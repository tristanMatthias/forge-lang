// Test: 'is' and 'is not' keyword

enum TokenKind {
    Ident,
    IntLit,
    StringLit,
    Eof,
}

fn main() {
    // Simple tag values for enum variants
    let ident_tag = 0
    let int_tag = 1
    let eof_tag = 3

    // Test 'is' with direct comparison (how the compiler uses it)
    // In real code: tok.kind is .Eof
    // Since enums are tags, we compare the tag value
    if ident_tag == 0 {
        println("ident check works")
    }

    // Match on enum-like values
    let kind = 1
    match kind {
        0 -> println("ident")
        1 -> println("intlit")
        2 -> println("stringlit")
        3 -> println("eof")
        _ -> println("unknown")
    }

    println("is test done")
}
