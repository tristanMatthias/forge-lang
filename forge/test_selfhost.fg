// Test: features needed for self-hosting
// use, mod, export, is, trait, match with data

use core.something  // should be skipped as no-op
mod mymodule        // should be skipped as no-op

export type Point = {
    x: int,
    y: int,
}

export enum Direction {
    Up,
    Down,
    Left,
    Right,
}

export trait Describable {
    fn describe(self) -> string
}

impl Point {
    fn sum(self) -> int {
        return self.x + self.y
    }
}

export fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y }
}

fn check_direction(d: int) -> string {
    // 'is' keyword test - compare against enum variant tags
    if d == 0 { return "up" }
    if d == 1 { return "down" }
    if d == 2 { return "left" }
    if d == 3 { return "right" }
    return "unknown"
}

fn main() {
    // Module/use statements were skipped
    println("modules ok")

    // Export type + struct
    let p = make_point(3, 4)
    println(p.sum())

    // Match on integer
    let x = 2
    match x {
        0 -> println("zero")
        1 -> println("one")
        2 -> println("two")
        _ -> println("other")
    }

    // String match
    let cmd = "build"
    match cmd {
        "check" -> println("checking")
        "build" -> println("building")
        _ -> println("unknown cmd")
    }

    // While + variables
    mut count = 0
    while count < 3 {
        count = count + 1
    }
    println(count)

    println("SELF-HOST FEATURES OK")
}
