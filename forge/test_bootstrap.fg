// Minimal lexer test

export type Token = {
    kind_id: int,
    text: string,
}

export mut TOKENS: List<Token> = []

fn add_token(kid: int, txt: string) {
    TOKENS = TOKENS.push(Token { kind_id: kid, text: txt })
}

fn is_lower(ch: string) -> int {
    if ch >= "a" && ch <= "z" { return 1 }
    return 0
}

fn lex(source: string) {
    mut pos = 0
    while pos < source.length {
        let ch = source[pos]
        if ch == " " {
            pos = pos + 1
        } else if is_lower(ch) == 1 {
            mut word = ""
            mut reading = 1
            while pos < source.length && reading == 1 {
                if is_lower(source[pos]) == 1 {
                    word = word + source[pos]
                    pos = pos + 1
                } else {
                    reading = 0
                }
            }
            add_token(0, word)
        } else {
            pos = pos + 1
        }
    }
}

fn main() {
    lex("hello world foo")
    println(TOKENS.length)
    println(TOKENS[0].text)
    println(TOKENS[1].text)
    println(TOKENS[2].text)
    println("done")
}
