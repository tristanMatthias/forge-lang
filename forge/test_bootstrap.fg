type Token = {
    kind_id: int,
    text: string,
}

// Put POS BEFORE TOKENS to avoid memory overlap
mut POS: int = 0
mut TOKENS: List<Token> = []

fn add_token(kid: int, txt: string) {
    TOKENS = TOKENS.push(Token { kind_id: kid, text: txt })
}

fn peek_id() -> int {
    if POS < TOKENS.length {
        let tok = TOKENS[POS]
        return tok.kind_id
    }
    return 99
}

fn advance_pos() { POS = POS + 1 }

fn main() {
    add_token(4, "fn")
    add_token(0, "main")
    add_token(6, "(")
    println(TOKENS.length)
    println(POS)
    println(peek_id())
    advance_pos()
    println(peek_id())
    advance_pos()
    println(peek_id())
    println("done")
}
