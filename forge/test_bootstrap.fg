// Minimal struct list index test

type Token = {
    kind_id: int,
    text: string,
}

mut TOKENS: List<Token> = []

fn add_token(kid: int, txt: string) {
    TOKENS = TOKENS.push(Token { kind_id: kid, text: txt })
}

fn main() {
    add_token(4, "fn")
    add_token(0, "main")
    add_token(6, "(")
    println(TOKENS.length)

    // Direct access
    let t0 = TOKENS[0]
    println(t0.kind_id)
    println(t0.text)

    let t1 = TOKENS[1]
    println(t1.kind_id)
    println(t1.text)

    println("struct list access done")
}
