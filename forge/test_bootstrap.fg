// Test: mixed int + string/list globals

mut COUNTER: int = 0
mut ITEMS: List<string> = []

fn bump() { COUNTER = COUNTER + 1 }
fn add(s: string) { ITEMS = ITEMS.push(s) }

fn main() {
    bump()
    bump()
    bump()
    println(COUNTER)

    add("hello")
    add("world")
    println(ITEMS.length)
    println(ITEMS[0])
    println(ITEMS[1])

    println("mixed globals work!")
}
