type Vec3 = {
    x: int,
    y: int,
    z: int,
}

fn dot(a: Vec3, b: Vec3) -> int {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn main() {
    let v1 = Vec3 { x: 1, y: 2, z: 3 }
    let v2 = Vec3 { x: 4, y: 5, z: 6 }

    let d = dot(v1, v2)
    println(d)

    let sum = v1.x + v1.y + v1.z
    println(sum)

    println("done!")
}
