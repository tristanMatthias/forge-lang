fn fib(n: int) -> int {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn gcd(a: int, b: int) -> int {
    if b == 0 { return a }
    return gcd(b, a - a / b * b)
}

fn pow(base: int, exp: int) -> int {
    if exp == 0 { return 1 }
    return base * pow(base, exp - 1)
}

fn main() {
    // Fibonacci
    println(fib(15))

    // GCD
    println(gcd(48, 18))

    // Power
    println(pow(2, 10))
    println(pow(3, 5))

    // Arithmetic
    let x = pow(2, 10) + fib(10)
    println(x)
}
