type Point = {
    x: int,
    y: int,
}

fn add_points(a: Point, b: Point) -> int {
    return a.x + b.x + a.y + b.y
}

fn describe(p: Point) {
    let px = p.x
    let py = p.y
    println("x=${px} y=${py}")
}

fn main() {
    let p1 = Point { x: 10, y: 20 }
    let p2 = Point { x: 3, y: 7 }

    describe(p1)
    describe(p2)

    let sum = add_points(p1, p2)
    println("sum=${sum}")

    // Local field access
    let total = p1.x + p1.y + p2.x + p2.y
    println("total=${total}")

    println("done!")
}
