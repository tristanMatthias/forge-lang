fn main() {
    let nums = [10, 20, 30, 40, 50]
    println(nums.length)
    println(nums[0])
    println(nums[2])
    println(nums[4])

    // Sum via while loop
    mut sum = 0
    mut i = 0
    while i < nums.length {
        sum = sum + nums[i]
        i = i + 1
    }
    println(sum)
    println("done!")
}
