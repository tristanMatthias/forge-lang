// Comprehensive test of the self-hosted Forge compiler
// Tests: functions, params, recursion, if/else, while, let/mut, assignment, arithmetic

fn fib(n: int) -> int {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

fn gcd(a: int, b: int) -> int {
    if b == 0 { return a }
    return gcd(b, a - a / b * b)
}

fn pow(base: int, exp: int) -> int {
    if exp == 0 { return 1 }
    return base * pow(base, exp - 1)
}

fn is_prime(n: int) -> int {
    if n < 2 { return 0 }
    mut i = 2
    while i * i <= n {
        if n / i * i == n { return 0 }
        i = i + 1
    }
    return 1
}

fn count_primes(limit: int) -> int {
    mut count = 0
    mut n = 2
    while n <= limit {
        if is_prime(n) == 1 {
            count = count + 1
        }
        n = n + 1
    }
    return count
}

fn collatz_steps(n: int) -> int {
    mut steps = 0
    mut current = n
    while current > 1 {
        if current / 2 * 2 == current {
            current = current / 2
        } else {
            current = current * 3 + 1
        }
        steps = steps + 1
    }
    return steps
}

fn main() {
    println(fib(20))
    println(factorial(12))
    println(gcd(252, 105))
    println(pow(2, 16))
    println(is_prime(97))
    println(is_prime(100))
    println(count_primes(100))
    println(collatz_steps(27))
}
