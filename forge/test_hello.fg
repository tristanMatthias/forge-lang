// Mini lexer test — a tiny fragment of what the self-hosted compiler does

type Token = {
    kind_id: int,
    text: string,
}

fn lex_char(ch: string) -> Token {
    if ch == "(" {
        return Token { kind_id: 0, text: "" }
    }
    if ch == ")" {
        return Token { kind_id: 0, text: "" }
    }
    // Default: treat as identifier
    return Token { kind_id: 1, text: ch }
}

fn main() {
    let tok = lex_char("x")
    let kid = tok.kind_id
    let txt = tok.text
    println(kid)
    println(txt)

    let tok2 = lex_char("(")
    println(tok2.kind_id)

    println("done!")
}
