fn count_down(n: int) -> int {
    mut i = n
    mut count = 0
    while i > 0 {
        i = i - 1
        count = count + 1
    }
    return count
}

fn sum_to(n: int) -> int {
    mut total = 0
    mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

fn collatz_steps(n: int) -> int {
    mut steps = 0
    mut current = n
    while current > 1 {
        if current / 2 * 2 == current {
            current = current / 2
        } else {
            current = current * 3 + 1
        }
        steps = steps + 1
    }
    return steps
}

fn main() {
    println(count_down(5))
    println(sum_to(10))
    println(sum_to(100))
    println(collatz_steps(27))
    println(collatz_steps(1))
    println(collatz_steps(6))
}
