type Tok = {
    kind: int,
    text: string,
}

mut SRC: string = ""
mut POS: int = 0

fn peek_ch() -> string {
    if POS >= SRC.length { return "" }
    SRC.substring(POS, POS + 1)
}

fn advance_ch() -> string {
    let ch = peek_ch()
    POS = POS + 1
    ch
}

fn is_alpha(ch: string) -> bool {
    if ch >= "a" && ch <= "z" { return true }
    if ch >= "A" && ch <= "Z" { return true }
    if ch == "_" { return true }
    false
}

fn is_digit(ch: string) -> bool {
    if ch >= "0" && ch <= "9" { return true }
    false
}

fn skip_ws() {
    while POS < SRC.length {
        let ch = peek_ch()
        if ch == " " {
            advance_ch()
        } else {
            return
        }
    }
}

fn next_tok() -> Tok {
    skip_ws()
    if POS >= SRC.length {
        return Tok { kind: 0, text: "" }
    }
    let ch = peek_ch()

    // Number
    if is_digit(ch) {
        mut num = ""
        while POS < SRC.length && is_digit(peek_ch()) {
            num = num + advance_ch()
        }
        return Tok { kind: 2, text: num }
    }

    // Identifier
    if is_alpha(ch) {
        mut word = ""
        while POS < SRC.length {
            let wch = peek_ch()
            if !is_alpha(wch) && !is_digit(wch) { break }
            word = word + advance_ch()
        }
        return Tok { kind: 1, text: word }
    }

    // Single char
    advance_ch()
    Tok { kind: 3, text: ch }
}

fn tokenize(source: string) -> List<Tok> {
    SRC = source
    POS = 0
    mut tokens: List<Tok> = []
    while true {
        let tok = next_tok()
        tokens = tokens.push(tok)
        if tok.kind == 0 { break }
    }
    tokens
}

fn main() -> int {
    mut tokens: List<Tok> = []
    tokens = tokenize("let x = 42 + y")
    mut i = 0
    while i < tokens.length {
        let t = tokens[i]
        println("kind=" + string(t.kind) + " text='" + t.text + "'")
        i = i + 1
    }
    tokens.length
}
