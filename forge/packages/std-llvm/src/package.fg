/// Build a signed integer division instruction.
export fn build_sdiv(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_sdiv(builder, lhs, rhs, name)
}

/// Build a signed integer remainder instruction.
export fn build_srem(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_srem(builder, lhs, rhs, name)
}

/// Build a floating-point add instruction.
export fn build_fadd(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_fadd(builder, lhs, rhs, name)
}

/// Build a floating-point subtract instruction.
export fn build_fsub(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_fsub(builder, lhs, rhs, name)
}

/// Build a floating-point multiply instruction.
export fn build_fmul(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_fmul(builder, lhs, rhs, name)
}

/// Build a floating-point division instruction.
export fn build_fdiv(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_fdiv(builder, lhs, rhs, name)
}

/// Build a floating-point remainder instruction.
export fn build_frem(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_frem(builder, lhs, rhs, name)
}

/// Build a floating-point negation instruction.
export fn build_fneg(builder: ptr, val: ptr, name: string) -> ptr {
    forge_llvm_build_fneg(builder, val, name)
}

/// Build a floating-point comparison. pred: 0=false, 1=oeq, 2=ogt, 3=oge, 4=olt, 5=ole, 6=one, 7=ord, 8=uno, 9=ueq, 10=ugt, 11=uge, 12=ult, 13=ule, 14=une, 15=true
export fn build_fcmp(builder: ptr, pred: int, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_fcmp(builder, pred, lhs, rhs, name)
}

