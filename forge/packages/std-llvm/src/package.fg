/// Build a bitwise AND instruction.
export fn build_and(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_and(builder, lhs, rhs, name)
}

/// Build a bitwise OR instruction.
