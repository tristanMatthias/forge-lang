// ── Control Flow (switch, unreachable) ──

/// Build an unreachable instruction.
export fn build_unreachable(builder: ptr) -> ptr {
    forge_llvm_build_unreachable(builder)
}

/// Build a switch instruction. Returns the switch value for adding cases.
export fn build_switch(builder: ptr, val: ptr, else_bb: ptr, num_cases: int) -> ptr {
    forge_llvm_build_switch(builder, val, else_bb, num_cases)
}

/// Add a case to a switch instruction.
export fn add_case(switch_val: ptr, on_val: ptr, dest: ptr) {
    forge_llvm_add_case(switch_val, on_val, dest)
}

// ── Constants and Globals ──

/// Create a null constant of the given type.
export fn const_null(ty: ptr) -> ptr {
    forge_llvm_const_null(ty)
}

/// Get an undef value of the given type.
export fn get_undef(ty: ptr) -> ptr {
    forge_llvm_get_undef(ty)
}

/// Create a floating-point constant.
export fn const_real(ty: ptr, value: float) -> ptr {
    forge_llvm_const_real(ty, value)
}

/// Create a constant struct from the given values.
export fn const_struct(ctx: ptr, values: ptr, count: int, packed: int) -> ptr {
    forge_llvm_const_struct(ctx, values, count, packed)
}

/// Add a global variable to a module.
export fn add_global(m: ptr, ty: ptr, name: string) -> ptr {
    forge_llvm_add_global(m, ty, name)
}

/// Set the initializer for a global variable.
export fn set_initializer(global: ptr, val: ptr) {
    forge_llvm_set_initializer(global, val)
}

/// Mark a global variable as constant.
export fn set_global_constant(global: ptr, is_constant: int) {
    forge_llvm_set_global_constant(global, is_constant)
}

// ── Builder/Block Operations ──

/// Get the basic block the builder is currently inserting into.
export fn get_insert_block(builder: ptr) -> ptr {
    forge_llvm_get_insert_block(builder)
}

/// Get the function that a basic block belongs to.
export fn get_basic_block_parent(bb: ptr) -> ptr {
    forge_llvm_get_basic_block_parent(bb)
}

/// Position the builder before the given instruction.
export fn position_builder_before(builder: ptr, instr: ptr) {
    forge_llvm_position_builder_before(builder, instr)
}

/// Get the first instruction in a basic block.
export fn get_first_instruction(bb: ptr) -> ptr {
    forge_llvm_get_first_instruction(bb)
}

/// Get the entry basic block of a function.
export fn get_entry_basic_block(f: ptr) -> ptr {
    forge_llvm_get_entry_basic_block(f)
}

// ── Target Machine ──

/// Initialize all LLVM targets (must call before any target machine operations).
export fn initialize_all_targets() {
    forge_llvm_initialize_all_targets()
}

/// Get the default target triple for this host. Returns a raw C string pointer.
export fn get_default_target_triple() -> ptr {
    forge_llvm_get_default_target_triple()
}

/// Look up a target by triple. Writes target ptr to target_out. Returns 0 on success.
export fn get_target_from_triple(triple: ptr, target_out: ptr) -> int {
    forge_llvm_get_target_from_triple(triple, target_out)
}

/// Create a target machine. level: 0=None, 1=Less, 2=Default, 3=Aggressive. reloc: 0=Default, 1=Static, 2=PIC. code_model: 0=Default, 1=JITDefault, 2=Tiny, 3=Small, 4=Kernel, 5=Medium, 6=Large.
export fn create_target_machine(target: ptr, triple: ptr, cpu: ptr, features: ptr, level: int, reloc: int, code_model: int) -> ptr {
    forge_llvm_create_target_machine(target, triple, cpu, features, level, reloc, code_model)
}

/// Dispose a target machine.
export fn dispose_target_machine(tm: ptr) {
    forge_llvm_dispose_target_machine(tm)
}

/// Emit module to file. codegen: 0=assembly, 1=object. Returns 0 on success.
export fn target_machine_emit_to_file(tm: ptr, m: ptr, filename: ptr, codegen: int) -> int {
    forge_llvm_target_machine_emit_to_file(tm, m, filename, codegen)
}

/// Set the target triple on a module.
export fn set_target(m: ptr, triple: ptr) {
    forge_llvm_set_target(m, triple)
}

/// Set the data layout string on a module.
export fn set_data_layout(m: ptr, layout: ptr) {
    forge_llvm_set_data_layout(m, layout)
}

/// Create a target data layout from a target machine.
export fn create_target_data_layout(tm: ptr) -> ptr {
    forge_llvm_create_target_data_layout(tm)
}

/// Get the string representation of a target data layout. Returns a raw C string pointer.
export fn copy_string_rep_of_target_data(td: ptr) -> ptr {
    forge_llvm_copy_string_rep_of_target_data(td)
}

/// Dispose a target data layout.
export fn dispose_target_data(td: ptr) {
    forge_llvm_dispose_target_data(td)
}
