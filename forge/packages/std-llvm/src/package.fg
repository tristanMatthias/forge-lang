    forge_llvm_build_xor(builder, lhs, rhs, name)
}

/// Build a left shift instruction.
export fn build_shl(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_shl(builder, lhs, rhs, name)
}

/// Build an arithmetic right shift instruction.
export fn build_ashr(builder: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr {
    forge_llvm_build_ashr(builder, lhs, rhs, name)
}

