// ─── Type Environment ──────────────────────────
// Scoped symbol tables for the type checker.
// Each scope maps variable names to their types and mutability.

use core.types.Type

// ─── Symbol ────────────────────────────────────

export type Symbol = {
    name: string,
    sym_type: Type,
    mutable: bool,
}

// ─── Scope ─────────────────────────────────────

export type Scope = {
    symbols: Map<string, Symbol>,
    parent: Scope?,
}

export fn scope_new() -> Scope {
    Scope { symbols: {}, parent: null }
}

export fn scope_child(parent: Scope) -> Scope {
    Scope { symbols: {}, parent }
}

// ─── Type Environment ──────────────────────────

export type TypeEnv = {
    mut current: Scope,
    // Function return type stack for checking return statements
    mut return_types: List<Type>,
}

export fn type_env_new() -> TypeEnv {
    TypeEnv {
        current: scope_new(),
        return_types: [],
    }
}

impl TypeEnv {
    fn push_scope(self) {
        self.current = scope_child(self.current)
    }

    fn pop_scope(self) {
        if self.current.parent != null {
            self.current = self.current.parent!
        }
    }

    fn define(self, name: string, ty: Type, mutable: bool) {
        self.current.symbols[name] = Symbol { name, sym_type: ty, mutable }
    }

    fn lookup(self, name: string) -> Symbol? {
        // Walk up the scope chain
        mut scope: Scope? = self.current
        while scope != null {
            if scope!.symbols.has(name) {
                return scope!.symbols[name]
            }
            scope = scope!.parent
        }
        null
    }

    fn is_mutable(self, name: string) -> bool {
        let sym = self.lookup(name)
        if sym != null { sym!.mutable } else { false }
    }

    fn push_return_type(self, ty: Type) {
        self.return_types = self.return_types.push(ty)
    }

    fn pop_return_type(self) {
        if self.return_types.length > 0 {
            self.return_types = self.return_types.pop()
        }
    }

    fn current_return_type(self) -> Type? {
        if self.return_types.length > 0 {
            self.return_types[self.return_types.length - 1]
        } else {
            null
        }
    }
}
