// ─── Mini Forge Compiler ──────────────────────────────────────────
// Self-contained single-file compiler. Emits LLVM IR as text.
// Lex → Parse → Emit IR → llc → cc
//
// Architecture:
// - Own lexer (token kind as int, text as string)
// - Direct IR emission during parsing (no AST)
// - Type tracking via globals (LAST_IS_STR, LAST_STRUCT_TYPE, etc.)
// - String constants collected in STR_DECLS, appended after functions

use @std.process
use @std.fs

// ═══════════════════════════════════════════════════════════════════
// SIMPLE LEXER — token kind as int, text as string
// ═══════════════════════════════════════════════════════════════════
// kind: 0=eof, 1=ident, 2=int, 3=string, 4=newline,
//       5=symbol (text has the symbol), 6=bool

type Tok = {
    kind: int,
    text: string,
    line: int,
}

// ═══════════════════════════════════════════════════════════════════
// AST — Abstract Syntax Tree
// Small enum variants to stay within bootstrap limits (~10 each)
// ═══════════════════════════════════════════════════════════════════

// Expression nodes
// Using kind+fields encoding instead of data-carrying enum variants
// (bootstrap can match on unit enums reliably)
enum ExprKind {
    IntLit      // data: int_val
    StrLit      // data: str_val
    BoolLit     // data: int_val (0/1)
    Ident       // data: str_val
    Binary      // data: str_val (op), children: left, right
    Unary       // data: str_val (op), children: operand
    Call        // data: str_val (callee), children: args list
    Index       // children: obj, idx
    Member      // data: str_val (field), children: obj
    ListLit     // children: elements
    StructLit   // data: str_val (type name), fields via side table
    EnumLit     // data: str_val (Type.Variant), children: args
    Null        // no data
}

type Expr = {
    kind: ExprKind,
    int_val: int,
    str_val: string,
    children: List<Expr>,  // left=[0], right=[1], or args list
}

// Statement nodes
enum StmtKind {
    Let         // data: str_val (name), str2 (type ann), children: value
    Assign      // children: target, value
    Return      // children: value (null for bare return)
    If          // children: cond, then_body (as Block), else_body
    While       // children: cond, body
    For         // data: str_val (var name), children: iterable, body
    Break
    Continue
    ExprStmt    // children: expr
    Match       // children: scrutinee, arms via side table
}

type Stmt = {
    kind: StmtKind,
    str_val: string,
    str2: string,
    exprs: List<Expr>,    // condition, value, target, etc.
    body: List<Stmt>,
    else_body: List<Stmt>,
    is_mut: bool,
}

type FnDecl = {
    name: string,
    params: List<Param>,
    return_type: string,
    body: List<Stmt>,
    exported: bool,
}

type Param = {
    name: string,
    type_name: string,
}

type Program = {
    functions: List<FnDecl>,
    types: List<TypeDecl>,
    enums: List<EnumDecl>,
    globals: List<Stmt>,
}

type TypeDecl = {
    name: string,
    fields: List<Param>,
}

type EnumDecl = {
    name: string,
    variants: List<VariantDecl>,
}

type VariantDecl = {
    name: string,
    fields: List<Param>,
}

// ─── AST constructors ─────────────────────────────────────────────

fn expr_int(val: int) -> Expr {
    Expr { kind: ExprKind.IntLit, int_val: val, str_val: "", children: [] }
}

fn expr_str(val: string) -> Expr {
    Expr { kind: ExprKind.StrLit, int_val: 0, str_val: val, children: [] }
}

fn expr_bool(val: bool) -> Expr {
    mut v = 0
    if val { v = 1 }
    Expr { kind: ExprKind.BoolLit, int_val: v, str_val: "", children: [] }
}

fn expr_ident(name: string) -> Expr {
    Expr { kind: ExprKind.Ident, int_val: 0, str_val: name, children: [] }
}

fn expr_binary(op: string, left: Expr, right: Expr) -> Expr {
    mut ch: List<Expr> = []
    ch = ch.push(left)
    ch = ch.push(right)
    Expr { kind: ExprKind.Binary, int_val: 0, str_val: op, children: ch }
}

fn expr_unary(op: string, operand: Expr) -> Expr {
    mut ch: List<Expr> = []
    ch = ch.push(operand)
    Expr { kind: ExprKind.Unary, int_val: 0, str_val: op, children: ch }
}

fn expr_call(callee: string, args: List<Expr>) -> Expr {
    Expr { kind: ExprKind.Call, int_val: 0, str_val: callee, children: args }
}

fn expr_member(obj: Expr, field: string) -> Expr {
    mut ch: List<Expr> = []
    ch = ch.push(obj)
    Expr { kind: ExprKind.Member, int_val: 0, str_val: field, children: ch }
}

fn expr_index(obj: Expr, idx: Expr) -> Expr {
    mut ch: List<Expr> = []
    ch = ch.push(obj)
    ch = ch.push(idx)
    Expr { kind: ExprKind.Index, int_val: 0, str_val: "", children: ch }
}

fn expr_null() -> Expr {
    Expr { kind: ExprKind.Null, int_val: 0, str_val: "", children: [] }
}

fn expr_list(items: List<Expr>) -> Expr {
    Expr { kind: ExprKind.ListLit, int_val: 0, str_val: "", children: items }
}

fn expr_struct(type_name: string, args: List<Expr>) -> Expr {
    Expr { kind: ExprKind.StructLit, int_val: 0, str_val: type_name, children: args }
}

fn expr_enum(name: string, args: List<Expr>) -> Expr {
    Expr { kind: ExprKind.EnumLit, int_val: 0, str_val: name, children: args }
}

// ─── Statement constructors ───────────────────────────────────────

fn stmt_let(name: string, type_ann: string, value: Expr, mutable: bool) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(value)
    Stmt { kind: StmtKind.Let, str_val: name, str2: type_ann, exprs: exprs, body: [], else_body: [], is_mut: mutable }
}

fn stmt_assign(target: Expr, value: Expr) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(target)
    exprs = exprs.push(value)
    Stmt { kind: StmtKind.Assign, str_val: "", str2: "", exprs: exprs, body: [], else_body: [], is_mut: false }
}

fn stmt_return(value: Expr) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(value)
    Stmt { kind: StmtKind.Return, str_val: "", str2: "", exprs: exprs, body: [], else_body: [], is_mut: false }
}

fn stmt_expr(e: Expr) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(e)
    Stmt { kind: StmtKind.ExprStmt, str_val: "", str2: "", exprs: exprs, body: [], else_body: [], is_mut: false }
}

fn stmt_if(cond: Expr, then_body: List<Stmt>, else_body: List<Stmt>) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(cond)
    Stmt { kind: StmtKind.If, str_val: "", str2: "", exprs: exprs, body: then_body, else_body: else_body, is_mut: false }
}

fn stmt_while(cond: Expr, body: List<Stmt>) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(cond)
    Stmt { kind: StmtKind.While, str_val: "", str2: "", exprs: exprs, body: body, else_body: [], is_mut: false }
}

fn stmt_for(var_name: string, iterable: Expr, body: List<Stmt>) -> Stmt {
    mut exprs: List<Expr> = []
    exprs = exprs.push(iterable)
    Stmt { kind: StmtKind.For, str_val: var_name, str2: "", exprs: exprs, body: body, else_body: [], is_mut: false }
}

fn stmt_break() -> Stmt {
    Stmt { kind: StmtKind.Break, str_val: "", str2: "", exprs: [], body: [], else_body: [], is_mut: false }
}

fn stmt_continue() -> Stmt {
    Stmt { kind: StmtKind.Continue, str_val: "", str2: "", exprs: [], body: [], else_body: [], is_mut: false }
}

mut LEX_SRC: string = ""
mut LEX_POS: int = 0
mut LEX_LINE: int = 1

fn lex_peek() -> string {
    if LEX_POS >= LEX_SRC.length { return "" }
    lex_char_at(LEX_POS)
}

fn lex_advance() -> string {
    if LEX_POS >= LEX_SRC.length { return "" }
    let ch = lex_char_at(LEX_POS)
    LEX_POS = LEX_POS + 1
    ch
}

fn lex_is_alpha(ch: string) -> bool {
    if ch == "_" { return true }
    if ch >= "a" && ch <= "z" { return true }
    if ch >= "A" && ch <= "Z" { return true }
    false
}

fn lex_is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

fn lex_is_alnum(ch: string) -> bool {
    if lex_is_alpha(ch) { return true }
    lex_is_digit(ch)
}

fn is_quote(c: string) -> bool {
    c == "\""
}

// ─── Codegen helpers (defined early for forward reference) ────────

fn ir_block_terminated() -> int {
    // Check if the last emitted IR instruction is a terminator (ret/br/unreachable)
    // Scan backwards in IR for last non-empty line
    let len = IR.length
    if len < 5 { return 0 }
    // Find last newline
    mut i = len - 2
    while i > 0 {
        if IR.byte_at(i) == 10 {
            // Found newline — check the line after it
            let line = IR.substring(i + 1, len)
            // Check for common terminators
            if line.contains("ret ") { return 1 }
            if line.contains("ret void") { return 1 }
            if line.contains("unreachable") { return 1 }
            if line.contains("br label") { return 1 }
            if line.contains("br i1") { return 1 }
            return 0
        }
        i = i - 1
    }
    0
}

fn set_field_type(fty: string) {
    LAST_IS_STR = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    LAST_IS_LIST = 0
    if fty == "%ForgeString" {
        LAST_IS_STR = 1
    }
    if fty == "{ ptr, i64 }" {
        LAST_IS_LIST = 1
    }
    if is_list_type(fty) {
        LAST_IS_LIST = 1
        LAST_LIST_ELEM_TYPE = fty.substring(5, fty.length)
    }
    // Check for struct field type
    if fty.length > 1 {
        if fty.substring(0, 1) == "%" {
            if fty != "%ForgeString" {
                let tname = fty.substring(1, fty.length)
                LAST_STRUCT_TYPE = tname
                LAST_ENUM_TYPE = tname
            }
        }
    }
}

fn is_ann_list(ann: string) -> bool {
    ann == "List"
}

fn read_last_is_str() -> int {
    LAST_IS_STR
}

fn read_last_is_list() -> int {
    LAST_IS_LIST
}

fn byte_at_pos(pos: int) -> int {
    // Get raw byte value at position (avoids string comparison issues)
    // 34 = double quote, 10 = newline
    LEX_SRC.byte_at(pos)
}

fn is_slash(c: string) -> bool {
    c.substring(0, 1) == "/"
}

fn not_at_end() -> bool {
    POS < TOKENS.length
}

fn not_at_brace() -> bool {
    if POS >= TOKENS.length { return false }
    if TOKENS[POS].text == "}" { return false }
    true
}

fn not_at_paren() -> bool {
    if POS >= TOKENS.length { return false }
    if TOKENS[POS].text == ")" { return false }
    true
}

fn lex_char_at(pos: int) -> string {
    LEX_SRC.substring(pos, pos + 1)
}

fn lex_skip_whitespace() {
    while LEX_POS < LEX_SRC.length {
        let c = lex_peek()
        if c == " " {
            lex_advance()
        } else if c == "\t" {
            lex_advance()
        } else if c == "\r" {
            lex_advance()
        } else if is_slash(c) {
            if LEX_POS + 1 < LEX_SRC.length {
                if is_slash(lex_char_at(LEX_POS + 1)) {
                    while LEX_POS < LEX_SRC.length {
                        if lex_peek() == "\n" { return }
                        lex_advance()
                    }
                } else {
                    return
                }
            } else {
                return
            }
        } else {
            return
        }
    }
}

fn lex_read_string() -> string {
    lex_advance() // consume opening "
    mut result = ""
    while LEX_POS < LEX_SRC.length && byte_at_pos(LEX_POS) != 34 {
        let ch = lex_advance()
        if ch == "\\" && LEX_POS < LEX_SRC.length {
            let esc = lex_advance()
            if esc == "n" {
                result = result + "\n"
            } else if esc == "t" {
                result = result + "\t"
            } else if esc == "\\" {
                result = result + "\\"
            } else if esc == "\"" {
                result = result + "\""
            } else {
                result = result + "\\" + esc
            }
        } else {
            result = result + ch
        }
    }
    if LEX_POS < LEX_SRC.length { lex_advance() } // consume closing "
    result
}

fn lex_next() -> Tok {
    lex_skip_whitespace()
    if LEX_POS >= LEX_SRC.length {
        return Tok { kind: 0, text: "", line: LEX_LINE }
    }

    let ch = lex_peek()
    let line = LEX_LINE
    let ch_byte = byte_at_pos(LEX_POS)

    // Newline (byte 10)
    if ch_byte == 10 {
        lex_advance()
        return Tok { kind: 4, text: "\n", line: line }
    }
    if ch_byte == 34 {
        let s = lex_read_string()
        return Tok { kind: 3, text: s, line: line }
    }

    // Number
    if lex_is_digit(ch) {
        mut num = ""
        while LEX_POS < LEX_SRC.length && lex_is_digit(lex_peek()) {
            num = num + lex_advance()
        }
        return Tok { kind: 2, text: num, line: line }
    }

    // Identifier / keyword
    if lex_is_alpha(ch) {
        mut word = ""
        while LEX_POS < LEX_SRC.length {
            let wch = lex_char_at(LEX_POS)
            if !lex_is_alnum(wch) { break }
            word = word + wch
            LEX_POS = LEX_POS + 1
        }
        // Check for bool literals
        if word == "true" || word == "false" {
            return Tok { kind: 6, text: word, line: line }
        }
        return Tok { kind: 1, text: word, line: line }
    }

    // Two-character operators
    if LEX_POS + 1 < LEX_SRC.length {
        let ch2 = lex_char_at(LEX_POS + 1)
        mut two = ch + ch2
        if two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "->" {
            lex_advance()
            lex_advance()
            return Tok { kind: 5, text: two, line: line }
        }
    }

    // Single-character symbols
    lex_advance()
    Tok { kind: 5, text: ch, line: line }
}

fn tokenize(source: string) -> List<Tok> {
    LEX_SRC = source
    LEX_POS = 0
    LEX_LINE = 1
    mut tokens: List<Tok> = []
    while true {
        let tok: Tok = lex_next()
        tokens = tokens.push(tok)
        if tok.kind == 0 { break }
    }
    tokens
}

// ═══════════════════════════════════════════════════════════════════
// CODEGEN STATE
// Parser globals, IR emission, variable/struct/enum tracking
// ═══════════════════════════════════════════════════════════════════

mut TOKENS: List<Tok> = []
mut POS: int = 0
mut IR: string = ""
mut REG_N: int = 0
mut LBL_N: int = 0
mut STR_N: int = 0
mut STR_DECLS: string = ""

// Variable tracking — flat lists
mut VAR_NAMES: List<string> = []
mut VAR_REGS: List<string> = []
mut VAR_TYPES: List<string> = [] // "i64", "%ForgeString", etc.

// Struct type tracking
// Flat representation: all fields from all structs in order
// STRUCT_NAMES[i] = "Tok"
// STRUCT_FIELD_STARTS[i] = index into SFIELD_* arrays
// STRUCT_FIELD_COUNTS[i] = number of fields
mut STRUCT_NAMES: List<string> = []
mut STRUCT_FIELD_STARTS: List<int> = []
mut STRUCT_FIELD_COUNTS: List<int> = []
// Flat arrays of all struct fields
mut SFIELD_NAMES: List<string> = []
mut SFIELD_TYPES: List<string> = []

// Track which variables hold struct values: VAR_STRUCT_TYPE[i] = "Tok" or ""
mut VAR_STRUCT_TYPE: List<string> = []
mut LAST_STRUCT_TYPE: string = ""

// Enum tracking
// ENUM_NAMES[i] = "Color"
// ENUM_VARIANT_STARTS[i] = index into EVAR_* arrays
// ENUM_VARIANT_COUNTS[i] = number of variants
mut ENUM_NAMES: List<string> = []
mut ENUM_VARIANT_STARTS: List<int> = []
mut ENUM_VARIANT_COUNTS: List<int> = []
// Flat arrays of variant names/field info
mut EVAR_NAMES: List<string> = []
// For data-carrying variants: field starts/counts into EFIELD_* arrays
mut EVAR_FIELD_STARTS: List<int> = []
mut EVAR_FIELD_COUNTS: List<int> = []
mut EFIELD_NAMES: List<string> = []
mut EFIELD_TYPES: List<string> = []

mut LAST_ENUM_TYPE: string = ""
mut LAST_IS_LIST: int = 0
mut LAST_LIST_ELEM_TYPE: string = "i64"  // element LLVM type for last list expr
// For struct field assignment: track the object being accessed
mut LAST_MEMBER_OBJ_NAME: string = ""  // variable name of the struct object
mut LAST_MEMBER_FIELD: string = ""     // field name that was accessed
mut LAST_MEMBER_OBJ_REG: string = ""   // the loaded struct value register
// Per-variable list element type: "" for non-lists
mut VAR_LIST_ELEM_TYPE: List<string> = []

// Function forward declarations
mut FN_NAMES: List<string> = []
mut FN_RETTYPES: List<string> = []
mut FN_PARAMCOUNTS: List<int> = []
mut FN_PARAM_TYPES: List<string> = []  // CSV per function: "i64,%ForgeString,i64"

// Loop labels for break/continue
mut LOOP_COND: List<string> = []
mut LOOP_END: List<string> = []

// Current function return type
mut CUR_RET_TY: string = "i64"
mut LAST_EXPR_VAL: string = "0"
mut LAST_IDENT_NAME: string = ""
mut LAST_IS_STR: int = 0  // 1 if last expression produced a string
mut BLOCK_TERMINATED: int = 0

fn mark_if_terminated(terminated: bool) {
    if terminated {
        BLOCK_TERMINATED = 1
    }
}

fn parse_block_stmt() {
    let t = parse_stmt()
    mark_if_terminated(t)
}

// ─── Struct helpers ───────────────────────────────

fn find_struct(name: string) -> int {
    mut i = 0
    while i < STRUCT_NAMES.length {
        if STRUCT_NAMES[i] == name { return i }
        i = i + 1
    }
    -1
}

fn struct_field_index(struct_idx: int, field_name: string) -> int {
    let start = STRUCT_FIELD_STARTS[struct_idx]
    let count = STRUCT_FIELD_COUNTS[struct_idx]
    mut i = 0
    while i < count {
        if SFIELD_NAMES[start + i] == field_name { return i }
        i = i + 1
    }
    -1
}

fn struct_field_type_raw(struct_idx: int, field_idx: int) -> string {
    let start = STRUCT_FIELD_STARTS[struct_idx]
    SFIELD_TYPES[start + field_idx]
}

fn struct_field_type(struct_idx: int, field_idx: int) -> string {
    let raw = struct_field_type_raw(struct_idx, field_idx)
    // Convert list_X → { ptr, i64 } for LLVM IR
    if is_list_type(raw) { return "{ ptr, i64 }" }
    raw
}

fn struct_field_count(struct_idx: int) -> int {
    STRUCT_FIELD_COUNTS[struct_idx]
}

fn struct_llvm_type(name: string) -> string {
    "%" + name
}

fn load_var_by_type(name: string, idx: int, vty: string) -> string {
    detect_var_type(vty)
    let load_ty = get_load_type(vty)
    let r = new_reg()
    ir_line(r + " = load " + load_ty + ", ptr " + VAR_REGS[idx])
    r
}

fn get_load_type(vty: string) -> string {
    if is_list_type(vty) { return "{ ptr, i64 }" }
    vty
}

fn detect_var_type(vty: string) {
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    if vty == "%ForgeString" {
        LAST_IS_STR = 1
        return
    }
    if is_list_type(vty) {
        LAST_IS_LIST = 1
        LAST_LIST_ELEM_TYPE = vty.substring(5, vty.length)
        return
    }
    if vty.length > 1 {
        if vty.substring(0, 1) == "%" {
            LAST_STRUCT_TYPE = vty.substring(1, vty.length)
            LAST_ENUM_TYPE = vty.substring(1, vty.length)
        }
    }
}

fn load_list_var(name: string, idx: int, vty: string) -> string {
    let r = new_reg()
    ir_line(r + " = load { ptr, i64 }, ptr " + VAR_REGS[idx])
    LAST_IS_LIST = 1
    LAST_IS_STR = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    LAST_LIST_ELEM_TYPE = vty.substring(5, vty.length)
    r
}

fn is_list_type(ty: string) -> bool {
    if ty.length < 6 { return false }
    // Check "list_" prefix char by char
    if ty.substring(0, 1) != "l" { return false }
    if ty.substring(1, 2) != "i" { return false }
    if ty.substring(2, 3) != "s" { return false }
    if ty.substring(3, 4) != "t" { return false }
    if ty.substring(4, 5) != "_" { return false }
    true
}

fn clear_last_ident() {
    LAST_IDENT_NAME = ""
}

fn check_list_annotation(ann: string, generic: string) {
    if ann == "List" {
        LAST_IS_LIST = 1
        if generic != "" {
            LAST_LIST_ELEM_TYPE = type_to_llvm(generic)
        }
    }
}

fn set_type_from_llvm(ty: string) {
    // Given an LLVM return type like "%Tok", set LAST_STRUCT_TYPE/LAST_ENUM_TYPE
    if ty.length > 1 {
        if ty.substring(0, 1) == "%" {
            if ty != "%ForgeString" {
                let tname = ty.substring(1, ty.length)
                LAST_STRUCT_TYPE = tname
                LAST_ENUM_TYPE = tname
            }
        }
    }
}

fn find_enum(name: string) -> int {
    mut i = 0
    while i < ENUM_NAMES.length {
        if ENUM_NAMES[i] == name { return i }
        i = i + 1
    }
    -1
}

fn enum_variant_index(enum_idx: int, variant_name: string) -> int {
    let start = ENUM_VARIANT_STARTS[enum_idx]
    let count = ENUM_VARIANT_COUNTS[enum_idx]
    mut i = 0
    while i < count {
        if EVAR_NAMES[start + i] == variant_name { return i }
        i = i + 1
    }
    -1
}

// Compute max payload size across all variants (in i64 slots)
fn enum_max_slots(enum_idx: int) -> int {
    let start = ENUM_VARIANT_STARTS[enum_idx]
    let count = ENUM_VARIANT_COUNTS[enum_idx]
    mut max_slots = 0
    mut i = 0
    while i < count {
        let fc = EVAR_FIELD_COUNTS[start + i]
        // Each field takes 1 slot (i64-sized)
        // Strings take 2 slots ({ptr, i64})
        let fs = EVAR_FIELD_STARTS[start + i]
        mut slots = 0
        mut j = 0
        while j < fc {
            let fty = EFIELD_TYPES[fs + j]
            if fty == "%ForgeString" {
                slots = slots + 2
            } else {
                slots = slots + 1
            }
            j = j + 1
        }
        if slots > max_slots { max_slots = slots }
        i = i + 1
    }
    if max_slots == 0 { max_slots = 1 }
    max_slots
}

fn enum_llvm_type_str(enum_idx: int) -> string {
    let ms = enum_max_slots(enum_idx)
    // { i8, i64, i64, ... } — tag + payload slots
    mut ty = "{ i8"
    mut i = 0
    while i < ms {
        ty = ty + ", i64"
        i = i + 1
    }
    ty = ty + " }"
    ty
}

fn type_to_llvm(ty_name: string) -> string {
    if ty_name == "int" { return "i64" }
    if ty_name == "bool" { return "i64" }
    if ty_name == "string" { return "%ForgeString" }
    if ty_name == "float" { return "double" }
    if ty_name == "List" { return "{ ptr, i64 }" }
    // Check if it's a known struct
    let si = find_struct(ty_name)
    if si >= 0 { return "%" + ty_name }
    // Check if it's a known enum
    let ei = find_enum(ty_name)
    if ei >= 0 { return "%" + ty_name }
    "i64"
}

fn parse_enum_decl_top() {
    expect("enum")
    let name = advance().text
    expect("{")
    skip_nl()
    let vstart = EVAR_NAMES.length
    mut vcount = 0
    while not_at_brace() {
        let vname = advance().text
        let fstart = EFIELD_NAMES.length
        mut fcount = 0
        if check("(") {
            advance()
            skip_nl()
            while not_at_paren() {
                let fname = advance().text
                expect(":")
                skip_nl()
                let ftname = peek().text
                parse_type_ann()
                EFIELD_NAMES = EFIELD_NAMES.push(fname)
                EFIELD_TYPES = EFIELD_TYPES.push(type_to_llvm(ftname))
                fcount = fcount + 1
                skip_nl()
                if check(",") { advance() }
                skip_nl()
            }
            expect(")")
        }
        EVAR_NAMES = EVAR_NAMES.push(vname)
        EVAR_FIELD_STARTS = EVAR_FIELD_STARTS.push(fstart)
        EVAR_FIELD_COUNTS = EVAR_FIELD_COUNTS.push(fcount)
        vcount = vcount + 1
        skip_nl()
    }
    expect("}")
    ENUM_NAMES = ENUM_NAMES.push(name)
    ENUM_VARIANT_STARTS = ENUM_VARIANT_STARTS.push(vstart)
    ENUM_VARIANT_COUNTS = ENUM_VARIANT_COUNTS.push(vcount)
}

fn parse_type_decl_top() {
    expect("type")
    let name = advance().text
    expect("=")
    skip_nl()
    expect("{")
    skip_nl()
    let start_idx = SFIELD_NAMES.length
    mut count = 0
    while not_at_brace() {
        if check("mut") { advance() }
        let fname = advance().text
        expect(":")
        skip_nl()
        let ftype_name = peek().text
        // Capture generic param for List<T>
        advance()
        mut ftype_generic = ""
        if check("<") {
            advance()
            ftype_generic = peek().text
            mut ftd = 1
            while ftd > 0 && POS < TOKENS.length {
                if check("<") { ftd = ftd + 1 }
                if check(">") { ftd = ftd - 1 }
                advance()
            }
        }
        if check("?") { advance() }
        mut ftype = type_to_llvm(ftype_name)
        // For List<T> fields, store as "list_ELEMTYPE" for element tracking
        if ftype_name == "List" && ftype_generic != "" {
            ftype = "list_" + type_to_llvm(ftype_generic)
        }
        SFIELD_NAMES = SFIELD_NAMES.push(fname)
        SFIELD_TYPES = SFIELD_TYPES.push(ftype)
        count = count + 1
        skip_nl()
        if check(",") { advance() }
        skip_nl()
    }
    expect("}")
    STRUCT_NAMES = STRUCT_NAMES.push(name)
    STRUCT_FIELD_STARTS = STRUCT_FIELD_STARTS.push(start_idx)
    STRUCT_FIELD_COUNTS = STRUCT_FIELD_COUNTS.push(count)
}

fn peek() -> Tok {
    if POS >= TOKENS.length { return Tok { kind: 0, text: "", line: 0 } }
    TOKENS[POS]
}

fn advance() -> Tok {
    let tok: Tok = peek()
    POS = POS + 1
    tok
}

fn check(text: string) -> bool {
    if POS >= TOKENS.length { return false }
    let t: Tok = TOKENS[POS]
    // Don't match string literals or numbers as keywords/symbols
    if t.kind == 3 { return false }
    if t.kind == 2 { return false }
    t.text == text
}

fn check_kind(k: int) -> bool {
    if POS >= TOKENS.length { return false }
    TOKENS[POS].kind == k
}

fn expect(text: string) {
    if !check(text) {
        if POS > 2 {
            eprintln("  ctx: [" + string(POS - 2) + "]='" + TOKENS[POS - 2].text + "' [" + string(POS - 1) + "]='" + TOKENS[POS - 1].text + "'")
        }
        eprintln("error: expected '" + text + "' got '" + peek().text + "' line " + string(peek().line) + " pos=" + string(POS))
        process.exit(1)
    }
    advance()
}

fn skip_nl() {
    while check_kind(4) { advance() }
}

fn ir_line(s: string) {
    IR = IR + "  " + s + "\n"
}

fn ir_raw(s: string) {
    IR = IR + s + "\n"
}

fn new_reg() -> string {
    REG_N = REG_N + 1
    "%r" + string(REG_N)
}

fn new_label(prefix: string) -> string {
    LBL_N = LBL_N + 1
    prefix + string(LBL_N)
}

fn new_str_const(text: string) -> string {
    STR_N = STR_N + 1
    let name = "@.str." + string(STR_N)
    let escaped = ir_escape(text)
    // Collect string constants in STR_DECLS (emitted at top of IR)
    // Size = escaped byte count + 1 (for NUL). Each \XX escape = 1 byte, regular char = 1 byte.
    let byte_len = count_ir_bytes(escaped)
    STR_DECLS = STR_DECLS + name + " = private unnamed_addr constant [" + string(byte_len + 1) + " x i8] c\"" + escaped + "\\00\"\n"
    name
}

fn hex_digit(n: int) -> string {
    if n == 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    if n == 3 { return "3" }
    if n == 4 { return "4" }
    if n == 5 { return "5" }
    if n == 6 { return "6" }
    if n == 7 { return "7" }
    if n == 8 { return "8" }
    if n == 9 { return "9" }
    if n == 10 { return "A" }
    if n == 11 { return "B" }
    if n == 12 { return "C" }
    if n == 13 { return "D" }
    if n == 14 { return "E" }
    if n == 15 { return "F" }
    "0"
}

fn count_ir_bytes(escaped: string) -> int {
    // Count actual bytes in an IR escaped string
    // \XX (hex escape) = 1 byte (3 chars)
    // \\ (literal backslash) = 1 byte (2 chars)
    // regular char = 1 byte (1 char)
    mut bytes = 0
    mut i = 0
    while i < escaped.length {
        let c = escaped.byte_at(i)
        if c == 92 {
            // Backslash: check next char
            if i + 1 < escaped.length {
                let next = escaped.byte_at(i + 1)
                if next == 92 {
                    // \\ = literal backslash = 1 byte
                    bytes = bytes + 1
                    i = i + 2
                } else {
                    // \XX = hex escape = 1 byte
                    bytes = bytes + 1
                    i = i + 3
                }
            } else {
                bytes = bytes + 1
                i = i + 1
            }
        } else {
            bytes = bytes + 1
            i = i + 1
        }
    }
    bytes
}

fn ir_escape(s: string) -> string {
    mut r = ""
    mut i = 0
    while i < s.length {
        let ch = s[i]
        let byte = s.byte_at(i)
        if byte == 10 {
            r = r + "\\0A"
        } else if byte == 9 {
            r = r + "\\09"
        } else if byte == 13 {
            r = r + "\\0D"
        } else if byte == 92 {
            r = r + "\\\\"
        } else if byte == 34 {
            r = r + "\\22"
        } else if byte == 0 {
            r = r + "\\00"
        } else if byte < 32 || byte > 126 {
            // Non-printable or non-ASCII: hex escape
            let hi = byte / 16
            let lo = byte - hi * 16
            r = r + "\\" + hex_digit(hi) + hex_digit(lo)
        } else {
            r = r + ch
        }
        i = i + 1
    }
    r
}

fn find_var(name: string) -> int {
    mut i = VAR_NAMES.length - 1
    while i >= 0 {
        if VAR_NAMES[i] == name { return i }
        i = i - 1
    }
    -1
}

// Split into 2 calls to stay under ARM64's 8-register limit
fn push_var(name: string, reg_name: string, ty: string) {
    VAR_NAMES = VAR_NAMES.push(name)
    VAR_REGS = VAR_REGS.push(reg_name)
    VAR_TYPES = VAR_TYPES.push(ty)
    VAR_STRUCT_TYPE = VAR_STRUCT_TYPE.push("")
    VAR_LIST_ELEM_TYPE = VAR_LIST_ELEM_TYPE.push("")
}

fn push_var_with_struct(name: string, reg_name: string, ty: string, stype: string) {
    VAR_NAMES = VAR_NAMES.push(name)
    VAR_REGS = VAR_REGS.push(reg_name)
    VAR_TYPES = VAR_TYPES.push(ty)
    VAR_STRUCT_TYPE = VAR_STRUCT_TYPE.push(stype)
    VAR_LIST_ELEM_TYPE = VAR_LIST_ELEM_TYPE.push("")
}

fn push_var_list(name: string, reg_name: string, ty: string, lelem: string) {
    VAR_NAMES = VAR_NAMES.push(name)
    VAR_REGS = VAR_REGS.push(reg_name)
    VAR_TYPES = VAR_TYPES.push(ty)
    VAR_STRUCT_TYPE = VAR_STRUCT_TYPE.push("")
    VAR_LIST_ELEM_TYPE = VAR_LIST_ELEM_TYPE.push(lelem)
}

mut FIND_FN_RET_RESULT: string = "i64"

fn do_find_fn_ret(name: string) {
    FIND_FN_RET_RESULT = "i64"
    mut i = 0
    while i < FN_NAMES.length {
        if FN_NAMES[i] == name {
            FIND_FN_RET_RESULT = FN_RETTYPES[i]
            return
        }
        i = i + 1
    }
}

fn find_fn_ret(name: string) -> string {
    do_find_fn_ret(name)
    FIND_FN_RET_RESULT
}

// ─── Expression parsing + IR emission ─────────────
// Returns the SSA register name holding the result

fn parse_expr() -> string {
    // Handles ||, && (lowest precedence)
    mut lhs = parse_compare()
    while true {
        if check("||") {
            advance()
            skip_nl()
            let rhs = parse_compare()
            let l1 = new_reg()
            ir_line(l1 + " = trunc i64 " + lhs + " to i1")
            let r1 = new_reg()
            ir_line(r1 + " = trunc i64 " + rhs + " to i1")
            let r = new_reg()
            ir_line(r + " = or i1 " + l1 + ", " + r1)
            let r2 = new_reg()
            ir_line(r2 + " = zext i1 " + r + " to i64")
            lhs = r2
        } else if check("&&") {
            advance()
            skip_nl()
            let rhs = parse_compare()
            let l1 = new_reg()
            ir_line(l1 + " = trunc i64 " + lhs + " to i1")
            let r1 = new_reg()
            ir_line(r1 + " = trunc i64 " + rhs + " to i1")
            let r = new_reg()
            ir_line(r + " = and i1 " + l1 + ", " + r1)
            let r2 = new_reg()
            ir_line(r2 + " = zext i1 " + r + " to i64")
            lhs = r2
        } else {
            break
        }
    }
    lhs
}

fn parse_compare() -> string {
    mut lhs = parse_arith()
    while true {
        if check("==") || check("!=") {
            let op = advance().text
            skip_nl()
            let lhs_str = LAST_IS_STR
            let rhs = parse_arith()
            if lhs_str == 1 {
                let eq_r = new_reg()
                ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
                let ext = new_reg()
                ir_line(ext + " = zext i8 " + eq_r + " to i64")
                if op == "!=" {
                    let neg = new_reg()
                    ir_line(neg + " = icmp eq i64 " + ext + ", 0")
                    let neg2 = new_reg()
                    ir_line(neg2 + " = zext i1 " + neg + " to i64")
                    lhs = neg2
                } else {
                    lhs = ext
                }
            } else {
                mut pred = "eq"
                if op == "!=" { pred = "ne" }
                let r = new_reg()
                ir_line(r + " = icmp " + pred + " i64 " + lhs + ", " + rhs)
                let r2 = new_reg()
                ir_line(r2 + " = zext i1 " + r + " to i64")
                lhs = r2
            }
            LAST_IS_STR = 0
        } else if check("<") || check(">") || check("<=") || check(">=") {
            let op = advance().text
            skip_nl()
            let lhs_str = LAST_IS_STR
            let rhs = parse_arith()
            if lhs_str == 1 {
                let cmp_r = new_reg()
                ir_line(cmp_r + " = call i64 @forge_string_compare(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
                mut pred = "slt"
                if op == ">" { pred = "sgt" }
                if op == "<=" { pred = "sle" }
                if op == ">=" { pred = "sge" }
                let r = new_reg()
                ir_line(r + " = icmp " + pred + " i64 " + cmp_r + ", 0")
                let r2 = new_reg()
                ir_line(r2 + " = zext i1 " + r + " to i64")
                lhs = r2
            } else {
                mut pred = "slt"
                if op == ">" { pred = "sgt" }
                if op == "<=" { pred = "sle" }
                if op == ">=" { pred = "sge" }
                let r = new_reg()
                ir_line(r + " = icmp " + pred + " i64 " + lhs + ", " + rhs)
                let r2 = new_reg()
                ir_line(r2 + " = zext i1 " + r + " to i64")
                lhs = r2
            }
            LAST_IS_STR = 0
        } else {
            break
        }
    }
    lhs
}

// parse_arith: combined +, -, *, /, % (reduces call depth)
fn parse_arith() -> string {
    mut lhs = parse_unary()
    mut lhs_is_str = LAST_IS_STR
    while true {
        if check("+") {
            advance()
            skip_nl()
            let rhs = parse_unary()
            let r = new_reg()
            if lhs_is_str == 1 {
                ir_line(r + " = call %ForgeString @forge_string_concat(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
                LAST_IS_STR = 1
                lhs_is_str = 1
            } else {
                ir_line(r + " = add i64 " + lhs + ", " + rhs)
                LAST_IS_STR = 0
                lhs_is_str = 0
            }
            lhs = r
        } else if check("-") {
            advance()
            skip_nl()
            let rhs = parse_unary()
            let r = new_reg()
            ir_line(r + " = sub i64 " + lhs + ", " + rhs)
            lhs = r
            LAST_IS_STR = 0
            lhs_is_str = 0
        } else if check("*") {
            advance()
            skip_nl()
            let rhs = parse_unary()
            let r = new_reg()
            ir_line(r + " = mul i64 " + lhs + ", " + rhs)
            lhs = r
        } else if check("/") {
            advance()
            skip_nl()
            let rhs = parse_unary()
            let r = new_reg()
            ir_line(r + " = sdiv i64 " + lhs + ", " + rhs)
            lhs = r
        } else if check("%") {
            advance()
            skip_nl()
            let rhs = parse_unary()
            let r = new_reg()
            ir_line(r + " = srem i64 " + lhs + ", " + rhs)
            lhs = r
        } else {
            break
        }
    }
    lhs
}

fn parse_unary() -> string {
    if check("!") {
        advance()
        let val = parse_unary()
        let t = new_reg()
        ir_line(t + " = trunc i64 " + val + " to i1")
        let n = new_reg()
        ir_line(n + " = xor i1 " + t + ", true")
        let r = new_reg()
        ir_line(r + " = zext i1 " + n + " to i64")
        return r
    }
    if check("-") {
        advance()
        let val = parse_unary()
        let r = new_reg()
        ir_line(r + " = sub i64 0, " + val)
        return r
    }
    // Inline postfix to avoid extra call depth
    mut val = parse_primary()
    mut val_is_str = read_last_is_str()
    mut val_is_list = read_last_is_list()
    mut val_list_elem = LAST_LIST_ELEM_TYPE
    mut val_struct = LAST_STRUCT_TYPE
    postfix_loop(val, val_is_str, val_is_list, val_list_elem, val_struct)
}

fn postfix_loop(val_init: string, str_init: int, list_init: int, elem_init: string, struct_init: string) -> string {
    mut val = val_init
    mut val_is_str = str_init
    mut val_is_list = list_init
    mut val_list_elem = elem_init
    mut val_struct = struct_init
    // Read type info from globals — use helper to ensure correct reading
    mut val_is_str = read_last_is_str()
    mut val_is_list = read_last_is_list()
    mut val_list_elem = LAST_LIST_ELEM_TYPE
    mut val_struct = LAST_STRUCT_TYPE
    while true {
        if check("(") {
            // Function call — save function name before parsing args
            let call_fn_name = LAST_IDENT_NAME
            advance()
            skip_nl()
            mut args: List<string> = []
            mut arg_types: List<string> = []
            while !check(")") {
                LAST_IS_STR = 0
                LAST_ENUM_TYPE = ""
                LAST_STRUCT_TYPE = ""
                let a = parse_expr()
                args = args.push(a)
                if LAST_IS_STR == 1 {
                    arg_types = arg_types.push("%ForgeString")
                } else if LAST_IS_LIST == 1 {
                    arg_types = arg_types.push("{ ptr, i64 }")
                } else if LAST_ENUM_TYPE != "" {
                    arg_types = arg_types.push("%" + LAST_ENUM_TYPE)
                } else if LAST_STRUCT_TYPE != "" {
                    arg_types = arg_types.push("%" + LAST_STRUCT_TYPE)
                } else {
                    arg_types = arg_types.push("i64")
                }
                skip_nl()
                if check(",") { advance() }
                skip_nl()
            }
            expect(")")
            // Look up return type via helper (avoids deep nesting issues)
            let call_ret = find_fn_ret(call_fn_name)
            // Build call args with inferred types
            mut arg_str = ""
            mut i = 0
            while i < args.length {
                if i > 0 { arg_str = arg_str + ", " }
                arg_str = arg_str + arg_types[i] + " " + args[i]
                i = i + 1
            }
            LAST_ENUM_TYPE = ""
            LAST_STRUCT_TYPE = ""
            if call_ret == "void" {
                ir_line("call void " + val + "(" + arg_str + ")")
                val = "0"
                LAST_IS_STR = 0
                val_is_str = 0
            } else {
                let r = new_reg()
                ir_line(r + " = call " + call_ret + " " + val + "(" + arg_str + ")")
                if call_ret == "%ForgeString" {
                    LAST_IS_STR = 1
                    val_is_str = 1
                } else if call_ret == "{ ptr, i64 }" {
                    LAST_IS_LIST = 1
                    val_is_str = 0
                    LAST_IS_STR = 0
                } else {
                    LAST_IS_STR = 0
                    val_is_str = 0
                }
                val = r
                val_struct = ""
                // Set struct/enum type from known return types
                set_type_from_llvm(call_ret)
                val_struct = LAST_STRUCT_TYPE
            }
        } else if check(".") {
            advance()
            let field = advance().text
            // List methods
            if field == "length" && val_is_list == 1 {
                let r = new_reg()
                ir_line(r + " = extractvalue { ptr, i64 } " + val + ", 1")
                val = r
                LAST_IS_LIST = 0
                LAST_IS_STR = 0
                val_is_str = 0
            } else if field == "push" && val_is_list == 1 && check("(") {
                // list.push(elem) → allocate new array, copy, add element
                let saved_elem_ty = val_list_elem
                advance()
                skip_nl()
                LAST_IS_STR = 0
                let elem = parse_expr()
                skip_nl()
                expect(")")
                // Infer element type from pushed value
                mut elem_ty = saved_elem_ty
                if LAST_IS_STR == 1 {
                    elem_ty = "%ForgeString"
                }
                LAST_LIST_ELEM_TYPE = elem_ty
                // Get old data and length
                let old_data = new_reg()
                ir_line(old_data + " = extractvalue { ptr, i64 } " + val + ", 0")
                let old_len = new_reg()
                ir_line(old_len + " = extractvalue { ptr, i64 } " + val + ", 1")
                // New length = old_len + 1
                let new_len = new_reg()
                ir_line(new_len + " = add i64 " + old_len + ", 1")
                // Alloc new array: new_len * elem_size
                let elem_size = new_reg()
                ir_line(elem_size + " = ptrtoint ptr getelementptr (" + elem_ty + ", ptr null, i32 1) to i64")
                let total = new_reg()
                ir_line(total + " = mul i64 " + elem_size + ", " + new_len)
                let new_data = new_reg()
                ir_line(new_data + " = call ptr @forge_alloc(i64 " + total + ")")
                // Copy old data: memcpy(new_data, old_data, old_len * elem_size)
                let copy_size = new_reg()
                ir_line(copy_size + " = mul i64 " + elem_size + ", " + old_len)
                ir_line("call void @llvm.memcpy.p0.p0.i64(ptr " + new_data + ", ptr " + old_data + ", i64 " + copy_size + ", i1 false)")
                // Store new element at new_data[old_len]
                let elem_ptr = new_reg()
                ir_line(elem_ptr + " = getelementptr " + elem_ty + ", ptr " + new_data + ", i64 " + old_len)
                ir_line("store " + elem_ty + " " + elem + ", ptr " + elem_ptr)
                // Build new list struct
                let ls1 = new_reg()
                ir_line(ls1 + " = insertvalue { ptr, i64 } undef, ptr " + new_data + ", 0")
                let ls2 = new_reg()
                ir_line(ls2 + " = insertvalue { ptr, i64 } " + ls1 + ", i64 " + new_len + ", 1")
                val = ls2
                LAST_IS_LIST = 1
                val_is_str = 0
            } else if field == "length" && val_is_str == 1 {
                let r = new_reg()
                ir_line(r + " = call i64 @forge_string_length(%ForgeString " + val + ")")
                val = r
                val_is_str = 0
                LAST_IS_STR = 0
            } else if field == "substring" && val_is_str == 1 && check("(") {
                // s.substring(start, end)
                advance()
                skip_nl()
                let start_arg = parse_expr()
                expect(",")
                skip_nl()
                let end_arg = parse_expr()
                skip_nl()
                expect(")")
                let r = new_reg()
                ir_line(r + " = call %ForgeString @forge_string_substring(%ForgeString " + val + ", i64 " + start_arg + ", i64 " + end_arg + ")")
                val = r
                val_is_str = 1
                LAST_IS_STR = 1
            } else if field == "index_of" && val_is_str == 1 && check("(") {
                advance()
                skip_nl()
                let needle = parse_expr()
                skip_nl()
                expect(")")
                let r = new_reg()
                ir_line(r + " = call i64 @forge_string_index_of(%ForgeString " + val + ", %ForgeString " + needle + ")")
                val = r
                val_is_str = 0
                LAST_IS_STR = 0
            } else if field == "byte_at" && val_is_str == 1 && check("(") {
                advance()
                skip_nl()
                let ba_idx = parse_expr()
                skip_nl()
                expect(")")
                let r = new_reg()
                ir_line(r + " = call i64 @forge_string_byte_at(%ForgeString " + val + ", i64 " + ba_idx + ")")
                val = r
                val_is_str = 0
                LAST_IS_STR = 0
            } else if field == "contains" && val_is_str == 1 && check("(") {
                advance()
                skip_nl()
                let needle = parse_expr()
                skip_nl()
                expect(")")
                let r = new_reg()
                ir_line(r + " = call i8 @forge_string_contains(%ForgeString " + val + ", %ForgeString " + needle + ")")
                let r2 = new_reg()
                ir_line(r2 + " = zext i8 " + r + " to i64")
                val = r2
                val_is_str = 0
                LAST_IS_STR = 0
            } else {
                // Struct member access: obj.field → extractvalue
                let struct_name = val_struct
                let si = find_struct(struct_name)
                LAST_MEMBER_OBJ_NAME = LAST_IDENT_NAME
                LAST_MEMBER_FIELD = field
                LAST_MEMBER_OBJ_REG = val
                if si >= 0 {
                    let fi = struct_field_index(si, field)
                    if fi >= 0 {
                        let fty = struct_field_type(si, fi)
                        let fty_raw = struct_field_type_raw(si, fi)
                        let r = new_reg()
                        ir_line(r + " = extractvalue %" + val_struct + " " + val + ", " + string(fi))
                        val = r
                        set_field_type(fty_raw)
                        val_is_str = read_last_is_str()
                        val_is_list = read_last_is_list()
                        val_list_elem = LAST_LIST_ELEM_TYPE
                        val_struct = LAST_STRUCT_TYPE
                    }
                }
            }
        } else if check("[") {
            advance()
            skip_nl()
            let saved_str = val_is_str
            let idx = parse_expr()
            skip_nl()
            expect("]")
            if saved_str == 1 {
                // String indexing: s[i] → forge_string_char_at(s, i)
                let r = new_reg()
                ir_line(r + " = call %ForgeString @forge_string_char_at(%ForgeString " + val + ", i64 " + idx + ")")
                val = r
                val_is_str = 1
                LAST_IS_STR = 1
            } else if val_is_list == 1 {
                // List indexing: list[i] → GEP + load
                let ety = val_list_elem
                let data_ptr = new_reg()
                ir_line(data_ptr + " = extractvalue { ptr, i64 } " + val + ", 0")
                let elem_ptr = new_reg()
                ir_line(elem_ptr + " = getelementptr " + ety + ", ptr " + data_ptr + ", i64 " + idx)
                let elem_val = new_reg()
                ir_line(elem_val + " = load " + ety + ", ptr " + elem_ptr)
                val = elem_val
                val_is_list = 0
                LAST_IS_LIST = 0
                if ety == "%ForgeString" {
                    val_is_str = 1
                    LAST_IS_STR = 1
                } else {
                    val_is_str = 0
                    LAST_IS_STR = 0
                    // If element is a struct/enum, set tracking
                    if ety.length > 1 {
                        if ety.substring(0, 1) == "%" {
                            val_struct = ety.substring(1, ety.length)
                            LAST_STRUCT_TYPE = val_struct
                        }
                    }
                }
            }
        } else {
            break
        }
    }
    val
}

fn parse_ident_expr() -> string {
    advance()
    let name = peek_prev_text()
    LAST_IDENT_NAME = name

    // Check for struct literal
    let si = find_struct(name)
    if si >= 0 && check("{") {
        advance()
        skip_nl()
        let sty = struct_llvm_type(name)
        let nfields = struct_field_count(si)
        mut cur = "undef"
        while !check("}") {
            let fname = advance().text
            mut fval = ""
            if check(":") {
                advance()
                skip_nl()
                fval = parse_expr()
            } else {
                let vi = find_var(fname)
                if vi >= 0 {
                    fval = new_reg()
                    ir_line(fval + " = load " + VAR_TYPES[vi] + ", ptr " + VAR_REGS[vi])
                } else {
                    fval = "0"
                }
            }
            let fidx = struct_field_index(si, fname)
            if fidx >= 0 {
                let fty = struct_field_type(si, fidx)
                let nr = new_reg()
                ir_line(nr + " = insertvalue " + sty + " " + cur + ", " + fty + " " + fval + ", " + string(fidx))
                cur = nr
            }
            skip_nl()
            if check(",") { advance() }
            skip_nl()
        }
        expect("}")
        LAST_STRUCT_TYPE = name
        LAST_IS_STR = 0
        return cur
    }

    // Check for enum construction
    let ei = find_enum(name)
    if ei >= 0 && check(".") {
        advance()
        let vname = advance().text
        let vidx = enum_variant_index(ei, vname)
        let ety = "%" + name
        let tag_r = new_reg()
        ir_line(tag_r + " = insertvalue " + ety + " undef, i8 " + string(vidx) + ", 0")
        let gvi = ENUM_VARIANT_STARTS[ei] + vidx
        let fc = EVAR_FIELD_COUNTS[gvi]
        mut cur = tag_r
        if fc > 0 && check("(") {
            advance()
            skip_nl()
            let fs = EVAR_FIELD_STARTS[gvi]
            mut fi = 0
            while fi < fc {
                let fval = parse_expr()
                let slot = fi + 1
                let nr = new_reg()
                ir_line(nr + " = insertvalue " + ety + " " + cur + ", i64 " + fval + ", " + string(slot))
                cur = nr
                fi = fi + 1
                skip_nl()
                if check(",") { advance() }
                skip_nl()
            }
            expect(")")
        }
        LAST_ENUM_TYPE = name
        LAST_STRUCT_TYPE = ""
        LAST_IS_STR = 0
        return cur
    }

    // Check for string() conversion
    if name == "string" && check("(") {
        advance()
        skip_nl()
        let arg = parse_expr()
        skip_nl()
        expect(")")
        let r = new_reg()
        ir_line(r + " = call %ForgeString @forge_int_to_string(i64 " + arg + ")")
        LAST_IS_STR = 1
        return r
    }

    // Check for int() conversion
    if name == "int" && check("(") {
        advance()
        skip_nl()
        let arg = parse_expr()
        skip_nl()
        expect(")")
        return arg
    }

    // Check for println/eprintln
    if (name == "println" || name == "eprintln") && check("(") {
        advance()
        skip_nl()
        let arg = parse_expr()
        skip_nl()
        expect(")")
        if name == "println" {
            ir_line("call void @forge_println_string(%ForgeString " + arg + ")")
        } else {
            ir_line("call void @forge_eprintln_string(%ForgeString " + arg + ")")
        }
        return "0"
    }

    // process.* and fs.* built-ins
    if name == "process" && check(".") {
        advance()
        let method = advance().text
        if method == "args" && check("(") {
            advance()
            expect(")")
            // Build List<string> from argc/argv
            let argc_r = new_reg()
            ir_line(argc_r + " = call i64 @forge_mini_argc()")
            // Allocate array
            let sz = new_reg()
            ir_line(sz + " = mul i64 " + argc_r + ", 16") // ForgeString = 16 bytes
            let data = new_reg()
            ir_line(data + " = call ptr @forge_alloc(i64 " + sz + ")")
            // Fill array
            let idx_a = new_reg()
            ir_line(idx_a + " = alloca i64")
            ir_line("store i64 0, ptr " + idx_a)
            let loop_l = new_label("args_loop")
            let done_l = new_label("args_done")
            ir_line("br label %" + loop_l)
            ir_raw(loop_l + ":")
            let ci = new_reg()
            ir_line(ci + " = load i64, ptr " + idx_a)
            let cmp = new_reg()
            ir_line(cmp + " = icmp slt i64 " + ci + ", " + argc_r)
            ir_line("br i1 " + cmp + ", label %" + loop_l + "_body, label %" + done_l)
            ir_raw(loop_l + "_body:")
            let arg_s = new_reg()
            ir_line(arg_s + " = call %ForgeString @forge_mini_argv(i64 " + ci + ")")
            let ep = new_reg()
            ir_line(ep + " = getelementptr %ForgeString, ptr " + data + ", i64 " + ci)
            ir_line("store %ForgeString " + arg_s + ", ptr " + ep)
            let ni = new_reg()
            ir_line(ni + " = add i64 " + ci + ", 1")
            ir_line("store i64 " + ni + ", ptr " + idx_a)
            ir_line("br label %" + loop_l)
            ir_raw(done_l + ":")
            let ls1 = new_reg()
            ir_line(ls1 + " = insertvalue { ptr, i64 } undef, ptr " + data + ", 0")
            let ls2 = new_reg()
            ir_line(ls2 + " = insertvalue { ptr, i64 } " + ls1 + ", i64 " + argc_r + ", 1")
            LAST_IS_LIST = 1
            LAST_LIST_ELEM_TYPE = "%ForgeString"
            LAST_IS_STR = 0
            return ls2
        }
        if method == "exit" && check("(") {
            advance()
            skip_nl()
            let code = parse_expr()
            skip_nl()
            expect(")")
            ir_line("call void @forge_exit(i64 " + code + ")")
            ir_line("unreachable")
            return "0"
        }
        if method == "run" && check("(") {
            advance()
            skip_nl()
            let cmd = parse_expr()
            expect(",")
            skip_nl()
            // Args is a list — for now just pass as JSON string
            let args_val = parse_expr()
            skip_nl()
            expect(")")
            // Convert list to JSON string for forge_mini_run
            // For simplicity, just call with the cmd and args as ForgeStrings
            let r = new_reg()
            ir_line(r + " = call %ForgeString @forge_mini_run(%ForgeString " + cmd + ", { ptr, i64 } " + args_val + ")")
            LAST_IS_STR = 1
            LAST_IS_LIST = 0
            return r
        }
        return "0"
    }
    if name == "fs" && check(".") {
        advance()
        let method = advance().text
        if method == "read" && check("(") {
            advance()
            skip_nl()
            let path = parse_expr()
            skip_nl()
            expect(")")
            let r = new_reg()
            ir_line(r + " = call %ForgeString @forge_read_file(%ForgeString " + path + ")")
            LAST_IS_STR = 1
            return r
        }
        if method == "write" && check("(") {
            advance()
            skip_nl()
            let path = parse_expr()
            expect(",")
            skip_nl()
            let content = parse_expr()
            skip_nl()
            expect(")")
            ir_line("call i8 @forge_write_file(%ForgeString " + path + ", %ForgeString " + content + ")")
            return "0"
        }
        return "0"
    }

    // Variable lookup
    let idx = find_var(name)
    if idx >= 0 {
        let vty = VAR_TYPES[idx]
        let r = load_var_by_type(name, idx, vty)
        return r
    }

    // Function reference — warn if common variable name
    if name == "i" || name == "pos" || name == "idx" {
        
    }
    "@" + name
}

fn peek_prev_text() -> string {
    // Return text of the token we just advanced past
    if POS > 0 {
        return TOKENS[POS - 1].text
    }
    ""
}

fn parse_primary() -> string {
    skip_nl()
    let tok: Tok = peek()

    // Integer literal
    if tok.kind == 2 {
        advance()
        return tok.text
    }

    // List literal: []
    if tok.text == "[" && tok.kind == 5 {
        advance()
        skip_nl()
        // Collect elements
        mut elems: List<string> = []
        mut elem_type = "i64"
        while !check("]") && not_at_end() {
            LAST_IS_STR = 0
            let e = parse_expr()
            elems = elems.push(e)
            if LAST_IS_STR == 1 { elem_type = "%ForgeString" }
            skip_nl()
            if check(",") { advance() }
            skip_nl()
        }
        expect("]")
        let count = elems.length
        // Allocate array
        let esize = new_reg()
        ir_line(esize + " = ptrtoint ptr getelementptr (" + elem_type + ", ptr null, i32 1) to i64")
        let total = new_reg()
        ir_line(total + " = mul i64 " + esize + ", " + string(count))
        let data_r = new_reg()
        ir_line(data_r + " = call ptr @forge_alloc(i64 " + total + ")")
        // Store elements
        mut ei = 0
        while ei < count {
            let ep = new_reg()
            ir_line(ep + " = getelementptr " + elem_type + ", ptr " + data_r + ", i64 " + string(ei))
            ir_line("store " + elem_type + " " + elems[ei] + ", ptr " + ep)
            ei = ei + 1
        }
        // Build list struct
        let ls1 = new_reg()
        ir_line(ls1 + " = insertvalue { ptr, i64 } undef, ptr " + data_r + ", 0")
        let ls2 = new_reg()
        ir_line(ls2 + " = insertvalue { ptr, i64 } " + ls1 + ", i64 " + string(count) + ", 1")
        LAST_IS_LIST = 1
        LAST_IS_STR = 0
        LAST_LIST_ELEM_TYPE = elem_type
        return ls2
    }

    // String literal
    if tok.kind == 3 {
        advance()
        let sc = new_str_const(tok.text)
        let r = new_reg()
        ir_line(r + " = call %ForgeString @forge_string_new(ptr " + sc + ", i64 " + string(tok.text.length) + ")")
        LAST_IS_STR = 1
        return r
    }

    // Bool literal
    if tok.kind == 6 {
        advance()
        if tok.text == "true" { return "1" }
        return "0"
    }

    // Parenthesized expression
    if tok.text == "(" {
        advance()
        skip_nl()
        let val = parse_expr()
        skip_nl()
        expect(")")
        return val
    }

    // Identifier — delegate to separate function to reduce size
    if tok.kind == 1 {
        return parse_ident_expr()
    }
    // (ident code moved to parse_ident_expr)

    // Print surrounding tokens for debug
    if POS > 2 {
        eprintln("  prev tokens: [" + string(POS - 3) + "]='" + TOKENS[POS - 3].text + "' [" + string(POS - 2) + "]='" + TOKENS[POS - 2].text + "' [" + string(POS - 1) + "]='" + TOKENS[POS - 1].text + "'")
        eprintln("  next tokens: [" + string(POS) + "]='" + TOKENS[POS].text + "' [" + string(POS + 1) + "]='" + TOKENS[POS + 1].text + "' [" + string(POS + 2) + "]='" + TOKENS[POS + 2].text + "'")
    }
    eprintln("unexpected token: '" + tok.text + "' kind=" + string(tok.kind) + " line " + string(tok.line) + " pos=" + string(POS))
    advance()
    "0"
}

// ─── Statement parsing + IR emission ──────────────
// Returns true if statement terminates (return/break/continue)

fn parse_let_stmt() -> bool {
    advance() // consume let/mut
    let name = advance().text
    mut ann_type = ""
    mut ann_generic = ""
    if check(":") {
        advance()
        skip_nl()
        ann_type = peek().text
        advance()
        if check("<") {
            advance()
            ann_generic = peek().text
            mut tdepth = 1
            while tdepth > 0 && POS < TOKENS.length {
                if check("<") { tdepth = tdepth + 1 }
                if check(">") { tdepth = tdepth - 1 }
                advance()
            }
        }
        if check("?") { advance() }
    }
    expect("=")
    skip_nl()
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    check_list_annotation(ann_type, ann_generic)
    let val = parse_expr()
    let alloca = new_reg()
    // Use struct type from annotations or function return type
    mut saved_struct = ""
    if ann_type != "" {
        if find_struct(ann_type) >= 0 { saved_struct = ann_type }
        if find_enum(ann_type) >= 0 { saved_struct = ann_type }
    }
    // Struct types must come from explicit annotations
    // (function return type inference is unreliable in compiled binary)
    if saved_struct != "" {
        let sty = struct_llvm_type(saved_struct)
        ir_line(alloca + " = alloca " + sty)
        ir_line("store " + sty + " " + val + ", ptr " + alloca)
        push_var_with_struct(name, alloca, sty, saved_struct)
    } else if LAST_ENUM_TYPE != "" {
        let ety = "%" + LAST_ENUM_TYPE
        ir_line(alloca + " = alloca " + ety)
        ir_line("store " + ety + " " + val + ", ptr " + alloca)
        push_var(name, alloca, ety)
    } else if is_ann_list(ann_type) {
        ir_line(alloca + " = alloca { ptr, i64 }")
        ir_line("store { ptr, i64 } " + val + ", ptr " + alloca)
        mut elet = LAST_LIST_ELEM_TYPE
        if ann_generic == "string" { elet = "%ForgeString" }
        if ann_generic == "int" { elet = "i64" }
        if find_struct(ann_generic) >= 0 { elet = "%" + ann_generic }
        if find_enum(ann_generic) >= 0 { elet = "%" + ann_generic }
        push_var_list(name, alloca, "list_" + elet, elet)
    } else if LAST_IS_LIST == 1 {
        ir_line(alloca + " = alloca { ptr, i64 }")
        ir_line("store { ptr, i64 } " + val + ", ptr " + alloca)
        push_var_list(name, alloca, "list_" + LAST_LIST_ELEM_TYPE, LAST_LIST_ELEM_TYPE)
    } else if LAST_IS_STR == 1 {
        ir_line(alloca + " = alloca %ForgeString")
        ir_line("store %ForgeString " + val + ", ptr " + alloca)
        push_var(name, alloca, "%ForgeString")
    } else {
        ir_line(alloca + " = alloca i64")
        ir_line("store i64 " + val + ", ptr " + alloca)
        // Inline push_var to avoid function call depth issues
        VAR_NAMES = VAR_NAMES.push(name)
        VAR_REGS = VAR_REGS.push(alloca)
        VAR_TYPES = VAR_TYPES.push("i64")
        VAR_STRUCT_TYPE = VAR_STRUCT_TYPE.push("")
        VAR_LIST_ELEM_TYPE = VAR_LIST_ELEM_TYPE.push("")
    }
    clear_last_ident()
    false
}

fn parse_stmt() -> bool {
    skip_nl()
    let tok: Tok = peek()
    // Reset member tracking to prevent stale field names from previous statements
    LAST_MEMBER_FIELD = ""
    LAST_MEMBER_OBJ_NAME = ""

    // let / mut
    if tok.text == "let" || tok.text == "mut" {
        return parse_let_stmt()
    }

    // return
    if tok.text == "return" {
        advance()
        skip_nl()
        if check("}") || check("\n") || POS >= TOKENS.length {
            ir_line("ret void")
            return true
        }
        let val = parse_expr()
        ir_line("ret " + CUR_RET_TY + " " + val)
        return true
    }

    // if
    if tok.text == "if" {
        advance()
        skip_nl()
        let cond = parse_expr()
        skip_nl()
        let cond_i1 = new_reg()
        ir_line(cond_i1 + " = trunc i64 " + cond + " to i1")
        let then_l = new_label("then")
        let else_l = new_label("else")
        let merge_l = new_label("merge")
        ir_line("br i1 " + cond_i1 + ", label %" + then_l + ", label %" + else_l)

        ir_raw(then_l + ":")
        BLOCK_TERMINATED = 0
        expect("{")
        skip_nl()
        while !check("}") {
            parse_block_stmt()
            skip_nl()
        }
        expect("}")
        let then_ended = ir_block_terminated()
        if then_ended == 0 { ir_line("br label %" + merge_l) }

        ir_raw(else_l + ":")
        BLOCK_TERMINATED = 0
        skip_nl()
        if check("else") {
            advance()
            skip_nl()
            if check("if") {
                parse_block_stmt()
            } else {
                expect("{")
                skip_nl()
                while !check("}") {
                    parse_block_stmt()
                    skip_nl()
                }
                expect("}")
            }
        }
        let else_ended = ir_block_terminated()
        if else_ended == 0 { ir_line("br label %" + merge_l) }

        ir_raw(merge_l + ":")
        // If both branches ended with terminators, merge is unreachable
        if then_ended == 1 && else_ended == 1 {
            ir_line("unreachable")
        }
        return false
    }

    // while
    if tok.text == "while" {
        advance()
        skip_nl()
        let cond_l = new_label("while_cond")
        let body_l = new_label("while_body")
        let end_l = new_label("while_end")

        LOOP_COND = LOOP_COND.push(cond_l)
        LOOP_END = LOOP_END.push(end_l)

        ir_line("br label %" + cond_l)
        ir_raw(cond_l + ":")
        let cond = parse_expr()
        skip_nl()
        let cond_i1 = new_reg()
        ir_line(cond_i1 + " = trunc i64 " + cond + " to i1")
        ir_line("br i1 " + cond_i1 + ", label %" + body_l + ", label %" + end_l)

        ir_raw(body_l + ":")
        expect("{")
        skip_nl()
        mut body_term = false
        while !check("}") {
            if parse_stmt() { body_term = true }
            skip_nl()
        }
        expect("}")
        if !body_term { ir_line("br label %" + cond_l) }

        // Pop loop labels
        mut new_cond: List<string> = []
        mut new_end: List<string> = []
        mut li = 0
        while li < LOOP_COND.length - 1 {
            new_cond = new_cond.push(LOOP_COND[li])
            new_end = new_end.push(LOOP_END[li])
            li = li + 1
        }
        LOOP_COND = new_cond
        LOOP_END = new_end

        ir_raw(end_l + ":")
        return false
    }

    // break
    if tok.text == "break" {
        advance()
        if LOOP_END.length > 0 {
            ir_line("br label %" + LOOP_END[LOOP_END.length - 1])
        }
        return true
    }

    // continue
    if tok.text == "continue" {
        advance()
        if LOOP_COND.length > 0 {
            ir_line("br label %" + LOOP_COND[LOOP_COND.length - 1])
        }
        return true
    }

    // for
    if tok.text == "for" {
        advance()
        let var_name = advance().text
        expect("in")
        skip_nl()
        LAST_IS_LIST = 0
        let list_val = parse_expr()
        let elem_ty = LAST_LIST_ELEM_TYPE
        skip_nl()
        // Get list data ptr and length
        let data_ptr = new_reg()
        ir_line(data_ptr + " = extractvalue { ptr, i64 } " + list_val + ", 0")
        let list_len = new_reg()
        ir_line(list_len + " = extractvalue { ptr, i64 } " + list_val + ", 1")
        // Create index variable
        let idx_alloca = new_reg()
        ir_line(idx_alloca + " = alloca i64")
        ir_line("store i64 0, ptr " + idx_alloca)
        // Loop blocks
        let cond_l = new_label("for_cond")
        let body_l = new_label("for_body")
        let incr_l = new_label("for_incr")
        let end_l = new_label("for_end")
        LOOP_COND = LOOP_COND.push(incr_l)
        LOOP_END = LOOP_END.push(end_l)
        // Cond: idx < len
        ir_line("br label %" + cond_l)
        ir_raw(cond_l + ":")
        let idx_val = new_reg()
        ir_line(idx_val + " = load i64, ptr " + idx_alloca)
        let cmp = new_reg()
        ir_line(cmp + " = icmp slt i64 " + idx_val + ", " + list_len)
        ir_line("br i1 " + cmp + ", label %" + body_l + ", label %" + end_l)
        // Body: load element, bind variable
        ir_raw(body_l + ":")
        let body_idx = new_reg()
        ir_line(body_idx + " = load i64, ptr " + idx_alloca)
        let elem_ptr = new_reg()
        ir_line(elem_ptr + " = getelementptr " + elem_ty + ", ptr " + data_ptr + ", i64 " + body_idx)
        let elem_val = new_reg()
        ir_line(elem_val + " = load " + elem_ty + ", ptr " + elem_ptr)
        let item_alloca = new_reg()
        ir_line(item_alloca + " = alloca " + elem_ty)
        ir_line("store " + elem_ty + " " + elem_val + ", ptr " + item_alloca)
        push_var(var_name, item_alloca, elem_ty)
        // Parse body
        BLOCK_TERMINATED = 0
        expect("{")
        skip_nl()
        while !check("}") {
            parse_block_stmt()
            skip_nl()
        }
        expect("}")
        let body_term = BLOCK_TERMINATED
        if body_term == 0 {
            ir_line("br label %" + incr_l)
        }
        // Increment
        ir_raw(incr_l + ":")
        let cur_idx = new_reg()
        ir_line(cur_idx + " = load i64, ptr " + idx_alloca)
        let next_idx = new_reg()
        ir_line(next_idx + " = add i64 " + cur_idx + ", 1")
        ir_line("store i64 " + next_idx + ", ptr " + idx_alloca)
        ir_line("br label %" + cond_l)
        // End
        // Pop loop labels
        mut new_cond: List<string> = []
        mut new_end: List<string> = []
        mut li = 0
        while li < LOOP_COND.length - 1 {
            new_cond = new_cond.push(LOOP_COND[li])
            new_end = new_end.push(LOOP_END[li])
            li = li + 1
        }
        LOOP_COND = new_cond
        LOOP_END = new_end
        ir_raw(end_l + ":")
        return false
    }

    // match
    if tok.text == "match" {
        advance()
        skip_nl()
        let scrutinee = parse_expr()
        let scrut_enum = LAST_ENUM_TYPE
        skip_nl()
        expect("{")
        skip_nl()
        // Extract tag
        let tag_r = new_reg()
        let ei = find_enum(scrut_enum)
        if ei >= 0 {
            ir_line(tag_r + " = extractvalue %" + scrut_enum + " " + scrutinee + ", 0")
        }
        let merge_l = new_label("match_end")
        // Parse arms
        while not_at_brace() {
            skip_nl()
            if check("_") {
                // Wildcard — already in the fallthrough block
                advance()
                expect("->")
                skip_nl()
                if check("{") {
                    expect("{")
                    skip_nl()
                    while !check("}") {
                        parse_block_stmt()
                        skip_nl()
                    }
                    expect("}")
                } else {
                    parse_stmt()
                }
                if BLOCK_TERMINATED == 0 {
                    ir_line("br label %" + merge_l)
                }
            } else if check(".") {
                // .Variant pattern
                advance()
                let vname = advance().text
                // Check for binding: .Variant(x, y)
                mut bindings: List<string> = []
                if check("(") {
                    advance()
                    skip_nl()
                    while !check(")") {
                        let bname = advance().text
                        bindings = bindings.push(bname)
                        skip_nl()
                        if check(",") { advance() }
                        skip_nl()
                    }
                    expect(")")
                }
                expect("->")
                skip_nl()
                let vidx = enum_variant_index(ei, vname)
                let arm_l = new_label("match_arm")
                let next_l = new_label("match_next")
                // Compare tag
                let cmp = new_reg()
                ir_line(cmp + " = icmp eq i8 " + tag_r + ", " + string(vidx))
                ir_line("br i1 " + cmp + ", label %" + arm_l + ", label %" + next_l)
                ir_raw(arm_l + ":")
                // Bind variant fields
                let gvi = ENUM_VARIANT_STARTS[ei] + vidx
                mut bi = 0
                while bi < bindings.length {
                    let bval = new_reg()
                    let slot = bi + 1
                    ir_line(bval + " = extractvalue %" + scrut_enum + " " + scrutinee + ", " + string(slot))
                    let balloca = new_reg()
                    ir_line(balloca + " = alloca i64")
                    ir_line("store i64 " + bval + ", ptr " + balloca)
                    push_var(bindings[bi], balloca, "i64")
                    bi = bi + 1
                }
                BLOCK_TERMINATED = 0
                if check("{") {
                    expect("{")
                    skip_nl()
                    while !check("}") {
                        parse_block_stmt()
                        skip_nl()
                    }
                    expect("}")
                } else {
                    parse_stmt()
                }
                if BLOCK_TERMINATED == 0 {
                    ir_line("br label %" + merge_l)
                }
                ir_raw(next_l + ":")
            } else {
                // Skip unknown pattern
                advance()
            }
            skip_nl()
        }
        expect("}")
        // Default: branch to merge if we fall through
        ir_line("br label %" + merge_l)
        ir_raw(merge_l + ":")
        return false
    }

    // Expression statement (or assignment)
    let val = parse_expr()
    LAST_EXPR_VAL = val
    skip_nl()
    if check("=") {
        let lhs_name = LAST_IDENT_NAME
        let member_obj = LAST_MEMBER_OBJ_NAME
        let member_field = LAST_MEMBER_FIELD
        let member_obj_reg = LAST_MEMBER_OBJ_REG
        advance()
        skip_nl()
        let rhs = parse_expr()
        // Check if LHS was a member access (obj.field = value)
        if member_field != "" && member_obj != "" {
            // Struct field assignment: load struct, insertvalue, store back
            let obj_idx = find_var(member_obj)
            if obj_idx >= 0 {
                let sty_name = VAR_TYPES[obj_idx]
                // Find struct and field index
                let st_name = sty_name.substring(1, sty_name.length)
                let si = find_struct(st_name)
                if si >= 0 {
                    let fi = struct_field_index(si, member_field)
                    if fi >= 0 {
                        let fty = struct_field_type(si, fi)
                        // Load current struct
                        let cur = new_reg()
                        ir_line(cur + " = load " + sty_name + ", ptr " + VAR_REGS[obj_idx])
                        // Insert new field value
                        let updated = new_reg()
                        ir_line(updated + " = insertvalue " + sty_name + " " + cur + ", " + fty + " " + rhs + ", " + string(fi))
                        // Store back
                        ir_line("store " + sty_name + " " + updated + ", ptr " + VAR_REGS[obj_idx])
                    }
                }
            }
        } else {
            // Simple variable assignment
            let var_idx = find_var(lhs_name)
            if var_idx >= 0 {
                let store_ty = VAR_TYPES[var_idx]
                if store_ty.length > 5 && store_ty.substring(0, 5) == "list_" {
                    ir_line("store { ptr, i64 } " + rhs + ", ptr " + VAR_REGS[var_idx])
                } else {
                    ir_line("store " + store_ty + " " + rhs + ", ptr " + VAR_REGS[var_idx])
                }
            }
        }
        LAST_MEMBER_OBJ_NAME = ""
        LAST_MEMBER_FIELD = ""
        clear_last_ident()
        return false
    }
    false
}

fn parse_type_ann() {
    // Consume a type annotation (skip it)
    advance() // type name
    if check("<") {
        advance()
        parse_type_ann()
        if check(",") {
            advance()
            skip_nl()
            parse_type_ann()
        }
        expect(">")
    }
    if check("?") { advance() }
}

// ─── Top-level parsing ────────────────────────────

fn parse_fn_decl() {
    expect("fn")
    let name = advance().text

    // Params
    expect("(")
    skip_nl()
    mut param_names: List<string> = []
    mut param_types: List<string> = []
    mut param_generics: List<string> = []
    mut param_count = 0
    while !check(")") {
        // Skip 'mut' keyword before param names
        if check("mut") { advance() }
        let pname = advance().text
        expect(":")
        skip_nl()
        let pty = peek().text
        advance()
        // Capture generic param for List<T>
        mut pty_generic = ""
        if check("<") {
            advance()
            pty_generic = peek().text
            mut ptd = 1
            while ptd > 0 && POS < TOKENS.length {
                if check("<") { ptd = ptd + 1 }
                if check(">") { ptd = ptd - 1 }
                advance()
            }
        }
        if check("?") { advance() }
        param_names = param_names.push(pname)
        param_generics = param_generics.push(pty_generic)
        mut llvm_pty = "i64"
        if pty == "string" { llvm_pty = "%ForgeString" }
        if pty == "List" {
            llvm_pty = "{ ptr, i64 }"
        }
        if find_struct(pty) >= 0 { llvm_pty = "%" + pty }
        if find_enum(pty) >= 0 { llvm_pty = "%" + pty }
        param_types = param_types.push(llvm_pty)
        param_count = param_count + 1
        skip_nl()
        if check(",") { advance() }
        skip_nl()
    }
    expect(")")
    skip_nl()

    // Return type
    mut ret_ty = "void"
    if check("->") {
        advance()
        skip_nl()
        let rt = advance().text
        if rt == "int" { ret_ty = "i64" }
        if rt == "bool" { ret_ty = "i64" }
        if rt == "string" { ret_ty = "%ForgeString" }
        if find_struct(rt) >= 0 { ret_ty = "%" + rt }
        if find_enum(rt) >= 0 { ret_ty = "%" + rt }
        if rt == "List" { ret_ty = "{ ptr, i64 }" }
        // Skip generic params
        if check("<") {
            advance()
            parse_type_ann()
            expect(">")
        }
        if check("?") { advance() }
    }
    skip_nl()

    CUR_RET_TY = ret_ty
    FN_NAMES = FN_NAMES.push(name)
    FN_RETTYPES = FN_RETTYPES.push(ret_ty)
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(param_count)
    // Build CSV of param types
    mut pt_csv = ""
    mut pti = 0
    while pti < param_count {
        if pti > 0 { pt_csv = pt_csv + "," }
        pt_csv = pt_csv + param_types[pti]
        pti = pti + 1
    }
    FN_PARAM_TYPES = FN_PARAM_TYPES.push(pt_csv)

    // Build param list string
    mut param_str = ""
    mut i = 0
    while i < param_count {
        if i > 0 { param_str = param_str + ", " }
        param_str = param_str + param_types[i] + " %" + param_names[i] + ".arg"
        i = i + 1
    }

    // Special handling for main: accept (i32 argc, ptr argv) for arg access
    if name == "main" {
        ret_ty = "i32"
        CUR_RET_TY = "i32"
        ir_raw("define i32 @main(i32 %argc, ptr %argv) {")
        ir_raw("entry:")
        ir_line("call void @forge_mini_set_args(i32 %argc, ptr %argv)")
    } else {
        ir_raw("define " + ret_ty + " @" + name + "(" + param_str + ") {")
        ir_raw("entry:")
    }

    // Reset registers and scope (keep globals)
    REG_N = 0
    LAST_EXPR_VAL = "0"
    // Truncate var lists to just globals
    let gc = GLOBAL_NAMES.length
    mut gn: List<string> = []
    mut gr: List<string> = []
    mut gt: List<string> = []
    mut gs: List<string> = []
    mut gle: List<string> = []
    mut gi2 = 0
    while gi2 < gc {
        gn = gn.push(VAR_NAMES[gi2])
        gr = gr.push(VAR_REGS[gi2])
        gt = gt.push(VAR_TYPES[gi2])
        gs = gs.push(VAR_STRUCT_TYPE[gi2])
        gle = gle.push(VAR_LIST_ELEM_TYPE[gi2])
        gi2 = gi2 + 1
    }
    VAR_NAMES = gn
    VAR_REGS = gr
    VAR_TYPES = gt
    VAR_STRUCT_TYPE = gs
    VAR_LIST_ELEM_TYPE = gle

    // Create param allocas
    mut i = 0
    while i < param_count {
        let alloca = new_reg()
        let pty = param_types[i]
        let pgen = param_generics[i]
        ir_line(alloca + " = alloca " + pty)
        ir_line("store " + pty + " %" + param_names[i] + ".arg, ptr " + alloca)
        // For List<T> params, register with list_ELEMTYPE for proper indexing
        mut var_ty = pty
        if pty == "{ ptr, i64 }" && pgen != "" {
            var_ty = "list_" + type_to_llvm(pgen)
        }
        push_var(param_names[i], alloca, var_ty)
        i = i + 1
    }

    // Parse body
    expect("{")
    skip_nl()
    mut terminated = false
    while !check("}") {
        if parse_stmt() { terminated = true }
        skip_nl()
    }
    expect("}")

    // Implicit return
    if !terminated {
        if name == "main" {
            ir_line("ret i32 0")
        } else if ret_ty == "void" {
            ir_line("ret void")
        } else {
            ir_line("ret " + ret_ty + " " + LAST_EXPR_VAL)
        }
    }

    ir_raw("}")
    ir_raw("")
}

fn skip_block() {
    // Skip a { ... } block including nested blocks
    if !check("{") { return }
    advance()
    mut depth = 1
    while depth > 0 && POS < TOKENS.length {
        if check("{") { depth = depth + 1 }
        if check("}") { depth = depth - 1 }
        advance()
    }
}

fn scan_fn_sig() {
    advance() // consume 'fn'
    let name = advance().text
    // scan fn sig
    // Skip params
    while !check("{") && !check("->") && POS < TOKENS.length { advance() }
    mut ret_ty = "void"
    if check("->") {
        advance()
        skip_nl()
        let rt = advance().text
        if rt == "int" { ret_ty = "i64" }
        if rt == "bool" { ret_ty = "i64" }
        if rt == "string" { ret_ty = "%ForgeString" }
        if find_struct(rt) >= 0 { ret_ty = "%" + rt }
        if find_enum(rt) >= 0 { ret_ty = "%" + rt }
        if rt == "List" { ret_ty = "{ ptr, i64 }" }
        // Skip generic params
        if check("<") {
            while !check(">") && POS < TOKENS.length { advance() }
            if check(">") { advance() }
        }
        if check("?") { advance() }
    }
    // Skip to body and skip it
    while !check("{") && POS < TOKENS.length { advance() }
    skip_block()
    // Register
    
    FN_NAMES = FN_NAMES.push(name)
    FN_RETTYPES = FN_RETTYPES.push(ret_ty)
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(0)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("")
}

// Global variable tracking for pass 1
mut GLOBAL_NAMES: List<string> = []
mut GLOBAL_TYPES: List<string> = []  // LLVM types

fn parse_global_decl() {
    // mut NAME: TYPE = VALUE  or  let NAME: TYPE = VALUE
    advance() // consume mut/let
    let name = advance().text
    mut gty = "i64"
    if check(":") {
        advance()
        skip_nl()
        let ty_name = peek().text
        advance()
        // Capture generic param for List<T>
        mut gen_param = ""
        if check("<") {
            advance()
            gen_param = peek().text
            // Skip rest of type
            mut td = 1
            while td > 0 && POS < TOKENS.length {
                if check("<") { td = td + 1 }
                if check(">") { td = td - 1 }
                advance()
            }
        }
        if check("?") { advance() }
        gty = type_to_llvm(ty_name)
        if ty_name == "List" {
            let ety = type_to_llvm(gen_param)
            gty = "list_" + ety
        }
    }
    // Skip = and initial value (we just zero-init globals)
    if check("=") {
        advance()
        skip_nl()
        // Skip the value expression — consume until newline
        mut depth = 0
        while POS < TOKENS.length {
            if check("\n") && depth == 0 { break }
            if check("{") || check("[") || check("(") { depth = depth + 1 }
            if check("}") || check("]") || check(")") { depth = depth - 1 }
            advance()
        }
    }
    GLOBAL_NAMES = GLOBAL_NAMES.push(name)
    GLOBAL_TYPES = GLOBAL_TYPES.push(gty)
}

fn skip_to_newline() {
    while !check("\n") && POS < TOKENS.length { advance() }
}

// ═══════════════════════════════════════════════════════════════════
// AST PARSER — builds Expr/Stmt trees (no IR emission)
// ═══════════════════════════════════════════════════════════════════

fn ast_parse_expr() -> Expr {
    ast_parse_or()
}

fn ast_parse_or() -> Expr {
    mut left = ast_parse_and()
    while check("||") {
        advance()
        skip_nl()
        let right = ast_parse_and()
        left = expr_binary("||", left, right)
    }
    left
}

fn ast_parse_and() -> Expr {
    mut left = ast_parse_compare()
    while check("&&") {
        advance()
        skip_nl()
        let right = ast_parse_compare()
        left = expr_binary("&&", left, right)
    }
    left
}

fn ast_parse_compare() -> Expr {
    mut left = ast_parse_arith()
    while check("==") || check("!=") || check("<") || check(">") || check("<=") || check(">=") {
        let op = advance().text
        skip_nl()
        let right = ast_parse_arith()
        left = expr_binary(op, left, right)
    }
    left
}

fn ast_parse_arith() -> Expr {
    mut left = ast_parse_unary()
    while check("+") || check("-") || check("*") || check("/") || check("%") {
        let op = advance().text
        skip_nl()
        let right = ast_parse_unary()
        left = expr_binary(op, left, right)
    }
    left
}

fn ast_parse_unary() -> Expr {
    if check("!") {
        advance()
        let operand = ast_parse_unary()
        return expr_unary("!", operand)
    }
    if check("-") {
        advance()
        let operand = ast_parse_unary()
        return expr_unary("-", operand)
    }
    ast_parse_postfix()
}

fn ast_parse_postfix() -> Expr {
    mut node = ast_parse_primary()
    while true {
        if check("(") {
            // Function call
            let callee = node.str_val
            advance()
            skip_nl()
            mut args: List<Expr> = []
            while not_at_paren() {
                args = args.push(ast_parse_expr())
                skip_nl()
                if check(",") { advance() }
                skip_nl()
            }
            expect(")")
            node = expr_call(callee, args)
        } else if check(".") {
            advance()
            let field = advance().text
            if check("(") {
                // Method call: obj.method(args) → treat as call with obj as context
                advance()
                skip_nl()
                mut args: List<Expr> = []
                args = args.push(node)  // obj is first arg
                while not_at_paren() {
                    args = args.push(ast_parse_expr())
                    skip_nl()
                    if check(",") { advance() }
                    skip_nl()
                }
                expect(")")
                node = expr_call(field, args)
                node.str_val = field
                // Encode as member call: kind=Call, str_val=method, children[0]=obj
            } else {
                node = expr_member(node, field)
            }
        } else if check("[") {
            advance()
            skip_nl()
            let idx = ast_parse_expr()
            skip_nl()
            expect("]")
            node = expr_index(node, idx)
        } else {
            break
        }
    }
    node
}

fn ast_parse_primary() -> Expr {
    skip_nl()
    let tok: Tok = peek()

    // Int literal
    if tok.kind == 2 {
        advance()
        return expr_int(int(tok.text))
    }

    // String literal
    if tok.kind == 3 {
        advance()
        return expr_str(tok.text)
    }

    // Bool literal
    if tok.kind == 6 {
        advance()
        return expr_bool(tok.text == "true")
    }

    // Null
    if tok.text == "null" {
        advance()
        return expr_null()
    }

    // Parenthesized expression
    if tok.text == "(" {
        advance()
        skip_nl()
        let inner = ast_parse_expr()
        skip_nl()
        expect(")")
        return inner
    }

    // List literal: [a, b, c]
    if tok.text == "[" && tok.kind == 5 {
        advance()
        skip_nl()
        mut items: List<Expr> = []
        while !check("]") && not_at_end() {
            items = items.push(ast_parse_expr())
            skip_nl()
            if check(",") { advance() }
            skip_nl()
        }
        expect("]")
        return expr_list(items)
    }

    // Identifier
    if tok.kind == 1 {
        advance()
        let name = tok.text

        // Struct literal: TypeName { field: val, ... }
        let si = find_struct(name)
        if si >= 0 && check("{") {
            advance()
            skip_nl()
            mut fields: List<Expr> = []
            // Store field names in str_val as CSV
            mut field_names = ""
            while not_at_brace() {
                let fname = advance().text
                if check(":") {
                    advance()
                    skip_nl()
                    fields = fields.push(ast_parse_expr())
                } else {
                    fields = fields.push(expr_ident(fname))
                }
                if field_names.length > 0 { field_names = field_names + "," }
                field_names = field_names + fname
                skip_nl()
                if check(",") { advance() }
                skip_nl()
            }
            expect("}")
            mut node = expr_struct(name, fields)
            node.str_val = name
            // Store field names as secondary info
            node.int_val = fields.length
            return node
        }

        // Enum construction: EnumName.Variant(args)
        let ei = find_enum(name)
        if ei >= 0 && check(".") {
            advance()
            let vname = advance().text
            mut args: List<Expr> = []
            if check("(") {
                advance()
                skip_nl()
                while not_at_paren() {
                    args = args.push(ast_parse_expr())
                    skip_nl()
                    if check(",") { advance() }
                    skip_nl()
                }
                expect(")")
            }
            return expr_enum(name + "." + vname, args)
        }

        return expr_ident(name)
    }

    // Fallback
    advance()
    expr_int(0)
}

// ─── AST Statement Parser ─────────────────────────────────────────

fn ast_parse_block() -> List<Stmt> {
    mut stmts: List<Stmt> = []
    expect("{")
    skip_nl()
    while not_at_brace() {
        stmts = stmts.push(ast_parse_stmt())
        skip_nl()
    }
    expect("}")
    stmts
}

fn ast_parse_stmt() -> Stmt {
    skip_nl()
    let tok: Tok = peek()

    // let / mut
    if tok.text == "let" || tok.text == "mut" {
        let is_mut = tok.text == "mut"
        advance()
        let name = advance().text
        mut type_ann = ""
        if check(":") {
            advance()
            skip_nl()
            type_ann = peek().text
            // Skip full type annotation
            advance()
            if check("<") {
                mut td = 1
                while td > 0 && POS < TOKENS.length {
                    if check("<") { td = td + 1 }
                    if check(">") { td = td - 1 }
                    advance()
                }
            }
            if check("?") { advance() }
        }
        expect("=")
        skip_nl()
        let value = ast_parse_expr()
        return stmt_let(name, type_ann, value, is_mut)
    }

    // return
    if tok.text == "return" {
        advance()
        skip_nl()
        if check("}") || check_kind(4) || !not_at_end() {
            return stmt_return(expr_null())
        }
        let value = ast_parse_expr()
        return stmt_return(value)
    }

    // if
    if tok.text == "if" {
        advance()
        skip_nl()
        let cond = ast_parse_expr()
        skip_nl()
        let then_body = ast_parse_block()
        skip_nl()
        mut else_stmts: List<Stmt> = []
        if check("else") {
            advance()
            skip_nl()
            if check("if") {
                // else if → wrap in list
                else_stmts = else_stmts.push(ast_parse_stmt())
            } else {
                else_stmts = ast_parse_block()
            }
        }
        return stmt_if(cond, then_body, else_stmts)
    }

    // while
    if tok.text == "while" {
        advance()
        skip_nl()
        let cond = ast_parse_expr()
        skip_nl()
        let body = ast_parse_block()
        return stmt_while(cond, body)
    }

    // for
    if tok.text == "for" {
        advance()
        let var_name = advance().text
        expect("in")
        skip_nl()
        let iterable = ast_parse_expr()
        skip_nl()
        let body = ast_parse_block()
        return stmt_for(var_name, iterable, body)
    }

    // break / continue
    if tok.text == "break" {
        advance()
        return stmt_break()
    }
    if tok.text == "continue" {
        advance()
        return stmt_continue()
    }

    // match — parse but store as if-chain for now
    if tok.text == "match" {
        // TODO: parse match into AST
        advance()
        skip_nl()
        let scrutinee = ast_parse_expr()
        skip_nl()
        expect("{")
        skip_nl()
        // Skip match body for now
        mut depth = 1
        while depth > 0 && POS < TOKENS.length {
            if check("{") { depth = depth + 1 }
            if check("}") { depth = depth - 1 }
            if depth > 0 { advance() }
        }
        expect("}")
        return stmt_expr(scrutinee)
    }

    // Expression statement (or assignment)
    let expr = ast_parse_expr()
    skip_nl()
    if check("=") {
        advance()
        skip_nl()
        let value = ast_parse_expr()
        return stmt_assign(expr, value)
    }
    stmt_expr(expr)
}

// ═══════════════════════════════════════════════════════════════════
// AST CODEGEN — walks Expr/Stmt trees and emits IR text
// ═══════════════════════════════════════════════════════════════════

// Access child Expr from a List<Expr>
fn gen_child(children: List<Expr>, idx: int) -> string {
    let child: Expr = children[idx]
    gen_expr(child)
}

fn gen_expr_child(parent: Expr, idx: int) -> string {
    gen_child(parent.children, idx)
}

fn gen_expr_from(s: Stmt, idx: int) -> string {
    gen_child(s.exprs, idx)
}

fn gen_expr(e: Expr) -> string {
    match e.kind {
        .IntLit -> {
            return string(e.int_val)
        }
        .StrLit -> {
            let sc = new_str_const(e.str_val)
            let r = new_reg()
            ir_line(r + " = call %ForgeString @forge_string_new(ptr " + sc + ", i64 " + string(e.str_val.length) + ")")
            LAST_IS_STR = 1
            return r
        }
        .BoolLit -> {
            return string(e.int_val)
        }
        .Null -> {
            return "zeroinitializer"
        }
        .Ident -> {
            return gen_ident(e.str_val)
        }
        .Binary -> {
            let lhs = gen_expr_child(e, 0)
            let lhs_str = LAST_IS_STR
            let rhs = gen_expr_child(e, 1)
            return gen_binary(e.str_val, lhs, rhs, lhs_str)
        }
        .Unary -> {
            let val = gen_expr_child(e, 0)
            let r = new_reg()
            if e.str_val == "!" {
                let t = new_reg()
                ir_line(t + " = trunc i64 " + val + " to i1")
                let n = new_reg()
                ir_line(n + " = xor i1 " + t + ", true")
                ir_line(r + " = zext i1 " + n + " to i64")
            } else {
                ir_line(r + " = sub i64 0, " + val)
            }
            return r
        }
        .Call -> {
            return gen_call(e)
        }
        .Member -> {
            let obj = gen_expr_child(e, 0)
            return gen_member(obj, e.str_val)
        }
        .Index -> {
            let obj = gen_expr_child(e, 0)
            let obj_is_str = LAST_IS_STR
            let obj_is_list = LAST_IS_LIST
            let elem_ty = LAST_LIST_ELEM_TYPE
            let idx = gen_expr_child(e, 1)
            if obj_is_str == 1 {
                let r = new_reg()
                ir_line(r + " = call %ForgeString @forge_string_char_at(%ForgeString " + obj + ", i64 " + idx + ")")
                LAST_IS_STR = 1
                return r
            }
            if obj_is_list == 1 {
                let dp = new_reg()
                ir_line(dp + " = extractvalue { ptr, i64 } " + obj + ", 0")
                let ep = new_reg()
                ir_line(ep + " = getelementptr " + elem_ty + ", ptr " + dp + ", i64 " + idx)
                let ev = new_reg()
                ir_line(ev + " = load " + elem_ty + ", ptr " + ep)
                LAST_IS_LIST = 0
                set_field_type(elem_ty)
                return ev
            }
            return obj
        }
        .ListLit -> {
            let count = e.children.length
            mut elem_type = "i64"
            // Emit elements and collect registers
            mut elem_regs: List<string> = []
            mut ei = 0
            while ei < count {
                LAST_IS_STR = 0
                let ev = gen_expr_child(e, ei)
                elem_regs = elem_regs.push(ev)
                if LAST_IS_STR == 1 { elem_type = "%ForgeString" }
                ei = ei + 1
            }
            // Allocate array
            let esize = new_reg()
            ir_line(esize + " = ptrtoint ptr getelementptr (" + elem_type + ", ptr null, i32 1) to i64")
            let total = new_reg()
            ir_line(total + " = mul i64 " + esize + ", " + string(count))
            let data = new_reg()
            ir_line(data + " = call ptr @forge_alloc(i64 " + total + ")")
            // Store elements
            ei = 0
            while ei < count {
                let ep = new_reg()
                ir_line(ep + " = getelementptr " + elem_type + ", ptr " + data + ", i64 " + string(ei))
                ir_line("store " + elem_type + " " + elem_regs[ei] + ", ptr " + ep)
                ei = ei + 1
            }
            let ls1 = new_reg()
            ir_line(ls1 + " = insertvalue { ptr, i64 } undef, ptr " + data + ", 0")
            let ls2 = new_reg()
            ir_line(ls2 + " = insertvalue { ptr, i64 } " + ls1 + ", i64 " + string(count) + ", 1")
            LAST_IS_LIST = 1
            LAST_IS_STR = 0
            LAST_LIST_ELEM_TYPE = elem_type
            return ls2
        }
        _ -> {
            return "0"
        }
    }
    "0"
}

fn gen_ident(name: string) -> string {
    // Built-in namespace handling
    if name == "process" || name == "fs" {
        return "@" + name
    }
    // Variable lookup
    let idx = find_var(name)
    if idx >= 0 {
        let vty = VAR_TYPES[idx]
        return load_var_by_type(name, idx, vty)
    }
    // Function reference
    "@" + name
}

fn gen_binary(op: string, lhs: string, rhs: string, lhs_str: int) -> string {
    let r = new_reg()
    if op == "+" && lhs_str == 1 {
        ir_line(r + " = call %ForgeString @forge_string_concat(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        LAST_IS_STR = 1
        return r
    }
    if op == "==" && lhs_str == 1 {
        let eq_r = new_reg()
        ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        ir_line(r + " = zext i8 " + eq_r + " to i64")
        LAST_IS_STR = 0
        return r
    }
    if op == "!=" && lhs_str == 1 {
        let eq_r = new_reg()
        ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        let ext = new_reg()
        ir_line(ext + " = zext i8 " + eq_r + " to i64")
        ir_line(r + " = icmp eq i64 " + ext + ", 0")
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        LAST_IS_STR = 0
        return r2
    }
    if (op == "<" || op == ">" || op == "<=" || op == ">=") && lhs_str == 1 {
        let cmp_r = new_reg()
        ir_line(cmp_r + " = call i64 @forge_string_compare(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        mut pred = "slt"
        if op == ">" { pred = "sgt" }
        if op == "<=" { pred = "sle" }
        if op == ">=" { pred = "sge" }
        ir_line(r + " = icmp " + pred + " i64 " + cmp_r + ", 0")
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        LAST_IS_STR = 0
        return r2
    }
    LAST_IS_STR = 0
    // Integer operations
    if op == "+" {
        ir_line(r + " = add i64 " + lhs + ", " + rhs)
        return r
    }
    if op == "-" {
        ir_line(r + " = sub i64 " + lhs + ", " + rhs)
        return r
    }
    if op == "*" {
        ir_line(r + " = mul i64 " + lhs + ", " + rhs)
        return r
    }
    if op == "/" {
        ir_line(r + " = sdiv i64 " + lhs + ", " + rhs)
        return r
    }
    if op == "%" {
        ir_line(r + " = srem i64 " + lhs + ", " + rhs)
        return r
    }
    // Comparisons
    mut pred = "eq"
    if op == "!=" { pred = "ne" }
    if op == "<" { pred = "slt" }
    if op == ">" { pred = "sgt" }
    if op == "<=" { pred = "sle" }
    if op == ">=" { pred = "sge" }
    if op == "&&" {
        let l1 = new_reg()
        ir_line(l1 + " = trunc i64 " + lhs + " to i1")
        let r1 = new_reg()
        ir_line(r1 + " = trunc i64 " + rhs + " to i1")
        ir_line(r + " = and i1 " + l1 + ", " + r1)
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        return r2
    }
    if op == "||" {
        let l1 = new_reg()
        ir_line(l1 + " = trunc i64 " + lhs + " to i1")
        let r1 = new_reg()
        ir_line(r1 + " = trunc i64 " + rhs + " to i1")
        ir_line(r + " = or i1 " + l1 + ", " + r1)
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        return r2
    }
    ir_line(r + " = icmp " + pred + " i64 " + lhs + ", " + rhs)
    let r2 = new_reg()
    ir_line(r2 + " = zext i1 " + r + " to i64")
    r2
}

fn gen_call(e: Expr) -> string {
    let name = e.str_val
    // Built-in: string(x)
    if name == "string" && e.children.length == 1 {
        let arg = gen_expr_child(e, 0)
        let r = new_reg()
        ir_line(r + " = call %ForgeString @forge_int_to_string(i64 " + arg + ")")
        LAST_IS_STR = 1
        return r
    }
    // Built-in: println/eprintln
    if name == "println" || name == "eprintln" {
        let arg = gen_expr_child(e, 0)
        if name == "println" {
            ir_line("call void @forge_println_string(%ForgeString " + arg + ")")
        } else {
            ir_line("call void @forge_eprintln_string(%ForgeString " + arg + ")")
        }
        return "0"
    }
    // Regular function call
    let call_ret = find_fn_ret(name)
    mut arg_str = ""
    mut i = 0
    while i < e.children.length {
        if i > 0 { arg_str = arg_str + ", " }
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        let a = gen_expr_child(e, i)
        mut aty = "i64"
        if LAST_IS_STR == 1 { aty = "%ForgeString" }
        if LAST_IS_LIST == 1 { aty = "{ ptr, i64 }" }
        if LAST_STRUCT_TYPE != "" { aty = "%" + LAST_STRUCT_TYPE }
        if LAST_ENUM_TYPE != "" { aty = "%" + LAST_ENUM_TYPE }
        arg_str = arg_str + aty + " " + a
        i = i + 1
    }
    if call_ret == "void" {
        ir_line("call void @" + name + "(" + arg_str + ")")
        return "0"
    }
    let r = new_reg()
    ir_line(r + " = call " + call_ret + " @" + name + "(" + arg_str + ")")
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    set_type_from_llvm(call_ret)
    r
}

fn gen_member(obj: string, field: string) -> string {
    // String methods
    if LAST_IS_STR == 1 {
        if field == "length" {
            let r = new_reg()
            ir_line(r + " = call i64 @forge_string_length(%ForgeString " + obj + ")")
            LAST_IS_STR = 0
            return r
        }
    }
    // List methods
    if LAST_IS_LIST == 1 {
        if field == "length" {
            let r = new_reg()
            ir_line(r + " = extractvalue { ptr, i64 } " + obj + ", 1")
            LAST_IS_LIST = 0
            LAST_IS_STR = 0
            return r
        }
    }
    // Struct field access
    let sname = LAST_STRUCT_TYPE
    let si = find_struct(sname)
    if si >= 0 {
        let fi = struct_field_index(si, field)
        if fi >= 0 {
            let fty = struct_field_type(si, fi)
            let fty_raw = struct_field_type_raw(si, fi)
            let r = new_reg()
            ir_line(r + " = extractvalue %" + sname + " " + obj + ", " + string(fi))
            set_field_type(fty_raw)
            return r
        }
    }
    obj
}

fn gen_stmt(s: Stmt) -> bool {
    match s.kind {
        .Let -> {
            let val = gen_expr_from(s, 0)
            let alloca = new_reg()
            let name = s.str_val
            // Determine type from annotation or inference
            mut ty = "i64"
            if LAST_IS_STR == 1 { ty = "%ForgeString" }
            if LAST_IS_LIST == 1 { ty = "{ ptr, i64 }" }
            if LAST_STRUCT_TYPE != "" { ty = "%" + LAST_STRUCT_TYPE }
            if LAST_ENUM_TYPE != "" { ty = "%" + LAST_ENUM_TYPE }
            // Prefer annotation
            if s.str2 == "string" { ty = "%ForgeString" }
            if s.str2 == "List" { ty = "{ ptr, i64 }" }
            if find_struct(s.str2) >= 0 { ty = "%" + s.str2 }
            if find_enum(s.str2) >= 0 { ty = "%" + s.str2 }
            ir_line(alloca + " = alloca " + ty)
            ir_line("store " + ty + " " + val + ", ptr " + alloca)
            push_var(name, alloca, ty)
            clear_last_ident()
            return false
        }
        .Return -> {
            let val = gen_expr_from(s, 0)
            ir_line("ret " + CUR_RET_TY + " " + val)
            return true
        }
        .ExprStmt -> {
            let val = gen_expr_from(s, 0)
            LAST_EXPR_VAL = val
            return false
        }
        .If -> {
            let cond = gen_expr_from(s, 0)
            let cond_i1 = new_reg()
            ir_line(cond_i1 + " = trunc i64 " + cond + " to i1")
            let then_l = new_label("then")
            let else_l = new_label("else")
            let merge_l = new_label("merge")
            ir_line("br i1 " + cond_i1 + ", label %" + then_l + ", label %" + else_l)
            // Then
            ir_raw(then_l + ":")
            let then_ended = gen_block(s.body)
            if then_ended == 0 { ir_line("br label %" + merge_l) }
            // Else
            ir_raw(else_l + ":")
            let else_ended = gen_block(s.else_body)
            if else_ended == 0 { ir_line("br label %" + merge_l) }
            // Merge
            ir_raw(merge_l + ":")
            if then_ended == 1 && else_ended == 1 {
                ir_line("unreachable")
                return true
            }
            return false
        }
        .While -> {
            let cond_l = new_label("while_cond")
            let body_l = new_label("while_body")
            let end_l = new_label("while_end")
            LOOP_COND = LOOP_COND.push(cond_l)
            LOOP_END = LOOP_END.push(end_l)
            ir_line("br label %" + cond_l)
            ir_raw(cond_l + ":")
            let cond = gen_expr_from(s, 0)
            let cond_i1 = new_reg()
            ir_line(cond_i1 + " = trunc i64 " + cond + " to i1")
            ir_line("br i1 " + cond_i1 + ", label %" + body_l + ", label %" + end_l)
            ir_raw(body_l + ":")
            let body_ended = gen_block(s.body)
            if body_ended == 0 { ir_line("br label %" + cond_l) }
            // Pop loop labels
            mut new_cond: List<string> = []
            mut new_end: List<string> = []
            mut li = 0
            while li < LOOP_COND.length - 1 {
                new_cond = new_cond.push(LOOP_COND[li])
                new_end = new_end.push(LOOP_END[li])
                li = li + 1
            }
            LOOP_COND = new_cond
            LOOP_END = new_end
            ir_raw(end_l + ":")
            return false
        }
        .Break -> {
            if LOOP_END.length > 0 {
                ir_line("br label %" + LOOP_END[LOOP_END.length - 1])
            }
            return true
        }
        .Continue -> {
            if LOOP_COND.length > 0 {
                ir_line("br label %" + LOOP_COND[LOOP_COND.length - 1])
            }
            return true
        }
        .Assign -> {
            let target: Expr = s.exprs[0]
            let val = gen_expr_from(s, 1)
            // Simple variable assignment
            match target.kind {
                .Ident -> {
                    let var_idx = find_var(target.str_val)
                    if var_idx >= 0 {
                        let store_ty = VAR_TYPES[var_idx]
                        let load_ty = get_load_type(store_ty)
                        ir_line("store " + load_ty + " " + val + ", ptr " + VAR_REGS[var_idx])
                    }
                }
                _ -> {}
            }
            return false
        }
        _ -> {
            return false
        }
    }
    false
}

fn gen_block(stmts: List<Stmt>) -> int {
    mut terminated = 0
    mut i = 0
    while i < stmts.length {
        let s: Stmt = stmts[i]
        if gen_stmt(s) {
            terminated = 1
        }
        i = i + 1
    }
    terminated
}

// ═══════════════════════════════════════════════════════════════════
// COMPILE + MAIN
// ═══════════════════════════════════════════════════════════════════

fn compile(source: string) -> string {
    TOKENS = tokenize(source)
    POS = 0
    IR = ""
    STR_DECLS = ""
    STR_N = 0
    STRUCT_NAMES = []
    STRUCT_FIELD_STARTS = []
    STRUCT_FIELD_COUNTS = []
    SFIELD_NAMES = []
    SFIELD_TYPES = []
    ENUM_NAMES = []
    ENUM_VARIANT_STARTS = []
    ENUM_VARIANT_COUNTS = []
    EVAR_NAMES = []
    EVAR_FIELD_STARTS = []
    EVAR_FIELD_COUNTS = []
    EFIELD_NAMES = []
    EFIELD_TYPES = []
    GLOBAL_NAMES = []
    GLOBAL_TYPES = []

    // Pass 1: scan for type declarations only
    skip_nl()
    while POS < TOKENS.length && peek().kind != 0 {
        let tok: Tok = peek()
        if tok.text == "export" {
            advance()
            skip_nl()
            if check("type") {
                parse_type_decl_top()
            } else if check("enum") {
                parse_enum_decl_top()
            } else if check("fn") {
                scan_fn_sig()
            } else if check("mut") || check("let") {
                parse_global_decl()
            } else {
                skip_to_newline()
            }
        } else if tok.text == "type" {
            parse_type_decl_top()
        } else if tok.text == "fn" {
            scan_fn_sig()
        } else if tok.text == "enum" {
            parse_enum_decl_top()
        } else if tok.text == "mut" || tok.text == "let" {
            parse_global_decl()
        } else if tok.text == "impl" {
            advance()
            while !check("{") && POS < TOKENS.length { advance() }
            skip_block()
        } else {
            advance()
        }
        skip_nl()
    }

    // Pass 2: reset and compile functions
    POS = 0

    // IR header
    ir_raw("target datalayout = \"e-m:o-i64:64-i128:128-n32:64-S128\"")
    ir_raw("")
    ir_raw("%ForgeString = type { ptr, i64 }")
    // Emit struct type declarations
    mut sti = 0
    while sti < STRUCT_NAMES.length {
        let sname = STRUCT_NAMES[sti]
        let nf = struct_field_count(sti)
        mut fields_ir = ""
        mut fi = 0
        while fi < nf {
            if fi > 0 { fields_ir = fields_ir + ", " }
            fields_ir = fields_ir + struct_field_type(sti, fi)
            fi = fi + 1
        }
        ir_raw("%" + sname + " = type { " + fields_ir + " }")
        sti = sti + 1
    }
    // Emit enum type declarations
    mut ei = 0
    while ei < ENUM_NAMES.length {
        let ename = ENUM_NAMES[ei]
        ir_raw("%" + ename + " = type " + enum_llvm_type_str(ei))
        ei = ei + 1
    }
    // Emit global variable declarations
    mut gi = 0
    while gi < GLOBAL_NAMES.length {
        let gname = GLOBAL_NAMES[gi]
        let gty = GLOBAL_TYPES[gi]
        // For list types, emit { ptr, i64 } but register with list_elemtype
        mut emit_ty = gty
        if is_list_type(gty) {
            emit_ty = "{ ptr, i64 }"
        }
        ir_raw("@" + gname + " = global " + emit_ty + " zeroinitializer")
        push_var(gname, "@" + gname, gty)
        gi = gi + 1
    }
    ir_raw("")
    ir_raw("declare %ForgeString @forge_string_new(ptr, i64)")
    ir_raw("declare %ForgeString @forge_string_concat(%ForgeString, %ForgeString)")
    ir_raw("declare i64 @forge_string_length(%ForgeString)")
    ir_raw("declare %ForgeString @forge_int_to_string(i64)")
    ir_raw("declare void @forge_print_string(%ForgeString)")
    ir_raw("declare void @forge_println_string(%ForgeString)")
    ir_raw("declare void @forge_eprintln_string(%ForgeString)")
    ir_raw("declare %ForgeString @forge_string_char_at(%ForgeString, i64)")
    ir_raw("declare %ForgeString @forge_string_substring(%ForgeString, i64, i64)")
    ir_raw("declare i64 @forge_string_index_of(%ForgeString, %ForgeString)")
    ir_raw("declare i64 @forge_string_compare(%ForgeString, %ForgeString)")
    ir_raw("declare i8 @forge_string_eq(%ForgeString, %ForgeString)")
    ir_raw("declare ptr @forge_alloc(i64)")
    ir_raw("declare i32 @puts(ptr)")
    ir_raw("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    // Mini compiler helpers
    ir_raw("declare void @forge_mini_set_args(i32, ptr)")
    ir_raw("declare i64 @forge_mini_argc()")
    ir_raw("declare %ForgeString @forge_mini_argv(i64)")
    ir_raw("declare %ForgeString @forge_mini_run(%ForgeString, { ptr, i64 })")
    ir_raw("declare void @forge_exit(i64)")
    ir_raw("declare %ForgeString @forge_read_file(%ForgeString)")
    ir_raw("declare i8 @forge_write_file(%ForgeString, %ForgeString)")
    ir_raw("declare i8 @forge_string_contains(%ForgeString, %ForgeString)")
    ir_raw("declare i64 @forge_string_byte_at(%ForgeString, i64)")
    ir_raw("declare void @forge_mini_write_file(%ForgeString, %ForgeString)")
    ir_raw("declare void @forge_mini_write_debug(%ForgeString, %ForgeString)")
    ir_raw("declare i8 @forge_fs_write_string(ptr, i64, ptr, i64)")
    ir_raw("")

    // Parse top-level
    skip_nl()
    while POS < TOKENS.length && peek().kind != 0 {
        let tok: Tok = peek()

        if tok.text == "fn" {
            
            parse_fn_decl()
        } else if tok.text == "export" {
            advance()
            skip_nl()
            if check("fn") {
                parse_fn_decl()
            } else if check("type") {
                parse_type_decl_top()
            } else {
                skip_to_newline()
            }
        } else if tok.text == "use" || tok.text == "mod" || tok.text == "type" || tok.text == "enum" || tok.text == "impl" || tok.text == "let" || tok.text == "mut" {
            // Skip declarations we don't handle yet
            if tok.text == "impl" {
                advance()
                while !check("{") && POS < TOKENS.length { advance() }
                skip_block()
            } else if tok.text == "type" {
                parse_type_decl_top()
            } else if tok.text == "enum" {
                // Already parsed in pass 1, skip
                advance() // enum
                advance() // name
                expect("{")
                skip_nl()
                while not_at_brace() { advance() }
                if check("}") { advance() }
            } else {
                skip_to_newline()
            }
        } else {
            advance()
        }
        skip_nl()
    }

    // Build final IR: header + string constants + functions
    // The header is already at the top of IR. Insert STR_DECLS after header, before functions.
    // Since we can't easily split, just prepend STR_DECLS to the function definitions.
    let final_ir = STR_DECLS + "\n" + IR
    final_ir
}

// ═══════════════════════════════════════════════════════════════════
// MAIN
// ═══════════════════════════════════════════════════════════════════

fn main() {
    let args = process.args()

    if args.length < 3 {
        eprintln("mini-forge v0.1 - minimal self-hosted compiler")
        eprintln("Usage: mini build <file.fg> [output]")
        process.exit(1)
    }

    let command = args[1]
    let input = args[2]
    let source = fs.read(input)

    if source.length == 0 {
        eprintln("error: could not read " + input)
        process.exit(1)
    }

    eprintln("  lex + parse + codegen: " + input)
    compile(source)
    eprintln("  IR: " + string(IR.length) + " + " + string(STR_DECLS.length) + " chars")

    // Write combined IR: string constants + header + functions
    let ir_path = "/tmp/mini_output.ll"
    let full_ir = IR + "\n" + STR_DECLS
    fs.write(ir_path, full_ir)
    let written = fs.read(ir_path)
    eprintln("  wrote " + string(written.length) + " chars to " + ir_path)

    // Compile
    mut output = "a.out"
    if args.length > 3 { output = args[3] }

    let llc_result = process.run("/opt/homebrew/opt/llvm@18/bin/llc", ["-O2", "-filetype=obj", ir_path, "-o", "/tmp/mini_output.o"])
    if !llc_result.contains("\"code\":0") {
        eprintln("error: llc failed")
        eprintln(llc_result)
        // Write IR for debugging
        eprintln("IR written to " + ir_path)
        process.exit(1)
    }

    let rt_result = process.run("cc", ["-c", "-O0", "stdlib/runtime.c", "-o", "/tmp/mini_runtime.o"])
    let link_result = process.run("cc", ["-o", output, "/tmp/mini_output.o", "/tmp/mini_runtime.o", "-lm"])
    if !link_result.contains("\"code\":0") {
        eprintln("error: linker failed")
        eprintln(link_result)
        process.exit(1)
    }

    println("compiled: " + output)
}
