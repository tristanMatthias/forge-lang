// ─── Code Generator ────────────────────────────
// Emits LLVM IR for Forge programs. Feature codegen dispatched via registry.

use core.types.Type
use core.ast.{Program, Statement, Expr, Block, BinOp, UnaryOp, FeatureStmt, FeatureExpr, NodeRef}
use core.registry.REGISTRY
use @std.llvm

// ─── Types ─────────────────────────────────────

export type Codegen = {
    ctx: ptr,
    module: ptr,
    builder: ptr,
    i64_type: ptr,
    i32_type: ptr,
    i8_type: ptr,
    void_type: ptr,
    ptr_type: ptr,
    f64_type: ptr,
    string_type: ptr,
    rt_println: ptr,
    rt_int_to_str: ptr,
    rt_str_new: ptr,
    mut current_fn: ptr?,
    mut functions: Map<string, ptr>,
    mut vars: Map<string, ptr>,
}

export fn codegen_new() -> Codegen {
    Codegen {
        ctx: null, module: null, builder: null,
        i64_type: null, i32_type: null, i8_type: null,
        void_type: null, ptr_type: null, f64_type: null,
        string_type: null,
        rt_println: null, rt_int_to_str: null, rt_str_new: null,
        current_fn: null, functions: {}, vars: {},
    }
}

fn make_fn_type(ret: ptr, params: List<ptr>) -> ptr {
    let arr = llvm.type_array_new(params.length)
    mut i = 0
    for p in params {
        llvm.type_array_set(arr, i, p)
        i = i + 1
    }
    let ft = llvm.function_type(ret, arr, params.length, 0)
    llvm.type_array_free(arr)
    ft
}

// ─── Codegen Methods ───────────────────────────

impl Codegen {

    // ─── Initialization ────────────────────────

    fn init(self, name: string) {
        self.ctx = llvm.context_create()
        self.module = llvm.module_create(name, self.ctx)
        self.builder = llvm.create_builder(self.ctx)
        self.init_types()
        self.init_runtime()
    }

    fn init_types(self) {
        self.i64_type = llvm.int64_type(self.ctx)
        self.i32_type = llvm.int32_type(self.ctx)
        self.i8_type = llvm.int8_type(self.ctx)
        self.void_type = llvm.void_type(self.ctx)
        self.ptr_type = llvm.pointer_type(self.ctx)
        self.f64_type = llvm.double_type(self.ctx)
        let sf = llvm.type_array_new(2)
        llvm.type_array_set(sf, 0, self.ptr_type)
        llvm.type_array_set(sf, 1, self.i64_type)
        self.string_type = llvm.struct_type(self.ctx, sf, 2, 0)
        llvm.type_array_free(sf)
    }

    fn init_runtime(self) {
        let pt = make_fn_type(self.void_type, [self.ptr_type, self.i64_type])
        self.rt_println = llvm.add_function(self.module, "forge_println", pt)
        let it = make_fn_type(self.string_type, [self.i64_type])
        self.rt_int_to_str = llvm.add_function(self.module, "forge_int_to_string", it)
        let sn = make_fn_type(self.string_type, [self.ptr_type, self.i64_type])
        self.rt_str_new = llvm.add_function(self.module, "forge_string_new", sn)
    }

    // ─── Finalization ──────────────────────────

    fn verify(self) -> bool { llvm.verify_module(self.module) == 0 }
    fn dispose(self) {
        llvm.dispose_builder(self.builder)
        llvm.module_dispose(self.module)
        llvm.context_dispose(self.ctx)
    }

    // ─── Program ───────────────────────────────

    fn emit_program(self, program: Program) {
        // Wrap everything in main() for now
        let params = llvm.type_array_new(0)
        let mt = llvm.function_type(self.i32_type, params, 0, 0)
        llvm.type_array_free(params)
        let mf = llvm.add_function(self.module, "main", mt)
        self.current_fn = mf
        let entry = llvm.append_basic_block(self.ctx, mf, "entry")
        llvm.position_at_end(self.builder, entry)

        for stmt in program.statements {
            self.emit_statement(stmt)
        }

        let zero = llvm.const_int(self.i32_type, 0, 0)
        llvm.build_ret(self.builder, zero)
    }

    // ─── Statements ────────────────────────────

    fn emit_statement(self, stmt: Statement) {
        match stmt {
            .Expr(expr) -> { self.emit_expr(expr) }
            .Assign(target, value, span) -> {}
            .Return(value, span) -> { self.emit_return(value) }
            .Feature(fe) -> { self.dispatch_stmt(fe) }
        }
    }

    fn emit_return(self, value: Expr?) {
        if value != null {
            let val = self.emit_expr(value!)
            llvm.build_ret(self.builder, val)
        } else {
            llvm.build_ret_void(self.builder)
        }
    }

    fn dispatch_stmt(self, fe: FeatureStmt) {
        let fid = fe.data.feature
        if REGISTRY.emit_stmt.has(fid) {
            let handler = REGISTRY.emit_stmt[fid]
            handler(self, fe.data)
        }
    }

    fn dispatch_expr(self, fe: FeatureExpr) -> ptr {
        let fid = fe.data.feature
        if REGISTRY.emit_expr.has(fid) {
            let handler = REGISTRY.emit_expr[fid]
            return handler(self, fe.data)
        }
        llvm.const_int(self.i64_type, 0, 0)
    }

    // ─── Expressions ───────────────────────────

    fn emit_expr(self, expr: Expr) -> ptr {
        match expr {
            .IntLit(value, span) -> { return llvm.const_int(self.i64_type, value, 0) }
            .FloatLit(value, span) -> { return llvm.const_real(self.f64_type, value) }
            .StringLit(value, span) -> { return self.emit_string(value) }
            .BoolLit(value, span) -> { return llvm.const_int(self.i8_type, if value { 1 } else { 0 }, 0) }
            .NullLit(span) -> { return llvm.const_null(self.ptr_type) }
            .Ident(name, span) -> { return self.emit_ident(name) }
            .Binary(left, op, right, span) -> { return self.emit_binary(left, op, right) }
            .Unary(op, operand, span) -> { return self.emit_expr(operand) }
            .Call(callee, args, span) -> { return self.emit_call(callee, args) }
            .MemberAccess(obj, field, span) -> { return llvm.const_int(self.i64_type, 0, 0) }
            .Index(obj, idx, span) -> { return llvm.const_int(self.i64_type, 0, 0) }
            .Block(block) -> { return self.emit_block(block) }
            .Feature(fe) -> { return self.dispatch_expr(fe) }
        }
        llvm.const_int(self.i64_type, 0, 0)
    }

    fn emit_string(self, value: string) -> ptr {
        let raw = llvm.build_global_string_ptr(self.builder, value, "str")
        let len = llvm.const_int(self.i64_type, value.length, 0)
        // Call forge_string_new(ptr, len) → ForgeString
        let ca = llvm.value_array_new(2)
        llvm.value_array_set(ca, 0, raw)
        llvm.value_array_set(ca, 1, len)
        let ft = make_fn_type(self.string_type, [self.ptr_type, self.i64_type])
        let result = llvm.build_call(self.builder, ft, self.rt_str_new, ca, 2, "str")
        llvm.value_array_free(ca)
        result
    }

    fn emit_ident(self, name: string) -> ptr {
        if self.vars.has(name) {
            return llvm.build_load(self.builder, self.i64_type, self.vars[name], name)
        }
        if self.functions.has(name) {
            return self.functions[name]
        }
        llvm.const_int(self.i64_type, 0, 0)
    }

    fn emit_binary(self, left: Expr, op: BinOp, right: Expr) -> ptr {
        let lhs = self.emit_expr(left)
        let rhs = self.emit_expr(right)
        match op {
            .Add -> { return llvm.build_add(self.builder, lhs, rhs, "add") }
            .Sub -> { return llvm.build_sub(self.builder, lhs, rhs, "sub") }
            .Mul -> { return llvm.build_mul(self.builder, lhs, rhs, "mul") }
            .Div -> { return llvm.build_sdiv(self.builder, lhs, rhs, "div") }
            .Mod -> { return llvm.build_srem(self.builder, lhs, rhs, "mod") }
            .Eq -> { return llvm.build_icmp(self.builder, 32, lhs, rhs, "eq") }
            .NotEq -> { return llvm.build_icmp(self.builder, 33, lhs, rhs, "ne") }
            .Lt -> { return llvm.build_icmp(self.builder, 40, lhs, rhs, "lt") }
            .LtEq -> { return llvm.build_icmp(self.builder, 41, lhs, rhs, "le") }
            .Gt -> { return llvm.build_icmp(self.builder, 38, lhs, rhs, "gt") }
            .GtEq -> { return llvm.build_icmp(self.builder, 39, lhs, rhs, "ge") }
            .BitAnd -> { return llvm.build_and(self.builder, lhs, rhs, "ba") }
            .BitOr -> { return llvm.build_or(self.builder, lhs, rhs, "bo") }
            .BitXor -> { return llvm.build_xor(self.builder, lhs, rhs, "bx") }
            .Shl -> { return llvm.build_shl(self.builder, lhs, rhs, "sl") }
            .Shr -> { return llvm.build_ashr(self.builder, lhs, rhs, "sr") }
            .And -> { return llvm.build_and(self.builder, lhs, rhs, "and") }
            .Or -> { return llvm.build_or(self.builder, lhs, rhs, "or") }
            .Pipe -> { return rhs }
        }
        llvm.const_int(self.i64_type, 0, 0)
    }

    fn emit_call(self, callee: Expr, args: List<Expr>) -> ptr {
        match callee {
            .Ident(name, span) -> {
                if name == "println" { return self.emit_println(args) }
                if name == "print" { return self.emit_println(args) }
                if self.functions.has(name) { return self.emit_fn_call(name, args) }
            }
            .MemberAccess(o, f, s) -> {}
            .Feature(fe) -> {}
            .Binary(l, o, r, s) -> {}
            .Unary(o, e, s) -> {}
            .Call(c, a, s) -> {}
            .IntLit(v, s) -> {}
            .FloatLit(v, s) -> {}
            .StringLit(v, s) -> {}
            .BoolLit(v, s) -> {}
            .NullLit(s) -> {}
            .Index(o, i, s) -> {}
            .Block(b) -> {}
        }
        llvm.const_int(self.i64_type, 0, 0)
    }

    fn emit_fn_call(self, name: string, args: List<Expr>) -> ptr {
        let fn_val = self.functions[name]
        let arg_arr = llvm.value_array_new(args.length)
        let param_arr = llvm.type_array_new(args.length)
        mut i = 0
        for arg in args {
            llvm.value_array_set(arg_arr, i, self.emit_expr(arg))
            llvm.type_array_set(param_arr, i, self.i64_type)
            i = i + 1
        }
        let ft = llvm.function_type(self.i64_type, param_arr, args.length, 0)
        llvm.type_array_free(param_arr)
        let r = llvm.build_call(self.builder, ft, fn_val, arg_arr, args.length, "call")
        llvm.value_array_free(arg_arr)
        r
    }

    fn emit_println(self, args: List<Expr>) -> ptr {
        for arg in args {
            let val = self.emit_expr(arg)
            self.emit_println_value(val)
        }
        llvm.const_int(self.i64_type, 0, 0)
    }

    fn emit_println_value(self, val: ptr) {
        // Convert to string via int_to_string (simplified — treats all as int)
        let ca = llvm.value_array_new(1)
        llvm.value_array_set(ca, 0, val)
        let ft = make_fn_type(self.string_type, [self.i64_type])
        let sv = llvm.build_call(self.builder, ft, self.rt_int_to_str, ca, 1, "ts")
        llvm.value_array_free(ca)
        // Extract ptr and len from ForgeString
        let sp = llvm.build_extract_value(self.builder, sv, 0, "sp")
        let sl = llvm.build_extract_value(self.builder, sv, 1, "sl")
        // Call forge_println(ptr, len)
        let pa = llvm.value_array_new(2)
        llvm.value_array_set(pa, 0, sp)
        llvm.value_array_set(pa, 1, sl)
        let pft = make_fn_type(self.void_type, [self.ptr_type, self.i64_type])
        llvm.build_call(self.builder, pft, self.rt_println, pa, 2, "")
        llvm.value_array_free(pa)
    }

    fn emit_block(self, block: Block) -> ptr {
        mut last = llvm.const_int(self.i64_type, 0, 0)
        for stmt in block.statements {
            match stmt {
                .Expr(expr) -> { last = self.emit_expr(expr) }
                .Assign(t, v, s) -> {}
                .Return(v, s) -> { self.emit_return(v) }
                .Feature(fe) -> { self.dispatch_stmt(fe) }
            }
        }
        last
    }

    fn write_ir(self, path: string) -> bool {
        llvm.print_module_to_file(self.module, path) == 0
    }

    // ─── Variable Definition ───────────────────

    fn define_var(self, name: string, ty: Type, value: ptr) {
        let alloca = llvm.build_alloca(self.builder, self.i64_type, name)
        llvm.build_store(self.builder, value, alloca)
        self.vars[name] = alloca
    }
}
