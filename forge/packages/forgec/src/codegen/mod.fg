mut CG_F64: ptr = null
export mut CG_STR: ptr = null
mut CG_RT_PRINTLN: ptr = null
mut CG_RT_I2S: ptr = null
mut CG_RT_SNEW: ptr = null
mut CG_RT_SCONCAT: ptr = null
mut CG_RT_SCHARAT: ptr = null
mut CG_RT_SLEN: ptr = null
mut CG_RT_SEQ: ptr = null
mut CG_RT_SSUBSTR: ptr = null
mut CG_RT_SINDEXOF: ptr = null
mut CG_RT_SCMP: ptr = null
mut CG_RT_ALLOC: ptr = null
mut CG_RT_MEMCPY: ptr = null

// List struct type: {ptr data, i64 count}
mut CG_LIST: ptr = null

// Map runtime helpers (pointer-based API in runtime.c)
export mut CG_RT_MAP_NEW: ptr = null
export mut CG_RT_MAP_HAS: ptr = null
export mut CG_RT_MAP_GET: ptr = null
export mut CG_RT_MAP_SET: ptr = null

// Variable lookup uses:
// - Locals: alloca cache (C-side per-function storage) → get_allocated_type → build_load
// - Globals: llvm.get_named_global(CG_MOD, name) → global_get_value_type → build_load
// - Functions: llvm.get_named_function(CG_MOD, name) → fn ref

// CG_ACTIVE removed — parser is now a pure parser, codegen is separate

// Debug: recursion depth counter for emit_expr
// EMIT_DEPTH moved to C-side (forge_emit_depth_push/pop/get)

// Top-level source fragments to inject into main
// CG_TOPLEVEL_SOURCES removed (was unused — only pushed to, never read)

// Struct type registry uses C-side (forge_struct_type_register, forge_struct_field_index)
// Struct type registry uses C-side (forge_struct_type_register, forge_struct_field_index, etc.)

// Variable struct type tracking now uses alloca cache (forge_alloca_cache_set_var_type)
// The most recently emitted LLVM value (for passing through call chain without AST corruption)
// CG_LAST_VAL/CG_HAS_LAST_VAL moved to C-side (forge_last_val_set/get/has/clear)

// Match expression globals (PENDING pattern)
// Match/If expressions use proper AST nodes (Expr.MatchExpr, Expr.IfExpr) — no globals

export type Codegen = {
    mut current_fn: ptr?,
    mut functions: Map<string, ptr>,
    mut vars: Map<string, ptr>,
}

export fn codegen_new() -> Codegen {
    Codegen { current_fn: null, functions: {}, vars: {} }
}

fn make_fn_type(ret: ptr, params: List<ptr>) -> ptr {
    let arr = llvm.type_array_new(params.length)
    mut i = 0
    for p in params {
        llvm.type_array_set(arr, i, p)
        i = i + 1
    }
    let ft = llvm.function_type(ret, arr, params.length, 0)
    llvm.type_array_free(arr)
    ft
}
fn mft0(ret: ptr) -> ptr {
    let a = llvm.type_array_new(0)
    let f = llvm.function_type(ret, a, 0, 0)
    llvm.type_array_free(a)
    f
}
fn mft1(ret: ptr, p0: ptr) -> ptr {
    let a = llvm.type_array_new(1)
    llvm.type_array_set(a, 0, p0)
    let f = llvm.function_type(ret, a, 1, 0)
    llvm.type_array_free(a)
    f
}
fn mft2(ret: ptr, p0: ptr, p1: ptr) -> ptr {
    let a = llvm.type_array_new(2)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    let f = llvm.function_type(ret, a, 2, 0)
    llvm.type_array_free(a)
    f
}
fn mft3(ret: ptr, p0: ptr, p1: ptr, p2: ptr) -> ptr {
    let a = llvm.type_array_new(3)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    let f = llvm.function_type(ret, a, 3, 0)
    llvm.type_array_free(a)
    f
}
fn mft4(ret: ptr, p0: ptr, p1: ptr, p2: ptr, p3: ptr) -> ptr {
    let a = llvm.type_array_new(4)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    llvm.type_array_set(a, 3, p3)
    let f = llvm.function_type(ret, a, 4, 0)
    llvm.type_array_free(a)
    f
}
fn mft5(ret: ptr, p0: ptr, p1: ptr, p2: ptr, p3: ptr, p4: ptr) -> ptr {
    let a = llvm.type_array_new(5)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    llvm.type_array_set(a, 3, p3)
    llvm.type_array_set(a, 4, p4)
    let f = llvm.function_type(ret, a, 5, 0)
    llvm.type_array_free(a)
    f
}
fn mft6(ret: ptr, p0: ptr, p1: ptr, p2: ptr, p3: ptr, p4: ptr, p5: ptr) -> ptr {
    let a = llvm.type_array_new(6)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    llvm.type_array_set(a, 3, p3)
    llvm.type_array_set(a, 4, p4)
    llvm.type_array_set(a, 5, p5)
    let f = llvm.function_type(ret, a, 6, 0)
    llvm.type_array_free(a)
    f
}

// store_toplevel_source removed (unused)

// Create LLVM globals from the C-side global variable registry
export fn create_globals_from_registry() {
    let count = forge_global_var_count()
    mut i = 0
    while i < count {
        let name = forge_global_var_name(i)
        let is_str = forge_global_var_is_str(i)
        cg_reinit_types()
        mut gty = CG_I64
        if is_str == 1 { gty = CG_STR }
        let gv = llvm.add_global(CG_MOD, gty, name)
        let zero = llvm.const_null(gty)
        llvm.set_initializer(gv, zero)
        i = i + 1
    }
}

// Create LLVM globals for all registered global variables.
// Parses CSV string with "name:type\n" entries.
export fn create_llvm_globals_from(csv: string, count: int) {
    if count == 0 { return }
    mut pos = 0
    let csv_len = csv.length
    while pos < csv_len {
        // Read name (until :)
        mut name = ""
        while pos < csv_len {
            if csv[pos] == ":" { break }
            name = name + csv[pos]
            pos = pos + 1
        }
        if pos >= csv_len { break }
        pos = pos + 1 // skip :
        // Read type (until \n)
        mut type_name = ""
        while pos < csv_len {
            if csv[pos] == "\n" { break }
            type_name = type_name + csv[pos]
            pos = pos + 1
        }
        if pos < csv_len { pos = pos + 1 } // skip \n
        if name == "" { break }

        // Determine LLVM type
        mut gty = CG_I64
        let is_list_struct = type_name.length > 12 && type_name.substring(0, 12) == "list_struct:"
        let is_list = type_name == "list" || type_name == "list_str" || is_list_struct
        if type_name == "string" || is_list { gty = CG_STR }
        else if type_name == "map" { gty = CG_PTR }

        let gv = llvm.add_global(CG_MOD, gty, name)
        mut zero = llvm.const_int(CG_I64, 0, 0)
        if type_name == "string" || is_list {
            zero = llvm.const_null(gty)
        } else if type_name == "map" {
            zero = llvm.const_null(CG_PTR)
        }
        llvm.set_initializer(gv, zero)

    }
}

// These used to search CSV globals that have been removed.
// Variable type info now comes from the alloca cache (LLVM is source of truth).
export fn is_list_var(name: string) -> bool {
    let vt = forge_alloca_cache_get_var_type(name)
    vt == "list" || vt == "List" || (vt.length > 5 && vt.substring(0, 5) == "list:")
}

export fn is_str_list_var(name: string) -> bool {
    let vt = forge_alloca_cache_get_var_type(name)
    vt == "list:string"
}

export fn list_elem_type(name: string) -> string {
    let vt = forge_alloca_cache_get_var_type(name)
    if vt.length > 5 {
        let prefix = vt.substring(0, 5)
        if prefix == "list:" || prefix == "List:" {
            return vt.substring(5, vt.length)
        }
    }
    ""
}

// Get the LLVM element type for a list variable
export fn list_elem_llvm_type(name: string) -> ptr {
    let elem = list_elem_type(name)
    if elem == "string" { return CG_STR }
    if elem == "int" || elem == "" { return CG_I64 }
    // Struct type — use LLVM named type or lazy creation
    let resolved = resolve_type_to_llvm(elem)
    resolved
}

// ─── Enum Tagged Union Helpers ───────────────────
// Enum type/variant registries use C-side storage (forge_enum_type_register, etc.)

export fn cg_enum_max_fields(name: string) -> int {
    forge_enum_type_max_fields(name)
}

// Get or create the LLVM type for a specific enum (per-enum sizing like Rust)
export fn cg_get_enum_ty_for(name: string) -> ptr {
    // Check LLVM named type registry first
    let existing = llvm.get_type_by_name(CG_CTX, name)
    if existing != null { return existing }
    // Create: {i8, i64 x max_fields}
    let mf = cg_enum_max_fields(name)
    mut fc = 2  // minimum {i8, i64}
    if mf > 0 { fc = mf + 1 }
    let fields = llvm.type_array_new(fc)
    llvm.type_array_set(fields, 0, CG_I8)
    mut fi = 1
    while fi < fc {
        llvm.type_array_set(fields, fi, CG_I64)
        fi = fi + 1
    }
    let ty = llvm.struct_create_named(CG_CTX, name)
    llvm.struct_set_body(ty, fields, fc, 0)
    llvm.type_array_free(fields)
    ty
}

export fn cg_make_enum_type(name: string) -> ptr {
    let mf = cg_enum_max_fields(name)
    if mf == 0 { return null }
    cg_get_enum_ty_for(name)
}

export fn cg_var_enum_type(name: string) -> string {
    // Check alloca cache for the variable's type name
    let vt = forge_alloca_cache_get_var_type(name)
    if vt.length > 0 {
        // If it's a registered enum type, return it
        if forge_enum_type_exists(vt) == 1 {
            return vt
        }
    }
    ""
}

// Look up variant field types string for "EnumName.VariantName"
// Returns e.g. "si" meaning field 0 is string, field 1 is int
export fn cg_enum_variant_field_types(enum_name: string, variant_name: string) -> string {
    let key = enum_name + "." + variant_name
    forge_enum_variant_fields_get(key)
}

// Same as above but takes qualified name "EnumName.VariantName" directly
export fn cg_enum_variant_field_types_from_qname(qname: string) -> string {
    forge_enum_variant_fields_get(qname)
}

// Compute slot offset for field index in a variant, given field types string
// e.g. field_types="si", field_idx=1 -> offset=2 (string takes slots 0-1, int at slot 2)
// Field type codes: i=int(1), s=string(2), l=list(2), 4=Span(4)
export fn cg_enum_field_slot_offset(field_types: string, field_idx: int) -> int {
    mut offset = 0
    mut fi = 0
    while fi < field_idx {
        if fi < field_types.length {
            let fc = field_types[fi]
            if fc == "s" {
                offset = offset + 2
            } else if fc == "l" {
                offset = offset + 2
            } else if fc == "4" {
                offset = offset + 4
            } else {
                offset = offset + 1
            }
        } else {
            offset = offset + 1
        }
        fi = fi + 1
    }
    offset
}

// Get the number of i64 slots for a field type code
fn field_type_slots(code: string) -> int {
    if code == "s" { return 2 }
    if code == "l" { return 2 }
    if code == "4" { return 4 }
    1
}

// Register variant field types
export fn register_enum_variant_fields(enum_name: string, variant_name: string, field_types: string) {
    let key = enum_name + "." + variant_name
    forge_enum_variant_fields_set(key, field_types)
}

// ─── Nullable Type Helpers ───────────────────────

// Per-function nullable state uses C-side (forge_fn_nullable_set/get_flag/get_inner/get_ret)
export fn make_nullable_type(inner_ty: ptr) -> ptr {
    // LLVM deduplicates struct types, so no caching needed
    let fields = llvm.type_array_new(2)
    llvm.type_array_set(fields, 0, CG_I8)
    llvm.type_array_set(fields, 1, inner_ty)
    let nullable_ty = llvm.struct_type(CG_CTX, fields, 2, 0)
    llvm.type_array_free(fields)
    nullable_ty
}

export fn wrap_nullable(inner_ty: ptr, value: ptr) -> ptr {
    let nullable_ty = make_nullable_type(inner_ty)
    let undef = llvm.get_undef(nullable_ty)
    let s1 = llvm.build_insert_value(CG_B, undef, llvm.const_int(CG_I8, 1, 0), 0, "wt")
    llvm.build_insert_value(CG_B, s1, value, 1, "wv")
}

export fn make_null_value(inner_ty: ptr) -> ptr {
    let nullable_ty = make_nullable_type(inner_ty)
    let undef = llvm.get_undef(nullable_ty)
    let s1 = llvm.build_insert_value(CG_B, undef, llvm.const_int(CG_I8, 0, 0), 0, "nt")
    llvm.build_insert_value(CG_B, s1, llvm.const_null(inner_ty), 1, "nv")
}

export fn is_nullable_var(name: string) -> bool {
    mut i = CG_NULLABLE_VAR_NAMES.length - 1
    while i >= 0 {
        if CG_NULLABLE_VAR_NAMES[i] == name { return true }
        i = i - 1
    }
    false
}

export fn nullable_var_inner_type(name: string) -> string {
    mut i = CG_NULLABLE_VAR_NAMES.length - 1
    while i >= 0 {
        if CG_NULLABLE_VAR_NAMES[i] == name { return CG_NULLABLE_VAR_INNER[i] }
        i = i - 1
    }
    "int"
}

// ─── Codegen Methods ───────────────────────────

// Register a struct type with its fields
export fn register_struct_type(name: string, fields: string, field_is_str: string, llvm_ty: ptr) {
    forge_struct_type_register(name, fields, field_is_str, "", llvm_ty)
}

export fn register_struct_type_full(name: string, fields: string, field_is_str: string, field_type_names: string, llvm_ty: ptr) {
    forge_struct_type_register(name, fields, field_is_str, field_type_names, llvm_ty)
}

// Create an LLVM named struct type from the field info at index `idx` in CG_STRUCT_*
fn create_struct_llvm_type(name: string, idx: int) -> ptr {
    // Delegate entirely to C-side (avoids Forge ptr/i64 type coercion issues)
    return forge_create_struct_type(name)
    if CG_STR == null { return null }
    if CG_I64 == null { return null }
    // Get field info from C-side struct registry
    let field_type_csv = forge_struct_type_get_field_types(name)
    let field_is_str_csv = ""  // No longer needed — field_type_csv has all info
    // Count fields by counting commas + 1 in field_type_csv
    mut field_count = 0
    if field_type_csv.length > 0 {
        field_count = 1
        mut ci = 0
        while ci < field_type_csv.length {
            if field_type_csv[ci] == "," { field_count = field_count + 1 }
            ci = ci + 1
        }
    }
    if field_count == 0 { return null }
    // Build LLVM field types array
    let fa = llvm.type_array_new(field_count)
    mut fi = 0
    // Parse comma-separated type names
    mut tpos = 0
    while fi < field_count {
        mut ft_name = ""
        while tpos < field_type_csv.length {
            let c = field_type_csv[tpos]
            tpos = tpos + 1
            if c == "," { break }
            ft_name = ft_name + c
        }
        // Resolve field type via central resolve_type_to_llvm
        let fty = resolve_type_to_llvm(ft_name)
        llvm.type_array_set(fa, fi, fty)
        fi = fi + 1
    }
    // Check if already created (avoid duplicates)
    let existing = llvm.get_type_by_name(CG_CTX, name)
    if existing != null {
        llvm.type_array_free(fa)
        return existing
    }
    // Create named LLVM struct type
    let sty = llvm.struct_create_named(CG_CTX, name)
    llvm.struct_set_body(sty, fa, field_count, 0)
    llvm.type_array_free(fa)
    sty
}

// Resolve a type name to its LLVM type
export fn resolve_type_to_llvm(type_name: string) -> ptr {
    if type_name == "string" { return CG_STR }
    if type_name == "int" { return CG_I64 }
    if type_name == "float" { return CG_I64 }
    if type_name == "bool" { return CG_I64 }
    if type_name == "ptr" { return CG_I64 }
    if type_name == "List" || type_name == "list" || (type_name.length > 5 && (type_name.substring(0, 5) == "List:" || type_name.substring(0, 5) == "list:")) {
        return CG_LIST
    }
    // Use LLVM's named type registry (i64-based to avoid ptr null check issue)
    let named_i = forge_get_type_by_name_i64(type_name)
    if named_i != 0 { return named_i }
    // Check enum type
    let emf = cg_enum_max_fields(type_name)
    if forge_enum_type_exists(type_name) == 1 {
        if emf > 0 {
            let ety = cg_get_enum_ty_for(type_name)
            if ety != null { return ety }
        } else {
            // Zero-payload enum: just a tag, represented as i64
            return CG_I64
        }
    }
    // Check C-side struct registry — create LLVM type lazily if needed
    let struct_fields = forge_struct_type_get_fields(type_name)
    if struct_fields.length > 0 {
        // create_struct_llvm_type always returns a valid type (never null)
        return create_struct_llvm_type(type_name, 0)
    }
    CG_I64
}

// Find a struct type's field index by name. Returns -1 if not found.
export fn struct_field_index(struct_name: string, field_name: string) -> int {
    forge_struct_field_index(struct_name, field_name)
}

// Get the struct type name for a variable
export fn var_struct_type(name: string) -> string {
    // Check alloca cache for the variable's Forge type name
    let cached_type = forge_alloca_cache_get_var_type(name)
    if cached_type.length > 0 {
        // Return only if it's a struct/enum type (not a primitive)
        if cached_type != "int" && cached_type != "string" && cached_type != "float" && cached_type != "bool" && cached_type != "ptr" && cached_type != "null" && cached_type != "map" {
            // Exclude list types
            if cached_type == "list" || cached_type == "List" { return "" }
            if cached_type.length > 5 && cached_type.substring(0, 5) == "list:" { return "" }
            return cached_type
        }
    }
    ""
}

export fn codegen_init(name: string) {
    forge_alloca_cache_clear()
    forge_last_val_clear()
    // (CG_UNIVERSAL_ENUM_TY removed)
    let dfns = forge_map_new()
    DECLARED_FNS = dfns
    cg_init_ctx(name)
    cg_init_int_types()
    cg_init_other_types()
    cg_init_str()
    cg_register_core_types()
    cg_init_runtime()
}

export fn codegen_write_ir(path: string) {
    llvm.print_module_to_file(CG_MOD, path)
}

export fn codegen_emit_object(path: string) -> bool {
    let result = llvm.emit_object_file(CG_MOD, path)
    result == 0
}

export fn codegen_cleanup() {
    // codegen cleaned up
    cg_cleanup()
}

fn cg_init_ctx(name: string) {
    CG_CTX = llvm.context_create()
    if CG_CTX == null {
        eprintln("FATAL: LLVM context_create returned null!")
        process.exit(1)
    }
    CG_MOD = llvm.module_create(name, CG_CTX)
    CG_B = llvm.create_builder(CG_CTX)
}

fn cg_init_int_types() {
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
}

// Re-init ALL type globals (list pushes corrupt globals in bootstrap compiler)
export fn cg_reinit_types() {
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
    CG_VOID = llvm.void_type(CG_CTX)
    CG_PTR = llvm.pointer_type(CG_CTX)
    CG_F64 = llvm.double_type(CG_CTX)
    // CG_STR is set once by cg_init_str — don't clobber it here
    // (get_type_by_name may return null in bootstrap if string isn't null-terminated)
    CG_LIST = CG_STR
}

fn cg_init_other_types() {
    CG_VOID = llvm.void_type(CG_CTX)
    CG_PTR = llvm.pointer_type(CG_CTX)
    CG_F64 = llvm.double_type(CG_CTX)
}

fn cg_init_str() {
    // Named type %ForgeString = { ptr, i64 } — matches bootstrap's layout
    CG_STR = llvm.struct_create_named(CG_CTX, "ForgeString")
    let sf = llvm.type_array_new(2)
    llvm.type_array_set(sf, 0, CG_PTR)
    llvm.type_array_set(sf, 1, CG_I64)
    llvm.struct_set_body(CG_STR, sf, 2, 0)
    llvm.type_array_free(sf)
    // List type: {ptr, i64} — same layout as ForgeString but semantically different
    let lf = llvm.type_array_new(2)
    llvm.type_array_set(lf, 0, CG_PTR)
    llvm.type_array_set(lf, 1, CG_I64)
    CG_LIST = llvm.struct_type(CG_CTX, lf, 2, 0)
    llvm.type_array_free(lf)
}

fn cg_register_core_types() {
    // Register core struct types as LLVM named types.
    // Layouts match the source definitions. Avoids parsing type declarations
    // (which corrupts globals via list push).

    // Register core enum types so resolve_type_to_llvm can find them.
    // max_fields = number of i64 slots for the largest variant (tag excluded).
    // Statement max payload slots (with boxing): Match = scrutinee(1) + arm_tags(2) + arm_bindings(2) + arm_bodies(2) + default_body(1,boxed) + has_default(1) + span(4) = 13
    forge_enum_type_register("Statement", 13)
    // Expr max payload slots (with boxing): MatchExpr = scrutinee(1) + arm_tags(2) + arm_bindings(2) + arm_bodies(2) + default_body(1,boxed) + has_default(1) + span(4) = 13
    forge_enum_type_register("Expr", 13)
    // BinOp: simple enum, no fields
    forge_enum_type_register("BinOp", 0)
    // UnaryOp: simple enum, no fields
    forge_enum_type_register("UnaryOp", 0)
    // TokenKind: variants with up to 1 field (TemplateLiteral has List<TemplatePart>)
    forge_enum_type_register("TokenKind", 1)
    // Note: Type, TypeExpr NOT registered as named LLVM types because the Rust compiler
    // uses them as branch conditions (if t is .Int) which requires i64, not a struct.
    // They stay as i64 in the self-hosted codegen.

    // Helper: create a named struct type
    // Span = { i64, i64, i64, i64 }
    let s4 = llvm.type_array_new(4)
    llvm.type_array_set(s4, 0, CG_I64)
    llvm.type_array_set(s4, 1, CG_I64)
    llvm.type_array_set(s4, 2, CG_I64)
    llvm.type_array_set(s4, 3, CG_I64)
    let span_ty = llvm.struct_create_named(CG_CTX, "Span")
    llvm.struct_set_body(span_ty, s4, 4, 0)
    llvm.type_array_free(s4)

    // Token, Block, NodeRef — created lazily via create_struct_llvm_type
    // (hardcoded versions get shadowed by parsed type declarations)

    // Lexer = { source: string, pos: int, line: int, col: int, pos_offset: int, diagnostics: List<Diagnostic> }
    // = { %ForgeString, i64, i64, i64, i64, %ForgeString }
    let lf = llvm.type_array_new(6)
    llvm.type_array_set(lf, 0, CG_STR)
    llvm.type_array_set(lf, 1, CG_I64)
    llvm.type_array_set(lf, 2, CG_I64)
    llvm.type_array_set(lf, 3, CG_I64)
    llvm.type_array_set(lf, 4, CG_I64)
    llvm.type_array_set(lf, 5, CG_STR)
    let lexer_ty = llvm.struct_create_named(CG_CTX, "Lexer")
    llvm.struct_set_body(lexer_ty, lf, 6, 0)
    llvm.type_array_free(lf)
    register_struct_type_full("Lexer", "source,pos,line,col,pos_offset,diagnostics", "100001", "string,int,int,int,int,List:Diagnostic", lexer_ty)

    // Parser = { tokens: List<Token>, pos: int, diagnostics: List<Diagnostic>, source: string }
    // = { %ForgeString, i64, %ForgeString, %ForgeString }
    let pf = llvm.type_array_new(4)
    llvm.type_array_set(pf, 0, CG_STR)
    llvm.type_array_set(pf, 1, CG_I64)
    llvm.type_array_set(pf, 2, CG_STR)
    llvm.type_array_set(pf, 3, CG_STR)
    let parser_ty = llvm.struct_create_named(CG_CTX, "Parser")
    llvm.struct_set_body(parser_ty, pf, 4, 0)
    llvm.type_array_free(pf)
    register_struct_type_full("Parser", "tokens,pos,diagnostics,source", "1010", "List:Token,int,List:Diagnostic,string", parser_ty)

    // TypeChecker = { env: TypeEnv, diagnostics: DiagnosticBag, expr_types: Map<string> }
    // = { i64, i64, i64 } (opaque internal types)
    let tf = llvm.type_array_new(3)
    llvm.type_array_set(tf, 0, CG_I64)
    llvm.type_array_set(tf, 1, CG_I64)
    llvm.type_array_set(tf, 2, CG_I64)
    let tc_ty = llvm.struct_create_named(CG_CTX, "TypeChecker")
    llvm.struct_set_body(tc_ty, tf, 3, 0)
    llvm.type_array_free(tf)

    // Codegen = { current_fn: ptr?, functions: Map, vars: Map }
    // = { i64, i64, i64 } (opaque)
    let cf = llvm.type_array_new(3)
    llvm.type_array_set(cf, 0, CG_I64)
    llvm.type_array_set(cf, 1, CG_I64)
    llvm.type_array_set(cf, 2, CG_I64)
    let cg_ty = llvm.struct_create_named(CG_CTX, "Codegen")
    llvm.struct_set_body(cg_ty, cf, 3, 0)
    llvm.type_array_free(cf)
    register_struct_type_full("Codegen", "current_fn,functions,vars", "000", "ptr,Map:string,Map:string", cg_ty)

    // Param = { name: string, type_ann: TypeExpr, default_value: Expr, span: Span, mutable: bool }
    // = { %ForgeString, i64, i64, %Span, i64 }
    let pmf = llvm.type_array_new(5)
    llvm.type_array_set(pmf, 0, CG_STR)
    llvm.type_array_set(pmf, 1, CG_I64)
    llvm.type_array_set(pmf, 2, CG_I64)
    llvm.type_array_set(pmf, 3, span_ty)
    llvm.type_array_set(pmf, 4, CG_I64)
    let param_ty = llvm.struct_create_named(CG_CTX, "Param")
    llvm.struct_set_body(param_ty, pmf, 5, 0)
    llvm.type_array_free(pmf)
    register_struct_type_full("Param", "name,type_ann,default_value,span,mutable", "10000", "string,TypeExpr,Expr,Span,bool", param_ty)
    register_struct_type_full("Span", "start,end,line,col", "0000", "int,int,int,int", span_ty)

    // Block = { statements: List<Statement>, span: Span }
    let blk_fields = llvm.type_array_new(2)
    llvm.type_array_set(blk_fields, 0, CG_LIST)
    llvm.type_array_set(blk_fields, 1, span_ty)
    let block_ty = llvm.struct_create_named(CG_CTX, "Block")
    llvm.struct_set_body(block_ty, blk_fields, 2, 0)
    llvm.type_array_free(blk_fields)
    register_struct_type_full("Block", "statements,span", "01", "List:Statement,Span", block_ty)

    // Token = { kind: TokenKind, span: Span, text: string, kind_id: int }
    let tok_fields = llvm.type_array_new(4)
    llvm.type_array_set(tok_fields, 0, CG_I64)   // TokenKind enum → i64 for simplicity
    llvm.type_array_set(tok_fields, 1, span_ty)
    llvm.type_array_set(tok_fields, 2, CG_STR)
    llvm.type_array_set(tok_fields, 3, CG_I64)
    let token_ty = llvm.struct_create_named(CG_CTX, "Token")
    llvm.struct_set_body(token_ty, tok_fields, 4, 0)
    llvm.type_array_free(tok_fields)
    register_struct_type_full("Token", "kind,span,text,kind_id", "0010", "TokenKind,Span,string,int", token_ty)

    // NodeRef = { node_id: int, feature: string, kind_name: string, node_span: Span }
    let nr_fields = llvm.type_array_new(4)
    llvm.type_array_set(nr_fields, 0, CG_I64)
    llvm.type_array_set(nr_fields, 1, CG_STR)
    llvm.type_array_set(nr_fields, 2, CG_STR)
    llvm.type_array_set(nr_fields, 3, span_ty)
    let nr_ty = llvm.struct_create_named(CG_CTX, "NodeRef")
    llvm.struct_set_body(nr_ty, nr_fields, 4, 0)
    llvm.type_array_free(nr_fields)
    register_struct_type_full("NodeRef", "node_id,feature,kind_name,node_span", "0110", "int,string,string,Span", nr_ty)

    // FeatureExpr = { data: NodeRef }
    let fe_fields = llvm.type_array_new(1)
    llvm.type_array_set(fe_fields, 0, nr_ty)
    let fe_ty = llvm.struct_create_named(CG_CTX, "FeatureExpr")
    llvm.struct_set_body(fe_ty, fe_fields, 1, 0)
    llvm.type_array_free(fe_fields)
    register_struct_type_full("FeatureExpr", "data", "0", "NodeRef", fe_ty)

    // FeatureStmt = { data: NodeRef }
    let fs_fields = llvm.type_array_new(1)
    llvm.type_array_set(fs_fields, 0, nr_ty)
    let fs_ty = llvm.struct_create_named(CG_CTX, "FeatureStmt")
    llvm.struct_set_body(fs_ty, fs_fields, 1, 0)
    llvm.type_array_free(fs_fields)
    register_struct_type_full("FeatureStmt", "data", "0", "NodeRef", fs_ty)
}

fn cg_init_runtime() {
    cg_reinit_types()
    // Core
    CG_RT_PRINTLN = llvm.add_function(CG_MOD, "forge_println_string", mft1(CG_VOID, CG_STR))
    CG_RT_I2S = llvm.add_function(CG_MOD, "forge_int_to_string", mft1(CG_STR, CG_I64))
    CG_RT_SNEW = llvm.add_function(CG_MOD, "forge_string_new", mft2(CG_STR, CG_PTR, CG_I64))
    // String operations
    CG_RT_SCONCAT = llvm.add_function(CG_MOD, "forge_string_concat", mft2(CG_STR, CG_STR, CG_STR))
    CG_RT_SCHARAT = llvm.add_function(CG_MOD, "forge_string_char_at", mft2(CG_STR, CG_STR, CG_I64))
    CG_RT_SLEN = llvm.add_function(CG_MOD, "forge_string_length", mft1(CG_I64, CG_STR))
    CG_RT_SEQ = llvm.add_function(CG_MOD, "forge_string_eq", mft2(CG_I8, CG_STR, CG_STR))
    CG_RT_SCMP = llvm.add_function(CG_MOD, "forge_string_compare", mft2(CG_I64, CG_STR, CG_STR))
    CG_RT_SSUBSTR = llvm.add_function(CG_MOD, "forge_string_substring", mft3(CG_STR, CG_STR, CG_I64, CG_I64))
    CG_RT_SINDEXOF = llvm.add_function(CG_MOD, "forge_string_index_of", mft2(CG_I64, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_c_index_of", mft2(CG_I64, CG_STR, CG_STR))
    // Memory
    CG_RT_ALLOC = llvm.add_function(CG_MOD, "forge_alloc", mft1(CG_PTR, CG_I64))
    CG_RT_MEMCPY = llvm.add_function(CG_MOD, "forge_memcpy", mft3(CG_VOID, CG_PTR, CG_PTR, CG_I64))
    // List type: {ptr, i64}
    let lf = llvm.type_array_new(2)
    llvm.type_array_set(lf, 0, CG_PTR)
    llvm.type_array_set(lf, 1, CG_I64)
    CG_LIST = llvm.struct_type(CG_CTX, lf, 2, 0)
    llvm.type_array_free(lf)
    // Map runtime functions (pointer-based: map is heap-allocated ptr)
    cg_reinit_types()
    CG_RT_MAP_NEW = llvm.add_function(CG_MOD, "forge_map_new", mft0(CG_PTR))
    CG_RT_MAP_HAS = llvm.add_function(CG_MOD, "forge_map_has", mft2(CG_I8, CG_PTR, CG_STR))
    CG_RT_MAP_GET = llvm.add_function(CG_MOD, "forge_map_get", mft2(CG_I64, CG_PTR, CG_STR))
    CG_RT_MAP_SET = llvm.add_function(CG_MOD, "forge_map_set", mft3(CG_VOID, CG_PTR, CG_STR, CG_I64))
    // Process/FS functions (self-hosted compiler support — selfhost_ prefix avoids package conflicts)
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_set_args", mft2(CG_VOID, CG_I32, CG_PTR))
    llvm.add_function(CG_MOD, "forge_selfhost_process_args", mft0(CG_STR))
    llvm.add_function(CG_MOD, "forge_selfhost_fs_read", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_selfhost_process_exit", mft1(CG_VOID, CG_I64))
    llvm.add_function(CG_MOD, "forge_selfhost_process_run", mft2(CG_STR, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_eprintln_string", mft1(CG_VOID, CG_STR))
    // LLVM C API functions (used by the compiler itself when self-hosting)
    cg_reinit_types()
    // 0-arg → ptr
    llvm.add_function(CG_MOD, "forge_llvm_context_create", mft0(CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_void_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_double_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_pointer_type", mft1(CG_PTR, CG_PTR))
    // 1-arg
    llvm.add_function(CG_MOD, "forge_llvm_create_builder", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_dispose_builder", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_context_dispose", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_module_dispose", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_verify_module", mft1(CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_undef", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_type_of", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_type_kind", mft1(CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_allocated_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_global_get_value_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_insert_block", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_basic_block_parent", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_entry_basic_block", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_first_instruction", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_block_has_terminator", mft1(CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_ret_void", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_const_null", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_type_array_new", mft1(CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_type_array_free", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_value_array_new", mft1(CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_value_array_free", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_param", mft2(CG_PTR, CG_PTR, CG_I64))
    // 2-arg
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_llvm_module_create_s", mft2(CG_PTR, CG_STR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int1_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int8_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int32_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int64_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_add_global_s", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_set_initializer", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_named_function_s", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_get_named_global_s", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_get_type_by_name_s", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_append_basic_block_s", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_position_at_end", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_position_before", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_br", mft2(CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_ret", mft2(CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_alloca_s", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_store", mft3(CG_PTR, CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_print_module_to_file_s", mft2(CG_VOID, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_emit_object_file_s", mft2(CG_I64, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_const_string_s", mft2(CG_PTR, CG_PTR, CG_STR))
    // 3-arg
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_llvm_const_int", mft3(CG_PTR, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_const_real", mft2(CG_PTR, CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_build_load_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_add_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_sub_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_mul_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_sdiv_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_srem_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_and_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_or_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_xor_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_shl_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_ashr_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_cond_br", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_phi_s", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_zext_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_trunc_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_inttoptr_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_add_incoming", mft3(CG_VOID, CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_extract_value_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_insert_value_s", mft5(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_gep2_s", mft5(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_struct_gep2_s", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_build_icmp_s", mft5(CG_PTR, CG_PTR, CG_I64, CG_PTR, CG_PTR, CG_STR))
    // Function types and calls
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_llvm_function_type", mft4(CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_add_function_s", mft3(CG_PTR, CG_PTR, CG_STR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_call_s", mft6(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_type_array_set", mft3(CG_VOID, CG_PTR, CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_value_array_set", mft3(CG_VOID, CG_PTR, CG_I64, CG_PTR))
    // Struct types
    llvm.add_function(CG_MOD, "forge_llvm_struct_type", mft4(CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_struct_create_named_s", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_struct_set_body", mft4(CG_VOID, CG_PTR, CG_PTR, CG_I64, CG_I64))
    // Token/parser C-side helpers
    llvm.add_function(CG_MOD, "forge_fn_store_add", mft2(CG_VOID, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_fn_store_count", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_store_get_name", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_store_get_body", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_set_token_list", mft1(CG_VOID, CG_STR))
    llvm.add_function(CG_MOD, "forge_token_list_len", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_parser_get_pos", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_parser_set_pos", mft1(CG_VOID, CG_I64))
    llvm.add_function(CG_MOD, "forge_parser_advance_pos", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_peek_kind_id", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_extract_body_source", mft3(CG_STR, CG_STR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_kind_id_for_keyword", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_list_push", mft3(CG_STR, CG_STR, CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_signal_handler", mft1(CG_VOID, CG_I64))
    // Alloca cache (C-side per-function variable storage)
    llvm.add_function(CG_MOD, "forge_alloca_cache_set", mft2(CG_I64, CG_STR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_get", mft1(CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_has", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_type_id", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_set_var_type", mft2(CG_VOID, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_get_var_type", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_load", mft3(CG_I64, CG_STR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_load_field", mft4(CG_I64, CG_STR, CG_STR, CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_alloca_cache_clear", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_get_type_by_name_i64", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_create_struct_type", mft1(CG_I64, CG_STR))
    // Character classification
    llvm.add_function(CG_MOD, "forge_is_alpha", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_is_digit", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_is_alnum", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_is_ident_start", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_is_ident_continue", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_is_whitespace_not_newline", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_is_hex_digit", mft1(CG_I64, CG_STR))
    // Value introspection
    llvm.add_function(CG_MOD, "forge_value_type_kind", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_value_is_string", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_trace_i64", mft2(CG_VOID, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_loop_push", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_loop_pop", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_loop_break", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_loop_continue", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_build_cond_br_trunc", mft4(CG_VOID, CG_PTR, CG_PTR, CG_PTR, CG_PTR))
    // Global variable access (i64-based)
    llvm.add_function(CG_MOD, "forge_get_named_global_i64", mft2(CG_I64, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_store_to_global", mft3(CG_VOID, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_load_from_global", mft3(CG_I64, CG_PTR, CG_I64, CG_STR))
    // Alloca cache extras
    llvm.add_function(CG_MOD, "forge_alloca_cache_set_type", mft2(CG_VOID, CG_STR, CG_PTR))
    // Enum registry
    llvm.add_function(CG_MOD, "forge_enum_type_register", mft2(CG_VOID, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_enum_type_max_fields", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_enum_type_exists", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_enum_variant_tag_set", mft2(CG_VOID, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_enum_variant_tag_get", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_enum_variant_fields_set", mft2(CG_VOID, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_enum_variant_fields_get", mft1(CG_STR, CG_STR))
    // Match binding storage (integer-indexed, avoids ForgeString corruption)
    llvm.add_function(CG_MOD, "forge_match_binding_clear", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_match_binding_add", mft1(CG_VOID, CG_STR))
    llvm.add_function(CG_MOD, "forge_match_binding_get", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_match_binding_csv", mft0(CG_STR))
    llvm.add_function(CG_MOD, "forge_list_elem_llvm_type", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_enum_field_type_name", mft2(CG_STR, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_match_binding_variant", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_match_binding_names", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_match_binding_name_at", mft2(CG_STR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_match_binding_name_count", mft1(CG_I64, CG_I64))
    // Nullable tracking
    llvm.add_function(CG_MOD, "forge_fn_nullable_set", mft3(CG_VOID, CG_I64, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_fn_nullable_get_flag", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_nullable_get_inner", mft0(CG_I64))
    // Last val tracking
    llvm.add_function(CG_MOD, "forge_last_val_set", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_last_val_clear", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_last_val_has", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_last_val_get", mft0(CG_I64))
    // Emit depth
    llvm.add_function(CG_MOD, "forge_emit_depth_push", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_emit_depth_pop", mft0(CG_I64))
    // Global var registry
    llvm.add_function(CG_MOD, "forge_global_var_register", mft2(CG_VOID, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_global_var_count", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_global_var_name", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_global_var_is_str", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_global_type_kind", mft2(CG_I64, CG_PTR, CG_STR))
    // Struct registry
    llvm.add_function(CG_MOD, "forge_struct_type_register", mft5(CG_VOID, CG_STR, CG_STR, CG_STR, CG_STR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_struct_type_get_fields", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_struct_type_get_field_types", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_struct_field_index", mft2(CG_I64, CG_STR, CG_STR))
    // String operations
    llvm.add_function(CG_MOD, "forge_bool_to_string", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_float_to_string", mft1(CG_STR, CG_F64))
    llvm.add_function(CG_MOD, "forge_string_to_int", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_string_to_float", mft1(CG_F64, CG_STR))
    llvm.add_function(CG_MOD, "forge_string_contains", mft2(CG_I64, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_string_byte_at", mft2(CG_I64, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_sh_substr", mft3(CG_STR, CG_STR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_sh_indexof", mft2(CG_I64, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_sh_byteat", mft2(CG_I64, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_print_string", mft1(CG_VOID, CG_STR))
    llvm.add_function(CG_MOD, "forge_exit", mft1(CG_VOID, CG_I64))
    llvm.add_function(CG_MOD, "forge_read_file", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_write_file", mft2(CG_VOID, CG_STR, CG_STR))
    // Fn store
    llvm.add_function(CG_MOD, "forge_fn_store_get_param_count", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_store_set_param_count", mft2(CG_VOID, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_reg_get_ret", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_param_name_get", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_param_type_get", mft1(CG_STR, CG_I64))
    // Token accumulation
    llvm.add_function(CG_MOD, "forge_tok_clear", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_tok_push", mft4(CG_VOID, CG_I64, CG_I64, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_tok_count", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_tok_to_list", mft0(CG_STR))
    // Full token accumulation
    llvm.add_function(CG_MOD, "forge_ftok_clear", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_ftok_push", mft6(CG_VOID, CG_I64, CG_STR, CG_I64, CG_I64, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_ftok_count", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_ftok_to_list", mft0(CG_STR))
    llvm.add_function(CG_MOD, "forge_ftok_kind_id", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_ftok_text", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_kind_id_to_key", mft1(CG_STR, CG_I64))
    // Var type tracking (legacy)
    llvm.add_function(CG_MOD, "forge_var_type_set", mft2(CG_VOID, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_var_type_get", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_str_var_add", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_ptr_var_add", mft1(CG_VOID, CG_STR))
    // IR output (mini compat)
    llvm.add_function(CG_MOD, "forge_ir_open", mft1(CG_VOID, CG_STR))
    llvm.add_function(CG_MOD, "forge_ir_line", mft1(CG_VOID, CG_STR))
    llvm.add_function(CG_MOD, "forge_ir_close", mft0(CG_VOID))
    // Other
    llvm.add_function(CG_MOD, "forge_keyword_from_range", mft3(CG_STR, CG_STR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_selfhost_get_arg", mft1(CG_STR, CG_I64))
}

fn cg_cleanup() {
    llvm.dispose_builder(CG_B)
    llvm.module_dispose(CG_MOD)
    llvm.context_dispose(CG_CTX)
}

impl Codegen {
    fn init(self, name: string) { codegen_init(name) }
    fn verify(self) -> bool { llvm.verify_module(CG_MOD) == 0 }
    fn dispose(self) { codegen_cleanup() }
    fn write_ir(self, path: string) { codegen_write_ir(path) }

    // ─── Program ───────────────────────────────

    fn emit_program(self, program: Program) {
        // Single-pass: declare and emit each function
        // (FN_BODIES[i] data is only valid when accessed immediately)
        emit_all_fn_bodies(self)
    }

    // Direct codegen for fn main: create main() with the given body
    fn emit_main_fn(self, body: Block) {
        let params = llvm.type_array_new(0)
        let mt = llvm.function_type(CG_I32, params, 0, 0)
        llvm.type_array_free(params)
        let mf = llvm.add_function(CG_MOD, "main", mt)
        self.current_fn = mf
        let entry = llvm.append_basic_block(CG_CTX, mf, "en")
        llvm.position_at_end(CG_B, entry)
        self.emit_block(body)
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    }

    // Note: void-return emit_statement removed — the ptr-return version
    // at line ~2454 handles ALL statement types. Having two methods with the
    // same LLVM name caused the ptr-return version to be shadowed.

    fn emit_let(self, name: string, value: Expr) {
        // Check if type was pre-set by parser (e.g., List<Statement> annotation)
        let pre_type = forge_alloca_cache_get_var_type(name)
        mut val_type = self.expr_type_name(value)
        if pre_type.length > 0 && (val_type == "int" || val_type == "") {
            val_type = pre_type
        }
        let val = self.emit_expr(value)
        mut var_type = Type.Int
        if val_type == "string" { var_type = Type.String }
        if val_type == "map" { var_type = Type.MapType(Type.String, Type.Int) }
        // Lists use ForgeString alloca ({ptr, i64})
        if val_type == "list" || val_type == "List" || (val_type.length > 5 && (val_type.substring(0, 5) == "list:" || val_type.substring(0, 5) == "List:")) {
            var_type = Type.String
        }
        // Use define_var_typed with the FULL type name (preserves list element type)
        self.define_var_typed(name, val_type, val)
        forge_last_val_clear()
    }

    fn emit_if_stmt(self, cond: Expr, then_b: Block, else_b: Block, has_else: int) {
        let cond_val = self.emit_expr(cond)
        let fn_val = self.current_fn
        let then_bb = llvm.append_basic_block(CG_CTX, fn_val, "then")
        let else_bb = llvm.append_basic_block(CG_CTX, fn_val, "else")
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "merge")
        forge_build_cond_br_trunc(CG_B, cond_val, then_bb, else_bb)
        llvm.position_at_end(CG_B, then_bb)
        self.emit_block(then_b)
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, else_bb)
        if has_else == 1 { self.emit_block(else_b) }
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, merge_bb)
    }

    fn emit_while_stmt(self, cond: Expr, body: Block) {
        let fn_val = self.current_fn
        let cond_bb = llvm.append_basic_block(CG_CTX, fn_val, "wc")
        let body_bb = llvm.append_basic_block(CG_CTX, fn_val, "wb")
        let end_bb = llvm.append_basic_block(CG_CTX, fn_val, "we")
        forge_loop_push(cond_bb, end_bb)
        llvm.build_br(CG_B, cond_bb)
        llvm.position_at_end(CG_B, cond_bb)
        let cval = self.emit_expr(cond)
        forge_build_cond_br_trunc(CG_B, cval, body_bb, end_bb)
        llvm.position_at_end(CG_B, body_bb)
        self.emit_block(body)
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, cond_bb) }
        llvm.position_at_end(CG_B, end_bb)
        forge_loop_pop()
    }

    fn emit_for_stmt(self, var_name: string, iter: Expr, body: Block) {
        // Emit iterable
        let iter_type = self.expr_type_name(iter)
        let list_val = self.emit_expr(iter)
        mut list_is_str = 0
        if iter_type == "string" { list_is_str = 1 }
        // Get length: extract field 1 (for {ptr, i64} lists)
        let len_val = llvm.build_extract_value(CG_B, list_val, 1, "len")
        // Create counter
        let counter = llvm.build_alloca(CG_B, CG_I64, "fi")
        llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), counter)
        let fn_val = self.current_fn
        let cond_bb = llvm.append_basic_block(CG_CTX, fn_val, "fc")
        let body_bb = llvm.append_basic_block(CG_CTX, fn_val, "fb")
        let end_bb = llvm.append_basic_block(CG_CTX, fn_val, "fe")
        let save_cond = WHILE_COND_BB
        let save_end = WHILE_END_BB
        WHILE_COND_BB = cond_bb
        WHILE_END_BB = end_bb
        llvm.build_br(CG_B, cond_bb)
        llvm.position_at_end(CG_B, cond_bb)
        let idx = llvm.build_load(CG_B, CG_I64, counter, "idx")
        let cmp = llvm.build_icmp(CG_B, 38, idx, len_val, "fc")
        forge_build_cond_br_trunc(CG_B, cmp, body_bb, end_bb)
        llvm.position_at_end(CG_B, body_bb)
        // Define loop var (just use counter as the element for now)
        self.define_var(var_name, Type.Int, idx)
        self.emit_block(body)
        // Increment
        let next = llvm.build_add(CG_B, llvm.build_load(CG_B, CG_I64, counter, "ci"), llvm.const_int(CG_I64, 1, 0), "inc")
        llvm.build_store(CG_B, next, counter)
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, cond_bb) }
        llvm.position_at_end(CG_B, end_bb)
        WHILE_COND_BB = save_cond
        WHILE_END_BB = save_end
    }

    fn emit_match_stmt(self, scrut: Expr, tags_csv: string, binds: string, bodies: List<Block>, def: Block, has_def: int) {
        let subj_raw = self.emit_expr(scrut)
        // Extract enum tag if scrutinee is a tagged union
        mut subj = subj_raw
        let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
        if tag_byte != null {
            subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
        }
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")
        // Parse tag CSV
        mut tag_list: List<int> = []
        mut tpos = 0
        mut tcur = ""
        while tpos < tags_csv.length {
            let ch = tags_csv[tpos]
            if ch == "," {
                tag_list = tag_list.push(int(tcur))
                tcur = ""
            } else {
                tcur = tcur + ch
            }
            tpos = tpos + 1
        }
        if tcur != "" { tag_list = tag_list.push(int(tcur)) }
        // Emit each arm as if-else chain
        mut ai = 0
        while ai < tag_list.length && ai < bodies.length {
            cg_reinit_types()
            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            let next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            let tag_val = llvm.const_int(CG_I64, tag_list[ai], 0)
            let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
            forge_build_cond_br_trunc(CG_B, cmp, arm_bb, next_bb)
            llvm.position_at_end(CG_B, arm_bb)
            self.emit_block(bodies[ai])
            if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
            llvm.position_at_end(CG_B, next_bb)
            ai = ai + 1
        }
        // Default arm
        if has_def == 1 {
            self.emit_block(def)
        }
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, merge_bb)
    }

    fn emit_return(self, value: Expr) {
        match value {
            .NullLit(span) -> {
                if forge_fn_nullable_get_flag() == 1 {
                    llvm.build_ret(CG_B, make_null_value(forge_fn_nullable_get_inner()))
                } else {
                    llvm.build_ret_void(CG_B)
                }
            }
            _ -> { self.emit_ret_value(value) }
        }
    }

    fn emit_ret_value(self, value: Expr) {
        let ret_type = self.expr_type_name(value)
        let val = self.emit_expr(value)
        let is_nullable = ret_type == "nullable" || ret_type == "null"
        if forge_fn_nullable_get_flag() == 1 && !is_nullable {
            llvm.build_ret(CG_B, wrap_nullable(forge_fn_nullable_get_inner(), val))
        } else {
            llvm.build_ret(CG_B, val)
        }
    }

    fn dispatch_stmt(self, fe: FeatureStmt) {
        dispatch_emit_stmt(self, fe.data)
    }

    fn dispatch_expr(self, fe: FeatureExpr) -> ptr {
        let result = dispatch_emit_expr(self, fe.data)
        if result != null { return result }
        llvm.const_int(CG_I64, 0, 0)
    }

    // ─── Expressions ───────────────────────────

    fn emit_expr(self, expr: Expr) -> ptr {
        let depth = forge_emit_depth_push()
        if depth > 50 {
            forge_emit_depth_pop()
            return llvm.const_int(CG_I64, 0, 0)
        }
        let r = self.emit_expr_inner(expr)
        forge_emit_depth_pop()
        r
    }

    // Determine the type name of an expression WITHOUT emitting it
    fn expr_type_name(self, expr: Expr) -> string {
        match expr {
            .IntLit(_, _) -> { return "int" }
            .FloatLit(_, _) -> { return "float" }
            .StringLit(_, _) -> { return "string" }
            .BoolLit(_, _) -> { return "bool" }
            .NullLit(_) -> { return "null" }
            .Ident(name, _) -> {
                // Check alloca cache for stored Forge type name
                let var_type = forge_alloca_cache_get_var_type(name)
                if var_type.length > 0 { return var_type }
                // Fallback: LLVM type kind (0=miss, 8=i64, 10=struct, 12=ptr)
                let type_kind = forge_alloca_cache_type_id(name)
                if type_kind == 10 { return "string" }
                if type_kind == 12 { return "ptr" }
                if type_kind == 8 { return "int" }
                // Check if it's a global (i64-based to avoid ptr null check issue)
                let gkind = forge_global_type_kind(CG_MOD, name)
                if gkind == 10 { return "string" }  // StructTypeKind (ForgeString)
                if gkind == 12 { return "ptr" }     // PointerTypeKind
                if gkind == 8 { return "int" }      // IntegerTypeKind
                // Check function return types
                mut fi = 0
                while fi < FN_NAMES.length {
                    if FN_NAMES[fi] == name {
                        if fi < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[fi] }
                    }
                    fi = fi + 1
                }
                return "int"
            }
            .Call(callee, _, _) -> {
                match callee {
                    .Ident(name, _) -> {
                        // Struct literal: __s_TypeName → return TypeName
                        if name.length > 4 && name.substring(0, 4) == "__s_" {
                            return name.substring(4, name.length)
                        }
                        if name == "string" { return "string" }
                        if name == "int" { return "int" }
                        if name == "float" { return "float" }
                        if name == "bool" { return "bool" }
                        // Known runtime functions
                        if name == "forge_string_concat" { return "string" }
                        if name == "forge_string_substring" { return "string" }
                        if name == "forge_string_char_at" { return "string" }
                        if name == "forge_int_to_string" { return "string" }
                        if name == "forge_string_new" { return "string" }
                        if name == "forge_string_index_of" { return "int" }
                        if name == "forge_string_length" { return "int" }
                        if name == "forge_string_compare" { return "int" }
                        // User-defined functions
                        mut fi = 0
                        while fi < FN_NAMES.length {
                            if FN_NAMES[fi] == name {
                                if fi < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[fi] }
                                return "int"
                            }
                            fi = fi + 1
                        }
                    }
                    .MemberAccess(obj, method, _) -> {
                        if method == "substring" { return "string" }
                        if method == "char_at" { return "string" }
                        if method == "index_of" { return "int" }
                        if method == "length" { return "int" }
                        // Namespace methods
                        mut obj_name = ""
                        match obj {
                            .Ident(n, _) -> { obj_name = n }
                            _ -> {}
                        }
                        // Known namespace.method return types
                        if obj_name == "process" && method == "args" { return "list:string" }
                        if obj_name == "process" && method == "run" { return "string" }
                        if obj_name == "fs" && method == "read" { return "string" }
                        // Try looking up mangled name in FN_NAMES
                        if obj_name != "" {
                            let direct = obj_name + "_" + method
                            mut di = 0
                            while di < FN_NAMES.length {
                                if FN_NAMES[di] == direct {
                                    if di < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[di] }
                                }
                                di = di + 1
                            }
                            let prefixed = "forge_" + obj_name + "_" + method
                            mut pi2 = 0
                            while pi2 < FN_NAMES.length {
                                if FN_NAMES[pi2] == prefixed {
                                    if pi2 < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[pi2] }
                                }
                                pi2 = pi2 + 1
                            }
                        }
                        // Resolve impl method return type
                        if obj_name != "" {
                            let st = var_struct_type(obj_name)
                            if st != "" {
                                let mname = st + "_" + method
                                mut mi = 0
                                while mi < FN_NAMES.length {
                                    if FN_NAMES[mi] == mname {
                                        if mi < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[mi] }
                                    }
                                    mi = mi + 1
                                }
                            }
                        }
                    }
                    _ -> {}
                }
                return "int"
            }
            .Binary(l, op, r, _) -> {
                match op {
                    .Add -> {
                        // String + anything = string
                        let lt = self.expr_type_name(l)
                        let rt = self.expr_type_name(r)
                        if lt == "string" || rt == "string" { return "string" }
                        return "int"
                    }
                    .Eq -> { return "bool" }
                    .NotEq -> { return "bool" }
                    .Lt -> { return "bool" }
                    .LtEq -> { return "bool" }
                    .Gt -> { return "bool" }
                    .GtEq -> { return "bool" }
                    .And -> { return "bool" }
                    .Or -> { return "bool" }
                    _ -> { return "int" }
                }
            }
            .MemberAccess(obj, field, _) -> {
                if field == "length" { return "int" }
                // Look up struct field type via registered struct info
                let obj_type = self.expr_type_name(obj)
                if obj_type != "int" && obj_type != "string" && obj_type != "ptr" {
                    // obj_type is a struct name — look up the field's type
                    let fields_csv = forge_struct_type_get_fields(obj_type)
                    if fields_csv.length > 0 {
                        let fi = forge_struct_field_index(obj_type, field)
                        if fi >= 0 {
                            // Get field type from the struct's field_types registry
                            let field_types = forge_struct_type_get_field_types(obj_type)
                            if field_types.length > 0 {
                                // Parse CSV to get the fi-th type
                                mut fti = 0
                                mut ft_start = 0
                                mut ft_pos = 0
                                while ft_pos <= field_types.length {
                                    if ft_pos == field_types.length || field_types[ft_pos] == "," {
                                        if fti == fi {
                                            return field_types.substring(ft_start, ft_pos)
                                        }
                                        fti = fti + 1
                                        ft_start = ft_pos + 1
                                    }
                                    ft_pos = ft_pos + 1
                                }
                            }
                        }
                    }
                }
                return "int"
            }
            .Index(obj, _, _) -> {
                // Element type of list indexing
                let ot = self.expr_type_name(obj)
                if ot.length > 5 && ot.substring(0, 5) == "list:" {
                    return ot.substring(5, ot.length)
                }
                if ot == "string" { return "string" }
                return "int"
            }
            .IfExpr(_, _, _, _, _) -> { return "int" }
            .MatchExpr(_, _, _, _, _, _, _) -> { return "int" }
            _ -> { return "int" }
        }
        "int"
    }

    fn emit_expr_inner(self, expr: Expr) -> ptr {
        match expr {
            .IntLit(value, span) -> { return llvm.const_int(CG_I64, value, 0) }
            .FloatLit(value, span) -> { return llvm.const_real(CG_F64, value) }
            .StringLit(value, span) -> { return self.emit_string(value) }
            .BoolLit(value, span) -> {
                if value { return llvm.const_int(CG_I64, 1, 0) }
                return llvm.const_int(CG_I64, 0, 0)
            }
            .NullLit(span) -> {
                if forge_fn_nullable_get_flag() == 1 {
                    return make_null_value(forge_fn_nullable_get_inner())
                }
                return llvm.const_null(CG_PTR)
            }
            .Ident(name, span) -> { return self.emit_ident(name) }
            .Binary(left, op, right, span) -> { return self.emit_binary(left, op, right) }
            .Unary(op, operand, span) -> {
                let val = self.emit_expr(operand)
                match op {
                    .Neg -> { return llvm.build_sub(CG_B, llvm.const_int(CG_I64, 0, 0), val, "neg") }
                    .Not -> {
                        let cmp = llvm.build_icmp(CG_B, 32, val, llvm.const_int(CG_I64, 0, 0), "not")
                        return llvm.build_zext(CG_B, cmp, llvm.int64_type(CG_CTX), "nx")
                    }
                    .BitNot -> { return llvm.build_xor(CG_B, val, llvm.const_int(CG_I64, -1, 1), "bn") }
                }
            }
            .Call(callee, args, span) -> { return self.emit_call(callee, args) }
            .MemberAccess(obj, field, span) -> { return self.emit_member_access(obj, field) }
            .Index(obj, idx, span) -> {
                let obj_type = self.expr_type_name(obj)
                mut obj_var_name = ""
                match obj {
                    .Ident(n, s) -> { obj_var_name = n }
                    _ -> {}
                }
                let is_known_list = obj_type == "list" || obj_type == "List" || (obj_type.length > 5 && obj_type.substring(0, 5) == "list:")
                mut is_str_list = obj_type == "list:string" || obj_type == "List:string"
                let obj_type = self.expr_type_name(obj)
                let obj_val = self.emit_expr(obj)
                mut obj_is_str = 0
                mut obj_is_map = 0
                if obj_type == "string" { obj_is_str = 1 }
                if obj_type == "map" { obj_is_map = 1 }
                mut obj_is_list = 0
                if obj_type.length > 5 {
                    if obj_type.substring(0, 5) == "list:" { obj_is_list = 1 }
                }
                let idx_val = self.emit_expr(idx)
                cg_reinit_types()
                if obj_is_map == 1 {
                    // Map: forge_map_get(map_ptr, key) → i64
                    let ga = llvm.value_array_new(2)
                    llvm.value_array_set(ga, 0, obj_val)
                    llvm.value_array_set(ga, 1, idx_val)
                    let gt = llvm.type_array_new(2)
                    llvm.type_array_set(gt, 0, CG_PTR)
                    llvm.type_array_set(gt, 1, CG_STR)
                    let gf = llvm.function_type(CG_I64, gt, 2, 0)
                    llvm.type_array_free(gt)
                    let result = llvm.build_call(CG_B, gf, CG_RT_MAP_GET, ga, 2, "mg")
                    llvm.value_array_free(ga)
                    return result
                }
                // Default: use charAt for string indexing
                // Use GEP only for explicitly known list variables
                mut use_gep = is_known_list || is_str_list || obj_is_list == 1
                if !use_gep {
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, obj_val)
                    llvm.value_array_set(ca, 1, idx_val)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_I64)
                    let cf = llvm.function_type(CG_STR, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let result = llvm.build_call(CG_B, cf, CG_RT_SCHARAT, ca, 2, "ch")
                    llvm.value_array_free(ca)
                    return result
                }
                // List: extract data pointer, GEP to element, load
                cg_reinit_types()
                // Default to ForgeString for list elements (most Forge lists hold strings)
                // Override with specific type if known from alloca cache
                mut elem_ty = CG_STR
                let elt = list_elem_type(obj_var_name)
                if elt == "int" || elt == "bool" { elem_ty = CG_I64 }
                else if elt != "" && elt != "string" {
                    let resolved = resolve_type_to_llvm(elt)
                    if resolved != null { elem_ty = resolved }
                }
                let dp = llvm.build_extract_value(CG_B, obj_val, 0, "dp")
                if dp == null { return llvm.const_int(CG_I64, 0, 0) }
                // Ensure index is integer (might be ForgeString)
                mut safe_idx = idx_val
                let maybe_int = llvm.build_extract_value(CG_B, idx_val, 0, "ix")
                if maybe_int != null { safe_idx = maybe_int }
                let gi = llvm.value_array_new(1)
                llvm.value_array_set(gi, 0, safe_idx)
                let gp = llvm.build_gep2(CG_B, elem_ty, dp, gi, 1, "ep")
                llvm.value_array_free(gi)
                if gp == null { return llvm.const_int(CG_I64, 0, 0) }
                let ev = llvm.build_load(CG_B, elem_ty, gp, "ev")
                return ev
            }
            .Block(block) -> { return self.emit_block(block) }
            .IfExpr(cond, then_b, else_b, has_else, span) -> {
                return self.emit_if_expr(cond, then_b, else_b, has_else)
            }
            .MatchExpr(scrutinee, tags, binds, bodies, default_b, has_default, span) -> {
                return self.emit_match_expr_with_bindings(scrutinee, tags, binds, bodies, default_b, has_default)
            }
            .IsCheck(subject, variant_name, pred, span) -> {
                let obj_val = self.emit_expr(subject)
                // Use qualified name for tag lookup
                let subj_type = self.expr_type_name(subject)
                mut tag = match_enum_tag(subj_type + "." + variant_name)
                if tag < 0 { tag = match_enum_tag(variant_name) }
                let tag_val = llvm.const_int(CG_I64, tag, 0)
                // Extract tag from enum value for comparison
                // For struct-typed enums {i8 tag, ...}: extract field 0 and zext
                // For i64-typed enums: use the value directly (it IS the tag)
                mut cmp_lhs = obj_val
                let val_kind = forge_value_type_kind(obj_val)
                if val_kind == 10 {
                    // Struct type — extract tag (field 0)
                    let etag = llvm.build_extract_value(CG_B, obj_val, 0, "it")
                    cmp_lhs = llvm.build_zext(CG_B, etag, llvm.int64_type(CG_CTX), "ite")
                }
                let cmp = llvm.build_icmp(CG_B, pred, cmp_lhs, tag_val, "ic")
                let ext = llvm.build_zext(CG_B, cmp, llvm.int64_type(CG_CTX), "ie")
                return ext
            }
            .ForceUnwrap(operand, span) -> {
                // Force-unwrap: extract inner value from nullable {i8 tag, T value}
                let val = self.emit_expr(operand)
                let inner = llvm.build_extract_value(CG_B, val, 1, "unwrap")
                if inner != null { return inner }
                // Not a struct (already non-nullable), pass through
                return val
            }
            .Feature(fe) -> {
                return self.dispatch_expr(fe)
            }
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_if_expr(self, condition: Expr, then_block: Block, else_block: Block, has_else: int) -> ptr {
        cg_reinit_types()
        let cv = self.emit_expr(condition)
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let tb = llvm.append_basic_block(CG_CTX, fn_val, "th")
        let eb = llvm.append_basic_block(CG_CTX, fn_val, "el")
        let mb = llvm.append_basic_block(CG_CTX, fn_val, "mg")
        forge_build_cond_br_trunc(CG_B, cv, tb, eb)
        llvm.position_at_end(CG_B, tb)
        let tv = self.emit_block(then_block)
        let te = llvm.get_insert_block(CG_B)
        let tt = llvm.block_has_terminator(CG_B)
        if !tt { llvm.build_br(CG_B, mb) }
        llvm.position_at_end(CG_B, eb)
        mut ev = llvm.const_int(CG_I64, 0, 0)
        if has_else == 1 { ev = self.emit_block(else_block) }
        let ee = llvm.get_insert_block(CG_B)
        let et = llvm.block_has_terminator(CG_B)
        if !et { llvm.build_br(CG_B, mb) }
        llvm.position_at_end(CG_B, mb)
        if has_else == 1 && !tt && !et {
            let phi = llvm.build_phi(CG_B, CG_I64, "iv")
            llvm.add_incoming(phi, tv, te)
            llvm.add_incoming(phi, ev, ee)
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_match_call(self, patterns: string, args: List<Expr>) -> ptr {
        if args.length < 2 { return llvm.const_int(CG_I64, 0, 0) }
        // args[0] = scrutinee, args[1..] = arm bodies
        let subj = self.emit_expr(args[0])
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")

        // Parse patterns CSV and create arm blocks
        mut arm_idx = 0
        mut pat_pos = 0
        mut phi_vals: List<ptr> = []
        mut phi_bbs: List<ptr> = []

        while arm_idx < args.length - 1 {
            // Extract next pattern name
            mut pat = ""
            while pat_pos < patterns.length {
                let ch = patterns[pat_pos]
                pat_pos = pat_pos + 1
                if ch == "," { break }
                pat = pat + ch
            }

            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            mut next_bb = merge_bb
            if arm_idx < args.length - 2 {
                next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            }

            if pat == "_" {
                // Wildcard — unconditional branch
                llvm.build_br(CG_B, arm_bb)
            } else {
                // Enum variant — compare tag to variant index
                // Use qualified name (EnumName.VariantName) to avoid collisions
                let scrut_type = self.expr_type_name(args[0])
                mut tag_idx = match_enum_tag(scrut_type + "." + pat)
                if tag_idx < 0 { tag_idx = match_enum_tag(pat) }
                let tag_val = llvm.const_int(CG_I64, tag_idx, 0)
                // For struct-typed enums, extract tag first
                mut cmp_lhs = subj
                let scrut_is_enum = scrut_type.length > 5 && scrut_type.substring(0, 5) == "enum:"
                if scrut_is_enum {
                    let etag = llvm.build_extract_value(CG_B, subj, 0, "tg")
                    cmp_lhs = llvm.build_zext(CG_B, etag, CG_I64, "te")
                }
                let cmp = llvm.build_icmp(CG_B, 32, cmp_lhs, tag_val, "mc")
                forge_build_cond_br_trunc(CG_B, cmp, arm_bb, next_bb)
            }

            llvm.position_at_end(CG_B, arm_bb)
            let arm_val = self.emit_expr(args[arm_idx + 1])
            let arm_end = llvm.get_insert_block(CG_B)
            let mc_has_term = llvm.block_has_terminator(CG_B)
            if !mc_has_term {
                llvm.build_br(CG_B, merge_bb)
            }
            if !mc_has_term {
                phi_vals = phi_vals.push(arm_val)
                phi_bbs = phi_bbs.push(arm_end)
            }

            if pat != "_" && arm_idx < args.length - 2 {
                llvm.position_at_end(CG_B, next_bb)
            }
            arm_idx = arm_idx + 1
        }

        llvm.position_at_end(CG_B, merge_bb)
        // Build PHI if multiple arms
        if phi_vals.length > 0 {
            let phi = llvm.build_phi(CG_B, CG_I64, "mv")
            mut pi = 0
            while pi < phi_vals.length {
                llvm.add_incoming(phi, phi_vals[pi], phi_bbs[pi])
                pi = pi + 1
            }
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_match_expr_with_bindings(self, scrutinee: Expr, arm_tags_csv: string, arm_bindings_csv: string, arm_bodies: List<Block>, default_body: Block, has_default: int) -> ptr {
        let subj_raw = self.emit_expr(scrutinee)
        // For enum scrutinees, extract the tag byte
        mut subj = subj_raw
        let val_kind = forge_value_type_kind(subj_raw)
        if val_kind == 10 {
            let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
            subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
        }
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")
        // Parse tag CSV
        mut tags: List<int> = []
        mut tpos = 0
        mut tcur = ""
        while tpos < arm_tags_csv.length {
            let ch = arm_tags_csv[tpos]
            if ch == "," { tags = tags.push(int(tcur))
                tcur = "" } else { tcur = tcur + ch }
            tpos = tpos + 1
        }
        if tcur != "" { tags = tags.push(int(tcur)) }
        // Bindings are stored in C-side registry as "__mb0", "__mb1", etc.
        // The arm_bindings_csv is "__mb:N" where N is the count
        // Retrieve each binding from C-side at codegen time
        // Emit each arm as if-else chain with binding extraction
        let _bodies = arm_bodies
        mut phi_vals: List<ptr> = []
        mut phi_bbs: List<ptr> = []
        mut ai = 0
        while ai < tags.length {
            cg_reinit_types()
            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            let next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            let tag_val = llvm.const_int(CG_I64, tags[ai], 0)
            let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
            forge_build_cond_br_trunc(CG_B, cmp, arm_bb, next_bb)
            llvm.position_at_end(CG_B, arm_bb)
            // Extract bindings for this arm (ALL via C-side, no string ops in self-hosted code)
            let variant_qname = forge_match_binding_variant(ai)
            let bind_count = forge_match_binding_name_count(ai)
            if bind_count > 0 {
                // Get field type codes from C-side registry
                let field_types = cg_enum_variant_field_types_from_qname(variant_qname)
                mut fi = 0
                while fi < bind_count {
                    let bpname = forge_match_binding_name_at(ai, fi)
                    if bpname.length > 0 {
                        cg_reinit_types()
                        let slot_off = cg_enum_field_slot_offset(field_types, fi)
                        let slot = 1 + slot_off
                        mut fcode = "i"
                        if fi < field_types.length { fcode = field_types[fi] }
                        let slots = field_type_slots(fcode)
                        if slots >= 2 {
                            // ForgeString/List: extract 2 slots, build struct
                            let ev0 = llvm.build_extract_value(CG_B, subj_raw, slot, "b0")
                            let ev1 = llvm.build_extract_value(CG_B, subj_raw, slot + 1, "b1")
                            if ev0 != null {
                                let ev0_ptr = llvm.build_inttoptr(CG_B, ev0, CG_PTR, "sp")
                                let fs = llvm.build_insert_value(CG_B, llvm.get_undef(CG_STR), ev0_ptr, 0, "fs")
                                mut fsv = fs
                                if ev1 != null { fsv = llvm.build_insert_value(CG_B, fs, ev1, 1, "fs") }
                                // Use define_var_typed to create entry-block alloca
                                self.define_var_typed(bpname, "string", fsv)
                            }
                        } else if fcode == "p" {
                            // Pointer/enum: look up actual type from registry
                            let ev = llvm.build_extract_value(CG_B, subj_raw, slot, "b")
                            if ev != null {
                                let field_type_name = forge_enum_field_type_name(variant_qname, fi)
                                mut type_str = "int"
                                if field_type_name.length > 0 { type_str = field_type_name }
                                self.define_var_typed(bpname, type_str, ev)
                            }
                        } else {
                            // Integer/bool: extract single slot
                            let ev = llvm.build_extract_value(CG_B, subj_raw, slot, "b")
                            if ev != null {
                                self.define_var_typed(bpname, "int", ev)
                            }
                        }
                    }
                    fi = fi + 1
                }
            }
            let av = self.emit_block(_bodies[ai])
            let ae = llvm.get_insert_block(CG_B)
            let arm_has_term = llvm.block_has_terminator(CG_B)
            if !arm_has_term { llvm.build_br(CG_B, merge_bb) }
            if !arm_has_term {
                phi_vals = phi_vals.push(av)
                phi_bbs = phi_bbs.push(ae)
            }
            llvm.position_at_end(CG_B, next_bb)
            ai = ai + 1
        }
        // Default/fallthrough arm
        if has_default == 1 {
            let dv = self.emit_block(default_body)
            let de = llvm.get_insert_block(CG_B)
            let def_has_term = llvm.block_has_terminator(CG_B)
            if !def_has_term { llvm.build_br(CG_B, merge_bb) }
            if !def_has_term {
                phi_vals = phi_vals.push(dv)
                phi_bbs = phi_bbs.push(de)
            }
        } else {
            let def_val = llvm.const_int(CG_I64, 0, 0)
            phi_vals = phi_vals.push(def_val)
            phi_bbs = phi_bbs.push(llvm.get_insert_block(CG_B))
            llvm.build_br(CG_B, merge_bb)
        }
        llvm.position_at_end(CG_B, merge_bb)
        if phi_vals.length > 0 {
            let phi = llvm.build_phi(CG_B, CG_I64, "mv")
            mut pi = 0
            while pi < phi_vals.length {
                llvm.add_incoming(phi, phi_vals[pi], phi_bbs[pi])
                pi = pi + 1
            }
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_match_expr(self, scrutinee: Expr, arm_tags_csv: string, arm_bodies: List<Block>, default_body: Block, has_default: int) -> ptr {
        let subj_raw = self.emit_expr(scrutinee)
        // For enum scrutinees, extract the tag byte
        mut subj = subj_raw
        // Try extract_value to get tag — returns null if not aggregate
        let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
        if tag_byte != null {
            subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
        }
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")
        // Parse tag CSV
        mut tags: List<int> = []
        mut tpos = 0
        mut tcur = ""
        while tpos < arm_tags_csv.length {
            let ch = arm_tags_csv[tpos]
            if ch == "," {
                tags = tags.push(int(tcur))
                tcur = ""
            } else {
                tcur = tcur + ch
            }
            tpos = tpos + 1
        }
        if tcur != "" { tags = tags.push(int(tcur)) }
        // Emit each arm as if-else chain
        mut phi_vals: List<ptr> = []
        mut phi_bbs: List<ptr> = []
        let _bodies = arm_bodies
        mut ai = 0
        while ai < tags.length {
            cg_reinit_types()
            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            let next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            let tag_val = llvm.const_int(CG_I64, tags[ai], 0)
            let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
            forge_build_cond_br_trunc(CG_B, cmp, arm_bb, next_bb)
            llvm.position_at_end(CG_B, arm_bb)
            let av = self.emit_block(_bodies[ai])
            let ae = llvm.get_insert_block(CG_B)
            let arm_has_term = llvm.block_has_terminator(CG_B)
            if !arm_has_term { llvm.build_br(CG_B, merge_bb) }
            // Only add PHI entry if this arm actually branches to merge (no early return)
            if !arm_has_term {
                phi_vals = phi_vals.push(av)
                phi_bbs = phi_bbs.push(ae)
            }
            llvm.position_at_end(CG_B, next_bb)
            ai = ai + 1
        }
        // Default/fallthrough arm
        if has_default == 1 {
            let dv = self.emit_block(default_body)
            let de = llvm.get_insert_block(CG_B)
            let def_has_term = llvm.block_has_terminator(CG_B)
            if !def_has_term { llvm.build_br(CG_B, merge_bb) }
            if !def_has_term {
                phi_vals = phi_vals.push(dv)
                phi_bbs = phi_bbs.push(de)
            }
        } else {
            // No default — add empty fallthrough for PHI completeness
            let def_val = llvm.const_int(CG_I64, 0, 0)
            phi_vals = phi_vals.push(def_val)
            phi_bbs = phi_bbs.push(llvm.get_insert_block(CG_B))
            llvm.build_br(CG_B, merge_bb)
        }
        llvm.position_at_end(CG_B, merge_bb)
        if phi_vals.length > 0 {
            let phi = llvm.build_phi(CG_B, CG_I64, "mv")
            mut pi = 0
            while pi < phi_vals.length {
                llvm.add_incoming(phi, phi_vals[pi], phi_bbs[pi])
                pi = pi + 1
            }
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_struct_lit(self, struct_name: string, field_values: List<Expr>) -> ptr {
        cg_reinit_types()
        let struct_ty = resolve_type_to_llvm(struct_name)
        if struct_ty == CG_I64 { return llvm.const_int(CG_I64, 0, 0) }
        let alloca = llvm.build_alloca(CG_B, struct_ty, "sl")
        llvm.build_store(CG_B, llvm.const_null(struct_ty), alloca)
        mut fi = 0
        let _fv = field_values
        for fexpr in _fv {
            let val = self.emit_expr(fexpr)
            let fp = llvm.build_struct_gep2(CG_B, struct_ty, alloca, fi, "sf")
            llvm.build_store(CG_B, val, fp)
            fi = fi + 1
        }
        // Load completed struct
        let sv = llvm.build_load(CG_B, struct_ty, alloca, "sv")
        sv
    }

    fn emit_assign(self, target: Expr, value: Expr) {
        match target {
            .Ident(name, span) -> {
                let val = self.emit_expr(value)
                // Find alloca from cache (returns ptr-as-i64, 0 for miss)
                let alloca_i = forge_alloca_cache_has(name)
                if alloca_i != 0 {
                    llvm.build_store(CG_B, val, alloca_i)
                    return
                }
                // Try global variable (i64-based to avoid ptr null check issue)
                let gptr_i = forge_get_named_global_i64(CG_MOD, name)
                if gptr_i != 0 {
                    forge_store_to_global(CG_B, val, gptr_i)
                    return
                }
            }
            .Index(obj, idx, span) -> {
                // Map index assignment: map["key"] = val → forge_map_set(map, key, val)
                let map_val = self.emit_expr(obj)
                let key_val = self.emit_expr(idx)
                let rhs_val = self.emit_expr(value)
                let sa = llvm.value_array_new(3)
                llvm.value_array_set(sa, 0, map_val)
                llvm.value_array_set(sa, 1, key_val)
                llvm.value_array_set(sa, 2, rhs_val)
                cg_reinit_types()
                let sft = mft3(CG_VOID, CG_PTR, CG_STR, CG_I64)
                llvm.build_call(CG_B, sft, CG_RT_MAP_SET, sa, 3, "")
                llvm.value_array_free(sa)
            }
            .MemberAccess(obj, field, span) -> {
                // Struct field assignment: self.pos = val
                let val = self.emit_expr(value)
                mut obj_name = ""
                match obj {
                    .Ident(n, _) -> { obj_name = n }
                    _ -> {}
                }
                if obj_name != "" {
                    let struct_type_name = var_struct_type(obj_name)
                    if struct_type_name != "" {
                        let fidx = struct_field_index(struct_type_name, field)
                        if fidx >= 0 {
                            let obj_alloca = forge_alloca_cache_has(obj_name)
                            if obj_alloca != 0 {
                                    cg_reinit_types()
                                    let struct_ty = llvm.get_type_by_name(CG_CTX, struct_type_name)
                                    if struct_ty != null {
                                        let fp = llvm.build_struct_gep2(CG_B, struct_ty, obj_alloca, fidx, "sf")
                                        if fp != null {
                                            llvm.build_store(CG_B, val, fp)
                                        }
                                    }
                                    return
                            }
                        }
                    }
                }
            }
            .Index(obj, idx, s) -> {
                // Map index assignment: map[key] = value
                let map_val = self.emit_expr(obj)
                let key_val = self.emit_expr(idx)
                let rhs_val = self.emit_expr(value)
                let sa = llvm.value_array_new(3)
                llvm.value_array_set(sa, 0, map_val)
                llvm.value_array_set(sa, 1, key_val)
                llvm.value_array_set(sa, 2, rhs_val)
                let st = llvm.type_array_new(3)
                llvm.type_array_set(st, 0, CG_PTR)
                llvm.type_array_set(st, 1, CG_STR)
                llvm.type_array_set(st, 2, CG_I64)
                let sf = llvm.function_type(CG_VOID, st, 3, 0)
                llvm.type_array_free(st)
                llvm.build_call(CG_B, sf, CG_RT_MAP_SET, sa, 3, "")
                llvm.value_array_free(sa)
            }
            _ -> {}
        }
    }

    fn emit_if_from_block(self, block: Block) -> ptr {
        // block.statements[0] = marker, [1] = condition, [2] = then block
        // Bootstrap workaround: avoid match-as-expression for Expr (returns i64 instead of Expr).
        // Use match arms directly — destructured values used in-arm work correctly.
        let cond_stmt = block.statements[1]
        let then_stmt = block.statements[2]

        // Emit condition: match arm uses destructured Expr directly
        mut cond_val = llvm.const_int(CG_I64, 0, 0)
        match cond_stmt {
            .Expr(e) -> { cond_val = self.emit_expr(e) }
            _ -> {}
        }
        let current_fn = self.current_fn
        let then_bb = llvm.append_basic_block(CG_CTX, current_fn, "th")
        let merge_bb = llvm.append_basic_block(CG_CTX, current_fn, "ic")

        forge_build_cond_br_trunc(CG_B, cond_val, then_bb, merge_bb)

        // Emit then block
        llvm.position_at_end(CG_B, then_bb)
        match then_stmt {
            .Expr(e) -> { self.emit_expr(e) }
            _ -> {}
        }
        llvm.build_br(CG_B, merge_bb)

        // Continue at merge
        llvm.position_at_end(CG_B, merge_bb)
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_string_concat(self, lhs: ptr, lhs_is_str: int, rhs: ptr, rhs_is_str: int) -> ptr {
        // Auto-stringify non-string operands
        mut l = lhs
        mut r = rhs
        if lhs_is_str != 1 {
            let ca = llvm.value_array_new(1)
            llvm.value_array_set(ca, 0, lhs)
            let ft = mft1(CG_STR, CG_I64)
            l = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "l2s")
            llvm.value_array_free(ca)
        }
        if rhs_is_str != 1 {
            let ca = llvm.value_array_new(1)
            llvm.value_array_set(ca, 0, rhs)
            let ft = mft1(CG_STR, CG_I64)
            r = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "r2s")
            llvm.value_array_free(ca)
        }
        let ca = llvm.value_array_new(2)
        llvm.value_array_set(ca, 0, l)
        llvm.value_array_set(ca, 1, r)
        let ft = mft2(CG_STR, CG_STR, CG_STR)
        let result = llvm.build_call(CG_B, ft, CG_RT_SCONCAT, ca, 2, "cc")
        llvm.value_array_free(ca)
        result
    }

    fn emit_list_literal(self, elements: List<Expr>) -> ptr {
        cg_reinit_types()
        let count = elements.length
        let count_val = llvm.const_int(CG_I64, count, 0)
        mut elem_ty = CG_I64
        mut elem_size = 8
        let vals = llvm.value_array_new(count)
        mut i = 0
        for elem in elements {
            let val = self.emit_expr(elem)
            llvm.value_array_set(vals, i, val)
            if i == 0 {
                let ety = self.expr_type_name(elem)
                if ety == "string" {
                    elem_ty = CG_STR
                    elem_size = 16
                }
            }
            i = i + 1
        }
        let elem_size_val = llvm.const_int(CG_I64, elem_size, 0)
        let size = llvm.build_mul(CG_B, count_val, elem_size_val, "lsz")
        let ca = llvm.value_array_new(1)
        llvm.value_array_set(ca, 0, size)
        let ft = mft1(CG_PTR, CG_I64)
        let data_ptr = llvm.build_call(CG_B, ft, CG_RT_ALLOC, ca, 1, "ld")
        llvm.value_array_free(ca)
        i = 0
        while i < count {
            let idx = llvm.const_int(CG_I64, i, 0)
            let indices = llvm.value_array_new(1)
            llvm.value_array_set(indices, 0, idx)
            let elem_ptr = llvm.build_gep2(CG_B, elem_ty, data_ptr, indices, 1, "ep")
            llvm.value_array_free(indices)
            llvm.build_store(CG_B, llvm.value_array_get(vals, i), elem_ptr)
            i = i + 1
        }
        llvm.value_array_free(vals)
        cg_reinit_types()
        let undef = llvm.get_undef(CG_LIST)
        let s1 = llvm.build_insert_value(CG_B, undef, data_ptr, 0, "ls1")
        llvm.build_insert_value(CG_B, s1, count_val, 1, "ls2")
    }

    fn emit_string(self, value: string) -> ptr {
        // Create string as a constant struct (position-independent, no builder call needed)
        // This prevents forward SSA references when strings are used in loop bodies
        llvm.const_string(CG_MOD, value, value.length)
    }

    fn emit_ident(self, name: string) -> ptr {
        // 1. Local variables: C-side lookup + load (returns LLVM value as i64, 0 for miss)
        let loaded = forge_alloca_cache_load(name, CG_B, CG_I64)
        if loaded != 0 { return loaded }
        // 2. Global variables (i64-based to avoid ptr null check issue)
        let gptr_i = forge_get_named_global_i64(CG_MOD, name)
        if gptr_i != 0 {
            let loaded_g = forge_load_from_global(CG_B, gptr_i, name)
            if loaded_g != 0 { return loaded_g }
        }
        // 3. Functions
        let fn_ref = llvm.get_named_function(CG_MOD, name)
        if fn_ref != null { return fn_ref }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_member_access(self, obj: Expr, field: string) -> ptr {
        mut var_name = ""
        match obj {
            .Ident(name, span) -> { var_name = name }
            .MemberAccess(inner_obj, inner_field, _) -> {
                // Chained access: self.source.length → emit inner first
                let inner_val = self.emit_member_access(inner_obj, inner_field)
                // Handle .length on the result
                if field == "length" {
                    let ca = llvm.value_array_new(1)
                    llvm.value_array_set(ca, 0, inner_val)
                    let ft = mft1(CG_I64, CG_STR)
                    let result = llvm.build_call(CG_B, ft, CG_RT_SLEN, ca, 1, "len")
                    llvm.value_array_free(ca)
                    return result
                }
                return inner_val
            }
            _ -> { return llvm.const_int(CG_I64, 0, 0) }
        }
        if var_name == "" { return llvm.const_int(CG_I64, 0, 0) }

        // Enum constructor: Color.Green → tag value
        let tag = match_enum_tag(var_name + "." + field)
        if tag >= 0 {
            return llvm.const_int(CG_I64, tag, 0)
        }

        // Special case: .length property on string/list variables
        if field == "length" {
            // Try struct field access (for struct-typed vars like Lexer)
            let st = var_struct_type(var_name)
            if st != "" {
                let len_val = forge_alloca_cache_load_field(var_name, st, struct_field_index(st, "length"), CG_B)
                if len_val != 0 { return len_val }
            }
            // For strings/lists: call forge_string_length
            let obj_val = self.emit_ident(var_name)
            let ca = llvm.value_array_new(1)
            llvm.value_array_set(ca, 0, obj_val)
            let ft = mft1(CG_I64, CG_STR)
            let result = llvm.build_call(CG_B, ft, CG_RT_SLEN, ca, 1, "len")
            llvm.value_array_free(ca)
            return result
        }

        // Look up the variable's struct type
        let struct_type_name = var_struct_type(var_name)
        if struct_type_name == "" { return llvm.const_int(CG_I64, 0, 0) }

        // Find the field index in the struct's field list
        let fidx = struct_field_index(struct_type_name, field)
        if fidx < 0 { return llvm.const_int(CG_I64, 0, 0) }

        // Use GEP to access the field directly from the alloca (avoids loading the whole struct)
        let field_val = forge_alloca_cache_load_field(var_name, struct_type_name, fidx, CG_B)
        if field_val != 0 { return field_val }

        // Fallback: load whole struct and extract
        let obj_val = self.emit_ident(var_name)
        llvm.build_extract_value(CG_B, obj_val, fidx, field)
    }

    fn emit_binary(self, left: Expr, op: BinOp, right: Expr) -> ptr {
        // Emit both sides first
        let lhs = self.emit_expr(left)
        let rhs = self.emit_expr(right)
        // Detect types from LLVM values (central, reliable)
        mut lhs_is_str = forge_value_is_string(lhs)
        mut rhs_is_str = forge_value_is_string(rhs)
        // Also check expr_type_name as fallback (for cases where value type is i64 but Forge type is string)
        let left_type = self.expr_type_name(left)
        let right_type = self.expr_type_name(right)
        if left_type == "string" { lhs_is_str = 1 }
        if right_type == "string" { rhs_is_str = 1 }
        match op {
            .Add -> {
                if lhs_is_str == 1 && rhs_is_str == 1 {
                    return self.emit_string_concat(lhs, lhs_is_str, rhs, rhs_is_str)
                }
                // Rust build_add auto-detects remaining cases (struct + any → concat)
                return llvm.build_add(CG_B, lhs, rhs, "add")
            }
            .Sub -> { return llvm.build_sub(CG_B, lhs, rhs, "sub") }
            .Mul -> { return llvm.build_mul(CG_B, lhs, rhs, "mul") }
            .Div -> { return llvm.build_sdiv(CG_B, lhs, rhs, "div") }
            .Mod -> { return llvm.build_srem(CG_B, lhs, rhs, "mod") }
            .Eq -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    // String comparison: forge_string_compare(a, b) == 0
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp_result = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 32, cmp_result, llvm.const_int(CG_I64, 0, 0), "eq")
                }
                // Null comparison: compare against i64 0 (type-safe for both ptr and int)
                if right_type == "null" {
                    return llvm.build_icmp(CG_B, 32, lhs, llvm.const_int(CG_I64, 0, 0), "eq")
                }
                if left_type == "null" {
                    return llvm.build_icmp(CG_B, 32, rhs, llvm.const_int(CG_I64, 0, 0), "eq")
                }
                return llvm.build_icmp(CG_B, 32, lhs, rhs, "eq")
            }
            .NotEq -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp_result = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 33, cmp_result, llvm.const_int(CG_I64, 0, 0), "ne")
                }
                // Null comparison: compare against i64 0 (type-safe for both ptr and int)
                if right_type == "null" {
                    return llvm.build_icmp(CG_B, 33, lhs, llvm.const_int(CG_I64, 0, 0), "ne")
                }
                if left_type == "null" {
                    return llvm.build_icmp(CG_B, 33, rhs, llvm.const_int(CG_I64, 0, 0), "ne")
                }
                return llvm.build_icmp(CG_B, 33, lhs, rhs, "ne")
            }
            .Lt -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 40, cmp, llvm.const_int(CG_I64, 0, 0), "lt")
                }
                return llvm.build_icmp(CG_B, 40, lhs, rhs, "lt")
            }
            .LtEq -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 41, cmp, llvm.const_int(CG_I64, 0, 0), "le")
                }
                return llvm.build_icmp(CG_B, 41, lhs, rhs, "le")
            }
            .Gt -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 38, cmp, llvm.const_int(CG_I64, 0, 0), "gt")
                }
                return llvm.build_icmp(CG_B, 38, lhs, rhs, "gt")
            }
            .GtEq -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 39, cmp, llvm.const_int(CG_I64, 0, 0), "ge")
                }
                return llvm.build_icmp(CG_B, 39, lhs, rhs, "ge")
            }
            .BitAnd -> { return llvm.build_and(CG_B, lhs, rhs, "ba") }
            .BitOr -> { return llvm.build_or(CG_B, lhs, rhs, "bo") }
            .BitXor -> { return llvm.build_xor(CG_B, lhs, rhs, "bx") }
            .Shl -> { return llvm.build_shl(CG_B, lhs, rhs, "sl") }
            .Shr -> { return llvm.build_ashr(CG_B, lhs, rhs, "sr") }
            .And -> {
                // Ensure both operands are i64 (icmp returns i1, needs zext)
                let lz = llvm.build_zext(CG_B, lhs, CG_I64, "al")
                let rz = llvm.build_zext(CG_B, rhs, CG_I64, "ar")
                mut al = lhs
                mut ar = rhs
                if lz != null { al = lz }
                if rz != null { ar = rz }
                return llvm.build_and(CG_B, al, ar, "and")
            }
            .Or -> {
                let lz = llvm.build_zext(CG_B, lhs, CG_I64, "ol")
                let rz = llvm.build_zext(CG_B, rhs, CG_I64, "or")
                mut ol = lhs
                mut or2 = rhs
                if lz != null { ol = lz }
                if rz != null { or2 = rz }
                return llvm.build_or(CG_B, ol, or2, "or")
            }
            .Pipe -> { return rhs }
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_call(self, callee: Expr, args: List<Expr>) -> ptr {
        match callee {
            .Ident(name, span) -> {
                if name == "println" { return self.emit_println(args) }
                if name == "print" { return self.emit_println(args) }
                if name == "eprintln" { return self.emit_println(args) }
                if name == "eprint" { return self.emit_println(args) }
                // Struct literal: __s_TypeName(field1, field2, ...)
                if name.length > 4 && name.substring(0, 4) == "__s_" {
                    let sn = name.substring(4, name.length)
                    return self.emit_struct_lit(sn, args)
                }
                // Match expression: __m_pat1,pat2,...(scrutinee, body1, body2, ...)
                if name.length > 4 && name.substring(0, 4) == "__m_" {
                    let patterns = name.substring(4, name.length)
                    return self.emit_match_call(patterns, args)
                }
                // Cast functions: string(x), int(x), float(x), bool(x)
                if name == "string" && args.length > 0 {
                    let val = self.emit_expr(args[0])
                    // Call forge_int_to_string(val) → ForgeString
                    let ca = llvm.value_array_new(1)
                    llvm.value_array_set(ca, 0, val)
                    let ft = mft1(CG_STR, CG_I64)
                    let result = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "i2s")
                    llvm.value_array_free(ca)
                    return result
                }
                // Look up function by name in the LLVM module (not Map — Map ptrs are corrupt)
                let fn_ref = llvm.get_named_function(CG_MOD, name)
                if fn_ref != null {
                    let call_result = self.emit_fn_call_direct(fn_ref, name, args)
                    forge_last_val_clear()
                    return call_result
                }
            }
            .MemberAccess(o, f, s) -> {
                // Built-in method calls: obj.has(key), obj.push(val), etc.
                if f == "has" && args.length >= 1 {
                    let obj_val = self.emit_expr(o)
                    let key_val = self.emit_expr(args[0])
                    let ha = llvm.value_array_new(2)
                    llvm.value_array_set(ha, 0, obj_val)
                    llvm.value_array_set(ha, 1, key_val)
                    cg_reinit_types()
                    let hft = mft2(CG_I8, CG_PTR, CG_STR)
                    let hresult = llvm.build_call(CG_B, hft, CG_RT_MAP_HAS, ha, 2, "has")
                    llvm.value_array_free(ha)
                    return llvm.build_zext(CG_B, hresult, llvm.int64_type(CG_CTX), "hx")
                }

                // List.push(elem): obj.push(val) → forge_list_push(obj, &val, elem_size)
                if f == "push" && args.length >= 1 {
                    let obj_val = self.emit_expr(o)
                    let elem_val = self.emit_expr(args[0])
                    // Determine element type from the list variable's type
                    mut obj_var_name = ""
                    match o {
                        .Ident(n, _) -> { obj_var_name = n }
                        _ -> {}
                    }
                    // Detect element type from LLVM value (source of truth — no string ops needed)
                    mut elem_ty = llvm.type_of(elem_val)
                    if elem_ty == null { elem_ty = CG_I64 }
                    // Store elem to temp alloca, get its address
                    let tmp = llvm.build_alloca(CG_B, elem_ty, "pe")
                    llvm.build_store(CG_B, elem_val, tmp)
                    // Compute element size via GEP trick
                    let null_ptr = llvm.const_null(CG_PTR)
                    let gep_args = llvm.value_array_new(1)
                    llvm.value_array_set(gep_args, 0, llvm.const_int(CG_I64, 1, 0))
                    let gep = llvm.build_gep2(CG_B, elem_ty, null_ptr, gep_args, 1, "sz")
                    llvm.value_array_free(gep_args)
                    let elem_size = llvm.build_ptrtoint(CG_B, gep, CG_I64, "es")
                    // Call forge_list_push(list, &elem, size) → new list
                    cg_reinit_types()
                    let pa = llvm.value_array_new(3)
                    llvm.value_array_set(pa, 0, obj_val)
                    llvm.value_array_set(pa, 1, tmp)
                    llvm.value_array_set(pa, 2, elem_size)
                    let push_fn = llvm.get_named_function(CG_MOD, "forge_list_push")
                    if push_fn != null {
                        let push_ty = llvm.global_get_value_type(push_fn)
                        let result = llvm.build_call(CG_B, push_ty, push_fn, pa, 3, "lp")
                        llvm.value_array_free(pa)
                        return result
                    }
                    llvm.value_array_free(pa)
                    return obj_val
                }

                // Map.set(key, val): obj.set(key, val) → forge_map_set(obj, key, val)
                if f == "set" && args.length >= 2 {
                    let obj_val = self.emit_expr(o)
                    let key_val = self.emit_expr(args[0])
                    let set_val = self.emit_expr(args[1])
                    // Convert set_val to i64 if needed
                    mut val_i64 = set_val
                    if forge_value_type_kind(set_val) == 12 {
                        // Pointer value → ptrtoint
                        val_i64 = llvm.build_ptrtoint(CG_B, set_val, CG_I64, "si")
                    }
                    let sa = llvm.value_array_new(3)
                    llvm.value_array_set(sa, 0, obj_val)
                    llvm.value_array_set(sa, 1, key_val)
                    llvm.value_array_set(sa, 2, val_i64)
                    cg_reinit_types()
                    let set_fn = llvm.get_named_function(CG_MOD, "forge_map_set")
                    if set_fn != null {
                        let set_ty = llvm.global_get_value_type(set_fn)
                        llvm.build_call(CG_B, set_ty, set_fn, sa, 3, "ms")
                    }
                    llvm.value_array_free(sa)
                    return obj_val
                }

                // Namespace.method call: process.args(), fs.read(), llvm.build_add(), etc.
                mut ns = ""
                match o {
                    .Ident(n, _) -> { ns = n }
                    _ -> {}
                }
                if ns != "" {
                    // Build function name: namespace_method or forge_namespace_method
                    // Try: name as-is first (for llvm_* calls), then forge_ prefixed
                    let direct_name = ns + "_" + f
                    let fn_ref = llvm.get_named_function(CG_MOD, direct_name)
                    if fn_ref != null {
                        return self.emit_fn_call_direct(fn_ref, direct_name, args)
                    }
                    // Try forge_ prefix: process.args → forge_process_args
                    let prefixed = "forge_" + ns + "_" + f
                    let fn_ref2 = llvm.get_named_function(CG_MOD, prefixed)
                    if fn_ref2 != null {
                        return self.emit_fn_call_direct(fn_ref2, prefixed, args)
                    }
                    // Try _s suffix: forge_llvm_X_s (ForgeString-accepting wrappers)
                    let prefixed_s = "forge_" + ns + "_" + f + "_s"
                    let fn_ref2s = llvm.get_named_function(CG_MOD, prefixed_s)
                    if fn_ref2s != null {
                        return self.emit_fn_call_direct(fn_ref2s, prefixed_s, args)
                    }
                    // Try ns_method_s (direct _s suffix)
                    let direct_s = ns + "_" + f + "_s"
                    let fn_ref_ds = llvm.get_named_function(CG_MOD, direct_s)
                    if fn_ref_ds != null {
                        return self.emit_fn_call_direct(fn_ref_ds, direct_s, args)
                    }
                    // Try forge_selfhost_ prefix: process.args → forge_selfhost_process_args
                    let selfhost = "forge_selfhost_" + ns + "_" + f
                    let fn_ref_sh = llvm.get_named_function(CG_MOD, selfhost)
                    if fn_ref_sh != null {
                        return self.emit_fn_call_direct(fn_ref_sh, selfhost, args)
                    }
                    // Try method call: Type__method (impl methods)
                    // Resolve the struct type name for the object variable
                    mut impl_ns = ns
                    let st = var_struct_type(ns)
                    if st != "" { impl_ns = st }
                    // Try method call: Type_method (single underscore, matches Rust convention)
                    let method_name = impl_ns + "_" + f
                    let fn_ref3 = llvm.get_named_function(CG_MOD, method_name)
                    if fn_ref3 != null {
                        // Prepend self (the object) as first arg — pass by pointer
                        let obj_alloca_i = forge_alloca_cache_has(ns)
                        mut obj_ptr = self.emit_ident(ns)
                        if obj_alloca_i != 0 { obj_ptr = obj_alloca_i }
                        cg_reinit_types()
                        let total_args = args.length + 1
                        let arg_arr = llvm.value_array_new(total_args)
                        llvm.value_array_set(arg_arr, 0, obj_ptr)
                        mut argi = 0
                        for arg in args {
                            llvm.value_array_set(arg_arr, argi + 1, self.emit_expr(arg))
                            argi = argi + 1
                        }
                        // Build function type with self as first param
                        let param_arr = llvm.type_array_new(total_args)
                        // Use the function's declared type
                        let fn_ty = llvm.global_get_value_type(fn_ref3)
                        let result = llvm.build_call(CG_B, fn_ty, fn_ref3, arg_arr, total_args, "mc")
                        llvm.value_array_free(arg_arr)
                        return result
                    }
                }
            }
            .IsCheck(s, v, p, sp) -> {}
            .ForceUnwrap(o, sp) -> {}
            .Feature(fe) -> {}
            .Binary(l, o, r, s) -> {}
            .Unary(o, e, s) -> {}
            .Call(c, a, s) -> {}
            .IntLit(v, s) -> {}
            .FloatLit(v, s) -> {}
            .StringLit(v, s) -> {}
            .BoolLit(v, s) -> {}
            .NullLit(s) -> {}
            .Index(o, i, s) -> {}
            .Block(b) -> {}
            .IfExpr(c, t, e, h, sp) -> {}
            .MatchExpr(s2, t2, bd2, b2, d, hd, sp2) -> {}
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_fn_call_direct(self, fn_val: ptr, fn_name: string, args: List<Expr>) -> ptr {
        // Emit all argument values
        let arg_arr = llvm.value_array_new(args.length)
        mut i = 0
        for arg in args {
            llvm.value_array_set(arg_arr, i, self.emit_expr(arg))
            i = i + 1
        }

        // Use the function's actual LLVM type (works for both user and runtime fns)
        cg_reinit_types()
        let fn_ty = llvm.global_get_value_type(fn_val)
        let r = llvm.build_call(CG_B, fn_ty, fn_val, arg_arr, args.length, "call")
        llvm.value_array_free(arg_arr)

        r
    }

    fn is_string_var(self, name: string) -> bool {
        let vt = forge_alloca_cache_get_var_type(name)
        vt == "string"
    }

    fn emit_println(self, args: List<Expr>) -> ptr {
        for arg in args {
            // Check if arg is a string literal — pass ForgeString directly
            match arg {
                .StringLit(value, span) -> {
                    let str_val = self.emit_string(value)
                    self.emit_println_str(str_val)
                }
                .Ident(name, span) -> {
                    let val = self.emit_ident(name)
                    if self.is_string_var(name) {
                        self.emit_println_str(val)
                    } else {
                        self.emit_println_int(val)
                    }
                }
                _ -> {
                    let val = self.emit_expr(arg)
                    // Use LLVM value type to detect strings (central, reliable)
                    if forge_value_is_string(val) == 1 {
                        self.emit_println_str(val)
                    } else {
                        self.emit_println_int(val)
                    }
                }
            }
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_println_int(self, val: ptr) {
        // Convert int to string, then print
        let ca = llvm.value_array_new(1)
        llvm.value_array_set(ca, 0, val)
        let ft = mft1(CG_STR, CG_I64)
        let sv = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "ts")
        llvm.value_array_free(ca)
        self.emit_println_str(sv)
    }

    fn emit_println_str(self, str_val: ptr) {
        // Print ForgeString directly
        let pa = llvm.value_array_new(1)
        llvm.value_array_set(pa, 0, str_val)
        let pft = mft1(CG_VOID, CG_STR)
        llvm.build_call(CG_B, pft, CG_RT_PRINTLN, pa, 1, "")
        llvm.value_array_free(pa)
    }

    fn emit_statement(self, stmt: Statement) -> ptr {
        forge_trace_i64(999, 999)
        match stmt {
            .Expr(expr) -> { forge_trace_i64(0, 998)
                return self.emit_expr(expr) }
            .Assign(t, v, s) -> { forge_trace_i64(1, 998)
                self.emit_assign(t, v) }
            .Return(v, s) -> { forge_trace_i64(2, 998)
                self.emit_return(v) }
            .Let(name, val, s) -> {
                let val_type = self.expr_type_name(val)
                // Debug: trace what expr variant the value is
                match val {
                    .Call(c, _, _) -> {
                        match c {
                            .Ident(cn, _) -> { eprintln("  [LET] " + name + " is Call(Ident(" + cn + "))") }
                            .MemberAccess(_, mf, _) -> { eprintln("  [LET] " + name + " is Call(MA(." + mf + "))") }
                            _ -> { eprintln("  [LET] " + name + " is Call(OTHER)") }
                        }
                    }
                    .Ident(n, _) -> { eprintln("  [LET] " + name + " is Ident(" + n + ")") }
                    .MemberAccess(o, f, _) -> { eprintln("  [LET] " + name + " is MemberAccess(." + f + ")") }
                    .Binary(_, _, _, _) -> { eprintln("  [LET] " + name + " is Binary") }
                    .StringLit(_, _) -> { eprintln("  [LET] " + name + " is StringLit") }
                    .IntLit(_, _) -> { eprintln("  [LET] " + name + " is IntLit") }
                    _ -> { eprintln("  [LET] " + name + " is OTHER") }
                }
                eprintln("  [LET] " + name + " type=" + val_type)
                let ev = self.emit_expr(val)
                self.define_var_typed(name, val_type, ev)
            }
                .If(cond, then_body, else_body, has_else, s) -> {
                    cg_reinit_types()
                    let cv = self.emit_expr(cond)
                    let ifn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let tb = llvm.append_basic_block(CG_CTX, ifn, "th")
                    let eb = llvm.append_basic_block(CG_CTX, ifn, "el")
                    let mb = llvm.append_basic_block(CG_CTX, ifn, "mg")
                    forge_build_cond_br_trunc(CG_B, cv, tb, eb)
                    llvm.position_at_end(CG_B, tb)
                    self.emit_block(then_body)
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, mb) }
                    llvm.position_at_end(CG_B, eb)
                    if has_else == 1 { self.emit_block(else_body) }
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, mb) }
                    llvm.position_at_end(CG_B, mb)
                }
                .Match(scrutinee, arm_tags_csv, arm_bindings_csv, arm_bodies, default_body, has_default, s) -> {
                    cg_reinit_types()
                    let subj_raw = self.emit_expr(scrutinee)
                    // Try extracting tag from enum struct
                    mut subj = subj_raw
                    let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
                    if tag_byte != null {
                        subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
                    }
                    let mfn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let merge_bb = llvm.append_basic_block(CG_CTX, mfn, "me")
                    // Parse tag CSV
                    mut tags: List<int> = []
                    mut tpos = 0
                    mut tcur = ""
                    while tpos < arm_tags_csv.length {
                        let ch = arm_tags_csv[tpos]
                        if ch == "," {
                            tags = tags.push(int(tcur))
                            tcur = ""
                        } else {
                            tcur = tcur + ch
                        }
                        tpos = tpos + 1
                    }
                    if tcur != "" { tags = tags.push(int(tcur)) }
                    // Parse arm bindings (semicolon-separated groups, comma-separated names)
                    mut all_bindings: List<string> = []
                    mut bpos = 0
                    mut bcur = ""
                    while bpos < arm_bindings_csv.length {
                        let bch = arm_bindings_csv[bpos]
                        if bch == ";" {
                            all_bindings = all_bindings.push(bcur)
                            bcur = ""
                        } else {
                            bcur = bcur + bch
                        }
                        bpos = bpos + 1
                    }
                    if bcur != "" { all_bindings = all_bindings.push(bcur) }
                    // Emit each arm as if-else chain
                    mut ai = 0
                    while ai < tags.length {
                        cg_reinit_types()
                        let arm_bb = llvm.append_basic_block(CG_CTX, mfn, "ma")
                        let next_bb = llvm.append_basic_block(CG_CTX, mfn, "mn")
                        let tag_val = llvm.const_int(CG_I64, tags[ai], 0)
                        let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
                        forge_build_cond_br_trunc(CG_B, cmp, arm_bb, next_bb)
                        llvm.position_at_end(CG_B, arm_bb)
                        // Extract bindings with field-type-aware slot offsets
                        if ai < all_bindings.length {
                            let raw_bind = all_bindings[ai]
                            // Parse "EnumType.Variant:name1,name2"
                            mut variant_qname = ""
                            mut names_part = raw_bind
                            let colon_pos = raw_bind.index_of(":")
                            if colon_pos >= 0 {
                                variant_qname = raw_bind.substring(0, colon_pos)
                                names_part = raw_bind.substring(colon_pos + 1, raw_bind.length)
                            }
                            // Look up field types (hardcoded for key enums — CSV globals corrupted)
                            mut field_types = ""
                            let dot_pos = variant_qname.index_of(".")
                            if dot_pos > 0 {
                                let ename = variant_qname.substring(0, dot_pos)
                                let vn2 = variant_qname.substring(dot_pos + 1, variant_qname.length)
                                // Try CSV first
                                field_types = cg_enum_variant_field_types(ename, vn2)
                                // Hardcoded fallback for common Expr/Statement variants
                                if field_types == "" {
                                    // Expr variants: most have (value/name: s, span: 4)
                                    if vn2 == "IntLit" { field_types = "i4" }
                                    if vn2 == "FloatLit" { field_types = "i4" }
                                    if vn2 == "StringLit" { field_types = "s4" }
                                    if vn2 == "BoolLit" { field_types = "i4" }
                                    if vn2 == "NullLit" { field_types = "4" }
                                    if vn2 == "Ident" { field_types = "s4" }
                                    // Statement variants
                                    if vn2 == "Expr" { field_types = "p" }
                                    if vn2 == "Assign" { field_types = "pp4" }
                                    if vn2 == "Return" { field_types = "p4" }
                                    if vn2 == "Let" { field_types = "sp4" }
                                }
                            }
                            mut field_idx = 0
                            mut bpi = 0
                            mut bpname = ""
                            while bpi <= names_part.length {
                                mut is_sep = bpi == names_part.length
                                if !is_sep { if names_part[bpi] == "," { is_sep = true } }
                                if is_sep {
                                    if bpname != "_" && bpname != "" {
                                        cg_reinit_types()
                                        let slot_off = cg_enum_field_slot_offset(field_types, field_idx)
                                        let slot = 1 + slot_off
                                        mut fcode = "i"
                                        if field_idx < field_types.length { fcode = field_types[field_idx] }
                                        let slots = field_type_slots(fcode)
                                        if slots >= 2 {
                                            // ForgeString/List: extract 2 slots, build struct
                                            let ev0 = llvm.build_extract_value(CG_B, subj_raw, slot, "b0")
                                            let ev1 = llvm.build_extract_value(CG_B, subj_raw, slot + 1, "b1")
                                            if ev0 != null {
                                                // Convert ev0 (i64) to ptr for ForgeString field 0
                                                let ev0_ptr = llvm.build_inttoptr(CG_B, ev0, CG_PTR, "sp")
                                                let fs = llvm.build_insert_value(CG_B, llvm.get_undef(CG_STR), ev0_ptr, 0, "fs")
                                                mut fsv = fs
                                                if ev1 != null { fsv = llvm.build_insert_value(CG_B, fs, ev1, 1, "fs") }
                                                let ba = llvm.build_alloca(CG_B, CG_STR, bpname)
                                                llvm.build_store(CG_B, fsv, ba)
                                                forge_alloca_cache_set(bpname, ba)
                                            }
                                        } else if fcode == "p" {
                                            // Boxed pointer: extract ptr, load full value
                                            let ev = llvm.build_extract_value(CG_B, subj_raw, slot, "bp")
                                            if ev != null {
                                                cg_reinit_types()
                                                // Dereference: inttoptr → load %Expr
                                                let ptr_val = llvm.build_inttoptr(CG_B, ev, CG_PTR, "dp")
                                                let expr_ty = llvm.get_type_by_name(CG_CTX, "Expr")
                                                mut deref_val = ev
                                                if expr_ty != null && ptr_val != null {
                                                    let loaded = llvm.build_load(CG_B, expr_ty, ptr_val, "de")
                                                    if loaded != null { deref_val = loaded }
                                                }
                                                // Store the dereferenced full value
                                                if expr_ty != null {
                                                    let big_alloca = llvm.build_alloca(CG_B, expr_ty, bpname)
                                                    llvm.build_store(CG_B, deref_val, big_alloca)
                                                    forge_alloca_cache_set(bpname, big_alloca)
                                                } else {
                                                    let ba = llvm.build_alloca(CG_B, CG_I64, bpname)
                                                    llvm.build_store(CG_B, ev, ba)
                                                    forge_alloca_cache_set(bpname, ba)
                                                }
                                            }
                                        } else {
                                            // Single slot (int, bool, etc.)
                                            let ev = llvm.build_extract_value(CG_B, subj_raw, slot, "b")
                                            if ev != null {
                                                let ba = llvm.build_alloca(CG_B, CG_I64, bpname)
                                                llvm.build_store(CG_B, ev, ba)
                                                forge_alloca_cache_set(bpname, ba)
                                            }
                                        }
                                    }
                                    field_idx = field_idx + 1
                                    bpname = ""
                                } else {
                                    bpname = bpname + names_part[bpi]
                                }
                                bpi = bpi + 1
                            }
                            // (Last binding handled by bpi <= names_part.length loop)
                        }
                        if ai < arm_bodies.length {
                            self.emit_block(arm_bodies[ai])
                        }
                        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
                        // Bindings are in alloca cache, scoped to current function
                        llvm.position_at_end(CG_B, next_bb)
                        ai = ai + 1
                    }
                    // Default arm
                    if has_default == 1 {
                        self.emit_block(default_body)
                    }
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
                    llvm.position_at_end(CG_B, merge_bb)
                }
                .While(cond, body, s) -> {
                    let wfn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let w1 = llvm.append_basic_block(CG_CTX, wfn, "wc")
                    let w2 = llvm.append_basic_block(CG_CTX, wfn, "wb")
                    let w3 = llvm.append_basic_block(CG_CTX, wfn, "we")
                    forge_loop_push(w1, w3)
                    llvm.build_br(CG_B, w1)
                    llvm.position_at_end(CG_B, w1)
                    let wv = self.emit_expr(cond)
                    forge_build_cond_br_trunc(CG_B, wv, w2, w3)
                    llvm.position_at_end(CG_B, w2)
                    self.emit_block(body)
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, w1) }
                    llvm.position_at_end(CG_B, w3)
                    forge_loop_pop()
                }
                .For(vn, iter, body, s) -> {
                    // Check if iterable is a known string list BEFORE emitting
                    mut iter_var_name = ""
                    match iter {
                        .Ident(n, _) -> { iter_var_name = n }
                        _ -> {}
                    }
                    // Determine element type BEFORE emitting (no global flag dependency)
                    let iter_ty2 = self.expr_type_name(iter)
                    // Determine element type from list_elem_type lookup
                    mut for_elem_type = ""
                    if iter_var_name != "" { for_elem_type = list_elem_type(iter_var_name) }
                    let fl = self.emit_expr(iter)
                    mut elem_llvm_ty = CG_I64
                    if for_elem_type != "" {
                        cg_reinit_types()
                        let resolved = resolve_type_to_llvm(for_elem_type)
                        if resolved != null { elem_llvm_ty = resolved }
                    }
                    // Use ForgeString elements when iterable type is string/list
                    if (iter_ty2 == "string" || iter_ty2.length > 5) && for_elem_type == "" {
                        if iter_ty2 == "string" {
                            cg_reinit_types()
                            elem_llvm_ty = CG_STR
                        }
                    }
                    let fa = llvm.build_alloca(CG_B, CG_I64, "fi")
                    llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), fa)
                    let fla = llvm.value_array_new(1)
                    llvm.value_array_set(fla, 0, fl)
                    let flt = llvm.type_array_new(1)
                    llvm.type_array_set(flt, 0, CG_STR)
                    let flf = llvm.function_type(CG_I64, flt, 1, 0)
                    llvm.type_array_free(flt)
                    let fln = llvm.build_call(CG_B, flf, CG_RT_SLEN, fla, 1, "ln")
                    llvm.value_array_free(fla)
                    let ffn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let f1 = llvm.append_basic_block(CG_CTX, ffn, "fc")
                    let f2 = llvm.append_basic_block(CG_CTX, ffn, "fb")
                    let f3 = llvm.append_basic_block(CG_CTX, ffn, "fx")
                    let f4 = llvm.append_basic_block(CG_CTX, ffn, "fe")
                    llvm.build_br(CG_B, f1)
                    llvm.position_at_end(CG_B, f1)
                    let fc = llvm.build_load(CG_B, CG_I64, fa, "ci")
                    let fx = llvm.build_icmp(CG_B, 40, fc, fln, "cc")
                    forge_build_cond_br_trunc(CG_B, fx, f2, f4)
                    llvm.position_at_end(CG_B, f2)
                    let fd = llvm.build_extract_value(CG_B, fl, 0, "dp")
                    if fd == null {
                        // List value was not a struct — can't iterate. Skip to end.
                        // Create a dummy var for the loop body to reference
                        let fv = llvm.build_alloca(CG_B, CG_I64, "iv")
                        llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), fv)
                        llvm.build_br(CG_B, f4)
                        llvm.position_at_end(CG_B, f3)
                        llvm.build_br(CG_B, f1)
                    } else {
                        let fb = llvm.build_load(CG_B, CG_I64, fa, "bi")
                        let fg = llvm.value_array_new(1)
                        llvm.value_array_set(fg, 0, fb)
                        let fp = llvm.build_gep2(CG_B, elem_llvm_ty, fd, fg, 1, "ep")
                        llvm.value_array_free(fg)
                        let fe = llvm.build_load(CG_B, elem_llvm_ty, fp, "ev")
                        let fv = llvm.build_alloca(CG_B, elem_llvm_ty, "iv")
                        llvm.build_store(CG_B, fe, fv)
                        // Register loop var type in alloca cache
                        if for_elem_type != "" {
                            forge_alloca_cache_set(vn, fv)
                            forge_alloca_cache_set_var_type(vn, for_elem_type)
                        }
                        self.emit_block(body)
                        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, f3) }
                        llvm.position_at_end(CG_B, f3)
                        let fi = llvm.build_load(CG_B, CG_I64, fa, "ic")
                        let fn2 = llvm.build_add(CG_B, fi, llvm.const_int(CG_I64, 1, 0), "ni")
                        llvm.build_store(CG_B, fn2, fa)
                        llvm.build_br(CG_B, f1)
                    }
                    llvm.position_at_end(CG_B, f4)
                }
                .Break(s) -> { forge_loop_break(CG_B) }
                .Continue(s) -> { forge_loop_continue(CG_B) }
                .Feature(fe) -> { self.dispatch_stmt(fe) }
            }
            llvm.const_int(CG_I64, 0, 0)
        }

    fn emit_block(self, block: Block) -> ptr {
        mut last = llvm.const_int(CG_I64, 0, 0)
        let _stmts = block.statements
        for stmt in _stmts {
            if llvm.block_has_terminator(CG_B) { break }
            last = self.emit_statement(stmt)
        }
        last
    }

    fn write_ir(self, path: string) -> bool {
        llvm.print_module_to_file(CG_MOD, path) == 0
    }

    // ─── Variable Definition ───────────────────

    // Define a local variable: create alloca, store value, register in CG_LOCALS.
    // Type is determined by the alloca — LLVM is the source of truth.
    fn define_var_typed(self, name: string, type_name: string, value: ptr) {
        // Resolve alloca type: prefer LLVM type of the value (source of truth)
        // Falls back to type name resolution if value type is i64
        mut alloca_ty = resolve_type_to_llvm(type_name)
        // If resolved to i64 but value is a struct, use value's actual type
        let val_kind = forge_value_type_kind(value)
        if val_kind == 10 {
            // Value is a struct — use its LLVM type for the alloca
            alloca_ty = llvm.type_of(value)
        }
        if CG_B == null { return }
        let cur_bb = llvm.get_insert_block(CG_B)
        let fn_val = llvm.get_basic_block_parent(cur_bb)
        let entry_bb = llvm.get_entry_basic_block(fn_val)
        let first_instr = llvm.get_first_instruction(entry_bb)
        if first_instr != null {
            llvm.position_before(CG_B, first_instr)
        } else {
            llvm.position_at_end(CG_B, entry_bb)
        }
        let alloca = llvm.build_alloca(CG_B, alloca_ty, name)
        llvm.position_at_end(CG_B, cur_bb)
        llvm.build_store(CG_B, value, alloca)
        forge_alloca_cache_set(name, alloca)
        // Preserve pre-set types (e.g., "List:Statement" from parser annotations)
        let existing = forge_alloca_cache_get_var_type(name)
        if existing.length == 0 {
            forge_alloca_cache_set_var_type(name, type_name)
        }
    }

    // Legacy wrapper — callers should migrate to define_var_typed
    fn define_var(self, name: string, ty: Type, value: ptr) {
        mut tn = "int"
        let is_str = ty is .String
        let is_list = ty is .ListType
        let is_map = ty is .MapType
        if is_str { tn = "string" }
        if is_map { tn = "map" }
        match ty {
            .ListType(elem) -> {
                match elem {
                    .String -> { tn = "list:string" }
                    _ -> { tn = "list" }
                }
            }
            _ -> {}
        }
        self.define_var_typed(name, tn, value)
    }

    fn is_map_var(self, name: string) -> bool {
        let vt = forge_alloca_cache_get_var_type(name)
        vt == "map"
    }

}
