mut CG_RT_SCONCAT: ptr = null
mut CG_RT_SCHARAT: ptr = null
mut CG_RT_SLEN: ptr = null
mut CG_RT_SEQ: ptr = null
mut CG_RT_SSUBSTR: ptr = null
mut CG_RT_SINDEXOF: ptr = null
mut CG_RT_SCMP: ptr = null
mut CG_RT_ALLOC: ptr = null
