fn cg_cleanup() {
    llvm.dispose_builder(CG_B)
    llvm.module_dispose(CG_MOD)
    llvm.context_dispose(CG_CTX)
}

// ─── Helper: coerce argument to match parameter type ────────────
// Mature compilers do this at every call site. Handles:
//   struct (ForgeString) → ptr: extractvalue field 0
//   i64 → struct: zeroinitializer (lossy but prevents crashes)
fn coerce_call_arg(val: ptr, fn_ty: ptr, arg_idx: int) -> ptr {
    if val == null || fn_ty == null { return val }
    let param_ty = llvm.fn_get_param_type(fn_ty, arg_idx)
    if param_ty == null { return val }
    let val_ty = llvm.type_of(val)
    if val_ty == null { return val }
    let val_kind = llvm.get_type_kind(val_ty)
    let param_kind = llvm.get_type_kind(param_ty)
    // Struct value (kind 10) → ptr param (kind 12): extract field 0 (the pointer)
    if val_kind == 10 && param_kind == 12 {
        return llvm.build_extract_value(CG_B, val, 0, "sp")
    }
    // i64 (kind 8) → struct param (kind 10): use zeroinitializer
    if val_kind == 8 && param_kind == 10 {
        return llvm.const_null(param_ty)
    }
    // Struct value → i64 param: extract first field and cast if needed
    if val_kind == 10 && param_kind == 8 {
        let f0 = llvm.build_extract_value(CG_B, val, 0, "s0")
        if f0 != null { return f0 }
    }
    // ptr (kind 12) → i64 param (kind 8): ptrtoint
    if val_kind == 12 && param_kind == 8 {
        return llvm.build_ptr_to_int(CG_B, val, CG_I64, "pi")
    }
    // i64 (kind 8) → ptr param (kind 12): inttoptr
    if val_kind == 8 && param_kind == 12 {
        return llvm.build_int_to_ptr(CG_B, val, CG_PTR, "ip")
    }
    val
}

// ─── Checked build_call: validates and coerces ALL arguments ────────────
// This is the single entry point for emitting function calls.
// Replaces scattered coerce_call_arg usage with centralized type validation.
// Handles: struct→ptr (extractvalue 0), i64→struct (zeroinitializer),
//          struct→i64 (extractvalue 0), ptr load for self-by-ptr, null guards.
fn checked_build_call(fn_val: ptr, arg_values: ptr, arg_count: int, name: string) -> ptr {
    if fn_val == null { return llvm.const_int(CG_I64, 0, 0) }
    // Store args in C-side global — the mini corrupts local arg_values pointer.
    forge_cbc_set_builder(CG_B, CG_CTX)
    forge_cbc_set_args(arg_values, arg_count)
    forge_checked_build_call_c(fn_val, arg_values, arg_count)
}

// ─── Checked build_store: validates value type matches alloca type ────────────
fn checked_build_store(val: ptr, ptr_val: ptr) -> ptr {
    if val == null || ptr_val == null { return null }
    // Get the alloca's element type
    let alloca_ty = llvm.get_allocated_type(ptr_val)
    if alloca_ty == null { return llvm.build_store(CG_B, val, ptr_val) }
    let val_ty = llvm.type_of(val)
    if val_ty == null { return llvm.build_store(CG_B, val, ptr_val) }
    let val_kind = llvm.get_type_kind(val_ty)
    let alloca_kind = llvm.get_type_kind(alloca_ty)
    // Types match → store directly
    if val_ty == alloca_ty { return llvm.build_store(CG_B, val, ptr_val) }
    // Same kind → store (might differ in name but same layout)
    if val_kind == alloca_kind { return llvm.build_store(CG_B, val, ptr_val) }
    // Struct value (kind 10) into ptr alloca (kind 12): extract field 0
    if val_kind == 10 && alloca_kind == 12 {
        let extracted = llvm.build_extract_value(CG_B, val, 0, "cs0")
        return llvm.build_store(CG_B, extracted, ptr_val)
    }
    // ptr value (kind 12) into struct alloca (kind 10): store zeroinitializer
    if val_kind == 12 && alloca_kind == 10 {
        return llvm.build_store(CG_B, llvm.const_null(alloca_ty), ptr_val)
    }
    // i64 (kind 8) into struct alloca (kind 10): store zeroinitializer
    if val_kind == 8 && alloca_kind == 10 {
        return llvm.build_store(CG_B, llvm.const_null(alloca_ty), ptr_val)
    }
    // Struct (kind 10) into i64 alloca (kind 8): extract first field
    if val_kind == 10 && alloca_kind == 8 {
        let f0 = llvm.build_extract_value(CG_B, val, 0, "cs1")
        if f0 != null { return llvm.build_store(CG_B, f0, ptr_val) }
    }
    // Fallback: store anyway (LLVM may reject but at least it's visible)
    llvm.build_store(CG_B, val, ptr_val)
}

// ─── Checked build_insertvalue: validates field type ────────────
fn checked_build_insertvalue(agg: ptr, val: ptr, idx: int, name: string) -> ptr {
    if agg == null || val == null { return agg }
    // Get the aggregate's type and the expected field type
    let agg_ty = llvm.type_of(agg)
    if agg_ty == null { return llvm.build_insert_value(CG_B, agg, val, idx, name) }
    let agg_kind = llvm.get_type_kind(agg_ty)
    if agg_kind != 10 { return llvm.build_insert_value(CG_B, agg, val, idx, name) }
    let field_ty = llvm.struct_get_type_at_index(agg_ty, idx)
    if field_ty == null { return llvm.build_insert_value(CG_B, agg, val, idx, name) }
    let val_ty = llvm.type_of(val)
    // Types match → insert directly
    if val_ty == field_ty { return llvm.build_insert_value(CG_B, agg, val, idx, name) }
    let val_kind = llvm.get_type_kind(val_ty)
    let field_kind = llvm.get_type_kind(field_ty)
    if val_kind == field_kind { return llvm.build_insert_value(CG_B, agg, val, idx, name) }
    // Coerce: struct→ptr (extract field 0)
    if val_kind == 10 && field_kind == 12 {
        let coerced = llvm.build_extract_value(CG_B, val, 0, "ci0")
        return llvm.build_insert_value(CG_B, agg, coerced, idx, name)
    }
    // Coerce: wrong struct type → use zeroinitializer of expected type
    if val_kind == 10 && field_kind == 10 && val_ty != field_ty {
        return llvm.build_insert_value(CG_B, agg, llvm.const_null(field_ty), idx, name)
    }
    // Coerce: i64 into struct field → zeroinitializer
    if val_kind == 8 && field_kind == 10 {
        return llvm.build_insert_value(CG_B, agg, llvm.const_null(field_ty), idx, name)
    }
    // Coerce: ptr into i64 field → ptrtoint
    if val_kind == 12 && field_kind == 8 {
        return llvm.build_insert_value(CG_B, agg, llvm.const_int(CG_I64, 0, 0), idx, name)
    }
    llvm.build_insert_value(CG_B, agg, val, idx, name)
}

// ─── Helper: call runtime with 1 arg ────────────
fn call_rt_1(fn_val: ptr, arg_ty: ptr, ret_ty: ptr, arg: ptr, name: string) -> ptr {
    let ca = llvm.value_array_new(1)
    llvm.value_array_set(ca, 0, arg)
    let r = checked_build_call(fn_val, ca, 1, name)
    llvm.value_array_free(ca)
    r
}

// ─── Helper: call runtime with 2 string args ────
fn call_rt_2_ss(fn_val: ptr, a: ptr, b: ptr, ret_ty: ptr, name: string) -> ptr {
    let ca = llvm.value_array_new(2)
    llvm.value_array_set(ca, 0, a)
    llvm.value_array_set(ca, 1, b)
    let r = checked_build_call(fn_val, ca, 2, name)
    llvm.value_array_free(ca)
    r
}

impl Codegen {
    fn init(self, name: string) { codegen_init(name) }
    fn verify(self) -> bool { llvm.verify_module(CG_MOD) == 0 }
    fn dispose(self) { codegen_cleanup() }
    // ─── Program ───────────────────────────────

    fn emit_program(self, program: Program) {
        emit_all_fn_bodies(self)
    }

    fn emit_main_fn(self, body: Block) {
        let params = llvm.type_array_new(0)
        let mt = llvm.function_type(CG_I32, params, 0, 0)
        llvm.type_array_free(params)
        let mf = llvm.add_function(CG_MOD, "main", mt)
        self.current_fn = mf
        let entry = llvm.append_basic_block(CG_CTX, mf, "en")
        llvm.position_at_end(CG_B, entry)
        self.emit_block(body)
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    }

    // ─── Expressions (all return TypedValue) ────────────────

    fn emit_expr(self, expr: Expr) -> TypedValue {
        match expr {
            .IntLit(value, span) -> {
                let iv = llvm.const_int(CG_I64, value, 0)
                forge_set_last_emit_result(iv)
                return tv_int(iv)
            }
            .FloatLit(value, span) -> {
                let fv = llvm.const_real(CG_F64, value)
                return tv_typed(fv, CG_F64, "float")
            }
            .StringLit(value, span) -> {
                let sv = self.emit_string(value)
                forge_set_last_emit_result(sv)
                return tv_str(sv)
            }
            .BoolLit(value, span) -> {
                mut bv = llvm.const_int(CG_I64, 0, 0)
                if value { bv = llvm.const_int(CG_I64, 1, 0) }
                forge_set_last_emit_result(bv)
                return tv_bool(bv)
            }
            .NullLit(span) -> {
                if CG_FN_RETURNS_NULLABLE == 1 {
                    return tv_typed(make_null_value(CG_FN_NULLABLE_INNER_TY), CG_PTR, "ptr?")
                }
                return tv_ptr(llvm.const_null(CG_PTR))
            }
            .Ident(name, span) -> { return self.emit_ident(name) }
            .Binary(left, op, right, span) -> { return self.emit_binary(left, op, right) }
            .IsCheck(subject, variant, negated, span) -> {
                let obj_tv = self.emit_expr(subject)
                let tag = match_enum_tag(variant)
                let tag_val = llvm.const_int(CG_I64, tag, 0)
                mut cmp_lhs = obj_tv.val
                // If it's an enum, extract the tag field
                // Check if subject is an enum by trying extractvalue
                if tv_is_struct(obj_tv) {
                    let etag = llvm.build_extract_value(CG_B, obj_tv.val, 0, "it")
                    if etag != null {
                        cmp_lhs = llvm.build_zext(CG_B, etag, llvm.int64_type(CG_CTX), "ite")
                    }
                }
                mut pred = 32
                if negated == 1 { pred = 33 }
                let cmp = llvm.build_icmp(CG_B, pred, cmp_lhs, tag_val, "ic")
                let ext = llvm.build_zext(CG_B, cmp, llvm.int64_type(CG_CTX), "ie")
                return tv_bool(ext)
            }
            .Unary(op, operand, span) -> {
                let inner = self.emit_expr(operand)
                match op {
                    .Neg -> { return tv_int(llvm.build_sub(CG_B, llvm.const_int(CG_I64, 0, 0), inner.val, "neg")) }
                    .Not -> {
                        let cmp = llvm.build_icmp(CG_B, 32, inner.val, llvm.const_int(CG_I64, 0, 0), "not")
                        return tv_bool(llvm.build_zext(CG_B, cmp, llvm.int64_type(CG_CTX), "nx"))
                    }
                    .BitNot -> { return tv_int(llvm.build_xor(CG_B, inner.val, llvm.const_int(CG_I64, -1, 1), "bn")) }
                }
            }
            .Call(callee, args, span) -> { return self.emit_call(callee, args) }
            .MemberAccess(obj, field, span) -> { return self.emit_member_access(obj, field) }
            .Index(obj, idx, span) -> { return self.emit_index(obj, idx) }
            .Block(block) -> {
                // Empty block = [] list literal
                if block.statements.length == 0 {
                    return tv_typed(llvm.const_null(CG_STR), CG_LIST, "List<int>")
                }
                // Non-empty block = [a, b, c] list literal
                let count = block.statements.length
                cg_reinit_types()
                let elem_size = llvm.size_of(CG_I64)
                let total_size = llvm.build_mul(CG_B, llvm.const_int(CG_I64, count, 0), elem_size, "lsz")
                let data_ptr = call_rt_1(CG_RT_ALLOC, CG_I64, CG_PTR, total_size, "ld")
                mut li = 0
                let _stmts = block.statements
                for stmt in _stmts {
                    match stmt {
                        .Expr(expr) -> {
                            let elem_tv = self.emit_expr(expr)
                            let gi = llvm.value_array_new(1)
                            llvm.value_array_set(gi, 0, llvm.const_int(CG_I64, li, 0))
                            let ep = llvm.build_gep2(CG_B, CG_I64, data_ptr, gi, 1, "le")
                            llvm.value_array_free(gi)
                            llvm.build_store(CG_B, elem_tv.val, ep)
                        }
                        _ -> {}
                    }
                    li = li + 1
                }
                cg_reinit_types()
                let undef = llvm.get_undef(CG_STR)
                let s1 = llvm.build_insert_value(CG_B, undef, data_ptr, 0, "ll1")
                let s2 = llvm.build_insert_value(CG_B, s1, llvm.const_int(CG_I64, count, 0), 1, "ll2")
                return tv_typed(s2, CG_LIST, "List<int>")
            }
            .Feature(fe) -> {
                return self.dispatch_expr(fe)
            }
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    fn emit_string(self, value: string) -> ptr {
        llvm.const_string(CG_MOD, value, value.length)
    }

    // ─── Identifier loading ─────────────────────
    fn emit_ident(self, name: string) -> TypedValue {
        if name == "EMPTYLIST" {
            return tv_typed(llvm.const_null(CG_STR), CG_LIST, "List<int>")
        }
        // PRIMARY: C-side alloca cache (set by define_var)
        let cached_ptr = forge_alloca_cache_get(name)
        if cached_ptr != null {
            cg_reinit_types()
            mut load_ty = CG_I64
            mut type_name = "int"
            // Use forge_var_type_get (string-based C-side lookup) for type resolution.
            // This is immune to mini's pointer corruption — both get_allocated_type(cached_ptr)
            // and forge_alloca_cache_get_type(name) return corrupted pointers (always kind=10).
            // Only use annotations for primitive types (string, ptr, float).
            // Struct types stay as i64 because values are still stored as i64 by emit_expr.
            forge_trace_ei_type(name)
            let vt = forge_var_type_get(name)
            if vt == "string" {
                load_ty = CG_STR
                type_name = "string"
            } else if vt == "ptr" {
                load_ty = CG_PTR
                type_name = "ptr"
            } else if vt == "float" {
                load_ty = CG_F64
                type_name = "float"
            }
            // Fallback: C-side caches (for variables without var_type entries)
            if load_ty == CG_I64 {
                if forge_str_var_check(name) == 1 {
                    cg_reinit_types()
                    load_ty = CG_STR
                    type_name = "string"
                } else if forge_ptr_var_check(name) == 1 {
                    load_ty = CG_PTR
                    type_name = "ptr"
                }
            }
            let loaded = llvm.build_load(CG_B, load_ty, cached_ptr, name)
            forge_set_last_emit_result(loaded)
            return tv_typed(loaded, load_ty, type_name)
        }
        // FALLBACK: search CG_VAR_NAMES
        mut vi = CG_VAR_NAMES.length - 1
        while vi >= 0 {
            if CG_VAR_NAMES[vi] == name {
                let var_ptr = CG_VAR_PTRS[vi]
                if var_ptr == null { return tv_int(llvm.const_int(CG_I64, 0, 0)) }
                // Use alloca type for load
                mut load_ty = CG_I64
                mut type_name = "int"
                let alloca_ty = llvm.get_allocated_type(var_ptr)
                if alloca_ty != null {
                    let ak = llvm.get_type_kind(alloca_ty)
                    if ak == 12 { load_ty = CG_PTR
                        type_name = "ptr" }
                    if ak == 10 {
                        if alloca_ty == CG_STR { load_ty = CG_STR
                            type_name = "string"
                        } else {
                            load_ty = alloca_ty
                            let sn = forge_struct_var_get(name)
                            if sn != "" { type_name = sn }
                        }
                    }
                }
                let loaded = llvm.build_load(CG_B, load_ty, var_ptr, name)
                return tv_typed(loaded, load_ty, type_name)
            }
            vi = vi - 1
        }
        // Function-as-value: if no variable found, try getting the function pointer
        let fn_ptr = llvm.get_named_function(CG_MOD, name)
        if fn_ptr != null {
            return tv_ptr(fn_ptr)
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    // ─── Binary operations ──────────────────────
    fn emit_binary(self, left: Expr, op: BinOp, right: Expr) -> TypedValue {
        // Handle && and || with i1 conversion
        match op {
            .And -> {
                let lv = self.emit_expr(left)
                let rv = self.emit_expr(right)
                let lv1 = llvm.build_icmp(CG_B, 33, lv.val, llvm.const_int(CG_I64, 0, 0), "ab")
                let rv1 = llvm.build_icmp(CG_B, 33, rv.val, llvm.const_int(CG_I64, 0, 0), "ac")
                return tv_bool(llvm.build_and(CG_B, lv1, rv1, "aa"))
            }
            .Or -> {
                let lv = self.emit_expr(left)
                let rv = self.emit_expr(right)
                let lv2 = llvm.build_icmp(CG_B, 33, lv.val, llvm.const_int(CG_I64, 0, 0), "ob")
                let rv2 = llvm.build_icmp(CG_B, 33, rv.val, llvm.const_int(CG_I64, 0, 0), "oc")
                return tv_bool(llvm.build_or(CG_B, lv2, rv2, "oo"))
            }
            _ -> {}
        }
        let lhs_tv = self.emit_expr(left)
        let rhs_tv = self.emit_expr(right)
        let lhs = lhs_tv.val
        let rhs = rhs_tv.val
        let lhs_is_str = tv_is_str(lhs_tv)
        let rhs_is_str = tv_is_str(rhs_tv)
        match op {
            .Add -> {
                if lhs_is_str && rhs_is_str {
                    return tv_str(self.emit_string_concat(lhs, rhs))
                }
                return tv_int(llvm.build_add(CG_B, lhs, rhs, "add"))
            }
            .Sub -> { return tv_int(llvm.build_sub(CG_B, lhs, rhs, "sub")) }
            .Mul -> { return tv_int(llvm.build_mul(CG_B, lhs, rhs, "mul")) }
            .Div -> { return tv_int(llvm.build_sdiv(CG_B, lhs, rhs, "div")) }
            .Mod -> { return tv_int(llvm.build_srem(CG_B, lhs, rhs, "mod")) }
            .Eq -> {
                if lhs_is_str {
                    if rhs_is_str {
                        let cmp_r = call_rt_2_ss(CG_RT_SCMP, lhs, rhs, CG_I64, "sc")
                        return tv_bool(llvm.build_icmp(CG_B, 32, cmp_r, llvm.const_int(CG_I64, 0, 0), "eq"))
                    }
                }
                return tv_bool(llvm.build_icmp(CG_B, 32, lhs, rhs, "eq"))
            }
            .NotEq -> {
                if lhs_is_str {
                    if rhs_is_str {
                        let cmp_r = call_rt_2_ss(CG_RT_SCMP, lhs, rhs, CG_I64, "sc")
                        return tv_bool(llvm.build_icmp(CG_B, 33, cmp_r, llvm.const_int(CG_I64, 0, 0), "ne"))
                    }
                }
                return tv_bool(llvm.build_icmp(CG_B, 33, lhs, rhs, "ne"))
            }
            .Lt -> { return tv_bool(llvm.build_icmp(CG_B, 40, lhs, rhs, "lt")) }
            .LtEq -> { return tv_bool(llvm.build_icmp(CG_B, 41, lhs, rhs, "le")) }
            .Gt -> { return tv_bool(llvm.build_icmp(CG_B, 38, lhs, rhs, "gt")) }
            .GtEq -> { return tv_bool(llvm.build_icmp(CG_B, 39, lhs, rhs, "ge")) }
            .BitAnd -> { return tv_int(llvm.build_and(CG_B, lhs, rhs, "ba")) }
            .BitOr -> { return tv_int(llvm.build_or(CG_B, lhs, rhs, "bo")) }
            .BitXor -> { return tv_int(llvm.build_xor(CG_B, lhs, rhs, "bx")) }
            .Shl -> { return tv_int(llvm.build_shl(CG_B, lhs, rhs, "sl")) }
            .Shr -> { return tv_int(llvm.build_ashr(CG_B, lhs, rhs, "sr")) }
            .And -> { return tv_bool(llvm.build_and(CG_B, lhs, rhs, "and")) }
            .Or -> { return tv_bool(llvm.build_or(CG_B, lhs, rhs, "or")) }
            .Pipe -> { return rhs_tv }
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    fn emit_string_concat(self, lhs: ptr, rhs: ptr) -> ptr {
        let ca = llvm.value_array_new(2)
        llvm.value_array_set(ca, 0, lhs)
        llvm.value_array_set(ca, 1, rhs)
        let r = checked_build_call(CG_RT_SCONCAT, ca, 2, "cc")
        llvm.value_array_free(ca)
        r
    }

    // ─── Function calls ─────────────────────────
    fn emit_call(self, callee: Expr, args: List<Expr>) -> TypedValue {
        let ctag = forge_enum_tag(callee)
        match callee {
            .Ident(name, span) -> {
                if name == "println" || name == "print" || name == "eprintln" || name == "eprint" {
                    self.emit_println(args)
                    return tv_void()
                }
                // Struct literal: __s_TypeName(field1, field2, ...)
                if name.length > 4 && name[0] == "_" && name[1] == "_" && name[2] == "s" && name[3] == "_" {
                    let sn = name.substring(4, name.length)
                    return self.emit_struct_literal(sn, args)
                }
                // Match expression: __m_pat1,pat2,...
                if name.length > 4 && name[0] == "_" && name[1] == "_" && name[2] == "m" && name[3] == "_" {
                    let patterns = name.substring(4, name.length)
                    return self.emit_match_call(patterns, args)
                }
                // Cast: string(x)
                if name == "string" && args.length > 0 {
                    let val = self.emit_expr(args[0])
                    let r = call_rt_1(CG_RT_I2S, CG_I64, CG_STR, val.val, "i2s")
                    return tv_str(r)
                }
                // Cast: int(x)
                if name == "int" && args.length > 0 {
                    let int_tv = self.emit_expr(args[0])
                    if tv_is_str(int_tv) {
                        let s2i_fn = llvm.get_named_function(CG_MOD, "forge_string_to_int")
                        if s2i_fn != null {
                            let r = call_rt_1(s2i_fn, CG_STR, CG_I64, int_tv.val, "s2i")
                            return tv_int(r)
                        }
                    }
                    return tv_int(int_tv.val)
                }
                if name == "float" || name == "bool" {
                    if args.length > 0 { return self.emit_expr(args[0]) }
                }
                // Regular function call
                let fn_ref = llvm.get_named_function(CG_MOD, name)
                if fn_ref != null {
                    return self.emit_fn_call_direct(fn_ref, name, args)
                }
                eprintln("WARN: unresolved fn: " + name)
            }
            .MemberAccess(o, f, s) -> {
                // Namespace.method or obj.method
                mut ns = ""
                match o {
                    .Ident(n, _) -> { ns = n }
                    _ -> {}
                }
                if ns != "" {
                    return self.emit_method_or_ns_call(ns, f, args)
                }
            }
            _ -> {}
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    fn emit_method_or_ns_call(self, ns: string, method: string, args: List<Expr>) -> TypedValue {
        // Try direct: ns_method
        let direct_name = ns + "_" + method
        let fn_ref = llvm.get_named_function(CG_MOD, direct_name)
        if fn_ref != null { return self.emit_fn_call_direct(fn_ref, direct_name, args) }
        // Try forge_ prefix
        let prefixed = "forge_" + ns + "_" + method
        let fn_ref2 = llvm.get_named_function(CG_MOD, prefixed)
        if fn_ref2 != null { return self.emit_fn_call_direct(fn_ref2, prefixed, args) }
        // Try forge_selfhost_ prefix
        let selfhost = "forge_selfhost_" + ns + "_" + method
        let fn_ref_sh = llvm.get_named_function(CG_MOD, selfhost)
        if fn_ref_sh != null {
            // For selfhost functions, check if return type is ForgeString
            let result = self.emit_fn_call_direct(fn_ref_sh, selfhost, args)
            return result
        }
        // Try impl method: Type_method (single underscore) or Type__method (double)
        mut method_ns = ns
        mut vst = var_struct_type(ns)
        // Fallback: for "self", use C-side self type (set by emit_fn_body_from_source)
        if vst == "" && ns == "self" { vst = forge_get_self_type() }
        if vst != "" { method_ns = vst }
        // Try both naming conventions
        let method_name_1 = method_ns + "_" + method
        let method_name_2 = method_ns + "__" + method
        mut method_name = method_name_2
        mut fn_ref3 = llvm.get_named_function(CG_MOD, method_name_2)
        if fn_ref3 == null {
            fn_ref3 = llvm.get_named_function(CG_MOD, method_name_1)
            method_name = method_name_1
        }
        if fn_ref3 != null {
            // Build call manually: self from alloca cache, args from emit_expr.
            // Use forge_get_last_emit_result for values (immune to stack corruption).
            // Don't build intermediate List<Expr> (Forge list push corruption).
            let self_ptr = forge_alloca_cache_get(ns)
            if self_ptr == null { return tv_int(llvm.const_int(CG_I64, 0, 0)) }
            let total_args = args.length + 1
            let arg_arr = llvm.value_array_new(total_args)
            // Store in C-side global immediately
            forge_cbc_set_args(arg_arr, total_args)
            llvm.value_array_set(arg_arr, 0, self_ptr)
            // Process args using INDEX access (not for loop — avoids list iteration issues)
            mut argi = 0
            while argi < args.length {
                let arg_expr = args[argi]
                self.emit_expr(arg_expr)
                let aval = forge_get_last_emit_result()
                if aval != null {
                    llvm.value_array_set(arg_arr, argi + 1, aval)
                } else {
                    llvm.value_array_set(arg_arr, argi + 1, llvm.const_int(CG_I64, 0, 0))
                }
                argi = argi + 1
            }
            let result = checked_build_call(fn_ref3, arg_arr, total_args, "mc")
            llvm.value_array_free(arg_arr)
            // Determine return type from registry (try both naming conventions)
            mut rtn = forge_fn_reg_get_ret(method_name)
            if rtn.length == 0 {
                rtn = forge_fn_reg_get_ret(method_name_1)
            }
            return self.tv_from_return_type(result, rtn)
        }
        // String methods
        if method == "index_of" && args.length >= 1 {
            let obj_tv = self.emit_ident(ns)
            let sub_tv = self.emit_expr(args[0])
            return tv_int(call_rt_2_ss(CG_RT_SINDEXOF, obj_tv.val, sub_tv.val, CG_I64, "io"))
        }
        if method == "substring" && args.length >= 2 {
            let obj_tv = self.emit_ident(ns)
            let start_tv = self.emit_expr(args[0])
            let end_tv = self.emit_expr(args[1])
            cg_reinit_types()
            let sa = llvm.value_array_new(3)
            llvm.value_array_set(sa, 0, obj_tv.val)
            llvm.value_array_set(sa, 1, start_tv.val)
            llvm.value_array_set(sa, 2, end_tv.val)
            let r = checked_build_call(CG_RT_SSUBSTR, sa, 3, "ss")
            llvm.value_array_free(sa)
            return tv_str(r)
        }
        if method == "length" && args.length == 0 {
            let obj_tv = self.emit_ident(ns)
            if tv_is_str(obj_tv) {
                return tv_int(call_rt_1(CG_RT_SLEN, CG_STR, CG_I64, obj_tv.val, "sl"))
            }
            // List length: extractvalue field 1
            let len = llvm.build_extract_value(CG_B, obj_tv.val, 1, "ll")
            return tv_int(len)
        }
        if method == "push" && args.length >= 1 {
            let obj_tv = self.emit_ident(ns)
            let item_tv = self.emit_expr(args[0])
            // List push via runtime
            let push_fn = llvm.get_named_function(CG_MOD, "forge_list_push")
            if push_fn != null {
                // forge_list_push takes a POINTER to the element, not the value.
                // Alloca temp, store the item, pass the alloca pointer.
                mut item_ptr = item_tv.val
                mut elem_size = 8
                if item_tv.val != null {
                    let item_ty = llvm.type_of(item_tv.val)
                    let item_kind = llvm.get_type_kind(item_ty)
                    if item_kind == 10 {
                        // Struct value → store in temp alloca, pass pointer
                        let tmp = llvm.build_alloca(CG_B, item_ty, "lpt")
                        llvm.build_store(CG_B, item_tv.val, tmp)
                        item_ptr = tmp
                        // Compute struct size from LLVM data layout
                        let sz = llvm.store_size_of_type(CG_MOD, item_ty)
                        if sz > 0 { elem_size = sz }
                    }
                }
                let pa = llvm.value_array_new(3)
                llvm.value_array_set(pa, 0, obj_tv.val)
                llvm.value_array_set(pa, 1, item_ptr)
                llvm.value_array_set(pa, 2, llvm.const_int(CG_I64, elem_size, 0))
                let r = checked_build_call(push_fn, pa, 3, "lp")
                llvm.value_array_free(pa)
                return tv_typed(r, CG_LIST, obj_tv.type_name)
            }
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    // Determine TypedValue from a function's return type name
    fn tv_from_return_type(self, val: ptr, rtn: string) -> TypedValue {
        if rtn == "int" || rtn == "bool" { return tv_int(val) }
        // If no registry entry, use LLVM type of the value
        if rtn == "" && val != null {
            let vty = llvm.type_of(val)
            if vty != null {
                let vk = llvm.get_type_kind(vty)
                if vk == 12 { return tv_ptr(val) }
                if vk == 10 {
                    cg_reinit_types()
                    if vty == CG_STR { return tv_str(val) }
                    // Named struct — look up the name from the registry
                    let name_len = forge_struct_reg_name_for_type_i64(vty)
                    if name_len > 0 {
                        let sname = forge_struct_reg_last_name()
                        return tv_typed(val, vty, sname)
                    }
                    // Fallback: treat as ForgeString (2-field structs like lists)
                    return tv_str(val)
                }
            }
            return tv_int(val)
        }
        if rtn == "" { return tv_int(val) }
        if rtn == "string" { return tv_str(val) }
        if rtn == "ptr" { return tv_ptr(val) }
        if rtn == "void" { return tv_void() }
        if rtn == "float" { return tv_typed(val, CG_F64, "float") }
        // Nullable (ends with ?)
        if rtn.length > 1 && rtn[rtn.length - 1] == "?" {
            return tv_typed(val, CG_PTR, rtn)
        }
        // List
        if rtn.length >= 4 && rtn.substring(0, 4) == "List" {
            return tv_typed(val, CG_LIST, rtn)
        }
        // Struct or enum
        let resolved = resolve_type_to_llvm(rtn)
        if resolved != null { return tv_typed(val, resolved, rtn) }
        tv_typed(val, CG_PTR, rtn)
    }

    fn emit_fn_call_direct(self, fn_val: ptr, fn_name: string, args: List<Expr>) -> TypedValue {
        let ft = llvm.global_get_value_type(fn_val)
        let arg_arr = llvm.value_array_new(args.length)
        if fn_name == "forge_string_byte_at" {
            eprintln("  [EFCD] " + fn_name + " args.len=" + string(args.length) + " fn_val_null=" + string(fn_val == null) + " ft_null=" + string(ft == null))
        }
        // Detect desugared method calls: Type__method(self, args...)
        // For self (arg 0), pass the ALLOCA POINTER, not the loaded value.
        mut self_by_ptr = false
        if fn_name.index_of("__") > 0 && ft != null {
            let p0_ty = llvm.fn_get_param_type(ft, 0)
            if p0_ty != null {
                if llvm.get_type_kind(p0_ty) == 12 { self_by_ptr = true }
            }
        }
        mut i = 0
        if fn_name == "forge_string_byte_at" { eprintln("  [EFCD] before for loop, args.length=" + string(args.length)) }
        for arg in args {
            if fn_name == "forge_string_byte_at" { eprintln("  [EFCD] loop iter i=" + string(i)) }
            if self_by_ptr && i == 0 {
                match arg {
                    .Ident(var_name, _) -> {
                        let alloca_ptr = forge_alloca_cache_get(var_name)
                        if alloca_ptr != null {
                            let alloca_ty = llvm.get_allocated_type(alloca_ptr)
                            if alloca_ty != null && llvm.get_type_kind(alloca_ty) == 12 {
                                // ptr alloca (parameter) → load the ptr value
                                llvm.value_array_set(arg_arr, 0, llvm.build_load(CG_B, CG_PTR, alloca_ptr, "sp"))
                            } else {
                                // struct alloca → pass address directly
                                llvm.value_array_set(arg_arr, 0, alloca_ptr)
                            }
                            i = i + 1
                            continue
                        }
                    }
                    _ -> {}
                }
            }
            self.emit_expr(arg)
            // Use forge_get_last_emit_result — the TypedValue.val field gets
            // corrupted by the mini's struct return handling across function calls.
            // emit_ident/emit_call/etc all call forge_set_last_emit_result before returning.
            mut aval = forge_get_last_emit_result()
            if aval == null { aval = llvm.const_int(CG_I64, 0, 0) }
            llvm.value_array_set(arg_arr, i, aval)
            i = i + 1
        }
        // Centralized type checking + coercion for ALL arguments
        if fn_name == "forge_string_byte_at" { eprintln("  [EFCD] calling checked_build_call, i=" + string(i) + " args.length=" + string(args.length)) }
        let r = checked_build_call(fn_val, arg_arr, args.length, "call")
        llvm.value_array_free(arg_arr)
        forge_set_last_emit_result(r)
        let rtn = forge_fn_reg_get_ret(fn_name)
        self.tv_from_return_type(r, rtn)
    }

    // ─── Member access ──────────────────────────
    fn emit_member_access(self, obj: Expr, field: string) -> TypedValue {
        mut var_name = ""
        match obj {
            .Ident(name, span) -> { var_name = name }
            _ -> {}
        }
        // Try enum variant construction: EnumType.Variant
        if var_name != "" {
            let tag = match_enum_tag(var_name + "." + field)
            if tag >= 0 {
                // This is an enum variant — check if it has data fields
                let emf = cg_enum_max_fields(var_name)
                if emf > 0 {
                    // Data-carrying enum: { i64 tag, ptr payload }
                    let ety = cg_get_enum_ty_for(var_name)
                    if ety != null {
                        let undef = llvm.get_undef(ety)
                        let s1 = llvm.build_insert_value(CG_B, undef, llvm.const_int(CG_I64, tag, 0), 0, "et")
                        let s2 = llvm.build_insert_value(CG_B, s1, llvm.const_null(CG_PTR), 1, "ep")
                        return tv_typed(s2, ety, var_name)
                    }
                }
                // Unit-only enum: just the tag as i64 (no struct wrapping)
                // But if a struct type exists, use it
                let ety2 = cg_make_enum_type(var_name)
                if ety2 != null {
                    let undef = llvm.get_undef(ety2)
                    let s1 = llvm.build_insert_value(CG_B, undef, llvm.const_int(CG_I64, tag, 0), 0, "et")
                    let s2 = llvm.build_insert_value(CG_B, s1, llvm.const_null(CG_PTR), 1, "ep")
                    return tv_typed(s2, ety2, var_name)
                }
                // Fallback for unit-only enums: just the tag
                return tv_int(llvm.const_int(CG_I64, tag, 0))
            }
        }
        // Try struct field access
        if var_name != "" {
            let stype = var_struct_type(var_name)
            if stype != "" {
                let fi = struct_field_index(stype, field)
                if fi >= 0 {
                    let obj_tv = self.emit_ident(var_name)
                    // If obj is a ptr (self param), load the struct through the ptr
                    mut struct_val = obj_tv.val
                    if tv_is_ptr(obj_tv) {
                        let sty = resolve_type_to_llvm(stype)
                        if sty != null {
                            struct_val = llvm.build_load(CG_B, sty, obj_tv.val, "sl")
                        }
                    }
                    let fv = llvm.build_extract_value(CG_B, struct_val, fi, "sf")
                    // Determine field type from struct registry
                    mut ftype_name = "int"
                    mut si = 0
                    while si < CG_STRUCT_NAMES.length {
                        if CG_STRUCT_NAMES[si] == stype {
                            let ftnames = CG_STRUCT_FIELD_TYPE_NAMES[si]
                            // Parse comma-separated field type names to get field at index fi
                            mut fidx = 0
                            mut fstart = 0
                            mut fpos = 0
                            while fpos <= ftnames.length {
                                mut is_sep = false
                                if fpos == ftnames.length { is_sep = true }
                                if !is_sep {
                                    if ftnames[fpos] == "," { is_sep = true }
                                }
                                if is_sep {
                                    if fidx == fi {
                                        ftype_name = ftnames.substring(fstart, fpos)
                                    }
                                    fidx = fidx + 1
                                    fstart = fpos + 1
                                }
                                fpos = fpos + 1
                            }
                            break
                        }
                        si = si + 1
                    }
                    let fty = resolve_type_name_to_llvm(ftype_name)
                    return tv_typed(fv, fty, ftype_name)
                }
            }
        }
        // Fallback: emit obj and try extractvalue
        let obj_tv = self.emit_expr(obj)
        if tv_is_struct(obj_tv) {
            let fi = struct_field_index(obj_tv.type_name, field)
            if fi >= 0 {
                let fv = llvm.build_extract_value(CG_B, obj_tv.val, fi, "sf")
                // Look up field type from struct registry
                mut ftype_name2 = "int"
                mut si2 = 0
                while si2 < CG_STRUCT_NAMES.length {
                    if CG_STRUCT_NAMES[si2] == obj_tv.type_name {
                        let ftnames2 = CG_STRUCT_FIELD_TYPE_NAMES[si2]
                        mut fidx2 = 0
                        mut fstart2 = 0
                        mut fpos2 = 0
                        while fpos2 <= ftnames2.length {
                            mut is_sep2 = false
                            if fpos2 == ftnames2.length { is_sep2 = true }
                            if !is_sep2 {
                                if ftnames2[fpos2] == "," { is_sep2 = true }
                            }
                            if is_sep2 {
                                if fidx2 == fi {
                                    ftype_name2 = ftnames2.substring(fstart2, fpos2)
                                }
                                fidx2 = fidx2 + 1
                                fstart2 = fpos2 + 1
                            }
                            fpos2 = fpos2 + 1
                        }
                        break
                    }
                    si2 = si2 + 1
                }
                let fty2 = resolve_type_name_to_llvm(ftype_name2)
                return tv_typed(fv, fty2, ftype_name2)
            }
        }
        // .length on list/string
        if field == "length" {
            if tv_is_str(obj_tv) {
                return tv_int(call_rt_1(CG_RT_SLEN, CG_STR, CG_I64, obj_tv.val, "sl"))
            }
            if tv_is_list(obj_tv) {
                let len = llvm.build_extract_value(CG_B, obj_tv.val, 1, "ll")
                return tv_int(len)
            }
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    // ─── Index access ───────────────────────────
    fn emit_index(self, obj: Expr, idx: Expr) -> TypedValue {
        let obj_tv = self.emit_expr(obj)
        let idx_tv = self.emit_expr(idx)
        // Map indexing
        if tv_is_map(obj_tv) {
            let ga = llvm.value_array_new(2)
            llvm.value_array_set(ga, 0, obj_tv.val)
            llvm.value_array_set(ga, 1, idx_tv.val)
            let gt = llvm.type_array_new(2)
            llvm.type_array_set(gt, 0, CG_PTR)
            llvm.type_array_set(gt, 1, CG_STR)
            llvm.type_array_free(gt)
            let result = checked_build_call(CG_RT_MAP_GET, ga, 2, "mg")
            llvm.value_array_free(ga)
            return tv_int(result)
        }
        // String indexing: charAt
        if tv_is_str(obj_tv) {
            let ca = llvm.value_array_new(2)
            llvm.value_array_set(ca, 0, obj_tv.val)
            llvm.value_array_set(ca, 1, idx_tv.val)
            let result = checked_build_call(CG_RT_SCHARAT, ca, 2, "ch")
            llvm.value_array_free(ca)
            return tv_str(result)
        }
        // List indexing: GEP
        if tv_is_list(obj_tv) {
            let dp = llvm.build_extract_value(CG_B, obj_tv.val, 0, "dp")
            if dp == null { return tv_int(llvm.const_int(CG_I64, 0, 0)) }
            let gi = llvm.value_array_new(1)
            llvm.value_array_set(gi, 0, idx_tv.val)
            let gp = llvm.build_gep2(CG_B, CG_I64, dp, gi, 1, "ep")
            llvm.value_array_free(gi)
            if gp == null { return tv_int(llvm.const_int(CG_I64, 0, 0)) }
            let ev = llvm.build_load(CG_B, CG_I64, gp, "ev")
            return tv_int(ev)
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    // ─── Struct literal ─────────────────────────
    fn emit_struct_literal(self, struct_name: string, field_values: List<Expr>) -> TypedValue {
        mut sty = resolve_type_to_llvm(struct_name)
        if sty == null { return tv_int(llvm.const_int(CG_I64, 0, 0)) }
        // If type resolved to i64 but has multiple fields, try to create named struct
        // using field type names from the struct registry
        if sty == CG_I64 && field_values.length > 1 {
            // Try to find field types from registry
            mut found_fields = false
            mut fsi = CG_STRUCT_NAMES.length - 1
            while fsi >= 0 {
                if CG_STRUCT_NAMES[fsi] == struct_name {
                    found_fields = true
                    break
                }
                fsi = fsi - 1
            }
            if found_fields && fsi >= 0 {
                let ftn = CG_STRUCT_FIELD_TYPE_NAMES[fsi]
                let fc = field_values.length
                let fta = llvm.type_array_new(fc)
                mut ffi = 0
                mut ftn_pos = 0
                mut ftn_start = 0
                while ftn_pos <= ftn.length && ffi < fc {
                    mut is_end = false
                    if ftn_pos == ftn.length { is_end = true }
                    if !is_end {
                        if ftn[ftn_pos] == "," { is_end = true }
                    }
                    if is_end {
                        let ft = ftn.substring(ftn_start, ftn_pos)
                        llvm.type_array_set(fta, ffi, resolve_type_name_to_llvm(ft))
                        ffi = ffi + 1
                        ftn_start = ftn_pos + 1
                    }
                    ftn_pos = ftn_pos + 1
                }
                // Use existing named type if available, don't create duplicates
                mut named = llvm.get_type_by_name(CG_CTX, struct_name)
                if named == null {
                    named = llvm.struct_create_named(CG_CTX, struct_name)
                }
                llvm.struct_set_body(named, fta, fc, 0)
                llvm.type_array_free(fta)
                sty = named
            }
        }
        mut result = llvm.get_undef(sty)
        // Look up field type names for nullable wrapping
        mut ftnames_str = ""
        mut si = CG_STRUCT_NAMES.length - 1
        while si >= 0 {
            if CG_STRUCT_NAMES[si] == struct_name {
                if si < CG_STRUCT_FIELD_TYPE_NAMES.length {
                    ftnames_str = CG_STRUCT_FIELD_TYPE_NAMES[si]
                }
                break
            }
            si = si - 1
        }
        mut fi = 0
        for fv in field_values {
            let ftv = self.emit_expr(fv)
            mut val = ftv.val
            // Check if this field is nullable — wrap in {i8, T} if needed
            // Parse field type at index fi from comma-separated ftnames_str
            mut ftn_idx = 0
            mut ftn_start = 0
            mut ftn_pos = 0
            mut field_type = ""
            while ftn_pos <= ftnames_str.length {
                mut is_end = false
                if ftn_pos == ftnames_str.length { is_end = true }
                if !is_end {
                    if ftnames_str[ftn_pos] == "," { is_end = true }
                }
                if is_end {
                    if ftn_idx == fi { field_type = ftnames_str.substring(ftn_start, ftn_pos) }
                    ftn_idx = ftn_idx + 1
                    ftn_start = ftn_pos + 1
                }
                ftn_pos = ftn_pos + 1
            }
            // Type coercion: ensure value matches expected field type
            if field_type != "" {
                let expected_ty = resolve_type_to_llvm(field_type)
                if expected_ty != null && val != null {
                    let val_ty = llvm.type_of(val)
                    // If types don't match, use zeroinitializer of the expected type
                    if val_ty != expected_ty {
                        val = llvm.const_null(expected_ty)
                    }
                }
            }
            // Nullable wrapping: if field type ends with "?" use resolve_type_to_llvm
            // which handles ptr-indirection for struct inner types automatically
            if field_type.length > 1 && field_type[field_type.length - 1] == "?" {
                let inner_name = field_type.substring(0, field_type.length - 1)
                // Resolve inner type, applying ptr-indirection for structs
                mut inner_ty = resolve_type_to_llvm(inner_name)
                // Apply same ptr-indirection as resolve_type_to_llvm does for nullable
                if inner_ty != null && inner_ty != CG_I64 && inner_ty != CG_STR && inner_ty != CG_PTR && inner_ty != CG_I8 {
                    let ik = llvm.get_type_kind(inner_ty)
                    if ik == 10 { inner_ty = CG_PTR }
                }
                if ftv.type_name == "ptr" || ftv.val == null {
                    val = make_null_value(inner_ty)
                } else {
                    mut coerced_val = val
                    if val != null {
                        let val_ty = llvm.type_of(val)
                        if val_ty != inner_ty {
                            coerced_val = llvm.const_null(inner_ty)
                        }
                    }
                    val = wrap_nullable(inner_ty, coerced_val)
                }
            }
            result = checked_build_insertvalue(result, val, fi, "sf")
            fi = fi + 1
        }
        tv_typed(result, sty, struct_name)
    }

    // ─── Match expression ───────────────────────
    fn emit_match_call(self, patterns: string, args: List<Expr>) -> TypedValue {
        if args.length < 2 { return tv_int(llvm.const_int(CG_I64, 0, 0)) }
        let subj_tv = self.emit_expr(args[0])
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")
        mut arm_idx = 0
        mut pat_pos = 0
        mut phi_vals: List<ptr> = []
        mut phi_bbs: List<ptr> = []
        while arm_idx < args.length - 1 {
            mut pat = ""
            while pat_pos < patterns.length {
                let ch = patterns[pat_pos]
                pat_pos = pat_pos + 1
                if ch == "," { break }
                pat = pat + ch
            }
            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            let next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            // Compare tag
            if pat == "_" {
                llvm.build_br(CG_B, arm_bb)
            } else {
                let tag = int(pat)
                let tag_val = llvm.const_int(CG_I64, tag, 0)
                mut cmp_val = subj_tv.val
                mut sk = 0
                if subj_tv.val != null { sk = llvm.get_type_kind(llvm.type_of(subj_tv.val)) }
                if sk == 10 {
                    let etag = llvm.build_extract_value(CG_B, subj_tv.val, 0, "mt")
                    if etag != null { cmp_val = llvm.build_zext(CG_B, etag, CG_I64, "mz") }
                }
                let cmp = llvm.build_icmp(CG_B, 32, cmp_val, tag_val, "mc")
                llvm.build_cond_br(CG_B, cmp, arm_bb, next_bb)
            }
            // Emit arm body
            llvm.position_at_end(CG_B, arm_bb)
            let arm_tv = self.emit_expr(args[arm_idx + 1])
            let arm_end = llvm.get_insert_block(CG_B)
            if !llvm.block_has_terminator(CG_B) {
                phi_vals = phi_vals.push(arm_tv.val)
                phi_bbs = phi_bbs.push(arm_end)
                llvm.build_br(CG_B, merge_bb)
            }
            llvm.position_at_end(CG_B, next_bb)
            arm_idx = arm_idx + 1
        }
        // Default: br to merge
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, merge_bb)
        if phi_vals.length > 0 {
            let phi = llvm.build_phi(CG_B, CG_I64, "mv")
            mut pi = 0
            while pi < phi_vals.length {
                llvm.add_incoming(phi, phi_vals[pi], phi_bbs[pi])
                pi = pi + 1
            }
            return tv_int(phi)
        }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    // ─── Variable definition ────────────────────
    fn define_var(self, name: string, tv: TypedValue) {
        mut alloca_ty = tv.ty
        if alloca_ty == null { alloca_ty = CG_I64 }
        if CG_B == 0 { return }
        let real_val = tv.val
        // Trust the type provided by the caller. No LLVMTypeOf override.
        // The caller (emit_expr, emit_fn_call_direct, param setup) is responsible
        // for setting the correct type. Overriding with LLVMTypeOf causes i64 params
        // to become ptr allocas (LLVM opaque pointers returns ptr for all params).
        if alloca_ty == null || alloca_ty == 0 { alloca_ty = CG_I64 }
        // Create alloca in entry block
        let cur_bb = llvm.get_insert_block(CG_B)
        let fn_val = llvm.get_basic_block_parent(cur_bb)
        let entry_bb = llvm.get_entry_basic_block(fn_val)
        let first_instr = llvm.get_first_instruction(entry_bb)
        if first_instr != null {
            llvm.position_before(CG_B, first_instr)
        } else {
            llvm.position_at_end(CG_B, entry_bb)
        }
        // Set pending name BEFORE build_alloca — the auto-cache in the Rust
        // wrapper uses it. Don't call forge_alloca_cache_set explicitly —
        // the mini's local variable for 'alloca' gets corrupted across scopes.
        forge_set_alloca_name(name)
        let alloca = llvm.build_alloca(CG_B, alloca_ty, name)
        forge_alloca_cache_set_type(name, alloca_ty)
        forge_var_type_set(name, tv.type_name)
        forge_idx_cache_set(forge_var_counter_inc(), alloca)
        // Restore position and store (checked: validates value type matches alloca type)
        llvm.position_at_end(CG_B, cur_bb)
        checked_build_store(real_val, alloca)
        CG_VAR_NAMES = CG_VAR_NAMES.push(name)
        CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
        // Register in C-side caches based on ACTUAL alloca type (not TypedValue type_name)
        cg_reinit_types()
        if alloca_ty == CG_STR { forge_str_var_add(name) }
        if alloca_ty == CG_PTR { forge_ptr_var_add(name) }
        if tv_is_list(tv) { forge_list_var_add(name) }
        // Register struct type if alloca is a struct (not ForgeString, not list)
        let ak2 = llvm.get_type_kind(alloca_ty)
        if ak2 == 10 && alloca_ty != CG_STR {
            // Single C call: looks up struct name by LLVM type AND registers the variable.
            // Avoids ForgeString intermediate that gets corrupted by mini's i64 alloca storage.
            forge_struct_var_add_by_type(name, alloca_ty)
        }
    }

    // ─── Statements ─────────────────────────────
    fn emit_statement(self, stmt: Statement) -> ptr {
        let stag = forge_enum_tag(stmt)
        match stmt {
            .Expr(expr) -> {
                return self.emit_expr(expr).val
            }
            .Assign(target, value, s) -> { self.emit_assign(target, value) }
            .Return(v, s) -> { self.emit_return(v) }
            .Let(name, val, s) -> {
                // Emit expr — the TypedValue .val field carries the LLVM value.
                // Also set last_emit_result as fallback for cases where .val is corrupted.
                let tv_result = self.emit_expr(val)
                forge_set_last_emit_result(tv_result.val)
                let real = tv_result.val
                // Use type annotation first (declared type drives codegen).
                // If no annotation, infer from the LLVM value type (struct returns, etc).
                let ann = forge_var_type_get(name)
                if ann != "" {
                    let resolved_ty = resolve_type_to_llvm(ann)
                    self.define_var(name, tv_typed(real, resolved_ty, ann))
                } else {
                    // No annotation — use the TypedValue from emit_expr which carries
                    // the return type info from the function registry
                    self.define_var(name, tv_result)
                }
            }
            .If(cond, then_body, else_body, has_else, s) -> {
                let cv = self.emit_expr(cond)
                let ci = cg_to_i1(cv.val)
                let ifn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                let tb = llvm.append_basic_block(CG_CTX, ifn, "th")
                let eb = llvm.append_basic_block(CG_CTX, ifn, "el")
                let mb = llvm.append_basic_block(CG_CTX, ifn, "mg")
                llvm.build_cond_br(CG_B, ci, tb, eb)
                llvm.position_at_end(CG_B, tb)
                self.emit_block(then_body)
                if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, mb) }
                llvm.position_at_end(CG_B, eb)
                if has_else { self.emit_block(else_body) }
                if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, mb) }
                llvm.position_at_end(CG_B, mb)
            }
            .While(cond, body, s) -> {
                let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                let cond_bb = llvm.append_basic_block(CG_CTX, fn_val, "wc")
                let body_bb = llvm.append_basic_block(CG_CTX, fn_val, "wb")
                let end_bb = llvm.append_basic_block(CG_CTX, fn_val, "we")
                WHILE_COND_BB = cond_bb
                WHILE_END_BB = end_bb
                llvm.build_br(CG_B, cond_bb)
                llvm.position_at_end(CG_B, cond_bb)
                let cv = self.emit_expr(cond)
                let ci = cg_to_i1(cv.val)
                llvm.build_cond_br(CG_B, ci, body_bb, end_bb)
                llvm.position_at_end(CG_B, body_bb)
                self.emit_block(body)
                if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, cond_bb) }
                llvm.position_at_end(CG_B, end_bb)
            }
            .For(name, iter, body, s) -> {
                let iter_tv = self.emit_expr(iter)
                let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                let cond_bb = llvm.append_basic_block(CG_CTX, fn_val, "fc")
                let body_bb = llvm.append_basic_block(CG_CTX, fn_val, "fb")
                let end_bb = llvm.append_basic_block(CG_CTX, fn_val, "fe")
                WHILE_COND_BB = cond_bb
                WHILE_END_BB = end_bb
                // Store iter data in allocas (domination: available in all loop blocks)
                let len_val = llvm.build_extract_value(CG_B, iter_tv.val, 1, "fl")
                let data_val = llvm.build_extract_value(CG_B, iter_tv.val, 0, "fd")
                self.define_var("__for_len", tv_int(len_val))
                self.define_var("__for_data", tv_ptr(data_val))
                self.define_var("__for_idx", tv_int(llvm.const_int(CG_I64, 0, 0)))
                llvm.build_br(CG_B, cond_bb)
                llvm.position_at_end(CG_B, cond_bb)
                let idx_ptr = forge_alloca_cache_get("__for_idx")
                let len_ptr = forge_alloca_cache_get("__for_len")
                let data_ptr = forge_alloca_cache_get("__for_data")
                let cur_idx = llvm.build_load(CG_B, CG_I64, idx_ptr, "fi")
                let len = llvm.build_load(CG_B, CG_I64, len_ptr, "fl")
                let data = llvm.build_load(CG_B, CG_PTR, data_ptr, "fd")
                let cmp = llvm.build_icmp(CG_B, 40, cur_idx, len, "fc")
                llvm.build_cond_br(CG_B, cmp, body_bb, end_bb)
                llvm.position_at_end(CG_B, body_bb)
                // Load current element
                let gi = llvm.value_array_new(1)
                llvm.value_array_set(gi, 0, cur_idx)
                let ep = llvm.build_gep2(CG_B, CG_I64, data, gi, 1, "fp")
                llvm.value_array_free(gi)
                let elem = llvm.build_load(CG_B, CG_I64, ep, "fv")
                self.define_var(name, tv_int(elem))
                self.emit_block(body)
                // Increment index
                let next_idx = llvm.build_add(CG_B, cur_idx, llvm.const_int(CG_I64, 1, 0), "fi")
                llvm.build_store(CG_B, next_idx, idx_ptr)
                if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, cond_bb) }
                llvm.position_at_end(CG_B, end_bb)
            }
            .Break(s) -> {
                if WHILE_END_BB != null { llvm.build_br(CG_B, WHILE_END_BB) }
            }
            .Continue(s) -> {
                if WHILE_COND_BB != null { llvm.build_br(CG_B, WHILE_COND_BB) }
            }
            .Feature(fe) -> { self.dispatch_stmt(fe) }
            _ -> {}
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_block(self, block: Block) -> ptr {
        mut last = llvm.const_int(CG_I64, 0, 0)
        let _stmts = block.statements
        for stmt in _stmts {
            if llvm.block_has_terminator(CG_B) { break }
            last = self.emit_statement(stmt)
        }
        last
    }

    fn emit_return(self, value: Expr) {
        match value {
            .NullLit(span) -> {
                if CG_FN_RETURNS_NULLABLE == 1 {
                    llvm.build_ret(CG_B, make_null_value(CG_FN_NULLABLE_INNER_TY))
                } else {
                    llvm.build_ret_void(CG_B)
                }
            }
            _ -> {
                let tv = self.emit_expr(value)
                if CG_FN_RETURNS_NULLABLE == 1 {
                    llvm.build_ret(CG_B, wrap_nullable(CG_FN_NULLABLE_INNER_TY, tv.val))
                } else {
                    llvm.build_ret(CG_B, tv.val)
                }
            }
        }
    }

    fn emit_assign(self, target: Expr, value: Expr) {
        let tv = self.emit_expr(value)
        match target {
            .Ident(name, span) -> {
                let var_ptr = forge_alloca_cache_get(name)
                if var_ptr != null {
                    llvm.build_store(CG_B, tv.val, var_ptr)
                }
            }
            .MemberAccess(obj, field, span) -> {
                // self.field = value → GEP to field, store
                mut obj_name = ""
                match obj {
                    .Ident(n, s) -> { obj_name = n }
                    _ -> {}
                }
                if obj_name != "" {
                    let stype = var_struct_type(obj_name)
                    if stype != "" {
                        let fi = struct_field_index(stype, field)
                        if fi >= 0 {
                            let obj_ptr = forge_alloca_cache_get(obj_name)
                            if obj_ptr != null {
                                // obj_ptr might be ptr to ptr (self), or ptr to struct
                                let alloca_ty = forge_alloca_cache_get_type(obj_name)
                                let ak = llvm.get_type_kind(alloca_ty)
                                if ak == 12 {
                                    // ptr alloca (self) — load ptr, then GEP struct field
                                    let struct_ptr = llvm.build_load(CG_B, CG_PTR, obj_ptr, "sp")
                                    let sty = resolve_type_to_llvm(stype)
                                    if sty != null {
                                        let field_ptr = llvm.build_struct_gep2(CG_B, sty, struct_ptr, fi, "fp")
                                        llvm.build_store(CG_B, tv.val, field_ptr)
                                    }
                                } else {
                                    // Direct struct alloca — GEP directly
                                    let sty = resolve_type_to_llvm(stype)
                                    if sty != null {
                                        let field_ptr = llvm.build_struct_gep2(CG_B, sty, obj_ptr, fi, "fp")
                                        llvm.build_store(CG_B, tv.val, field_ptr)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            _ -> {}
        }
    }

    fn emit_println(self, args: List<Expr>) {
        if args.length == 0 { return }
        let tv = self.emit_expr(args[0])
        if tv_is_str(tv) {
            let pa = llvm.value_array_new(1)
            llvm.value_array_set(pa, 0, tv.val)
            checked_build_call(CG_RT_PRINTLN, pa, 1, "")
            llvm.value_array_free(pa)
        } else {
            // Convert to string first
            let sv = call_rt_1(CG_RT_I2S, CG_I64, CG_STR, tv.val, "ts")
            let pa = llvm.value_array_new(1)
            llvm.value_array_set(pa, 0, sv)
            checked_build_call(CG_RT_PRINTLN, pa, 1, "")
            llvm.value_array_free(pa)
        }
    }

    fn dispatch_stmt(self, fe: FeatureStmt) {
        dispatch_emit_stmt(self, fe.data)
    }

    fn dispatch_expr(self, fe: FeatureExpr) -> TypedValue {
        let result = dispatch_emit_expr(self, fe.data)
        if result != null { return tv_ptr(result) }
        tv_int(llvm.const_int(CG_I64, 0, 0))
    }

    fn write_ir(self, path: string) -> bool {
        llvm.print_module_to_file(CG_MOD, path) == 0
    }

    fn is_string_var(self, name: string) -> bool {
        forge_str_var_check(name) == 1
    }

    fn is_map_var(self, name: string) -> bool {
        false
    }

    fn lookup_variant_field_types(self, variant_qname: string) -> string {
        ""
    }

    fn lookup_list_elem_type(self, field_name: string) -> string {
        ""
    }

    fn field_is_boxed(self, ft: string, idx: int) -> bool {
        false
    }

    fn field_is_multislot(self, ft: string, idx: int) -> bool {
        false
    }
}
