// ─── Code Generator (stub for bootstrap) ───────
// Full codegen deferred — bootstrap has multiple IR generation bugs:
// 1. Struct default values produce i64 0 instead of zeroed structs
// 2. Enum variant construction inserts wrong types
// 3. PHI predecessor mismatches in complex match arms
//
// The check command works fully. Build requires fixing bootstrap codegen.

use core.types.Type
use core.ast.{Program, Statement, Expr}
use @std.llvm

export type Codegen = { ctx: ptr }
export fn codegen_new() -> Codegen { Codegen { ctx: null } }
impl Codegen {
    fn init(self, name: string) {}
    fn verify(self) -> bool { true }
    fn dispose(self) {}
    fn emit_program(self, program: Program) {}
    fn define_var(self, name: string, ty: Type, value: ptr) {}
    fn emit_expr(self, expr: Expr) -> ptr { null }
}
