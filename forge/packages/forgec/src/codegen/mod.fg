export mut CG_RT_MAP_HAS: ptr = null
export mut CG_RT_MAP_GET: ptr = null
export mut CG_RT_MAP_SET: ptr = null

// Global variable storage (bootstrap workaround: struct fields don't survive method calls)
mut CG_VAR_NAMES: List<string> = []
mut CG_VAR_PTRS: List<ptr> = []
export mut CG_VAR_TYPES: List<string> = []  // canonical type: "int","string","float","bool","ptr","map","list:T","nullable:T","enum:E","struct:S"
mut CG_VAR_IS_STR: List<int> = []  // 1 = string/list type, 0 = int type (UNRELIABLE after many entries)
export mut CG_STR_VAR_NAMES: List<string> = []  // names of string/list typed variables (reliable)
export mut CG_VAR_IS_MAP: List<int> = []  // 1 = map type, 0 = other
export mut CG_MAP_VAR_NAMES: List<string> = []  // names of map-typed variables
// Track nullable variable names (for null comparison and unwrap)
export mut CG_NULLABLE_VAR_NAMES: List<string> = []
export mut CG_NULLABLE_VAR_INNER: List<string> = []  // inner type name ("int", "string")
// Track list variable names as comma-separated strings (bootstrap List<string> unreliable)
export mut CG_LIST_VAR_CSV: string = ""        // all list vars
export mut CG_STR_GLOBALS_CSV: string = ""     // string/list globals (CSV, immune to corruption)
export mut CG_STR_LOCALS_CSV: string = ""      // string/list locals (CSV, immune to corruption)
export mut CG_STR_LIST_VAR_CSV: string = ""    // string-element list vars
// Track list element type names: ",varname:typename," format
export mut CG_LIST_ELEM_TYPE_CSV: string = ""  // e.g. ",TOKENS:Token,,IDS:int,"

// Top-level global variable tracking (CSV strings — List<string> globals unreliable)
export mut CG_GLOBAL_CSV: string = ""  // ",name:type,name:type," format
export mut CG_GLOBAL_COUNT: int = 0

// Boundary index: vars before this index are globals, after are function-locals
export mut CG_VAR_SCOPE_START: int = 0

// CG_ACTIVE removed — parser is now a pure parser, codegen is separate

// Debug: recursion depth counter for emit_expr
export mut EMIT_DEPTH: int = 0

// Top-level source fragments to inject into main
export mut CG_TOPLEVEL_SOURCES: List<string> = []

// Struct type registry: maps struct names to field info
// Each struct is stored as: name in CG_STRUCT_NAMES, fields as comma-separated
// in CG_STRUCT_FIELDS, LLVM type in CG_STRUCT_TYPES
export mut CG_STRUCT_NAMES: List<string> = []
export mut CG_STRUCT_FIELDS: List<string> = []  // comma-separated field names
export mut CG_STRUCT_TYPES: List<ptr> = []       // LLVM struct types
export mut CG_STRUCT_FIELD_IS_STR: List<string> = []  // comma-separated "0"/"1" per field
export mut CG_STRUCT_FIELD_TYPE_NAMES: List<string> = []  // comma-separated type names per field

// Track which variables are struct-typed
export mut CG_STRUCT_VAR_NAMES: List<string> = []   // variable names
export mut CG_STRUCT_VAR_CSV: string = ""            // ",varname:TypeName," format (immune to corruption)
export mut CG_STRUCT_VAR_TYPES: List<string> = []   // struct type names
export mut CG_STRUCT_VAR_FIELDS: List<string> = []  // comma-separated field names
// The most recently emitted LLVM value (for passing through call chain without AST corruption)
export mut CG_LAST_VAL: ptr = null
export mut CG_HAS_LAST_VAL: int = 0

// Match expression globals (PENDING pattern)
export mut PENDING_MATCH: bool = false
export mut MATCH_SCRUTINEE: Expr = Expr.IntLit(0, Span { start: 0, end: 0, line: 0, col: 0 })
export mut MATCH_ARM_TAGS: string = ""    // comma-separated tag ints
export mut MATCH_ARM_BODIES: List<Block> = []
export mut MATCH_DEFAULT: Block = Block { statements: [], span: Span { start: 0, end: 0, line: 0, col: 0 } }
export mut MATCH_HAS_DEFAULT: bool = false

export type Codegen = {
    mut current_fn: ptr?,
    mut functions: Map<string, ptr>,
    mut vars: Map<string, ptr>,
}

export fn codegen_new() -> Codegen {
    Codegen { current_fn: null, functions: {}, vars: {} }
}

fn make_fn_type(ret: ptr, params: List<ptr>) -> ptr {
    let arr = llvm.type_array_new(params.length)
    mut i = 0
    for p in params {
        llvm.type_array_set(arr, i, p)
        i = i + 1
    }
    let ft = llvm.function_type(ret, arr, params.length, 0)
    llvm.type_array_free(arr)
    ft
}
fn mft0(ret: ptr) -> ptr {
    let a = llvm.type_array_new(0)
    let f = llvm.function_type(ret, a, 0, 0)
    llvm.type_array_free(a)
    f
}
fn mft1(ret: ptr, p0: ptr) -> ptr {
    let a = llvm.type_array_new(1)
    llvm.type_array_set(a, 0, p0)
    let f = llvm.function_type(ret, a, 1, 0)
    llvm.type_array_free(a)
    f
}
fn mft2(ret: ptr, p0: ptr, p1: ptr) -> ptr {
    let a = llvm.type_array_new(2)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    let f = llvm.function_type(ret, a, 2, 0)
    llvm.type_array_free(a)
    f
}
fn mft3(ret: ptr, p0: ptr, p1: ptr, p2: ptr) -> ptr {
    let a = llvm.type_array_new(3)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    let f = llvm.function_type(ret, a, 3, 0)
    llvm.type_array_free(a)
    f
}
fn mft4(ret: ptr, p0: ptr, p1: ptr, p2: ptr, p3: ptr) -> ptr {
    let a = llvm.type_array_new(4)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    llvm.type_array_set(a, 3, p3)
    let f = llvm.function_type(ret, a, 4, 0)
    llvm.type_array_free(a)
    f
}
fn mft5(ret: ptr, p0: ptr, p1: ptr, p2: ptr, p3: ptr, p4: ptr) -> ptr {
    let a = llvm.type_array_new(5)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    llvm.type_array_set(a, 3, p3)
    llvm.type_array_set(a, 4, p4)
    let f = llvm.function_type(ret, a, 5, 0)
    llvm.type_array_free(a)
    f
}
fn mft6(ret: ptr, p0: ptr, p1: ptr, p2: ptr, p3: ptr, p4: ptr, p5: ptr) -> ptr {
    let a = llvm.type_array_new(6)
    llvm.type_array_set(a, 0, p0)
    llvm.type_array_set(a, 1, p1)
    llvm.type_array_set(a, 2, p2)
    llvm.type_array_set(a, 3, p3)
    llvm.type_array_set(a, 4, p4)
    llvm.type_array_set(a, 5, p5)
    let f = llvm.function_type(ret, a, 6, 0)
    llvm.type_array_free(a)
    f
}

// Store a top-level statement's source text for injection into main
export fn store_toplevel_source(src: string) {
    CG_TOPLEVEL_SOURCES = CG_TOPLEVEL_SOURCES.push(src)
}

// Create LLVM globals from a list of names. All globals use CG_STR type ({ptr, i64})
// which covers int (wastes 8 bytes), string, and list values.
export fn create_globals_typed(names: List<string>, str_mask: int) {
    mut i = 0
    while i < names.length {
        let name = names[i]
        // Use ForgeString type for ALL globals (safe: ForgeString is 16 bytes, i64 fits in first 8)
        // This ensures string globals work correctly with ForgeString operations
        cg_reinit_types()
        let gty = CG_STR
        let gv = llvm.add_global(CG_MOD, gty, name)
        let zero = llvm.const_null(gty)
        llvm.set_initializer(gv, zero)
        CG_VAR_NAMES = CG_VAR_NAMES.push(name)
        CG_VAR_PTRS = CG_VAR_PTRS.push(gv)
        // Check bitmask for string type
        mut bit = 1
        mut shift = 0
        while shift < i {
            bit = bit * 2
            shift = shift + 1
        }
        let is_str = (str_mask / bit) % 2 == 1
        // Also check name patterns for string/list globals
        mut is_str_global = is_str
        if name.index_of("CSV") >= 0 { is_str_global = true }
        if name.index_of("PATHS") >= 0 { is_str_global = true }
        if name.index_of("REG_") >= 0 { is_str_global = false }
        if name.index_of("REGISTRY") >= 0 { is_str_global = false }
        mut gtype = "int"
        if is_str_global { gtype = "string" }
        CG_VAR_TYPES = CG_VAR_TYPES.push(gtype)
        mut is_str_flag2 = 0
        if is_str_global { is_str_flag2 = 1 }
        CG_VAR_IS_STR = CG_VAR_IS_STR.push(is_str_flag2)
        CG_VAR_IS_MAP = CG_VAR_IS_MAP.push(0)
        // Register in CSV (immune to list corruption)
        if is_str_global {
            CG_STR_GLOBALS_CSV = CG_STR_GLOBALS_CSV + "," + name + ","
            CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(name)
        }
        i = i + 1
    }
}

// Create LLVM globals for all registered global variables.
// Parses CSV string with "name:type\n" entries.
export fn create_llvm_globals_from(csv: string, count: int) {
    if count == 0 { return }
    mut pos = 0
    let csv_len = csv.length
    while pos < csv_len {
        // Read name (until :)
        mut name = ""
        while pos < csv_len {
            if csv[pos] == ":" { break }
            name = name + csv[pos]
            pos = pos + 1
        }
        if pos >= csv_len { break }
        pos = pos + 1 // skip :
        // Read type (until \n)
        mut type_name = ""
        while pos < csv_len {
            if csv[pos] == "\n" { break }
            type_name = type_name + csv[pos]
            pos = pos + 1
        }
        if pos < csv_len { pos = pos + 1 } // skip \n
        if name == "" { break }

        // Determine LLVM type
        mut gty = CG_I64
        let is_list_struct = type_name.length > 12 && type_name.substring(0, 12) == "list_struct:"
        let is_list = type_name == "list" || type_name == "list_str" || is_list_struct
        if type_name == "string" || is_list { gty = CG_STR }
        else if type_name == "map" { gty = CG_PTR }

        let gv = llvm.add_global(CG_MOD, gty, name)
        mut zero = llvm.const_int(CG_I64, 0, 0)
        if type_name == "string" || is_list {
            zero = llvm.const_null(gty)
        } else if type_name == "map" {
            zero = llvm.const_null(CG_PTR)
        }
        llvm.set_initializer(gv, zero)

        // Register in CG_VAR system
        CG_VAR_NAMES = CG_VAR_NAMES.push(name)
        CG_VAR_PTRS = CG_VAR_PTRS.push(gv)
        CG_VAR_TYPES = CG_VAR_TYPES.push(type_name)
        mut is_str_flag2 = 0
        if type_name == "string" || is_list { is_str_flag2 = 1 }
        CG_VAR_IS_STR = CG_VAR_IS_STR.push(is_str_flag2)
        mut is_map_flag = 0
        if type_name == "map" { is_map_flag = 1 }
        CG_VAR_IS_MAP = CG_VAR_IS_MAP.push(is_map_flag)
        if type_name == "string" || is_list {
            CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(name)
        }
        if type_name == "map" {
            CG_MAP_VAR_NAMES = CG_MAP_VAR_NAMES.push(name)
        }
        // Track list info
        if is_list {
            CG_LIST_VAR_CSV = CG_LIST_VAR_CSV + ",${name},"
            if type_name == "list_str" {
                CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${name}:string,"
                CG_STR_LIST_VAR_CSV = CG_STR_LIST_VAR_CSV + ",${name},"
            } else if is_list_struct {
                let elem_type = type_name.substring(12, type_name.length)
                CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${name}:${elem_type},"
            } else {
                CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${name}:int,"
            }
        }
    }
}

// Check if a name is in a comma-separated string (e.g., ",NAMES,IDS,")
fn csv_contains(csv: string, name: string) -> bool {
    let needle = ",${name},"
    let nl = needle.length
    let cl = csv.length
    if cl < nl { return false }
    mut i = 0
    while i <= cl - nl {
        mut match_ok = true
        mut j = 0
        while j < nl {
            if csv[i + j] != needle[j] {
                match_ok = false
                break
            }
            j = j + 1
        }
        if match_ok { return true }
        i = i + 1
    }
    false
}

// Check if a variable is ANY kind of list
export fn is_list_var(name: string) -> bool {
    csv_contains(CG_LIST_VAR_CSV, name)
}

// Check if a variable is a list with string elements (16-byte stride)
export fn is_str_list_var(name: string) -> bool {
    csv_contains(CG_STR_LIST_VAR_CSV, name)
}

// Get the element type name for a list variable. Returns "" if not found.
export fn list_elem_type(name: string) -> string {
    // Search CG_LIST_ELEM_TYPE_CSV for ",name:type,"
    let needle = ",${name}:"
    let nl = needle.length
    let cl = CG_LIST_ELEM_TYPE_CSV.length
    mut i = 0
    while i <= cl - nl {
        mut match_ok = true
        mut j = 0
        while j < nl {
            if CG_LIST_ELEM_TYPE_CSV[i + j] != needle[j] {
                match_ok = false
                break
            }
            j = j + 1
        }
        if match_ok {
            // Found — extract type until next comma
            mut type_start = i + nl
            mut type_end = type_start
            while type_end < cl {
                if CG_LIST_ELEM_TYPE_CSV[type_end] == "," { break }
                type_end = type_end + 1
            }
            return CG_LIST_ELEM_TYPE_CSV.substring(type_start, type_end)
        }
        i = i + 1
    }
    ""
}

// Get the LLVM element type for a list variable
export fn list_elem_llvm_type(name: string) -> ptr {
    let elem = list_elem_type(name)
    if elem == "string" { return CG_STR }
    if elem == "int" || elem == "" { return CG_I64 }
    // Struct type — look up in struct registry
    mut si = CG_STRUCT_NAMES.length - 1
    while si >= 0 {
        if CG_STRUCT_NAMES[si] == elem {
            let sty = CG_STRUCT_TYPES[si]
            if sty != null { return sty }
        }
        si = si - 1
    }
    CG_I64
}

// ─── Enum Tagged Union Helpers ───────────────────
export mut CG_ENUM_TYPE_CSV: string = ""   // ",Name:maxslots,"  (slot count, not field count)
export mut CG_ENUM_VAR_CSV: string = ""    // ",varname:EnumType,"
export mut CG_UNIVERSAL_ENUM_TY: ptr = null // DEPRECATED — use per-enum types
// Per-enum type cache
mut CG_ENUM_TYPE_CACHE_NAMES: List<string> = []
mut CG_ENUM_TYPE_CACHE_PTRS: List<ptr> = []
// Per-variant field types: ",EnumName.VariantName:si," where s=string(2 slots), i=int(1 slot)
export mut CG_ENUM_VARIANT_FIELDS_CSV: string = ""

export fn cg_enum_max_fields(name: string) -> int {
    let needle = "," + name + ":"
    let idx = CG_ENUM_TYPE_CSV.index_of(needle)
    if idx < 0 { return 0 }
    // Extract the number after the needle
    let start = idx + needle.length
    mut ns = ""
    mut k = start
    while k < CG_ENUM_TYPE_CSV.length {
        let ch = CG_ENUM_TYPE_CSV[k]
        if ch == "," { break }
        ns = ns + ch
        k = k + 1
    }
    if ns.length > 0 { return int(ns) }
    0
}

// Get or create the LLVM type for a specific enum (per-enum sizing like Rust)
export fn cg_get_enum_ty_for(name: string) -> ptr {
    // Check cache first
    mut ci = 0
    while ci < CG_ENUM_TYPE_CACHE_NAMES.length {
        if CG_ENUM_TYPE_CACHE_NAMES[ci] == name {
            return CG_ENUM_TYPE_CACHE_PTRS[ci]
        }
        ci = ci + 1
    }
    // Create: {i8, i64 x max_fields}
    let mf = cg_enum_max_fields(name)
    mut fc = 2  // minimum {i8, i64}
    if mf > 0 { fc = mf + 1 }
    let fields = llvm.type_array_new(fc)
    llvm.type_array_set(fields, 0, CG_I8)
    mut fi = 1
    while fi < fc {
        llvm.type_array_set(fields, fi, CG_I64)
        fi = fi + 1
    }
    // Named enum type (like Rust) for proper LLVM ABI handling
    let ty = llvm.struct_create_named(CG_CTX, name)
    llvm.struct_set_body(ty, fields, fc, 0)
    llvm.type_array_free(fields)
    // Cache it
    CG_ENUM_TYPE_CACHE_NAMES = CG_ENUM_TYPE_CACHE_NAMES.push(name)
    CG_ENUM_TYPE_CACHE_PTRS = CG_ENUM_TYPE_CACHE_PTRS.push(ty)
    ty
}

export fn cg_make_enum_type(name: string) -> ptr {
    let mf = cg_enum_max_fields(name)
    if mf == 0 { return null }
    cg_get_enum_ty_for(name)
}

export fn cg_var_enum_type(name: string) -> string {
    let needle = "," + name + ":"
    let nl = needle.length
    let cl = CG_ENUM_VAR_CSV.length
    mut i = 0
    while i + nl <= cl {
        mut ok = true
        mut j = 0
        while j < nl {
            if CG_ENUM_VAR_CSV[i + j] != needle[j] { ok = false }
            j = j + 1
        }
        if ok {
            mut r = ""
            mut k = i + nl
            while k < cl {
                if CG_ENUM_VAR_CSV[k] == "," { break }
                r = r + CG_ENUM_VAR_CSV[k]
                k = k + 1
            }
            return r
        }
        i = i + 1
    }
    ""
}

// Look up variant field types string for "EnumName.VariantName"
// Returns e.g. "si" meaning field 0 is string, field 1 is int
export fn cg_enum_variant_field_types(enum_name: string, variant_name: string) -> string {
    let needle = "," + enum_name + "." + variant_name + ":"
    let nl = needle.length
    let cl = CG_ENUM_VARIANT_FIELDS_CSV.length
    mut i = 0
    while i + nl <= cl {
        mut ok = true
        mut j = 0
        while j < nl {
            if CG_ENUM_VARIANT_FIELDS_CSV[i + j] != needle[j] { ok = false }
            j = j + 1
        }
        if ok {
            mut r = ""
            mut k = i + nl
            while k < cl {
                if CG_ENUM_VARIANT_FIELDS_CSV[k] == "," { break }
                r = r + CG_ENUM_VARIANT_FIELDS_CSV[k]
                k = k + 1
            }
            return r
        }
        i = i + 1
    }
    ""
}

// Compute slot offset for field index in a variant, given field types string
// e.g. field_types="si", field_idx=1 -> offset=2 (string takes slots 0-1, int at slot 2)
// Field type codes: i=int(1), s=string(2), l=list(2), 4=Span(4)
export fn cg_enum_field_slot_offset(field_types: string, field_idx: int) -> int {
    mut offset = 0
    mut fi = 0
    while fi < field_idx {
        if fi < field_types.length {
            let fc = field_types[fi]
            if fc == "s" {
                offset = offset + 2
            } else if fc == "l" {
                offset = offset + 2
            } else if fc == "4" {
                offset = offset + 4
            } else {
                offset = offset + 1
            }
        } else {
            offset = offset + 1
        }
        fi = fi + 1
    }
    offset
}

// Get the number of i64 slots for a field type code
fn field_type_slots(code: string) -> int {
    if code == "s" { return 2 }
    if code == "l" { return 2 }
    if code == "4" { return 4 }
    1
}

// Register variant field types
export fn register_enum_variant_fields(enum_name: string, variant_name: string, field_types: string) {
    CG_ENUM_VARIANT_FIELDS_CSV = CG_ENUM_VARIANT_FIELDS_CSV + "," + enum_name + "." + variant_name + ":" + field_types + ","
}

// ─── Nullable Type Helpers ───────────────────────

export mut CG_FN_RETURNS_NULLABLE: int = 0
export mut CG_FN_NULLABLE_INNER_TY: ptr = null
export mut CG_FN_NULLABLE_RET_TY: ptr = null
export mut CG_NULLABLE_INT_TY: ptr = null
export mut CG_NULLABLE_STR_TY: ptr = null

export fn make_nullable_type(inner_ty: ptr) -> ptr {
    if inner_ty == CG_I64 && CG_NULLABLE_INT_TY != null { return CG_NULLABLE_INT_TY }
    if inner_ty == CG_STR && CG_NULLABLE_STR_TY != null { return CG_NULLABLE_STR_TY }
    let fields = llvm.type_array_new(2)
    llvm.type_array_set(fields, 0, CG_I8)
    llvm.type_array_set(fields, 1, inner_ty)
    let nullable_ty = llvm.struct_type(CG_CTX, fields, 2, 0)
    llvm.type_array_free(fields)
    if inner_ty == CG_I64 { CG_NULLABLE_INT_TY = nullable_ty }
    if inner_ty == CG_STR { CG_NULLABLE_STR_TY = nullable_ty }
    nullable_ty
}

export fn wrap_nullable(inner_ty: ptr, value: ptr) -> ptr {
    let nullable_ty = make_nullable_type(inner_ty)
    let undef = llvm.get_undef(nullable_ty)
    let s1 = llvm.build_insert_value(CG_B, undef, llvm.const_int(CG_I8, 1, 0), 0, "wt")
    llvm.build_insert_value(CG_B, s1, value, 1, "wv")
}

export fn make_null_value(inner_ty: ptr) -> ptr {
    let nullable_ty = make_nullable_type(inner_ty)
    let undef = llvm.get_undef(nullable_ty)
    let s1 = llvm.build_insert_value(CG_B, undef, llvm.const_int(CG_I8, 0, 0), 0, "nt")
    llvm.build_insert_value(CG_B, s1, llvm.const_null(inner_ty), 1, "nv")
}

export fn is_nullable_var(name: string) -> bool {
    mut i = CG_NULLABLE_VAR_NAMES.length - 1
    while i >= 0 {
        if CG_NULLABLE_VAR_NAMES[i] == name { return true }
        i = i - 1
    }
    false
}

export fn nullable_var_inner_type(name: string) -> string {
    mut i = CG_NULLABLE_VAR_NAMES.length - 1
    while i >= 0 {
        if CG_NULLABLE_VAR_NAMES[i] == name { return CG_NULLABLE_VAR_INNER[i] }
        i = i - 1
    }
    "int"
}

// ─── Codegen Methods ───────────────────────────

// Register a struct type with its fields
export fn register_struct_type(name: string, fields: string, field_is_str: string, llvm_ty: ptr) {
    CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(name)
    CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
    CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(field_is_str)
    CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(llvm_ty)
    CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push("")
}

// Register a struct type with field type names
export fn register_struct_type_full(name: string, fields: string, field_is_str: string, field_type_names: string, llvm_ty: ptr) {
    CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(name)
    CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
    CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(field_is_str)
    CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(llvm_ty)
    CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(field_type_names)
}

// Resolve a type name to its LLVM type
export fn resolve_type_to_llvm(type_name: string) -> ptr {
    if type_name == "string" { return CG_STR }
    if type_name == "int" { return CG_I64 }
    if type_name == "float" { return CG_I64 }
    if type_name == "bool" { return CG_I64 }
    if type_name == "ptr" { return CG_I64 }
    if type_name.length >= 4 {
        if type_name[0] == "L" {
            if type_name[1] == "i" {
                if type_name[2] == "s" {
                    if type_name[3] == "t" {
                        return CG_LIST
                    }
                }
            }
        }
    }
    // Use LLVM's own named type registry — no global list search
    let named = llvm.get_type_by_name(CG_CTX, type_name)
    if named != null { return named }
    // Check enum type
    let emf = cg_enum_max_fields(type_name)
    let enum_needle = "," + type_name + ":"
    if CG_ENUM_TYPE_CSV.index_of(enum_needle) >= 0 {
        if emf > 0 {
            let ety = cg_get_enum_ty_for(type_name)
            if ety != null { return ety }
        } else {
            // Zero-payload enum: just a tag, represented as i64
            return CG_I64
        }
    }
    // Check struct type via CG_STRUCT_NAMES (legacy — used for field info lookup)
    mut sti = CG_STRUCT_NAMES.length - 1
    while sti >= 0 {
        if CG_STRUCT_NAMES[sti] == type_name {
            let sty = CG_STRUCT_TYPES[sti]
            if sty != null { return sty }
        }
        sti = sti - 1
    }
    // Fallback: direct LLVM named type lookup (immune to list corruption)
    let named_ty = llvm.get_type_by_name(CG_CTX, type_name)
    if named_ty != null { return named_ty }
    CG_I64
}

// Find a struct type's field index by name. Returns -1 if not found.
export fn struct_field_index(struct_name: string, field_name: string) -> int {
    // Find the struct
    mut si = 0
    while si < CG_STRUCT_NAMES.length {
        if CG_STRUCT_NAMES[si] == struct_name {
            // Parse comma-separated fields
            let fields = CG_STRUCT_FIELDS[si]
            mut idx = 0
            mut current = ""
            mut fi = 0
            while fi < fields.length {
                let ch = fields[fi]
                if ch == "," {
                    if current == field_name { return idx }
                    idx = idx + 1
                    current = ""
                } else {
                    current = current + ch
                }
                fi = fi + 1
            }
            if current == field_name { return idx }
            return -1
        }
        si = si + 1
    }
    return -1
}

// Get the struct type name for a variable
export fn var_struct_type(name: string) -> string {
    // Try CSV first (immune to list corruption)
    let csv_needle = "," + name + ":"
    let csv_pos = CG_STRUCT_VAR_CSV.index_of(csv_needle)
    if csv_pos >= 0 {
        let after = CG_STRUCT_VAR_CSV.substring(csv_pos + csv_needle.length, CG_STRUCT_VAR_CSV.length)
        let comma = after.index_of(",")
        if comma >= 0 { return after.substring(0, comma) }
    }
    // Fallback to list (may be corrupted)
    mut vi = CG_STRUCT_VAR_NAMES.length - 1
    while vi >= 0 {
        if CG_STRUCT_VAR_NAMES[vi] == name {
            return CG_STRUCT_VAR_TYPES[vi]
        }
        vi = vi - 1
    }
    ""
}

export fn codegen_init(name: string) {
    // Reset per-module LLVM state (preserves metadata from scan phase)
    CG_VAR_NAMES = []
    CG_VAR_PTRS = []
    CG_VAR_IS_STR = []
    CG_STR_VAR_NAMES = []
    CG_VAR_IS_MAP = []
    CG_MAP_VAR_NAMES = []
    CG_STRUCT_VAR_NAMES = []
    CG_STRUCT_VAR_TYPES = []
    CG_STRUCT_VAR_FIELDS = []
    CG_VAR_SCOPE_START = 0
    CG_HAS_LAST_VAL = 0
    CG_UNIVERSAL_ENUM_TY = null
    CG_ENUM_TYPE_CACHE_NAMES = []
    CG_ENUM_TYPE_CACHE_PTRS = []
    CG_NULLABLE_INT_TY = null
    CG_NULLABLE_STR_TY = null
    let dfns = forge_map_new()
    DECLARED_FNS = dfns
    cg_init_ctx(name)
    cg_init_int_types()
    cg_init_other_types()
    cg_init_str()
    cg_init_runtime()
}

export fn codegen_write_ir(path: string) {
    llvm.print_module_to_file(CG_MOD, path)
}

export fn codegen_emit_object(path: string) -> bool {
    let result = llvm.emit_object_file(CG_MOD, path)
    result == 0
}

export fn codegen_cleanup() {
    // codegen cleaned up
    cg_cleanup()
}

fn cg_init_ctx(name: string) {
    CG_CTX = llvm.context_create()
    if CG_CTX == null {
        eprintln("FATAL: LLVM context_create returned null!")
        process.exit(1)
    }
    CG_MOD = llvm.module_create(name, CG_CTX)
    CG_B = llvm.create_builder(CG_CTX)
}

fn cg_init_int_types() {
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
}

// Re-init ALL type globals (list pushes corrupt globals in bootstrap compiler)
export fn cg_reinit_types() {
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
    CG_VOID = llvm.void_type(CG_CTX)
    CG_PTR = llvm.pointer_type(CG_CTX)
    CG_F64 = llvm.double_type(CG_CTX)
    CG_STR = llvm.get_type_by_name(CG_CTX, "ForgeString")
    CG_LIST = CG_STR
}

fn cg_init_other_types() {
    CG_VOID = llvm.void_type(CG_CTX)
    CG_PTR = llvm.pointer_type(CG_CTX)
    CG_F64 = llvm.double_type(CG_CTX)
}

fn cg_init_str() {
    // Named type %ForgeString = { ptr, i64 } — matches bootstrap's layout
    CG_STR = llvm.struct_create_named(CG_CTX, "ForgeString")
    let sf = llvm.type_array_new(2)
    llvm.type_array_set(sf, 0, CG_PTR)
    llvm.type_array_set(sf, 1, CG_I64)
    llvm.struct_set_body(CG_STR, sf, 2, 0)
    llvm.type_array_free(sf)
}

fn cg_register_core_types() {
    // Register core struct types as LLVM named types.
    // Uses LLVM's own type registry (get_type_by_name) — no global list pushes.
    // Layouts match the Rust compiler's output exactly.
    // Span = { i64, i64, i64, i64 }
    let s4 = llvm.type_array_new(4)
    llvm.type_array_set(s4, 0, CG_I64)
    llvm.type_array_set(s4, 1, CG_I64)
    llvm.type_array_set(s4, 2, CG_I64)
    llvm.type_array_set(s4, 3, CG_I64)
    let span_ty = llvm.struct_create_named(CG_CTX, "Span")
    llvm.struct_set_body(span_ty, s4, 4, 0)
    llvm.type_array_free(s4)
    // TokenKind = { i8, ptr } (all enums use this layout)
    let e2 = llvm.type_array_new(2)
    llvm.type_array_set(e2, 0, CG_I8)
    llvm.type_array_set(e2, 1, CG_PTR)
    let tk_ty = llvm.struct_create_named(CG_CTX, "TokenKind")
    llvm.struct_set_body(tk_ty, e2, 2, 0)
    // Reuse same layout for all enums
    let binop_ty = llvm.struct_create_named(CG_CTX, "BinOp")
    llvm.struct_set_body(binop_ty, e2, 2, 0)
    let unaryop_ty = llvm.struct_create_named(CG_CTX, "UnaryOp")
    llvm.struct_set_body(unaryop_ty, e2, 2, 0)
    let expr_ty = llvm.struct_create_named(CG_CTX, "Expr")
    llvm.struct_set_body(expr_ty, e2, 2, 0)
    let stmt_ty = llvm.struct_create_named(CG_CTX, "Statement")
    llvm.struct_set_body(stmt_ty, e2, 2, 0)
    let type_ty = llvm.struct_create_named(CG_CTX, "Type")
    llvm.struct_set_body(type_ty, e2, 2, 0)
    let sev_ty = llvm.struct_create_named(CG_CTX, "Severity")
    llvm.struct_set_body(sev_ty, e2, 2, 0)
    let texp_ty = llvm.struct_create_named(CG_CTX, "TypeExpr")
    llvm.struct_set_body(texp_ty, e2, 2, 0)
    let vk_ty = llvm.struct_create_named(CG_CTX, "VarKind")
    llvm.struct_set_body(vk_ty, e2, 2, 0)
    let pat_ty = llvm.struct_create_named(CG_CTX, "Pattern")
    llvm.struct_set_body(pat_ty, e2, 2, 0)
    llvm.type_array_free(e2)
    // Token = { %TokenKind, %Span, %ForgeString, i64 }
    let t4 = llvm.type_array_new(4)
    llvm.type_array_set(t4, 0, tk_ty)
    llvm.type_array_set(t4, 1, span_ty)
    llvm.type_array_set(t4, 2, CG_STR)
    llvm.type_array_set(t4, 3, CG_I64)
    let token_ty = llvm.struct_create_named(CG_CTX, "Token")
    llvm.struct_set_body(token_ty, t4, 4, 0)
    llvm.type_array_free(t4)
    // Block = { {ptr, i64}, %Span }
    let b2 = llvm.type_array_new(2)
    llvm.type_array_set(b2, 0, CG_STR)
    llvm.type_array_set(b2, 1, span_ty)
    let block_ty = llvm.struct_create_named(CG_CTX, "Block")
    llvm.struct_set_body(block_ty, b2, 2, 0)
    llvm.type_array_free(b2)
    // Program = { {ptr, i64} }
    let p1 = llvm.type_array_new(1)
    llvm.type_array_set(p1, 0, CG_STR)
    let prog_ty = llvm.struct_create_named(CG_CTX, "Program")
    llvm.struct_set_body(prog_ty, p1, 1, 0)
    llvm.type_array_free(p1)
    // Parser = { {ptr,i64}, i64, {ptr,i64}, %ForgeString }
    let pa4 = llvm.type_array_new(4)
    llvm.type_array_set(pa4, 0, CG_STR)
    llvm.type_array_set(pa4, 1, CG_I64)
    llvm.type_array_set(pa4, 2, CG_STR)
    llvm.type_array_set(pa4, 3, CG_STR)
    let parser_ty = llvm.struct_create_named(CG_CTX, "Parser")
    llvm.struct_set_body(parser_ty, pa4, 4, 0)
    llvm.type_array_free(pa4)
    // Codegen = { ptr, ptr, ptr }
    let c3 = llvm.type_array_new(3)
    llvm.type_array_set(c3, 0, CG_PTR)
    llvm.type_array_set(c3, 1, CG_PTR)
    llvm.type_array_set(c3, 2, CG_PTR)
    let cg_ty = llvm.struct_create_named(CG_CTX, "Codegen")
    llvm.struct_set_body(cg_ty, c3, 3, 0)
    llvm.type_array_free(c3)
    // Param = { %ForgeString, ptr, ptr, %Span, i64 }
    let pm5 = llvm.type_array_new(5)
    llvm.type_array_set(pm5, 0, CG_STR)
    llvm.type_array_set(pm5, 1, CG_PTR)
    llvm.type_array_set(pm5, 2, CG_PTR)
    llvm.type_array_set(pm5, 3, span_ty)
    llvm.type_array_set(pm5, 4, CG_I64)
    let param_ty2 = llvm.struct_create_named(CG_CTX, "Param")
    llvm.struct_set_body(param_ty2, pm5, 5, 0)
    llvm.type_array_free(pm5)
    // NodeRef = { i64, %ForgeString, %ForgeString, %Span }
    let n4 = llvm.type_array_new(4)
    llvm.type_array_set(n4, 0, CG_I64)
    llvm.type_array_set(n4, 1, CG_STR)
    llvm.type_array_set(n4, 2, CG_STR)
    llvm.type_array_set(n4, 3, span_ty)
    let noderef_ty = llvm.struct_create_named(CG_CTX, "NodeRef")
    llvm.struct_set_body(noderef_ty, n4, 4, 0)
    llvm.type_array_free(n4)
    // FeatureStmt = { %NodeRef }, FeatureExpr = { %NodeRef }
    let f1 = llvm.type_array_new(1)
    llvm.type_array_set(f1, 0, noderef_ty)
    let fstmt_ty = llvm.struct_create_named(CG_CTX, "FeatureStmt")
    llvm.struct_set_body(fstmt_ty, f1, 1, 0)
    let fexpr_ty = llvm.struct_create_named(CG_CTX, "FeatureExpr")
    llvm.struct_set_body(fexpr_ty, f1, 1, 0)
    llvm.type_array_free(f1)
}

fn cg_init_runtime() {
    cg_reinit_types()
    // Core
    CG_RT_PRINTLN = llvm.add_function(CG_MOD, "forge_println_string", mft1(CG_VOID, CG_STR))
    CG_RT_I2S = llvm.add_function(CG_MOD, "forge_int_to_string", mft1(CG_STR, CG_I64))
    CG_RT_SNEW = llvm.add_function(CG_MOD, "forge_string_new", mft2(CG_STR, CG_PTR, CG_I64))
    // String operations
    CG_RT_SCONCAT = llvm.add_function(CG_MOD, "forge_string_concat", mft2(CG_STR, CG_STR, CG_STR))
    CG_RT_SCHARAT = llvm.add_function(CG_MOD, "forge_string_char_at", mft2(CG_STR, CG_STR, CG_I64))
    CG_RT_SLEN = llvm.add_function(CG_MOD, "forge_string_length", mft1(CG_I64, CG_STR))
    CG_RT_SEQ = llvm.add_function(CG_MOD, "forge_string_eq", mft2(CG_I8, CG_STR, CG_STR))
    CG_RT_SCMP = llvm.add_function(CG_MOD, "forge_string_compare", mft2(CG_I64, CG_STR, CG_STR))
    CG_RT_SSUBSTR = llvm.add_function(CG_MOD, "forge_string_substring", mft3(CG_STR, CG_STR, CG_I64, CG_I64))
    CG_RT_SINDEXOF = llvm.add_function(CG_MOD, "forge_string_index_of", mft2(CG_I64, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_c_index_of", mft2(CG_I64, CG_STR, CG_STR))
    // Memory
    CG_RT_ALLOC = llvm.add_function(CG_MOD, "forge_alloc", mft1(CG_PTR, CG_I64))
    CG_RT_MEMCPY = llvm.add_function(CG_MOD, "forge_memcpy", mft3(CG_VOID, CG_PTR, CG_PTR, CG_I64))
    // List type: {ptr, i64}
    let lf = llvm.type_array_new(2)
    llvm.type_array_set(lf, 0, CG_PTR)
    llvm.type_array_set(lf, 1, CG_I64)
    CG_LIST = llvm.struct_type(CG_CTX, lf, 2, 0)
    llvm.type_array_free(lf)
    // Map runtime functions (pointer-based: map is heap-allocated ptr)
    cg_reinit_types()
    CG_RT_MAP_NEW = llvm.add_function(CG_MOD, "forge_map_new", mft0(CG_PTR))
    CG_RT_MAP_HAS = llvm.add_function(CG_MOD, "forge_map_has", mft2(CG_I8, CG_PTR, CG_STR))
    CG_RT_MAP_GET = llvm.add_function(CG_MOD, "forge_map_get", mft2(CG_I64, CG_PTR, CG_STR))
    CG_RT_MAP_SET = llvm.add_function(CG_MOD, "forge_map_set", mft3(CG_VOID, CG_PTR, CG_STR, CG_I64))
    // Process/FS functions (self-hosted compiler support — selfhost_ prefix avoids package conflicts)
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_set_args", mft2(CG_VOID, CG_I32, CG_PTR))
    llvm.add_function(CG_MOD, "forge_selfhost_process_args", mft0(CG_STR))
    llvm.add_function(CG_MOD, "forge_selfhost_fs_read", mft1(CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_selfhost_process_exit", mft1(CG_VOID, CG_I64))
    llvm.add_function(CG_MOD, "forge_selfhost_process_run", mft2(CG_STR, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_eprintln_string", mft1(CG_VOID, CG_STR))
    // LLVM C API functions (used by the compiler itself when self-hosting)
    cg_reinit_types()
    // 0-arg → ptr
    llvm.add_function(CG_MOD, "forge_llvm_context_create", mft0(CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_void_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_double_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_pointer_type", mft1(CG_PTR, CG_PTR))
    // 1-arg
    llvm.add_function(CG_MOD, "forge_llvm_create_builder", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_dispose_builder", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_context_dispose", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_module_dispose", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_verify_module", mft1(CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_undef", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_type_of", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_type_kind", mft1(CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_allocated_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_global_get_value_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_insert_block", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_basic_block_parent", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_entry_basic_block", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_first_instruction", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_block_has_terminator", mft1(CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_ret_void", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_const_null", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_type_array_new", mft1(CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_type_array_free", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_value_array_new", mft1(CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_value_array_free", mft1(CG_VOID, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_param", mft2(CG_PTR, CG_PTR, CG_I64))
    // 2-arg
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_llvm_module_create", mft2(CG_PTR, CG_STR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int1_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int8_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int32_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_int64_type", mft1(CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_add_global", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_set_initializer", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_get_named_function", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_get_type_by_name", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_append_basic_block", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_position_at_end", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_position_before", mft2(CG_VOID, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_br", mft2(CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_ret", mft2(CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_alloca", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_store", mft3(CG_PTR, CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_print_module_to_file", mft2(CG_VOID, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_emit_object_file", mft2(CG_I64, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_const_string", mft3(CG_PTR, CG_PTR, CG_STR, CG_I64))
    // 3-arg
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_llvm_const_int", mft3(CG_PTR, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_const_real", mft2(CG_PTR, CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_build_load", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_add", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_sub", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_mul", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_sdiv", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_srem", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_and", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_or", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_xor", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_shl", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_ashr", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_cond_br", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_phi", mft3(CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_zext", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_trunc", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_inttoptr", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_add_incoming", mft3(CG_VOID, CG_PTR, CG_PTR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_extract_value", mft4(CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_insert_value", mft5(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_gep2", mft5(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_build_struct_gep", mft4(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_build_icmp", mft5(CG_PTR, CG_PTR, CG_I64, CG_PTR, CG_PTR, CG_STR))
    // Function types and calls
    cg_reinit_types()
    llvm.add_function(CG_MOD, "forge_llvm_function_type", mft4(CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_add_function", mft3(CG_PTR, CG_PTR, CG_STR, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_build_call", mft6(CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_type_array_set", mft3(CG_VOID, CG_PTR, CG_I64, CG_PTR))
    llvm.add_function(CG_MOD, "forge_llvm_value_array_set", mft3(CG_VOID, CG_PTR, CG_I64, CG_PTR))
    // Struct types
    llvm.add_function(CG_MOD, "forge_llvm_struct_type", mft4(CG_PTR, CG_PTR, CG_PTR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_llvm_struct_create_named", mft2(CG_PTR, CG_PTR, CG_STR))
    llvm.add_function(CG_MOD, "forge_llvm_struct_set_body", mft4(CG_VOID, CG_PTR, CG_PTR, CG_I64, CG_I64))
    // Token/parser C-side helpers
    llvm.add_function(CG_MOD, "forge_fn_store_add", mft2(CG_VOID, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_fn_store_count", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_store_get_name", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_fn_store_get_body", mft1(CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_set_token_list", mft1(CG_VOID, CG_STR))
    llvm.add_function(CG_MOD, "forge_token_list_len", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_parser_get_pos", mft0(CG_I64))
    llvm.add_function(CG_MOD, "forge_parser_set_pos", mft1(CG_VOID, CG_I64))
    llvm.add_function(CG_MOD, "forge_parser_advance_pos", mft0(CG_VOID))
    llvm.add_function(CG_MOD, "forge_peek_kind_id", mft1(CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_extract_body_source", mft3(CG_STR, CG_STR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_kind_id_for_keyword", mft1(CG_I64, CG_STR))
    llvm.add_function(CG_MOD, "forge_list_push", mft2(CG_STR, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_signal_handler", mft1(CG_VOID, CG_I64))
}

fn cg_cleanup() {
    llvm.dispose_builder(CG_B)
    llvm.module_dispose(CG_MOD)
    llvm.context_dispose(CG_CTX)
}

impl Codegen {
    fn init(self, name: string) { codegen_init(name) }
    fn verify(self) -> bool { llvm.verify_module(CG_MOD) == 0 }
    fn dispose(self) { codegen_cleanup() }
    fn write_ir(self, path: string) { codegen_write_ir(path) }

    // ─── Program ───────────────────────────────

    fn emit_program(self, program: Program) {
        // Single-pass: declare and emit each function
        // (FN_BODIES[i] data is only valid when accessed immediately)
        emit_all_fn_bodies(self)
    }

    // Direct codegen for fn main: create main() with the given body
    fn emit_main_fn(self, body: Block) {
        let params = llvm.type_array_new(0)
        let mt = llvm.function_type(CG_I32, params, 0, 0)
        llvm.type_array_free(params)
        let mf = llvm.add_function(CG_MOD, "main", mt)
        self.current_fn = mf
        let entry = llvm.append_basic_block(CG_CTX, mf, "en")
        llvm.position_at_end(CG_B, entry)
        self.emit_block(body)
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    }

    fn emit_statement(self, stmt: Statement) {
        match stmt {
            .Expr(expr) -> {
                self.emit_expr(expr)
            }
            .Assign(target, value, span) -> { self.emit_assign(target, value) }
            .Return(value, span) -> { self.emit_return(value) }
            .Let(name, value, span) -> { self.emit_let(name, value) }
            .If(cond, then_b, else_b, has_else, span) -> { self.emit_if_stmt(cond, then_b, else_b, has_else) }
            .While(cond, body, span) -> { self.emit_while_stmt(cond, body) }
            .For(var_name, iter, body, span) -> { self.emit_for_stmt(var_name, iter, body) }
            .Match(scrut, tags, binds, bodies, def, has_def, span) -> { self.emit_match_stmt(scrut, tags, binds, bodies, def, has_def) }
            .Break(span) -> {
                if WHILE_END_BB != null { llvm.build_br(CG_B, WHILE_END_BB) }
            }
            .Continue(span) -> {
                if WHILE_COND_BB != null { llvm.build_br(CG_B, WHILE_COND_BB) }
            }
            .Feature(fe) -> { self.dispatch_stmt(fe) }
        }
    }

    fn emit_let(self, name: string, value: Expr) {
        let val_type = self.expr_type_name(value)
        let val = self.emit_expr(value)
        let is_str = val_type == "string"
        let is_map = val_type == "map"
        mut var_type = Type.Int
        if is_str { var_type = Type.String }
        if is_map { var_type = Type.MapType(Type.String, Type.Int) }
        self.define_var(name, var_type, val)
        if is_map { CG_MAP_VAR_NAMES = CG_MAP_VAR_NAMES.push(name) }
        CG_HAS_LAST_VAL = 0
    }

    fn emit_if_stmt(self, cond: Expr, then_b: Block, else_b: Block, has_else: int) {
        let cond_val = self.emit_expr(cond)
        // Convert to i1: trunc only works i64→i1, not i1→i1
        // Check if already i1 by attempting trunc; if it returns null, value is already i1
        let trunc_result = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifc")
        mut cond_i1 = cond_val
        if trunc_result != null { cond_i1 = trunc_result }
        let fn_val = self.current_fn
        let then_bb = llvm.append_basic_block(CG_CTX, fn_val, "then")
        let else_bb = llvm.append_basic_block(CG_CTX, fn_val, "else")
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "merge")
        llvm.build_cond_br(CG_B, cond_i1, then_bb, else_bb)
        llvm.position_at_end(CG_B, then_bb)
        self.emit_block(then_b)
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, else_bb)
        if has_else == 1 { self.emit_block(else_b) }
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, merge_bb)
    }

    fn emit_while_stmt(self, cond: Expr, body: Block) {
        let fn_val = self.current_fn
        let cond_bb = llvm.append_basic_block(CG_CTX, fn_val, "wc")
        let body_bb = llvm.append_basic_block(CG_CTX, fn_val, "wb")
        let end_bb = llvm.append_basic_block(CG_CTX, fn_val, "we")
        let save_cond = WHILE_COND_BB
        let save_end = WHILE_END_BB
        WHILE_COND_BB = cond_bb
        WHILE_END_BB = end_bb
        llvm.build_br(CG_B, cond_bb)
        llvm.position_at_end(CG_B, cond_bb)
        let cval = self.emit_expr(cond)
        let trunc_w = llvm.build_trunc(CG_B, cval, llvm.int1_type(CG_CTX), "wci")
        mut ci1 = cval
        if trunc_w != null { ci1 = trunc_w }
        llvm.build_cond_br(CG_B, ci1, body_bb, end_bb)
        llvm.position_at_end(CG_B, body_bb)
        self.emit_block(body)
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, cond_bb) }
        llvm.position_at_end(CG_B, end_bb)
        WHILE_COND_BB = save_cond
        WHILE_END_BB = save_end
    }

    fn emit_for_stmt(self, var_name: string, iter: Expr, body: Block) {
        // Emit iterable
        let iter_type = self.expr_type_name(iter)
        let list_val = self.emit_expr(iter)
        mut list_is_str = 0
        if iter_type == "string" { list_is_str = 1 }
        // Get length: extract field 1 (for {ptr, i64} lists)
        let len_val = llvm.build_extract_value(CG_B, list_val, 1, "len")
        // Create counter
        let counter = llvm.build_alloca(CG_B, CG_I64, "fi")
        llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), counter)
        let fn_val = self.current_fn
        let cond_bb = llvm.append_basic_block(CG_CTX, fn_val, "fc")
        let body_bb = llvm.append_basic_block(CG_CTX, fn_val, "fb")
        let end_bb = llvm.append_basic_block(CG_CTX, fn_val, "fe")
        let save_cond = WHILE_COND_BB
        let save_end = WHILE_END_BB
        WHILE_COND_BB = cond_bb
        WHILE_END_BB = end_bb
        llvm.build_br(CG_B, cond_bb)
        llvm.position_at_end(CG_B, cond_bb)
        let idx = llvm.build_load(CG_B, CG_I64, counter, "idx")
        let cmp = llvm.build_icmp(CG_B, 38, idx, len_val, "fc")
        llvm.build_cond_br(CG_B, cmp, body_bb, end_bb)
        llvm.position_at_end(CG_B, body_bb)
        // Define loop var (just use counter as the element for now)
        self.define_var(var_name, Type.Int, idx)
        self.emit_block(body)
        // Increment
        let next = llvm.build_add(CG_B, llvm.build_load(CG_B, CG_I64, counter, "ci"), llvm.const_int(CG_I64, 1, 0), "inc")
        llvm.build_store(CG_B, next, counter)
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, cond_bb) }
        llvm.position_at_end(CG_B, end_bb)
        WHILE_COND_BB = save_cond
        WHILE_END_BB = save_end
    }

    fn emit_match_stmt(self, scrut: Expr, tags_csv: string, binds: string, bodies: List<Block>, def: Block, has_def: int) {
        let subj_raw = self.emit_expr(scrut)
        // Extract enum tag if scrutinee is a tagged union
        mut subj = subj_raw
        let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
        if tag_byte != null {
            subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
        }
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")
        // Parse tag CSV
        mut tag_list: List<int> = []
        mut tpos = 0
        mut tcur = ""
        while tpos < tags_csv.length {
            let ch = tags_csv[tpos]
            if ch == "," {
                tag_list = tag_list.push(int(tcur))
                tcur = ""
            } else {
                tcur = tcur + ch
            }
            tpos = tpos + 1
        }
        if tcur != "" { tag_list = tag_list.push(int(tcur)) }
        // Emit each arm as if-else chain
        mut ai = 0
        while ai < tag_list.length && ai < bodies.length {
            cg_reinit_types()
            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            let next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            let tag_val = llvm.const_int(CG_I64, tag_list[ai], 0)
            let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
            llvm.build_cond_br(CG_B, cmp, arm_bb, next_bb)
            llvm.position_at_end(CG_B, arm_bb)
            self.emit_block(bodies[ai])
            if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
            llvm.position_at_end(CG_B, next_bb)
            ai = ai + 1
        }
        // Default arm
        if has_def == 1 {
            self.emit_block(def)
        }
        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
        llvm.position_at_end(CG_B, merge_bb)
    }

    fn emit_return(self, value: Expr) {
        match value {
            .NullLit(span) -> {
                if CG_FN_RETURNS_NULLABLE == 1 {
                    llvm.build_ret(CG_B, make_null_value(CG_FN_NULLABLE_INNER_TY))
                } else {
                    llvm.build_ret_void(CG_B)
                }
            }
            _ -> { self.emit_ret_value(value) }
        }
    }

    fn emit_ret_value(self, value: Expr) {
        let ret_type = self.expr_type_name(value)
        let val = self.emit_expr(value)
        let is_nullable = ret_type == "nullable" || ret_type == "null"
        if CG_FN_RETURNS_NULLABLE == 1 && !is_nullable {
            llvm.build_ret(CG_B, wrap_nullable(CG_FN_NULLABLE_INNER_TY, val))
        } else {
            llvm.build_ret(CG_B, val)
        }
    }

    fn dispatch_stmt(self, fe: FeatureStmt) {
        dispatch_emit_stmt(self, fe.data)
    }

    fn dispatch_expr(self, fe: FeatureExpr) -> ptr {
        let result = dispatch_emit_expr(self, fe.data)
        if result != null { return result }
        llvm.const_int(CG_I64, 0, 0)
    }

    // ─── Expressions ───────────────────────────

    fn emit_expr(self, expr: Expr) -> ptr {
        EMIT_DEPTH = EMIT_DEPTH + 1
        if EMIT_DEPTH > 50 {
            EMIT_DEPTH = EMIT_DEPTH - 1
            return llvm.const_int(CG_I64, 0, 0)
        }
        let r = self.emit_expr_inner(expr)
        EMIT_DEPTH = EMIT_DEPTH - 1
        r
    }

    // Determine the type name of an expression WITHOUT emitting it
    fn expr_type_name(self, expr: Expr) -> string {
        match expr {
            .IntLit(_, _) -> { return "int" }
            .FloatLit(_, _) -> { return "float" }
            .StringLit(_, _) -> { return "string" }
            .BoolLit(_, _) -> { return "bool" }
            .NullLit(_) -> { return "null" }
            .Ident(name, _) -> {
                // Look up in CG_VAR_TYPES
                mut vi = CG_VAR_NAMES.length - 1
                while vi >= 0 {
                    if CG_VAR_NAMES[vi] == name {
                        if vi < CG_VAR_TYPES.length { return CG_VAR_TYPES[vi] }
                        return "int"
                    }
                    vi = vi - 1
                }
                return "int"
            }
            .Call(callee, _, _) -> {
                match callee {
                    .Ident(name, _) -> {
                        // Built-in casts
                        if name == "string" { return "string" }
                        if name == "int" { return "int" }
                        if name == "float" { return "float" }
                        if name == "bool" { return "bool" }
                        // Known runtime functions
                        if name == "forge_string_concat" { return "string" }
                        if name == "forge_string_substring" { return "string" }
                        if name == "forge_string_char_at" { return "string" }
                        if name == "forge_int_to_string" { return "string" }
                        if name == "forge_string_new" { return "string" }
                        if name == "forge_string_index_of" { return "int" }
                        if name == "forge_string_length" { return "int" }
                        if name == "forge_string_compare" { return "int" }
                        // User-defined functions
                        mut fi = 0
                        while fi < FN_NAMES.length {
                            if FN_NAMES[fi] == name {
                                if fi < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[fi] }
                                return "int"
                            }
                            fi = fi + 1
                        }
                    }
                    .MemberAccess(obj, method, _) -> {
                        // String methods
                        if method == "substring" { return "string" }
                        if method == "char_at" { return "string" }
                        if method == "index_of" { return "int" }
                        if method == "length" { return "int" }
                        // Namespace methods
                        mut obj_name = ""
                        match obj {
                            .Ident(n, _) -> { obj_name = n }
                            _ -> {}
                        }
                        // Known namespace.method return types
                        if obj_name == "process" && method == "args" { return "list:string" }
                        if obj_name == "process" && method == "run" { return "string" }
                        if obj_name == "fs" && method == "read" { return "string" }
                        // Try looking up mangled name in FN_NAMES
                        if obj_name != "" {
                            let direct = obj_name + "_" + method
                            mut di = 0
                            while di < FN_NAMES.length {
                                if FN_NAMES[di] == direct {
                                    if di < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[di] }
                                }
                                di = di + 1
                            }
                            let prefixed = "forge_" + obj_name + "_" + method
                            mut pi2 = 0
                            while pi2 < FN_NAMES.length {
                                if FN_NAMES[pi2] == prefixed {
                                    if pi2 < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[pi2] }
                                }
                                pi2 = pi2 + 1
                            }
                        }
                        // Resolve impl method return type
                        if obj_name != "" {
                            let st = var_struct_type(obj_name)
                            if st != "" {
                                let mname = st + "_" + method
                                mut mi = 0
                                while mi < FN_NAMES.length {
                                    if FN_NAMES[mi] == mname {
                                        if mi < FN_RETURN_TYPES.length { return FN_RETURN_TYPES[mi] }
                                    }
                                    mi = mi + 1
                                }
                            }
                        }
                    }
                    _ -> {}
                }
                return "int"
            }
            .Binary(l, op, r, _) -> {
                match op {
                    .Add -> {
                        // String + anything = string
                        let lt = self.expr_type_name(l)
                        let rt = self.expr_type_name(r)
                        if lt == "string" || rt == "string" { return "string" }
                        return "int"
                    }
                    .Eq -> { return "bool" }
                    .NotEq -> { return "bool" }
                    .Lt -> { return "bool" }
                    .LtEq -> { return "bool" }
                    .Gt -> { return "bool" }
                    .GtEq -> { return "bool" }
                    .And -> { return "bool" }
                    .Or -> { return "bool" }
                    _ -> { return "int" }
                }
            }
            .MemberAccess(obj, field, _) -> {
                if field == "length" { return "int" }
                return "int"
            }
            .Index(obj, _, _) -> {
                // Element type of list indexing
                let ot = self.expr_type_name(obj)
                if ot.length > 5 && ot.substring(0, 5) == "list:" {
                    return ot.substring(5, ot.length)
                }
                if ot == "string" { return "string" }
                return "int"
            }
            _ -> { return "int" }
        }
        "int"
    }

    fn emit_expr_inner(self, expr: Expr) -> ptr {
        match expr {
            .IntLit(value, span) -> { return llvm.const_int(CG_I64, value, 0) }
            .FloatLit(value, span) -> { return llvm.const_real(CG_F64, value) }
            .StringLit(value, span) -> { return self.emit_string(value) }
            .BoolLit(value, span) -> {
                if value { return llvm.const_int(CG_I64, 1, 0) }
                return llvm.const_int(CG_I64, 0, 0)
            }
            .NullLit(span) -> {
                if CG_FN_RETURNS_NULLABLE == 1 {
                    return make_null_value(CG_FN_NULLABLE_INNER_TY)
                }
                return llvm.const_null(CG_PTR)
            }
            .Ident(name, span) -> { return self.emit_ident(name) }
            .Binary(left, op, right, span) -> { return self.emit_binary(left, op, right) }
            .Unary(op, operand, span) -> {
                let val = self.emit_expr(operand)
                match op {
                    .Neg -> { return llvm.build_sub(CG_B, llvm.const_int(CG_I64, 0, 0), val, "neg") }
                    .Not -> {
                        let cmp = llvm.build_icmp(CG_B, 32, val, llvm.const_int(CG_I64, 0, 0), "not")
                        return llvm.build_zext(CG_B, cmp, llvm.int64_type(CG_CTX), "nx")
                    }
                    .BitNot -> { return llvm.build_xor(CG_B, val, llvm.const_int(CG_I64, -1, 1), "bn") }
                }
            }
            .Call(callee, args, span) -> { return self.emit_call(callee, args) }
            .MemberAccess(obj, field, span) -> { return self.emit_member_access(obj, field) }
            .Index(obj, idx, span) -> {
                // Check if object is a known list variable BEFORE emitting
                mut obj_var_name = ""
                match obj {
                    .Ident(n, s) -> { obj_var_name = n }
                    _ -> {}
                }
                mut is_known_list = is_list_var(obj_var_name)
                mut is_str_list = is_str_list_var(obj_var_name)
                let obj_type = self.expr_type_name(obj)
                let obj_val = self.emit_expr(obj)
                mut obj_is_str = 0
                mut obj_is_map = 0
                if obj_type == "string" { obj_is_str = 1 }
                if obj_type == "map" { obj_is_map = 1 }
                mut obj_is_list = 0
                if obj_type.length > 5 {
                    if obj_type.substring(0, 5) == "list:" { obj_is_list = 1 }
                }
                let idx_val = self.emit_expr(idx)
                cg_reinit_types()
                if obj_is_map == 1 {
                    // Map: forge_map_get(map_ptr, key) → i64
                    let ga = llvm.value_array_new(2)
                    llvm.value_array_set(ga, 0, obj_val)
                    llvm.value_array_set(ga, 1, idx_val)
                    let gt = llvm.type_array_new(2)
                    llvm.type_array_set(gt, 0, CG_PTR)
                    llvm.type_array_set(gt, 1, CG_STR)
                    let gf = llvm.function_type(CG_I64, gt, 2, 0)
                    llvm.type_array_free(gt)
                    let result = llvm.build_call(CG_B, gf, CG_RT_MAP_GET, ga, 2, "mg")
                    llvm.value_array_free(ga)
                    return result
                }
                // Default: use charAt for string indexing
                // Use GEP only for explicitly known list variables
                mut use_gep = is_known_list || is_str_list || obj_is_list == 1
                if !use_gep {
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, obj_val)
                    llvm.value_array_set(ca, 1, idx_val)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_I64)
                    let cf = llvm.function_type(CG_STR, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let result = llvm.build_call(CG_B, cf, CG_RT_SCHARAT, ca, 2, "ch")
                    llvm.value_array_free(ca)
                    return result
                }
                // List: extract data pointer, GEP to element, load
                cg_reinit_types()
                mut elem_ty = CG_I64
                // Use CG_STR for string list elements
                if is_str_list { elem_ty = CG_STR }
                // Also check if obj is string type
                if obj_var_name != "" && obj_is_str == 1 { elem_ty = CG_STR }
                let dp = llvm.build_extract_value(CG_B, obj_val, 0, "dp")
                if dp == null { return llvm.const_int(CG_I64, 0, 0) }
                // Ensure index is integer (might be ForgeString)
                mut safe_idx = idx_val
                let maybe_int = llvm.build_extract_value(CG_B, idx_val, 0, "ix")
                if maybe_int != null { safe_idx = maybe_int }
                let gi = llvm.value_array_new(1)
                llvm.value_array_set(gi, 0, safe_idx)
                let gp = llvm.build_gep2(CG_B, elem_ty, dp, gi, 1, "ep")
                llvm.value_array_free(gi)
                if gp == null { return llvm.const_int(CG_I64, 0, 0) }
                let ev = llvm.build_load(CG_B, elem_ty, gp, "ev")
                return ev
            }
            .Block(block) -> { return self.emit_block(block) }
            .Feature(fe) -> {
                return self.dispatch_expr(fe)
            }
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_if_from_globals(self) -> ptr {
        cg_reinit_types()
        let cv = self.emit_expr(CURRENT_IF_COND)
        let ci = llvm.build_trunc(CG_B, cv, llvm.int1_type(CG_CTX), "ic")
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let tb = llvm.append_basic_block(CG_CTX, fn_val, "th")
        let eb = llvm.append_basic_block(CG_CTX, fn_val, "el")
        let mb = llvm.append_basic_block(CG_CTX, fn_val, "mg")
        llvm.build_cond_br(CG_B, ci, tb, eb)
        llvm.position_at_end(CG_B, tb)
        let tv = self.emit_block(CURRENT_IF_THEN)
        let te = llvm.get_insert_block(CG_B)
        let tt = llvm.block_has_terminator(CG_B)
        if !tt { llvm.build_br(CG_B, mb) }
        llvm.position_at_end(CG_B, eb)
        mut ev = llvm.const_int(CG_I64, 0, 0)
        if CURRENT_IF_HAS_ELSE { ev = self.emit_block(CURRENT_IF_ELSE) }
        let ee = llvm.get_insert_block(CG_B)
        let et = llvm.block_has_terminator(CG_B)
        if !et { llvm.build_br(CG_B, mb) }
        llvm.position_at_end(CG_B, mb)
        if CURRENT_IF_HAS_ELSE && !tt && !et {
            let phi = llvm.build_phi(CG_B, CG_I64, "iv")
            llvm.add_incoming(phi, tv, te)
            llvm.add_incoming(phi, ev, ee)
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_match_call(self, patterns: string, args: List<Expr>) -> ptr {
        if args.length < 2 { return llvm.const_int(CG_I64, 0, 0) }
        // args[0] = scrutinee, args[1..] = arm bodies
        let subj = self.emit_expr(args[0])
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")

        // Parse patterns CSV and create arm blocks
        mut arm_idx = 0
        mut pat_pos = 0
        mut phi_vals: List<ptr> = []
        mut phi_bbs: List<ptr> = []

        while arm_idx < args.length - 1 {
            // Extract next pattern name
            mut pat = ""
            while pat_pos < patterns.length {
                let ch = patterns[pat_pos]
                pat_pos = pat_pos + 1
                if ch == "," { break }
                pat = pat + ch
            }

            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            mut next_bb = merge_bb
            if arm_idx < args.length - 2 {
                next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            }

            if pat == "_" {
                // Wildcard — unconditional branch
                llvm.build_br(CG_B, arm_bb)
            } else {
                // Enum variant — compare tag to variant index
                let tag_val = llvm.const_int(CG_I64, match_enum_tag(pat), 0)
                // For struct-typed enums, extract tag first
                mut cmp_lhs = subj
                let scrut_type = self.expr_type_name(args[0])
                let scrut_is_enum = scrut_type.length > 5 && scrut_type.substring(0, 5) == "enum:"
                if scrut_is_enum {
                    let etag = llvm.build_extract_value(CG_B, subj, 0, "tg")
                    cmp_lhs = llvm.build_zext(CG_B, etag, CG_I64, "te")
                }
                let cmp = llvm.build_icmp(CG_B, 32, cmp_lhs, tag_val, "mc")
                llvm.build_cond_br(CG_B, cmp, arm_bb, next_bb)
            }

            llvm.position_at_end(CG_B, arm_bb)
            let arm_val = self.emit_expr(args[arm_idx + 1])
            let arm_end = llvm.get_insert_block(CG_B)
            if !llvm.block_has_terminator(CG_B) {
                llvm.build_br(CG_B, merge_bb)
            }
            phi_vals = phi_vals.push(arm_val)
            phi_bbs = phi_bbs.push(arm_end)

            if pat != "_" && arm_idx < args.length - 2 {
                llvm.position_at_end(CG_B, next_bb)
            }
            arm_idx = arm_idx + 1
        }

        llvm.position_at_end(CG_B, merge_bb)
        // Build PHI if multiple arms
        if phi_vals.length > 0 {
            let phi = llvm.build_phi(CG_B, CG_I64, "mv")
            mut pi = 0
            while pi < phi_vals.length {
                llvm.add_incoming(phi, phi_vals[pi], phi_bbs[pi])
                pi = pi + 1
            }
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_match_from_globals(self) -> ptr {
        let subj_raw = self.emit_expr(MATCH_SCRUTINEE)
        // For enum scrutinees, extract the tag byte
        mut subj = subj_raw
        // Try extract_value to get tag — returns null if not aggregate
        let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
        if tag_byte != null {
            subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
        }
        let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
        let merge_bb = llvm.append_basic_block(CG_CTX, fn_val, "me")
        // Parse tag CSV
        mut tags: List<int> = []
        mut tpos = 0
        mut tcur = ""
        while tpos < MATCH_ARM_TAGS.length {
            let ch = MATCH_ARM_TAGS[tpos]
            if ch == "," {
                tags = tags.push(int(tcur))
                tcur = ""
            } else {
                tcur = tcur + ch
            }
            tpos = tpos + 1
        }
        if tcur != "" { tags = tags.push(int(tcur)) }
        // Emit each arm as if-else chain
        mut phi_vals: List<ptr> = []
        mut phi_bbs: List<ptr> = []
        let _bodies = MATCH_ARM_BODIES
        mut ai = 0
        while ai < tags.length {
            cg_reinit_types()
            let arm_bb = llvm.append_basic_block(CG_CTX, fn_val, "ma")
            let next_bb = llvm.append_basic_block(CG_CTX, fn_val, "mn")
            let tag_val = llvm.const_int(CG_I64, tags[ai], 0)
            let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
            llvm.build_cond_br(CG_B, cmp, arm_bb, next_bb)
            llvm.position_at_end(CG_B, arm_bb)
            let av = self.emit_block(_bodies[ai])
            let ae = llvm.get_insert_block(CG_B)
            if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
            phi_vals = phi_vals.push(av)
            phi_bbs = phi_bbs.push(ae)
            llvm.position_at_end(CG_B, next_bb)
            ai = ai + 1
        }
        // Default/fallthrough arm
        if MATCH_HAS_DEFAULT {
            let dv = self.emit_block(MATCH_DEFAULT)
            let de = llvm.get_insert_block(CG_B)
            if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
            phi_vals = phi_vals.push(dv)
            phi_bbs = phi_bbs.push(de)
        } else {
            // No default — add empty fallthrough for PHI completeness
            let def_val = llvm.const_int(CG_I64, 0, 0)
            phi_vals = phi_vals.push(def_val)
            phi_bbs = phi_bbs.push(llvm.get_insert_block(CG_B))
            llvm.build_br(CG_B, merge_bb)
        }
        llvm.position_at_end(CG_B, merge_bb)
        if phi_vals.length > 0 {
            let phi = llvm.build_phi(CG_B, CG_I64, "mv")
            mut pi = 0
            while pi < phi_vals.length {
                llvm.add_incoming(phi, phi_vals[pi], phi_bbs[pi])
                pi = pi + 1
            }
            return phi
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_struct_lit(self, struct_name: string, field_values: List<Expr>) -> ptr {
        // Find struct LLVM type via direct LLVM lookup (avoids corrupted list search)
        cg_reinit_types()
        mut struct_ty = llvm.get_type_by_name(CG_CTX, struct_name)
        // Also check old list for field info index
        mut si = CG_STRUCT_NAMES.length - 1
        if struct_ty == null {
            while si >= 0 {
                if CG_STRUCT_NAMES[si] == struct_name {
                    struct_ty = CG_STRUCT_TYPES[si]
                    break
                }
                si = si - 1
            }
        }
        if struct_ty == null { return llvm.const_int(CG_I64, 0, 0) }

        // Alloca + GEP stores
        let alloca = llvm.build_alloca(CG_B, struct_ty, "sl")
        llvm.build_store(CG_B, llvm.const_null(struct_ty), alloca)
        mut fi = 0
        let _fv = field_values
        for fexpr in _fv {
            let val = self.emit_expr(fexpr)
            let fp = llvm.build_struct_gep2(CG_B, struct_ty, alloca, fi, "sf")
            llvm.build_store(CG_B, val, fp)
            fi = fi + 1
        }
        // Load completed struct
        let sv = llvm.build_load(CG_B, struct_ty, alloca, "sv")
        // Register as struct var
        let tmp = "_s" + string(fi)
        CG_VAR_NAMES = CG_VAR_NAMES.push(tmp)
        CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
        CG_VAR_TYPES = CG_VAR_TYPES.push("struct:" + struct_name)
        CG_STRUCT_VAR_NAMES = CG_STRUCT_VAR_NAMES.push(tmp)
        CG_STRUCT_VAR_TYPES = CG_STRUCT_VAR_TYPES.push(struct_name)
        // Get field names for var
        mut field_names = ""
        if si >= 0 { field_names = CG_STRUCT_FIELDS[si] }
        CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push(field_names)
        sv
    }

    fn emit_assign(self, target: Expr, value: Expr) {
        // target should be an Ident — find alloca directly from CG_VAR_NAMES/PTRS
        match target {
            .Ident(name, span) -> {
                let val = self.emit_expr(value)
                // Search CG_VAR_NAMES for the alloca pointer
                mut vi = CG_VAR_NAMES.length - 1
                while vi >= 0 {
                    if CG_VAR_NAMES[vi] == name {
                        llvm.build_store(CG_B, val, CG_VAR_PTRS[vi])
                        return
                    }
                    vi = vi - 1
                }
            }
            .MemberAccess(obj, field, span) -> {
                // Struct field assignment: self.pos = val
                let val = self.emit_expr(value)
                mut obj_name = ""
                match obj {
                    .Ident(n, _) -> { obj_name = n }
                    _ -> {}
                }
                if obj_name != "" {
                    // Look up struct type via CSV (immune to list corruption)
                    mut struct_type_name = ""
                    let csv_needle = "," + obj_name + ":"
                    let csv_pos = CG_STRUCT_VAR_CSV.index_of(csv_needle)
                    if csv_pos >= 0 {
                        let after = CG_STRUCT_VAR_CSV.substring(csv_pos + csv_needle.length, CG_STRUCT_VAR_CSV.length)
                        let comma = after.index_of(",")
                        if comma >= 0 { struct_type_name = after.substring(0, comma) }
                    }
                    // Fallback to corrupted list
                    if struct_type_name == "" { struct_type_name = var_struct_type(obj_name) }
                    if struct_type_name != "" {
                        let fidx = struct_field_index(struct_type_name, field)
                        if fidx >= 0 {
                            mut vi = CG_VAR_NAMES.length - 1
                            while vi >= 0 {
                                if CG_VAR_NAMES[vi] == obj_name {
                                    cg_reinit_types()
                                    let struct_ty = llvm.get_type_by_name(CG_CTX, struct_type_name)
                                    if struct_ty != null {
                                        let fp = llvm.build_struct_gep2(CG_B, struct_ty, CG_VAR_PTRS[vi], fidx, "sf")
                                        if fp != null {
                                            llvm.build_store(CG_B, val, fp)
                                        }
                                    }
                                    return
                                }
                                vi = vi - 1
                            }
                        }
                    }
                }
            }
            .Index(obj, idx, s) -> {
                // Map index assignment: map[key] = value
                let map_val = self.emit_expr(obj)
                let key_val = self.emit_expr(idx)
                let rhs_val = self.emit_expr(value)
                let sa = llvm.value_array_new(3)
                llvm.value_array_set(sa, 0, map_val)
                llvm.value_array_set(sa, 1, key_val)
                llvm.value_array_set(sa, 2, rhs_val)
                let st = llvm.type_array_new(3)
                llvm.type_array_set(st, 0, CG_PTR)
                llvm.type_array_set(st, 1, CG_STR)
                llvm.type_array_set(st, 2, CG_I64)
                let sf = llvm.function_type(CG_VOID, st, 3, 0)
                llvm.type_array_free(st)
                llvm.build_call(CG_B, sf, CG_RT_MAP_SET, sa, 3, "")
                llvm.value_array_free(sa)
            }
            _ -> {}
        }
    }

    fn emit_if_from_block(self, block: Block) -> ptr {
        // block.statements[0] = marker, [1] = condition, [2] = then block
        // Bootstrap workaround: avoid match-as-expression for Expr (returns i64 instead of Expr).
        // Use match arms directly — destructured values used in-arm work correctly.
        let cond_stmt = block.statements[1]
        let then_stmt = block.statements[2]

        // Emit condition: match arm uses destructured Expr directly
        mut cond_val = llvm.const_int(CG_I64, 0, 0)
        match cond_stmt {
            .Expr(e) -> { cond_val = self.emit_expr(e) }
            _ -> {}
        }
        let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifc")

        let current_fn = self.current_fn
        if current_fn == null { return llvm.const_int(CG_I64, 0, 0) }

        let then_bb = llvm.append_basic_block(CG_CTX, current_fn!, "th")
        let merge_bb = llvm.append_basic_block(CG_CTX, current_fn!, "ic")

        llvm.build_cond_br(CG_B, cond_i1, then_bb, merge_bb)

        // Emit then block
        llvm.position_at_end(CG_B, then_bb)
        match then_stmt {
            .Expr(e) -> { self.emit_expr(e) }
            _ -> {}
        }
        llvm.build_br(CG_B, merge_bb)

        // Continue at merge
        llvm.position_at_end(CG_B, merge_bb)
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_if_inline(self) -> ptr {
        let cond_val = self.emit_expr(CURRENT_IF_COND)
        // Truncate to i1
        let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifc")

        let current_fn = self.current_fn
        if current_fn == null { return llvm.const_int(CG_I64, 0, 0) }

        let then_bb = llvm.append_basic_block(CG_CTX, current_fn!, "th")
        let merge_bb = llvm.append_basic_block(CG_CTX, current_fn!, "ic")

        // No else for now — simple if { ... }
        llvm.build_cond_br(CG_B, cond_i1, then_bb, merge_bb)

        llvm.position_at_end(CG_B, then_bb)
        self.emit_block(CURRENT_IF_THEN)
        // Only add br if block didn't already terminate (e.g., with return)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, merge_bb)
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_string_concat(self, lhs: ptr, lhs_is_str: int, rhs: ptr, rhs_is_str: int) -> ptr {
        // Auto-stringify non-string operands
        mut l = lhs
        mut r = rhs
        if lhs_is_str != 1 {
            let ca = llvm.value_array_new(1)
            llvm.value_array_set(ca, 0, lhs)
            let ft = mft1(CG_STR, CG_I64)
            l = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "l2s")
            llvm.value_array_free(ca)
        }
        if rhs_is_str != 1 {
            let ca = llvm.value_array_new(1)
            llvm.value_array_set(ca, 0, rhs)
            let ft = mft1(CG_STR, CG_I64)
            r = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "r2s")
            llvm.value_array_free(ca)
        }
        let ca = llvm.value_array_new(2)
        llvm.value_array_set(ca, 0, l)
        llvm.value_array_set(ca, 1, r)
        let ft = mft2(CG_STR, CG_STR, CG_STR)
        let result = llvm.build_call(CG_B, ft, CG_RT_SCONCAT, ca, 2, "cc")
        llvm.value_array_free(ca)
        result
    }

    fn emit_string(self, value: string) -> ptr {
        // Create string as a constant struct (position-independent, no builder call needed)
        // This prevents forward SSA references when strings are used in loop bodies
        llvm.const_string(CG_MOD, value, value.length)
    }

    fn emit_ident(self, name: string) -> ptr {
        // Search current function locals first (from END to scope start)
        // then globals (from scope start-1 to 0)
        mut vi = CG_VAR_NAMES.length - 1
        while vi >= CG_VAR_SCOPE_START {
            if CG_VAR_NAMES[vi] == name {
                cg_reinit_types()
                let alloca_ptr = CG_VAR_PTRS[vi]
                // Determine load type from CG_VAR_TYPES (primary source)
                mut load_ty = CG_I64
                if vi < CG_VAR_TYPES.length {
                    let vtype = CG_VAR_TYPES[vi]
                    if vtype == "string" {
                        load_ty = CG_STR
                    } else if vtype == "float" {
                        load_ty = CG_I64
                    } else if vtype == "map" {
                        load_ty = CG_PTR
                    } else if vtype.length > 5 {
                        if vtype.substring(0, 5) == "enum:" {
                            let ename = vtype.substring(5, vtype.length)
                            let ety = cg_get_enum_ty_for(ename)
                            if ety != null { load_ty = ety }
                        } else if vtype.substring(0, 7) == "struct:" {
                            let sname = vtype.substring(7, vtype.length)
                            mut sti = CG_STRUCT_NAMES.length - 1
                            while sti >= 0 {
                                if CG_STRUCT_NAMES[sti] == sname {
                                    let sty = CG_STRUCT_TYPES[sti]
                                    if sty != null { load_ty = sty }
                                    break
                                }
                                sti = sti - 1
                            }
                        } else if vtype.substring(0, 5) == "list:" {
                            load_ty = CG_STR
                        }
                    } else if vtype != "int" && vtype != "bool" && vtype != "ptr" {
                        // Unknown type name — try LLVM named type lookup
                        let resolved = resolve_type_to_llvm(vtype)
                        if resolved != null { load_ty = resolved }
                    }
                } else {
                    // Fallback: use LLVM's allocated type
                    let alloc_ty = llvm.get_allocated_type(alloca_ptr)
                    if alloc_ty != null { load_ty = alloc_ty }
                }
                // Legacy fallbacks for string vars
                mut si = CG_STR_VAR_NAMES.length - 1
                while si >= 0 {
                    if CG_STR_VAR_NAMES[si] == name {
                        cg_reinit_types()
                        load_ty = CG_STR
                        break
                    }
                    si = si - 1
                }
                // Check nullable
                if is_nullable_var(name) {
                    let inner_name = nullable_var_inner_type(name)
                    mut inner_ty = CG_I64
                    if inner_name == "string" { inner_ty = CG_STR }
                    load_ty = make_nullable_type(inner_ty)
                }
                // Check enum type
                cg_reinit_types()
                let vet = cg_var_enum_type(name)
                if vet != "" {
                    let ety = cg_get_enum_ty_for(vet)
                    if ety != null { load_ty = ety }
                }
                // Check struct type
                let struct_type_name = var_struct_type(name)
                if struct_type_name != "" {
                    mut sti = CG_STRUCT_NAMES.length - 1
                    while sti >= 0 {
                        if CG_STRUCT_NAMES[sti] == struct_type_name {
                            let sty = CG_STRUCT_TYPES[sti]
                            if sty != null { load_ty = sty }
                            break
                        }
                        sti = sti - 1
                    }
                }
                return llvm.build_load(CG_B, load_ty, alloca_ptr, name)
            }
            vi = vi - 1
        }
        // Search globals (indices 0 to CG_VAR_SCOPE_START-1)
        vi = CG_VAR_SCOPE_START - 1
        while vi >= 0 {
            if CG_VAR_NAMES[vi] == name {
                cg_reinit_types()
                // Check if this global is a string/list via CSV (immune to list corruption)
                let str_needle = "," + name + ","
                let is_str_global = CG_STR_GLOBALS_CSV.index_of(str_needle) >= 0
                mut load_ty = CG_I64
                if is_str_global { load_ty = CG_STR }
                if is_nullable_var(name) {
                    let inner_name = nullable_var_inner_type(name)
                    mut inner_ty2 = CG_I64
                    if inner_name == "string" { inner_ty2 = CG_STR }
                    load_ty = make_nullable_type(inner_ty2)
                }
                // Check enum type
                let g_vet = cg_var_enum_type(name)
                if g_vet != "" {
                    if CG_UNIVERSAL_ENUM_TY != null { load_ty = CG_UNIVERSAL_ENUM_TY }
                }
                let struct_type_name = var_struct_type(name)
                if struct_type_name != "" {
                    mut sti = CG_STRUCT_NAMES.length - 1
                    while sti >= 0 {
                        if CG_STRUCT_NAMES[sti] == struct_type_name {
                            let sty = CG_STRUCT_TYPES[sti]
                            if sty != null { load_ty = sty }
                            break
                        }
                        sti = sti - 1
                    }
                }
                return llvm.build_load(CG_B, load_ty, CG_VAR_PTRS[vi], name)
            }
            vi = vi - 1
        }
        // Try function lookup
        let fn_ref = llvm.get_named_function(CG_MOD, name)
        if fn_ref != null { return fn_ref }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_binary(self, left: Expr, op: BinOp, right: Expr) -> ptr {
        // Determine types BEFORE emitting (no global flag dependency)
        let left_type = self.expr_type_name(left)
        let right_type = self.expr_type_name(right)
        mut lhs_is_str = 0
        mut rhs_is_str = 0
        if left_type == "string" { lhs_is_str = 1 }
        if right_type == "string" { rhs_is_str = 1 }
        let lhs = self.emit_expr(left)
        let rhs = self.emit_expr(right)
        match op {
            .Add -> {
                if lhs_is_str == 1 && rhs_is_str == 1 {
                    return self.emit_string_concat(lhs, lhs_is_str, rhs, rhs_is_str)
                }
                // Rust build_add auto-detects remaining cases (struct + any → concat)
                return llvm.build_add(CG_B, lhs, rhs, "add")
            }
            .Sub -> { return llvm.build_sub(CG_B, lhs, rhs, "sub") }
            .Mul -> { return llvm.build_mul(CG_B, lhs, rhs, "mul") }
            .Div -> { return llvm.build_sdiv(CG_B, lhs, rhs, "div") }
            .Mod -> { return llvm.build_srem(CG_B, lhs, rhs, "mod") }
            .Eq -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    // String comparison: forge_string_compare(a, b) == 0
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp_result = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 32, cmp_result, llvm.const_int(CG_I64, 0, 0), "eq")
                }
                return llvm.build_icmp(CG_B, 32, lhs, rhs, "eq")
            }
            .NotEq -> {
                if lhs_is_str == 1 || rhs_is_str == 1 {
                    cg_reinit_types()
                    let ca = llvm.value_array_new(2)
                    llvm.value_array_set(ca, 0, lhs)
                    llvm.value_array_set(ca, 1, rhs)
                    let ct = llvm.type_array_new(2)
                    llvm.type_array_set(ct, 0, CG_STR)
                    llvm.type_array_set(ct, 1, CG_STR)
                    let cf = llvm.function_type(CG_I64, ct, 2, 0)
                    llvm.type_array_free(ct)
                    let cmp_result = llvm.build_call(CG_B, cf, CG_RT_SCMP, ca, 2, "sc")
                    llvm.value_array_free(ca)
                    return llvm.build_icmp(CG_B, 33, cmp_result, llvm.const_int(CG_I64, 0, 0), "ne")
                }
                return llvm.build_icmp(CG_B, 33, lhs, rhs, "ne")
            }
            .Lt -> { return llvm.build_icmp(CG_B, 40, lhs, rhs, "lt") }
            .LtEq -> { return llvm.build_icmp(CG_B, 41, lhs, rhs, "le") }
            .Gt -> { return llvm.build_icmp(CG_B, 38, lhs, rhs, "gt") }
            .GtEq -> { return llvm.build_icmp(CG_B, 39, lhs, rhs, "ge") }
            .BitAnd -> { return llvm.build_and(CG_B, lhs, rhs, "ba") }
            .BitOr -> { return llvm.build_or(CG_B, lhs, rhs, "bo") }
            .BitXor -> { return llvm.build_xor(CG_B, lhs, rhs, "bx") }
            .Shl -> { return llvm.build_shl(CG_B, lhs, rhs, "sl") }
            .Shr -> { return llvm.build_ashr(CG_B, lhs, rhs, "sr") }
            .And -> {
                // Ensure both operands are i64 (icmp returns i1, needs zext)
                let lz = llvm.build_zext(CG_B, lhs, CG_I64, "al")
                let rz = llvm.build_zext(CG_B, rhs, CG_I64, "ar")
                mut al = lhs
                mut ar = rhs
                if lz != null { al = lz }
                if rz != null { ar = rz }
                return llvm.build_and(CG_B, al, ar, "and")
            }
            .Or -> {
                let lz = llvm.build_zext(CG_B, lhs, CG_I64, "ol")
                let rz = llvm.build_zext(CG_B, rhs, CG_I64, "or")
                mut ol = lhs
                mut or2 = rhs
                if lz != null { ol = lz }
                if rz != null { or2 = rz }
                return llvm.build_or(CG_B, ol, or2, "or")
            }
            .Pipe -> { return rhs }
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_call(self, callee: Expr, args: List<Expr>) -> ptr {
        match callee {
            .Ident(name, span) -> {
                if name == "println" { return self.emit_println(args) }
                if name == "print" { return self.emit_println(args) }
                if name == "eprintln" { return self.emit_println(args) }
                if name == "eprint" { return self.emit_println(args) }
                // Struct literal: __s_TypeName(field1, field2, ...)
                if name.length > 4 {
                    if name[0] == "_" {
                        if name[1] == "_" {
                            if name[2] == "s" {
                                if name[3] == "_" {
                                    let sn = name.substring(4, name.length)
                                    return self.emit_struct_lit(sn, args)
                                }
                            }
                        }
                    }
                }
                // Match expression: __m_pat1,pat2,...(scrutinee, body1, body2, ...)
                if name.length > 4 {
                    if name[0] == "_" && name[1] == "_" && name[2] == "m" && name[3] == "_" {
                        let patterns = name.substring(4, name.length)
                        return self.emit_match_call(patterns, args)
                    }
                }
                // Cast functions: string(x), int(x), float(x), bool(x)
                if name == "string" && args.length > 0 {
                    let val = self.emit_expr(args[0])
                    // Call forge_int_to_string(val) → ForgeString
                    let ca = llvm.value_array_new(1)
                    llvm.value_array_set(ca, 0, val)
                    let ft = mft1(CG_STR, CG_I64)
                    let result = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "i2s")
                    llvm.value_array_free(ca)
                    return result
                }
                // Look up function by name in the LLVM module (not Map — Map ptrs are corrupt)
                let fn_ref = llvm.get_named_function(CG_MOD, name)
                if fn_ref != null {
                    let call_result = self.emit_fn_call_direct(fn_ref, name, args)
                    CG_HAS_LAST_VAL = 0
                    return call_result
                }
            }
            .MemberAccess(o, f, s) -> {
                // Built-in method calls: obj.has(key), obj.push(val), etc.
                if f == "has" && args.length >= 1 {
                    let obj_val = self.emit_expr(o)
                    let key_val = self.emit_expr(args[0])
                    let ha = llvm.value_array_new(2)
                    llvm.value_array_set(ha, 0, obj_val)
                    llvm.value_array_set(ha, 1, key_val)
                    cg_reinit_types()
                    let hft = mft2(CG_I8, CG_PTR, CG_STR)
                    let hresult = llvm.build_call(CG_B, hft, CG_RT_MAP_HAS, ha, 2, "has")
                    llvm.value_array_free(ha)
                    return llvm.build_zext(CG_B, hresult, llvm.int64_type(CG_CTX), "hx")
                }

                // Namespace.method call: process.args(), fs.read(), llvm.build_add(), etc.
                mut ns = ""
                match o {
                    .Ident(n, _) -> { ns = n }
                    _ -> {}
                }
                if ns != "" {
                    // Build function name: namespace_method or forge_namespace_method
                    // Try: name as-is first (for llvm_* calls), then forge_ prefixed
                    let direct_name = ns + "_" + f
                    let fn_ref = llvm.get_named_function(CG_MOD, direct_name)
                    if fn_ref != null {
                        return self.emit_fn_call_direct(fn_ref, direct_name, args)
                    }
                    // Try forge_ prefix: process.args → forge_process_args
                    let prefixed = "forge_" + ns + "_" + f
                    let fn_ref2 = llvm.get_named_function(CG_MOD, prefixed)
                    if fn_ref2 != null {
                        return self.emit_fn_call_direct(fn_ref2, prefixed, args)
                    }
                    // Try forge_selfhost_ prefix: process.args → forge_selfhost_process_args
                    let selfhost = "forge_selfhost_" + ns + "_" + f
                    let fn_ref_sh = llvm.get_named_function(CG_MOD, selfhost)
                    if fn_ref_sh != null {
                        return self.emit_fn_call_direct(fn_ref_sh, selfhost, args)
                    }
                    // Try method call: Type__method (impl methods)
                    // Resolve the struct type name for the object variable
                    mut impl_ns = ns
                    let st = var_struct_type(ns)
                    if st != "" { impl_ns = st }
                    // Try method call: Type_method (single underscore, matches Rust convention)
                    let method_name = impl_ns + "_" + f
                    let fn_ref3 = llvm.get_named_function(CG_MOD, method_name)
                    if fn_ref3 != null {
                        // Prepend self (the object) as first arg
                        let obj_val = self.emit_ident(ns)
                        // Emit all args + obj_val as first param
                        cg_reinit_types()
                        let total_args = args.length + 1
                        let arg_arr = llvm.value_array_new(total_args)
                        llvm.value_array_set(arg_arr, 0, obj_val)
                        mut argi = 0
                        for arg in args {
                            llvm.value_array_set(arg_arr, argi + 1, self.emit_expr(arg))
                            argi = argi + 1
                        }
                        // Build function type with self as first param
                        let param_arr = llvm.type_array_new(total_args)
                        // Use the function's declared type
                        let fn_ty = llvm.global_get_value_type(fn_ref3)
                        let result = llvm.build_call(CG_B, fn_ty, fn_ref3, arg_arr, total_args, "mc")
                        llvm.value_array_free(arg_arr)
                        return result
                    }
                }
            }
            .Feature(fe) -> {}
            .Binary(l, o, r, s) -> {}
            .Unary(o, e, s) -> {}
            .Call(c, a, s) -> {}
            .IntLit(v, s) -> {}
            .FloatLit(v, s) -> {}
            .StringLit(v, s) -> {}
            .BoolLit(v, s) -> {}
            .NullLit(s) -> {}
            .Index(o, i, s) -> {}
            .Block(b) -> {}
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_fn_call_direct(self, fn_val: ptr, fn_name: string, args: List<Expr>) -> ptr {
        // Emit all argument values
        let arg_arr = llvm.value_array_new(args.length)
        mut i = 0
        for arg in args {
            llvm.value_array_set(arg_arr, i, self.emit_expr(arg))
            i = i + 1
        }

        // Use the function's actual LLVM type (works for both user and runtime fns)
        cg_reinit_types()
        let fn_ty = llvm.global_get_value_type(fn_val)
        let r = llvm.build_call(CG_B, fn_ty, fn_val, arg_arr, args.length, "call")
        llvm.value_array_free(arg_arr)

        r
    }

    fn is_string_var(self, name: string) -> bool {
        // Use dedicated name list (more reliable than parallel int list)
        mut si = CG_STR_VAR_NAMES.length - 1
        while si >= 0 {
            if CG_STR_VAR_NAMES[si] == name {
                return true
            }
            si = si - 1
        }
        false
    }

    fn emit_println(self, args: List<Expr>) -> ptr {
        for arg in args {
            // Check if arg is a string literal — pass ForgeString directly
            match arg {
                .StringLit(value, span) -> {
                    let str_val = self.emit_string(value)
                    self.emit_println_str(str_val)
                }
                .Ident(name, span) -> {
                    let val = self.emit_ident(name)
                    if self.is_string_var(name) {
                        self.emit_println_str(val)
                    } else {
                        self.emit_println_int(val)
                    }
                }
                _ -> {
                    let arg_type = self.expr_type_name(arg)
                    let val = self.emit_expr(arg)
                    if arg_type == "string" {
                        self.emit_println_str(val)
                    } else {
                        self.emit_println_int(val)
                    }
                }
            }
        }
        llvm.const_int(CG_I64, 0, 0)
    }

    fn emit_println_int(self, val: ptr) {
        // Convert int to string, then print
        let ca = llvm.value_array_new(1)
        llvm.value_array_set(ca, 0, val)
        let ft = mft1(CG_STR, CG_I64)
        let sv = llvm.build_call(CG_B, ft, CG_RT_I2S, ca, 1, "ts")
        llvm.value_array_free(ca)
        self.emit_println_str(sv)
    }

    fn emit_println_str(self, str_val: ptr) {
        // Print ForgeString directly
        let pa = llvm.value_array_new(1)
        llvm.value_array_set(pa, 0, str_val)
        let pft = mft1(CG_VOID, CG_STR)
        llvm.build_call(CG_B, pft, CG_RT_PRINTLN, pa, 1, "")
        llvm.value_array_free(pa)
    }

    fn emit_statement(self, stmt: Statement) -> ptr {
        match stmt {
            .Expr(expr) -> {
                if PENDING_IF {
                    PENDING_IF = false
                    return self.emit_if_from_globals()
                } else if PENDING_MATCH {
                    PENDING_MATCH = false
                    return self.emit_match_from_globals()
                } else {
                    return self.emit_expr(expr)
                }
            }
            .Assign(t, v, s) -> { self.emit_assign(t, v) }
            .Return(v, s) -> { self.emit_return(v) }
            .Let(name, val, s) -> {
                let val_type = self.expr_type_name(val)
                let ev = self.emit_expr(val)
                mut ty = Type.Int
                if val_type == "string" { ty = Type.String }
                // Lists use ForgeString alloca ({ptr, i64}) — must set BEFORE define_var
                if val_type.length > 5 && val_type.substring(0, 5) == "list:" {
                    ty = Type.String
                    CG_LIST_VAR_CSV = CG_LIST_VAR_CSV + "," + name + ","
                    CG_STR_LIST_VAR_CSV = CG_STR_LIST_VAR_CSV + "," + name + ","
                }
                self.define_var(name, ty, ev)
                if val_type == "string" || ty is .String {
                    CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(name)
                }
                // Check if val_type indicates a struct
                let is_struct_val = val_type.length > 7 && val_type.substring(0, 7) == "struct:"
                if is_struct_val {
                    let stype = val_type.substring(7, val_type.length)
                    CG_STRUCT_VAR_NAMES = CG_STRUCT_VAR_NAMES.push(name)
                    CG_STRUCT_VAR_TYPES = CG_STRUCT_VAR_TYPES.push(stype)
                    CG_STRUCT_VAR_CSV = CG_STRUCT_VAR_CSV + "," + name + ":" + stype + ","
                    mut fn_str = ""
                    mut fsi = CG_STRUCT_FIELDS.length - 1
                    while fsi >= 0 {
                        if CG_STRUCT_NAMES[fsi] == stype {
                            fn_str = CG_STRUCT_FIELDS[fsi]
                            break
                        }
                        fsi = fsi - 1
                    }
                    CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push(fn_str)
                }
            }
                .If(cond, then_body, else_body, has_else, s) -> {
                    cg_reinit_types()
                    let cv = self.emit_expr(cond)
                    let ci = llvm.build_trunc(CG_B, cv, llvm.int1_type(CG_CTX), "ic")
                    let ifn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let tb = llvm.append_basic_block(CG_CTX, ifn, "th")
                    let eb = llvm.append_basic_block(CG_CTX, ifn, "el")
                    let mb = llvm.append_basic_block(CG_CTX, ifn, "mg")
                    llvm.build_cond_br(CG_B, ci, tb, eb)
                    llvm.position_at_end(CG_B, tb)
                    self.emit_block(then_body)
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, mb) }
                    llvm.position_at_end(CG_B, eb)
                    if has_else == 1 { self.emit_block(else_body) }
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, mb) }
                    llvm.position_at_end(CG_B, mb)
                }
                .Match(scrutinee, arm_tags_csv, arm_bindings_csv, arm_bodies, default_body, has_default, s) -> {
                    cg_reinit_types()
                    let subj_raw = self.emit_expr(scrutinee)
                    // Try extracting tag from enum struct
                    mut subj = subj_raw
                    let tag_byte = llvm.build_extract_value(CG_B, subj_raw, 0, "tg")
                    if tag_byte != null {
                        subj = llvm.build_zext(CG_B, tag_byte, CG_I64, "te")
                    }
                    let mfn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let merge_bb = llvm.append_basic_block(CG_CTX, mfn, "me")
                    // Parse tag CSV
                    mut tags: List<int> = []
                    mut tpos = 0
                    mut tcur = ""
                    while tpos < arm_tags_csv.length {
                        let ch = arm_tags_csv[tpos]
                        if ch == "," {
                            tags = tags.push(int(tcur))
                            tcur = ""
                        } else {
                            tcur = tcur + ch
                        }
                        tpos = tpos + 1
                    }
                    if tcur != "" { tags = tags.push(int(tcur)) }
                    // Parse arm bindings (semicolon-separated groups, comma-separated names)
                    mut all_bindings: List<string> = []
                    mut bpos = 0
                    mut bcur = ""
                    while bpos < arm_bindings_csv.length {
                        let bch = arm_bindings_csv[bpos]
                        if bch == ";" {
                            all_bindings = all_bindings.push(bcur)
                            bcur = ""
                        } else {
                            bcur = bcur + bch
                        }
                        bpos = bpos + 1
                    }
                    if bcur != "" { all_bindings = all_bindings.push(bcur) }
                    // Pre-create allocas before match branches (current block)
                    // Format: "EnumType.Variant:name1,name2" — skip prefix before ':'
                    let pre_start_idx = CG_VAR_PTRS.length  // save index for direct access
                    mut pre_bi = 0
                    while pre_bi < all_bindings.length {
                        let pre_raw = all_bindings[pre_bi]
                        // Skip variant prefix (everything before ':')
                        mut pre_csv = pre_raw
                        let colon = pre_raw.index_of(":")
                        if colon >= 0 { pre_csv = pre_raw.substring(colon + 1, pre_raw.length) }
                        mut pre_pi = 0
                        mut pre_name = ""
                        while pre_pi < pre_csv.length {
                            let pc = pre_csv[pre_pi]
                            if pc == "," {
                                if pre_name != "_" && pre_name != "" {
                                    cg_reinit_types()
                                    let pre_alloca = llvm.build_alloca(CG_B, CG_STR, "mb")
                                    CG_VAR_NAMES = CG_VAR_NAMES.push(pre_name)
                                    CG_VAR_PTRS = CG_VAR_PTRS.push(pre_alloca)
                                    CG_VAR_TYPES = CG_VAR_TYPES.push("string")
                                }
                                pre_name = ""
                            } else {
                                pre_name = pre_name + pc
                            }
                            pre_pi = pre_pi + 1
                        }
                        if pre_name != "_" && pre_name != "" {
                            cg_reinit_types()
                            let pre_alloca = llvm.build_alloca(CG_B, CG_STR, "mb")
                            CG_VAR_NAMES = CG_VAR_NAMES.push(pre_name)
                            CG_VAR_PTRS = CG_VAR_PTRS.push(pre_alloca)
                            CG_VAR_TYPES = CG_VAR_TYPES.push("string")
                        }
                        pre_bi = pre_bi + 1
                    }
                    // Emit each arm as if-else chain
                    mut ai = 0
                    while ai < tags.length {
                        cg_reinit_types()
                        let arm_bb = llvm.append_basic_block(CG_CTX, mfn, "ma")
                        let next_bb = llvm.append_basic_block(CG_CTX, mfn, "mn")
                        let tag_val = llvm.const_int(CG_I64, tags[ai], 0)
                        let cmp = llvm.build_icmp(CG_B, 32, subj, tag_val, "mc")
                        llvm.build_cond_br(CG_B, cmp, arm_bb, next_bb)
                        llvm.position_at_end(CG_B, arm_bb)
                        // Save var scope for binding cleanup
                        let saved_var_len = CG_VAR_NAMES.length
                        // Extract bindings with field-type-aware slot offsets
                        if ai < all_bindings.length {
                            let raw_bind = all_bindings[ai]
                            // Parse "EnumType.Variant:name1,name2"
                            mut variant_qname = ""
                            mut names_part = raw_bind
                            let colon_pos = raw_bind.index_of(":")
                            if colon_pos >= 0 {
                                variant_qname = raw_bind.substring(0, colon_pos)
                                names_part = raw_bind.substring(colon_pos + 1, raw_bind.length)
                            }
                            // Look up field types (hardcoded for key enums — CSV globals corrupted)
                            mut field_types = ""
                            let dot_pos = variant_qname.index_of(".")
                            if dot_pos > 0 {
                                let ename = variant_qname.substring(0, dot_pos)
                                let vn2 = variant_qname.substring(dot_pos + 1, variant_qname.length)
                                // Try CSV first
                                field_types = cg_enum_variant_field_types(ename, vn2)
                                // Hardcoded fallback for common Expr/Statement variants
                                if field_types == "" {
                                    // Expr variants: most have (value/name: s, span: 4)
                                    if vn2 == "IntLit" { field_types = "i4" }
                                    if vn2 == "FloatLit" { field_types = "i4" }
                                    if vn2 == "StringLit" { field_types = "s4" }
                                    if vn2 == "BoolLit" { field_types = "i4" }
                                    if vn2 == "NullLit" { field_types = "4" }
                                    if vn2 == "Ident" { field_types = "s4" }
                                    // Statement variants
                                    if vn2 == "Expr" { field_types = "p" }
                                    if vn2 == "Assign" { field_types = "pp4" }
                                    if vn2 == "Return" { field_types = "p4" }
                                    if vn2 == "Let" { field_types = "sp4" }
                                }
                            }
                            mut field_idx = 0
                            mut binding_ptr_idx = 0  // index into pre-created allocas
                            mut bpi = 0
                            mut bpname = ""
                            while bpi <= names_part.length {
                                mut is_sep = bpi == names_part.length
                                if !is_sep { if names_part[bpi] == "," { is_sep = true } }
                                if is_sep {
                                    if bpname != "_" && bpname != "" {
                                        cg_reinit_types()
                                        let slot_off = cg_enum_field_slot_offset(field_types, field_idx)
                                        let slot = 1 + slot_off
                                        mut fcode = "i"
                                        if field_idx < field_types.length { fcode = field_types[field_idx] }
                                        let slots = field_type_slots(fcode)
                                        if slots >= 2 {
                                            // ForgeString/List: extract 2 slots, build struct
                                            let ev0 = llvm.build_extract_value(CG_B, subj_raw, slot, "b0")
                                            let ev1 = llvm.build_extract_value(CG_B, subj_raw, slot + 1, "b1")
                                            if ev0 != null {
                                                // Convert ev0 (i64) to ptr for ForgeString field 0
                                                let ev0_ptr = llvm.build_inttoptr(CG_B, ev0, CG_PTR, "sp")
                                                let fs = llvm.build_insert_value(CG_B, llvm.get_undef(CG_STR), ev0_ptr, 0, "fs")
                                                mut fsv = fs
                                                if ev1 != null { fsv = llvm.build_insert_value(CG_B, fs, ev1, 1, "fs") }
                                                let alloca_idx = pre_start_idx + binding_ptr_idx
                                                if alloca_idx < CG_VAR_PTRS.length {
                                                    llvm.build_store(CG_B, fsv, CG_VAR_PTRS[alloca_idx])
                                                    CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(bpname)
                                                }
                                                binding_ptr_idx = binding_ptr_idx + 1
                                            }
                                        } else if fcode == "p" {
                                            // Boxed pointer: extract ptr, load full value
                                            let ev = llvm.build_extract_value(CG_B, subj_raw, slot, "bp")
                                            if ev != null {
                                                cg_reinit_types()
                                                // Dereference: inttoptr → load %Expr
                                                let ptr_val = llvm.build_inttoptr(CG_B, ev, CG_PTR, "dp")
                                                let expr_ty = llvm.get_type_by_name(CG_CTX, "Expr")
                                                mut deref_val = ev
                                                if expr_ty != null && ptr_val != null {
                                                    let loaded = llvm.build_load(CG_B, expr_ty, ptr_val, "de")
                                                    if loaded != null { deref_val = loaded }
                                                }
                                                // Store the dereferenced full value
                                                let alloca_idx = pre_start_idx + binding_ptr_idx
                                                if alloca_idx < CG_VAR_PTRS.length {
                                                    // For boxed Expr: alloca needs to be Expr-sized
                                                    // But pre-alloca is CG_STR (16 bytes). Expr is larger.
                                                    // Create a new alloca of the right type
                                                    if expr_ty != null {
                                                        let big_alloca = llvm.build_alloca(CG_B, expr_ty, "bx")
                                                        llvm.build_store(CG_B, deref_val, big_alloca)
                                                        // Shadow with Expr-sized alloca + register as enum var
                                                        CG_VAR_NAMES = CG_VAR_NAMES.push(bpname)
                                                        CG_VAR_PTRS = CG_VAR_PTRS.push(big_alloca)
                                                        CG_VAR_TYPES = CG_VAR_TYPES.push("enum:Expr")
                                                        CG_ENUM_VAR_CSV = CG_ENUM_VAR_CSV + "," + bpname + ":Expr,"
                                                    } else {
                                                        llvm.build_store(CG_B, ev, CG_VAR_PTRS[alloca_idx])
                                                    }
                                                }
                                                binding_ptr_idx = binding_ptr_idx + 1
                                            }
                                        } else {
                                            // Single slot (int, bool, etc.)
                                            let ev = llvm.build_extract_value(CG_B, subj_raw, slot, "b")
                                            if ev != null {
                                                let alloca_idx = pre_start_idx + binding_ptr_idx
                                                if alloca_idx < CG_VAR_PTRS.length {
                                                    llvm.build_store(CG_B, ev, CG_VAR_PTRS[alloca_idx])
                                                }
                                                binding_ptr_idx = binding_ptr_idx + 1
                                            }
                                        }
                                    }
                                    field_idx = field_idx + 1
                                    bpname = ""
                                } else {
                                    bpname = bpname + names_part[bpi]
                                }
                                bpi = bpi + 1
                            }
                            // (Last binding handled by bpi <= names_part.length loop)
                        }
                        if ai < arm_bodies.length {
                            self.emit_block(arm_bodies[ai])
                        }
                        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
                        // Restore var scope (remove bindings from this arm)
                        // Truncate CG_VAR_NAMES/CG_VAR_PTRS back to saved length
                        // (bootstrap: can't truncate lists, but pushing same names in next arm is fine
                        //  because emit_ident searches from end — new arm's bindings shadow old ones)
                        llvm.position_at_end(CG_B, next_bb)
                        ai = ai + 1
                    }
                    // Default arm
                    if has_default == 1 {
                        self.emit_block(default_body)
                    }
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, merge_bb) }
                    llvm.position_at_end(CG_B, merge_bb)
                }
                .While(cond, body, s) -> {
                    let wfn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let w1 = llvm.append_basic_block(CG_CTX, wfn, "wc")
                    let w2 = llvm.append_basic_block(CG_CTX, wfn, "wb")
                    let w3 = llvm.append_basic_block(CG_CTX, wfn, "we")
                    llvm.build_br(CG_B, w1)
                    llvm.position_at_end(CG_B, w1)
                    let wv = self.emit_expr(cond)
                    let wi = llvm.build_trunc(CG_B, wv, llvm.int1_type(CG_CTX), "wt")
                    llvm.build_cond_br(CG_B, wi, w2, w3)
                    llvm.position_at_end(CG_B, w2)
                    self.emit_block(body)
                    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, w1) }
                    llvm.position_at_end(CG_B, w3)
                }
                .For(vn, iter, body, s) -> {
                    // Check if iterable is a known string list BEFORE emitting
                    mut iter_var_name = ""
                    match iter {
                        .Ident(n, _) -> { iter_var_name = n }
                        _ -> {}
                    }
                    // Determine element type BEFORE emitting (no global flag dependency)
                    let iter_ty2 = self.expr_type_name(iter)
                    // Determine element type from list_elem_type lookup
                    mut for_elem_type = ""
                    if iter_var_name != "" { for_elem_type = list_elem_type(iter_var_name) }
                    let fl = self.emit_expr(iter)
                    mut elem_llvm_ty = CG_I64
                    if for_elem_type != "" {
                        cg_reinit_types()
                        let resolved = resolve_type_to_llvm(for_elem_type)
                        if resolved != null { elem_llvm_ty = resolved }
                    }
                    // Use ForgeString elements when iterable type is string/list
                    if (iter_ty2 == "string" || iter_ty2.length > 5) && for_elem_type == "" {
                        if iter_ty2 == "string" {
                            cg_reinit_types()
                            elem_llvm_ty = CG_STR
                        }
                    }
                    let fa = llvm.build_alloca(CG_B, CG_I64, "fi")
                    llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), fa)
                    let fla = llvm.value_array_new(1)
                    llvm.value_array_set(fla, 0, fl)
                    let flt = llvm.type_array_new(1)
                    llvm.type_array_set(flt, 0, CG_STR)
                    let flf = llvm.function_type(CG_I64, flt, 1, 0)
                    llvm.type_array_free(flt)
                    let fln = llvm.build_call(CG_B, flf, CG_RT_SLEN, fla, 1, "ln")
                    llvm.value_array_free(fla)
                    let ffn = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
                    let f1 = llvm.append_basic_block(CG_CTX, ffn, "fc")
                    let f2 = llvm.append_basic_block(CG_CTX, ffn, "fb")
                    let f3 = llvm.append_basic_block(CG_CTX, ffn, "fx")
                    let f4 = llvm.append_basic_block(CG_CTX, ffn, "fe")
                    llvm.build_br(CG_B, f1)
                    llvm.position_at_end(CG_B, f1)
                    let fc = llvm.build_load(CG_B, CG_I64, fa, "ci")
                    let fx = llvm.build_icmp(CG_B, 40, fc, fln, "cc")
                    llvm.build_cond_br(CG_B, fx, f2, f4)
                    llvm.position_at_end(CG_B, f2)
                    let fd = llvm.build_extract_value(CG_B, fl, 0, "dp")
                    if fd == null {
                        // List value was not a struct — can't iterate. Skip to end.
                        // Create a dummy var for the loop body to reference
                        let fv = llvm.build_alloca(CG_B, CG_I64, "iv")
                        llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), fv)
                        CG_VAR_NAMES = CG_VAR_NAMES.push(vn)
                        CG_VAR_PTRS = CG_VAR_PTRS.push(fv)
                        CG_VAR_TYPES = CG_VAR_TYPES.push("int")
                        llvm.build_br(CG_B, f4)
                        llvm.position_at_end(CG_B, f3)
                        llvm.build_br(CG_B, f1)
                    } else {
                        let fb = llvm.build_load(CG_B, CG_I64, fa, "bi")
                        let fg = llvm.value_array_new(1)
                        llvm.value_array_set(fg, 0, fb)
                        let fp = llvm.build_gep2(CG_B, elem_llvm_ty, fd, fg, 1, "ep")
                        llvm.value_array_free(fg)
                        let fe = llvm.build_load(CG_B, elem_llvm_ty, fp, "ev")
                        let fv = llvm.build_alloca(CG_B, elem_llvm_ty, "iv")
                        llvm.build_store(CG_B, fe, fv)
                        CG_VAR_NAMES = CG_VAR_NAMES.push(vn)
                        CG_VAR_PTRS = CG_VAR_PTRS.push(fv)
                        mut loop_elem_type = "int"
                        if elem_llvm_ty == CG_STR { loop_elem_type = "string" }
                        CG_VAR_TYPES = CG_VAR_TYPES.push(loop_elem_type)
                        // Register string loop vars so emit_ident loads as ForgeString
                        if elem_llvm_ty == CG_STR {
                            CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(vn)
                        }
                        // Register enum loop var for match
                        if for_elem_type != "" {
                            let enum_needle = "," + for_elem_type + ":"
                            if CG_ENUM_TYPE_CSV.index_of(enum_needle) >= 0 {
                                CG_ENUM_VAR_CSV = CG_ENUM_VAR_CSV + "," + vn + ":" + for_elem_type + ","
                            }
                        }
                        self.emit_block(body)
                        if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, f3) }
                        llvm.position_at_end(CG_B, f3)
                        let fi = llvm.build_load(CG_B, CG_I64, fa, "ic")
                        let fn2 = llvm.build_add(CG_B, fi, llvm.const_int(CG_I64, 1, 0), "ni")
                        llvm.build_store(CG_B, fn2, fa)
                        llvm.build_br(CG_B, f1)
                    }
                    llvm.position_at_end(CG_B, f4)
                }
                .Break(s) -> {}
                .Continue(s) -> {}
                .Feature(fe) -> { self.dispatch_stmt(fe) }
            }
            llvm.const_int(CG_I64, 0, 0)
        }

    fn emit_block(self, block: Block) -> ptr {
        mut last = llvm.const_int(CG_I64, 0, 0)
        let _stmts = block.statements
        for stmt in _stmts {
            if llvm.block_has_terminator(CG_B) { break }
            last = self.emit_statement(stmt)
        }
        last
    }

    fn write_ir(self, path: string) -> bool {
        llvm.print_module_to_file(CG_MOD, path) == 0
    }

    // ─── Variable Definition ───────────────────

    fn define_var(self, name: string, ty: Type, value: ptr) {
        let is_str = ty is .String
        let is_map = ty is .MapType
        cg_reinit_types()
        // Determine alloca type from the LLVM value's type (most reliable source)
        mut alloca_ty = CG_I64
        if is_str {
            alloca_ty = CG_STR
            CG_STR_LOCALS_CSV = CG_STR_LOCALS_CSV + "," + name + ","
        }
        if is_map { alloca_ty = CG_PTR }
        if CG_B == null { return }
        if alloca_ty == 0 { return }
        // Create alloca in ENTRY block (ensures dominance across all basic blocks)
        let cur_bb = llvm.get_insert_block(CG_B)
        let fn_val = llvm.get_basic_block_parent(cur_bb)
        let entry_bb = llvm.get_entry_basic_block(fn_val)
        let first_instr = llvm.get_first_instruction(entry_bb)
        if first_instr != null {
            llvm.position_before(CG_B, first_instr)
        } else {
            llvm.position_at_end(CG_B, entry_bb)
        }
        let alloca = llvm.build_alloca(CG_B, alloca_ty, name)
        // Restore builder position and store value
        llvm.position_at_end(CG_B, cur_bb)
        llvm.build_store(CG_B, value, alloca)
        CG_VAR_NAMES = CG_VAR_NAMES.push(name)
        // Determine canonical type name from alloca type
        mut var_type_name = "int"
        if is_str { var_type_name = "string" }
        if is_map { var_type_name = "map" }
        // Detect type from alloca type when expr_type_name couldn't determine it
        if var_type_name == "int" && alloca_ty == CG_STR {
            var_type_name = "string"
        }
        if var_type_name == "int" && alloca_ty != CG_I64 {
            // Check enum cache
            mut ei = CG_ENUM_TYPE_CACHE_PTRS.length - 1
            while ei >= 0 {
                if CG_ENUM_TYPE_CACHE_PTRS[ei] == alloca_ty {
                    var_type_name = "enum:" + CG_ENUM_TYPE_CACHE_NAMES[ei]
                    break
                }
                ei = ei - 1
            }
            // Check struct types
            if var_type_name == "int" {
                mut si = CG_STRUCT_TYPES.length - 1
                while si >= 0 {
                    if CG_STRUCT_TYPES[si] == alloca_ty {
                        var_type_name = "struct:" + CG_STRUCT_NAMES[si]
                        break
                    }
                    si = si - 1
                }
            }
        }
        CG_VAR_TYPES = CG_VAR_TYPES.push(var_type_name)
        mut is_str_flag3 = 0
        if is_str { is_str_flag3 = 1 }
        CG_VAR_IS_STR = CG_VAR_IS_STR.push(is_str_flag3)
        mut is_map_flag2 = 0
        if is_map { is_map_flag2 = 1 }
        CG_VAR_IS_MAP = CG_VAR_IS_MAP.push(is_map_flag2)
        if is_str {
            CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(name)
        }
        CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
    }

    fn is_map_var(self, name: string) -> bool {
        // Search the dedicated map names list (more reliable than parallel int list)
        mut mi = CG_MAP_VAR_NAMES.length - 1
        while mi >= 0 {
            if CG_MAP_VAR_NAMES[mi] == name {
                return true
            }
            mi = mi - 1
        }
        false
    }

    fn emit_member_access(self, obj: Expr, field: string) -> ptr {
        // Handle obj.field: extract the variable name from obj, look up struct type, extract field
        mut var_name = ""
        match obj {
            .Ident(name, span) -> { var_name = name }
            _ -> { return llvm.const_int(CG_I64, 0, 0) }
        }
        if var_name == "" { return llvm.const_int(CG_I64, 0, 0) }

        // Enum constructor: Color.Green → tag value
        let tag = match_enum_tag(var_name + "." + field)
        if tag >= 0 {
            return llvm.const_int(CG_I64, tag, 0)
        }

        // Special case: .length property
        if field == "length" {
            let obj_val = self.emit_ident(var_name)
            // For lists: extract field 1 directly (it's the count)
            if is_list_var(var_name) || is_str_list_var(var_name) {
                return llvm.build_extract_value(CG_B, obj_val, 1, "len")
            }
            // For strings: call forge_string_length
            let ca = llvm.value_array_new(1)
            llvm.value_array_set(ca, 0, obj_val)
            let ft = mft1(CG_I64, CG_STR)
            let result = llvm.build_call(CG_B, ft, CG_RT_SLEN, ca, 1, "len")
            llvm.value_array_free(ca)
            return result
        }

        // Look up the variable's struct type
        let struct_type_name = var_struct_type(var_name)
        if struct_type_name == "" { return llvm.const_int(CG_I64, 0, 0) }

        // Find the field index in the struct's field list
        let fidx = struct_field_index(struct_type_name, field)
        if fidx < 0 { return llvm.const_int(CG_I64, 0, 0) }

        // Load the struct value and extract the field
        let obj_val = self.emit_ident(var_name)
        let field_val = llvm.build_extract_value(CG_B, obj_val, fidx, field)

        field_val
    }
}
