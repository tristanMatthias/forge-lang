// ─── Lexer ─────────────────────────────────────
// Tokenizes Forge source code into a stream of tokens.
// Ported from forgec-rust/lexer/lexer.rs (~1256 lines).

use core.token.{Token, TokenKind, Span, TemplatePart}
use core.error.{Diagnostic, error, E_SYNTAX, E_UNTERMINATED_STRING, E_UNTERMINATED_TEMPLATE, E_BAD_NUMBER}

// ─── Lexer State ───────────────────────────────

export type Lexer = {
    source: string,
    mut pos: int,
    mut line: int,
    mut col: int,
    pos_offset: int,
    mut diagnostics: List<Diagnostic>,
}

export fn lexer_new(source: string) -> Lexer {
    eprintln("  lexer_new src_len=" + string(source.length))
    let result = Lexer {
        source,
        pos: 0,
        line: 1,
        col: 1,
        pos_offset: 0,
        diagnostics: [],
    }
    eprintln("  lexer_new result.source? checking...")
    return result
}

export fn lexer_with_offset(source: string, pos_offset: int, line: int, col: int) -> Lexer {
    Lexer {
        source,
        pos: 0,
        line,
        col,
        pos_offset,
        diagnostics: [],
    }
}

// ─── Character Helpers ─────────────────────────

export fn string_to_chars(s: string) -> List<string> {
    let len = s.length
    mut result: List<string> = []
    mut i = 0
    while i < len {
        result = result.push(s[i])
        i = i + 1
    }
    result
}

export fn is_alpha(ch: string) -> bool {
    (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

export fn is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

export fn is_hex_digit(ch: string) -> bool {
    is_digit(ch) || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F")
}

export fn is_alnum(ch: string) -> bool {
    is_alpha(ch) || is_digit(ch)
}

export fn is_ident_start(ch: string) -> bool {
    is_alpha(ch) || ch == "$"
}

export fn is_ident_continue(ch: string) -> bool {
    is_alnum(ch) || ch == "$"
}

fn is_binary_digit(ch: string) -> bool {
    ch == "0" || ch == "1"
}

fn is_octal_digit(ch: string) -> bool {
    ch >= "0" && ch <= "7"
}

fn is_radix_digit(ch: string, radix: int) -> bool {
    if radix == 16 { return is_hex_digit(ch) }
    if radix == 2 { return is_binary_digit(ch) }
    if radix == 8 { return is_octal_digit(ch) }
    false
}

export fn is_whitespace_not_newline(ch: string) -> bool {
    // Note: removed \r check — bootstrap confuses "r" with "\r" in string comparison
    ch == " " || ch == "\t"
}

// ─── Lexer Methods ─────────────────────────────

impl Lexer {
    fn is_at_end(self) -> bool {
        self.pos >= self.source.length
    }

    fn peek(self) -> string? {
        if self.pos < self.source.length {
            self.source[self.pos]
        } else {
            null
        }
    }

    // Non-nullable peek — returns "" at end. Use in while conditions
    // to avoid force-unwrap codegen issues in && expressions.
    fn peek_ch(self) -> string {
        if self.pos < self.source.length {
            return self.source[self.pos]
        }
        return ""
    }

    fn peek_at(self, offset: int) -> string? {
        let idx = self.pos + offset
        if idx < self.source.length {
            self.source[idx]
        } else {
            null
        }
    }

    // Non-nullable peek_at (returns "" at end). Use instead of peek_at
    // to avoid bootstrap nullable comparison issues.
    fn peek_ch_at(self, offset: int) -> string {
        let idx = self.pos + offset
        if idx < self.source.length {
            return self.source[idx]
        }
        return ""
    }

    fn advance(self) -> string {
        if self.pos >= self.source.length { return "" }
        let ch = self.source[self.pos]
        self.pos = self.pos + 1
        if ch == "\n" {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
        ch
    }

    fn make_span(self, start_pos: int, start_line: int, start_col: int) -> Span {
        Span {
            start: start_pos + self.pos_offset,
            end: self.pos + self.pos_offset,
            line: start_line,
            col: start_col,
        }
    }

    fn current_span(self) -> Span {
        Span {
            start: self.pos + self.pos_offset,
            end: self.pos + self.pos_offset,
            line: self.line,
            col: self.col,
        }
    }

    fn add_error(self, code: string, message: string, span: Span) {
        self.diagnostics = self.diagnostics.push(error(code, message, span))
    }

    // ─── Whitespace & Comments ─────────────────

    fn skip_whitespace(self) {
        // No && in while condition (compiled output doesn't short-circuit)
        while self.pos < self.source.length {
            if !is_whitespace_not_newline(self.source[self.pos]) { return }
            self.advance()
        }
    }

    fn skip_comments(self) {
        // Skip // comments — use explicit returns to avoid if-branch merge bug
        if self.pos + 1 >= self.source.length { return }
        let c0 = self.source[self.pos]
        if c0 != "/" { return }
        let c1 = self.source[self.pos + 1]
        if c1 != "/" { return }
        // Got // — check for doc comment ///
        if self.pos + 2 < self.source.length {
            let c2 = self.source[self.pos + 2]
            if c2 == "/" {
                // Check for //// (regular comment, not doc)
                if self.pos + 3 < self.source.length {
                    let c3 = self.source[self.pos + 3]
                    if c3 != "/" { return }
                } else {
                    return
                }
            }
        }
        // Skip to end of line
        while self.pos < self.source.length {
            let lch = self.source[self.pos]
            if lch == "\n" { return }
            self.pos = self.pos + 1
            self.col = self.col + 1
        }
    }

    // ─── Main Tokenization ─────────────────────

    fn tokenize(self) -> List<Token> {
        mut tokens: List<Token> = []

        self.skip_whitespace()
        self.skip_comments()
        while !self.is_at_end() {
            let token = self.next_token()
            tokens = tokens.push(token)
            self.skip_whitespace()
            self.skip_comments()
        }

        // Add EOF (kind_id=99 for EOF detection)
        tokens = tokens.push(Token {
            kind: TokenKind.Eof,
            span: self.current_span(),
            text: "",
            kind_id: 99,
        })

        tokens
    }

    fn next_token(self) -> Token {
        let ch = self.peek_ch()
        let start_pos = self.pos
        let start_line = self.line
        let start_col = self.col

        // Newline
        if ch == "\n" {
            self.advance()
            return Token {
                kind: TokenKind.Newline,
                span: self.make_span(start_pos, start_line, start_col),
                text: "",
                kind_id: 120,
            }
        }

        // Doc comment: ///
        if ch == "/" && self.peek_at(1) == "/" && self.peek_at(2) == "/" {
            if self.peek_at(3) != "/" {
                return self.lex_doc_comment(start_pos, start_line, start_col)
            }
        }

        // Numbers
        if is_digit(ch) {
            return self.lex_number(start_pos, start_line, start_col)
        }

        // Identifiers and keywords
        if is_ident_start(ch) {
            // Skip $ handling for now (nullable peek_at checks are unreliable)
            if ch == "$" {
                // Just treat as identifier
                return self.lex_ident_or_keyword(start_pos, start_line, start_col)
            }
            return self.lex_ident_or_keyword(start_pos, start_line, start_col)
        }

        // String literals
        if ch == "\"" {
            self.advance() // consume opening "
            return self.lex_string(start_pos, start_line, start_col)
        }

        // Template literals
        if ch == "`" {
            self.advance() // consume opening `
            return self.lex_template(start_pos, start_line, start_col)
        }

        // Operators and punctuation
        self.lex_operator(start_pos, start_line, start_col)
    }

    // ─── Doc Comments ──────────────────────────

    fn lex_doc_comment(self, start_pos: int, start_line: int, start_col: int) -> Token {
        // Consume ///
        self.advance()
        self.advance()
        self.advance()

        // Skip one leading space if present
        if self.peek() == " " {
            self.advance()
        }

        // Collect until newline
        mut text = ""
        while !self.is_at_end() && self.peek_ch() != "\n" {
            text = text + self.advance()
        }

        Token {
            kind: TokenKind.DocComment(text),
            span: self.make_span(start_pos, start_line, start_col),
        }
    }

    // ─── Numbers ───────────────────────────────

    fn lex_number(self, start_pos: int, start_line: int, start_col: int) -> Token {
        // Check for base prefixes
        if self.peek_ch() == "0" && self.peek_at(1) != null {
            let next = self.peek_at(1)!
            if next == "x" || next == "X" {
                self.advance()
                self.advance()
                return self.lex_radix(start_pos, start_line, start_col, 16, "x")
            }
            if next == "b" || next == "B" {
                self.advance()
                self.advance()
                return self.lex_radix(start_pos, start_line, start_col, 2, "b")
            }
            if next == "o" || next == "O" {
                self.advance()
                self.advance()
                return self.lex_radix(start_pos, start_line, start_col, 8, "o")
            }
        }

        // Decimal number
        mut text = ""
        mut is_float = false

        // Integer part: consume digits and underscores
        while !self.is_at_end() {
            let ch = self.peek_ch()
            if is_digit(ch) {
                text = text + self.advance()
            } else if ch == "_" {
                self.advance() // skip underscores in numbers
            } else {
                break
            }
        }

        // Decimal point (only if followed by a digit, and not .. range)
        if !self.is_at_end() && self.peek_ch() == "." {
            if self.peek_at(1) != null && is_digit(self.peek_at(1)!) {
                // Make sure it's not .. (range operator)
                is_float = true
                text = text + self.advance() // consume .
                while !self.is_at_end() {
                    let ch = self.peek_ch()
                    if is_digit(ch) {
                        text = text + self.advance()
                    } else if ch == "_" {
                        self.advance()
                    } else {
                        break
                    }
                }
            }
        }

        let span = self.make_span(start_pos, start_line, start_col)

        if is_float {
            let value = parse_float(text)
            return token_float(value, span)
        }

        // Parse integer
        let value = parse_int(text)

        // Check for duration suffixes: d, h, m, s
        if !self.is_at_end() {
            let ch = self.peek_ch()
            if ch == "d" || ch == "h" || ch == "m" || ch == "s" {
                // Ensure next char is NOT alphanumeric (prevent 5min -> 5m + in)
                let next_next = self.peek_at(1)
                if next_next == null || (!is_alnum(next_next!) && next_next! != "_") {
                    let suffix = self.advance()
                    let multiplier = match suffix {
                        "d" -> 86400000
                        "h" -> 3600000
                        "m" -> 60000
                        "s" -> 1000
                        _ -> 1
                    }
                    return token_int(value * multiplier, self.make_span(start_pos, start_line, start_col))
                }
            }
        }

        token_int(value, span)
    }

    fn lex_radix(self, start_pos: int, start_line: int, start_col: int, radix: int, prefix: string) -> Token {
        mut text = ""
        while !self.is_at_end() {
            let ch = self.peek_ch()
            let valid = is_radix_digit(ch, radix)
            if valid {
                text = text + self.advance()
            } else if ch == "_" {
                self.advance()
            } else {
                break
            }
        }
        if text.length == 0 {
            let span = self.make_span(start_pos, start_line, start_col)
            self.add_error("F0006", "expected digits after prefix", span)
            return token_int(0, span)
        }
        token_int(parse_int_radix(text, radix), self.make_span(start_pos, start_line, start_col))
    }

    // ─── Strings ───────────────────────────────

    // Generic string/template lexer. All 4 variants (string, template,
    // dollar string, dollar template) share this core loop.
    // - close_ch: closing delimiter ("\"" or "`")
    // - escapes: "full" (all \n\t etc), "limited" (only \\ and close), "none"
    // - is_dollar: true for $"/$` variants (DollarString token kind)
    // - is_template: true for `/`` variants (always TemplateLiteral)
    fn lex_string_generic(self, start_pos: int, start_line: int, start_col: int,
                          close_ch: string, escapes: string, is_dollar: bool, is_template: bool) -> Token {
        mut text = ""
        mut raw_text = ""  // full source text for template codegen
        mut parts: List<TemplatePart> = []
        mut has_interpolation = is_template

        while !self.is_at_end() {
            let ch = self.peek_ch()

            // Closing delimiter
            if ch == close_ch {
                self.advance()
                if text.length > 0 {
                    parts = parts.push(TemplatePart.Literal(text))
                }
                let span = self.make_span(start_pos, start_line, start_col)
                if is_dollar {
                    return Token { kind: TokenKind.DollarString(parts), span }
                }
                if has_interpolation {
                    return Token { kind: TokenKind.TemplateLiteral(parts), span, text: raw_text, kind_id: 6 }
                }
                return token_string(text, span)
            }

            // Escape handling
            if ch == "\\" && escapes != "none" {
                if escapes == "full" {
                    self.advance()
                    if !self.is_at_end() {
                        let escaped = self.advance()
                        match escaped {
                            "n" -> { text = text + "\n" }
                            "t" -> { text = text + "\t" }
                            "\\" -> { text = text + "\\" }
                            "$" -> { text = text + "$" }
                            _ -> {
                                // Also handle close_ch as escape target
                                if escaped == close_ch {
                                    text = text + close_ch
                                } else {
                                    text = text + escaped
                                }
                            }
                        }
                    }
                    continue
                }
                if escapes == "limited" {
                    // Only \close and \\ are escapes
                    if self.peek_at(1) == close_ch {
                        self.advance()
                        text = text + self.advance()
                        continue
                    }
                    if self.peek_at(1) == "\\" {
                        self.advance()
                        text = text + self.advance()
                        continue
                    }
                }
            }

            // Interpolation: ${...}
            if ch == "$" && self.peek_ch_at(1) == "{" {
                has_interpolation = true
                if text.length > 0 {
                    parts = parts.push(TemplatePart.Literal(text))
                    text = ""
                }
                self.advance()
                self.advance()
                let expr_span = self.current_span()
                let expr_text = self.capture_interpolation_expr()
                // Use \x24 instead of $ to avoid bootstrap template processing
                let dollar = "$"
                raw_text = raw_text + dollar + "{" + expr_text + "}"
                parts = parts.push(TemplatePart.Expr(expr_text, expr_span))
                continue
            }

            let adv = self.advance()
            text = text + adv
            raw_text = raw_text + adv
        }

        // Unterminated
        let span = self.make_span(start_pos, start_line, start_col)
        mut err_code = E_UNTERMINATED_TEMPLATE
        if close_ch == "\"" { err_code = E_UNTERMINATED_STRING }
        self.add_error("F0002", "unterminated string literal", span)
        if text.length > 0 {
            parts = parts.push(TemplatePart.Literal(text))
        }
        if is_dollar { return Token { kind: TokenKind.DollarString(parts), span } }
        if has_interpolation { return Token { kind: TokenKind.TemplateLiteral(parts), span } }
        token_string(text, span)
    }

    fn lex_string(self, sp: int, sl: int, sc: int) -> Token {
        self.lex_string_generic(sp, sl, sc, "\"", "full", false, false)
    }

    fn lex_template(self, sp: int, sl: int, sc: int) -> Token {
        self.lex_string_generic(sp, sl, sc, "`", "full", false, true)
    }

    fn lex_dollar_string(self, sp: int, sl: int, sc: int) -> Token {
        self.lex_string_generic(sp, sl, sc, "\"", "limited", true, false)
    }

    fn lex_dollar_template(self, sp: int, sl: int, sc: int) -> Token {
        self.lex_string_generic(sp, sl, sc, "`", "none", true, false)
    }

    // ─── Interpolation Capture ─────────────────

    fn capture_interpolation_expr(self) -> string {
        // Capture everything between ${ and matching }
        // Track brace depth, skip nested strings/templates
        mut depth = 1
        mut text = ""

        while !self.is_at_end() && depth > 0 {
            let ch = self.peek_ch()

            if ch == "{" {
                depth = depth + 1
                text = text + self.advance()
                continue
            }

            if ch == "}" {
                depth = depth - 1
                if depth == 0 {
                    self.advance() // consume closing }
                    return text
                }
                text = text + self.advance()
                continue
            }

            // Skip nested strings
            if ch == "\"" {
                text = text + self.advance() // opening "
                while !self.is_at_end() && self.peek_ch() != "\"" {
                    if self.peek_ch() == "\\" {
                        text = text + self.advance() // backslash
                        if !self.is_at_end() {
                            text = text + self.advance() // escaped char
                        }
                    } else {
                        text = text + self.advance()
                    }
                }
                if !self.is_at_end() {
                    text = text + self.advance() // closing "
                }
                continue
            }

            // Skip nested templates
            if ch == "`" {
                text = text + self.advance() // opening `
                while !self.is_at_end() && self.peek_ch() != "`" {
                    if self.peek_ch() == "\\" {
                        text = text + self.advance()
                        if !self.is_at_end() {
                            text = text + self.advance()
                        }
                    } else if self.peek_ch() == "$" && self.peek_at(1) == "{" {
                        text = text + self.advance() // $
                        text = text + self.advance() // {
                        depth = depth + 1
                    } else {
                        text = text + self.advance()
                    }
                }
                if !self.is_at_end() {
                    text = text + self.advance() // closing `
                }
                continue
            }

            text = text + self.advance()
        }

        text
    }

    // ─── Identifiers & Keywords ────────────────

    fn lex_ident_or_keyword(self, start_pos: int, start_line: int, start_col: int) -> Token {
        mut text = ""
        text = text + self.advance() // first char

        while !self.is_at_end() && is_ident_continue(self.peek_ch()) {
            text = text + self.advance()
        }

        let span = self.make_span(start_pos, start_line, start_col)

        // Check for tagged template: ident immediately followed by `
        // (only if not a keyword)
        let kind = keyword_kind(text)
        if kind == null && !self.is_at_end() && self.peek_ch() == "`" {
            self.advance() // consume `
            return self.lex_tagged_template(text, start_pos, start_line, start_col)
        }

        // Check for typed tagged template: ident<Type>`
        if kind == null && !self.is_at_end() && self.peek_ch() == "<" {
            let typed_tag = self.try_typed_tagged_template(text, start_pos, start_line, start_col)
            if typed_tag.kind is not .Eof {
                return typed_tag
            }
        }

        // Return keyword or identifier
        // Bootstrap workaround: nullable return from keyword_kind is unreliable.
        // Use is_keyword check (returns bool, not nullable) instead.
        // Bool/null keywords with specific kind_ids
        if text == "true" { return token_bool(true, span) }
        if text == "false" { return token_bool(false, span) }
        if text == "null" { return Token { kind: TokenKind.NullLiteral, span: span, text: "null", kind_id: 8 } }
        // All other keywords get unique kind_id (20-60) for Stage 2 dispatch
        let kid = kind_id_for_keyword(text)
        if kid > 0 {
            let kw = keyword_kind(text)
            if kw != null {
                return token_kw(kw!, text, span, kid)
            }
        }
        if is_keyword(text) {
            let kw = keyword_kind(text)
            return Token { kind: kw!, span: span, text: text, kind_id: 0 }
        }

        token_ident(text, span)
    }

    fn lex_tagged_template(self, tag: string, start_pos: int, start_line: int, start_col: int) -> Token {
        // ` already consumed, parse template body
        mut text = ""
        mut parts: List<TemplatePart> = []

        while !self.is_at_end() {
            let ch = self.peek_ch()

            if ch == "`" {
                self.advance()
                if text.length > 0 {
                    parts = parts.push(TemplatePart.Literal(text))
                }
                return Token {
                    kind: TokenKind.TaggedTemplate(tag, parts, ""),
                    span: self.make_span(start_pos, start_line, start_col),
                }
            }

            if ch == "\\" {
                self.advance()
                if !self.is_at_end() {
                    text = text + self.advance()
                }
                continue
            }

            if ch == "$" && self.peek_at(1) == "{" {
                if text.length > 0 {
                    parts = parts.push(TemplatePart.Literal(text))
                    text = ""
                }
                self.advance()
                self.advance()
                let expr_span = self.current_span()
                let expr_text = self.capture_interpolation_expr()
                parts = parts.push(TemplatePart.Expr(expr_text, expr_span))
                continue
            }

            text = text + self.advance()
        }

        let span = self.make_span(start_pos, start_line, start_col)
        self.add_error("F0003", "unterminated tagged template", span)
        Token { kind: TokenKind.TaggedTemplate(tag, parts, ""), span }
    }

    fn try_typed_tagged_template(self, tag: string, start_pos: int, start_line: int, start_col: int) -> Token {
        // Try to parse ident<Type>` — backtrack if it doesn't match
        let saved_pos = self.pos
        let saved_line = self.line
        let saved_col = self.col

        self.advance() // consume <
        mut depth = 1
        mut type_text = ""

        while !self.is_at_end() && depth > 0 {
            let ch = self.peek_ch()
            if ch == "<" {
                depth = depth + 1
                type_text = type_text + self.advance()
            } else if ch == ">" {
                depth = depth - 1
                if depth == 0 {
                    self.advance() // consume closing >
                } else {
                    type_text = type_text + self.advance()
                }
            } else {
                type_text = type_text + self.advance()
            }
        }

        // Check if immediately followed by `
        if !self.is_at_end() && self.peek_ch() == "`" {
            self.advance() // consume `
            mut text = ""
            mut parts: List<TemplatePart> = []

            while !self.is_at_end() {
                let ch = self.peek_ch()

                if ch == "`" {
                    self.advance()
                    if text.length > 0 {
                        parts = parts.push(TemplatePart.Literal(text))
                    }
                    return Token {
                        kind: TokenKind.TaggedTemplate(tag, parts, type_text),
                        span: self.make_span(start_pos, start_line, start_col),
                    }
                }

                if ch == "\\" {
                    self.advance()
                    if !self.is_at_end() {
                        text = text + self.advance()
                    }
                    continue
                }

                if ch == "$" && self.peek_at(1) == "{" {
                    if text.length > 0 {
                        parts = parts.push(TemplatePart.Literal(text))
                        text = ""
                    }
                    self.advance()
                    self.advance()
                    let expr_span = self.current_span()
                    let expr_text = self.capture_interpolation_expr()
                    parts = parts.push(TemplatePart.Expr(expr_text, expr_span))
                    continue
                }

                text = text + self.advance()
            }

            let span = self.make_span(start_pos, start_line, start_col)
            self.add_error("F0003", "unterminated typed tagged template", span)
            return Token { kind: TokenKind.TaggedTemplate(tag, parts, type_text), span }
        }

        // Not a typed tagged template — backtrack
        self.pos = saved_pos
        self.line = saved_line
        self.col = saved_col
        Token { kind: TokenKind.Eof, span: self.current_span(), text: "", kind_id: 99 }
    }

    // ─── Operators & Punctuation ───────────────

    fn lex_operator(self, start_pos: int, start_line: int, start_col: int) -> Token {
        let ch = self.advance()
        let sp = self.make_span(start_pos, start_line, start_col)

        // Single-character tokens (all with kind_id for Stage 2 dispatch)
        if ch == "(" { return token_with_id(TokenKind.LParen, sp, 100) }
        if ch == ")" { return token_with_id(TokenKind.RParen, sp, 101) }
        if ch == "{" { return token_with_id(TokenKind.LBrace, sp, 102) }
        if ch == "}" { return token_with_id(TokenKind.RBrace, sp, 103) }
        if ch == "[" { return token_with_id(TokenKind.LBracket, sp, 104) }
        if ch == "]" { return token_with_id(TokenKind.RBracket, sp, 105) }
        if ch == "," { return token_with_id(TokenKind.Comma, sp, 110) }
        if ch == ":" { return token_with_id(TokenKind.Colon, sp, 112) }
        if ch == ";" { return token_with_id(TokenKind.Semicolon, sp, 113) }
        if ch == "@" { return token_with_id(TokenKind.At, sp, 114) }
        if ch == "#" { return token_with_id(TokenKind.Hash, sp, 115) }
        if ch == "+" { return token_with_id(TokenKind.Plus, sp, 70) }
        if ch == "*" { return token_with_id(TokenKind.Star, sp, 72) }
        if ch == "%" { return token_with_id(TokenKind.Percent, sp, 74) }
        if ch == "^" { return token_with_id(TokenKind.Caret, sp, 95) }
        if ch == "~" { return token_with_id(TokenKind.Tilde, sp, 96) }

        // Multi-character operators (all with kind_id for Stage 2 dispatch)
        let next = self.peek_ch()

        // - or ->
        if ch == "-" {
            if next == ">" {
                self.advance()
                return token_with_id(TokenKind.Arrow, self.make_span(start_pos, start_line, start_col), 86)
            }
            return token_with_id(TokenKind.Minus, sp, 71)
        }

        // = or ==
        if ch == "=" {
            if next == "=" {
                self.advance()
                return token_with_id(TokenKind.EqEq, self.make_span(start_pos, start_line, start_col), 76)
            }
            return token_with_id(TokenKind.Eq, sp, 75)
        }

        // ! or !=
        if ch == "!" {
            if next == "=" {
                self.advance()
                return token_with_id(TokenKind.NotEq, self.make_span(start_pos, start_line, start_col), 77)
            }
            return token_with_id(TokenKind.Not, sp, 84)
        }

        // < or <= or <- or <<
        if ch == "<" {
            if next == "=" {
                self.advance()
                return token_with_id(TokenKind.LtEq, self.make_span(start_pos, start_line, start_col), 79)
            }
            if next == "-" {
                self.advance()
                return token_with_id(TokenKind.LeftArrow, self.make_span(start_pos, start_line, start_col), 87)
            }
            if next == "<" {
                self.advance()
                return token_with_id(TokenKind.ShiftLeft, self.make_span(start_pos, start_line, start_col), 97)
            }
            return token_with_id(TokenKind.Lt, sp, 78)
        }

        // > or >= or >>
        if ch == ">" {
            if next == "=" {
                self.advance()
                return token_with_id(TokenKind.GtEq, self.make_span(start_pos, start_line, start_col), 81)
            }
            if next == ">" {
                self.advance()
                return token_with_id(TokenKind.ShiftRight, self.make_span(start_pos, start_line, start_col), 98)
            }
            return token_with_id(TokenKind.Gt, sp, 80)
        }

        // & or &&
        if ch == "&" {
            if next == "&" {
                self.advance()
                return token_with_id(TokenKind.And, self.make_span(start_pos, start_line, start_col), 82)
            }
            return token_with_id(TokenKind.Ampersand, sp, 93)
        }

        // | or || or |>
        if ch == "|" {
            if next == "|" {
                self.advance()
                return token_with_id(TokenKind.Or, self.make_span(start_pos, start_line, start_col), 83)
            }
            if next == ">" {
                self.advance()
                return token_with_id(TokenKind.Pipe, self.make_span(start_pos, start_line, start_col), 85)
            }
            return token_with_id(TokenKind.Bar, sp, 94)
        }

        // ? or ?. or ??
        if ch == "?" {
            if next == "." {
                self.advance()
                return token_with_id(TokenKind.QuestionDot, self.make_span(start_pos, start_line, start_col), 89)
            }
            if next == "?" {
                self.advance()
                return token_with_id(TokenKind.DoubleQuestion, self.make_span(start_pos, start_line, start_col), 90)
            }
            return token_with_id(TokenKind.Question, sp, 88)
        }

        // . or .. or ... or ..=
        if ch == "." {
            if next == "." {
                self.advance()
                let next2 = self.peek()
                if next2 == "." {
                    self.advance()
                    return token_with_id(TokenKind.Spread, self.make_span(start_pos, start_line, start_col), 116)
                }
                if next2 == "=" {
                    self.advance()
                    return token_with_id(TokenKind.DotDotEq, self.make_span(start_pos, start_line, start_col), 92)
                }
                return token_with_id(TokenKind.DotDot, self.make_span(start_pos, start_line, start_col), 91)
            }
            return token_with_id(TokenKind.Dot, sp, 111)
        }

        // /
        if ch == "/" {
            return token_with_id(TokenKind.Slash, sp, 73)
        }

        // Unknown character
        let span = self.make_span(start_pos, start_line, start_col)
        self.add_error("F0001", "unexpected character: '${ch}'", span)
        Token { kind: TokenKind.Eof, span: span, text: "", kind_id: 99 }
    }
}

// ─── Keyword Lookup ────────────────────────────

export fn is_keyword(text: string) -> bool {
    if text == "let" { return true }
    if text == "mut" { return true }
    if text == "const" { return true }
    if text == "fn" { return true }
    if text == "return" { return true }
    if text == "if" { return true }
    if text == "else" { return true }
    if text == "match" { return true }
    if text == "for" { return true }
    if text == "in" { return true }
    if text == "while" { return true }
    if text == "loop" { return true }
    if text == "break" { return true }
    if text == "continue" { return true }
    if text == "enum" { return true }
    if text == "type" { return true }
    if text == "use" { return true }
    if text == "mod" { return true }
    if text == "as" { return true }
    if text == "export" { return true }
    if text == "emit" { return true }
    if text == "on" { return true }
    if text == "trait" { return true }
    if text == "impl" { return true }
    if text == "defer" { return true }
    if text == "errdefer" { return true }
    if text == "spawn" { return true }
    if text == "parallel" { return true }
    if text == "with" { return true }
    if text == "without" { return true }
    if text == "only" { return true }
    if text == "partial" { return true }
    if text == "catch" { return true }
    if text == "select" { return true }
    if text == "component" { return true }
    if text == "is" { return true }
    if text == "table" { return true }
    if text == "true" { return true }
    if text == "false" { return true }
    if text == "null" { return true }
    if text == "Ok" { return true }
    if text == "Err" { return true }
    if text == "_" { return true }
    false
}

export fn keyword_kind(text: string) -> TokenKind? {
    match text {
        "let" -> TokenKind.Let
        "mut" -> TokenKind.Mut
        "const" -> TokenKind.Const
        "fn" -> TokenKind.Fn
        "return" -> TokenKind.Return
        "if" -> TokenKind.If
        "else" -> TokenKind.Else
        "match" -> TokenKind.Match
        "for" -> TokenKind.For
        "in" -> TokenKind.In
        "while" -> TokenKind.While
        "loop" -> TokenKind.Loop
        "break" -> TokenKind.Break
        "continue" -> TokenKind.Continue
        "enum" -> TokenKind.Enum
        "type" -> TokenKind.TypeKw
        "use" -> TokenKind.Use
        "mod" -> TokenKind.Mod
        "as" -> TokenKind.As
        "export" -> TokenKind.Export
        "emit" -> TokenKind.Emit
        "on" -> TokenKind.On
        "trait" -> TokenKind.Trait
        "impl" -> TokenKind.Impl
        "defer" -> TokenKind.Defer
        "errdefer" -> TokenKind.Errdefer
        "spawn" -> TokenKind.Spawn
        "parallel" -> TokenKind.Parallel
        "with" -> TokenKind.With
        "without" -> TokenKind.Without
        "only" -> TokenKind.Only
        "partial" -> TokenKind.Partial
        "catch" -> TokenKind.Catch
        "select" -> TokenKind.Select
        "component" -> TokenKind.Component
        "is" -> TokenKind.Is
        "table" -> TokenKind.Table
        "true" -> TokenKind.BoolLiteral(true)
        "false" -> TokenKind.BoolLiteral(false)
        "null" -> TokenKind.NullLiteral
        "Ok" -> TokenKind.OkKw
        "Err" -> TokenKind.ErrKw
        "_" -> TokenKind.Underscore
        _ -> null
    }
}

// ─── Number Parsing Helpers ────────────────────

export fn parse_int(text: string) -> int {
    // Use runtime int() conversion
    int(text)
}

export fn parse_float(text: string) -> float {
    // Use runtime float() conversion
    float(text)
}

export fn parse_int_radix(text: string, radix: int) -> int {
    mut result = 0
    for ch in text {
        mut digit = 0
        if ch >= "0" && ch <= "9" {
            digit = int(ch) - int("0")
        } else if ch >= "a" && ch <= "f" {
            digit = int(ch) - int("a") + 10
        } else if ch >= "A" && ch <= "F" {
            digit = int(ch) - int("A") + 10
        }
        result = result * radix + digit
    }
    result
}
