// ─── Parser ────────────────────────────────────
// Parses a token stream into an AST.
// Statement dispatch uses the feature registry; expression parsing
// uses precedence climbing defined in expressions.fg.

mod expressions
mod templates

use core.token.{Token, TokenKind, Span, TemplatePart}
use core.ast.{
    Program, Statement, Expr, Block, BinOp, UnaryOp,
    FeatureStmt, FeatureExpr, NodeRef,
    feature_stmt, feature_expr,
}
use core.types.Type
use core.error.{Diagnostic, error, E_SYNTAX}
use core.kind_ids.{
    KID_IDENT, KID_INT_LIT, KID_STRING_LIT, KID_BOOL_LIT, KID_NULL_LIT,
    KID_LET, KID_MUT, KID_CONST, KID_FN, KID_RETURN, KID_IF, KID_ELSE,
    KID_MATCH, KID_FOR, KID_IN, KID_WHILE, KID_LOOP, KID_BREAK, KID_CONTINUE,
    KID_ENUM, KID_TYPE, KID_USE, KID_MOD, KID_EXPORT, KID_IMPL, KID_TRAIT,
    KID_IS, KID_TABLE, KID_EOF,
    KID_LPAREN, KID_RPAREN, KID_LBRACE, KID_RBRACE, KID_LBRACKET, KID_RBRACKET,
    KID_NEWLINE, KID_ARROW, KID_DOT, KID_COMMA, KID_COLON, KID_SEMICOLON,
    KID_PLUS, KID_MINUS, KID_NOT, KID_PIPE, KID_QUESTION,
    KID_EQ, KID_LT, KID_GT, KID_LTEQ, KID_GTEQ,
}
use features.while_loops.{PARSE_END_POS}
use features.impl_methods.parse_impl_block
use expressions.{LAST_IDENT_NAME, IN_MATCH_ARM, match_enum_tag, register_enum_variant}

export mut LAST_PARAM_TYPE_NAME: string = "int"
export mut PARSED_PARAM_TYPES: List<string> = []
export mut PARSED_PARAM_NAMES: List<string> = []

// ─── Param Type ────────────────────────────────

export type Param = {
    name: string,
    type_ann: TypeExpr?,
    default_value: Expr?,
    span: Span,
    mutable: bool,
}

// ─── Type Expressions ──────────────────────────

export enum TypeExpr {
    Named(name: string, span: Span)
    Generic(name: string, args: List<TypeExpr>, span: Span)
    Nullable(inner: TypeExpr, span: Span)
    Function(params: List<TypeExpr>, return_type: TypeExpr, span: Span)
    Tuple(elements: List<TypeExpr>, span: Span)
    Struct(fields: List<TypeField>, span: Span)
}

export type TypeField = {
    name: string,
    type_expr: TypeExpr,
    mutable: bool,
}

// ─── Parser State ──────────────────────────────

export type Parser = {
    tokens: List<Token>,
    mut pos: int,
    mut diagnostics: List<Diagnostic>,
    source: string,
}

export fn parser_new(tokens: List<Token>) -> Parser {
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: "",
    }
}

export fn parser_new_with_source(tokens: List<Token>, source: string) -> Parser {
    forge_set_token_list(tokens)
    forge_parser_set_pos(0)
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: source,
    }
}

// ─── Parser Methods ────────────────────────────

impl Parser {

    // ─── Token Navigation ──────────────────────

    fn is_at_end(self) -> bool {
        forge_parser_get_pos() >= forge_token_list_len()
    }

    fn peek(self) -> Token {
        let _cpos = forge_parser_get_pos()
        if _cpos < forge_token_list_len() {
            // Use C-side token access (immune to Token struct size mismatch between stages)
            let kid = forge_ftok_kind_id(_cpos)
            let txt = forge_ftok_text(_cpos)
            Token {
                kind: TokenKind.Eof,  // kind enum unused by parser — only kind_id matters
                span: Span { start: 0, end: 0, line: 0, col: 0 },
                text: txt,
                kind_id: kid,
            }
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 }, text: "", kind_id: 99 }
        }
    }

    fn peek_at(self, offset: int) -> Token {
        let idx = forge_parser_get_pos() + offset
        if idx < forge_token_list_len() {
            let kid = forge_ftok_kind_id(idx)
            let txt = forge_ftok_text(idx)
            Token {
                kind: TokenKind.Eof,
                span: Span { start: 0, end: 0, line: 0, col: 0 },
                text: txt,
                kind_id: kid,
            }
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 }, text: "", kind_id: 99 }
        }
    }

    fn advance(self) -> Token {
        let tok = self.peek()
        if forge_parser_get_pos() < forge_token_list_len() {
            self.pos = self.pos + 1
            forge_parser_advance_pos()
        }
        tok
    }

    // Helpers: avoid method().field chains which the self-hosted codegen
    // doesn't emit correctly (the method call is dropped, only field access runs)
    fn advance_span(self) -> Span {
        let tok = self.advance()
        tok.span
    }

    fn peek_kind_id(self) -> int {
        let tok = self.peek()
        tok.kind_id
    }

    fn peek_text(self) -> string {
        let tok = self.peek()
        tok.text
    }

    fn peek_span(self) -> Span {
        let tok = self.peek()
        tok.span
    }

    fn check(self, kind: TokenKind) -> bool {
        let kid = self.kind_to_kid(kind)
        if kid >= 0 { return self.peek_kind_id() == kid }
        // Fallback to string comparison
        let a = forge_kind_id_to_key(self.peek_kind_id())
        let b = self.kind_to_key(kind)
        a != "" && a == b
    }

    fn kind_to_kid(self, kind: TokenKind) -> int {
        match kind {
            .LParen -> KID_LPAREN
            .RParen -> KID_RPAREN
            .LBrace -> KID_LBRACE
            .RBrace -> KID_RBRACE
            .LBracket -> KID_LBRACKET
            .RBracket -> KID_RBRACKET
            .Newline -> KID_NEWLINE
            .Arrow -> KID_ARROW
            .Dot -> KID_DOT
            .Comma -> KID_COMMA
            .Colon -> KID_COLON
            .Eq -> KID_EQ
            .Semicolon -> KID_SEMICOLON
            .Let -> KID_LET
            .Mut -> KID_MUT
            .Const -> KID_CONST
            .Fn -> KID_FN
            .Return -> KID_RETURN
            .If -> KID_IF
            .Else -> KID_ELSE
            .Match -> KID_MATCH
            .For -> KID_FOR
            .In -> KID_IN
            .While -> KID_WHILE
            .Break -> KID_BREAK
            .Continue -> KID_CONTINUE
            .Enum -> KID_ENUM
            .TypeKw -> KID_TYPE
            .Use -> KID_USE
            .Mod -> KID_MOD
            .Export -> KID_EXPORT
            .Trait -> KID_TRAIT
            .Impl -> KID_IMPL
            .Is -> KID_IS
            .Not -> KID_NOT
            .Minus -> KID_MINUS
            .Plus -> KID_PLUS
            .Pipe -> KID_PIPE
            .Question -> KID_QUESTION
            .Lt -> KID_LT
            .Gt -> KID_GT
            .Eof -> KID_EOF
            _ -> -1
        }
    }

    fn check_id(self, kid: int) -> bool {
        if forge_parser_get_pos() >= forge_token_list_len() { return kid == KID_EOF }
        self.peek_kind_id() == kid
    }

    fn expect_id(self, kid: int) -> Token? {
        if !self.check_id(kid) {
            return null
        }
        let tok = self.advance()
        return tok
    }

    fn expect(self, kind: TokenKind) -> Token? {
        let expected_kid = self.kind_to_kid(kind)
        if expected_kid >= 0 && self.peek_kind_id() == expected_kid {
            self.advance()
        } else if self.check(kind) {
            self.advance()
        } else {
            self.error("expected token")
            null
        }
    }

    fn expect_ident(self) -> string {
        let tok = self.peek()
        // Bootstrap workaround: use kind_id instead of pattern matching on .Ident(name)
        if tok.kind_id == KID_IDENT {
            self.advance()
            return tok.text
        }
        // Keywords that can be used as identifiers
        if tok.kind_id == KID_IS {
            self.advance()
            return "is"
        }
        if tok.kind_id == KID_TABLE {
            self.advance()
            return "table"
        }
        if tok.text == "_" {  // Underscore
            self.advance()
            return "_"
        }
        self.error("expected identifier")
        ""
    }

    fn skip_newlines(self) {
        while !self.is_at_end() && self.peek_kind_id() == KID_NEWLINE {
            self.advance()
        }
    }

    // Skip tokens until matching closing brace (handles nesting).
    // Assumes opening { was already consumed. Consumes the closing }.
    fn skip_to_matching_brace(self) {
        mut depth = 1
        while depth > 0 && !self.is_at_end() {
            if self.peek_kind_id() == KID_LBRACE {
                depth = depth + 1
            }
            if self.peek_kind_id() == KID_RBRACE {
                depth = depth - 1
            }
            self.advance()
        }
    }

    fn current_span(self) -> Span {
        self.peek_span()
    }

    fn error(self, message: string) {
        self.diagnostics = self.diagnostics.push(
            error(E_SYNTAX, message, self.current_span())
        )
    }

    // ─── Peek Helpers ──────────────────────────

    fn peek_at_meaningful(self, n: int) -> Token {
        // Peek at the nth non-newline token
        mut count = 0
        mut offset = 0
        while forge_parser_get_pos() + offset < forge_token_list_len() {
            let tok = self.tokens[forge_parser_get_pos() + offset]
            if tok.kind_id != 120 {  // not Newline
                if count == n {
                    return tok
                }
                count = count + 1
            }
            offset = offset + 1
        }
        Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
    }

    fn next_meaningful_is(self, kind: TokenKind) -> bool {
        let mtok = self.peek_at_meaningful(0)
        let a = forge_kind_id_to_key(mtok.kind_id)
        let b = self.kind_to_key(kind)
        a != "" && a == b
    }

    // ─── Program Parsing ───────────────────────

    fn parse_program(self) -> Program {
        mut statements: List<Statement> = []
        self.skip_newlines()
        mut stuck_count = 0
        mut last_pos = forge_parser_get_pos()

        while !self.is_at_end() {
            let before = forge_parser_get_pos()
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            // Safety: skip token if parser didn't advance
            let after = forge_parser_get_pos()
            if after == before {
                self.advance()
            }
            // Detect stuck parser — if position hasn't changed in 3 iterations, force advance
            if forge_parser_get_pos() == last_pos {
                stuck_count = stuck_count + 1
                if stuck_count > 3 {
                    self.advance()
                    stuck_count = 0
                }
            } else {
                stuck_count = 0
                last_pos = forge_parser_get_pos()
            }
            self.skip_newlines()
        }

        Program { statements }
    }

    // ─── Statement Parsing ─────────────────────
    // Check registry first, then fall back to built-in structural statements.

    fn parse_statement(self) -> Statement? {
        self.skip_newlines()
        if self.is_at_end() { return null }

        let tok = self.peek()

        // kind_id dispatch (constants from core/kind_ids.fg)
        let kid = tok.kind_id
        forge_trace_i64(kid, KID_FN)
        if kid == KID_LET { let r = parse_let(self)
            self.sync_pos()
            return r }
        if kid == KID_MUT { let r = parse_mut(self)
            self.sync_pos()
            return r }
        if kid == KID_CONST { let r = parse_const(self)
            self.sync_pos()
            return r }
        if kid == KID_FN { let r = parse_fn(self)
            self.sync_pos()
            return r }
        if kid == KID_EXPORT { let r = parse_export(self)
            self.sync_pos()
            return r }
        if kid == KID_WHILE {
            let wstart = self.advance_span()
            self.skip_newlines()
            let wcond = self.parse_expr()
            if wcond == null { return null }
            self.skip_newlines()
            let wbody = self.parse_block()
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.While(wcond!, wbody, wstart)
        }
        if kid == KID_FOR {
            let fstart = self.advance_span()
            let fname = self.expect_ident()
            if self.peek_kind_id() == KID_IN { self.advance() }
            self.skip_newlines()
            let fiter = self.parse_expr()
            if fiter == null { return null }
            self.skip_newlines()
            let fbody = self.parse_block()
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.For(fname, fiter!, fbody, fstart)
        }
        if kid == KID_RETURN { return self.parse_return() }
        if kid == KID_IF {
            let start = self.advance_span()
            self.skip_newlines()
            let cond = self.parse_expr()
            if cond == null { return null }
            self.skip_newlines()
            let then_block = self.parse_block()
            self.skip_newlines()
            mut has_else = 0
            mut else_block = Block { statements: [], span: start }
            if self.peek_kind_id() == KID_ELSE || self.peek_kind_id() == KID_ELSE {
                has_else = 1
                self.advance()
                self.skip_newlines()
                if self.peek_kind_id() == KID_IF {
                    let nested = self.parse_statement()
                    if nested != null {
                        else_block = Block { statements: [nested!], span: start }
                    }
                } else {
                    else_block = self.parse_block()
                }
            }
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.If(cond!, then_block, else_block, has_else, start)
        }
        if kid == KID_WHILE {
            let wstart = self.advance_span()
            self.skip_newlines()
            let wcond = self.parse_expr()
            if wcond == null { return null }
            self.skip_newlines()
            let wbody = self.parse_block()
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.While(wcond!, wbody, wstart)
        }
        if kid == KID_MATCH {
            let mexpr = self.parse_match_expr()
            if mexpr != null {
                PARSE_END_POS = forge_parser_get_pos()
                return Statement.Expr(mexpr!)
            }
            return null
        }
        if kid == KID_BREAK {
            let bspan = self.advance_span()
            return Statement.Break(bspan)
        }
        if kid == KID_CONTINUE {
            let cspan = self.advance_span()
            return Statement.Continue(cspan)
        }
        if kid == KID_USE {
            self.advance()
            // Skip until end of line. Use ==/break form rather than `!=`
            // because `!= KID_NEWLINE` has hit miscompile issues in
            // earlier self-host bootstrap snapshots.
            mut done = false
            while !done && !self.is_at_end() {
                if self.peek_kind_id() == KID_NEWLINE { done = true }
                if !done { self.advance() }
            }
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        if kid == KID_MOD {
            self.advance()
            self.expect_ident()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        if kid == KID_IMPL {
            let r = parse_impl_block(self)
            self.sync_pos()
            return r
        }
        if kid == KID_TYPE {
            let r = parse_type_decl(self)
            self.sync_pos()
            return r
        }
        if kid == KID_ENUM {
            self.advance()
            self.parse_enum_variants()
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        if kid == KID_TRAIT {
            self.advance()
            self.expect_ident()
            while !self.is_at_end() && self.peek_kind_id() != KID_LBRACE {
                self.advance()
            }
            if self.peek_kind_id() == 102 {
                self.advance()
                mut bdepth = 1
                while bdepth > 0 && !self.is_at_end() {
                    let bk = self.peek_kind_id()
                    if bk == 102 { bdepth = bdepth + 1 }
                    if bk == 103 { bdepth = bdepth - 1 }
                    if bdepth > 0 { self.advance() }
                }
                if self.peek_kind_id() == 103 { self.advance() }
            }
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }

        match tok.kind {
            .Let -> {
                let r = parse_let(self)
                self.sync_pos()
                return r
            }
            .Mut -> {
                let r = parse_mut(self)
                self.sync_pos()
                return r
            }
            .Const -> {
                let r = parse_const(self)
                self.sync_pos()
                return r
            }
            .Fn -> {
                let r = parse_fn(self)
                self.sync_pos()
                return r
            }
            .Export -> {
                let r = parse_export(self)
                self.sync_pos()
                return r
            }
            .While -> {
                let r = parse_while(self)
                self.sync_pos()
                return r
            }
            .For -> {
                let r = parse_for(self)
                self.sync_pos()
                return r
            }
            .If -> {
                let start = self.advance_span() // consume 'if'
                self.skip_newlines()
                let cond = self.parse_expr()
                if cond == null { return null }
                self.skip_newlines()
                let then_block = self.parse_block()
                self.skip_newlines()
                mut has_else = 0
                mut else_block = Block { statements: [], span: start }
                if self.peek_kind_id() == KID_ELSE {
                    has_else = 1
                    self.advance()
                    self.skip_newlines()
                    if self.peek_kind_id() == KID_IF {
                        let nested = self.parse_statement()
                        if nested != null {
                            else_block = Block { statements: [nested!], span: start }
                        }
                    } else {
                        else_block = self.parse_block()
                    }
                }
                return Statement.If(cond!, then_block, else_block, has_else, start)
            }
            .Match -> {
                let mexpr = self.parse_match_expr()
                if mexpr == null { return null }
                return Statement.Expr(mexpr!)
            }
            .TypeKw -> {
                let r = parse_type_decl(self)
                self.sync_pos()
                return r
            }
            .Enum -> {
                let r = parse_enum_decl(self)
                self.sync_pos()
                return r
            }
            .Impl -> {
                let r = parse_impl_block(self)
                self.sync_pos()
                return r
            }
            .Use -> {
                // Skip 'use' statements — module imports are no-op in single-file mode
                self.advance() // consume 'use'
                // Skip until newline or end
                while !self.is_at_end() && self.peek_kind_id() != KID_NEWLINE {
                    self.advance()
                }
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Mod -> {
                // Skip 'mod' declarations — no-op in single-file mode
                self.advance() // consume 'mod'
                self.expect_ident() // consume module name
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Trait -> {
                // Skip trait declarations — parse and discard
                self.advance() // consume 'trait'
                self.expect_ident() // trait name
                if self.peek_kind_id() == KID_LBRACE {
                    self.parse_block() // skip body
                }
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            _ -> {}
        }

        // Built-in structural statements
        match tok.kind {
            .Return -> {
                self.parse_return()
            }
            .Break -> {
                self.advance()
                Statement.Break(tok.span)
            }
            .Continue -> {
                self.advance()
                Statement.Continue(tok.span)
            }
            _ -> {
                self.parse_expr_or_assign()
            }
        }
    }

    fn sync_pos(self) {
        if PARSE_END_POS >= 0 {
            forge_parser_set_pos(PARSE_END_POS)
            PARSE_END_POS = -1
        }
    }

    fn parse_return(self) -> Statement? {
        let start = self.advance_span() // consume 'return'

        // Bare return (no value)
        if self.is_at_end() || self.peek_kind_id() == KID_NEWLINE || self.peek_kind_id() == KID_RBRACE {
            return Statement.Return(Expr.NullLit(start), start)
        }

        // return null
        let pk = self.peek()
        let pk_key = self.kind_to_key(pk.kind)
        if pk_key == "NullLiteral" {
            self.advance() // consume 'null'
            return Statement.Return(Expr.NullLit(start), start)
        }

        let value = self.parse_expr()
        if value == null {
            return Statement.Return(Expr.NullLit(start), start)
        }

        Statement.Return(value!, start)
    }

    fn parse_expr_or_assign(self) -> Statement? {
        let expr = self.parse_expr()
        if expr == null { return null }

        // Check for assignment: expr = value
        if self.peek_kind_id() == KID_EQ {
            // Save target variable name before RHS parsing overwrites LAST_IDENT_NAME
            let assign_target_name = LAST_IDENT_NAME
            let eq_span = self.advance_span() // consume =
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '='")
                return null
            }
            return Statement.Assign(expr!, value!, eq_span)
        }

        // Check for channel send: expr <- value
        if self.peek_kind_id() == 211 {
            self.advance()
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '<-'")
                return null
            }
            return Statement.Expr(expr!)
        }

        Statement.Expr(expr!)
    }

    // ─── Block Parsing ─────────────────────────

    fn parse_block(self) -> Block {
        let start = self.current_span()
        let empty = Block { statements: [], span: start }
        if self.expect_id(KID_LBRACE) == null {
            return empty
        }

        self.skip_newlines()
        mut statements: List<Statement> = []

        while self.peek_kind_id() != KID_RBRACE && !self.is_at_end() {
            let before = forge_parser_get_pos()
            let stmt = self.parse_statement()
            forge_trace_i64(9001, forge_parser_get_pos())
            if stmt != null {
                forge_trace_i64(9002, 1)
                statements = statements.push(stmt!)
            } else {
                forge_trace_i64(9002, 0)
            }
            if forge_parser_get_pos() == before { self.advance() }
            self.skip_newlines()
        }
        forge_trace_i64(9003, statements.length)

        self.expect_id(KID_RBRACE)

        Block {
            statements,
            span: Span {
                start: start.start,
                end: self.current_span().end,
                line: start.line,
                col: start.col,
            },
        }
    }

    // Parse a block or wrap a single statement in a block
    fn parse_block_or_stmt(self) -> Block? {
        if self.peek_kind_id() == KID_LBRACE {
            self.parse_block()
        } else {
            let start = self.current_span()
            let stmt = self.parse_statement()
            if stmt == null { return null }
            Block {
                statements: [stmt!],
                span: start,
            }
        }
    }

    // ─── Type Expression Parsing ───────────────

    fn parse_type_expr(self) -> TypeExpr? {
        let ty = self.parse_primary_type()
        if ty == null { return null }

        // Check for nullable modifier: Type?
        if self.peek_kind_id() == KID_QUESTION {
            let span = self.advance_span()
            return TypeExpr.Nullable(ty!, span)
        }

        ty
    }

    fn parse_primary_type(self) -> TypeExpr? {
        let tok = self.peek()

        // Ident → type name (bootstrap workaround: use kind_id)
        if tok.kind_id == 1 {
            let name = tok.text
            let start = self.advance_span()
            // Check for generic: Name<A, B>
            if self.peek_kind_id() == KID_LT {
                let args = self.parse_type_args()
                if args != null {
                    return TypeExpr.Generic(name, args!, start)
                }
            }
            return TypeExpr.Named(name, start)
        }

        match tok.kind {
            // fn(A, B) -> R
            .Fn -> {
                self.parse_function_type()
            }

            // (A, B) — tuple or parenthesized
            .LParen -> {
                self.parse_tuple_or_paren_type()
            }

            // { name: Type, ... } — struct type
            .LBrace -> {
                self.parse_struct_type()
            }

            _ -> {
                self.error("expected type")
                null
            }
        }
    }

    fn parse_type_args(self) -> List<TypeExpr>? {
        if self.expect_id(KID_LT) == null { return null }
        mut args: List<TypeExpr> = []

        while self.peek_kind_id() != KID_GT && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                args = args.push(ty!)
            }
            if self.peek_kind_id() == KID_COMMA {
                self.advance()
            }
        }

        // Handle >> as > >
        if self.peek_kind_id() == 218 {
            // Split >> into two > tokens — consume one
            // TODO: proper token splitting
            self.advance()
        } else {
            if self.expect_id(KID_GT) == null { return null }
        }

        args
    }

    fn parse_function_type(self) -> TypeExpr? {
        let start = self.advance_span() // consume 'fn'
        if self.expect_id(KID_LPAREN) == null { return null }

        mut params: List<TypeExpr> = []
        while self.peek_kind_id() != KID_RPAREN && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                params = params.push(ty!)
            }
            if self.peek_kind_id() == KID_COMMA {
                self.advance()
            }
        }
        if self.expect_id(KID_RPAREN) == null { return null }

        // -> ReturnType
        mut ret: TypeExpr? = TypeExpr.Named("void", start)
        if self.peek_kind_id() == KID_ARROW {
            self.advance()
            ret = self.parse_type_expr()
        }

        if ret == null { return null }
        TypeExpr.Function(params, ret!, start)
    }

    fn parse_tuple_or_paren_type(self) -> TypeExpr? {
        let start = self.advance_span() // consume (

        if self.peek_kind_id() == KID_RPAREN {
            self.advance()
            return TypeExpr.Tuple([], start)
        }

        let first = self.parse_type_expr()
        if first == null { return null }

        if self.peek_kind_id() == KID_COMMA {
            // Tuple type
            self.advance()
            mut elements: List<TypeExpr> = [first!]
            while self.peek_kind_id() != KID_RPAREN && !self.is_at_end() {
                self.skip_newlines()
                let ty = self.parse_type_expr()
                if ty != null {
                    elements = elements.push(ty!)
                }
                if self.peek_kind_id() == KID_COMMA {
                    self.advance()
                }
            }
            if self.expect_id(KID_RPAREN) == null { return null }

            // Check for -> ReturnType (function type)
            if self.peek_kind_id() == KID_ARROW {
                self.advance()
                let ret = self.parse_type_expr()
                if ret == null { return null }
                return TypeExpr.Function(elements, ret!, start)
            }

            return TypeExpr.Tuple(elements, start)
        }

        if self.expect_id(KID_RPAREN) == null { return null }

        // Check for -> ReturnType (single-param function type)
        if self.peek_kind_id() == KID_ARROW {
            self.advance()
            let ret = self.parse_type_expr()
            if ret == null { return null }
            return TypeExpr.Function([first!], ret!, start)
        }

        // Parenthesized type
        first
    }

    fn parse_struct_type(self) -> TypeExpr? {
        let start = self.advance_span() // consume {
        mut fields: List<TypeField> = []

        while self.peek_kind_id() != KID_RBRACE && !self.is_at_end() {
            self.skip_newlines()
            mut mutable = false
            if self.peek_kind_id() == KID_MUT {
                self.advance()
                mutable = true
            }
            let name = self.expect_ident()
            if name.length == 0 { return null }
            if self.expect_id(KID_COLON) == null { return null }
            let ty = self.parse_type_expr()
            if ty == null { return null }
            fields = fields.push(TypeField { name, type_expr: ty!, mutable })
            self.skip_newlines()
            if self.peek_kind_id() == KID_COMMA {
                self.advance()
            }
        }

        if self.expect_id(KID_RBRACE) == null { return null }
        TypeExpr.Struct(fields, start)
    }

    // ─── Parameter Parsing ─────────────────────

    fn parse_params(self) -> List<Param> {
        PARSED_PARAM_TYPES = []
        PARSED_PARAM_NAMES = []
        self.expect_id(KID_LPAREN)
        mut params: List<Param> = []

        while self.peek_kind_id() != KID_RPAREN && !self.is_at_end() {
            self.skip_newlines()
            let before_param = forge_parser_get_pos()
            let param = self.parse_param()
            if param != null {
                params = params.push(param!)
                eprintln("[PUSH] params.length now=" + string(params.length))
            }
            if self.peek_kind_id() == KID_COMMA {
                self.advance()
            }
            // Safety: advance if parse_param didn't advance
            if forge_parser_get_pos() == before_param { self.advance() }
        }

        self.expect_id(KID_RPAREN)
        params
    }

    fn parse_param(self) -> Param? {
        let start = self.current_span()
        mut mutable = false
        if self.peek_kind_id() == KID_MUT {
            self.advance()
            mutable = true
        }
        let name = self.expect_ident()
        if name.length == 0 { return null }

        // Optional type annotation: : Type
        // Capture the type name text before parsing (for struct type lookup)
        mut type_name_text = "int"  // default
        mut type_ann: TypeExpr? = null
        if self.peek_kind_id() == KID_COLON {
            self.advance()
            // Capture the type name including generic params: List<Expr> → "List:Expr"
            let type_tok = self.peek()
            if type_tok.kind_id == KID_IDENT {
                type_name_text = type_tok.text
                // Check for generic: Name<T> → "Name:T"
                let next_tok = self.peek_at(1)
                if next_tok.kind_id == KID_LT {
                    let generic_tok = self.peek_at(2)
                    if generic_tok.kind_id == KID_IDENT {
                        type_name_text = type_tok.text + ":" + generic_tok.text
                    }
                }
            }
            type_ann = self.parse_type_expr()
        }
        // Store the type name for function param type tracking
        LAST_PARAM_TYPE_NAME = type_name_text
        PARSED_PARAM_TYPES = PARSED_PARAM_TYPES.push(type_name_text)
        PARSED_PARAM_NAMES = PARSED_PARAM_NAMES.push(name)

        // Optional default value: = expr
        mut default_value: Expr? = null
        if self.peek_kind_id() == KID_EQ {
            self.advance()
            default_value = self.parse_expr()
        }

        Param { name, type_ann, default_value, span: start, mutable }
    }

    // ─── Type Parameters ───────────────────────

    fn parse_type_params(self) -> List<string> {
        if self.peek_kind_id() != KID_LT { return [] }
        self.advance() // consume <

        mut params: List<string> = []
        while self.peek_kind_id() != KID_GT && !self.is_at_end() {
            self.skip_newlines()
            let name = self.expect_ident()
            if name.length > 0 {
                params = params.push(name)
            }
            // TODO: bounds (T: Clone)
            if self.peek_kind_id() == KID_COMMA {
                self.advance()
            }
        }

        if self.expect_id(KID_GT) == null { return params }
        params
    }

    // ─── Delimited List Helper ─────────────────

    fn parse_delimited(self, close: TokenKind) -> List<Expr> {
        mut items: List<Expr> = []

        while !self.check(close) && !self.is_at_end() {
            self.skip_newlines()
            let item = self.parse_expr()
            if item != null {
                items = items.push(item!)
            }
            self.skip_newlines()
            if self.peek_kind_id() == KID_COMMA {
                self.advance()
            }
        }

        items
    }

    // ─── Token Kind Key ────────────────────────
    // Convert a TokenKind to a string key for registry lookup.

    fn token_kind_key(self, kind: TokenKind) -> string {
        self.kind_to_key(kind)
    }

    // Parse enum declaration: register variant names and tags
    fn parse_enum_variants(self) {
        let enum_name = self.expect_ident()
        // Skip to opening brace
        while !self.is_at_end() && self.peek_kind_id() != 102 {
            self.advance()
        }
        if self.peek_kind_id() != 102 { return }
        self.advance() // consume {
        mut variant_tag = 0
        mut max_fields = 0
        while !self.is_at_end() && self.peek_kind_id() != 103 {
            self.skip_newlines()
            let vk = self.peek_kind_id()
            if vk == 103 { break }
            if vk == 1 {
                let vname = self.expect_ident()
                if vname == "" { self.advance() }
                register_enum_variant(enum_name, vname, variant_tag)
                mut field_count = 0
                mut field_types: string = ""
                if self.peek_kind_id() == 100 {
                    self.advance() // consume (
                    // Parse fields: name: Type, name: Type, ...
                    while self.peek_kind_id() != 101 && !self.is_at_end() {
                        self.skip_newlines()
                        let before_field = forge_parser_get_pos()
                        let fk = self.peek_kind_id()
                        if fk == 101 { break }
                        // Expect field name (ident)
                        if fk == 1 {
                            self.advance() // consume field name
                            // Expect colon
                            if self.peek_kind_id() == 124 {
                                self.advance() // consume :
                                // Read type name
                                let type_tok = self.peek()
                                mut type_code = "i"
                                if type_tok.kind_id == 1 {
                                    let tn = type_tok.text
                                    if tn == "string" { type_code = "s" }
                                    else if tn == "Span" { type_code = "4" }
                                    else if tn == "int" || tn == "bool" || tn == "float" { type_code = "i" }
                                    else if tn == "List" { type_code = "l" }
                                    else { type_code = "p" }
                                    // Store the actual field type name for p-type resolution
                                    forge_enum_variant_fields_set(
                                        enum_name + "." + vname + "." + string(field_count),
                                        tn
                                    )
                                }
                                field_types = field_types + type_code
                                field_count = field_count + 1
                                // Skip the type expression (may have generics like List<Token>)
                                mut tdepth = 0
                                while !self.is_at_end() {
                                    let tk = self.peek_kind_id()
                                    if tk == 216 { tdepth = tdepth + 1 } // <
                                    if tk == 219 { tdepth = tdepth - 1 } // >
                                    if tdepth == 0 && (tk == 123 || tk == 101) { break } // , or )
                                    self.advance()
                                }
                            } else {
                                // No colon — bare field name without type
                                field_types = field_types + "i"
                                field_count = field_count + 1
                            }
                        }
                        // Skip comma
                        if self.peek_kind_id() == 123 { self.advance() }
                        // Safety advance if nothing moved
                        if forge_parser_get_pos() == before_field { self.advance() }
                    }
                    if self.peek_kind_id() == 101 { self.advance() }
                    // Register variant field types in C-side registry
                    let variant_key = enum_name + "." + vname
                    forge_enum_variant_fields_set(variant_key, field_types)
                }
                if field_count > max_fields { max_fields = field_count }
                variant_tag = variant_tag + 1
            } else {
                self.advance()
            }
        }
        if self.peek_kind_id() == 103 { self.advance() }
        // Only register as LLVM type for enums that need struct representation
        // (Statement, Expr, etc. — NOT Type, TokenKind which are used as i64)
        if enum_name == "Statement" || enum_name == "Expr" || enum_name == "BinOp" || enum_name == "UnaryOp" {
            forge_enum_type_register(enum_name, max_fields)
        }
    }

    fn kind_to_key(self, kind: TokenKind) -> string {
        match kind {
            // Keywords
            .Let -> "Let"
            .Mut -> "Mut"
            .Const -> "Const"
            .Fn -> "Fn"
            .Export -> "Export"
            .Enum -> "Enum"
            .TypeKw -> "TypeKw"
            .Use -> "Use"
            .Mod -> "Mod"
            .Trait -> "Trait"
            .Impl -> "Impl"
            .For -> "For"
            .While -> "While"
            .Loop -> "Loop"
            .Break -> "Break"
            .Continue -> "Continue"
            .Defer -> "Defer"
            .Spawn -> "Spawn"
            .Select -> "Select"
            .Component -> "Component"
            .If -> "If"
            .Else -> "Else"
            .Match -> "Match"
            .Return -> "Return"
            .In -> "In"
            .As -> "As"
            .Emit -> "Emit"
            .On -> "On"
            .Errdefer -> "Errdefer"
            .Parallel -> "Parallel"
            .With -> "With"
            .Catch -> "Catch"
            .Without -> "Without"
            .Only -> "Only"
            .Partial -> "Partial"
            .Is -> "Is"
            .Table -> "Table"
            .Null -> "Null"
            .OkKw -> "OkKw"
            .ErrKw -> "ErrKw"
            .NullLiteral -> "NullLiteral"
            .Underscore -> "Underscore"
            // Operators
            .Plus -> "Plus"
            .Minus -> "Minus"
            .Star -> "Star"
            .Slash -> "Slash"
            .Percent -> "Percent"
            .Eq -> "Eq"
            .EqEq -> "EqEq"
            .NotEq -> "NotEq"
            .Lt -> "Lt"
            .LtEq -> "LtEq"
            .Gt -> "Gt"
            .GtEq -> "GtEq"
            .And -> "And"
            .Or -> "Or"
            .Not -> "Not"
            .Pipe -> "Pipe"
            .Arrow -> "Arrow"
            .LeftArrow -> "LeftArrow"
            .Question -> "Question"
            .QuestionDot -> "QuestionDot"
            .DoubleQuestion -> "DoubleQuestion"
            .DotDot -> "DotDot"
            .DotDotEq -> "DotDotEq"
            .Ampersand -> "Ampersand"
            .Bar -> "Bar"
            .Caret -> "Caret"
            .Tilde -> "Tilde"
            .ShiftLeft -> "ShiftLeft"
            .ShiftRight -> "ShiftRight"
            // Delimiters
            .LParen -> "LParen"
            .RParen -> "RParen"
            .LBrace -> "LBrace"
            .RBrace -> "RBrace"
            .LBracket -> "LBracket"
            .RBracket -> "RBracket"
            // Punctuation
            .Comma -> "Comma"
            .Dot -> "Dot"
            .Colon -> "Colon"
            .Semicolon -> "Semicolon"
            .At -> "At"
            .Hash -> "Hash"
            .Spread -> "Spread"
            // Special
            .Newline -> "Newline"
            .Eof -> "Eof"
            _ -> ""
        }
    }

    // ─── Expression Parsing (delegated) ────────
    // See expressions.fg for the full precedence climbing implementation.
    // These are the entry points called by statement parsing.

    fn parse_expr(self) -> Expr? {
        self.parse_pipe_expr()
    }
}
