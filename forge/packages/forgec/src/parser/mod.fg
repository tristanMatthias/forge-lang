// ─── Parser ────────────────────────────────────
// Parses a token stream into an AST.
// Statement dispatch uses the feature registry; expression parsing
// uses precedence climbing defined in expressions.fg.

mod expressions

use core.token.{Token, TokenKind, Span, TemplatePart}
use core.ast.{
    Program, Statement, Expr, Block, BinOp, UnaryOp,
    FeatureStmt, FeatureExpr, NodeRef,
    feature_stmt, feature_expr,
}
use core.types.Type
use core.error.{Diagnostic, error, E_SYNTAX}
use codegen.{CG_B, CG_VAR_NAMES, CG_VAR_PTRS, codegen_new}
use features.while_loops.PARSE_END_POS
use @std.llvm

// ─── Param Type ────────────────────────────────

export type Param = {
    name: string,
    type_ann: TypeExpr?,
    default_value: Expr?,
    span: Span,
    mutable: bool,
}

// ─── Type Expressions ──────────────────────────

export enum TypeExpr {
    Named(name: string, span: Span)
    Generic(name: string, args: List<TypeExpr>, span: Span)
    Nullable(inner: TypeExpr, span: Span)
    Function(params: List<TypeExpr>, return_type: TypeExpr, span: Span)
    Tuple(elements: List<TypeExpr>, span: Span)
    Struct(fields: List<TypeField>, span: Span)
}

export type TypeField = {
    name: string,
    type_expr: TypeExpr,
    mutable: bool,
}

// ─── Parser State ──────────────────────────────

export type Parser = {
    tokens: List<Token>,
    mut pos: int,
    mut diagnostics: List<Diagnostic>,
    source: string,
}

export fn parser_new(tokens: List<Token>) -> Parser {
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: "",
    }
}

export fn parser_new_with_source(tokens: List<Token>, source: string) -> Parser {
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: source,
    }
}

// ─── Parser Methods ────────────────────────────

impl Parser {

    // ─── Token Navigation ──────────────────────

    fn is_at_end(self) -> bool {
        self.pos >= self.tokens.length || self.peek().kind_id == 99
    }

    fn peek(self) -> Token {
        if self.pos < self.tokens.length {
            self.tokens[self.pos]
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
        }
    }

    fn peek_at(self, offset: int) -> Token {
        let idx = self.pos + offset
        if idx < self.tokens.length {
            self.tokens[idx]
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
        }
    }

    fn advance(self) -> Token {
        let tok = self.peek()
        if self.pos < self.tokens.length {
            self.pos = self.pos + 1
        }
        tok
    }

    fn check(self, kind: TokenKind) -> bool {
        // Bootstrap workaround: == on tagged unions compares full payload bytes.
        // Use string key comparison instead.
        let a = self.kind_to_key(self.peek().kind)
        let b = self.kind_to_key(kind)
        a != "" && a == b
    }

    fn expect(self, kind: TokenKind) -> Token? {
        if self.check(kind) {
            self.advance()
        } else {
            self.error("expected token")
            null
        }
    }

    fn expect_ident(self) -> string {
        let tok = self.peek()
        // Bootstrap workaround: use kind_id instead of pattern matching on .Ident(name)
        if tok.kind_id == 1 {
            self.advance()
            return tok.text
        }
        // Keywords that can be used as identifiers
        if tok.kind is .Is {
            self.advance()
            return "is"
        }
        if tok.kind is .Table {
            self.advance()
            return "table"
        }
        if tok.kind is .Underscore {
            self.advance()
            return "_"
        }
        self.error("expected identifier")
        ""
    }

    fn skip_newlines(self) {
        while self.check(TokenKind.Newline) {
            self.advance()
        }
    }

    fn current_span(self) -> Span {
        self.peek().span
    }

    fn error(self, message: string) {
        self.diagnostics = self.diagnostics.push(
            error(E_SYNTAX, message, self.current_span())
        )
    }

    // ─── Peek Helpers ──────────────────────────

    fn peek_at_meaningful(self, n: int) -> Token {
        // Peek at the nth non-newline token
        mut count = 0
        mut offset = 0
        while self.pos + offset < self.tokens.length {
            let tok = self.tokens[self.pos + offset]
            if tok.kind is not .Newline {
                if count == n {
                    return tok
                }
                count = count + 1
            }
            offset = offset + 1
        }
        Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
    }

    fn next_meaningful_is(self, kind: TokenKind) -> bool {
        self.peek_at_meaningful(0).kind == kind
    }

    // ─── Program Parsing ───────────────────────

    fn parse_program(self) -> Program {
        mut statements: List<Statement> = []
        self.skip_newlines()

        while !self.is_at_end() {
            let before = self.pos
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            // Safety: skip token if parser didn't advance
            if self.pos == before {
                self.advance()
            }
            self.skip_newlines()
        }

        Program { statements }
    }

    // ─── Statement Parsing ─────────────────────
    // Check registry first, then fall back to built-in structural statements.

    fn parse_statement(self) -> Statement? {
        self.skip_newlines()
        if self.is_at_end() { return null }

        let tok = self.peek()

        // Hardcoded feature dispatch (bootstrap can't store fn ptrs in Maps)
        // All feature parse fns receive Parser by value — PARSE_END_POS syncs pos back.
        match tok.kind {
            .Let -> {
                let r = parse_let(self)
                self.sync_pos()
                return r
            }
            .Mut -> {
                let r = parse_mut(self)
                self.sync_pos()
                return r
            }
            .Const -> {
                let r = parse_const(self)
                self.sync_pos()
                return r
            }
            .Fn -> {
                let r = parse_fn(self)
                self.sync_pos()
                return r
            }
            .Export -> {
                let r = parse_export(self)
                self.sync_pos()
                return r
            }
            .While -> {
                let r = parse_while(self)
                self.sync_pos()
                return r
            }
            _ -> {}
        }

        // Built-in structural statements
        match tok.kind {
            .Return -> self.parse_return()
            _ -> self.parse_expr_or_assign()
        }
    }

    fn sync_pos(self) {
        if PARSE_END_POS >= 0 {
            self.pos = PARSE_END_POS
            PARSE_END_POS = -1
        }
    }

    fn parse_return(self) -> Statement? {
        let start = self.advance().span // consume 'return'

        // Check if there's a value (not at end of statement)
        if self.is_at_end() || self.check(TokenKind.Newline) || self.check(TokenKind.RBrace) {
            // Bare return — emit void return inline if codegen active
            if CG_B != null {
                llvm.build_ret_void(CG_B)
            }
            return Statement.Expr(Expr.IntLit(0, start))
        }

        let value = self.parse_expr()
        if value == null {
            if CG_B != null {
                llvm.build_ret_void(CG_B)
            }
            return Statement.Expr(Expr.IntLit(0, start))
        }

        // Emit return inline during codegen
        if CG_B != null {
            mut cg = codegen_new()
            let ret_val = cg.emit_expr(value!)
            llvm.build_ret(CG_B, ret_val)
        }
        Statement.Expr(Expr.IntLit(0, start))
    }

    fn parse_expr_or_assign(self) -> Statement? {
        let expr = self.parse_expr()
        if expr == null { return null }

        // Check for assignment: expr = value
        if self.check(TokenKind.Eq) {
            self.advance() // consume =
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '='")
                return null
            }
            // Emit assignment inline during re-parse+codegen
            if CG_B != null {
                // Extract variable name from target (Ident)
                match expr! {
                    .Ident(name, span) -> {
                        mut cg = codegen_new()
                        let val = cg.emit_expr(value!)
                        // Find variable alloca and store
                        mut vi = CG_VAR_NAMES.length - 1
                        while vi >= 0 {
                            if CG_VAR_NAMES[vi] == name {
                                llvm.build_store(CG_B, val, CG_VAR_PTRS[vi])
                                break
                            }
                            vi = vi - 1
                        }
                    }
                    _ -> {}
                }
            }
            // Return a no-op expression statement (assignment already emitted)
            return Statement.Expr(Expr.IntLit(0, Span { start: 0, end: 0, line: 0, col: 0 }))
        }

        // Check for channel send: expr <- value
        if self.check(TokenKind.LeftArrow) {
            self.advance()
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '<-'")
                return null
            }
            // Channel send wraps as an expression statement
            // TODO: create FeatureExpr for channel send
            return Statement.Expr(expr!)
        }

        // Emit expression statement inline during codegen
        if CG_B != null {
            eprintln("[inline_expr] pos=${self.pos} emitting expr stmt")
            mut cg = codegen_new()
            cg.emit_expr(expr!)
        }
        Statement.Expr(Expr.IntLit(0, Span { start: 0, end: 0, line: 0, col: 0 }))
    }

    // ─── Block Parsing ─────────────────────────

    fn parse_block(self) -> Block {
        let start = self.current_span()
        let empty = Block { statements: [], span: start }
        if self.expect(TokenKind.LBrace) == null { return empty }

        self.skip_newlines()
        mut statements: List<Statement> = []

        while !self.check(TokenKind.RBrace) && !self.is_at_end() {
            let before = self.pos
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            if self.pos == before { self.advance() }
            self.skip_newlines()
        }

        self.expect(TokenKind.RBrace)

        Block {
            statements,
            span: Span {
                start: start.start,
                end: self.current_span().end,
                line: start.line,
                col: start.col,
            },
        }
    }

    // Parse a block or wrap a single statement in a block
    fn parse_block_or_stmt(self) -> Block? {
        if self.check(TokenKind.LBrace) {
            self.parse_block()
        } else {
            let start = self.current_span()
            let stmt = self.parse_statement()
            if stmt == null { return null }
            Block {
                statements: [stmt!],
                span: start,
            }
        }
    }

    // ─── Type Expression Parsing ───────────────

    fn parse_type_expr(self) -> TypeExpr? {
        let ty = self.parse_primary_type()
        if ty == null { return null }

        // Check for nullable modifier: Type?
        if self.check(TokenKind.Question) {
            let span = self.advance().span
            return TypeExpr.Nullable(ty!, span)
        }

        ty
    }

    fn parse_primary_type(self) -> TypeExpr? {
        let tok = self.peek()

        // Ident → type name (bootstrap workaround: use kind_id)
        if tok.kind_id == 1 {
            let name = tok.text
            let start = self.advance().span
            // Check for generic: Name<A, B>
            if self.check(TokenKind.Lt) {
                let args = self.parse_type_args()
                if args != null {
                    return TypeExpr.Generic(name, args!, start)
                }
            }
            return TypeExpr.Named(name, start)
        }

        match tok.kind {
            // fn(A, B) -> R
            .Fn -> {
                self.parse_function_type()
            }

            // (A, B) — tuple or parenthesized
            .LParen -> {
                self.parse_tuple_or_paren_type()
            }

            // { name: Type, ... } — struct type
            .LBrace -> {
                self.parse_struct_type()
            }

            _ -> {
                self.error("expected type")
                null
            }
        }
    }

    fn parse_type_args(self) -> List<TypeExpr>? {
        if self.expect(TokenKind.Lt) == null { return null }
        mut args: List<TypeExpr> = []

        while !self.check(TokenKind.Gt) && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                args = args.push(ty!)
            }
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        // Handle >> as > >
        if self.check(TokenKind.ShiftRight) {
            // Split >> into two > tokens — consume one
            // TODO: proper token splitting
            self.advance()
        } else {
            if self.expect(TokenKind.Gt) == null { return null }
        }

        args
    }

    fn parse_function_type(self) -> TypeExpr? {
        let start = self.advance().span // consume 'fn'
        if self.expect(TokenKind.LParen) == null { return null }

        mut params: List<TypeExpr> = []
        while !self.check(TokenKind.RParen) && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                params = params.push(ty!)
            }
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }
        if self.expect(TokenKind.RParen) == null { return null }

        // -> ReturnType
        let ret = if self.check(TokenKind.Arrow) {
            self.advance()
            self.parse_type_expr()
        } else {
            TypeExpr.Named("void", start)
        }

        if ret == null { return null }
        TypeExpr.Function(params, ret!, start)
    }

    fn parse_tuple_or_paren_type(self) -> TypeExpr? {
        let start = self.advance().span // consume (

        if self.check(TokenKind.RParen) {
            self.advance()
            return TypeExpr.Tuple([], start)
        }

        let first = self.parse_type_expr()
        if first == null { return null }

        if self.check(TokenKind.Comma) {
            // Tuple type
            self.advance()
            mut elements: List<TypeExpr> = [first!]
            while !self.check(TokenKind.RParen) && !self.is_at_end() {
                self.skip_newlines()
                let ty = self.parse_type_expr()
                if ty != null {
                    elements = elements.push(ty!)
                }
                if self.check(TokenKind.Comma) {
                    self.advance()
                }
            }
            if self.expect(TokenKind.RParen) == null { return null }

            // Check for -> ReturnType (function type)
            if self.check(TokenKind.Arrow) {
                self.advance()
                let ret = self.parse_type_expr()
                if ret == null { return null }
                return TypeExpr.Function(elements, ret!, start)
            }

            return TypeExpr.Tuple(elements, start)
        }

        if self.expect(TokenKind.RParen) == null { return null }

        // Check for -> ReturnType (single-param function type)
        if self.check(TokenKind.Arrow) {
            self.advance()
            let ret = self.parse_type_expr()
            if ret == null { return null }
            return TypeExpr.Function([first!], ret!, start)
        }

        // Parenthesized type
        first
    }

    fn parse_struct_type(self) -> TypeExpr? {
        let start = self.advance().span // consume {
        mut fields: List<TypeField> = []

        while !self.check(TokenKind.RBrace) && !self.is_at_end() {
            self.skip_newlines()
            let mutable = if self.check(TokenKind.Mut) {
                self.advance()
                true
            } else { false }
            let name = self.expect_ident()
            if name == null { return null }
            if self.expect(TokenKind.Colon) == null { return null }
            let ty = self.parse_type_expr()
            if ty == null { return null }
            fields = fields.push(TypeField { name: name!, type_expr: ty!, mutable })
            self.skip_newlines()
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        if self.expect(TokenKind.RBrace) == null { return null }
        TypeExpr.Struct(fields, start)
    }

    // ─── Parameter Parsing ─────────────────────

    fn parse_params(self) -> List<Param> {
        self.expect(TokenKind.LParen)
        mut params: List<Param> = []

        while !self.check(TokenKind.RParen) && !self.is_at_end() {
            self.skip_newlines()
            let param = self.parse_param()
            if param != null {
                params = params.push(param!)
            }
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        self.expect(TokenKind.RParen)
        params
    }

    fn parse_param(self) -> Param? {
        let start = self.current_span()
        let mutable = if self.check(TokenKind.Mut) {
                self.advance()
                true
            } else { false }
        let name = self.expect_ident()
        if name == null { return null }

        // Optional type annotation: : Type
        let type_ann = if self.check(TokenKind.Colon) {
            self.advance()
            self.parse_type_expr()
        } else {
            null
        }

        // Optional default value: = expr
        let default_value = if self.check(TokenKind.Eq) {
            self.advance()
            self.parse_expr()
        } else {
            null
        }

        Param { name: name!, type_ann, default_value, span: start, mutable }
    }

    // ─── Type Parameters ───────────────────────

    fn parse_type_params(self) -> List<string> {
        if !self.check(TokenKind.Lt) { return [] }
        self.advance() // consume <

        mut params: List<string> = []
        while !self.check(TokenKind.Gt) && !self.is_at_end() {
            self.skip_newlines()
            let name = self.expect_ident()
            if name != null {
                params = params.push(name!)
            }
            // TODO: bounds (T: Clone)
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        if self.expect(TokenKind.Gt) == null { return params }
        params
    }

    // ─── Delimited List Helper ─────────────────

    fn parse_delimited(self, close: TokenKind) -> List<Expr> {
        mut items: List<Expr> = []

        while !self.check(close) && !self.is_at_end() {
            self.skip_newlines()
            let item = self.parse_expr()
            if item != null {
                items = items.push(item!)
            }
            self.skip_newlines()
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        items
    }

    // ─── Token Kind Key ────────────────────────
    // Convert a TokenKind to a string key for registry lookup.

    fn token_kind_key(self, kind: TokenKind) -> string {
        self.kind_to_key(kind)
    }

    fn kind_to_key(self, kind: TokenKind) -> string {
        match kind {
            // Keywords
            .Let -> "Let"
            .Mut -> "Mut"
            .Const -> "Const"
            .Fn -> "Fn"
            .Export -> "Export"
            .Enum -> "Enum"
            .TypeKw -> "TypeKw"
            .Use -> "Use"
            .Mod -> "Mod"
            .Trait -> "Trait"
            .Impl -> "Impl"
            .For -> "For"
            .While -> "While"
            .Loop -> "Loop"
            .Break -> "Break"
            .Continue -> "Continue"
            .Defer -> "Defer"
            .Spawn -> "Spawn"
            .Select -> "Select"
            .Component -> "Component"
            .If -> "If"
            .Else -> "Else"
            .Match -> "Match"
            .Return -> "Return"
            .In -> "In"
            .As -> "As"
            .Emit -> "Emit"
            .On -> "On"
            .Errdefer -> "Errdefer"
            .Parallel -> "Parallel"
            .With -> "With"
            .Catch -> "Catch"
            .Without -> "Without"
            .Only -> "Only"
            .Partial -> "Partial"
            .Is -> "Is"
            .Table -> "Table"
            .Null -> "Null"
            .OkKw -> "OkKw"
            .ErrKw -> "ErrKw"
            .NullLiteral -> "NullLiteral"
            .Underscore -> "Underscore"
            // Operators
            .Plus -> "Plus"
            .Minus -> "Minus"
            .Star -> "Star"
            .Slash -> "Slash"
            .Percent -> "Percent"
            .Eq -> "Eq"
            .EqEq -> "EqEq"
            .NotEq -> "NotEq"
            .Lt -> "Lt"
            .LtEq -> "LtEq"
            .Gt -> "Gt"
            .GtEq -> "GtEq"
            .And -> "And"
            .Or -> "Or"
            .Not -> "Not"
            .Pipe -> "Pipe"
            .Arrow -> "Arrow"
            .LeftArrow -> "LeftArrow"
            .Question -> "Question"
            .QuestionDot -> "QuestionDot"
            .DoubleQuestion -> "DoubleQuestion"
            .DotDot -> "DotDot"
            .DotDotEq -> "DotDotEq"
            .Ampersand -> "Ampersand"
            .Bar -> "Bar"
            .Caret -> "Caret"
            .Tilde -> "Tilde"
            .ShiftLeft -> "ShiftLeft"
            .ShiftRight -> "ShiftRight"
            // Delimiters
            .LParen -> "LParen"
            .RParen -> "RParen"
            .LBrace -> "LBrace"
            .RBrace -> "RBrace"
            .LBracket -> "LBracket"
            .RBracket -> "RBracket"
            // Punctuation
            .Comma -> "Comma"
            .Dot -> "Dot"
            .Colon -> "Colon"
            .Semicolon -> "Semicolon"
            .At -> "At"
            .Hash -> "Hash"
            .Spread -> "Spread"
            // Special
            .Newline -> "Newline"
            .Eof -> "Eof"
            _ -> ""
        }
    }

    // ─── Expression Parsing (delegated) ────────
    // See expressions.fg for the full precedence climbing implementation.
    // These are the entry points called by statement parsing.

    fn parse_expr(self) -> Expr? {
        self.parse_pipe_expr()
    }
}
