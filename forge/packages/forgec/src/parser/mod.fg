// ─── Parser ────────────────────────────────────
// Parses a token stream into an AST.
// Statement dispatch uses the feature registry; expression parsing
// uses precedence climbing defined in expressions.fg.

mod expressions
mod templates

use core.token.{Token, TokenKind, Span, TemplatePart}
use core.ast.{
    Program, Statement, Expr, Block, BinOp, UnaryOp,
    FeatureStmt, FeatureExpr, NodeRef,
    feature_stmt, feature_expr,
}
use core.types.Type
use core.error.{Diagnostic, error, E_SYNTAX}
use codegen.{CG_ACTIVE, CG_LAST_IS_STR, CG_LAST_IS_MAP, CG_HAS_LAST_VAL, CG_LAST_VAL, CG_B, CG_VAR_NAMES, CG_VAR_PTRS, CG_STR_VAR_NAMES, CG_STRUCT_NAMES, CG_STRUCT_TYPES, CG_IS_MAP_INDEX, CG_MAP_INDEX_OBJ, CG_MAP_INDEX_KEY, CG_RT_MAP_SET, CG_PTR, CG_STR, CG_I64, CG_VOID, codegen_new, var_struct_type, CG_FN_RETURNS_NULLABLE, CG_FN_NULLABLE_INNER_TY, wrap_nullable, make_null_value, cg_var_enum_type}
use features.while_loops.{PARSE_END_POS, WHILE_COND_BB, WHILE_END_BB}
use expressions.{LAST_IDENT_NAME, IN_MATCH_ARM, match_enum_tag}

export mut LAST_PARAM_TYPE_NAME: string = "int"
export mut PARSED_PARAM_TYPES: List<string> = []
export mut PARSED_PARAM_NAMES: List<string> = []
use @std.llvm

// ─── Param Type ────────────────────────────────

export type Param = {
    name: string,
    type_ann: TypeExpr?,
    default_value: Expr?,
    span: Span,
    mutable: bool,
}

// ─── Type Expressions ──────────────────────────

export enum TypeExpr {
    Named(name: string, span: Span)
    Generic(name: string, args: List<TypeExpr>, span: Span)
    Nullable(inner: TypeExpr, span: Span)
    Function(params: List<TypeExpr>, return_type: TypeExpr, span: Span)
    Tuple(elements: List<TypeExpr>, span: Span)
    Struct(fields: List<TypeField>, span: Span)
}

export type TypeField = {
    name: string,
    type_expr: TypeExpr,
    mutable: bool,
}

// ─── Parser State ──────────────────────────────

export type Parser = {
    tokens: List<Token>,
    mut pos: int,
    mut diagnostics: List<Diagnostic>,
    source: string,
}

export fn parser_new(tokens: List<Token>) -> Parser {
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: "",
    }
}

export fn parser_new_with_source(tokens: List<Token>, source: string) -> Parser {
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: source,
    }
}

// ─── Parser Methods ────────────────────────────

impl Parser {

    // ─── Token Navigation ──────────────────────

    fn is_at_end(self) -> bool {
        // Use C-side position + token list length (self.pos struct offset may be wrong)
        forge_parser_get_pos() >= forge_token_list_len()
    }

    fn peek(self) -> Token {
        if self.pos < self.tokens.length {
            let tok = self.tokens[self.pos]
            return tok
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
        }
    }

    fn peek_at(self, offset: int) -> Token {
        let idx = self.pos + offset
        if idx < self.tokens.length {
            self.tokens[idx]
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
        }
    }

    fn advance(self) -> Token {
        forge_watchdog(forge_parser_get_pos(), "advance")
        let tok = self.peek()
        // Advance both Forge-side and C-side position
        self.pos = self.pos + 1
        forge_parser_advance_pos()
        tok
    }

    // Check by kind_id integer — no allocation, no function call
    fn check_id(self, kid: int) -> bool {
        forge_watchdog(forge_parser_get_pos(), "check_id")
        if forge_parser_get_pos() >= forge_token_list_len() { return kid == 99 }
        // Use C-side kind_id accessor with C-side position
        forge_peek_kind_id(forge_parser_get_pos()) == kid
    }

    fn check(self, kind: TokenKind) -> bool {
        forge_watchdog(self.pos, "check")
        let tok = self.peek()
        let expected = self.kind_to_id(kind)
        if expected == 0 { return false }
        if tok.kind_id == expected { return true }
        return false
    }

    fn expect_id(self, kid: int) -> Token? {
        if self.check_id(kid) {
            self.advance()
        } else {
            self.error("expected token")
            null
        }
    }

    fn expect(self, kind: TokenKind) -> Token? {
        let kid = self.kind_to_id(kind)
        if kid > 0 {
            return self.expect_id(kid)
        }
        if self.check(kind) {
            self.advance()
        } else {
            self.error("expected token")
            null
        }
    }

    fn expect_ident(self) -> string {
        // Entirely C-side: forge_expect_ident advances C-side pos + returns text
        // Advance Forge-side pos AFTER (to keep in sync)
        // forge_expect_ident checks kind_id and returns text or empty
        self.advance()
        // Return the text from C-side (forge_expect_ident was called during advance indirectly)
        // Actually, use forge_peek_text at the PREVIOUS position
        forge_peek_text(forge_parser_get_pos() - 1)
    }

    fn _old_expect_ident(self) -> string {
        let tok = self.peek()
        if tok.kind_id == 1 {
            self.advance()
            return tok.text
        }
        if tok.kind_id == 60 {
            self.advance()
            return "_"
        }
        // Keywords that can be used as identifiers
        if tok.kind is .Is {
            self.advance()
            return "is"
        }
        if tok.kind is .Table {
            self.advance()
            return "table"
        }
        if tok.kind is .Underscore {
            self.advance()
            return "_"
        }
        // Keywords used as enum variant names — use tok.text instead of kind matching
        // (bootstrap's large enum match is broken for high variant indices)
        let txt = tok.text
        if txt == "match" { self.advance()
            return "Match" }
        if txt == "while" { self.advance()
            return "While" }
        if txt == "for" { self.advance()
            return "For" }
        if txt == "break" { self.advance()
            return "Break" }
        if txt == "continue" { self.advance()
            return "Continue" }
        if txt == "if" { self.advance()
            return "If" }
        if txt == "return" { self.advance()
            return "Return" }
        if txt == "let" { self.advance()
            return "Let" }
        if txt == "mut" { self.advance()
            return "Mut" }
        if txt == "fn" { self.advance()
            return "Fn" }
        if txt == "enum" { self.advance()
            return "Enum" }
        if txt == "struct" { self.advance()
            return "Struct" }
        if txt == "impl" { self.advance()
            return "Impl" }
        if txt == "use" { self.advance()
            return "Use" }
        if txt == "mod" { self.advance()
            return "Mod" }
        self.error("expected identifier")
        ""
    }

    fn skip_newlines(self) {
        while self.check_id(120) {
            self.advance()
        }
    }

    // Skip tokens until matching closing brace (handles nesting).
    // Assumes opening { was already consumed. Consumes the closing }.
    fn skip_to_matching_brace(self) {
        mut depth = 1
        while depth > 0 && !self.is_at_end() {
            if self.check_id(102) {
                depth = depth + 1
            }
            if self.check_id(103) {
                depth = depth - 1
            }
            self.advance()
        }
    }

    fn current_span(self) -> Span {
        self.peek().span
    }

    fn error(self, message: string) {
        self.diagnostics = self.diagnostics.push(
            error(E_SYNTAX, message, self.current_span())
        )
    }

    // ─── Peek Helpers ──────────────────────────

    fn peek_at_meaningful(self, n: int) -> Token {
        // Peek at the nth non-newline token
        mut count = 0
        mut offset = 0
        while self.pos + offset < self.tokens.length {
            let tok = self.tokens[self.pos + offset]
            if tok.kind is not .Newline {
                if count == n {
                    return tok
                }
                count = count + 1
            }
            offset = offset + 1
        }
        Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
    }

    fn next_meaningful_is(self, kind: TokenKind) -> bool {
        self.peek_at_meaningful(0).kind == kind
    }

    // ─── Program Parsing ───────────────────────

    fn parse_program(self) -> Program {
        mut statements: List<Statement> = []
        // Reset C-side position + set parser pointer for diagnostics
        forge_parser_set_ptr(self)
        forge_parser_set_pos(0)
        eprintln("  [parse_program] c_len=" + string(forge_token_list_len()) + " kid0=" + string(forge_peek_kind_id(0)) + " cpos=" + string(forge_parser_get_pos()))
        self.skip_newlines()
        eprintln("  [parse_program] after skip_nl cpos=" + string(forge_parser_get_pos()) + " kid=" + string(forge_peek_kind_id(forge_parser_get_pos())))

        while !self.is_at_end() {
            eprintln("  [pp_loop] pos=" + string(forge_parser_get_pos()) + " kid=" + string(forge_peek_kind_id(forge_parser_get_pos())))
            CG_ACTIVE = false
            // Use C-side position for safety check (self.pos corrupted in Stage 2)
            mut before_pos = forge_parser_get_pos()
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            // Safety: skip token if parser didn't advance
            if forge_parser_get_pos() == before_pos {
                self.advance()
            }
            self.skip_newlines()
        }

        Program { statements }
    }

    // ─── Statement Parsing ─────────────────────
    // Check registry first, then fall back to built-in structural statements.

    fn parse_statement(self) -> Statement? {
        self.skip_newlines()
        if self.is_at_end() { return null }

        let tok = self.peek()

        // Reset type flags at statement boundary
        CG_LAST_IS_STR = 0
        CG_LAST_IS_MAP = 0
        CG_IS_MAP_INDEX = 0

        // kind_id fast dispatch — try tok.kind_id first (works in Stage 1)
        // In Stage 2, tok.kind_id is garbage, so we also check forge_peek_kind_id
        // which reads directly from token list memory at correct offset
        forge_parser_set_pos(self.pos)
        if tok.kind_id == 20 || forge_peek_kind_id(forge_parser_get_pos()) == 20 { let r = parse_let(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 21 || forge_peek_kind_id(forge_parser_get_pos()) == 21 { let r = parse_mut(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 22 || forge_peek_kind_id(forge_parser_get_pos()) == 22 { let r = parse_const(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 23 || forge_peek_kind_id(forge_parser_get_pos()) == 23 { let r = parse_fn(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 39 || forge_peek_kind_id(forge_parser_get_pos()) == 39 { let r = parse_export(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 30 || forge_peek_kind_id(forge_parser_get_pos()) == 30 { let r = parse_while(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 28 || forge_peek_kind_id(forge_parser_get_pos()) == 28 { let r = parse_for(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 43 || forge_peek_kind_id(forge_parser_get_pos()) == 43 { let r = parse_impl_block(self)  // Impl
            self.sync_pos()
            return r }
        if tok.kind_id == 34 || forge_peek_kind_id(forge_parser_get_pos()) == 34 { let r = parse_enum_decl(self)  // Enum
            self.sync_pos()
            return r }
        if tok.kind_id == 35 || forge_peek_kind_id(forge_parser_get_pos()) == 35 {  // TypeKw
            let r = parse_type_decl(self)
            self.sync_pos()
            return r }
        if tok.kind_id == 42 || forge_peek_kind_id(forge_parser_get_pos()) == 42 {  // Trait - skip
            self.advance()
            self.expect_ident()
            while !self.check_id(103) && !self.is_at_end() { self.advance() }
            if self.check_id(103) { self.advance() }
            return Statement.Expr(Expr.IntLit(0, tok.span)) }
        if tok.kind_id == 36 || forge_peek_kind_id(forge_parser_get_pos()) == 36 {  // Use - skip
            self.advance()
            while !self.is_at_end() && !self.check_id(120) { self.advance() }
            return Statement.Expr(Expr.IntLit(0, tok.span)) }
        if tok.kind_id == 37 || forge_peek_kind_id(forge_parser_get_pos()) == 37 {  // Mod - skip
            self.advance()
            self.expect_ident()
            return Statement.Expr(Expr.IntLit(0, tok.span)) }
        // Return (24), Break (32), Continue (33) — fast dispatch
        if tok.kind_id == 24 || forge_peek_kind_id(forge_parser_get_pos()) == 24 { return self.parse_return() }
        if tok.kind_id == 32 || forge_peek_kind_id(forge_parser_get_pos()) == 32 {  // Break
            self.advance()
            if CG_ACTIVE && WHILE_END_BB != null {
                llvm.build_br(CG_B, WHILE_END_BB)
            }
            return Statement.Expr(Expr.IntLit(0, tok.span)) }
        if tok.kind_id == 33 || forge_peek_kind_id(forge_parser_get_pos()) == 33 {  // Continue
            self.advance()
            if CG_ACTIVE && WHILE_COND_BB != null {
                llvm.build_br(CG_B, WHILE_COND_BB)
            }
            return Statement.Expr(Expr.IntLit(0, tok.span)) }
        // If (25) — inline handler
        if tok.kind_id == 25 || forge_peek_kind_id(forge_parser_get_pos()) == 25 {
            if !CG_ACTIVE {
                let start = self.advance().span
                self.skip_newlines()
                let cond = self.parse_expr()
                if cond == null { return null }
                self.skip_newlines()
                let then_block = self.parse_block()
                self.skip_newlines()
                mut has_else = 0
                mut else_block = Block { statements: [], span: start }
                if self.check_id(26) {  // Else
                    has_else = 1
                    self.advance()
                    self.skip_newlines()
                    if self.check_id(25) {  // else if
                        let nested = self.parse_statement()
                        if nested != null {
                            mut stmts: List<Statement> = []
                            stmts = stmts.push(nested!)
                            else_block = Block { statements: stmts, span: start }
                        }
                    } else {
                        else_block = self.parse_block()
                    }
                }
                return Statement.If(cond!, then_block, else_block, has_else, start)
            }
            return self.parse_expr_or_assign()
        }
        // Match (27) — inline handler
        if tok.kind_id == 27 || forge_peek_kind_id(forge_parser_get_pos()) == 27 {
            if !CG_ACTIVE {
                let start = self.advance().span
                self.skip_newlines()
                let scrutinee = self.parse_expr()
                if scrutinee == null { return null }
                let scrutinee_var = LAST_IDENT_NAME
                self.skip_newlines()
                if self.expect_id(102) == null { return null }
                self.skip_newlines()
                let enum_type = cg_var_enum_type(scrutinee_var)
                mut arm_tags: List<int> = []
                mut arm_bodies: List<Block> = []
                mut arm_bindings_list: List<string> = []
                mut has_default = 0
                mut default_body = Block { statements: [], span: start }
                while !self.check_id(103) && !self.is_at_end() {
                    self.skip_newlines()
                    mut pat_tag = -1
                    mut arm_bind_csv = ""
                    if self.check_id(111) {
                        self.advance()
                        let vname = self.expect_ident()
                        let qname = enum_type + "." + vname
                        arm_bind_csv = qname + ":"
                        pat_tag = match_enum_tag(qname)
                        if pat_tag < 0 { pat_tag = match_enum_tag(vname) }
                        if self.check_id(100) {
                            self.advance()
                            mut bind_idx = 0
                            while !self.check_id(101) && !self.is_at_end() {
                                let bname = self.expect_ident()
                                if bname != "" && bname != "_" {
                                    if bind_idx > 0 { arm_bind_csv = arm_bind_csv + "," }
                                    arm_bind_csv = arm_bind_csv + bname
                                } else {
                                    if bind_idx > 0 { arm_bind_csv = arm_bind_csv + "," }
                                    arm_bind_csv = arm_bind_csv + "_"
                                }
                                bind_idx = bind_idx + 1
                                if self.check_id(110) { self.advance() }
                                self.skip_newlines()
                            }
                            if self.check_id(101) { self.advance() }
                        }
                    } else if self.check_id(60) {
                        self.advance()
                        pat_tag = -1
                        has_default = 1
                    } else {
                        self.advance()
                    }
                    self.skip_newlines()
                    if self.check_id(86) { self.advance() }
                    self.skip_newlines()
                    let prev_match = IN_MATCH_ARM
                    IN_MATCH_ARM = true
                    mut body = Block { statements: [], span: start }
                    if self.check_id(102) {
                        body = self.parse_block()
                    } else {
                        let e = self.parse_expr()
                        if e != null {
                            mut body_stmts: List<Statement> = []
                            body_stmts = body_stmts.push(Statement.Expr(e!))
                            body = Block { statements: body_stmts, span: start }
                        }
                    }
                    IN_MATCH_ARM = prev_match
                    if pat_tag == -1 && has_default == 1 {
                        default_body = body
                    } else {
                        arm_tags = arm_tags.push(pat_tag)
                        arm_bodies = arm_bodies.push(body)
                        arm_bindings_list = arm_bindings_list.push(arm_bind_csv)
                    }
                    self.skip_newlines()
                    if self.check_id(110) { self.advance() }
                    self.skip_newlines()
                }
                if self.check_id(103) { self.advance() }
                mut tag_csv = ""
                mut ti = 0
                while ti < arm_tags.length {
                    if ti > 0 { tag_csv = tag_csv + "," }
                    tag_csv = tag_csv + string(arm_tags[ti])
                    ti = ti + 1
                }
                mut bindings_csv = ""
                mut bi = 0
                while bi < arm_bindings_list.length {
                    if bi > 0 { bindings_csv = bindings_csv + ";" }
                    bindings_csv = bindings_csv + arm_bindings_list[bi]
                    bi = bi + 1
                }
                return Statement.Match(scrutinee!, tag_csv, bindings_csv, arm_bodies, default_body, has_default, start)
            }
            return self.parse_expr_or_assign()
        }
        // Catch-all: any token not handled above is an expression or assignment
        // This replaces the broken `_ ->` match arm in mini-built binaries
        if tok.kind_id == 1 || forge_peek_kind_id(forge_parser_get_pos()) == 1 || forge_peek_kind_id(forge_parser_get_pos()) == 2 || forge_peek_kind_id(forge_parser_get_pos()) == 3 || forge_peek_kind_id(forge_parser_get_pos()) == 4 || forge_peek_kind_id(forge_parser_get_pos()) == 5 || forge_peek_kind_id(forge_parser_get_pos()) == 6 || forge_peek_kind_id(forge_parser_get_pos()) == 7 || forge_peek_kind_id(forge_parser_get_pos()) == 8 || forge_peek_kind_id(forge_parser_get_pos()) == 100 || forge_peek_kind_id(forge_parser_get_pos()) == 84 || forge_peek_kind_id(forge_parser_get_pos()) == 71 {
            // Ident(1), IntLit(2), FloatLit(3), StringLit(4), BoolLit(5), TemplateLit(6), DollarStr(7), NullLit(8), LParen(100), Not(84), Minus(71)
            return self.parse_expr_or_assign()
        }
        // Fallback to pattern match (Rust compiler only — mini binary uses kind_id dispatch above)

        match tok.kind {
            .Let -> {
                let r = parse_let(self)
                self.sync_pos()
                return r
            }
            .Mut -> {
                let r = parse_mut(self)
                self.sync_pos()
                return r
            }
            .Const -> {
                let r = parse_const(self)
                self.sync_pos()
                return r
            }
            .Fn -> {
                let r = parse_fn(self)
                self.sync_pos()
                return r
            }
            .Export -> {
                let r = parse_export(self)
                self.sync_pos()
                return r
            }
            .While -> {
                let r = parse_while(self)
                self.sync_pos()
                return r
            }
            .For -> {
                let r = parse_for(self)
                self.sync_pos()
                return r
            }
            .If -> {
                if !CG_ACTIVE {
                    // Parse if-statement as Statement.If (avoids PENDING_IF forward refs)
                    let start = self.advance().span // consume 'if'
                    self.skip_newlines()
                    let cond = self.parse_expr()
                    if cond == null { return null }
                    self.skip_newlines()
                    let then_block = self.parse_block()
                    self.skip_newlines()
                    mut has_else = 0
                    mut else_block = Block { statements: [], span: start }
                    if self.check_id(26) {
                        has_else = 1
                        self.advance()
                        self.skip_newlines()
                        if self.check_id(25) {
                            // else-if chain: parse recursively as statement
                            let nested = self.parse_statement()
                            if nested != null {
                                else_block = Block { statements: [nested!], span: start }
                            }
                        } else {
                            else_block = self.parse_block()
                        }
                    }
                    return Statement.If(cond!, then_block, else_block, has_else, start)
                }
                // CG_ACTIVE: fall through to expression parser (inline emit)
                return self.parse_expr_or_assign()
            }
            .Match -> {
                if !CG_ACTIVE {
                    // Parse match-statement as Statement.Match (avoids PENDING_MATCH forward refs)
                    let start = self.advance().span // consume 'match'
                    self.skip_newlines()
                    let scrutinee = self.parse_expr()
                    if scrutinee == null { return null }
                    let scrutinee_var = LAST_IDENT_NAME
                    self.skip_newlines()
                    if self.expect_id(102) == null { return null }
                    self.skip_newlines()

                    let enum_type = cg_var_enum_type(scrutinee_var)
                    mut arm_tags: List<int> = []
                    mut arm_bodies: List<Block> = []
                    mut arm_bindings_list: List<string> = []
                    mut has_default = 0
                    mut default_body = Block { statements: [], span: start }

                    while !self.check_id(103) && !self.is_at_end() {
                        self.skip_newlines()
                        mut pat_tag = -1
                        mut arm_bind_csv = ""
                        if self.check_id(111) {
                            self.advance()
                            let vname = self.expect_ident()
                            let qname = enum_type + "." + vname
                            // Store variant qualified name for field type lookup
                            arm_bind_csv = qname + ":"
                            pat_tag = match_enum_tag(qname)
                            if pat_tag < 0 { pat_tag = match_enum_tag(vname) }
                            // Capture binding names
                            if self.check_id(100) {
                                self.advance()
                                mut bind_idx = 0
                                while !self.check_id(101) && !self.is_at_end() {
                                    let bname = self.expect_ident()
                                    if bname != "" && bname != "_" {
                                        if bind_idx > 0 { arm_bind_csv = arm_bind_csv + "," }
                                        arm_bind_csv = arm_bind_csv + bname
                                    } else {
                                        if bind_idx > 0 { arm_bind_csv = arm_bind_csv + "," }
                                        arm_bind_csv = arm_bind_csv + "_"
                                    }
                                    bind_idx = bind_idx + 1
                                    if self.check_id(110) { self.advance() }
                                    self.skip_newlines()
                                }
                                if self.check_id(101) { self.advance() }
                            }
                        } else if self.check_id(60) {
                            self.advance()
                            pat_tag = -1
                            has_default = 1
                        } else {
                            self.advance()
                        }
                        self.skip_newlines()
                        if self.check_id(86) { self.advance() }
                        self.skip_newlines()
                        let prev_match = IN_MATCH_ARM
                        IN_MATCH_ARM = true
                        mut body = Block { statements: [], span: start }
                        let _body_start = self.pos
                        if self.check_id(102) {
                            body = self.parse_block()
                        } else {
                            let e = self.parse_expr()
                            if e != null {
                                mut body_stmts: List<Statement> = []
                                body_stmts = body_stmts.push(Statement.Expr(e!))
                                body = Block { statements: body_stmts, span: start }
                            }
                        }
                        eprintln("  ARM_BODY " + string(_body_start) + "→" + string(self.pos) + " tag=" + string(pat_tag))
                        IN_MATCH_ARM = prev_match
                        if pat_tag == -1 && has_default == 1 {
                            default_body = body
                        } else {
                            arm_tags = arm_tags.push(pat_tag)
                            arm_bodies = arm_bodies.push(body)
                            arm_bindings_list = arm_bindings_list.push(arm_bind_csv)
                        }
                        self.skip_newlines()
                        if self.check_id(110) { self.advance() }
                        self.skip_newlines()
                    }
                    if self.check_id(103) { self.advance() }

                    // Build tag CSV
                    mut tag_csv = ""
                    mut ti = 0
                    while ti < arm_tags.length {
                        if ti > 0 { tag_csv = tag_csv + "," }
                        tag_csv = tag_csv + string(arm_tags[ti])
                        ti = ti + 1
                    }

                    // Build bindings CSV (semicolons between arms)
                    mut bindings_csv = ""
                    mut bi = 0
                    while bi < arm_bindings_list.length {
                        if bi > 0 { bindings_csv = bindings_csv + ";" }
                        bindings_csv = bindings_csv + arm_bindings_list[bi]
                        bi = bi + 1
                    }

                    return Statement.Match(scrutinee!, tag_csv, bindings_csv, arm_bodies, default_body, has_default, start)
                }
                // CG_ACTIVE: fall through to expression parser (inline emit)
                return self.parse_expr_or_assign()
            }
            .TypeKw -> {
                let r = parse_type_decl(self)
                self.sync_pos()
                return r
            }
            .Enum -> {
                let r = parse_enum_decl(self)
                self.sync_pos()
                return r
            }
            .Impl -> {
                let r = parse_impl_block(self)
                self.sync_pos()
                return r
            }
            .Use -> {
                // Skip 'use' statements — module imports are no-op in single-file mode
                self.advance() // consume 'use'
                // Skip until newline or end
                while !self.is_at_end() && !self.check_id(120) {
                    self.advance()
                }
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Mod -> {
                // Skip 'mod' declarations — no-op in single-file mode
                self.advance() // consume 'mod'
                self.expect_ident() // consume module name
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Trait -> {
                // Skip trait declarations — parse and discard
                self.advance() // consume 'trait'
                self.expect_ident() // trait name
                if self.check_id(102) {
                    self.parse_block() // skip body
                }
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            _ -> {}
        }

        // Built-in structural statements
        match tok.kind {
            .Return -> {
                self.parse_return()
            }
            .Break -> {
                self.advance() // consume 'break'
                if CG_ACTIVE && WHILE_END_BB != null {
                    llvm.build_br(CG_B, WHILE_END_BB)
                }
                Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Continue -> {
                self.advance() // consume 'continue'
                if CG_ACTIVE && WHILE_COND_BB != null {
                    llvm.build_br(CG_B, WHILE_COND_BB)
                }
                Statement.Expr(Expr.IntLit(0, tok.span))
            }
            _ -> {
                self.parse_expr_or_assign()
            }
        }
    }

    fn sync_pos(self) {
        eprintln("  [sync_pos] PARSE_END_POS=" + string(PARSE_END_POS) + " c_pos=" + string(forge_parser_get_pos()))
        if PARSE_END_POS >= 0 {
            self.pos = PARSE_END_POS
            forge_parser_set_pos(PARSE_END_POS)
            PARSE_END_POS = -1
        }
    }

    fn parse_return(self) -> Statement? {
        let start = self.advance().span // consume 'return'

        // Bare return (no value)
        if self.is_at_end() || self.check_id(120) || self.check_id(103) {
            return Statement.Return(Expr.NullLit(start), start)
        }

        // return null
        let pk = self.peek()
        let pk_key = self.kind_to_key(pk.kind)
        if pk_key == "NullLiteral" {
            self.advance() // consume 'null'
            return Statement.Return(Expr.NullLit(start), start)
        }

        let value = self.parse_expr()
        if value == null {
            return Statement.Return(Expr.NullLit(start), start)
        }

        Statement.Return(value!, start)
    }

    fn parse_expr_or_assign(self) -> Statement? {
        let expr = self.parse_expr()
        if expr == null { return null }

        // Check for assignment: expr = value
        if self.check_id(75) {
            // Save target variable name before RHS parsing overwrites LAST_IDENT_NAME
            let assign_target_name = LAST_IDENT_NAME
            let eq_span = self.advance().span // consume =
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '='")
                return null
            }
            // Emit store inline so subsequent statements see the updated value
            if CG_ACTIVE {
                mut cg = codegen_new()
                let rhs_val = cg.emit_expr(value!)
                // Map index assignment: m["key"] = value → forge_map_set
                if CG_IS_MAP_INDEX == 1 {
                    CG_IS_MAP_INDEX = 0
                    let set_args = llvm.value_array_new(3)
                    llvm.value_array_set(set_args, 0, CG_MAP_INDEX_OBJ)
                    llvm.value_array_set(set_args, 1, CG_MAP_INDEX_KEY)
                    llvm.value_array_set(set_args, 2, rhs_val)
                    let set_pt = llvm.type_array_new(3)
                    llvm.type_array_set(set_pt, 0, CG_PTR)
                    llvm.type_array_set(set_pt, 1, CG_STR)
                    llvm.type_array_set(set_pt, 2, CG_I64)
                    let set_ft = llvm.function_type(CG_VOID, set_pt, 3, 0)
                    llvm.type_array_free(set_pt)
                    llvm.build_call(CG_B, set_ft, CG_RT_MAP_SET, set_args, 3, "")
                    llvm.value_array_free(set_args)
                } else if assign_target_name != "" {
                    // Regular variable assignment
                    mut vi = CG_VAR_NAMES.length - 1
                    while vi >= 0 {
                        if CG_VAR_NAMES[vi] == assign_target_name {
                            llvm.build_store(CG_B, rhs_val, CG_VAR_PTRS[vi])
                            break
                        }
                        vi = vi - 1
                    }
                }
            }
            return Statement.Assign(expr!, value!, eq_span)
        }

        // Check for channel send: expr <- value
        if self.check_id(87) {
            self.advance()
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '<-'")
                return null
            }
            return Statement.Expr(expr!)
        }

        Statement.Expr(expr!)
    }

    // ─── Block Parsing ─────────────────────────

    fn parse_block(self) -> Block {
        let start = self.current_span()
        let empty = Block { statements: [], span: start }
        let pb_open_pos = self.pos
        if self.expect_id(102) == null {
            eprintln("PB_NO_BRACE pos=" + string(pb_open_pos))
            return empty
        }

        self.skip_newlines()
        mut statements: List<Statement> = []
        mut _pb_count = 0

        while !self.check_id(103) && !self.is_at_end() {
            let before = self.pos
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            if self.pos == before {
                eprintln("PB_STUCK pos=" + string(self.pos) + " tok=" + self.peek().text)
                self.advance()
            }
            _pb_count = _pb_count + 1
            self.skip_newlines()
        }

        self.expect_id(103)

        Block {
            statements,
            span: Span {
                start: start.start,
                end: self.current_span().end,
                line: start.line,
                col: start.col,
            },
        }
    }

    // Parse a block and return the last emitted LLVM value (for match-as-expression)
    fn parse_block_for_value(self, cg: Codegen) -> ptr {
        let block = self.parse_block()
        // The last emitted value might be in CG_LAST_VAL
        if CG_HAS_LAST_VAL == 1 { return CG_LAST_VAL }
        llvm.const_int(CG_I64, 0, 0)
    }

    // Parse a block or wrap a single statement in a block
    fn parse_block_or_stmt(self) -> Block? {
        if self.check_id(102) {
            self.parse_block()
        } else {
            let start = self.current_span()
            let stmt = self.parse_statement()
            if stmt == null { return null }
            Block {
                statements: [stmt!],
                span: start,
            }
        }
    }

    // ─── Type Expression Parsing ───────────────

    fn parse_type_expr(self) -> TypeExpr? {
        let ty = self.parse_primary_type()
        if ty == null { return null }

        // Check for nullable modifier: Type?
        if self.check_id(88) {
            let span = self.advance().span
            return TypeExpr.Nullable(ty!, span)
        }

        ty
    }

    fn parse_primary_type(self) -> TypeExpr? {
        let tok = self.peek()

        // Ident → type name (bootstrap workaround: use kind_id)
        if tok.kind_id == 1 {
            let name = tok.text
            let start = self.advance().span
            // Check for generic: Name<A, B>
            if self.check_id(78) {
                let args = self.parse_type_args()
                if args != null {
                    return TypeExpr.Generic(name, args!, start)
                }
            }
            return TypeExpr.Named(name, start)
        }

        match tok.kind {
            // fn(A, B) -> R
            .Fn -> {
                self.parse_function_type()
            }

            // (A, B) — tuple or parenthesized
            .LParen -> {
                self.parse_tuple_or_paren_type()
            }

            // { name: Type, ... } — struct type
            .LBrace -> {
                self.parse_struct_type()
            }

            _ -> {
                self.error("expected type")
                null
            }
        }
    }

    fn parse_type_args(self) -> List<TypeExpr>? {
        if self.expect_id(78) == null { return null }
        mut args: List<TypeExpr> = []

        while !self.check_id(80) && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                args = args.push(ty!)
            }
            if self.check_id(110) {
                self.advance()
            }
        }

        // Handle >> as > >
        if self.check_id(98) {
            // Split >> into two > tokens — consume one
            // TODO: proper token splitting
            self.advance()
        } else {
            if self.expect_id(80) == null { return null }
        }

        args
    }

    fn parse_function_type(self) -> TypeExpr? {
        let start = self.advance().span // consume 'fn'
        if self.expect_id(100) == null { return null }

        mut params: List<TypeExpr> = []
        while !self.check_id(101) && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                params = params.push(ty!)
            }
            if self.check_id(110) {
                self.advance()
            }
        }
        if self.expect_id(101) == null { return null }

        // -> ReturnType
        mut ret: TypeExpr? = TypeExpr.Named("void", start)
        if self.check_id(86) {
            self.advance()
            ret = self.parse_type_expr()
        }

        if ret == null { return null }
        TypeExpr.Function(params, ret!, start)
    }

    fn parse_tuple_or_paren_type(self) -> TypeExpr? {
        let start = self.advance().span // consume (

        if self.check_id(101) {
            self.advance()
            return TypeExpr.Tuple([], start)
        }

        let first = self.parse_type_expr()
        if first == null { return null }

        if self.check_id(110) {
            // Tuple type
            self.advance()
            mut elements: List<TypeExpr> = [first!]
            while !self.check_id(101) && !self.is_at_end() {
                self.skip_newlines()
                let ty = self.parse_type_expr()
                if ty != null {
                    elements = elements.push(ty!)
                }
                if self.check_id(110) {
                    self.advance()
                }
            }
            if self.expect_id(101) == null { return null }

            // Check for -> ReturnType (function type)
            if self.check_id(86) {
                self.advance()
                let ret = self.parse_type_expr()
                if ret == null { return null }
                return TypeExpr.Function(elements, ret!, start)
            }

            return TypeExpr.Tuple(elements, start)
        }

        if self.expect_id(101) == null { return null }

        // Check for -> ReturnType (single-param function type)
        if self.check_id(86) {
            self.advance()
            let ret = self.parse_type_expr()
            if ret == null { return null }
            return TypeExpr.Function([first!], ret!, start)
        }

        // Parenthesized type
        first
    }

    fn parse_struct_type(self) -> TypeExpr? {
        let start = self.advance().span // consume {
        mut fields: List<TypeField> = []

        while !self.check_id(103) && !self.is_at_end() {
            self.skip_newlines()
            mut mutable = false
            if self.check_id(21) {
                self.advance()
                mutable = true
            }
            let name = self.expect_ident()
            if name == null { return null }
            if self.expect_id(112) == null { return null }
            let ty = self.parse_type_expr()
            if ty == null { return null }
            fields = fields.push(TypeField { name: name!, type_expr: ty!, mutable })
            self.skip_newlines()
            if self.check_id(110) {
                self.advance()
            }
        }

        if self.expect_id(103) == null { return null }
        TypeExpr.Struct(fields, start)
    }

    // ─── Parameter Parsing ─────────────────────

    fn parse_params(self) -> List<Param> {
        PARSED_PARAM_TYPES = []
        PARSED_PARAM_NAMES = []
        // Consume ( — function call must be in a condition to survive Stage 2 compilation
        // (standalone expression statements are dropped when Statement.Expr tag is wrong)
        if forge_parser_expect_id(100) >= 0 { self.pos = forge_parser_get_pos() }
        mut params: List<Param> = []

        while forge_parser_is_at_rparen() == 0 {
            self.skip_newlines()
            let before_pos = self.pos
            let param = self.parse_param()
            if param != null {
                params = params.push(param!)
            }
            if self.check_id(110) {
                self.advance()
            }
            // Safety: if parse_param didn't advance, skip one token to avoid infinite loop
            if self.pos == before_pos {
                eprintln("  [WARN] parse_params stuck at pos=" + string(self.pos) + " kind_id=" + string(self.peek().kind_id) + " text=" + self.peek().text)
                self.advance()
            }
        }

        // Consume ) — in condition to survive Stage 2
        if forge_parser_expect_id(101) >= 0 { self.pos = forge_parser_get_pos() }
        params
    }

    fn parse_param(self) -> Param? {
        let start = self.current_span()
        mut mutable = false
        if self.check_id(21) {
            self.advance()
            mutable = true
        }
        let name = self.expect_ident()
        if name == null { return null }

        // Optional type annotation: : Type
        // Capture the type name text before parsing (for struct type lookup)
        mut type_name_text = "int"  // default
        mut type_ann: TypeExpr? = null
        if self.check_id(112) {
            self.advance()
            // Capture the next token's text as the type name
            let type_tok = self.peek()
            if type_tok.kind_id == 1 {
                type_name_text = type_tok.text
            }
            type_ann = self.parse_type_expr()
        }
        // Store the type name for function param type tracking
        LAST_PARAM_TYPE_NAME = type_name_text
        PARSED_PARAM_TYPES = PARSED_PARAM_TYPES.push(type_name_text)
        PARSED_PARAM_NAMES = PARSED_PARAM_NAMES.push(name!)

        // Optional default value: = expr
        mut default_value: Expr? = null
        if self.check_id(75) {
            self.advance()
            default_value = self.parse_expr()
        }

        Param { name: name!, type_ann, default_value, span: start, mutable }
    }

    // ─── Type Parameters ───────────────────────

    fn parse_type_params(self) -> List<string> {
        if !self.check_id(78) { return [] }
        self.advance() // consume <

        mut params: List<string> = []
        while !self.check_id(80) && !self.is_at_end() {
            self.skip_newlines()
            let name = self.expect_ident()
            if name != null {
                params = params.push(name!)
            }
            // TODO: bounds (T: Clone)
            if self.check_id(110) {
                self.advance()
            }
        }

        if self.expect_id(80) == null { return params }
        params
    }

    // ─── Delimited List Helper ─────────────────

    fn parse_delimited(self, close: TokenKind) -> List<Expr> {
        mut items: List<Expr> = []

        while !self.check(close) && !self.is_at_end() {
            self.skip_newlines()
            let item = self.parse_expr()
            if item != null {
                items = items.push(item!)
            }
            self.skip_newlines()
            if self.check_id(110) {
                self.advance()
            }
        }

        items
    }

    // ─── Token Kind Key ────────────────────────
    // Convert a TokenKind to a string key for registry lookup.

    fn token_kind_key(self, kind: TokenKind) -> string {
        self.kind_to_key(kind)
    }

    fn kind_to_key(self, kind: TokenKind) -> string {
        match kind {
            // Keywords
            .Let -> "Let"
            .Mut -> "Mut"
            .Const -> "Const"
            .Fn -> "Fn"
            .Export -> "Export"
            .Enum -> "Enum"
            .TypeKw -> "TypeKw"
            .Use -> "Use"
            .Mod -> "Mod"
            .Trait -> "Trait"
            .Impl -> "Impl"
            .For -> "For"
            .While -> "While"
            .Loop -> "Loop"
            .Break -> "Break"
            .Continue -> "Continue"
            .Defer -> "Defer"
            .Spawn -> "Spawn"
            .Select -> "Select"
            .Component -> "Component"
            .If -> "If"
            .Else -> "Else"
            .Match -> "Match"
            .Return -> "Return"
            .In -> "In"
            .As -> "As"
            .Emit -> "Emit"
            .On -> "On"
            .Errdefer -> "Errdefer"
            .Parallel -> "Parallel"
            .With -> "With"
            .Catch -> "Catch"
            .Without -> "Without"
            .Only -> "Only"
            .Partial -> "Partial"
            .Is -> "Is"
            .Table -> "Table"
            .Null -> "Null"
            .OkKw -> "OkKw"
            .ErrKw -> "ErrKw"
            .NullLiteral -> "NullLiteral"
            .Underscore -> "Underscore"
            // Operators
            .Plus -> "Plus"
            .Minus -> "Minus"
            .Star -> "Star"
            .Slash -> "Slash"
            .Percent -> "Percent"
            .Eq -> "Eq"
            .EqEq -> "EqEq"
            .NotEq -> "NotEq"
            .Lt -> "Lt"
            .LtEq -> "LtEq"
            .Gt -> "Gt"
            .GtEq -> "GtEq"
            .And -> "And"
            .Or -> "Or"
            .Not -> "Not"
            .Pipe -> "Pipe"
            .Arrow -> "Arrow"
            .LeftArrow -> "LeftArrow"
            .Question -> "Question"
            .QuestionDot -> "QuestionDot"
            .DoubleQuestion -> "DoubleQuestion"
            .DotDot -> "DotDot"
            .DotDotEq -> "DotDotEq"
            .Ampersand -> "Ampersand"
            .Bar -> "Bar"
            .Caret -> "Caret"
            .Tilde -> "Tilde"
            .ShiftLeft -> "ShiftLeft"
            .ShiftRight -> "ShiftRight"
            // Delimiters
            .LParen -> "LParen"
            .RParen -> "RParen"
            .LBrace -> "LBrace"
            .RBrace -> "RBrace"
            .LBracket -> "LBracket"
            .RBracket -> "RBracket"
            // Punctuation
            .Comma -> "Comma"
            .Dot -> "Dot"
            .Colon -> "Colon"
            .Semicolon -> "Semicolon"
            .At -> "At"
            .Hash -> "Hash"
            .Spread -> "Spread"
            // Special
            .Newline -> "Newline"
            .Eof -> "Eof"
            _ -> ""
        }
    }

    // Map TokenKind enum to kind_id integer (for check() dispatch)
    // NOTE: uses match but with explicit return in each arm (works in bootstrap)
    fn kind_to_id(self, kind: TokenKind) -> int {
        match kind {
            .Let -> { return 20 }
            .Mut -> { return 21 }
            .Const -> { return 22 }
            .Fn -> { return 23 }
            .Return -> { return 24 }
            .If -> { return 25 }
            .Else -> { return 26 }
            .Match -> { return 27 }
            .For -> { return 28 }
            .In -> { return 29 }
            .While -> { return 30 }
            .Loop -> { return 31 }
            .Break -> { return 32 }
            .Continue -> { return 33 }
            .Enum -> { return 34 }
            .TypeKw -> { return 35 }
            .Use -> { return 36 }
            .Mod -> { return 37 }
            .As -> { return 38 }
            .Export -> { return 39 }
            .Emit -> { return 40 }
            .On -> { return 41 }
            .Trait -> { return 42 }
            .Impl -> { return 43 }
            .Defer -> { return 44 }
            .Errdefer -> { return 45 }
            .Spawn -> { return 46 }
            .Parallel -> { return 47 }
            .With -> { return 48 }
            .Catch -> { return 49 }
            .Select -> { return 50 }
            .Component -> { return 51 }
            .Without -> { return 52 }
            .Only -> { return 53 }
            .Partial -> { return 54 }
            .Is -> { return 55 }
            .Table -> { return 56 }
            .Null -> { return 57 }
            .OkKw -> { return 58 }
            .ErrKw -> { return 59 }
            .NullLiteral -> { return 8 }
            .Underscore -> { return 60 }
            .Plus -> { return 70 }
            .Minus -> { return 71 }
            .Star -> { return 72 }
            .Slash -> { return 73 }
            .Percent -> { return 74 }
            .Eq -> { return 75 }
            .EqEq -> { return 76 }
            .NotEq -> { return 77 }
            .Lt -> { return 78 }
            .LtEq -> { return 79 }
            .Gt -> { return 80 }
            .GtEq -> { return 81 }
            .And -> { return 82 }
            .Or -> { return 83 }
            .Not -> { return 84 }
            .Pipe -> { return 85 }
            .Arrow -> { return 86 }
            .LeftArrow -> { return 87 }
            .Question -> { return 88 }
            .QuestionDot -> { return 89 }
            .DoubleQuestion -> { return 90 }
            .DotDot -> { return 91 }
            .DotDotEq -> { return 92 }
            .Ampersand -> { return 93 }
            .Bar -> { return 94 }
            .Caret -> { return 95 }
            .Tilde -> { return 96 }
            .ShiftLeft -> { return 97 }
            .ShiftRight -> { return 98 }
            .LParen -> { return 100 }
            .RParen -> { return 101 }
            .LBrace -> { return 102 }
            .RBrace -> { return 103 }
            .LBracket -> { return 104 }
            .RBracket -> { return 105 }
            .Comma -> { return 110 }
            .Dot -> { return 111 }
            .Colon -> { return 112 }
            .Semicolon -> { return 113 }
            .At -> { return 114 }
            .Hash -> { return 115 }
            .Spread -> { return 116 }
            .Newline -> { return 120 }
            .Eof -> { return 99 }
            _ -> { return 0 }
        }
        return 0
    }

    // ─── Expression Parsing (delegated) ────────
    // See expressions.fg for the full precedence climbing implementation.
    // These are the entry points called by statement parsing.

    fn parse_expr(self) -> Expr? {
        self.parse_pipe_expr()
    }
}
