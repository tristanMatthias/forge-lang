// ─── Parser ────────────────────────────────────
// Parses a token stream into an AST.
// Statement dispatch uses the feature registry; expression parsing
// uses precedence climbing defined in expressions.fg.

mod expressions
mod templates

use core.token.{Token, TokenKind, Span, TemplatePart}
use core.ast.{
    Program, Statement, Expr, Block, BinOp, UnaryOp,
    FeatureStmt, FeatureExpr, NodeRef,
    feature_stmt, feature_expr,
}
use core.types.Type
use core.error.{Diagnostic, error, E_SYNTAX}
use codegen.{cg_var_enum_type}
use features.while_loops.{PARSE_END_POS}
use features.impl_methods.parse_impl_block
use expressions.{LAST_IDENT_NAME, IN_MATCH_ARM, match_enum_tag}

export mut LAST_PARAM_TYPE_NAME: string = "int"
export mut PARSED_PARAM_TYPES: List<string> = []

// ─── Param Type ────────────────────────────────

export type Param = {
    name: string,
    type_ann: TypeExpr?,
    default_value: Expr?,
    span: Span,
    mutable: bool,
}

// ─── Type Expressions ──────────────────────────

export enum TypeExpr {
    Named(name: string, span: Span)
    Generic(name: string, args: List<TypeExpr>, span: Span)
    Nullable(inner: TypeExpr, span: Span)
    Function(params: List<TypeExpr>, return_type: TypeExpr, span: Span)
    Tuple(elements: List<TypeExpr>, span: Span)
    Struct(fields: List<TypeField>, span: Span)
}

export type TypeField = {
    name: string,
    type_expr: TypeExpr,
    mutable: bool,
}

// ─── Parser State ──────────────────────────────

export type Parser = {
    tokens: List<Token>,
    mut pos: int,
    mut diagnostics: List<Diagnostic>,
    source: string,
}

export fn parser_new(tokens: List<Token>) -> Parser {
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: "",
    }
}

export fn parser_new_with_source(tokens: List<Token>, source: string) -> Parser {
    forge_set_token_list(tokens)
    forge_parser_set_pos(0)
    Parser {
        tokens,
        pos: 0,
        diagnostics: [],
        source: source,
    }
}

// ─── Parser Methods ────────────────────────────

impl Parser {

    // ─── Token Navigation ──────────────────────

    fn is_at_end(self) -> bool {
        forge_parser_get_pos() >= forge_token_list_len()
    }

    fn peek(self) -> Token {
        let _cpos = forge_parser_get_pos()
        if _cpos < forge_token_list_len() {
            let tok = self.tokens[_cpos]
            return tok
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
        }
    }

    fn peek_at(self, offset: int) -> Token {
        let idx = forge_parser_get_pos() + offset
        if idx < forge_token_list_len() {
            self.tokens[idx]
        } else {
            Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
        }
    }

    fn advance(self) -> Token {
        let tok = self.peek()
        if forge_parser_get_pos() < forge_token_list_len() {
            self.pos = self.pos + 1
            forge_parser_advance_pos()
        }
        tok
    }

    fn check(self, kind: TokenKind) -> bool {
        // Bootstrap workaround: == on tagged unions compares full payload bytes.
        // Use string key comparison instead.
        let a = self.kind_to_key(self.peek().kind)
        let b = self.kind_to_key(kind)
        a != "" && a == b
    }

    fn check_id(self, kid: int) -> bool {
        if forge_parser_get_pos() >= forge_token_list_len() { return kid == 99 }
        forge_peek_kind_id(forge_parser_get_pos()) == kid
    }

    fn expect_id(self, kid: int) -> Token? {
        if self.check_id(kid) {
            self.advance()
        } else {
            null
        }
    }

    fn expect(self, kind: TokenKind) -> Token? {
        if self.check(kind) {
            self.advance()
        } else {
            self.error("expected token")
            null
        }
    }

    fn expect_ident(self) -> string {
        let tok = self.peek()
        // Bootstrap workaround: use kind_id instead of pattern matching on .Ident(name)
        if tok.kind_id == 1 {
            self.advance()
            return tok.text
        }
        // Keywords that can be used as identifiers
        if tok.kind is .Is {
            self.advance()
            return "is"
        }
        if tok.kind is .Table {
            self.advance()
            return "table"
        }
        if tok.kind is .Underscore {
            self.advance()
            return "_"
        }
        self.error("expected identifier")
        ""
    }

    fn skip_newlines(self) {
        while self.check(TokenKind.Newline) {
            self.advance()
        }
    }

    // Skip tokens until matching closing brace (handles nesting).
    // Assumes opening { was already consumed. Consumes the closing }.
    fn skip_to_matching_brace(self) {
        mut depth = 1
        while depth > 0 && !self.is_at_end() {
            if self.check(TokenKind.LBrace) {
                depth = depth + 1
            }
            if self.check(TokenKind.RBrace) {
                depth = depth - 1
            }
            self.advance()
        }
    }

    fn current_span(self) -> Span {
        self.peek().span
    }

    fn error(self, message: string) {
        self.diagnostics = self.diagnostics.push(
            error(E_SYNTAX, message, self.current_span())
        )
    }

    // ─── Peek Helpers ──────────────────────────

    fn peek_at_meaningful(self, n: int) -> Token {
        // Peek at the nth non-newline token
        mut count = 0
        mut offset = 0
        while forge_parser_get_pos() + offset < forge_token_list_len() {
            let tok = self.tokens[forge_parser_get_pos() + offset]
            if tok.kind is not .Newline {
                if count == n {
                    return tok
                }
                count = count + 1
            }
            offset = offset + 1
        }
        Token { kind: TokenKind.Eof, span: Span { start: 0, end: 0, line: 0, col: 0 } }
    }

    fn next_meaningful_is(self, kind: TokenKind) -> bool {
        self.peek_at_meaningful(0).kind == kind
    }

    // ─── Program Parsing ───────────────────────

    fn parse_program(self) -> Program {
        mut statements: List<Statement> = []
        self.skip_newlines()

        while !self.is_at_end() {
            let before = forge_parser_get_pos()
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            // Safety: skip token if parser didn't advance
            if forge_parser_get_pos() == before {
                self.advance()
            }
            self.skip_newlines()
        }

        Program { statements }
    }

    // ─── Statement Parsing ─────────────────────
    // Check registry first, then fall back to built-in structural statements.

    fn parse_statement(self) -> Statement? {
        self.skip_newlines()
        if self.is_at_end() { return null }

        let tok = self.peek()

        // kind_id dispatch
        let kid = tok.kind_id
        if kid == 20 { let r = parse_let(self)
            self.sync_pos()
            return r }
        if kid == 21 { let r = parse_mut(self)
            self.sync_pos()
            return r }
        if kid == 22 { let r = parse_const(self)
            self.sync_pos()
            return r }
        if kid == 23 { let r = parse_fn(self)
            self.sync_pos()
            return r }
        if kid == 39 { let r = parse_export(self)
            self.sync_pos()
            return r }
        if kid == 30 {
            let wstart = self.advance().span
            self.skip_newlines()
            let wcond = self.parse_expr()
            if wcond == null { return null }
            self.skip_newlines()
            let wbody = self.parse_block()
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.While(wcond!, wbody, wstart)
        }
        if kid == 28 {
            let fstart = self.advance().span
            let fname = self.expect_ident()
            if self.check(TokenKind.In) { self.advance() }
            self.skip_newlines()
            let fiter = self.parse_expr()
            if fiter == null { return null }
            self.skip_newlines()
            let fbody = self.parse_block()
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.For(fname, fiter!, fbody, fstart)
        }
        if kid == 24 { return self.parse_return() }
        if kid == 32 {
            self.advance()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        if kid == 33 {
            self.advance()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        if kid == 36 {
            self.advance()
            while !self.is_at_end() && !self.check(TokenKind.Newline) { self.advance() }
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        if kid == 37 {
            self.advance()
            self.expect_ident()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }
        // Parse impl blocks to register methods for later codegen
        if kid == 43 {
            let r = parse_impl_block(self)
            self.sync_pos()
            return r
        }
        // type: parse struct declarations to register field info
        if kid == 35 {
            let r = parse_type_decl(self)
            self.sync_pos()
            return r
        }
        // enum/trait: skip by brace counting
        if kid == 42 || kid == 34 {
            self.advance()
            self.expect_ident()
            while !self.is_at_end() && forge_peek_kind_id(forge_parser_get_pos()) != 102 {
                self.advance()
            }
            if forge_peek_kind_id(forge_parser_get_pos()) == 102 {
                self.advance()
                mut bdepth = 1
                while bdepth > 0 && !self.is_at_end() {
                    let bk = forge_peek_kind_id(forge_parser_get_pos())
                    if bk == 102 { bdepth = bdepth + 1 }
                    if bk == 103 { bdepth = bdepth - 1 }
                    if bdepth > 0 { self.advance() }
                }
                if forge_peek_kind_id(forge_parser_get_pos()) == 103 { self.advance() }
            }
            PARSE_END_POS = forge_parser_get_pos()
            return Statement.Expr(Expr.IntLit(0, tok.span))
        }

        match tok.kind {
            .Let -> {
                let r = parse_let(self)
                self.sync_pos()
                return r
            }
            .Mut -> {
                let r = parse_mut(self)
                self.sync_pos()
                return r
            }
            .Const -> {
                let r = parse_const(self)
                self.sync_pos()
                return r
            }
            .Fn -> {
                let r = parse_fn(self)
                self.sync_pos()
                return r
            }
            .Export -> {
                let r = parse_export(self)
                self.sync_pos()
                return r
            }
            .While -> {
                let r = parse_while(self)
                self.sync_pos()
                return r
            }
            .For -> {
                let r = parse_for(self)
                self.sync_pos()
                return r
            }
            .If -> {
                let start = self.advance().span // consume 'if'
                self.skip_newlines()
                let cond = self.parse_expr()
                if cond == null { return null }
                self.skip_newlines()
                let then_block = self.parse_block()
                self.skip_newlines()
                mut has_else = 0
                mut else_block = Block { statements: [], span: start }
                if self.check(TokenKind.Else) {
                    has_else = 1
                    self.advance()
                    self.skip_newlines()
                    if self.check(TokenKind.If) {
                        let nested = self.parse_statement()
                        if nested != null {
                            else_block = Block { statements: [nested!], span: start }
                        }
                    } else {
                        else_block = self.parse_block()
                    }
                }
                return Statement.If(cond!, then_block, else_block, has_else, start)
            }
            .Match -> {
                let start = self.advance().span // consume 'match'
                    self.skip_newlines()
                    let scrutinee = self.parse_expr()
                    if scrutinee == null { return null }
                    let scrutinee_var = LAST_IDENT_NAME
                    self.skip_newlines()
                    if self.expect(TokenKind.LBrace) == null { return null }
                    self.skip_newlines()

                    let enum_type = cg_var_enum_type(scrutinee_var)
                    mut arm_tags: List<int> = []
                    mut arm_bodies: List<Block> = []
                    mut arm_bindings_list: List<string> = []
                    mut has_default = 0
                    mut default_body = Block { statements: [], span: start }

                    while !self.check(TokenKind.RBrace) && !self.is_at_end() {
                        self.skip_newlines()
                        mut pat_tag = -1
                        mut arm_bind_csv = ""
                        if self.check(TokenKind.Dot) {
                            self.advance()
                            let vname = self.expect_ident()
                            let qname = enum_type + "." + vname
                            // Store variant qualified name for field type lookup
                            arm_bind_csv = qname + ":"
                            pat_tag = match_enum_tag(qname)
                            if pat_tag < 0 { pat_tag = match_enum_tag(vname) }
                            // Capture binding names
                            if self.check(TokenKind.LParen) {
                                self.advance()
                                mut bind_idx = 0
                                while !self.check(TokenKind.RParen) && !self.is_at_end() {
                                    let bname = self.expect_ident()
                                    if bname != "" && bname != "_" {
                                        if bind_idx > 0 { arm_bind_csv = arm_bind_csv + "," }
                                        arm_bind_csv = arm_bind_csv + bname
                                    } else {
                                        if bind_idx > 0 { arm_bind_csv = arm_bind_csv + "," }
                                        arm_bind_csv = arm_bind_csv + "_"
                                    }
                                    bind_idx = bind_idx + 1
                                    if self.check(TokenKind.Comma) { self.advance() }
                                    self.skip_newlines()
                                }
                                if self.check(TokenKind.RParen) { self.advance() }
                            }
                        } else if self.check(TokenKind.Underscore) {
                            self.advance()
                            pat_tag = -1
                            has_default = 1
                        } else {
                            self.advance()
                        }
                        self.skip_newlines()
                        if self.check(TokenKind.Arrow) { self.advance() }
                        self.skip_newlines()
                        let prev_match = IN_MATCH_ARM
                        IN_MATCH_ARM = true
                        mut body = Block { statements: [], span: start }
                        if self.check(TokenKind.LBrace) {
                            body = self.parse_block()
                        } else {
                            let e = self.parse_expr()
                            if e != null {
                                mut body_stmts: List<Statement> = []
                                body_stmts = body_stmts.push(Statement.Expr(e!))
                                body = Block { statements: body_stmts, span: start }
                            }
                        }
                        IN_MATCH_ARM = prev_match
                        if pat_tag == -1 && has_default == 1 {
                            default_body = body
                        } else {
                            arm_tags = arm_tags.push(pat_tag)
                            arm_bodies = arm_bodies.push(body)
                            arm_bindings_list = arm_bindings_list.push(arm_bind_csv)
                        }
                        self.skip_newlines()
                        if self.check(TokenKind.Comma) { self.advance() }
                        self.skip_newlines()
                    }
                    if self.check(TokenKind.RBrace) { self.advance() }

                    // Build tag CSV
                    mut tag_csv = ""
                    mut ti = 0
                    while ti < arm_tags.length {
                        if ti > 0 { tag_csv = tag_csv + "," }
                        tag_csv = tag_csv + string(arm_tags[ti])
                        ti = ti + 1
                    }

                    // Build bindings CSV (semicolons between arms)
                    mut bindings_csv = ""
                    mut bi = 0
                    while bi < arm_bindings_list.length {
                        if bi > 0 { bindings_csv = bindings_csv + ";" }
                        bindings_csv = bindings_csv + arm_bindings_list[bi]
                        bi = bi + 1
                    }

                return Statement.Match(scrutinee!, tag_csv, bindings_csv, arm_bodies, default_body, has_default, start)
            }
            .TypeKw -> {
                let r = parse_type_decl(self)
                self.sync_pos()
                return r
            }
            .Enum -> {
                let r = parse_enum_decl(self)
                self.sync_pos()
                return r
            }
            .Impl -> {
                let r = parse_impl_block(self)
                self.sync_pos()
                return r
            }
            .Use -> {
                // Skip 'use' statements — module imports are no-op in single-file mode
                self.advance() // consume 'use'
                // Skip until newline or end
                while !self.is_at_end() && !self.check(TokenKind.Newline) {
                    self.advance()
                }
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Mod -> {
                // Skip 'mod' declarations — no-op in single-file mode
                self.advance() // consume 'mod'
                self.expect_ident() // consume module name
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            .Trait -> {
                // Skip trait declarations — parse and discard
                self.advance() // consume 'trait'
                self.expect_ident() // trait name
                if self.check(TokenKind.LBrace) {
                    self.parse_block() // skip body
                }
                return Statement.Expr(Expr.IntLit(0, tok.span))
            }
            _ -> {}
        }

        // Built-in structural statements
        match tok.kind {
            .Return -> {
                self.parse_return()
            }
            .Break -> {
                self.advance()
                Statement.Break(tok.span)
            }
            .Continue -> {
                self.advance()
                Statement.Continue(tok.span)
            }
            _ -> {
                self.parse_expr_or_assign()
            }
        }
    }

    fn sync_pos(self) {
        if PARSE_END_POS >= 0 {
            forge_parser_set_pos(PARSE_END_POS)
            PARSE_END_POS = -1
        }
    }

    fn parse_return(self) -> Statement? {
        let start = self.advance().span // consume 'return'

        // Bare return (no value)
        if self.is_at_end() || self.check(TokenKind.Newline) || self.check(TokenKind.RBrace) {
            return Statement.Return(Expr.NullLit(start), start)
        }

        // return null
        let pk = self.peek()
        let pk_key = self.kind_to_key(pk.kind)
        if pk_key == "NullLiteral" {
            self.advance() // consume 'null'
            return Statement.Return(Expr.NullLit(start), start)
        }

        let value = self.parse_expr()
        if value == null {
            return Statement.Return(Expr.NullLit(start), start)
        }

        Statement.Return(value!, start)
    }

    fn parse_expr_or_assign(self) -> Statement? {
        let expr = self.parse_expr()
        if expr == null { return null }

        // Check for assignment: expr = value
        if self.check(TokenKind.Eq) {
            // Save target variable name before RHS parsing overwrites LAST_IDENT_NAME
            let assign_target_name = LAST_IDENT_NAME
            let eq_span = self.advance().span // consume =
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '='")
                return null
            }
            return Statement.Assign(expr!, value!, eq_span)
        }

        // Check for channel send: expr <- value
        if self.check(TokenKind.LeftArrow) {
            self.advance()
            let value = self.parse_expr()
            if value == null {
                self.error("expected expression after '<-'")
                return null
            }
            return Statement.Expr(expr!)
        }

        Statement.Expr(expr!)
    }

    // ─── Block Parsing ─────────────────────────

    fn parse_block(self) -> Block {
        let start = self.current_span()
        let empty = Block { statements: [], span: start }
        if self.expect(TokenKind.LBrace) == null { return empty }

        self.skip_newlines()
        mut statements: List<Statement> = []

        while !self.check(TokenKind.RBrace) && !self.is_at_end() {
            let before = forge_parser_get_pos()
            let stmt = self.parse_statement()
            if stmt != null {
                statements = statements.push(stmt!)
            }
            if forge_parser_get_pos() == before { self.advance() }
            self.skip_newlines()
        }

        self.expect(TokenKind.RBrace)

        Block {
            statements,
            span: Span {
                start: start.start,
                end: self.current_span().end,
                line: start.line,
                col: start.col,
            },
        }
    }

    // Parse a block or wrap a single statement in a block
    fn parse_block_or_stmt(self) -> Block? {
        if self.check(TokenKind.LBrace) {
            self.parse_block()
        } else {
            let start = self.current_span()
            let stmt = self.parse_statement()
            if stmt == null { return null }
            Block {
                statements: [stmt!],
                span: start,
            }
        }
    }

    // ─── Type Expression Parsing ───────────────

    fn parse_type_expr(self) -> TypeExpr? {
        let ty = self.parse_primary_type()
        if ty == null { return null }

        // Check for nullable modifier: Type?
        if self.check(TokenKind.Question) {
            let span = self.advance().span
            return TypeExpr.Nullable(ty!, span)
        }

        ty
    }

    fn parse_primary_type(self) -> TypeExpr? {
        let tok = self.peek()

        // Ident → type name (bootstrap workaround: use kind_id)
        if tok.kind_id == 1 {
            let name = tok.text
            let start = self.advance().span
            // Check for generic: Name<A, B>
            if self.check(TokenKind.Lt) {
                let args = self.parse_type_args()
                if args != null {
                    return TypeExpr.Generic(name, args!, start)
                }
            }
            return TypeExpr.Named(name, start)
        }

        match tok.kind {
            // fn(A, B) -> R
            .Fn -> {
                self.parse_function_type()
            }

            // (A, B) — tuple or parenthesized
            .LParen -> {
                self.parse_tuple_or_paren_type()
            }

            // { name: Type, ... } — struct type
            .LBrace -> {
                self.parse_struct_type()
            }

            _ -> {
                self.error("expected type")
                null
            }
        }
    }

    fn parse_type_args(self) -> List<TypeExpr>? {
        if self.expect(TokenKind.Lt) == null { return null }
        mut args: List<TypeExpr> = []

        while !self.check(TokenKind.Gt) && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                args = args.push(ty!)
            }
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        // Handle >> as > >
        if self.check(TokenKind.ShiftRight) {
            // Split >> into two > tokens — consume one
            // TODO: proper token splitting
            self.advance()
        } else {
            if self.expect(TokenKind.Gt) == null { return null }
        }

        args
    }

    fn parse_function_type(self) -> TypeExpr? {
        let start = self.advance().span // consume 'fn'
        if self.expect(TokenKind.LParen) == null { return null }

        mut params: List<TypeExpr> = []
        while !self.check(TokenKind.RParen) && !self.is_at_end() {
            self.skip_newlines()
            let ty = self.parse_type_expr()
            if ty != null {
                params = params.push(ty!)
            }
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }
        if self.expect(TokenKind.RParen) == null { return null }

        // -> ReturnType
        mut ret: TypeExpr? = TypeExpr.Named("void", start)
        if self.check(TokenKind.Arrow) {
            self.advance()
            ret = self.parse_type_expr()
        }

        if ret == null { return null }
        TypeExpr.Function(params, ret!, start)
    }

    fn parse_tuple_or_paren_type(self) -> TypeExpr? {
        let start = self.advance().span // consume (

        if self.check(TokenKind.RParen) {
            self.advance()
            return TypeExpr.Tuple([], start)
        }

        let first = self.parse_type_expr()
        if first == null { return null }

        if self.check(TokenKind.Comma) {
            // Tuple type
            self.advance()
            mut elements: List<TypeExpr> = [first!]
            while !self.check(TokenKind.RParen) && !self.is_at_end() {
                self.skip_newlines()
                let ty = self.parse_type_expr()
                if ty != null {
                    elements = elements.push(ty!)
                }
                if self.check(TokenKind.Comma) {
                    self.advance()
                }
            }
            if self.expect(TokenKind.RParen) == null { return null }

            // Check for -> ReturnType (function type)
            if self.check(TokenKind.Arrow) {
                self.advance()
                let ret = self.parse_type_expr()
                if ret == null { return null }
                return TypeExpr.Function(elements, ret!, start)
            }

            return TypeExpr.Tuple(elements, start)
        }

        if self.expect(TokenKind.RParen) == null { return null }

        // Check for -> ReturnType (single-param function type)
        if self.check(TokenKind.Arrow) {
            self.advance()
            let ret = self.parse_type_expr()
            if ret == null { return null }
            return TypeExpr.Function([first!], ret!, start)
        }

        // Parenthesized type
        first
    }

    fn parse_struct_type(self) -> TypeExpr? {
        let start = self.advance().span // consume {
        mut fields: List<TypeField> = []

        while !self.check(TokenKind.RBrace) && !self.is_at_end() {
            self.skip_newlines()
            mut mutable = false
            if self.check(TokenKind.Mut) {
                self.advance()
                mutable = true
            }
            let name = self.expect_ident()
            if name == null { return null }
            if self.expect(TokenKind.Colon) == null { return null }
            let ty = self.parse_type_expr()
            if ty == null { return null }
            fields = fields.push(TypeField { name: name!, type_expr: ty!, mutable })
            self.skip_newlines()
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        if self.expect(TokenKind.RBrace) == null { return null }
        TypeExpr.Struct(fields, start)
    }

    // ─── Parameter Parsing ─────────────────────

    fn parse_params(self) -> List<Param> {
        PARSED_PARAM_TYPES = []
        self.expect(TokenKind.LParen)
        mut params: List<Param> = []

        while !self.check(TokenKind.RParen) && !self.is_at_end() {
            self.skip_newlines()
            let param = self.parse_param()
            if param != null {
                params = params.push(param!)
            }
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        self.expect(TokenKind.RParen)
        params
    }

    fn parse_param(self) -> Param? {
        let start = self.current_span()
        mut mutable = false
        if self.check(TokenKind.Mut) {
            self.advance()
            mutable = true
        }
        let name = self.expect_ident()
        if name == null { return null }

        // Optional type annotation: : Type
        // Capture the type name text before parsing (for struct type lookup)
        mut type_name_text = "int"  // default
        mut type_ann: TypeExpr? = null
        if self.check(TokenKind.Colon) {
            self.advance()
            // Capture the next token's text as the type name
            let type_tok = self.peek()
            if type_tok.kind_id == 1 {
                type_name_text = type_tok.text
            }
            type_ann = self.parse_type_expr()
        }
        // Store the type name for function param type tracking
        LAST_PARAM_TYPE_NAME = type_name_text
        PARSED_PARAM_TYPES = PARSED_PARAM_TYPES.push(type_name_text)

        // Optional default value: = expr
        mut default_value: Expr? = null
        if self.check(TokenKind.Eq) {
            self.advance()
            default_value = self.parse_expr()
        }

        Param { name: name!, type_ann, default_value, span: start, mutable }
    }

    // ─── Type Parameters ───────────────────────

    fn parse_type_params(self) -> List<string> {
        if !self.check(TokenKind.Lt) { return [] }
        self.advance() // consume <

        mut params: List<string> = []
        while !self.check(TokenKind.Gt) && !self.is_at_end() {
            self.skip_newlines()
            let name = self.expect_ident()
            if name != null {
                params = params.push(name!)
            }
            // TODO: bounds (T: Clone)
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        if self.expect(TokenKind.Gt) == null { return params }
        params
    }

    // ─── Delimited List Helper ─────────────────

    fn parse_delimited(self, close: TokenKind) -> List<Expr> {
        mut items: List<Expr> = []

        while !self.check(close) && !self.is_at_end() {
            self.skip_newlines()
            let item = self.parse_expr()
            if item != null {
                items = items.push(item!)
            }
            self.skip_newlines()
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        items
    }

    // ─── Token Kind Key ────────────────────────
    // Convert a TokenKind to a string key for registry lookup.

    fn token_kind_key(self, kind: TokenKind) -> string {
        self.kind_to_key(kind)
    }

    fn kind_to_key(self, kind: TokenKind) -> string {
        match kind {
            // Keywords
            .Let -> "Let"
            .Mut -> "Mut"
            .Const -> "Const"
            .Fn -> "Fn"
            .Export -> "Export"
            .Enum -> "Enum"
            .TypeKw -> "TypeKw"
            .Use -> "Use"
            .Mod -> "Mod"
            .Trait -> "Trait"
            .Impl -> "Impl"
            .For -> "For"
            .While -> "While"
            .Loop -> "Loop"
            .Break -> "Break"
            .Continue -> "Continue"
            .Defer -> "Defer"
            .Spawn -> "Spawn"
            .Select -> "Select"
            .Component -> "Component"
            .If -> "If"
            .Else -> "Else"
            .Match -> "Match"
            .Return -> "Return"
            .In -> "In"
            .As -> "As"
            .Emit -> "Emit"
            .On -> "On"
            .Errdefer -> "Errdefer"
            .Parallel -> "Parallel"
            .With -> "With"
            .Catch -> "Catch"
            .Without -> "Without"
            .Only -> "Only"
            .Partial -> "Partial"
            .Is -> "Is"
            .Table -> "Table"
            .Null -> "Null"
            .OkKw -> "OkKw"
            .ErrKw -> "ErrKw"
            .NullLiteral -> "NullLiteral"
            .Underscore -> "Underscore"
            // Operators
            .Plus -> "Plus"
            .Minus -> "Minus"
            .Star -> "Star"
            .Slash -> "Slash"
            .Percent -> "Percent"
            .Eq -> "Eq"
            .EqEq -> "EqEq"
            .NotEq -> "NotEq"
            .Lt -> "Lt"
            .LtEq -> "LtEq"
            .Gt -> "Gt"
            .GtEq -> "GtEq"
            .And -> "And"
            .Or -> "Or"
            .Not -> "Not"
            .Pipe -> "Pipe"
            .Arrow -> "Arrow"
            .LeftArrow -> "LeftArrow"
            .Question -> "Question"
            .QuestionDot -> "QuestionDot"
            .DoubleQuestion -> "DoubleQuestion"
            .DotDot -> "DotDot"
            .DotDotEq -> "DotDotEq"
            .Ampersand -> "Ampersand"
            .Bar -> "Bar"
            .Caret -> "Caret"
            .Tilde -> "Tilde"
            .ShiftLeft -> "ShiftLeft"
            .ShiftRight -> "ShiftRight"
            // Delimiters
            .LParen -> "LParen"
            .RParen -> "RParen"
            .LBrace -> "LBrace"
            .RBrace -> "RBrace"
            .LBracket -> "LBracket"
            .RBracket -> "RBracket"
            // Punctuation
            .Comma -> "Comma"
            .Dot -> "Dot"
            .Colon -> "Colon"
            .Semicolon -> "Semicolon"
            .At -> "At"
            .Hash -> "Hash"
            .Spread -> "Spread"
            // Special
            .Newline -> "Newline"
            .Eof -> "Eof"
            _ -> ""
        }
    }

    // ─── Expression Parsing (delegated) ────────
    // See expressions.fg for the full precedence climbing implementation.
    // These are the entry points called by statement parsing.

    fn parse_expr(self) -> Expr? {
        self.parse_pipe_expr()
    }
}
