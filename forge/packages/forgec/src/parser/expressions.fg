// ─── Expression Parser ─────────────────────────
// Precedence-climbing expression parsing.
// Lowest precedence at top, highest at bottom.
//
// Precedence levels (lowest → highest):
//  1. Pipe:          |>
//  2. Or:            ||
//  3. And:           &&
//  4. Equality:      ==  !=
//  5. Comparison:    <  <=  >  >=
//  6. Bitwise Or:    |
//  7. Bitwise Xor:   ^
//  8. Bitwise And:   &
//  9. Bitwise Shift: <<  >>
// 10. Addition:      +  -
// 11. Multiplication: *  /  %
// 12. Unary:         !  -  ~
// 13. Postfix:       ()  .  []  ?  !

use core.token.{Token, TokenKind, Span, TemplatePart}
use core.ast.{Expr, BinOp, UnaryOp, Block, Statement}
use core.error.E_SYNTAX
use lexer.{parse_int, parse_float}
use features.if_else.{make_if_expr, make_if_with_else, make_if_no_else}

// ─── Precedence Levels ─────────────────────────
// All binary levels use parse_binary_level(prec) which:
//   1. Parses the next-higher precedence level
//   2. Loops while the current token matches this level's operators
//   3. Builds Expr.Binary nodes left-to-right
//
// Levels: 1=pipe, 2=or, 3=and, 4=eq, 5=cmp, 6=bitor, 7=bitxor,
//         8=bitand, 9=shift, 10=add, 11=mul

impl Parser {

    // Map current token to BinOp for a given precedence level.
    // Returns "" for no match (bootstrap workaround: nullable returns unreliable)
    fn token_to_binop_key(self, level: int) -> string {
        let k = self.kind_to_key(self.peek().kind)
        match level {
            1  -> if k == "Pipe" { "Pipe" } else { "" }
            2  -> if k == "Or" { "Or" } else { "" }
            3  -> if k == "And" { "And" } else { "" }
            4  -> if k == "EqEq" { "Eq" } else if k == "NotEq" { "NotEq" } else { "" }
            5  -> {
                if k == "Lt" { "Lt" }
                else if k == "LtEq" { "LtEq" }
                else if k == "Gt" { "Gt" }
                else if k == "GtEq" { "GtEq" }
                else { "" }
            }
            6  -> if k == "Bar" { "BitOr" } else { "" }
            7  -> if k == "Caret" { "BitXor" } else { "" }
            8  -> if k == "Ampersand" { "BitAnd" } else { "" }
            9  -> if k == "ShiftLeft" { "Shl" } else if k == "ShiftRight" { "Shr" } else { "" }
            10 -> if k == "Plus" { "Add" } else if k == "Minus" { "Sub" } else { "" }
            11 -> if k == "Star" { "Mul" } else if k == "Slash" { "Div" } else if k == "Percent" { "Mod" } else { "" }
            _  -> ""
        }
    }

    fn binop_from_key(self, key: string) -> BinOp {
        if key == "Add" { return BinOp.Add }
        if key == "Sub" { return BinOp.Sub }
        if key == "Mul" { return BinOp.Mul }
        if key == "Div" { return BinOp.Div }
        if key == "Mod" { return BinOp.Mod }
        if key == "Eq" { return BinOp.Eq }
        if key == "NotEq" { return BinOp.NotEq }
        if key == "Lt" { return BinOp.Lt }
        if key == "LtEq" { return BinOp.LtEq }
        if key == "Gt" { return BinOp.Gt }
        if key == "GtEq" { return BinOp.GtEq }
        if key == "And" { return BinOp.And }
        if key == "Or" { return BinOp.Or }
        if key == "BitAnd" { return BinOp.BitAnd }
        if key == "BitOr" { return BinOp.BitOr }
        if key == "BitXor" { return BinOp.BitXor }
        if key == "Shl" { return BinOp.Shl }
        if key == "Shr" { return BinOp.Shr }
        if key == "Pipe" { return BinOp.Pipe }
        BinOp.Add  // fallback (shouldn't reach)
    }

    // Parse the next-higher precedence level for a given level.
    fn parse_next_level(self, level: int) -> Expr? {
        match level {
            1  -> self.parse_binary_level(2)    // pipe → or
            2  -> self.parse_binary_level(3)    // or → and
            3  -> self.parse_binary_level(4)    // and → equality
            4  -> self.parse_binary_level(5)    // eq → comparison
            5  -> self.parse_binary_level(6)    // cmp → bitor
            6  -> self.parse_binary_level(7)    // bitor → bitxor
            7  -> self.parse_binary_level(8)    // bitxor → bitand
            8  -> self.parse_binary_level(9)    // bitand → shift
            9  -> self.parse_binary_level(10)   // shift → add
            10 -> self.parse_binary_level(11)   // add → mul
            11 -> self.parse_unary_expr()       // mul → unary (base case)
            _  -> self.parse_unary_expr()
        }
    }

    // Generic binary operator loop for any precedence level.
    fn parse_binary_level(self, level: int) -> Expr? {
        let left = self.parse_next_level(level)
        if left == null { return null }

        mut result = left!
        while true {
            let op_key = self.token_to_binop_key(level)
            if op_key == "" { break }
            let op = self.binop_from_key(op_key)
            self.advance()
            self.skip_newlines()
            let right = self.parse_next_level(level)
            if right == null { return null }
            let span = self.merge_spans(self.current_span(), self.current_span())
            result = Expr.Binary(result, op!, right!, span)
        }
        result
    }

    // Entry point: start at level 1 (pipe, lowest precedence)
    fn parse_pipe_expr(self) -> Expr? {
        self.parse_binary_level(1)
    }

    // Level 12: Unary prefix ! - ~
    fn parse_unary_expr(self) -> Expr? {
        if self.check(TokenKind.Not) {
            let start = self.advance().span
            let operand = self.parse_unary_expr() // right-associative
            if operand == null { return null }
            let span = self.merge_spans(start, self.current_span())
            return Expr.Unary(UnaryOp.Not, operand!, span)
        }

        if self.check(TokenKind.Minus) {
            let start = self.advance().span
            let operand = self.parse_unary_expr()
            if operand == null { return null }
            let span = self.merge_spans(start, self.current_span())
            return Expr.Unary(UnaryOp.Neg, operand!, span)
        }

        if self.check(TokenKind.Tilde) {
            let start = self.advance().span
            let operand = self.parse_unary_expr()
            if operand == null { return null }
            let span = self.merge_spans(start, self.current_span())
            return Expr.Unary(UnaryOp.BitNot, operand!, span)
        }

        self.parse_postfix_expr()
    }

    // Level 13: Postfix () . [] ? !
    fn parse_postfix_expr(self) -> Expr? {
        let expr = self.parse_primary_expr()
        if expr == null { return null }

        mut result = expr!

        while !self.is_at_end() {
            // Function call: expr(args...)
            if self.check(TokenKind.LParen) {
                self.advance()
                let args = self.parse_call_args()
                let close = self.expect(TokenKind.RParen)
                let span = self.merge_spans(self.current_span(), self.peek_at(-1).span)
                result = Expr.Call(result, args, span)
                continue
            }

            // Member access: expr.field
            if self.check(TokenKind.Dot) {
                self.advance()
                // Numeric tuple access: expr.0
                let pk = self.peek()
                if pk.kind_id == 2 {
                    let field_span = self.advance().span
                    let span = self.merge_spans(self.current_span(), field_span)
                    result = Expr.Index(result, Expr.IntLit(parse_int(pk.text), field_span), span)
                    continue
                }
                let field = self.expect_ident()
                if field == "" { return null }
                let span = self.merge_spans(self.current_span(), self.peek_at(-1).span)
                result = Expr.MemberAccess(result, field, span)
                continue
            }

            // Cross-newline dot chaining: allow .field after newline
            if self.check(TokenKind.Newline) {
                let next = self.peek_at_meaningful(0)
                if next.kind is .Dot {
                    self.skip_newlines()
                    continue
                }
            }

            // Index access: expr[index]
            if self.check(TokenKind.LBracket) {
                self.advance()
                let index = self.parse_expr()
                if index == null { return null }
                if self.expect(TokenKind.RBracket) == null { return null }
                let span = self.merge_spans(self.current_span(), self.peek_at(-1).span)
                result = Expr.Index(result, index!, span)
                continue
            }

            break
        }

        result
    }

    // ─── Call Arguments ────────────────────────

    fn parse_call_args(self) -> List<Expr> {
        mut args: List<Expr> = []

        while !self.check(TokenKind.RParen) && !self.is_at_end() {
            self.skip_newlines()
            let arg = self.parse_expr()
            if arg != null {
                args = args.push(arg!)
            }
            self.skip_newlines()
            if self.check(TokenKind.Comma) {
                self.advance()
            }
        }

        args
    }

    // ─── Primary Expressions ───────────────────

    fn parse_primary_expr(self) -> Expr? {
        let tok = self.peek()

        // Bootstrap workaround: check data-carrying variants via kind_id
        if tok.kind_id == 2 {
            // IntLiteral — parse value from text
            let span = self.advance().span
            return Expr.IntLit(parse_int(tok.text), span)
        }
        if tok.kind_id == 3 {
            // FloatLiteral — parse value from text
            let span = self.advance().span
            return Expr.FloatLit(parse_float(tok.text), span)
        }
        if tok.kind_id == 4 {
            // StringLiteral
            let span = self.advance().span
            return Expr.StringLit(tok.text, span)
        }
        if tok.kind_id == 5 {
            // BoolLiteral
            let span = self.advance().span
            return Expr.BoolLit(tok.text == "true", span)
        }
        if tok.kind_id == 6 {
            // TemplateLiteral / DollarString
            let span = self.advance().span
            return Expr.StringLit("(template)", span)
        }
        if tok.kind_id == 1 {
            // Identifier
            let name = tok.text
            let span = self.advance().span

            // Check for single-param closure: x -> expr
            if self.check(TokenKind.Arrow) {
                self.advance()
                self.skip_newlines()
                let body = self.parse_expr()
                if body == null { return null }
                return body
            }

            return Expr.Ident(name, span)
        }

        match tok.kind {
            .NullLiteral -> {
                let span = self.advance().span
                Expr.NullLit(span)
            }

            // Parenthesized expression or tuple
            .LParen -> {
                self.parse_paren_expr()
            }

            // Block expression { ... }
            .LBrace -> {
                self.parse_block_expr()
            }

            // List literal [ ... ]
            .LBracket -> {
                self.parse_list_literal()
            }

            // Dot-prefixed enum variant: .Variant
            .Dot -> {
                self.parse_dot_variant()
            }

            // If expression
            .If -> {
                self.parse_if_expr()
            }

            // Match expression (will be registered by pattern_matching feature)
            .Match -> {
                self.parse_match_expr()
            }

            _ -> {
                self.error("unexpected token")
                self.advance() // skip the bad token
                null
            }
        }
    }

    // ─── Parenthesized / Tuple ─────────────────

    fn parse_paren_expr(self) -> Expr? {
        let start = self.advance().span // consume (

        // Empty parens: ()
        if self.check(TokenKind.RParen) {
            self.advance()
            return Expr.NullLit(start) // unit/void
        }

        self.skip_newlines()
        let first = self.parse_expr()
        if first == null { return null }
        self.skip_newlines()

        // Check for tuple: (a, b, ...)
        if self.check(TokenKind.Comma) {
            // TODO: create tuple expression
            self.advance()
            while !self.check(TokenKind.RParen) && !self.is_at_end() {
                self.skip_newlines()
                self.parse_expr() // consume but don't collect for now
                self.skip_newlines()
                if self.check(TokenKind.Comma) { self.advance() }
            }
            self.expect(TokenKind.RParen)
            return first // TODO: return Tuple expr
        }

        self.skip_newlines()
        if self.expect(TokenKind.RParen) == null { return null }
        first // parenthesized expression
    }

    // ─── Block Expression ──────────────────────

    fn parse_block_expr(self) -> Expr? {
        // Disambiguate: struct literal { field: value } vs block { stmts }
        // Look ahead to determine which
        if self.is_struct_literal() {
            return self.parse_struct_literal()
        }

        let block = self.parse_block()
        if block == null { return null }
        Expr.Block(block!)
    }

    fn is_struct_literal(self) -> bool {
        // { ident: ...} or { ident, ...} or { "string": ... } (map)
        let tok1 = self.peek_at(1) // first token after {

        // Skip newlines
        mut offset = 1
        while self.peek_at(offset).kind is .Newline {
            offset = offset + 1
        }

        let after_brace = self.peek_at(offset)

        // { ident: ... } — struct literal (use kind_id for data variants)
        if after_brace.kind_id == 1 {
            let after_ident = self.peek_at(offset + 1)
            return after_ident.kind is .Colon || after_ident.kind is .Comma || after_ident.kind is .RBrace
        }
        // { "string": ... } — map literal
        if after_brace.kind_id == 4 {
            let after_str = self.peek_at(offset + 1)
            return after_str.kind is .Colon
        }
        false
    }

    fn parse_struct_literal(self) -> Expr? {
        let start = self.advance().span // consume {
        // For now, parse as a block expression placeholder
        // TODO: proper struct literal parsing with field: value pairs
        mut fields: List<Expr> = []

        while !self.check(TokenKind.RBrace) && !self.is_at_end() {
            self.skip_newlines()

            // field: value or field (shorthand)
            let field_tok = self.peek()
            if field_tok.kind_id == 1 {
                let name_span = self.advance().span
                if self.check(TokenKind.Colon) {
                    self.advance()
                    let _value = self.parse_expr()
                }
            } else if field_tok.kind_id == 4 {
                // Map literal
                self.advance()
                if self.expect(TokenKind.Colon) == null { return null }
                let _value = self.parse_expr()
            } else {
                break
            }

            self.skip_newlines()
            if self.check(TokenKind.Comma) { self.advance() }
        }

        self.expect(TokenKind.RBrace)
        // Return a placeholder block for now
        Expr.Block(Block { statements: [], span: start })
    }

    // ─── List Literal ──────────────────────────

    fn parse_list_literal(self) -> Expr? {
        let start = self.advance().span // consume [
        let items = self.parse_delimited(.RBracket)
        if self.expect(TokenKind.RBracket) == null { return null }

        // TODO: create proper list literal FeatureExpr
        // For now, wrap in a block
        Expr.Block(Block { statements: [], span: start })
    }

    // ─── Dot Variant ───────────────────────────

    fn parse_dot_variant(self) -> Expr? {
        let start = self.advance().span // consume .
        let name = self.expect_ident()
        if name == "" { return null }

        // .Variant(args) — enum constructor with args
        if self.check(TokenKind.LParen) {
            self.advance()
            let args = self.parse_call_args()
            self.expect(TokenKind.RParen)
            let span = self.merge_spans(start, self.peek_at(-1).span)
            return Expr.Ident(".${name}", span)
        }

        // .Variant — simple enum variant
        Expr.Ident(".${name}", start)
    }

    // ─── If Expression ─────────────────────────
    // Basic if/else parsing. Will be overridden by if_else feature.

    fn parse_if_expr(self) -> Expr? {
        let start = self.advance().span // consume 'if'
        self.skip_newlines()

        let condition = self.parse_expr()
        if condition == null { return null }

        self.skip_newlines()
        let then_block = self.parse_block()
        if then_block == null { return null }

        // Optional else
        self.skip_newlines()
        let has_else = self.check(TokenKind.Else)
        if has_else {
            self.advance()
            self.skip_newlines()
            if self.check(TokenKind.If) {
                // else if — wrap in block with single if expr
                let elif = self.parse_if_expr()
                let elif_block = Block { statements: [Statement.Expr(elif!)], span: self.current_span() }
                return make_if_with_else(condition!, then_block!, elif_block, start)
            } else {
                let else_block = self.parse_block()
                return make_if_with_else(condition!, then_block!, else_block!, start)
            }
        }

        make_if_no_else(condition!, then_block!, start)
    }

    // ─── Match Expression ──────────────────────
    // Basic match parsing. Will be overridden by pattern_matching feature.

    fn parse_match_expr(self) -> Expr? {
        let start = self.advance().span // consume 'match'
        self.skip_newlines()

        let scrutinee = self.parse_expr()
        if scrutinee == null { return null }

        self.skip_newlines()
        if self.expect(TokenKind.LBrace) == null { return null }

        // Parse match arms: pattern -> expr
        self.skip_newlines()
        while !self.check(TokenKind.RBrace) && !self.is_at_end() {
            self.skip_newlines()

            // Parse pattern (simplified: just an expression for now)
            let pattern = self.parse_expr()

            // Expect ->
            self.skip_newlines()
            if self.check(TokenKind.Arrow) {
                self.advance()
            }

            self.skip_newlines()

            // Parse body (discard result — match not fully implemented yet)
            if self.check(TokenKind.LBrace) {
                let _body = self.parse_block()
            } else {
                let _body = self.parse_expr()
            }

            self.skip_newlines()
        }

        self.expect(TokenKind.RBrace)

        // TODO: create proper match FeatureExpr
        Expr.Block(Block { statements: [], span: start })
    }

    // ─── Span Helper ───────────────────────────

    fn merge_spans(self, a: Span, b: Span) -> Span {
        Span {
            start: a.start,
            end: b.end,
            line: a.line,
            col: a.col,
        }
    }
}

// ─── Expr Span Access ──────────────────────────
// Helper to get span from any Expr variant.

impl Expr {
    fn span(self) -> Span {
        match self {
            .IntLit(_, span) -> span
            .FloatLit(_, span) -> span
            .StringLit(_, span) -> span
            .BoolLit(_, span) -> span
            .NullLit(span) -> span
            .Ident(name, span) -> span
            .Binary(_, _, _, span) -> span
            .Unary(_, _, span) -> span
            .Call(_, _, span) -> span
            .MemberAccess(_, _, span) -> span
            .Index(_, _, span) -> span
            .Block(block) -> block.span
            .Feature(fe) -> fe.data.node_span
        }
    }
}
