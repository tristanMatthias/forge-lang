use core.ast.{Expr, BinOp}
use core.token.Span

export fn decompose_template(raw: string, span: Span) -> Expr {
    // Brace chars as local vars to avoid confusing HOST parser
    let LBRACE = "{"
    let RBRACE = "}"
    let DOLLAR = "$"
    let dollar_brace = DOLLAR + LBRACE
    if raw.index_of(dollar_brace) < 0 {
        return Expr.StringLit(raw, span)
    }
    mut result: Expr = Expr.StringLit("", span)
    mut has = false
    mut pos = 0
    let len = raw.length
    while pos < len {
        mut dp = pos
        while dp < len - 1 {
            if raw[dp] == DOLLAR {
                if raw[dp + 1] == LBRACE {
                    break
                }
            }
            dp = dp + 1
        }
        let found = dp < len - 1 && raw[dp] == DOLLAR && raw[dp + 1] == LBRACE
        if found {
            if dp > pos {
                let lit = Expr.StringLit(raw.substring(pos, dp), span)
                if has {
                    result = Expr.Binary(result, BinOp.Add, lit, span)
                } else {
                    result = lit
                    has = true
                }
            }
            mut ep = dp + 2
            mut d = 1
            while ep < len && d > 0 {
                if raw[ep] == LBRACE {
                    d = d + 1
                }
                if raw[ep] == RBRACE {
                    d = d - 1
                }
                if d > 0 {
                    ep = ep + 1
                }
            }
            let et = raw.substring(dp + 2, ep)
            // Build chained member access: d.span.line → MemberAccess(MemberAccess(Ident("d"), "span"), "line")
            mut inner: Expr = Expr.Ident("", span)
            mut seg_start = 0
            mut seg_pos = 0
            mut first_seg = true
            while seg_pos <= et.length {
                mut is_dot = true
                if seg_pos < et.length { is_dot = et[seg_pos] == "." }
                if is_dot {
                    let seg = et.substring(seg_start, seg_pos)
                    if first_seg {
                        inner = Expr.Ident(seg, span)
                        first_seg = false
                    } else {
                        inner = Expr.MemberAccess(inner, seg, span)
                    }
                    seg_start = seg_pos + 1
                }
                seg_pos = seg_pos + 1
            }
            mut sc_args: List<Expr> = []
            sc_args = sc_args.push(inner)
            let sc = Expr.Call(Expr.Ident("string", span), sc_args, span)
            if has {
                result = Expr.Binary(result, BinOp.Add, sc, span)
            } else {
                result = sc
                has = true
            }
            pos = ep + 1
        } else {
            if pos < len {
                let lit = Expr.StringLit(raw.substring(pos, len), span)
                if has {
                    result = Expr.Binary(result, BinOp.Add, lit, span)
                } else {
                    result = lit
                    has = true
                }
            }
            pos = len
        }
    }
    result
}
