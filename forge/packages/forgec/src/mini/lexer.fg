mut LEX_SRC: string = ""
mut LEX_POS: int = 0
mut LEX_LINE: int = 1

fn lex_peek() -> string {
    if LEX_POS >= LEX_SRC.length { return "" }
    lex_char_at(LEX_POS)
}

fn lex_advance() -> string {
    if LEX_POS >= LEX_SRC.length { return "" }
    let ch = lex_char_at(LEX_POS)
    LEX_POS = LEX_POS + 1
    ch
}

fn lex_is_alpha(ch: string) -> bool {
    if ch == "_" { return true }
    if ch >= "a" && ch <= "z" { return true }
    if ch >= "A" && ch <= "Z" { return true }
    false
}

fn lex_is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

fn lex_is_alnum(ch: string) -> bool {
    if lex_is_alpha(ch) { return true }
    lex_is_digit(ch)
}

// Byte-based versions (no string allocation)
fn lex_is_alpha_b(b: int) -> bool {
    if b == 95 { return true }
    if b >= 97 && b <= 122 { return true }
    if b >= 65 && b <= 90 { return true }
    false
}

fn lex_is_digit_b(b: int) -> bool {
    b >= 48 && b <= 57
}

fn lex_is_alnum_b(b: int) -> bool {
    if lex_is_alpha_b(b) { return true }
    lex_is_digit_b(b)
}


// ─── Codegen helpers (defined early for forward reference) ────────

fn ir_block_terminated() -> int {
    if IR.length == 0 { return 0 }
    let last = IR[IR.length - 1]
    if last.contains("ret ") { return 1 }
    if last.contains("ret void") { return 1 }
    if last.contains("unreachable") { return 1 }
    if last.contains("br label") { return 1 }
    if last.contains("br i1") { return 1 }
    0
}

fn set_field_type(fty: string) {
    LAST_IS_STR = 0
    LAST_IS_PTR = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    LAST_IS_LIST = 0
    if fty == "ptr" {
        LAST_IS_PTR = 1
        return
    }
    if fty == "%ForgeString" {
        LAST_IS_STR = 1
    }
    if fty == "{ ptr, i64 }" {
        LAST_IS_LIST = 1
    }
    if is_list_type(fty) {
        LAST_IS_LIST = 1
        LAST_LIST_ELEM_TYPE = fty.substring(5, fty.length)
    }
    // Check for struct field type
    if fty.length > 1 {
        if fty.substring(0, 1) == "%" {
            if fty != "%ForgeString" {
                let tname = fty.substring(1, fty.length)
                LAST_STRUCT_TYPE = tname
                LAST_ENUM_TYPE = tname
            }
        }
    }
}

fn byte_at_pos(pos: int) -> int {
    // Get raw byte value at position (avoids string comparison issues)
    // 34 = double quote, 10 = newline
    LEX_SRC.byte_at(pos)
}

fn is_slash(c: string) -> bool {
    c.substring(0, 1) == "/"
}

fn not_at_end() -> bool {
    POS < TOKENS.length
}

fn not_at_brace() -> bool {
    if POS >= TOKENS.length { return false }
    let t: Tok = TOKENS[POS]
    if t.kind == 3 { return true }
    if t.text == "}" { return false }
    true
}

fn not_at_paren() -> bool {
    if POS >= TOKENS.length { return false }
    let t: Tok = TOKENS[POS]
    // Don't match string literals as closing paren
    if t.kind == 3 { return true }
    if t.text == ")" { return false }
    true
}

fn lex_char_at(pos: int) -> string {
    LEX_SRC.substring(pos, pos + 1)
}

fn lex_skip_whitespace() {
    while LEX_POS < LEX_SRC.length {
        let b = byte_at_pos(LEX_POS)
        if b == 32 {
            LEX_POS = LEX_POS + 1
        } else if b == 9 {
            LEX_POS = LEX_POS + 1
        } else if b == 13 {
            LEX_POS = LEX_POS + 1
        } else if b == 47 {
            if LEX_POS + 1 < LEX_SRC.length {
                if byte_at_pos(LEX_POS + 1) == 47 {
                    while LEX_POS < LEX_SRC.length && byte_at_pos(LEX_POS) != 10 {
                        LEX_POS = LEX_POS + 1
                    }
                    return
                } else {
                    return
                }
            } else {
                return
            }
        } else {
            return
        }
    }
}

fn lex_read_string() -> string {
    LEX_POS = LEX_POS + 1 // skip opening "
    let start = LEX_POS
    // Fast scan: check if string has any escape sequences
    mut has_escape = false
    mut scan = LEX_POS
    while scan < LEX_SRC.length && byte_at_pos(scan) != 34 {
        if byte_at_pos(scan) == 92 { has_escape = true }
        scan = scan + 1
    }
    // Fast path: no escapes, just substring
    if !has_escape {
        let result = LEX_SRC.substring(start, scan)
        LEX_POS = scan
        if LEX_POS < LEX_SRC.length { LEX_POS = LEX_POS + 1 }
        return result
    }
    // Slow path: handle escape sequences
    mut result = ""
    while LEX_POS < LEX_SRC.length && byte_at_pos(LEX_POS) != 34 {
        let ch_b = byte_at_pos(LEX_POS)
        if ch_b == 92 && LEX_POS + 1 < LEX_SRC.length {
            LEX_POS = LEX_POS + 1
            let esc_b = byte_at_pos(LEX_POS)
            LEX_POS = LEX_POS + 1
            if esc_b == 110 {
                result = result + "\n"
            } else if esc_b == 116 {
                result = result + "\t"
            } else if esc_b == 92 {
                result = result + "\\"
            } else if esc_b == 34 {
                result = result + "\""
            } else {
                result = result + "\\" + LEX_SRC.substring(LEX_POS - 1, LEX_POS)
            }
        } else {
            result = result + LEX_SRC.substring(LEX_POS, LEX_POS + 1)
            LEX_POS = LEX_POS + 1
        }
    }
    if LEX_POS < LEX_SRC.length { LEX_POS = LEX_POS + 1 }
    result
}

fn lex_next() -> Tok {
    lex_skip_whitespace()
    if LEX_POS >= LEX_SRC.length {
        return Tok { kind: 0, text: "", line: LEX_LINE }
    }

    let line = LEX_LINE
    let b = byte_at_pos(LEX_POS)

    // Newline (byte 10)
    if b == 10 {
        LEX_POS = LEX_POS + 1
        return Tok { kind: 4, text: "\n", line: line }
    }
    // String literal (byte 34 = ")
    if b == 34 {
        let s = lex_read_string()
        return Tok { kind: 3, text: s, line: line }
    }

    // Template string (byte 96 = backtick)
    if b == 96 {
        LEX_POS = LEX_POS + 1 // skip opening backtick
        let start = LEX_POS
        while LEX_POS < LEX_SRC.length && byte_at_pos(LEX_POS) != 96 {
            LEX_POS = LEX_POS + 1
        }
        let tmpl = LEX_SRC.substring(start, LEX_POS)
        if LEX_POS < LEX_SRC.length { LEX_POS = LEX_POS + 1 } // skip closing backtick
        return Tok { kind: 7, text: tmpl, line: line }
    }

    // Number — span-based
    if lex_is_digit_b(b) {
        let start = LEX_POS
        while LEX_POS < LEX_SRC.length && lex_is_digit_b(byte_at_pos(LEX_POS)) {
            LEX_POS = LEX_POS + 1
        }
        return Tok { kind: 2, text: LEX_SRC.substring(start, LEX_POS), line: line }
    }

    // Identifier / keyword — span-based
    if lex_is_alpha_b(b) {
        let start = LEX_POS
        while LEX_POS < LEX_SRC.length && lex_is_alnum_b(byte_at_pos(LEX_POS)) {
            LEX_POS = LEX_POS + 1
        }
        let word = LEX_SRC.substring(start, LEX_POS)
        if word == "true" || word == "false" {
            return Tok { kind: 6, text: word, line: line }
        }
        return Tok { kind: 1, text: word, line: line }
    }

    // Two-character operators — byte-pair detection
    if LEX_POS + 1 < LEX_SRC.length {
        let b2 = byte_at_pos(LEX_POS + 1)
        mut is_two = false
        if b == 61 && b2 == 61 { is_two = true }
        if b == 33 && b2 == 61 { is_two = true }
        if b == 60 && b2 == 61 { is_two = true }
        if b == 62 && b2 == 61 { is_two = true }
        if b == 38 && b2 == 38 { is_two = true }
        if b == 124 && b2 == 124 { is_two = true }
        if b == 124 && b2 == 62 { is_two = true }
        if b == 45 && b2 == 62 { is_two = true }
        if is_two {
            let two = LEX_SRC.substring(LEX_POS, LEX_POS + 2)
            LEX_POS = LEX_POS + 2
            return Tok { kind: 5, text: two, line: line }
        }
    }

    // Single-character symbol
    let sym = LEX_SRC.substring(LEX_POS, LEX_POS + 1)
    LEX_POS = LEX_POS + 1
    Tok { kind: 5, text: sym, line: line }
}

fn tokenize(source: string) -> List<Tok> {
    LEX_SRC = source
    LEX_POS = 0
    LEX_LINE = 1
    // Use C-side token accumulator (amortized O(1) push instead of O(n) list copy)
    forge_tok_clear()
    while true {
        let tok: Tok = lex_next()
        forge_tok_push(tok.kind, tok.text, tok.line)
        if tok.kind == 0 { break }
    }
    let count = forge_tok_count()
    eprintln("  " + string(count) + " tokens")
    forge_tok_to_list()
}
