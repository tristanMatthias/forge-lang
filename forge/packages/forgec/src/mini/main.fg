// Mini Forge Compiler — self-hosted (multi-file)
use @std.process
use @std.fs
mod types
mod lexer
mod state
mod registry
mod packages
mod parser
mod codegen
mod bridge
// ═══════════════════════════════════════════════════════════════════
// MODULE RESOLUTION
// ═══════════════════════════════════════════════════════════════════

// Extract directory from a file path: "/foo/bar/baz.fg" → "/foo/bar"
fn path_dir(path: string) -> string {
    mut last_slash = -1
    mut i = 0
    while i < path.length {
        if path.substring(i, i + 1) == "/" {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 { return "." }
    path.substring(0, last_slash)
}

// Collect module file paths from "mod " declarations in source text
fn collect_mod_paths(dir: string, source: string) -> List<string> {
    mut paths: List<string> = []
    mut i = 0
    while i < source.length {
        mut at_line_start = false
        if i == 0 { at_line_start = true }
        if i > 0 {
            if source.byte_at(i - 1) == 10 { at_line_start = true }
        }
        if at_line_start && i + 4 < source.length {
            if source.substring(i, i + 4) == "mod " {
                mut j = i + 4
                while j < source.length && source.byte_at(j) != 10 && source.byte_at(j) != 32 && source.byte_at(j) != 13 {
                    j = j + 1
                }
                let mod_name = source.substring(i + 4, j)
                // Try mod_name.fg then mod_name/mod.fg
                mut mod_path = dir + "/" + mod_name + ".fg"
                let test = fs.read(mod_path)
                if test.length == 0 {
                    mod_path = dir + "/" + mod_name + "/mod.fg"
                }
                paths = paths.push(mod_path)
            }
        }
        i = i + 1
    }
    paths
}

// Read source file + all mod dependencies, return concatenated source
fn resolve_modules(path: string) -> string {
    let source = fs.read(path)
    if source.length == 0 { return "" }
    let dir = path_dir(path)
    let mod_paths: List<string> = collect_mod_paths(dir, source)

    // Collect all sources into a list, then join once
    mut all: List<string> = []
    all = all.push(source)
    mut i = 0
    while i < mod_paths.length {
        let mp = mod_paths[i]
        let mod_source = resolve_modules(mp)
        if mod_source.length > 0 {
            all = all.push(mod_source)
        }
        i = i + 1
    }
    forge_join_lines(all)
}

// ═══════════════════════════════════════════════════════════════════
// MAIN
// ═══════════════════════════════════════════════════════════════════

fn main() {
    let args: List<string> = process.args()

    if args.length < 3 {
        eprintln("mini-forge v0.2 - self-hosted compiler")
        eprintln("Usage: mini build <file.fg> [output]")
        process.exit(1)
    }

    let command = args[1]
    let input = args[2]
    let source = resolve_modules(input)

    if source.length == 0 {
        eprintln("error: could not read " + input)
        process.exit(1)
    }

    // Open IR file for streaming (ir_line/ir_raw write directly)
    let ir_path = "/tmp/mini_output.ll"
    forge_ir_open(ir_path)
    eprintln("  lex + parse + codegen: " + input)
    compile(source)
    eprintln("  IR: " + string(IR_LINE_COUNT) + " + " + string(STR_DECLS.length) + " lines")
    // Write string constants
    forge_ir_line("")
    mut si = 0
    while si < STR_DECLS.length {
        forge_ir_line(STR_DECLS[si])
        si = si + 1
    }
    forge_ir_close()
    eprintln("  wrote IR to " + ir_path)

    // Compile
    mut output = "a.out"
    if args.length > 3 { output = args[3] }

    let llc_result = process.run("/opt/homebrew/opt/llvm@18/bin/llc", ["-O2", "-filetype=obj", ir_path, "-o", "/tmp/mini_output.o"])
    if !llc_result.contains("\"code\":0") {
        eprintln("error: llc failed")
        eprintln(llc_result)
        // Write IR for debugging
        eprintln("IR written to " + ir_path)
        process.exit(1)
    }

    let rt_result = process.run("cc", ["-c", "-O0", "stdlib/runtime.c", "-o", "/tmp/mini_runtime.o"])
    // Build link command with package libraries
    mut link_args: List<string> = ["-o", output, "/tmp/mini_output.o", "/tmp/mini_runtime.o", "-lm", "-Wl,-stack_size,0x800000"]
    let pkg_args: List<string> = get_link_args()
    mut pi = 0
    while pi < pkg_args.length {
        link_args = link_args.push(pkg_args[pi])
        pi = pi + 1
    }
    let link_result = process.run("cc", link_args)
    if !link_result.contains("\"code\":0") {
        eprintln("error: linker failed")
        eprintln(link_result)
        process.exit(1)
    }

    println("compiled: " + output)
}
