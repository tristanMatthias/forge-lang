    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string,string")
    FN_NAMES = FN_NAMES.push("forge_string_eq")
    FN_RETTYPES = FN_RETTYPES.push("i64")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(2)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string,string")
    FN_NAMES = FN_NAMES.push("forge_string_concat")
