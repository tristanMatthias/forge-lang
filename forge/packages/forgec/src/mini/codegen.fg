// ═══════════════════════════════════════════════════════════════════
// AST CODEGEN — walks Expr/Stmt trees and emits IR text
// ═══════════════════════════════════════════════════════════════════

// Access child Expr from a List<Expr>
fn gen_child(children: List<Expr>, idx: int) -> string {
    if idx < 0 || idx >= children.length {
        eprintln("  [gen_child] OOB idx=" + string(idx) + " len=" + string(children.length))
        return "0"
    }
    let child: Expr = children[idx]
    gen_expr(child)
}

fn gen_expr_child(parent: Expr, idx: int) -> string {
    gen_child(parent.children, idx)
}

fn gen_expr_from(s: Stmt, idx: int) -> string {
    gen_child(s.exprs, idx)
}

fn gen_expr(e: Expr) -> string {
    match e.kind {
        .IntLit -> {
            return string(e.int_val)
        }
        .StrLit -> {
            let sc = new_str_const(e.str_val)
            let r = new_reg()
            ir_line(r + " = call %ForgeString @forge_string_new(ptr " + sc + ", i64 " + string(e.str_val.length) + ")")
            reg_set_type(r, "%ForgeString")
            LAST_IS_STR = 1
            return r
        }
        .BoolLit -> {
            return string(e.int_val)
        }
        .Null -> {
            return "zeroinitializer"
        }
        .Ident -> {
            return gen_ident(e.str_val)
        }
        .Binary -> {
            // Handle null comparison: expr == null / expr != null
            if (e.str_val == "==" || e.str_val == "!=") && e.children.length == 2 {
                let rhs_node: Expr = e.children[1]
                if rhs_node.kind is .Null {
                    let lhs = gen_expr_child(e, 0)
                    // For struct/enum types, always non-null (no nullable wrapping yet)
                    // For string types, null = zero-length or null ptr
                    if LAST_IS_STR == 1 {
                        let sptr = new_reg()
                        ir_line(sptr + " = extractvalue %ForgeString " + lhs + ", 0")
                        let cmp = new_reg()
                        mut null_pred = "eq"
                        if e.str_val == "!=" { null_pred = "ne" }
                        ir_line(cmp + " = icmp " + null_pred + " ptr " + sptr + ", null")
                        let r = new_reg()
                        ir_line(r + " = zext i1 " + cmp + " to i64")
                        LAST_IS_STR = 0
                        return r
                    }
                    // For ptr types, compare to null
                    if LAST_IS_PTR == 1 {
                        let cmp = new_reg()
                        let r = new_reg()
                        if e.str_val == "==" {
                            ir_line(cmp + " = icmp eq ptr " + lhs + ", null")
                        } else {
                            ir_line(cmp + " = icmp ne ptr " + lhs + ", null")
                        }
                        ir_line(r + " = zext i1 " + cmp + " to i64")
                        LAST_IS_STR = 0
                        LAST_IS_PTR = 0
                        LAST_STRUCT_TYPE = ""
                        LAST_ENUM_TYPE = ""
                        return r
                    }
                    // For struct types, == null is always false, != null always true
                    if LAST_STRUCT_TYPE.length > 0 || LAST_ENUM_TYPE.length > 0 {
                        LAST_IS_STR = 0
                        LAST_STRUCT_TYPE = ""
                        LAST_ENUM_TYPE = ""
                        if e.str_val == "==" { return "0" }
                        return "1"
                    }
                    // Default: comparison with 0/null
                    mut null_pred = "eq"
                    if e.str_val == "!=" { null_pred = "ne" }
                    // Check register type to handle list/struct null checks
                    let lhs_rty = reg_get_type(lhs)
                    if LAST_IS_LIST == 1 || lhs_rty == "{ ptr, i64 }" {
                        // List null check: extract data ptr and compare
                        let dp = new_reg()
                        ir_line(dp + " = extractvalue { ptr, i64 } " + lhs + ", 0")
                        let r = new_reg()
                        ir_line(r + " = icmp " + null_pred + " ptr " + dp + ", null")
                        let r2 = new_reg()
                        ir_line(r2 + " = zext i1 " + r + " to i64")
                        return r2
                    }
                    if lhs_rty == "ptr" || LAST_IS_PTR == 1 {
                        // Ptr null check
                        let r = new_reg()
                        ir_line(r + " = icmp " + null_pred + " ptr " + lhs + ", null")
                        let r2 = new_reg()
                        ir_line(r2 + " = zext i1 " + r + " to i64")
                        return r2
                    }
                    if lhs_rty.length > 1 && lhs_rty.substring(0, 1) == "%" {
                        // Struct/enum null check — non-null unless zeroinitializer
                        if e.str_val == "==" { return "0" }
                        return "1"
                    }
                    let r = new_reg()
                    ir_line(r + " = icmp " + null_pred + " i64 " + lhs + ", 0")
                    let r2 = new_reg()
                    ir_line(r2 + " = zext i1 " + r + " to i64")
                    return r2
                }
            }
            // Handle .Variant comparison: expr == .Error
            if (e.str_val == "==" || e.str_val == "!=") && e.children.length == 2 {
                let rhs_check: Expr = e.children[1]
                if rhs_check.kind is .EnumLit {
                    if rhs_check.str_val.length > 0 && rhs_check.str_val.substring(0, 1) == "." {
                        // Bare .Variant — infer enum type from LHS
                        let lhs = gen_expr_child(e, 0)
                        let enum_name = LAST_ENUM_TYPE
                        let ei = find_enum(enum_name)
                        let vname = rhs_check.str_val.substring(1, rhs_check.str_val.length)
                        let vidx = enum_variant_index(ei, vname)
                        let tag = new_reg()
                        ir_line(tag + " = extractvalue %" + enum_name + " " + lhs + ", 0")
                        let cmp = new_reg()
                        mut cmp_pred = "eq"
                        if e.str_val == "!=" { cmp_pred = "ne" }
                        ir_line(cmp + " = icmp " + cmp_pred + " i64 " + tag + ", " + string(vidx))
                        let r = new_reg()
                        ir_line(r + " = zext i1 " + cmp + " to i64")
                        LAST_IS_STR = 0
                        LAST_ENUM_TYPE = ""
                        LAST_STRUCT_TYPE = ""
                        return r
                    }
                }
            }
            // Handle 'is' pattern: expr is .Variant
            if e.str_val == "is" || e.str_val == "is_not" {
                let lhs = gen_expr_child(e, 0)
                let enum_name = LAST_ENUM_TYPE
                let ei = find_enum(enum_name)
                // rhs is expr_str(variant_name)
                let rhs_expr: Expr = e.children[1]
                let vname = rhs_expr.str_val
                let vidx = enum_variant_index(ei, vname)
                let tag = new_reg()
                ir_line(tag + " = extractvalue %" + enum_name + " " + lhs + ", 0")
                let cmp = new_reg()
                mut is_pred = "eq"
                if e.str_val == "is_not" { is_pred = "ne" }
                ir_line(cmp + " = icmp " + is_pred + " i64 " + tag + ", " + string(vidx))
                let r = new_reg()
                ir_line(r + " = zext i1 " + cmp + " to i64")
                LAST_IS_STR = 0
                LAST_IS_LIST = 0
                LAST_STRUCT_TYPE = ""
                LAST_ENUM_TYPE = ""
                return r
            }
            let lhs = gen_expr_child(e, 0)
            let lhs_str = LAST_IS_STR
            mut lhs_enum = LAST_ENUM_TYPE
            let lhs_struct = LAST_STRUCT_TYPE
            // Register table fallback for enum detection
            if lhs_enum.length == 0 {
                let lrt = reg_get_type(lhs)
                if lrt.length > 1 && lrt.substring(0, 1) == "%" && lrt != "%ForgeString" {
                    let tname = lrt.substring(1, lrt.length)
                    if find_enum(tname) >= 0 { lhs_enum = tname }
                }
            }
            let rhs = gen_expr_child(e, 1)
            // Check RHS for enum type too
            if lhs_enum.length == 0 {
                let rrt = reg_get_type(rhs)
                if rrt.length > 1 && rrt.substring(0, 1) == "%" && rrt != "%ForgeString" {
                    let rtname = rrt.substring(1, rrt.length)
                    if find_enum(rtname) >= 0 { lhs_enum = rtname }
                }
            }
            // Enum-to-enum comparison: compare tags (field 0)
            if (e.str_val == "==" || e.str_val == "!=") && lhs_enum.length > 0 {
                let ety = "%" + lhs_enum
                let lrt = reg_get_type(lhs)
                let rrt2 = reg_get_type(rhs)
                mut lt_val = ""
                mut rt_val = ""
                // LHS: extract tag if it's the enum type, otherwise use as i64
                if lrt == ety || lrt == "" {
                    let lt = new_reg()
                    ir_line(lt + " = extractvalue " + ety + " " + lhs + ", 0")
                    lt_val = lt
                } else {
                    lt_val = lhs
                }
                // RHS: same logic
                if rrt2 == ety || rrt2 == "" {
                    let rt = new_reg()
                    ir_line(rt + " = extractvalue " + ety + " " + rhs + ", 0")
                    rt_val = rt
                } else {
                    rt_val = rhs
                }
                let cmp = new_reg()
                mut pred = "eq"
                if e.str_val == "!=" { pred = "ne" }
                ir_line(cmp + " = icmp " + pred + " i64 " + lt_val + ", " + rt_val)
                let r = new_reg()
                ir_line(r + " = zext i1 " + cmp + " to i64")
                LAST_IS_STR = 0
                LAST_ENUM_TYPE = ""
                return r
            }
            return gen_binary(e.str_val, lhs, rhs, lhs_str)
        }
        .Unary -> {
            let val = gen_expr_child(e, 0)
            let r = new_reg()
            if e.str_val == "!" {
                let t = new_reg()
                ir_line(t + " = trunc i64 " + val + " to i1")
                let n = new_reg()
                ir_line(n + " = xor i1 " + t + ", true")
                ir_line(r + " = zext i1 " + n + " to i64")
            } else {
                ir_line(r + " = sub i64 0, " + val)
            }
            return r
        }
        .Call -> {
            return gen_call(e)
        }
        .Member -> {
            let obj = gen_expr_child(e, 0)
            return gen_member(obj, e.str_val)
        }
        .Index -> {
            let obj = gen_expr_child(e, 0)
            let obj_is_str = LAST_IS_STR
            let obj_is_list = LAST_IS_LIST
            let elem_ty = LAST_LIST_ELEM_TYPE
            let idx = gen_expr_child(e, 1)
            if obj_is_str == 1 {
                let r = new_reg()
                ir_line(r + " = call %ForgeString @forge_string_char_at(%ForgeString " + obj + ", i64 " + idx + ")")
                LAST_IS_STR = 1
                return r
            }
            if obj_is_list == 1 {
                let dp = new_reg()
                ir_line(dp + " = extractvalue { ptr, i64 } " + obj + ", 0")
                let ep = new_reg()
                ir_line(ep + " = getelementptr " + elem_ty + ", ptr " + dp + ", i64 " + idx)
                let ev = new_reg()
                ir_line(ev + " = load " + elem_ty + ", ptr " + ep)
                LAST_IS_LIST = 0
                set_field_type(elem_ty)
                return ev
            }
            return obj
        }
        .StructLit -> {
            // str_val = "TypeName|field1,field2,..."
            let pipe_idx = e.str_val.index_of("|")
            let sname = e.str_val.substring(0, pipe_idx)
            let field_csv = e.str_val.substring(pipe_idx + 1, e.str_val.length)
            let si = find_struct(sname)
            let sty = struct_llvm_type(sname)
            mut cur = "zeroinitializer"
            mut fi = 0
            while fi < e.children.length {
                // Get field name from CSV
                mut fname = field_csv
                if fi == 0 {
                    let comma_idx = field_csv.index_of(",")
                    if comma_idx >= 0 { fname = field_csv.substring(0, comma_idx) }
                } else {
                    // Find the fi-th comma-separated entry
                    mut ci = 0
                    mut start = 0
                    mut end = field_csv.length
                    mut pos = 0
                    while pos < field_csv.length {
                        if field_csv.substring(pos, pos + 1) == "," {
                            if ci == fi - 1 { start = pos + 1 }
                            if ci == fi { end = pos }
                            ci = ci + 1
                        }
                        pos = pos + 1
                    }
                    if ci == fi - 1 { start = pos }
                    fname = field_csv.substring(start, end)
                }
                let fval = gen_expr_child(e, fi)
                let fidx = struct_field_index(si, fname)
                if fidx >= 0 {
                    let fty = struct_field_type(si, fidx)
                    // Verify register type matches field type; use zeroinitializer if mismatch
                    let actual_ty = reg_get_type(fval)
                    if actual_ty.length > 0 && actual_ty != fty {
                        eprintln("  [type-fix] " + sname + "." + fname + ": field=" + fty + " actual=" + actual_ty + " val=" + fval)
                    }
                    mut final_val = fval
                    // Fix double literals: "0" → "0.0" for double fields
                    if fty == "double" && final_val == "0" { final_val = "0.0" }
                    if actual_ty.length > 0 && actual_ty != fty {
                        // Type mismatch between value and field
                        if actual_ty == "i64" && fty == "%ForgeString" { final_val = "zeroinitializer" }
                        if actual_ty == "i64" && fty == "ptr" { final_val = "null" }
                        if actual_ty == "i64" && fty == "{ ptr, i64 }" { final_val = "zeroinitializer" }
                        if actual_ty == "i64" && fty.length > 1 && fty.substring(0, 1) == "%" && fty != "%ForgeString" { final_val = "zeroinitializer" }
                        if actual_ty != "i64" {
                            if fty == "i64" { final_val = "0" }
                            if fty == "double" { final_val = "0.0" }
                            if fty == "ptr" { final_val = "null" }
                            if fty == "%ForgeString" { final_val = "zeroinitializer" }
                            if fty.length > 1 && fty.substring(0, 1) == "%" && final_val == fval { final_val = "zeroinitializer" }
                        }
                    }
                    // Fix literal 0 for non-i64 field types
                    if fty == "ptr" && (final_val == "0" || final_val == "zeroinitializer") { final_val = "null" }
                    if fty == "double" && final_val == "0" { final_val = "0.0" }
                    if fty == "%ForgeString" && final_val == "0" { final_val = "zeroinitializer" }
                    if fty == "{ ptr, i64 }" && final_val == "0" { final_val = "zeroinitializer" }
                    // Any struct/enum type with literal 0
                    if fty.length > 1 && fty.substring(0, 1) == "%" && fty != "%ForgeString" && final_val == "0" {
                        final_val = "zeroinitializer"
                    }
                    let nr = new_reg()
                    ir_line(nr + " = insertvalue " + sty + " " + cur + ", " + fty + " " + final_val + ", " + string(fidx))
                    reg_set_type(nr, sty)
                    cur = nr
                }
                fi = fi + 1
            }
            LAST_STRUCT_TYPE = sname
            LAST_IS_STR = 0
            LAST_IS_LIST = 0
            LAST_ENUM_TYPE = ""
            return cur
        }
        .EnumLit -> {
            // Heap-allocated enum: { i64 tag, ptr payload }
            // Payload is a heap-allocated variant struct
            let dot_idx = e.str_val.index_of(".")
            if dot_idx < 0 { return "0" }
            mut ename = e.str_val.substring(0, dot_idx)
            if ename.length == 0 && CUR_RET_TY.length > 1 && CUR_RET_TY.substring(0, 1) == "%" {
                let candidate = CUR_RET_TY.substring(1, CUR_RET_TY.length)
                // Only use CUR_RET_TY if it's an enum (not a struct)
                if find_enum(candidate) >= 0 { ename = candidate }
            }
            let vname = e.str_val.substring(dot_idx + 1, e.str_val.length)
            mut ei = find_enum(ename)
            // If enum not found, return 0 (unresolved shorthand)
            if ei < 0 { return "0" }
            mut vidx = enum_variant_index(ei, vname)
            // If variant not found in resolved enum, search ALL enums
            if vidx < 0 {
                mut search_ei = 0
                while search_ei < ENUM_NAMES.length {
                    let try_vidx = enum_variant_index(search_ei, vname)
                    if try_vidx >= 0 {
                        ei = search_ei
                        ename = ENUM_NAMES[search_ei]
                        vidx = try_vidx
                        break
                    }
                    search_ei = search_ei + 1
                }
            }
            let ety = "%" + ename

            if vidx < 0 { return "0" }
            if ei < 0 || ei >= ENUM_VARIANT_STARTS.length { return "0" }
            let gvi = ENUM_VARIANT_STARTS[ei] + vidx
            if gvi < 0 || gvi >= EVAR_FIELD_COUNTS.length { return "0" }
            let fc = EVAR_FIELD_COUNTS[gvi]
            let fs = EVAR_FIELD_STARTS[gvi]

            // Build variant struct type
            mut variant_fields = ""
            mut vfi = 0
            while vfi < fc {
                if vfi > 0 { variant_fields = variant_fields + ", " }
                if fs + vfi < EFIELD_TYPES.length {
                    variant_fields = variant_fields + EFIELD_TYPES[fs + vfi]
                } else {
                    variant_fields = variant_fields + "i64"
                }
                vfi = vfi + 1
            }
            let variant_ty = "{ " + variant_fields + " }"

            // Heap-allocate the variant struct
            mut payload_ptr = "null"
            if fc > 0 {
                let vsize = new_reg()
                ir_line(vsize + " = ptrtoint ptr getelementptr (" + variant_ty + ", ptr null, i32 1) to i64")
                payload_ptr = new_reg()
                ir_line(payload_ptr + " = call ptr @forge_alloc(i64 " + vsize + ")")

                // Compile and store each field
                mut fi = 0
                while fi < fc && fi < e.children.length {
                    let fval = gen_expr_child(e, fi)
                    mut fty = "i64"
                    if fs + fi < EFIELD_TYPES.length { fty = EFIELD_TYPES[fs + fi] }
                    let fptr = new_reg()
                    ir_line(fptr + " = getelementptr inbounds " + variant_ty + ", ptr " + payload_ptr + ", i32 0, i32 " + string(fi))
                    mut store_val = fval
                    if fty == "double" && store_val == "0" { store_val = "0.0" }
                    let actual_fty = reg_get_type(fval)
                    if fty == "double" && (actual_fty == "i64" || actual_fty == "") && store_val != "0.0" {
                        let conv = new_reg()
                        ir_line(conv + " = sitofp i64 " + store_val + " to double")
                        store_val = conv
                    }
                    if actual_fty.length > 0 && actual_fty != fty && actual_fty != "i64" {
                        if fty == "i64" { store_val = "0" }
                        if fty == "ptr" { store_val = "null" }
                        if fty == "double" { store_val = "0.0" }
                        if fty == "%ForgeString" { store_val = "zeroinitializer" }
                    }
                    // Fix literal 0 for non-i64 types
                    if store_val == "0" && fty != "i64" && fty != "i8" {
                        if fty == "%ForgeString" { store_val = "zeroinitializer" }
                        if fty == "ptr" { store_val = "null" }
                        if fty == "double" { store_val = "0.0" }
                        if fty == "{ ptr, i64 }" { store_val = "zeroinitializer" }
                        if fty.length > 1 && fty.substring(0, 1) == "%" && fty != "%ForgeString" {
                            store_val = "zeroinitializer"
                        }
                    }
                    ir_line("store " + fty + " " + store_val + ", ptr " + fptr)
                    fi = fi + 1
                }
            }

            // Build enum value: { i64 tag, ptr payload }
            let e1 = new_reg()
            ir_line(e1 + " = insertvalue " + ety + " zeroinitializer, i64 " + string(vidx) + ", 0")
            let e2 = new_reg()
            ir_line(e2 + " = insertvalue " + ety + " " + e1 + ", ptr " + payload_ptr + ", 1")
            reg_set_type(e2, ety)
            LAST_ENUM_TYPE = ename
            LAST_STRUCT_TYPE = ""
            LAST_IS_STR = 0
            LAST_IS_LIST = 0
            return e2
        }
        .ListLit -> {
            let count = e.children.length
            mut elem_type = "i64"
            // Emit elements and collect registers
            mut elem_regs: List<string> = []
            mut ei = 0
            while ei < count {
                LAST_IS_STR = 0
                LAST_STRUCT_TYPE = ""
                LAST_ENUM_TYPE = ""
                let ev = gen_expr_child(e, ei)
                elem_regs = elem_regs.push(ev)
                if LAST_IS_STR == 1 { elem_type = "%ForgeString" }
                if LAST_STRUCT_TYPE.length > 0 { elem_type = "%" + LAST_STRUCT_TYPE }
                if LAST_ENUM_TYPE.length > 0 { elem_type = "%" + LAST_ENUM_TYPE }
                // Fallback: check register type table
                if elem_type == "i64" {
                    let rt = reg_get_type(ev)
                    if rt.length > 0 && rt != "i64" && rt != "i1" && rt != "i8" { elem_type = rt }
                }
                ei = ei + 1
            }
            // Allocate array
            let esize = new_reg()
            ir_line(esize + " = ptrtoint ptr getelementptr (" + elem_type + ", ptr null, i32 1) to i64")
            let total = new_reg()
            ir_line(total + " = mul i64 " + esize + ", " + string(count))
            let data = new_reg()
            ir_line(data + " = call ptr @forge_alloc(i64 " + total + ")")
            // Store elements
            ei = 0
            while ei < count {
                let ep = new_reg()
                ir_line(ep + " = getelementptr " + elem_type + ", ptr " + data + ", i64 " + string(ei))
                ir_line("store " + elem_type + " " + elem_regs[ei] + ", ptr " + ep)
                ei = ei + 1
            }
            let ls1 = new_reg()
            ir_line(ls1 + " = insertvalue { ptr, i64 } zeroinitializer, ptr " + data + ", 0")
            let ls2 = new_reg()
            ir_line(ls2 + " = insertvalue { ptr, i64 } " + ls1 + ", i64 " + string(count) + ", 1")
            LAST_IS_LIST = 1
            LAST_IS_STR = 0
            LAST_LIST_ELEM_TYPE = elem_type
            return ls2
        }
        .Closure -> {
            // Emit closure as anonymous function, return ptr to it
            let params_str = e.str_val
            CLOSURE_COUNT = CLOSURE_COUNT + 1
            let fn_name = "__closure_" + string(CLOSURE_COUNT)

            // Parse params from "x:int,y:int" format
            mut param_ir = ""
            mut param_names: List<string> = []
            mut param_types: List<string> = []
            if params_str.length > 0 {
                mut pi = 0
                mut pstart = 0
                while pi <= params_str.length {
                    mut is_sep = false
                    if pi == params_str.length { is_sep = true }
                    if pi < params_str.length {
                        if params_str.substring(pi, pi + 1) == "," { is_sep = true }
                    }
                    if is_sep {
                        let param = params_str.substring(pstart, pi)
                        let colon = param.index_of(":")
                        if colon >= 0 {
                            let pn = param.substring(0, colon)
                            let pt_name = param.substring(colon + 1, param.length)
                            let pt = type_to_llvm(pt_name)
                            param_names = param_names.push(pn)
                            param_types = param_types.push(pt)
                            if param_ir.length > 0 { param_ir = param_ir + ", " }
                            param_ir = param_ir + pt + " %" + pn + ".arg"
                        }
                        pstart = pi + 1
                    }
                    pi = pi + 1
                }
            }

            // Save current IR state
            let saved_ir: List<string> = IR
            let saved_reg = REG_N
            let saved_lbl = LBL_N
            let saved_ret = CUR_RET_TY

            // Emit closure function body
            IR = []
            REG_N = 0
            LBL_N = 0
            // Infer return type from body (default i64)
            CUR_RET_TY = "i64"

            ir_raw("define i64 @" + fn_name + "(" + param_ir + ") {")
            ir_raw("entry:")

            // Create param allocas
            mut ci = 0
            while ci < param_names.length {
                let alloca = new_reg()
                ir_line(alloca + " = alloca " + param_types[ci])
                ir_line("store " + param_types[ci] + " %" + param_names[ci] + ".arg, ptr " + alloca)
                push_var(param_names[ci], alloca, param_types[ci])
                ci = ci + 1
            }

            // Compile body expression
            LAST_IS_STR = 0
            LAST_IS_LIST = 0
            LAST_STRUCT_TYPE = ""
            LAST_ENUM_TYPE = ""
            let body_val = gen_expr_child(e, 0)
            ir_line("ret i64 " + body_val)
            ir_raw("}")
            ir_raw("")

            // Capture closure IR and restore state
            let closure_ir: List<string> = IR
            IR = saved_ir
            REG_N = saved_reg
            LBL_N = saved_lbl
            CUR_RET_TY = saved_ret

            // Store closure function in CLOSURE_IR (emitted between functions)
            mut ni = 0
            while ni < closure_ir.length {
                CLOSURE_IR = CLOSURE_IR.push(closure_ir[ni])
                ni = ni + 1
            }

            // Pop closure params from var table
            ci = 0
            while ci < param_names.length {
                // Simple: just leave them (they'll be shadowed by later scopes)
                ci = ci + 1
            }

            LAST_IS_STR = 0
            LAST_IS_LIST = 0
            LAST_IS_PTR = 1
            LAST_STRUCT_TYPE = ""
            LAST_ENUM_TYPE = ""
            return "@" + fn_name
        }
        _ -> {
            return "0"
        }
    }
    "0"
}

// Extract the Nth comma-separated field from a CSV string
fn csv_field(csv: string, idx: int) -> string {
    mut start = 0
    mut count = 0
    mut i = 0
    while i < csv.length {
        if csv[i] == "," {
            if count == idx {
                return csv.substring(start, i)
            }
            count = count + 1
            start = i + 1
        }
        i = i + 1
    }
    if count == idx {
        return csv.substring(start, csv.length)
    }
    ""
}

fn gen_ident(name: string) -> string {
    // Variable lookup (check first — local vars shadow namespaces)
    let idx = find_var(name)
    if idx >= 0 {
        let vty = VAR_TYPES[idx]
        return load_var_by_type(name, idx, vty)
    }
    // Built-in namespace handling (only if no local var found)
    if name == "process" || name == "fs" || is_namespace(name) {
        return "@" + name
    }
    // Function reference (only if the function exists)
    if find_fn_index(name) >= 0 {
        LAST_IS_PTR = 1
        return "@" + name
    }
    // Unknown identifier — return 0 as safe fallback
    "0"
}

fn gen_binary(op: string, lhs: string, rhs: string, lhs_str: int) -> string {
    let r = new_reg()
    // Register type table: detect string/struct/enum comparison
    if (op == "==" || op == "!=") && lhs_str == 0 {
        let lty = reg_get_type(lhs)
        let rty = reg_get_type(rhs)
        // String comparison detected via register table
        if lty == "%ForgeString" || rty == "%ForgeString" {
            // Ensure both operands are ForgeString — convert i64 if needed
            mut str_lhs = lhs
            mut str_rhs = rhs
            if lty == "i64" || lty == "" {
                let lp = new_reg()
                ir_line(lp + " = inttoptr i64 " + lhs + " to ptr")
                let ls = new_reg()
                ir_line(ls + " = insertvalue %ForgeString zeroinitializer, ptr " + lp + ", 0")
                let ls2 = new_reg()
                ir_line(ls2 + " = insertvalue %ForgeString " + ls + ", i64 0, 1")
                str_lhs = ls2
            }
            if rty == "i64" || rty == "" {
                let rp = new_reg()
                ir_line(rp + " = inttoptr i64 " + rhs + " to ptr")
                let rs = new_reg()
                ir_line(rs + " = insertvalue %ForgeString zeroinitializer, ptr " + rp + ", 0")
                let rs2 = new_reg()
                ir_line(rs2 + " = insertvalue %ForgeString " + rs + ", i64 0, 1")
                str_rhs = rs2
            }
            if op == "==" {
                let eq_r = new_reg()
                ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + str_lhs + ", %ForgeString " + str_rhs + ")")
                ir_line(r + " = zext i8 " + eq_r + " to i64")
                LAST_IS_STR = 0
                return r
            }
            if op == "!=" {
                let eq_r = new_reg()
                ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + str_lhs + ", %ForgeString " + str_rhs + ")")
                let ext = new_reg()
                ir_line(ext + " = zext i8 " + eq_r + " to i64")
                ir_line(r + " = icmp eq i64 " + ext + ", 0")
                let r2 = new_reg()
                ir_line(r2 + " = zext i1 " + r + " to i64")
                LAST_IS_STR = 0
                return r2
            }
        }
        if lty.length > 1 && lty.substring(0, 1) == "%" && lty != "%ForgeString" {
            // Struct/enum comparison — extract tag (field 0) and compare
            let lt = new_reg()
            ir_line(lt + " = extractvalue " + lty + " " + lhs + ", 0")
            let rt = new_reg()
            if rty == lty {
                ir_line(rt + " = extractvalue " + lty + " " + rhs + ", 0")
            } else {
                ir_line(rt + " = extractvalue " + lty + " " + rhs + ", 0")
            }
            let cmp = new_reg()
            mut pred = "eq"
            if op == "!=" { pred = "ne" }
            ir_line(cmp + " = icmp " + pred + " i8 " + lt + ", " + rt)
            let r2 = new_reg()
            ir_line(r2 + " = zext i1 " + cmp + " to i64")
            LAST_IS_STR = 0
            return r2
        }
    }
    if op == "+" && lhs_str == 1 {
        ir_line(r + " = call %ForgeString @forge_string_concat(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        reg_set_type(r, "%ForgeString")
        LAST_IS_STR = 1
        return r
    }
    if op == "==" && lhs_str == 1 {
        let eq_r = new_reg()
        ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        ir_line(r + " = zext i8 " + eq_r + " to i64")
        LAST_IS_STR = 0
        return r
    }
    if op == "!=" && lhs_str == 1 {
        let eq_r = new_reg()
        ir_line(eq_r + " = call i8 @forge_string_eq(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        let ext = new_reg()
        ir_line(ext + " = zext i8 " + eq_r + " to i64")
        ir_line(r + " = icmp eq i64 " + ext + ", 0")
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        LAST_IS_STR = 0
        return r2
    }
    if (op == "<" || op == ">" || op == "<=" || op == ">=") && lhs_str == 1 {
        let cmp_r = new_reg()
        ir_line(cmp_r + " = call i64 @forge_string_compare(%ForgeString " + lhs + ", %ForgeString " + rhs + ")")
        mut pred = "slt"
        if op == ">" { pred = "sgt" }
        if op == "<=" { pred = "sle" }
        if op == ">=" { pred = "sge" }
        ir_line(r + " = icmp " + pred + " i64 " + cmp_r + ", 0")
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        LAST_IS_STR = 0
        return r2
    }
    LAST_IS_STR = 0
    // Float operations
    let lf = reg_get_type(lhs) == "double"
    let rf = reg_get_type(rhs) == "double"
    if lf || rf || LAST_IS_FLOAT == 1 {
        // Ensure both operands are double
        mut fl = lhs
        mut fr = rhs
        if !lf {
            let conv = new_reg()
            ir_line(conv + " = sitofp i64 " + lhs + " to double")
            fl = conv
        }
        if !rf {
            let conv = new_reg()
            ir_line(conv + " = sitofp i64 " + rhs + " to double")
            fr = conv
        }
        if op == "+" { ir_line(r + " = fadd double " + fl + ", " + fr) }
        if op == "-" { ir_line(r + " = fsub double " + fl + ", " + fr) }
        if op == "*" { ir_line(r + " = fmul double " + fl + ", " + fr) }
        if op == "/" { ir_line(r + " = fdiv double " + fl + ", " + fr) }
        if op == "%" { ir_line(r + " = frem double " + fl + ", " + fr) }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            reg_set_type(r, "double")
            LAST_IS_FLOAT = 1
            return r
        }
        // Float comparison
        mut fpred = "oeq"
        if op == "!=" { fpred = "one" }
        if op == "<" { fpred = "olt" }
        if op == ">" { fpred = "ogt" }
        if op == "<=" { fpred = "ole" }
        if op == ">=" { fpred = "oge" }
        ir_line(r + " = fcmp " + fpred + " double " + fl + ", " + fr)
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        LAST_IS_FLOAT = 0
        return r2
    }
    // Coerce ptr operands to i64 for integer arithmetic
    mut ilhs = lhs
    mut irhs = rhs
    let lpty = reg_get_type(lhs)
    let rpty = reg_get_type(rhs)
    if lpty == "ptr" {
        let conv = new_reg()
        ir_line(conv + " = ptrtoint ptr " + lhs + " to i64")
        ilhs = conv
    }
    if rpty == "ptr" {
        let conv = new_reg()
        ir_line(conv + " = ptrtoint ptr " + rhs + " to i64")
        irhs = conv
    }
    // Integer operations
    if op == "+" {
        ir_line(r + " = add i64 " + ilhs + ", " + irhs)
        return r
    }
    if op == "-" {
        ir_line(r + " = sub i64 " + ilhs + ", " + irhs)
        return r
    }
    if op == "*" {
        ir_line(r + " = mul i64 " + ilhs + ", " + irhs)
        return r
    }
    if op == "/" {
        ir_line(r + " = sdiv i64 " + ilhs + ", " + irhs)
        return r
    }
    if op == "%" {
        ir_line(r + " = srem i64 " + ilhs + ", " + irhs)
        return r
    }
    // Comparisons
    mut pred = "eq"
    if op == "!=" { pred = "ne" }
    if op == "<" { pred = "slt" }
    if op == ">" { pred = "sgt" }
    if op == "<=" { pred = "sle" }
    if op == ">=" { pred = "sge" }
    if op == "&&" {
        let l1 = new_reg()
        ir_line(l1 + " = trunc i64 " + lhs + " to i1")
        let r1 = new_reg()
        ir_line(r1 + " = trunc i64 " + rhs + " to i1")
        ir_line(r + " = and i1 " + l1 + ", " + r1)
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        return r2
    }
    if op == "||" {
        let l1 = new_reg()
        ir_line(l1 + " = trunc i64 " + lhs + " to i1")
        let r1 = new_reg()
        ir_line(r1 + " = trunc i64 " + rhs + " to i1")
        ir_line(r + " = or i1 " + l1 + ", " + r1)
        let r2 = new_reg()
        ir_line(r2 + " = zext i1 " + r + " to i64")
        return r2
    }
    // Check if either operand is ptr type and coerce
    let lhs_ty = reg_get_type(lhs)
    let rhs_ty = reg_get_type(rhs)
    mut cmp_lhs = lhs
    mut cmp_rhs = rhs
    mut cmp_ty = "i64"
    if lhs_ty == "ptr" || rhs_ty == "ptr" {
        cmp_ty = "ptr"
        if lhs_ty != "ptr" {
            let conv = new_reg()
            ir_line(conv + " = inttoptr i64 " + lhs + " to ptr")
            cmp_lhs = conv
        }
        if rhs_ty != "ptr" {
            let conv = new_reg()
            ir_line(conv + " = inttoptr i64 " + rhs + " to ptr")
            cmp_rhs = conv
        }
    }
    ir_line(r + " = icmp " + pred + " " + cmp_ty + " " + cmp_lhs + ", " + cmp_rhs)
    let r2 = new_reg()
    ir_line(r2 + " = zext i1 " + r + " to i64")
    r2
}

fn gen_list_push(list_val: string, elem: string, elem_ty: string, saved_elem: string) -> string {
    LAST_LIST_ELEM_TYPE = saved_elem
    if elem_ty != "i64" { LAST_LIST_ELEM_TYPE = elem_ty }
    // Store elem to a temp alloca so we can pass its address
    let tmp = new_reg()
    ir_line(tmp + " = alloca " + elem_ty)
    ir_line("store " + elem_ty + " " + elem + ", ptr " + tmp)
    let elem_size = new_reg()
    ir_line(elem_size + " = ptrtoint ptr getelementptr (" + elem_ty + ", ptr null, i32 1) to i64")
    let result = new_reg()
    ir_line(result + " = call { ptr, i64 } @forge_list_push({ ptr, i64 } " + list_val + ", ptr " + tmp + ", i64 " + elem_size + ")")
    LAST_IS_LIST = 1
    LAST_IS_STR = 0
    result
}

fn is_ident_expr(e: Expr) -> bool {
    // Check if expr is an Ident by matching its kind
    match e.kind {
        .Ident -> { return true }
        _ -> { return false }
    }
    false
}

fn gen_call(e: Expr) -> string {
    let name = e.str_val

    // Generic namespace dispatch via package exports (skip process/fs — handled as builtins)
    if e.children.length >= 1 {
        let first: Expr = e.children[0]
        if is_ident_expr(first) && first.str_val != "process" && first.str_val != "fs" {
            mut mangled = find_ns_fn(first.str_val, name)
            // Fallback: if namespace is known but method not found, try ns_method
            if mangled.length == 0 && is_namespace(first.str_val) {
                mangled = first.str_val + "_" + name
                // Auto-declare if not yet seen
                mut already = false
                mut ai = 0
                while ai < AUTO_DECLARED.length {
                    if AUTO_DECLARED[ai] == mangled { already = true }
                    ai = ai + 1
                }
                if !already {
                    AUTO_DECLARED = AUTO_DECLARED.push(mangled)
                    // Register in FN tables — LLVM API functions return ptr, others i64
                    FN_NAMES = FN_NAMES.push(mangled)
                    if mangled.substring(0, 10) == "forge_llvm" {
                        FN_RETTYPES = FN_RETTYPES.push("ptr")
                    } else {
                        FN_RETTYPES = FN_RETTYPES.push("i64")
                    }
                    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(0)
                    FN_PARAM_TYPES = FN_PARAM_TYPES.push("")
                }
            }
            if mangled.length > 0 {
                // Call the mangled wrapper function, skip children[0] (namespace ident)
                let call_ret = find_fn_ret(mangled)
                mut arg_str = ""
                mut nsi = 1
                while nsi < e.children.length {
                    if nsi > 1 { arg_str = arg_str + ", " }
                    LAST_IS_STR = 0
                    LAST_IS_LIST = 0
                    LAST_IS_PTR = 0
                    LAST_STRUCT_TYPE = ""
                    LAST_ENUM_TYPE = ""
                    let a = gen_expr_child(e, nsi)
                    mut aty = "i64"
                    if LAST_IS_STR == 1 { aty = "%ForgeString" }
                    if LAST_IS_PTR == 1 { aty = "ptr" }
                    if LAST_IS_LIST == 1 { aty = "{ ptr, i64 }" }
                    if LAST_STRUCT_TYPE != "" { aty = "%" + LAST_STRUCT_TYPE }
                    if LAST_ENUM_TYPE != "" { aty = "%" + LAST_ENUM_TYPE }
                    if aty == "i64" {
                        let ns_art = reg_get_type(a)
                        if ns_art.length > 0 && ns_art != "i64" && ns_art != "i1" && ns_art != "i8" { aty = ns_art }
                    }
                    if a.length > 1 {
                        if a.substring(0, 1) == "@" { aty = "ptr" }
                    }
                    arg_str = arg_str + aty + " " + a
                    nsi = nsi + 1
                }
                if call_ret == "void" {
                    ir_line("call void @" + mangled + "(" + arg_str + ")")
                    LAST_IS_STR = 0
                    LAST_IS_LIST = 0
                    LAST_IS_PTR = 0
                    LAST_STRUCT_TYPE = ""
                    LAST_ENUM_TYPE = ""
                    return "0"
                }
                let r = new_reg()
                ir_line(r + " = call " + call_ret + " @" + mangled + "(" + arg_str + ")")
                reg_set_type(r, call_ret)
                LAST_IS_STR = 0
                LAST_IS_LIST = 0
                LAST_IS_PTR = 0
                LAST_STRUCT_TYPE = ""
                LAST_ENUM_TYPE = ""
                set_type_from_llvm(call_ret)
                return r
            }
        }
    }

    // Method resolution: p.method(args) → StructName_method(p, args)
    if e.children.length >= 1 {
        let first: Expr = e.children[0]
        // For non-ident first child (like member access: self.env.method()),
        // evaluate and use LAST_STRUCT_TYPE for method resolution
        if !is_ident_expr(first) && first.kind is .Member {
            LAST_STRUCT_TYPE = ""
            let obj_val = gen_expr_child(e, 0)
            let obj_stype = LAST_STRUCT_TYPE
            if obj_stype.length > 0 {
                let method_name = obj_stype + "_" + name
                let method_ret = find_fn_ret(method_name)
                if method_ret != "i64" || find_fn_index(method_name) >= 0 {
                    let call_ret = method_ret
                    mut arg_str = ""
                    // First arg is the already-evaluated object
                    mut obj_ty = "%" + obj_stype
                    arg_str = obj_ty + " " + obj_val
                    mut mi = 1
                    while mi < e.children.length {
                        arg_str = arg_str + ", "
                        LAST_IS_STR = 0
                        LAST_IS_LIST = 0
                        LAST_IS_PTR = 0
                        LAST_STRUCT_TYPE = ""
                        LAST_ENUM_TYPE = ""
                        let a = gen_expr_child(e, mi)
                        mut aty = "i64"
                        if LAST_IS_STR == 1 { aty = "%ForgeString" }
                        if LAST_IS_PTR == 1 { aty = "ptr" }
                        if LAST_IS_LIST == 1 { aty = "{ ptr, i64 }" }
                        if LAST_STRUCT_TYPE != "" { aty = "%" + LAST_STRUCT_TYPE }
                        if LAST_ENUM_TYPE != "" { aty = "%" + LAST_ENUM_TYPE }
                        let arg_rt2 = reg_get_type(a)
                        if aty == "i64" && arg_rt2.length > 0 && arg_rt2 != "i64" && arg_rt2 != "i1" { aty = arg_rt2 }
                        arg_str = arg_str + aty + " " + a
                        mi = mi + 1
                    }
                    if call_ret == "void" {
                        ir_line("call void @" + method_name + "(" + arg_str + ")")
                        return "0"
                    }
                    let r = new_reg()
                    ir_line(r + " = call " + call_ret + " @" + method_name + "(" + arg_str + ")")
                    reg_set_type(r, call_ret)
                    set_type_from_llvm(call_ret)
                    return r
                }
            }
        }
        if is_ident_expr(first) {
            let var_idx = find_var(first.str_val)
            if var_idx >= 0 {
                let var_stype = VAR_STRUCT_TYPE[var_idx]
                if var_stype.length > 0 {
                    // Try StructName_method
                    let method_name = var_stype + "_" + name
                    let method_ret = find_fn_ret(method_name)
                    if method_ret != "i64" || find_fn_index(method_name) >= 0 {
                        // Found a method — call it with self ptr
                        let call_ret = method_ret
                        // If var is self (ptr type), load the ptr; otherwise pass alloca
                        mut self_arg = VAR_REGS[var_idx]
                        if VAR_TYPES[var_idx] == "ptr" {
                            let sp = new_reg()
                            ir_line(sp + " = load ptr, ptr " + VAR_REGS[var_idx])
                            self_arg = sp
                        }
                        mut arg_str = "ptr " + self_arg
                        mut mi = 1
                        while mi < e.children.length {
                            arg_str = arg_str + ", "
                            LAST_IS_STR = 0
                            LAST_IS_LIST = 0
                            LAST_IS_PTR = 0
                            LAST_IS_FLOAT = 0
                            LAST_STRUCT_TYPE = ""
                            LAST_ENUM_TYPE = ""
                            let a = gen_expr_child(e, mi)
                            mut aty = "i64"
                            if LAST_IS_STR == 1 { aty = "%ForgeString" }
                            if LAST_IS_PTR == 1 { aty = "ptr" }
                            if LAST_IS_FLOAT == 1 { aty = "double" }
                            if LAST_IS_LIST == 1 { aty = "{ ptr, i64 }" }
                            if LAST_STRUCT_TYPE != "" { aty = "%" + LAST_STRUCT_TYPE }
                            if LAST_ENUM_TYPE != "" { aty = "%" + LAST_ENUM_TYPE }
                            // Register type table fallback
                            if aty == "i64" {
                                let arg_rt = reg_get_type(a)
                                if arg_rt.length > 0 && arg_rt != "i64" && arg_rt != "i1" && arg_rt != "i8" {
                                    aty = arg_rt
                                }
                            }
                            if a.length > 1 {
                                if a.substring(0, 1) == "@" { aty = "ptr" }
                            }
                            arg_str = arg_str + aty + " " + a
                            mi = mi + 1
                        }
                        if call_ret == "void" {
                            ir_line("call void @" + method_name + "(" + arg_str + ")")
                            LAST_IS_STR = 0
                            LAST_IS_LIST = 0
                            LAST_IS_PTR = 0
                            LAST_STRUCT_TYPE = ""
                            LAST_ENUM_TYPE = ""
                            return "0"
                        }
                        let r = new_reg()
                        ir_line(r + " = call " + call_ret + " @" + method_name + "(" + arg_str + ")")
                        reg_set_type(r, call_ret)
                        LAST_IS_STR = 0
                        LAST_IS_LIST = 0
                        LAST_IS_PTR = 0
                        LAST_STRUCT_TYPE = ""
                        LAST_ENUM_TYPE = ""
                        set_type_from_llvm(call_ret)
                        return r
                    }
                }
            }
        }
    }

    // Hardcoded namespace methods: fs.read, fs.write, process.run, process.args, process.exit
    if e.children.length >= 1 {
        let first: Expr = e.children[0]
        if is_ident_expr(first) {
            if first.str_val == "fs" {
                if name == "read" {
                    let path = gen_expr_child(e, 1)
                    let r = new_reg()
                    ir_line(r + " = call %ForgeString @forge_read_file(%ForgeString " + path + ")")
                    LAST_IS_STR = 1
                    return r
                }
                if name == "write" {
                    let path = gen_expr_child(e, 1)
                    let content = gen_expr_child(e, 2)
                    ir_line("call void @forge_mini_write_file(%ForgeString " + path + ", %ForgeString " + content + ")")
                    LAST_IS_STR = 0
                    return "0"
                }
            }
            if first.str_val == "process" {
                if name == "args" {
                    // Return list of strings
                    let argc = new_reg()
                    ir_line(argc + " = call i64 @forge_mini_argc()")
                    // Build list by iterating
                    let alloca = new_reg()
                    ir_line(alloca + " = alloca { ptr, i64 }")
                    // Start with empty list
                    let esize = new_reg()
                    ir_line(esize + " = ptrtoint ptr getelementptr (%ForgeString, ptr null, i32 1) to i64")
                    let total = new_reg()
                    ir_line(total + " = mul i64 " + esize + ", " + argc)
                    let data = new_reg()
                    ir_line(data + " = call ptr @forge_alloc(i64 " + total + ")")
                    // Fill
                    let idx = new_reg()
                    ir_line(idx + " = alloca i64")
                    ir_line("store i64 0, ptr " + idx)
                    let cond_l = new_label("args_cond")
                    let body_l = new_label("args_body")
                    let end_l = new_label("args_end")
                    ir_line("br label %" + cond_l)
                    ir_raw(cond_l + ":")
                    let iv = new_reg()
                    ir_line(iv + " = load i64, ptr " + idx)
                    let cmp = new_reg()
                    ir_line(cmp + " = icmp slt i64 " + iv + ", " + argc)
                    ir_line("br i1 " + cmp + ", label %" + body_l + ", label %" + end_l)
                    ir_raw(body_l + ":")
                    let arg = new_reg()
                    ir_line(arg + " = call %ForgeString @forge_mini_argv(i64 " + iv + ")")
                    let ep = new_reg()
                    ir_line(ep + " = getelementptr %ForgeString, ptr " + data + ", i64 " + iv)
                    ir_line("store %ForgeString " + arg + ", ptr " + ep)
                    let next = new_reg()
                    ir_line(next + " = add i64 " + iv + ", 1")
                    ir_line("store i64 " + next + ", ptr " + idx)
                    ir_line("br label %" + cond_l)
                    ir_raw(end_l + ":")
                    let ls1 = new_reg()
                    ir_line(ls1 + " = insertvalue { ptr, i64 } zeroinitializer, ptr " + data + ", 0")
                    let ls2 = new_reg()
                    ir_line(ls2 + " = insertvalue { ptr, i64 } " + ls1 + ", i64 " + argc + ", 1")
                    LAST_IS_LIST = 1
                    LAST_IS_STR = 0
                    LAST_LIST_ELEM_TYPE = "%ForgeString"
                    return ls2
                }
                if name == "exit" {
                    let code = gen_expr_child(e, 1)
                    ir_line("call void @forge_exit(i64 " + code + ")")
                    LAST_IS_STR = 0
                    return "0"
                }
                if name == "run" {
                    let cmd = gen_expr_child(e, 1)
                    let args = gen_expr_child(e, 2)
                    let r = new_reg()
                    ir_line(r + " = call %ForgeString @forge_mini_run_list(%ForgeString " + cmd + ", { ptr, i64 } " + args + ")")
                    LAST_IS_STR = 1
                    LAST_IS_LIST = 0
                    LAST_STRUCT_TYPE = ""
                    LAST_ENUM_TYPE = ""
                    return r
                }
            }
        }
    }

    // Built-in: map_new() → ptr
    // Match/if expression — pop from pending list and compile inline
    if name == "__match_expr" && PENDING_MATCH_STMTS.length > 0 {
        let m: Stmt = PENDING_MATCH_STMTS[0]
        // Pop first element
        mut new_pending: List<Stmt> = []
        mut pmi = 1
        while pmi < PENDING_MATCH_STMTS.length {
            let ps: Stmt = PENDING_MATCH_STMTS[pmi]
            new_pending = new_pending.push(ps)
            pmi = pmi + 1
        }
        PENDING_MATCH_STMTS = new_pending
        codegen_match(m)
        return LAST_EXPR_VAL
    }
    if name == "__if_expr" && PENDING_MATCH_STMTS.length > 0 {
        let m: Stmt = PENDING_MATCH_STMTS[0]
        mut new_pending: List<Stmt> = []
        mut pmi = 1
        while pmi < PENDING_MATCH_STMTS.length {
            let ps: Stmt = PENDING_MATCH_STMTS[pmi]
            new_pending = new_pending.push(ps)
            pmi = pmi + 1
        }
        PENDING_MATCH_STMTS = new_pending
        IF_IS_EXPR = 1
        codegen_if(m)
        return LAST_EXPR_VAL
    }

    if name == "map_new" && e.children.length == 0 {
        let r = new_reg()
        ir_line(r + " = call ptr @forge_map_new()")
        LAST_IS_PTR = 1
        LAST_IS_STR = 0
        return r
    }
    // Built-in: forge_join_lines(list) → string
    if name == "forge_join_lines" && e.children.length == 1 {
        let arg = gen_expr_child(e, 0)
        let r = new_reg()
        ir_line(r + " = call %ForgeString @forge_join_lines({ ptr, i64 } " + arg + ")")
        LAST_IS_STR = 1
        LAST_IS_LIST = 0
        return r
    }
    // Built-in: forge_write_lines(path, list) → void
    if name == "forge_write_lines" && e.children.length == 2 {
        let path = gen_expr_child(e, 0)
        let lines = gen_expr_child(e, 1)
        ir_line("call void @forge_write_lines(%ForgeString " + path + ", { ptr, i64 } " + lines + ")")
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        return "0"
    }
    // Built-in: string(x)
    if name == "string" && e.children.length == 1 {
        let arg = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 { return arg }
        if LAST_IS_FLOAT == 1 {
            let r = new_reg()
            ir_line(r + " = call %ForgeString @forge_float_to_string(double " + arg + ")")
            LAST_IS_STR = 1
            LAST_IS_FLOAT = 0
            return r
        }
        let r = new_reg()
        ir_line(r + " = call %ForgeString @forge_int_to_string(i64 " + arg + ")")
        LAST_IS_STR = 1
        return r
    }
    // Built-in: int(x)
    if name == "int" && e.children.length == 1 {
        let arg = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            let r = new_reg()
            ir_line(r + " = call i64 @forge_string_to_int(%ForgeString " + arg + ")")
            LAST_IS_STR = 0
            return r
        }
        if LAST_IS_FLOAT == 1 {
            let r = new_reg()
            ir_line(r + " = fptosi double " + arg + " to i64")
            LAST_IS_FLOAT = 0
            return r
        }
        return arg
    }
    // Built-in: float(x)
    if name == "float" && e.children.length == 1 {
        let arg = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            // Parse string to float — use strtod via runtime
            let r = new_reg()
            ir_line(r + " = call double @forge_string_to_float(%ForgeString " + arg + ")")
            LAST_IS_STR = 0
            LAST_IS_FLOAT = 1
            return r
        }
        if LAST_IS_FLOAT == 1 { return arg }
        // int to float
        let r = new_reg()
        ir_line(r + " = sitofp i64 " + arg + " to double")
        LAST_IS_FLOAT = 1
        return r
    }
    // Built-in: println/eprintln
    if name == "println" || name == "eprintln" {
        let arg = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            if name == "println" {
                ir_line("call void @forge_println_string(%ForgeString " + arg + ")")
            } else {
                ir_line("call void @forge_eprintln_string(%ForgeString " + arg + ")")
            }
        } else if LAST_IS_FLOAT == 1 {
            ir_line("call void @forge_println_float(double " + arg + ")")
        } else {
            // Default: int
            if name == "println" {
                ir_line("call void @forge_println_int(i64 " + arg + ")")
            } else {
                // Convert int to string for eprintln
                let s = new_reg()
                ir_line(s + " = call %ForgeString @forge_int_to_string(i64 " + arg + ")")
                ir_line("call void @forge_eprintln_string(%ForgeString " + s + ")")
            }
        }
        LAST_IS_STR = 0
        LAST_IS_FLOAT = 0
        LAST_IS_LIST = 0
        LAST_STRUCT_TYPE = ""
        LAST_ENUM_TYPE = ""
        return "0"
    }
    // Map methods: set, get, has
    if name == "set" && e.children.length == 3 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_PTR == 1 {
            LAST_IS_PTR = 0
            let key = gen_expr_child(e, 1)
            LAST_IS_PTR = 0
            let val = gen_expr_child(e, 2)
            // Convert val to i64 if it's a ptr (fn pointer or closure)
            mut val_i64 = val
            mut is_ptr_val = false
            if LAST_IS_PTR == 1 { is_ptr_val = true }
            if val.length > 1 {
                if val.substring(0, 1) == "@" { is_ptr_val = true }
            }
            if is_ptr_val {
                val_i64 = new_reg()
                ir_line(val_i64 + " = ptrtoint ptr " + val + " to i64")
            }
            ir_line("call void @forge_map_set(ptr " + obj + ", %ForgeString " + key + ", i64 " + val_i64 + ")")
            LAST_IS_PTR = 1
            LAST_IS_STR = 0
            return obj
        }
    }
    if name == "get" && e.children.length == 2 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_PTR == 1 {
            let key = gen_expr_child(e, 1)
            let r = new_reg()
            ir_line(r + " = call i64 @forge_map_get(ptr " + obj + ", %ForgeString " + key + ")")
            LAST_IS_PTR = 0
            LAST_IS_STR = 0
            return r
        }
    }
    // List.pop() — return list with last element removed
    if name == "pop" && e.children.length == 1 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_LIST == 1 {
            // New list with length - 1
            let old_len = new_reg()
            ir_line(old_len + " = extractvalue { ptr, i64 } " + obj + ", 1")
            let new_len = new_reg()
            ir_line(new_len + " = sub i64 " + old_len + ", 1")
            let ls1 = new_reg()
            ir_line(ls1 + " = insertvalue { ptr, i64 } " + obj + ", i64 " + new_len + ", 1")
            LAST_IS_LIST = 1
            LAST_IS_STR = 0
            reg_set_type(ls1, "{ ptr, i64 }")
            return ls1
        }
    }
    if name == "has" && e.children.length == 2 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_PTR == 1 {
            let key = gen_expr_child(e, 1)
            // Ensure key is ForgeString — convert from i64 if needed
            mut key_str = key
            let key_ty = reg_get_type(key)
            if LAST_IS_STR == 0 && (key_ty == "i64" || key_ty == "") {
                let kp = new_reg()
                ir_line(kp + " = inttoptr i64 " + key + " to ptr")
                let ks = new_reg()
                ir_line(ks + " = insertvalue %ForgeString zeroinitializer, ptr " + kp + ", 0")
                let ks2 = new_reg()
                ir_line(ks2 + " = insertvalue %ForgeString " + ks + ", i64 0, 1")
                key_str = ks2
            }
            let r = new_reg()
            ir_line(r + " = call i8 @forge_map_has(ptr " + obj + ", %ForgeString " + key_str + ")")
            let r2 = new_reg()
            ir_line(r2 + " = zext i8 " + r + " to i64")
            LAST_IS_PTR = 0
            LAST_IS_STR = 0
            return r2
        }
    }
    // Method calls: children[0] is the object
    // List.push(elem) — obj.push(val) where obj is list
    if name == "push" && e.children.length == 2 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_LIST == 1 {
            let saved_elem = LAST_LIST_ELEM_TYPE
            let elem = gen_expr_child(e, 1)
            mut ety = "i64"
            if LAST_IS_STR == 1 { ety = "%ForgeString" }
            if LAST_IS_PTR == 1 { ety = "ptr" }
            if LAST_STRUCT_TYPE != "" { ety = "%" + LAST_STRUCT_TYPE }
            if LAST_ENUM_TYPE != "" { ety = "%" + LAST_ENUM_TYPE }
            // Also check register type for ptr values
            let rt = reg_get_type(elem)
            if rt == "ptr" { ety = "ptr" }
            return gen_list_push(obj, elem, ety, saved_elem)
        }
    }
    // String.byte_at(idx)
    if name == "byte_at" && e.children.length == 2 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            let idx = gen_expr_child(e, 1)
            let r = new_reg()
            ir_line(r + " = call i64 @forge_string_byte_at(%ForgeString " + obj + ", i64 " + idx + ")")
            LAST_IS_STR = 0
            LAST_IS_LIST = 0
            return r
        }
    }
    // String.contains(s)
    if name == "contains" && e.children.length == 2 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            let arg = gen_expr_child(e, 1)
            let r = new_reg()
            ir_line(r + " = call i8 @forge_string_contains(%ForgeString " + obj + ", %ForgeString " + arg + ")")
            let r2 = new_reg()
            ir_line(r2 + " = zext i8 " + r + " to i64")
            LAST_IS_STR = 0
            return r2
        }
    }
    // String.substring(start, end)
    if name == "substring" && e.children.length == 3 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            let start = gen_expr_child(e, 1)
            let end = gen_expr_child(e, 2)
            let r = new_reg()
            ir_line(r + " = call %ForgeString @forge_string_substring(%ForgeString " + obj + ", i64 " + start + ", i64 " + end + ")")
            LAST_IS_STR = 1
            return r
        }
    }
    // String.index_of(s)
    if name == "index_of" && e.children.length == 2 {
        let obj = gen_expr_child(e, 0)
        if LAST_IS_STR == 1 {
            let arg = gen_expr_child(e, 1)
            let r = new_reg()
            ir_line(r + " = call i64 @forge_string_index_of(%ForgeString " + obj + ", %ForgeString " + arg + ")")
            LAST_IS_STR = 0
            return r
        }
    }
    // Check if callee is a variable (function pointer / indirect call)
    let var_idx = find_var(name)
    if var_idx >= 0 {
        let vty = VAR_TYPES[var_idx]
        if vty == "ptr" {
            // Indirect call through function pointer
            let fn_ptr = new_reg()
            ir_line(fn_ptr + " = load ptr, ptr " + VAR_REGS[var_idx])
            mut arg_str = ""
            mut arg_types = ""
            mut i = 0
            while i < e.children.length {
                if i > 0 {
                    arg_str = arg_str + ", "
                    arg_types = arg_types + ", "
                }
                LAST_IS_STR = 0
                LAST_IS_LIST = 0
                LAST_STRUCT_TYPE = ""
                LAST_ENUM_TYPE = ""
                let a = gen_expr_child(e, i)
                mut aty = "i64"
                if LAST_IS_STR == 1 { aty = "%ForgeString" }
                if LAST_IS_LIST == 1 { aty = "{ ptr, i64 }" }
                if LAST_STRUCT_TYPE != "" { aty = "%" + LAST_STRUCT_TYPE }
                if LAST_ENUM_TYPE != "" { aty = "%" + LAST_ENUM_TYPE }
                arg_str = arg_str + aty + " " + a
                arg_types = arg_types + aty
                i = i + 1
            }
            // Use current fn return type for indirect call if non-primitive
            mut indirect_ret = "i64"
            if CUR_RET_TY != "i64" && CUR_RET_TY != "void" && CUR_RET_TY != "i32" {
                indirect_ret = CUR_RET_TY
            }
            let r = new_reg()
            ir_line(r + " = call " + indirect_ret + " " + fn_ptr + "(" + arg_str + ")")
            LAST_IS_STR = 0
            LAST_IS_LIST = 0
            LAST_STRUCT_TYPE = ""
            LAST_ENUM_TYPE = ""
            set_type_from_llvm(indirect_ret)
            return r
        }
    }

    // Regular function call (direct)
    // Check if this is a Type_method call where first param is self (ptr)
    // If so, pass the variable's ALLOCA pointer, not the loaded struct value
    mut is_method_call = false
    let uscore = name.index_of("_")
    if uscore > 0 {
        let maybe_type = name.substring(0, uscore)
        if find_struct(maybe_type) >= 0 { is_method_call = true }
    }
    let call_ret = find_fn_ret(name)
    mut arg_str = ""
    mut i = 0
    while i < e.children.length {
        if i > 0 { arg_str = arg_str + ", " }
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        LAST_IS_PTR = 0
        LAST_STRUCT_TYPE = ""
        LAST_ENUM_TYPE = ""
        let a = gen_expr_child(e, i)
        mut aty = "i64"
        if LAST_IS_STR == 1 { aty = "%ForgeString" }
        if LAST_IS_PTR == 1 { aty = "ptr" }
        if LAST_IS_LIST == 1 { aty = "{ ptr, i64 }" }
        if LAST_STRUCT_TYPE != "" { aty = "%" + LAST_STRUCT_TYPE }
        if LAST_ENUM_TYPE != "" { aty = "%" + LAST_ENUM_TYPE }
        // Method call: first arg is self — pass as ptr (alloca pointer)
        if is_method_call && i == 0 && LAST_STRUCT_TYPE != "" {
            // a is the loaded struct value, but we need the alloca pointer
            // Find the variable and use its alloca register directly
            let first_expr: Expr = e.children[0]
            if is_ident_expr(first_expr) {
                let vname = first_expr.str_val
                mut vi = VAR_NAMES.length - 1
                while vi >= 0 {
                    if VAR_NAMES[vi] == vname {
                        aty = "ptr"
                        arg_str = arg_str + "ptr " + VAR_REGS[vi]
                        i = i + 1
                        break
                    }
                    vi = vi - 1
                }
                if vi >= 0 { continue }
            }
        }
        // Function reference: @name is a ptr
        if a.length > 1 {
            if a.substring(0, 1) == "@" { aty = "ptr" }
        }
        // Type tracking for float
        if LAST_IS_FLOAT == 1 { aty = "double" }
        // Register type table fallback for arguments
        if aty == "i64" {
            let arg_rt = reg_get_type(a)
            if arg_rt.length > 0 && arg_rt != "i64" && arg_rt != "i1" && arg_rt != "i8" {
                aty = arg_rt
            }
        }
        // Extern FFI: coerce ForgeString → ptr for string params
        mut final_a = a
        if is_extern_fn(name) && aty == "%ForgeString" {
            let coerced = new_reg()
            ir_line(coerced + " = extractvalue %ForgeString " + a + ", 0")
            final_a = coerced
            aty = "ptr"
        }
        // Fix: i64 value passed to %ForgeString parameter — create ForgeString from i64
        // This handles map key lookups where the key lost its string type
        if aty == "i64" && i == 1 {
            if name == "forge_map_has" || name == "forge_map_get" || name == "forge_map_set" || name == "has" || name == "get" {
                // Reinterpret i64 as ForgeString (the i64 contains the ptr bits)
                let sptr = new_reg()
                ir_line(sptr + " = inttoptr i64 " + final_a + " to ptr")
                let fs = new_reg()
                ir_line(fs + " = insertvalue %ForgeString zeroinitializer, ptr " + sptr + ", 0")
                let fs2 = new_reg()
                ir_line(fs2 + " = insertvalue %ForgeString " + fs + ", i64 0, 1")
                final_a = fs2
                aty = "%ForgeString"
            }
        }
        arg_str = arg_str + aty + " " + final_a
        i = i + 1
    }
    if call_ret == "void" {
        ir_line("call void @" + name + "(" + arg_str + ")")
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        LAST_IS_PTR = 0
        LAST_IS_FLOAT = 0
        LAST_STRUCT_TYPE = ""
        LAST_ENUM_TYPE = ""
        return "0"
    }
    let r = new_reg()
    ir_line(r + " = call " + call_ret + " @" + name + "(" + arg_str + ")")
    reg_set_type(r, call_ret)
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    set_type_from_llvm(call_ret)
    r
}

fn gen_member(obj: string, field: string) -> string {
    // String methods
    if LAST_IS_STR == 1 {
        if field == "length" {
            let r = new_reg()
            ir_line(r + " = call i64 @forge_string_length(%ForgeString " + obj + ")")
            LAST_IS_STR = 0
            return r
        }
    }
    // List methods (also handles ForgeString-typed lists)
    if LAST_IS_LIST == 1 {
        if field == "length" {
            let r = new_reg()
            // Use correct struct type for extractvalue
            mut list_ty = "{ ptr, i64 }"
            ir_line(r + " = extractvalue " + list_ty + " " + obj + ", 1")
            LAST_IS_LIST = 0
            LAST_IS_STR = 0
            return r
        }
    }
    // Struct field access
    let sname = LAST_STRUCT_TYPE
    let si = find_struct(sname)
    let struct_val = obj
    if si >= 0 {
        let fi = struct_field_index(si, field)
        if fi >= 0 {
            let fty = struct_field_type(si, fi)
            let fty_raw = struct_field_type_raw(si, fi)
            let r = new_reg()
            ir_line(r + " = extractvalue %" + sname + " " + struct_val + ", " + string(fi))
            set_field_type(fty_raw)
            return r
        }
    }
    obj
}

// ─── Codegen handlers (registered in registry) ──────────────────

fn codegen_let(s: Stmt) -> int {
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_IS_PTR = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    let val = gen_expr_from(s, 0)
    let alloca = new_reg()
    let name = s.str_val
    mut ty = "i64"
    mut is_list = false
    mut list_elem = LAST_LIST_ELEM_TYPE
    mut stype = ""
    if LAST_IS_STR == 1 { ty = "%ForgeString" }
    if LAST_IS_PTR == 1 { ty = "ptr" }
    if LAST_IS_LIST == 1 {
        ty = "{ ptr, i64 }"
        is_list = true
    }
    // Only override with struct/enum type if NOT a list
    if !is_list && LAST_STRUCT_TYPE != "" {
        ty = "%" + LAST_STRUCT_TYPE
        stype = LAST_STRUCT_TYPE
    }
    if !is_list && LAST_ENUM_TYPE != "" { ty = "%" + LAST_ENUM_TYPE }
    // Register type table fallback
    if ty == "i64" {
        let rt = reg_get_type(val)
        if rt.length > 0 && rt != "i64" && rt != "i1" && rt != "i8" {
            ty = rt
            if rt == "ptr" { LAST_IS_PTR = 1 }
            if rt == "%ForgeString" { LAST_IS_STR = 1 }
            if rt == "{ ptr, i64 }" { is_list = true }
            if rt.length > 1 && rt.substring(0, 1) == "%" && rt != "%ForgeString" {
                stype = rt.substring(1, rt.length)
            }
        }
    }
    mut ann_base = s.str2
    mut ann_generic = ""
    let ann_lt = s.str2.index_of("<")
    if ann_lt >= 0 {
        ann_base = s.str2.substring(0, ann_lt)
        ann_generic = s.str2.substring(ann_lt + 1, s.str2.length - 1)
    }
    if ann_base == "string" { ty = "%ForgeString" }
    if ann_base == "int" || ann_base == "bool" { ty = "i64" }
    if ann_base == "List" {
        ty = "{ ptr, i64 }"
        is_list = true
        if ann_generic != "" {
            list_elem = type_to_llvm(ann_generic)
        }
    }
    if ann_base == "Map" { ty = "ptr" }
    if ann_base == "fn" { ty = "ptr" }
    if find_struct(ann_base) >= 0 {
        ty = "%" + ann_base
        stype = ann_base
    }
    if find_enum(ann_base) >= 0 { ty = "%" + ann_base }
    mut final_val = val
    if ann_base == "Map" {
        final_val = new_reg()
        ir_line(final_val + " = call ptr @forge_map_new()")
    }
    if ann_base == "fn" && ty == "ptr" && LAST_IS_PTR == 0 {
        let conv = new_reg()
        ir_line(conv + " = inttoptr i64 " + final_val + " to ptr")
        final_val = conv
    }
    // Final check: only override if register type is clearly more accurate
    let final_rt = reg_get_type(final_val)
    if final_rt == "ptr" && ty == "%ForgeString" {
        ty = "ptr"
        LAST_IS_PTR = 1
    }
    // Coerce value type to match alloca type
    let store_rt = reg_get_type(final_val)
    if store_rt == "ptr" && ty == "i64" {
        let conv = new_reg()
        ir_line(conv + " = ptrtoint ptr " + final_val + " to i64")
        final_val = conv
    }
    if store_rt == "i64" && ty == "ptr" {
        let conv = new_reg()
        ir_line(conv + " = inttoptr i64 " + final_val + " to ptr")
        final_val = conv
    }
    ir_line(alloca + " = alloca " + ty)
    ir_line("store " + ty + " " + final_val + ", ptr " + alloca)
    if is_list {
        push_var_list(name, alloca, "list_" + list_elem, list_elem)
    } else if stype != "" {
        push_var_with_struct(name, alloca, ty, stype)
    } else {
        push_var(name, alloca, ty)
    }
    0
}

fn codegen_return(s: Stmt) -> int {
    if CUR_RET_TY == "void" {
        ir_line("ret void")
    } else {
        let val = gen_expr_from(s, 0)
        let vt = val_type(val)
        if vt == "ptr" && CUR_RET_TY == "i64" {
            let conv = new_reg()
            ir_line(conv + " = ptrtoint ptr " + val + " to i64")
            ir_line("ret i64 " + conv)
        } else if vt == "i64" && CUR_RET_TY == "ptr" {
            let conv = new_reg()
            ir_line(conv + " = inttoptr i64 " + val + " to ptr")
            ir_line("ret ptr " + conv)
        } else if (vt == "ptr" || vt == "i64" || vt == "") && CUR_RET_TY.length > 1 && CUR_RET_TY.substring(0, 1) == "%" {
            // Type mismatch or null return — use zeroinitializer for null, CUR_RETVAL for type mismatch
            if CUR_RETVAL.length > 0 {
                let rv = new_reg()
                ir_line(rv + " = load " + CUR_RET_TY + ", ptr " + CUR_RETVAL)
                ir_line("ret " + CUR_RET_TY + " " + rv)
            } else {
                ir_line("ret " + CUR_RET_TY + " zeroinitializer")
            }
        } else {
            ir_line("ret " + CUR_RET_TY + " " + val)
        }
    }
    // Clear ALL state after return (prevents stale values/types leaking to merge blocks)
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_IS_PTR = 0
    LAST_EXPR_VAL = "0"
    1
}

fn codegen_expr_stmt(s: Stmt) -> int {
    let val = gen_expr_from(s, 0)
    LAST_EXPR_VAL = val
    0
}

mut LAST_STORE_TY: string = "i64"

fn if_store_val(if_val: string) {
    let st = val_type(LAST_EXPR_VAL)
    mut store_ty = st
    if store_ty.length == 0 { store_ty = "i64" }
    if store_ty == "i1" || store_ty == "i8" { store_ty = "i64" }
    // Fix literals for non-i64 types
    mut sv = LAST_EXPR_VAL
    if store_ty == "ptr" && sv == "0" { sv = "null" }
    if store_ty == "double" && sv == "0" { sv = "0.0" }
    if store_ty == "%ForgeString" && sv == "0" { sv = "zeroinitializer" }
    if store_ty.length > 1 && store_ty.substring(0, 1) == "%" && sv == "0" { sv = "zeroinitializer" }
    ir_line("store " + store_ty + " " + sv + ", ptr " + if_val)
    LAST_STORE_TY = store_ty
}

fn codegen_if(s: Stmt) -> int {
    let cond = gen_expr_from(s, 0)
    let cond_i1 = new_reg()
    ir_line(cond_i1 + " = trunc i64 " + cond + " to i1")
    let then_l = new_label("then")
    let else_l = new_label("else")
    let merge_l = new_label("merge")

    let is_expr = IF_IS_EXPR
    let use_retval = false
    IF_DEPTH = IF_DEPTH + 1

    // Alloca for if-result — use CUR_RETVAL (entry block) when available to avoid dominance issues
    mut if_val = ""
    if is_expr == 1 || use_retval {
        if CUR_RETVAL.length > 0 {
            if_val = CUR_RETVAL
        } else {
            if_val = new_reg()
            if CUR_RET_TY.length > 0 && CUR_RET_TY != "void" && CUR_RET_TY != "i32" {
                ir_line(if_val + " = alloca " + CUR_RET_TY)
            } else {
                ir_line(if_val + " = alloca [16 x i8]")
            }
        }
    }

    // Save LAST_EXPR_VAL for non-expression ifs without else
    // (prevents branch-local registers leaking to the merge)
    let saved_expr_val = LAST_EXPR_VAL

    ir_line("br i1 " + cond_i1 + ", label %" + then_l + ", label %" + else_l)

    // Then branch
    ir_raw(then_l + ":")
    let then_ended = gen_stmts(s.body)
    if then_ended == 1 {
        LAST_STRUCT_TYPE = ""
        LAST_ENUM_TYPE = ""
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        LAST_EXPR_VAL = "0"
    }
    let then_is_str = LAST_IS_STR
    let then_is_list = LAST_IS_LIST
    let then_struct = LAST_STRUCT_TYPE
    let then_enum = LAST_ENUM_TYPE
    if then_ended == 0 {
        if is_expr == 1 || use_retval {
            if_store_val(if_val)
        }
        ir_line("br label %" + merge_l)
    }

    // Else branch
    ir_raw(else_l + ":")
    let else_ended = gen_stmts(s.else_body)
    if else_ended == 1 {
        LAST_STRUCT_TYPE = ""
        LAST_ENUM_TYPE = ""
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        LAST_EXPR_VAL = "0"
    }
    if else_ended == 0 {
        if (is_expr == 1 || use_retval) && s.else_body.length > 0 {
            if_store_val(if_val)
        }
        ir_line("br label %" + merge_l)
    }

    // Merge
    ir_raw(merge_l + ":")
    if then_ended == 1 && else_ended == 1 {
        ir_line("unreachable")
        return 1
    }


    // When one branch terminated (ret/break), the merge only receives the other branch.
    if (is_expr == 1 || use_retval) && (then_ended == 0 || else_ended == 0) {
        // Use LAST_STORE_TY (set by if_store_val) — matches what was actually stored
        mut load_ty = LAST_STORE_TY
        if load_ty.length == 0 { load_ty = "i64" }
        mut result_struct = ""
        mut result_enum = ""
        if load_ty.length > 1 && load_ty.substring(0, 1) == "%" {
            let tname = load_ty.substring(1, load_ty.length)
            if find_struct(tname) >= 0 { result_struct = tname }
            if find_enum(tname) >= 0 { result_enum = tname }
        }
        let ifr = new_reg()
        ir_line(ifr + " = load " + load_ty + ", ptr " + if_val)
        LAST_EXPR_VAL = ifr
        LAST_IS_STR = 0
        LAST_IS_LIST = 0
        LAST_STRUCT_TYPE = result_struct
        LAST_ENUM_TYPE = result_enum
        if load_ty == "%ForgeString" { LAST_IS_STR = 1 }
        if load_ty == "{ ptr, i64 }" { LAST_IS_LIST = 1 }
    }
    IF_IS_EXPR = 0
    IF_DEPTH = IF_DEPTH - 1
    // For non-expression ifs without else, restore LAST_EXPR_VAL
    // to prevent branch-local registers leaking to the merge
    if is_expr == 0 && s.else_body.length == 0 {
        LAST_EXPR_VAL = saved_expr_val
    }
    // Return terminated if both branches terminated
    if then_ended == 1 && else_ended == 1 { return 1 }
    0
}

fn codegen_while(s: Stmt) -> int {
    let cond_l = new_label("while_cond")
    let body_l = new_label("while_body")
    let end_l = new_label("while_end")
    LOOP_COND = LOOP_COND.push(cond_l)
    LOOP_END = LOOP_END.push(end_l)
    ir_line("br label %" + cond_l)
    ir_raw(cond_l + ":")
    let cond = gen_expr_from(s, 0)
    let cond_i1 = new_reg()
    ir_line(cond_i1 + " = trunc i64 " + cond + " to i1")
    ir_line("br i1 " + cond_i1 + ", label %" + body_l + ", label %" + end_l)
    ir_raw(body_l + ":")
    let body_ended = gen_stmts(s.body)
    if body_ended == 0 { ir_line("br label %" + cond_l) }
    mut new_cond: List<string> = []
    mut new_end: List<string> = []
    mut li = 0
    while li < LOOP_COND.length - 1 {
        new_cond = new_cond.push(LOOP_COND[li])
        new_end = new_end.push(LOOP_END[li])
        li = li + 1
    }
    LOOP_COND = new_cond
    LOOP_END = new_end
    ir_raw(end_l + ":")
    0
}

fn codegen_for(s: Stmt) -> int {
    let var_name = s.str_val
    LAST_IS_LIST = 0
    LAST_IS_STR = 0
    let iterable = gen_expr_from(s, 0)
    let iter_is_str = LAST_IS_STR
    let iter_is_list = LAST_IS_LIST

    // Get length and set up element access
    mut elem_ty = LAST_LIST_ELEM_TYPE
    // If element type unknown, look up from variable's stored element type
    if elem_ty == "i64" || elem_ty == "" {
        let iter_expr: Expr = s.children[0]
        if iter_expr.kind is .Ident {
            let vi = find_var(iter_expr.str_val)
            if vi >= 0 && vi < VAR_LIST_ELEM_TYPE.length {
                let stored = VAR_LIST_ELEM_TYPE[vi]
                if stored != "" { elem_ty = stored }
            }
        }
    }
    let len_r = new_reg()
    let data_r = new_reg()

    if iter_is_str == 1 {
        // String iteration: use forge_string_length + forge_string_char_at
        ir_line(len_r + " = call i64 @forge_string_length(%ForgeString " + iterable + ")")
        ir_line(data_r + " = alloca %ForgeString")  // placeholder
        ir_line("store %ForgeString " + iterable + ", ptr " + data_r)
        elem_ty = "%ForgeString"  // each element is a single-char string
    } else {
        // List iteration: extractvalue
        let it_rt = reg_get_type(iterable)
        mut list_val = iterable
        if it_rt == "i64" || (it_rt == "" && iter_is_list == 0) {
            // Value is i64 (enum field) — create an empty list
            let empty_ls = new_reg()
            ir_line(empty_ls + " = insertvalue { ptr, i64 } zeroinitializer, i64 0, 1")
            list_val = empty_ls
        }
        if true {
            ir_line(len_r + " = extractvalue { ptr, i64 } " + list_val + ", 1")
            ir_line(data_r + " = extractvalue { ptr, i64 } " + list_val + ", 0")
        }
    }

    let idx_alloca = new_reg()
    ir_line(idx_alloca + " = alloca i64")
    ir_line("store i64 0, ptr " + idx_alloca)
    let elem_alloca = new_reg()
    ir_line(elem_alloca + " = alloca " + elem_ty)
    push_var(var_name, elem_alloca, elem_ty)
    let cond_l = new_label("for_cond")
    let body_l = new_label("for_body")
    let end_l = new_label("for_end")
    LOOP_COND = LOOP_COND.push(cond_l)
    LOOP_END = LOOP_END.push(end_l)
    ir_line("br label %" + cond_l)
    ir_raw(cond_l + ":")
    let idx_val = new_reg()
    ir_line(idx_val + " = load i64, ptr " + idx_alloca)
    let cmp = new_reg()
    ir_line(cmp + " = icmp slt i64 " + idx_val + ", " + len_r)
    ir_line("br i1 " + cmp + ", label %" + body_l + ", label %" + end_l)
    ir_raw(body_l + ":")
    if iter_is_str == 1 {
        // String iteration: char_at(str, idx)
        let str_val = new_reg()
        ir_line(str_val + " = load %ForgeString, ptr " + data_r)
        let ev = new_reg()
        ir_line(ev + " = call %ForgeString @forge_string_char_at(%ForgeString " + str_val + ", i64 " + idx_val + ")")
        ir_line("store %ForgeString " + ev + ", ptr " + elem_alloca)
    } else {
        // List iteration: GEP + load
        let ep = new_reg()
        ir_line(ep + " = getelementptr " + elem_ty + ", ptr " + data_r + ", i64 " + idx_val)
        let ev = new_reg()
        ir_line(ev + " = load " + elem_ty + ", ptr " + ep)
        ir_line("store " + elem_ty + " " + ev + ", ptr " + elem_alloca)
    }
    let body_ended = gen_stmts(s.body)
    let next_idx = new_reg()
    ir_line(next_idx + " = add i64 " + idx_val + ", 1")
    ir_line("store i64 " + next_idx + ", ptr " + idx_alloca)
    if body_ended == 0 { ir_line("br label %" + cond_l) }
    mut new_cond: List<string> = []
    mut new_end: List<string> = []
    mut li = 0
    while li < LOOP_COND.length - 1 {
        new_cond = new_cond.push(LOOP_COND[li])
        new_end = new_end.push(LOOP_END[li])
        li = li + 1
    }
    LOOP_COND = new_cond
    LOOP_END = new_end
    ir_raw(end_l + ":")
    0
}

fn codegen_break(s: Stmt) -> int {
    if LOOP_END.length > 0 {
        ir_line("br label %" + LOOP_END[LOOP_END.length - 1])
    }
    1
}

fn codegen_continue(s: Stmt) -> int {
    if LOOP_COND.length > 0 {
        ir_line("br label %" + LOOP_COND[LOOP_COND.length - 1])
    }
    1
}

fn codegen_assign(s: Stmt) -> int {
    let target: Expr = s.exprs[0]
    match target.kind {
        .Ident -> {
            let val = gen_expr_from(s, 1)
            let var_idx = find_var(target.str_val)
            if var_idx >= 0 {
                let store_ty = VAR_TYPES[var_idx]
                mut load_ty = get_load_type(store_ty)
                let rt = reg_get_type(val)
                // Handle type conversions
                mut final_val = val
                if rt == "ptr" && load_ty == "i64" {
                    let conv = new_reg()
                    ir_line(conv + " = ptrtoint ptr " + val + " to i64")
                    final_val = conv
                }
                // ptr value into struct-typed variable — store ptr (the var type might be wrong)
                if rt == "ptr" && load_ty.length > 1 && load_ty.substring(0, 1) == "%" {
                    // Var was declared as struct but nullable value is ptr — store as ptr
                    load_ty = "ptr"
                }
                if rt == "i64" && load_ty == "ptr" {
                    let conv = new_reg()
                    ir_line(conv + " = inttoptr i64 " + val + " to ptr")
                    final_val = conv
                }
                ir_line("store " + load_ty + " " + final_val + ", ptr " + VAR_REGS[var_idx])
            }
        }
        .Member -> {
            let obj_expr: Expr = target.children[0]
            let field = target.str_val
            if is_ident_expr(obj_expr) {
                let var_idx = find_var(obj_expr.str_val)
                if var_idx >= 0 {
                    let sty_name = VAR_STRUCT_TYPE[var_idx]
                    let si = find_struct(sty_name)
                    if si >= 0 {
                        let fi = struct_field_index(si, field)
                        let fty = struct_field_type(si, fi)
                        let val = gen_expr_from(s, 1)
                        // Type check: if value type doesn't match field type, use zeroinitializer
                        mut final_val = val
                        let val_rt = reg_get_type(val)
                        if val_rt.length > 0 && val_rt != fty {
                            if fty == "ptr" && val_rt != "ptr" { final_val = "null" }
                            if fty != "ptr" && val_rt == "ptr" { final_val = "zeroinitializer" }
                            if fty == "i64" && val_rt != "i64" { final_val = "0" }
                        }
                        if fty == "ptr" && final_val == "0" { final_val = "null" }
                        // For self (ptr type), load ptr first then load/store struct through it
                        mut assign_ptr = VAR_REGS[var_idx]
                        if VAR_TYPES[var_idx] == "ptr" {
                            assign_ptr = new_reg()
                            ir_line(assign_ptr + " = load ptr, ptr " + VAR_REGS[var_idx])
                        }
                        let cur = new_reg()
                        ir_line(cur + " = load %" + sty_name + ", ptr " + assign_ptr)
                        let updated = new_reg()
                        ir_line(updated + " = insertvalue %" + sty_name + " " + cur + ", " + fty + " " + final_val + ", " + string(fi))
                        ir_line("store %" + sty_name + " " + updated + ", ptr " + assign_ptr)
                    }
                }
            }
        }
        _ -> {}
    }
    0
}

fn codegen_match(s: Stmt) -> int {
    LAST_ENUM_TYPE = ""
    LAST_IS_STR = 0
    let scrutinee = gen_expr_from(s, 0)
    let scrut_enum = LAST_ENUM_TYPE
    let scrut_is_str = LAST_IS_STR
    let ei = find_enum(scrut_enum)
    let merge_l = new_label("match_end")
    // Use CUR_RETVAL (entry-block alloca) for match result — dominates all blocks
    mut match_result = CUR_RETVAL
    if match_result.length == 0 {
        // Fallback: create inline alloca (only for void functions)
        match_result = new_reg()
        if CUR_RET_TY.length > 0 && CUR_RET_TY != "void" && CUR_RET_TY != "i32" {
            ir_line(match_result + " = alloca " + CUR_RET_TY)
        } else {
            ir_line(match_result + " = alloca [16 x i8]")
        }
    }
    let tag_r = new_reg()
    if ei >= 0 {
        ir_line(tag_r + " = extractvalue %" + scrut_enum + " " + scrutinee + ", 0")
    }
    mut ai = 0
    while ai < s.body.length {
        let arm: Stmt = s.body[ai]
        let vname = arm.str_val
        if vname == "_" {
            LAST_IS_STR = 0
            LAST_STRUCT_TYPE = ""
            LAST_ENUM_TYPE = ""
            LAST_EXPR_VAL = "0"
            IN_MATCH_ARM = 1
            let ended = gen_stmts(arm.body)
            IN_MATCH_ARM = 0
            // If last stmt was if-without-else, the value may be from a branch — use 0
            if arm.body.length > 0 {
                let ls: Stmt = arm.body[arm.body.length - 1]
                if ls.kind is .If && ls.else_body.length == 0 { LAST_EXPR_VAL = "0" }
            }
            if ended == 0 {
                if CUR_RET_TY != "void" { if_store_val(match_result) }
                ir_line("br label %" + merge_l)
            }
        } else if ei < 0 {
            // Value match (string/int pattern)
            let arm_l = new_label("match_arm")
            let next_l = new_label("match_next")
            let cmp = new_reg()
            if scrut_is_str == 1 {
                // String comparison
                let pat_str = new_str_const(vname)
                let pat_val = new_reg()
                ir_line(pat_val + " = call %ForgeString @forge_string_new(ptr " + pat_str + ", i64 " + string(vname.length) + ")")
                let eq = new_reg()
                ir_line(eq + " = call i8 @forge_string_eq(%ForgeString " + scrutinee + ", %ForgeString " + pat_val + ")")
                ir_line(cmp + " = trunc i8 " + eq + " to i1")
            } else {
                // Int comparison
                ir_line(cmp + " = icmp eq i64 " + scrutinee + ", " + vname)
            }
            ir_line("br i1 " + cmp + ", label %" + arm_l + ", label %" + next_l)
            ir_raw(arm_l + ":")
            LAST_EXPR_VAL = "0"
            LAST_IS_STR = 0
            LAST_STRUCT_TYPE = ""
            LAST_ENUM_TYPE = ""
            IN_MATCH_ARM = 1
            let ended = gen_stmts(arm.body)
            IN_MATCH_ARM = 0
            if arm.body.length > 0 {
                let ls2: Stmt = arm.body[arm.body.length - 1]
                if ls2.kind is .If && ls2.else_body.length == 0 { LAST_EXPR_VAL = "0" }
            }
            if ended == 0 {
                if CUR_RET_TY != "void" { if_store_val(match_result) }
                ir_line("br label %" + merge_l)
            }
            ir_raw(next_l + ":")
        } else if ei >= 0 {
            let vidx = enum_variant_index(ei, vname)
            let arm_l = new_label("match_arm")
            let next_l = new_label("match_next")
            let cmp = new_reg()
            ir_line(cmp + " = icmp eq i64 " + tag_r + ", " + string(vidx))
            ir_line("br i1 " + cmp + ", label %" + arm_l + ", label %" + next_l)
            ir_raw(arm_l + ":")
            if arm.str2.length > 0 {
                // GEP-based variant field extraction (matches enum construction layout)
                // 1. Store scrutinee to alloca
                // 2. GEP to payload (field 1)
                // 3. Cast to variant struct type
                // 4. GEP to each field and load
                // GEP-based payload extraction (more correct than extractvalue for padding)
                // 1. Store scrutinee to alloca
                // 2. GEP to payload ptr (field 1 of { i8, ptr })
                // 3. Load the payload ptr
                let scrut_alloca = new_reg()
                ir_line(scrut_alloca + " = alloca %" + scrut_enum)
                ir_line("store %" + scrut_enum + " " + scrutinee + ", ptr " + scrut_alloca)
                let payload_gep = new_reg()
                ir_line(payload_gep + " = getelementptr inbounds %" + scrut_enum + ", ptr " + scrut_alloca + ", i32 0, i32 1")
                let payload_ptr = new_reg()
                ir_line(payload_ptr + " = load ptr, ptr " + payload_gep)

                // Null guard: skip extraction if payload is null
                let null_chk = new_reg()
                ir_line(null_chk + " = icmp eq ptr " + payload_ptr + ", null")
                let safe_l = new_label("payload_ok")
                let skip_l = new_label("payload_null")
                ir_line("br i1 " + null_chk + ", label %" + skip_l + ", label %" + safe_l)
                ir_raw(skip_l + ":")
                ir_line("br label %" + merge_l)
                ir_raw(safe_l + ":")

                // Build variant struct type string
                let gvi_arm = ENUM_VARIANT_STARTS[ei] + vidx
                let fs_arm = EVAR_FIELD_STARTS[gvi_arm]
                let fc_arm = EVAR_FIELD_COUNTS[gvi_arm]
                mut variant_fields = ""
                mut vfi = 0
                while vfi < fc_arm {
                    if vfi > 0 { variant_fields = variant_fields + ", " }
                    variant_fields = variant_fields + EFIELD_TYPES[fs_arm + vfi]
                    vfi = vfi + 1
                }
                let variant_ty = "{ " + variant_fields + " }"

                // Extract bindings via GEP on variant struct
                mut bi = 0
                mut bstart = 0
                mut bpos = 0
                while bpos <= arm.str2.length {
                    mut is_comma = false
                    if bpos < arm.str2.length {
                        if arm.str2.substring(bpos, bpos + 1) == "," {
                            is_comma = true
                        }
                    }
                    if is_comma || bpos == arm.str2.length {
                        let bname = arm.str2.substring(bstart, bpos)
                        if bname != "_" && bi < fc_arm {
                            let bind_ty = EFIELD_TYPES[fs_arm + bi]
                            let fld_ptr = new_reg()
                            ir_line(fld_ptr + " = getelementptr inbounds " + variant_ty + ", ptr " + payload_ptr + ", i32 0, i32 " + string(bi))
                            let fld_val = new_reg()
                            let load_ty = type_to_llvm_field(bind_ty)
                            ir_line(fld_val + " = load " + load_ty + ", ptr " + fld_ptr)
                            let balloca = new_reg()
                            ir_line(balloca + " = alloca " + load_ty)
                            ir_line("store " + load_ty + " " + fld_val + ", ptr " + balloca)
                            if bind_ty == "%ForgeString" {
                                push_var(bname, balloca, "%ForgeString")
                            } else if bind_ty == "{ ptr, i64 }" || is_list_type(bind_ty) {
                                if is_list_type(bind_ty) {
                                    let ety = bind_ty.substring(5, bind_ty.length)
                                    push_var_list(bname, balloca, bind_ty, ety)
                                } else {
                                    push_var_list(bname, balloca, "list_i64", "i64")
                                }
                            } else if bind_ty.length > 1 && bind_ty.substring(0, 1) == "%" {
                                let sname = bind_ty.substring(1, bind_ty.length)
                                push_var_with_struct(bname, balloca, bind_ty, sname)
                            } else {
                                push_var(bname, balloca, bind_ty)
                            }
                        }
                        bi = bi + 1
                        bstart = bpos + 1
                    }
                    bpos = bpos + 1
                }
            }
            LAST_EXPR_VAL = "0"
            LAST_IS_STR = 0
            LAST_STRUCT_TYPE = ""
            LAST_ENUM_TYPE = ""
            IN_MATCH_ARM = 1
            let ended = gen_stmts(arm.body)
            IN_MATCH_ARM = 0
            if arm.body.length > 0 {
                let ls3: Stmt = arm.body[arm.body.length - 1]
                if ls3.kind is .If && ls3.else_body.length == 0 { LAST_EXPR_VAL = "0" }
            }
            if ended == 0 {
                if CUR_RET_TY != "void" { if_store_val(match_result) }
                ir_line("br label %" + merge_l)
            }
            ir_raw(next_l + ":")
        }
        ai = ai + 1
    }
    ir_line("br label %" + merge_l)
    ir_raw(merge_l + ":")
    mut load_ty = LAST_STORE_TY
    if load_ty.length == 0 { load_ty = "i64" }
    let mr = new_reg()
    ir_line(mr + " = load " + load_ty + ", ptr " + match_result)
    LAST_EXPR_VAL = mr
    set_type_from_llvm(load_ty)
    0
}

// Register all codegen handlers
fn register_codegen_handlers() {
    register_codegen("Let", "let")
    register_codegen("Return", "return")
    register_codegen("ExprStmt", "expr")
    register_codegen("If", "if")
    register_codegen("While", "while")
    register_codegen("For", "for")
    register_codegen("Break", "break")
    register_codegen("Continue", "continue")
    register_codegen("Assign", "assign")
    register_codegen("Match", "match")
}

// ─── Main statement codegen (registry-driven) ────────────────────

fn stmt_kind_name(s: Stmt) -> string {
    match s.kind {
        .Let -> { return "Let" }
        .Return -> { return "Return" }
        .ExprStmt -> { return "ExprStmt" }
        .If -> { return "If" }
        .While -> { return "While" }
        .For -> { return "For" }
        .Break -> { return "Break" }
        .Continue -> { return "Continue" }
        .Assign -> { return "Assign" }
        .Match -> { return "Match" }
        _ -> { return "" }
    }
    ""
}

fn gen_stmt(s: Stmt) -> bool {
    let kind = stmt_kind_name(s)
    if kind.length > 0 && has_codegen_handler(kind) {
        let result = call_codegen_handler(kind, s)
        if result == 1 { return true }
        return false
    }
    false
}
fn gen_stmts(stmts: List<Stmt>) -> int {
    gen_block(stmts)
}

fn gen_block(stmts: List<Stmt>) -> int {
    let saved_fn_body = IN_FN_BODY
    let saved_match_arm = IN_MATCH_ARM
    IN_FN_BODY = 0
    IN_MATCH_ARM = 0
    mut terminated = 0
    mut i = 0
    while i < stmts.length {
        if terminated == 1 { break }
        let s: Stmt = stmts[i]
        // Last stmt: if-else as implicit return (function body or match arm)
        if i == stmts.length - 1 && s.kind is .If && s.else_body.length > 0 {
            if saved_fn_body == 1 && CUR_RET_TY != "void" && CUR_RET_TY != "i32" {
                IF_IS_EXPR = 1
            }
            if saved_match_arm == 1 {
                IF_IS_EXPR = 1
            }
        }
        if gen_stmt(s) {
            terminated = 1
        }
        i = i + 1
    }
    terminated
}

// ═══════════════════════════════════════════════════════════════════
// AST CODEGEN — top-level: fn decls, compile
// ═══════════════════════════════════════════════════════════════════

mut EMITTED_FNS: List<string> = []

fn gen_fn_decl(f: FnDecl) {
    let name = f.name
    // Dedup: skip if already emitted
    mut already_emitted = false
    mut efi = 0
    while efi < EMITTED_FNS.length {
        if EMITTED_FNS[efi] == name { already_emitted = true }
        efi = efi + 1
    }
    if already_emitted { return }
    EMITTED_FNS = EMITTED_FNS.push(name)

    // Resolve param types to LLVM
    mut param_types: List<string> = []
    mut param_generics: List<string> = []
    mut self_struct_type = ""  // original struct type name for self param
    mut i = 0
    while i < f.params.length {
        let p: Param = f.params[i]
        // Parse "List<int>" format
        let lt_idx = p.type_name.index_of("<")
        mut base_type = p.type_name
        mut generic = ""
        if lt_idx >= 0 {
            base_type = p.type_name.substring(0, lt_idx)
            generic = p.type_name.substring(lt_idx + 1, p.type_name.length - 1)
        }
        mut pty = type_to_llvm(base_type)
        // Self parameter: pass as ptr for mutability
        if p.name == "self" {
            if pty.length > 1 && pty.substring(0, 1) == "%" {
                self_struct_type = pty.substring(1, pty.length)
            }
            // self is always passed as ptr, but track the underlying struct type
            // from the original type_name (set by impl handler or from struct type)
            if pty == "ptr" {
                // Look up struct from mangled name: TypeName_method → TypeName
                let uscore = name.index_of("_")
                if uscore > 0 {
                    let impl_type_name = name.substring(0, uscore)
                    if find_struct(impl_type_name) >= 0 || find_enum(impl_type_name) >= 0 {
                        self_struct_type = impl_type_name
                    }
                }
            }
            pty = "ptr"
        }
        param_types = param_types.push(pty)
        param_generics = param_generics.push(generic)
        i = i + 1
    }
    let param_count = f.params.length

    // Resolve return type (strip generic: "List<int>" → "List")
    mut ret_ty = "void"
    if f.return_type != "void" {
        let ret_lt = f.return_type.index_of("<")
        if ret_lt >= 0 {
            ret_ty = type_to_llvm(f.return_type.substring(0, ret_lt))
        } else {
            ret_ty = type_to_llvm(f.return_type)
        }
    }

    CUR_RET_TY = ret_ty

    // Register fn signature (already done in pass 1, but update for safety)

    // Build param list string
    mut param_str = ""
    i = 0
    while i < param_count {
        let p: Param = f.params[i]
        if i > 0 { param_str = param_str + ", " }
        param_str = param_str + param_types[i] + " %" + p.name + ".arg"
        i = i + 1
    }

    // Emit function header
    if name == "main" {
        ret_ty = "i32"
        CUR_RET_TY = "i32"
        ir_raw("define i32 @main(i32 %argc, ptr %argv) {")
        ir_raw("entry:")
        ir_line("call void @forge_mini_set_args(i32 %argc, ptr %argv)")
    } else {
        ir_raw("define " + ret_ty + " @" + name + "(" + param_str + ") {")
        ir_raw("entry:")
    }
    // Reset registers, type tracking, and scope (keep globals)
    REG_N = 0
    LAST_EXPR_VAL = "0"
    LAST_IS_STR = 0
    LAST_IS_LIST = 0
    LAST_STRUCT_TYPE = ""
    LAST_ENUM_TYPE = ""
    LAST_LIST_ELEM_TYPE = "i64"
    IF_DEPTH = 0
    REG_TY_NAMES = []
    REG_TY_VALS = []
    let gc = GLOBAL_NAMES.length
    mut gn: List<string> = []
    mut gr: List<string> = []
    mut gt: List<string> = []
    mut gs: List<string> = []
    mut gle: List<string> = []
    mut gi2 = 0
    while gi2 < gc {
        if gi2 < VAR_NAMES.length { gn = gn.push(VAR_NAMES[gi2]) }
        if gi2 < VAR_REGS.length { gr = gr.push(VAR_REGS[gi2]) }
        if gi2 < VAR_TYPES.length { gt = gt.push(VAR_TYPES[gi2]) }
        if gi2 < VAR_STRUCT_TYPE.length { gs = gs.push(VAR_STRUCT_TYPE[gi2]) }
        if gi2 < VAR_LIST_ELEM_TYPE.length { gle = gle.push(VAR_LIST_ELEM_TYPE[gi2]) }
        gi2 = gi2 + 1
    }
    VAR_NAMES = gn
    VAR_REGS = gr
    VAR_TYPES = gt
    VAR_STRUCT_TYPE = gs
    VAR_LIST_ELEM_TYPE = gle

    // For non-void functions, create a return value alloca in the entry block
    // This dominates ALL blocks, avoiding SSA issues with if-else return values
    CUR_RETVAL = ""
    if ret_ty != "void" && ret_ty != "i32" {
        CUR_RETVAL = new_reg()
        // Alloca sized for the return type (use ret_ty directly, not fixed 16 bytes)
        ir_line(CUR_RETVAL + " = alloca " + ret_ty)
    }

    // Create param allocas
    i = 0
    while i < param_count {
        let p: Param = f.params[i]
        let alloca = new_reg()
        let pty = param_types[i]
        let pgen = param_generics[i]
        ir_line(alloca + " = alloca " + pty)
        ir_line("store " + pty + " %" + p.name + ".arg, ptr " + alloca)
        if p.name == "self" && pty == "ptr" && self_struct_type.length > 0 {
            // Self ptr: store alloca with struct type info for field access
            push_var_with_struct(p.name, alloca, "ptr", self_struct_type)
        } else if pty == "{ ptr, i64 }" && pgen != "" {
            let elem_ty = type_to_llvm(pgen)
            push_var_list(p.name, alloca, "list_" + elem_ty, elem_ty)
        } else if pty.length > 1 && pty.substring(0, 1) == "%" {
            let sname = pty.substring(1, pty.length)
            push_var_with_struct(p.name, alloca, pty, sname)
        } else {
            push_var(p.name, alloca, pty)
        }
        i = i + 1
    }

    // Generate body
    IN_FN_BODY = 1
    let terminated = gen_stmts(f.body)
    IN_FN_BODY = 0

    // Implicit return
    if terminated == 0 {
        if name == "main" {
            ir_line("ret i32 0")
        } else if ret_ty == "void" {
            ir_line("ret void")
        } else if ret_ty == "double" {
            if LAST_IS_FLOAT == 1 {
                ir_line("ret double " + LAST_EXPR_VAL)
            } else {
                let conv = new_reg()
                ir_line(conv + " = sitofp i64 " + LAST_EXPR_VAL + " to double")
                ir_line("ret double " + conv)
            }
        } else {
            // Check register type matches return type; convert if needed
            let val_ty = reg_get_type(LAST_EXPR_VAL)
            if val_ty == "ptr" && ret_ty == "i64" {
                let conv = new_reg()
                ir_line(conv + " = ptrtoint ptr " + LAST_EXPR_VAL + " to i64")
                ir_line("ret i64 " + conv)
            } else if val_ty == "i64" && ret_ty == "ptr" {
                let conv = new_reg()
                ir_line(conv + " = inttoptr i64 " + LAST_EXPR_VAL + " to ptr")
                ir_line("ret ptr " + conv)
            } else if val_ty.length > 0 && val_ty != ret_ty && val_ty != "i64" && LAST_EXPR_VAL != "0" {
                ir_line("ret " + val_ty + " " + LAST_EXPR_VAL)
            } else if (val_ty == "i64" || val_ty == "" || val_ty == "ptr") && ret_ty.length > 1 && ret_ty.substring(0, 1) == "%" {
                // Type mismatch — load from CUR_RETVAL with correct return type
                if CUR_RETVAL.length > 0 {
                    let rv = new_reg()
                    ir_line(rv + " = load " + ret_ty + ", ptr " + CUR_RETVAL)
                    ir_line("ret " + ret_ty + " " + rv)
                } else {
                    ir_line("ret " + ret_ty + " zeroinitializer")
                }
            } else {
                ir_line("ret " + ret_ty + " " + LAST_EXPR_VAL)
            }
        }
    }

    ir_raw("}")
    ir_raw("")
    // Emit any closure functions generated during this function
    mut ci = 0
    while ci < CLOSURE_IR.length {
        IR = IR.push(CLOSURE_IR[ci])
        ci = ci + 1
    }
    CLOSURE_IR = []
}

// Known type names (pre-scanned for forward references)
mut KNOWN_TYPE_NAMES: List<string> = []

// Pass 0: pre-scan type/enum names so self-referential types resolve
fn scan_type_name_decl() {
    KNOWN_TYPE_NAMES = KNOWN_TYPE_NAMES.push(advance().text)
    // Skip = and check for fn type alias vs struct body
    if check("=") {
        advance()
        skip_nl()
        if check("fn") {
            // Type alias: type Foo = fn(...) -> Bar — skip to newline
            skip_to_newline()
            return
        }
    }
    // Struct/enum body: skip to { then skip block
    while !check("{") && !check_kind(4) && POS < TOKENS.length { advance() }
    if check("{") { skip_block() }
}

fn scan_type_names() {
    let saved_pos = POS
    POS = 0
    skip_nl()
    while POS < TOKENS.length && peek().kind != 0 {
        let tok: Tok = peek()
        if tok.text == "export" {
            advance()
            skip_nl()
            if check("type") {
                advance()
                scan_type_name_decl()
            } else if check("enum") {
                advance()
                scan_type_name_decl()
            } else {
                skip_to_newline()
            }
        } else if tok.text == "type" {
            advance()
            scan_type_name_decl()
        } else if tok.text == "enum" {
            advance()
            scan_type_name_decl()
        } else {
            advance()
        }
        skip_nl()
    }
    POS = saved_pos
}

fn is_known_type(name: string) -> bool {
    mut i = 0
    while i < KNOWN_TYPE_NAMES.length {
        if KNOWN_TYPE_NAMES[i] == name { return true }
        i = i + 1
    }
    false
}

fn compile(source: string) -> string {
    eprintln("  tokenizing " + string(source.length) + " chars...")
    TOKENS = tokenize(source)
    eprintln("  " + string(TOKENS.length) + " tokens")
    POS = 0
    IR = []
    STR_DECLS = []
    STR_N = 0
    CLOSURE_COUNT = 0
    CLOSURE_IR = []
    PENDING_MATCH_STMTS = []
    // Initialize registry and register handlers
    init_registry()
    register_parse_handlers()
    register_codegen_handlers()
    STRUCT_NAMES = []
    STRUCT_FIELD_STARTS = []
    STRUCT_FIELD_COUNTS = []
    SFIELD_NAMES = []
    SFIELD_TYPES = []
    ENUM_NAMES = []
    ENUM_VARIANT_STARTS = []
    ENUM_VARIANT_COUNTS = []
    EVAR_NAMES = []
    EVAR_FIELD_STARTS = []
    EVAR_FIELD_COUNTS = []
    EFIELD_NAMES = []
    EFIELD_TYPES = []
    GLOBAL_NAMES = []
    GLOBAL_TYPES = []
    KNOWN_TYPE_NAMES = []

    // Register runtime string functions with correct return types
    FN_NAMES = FN_NAMES.push("forge_string_index_of")
    FN_RETTYPES = FN_RETTYPES.push("i64")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(2)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string,string")
    FN_NAMES = FN_NAMES.push("forge_string_substring")
