    FN_NAMES = FN_NAMES.push("forge_csv_substr")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(2)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("int,int")
    FN_NAMES = FN_NAMES.push("forge_scan_csv_path")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("int")
    FN_NAMES = FN_NAMES.push("forge_scan_csv")
    FN_RETTYPES = FN_RETTYPES.push("i64")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")
    FN_NAMES = FN_NAMES.push("forge_mod_csv_get")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(0)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("")
    FN_NAMES = FN_NAMES.push("forge_fn_store_get_body")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("int")
    FN_NAMES = FN_NAMES.push("forge_fn_reg_get_ret")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")
    FN_NAMES = FN_NAMES.push("forge_param_type_get")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("int")
    FN_NAMES = FN_NAMES.push("forge_param_name_get")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("int")
    FN_NAMES = FN_NAMES.push("forge_param_name_add")
    FN_RETTYPES = FN_RETTYPES.push("void")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")
    FN_NAMES = FN_NAMES.push("forge_set_self_type")
    FN_RETTYPES = FN_RETTYPES.push("void")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")
    // Alloca cache returns ptr (not i64!) — critical for correct Value* handling
    FN_NAMES = FN_NAMES.push("forge_alloca_cache_get")
    FN_RETTYPES = FN_RETTYPES.push("ptr")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")
    FN_NAMES = FN_NAMES.push("forge_idx_cache_get")
    FN_RETTYPES = FN_RETTYPES.push("ptr")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("int")
    FN_NAMES = FN_NAMES.push("forge_get_self_type")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(0)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("")
    FN_NAMES = FN_NAMES.push("forge_sh_indexof")
    FN_RETTYPES = FN_RETTYPES.push("i64")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(2)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string,string")
    FN_NAMES = FN_NAMES.push("forge_sh_substr")
    FN_RETTYPES = FN_RETTYPES.push("%ForgeString")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(3)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string,int,int")
    FN_NAMES = FN_NAMES.push("forge_sh_length")
    FN_RETTYPES = FN_RETTYPES.push("i64")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")

    // Pass 0: pre-scan type/enum names + load packages
    eprintln("  pass 0: scanning type names...")
    scan_type_names()
    reset_packages()
    load_packages(source)

    eprintln("  pass 1: scanning declarations...")
    // Pass 1: scan for type declarations, enum decls, fn sigs, globals
    skip_nl()
    while POS < TOKENS.length && peek().kind != 0 {
        let tok: Tok = peek()
        if tok.text == "export" {
            advance()
            skip_nl()
            if !check("type") && !check("enum") && !check("fn") && !check("mut") && !check("let") {
                // Unknown export — skip (covers trait, impl, etc.)
                advance()
                // If there's a block, skip it
                while !check("{") && !check_kind(4) && POS < TOKENS.length { advance() }
                if check("{") { skip_block() }
            } else if false {
                advance()
                while !check("{") && POS < TOKENS.length { advance() }
                skip_block()
            } else if check("type") {
                parse_type_decl_top()
            } else if check("enum") {
                parse_enum_decl_top()
            } else if check("fn") {
                scan_fn_sig()
            } else if check("mut") || check("let") {
                parse_global_decl()
            } else {
                skip_to_newline()
            }
        } else if tok.text == "type" {
            parse_type_decl_top()
        } else if tok.text == "fn" {
            scan_fn_sig()
        } else if tok.text == "enum" {
            parse_enum_decl_top()
        } else if tok.text == "mut" || tok.text == "let" {
            parse_global_decl()
        } else if tok.text == "trait" {
            advance()
            while !check("{") && POS < TOKENS.length { advance() }
            skip_block()
        } else if tok.text == "impl" {
            // Scan impl methods for fn signatures
            advance()
            skip_nl()
            mut impl_name = advance().text
            skip_nl()
            if check("for") {
                advance()
                skip_nl()
                impl_name = advance().text
            }
            skip_nl()
            while !check("{") && POS < TOKENS.length { advance() }
            advance() // consume {
            skip_nl()
            while not_at_brace() {
                skip_nl()
                if check("fn") {
                    // scan_fn_sig but with mangled name
                    advance() // fn
                    let method_name = advance().text
                    let mangled = impl_name + "_" + method_name
                    while !check("{") && !check("->") && POS < TOKENS.length { advance() }
                    mut ret_ty = "void"
                    if check("->") {
                        advance()
                        skip_nl()
                        let rt = advance().text
                        if rt == "int" { ret_ty = "i64" }
                        if rt == "bool" { ret_ty = "i64" }
                        if rt == "string" { ret_ty = "%ForgeString" }
                        if rt == "ptr" { ret_ty = "ptr" }
                        if find_struct(rt) >= 0 { ret_ty = "%" + rt }
                        if find_enum(rt) >= 0 { ret_ty = "%" + rt }
                        if ret_ty == "void" && is_known_type(rt) { ret_ty = "%" + rt }
                        if rt == "List" { ret_ty = "{ ptr, i64 }" }
                        if check("<") {
                            while !check(">") && POS < TOKENS.length { advance() }
                            if check(">") { advance() }
                        }
                        if check("?") { advance() }
                    }
                    while !check("{") && POS < TOKENS.length { advance() }
                    skip_block()
                    FN_NAMES = FN_NAMES.push(mangled)
                    FN_RETTYPES = FN_RETTYPES.push(ret_ty)
                    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(0)
                    FN_PARAM_TYPES = FN_PARAM_TYPES.push("")
                } else {
                    advance()
                }
                skip_nl()
            }
            if check("}") { advance() }
        } else {
            // Unknown top-level statement (function calls, use, etc.) — skip to newline
            skip_to_newline()
        }
        skip_nl()
    }

    eprintln("  pass 2: emitting IR header + parsing AST...")
    // Pass 2: reset and parse into AST
    POS = 0

    // IR header
    ir_raw("target datalayout = \"e-m:o-i64:64-i128:128-n32:64-S128\"")
    ir_raw("")
    ir_raw("%ForgeString = type { ptr, i64 }")
    // Emit struct type declarations
    mut sti = 0
    while sti < STRUCT_NAMES.length {
        let sname = STRUCT_NAMES[sti]
        let nf = struct_field_count(sti)
        mut fields_ir = ""
        mut fi = 0
        while fi < nf {
            if fi > 0 { fields_ir = fields_ir + ", " }
            fields_ir = fields_ir + struct_field_type(sti, fi)
            fi = fi + 1
        }
        ir_raw("%" + sname + " = type { " + fields_ir + " }")
        sti = sti + 1
    }
    // Emit enum type declarations
    mut ei = 0
    while ei < ENUM_NAMES.length {
        let ename = ENUM_NAMES[ei]
        ir_raw("%" + ename + " = type " + enum_llvm_type_str(ei))
        ei = ei + 1
    }
    // Emit global variable declarations
    mut gi = 0
    while gi < GLOBAL_NAMES.length {
        let gname = GLOBAL_NAMES[gi]
        let gty = GLOBAL_TYPES[gi]
        mut emit_ty = gty
        if is_list_type(gty) {
            emit_ty = "{ ptr, i64 }"
        }
        ir_raw("@" + gname + " = global " + emit_ty + " zeroinitializer")
        push_var(gname, "@" + gname, gty)
        gi = gi + 1
    }
    ir_raw("")
    ir_raw("declare %ForgeString @forge_string_new(ptr, i64)")
    ir_raw("declare %ForgeString @forge_string_concat(%ForgeString, %ForgeString)")
    ir_raw("declare i64 @forge_string_length(%ForgeString)")
    ir_raw("declare %ForgeString @forge_int_to_string(i64)")
    ir_raw("declare %ForgeString @forge_float_to_string(double)")
    ir_raw("declare void @forge_print_string(%ForgeString)")
    ir_raw("declare void @forge_println_string(%ForgeString)")
    ir_raw("declare void @forge_println_int(i64)")
    ir_raw("declare void @forge_println_float(double)")
    ir_raw("declare void @forge_eprintln_string(%ForgeString)")
    ir_raw("declare %ForgeString @forge_string_char_at(%ForgeString, i64)")
    ir_raw("declare %ForgeString @forge_string_substring(%ForgeString, i64, i64)")
    ir_raw("declare i64 @forge_string_index_of(%ForgeString, %ForgeString)")
    ir_raw("declare i64 @forge_string_compare(%ForgeString, %ForgeString)")
    ir_raw("declare i8 @forge_string_eq(%ForgeString, %ForgeString)")
    ir_raw("declare ptr @forge_alloc(i64)")
    ir_raw("declare i64 @span(i64)")
    ir_raw("declare i32 @puts(ptr)")
    ir_raw("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    ir_raw("declare void @forge_mini_set_args(i32, ptr)")
    ir_raw("declare i64 @forge_mini_argc()")
    ir_raw("declare %ForgeString @forge_mini_argv(i64)")
    ir_raw("declare %ForgeString @forge_mini_run(%ForgeString, { ptr, i64 })")
    ir_raw("declare %ForgeString @forge_mini_run_list(%ForgeString, { ptr, i64 })")
    ir_raw("declare void @forge_exit(i64)")
    ir_raw("declare i64 @forge_try_begin()")
    ir_raw("declare void @forge_try_end()")
    ir_raw("declare void @forge_alloc_stats()")
    ir_raw("declare void @forge_watchdog(i64, ptr)")
    ir_raw("declare void @forge_watchdog_reset()")
    ir_raw("declare i64 @forge_alloca_cache_clear()")
    ir_raw("declare void @forge_alloca_cache_set_fn(ptr)")
    ir_raw("declare i64 @forge_alloca_cache_set(%ForgeString, ptr)")
    ir_raw("declare ptr @forge_alloca_cache_get(%ForgeString)")
    ir_raw("declare i64 @forge_str_var_add(%ForgeString)")
    ir_raw("declare i64 @forge_str_var_check(%ForgeString)")
    ir_raw("declare i64 @forge_str_var_clear()")
    ir_raw("declare i64 @forge_idx_cache_clear()")
    ir_raw("declare i64 @forge_idx_cache_set(i64, ptr)")
    ir_raw("declare ptr @forge_idx_cache_get(i64)")
    ir_raw("declare i64 @forge_var_counter_get()")
    ir_raw("declare i64 @forge_var_counter_inc()")
    ir_raw("declare i64 @forge_var_counter_reset(i64)")
    ir_raw("declare %ForgeString @forge_read_file(%ForgeString)")
    ir_raw("declare i8 @forge_write_file(%ForgeString, %ForgeString)")
    ir_raw("declare i8 @forge_string_contains(%ForgeString, %ForgeString)")
    ir_raw("declare i64 @forge_string_byte_at(%ForgeString, i64)")
    ir_raw("declare i64 @forge_string_to_int(%ForgeString)")
    ir_raw("declare double @forge_string_to_float(%ForgeString)")
    ir_raw("declare ptr @forge_map_new()")
    ir_raw("declare void @forge_map_set(ptr, %ForgeString, i64)")
    ir_raw("declare i64 @forge_map_get(ptr, %ForgeString)")
    // Token accumulator (O(1) amortized push)
    ir_raw("declare void @forge_tok_clear()")
    ir_raw("declare void @forge_tok_push(i64, %ForgeString, i64)")
    ir_raw("declare i64 @forge_tok_count()")
    ir_raw("declare { ptr, i64 } @forge_tok_to_list()")
    ir_raw("declare i8 @forge_map_has(ptr, %ForgeString)")
    // C-side function body store (immune to Forge list corruption)
    // Module CSV accumulator
    ir_raw("declare i64 @forge_scan_csv(%ForgeString)")
    ir_raw("declare void @forge_scan_csv_set_cb(ptr)")
    ir_raw("declare %ForgeString @forge_scan_csv_path(i64)")
    ir_raw("declare void @forge_save_csv(%ForgeString)")
    ir_raw("declare i64 @forge_csv_byte_at(i64)")
    ir_raw("declare i64 @forge_csv_length()")
    ir_raw("declare %ForgeString @forge_csv_substr(i64, i64)")
    ir_raw("declare %ForgeString @forge_csv_next()")
    ir_raw("declare void @forge_csv_scan_reset()")
    ir_raw("declare i64 @forge_csv_scan_idx()")
    ir_raw("declare i64 @forge_csv_has_next()")
    ir_raw("declare void @forge_mod_csv_clear()")
    ir_raw("declare void @forge_mod_csv_add(%ForgeString)")
    ir_raw("declare %ForgeString @forge_mod_csv_get()")
    // Param type registry
    ir_raw("declare void @forge_param_type_clear()")
    ir_raw("declare void @forge_param_type_add(%ForgeString)")
    ir_raw("declare %ForgeString @forge_param_type_get(i64)")
    // Param name registry
    ir_raw("declare void @forge_param_name_clear()")
    ir_raw("declare void @forge_param_name_add(%ForgeString)")
    ir_raw("declare %ForgeString @forge_param_name_get(i64)")
    // Self type tracking for method desugaring
    ir_raw("declare void @forge_set_self_type(%ForgeString)")
    ir_raw("declare %ForgeString @forge_get_self_type()")
    // Debug
    ir_raw("declare void @forge_debug_enum({ i64, ptr })")
    ir_raw("declare void @forge_debug_str(%ForgeString)")
    // C-side struct var type tracking
    ir_raw("declare void @forge_struct_var_clear()")
    ir_raw("declare void @forge_struct_var_add(%ForgeString, %ForgeString)")
    ir_raw("declare %ForgeString @forge_struct_var_get(%ForgeString)")
    // C-side variable name tracking
    ir_raw("declare void @forge_var_name_clear()")
    ir_raw("declare void @forge_var_name_push(%ForgeString)")
    ir_raw("declare i64 @forge_var_name_exists(%ForgeString)")
    ir_raw("declare void @forge_var_name_set_scope(i64)")
    // Function name/return-type registry
    ir_raw("declare void @forge_fn_reg_clear()")
    ir_raw("declare void @forge_fn_reg_add(%ForgeString, %ForgeString)")
    ir_raw("declare %ForgeString @forge_fn_reg_get_ret(%ForgeString)")
    ir_raw("declare i64 @forge_fn_reg_count()")
    ir_raw("declare void @forge_fn_store_clear()")
    ir_raw("declare void @forge_fn_store_add(%ForgeString, %ForgeString)")
    ir_raw("declare %ForgeString @forge_fn_store_get_body(i64)")
    ir_raw("declare i64 @forge_fn_store_count()")
    // C-side string helpers for Stage 2 bootstrap
    ir_raw("declare i64 @forge_sh_indexof(%ForgeString, %ForgeString)")
    ir_raw("declare %ForgeString @forge_sh_substr(%ForgeString, i64, i64)")
    ir_raw("declare i64 @forge_sh_length(%ForgeString)")
    ir_raw("declare void @forge_mini_write_file(%ForgeString, %ForgeString)")
    ir_raw("declare void @forge_mini_write_debug(%ForgeString, %ForgeString)")
    ir_raw("declare i8 @forge_fs_write_string(ptr, i64, ptr, i64)")
    ir_raw("declare void @forge_write_lines(%ForgeString, { ptr, i64 })")
    ir_raw("declare %ForgeString @forge_join_lines({ ptr, i64 })")
    ir_raw("declare void @forge_write_lines_append(%ForgeString, { ptr, i64 })")
    ir_raw("declare void @forge_ir_open(%ForgeString)")
    ir_raw("declare void @forge_ir_line(%ForgeString)")
    ir_raw("declare void @forge_ir_close()")
    ir_raw("declare { ptr, i64 } @forge_list_push({ ptr, i64 }, ptr, i64)")
    ir_raw("declare { ptr, i64 } @forge_list_push_str({ ptr, i64 }, %ForgeString)")
    ir_raw("")
    // Emit package extern function declarations
    emit_package_externs()
    ir_raw("")

    // Register wrapper fn signatures so gen_call knows return types
    mut pwi = 0
    while pwi < PKG_EXPORT_FNS.length {
        let wf: FnDecl = PKG_EXPORT_FNS[pwi]
        let wns = PKG_EXPORT_NS[pwi]
        let wmangled = wns + "_" + wf.name
        mut wret = "void"
        if wf.return_type != "void" {
            let wlt = wf.return_type.index_of("<")
            if wlt >= 0 {
                wret = type_to_llvm(wf.return_type.substring(0, wlt))
            } else {
                wret = type_to_llvm(wf.return_type)
            }
        }
        FN_NAMES = FN_NAMES.push(wmangled)
        FN_RETTYPES = FN_RETTYPES.push(wret)
        FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(wf.params.length)
        FN_PARAM_TYPES = FN_PARAM_TYPES.push("")
        pwi = pwi + 1
    }

    // Parse all functions into AST
    eprintln("  parsing functions...")
    let fns: List<FnDecl> = ast_parse_program()
    eprintln("  " + string(fns.length) + " functions parsed, generating IR...")

    // Compile package export wrapper functions with mangled names
    // Skip process/fs — those are handled as builtins in gen_call
    mut pci = 0
    while pci < PKG_EXPORT_FNS.length {
        let wf: FnDecl = PKG_EXPORT_FNS[pci]
        let wns = PKG_EXPORT_NS[pci]
        if wns != "process" && wns != "fs" {
            let mangled_f = FnDecl {
                name: wns + "_" + wf.name,
                params: wf.params,
                return_type: wf.return_type,
                body: wf.body,
                exported: false,
            }
            gen_fn_decl(mangled_f)
        }
        pci = pci + 1
    }

    // Generate IR for user functions
    mut fi = 0
    while fi < fns.length {
        let f: FnDecl = fns[fi]
        if fi % 50 == 0 { eprintln("  codegen: " + string(fi) + "/" + string(fns.length) + " " + f.name) }
        gen_fn_decl(f)
        fi = fi + 1
    }

    // Emit auto-declared namespace functions (discovered during codegen)
    mut adi = 0
    while adi < AUTO_DECLARED.length {
        let ad_name = AUTO_DECLARED[adi]
        // Emit variadic declare — use i64 return, varargs
        // These are LLVM API wrappers that take ptr/i64 args
        ir_raw("declare i64 @" + ad_name + "(...)")
        adi = adi + 1
    }

    "done"
}
