    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(3)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string,int,int")
    FN_NAMES = FN_NAMES.push("forge_string_length")
    FN_RETTYPES = FN_RETTYPES.push("i64")
    FN_PARAMCOUNTS = FN_PARAMCOUNTS.push(1)
    FN_PARAM_TYPES = FN_PARAM_TYPES.push("string")
    FN_NAMES = FN_NAMES.push("forge_string_compare")
    FN_RETTYPES = FN_RETTYPES.push("i64")
