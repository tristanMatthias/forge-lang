// ─── Error Propagation Feature ────────────────
// Handles: Result<T,E> types, Ok/Err constructors, ? operator, catch blocks.
// Minimal implementation — registers types and construction helpers.

use core.token.Span
use core.ast.{Expr, Block, NodeRef, feature_expr, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use checker.TypeChecker
use codegen.Codegen

// ─── Side Tables ────────────────────────────────

mut RESULT_EXPRS: Map<string, ResultExprData> = {}
mut CATCH_BLOCKS: Map<string, CatchData> = {}

// ─── Data Types ─────────────────────────────────

enum ResultExprKind {
    Ok
    Err
    Propagate  // ? operator
}

type ResultExprData = {
    kind: ResultExprKind,
    inner: Expr,
    span: Span,
}

type CatchData = {
    try_expr: Expr,
    error_name: string,
    catch_body: Block,
    span: Span,
}

fn get_result_expr(id: int) -> ResultExprData? {
    let key = "${id}"
    if RESULT_EXPRS.has(key) { RESULT_EXPRS[key] } else { null }
}

fn get_catch(id: int) -> CatchData? {
    let key = "${id}"
    if CATCH_BLOCKS.has(key) { CATCH_BLOCKS[key] } else { null }
}

// ─── Construction Helpers ───────────────────────

fn make_ok(inner: Expr, span: Span) -> Expr {
    let id = next_node_id()
    RESULT_EXPRS["${id}"] = ResultExprData { kind: .Ok, inner, span }
    feature_expr("error_propagation", "result_expr", id, span)
}

fn make_err(inner: Expr, span: Span) -> Expr {
    let id = next_node_id()
    RESULT_EXPRS["${id}"] = ResultExprData { kind: .Err, inner, span }
    feature_expr("error_propagation", "result_expr", id, span)
}

fn make_propagate(inner: Expr, span: Span) -> Expr {
    let id = next_node_id()
    RESULT_EXPRS["${id}"] = ResultExprData { kind: .Propagate, inner, span }
    feature_expr("error_propagation", "propagate", id, span)
}

fn make_catch(try_expr: Expr, error_name: string, catch_body: Block, span: Span) -> Expr {
    let id = next_node_id()
    CATCH_BLOCKS["${id}"] = CatchData { try_expr, error_name, catch_body, span }
    feature_expr("error_propagation", "catch", id, span)
}

// ─── Check ──────────────────────────────────────

fn check_error_prop(tc: TypeChecker, node: NodeRef) -> Type {
    if node.kind_name == "result_expr" {
        let d = get_result_expr(node.node_id)
        if d == null { return Type.Unknown }
        let data = d!
        let inner_type = tc.infer_expr(data.inner)
        if data.kind is .Ok { return Type.Result(inner_type, Type.String) }
        if data.kind is .Err { return Type.Result(Type.Unknown, inner_type) }
        return inner_type
    }
    if node.kind_name == "propagate" {
        let d = get_result_expr(node.node_id)
        if d == null { return Type.Unknown }
        let data = d!
        let inner_type = tc.infer_expr(data.inner)
        // ? on Result<T,E> yields T (simplified for bootstrap)
        if inner_type is .Result { return Type.Unknown }
        return inner_type
    }
    if node.kind_name == "catch" {
        let d = get_catch(node.node_id)
        if d == null { return Type.Unknown }
        let data = d!
        let try_type = tc.infer_expr(data.try_expr)

        // Bind error name in catch scope
        tc.env.push_scope()
        if data.error_name != "" {
            tc.env.define(data.error_name, Type.String, false)
        }
        let catch_type = tc.check_block(data.catch_body)
        tc.env.pop_scope()

        // Result unwraps to ok type, catch provides fallback (simplified for bootstrap)
        if try_type is .Result { return Type.Unknown }
        return try_type
    }
    return Type.Unknown
}

// ─── Emit ───────────────────────────────────────

fn emit_error_prop(cg: Codegen, node: NodeRef) -> ptr {
    // TODO: emit Result tagged union + propagation branching
    llvm.const_int(CG_I64, 0, 0)
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "error_propagation", ... })
reg_check_expr("error_propagation", check_error_prop)
reg_emit_expr("error_propagation", emit_error_prop)
