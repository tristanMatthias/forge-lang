// ─── Impl Methods Feature ──────────────────────
// Handles: impl blocks with methods on types.
// impl TypeName { fn method(self, ...) -> ... { ... } }
// Methods are compiled as free functions with self as first param.
// In the inline-emit-during-parse model, each method's body is
// stored as source text and re-parsed during codegen (same as regular functions).

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr}
use parser.{LAST_PARAM_TYPE_NAME, PARSED_PARAM_TYPES}
use checker.TypeChecker
use codegen.Codegen
use features.while_loops.PARSE_END_POS
use features.functions.{store_fn_source, store_fn_param_count, store_fn_param_name, store_fn_param_type, store_fn_return_type}
use features.variables.{IN_FUNCTION_BODY}

// ─── Side Table ─────────────────────────────────

mut IMPL_BLOCKS: Map<string, ImplBlockData> = {}

// ─── Data Types ─────────────────────────────────

type ImplMethod = {
    name: string,
    params: List<Param>,
    return_type: TypeExpr?,
    body: Block,
    span: Span,
}

type ImplBlockData = {
    trait_name: string?,
    type_name: string,
    type_params: List<string>,
    methods: List<ImplMethod>,
    span: Span,
}

fn get_impl_block(id: int) -> ImplBlockData? {
    let key = "${id}"
    if IMPL_BLOCKS.has(key) { IMPL_BLOCKS[key] } else { null }
}

// ─── Parse: Impl Block (inline-emit-during-parse) ──
// Called from parser dispatch when .Impl token is seen.
// Each method is stored as a function in the function registry
// with name "TypeName__methodName" for later codegen.

export fn parse_impl_block(p: Parser) -> Statement? {
    let start = p.advance().span // consume 'impl'

    let first_name = p.expect_ident()
    if first_name == "" {
        p.error("expected type name after 'impl'")
        return null
    }

    // Check for "impl Trait for Type"
    mut type_name = first_name
    if p.check_id(28) {  // For
        p.advance()
        let tn = p.expect_ident()
        if tn == "" {
            p.error("expected type name after 'for'")
            return null
        }
        type_name = tn
    }

    // Skip type params if present
    if p.check_id(78) {  // Lt
        p.parse_type_params()
    }

    if p.expect_id(102) == null { return null }  // LBrace
    p.skip_newlines()

    // Parse each method and store as a function
    while !p.check_id(103) && !p.is_at_end() {  // RBrace
        p.skip_newlines()
        if p.check_id(23) {  // Fn
            // Parse method as a function, storing with mangled name
            parse_impl_method_as_fn(p, type_name)
            // Sync position (parse_impl_method_as_fn receives p by value)
            if PARSE_END_POS >= 0 {
                p.pos = PARSE_END_POS
                PARSE_END_POS = -1
            }
        } else if !p.check_id(103) {  // RBrace
            p.advance() // skip unexpected tokens
        }
        p.skip_newlines()
    }

    p.expect_id(103)  // RBrace

    PARSE_END_POS = p.pos
    let id = next_node_id()
    feature_stmt("impl_methods", "impl_block", id, start)
}

// Parse a single impl method and register it as a free function
fn parse_impl_method_as_fn(p: Parser, type_name: string) {
    let start = p.advance().span // consume 'fn'

    let method_name = p.expect_ident()
    if method_name == "" { return }

    // Create mangled function name: TypeName__methodName
    // (Can't use . in LLVM function names, so use __)
    // BUT: for method dispatch, we also need "TypeName.methodName" in the lookup
    let fn_name = "${type_name}__${method_name}"

    PARSED_PARAM_TYPES = []
    let params: List<Param> = p.parse_params()

    mut return_type_name = ""
    if p.check_id(86) {  // Arrow
        p.advance()
        let ret_tok = p.peek()
        if ret_tok.kind_id == 1 {
            return_type_name = ret_tok.text
        }
        p.parse_type_expr()
    }

    // Capture body source text (same as regular functions)
    let block_open_span = p.peek().span
    IN_FUNCTION_BODY = 1
    let body = p.parse_block()
    IN_FUNCTION_BODY = 0
    // Get close position directly (avoid if-assignment bug)
    let close_tok_idx = p.pos - 1
    let block_close_end = p.tokens[close_tok_idx].span.end
    mut body_src = ""
    if p.source.length > 0 {
        body_src = p.source.substring(block_open_span.start, block_close_end + 1)
    }

    // Store function data for codegen (using the mangled name)
    // Filter out 'self' param: replace it with the type name as param type
    store_fn_source(fn_name, body_src)

    // Count non-self params and store param info
    mut param_count = 0
    mut pi = 0
    // For impl methods, first param is always "self" with type = type_name
    // Use C-side registry directly (immune to mini codegen type bugs)
    if params.length > 0 {
        forge_param_name_add("self")
        forge_param_type_add(type_name)
        FN_ALL_PARAM_NAMES = FN_ALL_PARAM_NAMES.push("self")
        FN_ALL_PARAM_TYPES = FN_ALL_PARAM_TYPES.push(type_name)
        param_count = 1
    }
    // Remaining params (non-self)
    pi = 1
    while pi < params.length {
        forge_param_name_add("p")  // placeholder name for non-self params
        if pi < PARSED_PARAM_TYPES.length {
            forge_param_type_add(PARSED_PARAM_TYPES[pi])
            FN_ALL_PARAM_TYPES = FN_ALL_PARAM_TYPES.push(PARSED_PARAM_TYPES[pi])
        } else {
            forge_param_type_add("int")
            FN_ALL_PARAM_TYPES = FN_ALL_PARAM_TYPES.push("int")
        }
        FN_ALL_PARAM_NAMES = FN_ALL_PARAM_NAMES.push("p")
        param_count = param_count + 1
        pi = pi + 1
    }
    store_fn_param_count(param_count)
    store_fn_return_type(return_type_name)

    // Set PARSE_END_POS so the caller can sync (Parser passed by value)
    PARSE_END_POS = p.pos
}

// ─── Original Parse (for registry-based dispatch) ───

fn parse_impl(p: Parser) -> Statement? {
    parse_impl_block(p)
}

fn parse_impl_method(p: Parser) -> ImplMethod? {
    let start = p.advance().span // consume 'fn'

    let name = p.expect_ident()
    if name == null {
        p.error("expected method name")
        return null
    }

    let params: List<Param> = p.parse_params()
    if params == null { return null }

    mut return_type: TypeExpr? = null
    if p.check_id(86) {  // Arrow
        p.advance()
        return_type = p.parse_type_expr()
    }

    let body = p.parse_block()
    if body == null {
        p.error("expected method body")
        return null
    }

    ImplMethod { name: name!, params: params!, return_type, body: body!, span: start }
}

// ─── Check ──────────────────────────────────────

fn check_impl(tc: TypeChecker, node: NodeRef) {
    // In inline-emit-during-parse model, methods are already registered
    // as functions. No additional checking needed here.
}

fn top_level_impl(tc: TypeChecker, node: NodeRef) {
    check_impl(tc, node)
}

// ─── Emit ───────────────────────────────────────

fn emit_impl(cg: Codegen, node: NodeRef) {
    // In inline-emit-during-parse model, methods are emitted
    // as regular functions during emit_all_fn_bodies.
    // No-op here.
}

// ─── Registration ───────────────────────────────

reg_parser("impl", parse_impl)
reg_check_stmt("impl_methods", check_impl)
reg_emit_stmt("impl_methods", emit_impl)
reg_top_level("impl_methods", top_level_impl)
