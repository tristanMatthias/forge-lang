// ─── Variables Feature ─────────────────────────
// Handles: let, mut, const bindings.
// Side table stores VarDeclData keyed by node_id.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr}
use checker.TypeChecker
use codegen.{Codegen}
use features.while_loops.PARSE_END_POS
use @std.llvm

// ─── Side Table ──────────────────────────────────

mut VAR_DECLS: Map<string, VarDeclData> = {}

// ─── Data Types ──────────────────────────────────

enum VarKind { Let, Mut, Const }

type VarDeclData = {
    var_kind: VarKind,
    name: string,
    type_ann: TypeExpr?,
    value: Expr,
    exported: bool,
    span: Span,
}

fn get_var_decl(node_id: int) -> VarDeclData? {
    let key = "${node_id}"
    if VAR_DECLS.has(key) { VAR_DECLS[key] } else { null }
}

// ─── Parse ──────────────────────────────────────

// Track whether we're inside a function body (to detect top-level globals)
export mut IN_FUNCTION_BODY: int = 0

// Global variable tracking uses C-side (forge_global_var_register)

fn parse_var_binding(p: Parser, kind: VarKind, exported: bool) -> Statement? {
    let start = p.advance().span // consume let/mut/const

    let var_name = p.expect_ident()
    if var_name == "" {
        p.error("expected variable name")
        return null
    }

    // Optional type annotation: : Type
    // Capture type annotation info for global type detection
    mut ann_is_list = 0
    mut ann_elem_name = ""
    mut type_ann: TypeExpr? = null
    if p.check(TokenKind.Colon) {
        p.advance()
        // Peek: if next is "List", capture element type name
        let type_tok = p.peek()
        if type_tok.kind_id == 1 && type_tok.text == "List" {
            ann_is_list = 1
            // Element type is 2 tokens ahead: List < ElementType >
            let elem_tok = p.peek_at(2)
            if elem_tok.kind_id == 1 {
                ann_elem_name = elem_tok.text
            }
        }
        type_ann = p.parse_type_expr()
    }

    // Expect = value
    if p.expect(TokenKind.Eq) == null {
        p.error("expected '=' in variable declaration")
        return null
    }

    // Peek at value token to detect type for globals (before parse_expr consumes it)
    let value_tok_kind = p.peek().kind_id
    // kind_id 4 = StringLit, 2 = IntLit, 3 = FloatLit
    // LBracket = list literal, LBrace = map literal
    let value_tok_key = p.kind_to_key(p.peek().kind)

    let value = p.parse_expr()
    if value == null {
        p.error("expected expression after '='")
        return null
    }

    // Register top-level globals with type info
    if IN_FUNCTION_BODY != 1 {
        mut is_str_global = 0
        if value_tok_key == "LBracket" || value_tok_key == "LBrace" || value_tok_kind == 4 {
            is_str_global = 1
        }
        forge_global_var_register(var_name, is_str_global)
    }

    PARSE_END_POS = forge_parser_get_pos()
    return Statement.Let(var_name, value!, start)
}

fn parse_let(p: Parser) -> Statement? { parse_var_binding(p, .Let, false) }
fn parse_mut(p: Parser) -> Statement? { parse_var_binding(p, .Mut, false) }
fn parse_const(p: Parser) -> Statement? { parse_var_binding(p, .Const, false) }

// ─── Check ──────────────────────────────────────

fn check_var(tc: TypeChecker, node: NodeRef) {
    let d = get_var_decl(node.node_id)
    if d == null { return }
    let data = d!

    let val_type = tc.infer_expr(data.value)
    // TODO: resolve type annotation (currently both branches return val_type)
    let ty = val_type

    let mutable = data.var_kind is .Mut
    tc.env.define(data.name, ty, mutable)
}

fn top_level_var(tc: TypeChecker, node: NodeRef) {
    // Pre-register variable in scope for forward references
    check_var(tc, node)
}

// ─── Emit ───────────────────────────────────────

fn emit_var(cg: Codegen, node: NodeRef) {
    // No-op: variables are emitted inline during parsing
    return
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "variables", ... })
reg_parser("let", parse_let)
reg_parser("mut", parse_mut)
reg_parser("const", parse_const)
reg_check_stmt("variables", check_var)
reg_emit_stmt("variables", emit_var)
reg_top_level("variables", top_level_var)
