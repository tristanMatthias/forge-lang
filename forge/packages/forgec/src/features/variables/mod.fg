// ─── Variables Feature ─────────────────────────
// Handles: let, mut, const bindings.
// Side table stores VarDeclData keyed by node_id.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr}
use checker.TypeChecker
use codegen.{Codegen, CG_ACTIVE, CG_LAST_IS_STR, CG_LAST_IS_MAP, CG_LAST_IS_LIST, CG_LAST_IS_NULLABLE, CG_LAST_ENUM_TYPE, CG_ENUM_VAR_CSV, CG_LAST_VAL, CG_HAS_LAST_VAL, CG_LAST_STRUCT_TYPE, CG_LAST_LIST_ELEM_IS_STR, CG_STRUCT_VAR_NAMES, CG_STRUCT_VAR_TYPES, CG_STRUCT_VAR_FIELDS, CG_B, CG_I64, CG_VAR_NAMES, CG_VAR_IS_MAP, CG_MAP_VAR_NAMES, CG_VAR_PTRS, CG_LIST_VAR_CSV, CG_STR_LIST_VAR_CSV, CG_LIST_ELEM_TYPE_CSV, CG_NULLABLE_VAR_NAMES, CG_NULLABLE_VAR_INNER, codegen_new}
use features.while_loops.PARSE_END_POS
use @std.llvm

// ─── Side Table ──────────────────────────────────

mut VAR_DECLS: Map<string, VarDeclData> = {}

// ─── Data Types ──────────────────────────────────

enum VarKind { Let, Mut, Const }

type VarDeclData = {
    var_kind: VarKind,
    name: string,
    type_ann: TypeExpr?,
    value: Expr,
    exported: bool,
    span: Span,
}

fn get_var_decl(node_id: int) -> VarDeclData? {
    let key = "${node_id}"
    if VAR_DECLS.has(key) { VAR_DECLS[key] } else { null }
}

// ─── Parse ──────────────────────────────────────

// Track whether we're inside a function body (to detect top-level globals)
export mut IN_FUNCTION_BODY: int = 0

// Global variable tracking
export mut VAR_GLOBAL_COUNT: int = 0
export mut VAR_GLOBAL_NAMES: List<string> = []
// Bitmask: bit i = 1 if global i is string/list type
export mut VAR_GLOBAL_STR_MASK: int = 0  // Legacy bitmask (only works for first 64 globals)
export mut VAR_GLOBAL_IS_STR: List<int> = []  // 0/1 per global (replaces bitmask)
export mut VAR_GLOBAL_TYPE_CSV: string = ""    // "name:ann_is_list:value_tok_kind\n" per global
export mut VAR_GLOBAL_IS_STR: int = 0

fn parse_var_binding(p: Parser, kind: VarKind, exported: bool) -> Statement? {
    let start = p.advance().span // consume let/mut/const
    // Reset ALL codegen tracking flags so we don't use stale values from
    // preceding expressions (e.g., if condition, struct literal, list push)
    if CG_ACTIVE {
        CG_HAS_LAST_VAL = 0
        CG_LAST_IS_STR = 0
        CG_LAST_IS_MAP = 0
        CG_LAST_IS_LIST = 0
        CG_LAST_IS_NULLABLE = 0
        CG_LAST_STRUCT_TYPE = ""
        CG_LAST_ENUM_TYPE = ""
    }

    let var_name = p.expect_ident()
    if var_name == "" {
        p.error("expected variable name")
        return null
    }

    // Optional type annotation: : Type
    // Capture type annotation info for global type detection
    mut ann_is_list = 0
    mut ann_elem_name = ""
    mut type_ann: TypeExpr? = null
    if p.check(TokenKind.Colon) {
        p.advance()
        // Peek: if next is "List", capture element type name
        let type_tok = p.peek()
        if type_tok.kind_id == 1 {
            if type_tok.text == "List" {
                ann_is_list = 1
                // Element type is 2 tokens ahead: List < ElementType >
                let elem_tok = p.peek_at(2)
                if elem_tok.kind_id == 1 {
                    ann_elem_name = elem_tok.text
                }
            }
        }
        type_ann = p.parse_type_expr()
    }

    // Expect = value
    if p.expect(TokenKind.Eq) == null {
        p.error("expected '=' in variable declaration")
        return null
    }

    // Peek at value token to detect type for globals (before parse_expr consumes it)
    let value_tok_kind = p.peek().kind_id
    // kind_id 4 = StringLit, 2 = IntLit, 3 = FloatLit
    // LBracket = list literal, LBrace = map literal
    let value_tok_key = p.kind_to_key(p.peek().kind)

    let value = p.parse_expr()
    if value == null {
        p.error("expected expression after '='")
        return null
    }

    // Register top-level globals with type detection from value token
    if IN_FUNCTION_BODY != 1 {
        // Track if this global is a string/list/map type
        // Use token TEXT instead of kind match (bootstrap match on 100+ variant
        // TokenKind enum has issues with high variant indices)
        // Detect string/list/map globals
        // Store type info in CSV. Use the raw type token text instead of ann_is_list
        // (bootstrap has bugs with mut variables modified inside if blocks)
        mut type_hint = "int"
        if type_ann != null {
            // We stored the type tok text in the check above. But since ann_is_list
            // is unreliable, use the raw type token text which was peeked before
            // parse_type_expr consumed it. If the type starts with "List", it's a list.
        }
        // Detect from token kind: 4 = StringLit value
        // Detect from type annotation text by re-checking the global name pattern
        // (all lists are initialized with [] which is LBracket)
        VAR_GLOBAL_TYPE_CSV = VAR_GLOBAL_TYPE_CSV + var_name + ":" + string(value_tok_kind) + "\n"
        // Use CSV-based detection instead of bitmask/list (both unreliable with bootstrap bugs)
        mut is_list_or_str = false
        if value_tok_kind == 4 { is_list_or_str = true }
        // ann_is_list detection deferred to create_globals_typed via CSV
        if is_list_or_str {
            VAR_GLOBAL_IS_STR = VAR_GLOBAL_IS_STR.push(1)
            // Legacy bitmask (only for first 64)
            if VAR_GLOBAL_COUNT < 64 {
                mut bit = 1
                mut shift = 0
                while shift < VAR_GLOBAL_COUNT {
                    bit = bit * 2
                    shift = shift + 1
                }
                VAR_GLOBAL_STR_MASK = VAR_GLOBAL_STR_MASK + bit
            }
        } else {
            VAR_GLOBAL_IS_STR = VAR_GLOBAL_IS_STR.push(0)
        }
        VAR_GLOBAL_COUNT = VAR_GLOBAL_COUNT + 1
        VAR_GLOBAL_NAMES = VAR_GLOBAL_NAMES.push(var_name)
    }

    // Emit inline during re-parse+codegen (Map storage corrupts complex data)
    if CG_ACTIVE {
        // Check if parse_list_literal or postfix set a pre-computed LLVM value
        // Bootstrap fix: `mut val = null` infers nullable {i8,i64} type.
        // Use explicit ptr type to avoid type mismatch when passing to define_var.
        mut val: ptr = null
        if CG_HAS_LAST_VAL == 1 {
            CG_HAS_LAST_VAL = 0
            val = CG_LAST_VAL
        } else {
            mut cg = codegen_new()
            val = cg.emit_expr(value!)
        }
        // Detect string/list/map type
        let is_str = CG_LAST_IS_STR == 1
        let is_map = CG_LAST_IS_MAP == 1
        mut var_type = Type.Int
        if is_map {
            var_type = Type.MapType(Type.String, Type.Int)
        } else if is_str {
            var_type = Type.String
        }
        // Also check if value expression is a string literal
        match value! {
            .StringLit(v, s) -> {
                mut cg = codegen_new()
                cg.define_var(var_name, Type.String, val)
            }
            _ -> {
                mut cg = codegen_new()
                cg.define_var(var_name, var_type, val)
            }
        }
        // Register map variable name for reliable lookup
        if is_map {
            CG_MAP_VAR_NAMES = CG_MAP_VAR_NAMES.push(var_name)
        }
        // Register list variable for for-loop element type detection + indexing
        if value_tok_key == "LBracket" || ann_is_list == 1 || CG_LAST_IS_LIST == 1 {
            CG_LIST_VAR_CSV = CG_LIST_VAR_CSV + ",${var_name},"
            // Determine element type from annotation or first element
            let elem_is_str_detected = ann_elem_name == "string" || ann_elem_name == "String" || CG_LAST_LIST_ELEM_IS_STR == 1
            if elem_is_str_detected {
                CG_STR_LIST_VAR_CSV = CG_STR_LIST_VAR_CSV + ",${var_name},"
                CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${var_name}:string,"
            } else if ann_elem_name != "" {
                CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${var_name}:${ann_elem_name},"
            } else {
                CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${var_name}:int,"
            }
            CG_LAST_LIST_ELEM_IS_STR = 0
            CG_LAST_IS_LIST = 0
        }
        // Register enum variable
        if CG_LAST_ENUM_TYPE != "" {
            CG_ENUM_VAR_CSV = CG_ENUM_VAR_CSV + "," + var_name + ":" + CG_LAST_ENUM_TYPE + ","
            CG_LAST_ENUM_TYPE = ""
        }
        // Register nullable variable for null comparison and unwrap
        if CG_LAST_IS_NULLABLE == 1 {
            CG_NULLABLE_VAR_NAMES = CG_NULLABLE_VAR_NAMES.push(var_name)
            mut inner_type_name = "int"
            if is_str { inner_type_name = "string" }
            CG_NULLABLE_VAR_INNER = CG_NULLABLE_VAR_INNER.push(inner_type_name)
        }
        // Register struct variable type + copy field info from temp
        if CG_LAST_STRUCT_TYPE != "" {
            CG_STRUCT_VAR_NAMES = CG_STRUCT_VAR_NAMES.push(var_name)
            CG_STRUCT_VAR_TYPES = CG_STRUCT_VAR_TYPES.push(CG_LAST_STRUCT_TYPE)
            // Copy field list from the temp struct variable (last entry)
            let last_fi = CG_STRUCT_VAR_FIELDS.length - 1
            if last_fi >= 0 {
                CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push(CG_STRUCT_VAR_FIELDS[last_fi])
            } else {
                CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push("")
            }
        }
        // Reset flags for next expression
        CG_LAST_IS_STR = 0
        CG_LAST_IS_MAP = 0
        CG_LAST_IS_NULLABLE = 0
        CG_LAST_STRUCT_TYPE = ""
        CG_HAS_LAST_VAL = 0
    }

    PARSE_END_POS = p.pos
    let id = next_node_id()
    // Store in side table for codegen path (emit_var)
    VAR_DECLS["${id}"] = VarDeclData {
        var_kind: kind,
        name: var_name,
        type_ann: type_ann,
        value: value!,
        exported: exported,
        span: start,
    }
    feature_stmt("variables", "let_decl", id, start)
}

fn parse_let(p: Parser) -> Statement? { parse_var_binding(p, .Let, false) }
fn parse_mut(p: Parser) -> Statement? { parse_var_binding(p, .Mut, false) }
fn parse_const(p: Parser) -> Statement? { parse_var_binding(p, .Const, false) }

// ─── Check ──────────────────────────────────────

fn check_var(tc: TypeChecker, node: NodeRef) {
    let d = get_var_decl(node.node_id)
    if d == null { return }
    let data = d!

    let val_type = tc.infer_expr(data.value)
    let ty = val_type

    let mutable = data.var_kind is .Mut
    tc.env.define(data.name, ty, mutable)
}

fn top_level_var(tc: TypeChecker, node: NodeRef) {
    // Pre-register variable in scope for forward references
    check_var(tc, node)
}

// ─── Emit ───────────────────────────────────────

fn emit_var(cg: Codegen, node: NodeRef) {
    let d = get_var_decl(node.node_id)
    if d == null { return }
    let data = d!
    let var_name = data.name

    // Emit the value expression
    let val = cg.emit_expr(data.value)

    // Detect type from the emitted value's type flags
    let is_str = CG_LAST_IS_STR == 1
    let is_map = CG_LAST_IS_MAP == 1
    mut var_type = Type.Int
    if is_map {
        var_type = Type.MapType(Type.String, Type.Int)
    } else if is_str {
        var_type = Type.String
    }

    // Define the variable (alloca + store + register)
    cg.define_var(var_name, var_type, val)

    // Register map variable
    if is_map {
        CG_MAP_VAR_NAMES = CG_MAP_VAR_NAMES.push(var_name)
    }
    // Register list variable
    if CG_LAST_IS_LIST == 1 {
        CG_LIST_VAR_CSV = CG_LIST_VAR_CSV + ",${var_name},"
        if CG_LAST_LIST_ELEM_IS_STR == 1 {
            CG_STR_LIST_VAR_CSV = CG_STR_LIST_VAR_CSV + ",${var_name},"
            CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${var_name}:string,"
        } else {
            CG_LIST_ELEM_TYPE_CSV = CG_LIST_ELEM_TYPE_CSV + ",${var_name}:int,"
        }
    }
    // Register struct variable
    if CG_LAST_STRUCT_TYPE != "" {
        CG_STRUCT_VAR_NAMES = CG_STRUCT_VAR_NAMES.push(var_name)
        CG_STRUCT_VAR_TYPES = CG_STRUCT_VAR_TYPES.push(CG_LAST_STRUCT_TYPE)
        mut field_info = ""
        mut sri = CG_STRUCT_FIELDS.length - 1
        while sri >= 0 {
            if CG_STRUCT_NAMES[sri] == CG_LAST_STRUCT_TYPE {
                field_info = CG_STRUCT_FIELDS[sri]
                break
            }
            sri = sri - 1
        }
        CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push(field_info)
    }
    // Register enum variable
    if CG_LAST_ENUM_TYPE != "" {
        CG_ENUM_VAR_CSV = CG_ENUM_VAR_CSV + ",${var_name}:${CG_LAST_ENUM_TYPE},"
    }
    // Register nullable variable
    if CG_LAST_IS_NULLABLE == 1 {
        CG_NULLABLE_VAR_NAMES = CG_NULLABLE_VAR_NAMES.push(var_name)
        mut inner = "int"
        if is_str { inner = "string" }
        CG_NULLABLE_VAR_INNER = CG_NULLABLE_VAR_INNER.push(inner)
    }
    // Reset type flags
    CG_LAST_IS_STR = 0
    CG_LAST_IS_MAP = 0
    CG_LAST_IS_LIST = 0
    CG_LAST_IS_NULLABLE = 0
    CG_LAST_STRUCT_TYPE = ""
    CG_LAST_ENUM_TYPE = ""
    CG_HAS_LAST_VAL = 0
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "variables", ... })
reg_parser("let", parse_let)
reg_parser("mut", parse_mut)
reg_parser("const", parse_const)
reg_check_stmt("variables", check_var)
reg_emit_stmt("variables", emit_var)
reg_top_level("variables", top_level_var)
