// ─── Variables Feature ─────────────────────────
// Handles: let, mut, const bindings.
// Side table stores VarDeclData keyed by node_id (as string).
// Parse handlers for "let", "mut", "const" tokens.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.registry.{register_feature, FeatureRegistration, REGISTRY}
use parser.mod.{Parser, Param, TypeExpr}

// ─── Side Table ──────────────────────────────────

mut VAR_DECLS: Map<string, VarDeclData> = {}

// ─── Data Types ──────────────────────────────────

enum VarKind {
    Let
    Mut
    Const
}

type VarDeclData = {
    var_kind: VarKind,
    name: string,
    type_ann: TypeExpr?,
    value: Expr,
    exported: bool,
    span: Span,
}

// ─── Lookup Helper ───────────────────────────────

fn get_var_decl(node_id: int) -> VarDeclData? {
    let key = "${node_id}"
    if VAR_DECLS.has(key) {
        VAR_DECLS[key]
    } else {
        null
    }
}

// ─── Parse Helpers ───────────────────────────────

fn parse_var_binding(p: Parser, kind: VarKind, exported: bool) -> Statement? {
    let start = p.advance().span // consume let/mut/const

    // Expect identifier
    let name = p.expect_ident()
    if name == null {
        p.error("expected variable name after '${match kind { .Let -> "let", .Mut -> "mut", .Const -> "const" }}'")
        return null
    }

    // Optional type annotation: : Type
    let type_ann = if p.check(.Colon) {
        p.advance()
        p.parse_type_expr()
    } else {
        null
    }

    // Expect = value
    if p.expect(.Eq) == null {
        p.error("expected '=' in variable declaration")
        return null
    }

    let value = p.parse_expr()
    if value == null {
        p.error("expected expression after '='")
        return null
    }

    // Store in side table
    let id = next_node_id()
    let key = "${id}"
    VAR_DECLS[key] = VarDeclData {
        var_kind: kind,
        name: name!,
        type_ann,
        value: value!,
        exported,
        span: start,
    }

    feature_stmt("variables", match kind {
        .Let -> "let_decl"
        .Mut -> "mut_decl"
        .Const -> "const_decl"
    }, id, start)
}

// ─── Parse Handlers ──────────────────────────────

fn parse_let(ctx: ptr) -> ptr {
    let p = ctx as Parser
    let result = parse_var_binding(p, .Let, false)
    result as ptr
}

fn parse_mut(ctx: ptr) -> ptr {
    let p = ctx as Parser
    let result = parse_var_binding(p, .Mut, false)
    result as ptr
}

fn parse_const(ctx: ptr) -> ptr {
    let p = ctx as Parser
    let result = parse_var_binding(p, .Const, false)
    result as ptr
}

// ─── Registration ────────────────────────────────

register_feature(FeatureRegistration {
    id: "variables",
    name: "Variable Declarations",
    status: "wip",
    parse_tokens: ["let", "mut", "const"],
    parse_handlers: [parse_let, parse_mut, parse_const],
    check_stmt: null,
    check_expr: null,
    emit_stmt: null,
    emit_expr: null,
    top_level: null,
})
