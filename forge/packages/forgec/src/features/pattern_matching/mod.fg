use core.ast.NodeRef
use core.types.Type
use checker.TypeChecker
use codegen.Codegen

export fn check_match(tc: TypeChecker, node: NodeRef) -> Type {
    Type.Unknown
}

export fn emit_match(cg: Codegen, node: NodeRef) -> ptr {
    llvm.const_int(CG_I64, 0, 0)
}
