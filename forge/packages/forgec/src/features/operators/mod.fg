// ─── Operators Feature ─────────────────────────
// Operators (arithmetic, comparison, logical, bitwise) are built into the
// expression parser's precedence climbing in parser/expressions.fg.
// They produce core Expr.Binary/Expr.Unary nodes directly — no
// feature-specific parse handlers needed.

use core.registry.{register_feature, FeatureRegistration}

register_feature(FeatureRegistration {
    id: "operators",
    name: "Arithmetic & Comparison Operators",
    status: "wip",
    parsers: {},
    check_stmt: null, check_expr: null,
    emit_stmt: null, emit_expr: null,
    top_level: null,
})
