// ─── Operators Feature ─────────────────────────
// Operators (arithmetic, comparison, logical, bitwise) are built into the
// expression parser's precedence climbing in parser/expressions.fg.
// They produce core Expr.Binary/Expr.Unary nodes directly — no
// feature-specific parse handlers needed.

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "operators", ... })
