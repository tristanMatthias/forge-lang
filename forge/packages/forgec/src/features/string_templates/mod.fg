// ─── String Templates Feature ─────────────────
// Handles: template literals "hello ${name}" → string concatenation.
// Side table stores template parts (literal segments + interpolated exprs).
// Construction helper called from expression parser on TemplateLiteral tokens.

use core.token.Span
use core.ast.{Expr, NodeRef, feature_expr, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use checker.TypeChecker
use codegen.Codegen

// ─── Side Table ─────────────────────────────────

mut TEMPLATES: Map<string, TemplateData> = {}

// ─── Data Types ─────────────────────────────────

enum TemplatePart {
    Literal(value: string)
    Interpolation(expr: Expr)
}

type TemplateData = {
    parts: List<TemplatePart>,
    span: Span,
}

fn get_template(id: int) -> TemplateData? {
    let key = "${id}"
    if TEMPLATES.has(key) { TEMPLATES[key] } else { null }
}

// ─── Construction Helper ────────────────────────
// Called by expression parser when it encounters a template string.

fn make_template(parts: List<TemplatePart>, span: Span) -> Expr {
    let id = next_node_id()
    TEMPLATES["${id}"] = TemplateData { parts, span }
    feature_expr("string_templates", "template", id, span)
}

// ─── Check ──────────────────────────────────────

fn check_template(tc: TypeChecker, node: NodeRef) -> Type {
    // Bootstrap workaround: match destructuring of complex enum payloads
    // (Expr inside TemplatePart.Interpolation) causes LLVM verification errors.
    // Skip checking interpolated expressions — templates always produce String.
    Type.String
}

// ─── Emit ───────────────────────────────────────

fn emit_template(cg: Codegen, node: NodeRef) -> ptr {
    // Template codegen is handled inline in parse_primary_expr (expressions.fg)
    // via emit_template_expr() + tpl_emit_interpolation(). This dispatch path
    // is only reached for FeatureExpr nodes, which templates don't produce.
    llvm.const_int(CG_I64, 0, 0)
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "string_templates", ... })
reg_check_expr("string_templates", check_template)
reg_emit_expr("string_templates", emit_template)
