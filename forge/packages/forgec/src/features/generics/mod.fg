// ─── Generics Feature ─────────────────────────
// Handles: generic type parameters <T, U> on functions, structs, enums.
// Generics are parsed in the type expression parser (parse_type_params)
// and resolved during type checking (monomorphization / erasure).
// No parse handler — type params are part of existing declaration parsers.
// No side table — generic info is stored on the declarations themselves.

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "generics", ... })
