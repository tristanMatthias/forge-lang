// ─── Functions Feature ─────────────────────────
// Handles: fn declarations and export fn.
// Side table stores FnDeclData keyed by node_id.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr, parser_new}
use lexer.{lexer_new}
use checker.TypeChecker
use codegen.{Codegen, TypedValue, tv_int, CG_ENUM_TYPE_CSV, CG_CTX, CG_STR, CG_I64, CG_I8, CG_VOID, CG_PTR, CG_VAR_SCOPE_START, CG_FN_RETURNS_NULLABLE, CG_FN_NULLABLE_INNER_TY, CG_FN_NULLABLE_RET_TY, make_nullable_type, wrap_nullable, make_null_value, cg_enum_max_fields, cg_make_enum_type, resolve_type_to_llvm, cg_reinit_types}
use features.variables.{parse_var_binding, VarKind, IN_FUNCTION_BODY, VAR_LIST_INIT_CSV}
use features.structs.{parse_type_decl}
use features.enums.{parse_enum_decl}
use features.while_loops.{PARSE_END_POS, WHILE_COND_BB, WHILE_END_BB}
use parser.{LAST_PARAM_TYPE_NAME, PARSED_PARAM_TYPES, LAST_IDENT_NAME}

// ─── Side Table ──────────────────────────────────

mut FN_DECLS: Map<string, FnDeclData> = {}

// ─── Data Types ──────────────────────────────────

type FnDeclData = {
    name: string,
    type_params: List<string>,
    params: List<Param>,
    return_type: TypeExpr?,
    body: Block,
    exported: bool,
    span: Span,
}

fn get_fn_decl(node_id: int) -> FnDeclData? {
    let key = "${node_id}"
    if FN_DECLS.has(key) { FN_DECLS[key] } else { null }
}

// ─── Parse ──────────────────────────────────────

fn parse_fn_decl(p: Parser, exported: bool) -> Statement? {
    let start = p.advance().span // consume 'fn'

    let name = p.expect_ident()
    if name == "" { return null }

    let type_params = p.parse_type_params()
    let params: List<Param> = p.parse_params()

    mut return_type_name = ""
    mut return_type: TypeExpr? = null
    if p.check_id(86) {  // Arrow
        p.advance()
        // Capture return type name
        let ret_tok = p.peek()
        if ret_tok.kind_id == 1 {
            return_type_name = ret_tok.text
        }
        let parsed_ret = p.parse_type_expr()
        if parsed_ret != null {
            match parsed_ret! {
                .Nullable(inner, span) -> {
                    return_type_name = return_type_name + "?"
                }
                _ -> {}
            }
        }
        return_type = parsed_ret
    }

    // Capture body source using C-side token span access
    // (Forge-level span access produces garbage in Stage 2 due to struct field extraction bugs)
    let block_open_pos = p.pos
    IN_FUNCTION_BODY = 1
    let body = p.parse_block()
    IN_FUNCTION_BODY = 0
    let block_close_pos = p.pos - 1
    let body_src = forge_extract_body_source(p.source, block_open_pos, block_close_pos)
    eprintln("  BODY " + name + " open_pos=" + string(block_open_pos) + " close_pos=" + string(block_close_pos) + " len=" + string(body_src.length) + " src_len=" + string(p.source.length))

    store_fn_source(name, body_src)
    store_fn_param_count(params.length)
    store_fn_return_type(return_type_name)
    mut pi = 0
    for param in params {
        store_fn_param_name(param.name)
        if pi < PARSED_PARAM_TYPES.length {
            store_fn_param_type(PARSED_PARAM_TYPES[pi])
        } else {
            store_fn_param_type("int")
        }
        pi = pi + 1
    }

    PARSE_END_POS = p.pos
    let id = next_node_id()
    feature_stmt("functions", "fn_decl", id, start)
}

fn parse_fn(p: Parser) -> Statement? { parse_fn_decl(p, false) }

fn parse_export(p: Parser) -> Statement? {
    let start = p.advance().span // consume 'export'

    match p.peek().kind {
        .Fn -> parse_fn_decl(p, true)
        .Let -> parse_var_binding(p, .Let, true)
        .Mut -> parse_var_binding(p, .Mut, true)
        .Const -> parse_var_binding(p, .Const, true)
        .TypeKw -> {
            // export type — treat same as type
            parse_type_decl(p)
        }
        .Enum -> {
            // export enum — treat same as enum
            parse_enum_decl(p)
        }
        .Trait -> {
            // export trait — skip (trait is no-op for codegen)
            p.advance() // consume 'trait'
            p.expect_ident() // trait name
            if p.check_id(102) {  // LBrace
                p.parse_block() // skip body
            }
            PARSE_END_POS = forge_parser_get_pos()
            let id = next_node_id()
            feature_stmt("functions", "noop", id, start)
        }
        _ -> {
            p.error("expected 'fn', 'let', 'mut', or 'const' after 'export'")
            null
        }
    }
}

// ─── Check ──────────────────────────────────────

fn check_fn(tc: TypeChecker, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Build function type
    mut param_types: List<Type> = []
    for param in data.params {
        // TODO: resolve param type from annotation
        param_types = param_types.push(Type.Unknown)
    }
    let ret_type = Type.Void // TODO: resolve from return_type annotation
    let fn_type = Type.Function(param_types, ret_type)

    // Register function in scope
    tc.env.define(data.name, fn_type, false)

    // Check body in new scope
    tc.env.push_scope()
    tc.env.push_return_type(ret_type)

    // Define params in scope
    mut i = 0
    for param in data.params {
        tc.env.define(param.name, param_types[i], param.mutable)
        i = i + 1
    }

    tc.check_block(data.body)
    tc.env.pop_return_type()
    tc.env.pop_scope()
}

fn top_level_fn(tc: TypeChecker, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Pre-register function type for forward references
    mut param_types: List<Type> = []
    for param in data.params {
        param_types = param_types.push(Type.Unknown)
    }
    tc.env.define(data.name, Type.Function(param_types, Type.Void), false)
}

// ─── Emit ───────────────────────────────────────

fn emit_fn(cg: Codegen, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Use globals for LLVM state (bootstrap workaround)
    // main() returns i32, other functions return i64
    let is_main = data.name == "main"

    // Build LLVM function type
    let param_arr = llvm.type_array_new(data.params.length)
    mut i = 0
    for param in data.params {
        llvm.type_array_set(param_arr, i, CG_I64)
        i = i + 1
    }
    mut ret_ty = CG_I64
    if is_main { ret_ty = CG_I32 }
    let fn_type = llvm.function_type(ret_ty, param_arr, data.params.length, 0)
    llvm.type_array_free(param_arr)

    let fn_val = llvm.add_function(CG_MOD, data.name, fn_type)
    cg.functions[data.name] = fn_val
    cg.current_fn = fn_val

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    // Define params as local variables
    i = 0
    for param in data.params {
        let param_val = llvm.get_param(fn_val, i)
        cg.define_var(param.name, tv_int(param_val))
        i = i + 1
    }

    // Emit body
    cg.emit_block(data.body)

    // Add implicit return if needed
    if is_main {
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    } else {
        llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
    }
}

// ─── Emit All Functions (bypass enum dispatch) ──

// Global parallel lists for function data (bootstrap can't use Map<string, struct>)
export mut FN_NAMES: List<string> = []
export mut FN_BODY_SOURCES: List<string> = []  // body source text for re-parsing
// FN_BODIES removed — was dead code causing LLVM verification errors
export mut FN_PARAM_COUNTS: List<int> = []     // param count per fn
mut FN_ALL_PARAM_NAMES: List<string> = [] // flat list of ALL param names
mut FN_ALL_PARAM_TYPES: List<string> = [] // flat list of ALL param type names
mut FN_RETURN_TYPES: List<string> = []    // return type name per function
export mut FN_FILE_INDEX: List<int> = []        // which file each function belongs to
export mut CURRENT_FILE_INDEX: int = 0           // set before scanning each file
export mut EMIT_FILE_IDX: int = -1               // -1 = all files, >= 0 = only this file

// Store source text for re-parsing during codegen
export fn store_fn_source(name: string, body_source: string) {
    FN_NAMES = FN_NAMES.push(name)
    FN_BODY_SOURCES = FN_BODY_SOURCES.push(body_source)
    FN_FILE_INDEX = FN_FILE_INDEX.push(CURRENT_FILE_INDEX)
    // Also store in C-side array (immune to Forge list push corruption)
    forge_fn_store_add(name, body_source)
}

export fn store_fn_param_count(count: int) {
    FN_PARAM_COUNTS = FN_PARAM_COUNTS.push(count)
    // Also store in C-side fn store (immune to Forge list corruption)
    // The param count is always stored right after fn_store_add for the same function
    let fn_idx = forge_fn_store_count() - 1
    forge_fn_store_set_param_count(fn_idx, count)
}

export fn store_fn_param_name(name: string) {
    FN_ALL_PARAM_NAMES = FN_ALL_PARAM_NAMES.push(name)
    forge_param_name_add(name)
}

export fn store_fn_param_type(type_name: string) {
    FN_ALL_PARAM_TYPES = FN_ALL_PARAM_TYPES.push(type_name)
    forge_param_type_add(type_name)
}

export fn store_fn_return_type(type_name: string) {
    FN_RETURN_TYPES = FN_RETURN_TYPES.push(type_name)
    // Register name+return_type pair in C-side registry (immune to list corruption)
    let store_count = forge_fn_store_count()
    if store_count > 0 {
        let fn_name = forge_fn_store_get_name(store_count - 1)
        forge_fn_reg_add(fn_name, type_name)
    }
}

// Global function map (bootstrap workaround: Codegen.functions passed by value loses data)
mut DECLARED_FNS: Map<string, ptr> = {}

// Declare all functions (signatures only, no bodies) so forward calls work
export fn declare_all_functions(cg: Codegen) {
    mut i = 0
    let daf_total = forge_fn_store_count()
    while i < daf_total {
        let name = forge_fn_store_get_name(i)
        let is_main = name == "main"
        mut pc = 0
        if i < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[i] }
        let param_arr = llvm.type_array_new(pc)
        mut pi = 0
        while pi < pc {
            llvm.type_array_set(param_arr, pi, CG_I64)
            pi = pi + 1
        }
        mut ret_ty = CG_I64
        if is_main { ret_ty = CG_I32 }
        let fn_type = llvm.function_type(ret_ty, param_arr, pc, 0)
        llvm.type_array_free(param_arr)
        let fn_val = llvm.add_function(CG_MOD, name, fn_type)
        cg.functions[name] = fn_val
        DECLARED_FNS[name] = fn_val
        i = i + 1
    }
}

// Phase 1: Declare all functions with proper types (called before any body emission)
export fn declare_all_fns() {
    cg_reinit_types()
    // Create struct LLVM types
    let struct_count = CG_STRUCT_NAMES.length
    // Pass 1: create all opaque named types (handles circular references like Scope → Scope?)
    mut pre = 0
    while pre < struct_count {
        let pname = CG_STRUCT_NAMES[pre]
        let existing = llvm.get_type_by_name(CG_CTX, pname)
        if existing == null {
            llvm.struct_create_named(CG_CTX, pname)
        }
        pre = pre + 1
    }
    // Pass 2: set bodies with proper field types
    mut si = 0
    while si < struct_count {
        cg_reinit_types()
        let fields = CG_STRUCT_FIELDS[si]
        mut fc = 1
        mut ci = 0
        while ci < fields.length {
            if fields[ci] == "," { fc = fc + 1 }
            ci = ci + 1
        }
        if fields.length == 0 { fc = 0 }
        mut ftn = ""
        if si < CG_STRUCT_FIELD_TYPE_NAMES.length { ftn = CG_STRUCT_FIELD_TYPE_NAMES[si] }
        let fta = llvm.type_array_new(fc)
        // Save type values locally (list pushes corrupt globals)
        let saved_i64 = CG_I64
        let saved_str = CG_STR
        if ftn.length > 0 {
            mut fi = 0
            mut ftn_pos = 0
            mut ftn_cur = ""
            while ftn_pos < ftn.length {
                let ch = ftn[ftn_pos]
                if ch == "," {
                    // Resolve field type — use resolve_type_to_llvm for proper enum/struct types
                    let fty = resolve_type_to_llvm(ftn_cur)
                    llvm.type_array_set(fta, fi, fty)
                    fi = fi + 1
                    ftn_cur = ""
                } else {
                    ftn_cur = ftn_cur + ch
                }
                ftn_pos = ftn_pos + 1
            }
            if ftn_cur != "" {
                mut fty = saved_i64
                if ftn_cur == "string" { fty = saved_str }
                else if ftn_cur.length >= 4 {
                    if ftn_cur[0] == "L" { fty = saved_str }
                }
                llvm.type_array_set(fta, fi, fty)
            }
        } else {
            mut fi = 0
            while fi < fc {
                llvm.type_array_set(fta, fi, saved_i64)
                fi = fi + 1
            }
        }
        // Always create/update named struct type
        let sname = CG_STRUCT_NAMES[si]
        mut sty = llvm.get_type_by_name(CG_CTX, sname)
        if sty == null {
            sty = llvm.struct_create_named(CG_CTX, sname)
        }
        // Always set body (updates fields to match resolve_type_to_llvm)
        llvm.struct_set_body(sty, fta, fc, 0)
        llvm.type_array_free(fta)
        CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(sname)
        CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
        CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(CG_STRUCT_FIELD_IS_STR[si])
        CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(ftn)
        CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(sty)
        si = si + 1
    }
    // Declare all function signatures — use C-side fn store count (Forge FN_NAMES.length is corrupt in Stage 2)
    mut param_offset = 0
    mut i = 0
    let fn_total = forge_fn_store_count()
    while i < fn_total {
        cg_reinit_types()
        let name = forge_fn_store_get_name(i)
        let is_main = name == "main"
        mut pc = 0
        if i < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[i] }
        let param_arr = llvm.type_array_new(pc)
        mut pi = 0
        while pi < pc {
            let pt_idx = param_offset + pi
            mut param_ty = CG_I64
            // Use C-side param registry (immune to Forge list corruption)
            let tname = forge_param_type_get(pt_idx)
            let pname = forge_param_name_get(pt_idx)
            if tname != "" {
                if pname == "self" {
                    param_ty = CG_PTR
                } else {
                    let resolved = resolve_type_to_llvm(tname)
                    if resolved != null { param_ty = resolved }
                }
            }
            llvm.type_array_set(param_arr, pi, param_ty)
            pi = pi + 1
        }
        mut ret_ty = CG_I64
        if is_main { ret_ty = CG_I32 }
        if !is_main {
            // Use C-side function registry (immune to Forge list corruption)
            // FN_RETURN_TYPES list gets corrupted after ~40 entries in Stage 1.
            mut rtn = forge_fn_reg_get_ret(name)
            // Fallback to Forge list if C-side registry is empty
            if rtn == "" && i < FN_RETURN_TYPES.length {
                rtn = FN_RETURN_TYPES[i]
            }
            // Strip nullable suffix for type resolution
            if rtn.length > 1 { if rtn[rtn.length - 1] == "?" {
                rtn = rtn.substring(0, rtn.length - 1)
            } }
            if rtn == "string" { ret_ty = CG_STR }
            else if rtn == "List" { ret_ty = CG_STR }
            else if rtn.length >= 4 && rtn.substring(0, 4) == "List" { ret_ty = CG_STR }
            else if rtn != "" && rtn != "int" && rtn != "bool" && rtn != "void" {
                cg_reinit_types()
                let resolved = resolve_type_to_llvm(rtn)
                if resolved != null { ret_ty = resolved }
            }
        }
        mut fn_val: ptr = null
        if is_main {
            // main gets (i32, ptr) for argc/argv
            let main_params = llvm.type_array_new(2)
            llvm.type_array_set(main_params, 0, CG_I32)
            llvm.type_array_set(main_params, 1, CG_PTR)
            let main_ft = llvm.function_type(CG_I32, main_params, 2, 0)
            llvm.type_array_free(main_params)
            fn_val = llvm.add_function(CG_MOD, "main", main_ft)
        } else {
            let fn_type = llvm.function_type(ret_ty, param_arr, pc, 0)
            fn_val = llvm.add_function(CG_MOD, name, fn_type)
        }
        llvm.type_array_free(param_arr)
        DECLARED_FNS[name] = fn_val
        param_offset = param_offset + pc
        i = i + 1
    }
}

// Emit a single function body from source — called per-function (no re-declaration)
export fn emit_fn_body_from_source(cg: Codegen, idx: int, param_offset: int) {
    let name = forge_fn_store_get_name(idx)
    eprintln("  emit: " + name)
    // Use C-side body store (immune to Forge list corruption that misaligns indices)
    let body_src = forge_fn_store_get_body(idx)
    let is_main = name == "main"
    mut pc = 0
    if idx < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[idx] }

    // Use LLVM lookup (avoids map ptr-as-i64 corruption)
    let fn_val = llvm.get_named_function(CG_MOD, name)
    if fn_val == null { return }
    cg.current_fn = fn_val
    cg_reinit_types()

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    // main: call forge_set_args(argc, argv) to make process.args() work
    if is_main {
        let argc_val = llvm.get_param(fn_val, 0)
        let argv_val = llvm.get_param(fn_val, 1)
        let sa = llvm.value_array_new(2)
        llvm.value_array_set(sa, 0, argc_val)
        llvm.value_array_set(sa, 1, argv_val)
        let sa_params = llvm.type_array_new(2)
        llvm.type_array_set(sa_params, 0, CG_I32)
        llvm.type_array_set(sa_params, 1, CG_PTR)
        let sa_ft = llvm.function_type(CG_VOID, sa_params, 2, 0)
        llvm.type_array_free(sa_params)
        let set_args_fn = llvm.get_named_function(CG_MOD, "forge_set_args")
        if set_args_fn != null {
            llvm.build_call(CG_B, sa_ft, set_args_fn, sa, 2, "")
        }
        llvm.value_array_free(sa)
    }

    CG_VAR_SCOPE_START = CG_VAR_NAMES.length
    // Reset C-side caches for this function
    forge_alloca_cache_clear()
    forge_str_var_clear()
    forge_idx_cache_clear()
    forge_var_counter_reset(CG_VAR_SCOPE_START)
    forge_var_name_clear()
    forge_struct_var_clear()
    forge_var_type_clear()
    forge_clear_last_let_name()
    forge_list_var_clear()
    forge_ptr_var_clear()

    // Define params
    mut pi = 0
    while pi < pc {
        let pt_idx = param_offset + pi
        // Use C-side param name/type registries (immune to Forge list corruption)
        let pname = forge_param_name_get(pt_idx)
        let param_val = llvm.get_param(fn_val, pi)
        let param_type_name = forge_param_type_get(pt_idx)
        let is_struct_param = param_type_name != "int" && param_type_name != "string" && param_type_name != "float" && param_type_name != "bool" && param_type_name != "ptr"
        mut p_ty = CG_I64
        if param_type_name == "string" { p_ty = CG_STR }
        if param_type_name == "ptr" { p_ty = CG_PTR
            forge_ptr_var_add(pname) }
        if is_struct_param {
            let resolved = resolve_type_to_llvm(param_type_name)
            if resolved != null && resolved != CG_I64 { p_ty = resolved }
        }
        // self param: store ptr directly in cache (no alloca copy needed)
        mut alloca = param_val
        if pname != "self" {
            forge_set_alloca_name(pname)
            alloca = llvm.build_alloca(CG_B, p_ty, pname)
            forge_alloca_cache_set_type(pname, p_ty)
            llvm.build_store(CG_B, param_val, alloca)
        } else {
            // Create ptr alloca for self too
            forge_set_alloca_name(pname)
            alloca = llvm.build_alloca(CG_B, CG_PTR, pname)
            forge_alloca_cache_set_type(pname, CG_PTR)
            llvm.build_store(CG_B, param_val, alloca)
        }
        // Save alloca by C counter (immune to Forge list length corruption)
        let var_idx = forge_var_counter_inc()
        forge_idx_cache_set(var_idx, alloca)
        // Derive param type from p_ty (actual alloca type)
        mut param_vty = "i64"
        if p_ty == CG_STR { param_vty = "%ForgeString" }
        else if p_ty == CG_PTR || pname == "self" { param_vty = "ptr" }
        else if is_struct_param { param_vty = "%" + param_type_name }
        // Register type name from param declaration (source-level, not flag-derived)
        forge_var_type_set(pname, param_type_name)
        CG_VAR_NAMES = CG_VAR_NAMES.push(pname)
        forge_var_name_push(pname)
        mut _vis = 0
        if param_type_name == "string" { _vis = 1 }
        CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
        // String and List share {ptr, i64} — register in CG_STR_VAR_NAMES so emit_ident loads correctly
        if param_type_name == "string" {
            forge_str_var_add(pname)
        // Also handle: param_type_name might be corrupted — check text match
        } else if pname == "text" || pname == "source" || pname == "name" || pname == "value" || pname == "message" || pname == "key" || pname == "path" || pname == "code" || pname == "help" || pname == "filename" || pname == "pattern" || pname == "prefix" {
            // Common string param names — add to C cache as safety net
            forge_str_var_add(pname)
        } else if param_type_name.length >= 4 {
            if param_type_name[0] == "L" {
                forge_list_var_add(pname)
                // Extract element type from "List<Elem>" and register
                let lt_pos = param_type_name.index_of("<")
                if lt_pos > 0 {
                    let gt_pos = param_type_name.index_of(">")
                    if gt_pos > lt_pos {
                        let elem_name = param_type_name.substring(lt_pos + 1, gt_pos)
                        if elem_name == "string" {
                        }
                    }
                } else {
                    // No generic info — default to string list
                }
            }
        }
        if is_struct_param {
            let emf = cg_enum_max_fields(param_type_name)
            // Check if type is a known enum (any payload size)
            let enum_needle = "," + param_type_name + ":"
            let is_enum = CG_ENUM_TYPE_CSV.index_of(enum_needle) >= 0
            if is_enum {
            } else {
                forge_struct_var_add(pname, param_type_name)
                mut field_info = ""
                mut sri = CG_STRUCT_FIELDS.length - 1
                while sri >= 0 {
                    if CG_STRUCT_NAMES[sri] == param_type_name {
                        field_info = CG_STRUCT_FIELDS[sri]
                        break
                    }
                    sri = sri - 1
                }
            }
        }
        pi = pi + 1
    }

    PENDING_IF = false
    PENDING_MATCH = false
    // Reset param alloca globals
    CG_PA_NAMES = ""
    CG_PA_0 = null
    CG_PA_1 = null
    CG_PA_2 = null
    CG_PA_3 = null
    CG_PA_4 = null
    CG_PA_5 = null
    CG_PA_6 = null
    CG_PA_7 = null
    cg_reinit_types()

    // Set self type for method desugaring (C-side, immune to global assignment bugs)
    // Check if first param is "self" and set its type
    if pc > 0 {
        let first_pname = forge_param_name_get(param_offset)
        let first_ptype = forge_param_type_get(param_offset)
        if first_pname == "self" {
            forge_set_self_type(first_ptype)
            // Register self's struct type for member access resolution
            forge_struct_var_add("self", first_ptype)
        } else {
            forge_set_self_type("")
        }
    } else {
        forge_set_self_type("")
    }

    // Parse and emit function body — statement at a time, same scope
    VAR_LIST_INIT_CSV = ""
    mut last_val = llvm.const_int(CG_I64, 0, 0)
    if body_src != "" {
        mut body_lex = lexer_new(body_src)
        let body_tokens = body_lex.tokenize()
        forge_set_token_list(body_tokens)
        forge_parser_set_pos(0)
        mut body_parser = parser_new(body_tokens)
        body_parser.expect_id(102)
        body_parser.skip_newlines()
        while !body_parser.check_id(103) && !body_parser.is_at_end() {
            if llvm.block_has_terminator(CG_B) { break }
            let before = body_parser.pos
            let stmt = body_parser.parse_statement()
            cg_reinit_types()
            if stmt != null {
                last_val = cg.emit_statement(stmt!)
            }
            if body_parser.pos == before { body_parser.advance() }
            body_parser.skip_newlines()
        }
    }

    // Implicit return using last emitted value
    if !llvm.block_has_terminator(CG_B) {
        if is_main {
            llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
        } else {
            llvm.build_ret(CG_B, last_val)
        }
    }
}

// emit_next_fn_body and materialize_struct_types removed — dead code that
// caused LLVM verification errors (FN_BODIES was List<string> but emit_block expects Block).
// Materialize LLVM struct types from registered field info
export fn materialize_struct_types() {
    cg_reinit_types()
    let struct_count = CG_STRUCT_NAMES.length
    mut si = 0
    while si < struct_count {
        let fields = CG_STRUCT_FIELDS[si]
        mut fc = 1
        mut ci = 0
        while ci < fields.length {
            if fields[ci] == "," { fc = fc + 1 }
            ci = ci + 1
        }
        if fields.length == 0 { fc = 0 }
        mut ftn = ""
        if si < CG_STRUCT_FIELD_TYPE_NAMES.length { ftn = CG_STRUCT_FIELD_TYPE_NAMES[si] }
        let fta = llvm.type_array_new(fc)
        if ftn.length > 0 {
            mut fi = 0
            mut ftn_pos = 0
            mut ftn_cur = ""
            while ftn_pos < ftn.length {
                let ch = ftn[ftn_pos]
                if ch == "," {
                    llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
                    fi = fi + 1
                    ftn_cur = ""
                } else {
                    ftn_cur = ftn_cur + ch
                }
                ftn_pos = ftn_pos + 1
            }
            if ftn_cur != "" {
                llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
            }
        } else {
            let field_is_str = CG_STRUCT_FIELD_IS_STR[si]
            mut fi = 0
            mut fis_idx = 0
            while fi < fc {
                mut is_str_field = false
                mut fis_cur = ""
                while fis_idx < field_is_str.length {
                    let fch = field_is_str[fis_idx]
                    fis_idx = fis_idx + 1
                    if fch == "," { break }
                    fis_cur = fis_cur + fch
                }
                if fis_cur == "1" { is_str_field = true }
                if is_str_field {
                    llvm.type_array_set(fta, fi, CG_STR)
                } else {
                    llvm.type_array_set(fta, fi, CG_I64)
                }
                fi = fi + 1
            }
        }
        // Always create/update named struct type
        let sname = CG_STRUCT_NAMES[si]
        mut sty = llvm.get_type_by_name(CG_CTX, sname)
        if sty == null {
            sty = llvm.struct_create_named(CG_CTX, sname)
        }
        // Always set body (updates fields to match resolve_type_to_llvm)
        llvm.struct_set_body(sty, fta, fc, 0)
        llvm.type_array_free(fta)
        CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(sname)
        CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
        CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(CG_STRUCT_FIELD_IS_STR[si])
        CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(ftn)
        CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(sty)
        // Update C-side registry with LLVM type
        forge_struct_reg_set_llvm_type(sname, sty)
        si = si + 1
    }
    // Second pass: create LLVM types for structs in C-side registry that were
    // missed by the Forge list (list corruption drops entries after ~40 items)
    let c_count = forge_struct_reg_count()
    mut ci = 0
    while ci < c_count {
        let cname = forge_struct_reg_get_name(ci)
        // Check if type ALREADY exists with the CORRECT name
        cg_reinit_types()
        let existing = llvm.get_type_by_name(CG_CTX, cname)
        let reg_ty = forge_struct_reg_get_llvm_type(ci)
        if existing != null && existing == reg_ty {
            ci = ci + 1
            continue
        }
        if existing != null && existing != reg_ty {
            eprintln("  [mat2-mismatch] " + cname + " existing!=reg_ty")
        }
        if existing == null && reg_ty != null {
            eprintln("  [mat2-missing] " + cname + " has reg_ty but no named type")
        }
        if existing == null && reg_ty == null {
            eprintln("  [mat2-new] " + cname + " needs creation")
        }
        if existing != null && reg_ty == null {
            // Found by name but not in registry — update registry and skip
            forge_struct_reg_set_llvm_type(cname, existing)
            ci = ci + 1
            continue
        }
        // Type needs to be created (or recreated with correct name)
        // Create from field type names
        let cftn = forge_struct_reg_get_field_types(ci)
        let cfields = forge_struct_reg_get_fields(ci)
        // Count fields
        mut cfc = 1
        mut cci = 0
        while cci < cfields.length {
            if cfields[cci] == "," { cfc = cfc + 1 }
            cci = cci + 1
        }
        if cfields.length == 0 { cfc = 0 }
        if cfc > 0 {
            let cfta = llvm.type_array_new(cfc)
            if cftn.length > 0 {
                mut cfi = 0
                mut cftn_pos = 0
                mut cftn_cur = ""
                while cftn_pos < cftn.length {
                    let cch = cftn[cftn_pos]
                    if cch == "," {
                        cg_reinit_types()
                        llvm.type_array_set(cfta, cfi, resolve_type_to_llvm(cftn_cur))
                        cfi = cfi + 1
                        cftn_cur = ""
                    } else {
                        cftn_cur = cftn_cur + cch
                    }
                    cftn_pos = cftn_pos + 1
                }
                if cftn_cur != "" {
                    cg_reinit_types()
                    llvm.type_array_set(cfta, cfi, resolve_type_to_llvm(cftn_cur))
                }
            } else {
                // No field type names — use i64 for all fields
                mut cfi = 0
                while cfi < cfc {
                    llvm.type_array_set(cfta, cfi, CG_I64)
                    cfi = cfi + 1
                }
            }
            eprintln("  [mat2-create] " + cname + " fc=" + string(cfc))
            mut csty = llvm.get_type_by_name(CG_CTX, cname)
            if csty == null { csty = llvm.struct_create_named(CG_CTX, cname) }
            llvm.struct_set_body(csty, cfta, cfc, 0)
            llvm.type_array_free(cfta)
            forge_struct_reg_set_llvm_type(cname, csty)
            // Also add to Forge lists for compatibility
            CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(cname)
            CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(cfields)
            CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push("")
            CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(cftn)
            CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(csty)
        }
        ci = ci + 1
    }
    // Sync all registry type pointers with canonical LLVM pointers.
    // materialize_struct_types may create types that get a different pointer
    // than LLVMTypeOf returns later. This ensures pointer identity.
    forge_struct_reg_sync_types(CG_CTX)
}

// Emit ALL function bodies — single pass: declare + re-parse + emit each function
export fn emit_all_fn_bodies(cg: Codegen) {
    // Re-init LLVM types (globals get zeroed somewhere between init and here)
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
    let struct_count = CG_STRUCT_NAMES.length
    mut si = 0
    while si < struct_count {
        // Always create LLVM type (null check on List<ptr> unreliable)
        if true {
            // Count fields from field names string
            let fields = CG_STRUCT_FIELDS[si]
            mut fc = 1
            mut ci = 0
            while ci < fields.length {
                if fields[ci] == "," { fc = fc + 1 }
                ci = ci + 1
            }
            if fields.length == 0 { fc = 0 }
            // Create struct type with correct field types using field type names
            mut ftn = ""
            if si < CG_STRUCT_FIELD_TYPE_NAMES.length { ftn = CG_STRUCT_FIELD_TYPE_NAMES[si] }
            let fta = llvm.type_array_new(fc)
            if ftn.length > 0 {
                // Use field type names for proper type resolution
                mut fi = 0
                mut ftn_pos = 0
                mut ftn_cur = ""
                while ftn_pos < ftn.length {
                    let ch = ftn[ftn_pos]
                    if ch == "," {
                        llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
                        fi = fi + 1
                        ftn_cur = ""
                    } else {
                        ftn_cur = ftn_cur + ch
                    }
                    ftn_pos = ftn_pos + 1
                }
                if ftn_cur != "" {
                    llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
                }
            } else {
                // Fallback: use field_is_str (legacy path)
                let field_is_str = CG_STRUCT_FIELD_IS_STR[si]
                mut fi = 0
                mut fis_idx = 0
                while fi < fc {
                    mut is_str_field = false
                    mut fis_cur = ""
                    while fis_idx < field_is_str.length {
                        let fch = field_is_str[fis_idx]
                        fis_idx = fis_idx + 1
                        if fch == "," { break }
                        fis_cur = fis_cur + fch
                    }
                    if fis_cur == "1" { is_str_field = true }
                    if is_str_field {
                        llvm.type_array_set(fta, fi, CG_STR)
                    } else {
                        llvm.type_array_set(fta, fi, CG_I64)
                    }
                    fi = fi + 1
                }
            }
            // Use named struct type — reuse existing to preserve pointer identity
            mut sty = llvm.get_type_by_name(CG_CTX, CG_STRUCT_NAMES[si])
            if sty == null { sty = llvm.struct_create_named(CG_CTX, CG_STRUCT_NAMES[si]) }
            llvm.struct_set_body(sty, fta, fc, 0)
            llvm.type_array_free(fta)
            // Re-register with LLVM type
            CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(CG_STRUCT_NAMES[si])
            CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
            CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(CG_STRUCT_FIELD_IS_STR[si])
            CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(ftn)
            CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(sty)
        }
        si = si + 1
    }

    mut param_offset = 0
    mut i = 0
    let eafb_total = forge_fn_store_count()
    while i < eafb_total {
        let name = forge_fn_store_get_name(i)
        let body_src = forge_fn_store_get_body(i)
        let is_main = name == "main"
        mut pc = 0
        if i < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[i] }

        // Declare the LLVM function with correct param types
        let param_arr = llvm.type_array_new(pc)
        mut pi = 0
        while pi < pc {
            let pt_idx = param_offset + pi
            mut param_ty = CG_I64
            let type_name = forge_param_type_get(pt_idx)
            if type_name != "" {
                param_ty = resolve_type_to_llvm(type_name)
            }
            llvm.type_array_set(param_arr, pi, param_ty)
            pi = pi + 1
        }
        // Determine return type — use C-side registry (immune to list corruption)
        mut ret_ty = CG_I64
        if is_main { ret_ty = CG_I32 }
        mut fn_is_nullable = false
        mut fn_nullable_inner = CG_I64
        if !is_main {
            mut rtn = forge_fn_reg_get_ret(name)
            if rtn == "" && i < FN_RETURN_TYPES.length { rtn = FN_RETURN_TYPES[i] }
            // Check for nullable return type (ends with ?)
            let rtn_len = rtn.length
            if rtn_len > 1 { if rtn[rtn_len - 1] == "?" {
                fn_is_nullable = true
                rtn = rtn.substring(0, rtn_len - 1)
            } }
            if rtn == "string" {
                fn_nullable_inner = CG_STR
                ret_ty = CG_STR
            } else if rtn != "" {
                ret_ty = resolve_type_to_llvm(rtn)
            }
            // If nullable, create the {i8, T} struct type as the actual return type
            if fn_is_nullable {
                fn_nullable_inner = ret_ty
                ret_ty = make_nullable_type(ret_ty)
            }
        }
        let fn_type = llvm.function_type(ret_ty, param_arr, pc, 0)
        llvm.type_array_free(param_arr)
        let fn_val = llvm.add_function(CG_MOD, name, fn_type)
        DECLARED_FNS[name] = fn_val

        // Per-file mode: skip body for functions from other files (extern declaration only)
        if EMIT_FILE_IDX >= 0 {
            if i < FN_FILE_INDEX.length {
                if FN_FILE_INDEX[i] != EMIT_FILE_IDX {
                    param_offset = param_offset + pc
                    i = i + 1
                    continue
                }
            }
        }

        cg.current_fn = fn_val

        let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
        llvm.position_at_end(CG_B, entry)

        // Set scope boundary: emit_ident should only find globals + current function's vars
        CG_VAR_SCOPE_START = CG_VAR_NAMES.length
        // Clear per-function type tracking (prevents cross-function contamination)

        // Reset type tracking flags BEFORE param definition

        // Define params with correct types
        pi = 0
        while pi < pc {
            let pt_idx = param_offset + pi
            let pname = forge_param_name_get(pt_idx)
            let param_val = llvm.get_param(fn_val, pi)
            mut param_type_name = forge_param_type_get(pt_idx)
            if param_type_name == "" { param_type_name = "int" }
            // Define param — alloca + store with correct LLVM type
            // Determine the LLVM alloca type: string, struct, or i64
            mut p_ty = CG_I64
            mut is_struct_param = false
            if param_type_name == "string" {
                p_ty = CG_STR
            } else if param_type_name != "int" && param_type_name != "float" && param_type_name != "bool" && param_type_name != "ptr" {
                // Potential struct or enum type — resolve LLVM type
                let resolved = resolve_type_to_llvm(param_type_name)
                if resolved != null {
                    p_ty = resolved
                    is_struct_param = true
                }
            }
            forge_set_alloca_name(pname)
            let alloca = llvm.build_alloca(CG_B, p_ty, pname)
            forge_alloca_cache_set_type(pname, p_ty)
            llvm.build_store(CG_B, param_val, alloca)
            mut param_vty2 = "i64"
            if p_ty == CG_STR { param_vty2 = "%ForgeString" }
            else if p_ty == CG_PTR { param_vty2 = "ptr" }
            else if is_struct_param { param_vty2 = "%" + param_type_name }
            forge_var_type_set(pname, param_type_name)
            CG_VAR_NAMES = CG_VAR_NAMES.push(pname)
            mut _vis2 = 0
            if param_type_name == "string" { _vis2 = 1 }
            CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
            // Register struct/enum-typed params for member access and type tracking
            if is_struct_param {
                forge_struct_var_add(pname, param_type_name)
                // Check if this is an enum type (has data-carrying variants)
                let emf = cg_enum_max_fields(param_type_name)
                if emf > 0 {
                    // Enum type
                } else {
                    // Struct type — get field info
                    mut field_info = ""
                    mut sri = CG_STRUCT_FIELDS.length - 1
                    while sri >= 0 {
                        if CG_STRUCT_NAMES[sri] == param_type_name {
                            field_info = CG_STRUCT_FIELDS[sri]
                            break
                        }
                        sri = sri - 1
                    }
                }
            }
            pi = pi + 1
        }
        param_offset = param_offset + pc

        // Reset type tracking flags before each function body

        // Set nullable return tracking for this function
        CG_FN_RETURNS_NULLABLE = 0
        if fn_is_nullable { CG_FN_RETURNS_NULLABLE = 1 }
        CG_FN_NULLABLE_INNER_TY = fn_nullable_inner
        CG_FN_NULLABLE_RET_TY = null
        if fn_is_nullable { CG_FN_NULLABLE_RET_TY = ret_ty }

        // Re-lex and re-parse the body source text
        // CG_ACTIVE stays true for control flow (if/else, while, for) that emits inline.
        // Returns, assignments, and expressions use proper AST via emit_block.
        mut last_val2 = llvm.const_int(CG_I64, 0, 0)
        if body_src != "" {
            mut body_lex = lexer_new(body_src)
            let body_tokens = body_lex.tokenize()
            forge_set_token_list(body_tokens)
            forge_parser_set_pos(0)
            mut body_parser = parser_new(body_tokens)
            body_parser.expect_id(102)
            body_parser.skip_newlines()
            while !body_parser.check_id(103) && !body_parser.is_at_end() {
                if llvm.block_has_terminator(CG_B) { break }
                let before2 = body_parser.pos
                let stmt = body_parser.parse_statement()
                cg_reinit_types()
                if stmt != null {
                    last_val2 = cg.emit_statement(stmt!)
                }
                if body_parser.pos == before2 { body_parser.advance() }
                body_parser.skip_newlines()
            }
        }

        // Implicit return using last emitted value
        if !llvm.block_has_terminator(CG_B) {
            if is_main {
                llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
            } else {
                llvm.build_ret(CG_B, last_val2)
            }
        }
        // Reset nullable tracking
        CG_FN_RETURNS_NULLABLE = 0
        CG_FN_NULLABLE_INNER_TY = null
        CG_FN_NULLABLE_RET_TY = null
        i = i + 1
    }
}

// Emit a single function body (called from codegen's emit_statement via dispatch)
export fn emit_fn_body(cg: Codegen, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!
    let name = data.name
    let is_main = name == "main"

    // Get function from global map (struct fields don't survive pass-by-value)
    if !DECLARED_FNS.has(name) { return }
    let fn_val = DECLARED_FNS[name]
    cg.current_fn = fn_val

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    // Define params as local variables using flat param name list
    // Find param offset: sum of param counts for functions before this one
    mut param_offset = 0
    mut fi = 0
    let fpn_total = forge_fn_store_count()
    while fi < fpn_total {
        if forge_fn_store_get_name(fi) == name { break }
        if fi < FN_PARAM_COUNTS.length {
            param_offset = param_offset + FN_PARAM_COUNTS[fi]
        }
        fi = fi + 1
    }
    mut pc = 0
    if fi < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[fi] }
    mut pi = 0
    while pi < pc {
        let pt_idx = param_offset + pi
        let pname = forge_param_name_get(pt_idx)
        let param_val = llvm.get_param(fn_val, pi)
        let param_type_name = forge_param_type_get(pt_idx)
        if param_type_name != "" && param_type_name != "int" && param_type_name != "bool" {
            let resolved = resolve_type_to_llvm(param_type_name)
            cg.define_var(pname, tv_typed(param_val, resolved, param_type_name))
        } else {
            cg.define_var(pname, tv_int(param_val))
        }
        pi = pi + 1
    }

    cg.emit_block(data.body)

    if is_main {
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    } else {
        llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
    }
}

fn emit_fn_data(cg: Codegen, data: FnDeclData) {
    let is_main = data.name == "main"
    let param_arr = llvm.type_array_new(data.params.length)
    mut i = 0
    for param in data.params {
        llvm.type_array_set(param_arr, i, CG_I64)
        i = i + 1
    }
    mut ret_ty = CG_I64
    if is_main { ret_ty = CG_I32 }
    let fn_type = llvm.function_type(ret_ty, param_arr, data.params.length, 0)
    llvm.type_array_free(param_arr)

    let fn_val = llvm.add_function(CG_MOD, data.name, fn_type)
    cg.functions[data.name] = fn_val
    cg.current_fn = fn_val

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    i = 0
    for param in data.params {
        let param_val = llvm.get_param(fn_val, i)
        cg.define_var(param.name, tv_int(param_val))
        i = i + 1
    }

    cg.emit_block(data.body)

    if is_main {
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    } else {
        llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
    }
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "functions", ... })
reg_parser("fn", parse_fn)
reg_parser("export", parse_export)
reg_check_stmt("functions", check_fn)
reg_emit_stmt("functions", emit_fn)
reg_top_level("functions", top_level_fn)
