// ─── Functions Feature ─────────────────────────
// Handles: fn declarations and export fn.
// Side table stores FnDeclData keyed by node_id.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr, parser_new}
use lexer.{lexer_new}
use checker.TypeChecker
use codegen.{Codegen, CG_ACTIVE, CG_ENUM_TYPE_CSV, CG_LAST_IS_STR, CG_LAST_IS_MAP, CG_HAS_LAST_VAL, CG_IS_MAP_INDEX, CG_LAST_STRUCT_TYPE, CG_LAST_IS_NULLABLE, CG_LAST_ENUM_TYPE, CG_ENUM_VAR_CSV, CG_STR_VAR_NAMES, CG_STRUCT_NAMES, CG_STRUCT_FIELDS, CG_STRUCT_FIELD_IS_STR, CG_STRUCT_FIELD_TYPE_NAMES, CG_STRUCT_TYPES, CG_STRUCT_VAR_NAMES, CG_STRUCT_VAR_TYPES, CG_STRUCT_VAR_FIELDS, CG_CTX, CG_STR, CG_I64, CG_I8, CG_VAR_SCOPE_START, CG_FN_RETURNS_NULLABLE, CG_FN_NULLABLE_INNER_TY, CG_FN_NULLABLE_RET_TY, make_nullable_type, wrap_nullable, make_null_value, cg_enum_max_fields, cg_make_enum_type, resolve_type_to_llvm}
use features.variables.{parse_var_binding, VarKind, IN_FUNCTION_BODY}
use features.structs.{parse_type_decl}
use features.enums.{parse_enum_decl}
use features.while_loops.PARSE_END_POS
use parser.{LAST_PARAM_TYPE_NAME, PARSED_PARAM_TYPES}

// ─── Side Table ──────────────────────────────────

mut FN_DECLS: Map<string, FnDeclData> = {}

// ─── Data Types ──────────────────────────────────

type FnDeclData = {
    name: string,
    type_params: List<string>,
    params: List<Param>,
    return_type: TypeExpr?,
    body: Block,
    exported: bool,
    span: Span,
}

fn get_fn_decl(node_id: int) -> FnDeclData? {
    let key = "${node_id}"
    if FN_DECLS.has(key) { FN_DECLS[key] } else { null }
}

// ─── Parse ──────────────────────────────────────

fn parse_fn_decl(p: Parser, exported: bool) -> Statement? {
    let start = p.advance().span // consume 'fn'

    let name = p.expect_ident()
    if name == "" { return null }

    let type_params = p.parse_type_params()
    let params = p.parse_params()

    mut return_type_name = ""
    let return_type = if p.check(TokenKind.Arrow) {
        p.advance()
        // Capture return type name
        let ret_tok = p.peek()
        if ret_tok.kind_id == 1 {
            return_type_name = ret_tok.text
        }
        let parsed_ret = p.parse_type_expr()
        // Check if the parsed type is Nullable (T?) and update return_type_name
        if parsed_ret != null {
            match parsed_ret! {
                .Nullable(inner, span) -> {
                    // Append ? to signal nullable return
                    return_type_name = return_type_name + "?"
                }
                _ -> {}
            }
        }
        parsed_ret
    } else { null }

    // Capture body source by reconstructing from token positions
    // Use raw source between the { and } tokens (span-based extraction)
    let block_open_span = p.peek().span  // span of the {
    IN_FUNCTION_BODY = 1
    let body = p.parse_block()
    IN_FUNCTION_BODY = 0
    // The } token was consumed by parse_block, so peek_at(-1) is the }
    // Use the source positions: from block_open to current position
    let block_close_end = if p.pos > 0 { p.tokens[p.pos - 1].span.end } else { block_open_span.end }
    let body_src = if p.source.length > 0 && block_close_end > block_open_span.start {
        p.source.substring(block_open_span.start, block_close_end + 1)
    } else { "" }

    // Store for codegen — name, body, param count, names, types, return type
    store_fn_source(name, body_src)
    store_fn_param_count(params.length)
    store_fn_return_type(return_type_name)
    // Store param info with type names from PARSED_PARAM_TYPES
    mut pi = 0
    for param in params {
        store_fn_param_name(param.name)
        if pi < PARSED_PARAM_TYPES.length {
            store_fn_param_type(PARSED_PARAM_TYPES[pi])
        } else {
            store_fn_param_type("int")
        }
        pi = pi + 1
    }

    PARSE_END_POS = p.pos
    let id = next_node_id()
    feature_stmt("functions", "fn_decl", id, start)
}

fn parse_fn(p: Parser) -> Statement? { parse_fn_decl(p, false) }

fn parse_export(p: Parser) -> Statement? {
    let start = p.advance().span // consume 'export'

    match p.peek().kind {
        .Fn -> parse_fn_decl(p, true)
        .Let -> parse_var_binding(p, .Let, true)
        .Mut -> parse_var_binding(p, .Mut, true)
        .Const -> parse_var_binding(p, .Const, true)
        .TypeKw -> {
            // export type — treat same as type
            parse_type_decl(p)
        }
        .Enum -> {
            // export enum — treat same as enum
            parse_enum_decl(p)
        }
        .Trait -> {
            // export trait — skip (trait is no-op for codegen)
            p.advance() // consume 'trait'
            p.expect_ident() // trait name
            if p.check(TokenKind.LBrace) {
                p.parse_block() // skip body
            }
            PARSE_END_POS = p.pos
            let id = next_node_id()
            feature_stmt("functions", "noop", id, start)
        }
        _ -> {
            p.error("expected 'fn', 'let', 'mut', or 'const' after 'export'")
            null
        }
    }
}

// ─── Check ──────────────────────────────────────

fn check_fn(tc: TypeChecker, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Build function type
    mut param_types: List<Type> = []
    for param in data.params {
        // TODO: resolve param type from annotation
        param_types = param_types.push(Type.Unknown)
    }
    let ret_type = Type.Void // TODO: resolve from return_type annotation
    let fn_type = Type.Function(param_types, ret_type)

    // Register function in scope
    tc.env.define(data.name, fn_type, false)

    // Check body in new scope
    tc.env.push_scope()
    tc.env.push_return_type(ret_type)

    // Define params in scope
    mut i = 0
    for param in data.params {
        tc.env.define(param.name, param_types[i], param.mutable)
        i = i + 1
    }

    tc.check_block(data.body)
    tc.env.pop_return_type()
    tc.env.pop_scope()
}

fn top_level_fn(tc: TypeChecker, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Pre-register function type for forward references
    mut param_types: List<Type> = []
    for param in data.params {
        param_types = param_types.push(Type.Unknown)
    }
    tc.env.define(data.name, Type.Function(param_types, Type.Void), false)
}

// ─── Emit ───────────────────────────────────────

fn emit_fn(cg: Codegen, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Use globals for LLVM state (bootstrap workaround)
    // main() returns i32, other functions return i64
    let is_main = data.name == "main"

    // Build LLVM function type
    let param_arr = llvm.type_array_new(data.params.length)
    mut i = 0
    for param in data.params {
        llvm.type_array_set(param_arr, i, CG_I64)
        i = i + 1
    }
    let ret_ty = if is_main { CG_I32 } else { CG_I64 }
    let fn_type = llvm.function_type(ret_ty, param_arr, data.params.length, 0)
    llvm.type_array_free(param_arr)

    let fn_val = llvm.add_function(CG_MOD, data.name, fn_type)
    cg.functions[data.name] = fn_val
    cg.current_fn = fn_val

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    // Define params as local variables
    i = 0
    for param in data.params {
        let param_val = llvm.get_param(fn_val, i)
        cg.define_var(param.name, Type.Int, param_val)
        i = i + 1
    }

    // Emit body
    cg.emit_block(data.body)

    // Add implicit return if needed
    if is_main {
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    } else {
        llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
    }
}

// ─── Emit All Functions (bypass enum dispatch) ──

// Global parallel lists for function data (bootstrap can't use Map<string, struct>)
export mut FN_NAMES: List<string> = []
export mut FN_BODY_SOURCES: List<string> = []  // body source text for re-parsing
// FN_BODIES removed — was dead code causing LLVM verification errors
export mut FN_PARAM_COUNTS: List<int> = []     // param count per fn
mut FN_ALL_PARAM_NAMES: List<string> = [] // flat list of ALL param names
mut FN_ALL_PARAM_TYPES: List<string> = [] // flat list of ALL param type names
mut FN_RETURN_TYPES: List<string> = []    // return type name per function
export mut FN_FILE_INDEX: List<int> = []        // which file each function belongs to
export mut CURRENT_FILE_INDEX: int = 0           // set before scanning each file
export mut EMIT_FILE_IDX: int = -1               // -1 = all files, >= 0 = only this file

// Store source text for re-parsing during codegen
export fn store_fn_source(name: string, body_source: string) {
    FN_NAMES = FN_NAMES.push(name)
    FN_BODY_SOURCES = FN_BODY_SOURCES.push(body_source)
    FN_FILE_INDEX = FN_FILE_INDEX.push(CURRENT_FILE_INDEX)
}

export fn store_fn_param_count(count: int) {
    FN_PARAM_COUNTS = FN_PARAM_COUNTS.push(count)
}

export fn store_fn_param_name(name: string) {
    FN_ALL_PARAM_NAMES = FN_ALL_PARAM_NAMES.push(name)
}

export fn store_fn_param_type(type_name: string) {
    FN_ALL_PARAM_TYPES = FN_ALL_PARAM_TYPES.push(type_name)
}

export fn store_fn_return_type(type_name: string) {
    FN_RETURN_TYPES = FN_RETURN_TYPES.push(type_name)
}

// Global function map (bootstrap workaround: Codegen.functions passed by value loses data)
mut DECLARED_FNS: Map<string, ptr> = {}

// Declare all functions (signatures only, no bodies) so forward calls work
export fn declare_all_functions(cg: Codegen) {
    mut i = 0
    while i < FN_NAMES.length {
        let name = FN_NAMES[i]
        let is_main = name == "main"
        let pc = if i < FN_PARAM_COUNTS.length { FN_PARAM_COUNTS[i] } else { 0 }
        let param_arr = llvm.type_array_new(pc)
        mut pi = 0
        while pi < pc {
            llvm.type_array_set(param_arr, pi, CG_I64)
            pi = pi + 1
        }
        let ret_ty = if is_main { CG_I32 } else { CG_I64 }
        let fn_type = llvm.function_type(ret_ty, param_arr, pc, 0)
        llvm.type_array_free(param_arr)
        let fn_val = llvm.add_function(CG_MOD, name, fn_type)
        cg.functions[name] = fn_val
        DECLARED_FNS[name] = fn_val
        i = i + 1
    }
}

// Phase 1: Declare all functions with proper types (called before any body emission)
export fn declare_all_fns() {
    // Re-init LLVM types (globals may get zeroed)
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
    // List uses same type as string: %ForgeString = {ptr, i64}
    CG_LIST = CG_STR
    // Create struct LLVM types
    let struct_count = CG_STRUCT_NAMES.length
    mut si = 0
    while si < struct_count {
        let fields = CG_STRUCT_FIELDS[si]
        mut fc = 1
        mut ci = 0
        while ci < fields.length {
            if fields[ci] == "," { fc = fc + 1 }
            ci = ci + 1
        }
        if fields.length == 0 { fc = 0 }
        let ftn = if si < CG_STRUCT_FIELD_TYPE_NAMES.length { CG_STRUCT_FIELD_TYPE_NAMES[si] } else { "" }
        let fta = llvm.type_array_new(fc)
        if ftn.length > 0 {
            mut fi = 0
            mut ftn_pos = 0
            mut ftn_cur = ""
            while ftn_pos < ftn.length {
                let ch = ftn[ftn_pos]
                if ch == "," {
                    llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
                    fi = fi + 1
                    ftn_cur = ""
                } else {
                    ftn_cur = ftn_cur + ch
                }
                ftn_pos = ftn_pos + 1
            }
            if ftn_cur != "" {
                llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
            }
        } else {
            mut fi = 0
            while fi < fc {
                llvm.type_array_set(fta, fi, CG_I64)
                fi = fi + 1
            }
        }
        let sty = llvm.struct_create_named(CG_CTX, CG_STRUCT_NAMES[si])
        llvm.struct_set_body(sty, fta, fc, 0)
        llvm.type_array_free(fta)
        CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(CG_STRUCT_NAMES[si])
        CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
        CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(CG_STRUCT_FIELD_IS_STR[si])
        CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(ftn)
        CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(sty)
        si = si + 1
    }
    // Declare all function signatures — use i64 for all params/returns
    // (bootstrap: resolve_type_to_llvm may return null for complex types)
    mut param_offset = 0
    mut i = 0
    while i < FN_NAMES.length {
        let name = FN_NAMES[i]
        let is_main = name == "main"
        let pc = if i < FN_PARAM_COUNTS.length { FN_PARAM_COUNTS[i] } else { 0 }
        let param_arr = llvm.type_array_new(pc)
        mut pi = 0
        while pi < pc {
            let pt_idx = param_offset + pi
            mut param_ty = CG_I64
            if pt_idx < FN_ALL_PARAM_TYPES.length {
                let tname = FN_ALL_PARAM_TYPES[pt_idx]
                let resolved = resolve_type_to_llvm(tname)
                if resolved != null { param_ty = resolved }
            }
            llvm.type_array_set(param_arr, pi, param_ty)
            pi = pi + 1
        }
        mut ret_ty = CG_I64
        if is_main { ret_ty = CG_I32 }
        if !is_main && i < FN_RETURN_TYPES.length {
            let rtn = FN_RETURN_TYPES[i]
            if rtn == "string" { ret_ty = CG_STR }
            else if rtn != "" {
                let resolved = resolve_type_to_llvm(rtn)
                if resolved != null { ret_ty = resolved }
            }
        }
        let fn_type = llvm.function_type(ret_ty, param_arr, pc, 0)
        llvm.type_array_free(param_arr)
        let fn_val = llvm.add_function(CG_MOD, name, fn_type)
        DECLARED_FNS[name] = fn_val
        param_offset = param_offset + pc
        i = i + 1
    }
}

// Emit a single function body from source — called per-function (no re-declaration)
export fn emit_fn_body_from_source(cg: Codegen, idx: int, param_offset: int) {
    let name = FN_NAMES[idx]
    let body_src = FN_BODY_SOURCES[idx]
    let is_main = name == "main"
    let pc = if idx < FN_PARAM_COUNTS.length { FN_PARAM_COUNTS[idx] } else { 0 }

    // Use LLVM lookup (avoids map ptr-as-i64 corruption)
    let fn_val = llvm.get_named_function(CG_MOD, name)
    if fn_val == null { return }
    cg.current_fn = fn_val
    // Re-init types (may get zeroed between functions)
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    CG_VAR_SCOPE_START = CG_VAR_NAMES.length
    CG_STR_VAR_NAMES = []
    CG_STRUCT_VAR_NAMES = []
    CG_STRUCT_VAR_TYPES = []
    CG_STRUCT_VAR_FIELDS = []
    CG_LAST_IS_STR = 0
    CG_LAST_IS_MAP = 0
    CG_HAS_LAST_VAL = 0
    CG_IS_MAP_INDEX = 0
    CG_LAST_STRUCT_TYPE = ""

    // Define params
    mut pi = 0
    while pi < pc {
        let pname = FN_ALL_PARAM_NAMES[param_offset + pi]
        let param_val = llvm.get_param(fn_val, pi)
        let pt_idx = param_offset + pi
        mut param_type_name = "int"
        if pt_idx < FN_ALL_PARAM_TYPES.length {
            param_type_name = FN_ALL_PARAM_TYPES[pt_idx]
        }
        let is_struct_param = param_type_name != "int" && param_type_name != "string" && param_type_name != "float" && param_type_name != "bool" && param_type_name != "ptr"
        mut p_ty = if param_type_name == "string" { CG_STR } else { CG_I64 }
        if is_struct_param {
            let resolved = resolve_type_to_llvm(param_type_name)
            if resolved != null && resolved != CG_I64 { p_ty = resolved }
        }
        let alloca = llvm.build_alloca(CG_B, p_ty, pname)
        llvm.build_store(CG_B, param_val, alloca)
        CG_VAR_NAMES = CG_VAR_NAMES.push(pname)
        CG_VAR_IS_STR = CG_VAR_IS_STR.push(if param_type_name == "string" { 1 } else { 0 })
        CG_VAR_IS_MAP = CG_VAR_IS_MAP.push(0)
        CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
        // String and List share {ptr, i64} — register in CG_STR_VAR_NAMES so emit_ident loads correctly
        if param_type_name == "string" {
            CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(pname)
        } else if param_type_name.length >= 4 {
            if param_type_name[0] == "L" { CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(pname) }
        }
        if is_struct_param {
            let emf = cg_enum_max_fields(param_type_name)
            // Check if type is a known enum (any payload size)
            let enum_needle = "," + param_type_name + ":"
            let is_enum = CG_ENUM_TYPE_CSV.index_of(enum_needle) >= 0
            if is_enum {
                CG_ENUM_VAR_CSV = CG_ENUM_VAR_CSV + "," + pname + ":" + param_type_name + ","
            } else {
                CG_STRUCT_VAR_NAMES = CG_STRUCT_VAR_NAMES.push(pname)
                CG_STRUCT_VAR_TYPES = CG_STRUCT_VAR_TYPES.push(param_type_name)
                mut field_info = ""
                mut sri = CG_STRUCT_FIELDS.length - 1
                while sri >= 0 {
                    if CG_STRUCT_NAMES[sri] == param_type_name {
                        field_info = CG_STRUCT_FIELDS[sri]
                        break
                    }
                    sri = sri - 1
                }
                CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push(field_info)
            }
        }
        pi = pi + 1
    }

    CG_LAST_IS_STR = 0
    CG_LAST_IS_MAP = 0
    CG_HAS_LAST_VAL = 0
    CG_IS_MAP_INDEX = 0
    CG_LAST_STRUCT_TYPE = ""
    CG_LAST_IS_NULLABLE = 0
    PENDING_IF = false
    PENDING_MATCH = false

    // Pure AST parse then emit
    if body_src != "" {
        CG_ACTIVE = false
        mut body_lex = lexer_new(body_src)
        let body_tokens = body_lex.tokenize()
        mut body_parser = parser_new(body_tokens)
        let body = body_parser.parse_block()
        CG_ACTIVE = true
        let last = cg.emit_block(body)
        CG_LAST_VAL = last
        CG_HAS_LAST_VAL = 1
    }

    // Implicit return
    if !llvm.block_has_terminator(CG_B) {
        if is_main {
            llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
        } else if CG_HAS_LAST_VAL == 1 {
            CG_HAS_LAST_VAL = 0
            llvm.build_ret(CG_B, CG_LAST_VAL)
        } else {
            llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
        }
    }
}

// emit_next_fn_body and materialize_struct_types removed — dead code that
// caused LLVM verification errors (FN_BODIES was List<string> but emit_block expects Block).
// All function emission goes through emit_all_fn_bodies which re-parses from source text.

// Emit ALL function bodies — single pass: declare + re-parse + emit each function
export fn emit_all_fn_bodies(cg: Codegen) {
    // Re-init LLVM types (globals get zeroed somewhere between init and here)
    CG_I64 = llvm.int64_type(CG_CTX)
    CG_I32 = llvm.int32_type(CG_CTX)
    CG_I8 = llvm.int8_type(CG_CTX)
    let struct_count = CG_STRUCT_NAMES.length
    mut si = 0
    while si < struct_count {
        // Always create LLVM type (null check on List<ptr> unreliable)
        if true {
            // Count fields from field names string
            let fields = CG_STRUCT_FIELDS[si]
            mut fc = 1
            mut ci = 0
            while ci < fields.length {
                if fields[ci] == "," { fc = fc + 1 }
                ci = ci + 1
            }
            if fields.length == 0 { fc = 0 }
            // Create struct type with correct field types using field type names
            let ftn = if si < CG_STRUCT_FIELD_TYPE_NAMES.length { CG_STRUCT_FIELD_TYPE_NAMES[si] } else { "" }
            let fta = llvm.type_array_new(fc)
            if ftn.length > 0 {
                // Use field type names for proper type resolution
                mut fi = 0
                mut ftn_pos = 0
                mut ftn_cur = ""
                while ftn_pos < ftn.length {
                    let ch = ftn[ftn_pos]
                    if ch == "," {
                        llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
                        fi = fi + 1
                        ftn_cur = ""
                    } else {
                        ftn_cur = ftn_cur + ch
                    }
                    ftn_pos = ftn_pos + 1
                }
                if ftn_cur != "" {
                    llvm.type_array_set(fta, fi, resolve_type_to_llvm(ftn_cur))
                }
            } else {
                // Fallback: use field_is_str (legacy path)
                let field_is_str = CG_STRUCT_FIELD_IS_STR[si]
                mut fi = 0
                mut fis_idx = 0
                while fi < fc {
                    mut is_str_field = false
                    mut fis_cur = ""
                    while fis_idx < field_is_str.length {
                        let fch = field_is_str[fis_idx]
                        fis_idx = fis_idx + 1
                        if fch == "," { break }
                        fis_cur = fis_cur + fch
                    }
                    if fis_cur == "1" { is_str_field = true }
                    if is_str_field {
                        llvm.type_array_set(fta, fi, CG_STR)
                    } else {
                        llvm.type_array_set(fta, fi, CG_I64)
                    }
                    fi = fi + 1
                }
            }
            // Use named struct type (like Rust) for proper LLVM ARM64 ABI handling
            let sty = llvm.struct_create_named(CG_CTX, CG_STRUCT_NAMES[si])
            llvm.struct_set_body(sty, fta, fc, 0)
            llvm.type_array_free(fta)
            // Re-register with LLVM type
            CG_STRUCT_NAMES = CG_STRUCT_NAMES.push(CG_STRUCT_NAMES[si])
            CG_STRUCT_FIELDS = CG_STRUCT_FIELDS.push(fields)
            CG_STRUCT_FIELD_IS_STR = CG_STRUCT_FIELD_IS_STR.push(CG_STRUCT_FIELD_IS_STR[si])
            CG_STRUCT_FIELD_TYPE_NAMES = CG_STRUCT_FIELD_TYPE_NAMES.push(ftn)
            CG_STRUCT_TYPES = CG_STRUCT_TYPES.push(sty)
        }
        si = si + 1
    }

    eprintln("  structs=" + string(struct_count) + " fns=" + string(FN_NAMES.length))
    mut param_offset = 0
    mut i = 0
    while i < FN_NAMES.length {
        let name = FN_NAMES[i]
        let body_src = FN_BODY_SOURCES[i]
        let is_main = name == "main"
        let pc = if i < FN_PARAM_COUNTS.length { FN_PARAM_COUNTS[i] } else { 0 }

        // Declare the LLVM function with correct param types
        let param_arr = llvm.type_array_new(pc)
        mut pi = 0
        while pi < pc {
            // Look up param type — use struct LLVM type if registered
            let pt_idx = param_offset + pi
            mut param_ty = CG_I64
            if pt_idx < FN_ALL_PARAM_TYPES.length {
                let type_name = FN_ALL_PARAM_TYPES[pt_idx]
                param_ty = resolve_type_to_llvm(type_name)
            }
            llvm.type_array_set(param_arr, pi, param_ty)
            pi = pi + 1
        }
        // Determine return type
        mut ret_ty = CG_I64
        if is_main { ret_ty = CG_I32 }
        mut fn_is_nullable = false
        mut fn_nullable_inner = CG_I64
        if !is_main && i < FN_RETURN_TYPES.length {
            mut rtn = FN_RETURN_TYPES[i]
            // Check for nullable return type (ends with ?)
            let rtn_len = rtn.length
            if rtn_len > 1 { if rtn[rtn_len - 1] == "?" {
                fn_is_nullable = true
                rtn = rtn.substring(0, rtn_len - 1)
            } }
            if rtn == "string" {
                fn_nullable_inner = CG_STR
                ret_ty = CG_STR
            } else if rtn != "" {
                ret_ty = resolve_type_to_llvm(rtn)
            }
            // If nullable, create the {i8, T} struct type as the actual return type
            if fn_is_nullable {
                fn_nullable_inner = ret_ty
                ret_ty = make_nullable_type(ret_ty)
            }
        }
        let fn_type = llvm.function_type(ret_ty, param_arr, pc, 0)
        llvm.type_array_free(param_arr)
        let fn_val = llvm.add_function(CG_MOD, name, fn_type)
        DECLARED_FNS[name] = fn_val

        // Per-file mode: skip body for functions from other files (extern declaration only)
        if EMIT_FILE_IDX >= 0 {
            if i < FN_FILE_INDEX.length {
                if FN_FILE_INDEX[i] != EMIT_FILE_IDX {
                    param_offset = param_offset + pc
                    i = i + 1
                    continue
                }
            }
        }

        cg.current_fn = fn_val

        let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
        llvm.position_at_end(CG_B, entry)

        // Set scope boundary: emit_ident should only find globals + current function's vars
        CG_VAR_SCOPE_START = CG_VAR_NAMES.length
        // Clear per-function type tracking (prevents cross-function contamination)
        CG_STR_VAR_NAMES = []
        CG_STRUCT_VAR_NAMES = []
        CG_STRUCT_VAR_TYPES = []
        CG_STRUCT_VAR_FIELDS = []

        // Reset type tracking flags BEFORE param definition
        CG_LAST_IS_STR = 0
        CG_LAST_IS_MAP = 0
        CG_HAS_LAST_VAL = 0
        CG_IS_MAP_INDEX = 0
        CG_LAST_STRUCT_TYPE = ""

        // Define params with correct types
        pi = 0
        while pi < pc {
            let pname = FN_ALL_PARAM_NAMES[param_offset + pi]
            let param_val = llvm.get_param(fn_val, pi)
            let pt_idx = param_offset + pi
            mut param_type_name = "int"
            if pt_idx < FN_ALL_PARAM_TYPES.length {
                param_type_name = FN_ALL_PARAM_TYPES[pt_idx]
            }
            // Define param — alloca + store with correct LLVM type
            // Determine the LLVM alloca type: string, struct, or i64
            mut p_ty = CG_I64
            mut is_struct_param = false
            if param_type_name == "string" {
                p_ty = CG_STR
            } else if param_type_name != "int" && param_type_name != "float" && param_type_name != "bool" && param_type_name != "ptr" {
                // Potential struct or enum type — resolve LLVM type
                let resolved = resolve_type_to_llvm(param_type_name)
                if resolved != null {
                    p_ty = resolved
                    is_struct_param = true
                }
            }
            let alloca = llvm.build_alloca(CG_B, p_ty, pname)
            llvm.build_store(CG_B, param_val, alloca)
            CG_VAR_NAMES = CG_VAR_NAMES.push(pname)
            CG_VAR_IS_STR = CG_VAR_IS_STR.push(if param_type_name == "string" { 1 } else { 0 })
            CG_VAR_IS_MAP = CG_VAR_IS_MAP.push(0)
            CG_VAR_PTRS = CG_VAR_PTRS.push(alloca)
            if param_type_name == "string" { CG_STR_VAR_NAMES = CG_STR_VAR_NAMES.push(pname) }
            // Register struct/enum-typed params for member access and type tracking
            if is_struct_param {
                // Check if this is an enum type (has data-carrying variants)
                let emf = cg_enum_max_fields(param_type_name)
                if emf > 0 {
                    // Enum type — register in CG_ENUM_VAR_CSV for load-time type lookup
                    CG_ENUM_VAR_CSV = CG_ENUM_VAR_CSV + "," + pname + ":" + param_type_name + ","
                } else {
                    // Struct type — register for field access
                    CG_STRUCT_VAR_NAMES = CG_STRUCT_VAR_NAMES.push(pname)
                    CG_STRUCT_VAR_TYPES = CG_STRUCT_VAR_TYPES.push(param_type_name)
                    // Get field info from struct registry
                    mut field_info = ""
                    mut sri = CG_STRUCT_FIELDS.length - 1
                    while sri >= 0 {
                        if CG_STRUCT_NAMES[sri] == param_type_name {
                            field_info = CG_STRUCT_FIELDS[sri]
                            break
                        }
                        sri = sri - 1
                    }
                    CG_STRUCT_VAR_FIELDS = CG_STRUCT_VAR_FIELDS.push(field_info)
                }
            }
            pi = pi + 1
        }
        param_offset = param_offset + pc

        // Reset type tracking flags before each function body
        CG_LAST_IS_STR = 0
        CG_LAST_IS_MAP = 0
        CG_HAS_LAST_VAL = 0
        CG_IS_MAP_INDEX = 0
        CG_LAST_STRUCT_TYPE = ""
        CG_LAST_IS_NULLABLE = 0

        // Set nullable return tracking for this function
        CG_FN_RETURNS_NULLABLE = if fn_is_nullable { 1 } else { 0 }
        CG_FN_NULLABLE_INNER_TY = fn_nullable_inner
        CG_FN_NULLABLE_RET_TY = if fn_is_nullable { ret_ty } else { null }

        // Re-lex and re-parse the body source text
        // CG_ACTIVE stays true for control flow (if/else, while, for) that emits inline.
        // Returns, assignments, and expressions use proper AST via emit_block.
        if body_src != "" {
            mut body_lex = lexer_new(body_src)
            let body_tokens = body_lex.tokenize()
            mut body_parser = parser_new(body_tokens)
            let body = body_parser.parse_block()
            let last = cg.emit_block(body)
            // Only update CG_LAST_VAL if not already set by inline emit (e.g., PHI from if-expr)
            if CG_HAS_LAST_VAL != 1 {
                CG_LAST_VAL = last
                CG_HAS_LAST_VAL = 1
            }
        }

        // Add implicit return only if the block doesn't already terminate
        if !llvm.block_has_terminator(CG_B) {
            if is_main {
                llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
            } else if fn_is_nullable && CG_HAS_LAST_VAL == 1 {
                // Nullable function with a last value
                CG_HAS_LAST_VAL = 0
                // If the last value is already nullable (e.g., null literal), use directly
                if CG_LAST_IS_NULLABLE == 1 {
                    llvm.build_ret(CG_B, CG_LAST_VAL)
                } else {
                    let wrapped_ret = wrap_nullable(fn_nullable_inner, CG_LAST_VAL)
                    llvm.build_ret(CG_B, wrapped_ret)
                }
            } else if fn_is_nullable {
                // Nullable function with no last value — return null
                let null_ret = make_null_value(fn_nullable_inner)
                llvm.build_ret(CG_B, null_ret)
            } else if CG_HAS_LAST_VAL == 1 {
                // Return the last expression value from emit_block
                CG_HAS_LAST_VAL = 0
                llvm.build_ret(CG_B, CG_LAST_VAL)
            } else {
                llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
            }
        }
        // Reset nullable tracking
        CG_FN_RETURNS_NULLABLE = 0
        CG_FN_NULLABLE_INNER_TY = null
        CG_FN_NULLABLE_RET_TY = null
        i = i + 1
    }
}

// Emit a single function body (called from codegen's emit_statement via dispatch)
export fn emit_fn_body(cg: Codegen, node: NodeRef) {
    let d = get_fn_decl(node.node_id)
    if d == null { return }
    let data = d!
    let name = data.name
    let is_main = name == "main"

    // Get function from global map (struct fields don't survive pass-by-value)
    if !DECLARED_FNS.has(name) { return }
    let fn_val = DECLARED_FNS[name]
    cg.current_fn = fn_val

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    // Define params as local variables using flat param name list
    // Find param offset: sum of param counts for functions before this one
    mut param_offset = 0
    mut fi = 0
    while fi < FN_NAMES.length {
        if FN_NAMES[fi] == name { break }
        if fi < FN_PARAM_COUNTS.length {
            param_offset = param_offset + FN_PARAM_COUNTS[fi]
        }
        fi = fi + 1
    }
    let pc = if fi < FN_PARAM_COUNTS.length { FN_PARAM_COUNTS[fi] } else { 0 }
    mut pi = 0
    while pi < pc {
        let pname = FN_ALL_PARAM_NAMES[param_offset + pi]
        let param_val = llvm.get_param(fn_val, pi)
        cg.define_var(pname, Type.Int, param_val)
        pi = pi + 1
    }

    cg.emit_block(data.body)

    if is_main {
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    } else {
        llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
    }
}

fn emit_fn_data(cg: Codegen, data: FnDeclData) {
    let is_main = data.name == "main"
    let param_arr = llvm.type_array_new(data.params.length)
    mut i = 0
    for param in data.params {
        llvm.type_array_set(param_arr, i, CG_I64)
        i = i + 1
    }
    let ret_ty = if is_main { CG_I32 } else { CG_I64 }
    let fn_type = llvm.function_type(ret_ty, param_arr, data.params.length, 0)
    llvm.type_array_free(param_arr)

    let fn_val = llvm.add_function(CG_MOD, data.name, fn_type)
    cg.functions[data.name] = fn_val
    cg.current_fn = fn_val

    let entry = llvm.append_basic_block(CG_CTX, fn_val, "entry")
    llvm.position_at_end(CG_B, entry)

    i = 0
    for param in data.params {
        let param_val = llvm.get_param(fn_val, i)
        cg.define_var(param.name, Type.Int, param_val)
        i = i + 1
    }

    cg.emit_block(data.body)

    if is_main {
        llvm.build_ret(CG_B, llvm.const_int(CG_I32, 0, 0))
    } else {
        llvm.build_ret(CG_B, llvm.const_int(CG_I64, 0, 0))
    }
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "functions", ... })
reg_parser("fn", parse_fn)
reg_parser("export", parse_export)
reg_check_stmt("functions", check_fn)
reg_emit_stmt("functions", emit_fn)
reg_top_level("functions", top_level_fn)
