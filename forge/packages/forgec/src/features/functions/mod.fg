// ─── Functions Feature ─────────────────────────
// Handles: fn declarations and export fn.
// Side table stores FnDeclData keyed by node_id (as string).
// Parse handlers for "fn" and "export" tokens.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, next_node_id}
use core.registry.{register_feature, FeatureRegistration, REGISTRY}
use parser.mod.{Parser, Param, TypeExpr}

// ─── Side Table ──────────────────────────────────

mut FN_DECLS: Map<string, FnDeclData> = {}

// ─── Data Types ──────────────────────────────────

type FnDeclData = {
    name: string,
    type_params: List<string>,
    params: List<Param>,
    return_type: TypeExpr?,
    body: Block,
    exported: bool,
    span: Span,
}

// ─── Lookup Helper ───────────────────────────────

fn get_fn_decl(node_id: int) -> FnDeclData? {
    let key = "${node_id}"
    if FN_DECLS.has(key) {
        FN_DECLS[key]
    } else {
        null
    }
}

// ─── Parse Helpers ───────────────────────────────

fn parse_fn_decl(p: Parser, exported: bool) -> Statement? {
    let start = p.advance().span // consume 'fn'

    // Expect function name
    let name = p.expect_ident()
    if name == null {
        p.error("expected function name after 'fn'")
        return null
    }

    // Optional type parameters: <T, U>
    let type_params = p.parse_type_params()

    // Parameter list: (a: int, b: string)
    let params = p.parse_params()
    if params == null {
        return null
    }

    // Optional return type: -> Type
    let return_type = if p.check(.Arrow) {
        p.advance()
        p.parse_type_expr()
    } else {
        null
    }

    // Function body: { ... }
    let body = p.parse_block()
    if body == null {
        p.error("expected function body")
        return null
    }

    // Store in side table
    let id = next_node_id()
    let key = "${id}"
    FN_DECLS[key] = FnDeclData {
        name: name!,
        type_params,
        params: params!,
        return_type,
        body: body!,
        exported,
        span: start,
    }

    feature_stmt("functions", "fn_decl", id, start)
}

// ─── Parse Handlers ──────────────────────────────

fn parse_fn(ctx: ptr) -> ptr {
    let p = ctx as Parser
    let result = parse_fn_decl(p, false)
    result as ptr
}

fn parse_export(ctx: ptr) -> ptr {
    let p = ctx as Parser
    let start = p.advance().span // consume 'export'
    let tok = p.peek()

    match tok.kind {
        .Fn -> {
            // export fn name(...) { ... }
            let result = parse_fn_decl(p, true)
            result as ptr
        }
        .Let -> {
            // export let name = value
            // Delegate to variables feature
            use features.variables.{parse_var_binding, VarKind}
            let result = parse_var_binding(p, .Let, true)
            result as ptr
        }
        .Mut -> {
            // export mut name = value
            use features.variables.{parse_var_binding, VarKind}
            let result = parse_var_binding(p, .Mut, true)
            result as ptr
        }
        .Const -> {
            // export const name = value
            use features.variables.{parse_var_binding, VarKind}
            let result = parse_var_binding(p, .Const, true)
            result as ptr
        }
        _ -> {
            p.error("expected 'fn', 'let', 'mut', or 'const' after 'export'")
            null as ptr
        }
    }
}

// ─── Registration ────────────────────────────────

register_feature(FeatureRegistration {
    id: "functions",
    name: "Function Declarations",
    status: "wip",
    parse_tokens: ["fn", "export"],
    parse_handlers: [parse_fn, parse_export],
    check_stmt: null,
    check_expr: null,
    emit_stmt: null,
    emit_expr: null,
    top_level: null,
})
