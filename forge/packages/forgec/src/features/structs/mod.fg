// ─── Structs Feature ───────────────────────────
// Handles: type declarations (named structs), struct literals,
// field access. Struct layout is { field1, field2, ... } in LLVM.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, FeatureExpr, feature_stmt, feature_expr, next_node_id}
use core.types.{Type, StructField}
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr, TypeField}
use checker.TypeChecker
use codegen.{Codegen, CG_CTX, CG_B, CG_I64, CG_PTR, CG_STR, CG_LIST, register_struct_type, register_struct_type_full, resolve_type_to_llvm, codegen_new, cg_enum_max_fields, cg_make_enum_type}
use features.while_loops.PARSE_END_POS
use @std.llvm

// ─── Side Tables ────────────────────────────────

mut TYPE_DECLS: Map<string, TypeDeclData> = {}
mut STRUCT_LITS: Map<string, StructLitData> = {}

// ─── Data Types ─────────────────────────────────

type TypeDeclData = {
    name: string,
    type_params: List<string>,
    value: TypeExpr,
    exported: bool,
    span: Span,
}

type StructLitField = {
    name: string,
    value: Expr,
}

type StructLitData = {
    type_name: string,
    fields: List<StructLitField>,
    span: Span,
}

fn get_type_decl(id: int) -> TypeDeclData? {
    let key = "${id}"
    if TYPE_DECLS.has(key) { TYPE_DECLS[key] } else { null }
}

fn get_struct_lit(id: int) -> StructLitData? {
    let key = "${id}"
    if STRUCT_LITS.has(key) { STRUCT_LITS[key] } else { null }
}

// ─── Parse: Type Declaration ────────────────────
// type Name = { field: Type, ... }
// type Name<T> = { field: T, ... }

fn parse_type_decl(p: Parser) -> Statement? {
    let start = p.advance().span // consume 'type'

    let name = p.expect_ident()
    if name == "" {
        p.error("expected type name after 'type'")
        return null
    }

    let type_params = p.parse_type_params()

    if p.expect(TokenKind.Eq) == null {
        p.error("expected '=' in type declaration")
        return null
    }

    // Parse the struct body { field: type, ... }
    if p.check(TokenKind.LBrace) {
        p.advance() // consume {
        p.skip_newlines()

        // Parse fields — store as string info (LLVM types created lazily)
        mut field_names = ""
        mut field_is_str = ""
        mut field_types_str = ""  // comma-separated type names
        mut field_count = 0

        while !p.check(TokenKind.RBrace) && !p.is_at_end() {
            if field_count > 0 {
                field_names = field_names + ","
                field_is_str = field_is_str + ","
                field_types_str = field_types_str + ","
            }
            // Skip optional 'mut' modifier on fields
            if p.check(TokenKind.Mut) { p.advance() }
            let fname = p.expect_ident()
            p.expect(TokenKind.Colon)
            // Parse type — might be generic like List<Token>
            mut ftype_name = p.expect_ident()
            // Capture generic arg for List<T> → store as "List:T"
            if p.check(TokenKind.Lt) {
                p.advance()
                let gen_arg = p.expect_ident()
                // Store as "List:Diagnostic" so element type is recoverable
                if ftype_name == "List" || ftype_name == "Map" {
                    ftype_name = ftype_name + ":" + gen_arg
                }
                // Skip remaining generic args
                mut depth = 1
                while depth > 0 && !p.is_at_end() {
                    if p.check(TokenKind.Lt) { depth = depth + 1 }
                    if p.check(TokenKind.Gt) { depth = depth - 1 }
                    if depth > 0 { p.advance() }
                }
                if p.check(TokenKind.Gt) { p.advance() }
            }
            // Check for nullable ?
            if p.check(TokenKind.Question) { p.advance() }

            if ftype_name == "string" {
                field_is_str = field_is_str + "1"
            } else {
                field_is_str = field_is_str + "0"
            }
            field_names = field_names + fname
            field_types_str = field_types_str + ftype_name
            field_count = field_count + 1

            p.skip_newlines()
            if p.check(TokenKind.Comma) { p.advance() }
            p.skip_newlines()
        }
        p.expect(TokenKind.RBrace)

        // Store field info for lazy LLVM type creation during codegen
        register_struct_type_full(name, field_names, field_is_str, field_types_str, null)
    } else {
        // Non-struct type alias — skip
        let value = p.parse_type_expr()
    }

    PARSE_END_POS = forge_parser_get_pos()
    let id = next_node_id()
    feature_stmt("structs", "type_decl", id, start)
}

// Resolve a type name to its LLVM type for struct fields
fn resolve_field_llvm_type(type_name: string) -> ptr {
    if type_name == "string" { return CG_STR }
    if type_name == "int" { return CG_I64 }
    if type_name == "float" { return CG_I64 }  // float is still i64-sized
    if type_name == "bool" { return CG_I64 }
    if type_name == "ptr" { return CG_I64 }
    // Check if it starts with "List<" — list is {ptr, i64}
    if type_name.length > 5 {
        if type_name[0] == "L" {
            if type_name[1] == "i" {
                if type_name[2] == "s" {
                    if type_name[3] == "t" {
                        return CG_LIST
                    }
                }
            }
        }
    }
    // Check enum type
    let emf = cg_enum_max_fields(type_name)
    if emf > 0 {
        let ety = cg_make_enum_type(type_name)
        if ety != null { return ety }
    }
    // Check struct type via LLVM named types
    let named = llvm.get_type_by_name(CG_CTX, type_name)
    if named != null { return named }
    // Default: i64
    CG_I64
}

// ─── Struct Literal Construction ────────────────
// Called by expression parser when it detects { ident: expr, ... }

fn make_struct_lit(type_name: string, fields: List<StructLitField>, span: Span) -> Expr {
    let id = next_node_id()
    STRUCT_LITS["${id}"] = StructLitData { type_name, fields, span }
    feature_expr("structs", "struct_lit", id, span)
}

// ─── Check ──────────────────────────────────────

fn check_type_decl(tc: TypeChecker, node: NodeRef) {
    let d = get_type_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Resolve struct type from TypeExpr
    match data.value {
        .Struct(fields, _) -> {
            mut struct_fields: List<StructField> = []
            for f in fields {
                // TODO: resolve field type from type_ann
                struct_fields = struct_fields.push(StructField {
                    name: f.name, field_type: Type.Unknown,
                })
            }
            let ty = Type.Struct(data.name, struct_fields)
            tc.env.define(data.name, ty, false)
        }
        _ -> {
            // Type alias (not a struct)
            tc.env.define(data.name, Type.Unknown, false)
        }
    }
}

fn check_struct_lit(tc: TypeChecker, node: NodeRef) -> Type {
    let d = get_struct_lit(node.node_id)
    if d == null { return Type.Unknown }
    let data = d!

    // Infer field types
    mut fields: List<StructField> = []
    for f in data.fields {
        let ft = tc.infer_expr(f.value)
        fields = fields.push(StructField { name: f.name, field_type: ft })
    }

    Type.Struct(data.type_name, fields)
}

fn top_level_type(tc: TypeChecker, node: NodeRef) {
    check_type_decl(tc, node)
}

// ─── Emit ───────────────────────────────────────

fn emit_type_decl(cg: Codegen, node: NodeRef) {
    // Type declarations don't emit code — they define LLVM struct types
}

fn emit_struct_lit(cg: Codegen, node: NodeRef) -> ptr {
    let d = get_struct_lit(node.node_id)
    if d == null { return llvm.const_int(CG_I64, 0, 0) }
    let data = d!

    // Look up the registered LLVM struct type by name
    let struct_ty = resolve_type_to_llvm(data.type_name)
    if struct_ty == CG_I64 { return llvm.const_int(CG_I64, 0, 0) }

    // Build LLVM struct value with insert_value
    mut val = llvm.get_undef(struct_ty)

    mut i = 0
    for f in data.fields {
        let field_val = cg.emit_expr(f.value)
        val = llvm.build_insert_value(CG_B, val, field_val, i, f.name)
        i = i + 1
    }

    // Store in alloca and register as struct variable
    let alloca = llvm.build_alloca(CG_B, struct_ty, data.type_name)
    llvm.build_store(CG_B, val, alloca)

    val
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "structs", ... })
reg_parser("type", parse_type_decl)
reg_check_stmt("structs", check_type_decl)
reg_check_expr("structs", check_struct_lit)
reg_emit_stmt("structs", emit_type_decl)
reg_emit_expr("structs", emit_struct_lit)
reg_top_level("structs", top_level_type)
