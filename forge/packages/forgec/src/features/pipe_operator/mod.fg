// ─── Pipe Operator Feature ────────────────────
// Handles: expr |> fn — pipes left side as first argument to right side.
// Already handled in expression parser's precedence climbing (infix |>).
// No side table — desugared to a function call during parsing or checking.
// Just register metadata.

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "pipe_operator", ... })
