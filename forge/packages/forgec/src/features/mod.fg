// Features for the self-hosted compiler.

mod variables
mod functions
mod operators
mod if_else
mod printing
mod primitive_types
mod enums
mod pattern_matching
mod structs
mod impl_methods
mod while_loops
mod for_loops
mod ranges
mod collections
mod strings
mod string_templates
mod traits
mod modules

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use variables.{parse_let, parse_mut, parse_const, check_var, emit_var, top_level_var}
use functions.{parse_fn, parse_export, check_fn, emit_fn, top_level_fn}
use enums.{parse_enum, check_enum, emit_enum_decl, top_level_enum}
use structs.{parse_type_decl, check_type_decl, check_struct_lit, emit_type_decl, emit_struct_lit, top_level_type}
use traits.{parse_trait, check_trait, top_level_trait}
use impl_methods.{parse_impl, check_impl, emit_impl, top_level_impl}
use modules.{parse_use, check_use, top_level_use}
use while_loops.{parse_while, check_while, emit_while}
use for_loops.{parse_for, check_for, emit_for}
use if_else.{check_if_expr, emit_if_expr}
use pattern_matching.{check_match, emit_match}
use collections.{check_collection, emit_collection}
use ranges.{check_range, emit_range}
use string_templates.{check_template, emit_template}

// All feature registration in one function, called from main()
// (top-level calls don't work in the bootstrap AOT binary)
export fn init_features() {
    // variables
    reg_parser("let", parse_let)
    reg_parser("mut", parse_mut)
    reg_parser("const", parse_const)
    reg_check_stmt("variables", check_var)
    reg_emit_stmt("variables", emit_var)
    reg_top_level("variables", top_level_var)

    // functions
    reg_parser("fn", parse_fn)
    reg_parser("export", parse_export)
    reg_check_stmt("functions", check_fn)
    reg_emit_stmt("functions", emit_fn)
    reg_top_level("functions", top_level_fn)

    // enums
    reg_parser("enum", parse_enum)
    reg_check_stmt("enums", check_enum)
    reg_emit_stmt("enums", emit_enum_decl)
    reg_top_level("enums", top_level_enum)

    // structs
    reg_parser("type", parse_type_decl)
    reg_check_stmt("structs", check_type_decl)
    reg_check_expr("structs", check_struct_lit)
    reg_emit_stmt("structs", emit_type_decl)
    reg_emit_expr("structs", emit_struct_lit)
    reg_top_level("structs", top_level_type)

    // traits
    reg_parser("trait", parse_trait)
    reg_check_stmt("traits", check_trait)
    reg_top_level("traits", top_level_trait)

    // impl_methods
    reg_parser("impl", parse_impl)
    reg_check_stmt("impl_methods", check_impl)
    reg_emit_stmt("impl_methods", emit_impl)
    reg_top_level("impl_methods", top_level_impl)

    // modules
    reg_parser("use", parse_use)
    reg_check_stmt("modules", check_use)
    reg_top_level("modules", top_level_use)

    // while_loops
    reg_parser("while", parse_while)
    reg_check_stmt("while_loops", check_while)
    reg_emit_stmt("while_loops", emit_while)

    // for_loops
    reg_parser("for", parse_for)
    reg_check_stmt("for_loops", check_for)
    reg_emit_stmt("for_loops", emit_for)

    // if_else
    reg_check_expr("if_else", check_if_expr)
    reg_emit_expr("if_else", emit_if_expr)

    // pattern_matching
    reg_check_expr("pattern_matching", check_match)
    reg_emit_expr("pattern_matching", emit_match)

    // collections
    reg_check_expr("collections", check_collection)
    reg_emit_expr("collections", emit_collection)

    // ranges
    reg_check_expr("ranges", check_range)
    reg_emit_expr("ranges", emit_range)

    // string_templates
    reg_check_expr("string_templates", check_template)
    reg_emit_expr("string_templates", emit_template)



}
