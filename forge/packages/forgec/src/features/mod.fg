// Features for the self-hosted compiler.
// Bootstrap workaround: Map-based registry can't store fn pointers correctly.
// All dispatch is hardcoded here via match on string IDs.

mod variables
mod functions
mod operators
mod if_else
mod printing
mod primitive_types
mod enums
mod pattern_matching
mod structs
mod impl_methods
mod while_loops
mod for_loops
mod ranges
mod collections
mod strings
mod string_templates
mod closures
mod fn_types
mod null_safety
mod traits
mod generics
mod pipe_operator
mod modules
mod is_keyword
// mod error_propagation  // has parse errors with Ok_/Err_ tokens

use core.ast.NodeRef
use core.types.Type
use codegen.Codegen
use checker.TypeChecker
use variables.{parse_let, parse_mut, parse_const, check_var, emit_var, top_level_var}
use functions.{parse_fn, parse_export, check_fn, emit_fn, top_level_fn, declare_all_functions, emit_fn_body, store_fn_for_codegen}
use enums.{parse_enum, check_enum, emit_enum_decl, top_level_enum}
use structs.{parse_type_decl, check_type_decl, check_struct_lit, emit_type_decl, emit_struct_lit, top_level_type}
use traits.{parse_trait, check_trait, top_level_trait}
use impl_methods.{parse_impl, check_impl, emit_impl, top_level_impl}
use modules.{parse_use, check_use, top_level_use}
use while_loops.{parse_while, check_while, emit_while}
use for_loops.{parse_for, check_for, emit_for}
use if_else.{check_if_expr, emit_if_expr}
use pattern_matching.{check_match, emit_match}
use collections.{check_collection, emit_collection}
use ranges.{check_range, emit_range}
use string_templates.{check_template, emit_template}
use closures.{check_closure, emit_closure}
use null_safety.{check_null_safety, emit_null_safety}
use is_keyword.{emit_is_check}
// use error_propagation.{check_error_prop, emit_error_prop}  // not exported yet

export fn init_features() {
    // No-op: dispatch is hardcoded below (bootstrap can't store fn ptrs in Maps)
}

// ─── Hardcoded Codegen Dispatch ──────────────────

export fn dispatch_emit_stmt(cg: Codegen, node: NodeRef) {
    let fid = node.feature
    if fid == "variables" { emit_var(cg, node) }
    else if fid == "functions" { emit_fn_body(cg, node) }
    else if fid == "enums" { emit_enum_decl(cg, node) }
    else if fid == "structs" { emit_type_decl(cg, node) }
    else if fid == "impl_methods" { emit_impl(cg, node) }
    else if fid == "while_loops" { emit_while(cg, node) }
    else if fid == "for_loops" { emit_for(cg, node) }
    else {
        eprintln("[dispatch_emit_stmt] unknown feature: ${fid}")
    }
}

export fn dispatch_emit_expr(cg: Codegen, node: NodeRef) -> ptr {
    let fid = node.feature
    if fid == "if_else" { return emit_if_expr(cg, node) }
    else if fid == "pattern_matching" { return emit_match(cg, node) }
    else if fid == "collections" { return emit_collection(cg, node) }
    else if fid == "ranges" { return emit_range(cg, node) }
    else if fid == "string_templates" { return emit_template(cg, node) }
    else if fid == "closures" { return emit_closure(cg, node) }
    else if fid == "null_safety" { return emit_null_safety(cg, node) }
    else if fid == "structs" { return emit_struct_lit(cg, node) }
    else if fid == "is_keyword" { return emit_is_check(cg, node.node_id) }
    else {
        eprintln("[dispatch_emit_expr] unknown feature: ${fid}")
    }
    null
}
