// ─── While Loops Feature ───────────────────────
// while condition { body }
// Emits LLVM IR inline during parsing (bootstrap workaround).

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.Parser
use checker.TypeChecker
use codegen.{Codegen, CG_CTX, CG_B, CG_I64, codegen_new}
use @std.llvm

// Global to propagate parser position back after free-function parse calls
// (bootstrap workaround: Parser is pass-by-value, pos changes lost)
// Shared by ALL feature parse functions
export mut PARSE_END_POS: int = -1

export fn parse_while(p: Parser) -> Statement? {
    let start = p.advance().span // consume 'while'
    p.skip_newlines()

    // If codegen is active, set up while loop blocks BEFORE parsing body
    if CG_B != null {
        // Parse condition
        let condition = p.parse_expr()
        if condition == null { return null }

        p.skip_newlines()

        let current_bb = llvm.get_insert_block(CG_B)
        let current_fn = llvm.get_basic_block_parent(current_bb)

        let cond_bb = llvm.append_basic_block(CG_CTX, current_fn, "while.cond")
        let body_bb = llvm.append_basic_block(CG_CTX, current_fn, "while.body")
        let end_bb = llvm.append_basic_block(CG_CTX, current_fn, "while.end")

        // Jump to condition check
        llvm.build_br(CG_B, cond_bb)

        // Emit condition
        llvm.position_at_end(CG_B, cond_bb)
        mut cg = codegen_new()
        let cond_val = cg.emit_expr(condition!)
        let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "whilecond")
        llvm.build_cond_br(CG_B, cond_i1, body_bb, end_bb)

        // Position in body block, then parse+emit body
        llvm.position_at_end(CG_B, body_bb)
        let body = p.parse_block()
        // Only loop back if the body didn't already terminate (e.g., break/return)
        if !llvm.block_has_terminator(CG_B) {
            llvm.build_br(CG_B, cond_bb)
        }

        // Continue after loop
        llvm.position_at_end(CG_B, end_bb)
    } else {
        // Not in codegen — just parse and discard
        let condition = p.parse_expr()
        p.skip_newlines()
        let body = p.parse_block()
    }

    PARSE_END_POS = p.pos
    let id = next_node_id()
    feature_stmt("while_loops", "while", id, start)
}

fn check_while(tc: TypeChecker, node: NodeRef) {
    // TODO: type check condition and body
}

fn emit_while(cg: Codegen, node: NodeRef) {
    // No-op: while loops are emitted inline during parsing
    return
}

reg_parser("while", parse_while)
reg_check_stmt("while_loops", check_while)
reg_emit_stmt("while_loops", emit_while)
