// ─── While Loops Feature ───────────────────────

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_emit_stmt}
use parser.Parser
use checker.TypeChecker
use codegen.{Codegen, CG_CTX, CG_B, CG_I64, codegen_new}
use @std.llvm

export mut PARSE_END_POS: int = -1
export mut WHILE_COND_BB: ptr = null
export mut WHILE_END_BB: ptr = null

export fn parse_while(p: Parser) -> Statement? {
    let start = p.advance().span
    p.skip_newlines()
    let condition = p.parse_expr()
    if condition == null { return null }
    p.skip_newlines()
    let body = p.parse_block()
    PARSE_END_POS = forge_parser_get_pos()
    Statement.While(condition!, body, start)
}

// Emit while loop from AST (called by emit_block)
export fn emit_while_ast(cg: Codegen, condition: Expr, body: Block) {
    let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
    let wc = llvm.append_basic_block(CG_CTX, fn_val, "wc")
    let wb = llvm.append_basic_block(CG_CTX, fn_val, "wb")
    let we = llvm.append_basic_block(CG_CTX, fn_val, "we")
    let oc = WHILE_COND_BB
    let oe = WHILE_END_BB
    WHILE_COND_BB = wc
    WHILE_END_BB = we
    llvm.build_br(CG_B, wc)
    llvm.position_at_end(CG_B, wc)
    let cv = cg.emit_expr(condition).val
    let ci = llvm.build_trunc(CG_B, cv, llvm.int1_type(CG_CTX), "wt")
    llvm.build_cond_br(CG_B, ci, wb, we)
    llvm.position_at_end(CG_B, wb)
    cg.emit_block(body)
    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, wc) }
    WHILE_COND_BB = oc
    WHILE_END_BB = oe
    llvm.position_at_end(CG_B, we)
}

fn check_while(tc: TypeChecker, node: NodeRef) {}
fn emit_while(cg: Codegen, node: NodeRef) {}

reg_parser("while", parse_while)
reg_check_stmt("while_loops", check_while)
reg_emit_stmt("while_loops", emit_while)
