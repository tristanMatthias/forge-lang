// ─── If/Else Feature ──────────────────────────
// Handles: if/else expressions.
// Side table stores IfExprData keyed by node_id.
// Parse stores AST, emit reads from side table.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureExpr, feature_expr, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use checker.TypeChecker
use codegen.{Codegen, CG_CTX, CG_I64, CG_PTR, CG_STR, CG_FN_RETURNS_NULLABLE, CG_FN_NULLABLE_INNER_TY, make_nullable_type, wrap_nullable, codegen_new, CG_NULLABLE_VAR_NAMES}
use @std.llvm

// ─── Data Types ──────────────────────────────────

type IfExprData = {
    condition: Expr,
    then_block: Block,
    has_else: bool,
    else_block: Block,
    span: Span,
}

// ─── Side Table ─────────────────────────────────

mut IF_EXPR_DATA: Map<string, IfExprData> = {}

fn get_if_expr(node_id: int) -> IfExprData? {
    let key = "${node_id}"
    if IF_EXPR_DATA.has(key) { IF_EXPR_DATA[key] } else { null }
}

// ─── Store ──────────────────────────────────────
// Called by parser to store if-expression data

export fn store_if_expr(condition: Expr, then_block: Block, has_else: bool, else_block: Block, span: Span) -> Expr {
    let id = next_node_id()
    let key = "${id}"
    IF_EXPR_DATA[key] = IfExprData {
        condition,
        then_block,
        has_else,
        else_block,
        span,
    }
    feature_expr("if_else", "if_expr", id, span)
}

// Legacy exports (for old inline-emit code that may still reference these)
export mut PENDING_IF: bool = false
export mut CURRENT_IF_COND: Expr = Expr.IntLit(0, Span { start: 0, end: 0, line: 0, col: 0 })
export mut CURRENT_IF_THEN: Block = Block { statements: [], span: Span { start: 0, end: 0, line: 0, col: 0 } }
export mut CURRENT_IF_HAS_ELSE: bool = false
export mut CURRENT_IF_ELSE: Block = Block { statements: [], span: Span { start: 0, end: 0, line: 0, col: 0 } }

// ─── Check ──────────────────────────────────────

fn check_if_expr(tc: TypeChecker, node: NodeRef) -> Type {
    let d = get_if_expr(node.node_id)
    if d == null { return Type.Void }
    let data = d!

    let cond_type = tc.infer_expr(data.condition)

    let then_type = tc.check_block(data.then_block)

    if data.has_else {
        let else_type = tc.check_block(data.else_block)
        then_type
    } else {
        Type.Void
    }
}

// ─── Emit ───────────────────────────────────────

fn emit_if_expr(cg: Codegen, node: NodeRef) -> ptr {
    let d = get_if_expr(node.node_id)
    if d == null { return llvm.const_int(CG_I64, 0, 0) }
    let data = d!

    // Emit condition
    let cond_val = cg.emit_expr(data.condition)
    // Truncate to i1 (comparison results are i64 after zext)
    let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifc")

    let current_bb = llvm.get_insert_block(CG_B)
    let current_fn = llvm.get_basic_block_parent(current_bb)

    let then_bb = llvm.append_basic_block(CG_CTX, current_fn, "th")
    let else_bb = llvm.append_basic_block(CG_CTX, current_fn, "el")
    let merge_bb = llvm.append_basic_block(CG_CTX, current_fn, "ic")

    llvm.build_cond_br(CG_B, cond_i1, then_bb, else_bb)

    // Emit then block
    llvm.position_at_end(CG_B, then_bb)
    mut then_val = cg.emit_block(data.then_block)
    mut then_is_nullable = false
    // In nullable function context, wrap non-nullable then value before branching
    if CG_FN_RETURNS_NULLABLE == 1 {
        then_val = wrap_nullable(CG_FN_NULLABLE_INNER_TY, then_val)
        then_is_nullable = true
    }
    let then_end_bb = llvm.get_insert_block(CG_B)
    let then_terminated = llvm.block_has_terminator(CG_B)
    if !then_terminated {
        llvm.build_br(CG_B, merge_bb)
    }

    // Emit else block
    llvm.position_at_end(CG_B, else_bb)
    mut else_val = llvm.const_int(CG_I64, 0, 0)
    if data.has_else {
        else_val = cg.emit_block(data.else_block)
    }
    mut else_is_nullable = false
    // In nullable function context, wrap non-nullable else value before branching
    if data.has_else && CG_FN_RETURNS_NULLABLE == 1 {
        else_val = wrap_nullable(CG_FN_NULLABLE_INNER_TY, else_val)
        else_is_nullable = true
    }
    let else_end_bb = llvm.get_insert_block(CG_B)
    let else_terminated = llvm.block_has_terminator(CG_B)
    if !else_terminated {
        llvm.build_br(CG_B, merge_bb)
    }

    llvm.position_at_end(CG_B, merge_bb)

    // If both branches produced values (if-as-expression), use PHI
    if data.has_else && !then_terminated && !else_terminated {
        // In a nullable function, both branches are now wrapped as {i8, T}
        if CG_FN_RETURNS_NULLABLE == 1 && (then_is_nullable || else_is_nullable) {
            let nullable_ty = make_nullable_type(CG_FN_NULLABLE_INNER_TY)
            let phi = llvm.build_phi(CG_B, nullable_ty, "iv")
            llvm.add_incoming(phi, then_val, then_end_bb)
            llvm.add_incoming(phi, else_val, else_end_bb)
            return phi
        }
        let phi = llvm.build_phi(CG_B, CG_I64, "iv")
        llvm.add_incoming(phi, then_val, then_end_bb)
        llvm.add_incoming(phi, else_val, else_end_bb)
        return phi
    }

    llvm.const_int(CG_I64, 0, 0)
}

// ─── Registration ────────────────────────────────

reg_check_expr("if_else", check_if_expr)
reg_emit_expr("if_else", emit_if_expr)
