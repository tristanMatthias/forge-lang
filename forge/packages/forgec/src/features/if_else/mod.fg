// ─── If/Else Feature ──────────────────────────
// Handles: if/else expressions.
// Side table stores IfExprData keyed by node_id (as string).
//
// Note: if/else is an EXPRESSION in Forge, not a statement. It produces
// a value. Currently, the if/else parsing is handled inline in the
// expression parser (parser/expressions.fg) because it's a prefix
// expression. This feature module declares the side table and data types
// so that the expression parser can store data here, and registers the
// feature for check/emit dispatch.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureExpr, feature_expr, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use checker.TypeChecker
use codegen.{Codegen, CG_ACTIVE, CG_CTX, CG_B, CG_I64, CG_I8, CG_PTR, CG_VAR_NAMES, CG_VAR_PTRS, codegen_new}
use @std.llvm

// ─── Data Types ──────────────────────────────────

type IfExprData = {
    condition: Expr,
    then_block: Block,
    else_block: Block?,
    span: Span,
}

// ─── Current If Data ─────────────────────────────
// Since we re-parse + codegen each function body in one pass,
// the most recently parsed if-expression data is still live.
// Use a global to pass data from parser → codegen.
export mut PENDING_IF: bool = false
export mut CURRENT_IF_COND: Expr = Expr.IntLit(0, Span { start: 0, end: 0, line: 0, col: 0 })
export mut CURRENT_IF_THEN: Block = Block { statements: [], span: Span { start: 0, end: 0, line: 0, col: 0 } }
export mut CURRENT_IF_HAS_ELSE: bool = false
export mut CURRENT_IF_ELSE: Block = Block { statements: [], span: Span { start: 0, end: 0, line: 0, col: 0 } }

// Emit if-expression inline during parse (because AST storage corrupts nested data)
// Two entry points: with else and without (avoids nullable which is unreliable)
export fn make_if_expr(condition: Expr, then_block: Block, else_block: Block?, span: Span) -> Expr {
    // Delegate to the non-nullable version
    // Bootstrap workaround: else_block nullability is unreliable
    make_if_no_else(condition, then_block, span)
}

export fn make_if_with_else(condition: Expr, then_block: Block, else_block: Block, span: Span) -> Expr {
    if CG_ACTIVE {
        let cond_val = emit_if_cond(condition)
        let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifcond")
        let current_bb = llvm.get_insert_block(CG_B)
        let current_fn = llvm.get_basic_block_parent(current_bb)
        let then_bb = llvm.append_basic_block(CG_CTX, current_fn, "then")
        let else_bb = llvm.append_basic_block(CG_CTX, current_fn, "else")
        let merge_bb = llvm.append_basic_block(CG_CTX, current_fn, "ifcont")

        llvm.build_cond_br(CG_B, cond_i1, then_bb, else_bb)

        llvm.position_at_end(CG_B, then_bb)
        emit_if_block(then_block)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, else_bb)
        emit_if_block(else_block)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, merge_bb)
    }
    Expr.IntLit(0, span)
}

export fn make_if_no_else(condition: Expr, then_block: Block, span: Span) -> Expr {
    if CG_ACTIVE {
        let cond_val = emit_if_cond(condition)
        let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifcond")
        let current_bb = llvm.get_insert_block(CG_B)
        let current_fn = llvm.get_basic_block_parent(current_bb)
        let then_bb = llvm.append_basic_block(CG_CTX, current_fn, "then")
        let merge_bb = llvm.append_basic_block(CG_CTX, current_fn, "ifcont")

        llvm.build_cond_br(CG_B, cond_i1, then_bb, merge_bb)

        llvm.position_at_end(CG_B, then_bb)
        emit_if_block(then_block)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, merge_bb)
    }
    Expr.IntLit(0, span)
}

// ─── Inline Emit Helpers ────────────────────────

fn emit_if_cond(condition: Expr) -> ptr {
    mut cg = codegen_new()
    cg.emit_expr(condition)
}

fn emit_if_block(block: Block) -> ptr {
    mut cg = codegen_new()
    cg.emit_block(block)
}

// ─── Check ──────────────────────────────────────

fn check_if_expr(tc: TypeChecker, node: NodeRef) -> Type {
    let d = get_if_expr(node.node_id)
    if d == null { return Type.Void }
    let data = d!

    let cond_type = tc.infer_expr(data.condition)
    // TODO: verify cond_type is bool

    let then_type = tc.check_block(data.then_block)

    if data.else_block != null {
        let else_type = tc.check_block(data.else_block!)
        // TODO: unify then_type and else_type
        then_type
    } else {
        Type.Void
    }
}

// ─── Emit ───────────────────────────────────────

fn emit_if_expr(cg: Codegen, node: NodeRef) -> ptr {
    eprintln("[emit_if] called! node_id=${node.node_id}")
    // Use globals set by make_if_expr (data from most recent parse)
    let cond_val = cg.emit_expr(CURRENT_IF_COND)
    eprintln("[emit_if] cond emitted")

    // Truncate to i1 (condition might be i1 from icmp, or i8, or i64)
    let cond_i1 = llvm.build_trunc(CG_B, cond_val, llvm.int1_type(CG_CTX), "ifcond")

    let current_fn = cg.current_fn
    if current_fn == null { return llvm.const_int(CG_I64, 0, 0) }

    let then_bb = llvm.append_basic_block(CG_CTX, current_fn!, "then")
    let merge_bb = llvm.append_basic_block(CG_CTX, current_fn!, "ifcont")

    if CURRENT_IF_HAS_ELSE {
        let else_bb = llvm.append_basic_block(CG_CTX, current_fn!, "else")
        llvm.build_cond_br(CG_B, cond_i1, then_bb, else_bb)

        llvm.position_at_end(CG_B, then_bb)
        cg.emit_block(CURRENT_IF_THEN)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, else_bb)
        cg.emit_block(CURRENT_IF_ELSE)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, merge_bb)
        llvm.const_int(CG_I64, 0, 0)
    } else {
        llvm.build_cond_br(CG_B, cond_i1, then_bb, merge_bb)

        llvm.position_at_end(CG_B, then_bb)
        cg.emit_block(CURRENT_IF_THEN)
        llvm.build_br(CG_B, merge_bb)

        llvm.position_at_end(CG_B, merge_bb)
        llvm.const_int(CG_I64, 0, 0)
    }
}

// ─── Registration ────────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "if_else", ... })
reg_check_expr("if_else", check_if_expr)
reg_emit_expr("if_else", emit_if_expr)
