// ─── If/Else Feature ──────────────────────────
// Handles: if/else expressions.
// Side table stores IfExprData keyed by node_id (as string).
//
// Note: if/else is an EXPRESSION in Forge, not a statement. It produces
// a value. Currently, the if/else parsing is handled inline in the
// expression parser (parser/expressions.fg) because it's a prefix
// expression. This feature module declares the side table and data types
// so that the expression parser can store data here, and registers the
// feature for check/emit dispatch.

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureExpr, feature_expr, next_node_id}
use core.types.Type
use core.registry.{register_feature, FeatureRegistration}
use checker.TypeChecker
use codegen.Codegen

// ─── Side Table ──────────────────────────────────

mut IF_EXPRS: Map<string, IfExprData> = {}

// ─── Data Types ──────────────────────────────────

type IfExprData = {
    condition: Expr,
    then_block: Block,
    else_block: Block?,
    span: Span,
}

// ─── Lookup Helper ───────────────────────────────

fn get_if_expr(node_id: int) -> IfExprData? {
    let key = "${node_id}"
    if IF_EXPRS.has(key) {
        IF_EXPRS[key]
    } else {
        null
    }
}

// ─── Construction Helper ─────────────────────────
// Called by the expression parser when it encounters an `if` token.

fn make_if_expr(condition: Expr, then_block: Block, else_block: Block?, span: Span) -> Expr {
    let id = next_node_id()
    let key = "${id}"
    IF_EXPRS[key] = IfExprData {
        condition,
        then_block,
        else_block,
        span,
    }
    feature_expr("if_else", "if_expr", id, span)
}

// ─── Check ──────────────────────────────────────

fn check_if_expr(tc: TypeChecker, node: NodeRef) -> Type {
    let d = get_if_expr(node.node_id)
    if d == null { return Type.Void }
    let data = d!

    let cond_type = tc.infer_expr(data.condition)
    // TODO: verify cond_type is bool

    let then_type = tc.check_block(data.then_block)

    if data.else_block != null {
        let else_type = tc.check_block(data.else_block!)
        // TODO: unify then_type and else_type
        then_type
    } else {
        Type.Void
    }
}

// ─── Emit ───────────────────────────────────────

fn emit_if_expr(cg: Codegen, node: NodeRef) -> ptr {
    let d = get_if_expr(node.node_id)
    if d == null { return cg.null_ptr() }
    let data = d!

    let cond_val = cg.emit_expr(data.condition)
    // TODO: full if/else codegen with phi nodes
    cg.emit_block(data.then_block)
}

// ─── Registration ────────────────────────────────

register_feature(FeatureRegistration {
    id: "if_else",
    name: "If/Else Expressions",
    status: "wip",
    parsers: {},
    check_stmt: null,
    check_expr: check_if_expr,
    emit_stmt: null,
    emit_expr: emit_if_expr,
    top_level: null,
})
