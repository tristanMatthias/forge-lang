// ─── Strings Feature ──────────────────────────
// Handles: built-in string methods resolved at type check time.
// .length, .substring(start, end), .contains(sub), .split(sep),
// .trim(), .to_upper(), .to_lower(), .starts_with(), .ends_with(),
// .replace(old, new), .char_at(i), .index_of(sub)
// No parse handler — methods are resolved by the checker on String type.

use core.types.Type
use core.registry.{register_feature, FeatureRegistration}

// No side tables needed — string methods are resolved inline
// by the checker when it sees a method call on a String-typed value.

// ─── Registration ───────────────────────────────

register_feature(FeatureRegistration {
    id: "strings",
    name: "String Methods",
    status: "draft",
    parsers: {},
    check_stmt: null,
    check_expr: null,  // Method resolution handled in checker's method dispatch
    emit_stmt: null,
    emit_expr: null,
    top_level: null,
})
