// ─── Printing Feature ─────────────────────────
// print/println are ordinary function calls resolved during codegen.
// No parse handlers needed — they parse as Expr.Call nodes.

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

fn is_print_builtin(name: string) -> bool {
    name == "print" || name == "println" || name == "eprint" || name == "eprintln"
}

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "printing", ... })
