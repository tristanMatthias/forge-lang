// ─── Printing Feature ─────────────────────────
// print/println are ordinary function calls resolved during codegen.
// No parse handlers needed — they parse as Expr.Call nodes.

use core.registry.{register_feature, FeatureRegistration}

fn is_print_builtin(name: string) -> bool {
    name == "print" || name == "println" || name == "eprint" || name == "eprintln"
}

register_feature(FeatureRegistration {
    id: "printing",
    name: "Print Functions",
    status: "wip",
    parsers: {},
    check_stmt: null, check_expr: null,
    emit_stmt: null, emit_expr: null,
    top_level: null,
})
