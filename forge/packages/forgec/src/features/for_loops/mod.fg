// ─── For Loops Feature ─────────────────────────
// for item in iterable { body }
// Desugars to a while loop with index counter.
// Emits LLVM IR inline during parsing (bootstrap workaround).

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.Parser
use checker.TypeChecker
use codegen.{Codegen, CG_ACTIVE, CG_CTX, CG_B, CG_I64, CG_STR, CG_RT_SLEN, CG_VAR_NAMES, CG_VAR_PTRS, codegen_new}
use features.while_loops.PARSE_END_POS
use @std.llvm

export fn parse_for(p: Parser) -> Statement? {
    let start = p.advance().span // consume 'for'
    p.skip_newlines()

    let var_name = p.expect_ident()
    if var_name == "" {
        p.error("expected variable name after 'for'")
        return null
    }

    if p.expect(.In) == null {
        p.error("expected 'in' after for variable")
        return null
    }

    p.skip_newlines()

    // If codegen is active, desugar to a while loop inline:
    //   mut __for_i = 0
    //   while __for_i < list.length {
    //       let item = list[__for_i]
    //       body
    //       __for_i = __for_i + 1
    //   }
    if CG_ACTIVE {
        // Parse the iterable expression (inline emit fires)
        let iterable = p.parse_expr()
        if iterable == null { return null }
        p.skip_newlines()

        // --- Emit iterable expression to get list value ---
        mut cg = codegen_new()
        let list_val = cg.emit_expr(iterable!)

        // --- Emit: mut __for_i = 0 ---
        let idx_name = "__for_i"
        let zero = llvm.const_int(CG_I64, 0, 0)
        let idx_alloca = llvm.build_alloca(CG_B, CG_I64, idx_name)
        llvm.build_store(CG_B, zero, idx_alloca)
        CG_VAR_NAMES = CG_VAR_NAMES.push(idx_name)
        CG_VAR_PTRS = CG_VAR_PTRS.push(idx_alloca)

        // --- Get list length via forge_string_length (same {ptr, i64} layout) ---
        let len_args = llvm.value_array_new(1)
        llvm.value_array_set(len_args, 0, list_val)
        let len_pt = llvm.type_array_new(1)
        llvm.type_array_set(len_pt, 0, CG_STR)
        let len_ft = llvm.function_type(CG_I64, len_pt, 1, 0)
        llvm.type_array_free(len_pt)
        let length_val = llvm.build_call(CG_B, len_ft, CG_RT_SLEN, len_args, 1, "list_len")
        llvm.value_array_free(len_args)

        // --- Set up while loop blocks ---
        let current_bb = llvm.get_insert_block(CG_B)
        let current_fn = llvm.get_basic_block_parent(current_bb)

        let cond_bb = llvm.append_basic_block(CG_CTX, current_fn, "for.cond")
        let body_bb = llvm.append_basic_block(CG_CTX, current_fn, "for.body")
        let end_bb = llvm.append_basic_block(CG_CTX, current_fn, "for.end")

        // Jump to condition
        llvm.build_br(CG_B, cond_bb)

        // --- Condition: __for_i < length ---
        llvm.position_at_end(CG_B, cond_bb)
        let idx_val = llvm.build_load(CG_B, CG_I64, idx_alloca, "for_i")
        let cond_val = llvm.build_icmp(CG_B, 40, idx_val, length_val, "forcond")
        llvm.build_cond_br(CG_B, cond_val, body_bb, end_bb)

        // --- Body ---
        llvm.position_at_end(CG_B, body_bb)

        // let item = list[__for_i]
        let body_idx = llvm.build_load(CG_B, CG_I64, idx_alloca, "for_i_body")
        let data_ptr = llvm.build_extract_value(CG_B, list_val, 0, "list_data")
        let indices = llvm.value_array_new(1)
        llvm.value_array_set(indices, 0, body_idx)
        let elem_ptr = llvm.build_gep2(CG_B, CG_I64, data_ptr, indices, 1, "elem_ptr")
        llvm.value_array_free(indices)
        let elem_val = llvm.build_load(CG_B, CG_I64, elem_ptr, var_name)
        let item_alloca = llvm.build_alloca(CG_B, CG_I64, var_name)
        llvm.build_store(CG_B, elem_val, item_alloca)
        CG_VAR_NAMES = CG_VAR_NAMES.push(var_name)
        CG_VAR_PTRS = CG_VAR_PTRS.push(item_alloca)

        // Parse body block (inline emit fires into body_bb)
        let body = p.parse_block()

        // __for_i = __for_i + 1
        let cur_idx = llvm.build_load(CG_B, CG_I64, idx_alloca, "for_i_cur")
        let one = llvm.const_int(CG_I64, 1, 0)
        let next_idx = llvm.build_add(CG_B, cur_idx, one, "for_i_next")
        llvm.build_store(CG_B, next_idx, idx_alloca)

        // Loop back to condition (only if body didn't terminate)
        if !llvm.block_has_terminator(CG_B) {
            llvm.build_br(CG_B, cond_bb)
        }

        // Continue after loop
        llvm.position_at_end(CG_B, end_bb)
    } else {
        // Not in codegen — just parse and discard
        let iterable = p.parse_expr()
        p.skip_newlines()
        let body = p.parse_block()
    }

    PARSE_END_POS = p.pos
    let id = next_node_id()
    feature_stmt("for_loops", "for", id, start)
}

fn check_for(tc: TypeChecker, node: NodeRef) {
    // TODO: type check iterable and body
}

fn emit_for(cg: Codegen, node: NodeRef) {
    // No-op: for loops are emitted inline during parsing
    return
}

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
reg_parser("for", parse_for)
reg_check_stmt("for_loops", check_for)
reg_emit_stmt("for_loops", emit_for)
