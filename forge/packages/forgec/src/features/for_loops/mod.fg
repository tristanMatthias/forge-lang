// ─── For Loops Feature ─────────────────────────

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, feature_stmt, next_node_id}
use core.types.Type
use core.registry.{reg_parser, reg_check_stmt, reg_emit_stmt}
use parser.Parser
use checker.TypeChecker
use codegen.{Codegen, CG_CTX, CG_B, CG_I64, CG_STR, CG_RT_SLEN, CG_VAR_NAMES, CG_VAR_PTRS, codegen_new}
use features.while_loops.{PARSE_END_POS, WHILE_COND_BB, WHILE_END_BB}
use @std.llvm

export fn parse_for(p: Parser) -> Statement? {
    let start = p.advance().span
    p.skip_newlines()
    let var_name = p.expect_ident()
    if var_name == "" { return null }
    if p.expect_id(29) == null { return null }  // In
    p.skip_newlines()
    let iterable = p.parse_expr()
    if iterable == null { return null }
    p.skip_newlines()
    let body = p.parse_block()
    PARSE_END_POS = forge_parser_get_pos()
    Statement.For(var_name, iterable!, body, start)
}

export fn emit_for_ast(cg: Codegen, var_name: string, iterable: Expr, body: Block) {
    let lv = cg.emit_expr(iterable).val
    if lv == null {
        eprintln("  WARN: for-in iterable is null, skipping")
        return
    }
    let ia = llvm.build_alloca(CG_B, CG_I64, "fi")
    llvm.build_store(CG_B, llvm.const_int(CG_I64, 0, 0), ia)
    let la = llvm.value_array_new(1)
    llvm.value_array_set(la, 0, lv)
    let lt = llvm.type_array_new(1)
    llvm.type_array_set(lt, 0, CG_STR)
    llvm.type_array_free(lt)
    let ln = checked_build_call(CG_RT_SLEN, la, 1, "ln")
    llvm.value_array_free(la)
    let fn_val = llvm.get_basic_block_parent(llvm.get_insert_block(CG_B))
    let fc = llvm.append_basic_block(CG_CTX, fn_val, "fc")
    let fb = llvm.append_basic_block(CG_CTX, fn_val, "fb")
    let fx = llvm.append_basic_block(CG_CTX, fn_val, "fx")
    let fe = llvm.append_basic_block(CG_CTX, fn_val, "fe")
    let oc = WHILE_COND_BB
    let oe = WHILE_END_BB
    WHILE_COND_BB = fx
    WHILE_END_BB = fe
    llvm.build_br(CG_B, fc)
    llvm.position_at_end(CG_B, fc)
    let ci = llvm.build_load(CG_B, CG_I64, ia, "ci")
    let cc = llvm.build_icmp(CG_B, 40, ci, ln, "cc")
    llvm.build_cond_br(CG_B, cc, fb, fe)
    llvm.position_at_end(CG_B, fb)
    let bi = llvm.build_load(CG_B, CG_I64, ia, "bi")
    let dp = llvm.build_extract_value(CG_B, lv, 0, "dp")
    let gi = llvm.value_array_new(1)
    llvm.value_array_set(gi, 0, bi)
    let ep = llvm.build_gep2(CG_B, CG_I64, dp, gi, 1, "ep")
    llvm.value_array_free(gi)
    let ev = llvm.build_load(CG_B, CG_I64, ep, "ev")
    let va = llvm.build_alloca(CG_B, CG_I64, "iv")
    llvm.build_store(CG_B, ev, va)
    CG_VAR_NAMES = CG_VAR_NAMES.push(var_name)
    CG_VAR_PTRS = CG_VAR_PTRS.push(va)
    cg.emit_block(body)
    if !llvm.block_has_terminator(CG_B) { llvm.build_br(CG_B, fx) }
    llvm.position_at_end(CG_B, fx)
    let ic = llvm.build_load(CG_B, CG_I64, ia, "ic")
    let ni = llvm.build_add(CG_B, ic, llvm.const_int(CG_I64, 1, 0), "ni")
    llvm.build_store(CG_B, ni, ia)
    llvm.build_br(CG_B, fc)
    WHILE_COND_BB = oc
    WHILE_END_BB = oe
    llvm.position_at_end(CG_B, fe)
}

fn check_for(tc: TypeChecker, node: NodeRef) {}
fn emit_for(cg: Codegen, node: NodeRef) {}

reg_parser("for", parse_for)
reg_check_stmt("for_loops", check_for)
reg_emit_stmt("for_loops", emit_for)
