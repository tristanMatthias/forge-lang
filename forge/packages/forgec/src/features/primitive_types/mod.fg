// ─── Primitive Types Feature ──────────────────
// int, float, bool, string, void, ptr — resolved during type checking.
// No parse handlers needed.

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

fn is_primitive_type(name: string) -> bool {
    name == "int" || name == "float" || name == "bool" ||
    name == "string" || name == "void" || name == "ptr"
}

fn primitive_size(name: string) -> int {
    if name == "int" { return 8 }
    else if name == "float" { return 8 }
    else if name == "bool" { return 1 }
    else if name == "string" { return 16 }
    else if name == "void" { return 0 }
    else if name == "ptr" { return 8 }
    else { return -1 }
}

fn primitive_coercible(from: string, to: string) -> bool {
    if from == to { return true }
    if from == "int" && to == "float" { return true }
    false
}

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "primitive_types", ... })
