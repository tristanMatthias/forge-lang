// ─── Enums Feature ─────────────────────────────
use core.kind_ids.{KID_LPAREN, KID_RPAREN, KID_LBRACE, KID_RBRACE, KID_COMMA, KID_COLON, KID_ARROW, KID_DOT, KID_EQ, KID_NEWLINE, KID_IDENT, KID_FN, KID_MUT}
// Handles: enum declarations and enum variant construction.
// Tagged union representation: { tag: i8, payload: [fields] }

use core.token.{TokenKind, Span}
use core.ast.{Statement, Expr, Block, NodeRef, FeatureStmt, feature_stmt, feature_expr, next_node_id}
use core.types.{Type, EnumVariantType, StructField}
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}
use parser.{Parser, Param, TypeExpr}
use parser.expressions.{register_enum_variant}
use checker.TypeChecker
use codegen.{Codegen, register_enum_variant_fields, cg_get_enum_ty_for, cg_enum_variant_field_types, cg_enum_field_slot_offset, CG_B, CG_I8, CG_I64, match_enum_tag}
use @std.llvm
use features.while_loops.PARSE_END_POS

// ─── Side Tables ────────────────────────────────

mut ENUM_DECLS: Map<string, EnumDeclData> = {}
mut ENUM_CONSTRUCTS: Map<string, EnumConstructData> = {}

// ─── Data Types ─────────────────────────────────

type EnumVariant = {
    name: string,
    fields: List<EnumVariantField>,
    span: Span,
}

type EnumVariantField = {
    name: string,
    // Using non-nullable to avoid bootstrap type identity issue
    // (anonymous {i8,TypeExpr} vs %Nullable_TypeExpr)
    type_ann: TypeExpr,
}

type EnumDeclData = {
    name: string,
    variants: List<EnumVariant>,
    exported: bool,
    span: Span,
}

type EnumConstructData = {
    enum_name: string,
    variant_name: string,
    args: List<Expr>,
    span: Span,
}

fn get_enum_decl(id: int) -> EnumDeclData? {
    let key = "${id}"
    if ENUM_DECLS.has(key) { ENUM_DECLS[key] } else { null }
}

fn get_enum_construct(id: int) -> EnumConstructData? {
    let key = "${id}"
    if ENUM_CONSTRUCTS.has(key) { ENUM_CONSTRUCTS[key] } else { null }
}

// ─── Parse: Enum Declaration (inline-emit-during-parse) ────
// Called from parser dispatch when .Enum token is seen.
// Registers variant tags for use by match expressions.

export fn parse_enum_decl(p: Parser) -> Statement? {
    let start = p.advance_span() // consume 'enum'

    let name = p.expect_ident()
    if name == "" {
        p.error("expected enum name after 'enum'")
        return null
    }

    if p.expect_id(KID_LBRACE) == null { return null }
    p.skip_newlines()

    mut tag = 0
    mut max_slots = 0
    while p.peek_kind_id() != KID_RBRACE && !p.is_at_end() {
        p.skip_newlines()
        let variant_name = p.expect_ident()
        if variant_name == "" { break }

        // Register this variant's tag in the global registry
        register_enum_variant(name, variant_name, tag)

        // Parse optional fields, track types, and count slots
        mut variant_slots = 0
        mut field_types_str = ""
        if p.peek_kind_id() == KID_LPAREN {
            p.advance()
            while p.peek_kind_id() != KID_RPAREN && !p.is_at_end() {
                p.expect_ident()
                mut field_slots = 1  // default: 1 slot (int, bool, ptr, etc.)
                mut field_code = "i"
                if p.peek_kind_id() == KID_COLON {
                    p.advance()
                    // Check the type name BEFORE parse_type_expr consumes it
                    let type_text = p.peek_text()
                    // string and List<T> are 2 i64 slots ({ptr, i64})
                    if type_text == "string" {
                        field_slots = 2
                        field_code = "s"
                    }
                    if type_text == "List" {
                        field_slots = 2
                        field_code = "l"
                    }
                    // Span is a struct with 4 int fields = 4 slots
                    if type_text == "Span" {
                        field_slots = 4
                        field_code = "4"
                    }
                    p.parse_type_expr()
                }
                variant_slots = variant_slots + field_slots
                field_types_str = field_types_str + field_code
                if p.peek_kind_id() == KID_COMMA { p.advance() }
            }
            p.expect_id(KID_RPAREN)
        }
        if variant_slots > max_slots { max_slots = variant_slots }
        // Register per-variant field type info
        if field_types_str.length > 0 {
            register_enum_variant_fields(name, variant_name, field_types_str)
        }

        tag = tag + 1
        p.skip_newlines()
        if p.peek_kind_id() == KID_COMMA { p.advance() }
        p.skip_newlines()
    }

    p.expect_id(KID_RBRACE)

    forge_enum_type_register(name, max_slots)
    // Enum declarations register tags + max field count.
    PARSE_END_POS = forge_parser_get_pos()
    let id = next_node_id()
    feature_stmt("enums", "enum_decl", id, start)
}

// ─── Original Parse (for registry-based dispatch) ───

fn parse_enum(p: Parser) -> Statement? {
    parse_enum_decl(p)
}

fn parse_enum_variant(p: Parser) -> EnumVariant? {
    let start = p.current_span()
    let name = p.expect_ident()
    if name == null { return null }

    // Optional fields: Variant(field1: Type, field2: Type)
    mut fields: List<EnumVariantField> = []
    if p.peek_kind_id() == KID_LPAREN {
        p.advance()
        mut field_idx = 0
        while p.peek_kind_id() != KID_RPAREN && !p.is_at_end() {
            p.skip_newlines()
            let field_name_or_type = p.expect_ident()
            if field_name_or_type == null { break }

            if p.peek_kind_id() == KID_COLON {
                p.advance()
                let type_ann = p.parse_type_expr()
                mut ann = TypeExpr.Named("unknown", start)
                if type_ann != null { ann = type_ann! }
                fields = fields.push(EnumVariantField {
                    name: field_name_or_type!, type_ann: ann,
                })
            } else {
                fields = fields.push(EnumVariantField {
                    name: "${field_idx}",
                    type_ann: TypeExpr.Named(field_name_or_type!, start),
                })
            }

            field_idx = field_idx + 1
            p.skip_newlines()
            if p.peek_kind_id() == KID_COMMA { p.advance() }
        }
        if p.expect(.RParen) == null { return null }
    }

    EnumVariant { name: name!, fields, span: start }
}

// ─── Construction Helper ────────────────────────
// Called when the expression parser sees .Variant(args)

fn make_enum_construct(enum_name: string, variant_name: string, args: List<Expr>, span: Span) -> Expr {
    let id = next_node_id()
    ENUM_CONSTRUCTS["${id}"] = EnumConstructData {
        enum_name, variant_name, args, span,
    }
    feature_expr("enums", "enum_construct", id, span)
}

// ─── Check ──────────────────────────────────────

fn check_enum(tc: TypeChecker, node: NodeRef) {
    let d = get_enum_decl(node.node_id)
    if d == null { return }
    let data = d!

    // Build Type::Enum and register in environment
    mut variant_types: List<EnumVariantType> = []
    for v in data.variants {
        mut fields: List<StructField> = []
        for f in v.fields {
            // TODO: resolve field type from type_ann
            fields = fields.push(StructField { name: f.name, field_type: Type.Unknown })
        }
        variant_types = variant_types.push(EnumVariantType { name: v.name, fields })
    }

    let enum_type = Type.Enum(data.name, variant_types)
    tc.env.define(data.name, enum_type, false)
}

fn top_level_enum(tc: TypeChecker, node: NodeRef) {
    check_enum(tc, node)
}

// ─── Emit ───────────────────────────────────────

fn emit_enum_decl(cg: Codegen, node: NodeRef) {
    // Enum declarations don't emit code directly — they define types
    // that are used by variant constructors and match expressions.
}

// Emit an enum variant constructor expression, e.g. `Pattern.EnumVariant(name,
// fields, span)`. Builds the tagged-union value:
//   { i8 tag, i64 slot0, i64 slot1, ... }
// in an alloca, sets the tag byte to the variant index, packs each argument
// into the appropriate i64 slot(s), then loads and returns the struct value.
//
// This MUST exist for any function that returns an enum variant — without it,
// `dispatch_emit_expr` falls through and the constructor evaluates to null.
export fn emit_enum_construct(cg: Codegen, node: NodeRef) -> ptr {
    let d = get_enum_construct(node.node_id)
    if d == null { return null }
    let data = d!

    let enum_ty = cg_get_enum_ty_for(data.enum_name)
    if enum_ty == null { return null }

    // Allocate the enum struct, zero-initialize it.
    let alloca = llvm.build_alloca(CG_B, enum_ty, "enum_tmp")
    llvm.build_store(CG_B, llvm.const_null(enum_ty), alloca)

    // Set the tag byte (field 0) to the variant index.
    let qname = data.enum_name + "." + data.variant_name
    mut tag = match_enum_tag(qname)
    if tag < 0 { tag = match_enum_tag(data.variant_name) }
    if tag < 0 { tag = 0 }
    let tag_ptr = llvm.build_struct_gep2(CG_B, enum_ty, alloca, 0, "tag_ptr")
    llvm.build_store(CG_B, llvm.const_int(CG_I8, tag, 0), tag_ptr)

    // Pack arguments into i64 payload slots. The slot layout is computed
    // by cg_enum_field_slot_offset based on each field's type code:
    //   i = int   (1 slot)
    //   s = string (2 slots: ptr, len)
    //   l = list   (2 slots: ptr, len)
    //   4 = Span   (4 slots: start, end, line, col)
    //   p = boxed  (1 slot, holds inttoptr handle)
    let field_types = cg_enum_variant_field_types(data.enum_name, data.variant_name)
    mut field_idx = 0
    let _args = data.args
    for arg in _args {
        let v = cg.emit_expr(arg)
        let slot_off = cg_enum_field_slot_offset(field_types, field_idx)
        let slot = 1 + slot_off
        mut fcode = "i"
        if field_idx < field_types.length { fcode = field_types[field_idx] }

        if fcode == "s" || fcode == "l" {
            // ForgeString / List<T> — both {ptr, i64}.
            // Extract field 0 (data ptr) and field 1 (length), store each into
            // its own i64 slot via ptrtoint for the pointer half.
            let f0 = llvm.build_extract_value(CG_B, v, 0, "f0")
            let f1 = llvm.build_extract_value(CG_B, v, 1, "f1")
            let f0_i64 = llvm.build_ptrtoint(CG_B, f0, CG_I64, "f0i")
            let s0_ptr = llvm.build_struct_gep2(CG_B, enum_ty, alloca, slot, "s0")
            llvm.build_store(CG_B, f0_i64, s0_ptr)
            let s1_ptr = llvm.build_struct_gep2(CG_B, enum_ty, alloca, slot + 1, "s1")
            llvm.build_store(CG_B, f1, s1_ptr)
        } else if fcode == "4" {
            // Span = {i64, i64, i64, i64} — extract each field into its slot.
            mut sf = 0
            while sf < 4 {
                let sv = llvm.build_extract_value(CG_B, v, sf, "sv")
                let sp_ptr = llvm.build_struct_gep2(CG_B, enum_ty, alloca, slot + sf, "sp")
                llvm.build_store(CG_B, sv, sp_ptr)
                sf = sf + 1
            }
        } else {
            // Single i64 slot — int, bool, or boxed handle.
            let s_ptr = llvm.build_struct_gep2(CG_B, enum_ty, alloca, slot, "sl")
            llvm.build_store(CG_B, v, s_ptr)
        }

        field_idx = field_idx + 1
    }

    // Load and return the constructed enum value.
    llvm.build_load(CG_B, enum_ty, alloca, "enum_val")
}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
reg_parser("enum", parse_enum)
reg_check_stmt("enums", check_enum)
reg_emit_stmt("enums", emit_enum_decl)
reg_top_level("enums", top_level_enum)
