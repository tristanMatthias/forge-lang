// ─── Function Types Feature ───────────────────
// Handles: fn(int, string) -> bool type expressions.
// Function types are represented as Type.Function in the type system.
// No parse handler — fn types are parsed in the type expression parser.
// No side table — the type system handles function type representation.

use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

// ─── Registration ───────────────────────────────

// Register feature imperatively (bootstrap compiler cannot compile struct literals with fn pointers)
// Old: register_feature(FeatureRegistration { id: "fn_types", ... })
