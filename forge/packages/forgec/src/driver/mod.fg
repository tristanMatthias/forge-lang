// ─── Driver ────────────────────────────────────
// Orchestrates the compilation pipeline:
// Source → Lexer → Parser → Checker → Codegen → Linker

use core.ast.Program
use core.error.{render_diagnostic, render_all}
use lexer.mod.{lexer_new}
use parser.mod.{parser_new}
use checker.mod.{type_checker_new}
use codegen.mod.{codegen_new}
use @std.fs
use @std.process

// ─── Compilation Options ───────────────────────

type CompileOptions = {
    input_path: string,
    output_path: string?,
    check_only: bool,
    emit_ir: bool,
}

// ─── Pipeline ──────────────────────────────────

fn compile(source: string, filename: string, opts: CompileOptions) -> bool {
    // Phase 1: Lex
    mut lexer = lexer_new(source)
    let tokens = lexer.tokenize()

    if lexer.diagnostics.length > 0 {
        for d in lexer.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
    }

    // Phase 2: Parse
    mut parser = parser_new(tokens)
    let program = parser.parse_program()

    if parser.diagnostics.length > 0 {
        for d in parser.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
        return false
    }

    // Phase 3: Type Check
    mut checker = type_checker_new()
    checker.check_program(program)

    if checker.diagnostics.has_errors {
        let output = render_all(checker.diagnostics, source, filename)
        eprintln(output)
        return false
    }

    if opts.check_only {
        return true
    }

    // Phase 4: Codegen
    mut cg = codegen_new(filename)
    cg.emit_program(program)

    if !cg.verify() {
        eprintln("error: LLVM module verification failed")
        if opts.emit_ir {
            // Print IR for debugging
            let ir_ptr = cg.print_ir()
            // TODO: convert raw ptr to string and print
        }
        cg.dispose()
        return false
    }

    if opts.emit_ir {
        let ir_ptr = cg.print_ir()
        // TODO: convert and print IR
    }

    // Phase 5: Emit object + link
    let output = opts.output_path ?? "a.out"
    // TODO: use target machine to emit .o, then link with cc
    // For now, we just verify the IR is valid

    cg.dispose()
    true
}

// ─── File-based Entry Points ───────────────────

fn compile_file(path: string, output: string?) -> bool {
    let source = fs.read(path)
    compile(source, path, CompileOptions {
        input_path: path,
        output_path: output,
        check_only: false,
        emit_ir: false,
    })
}

fn check_file(path: string) -> bool {
    let source = fs.read(path)
    compile(source, path, CompileOptions {
        input_path: path,
        output_path: null,
        check_only: true,
        emit_ir: false,
    })
}
