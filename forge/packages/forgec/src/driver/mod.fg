// ─── Driver ────────────────────────────────────
// Orchestrates the compilation pipeline:
// Source → Lexer → Parser → Checker → Codegen → Linker

use core.error.{render_diagnostic, render_all}
use lexer.{lexer_new}
use parser.{parser_new}
use checker.{type_checker_new}
use codegen.{codegen_new}
use @std.fs
use @std.process

// ─── Compilation Options ───────────────────────

export type CompileOptions = {
    input_path: string,
    output_path: string?,
    check_only: bool,
    emit_ir: bool,
}

// ─── Pipeline ──────────────────────────────────

export fn compile(source: string, filename: string, opts: CompileOptions) -> bool {
    // Phase 1: Lex
    mut lex = lexer_new(source)
    let tokens = lex.tokenize()

    if lex.diagnostics.length > 0 {
        for d in lex.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
    }

    // Phase 2: Parse
    mut p = parser_new(tokens)
    let program = p.parse_program()

    if p.diagnostics.length > 0 {
        for d in p.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
        return false
    }

    // Phase 3: Type Check
    mut tc = type_checker_new()
    tc.check_program(program)

    if tc.diagnostics.has_errors {
        let output = render_all(tc.diagnostics, source, filename)
        eprintln(output)
        return false
    }

    if opts.check_only {
        return true
    }

    // Phase 4: Codegen
    mut cg = codegen_new(filename)
    cg.emit_program(program)

    if !cg.verify() {
        eprintln("error: LLVM module verification failed")
        cg.dispose()
        return false
    }

    // Phase 5: Emit object + link
    let output = opts.output_path ?? "a.out"
    // TODO: emit .o + cc link

    cg.dispose()
    true
}

// ─── File-based Entry Points ───────────────────

export fn compile_file(path: string, output: string?) -> bool {
    let source = fs.read(path)
    compile(source, path, CompileOptions {
        input_path: path,
        output_path: output,
        check_only: false,
        emit_ir: false,
    })
}

export fn check_file(path: string) -> bool {
    let source = fs.read(path)
    compile(source, path, CompileOptions {
        input_path: path,
        output_path: null,
        check_only: true,
        emit_ir: false,
    })
}
