// ─── Feature Registry ──────────────────────────
// Metadata registry for compiler features. Each phase (parse, check, emit)
// owns its own typed dispatch maps in its own module.
//
// This module stores only feature metadata and the parse dispatch map.
// The parse map uses Map<string, fn(Parser) -> Statement?> — fully typed,
// no ptr casts. Checker and codegen dispatch maps live in their own modules
// to avoid circular imports.

use core.token.Span
use core.ast.{Statement, Expr, NodeRef}
use core.types.Type

// ─── Feature Metadata ────────────────────────────

type FeatureMeta = {
    id: string,
    name: string,
    status: string,
}

// Global metadata list
mut FEATURES: List<FeatureMeta> = []

fn register_feature_meta(id: string, name: string, status: string) {
    FEATURES = FEATURES.push(FeatureMeta { id, name, status })
}
