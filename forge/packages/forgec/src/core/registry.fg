// ─── Feature Registry ──────────────────────────
// Maps are top-level globals (not struct fields) because the bootstrap
// can't compile struct.field[key] = value assignments.

use core.token.Span
use core.ast.{Statement, Expr, NodeRef}
use core.types.Type
use parser.Parser
use checker.TypeChecker
use codegen.Codegen

// ─── Handler Types ─────────────────────────────

export type ParseHandler = fn(Parser) -> Statement?
export type CheckStmtHandler = fn(TypeChecker, NodeRef)
export type CheckExprHandler = fn(TypeChecker, NodeRef) -> Type
export type EmitStmtHandler = fn(Codegen, NodeRef)
export type EmitExprHandler = fn(Codegen, NodeRef) -> ptr
export type TopLevelHandler = fn(TypeChecker, NodeRef)

// ─── Registry Maps (top-level globals) ─────────

export mut REG_PARSE: Map<string, ParseHandler> = {}
export mut REG_CHECK_STMT: Map<string, CheckStmtHandler> = {}
export mut REG_CHECK_EXPR: Map<string, CheckExprHandler> = {}
export mut REG_EMIT_STMT: Map<string, EmitStmtHandler> = {}
export mut REG_EMIT_EXPR: Map<string, EmitExprHandler> = {}
export mut REG_TOP_LEVEL: Map<string, TopLevelHandler> = {}

// ─── Legacy REGISTRY struct (for backward compat) ──

export type FeatureRegistry = {
    mut features: List<FeatureMeta>,
    mut parse_stmt: Map<string, ParseHandler>,
    mut check_stmt: Map<string, CheckStmtHandler>,
    mut check_expr: Map<string, CheckExprHandler>,
    mut emit_stmt: Map<string, EmitStmtHandler>,
    mut emit_expr: Map<string, EmitExprHandler>,
    mut top_level: Map<string, TopLevelHandler>,
}

export type FeatureMeta = {
    id: string,
    name: string,
    status: string,
}

export mut REGISTRY = FeatureRegistry {
    features: [],
    parse_stmt: {},
    check_stmt: {},
    check_expr: {},
    emit_stmt: {},
    emit_expr: {},
    top_level: {},
}

export type FeatureRegistration = {
    id: string,
    name: string,
    status: string,
    parsers: Map<string, ParseHandler>,
    check_stmt: CheckStmtHandler?,
    check_expr: CheckExprHandler?,
    emit_stmt: EmitStmtHandler?,
    emit_expr: EmitExprHandler?,
    top_level: TopLevelHandler?,
}

export fn register_feature(reg: FeatureRegistration) {
    // no-op: bootstrap can't compile struct literals with fn pointers
}

// Simple registration helpers that the bootstrap CAN compile
// (regular function calls, no struct literals or Map index assignments)
export fn reg_parser(key: string, handler: ParseHandler) {
    REG_PARSE[key] = handler
}

export fn reg_check_stmt(id: string, handler: CheckStmtHandler) {
    REG_CHECK_STMT[id] = handler
}

export fn reg_check_expr(id: string, handler: CheckExprHandler) {
    REG_CHECK_EXPR[id] = handler
}

export fn reg_emit_stmt(id: string, handler: EmitStmtHandler) {
    REG_EMIT_STMT[id] = handler
}

export fn reg_emit_expr(id: string, handler: EmitExprHandler) {
    REG_EMIT_EXPR[id] = handler
}

export fn reg_top_level(id: string, handler: TopLevelHandler) {
    REG_TOP_LEVEL[id] = handler
}
