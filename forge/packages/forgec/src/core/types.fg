// ─── Type System ───────────────────────────────
// Represents Forge types during compilation. This is the self-hosted
// equivalent of the Rust Type enum in the current compiler.

// ─── Core Type Enum ────────────────────────────

export enum Type {
    Int
    Float
    Bool
    String
    Void
    Never
    Ptr
    Nullable(inner: Type)
    ListType(element: Type)
    MapType(key: Type, value: Type)
    Tuple(elements: List<Type>)
    Struct(name: string, fields: List<StructField>)
    Enum(name: string, variants: List<EnumVariantType>)
    Function(params: List<Type>, return_type: Type)
    Result(ok: Type, err: Type)
    Range(element: Type)
    Channel(element: Type)
    TypeVar(id: int)
    Trait(name: string)
    Unknown
    Error
}

// ─── Supporting Types ──────────────────────────

export type StructField = {
    name: string,
    field_type: Type,
}

export type EnumVariantType = {
    name: string,
    fields: List<StructField>,
}

// ─── Type Predicates ───────────────────────────

export fn type_is_numeric(t: Type) -> bool {
    match t {
        .Int -> true
        .Float -> true
        _ -> false
    }
}

export fn type_is_nullable(t: Type) -> bool {
    match t {
        .Nullable(_) -> true
        _ -> false
    }
}

export fn type_is_primitive(t: Type) -> bool {
    match t {
        .Int -> true
        .Float -> true
        .Bool -> true
        .String -> true
        .Void -> true
        _ -> false
    }
}

export fn type_is_container(t: Type) -> bool {
    match t {
        .ListType(_) -> true
        .MapType(_, _) -> true
        .Tuple(_) -> true
        _ -> false
    }
}

export fn type_is_callable(t: Type) -> bool {
    match t {
        .Function(_, _) -> true
        _ -> false
    }
}

// ─── Type Unwrapping ───────────────────────────

export fn unwrap_nullable(t: Type) -> Type {
    // Bootstrap workaround: match-as-expression + enum return has type issues
    // Just return the input unchanged for now (checker handles nullable separately)
    return t
}

export fn unwrap_list_element(t: Type) -> Type? {
    return null
}

export fn unwrap_result_ok(t: Type) -> Type? {
    return null
}

export fn unwrap_result_err(t: Type) -> Type? {
    return null
}

// ─── Type Display ──────────────────────────────

export fn type_to_string(t: Type) -> string {
    // Bootstrap workaround: avoid match entirely (match-as-expression returns i64 phi)
    if t is .Int { return "int" }
    if t is .Float { return "float" }
    if t is .Bool { return "bool" }
    if t is .String { return "string" }
    if t is .Void { return "void" }
    if t is .Never { return "never" }
    if t is .Ptr { return "ptr" }
    if t is .Unknown { return "unknown" }
    if t is .Error { return "error" }
    // Struct/Enum: extract name field (field 0 in both variants)
    if t is .Struct { return "struct" }
    if t is .Enum { return "enum" }
    if t is .ListType { return "List" }
    if t is .MapType { return "Map" }
    if t is .Function { return "fn" }
    if t is .Nullable { return "nullable" }
    return "?"
}

// Convert a Type to a codegen-friendly name string
// Returns the name that resolve_type_to_llvm can process
export fn type_to_codegen_name(t: Type) -> string {
    if t is .Int { return "int" }
    if t is .Float { return "float" }
    if t is .Bool { return "bool" }
    if t is .String { return "string" }
    if t is .Void { return "void" }
    if t is .Ptr { return "ptr" }
    if t is .ListType { return "List" }
    if t is .MapType { return "Map" }
    if t is .Function { return "fn" }
    // For Struct/Enum, we need the name — but can't extract it with `is` checks
    // Use type_to_string as fallback for now
    return type_to_string(t)
}
