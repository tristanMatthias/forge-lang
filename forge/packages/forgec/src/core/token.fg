// ============================================================================
// Token types for the Forge self-hosted compiler
// Ported from forgec-rust/lexer/token.rs
// ============================================================================

// --- Span -------------------------------------------------------------------
// Tracks source position for error reporting and diagnostics.

export type Span = {
    start: int,
    end: int,
    line: int,
    col: int,
}

export fn span_new(start: int, end: int, line: int, col: int) -> Span {
    Span { start: start, end: end, line: line, col: col }
}

export fn span_dummy() -> Span {
    Span { start: 0, end: 0, line: 0, col: 0 }
}

// --- TemplatePart -----------------------------------------------------------
// Represents a segment of a template literal or dollar string.

export enum TemplatePart {
    Literal(value: string),
    Expr(value: string, span: Span),
}

// --- TokenKind --------------------------------------------------------------
// Every distinct token the lexer can produce.

export enum TokenKind {
    // Literals
    IntLiteral(value: int),
    FloatLiteral(value: float),
    StringLiteral(value: string),
    TemplateLiteral(parts: List<TemplatePart>),
    DollarString(parts: List<TemplatePart>),
    TaggedTemplate(tag: string, parts: List<TemplatePart>, type_param: string),
    BoolLiteral(value: bool),
    NullLiteral,

    // Identifiers
    Ident(name: string),

    // Keywords
    Let,
    Mut,
    Const,
    Fn,
    Return,
    If,
    Else,
    Match,
    For,
    In,
    While,
    Loop,
    Break,
    Continue,
    Enum,
    TypeKw,
    Use,
    Mod,
    As,
    Export,
    Emit,
    On,
    Trait,
    Impl,
    Defer,
    Errdefer,
    Spawn,
    Parallel,
    With,
    Catch,
    Select,
    Component,
    Without,
    Only,
    Partial,
    Is,
    Table,
    Null,
    OkKw,
    ErrKw,

    // Operators
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Eq,
    EqEq,
    NotEq,
    Lt,
    LtEq,
    Gt,
    GtEq,
    And,
    Or,
    Not,
    Pipe,
    Arrow,
    LeftArrow,
    Question,
    QuestionDot,
    DoubleQuestion,
    DotDot,
    DotDotEq,
    Ampersand,
    Bar,
    Caret,
    Tilde,
    ShiftLeft,
    ShiftRight,

    // Delimiters
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,

    // Punctuation
    Comma,
    Dot,
    Colon,
    Semicolon,
    At,
    Hash,
    Underscore,
    Spread,

    // Doc comment: /// text
    DocComment(text: string),

    // Special
    Newline,
    Eof,
}

// --- Token ------------------------------------------------------------------
// A lexed token: its kind plus source location.
// `text` and `kind_id` are bootstrap workarounds — the bootstrap can't
// match on data-carrying enum variants, so we store the data separately.
//   kind_id: 0=keyword/op/delim, 1=Ident, 2=IntLiteral, 3=FloatLiteral,
//            4=StringLiteral, 5=BoolLiteral, 6=Template, 7=DocComment,
//            8=NullLiteral, 9=TemplatePart, 10=TaggedTemplate

export type Token = {
    kind: TokenKind,
    span: Span,
    text: string,
    kind_id: int,
}

export fn token_new(kind: TokenKind, span: Span) -> Token {
    Token { kind: kind, span: span, text: "", kind_id: 0 }
}

export fn token_ident(name: string, span: Span) -> Token {
    Token { kind: TokenKind.Ident(name), span: span, text: name, kind_id: 1 }
}

export fn token_int(value: int, span: Span) -> Token {
    // Store value in text for later parsing (bootstrap workaround)
    Token { kind: TokenKind.IntLiteral(value), span: span, text: "${value}", kind_id: 2 }
}

export fn token_float(value: float, span: Span) -> Token {
    Token { kind: TokenKind.FloatLiteral(value), span: span, text: "${value}", kind_id: 3 }
}

export fn token_string(value: string, span: Span) -> Token {
    Token { kind: TokenKind.StringLiteral(value), span: span, text: value, kind_id: 4 }
}

export fn token_bool(value: bool, span: Span) -> Token {
    let t = if value { "true" } else { "false" }
    Token { kind: TokenKind.BoolLiteral(value), span: span, text: t, kind_id: 5 }
}
