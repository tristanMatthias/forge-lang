// ─── Forge Compiler (Self-Hosted) ──────────────

use @std.process
use @std.fs
use @std.llvm

mod core
mod lexer
mod parser
mod checker
mod codegen
mod features

use features

use core.error.{render_diagnostic, render_all}
use lexer.{lexer_new}
use parser.{parser_new, parser_new_with_source}
use checker.{type_checker_new}
use codegen.{codegen_new, create_globals_typed, codegen_init, codegen_write_ir, codegen_emit_object, codegen_cleanup}
use features.variables.{VAR_GLOBAL_COUNT, VAR_GLOBAL_NAMES, VAR_GLOBAL_STR_MASK}
use features.functions.{CURRENT_FILE_INDEX, EMIT_FILE_IDX, FN_NAMES, FN_BODY_SOURCES, FN_PARAM_COUNTS, emit_all_fn_bodies, declare_all_fns, emit_fn_body_from_source, materialize_struct_types}

// Byte-based string search — uses forge_string_byte_at (returns i64, no type tracking issues)
// 10=\n, 47=/, 32=space, 109=m, 111=o, 100=d
fn find_byte(s: string, byte_val: int) -> int {
    let len = s.length
    mut i = 0
    while i < len {
        if forge_string_byte_at(s, i) == byte_val { return i }
        i = i + 1
    }
    return -1
}

fn find_nmod(s: string) -> int {
    let len = s.length
    if len < 5 { return -1 }
    mut i = 0
    while i < len - 4 {
        if forge_string_byte_at(s, i) == 10 {
            if forge_string_byte_at(s, i + 1) == 109 {
                if forge_string_byte_at(s, i + 2) == 111 {
                    if forge_string_byte_at(s, i + 3) == 100 {
                        if forge_string_byte_at(s, i + 4) == 32 {
                            return i
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn check(source: string, filename: string) -> bool {
    eprintln("check: " + filename + " len=" + string(source.length))
    eprintln("  creating lexer...")
    mut lex = lexer_new(source)
    eprintln("  lexer created, len=" + string(source.length))
    eprintln("  tokenizing...")
    let tokens = lex.tokenize()
    eprintln("  " + string(tokens.length) + " tokens")

    eprintln("  parsing...")
    mut p = parser_new_with_source(tokens, source)
    eprintln("  parser created, parsing program...")
    let program = p.parse_program()
    eprintln("  parsed!")
    eprintln("OK")
    return true

    if lex.diagnostics.length > 0 {
        for d in lex.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
    }

    mut p = parser_new_with_source(tokens, source)
    let program = p.parse_program()

    if p.diagnostics.length > 0 {
        for d in p.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
        return false
    }

    mut tc = type_checker_new()
    tc.check_program(program)

    if tc.diagnostics.has_errors {
        let err_output = render_all(tc.diagnostics, source, filename)
        eprintln(err_output)
        return false
    }

    true
}

// ─── Module Resolution ─────────────────────────
// Reads a .fg file, finds `mod` declarations, recursively loads
// all module files, and returns concatenated source.

fn resolve_modules(filepath: string) -> string {
    eprintln("resolve_modules: " + filepath)
    let source = fs.read(filepath)
    eprintln("  source length: " + string(source.length))
    // Find the directory of this file
    mut dir = ""
    mut last_slash = -1
    mut ci = 0
    while ci < filepath.length {
        if filepath[ci] == "/" { last_slash = ci }
        ci = ci + 1
    }
    if last_slash >= 0 {
        dir = forge_string_substring(filepath, 0, last_slash + 1)
    }

    // Collect all source: start with this file
    // Modules go BEFORE the file that imports them (forward declaration)
    mut result = ""

    // Scan for `mod <name>` lines and recursively load
    mut pos = 0
    while pos < source.length {
        // Find next line starting with "mod "
        // Skip to start of line
        mut at_line_start = pos == 0
        if !at_line_start { if source[pos - 1] == "\n" { at_line_start = true } }
        if at_line_start {
            if pos + 4 < source.length {
                let c0 = source[pos]
                let c1 = source[pos + 1]
                let c2 = source[pos + 2]
                let c3 = source[pos + 3]
                if c0 == "m" {
                    if c1 == "o" {
                        if c2 == "d" {
                            if c3 == " " {
                                // Extract module name
                                // Find end of mod name using indexOf
                                let rest_str = forge_string_substring(source, pos + 4, source.length)
                                let nl_pos = find_byte(rest_str, 10)
                                mut mod_name = rest_str
                                if nl_pos >= 0 { mod_name = forge_string_substring(rest_str, 0, nl_pos) }

                                // Try: dir/name/mod.fg then dir/name.fg
                                let mod_path1 = dir + mod_name + "/mod.fg"
                                let mod_path2 = dir + mod_name + ".fg"

                                let mod_src1 = fs.read(mod_path1)
                                if mod_src1.length > 0 {
                                    result = result + resolve_modules(mod_path1)
                                } else {
                                    let mod_src2 = fs.read(mod_path2)
                                    if mod_src2.length > 0 {
                                        result = result + resolve_modules(mod_path2)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }

    // Append this file's source AFTER modules
    result = result + source + "\n"
    // Also track file paths for separate compilation
    MODULE_PATHS_CSV = MODULE_PATHS_CSV + filepath + "\n"
    return result
}

// ─── Module Path Resolution ────────────────────
// Returns list of .fg file paths in dependency order (modules first)

// Use a CSV string for paths (avoid List<string> from recursive calls crashing bootstrap)
mut MODULE_PATHS_CSV: string = ""

// Helper: find directory from filepath (no assignments inside if blocks)
fn filepath_dir(filepath: string) -> string {
    // Find last "/" by searching for "/" in progressively shorter suffixes
    let first = find_byte(filepath, 47)
    if first < 0 { return "" }
    // Walk forward finding all slashes
    let after1 = forge_string_substring(filepath, first + 1, filepath.length)
    let second = find_byte(after1, 47)
    if second < 0 { return forge_string_substring(filepath, 0, first + 1) }
    let after2 = forge_string_substring(after1, second + 1, after1.length)
    let third = find_byte(after2, 47)
    if third < 0 { return forge_string_substring(filepath, 0, first + 1 + second + 1) }
    let after3 = forge_string_substring(after2, third + 1, after2.length)
    let fourth = find_byte(after3, 47)
    if fourth < 0 { return forge_string_substring(filepath, 0, first + 1 + second + 1 + third + 1) }
    let after4 = forge_string_substring(after3, fourth + 1, after3.length)
    let fifth = find_byte(after4, 47)
    if fifth < 0 { return forge_string_substring(filepath, 0, first + 1 + second + 1 + third + 1 + fourth + 1) }
    let after5 = forge_string_substring(after4, fifth + 1, after4.length)
    let sixth = find_byte(after5, 47)
    if sixth < 0 { return forge_string_substring(filepath, 0, first + 1 + second + 1 + third + 1 + fourth + 1 + fifth + 1) }
    // 7+ levels deep — return up to 6th slash
    return forge_string_substring(filepath, 0, first + 1 + second + 1 + third + 1 + fourth + 1 + fifth + 1 + sixth + 1)
}

// Helper: extract mod name (text before first newline)
fn mod_name_from(rest: string) -> string {
    let nl = find_byte(rest, 10)
    if nl >= 0 { return forge_string_substring(rest, 0, nl) }
    return rest
}

// Helper: try loading a module path, recurse if found
fn try_load_mod(dir: string, mod_name: string) {
    let p1 = dir + mod_name + "/mod.fg"
    let p2 = dir + mod_name + ".fg"
    let s1 = fs.read(p1)
    if s1.length > 0 { collect_module_paths(p1) }
    else {
        let s2 = fs.read(p2)
        if s2.length > 0 { collect_module_paths(p2) }
    }
}

// Byte-based scan for \nmod in source text
fn scan_mods(src: string, dir: string) {
    let found = find_nmod(src)
    if found < 0 { return }
    let name_start = found + 5
    let rest = forge_string_substring(src, name_start, src.length)
    let mod_name = mod_name_from(rest)
    try_load_mod(dir, mod_name)
    let remaining = forge_string_substring(src, name_start, src.length)
    scan_mods(remaining, dir)
}

fn collect_module_paths(filepath: string) {
    eprintln("collect_module_paths: " + filepath)
    let source = fs.read(filepath)
    eprintln("  read " + string(source.length) + " bytes")
    let dir = filepath_dir(filepath)
    // Prepend \n so "mod " at line 1 also matches "\nmod "
    let src = "\n" + source
    scan_mods(src, dir)
    // Use C-side CSV accumulator (Forge global assignment is corrupted in Stage 2)
    forge_mod_csv_add(filepath)
    MODULE_PATHS_CSV = MODULE_PATHS_CSV + filepath + "\n"
}

fn resolve_module_paths(filepath: string) -> List<string> {
    MODULE_PATHS_CSV = ""
    collect_module_paths(filepath)
    eprintln("  CSV len=" + string(MODULE_PATHS_CSV.length))
    // Parse CSV into list
    mut paths: List<string> = []
    mut start = 0
    mut i = 0
    while i < MODULE_PATHS_CSV.length {
        if MODULE_PATHS_CSV[i] == "\n" {
            if i > start {
                paths = paths.push(forge_string_substring(MODULE_PATHS_CSV, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    return paths
}

// ─── Per-File Compilation ──────────────────────

fn scan_one_file(filepath: string, idx: int) {
    CURRENT_FILE_INDEX = idx
    // CG_ACTIVE removed
    eprintln("  [scan] " + string(idx) + " reading " + filepath)
    let source = fs.read(filepath)
    eprintln("  [scan] " + string(idx) + " read " + string(source.length) + " bytes")
    forge_set_scan_source(source)
    mut lex = lexer_new(source)
    eprintln("  [scan] " + string(idx) + " lexer created")
    let tokens = lex.tokenize()
    eprintln("  [scan] " + string(idx) + " " + string(tokens.length) + " tok")
    forge_dump_token_list(tokens)
    forge_set_token_list(tokens)
    mut p = parser_new_with_source(tokens, source)
    eprintln("  [scan] " + string(idx) + " parser created")
    p.parse_program()
    // Type checker not yet run during build — Program.statements list data
    // is corrupted in Stage 1's runtime (calling convention truncates struct returns).
    // Type annotations from parsing are stored via forge_var_type_set during parse_var_binding.
    // Full checker integration needs the struct return fix first.
    forge_alloc_stats()
    eprintln("  [scan] " + string(idx) + " parsed OK")
}

fn declare_llvm_api() {
    // LLVM API functions needed by self-hosted compiler (Stage 2+)
    llvm.add_function(CG_MOD, "forge_llvm_build_extract_value", make_fn_type(CG_PTR, [CG_PTR, CG_PTR, CG_I64, CG_STR]))
    // Declare C-side string helpers (non-"string" names to avoid type tracking corruption)
    llvm.add_function(CG_MOD, "forge_sh_indexof", make_fn_type_2(CG_I64, CG_STR, CG_STR))
    llvm.add_function(CG_MOD, "forge_sh_substr", make_fn_type_3(CG_STR, CG_STR, CG_I64, CG_I64))
    llvm.add_function(CG_MOD, "forge_sh_byteat", make_fn_type_2(CG_I64, CG_STR, CG_I64))
    llvm.add_function(CG_MOD, "forge_sh_length", make_fn_type_1(CG_I64, CG_STR))
}

// Entirely C-side scan loop (Forge stack corruption makes any Forge loop fail)
fn scan_csv(csv: string, start_idx: int) -> int {
    forge_scan_csv_set_cb(scan_one_file)
    return forge_scan_csv(csv)
}

fn build_compile_separate(paths_csv: string, output: string) {
    // Phase 1: Scan ALL files from newline-separated CSV
    // Use C-side CSV if Forge global is empty (Stage 2 global assignment is broken)
    mut csv = paths_csv
    if csv.length == 0 {
        codegen_init("forgec_output")
        declare_llvm_api()
        // NOW forge_mod_csv_get is declared in the LLVM module
        csv = forge_mod_csv_get()
        eprintln("  using C-side CSV: " + string(csv.length) + " bytes")
    }
    // Use recursive scan (works with Rust-compiled bootstrap)
    let file_count = scan_csv(csv, 0)
    let fn_count = forge_fn_store_count()
    eprintln("scanned " + string(file_count) + " files, " + string(fn_count) + " fns")

    // Phase 2: Single LLVM module — declare all, then emit bodies
    if csv.length != paths_csv.length {
        // codegen_init already called above
    } else {
        codegen_init("forgec_output")
        declare_llvm_api()
    }
    create_globals_typed(VAR_GLOBAL_NAMES, VAR_GLOBAL_STR_MASK)
    forge_str_var_set_global_count()
    forge_var_type_set_global_count()
    EMIT_FILE_IDX = -1
    mut cg = codegen_new()
    declare_all_fns()
    let declared_count = forge_fn_store_count()
    eprintln("  declared " + string(declared_count) + " fns")
    // Materialize struct types before emitting function bodies
    materialize_struct_types()
    // Emit each function body — use C-side fn store count (Forge FN_NAMES.length is corrupt in Stage 2)
    mut param_offset = 0
    mut fi = 0
    let total_fns = forge_fn_store_count()
    while fi < total_fns {
        mut pc = 0
        if fi < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[fi] }
        // Use C-side body store (immune to Forge list index misalignment)
        let bsrc = forge_fn_store_get_body(fi)
        if bsrc.length > 0 {
            emit_fn_body_from_source(cg, fi, param_offset)
        }
        param_offset = param_offset + pc
        fi = fi + 1
    }
    codegen_write_ir("output.ll")
    forge_alloca_cache_stats()
    eprintln("  emit done")

    // Use external llc for object emission
    // Note: use output.ll (CWD) — second codegen_write_ir may produce empty module
    let ir_path = "output.ll"
    let obj_path = output + ".o"
    codegen_cleanup()
    let llc_result = process.run("/opt/homebrew/opt/llvm@18/bin/llc", [ir_path, "-filetype=obj", "-o", obj_path, "--disable-verify"])

    // Compile runtime
    let runtime_obj = "/tmp/forgec_runtime.o"
    let rt_result = process.run("cc", ["-c", "-O0", "stdlib/runtime.c", "-o", runtime_obj])

    // Link
    let link_result = process.run("cc", ["-o", output, obj_path, runtime_obj, "-lm"])

    println("compiled: " + output)
}

fn build_compile_single(input_file: string, output: string) {
    // Single-file build: read, scan, compile
    eprintln("BC: reading " + input_file)
    let source = fs.read(input_file)
    eprintln("BC: read " + string(source.length) + " bytes")
    mut lex = lexer_new(source)
    let tokens = lex.tokenize()
    eprintln("BC: " + string(tokens.length) + " tokens")
    mut p = parser_new_with_source(tokens, source)
    p.parse_program()
    eprintln("BC: parsed, " + string(forge_fn_store_count()) + " fns")

    // Phase 2: Single LLVM module — declare all, then emit bodies
    codegen_init("forgec_output")
    create_globals_typed(VAR_GLOBAL_NAMES, VAR_GLOBAL_STR_MASK)
    forge_str_var_set_global_count()
    forge_var_type_set_global_count()
    EMIT_FILE_IDX = -1
    mut cg = codegen_new()
    declare_all_fns()
    let bc_fn_count = forge_fn_store_count()
    eprintln("  declared " + string(bc_fn_count) + " fns")
    // Emit each function body (parse once, emit once — no re-declaration)
    mut param_offset = 0
    mut fi = 0
    while fi < bc_fn_count {
        mut pc = 0
        if fi < FN_PARAM_COUNTS.length { pc = FN_PARAM_COUNTS[fi] }
        let bsrc = forge_fn_store_get_body(fi)
        if bsrc.length > 0 {
            eprintln("  >> " + string(fi))
            emit_fn_body_from_source(cg, fi, param_offset)
            eprintln("    [" + string(fi) + "] " + forge_fn_store_get_name(fi))
        }
        param_offset = param_offset + pc
        fi = fi + 1
    }
    codegen_write_ir("output.ll")
    eprintln("  emit done")

    // Use external llc for object emission (in-process LLVM emitter crashes)
    let ir_path = "/tmp/forgec_out.ll"
    let obj_path = output + ".o"
    codegen_write_ir(ir_path)
    codegen_cleanup()
    let llc_result = process.run("/opt/homebrew/opt/llvm@18/bin/llc", [ir_path, "-filetype=obj", "-o", obj_path, "--disable-verify"])
    mut obj_files: List<string> = [obj_path]

    // Phase 3: Compile runtime
    let runtime_obj = "/tmp/forgec_runtime.o"
    let rt_result = process.run("cc", ["-c", "-O0", "stdlib/runtime.c", "-o", runtime_obj])

    // Phase 4: Link all .o files
    mut link_args: List<string> = ["-o", output]
    for obj in obj_files {
        link_args = link_args.push(obj)
    }
    link_args = link_args.push(runtime_obj)
    link_args = link_args.push("-lm")
    let link_result = process.run("cc", link_args)

    println("compiled: ${output}")
}

fn main() {
    init_features()
    let args = process.args()

    if args.length < 3 {
        eprintln("forgec v0.1.0 - self-hosted Forge compiler")
        eprintln("Usage: forgec <check|build> <file.fg>")
        process.exit(1)
    }

    let command = forge_selfhost_get_arg(1)
    let input = forge_selfhost_get_arg(2)

    // Reset CSV BEFORE any branching (avoids emit_assign-in-if bug)
    MODULE_PATHS_CSV = ""

    eprintln("M:argc=" + string(args.length))
    eprintln("M:cmd=[" + command + "]")
    if command == "check" {
        // For check: concatenate and check as one unit
        let source = resolve_modules(input)
        if !check(source, input) {
            process.exit(1)
        }
        println("OK")
    } else if command == "build" {
        mut output = "a.out"
        if args.length > 3 { output = forge_selfhost_get_arg(3) }
        forge_mod_csv_clear()
        collect_module_paths(input)
        eprintln("M:csv_len=" + string(MODULE_PATHS_CSV.length))
        build_compile_separate(MODULE_PATHS_CSV, output)
    } else {
        eprintln("unknown command")
        process.exit(1)
    }
}
