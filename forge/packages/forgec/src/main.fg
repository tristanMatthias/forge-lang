// ─── Forge Compiler (Self-Hosted) ──────────────

use @std.process
use @std.fs
use @std.llvm

mod core
mod lexer
mod parser
mod checker
mod codegen
mod features

use features

use core.error.{render_diagnostic, render_all}
use lexer.{lexer_new}
use parser.{parser_new}
use checker.{type_checker_new}
use codegen.{codegen_new}

fn parse_source(source: string, filename: string) -> Program? {
    mut lex = lexer_new(source)
    let tokens = lex.tokenize()

    if lex.diagnostics.length > 0 {
        for d in lex.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
    }

    mut p = parser_new(tokens)
    let program = p.parse_program()

    if p.diagnostics.length > 0 {
        for d in p.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
        return null
    }

    mut tc = type_checker_new()
    tc.check_program(program)

    if tc.diagnostics.has_errors {
        let output = render_all(tc.diagnostics, source, filename)
        eprintln(output)
        return null
    }

    program
}

fn check(source: string, filename: string) -> bool {
    let program = parse_source(source, filename)
    program != null
}

fn build(source: string, filename: string, output: string) -> bool {
    let program = parse_source(source, filename)
    if program == null {
        return false
    }

    mut cg = codegen_new()
    cg.init(filename)
    cg.emit_program(program!)

    if !cg.verify() {
        eprintln("LLVM verification failed")
        cg.dispose()
        return false
    }
    eprintln("build: verified OK")

    cg.dispose()
    println("build: codegen complete (linking not yet implemented)")
    true
}

fn main() {
    let args = process.args()

    if args.length < 3 {
        eprintln("forgec v0.1.0 - self-hosted Forge compiler")
        eprintln("Usage: forgec <check|build> <file.fg> [output]")
        process.exit(1)
    }

    let command = args[1]
    let input = args[2]

    if command == "check" {
        let source = fs.read(input)
        if !check(source, input) {
            process.exit(1)
        }
        println("OK")
    } else if command == "build" {
        let source = fs.read(input)
        let output = if args.length > 3 { args[3] } else { "a.out" }
        if !build(source, input, output) {
            process.exit(1)
        }
    } else {
        eprintln("unknown command")
        process.exit(1)
    }
}
