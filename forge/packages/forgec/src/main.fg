// ─── Forge Compiler (Self-Hosted) ──────────────

use @std.process
use @std.fs
use @std.llvm

mod core
mod lexer
mod parser
mod checker
mod codegen
mod features

use features

use core.error.{render_diagnostic, render_all}
use lexer.{lexer_new}
use parser.{parser_new}
use checker.{type_checker_new}
use codegen.{codegen_new}
use core.registry.{reg_parser, reg_check_stmt, reg_check_expr, reg_emit_stmt, reg_emit_expr, reg_top_level}

fn check(source: string, filename: string) -> bool {
    mut lex = lexer_new(source)
    let tokens = lex.tokenize()

    if lex.diagnostics.length > 0 {
        for d in lex.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
    }

    mut p = parser_new(tokens)
    let program = p.parse_program()

    if p.diagnostics.length > 0 {
        for d in p.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
        return false
    }

    mut tc = type_checker_new()
    tc.check_program(program)

    if tc.diagnostics.has_errors {
        let output = render_all(tc.diagnostics, source, filename)
        eprintln(output)
        return false
    }

    true
}

fn build_compile(source: string, filename: string, output: string) {
    mut lex = lexer_new(source)
    let tokens = lex.tokenize()

    if lex.diagnostics.length > 0 {
        for d in lex.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
    }

    mut p = parser_new(tokens)
    let program = p.parse_program()
    eprintln("build: ${program.statements.length} stmts parsed")

    if p.diagnostics.length > 0 {
        for d in p.diagnostics {
            eprintln(render_diagnostic(d, source, filename))
        }
        process.exit(1)
    }

    mut tc = type_checker_new()
    tc.check_program(program)

    if tc.diagnostics.has_errors {
        let output = render_all(tc.diagnostics, source, filename)
        eprintln(output)
        process.exit(1)
    }

    let has_fn = REG_PARSE.has("fn")
    let has_let = REG_PARSE.has("let")
    eprintln("has fn:")
    eprintln(has_fn)
    eprintln("has let:")
    eprintln(has_let)
    codegen_init(filename)
    mut cg = codegen_new()
    cg.emit_program(program)
    codegen_write_ir("output.ll")
    codegen_cleanup()
    println("wrote output.ll")
}

fn main() {
    init_features()
    let args = process.args()

    if args.length < 3 {
        eprintln("forgec v0.1.0 - self-hosted Forge compiler")
        eprintln("Usage: forgec <check|build> <file.fg>")
        process.exit(1)
    }

    let command = args[1]
    let input = args[2]

    if command == "check" {
        let source = fs.read(input)
        if !check(source, input) {
            process.exit(1)
        }
        println("OK")
    } else if command == "build" {
        let source = fs.read(input)
        let output = if args.length > 3 { args[3] } else { "a.out" }
        build_compile(source, input, output)
    } else {
        eprintln("unknown command")
        process.exit(1)
    }
}
