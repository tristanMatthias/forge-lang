// ─── loops.fg ──────────────────────────────────
// Tests while loops, for loops, ranges.
//
// Expected output:
//   10
//   hello hello hello
//   45

fn main() {
    // While loop
    mut count = 0
    while count < 10 {
        count = count + 1
    }
    println(string(count))

    // For loop with range
    mut msg = ""
    for i in 0..3 {
        if msg != "" {
            msg = msg + " "
        }
        msg = msg + "hello"
    }
    println(msg)

    // For accumulation
    mut sum = 0
    for i in 0..10 {
        sum = sum + i
    }
    println(string(sum))
}
