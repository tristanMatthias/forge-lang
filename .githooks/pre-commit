#!/usr/bin/env bash
# Stage 3 regression guard. Skips if no forge/ files are staged.
# Bypass with `git commit --no-verify` if intentional.

set -e

# Only run when staged changes touch the forge subtree.
if ! git diff --cached --name-only | grep -q '^forge/'; then
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
exec bash "$REPO_ROOT/forge/scripts/check_stage3_progress.sh"
