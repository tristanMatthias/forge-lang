// `avra lang` — generate the executable language reference.
//
// Walks the compiler's keyword + diagnostic tables and emits each
// entry as a /// documented Avra const. The CLI's docs command (after
// x35m.6's --scope=lang) reads this file via the AST extractor.

use core.{avra_selfhost_write_file}
use diagnostics.{DiagCode, error_def}
use parse.{keyword_rules}
use core.{Tk}

// DERIVED from `keyword_rules()` (parse/token_table.av) — the single source
// of truth for the spelling->token binding, and what the generated byte-trie
// `classify_keyword` is compiled from.
//
// These were TWO HAND-MAINTAINED CSV LITERALS carrying this comment:
//
//     // Mirrored from p_keyword_kind in src/parse/mod.av. CI verifies the
//     // generator stays in sync with that table.
//
// All three claims were false. There was no CI check. `p_keyword_kind` has not
// held a keyword table since it became a wrapper over the generated trie. And
// the lists had ALREADY DRIFTED — 43 entries against 60 rows, missing
// `channel`, `isolated`, `none` and `quote`, so four real keywords were absent
// from every generated tooling artifact. A comment asserting a gate that does
// not exist is worse than no comment: it reads as a reason not to check.
//
// Deriving is the fix, not adding the four missing words — that restores the
// drift a week later. The split between active and reserved is derivable too:
// every reserved future keyword collapses to `Tk.KwReserved`, which is exactly
// what distinguishes the two lists.
export fn active_keywords() -> List<string> {
    mut out: List<string> = []
    for r in keyword_rules() {
        if r.tk != Tk.KwReserved { out.push(r.spelling) }
    }
    out
}

export fn reserved_keywords() -> List<string> {
    mut out: List<string> = []
    for r in keyword_rules() {
        if r.tk == Tk.KwReserved { out.push(r.spelling) }
    }
    out
}

// (DiagCode, variant_name) pairs — variant_name lives here because
// Avra has no enum-name reflection. error_def(code) provides the
// F-code + help text from a single source of truth in diagnostics/.
fn render_diag_section() -> string {
    mut out = "// ── Error codes ─────────────────────────────────────────────\n\n"
    out = out + render_one_diag(DiagCode.SyntaxError, "SyntaxError")
    out = out + render_one_diag(DiagCode.BadNumber, "BadNumber")
    out = out + render_one_diag(DiagCode.ExpectedBlock, "ExpectedBlock")
    out = out + render_one_diag(DiagCode.MismatchedParen, "MismatchedParen")
    out = out + render_one_diag(DiagCode.MismatchedBracket, "MismatchedBracket")
    out = out + render_one_diag(DiagCode.MismatchedBrace, "MismatchedBrace")
    out = out + render_one_diag(DiagCode.ExpectedArrow, "ExpectedArrow")
    out = out + render_one_diag(DiagCode.UnterminatedString, "UnterminatedString")
    out = out + render_one_diag(DiagCode.UnterminatedTemplate, "UnterminatedTemplate")
    out = out + render_one_diag(DiagCode.ExpectedForVar, "ExpectedForVar")
    out = out + render_one_diag(DiagCode.ExpectedIn, "ExpectedIn")
    out = out + render_one_diag(DiagCode.ExpectedExpression, "ExpectedExpression")
    out = out + render_one_diag(DiagCode.UnexpectedSemicolon, "UnexpectedSemicolon")
    out = out + render_one_diag(DiagCode.TypeMismatch, "TypeMismatch")
    out = out + render_one_diag(DiagCode.WrongArgCount, "WrongArgCount")
    out = out + render_one_diag(DiagCode.CannotInferTypeParam, "CannotInferTypeParam")
    out = out + render_one_diag(DiagCode.UndefinedVariable, "UndefinedVariable")
    out = out + render_one_diag(DiagCode.ImmutableAssign, "ImmutableAssign")
    out = out + render_one_diag(DiagCode.ModuleNotFound, "ModuleNotFound")
    out = out + render_one_diag(DiagCode.ImportNotFound, "ImportNotFound")
    out = out + render_one_diag(DiagCode.ImportPrivate, "ImportPrivate")
    out = out + render_one_diag(DiagCode.CircularImport, "CircularImport")
    out = out + render_one_diag(DiagCode.OrphanImpl, "OrphanImpl")
    out = out + render_one_diag(DiagCode.NonExhaustiveMatch, "NonExhaustiveMatch")
    out = out + render_one_diag(DiagCode.UnusedImport, "UnusedImport")
    out = out + render_one_diag(DiagCode.NamingConvention, "NamingConvention")
    out = out + render_one_diag(DiagCode.ICE, "ICE")
    out = out + render_one_diag(DiagCode.RuntimeNullDeref, "RuntimeNullDeref")
    out = out + render_one_diag(DiagCode.RuntimeDivByZero, "RuntimeDivByZero")
    out = out + render_one_diag(DiagCode.RuntimeIndexOOB, "RuntimeIndexOOB")
    out = out + render_one_diag(DiagCode.RuntimeMatchFallthrough, "RuntimeMatchFallthrough")
    out = out + render_one_diag(DiagCode.RuntimeStackOverflow, "RuntimeStackOverflow")
    out = out + render_one_diag(DiagCode.RuntimeNullArg, "RuntimeNullArg")
    out
}

fn render_one_diag(code: DiagCode, name: string) -> string {
    let def = error_def(code)
    let help = if def.help == "" {
        "${name} — see compiler diagnostics for details."
    } else {
        def.help
    }
    "/// ${def.code} — ${help}\nexport const ${def.code} = \"${name}\"\n\n"
}

fn render_keyword_section() -> string {
    mut out = "// ── Keywords ────────────────────────────────────────────────\n\n"
    for kw in active_keywords() {
        out = "${out}/// keyword `${kw}`\nexport const KW_${kw.to_upper()} = \"${kw}\"\n\n"
    }
    out = "${out}// ── Reserved keywords (not yet active in v1.0) ──────────────\n\n"
    for kw in reserved_keywords() {
        out = "${out}/// reserved keyword `${kw}`\nexport const RESERVED_${kw.to_upper()} = \"${kw}\"\n\n"
    }
    out
}

fn render_header() -> string {
    "// AUTOGENERATED by `avra lang` — do not edit by hand.\n// Regenerate when keywords or error codes change.\n\n"
}

export fn render_lang_av() -> string {
    "${render_header()}${render_keyword_section()}${render_diag_section()}"
}

export fn write_lang_av(path: string) -> int {
    avra_selfhost_write_file(path, render_lang_av())
}
