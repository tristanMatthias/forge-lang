// WHY: L1 node-model foundation (ps3t.3.2 + the ingest half of the shim
// ps3t.3.7 / spine §14.1, §14.6). Per-type arena stores + typed-id
// newtypes for ALL FOUR node kinds (Expr/Stmt/Pattern/ValueType), plus a
// RECURSIVE, id-based ingest that flattens the live pointer-tree into the
// arenas — child/cross references become typed ids (the array-of-nodes-now
// form, §14.1), proving "pointer-tree access removed" within the store.
//
// ADDITIVE (bootstrap window, §14.6 step 1): lands ALONGSIDE the existing
// SExpr/SStmt; changes no variant, so it builds on the current pinned seed.
// The arenas store today's boxed nodes addressed by index, and a parallel
// child-id side-table records the typed-id edges between them. The
// data-oriented end-state — nodes literally holding child *ids*
// (Binary(ExprId,op,ExprId)) and the compiler PASSES reading from here
// instead of the pointer-tree — is the seed-gated pass migration that
// §14.6 stages AFTER this foundation (tickets ps3t.3.7 + per-pass work).
//
// Typed ids are OPAQUE HANDLES (compare / look up, never inspect): typeck
// keeps ExprId / StmtId / PatId / TypeId nominally distinct (passing a
// StmtId where an ExprId is wanted is a type error — see arena_test.av).
// Construct `StmtId(i)`, peel with `.raw()` inside this module only.
//
// The recursion is driven by the derive_walker-generated `children()`
// method on each AST enum (features/walker), so it needs no per-variant
// hand-rolled match here and stays correct as variants are added. The
// per-node edge lists use a one-field wrapper struct (`*Edges`) rather
// than `List<List<Id>>`: the current seed lexes the closing `>>` as a
// shift token, so nested generics are seed-gated — the wrapper is the
// additive equivalent.

use core.{Expr, Stmt, Pattern, ValueType, SStmt}

/// Index into the Expr arena — nominally distinct from StmtId/PatId/TypeId/int.
export type ExprId = int
/// Index into the Stmt arena.
export type StmtId = int
/// Index into the Pattern arena.
export type PatId = int
/// Index into the ValueType arena.
export type TypeId = int

/// The direct child `ExprId` edges of one node (wrapper dodges `List<List<>>`).
export type ExprEdges = { ids: List<ExprId> }
/// The direct child `StmtId` edges of one node.
export type StmtEdges = { ids: List<StmtId> }
/// The direct child `PatId` edges of one node.
export type PatEdges = { ids: List<PatId> }
/// The direct child `TypeId` edges of one node.
export type TypeEdges = { ids: List<TypeId> }

/// Append-only arena of `Expr` nodes, addressed by `ExprId`. `nodes[i]` is
/// the boxed node (array-of-nodes-now, §14.1); `edges[i]` is the dense
/// side-table of that node's direct child `ExprId`s — the typed-id edges
/// that replace pointer-tree navigation inside the store.
export type ExprArena = { nodes: List<Expr>, edges: List<ExprEdges> }
impl ExprArena {
    /// Recursively ingest `node` (post-order: children first so their ids
    /// exist before the parent records them), returning the parent's id.
    /// allocate = append; cross references are typed `ExprId`s, never
    /// owned sub-nodes.
    fn ingest(self, node: Expr) -> ExprId {
        let mut kid_ids: List<ExprId> = []
        for c in node.children() {
            kid_ids.push(self.ingest(c))
        }
        let id = self.nodes.length
        self.nodes.push(node)
        self.edges.push(ExprEdges { ids: kid_ids })
        ExprId(id)
    }
    fn get(self, id: ExprId) -> Expr { self.nodes[id.raw()] }
    /// Navigate by id, not by pointer — the L1 access discipline.
    fn children_of(self, id: ExprId) -> List<ExprId> { self.edges[id.raw()].ids }
    fn count(self) -> int { self.nodes.length }
}

/// Append-only arena of `Stmt` nodes, addressed by `StmtId`.
export type StmtArena = { nodes: List<Stmt>, edges: List<StmtEdges> }
impl StmtArena {
    fn ingest(self, node: Stmt) -> StmtId {
        let mut kid_ids: List<StmtId> = []
        for c in node.children() {
            kid_ids.push(self.ingest(c))
        }
        let id = self.nodes.length
        self.nodes.push(node)
        self.edges.push(StmtEdges { ids: kid_ids })
        StmtId(id)
    }
    fn get(self, id: StmtId) -> Stmt { self.nodes[id.raw()] }
    fn children_of(self, id: StmtId) -> List<StmtId> { self.edges[id.raw()].ids }
    fn count(self) -> int { self.nodes.length }
}

/// Append-only arena of `Pattern` nodes, addressed by `PatId`.
export type PatArena = { nodes: List<Pattern>, edges: List<PatEdges> }
impl PatArena {
    fn ingest(self, node: Pattern) -> PatId {
        let mut kid_ids: List<PatId> = []
        for c in node.children() {
            kid_ids.push(self.ingest(c))
        }
        let id = self.nodes.length
        self.nodes.push(node)
        self.edges.push(PatEdges { ids: kid_ids })
        PatId(id)
    }
    fn get(self, id: PatId) -> Pattern { self.nodes[id.raw()] }
    fn children_of(self, id: PatId) -> List<PatId> { self.edges[id.raw()].ids }
    fn count(self) -> int { self.nodes.length }
}

/// Append-only arena of `ValueType` nodes, addressed by `TypeId` — the
/// fourth node kind (§14.1: "Expr/Stmt/Pattern/ValueType, each in its own
/// dense arena"). Type trees flatten the same way (e.g. `List<T>`'s element
/// type becomes a child `TypeId`).
export type TypeArena = { nodes: List<ValueType>, edges: List<TypeEdges> }
impl TypeArena {
    fn ingest(self, node: ValueType) -> TypeId {
        let mut kid_ids: List<TypeId> = []
        for c in node.children() {
            kid_ids.push(self.ingest(c))
        }
        let id = self.nodes.length
        self.nodes.push(node)
        self.edges.push(TypeEdges { ids: kid_ids })
        TypeId(id)
    }
    fn get(self, id: TypeId) -> ValueType { self.nodes[id.raw()] }
    fn children_of(self, id: TypeId) -> List<TypeId> { self.edges[id.raw()].ids }
    fn count(self) -> int { self.nodes.length }
}

/// The L1 store: one dense arena per node kind, the data-oriented
/// replacement for the boxed pointer-tree. Built by `ingest_program`.
export type NodeStore = {
    exprs: ExprArena,
    stmts: StmtArena,
    pats: PatArena,
    types: TypeArena,
}

/// Construct an empty store with all four arenas.
export fn new_node_store() -> NodeStore {
    NodeStore {
        exprs: ExprArena { nodes: [], edges: [] },
        stmts: StmtArena { nodes: [], edges: [] },
        pats: PatArena { nodes: [], edges: [] },
        types: TypeArena { nodes: [], edges: [] },
    }
}

/// Compat shim (ingest direction, ps3t.3.7): flatten a parsed statement
/// list into the store's StmtArena, recursively (every nested statement
/// gets an id, edges recorded as typed StmtIds). The first real, reachable
/// consumer of the arena store; later increments migrate passes to read
/// from it instead of the SStmt pointer-tree.
export fn ingest_program(stmts: List<SStmt>) -> NodeStore {
    let store = new_node_store()
    for s in stmts {
        let _ = store.stmts.ingest(s.node)
    }
    store
}

/// Back-compat thin wrapper (the original ingest entry): just the stmt
/// arena of a fully ingested program.
export fn ingest_stmts(stmts: List<SStmt>) -> StmtArena {
    ingest_program(stmts).stmts
}
