// WHY: Central type identity system — ONE place to register, ONE place to look up.
// Every type gets a unique integer TypeId. All registries use O(1) intmap lookups.
// String names are kept only for diagnostics and LLVM type name generation.

use core.{FieldEntry, Variant, ValueType}
use core.{avra_intmap_new, avra_intmap_set, avra_intmap_get, avra_intmap_has, avra_map_new_cstr, avra_map_set_cstr, avra_map_get_cstr, avra_map_has_cstr}
use core.{avra_intmap_inc, avra_intmap_get_as_string}

/// Categorical kind for a registered type — drives codegen layout
/// decisions (struct vs enum tagged-union, newtype passthrough, etc.).
export enum TypeKind {
    /// Nominal record: `type Foo = { a: int, b: string }`.
    StructKind,
    /// Sum type with named variants and optional payloads.
    EnumKind,
    /// Trait declaration — interface for `impl Trait for Type`.
    TraitKind,
    /// Wrapper around a single inner type: `type UserId = UUID`.
    NewtypeKind,
    /// Union type alias: `type Json = string | int | bool`.
    UnionAliasKind,
    /// Structural shape: width-subtyping record, no nominal identity.
    ShapeKind,
}

/// Everything the compiler needs to know about a registered type,
/// looked up by integer TypeId. Allocated once per type, cached in
/// the TypeRegistry's info_map.
/// @field id        — unique integer identity, stable for a build.
/// @field name      — fully-qualified canonical name.
/// @field kind      — TypeKind discriminant.
/// @field fields    — populated for StructKind / ShapeKind.
/// @field variants  — populated for EnumKind.
/// @field inner_vt  — populated for NewtypeKind / UnionAliasKind.
export type TypeInfo = {
    id: int,
    name: string,
    kind: TypeKind,
    fields: List<FieldEntry>,
    variants: List<Variant>,
    inner_vt: ValueType,
}

/// Single source of truth for type identity. Replaces the historic
/// "string-name everywhere" approach with O(1) integer ids and
/// constant-time name ↔ id lookups. Pass-by-value (the maps are
/// pointers — copying TypeRegistry shares the underlying tables).
/// @field infos      — List<TypeInfo>: id-1 indexed (id 0 reserved
///                     as the "no such type" sentinel). Was an
///                     avra_intmap with hard 256-slot cap before
///                     forge-crafting-intepreters-q3gp follow-up;
///                     bundle compiles overflowed at ~280 types.
/// @field name_to_id — string-keyed map: qualified name → id.
/// @field id_to_name — intmap: id → name string ptr.
export type TypeRegistry = {
    infos: List<TypeInfo>,
    name_to_id: ptr,
    id_to_name: ptr,
}


/// Construct an empty registry. The id counter starts at 1 — id 0 is
/// reserved as the "no such type" sentinel returned by lookups.
export fn type_registry_new() -> TypeRegistry {
    TypeRegistry {
        infos: [],
        name_to_id: avra_map_new_cstr(),
        id_to_name: avra_intmap_new(),
    }
}

/// Register a type. Idempotent — re-registering an existing name
/// returns the original id without reallocating the TypeInfo. Also
/// indexes the unqualified short name (`Foo` for `module::Foo`) when
/// the short form is unambiguous.
/// @returns the assigned TypeId, or the existing id on duplicate.
export fn type_registry_register(reg: TypeRegistry, name: string, kind: TypeKind, fields: List<FieldEntry>, variants: List<Variant>, inner_vt: ValueType) -> int {
    // If already registered, return existing id
    if avra_map_has_cstr(reg.name_to_id, name) == 1 {
        return avra_map_get_cstr(reg.name_to_id, name)
    }
    // List-backed: id is 1-indexed position. id 0 stays the sentinel.
    mut infos = reg.infos
    let id = infos.length + 1
    let info = TypeInfo { id, name, kind, fields, variants, inner_vt }
    infos.push(info)
    avra_map_set_cstr(reg.name_to_id, name, id)
    avra_intmap_set(reg.id_to_name, id, name)
    // Also register short name (last segment after ::) for codegen lookups
    if name.contains("::") {
        let parts = name.split("::")
        let short = parts[parts.length - 1]
        if avra_map_has_cstr(reg.name_to_id, short) == 0 {
            avra_map_set_cstr(reg.name_to_id, short, id)
        }
    }
    id
}

/// Look up the TypeInfo for a given id. Returns null when the id is
/// out of range — callers should branch on null rather than poking
/// at a dummy struct.
export fn type_registry_lookup(reg: TypeRegistry, id: int) -> TypeInfo? {
    if id == 0 { return null }
    let i = id - 1
    if i < 0 || i >= reg.infos.length { return null }
    reg.infos[i]
}

/// Resolve a type name to its TypeId. Returns 0 when the name has
/// not been registered (lets callers branch on the sentinel without
/// pattern-matching on Option).
export fn type_registry_id_for(reg: TypeRegistry, name: string) -> int {
    if avra_map_has_cstr(reg.name_to_id, name) == 0 { return 0 }
    avra_map_get_cstr(reg.name_to_id, name)
}

/// True iff `id` corresponds to a registered type. Cheap O(1) probe;
/// use this before treating a non-zero id as valid.
export fn type_registry_has(reg: TypeRegistry, id: int) -> bool {
    id > 0 && (id - 1) < reg.infos.length
}


/// Reverse lookup: TypeId → canonical name. Returns "" for unknown
/// ids; the empty string acts as a sentinel paralleling 0 from
/// `type_registry_id_for`.
export fn type_registry_name_for(reg: TypeRegistry, id: int) -> string {
    if id == 0 { return "" }
    if avra_intmap_has(reg.id_to_name, id) == 0 { return "" }
    avra_intmap_get_as_string(reg.id_to_name, id)
}

/// True iff the given name has been registered. Equivalent to
/// `type_registry_id_for(reg, name) != 0` but skips the integer
/// fetch when the caller only needs presence.
export fn type_registry_has_name(reg: TypeRegistry, name: string) -> bool {
    avra_map_has_cstr(reg.name_to_id, name) == 1
}

// ── Centralized name generation ──
//
// The ONLY functions that produce `::` or `__` in type / method
// names. Single point of change if the naming convention ever moves.

/// Build a module-qualified name. Empty module returns `name` bare —
/// used by passes that may emit either top-level or nested decls.
/// Example: `("codegen::types", "Ctx") → "codegen::types::Ctx"`.
export fn type_qualified_name(module: string, name: string) -> string {
    if module == "" { name } else { "${module}::${name}" }
}

/// Mangle a method into its dispatch symbol. Example:
/// `("Point", "distance") → "Point__distance"`. The double underscore
/// avoids collisions with user identifiers (Avra forbids `__` in
/// hand-written names per spec Axis 28).
export fn method_mangled_name(type_name: string, method: string) -> string {
    "${type_name}__${method}"
}

/// Build the payload struct name for an enum variant. Example:
/// `("Option", "Some") → "Option__Some"`. Each variant with a payload
/// gets its own struct in codegen so GEPs are statically typed.
export fn variant_payload_name(enum_name: string, variant: string) -> string {
    "${enum_name}__${variant}"
}

/// Join two name segments with `__`. Used by the monomorphizer for
/// generic type mangling: `("Result", "int__string")` →
/// `"Result__int__string"`.
export fn mangle_join(a: string, b: string) -> string {
    "${a}__${b}"
}

/// Strip the module prefix from a qualified name. Returns the input
/// unchanged when no `::` is present.
/// Example: `"codegen::types::Ctx" → "Ctx"`.
///
/// `@comptime` so derive_walker / quote_expr / future @expand macros
/// can call this directly instead of duplicating the scan logic. Uses
/// back-scanning string indexing (no `.split` allocation) for both
/// runtime efficiency and @comptime eval compatibility (`.split` is
/// not yet in the @comptime evaluator's string method surface).
@comptime
export fn type_short_name(name: string) -> string {
    if name == "" { return "" }
    let len = name.length
    mut i = len - 1
    while i > 0 {
        if name[i] == ":" && name[i - 1] == ":" {
            return name.substring(i + 1, len)
        }
        i = i - 1
    }
    name
}

/// Heuristic: a name is method-mangled if it contains `__`. Cheap;
/// false positives are impossible because user identifiers can't
/// contain `__` (spec Axis 28).
export fn is_mangled_method(name: string) -> bool {
    name.contains("__")
}

/// Extract the method portion of a mangled name.
/// Example: `"Type__method" → "method"`. Returns `name` unchanged
/// when not mangled (no `__`).
export fn method_from_mangled(name: string) -> string {
    let parts = name.split("__")
    if parts.length > 1 { parts[1] } else { name }
}

/// Build the registry key for a trait impl: `"Trait:Type"`. Single
/// `:` (not `::`) to keep impl entries distinct from qualified type
/// names in the same lookup tables.
export fn trait_impl_name(trait_name: string, type_name: string) -> string {
    "${trait_name}:${type_name}"
}

/// True when `name` refers to the built-in Result enum, accepting any
/// of these shapes:
///   - `"Result"`                       — unqualified, non-mono
///   - `"Result__int__string"`          — unqualified, monomorphized
///   - `"<module>::Result"`             — qualified, non-mono
///   - `"<module>::Result__int__string"` — qualified, monomorphized
/// Used by `?` operator codegen and Try-expression typecheck so any
/// Result-shaped enum (regardless of module wrap) is recognised.
///
/// For user-defined Result-shaped enums (`enum MyResult { Ok, Err }`),
/// use `is_result_shaped_enum` against the type registry instead.
export fn is_result_enum_name(name: string) -> bool {
    let short = type_short_name(name)
    short == "Result" || short.starts_with("Result__")
}

/// Structural check: an enum is Result-shaped when it has both an
/// `Ok` and an `Err` variant (payload types ignored). This lets the
/// `?` operator and errdefer routing accept user-defined Result-likes
/// (MyResult, TrResult, etc.) without naming convention coupling.
export fn is_result_shaped_enum(reg: TypeRegistry, enum_name: string) -> bool {
    if is_result_enum_name(enum_name) { return true }
    let id = type_registry_id_for(reg, enum_name)
    if id == 0 { return false }
    let opt = type_registry_lookup(reg, id)
    if opt == null { return false }
    let info = opt!
    match info.kind { .EnumKind -> {}, _ -> { return false } }
    mut ok = false
    mut err = false
    mut i = 0
    while i < info.variants.length {
        let n = info.variants[i].name
        if n == "Ok" { ok = true }
        if n == "Err" { err = true }
        i = i + 1
    }
    ok && err
}
