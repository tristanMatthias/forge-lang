// WHY: AST node definitions — the single source of truth for Expr,
// Stmt, Pattern, and their recursive list types. Pure data only;
// all logic (parsing, resolution, codegen) lives elsewhere.

// ── Spanned wrappers ──
//
// Every Expr / Stmt in the AST is wrapped in a span carrier so error
// messages and the LSP can point at the originating source range
// without an out-of-band side-table. Carriers also park the inferred
// ValueType (SExpr only) so passes can read types without a separate
// annotation layer.

/// Spanned expression. `line`/`col` are 1-based source coordinates;
/// `ty` is the inferred ValueType (Unknown until typecheck runs);
/// `file` is the source file path (empty for synthesised nodes).
/// Carrying `file` per-node lets diagnostics in multi-file bundles
/// (test runner, future incremental compilation) cite the
/// originating file rather than a `<bundle>` placeholder.
export type SExpr = { node: Expr, line: int, col: int, ty: ValueType, file: string }

/// Spanned statement. Mirrors SExpr but without the cached type —
/// statements have no result value to track.
export type SStmt = { node: Stmt, line: int, col: int, file: string }

/// Build an SExpr at a known source position. File defaults to "" —
/// use `sexpr_at` when the source file is known.
export fn sexpr(e: Expr, line: int, col: int) -> SExpr { SExpr { node: e, line, col, ty: ValueType.Unknown, file: "" } }

/// Build an SExpr at a known source position with explicit file.
export fn sexpr_at(e: Expr, line: int, col: int, file: string) -> SExpr { SExpr { node: e, line, col, ty: ValueType.Unknown, file } }

/// Build an SExpr with no source position. Used by passes that
/// synthesise nodes (desugar, monomorphizer) where line/col would be
/// misleading.
export fn sexpr_dummy(e: Expr) -> SExpr { SExpr { node: e, line: 0, col: 0, ty: ValueType.Unknown, file: "" } }

/// Build a fully-annotated SExpr. Used by the typechecker to attach
/// a known type without mutating the existing wrapper.
export fn sexpr_typed(e: Expr, line: int, col: int, ty: ValueType) -> SExpr { SExpr { node: e, line, col, ty, file: "" } }

/// Build an SStmt at a known source position. File defaults to "".
export fn sstmt(s: Stmt, line: int, col: int) -> SStmt { SStmt { node: s, line, col, file: "" } }

/// Build an SStmt at a known source position with explicit file.
export fn sstmt_at(s: Stmt, line: int, col: int, file: string) -> SStmt { SStmt { node: s, line, col, file } }

/// Build an SStmt with no source position. Same caveats as
/// `sexpr_dummy` — synthesised nodes only.
export fn sstmt_dummy(s: Stmt) -> SStmt { SStmt { node: s, line: 0, col: 0, file: "" } }

/// Linked list of expressions. Used for call args, list literals,
/// and any other comma-separated expression sequence.
export enum ExprList {
    End
    Node(expr: SExpr, next: ExprList)
}

/// Function parameter list. Each param carries its resolved
/// ValueType — populated by the resolver, used by typecheck and
/// codegen for arity and ABI matching.
export enum ParamList {
    End
    Node(name: string, resolved: ValueType, next: ParamList)
}

/// Struct field declaration list — used in `type Foo = { f1: int, f2: string }`.
export enum FieldList {
    End
    Node(name: string, resolved: ValueType, next: FieldList)
}

/// Field initializer list — used in literal construction like
/// `Foo { f1: 1, f2: "hi" }`.
export enum FieldInitList {
    End
    Node(name: string, value: SExpr, next: FieldInitList)
}

/// Variant of an enum declaration. Each variant has zero or more
/// payload fields, stored as a FieldList so the same renderer works
/// for both struct fields and variant payloads.
export enum VariantList {
    End
    Node(name: string, fields: FieldList, next: VariantList)
}

/// Recursive pattern list for nested pattern matching:
/// `match v { .Some(.Ok(x)) -> ... }` builds nested NestedVariant
/// patterns whose sub-patterns live in this list.
export enum PatternList {
    End
    Node(pattern: Pattern, next: PatternList)
}

/// Pattern in a match arm. Used by `match`, `when`, and destructuring
/// `let (a, b) = tuple`.
export enum Pattern {
    /// `_` — matches anything, binds nothing.
    Wildcard
    /// `.Variant(a, b)` — positional payload bindings into `bindings`.
    /// Bare `.Variant` (no payload) shows up here with empty bindings.
    Variant(name: string, bindings: ParamList)
    /// String literal pattern: `"hello" -> ...`.
    LitString(value: string)
    /// Integer literal pattern: `42 -> ...`.
    LitInt(value: int)
    /// Boolean literal pattern: `true -> ...` / `false -> ...`.
    LitBool(value: int)
    /// Float literal pattern (stored as string to preserve precision).
    LitFloat(value: string)
    /// Nested destructure: `.Some(.Ok(x))` — sub-patterns recurse.
    NestedVariant(name: string, sub_patterns: PatternList)
    /// Or-pattern: `.Red | .Green | .Blue -> ...`.
    Or(left: Pattern, right: Pattern)
    /// Union-type pattern: `int(n)` matches the int branch of a
    /// union-typed subject and binds the unwrapped value to `binding`.
    TypePattern(type_name: string, binding: string)
}

/// Arms of a match expression / statement, terminated by `End`. Body
/// is an SExpr — single-expression arms are common, and a brace
/// block is itself an `Expr.Block`. Optional `guard` adds an `if`
/// condition that must hold for the arm to fire.
export enum MatchArmList {
    End
    Node(pattern: Pattern, guard: SExpr?, body: SExpr, next: MatchArmList)
}

/// Type parameter list — used on generic declarations
/// (`fn foo<T, U: Display>(...)`). `bounds` is `""` for unconstrained
/// params, or a trait name for bounded params.
/// Type-arg binding list: `TypeArgList` maps each type parameter
/// name (e.g. "T") to its concrete `ValueType`. Built during
/// inference (both typeck-side substitution and mono's
/// specialisation). Lives in core so both passes share one shape.
export enum TypeArgList {
    End,
    Node(param_name: string, concrete_vt: ValueType, next: TypeArgList),
}

export enum TypeParamList {
    End
    Node(name: string, bounds: string, next: TypeParamList)
}

/// Membership test for a TypeParamList. True iff `name` appears as
/// a parameter name (bounds ignored).
export fn type_param_has(params: TypeParamList, name: string) -> bool {
    match params {
        .End -> false
        .Node(n, _, _) if n == name -> true
        .Node(_, _, next) -> type_param_has(next, name)
    }
}

/// Render a TypeParamList back to source-form: `T, U: Display`.
export fn render_type_param_list(params: TypeParamList) -> string {
    match params {
        .End -> ""
        .Node(name, bounds, next) -> {
            let b = if bounds == "" { name } else { "${name}: ${bounds}" }
            let rest = render_type_param_list(next)
            if rest == "" { b } else { "${b}, ${rest}" }
        }
    }
}

/// Explicit type arguments at call sites: `identity::<int, string>(x)`
/// — used by GenericCall to pin generic type parameters.
export enum TypeNameList {
    End
    Node(name: string, next: TypeNameList)
}

// ── Value types ──
//
// Every compiled value carries a ValueType that tells codegen how
// to dispatch operations. The string-tag-everywhere model has been
// retired — ValueType is the single source of truth.

/// Linked list of ValueType. Used for tuple element types, generic
/// type args, and union member types.
export enum TypeList {
    End,
    Node(ty: ValueType, next: TypeList),
}

/// The compiler's central type representation. Every Sym, every Expr
/// carries one of these; codegen dispatches on the variant to pick
/// the LLVM type and ABI. New variants here also need a row in
/// `llvm_type_for_full` and an arm in `vtype_display`.
export enum ValueType {
    /// `int` — i64 in LLVM.
    Int,
    /// Sized integer types (forge-crafting-intepreters-k5al). `int`
    /// remains the default 64-bit signed integer; these narrower
    /// variants exist for crypto, binary protocols, FFI struct
    /// layouts, and any code that needs precise width control.
    /// All lower to the corresponding LLVM primitive (i8, i16, i32,
    /// i64) and use wrapping arithmetic for unsigned variants.
    U8,
    U16,
    U32,
    U64,
    I8,
    I16,
    I32,
    /// `string` — heap-allocated, ptr in LLVM. UTF-8 byte sequence
    /// with character semantics on top.
    Str,
    /// `bytes` — heap-allocated, ptr in LLVM. Raw octet sequence
    /// distinct from `string`. Used by crypto, binary protocols,
    /// any byte-shaped parser. Tracked under ticket forge-crafting-intepreters-73wa
    /// inside the in-language-crypto epic.
    Bytes,
    /// `bool` — i1 in LLVM (1 byte storage).
    Bool,
    /// Opaque pointer — used for FFI and runtime handles.
    Ptr,
    /// Nominal struct: `name` is fully qualified, `id` is the
    /// TypeRegistry id (0 before resolve runs).
    Struct(name: string, id: int),
    /// Enum (sum type). `type_args` populated for generic instances
    /// (`Result<int, string>` carries Int + Str in type_args).
    Enum(name: string, type_args: TypeList, id: int),
    /// Anonymous tuple: `(int, string, bool)`.
    Tuple(elements: TypeList),
    /// Homogeneous list. `elem` is the element type.
    List(elem: ValueType),
    /// String-keyed map. Element type pinned by usage / inference.
    Map,
    /// Function value. `ret` is the return type — params are
    /// elided pre-typecheck and resolved into `FnTyped`.
    Fn(ret: ValueType),
    /// Closure value with captured environment. `num_captures` is
    /// the count of captured locals; codegen sizes the env struct
    /// from this.
    Closure(num_captures: int, ret: ValueType),
    /// `void` — fn-without-return-type tag.
    Void,
    /// `float` — double in LLVM.
    Float,
    /// Function type with full param + return signature. Resolver
    /// upgrades plain `Fn(ret)` into this once arity / param types
    /// are known.
    FnTyped(params: TypeList, ret: ValueType),
    /// Trait reference: `dyn Printable` etc. `id` is the TypeRegistry id.
    Trait(name: string, id: int),
    /// Union type: `int | string | bool`. `types` is the list of
    /// alternatives.
    Union(types: TypeList),
    /// Newtype wrapper. `inner` is the wrapped type — codegen passes
    /// it through, but typecheck enforces nominal distinction.
    Newtype(name: string, inner: ValueType, id: int),
    /// Flow-narrowed enum: after `if x is .Some`, the `then` branch
    /// sees `x` typed as NarrowedEnum so payload field accesses don't
    /// need an explicit destructure.
    NarrowedEnum(enum_name: string, variant_name: string, id: int),
    /// Type not yet resolved. Default for fresh AST nodes; typecheck
    /// replaces these with concrete variants.
    Unknown,
    /// Task / future type from `spawn`: `result_ty` is what the task
    /// resolves to when awaited.
    Task(result_ty: ValueType),
}

/// Structured type annotation as written in source. Pre-resolution
/// representation — the resolver lowers TypeExpr to ValueType once
/// names are bound. Replaces the historic string-based type tags.
export enum TypeExpr {
    /// Bare named type: `int`, `Foo`, `T`.
    Named(name: string)
    /// Implicit type — `_` placeholder or a missing annotation.
    Infer
    /// Pipe-union: `int | string`.
    Union(left: TypeExpr, right: TypeExpr)
    /// Nullable: `T?`.
    Optional(inner: TypeExpr)
    /// Function type: `fn(int, string) -> bool`.
    FnType(params: TypeExprList, ret: TypeExpr)
    /// List type: `[T]` / `List<T>`.
    ListType(elem: TypeExpr)
    /// Generic instantiation: `Result<int, IoError>`.
    Generic(base: string, args: TypeExprList)
}

/// Linked list of TypeExpr — used for generic args, fn params, etc.
export enum TypeExprList {
    End
    Node(ty: TypeExpr, next: TypeExprList)
}


// Convert a structured TypeExpr to a ValueType without string round-tripping.
// This is a parser-time conversion — it only knows primitive names and structural
// types. Named types that require registry lookups (structs, enums, traits) are
// left as ValueType.Struct(name, 0) and resolved later by typeck/codegen.
// Convert a TypeExpr to a ValueType at parse time. Only resolves primitives
// and structural types (List, Union, Fn, Map). Named types that require
// registry lookups (structs, enums, traits, newtypes) resolve to Int —
/// Map a concrete type-name string to a ValueType. Handles primitives
/// (`int`, `string`, `bool`, `ptr`, `void`, `float`, `Map`, `List`),
/// nullable suffix (`T?`), and pipe-unions (`A | B`). Named types
/// fall through as `Struct(name, 0)` to be upgraded once the registry
/// resolves the id. Used by `type_expr_to_vtype` and by the
/// monomorphizer's `substitute_vtype`.
export fn vtype_from_name(name: string) -> ValueType {
    // Handle nullable "T?"
    if name.ends_with("?") && name.length > 1 {
        return vtype_from_name(name.substring(0, name.length - 1))
    }
    // Handle union "A|B"
    let pipe = find_type_pipe(name)
    if pipe >= 0 {
        let left = vtype_from_name(name.substring(0, pipe))
        let right = vtype_from_name(name.substring(pipe + 1, name.length))
        return ValueType.Union(union_type_list_merge(left, right))
    }
    match name {
        "int" -> ValueType.Int
        "i64" -> ValueType.Int
        "u8"  -> ValueType.U8
        "u16" -> ValueType.U16
        "u32" -> ValueType.U32
        "u64" -> ValueType.U64
        "i8"  -> ValueType.I8
        "i16" -> ValueType.I16
        "i32" -> ValueType.I32
        "string" -> ValueType.Str
        "str" -> ValueType.Str
        "bytes" -> ValueType.Bytes
        "float" -> ValueType.Float
        "f64" -> ValueType.Float
        "bool" -> ValueType.Bool
        "ptr" -> ValueType.Ptr
        "Map" -> ValueType.Map
        "List" -> ValueType.List(ValueType.Unknown)
        "void" -> ValueType.Void
        "fn" -> ValueType.Fn(ValueType.Unknown)
        _ -> ValueType.Struct(name, 0)
    }
}

/// Lower a parsed TypeExpr to a ValueType. Named types that require
/// registry lookups (structs, enums, traits) become `Struct(name, 0)`
/// here — `resolve_vtype` / `resolve_codegen_vtype` upgrade them once
/// the canonical id is known.
export fn type_expr_to_vtype(te: TypeExpr) -> ValueType {
    match te {
        .Named(name) -> vtype_from_name(name)
        .Infer -> ValueType.Unknown
        .Union(left, right) -> {
            let lt = type_expr_to_vtype(left)
            let rt = type_expr_to_vtype(right)
            ValueType.Union(union_type_list_merge(lt, rt))
        }
        .Optional(inner) -> type_expr_to_vtype(inner)
        .FnType(params, ret) -> ValueType.FnTyped(tel_to_type_list(params), type_expr_to_vtype(ret))
        .ListType(elem) -> ValueType.List(type_expr_to_vtype(elem))
        .Generic(base, args) -> {
            match base {
                "List" -> {
                    let elem = match args { .Node(t, _) -> type_expr_to_vtype(t), .End -> ValueType.Unknown }
                    ValueType.List(elem)
                }
                "__tuple" -> ValueType.Tuple(tel_to_type_list(args))
                _ -> ValueType.Enum(base, tel_to_type_list(args), 0)
            }
        }
    }
}

/// Lower a TypeExprList to its corresponding TypeList by recursing
/// `type_expr_to_vtype` on each element.
fn tel_to_type_list(tel: TypeExprList) -> TypeList {
    match tel {
        .End -> TypeList.End
        .Node(te, next) -> TypeList.Node(type_expr_to_vtype(te), tel_to_type_list(next))
    }
}

/// Length of a TypeExprList. O(n).
export fn type_expr_list_length(tel: TypeExprList) -> int {
    match tel { .End -> 0, .Node(_, next) -> 1 + type_expr_list_length(next) }
}

/// Append `ty` to the end of a TypeExprList. O(n) — the parser uses
/// this when assembling generic argument lists left-to-right.
export fn type_expr_list_append(list: TypeExprList, ty: TypeExpr) -> TypeExprList {
    match list {
        .End -> TypeExprList.Node(ty, TypeExprList.End)
        .Node(head, next) -> TypeExprList.Node(head, type_expr_list_append(next, ty))
    }
}

/// Compare two type names, accepting equality if their last
/// `::`-segments match. Used as a fallback in `vtype_eq` when type
/// ids aren't both populated — covers the case where a Module-
/// wrapped test file has a param annotated with a qualified Enum
/// name (`mymod::Foo`) but an inner EnumCtor literal still carries
/// the bare name (`Foo`).
fn vtype_names_match(a: string, b: string) -> bool {
    if a == b { return true }
    last_seg(a) == last_seg(b)
}

/// Strip the module prefix from a qualified path: `"mod::Foo" → "Foo"`.
/// Local helper kept distinct from `type_short_name` because this one
/// stays in core/ast.av's namespace (the type registry's copy lives
/// at `core::type_registry::type_short_name`).
fn last_seg(s: string) -> string {
    if !s.contains("::") { return s }
    let parts = s.split("::")
    parts[parts.length - 1]
}

/// Strict ValueType equality. Two types are equal when they have
/// the same shape AND the same identity for nominal kinds (matched
/// by TypeRegistry id when both are non-zero, else by name string).
/// Use `vtype_assignable` for the broader "can A be passed where B
/// is expected" check.
export fn vtype_eq(a: ValueType, b: ValueType) -> bool {
    match a {
        .Int -> b is .Int
        .U8 -> b is .U8
        .U16 -> b is .U16
        .U32 -> b is .U32
        .U64 -> b is .U64
        .I8 -> b is .I8
        .I16 -> b is .I16
        .I32 -> b is .I32
        .Str -> b is .Str
        .Bytes -> b is .Bytes
        .Bool -> b is .Bool
        .Ptr -> b is .Ptr
        .List -> b is .List
        .Fn -> b is .Fn
        .Void -> b is .Void
        .Struct(n1, id1) -> match b { .Struct(n2, id2) -> if id1 > 0 && id2 > 0 { id1 == id2 } else { n1 == n2 }, _ -> false }
        .Enum(n1, _, id1) -> match b { .Enum(n2, _, id2) -> if id1 > 0 && id2 > 0 { id1 == id2 } else { n1 == n2 }, _ -> false }
        .Float -> b is .Float
        .Map -> b is .Map
        .FnTyped(_, _) -> match b { .FnTyped(_, _) -> true, .Fn(_) -> true, _ -> false }
        .Trait(n1, _) -> match b { .Trait(n2, _) -> n1 == n2, _ -> false }
        .Tuple(_) -> match b { .Tuple(_) -> true, _ -> false }
        .Closure(_, _) -> match b { .Closure(_, _) -> true, _ -> false }
        .Union(types_a) -> match b {
            .Union(types_b) -> type_lists_eq(types_a, types_b)
            _ -> false
        }
        .Newtype(n1, _, _) -> match b { .Newtype(n2, _, _) -> n1 == n2, _ -> false }
        .NarrowedEnum(e1, v1, _) -> match b { .NarrowedEnum(e2, v2, _) -> e1 == e2 && v1 == v2, _ -> false }
        .Unknown -> b is .Unknown
        .Task(_) -> b is .Task
        _ -> false
    }
}

/// Pairwise `vtype_eq` over two TypeLists. False on length mismatch.
fn type_lists_eq(a: TypeList, b: TypeList) -> bool {
    match a {
        .End -> b is .End
        .Node(ty_a, next_a) -> match b {
            .End -> false
            .Node(ty_b, next_b) -> vtype_eq(ty_a, ty_b) && type_lists_eq(next_a, next_b)
        }
    }
}

/// Subtype check: can a `src`-typed value be passed where a `dst`
/// is expected? Broader than `vtype_eq` — a concrete type is
/// assignable to any Union containing it, and a NarrowedEnum is
/// assignable back to its underlying Enum.
export fn vtype_assignable(src: ValueType, dst: ValueType) -> bool {
    if vtype_eq(src, dst) { return true }
    // NarrowedEnum is assignable to its base Enum
    if narrowed_assignable_to(src, dst) { return true }
    match dst {
        .Union(types) -> union_contains(types, src)
        _ -> false
    }
}

/// True iff `src` is a NarrowedEnum form of `dst` (or vice-versa).
/// A narrowed enum can always re-widen to its base enum.
fn narrowed_assignable_to(src: ValueType, dst: ValueType) -> bool {
    let en = vtype_enum_name(src)
    let dn = vtype_enum_name(dst)
    if en != "" && dn != "" && en == dn {
        return vtype_narrowed_variant(src) != ""
    }
    false
}

/// True iff `t` is the unresolved-type sentinel.
export fn vtype_is_unknown(t: ValueType) -> bool { t is .Unknown }

/// True iff `t` is the `string` type.
export fn vtype_is_str(t: ValueType) -> bool { t is .Str }

/// True iff `t` is the `bytes` type.
export fn vtype_is_bytes(t: ValueType) -> bool { t is .Bytes }

/// True iff `t` is a `List<…>`.
export fn vtype_is_list(t: ValueType) -> bool { t is .List }

/// Extract the element type of a List, or Unknown for non-List.
export fn vtype_list_elem(t: ValueType) -> ValueType {
    match t { .List(e) -> e, _ -> ValueType.Unknown }
}

/// True iff `t` is a `Map`.
export fn vtype_is_map(t: ValueType) -> bool { t is .Map }

/// True iff `t` is any callable shape — Fn, Closure, or FnTyped.
export fn vtype_is_fn(t: ValueType) -> bool {
    match t { .Fn(_) -> true, .Closure(_, _) -> true, .FnTyped(_, _) -> true, _ -> false }
}

/// Return type of a callable, or Unknown for non-callable.
export fn vtype_fn_ret(t: ValueType) -> ValueType {
    match t { .Fn(r) -> r, .Closure(_, r) -> r, .FnTyped(_, r) -> r, _ -> ValueType.Unknown }
}

/// Parameter list for a fully-typed callable. `Fn(ret)` (params not
/// yet resolved) returns an empty list.
export fn vtype_fn_params(t: ValueType) -> TypeList {
    match t { .FnTyped(p, _) -> p, _ -> TypeList.End }
}

/// Number of captured locals for a Closure, 0 otherwise. Codegen
/// uses this to size the env struct.
export fn vtype_closure_captures(t: ValueType) -> int {
    match t { .Closure(n, _) -> n, _ -> 0 }
}

/// True iff `t` is a Closure (carries captures, distinct from Fn).
export fn vtype_is_closure(t: ValueType) -> bool { t is .Closure }

/// Name of a Struct type, or "" for non-Struct. Cheap accessor used
/// pervasively by codegen for GEPs.
export fn vtype_struct_name(t: ValueType) -> string {
    match t { .Struct(n, _) -> n, _ -> "" }
}

/// Name of an Enum (or its NarrowedEnum form), or "" otherwise.
export fn vtype_enum_name(t: ValueType) -> string {
    match t { .Enum(n, _, _) -> n, .NarrowedEnum(n, _, _) -> n, _ -> "" }
}

/// Variant name pinned by a NarrowedEnum, or "" otherwise.
export fn vtype_narrowed_variant(t: ValueType) -> string {
    match t { .NarrowedEnum(_, v, _) -> v, _ -> "" }
}

/// Render a ValueType for human-facing output (diagnostics, hover).
/// Concise — compound types abbreviate to e.g. `(tuple)`. For full
/// structural rendering, use `vtype_render_full`.
export fn vtype_display(t: ValueType) -> string {
    match t {
        .Int -> "int"
        .U8 -> "u8"
        .U16 -> "u16"
        .U32 -> "u32"
        .U64 -> "u64"
        .I8 -> "i8"
        .I16 -> "i16"
        .I32 -> "i32"
        .Str -> "string"
        .Bytes -> "bytes"
        .Bool -> "bool"
        .Ptr -> "ptr"
        .Struct(n, _) -> n
        .Enum(n, _, _) -> n
        .Tuple(_) -> "(tuple)"
        .List(_) -> "List"
        .Map -> "Map"
        .Fn(_) or .Closure(_, _) -> "fn"
        .Void -> "void"
        .Float -> "float"
        .FnTyped(params, ret) -> "fn(${render_type_list(params)}) -> ${vtype_display(ret)}"
        .Trait(n, _) -> "dyn ${n}"
        .Union(types) -> render_union_display(types)
        .Newtype(name, _, _) -> name
        .NarrowedEnum(en, vn, _) -> "${en}.${vn}"
        .Unknown -> "<unknown>"
        .Task(r) -> "Task<${vtype_display(r)}>"
    }
}

/// Display-form pipe-join over a union's TypeList, used by
/// `vtype_display` for the `Union(types)` arm.
fn render_union_display(tl: TypeList) -> string {
    match tl {
        .End -> ""
        .Node(ty, next) -> {
            let rest = render_union_display(next)
            if rest == "" {
                vtype_display(ty)
            } else {
                vtype_display(ty) + " | " + rest
            }
        }
    }
}

/// Render a ValueType including generic type arguments — e.g.
/// `Result<int, string>` rather than `Result`. Used by the
/// monomorphizer for symbol mangling and by docs --gen for accurate
/// signature reproduction.
export fn vtype_render_full(t: ValueType) -> string {
    match t {
        .Int -> "int"
        .U8 -> "u8"
        .U16 -> "u16"
        .U32 -> "u32"
        .U64 -> "u64"
        .I8 -> "i8"
        .I16 -> "i16"
        .I32 -> "i32"
        .Str -> "string"
        .Bytes -> "bytes"
        .Bool -> "bool"
        .Ptr -> "ptr"
        .Struct(n, _) -> n
        .Enum(n, args, _) -> {
            let args_str = render_type_list_full(args)
            if args_str == "" { n } else { "${n}<${args_str}>" }
        }
        .Tuple(types) -> "(${render_type_list(types)})"
        .List(elem) -> "List<${vtype_render_full(elem)}>"
        .Map -> "Map"
        .Fn(_) or .Closure(_, _) -> "fn"
        .Void -> "void"
        .Float -> "float"
        .FnTyped(params, ret) -> "fn(${render_type_list_full(params)}) -> ${vtype_render_full(ret)}"
        .Trait(n, _) -> "dyn ${n}"
        .Union(types) -> render_union_full(types)
        .Newtype(name, _, _) -> name
        .NarrowedEnum(en, vn, _) -> "${en}.${vn}"
        .Unknown -> ""
        .Task(r) -> "Task<${vtype_render_full(r)}>"
    }
}

/// `vtype_render_full` over each element of a TypeList, comma-joined.
/// Used by `vtype_render_full` for tuple / fn-param rendering.
fn render_type_list_full(tl: TypeList) -> string {
    match tl {
        .End -> ""
        .Node(ty, next) -> {
            let rest = render_type_list_full(next)
            if rest == "" {
                vtype_render_full(ty)
            } else {
                "${vtype_render_full(ty)}, ${rest}"
            }
        }
    }
}

/// `vtype_render_full` over each element of a TypeList, pipe-joined
/// for union rendering (`int|string|bool`).
fn render_union_full(tl: TypeList) -> string {
    match tl {
        .End -> ""
        .Node(ty, next) -> {
            let rest = render_union_full(next)
            if rest == "" {
                vtype_render_full(ty)
            } else {
                vtype_render_full(ty) + "|" + rest
            }
        }
    }
}

/// Trait name for a Trait ValueType, or "" otherwise.
export fn vtype_trait_name(t: ValueType) -> string {
    match t { .Trait(n, _) -> n, _ -> "" }
}

/// True iff `t` is a Union type.
export fn vtype_is_union(t: ValueType) -> bool { t is .Union }

/// True iff `t` is a Newtype wrapper.
export fn vtype_is_newtype(t: ValueType) -> bool { t is .Newtype }

/// Inner (wrapped) type of a Newtype, or Unknown otherwise.
export fn vtype_newtype_inner(t: ValueType) -> ValueType {
    match t { .Newtype(_, inner, _) -> inner, _ -> ValueType.Unknown }
}

/// Name of a Newtype, or "" otherwise.
export fn vtype_newtype_name(t: ValueType) -> string {
    match t { .Newtype(n, _, _) -> n, _ -> "" }
}

/// Member TypeList of a Union, or empty list otherwise.
export fn vtype_union_types(t: ValueType) -> TypeList {
    match t { .Union(tl) -> tl, _ -> TypeList.End }
}

/// Membership test for a union's TypeList — `vtype_eq` against each
/// element. Used by `vtype_assignable` to widen concrete types.
export fn union_contains(tl: TypeList, t: ValueType) -> bool {
    match tl {
        .End -> false
        .Node(ty, next) -> if vtype_eq(ty, t) { true } else { union_contains(next, t) }
    }
}

/// Build a TypeList from two types, flattening nested unions. Used
/// by the parser when reading `A | B | C` so the resulting Union is
/// always one level deep, regardless of operator associativity.
export fn union_type_list_merge(a: ValueType, b: ValueType) -> TypeList {
    let left = match a {
        .Union(tl) -> tl
        _ -> TypeList.Node(a, TypeList.End)
    }
    let right = match b {
        .Union(tl) -> tl
        _ -> TypeList.Node(b, TypeList.End)
    }
    type_list_concat(left, right)
}

/// Concatenate two TypeLists. O(n) in `a`.
fn type_list_concat(a: TypeList, b: TypeList) -> TypeList {
    match a {
        .End -> b
        .Node(ty, next) -> TypeList.Node(ty, type_list_concat(next, b))
    }
}

/// Length of a TypeList. O(n).
export fn type_list_len(tl: TypeList) -> int {
    match tl {
        .End -> 0
        .Node(_, next) -> 1 + type_list_len(next)
    }
}

/// Get the type at position `idx` (0-based). Returns Unknown for
/// out-of-range — typecheck callers branch on Unknown rather than
/// pattern-matching on Option.
export fn type_list_at(tl: TypeList, idx: int) -> ValueType {
    match tl {
        .End -> ValueType.Unknown
        .Node(ty, next) -> if idx == 0 { ty } else { type_list_at(next, idx - 1) }
    }
}

/// Find a top-level `|` in a type string (not inside `<>`, `()`, or
/// `[]`). Used by both typeck and codegen to parse union type
/// strings like `int|string|bool`. Returns -1 when no top-level
/// pipe is present.
export fn find_type_pipe(s: string) -> int {
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s.substring(i, i + 1)
        if ch == "(" || ch == "<" || ch == "[" { depth = depth + 1 }
        if ch == ")" || ch == ">" || ch == "]" { depth = depth - 1 }
        if ch == "|" && depth == 0 { return i }
        i = i + 1
    }
    -1
}

/// Comma-separate the display names of every type in `tl`. Used by
/// every renderer that prints a type sequence (tuple types, generic
/// args, fn param lists).
export fn render_type_list(tl: TypeList) -> string {
    match tl {
        .End -> ""
        .Node(ty, next) -> {
            let rest = render_type_list(next)
            if rest == "" {
                vtype_display(ty)
            } else {
                "${vtype_display(ty)}, ${rest}"
            }
        }
    }
}

/// Index into a Tuple ValueType. Returns Unknown for non-tuples or
/// out-of-range — same convention as `type_list_at`.
export fn vtype_tuple_at(t: ValueType, idx: int) -> ValueType {
    match t {
        .Tuple(types) -> typelist_at(types, idx)
        _ -> ValueType.Unknown
    }
}

/// 0-indexed nth element of a TypeList, or Unknown out-of-range.
fn typelist_at(list: TypeList, idx: int) -> ValueType {
    match list {
        .End -> ValueType.Unknown
        .Node(ty, _) if idx <= 0 -> ty
        .Node(_, next) -> typelist_at(next, idx - 1)
    }
}

// ── Operators ──

/// Binary operators that appear in `Expr.Binary(left, op, right)`.
/// Renderer + codegen dispatch on this discriminant; `binop_str`
/// gives the source token. Logical short-circuit ops live in LogicOp,
/// not here, because they need lazy evaluation.
export enum BinOp {
    Add, Sub, Mul, Div, Mod,
    Eq, Ne, Lt, Le, Gt, Ge,
    BitAnd, BitOr, BitXor, Shl, Shr,
}

/// Unary prefix operators in `Expr.Unary(op, right)`. `Not` is
/// logical negation (`!`); `BitNot` is bitwise (`~`).
export enum UnOp {
    Neg, Not, BitNot,
}

/// Short-circuit logical operators. Distinct from BinOp because the
/// RHS is conditionally evaluated at runtime — codegen emits a
/// branch instead of an arithmetic op.
export enum LogicOp {
    And, Or,
}

/// Render a BinOp as its source-form operator (`+`, `==`, `<<`, …).
export fn binop_str(op: BinOp) -> string {
    match op {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .Mod -> "%"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Le -> "<="
        .Gt -> ">"
        .Ge -> ">="
        .BitAnd -> "&"
        .BitOr -> "|"
        .BitXor -> "^"
        .Shl -> "<<"
        .Shr -> ">>"
    }
}

/// Render a UnOp as its source-form prefix (`-`, `!`, `~`).
export fn unop_str(op: UnOp) -> string {
    match op {
        .Neg -> "-"
        .Not -> "!"
        .BitNot -> "~"
    }
}

/// Render a LogicOp as its source-form operator (`&&`, `||`).
export fn logicop_str(op: LogicOp) -> string {
    match op {
        .And -> "&&"
        .Or -> "||"
    }
}

/// Avra expression AST. Every value-producing source construct lowers
/// to one of these variants. Adding a new variant requires touching
/// every walker (resolver, typecheck, mono, codegen, render) — see
/// the existing match arms for the pattern.
export enum Expr {
    /// Integer literal (text form, parsed lazily by codegen).
    Number(value: string)
    /// String literal — `value` includes the surrounding quotes so
    /// the renderer can round-trip without re-quoting.
    String(value: string)
    /// Boolean literal: `"true"` or `"false"` (text for renderer).
    Bool(value: string)
    /// `null` keyword.
    Null
    /// Identifier reference. Resolver replaces with QualifiedIdent
    /// when the name resolves to a top-level / module-qualified item.
    Ident(name: string)
    /// `name = value` reassignment. Only valid for `mut` bindings.
    Assign(name: string, value: Expr)
    /// `(expr)` — preserves source parenthesisation for renderer.
    Grouping(expr: Expr)
    /// Prefix unary: `!x`, `-x`, `~x`.
    Unary(op: UnOp, right: Expr)
    /// Binary infix: `a + b`, `x == y`, `a & b`.
    Binary(left: Expr, op: BinOp, right: Expr)
    /// Short-circuit logical: `a && b`, `a || b`.
    Logical(left: Expr, op: LogicOp, right: Expr)
    /// Function call: `f(a, b)`.
    Call(callee: Expr, args: ExprList)
    /// Call with explicit type arguments: `f::<int, string>(x, y)`.
    GenericCall(callee: Expr, type_args: TypeNameList, args: ExprList)
    /// Struct literal: `Foo { x: 1, y: 2 }`.
    StructLit(name: string, inits: FieldInitList)
    /// Field access: `obj.field`.
    FieldAccess(obj: Expr, field: string)
    /// Enum constructor with payload: `Color.Red(255)` or `.Some(x)`.
    EnumCtor(type_name: string, variant: string, args: ExprList)
    /// Index access: `list[i]` / `map["key"]`.
    Index(obj: Expr, idx: Expr)
    /// Block expression — value is the last statement's value.
    Block(body: StmtList)
    /// `match subject { arms }` — match used as an expression.
    MatchExpr(subject: Expr, arms: MatchArmList)
    /// Field reassignment: `obj.field = value`.
    FieldAssign(obj: Expr, field: string, value: Expr)
    /// Ternary-like `if cond { then } else { else_branch }` as an expr.
    IfExpr(condition: Expr, then_branch: Expr, else_branch: Expr)
    /// Null coalesce: `a ?? default`.
    NullCoalesce(left: Expr, right: Expr)
    /// Optional chain: `obj?.field` — null obj passes through, no
    /// deref on null.
    OptionalChain(obj: Expr, field: string)
    /// Error / null propagate: `expr?` — bails the enclosing fn early
    /// if `expr` is Err / null.
    Try(expr: Expr)
    /// Tuple literal: `(a, b, c)`.
    Tuple(elements: ExprList)
    /// Tuple index: `t.0`, `t.1`.
    TupleIndex(obj: Expr, index: int)
    /// Functional struct update: `obj with { field: new_value }`.
    With(obj: Expr, overrides: FieldInitList)
    /// List literal: `[1, 2, 3]`.
    ListLit(elements: ExprList)
    /// Closure literal: `(x, y) -> body`.
    Lambda(params: ParamList, body: Expr)
    /// Map literal — flat list of alternating key/value:
    /// `{ "a": 1, "b": 2 }` → entries = [key1, val1, key2, val2, ...].
    MapLit(entries: ExprList)
    /// Slice: `list[start..end]`.
    Slice(obj: Expr, start: Expr, end: Expr)
    /// Float literal (text form, like Number).
    FloatLit(value: string)
    /// Type-narrowing test: `subject is .Variant`.
    IsCheck(subject: Expr, variant_name: string)
    /// Membership test: `needle in [a, b, c]`.
    InCheck(needle: Expr, items: ExprList)
    /// List comprehension: `[body for variable in collection if filter]`.
    ListComp(body: Expr, variable: string, collection: Expr, filter: Expr?)
    /// Module-qualified identifier — produced by the resolver from
    /// `Ident(name)` once the name's canonical path is known.
    QualifiedIdent(path: string)
    /// Subjectless match: `when { cond -> body, else -> body }`.
    When(arms: WhenArmList)
    /// Catch block: `expr catch (e) { body }` — recovers from an
    /// erroring `expr` by binding the error to `e`.
    Catch(inner: Expr, binding: string, body: Expr, line: int, col: int)
    /// `spawn body` — start a green-thread Task running `body`.
    Spawn(body: Expr)
    /// `quote { body }` — captures the AST of `body` as a value.
    /// Lowering pass turns this into AST-construction calls so
    /// evaluating the result rebuilds the original AST node.
    /// `kind` is one of "expr" / "stmt" / "stmts" / "type" / "decl";
    /// the default form `quote { ... }` uses "expr".
    Quote(kind: string, body: Expr)
    /// `~target` inside a quote body — splice the value of `target`
    /// directly into the constructed AST instead of rebuilding it.
    /// Outside a quote body the parser produces Expr.Unary(BitNot, ...)
    /// instead, so the same `~` token is overloaded by context.
    /// Phase 4 (vez6.4) of Components V2.
    Splice(target: Expr)
}

/// Avra statement AST. Anything that doesn't produce a value lowers
/// to one of these. `Expr(e)` is the bridge — wraps an expression so
/// it can stand alone in a block without yielding.
export enum Stmt {
    /// Immutable binding: `let name: T = init`.
    Let(name: string, ty_vt: ValueType, initializer: Expr)
    /// Mutable binding: `mut name: T = init`. Reassign with
    /// `Expr.Assign` later.
    Mut(name: string, ty_vt: ValueType, initializer: Expr)
    /// Compile-time constant: `const NAME: T = init`.
    Const(name: string, ty_vt: ValueType, initializer: Expr)
    /// Expression as a statement — runs for side effects, value
    /// discarded except as the final expression of a block.
    Expr(expr: Expr)
    /// Brace block: `{ stmt1; stmt2; }`.
    Block(body: StmtList)
    /// `if cond { then } else { else_branch }` (else may be null).
    If(condition: Expr, then_branch: Stmt, else_branch: Stmt?)
    /// `while cond { body }`.
    While(condition: Expr, body: Stmt)
    /// `for variable in start..end { body }` — integer range loop.
    For(variable: string, start: Expr, end: Expr, body: Stmt)
    /// `for variable in collection { body }` — list / iterator loop.
    ForIn(variable: string, collection: Expr, body: Stmt)
    /// Function declaration. `type_params` empty for non-generic
    /// fns; resolver fills `ret_vtype` from the source annotation.
    Function(name: string, type_params: TypeParamList, params: ParamList, ret_vtype: ValueType, body: StmtList)
    /// `return value` — early return with an expression.
    Return(value: Expr)
    /// Bare `return` — ends a void fn.
    ReturnEmpty
    /// Struct type declaration: `type Point = { x: int, y: int }`.
    TypeDecl(name: string, type_params: TypeParamList, fields: FieldList)
    /// Newtype: `type UserId = UUID` — nominal wrapper.
    NewtypeDecl(name: string, inner_vt: ValueType)
    /// Union alias: `type Json = string | int | bool`.
    UnionAliasDecl(name: string, type_vt: ValueType)
    /// Structural shape: `shape Point = { x: int, y: int }` —
    /// width-subtyping record.
    ShapeDecl(name: string, fields: FieldList)
    /// Enum declaration: `enum Color { Red, Green, Blue }`.
    EnumDecl(name: string, type_params: TypeParamList, variants: VariantList)
    /// Match as a statement: `match v { ... }` with no result.
    Match(subject: Expr, arms: MatchArmList)
    /// `impl Type { fns }` or `impl Trait for Type { fns }`. The
    /// `:` form encodes the trait+type pair as `"Trait:Type"`.
    Impl(type_name: string, methods: StmtList)
    /// Placeholder — used after rewriting passes that drop a stmt.
    NoOp
    /// FFI declaration: `extern fn name(...)`. No body; ABI matches C.
    ExternFn(name: string, params: ParamList, ret_vtype: ValueType)
    /// `break` — exit the enclosing loop.
    Break
    /// `continue` — skip to the next iteration of the enclosing loop.
    Continue
    /// `trait Name { fn ... }` — interface declaration.
    TraitDecl(name: string, methods: StmtList)
    /// Destructuring let: `let (a, b) = pair` / `let {x, y} = struct`.
    LetDestructure(names: ParamList, initializer: Expr)
    /// `defer expr` — runs `expr` at scope exit, LIFO order.
    Defer(body: Expr)
    /// `errdefer expr` — runs `expr` only on Err / panic exit.
    Errdefer(body: Expr)
    /// Annotation wrapper: `@annot stmt` — annotations live here so
    /// the inner stmt's match arms stay focused on the actual decl.
    Annotated(annotations: AnnotationList, inner: Stmt)
    /// Test outer block: `spec "name" { ... }`.
    SpecBlock(name: string, body: StmtList)
    /// Test setup block: `given "name" { let setup = ...; then "..." }`.
    GivenBlock(name: string, body: StmtList)
    /// Test assertion block: `then "name" { boolean_condition }`.
    ThenBlock(name: string, condition: Expr)
    /// `select { x <- ch1 -> body, ... }` — multi-channel wait.
    Select(arms: SelectArmList)
    /// `parallel { stmts }` — run statements concurrently as Tasks.
    Parallel(body: StmtList)
    /// `mod name { body }` — namespaced sub-module. Pre-resolution
    /// `mod name` (no body) shows up here with empty body and is
    /// filled in by the module resolver.
    Module(name: string, body: StmtList)
    /// `use module.path.{name1, name2}` — import declaration.
    Use(module_path: string, names: ParamList)
    /// Trait associated type: `type Item = T` inside a trait body.
    AssocType(name: string, ty_vt: ValueType)
    /// Component declaration: `component Name(params) { body }` —
    /// reusable templated block of statements.
    ComponentDef(name: string, params: ParamList, config: CompConfigList, children: ChildrenList, implements: TypeNameList, body: StmtList)
    /// Component instantiation: `component Foo as bar { config; body }`.
    ComponentBlock(comp_name: string, instance: string, config: CompConfigPairList, body: StmtList)
}

/// When-arms: `cond -> body` or `else -> body` (cond is null for the
/// final else). Used by the subjectless `when { ... }` expression.
export enum WhenArmList {
    End
    Node(cond: SExpr?, body: SExpr, next: WhenArmList)
}

/// Select-arms: `binding <- channel -> body` — one branch of a
/// `select` block.
export enum SelectArmList {
    End
    Node(binding: string, channel: Expr, body: StmtList, next: SelectArmList)
}

/// Annotations attached to declarations: `@name` or `@name(args)`.
/// Args are stored as ExprList for generality so any annotation
/// shape works without dedicated AST variants.
export enum AnnotationList {
    End
    Node(name: string, args: ExprList, next: AnnotationList)
}

/// Component config schema entries: `key`, `ty_vt`, optional default
/// value. Declared by ComponentDef so call sites can be type-checked
/// against the schema.
export enum CompConfigList {
    End
    Node(key: string, ty_vt: ValueType, default_val: Expr?, next: CompConfigList)
}

/// Component config pairs as supplied in a ComponentBlock — `key:
/// value` filled in by the consumer.
export enum CompConfigPairList {
    End
    Node(key: string, value: Expr, next: CompConfigPairList)
}

/// Component child-slot schema entries: `slot_name: List<T>` declared
/// inside a `children { ... }` block. Each entry names a parent list
/// field plus the child element type accepted there. Phase 7 (vez6.7).
export enum ChildrenList {
    End
    Node(slot_name: string, child_ty: ValueType, next: ChildrenList)
}

/// Strip every Annotated wrapper, returning the underlying decl.
/// Recursive on purpose: a single decl can wear multiple annotations
/// (e.g. `/// docstring\nexport fn foo()` parses to
/// `Annotated(@doc, Annotated(@export, Function))`), and call sites
/// that dispatch on the inner Stmt variant need to reach Function
/// regardless of how many `///` / `@export` / `@inline` / etc.
/// layers happen to wrap it.
export fn stmt_unwrap(s: Stmt) -> Stmt {
    match s {
        .Annotated(_, inner) -> stmt_unwrap(inner)
        _ -> s
    }
}

/// Look up an annotation by name on a Stmt. Walks every Annotated
/// layer (so `/// foo\n@inline\nfn bar()` finds @doc, @inline, etc.),
/// returning the first occurrence. Returns the raw arg list — the
/// caller decides what shape it expects (single string for @doc,
/// no args for @export, etc.).
export fn find_annotation(s: Stmt, name: string) -> AnnotationList? {
    match s {
        .Annotated(annots, inner) -> {
            let here = annotation_list_find(annots, name)
            if here != null {
                return here
            }
            find_annotation(inner, name)
        }
        _ -> null
    }
}

/// Extract the first `@doc` annotation's text body, with surrounding
/// `"..."` literal quotes stripped. Returns "" if the stmt has no
/// @doc annotation. Tooling (std-lsp indexer, IDE hover, the docs
/// CLI) should prefer this over reading the AnnotationList directly.
export fn doc_string_for(s: Stmt) -> string {
    let found = find_annotation(s, "doc")
    if found == null { return "" }
    annotation_first_string(found!)
}

/// Linear scan for an annotation by name within a single
/// AnnotationList layer. Used by `find_annotation` which walks
/// nested Annotated wrappers via `stmt_unwrap`.
fn annotation_list_find(annots: AnnotationList, name: string) -> AnnotationList? {
    match annots {
        .End -> null
        .Node(n, args, next) -> {
            if n == name {
                AnnotationList.Node(n, args, AnnotationList.End)
            } else {
                annotation_list_find(next, name)
            }
        }
    }
}

/// Pull the first arg's string body out of an annotation. The parser
/// stores doc comments as `Expr.String("\"…raw text…\"")` — quotes
/// are part of the literal form, so we strip them here.
fn annotation_first_string(annots: AnnotationList) -> string {
    match annots {
        .End -> ""
        .Node(_, args, _) -> {
            match args {
                .End -> ""
                .Node(se, _) -> {
                    match se.node {
                        .String(literal) -> strip_quotes(literal)
                        _ -> ""
                    }
                }
            }
        }
    }
}

/// Drop matching `"…"` outer quotes if present. Returns input
/// unchanged when there's nothing to strip.
fn strip_quotes(s: string) -> string {
    if s.length < 2 { return s }
    let first = s.substring(0, 1)
    let last = s.substring(s.length - 1, s.length)
    if first == "\"" && last == "\"" {
        s.substring(1, s.length - 1)
    } else {
        s
    }
}

/// Linked list of spanned statements. Every block-shaped construct
/// (Function body, Block, Module body, etc.) holds one of these.
export enum StmtList {
    End
    Node(stmt: SStmt, next: StmtList)
}

/// Recursive variable environment threaded through codegen. Each
/// node binds a name to its alloca (i64-shaped, holds either an int
/// or a ptr-encoded value) plus the ValueType tag that drives op
/// dispatch. Newer bindings sit at the head — `env_lookup` walks
/// in source order (innermost shadowing).
export enum VarEnv {
    End
    Node(name: string, alloca: ptr, ty: ValueType, next: VarEnv)
}

/// Result of an `env_lookup`. `found` is 0 / 1 (Avra has no Option
/// for ptr at the time this was written) — see callers for the idiom.
export type VarLookup = {
    found: int,
    alloca: ptr,
    ty: ValueType,
}

/// Look up a name in the env. Returns `found: false` with a null
/// alloca and Unknown type when not present. Innermost (head-most)
/// binding wins — supports lexical shadowing.
export fn env_lookup(env: VarEnv, name: string) -> VarLookup {
    match env {
        .End -> {
            let n: ptr = null
            VarLookup { found: false, alloca: n, ty: ValueType.Unknown }
        }
        .Node(n, alloca, ty, _) if n == name -> VarLookup { found: true, alloca, ty }
        .Node(_, _, _, next) -> env_lookup(next, name)
    }
}

/// Cons a new binding at the head — pure functional update, leaves
/// the underlying VarEnv shared with prior callers.
export fn env_extend(env: VarEnv, name: string, alloca: ptr, ty: ValueType) -> VarEnv {
    VarEnv.Node(name, alloca, ty, env)
}

/// Function symbol table — name → (LLVM function value, arity).
/// Separate from VarEnv because fns are visible across the whole
/// module and don't follow lexical scope rules.
export enum FnEnv {
    End
    Node(name: string, fn_val: ptr, arity: int, next: FnEnv)
}

/// Result of a `fn_env_lookup`. Same convention as VarLookup:
/// `found: false` carries a null fn_val + arity 0.
export type FnLookup = {
    found: int,
    fn_val: ptr,
    arity: int,
}

/// Look up a function by name. Like env_lookup, returns the unfound
/// sentinel rather than an Option for pointer fields.
export fn fn_env_lookup(env: FnEnv, name: string) -> FnLookup {
    match env {
        .End -> {
            let n: ptr = null
            FnLookup { found: false, fn_val: n, arity: 0 }
        }
        .Node(n, fn_val, arity, _) if n == name -> FnLookup { found: true, fn_val, arity }
        .Node(_, _, _, next) -> fn_env_lookup(next, name)
    }
}

/// Cons a fn binding at the head of an FnEnv.
export fn fn_env_extend(env: FnEnv, name: string, fn_val: ptr, arity: int) -> FnEnv {
    FnEnv.Node(name, fn_val, arity, env)
}

/// Length of a ParamList. O(n).
export fn param_list_length(params: ParamList) -> int {
    match params {
        .End -> 0
        .Node(_, _, next) -> 1 + param_list_length(next)
    }
}

/// Length of an ExprList. O(n).
export fn expr_list_length(exprs: ExprList) -> int {
    match exprs {
        .End -> 0
        .Node(_, next) -> 1 + expr_list_length(next)
    }
}

/// Length of a FieldList. O(n).
export fn field_list_length(fields: FieldList) -> int {
    match fields {
        .End -> 0
        .Node(_, _, next) -> 1 + field_list_length(next)
    }
}

/// Membership test for a FieldList. True iff `target` matches the
/// name of any field.
export fn field_list_has(list: FieldList, target: string) -> bool {
    match list {
        .End -> false
        .Node(n, _, _) if n == target -> true
        .Node(_, _, next) -> field_list_has(next, target)
    }
}

/// Drop every entry of `base` whose name appears in `excluded`. Used
/// by shape-coercion typecheck to compute the unmatched-field error.
export fn filter_fields_without(base: FieldList, excluded: FieldList) -> FieldList {
    match base {
        .End -> FieldList.End
        .Node(name, _, next) if field_list_has(excluded, name) -> filter_fields_without(next, excluded)
        .Node(name, r, next) -> FieldList.Node(name, r, filter_fields_without(next, excluded))
    }
}

/// Keep only the entries of `base` whose name appears in `included`.
/// The complement of `filter_fields_without`.
export fn filter_fields_only(base: FieldList, included: FieldList) -> FieldList {
    match base {
        .End -> FieldList.End
        .Node(name, r, next) if field_list_has(included, name) -> FieldList.Node(name, r, filter_fields_only(next, included))
        .Node(_, _, next) -> filter_fields_only(next, included)
    }
}

/// Length of a FieldInitList. O(n).
export fn field_init_length(inits: FieldInitList) -> int {
    match inits {
        .End -> 0
        .Node(_, _, next) -> 1 + field_init_length(next)
    }
}

/// Zero-based index of `name` in `fields`, or -1 if absent. Used by
/// codegen for GEP offsets.
export fn field_index_of(fields: FieldList, name: string) -> int {
    field_index_of_loop(fields, name, 0)
}

/// Tail-recursive search loop backing `field_index_of`. Threads the
/// running counter through the recursion.
fn field_index_of_loop(fields: FieldList, name: string, idx: int) -> int {
    match fields {
        .End -> -1
        .Node(n, _, _) if n == name -> idx
        .Node(_, _, next) -> field_index_of_loop(next, name, idx + 1)
    }
}

/// Length of a VariantList. O(n).
export fn variant_list_length(variants: VariantList) -> int {
    match variants {
        .End -> 0
        .Node(_, _, next) -> 1 + variant_list_length(next)
    }
}

/// Result of `variant_lookup`. `tag` is the djb2-style stable hash
/// used as the LLVM tag value; -1 when not found.
export type VariantLookup = {
    found: int,
    fields: FieldList,
    tag: int,
}

extern fn avra_variant_hash(name: string) -> int

/// Find a variant by name. Returns its FieldList plus the stable
/// tag hash, or `found: false` when absent.
export fn variant_lookup(variants: VariantList, name: string) -> VariantLookup {
    variant_lookup_by_hash(variants, name)
}

/// Implementation of `variant_lookup`: walks the list and computes
/// the djb2 tag hash for the matching variant.
fn variant_lookup_by_hash(variants: VariantList, name: string) -> VariantLookup {
    match variants {
        .End -> VariantLookup { found: false, fields: FieldList.End, tag: -1 }
        .Node(n, fields, _) if n == name -> VariantLookup { found: true, fields, tag: avra_variant_hash(name) }
        .Node(_, _, next) -> variant_lookup_by_hash(next, name)
    }
}

/// Maximum number of i64 slots needed across all variants in an
/// enum — determines the size of the payload union in the LLVM
/// struct layout. Each variant's payload is `field_list_length(...)`
/// slots; the enum's overall payload sizes to the largest.
export fn variant_max_payload(variants: VariantList) -> int {
    match variants {
        .End -> 0
        .Node(_, fields, next) -> {
            let here = field_list_length(fields)
            let rest = variant_max_payload(next)
            if here > rest {
                here
            } else {
                rest
            }
        }
    }
}

/// Resolved ValueType for field `name`, or Unknown when the field
/// isn't present.
export fn field_vtype_of(fields: FieldList, name: string) -> ValueType {
    match fields {
        .End -> .Unknown
        .Node(n, vt, _) if n == name -> vt
        .Node(_, _, next) -> field_vtype_of(next, name)
    }
}

/// Render an Expr as an S-expression. Used by `bs2 expr` /
/// `bs2 program` for AST inspection and by spec test failure
/// messages — not a source-form pretty-printer (see fmt_* in main.av
/// for that).
export fn render_expr(expr: Expr) -> string {
    match expr {
        .Number(value) -> value
        .String(value) -> value
        .Bool(value) -> value
        .Null -> "null"
        .Ident(name) -> name
        .Assign(name, value) -> "(assign ${name} ${render_expr(value)})"
        .Grouping(inner) -> "(group ${render_expr(inner)})"
        .Unary(op, right) -> "(${unop_str(op)} ${render_expr(right)})"
        .Binary(left, op, right) -> "(${binop_str(op)} ${render_expr(left)} ${render_expr(right)})"
        .Logical(left, op, right) -> "(${logicop_str(op)} ${render_expr(left)} ${render_expr(right)})"
        .Call(callee, args) -> "(call ${render_expr(callee)} ${render_expr_list(args)})"
        .GenericCall(callee, type_args, args) -> "(call ${render_expr(callee)}::<${render_type_name_list(type_args)}> ${render_expr_list(args)})"
        .StructLit(name, inits) -> "(struct ${name} ${render_field_init_list(inits)})"
        .FieldAccess(obj, field) -> "(field ${render_expr(obj)} ${field})"
        .EnumCtor(type_name, variant, args) -> "(ctor ${type_name}.${variant} ${render_expr_list(args)})"
        .Index(obj, idx) -> "(index ${render_expr(obj)} ${render_expr(idx)})"
        .Block(body) -> "(block-expr ${render_stmt_list(body)})"
        .MatchExpr(subject, arms) -> "(match-expr ${render_expr(subject)} ${render_match_arm_list(arms)})"
        .FieldAssign(obj, field, value) -> "(field-assign ${render_expr(obj)} ${field} ${render_expr(value)})"
        .IfExpr(c, t, e) -> "(if-expr ${render_expr(c)} ${render_expr(t)} ${render_expr(e)})"
        .NullCoalesce(left, right) -> "(?? ${render_expr(left)} ${render_expr(right)})"
        .OptionalChain(obj, field) -> "(?. ${render_expr(obj)} ${field})"
        .Try(inner) -> "(? ${render_expr(inner)})"
        .Tuple(elements) -> "(tuple ${render_expr_list(elements)})"
        .TupleIndex(obj, idx) -> "(tuple-idx ${render_expr(obj)} ${string(idx)})"
        .With(obj, overrides) -> "(with ${render_expr(obj)} ${render_field_init_list(overrides)})"
        .ListLit(elements) -> "(list ${render_expr_list(elements)})"
        .Lambda(params, body) -> "(lambda ${render_param_list(params)} ${render_expr(body)})"
        .MapLit(entries) -> "(map ${render_expr_list(entries)})"
        .FloatLit(value) -> value
        .Slice(obj, start, end) -> "(slice ${render_expr(obj)} ${render_expr(start)}..${render_expr(end)})"
        .IsCheck(subject, vname) -> "(is ${render_expr(subject)} .${vname})"
        .InCheck(needle, items) -> "(in ${render_expr(needle)} [${render_expr_list(items)}])"
        .QualifiedIdent(path) -> path
        .When(arms) -> "(when ${render_when_arm_list(arms)})"
        .ListComp(body, variable, collection, _) -> "(list-comp ${render_expr(body)} for ${variable} in ${render_expr(collection)})"
        .Catch(inner, binding, body, _, _) -> "(catch ${render_expr(inner)} (${binding}) ${render_expr(body)})"
        .Spawn(body) -> "(spawn ${render_expr(body)})"
        .Quote(kind, body) -> "(quote ${kind} ${render_expr(body)})"
        .Splice(target) -> "(splice ${render_expr(target)})"
    }
}

/// Render the body of a `when` expression as `cond -> body, ...`.
fn render_when_arm_list(arms: WhenArmList) -> string {
    match arms {
        .End -> ""
        .Node(cond, body, next) -> {
            let cond_str = if cond == null { "_" } else { render_expr(cond!.node) }
            "${cond_str} -> ${render_expr(body.node)} ${render_when_arm_list(next)}"
        }
    }
}

/// Render a FieldInitList as an S-expression: `(k=v, k2=v2)`.
export fn render_field_init_list(inits: FieldInitList) -> string {
    match inits {
        .End -> "()"
        .Node(name, sv, next) -> {
            let head = "${name}=${render_expr(sv.node)}"
            let tail = render_field_init_tail(next)
            "(${head}${tail})"
        }
    }
}

/// Tail half of `render_field_init_list` — comma-prefixes each entry
/// past the head so the head doesn't get a leading comma.
fn render_field_init_tail(inits: FieldInitList) -> string {
    match inits {
        .End -> ""
        .Node(name, sv, next) -> ", ${name}=${render_expr(sv.node)}${render_field_init_tail(next)}"
    }
}

/// Render a FieldList as an S-expression: `(name:Type, name2:Type)`.
export fn render_field_list(fields: FieldList) -> string {
    match fields {
        .End -> "()"
        .Node(name, vt, next) -> {
            let head = "${name}:${vtype_display(vt)}"
            let tail = render_field_list_tail(next)
            "(${head}${tail})"
        }
    }
}

/// Tail half of `render_field_list` — see `render_field_init_tail`.
fn render_field_list_tail(fields: FieldList) -> string {
    match fields {
        .End -> ""
        .Node(name, vt, next) -> ", ${name}:${vtype_display(vt)}${render_field_list_tail(next)}"
    }
}

/// Render a TypeNameList as a comma-separated string.
export fn render_type_name_list(names: TypeNameList) -> string {
    match names {
        .End -> ""
        .Node(name, next) -> {
            let rest = render_type_name_list(next)
            if rest == "" { name } else { "${name}, ${rest}" }
        }
    }
}

/// Render an ExprList as an S-expression: `(e1, e2, e3)`.
export fn render_expr_list(exprs: ExprList) -> string {
    match exprs {
        .End -> "()"
        .Node(se, next) -> {
            let head = render_expr(se.node)
            let tail = render_expr_list_tail(next)
            "(${head}${tail})"
        }
    }
}

/// Tail half of `render_expr_list` — see `render_field_init_tail`.
fn render_expr_list_tail(exprs: ExprList) -> string {
    match exprs {
        .End -> ""
        .Node(se, next) -> ", ${render_expr(se.node)}${render_expr_list_tail(next)}"
    }
}

/// Render a ParamList as `(name:Type, name2:Type)`.
export fn render_param_list(params: ParamList) -> string {
    match params {
        .End -> "()"
        .Node(name, _, next) -> {
            let tail = render_param_list_tail(next)
            "(${name}${tail})"
        }
    }
}

/// Tail half of `render_param_list` — see `render_field_init_tail`.
fn render_param_list_tail(params: ParamList) -> string {
    match params {
        .End -> ""
        .Node(name, _, next) -> ", ${name}${render_param_list_tail(next)}"
    }
}

/// Render a Stmt as an S-expression. Mirror to `render_expr` —
/// inspection-only, not source round-trip.
export fn render_stmt(stmt: Stmt) -> string {
    match stmt {
        .Let(name, vt, initializer) -> "(let ${name}:${vtype_display(vt)} ${render_expr(initializer)})"
        .Mut(name, vt, initializer) -> "(mut ${name}:${vtype_display(vt)} ${render_expr(initializer)})"
        .Const(name, vt, initializer) -> "(const ${name}:${vtype_display(vt)} ${render_expr(initializer)})"
        .Expr(expr) -> "(expr ${render_expr(expr)})"
        .Block(body) -> "(block ${render_stmt_list(body)})"
        .If(condition, then_branch, else_branch) -> {
            let base = "(if ${render_expr(condition)} ${render_stmt(then_branch)}"
            if else_branch == null {
                "${base})"
            } else {
                "${base} ${render_stmt(else_branch!)})"
            }
        }
        .While(condition, body) -> "(while ${render_expr(condition)} ${render_stmt(body)})"
        .For(variable, start, end, body) -> "(for ${variable} ${render_expr(start)}..${render_expr(end)} ${render_stmt(body)})"
        .ForIn(variable, collection, body) -> "(for-in ${variable} ${render_expr(collection)} ${render_stmt(body)})"
        .Function(name, tp, params, rvt, body) -> {
            let tp_str = render_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "(fn ${name}${tp_part} ${render_param_list(params)} -> ${vtype_display(rvt)} ${render_stmt_list(body)})"
        }
        .Return(value) -> "(return ${render_expr(value)})"
        .ReturnEmpty -> "(return)"
        .TypeDecl(name, tp, fields) -> {
            let tp_str = render_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "(type ${name}${tp_part} ${render_field_list(fields)})"
        }
        .NewtypeDecl(name, inner_vt) -> "(newtype ${name} = ${vtype_render_full(inner_vt)})"
        .UnionAliasDecl(name, type_vt) -> "(union-alias ${name} = ${vtype_render_full(type_vt)})"
        .ShapeDecl(name, fields) -> "(shape ${name} ${render_field_list(fields)})"
        .EnumDecl(name, tp, variants) -> {
            let tp_str = render_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "(enum ${name}${tp_part} ${render_variant_list(variants)})"
        }
        .Match(subject, arms) -> "(match ${render_expr(subject)} ${render_match_arm_list(arms)})"
        .Impl(name, methods) -> "(impl ${name} ${render_stmt_list(methods)})"
        .NoOp -> "(noop)"
        .ExternFn(name, params, rvt) -> "(extern ${name} ${render_param_list(params)} -> ${vtype_display(rvt)})"
        .Break -> "(break)"
        .Continue -> "(continue)"
        .TraitDecl(name, methods) -> "(trait ${name} ${render_stmt_list(methods)})"
        .LetDestructure(names, initializer) -> "(let-destruct ${render_param_list(names)} ${render_expr(initializer)})"
        .Defer(body) -> "(defer ${render_expr(body)})"
        .Errdefer(body) -> "(errdefer ${render_expr(body)})"
        .Annotated(annotations, inner) -> "(@annotated ${render_annotation_list(annotations)} ${render_stmt(inner)})"
        .SpecBlock(name, _) -> "(spec ${name} ...)"
        .GivenBlock(name, _) -> "(given ${name} ...)"
        .ThenBlock(name, cond) -> "(then ${name} ${render_expr(cond)})"
        .Select(_) -> "(select ...)"
        .Parallel(_) -> "(parallel ...)"
        .Module(name, body) -> "(module ${name} ${render_stmt_list(body)})"
        .Use(path, names) -> "(use ${path} ${render_param_list(names)})"
        .AssocType(name, ty_vt) -> if vtype_is_unknown(ty_vt) { "(assoc-type ${name})" } else { "(assoc-type ${name} = ${vtype_render_full(ty_vt)})" }
        .ComponentDef(name, params, _, _, _, body) -> "(component-def ${name} ${render_param_list(params)} ${render_stmt_list(body)})"
        .ComponentBlock(comp, inst, _, body) -> "(component-block ${comp} ${inst} ${render_stmt_list(body)})"
    }
}

/// Render an AnnotationList in the source `@name @name2` form.
export fn render_annotation_list(annots: AnnotationList) -> string {
    match annots {
        .End -> ""
        .Node(name, _, next) -> "@${name} ${render_annotation_list(next)}"
    }
}

/// Render a VariantList as an S-expression: `(Ok(value:T), Err(error:E))`.
export fn render_variant_list(variants: VariantList) -> string {
    match variants {
        .End -> "()"
        .Node(name, fields, next) -> {
            let head = "${name}${render_field_list(fields)}"
            let tail = render_variant_tail(next)
            "(${head}${tail})"
        }
    }
}

/// Tail half of `render_variant_list` — see `render_field_init_tail`.
fn render_variant_tail(variants: VariantList) -> string {
    match variants {
        .End -> ""
        .Node(name, fields, next) -> ", ${name}${render_field_list(fields)}${render_variant_tail(next)}"
    }
}

/// Render a Pattern as an S-expression — used by render_match_arm.
export fn render_pattern(p: Pattern) -> string {
    match p {
        .Wildcard -> "_"
        .Variant(name, bindings) -> ".${name}${render_param_list(bindings)}"
        .Or(left, right) -> "${render_pattern(left)} or ${render_pattern(right)}"
        .TypePattern(type_name, binding) -> "${type_name}(${binding})"
        _ -> "?"
    }
}

/// Render a MatchArmList as a comma-separated list of `pat -> body`.
export fn render_match_arm_list(arms: MatchArmList) -> string {
    match arms {
        .End -> "()"
        .Node(pattern, guard, body, next) -> {
            let guard_str = if guard != null { " if ${render_expr(guard!.node)}" } else { "" }
            let head = "${render_pattern(pattern)}${guard_str} -> ${render_expr(body.node)}"
            let tail = render_match_arm_tail(next)
            "(${head}${tail})"
        }
    }
}

/// Tail half of `render_match_arm_list` — see `render_field_init_tail`.
fn render_match_arm_tail(arms: MatchArmList) -> string {
    match arms {
        .End -> ""
        .Node(pattern, guard, body, next) -> {
            let guard_str = if guard != null { " if ${render_expr(guard!.node)}" } else { "" }
            "; ${render_pattern(pattern)}${guard_str} -> ${render_expr(body.node)}${render_match_arm_tail(next)}"
        }
    }
}

/// Render a StmtList as an S-expression sequence — convenient for
/// `render_stmt` recursion on Block bodies.
export fn render_stmt_list(stmts: StmtList) -> string {
    match stmts {
        .End -> ""
        .Node(ss, next) -> {
            let head = render_stmt(ss.node)
            let tail = render_stmt_list(next)
            if tail == "" {
                head
            } else {
                "${head}\n${tail}"
            }
        }
    }
}

// ── Token kinds ──
//
// Enum-based token kinds — replaces the historic string-tag dispatch
// in the parser. Type-safe, integer-comparison fast, and exhaustive-
// match-checked. Adding a new token requires:
//   - a Tk variant here
//   - an entry in `tk_keyword_str` (and `p_keyword_kind` for keywords)
//   - lexer recognition in `parse/lexer.av`
//   - any seed-patching needed when bs2 self-compiles past the change.

/// Token kind discriminant. Each variant maps to one of:
///   - punctuation (LeftParen, Dot, ...)
///   - operators (Plus, EqualEqual, ...)
///   - keywords (KwLet, KwFn, ...)
///   - reserved-but-inactive keywords (KwReserved family)
///   - literals (Number, String, Bool, ...)
///   - documentation (DocComment, ModDocComment)
///   - whitespace / structural (Newline, Eof)
export enum Tk {
    // Punctuation
    LeftParen
    RightParen
    LeftBrace
    RightBrace
    LeftBracket
    RightBracket
    Comma
    Dot
    DotDot
    Colon
    Arrow
    LeftArrow
    At
    Tilde
    Question
    QuestionDot
    QuestionQuestion
    // Operators
    Plus
    Minus
    Star
    Slash
    Percent
    Equal
    EqualEqual
    Bang
    BangEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    Amp
    AmpAmp
    Pipe
    PipePipe
    PipeGt
    Caret
    Shl
    Shr
    // Literals
    Number
    Float
    String
    Template
    Identifier
    // Keywords
    KwAnd
    KwBreak
    KwCatch
    KwConst
    KwContinue
    KwDefer
    KwElse
    KwErrdefer
    KwEnum
    KwExport
    KwExtern
    KwFalse
    KwFn
    KwFor
    KwGiven
    KwIf
    KwImpl
    KwIn
    KwIs
    KwLet
    KwMatch
    KwMod
    KwMut
    KwNot
    KwNull
    KwOr
    KwParallel
    KwReturn
    KwSpawn
    KwSelect
    KwShape
    KwSpec
    KwThen
    KwTrait
    KwTrue
    KwType
    KwUse
    KwWhere
    KwWhile
    KwWith
    KwComponent
    KwDyn
    KwWhen
    KwQuote
    // Reserved future keywords (parse as errors)
    KwReserved
    // Doc comments
    DocComment
    ModDocComment
    // Special
    Eof
    Error
}

// Bridge: convert Tk keyword to the string used by the feature registry.
// Returns "" for non-keyword tokens.
/// Map a keyword Tk variant back to its source-form string. Used by
/// the parser's stmt-keyword dispatch and by error rendering when
/// the lexer's lexeme isn't directly accessible.
export fn tk_keyword_str(tk: Tk) -> string {
    match tk {
        .KwAnd -> "kw_and"
        .KwBreak -> "kw_break"
        .KwCatch -> "kw_catch"
        .KwConst -> "kw_const"
        .KwContinue -> "kw_continue"
        .KwDefer -> "kw_defer"
        .KwElse -> "kw_else"
        .KwErrdefer -> "kw_errdefer"
        .KwEnum -> "kw_enum"
        .KwExport -> "kw_export"
        .KwExtern -> "kw_extern"
        .KwFalse -> "kw_false"
        .KwFn -> "kw_fn"
        .KwFor -> "kw_for"
        .KwGiven -> "kw_given"
        .KwIf -> "kw_if"
        .KwImpl -> "kw_impl"
        .KwIn -> "kw_in"
        .KwIs -> "kw_is"
        .KwLet -> "kw_let"
        .KwMatch -> "kw_match"
        .KwMod -> "kw_mod"
        .KwMut -> "kw_mut"
        .KwNot -> "kw_not"
        .KwNull -> "kw_null"
        .KwOr -> "kw_or"
        .KwParallel -> "kw_parallel"
        .KwReturn -> "kw_return"
        .KwSpawn -> "kw_spawn"
        .KwSelect -> "kw_select"
        .KwShape -> "kw_shape"
        .KwSpec -> "kw_spec"
        .KwThen -> "kw_then"
        .KwTrait -> "kw_trait"
        .KwTrue -> "kw_true"
        .KwType -> "kw_type"
        .KwUse -> "kw_use"
        .KwWhere -> "kw_where"
        .KwWhile -> "kw_while"
        .KwWith -> "kw_with"
        .KwComponent -> "kw_component"
        .KwDyn -> "kw_dyn"
        .KwWhen -> "kw_when"
        .KwQuote -> "kw_quote"
        _ -> ""
    }
}
