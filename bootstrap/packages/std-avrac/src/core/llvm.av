// WHY: single-source-of-truth declarations for the LLVM C API
// functions used by the bootstrap codegen. Every feature codegen
// file imports from here instead of re-declaring externs locally.
//
// These are C ABI functions provided by bootstrap/llvm_wrapper.c
// — thin wrappers around the LLVM 21 C API. No Rust dependency.

// ── Context / module / builder lifecycle ──
extern fn avra_llvm_context_create() -> ptr
extern fn avra_llvm_context_dispose(ctx: ptr)
extern fn avra_llvm_module_create(name: string, ctx: ptr) -> ptr
extern fn avra_llvm_module_dispose(m: ptr)
extern fn avra_llvm_create_builder(ctx: ptr) -> ptr
extern fn avra_llvm_dispose_builder(b: ptr)

// ── Types ──
extern fn avra_llvm_int1_type(ctx: ptr) -> ptr
extern fn avra_llvm_int8_type(ctx: ptr) -> ptr
extern fn avra_llvm_int16_type(ctx: ptr) -> ptr
extern fn avra_llvm_int32_type(ctx: ptr) -> ptr
extern fn avra_llvm_int64_type(ctx: ptr) -> ptr
extern fn avra_llvm_pointer_type(ctx: ptr) -> ptr
extern fn avra_llvm_const_null(ty: ptr) -> ptr
extern fn avra_llvm_void_type(ctx: ptr) -> ptr
extern fn avra_llvm_function_type(ret: ptr, params: ptr, count: int, is_var: int) -> ptr
extern fn avra_llvm_struct_create_named(ctx: ptr, name: string) -> ptr
extern fn avra_llvm_struct_set_body(st: ptr, elems: ptr, count: int, packed: int) -> ptr
extern fn avra_llvm_get_type_by_name(ctx: ptr, name: string) -> ptr

// ── Type / value arrays ──
extern fn avra_llvm_type_array_new(count: int) -> ptr
extern fn avra_llvm_type_array_set(arr: ptr, idx: int, ty: ptr)
extern fn avra_llvm_type_array_free(arr: ptr)
extern fn avra_llvm_value_array_new(count: int) -> ptr
extern fn avra_llvm_value_array_set(arr: ptr, idx: int, val: ptr)
extern fn avra_llvm_value_array_get(arr: ptr, idx: int) -> ptr
extern fn avra_llvm_value_array_free(arr: ptr)

// ── Constants ──
extern fn avra_llvm_const_int(ty: ptr, value: int, sign_extend: int) -> ptr

// ── Functions ──
extern fn avra_llvm_add_function(m: ptr, name: string, fn_type: ptr) -> ptr
extern fn avra_llvm_get_named_function(m: ptr, name: string) -> ptr
extern fn avra_llvm_get_param(fn_val: ptr, idx: int) -> ptr
extern fn avra_llvm_count_params(fn_val: ptr) -> int
extern fn avra_llvm_fn_type_of(fn_val: ptr) -> ptr

// ── Globals ──
extern fn avra_llvm_add_global(m: ptr, ty: ptr, name: string) -> ptr
extern fn avra_llvm_set_initializer(g: ptr, val: ptr)

// Mark an LLVM Value (fn or global) as linkonce_odr — library-mode
// uses this on auto-generated helper symbols so consumers and
// producers can both emit them without the linker rejecting
// duplicates.
extern fn avra_llvm_set_linkonce_odr(v: ptr)

// ── Basic blocks ──
extern fn avra_llvm_append_basic_block(ctx: ptr, fn_val: ptr, name: string) -> ptr
extern fn avra_llvm_position_at_end(b: ptr, bb: ptr)
extern fn avra_llvm_block_has_terminator(b: ptr) -> int

// ── Builder — arithmetic ──
extern fn avra_llvm_build_add(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_sub(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_mul(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_sdiv(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_srem(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_udiv(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_urem(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_and(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_or(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_xor(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_shl(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_lshr(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_ashr(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_not(b: ptr, val: ptr, name: string) -> ptr

// ── Builder — comparison ──
extern fn avra_llvm_build_icmp(b: ptr, pred: int, lhs: ptr, rhs: ptr, name: string) -> ptr

// ── Builder — conversion ──
extern fn avra_llvm_build_zext(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_sext(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_ptr_to_int(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_int_to_ptr(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_si_to_fp(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_fp_to_si(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_bitcast(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn avra_llvm_double_type(ctx: ptr) -> ptr

// ── Builder — float arithmetic ──
extern fn avra_llvm_build_fadd(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_fsub(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_fmul(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_fdiv(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_frem(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn avra_llvm_build_fneg(b: ptr, val: ptr, name: string) -> ptr
extern fn avra_llvm_build_fcmp(b: ptr, pred: int, lhs: ptr, rhs: ptr, name: string) -> ptr

// ── Builder — memory ──
extern fn avra_llvm_build_alloca(b: ptr, ty: ptr, name: string) -> ptr
extern fn avra_llvm_build_load(b: ptr, ty: ptr, ptr_val: ptr, name: string) -> ptr
extern fn avra_llvm_build_store(b: ptr, val: ptr, ptr_val: ptr) -> ptr
extern fn avra_llvm_build_struct_gep2(b: ptr, ty: ptr, ptr_val: ptr, idx: int, name: string) -> ptr
extern fn avra_llvm_build_global_string_ptr(b: ptr, s: string, name: string) -> ptr

// ── Builder — calls ──
extern fn avra_llvm_build_call(b: ptr, fn_type: ptr, fn_val: ptr, args: ptr, count: int, name: string) -> ptr

// ── Builder — control flow ──
extern fn avra_llvm_build_br(b: ptr, bb: ptr) -> ptr
extern fn avra_llvm_build_cond_br(b: ptr, cond: ptr, then_bb: ptr, else_bb: ptr) -> ptr
extern fn avra_llvm_build_ret(b: ptr, val: ptr) -> ptr
extern fn avra_llvm_build_unreachable(b: ptr) -> ptr

// ── Builder — PHI nodes ──
extern fn avra_llvm_build_phi(b: ptr, ty: ptr, name: string) -> ptr
extern fn avra_llvm_add_incoming(phi: ptr, value: ptr, block: ptr)

// ── Builder — introspection ──
extern fn avra_llvm_get_insert_block(b: ptr) -> ptr

// ── Type introspection ──
extern fn avra_llvm_is_ptr_value(val: ptr) -> int
extern fn avra_llvm_typeof(val: ptr) -> ptr
extern fn avra_llvm_cast_to_type(b: ptr, val: ptr, expected: ptr) -> ptr
extern fn avra_llvm_is_void_value(val: ptr) -> int
extern fn avra_llvm_build_store_cast(b: ptr, val: ptr, dest: ptr)
extern fn avra_llvm_type_kind(ty: ptr) -> int
extern fn avra_llvm_int_type_width(ty: ptr) -> int

// ── Type-coercing call ──
extern fn avra_llvm_build_call_coerce(b: ptr, fn_type: ptr, fn_val: ptr, args: ptr, count: int, name: string) -> ptr

// ── Module output ──
extern fn avra_llvm_print_module_to_file(m: ptr, path: string) -> int
extern fn avra_llvm_verify_module_print(m: ptr) -> int
extern fn avra_llvm_verify_function(fn_val: ptr) -> int

// ── Coverage instrumentation ──
extern fn avra_coverage_declare(m: ptr)
extern fn avra_coverage_emit_hit(builder: ptr, m: ptr, fn_name: string, fn_hash: int, num_counters: int, counter_idx: int)
extern fn avra_covmap_begin(source_file: string, covmap_path: string)
extern fn avra_covmap_alloc(cov_type: string, fn_name: string, line: int, col: int, branch_id: int) -> int
extern fn avra_covmap_reset_fn()
extern fn avra_covmap_next_branch_id() -> int
extern fn avra_covmap_next_decision_id() -> int
extern fn avra_coverage_finalize_fn(fn_val: ptr, actual_count: int)
extern fn avra_covmap_end()
extern fn avra_covmap_counter_count() -> int

// ── Basic block / instruction helpers ──
extern fn avra_llvm_get_entry_basic_block(fn_val: ptr) -> ptr
extern fn avra_llvm_get_first_instruction(bb: ptr) -> ptr
extern fn avra_llvm_position_before(builder: ptr, instr: ptr)
extern fn avra_llvm_build_call_void(builder: ptr, module: ptr, fn_name: string, args: ptr, arg_count: int)

// ── Object emission ──
