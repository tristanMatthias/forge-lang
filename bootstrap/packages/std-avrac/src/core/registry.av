// WHY: central feature registry. Each feature declares a Feature struct
// with all handlers (emit, resolve, check). Registration uses dummy
// enum values to derive tags — no magic numbers.
//
// To add a new feature:
//   1. Create features/<name>/mod.av
//   2. Build a Feature with your handlers
//   3. Call register_feature() with a dummy Expr/Stmt value
//   4. One line in build_registry()

use features.grammar.{BuilderBind}

// C-side helpers
extern fn avra_expr_tag(expr: int) -> int
extern fn avra_stmt_tag(stmt: int) -> int
extern fn avra_intmap_new() -> ptr
extern fn avra_intmap_set(map: ptr, key: int, value: int)
extern fn avra_intmap_get(map: ptr, key: int) -> int
extern fn avra_intmap_has(map: ptr, key: int) -> int
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int
extern fn avra_map_keys_cstr(map: ptr) -> List<string>


// ── No-op handlers ──
//
// Default handlers used by `feature_new` so a Feature only has to
// override the callbacks it actually implements — and the config defaults
// of the `LanguageFeature` component (features/lang.av), hence exported.
// The codegen and
// eval no-ops return a "no handler" error so bugs that route a node
// to an unregistered feature surface loudly instead of silently;
// the resolver / typecheck no-ops pass through unchanged because
// those passes have non-error fallback shapes.


// ── Registry ──

/// Compiled lookup tables for feature dispatch. Each map keys an
/// integer tag (Expr/Stmt variant tag) or a keyword string to the
/// corresponding handler `fn` (stored as int — Avra has no fn-ptr
/// type at this layer, so the cast happens at dispatch time).
/// Built once via `build_registry()` and consulted by every pass.
export type Registry = {
    expr_emitters: ptr,
    stmt_emitters: ptr,
    expr_resolvers: ptr,
    stmt_resolvers: ptr,
    expr_checkers: ptr,
    stmt_checkers: ptr,
    expr_evals: ptr,
    stmt_evals: ptr,
    // GENERIC named sets, keyed "<set>:<key>". core/ deliberately does NOT know
    // what sets exist — `component_names`, `expr_keywords` and `raw_body_comps`
    // used to be three FIELDS here, which made core/ aware of components and of
    // `kw { … }` expression forms: feature-specific knowledge in the layer every
    // feature imports (CLAUDE.md, "core is infrastructure only"). The set NAMES
    // now live with the features that own them; core only stores strings.
    //
    // Composite keys rather than a map-of-maps: the value slot is an int, so
    // nesting would mean storing a ptr as an int and coercing it back. Set names
    // and keys are both identifiers, so ":" cannot occur in either and the
    // composite is unambiguous.
    named_sets: ptr,
    // Feature-supplied grammar-build lowerings (t-kd4y.3) — the composed
    // manifest from `feature_builders()`, consulted by the grammar
    // executor's `apply_build` before its central dispatch. Populated
    // once by `build_registry`.
    builder_binds: List<BuilderBind>,
}

/// Empty registry — every map is freshly allocated. Use `register`
/// to populate it from Feature records.
export fn registry_new() -> Registry {
    Registry {
        expr_emitters: avra_intmap_new(),
        stmt_emitters: avra_intmap_new(),
        expr_resolvers: avra_intmap_new(),
        stmt_resolvers: avra_intmap_new(),
        expr_checkers: avra_intmap_new(),
        stmt_checkers: avra_intmap_new(),
        expr_evals: avra_intmap_new(),
        stmt_evals: avra_intmap_new(),
        named_sets: avra_map_new_cstr(),
        builder_binds: [],
    }
}


// ── Dispatch ──
//
// Each pass calls `has_*` to probe whether a feature is registered
// for a tag, then `dispatch_*` to invoke the handler. The Option
// return on dispatch_* lets callers fall back to the legacy in-tree
// match arms when no feature is registered.











/// Look up a decl parser by leading keyword (e.g. `"fn"`). Returns

/// True when `name` was declared as a component. This is the whole contract:
/// the executor's `comp_name_is_registered` predicate asks nothing else of it,
/// and the `bare_comp_inst` / `bare_comp_inst_raw` conds are its only
/// consumers.
///
/// It used to be `lookup_stmt_parser(...) -> int?`, storing a
/// `fn(Parser) -> Result<StmtId, string>` per name — but NOTHING ever
/// invoked the stored value (the generated parser handles instantiation
/// natively via `parse_bare_comp_inst`/`_raw`), and the sole consumer
/// tested `!= null`. So the map was a SET wearing a handler map's
/// signature, and the two closures that fed it were the only thing keeping
/// Add `key` to the named set `set`. The ONE write primitive for every
/// registry set; core/ stores the string and knows nothing about what the set
/// means. See the `named_sets` field for why the key is composite.
export fn registry_set_add(reg: Registry, set: string, key: string) {
    avra_map_set_cstr(reg.named_sets, set + ":" + key, 1)
}

/// True when `key` is in the named set `set`. The ONE read primitive.
///
/// Every consumer of the sets this replaced only ever asked PRESENCE —
/// `is_registered_component`, `is_expr_keyword` and `component_is_raw_body`
/// were all a single `avra_map_has_cstr` / `!= 0`. Nothing retrieved a value,
/// which is why a set (not a handler map) was the honest shape and why one
/// generic primitive covers all three.
export fn registry_set_has(reg: Registry, set: string, key: string) -> bool {
    avra_map_has_cstr(reg.named_sets, set + ":" + key) != 0
}

// ── Build the registry ──


