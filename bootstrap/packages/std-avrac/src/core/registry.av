// WHY: central feature registry. Each feature declares a Feature struct
// with all handlers (emit, resolve, check). Registration uses dummy
// enum values to derive tags — no magic numbers.
//
// To add a new feature:
//   1. Create features/<name>/mod.av
//   2. Build a Feature with your handlers
//   3. Call register_feature() with a dummy Expr/Stmt value
//   4. One line in build_registry()

use features.grammar.{BuilderBind}

// C-side helpers
extern fn avra_expr_tag(expr: int) -> int
extern fn avra_stmt_tag(stmt: int) -> int
extern fn avra_intmap_new() -> ptr
extern fn avra_intmap_set(map: ptr, key: int, value: int)
extern fn avra_intmap_get(map: ptr, key: int) -> int
extern fn avra_intmap_has(map: ptr, key: int) -> int
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int
extern fn avra_map_keys_cstr(map: ptr) -> List<string>


// ── No-op handlers ──
//
// Default handlers used by `feature_new` so a Feature only has to
// override the callbacks it actually implements — and the config defaults
// of the `LanguageFeature` component (features/lang.av), hence exported.
// The codegen and
// eval no-ops return a "no handler" error so bugs that route a node
// to an unregistered feature surface loudly instead of silently;
// the resolver / typecheck no-ops pass through unchanged because
// those passes have non-error fallback shapes.


// ── Registry ──

/// Compiled lookup tables for feature dispatch. Each map keys an
/// integer tag (Expr/Stmt variant tag) or a keyword string to the
/// corresponding handler `fn` (stored as int — Avra has no fn-ptr
/// type at this layer, so the cast happens at dispatch time).
/// Built once via `build_registry()` and consulted by every pass.
export type Registry = {
    expr_emitters: ptr,
    stmt_emitters: ptr,
    expr_resolvers: ptr,
    stmt_resolvers: ptr,
    expr_checkers: ptr,
    stmt_checkers: ptr,
    expr_evals: ptr,
    stmt_evals: ptr,
    // Component names declared so far — a SET, not a handler map. The
    // value slot is a constant 1: nothing ever invoked the handler this
    // map used to store, and the one consumer (`is_registered_component`)
    // only ever asked whether the key was present.
    component_names: ptr,
    // The keywords that lead a `kw { … }` expression construct — a SET, like
    // component_names above, and for the same reason: the value slot is a
    // constant 1 because nothing ever invoked the handler this map used to
    // store, and its one consumer only ever asks whether the key is PRESENT.
    // That presence test is genuinely load-bearing: it drives the
    // `ident_lbrace_plain` / `ident_lbrace_feature` peek conditions that
    // disambiguate `IDENT {` between a struct literal, `grammar { … }` and
    // `table { … }`.
    expr_keywords: ptr,
    // Component names declared with `body: TokenStream` (vez6.9) —
    // parse-time routing state alongside the name's component_names
    // entry, so every instance-block production (keyword-free,
    // keyword-prefixed, nested) agrees on raw-vs-structured capture.
    raw_body_comps: ptr,
    // Feature-supplied grammar-build lowerings (t-kd4y.3) — the composed
    // manifest from `feature_builders()`, consulted by the grammar
    // executor's `apply_build` before its central dispatch. Populated
    // once by `build_registry`.
    builder_binds: List<BuilderBind>,
}

/// Empty registry — every map is freshly allocated. Use `register`
/// to populate it from Feature records.
export fn registry_new() -> Registry {
    Registry {
        expr_emitters: avra_intmap_new(),
        stmt_emitters: avra_intmap_new(),
        expr_resolvers: avra_intmap_new(),
        stmt_resolvers: avra_intmap_new(),
        expr_checkers: avra_intmap_new(),
        stmt_checkers: avra_intmap_new(),
        expr_evals: avra_intmap_new(),
        stmt_evals: avra_intmap_new(),
        component_names: avra_map_new_cstr(),
        expr_keywords: avra_map_new_cstr(),
        raw_body_comps: avra_map_new_cstr(),
        builder_binds: [],
    }
}


// ── Dispatch ──
//
// Each pass calls `has_*` to probe whether a feature is registered
// for a tag, then `dispatch_*` to invoke the handler. The Option
// return on dispatch_* lets callers fall back to the legacy in-tree
// match arms when no feature is registered.











/// Look up a decl parser by leading keyword (e.g. `"fn"`). Returns

/// True when `name` was declared as a component. This is the whole contract:
/// the executor's `comp_name_is_registered` predicate asks nothing else of it,
/// and the `bare_comp_inst` / `bare_comp_inst_raw` conds are its only
/// consumers.
///
/// It used to be `lookup_stmt_parser(...) -> int?`, storing a
/// `fn(Parser) -> Result<StmtId, string>` per name — but NOTHING ever
/// invoked the stored value (the generated parser handles instantiation
/// natively via `parse_bare_comp_inst`/`_raw`), and the sole consumer
/// tested `!= null`. So the map was a SET wearing a handler map's
/// signature, and the two closures that fed it were the only thing keeping
/// ~650 lines of retired hand parser alive to satisfy an argument nobody
/// read. Storing a function pointer as an untyped `int` was also the same
/// rule-16 defect as the old `Feature.emit_expr: int`.
export fn is_registered_component(reg: Registry, name: string) -> bool {
    avra_map_has_cstr(reg.component_names, name) != 0
}

/// True when `keyword` leads a registered `kw { … }` expression construct
/// (e.g. `grammar`). This is the whole contract — the executor's
/// `ident_lbrace_plain` / `ident_lbrace_feature` peek conditions ask nothing
/// else of it, and through them the generated parser decides whether `IDENT {`
/// opens a struct literal, a `grammar { … }` block or a `table { … }`.
///
/// It used to be `lookup_expr_parser(...) -> int?`, returning "the parse_expr
/// handler-fn-as-int" — and nothing ever retrieved it. The map's only read was
/// `avra_map_has_cstr` (presence); no consumer ever called `avra_map_get_cstr`
/// on it, so the stored handler could not run.
///
/// Note the value COULD have been called, contrary to what an earlier version
/// of this comment claimed: `dispatch_expr_emit` (below) does exactly that for
/// the emitter maps — `avra_intmap_get` returns an `int` which is bound to a
/// fn-typed local and invoked. That coercion is the language's ambient
/// int-as-fn-pointer convention, and it is why `Feature.emit_expr: int` still
/// works. So this was dead by DISUSE, not by impossibility.
///
/// The old doc also cited `parse_primary`, which t-47hc deleted.
export fn is_expr_keyword(reg: Registry, keyword: string) -> bool {
    avra_map_has_cstr(reg.expr_keywords, keyword) != 0
}

/// Register a component name for keyword-free instantiation. After
/// this, `name instance { ... }` at statement level is parsed as a
/// ComponentBlock — the component declaration's name acts as a
/// pseudo-keyword in the stmt parser.
export fn register_component_name(reg: Registry, name: string) {
    avra_map_set_cstr(reg.component_names, name, 1)
}

/// Mark `name` as a `body: TokenStream` component (vez6.9): its
/// instance blocks capture raw tokens instead of structured Avra.
export fn register_raw_body_component(reg: Registry, name: string) {
    avra_map_set_cstr(reg.raw_body_comps, name, 1)
}

/// True when `name` was declared with `body: TokenStream`.
export fn component_is_raw_body(reg: Registry, name: string) -> bool {
    avra_map_get_cstr(reg.raw_body_comps, name) != 0
}

// ── Build the registry ──


