// WHY: central feature registry. Each feature declares a Feature struct
// with all handlers (emit, resolve, check). Registration uses dummy
// enum values to derive tags — no magic numbers.
//
// To add a new feature:
//   1. Create features/<name>/mod.av
//   2. Build a Feature with your handlers
//   3. Call register_feature() with a dummy Expr/Stmt value
//   4. One line in build_registry()

use codegen.{err_emit, StmtResult}
use codegen.{err_sr}
use features.{init_features}
use features.grammar.{BuilderBind}
use typeck.{tc_er}
use features.eval.{value_null}

// C-side helpers
extern fn avra_expr_tag(expr: int) -> int
extern fn avra_stmt_tag(stmt: int) -> int
extern fn avra_intmap_new() -> ptr
extern fn avra_intmap_set(map: ptr, key: int, value: int)
extern fn avra_intmap_get(map: ptr, key: int) -> int
extern fn avra_intmap_has(map: ptr, key: int) -> int
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

/// One language feature's declarative registration. A Feature
/// bundles every callback the compiler might invoke for a specific
/// AST shape — parse, resolve, typecheck, eval (interpreter), and
/// codegen — so adding a feature is a single decl change at the
/// registry, no scattered if-chains.
/// @field name           — for diagnostics / introspection.
/// @field expr_tag       — sentinel Expr value whose tag this feature
///                          handles (null when not an expr feature).
/// @field stmt_tag       — sentinel Stmt value, mirror of expr_tag.
/// @field expr_keyword   — leading keyword of a `kw { … }` expression
///                          construct (e.g. "grammar"); the generic
///                          "registered `<keyword> { }` → package parser"
///                          seam for embedded sublanguages.
export type Feature = {
    name: string,
    expr_tag: Expr?,
    stmt_tag: Stmt?,
    expr_keyword: string,
    // Properly typed, like every sibling hook below. These were `int` — a
    // function pointer stored as an untyped integer, riding the language's
    // ambient int-as-fn-pointer coercion (rule 16, in core/ of all places).
    // Nothing required it: `feature_new` already assigned the FUNCTIONS
    // `noop_emit_expr`/`noop_emit_stmt` to them, `LanguageFeature` has always
    // declared these fields with these exact signatures, and no code did
    // arithmetic or an int comparison on either. The intmap round-trip is
    // identical for the typed siblings (resolve/check/eval), which go through
    // the same `avra_intmap_set` and the same fn-typed `avra_intmap_get` read.
    emit_expr: fn(Ctx, List<VarBinding>, Expr) -> Result<EmitValue, string>,
    emit_stmt: fn(Ctx, List<VarBinding>, Stmt) -> Result<StmtResult, string>,
    resolve_expr: fn(Resolver, Expr) -> Resolver,
    resolve_stmt: fn(Resolver, Stmt) -> Resolver,
    check_expr: fn(TC, Expr) -> ExprResult,
    check_stmt: fn(TC, Stmt) -> TC,
    eval_expr: fn(Runtime, Expr) -> StepResult,
    eval_stmt: fn(Runtime, Stmt) -> StepResult,
}

// ── No-op handlers ──
//
// Default handlers used by `feature_new` so a Feature only has to
// override the callbacks it actually implements — and the config defaults
// of the `LanguageFeature` component (features/lang.av), hence exported.
// The codegen and
// eval no-ops return a "no handler" error so bugs that route a node
// to an unregistered feature surface loudly instead of silently;
// the resolver / typecheck no-ops pass through unchanged because
// those passes have non-error fallback shapes.

/// Codegen no-op for expressions — `err_emit("no expr handler")`.
export fn noop_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> { err_emit("no expr handler") }
/// Codegen no-op for statements — `err_sr("no stmt handler")`.
export fn noop_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> { err_sr("no stmt handler") }
/// Resolver no-op for expressions — pass-through.
export fn noop_resolve_expr(r: Resolver, expr: Expr) -> Resolver { r }
/// Resolver no-op for statements — pass-through.
export fn noop_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver { r }
/// Typecheck no-op for expressions — yields `Unknown`.
export fn noop_check_expr(tc: TC, expr: Expr) -> ExprResult { tc_er(tc, .Unknown) }
/// Typecheck no-op for statements — pass-through.
export fn noop_check_stmt(tc: TC, stmt: Stmt) -> TC { tc }
/// Eval no-op for expressions — error step ("no eval_expr handler").
export fn noop_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    StepResult { runtime: rt, value: value_null(), had_error: true, is_return: false, error_message: "no eval_expr handler" }
}
/// Eval no-op for statements — error step ("no eval_stmt handler").
export fn noop_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    StepResult { runtime: rt, value: value_null(), had_error: true, is_return: false, error_message: "no eval_stmt handler" }
}
/// Construct a Feature with no-op handlers. Each feature module
/// builds on this with `with`-updates to register its own callbacks.
export fn feature_new(name: string) -> Feature {
    Feature {
        name,
        expr_tag: null,
        stmt_tag: null,
        expr_keyword: "",
        emit_expr: noop_emit_expr,
        emit_stmt: noop_emit_stmt,
        resolve_expr: noop_resolve_expr,
        resolve_stmt: noop_resolve_stmt,
        check_expr: noop_check_expr,
        check_stmt: noop_check_stmt,
        eval_expr: noop_eval_expr,
        eval_stmt: noop_eval_stmt,
    }
}

// ── Registry ──

/// Compiled lookup tables for feature dispatch. Each map keys an
/// integer tag (Expr/Stmt variant tag) or a keyword string to the
/// corresponding handler `fn` (stored as int — Avra has no fn-ptr
/// type at this layer, so the cast happens at dispatch time).
/// Built once via `build_registry()` and consulted by every pass.
export type Registry = {
    expr_emitters: ptr,
    stmt_emitters: ptr,
    expr_resolvers: ptr,
    stmt_resolvers: ptr,
    expr_checkers: ptr,
    stmt_checkers: ptr,
    expr_evals: ptr,
    stmt_evals: ptr,
    // Component names declared so far — a SET, not a handler map. The
    // value slot is a constant 1: nothing ever invoked the handler this
    // map used to store, and the one consumer (`is_registered_component`)
    // only ever asked whether the key was present.
    component_names: ptr,
    // The keywords that lead a `kw { … }` expression construct — a SET, like
    // component_names above, and for the same reason: the value slot is a
    // constant 1 because nothing ever invoked the handler this map used to
    // store, and its one consumer only ever asks whether the key is PRESENT.
    // That presence test is genuinely load-bearing: it drives the
    // `ident_lbrace_plain` / `ident_lbrace_feature` peek conditions that
    // disambiguate `IDENT {` between a struct literal, `grammar { … }` and
    // `table { … }`.
    expr_keywords: ptr,
    // Component names declared with `body: TokenStream` (vez6.9) —
    // parse-time routing state alongside the name's component_names
    // entry, so every instance-block production (keyword-free,
    // keyword-prefixed, nested) agrees on raw-vs-structured capture.
    raw_body_comps: ptr,
    // Feature-supplied grammar-build lowerings (t-kd4y.3) — the composed
    // manifest from `feature_builders()`, consulted by the grammar
    // executor's `apply_build` before its central dispatch. Populated
    // once by `build_registry`.
    builder_binds: List<BuilderBind>,
}

/// Empty registry — every map is freshly allocated. Use `register`
/// to populate it from Feature records.
export fn registry_new() -> Registry {
    Registry {
        expr_emitters: avra_intmap_new(),
        stmt_emitters: avra_intmap_new(),
        expr_resolvers: avra_intmap_new(),
        stmt_resolvers: avra_intmap_new(),
        expr_checkers: avra_intmap_new(),
        stmt_checkers: avra_intmap_new(),
        expr_evals: avra_intmap_new(),
        stmt_evals: avra_intmap_new(),
        component_names: avra_map_new_cstr(),
        expr_keywords: avra_map_new_cstr(),
        raw_body_comps: avra_map_new_cstr(),
        builder_binds: [],
    }
}

/// Index `f` into every relevant map. Reads the variant tags off
/// the sentinel `expr_tag` / `stmt_tag` values when present, plus
/// the keyword strings for parser dispatch.
export fn register(reg: Registry, f: Feature) {
    if f.expr_tag != null {
        let etag = avra_expr_tag(f.expr_tag!)
        avra_intmap_set(reg.expr_emitters, etag, f.emit_expr)
        avra_intmap_set(reg.expr_resolvers, etag, f.resolve_expr)
        avra_intmap_set(reg.expr_checkers, etag, f.check_expr)
        avra_intmap_set(reg.expr_evals, etag, f.eval_expr)
    }
    if f.stmt_tag != null {
        let stag = avra_stmt_tag(f.stmt_tag!)
        avra_intmap_set(reg.stmt_emitters, stag, f.emit_stmt)
        avra_intmap_set(reg.stmt_resolvers, stag, f.resolve_stmt)
        avra_intmap_set(reg.stmt_checkers, stag, f.check_stmt)
        avra_intmap_set(reg.stmt_evals, stag, f.eval_stmt)
    }
    // stmt_keyword/parse_stmt died measured-unread (t-kd4y slice-1 evidence:
    // these writes keyed kw_*-style names the token-text lookup could never
    // match; the component_names set serves component names, written by
    // register_component_name). Batch A deleted the fields.
    if f.expr_keyword.length > 0 {
        avra_map_set_cstr(reg.expr_keywords, f.expr_keyword, 1)
    }
}

// ── Dispatch ──
//
// Each pass calls `has_*` to probe whether a feature is registered
// for a tag, then `dispatch_*` to invoke the handler. The Option
// return on dispatch_* lets callers fall back to the legacy in-tree
// match arms when no feature is registered.

/// True iff a feature has registered an expr-codegen handler for
/// this Expr-variant tag.
export fn has_expr_emit(reg: Registry, tag: int) -> bool {
    avra_intmap_has(reg.expr_emitters, tag) != 0
}

/// Invoke the registered expr-codegen handler. Caller must verify
/// `has_expr_emit` first — there's no fallback at this layer.
export fn dispatch_expr_emit(reg: Registry, tag: int, ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    let handler: fn(Ctx, List<VarBinding>, Expr) -> Result<EmitValue, string> = avra_intmap_get(reg.expr_emitters, tag)
    handler(ctx, env, expr)
}

/// True iff a feature has registered a stmt-codegen handler.
export fn has_stmt_emit(reg: Registry, tag: int) -> bool {
    avra_intmap_has(reg.stmt_emitters, tag) != 0
}

/// Invoke the registered stmt-codegen handler. Caller must verify
/// `has_stmt_emit` first.
export fn dispatch_stmt_emit(reg: Registry, tag: int, ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    let handler: fn(Ctx, List<VarBinding>, Stmt) -> Result<StmtResult, string> = avra_intmap_get(reg.stmt_emitters, tag)
    handler(ctx, env, stmt)
}

/// Invoke the resolver hook for `tag`, or null when none is
/// registered (resolver falls back to its built-in walker).
export fn dispatch_expr_resolve(reg: Registry, tag: int, r: Resolver, expr: Expr) -> Resolver? {
    if avra_intmap_has(reg.expr_resolvers, tag) == 0 { return null }
    let handler: fn(Resolver, Expr) -> Resolver = avra_intmap_get(reg.expr_resolvers, tag)
    handler(r, expr)
}

/// Invoke the typechecker expr hook, or null when not registered.
export fn dispatch_expr_check(reg: Registry, tag: int, tc: TC, expr: Expr) -> ExprResult? {
    if avra_intmap_has(reg.expr_checkers, tag) == 0 { return null }
    let handler: fn(TC, Expr) -> ExprResult = avra_intmap_get(reg.expr_checkers, tag)
    handler(tc, expr)
}

/// Invoke the resolver stmt hook, or null when not registered.
export fn dispatch_stmt_resolve(reg: Registry, tag: int, r: Resolver, stmt: Stmt) -> Resolver? {
    if avra_intmap_has(reg.stmt_resolvers, tag) == 0 { return null }
    let handler: fn(Resolver, Stmt) -> Resolver = avra_intmap_get(reg.stmt_resolvers, tag)
    handler(r, stmt)
}

/// Invoke the typechecker stmt hook, or null when not registered.
export fn dispatch_stmt_check(reg: Registry, tag: int, tc: TC, stmt: Stmt) -> TC? {
    if avra_intmap_has(reg.stmt_checkers, tag) == 0 { return null }
    let handler: fn(TC, Stmt) -> TC = avra_intmap_get(reg.stmt_checkers, tag)
    handler(tc, stmt)
}

/// Invoke the eval expr hook (tree-walking interpreter), or null.
export fn dispatch_expr_eval(reg: Registry, tag: int, rt: Runtime, expr: Expr) -> StepResult? {
    if avra_intmap_has(reg.expr_evals, tag) == 0 { return null }
    let handler: fn(Runtime, Expr) -> StepResult = avra_intmap_get(reg.expr_evals, tag)
    handler(rt, expr)
}

/// Invoke the eval stmt hook, or null.
export fn dispatch_stmt_eval(reg: Registry, tag: int, rt: Runtime, stmt: Stmt) -> StepResult? {
    if avra_intmap_has(reg.stmt_evals, tag) == 0 { return null }
    let handler: fn(Runtime, Stmt) -> StepResult = avra_intmap_get(reg.stmt_evals, tag)
    handler(rt, stmt)
}

/// Look up a decl parser by leading keyword (e.g. `"fn"`). Returns

/// True when `name` was declared as a component. This is the whole contract:
/// the executor's `comp_name_is_registered` predicate asks nothing else of it,
/// and the `bare_comp_inst` / `bare_comp_inst_raw` conds are its only
/// consumers.
///
/// It used to be `lookup_stmt_parser(...) -> int?`, storing a
/// `fn(Parser) -> Result<StmtId, string>` per name — but NOTHING ever
/// invoked the stored value (the generated parser handles instantiation
/// natively via `parse_bare_comp_inst`/`_raw`), and the sole consumer
/// tested `!= null`. So the map was a SET wearing a handler map's
/// signature, and the two closures that fed it were the only thing keeping
/// ~650 lines of retired hand parser alive to satisfy an argument nobody
/// read. Storing a function pointer as an untyped `int` was also the same
/// rule-16 defect as the old `Feature.emit_expr: int`.
export fn is_registered_component(reg: Registry, name: string) -> bool {
    avra_map_has_cstr(reg.component_names, name) != 0
}

/// True when `keyword` leads a registered `kw { … }` expression construct
/// (e.g. `grammar`). This is the whole contract — the executor's
/// `ident_lbrace_plain` / `ident_lbrace_feature` peek conditions ask nothing
/// else of it, and through them the generated parser decides whether `IDENT {`
/// opens a struct literal, a `grammar { … }` block or a `table { … }`.
///
/// It used to be `lookup_expr_parser(...) -> int?`, returning "the parse_expr
/// handler-fn-as-int" — and nothing ever retrieved it. The map's only read was
/// `avra_map_has_cstr` (presence); no consumer ever called `avra_map_get_cstr`
/// on it, so the stored handler could not run.
///
/// Note the value COULD have been called, contrary to what an earlier version
/// of this comment claimed: `dispatch_expr_emit` (below) does exactly that for
/// the emitter maps — `avra_intmap_get` returns an `int` which is bound to a
/// fn-typed local and invoked. That coercion is the language's ambient
/// int-as-fn-pointer convention, and it is why `Feature.emit_expr: int` still
/// works. So this was dead by DISUSE, not by impossibility.
///
/// The old doc also cited `parse_primary`, which t-47hc deleted.
export fn is_expr_keyword(reg: Registry, keyword: string) -> bool {
    avra_map_has_cstr(reg.expr_keywords, keyword) != 0
}

/// Register a component name for keyword-free instantiation. After
/// this, `name instance { ... }` at statement level is parsed as a
/// ComponentBlock — the component declaration's name acts as a
/// pseudo-keyword in the stmt parser.
export fn register_component_name(reg: Registry, name: string) {
    avra_map_set_cstr(reg.component_names, name, 1)
}

/// Mark `name` as a `body: TokenStream` component (vez6.9): its
/// instance blocks capture raw tokens instead of structured Avra.
export fn register_raw_body_component(reg: Registry, name: string) {
    avra_map_set_cstr(reg.raw_body_comps, name, 1)
}

/// True when `name` was declared with `body: TokenStream`.
export fn component_is_raw_body(reg: Registry, name: string) -> bool {
    avra_map_get_cstr(reg.raw_body_comps, name) != 0
}

// ── Build the registry ──

/// The parse registry for a program's shared NodeStore — built on first
/// use, then reused by every subsequent file parsed over the same store,
/// so parse-time component registration is program-wide, not per-file.
impl NodeStore {
    fn parse_features(self) -> Registry {
        if self.parse_registry == null {
            self.parse_registry = build_registry()
        }
        self.parse_registry!
    }
}

/// Construct + populate the Registry — EXPENSIVE: init_features re-runs
/// every LanguageFeature factory, and each definition's `grammar {}` block
/// re-parses into the program arena, which never frees. ONE registry per
/// program store is the contract (NodeStore.parse_features, lazy): every
/// pass shares it. Batch A measured the violation — four pass constructors
/// each built a FRESH registry, so every converted feature multiplied
/// arena growth across every pass construction (the #1232 regression
/// class); a 12GB+ F4014 on the GENPASS harness compile was the tell.
export fn build_registry() -> Registry {
    mut reg = registry_new()
    reg.builder_binds = init_features(reg)
    reg
}
