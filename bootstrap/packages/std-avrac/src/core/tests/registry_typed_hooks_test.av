// WHY: the compiler's emit hooks were declared `int` — FUNCTION POINTERS stored
// as untyped integers — which is the rule-16 defect the codebase bans ("untyped
// registries, i64 fallbacks — these are bugs, not features"). It survived
// because the language has an ambient int-as-fn-pointer coercion, so the wrong
// type WORKED and nothing surfaced it.
//
// The declaration has moved twice since, and this guard followed it rather than
// being deleted, because the INVARIANT never changed:
//   core/registry.av `Feature`      -> the original defect (#1308 typed it)
//   features/wiring.av `Feature`    -> t-y2i7.13 (core/ must not name codegen/
//                                     typeck/eval result types)
//   features/mod.av `LanguageFeature` -> P2d collapsed the two records; `Feature`
//                                     and `feature_new` are gone, and `register`
//                                     takes the LanguageFeature directly.
//
// A textual assertion is the honest instrument: the defect IS the declared type,
// and the type checker cannot fail a program for accepting a coercion it
// deliberately allows (cf. t-vt10 — it does not even reject a string in an
// enum-typed field).

use @std.avrac.core.{avra_selfhost_read_file}

fn hooks_src() -> string {
    avra_selfhost_read_file("packages/std-avrac/src/features/mod.av")
}

spec "the emit hooks are FUNCTION-typed, never untyped ints" {
    then "emit_expr declares a fn type" {
        hooks_src().contains("emit_expr: fn(Ctx, List<VarBinding>, Expr) -> Result<EmitValue, string>")
    }
    then "emit_stmt declares a fn type" {
        hooks_src().contains("emit_stmt: fn(Ctx, List<VarBinding>, Stmt) -> Result<StmtResult, string>")
    }
    then "neither is declared `int` — the exact regression" {
        // The DECLARATION form, not a bare substring: the surrounding prose
        // quotes `emit_expr: int` when explaining the history, and a substring
        // match reads the documentation as the defect. (That happened on the
        // first version of this guard.)
        !hooks_src().contains("\n        emit_expr: int")
            && !hooks_src().contains("\n        emit_stmt: int")
    }
    then "the declaration site still EXISTS — anti-vacuity" {
        // Without this, deleting or moving the record leaves the two
        // `!contains` arms passing on a file that no longer declares anything.
        // That is not hypothetical: it is exactly what happened when P2d
        // collapsed `Feature` away, and this arm is what caught it.
        hooks_src().contains("export component LanguageFeature") && hooks_src().length > 1000
    }
}
