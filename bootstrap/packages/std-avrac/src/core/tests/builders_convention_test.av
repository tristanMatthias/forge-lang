// WHY: t-y2i7.14. No feature passes its own builders any more — the generated
// `language_features()` wraps each `X_lang()` in `with_builders(X_lang(),
// X_builds())`, deriving the builds fn from the lang fn's OWN canonical path
// (features/regen.av `builds_path_for`).
//
// That derivation is only safe while the naming holds. Slice 1 guarded it by
// pairing each `builders = X_builds()` line against its `X_lang()`; slice 2
// DELETED those lines, so that guard's premise is gone — the same way P7's
// collapse invalidated kwid_lockstep_test.
//
// The invariant that matters now runs the other way: **no ORPHAN builds fn**.
// A `*_builds` that no `*_lang` derives to is never attached to anything, and
// nothing else complains — the feature simply registers with an empty manifest
// and its rules fail at parse time, far from the cause. A lang fn with NO
// builds fn is fine and expected (extern_decl relies on the `= []` default),
// which is why this is one-directional.
use @std.avrac.core.{avra_readdir, avra_selfhost_read_file}

fn features_root() -> string { "packages/std-avrac/src/features" }

/// `fn NAME(` declarations matching a suffix, from one file.
fn fn_names_with_suffix(path: string, suffix: string) -> List<string> {
    mut out: List<string> = []
    let src = avra_selfhost_read_file(path)
    if src == "" { return out }
    for line in src.split("\n") {
        let t = line.trim()
        mut rest = ""
        if t.starts_with("export fn ") { rest = t.substring(10, t.length) }
        else if t.starts_with("fn ") { rest = t.substring(3, t.length) }
        if rest == "" { continue }
        let paren = rest.index_of("(")
        if paren <= 0 { continue }
        let name = rest.substring(0, paren)
        if name.length > suffix.length &&
           name.substring(name.length - suffix.length, name.length) == suffix {
            if !out.contains(name) { out.push(name) }
        }
    }
    out
}

/// Every `*_builds` fn, paired with the feature directory that owns it.
/// Both layouts are real: nearly all live in `<dir>/lowering/mod.av`, but the
/// grammar engine keeps `grammar_block_builds` in `<dir>/mod.av`.
fn builds_by_dir() -> List<string> {
    mut out: List<string> = []
    for entry in avra_readdir(features_root()) {
        let base = features_root() + "/" + entry
        for n in fn_names_with_suffix(base + "/lowering/mod.av", "_builds") { out.push(entry + "|" + n) }
        for n in fn_names_with_suffix(base + "/mod.av", "_builds") { out.push(entry + "|" + n) }
    }
    out
}

/// `*_builds` fns with no `*_lang` in the same feature dir to derive them.
fn orphans() -> List<string> {
    mut out: List<string> = []
    for pair in builds_by_dir() {
        let bar = pair.index_of("|")
        let dir = pair.substring(0, bar)
        let builds = pair.substring(bar + 1, pair.length)
        let stem = builds.substring(0, builds.length - 7)   // drop "_builds"
        let langs = fn_names_with_suffix(features_root() + "/" + dir + "/mod.av", "_lang")
        if !langs.contains(stem + "_lang") { out.push(pair) }
    }
    out
}

spec "t-y2i7.14: every builders fn is reachable by derivation from a lang fn" {
    then "the scan finds the builds fns — anti-vacuity" {
        // 58 today across both layouts. A FLOOR: adding a feature must not fail
        // this, but a scan that stopped reading mod.av files must.
        builds_by_dir().length >= 55
    }

    then "no ORPHAN builds fn — each one has an X_lang in its own feature dir" {
        // An orphan is silently never attached: the generator derives from the
        // LANG side, so a builds fn nothing points at is dead weight and its
        // feature registers with an empty manifest.
        orphans().length == 0
    }

    then "the derivation's own shape holds for a known pair" {
        // grammar_block_lang -> grammar_block_builds, the FLAT layout, which is
        // the one that regressed during slice 2 and cost the most to diagnose.
        let langs = fn_names_with_suffix(features_root() + "/grammar/mod.av", "_lang")
        let builds = fn_names_with_suffix(features_root() + "/grammar/mod.av", "_builds")
        langs.contains("grammar_block_lang") && builds.contains("grammar_block_builds")
    }
}
