// ps3t.3.5 — content-hash primitive contract (spine §14.4, §15.2). The content
// fingerprint is STRUCTURAL: equal for structurally-identical subtrees, distinct
// for different structure, and INVARIANT under spans/positions (span-exclusion,
// the acceptance criterion "content hash excludes spans"). The interning that
// CONSUMES this hash is a later increment; here we pin the primitive's contract
// so that increment can rely on it. Distinct child ids with identical child
// CONTENT must still collapse to one hash — that is what makes interning dedup
// structurally-identical subtrees.

use @std.avrac.core.{NodeStore, new_node_store, build_line_index, Expr, Stmt, Pattern, NodeRef, ValueType,
                     byte_span, expr_content_hash, stmt_content_hash, pat_content_hash, type_content_hash}

fn ts() -> NodeStore { new_node_store(build_line_index("")) }

spec "content hash: structural, span-free (ps3t.3.5)" {
    then "identical leaf content with DIFFERENT spans hashes equal (span-exclusion)" {
        let store = ts()
        let a = store.add_expr(Expr.Number("5"), byte_span(0, 1), [])
        let b = store.add_expr(Expr.Number("5"), byte_span(100, 101), [])
        expr_content_hash(store, a) == expr_content_hash(store, b)
    }
    then "different literal content hashes differently" {
        let store = ts()
        let a = store.add_expr(Expr.Number("5"), byte_span(0, 1), [])
        let b = store.add_expr(Expr.Number("7"), byte_span(0, 1), [])
        expr_content_hash(store, a) != expr_content_hash(store, b)
    }
    then "structurally-identical NESTED subtrees with DISTINCT child ids hash equal" {
        let store = ts()
        // group(1) built twice from different rows + different spans — the whole
        // point of interning: same structure -> one hash, regardless of ids.
        let a1 = store.add_expr(Expr.Number("1"), byte_span(0, 1), [])
        let ga = store.add_expr(Expr.Grouping(a1), byte_span(0, 3), [NodeRef.ExprRef(a1)])
        let b1 = store.add_expr(Expr.Number("1"), byte_span(50, 51), [])
        let gb = store.add_expr(Expr.Grouping(b1), byte_span(50, 53), [NodeRef.ExprRef(b1)])
        expr_content_hash(store, ga) == expr_content_hash(store, gb)
    }
    then "nested subtrees differing in a leaf hash differently (group(1) vs group(2))" {
        let store = ts()
        let a1 = store.add_expr(Expr.Number("1"), byte_span(0, 1), [])
        let ga = store.add_expr(Expr.Grouping(a1), byte_span(0, 3), [NodeRef.ExprRef(a1)])
        let b1 = store.add_expr(Expr.Number("2"), byte_span(50, 51), [])
        let gb = store.add_expr(Expr.Grouping(b1), byte_span(50, 53), [NodeRef.ExprRef(b1)])
        expr_content_hash(store, ga) != expr_content_hash(store, gb)
    }
    // The statement arena hashes the same way — the primitive is symmetric.
    then "identical stmt content with DIFFERENT spans hashes equal (stmt path)" {
        let store = ts()
        let a = store.add_stmt(Stmt.Break, byte_span(0, 1), [])
        let b = store.add_stmt(Stmt.Break, byte_span(40, 41), [])
        stmt_content_hash(store, a) == stmt_content_hash(store, b)
    }
    then "different stmt content hashes differently (break vs continue)" {
        let store = ts()
        let a = store.add_stmt(Stmt.Break, byte_span(0, 1), [])
        let b = store.add_stmt(Stmt.Continue, byte_span(0, 1), [])
        stmt_content_hash(store, a) != stmt_content_hash(store, b)
    }
    // The pattern arena (populated by resolve/eval/parse) hashes the same way.
    then "identical pat content with DIFFERENT spans hashes equal (pat path)" {
        let store = ts()
        let a = store.add_pat(Pattern.LitInt(5), byte_span(0, 1), [])
        let b = store.add_pat(Pattern.LitInt(5), byte_span(60, 61), [])
        pat_content_hash(store, a) == pat_content_hash(store, b)
    }
    then "different pat content hashes differently (LitInt 5 vs 7)" {
        let store = ts()
        let a = store.add_pat(Pattern.LitInt(5), byte_span(0, 1), [])
        let b = store.add_pat(Pattern.LitInt(7), byte_span(0, 1), [])
        pat_content_hash(store, a) != pat_content_hash(store, b)
    }
    then "structurally-identical NESTED pats with DISTINCT child ids hash equal" {
        let store = ts()
        // (1 or 2) built twice from different rows + different spans.
        let a1 = store.add_pat(Pattern.LitInt(1), byte_span(0, 1), [])
        let a2 = store.add_pat(Pattern.LitInt(2), byte_span(5, 6), [])
        let oa = store.add_pat(Pattern.Or(a1, a2), byte_span(0, 6), [NodeRef.PatRef(a1), NodeRef.PatRef(a2)])
        let b1 = store.add_pat(Pattern.LitInt(1), byte_span(50, 51), [])
        let b2 = store.add_pat(Pattern.LitInt(2), byte_span(55, 56), [])
        let ob = store.add_pat(Pattern.Or(b1, b2), byte_span(50, 56), [NodeRef.PatRef(b1), NodeRef.PatRef(b2)])
        pat_content_hash(store, oa) == pat_content_hash(store, ob)
    }
    then "nested pats differing in a leaf hash differently ((1 or 2) vs (1 or 3))" {
        let store = ts()
        let a1 = store.add_pat(Pattern.LitInt(1), byte_span(0, 1), [])
        let a2 = store.add_pat(Pattern.LitInt(2), byte_span(5, 6), [])
        let oa = store.add_pat(Pattern.Or(a1, a2), byte_span(0, 6), [NodeRef.PatRef(a1), NodeRef.PatRef(a2)])
        let b1 = store.add_pat(Pattern.LitInt(1), byte_span(50, 51), [])
        let b2 = store.add_pat(Pattern.LitInt(3), byte_span(55, 56), [])
        let ob = store.add_pat(Pattern.Or(b1, b2), byte_span(50, 56), [NodeRef.PatRef(b1), NodeRef.PatRef(b2)])
        pat_content_hash(store, oa) != pat_content_hash(store, ob)
    }
    // Cross-kind: nodes from different arenas that render to the SAME string must
    // still hash apart (the arena discriminator). Without it, Expr.Number("5")
    // and Pattern.LitInt(5) both render "5" and would collide — a latent bug once
    // §15.3 unifies all ids into one content-addressed space.
    then "different node KINDS with identical render hash apart (Expr.Number 5 vs Pattern.LitInt 5)" {
        let store = ts()
        let e = store.add_expr(Expr.Number("5"), byte_span(0, 1), [])
        let p = store.add_pat(Pattern.LitInt(5), byte_span(0, 1), [])
        expr_content_hash(store, e) != pat_content_hash(store, p)
    }
    then "Expr.Ident(_) and Pattern.Wildcard both render \"_\" yet hash apart" {
        let store = ts()
        let e = store.add_expr(Expr.Ident("_"), byte_span(0, 1), [])
        let p = store.add_pat(Pattern.Wildcard, byte_span(0, 1), [])
        expr_content_hash(store, e) != pat_content_hash(store, p)
    }
}

// The TYPE arena (populated by the parser's glue_ingest_type) hashes the same
// way, via the fully-faithful `render_type_id` — the ps3t.4.3 addition.
spec "type content hash: structural, span-free, faithful, nominal-by-name (ps3t.4.3)" {
    then "identical type with DIFFERENT spans hashes equal (span-exclusion)" {
        let store = ts()
        let a = store.ingest_type(ValueType.List(ValueType.Int), byte_span(0, 3))
        let b = store.ingest_type(ValueType.List(ValueType.Int), byte_span(100, 103))
        type_content_hash(store, a) == type_content_hash(store, b)
    }
    then "different element type hashes differently (List<int> vs List<string>)" {
        let store = ts()
        let a = store.ingest_type(ValueType.List(ValueType.Int), byte_span(0, 3))
        let b = store.ingest_type(ValueType.List(ValueType.Str), byte_span(0, 3))
        type_content_hash(store, a) != type_content_hash(store, b)
    }
    then "Fn return type is FAITHFUL — Fn->int vs Fn->string hash apart (vtype_render_full collapses these)" {
        let store = ts()
        let a = store.ingest_type(ValueType.Fn(ValueType.Int), byte_span(0, 3))
        let b = store.ingest_type(ValueType.Fn(ValueType.Str), byte_span(0, 3))
        type_content_hash(store, a) != type_content_hash(store, b)
    }
    then "nominal identity is by NAME — Struct(Foo) hashes the same regardless of stamped id (cycle break)" {
        let store = ts()
        let no_args: List<ValueType> = []
        let a = store.ingest_type(ValueType.Struct("Foo", no_args, 0), byte_span(0, 3))
        let b = store.ingest_type(ValueType.Struct("Foo", no_args, 999), byte_span(0, 3))
        type_content_hash(store, a) == type_content_hash(store, b)
    }
    then "distinct nominal names hash apart (Struct Foo vs Struct Bar)" {
        let store = ts()
        let no_args: List<ValueType> = []
        let a = store.ingest_type(ValueType.Struct("Foo", no_args, 0), byte_span(0, 3))
        let b = store.ingest_type(ValueType.Struct("Bar", no_args, 0), byte_span(0, 3))
        type_content_hash(store, a) != type_content_hash(store, b)
    }
    then "cross-kind: ValueType.Int and Expr.Ident(\"int\") both render \"int\" yet hash apart (T: tag)" {
        let store = ts()
        let t = store.ingest_type(ValueType.Int, byte_span(0, 3))
        let e = store.add_expr(Expr.Ident("int"), byte_span(0, 3), [])
        type_content_hash(store, t) != expr_content_hash(store, e)
    }
}
