// WHY: integration spec for the L1 arena (ps3t.3.2 / spine §14.1, §14.6).
// The parser builds the NodeStore natively as it parses (B1) and
// parse_or_fail serves the program from it; AVRA_L1_INGEST=1 surfaces that
// store's diagnostics (row counts, root spans, reconstruct fidelity). We
// test the real wired path end-to-end (shelling out to bs2, the established
// pattern for compiler-behaviour specs) rather than a cross-package unit
// re-link. Flag-off changes only the output, so the diff-test stays
// byte-identical.
//
// Two acceptance facets are covered: (1) the store holds MORE nodes than
// top-level statements (proving nested stmts get their own arena rows, not
// just the top level); (2) the typed ids are nominally distinct — passing a
// StmtId where an ExprId is wanted is an F1000 type error ("type system
// rejects wrong-arena id use").

use @std.avrac.core.{avra_shell_exec, avra_selfhost_write_file}
use @std.avrac.core.{new_node_store, build_line_index, NodeRef, ExprId, PatId, Expr, Pattern, ValueType, BinOp}
use @std.avrac.core.{byte_span, byte_span_none, byte_span_is_none}
use @std.avrac.core.{Stmt, StmtId, TypeId, NodeStore}
use @std.avrac.core.{TypeParamEntry, ParamEntry, Annotation}
use @std.avrac.core.{expr_ref_id, stmt_ref_id, pat_ref_id, type_ref_id, noderef_tag}
use @std.avrac.core.{MatchArm, FieldInit, render_expr}

/// Fresh empty store for inline-AST probes — F2 renderers resolve
/// flipped pattern ids through it (never read for id-free nodes).
fn ts() -> NodeStore {
    new_node_store(build_line_index(""))
}

/// Allocate a positioned statement row — the id-native way to stamp a
/// body element with (line, col, file) that the parser records for real
/// source (replaces the retired rows_of([sstmt_at(...)]) bridge).
fn row_at(store: NodeStore, node: Stmt, line: int, col: int, file: string) -> StmtId {
    let id = store.stmts.add_leaf(node)
    store.set_stmt_pos(id, line, col, file)
    id
}


// The `NodeRef` peel helpers (`expr_ref_id` / `stmt_ref_id` / `pat_ref_id` /
// `type_ref_id`) and `noderef_tag` are now exported from core/arena.av; they are
// imported above and exercised by the specs below (and the whole suite).

/// Concatenated kind-tags of a stored edge list — proves the persisted
/// cross-type edges carry the right kinds in the right order.
fn edge_tags(refs: List<NodeRef>) -> string {
    mut out = ""
    for r in refs { out = out + noderef_tag(r) }
    out
}

fn l1_ingest_output() -> string {
    // 3 top-level fns, each with a one-statement body -> 6 stmt rows (3 fn
    // decls + 3 body stmts): nested statements get their own rows.
    let fixture = "build/_l1_arena_fixture.av"
    let _ = avra_selfhost_write_file(fixture, "fn a() -> int { 1 }\nfn b() -> int { 2 }\nfn c() -> int { 3 }\n")
    avra_shell_exec("AVRA_L1_INGEST=1 ./build/bs2 check ${fixture} 2>&1")
}

fn l1_mixup_output() -> string {
    // Misuse: pass a StmtId where an ExprId is expected. The arena's typed
    // ids are nominally distinct, so typeck must reject this (F1000).
    let fixture = "build/_l1_arena_mixup.av"
    let src = "use @std.avrac.core.{ExprId, StmtId}\n" +
        "fn want_expr(e: ExprId) -> int { e.raw() }\n" +
        "fn main() {\n" +
        "    let s = StmtId(0)\n" +
        "    let _ = want_expr(s)\n" +
        "}\n"
    let _ = avra_selfhost_write_file(fixture, src)
    avra_shell_exec("./build/bs2 check ${fixture} 2>&1")
}

spec "L1 arena ingest (wired)" {
    then "parse_or_fail's store carries a row for every stmt, nested included" {
        // 3 top-level fns, each with a one-statement body -> 6 stmt rows
        // (3 fn decls + 3 body stmts): nested statements get their own rows.
        l1_ingest_output().contains("[l1-ingest] NodeStore: 6 stmt nodes")
    }
    then "the last stmt carries a real byte-offset span; line/col recomputed from it" {
        // The last top-level statement (`fn c`) gets a REAL byte-offset span,
        // and its (line, col) is recomputed on demand from that span.
        let out = l1_ingest_output()
        out.contains("[l1-ingest] last stmt span [40,") && out.contains("line 3 col 1")
    }
    then "parse_or_fail serves the parser's native store, orphans included" {
        // The served store is the PARSER's own — orphan rows included — not a
        // re-ingest of a final tree. A let-else desugar leaves one orphaned
        // intermediate row, so a 3-stmt source holds 7 rows, not 6.
        let fixture = "build/_l1_arena_native_fixture.av"
        let _ = avra_selfhost_write_file(fixture, "fn f(o: int?) -> int {\n    let v = o else { return 0 }\n    v\n}\n")
        let out = avra_shell_exec("AVRA_L1_INGEST=1 ./build/bs2 check ${fixture} 2>&1")
        out.contains("[l1-ingest] NodeStore: 7 stmt nodes")
    }
}

spec "L1 typed ids reject wrong-arena use" {
    then "passing a StmtId where an ExprId is wanted is an F1000 type error" {
        let out = l1_mixup_output()
        out.contains("F1000") && out.contains("expects") && out.contains("ExprId")
    }
}

// All four node kinds get their own dense arena (acceptance: "Expr/Stmt/
// Pattern/ValueType each in its own dense arena"). Exercise Expr/Pattern/
// ValueType in-process here (same package, no cross-package re-link); the
// StmtArena is covered by the wired ingest spec above. Ingest is the
// cross-type, id-based `NodeStore.ingest_*` (A1): the count is the FULL
// flattened node total in that kind's arena, so a non-leaf tree yields more
// than one node — proof the all_children_spanned() recursion runs and edges are
// recorded. These trees are all-one-kind, so each lands wholly in its own
// arena (no cross-kind children to scatter).
spec "L1 ExprArena ingests recursively" {
    then "Grouping(id): the inner id is an inline scalar, not a recursed child edge" {
        let store = new_node_store(build_line_index(""))
        let inner = store.exprs.add_leaf(Expr.Number("5"))
        let root = store.ingest_expr(Expr.Grouping(inner), byte_span_none())
        // F3b: Grouping.expr is an arena ExprId — a scalar to the walker, so
        // ingest records NO child edge. The two rows are the leaf + the Grouping,
        // and the inline id survives the ingest verbatim.
        let kept = match store.exprs.get(root) { .Grouping(got) -> got == inner, _ -> false }
        store.exprs.count() == 2 && store.exprs.children_of(root).length == 0 && kept
    }
}

spec "L1 PatArena ingests id-payload patterns as leaves (F2)" {
    then "Or holds two pre-allocated rows; the ingest adds only the Or itself" {
        // Post-F2 the branches ARE ids — the payload is the child mechanism,
        // so the walker sees scalars and the ingest records no edges. Three
        // rows total: the two allocated branches plus the Or.
        let store = new_node_store(build_line_index(""))
        let l = store.pats.add_leaf(Pattern.Wildcard)
        let r = store.pats.add_leaf(Pattern.Wildcard)
        let root = store.ingest_pat(Pattern.Or(l, r), byte_span_none())
        store.pats.count() == 3 && store.pats.children_of(root).length == 0
    }
}

spec "L1 TypeArena ingests recursively" {
    then "List(Int) flattens to 2 type nodes" {
        let store = new_node_store(build_line_index(""))
        let root = store.ingest_type(ValueType.List(ValueType.Int), byte_span_none())
        store.types.count() == 2 && store.types.children_of(root).length == 1
    }
}

// Combinatorial, F3a form: the fn/if/let nesting now travels BY ID — the
// Function body, the If's cond/then, and the Let's initializer are all arena
// rows allocated up front in the SAME store the assertions read back from.
// ingest_stmt on the fn decl records only its one remaining boxed child (the
// ret ValueType); every flipped payload survives verbatim as a scalar, and
// resolving the ids step-by-step recovers the full nesting.
spec "ingest: combinatorial cross-kind nesting travels by id" {
    then "fn { if (1<2) { let xs: List<List<int>> = [] } } resolves level-by-level" {
        let no_tp: List<TypeParamEntry> = []
        let no_pp: List<ParamEntry> = []
        let no_el: List<ExprId> = []
        let store = ts()
        let cond = store.exprs.add_leaf(Expr.Binary(store.exprs.add_leaf(Expr.Number("1")), BinOp.Lt, store.exprs.add_leaf(Expr.Number("2"))))
        let init = store.exprs.add_leaf(Expr.ListLit(no_el))
        let inner_let = store.stmts.add_leaf(Stmt.Let("xs", ValueType.List(ValueType.List(ValueType.Int)), init))
        let if_id = store.stmts.add_leaf(Stmt.If(cond, inner_let, null))
        let body: List<StmtId> = [if_id]
        let root = store.ingest_stmt(Stmt.Function("f", no_tp, no_pp, ValueType.Void, body), byte_span_none())
        // The fn decl's only boxed child is its ret type; the body rides as ids.
        let fn_kids = store.stmts.children_of(root)
        let if_ok = match store.stmts.get(if_id) {
            .If(c, t, e) -> c == cond && t == inner_let && e == null
            _ -> false
        }
        let let_ok = match store.stmts.get(inner_let) {
            .Let(_, _, got) -> got == init
            _ -> false
        }
        let body_ok = match store.stmts.get(root) {
            .Function(_, _, _, _, got_body) -> got_body.length == 1 && got_body[0] == if_id
            _ -> false
        }
        edge_tags(fn_kids) == "T" && if_ok && let_ok && body_ok
    }
}

// Field-order fidelity for the ONE AST variant where a node-list field precedes
// a node-single field: ValueType.FnTyped(params: List<ValueType>, ret: ValueType).
// all_children_spanned must yield params THEN ret (field order) — a singles-first fold
// would emit ret first. `fn(int, str) -> bool` ingests with children [int, str,
// bool]: first child is a param (Int), last is the return (Bool).
spec "ingest: FnTyped children keep field order (params before ret)" {
    then "fn(int,str)->bool ingests to [int, str, bool], not ret-first" {
        let store = new_node_store(build_line_index(""))
        let params: List<ValueType> = [ValueType.Int, ValueType.Str]
        let root = store.ingest_type(ValueType.FnTyped(params, ValueType.Bool), byte_span_none())
        let kids = store.types.children_of(root)
        let first_is_param = match store.types.get(type_ref_id(kids[0])) { .Int -> true  _ -> false }
        let second_is_param = match store.types.get(type_ref_id(kids[1])) { .Str -> true  _ -> false }
        let last_is_ret = match store.types.get(type_ref_id(kids[2])) { .Bool -> true  _ -> false }
        // Assert all three positions so a [int, <wrong>, bool] mis-order can't pass.
        kids.length == 3 && first_is_param && second_is_param && last_is_ret
    }
}

// The byte-offset SPAN side-table: a node ingested with a real span reports
// it back via span_of (a side-table lookup, not a field on the node). A
// flipped id payload (F3b) is a scalar — ingest doesn't recurse into it — so
// the inline child keeps whatever span it was allocated with (add_leaf ⇒ none).
spec "L1 ExprArena records the node's span" {
    then "the ingested root keeps its span; the inline id payload is left untouched" {
        // Grouping.expr is an arena ExprId (F3b): a scalar to the walker, so
        // ingest records no child edge and never re-spans the inline id.
        let store = new_node_store(build_line_index(""))
        let inner = store.exprs.add_leaf(Expr.Number("5"))
        let root = store.ingest_expr(Expr.Grouping(inner), byte_span(10, 13))
        let rs = store.exprs.span_of(root)
        rs.lo == 10 && rs.hi == 13 && store.exprs.children_of(root).length == 0
            && byte_span_is_none(store.exprs.span_of(inner))
    }
}

// The exported NodeRef accessors + per-kind linecol accessors (y5um B2 inc 2) —
// the read primitives a pass migrated to `children_of` needs: peel an edge to
// its typed id, and recover a node's (line, col) from its arena span.
spec "y5um.2: NodeRef unwrap helpers peel each edge kind" {
    then "noderef_tag maps each variant to its kind letter" {
        noderef_tag(NodeRef.ExprRef(ExprId(0))) == "E"
            && noderef_tag(NodeRef.StmtRef(StmtId(0))) == "S"
            && noderef_tag(NodeRef.PatRef(PatId(0))) == "P"
            && noderef_tag(NodeRef.TypeRef(TypeId(0))) == "T"
    }
    then "each *_ref_id peels its own kind to the underlying id" {
        expr_ref_id(NodeRef.ExprRef(ExprId(3))) == ExprId(3)
            && stmt_ref_id(NodeRef.StmtRef(StmtId(4))) == StmtId(4)
            && pat_ref_id(NodeRef.PatRef(PatId(5))) == PatId(5)
            && type_ref_id(NodeRef.TypeRef(TypeId(6))) == TypeId(6)
    }
}

spec "y5um.2: per-kind linecol accessors recompute (line, col) from the span" {
    then "expr/pat/type_linecol lift a real span; a none-span maps to (0, 0)" {
        // line_starts for "aaaa\nbbbb\n" = [0, 5]; offset 5 = line 2, col 1.
        let store = new_node_store(build_line_index("aaaa\nbbbb\n"))
        let eid = store.ingest_expr(Expr.Number("5"), byte_span(5, 6))
        let pid = store.ingest_pat(Pattern.Wildcard, byte_span(5, 6))
        let tid = store.ingest_type(ValueType.Int, byte_span(5, 6))
        let none_eid = store.ingest_expr(Expr.Number("7"), byte_span_none())
        store.expr_linecol(eid).line == 2 && store.expr_linecol(eid).col == 1
            && store.pat_linecol(pid).line == 2 && store.pat_linecol(pid).col == 1
            && store.type_linecol(tid).line == 2 && store.type_linecol(tid).col == 1
            && store.expr_linecol(none_eid).line == 0 && store.expr_linecol(none_eid).col == 0
    }
}

// Speculative-parse rollback (B1): mark() snapshots the four arenas' row
// counts; truncate_to_mark() rolls them back so a backtracked parse leaves no
// rows. Nodes and their parallel id-keyed columns (edges, spans) truncate
// together — a stale span/edge for a re-issued id would corrupt later reads.
spec "B1: StoreMark truncation rolls back speculative allocation" {
    then "truncate_to_mark drops rows allocated after the mark, across kinds" {
        let store = new_node_store(build_line_index(""))
        let keep = store.ingest_expr(Expr.Number("1"), byte_span(0, 1))
        let m = store.mark()
        let _ = store.ingest_expr(Expr.Grouping(store.exprs.add_leaf(Expr.Number("2"))), byte_span(2, 3))
        let _ = store.ingest_pat(Pattern.Wildcard, byte_span_none())
        let _ = store.ingest_type(ValueType.Int, byte_span_none())
        store.truncate_to_mark(m)
        store.exprs.count() == 1 && store.pats.count() == 0 && store.types.count() == 0
            && render_expr(store, store.exprs.get(keep)) == render_expr(store, Expr.Number("1"))
    }
    then "a re-issued id after truncation gets fresh edges and span (no stale columns)" {
        let store = new_node_store(build_line_index(""))
        let m = store.mark()
        // Allocate a parent (an inline-id leaf) with a real span, then roll back.
        let _ = store.ingest_expr(Expr.Grouping(store.exprs.add_leaf(Expr.Number("9"))), byte_span(5, 9))
        store.truncate_to_mark(m)
        // The same raw ids are re-issued for a childless node with span_none.
        let fresh = store.ingest_expr(Expr.Ident("x"), byte_span_none())
        store.exprs.children_of(fresh).length == 0
            && byte_span_is_none(store.exprs.span_of(fresh))
    }
}

// ── A2: real spans for WRAPPED nested nodes (spine §14.2) ──
//
// Before A2 every nested node ingested with byte_span_none() because the
// cross-type walker dropped the SExpr/SStmt wrappers' positions. Now the span-
// aware `all_children_spanned()` carries each wrapper's (line, col), which
// `child_span` lifts into a real (zero-width) byte-offset span. These specs
// pin: a single-wrapper child, a wrapper-LIST child, the bare-vs-wrapped split
// within one node, and the end-to-end path through `ingest_stmt`.

spec "F3a: a flipped Block body row carries its position column" {
    then "row_at records (line, col, file); stmt_pos reads it back; no child edge" {
        // The SStmt wrapper died with the flip — a Block body element's
        // position now lives in the StmtArena's dense pos column, stamped
        // by `row_at` or the parser. The ingest treats
        // the id payload as a scalar, so the Block records no stmt edge.
        let store = new_node_store(build_line_index("aaaa\nbbbb\ncccc\n"))
        let body = [row_at(store, Stmt.Break, 2, 3, "f.av")]
        let root = store.ingest_stmt(Stmt.Block(body), byte_span(0, 4))
        let p = store.stmt_pos(body[0])
        store.stmts.children_of(root).length == 0
            && p.line == 2 && p.col == 3 && p.file == "f.av"
    }
}

spec "F3a: Annotated.inner (a StmtId payload) keeps its recorded position" {
    then "the inner row's pos column survives the wrapping ingest; no stmt edge" {
        let store = new_node_store(build_line_index("a\nb\nc\n"))
        let no_ann: List<Annotation> = []
        let inner = [row_at(store, Stmt.Break, 3, 1, "")]
        let root = store.ingest_stmt(Stmt.Annotated(no_ann, inner[0]), byte_span(0, 1))
        store.stmts.children_of(root).length == 0
            && store.stmt_pos(inner[0]).line == 3
            && store.stmt_pos(inner[0]).col == 1
    }
}

spec "A2: bare children stay span_none while the wrapped node gets a real span" {
    then "MatchExpr walks its bare arm pattern (span_none); its bare-added opaque body is span_none; the wrapped root keeps its span" {
        // B-final F4b: MatchExpr walks ONLY the arm's BARE pattern (span_none) —
        // guard/body/subject are walker-opaque ids. A body added bare (add_leaf,
        // no span) stays span_none in its own row, while the wrapped MatchExpr
        // root records its real ingest span. Bareness holds across BOTH a walked
        // child (the pattern) and an opaque id (the body); F3a below pins the
        // complement — an opaque body carrying a real span keeps it.
        let store = new_node_store(build_line_index("f(x)\n"))
        let body_id = store.exprs.add_leaf(Expr.Ident("x"))
        let arm = MatchArm { pattern: Pattern.Wildcard, guard_id: null, body_id }
        let arms: List<MatchArm> = [arm]
        let subj = store.exprs.add_leaf(Expr.Ident("f"))
        let root = store.ingest_expr(Expr.MatchExpr(subj, arms), byte_span(0, 4))
        let kids = store.exprs.children_of(root)
        kids.length == 1
            && byte_span_is_none(store.pats.span_of(pat_ref_id(kids[0])))
            && byte_span_is_none(store.exprs.span_of(body_id))
            && !byte_span_is_none(store.exprs.span_of(root))
            && store.exprs.span_of(root).lo == 0
    }
}

spec "F3a: a body row at line 1 col 1 is a REAL position, not the absent sentinel" {
    then "(1,1) stays distinguishable from the no-position (0,0) sentinel" {
        // stmt_pos treats line 0 as "no recorded position" (falls back to the
        // span table) — this pins that a legitimate line-1-col-1 element is
        // not mistaken for an unstamped row.
        let store = new_node_store(build_line_index("break\n"))
        let body = [row_at(store, Stmt.Break, 1, 1, "")]
        let p = store.stmt_pos(body[0])
        p.line == 1 && p.col == 1
    }
}

spec "F3a: positions and spans compose across the id boundary" {
    then "the body row keeps its pos; the MatchExpr arm body behind the expr id keeps its wrapper span" {
        // line_starts for "aaaa\nbbbb\ncccc\n" = [0, 5, 10].
        // Stmt side: the Block body element's (2,1) rides the pos column.
        // Expr side: B-final F4b makes the arm body a walker-opaque ExprId — it
        // rides its OWN arena row, ingested with a real span (offset_of(3,2) =
        // line_start[2]=10 + 1 = 11). Resolving that id recovers the span across
        // the id boundary, even though the MatchExpr walk only sees the pattern.
        let store = new_node_store(build_line_index("aaaa\nbbbb\ncccc\n"))
        let body_id = store.ingest_expr(Expr.Ident("x"), byte_span(11, 12))
        let arm = MatchArm { pattern: Pattern.Wildcard, guard_id: null, body_id }
        let arms: List<MatchArm> = [arm]
        let subj = store.exprs.add_leaf(Expr.Ident("g"))
        let match_id = store.ingest_expr(Expr.MatchExpr(subj, arms), byte_span_none())
        let stmt_body = [row_at(store, Stmt.Expr(match_id), 2, 1, "")]
        let root = store.ingest_stmt(Stmt.Block(stmt_body), byte_span(0, 4))
        store.stmts.children_of(root).length == 0
            && store.stmt_pos(stmt_body[0]).line == 2
            && store.exprs.span_of(body_id).lo == 11
    }
}

spec "F3a: a fn body row's position is its own, distinct from the fn root's" {
    then "the body break keeps (2,3) in the pos column; the fn's only edge is its ret type" {
        let store = new_node_store(build_line_index("fn f() {\n  break\n}\n"))
        let body = [row_at(store, Stmt.Break, 2, 3, "")]
        let no_tp: List<TypeParamEntry> = []
        let no_pp: List<ParamEntry> = []
        let root = store.ingest_stmt(Stmt.Function("f", no_tp, no_pp, ValueType.Void, body), byte_span(0, 18))
        edge_tags(store.stmts.children_of(root)) == "T"
            && store.stmt_pos(body[0]).line == 2
            && store.stmt_pos(body[0]).col == 3
    }
}

// ps3t.3.7.1 regression: `quote arm { p -> e }` parses to a synthetic
// `Expr.MatchExpr(<subject id>, [arm])`. B-final flipped `MatchExpr.subject` to an
// ExprId, so the parser allocates a real leaf `Expr.None` row for it (walker-opaque)
// and the node is well-formed. Historically the subject was a bare `Expr` and a
// stored `sexpr(...)` WRAPPER there made ingest's `all_children_spanned` trap
// ("unmatched tag <heap ptr>") — the id payload closes that hole. Guard the path.
spec "ps3t.3.7.1: ingest walks a quote-arm synthetic MatchExpr without trapping" {
    then "AVRA_L1_INGEST on a quote-arm program builds its arena and never traps" {
        let fixture = "/tmp/avra_l1_quote_arm_regress.av"
        let _ = avra_selfhost_write_file(fixture,
            "use @std.avrac.core.{MatchArm}\n" +
            "@comptime\n" +
            "fn ma() -> List<MatchArm> { [quote arm { 1 -> 100 }] }\n" +
            "fn main() {}\n")
        let out = avra_shell_exec("AVRA_L1_INGEST=1 ./build/bs2 check ${fixture} 2>&1")
        out.contains("[l1-ingest] NodeStore:") && !out.contains("unmatched tag")
    }
}

// The arena's `arg_tys` side-table carries a flipped `Call` arg's inferred type
// once the payload is a bare `ExprId` (annotate writes it, the mono path reads
// it back via arg_ty_of). An id with no recorded type reads Unknown.
spec "F3b: arg_tys round-trips an inferred type via arg_ty_of" {
    then "a set arg type is recovered; an unset id reads Unknown" {
        let store = new_node_store(build_line_index(""))
        let id = store.exprs.add_leaf(Expr.Number("7"))
        store.set_arg_ty(id, ValueType.Int)
        let unset = store.exprs.add_leaf(Expr.Number("9"))
        let stored_int = match store.arg_ty_of(id) { .Int -> true  _ -> false }
        let unset_unknown = match store.arg_ty_of(unset) { .Unknown -> true  _ -> false }
        stored_int && unset_unknown
    }
}
