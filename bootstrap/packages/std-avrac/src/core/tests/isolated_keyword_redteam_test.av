// nce6.D red-team: hostile tests for `isolated { body }`.
// Crash modes (SIGSEGV / SIGABRT / div-by-zero / OOM-ish / stack
// overflow / non-zero exit), payload edge cases (empty / single
// byte / 1MB+ / null-terminated / non-UTF8), nested isolated,
// recursion, capture aliasing, interleaving with spawn, error
// propagation. Anything that should be safe but might not be.

extern fn avra_bytes_from_string(s: string) -> bytes
extern fn avra_string_from_bytes(b: bytes) -> string
extern fn avra_bytes_slice(b: bytes, start: int, end: int) -> bytes
extern fn avra_bytes_to_int_le(b: bytes, offset: int) -> int
extern fn avra_int_to_bytes_le(n: int) -> bytes
extern fn avra_bytes_concat(a: bytes, b: bytes) -> bytes
extern fn avra_bytes_empty() -> bytes
extern fn abort() -> int

const STATUS_OK: int = 0
const STATUS_CRASH: int = 1
const HEADER: int = 16

fn frame_status(raw: bytes) -> int {
    if raw.length < HEADER { return -1 }
    avra_bytes_to_int_le(raw, 0)
}

fn frame_len(raw: bytes) -> int {
    if raw.length < HEADER { return -1 }
    avra_bytes_to_int_le(raw, 8)
}

fn frame_payload(raw: bytes) -> bytes {
    if raw.length < HEADER { return avra_bytes_empty() }
    let len = frame_len(raw)
    if len == 0 { return avra_bytes_empty() }
    avra_bytes_slice(raw, HEADER, HEADER + len)
}

fn frame_string(raw: bytes) -> string {
    avra_string_from_bytes(frame_payload(raw))
}

// Synthesise N bytes of 0x41 without runaway string interpolation.
fn make_blob(n: int) -> bytes {
    mut b = avra_bytes_empty()
    mut i = 0
    while i < n {
        b = avra_bytes_concat(b, avra_bytes_from_string("A"))
        i = i + 1
    }
    b
}

spec "isolated red-team: crash variants" {
    then "abort() in body → status=CRASH" {
        let payload = isolated {
            abort()
            avra_bytes_empty()
        }
        frame_status(payload) == STATUS_CRASH
    }
    then "null-deref crash → status=CRASH" {
        // Force a SEGV-class fault. avra_bytes_to_int_le with a
        // bogus offset reads valid memory (bounded), so we use
        // an explicit divide-by-zero via int arithmetic.
        let payload = isolated {
            mut x = 0
            // Compiler is allowed to optimise away pure / 0, so
            // funnel through a never-true conditional that the
            // compiler can't constant-fold.
            if x > 0 { x = x / x }
            abort()  // belt-and-braces
            avra_bytes_empty()
        }
        frame_status(payload) == STATUS_CRASH
    }
    then "every iteration of a crash-recovery loop reports CRASH" {
        mut crash_count = 0
        mut i = 0
        while i < 5 {
            let payload = isolated {
                abort()
                avra_bytes_empty()
            }
            if frame_status(payload) == STATUS_CRASH { crash_count = crash_count + 1 }
            i = i + 1
        }
        crash_count == 5
    }
    then "parent ALIVE after 10 sequential crashes" {
        mut i = 0
        while i < 10 {
            let _ = isolated {
                abort()
                avra_bytes_empty()
            }
            i = i + 1
        }
        // If parent died, this assertion never runs.
        let payload = isolated { avra_bytes_from_string("survived") }
        frame_string(payload) == "survived"
    }
}

spec "isolated red-team: payload edge cases" {
    then "empty payload is OK status with len=0" {
        let payload = isolated { avra_bytes_empty() }
        frame_status(payload) == STATUS_OK && frame_len(payload) == 0
    }
    then "single-byte payload survives the pipe" {
        let payload = isolated { avra_bytes_from_string("X") }
        frame_string(payload) == "X"
    }
    then "100 KB payload round-trips intact" {
        let payload = isolated { make_blob(100 * 1024) }
        // This spec intermittently fails in the bundled suite under memory
        // pressure (the child dies, never a pipe defect — the runtime IO is
        // short-read/EINTR-robust). The boolean alone can't distinguish a
        // CRASH frame from a truncated payload, so print the frame's actual
        // status + length on failure to pin the mechanism at the site.
        if frame_status(payload) != STATUS_OK || frame_len(payload) != 100 * 1024 {
            println("100KB round-trip failed: status=${string(frame_status(payload))} len=${string(frame_len(payload))} (expected status=0 len=${string(100 * 1024)})")
        }
        frame_status(payload) == STATUS_OK && frame_len(payload) == 100 * 1024
    }
    then "embedded NUL bytes survive (bytes layout is len-prefixed)" {
        let with_nul = avra_bytes_concat(
            avra_bytes_concat(avra_bytes_from_string("a"), avra_int_to_bytes_le(0)),
            avra_bytes_from_string("b")
        )
        let payload = isolated { with_nul }
        // 1 + 8 + 1 = 10 bytes
        frame_len(payload) == 10
    }
    then "marshaled i64 survives the pipe at canonical offset 0" {
        let payload = isolated { avra_int_to_bytes_le(0x0BADBEEF) }
        let inner = frame_payload(payload)
        avra_bytes_to_int_le(inner, 0) == 0x0BADBEEF
    }
    then "child returning a NEGATIVE int via marshal round-trips" {
        let payload = isolated { avra_int_to_bytes_le(0 - 42) }
        avra_bytes_to_int_le(frame_payload(payload), 0) == 0 - 42
    }
}

spec "isolated red-team: capture shapes" {
    then "captures by value: int" {
        let x = 7
        let payload = isolated {
            avra_int_to_bytes_le(x * x)
        }
        avra_bytes_to_int_le(frame_payload(payload), 0) == 49
    }
    then "captures by value: string" {
        let s = "captured"
        let payload = isolated { avra_bytes_from_string("${s} ok") }
        frame_string(payload) == "captured ok"
    }
    then "captures by value: list" {
        let xs = [10, 20, 30]
        let payload = isolated { avra_int_to_bytes_le(xs.length + xs[0]) }
        avra_bytes_to_int_le(frame_payload(payload), 0) == 13
    }
    then "captures don't leak — parent's mut not seen by child" {
        mut counter = 0
        let _ = isolated {
            // Child mutating its own COW copy doesn't affect parent.
            // Confirming this also confirms fork isolation works:
            // if the parent's `counter` was being clobbered, the
            // next-line assertion would fail.
            avra_int_to_bytes_le(counter + 100)
        }
        // Parent's counter must be unchanged.
        counter == 0
    }
    then "two sequential isolated blocks see independent state" {
        let payload_a = isolated { avra_bytes_from_string("a") }
        let payload_b = isolated { avra_bytes_from_string("b") }
        frame_string(payload_a) == "a" && frame_string(payload_b) == "b"
    }
}

spec "isolated red-team: interleaving with spawn + nesting" {
    then "spawn outside, isolated inside — both succeed" {
        let task = spawn {
            let payload = isolated { avra_bytes_from_string("nested") }
            if frame_string(payload) == "nested" { 1 } else { 0 }
        }
        task.await == 1
    }
    then "isolated outside, spawn inside the child — pthread joins inside the fork" {
        let payload = isolated {
            let task = spawn { 42 }
            avra_int_to_bytes_le(task.await)
        }
        avra_bytes_to_int_le(frame_payload(payload), 0) == 42
    }
    then "nested isolated — outer succeeds even if inner crashes" {
        let payload = isolated {
            let inner = isolated {
                abort()
                avra_bytes_empty()
            }
            // Outer body returns the inner's framed payload as-is;
            // an inner crash is just bytes the outer ships back.
            inner
        }
        // Outer wraps the inner-framed payload as ITS payload.
        // So unwrap once to get the inner frame, then check it
        // reports a crash.
        let outer_inner = frame_payload(payload)
        avra_bytes_to_int_le(outer_inner, 0) == STATUS_CRASH
    }
}

spec "isolated red-team: control-flow" {
    then "early return from body's lambda preserved" {
        let payload = isolated {
            if true {
                avra_bytes_from_string("short-circuit")
            } else {
                avra_bytes_from_string("unreachable")
            }
        }
        frame_string(payload) == "short-circuit"
    }
    then "loop body returns N-byte payload" {
        let payload = isolated {
            mut b = avra_bytes_empty()
            mut i = 0
            while i < 10 {
                b = avra_bytes_concat(b, avra_bytes_from_string("x"))
                i = i + 1
            }
            b
        }
        frame_len(payload) == 10
    }
    then "match expression in body" {
        let mode = 2
        let payload = isolated {
            let label = match mode {
                1 -> "one"
                2 -> "two"
                3 -> "three"
                _ -> "other"
            }
            avra_bytes_from_string(label)
        }
        frame_string(payload) == "two"
    }
}
