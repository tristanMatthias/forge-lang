// WHY: t-y2i7.7. `KwId` only earns its keep if it cannot DRIFT from the keyword
// set it mirrors.
//
// Phase A added `KwId` alongside the 48 `Tk.Kw*` variants and this guard pinned
// the two against each other. Phase B REMOVED those variants — `Tk.Keyword(id:
// KwId)` is now the only spelling — so the pairing this file used to assert no
// longer exists. The invariant survives the collapse by re-anchoring on the two
// places a keyword still lives: the `KwId` declaration and the `keyword_rules()`
// row that maps a spelling onto it. Adding one without the other must FAIL.
//
//   - every `keyword_rules()` target is a declared `KwId`
//   - every declared `KwId` is a `keyword_rules()` target (no orphans either way)
//   - `kwid_keyword_str` is TOTAL over `KwId` (bar `Reserved`, which covers the
//     12 reserved-future spellings and so has no single one of its own)
//   - `kwid_name` is injective and still renders the LEGACY spelling
//
// Deliberately source-derived: a hand-copied list of 48 names would itself be a
// place to drift, which is the defect this ticket exists to remove.
use @std.avrac.core.{KwId, kwid_name, kwid_keyword_str}

extern fn avra_selfhost_read_file(path: string) -> string

fn ast_src() -> string { avra_selfhost_read_file("packages/std-avrac/src/core/ast.av") }
fn table_src() -> string { avra_selfhost_read_file("packages/std-avrac/src/parse/token_table.av") }

/// Text between `open` and the next `close`, for every occurrence in `src`.
/// Every needle below is runtime-built, which is why `List<string>.contains` is
/// load-bearing here: it compared by IDENTITY until t-xpi0 (#1333) taught it
/// value equality, and before that fix this extractor reported 59 names where 48
/// are distinct — a guard failing for a reason unrelated to its invariant.
fn between_all(src: string, open: string, close: string) -> List<string> {
    mut out: List<string> = []
    for line in src.split("\n") {
        let at = line.index_of(open)
        if at < 0 { continue }
        let rest = line.substring(at + open.length, line.length)
        let cut = rest.index_of(close)
        if cut <= 0 { continue }
        let name = rest.substring(0, cut)
        if name != "" && !out.contains(name) { out.push(name) }
    }
    out
}

/// The ids `keyword_rules()` maps spellings onto. The needle carries NO row-syntax
/// prefix on purpose: it used to be `"tk: Tk.Keyword(KwId."`, which read the rows
/// only while they were struct literals, and went silently vacuous the moment they
/// became `table` cells (`"and" | Tk.Keyword(KwId.And)`). token_table.av mentions
/// `Tk.Keyword` nowhere but in its rows, so matching the constructor alone is both
/// sufficient and immune to the next reformatting.
fn table_kw_ids() -> List<string> { between_all(table_src(), "Tk.Keyword(KwId.", ")") }

/// The arms `kwid_keyword_str` actually covers: `.X -> "kw_x"`.
fn kwid_str_arms() -> List<string> { between_all(ast_src(), "        .", " -> \"kw_") }

/// The ids `KwId` declares, read from the enum body — NOT a copied list.
fn kwid_names() -> List<string> {
    mut out: List<string> = []
    mut inside = false
    for line in ast_src().split("\n") {
        let t = line.trim()
        if t == "export enum KwId {" { inside = true continue }
        if inside && t == "}" { break }
        if inside && t != "" && !t.starts_with("//") {
            for part in t.split(",") {
                let n = part.trim()
                if n != "" && !out.contains(n) { out.push(n) }
            }
        }
    }
    out
}

spec "t-y2i7.7: KwId stays in lockstep with the keyword set it mirrors" {
    then "the sources are non-empty — anti-vacuity" {
        // Without this every set-comparison below passes on two empty lists,
        // which is exactly how a lockstep guard rots into a no-op. It is also
        // what caught the Phase B collapse: the old extractor read `Tk.Kw*`
        // arms that no longer exist and this arm went red rather than silently
        // comparing nothing.
        kwid_names().length > 40 && table_kw_ids().length > 40
    }

    then "every keyword_rules() target is a declared KwId" {
        mut ok = true
        let declared = kwid_names()
        for n in table_kw_ids() { if !declared.contains(n) { ok = false } }
        ok
    }

    then "every declared KwId is a keyword_rules() target — no orphans" {
        // The other direction: population equality alone would tolerate one
        // added and one removed, and a one-way check would let a KwId with no
        // spelling sit unnoticed forever.
        mut ok = true
        let targets = table_kw_ids()
        for n in kwid_names() { if !targets.contains(n) { ok = false } }
        ok
    }

    then "kwid_keyword_str is total over KwId, bar Reserved" {
        // Reserved covers the 12 reserved-future spellings, so it has no single
        // one of its own and is the ONE deliberate omission. Asserted from the
        // arms in source, so a dropped arm fails here rather than returning "".
        mut missing = 0
        let arms = kwid_str_arms()
        for n in kwid_names() { if n != "Reserved" && !arms.contains(n) { missing = missing + 1 } }
        missing == 0 && !arms.contains("Reserved")
    }

    then "kwid_name is injective — no two ids share a rendering" {
        // A duplicated arm would make two keywords indistinguishable in the
        // token oracle while still compiling.
        let a = kwid_name(KwId.Defer)
        let b = kwid_name(KwId.Return)
        let c = kwid_name(KwId.Reserved)
        a != b && b != c && a != c
    }

    then "kwid_name still renders the LEGACY Tk.Kw* spelling, so lex_dump is unchanged" {
        // The variants are gone but the token-stream oracle must not move:
        // lex_dump characterises output, and renaming its labels would show up
        // as a diff in every characterisation test for no semantic reason.
        kwid_name(KwId.Defer) == "KwDefer" && kwid_name(KwId.Fn) == "KwFn"
    }

    then "kwid_keyword_str answers the kind-string, not the spelling" {
        kwid_keyword_str(KwId.Defer) == "kw_defer" && kwid_keyword_str(KwId.Fn) == "kw_fn"
    }
}
