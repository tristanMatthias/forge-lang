// WHY: core/ is the BOTTOM layer — every other layer imports it, so nothing
// under core/ may import UPWARD. CLAUDE.md states the rule ("Never put
// feature-specific code in core/") and nothing enforced it, which is how
// core/registry.av accumulated SEVEN live upward imports — into codegen/,
// typeck/ AND features/ — without anyone noticing. A dependency spelled
// `use features.eval.{value_null}` simply did not read as a layer claim.
//
// Built BEFORE the fix on purpose, the way --check-feature-layout was (P4a):
// the ALLOWLIST is the measurement, and it must shrink. Two files are on it
// today (registry.av, ast.av), each naming t-y2i7.13 as its owner.
//
// Worth knowing before "fixing" either:
//   - registry.av's dependency is CIRCULAR — typeck/ and codegen/ import
//     core.{Registry, dispatch_*} while registry.av imports typeck/codegen.
//     Moving the file RENAMES the participant; it does not remove the cycle.
//     Breaking it needs each pass to own its dispatch table.
//   - ast.av's `use features.walker.{derive_walker}` LOOKS unused (the import
//     plus three comments) and is LOAD-BEARING via four `@expand(derive_walker)`
//     sites. Deleting it breaks AST walker generation.
//
// Mirrors features/grammar/tests/feature_layout_lint_test.av: drive the real
// script, assert it passes as the tree stands, and assert it FAILS when the
// invariant breaks — the anti-vacuity half, without which a lint that always
// returned 0 would look identical to one that works.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int

spec "the core-layering lint is real" {
    then "it passes on the tree as it stands" {
        avra_shell_exec_status("bash scripts/diagnose.sh --check-core-layering >/dev/null 2>&1") == 0
    }
    then "a NEW upward import makes it FAIL — the anti-vacuity half" {
        // fingerprint.av is core and is NOT allowlisted, so an upward import
        // there must be caught.
        //
        // t-frix: this plants into a THROWAWAY COPY via --root, never into the
        // tracked tree. It used to overwrite the real core/fingerprint.av in
        // place and `mv` it back. The suite runs shards IN PARALLEL, so for that
        // window every other shard compiling core/ saw deliberately broken
        // source; and because `defer` is unavailable in this shell-out style,
        // a crash mid-window left the tree POISONED, with the real file
        // stranded at fingerprint.av.linttmp. The copy costs a few hundred ms
        // and removes the race outright rather than narrowing it.
        let root = avra_shell_exec("mktemp -d").trim()
        let _ = avra_shell_exec("cp -R packages/std-avrac/src '${root}/src'")
        let f = "${root}/src/core/fingerprint.av"
        let _ = avra_shell_exec("printf 'use typeck.{tc_er}\\n' | cat - '${f}' > '${f}.planted' && mv '${f}.planted' '${f}'")
        let rc = avra_shell_exec_status("bash scripts/diagnose.sh --check-core-layering --root '${root}/src' >/dev/null 2>&1")
        let _ = avra_shell_exec("rm -rf '${root}'")
        rc != 0
    }
    then "the REAL tree is untouched by the probe above" {
        // The probe plants into a copy, so the tracked tree must still pass.
        // A failure HERE means --root leaked back onto the real source.
        avra_shell_exec_status("bash scripts/diagnose.sh --check-core-layering >/dev/null 2>&1") == 0
    }
    then "the allowlist NAMES the two known inversions and their owner" {
        // The allowlist is the measurement. If it silently emptied, the lint
        // would still pass and would be asserting nothing.
        let out = avra_shell_exec("bash scripts/diagnose.sh --check-core-layering --list 2>&1")
        out.contains("core/registry.av") && out.contains("core/ast.av") && out.contains("t-y2i7.13")
    }
}
