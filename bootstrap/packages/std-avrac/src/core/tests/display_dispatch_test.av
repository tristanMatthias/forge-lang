// bfdq: `string(value)` and `${value}` interpolation dispatch to
// `<Type>.display(self) -> string` when defined — duck-typed
// Display, Go's `Stringer` pattern. No formal trait needed; the
// codegen detects the method and routes through it.
//
// Also covers bool → "true"/"false" (previously printed as "1"/"0"
// via the int-snprintf fallback path).

type User = { id: int, name: string, admin: bool }

impl User {
    fn display(self) -> string {
        "User#${string(self.id)}(${self.name}, admin=${string(self.admin)})"
    }
}

enum Mood {
    Happy,
    Sad,
    Angry,
}

impl Mood {
    fn display(self) -> string {
        match self {
            .Happy -> ":)"
            .Sad   -> ":("
            .Angry -> ">:("
        }
    }
}

spec "Display dispatch — struct" {
    then "string(user) calls User.display()" {
        let u = User { id: 7, name: "alice", admin: true }
        string(u) == "User#7(alice, admin=true)"
    }
    then "\${user} in interpolation calls display" {
        let u = User { id: 7, name: "alice", admin: false }
        let s = "got: ${u}"
        s == "got: User#7(alice, admin=false)"
    }
    then "two distinct users render distinctly" {
        let a = User { id: 1, name: "a", admin: true }
        let b = User { id: 2, name: "b", admin: false }
        "${a} | ${b}" == "User#1(a, admin=true) | User#2(b, admin=false)"
    }
}

spec "Display dispatch — enum" {
    then "string(Mood.Happy) calls Mood.display()" {
        string(Mood.Happy) == ":)"
    }
    then "all enum variants dispatch" {
        let xs = [Mood.Happy, Mood.Sad, Mood.Angry]
        "${xs[0]} ${xs[1]} ${xs[2]}" == ":) :( >:("
    }
}

spec "Bool → \"true\" / \"false\"" {
    then "string(true) is \"true\"" {
        let t = true
        string(t) == "true"
    }
    then "string(false) is \"false\"" {
        let f = false
        string(f) == "false"
    }
    then "bool interpolation reads naturally" {
        let admin = true
        "admin=${admin}" == "admin=true"
    }
}

spec "Fallback paths still work" {
    then "int still uses snprintf path" {
        string(42) == "42"
    }
    then "string passthrough" {
        let s = "hello"
        string(s) == "hello"
    }
    then "negative int" {
        let n = 0 - 7
        string(n) == "-7"
    }
}
