// WHY: module-aware name resolution — builds a module tree from
// Stmt.Module nodes, resolves `use` imports into alias tables, and
// rewrites Expr.Ident references to Expr.QualifiedIdent with their
// fully-qualified canonical paths (e.g. "core::ast::render_expr").
//
// After rewriting, calls resolve_program (sibling in resolve/) to
// validate variable scopes. The two passes are unified under a
// single `resolve_names` entry point.
//
// ── Audit of side effects (doc step 4.1 of EXPAND_PIPELINE_HANDOFF.md) ──
//
// register_decls(stmts) — pure with respect to AST. Builds:
//   - tree: ModuleNode — hierarchical mod path → items (per-stmt scan;
//     idempotent given the same AST).
//   - graph: ModuleGraph — flat module/item registry (per-stmt scan;
//     idempotent; mutates a fresh `interner` it owns; flat-allocates
//     a string-keyed C-side hashmap via avra_map_new_cstr for the
//     `by_path` / `by_canonical` / `package_roots` / `item_exports`
//     maps).
//   - aliases: List<AliasBinding> — per top-level `use` stmt walk;
//     diagnostics emitted when an imported name isn't found or is
//     private. Top-level only (doesn't recurse into Module bodies).
//   - global_index: GlobalItemReg — flat (short_name → canonical)
//     map derived from `graph.all_items`. Built via
//     `avra_map_new_cstr` + per-item insert (idempotent — first-seen
//     wins, dupes don't overwrite).
//   - bag — diagnostics accumulator (carries any use-alias errors).
//
// rewrite_uses(stmts, state) — pure: returns a new stmt list;
//   does NOT touch `state`. Walks each stmt, rewriting Idents into
//   QualifiedIdents per the alias + global_index. No registry
//   mutation, so calling twice on the same AST is idempotent.
//
// register_macro_decls(state, stmts) — additive: appends new
//   GraphItems to `state.graph.all_items` and new entries to
//   `state.global_index.idx` (in-place mutation of the C-side
//   hashmap; first-seen wins so re-running on the same AST is a
//   no-op). Tree / aliases / type_reg / bag are reused as-is.
//
// rewrite_uses_macro_only(stmts, state) — same purity as
//   rewrite_uses but walks only `from_macro == true` entries
//   (recursing into Module bodies to find spliced stmts nested
//   inside a user module).
//
//   read this file when:    working on module visibility, use imports,
//                           or qualified name resolution
//   do NOT read this file when:   the issue is variable scoping or
//                                  type checking

use core.{Expr, FieldEntry, Stmt, ParamEntry, FieldInit, MatchArm, WhenArm, Pattern, Variant, stmt_unwrap, Annotation, ValueType, SelectArm, vtype_from_name, vtype_struct, FORCE_UNWRAP_FN}
use core.{NodeStore, ExprId, StmtId, PatId}
use diagnostics.{Confidence, DiagCode, Span, MacroFnOrigin, DiagnosticBag, bag_new, bag_merge, bag_report, bag_has_errors, diag_error, diag_warning, diag_with_confidence, span_new, span_at, span_dummy}
use resolve.{resolve_program}
use resolve.{SymbolKind, SymbolTable, symbol_table_new, symbol_kind_is_type}
use core.{TypeRegistry, TypeKind, type_registry_new, type_registry_register, type_registry_id_for, type_qualified_name, method_mangled_name, trait_impl_name, is_mangled_method, method_from_mangled, type_short_name}
use core.{TypeParamEntry, type_param_has}
use core.{ModuleGraph, GraphItem, module_graph_is_exported, module_graph_new, ID_NONE}
use features.modules.{build_graph_from_stmts, graph_find_use_path}
use list_ops.{list_any, list_map, list_push_copy}

// ── Module tree ──
//
// Hierarchical namespace built from Stmt.Module nodes. Each node
// contains the items (functions, types, enums) defined in that module
// and links to child modules.

/// One declaration registered inside a module: short name, fully
/// qualified canonical path, export visibility flag, and the symbol
/// kind (the categorical half of the item's content-addressed identity
/// — see symbols.av).
type ModuleItemEntry = {
    short_name: string,
    canonical: string,
    exported: bool,
    kind: SymbolKind,
}

/// Hierarchical module tree built from `Stmt.Module` nodes. Each
/// node holds its name, full path, the items declared at that
/// level, child modules, and a sibling pointer.
///
/// Kept as an enum — `ModuleNode` is tree-shaped (each node has
/// BOTH `children` and `next` pointers), so a flat `List<T>` can't
/// model it. The `items` payload, however, is a simple list, so
/// that one moved over to `List<ModuleItemEntry>`.
enum ModuleNode {
    End
    Node(name: string, path: string, items: List<ModuleItemEntry>, children: ModuleNode, next: ModuleNode)
}

// ── Alias table ──
//
// Maps short names to canonical paths within a module scope.
// Built from `use` declarations.

/// `use mod.{name}` produces one AliasBinding per imported name —
/// short name → canonical path inside the module.
type AliasBinding = {
    short_name: string,
    canonical: string,
}

/// Linear search for `name` in the alias list. Returns the
/// canonical path or "" when not aliased. Scans from the tail
/// (most-recently-pushed) so the cons-list "newer alias wins"
/// shadowing semantics carry over — call sites that push the
/// same short_name twice (e.g. inner-module overrides
/// outer-module use) keep the inner binding.
fn alias_lookup(aliases: List<AliasBinding>, name: string) -> string {
    mut i = aliases.length - 1
    while i >= 0 {
        let a = aliases[i]
        if a.short_name == name { return a.canonical }
        i = i - 1
    }
    ""
}

// ── Module item lookup ──

/// Linear search for `name` in a module's item list. Returns the
/// canonical path or "" when not declared.
fn item_lookup(items: List<ModuleItemEntry>, name: string) -> string {
    mut i = 0
    while i < items.length {
        let it = items[i]
        if it.short_name == name { return it.canonical }
        i = i + 1
    }
    ""
}

// ── Global-index hashmap ──
//
// The global index — every item across every module, used by the
// rewriter to qualify every Ident — was a cons-list searched O(n) per
// identifier. Bootstrap source has ~5000 items and ~280k identifier
// references, so item_lookup was nearly quadratic. The reg below
// caches a cstr_map alongside the cons-list: build once at the top of
// resolve_names, then every Ident lookup is O(1).

extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

type GlobalItemReg = {
    canonicals: List<string>,
    idx: ptr,
}

/// Membership set of every declared TYPE's CANONICAL name (C-side cstr map,
/// value 1), built in the same pre-pass as the global index. It answers
/// "does module M declare TYPE N" (`M::N` present) BEFORE the rewrite walk
/// has registered anything — the local-shadowing probe in
/// `resolve_type_in_ctx` needs it because the TypeRegistry fills LAZILY
/// during the walk: a SELF-reference (a recursive enum's variant field) or a
/// FORWARD reference (a sibling type declared later in the same module)
/// probes the registry before its target registers, and without this set
/// the lookup fell through to the flat first-write-wins global index. Under
/// batched compilation, two modules each declaring a same-short-named type
/// then cross-resolved — module B's self-recursive `Wrap` acquired module
/// A's generic `Wrap<T>` and tripped the F1004 arity gate at its own
/// declaration (the type-name sibling of the per-module const-scoping fix).
/// TYPE-ONLY by design: this set feeds `resolve_type_in_ctx`'s local
/// probe, whose registry half (`type_registry_id_for`) is inherently
/// type-only. Adding fns/consts made a same-module `fn Foo` shadow an
/// explicitly imported `type Foo` — the annotation resolved to the fn's
/// canonical and the struct value silently collapsed to null.
fn declared_canonicals_build(items: List<ModuleItemEntry>) -> ptr {
    let set = avra_map_new_cstr()
    mut i = 0
    while i < items.length {
        let it = items[i]
        if symbol_kind_is_type(it.kind) {
            avra_map_set_cstr(set, it.canonical, 1)
        }
        i = i + 1
    }
    set
}

fn global_item_reg_build(items: List<ModuleItemEntry>) -> GlobalItemReg {
    let idx = avra_map_new_cstr()
    mut canonicals: List<string> = []
    mut i = 0
    while i < items.length {
        let it = items[i]
        // Bind field accesses to locals before passing them to method
        // calls — the current seed compiler's typeck can't propagate
        // the struct field type through `canonicals.push(it.canonical)`
        // directly (it bails with "field access on non-struct value,
        // ty=<unknown>"). Once a future seed cycle picks up improved
        // type inference, this can be simplified back to the direct
        // form.
        let sn = it.short_name
        let canon = it.canonical
        if avra_map_has_cstr(idx, sn) == 0 {
            let n = canonicals.length
            canonicals.push(canon)
            avra_map_set_cstr(idx, sn, n)
        }
        i = i + 1
    }
    GlobalItemReg { canonicals, idx }
}


fn global_item_lookup(reg: GlobalItemReg, name: string) -> string {
    if avra_map_has_cstr(reg.idx, name) == 0 { return "" }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.canonicals[i]
}

/// Membership set of canonical module-level `const` names, cstr-map-
/// backed for O(1) lookups during the ident rewrite. Built once per
/// resolve pass by `const_index_build`. The uppercase-ident rewrite
/// consults it to qualify SCREAMING_SNAKE const references without
/// touching type/enum names (which must stay bare for codegen).
type ConstIndex = { idx: ptr }

fn const_index_build(store: NodeStore, ids: List<StmtId>) -> ConstIndex {
    let ci = ConstIndex { idx: avra_map_new_cstr() }
    collect_module_consts(store, ids, "", ci)
    ci
}

fn const_index_has(ci: ConstIndex, canonical: string) -> bool {
    avra_map_has_cstr(ci.idx, canonical) != 0
}

/// Walk every module-level `const` (recursing into Module bodies and
/// Annotated wrappers only — fn/block bodies declare LOCAL consts, not
/// items) and record its canonical qualified name. Program-root consts
/// (mod_path == "") are skipped: they compile as root-scope bindings
/// and are never qualified.
fn collect_module_consts(store: NodeStore, ids: List<StmtId>, mod_path: string, ci: ConstIndex) {
    for id in ids {
        collect_module_const_stmt(store, store.stmts.get(id), mod_path, ci)
    }
}

fn collect_module_const_stmt(store: NodeStore, stmt: Stmt, mod_path: string, ci: ConstIndex) {
    match stmt {
        .Const(name, _, _) -> {
            if mod_path != "" {
                // Already-qualified names (re-resolve passes) register as-is.
                let canonical = if name.contains("::") { name } else { type_qualified_name(mod_path, name) }
                avra_map_set_cstr(ci.idx, canonical, 1)
            }
        }
        .Module(name, body) -> collect_module_consts(store, body, type_qualified_name(mod_path, name), ci)
        .Annotated(_, inner) -> collect_module_const_stmt(store, store.stmts.get(inner), mod_path, ci)
        _ -> {}
    }
}

/// True iff `name` is declared in `items` AND marked `export`.
fn item_is_exported(items: List<ModuleItemEntry>, name: string) -> bool {
    mut i = 0
    while i < items.length {
        let it = items[i]
        if it.short_name == name { return it.exported }
        i = i + 1
    }
    false
}

/// Graph-driven flat index builder: walks the graph's pre-computed
/// `all_items` list (populated by graph_build's `register_item_typed`)
/// into a `List<ModuleItemEntry>` the resolver can scan directly.
/// Avoids the recursive AST walk + per-module `collect_module_items`
/// pass. Iterates the List<GraphItem> in reverse to preserve the
/// prepend semantics of the previous cons-list form — graph_build
/// pushes in source order, so the resulting list has first-seen-last.
///
/// `kind` is a don't-care: this list feeds only the name-keyed global
/// index and the declared-canonicals set (neither reads kind). Real
/// (path, kind) symbol identities are interned separately in
/// `register_decls` via `intern_item_symbols` / `intern_tree_symbols`,
/// which walk the AST where the kind is known.
fn build_global_index_from_graph(items: List<GraphItem>) -> List<ModuleItemEntry> {
    mut out: List<ModuleItemEntry> = []
    mut i = items.length - 1
    while i >= 0 {
        let it = items[i]
        // GraphItem (core layer) can't name SymbolKind — it carries the
        // coarse is_type bit; map it back so the probe (declared_canonicals_build)
        // sees types as types. Non-types collapse to FnSym: the graph-path index
        // never distinguishes fn/const/method downstream, and this set is used
        // only for the type probe.
        let k = if it.is_type { SymbolKind.TypeSym } else { SymbolKind.FnSym }
        out.push(ModuleItemEntry { short_name: it.short_name, canonical: it.canonical, exported: it.exported, kind: k })
        i = i - 1
    }
    out
}

/// Find a ModuleNode by qualified path (e.g. `"helpers"` or
/// `"core::ast"`). Returns ModuleNode.End when no match.
fn module_find(tree: ModuleNode, path: string) -> ModuleNode {
    match tree {
        .End -> ModuleNode.End
        .Node(_, mod_path, _, _, _) if mod_path == path -> tree
        .Node(_, _, _, children, next) -> {
            let in_children = module_find(children, path)
            match in_children {
                .End -> module_find(next, path)
                _ -> in_children
            }
        }
    }
}

// ── Pass 1: Build module tree ──
//
// Walk the AST and collect all module-level declarations (fn, type,
// enum, trait, extern fn) into a hierarchical ModuleNode tree.

/// Root entry for module tree construction. Recurses on every
/// `Stmt.Module`, building children + sibling links.
fn build_module_tree(store: NodeStore, ids: List<StmtId>, parent_path: string, tree: ModuleNode) -> ModuleNode {
    mut cur = tree
    for id in ids {
        cur = build_tree_from_stmt(store, store.stmts.get(id), parent_path, cur)
    }
    cur
}

/// Per-stmt branch of `build_module_tree`. `Module` adds a node
/// (and recurses for children); `Annotated` strips the wrapper;
/// everything else passes through unchanged.
fn build_tree_from_stmt(store: NodeStore, stmt: Stmt, parent_path: string, tree: ModuleNode) -> ModuleNode {
    match stmt {
        .Module(name, body) -> {
            let mod_path = type_qualified_name(parent_path, name)
            // Collect items in this module
            let items = collect_module_items(store, body, mod_path)
            // Recursively build tree for nested modules
            let children = build_module_tree(store, body, mod_path, ModuleNode.End)
            // Add this module to the tree
            ModuleNode.Node(name, mod_path, items, children, tree)
        }
        .Annotated(_, inner) -> build_tree_from_stmt(store, store.stmts.get(inner), parent_path, tree)
        _ -> tree
    }
}

/// Collect every declaration name in a module's body — fn, type,
/// enum, trait, newtype, etc. Wraps the per-stmt collector.
/// Walks stmts in source order, pushing items as they're seen so
/// the resulting list preserves source order (matching the
/// previous cons-list which was built head-first by walking the
/// tail recursively).
fn collect_module_items(store: NodeStore, ids: List<StmtId>, mod_path: string) -> List<ModuleItemEntry> {
    mut out: List<ModuleItemEntry> = []
    for id in ids {
        collect_item_from_stmt(store, store.stmts.get(id), mod_path, false, out)
    }
    out
}

/// Per-stmt branch of `collect_module_items` — appends one or
/// more `ModuleItemEntry`s to `out_ref` for the matched
/// declaration variants (Function, TypeDecl, EnumDecl, TraitDecl,
/// etc.). `exported` is threaded down from the enclosing
/// `Annotated(@export, …)`.
///
/// `out_ref` is rebound to a `mut` local before pushing — Avra
/// params are immutable, but the underlying heap AvraArray is
/// shared so push mutations reach the caller (same convention as
/// test_runner/discovery.av).
fn collect_item_from_stmt(store: NodeStore, stmt: Stmt, mod_path: string, exported: bool, out_ref: List<ModuleItemEntry>) {
    mut out = out_ref
    match stmt {
        .Function(name, _, _, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.FnSym })
        }
        .ExternFn(name, _, _) -> {
            // Extern fns keep bare names (C ABI) but are registered
            // for visibility tracking
            out.push(ModuleItemEntry { short_name: name, canonical: name, exported: true, kind: SymbolKind.FnSym })
        }
        .TypeDecl(name, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.TypeSym })
        }
        .NewtypeDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.NewtypeSym })
        }
        .UnionAliasDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.UnionAliasSym })
        }
        .ShapeDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.ShapeSym })
        }
        .EnumDecl(name, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.EnumSym })
        }
        .TraitDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.TraitSym })
        }
        // Module-level consts are visible to `use mod.{NAME}` callers
        // exactly like fns and types.
        .Const(name, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            out.push(ModuleItemEntry { short_name: name, canonical, exported, kind: SymbolKind.ConstSym })
        }
        .Impl(_, methods) -> collect_impl_items(store, methods, mod_path, out)
        .Annotated(annotations, inner) -> {
            let is_export = annotation_has_export(annotations)
            // Re-exports: `export use path.{name1, name2}` makes imported
            // names visible as exports of the current module.
            if is_export {
                match store.stmts.get(inner) {
                    .Use(use_path, names) -> {
                        // The use path is relative to the current module, so
                        // prefix with the module path to get the canonical path.
                        let rel_path = dots_to_colons(use_path)
                        let canonical_mod = type_qualified_name(mod_path, rel_path)
                        collect_reexport_items(names, canonical_mod, out)
                        return
                    }
                    _ -> {}
                }
            }
            collect_item_from_stmt(store, store.stmts.get(inner), mod_path, is_export, out)
        }
        _ -> {}
    }
}

/// Collect re-exported names from `export use path.{name1, name2}`.
/// Each imported name becomes an exported item in the current
/// module, with its canonical path pointing at the source module.
fn collect_reexport_items(names: List<ParamEntry>, source_mod: string, out_ref: List<ModuleItemEntry>) {
    mut out = out_ref
    mut i = 0
    while i < names.length {
        let name = names[i].name
        let canonical = type_qualified_name(source_mod, name)
        // AliasSym: names another module's definition — never interned
        // as a symbol of its own (the definition interns in its module).
        // Not a type kind, so the declared-canonicals probe skips it — safe:
        // its canonical anchors at the SOURCE module, never the current one.
        out.push(ModuleItemEntry { short_name: name, canonical, exported: true, kind: SymbolKind.AliasSym })
        i = i + 1
    }
}

/// Collect the methods of an impl block. Methods are stored under
/// their pre-mangled `Type__method` name so dispatch can grep the
/// global index directly.
fn collect_impl_items(store: NodeStore, methods: List<StmtId>, mod_path: string, out_ref: List<ModuleItemEntry>) {
    mut out = out_ref
    mut i = 0
    while i < methods.length {
        match stmt_unwrap(store, store.stmts.get(methods[i])) {
            .Function(name, _, _, _, _) -> {
                // Impl methods are already mangled as Type__method.
                // Keep bare name — method call codegen uses Type__method directly.
                out.push(ModuleItemEntry { short_name: name, canonical: name, exported: true, kind: SymbolKind.MethodSym })
            }
            _ -> {}
        }
        i = i + 1
    }
}

/// True iff the annotation list includes `@export`.
fn annotation_has_export(annotations: List<Annotation>) -> bool {
    list_any(annotations, (a: Annotation) -> a.name == "export")
}

// ── Pass 2: Resolve use aliases ──
//
// Walk the AST and for each Stmt.Use, look up the imported names in
// the module tree and build an alias table for the containing scope.

/// Top-level entry for use-alias resolution: process every `use`
/// statement, building an AliasEntry list keyed off short names.
fn resolve_use_aliases(store: NodeStore, ids: List<StmtId>, tree: ModuleNode, graph: ModuleGraph) -> UseResult {
    resolve_use_aliases_in(store, ids, tree, graph, "")
}

/// Resolve `use` statements relative to a current module path.
/// Lookup order:
///   1. Absolute (root-relative) `canonical_path`.
///   2. `current_module::canonical_path` and each ancestor scope
///      walking up to the root.
/// The ancestor walk is what lets a sub-module of `@std.avrac.indexer`
/// say `use core.{...}` and have it resolve to the sibling
/// `@std.avrac.core.runtime` rather than failing because no such
/// module exists at the program root.
fn resolve_use_aliases_in(store: NodeStore, ids: List<StmtId>, tree: ModuleNode, graph: ModuleGraph, current_module: string) -> UseResult {
    // Walk in reverse so accumulator semantics match the original
    // head-recursive cons-cell walk (which built the result on the
    // way back up the recursion).
    mut acc = UseResult { aliases: [], bag: bag_new() }
    mut i = ids.length - 1
    while i >= 0 {
        let id = ids[i]
        let node = store.stmts.get(id)
        let unwrapped = match node {
            .Annotated(_, inner) -> store.stmts.get(inner)
            _ -> node
        }
        acc = match unwrapped {
            .Use(mod_path, names) -> {
                let canonical_path = dots_to_colons(mod_path)
                let p = store.stmt_pos(id)
                let sp = span_at(0, 0, p.line, p.col, p.file)
                // Graph is the source of truth for path resolution;
                // each module's canonical path was captured at
                // construction so the ancestor walk runs as a chain
                // of strmap hits instead of recursive AST traversal.
                let resolved_path = graph_find_use_path(graph, current_module, canonical_path)
                resolve_use_names(resolved_path, names, tree, graph, acc, sp)
            }
            _ -> acc
        }
        i = i - 1
    }
    acc
}

/// Output of `resolve_use_aliases` — the alias list plus any
/// diagnostics encountered during use-resolution.
type UseResult = {
    aliases: List<AliasBinding>,
    bag: DiagnosticBag,
}

/// Per-name resolver inside a `use mod.{name1, name2}` clause.
/// Looks each name up in `mod_path`'s items, emits ImportNotFound /
/// ImportPrivate when missing or non-exported, and otherwise
/// prepends an AliasEntry.
fn resolve_use_names(mod_path: string, names: List<ParamEntry>, tree: ModuleNode, graph: ModuleGraph, result: UseResult, sp: Span) -> UseResult {
    mut acc = result
    mut i = 0
    while i < names.length {
        let name = names[i].name
        let name_sp = sp
        let mod_node = module_find(tree, mod_path)
        acc = match mod_node {
            .End -> {
                let d = diag_error(DiagCode.ImportNotFound, "`use ${mod_path}` — module not found in module tree", sp)
                UseResult { aliases: acc.aliases, bag: bag_report(acc.bag, d) }
            }
            .Node(_, _, items, _, _) -> {
                let found = item_lookup(items, name)
                match {
                    found == "" -> {
                        let d = diag_error(DiagCode.ImportNotFound, "`${name}` not found in module `${mod_path}`", name_sp)
                        UseResult { aliases: acc.aliases, bag: bag_report(acc.bag, d) }
                    }
                    !is_item_visible(graph, mod_path, name, found, items) -> {
                        let d = diag_error(DiagCode.ImportPrivate, "`${name}` is private in module `${mod_path}`", name_sp)
                        UseResult { aliases: acc.aliases, bag: bag_report(acc.bag, d) }
                    }
                    _ -> {
                        mut new_aliases = acc.aliases
                        new_aliases.push(AliasBinding { short_name: name, canonical: found })
                        UseResult { aliases: new_aliases, bag: acc.bag }
                    }
                }
            }
            _ -> acc
        }
        i = i + 1
    }
    acc
}

/// Visibility check that prefers the graph but falls back to the AST
/// items list. Extern-fn items have a bare-name canonical (preserved
/// for C ABI) that doesn't appear in the graph's `${mod}::${name}`
/// keying — for those, defer to `item_is_exported(items, name)`.
fn is_item_visible(graph: ModuleGraph, mod_path: string, name: string, canonical: string, items: List<ModuleItemEntry>) -> bool {
    let qual = if mod_path == "" { name } else { "${mod_path}::${name}" }
    if canonical == qual {
        // Standard case: graph's export bit is the source of truth.
        module_graph_is_exported(graph, qual)
    } else {
        // Extern fn / re-exports / mangled methods: canonical doesn't
        // match `mod::name` so the graph's keying misses. Fall back
        // to the AST tree's per-item exported flag.
        item_is_exported(items, name)
    }
}

/// Convert a dotted module path (`a.b.c`) to its `::` form
/// (`a::b::c`) — bridging the source syntax `use a.b.c` to the
/// canonical-name representation used in the module tree.
fn dots_to_colons(path: string) -> string {
    mut result = ""
    for i in 0..path.length {
        let ch = path[i]
        if ch == "." {
            result = "${result}::"
        } else {
            result = result + ch
        }
    }
    result
}

// ── Pass 3: Rewrite identifiers ──
//
// Walk all expressions in the AST. For each Expr.Ident that references
// a module-level item (via use aliases or implicit sibling access),
// rewrite it to Expr.QualifiedIdent with the canonical path.
//
// Local variables (let/mut/fn params/for/match bindings) are tracked
// in a scope stack and are NOT rewritten — they stay as Expr.Ident.

/// Scope stack for the name-resolution pass — tracks the local
/// variables in scope at each point during the rewrite. Distinct
/// from the resolver's ScopeBinding because this layer also
/// carries `defined` for forward-reference handling.
type LocalBinding = {
    name: string,
    mutable: int,
    defined: int,
    depth: int,
}

/// Membership probe for the local scope list.
fn scope_has(scope: List<LocalBinding>, name: string) -> bool {
    list_any(scope, (b: LocalBinding) -> b.name == name)
}

/// True for names the rewriter must NOT qualify even when a global
/// item shadows them. `println`, `int`, `panic`, etc. always stay
/// bare so user shadowing of those names doesn't accidentally
/// trigger unintended dispatch.
fn is_builtin_name(name: string) -> bool {
    name in ["println", "eprintln", "print", "eprint", "string", "int", "float", "panic", "exit", "self", FORCE_UNWRAP_FN]
}

// ── Name resolution context ──

/// State threaded through the rewrite pass. Carries every lookup
/// surface the rewriter needs: the module tree, current alias chain,
/// active module path, the local scope stack, and the type registry.
/// `global_index` is a flat, O(1)-lookup view of all module items —
/// built once at the start of `resolve_names`.
type NameCtx = {
    tree: ModuleNode,
    graph: ModuleGraph,
    aliases: List<AliasBinding>,
    current_module: string,
    locals: List<LocalBinding>,
    global_index: GlobalItemReg,
    // Canonical-name membership set (see `declared_canonicals_build`) — the
    // registration-order-independent half of the local-shadowing probe.
    declared: ptr,
    type_reg: TypeRegistry,
    // The program's NodeStore (B-final F2+): pattern children are ids,
    // resolved through here when binding/rewriting.
    nodes: NodeStore,
    // cpvo: the enclosing generic fn's / type's type-params, in scope as a
    // LOCAL binding that shadows same-named types. A name is a type-param iff
    // it's here — replacing the brittle "single uppercase letter" heuristic
    // that conflated a param `T` with a user type `T`.
    type_params: List<TypeParamEntry>,
    // cpvo: every generic TypeDecl/EnumDecl's declared type-params, keyed by
    // name. The impl parser DROPS `impl Foo<T>`'s `<T>` (it skips the angle
    // brackets), so an impl method that returns the struct's param `T` would
    // otherwise have `T` qualified to a phantom `mod::T` while the struct
    // field's `T` stays bare — a spurious return-type mismatch. rewrite_impl_stmt
    // recovers the target's type-params from here and threads them into scope.
    type_decl_tps: List<TypeDeclTpEntry>,
    // True while rewriting a Module body's DIRECT children — the only
    // position where a `const` declares a module ITEM (qualified name,
    // one global per module) rather than a local binding. Set by
    // ctx_with_module, cleared on every descent into a fn / lambda /
    // block / spec / parallel body. Without the decl-side qualification
    // two modules' same-named consts collapsed into ONE flat LLVM
    // global and silently read each other's value (first-match-wins) —
    // the batched-test-file const collision.
    module_top: bool,
    // Canonical names of every module-level const declaration; lets the
    // uppercase-ident rewrite qualify const references specifically.
    const_index: ConstIndex,
    // The resolver's symbol interner (ResolverState.symbols). The rewrite
    // interns impl METHODS here — the one item kind whose qualified
    // identity (`mod::Foo__run`) only exists once the impl target has
    // resolved. Insert-once, so re-resolve passes are no-ops.
    symbols: SymbolTable,
}

/// One generic type declaration's type-params, indexed for impl-method
/// scope recovery (cpvo). Keyed by both qualified and short name so an
/// impl's resolved target (`mod::Foo`) or the parser's bare target
/// (`Foo`) both find it.
type TypeDeclTpEntry = {
    qualified: string,
    short: string,
    tp: List<TypeParamEntry>,
}

/// Functional update: replace the `locals` field.
fn ctx_with_locals(ctx: NameCtx, locals: List<LocalBinding>) -> NameCtx {
    ctx with { locals }
}

/// cpvo: enter a generic fn's / type's type-param scope. MERGES with the
/// existing scope so a nested generic accumulates (rather than dropping) the
/// outer type-params.
fn ctx_with_type_params(ctx: NameCtx, tp: List<TypeParamEntry>) -> NameCtx {
    if tp.length == 0 { return ctx }
    ctx with { type_params: concat_type_params(ctx.type_params, tp) }
}

fn concat_type_params(a: List<TypeParamEntry>, b: List<TypeParamEntry>) -> List<TypeParamEntry> {
    mut out: List<TypeParamEntry> = []
    for p in a { out.push(p) }
    for p in b { out.push(p) }
    out
}

/// cpvo: walk every TypeDecl / EnumDecl (recursing into Module bodies +
/// Annotated wrappers) and record those carrying type-params. Built once
/// per resolve pass; lets rewrite_impl_stmt recover an impl target's
/// `<T>` (which the impl parser discards). Names are short at collect time
/// — declared_type_name qualifies them only DURING the rewrite — so the
/// qualified key is computed here from the module path; an already-qualified
/// name (re-resolve passes) is stored as-is with its short tail.
fn collect_type_decl_tps(store: NodeStore, ids: List<StmtId>, mod_path: string, out_ref: List<TypeDeclTpEntry>) {
    mut out = out_ref
    for id in ids {
        collect_type_decl_tp_stmt(store, store.stmts.get(id), mod_path, out)
    }
}

fn collect_type_decl_tp_stmt(store: NodeStore, stmt: Stmt, mod_path: string, out_ref: List<TypeDeclTpEntry>) {
    mut out = out_ref
    match stmt {
        .TypeDecl(name, tp, _) -> { if tp.length > 0 { out.push(type_decl_tp_entry(mod_path, name, tp)) } }
        .EnumDecl(name, tp, _) -> { if tp.length > 0 { out.push(type_decl_tp_entry(mod_path, name, tp)) } }
        .Module(name, body) -> collect_type_decl_tps(store, body, type_qualified_name(mod_path, name), out)
        .Annotated(_, inner) -> collect_type_decl_tp_stmt(store, store.stmts.get(inner), mod_path, out)
        _ -> {}
    }
}

fn type_decl_tp_entry(mod_path: string, name: string, tp: List<TypeParamEntry>) -> TypeDeclTpEntry {
    if name.contains("::") {
        TypeDeclTpEntry { qualified: name, short: type_short_name(name), tp }
    } else {
        TypeDeclTpEntry { qualified: type_qualified_name(mod_path, name), short: name, tp }
    }
}

/// cpvo: recover an impl target's declared type-params. Tries the
/// resolved qualified name first (precise), then the bare short name
/// the impl parser hands us. Returns [] when the type isn't generic.
fn type_decl_tp_lookup(list: List<TypeDeclTpEntry>, qualified: string, short: string) -> List<TypeParamEntry> {
    mut i = 0
    while i < list.length {
        if list[i].qualified == qualified { return list[i].tp }
        i = i + 1
    }
    mut j = 0
    while j < list.length {
        if list[j].short == short { return list[j].tp }
        j = j + 1
    }
    let empty: List<TypeParamEntry> = []
    empty
}

/// Functional update: enter a new module by swapping the active path
/// and alias chain. The module body's direct children are module-top
/// statements — a `const` there is a module item (see NameCtx.module_top).
fn ctx_with_module(ctx: NameCtx, current_module: string, aliases: List<AliasBinding>) -> NameCtx {
    ctx with { aliases, current_module, module_top: true }
}

/// Enter a nested statement scope (block / spec / given / parallel /
/// trait body): a `const` declared there is a local binding, not a
/// module item. No-op when already outside module-top position.
fn ctx_nested_scope(ctx: NameCtx) -> NameCtx {
    if !ctx.module_top { return ctx }
    ctx with { module_top: false }
}

/// Push every parameter name onto the local scope as a defined
/// variable. Used when entering a fn / lambda body.
///
/// CRITICAL: uses list_push_copy so the parent ctx's underlying
/// locals list is NOT mutated. List<T> is heap-backed; a plain
/// `acc.locals.push(...)` would alias the parent's list and leak
/// every fn's params into every sibling fn's scope. That cross-
/// fn leak silently rewrites bare Ident("foo") into bare-Ident-
/// stays-bare when `foo` was actually a fn name in a different
/// module — undefined-variable errors fire in random downstream
/// fns whose locals had nothing to do with the leaked name.
fn bind_params_ctx(ctx: NameCtx, params: List<ParamEntry>) -> NameCtx {
    // Every caller (fn / lambda / catch / select / list-comp body) is a
    // nested value scope — consts declared inside are locals, never
    // module items, even when the param list is empty.
    bind_names_ctx(ctx_nested_scope(ctx), params)
}

/// Add each entry's name to the local scope WITHOUT entering a nested
/// scope — for bindings (destructures) that live at the current level.
fn bind_names_ctx(ctx: NameCtx, params: List<ParamEntry>) -> NameCtx {
    mut acc = ctx
    mut i = 0
    while i < params.length {
        acc = scope_add_local(acc, params[i].name)
        i = i + 1
    }
    acc
}

/// Push a single name onto the local scope. `list_push_copy` (not a
/// mutating push) keeps the parent ctx's `locals` untouched, so an
/// inner scope's bindings never leak back to the enclosing scope —
/// same reasoning as `bind_params_ctx`.
fn scope_add_local(ctx: NameCtx, name: string) -> NameCtx {
    ctx_with_locals(ctx, list_push_copy(ctx.locals, LocalBinding { name, mutable: false, defined: true, depth: 0 }))
}

/// Bind every binding in a pattern (e.g. `.Some(x, y)` adds `x` and
/// `y` to the local scope) so the match arm body can reference them.
fn bind_pattern_ctx(ctx: NameCtx, pattern: Pattern) -> NameCtx {
    match pattern {
        .Wildcard -> ctx
        .Rest -> ctx
        .Variant(_, bindings) -> bind_params_ctx(ctx, bindings)
        .NestedVariant(_, sub_pats) -> bind_pattern_list(ctx, sub_pats)  // ids resolved in the list walker
        .TypePattern(_, binding) -> scope_add_local(ctx, binding)
        _ -> ctx
    }
}

/// Apply `bind_pattern_ctx` over a list of patterns — used by
/// nested-variant destructuring.
fn bind_pattern_list(ctx: NameCtx, pats: List<PatId>) -> NameCtx {
    mut acc = ctx
    mut i = 0
    while i < pats.length {
        acc = bind_pattern_ctx(acc, ctx.nodes.pats.get(pats[i]))
        i = i + 1
    }
    acc
}

/// Concat two alias lists. Used to layer per-Module imports onto a
/// parent's alias environment. The `extra` entries are appended
/// in order so the last entry has the highest lookup priority
/// (alias_lookup scans from the tail).
fn merge_aliases(base: List<AliasBinding>, extra: List<AliasBinding>) -> List<AliasBinding> {
    mut out = base
    mut i = 0
    while i < extra.length {
        out.push(extra[i])
        i = i + 1
    }
    out
}

// ── Public entry point ──

/// Output of `resolve_names` — the rewritten statement tree, error
/// flags, accumulated diagnostics, the populated type registry, and
/// the macro-origin table built during @expand splice. Origins are
/// empty for the bare resolver path; populated by
/// `resolve_and_expand_program` when macros fire. Consumed by
/// `typecheck_program` so synthetic fns can blame their macro in
/// diagnostics (so07.3 / T3).
export type NameResolveResult = {
    // The post-resolve program vector is arena-id-native — the next pass
    // (run_comptime) takes ids straight, reading each node's position
    // and payload from the shared store.
    stmts: List<StmtId>,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
    type_reg: TypeRegistry,
    macro_origins: List<MacroFnOrigin>,
}

/// Snapshot produced by `register_decls`: every fact discovered
/// during the decl-scan half of name resolution, in a shape that
/// `rewrite_uses` can consume directly. Exported so the @expand
/// pipeline-eval phase can register macro-emitted decls into the
/// resolver state and re-run `rewrite_uses` over the spliced AST
/// without re-walking the originals.
export type ResolverState = {
    tree: ModuleNode,
    graph: ModuleGraph,
    aliases: List<AliasBinding>,
    global_index: GlobalItemReg,
    // Membership set of every declared TYPE's CANONICAL name (C-side cstr
    // map, value 1) — see `declared_canonicals_build` for why the local-
    // shadowing probe needs it alongside the lazily-filled type registry.
    declared: ptr,
    type_reg: TypeRegistry,
    bag: DiagnosticBag,
    // The program's NodeStore (B-final F2+): expansion-time transforms
    // allocate flipped id payloads through it (comptime runtimes seed
    // their `nodes` from here).
    nodes: NodeStore,
    // The interned symbol model (ps3t.8.4 / L6 §6): every declared item's
    // content-addressed (qualified path + kind) identity. Built by
    // register_decls; register_macro_decls interns spliced decls in place.
    symbols: SymbolTable,
}

/// Decl-scan half of `resolve_names`: builds the module tree, graph,
/// use-alias bindings, global index, and a fresh type registry from
/// `stmts`. Pure with respect to the input AST — returns a
/// `ResolverState` value, no in-place mutation.
///
/// Carved out of the monolithic `resolve_names` so the @expand
/// pipeline can rebuild the decl context after macro expansion
/// without re-running the use-site rewrite over already-resolved
/// originals.
export fn register_decls(ids: List<StmtId>, store: NodeStore) -> ResolverState {
    let tree = build_module_tree(store, ids, "", ModuleNode.End)
    let graph = build_graph_from_stmts(store, ids)
    let use_result = resolve_use_aliases(store, ids, tree, graph)
    let global_index_list = build_global_index_from_graph(graph.all_items)
    let global_index = global_item_reg_build(global_index_list)
    let reg = type_registry_new()
    // Intern the symbol model (ps3t.8.4): every declared item — root-level
    // (not in the tree, which only holds Module bodies) and module-nested —
    // gets its content-addressed (qualified path + kind) identity.
    let symbols = symbol_table_new()
    intern_item_symbols(symbols, collect_module_items(store, ids, ""))
    intern_tree_symbols(symbols, tree)
    ResolverState {
        tree,
        graph,
        aliases: use_result.aliases,
        global_index,
        declared: declared_canonicals_build(global_index_list),
        type_reg: reg,
        bag: use_result.bag,
        nodes: store,
        symbols,
    }
}

/// Intern every collected item's (path, kind) identity. Two kinds are
/// skipped here:
///  - AliasSym (re-exports): an alias names another module's definition,
///    which interns when its own module is walked.
///  - MethodSym (impl methods): at collect time the mangled name still
///    carries the impl target's BARE type (`Foo__run`), so same-named
///    types in different modules would collapse into one symbol. The
///    method interns during the use-site rewrite instead
///    (`rewrite_impl_method_stmt`), where the target has resolved to its
///    qualified name and the identity is the true `mod::Foo__run`.
fn intern_item_symbols(table: SymbolTable, items: List<ModuleItemEntry>) {
    mut i = 0
    while i < items.length {
        // `entry`, not `it`: inside a method-call argument a bare `it`
        // is the closure pronoun, not a local (same gotcha as
        // global_item_reg_build's bind-to-locals comment).
        let entry = items[i]
        match entry.kind {
            .AliasSym or .MethodSym -> {}
            .FnSym or .TypeSym or .EnumSym or .TraitSym or .NewtypeSym or .UnionAliasSym or .ShapeSym or .ConstSym -> {
                let _ = table.intern(entry.canonical, entry.kind, entry.exported)
            }
        }
        i = i + 1
    }
}

/// Recursive twin of `intern_item_symbols` over the module tree: intern
/// each node's items, then descend into children and siblings.
fn intern_tree_symbols(table: SymbolTable, tree: ModuleNode) {
    match tree {
        .End -> {}
        .Node(_, _, items, children, next) -> {
            intern_item_symbols(table, items)
            intern_tree_symbols(table, children)
            intern_tree_symbols(table, next)
        }
    }
}

/// Use-site rewrite half of `resolve_names`: walks `stmts` and
/// rewrites each Ident / type name to its canonical qualified form
/// using the supplied `ResolverState`. Pure: returns a new stmt list,
/// does not modify `stmts`.
export fn rewrite_uses(ids: List<StmtId>, state: ResolverState) -> List<StmtId> {
    mut tps: List<TypeDeclTpEntry> = []
    collect_type_decl_tps(state.nodes, ids, "", tps)
    let ctx = NameCtx {
        tree: state.tree,
        graph: state.graph,
        aliases: state.aliases,
        current_module: "",
        locals: [],
        global_index: state.global_index,
        declared: state.declared,
        type_reg: state.type_reg,
        nodes: state.nodes,
        type_params: [],
        type_decl_tps: tps,
        module_top: false,
        const_index: const_index_build(state.nodes, ids),
        symbols: state.symbols,
    }
    rewrite_stmt_ids(ctx, ids)
}

/// Partial re-resolve (step 4 of expand-pipeline doc): walks `stmts`
/// and re-rewrites ONLY entries with `from_macro == true` using the
/// supplied `state`. Hand-written stmts pass through unchanged — they
/// were already rewritten by the pre-expand pass against the same
/// alias table, so re-walking them would be redundant work. The
/// spliced stmts need this pass because their bodies were constructed
/// at quote-time with bare Idents that must be requalified against
/// the post-expand registry. Recurses into Module bodies so a
/// spliced fn inside a user module still gets rewritten.
export fn rewrite_uses_macro_only(ids: List<StmtId>, state: ResolverState) -> List<StmtId> {
    mut tps: List<TypeDeclTpEntry> = []
    collect_type_decl_tps(state.nodes, ids, "", tps)
    let ctx = NameCtx {
        tree: state.tree,
        graph: state.graph,
        aliases: state.aliases,
        current_module: "",
        locals: [],
        global_index: state.global_index,
        declared: state.declared,
        type_reg: state.type_reg,
        nodes: state.nodes,
        type_params: [],
        type_decl_tps: tps,
        module_top: false,
        const_index: const_index_build(state.nodes, ids),
        symbols: state.symbols,
    }
    rewrite_macro_stmts(ctx, ids)
}

fn rewrite_macro_stmts(ctx: NameCtx, ids: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    for id in ids {
        if ctx.nodes.is_from_macro(id) {
            out.push(ctx.nodes.restmt(rewrite_stmt(ctx, ctx.nodes.stmts.get(id)), id))
        } else {
            // Descend into Module bodies so spliced stmts nested
            // inside a Module wrapper are still picked up.
            match ctx.nodes.stmts.get(id) {
                .Module(name, body) -> {
                    let mod_ctx = ctx with { current_module: type_qualified_name(ctx.current_module, name), module_top: true }
                    let new_body = rewrite_macro_stmts(mod_ctx, body)
                    out.push(ctx.nodes.restmt(Stmt.Module(name, new_body), id))
                }
                _ -> out.push(id)
            }
        }
    }
    out
}

/// Additive register: takes an existing `state` and the full
/// post-expand stmt list. Walks the list (recursing into Modules)
/// and appends a `GraphItem` to `state.graph.all_items` + a
/// `(short_name → canonical)` entry to `state.global_index` for
/// every `from_macro == true` declaration. Returns a new
/// `ResolverState` with the augmented graph + global_index, sharing
/// the tree, aliases, type_reg, and bag from the input state.
///
/// Matches the doc's `register_decls(spliced_only, existing_registry)`
/// — additive, not a fresh rebuild. Avoids re-running
/// `resolve_use_aliases` (which would re-emit any pre-existing
/// import diagnostics and double-bag them).
export fn register_macro_decls(state: ResolverState, ids: List<StmtId>) -> ResolverState {
    mut new_items: List<GraphItem> = []
    collect_macro_items(state.nodes, ids, "", new_items, state.symbols)
    if new_items.length == 0 { return state }

    // Augment graph.all_items by appending the new entries.
    mut updated_all: List<GraphItem> = []
    for old in state.graph.all_items { updated_all.push(old) }
    for added in new_items { updated_all.push(added) }

    // Build a FRESH global_index from the augmented item list. We
    // don't mutate the existing C-side map ptr because
    // `register_macro_decls` may be called multiple times during a
    // single compile (once per @expand splice inside the walker, plus
    // once post-expand from cli/main.av). Re-using the same map ptr
    // would let stale indices from earlier calls leak into the new
    // ResolverState's `canonicals` list and produce OOB lookups.
    //
    // `kind` here is a don't-care: this throwaway list feeds only the
    // name-keyed global index and the declared-canonicals set, neither of
    // which reads kind. The real (path, kind) symbol identities for the
    // spliced decls were already interned by `collect_macro_items` above.
    mut new_items_list: List<ModuleItemEntry> = []
    for it in updated_all {
        let sn = it.short_name
        let canon = it.canonical
        let exp = it.exported
        let k = if it.is_type { SymbolKind.TypeSym } else { SymbolKind.FnSym }
        new_items_list.push(ModuleItemEntry { short_name: sn, canonical: canon, exported: exp, kind: k })
    }
    let new_global_index = global_item_reg_build(new_items_list)

    // Sibling lookup (rewrite_ident step 5) resolves through
    // the TREE's per-module item lists — a module-scoped spliced decl
    // must join its module's node, or a same-module caller of a
    // macro-introduced free fn (`from_bytes_T(...)` beside a
    // `@marshal type T`) can never qualify the reference and dies as
    // F3000 at scope validation. Top-level splices (canonical ==
    // short_name) have no module node and skip.
    mut new_tree = state.tree
    for added in new_items {
        let mod_path = canonical_module_prefix(added.canonical, added.short_name)
        if mod_path != "" {
            new_tree = module_tree_add_item(new_tree, mod_path, ModuleItemEntry {
                short_name: added.short_name,
                canonical: added.canonical,
                exported: added.exported,
                kind: if added.is_type { SymbolKind.TypeSym } else { SymbolKind.FnSym },
            })
        }
    }

    state with {
        tree: new_tree,
        graph: state.graph with { all_items: updated_all },
        global_index: new_global_index,
        declared: declared_canonicals_build(new_items_list),
    }
}

/// The module-path prefix of `canonical` when it qualifies `short`
/// (`"m::sub::f"`/`"f"` → `"m::sub"`), else "" (top-level decl).
fn canonical_module_prefix(canonical: string, short: string) -> string {
    let suffix = "::${short}"
    if canonical.length <= suffix.length { return "" }
    if !canonical.ends_with(suffix) { return "" }
    canonical.substring(0, canonical.length - suffix.length)
}

/// Rebuild the tree with `item` appended to the items of the node at
/// `path` (walking siblings + children). Unchanged when the path has
/// no node.
fn module_tree_add_item(tree: ModuleNode, path: string, item: ModuleItemEntry) -> ModuleNode {
    match tree {
        .End -> ModuleNode.End
        .Node(name, p, items, children, next) -> {
            if p == path {
                mut merged: List<ModuleItemEntry> = []
                for i in items { merged.push(i) }
                merged.push(item)
                ModuleNode.Node(name, p, merged, children, module_tree_add_item(next, path, item))
            } else {
                ModuleNode.Node(name, p, items, module_tree_add_item(children, path, item), module_tree_add_item(next, path, item))
            }
        }
    }
}

/// Collect macro-spliced declarations into `acc` (as `GraphItem`s) and
/// intern their symbols. REUSES the batch collector `collect_item_from_stmt`
/// so a macro-emitted decl registers IDENTICALLY to a hand-written one —
/// `@export` threaded through the `Annotated` wrapper, `Const`/`Impl` handled,
/// `export use` re-exports expanded. One shared collection path means the two
/// registration surfaces cannot drift (fixes t-dg7r; the prior bespoke
/// `collect_macro_item_from_stmt` dropped `@export` and skipped Const/Impl).
fn collect_macro_items(store: NodeStore, ids: List<StmtId>, mod_path: string, acc: List<GraphItem>, symbols: SymbolTable) {
    mut out = acc
    for id in ids {
        // Peel Annotated wrappers for the DISPATCH (an
        // `@deferred_init`-wrapped module — the test assembler's
        // per-file unit shape — must still descend; the wrapper-
        // blindness class), while from_macro provenance stays keyed
        // on the raw row id.
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Module(name, body) -> {
                let inner_path = type_qualified_name(mod_path, name)
                collect_macro_items(store, body, inner_path, out, symbols)
            }
            _ -> {
                if store.is_from_macro(id) {
                    // Batch collector → ModuleItemEntry list (the one shape that
                    // carries `exported` + `kind`), then intern (skips Alias
                    // re-exports and Method — methods intern at rewrite time,
                    // exactly as the top-level walk) and project to GraphItems.
                    mut entries: List<ModuleItemEntry> = []
                    collect_item_from_stmt(store, store.stmts.get(id), mod_path, false, entries)
                    intern_item_symbols(symbols, entries)
                    for e in entries {
                        out.push(GraphItem { short_name: e.short_name, canonical: e.canonical, exported: e.exported, is_type: symbol_kind_is_type(e.kind) })
                    }
                }
            }
        }
    }
}

/// Result of the pre-expand half of name resolution. Holds the
/// rewritten stmts plus the live `ResolverState` so the @expand
/// pipeline can splice macro-emitted decls and re-run `register_decls`
/// over the spliced AST before scope validation runs.
export type PreExpandResolve = {
    stmts: List<StmtId>,
    state: ResolverState,
    had_error: int,
    error_message: string,
}

/// Pre-expand half of `resolve_names`. Runs `register_decls` and
/// `rewrite_uses` but DEFERS scope-validation and unused-import
/// detection to `validate_scopes_after_expand`.
///
/// The pipeline-fix lives here: a `@expand` macro that emits a new
/// top-level decl needs the resolver to register that decl BEFORE
/// scope-validation runs over the call sites that reference it.
/// Splitting the two halves lets `cli/main.av` interleave
/// `expand_macros` between them.
export fn resolve_names_pre_expand(ids: List<StmtId>, store: NodeStore) -> PreExpandResolve {
    let state = register_decls(ids, store)
    let rewritten = rewrite_uses(ids, state)
    let has_errors = bag_has_errors(state.bag)
    PreExpandResolve {
        stmts: rewritten,
        state: state,
        had_error: if has_errors { 1 } else { 0 },
        error_message: if has_errors { "module resolution errors" } else { "" },
    }
}

/// Scope-validation + unused-import detection. Runs over the
/// post-expand stmt list, using the resolver state from the most
/// recent `register_decls` (which is post-expand for macro-bearing
/// programs and identical to pre-expand for macro-free programs).
///
/// Returns a full `NameResolveResult` so call sites can keep their
/// existing bag-handling path unchanged after the split.
export fn validate_scopes_after_expand(ids: List<StmtId>, state: ResolverState) -> NameResolveResult {
    let resolved = resolve_program(ids, state.nodes)
    let used = collect_used_paths_stmt_ids(state.nodes, ids, [])
    let unused_bag = check_unused_imports(state.aliases, used)
    let merged_bag = bag_merge(bag_merge(state.bag, resolved.bag), unused_bag)
    let has_errors = bag_has_errors(merged_bag) || resolved.had_error
    let no_origins: List<MacroFnOrigin> = []
    NameResolveResult {
        stmts: ids,
        had_error: has_errors,
        error_message: if has_errors {
            if resolved.had_error { resolved.error_message } else { "module resolution errors" }
        } else { "" },
        type_reg: state.type_reg,
        bag: merged_bag,
        macro_origins: no_origins,
    }
}

/// Top-level entry: build the module tree, resolve `use` aliases,
/// flatten the global index, rewrite every Ident / type name to its
/// canonical qualified form, then validate scopes and detect unused
/// imports. Composed from `resolve_names_pre_expand` and
/// `validate_scopes_after_expand`; pipelines that interleave
/// `expand_macros` call the halves directly.
export fn resolve_names(ids: List<StmtId>, store: NodeStore) -> NameResolveResult {
    let pre = resolve_names_pre_expand(ids, store)
    validate_scopes_after_expand(pre.stmts, pre.state)
}

// ── Statement rewriting ──

/// Rewrite an expression row: resolve, qualify, re-allocate (fresh
/// row inherits the original's span).
fn rewrite_expr_id(ctx: NameCtx, id: ExprId) -> ExprId {
    ctx.nodes.reexpr(rewrite_expr(ctx, ctx.nodes.exprs.get(id)), id)
}

/// Rewrite a statement row (see `rewrite_expr_id`).
fn rewrite_stmt_id(ctx: NameCtx, id: StmtId) -> StmtId {
    ctx.nodes.restmt(rewrite_stmt(ctx, ctx.nodes.stmts.get(id)), id)
}

/// Rewrite a flipped `List<StmtId>` body, threading the locals a
/// `let`/`mut`/`const`/destructure introduces forward so a later
/// statement's reference to that local is NOT mis-qualified as a
/// same-named module sibling or `use` alias. Without this the qualifier
/// (which checks `scope_has(ctx.locals, name)` first) never saw the
/// binding, so `let x = f(); g(x)` compiled `x` into a reference to a
/// module-level `x` — emitting the closure marker where the value
/// belonged (zo1a). A binding is visible only to the statements that
/// follow it in THIS sequence; a nested block gets its own extended ctx
/// and its locals don't leak back out.
fn rewrite_stmt_ids(ctx: NameCtx, ids: List<StmtId>) -> List<StmtId> {
    mut cur = ctx
    mut out: List<StmtId> = []
    mut i = 0
    while i < ids.length {
        let id = ids[i]
        // Rewrite under the scope as it stands BEFORE this statement's
        // own binding takes effect (`let x = x` reads the outer `x`).
        out.push(rewrite_stmt_id(cur, id))
        cur = bind_stmt_locals(cur, cur.nodes.stmts.get(id))
        i = i + 1
    }
    out
}

/// Extend `ctx.locals` with whatever binding `stmt` introduces, so the
/// statements that follow it in the same sequence see it as a local.
/// Peels `Annotated` wrappers; non-binding statements pass ctx through.
fn bind_stmt_locals(ctx: NameCtx, stmt: Stmt) -> NameCtx {
    match stmt {
        .Let(name, _, _) -> scope_add_local(ctx, name)
        .Mut(name, _, _) -> scope_add_local(ctx, name)
        // A module-top `const` is a module ITEM, not a local — later
        // references qualify through the sibling item lookup (order-
        // independent, exactly like fn items). Fn-body / block consts
        // keep the local-binding behavior.
        .Const(name, _, _) -> if ctx.module_top { ctx } else { scope_add_local(ctx, name) }
        // Destructure names bind at the CURRENT level (no nested scope
        // entered — the siblings that follow must keep module-top
        // status when this list is a module body).
        .LetDestructure(names, _) -> bind_names_ctx(ctx, names)
        .Annotated(_, inner) -> bind_stmt_locals(ctx, ctx.nodes.stmts.get(inner))
        _ -> ctx
    }
}

/// Rewrite a single statement: qualify type names in declarations,
/// register types in the registry, recurse into nested bodies. Each
/// variant gets its own arm.
fn rewrite_stmt(ctx: NameCtx, stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, rewrite_vtype(ctx, vt), rewrite_expr_id(ctx, init))
        .Mut(name, vt, init) -> .Mut(name, rewrite_vtype(ctx, vt), rewrite_expr_id(ctx, init))
        .Expr(e) -> .Expr(rewrite_expr_id(ctx, e))
        .Return(e) -> .Return(rewrite_expr_id(ctx, e))
        .Block(body) -> .Block(rewrite_stmt_ids(ctx_nested_scope(ctx), body))
        .If(cond, then_b, else_b) -> {
            let new_else = if else_b != null { rewrite_stmt_id(ctx, else_b!) } else { null }
            Stmt.If(rewrite_expr_id(ctx, cond), rewrite_stmt_id(ctx, then_b), new_else)
        }
        .While(cond, body) -> .While(rewrite_expr_id(ctx, cond), rewrite_stmt_id(ctx, body))
        // The loop `var` is bound in the body (not in start/end/coll,
        // which are evaluated in the enclosing scope) so a body reference
        // to it isn't mis-qualified as a same-named module sibling.
        .For(var, start, end, body) -> .For(var, rewrite_expr_id(ctx, start), rewrite_expr_id(ctx, end), rewrite_stmt_id(scope_add_local(ctx, var), body))
        .ForIn(var, coll, body) -> .ForIn(var, rewrite_expr_id(ctx, coll), rewrite_stmt_id(scope_add_local(ctx, var), body))
        .Function(name, tp, params, rvt, body) -> {
            let is_impl_method = is_mangled_method(name)
            // Idempotent qualification: skip if already qualified
            // (starts with `@`) — the post-expand resolve pass
            // re-runs rewrite_uses, and already-qualified names from
            // the first pass must not get doubly-prefixed
            // (`@std::crypto::foo` → `@std::crypto::@std::crypto::foo`).
            let already_qualified = (name.length > 0 && name.substring(0, 1) == "@") || name.contains("::")
            let qualified = if ctx.current_module != "" && name != "main" && !is_impl_method && !already_qualified { type_qualified_name(ctx.current_module, name) } else { name }
            let ctx_tp = ctx_with_type_params(ctx, tp)
            let rp = rewrite_param_types(ctx_tp, params)
            Stmt.Function(qualified, tp, rp, rewrite_vtype(ctx_tp, rvt), rewrite_stmt_ids(bind_params_ctx(ctx_tp, rp), body))
        }
        .Match(subject, arms) -> .Match(rewrite_expr_id(ctx, subject), rewrite_match_arms(ctx, arms))
        .Module(name, body) -> {
            let mod_path = type_qualified_name(ctx.current_module, name)
            let mod_uses = resolve_use_aliases_in(ctx.nodes, body, ctx.tree, ctx.graph, mod_path)
            Stmt.Module(name, rewrite_stmt_ids(ctx_with_module(ctx, mod_path, merge_aliases(ctx.aliases, mod_uses.aliases)), body))
        }
        .TypeDecl(name, tp, fields) -> {
            let qn = declared_type_name(ctx, name)
            let rf = rewrite_field_types(ctx_with_type_params(ctx, tp), fields)
            let no_variants: List<Variant> = []
            type_registry_register(ctx.type_reg, qn, TypeKind.StructKind, rf, no_variants, ValueType.Unknown)
            Stmt.TypeDecl(qn, tp, rf)
        }
        .EnumDecl(name, tp, variants) -> {
            let qn = declared_type_name(ctx, name)
            let rv = rewrite_variant_types(ctx_with_type_params(ctx, tp), variants)
            let no_fields: List<FieldEntry> = []
            type_registry_register(ctx.type_reg, qn, TypeKind.EnumKind, no_fields, rv, ValueType.Unknown)
            Stmt.EnumDecl(qn, tp, rv)
        }
        .TraitDecl(name, body) -> {
            let qn = declared_type_name(ctx, name)
            let no_variants: List<Variant> = []
            let no_fields: List<FieldEntry> = []
            type_registry_register(ctx.type_reg, qn, TypeKind.TraitKind, no_fields, no_variants, ValueType.Unknown)
            // Rewrite the body's method signatures so each method's
            // params/ret_ty pick up the surrounding module's qualifier.
            // Without this, `fn cause(self) -> EctError` inside
            // `Module(test) { trait EctError { ... } }` keeps EctError
            // bare, so the codegen-side lookup of `c.message()` (where
            // `c = e.cause()`) misses the qualified trait registration
            // and falls through to the type-name dispatch
            // (forge-crafting-intepreters-q3gp).
            Stmt.TraitDecl(qn, rewrite_stmt_ids(ctx_nested_scope(ctx), body))
        }
        .ShapeDecl(name, fields) -> {
            let qn = declared_type_name(ctx, name)
            let rf = rewrite_field_types(ctx, fields)
            let no_variants: List<Variant> = []
            type_registry_register(ctx.type_reg, qn, TypeKind.ShapeKind, rf, no_variants, ValueType.Unknown)
            Stmt.ShapeDecl(qn, rf)
        }
        .NewtypeDecl(name, inner) -> {
            let qn = declared_type_name(ctx, name)
            let ri = rewrite_vtype(ctx, inner)
            let no_variants: List<Variant> = []
            let no_fields: List<FieldEntry> = []
            type_registry_register(ctx.type_reg, qn, TypeKind.NewtypeKind, no_fields, no_variants, ri)
            Stmt.NewtypeDecl(qn, ri)
        }
        .Impl(type_name, methods) -> rewrite_impl_stmt(ctx, type_name, methods)
        // Rewrite annotation args too — names referenced inside
        // `@expand(derive_walker)`, `@derive(Foo)` etc. need to get
        // qualified the same way regular Idents do, otherwise
        // cross-module @comptime fns are unreachable from the
        // @expand pass (the registry keys them under the qualified
        // path; the lookup uses whatever's in the annotation arg).
        .Annotated(annotations, inner) -> .Annotated(rewrite_annotations(ctx, annotations), rewrite_stmt_id(ctx, inner))
        .Defer(body) -> .Defer(rewrite_expr_id(ctx, body))
        .Errdefer(body) -> .Errdefer(rewrite_expr_id(ctx, body))
        .LetDestructure(names, init) -> .LetDestructure(names, rewrite_expr_id(ctx, init))
        .ExternFn(name, params, rvt) -> .ExternFn(name, rewrite_param_types(ctx, params), rewrite_vtype(ctx, rvt))
        .SpecBlock(name, body) -> .SpecBlock(name, rewrite_stmt_ids(ctx_nested_scope(ctx), body))
        .GivenBlock(name, body) -> .GivenBlock(name, rewrite_stmt_ids(ctx_nested_scope(ctx), body))
        .ThenBlock(name, cond) -> .ThenBlock(name, rewrite_expr_id(ctx, cond))
        .Parallel(body) -> .Parallel(rewrite_stmt_ids(ctx_nested_scope(ctx), body))
        .Select(arms) -> .Select(rewrite_select_arms(ctx, arms))
        // A module-top `const` is a module ITEM — qualify its declared
        // name like fn / type declarations so each module's consts get
        // their own LLVM global. Without this, same-named consts from
        // sibling modules (batched test files) collapsed into one flat
        // global and silently read each other's value. Fn-body / block
        // consts (module_top cleared) keep their local names.
        .Const(name, vt, init) -> {
            let qn = if ctx.module_top { declared_type_name(ctx, name) } else { name }
            Stmt.Const(qn, rewrite_vtype(ctx, vt), rewrite_expr_id(ctx, init))
        }
        .UnionAliasDecl(name, vt) -> {
            let qn = declared_type_name(ctx, name)
            let rvt = rewrite_vtype(ctx, vt)
            let no_variants: List<Variant> = []
            let no_fields: List<FieldEntry> = []
            type_registry_register(ctx.type_reg, qn, TypeKind.NewtypeKind, no_fields, no_variants, rvt)
            Stmt.UnionAliasDecl(qn, rvt)
        }
        _ -> stmt
    }
}

/// Rewrite each arm of a `select { ... }` block — the channel
/// expression and the body are both walked.
fn rewrite_select_arms(ctx: NameCtx, arms: List<SelectArm>) -> List<SelectArm> {
    mut out: List<SelectArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        // Bind the received value so refs to it inside the body aren't
        // mis-qualified as module-level (mirrors Catch/Lambda). The channel
        // expression is rewritten in the OUTER ctx — it precedes the binding.
        let body_params: List<ParamEntry> = if arm.binding == "" { [] } else { [ParamEntry { name: arm.binding, vtype: ValueType.Unknown }] }
        let body_ctx = bind_params_ctx(ctx, body_params)
        out.push(SelectArm {
            binding: arm.binding,
            chan_id: rewrite_expr_id(ctx, arm.chan_id),
            body_ids: rewrite_stmt_ids(body_ctx, arm.body_ids),
        })
        i = i + 1
    }
    out
}

/// Rewrite an `Impl` statement — qualify the type name (and the
/// trait name when this is `impl Trait for Type`), then walk every
/// method to mangle its name into `Type__method` form.
fn rewrite_impl_stmt(ctx: NameCtx, type_name: string, methods: List<StmtId>) -> Stmt {
    // Trait impl: "TraitName:TypeName" — qualify both parts separately
    let sep = find_single_colon(type_name)
    if sep >= 0 {
        let trait_part = type_name.substring(0, sep)
        let type_part = type_name.substring(sep + 1, type_name.length)
        let rt = resolve_type_in_ctx(ctx, trait_part)
        let tt = resolve_type_in_ctx(ctx, type_part)
        // cpvo: a `impl Trait for Foo<T>` impl's methods reference Foo's `<T>`,
        // dropped by the parser — recover it so `T` stays bare (see below).
        let impl_ctx = ctx_with_type_params(ctx, type_decl_tp_lookup(ctx.type_decl_tps, tt, type_part))
        Stmt.Impl(trait_impl_name(rt, tt), rewrite_impl_methods(impl_ctx, tt, methods))
    } else {
        let rt = resolve_type_in_ctx(ctx, type_name)
        // cpvo: the impl parser discards `impl Foo<T>`'s `<T>`. Recover Foo's
        // declared type-params and put them in scope so a method returning the
        // struct's param `T` keeps `T` bare (matching the struct field's bare
        // `T`) instead of qualifying it to a phantom `mod::T`.
        let impl_ctx = ctx_with_type_params(ctx, type_decl_tp_lookup(ctx.type_decl_tps, rt, type_name))
        Stmt.Impl(rt, rewrite_impl_methods(impl_ctx, rt, methods))
    }
}

// Find single colon (trait:type separator) that isn't part of ::
/// Find a standalone `:` (trait/type separator) that isn't part of
/// `::`. Returns -1 when absent. Used by `rewrite_impl_stmt` to
/// split `"Trait:Type"` into its two halves.
fn find_single_colon(s: string) -> int {
    mut i = 0
    while i < s.length {
        if s[i] == ":" {
            if i + 1 < s.length && s[i + 1] == ":" {
                i = i + 2
                continue
            }
            return i
        }
        i = i + 1
    }
    -1
}

/// Qualify a type name at its DECLARATION site. Unlike
/// `resolve_type_in_ctx` (which qualifies REFERENCES and falls
/// back to the global index when a name isn't locally defined),
/// a declaration unambiguously belongs to the surrounding module.
/// Going through the global index here let imported types from
/// other packages steal the canonical name (e.g. metadata.av's
/// `type BytesReader` ended up registered as
/// `@std::process::BytesReader` when both were in scope, causing
/// duplicate-symbol FATALs at codegen — yx7b).
fn declared_type_name(ctx: NameCtx, name: string) -> string {
    if name.contains("::") { return name }
    if ctx.current_module != "" {
        return type_qualified_name(ctx.current_module, name)
    }
    name
}

/// Qualify a bare type name to its canonical path. Tries (in order):
/// already-qualified pass-through, primitives + single-uppercase
/// type params, the current module (when it declares the type),
/// the global index, the alias table, and finally the current
/// module path as a default. The current-module check comes BEFORE
/// the global index so a locally-declared type shadows an
/// identically-named import — without this, an impl block in a
/// module that shadows a name from another imported package
/// gets its methods mangled with the OTHER package's prefix,
/// producing FATAL duplicate-symbol collisions at codegen (yx7b).
fn resolve_type_in_ctx(ctx: NameCtx, type_name: string) -> string {
    if type_name.contains("::") { return type_name }
    // Primitives stay as-is.
    if type_name in ["int", "string", "bool", "float", "ptr", "void"] { return type_name }
    // cpvo: a type-param in scope shadows any same-named type and stays bare
    // (typeck binds it). Replaces the brittle single-uppercase-letter heuristic
    // that conflated a param `T` with a user type also named `T`.
    if type_param_has(ctx.type_params, type_name) { return type_name }
    if ctx.current_module != "" {
        let local_qn = type_qualified_name(ctx.current_module, type_name)
        // Two probes: the registry catches types the walk (or a macro
        // splice) already registered; the declared-canonicals set catches
        // the module's OWN not-yet-registered decls — the registry fills
        // lazily during this very walk, so a self-recursive enum field or a
        // forward reference to a later sibling would otherwise miss here
        // and fall through to the first-write-wins global index (wrong
        // module under batched compilation).
        if type_registry_id_for(ctx.type_reg, local_qn) != 0 || avra_map_has_cstr(ctx.declared, local_qn) == 1 {
            return local_qn
        }
    }
    // An explicit `use` import (alias) is authoritative for THIS file, so it must
    // win over the global item index — a flat, first-write-wins simple-name map
    // shared across every module in the compilation unit. Without this ordering,
    // two sibling modules that each own a same-named type (e.g. one imports core's
    // `NodeRef` enum, another declares a file-local `type NodeRef = int`) collide
    // in the global index; whichever registered first claims the slot and shadows
    // the other file's reference, mis-qualifying it to the wrong module. Consulting
    // the file's own import first mirrors value-identifier resolution
    // (`rewrite_ident`), which is already import-first with no global fallback.
    let alias = alias_lookup(ctx.aliases, type_name)
    if alias != "" { return alias }
    let canonical = global_item_lookup(ctx.global_index, type_name)
    if canonical != "" { return canonical }
    if ctx.current_module != "" {
        return type_qualified_name(ctx.current_module, type_name)
    }
    type_name
}

// ── ValueType + param rewriting ──
// Qualify all type names inside ValueType, `List<ParamEntry>`, and
// the `List<ValueType>` payloads on ValueType variants. After this pass,
// every Struct/Enum/Trait/Newtype name is fully qualified.

/// Qualify every type name inside a ValueType. Recurses into
/// compound shapes (List, Union, Tuple, FnTyped, ...).
fn rewrite_vtype(ctx: NameCtx, vt: ValueType) -> ValueType {
    match vt {
        .Struct(name, args, _) if name != "" -> {
            // qa6i probe 3: a `~ident` splice in type position lowers
            // to ValueType.Struct(spliced_name, 0). The spliced name
            // may be a primitive ("int", "string", ...) — re-run
            // through vtype_from_name so it lands in the right
            // ValueType variant rather than staying as Struct.
            let builtin = vtype_from_name(name)
            match builtin {
                .Struct(_, _, _) -> {
                    // A type-param in scope stays bare AND unstamped (id 0).
                    // resolve_type_in_ctx already keeps the NAME bare (cpvo),
                    // but the id stamp below consults the registry by that
                    // bare name — and a top-level user type sharing the
                    // param's name (`enum T` registers canonical "T") would
                    // stamp the param slot with the CONCRETE type's id,
                    // turning every generic signature mentioning `T` in the
                    // whole unit concrete (mass F1000 layout conflicts).
                    if type_param_has(ctx.type_params, name) {
                        return ValueType.Struct(name, rewrite_vtype_list(ctx, args), 0)
                    }
                    // Genuinely a struct name; resolve through aliases.
                    let qn = resolve_type_in_ctx(ctx, name)
                    ValueType.Struct(qn, rewrite_vtype_list(ctx, args), type_registry_id_for(ctx.type_reg, qn))
                }
                _ -> builtin
            }
        }
        .Enum(name, args, _) if name != "" -> {
            // Same type-param guard as the Struct arm — an inferred/narrowed
            // slot can carry a param under the Enum kind.
            if type_param_has(ctx.type_params, name) {
                return ValueType.Enum(name, rewrite_vtype_list(ctx, args), 0)
            }
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Enum(qn, rewrite_vtype_list(ctx, args), type_registry_id_for(ctx.type_reg, qn))
        }
        .Trait(name, _) if name != "" -> {
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Trait(qn, type_registry_id_for(ctx.type_reg, qn))
        }
        .Newtype(name, inner, _) if name != "" -> {
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Newtype(qn, rewrite_vtype(ctx, inner), type_registry_id_for(ctx.type_reg, qn))
        }
        .NarrowedEnum(en, v, _) if en != "" -> {
            let qn = resolve_type_in_ctx(ctx, en)
            ValueType.NarrowedEnum(qn, v, type_registry_id_for(ctx.type_reg, qn))
        }
        .List(elem) -> .List(rewrite_vtype(ctx, elem))
        .Channel(elem) -> .Channel(rewrite_vtype(ctx, elem))
        .Fn(ret) -> .Fn(rewrite_vtype(ctx, ret))
        .FnTyped(params, ret) -> .FnTyped(rewrite_vtype_list(ctx, params), rewrite_vtype(ctx, ret))
        .Closure(n, ret) -> .Closure(n, rewrite_vtype(ctx, ret))
        .Union(types) -> .Union(rewrite_vtype_list(ctx, types))
        .Task(rt) -> .Task(rewrite_vtype(ctx, rt))
        .Optional(inner) -> .Optional(rewrite_vtype(ctx, inner))
        // Tuple inner types need qualifying too — otherwise a fn
        // returning `(int, MyType)` keeps `MyType` bare, and methods
        // dispatched on a destructured tuple element fail with
        // `undefined method <bare>::method` because the registry
        // stores them under the qualified prefix.
        .Tuple(types) -> .Tuple(rewrite_vtype_list(ctx, types))
        _ -> vt
    }
}

/// Map `rewrite_vtype` over each ValueType in a `List<ValueType>`.
fn rewrite_vtype_list(ctx: NameCtx, tl: List<ValueType>) -> List<ValueType> {
    mut out: List<ValueType> = []
    mut i = 0
    while i < tl.length {
        out.push(rewrite_vtype(ctx, tl[i]))
        i = i + 1
    }
    out
}

/// Map `rewrite_vtype` over each FieldEntry's resolved type.
fn rewrite_field_types(ctx: NameCtx, fields: List<FieldEntry>) -> List<FieldEntry> {
    mut out: List<FieldEntry> = []
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        out.push(FieldEntry { name: e.name, resolved: rewrite_vtype(ctx, e.resolved) })
        i = i + 1
    }
    out
}

/// Map `rewrite_field_types` over each variant's payload list.
fn rewrite_variant_types(ctx: NameCtx, variants: List<Variant>) -> List<Variant> {
    mut out: List<Variant> = []
    mut i = 0
    while i < variants.length {
        let v = variants[i]
        out.push(Variant { name: v.name, fields: rewrite_field_types(ctx, v.fields) })
        i = i + 1
    }
    out
}

/// Map `rewrite_vtype` over each `ParamEntry`'s declared type.
fn rewrite_param_types(ctx: NameCtx, params: List<ParamEntry>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        let p = params[i]
        out.push(ParamEntry { name: p.name, vtype: rewrite_vtype(ctx, p.vtype) })
        i = i + 1
    }
    out
}

/// Replace the `self` parameter's bare type with the impl's
/// qualified type name. Other params pass through unchanged.
fn qualify_self_param(ctx: NameCtx, params: List<ParamEntry>, qualified_type: string) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        let p = params[i]
        if p.name == "self" {
            let tid = type_registry_id_for(ctx.type_reg, qualified_type)
            out.push(ParamEntry { name: "self", vtype: vtype_struct(qualified_type, tid) })
        } else {
            out.push(p)
        }
        i = i + 1
    }
    out
}

/// Walk the methods of an impl block, mangling each fn name into
/// `Type__method` and qualifying its self / param / return types.
/// Peels `Annotated` wrappers (doc comments, @export, etc.) so a
/// `/// docstring` on an impl method doesn't hide the Function from
/// the impl-method mangling — without this, doc-commented impl
/// methods kept the bare `Type__method` name and call sites looking
/// up the prefixed `@module::Type__method` failed to dispatch
/// (vez6.7.4).
fn rewrite_impl_methods(ctx: NameCtx, qualified_type: string, methods: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    mut i = 0
    while i < methods.length {
        let id = methods[i]
        let new_stmt = rewrite_impl_method_stmt(ctx, qualified_type, ctx.nodes.stmts.get(id))
        out.push(ctx.nodes.restmt(new_stmt, id))
        i = i + 1
    }
    out
}

/// Per-statement worker for rewrite_impl_methods. Recurses through
/// `Annotated` so doc-commented or annotated impl methods get the
/// same mangling as bare ones.
fn rewrite_impl_method_stmt(ctx: NameCtx, qualified_type: string, stmt: Stmt) -> Stmt {
    match stmt {
        .Function(name, tp, params, rvt, body) -> {
            let mn = method_from_mangled(name)
            let qualified_name = method_mangled_name(qualified_type, mn)
            // Intern the method's symbol identity HERE — the one place the
            // impl target has resolved to its qualified name, so
            // `a::Foo__run` and `b::Foo__run` are distinct symbols
            // (collect-time skips MethodSym; see intern_item_symbols).
            let _ = ctx.symbols.intern(qualified_name, SymbolKind.MethodSym, true)
            let ctx_tp = ctx_with_type_params(ctx, tp)
            let rp = rewrite_param_types(ctx_tp, qualify_self_param(ctx_tp, params, qualified_type))
            Stmt.Function(qualified_name, tp, rp, rewrite_vtype(ctx_tp, rvt), rewrite_stmt_ids(bind_params_ctx(ctx_tp, rp), body))
        }
        .Annotated(annots, inner) -> .Annotated(annots, ctx.nodes.restmt(rewrite_impl_method_stmt(ctx, qualified_type, ctx.nodes.stmts.get(inner)), inner))
        _ -> rewrite_stmt(ctx, stmt)
    }
}

// ── Expression rewriting ──

/// Rewrite an expression, qualifying name references to their
/// canonical paths and recursing into sub-expressions.
fn rewrite_expr(ctx: NameCtx, expr: Expr) -> Expr {
    if expr == null { return Expr.None }
    match expr {
        .Ident(name) -> rewrite_ident(ctx, name, expr)
        .Call(callee, args) -> {
            // Qualify uppercase callee in Call context (newtype constructors)
            let callee_node = ctx.nodes.exprs.get(callee)
            let rewritten_callee = match callee_node {
                .Ident(name) if name.length > 0 && name[0] in "A".."Z" -> {
                    let resolved = resolve_type_in_ctx(ctx, name)
                    if resolved != name { Expr.QualifiedIdent(resolved) } else { rewrite_ident(ctx, name, callee_node) }
                }
                _ -> rewrite_expr(ctx, callee_node)
            }
            Expr.Call(ctx.nodes.reexpr(rewritten_callee, callee), rewrite_expr_list_ids(ctx, args))
        }
        .GenericCall(callee, ta, args) -> .GenericCall(rewrite_expr_id(ctx, callee), ta, rewrite_expr_list_ids(ctx, args))
        .Binary(l, op, r) -> .Binary(rewrite_expr_id(ctx, l), op, rewrite_expr_id(ctx, r))
        .Unary(op, r) -> .Unary(op, rewrite_expr_id(ctx, r))
        .Logical(l, op, r) -> .Logical(rewrite_expr_id(ctx, l), op, rewrite_expr_id(ctx, r))
        .Grouping(inner) -> .Grouping(rewrite_expr_id(ctx, inner))
        .Assign(name, val) -> .Assign(name, rewrite_expr_id(ctx, val))
        .Index(obj, idx) -> .Index(rewrite_expr_id(ctx, obj), rewrite_expr_id(ctx, idx))
        .Try(inner) -> .Try(rewrite_expr_id(ctx, inner))
        .Block(body) -> .Block(rewrite_stmt_ids(ctx_nested_scope(ctx), body))
        _ -> rewrite_expr_compound(ctx, expr)
    }
}

/// Tail of `rewrite_expr` — handles the long list of compound /
/// less-frequently-traversed Expr variants (StructLit, Lambda,
/// Match, ListComp, etc.).
fn rewrite_expr_compound(ctx: NameCtx, expr: Expr) -> Expr {
    if expr == null { return Expr.None }
    match expr {
        .FieldAccess(obj, field) -> {
            // Qualify uppercase Ident in FieldAccess (enum constructors: ValueType.Unknown)
            let obj_node = ctx.nodes.exprs.get(obj)
            let rewritten_obj = match obj_node {
                .Ident(name) if name.length > 0 && name[0] in "A".."Z" -> {
                    let resolved = resolve_type_in_ctx(ctx, name)
                    if resolved != name { Expr.QualifiedIdent(resolved) } else { rewrite_ident(ctx, name, obj_node) }
                }
                _ -> rewrite_expr(ctx, obj_node)
            }
            Expr.FieldAccess(ctx.nodes.reexpr(rewritten_obj, obj), field)
        }
        .FieldAssign(obj, field, val) -> .FieldAssign(rewrite_expr_id(ctx, obj), field, rewrite_expr_id(ctx, val))
        .IfExpr(c, t, e) -> .IfExpr(rewrite_expr_id(ctx, c), rewrite_expr_id(ctx, t), rewrite_expr_id(ctx, e))
        .NullCoalesce(l, r) -> .NullCoalesce(rewrite_expr_id(ctx, l), rewrite_expr_id(ctx, r))
        .OptionalChain(obj, field) -> .OptionalChain(rewrite_expr_id(ctx, obj), field)
        .OptionalMethodCall(obj, method, args) -> .OptionalMethodCall(rewrite_expr_id(ctx, obj), method, rewrite_expr_list_ids(ctx, args))
        .Tuple(elems) -> .Tuple(rewrite_expr_list_ids(ctx, elems))
        .TupleIndex(obj, idx) -> .TupleIndex(rewrite_expr_id(ctx, obj), idx)
        .ListLit(elems) -> .ListLit(rewrite_expr_list_ids(ctx, elems))
        .MapLit(entries) -> .MapLit(rewrite_expr_list_ids(ctx, entries))
        .Slice(obj, s, e) -> .Slice(rewrite_expr_id(ctx, obj), rewrite_expr_id(ctx, s), rewrite_expr_id(ctx, e))
        .With(obj, overrides) -> .With(rewrite_expr_id(ctx, obj), rewrite_field_inits(ctx, overrides))
        .StructLit(name, inits) -> {
            let qn = if name != "" { resolve_type_in_ctx(ctx, name) } else { name }
            Expr.StructLit(qn, rewrite_field_inits(ctx, inits))
        }
        .EnumCtor(type_name, variant, args) -> {
            let qt = if type_name != "" { resolve_type_in_ctx(ctx, type_name) } else { type_name }
            Expr.EnumCtor(qt, variant, rewrite_expr_list_ids(ctx, args))
        }
        .MatchExpr(subject, arms) -> .MatchExpr(rewrite_expr_id(ctx, subject), rewrite_match_arms(ctx, arms))
        .Lambda(params, body) -> {
            // Qualify the closure's PARAM type annotations (a generic instance
            // `Box<int>` -> `mymod::Box<int>`) exactly as a fn decl's params are,
            // then bind the qualified params into the body scope. Without this a
            // method/field on the param later resolves against the un-qualified
            // name and mono can't find the instance (the closure-receiver gap).
            let rp = rewrite_param_types(ctx, params)
            Expr.Lambda(rp, rewrite_expr_id(bind_params_ctx(ctx, rp), body))
        }
        .ListComp(body, var, coll, filter) -> {
            // Collection sees the outer scope; body+filter see `var` bound.
            // Without binding, an Ident matching `var` could be wrongly
            // qualified to a module-level identifier of the same name.
            let comp_params: List<ParamEntry> = [ParamEntry { name: var, vtype: ValueType.Unknown }]
            let inner = bind_params_ctx(ctx, comp_params)
            let new_filter = if filter != null { rewrite_expr_id(inner, filter!) } else { null }
            Expr.ListComp(rewrite_expr_id(inner, body), var, rewrite_expr_id(ctx, coll), new_filter)
        }
        .Spawn(body) -> .Spawn(rewrite_expr_id(ctx, body))
        .ChannelNew(elem, capacity) -> {
            // The element type is embedded in the expression — qualify
            // nominal names exactly like Let/Mut annotations do, so
            // `channel<Foo>(1)` inside a module resolves Foo to its
            // module-qualified registry name.
            let qelem = rewrite_vtype(ctx, elem)
            if capacity == null { Expr.ChannelNew(qelem, null) } else { .ChannelNew(qelem, rewrite_expr_id(ctx, capacity!)) }
        }
        .Isolated(body) -> .Isolated(rewrite_expr_id(ctx, body))
        .IsCheck(subject, variant) -> .IsCheck(rewrite_expr_id(ctx, subject), variant)
        .InCheck(needle, items) -> .InCheck(rewrite_expr_id(ctx, needle), rewrite_expr_list_ids(ctx, items))
        .When(arms) -> .When(rewrite_when_arms(ctx, arms))
        // Catch / Quote / Splice had no arms — identifiers inside
        // their bodies stayed un-rewritten (raw `helper` Idents instead
        // of `QualifiedIdent("@pkg::mod::helper")`). Same root cause as
        // the desugar / mono / escape / closure walker bugs.
        .Catch(inner, binding, body, line, col) -> {
            // The `binding` introduces an error name visible only in
            // body. Bind it so refs to it inside body don't get
            // mis-qualified as module-level.
            let body_params: List<ParamEntry> = if binding == "" { [] } else { [ParamEntry { name: binding, vtype: ValueType.Unknown }] }
            let body_ctx = bind_params_ctx(ctx, body_params)
            Expr.Catch(rewrite_expr_id(ctx, inner), binding, rewrite_expr_id(body_ctx, body), line, col)
        }
        .Quote(kind, body) -> Expr.Quote(kind, rewrite_expr_id(ctx, body))
        .Splice(target) -> Expr.Splice(rewrite_expr_id(ctx, target))
        _ -> expr
    }
}

/// Rewrite `Expr.Ident(name)` — keep it as Ident when the name is
/// in local scope or a builtin; otherwise replace with
/// `QualifiedIdent(canonical_path)` resolved against the alias
/// table or global index.
fn rewrite_ident(ctx: NameCtx, name: string, original: Expr) -> Expr {
    // 1. Local variable — don't rewrite
    if scope_has(ctx.locals, name) { return original }
    // 2. Builtin function — don't rewrite
    if is_builtin_name(name) { return original }
    // 3. Uppercase — usually a type/enum name, left bare for codegen
    //    (StructLit/EnumCtor handled separately). The exception is a
    //    SCREAMING_SNAKE module const: a module ITEM whose declaration
    //    is qualified, so its references must qualify too (current-
    //    module sibling first, then `use` alias — see resolve_const_ref).
    if name.length > 0 && name[0] in "A".."Z" {
        let const_canonical = resolve_const_ref(ctx, name)
        if const_canonical != "" { return Expr.QualifiedIdent(const_canonical) }
        return original
    }
    // 4. Use alias (from `use path.{name}`)
    let from_alias = alias_lookup(ctx.aliases, name)
    if from_alias != "" { return Expr.QualifiedIdent(from_alias) }
    // 5. Sibling in current module
    if ctx.current_module != "" {
        let mod_node = module_find(ctx.tree, ctx.current_module)
        let from_sibling = match mod_node {
            .End -> ""
            .Node(_, _, items, _, _) -> item_lookup(items, name)
        }
        if from_sibling != "" { return Expr.QualifiedIdent(from_sibling) }
    }
    // No global fallback. Names must be imported via `use` or defined
    // in the current module. Unresolved names stay as Expr.Ident.
    original
}

/// Resolve an UPPERCASE identifier to a module-level const's canonical
/// path — a sibling of the current module first, then a `use` alias —
/// returning "" when the name doesn't refer to a known const. Type /
/// enum names (the other uppercase idents) fall through to "" because
/// only Const declarations populate the const index; no global
/// fallback, mirroring `rewrite_ident`'s lowercase path.
///
/// Sibling-before-alias mirrors `resolve_type_in_ctx`'s current-
/// module-first rule (yx7b): the entry file's `use` aliases are merged
/// into every module's ctx, so alias-first would let a ROOT import of
/// `mod_a.{X}` hijack `mod_b`'s reference to its OWN const `X`.
fn resolve_const_ref(ctx: NameCtx, name: string) -> string {
    if ctx.current_module != "" {
        let mod_node = module_find(ctx.tree, ctx.current_module)
        let from_sibling = match mod_node {
            .End -> ""
            .Node(_, _, items, _, _) -> item_lookup(items, name)
        }
        if from_sibling != "" && const_index_has(ctx.const_index, from_sibling) { return from_sibling }
    }
    let from_alias = alias_lookup(ctx.aliases, name)
    if from_alias != "" && const_index_has(ctx.const_index, from_alias) { return from_alias }
    ""
}

/// Map `rewrite_expr` over a flipped `List<ExprId>` (call args); rewrites
/// each arg row in place via reexpr.
fn rewrite_expr_list_ids(ctx: NameCtx, ids: List<ExprId>) -> List<ExprId> {
    mut out: List<ExprId> = []
    mut i = 0
    while i < ids.length {
        let id = ids[i]
        out.push(ctx.nodes.reexpr(rewrite_expr(ctx, ctx.nodes.exprs.get(id)), id))
        i = i + 1
    }
    out
}

/// Rewrite each annotation's arg list. Same shape as
/// `rewrite_expr_list` (the args are SExprs), but applied per-
/// annotation so the annotation name + cardinality are preserved.
/// Drives qualified-name resolution for `@expand(macro_name)`,
/// `@derive(Foo)` and any future name-referencing annotation.
fn rewrite_annotations(ctx: NameCtx, annots: List<Annotation>) -> List<Annotation> {
    mut out: List<Annotation> = []
    mut i = 0
    while i < annots.length {
        let a = annots[i]
        // B-final F4d: annotation args are arena-only — rewrite each arg id
        // through the id twin (rewrite_expr_id) so it carries resolved content.
        out.push(Annotation {
            name: a.name,
            arg_ids: rewrite_annotation_arg_ids(ctx, a.arg_ids),
        })
        i = i + 1
    }
    out
}

/// Rewrite each id in an annotation's nullable arg_ids row via the
/// `rewrite_expr_id` id twin; null (no row) passes through unchanged.
fn rewrite_annotation_arg_ids(ctx: NameCtx, ids: List<ExprId>?) -> List<ExprId>? {
    if ids == none { return none }
    mut out: List<ExprId> = []
    for id in ids! { out.push(rewrite_expr_id(ctx, id)) }
    out
}

/// Walk a `Foo { f: v, ... }` initializer list, rewriting each
/// value expression but leaving field names verbatim.
fn rewrite_field_inits(ctx: NameCtx, inits: List<FieldInit>) -> List<FieldInit> {
    mut out: List<FieldInit> = []
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        out.push(FieldInit { name: init.name, value_id: rewrite_expr_id(ctx, init.value_id) })
        i = i + 1
    }
    out
}

/// Walk a `List<MatchArm>`, binding pattern captures into the local
/// scope before rewriting each arm body.
fn rewrite_match_arms(ctx: NameCtx, arms: List<MatchArm>) -> List<MatchArm> {
    mut out: List<MatchArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let rp = rewrite_pattern(ctx, arm.pattern)
        let arm_ctx = bind_pattern_ctx(ctx, rp)
        let new_guard_id = if arm.guard_id != null {
            rewrite_expr_id(arm_ctx, arm.guard_id!)
        } else { null }
        // Pattern is rewritten to `rp`, so `pattern_id` must track the NEW
        // pattern — preserving the pre-resolve id would mis-point the dual.
        out.push(MatchArm { pattern: rp, pattern_id: ctx.nodes.pats.add_leaf(rp), guard_id: new_guard_id, body_id: rewrite_expr_id(arm_ctx, arm.body_id) })
        i = i + 1
    }
    out
}

// Qualify type names inside match patterns
/// True for `int`, `string`, `bool`, `ptr`, `void`, `float` —
/// the names that should never be qualified.
fn is_primitive_type(name: string) -> bool {
    name in ["int", "string", "bool", "float", "ptr", "void"]
}

/// Qualify type names inside a Pattern (TypePattern's `type_name`,
/// nested variant payloads). Bindings stay verbatim.
fn rewrite_pattern(ctx: NameCtx, pattern: Pattern) -> Pattern {
    match pattern {
        // The only node carrying a name to resolve. No Pattern children,
        // so it's a pure leaf transform.
        .TypePattern(type_name, binding) -> {
            if is_primitive_type(type_name) { return pattern }
            let resolved = resolve_type_in_ctx(ctx, type_name)
            Pattern.TypePattern(resolved, binding)
        }
        // Id-payload variants (F2): children are arena rows the derived
        // Pattern.map cannot see — resolve, rewrite, and re-allocate (a
        // rewritten sub-pattern is a NEW tree; transforms allocate).
        // Today's surface can't nest a TypePattern here (nested mode gates
        // on `.`, union matches reject `or` arms), so this is defensive —
        // it becomes load-bearing the day either gate opens.
        .NestedVariant(name, sub_patterns) -> {
            let rewritten = list_map(sub_patterns, (pid: PatId) ->
                ctx.nodes.pats.add_leaf(rewrite_pattern(ctx, ctx.nodes.pats.get(pid))))
            Pattern.NestedVariant(name, rewritten)
        }
        .Or(left, right) -> Pattern.Or(
            ctx.nodes.pats.add_leaf(rewrite_pattern(ctx, ctx.nodes.pats.get(left))),
            ctx.nodes.pats.add_leaf(rewrite_pattern(ctx, ctx.nodes.pats.get(right))))
        // The remaining variants carry no Pattern children and no resolvable
        // names — leaf transforms.
        _ -> pattern.map((p: Pattern) -> rewrite_pattern(ctx, p))
    }
}

/// Walk a `when` arm list, rewriting each arm's cond + body.
fn rewrite_when_arms(ctx: NameCtx, arms: List<WhenArm>) -> List<WhenArm> {
    mut out: List<WhenArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let new_cond_id = if arm.cond_id == null { null } else { rewrite_expr_id(ctx, arm.cond_id!) }
        out.push(WhenArm {
            cond_id: new_cond_id,
            body_id: rewrite_expr_id(ctx, arm.body_id),
        })
        i = i + 1
    }
    out
}

// ── Unused import detection ──
// After the rewrite pass, collect all QualifiedIdent canonical paths
// from the rewritten AST, then check each use-imported alias against
// the used set. Emit warnings for imports that were never referenced.

/// Membership probe for the used-path list — backs the
/// unused-import detection. The list is a multiset of canonical
/// paths the rewrite pass emitted as QualifiedIdent (plus
/// PascalCase Idents); duplicates are fine since this is only
/// queried for "ever used at all" containment.
fn used_has(set: List<string>, path: string) -> bool {
    list_any(set, (s: string) -> s == path)
}

// Collect all QualifiedIdent paths from the rewritten AST.
/// Per-stmt branch of `collect_used_paths_stmt_ids`.
fn collect_used_paths_stmt(store: NodeStore, stmt: Stmt, acc: List<string>) -> List<string> {
    match stmt {
        .Expr(e) -> collect_used_paths_expr(store, store.exprs.get(e), acc)
        .Let(_, _, init) -> collect_used_paths_expr(store, store.exprs.get(init), acc)
        .Mut(_, _, init) -> collect_used_paths_expr(store, store.exprs.get(init), acc)
        .Const(_, _, init) -> collect_used_paths_expr(store, store.exprs.get(init), acc)
        .Return(e) -> collect_used_paths_expr(store, store.exprs.get(e), acc)
        .Block(body) -> collect_used_paths_stmt_ids(store, body, acc)
        .Function(_, _, _, _, body) -> collect_used_paths_stmt_ids(store, body, acc)
        .If(cond, then_b, else_b) -> {
            let a = collect_used_paths_expr(store, store.exprs.get(cond), acc)
            let b = collect_used_paths_stmt(store, store.stmts.get(then_b), a)
            if else_b != null { collect_used_paths_stmt(store, store.stmts.get(else_b!), b) } else { b }
        }
        .While(cond, body) -> collect_used_paths_stmt(store, store.stmts.get(body), collect_used_paths_expr(store, store.exprs.get(cond), acc))
        .For(_, start, end, body) -> {
            let a = collect_used_paths_expr(store, store.exprs.get(start), acc)
            let b = collect_used_paths_expr(store, store.exprs.get(end), a)
            collect_used_paths_stmt(store, store.stmts.get(body), b)
        }
        .ForIn(_, coll, body) -> collect_used_paths_stmt(store, store.stmts.get(body), collect_used_paths_expr(store, store.exprs.get(coll), acc))
        .Match(subj, arms) -> collect_used_paths_match_arms(store, arms, collect_used_paths_expr(store, store.exprs.get(subj), acc))
        .Module(_, body) -> collect_used_paths_stmt_ids(store, body, acc)
        .Impl(_, methods) -> collect_used_paths_stmt_ids(store, methods, acc)
        .Annotated(_, inner) -> collect_used_paths_stmt(store, store.stmts.get(inner), acc)
        .Defer(body) -> collect_used_paths_expr(store, store.exprs.get(body), acc)
        .LetDestructure(_, init) -> collect_used_paths_expr(store, store.exprs.get(init), acc)
        _ -> acc
    }
}

/// Row-list twin of `collect_used_paths_stmts` for flipped bodies.
fn collect_used_paths_stmt_ids(store: NodeStore, ids: List<StmtId>, acc: List<string>) -> List<string> {
    mut out = acc
    for id in ids { out = collect_used_paths_stmt(store, store.stmts.get(id), out) }
    out
}

/// Per-expr branch of the unused-import sweep — recurses into
/// every sub-expression to find QualifiedIdent references.
fn collect_used_paths_expr(store: NodeStore, expr: Expr, acc_ref: List<string>) -> List<string> {
    if expr == null { return acc_ref }
    // Avra params are immutable. Rebind to a `mut` local — the
    // underlying heap AvraArray is shared, so push mutations reach
    // the caller (same convention as test_runner/discovery.av).
    mut acc = acc_ref
    match expr {
        .QualifiedIdent(path) -> {
            acc.push(path)
            acc
        }
        .Call(callee, args) -> collect_used_paths_expr_list_ids(store, args, collect_used_paths_expr(store, store.exprs.get(callee), acc))
        .GenericCall(callee, _, args) -> collect_used_paths_expr_list_ids(store, args, collect_used_paths_expr(store, store.exprs.get(callee), acc))
        .Binary(l, _, r) -> collect_used_paths_expr(store, store.exprs.get(r), collect_used_paths_expr(store, store.exprs.get(l), acc))
        .Unary(_, r) -> collect_used_paths_expr(store, store.exprs.get(r), acc)
        .Logical(l, _, r) -> collect_used_paths_expr(store, store.exprs.get(r), collect_used_paths_expr(store, store.exprs.get(l), acc))
        .Grouping(inner) -> collect_used_paths_expr(store, store.exprs.get(inner), acc)
        .Assign(_, val) -> collect_used_paths_expr(store, store.exprs.get(val), acc)
        .Index(obj, idx) -> collect_used_paths_expr(store, store.exprs.get(idx), collect_used_paths_expr(store, store.exprs.get(obj), acc))
        .Block(body) -> collect_used_paths_stmt_ids(store, body, acc)
        .FieldAccess(obj, _) -> collect_used_paths_expr(store, store.exprs.get(obj), acc)
        .FieldAssign(obj, _, val) -> collect_used_paths_expr(store, store.exprs.get(val), collect_used_paths_expr(store, store.exprs.get(obj), acc))
        .IfExpr(c, t, e) -> collect_used_paths_expr(store, store.exprs.get(e), collect_used_paths_expr(store, store.exprs.get(t), collect_used_paths_expr(store, store.exprs.get(c), acc)))
        .NullCoalesce(l, r) -> collect_used_paths_expr(store, store.exprs.get(r), collect_used_paths_expr(store, store.exprs.get(l), acc))
        .OptionalChain(obj, _) -> collect_used_paths_expr(store, store.exprs.get(obj), acc)
        .OptionalMethodCall(obj, _, args) -> collect_used_paths_expr_list_ids(store, args, collect_used_paths_expr(store, store.exprs.get(obj), acc))
        .Try(inner) -> collect_used_paths_expr(store, store.exprs.get(inner), acc)
        .Tuple(elems) -> collect_used_paths_expr_list_ids(store, elems, acc)
        .ListLit(elems) -> collect_used_paths_expr_list_ids(store, elems, acc)
        .MapLit(entries) -> collect_used_paths_expr_list_ids(store, entries, acc)
        .StructLit(sn, inits) -> {
            acc.push(sn)
            collect_used_paths_field_inits(store, inits, acc)
        }
        .EnumCtor(tn, _, args) -> {
            acc.push(tn)
            collect_used_paths_expr_list_ids(store, args, acc)
        }
        .MatchExpr(subj, arms) -> collect_used_paths_match_arms(store, arms, collect_used_paths_expr(store, store.exprs.get(subj), acc))
        .Lambda(_, body) -> collect_used_paths_expr(store, store.exprs.get(body), acc)
        .With(obj, overrides) -> collect_used_paths_field_inits(store, overrides, collect_used_paths_expr(store, store.exprs.get(obj), acc))
        .Slice(obj, s, e) -> collect_used_paths_expr(store, store.exprs.get(e), collect_used_paths_expr(store, store.exprs.get(s), collect_used_paths_expr(store, store.exprs.get(obj), acc)))
        .IsCheck(subj, _) -> collect_used_paths_expr(store, store.exprs.get(subj), acc)
        .InCheck(needle, items) -> collect_used_paths_expr_list_ids(store, items, collect_used_paths_expr(store, store.exprs.get(needle), acc))
        .Catch(inner, _, body, _, _) -> collect_used_paths_expr(store, store.exprs.get(body), collect_used_paths_expr(store, store.exprs.get(inner), acc))
        .Spawn(body) -> collect_used_paths_expr(store, store.exprs.get(body), acc)
        .ChannelNew(_, capacity) -> {
            if capacity == null { acc } else { collect_used_paths_expr(store, store.exprs.get(capacity!), acc) }
        }
        .Isolated(body) -> collect_used_paths_expr(store, store.exprs.get(body), acc)
        .Ident(name) -> {
            // PascalCase identifiers may be imported type/enum names.
            // Track them as used paths by looking up their alias.
            if name.length > 0 && name[0] >= "A" && name[0] <= "Z" {
                acc.push(name)
                return acc
            }
            acc
        }
        _ -> acc
    }
}

/// Walk a flipped `List<ExprId>` (call/collection args) for the unused-import
/// sweep, collecting used qualified paths.
fn collect_used_paths_expr_list_ids(store: NodeStore, ids: List<ExprId>, acc: List<string>) -> List<string> {
    mut out = acc
    mut i = 0
    while i < ids.length {
        out = collect_used_paths_expr(store, store.exprs.get(ids[i]), out)
        i = i + 1
    }
    out
}

/// Walk a `List<FieldInit>` for the unused-import sweep.
fn collect_used_paths_field_inits(store: NodeStore, inits: List<FieldInit>, acc: List<string>) -> List<string> {
    mut out = acc
    mut i = 0
    while i < inits.length {
        out = collect_used_paths_expr(store, store.exprs.get(inits[i].value_id), out)
        i = i + 1
    }
    out
}

/// Walk a `List<MatchArm>` for the unused-import sweep — both
/// guards and bodies contribute.
fn collect_used_paths_match_arms(store: NodeStore, arms: List<MatchArm>, acc: List<string>) -> List<string> {
    mut out = acc
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard_id != null {
            out = collect_used_paths_expr(store, store.exprs.get(arm.guard_id!), out)
        }
        out = collect_used_paths_expr(store, store.exprs.get(arm.body_id), out)
        i = i + 1
    }
    out
}

// Check each alias in the use_result against the used paths set.
// Returns a DiagnosticBag with warnings for unused imports.
/// Compare the alias chain against the used-paths set, emitting
/// `UnusedImport` warnings for every alias the rewrite never
/// referenced.
fn check_unused_imports(aliases: List<AliasBinding>, used: List<string>) -> DiagnosticBag {
    // Walk top-level Use stmts to match aliases to source spans
    check_unused_aliases(aliases, used, bag_new())
}

/// Implementation backing `check_unused_imports` — walks the
/// alias list, accumulating warnings into the bag.
fn check_unused_aliases(aliases: List<AliasBinding>, used: List<string>, bag: DiagnosticBag) -> DiagnosticBag {
    mut acc = bag
    mut i = 0
    while i < aliases.length {
        let a = aliases[i]
        if !used_has(used, a.canonical) && !used_has(used, a.short_name) {
            let d = diag_with_confidence(diag_warning(DiagCode.UnusedImport, "unused import `${a.short_name}`", span_dummy()), Confidence.Medium)
            acc = bag_report(acc, d)
        }
        i = i + 1
    }
    acc
}
