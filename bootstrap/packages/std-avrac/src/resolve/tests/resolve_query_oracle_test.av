// WHY: the ps3t.8.4 acceptance proof — §6's invalidation property, gated
// two ways.
//
// 1. PRECISE COUNTERS: a private-internal edit in an exporting module
//    (private fn body, public fn body, even a private RENAME) leaves the
//    exported surface's answer hash unchanged, so an importer's
//    resolve(ref) GREEN-REVALIDATES with ZERO recomputes — computes_of
//    (RESOLVE) does not move, only the surface recomputes (to an equal
//    answer; early cutoff kills the wave). A signature edit recomputes
//    the importer's resolve but early-cutoffs at the unchanged sym_id; a
//    pub->private flip propagates a REAL change (sym 0 + ImportPrivate).
//    Visibility is IN the fingerprint, by construction.
//
// 2. THE EDIT-SEQUENCE ORACLE (query/oracle.av, ps3t.8.7): the same edit
//    script replayed incrementally and from-scratch must answer
//    byte-identically at every step for every root — the engine-level
//    analogue of the HRN diff-test — while doing strictly less work.

use @std.avrac.resolve.{SymbolKind, symbol_id}
use @std.avrac.resolve.{RqDecl, RqImport, RqRef, RqValue, RqInput, rq_db_new, rq_decls_input, rq_ref_input, rq_ref_key, rq_compute, rq_render}
use @std.avrac.resolve.{RQ_FAM_RESOLVE, RQ_FAM_SURFACE, RQ_FAM_INDEX}
use @std.avrac.query.{Db, QueryKey, qk}
use @std.avrac.query.{InputWrite, EditStep, OracleReport, run_edit_oracle, oracle_clean, oracle_saved_work}
use @std.avrac.diagnostics.{diag_code_str}

fn d(name: string, kind: SymbolKind, sig: string, body: string, exported: bool) -> RqDecl {
    RqDecl { name, kind, sig, body, exported }
}

/// The exporting module in one of its edit states: `get` (public) and
/// `helper` (private), each with a controllable sig/body/visibility.
fn lib_state(get_sig: string, get_body: string, get_pub: bool, helper_name: string, helper_body: string) -> RqInput {
    rq_decls_input("lib", [
        d("get", SymbolKind.FnSym, get_sig, get_body, get_pub),
        d(helper_name, SymbolKind.FnSym, "fn()->int", helper_body, false),
    ])
}

fn iw(w: RqInput) -> InputWrite<RqValue> {
    InputWrite { q: w.q, value: w.value, value_hash: w.value_hash }
}

/// The importer's ref: `get` at a site inside `app` with `use lib.{get}`.
fn importer_ref() -> RqRef {
    RqRef { name: "get", scope_chain: ["app"], imports: [RqImport { short_name: "get", from_module: "lib" }] }
}

/// A lib-INTERNAL ref to the private helper (scope-chain path).
fn internal_ref() -> RqRef {
    RqRef { name: "helper", scope_chain: ["lib"], imports: [] }
}

fn resolve_key(site: RqRef) -> QueryKey {
    qk(RQ_FAM_RESOLVE, rq_ref_key(site))
}

fn apply(db: Db<RqValue>, w: RqInput) {
    db.set_input(w.q, w.value, w.value_hash)
}

/// Fetch + render a root — value AND full diagnostic identity (codes,
/// not just counts), so a diagnostic-only change can never compare
/// equal here. The engine-level guarantee is stronger still: its memo
/// answer hash folds every diagnostic canonical (`answer_hash_of`), and
/// the run_edit_oracle harness compares full canonicals too.
fn answer(db: Db<RqValue>, q: QueryKey) -> string {
    match db.fetch(q) {
        .Ok(f) -> {
            mut s = "${rq_render(f.value)}|diags:${string(f.diags.length)}"
            for dg in f.diags {
                s = "${s}|${diag_code_str(dg.code)}"
            }
            s
        }
        .Err(_) -> "cycle"
    }
}

/// A database at the base state with the importer's resolve fetched once.
fn warmed_db() -> Db<RqValue> {
    let mut db: Db<RqValue> = rq_db_new()
    apply(db, lib_state("fn(int)->int", "body:v1", true, "helper", "hbody:v1"))
    apply(db, rq_decls_input("app", []))
    apply(db, rq_ref_input(importer_ref()))
    let _ = answer(db, resolve_key(importer_ref()))
    db
}

spec "private-internal edits do NOT invalidate importers (ps3t.8.4 acceptance)" {
    then "the warm base state costs exactly one RESOLVE and one SURFACE compute, no INDEX" {
        let db = warmed_db()
        db.computes_of(RQ_FAM_RESOLVE) == 1
            && db.computes_of(RQ_FAM_SURFACE) == 1
            && db.computes_of(RQ_FAM_INDEX) == 0
    }
    then "editing a PRIVATE fn's body: importer green-revalidates with ZERO resolve recomputes" {
        let db = warmed_db()
        let before = answer(db, resolve_key(importer_ref()))
        apply(db, lib_state("fn(int)->int", "body:v1", true, "helper", "hbody:v2"))
        let after = answer(db, resolve_key(importer_ref()))
        // The surface recomputed (its input changed) to an IDENTICAL
        // answer — early cutoff kills the wave before resolve.
        after == before
            && db.computes_of(RQ_FAM_RESOLVE) == 1
            && db.computes_of(RQ_FAM_SURFACE) == 2
    }
    then "editing a PUBLIC fn's BODY only: still zero resolve recomputes (surface is signature-only)" {
        let db = warmed_db()
        let before = answer(db, resolve_key(importer_ref()))
        apply(db, lib_state("fn(int)->int", "body:v2", true, "helper", "hbody:v1"))
        let after = answer(db, resolve_key(importer_ref()))
        after == before && db.computes_of(RQ_FAM_RESOLVE) == 1
    }
    then "RENAMING a private fn: importer untouched (the surface never saw it)" {
        let db = warmed_db()
        let before = answer(db, resolve_key(importer_ref()))
        apply(db, lib_state("fn(int)->int", "body:v1", true, "helper_renamed", "hbody:v1"))
        let after = answer(db, resolve_key(importer_ref()))
        after == before && db.computes_of(RQ_FAM_RESOLVE) == 1
    }
    then "editing the PUBLIC fn's SIGNATURE: resolve recomputes — but to the same sym, early cutoff holds" {
        let db = warmed_db()
        let before = answer(db, resolve_key(importer_ref()))
        apply(db, lib_state("fn(int,int)->int", "body:v1", true, "helper", "hbody:v1"))
        let after = answer(db, resolve_key(importer_ref()))
        // sym_id is (path + kind) — a sig change moves sig_fp consumers
        // (ps3t.8.5's lane), not the resolution answer.
        after == before && db.computes_of(RQ_FAM_RESOLVE) == 2
    }
    then "flipping the imported fn pub->private IS a surface change: resolve goes red with ImportPrivate" {
        let db = warmed_db()
        apply(db, lib_state("fn(int)->int", "body:v1", false, "helper", "hbody:v1"))
        let after = answer(db, resolve_key(importer_ref()))
        after == "sym:0|diags:1|F3102" && db.computes_of(RQ_FAM_RESOLVE) == 2
    }
    then "flipping it back re-resolves to the SAME stable sym_id (content-addressed, no counter drift)" {
        let db = warmed_db()
        apply(db, lib_state("fn(int)->int", "body:v1", false, "helper", "hbody:v1"))
        let _ = answer(db, resolve_key(importer_ref()))
        apply(db, lib_state("fn(int)->int", "body:v1", true, "helper", "hbody:v1"))
        let restored = answer(db, resolve_key(importer_ref()))
        restored == "sym:${string(symbol_id("lib::get", SymbolKind.FnSym))}|diags:0"
    }
}

spec "resolve-as-query under the edit-sequence oracle (ps3t.8.4 x ps3t.8.7)" {
    then "incremental == from-scratch at every step, and the replay saved work" {
        let base = [
            iw(lib_state("fn(int)->int", "body:v1", true, "helper", "hbody:v1")),
            iw(rq_decls_input("app", [])),
            iw(rq_ref_input(importer_ref())),
            iw(rq_ref_input(internal_ref())),
        ]
        let script = [
            // private body edit — absorbable
            EditStep { writes: [iw(lib_state("fn(int)->int", "body:v1", true, "helper", "hbody:v2"))] },
            // public body edit — absorbable
            EditStep { writes: [iw(lib_state("fn(int)->int", "body:v2", true, "helper", "hbody:v2"))] },
            // public sig edit — importer recomputes, same answer
            EditStep { writes: [iw(lib_state("fn(int,int)->int", "body:v2", true, "helper", "hbody:v2"))] },
            // pub->private flip — importer answer CHANGES (diagnostic appears)
            EditStep { writes: [iw(lib_state("fn(int,int)->int", "body:v2", false, "helper", "hbody:v2"))] },
            // flip back — recovery
            EditStep { writes: [iw(lib_state("fn(int)->int", "body:v1", true, "helper", "hbody:v1"))] },
            // private RENAME — importer absorbed; the lib-internal ref to
            // `helper` legitimately changes (resolved -> F3000)
            EditStep { writes: [iw(lib_state("fn(int)->int", "body:v1", true, "helper2", "hbody:v1"))] },
            // no-op rewrite of the same state — revision must not move
            EditStep { writes: [iw(lib_state("fn(int)->int", "body:v1", true, "helper2", "hbody:v1"))] },
        ]
        let roots = [resolve_key(importer_ref()), resolve_key(internal_ref())]
        let r = run_edit_oracle<RqValue>(base, script, roots, rq_compute, rq_render)
        oracle_clean(r) && oracle_saved_work(r) && r.steps == 8 && r.checks == 16
    }
}
