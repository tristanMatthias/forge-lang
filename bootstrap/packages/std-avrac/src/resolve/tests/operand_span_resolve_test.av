// The resolve-pass mirror of typeck's operand-span sharpening: an undefined
// name inside a call ARGUMENT or struct-literal FIELD INIT is reported at
// that operand's own source position (rs_at_expr / rs_at_operand), not at
// the enclosing call/literal head. Interned leaves carry no span — a shared
// leaf has no single source occurrence — so a bare undefined ident falls
// back to the nearest sharpened ancestor (statement or operand walk), never
// a SIBLING operand's position. `rsspan_`-prefixed fixtures against
// cross-shard collisions.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

fn rsspan_check_out(tag: string, source: string) -> string {
    let path = "/tmp/avra_operand_span_resolve_${tag}.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 check '${path}' 2>&1 || true")
}

spec "resolver diagnostics point at the offending operand" {
    then "an undefined name inside a composite call arg carets the arg's line" {
        let out = rsspan_check_out("arg",
            "fn want(s: int) { println(string(s)) }\n" +
            "fn main() {\n" +
            "    want(\n" +
            "        no_such_var + 1)\n" +
            "}\n")
        out.contains("F3000") && out.contains(":4:9")
    }
    then "an undefined name inside a struct-literal field init carets the init" {
        let out = rsspan_check_out("fieldinit",
            "type P = { x: int, y: int }\n" +
            "fn main() {\n" +
            "    let p = P { x: 1,\n" +
            "        y: no_such + 1 }\n" +
            "    println(string(p.x))\n" +
            "}\n")
        out.contains("F3000") && out.contains(":4:12")
    }
    then "a top-level const's leaf init keeps the statement position (arena_root_walk parity)" {
        let out = rsspan_check_out("leaf",
            "fn main() -> int { 0 }\n" +
            "const BAD: int = missing_name\n")
        out.contains("F3000") && out.contains("(line 2)") && out.contains(":2:1")
    }
}
