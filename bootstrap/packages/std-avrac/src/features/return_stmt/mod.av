// return — exit the enclosing function (spec Axis 28). The definition
// carries the feature whole: syntax, docs, editor surface, and the grammar
// rule the statement views compose (gram_family = "stmt", t-47hc.8). The
// lowering (build_return) is feature-owned via the builder manifest
// (t-kd4y.3); Stmt.Return / Stmt.ReturnEmpty codegen — return-slot stores,
// DeferStack unwinding, RC releases — stays with the central emitters.
use features.return_stmt.lowering.{return_builds}
use features.grammar.{parse_grammar}

/// `return ( value )?` — an absent same-line value is a bare
/// `Stmt.ReturnEmpty`; a present one is `Stmt.Return(value)`. The
/// same-line/FIRST gating lives in the rule below; this build only folds
/// presence. Home in the feature file (t-47hc.8 dissolution) — the engine's
/// checked-in `_gb_` adapter imports it back.
export fn return_lang() -> LanguageFeature {
    LanguageFeature return_def {
        name = "return",
        title = "return — exit the enclosing function",
        docs = """
`return expr` exits the enclosing function with `expr` as its value;
bare `return` exits with the function's default value (unit fns, or a
`null` for a nullable return type, through the `optional_repr` primitives).

The operand must start on the SAME LINE as the `return` keyword — the
language is newline-sensitive, so a value on the next line is a separate
statement, not the return's operand:

    fn pick(flag: bool) -> int {
        if flag { return 1 }
        return
        compute()     // unreachable statement, NOT `return compute()`
    }

Every `return` runs the scope's pending `defer` / `errdefer` entries
(LIFO) before the function actually exits.
""",
        gram = grammar { return_stmt = "return" ( @peek(return_value) @gate @onfail(bail) e:expression )? -> build_return(e) },
        builders = return_builds(),
        snippet = r"return ${1:value}",
        gram_family = "stmt",
    }
    return_def
}
