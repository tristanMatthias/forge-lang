// WHY: parses the `return` statement, both with and without a value.

use core.{Stmt}
use parse.{Parser}
use core.{Tk}

impl Parser {
    fn parse_return_statement(self) -> Result<StmtId, string> {
        self.advance()

        if self.current_kind in [Tk.RightBrace, Tk.Eof] {
            return .Ok(self.glue_ingest_stmt(Stmt.ReturnEmpty))
        }

        let value = self.parse_expression_boxed()?
        .Ok(self.glue_ingest_stmt(Stmt.Return(value)))
    }
}
