// WHY: parses the `return` statement, both with and without a value.

use core.{Stmt}
use parse.{Parser}
use core.{Tk}

impl Parser {
    fn parse_return_statement(self) -> Result<Stmt, string> {
        self.advance()

        if self.current_kind in [Tk.RightBrace, Tk.Eof] {
            return .Ok(Stmt.ReturnEmpty)
        }

        let value = self.parse_expression_boxed()?
        .Ok(Stmt.Return(value))
    }
}
