// WHY: feature registration for `isolated { body }` expression.
// Forks a subprocess running `body`, marshals the bytes return
// value back through a pipe. Crash-safe sibling of `spawn { }` —
// SIGSEGV / abort in the child propagates as `Result.Err(Crashed)`
// to the parent, not a process-wide death.
//
// dir-as-module (g2eo.1): codegen.av + parser.av auto-load as
// siblings, surface flat at `features.isolated_expr.{...}`.
//
// Phase D of forge-crafting-intepreters-nce6.

use core.{ExprId}
use features.grammar.{parse_grammar}
use features.isolated_expr.lowering.{isolated_builds}
use resolve.{resolve_expr}
use typeck.{check_expr, tc_er}

/// `isolated { body }` — the definition carries the feature whole
/// (t-kd4y.3.5.1). Same double-keyed `@expect` as spawn_lang (fragment
/// rule, external block_expr), same t-rd44 `@require` gate.
export fn isolated_lang() -> LanguageFeature {
    LanguageFeature isolated_def {
        name = "isolated",
        title = "isolated — crash-safe subprocess execution",
        docs = """
`isolated { body }` forks a subprocess running the block and marshals
the result back through a pipe. The crash-safe sibling of `spawn`: a
SIGSEGV or abort in the child propagates as `Result.Err(Crashed)` to
the parent, not a process-wide death.
""",
        gram = grammar {
  isolated_expr = "isolated" @require body:block_expr
                  @expect("{", "expected `{` after isolated")
                  @expect("block_expr", "expected `{` after isolated") -> MkIsolated(body)
        },
        builders = isolated_builds(),
        snippet = r"isolated { ${1:body} }",
        expr_tag = Expr.Isolated(ExprId(0)),
        emit_expr = isolated_emit_expr,
        resolve_expr = isolated_resolve,
        check_expr = isolated_check,
        gram_family = "expr",
    }
    isolated_def
}

/// Resolver hook for `Isolated`. Body resolves in the enclosing
/// scope — fork() preserves captured names via COW so identifiers
/// from the outer scope work inside the body.
fn isolated_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .Isolated(body) -> resolve_expr(r, r.nodes.exprs.get(body))
        _ -> r
    }
}

/// Type-check hook for `Isolated`. Walks the body for its errors
/// then declares the result `bytes` — the framed payload from the
/// subprocess. The stdlib's `unframe_isolated` decodes this into
/// `Result<bytes, IsolatedError>` for callers.
fn isolated_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Isolated(body) -> {
            let b = check_expr(tc, tc.nodes.exprs.get(body))
            // The body's actual return type isn't reflected here yet —
            // until @marshal / generic isolated<T> lands, the surface
            // is "you return bytes; orchestrator unframes them".
            tc_er(b.tc, .Bytes)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
