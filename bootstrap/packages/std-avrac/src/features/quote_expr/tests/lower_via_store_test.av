// WHY: `lower_quotes_via_store` replaces the recursive boxed presence scan
// with a FLAT read of the parse-time arena's expr rows — the first consumer
// pass whose shape is *better* because of the arena (no tree walk; every Expr
// in the program is a dense row, including those embedded in match arms and
// struct-field inits). These specs guard its contract:
//   1. equivalence — on the same program it lowers exactly what
//      `lower_quotes` lowers (render-equality), and the no-quote fast path
//      returns the input unchanged;
//   2. coverage — a quote hiding ONLY inside a match-arm body or a struct-lit
//      field init is found via the arena rows (the historical bug class where
//      the presence scan missed a position, lowering skipped, and the
//      un-lowered Quote crashed eval later).

use @std.avrac.core.{Expr, Stmt, StmtId, NodeStore, MatchArm, FieldInit, Pattern, ValueType, render_stmt_ids, new_node_store, build_line_index, byte_span_none}
use @std.avrac.features.quote_expr.{lower_quotes, lower_quotes_via_store}

/// A program (its root rows) + the store its rows live in. F3a: the Let's
/// initializer is an ExprId, so the expr subtree is ingested into the store
/// FIRST — which is also exactly what makes the flat store scan see it.
type ProgramWithStore = { ids: List<StmtId>, store: NodeStore }

/// Render the program after lowering through the FLAT store scan. F4e:
/// `lower_quotes*` are arena-id-native — the roots lower to `List<StmtId>`
/// which render directly.
fn lowered_via_store(pw: ProgramWithStore) -> string {
    render_stmt_ids(pw.store, lower_quotes_via_store(pw.ids, pw.store))
}

/// Render the program after lowering through the recursive tree scan.
fn lowered_tree(pw: ProgramWithStore) -> string {
    render_stmt_ids(pw.store, lower_quotes(pw.ids, pw.store))
}

/// Render the program unchanged (the fast-path / no-rewrite baseline).
fn rendered_input(pw: ProgramWithStore) -> string {
    render_stmt_ids(pw.store, pw.ids)
}

/// One top-level `let q = <expr>` statement as a program, ingested into the
/// caller-supplied store — so the expr's flipped `ExprId` children (e.g. a
/// Quote body, a MatchExpr subject) already live in the SAME store the flat
/// scan resolves through.
fn program_of(e: Expr, store: NodeStore) -> ProgramWithStore {
    let init = store.ingest_expr(e, byte_span_none())
    let sid = store.stmts.add_leaf(Stmt.Let("q", ValueType.Unknown, init))
    store.set_stmt_pos(sid, 1, 1, "")
    ProgramWithStore { ids: [sid], store }
}

/// `quote { 5 }` with its body ingested into `store` — the flipped `Quote.body`
/// holds the body's arena id directly.
fn quote_num(store: NodeStore) -> Expr {
    Expr.Quote("expr", store.exprs.add_leaf(Expr.Number("5")))
}

spec "lower_quotes_via_store: equivalence with the boxed scan" {
    then "a program with a top-level quote lowers identically to lower_quotes" {
        let store = new_node_store(build_line_index(""))
        let pw = program_of(quote_num(store), store)
        lowered_via_store(pw) == lowered_tree(pw)
    }
    then "the lowered output differs from the input (the quote was rewritten)" {
        let store = new_node_store(build_line_index(""))
        let pw = program_of(quote_num(store), store)
        lowered_via_store(pw) != rendered_input(pw)
    }
    then "a no-quote program takes the fast path unchanged" {
        let store = new_node_store(build_line_index(""))
        let pw = program_of(Expr.Number("42"), store)
        lowered_via_store(pw) == rendered_input(pw)
    }
    then "an empty program takes the fast path" {
        let ids: List<StmtId> = []
        let store = new_node_store(build_line_index(""))
        lower_quotes_via_store(ids, store).length == 0
    }
}

spec "lower_quotes_via_store: arena rows cover struct-embedded positions" {
    then "a quote ONLY inside a match-arm body is found and lowered" {
        let store = new_node_store(build_line_index(""))
        let arm = MatchArm { pattern: Pattern.Wildcard, guard_id: null, body_id: store.exprs.add_leaf(quote_num(store)) }
        let arms: List<MatchArm> = [arm]
        let pw = program_of(Expr.MatchExpr(store.exprs.add_leaf(Expr.Ident("x")), arms), store)
        lowered_via_store(pw) == lowered_tree(pw)
            && lowered_via_store(pw) != rendered_input(pw)
    }
    then "a quote ONLY inside a struct-lit field init is found and lowered" {
        let store = new_node_store(build_line_index(""))
        let inits: List<FieldInit> = [FieldInit { name: "f", value_id: store.exprs.add_leaf(quote_num(store)) }]
        let pw = program_of(Expr.StructLit("P", inits), store)
        lowered_via_store(pw) == lowered_tree(pw)
            && lowered_via_store(pw) != rendered_input(pw)
    }
    then "a quote ONLY inside a guarded arm's guard is found and lowered" {
        let store = new_node_store(build_line_index(""))
        let arm = MatchArm { pattern: Pattern.Wildcard, guard_id: store.exprs.add_leaf(quote_num(store)), body_id: store.exprs.add_leaf(Expr.Number("1")) }
        let arms: List<MatchArm> = [arm]
        let pw = program_of(Expr.MatchExpr(store.exprs.add_leaf(Expr.Ident("x")), arms), store)
        lowered_via_store(pw) == lowered_tree(pw)
            && lowered_via_store(pw) != rendered_input(pw)
    }
}
