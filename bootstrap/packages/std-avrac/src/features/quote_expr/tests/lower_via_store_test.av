// WHY: `lower_quotes_via_store` replaces the recursive boxed presence scan
// with a FLAT read of the parse-time arena's expr rows — the first consumer
// pass whose shape is *better* because of the arena (no tree walk; every Expr
// in the program is a dense row, including those embedded in match arms and
// struct-field inits). These specs guard its contract:
//   1. equivalence — on the same program it lowers exactly what
//      `lower_quotes` lowers (render-equality), and the no-quote fast path
//      returns the input unchanged;
//   2. coverage — a quote hiding ONLY inside a match-arm body or a struct-lit
//      field init is found via the arena rows (the historical bug class where
//      the presence scan missed a position, lowering skipped, and the
//      un-lowered Quote crashed eval later).

use @std.avrac.core.{Expr, Stmt, SStmt, NodeStore, MatchArm, FieldInit, Pattern, ValueType, sexpr_at, sstmt_at, render_stmt_list, new_node_store, build_line_index, byte_span_none}
use @std.avrac.features.quote_expr.{lower_quotes, lower_quotes_via_store}

/// A program + the store its rows live in. F3a: the Let's initializer
/// is an ExprId, so the expr subtree is ingested into the store FIRST
/// — which is also exactly what makes the flat store scan see it.
type ProgramWithStore = { stmts: List<SStmt>, store: NodeStore }

/// One top-level `let q = <expr>` statement as a program.
fn program_of(e: Expr) -> ProgramWithStore {
    let store = new_node_store(build_line_index(""))
    let init = store.ingest_expr(e, byte_span_none())
    ProgramWithStore { stmts: [sstmt_at(Stmt.Let("q", ValueType.Unknown, init), 1, 1, "")], store }
}

fn quote_num() -> Expr {
    Expr.Quote("expr", Expr.Number("5"))
}

spec "lower_quotes_via_store: equivalence with the boxed scan" {
    then "a program with a top-level quote lowers identically to lower_quotes" {
        let pw = program_of(quote_num())
        render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) == render_stmt_list(pw.store, lower_quotes(pw.stmts, pw.store))
    }
    then "the lowered output differs from the input (the quote was rewritten)" {
        let pw = program_of(quote_num())
        render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) != render_stmt_list(pw.store, pw.stmts)
    }
    then "a no-quote program takes the fast path unchanged" {
        let pw = program_of(Expr.Number("42"))
        render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) == render_stmt_list(pw.store, pw.stmts)
    }
    then "an empty program takes the fast path" {
        let stmts: List<SStmt> = []
        let store = new_node_store(build_line_index(""))
        lower_quotes_via_store(stmts, store).length == 0
    }
}

spec "lower_quotes_via_store: arena rows cover struct-embedded positions" {
    then "a quote ONLY inside a match-arm body is found and lowered" {
        let arm = MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_at(quote_num(), 2, 3, "") }
        let arms: List<MatchArm> = [arm]
        let pw = program_of(Expr.MatchExpr(Expr.Ident("x"), arms))
        render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) == render_stmt_list(pw.store, lower_quotes(pw.stmts, pw.store))
            && render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) != render_stmt_list(pw.store, pw.stmts)
    }
    then "a quote ONLY inside a struct-lit field init is found and lowered" {
        let inits: List<FieldInit> = [FieldInit { name: "f", value: sexpr_at(quote_num(), 2, 3, "") }]
        let pw = program_of(Expr.StructLit("P", inits))
        render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) == render_stmt_list(pw.store, lower_quotes(pw.stmts, pw.store))
            && render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) != render_stmt_list(pw.store, pw.stmts)
    }
    then "a quote ONLY inside a guarded arm's guard is found and lowered" {
        let arm = MatchArm { pattern: Pattern.Wildcard, guard: sexpr_at(quote_num(), 2, 1, ""), body: sexpr_at(Expr.Number("1"), 2, 5, "") }
        let arms: List<MatchArm> = [arm]
        let pw = program_of(Expr.MatchExpr(Expr.Ident("x"), arms))
        render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) == render_stmt_list(pw.store, lower_quotes(pw.stmts, pw.store))
            && render_stmt_list(pw.store, lower_quotes_via_store(pw.stmts, pw.store)) != render_stmt_list(pw.store, pw.stmts)
    }
}
