// Phase 3 (vez6.3) of Components V2: end-to-end test for `quote { ... }`.
// Captures small expressions as runtime AST values, verifies via the
// render_expr S-expression serializer that the captured shape matches.

use @std.avrac.core.{Expr, render_expr}

spec "quote: literals" {
    then "number literal" {
        let e = quote { 42 }
        render_expr(e) == "42"
    }
    then "string literal" {
        let e = quote { "hi" }
        render_expr(e) == "\"hi\""
    }
    then "bool literal" {
        let e = quote { true }
        render_expr(e) == "true"
    }
    then "null literal" {
        let e = quote { null }
        render_expr(e) == "null"
    }
}

spec "quote: identifier capture" {
    then "bare identifier" {
        let e = quote { my_var }
        render_expr(e) == "my_var"
    }
    then "identifier in arithmetic" {
        let e = quote { x + y }
        render_expr(e) == "(+ x y)"
    }
}

spec "quote: arithmetic" {
    then "addition" {
        let e = quote { 5 + 7 }
        render_expr(e) == "(+ 5 7)"
    }
    then "nested arithmetic" {
        let e = quote { 1 + 2 * 3 }
        render_expr(e) == "(+ 1 (* 2 3))"
    }
    then "subtraction" {
        let e = quote { 10 - 3 }
        render_expr(e) == "(- 10 3)"
    }
    then "comparison" {
        let e = quote { 1 == 2 }
        render_expr(e) == "(== 1 2)"
    }
}

spec "quote: unary" {
    then "negation" {
        let e = quote { -5 }
        render_expr(e) == "(- 5)"
    }
    then "logical not" {
        let e = quote { !true }
        render_expr(e) == "(! true)"
    }
}

spec "quote: function calls" {
    then "no-arg call" {
        let e = quote { f() }
        render_expr(e) == "(call f ())"
    }
    then "single arg" {
        let e = quote { g(7) }
        render_expr(e) == "(call g (7))"
    }
    then "multiple args" {
        let e = quote { add(1, 2) }
        render_expr(e) == "(call add (1, 2))"
    }
    then "nested calls" {
        let e = quote { f(g(x)) }
        render_expr(e) == "(call f ((call g (x))))"
    }
}

spec "quote: field + index access" {
    then "field access" {
        let e = quote { obj.field }
        render_expr(e) == "(field obj field)"
    }
    then "chained field" {
        let e = quote { a.b.c }
        render_expr(e) == "(field (field a b) c)"
    }
    then "index access" {
        let e = quote { xs[0] }
        render_expr(e) == "(index xs 0)"
    }
}

spec "quote: collections" {
    then "tuple two" {
        let e = quote { (a, b) }
        render_expr(e) == "(tuple (a, b))"
    }
    then "tuple three" {
        let e = quote { (1, 2, 3) }
        render_expr(e) == "(tuple (1, 2, 3))"
    }
    then "list literal" {
        let e = quote { [1, 2, 3] }
        render_expr(e) == "(list (1, 2, 3))"
    }
    then "empty list" {
        let e = quote { [] }
        render_expr(e) == "(list ())"
    }
}

spec "quote: null safety" {
    then "null coalesce" {
        let e = quote { a ?? b }
        render_expr(e) == "(?? a b)"
    }
    then "optional chain" {
        let e = quote { obj?.field }
        render_expr(e) == "(?. obj field)"
    }
    then "try propagation" {
        let e = quote { fallible? }
        render_expr(e) == "(? fallible)"
    }
}
