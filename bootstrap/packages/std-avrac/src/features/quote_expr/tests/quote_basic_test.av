// Phase 3 (vez6.3) of Components V2: end-to-end test for `quote { ... }`.
// Captures small expressions as runtime AST values, verifies via the
// render_expr S-expression serializer that the captured shape matches.

use @std.avrac.core.{Expr, render_expr}

spec "quote: literals" {
    then "number literal" {
        let e = quote { 42 }
        render_expr(e) == "42"
    }
    then "string literal" {
        let e = quote { "hi" }
        render_expr(e) == "\"hi\""
    }
    then "bool literal" {
        let e = quote { true }
        render_expr(e) == "true"
    }
    then "null literal" {
        let e = quote { null }
        render_expr(e) == "null"
    }
}

spec "quote: identifier capture" {
    then "bare identifier" {
        let e = quote { my_var }
        render_expr(e) == "my_var"
    }
    then "identifier in arithmetic" {
        let e = quote { x + y }
        render_expr(e) == "(+ x y)"
    }
}

spec "quote: arithmetic" {
    then "addition" {
        let e = quote { 5 + 7 }
        render_expr(e) == "(+ 5 7)"
    }
    then "nested arithmetic" {
        let e = quote { 1 + 2 * 3 }
        render_expr(e) == "(+ 1 (* 2 3))"
    }
    then "subtraction" {
        let e = quote { 10 - 3 }
        render_expr(e) == "(- 10 3)"
    }
    then "comparison" {
        let e = quote { 1 == 2 }
        render_expr(e) == "(== 1 2)"
    }
}

spec "quote: unary" {
    then "negation" {
        let e = quote { -5 }
        render_expr(e) == "(- 5)"
    }
    then "logical not" {
        let e = quote { !true }
        render_expr(e) == "(! true)"
    }
}

spec "quote: function calls" {
    then "no-arg call" {
        let e = quote { f() }
        render_expr(e) == "(call f ())"
    }
    then "single arg" {
        let e = quote { g(7) }
        render_expr(e) == "(call g (7))"
    }
    then "multiple args" {
        let e = quote { add(1, 2) }
        render_expr(e) == "(call add (1, 2))"
    }
    then "nested calls" {
        let e = quote { f(g(x)) }
        render_expr(e) == "(call f ((call g (x))))"
    }
}

spec "quote: field + index access" {
    then "field access" {
        let e = quote { obj.field }
        render_expr(e) == "(field obj field)"
    }
    then "chained field" {
        let e = quote { a.b.c }
        render_expr(e) == "(field (field a b) c)"
    }
    then "index access" {
        let e = quote { xs[0] }
        render_expr(e) == "(index xs 0)"
    }
}

spec "quote: collections" {
    then "tuple two" {
        let e = quote { (a, b) }
        render_expr(e) == "(tuple (a, b))"
    }
    then "tuple three" {
        let e = quote { (1, 2, 3) }
        render_expr(e) == "(tuple (1, 2, 3))"
    }
    then "list literal" {
        let e = quote { [1, 2, 3] }
        render_expr(e) == "(list (1, 2, 3))"
    }
    then "empty list" {
        let e = quote { [] }
        render_expr(e) == "(list ())"
    }
}

spec "quote: null safety" {
    then "null coalesce" {
        let e = quote { a ?? b }
        render_expr(e) == "(?? a b)"
    }
    then "optional chain" {
        let e = quote { obj?.field }
        render_expr(e) == "(?. obj field)"
    }
    then "try propagation" {
        let e = quote { fallible? }
        render_expr(e) == "(? fallible)"
    }
}

spec "quote: float literal" {
    then "simple float" {
        let e = quote { 3.14 }
        render_expr(e) == "3.14"
    }
}

spec "quote: struct literal" {
    then "single field" {
        let e = quote { Point { x: 1 } }
        render_expr(e) == "(struct Point (x=1))"
    }
    then "two fields" {
        let e = quote { Point { x: 1, y: 2 } }
        render_expr(e) == "(struct Point (x=1, y=2))"
    }
    then "three fields" {
        let e = quote { Point3 { x: 1, y: 2, z: 3 } }
        render_expr(e) == "(struct Point3 (x=1, y=2, z=3))"
    }
}

spec "quote: lambda" {
    then "no params" {
        let e = quote { () -> 42 }
        render_expr(e) == "(lambda () 42)"
    }
    then "one param" {
        let e = quote { (x) -> x + 1 }
        render_expr(e) == "(lambda (x) (+ x 1))"
    }
    then "two params" {
        let e = quote { (x, y) -> x + y }
        render_expr(e) == "(lambda (x, y) (+ x y))"
    }
}

spec "quote: map literal" {
    then "single entry" {
        let e = quote { ({"a": 1}) }
        render_expr(e) == "(group (map (\"a\", 1)))"
    }
}

spec "quote: with-update" {
    then "single override" {
        let e = quote { obj with { x: 5 } }
        render_expr(e) == "(with obj (x=5))"
    }
}

spec "quote: tuple index" {
    then "first index" {
        let e = quote { t.0 }
        render_expr(e) == "(tuple-idx t 0)"
    }
    then "third index" {
        let e = quote { t.2 }
        render_expr(e) == "(tuple-idx t 2)"
    }
}

spec "quote: is + in checks" {
    then "is-check" {
        let e = quote { x is .Some }
        render_expr(e) == "(is x .Some)"
    }
}

// Regression: lower_expr previously dropped to `_ -> expr` for many
// container variants, leaving an inner Quote unlowered. Verifies the
// walker recurses into struct-literal fields, list elements, and
// tuple elements.
spec "quote: nested quote inside container is lowered" {
    then "inner quote inside list literal" {
        // outer quote builds a list-construction Expr; inner quote
        // builds a number literal. After lowering both, evaluating
        // the outer Expr should yield a runtime Expr.ListLit value
        // whose first element is itself an Expr.Number.
        let outer = quote { [quote { 42 }] }
        // The outer Expr is .ListLit with one element. The element is
        // the LOWERED inner quote — which evaluates to Expr.Number("42").
        // We check by asserting outer's render contains the marker for
        // the lowered (constructed) form, not the unlowered Quote form.
        !render_expr(outer).contains("quote ")
    }
    then "inner quote inside struct field" {
        let outer = quote { Foo { x: quote { 7 } } }
        !render_expr(outer).contains("quote ")
    }
}

// ── Red-team / edge-case stress tests (vez6.3.8) ──

// Operator precedence preserves the parse tree exactly.
spec "quote: precedence preserved" {
    then "mul before add" {
        let e = quote { a + b * c }
        render_expr(e) == "(+ a (* b c))"
    }
    then "and before or" {
        let e = quote { a || b && c }
        render_expr(e) == "(|| a (&& b c))"
    }
    then "explicit parens override precedence" {
        let e = quote { (a + b) * c }
        render_expr(e) == "(* (group (+ a b)) c)"
    }
    then "comparison precedence" {
        let e = quote { a + b == c - d }
        render_expr(e) == "(== (+ a b) (- c d))"
    }
}

// Deeply nested recursion: lowerings are not stack-bounded.
spec "quote: deep nesting" {
    then "8-level groupings" {
        let e = quote { ((((((((1)))))))) }
        render_expr(e).contains("(group ")
    }
    then "deeply chained binary" {
        let e = quote { 1 + 2 + 3 + 4 + 5 + 6 + 7 + 8 }
        render_expr(e).contains("(+ ") && render_expr(e).contains("8")
    }
    then "list-of-lists" {
        let e = quote { [[1, 2], [3, 4], [5, 6]] }
        render_expr(e) == "(list ((list (1, 2)), (list (3, 4)), (list (5, 6))))"
    }
    then "tuple-of-tuples" {
        let e = quote { ((1, 2), (3, 4)) }
        render_expr(e) == "(tuple ((tuple (1, 2)), (tuple (3, 4))))"
    }
}

// Unary stacking should preserve order — important for `-(-x)` etc.
spec "quote: stacked unaries" {
    then "double negation" {
        let e = quote { --5 }
        render_expr(e) == "(- (- 5))"
    }
    then "double not" {
        let e = quote { !!flag }
        render_expr(e) == "(! (! flag))"
    }
    then "negated call" {
        let e = quote { -f(x) }
        render_expr(e) == "(- (call f (x)))"
    }
}

// Long identifier names, snake-case, single-char — exercise the
// string_arg path for the Ident variant.
spec "quote: identifier shapes" {
    then "snake_case identifier" {
        let e = quote { user_id_value }
        render_expr(e) == "user_id_value"
    }
    then "single-char identifier" {
        let e = quote { x }
        render_expr(e) == "x"
    }
    then "trailing-digit identifier" {
        let e = quote { x1 }
        render_expr(e) == "x1"
    }
}

// String literal edge cases — the parser stores Expr.String.value with
// surrounding quotes, and codegen's strip_quotes must round-trip.
spec "quote: string-literal shapes" {
    then "empty string" {
        let e = quote { "" }
        render_expr(e) == "\"\""
    }
    then "single space" {
        let e = quote { " " }
        render_expr(e) == "\" \""
    }
    then "longer ASCII" {
        let e = quote { "hello world" }
        render_expr(e) == "\"hello world\""
    }
}

// Number-literal edge cases.
spec "quote: number shapes" {
    then "zero" {
        let e = quote { 0 }
        render_expr(e) == "0"
    }
    then "large number" {
        let e = quote { 1000000 }
        render_expr(e) == "1000000"
    }
    then "negative literal via unary" {
        let e = quote { -1 }
        render_expr(e) == "(- 1)"
    }
}
