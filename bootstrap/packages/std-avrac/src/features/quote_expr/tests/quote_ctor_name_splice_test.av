// t-47hc — the `~Name { … }` CONSTRUCTOR-NAME splice, pinned across the splice flip.
//
// The hand parser has a special case here: after `~`, an IDENT followed by `{` splices
// only the struct literal's TYPE NAME (encoded `StructLit("~" + name, …)`), rather than
// the greedy reading that would swallow the whole literal as one spliced node carrying a
// hardcoded type. When the grammar took over `~expr` (t-47hc), the obvious move was to
// mirror that special case as a second branch — and doing so BROKE quote lowering
// (quote_expr_value_splice 1/4, quote_arm 0/1). The generic `"~" t:unary -> MkSplice(t)`
// branch alone is correct: recursing into `unary` reaches the same struct literal, and
// lowering resolves the spliced name identically.
//
// This test exists because that equivalence was verified by hand against a baseline build
// and would otherwise be un-pinned — the existing quote suites cover `~(expr)` value
// splices but NOT the constructor-name form, so nothing would have caught a regression.
// It runs through @comptime/@expand, the path diff-test cannot see.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "quote: `~Name { … }` splices the struct CONSTRUCTOR NAME" {
    then "the spliced name resolves to the variable's VALUE, not the literal ident" {
        // `nm` holds "Pt", so the quoted body must build a `Pt`, not a struct named `nm`.
        // A greedy splice that lost the name would fail to resolve a type called `nm`.
        let out = write_fixture_and_run("/tmp/avra_quote_ctor_name_splice.av",
            "use @std.avrac.core.{Stmt, StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Pt = { x: int, y: int }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    let nm = \"Pt\"\n" +
            "    let decl = quote stmt {\n" +
            "        fn zzctor() -> int {\n" +
            "            let p = ~nm { x: 3, y: 4 }\n" +
            "            return p.x + p.y\n" +
            "        }\n" +
            "    }\n" +
            "    [synth_stmt_id(decl), synth_stmt_id(quote stmt { println(string(zzctor())) })]\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("7")
    }
}
