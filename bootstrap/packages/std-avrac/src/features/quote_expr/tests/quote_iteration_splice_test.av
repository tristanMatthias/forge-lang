// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 2 probe 4
// (iteration-style splice in a quote body).
//
// Per the handoff doc, an inline `~for item in items { quote stmt
// { ... ~item ... } }` syntax is NOT supported. The agreed
// alternative is the "build the list outside, return it directly"
// convention: a @comptime fn returning `List<SStmt>` constructs
// each statement via `quote stmt { ... }` and pushes the result
// into the output list. The @expand pipeline accepts a
// `List<SStmt>` return as a multi-stmt splice (commit 98e32334),
// so the caller gets the same effect without any new lowering.
//
// Note: the comptime eval's `for x in list { ... }` stmt handler
// is not implemented yet (separate gap), so this test exercises
// the pattern with explicit pushes. Once for-in lands at comptime,
// the same pattern works with a loop.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{cached_fixture_run}

fn write_temp(path: string, source: string) -> string {
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
}

fn run_capture(source: string) -> string {
    let path = "/tmp/avra_quote_iteration_splice_test.av"
    write_temp(path, source)
    cached_fixture_run(path)
}

spec "quote: iteration-style splice via list-return convention" {
    then "@comptime fn returning List<SStmt> splices each entry as a sibling stmt" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt, SStmt, sstmt_dummy}\n" +
            "\n" +
            "@comptime\n" +
            "fn build() -> List<SStmt> {\n" +
            "    let s1 = quote stmt { println(\"a\") }\n" +
            "    let s2 = quote stmt { println(\"b\") }\n" +
            "    let s3 = quote stmt { println(\"c\") }\n" +
            "    [sstmt_dummy(s1), sstmt_dummy(s2), sstmt_dummy(s3)]\n" +
            "}\n" +
            "\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("\"a\"") && out.contains("\"b\"") && out.contains("\"c\"")
    }
}
