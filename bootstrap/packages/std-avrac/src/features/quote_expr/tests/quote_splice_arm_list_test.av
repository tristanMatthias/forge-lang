// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 2 probe 2.
// Splice a `List<MatchArm>` into a `match { ... }` body via `~arms`
// in match-arm position. Tests the parser sentinel + lowerer's
// `list_concat`-based segmentation.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture_and_run}

spec "quote: ~arms splices a List<MatchArm> into match-arm position" {
    then "spliced arms fire at runtime" {
        let out = write_fixture_and_run("/tmp/avra_quote_splice_arm_list_test.av", 
            "use @std.avrac.core.{Stmt, SStmt, MatchArm}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_arms() -> List<MatchArm> {\n" +
            "    let a1 = quote arm { 1 -> 100 }\n" +
            "    let a2 = quote arm { 2 -> 200 }\n" +
            "    [a1, a2]\n" +
            "}\n" +
            "\n" +
            "@comptime\n" +
            "fn build_main() -> List<SStmt> {\n" +
            "    let arms = make_arms()\n" +
            "    quote stmts {\n" +
            "        let v = 2\n" +
            "        let r = match v {\n" +
            "            ~arms\n" +
            "            _ -> 0\n" +
            "        }\n" +
            "        println(string(r))\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(build_main)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("200")
    }
}

// B-final F4b regression: a spliced arm whose BODY is `none` (`Expr.None`)
// must round-trip through the reconstruct/decode path. The reconstructor
// reifies the body via `construct_expr_id` (the id-typed synth shim), and the
// decoder must NOT treat an `Expr.None` body_id as an absent slot — else the
// arm decodes as "match arm missing body" and the @expand fails to compile.
// The marker prints only if the @expand decode succeeded, so it fails cleanly
// on regression. (The marker leads the block to stay clear of an unrelated
// nullable-match-in-arg-position typeck limitation.)
spec "quote: a spliced arm with a `none` body decodes (Expr.None is a valid body)" {
    then "the none-bodied arm reconstructs + decodes through @expand" {
        let out = write_fixture_and_run("/tmp/avra_quote_splice_none_body_test.av",
            "use @std.avrac.core.{Stmt, SStmt, MatchArm}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_none_arm() -> List<MatchArm> {\n" +
            "    let a1 = quote arm { 1 -> none }\n" +
            "    [a1]\n" +
            "}\n" +
            "\n" +
            "@comptime\n" +
            "fn build_none_main() -> List<SStmt> {\n" +
            "    let arms = make_none_arm()\n" +
            "    quote stmts {\n" +
            "        println(\"none-body-arm-decoded\")\n" +
            "        let v = 2\n" +
            "        let r: int? = match v {\n" +
            "            ~arms\n" +
            "            _ -> 7\n" +
            "        }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(build_none_main)\n" +
            "fn placeholder2() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("none-body-arm-decoded")
    }
}
