// WHY: lowering pass for `quote { body }` (Phase 3 of Components V2).
//
// Each `Expr.Quote(kind, body)` becomes an Expr that, when evaluated,
// constructs `body` as a runtime AST value. So `quote { 5 }` evaluates
// to an `Expr.Number("5")` value, not the integer 5.
//
// Pipeline position: after resolve_names, before typecheck. Same slot
// the comptime pass uses, for the same reason — typeck sees the
// post-lowering AST (no Quote nodes survive).
//
// Phase 3 first slice: covers the literal + identifier + binary / unary
// expression shapes. More variants land in subsequent commits driven by
// tests that exercise them. The walker is the structural-walker pattern
// that desugar.av and comptime/rewrite.av use; once the generic-AST-
// visitor ticket lands (93k3) all three should share a single visitor.

use core.{Stmt, Expr, byte_span_none, FieldEntry, FieldInit, MatchArm, WhenArm, Pattern, BinOp, UnOp, LogicOp, ParamEntry, TypeParamEntry, CompConfigPair, Variant, ValueType, Annotation, binop_str, unop_str, logicop_str}
use core.{NodeStore, ExprId, StmtId}
use list_ops.{list_map}
use diagnostics.{DiagnosticBag, DiagCode, bag_new, bag_report, diag_error, span_at}

// ── Public entry ──

/// Walk every statement and expression under `ids`, replacing each
/// `Expr.Quote` node with an AST-construction expression that evaluates
/// to the captured AST. Returns a new `List<StmtId>`.
///
/// Fast-path: most files contain zero `quote { ... }` expressions, so
/// a non-allocating presence scan up-front lets the rewrite walker
/// skip entirely — the whole program's rows pass through untouched.
///
/// Fine-grained reuse: even a file that DOES contain a quote keeps every
/// quote-free subtree in place. `lower_stmt_id`/`lower_expr_id` re-run the
/// same presence predicate per node and return the original id when nothing
/// beneath it is a quote, so only the spine of nodes above each quote is
/// reallocated — most of a macro file (the non-quote fns) is reused, not
/// copied. Cost: the presence scan is repeated down each quote spine (bounded
/// by depth-to-quote), traded for eliminating the reallocation of every
/// quote-free container. The single-pass {node, changed} form that would drop
/// the repeated scan belongs to a future generic-AST-visitor consolidation
/// that would unify this walker with rewrite.av / desugar.av.
///
/// This RECURSIVE-scan entry walks the actual statement tree, so it stays
/// correct for trees merged from more than one parse (sibling-file loading),
/// where the store holds more than just this program. Callers whose store was
/// ingested from exactly this program should prefer `lower_quotes_via_store`
/// (flat arena scan) — the two scans must stay presence-equivalent
/// (spec-guarded).
export fn lower_quotes(ids: List<StmtId>, store: NodeStore) -> List<StmtId> {
    if !any_quote_in_stmt_ids(store, ids) { return ids }
    lower_stmt_ids(store, ids)
}

/// `lower_quotes` for a caller whose `store` was ingested from exactly this
/// program's `ids` (the arena `parse_or_fail` builds). The presence scan
/// becomes a FLAT pass over the expr arena — no recursion, no tree walk: every
/// Expr in the program (including those embedded in match arms and struct-field
/// inits) is a row, so "any quote?" is one linear read of dense rows. Strictly
/// covers at least the positions the recursive scan reaches; the lowering
/// itself is unchanged. ONLY valid when `store` was ingested from this exact
/// program — a store from a superset/subset tree (e.g. after sibling-file
/// merging) would scan the wrong program; such callers use `lower_quotes`.
export fn lower_quotes_via_store(ids: List<StmtId>, store: NodeStore) -> List<StmtId> {
    if !store_has_quote(store) { return ids }
    lower_stmt_ids(store, ids)
}

/// True iff any `Expr.Quote` row exists in the store's expr arena. The
/// data-oriented form of the presence scan: O(#exprs) over a dense array.
fn store_has_quote(store: NodeStore) -> bool {
    mut i = 1
    let n = store.exprs.count()
    while i <= n {
        if store.exprs.get(ExprId(i)) is .Quote { return true }
        i = i + 1
    }
    false
}

// ── Fast-path: non-allocating presence scan ──

/// True iff any `Expr.Quote` row appears anywhere under `ids`. Walks the
/// same shape as `lower_stmt_ids` but allocates nothing — the fast-path
/// guard `lower_quotes` uses to skip a program with no quotes.
fn any_quote_in_stmt_ids(store: NodeStore, ids: List<StmtId>) -> bool {
    for id in ids {
        if any_quote_in_stmt(store, store.stmts.get(id)) { return true }
    }
    false
}

fn any_quote_in_stmt(store: NodeStore, stmt: Stmt) -> bool {
    match stmt {
        .Let(_, _, init) -> any_quote_in_expr(store, store.exprs.get(init))
        .Mut(_, _, init) -> any_quote_in_expr(store, store.exprs.get(init))
        .Const(_, _, init) -> any_quote_in_expr(store, store.exprs.get(init))
        .Expr(e) -> any_quote_in_expr(store, store.exprs.get(e))
        .Return(e) -> any_quote_in_expr(store, store.exprs.get(e))
        .Block(body) -> any_quote_in_stmt_ids(store, body)
        .If(cond, then_b, else_b) -> {
            if any_quote_in_expr(store, store.exprs.get(cond)) { return true }
            if any_quote_in_stmt(store, store.stmts.get(then_b)) { return true }
            if else_b != null { return any_quote_in_stmt(store, store.stmts.get(else_b!)) }
            false
        }
        .While(cond, body) -> any_quote_in_expr(store, store.exprs.get(cond)) || any_quote_in_stmt(store, store.stmts.get(body))
        .For(_, start, end, body) -> any_quote_in_expr(store, store.exprs.get(start)) || any_quote_in_expr(store, store.exprs.get(end)) || any_quote_in_stmt(store, store.stmts.get(body))
        .ForIn(_, coll, body) -> any_quote_in_expr(store, store.exprs.get(coll)) || any_quote_in_stmt(store, store.stmts.get(body))
        .Function(_, _, _, _, body) -> any_quote_in_stmt_ids(store, body)
        .Impl(_, methods) -> any_quote_in_stmt_ids(store, methods)
        .Annotated(_, inner) -> any_quote_in_stmt(store, store.stmts.get(inner))
        .Module(_, body) -> any_quote_in_stmt_ids(store, body)
        .ComponentDef(_, _, _, _, _, body) -> any_quote_in_stmt_ids(store, body)
        .ComponentBlock(_, _, _, body) -> any_quote_in_stmt_ids(store, body)
        .SpecBlock(_, body) -> any_quote_in_stmt_ids(store, body)
        .GivenBlock(_, body) -> any_quote_in_stmt_ids(store, body)
        .ThenBlock(_, cond) -> any_quote_in_expr(store, store.exprs.get(cond))
        .Match(subj, arms) -> any_quote_in_expr(store, store.exprs.get(subj)) || any_quote_in_match_arms(store, arms)
        .Defer(body) -> any_quote_in_expr(store, store.exprs.get(body))
        .Errdefer(body) -> any_quote_in_expr(store, store.exprs.get(body))
        .LetDestructure(_, init) -> any_quote_in_expr(store, store.exprs.get(init))
        .TraitDecl(_, methods) -> any_quote_in_stmt_ids(store, methods)
        .Parallel(body) -> any_quote_in_stmt_ids(store, body)
        _ -> false
    }
}

fn any_quote_in_expr(store: NodeStore, expr: Expr) -> bool {
    match expr {
        .Quote(_, _) -> true
        .Splice(target) -> any_quote_in_expr(store, store.exprs.get(target))
        .Binary(l, _, r) -> any_quote_in_expr(store, store.exprs.get(l)) || any_quote_in_expr(store, store.exprs.get(r))
        .Unary(_, r) -> any_quote_in_expr(store, store.exprs.get(r))
        .Logical(l, _, r) -> any_quote_in_expr(store, store.exprs.get(l)) || any_quote_in_expr(store, store.exprs.get(r))
        .Call(callee, args) -> any_quote_in_expr(store, store.exprs.get(callee)) || any_quote_in_expr_id_list(store, args)
        .GenericCall(callee, _, args) -> any_quote_in_expr(store, store.exprs.get(callee)) || any_quote_in_expr_id_list(store, args)
        .Grouping(inner) -> any_quote_in_expr(store, store.exprs.get(inner))
        .Block(body) -> any_quote_in_stmt_ids(store, body)
        .IfExpr(c, t, e) -> any_quote_in_expr(store, store.exprs.get(c)) || any_quote_in_expr(store, store.exprs.get(t)) || any_quote_in_expr(store, store.exprs.get(e))
        .Assign(_, v) -> any_quote_in_expr(store, store.exprs.get(v))
        .StructLit(_, inits) -> any_quote_in_field_inits(store, inits)
        .FieldAccess(obj, _) -> any_quote_in_expr(store, store.exprs.get(obj))
        .FieldAssign(obj, _, v) -> any_quote_in_expr(store, store.exprs.get(obj)) || any_quote_in_expr(store, store.exprs.get(v))
        .EnumCtor(_, _, args) -> any_quote_in_expr_id_list(store, args)
        .Index(obj, idx) -> any_quote_in_expr(store, store.exprs.get(obj)) || any_quote_in_expr(store, store.exprs.get(idx))
        .NullCoalesce(l, r) -> any_quote_in_expr(store, store.exprs.get(l)) || any_quote_in_expr(store, store.exprs.get(r))
        .OptionalChain(obj, _) -> any_quote_in_expr(store, store.exprs.get(obj))
        .OptionalMethodCall(obj, _, args) -> any_quote_in_expr(store, store.exprs.get(obj)) || any_quote_in_expr_id_list(store, args)
        .Try(inner) -> any_quote_in_expr(store, store.exprs.get(inner))
        .Tuple(elems) -> any_quote_in_expr_id_list(store, elems)
        .TupleIndex(obj, _) -> any_quote_in_expr(store, store.exprs.get(obj))
        .With(obj, overrides) -> any_quote_in_expr(store, store.exprs.get(obj)) || any_quote_in_field_inits(store, overrides)
        .ListLit(elems) -> any_quote_in_expr_id_list(store, elems)
        .Lambda(_, body) -> any_quote_in_expr(store, store.exprs.get(body))
        .MapLit(entries) -> any_quote_in_expr_id_list(store, entries)
        .Slice(obj, s, e) -> any_quote_in_expr(store, store.exprs.get(obj)) || any_quote_in_expr(store, store.exprs.get(s)) || any_quote_in_expr(store, store.exprs.get(e))
        .IsCheck(subj, _) -> any_quote_in_expr(store, store.exprs.get(subj))
        .InCheck(needle, items) -> any_quote_in_expr(store, store.exprs.get(needle)) || any_quote_in_expr_id_list(store, items)
        .Spawn(body) -> any_quote_in_expr(store, store.exprs.get(body))
        .Isolated(body) -> any_quote_in_expr(store, store.exprs.get(body))
        .MatchExpr(subj, arms) -> any_quote_in_expr(store, store.exprs.get(subj)) || any_quote_in_match_arms(store, arms)
        // Subjectless-match / catch / comprehension / channel-capacity bodies
        // are expression positions too — a `quote { }` nested in one must be
        // seen by the presence scan (else the fast-path skips lowering and the
        // quote survives to codegen as an F9999 ICE). Kept presence-equivalent
        // with lower_expr's arms below.
        .When(arms) -> any_quote_in_when_arms(store, arms)
        .Catch(inner, _, body, _, _) -> any_quote_in_expr(store, store.exprs.get(inner)) || any_quote_in_expr(store, store.exprs.get(body))
        .ListComp(body, _, collection, filter) -> any_quote_in_expr(store, store.exprs.get(body)) || any_quote_in_expr(store, store.exprs.get(collection)) || (filter != null && any_quote_in_expr(store, store.exprs.get(filter!)))
        .ChannelNew(_, capacity) -> capacity != null && any_quote_in_expr(store, store.exprs.get(capacity!))
        _ -> false
    }
}

/// Presence-scan sibling of `any_quote_in_match_arms` for `when` arms
/// (WhenArm: nullable `cond_id`, non-null `body_id`).
fn any_quote_in_when_arms(store: NodeStore, arms: List<WhenArm>) -> bool {
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.cond_id != null && any_quote_in_expr(store, store.exprs.get(arm.cond_id!)) { return true }
        if any_quote_in_expr(store, store.exprs.get(arm.body_id)) { return true }
        i = i + 1
    }
    false
}


/// The id twin of `any_quote_in_expr_list` (mirrors `any_quote_in_stmt_ids`):
/// scan a flipped `List<ExprId>` for a nested quote by resolving each id in
/// place — keeps this presence check allocation-free (reads rows directly).
fn any_quote_in_expr_id_list(store: NodeStore, ids: List<ExprId>) -> bool {
    for id in ids {
        if any_quote_in_expr(store, store.exprs.get(id)) { return true }
    }
    false
}

fn any_quote_in_field_inits(store: NodeStore, list: List<FieldInit>) -> bool {
    mut i = 0
    while i < list.length {
        if any_quote_in_expr(store, store.exprs.get(list[i].value_id)) { return true }
        i = i + 1
    }
    false
}

/// cai8: the presence scan must walk match-arm guards + bodies too.
/// Without this, a program whose ONLY Quote is inside a match arm
/// hits the fast-path early-return and skips lowering entirely —
/// the un-lowered Quote nodes then survive into eval and trigger
/// `no eval_expr handler`. Same shape as `lower_match_arms`.
fn any_quote_in_match_arms(store: NodeStore, arms: List<MatchArm>) -> bool {
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard_id != null && any_quote_in_expr(store, store.exprs.get(arm.guard_id!)) { return true }
        if any_quote_in_expr(store, store.exprs.get(arm.body_id)) { return true }
        i = i + 1
    }
    false
}

// ── Runtime-quote gate (i0yg) ──
//
// A `quote { ... }` is a compile-time metaprogramming construct: it lowers to
// the comptime-only `synth_*` node-id shims, which the comptime evaluator
// intercepts and which have NO compiled body — so a quote reached by COMPILED
// (non-`@comptime`) code would hit the `exit(99)` synth guard at run time. This
// pass runs BEFORE `lower_quotes`, while each quote is still one `Expr.Quote`
// node carrying its real span, and reports F4009 for every quote reached in a
// NON-`@comptime` function. `@comptime` fns — and `@expand` macros, which ARE
// `@comptime` fns — are exempt: their bodies run only at compile time and
// legitimately build AST. Reporting here (one node ⇒ one diagnostic at the
// quote's own span) is why the gate is NOT in a post-lowering pass: by then a
// single quote has exploded into a tree of `synth_*` leaves with synthetic
// spans. The walk mirrors `lower_expr`/`lower_stmt` exactly, so it flags
// precisely the quotes the lowering would lower (and no more).

/// True iff `annots` carries `@comptime` (marks a compile-time-only decl).
fn annots_have_comptime(annots: List<Annotation>) -> bool {
    mut i = 0
    while i < annots.length {
        if annots[i].name == "comptime" { return true }
        i = i + 1
    }
    false
}

/// Report F4009 for every runtime (non-`@comptime`) `quote { ... }` under
/// `ids`. Returns a fresh bag — empty when every quote sits in comptime code
/// (the common case), so the shared no-quote fast-path returns it untouched.
export fn report_runtime_quotes(store: NodeStore, ids: List<StmtId>) -> DiagnosticBag {
    if !any_quote_in_stmt_ids(store, ids) { return bag_new() }
    rq_stmt_ids(store, ids, false, bag_new())
}

fn rq_stmt_ids(store: NodeStore, ids: List<StmtId>, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    mut cur = bag
    for id in ids { cur = rq_stmt(store, store.stmts.get(id), in_ct, cur) }
    cur
}

fn rq_stmt(store: NodeStore, stmt: Stmt, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    match stmt {
        .Let(_, _, init) -> rq_expr(store, init, in_ct, bag)
        .Mut(_, _, init) -> rq_expr(store, init, in_ct, bag)
        .Const(_, _, init) -> rq_expr(store, init, in_ct, bag)
        .Expr(e) -> rq_expr(store, e, in_ct, bag)
        .Return(e) -> rq_expr(store, e, in_ct, bag)
        .Block(body) -> rq_stmt_ids(store, body, in_ct, bag)
        .If(cond, then_b, else_b) -> {
            let b2 = rq_stmt(store, store.stmts.get(then_b), in_ct, rq_expr(store, cond, in_ct, bag))
            if else_b != null { rq_stmt(store, store.stmts.get(else_b!), in_ct, b2) } else { b2 }
        }
        .While(cond, body) -> rq_stmt(store, store.stmts.get(body), in_ct, rq_expr(store, cond, in_ct, bag))
        .For(_, start, end, body) -> rq_stmt(store, store.stmts.get(body), in_ct, rq_expr(store, end, in_ct, rq_expr(store, start, in_ct, bag)))
        .ForIn(_, coll, body) -> rq_stmt(store, store.stmts.get(body), in_ct, rq_expr(store, coll, in_ct, bag))
        // A plain `fn` keeps the enclosing comptime context; a `@comptime` fn
        // gets `in_ct = true` via its `.Annotated` wrapper below.
        .Function(_, _, _, _, body) -> rq_stmt_ids(store, body, in_ct, bag)
        .Impl(_, methods) -> rq_stmt_ids(store, methods, in_ct, bag)
        .Annotated(annots, inner) -> rq_stmt(store, store.stmts.get(inner), in_ct || annots_have_comptime(annots), bag)
        .Module(_, body) -> rq_stmt_ids(store, body, in_ct, bag)
        .ComponentDef(_, _, _, _, _, body) -> rq_stmt_ids(store, body, in_ct, bag)
        .ComponentBlock(_, _, _, body) -> rq_stmt_ids(store, body, in_ct, bag)
        .SpecBlock(_, body) -> rq_stmt_ids(store, body, in_ct, bag)
        .GivenBlock(_, body) -> rq_stmt_ids(store, body, in_ct, bag)
        .ThenBlock(_, cond) -> rq_expr(store, cond, in_ct, bag)
        .Match(subj, arms) -> rq_match_arms(store, arms, in_ct, rq_expr(store, subj, in_ct, bag))
        .Defer(body) -> rq_expr(store, body, in_ct, bag)
        .Errdefer(body) -> rq_expr(store, body, in_ct, bag)
        .LetDestructure(_, init) -> rq_expr(store, init, in_ct, bag)
        .TraitDecl(_, methods) -> rq_stmt_ids(store, methods, in_ct, bag)
        .Parallel(body) -> rq_stmt_ids(store, body, in_ct, bag)
        _ -> bag
    }
}

fn rq_expr(store: NodeStore, id: ExprId, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    match store.exprs.get(id) {
        // The quote itself: legal in comptime code (lowers to synth shims the
        // evaluator handles), F4009 in runtime code. Reported ONCE at the
        // quote's own node — the body is NOT walked (a nested quote collapses,
        // and the whole quote is a single error).
        .Quote(_, _) -> if in_ct { bag } else { rq_report(store, id, bag) }
        .Splice(target) -> rq_expr(store, target, in_ct, bag)
        .Binary(l, _, r) -> rq_expr(store, r, in_ct, rq_expr(store, l, in_ct, bag))
        .Unary(_, r) -> rq_expr(store, r, in_ct, bag)
        .Logical(l, _, r) -> rq_expr(store, r, in_ct, rq_expr(store, l, in_ct, bag))
        .Call(callee, args) -> rq_expr_ids(store, args, in_ct, rq_expr(store, callee, in_ct, bag))
        .GenericCall(callee, _, args) -> rq_expr_ids(store, args, in_ct, rq_expr(store, callee, in_ct, bag))
        .Grouping(inner) -> rq_expr(store, inner, in_ct, bag)
        .Block(body) -> rq_stmt_ids(store, body, in_ct, bag)
        .IfExpr(c, t, e) -> rq_expr(store, e, in_ct, rq_expr(store, t, in_ct, rq_expr(store, c, in_ct, bag)))
        .Assign(_, v) -> rq_expr(store, v, in_ct, bag)
        .StructLit(_, inits) -> rq_field_inits(store, inits, in_ct, bag)
        .FieldAccess(obj, _) -> rq_expr(store, obj, in_ct, bag)
        .FieldAssign(obj, _, v) -> rq_expr(store, v, in_ct, rq_expr(store, obj, in_ct, bag))
        .EnumCtor(_, _, args) -> rq_expr_ids(store, args, in_ct, bag)
        .Index(obj, idx) -> rq_expr(store, idx, in_ct, rq_expr(store, obj, in_ct, bag))
        .NullCoalesce(l, r) -> rq_expr(store, r, in_ct, rq_expr(store, l, in_ct, bag))
        .OptionalChain(obj, _) -> rq_expr(store, obj, in_ct, bag)
        .OptionalMethodCall(obj, _, args) -> rq_expr_ids(store, args, in_ct, rq_expr(store, obj, in_ct, bag))
        .Try(inner) -> rq_expr(store, inner, in_ct, bag)
        .Tuple(elems) -> rq_expr_ids(store, elems, in_ct, bag)
        .TupleIndex(obj, _) -> rq_expr(store, obj, in_ct, bag)
        .With(obj, overrides) -> rq_field_inits(store, overrides, in_ct, rq_expr(store, obj, in_ct, bag))
        .ListLit(elems) -> rq_expr_ids(store, elems, in_ct, bag)
        .Lambda(_, body) -> rq_expr(store, body, in_ct, bag)
        .MapLit(entries) -> rq_expr_ids(store, entries, in_ct, bag)
        .Slice(obj, s, e) -> rq_expr(store, e, in_ct, rq_expr(store, s, in_ct, rq_expr(store, obj, in_ct, bag)))
        .IsCheck(subj, _) -> rq_expr(store, subj, in_ct, bag)
        .InCheck(needle, items) -> rq_expr_ids(store, items, in_ct, rq_expr(store, needle, in_ct, bag))
        .Spawn(body) -> rq_expr(store, body, in_ct, bag)
        .Isolated(body) -> rq_expr(store, body, in_ct, bag)
        .MatchExpr(subj, arms) -> rq_match_arms(store, arms, in_ct, rq_expr(store, subj, in_ct, bag))
        // Same expression positions lower_expr now recurses into — a runtime
        // quote nested in a `when`/`catch`/comprehension/channel-capacity body
        // must be gated here too (else it lowers to run-time-aborting shims).
        .When(arms) -> rq_when_arms(store, arms, in_ct, bag)
        .Catch(inner, _, body, _, _) -> rq_expr(store, body, in_ct, rq_expr(store, inner, in_ct, bag))
        .ListComp(body, _, collection, filter) -> {
            let b1 = rq_expr(store, body, in_ct, rq_expr(store, collection, in_ct, bag))
            if filter != null { rq_expr(store, filter!, in_ct, b1) } else { b1 }
        }
        .ChannelNew(_, capacity) -> if capacity != null { rq_expr(store, capacity!, in_ct, bag) } else { bag }
        _ -> bag
    }
}

fn rq_when_arms(store: NodeStore, arms: List<WhenArm>, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    mut cur = bag
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.cond_id != null { cur = rq_expr(store, arm.cond_id!, in_ct, cur) }
        cur = rq_expr(store, arm.body_id, in_ct, cur)
        i = i + 1
    }
    cur
}

fn rq_expr_ids(store: NodeStore, ids: List<ExprId>, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    mut cur = bag
    for id in ids { cur = rq_expr(store, id, in_ct, cur) }
    cur
}

fn rq_field_inits(store: NodeStore, list: List<FieldInit>, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    mut cur = bag
    mut i = 0
    while i < list.length {
        cur = rq_expr(store, list[i].value_id, in_ct, cur)
        i = i + 1
    }
    cur
}

fn rq_match_arms(store: NodeStore, arms: List<MatchArm>, in_ct: bool, bag: DiagnosticBag) -> DiagnosticBag {
    mut cur = bag
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard_id != null { cur = rq_expr(store, arm.guard_id!, in_ct, cur) }
        cur = rq_expr(store, arm.body_id, in_ct, cur)
        i = i + 1
    }
    cur
}

/// One F4009 at the quote node's own line/col. Entry-file rows carry no
/// file here (`expr_linecol` gives line/col only) — the renderer then
/// falls back to the compile's filename, exactly as the parser's own
/// expr-span diagnostics do.
fn rq_report(store: NodeStore, id: ExprId, bag: DiagnosticBag) -> DiagnosticBag {
    let lc = store.expr_linecol(id)
    let msg = "`quote { ... }` can only be used inside a `@comptime` fn or an `@expand` macro"
    bag_report(bag, diag_error(DiagCode.QuoteOutsideComptime, msg, span_at(0, 0, lc.line, lc.col, "")))
}

// ── Top-level walker (mirrors comptime/rewrite.av structure) ──

/// Lower every root statement row: each rewritten child is a fresh row
/// inheriting the original's span + position (`restmt`, via
/// `lower_stmt_id`). Arena-id-native (F4e).
fn lower_stmt_ids(store: NodeStore, ids: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    for id in ids { out.push(lower_stmt_id(store, id)) }
    out
}

/// Lower one statement row. A statement with NO `Quote` anywhere beneath it
/// is UNCHANGED by lowering — this pass rewrites only `Quote` nodes — so its
/// id is returned IN PLACE: no `restmt`, no descent. Reallocation is confined
/// to the spine of statements above each quote. `any_quote_in_stmt` is the very
/// predicate the whole-program fast-path already trusts (`lower_quotes`),
/// applied per-subtree, so this adds no new correctness assumption — only
/// finer-grained reuse.
fn lower_stmt_id(store: NodeStore, id: StmtId) -> StmtId {
    if !any_quote_in_stmt(store, store.stmts.get(id)) { return id }
    store.restmt(lower_stmt(store, store.stmts.get(id)), id)
}

/// Lower one expression row. Like `lower_stmt_id`: a quote-free expression
/// subtree is returned in place (no `reexpr`, no descent), since only `Quote`
/// nodes are rewritten — so a `Binary`/`Call`/… whose operands hold no quote
/// keeps its original row.
fn lower_expr_id(store: NodeStore, id: ExprId) -> ExprId {
    if !any_quote_in_expr(store, store.exprs.get(id)) { return id }
    store.reexpr(lower_expr(store, store.exprs.get(id)), id)
}

fn lower_stmt(store: NodeStore, stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, vt, lower_expr_id(store, init))
        .Mut(name, vt, init) -> .Mut(name, vt, lower_expr_id(store, init))
        .Const(name, vt, init) -> .Const(name, vt, lower_expr_id(store, init))
        .Expr(e) -> .Expr(lower_expr_id(store, e))
        .Return(e) -> .Return(lower_expr_id(store, e))
        .Block(body) -> .Block(lower_stmt_ids(store, body))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(lower_expr_id(store, cond), lower_stmt_id(store, then_b), lower_stmt_id(store, else_b!))
            } else {
                .If(lower_expr_id(store, cond), lower_stmt_id(store, then_b), null)
            }
        }
        .While(cond, body) -> .While(lower_expr_id(store, cond), lower_stmt_id(store, body))
        .For(v, start, end, body) -> .For(v, lower_expr_id(store, start), lower_expr_id(store, end), lower_stmt_id(store, body))
        .ForIn(v, coll, body) -> .ForIn(v, lower_expr_id(store, coll), lower_stmt_id(store, body))
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, lower_stmt_ids(store, body))
        .Impl(type_name, methods) -> .Impl(type_name, lower_stmt_ids(store, methods))
        .Annotated(annots, inner) -> .Annotated(annots, lower_stmt_id(store, inner))
        .Module(name, body) -> .Module(name, lower_stmt_ids(store, body))
        .ComponentDef(name, params, config, children, implements, body) -> .ComponentDef(name, params, config, children, implements, lower_stmt_ids(store, body))
        .ComponentBlock(comp, inst, config, body) -> .ComponentBlock(comp, inst, config, lower_stmt_ids(store, body))
        .SpecBlock(name, body) -> .SpecBlock(name, lower_stmt_ids(store, body))
        .GivenBlock(name, body) -> .GivenBlock(name, lower_stmt_ids(store, body))
        .ThenBlock(name, cond) -> .ThenBlock(name, lower_expr_id(store, cond))
        .Match(subj, arms) -> .Match(lower_expr_id(store, subj), lower_match_arms(store, arms))
        .Defer(body) -> .Defer(lower_expr_id(store, body))
        .Errdefer(body) -> .Errdefer(lower_expr_id(store, body))
        .LetDestructure(names, init) -> .LetDestructure(names, lower_expr_id(store, init))
        .TraitDecl(name, methods) -> .TraitDecl(name, lower_stmt_ids(store, methods))
        .Parallel(body) -> .Parallel(lower_stmt_ids(store, body))
        _ -> stmt
    }
}

/// Walk an Expr, replacing any Quote node with its AST-construction
/// form. Recurses into every container variant so an inner
/// `quote { ... }` nested inside (e.g.) a struct-literal field or
/// match-arm body is also lowered. Leaves (Number/String/Bool/Null/
/// Ident/QualifiedIdent/FloatLit) hit the catch-all and pass through.
fn lower_expr(store: NodeStore, expr: Expr) -> Expr {
    match expr {
        .Quote(kind, body) -> dispatch_quote_kind(store, kind, store.exprs.get(body))
        .Binary(l, op, r) -> .Binary(lower_expr_id(store, l), op, lower_expr_id(store, r))
        .Unary(op, r) -> .Unary(op, lower_expr_id(store, r))
        .Logical(l, op, r) -> .Logical(lower_expr_id(store, l), op, lower_expr_id(store, r))
        .Call(callee, args) -> .Call(lower_expr_id(store, callee), lower_expr_list_ids(store, args))
        .GenericCall(callee, ta, args) -> .GenericCall(lower_expr_id(store, callee), ta, lower_expr_list_ids(store, args))
        .Grouping(inner) -> .Grouping(lower_expr_id(store, inner))
        .Block(body) -> .Block(lower_stmt_ids(store, body))
        .IfExpr(c, t, e) -> .IfExpr(lower_expr_id(store, c), lower_expr_id(store, t), lower_expr_id(store, e))
        .Assign(name, v) -> .Assign(name, lower_expr_id(store, v))
        .StructLit(name, inits) -> .StructLit(name, lower_field_inits(store, inits))
        .FieldAccess(obj, field) -> .FieldAccess(lower_expr_id(store, obj), field)
        .FieldAssign(obj, field, v) -> .FieldAssign(lower_expr_id(store, obj), field, lower_expr_id(store, v))
        .EnumCtor(tn, variant, args) -> .EnumCtor(tn, variant, lower_expr_list_ids(store, args))
        .Index(obj, idx) -> .Index(lower_expr_id(store, obj), lower_expr_id(store, idx))
        .NullCoalesce(l, r) -> .NullCoalesce(lower_expr_id(store, l), lower_expr_id(store, r))
        .OptionalChain(obj, field) -> .OptionalChain(lower_expr_id(store, obj), field)
        .OptionalMethodCall(obj, method, args) -> .OptionalMethodCall(lower_expr_id(store, obj), method, lower_expr_list_ids(store, args))
        .Try(inner) -> .Try(lower_expr_id(store, inner))
        .Tuple(elems) -> .Tuple(lower_expr_list_ids(store, elems))
        .TupleIndex(obj, idx) -> .TupleIndex(lower_expr_id(store, obj), idx)
        .With(obj, overrides) -> .With(lower_expr_id(store, obj), lower_field_inits(store, overrides))
        .ListLit(elems) -> .ListLit(lower_expr_list_ids(store, elems))
        .Lambda(params, body) -> .Lambda(params, lower_expr_id(store, body))
        .MapLit(entries) -> .MapLit(lower_expr_list_ids(store, entries))
        .Slice(obj, s, e) -> .Slice(lower_expr_id(store, obj), lower_expr_id(store, s), lower_expr_id(store, e))
        .IsCheck(subj, vname) -> .IsCheck(lower_expr_id(store, subj), vname)
        .InCheck(needle, items) -> .InCheck(lower_expr_id(store, needle), lower_expr_list_ids(store, items))
        .Spawn(body) -> .Spawn(lower_expr_id(store, body))
        .Isolated(body) -> .Isolated(lower_expr_id(store, body))
        .MatchExpr(subj, arms) -> .MatchExpr(lower_expr_id(store, subj), lower_match_arms(store, arms))
        .Splice(target) -> .Splice(lower_expr_id(store, target))
        // A `quote { }` nested in a subjectless-match / catch / comprehension /
        // channel-capacity body was previously left un-lowered (these fell to
        // the `_` arm), surviving to codegen as an F9999 ICE. Recurse into
        // them like every other expression container.
        .When(arms) -> .When(lower_when_arms(store, arms))
        .Catch(inner, binding, body, line, col) -> .Catch(lower_expr_id(store, inner), binding, lower_expr_id(store, body), line, col)
        .ListComp(body, variable, collection, filter) -> {
            let lf = if filter == null { null } else { lower_expr_id(store, filter!) }
            .ListComp(lower_expr_id(store, body), variable, lower_expr_id(store, collection), lf)
        }
        .ChannelNew(elem, capacity) -> {
            let lc = if capacity == null { null } else { lower_expr_id(store, capacity!) }
            .ChannelNew(elem, lc)
        }
        _ -> expr
    }
}

/// Lower quotes in `when` arms — the WhenArm sibling of `lower_match_arms`.
fn lower_when_arms(store: NodeStore, arms: List<WhenArm>) -> List<WhenArm> {
    list_map(arms, (arm: WhenArm) -> {
        let lc = if arm.cond_id == null { null } else { lower_expr_id(store, arm.cond_id!) }
        WhenArm { cond_id: lc, body_id: lower_expr_id(store, arm.body_id) }
    })
}

/// Lower quotes over a flipped `List<ExprId>` (call args) — the id twin of
/// `lower_expr_list`, via `lower_expr_id` (reexpr each arg row in place).
fn lower_expr_list_ids(store: NodeStore, ids: List<ExprId>) -> List<ExprId> {
    list_map(ids, (id: ExprId) -> lower_expr_id(store, id))
}

/// b85m: lower every Quote in match-arm guards + bodies. Without
/// this, an inline `return quote stmt { ... }` inside a match
/// arm body keeps its un-lowered Expr.Quote node, which the
/// tree-walk evaluator can't handle — the macro expansion
/// silently fails to fire.
fn lower_match_arms(store: NodeStore, arms: List<MatchArm>) -> List<MatchArm> {
    list_map(arms, (arm: MatchArm) -> {
        let lowered_guard_id = if arm.guard_id == null { null } else { lower_expr_id(store, arm.guard_id!) }
        MatchArm {
            pattern: arm.pattern,
            pattern_id: arm.pattern_id,
            guard_id: lowered_guard_id,
            body_id: lower_expr_id(store, arm.body_id),
        }
    })
}

fn lower_field_inits(store: NodeStore, inits: List<FieldInit>) -> List<FieldInit> {
    list_map(inits, (init: FieldInit) -> FieldInit {
        name: init.name,
        value_id: lower_expr_id(store, init.value_id),
    })
}

// ── Quote kind dispatch (vez6.3.10) ──

/// Dispatch on the quote kind keyword to produce the right AST type.
/// Default `expr` constructs an Expr. `stmt` extracts the single Stmt
/// inside the body block and constructs it. `stmts` constructs the
/// whole `List<StmtId>`. `decl` is currently an alias for `stmt` since
/// decls in Avra are Stmts. `type` recognizes primitive type names
/// (int / bool / float / string / bytes / void) by Ident shape —
/// generic types and structural type expressions need a parser path
/// that invokes parse_type_expr inside the braces (vez6.3.13 follow-up).
fn dispatch_quote_kind(store: NodeStore, kind: string, body: Expr) -> Expr {
    if kind == "stmt" || kind == "decl" {
        let single = extract_single_stmt(store, body)
        if single != null { return construct_stmt(store, single!) }
        // Block has 0 or 2+ statements — fall back to constructing
        // the List<StmtId> as if `stmts` was used. The user gets a
        // list instead of a Stmt, which surfaces the mismatch.
        return construct_stmt_ids(store, extract_stmt_ids(body))
    }
    if kind == "stmts" {
        return construct_stmt_ids(store, extract_stmt_ids(body))
    }
    if kind == "type" {
        return construct_value_type_from_body(store, body)
    }
    if kind == "arm" {
        // The parser wrapped the arm in a single-armed MatchExpr so
        // the Quote(body) shape stays uniform. Unbox it here and
        // construct the MatchArm value programmatically.
        let arm = extract_single_match_arm(body)
        if arm != null { return construct_match_arm(store, arm!) }
        // Malformed `quote arm { ... }` (no arm parsed) — emit a null
        // pattern arm so codegen has something well-typed; the parser
        // already reported the syntax error.
        return construct_match_arm_null(store)
    }
    // Default: kind == "expr" or unrecognized.
    construct_expr(store, unwrap_quote_body(store, body))
}

/// Pull the single MatchArm out of the synthetic `MatchExpr(Null, [arm])`
/// the parser uses to carry `quote arm { ... }` content through the
/// shared `Expr.Quote(kind, body)` envelope.
fn extract_single_match_arm(body: Expr) -> MatchArm? {
    match body {
        .MatchExpr(_, arms) -> {
            if arms.length == 1 { arms[0] } else { null }
        }
        _ -> null
    }
}

fn construct_match_arm_null(store: NodeStore) -> Expr {
    construct_match_arm(store, MatchArm {
        pattern: Pattern.Wildcard,
        guard_id: none,
        body_id: store.exprs.add_leaf(Expr.None),
    })
}

/// Lower the body of `quote type { ... }` to a ValueType-construction
/// Expr. The parser captures the type structurally as an Expr.TypeLit
/// carrier (vez6.3.14), so every compound form — List<T>, fn(A) -> B,
/// Result<T,E>, T?, A | B, tuples, maps — flows through the complete
/// construct_value_type. A bare-Ident body (a pre-carrier fallback, or
/// a splice-produced shape) still resolves its primitive name.
fn construct_value_type_from_body(store: NodeStore, body: Expr) -> Expr {
    let inner = unwrap_quote_body(store, body)
    match inner {
        .TypeLit(vt) -> construct_value_type(store, vt)
        .Ident(name) -> primitive_value_type(name)
        _ -> construct_value_type_unknown()
    }
}

fn primitive_value_type(name: string) -> Expr {
    if name == "int" { return value_type_ctor("Int") }
    if name == "bool" { return value_type_ctor("Bool") }
    if name == "float" { return value_type_ctor("Float") }
    if name == "string" { return value_type_ctor("Str") }
    if name == "bytes" { return value_type_ctor("Bytes") }
    if name == "void" { return value_type_ctor("Void") }
    if name == "ptr" { return value_type_ctor("Ptr") }
    construct_value_type_unknown()
}

fn value_type_ctor(variant: string) -> Expr {
    let empty: List<ExprId> = []
    Expr.EnumCtor("@std::avrac::core::ValueType", variant, empty)
}

/// Extract the single Stmt from a `Block(List<StmtId>)` of length 1.
/// Returns null if the block is empty or has multiple statements.
fn extract_single_stmt(store: NodeStore, body: Expr) -> Stmt? {
    match body {
        .Block(stmts) -> {
            if stmts.length == 1 { store.stmts.get(stmts[0]) } else { null }
        }
        _ -> null
    }
}

/// Extract the Block's statement rows (`List<StmtId>`); otherwise empty.
fn extract_stmt_ids(body: Expr) -> List<StmtId> {
    match body {
        .Block(stmts) -> stmts
        _ -> {
            let empty: List<StmtId> = []
            empty
        }
    }
}

// ── Quote body unwrapping ──

/// `parse_quote` currently captures the body via parse_block_expression,
/// which wraps single expressions in a Block of one Stmt.Expr.
/// For a single-expr body, peel that off so `quote { 5 }` lowers to the
/// AST of the literal 5, not the AST of a one-stmt Block.
fn unwrap_quote_body(store: NodeStore, body: Expr) -> Expr {
    match body {
        .Block(stmts) -> {
            if stmts.length == 1 {
                match store.stmts.get(stmts[0]) {
                    .Expr(inner) -> store.exprs.get(inner)
                    _ -> body
                }
            } else {
                body
            }
        }
        _ -> body
    }
}

// ── AST construction ──

/// Given an AST Expr `e`, produce another Expr that constructs `e` as
/// a runtime value when evaluated. So `construct_expr(store, Number("5"))`
/// returns the AST shape of `Expr.Number("5")` — i.e. an EnumCtor for
/// the Expr.Number variant carrying a string-literal arg "5".
///
/// Covers all leaf + structural variants needed for `quote { expr }`.
/// Block / MatchExpr / StructLit need `List<StmtId>` / `List<FieldInit>`
/// / `List<MatchArm>` constructors — landing in the next slice driven
/// by tests that need them. Other variants pass through unchanged for
/// now; downstream stages will see the raw AST and surface the missing
/// case naturally.
export fn construct_expr(store: NodeStore, e: Expr) -> Expr {
    match e {
        .Number(v) -> expr_ctor(store, "Number", string_arg(v))
        .String(v) -> expr_ctor(store, "String", string_arg(v))
        .Bool(v) -> expr_ctor(store, "Bool", string_arg(v))
        .None -> {
            let empty: List<Expr> = []
            expr_ctor(store, "None", empty)
        }
        .Ident(name) -> expr_ctor(store, "Ident", string_arg(name))
        .QualifiedIdent(path) -> expr_ctor(store, "QualifiedIdent", string_arg(path))
        .Assign(name, value) -> expr_ctor(store, "Assign", two_args(string_lit_expr(name), construct_expr_id(store, value)))
        .Binary(l, op, r) -> expr_ctor(store, "Binary", three_args(construct_expr_id(store, l), construct_binop(store, op), construct_expr_id(store, r)))
        .Unary(op, r) -> expr_ctor(store, "Unary", two_args(construct_unop(store, op), construct_expr_id(store, r)))
        .Logical(l, op, r) -> expr_ctor(store, "Logical", three_args(construct_expr_id(store, l), construct_logicop(store, op), construct_expr_id(store, r)))
        .Grouping(inner) -> expr_ctor(store, "Grouping", one_arg(construct_expr_id(store, inner)))
        .Call(callee, args) -> expr_ctor(store, "Call", two_args(construct_expr_id(store, callee), construct_expr_ids(store, args)))
        .FieldAccess(obj, field) -> expr_ctor(store, "FieldAccess", two_args(construct_expr_id(store, obj), string_lit_expr(field)))
        .Index(obj, idx) -> expr_ctor(store, "Index", two_args(construct_expr_id(store, obj), construct_expr_id(store, idx)))
        .IfExpr(c, t, el) -> expr_ctor(store, "IfExpr", three_args(construct_expr_id(store, c), construct_expr_id(store, t), construct_expr_id(store, el)))
        .Tuple(elements) -> expr_ctor(store, "Tuple", one_arg(construct_expr_ids(store, elements)))
        .ListLit(elements) -> expr_ctor(store, "ListLit", one_arg(construct_expr_ids(store, elements)))
        .NullCoalesce(l, r) -> expr_ctor(store, "NullCoalesce", two_args(construct_expr_id(store, l), construct_expr_id(store, r)))
        .OptionalChain(obj, field) -> expr_ctor(store, "OptionalChain", two_args(construct_expr_id(store, obj), string_lit_expr(field)))
        .OptionalMethodCall(obj, method, args) -> expr_ctor(store, "OptionalMethodCall", three_args(construct_expr_id(store, obj), string_lit_expr(method), construct_expr_ids(store, args)))
        .Try(inner) -> expr_ctor(store, "Try", one_arg(construct_expr_id(store, inner)))
        .FloatLit(v) -> expr_ctor(store, "FloatLit", string_arg(v))
        .StructLit(name, inits) -> expr_ctor(store, "StructLit", two_args(name_or_splice(store, name), construct_field_init_list(store, inits)))
        .EnumCtor(type_name, variant, args) -> expr_ctor(store, "EnumCtor", three_args(string_lit_expr(type_name), string_lit_expr(variant), construct_expr_ids(store, args)))
        .MapLit(entries) -> expr_ctor(store, "MapLit", one_arg(construct_expr_ids(store, entries)))
        .IsCheck(subj, vname) -> expr_ctor(store, "IsCheck", two_args(construct_expr_id(store, subj), string_lit_expr(vname)))
        .InCheck(needle, items) -> expr_ctor(store, "InCheck", two_args(construct_expr_id(store, needle), construct_expr_ids(store, items)))
        .Slice(obj, start, end) -> expr_ctor(store, "Slice", three_args(construct_expr_id(store, obj), construct_expr_id(store, start), construct_expr_id(store, end)))
        .TupleIndex(obj, idx) -> expr_ctor(store, "TupleIndex", two_args(construct_expr_id(store, obj), Expr.Number(string(idx))))
        .With(obj, overrides) -> expr_ctor(store, "With", two_args(construct_expr_id(store, obj), construct_field_init_list(store, overrides)))
        .FieldAssign(obj, field, value) -> expr_ctor(store, "FieldAssign", three_args(construct_expr_id(store, obj), string_lit_expr(field), construct_expr_id(store, value)))
        .Lambda(params, body) -> expr_ctor(store, "Lambda", two_args(construct_param_list(store, params), construct_expr_id(store, body)))
        .Spawn(body) -> expr_ctor(store, "Spawn", one_arg(construct_expr_id(store, body)))
        .Isolated(body) -> expr_ctor(store, "Isolated", one_arg(construct_expr_id(store, body)))
        .Block(body) -> expr_ctor(store, "Block", one_arg(construct_stmt_ids(store, body)))
        // MatchExpr inside a quote — subject + arms become a runtime
        // `Expr.MatchExpr` value. The arm list goes through
        // `construct_match_arm_list` which expands `~arms` sentinels
        // into `list_concat` calls.
        .MatchExpr(subject, arms) -> expr_ctor(store, "MatchExpr",
            two_args(construct_expr_id(store, subject), construct_match_arm_list(store, arms)))
        // Splice (~target) — the target evaluates at expansion time
        // to a runtime AST value of the right shape, so we emit it
        // straight through without a construct_expr wrap. That's the
        // whole point of splice: skip construction, paste the value.
        .Splice(target) -> store.exprs.get(target)
        // Nested Quote: `quote { ... quote { x } ... }` collapses one
        // level — the inner quote's BODY is what gets constructed, as
        // if the user had written `quote { ... x ... }` directly. This
        // matches the user's likely intent (inner construction is
        // already an AST-build expression) and avoids needing a meta-
        // quote machinery. Proper meta-quote (outer captures inner
        // Quote form verbatim) is a separate language design call.
        .Quote(_, body) -> construct_expr(store, unwrap_quote_body(store, store.exprs.get(body)))
        .When(_) -> e
        _ -> e
    }
}

/// Shorthand for `Expr.EnumCtor("@std::avrac::core::Expr", variant, args)`
/// — the canonical type name appears 25+ times in construct_expr, so
/// extracting it removes a thick band of visual noise and centralizes
/// the path constant.
fn expr_ctor(store: NodeStore, variant: string, args: List<Expr>) -> Expr {
    Expr.EnumCtor("@std::avrac::core::Expr", variant, ingest_exprs(store, args))
}

/// Build an Expr that, when evaluated, produces a `List<ParamEntry>`
/// AST value. Each entry is a `ParamEntry { name, vtype, ty_id }` struct
/// literal. Quote captures pre-resolve, so vtype is always Unknown —
/// the resolver fills it in when the lowered AST is re-resolved — and
/// ty_id is an explicit null dual (a constructed entry has no arena row).
fn construct_param_list(store: NodeStore, params: List<ParamEntry>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < params.length {
        let p = params[i]
        let entry_lit = struct_lit_3(store, "@std::avrac::core::ParamEntry",
                                     "name", string_lit_expr(p.name),
                                     "vtype", construct_param_vtype(store, p.vtype),
                                     "ty_id", Expr.None)
        elems.push(entry_lit)
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Synthetic field-init for the struct-literal builders. B-final F4: the
/// constructed value `v` is allocated as a fresh arena leaf and referenced by
/// its `value_id` — the boxed `value` slot is gone.
fn synth_init(store: NodeStore, k: string, v: Expr) -> FieldInit {
    FieldInit { name: k, value_id: store.exprs.add_leaf(v) }
}

/// Build a two-field struct-literal Expr `Type { k1: v1, k2: v2 }`.
/// Centralises the `Expr.StructLit(type_name, List<FieldInit> { ... })`
/// construction used by every `construct_*_list` below for the inner
/// per-entry struct literal.
fn struct_lit_2(store: NodeStore, type_name: string, k1: string, v1: Expr, k2: string, v2: Expr) -> Expr {
    mut inits: List<FieldInit> = []
    inits.push(synth_init(store, k1, v1))
    inits.push(synth_init(store, k2, v2))
    Expr.StructLit(type_name, inits)
}

/// Three-field sister to `struct_lit_2`. Wider literals build their init
/// list directly over `struct_lit` + `synth_init`.
fn struct_lit_3(store: NodeStore, type_name: string, k1: string, v1: Expr, k2: string, v2: Expr, k3: string, v3: Expr) -> Expr {
    mut inits: List<FieldInit> = []
    inits.push(synth_init(store, k1, v1))
    inits.push(synth_init(store, k2, v2))
    inits.push(synth_init(store, k3, v3))
    Expr.StructLit(type_name, inits)
}

/// Build an Expr that, when evaluated, produces a `Pattern` AST
/// value. Mirrors the variant shape of `core::ast::Pattern` —
/// emits an `Expr.EnumCtor("Pattern", VariantName, [args])` for
/// each case. Used by `construct_match_arm` and (in the future)
/// by quote_expr's pattern-position splices.
fn construct_pattern(store: NodeStore, p: Pattern) -> Expr {
    match p {
        .Wildcard -> pattern_ctor(store, "Wildcard", [])
        .Rest -> pattern_ctor(store, "Rest", [])
        .Variant(name, bindings) -> {
            let args: List<Expr> = [
                string_lit_expr(name),
                construct_param_list(store, bindings),
            ]
            pattern_ctor(store, "Variant", args)
        }
        .LitString(value) -> {
            let args: List<Expr> = [string_lit_expr(value)]
            pattern_ctor(store, "LitString", args)
        }
        .LitInt(value) -> {
            let args: List<Expr> = [Expr.Number(string(value))]
            pattern_ctor(store, "LitInt", args)
        }
        .LitBool(value) -> {
            let args: List<Expr> = [Expr.Number(string(value))]
            pattern_ctor(store, "LitBool", args)
        }
        .LitFloat(value) -> {
            let args: List<Expr> = [string_lit_expr(value)]
            pattern_ctor(store, "LitFloat", args)
        }
        .NestedVariant(name, sub_patterns) -> {
            let args: List<Expr> = [
                string_lit_expr(name),
                construct_pattern_list(store, sub_patterns),
            ]
            pattern_ctor(store, "NestedVariant", args)
        }
        .Or(left, right) -> {
            let args: List<Expr> = [
                construct_pattern(store, store.pats.get(left)),
                construct_pattern(store, store.pats.get(right)),
            ]
            pattern_ctor(store, "Or", args)
        }
        .TypePattern(type_name, binding) -> {
            let args: List<Expr> = [
                string_lit_expr(type_name),
                string_lit_expr(binding),
            ]
            pattern_ctor(store, "TypePattern", args)
        }
    }
}

fn pattern_ctor(store: NodeStore, variant: string, args: List<Expr>) -> Expr {
    Expr.EnumCtor("@std::avrac::core::Pattern", variant, ingest_exprs(store, args))
}

fn construct_pattern_list(store: NodeStore, patterns: List<PatId>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < patterns.length {
        elems.push(construct_pattern(store, store.pats.get(patterns[i])))
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build an Expr that, when evaluated, produces a `MatchArm` AST value.
/// Emits `Expr.StructLit("MatchArm", { pattern, pattern_id, guard_id, body_id })`.
/// `pattern_id` is the `Expr.None` sentinel (the constructed arm is a NEW
/// synthetic tree whose pattern row is allocated on re-ingest); guard_id/body_id
/// are reified through `construct_expr_id` (see the inline comment below).
fn construct_match_arm(store: NodeStore, arm: MatchArm) -> Expr {
    // B-final F4b: guard/body are arena ids, so reify them through the
    // `synth_expr_id` shim (`construct_expr_id`) — that types the generated
    // `guard_id`/`body_id` inits as `ExprId`, exactly what the decoder's
    // `value_to_expr_id` re-ingests (the same round-trip `EnumCtor.args` uses).
    // An absent guard reifies as the `Expr.None` sentinel the decoder reads as
    // "no guard".
    let pattern_expr = construct_pattern(store, arm.pattern)
    let guard_expr = if arm.guard_id != null { construct_expr_id(store, arm.guard_id!) } else { Expr.None }
    let body_expr = construct_expr_id(store, arm.body_id)
    mut inits: List<FieldInit> = []
    inits.push(synth_init(store, "pattern", pattern_expr))
    inits.push(synth_init(store, "pattern_id", Expr.None))
    inits.push(synth_init(store, "guard_id", guard_expr))
    inits.push(synth_init(store, "body_id", body_expr))
    Expr.StructLit("@std::avrac::core::MatchArm", inits)
}

/// Build an Expr that, when evaluated, produces a `List<MatchArm>`
/// AST value. Walks the arm list partitioning into segments around
/// any splice-sentinel arms — the segments between sentinels become
/// `ListLit` of arm struct lits, the sentinels emit their splice
/// target directly, and the whole result is wired together via
/// `list_concat` calls.
///
/// A `~target` in match-arm position lands here as a sentinel
/// `MatchArm { pattern: TypePattern("__quote_splice_arms__", ""),
/// body_id: <Splice(target) row> }` produced by `parse_match_arm_list`
/// when inside a quote.
fn construct_match_arm_list(store: NodeStore, arms: List<MatchArm>) -> Expr {
    mut result_opt: Expr? = null
    mut current_seg: List<Expr> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let is_sentinel = is_arm_splice_sentinel(arm)
        if is_sentinel {
            let seg_lit = listlit_of(store, current_seg)
            result_opt = if result_opt == null { seg_lit } else { list_concat_call(store, result_opt!, seg_lit) }
            let splice_target = extract_splice_target(store, store.exprs.get(arm.body_id))
            result_opt = list_concat_call(store, result_opt!, splice_target)
            current_seg = []
        } else {
            let arm_lit = construct_match_arm(store, arm)
            current_seg = current_seg.push(arm_lit)
        }
        i = i + 1
    }
    let final_seg = listlit_of(store, current_seg)
    if result_opt == null { final_seg } else { list_concat_call(store, result_opt!, final_seg) }
}

/// Detect the splice-sentinel arm produced by `parse_match_arm_list`
/// inside a quote when it sees `~target` in arm position.
fn is_arm_splice_sentinel(arm: MatchArm) -> bool {
    match arm.pattern {
        .TypePattern(tn, _) -> tn == "__quote_splice_arms__"
        _ -> false
    }
}

/// Unwrap the splice expression from a sentinel arm's body slot.
/// The parser stores it as `Expr.Splice(target)`; we want just the
/// target so its runtime value (a `List<MatchArm>`) flows into
/// `list_concat` directly.
fn extract_splice_target(store: NodeStore, body: Expr) -> Expr {
    match body {
        .Splice(t) -> store.exprs.get(t)
        _ -> body
    }
}

/// Emit `@std::avrac::list_ops::list_concat(left, right)` as a Call
/// expression. The runtime fn is monomorphized per-element-type by
/// the existing generic dispatch, so the resulting AST type-checks
/// against whatever element type the surrounding context expects.
fn list_concat_call(store: NodeStore, left: Expr, right: Expr) -> Expr {
    Expr.Call(
        store.exprs.add_leaf(Expr.QualifiedIdent("@std::avrac::list_ops::list_concat")),
        [store.exprs.add_leaf(left), store.exprs.add_leaf(right)]
    )
}

/// Build an Expr that, when evaluated, produces a single
/// `Annotation { name, arg_ids }` value. Step 4 — needed so a macro's
/// quote-emitted `@expand(...)` annotation roundtrips through the expand
/// pass's fixpoint loop and the inner @expand re-fires. Args are arena-only:
/// the id row is emitted as `synth_expr_id`-shaped elements decoded by
/// `list_value_to_expr_id_list`.
fn construct_annotation(store: NodeStore, a: Annotation) -> Expr {
    struct_lit_2(store, "@std::avrac::core::Annotation",
        "name", string_lit_expr(a.name),
        "arg_ids", construct_arg_id_list(store, a.arg_ids))
}

/// Reconstruct an annotation's `List<ExprId>` arg row: each element a
/// `synth_expr_id(construct_expr(...))` call so the ListLit eval yields
/// id-shaped values. Null (no row) produces an empty list.
fn construct_arg_id_list(store: NodeStore, ids: List<ExprId>?) -> Expr {
    mut elems: List<Expr> = []
    if ids != none {
        for id in ids! {
            elems.push(construct_expr_id(store, id))
        }
    }
    listlit_of(store, elems)
}

/// Build an Expr producing a `List<Annotation>` AST value at
/// runtime. Each entry uses `construct_annotation`.
fn construct_annotation_list(store: NodeStore, annots: List<Annotation>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < annots.length {
        elems.push(construct_annotation(store, annots[i]))
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build an Expr that, when evaluated, produces a
/// `List<TypeParamEntry>` AST value. Each entry is a struct literal
/// `TypeParamEntry { name, bounds }`; the result is an `Expr.ListLit`
/// so codegen materializes a real list at runtime.
fn construct_type_param_list(store: NodeStore, tp: List<TypeParamEntry>) -> Expr {
    // Walk source order, pushing each struct-literal Expr into the
    // ListLit element list.
    mut elems: List<Expr> = []
    mut i = 0
    while i < tp.length {
        let e = tp[i]
        let struct_lit = struct_lit_2(store, "@std::avrac::core::TypeParamEntry",
            "name", string_lit_expr(e.name),
            "bounds", string_lit_expr(e.bounds))
        elems.push(struct_lit)
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build an Expr that, when evaluated, produces a `List<FieldEntry>`
/// AST value. Each entry is a struct literal `FieldEntry { name,
/// resolved }`; the result is an `Expr.ListLit` so codegen
/// materializes a real list at runtime. Quote captures pre-resolve
/// so every entry's `resolved` slot is encoded as
/// `ValueType.Unknown` — sister convention to `construct_param_list`.
fn construct_field_list(store: NodeStore, fields: List<FieldEntry>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        // Preserve the field's actual `resolved` ValueType — pre-resolve
        // quote-captured fields are still Unknown (and encode as such);
        // post-resolve 2-arg @expand macros receive fields with real
        // types so they can introspect variants without needing a
        // separate resolver query per field.
        let struct_lit = struct_lit_2(store, "@std::avrac::core::FieldEntry",
            "name", string_lit_expr(e.name),
            "resolved", construct_value_type(store, e.resolved))
        elems.push(struct_lit)
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build an Expr that, when evaluated, produces a `List<Variant>` AST
/// value. Each entry is a struct literal `Variant { name, fields }`
/// where `fields` reuses `construct_field_list`. Mirrors
/// `construct_field_list`'s shape so the decoder side can roundtrip
/// EnumDecl payloads via `list_value_to_variant_list`.
fn construct_variant_list(store: NodeStore, variants: List<Variant>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < variants.length {
        let v = variants[i]
        let struct_lit = struct_lit_2(store, "@std::avrac::core::Variant",
            "name", string_lit_expr(v.name),
            "fields", construct_field_list(store, v.fields))
        elems.push(struct_lit)
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build an Expr that, when evaluated, produces a
/// `List<CompConfigPair>` AST value. Each entry is a struct
/// literal `CompConfigPair { key, value }`; the result is an
/// `Expr.ListLit` so codegen materializes a real list at runtime.
fn construct_comp_config_pair_list(store: NodeStore, list: List<CompConfigPair>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < list.length {
        let pair = list[i]
        let struct_lit = struct_lit_2(store, "@std::avrac::core::CompConfigPair",
            "key", string_lit_expr(pair.key),
            "value", construct_expr(store, pair.value))
        elems.push(struct_lit)
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Emit `ValueType.Unknown` — quote captures pre-resolve, so all types
/// are Unknown until the lowered AST is type-checked. Avoids the
/// complexity of constructing every ValueType variant.
/// Encode a ParamEntry's vtype for quote lowering. Splice case
/// (qa6i probe 3): when the vtype is `ValueType.Struct(name, _)`
/// with `name` starting with `~`, the parser captured a `~ident`
/// splice in type position — emit a runtime `ValueType.Struct(<ident>, 0)`
/// ctor whose first arg is an `Expr.Ident` referencing the macro's
/// local. Otherwise fall back to `ValueType.Unknown` (preserving the
/// existing quote-captures-pre-resolve convention so the lowered AST
/// re-resolves through the normal pipeline).
fn construct_param_vtype(store: NodeStore, vt: ValueType) -> Expr {
    match vt {
        .Struct(name, type_args, id) -> {
            if is_splice_name(name) {
                value_type_ctor_args(store, "Struct",
                    three_args(name_or_splice(store, name),
                               construct_value_type_list(store, type_args),
                               int_lit_expr(id)))
            } else {
                construct_value_type_unknown()
            }
        }
        _ -> construct_value_type_unknown()
    }
}

fn construct_value_type_unknown() -> Expr {
    let empty: List<ExprId> = []
    Expr.EnumCtor("@std::avrac::core::ValueType", "Unknown", empty)
}

/// Build an Expr that, when evaluated, produces a `ValueType` Value
/// matching `vt`. Sister to the decoder `enum_value_to_value_type` at
/// the eval boundary (features/eval/mod.av) — pin the
/// encoder/decoder contract for every declared ValueType variant so
/// future quote-surface work can preserve typed positions without
/// re-deriving the mapping.
///
/// Currently unused by the quote-lowering passes (which keep emitting
/// `construct_value_type_unknown` to preserve pre-resolve semantics);
/// available for callers that want to embed a typed ValueType literal
/// without round-tripping through quote.
fn construct_value_type(store: NodeStore, vt: ValueType) -> Expr {
    match vt {
        .Int     -> value_type_ctor("Int")
        .U8      -> value_type_ctor("U8")
        .U16     -> value_type_ctor("U16")
        .U32     -> value_type_ctor("U32")
        .U64     -> value_type_ctor("U64")
        .I8      -> value_type_ctor("I8")
        .I16     -> value_type_ctor("I16")
        .I32     -> value_type_ctor("I32")
        .Bool    -> value_type_ctor("Bool")
        .Float   -> value_type_ctor("Float")
        .Str     -> value_type_ctor("Str")
        .Bytes   -> value_type_ctor("Bytes")
        .Void    -> value_type_ctor("Void")
        .Ptr     -> value_type_ctor("Ptr")
        .Map(key, value) -> value_type_ctor_args(store, "Map",
            two_args(construct_value_type(store, key),
                     construct_value_type(store, value)))
        .Unknown -> value_type_ctor("Unknown")
        .Struct(name, type_args, id) -> value_type_ctor_args(store, "Struct",
            three_args(name_or_splice(store, name),
                       construct_value_type_list(store, type_args),
                       int_lit_expr(id)))
        .Enum(name, type_args, id) -> value_type_ctor_args(store, "Enum",
            three_args(string_lit_expr(name),
                       construct_value_type_list(store, type_args),
                       int_lit_expr(id)))
        .Tuple(elements) -> value_type_ctor_args(store, "Tuple",
            one_arg(construct_value_type_list(store, elements)))
        .List(elem) -> value_type_ctor_args(store, "List",
            one_arg(construct_value_type(store, elem)))
        .Fn(ret) -> value_type_ctor_args(store, "Fn",
            one_arg(construct_value_type(store, ret)))
        .Closure(num_captures, ret) -> value_type_ctor_args(store, "Closure",
            two_args(int_lit_expr(num_captures), construct_value_type(store, ret)))
        .FnTyped(params, ret) -> value_type_ctor_args(store, "FnTyped",
            two_args(construct_value_type_list(store, params),
                     construct_value_type(store, ret)))
        .Trait(name, id) -> value_type_ctor_args(store, "Trait",
            two_args(string_lit_expr(name), int_lit_expr(id)))
        .Union(types) -> value_type_ctor_args(store, "Union",
            one_arg(construct_value_type_list(store, types)))
        .Newtype(name, inner, id) -> value_type_ctor_args(store, "Newtype",
            three_args(string_lit_expr(name),
                       construct_value_type(store, inner),
                       int_lit_expr(id)))
        .NarrowedEnum(enum_name, variant_name, id) -> value_type_ctor_args(store, "NarrowedEnum",
            three_args(string_lit_expr(enum_name),
                       string_lit_expr(variant_name),
                       int_lit_expr(id)))
        .Task(result_ty) -> value_type_ctor_args(store, "Task",
            one_arg(construct_value_type(store, result_ty)))
        .Channel(elem) -> value_type_ctor_args(store, "Channel",
            one_arg(construct_value_type(store, elem)))
        .Optional(inner) -> value_type_ctor_args(store, "Optional",
            one_arg(construct_value_type(store, inner)))
    }
}

/// Variant with payload args. Sister to value_type_ctor for the
/// payload-bearing arms above.
fn value_type_ctor_args(store: NodeStore, variant: string, args: List<Expr>) -> Expr {
    Expr.EnumCtor("@std::avrac::core::ValueType", variant, ingest_exprs(store, args))
}

/// Build an Expr that produces a `List<ValueType>` Value at runtime.
/// Mirrors construct_field_list / construct_type_param_list: ListLit
/// of constructed entries.
fn construct_value_type_list(store: NodeStore, types: List<ValueType>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < types.length {
        elems.push(construct_value_type(store, types[i]))
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build `Expr.Number("<n>")` — used by construct_value_type for the
/// integer id slots on Struct / Enum / Trait / Newtype / NarrowedEnum.
fn int_lit_expr(n: int) -> Expr {
    Expr.Number(string(n))
}

/// Build an Expr that, when evaluated, produces a
/// `List<FieldInit>` AST value. Each entry materialises as a
/// `FieldInit { name, value }` struct literal; the result is an
/// `Expr.ListLit` so codegen produces a real list at runtime.
/// Mirrors `construct_type_param_list` shape — same pattern, same
/// reverse-walk-to-preserve-source-order.
fn construct_field_init_list(store: NodeStore, list: List<FieldInit>) -> Expr {
    mut elems: List<Expr> = []
    mut i = 0
    while i < list.length {
        let init = list[i]
        // B-final F4: FieldInit is now {name, value_id} — reconstruct the value
        // sub-tree and re-ingest it to a fresh id at expand time via the
        // `synth_expr_id` shim (the same mechanism Block/EnumCtor use for their
        // flipped id payloads).
        let struct_lit = struct_lit_2(store, "@std::avrac::core::FieldInit",
            "name", string_lit_expr(init.name),
            "value_id", construct_expr_id(store, init.value_id))
        elems.push(struct_lit)
        i = i + 1
    }
    listlit_of(store, elems)
}

/// Build an `Expr.String` whose runtime arg-after-strip_quotes is
/// exactly `s`. Codegen unwraps one outer quote pair, so we wrap with
/// exactly one. Used both bare and via `string_arg(s)` (which wraps
/// the result in a one-element `List<ExprId>` for ctor() args).
///
/// For inputs whose `s` ALREADY contains source-form quotes (parser's
/// Expr.String.value), the same wrap is correct: the runtime value
/// after strip_quotes is just `s` itself, including the inner quotes.
/// That's the round-trip property — programmatic AST construction
/// safely embeds literal `"` chars without re-parsing.
fn string_lit_expr(s: string) -> Expr {
    Expr.String("\"${s}\"")
}

/// Identifier-position splice. The parser records a name slot that
/// contained `~ident` by embedding `~ident` directly in the stored name
/// string. This happens in four places:
///   - a type's name:            `type ~T = { ... }`     → `~T`
///   - an impl target:           `impl Tr for ~T { ... }`→ `Tr:~T`
///   - an impl method (mangled): the same impl's methods → `~T__method`
///   - a struct-literal ctor:    `~T { ... }`            → `~T`
///
/// At expansion time each `~ident` must resolve to the live value of the
/// macro's local `ident`. This builds an Expr that, when evaluated,
/// reconstructs the final name: literal chunks become string literals,
/// each `~ident` becomes `Expr.Ident(ident)`, and the pieces are joined
/// with `+`. A name with no `~` is a plain string literal (fast path).
///
/// Splice boundaries are unambiguous — an identifier ends at the first
/// `__` (the method / variant mangling separator, which spec Axis 28
/// forbids inside hand-written names) or at any non-identifier char
/// (e.g. the `:` separating an impl's trait from its target). The `__`
/// separator is a guaranteed delimiter, so this needs no heuristics.
fn name_or_splice(store: NodeStore, name: string) -> Expr {
    if !is_splice_name(name) {
        return string_lit_expr(name)
    }
    let pieces = split_name_splices(name)
    mut joined = pieces[0]
    mut i = 1
    while i < pieces.length {
        joined = Expr.Binary(store.exprs.add_leaf(joined), BinOp.Add, store.exprs.add_leaf(pieces[i]))
        i = i + 1
    }
    joined
}

/// True when `name` carries a `~ident` splice marker anywhere.
fn is_splice_name(name: string) -> bool {
    name.contains("~")
}

/// Break a name into its alternating literal / `~ident`-splice pieces,
/// each rendered as an Expr (a string literal, or `Expr.Ident` for a
/// splice). Empty literal runs are dropped so the join reads as
/// `literal + ident + literal + ...`.
fn split_name_splices(name: string) -> List<Expr> {
    mut pieces: List<Expr> = []
    mut literal = ""
    mut i = 0
    let n = name.length
    while i < n {
        let ch = name.substring(i, i + 1)
        if ch != "~" {
            literal = literal + ch
            i = i + 1
            continue
        }
        // Flush the pending literal, then read the spliced identifier:
        // ident chars up to the first `__` separator or non-ident char.
        if literal.length > 0 {
            pieces.push(string_lit_expr(literal))
            literal = ""
        }
        mut ident = ""
        mut j = i + 1
        while j < n {
            let c = name.substring(j, j + 1)
            if !is_ident_char(c) { break }
            if c == "_" && j + 1 < n && name.substring(j + 1, j + 2) == "_" { break }
            ident = ident + c
            j = j + 1
        }
        pieces.push(Expr.Ident(ident))
        i = j
    }
    if literal.length > 0 {
        pieces.push(string_lit_expr(literal))
    }
    pieces
}

/// A character that may appear inside an Avra identifier.
fn is_ident_char(c: string) -> bool {
    (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
}

/// Ingest a recipe of raw Exprs into arena rows (span-less leaves that
/// still walk their boxed children — matching the retired
/// `ingest_sexpr_recipe`), returning the `List<ExprId>` payload the
/// flipped `ListLit` and the other id-native variants now hold. Every
/// quote-machinery list construction funnels through here, so the
/// builders can assemble `List<Expr>` directly and hand it off.
fn ingest_exprs(store: NodeStore, exprs: List<Expr>) -> List<ExprId> {
    mut ids: List<ExprId> = []
    for e in exprs { ids.push(store.ingest_expr(e, byte_span_none())) }
    ids
}

fn listlit_of(store: NodeStore, elems: List<Expr>) -> Expr {
    Expr.ListLit(ingest_exprs(store, elems))
}

/// Reconstruct a flipped `List<ExprId>` args payload. Each element is
/// `synth_expr_id(construct_expr(item))`,
/// so the ListLit TYPES as `List<ExprId>` (matching the flipped `Call.args`),
/// exactly as the scalar `construct_expr_id` types a single operand. Uses
/// `synth_expr_id` PER ELEMENT (never a whole-list shim), so the pinned seed —
/// which compiles this reconstructor but never evals it — needs no new eval
/// intercept. Decoded by `list_value_to_expr_id_list` in eval.
fn construct_expr_ids(store: NodeStore, list: List<ExprId>) -> Expr {
    mut elems: List<Expr> = []
    for id in list {
        elems.push(construct_expr_id(store, id))
    }
    listlit_of(store, elems)
}

// ── Statement construction (vez6.3.9) ──

/// Build an Expr that, when evaluated, produces a `List<StmtId>` AST value.
/// Resolves each row and emits the bare `Stmt` constructor list, wrapped
/// in the `synth_stmt_ids` id shim so the generated `List<StmtId>` payload
/// slot type-checks (see `construct_stmt_id`). Each element is a bare
/// `Stmt` constructor — `synth_stmt_ids` takes `List<Stmt>`, so no
/// per-element span wrapper is needed (the shim is an eval identity).
fn construct_stmt_ids(store: NodeStore, ids: List<StmtId>) -> Expr {
    // A bare `~list` statement in the body splices its `List<Stmt>` target in as
    // siblings (rmzs GAP 1) — the statement-list analogue of the match-arm
    // `~arms` splice: constructed stmts accumulate into a segment, and each
    // splice flushes the segment then `list_concat`s the target. With NO splice
    // this is byte-identical to the old `synth_stmt_ids(listlit_of(all))` — the
    // segment IS the full list, `result_opt` stays null, so the same nodes are
    // allocated in the same order.
    mut result_opt: Expr? = null
    mut current_seg: List<Expr> = []
    for id in ids {
        let stmt = store.stmts.get(id)
        let splice_opt = bare_stmt_splice_target(store, stmt)
        if splice_opt == null {
            current_seg = current_seg.push(construct_stmt(store, stmt))
        } else {
            let seg_lit = listlit_of(store, current_seg)
            result_opt = if result_opt == null { seg_lit } else { list_concat_call(store, result_opt!, seg_lit) }
            result_opt = list_concat_call(store, result_opt!, splice_opt!)
            current_seg = []
        }
    }
    let final_seg = listlit_of(store, current_seg)
    let list_expr = if result_opt == null { final_seg } else { list_concat_call(store, result_opt!, final_seg) }
    synth_shim_call(store, "synth_stmt_ids", list_expr)
}

/// A bare `~target` statement inside a quote body — parsed as
/// `Stmt.Expr(Splice(target))` — whose target evaluates to a `List<Stmt>` that
/// splices in as siblings (rmzs GAP 1). Returns the raw target Expr (skip
/// construction, paste the value — same contract as the expr-position splice at
/// `construct_expr`'s `.Splice` arm), or null when `stmt` is an ordinary stmt.
fn bare_stmt_splice_target(store: NodeStore, stmt: Stmt) -> Expr? {
    match stmt {
        .Expr(e) -> {
            match store.exprs.get(e) {
                .Splice(target) -> store.exprs.get(target)
                _ -> null
            }
        }
        _ -> null
    }
}

/// Resolve one statement row and build its constructor expression,
/// wrapped in the `synth_stmt_id` id shim so the generated construct
/// code type-checks against the flipped `StmtId` payload slot. The
/// shim is an identity at eval (features/eval intercepts it by name).
fn construct_stmt_id(store: NodeStore, id: StmtId) -> Expr {
    synth_shim_call(store, "synth_stmt_id", construct_stmt(store, store.stmts.get(id)))
}

/// Resolve one expression row and build its constructor expression,
/// wrapped in the `synth_expr_id` id shim (see `construct_stmt_id`).
fn construct_expr_id(store: NodeStore, id: ExprId) -> Expr {
    synth_shim_call(store, "synth_expr_id", construct_expr(store, store.exprs.get(id)))
}

/// A call to a synth_* id shim around `arg` — the generated-code carrier
/// that wraps a bare constructed node so the id-payload slot type-checks.
/// Fully qualified so the eval intercept's last-segment match and the
/// compiled resolver both find it.
fn synth_shim_call(store: NodeStore, name: string, arg: Expr) -> Expr {
    Expr.Call(
        store.exprs.add_leaf(Expr.QualifiedIdent("@std::avrac::features::comptime::${name}")),
        [store.exprs.add_leaf(arg)]
    )
}

/// Build an Expr that, when evaluated, produces a Stmt AST value
/// matching `stmt`. Variants we support: bindings, control flow,
/// returns, blocks, defers, traits, parallel — everything common
/// inside multi-stmt quote bodies. Decl-only variants (TypeDecl,
/// EnumDecl, NewtypeDecl, ShapeDecl, UnionAliasDecl, Function,
/// ExternFn, Annotated) and Match (needs MatchArmList construction)
/// pass through unchanged for now — they belong to vez6.3.10
/// (`quote decl { ... }`).
/// vez6.8.4.A: exposed so the @expand pass can box a Stmt as a Value
/// (via construct_stmt + eval_expr) when invoking a 1-arg macro.
/// Arity, encoding, and split between encoded vs. passthrough variants
/// stay an internal detail — callers should treat this as opaque.
export fn construct_stmt(store: NodeStore, stmt: Stmt) -> Expr {
    match stmt {
        // Preserve the declared/resolved type slot. Quote-emitted code
        // typically leaves it Unknown (resolver fills in), but macros
        // emitting a typed `let x: List<Self> = []` rely on the
        // annotation surviving the roundtrip — without it, scalar
        // match-arms returning `[]` can't unify with list_concat-typed
        // sibling arms and the typeck fires F1000 "arms have different
        // types: List vs List". The encoder now handles ValueType
        // construction generically; non-typed quote callers pass
        // ValueType.Unknown which encodes as the same Unknown ctor.
        .Let(name, vt, init) -> stmt_ctor(store, "Let", three_args(string_lit_expr(name), construct_value_type(store, vt), construct_expr_id(store, init)))
        .Mut(name, vt, init) -> stmt_ctor(store, "Mut", three_args(string_lit_expr(name), construct_value_type(store, vt), construct_expr_id(store, init)))
        .Const(name, vt, init) -> stmt_ctor(store, "Const", three_args(string_lit_expr(name), construct_value_type(store, vt), construct_expr_id(store, init)))
        .Expr(e) -> stmt_ctor(store, "Expr", one_arg(construct_expr_id(store, e)))
        .Block(body) -> stmt_ctor(store, "Block", one_arg(construct_stmt_ids(store, body)))
        .Return(e) -> stmt_ctor(store, "Return", one_arg(construct_expr_id(store, e)))
        .ReturnEmpty -> {
            let empty: List<Expr> = []
            stmt_ctor(store, "ReturnEmpty", empty)
        }
        .NoOp -> {
            let empty: List<Expr> = []
            stmt_ctor(store, "NoOp", empty)
        }
        .Break -> {
            let empty: List<Expr> = []
            stmt_ctor(store, "Break", empty)
        }
        .Continue -> {
            let empty: List<Expr> = []
            stmt_ctor(store, "Continue", empty)
        }
        .Defer(body) -> stmt_ctor(store, "Defer", one_arg(construct_expr_id(store, body)))
        .Errdefer(body) -> stmt_ctor(store, "Errdefer", one_arg(construct_expr_id(store, body)))
        .While(cond, body) -> stmt_ctor(store, "While", two_args(construct_expr_id(store, cond), construct_stmt_id(store, body)))
        .For(v, start, end, body) -> stmt_ctor(store, "For", four_args(string_lit_expr(v), construct_expr_id(store, start), construct_expr_id(store, end), construct_stmt_id(store, body)))
        .ForIn(v, coll, body) -> stmt_ctor(store, "ForIn", three_args(string_lit_expr(v), construct_expr_id(store, coll), construct_stmt_id(store, body)))
        // If has a nullable else_branch — encode null as Expr.None at
        // the AST level so the constructed runtime gets back the
        // null-discriminant.
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                stmt_ctor(store, "If", three_args(construct_expr_id(store, cond), construct_stmt_id(store, then_b), construct_stmt_id(store, else_b!)))
            } else {
                stmt_ctor(store, "If", three_args(construct_expr_id(store, cond), construct_stmt_id(store, then_b), Expr.None))
            }
        }
        .Impl(type_name, methods) -> stmt_ctor(store, "Impl", two_args(name_or_splice(store, type_name), construct_stmt_ids(store, methods)))
        .TraitDecl(name, methods) -> stmt_ctor(store, "TraitDecl", two_args(string_lit_expr(name), construct_stmt_ids(store, methods)))
        .Parallel(body) -> stmt_ctor(store, "Parallel", one_arg(construct_stmt_ids(store, body)))
        .Function(name, tp, params, rvt, body) -> stmt_ctor(store, "Function",
            five_args(name_or_splice(store, name),
                      construct_type_param_list(store, tp),
                      construct_param_list(store, params),
                      construct_value_type(store, rvt),
                      construct_stmt_ids(store, body)))
        .TypeDecl(name, tp, fields) -> stmt_ctor(store, "TypeDecl",
            three_args(name_or_splice(store, name),
                       construct_type_param_list(store, tp),
                       construct_field_list(store, fields)))
        .EnumDecl(name, tp, variants) -> stmt_ctor(store, "EnumDecl",
            three_args(name_or_splice(store, name),
                       construct_type_param_list(store, tp),
                       construct_variant_list(store, variants)))
        .ComponentBlock(comp_name, instance, config, body) -> stmt_ctor(store, "ComponentBlock",
            four_args(string_lit_expr(comp_name),
                      string_lit_expr(instance),
                      construct_comp_config_pair_list(store, config),
                      construct_stmt_ids(store, body)))
        // The raw body of a `body: TokenStream` component instance —
        // without this arm the passthrough would hand the macro a NoOp
        // and silently lose the text. string_lit_expr embeds the raw
        // text verbatim (no re-parse), so quotes/braces inside survive.
        .TokenBody(text) -> stmt_ctor(store, "TokenBody", one_arg(string_lit_expr(text)))
        // Step 4 nested @expand: a macro returning code that itself
        // carries an @expand annotation needs the Annotated layer to
        // roundtrip through quote construction so the outer expand
        // pass sees the new @expand site on the next fixpoint iter.
        .Annotated(annots, inner) -> stmt_ctor(store, "Annotated",
            two_args(construct_annotation_list(store, annots), construct_stmt_id(store, inner)))
        _ -> stmt_passthrough(store, stmt)
    }
}

/// Catch-all for Stmt variants we haven't taught construct_stmt yet
/// (decls, complex Match arms). Returns a synthesized Stmt.NoOp at the
/// AST level — at runtime the user gets a NoOp instead of a crash, and
/// the missing variant becomes a feature request rather than a silent
/// corruption. Filed as vez6.3.10 (`quote decl`) for completion.
fn stmt_passthrough(store: NodeStore, stmt: Stmt) -> Expr {
    let empty: List<Expr> = []
    stmt_ctor(store, "NoOp", empty)
}

/// Sister to expr_ctor for Stmt.
fn stmt_ctor(store: NodeStore, variant: string, args: List<Expr>) -> Expr {
    Expr.EnumCtor("@std::avrac::core::Stmt", variant, ingest_exprs(store, args))
}

fn four_args(a: Expr, b: Expr, c: Expr, d: Expr) -> List<Expr> {
    [a, b, c, d]
}

fn five_args(a: Expr, b: Expr, c: Expr, d: Expr, e: Expr) -> List<Expr> {
    [a, b, c, d, e]
}

fn construct_binop(store: NodeStore, op: BinOp) -> Expr {
    let empty: List<ExprId> = []
    Expr.EnumCtor("@std::avrac::core::BinOp", op_variant_name_bin(op), empty)
}
fn construct_unop(store: NodeStore, op: UnOp) -> Expr {
    let empty: List<ExprId> = []
    Expr.EnumCtor("@std::avrac::core::UnOp", op_variant_name_un(op), empty)
}
fn construct_logicop(store: NodeStore, op: LogicOp) -> Expr {
    let empty: List<ExprId> = []
    Expr.EnumCtor("@std::avrac::core::LogicOp", op_variant_name_logic(op), empty)
}

/// Map BinOp variants to their constructor-name string. binop_str
/// returns the source-text form ("+", "==", etc.); we need the
/// enum-variant name ("Add", "Eq", etc.) for the AST construction.
fn op_variant_name_bin(op: BinOp) -> string {
    // Exhaustive — no wildcard: a missing arm here silently mis-encodes the
    // operator (a `_ -> "Add"` fallthrough used to map every bitwise/shift op
    // to Add, so `quote { a << b }` reconstructed as `a + b`). Naming every
    // variant makes a future BinOp a compile error instead.
    match op {
        .Add -> "Add"
        .Sub -> "Sub"
        .Mul -> "Mul"
        .Div -> "Div"
        .Mod -> "Mod"
        .Eq -> "Eq"
        .Ne -> "Ne"
        .Lt -> "Lt"
        .Le -> "Le"
        .Gt -> "Gt"
        .Ge -> "Ge"
        .BitAnd -> "BitAnd"
        .BitOr -> "BitOr"
        .BitXor -> "BitXor"
        .Shl -> "Shl"
        .Shr -> "Shr"
    }
}
fn op_variant_name_un(op: UnOp) -> string {
    match op {
        .Neg -> "Neg"
        .Not -> "Not"
        .BitNot -> "BitNot"
    }
}
fn op_variant_name_logic(op: LogicOp) -> string {
    match op {
        .And -> "And"
        .Or -> "Or"
    }
}

// ── Constructor-call helpers ──

/// One-element `List<ExprId>` wrapping `string_lit_expr(s)` — the
/// string-arg form for ctor() invocations. Both ident-like inputs
/// and parser-form String.value (already-quoted) inputs round-trip
/// through this wrap; see `string_lit_expr` for why one wrap suffices.
fn string_arg(s: string) -> List<Expr> {
    [string_lit_expr(s)]
}

fn one_arg(a: Expr) -> List<Expr> {
    [a]
}
fn two_args(a: Expr, b: Expr) -> List<Expr> {
    [a, b]
}
fn three_args(a: Expr, b: Expr, c: Expr) -> List<Expr> {
    [a, b, c]
}

/// Escape every `"` and `\` in `s` for embedding in a string-literal
/// source form. The parser stores Expr.String values with their outer
/// quotes; nesting one inside another needs the inner pair escaped.
fn escape_string(s: string) -> string {
    mut out = ""
    mut i = 0
    while i < s.length {
        let ch = s.substring(i, i + 1)
        if ch == "\"" {
            out = out + "\\\""
        } else {
            if ch == "\\" {
                out = out + "\\\\"
            } else {
                out = out + ch
            }
        }
        i = i + 1
    }
    out
}
