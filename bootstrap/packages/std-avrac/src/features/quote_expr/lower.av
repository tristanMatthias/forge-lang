// WHY: lowering pass for `quote { body }` (Phase 3 of Components V2).
//
// Each `Expr.Quote(kind, body)` becomes an Expr that, when evaluated,
// constructs `body` as a runtime AST value. So `quote { 5 }` evaluates
// to an `Expr.Number("5")` value, not the integer 5.
//
// Pipeline position: after resolve_names, before typecheck. Same slot
// the comptime pass uses, for the same reason — typeck sees the
// post-lowering AST (no Quote nodes survive).
//
// Phase 3 first slice: covers the literal + identifier + binary / unary
// expression shapes. More variants land in subsequent commits driven by
// tests that exercise them. The walker is the structural-walker pattern
// that desugar.av and comptime/rewrite.av use; once the generic-AST-
// visitor ticket lands (93k3) all three should share a single visitor.

use core.{Stmt, StmtList, SStmt, sstmt_at, sstmt_dummy, Expr, ExprList, SExpr, sexpr, sexpr_dummy, FieldInitList, MatchArmList, WhenArmList, SelectArmList, BinOp, UnOp, LogicOp, binop_str, unop_str, logicop_str}

// ── Public entry ──

/// Walk every statement and expression in `stmts`, replacing each
/// `Expr.Quote` node with an AST-construction expression that evaluates
/// to the captured AST. Returns a new StmtList.
export fn lower_quotes(stmts: StmtList) -> StmtList {
    lower_stmt_list(stmts)
}

// ── Top-level walker (mirrors comptime/rewrite.av structure) ──

fn lower_stmt_list(stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> StmtList.Node(
            sstmt_at(lower_stmt(ss.node), ss.line, ss.col, ss.file),
            lower_stmt_list(next)
        )
    }
}

fn lower_stmt(stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, vt, lower_expr(init))
        .Mut(name, vt, init) -> .Mut(name, vt, lower_expr(init))
        .Const(name, vt, init) -> .Const(name, vt, lower_expr(init))
        .Expr(e) -> .Expr(lower_expr(e))
        .Return(e) -> .Return(lower_expr(e))
        .Block(body) -> .Block(lower_stmt_list(body))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(lower_expr(cond), lower_stmt(then_b), lower_stmt(else_b!))
            } else {
                .If(lower_expr(cond), lower_stmt(then_b), null)
            }
        }
        .While(cond, body) -> .While(lower_expr(cond), lower_stmt(body))
        .For(v, start, end, body) -> .For(v, lower_expr(start), lower_expr(end), lower_stmt(body))
        .ForIn(v, coll, body) -> .ForIn(v, lower_expr(coll), lower_stmt(body))
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, lower_stmt_list(body))
        .Impl(type_name, methods) -> .Impl(type_name, lower_stmt_list(methods))
        .Annotated(annots, inner) -> .Annotated(annots, lower_stmt(inner))
        .Module(name, body) -> .Module(name, lower_stmt_list(body))
        .ComponentDef(name, params, config, body) -> .ComponentDef(name, params, config, lower_stmt_list(body))
        .ComponentBlock(comp, inst, config, body) -> .ComponentBlock(comp, inst, config, lower_stmt_list(body))
        .SpecBlock(name, body) -> .SpecBlock(name, lower_stmt_list(body))
        .GivenBlock(name, body) -> .GivenBlock(name, lower_stmt_list(body))
        .ThenBlock(name, cond) -> .ThenBlock(name, lower_expr(cond))
        .Match(subj, arms) -> .Match(lower_expr(subj), arms)
        .Defer(body) -> .Defer(lower_expr(body))
        .Errdefer(body) -> .Errdefer(lower_expr(body))
        .LetDestructure(names, init) -> .LetDestructure(names, lower_expr(init))
        .Impl(type_name, methods) -> .Impl(type_name, lower_stmt_list(methods))
        .TraitDecl(name, methods) -> .TraitDecl(name, lower_stmt_list(methods))
        .Parallel(body) -> .Parallel(lower_stmt_list(body))
        _ -> stmt
    }
}

fn lower_expr(expr: Expr) -> Expr {
    match expr {
        .Quote(_, body) -> construct_expr(unwrap_quote_body(body))
        .Binary(l, op, r) -> .Binary(lower_expr(l), op, lower_expr(r))
        .Unary(op, r) -> .Unary(op, lower_expr(r))
        .Logical(l, op, r) -> .Logical(lower_expr(l), op, lower_expr(r))
        .Call(callee, args) -> .Call(lower_expr(callee), lower_expr_list(args))
        .Grouping(inner) -> .Grouping(lower_expr(inner))
        .Block(body) -> .Block(lower_stmt_list(body))
        .IfExpr(c, t, e) -> .IfExpr(lower_expr(c), lower_expr(t), lower_expr(e))
        _ -> expr
    }
}

fn lower_expr_list(list: ExprList) -> ExprList {
    match list {
        .End -> ExprList.End
        .Node(se, next) -> ExprList.Node(
            sexpr(lower_expr(se.node), se.line, se.col),
            lower_expr_list(next)
        )
    }
}

// ── Quote body unwrapping ──

/// `parse_quote` currently captures the body via parse_block_expression,
/// which wraps single expressions in a Block(StmtList(Stmt.Expr(...))).
/// For a single-expr body, peel that off so `quote { 5 }` lowers to the
/// AST of the literal 5, not the AST of a one-stmt Block.
fn unwrap_quote_body(body: Expr) -> Expr {
    match body {
        .Block(stmts) -> {
            match stmts {
                .Node(ss, rest) -> {
                    match rest {
                        .End -> {
                            match ss.node {
                                .Expr(inner) -> inner
                                _ -> body
                            }
                        }
                        _ -> body
                    }
                }
                _ -> body
            }
        }
        _ -> body
    }
}

// ── AST construction ──

/// Given an AST Expr `e`, produce another Expr that constructs `e` as
/// a runtime value when evaluated. So `construct_expr(Number("5"))`
/// returns the AST shape of `Expr.Number("5")` — i.e. an EnumCtor for
/// the Expr.Number variant carrying a string-literal arg "5".
///
/// First slice: covers Number, String, Bool, Null, Ident, Binary, Unary,
/// Logical, Grouping. Other variants pass through unchanged for now —
/// downstream stages will see the raw AST and will likely error,
/// surfacing the missing case naturally. New variants land driven by
/// tests that need them.
fn construct_expr(e: Expr) -> Expr {
    match e {
        .Number(v) -> ctor("@std::avrac::core::Expr", "Number", string_arg(v))
        .String(v) -> ctor("@std::avrac::core::Expr", "String", string_arg_raw(v))
        .Bool(v) -> ctor("@std::avrac::core::Expr", "Bool", string_arg(v))
        .Null -> ctor("@std::avrac::core::Expr", "Null", ExprList.End)
        .Ident(name) -> ctor("@std::avrac::core::Expr", "Ident", string_arg(name))
        .Binary(l, op, r) -> ctor("@std::avrac::core::Expr", "Binary", three_args(construct_expr(l), construct_binop(op), construct_expr(r)))
        .Unary(op, r) -> ctor("@std::avrac::core::Expr", "Unary", two_args(construct_unop(op), construct_expr(r)))
        .Logical(l, op, r) -> ctor("@std::avrac::core::Expr", "Logical", three_args(construct_expr(l), construct_logicop(op), construct_expr(r)))
        .Grouping(inner) -> ctor("@std::avrac::core::Expr", "Grouping", one_arg(construct_expr(inner)))
        _ -> e
    }
}

fn construct_binop(op: BinOp) -> Expr {
    Expr.EnumCtor("@std::avrac::core::BinOp", op_variant_name_bin(op), ExprList.End)
}
fn construct_unop(op: UnOp) -> Expr {
    Expr.EnumCtor("@std::avrac::core::UnOp", op_variant_name_un(op), ExprList.End)
}
fn construct_logicop(op: LogicOp) -> Expr {
    Expr.EnumCtor("@std::avrac::core::LogicOp", op_variant_name_logic(op), ExprList.End)
}

/// Map BinOp variants to their constructor-name string. binop_str
/// returns the source-text form ("+", "==", etc.); we need the
/// enum-variant name ("Add", "Eq", etc.) for the AST construction.
fn op_variant_name_bin(op: BinOp) -> string {
    match op {
        .Add -> "Add"
        .Sub -> "Sub"
        .Mul -> "Mul"
        .Div -> "Div"
        .Mod -> "Mod"
        .Eq -> "Eq"
        .Ne -> "Ne"
        .Lt -> "Lt"
        .Le -> "Le"
        .Gt -> "Gt"
        .Ge -> "Ge"
        _ -> "Add"
    }
}
fn op_variant_name_un(op: UnOp) -> string {
    match op {
        .Neg -> "Neg"
        .Not -> "Not"
        _ -> "Neg"
    }
}
fn op_variant_name_logic(op: LogicOp) -> string {
    match op {
        .And -> "And"
        .Or -> "Or"
        _ -> "And"
    }
}

// ── Constructor-call helpers ──

fn ctor(type_name: string, variant: string, args: ExprList) -> Expr {
    Expr.EnumCtor(type_name, variant, args)
}

fn string_arg(s: string) -> ExprList {
    ExprList.Node(sexpr_dummy(Expr.String("\"${s}\"")), ExprList.End)
}

/// Like string_arg but the string is already in source-text form
/// (i.e. already includes its surrounding quotes — the parser stores
/// String exactly as written in source). To embed it as an arg to
/// Expr.String(...) we need to escape the inner quotes.
fn string_arg_raw(s: string) -> ExprList {
    let escaped = escape_string(s)
    ExprList.Node(sexpr_dummy(Expr.String("\"${escaped}\"")), ExprList.End)
}

fn one_arg(a: Expr) -> ExprList {
    ExprList.Node(sexpr_dummy(a), ExprList.End)
}
fn two_args(a: Expr, b: Expr) -> ExprList {
    ExprList.Node(sexpr_dummy(a), ExprList.Node(sexpr_dummy(b), ExprList.End))
}
fn three_args(a: Expr, b: Expr, c: Expr) -> ExprList {
    ExprList.Node(sexpr_dummy(a),
      ExprList.Node(sexpr_dummy(b),
        ExprList.Node(sexpr_dummy(c), ExprList.End)))
}

/// Escape every `"` and `\` in `s` for embedding in a string-literal
/// source form. The parser stores Expr.String values with their outer
/// quotes; nesting one inside another needs the inner pair escaped.
fn escape_string(s: string) -> string {
    mut out = ""
    mut i = 0
    while i < s.length {
        let ch = s.substring(i, i + 1)
        if ch == "\"" {
            out = out + "\\\""
        } else {
            if ch == "\\" {
                out = out + "\\\\"
            } else {
                out = out + ch
            }
        }
        i = i + 1
    }
    out
}
