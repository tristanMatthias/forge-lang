// WHY: @expand pass — Phase 6 of Components V2 (vez6.6).
//
// `@expand(macro_fn)` on a declaration registers a @comptime fn to
// rewrite the declaration. The expand pass:
//   1. Walks the AST collecting Stmts wrapped in `@expand(M)`.
//   2. Looks up M in the comptime registry built by the same
//      `collect_comptime_fns` run_comptime uses.
//   3. Invokes M at compile time via `eval_fn_with_resolved_args`.
//   4. Decodes the resulting Value into a Stmt via `value_to_stmt`
//      and replaces the original decl with it.
//
// First slice covers argless macros that return a Stmt via
// `quote stmt { ... }`. Macros that take the decl as an argument
// land in a follow-up once AST→Value boxing is in place. Recursion
// limit + clear error for infinite expansion comes with the same
// follow-up.
//
// Pipeline position: between resolve_names and run_comptime — a
// macro-produced Stmt should still go through the normal fold pass
// so any `@comptime` calls inside its body fold correctly.

use core.{Stmt, SStmt, Expr, SExpr, sstmt_at, find_annotation, stmt_unwrap}
use features.comptime.{CompTimeRegistry, comptime_lookup, collect_comptime_fns, value_to_stmt, value_to_stmt_list, stmt_to_value}
use features.eval.{Runtime, Value, eval_fn_with_resolved_args, step_value, step_had_error, step_error_message}
use list_ops.{list_concat}

// ── Public entry ──

/// Walk `stmts`, expanding every Stmt wrapped in `@expand(M)` by
/// replacing it with the AST returned by M evaluated at compile
/// time.
///
/// Fast-path: when the program has no `@expand` annotations the
/// walker returns the input unchanged with no allocations.
///
/// vez6.8.5: also expands ComponentBlock instances of components
/// whose `ComponentDef` carries `@expand(macro)`. The macro fn is
/// looked up via a pre-pass that maps component name → macro fn
/// name; each instance gets the macro applied with the
/// ComponentBlock as a 1-arg Stmt value.
export fn expand_macros(stmts: List<SStmt>) -> List<SStmt> {
    let comp_macros = collect_component_macros(stmts)
    if !any_expand_annotation(stmts) && comp_macros.length == 0 { return stmts }
    let reg = collect_comptime_fns(stmts)
    expand_stmt_list(stmts, reg, comp_macros)
}

// ── Component-macro pre-pass (vez6.8.5) ──

/// One (component-name → @expand macro fn name) mapping. The full
/// registry is `List<CompMacroEntry>` — built once per program and
/// consulted at every ComponentBlock site.
type CompMacroEntry = { comp_name: string, macro_name: string }

fn comp_macro_lookup(m: List<CompMacroEntry>, comp_name: string) -> string {
    for e in m {
        if e.comp_name == comp_name { return e.macro_name }
    }
    ""
}

/// Walk the AST, finding every `@expand(macro) component name { ... }`
/// declaration and recording its (name → macro_fn) pair.
fn collect_component_macros(stmts: List<SStmt>) -> List<CompMacroEntry> {
    mut acc: List<CompMacroEntry> = []
    for ss in stmts {
        let inner = peel_annotations(ss.node)
        // ComponentDefs can live inside Module wrappers (e.g.
        // `component command implements Runnable {}` declared
        // in @std/cli's cli.av lands wrapped under
        // Module("@std::cli::cli", ...) in a bundled compile).
        // Without this recursion the (comp_name → macro_fn) map
        // is empty for any def behind a module boundary, so
        // instance dispatch silently skips them.
        match inner {
            .Module(_, body) -> acc = list_concat(acc, collect_component_macros(body))
            _ -> {
                let macro_name = comp_macro_for(ss.node)
                let comp_name = component_def_name(ss.node)
                if macro_name != "" && comp_name != "" {
                    acc = acc.push(CompMacroEntry { comp_name, macro_name })
                }
            }
        }
    }
    acc
}

/// If `stmt` is a ComponentDef wrapped in @expand(M), return M's
/// name. Returns "" otherwise. Handles arbitrarily-nested
/// Annotated wrappers (e.g. `///` doc + `@expand`).
fn comp_macro_for(stmt: Stmt) -> string {
    let inner = peel_annotations(stmt)
    match inner {
        .ComponentDef(_, _, _, _, _, _) -> expand_target_name(stmt)
        _ -> ""
    }
}

fn component_def_name(stmt: Stmt) -> string {
    let inner = peel_annotations(stmt)
    match inner {
        .ComponentDef(name, _, _, _, _, _) -> name
        _ -> ""
    }
}

fn peel_annotations(stmt: Stmt) -> Stmt {
    match stmt {
        .Annotated(_, inner) -> peel_annotations(inner)
        _ -> stmt
    }
}

// ── Fast-path presence scan ──

/// True iff any `@expand` annotation appears anywhere in `stmts`.
/// Walks recursively but allocates nothing — callers only pay for
/// the rewrite walk when the program actually has macros.
fn any_expand_annotation(stmts: List<SStmt>) -> bool {
    mut i = 0
    while i < stmts.length {
        if has_expand_annotation(stmts[i].node) { return true }
        i = i + 1
    }
    false
}

fn has_expand_annotation(stmt: Stmt) -> bool {
    let found = find_annotation(stmt, "expand")
    found != null
}

// ── Walker ──

fn expand_stmt_list(stmts: List<SStmt>, reg: CompTimeRegistry, comp_macros: List<CompMacroEntry>) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        let inner = peel_annotations(ss.node)
        // vez6.8.5: a ComponentDef with @expand only REGISTERS
        // the macro for its instances. The def itself drops
        // out of the output — there's no template-style expansion
        // for the def, only per-instance dispatch.
        match inner {
            .ComponentDef(_, _, _, _, _, _) -> {
                if !has_expand_annotation(ss.node) {
                    out.push(ss)
                }
            }
            .ComponentBlock(comp_name, _, _, _) -> {
                // ComponentBlock instances of @expand'd defs route
                // through the macro pipeline with the block itself
                // as the Stmt arg. Replacement is a list — splice
                // every element into the output so multi-stmt macros
                // emit all their decls as siblings.
                let inst_macro = comp_macro_lookup(comp_macros, comp_name)
                if inst_macro != "" {
                    let replacement = try_expand_with_macro(ss.node, inst_macro, reg, ss.line, ss.col, ss.file)
                    if replacement != null {
                        for r in replacement! { out.push(r) }
                    } else {
                        out.push(ss)
                    }
                } else {
                    out.push(ss)
                }
            }
            // Module bodies have to be walked too — without this,
            // component instances inside an imported module (e.g.
            // `component command build {}` declared inside a
            // submodule of @std/cli) never see the @expand
            // pipeline, and the unprocessed ComponentBlock falls
            // through to codegen with an unsupported tag. Re-wraps
            // the recursed body so the module structure stays
            // intact for downstream resolve/typeck.
            .Module(mod_name, body) -> {
                let expanded_body = expand_stmt_list(body, reg, comp_macros)
                let new_stmt = Stmt.Module(mod_name, expanded_body)
                out.push(sstmt_at(new_stmt, ss.line, ss.col, ss.file))
            }
            _ -> {
                if has_expand_annotation(ss.node) {
                    let replacement = try_expand_one(ss.node, reg, ss.line, ss.col, ss.file)
                    if replacement != null {
                        // Splice every Stmt the macro returned —
                        // singletons land as a 1-element list, lists
                        // land as N elements. Either way the macro's
                        // output becomes consecutive siblings of
                        // whatever it replaced.
                        for r in replacement! { out.push(r) }
                    } else {
                        // Expansion failed — keep the original stmt
                        // so downstream stages surface the issue.
                        out.push(ss)
                    }
                } else {
                    out.push(ss)
                }
            }
        }
        i = i + 1
    }
    out
}

/// Apply a named macro fn to `stmt`, treating the macro's return
/// value as the replacement. Sister to `try_expand_one` but
/// doesn't read the @expand annotation off the stmt — used for
/// vez6.8.5's component-instance dispatch where the macro is
/// inherited from the parent ComponentDef. Caller has already
/// unwrapped any Annotated layers.
fn try_expand_with_macro(stmt: Stmt, macro_name: string, reg: CompTimeRegistry, line: int, col: int, file: string) -> List<SStmt>? {
    invoke_macro(stmt, macro_name, reg, line, col, file)
}

/// Look up the macro fn name from the `@expand` annotation's first
/// arg, find it in the comptime registry, evaluate it (with the
/// wrapped Stmt as a single arg if the macro is 1-ary, else
/// zero-arg), and decode the result. Returns null when ANY step
/// fails — the caller treats that as "leave this stmt alone".
fn try_expand_one(stmt: Stmt, reg: CompTimeRegistry, line: int, col: int, file: string) -> List<SStmt>? {
    let macro_name = expand_target_name(stmt)
    if macro_name == "" {
        eprintln("error: @expand requires a macro fn identifier as its argument")
        return null
    }
    invoke_macro(stmt_unwrap(stmt), macro_name, reg, line, col, file)
}

/// Shared driver: locate `macro_name` in the comptime registry,
/// dispatch on arity (0 or 1), eval, and decode the return as
/// either a single Stmt or a List<Stmt>. Returns the replacement
/// list (always a list, even for single-Stmt returns) or null on
/// any failure. Logs context-rich diagnostics so users see which
/// macro / which step failed.
///
/// Multi-stmt support: macros built via `quote stmts { ... }` return
/// `List<SStmt>`, decoded via value_to_stmt_list. This lets a single
/// `@expand` site emit N sibling declarations (e.g. the original
/// type + an impl block + a top-level helper fn) without forcing
/// macros into the singleton-Stmt straightjacket. Marshal and other
/// derives that previously had to bypass @expand entirely can now
/// be expressed directly. Try list first because a List value
/// can't decode as a single Stmt; the second decode is the
/// fallback for traditional `quote stmt { ... }` macros.
///
/// 1-arg macros receive the wrapped Stmt boxed via stmt_to_value
/// (which routes through construct_stmt + eval_expr — so any variant
/// lower.av's construct_stmt encodes roundtrips correctly). Caller
/// is responsible for any annotation peeling: try_expand_one strips
/// @expand before invoking; try_expand_with_macro receives an
/// already-unwrapped ComponentBlock.
fn invoke_macro(stmt: Stmt, macro_name: string, reg: CompTimeRegistry, line: int, col: int, file: string) -> List<SStmt>? {
    let lookup = comptime_lookup(reg, macro_name)
    if lookup == null {
        eprintln("error: @expand(${macro_name}) — no @comptime fn named `${macro_name}` in scope")
        return null
    }
    let fn_def = lookup!
    let arity = fn_def.params.length
    let arg_values = if arity == 1 {
        let boxed = stmt_to_value(reg.runtime, stmt)
        if boxed == null {
            eprintln("error: @expand(${macro_name}) — could not box the wrapped Stmt as a Value (encoder may not yet support this Stmt variant)")
            return null
        }
        [boxed!]
    } else if arity == 0 {
        []
    } else {
        eprintln("error: @expand(${macro_name}) — macro has ${arity} parameters; @expand supports 0- or 1-arg macros only")
        return null
    }
    let result = eval_fn_with_resolved_args(reg.runtime, fn_def.params, fn_def.body, arg_values)
    if step_had_error(result) {
        eprintln("error: @expand(${macro_name}) — macro evaluation failed: ${step_error_message(result)}")
        return null
    }
    let v = step_value(result)
    // Try list first — a List<SStmt> Value is what `quote stmts { ... }`
    // produces. value_to_stmt_list returns null when v isn't a list,
    // so this is the cheap dispatch.
    let as_list = value_to_stmt_list(v)
    if as_list != null {
        mut out: List<SStmt> = []
        for ss in as_list! {
            out.push(sstmt_at(ss.node, line, col, file))
        }
        return out
    }
    // Fall back to single Stmt — `quote stmt { ... }` macros.
    let decoded = value_to_stmt(v)
    if decoded == null {
        eprintln("error: @expand(${macro_name}) — macro returned a value the expander could not decode into a Stmt or List<Stmt> (kind=${v.kind})")
        return null
    }
    [sstmt_at(decoded!, line, col, file)]
}

/// Pull the macro-fn identifier out of the `@expand(NAME)` annotation
/// args. Returns "" when the annotation isn't present, has no args,
/// or the first arg isn't a bare Ident / QualifiedIdent.
fn expand_target_name(stmt: Stmt) -> string {
    let found = find_annotation(stmt, "expand")
    if found == null { return "" }
    first_arg_ident(found!.args)
}

fn first_arg_ident(args: List<SExpr>) -> string {
    if args.length == 0 { return "" }
    match args[0].node {
        .Ident(name) -> name
        .QualifiedIdent(path) -> path
        _ -> ""
    }
}
