// WHY: @expand pass — Phase 6 of Components V2 (vez6.6).
//
// `@expand(macro_fn)` on a declaration registers a @comptime fn to
// rewrite the declaration. The expand pass:
//   1. Walks the AST collecting Stmts wrapped in `@expand(M)`.
//   2. Looks up M in the comptime registry built by the same
//      `collect_comptime_fns` run_comptime uses.
//   3. Invokes M at compile time via `eval_fn_with_resolved_args`.
//   4. Decodes the resulting Value into a Stmt via `value_to_stmt`
//      and replaces the original decl with it.
//
// First slice covers argless macros that return a Stmt via
// `quote stmt { ... }`. Macros that take the decl as an argument
// land in a follow-up once AST→Value boxing is in place. Recursion
// limit + clear error for infinite expansion comes with the same
// follow-up.
//
// Pipeline position: between resolve_names and run_comptime — a
// macro-produced Stmt should still go through the normal fold pass
// so any `@comptime` calls inside its body fold correctly.

use core.{Stmt, SStmt, Expr, SExpr, FieldEntry, ValueType, sstmt_at, sstmt_mark_from_macro, find_annotation, stmt_unwrap, exit, type_qualified_name}
use resolve.{ResolverState, register_macro_decls, dummy_resolver_state}
use features.comptime.{CompTimeRegistry, comptime_lookup, collect_comptime_fns, value_to_stmt, value_to_stmt_list, stmt_to_value}
use features.eval.{Runtime, Value, StructField, value_struct, value_string, value_number, value_null, value_list, eval_fn_with_resolved_args, step_value, step_had_error, step_error_message, path_last_segment}
use list_ops.{list_concat}

// ── ResolverCtx state stack (step 5) ──
//
// Runtime helpers that maintain a process-wide stack of active
// ResolverState pointers so `ctx_*` extern fns in macros can look
// up the resolver for the currently-expanding @expand site. Push
// before invoking the macro, pop after.

extern fn avra_resolver_ctx_push(state: ptr) -> int
extern fn avra_resolver_ctx_pop()
extern fn avra_resolver_ctx_get(handle: int) -> ptr
extern fn avra_resolver_ctx_top() -> int

// ── Resolver-data layer (step 5 of expand-pipeline doc) ──
//
// C-side scratch space populated before invoking each macro. Macros
// call ctx_* fns; the eval dispatch reads from these via getters
// instead of trying to introspect the opaque ResolverState ptr.
//
// `avra_rd_clear` resets all storage. We then call
// `avra_rd_set_current_module`, `avra_rd_add_alias`,
// `avra_rd_add_global` etc to populate. The macro reads them
// during eval. The next macro invocation clears and refills.

extern fn avra_rd_clear()
extern fn avra_rd_set_current_module(s: string)
extern fn avra_rd_add_alias(short_name: string, canonical: string)
extern fn avra_rd_add_global(short_name: string, canonical: string)
extern fn avra_rd_begin_type(canonical: string, kind: string) -> int
extern fn avra_rd_add_type_field(type_id: int, field_name: string, field_type_canonical: string)

/// Push the active resolver state's aliases + global decls + type
/// field info into the C-side resolver-data layer so `ctx_*` queries
/// from inside a macro body can answer with real data. Called once
/// per `expand_macros_eval` invocation; the data layer survives for
/// the full eval pass. current_module is set to "" for now — the
/// per-site tracking required to fill it accurately lives in
/// later work (see step 5 limitations in the handoff doc).
export fn populate_resolver_data(state: ResolverState, stmts: List<SStmt>) {
    avra_rd_clear()
    avra_rd_set_current_module("")
    for a in state.aliases {
        // seed-typeck workaround: bind field accesses to locals
        // before passing to extern fns (see global_item_reg_build).
        let sn = a.short_name
        let canon = a.canonical
        avra_rd_add_alias(sn, canon)
    }
    for g in state.graph.all_items {
        let sn = g.short_name
        let canon = g.canonical
        avra_rd_add_global(sn, canon)
    }
    populate_type_fields(stmts, "")
}

fn populate_type_fields(stmts: List<SStmt>, mod_path: string) {
    for ss in stmts {
        let inner = stmt_unwrap(ss.node)
        match inner {
            .Module(name, body) -> {
                let child_path = type_qualified_name(mod_path, name)
                populate_type_fields(body, child_path)
            }
            .TypeDecl(name, _, fields) -> {
                let canonical = type_qualified_name(mod_path, name)
                let type_id = avra_rd_begin_type(canonical, "struct")
                for f in fields {
                    let fname = f.name
                    let ftype = vtype_canonical_name(f.resolved)
                    avra_rd_add_type_field(type_id, fname, ftype)
                }
            }
            _ -> {}
        }
    }
}

fn vtype_canonical_name(vt: ValueType) -> string {
    match vt {
        .Int -> "int"
        .Bool -> "bool"
        .Float -> "float"
        .Str -> "string"
        .Bytes -> "bytes"
        .Void -> "void"
        .Ptr -> "ptr"
        .Struct(name, _) -> name
        .Enum(name, _, _) -> name
        .Newtype(name, _, _) -> name
        .Trait(name, _) -> name
        _ -> ""
    }
}

// ── Option C: collect + eval split (step 4 of expand-pipeline doc) ──

/// One macro invocation to perform during the eval phase. Keyed by
/// the @expand site's source span — index-based addressing is
/// brittle because the AST can change shape between phases.
export type ExpandTarget = {
    source_file: string,
    source_line: int,
    source_col: int,
    macro_name: string,
}

/// Output of `expand_macros_collect`: the full list of macros to
/// invoke during `expand_macros_eval`. Components add `comp_macros`
/// so the eval phase doesn't have to recompute the mapping. The
/// stmts pointer is carried through unchanged — pre-resolve walks
/// don't mutate the AST.
export type ExpandPlan = {
    stmts: List<SStmt>,
    targets: List<ExpandTarget>,
    comp_macros: List<CompMacroEntry>,
}

/// Phase 1 (pre-resolve): scan `stmts` for every `@expand(M)` site
/// and every component-instance whose def carries `@expand(M)`.
/// Returns the plan unmodified — no macro is invoked here. Lets
/// `resolve_names` run between collect and eval so that the macro
/// bodies (which themselves call helper fns) see resolved names.
export fn expand_macros_collect(stmts: List<SStmt>) -> ExpandPlan {
    let comp_macros = collect_component_macros(stmts)
    let targets = collect_expand_targets(stmts)
    ExpandPlan { stmts, targets, comp_macros }
}

/// True iff the plan has any work for the eval phase. Lets callers
/// short-circuit the partial re-resolve when no macros exist.
export fn plan_has_work(plan: ExpandPlan) -> bool {
    plan.targets.length > 0 || plan.comp_macros.length > 0
}

fn collect_expand_targets(stmts: List<SStmt>) -> List<ExpandTarget> {
    mut acc: List<ExpandTarget> = []
    for ss in stmts {
        let inner = peel_annotations(ss.node)
        match inner {
            .Module(_, body) -> acc = list_concat(acc, collect_expand_targets(body))
            _ -> {
                if has_expand_annotation(ss.node) {
                    let name = expand_target_name(ss.node)
                    if name != "" {
                        acc = acc.push(ExpandTarget {
                            source_file: ss.file,
                            source_line: ss.line,
                            source_col: ss.col,
                            macro_name: name,
                        })
                    }
                }
            }
        }
    }
    acc
}

/// Phase 2 (post-resolve): walk the stmt list, invoke every macro
/// captured in the plan, splice results back in. Tags every spliced
/// SStmt with `from_macro: true` so the partial re-resolve in
/// `cli/main.av:resolve_and_expand` walks only the new decls. Runs
/// a fixpoint loop so that macro-emitted `@expand` sites expand
/// transitively. Cap at 16 iterations — a self-referential macro
/// terminates with a clean error via `exit(1)`.
export fn expand_macros_eval(plan: ExpandPlan) -> List<SStmt> {
    expand_macros_fixpoint(plan.stmts, plan.comp_macros, false, dummy_resolver_state())
}

/// Stateful variant: takes a `ResolverState` and re-populates the
/// resolver-data layer between fixpoint iterations so that macros
/// firing in iter N+1 can see the names introduced by iter N via
/// `ctx_qualify_ident` / `ctx_lookup_type`. Used by the main pipeline;
/// the stateless `expand_macros_eval` skips the re-populate.
export fn expand_macros_eval_with_state(plan: ExpandPlan, state: ResolverState) -> List<SStmt> {
    expand_macros_fixpoint(plan.stmts, plan.comp_macros, true, state)
}

// ── Public entry (legacy single-pass form) ──

/// Walk `stmts`, expanding every Stmt wrapped in `@expand(M)` by
/// replacing it with the AST returned by M evaluated at compile
/// time. Equivalent to `expand_macros_eval(expand_macros_collect(stmts))` —
/// preserved as a stable surface for tests / call sites that don't
/// care about the collect/eval phase split.
///
/// Fast-path: when the program has no `@expand` annotations the
/// walker returns the input unchanged with no allocations.
///
/// vez6.8.5: also expands ComponentBlock instances of components
/// whose `ComponentDef` carries `@expand(macro)`. The macro fn is
/// looked up via a pre-pass that maps component name → macro fn
/// name; each instance gets the macro applied with the
/// ComponentBlock as a 1-arg Stmt value.
export fn expand_macros(stmts: List<SStmt>) -> List<SStmt> {
    let plan = expand_macros_collect(stmts)
    expand_macros_eval(plan)
}

/// Shared fixpoint loop. Caps at 16 iterations and `exit(1)`s with
/// a clean diagnostic on overflow so a self-referential macro
/// surfaces as a build error instead of a half-expanded binary.
/// `use_state` toggles the per-iter resolver-data re-population —
/// needed so a later-iteration macro can see names introduced by
/// an earlier iteration via `ctx_qualify_ident` / `ctx_lookup_type`.
fn expand_macros_fixpoint(stmts: List<SStmt>, initial_comp_macros: List<CompMacroEntry>, use_state: bool, state: ResolverState) -> List<SStmt> {
    mut current = stmts
    mut current_state = state
    mut iters = 0
    while iters < 16 {
        let comp_macros = if iters == 0 { initial_comp_macros } else { collect_component_macros(current) }
        if !any_expand_annotation(current) && comp_macros.length == 0 {
            return current
        }
        // Refresh resolver-data from any decls introduced by the
        // previous iteration (within-iter changes are handled inside
        // expand_stmt_list itself via register_and_repopulate).
        if use_state && iters > 0 {
            current_state = register_macro_decls(current_state, current)
            populate_resolver_data(current_state, current)
        }
        let reg = collect_comptime_fns(current)
        let walked = expand_stmt_list(current, reg, comp_macros, use_state, current_state)
        current = walked.out
        current_state = walked.state
        iters = iters + 1
    }
    eprintln("error: @expand recursion limit (16) exceeded — a macro is likely emitting code that contains another @expand to itself; check for self-referential @expand sites")
    exit(1)
    current
}


// ── Component-macro pre-pass (vez6.8.5) ──

/// One (component-name → @expand macro fn name) mapping. The full
/// registry is `List<CompMacroEntry>` — built once per program and
/// consulted at every ComponentBlock site.
export type CompMacroEntry = { comp_name: string, macro_name: string }

fn comp_macro_lookup(m: List<CompMacroEntry>, comp_name: string) -> string {
    for e in m {
        if e.comp_name == comp_name { return e.macro_name }
    }
    ""
}

/// Walk the AST, finding every `@expand(macro) component name { ... }`
/// declaration and recording its (name → macro_fn) pair.
fn collect_component_macros(stmts: List<SStmt>) -> List<CompMacroEntry> {
    mut acc: List<CompMacroEntry> = []
    for ss in stmts {
        let inner = peel_annotations(ss.node)
        // ComponentDefs can live inside Module wrappers (e.g.
        // `component command implements Runnable {}` declared
        // in @std/cli's cli.av lands wrapped under
        // Module("@std::cli::cli", ...) in a bundled compile).
        // Without this recursion the (comp_name → macro_fn) map
        // is empty for any def behind a module boundary, so
        // instance dispatch silently skips them.
        match inner {
            .Module(_, body) -> acc = list_concat(acc, collect_component_macros(body))
            _ -> {
                let macro_name = comp_macro_for(ss.node)
                let comp_name = component_def_name(ss.node)
                if macro_name != "" && comp_name != "" {
                    acc = acc.push(CompMacroEntry { comp_name, macro_name })
                }
            }
        }
    }
    acc
}

/// If `stmt` is a ComponentDef wrapped in @expand(M), return M's
/// name. Returns "" otherwise. Handles arbitrarily-nested
/// Annotated wrappers (e.g. `///` doc + `@expand`).
fn comp_macro_for(stmt: Stmt) -> string {
    let inner = peel_annotations(stmt)
    match inner {
        .ComponentDef(_, _, _, _, _, _) -> expand_target_name(stmt)
        _ -> ""
    }
}

fn component_def_name(stmt: Stmt) -> string {
    let inner = peel_annotations(stmt)
    match inner {
        .ComponentDef(name, _, _, _, _, _) -> name
        _ -> ""
    }
}

fn peel_annotations(stmt: Stmt) -> Stmt {
    match stmt {
        .Annotated(_, inner) -> peel_annotations(inner)
        _ -> stmt
    }
}

// ── Fast-path presence scan ──

/// True iff any `@expand` annotation appears anywhere in `stmts`.
/// Walks recursively but allocates nothing — callers only pay for
/// the rewrite walk when the program actually has macros.
/// True iff the program contains anything `expand_macros` would
/// rewrite — either a `@expand` annotation or an instance of a
/// component whose definition carries one. Gates the post-expand
/// re-resolve in `cli/main.av:resolve_and_expand` so we only pay
/// the second walk when there's actually work to splice.
export fn needs_expand_pass(stmts: List<SStmt>) -> bool {
    if any_expand_annotation(stmts) { return true }
    let comp_macros = collect_component_macros(stmts)
    comp_macros.length != 0
}

export fn any_expand_annotation(stmts: List<SStmt>) -> bool {
    mut i = 0
    while i < stmts.length {
        if has_expand_annotation(stmts[i].node) { return true }
        i = i + 1
    }
    false
}

fn has_expand_annotation(stmt: Stmt) -> bool {
    let found = find_annotation(stmt, "expand")
    found != null
}

// ── Walker ──

fn expand_stmt_list(stmts: List<SStmt>, reg: CompTimeRegistry, comp_macros: List<CompMacroEntry>, use_state: bool, in_state: ResolverState) -> WalkerOut {
    expand_stmt_list_in(stmts, reg, comp_macros, use_state, in_state, "")
}

fn expand_stmt_list_in(stmts: List<SStmt>, reg: CompTimeRegistry, comp_macros: List<CompMacroEntry>, use_state: bool, in_state: ResolverState, current_module: string) -> WalkerOut {
    mut out: List<SStmt> = []
    mut current_state = in_state
    for ss in stmts {
        let inner = peel_annotations(ss.node)
        // vez6.8.5: a ComponentDef with @expand only REGISTERS
        // the macro for its instances. The def itself drops
        // out of the output — there's no template-style expansion
        // for the def, only per-instance dispatch.
        match inner {
            .ComponentDef(_, _, _, _, _, _) -> {
                if !has_expand_annotation(ss.node) {
                    out.push(ss)
                }
            }
            .ComponentBlock(comp_name, _, _, _) -> {
                // ComponentBlock instances of @expand'd defs route
                // through the macro pipeline with the block itself
                // as the Stmt arg.
                let inst_macro = comp_macro_lookup(comp_macros, comp_name)
                if inst_macro != "" {
                    if use_state { avra_rd_set_current_module(current_module) }
                    let replacement = try_expand_with_macro(ss.node, inst_macro, reg, ss.line, ss.col, ss.file, current_module)
                    splice_expansion(out, ss, replacement)
                    if use_state && replacement != null {
                        current_state = register_and_repopulate(current_state, replacement!, current_module)
                    }
                } else {
                    out.push(ss)
                }
            }
            // Module bodies have to be walked too — without this,
            // component instances inside an imported module (e.g.
            // `component command build {}` declared inside a
            // submodule of @std/cli) never see the @expand
            // pipeline, and the unprocessed ComponentBlock falls
            // through to codegen with an unsupported tag. Re-wraps
            // the recursed body so the module structure stays
            // intact for downstream resolve/typeck.
            .Module(mod_name, body) -> {
                let child_module = type_qualified_name(current_module, mod_name)
                let sub = expand_stmt_list_in(body, reg, comp_macros, use_state, current_state, child_module)
                current_state = sub.state
                let new_stmt = Stmt.Module(mod_name, sub.out)
                out.push(sstmt_at(new_stmt, ss.line, ss.col, ss.file))
            }
            _ -> {
                if has_expand_annotation(ss.node) {
                    if use_state { avra_rd_set_current_module(current_module) }
                    let replacement = try_expand_one(ss.node, reg, ss.line, ss.col, ss.file, current_module)
                    splice_expansion(out, ss, replacement)
                    if use_state && replacement != null {
                        current_state = register_and_repopulate(current_state, replacement!, current_module)
                    }
                } else {
                    out.push(ss)
                }
            }
        }
    }
    WalkerOut { out, state: current_state }
}

/// Walker's per-iter return: the spliced stmts + the state after any
/// in-iter registrations. The fixpoint loop threads `state` between
/// iterations so the SECOND macro in an `@expand` site that fires
/// later in the same iteration can `ctx_qualify_ident` an introduced
/// name (doc step 4.4 / test 7).
type WalkerOut = {
    out: List<SStmt>,
    state: ResolverState,
}

/// After a macro splice lands, augment the resolver state with the
/// newly-introduced top-level decls and re-populate the C-side
/// resolver-data layer so subsequent ctx_* queries from later macros
/// in the same iter see the new names.
fn register_and_repopulate(state: ResolverState, spliced: List<SStmt>, current_module: string) -> ResolverState {
    mut tagged: List<SStmt> = []
    for ss in spliced { tagged.push(sstmt_mark_from_macro(ss)) }
    let new_state = register_macro_decls(state, tagged)
    populate_resolver_data(new_state, tagged)
    // populate_resolver_data overwrote current_module to ""; restore
    // the per-site value so subsequent ctx_current_module calls keep
    // returning the right module.
    avra_rd_set_current_module(current_module)
    new_state
}

/// Common splicer: replacement-on-success, original-on-failure. Every
/// spliced stmt gets `from_macro = true` so the partial re-resolve
/// in cli/main.av:resolve_and_expand walks them (step 4 of the
/// expand-pipeline doc — Option C).
fn splice_expansion(out: List<SStmt>, ss: SStmt, replacement: List<SStmt>?) {
    mut acc = out
    if replacement != null {
        for r in replacement! { acc.push(sstmt_mark_from_macro(r)) }
    } else {
        // Expansion failed — keep the original stmt so downstream
        // stages surface the issue (resolve / typeck will emit a
        // diagnostic against the unexpanded @expand annotation).
        acc.push(ss)
    }
}

/// Apply a named macro fn to `stmt`, treating the macro's return
/// value as the replacement. Sister to `try_expand_one` but
/// doesn't read the @expand annotation off the stmt — used for
/// vez6.8.5's component-instance dispatch where the macro is
/// inherited from the parent ComponentDef. Caller has already
/// unwrapped any Annotated layers.
fn try_expand_with_macro(stmt: Stmt, macro_name: string, reg: CompTimeRegistry, line: int, col: int, file: string, current_module: string) -> List<SStmt>? {
    invoke_macro(stmt, macro_name, reg, line, col, file, current_module)
}

/// Look up the macro fn name from the `@expand` annotation's first
/// arg, find it in the comptime registry, evaluate it (with the
/// wrapped Stmt as a single arg if the macro is 1-ary, else
/// zero-arg), and decode the result. Returns null when ANY step
/// fails — the caller treats that as "leave this stmt alone".
fn try_expand_one(stmt: Stmt, reg: CompTimeRegistry, line: int, col: int, file: string, current_module: string) -> List<SStmt>? {
    let macro_name = expand_target_name(stmt)
    if macro_name == "" {
        eprintln("error: @expand requires a macro fn identifier as its argument")
        return null
    }
    invoke_macro(stmt_unwrap(stmt), macro_name, reg, line, col, file, current_module)
}

/// Shared driver: locate `macro_name` in the comptime registry,
/// dispatch on arity (0 or 1), eval, and decode the return as
/// either a single Stmt or a List<Stmt>. Returns the replacement
/// list (always a list, even for single-Stmt returns) or null on
/// any failure. Logs context-rich diagnostics so users see which
/// macro / which step failed.
///
/// Multi-stmt support: macros built via `quote stmts { ... }` return
/// `List<SStmt>`, decoded via value_to_stmt_list. This lets a single
/// `@expand` site emit N sibling declarations (e.g. the original
/// type + an impl block + a top-level helper fn) without forcing
/// macros into the singleton-Stmt straightjacket. Marshal and other
/// derives that previously had to bypass @expand entirely can now
/// be expressed directly. Try list first because a List value
/// can't decode as a single Stmt; the second decode is the
/// fallback for traditional `quote stmt { ... }` macros.
///
/// 1-arg macros receive the wrapped Stmt boxed via stmt_to_value
/// (which routes through construct_stmt + eval_expr — so any variant
/// lower.av's construct_stmt encodes roundtrips correctly). Caller
/// is responsible for any annotation peeling: try_expand_one strips
/// @expand before invoking; try_expand_with_macro receives an
/// already-unwrapped ComponentBlock.
fn invoke_macro(stmt: Stmt, macro_name: string, reg: CompTimeRegistry, line: int, col: int, file: string, current_module: string) -> List<SStmt>? {
    let lookup = comptime_lookup(reg, macro_name)
    if lookup == null {
        eprintln("error: @expand(${macro_name}) — no @comptime fn named `${macro_name}` in scope")
        return null
    }
    let fn_def = lookup!
    let arity = fn_def.params.length
    let arg_values = if arity == 1 {
        let boxed = stmt_to_value(reg.runtime, stmt)
        if boxed == null {
            eprintln("error: @expand(${macro_name}) — could not box the wrapped Stmt as a Value (encoder may not yet support this Stmt variant)")
            return null
        }
        [boxed!]
    } else if arity == 0 {
        []
    } else if arity == 2 {
        // qa6i step 5: 2-arg macro receives (AnnotatedDecl, ResolverCtx).
        // The first arg boxes the wrapped decl + its @expand annotation
        // metadata; the second gives the macro an opaque handle the
        // compiler uses to dispatch ctx_* queries against the active
        // ResolverState.
        let boxed = stmt_to_value(reg.runtime, stmt)
        if boxed == null {
            eprintln("error: @expand(${macro_name}) — could not box the wrapped Stmt as a Value (encoder may not yet support this Stmt variant)")
            return null
        }
        let annotated = build_annotated_decl(boxed!, decl_name_of(stmt), current_module)
        let handle = avra_resolver_ctx_top()
        let ctx = build_resolver_ctx(handle)
        [annotated, ctx]
    } else {
        eprintln("error: @expand(${macro_name}) — macro has ${arity} parameters; @expand supports 0-, 1-, or 2-arg macros only")
        return null
    }
    let result = eval_fn_with_resolved_args(reg.runtime, fn_def.params, fn_def.body, arg_values)
    if step_had_error(result) {
        eprintln("error: @expand(${macro_name}) — macro evaluation failed: ${step_error_message(result)}")
        return null
    }
    let v = step_value(result)
    // Try ResolvedDecls first — the 2-arg macro return type per doc
    // step 4.4. value_to_resolved_decls returns null when v isn't a
    // `{decls, introduces, provenance}` struct, so non-ResolvedDecls
    // returns fall through to the existing decoders.
    let as_rd = value_to_resolved_decls(v)
    if as_rd != null {
        let rd = as_rd!
        mut out: List<SStmt> = []
        for ss in rd.decls {
            out.push(sstmt_at(ss.node, line, col, file))
        }
        return out
    }
    // Try List<SStmt> — what `quote stmts { ... }` produces.
    // value_to_stmt_list returns null when v isn't a list, so this is
    // the cheap dispatch.
    let as_list = value_to_stmt_list(v)
    if as_list != null {
        mut out: List<SStmt> = []
        for ss in as_list! {
            out.push(sstmt_at(ss.node, line, col, file))
        }
        return out
    }
    // Fall back to single Stmt — `quote stmt { ... }` macros.
    let decoded = value_to_stmt(v)
    if decoded == null {
        eprintln("error: @expand(${macro_name}) — macro returned a value the expander could not decode into a Stmt, List<Stmt>, or ResolvedDecls (kind=${v.kind})")
        return null
    }
    [sstmt_at(decoded!, line, col, file)]
}

/// Decode a `ResolvedDecls` struct Value into the per-decl list.
/// Returns null when the Value doesn't match the expected shape so
/// the caller can fall through to other decoders. The `decls` field
/// is decoded via `value_to_stmt_list`; `introduces` + `provenance`
/// aren't read here — `register_macro_decls` runs against the actual
/// post-expand AST, which is the same set of decls the macro returned.
fn value_to_resolved_decls(v: Value) -> ResolvedDeclsPayload? {
    if v.kind != "struct" { return null }
    // Match by suffix — the qualified form depends on how rewrite_uses
    // canonicalised the StructLit's type name (may be bare, may include
    // the @std::… path). path_last_segment ignores the prefix.
    let last = path_last_segment(v.struct_type)
    if last != "ResolvedDecls" { return null }
    mut decls_field: Value? = null
    for f in v.struct_payload {
        if f.name == "decls" { decls_field = f.value }
    }
    if decls_field == null { return null }
    let decls = value_to_stmt_list(decls_field!)
    if decls == null { return null }
    ResolvedDeclsPayload { decls: decls! }
}

/// Internal carrier for the decoded ResolvedDecls. The full type lives
/// in macro_types.av but it carries non-Value fields (provenance) the
/// invoker doesn't need; this is just enough to drive the splice.
type ResolvedDeclsPayload = { decls: List<SStmt> }

/// Pull the macro-fn identifier out of the `@expand(NAME)` annotation
/// args. Returns "" when the annotation isn't present, has no args,
/// or the first arg isn't a bare Ident / QualifiedIdent.
fn expand_target_name(stmt: Stmt) -> string {
    let found = find_annotation(stmt, "expand")
    if found == null { return "" }
    first_arg_ident(found!.args)
}

fn first_arg_ident(args: List<SExpr>) -> string {
    if args.length == 0 { return "" }
    match args[0].node {
        .Ident(name) -> name
        .QualifiedIdent(path) -> path
        _ -> ""
    }
}

// ── 2-arg @expand value builders (step 5) ──

/// Build a `@std::avrac::features::comptime::macro_types::AnnotatedDecl`
/// struct Value to pass as the first arg of a 2-arg macro. Per the
/// doc shape:
///   - stmt: the boxed (unwrapped) decl Value
///   - annotation: `{name, args}` struct for the @expand annotation
///   - canonical_path: qualified path to the decl (mod::name)
/// args lands as an empty list — args carry SExpr ASTs, and the
/// macro-side type expects `List<SExpr>`; encoding each runtime SExpr
/// Value back into the macro is a follow-up. The name field is the
/// useful piece for macros today ("expand" so the macro knows which
/// annotation triggered it).
fn build_annotated_decl(stmt_v: Value, decl_name: string, current_module: string) -> Value {
    let canonical = type_qualified_name(current_module, decl_name)
    let empty_args: List<Value> = []
    mut ann_fields: List<StructField> = []
    ann_fields.push(StructField { name: "name", value: value_string("expand") })
    ann_fields.push(StructField { name: "args", value: value_list(empty_args) })
    let annotation_v = value_struct("@std::avrac::core::Annotation", ann_fields)
    mut fields: List<StructField> = []
    fields.push(StructField { name: "stmt", value: stmt_v })
    fields.push(StructField { name: "annotation", value: annotation_v })
    fields.push(StructField { name: "canonical_path", value: value_string(canonical) })
    value_struct("@std::avrac::features::comptime::macro_types::AnnotatedDecl", fields)
}

/// Extract the decl name from a (possibly unwrapped) Stmt — the name
/// slot of Function / TypeDecl / EnumDecl / etc. Used to compute
/// AnnotatedDecl.canonical_path. Returns "" when the Stmt isn't a
/// declaration with a name.
fn decl_name_of(stmt: Stmt) -> string {
    match stmt {
        .Function(name, _, _, _, _) -> name
        .ExternFn(name, _, _) -> name
        .TypeDecl(name, _, _) -> name
        .EnumDecl(name, _, _) -> name
        .NewtypeDecl(name, _) -> name
        .UnionAliasDecl(name, _) -> name
        .ShapeDecl(name, _) -> name
        .TraitDecl(name, _) -> name
        .Impl(target, _) -> target
        .ComponentDef(name, _, _, _, _, _) -> name
        .Annotated(_, inner) -> decl_name_of(inner)
        _ -> ""
    }
}

/// Build a `@std::avrac::features::comptime::resolver_ctx::ResolverCtx`
/// struct Value carrying the handle for the active ResolverState. The
/// ctx_* extern fns the macro calls extract this id and route to the
/// compiler-side dispatchers in `features/eval/mod.av`.
fn build_resolver_ctx(handle: int) -> Value {
    mut fields: List<StructField> = []
    fields.push(StructField { name: "id", value: value_number(string(handle)) })
    value_struct("@std::avrac::features::comptime::resolver_ctx::ResolverCtx", fields)
}
