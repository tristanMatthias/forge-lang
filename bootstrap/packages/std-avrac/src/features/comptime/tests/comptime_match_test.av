// ty5v: regression test for tree-walk-evaluator match support. The
// canonical vez6.8 macro pattern is `match s { .ComponentBlock(...)
// -> ... }` — without match-eval the comptime fold errors with
// "match statements are not supported by the tree-walk evaluator".

use @std.avrac.core.{Stmt, StmtList, Expr, ExprList, SExpr, sexpr_dummy, sstmt_dummy, ParamList, ValueType, BinOp, Pattern, MatchArm, render_expr}
use @std.avrac.features.eval.{Value, value_enum, value_number, eval_fn_with_resolved_args, step_value, step_had_error, runtime_new}
use @std.avrac.features.comptime.{CompTimeFn, CompTimeRegistry, try_fold_call, prepare_runtime, comptime_registry_new}

// `fn classify(x: int) -> int {
//     match x {
//         0 -> 100
//         1 -> 200
//         _ -> 999
//     }
// }`
fn mk_int_match_fn() -> CompTimeFn {
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: Pattern.LitInt(0), guard: null, body: sexpr_dummy(Expr.Number("100")) })
    arms.push(MatchArm { pattern: Pattern.LitInt(1), guard: null, body: sexpr_dummy(Expr.Number("200")) })
    arms.push(MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_dummy(Expr.Number("999")) })
    let return_expr = Expr.MatchExpr(Expr.Ident("x"), arms)
    let body = StmtList.Node(sstmt_dummy(Stmt.Return(return_expr)), StmtList.End)
    CompTimeFn {
        name: "classify",
        params: ParamList.Node("x", ValueType.Int, ParamList.End),
        ret_ty: ValueType.Int,
        body,
    }
}

fn int_match_registry() -> CompTimeRegistry {
    let staged = comptime_registry_new() with { fns: [mk_int_match_fn()] }
    prepare_runtime(staged)
}

fn number_text_of(e: Expr) -> string {
    match e {
        .Number(text) -> text
        _ -> ""
    }
}

fn mk_call(name: string, args: ExprList) -> Expr {
    Expr.Call(Expr.Ident(name), args)
}

spec "ty5v: match on integer literal patterns" {
    then "0 hits the first arm (100)" {
        let args = ExprList.Node(sexpr_dummy(Expr.Number("0")), ExprList.End)
        let folded = try_fold_call(int_match_registry(), mk_call("classify", args))
        folded != null && number_text_of(folded!) == "100"
    }
    then "1 hits the second arm (200)" {
        let args = ExprList.Node(sexpr_dummy(Expr.Number("1")), ExprList.End)
        let folded = try_fold_call(int_match_registry(), mk_call("classify", args))
        folded != null && number_text_of(folded!) == "200"
    }
    then "anything else hits the wildcard (999)" {
        let args = ExprList.Node(sexpr_dummy(Expr.Number("42")), ExprList.End)
        let folded = try_fold_call(int_match_registry(), mk_call("classify", args))
        folded != null && number_text_of(folded!) == "999"
    }
}

// `fn label(s: string) -> int {
//     match s {
//         "one" -> 1
//         "two" -> 2
//         _ -> 0
//     }
// }`
fn mk_string_match_fn() -> CompTimeFn {
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: Pattern.LitString("one"), guard: null, body: sexpr_dummy(Expr.Number("1")) })
    arms.push(MatchArm { pattern: Pattern.LitString("two"), guard: null, body: sexpr_dummy(Expr.Number("2")) })
    arms.push(MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_dummy(Expr.Number("0")) })
    let return_expr = Expr.MatchExpr(Expr.Ident("s"), arms)
    let body = StmtList.Node(sstmt_dummy(Stmt.Return(return_expr)), StmtList.End)
    CompTimeFn {
        name: "label",
        params: ParamList.Node("s", ValueType.Str, ParamList.End),
        ret_ty: ValueType.Int,
        body,
    }
}

fn string_match_registry() -> CompTimeRegistry {
    let staged = comptime_registry_new() with { fns: [mk_string_match_fn()] }
    prepare_runtime(staged)
}

spec "ty5v: match on string literal patterns" {
    then "\"one\" -> 1" {
        let args = ExprList.Node(sexpr_dummy(Expr.String("\"one\"")), ExprList.End)
        let folded = try_fold_call(string_match_registry(), mk_call("label", args))
        folded != null && number_text_of(folded!) == "1"
    }
    then "\"two\" -> 2" {
        let args = ExprList.Node(sexpr_dummy(Expr.String("\"two\"")), ExprList.End)
        let folded = try_fold_call(string_match_registry(), mk_call("label", args))
        folded != null && number_text_of(folded!) == "2"
    }
    then "\"other\" -> 0 (wildcard)" {
        let args = ExprList.Node(sexpr_dummy(Expr.String("\"three\"")), ExprList.End)
        let folded = try_fold_call(string_match_registry(), mk_call("label", args))
        folded != null && number_text_of(folded!) == "0"
    }
}

// Exercise enum-variant matching directly via eval_fn_with_resolved_args
// (try_fold_call rejects EnumCtor args — only literal Number/String/Bool/Null).
//
// `fn unwrap_or_zero(arg: Option) -> int {
//     match arg {
//         .Some(x) -> x
//         .None    -> 0
//     }
// }`
fn mk_unwrap_fn() -> CompTimeFn {
    let some_pat = Pattern.Variant("Some", ParamList.Node("x", ValueType.Unknown, ParamList.End))
    let none_pat = Pattern.Variant("None", ParamList.End)
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: some_pat, guard: null, body: sexpr_dummy(Expr.Ident("x")) })
    arms.push(MatchArm { pattern: none_pat, guard: null, body: sexpr_dummy(Expr.Number("0")) })
    let return_expr = Expr.MatchExpr(Expr.Ident("arg"), arms)
    let body = StmtList.Node(sstmt_dummy(Stmt.Return(return_expr)), StmtList.End)
    CompTimeFn {
        name: "unwrap_or_zero",
        params: ParamList.Node("arg", ValueType.Unknown, ParamList.End),
        ret_ty: ValueType.Int,
        body,
    }
}

spec "ty5v: enum-variant match with payload binding" {
    then ".Some(42) extracts 42" {
        let fn_def = mk_unwrap_fn()
        let some_payload: List<Value> = [value_number("42")]
        let some_val = value_enum("Option", "Some", some_payload)
        let result = eval_fn_with_resolved_args(runtime_new(), fn_def.params, fn_def.body, [some_val])
        !step_had_error(result) && step_value(result).number_text == "42"
    }
    then ".None returns 0" {
        let fn_def = mk_unwrap_fn()
        let none_val = value_enum("Option", "None", [])
        let result = eval_fn_with_resolved_args(runtime_new(), fn_def.params, fn_def.body, [none_val])
        !step_had_error(result) && step_value(result).number_text == "0"
    }
}

// Or-pattern: multiple variant names in one arm
// `fn red_or_green(c: Color) -> int {
//     match c {
//         .Red | .Green -> 1
//         .Blue -> 2
//     }
// }`
fn mk_or_pattern_fn() -> CompTimeFn {
    let red_pat = Pattern.Variant("Red", ParamList.End)
    let green_pat = Pattern.Variant("Green", ParamList.End)
    let blue_pat = Pattern.Variant("Blue", ParamList.End)
    let or_pat = Pattern.Or(red_pat, green_pat)
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: or_pat, guard: null, body: sexpr_dummy(Expr.Number("1")) })
    arms.push(MatchArm { pattern: blue_pat, guard: null, body: sexpr_dummy(Expr.Number("2")) })
    let return_expr = Expr.MatchExpr(Expr.Ident("c"), arms)
    let body = StmtList.Node(sstmt_dummy(Stmt.Return(return_expr)), StmtList.End)
    CompTimeFn {
        name: "red_or_green",
        params: ParamList.Node("c", ValueType.Unknown, ParamList.End),
        ret_ty: ValueType.Int,
        body,
    }
}

spec "ty5v: or-pattern matches either variant" {
    then ".Red hits the or-arm" {
        let fn_def = mk_or_pattern_fn()
        let val = value_enum("Color", "Red", [])
        let result = eval_fn_with_resolved_args(runtime_new(), fn_def.params, fn_def.body, [val])
        !step_had_error(result) && step_value(result).number_text == "1"
    }
    then ".Green hits the or-arm" {
        let fn_def = mk_or_pattern_fn()
        let val = value_enum("Color", "Green", [])
        let result = eval_fn_with_resolved_args(runtime_new(), fn_def.params, fn_def.body, [val])
        !step_had_error(result) && step_value(result).number_text == "1"
    }
    then ".Blue takes the second arm" {
        let fn_def = mk_or_pattern_fn()
        let val = value_enum("Color", "Blue", [])
        let result = eval_fn_with_resolved_args(runtime_new(), fn_def.params, fn_def.body, [val])
        !step_had_error(result) && step_value(result).number_text == "2"
    }
}

// Match-as-statement with a Block body containing return
// `fn pick(x: int) -> int {
//     match x {
//         0 -> { return 10 }
//         _ -> { return 99 }
//     }
//     return -1   // unreachable
// }`
fn mk_match_stmt_with_return_fn() -> CompTimeFn {
    let arm0_block = Expr.Block(StmtList.Node(
        sstmt_dummy(Stmt.Return(Expr.Number("10"))),
        StmtList.End))
    let arm_wild_block = Expr.Block(StmtList.Node(
        sstmt_dummy(Stmt.Return(Expr.Number("99"))),
        StmtList.End))
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: Pattern.LitInt(0), guard: null, body: sexpr_dummy(arm0_block) })
    arms.push(MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_dummy(arm_wild_block) })
    let body = StmtList.Node(
        sstmt_dummy(Stmt.Match(Expr.Ident("x"), arms)),
        StmtList.Node(sstmt_dummy(Stmt.Return(Expr.Unary(UnOp.Neg, Expr.Number("1")))), StmtList.End))
    CompTimeFn {
        name: "pick",
        params: ParamList.Node("x", ValueType.Int, ParamList.End),
        ret_ty: ValueType.Int,
        body,
    }
}

fn match_stmt_registry() -> CompTimeRegistry {
    let staged = comptime_registry_new() with { fns: [mk_match_stmt_with_return_fn()] }
    prepare_runtime(staged)
}

spec "ty5v: match statement with Block body + return propagates" {
    then "0 -> 10 (block return)" {
        let args = ExprList.Node(sexpr_dummy(Expr.Number("0")), ExprList.End)
        let folded = try_fold_call(match_stmt_registry(), mk_call("pick", args))
        folded != null && number_text_of(folded!) == "10"
    }
    then "anything else -> 99 (wildcard block return)" {
        let args = ExprList.Node(sexpr_dummy(Expr.Number("7")), ExprList.End)
        let folded = try_fold_call(match_stmt_registry(), mk_call("pick", args))
        folded != null && number_text_of(folded!) == "99"
    }
}
