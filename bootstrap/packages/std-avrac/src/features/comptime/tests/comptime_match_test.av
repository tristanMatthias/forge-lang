// ty5v: regression test for tree-walk-evaluator match support. The
// canonical vez6.8 macro pattern is `match s { .ComponentBlock(...)
// -> ... }` — without match-eval the comptime fold errors with
// "match statements are not supported by the tree-walk evaluator".

use @std.avrac.core.{NodeStore, StmtId, ExprId, new_node_store, build_line_index, Stmt, SStmt, Expr, SExpr, sexpr_dummy, sstmt_dummy, ParamEntry, ValueType, BinOp, Pattern, MatchArm, render_expr}
use @std.avrac.features.eval.{Value, value_enum, value_number, eval_fn_with_resolved_args, step_value, step_had_error, runtime_new}
use @std.avrac.features.comptime.{CompTimeFn, CompTimeRegistry, try_fold_call, prepare_runtime, comptime_registry_new}

/// Fresh empty store for inline-AST probes — F2 renderers resolve
/// flipped pattern ids through it (never read for id-free nodes).
fn ts() -> NodeStore {
    new_node_store(build_line_index(""))
}


// `fn classify(x: int) -> int {
//     match x {
//         0 -> 100
//         1 -> 200
//         _ -> 999
//     }
// }`
fn mk_int_match_fn(ws: NodeStore) -> CompTimeFn {
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: Pattern.LitInt(0), guard: null, body: sexpr_dummy(Expr.Number("100")) })
    arms.push(MatchArm { pattern: Pattern.LitInt(1), guard: null, body: sexpr_dummy(Expr.Number("200")) })
    arms.push(MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_dummy(Expr.Number("999")) })
    let return_expr = ws.exprs.add_leaf(Expr.MatchExpr(ws.exprs.add_leaf(Expr.Ident("x")), arms))
    let body: List<StmtId> = [ws.stmts.add_leaf(Stmt.Return(return_expr))]
    CompTimeFn {
        name: "classify",
        params: [ParamEntry { name: "x", vtype: ValueType.Int }],
        ret_ty: ValueType.Int,
        body,
    }
}

fn int_match_registry() -> CompTimeRegistry {
    let ws = ts()
    let staged = comptime_registry_new(ws) with { fns: [mk_int_match_fn(ws)] }
    prepare_runtime(staged)
}

fn number_text_of(e: Expr) -> string {
    match e {
        .Number(text) -> text
        _ -> ""
    }
}

// Post-flip the callee is an ExprId and the args are `List<ExprId>` —
// both allocated into `store`, the SAME store the registry's runtime
// resolves ids through.
fn mk_call(store: NodeStore, name: string, args: List<ExprId>) -> Expr {
    Expr.Call(store.exprs.add_leaf(Expr.Ident(name)), args)
}

spec "ty5v: match on integer literal patterns" {
    then "0 hits the first arm (100)" {
        let reg = int_match_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.Number("0"))]
        let folded = try_fold_call(reg, mk_call(store, "classify", args))
        folded != null && number_text_of(folded!) == "100"
    }
    then "1 hits the second arm (200)" {
        let reg = int_match_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.Number("1"))]
        let folded = try_fold_call(reg, mk_call(store, "classify", args))
        folded != null && number_text_of(folded!) == "200"
    }
    then "anything else hits the wildcard (999)" {
        let reg = int_match_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.Number("42"))]
        let folded = try_fold_call(reg, mk_call(store, "classify", args))
        folded != null && number_text_of(folded!) == "999"
    }
}

// `fn label(s: string) -> int {
//     match s {
//         "one" -> 1
//         "two" -> 2
//         _ -> 0
//     }
// }`
fn mk_string_match_fn(ws: NodeStore) -> CompTimeFn {
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: Pattern.LitString("one"), guard: null, body: sexpr_dummy(Expr.Number("1")) })
    arms.push(MatchArm { pattern: Pattern.LitString("two"), guard: null, body: sexpr_dummy(Expr.Number("2")) })
    arms.push(MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_dummy(Expr.Number("0")) })
    let return_expr = ws.exprs.add_leaf(Expr.MatchExpr(ws.exprs.add_leaf(Expr.Ident("s")), arms))
    let body: List<StmtId> = [ws.stmts.add_leaf(Stmt.Return(return_expr))]
    CompTimeFn {
        name: "label",
        params: [ParamEntry { name: "s", vtype: ValueType.Str }],
        ret_ty: ValueType.Int,
        body,
    }
}

fn string_match_registry() -> CompTimeRegistry {
    let ws = ts()
    let staged = comptime_registry_new(ws) with { fns: [mk_string_match_fn(ws)] }
    prepare_runtime(staged)
}

spec "ty5v: match on string literal patterns" {
    then "\"one\" -> 1" {
        let reg = string_match_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.String("\"one\""))]
        let folded = try_fold_call(reg, mk_call(store, "label", args))
        folded != null && number_text_of(folded!) == "1"
    }
    then "\"two\" -> 2" {
        let reg = string_match_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.String("\"two\""))]
        let folded = try_fold_call(reg, mk_call(store, "label", args))
        folded != null && number_text_of(folded!) == "2"
    }
    then "\"other\" -> 0 (wildcard)" {
        let reg = string_match_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.String("\"three\""))]
        let folded = try_fold_call(reg, mk_call(store, "label", args))
        folded != null && number_text_of(folded!) == "0"
    }
}

// Exercise enum-variant matching directly via eval_fn_with_resolved_args
// (try_fold_call rejects EnumCtor args — only literal Number/String/Bool/Null).
//
// `fn unwrap_or_zero(arg: Option) -> int {
//     match arg {
//         .Some(x) -> x
//         .None    -> 0
//     }
// }`
fn mk_unwrap_fn(ws: NodeStore) -> CompTimeFn {
    let some_bindings: List<ParamEntry> = [ParamEntry { name: "x", vtype: ValueType.Unknown }]
    let some_pat = Pattern.Variant("Some", some_bindings)
    let none_bindings: List<ParamEntry> = []
    let none_pat = Pattern.Variant("None", none_bindings)
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: some_pat, guard: null, body: sexpr_dummy(Expr.Ident("x")) })
    arms.push(MatchArm { pattern: none_pat, guard: null, body: sexpr_dummy(Expr.Number("0")) })
    let return_expr = ws.exprs.add_leaf(Expr.MatchExpr(ws.exprs.add_leaf(Expr.Ident("arg")), arms))
    let body: List<StmtId> = [ws.stmts.add_leaf(Stmt.Return(return_expr))]
    CompTimeFn {
        name: "unwrap_or_zero",
        params: [ParamEntry { name: "arg", vtype: ValueType.Unknown }],
        ret_ty: ValueType.Int,
        body,
    }
}

spec "ty5v: enum-variant match with payload binding" {
    then ".Some(42) extracts 42" {
        let ws = ts()
        let fn_def = mk_unwrap_fn(ws)
        let some_payload: List<Value> = [value_number("42")]
        let some_val = value_enum("Option", "Some", some_payload)
        let result = eval_fn_with_resolved_args(runtime_new(ws), fn_def.params, fn_def.body, [some_val])
        !step_had_error(result) && step_value(result).number_text == "42"
    }
    then ".None returns 0" {
        let ws = ts()
        let fn_def = mk_unwrap_fn(ws)
        let none_val = value_enum("Option", "None", [])
        let result = eval_fn_with_resolved_args(runtime_new(ws), fn_def.params, fn_def.body, [none_val])
        !step_had_error(result) && step_value(result).number_text == "0"
    }
}

// Or-pattern: multiple variant names in one arm
// `fn red_or_green(c: Color) -> int {
//     match c {
//         .Red | .Green -> 1
//         .Blue -> 2
//     }
// }`
fn mk_or_pattern_fn(ws: NodeStore) -> CompTimeFn {
    // F2: Or branches are arena rows — allocated into the SAME store the
    // eval runtime resolves through (ids are store-relative).
    let no_bindings: List<ParamEntry> = []
    let red_pat = Pattern.Variant("Red", no_bindings)
    let green_pat = Pattern.Variant("Green", no_bindings)
    let blue_pat = Pattern.Variant("Blue", no_bindings)
    let or_pat = Pattern.Or(ws.pats.add_leaf(red_pat), ws.pats.add_leaf(green_pat))
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: or_pat, guard: null, body: sexpr_dummy(Expr.Number("1")) })
    arms.push(MatchArm { pattern: blue_pat, guard: null, body: sexpr_dummy(Expr.Number("2")) })
    let return_expr = ws.exprs.add_leaf(Expr.MatchExpr(ws.exprs.add_leaf(Expr.Ident("c")), arms))
    let body: List<StmtId> = [ws.stmts.add_leaf(Stmt.Return(return_expr))]
    CompTimeFn {
        name: "red_or_green",
        params: [ParamEntry { name: "c", vtype: ValueType.Unknown }],
        ret_ty: ValueType.Int,
        body,
    }
}

spec "ty5v: or-pattern matches either variant" {
    then ".Red hits the or-arm" {
        let ws = ts()
        let fn_def = mk_or_pattern_fn(ws)
        let val = value_enum("Color", "Red", [])
        let result = eval_fn_with_resolved_args(runtime_new(ws), fn_def.params, fn_def.body, [val])
        !step_had_error(result) && step_value(result).number_text == "1"
    }
    then ".Green hits the or-arm" {
        let ws = ts()
        let fn_def = mk_or_pattern_fn(ws)
        let val = value_enum("Color", "Green", [])
        let result = eval_fn_with_resolved_args(runtime_new(ws), fn_def.params, fn_def.body, [val])
        !step_had_error(result) && step_value(result).number_text == "1"
    }
    then ".Blue takes the second arm" {
        let ws = ts()
        let fn_def = mk_or_pattern_fn(ws)
        let val = value_enum("Color", "Blue", [])
        let result = eval_fn_with_resolved_args(runtime_new(ws), fn_def.params, fn_def.body, [val])
        !step_had_error(result) && step_value(result).number_text == "2"
    }
}

// Match-as-statement with a Block body containing return
// `fn pick(x: int) -> int {
//     match x {
//         0 -> { return 10 }
//         _ -> { return 99 }
//     }
//     return -1   // unreachable
// }`
fn mk_match_stmt_with_return_fn(ws: NodeStore) -> CompTimeFn {
    let arm0_stmts: List<SStmt> = [sstmt_dummy(Stmt.Return(ws.exprs.add_leaf(Expr.Number("10"))))]
    let arm0_block = Expr.Block(arm0_stmts)
    let arm_wild_stmts: List<SStmt> = [sstmt_dummy(Stmt.Return(ws.exprs.add_leaf(Expr.Number("99"))))]
    let arm_wild_block = Expr.Block(arm_wild_stmts)
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: Pattern.LitInt(0), guard: null, body: sexpr_dummy(arm0_block) })
    arms.push(MatchArm { pattern: Pattern.Wildcard, guard: null, body: sexpr_dummy(arm_wild_block) })
    let subj = ws.exprs.add_leaf(Expr.Ident("x"))
    let body: List<StmtId> = [
        ws.stmts.add_leaf(Stmt.Match(subj, arms)),
        ws.stmts.add_leaf(Stmt.Return(ws.exprs.add_leaf(Expr.Unary(UnOp.Neg, ws.exprs.add_leaf(Expr.Number("1")))))),
    ]
    CompTimeFn {
        name: "pick",
        params: [ParamEntry { name: "x", vtype: ValueType.Int }],
        ret_ty: ValueType.Int,
        body,
    }
}

fn match_stmt_registry() -> CompTimeRegistry {
    let ws = ts()
    let staged = comptime_registry_new(ws) with { fns: [mk_match_stmt_with_return_fn(ws)] }
    prepare_runtime(staged)
}

spec "ty5v: match statement with Block body + return propagates" {
    then "0 -> 10 (block return)" {
        let reg = match_stmt_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.Number("0"))]
        let folded = try_fold_call(reg, mk_call(store, "pick", args))
        folded != null && number_text_of(folded!) == "10"
    }
    then "anything else -> 99 (wildcard block return)" {
        let reg = match_stmt_registry()
        let store = reg.runtime.nodes
        let args: List<ExprId> = [store.exprs.add_leaf(Expr.Number("7"))]
        let folded = try_fold_call(reg, mk_call(store, "pick", args))
        folded != null && number_text_of(folded!) == "99"
    }
}
