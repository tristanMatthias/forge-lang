// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 4 test 4 part 2:
// "test the recursion cap: a self-referential macro should produce a
// clean 'macro recursion limit (16) exceeded' error, not a stack
// overflow."
//
// `loop_macro` emits a fn carrying `@expand(loop_macro)` — every
// fixpoint iteration the loop re-fires. expand_macros_fixpoint caps
// iterations at 16, prints a recognisable diagnostic, then exits(1)
// so the compile fails visibly. The captured output carries the cap
// message, proving the cap fired instead of the process diverging.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "@expand recursion cap fires on infinite self-recursion" {
    then "self-referential @expand stops at 16 iterations with a diagnostic" {
        let out = write_fixture_and_run("/tmp/avra_expand_recursion_cap_test.av", 
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn loop_macro() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        @expand(loop_macro)\n" +
            "        fn carrier() {}\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(loop_macro)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("recursion limit")
    }
}
