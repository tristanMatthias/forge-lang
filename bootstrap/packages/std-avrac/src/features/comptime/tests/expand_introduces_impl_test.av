// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 4 test.
// Verifies a @expand macro can introduce an impl block whose
// methods are callable from main. Complements the fn/type/enum
// introduction tests with the fourth decl-shape.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{cached_fixture_run}

fn write_temp(path: string, source: string) -> string {
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
}

fn run_capture(source: string) -> string {
    let path = "/tmp/avra_expand_introduces_impl_test.av"
    write_temp(path, source)
    cached_fixture_run(path)
}

spec "qa6i: @expand macro can introduce an impl block callable from main" {
    then "macro-emitted greet() on MyType returns 'hi' at runtime" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "type MyType = { x: int }\n" +
            "\n" +
            "@comptime\n" +
            "fn build_impl() -> Stmt {\n" +
            "    quote stmt {\n" +
            "        impl MyType {\n" +
            "            fn greet(self) -> string { \"hi\" }\n" +
            "        }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(build_impl)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {\n" +
            "    let m = MyType { x: 1 }\n" +
            "    println(m.greet())\n" +
            "}\n")
        out.contains("hi")
    }
}
