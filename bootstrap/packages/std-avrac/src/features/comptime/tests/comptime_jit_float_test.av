// ps3t.5.2.1.1 part a — extend the compiled-comptime (JIT) fold to FLOAT returns.
// Slice A JIT-folded int, then bool (ps3t.5.2.1); a float-returning @comptime fn
// fell back to the interpreter because avra_llvm_jit_call reads the INTEGER
// return register, and a `double` comes back in an FP register (xmm0/d0). The
// float sibling avra_llvm_jit_call_f64 casts the JIT'd address to a
// double-returning fn pointer so the ABI reads the FP register; the result is
// rendered through the SAME `render_float` the interpreter uses, so a JIT fold
// and an interpreter fold splice byte-identical Expr.FloatLit literals (gated by
// tests/difftest_corpus/comptime_float_fold.av).
//
// The fns below are JIT-ELIGIBLE (float return, int/no params, jit-safe bodies —
// FloatLit is blessed, `/` is not), so bs2 folds them through the JIT at COMPILE
// time. These specs COMPILE + RUN a fixture and assert its stdout: `string(<fold>)`
// is an integer context, so a wrong JIT result (e.g. reading the int register, or
// a bad FP marshal) reaches stdout verbatim rather than being masked by a float
// type annotation. Float PARAMS stay interpreter-folded (FP-register args are a
// separate step); part b (string returns) is still interpreter-only.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

/// Compile `source` with the current `./build/bs2` (which JIT-folds the
/// eligible float @comptime calls), link, run, and return stdout.
fn run_fixture(tag: string, source: string) -> string {
    let path = "/tmp/avra_jitf_${tag}.av"
    write_fixture(path, source)
    avra_shell_exec("timeout 90 bash scripts/diagnose.sh --run '${path}' 2>/dev/null || true")
}

spec "ps3t.5.2.1.1: a float-returning @comptime fn JIT-folds to its correct value" {
    then "a bare float-literal return JIT-folds to the exact float" {
        let out = run_fixture("bare",
            "@comptime\nfn half() -> float { return 3.5 }\n" +
            "@comptime\nfn pi() -> float { return 3.14 }\n" +
            "fn main() {\n" +
            "    println(string(half()))\n" +
            "    println(string(pi()))\n" +
            "}\n")
        out.contains("3.5") && out.contains("3.14")
    }
    then "float add/sub/mul in the body JIT-fold in double (no operand truncation)" {
        let out = run_fixture("arith",
            "@comptime\nfn addf() -> float { return 1.5 + 2.5 }\n" +      // 4.0 -> "4"
            "@comptime\nfn combo() -> float { return 1.5 + 2.5 - 1.0 }\n" +  // 3.0 -> "3"
            "@comptime\nfn scale() -> float { return 1.5 * 4.0 }\n" +     // 6.0 -> "6"
            "@comptime\nfn frac() -> float { return 0.5 + 0.25 }\n" +     // 0.75
            "fn main() {\n" +
            "    println(string(addf()))\n" +
            "    println(string(combo()))\n" +
            "    println(string(scale()))\n" +
            "    println(string(frac()))\n" +
            "}\n")
        out.contains("4") && out.contains("3") && out.contains("6") && out.contains("0.75")
    }
    then "an int param (int-register arg) with a float return JIT-folds correctly" {
        let out = run_fixture("intparam",
            "@comptime\nfn konst(n: int) -> float { return 2.25 }\n" +
            "fn main() { println(string(konst(7))) }\n")   // 2.25
        out.contains("2.25")
    }
    then "a transitive float callee (via_callee -> base) JIT-folds the whole closure" {
        let out = run_fixture("transitive",
            "@comptime\nfn base() -> float { return 2.5 }\n" +
            "@comptime\nfn via_callee() -> float { return base() + 1.0 }\n" +
            "fn main() { println(string(via_callee())) }\n")   // 3.5
        out.contains("3.5")
    }
    then "an if-expr body returning float JIT-folds on both branches" {
        let out = run_fixture("ifexpr",
            "@comptime\nfn pick(flag: int) -> float { return if flag > 0 { 1.5 } else { 9.25 } }\n" +
            "fn main() {\n" +
            "    println(string(pick(1)))\n" +   // 1.5
            "    println(string(pick(0)))\n" +   // 9.25
            "}\n")
        out.contains("1.5") && out.contains("9.25")
    }
}
