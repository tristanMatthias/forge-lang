// vez6.6.5/num — Expr-typed comptime fn folds to runtime Expr (num).
// Sibling files cover ident + sum cases; each split for shard-parallel.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{cached_fixture_run}

const MAIN_HEADER: string = "fn " + "main()"

fn write_temp(path: string, source: string) -> string {
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
}

// Write source, then run via the content-hashed fixture cache so
// repeated test runs with identical source skip the bs2 compile +
// link + execve round-trip entirely. Dominates the per-file shard
// timing when uncached (~1s) → ~0ms warm.
fn run_capture(source: string) -> string {
    let path = "/tmp/avra_expand_macro_expr_test.av"
    write_temp(path, source)
    cached_fixture_run(path)
}

spec "vez6.6.5: Expr-typed comptime fn folds to runtime Expr value (num)" {
    then "make_num() yields a runtime Expr that renders as `42`" {
        let out = run_capture(
            "use @std.avrac.core.{Expr, render_expr}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_num() -> Expr {\n" +
            "    return quote { 42 }\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    let e: Expr = make_num()\n" +
            "    println(render_expr(e))\n" +
            "}\n")
        out.contains("42")
    }
}
