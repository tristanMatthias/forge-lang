// vez6.6.5/sum — Expr-typed comptime fn folds to runtime Expr (sum).

use @std.avrac.test_runner.{write_fixture_and_run}

const MAIN_HEADER: string = "fn " + "main()"


spec "vez6.6.5: Expr-typed comptime fn folds to runtime Expr value (sum)" {
    // Post-F3b the folded Binary's operands are ExprId rows that live in the
    // fold's construction store, so rendering it against an unrelated fresh
    // store can't resolve them (tracked as yfb6). Verify the structural fold
    // instead — a Binary carrying the `+` operator — which reads only the
    // scalar op and needs no cross-store id resolution.
    then "make_sum() folds to a runtime Expr.Binary with the `+` operator" {
        let out = write_fixture_and_run("/tmp/avra_expand_macro_expr_sum_test.av",
            "use @std.avrac.core.{Expr, BinOp, binop_str}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_sum() -> Expr {\n" +
            "    return quote { 1 + 2 }\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    let e: Expr = make_sum()\n" +
            "    match e {\n" +
            "        .Binary(_, op, _) -> println(\"op=\" + binop_str(op))\n" +
            "        _ -> println(\"not-binary\")\n" +
            "    }\n" +
            "}\n")
        out.contains("op=+")
    }
}
