// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 4 test 4:
// "macro returns code containing another @expand site. The inner
// expansion fires."
//
// A first macro `outer` returns a `fn` annotated with `@expand(inner)`.
// expand_macros_fixpoint must catch the new @expand on a later
// iteration and run `inner`, which emits a fn that main can call.
// If the loop is missing or the Annotated encoder / decoder don't
// roundtrip, `inner_emitted_fn` never exists and main fails to link.

use @std.avrac.test_runner.{write_fixture_and_run}

fn run_capture(source: string) -> string {
    write_fixture_and_run("/tmp/avra_expand_nested_test.av", source)
}

spec "@expand nested: outer macro emits code carrying @expand(inner)" {
    then "inner macro fires on second fixpoint iteration" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn inner() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        fn nested_emitted() -> int { 7 }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@comptime\n" +
            "fn outer() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        @expand(inner)\n" +
            "        fn carrier() {}\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(outer)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {\n" +
            "    println(string(nested_emitted()))\n" +
            "}\n")
        out.contains("7")
    }
}
