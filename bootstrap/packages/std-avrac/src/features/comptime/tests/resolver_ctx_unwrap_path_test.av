// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 5 test 14.
// `ctx_unwrap_path_to` returns a field-access chain from a
// ResolvedType to a target type. The initial slice returns []
// (stub) — full ResolverState introspection + BFS is a follow-up.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{cached_fixture_run}

fn write_temp(path: string, source: string) -> string {
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
}

fn run_capture(source: string) -> string {
    let path = "/tmp/avra_resolver_ctx_unwrap_path_test.av"
    write_temp(path, source)
    cached_fixture_run(path)
}

spec "ResolverCtx: ctx_unwrap_path_to call path works" {
    then "macro calling ctx_unwrap_path_to returns successfully" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "use @std.avrac.features.comptime.{AnnotatedDecl, ResolverCtx, ctx_lookup_type, ctx_unwrap_path_to, ResolvedType}\n" +
            "\n" +
            "type Wrap = { node: int }\n" +
            "\n" +
            "@comptime\n" +
            "fn build(d: AnnotatedDecl, ctx: ResolverCtx) -> Stmt {\n" +
            "    let t_opt = ctx_lookup_type(ctx, \"Wrap\")\n" +
            "    quote stmt { println(\"ok\") }\n" +
            "}\n" +
            "\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("ok")
    }
}
