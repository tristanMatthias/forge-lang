// Phase 2 of Components V2 (vez6.2 slice C): exercise the program-
// walker that finds every comptime call and replaces it with the
// folded literal. Builds small ASTs by hand, runs rewrite_program,
// asserts the output AST matches the expected post-fold shape.

use @std.avrac.core.{Stmt, StmtList, Expr, ExprList, SExpr, sexpr_dummy, sstmt_dummy, ParamList, ValueType, TypeParamEntry, BinOp, Annotation}
use @std.avrac.features.comptime.{CompTimeFn, CompTimeRegistry, rewrite_program, collect_comptime_fns, comptime_registry_new}

// `@comptime fn add(x: int, y: int) -> int { return x + y }` as AST.
fn mk_add_decl() -> Stmt {
    let body = StmtList.Node(
        sstmt_dummy(Stmt.Return(Expr.Binary(Expr.Ident("x"), BinOp.Add, Expr.Ident("y")))),
        StmtList.End)
    let empty_tp: List<TypeParamEntry> = []
    let fn_decl = Stmt.Function(
        "add",
        empty_tp,
        ParamList.Node("x", ValueType.Int, ParamList.Node("y", ValueType.Int, ParamList.End)),
        ValueType.Int,
        body)
    let annot_args: List<SExpr> = []
    let annots: List<Annotation> = [Annotation { name: "comptime", args: annot_args }]
    Stmt.Annotated(annots, fn_decl)
}

// Helpers to build call exprs.
fn mk_call(name: string, args: ExprList) -> Expr {
    Expr.Call(Expr.Ident(name), args)
}
fn args2(a: Expr, b: Expr) -> ExprList {
    ExprList.Node(sexpr_dummy(a),
      ExprList.Node(sexpr_dummy(b), ExprList.End))
}

// Extract the initializer from a `let x = ...` statement, or null.
fn let_init_of(stmt: Stmt) -> Expr? {
    match stmt {
        .Let(_, _, init) -> init
        _ -> null
    }
}

// Get the first stmt in a list (skip past the @comptime fn decl).
fn nth_stmt(stmts: StmtList, n: int) -> Stmt {
    match stmts {
        .End -> Stmt.NoOp
        .Node(ss, next) -> if n == 0 { ss.node } else { nth_stmt(next, n - 1) }
    }
}

// Helper: get the Number text from an Expr literal, or "" otherwise.
fn number_text_of(e: Expr) -> string {
    match e {
        .Number(text) -> text
        _ -> ""
    }
}

// Build a program: [@comptime fn add(...) {...}, let z = add(2, 3)]
fn program_with_call() -> StmtList {
    let call_args = args2(Expr.Number("2"), Expr.Number("3"))
    let let_stmt = Stmt.Let("z", ValueType.Unknown, mk_call("add", call_args))
    StmtList.Node(sstmt_dummy(mk_add_decl()),
      StmtList.Node(sstmt_dummy(let_stmt), StmtList.End))
}

spec "comptime.rewrite_program: folds top-level call" {
    then "let z = add(2, 3) becomes let z = 5 after rewrite" {
        let prog = program_with_call()
        let reg = collect_comptime_fns(prog)
        let rewritten = rewrite_program(prog, reg)
        // Position 1 is the let stmt (position 0 is the @comptime fn).
        let init = let_init_of(nth_stmt(rewritten, 1))
        init != null && number_text_of(init!) == "5"
    }
    then "non-call expressions are unchanged" {
        let prog = StmtList.Node(
            sstmt_dummy(Stmt.Let("x", ValueType.Unknown, Expr.Number("42"))),
            StmtList.End)
        let reg = collect_comptime_fns(prog)
        let rewritten = rewrite_program(prog, reg)
        let init = let_init_of(nth_stmt(rewritten, 0))
        init != null && number_text_of(init!) == "42"
    }
    then "calls to non-comptime fns are unchanged" {
        // No @comptime fns registered → empty registry → nothing should fold.
        let call_args = args2(Expr.Number("2"), Expr.Number("3"))
        let let_stmt = Stmt.Let("z", ValueType.Unknown, mk_call("plain_fn", call_args))
        let prog = StmtList.Node(sstmt_dummy(let_stmt), StmtList.End)
        let reg = comptime_registry_new()
        let rewritten = rewrite_program(prog, reg)
        let init = let_init_of(nth_stmt(rewritten, 0))
        // Should still be a Call, not a Number.
        match init! {
            .Call(_, _) -> true
            _ -> false
        }
    }
}

spec "comptime.rewrite_program: bottom-up folds nested calls" {
    then "add(add(1, 2), 3) folds all the way to 6" {
        let inner = mk_call("add", args2(Expr.Number("1"), Expr.Number("2")))
        let outer = mk_call("add", args2(inner, Expr.Number("3")))
        let let_stmt = Stmt.Let("z", ValueType.Unknown, outer)
        let prog = StmtList.Node(sstmt_dummy(mk_add_decl()),
          StmtList.Node(sstmt_dummy(let_stmt), StmtList.End))
        let reg = collect_comptime_fns(prog)
        let rewritten = rewrite_program(prog, reg)
        let init = let_init_of(nth_stmt(rewritten, 1))
        init != null && number_text_of(init!) == "6"
    }
}

spec "comptime.rewrite_program: descends into fn bodies" {
    then "comptime call inside another fn body folds" {
        // fn outer() -> int { return add(2, 3) }
        let outer_body = StmtList.Node(
            sstmt_dummy(Stmt.Return(mk_call("add", args2(Expr.Number("2"), Expr.Number("3"))))),
            StmtList.End)
        let empty_tp2: List<TypeParamEntry> = []
        let outer_fn = Stmt.Function("outer", empty_tp2, ParamList.End, ValueType.Int, outer_body)
        let prog = StmtList.Node(sstmt_dummy(mk_add_decl()),
          StmtList.Node(sstmt_dummy(outer_fn), StmtList.End))
        let reg = collect_comptime_fns(prog)
        let rewritten = rewrite_program(prog, reg)
        // After rewrite: outer's body should be `return 5`.
        let outer_after = nth_stmt(rewritten, 1)
        match outer_after {
            .Function(_, _, _, _, body) -> {
                match body {
                    .Node(ss, _) -> match ss.node {
                        .Return(e) -> number_text_of(e) == "5"
                        _ -> false
                    }
                    _ -> false
                }
            }
            _ -> false
        }
    }
}
