// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 5 test 12.
// `ctx_qualify_ident` returns the QualifiedIdent path or null.
// The initial slice returns null (stub) — full ResolverState
// introspection is a follow-up.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{cached_fixture_run}

fn write_temp(path: string, source: string) -> string {
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
}

fn run_capture(source: string) -> string {
    let path = "/tmp/avra_resolver_ctx_qualify_ident_test.av"
    write_temp(path, source)
    cached_fixture_run(path)
}

spec "ResolverCtx: ctx_qualify_ident call path works" {
    then "macro calling ctx_qualify_ident returns successfully" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "use @std.avrac.features.comptime.{AnnotatedDecl, ResolverCtx, ctx_qualify_ident}\n" +
            "\n" +
            "@comptime\n" +
            "fn build(d: AnnotatedDecl, ctx: ResolverCtx) -> Stmt {\n" +
            "    let r = ctx_qualify_ident(ctx, \"exit\")\n" +
            "    quote stmt { println(\"ok\") }\n" +
            "}\n" +
            "\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("ok")
    }
}
