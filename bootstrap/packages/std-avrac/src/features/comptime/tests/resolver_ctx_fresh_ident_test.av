// docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md — Step 5 test 13.
// `ctx_fresh_ident` returns a monotonically-unique identifier per
// call. Backed by a runtime counter so two calls always differ;
// uniqueness scope is the whole compile.
//
// This test pins the call-path: a 2-arg macro can call
// ctx_fresh_ident and return a Stmt without error.

use @std.avrac.test_runner.{write_fixture_and_run}

fn run_capture(source: string) -> string {
    write_fixture_and_run("/tmp/avra_resolver_ctx_fresh_ident_test.av", source)
}

spec "ResolverCtx: ctx_fresh_ident call path works" {
    then "macro calling ctx_fresh_ident returns successfully" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "use @std.avrac.features.comptime.{AnnotatedDecl, ResolverCtx, ctx_fresh_ident}\n" +
            "\n" +
            "@comptime\n" +
            "fn build(d: AnnotatedDecl, ctx: ResolverCtx) -> Stmt {\n" +
            "    let n = ctx_fresh_ident(ctx, \"x\")\n" +
            "    quote stmt { println(\"ok\") }\n" +
            "}\n" +
            "\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("ok")
    }
}
