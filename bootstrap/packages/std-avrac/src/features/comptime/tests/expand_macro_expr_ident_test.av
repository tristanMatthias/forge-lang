use @std.avrac.core.{NodeStore, new_node_store, build_line_index}
// vez6.6.5/ident — Expr-typed comptime fn folds to runtime Expr (ident).

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture_and_run}

/// Fresh empty store for inline-AST probes — F2 renderers resolve
/// flipped pattern ids through it (never read for id-free nodes).
fn ts() -> NodeStore {
    new_node_store(build_line_index(""))
}


const MAIN_HEADER: string = "fn " + "main()"


spec "vez6.6.5: Expr-typed comptime fn folds to runtime Expr value (ident)" {
    then "make_ident() yields a runtime Expr that renders as `my_var`" {
        let out = write_fixture_and_run("/tmp/avra_expand_macro_expr_ident_test.av", 
            "use @std.avrac.core.{Expr, render_expr, new_node_store, build_line_index}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_ident() -> Expr {\n" +
            "    return quote { my_var }\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    let e: Expr = make_ident()\n" +
            "    println(render_expr(new_node_store(build_line_index(\"\")), e))\n" +
            "}\n")
        out.contains("my_var")
    }
}
