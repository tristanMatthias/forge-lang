// forge-crafting-intepreters-qa6i: @expand pipeline-order fix.
// Pre-fix: a macro emitting a top-level `fn _gen()` failed compile
// with "undefined variable _gen" because resolve_names ran BEFORE
// the @expand pass, freezing the name table before the macro
// spliced its decl in.
//
// Fix (Option C, per docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md):
// resolve_names is split into pre-expand (register + rewrite) and
// post-expand (scope validation + unused imports) halves. The
// `resolve_and_expand_program` driver in features/comptime/expand_macro.av
// interleaves expand_macros_eval_with_state between them, additively
// registers macro-introduced decls via register_macro_decls, and runs
// partial re-resolve via rewrite_uses_macro_only. Macro-emitted
// top-level decls land in the name table before scope validation runs.

use @std.avrac.test_runner.{write_fixture_and_run}

fn run_capture(source: string) -> string {
    write_fixture_and_run("/tmp/avra_expand_decl_introducing_test.av", source)
}

spec "qa6i: @expand macro can introduce a top-level fn callable from main" {
    then "macro-emitted _gen() is callable from main" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn build_simple_fn() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        fn _gen() {\n" +
            "            println(\"from macro\")\n" +
            "        }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(build_simple_fn)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {\n" +
            "    _gen()\n" +
            "    println(\"ok\")\n" +
            "}\n")
        out.contains("from macro") && out.contains("ok")
    }
}
