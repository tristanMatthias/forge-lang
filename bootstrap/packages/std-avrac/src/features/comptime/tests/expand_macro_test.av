// vez6.6 — `@expand(macro_fn)` end-to-end via bs2 compile+run.
// Confirms the expand pass evaluates a `@comptime fn -> Stmt`
// at compile time and splices the result over the placeholder
// declaration.

extern fn avra_shell_exec(cmd: string) -> string

const MAIN_HEADER: string = "fn " + "main()"

fn write_temp(path: string, source: string) -> string {
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
}

fn run_capture(source: string) -> string {
    let path = "/tmp/avra_expand_macro_test.av"
    write_temp(path, source)
    avra_shell_exec("bash scripts/diagnose.sh --run '${path}' 2>&1 || true")
}

fn compile_capture(source: string) -> string {
    // Use the bs2 compile pass directly so we can inspect the
    // expand-pass diagnostics that diagnose.sh's run path swallows
    // (compile-success keeps the original decl + skips its stderr).
    let path = "/tmp/avra_expand_macro_test.av"
    write_temp(path, source)
    avra_shell_exec("./build/bs2 compile '${path}' 2>&1 || true")
}

spec "vez6.6: @expand macro replaces decl with macro output" {
    then "macro returning quote stmt prints at runtime" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_println() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        println(\"hello from macro\")\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(make_println)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        out.contains("hello from macro")
    }
    then "missing macro fn: clear diagnostic" {
        let out = compile_capture(
            "@expand(no_such_macro)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    placeholder()\n" +
            "}\n")
        // The eprintln in try_expand_one names the missing macro so
        // the user can fix the typo.
        out.contains("no_such_macro") && out.contains("no @comptime fn named")
    }
    then "macro returning a different println body" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn say_seven() -> Stmt {\n" +
            "    return quote stmt { println(\"seven\") }\n" +
            "}\n" +
            "\n" +
            "@expand(say_seven)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        out.contains("seven")
    }
}

// vez6.6.5 — Expr-typed comptime returns now fold cleanly. The
// decoder produces the source-form EnumCtor that codegen turns into
// a runtime Expr value at the call site, where it can be rendered,
// pattern-matched, etc. Earlier the decoder produced post-resolve
// raw AST nodes (Expr.Ident("x") meant "look up x") and crashed.
spec "vez6.6.5: Expr-typed comptime fn folds to runtime Expr value" {
    then "make_num() yields a runtime Expr that renders as `42`" {
        let out = run_capture(
            "use @std.avrac.core.{Expr, render_expr}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_num() -> Expr {\n" +
            "    return quote { 42 }\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    let e: Expr = make_num()\n" +
            "    println(render_expr(e))\n" +
            "}\n")
        out.contains("42")
    }
    then "make_ident() yields a runtime Expr that renders as `my_var`" {
        let out = run_capture(
            "use @std.avrac.core.{Expr, render_expr}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_ident() -> Expr {\n" +
            "    return quote { my_var }\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    let e: Expr = make_ident()\n" +
            "    println(render_expr(e))\n" +
            "}\n")
        out.contains("my_var")
    }
    then "make_sum() yields a runtime Expr.Binary that renders as `(+ 1 2)`" {
        let out = run_capture(
            "use @std.avrac.core.{Expr, render_expr}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_sum() -> Expr {\n" +
            "    return quote { 1 + 2 }\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "    let e: Expr = make_sum()\n" +
            "    println(render_expr(e))\n" +
            "}\n")
        out.contains("(+ 1 2)")
    }
}

// vez6.8.4.B — value_to_stmt now decodes Stmt.Impl. A macro that
// returns `quote stmt { impl Foo { ... } }` should land an actual
// impl block in the post-expand AST. The body method bodies fall
// back to NoOp until Function/TypeDecl/etc. are added to the
// decoder (subsequent slices of vez6.8.4) — but the Impl wrapper
// itself decodes through, which is what this slice asserts.
fn run_expand_e2e(source: string) -> string {
    let path = "/tmp/avra_expand_impl_test.av"
    write_temp(path, source)
    avra_shell_exec("./build/bs2 expand '${path}' 2>&1 || true")
}

spec "vez6.8.4.B: value_to_stmt decodes Stmt.Impl from macro output" {
    then "macro emitting `impl Foo { ... }` produces impl wrapper in expanded output" {
        let out = run_expand_e2e(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "type Foo = { x: int }\n" +
            "\n" +
            "@comptime\n" +
            "fn make_impl() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        impl Foo {\n" +
            "            fn bar(self) -> int { return 42 }\n" +
            "        }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(make_impl)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        // The expanded output must contain the fmt'd impl wrapper —
        // proof that value_to_stmt decoded Stmt.Impl rather than
        // returning null and leaving the @expand annotation in place.
        out.contains("impl Foo")
            && !out.contains("@expand(make_impl)")
            && !out.contains("fn placeholder")
    }
}

// vez6.8.5: @expand on a ComponentDef registers the macro for
// every ComponentBlock instance of that component. The def
// itself drops out of the post-expand AST. Verifies the
// pre-pass + dispatch wiring: collect_component_macros finds
// the def, expand_stmt_list invokes try_expand_with_macro on
// each instance.
spec "vez6.8.5: ComponentDef-level @expand fires on each ComponentBlock instance" {
    then "instance is rewritten by macro; def drops out" {
        let out = run_expand_e2e(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn expand_cmd(s: Stmt) -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        type Command_build = { x: int }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(expand_cmd)\n" +
            "component command {\n" +
            "}\n" +
            "\n" +
            "command build {\n" +
            "}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        // Confirms: (1) the macro fired for `command build {...}`,
        // (2) the ComponentDef itself produced no template-style
        // emission, and (3) only ONE type Command_build appears
        // (no double-fire from def AND instance).
        out.contains("type Command_build")
            && !out.contains("component command")
            && !out.contains("type Command =")
    }
}

// vez6.8.4.A/C: 1-arg @expand macros receive the wrapped Stmt as
// a Value (boxed via stmt_to_value). Confirms try_expand_one
// inspects param arity, boxes the unwrapped Stmt for the macro,
// and threads its return back through value_to_stmt.
spec "vez6.8.4.A/C: 1-arg @expand macro receives the wrapped Stmt" {
    then "macro fn(s: Stmt) -> Stmt is invoked and its return decodes" {
        let out = run_expand_e2e(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "type Foo = { x: int }\n" +
            "\n" +
            "@comptime\n" +
            "fn passthrough(s: Stmt) -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        impl Foo {\n" +
            "            fn run(self) -> int { return 7 }\n" +
            "        }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(passthrough)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        // The 1-arg dispatch must have invoked the macro (since the
        // returned Stmt is what we see). Without arg-passing, the
        // macro fn would error 'wrong arity' and we'd see the
        // original placeholder fn or no impl at all.
        out.contains("impl Foo")
            && out.contains("fn Foo__run")
            && out.contains("return 7")
            && !out.contains("fn placeholder")
    }
}

// vez6.8.4.B slice 3: TypeDecl + ComponentBlock decoders. A macro
// emitting `quote stmt { type Foo_inst = { ... } }` now lands a
// real type declaration, and `quote stmt { command instance { ... } }`
// lands a real ComponentBlock so the components-V2 expand pass can
// continue processing it.
spec "vez6.8.4.B slice 3: Stmt.TypeDecl decodes from macro output" {
    then "macro emitting `type Foo_inst = { ... }` lands the type" {
        let out = run_expand_e2e(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "@comptime\n" +
            "fn make_type() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        type Foo_inst = { name: string, count: int }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(make_type)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        out.contains("type Foo_inst")
            && out.contains("name")
            && out.contains("count")
            && !out.contains("fn placeholder")
    }
}

// vez6.8.4.B slice 2: Function decode lands the inner method body.
// Prior to this slice, fn bodies inside `quote stmt { impl X { fn ... } }`
// fell through to NoOp because Function wasn't in the value_to_stmt
// matcher and lower.av's stmt_passthrough emitted NoOp for Function.
spec "vez6.8.4.B slice 2: Stmt.Function decodes inside macro-emitted impl" {
    then "fn body lands intact in expanded output" {
        let out = run_expand_e2e(
            "use @std.avrac.core.{Stmt}\n" +
            "\n" +
            "type Foo = { x: int }\n" +
            "\n" +
            "@comptime\n" +
            "fn make_impl() -> Stmt {\n" +
            "    return quote stmt {\n" +
            "        impl Foo {\n" +
            "            fn bar(self) -> int { return 42 }\n" +
            "        }\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "@expand(make_impl)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            MAIN_HEADER + " {\n" +
            "}\n")
        // The fmt'd Function variant inside the impl block must
        // surface the fn name + return body — proves Function +
        // ParamList + TypeParamList decoders all roundtrip.
        out.contains("fn Foo__bar")
            && out.contains("return 42")
    }
}
