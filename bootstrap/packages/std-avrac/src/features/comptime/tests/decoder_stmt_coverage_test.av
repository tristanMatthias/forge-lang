// y9y4.12: verify @comptime decoders for the Stmt variants that
// were silently undecoded — For / ForIn / If / While / NoOp /
// Break / Continue / Defer / Errdefer / Parallel / TraitDecl. The
// encoder side (lower.av construct_stmt) has written these since
// vez6.3; the decoder side was missing them, so any @expand macro
// emitting these failed F4006 'macro returned a value the expander
// could not decode' — silently, with no per-variant trace.
//
// This test makes the roundtrip a hard requirement: a macro that
// emits a ForIn-containing fn must compile + run. Spot-checking
// ForIn alone exercises the recursive pipeline:
//   Function → body ids → ForIn → Block → body ids →
//   Expr → Call. Every link from the missing-decoder list except
//   Defer/Errdefer/Parallel/TraitDecl rides through this chain.
// F3a: the macro builds flipped payloads through the synth_* id
// shims (typed node→id, identity at eval), the same surface every
// hand-written macro uses.

use @std.avrac.test_runner.{write_fixture_and_run_no_metadata}

spec "@comptime decoder: Stmt.ForIn roundtrips through the macro pipeline" {
    then "macro emitting `for x in [a,b,c] { println(x) }` compiles + runs" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_decoder_stmt_coverage_test.av", 
            "use @std.avrac.core.{Stmt, SStmt, ParamEntry, TypeParamEntry, ValueType, Expr, ExprId, SExpr, sexpr_dummy, sstmt_dummy}\n" +
            "use @std.avrac.features.comptime.{synth_expr_id, synth_stmt_id, synth_stmt_ids}\n" +
            "\n" +
            "@comptime\n" +
            "fn emit_iter() -> Stmt {\n" +
            "    let print_args: List<ExprId> = [synth_expr_id(Expr.Ident(\"x\"))]\n" +
            "    let body_stmts: List<SStmt> = [sstmt_dummy(Stmt.Expr(synth_expr_id(Expr.Call(synth_expr_id(Expr.Ident(\"println\")), print_args))))]\n" +
            "    let loop_body = Stmt.Block(synth_stmt_ids(body_stmts))\n" +
            "    let list_elems: List<ExprId> = [\n" +
            "        synth_expr_id(Expr.String(\"\\\"alpha\\\"\")),\n" +
            "        synth_expr_id(Expr.String(\"\\\"beta\\\"\")),\n" +
            "        synth_expr_id(Expr.String(\"\\\"gamma\\\"\"))\n" +
            "    ]\n" +
            "    let list_lit = Expr.ListLit(list_elems)\n" +
            "    let for_stmt = Stmt.ForIn(\"x\", synth_expr_id(list_lit), synth_stmt_id(loop_body))\n" +
            "    let empty_params: List<ParamEntry> = []\n" +
            "    let empty_tp: List<TypeParamEntry> = []\n" +
            "    let body: List<SStmt> = [sstmt_dummy(for_stmt)]\n" +
            "    Stmt.Function(\"_emit_iter\", empty_tp, empty_params, ValueType.Void, synth_stmt_ids(body))\n" +
            "}\n" +
            "\n" +
            "@expand(emit_iter)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {\n" +
            "    _emit_iter()\n" +
            "}\n")
        out.contains("alpha") && out.contains("beta") && out.contains("gamma")
    }
}
