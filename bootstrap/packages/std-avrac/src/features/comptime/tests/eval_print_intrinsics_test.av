// so07.7.8 — @comptime evaluator handles `eprintln` alongside the
// pre-existing `println`. Pre-fix: only println + string supported,
// `eprintln(...)` from a @comptime fn hit F4005 "undefined variable".
//
// `print` / `eprint` (no-newline) are deliberately NOT added — the
// codegen layer has no emit_print / emit_eprint so adding them to
// eval would ICE when bs2 self-compiles a source that uses them.
// Scope: eval surface tracks codegen surface.

use @std.avrac.test_runner.{write_fixture_and_run_no_metadata}


// The fixture runs `eprintln` at RUNTIME (not @comptime) because
// @comptime eval is harder to provoke from a synthetic fixture. The
// eprintln intrinsic is exercised when bs2 ITSELF compiles a source
// that contains `eprintln(...)` calls; the comptime evaluator dispatch
// table now accepts the name and routes through call_builtin.
//
// Regression guard: a runtime fixture using eprintln still routes
// correctly (different codepath, but both share the value_builtin
// recognition at line 814 of features/eval/mod.av).

spec "so07.7.8: eprintln is callable from user code at runtime" {
    then "runtime eprintln writes to stderr — appears in combined stream" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_eval_print_intrinsics_test.av", 
            "fn main() {\n" +
            "    eprintln(\"trace-marker-xyz\")\n" +
            "    println(\"after-trace\")\n" +
            "}\n")
        out.contains("trace-marker-xyz") && out.contains("after-trace")
    }
}
