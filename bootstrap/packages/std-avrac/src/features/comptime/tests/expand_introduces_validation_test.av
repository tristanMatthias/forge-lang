// forge-crafting-intepreters-opo3.2: ResolvedDecls.introduces is
// validated against ResolvedDecls.decls. When a macro returns a
// DeclSymbol whose name doesn't correspond to any decl in .decls,
// the compiler emits a warning via stderr.
//
// The doc step 4.4: "Register result.introduces with the existing
// registry." My impl registers via the from_macro=true tag on
// spliced stmts. Introduces entries without backing decls have no
// AST to register; emitting a warning surfaces the mismatch
// without breaking codegen.
//
// The test exercises BOTH paths:
//   (a) introducer's introduces matches its decls → no warning, fn
//       is callable (the happy path covered by
//       expand_introduces_registration_test).
//   (b) introducer lists a phantom name in introduces that isn't in
//       decls → captured stdout contains the warning, fn is still
//       callable because the warning is non-fatal.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_process_env_get(name: string) -> string
extern fn avra_host_os() -> string

/// Translate AVRA_LIB_OBJS (colon-separated .o paths) into a
/// space-separated string for the cc command. When AVRA_USE_METADATA
/// is set, the compiler emits EXTERN references to std-avrac fns
/// instead of inlining the bodies — those externs need their
/// producing .o files at link time, which the orchestrator stashes
/// in AVRA_LIB_OBJS. Without this the link silently fails on
/// undefined symbols and the test's `run` step finds no binary.
fn lib_objs_cc_args() -> string {
    let raw = avra_process_env_get("AVRA_LIB_OBJS")
    if raw == "" { return "" }
    mut out = ""
    for p in raw.split(":") {
        if p != "" { out = out + p + " " }
    }
    out
}

fn run_capture(source: string) -> string {
    let path = "/tmp/avra_expand_introduces_validation_test.av"
    let escaped = source.replace("'", "'\\''")
    avra_shell_exec("cat > '${path}' <<'EOF'\n${escaped}\nEOF")
    // Direct bs2 compile + link + run with stderr captured at every
    // stage. cached_fixture_run discards bs2 stderr on success, which
    // hides our warning. Run the steps manually here.
    //
    let compile = avra_shell_exec("./build/bs2 compile '${path}' 2>&1 || true")
    let extra_objs = lib_objs_cc_args()
    // Platform-portable link: llc the .ll to a PIC object (gcc can't
    // ingest .ll the way macOS clang can), then link with LLD +
    // libstdc++ on Linux / default ld + libc++ on macOS.
    let llvm_prefix = avra_process_env_get("LLVM_PREFIX")
    let llvm_pfx = if llvm_prefix == "" { "/opt/homebrew/opt/llvm" } else { llvm_prefix }
    let is_mac = avra_host_os() == "macos"
    let cxxlib = if is_mac { "-lc++" } else { "-lstdc++" }
    let ld_sel = if is_mac { "" } else { "-fuse-ld=lld" }
    avra_shell_exec("${llvm_pfx}/bin/llc -relocation-model=pic -filetype=obj '${path}.ll' -o '${path}.o' 2>&1 || true")
    let link = avra_shell_exec("cc '${path}.o' build/runtime.o build/llvm_wrapper.o ${extra_objs}${ld_sel} -L${llvm_pfx}/lib -lLLVM ${cxxlib} -o '${path}.bin' 2>&1 || true")
    let run = avra_shell_exec("'${path}.bin' 2>&1 || true")
    compile + "\n" + run
}

spec "@expand: introduces-vs-decls divergence emits a warning" {
    then "phantom name in introduces surfaces a stderr warning, real decl still works" {
        let out = run_capture(
            "use @std.avrac.core.{Stmt, SStmt, sstmt_dummy, ParamEntry, TypeParamEntry, ValueType, Expr, SExpr, sexpr_dummy}\n" +
            "use @std.avrac.diagnostics.{Span}\n" +
            "use @std.avrac.features.comptime.{AnnotatedDecl, ResolverCtx, ResolvedDecls, DeclSymbol, DeclKind, MacroProvenance}\n" +
            "\n" +
            "@comptime\n" +
            "fn introducer(d: AnnotatedDecl, ctx: ResolverCtx) -> ResolvedDecls {\n" +
            "    let empty_params: List<ParamEntry> = []\n" +
            "    let empty_tp: List<TypeParamEntry> = []\n" +
            "    let body: List<SStmt> = [sstmt_dummy(Stmt.Return(Expr.Number(\"7\")))]\n" +
            "    let real_fn = Stmt.Function(\"_real_emitted\", empty_tp, empty_params, ValueType.Int, body)\n" +
            "    let decls: List<SStmt> = [sstmt_dummy(real_fn)]\n" +
            "    // introduces lists BOTH the real decl AND a phantom name.\n" +
            "    let introduces: List<DeclSymbol> = [\n" +
            "        DeclSymbol { name: \"_real_emitted\", kind: DeclKind.Function, canonical_path: \"_real_emitted\" },\n" +
            "        DeclSymbol { name: \"_phantom_never_decl\", kind: DeclKind.Function, canonical_path: \"_phantom_never_decl\" }\n" +
            "    ]\n" +
            "    let provenance = MacroProvenance {\n" +
            "        macro_name: \"introducer\",\n" +
            "        target_canonical: \"placeholder\",\n" +
            "        target_source_span: Span { start: 0, end: 0, line: 0, col: 0, file: \"\" }\n" +
            "    }\n" +
            "    ResolvedDecls { decls, introduces, provenance }\n" +
            "}\n" +
            "\n" +
            "@expand(introducer)\n" +
            "fn placeholder() {}\n" +
            "\n" +
            "fn main() {\n" +
            "    println(string(_real_emitted()))\n" +
            "}\n")
        // Two assertions:
        //   (1) the warning was emitted for the phantom name
        //   (2) the real decl still works (main prints 7)
        out.contains("_phantom_never_decl") && out.contains("7")
    }
}
