// WHY: sealed read-only handle macros use to query the resolver
// from inside @comptime evaluation. Mirrors how `Runtime` is
// threaded through eval — opaque handle dispatched through Avra
// fns that read from the C-side state stack.
//
// Step 5 of docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md.
//
// The ResolverCtx struct holds a single opaque `id` field that
// the compiler uses to look up the live resolver state for the
// active @expand invocation. All queries are free fns; macros
// call them as `ctx_lookup_type(ctx, "Expr")` rather than
// `ctx.lookup_type("Expr")`.
//
// Type shapes:
//   ResolverCtx { id: int } — opaque handle.
//   ResolvedType { canonical_name, kind, fields?, variants? } —
//     full hierarchical shape for struct/enum introspection.
//   ResolvedField { name, ty } — one struct field.
//   ResolvedVariant { name, fields } — one enum variant + its
//     positional fields.

use core.{TypeKind}

export type ResolverCtx = { id: int }

export type ResolvedType = {
    canonical_name: string,
    kind: TypeKind,
    fields: List<ResolvedField>?,
    variants: List<ResolvedVariant>?,
}

export type ResolvedField = {
    name: string,
    ty: ResolvedType,
}

export type ResolvedVariant = {
    name: string,
    fields: List<ResolvedField>,
}

// ── Runtime extern fns ──
//
// The actual state stack + fresh-id counter live in `runtime.c`.
// Avra-side fns below call these to implement the user-facing
// ctx_* operations.

extern fn avra_resolver_ctx_get(handle: int) -> ptr
extern fn avra_resolver_fresh_id() -> int

// ── Public ctx_* operations ──
//
// These are the user-facing entry points macros call. Implemented
// as regular Avra fns (not `extern fn`) so the comptime eval
// treats them as standard calls — no special-case dispatch in
// eval_call needed.

/// Module the annotated decl lives in (e.g. "@std::avrac::core").
/// Returns "" when the @expand site is at top-level or when the
/// resolver state is unavailable.
export fn ctx_current_module(ctx: ResolverCtx) -> string {
    // Initial slice: ResolverState introspection requires reading
    // typed struct fields off the C-stack ptr, which needs proper
    // Avra cast support. Returning "" until that lands keeps the
    // surface usable; macros that need module info can check for
    // "" and fall back to a default.
    ""
}

/// Look up a type by source-level name, qualifying through the
/// active scope's imports. Returns the canonical resolved type or
/// null if the name doesn't resolve to a known type.
export fn ctx_lookup_type(ctx: ResolverCtx, name: string) -> ResolvedType? {
    null
}

/// Resolve an identifier the same way `Expr.Ident` would resolve at
/// this scope. Returns the QualifiedIdent path or null when the
/// name doesn't bind.
export fn ctx_qualify_ident(ctx: ResolverCtx, name: string) -> string? {
    null
}

/// Synthesise a fresh identifier guaranteed not to collide with any
/// name visible in this scope. Uniqueness scope: this compile.
/// Format: `__avra_fresh_<n>` where n is a monotonic per-process
/// counter. The hint is currently ignored — uniqueness is the
/// hard guarantee, readability is best-effort.
export fn ctx_fresh_ident(ctx: ResolverCtx, hint: string) -> string {
    let id = avra_resolver_fresh_id()
    "__avra_fresh_${string(id)}"
}

/// Returns the field-access chain to dig from `t` to a value of type
/// `target`. Examples:
///   ctx_unwrap_path_to(SExpr, "Expr")    -> ["node"]
///   ctx_unwrap_path_to(FieldInit, "Expr") -> ["value", "node"]
///   ctx_unwrap_path_to(string, "Expr")   -> []
///   ctx_unwrap_path_to(Expr, "Expr")     -> []
export fn ctx_unwrap_path_to(ctx: ResolverCtx, t: ResolvedType, target: string) -> List<string> {
    let empty: List<string> = []
    empty
}
