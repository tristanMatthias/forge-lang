// WHY: sealed read-only handle macros use to query the resolver
// from inside @comptime evaluation. Mirrors how `Runtime` is
// threaded through eval — opaque handle dispatched through Avra
// fns that read from the C-side state stack.
//
// Step 5 of docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md.
//
// The ResolverCtx struct holds a single opaque `id` field that
// the compiler uses to look up the live resolver state for the
// active @expand invocation. All queries are free fns; macros
// call them as `ctx_lookup_type(ctx, "Expr")` rather than
// `ctx.lookup_type("Expr")`.
//
// Type shapes:
//   ResolverCtx { id: int } — opaque handle.
//   ResolvedType { canonical_name, kind, fields?, variants? } —
//     full hierarchical shape for struct/enum introspection.
//   ResolvedField { name, ty } — one struct field.
//   ResolvedVariant { name, fields } — one enum variant + its
//     positional fields.

use core.{TypeKind}

export type ResolverCtx = { id: int }

export type ResolvedType = {
    canonical_name: string,
    kind: TypeKind,
    fields: List<ResolvedField>?,
    variants: List<ResolvedVariant>?,
}

export type ResolvedField = {
    name: string,
    ty: ResolvedType,
}

export type ResolvedVariant = {
    name: string,
    fields: List<ResolvedField>,
}

// ── Runtime extern fns ──
//
// The fresh-id counter lives in `runtime.c`. ctx_fresh_ident
// reads from it directly (the other ctx_* fns route through
// eval_resolver_ctx_call which reads from the avra_rd_* layer).

extern fn avra_resolver_fresh_id() -> int

// ── Public ctx_* operations ──
//
// These are the user-facing entry points macros call. Implemented
// as regular Avra fns (not `extern fn`) so the comptime eval
// treats them as standard calls — no special-case dispatch in
// eval_call needed.

// ── Public ctx_* surface ──
//
// All five ctx_* fns below have STUB bodies (null / "" / []). The
// real semantics come from eval intercept in features/eval/mod.av:
// `eval_resolver_ctx_call` recognises the call by name and routes
// it through the C-side resolver-data layer (avra_rd_*) populated
// by expand_macro.av before each macro invocation. The stub bodies
// here remain as a defensive fallback for any path that bypasses
// the intercept (e.g. a macro calling ctx_lookup_type from a
// non-comptime context, which the resolver would block anyway).
// ctx_fresh_ident's body has the real impl because it doesn't need
// resolver-data — just the monotonic C-side counter.

/// Module the annotated decl lives in (e.g. "@std::avrac::core").
/// Returns "" when the @expand site is at top-level.
export fn ctx_current_module(ctx: ResolverCtx) -> string {
    ""
}

/// Every top-level item whose SHORT name ends with `suffix`, returned as
/// canonical names — e.g. `ctx_items_with_suffix(ctx, "_lang")` finds every
/// feature's `<name>_lang()` regardless of which module declares it.
///
/// The sibling of ctx_modules_under, and needed for the same reason: a feature
/// directory can export SEVERAL `_lang` fns (defer/ exports defer_lang AND
/// errdefer_lang; let_stmt/ exports four), so knowing the module set is not
/// enough to know the function set.
///
/// Same purity story: these are items the resolver already registered, not a
/// filesystem read.
export fn ctx_items_with_suffix(ctx: ResolverCtx, suffix: string) -> List<string> {
    []
}

/// Every top-level fn whose RETURN TYPE is `type_name`, as canonical names —
/// e.g. `ctx_items_returning(ctx, "LanguageFeature")`.
///
/// The query the feature registry actually needs, and the reason the suffix
/// query is not enough for it. There are 71 `*_lang` fns under features/ and
/// only 70 features: the odd one out is `register_lang`, the registration
/// HELPER. No naming rule separates them — 49 of the 71 do not match their own
/// module's name, because one module routinely defines several features
/// (struct_decl declares 7, null_safety 5, modules 4). Selecting on the name
/// would mean special-casing `register_lang`, i.e. exactly the string-matching
/// heuristic the repo forbids, in the file whose purpose is to stop
/// hand-maintained lists.
///
/// The SIGNATURE separates them exactly: the 70 are `fn <name>() ->
/// LanguageFeature`; the helper takes a Registry and returns nothing. Measured
/// on the tree: 70 fns return LanguageFeature, all nil-ary, matching the
/// hand-written array precisely.
///
/// Stub body like its siblings — the real answer comes from the eval intercept
/// over the resolver-data layer; see the header note above.
export fn ctx_items_returning(ctx: ResolverCtx, type_name: string) -> List<string> {
    []
}

/// `ctx_items_returning` narrowed to items of a given PARAMETER COUNT.
///
/// Return type alone is not enough to identify a discoverable item. Measured on
/// the real package compile, `ctx_items_returning(ctx,
/// "@std::avrac::features::LanguageFeature")` answers **71**, not 70: the extra
/// is `LanguageFeature_new`, the constructor SYNTHESIZED for `export component
/// LanguageFeature`. It genuinely returns a LanguageFeature, so the query is not
/// wrong — but it takes parameters, and a consumer that emits nil-ary calls (the
/// feature registry does) would emit `LanguageFeature_new()` with no arguments.
///
/// This is the same near-miss that ruled out `ctx_items_with_suffix("_lang")`,
/// one layer down: that returned 71 where the odd one out was `register_lang`.
/// Every name-shaped discriminator so far admits exactly one wrong item, and
/// filtering on a `_new` suffix would be the string-matching heuristic the repo
/// forbids — the same one already rejected for `register_lang`.
///
/// ARITY separates them structurally: `arity = 0` selects exactly the 70.
///
/// NOTE the type name must be the CANONICAL one. On a resolved package compile
/// that is fully qualified (`@std::avrac::features::LanguageFeature`); a bare
/// `LanguageFeature` matches nothing and returns an EMPTY LIST with no error.
/// Assert non-empty at the call site — a silently empty result is how a derived
/// registry ends up inert while the build stays green.
///
/// Stub body like its siblings — the real answer comes from the eval intercept.
export fn ctx_items_returning_arity(ctx: ResolverCtx, type_name: string, arity: int) -> List<string> {
    []
}

/// Every module whose canonical name starts with `prefix`, e.g.
/// `ctx_modules_under(ctx, "@std::avrac::features")`. The answer comes from the
/// compiler's own module graph — the resolver already walked those directories —
/// so this is PURE with respect to the compilation and needs no filesystem access.
/// That distinction is the whole point: `avra_readdir` in a @comptime fn is
/// F4008 (and rightly so, since a fold is cached without the directory in its
/// key), but asking the compiler what it already resolved is neither impure nor
/// stale.
///
/// Returns [] outside a macro context (the stub below); the real answer arrives
/// through the eval intercept.
export fn ctx_modules_under(ctx: ResolverCtx, prefix: string) -> List<string> {
    []
}

/// Look up a type by source-level name, qualifying through the
/// active scope's imports. Returns the canonical resolved type or
/// null if the name doesn't resolve to a known type.
export fn ctx_lookup_type(ctx: ResolverCtx, name: string) -> ResolvedType? {
    null
}

/// Resolve an identifier the same way `Expr.Ident` would resolve at
/// this scope. Returns the QualifiedIdent path or null when the
/// name doesn't bind.
export fn ctx_qualify_ident(ctx: ResolverCtx, name: string) -> string? {
    null
}

/// Synthesise a fresh identifier guaranteed not to collide with any
/// name visible in this scope. Uniqueness scope: this compile.
/// Format: `__avra_fresh_<n>` where n is a monotonic per-process
/// counter. The hint is currently ignored — uniqueness is the
/// hard guarantee, readability is best-effort.
export fn ctx_fresh_ident(ctx: ResolverCtx, hint: string) -> string {
    let id = avra_resolver_fresh_id()
    "__avra_fresh_${string(id)}"
}

/// Returns the field-access chain to dig from `t` to a value of type
/// `target`. Examples:
///   ctx_unwrap_path_to(SExpr, "Expr")    -> ["node"]
///   ctx_unwrap_path_to(FieldInit, "Expr") -> ["value", "node"]
///   ctx_unwrap_path_to(string, "Expr")   -> []
///   ctx_unwrap_path_to(Expr, "Expr")     -> []
/// BFS over the field graph; depth-capped at 8 + visited-set
/// cycle protection so recursive types terminate.
export fn ctx_unwrap_path_to(ctx: ResolverCtx, t: ResolvedType, target: string) -> List<string> {
    let empty: List<string> = []
    empty
}
