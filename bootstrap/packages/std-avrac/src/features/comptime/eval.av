// WHY: compile-time evaluation of @comptime-annotated fns.
//
// `try_fold_call(reg, call_expr)` — given a registered comptime fn
// and a call expression with literal args, evaluates the fn body and
// returns the result as an Expr AST literal. Returns null when the call
// can't be folded (callee not registered, args not literals, body errors).
//
// A self-contained scalar-int fn is evaluated by the COMPILED-COMPTIME fast
// path (`try_jit_fold`, ps3t.5): codegen the fn and run it in-process via the
// JIT, byte-identical to the interpreter but without the tree-walk. Everything
// else — non-scalar shapes, calls, macros/AST-returning fns — falls back to the
// tree-walk evaluator (features/eval), so capability is unchanged.
//
// Phase 2 of Components V2 (vez6.2). The program-walker that calls
// this on every call site lives in rewrite.av.
//
// The Value→AST decoder that used to live here (value_to_stmt
// / enum_value_to_stmt / enum_value_to_expr / enum_value_to_value_type
// and their helpers) moved to the eval boundary in features/eval —
// eval_enum_ctor boxes Stmt/Expr/ValueType natively so consumers
// unwrap in O(1) instead of re-decoding. This file keeps only the
// fold path (Value → construct-expression source form) and the
// Stmt→Value encoder used to pass wrapped decls into 1-/2-arg macros.

use core.{Expr, ExprId, Stmt, StmtId, FieldInit, NodeStore, TypeParamEntry, ValueType, ParamEntry, BinOp, stmt_unwrap}
use features.eval.{Runtime, Value, eval_expr, eval_fn_with_resolved_args, literal_args_to_values, step_value, step_had_error, is_boxed_ast_kind, value_to_stmt, render_number, parse_num}
use features.comptime.{CompTimeFn, CompTimeRegistry, comptime_lookup_lazy}
use features.quote_expr.{construct_stmt}
use codegen.{compile_and_jit_call}

// Flat i64 argv buffer for the compiled-comptime JIT (declared in core/llvm.av;
// redeclared here so the fold path is self-contained, converged by exact type).
extern fn avra_i64_buf_new(n: int) -> ptr
extern fn avra_i64_buf_set(buf: ptr, i: int, v: int)
extern fn avra_i64_buf_free(buf: ptr)
// ps3t.5.5 result cache (a cstr-map on CompTimeRegistry.fold_cache).
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

// ── Public API ──

/// Try to fold a call expression at compile time. Returns the
/// folded literal Expr on success, null when the call can't be
/// reduced (callee unknown, args non-literal, body errored, etc).
///
/// Caller pattern:
///   match try_fold_call(reg, expr) {
///     null      -> emit the call as-is
///     folded    -> emit `folded`
///   }
export fn try_fold_call(reg: CompTimeRegistry, call: Expr) -> Expr? {
    // Early-exit gates, fastest-first:
    //   1. Not a Call(Ident(_), _) — common (most exprs are not calls)
    //   2. Callee not in the comptime registry — O(1) hashmap miss
    //   3. Args not all literals — handled by literal_args_to_values
    //      returning null. Single walk; serves both as gate AND as
    //      conversion to Value form for the direct-call eval path.
    // Only after all three pass do we run the tree-walk evaluator.
    match call {
        .Call(callee, args) -> {
            match reg.runtime.nodes.exprs.get(callee) {
                .Ident(name) -> {
                    let fn_def_opt = comptime_lookup_lazy(reg, name)
                    if fn_def_opt == none { return none }
                    let arg_values_opt = literal_args_to_values(reg.runtime.nodes, args)
                    if arg_values_opt == none { return none }
                    fold_call(reg, fn_def_opt!, arg_values_opt!)
                }
                _ -> null
            }
        }
        _ -> null
    }
}

// ── Folding driver ──

/// Run the comptime fn body with pre-resolved Value args bound to
/// params. Uses the pre-built `reg.runtime` (seeded with every
/// comptime fn) and the direct-call path that bypasses eval's
/// Call-dispatch overhead (no name lookup, no Expr.Call wrapper,
/// no per-arg eval_expr round-trip).
fn fold_call(reg: CompTimeRegistry, fn_def: CompTimeFn, arg_values: List<Value>) -> Expr? {
    // ps3t.5.5 content-addressed result memoization: a @comptime fn is pure, so
    // (fn identity + scalar arg values) fully determines the folded literal.
    // Cache it, keyed on that content, so a repeated call reuses the result
    // instead of re-running the JIT (re-codegen) or the tree-walker. Only scalar
    // args produce a key (unambiguous, length-prefixed); complex-arg folds skip
    // the cache and recompute. The cached row is a literal leaf re-stamped at
    // each call site by the id-native rewrite driver, so sharing the value never
    // shares a span — byte-identical to recomputing it.
    let key = fold_cache_key(fn_def.name, arg_values)
    if key != "" && avra_map_has_cstr(reg.fold_cache, key) == 1 {
        return reg.runtime.nodes.exprs.get(ExprId(avra_map_get_cstr(reg.fold_cache, key)))
    }
    let computed = fold_call_compute(reg, fn_def, arg_values)
    if computed != null && key != "" {
        avra_map_set_cstr(reg.fold_cache, key, reg.runtime.nodes.add_expr_leaf(computed!).raw())
    }
    computed
}

/// Compute a fold WITHOUT memoization — the compiled-comptime fast path
/// (ps3t.5 Slice A) with a total interpreter fallback: for a self-contained
/// scalar-int fn we codegen + JIT it instead of tree-walking, else fall back
/// to the interpreter for every shape the JIT can't safely handle. `fold_call`
/// wraps this with the result cache.
fn fold_call_compute(reg: CompTimeRegistry, fn_def: CompTimeFn, arg_values: List<Value>) -> Expr? {
    let jit = try_jit_fold(reg, fn_def, arg_values)
    if jit != null { return jit }
    let result = eval_fn_with_resolved_args(reg.runtime, fn_def.params, fn_def.body, arg_values)
    if step_had_error(result) != 0 { return null }
    value_to_expr(reg.runtime.nodes, step_value(result))
}

/// Content-address a fold: a length-prefixed, unambiguous key over the fn's
/// (qualified) name + its scalar (number/bool/string) arg values. Returns ""
/// — "not memoizable, recompute" — for any non-scalar arg, so complex
/// AST/collection values never collide in the string-keyed cache. Length
/// prefixes make the concatenation self-delimiting, so distinct (name, args)
/// tuples can never produce the same key.
fn fold_cache_key(fn_name: string, arg_values: List<Value>) -> string {
    mut key = string(fn_name.length) + ":" + fn_name
    mut i = 0
    while i < arg_values.length {
        let a = arg_values[i]
        let part = match a.kind {
            "number" -> "n" + string(a.number_text.length) + ":" + a.number_text
            "bool" -> "b:" + string(a.bool_value)
            "string" -> "s" + string(a.text.length) + ":" + a.text
            _ -> ""
        }
        if part == "" { return "" }
        key = key + part
        i = i + 1
    }
    key
}

// ── Compiled-comptime fold (ps3t.5 Slice A) ──

/// True for `ValueType.Int` — the only param/return shape the first-cut JIT
/// fold marshals (i64 in, i64 out, unambiguous ABI).
fn vtype_is_int(vt: ValueType) -> bool {
    match vt {
        .Int -> true
        _ -> false
    }
}

/// Try to evaluate `fn_def(arg_values)` by compiling the fn to machine code and
/// running it in-process, returning the result as a literal `Expr.Number`.
/// Returns null (→ interpreter fallback) unless EVERY safety gate holds, because
/// the alternative is worse than slow: a JIT'd `/`-by-zero fires a runtime trap
/// that `abort()`s the compiler, and a call to a non-comptime callee can't be
/// resolved in the single-fn module. The gates keep the JIT to pure scalar-int
/// arithmetic whose result is byte-identical to the interpreter's.
fn try_jit_fold(reg: CompTimeRegistry, fn_def: CompTimeFn, arg_values: List<Value>) -> Expr? {
    if !vtype_is_int(fn_def.ret_ty) { return null }
    let argc = arg_values.length
    if argc != fn_def.params.length { return null }
    if argc > 4 { return null }              // avra_llvm_jit_call arity ceiling
    mut pi = 0
    while pi < fn_def.params.length {
        if !vtype_is_int(fn_def.params[pi].vtype) { return null }
        pi = pi + 1
    }
    mut ai = 0
    while ai < argc {
        if arg_values[ai].kind != "number" { return null }
        ai = ai + 1
    }
    if !body_jit_safe(reg.runtime.nodes, fn_def.body) { return null }

    let argv = avra_i64_buf_new(argc)
    mut i = 0
    while i < argc {
        avra_i64_buf_set(argv, i, parse_num(arg_values[i].number_text))
        i = i + 1
    }
    // Materialise the fn as a standalone declaration in the program store, then
    // codegen just that row and JIT-call it. The body rows are already in the
    // store, so a leaf Function row (payload carries params/ret/body) is enough.
    // NOTE: no memoization — every eligible call site re-runs codegen + JIT for
    // its fn, even repeated calls to the same helper. Fine for the first cut
    // (correctness before speed); caching the compiled fn keyed on identity is
    // ps3t.5.5. The interpreter fallback bounds the blast radius until then.
    let empty_tp: List<TypeParamEntry> = []
    let fn_stmt_id = reg.runtime.nodes.add_stmt_leaf(Stmt.Function(fn_def.name, empty_tp, fn_def.params, fn_def.ret_ty, fn_def.body))
    let only: List<StmtId> = [fn_stmt_id]
    let folded = match compile_and_jit_call(only, reg.type_reg, reg.runtime.nodes, fn_def.name, argc, argv) {
        .Ok(v) -> maybe_number(render_number(v))
        .Err(_) -> null
    }
    avra_i64_buf_free(argv)
    folded
}

/// Wrap a rendered integer literal as an `Expr.Number` — the same shape
/// `value_to_expr` produces for the interpreter's `value_number(render_number)`,
/// so a JIT fold and an interpreter fold are byte-identical.
fn maybe_number(text: string) -> Expr? {
    Expr.Number(text)
}

/// Conservatively decide whether a fn body is safe to JIT: only pure scalar
/// arithmetic + branching control flow, with NO call of any kind (the single-fn
/// module has no callees), NO `/` or `%` (their zero-divisor trap `abort()`s
/// the compiler), and NO loops. Loops are excluded on purpose: the blessed
/// subset has no assignment, so the only loop that would type-check is one whose
/// condition never changes — an infinite loop that, JIT'd and run in-process,
/// would HANG the compiler (the interpreter fallback at least tree-walks it
/// under the evaluator's control). So the body is terminating by construction.
/// Any statement/expression this doesn't explicitly bless → unsafe → interpreter
/// fallback. Fail-closed by design.
fn body_jit_safe(store: NodeStore, body: List<StmtId>) -> bool {
    mut i = 0
    while i < body.length {
        if !stmt_jit_safe(store, store.stmts.get(body[i])) { return false }
        i = i + 1
    }
    true
}

fn stmt_jit_safe(store: NodeStore, stmt: Stmt) -> bool {
    match stmt_unwrap(store, stmt) {
        .Expr(e) -> expr_jit_safe(store, e)
        .Return(e) -> expr_jit_safe(store, e)
        .ReturnEmpty -> true
        .Let(_, _, init) -> expr_jit_safe(store, init)
        .Mut(_, _, init) -> expr_jit_safe(store, init)
        .Const(_, _, init) -> expr_jit_safe(store, init)
        .Block(b) -> body_jit_safe(store, b)
        .If(cond, then_s, else_s) -> expr_jit_safe(store, cond)
            && stmt_jit_safe(store, store.stmts.get(then_s))
            && (else_s == null || stmt_jit_safe(store, store.stmts.get(else_s!)))
        // NB: no `.While` / `.For` arm — loops are deliberately not blessed (see
        // body_jit_safe: without assignment a terminating loop is impossible, and
        // an infinite one would hang the JIT'd compiler). Loops fall back to the
        // interpreter, which folds them under the evaluator's control.
        _ -> false
    }
}

fn expr_jit_safe(store: NodeStore, id: ExprId) -> bool {
    match store.exprs.get(id) {
        .Number(_) -> true
        .Bool(_) -> true
        .Ident(_) -> true
        .Grouping(e) -> expr_jit_safe(store, e)
        .Unary(_, right) -> expr_jit_safe(store, right)
        .Binary(left, op, right) -> binop_jit_safe(op)
            && expr_jit_safe(store, left) && expr_jit_safe(store, right)
        .Logical(left, _, right) -> expr_jit_safe(store, left) && expr_jit_safe(store, right)
        .IfExpr(cond, then_e, else_e) -> expr_jit_safe(store, cond)
            && expr_jit_safe(store, then_e) && expr_jit_safe(store, else_e)
        .Block(b) -> body_jit_safe(store, b)
        _ -> false
    }
}

/// `/` and `%` are the only pure-int operators that can trap (zero divisor →
/// `avra_div_by_zero_trap` → `abort()`), so they force the interpreter path.
fn binop_jit_safe(op: BinOp) -> bool {
    match op {
        .Div -> false
        .Mod -> false
        _ -> true
    }
}

// ── Value → Expr (construct-expression) conversion ──

/// Normalise a Value's kind for the fold reconstructor. AST nodes
/// boxed at the eval boundary (so07.8) carry kind="stmt"/"expr"/
/// "value_type" but keep their enum_* fields populated, so the fold
/// path treats them exactly like a plain "enum" Value.
fn fold_kind(v: Value) -> string {
    if is_boxed_ast_kind(v.kind) { return "enum" }
    v.kind
}

/// Turn a tree-walk evaluator Value into an AST literal Expr so
/// we can splice it into the surrounding program. Returns null
/// for shapes that don't have a literal AST representation —
/// caller treats null as "can't fold, leave the call alone".
///
/// Enum values produced by `quote { ... }`-style macro fns are
/// decoded back to a value-construction expression (`Expr.EnumCtor`
/// source form) so the spliced fold result reads as the construction
/// of the original Value rather than a post-resolve raw AST node.
fn value_to_expr(store: NodeStore, v: Value) -> Expr? {
    match fold_kind(v) {
        "number" -> Expr.Number(v.number_text)
        "string" -> Expr.String("\"${v.text}\"")
        "bool"   -> Expr.Bool(if v.bool_value != 0 { "true" } else { "false" })
        "null"   -> Expr.None
        "enum"   -> value_to_construct_expr(store, v)
        _        -> null
    }
}

/// Convert a Value back into an Expr representing a runtime
/// reconstruction of the value. For enum Values this yields
/// `Expr.EnumCtor(type, variant, args)` matching the shape
/// `lower_quotes` would emit for the equivalent `quote { ... }`
/// source. Primitives reuse the fast-path forms in `value_to_expr`.
fn value_to_construct_expr(store: NodeStore, v: Value) -> Expr? {
    match fold_kind(v) {
        "number" -> Expr.Number(v.number_text)
        "string" -> Expr.String("\"${v.text}\"")
        "bool"   -> Expr.Bool(if v.bool_value != 0 { "true" } else { "false" })
        "null"   -> Expr.None
        // A boxed Stmt-node Value reconstructs through the flip-aware
        // `construct_stmt`, NOT the generic payload rebuild below. Since
        // B-final flipped Stmt/Expr payloads to arena ids (`Call.args:
        // List<ExprId>`, `Stmt.Expr: ExprId`, …), the generic `Expr.EnumCtor(
        // type, variant, payload_to_args(…))` rebuilds each id field as a boxed
        // `Expr` — a `List<Expr>` / `Expr` where the flipped slot demands
        // `List<ExprId>` / `ExprId`. That only bites when the fold result is
        // COMPILED into a program (a `quote` returned through a sibling
        // @comptime helper — the fold path, invisible to diff-test since the
        // compiler never folds a quote); a render-only fold is unaffected.
        // Decoding to the native Stmt then re-emitting via `construct_stmt`
        // yields exactly what a direct `quote stmt` would — nested Exprs ride
        // the constructor's own recursion, so no Expr-level route is needed.
        // (Expr Values stay on the generic rebuild: it renders identically and
        // decoding some hand-built Expr Values can abort the decoder.)
        "enum" -> {
            if v.enum_type == "@std::avrac::core::Stmt" {
                match value_to_stmt(store, v) {
                    .Ok(n) -> construct_stmt(store, n)
                    .Err(_) -> null
                }
            } else {
                let args_opt = payload_to_args(store, v.enum_payload, 0)
                if args_opt == none { return none }
                Expr.EnumCtor(v.enum_type, v.enum_variant, args_opt!)
            }
        }
        // fwyx: a list Value reconstructs as Expr.ListLit, mirroring
        // the construct_expr_list output that produced it.
        "list" -> {
            let elems_opt = payload_to_args(store, v.list_payload, 0)
            if elems_opt == none { return none }
            Expr.ListLit(elems_opt!)
        }
        // fwyx: a struct Value reconstructs as Expr.StructLit, mirroring
        // the struct_lit_2 output (every FieldInit recurses).
        "struct" -> {
            mut inits: List<FieldInit> = []
            for f in v.struct_payload {
                let inner_opt = value_to_construct_expr(store, f.value)
                if inner_opt == none { return none }
                inits.push(FieldInit { name: f.name, value_id: store.exprs.add_leaf(inner_opt!) })
            }
            Expr.StructLit(v.struct_type, inits)
        }
        _ -> null
    }
}

/// Convert a payload List<Value> into the arena rows whose elements
/// reconstruct each value at runtime. `value_to_construct_expr` yields an
/// Expr whose own children are already ids, so a leaf row per element
/// suffices (identical to ingesting a `sexpr_dummy` recipe).
fn payload_to_args(store: NodeStore, payload: List<Value>, i: int) -> List<ExprId>? {
    mut out: List<ExprId> = []
    mut j = i
    while j < payload.length {
        let inner_opt = value_to_construct_expr(store, payload[j])
        if inner_opt == none { return none }
        out.push(store.exprs.add_leaf(inner_opt!))
        j = j + 1
    }
    out
}

// ── Stmt → Value encoder ──
//
// The @expand pass boxes a wrapped Stmt as a Value before
// invoking a 1-arg (or 2-arg) macro fn. Implementation reuses the
// quote-lowering pipeline: `construct_stmt(s)` produces an
// Expr.EnumCtor whose runtime evaluation builds the Value the macro
// pattern-matches on. Because eval boxes AST EnumCtors natively
// the resulting Value carries both the enum_* representation
// (for the macro's `match`) and the native node (for value_to_stmt).
// Returns null when evaluation errors — caller falls back to a
// zero-arg invocation.

/// Encode a Stmt as a Value for passing into a comptime fn arg.
/// Uses the runtime stored on the comptime registry — same one
/// that try_fold_call seeds via prepare_runtime.
export fn stmt_to_value(runtime: Runtime, s: Stmt) -> Value? {
    let expr = construct_stmt(runtime.nodes, s)
    let result = eval_expr(runtime, expr)
    if step_had_error(result) != 0 { return null }
    step_value(result)
}
