// WHY: compile-time evaluation of @comptime-annotated fns.
//
// `try_fold_call(reg, call_expr)` — given a registered comptime fn
// and a call expression with literal args, runs the fn body via the
// tree-walk evaluator (features/eval) and returns the result as an
// Expr AST literal. Returns null when the call can't be folded
// (callee not registered, args not literals, or body errors).
//
// Phase 2 of Components V2 (vez6.2). The program-walker that calls
// this on every call site lives in rewrite.av.

use core.{Expr, ExprList}
use features.eval.{Value, eval_fn_with_resolved_args, literal_args_to_values, step_value, step_had_error}
use features.comptime.{CompTimeFn, CompTimeRegistry, comptime_lookup}

// ── Public API ──

/// Try to fold a call expression at compile time. Returns the
/// folded literal Expr on success, null when the call can't be
/// reduced (callee unknown, args non-literal, body errored, etc).
///
/// Caller pattern:
///   match try_fold_call(reg, expr) {
///     null      -> emit the call as-is
///     folded    -> emit `folded`
///   }
export fn try_fold_call(reg: CompTimeRegistry, call: Expr) -> Expr? {
    // Early-exit gates, fastest-first:
    //   1. Not a Call(Ident(_), _) — common (most exprs are not calls)
    //   2. Callee not in the comptime registry — O(1) hashmap miss
    //   3. Args not all literals — handled by literal_args_to_values
    //      returning null. Single walk; serves both as gate AND as
    //      conversion to Value form for the direct-call eval path.
    // Only after all three pass do we run the tree-walk evaluator.
    match call {
        .Call(callee, args) -> {
            match callee {
                .Ident(name) -> {
                    let fn_def = comptime_lookup(reg, name)
                    if fn_def == null { return null }
                    let arg_values = literal_args_to_values(args)
                    if arg_values == null { return null }
                    fold_call(reg, fn_def!, arg_values!)
                }
                _ -> null
            }
        }
        _ -> null
    }
}

// ── Folding driver ──

/// Run the comptime fn body with pre-resolved Value args bound to
/// params. Uses the pre-built `reg.runtime` (seeded with every
/// comptime fn) and the direct-call path that bypasses eval's
/// Call-dispatch overhead (no name lookup, no Expr.Call wrapper,
/// no per-arg eval_expr round-trip).
fn fold_call(reg: CompTimeRegistry, fn_def: CompTimeFn, arg_values: List<Value>) -> Expr? {
    let result = eval_fn_with_resolved_args(reg.runtime, fn_def.params, fn_def.body, arg_values)
    if step_had_error(result) != 0 { return null }
    value_to_expr(step_value(result))
}

// ── Value → Expr conversion ──

/// Turn a tree-walk evaluator Value into an AST literal Expr so
/// we can splice it into the surrounding program. Returns null
/// for shapes that don't have a literal AST representation —
/// caller treats null as "can't fold, leave the call alone".
fn value_to_expr(v: Value) -> Expr? {
    match v.kind {
        "number" -> Expr.Number(v.number_text)
        "string" -> Expr.String("\"${v.text}\"")
        "bool"   -> Expr.Bool(if v.bool_value != 0 { "true" } else { "false" })
        "null"   -> Expr.Null
        _        -> null
    }
}
