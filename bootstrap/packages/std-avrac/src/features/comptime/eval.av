// WHY: compile-time evaluation of @comptime-annotated fns.
//
// `try_fold_call(reg, call_expr)` — given a registered comptime fn
// and a call expression with literal args, runs the fn body via the
// tree-walk evaluator (features/eval) and returns the result as an
// Expr AST literal. Returns null when the call can't be folded
// (callee not registered, args not literals, or body errors).
//
// Phase 2 of Components V2 (vez6.2). The program-walker that calls
// this on every call site lives in rewrite.av.

use core.{Expr, SExpr, sexpr_dummy, Stmt, SStmt, sstmt_dummy, ValueType, BinOp, UnOp, LogicOp, ParamEntry, TypeParamEntry, FieldEntry, FieldInit, CompConfigPair, Variant}
use features.eval.{Runtime, Value, eval_expr, eval_fn_with_resolved_args, literal_args_to_values, step_value, step_had_error}
use features.comptime.{CompTimeFn, CompTimeRegistry, comptime_lookup}
use features.quote_expr.{construct_stmt}

// ── Public API ──

/// Try to fold a call expression at compile time. Returns the
/// folded literal Expr on success, null when the call can't be
/// reduced (callee unknown, args non-literal, body errored, etc).
///
/// Caller pattern:
///   match try_fold_call(reg, expr) {
///     null      -> emit the call as-is
///     folded    -> emit `folded`
///   }
export fn try_fold_call(reg: CompTimeRegistry, call: Expr) -> Expr? {
    // Early-exit gates, fastest-first:
    //   1. Not a Call(Ident(_), _) — common (most exprs are not calls)
    //   2. Callee not in the comptime registry — O(1) hashmap miss
    //   3. Args not all literals — handled by literal_args_to_values
    //      returning null. Single walk; serves both as gate AND as
    //      conversion to Value form for the direct-call eval path.
    // Only after all three pass do we run the tree-walk evaluator.
    match call {
        .Call(callee, args) -> {
            match callee {
                .Ident(name) -> {
                    let fn_def = comptime_lookup(reg, name)?
                    let arg_values = literal_args_to_values(args)?
                    fold_call(reg, fn_def, arg_values)
                }
                _ -> null
            }
        }
        _ -> null
    }
}

// ── Folding driver ──

/// Run the comptime fn body with pre-resolved Value args bound to
/// params. Uses the pre-built `reg.runtime` (seeded with every
/// comptime fn) and the direct-call path that bypasses eval's
/// Call-dispatch overhead (no name lookup, no Expr.Call wrapper,
/// no per-arg eval_expr round-trip).
fn fold_call(reg: CompTimeRegistry, fn_def: CompTimeFn, arg_values: List<Value>) -> Expr? {
    let result = eval_fn_with_resolved_args(reg.runtime, fn_def.params, fn_def.body, arg_values)
    if step_had_error(result) != 0 { return null }
    value_to_expr(step_value(result))
}

// ── Value → Expr conversion ──

/// Turn a tree-walk evaluator Value into an AST literal Expr so
/// we can splice it into the surrounding program. Returns null
/// for shapes that don't have a literal AST representation —
/// caller treats null as "can't fold, leave the call alone".
///
/// Enum values produced by `quote { ... }`-style macro fns are
/// decoded back to their AST node by recognising the canonical
/// type path (`@std::avrac::core::Expr`) + variant name. Other
/// AST types (Stmt, ValueType, list types) reach this only via
/// the @expand pass which has its own decoder; for the fold
/// pass, `quote stmt {}` results return null and stay as Calls.
fn value_to_expr(v: Value) -> Expr? {
    match v.kind {
        "number" -> Expr.Number(v.number_text)
        "string" -> Expr.String("\"${v.text}\"")
        "bool"   -> Expr.Bool(if v.bool_value != 0 { "true" } else { "false" })
        "null"   -> Expr.Null
        // vez6.6.5: produce the EnumCtor SOURCE FORM (not the
        // post-resolve raw AST) so the spliced fold result reads as
        // a value-construction expression. `Expr.Ident("foo")` in
        // source builds a runtime Expr.Ident("foo") VALUE; the raw
        // post-resolve Ident("foo") would mean "look up the variable
        // foo" and codegen would emit `undefined variable` errors.
        // The Stmt decoder still uses enum_value_to_expr below for
        // sub-Expr payloads of Stmt — a Stmt.Return(Expr) splice
        // wants the inner Expr in raw form so `return 7` stays
        // `return 7`, not `return Expr.Number(\"7\")`.
        "enum"   -> value_to_construct_expr(v)
        _        -> null
    }
}

/// Convert a Value back into an Expr representing a runtime
/// reconstruction of the value. For enum Values this yields
/// `Expr.EnumCtor(type, variant, args)` matching the shape
/// `lower_quotes` would emit for the equivalent `quote { ... }`
/// source. Primitives reuse the fast-path forms in `value_to_expr`.
///
/// vez6.6.5: enables comptime fns whose return type is an AST type
/// (Expr / List<SExpr> / BinOp / etc.) to fold cleanly into their
/// callers — the call-site receives a value-construction expression
/// whose runtime evaluation produces the original Value.
fn value_to_construct_expr(v: Value) -> Expr? {
    match v.kind {
        "number" -> Expr.Number(v.number_text)
        "string" -> Expr.String("\"${v.text}\"")
        "bool"   -> Expr.Bool(if v.bool_value != 0 { "true" } else { "false" })
        "null"   -> Expr.Null
        "enum"   -> {
            let args = payload_to_args(v.enum_payload, 0)?
            Expr.EnumCtor(v.enum_type, v.enum_variant, args)
        }
        // fwyx: a list Value reconstructs as Expr.ListLit, mirroring
        // the construct_expr_list output that produced it.
        "list" -> {
            let elems = payload_to_args(v.list_payload, 0)?
            Expr.ListLit(elems)
        }
        // fwyx: a struct Value reconstructs as Expr.StructLit, mirroring
        // the struct_lit_2 output (every FieldInit recurses).
        "struct" -> {
            mut inits: List<FieldInit> = []
            for f in v.struct_payload {
                let inner = value_to_construct_expr(f.value)?
                inits.push(FieldInit { name: f.name, value: sexpr_dummy(inner) })
            }
            Expr.StructLit(v.struct_type, inits)
        }
        _ -> null
    }
}

/// Convert a payload List<Value> into a `List<SExpr>` whose elements
/// reconstruct each value at runtime. Each value is wrapped via
/// `sexpr_dummy` — same as `lower_quotes` does when it builds
/// construct-expression payloads.
fn payload_to_args(payload: List<Value>, i: int) -> List<SExpr>? {
    mut out: List<SExpr> = []
    mut j = i
    while j < payload.length {
        let inner = value_to_construct_expr(payload[j])?
        out.push(sexpr_dummy(inner))
        j = j + 1
    }
    out
}

/// Decode an enum Value whose type is `@std::avrac::core::Expr`
/// back into its AST shape. The variant name selects the Expr
/// constructor; payload values are decoded recursively for the
/// structural variants.
///
/// Slices land driven by what users build with `quote { ... }`:
/// leaves (Number/String/Bool/Null/Ident/QualifiedIdent/FloatLit)
/// and the prefix/infix/grouping shapes (Unary/Binary/Logical/
/// Grouping). More variants — Call/FieldAccess/Index/etc. — return
/// null until a test demands them, and the caller treats null as
/// "can't fold, leave the call alone".
fn enum_value_to_expr(v: Value) -> Expr? {
    if v.enum_type != "@std::avrac::core::Expr" { return null }
    if v.enum_variant == "Null" { return Expr.Null }
    let p = v.enum_payload
    if p.length == 0 { return null }
    let head: Value = p[0]
    match v.enum_variant {
        "Number"          -> Expr.Number(head.text)
        "String"          -> Expr.String("\"${head.text}\"")
        "Bool"            -> Expr.Bool(head.text)
        "Ident"           -> Expr.Ident(head.text)
        "QualifiedIdent"  -> Expr.QualifiedIdent(head.text)
        "FloatLit"        -> Expr.FloatLit(head.text)
        "Grouping"        -> {
            let inner = enum_value_to_expr(head)?
            Expr.Grouping(inner)
        }
        "Unary" -> {
            if p.length != 2 { return null }
            let op = enum_value_to_unop(head)?
            let right = enum_value_to_expr(p[1])?
            Expr.Unary(op, right)
        }
        "Binary" -> {
            if p.length != 3 { return null }
            let left = enum_value_to_expr(head)?
            let op = enum_value_to_binop(p[1])?
            let right = enum_value_to_expr(p[2])?
            Expr.Binary(left, op, right)
        }
        "Logical" -> {
            if p.length != 3 { return null }
            let left = enum_value_to_expr(head)?
            let op = enum_value_to_logicop(p[1])?
            let right = enum_value_to_expr(p[2])?
            Expr.Logical(left, op, right)
        }
        "Call" -> {
            if p.length != 2 { return null }
            let callee = enum_value_to_expr(head)?
            let args = list_value_to_expr_list(p[1])?
            Expr.Call(callee, args)
        }
        "EnumCtor" -> {
            if p.length != 3 { return null }
            let variant_v: Value = p[1]
            let args_v: Value = p[2]
            let args = list_value_to_expr_list(args_v)?
            Expr.EnumCtor(head.text, variant_v.text, args)
        }
        // Container shapes whose payload is two sub-Exprs.
        "Index" -> two_expr_decode(p, "Index")
        "NullCoalesce" -> two_expr_decode(p, "NullCoalesce")
        "Try" -> {
            if p.length != 1 { return null }
            let inner = enum_value_to_expr(head)?
            Expr.Try(inner)
        }
        "Spawn" -> {
            if p.length != 1 { return null }
            let inner = enum_value_to_expr(head)?
            Expr.Spawn(inner)
        }
        "FieldAccess" -> {
            if p.length != 2 { return null }
            let obj = enum_value_to_expr(head)?
            let field_v: Value = p[1]
            Expr.FieldAccess(obj, field_v.text)
        }
        "OptionalChain" -> {
            if p.length != 2 { return null }
            let obj = enum_value_to_expr(head)?
            let field_v: Value = p[1]
            Expr.OptionalChain(obj, field_v.text)
        }
        "IsCheck" -> {
            if p.length != 2 { return null }
            let subj = enum_value_to_expr(head)?
            let vname_v: Value = p[1]
            Expr.IsCheck(subj, vname_v.text)
        }
        "Tuple" -> {
            if p.length != 1 { return null }
            let elems = list_value_to_expr_list(head)?
            Expr.Tuple(elems)
        }
        "ListLit" -> {
            if p.length != 1 { return null }
            let elems = list_value_to_expr_list(head)?
            Expr.ListLit(elems)
        }
        "MapLit" -> {
            if p.length != 1 { return null }
            let entries = list_value_to_expr_list(head)?
            Expr.MapLit(entries)
        }
        "InCheck" -> {
            if p.length != 2 { return null }
            let needle = enum_value_to_expr(head)?
            let items = list_value_to_expr_list(p[1])?
            Expr.InCheck(needle, items)
        }
        "IfExpr" -> {
            if p.length != 3 { return null }
            let c = enum_value_to_expr(head)?
            let t = enum_value_to_expr(p[1])?
            let e = enum_value_to_expr(p[2])?
            Expr.IfExpr(c, t, e)
        }
        _                 -> null
    }
}

/// Helper for two-Expr-payload variants (Index, NullCoalesce). Picks
/// the right Expr ctor based on `variant`; returns null when payload
/// shape is wrong or either child fails to decode.
fn two_expr_decode(p: List<Value>, variant: string) -> Expr? {
    if p.length != 2 { return null }
    let l = enum_value_to_expr(p[0])?
    let r = enum_value_to_expr(p[1])?
    match variant {
        "Index" -> Expr.Index(l, r)
        "NullCoalesce" -> Expr.NullCoalesce(l, r)
        _ -> null
    }
}

/// Decode a Value carrying a list-of-Expr back into a `List<SExpr>`.
/// Post-lkze.9 #18: `construct_expr_list` emits `Expr.ListLit` whose
/// runtime evaluation produces a `kind="list"` Value, so the only
/// shape we see is the flat list payload.
fn list_value_to_expr_list(v: Value) -> List<SExpr>? {
    if v.kind != "list" { return null }
    list_value_to_expr_list_at(v.list_payload, 0)
}

fn list_value_to_expr_list_at(items: List<Value>, i: int) -> List<SExpr>? {
    mut out: List<SExpr> = []
    mut j = i
    while j < items.length {
        let inner = enum_value_to_expr(items[j])?
        out.push(sexpr_dummy(inner))
        j = j + 1
    }
    out
}

/// Decode an enum Value carrying a `@std::avrac::core::BinOp` tag
/// back into the BinOp variant. Mirrors construct_binop in lower.av.
fn enum_value_to_binop(v: Value) -> BinOp? {
    if v.enum_type != "@std::avrac::core::BinOp" { return null }
    match v.enum_variant {
        "Add" -> BinOp.Add
        "Sub" -> BinOp.Sub
        "Mul" -> BinOp.Mul
        "Div" -> BinOp.Div
        "Mod" -> BinOp.Mod
        "Eq"  -> BinOp.Eq
        "Ne"  -> BinOp.Ne
        "Lt"  -> BinOp.Lt
        "Le"  -> BinOp.Le
        "Gt"  -> BinOp.Gt
        "Ge"  -> BinOp.Ge
        _     -> null
    }
}

fn enum_value_to_unop(v: Value) -> UnOp? {
    if v.enum_type != "@std::avrac::core::UnOp" { return null }
    match v.enum_variant {
        "Neg" -> UnOp.Neg
        "Not" -> UnOp.Not
        _     -> null
    }
}

fn enum_value_to_logicop(v: Value) -> LogicOp? {
    if v.enum_type != "@std::avrac::core::LogicOp" { return null }
    match v.enum_variant {
        "And" -> LogicOp.And
        "Or"  -> LogicOp.Or
        _     -> null
    }
}

// ── Stmt / List<SStmt> decoders (vez6.6.4) ──
//
// The fold path can't return Stmt (call sites are expression-typed),
// so these helpers exist for the upcoming @expand pass: invoke a
// macro fn returning `quote stmt { ... }`, decode the resulting Value
// into a real Stmt, splice it into the parent scope.

/// Decode an enum Value whose type is `@std::avrac::core::Stmt`
/// back into a Stmt AST. Returns null when the variant isn't yet
/// supported or the payload shape doesn't match.
export fn value_to_stmt(v: Value) -> Stmt? {
    if v.kind != "enum" { return null }
    enum_value_to_stmt(v)
}

fn enum_value_to_stmt(v: Value) -> Stmt? {
    if v.enum_type != "@std::avrac::core::Stmt" { return null }
    let p = v.enum_payload
    match v.enum_variant {
        "ReturnEmpty" -> Stmt.ReturnEmpty
        "Break"       -> Stmt.Break
        "Continue"    -> Stmt.Continue
        "NoOp"        -> Stmt.NoOp
        "Expr" -> {
            if p.length != 1 { return null }
            let inner = enum_value_to_expr(p[0])?
            Stmt.Expr(inner)
        }
        "Return" -> {
            if p.length != 1 { return null }
            let inner = enum_value_to_expr(p[0])?
            Stmt.Return(inner)
        }
        "Let" -> binding_decode(p, "Let")
        "Mut" -> binding_decode(p, "Mut")
        "Const" -> binding_decode(p, "Const")
        "Block" -> {
            if p.length != 1 { return null }
            let body = list_value_to_stmt_list(p[0])?
            Stmt.Block(body)
        }
        "Impl" -> {
            // `impl Type { fns }` or `impl Trait for Type { fns }`.
            // Payload: (type_name: string, methods: List<SStmt>). The
            // method list recurses through list_value_to_stmt_list,
            // which itself recurses back here for each method body —
            // so any Stmt variant we don't yet decode becomes the
            // weak link, not Impl itself. Trait+Type is encoded as
            // "Trait:Type" in the type_name slot.
            if p.length != 2 { return null }
            let type_name_v: Value = p[0]
            let methods = list_value_to_stmt_list(p[1])?
            Stmt.Impl(type_name_v.text, methods)
        }
        "Function" -> {
            // `fn name<T>(params) -> RT { body }`. Payload:
            // (name: string, type_params: List<TypeParamEntry>,
            //  params: List<ParamEntry>, ret_vtype: ValueType, body: List<SStmt>).
            // Quote-lowering emits ValueType.Unknown at slot 3; the
            // re-resolve pass on the spliced AST fills it in.
            if p.length != 5 { return null }
            let name_v: Value = p[0]
            let tp = list_value_to_type_param_list(p[1])?
            let params = list_value_to_param_list(p[2])?
            let ret_vt = enum_value_to_value_type(p[3])
            let body = list_value_to_stmt_list(p[4])?
            let resolved_rt = ret_vt ?? ValueType.Unknown
            Stmt.Function(name_v.text, tp, params, resolved_rt, body)
        }
        "TypeDecl" -> {
            // `type Name<T> = { f1: T1, ... }`. Payload:
            // (name: string, type_params: List<TypeParamEntry>,
            //  fields: List<FieldEntry>).
            //
            // fwyx: fields + type_params now decode for real via the
            // list / struct kinds on Value — previous comments about
            // an empty fields slot are obsolete.
            if p.length != 3 { return null }
            let name_v: Value = p[0]
            let tp = list_value_to_type_param_list(p[1])?
            let fields = list_value_to_field_list(p[2])?
            Stmt.TypeDecl(name_v.text, tp, fields)
        }
        "EnumDecl" -> {
            // `enum Name<T> { V1, V2(f: T), ... }`. Payload:
            // (name: string, type_params: List<TypeParamEntry>,
            //  variants: List<Variant>). Mirrors TypeDecl shape so
            // macros emitting EnumDecl roundtrip through the same
            // list/struct kinds — gap 1.A of the @expand handoff.
            if p.length != 3 { return null }
            let name_v: Value = p[0]
            let tp = list_value_to_type_param_list(p[1])?
            let variants = list_value_to_variant_list(p[2])?
            Stmt.EnumDecl(name_v.text, tp, variants)
        }
        "ComponentBlock" -> {
            // `comp_name instance { config; body }`. Payload:
            // (comp_name: string, instance: string,
            //  config: List<CompConfigPair>, body: List<SStmt>).
            //
            // fwyx: config now decodes for real via the list / struct
            // kinds on Value — the old "empty config" workaround is gone.
            if p.length != 4 { return null }
            let comp_v: Value = p[0]
            let inst_v: Value = p[1]
            let config = list_value_to_comp_config_pair_list(p[2])?
            let body = list_value_to_stmt_list(p[3])?
            Stmt.ComponentBlock(comp_v.text, inst_v.text, config, body)
        }
        _ -> null
    }
}

/// Decode a list-Value of FieldEntry struct values back into a
/// `List<FieldEntry>`. Quote captures pre-resolve, so each entry's
/// resolved slot lands as ValueType.Unknown — the typeck pass fills
/// in real types on the re-resolved spliced AST.
fn list_value_to_field_list(v: Value) -> List<FieldEntry>? {
    if v.kind != "list" { return [] }
    mut out: List<FieldEntry> = []
    for entry in v.list_payload {
        let name = struct_field_string(entry, "name")
        let resolved = struct_field_value_type(entry, "resolved") ?? ValueType.Unknown
        out.push(FieldEntry { name, resolved })
    }
    out
}

/// Decode a list-Value of Variant struct values back into a
/// `List<Variant>`. Mirrors `list_value_to_field_list` — each entry
/// is a struct `Variant { name, fields }` where `fields` recurses
/// through `list_value_to_field_list`. Drives the EnumDecl decode
/// path (gap 1.A of the @expand handoff).
fn list_value_to_variant_list(v: Value) -> List<Variant>? {
    if v.kind != "list" { return [] }
    mut out: List<Variant> = []
    for entry in v.list_payload {
        if entry.kind != "struct" { return null }
        let name = struct_field_string(entry, "name")
        mut fields: List<FieldEntry> = []
        for f in entry.struct_payload {
            if f.name == "fields" {
                fields = list_value_to_field_list(f.value) ?? []
            }
        }
        out.push(Variant { name, fields })
    }
    out
}

/// Decode a list-Value of CompConfigPair struct values back into a
/// `List<CompConfigPair>`. Each pair carries a key (string) and a
/// value (Expr decoded via enum_value_to_expr).
fn list_value_to_comp_config_pair_list(v: Value) -> List<CompConfigPair>? {
    if v.kind != "list" { return [] }
    mut out: List<CompConfigPair> = []
    for entry in v.list_payload {
        if entry.kind != "struct" { return null }
        let key = struct_field_string(entry, "key")
        mut value_expr: Expr = Expr.Null
        for f in entry.struct_payload {
            if f.name == "value" {
                value_expr = enum_value_to_expr(f.value)?
            }
        }
        out.push(CompConfigPair { key, value: value_expr })
    }
    out
}
// Once Value grows list/struct support, the decoder can be
// reintroduced — for now the dropped slot is documented at the
// TypeDecl decode site.

/// Decode a `List<TypeParamEntry>` from its evaluator-Value form
/// (kind="list" of kind="struct" `TypeParamEntry {name, bounds}`).
///
/// fwyx: was a TODO-stub returning the empty list because the Value
/// union didn't model list / struct shapes. Now flowing through the
/// real list_payload + struct_payload — macro-emitted Function /
/// TypeDecl regain proper type-param fidelity.
fn list_value_to_type_param_list(v: Value) -> List<TypeParamEntry>? {
    if v.kind != "list" { return [] }
    mut out: List<TypeParamEntry> = []
    for entry in v.list_payload {
        let name = struct_field_string(entry, "name")
        let bounds = struct_field_string(entry, "bounds")
        out.push(TypeParamEntry { name, bounds })
    }
    out
}

/// Decode a Value carrying a `List<ParamEntry>` back into a real
/// `List<ParamEntry>` AST value. Walks the list payload of struct
/// Values `{name, vtype}` produced by `construct_param_list`.
fn list_value_to_param_list(v: Value) -> List<ParamEntry>? {
    if v.kind != "list" { return null }
    mut out: List<ParamEntry> = []
    for entry in v.list_payload {
        let name = struct_field_string(entry, "name")
        let resolved_vt = struct_field_value_type(entry, "vtype") ?? ValueType.Unknown
        out.push(ParamEntry { name: name, vtype: resolved_vt })
    }
    out
}

/// Lookup a string-valued field on a struct Value. Returns "" when
/// the entry isn't a struct, the field is missing, or the value
/// isn't a string. Callers treat "" as the no-name default.
fn struct_field_string(v: Value, name: string) -> string {
    if v.kind != "struct" { return "" }
    for f in v.struct_payload {
        if f.name == name { return f.value.text }
    }
    ""
}

/// Lookup a ValueType-encoded field. Returns null when the entry
/// isn't a struct, the field is missing, or the decoder rejects
/// the payload.
fn struct_field_value_type(v: Value, name: string) -> ValueType? {
    if v.kind != "struct" { return null }
    for f in v.struct_payload {
        if f.name == name { return enum_value_to_value_type(f.value) }
    }
    null
}

/// Three-arg binding decoder shared by Let / Mut / Const.
/// Payload: (name: string, ty_vt: ValueType, init: Expr).
/// Construct lower.av always emits ValueType.Unknown so we don't
/// need a full ValueType decoder yet — accept any kind="enum"
/// payload at slot 1 and use Unknown.
fn binding_decode(p: List<Value>, variant: string) -> Stmt? {
    if p.length != 3 { return null }
    let name_v: Value = p[0]
    let init = enum_value_to_expr(p[2])?
    let resolved_vt = enum_value_to_value_type(p[1]) ?? ValueType.Unknown
    match variant {
        "Let"   -> Stmt.Let(name_v.text, resolved_vt, init)
        "Mut"   -> Stmt.Mut(name_v.text, resolved_vt, init)
        "Const" -> Stmt.Const(name_v.text, resolved_vt, init)
        _ -> null
    }
}

/// Decode an enum Value carrying a `@std::avrac::core::ValueType`
/// tag. First slice covers the no-payload primitives + the Unknown
/// catch-all that lower_quotes emits everywhere by default.
fn enum_value_to_value_type(v: Value) -> ValueType? {
    if v.enum_type != "@std::avrac::core::ValueType" { return null }
    match v.enum_variant {
        "Int"     -> ValueType.Int
        "Bool"    -> ValueType.Bool
        "Float"   -> ValueType.Float
        "Str"     -> ValueType.Str
        "Bytes"   -> ValueType.Bytes
        "Void"    -> ValueType.Void
        "Ptr"     -> ValueType.Ptr
        "Unknown" -> ValueType.Unknown
        _ -> null
    }
}

/// Decode a Value carrying a `List<SStmt>` back into a real
/// `List<SStmt>` AST value. Walks the list payload of struct
/// Values produced by `construct_stmt_list`.
export fn value_to_stmt_list(v: Value) -> List<SStmt>? {
    list_value_to_stmt_list(v)
}

fn list_value_to_stmt_list(v: Value) -> List<SStmt>? {
    if v.kind != "list" { return null }
    mut out: List<SStmt> = []
    for entry in v.list_payload {
        let inner = enum_value_to_stmt(entry)?
        out.push(sstmt_dummy(inner))
    }
    out
}

// vez6.8.4.A: Stmt → Value encoder. Mirrors the value_to_stmt
// decoder so the @expand pass can box a wrapped Stmt as a Value
// before invoking a 1-arg macro fn.
//
// Implementation reuses the existing quote-lowering pipeline:
// `construct_stmt(s)` produces an Expr.EnumCtor whose runtime
// evaluation builds the Value the macro pattern-matches on.
// `eval_expr(runtime, expr)` walks that constructor tree using
// the same evaluator quote-lowered programs already drive at
// macro-expansion time. Returns null when evaluation errors —
// caller falls back to a zero-arg invocation.
//
// Variants that lack an encoder in lower.av (`stmt_passthrough`)
// fall back to NoOp here, matching the decode-side fallthrough.

/// Encode a Stmt as a Value for passing into a comptime fn arg.
/// Uses the runtime stored on the comptime registry — same one
/// that try_fold_call seeds via prepare_runtime.
export fn stmt_to_value(runtime: Runtime, s: Stmt) -> Value? {
    let expr = construct_stmt(s)
    let result = eval_expr(runtime, expr)
    if step_had_error(result) != 0 { return null }
    step_value(result)
}
