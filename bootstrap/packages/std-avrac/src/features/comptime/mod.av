// WHY: Compile-time evaluator (Phase 2 of Components V2 / vez6.2).
//
// `@comptime fn foo(...)` marks a function as evaluable at compile
// time. When such a fn is called with comptime-known arguments
// (literals or other comptime calls), the rewrite pass evaluates the
// call and replaces it with the resulting AST node — no runtime
// fn-call survives.
//
// This file is the entry point + registry. Folding lives in eval.av;
// the program-walker lives in rewrite.av. Pipeline:
// resolve_names → run_comptime → typecheck_program.
//
// Performance shape:
// - `run_comptime` short-circuits when no @comptime fns exist
//   (the common case for current programs — saves a full AST walk).
// - The shared evaluator Runtime is built once per program; folding
//   reuses it across every call site instead of re-registering fns.
//
// Design doc: docs/2026_05_08_COMPONENTS_V2_DESIGN.md §3.1

use core.{Stmt, ParamEntry, ValueType, TypeParamEntry, Annotation, stmt_unwrap}
use core.{NodeStore, StmtId, TypeRegistry, type_registry_new}
use features.eval.{Runtime, runtime_new, execute_stmt}
use features.comptime.{rewrite_program_ids}
use parse.{parse_body_source}
use diagnostics.{Span, DiagnosticBag, DiagCode, span_dummy, span_at, diag_error, bag_new, bag_report}

// String → int hashmap, same C-runtime primitive resolve/names + module_graph
// use. Stores name → index-into-`reg.fns` so `comptime_lookup` is O(1) per
// call site instead of O(N).
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

// ── Top-level entry ──

/// Single-call high-level entry point. Walks `stmts`, collects every
/// `@comptime` fn declaration, then rewrites every foldable comptime
/// call site with its evaluated literal. Idempotent.
///
/// Inserted into the compile pipeline AFTER `resolve_names` and
/// BEFORE `typecheck_program` so the typechecker sees the post-fold
/// AST (calls have collapsed into literals).
///
/// Fast path: when the program has no @comptime fns we short-circuit
/// without walking the AST at all.
export fn run_comptime(ids: List<StmtId>, store: NodeStore, type_reg: TypeRegistry) -> ComptimeResult {
    // Inject the resolved type registry so the fold path can codegen + JIT a
    // constant-fold `@comptime` fn (ps3t.5); `collect_comptime_fns_ids` seeds an
    // empty one for the discovery path.
    let reg = collect_comptime_fns_ids(ids, store) with { type_reg }
    if reg.fns.length == 0 { return ComptimeResult { stmts: ids, bag: bag_new() } }
    let out = rewrite_program_ids(ids, reg)
    // `reg.fold_errors` is a shared heap list appended to by the fold path
    // (eval.av) as the functional rewrite runs, so it now holds every genuine
    // fold failure — turn each into an F4007 the callers gate on.
    ComptimeResult { stmts: out, bag: fold_errors_to_bag(reg.fold_errors) }
}

/// The result of `run_comptime`: the rewritten root rows plus a
/// DiagnosticBag carrying any genuine constant-fold failures (F4007).
/// Callers thread `.stmts` into typecheck and merge `.bag` into the
/// compile bag, so a fold error gates compilation — the fold-path mirror
/// of how @expand's F4005 gates via `resolve_and_expand_program`.
export type ComptimeResult = {
    stmts: List<StmtId>,
    bag: DiagnosticBag,
}

/// Build a DiagnosticBag from the fold-error accumulator: one F4007 per
/// genuine constant-fold failure recorded during the rewrite. Empty in the
/// common case (no @comptime fold errored), so `bag_has_errors` is false and
/// compilation proceeds exactly as before this diagnostic channel existed.
fn fold_errors_to_bag(errors: List<ComptimeFoldError>) -> DiagnosticBag {
    mut bag = bag_new()
    for e in errors {
        bag = bag_report(bag, diag_error(
            DiagCode.ComptimeFoldFailed,
            "@comptime fn `${e.fn_name}` failed to fold at compile time: ${e.message}",
            e.span
        ))
    }
    bag
}

/// Build a diagnostics `Span` for a statement row from its byte span +
/// line/col/file in the store, so a fold failure recorded against
/// `reg.fold_span` carets at the enclosing statement. Synthesised rows with
/// no source attribution (line 0) collapse to the caret-less `span_dummy`.
export fn comptime_stmt_span(store: NodeStore, id: StmtId) -> Span {
    let pos = store.stmt_pos(id)
    if pos.line == 0 { return span_dummy() }
    let bs = store.stmts.span_of(id)
    span_at(bs.lo, bs.hi, pos.line, pos.col, pos.file)
}

/// Construct a fresh empty registry — no comptime fns, blank runtime,
/// empty name index. Tests and external callers that build registries
/// by hand should use this rather than the raw struct literal so
/// internal fields can evolve without touching call sites.
export fn comptime_registry_new(store: NodeStore) -> CompTimeRegistry {
    CompTimeRegistry { fns: [], runtime: runtime_new(store), name_index: avra_map_new_cstr(), type_reg: type_registry_new(), fold_cache: avra_map_new_cstr(), fold_errors: [], fold_span: span_dummy() }
}

/// Seed `reg.runtime` with every comptime fn AND build the name → index
/// hashmap. Returns a new registry — pure with respect to the input.
/// Idempotent: re-preparing rebuilds from `reg.fns`, fine but wasteful.
/// Callers usually go through `collect_comptime_fns_ids` which returns a
/// fully-prepared registry.
export fn prepare_runtime(reg: CompTimeRegistry) -> CompTimeRegistry {
    // Reseed from the registry's own runtime — the store rides along.
    mut rt = runtime_new(reg.runtime.nodes)
    let idx = avra_map_new_cstr()
    mut i = 0
    for f in reg.fns {
        let empty_tp: List<TypeParamEntry> = []
        let fn_stmt = Stmt.Function(f.name, empty_tp, f.params, f.ret_ty, f.body)
        rt = execute_stmt(rt, fn_stmt).runtime
        avra_map_set_cstr(idx, f.name, i)
        i = i + 1
    }
    CompTimeRegistry { fns: reg.fns, runtime: rt, name_index: idx, type_reg: reg.type_reg, fold_cache: reg.fold_cache, fold_errors: reg.fold_errors, fold_span: reg.fold_span }
}

// ── Types ──

/// One `@comptime`-annotated function declaration. Carries enough
/// AST to invoke the body at compile time: name, params, return
/// type, body.
///
/// @field name    — fn identifier (used for call-site lookup).
/// @field params  — formal parameter list.
/// @field ret_ty  — declared return type.
/// @field body    — fn body statement list.
export type CompTimeFn = {
    name: string,
    params: List<ParamEntry>,
    ret_ty: ValueType,
    body: List<StmtId>,
}

/// Registry of every `@comptime` fn discovered in the program,
/// plus a pre-built evaluator Runtime AND a name → index hashmap
/// for O(1) lookup at call sites. Built once per compile by
/// `collect_comptime_fns_ids`; folding reuses everything across every
/// call site — no per-call-site setup work.
///
/// @field fns        — every @comptime fn, in source order.
/// @field runtime    — eval Runtime with every fn pre-registered.
/// @field name_index — name → index-in-`fns` hashmap.
/// @field type_reg   — the program's resolved type registry, so the fold path
///   can codegen a `@comptime` fn in isolation and JIT it (compiled comptime,
///   ps3t.5). Empty (`type_registry_new()`) on the discovery + @expand paths,
///   where folds are macro/AST-returning and stay on the interpreter; the
///   top-level `run_comptime` injects the real one for the constant-fold path.
/// @field fold_cache — content-addressed memo of folded call results
///   (ps3t.5.5): a `(fn identity + scalar arg values) → ExprId` cstr-map.
///   A `@comptime` fn is pure, so identical inputs fold to the identical
///   literal; caching it lets a repeated call reuse the result instead of
///   re-running the JIT (re-codegen) or the tree-walker. Scoped to one
///   fold pass (a fresh map per prepared registry). Only scalar-arg folds
///   are keyed; complex-arg folds bypass the cache.
/// @field fold_errors — accumulator for genuine constant-fold FAILURES
///   (ps3t.5.7): when a call to a KNOWN @comptime fn with LITERAL args can't
///   be evaluated (a runtime error in the body, or the ps3t.5.4 loop-budget
///   trap), the fold path used to swallow it silently (null → unfolded call).
///   The rewrite records each such failure here (with the enclosing
///   statement's span); `run_comptime` turns them into F4007 diagnostics.
///   A shared heap list, so appends during the functional rewrite reach the
///   registry `run_comptime` holds; preserved through `prepare_runtime`.
/// @field fold_span — the enclosing statement's span, refreshed per-statement
///   by the rewriter (via `with`), so a fold failure deep in an expression is
///   attributed to a real source location without threading a span param
///   through every fold fn.
export type CompTimeRegistry = {
    fns: List<CompTimeFn>,
    runtime: Runtime,
    name_index: ptr,
    type_reg: TypeRegistry,
    fold_cache: ptr,
    fold_errors: List<ComptimeFoldError>,
    fold_span: Span,
}

/// One genuine constant-fold failure (ps3t.5.7): a call to a known @comptime
/// fn with literal args that could not be evaluated. `fn_name` + `message`
/// (the evaluator's error) name the failure; `span` locates it (the enclosing
/// statement). Distinct from "not foldable" (a comptime fn called with
/// non-literal args), which correctly stays unfolded and is NOT recorded here.
export type ComptimeFoldError = {
    fn_name: string,
    message: string,
    span: Span,
}

/// Record a genuine fold failure on the registry's shared accumulator. Called
/// from the fold path (eval.av) when a known @comptime fn with literal args
/// fails to evaluate. `mut` local rebind so the push reaches the shared list.
export fn record_fold_error(reg: CompTimeRegistry, fn_name: string, message: string) {
    mut errs = reg.fold_errors
    errs.push(ComptimeFoldError { fn_name: fn_name, message: message, span: reg.fold_span })
}

// ── Discovery ──

/// Scan a program's root `List<StmtId>` and collect every fn carrying the
/// `@comptime` annotation into a fully-prepared `CompTimeRegistry`. The
/// returned registry's runtime is seeded; callers fold immediately without
/// a separate `prepare_runtime` step. Recurses into Module bodies (via the
/// shared `gather_from_stmt`) so package-internal comptime fns are found.
/// Pure: doesn't mutate the AST. Used by the id-native `run_comptime` and
/// the @expand fixpoint's per-iteration registry rebuild.
export fn collect_comptime_fns_ids(ids: List<StmtId>, store: NodeStore) -> CompTimeRegistry {
    let fns = gather_fns_ids(store, ids, [])
    prepare_runtime(CompTimeRegistry { fns, runtime: runtime_new(store), name_index: avra_map_new_cstr(), type_reg: type_registry_new(), fold_cache: avra_map_new_cstr(), fold_errors: [], fold_span: span_dummy() })
}

/// Walks the root rows, sharing the
/// per-statement `gather_from_stmt` (which already reads store rows).
fn gather_fns_ids(store: NodeStore, ids: List<StmtId>, acc: List<CompTimeFn>) -> List<CompTimeFn> {
    mut fns = acc
    for id in ids { fns = gather_from_stmt(store, store.stmts.get(id), fns) }
    fns
}

/// Per-statement half of `gather_fns_ids`: register the stmt if it's an
/// @comptime fn, then recurse into a Module body's rows.
fn gather_from_stmt(store: NodeStore, stmt: Stmt, acc: List<CompTimeFn>) -> List<CompTimeFn> {
    mut fns = acc
    let entry = comptime_fn_from_stmt(store, stmt)
    if entry != null { fns.push(entry!) }
    // Unwrap Annotated wrappers before the Module match so `@x module { … }`
    // still recurses into its body to find nested @comptime fns.
    match stmt_unwrap(store, stmt) {
        .Module(_, body) -> {
            for id in body { fns = gather_from_stmt(store, store.stmts.get(id), fns) }
        }
        _ -> {}
    }
    fns
}

/// If `stmt` is an `@comptime`-annotated fn, return a CompTimeFn
/// describing it. Returns null otherwise. Peels through arbitrary
/// nesting of `Annotated` wrappers (`@doc @export @comptime fn` etc).
fn comptime_fn_from_stmt(store: NodeStore, stmt: Stmt) -> CompTimeFn? {
    match stmt {
        .Annotated(annots, inner) -> {
            if annotation_present(annots, "comptime") {
                fn_payload(store, store.stmts.get(inner))
            } else {
                comptime_fn_from_stmt(store, store.stmts.get(inner))
            }
        }
        _ -> null
    }
}

/// Recursively peel further annotation layers and extract the
/// Function payload. Returns null if the underlying decl isn't a fn.
fn fn_payload(store: NodeStore, stmt: Stmt) -> CompTimeFn? {
    match stmt {
        .Annotated(_, inner) -> fn_payload(store, store.stmts.get(inner))
        .Function(name, _, params, ret_ty, body) -> CompTimeFn { name, params, ret_ty, body }
        _ -> null
    }
}

/// True when `annots` contains a `@<name>` annotation. Iterative
/// (consistent with the rest of the file's loop pattern).
fn annotation_present(annots: List<Annotation>, name: string) -> bool {
    mut i = 0
    while i < annots.length {
        if annots[i].name == name { return true }
        i = i + 1
    }
    false
}

// ── Lookup ──

/// Find a comptime fn by name. Returns null when not registered —
/// caller treats that as "not a comptime call, leave it alone."
/// O(1) hashmap lookup via `reg.name_index`.
export fn comptime_lookup(reg: CompTimeRegistry, name: string) -> CompTimeFn? {
    if avra_map_has_cstr(reg.name_index, name) == 0 { return null }
    reg.fns[avra_map_get_cstr(reg.name_index, name)]
}

/// True when `name` is registered as a comptime fn. Constant-time —
/// avoids the full `comptime_lookup` round-trip when callers only
/// care about presence, not the fn body.
export fn comptime_has(reg: CompTimeRegistry, name: string) -> bool {
    avra_map_has_cstr(reg.name_index, name) != 0
}

// 9p1d: the metadata-side counterpart to `avra_lazy_comptime_set` in
// metadata_synthesize.av. When a consumer loads std-avrac (or any
// package shipping @comptime fns) from `.meta.bin`, the synthesizer
// stashes the body source string here keyed by the fn's qualified
// name. The consumer's `collect_comptime_fns_ids` finds the empty-body
// stub (the metadata synthesizes `@comptime fn foo(...) {}`), and
// the first `comptime_lookup_lazy` call rehydrates it from the
// stash. Subsequent lookups hit the populated registry.
//
// Cost shape: package-level cost (parse + register every lazy
// @comptime fn from this package) is paid ONCE per consumer that
// actually invokes any @expand from the package. Consumers that
// never @expand from this package pay zero parse cost.
extern fn avra_lazy_comptime_get(qn: string) -> string
extern fn avra_lazy_comptime_has(qn: string) -> int

/// Rehydrate every empty-body stub in `reg.fns` that has a stash
/// entry. Called once by `invoke_macro` before evaluating a macro
/// body — the macro may call helper @comptime fns that the eval
/// runtime dispatches internally (no lazy hook in eval's Call path),
/// so they must all be populated before evaluation begins. Idempotent:
/// already-rehydrated entries short-circuit in `comptime_lookup_lazy`.
export fn comptime_drain_lazy(reg: CompTimeRegistry) {
    for f in reg.fns {
        if f.body.length == 0 && avra_lazy_comptime_has(f.name) != 0 {
            let _ = comptime_lookup_lazy(reg, f.name)
        }
    }
}

/// Lookup that rehydrates lazy-shipped @comptime fns on demand. When
/// `comptime_lookup` returns a stub (empty body) AND the lazy registry
/// has source for the same name, parse the source, replace the stub
/// in `reg.fns` in-place, register the body with `reg.runtime`, and
/// return the rehydrated entry. Otherwise behaves like
/// `comptime_lookup`. Used by `invoke_macro` so the @expand pipeline
/// pays the parse cost ONLY for macros it actually invokes.
export fn comptime_lookup_lazy(reg: CompTimeRegistry, name: string) -> CompTimeFn? {
    let direct = comptime_lookup(reg, name)
    if direct != null && direct!.body.length > 0 { return direct }
    if avra_lazy_comptime_has(name) == 0 { return direct }
    let source = avra_lazy_comptime_get(name)
    if source == "" { return direct }
    let body = parse_body_source(source, reg.runtime.nodes)
    if body.length == 0 { return direct }
    if avra_map_has_cstr(reg.name_index, name) == 0 { return direct }
    let idx = avra_map_get_cstr(reg.name_index, name)
    let stub = reg.fns[idx]
    let rehydrated = CompTimeFn {
        name: stub.name,
        params: stub.params,
        ret_ty: stub.ret_ty,
        body: body,
    }
    // List/Runtime are heap-allocated reference shapes — mutating
    // through a mut-bound alias updates the registry the caller holds.
    mut fns = reg.fns
    fns.set(idx, rehydrated)
    let empty_tp: List<TypeParamEntry> = []
    let fn_stmt = Stmt.Function(stub.name, empty_tp, stub.params, stub.ret_ty, body)
    let _ = execute_stmt(reg.runtime, fn_stmt)
    rehydrated
}

