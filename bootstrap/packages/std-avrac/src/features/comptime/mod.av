// WHY: Compile-time evaluator (Phase 2 of Components V2 / vez6.2).
//
// `@comptime fn foo(...)` marks a function as evaluable at compile
// time. When such a fn is called with comptime-known arguments
// (literals or other comptime calls), the rewrite pass evaluates the
// call and replaces it with the resulting AST node — no runtime
// fn-call survives.
//
// This file is the entry point + registry. Folding lives in eval.av;
// the program-walker lives in rewrite.av. Pipeline:
// resolve_names → run_comptime → typecheck_program.
//
// Performance shape:
// - `run_comptime` short-circuits when no @comptime fns exist
//   (the common case for current programs — saves a full AST walk).
// - The shared evaluator Runtime is built once per program; folding
//   reuses it across every call site instead of re-registering fns.
//
// Design doc: docs/2026_05_08_COMPONENTS_V2_DESIGN.md §3.1

use core.{Stmt, StmtList, ParamList, ValueType, TypeParamList, AnnotationList}
use features.eval.{Runtime, runtime_new, execute_stmt}
use features.comptime.{rewrite_program}

// ── Top-level entry ──

/// Single-call high-level entry point. Walks `stmts`, collects every
/// `@comptime` fn declaration, then rewrites every foldable comptime
/// call site with its evaluated literal. Idempotent.
///
/// Inserted into the compile pipeline AFTER `resolve_names` and
/// BEFORE `typecheck_program` so the typechecker sees the post-fold
/// AST (calls have collapsed into literals).
///
/// Fast path: when the program has no @comptime fns we short-circuit
/// without walking the AST at all.
export fn run_comptime(stmts: StmtList) -> StmtList {
    let reg = collect_comptime_fns(stmts)
    if reg.fns.length == 0 { return stmts }
    rewrite_program(stmts, reg)
}

/// Construct a fresh empty registry — no comptime fns, blank runtime.
/// Tests and external callers that build registries by hand should use
/// this rather than the raw struct literal so internal fields can
/// evolve without touching call sites.
export fn comptime_registry_new() -> CompTimeRegistry {
    CompTimeRegistry { fns: [], runtime: runtime_new() }
}

/// Seed `reg.runtime` with every comptime fn so the folder doesn't
/// re-register them per call site. Returns a new registry — pure.
/// Idempotent: re-preparing an already-prepared registry rebuilds
/// from `reg.fns`. Callers usually go through `collect_comptime_fns`
/// which returns a fully-prepared registry.
export fn prepare_runtime(reg: CompTimeRegistry) -> CompTimeRegistry {
    mut rt = runtime_new()
    for f in reg.fns {
        let fn_stmt = Stmt.Function(f.name, TypeParamList.End, f.params, f.ret_ty, f.body)
        rt = execute_stmt(rt, fn_stmt).runtime
    }
    CompTimeRegistry { fns: reg.fns, runtime: rt }
}

// ── Types ──

/// One `@comptime`-annotated function declaration. Carries enough
/// AST to invoke the body at compile time: name, params, return
/// type, body.
///
/// @field name    — fn identifier (used for call-site lookup).
/// @field params  — formal parameter list.
/// @field ret_ty  — declared return type.
/// @field body    — fn body statement list.
export type CompTimeFn = {
    name: string,
    params: ParamList,
    ret_ty: ValueType,
    body: StmtList,
}

/// Registry of every `@comptime` fn discovered in the program,
/// plus a pre-built evaluator Runtime with all of them registered.
/// Built once per compile by `collect_comptime_fns`; folding reuses
/// the runtime across every call site.
export type CompTimeRegistry = {
    fns: List<CompTimeFn>,
    runtime: Runtime,
}

// ── Discovery ──

/// Walk a program's statement list and collect every fn carrying
/// the `@comptime` annotation into a fully-prepared `CompTimeRegistry`.
/// The returned registry's runtime is seeded; callers fold immediately
/// without a separate `prepare_runtime` step.
///
/// Recurses into Module bodies so package-internal comptime fns are
/// found. Pure: doesn't mutate the AST.
export fn collect_comptime_fns(stmts: StmtList) -> CompTimeRegistry {
    let fns = gather_fns(stmts, [])
    prepare_runtime(CompTimeRegistry { fns, runtime: runtime_new() })
}

/// Internal: walk `stmts`, append matching @comptime fns to the
/// running accumulator. Recurses into Module bodies. Threading the
/// accumulator through the recursion avoids the per-Module list-copy
/// that an outer-merge approach would do.
fn gather_fns(stmts: StmtList, acc: List<CompTimeFn>) -> List<CompTimeFn> {
    mut fns = acc
    mut cur = stmts
    mut keep_going = true
    while keep_going {
        match cur {
            .End -> { keep_going = false }
            .Node(ss, next) -> {
                let entry = comptime_fn_from_stmt(ss.node)
                if entry != null { fns.push(entry!) }
                match ss.node {
                    .Module(_, body) -> { fns = gather_fns(body, fns) }
                    _ -> {}
                }
                cur = next
            }
        }
    }
    fns
}

/// If `stmt` is an `@comptime`-annotated fn, return a CompTimeFn
/// describing it. Returns null otherwise. Peels through arbitrary
/// nesting of `Annotated` wrappers (`@doc @export @comptime fn` etc).
fn comptime_fn_from_stmt(stmt: Stmt) -> CompTimeFn? {
    match stmt {
        .Annotated(annots, inner) -> {
            if annotation_present(annots, "comptime") {
                fn_payload(inner)
            } else {
                comptime_fn_from_stmt(inner)
            }
        }
        _ -> null
    }
}

/// Recursively peel further annotation layers and extract the
/// Function payload. Returns null if the underlying decl isn't a fn.
fn fn_payload(stmt: Stmt) -> CompTimeFn? {
    match stmt {
        .Annotated(_, inner) -> fn_payload(inner)
        .Function(name, _, params, ret_ty, body) -> CompTimeFn { name, params, ret_ty, body }
        _ -> null
    }
}

/// True when `annots` contains a `@<name>` annotation. Iterative
/// (consistent with the rest of the file's loop pattern).
fn annotation_present(annots: AnnotationList, name: string) -> bool {
    mut cur = annots
    mut keep_going = true
    while keep_going {
        match cur {
            .End -> { keep_going = false }
            .Node(n, _, next) -> {
                if n == name { return true }
                cur = next
            }
        }
    }
    false
}

// ── Lookup ──

/// Find a comptime fn by name. Returns null when not registered —
/// caller treats that as "not a comptime call, leave it alone."
///
/// Linear scan over `reg.fns`. Acceptable for current programs (N
/// usually 0-20). When N grows (post std-cli rewrite, vez6.11), this
/// should become an O(1) hashmap lookup — see bd comptime-perf ticket.
export fn comptime_lookup(reg: CompTimeRegistry, name: string) -> CompTimeFn? {
    mut i = 0
    while i < reg.fns.length {
        if reg.fns[i].name == name { return reg.fns[i] }
        i = i + 1
    }
    null
}

/// True when `name` is registered as a comptime fn.
export fn comptime_has(reg: CompTimeRegistry, name: string) -> bool {
    comptime_lookup(reg, name) != null
}
