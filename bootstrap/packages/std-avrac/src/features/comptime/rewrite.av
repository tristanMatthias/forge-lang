// WHY: program walker that rewrites every foldable @comptime call
// in a program AST. Bottom-up traversal: inner expressions fold
// first, so `add(mul(2, 3), 5)` collapses to `add(6, 5)` then `11`.
//
// The structural-walker pattern mirrors desugar/mod.av — same shape,
// different rewrite hook (`try_fold_call` instead of
// dispatch-on-callee-name). The duplication is real tech debt; see
// the tracked ticket on a generic AST visitor.
//
// Phase 2 of Components V2 (vez6.2). Plumbed into 4 compile-pipeline
// sites in packages/cli/src/main.av between resolve_names and
// typecheck_program.

use core.{Stmt, Expr, FieldInit, MatchArm, WhenArm, SelectArm, StmtId, ExprId}
use features.comptime.{CompTimeRegistry, try_fold_call, comptime_stmt_span}

// ── Public entry ──

/// Walk every statement and expression in `ids`, replacing each foldable
/// @comptime call with its evaluated literal. Folds each root `StmtId`
/// row and returns fresh `List<StmtId>` rows — the input arena rows are
/// never mutated. Used by the id-native `run_comptime`.
export fn rewrite_program_ids(ids: List<StmtId>, reg: CompTimeRegistry) -> List<StmtId> {
    rewrite_stmt_ids(ids, reg)
}

// ── Statement walker ──

/// Rewrites each row and allocates the result against the original's
/// span + position.
fn rewrite_stmt_ids(ids: List<StmtId>, reg: CompTimeRegistry) -> List<StmtId> {
    mut out: List<StmtId> = []
    for id in ids { out.push(rewrite_stmt_id(id, reg)) }
    out
}

/// Rewrite one statement row, allocating against the original.
fn rewrite_stmt_id(id: StmtId, reg: CompTimeRegistry) -> StmtId {
    let store = reg.runtime.nodes
    // Refresh the fold-failure attribution span to THIS statement, so a genuine
    // fold error deep in its expressions carets here (ps3t.5.7). `with` shares the
    // fold_errors accumulator ptr, so appends still reach run_comptime's registry.
    let sreg = reg with { fold_span: comptime_stmt_span(store, id) }
    store.restmt(rewrite_stmt(store.stmts.get(id), sreg), id)
}

/// Rewrite one expression row, allocating against the original.
fn rewrite_expr_id(id: ExprId, reg: CompTimeRegistry) -> ExprId {
    let store = reg.runtime.nodes
    store.reexpr(rewrite_expr(store.exprs.get(id), reg), id)
}

fn rewrite_stmt(stmt: Stmt, reg: CompTimeRegistry) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, vt, rewrite_expr_id(init, reg))
        .Mut(name, vt, init) -> .Mut(name, vt, rewrite_expr_id(init, reg))
        .Const(name, vt, init) -> .Const(name, vt, rewrite_expr_id(init, reg))
        .Expr(e) -> .Expr(rewrite_expr_id(e, reg))
        .Return(e) -> .Return(rewrite_expr_id(e, reg))
        .Block(body) -> .Block(rewrite_stmt_ids(body, reg))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(rewrite_expr_id(cond, reg), rewrite_stmt_id(then_b, reg), rewrite_stmt_id(else_b!, reg))
            } else {
                .If(rewrite_expr_id(cond, reg), rewrite_stmt_id(then_b, reg), null)
            }
        }
        .While(cond, body) -> .While(rewrite_expr_id(cond, reg), rewrite_stmt_id(body, reg))
        .For(v, start, end, body) -> .For(v, rewrite_expr_id(start, reg), rewrite_expr_id(end, reg), rewrite_stmt_id(body, reg))
        .ForIn(v, coll, body) -> .ForIn(v, rewrite_expr_id(coll, reg), rewrite_stmt_id(body, reg))
        .Match(subj, arms) -> .Match(rewrite_expr_id(subj, reg), rewrite_match_arms(arms, reg))
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, rewrite_stmt_ids(body, reg))
        .Impl(type_name, methods) -> .Impl(type_name, rewrite_stmt_ids(methods, reg))
        .TraitDecl(name, methods) -> .TraitDecl(name, rewrite_stmt_ids(methods, reg))
        .LetDestructure(names, init) -> .LetDestructure(names, rewrite_expr_id(init, reg))
        .Defer(body) -> .Defer(rewrite_expr_id(body, reg))
        .Errdefer(body) -> .Errdefer(rewrite_expr_id(body, reg))
        .Annotated(annots, inner) -> .Annotated(annots, rewrite_stmt_id(inner, reg))
        .SpecBlock(name, body) -> .SpecBlock(name, rewrite_stmt_ids(body, reg))
        .GivenBlock(name, body) -> .GivenBlock(name, rewrite_stmt_ids(body, reg))
        .ThenBlock(name, cond) -> .ThenBlock(name, rewrite_expr_id(cond, reg))
        .Select(arms) -> .Select(rewrite_select_arms(arms, reg))
        .Parallel(body) -> .Parallel(rewrite_stmt_ids(body, reg))
        .Module(name, body) -> .Module(name, rewrite_stmt_ids(body, reg))
        .ComponentDef(name, params, config, children, implements, body) -> .ComponentDef(name, params, config, children, implements, rewrite_stmt_ids(body, reg))
        .ComponentBlock(comp, inst, config, body) -> .ComponentBlock(comp, inst, config, rewrite_stmt_ids(body, reg))
        // Leaves and decl-only statements pass through untouched.
        _ -> stmt
    }
}

// ── Expression walker ──

/// Bottom-up rewrite: descend into children first, then attempt to
/// fold THIS expression. Folding the outer-most after the children
/// lets nested comptime calls collapse in one pass.
///
/// Fast path: only Call expressions can fold. Non-Call shapes skip
/// the `try_fold_call` round-trip entirely — saves a fn call per
/// expression in the AST. The walker is the hot loop here.
fn rewrite_expr(expr: Expr, reg: CompTimeRegistry) -> Expr {
    let with_children = walk_expr(expr, reg)
    match with_children {
        .Call(_, _) -> {
            let folded = try_fold_call(reg, with_children)
            if folded != null { return folded! }
            with_children
        }
        _ -> with_children
    }
}

/// Structural walk: recurse `rewrite_expr` into every sub-expression
/// of `expr`. Mirror of desugar's `walk_expr` — same shape, different
/// hook function.
fn walk_expr(expr: Expr, reg: CompTimeRegistry) -> Expr {
    match expr {
        .Binary(l, op, r) -> .Binary(rewrite_expr_id(l, reg), op, rewrite_expr_id(r, reg))
        .Unary(op, r) -> .Unary(op, rewrite_expr_id(r, reg))
        .Logical(l, op, r) -> .Logical(rewrite_expr_id(l, reg), op, rewrite_expr_id(r, reg))
        .Call(callee, args) -> .Call(rewrite_expr_id(callee, reg), rewrite_expr_list_ids(args, reg))
        .GenericCall(callee, type_args, args) -> .GenericCall(rewrite_expr_id(callee, reg), type_args, rewrite_expr_list_ids(args, reg))
        .StructLit(name, inits) -> .StructLit(name, rewrite_field_inits(inits, reg))
        .Grouping(inner) -> .Grouping(rewrite_expr_id(inner, reg))
        .Assign(name, val) -> .Assign(name, rewrite_expr_id(val, reg))
        .Index(obj, idx) -> .Index(rewrite_expr_id(obj, reg), rewrite_expr_id(idx, reg))
        .FieldAccess(obj, field) -> .FieldAccess(rewrite_expr_id(obj, reg), field)
        .FieldAssign(obj, field, val) -> .FieldAssign(rewrite_expr_id(obj, reg), field, rewrite_expr_id(val, reg))
        .EnumCtor(type_name, variant, args) -> .EnumCtor(type_name, variant, rewrite_expr_list_ids(args, reg))
        .IfExpr(c, t, e) -> .IfExpr(rewrite_expr_id(c, reg), rewrite_expr_id(t, reg), rewrite_expr_id(e, reg))
        .Block(body) -> .Block(rewrite_stmt_ids(body, reg))
        .MatchExpr(subj, arms) -> .MatchExpr(rewrite_expr_id(subj, reg), rewrite_match_arms(arms, reg))
        .NullCoalesce(l, r) -> .NullCoalesce(rewrite_expr_id(l, reg), rewrite_expr_id(r, reg))
        .OptionalChain(obj, field) -> .OptionalChain(rewrite_expr_id(obj, reg), field)
        .OptionalMethodCall(obj, method, args) -> .OptionalMethodCall(rewrite_expr_id(obj, reg), method, rewrite_expr_list_ids(args, reg))
        .Try(inner) -> .Try(rewrite_expr_id(inner, reg))
        .Tuple(elems) -> .Tuple(rewrite_expr_list_ids(elems, reg))
        .TupleIndex(obj, idx) -> .TupleIndex(rewrite_expr_id(obj, reg), idx)
        .With(obj, overrides) -> .With(rewrite_expr_id(obj, reg), rewrite_field_inits(overrides, reg))
        .ListLit(elems) -> .ListLit(rewrite_expr_list_ids(elems, reg))
        .Lambda(params, body) -> .Lambda(params, rewrite_expr_id(body, reg))
        .MapLit(entries) -> .MapLit(rewrite_expr_list_ids(entries, reg))
        .Slice(obj, s, e) -> .Slice(rewrite_expr_id(obj, reg), rewrite_expr_id(s, reg), rewrite_expr_id(e, reg))
        .IsCheck(subj, variant) -> .IsCheck(rewrite_expr_id(subj, reg), variant)
        .InCheck(needle, items) -> .InCheck(rewrite_expr_id(needle, reg), rewrite_expr_list_ids(items, reg))
        .ListComp(body, variable, collection, filter) -> {
            let new_filter = if filter != null { rewrite_expr_id(filter!, reg) } else { null }
            .ListComp(rewrite_expr_id(body, reg), variable, rewrite_expr_id(collection, reg), new_filter)
        }
        .When(arms) -> .When(rewrite_when_arms(arms, reg))
        .Catch(inner, binding, body, line, col) -> .Catch(rewrite_expr_id(inner, reg), binding, rewrite_expr_id(body, reg), line, col)
        .Spawn(body) -> .Spawn(rewrite_expr_id(body, reg))
        .ChannelNew(elem, capacity) -> {
            if capacity == null { Expr.ChannelNew(elem, null) } else { .ChannelNew(elem, rewrite_expr_id(capacity!, reg)) }
        }
        .Isolated(body) -> .Isolated(rewrite_expr_id(body, reg))
        .Quote(kind, body) -> .Quote(kind, rewrite_expr_id(body, reg))
        .Splice(target) -> .Splice(rewrite_expr_id(target, reg))
        // Number, String, Bool, Null, Ident, QualifiedIdent, FloatLit
        // are leaves with no sub-expressions to recurse into.
        _ -> expr
    }
}

// ── List / sub-structure helpers ──

/// Map `rewrite_expr_id` over a flipped `List<ExprId>` (call args),
/// allocating each rewritten row via `reexpr`.
fn rewrite_expr_list_ids(ids: List<ExprId>, reg: CompTimeRegistry) -> List<ExprId> {
    mut out: List<ExprId> = []
    for id in ids { out.push(rewrite_expr_id(id, reg)) }
    out
}

fn rewrite_field_inits(inits: List<FieldInit>, reg: CompTimeRegistry) -> List<FieldInit> {
    mut out: List<FieldInit> = []
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        out.push(FieldInit { name: init.name, value_id: rewrite_expr_id(init.value_id, reg) })
        i = i + 1
    }
    out
}

fn rewrite_match_arms(arms: List<MatchArm>, reg: CompTimeRegistry) -> List<MatchArm> {
    mut out: List<MatchArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let new_guard_id = if arm.guard_id != null {
            rewrite_expr_id(arm.guard_id!, reg)
        } else { null }
        out.push(MatchArm { pattern: arm.pattern, pattern_id: arm.pattern_id, guard_id: new_guard_id, body_id: rewrite_expr_id(arm.body_id, reg) })
        i = i + 1
    }
    out
}

fn rewrite_when_arms(arms: List<WhenArm>, reg: CompTimeRegistry) -> List<WhenArm> {
    mut out: List<WhenArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let new_cond_id = if arm.cond_id != null {
            rewrite_expr_id(arm.cond_id!, reg)
        } else { null }
        out.push(WhenArm {
            cond_id: new_cond_id,
            body_id: rewrite_expr_id(arm.body_id, reg),
        })
        i = i + 1
    }
    out
}

fn rewrite_select_arms(arms: List<SelectArm>, reg: CompTimeRegistry) -> List<SelectArm> {
    mut out: List<SelectArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        out.push(SelectArm {
            binding: arm.binding,
            chan_id: rewrite_expr_id(arm.chan_id, reg),
            body_ids: rewrite_stmt_ids(arm.body_ids, reg),
        })
        i = i + 1
    }
    out
}
