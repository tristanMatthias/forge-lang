// WHY: typed id-shim constructors AND destructors for @comptime macro
// source — the eval-side mechanism for the B-final arena flip (Stmt
// payloads become ExprId / StmtId / List<StmtId> arena ids).
//
// Macro bodies run in the tree-walk evaluator's Value space, where
// every AST node is a boxed Value and arena ids don't exist — a macro
// has no store handle to allocate rows into. Once the Stmt enum's
// payloads are flipped to ids, a typed macro construct like
// `Stmt.Expr(e)` stops type-checking: `e` is an `Expr` node where the
// declaration demands an `ExprId` row.
//
// TWO DIRECTIONS, one identity mechanism:
//
//   WRITE (node → id): `synth_expr_id` / `synth_stmt_id` /
//   `synth_stmt_ids` let a macro CONSTRUCT flipped variants —
//   `Stmt.Expr(synth_expr_id(e))` type-checks with no leniency.
//
//   READ (id → node): `synth_deref_expr` / `synth_deref_stmt` /
//   `synth_deref_stmt_ids` let a macro INTROSPECT a flipped variant it
//   received — after `match s { .ComponentBlock(_, _, _, body) }` the
//   `body: List<StmtId>` children are already boxed, matchable Stmt
//   Values (the arg encoder `construct_stmt` materialises them
//   recursively), but the static type is `StmtId`; the deref shim
//   re-types each `StmtId → Stmt` so the macro can `match` it. This is
//   the read half of the pair that unblocks library-authored
//   introspection helpers (children_of_type / method_body). It is the
//   exact inverse of the write shims and shares their identity
//   intercept.
//
// At the type level each converts between a node value and its id
// form; at eval time each is an IDENTITY: features/eval/mod.av
// intercepts the calls by name (`call_is_synth_shim` — same
// last-segment matching as the ctx_* fns in resolver_ctx.av) and
// returns the evaluated argument Value unchanged, because Value space
// keeps the F2-boxed convention — the boxed node IS the payload, and
// the Value→AST decoder allocates real rows only when the macro's
// return value is spliced.
//
// The compiled bodies below are unreachable by design: every call
// site lives in @comptime macro code, which only the evaluator
// executes. Reaching one compiled means a shim leaked into runtime
// code — an internal invariant violation, reported and aborted with
// the same exit(99) convention as avra_match_unreachable.

use core.{ExprId, StmtId, Stmt, Expr, exit}

/// Compiled-path guard shared by every shim body.
fn synth_shim_unreachable(name: string) {
    eprintln("internal error: ${name} is comptime-only (eval-intercepted); it must not be reached in compiled code")
    exit(99)
}

/// Id view of an expression node — comptime-only identity shim.
export fn synth_expr_id(e: Expr) -> ExprId {
    synth_shim_unreachable("synth_expr_id")
    ExprId(0)
}

/// Id view of a statement node — comptime-only identity shim.
export fn synth_stmt_id(s: Stmt) -> StmtId {
    synth_shim_unreachable("synth_stmt_id")
    StmtId(0)
}

/// Id view of a statement list — comptime-only identity shim. Takes
/// bare `Stmt` nodes (matching `synth_stmt_id`/`synth_expr_id`); the
/// eval intercept is an identity, and the Value→AST decoder allocates
/// the real `StmtId` rows when the macro's return value is spliced.
export fn synth_stmt_ids(body: List<Stmt>) -> List<StmtId> {
    synth_shim_unreachable("synth_stmt_ids")
    []
}

/// Unsupported-variant marker (2h5s). The quote lowerer emits a call to
/// this in place of a silent `Stmt.NoOp` whenever `construct_stmt` meets a
/// statement variant it cannot yet encode (a decl / `match`-with-arms in a
/// quote body). It is NOT an identity shim: reaching it at macro-expansion
/// time is a hard error naming the variant (features/eval intercepts it and
/// returns an eval error, surfaced as F4005), so an unsupported quoted
/// statement fails the expansion — design §3.4 (wrong splice = compile
/// error) — instead of vanishing silently. The `Stmt` return type lets the
/// call sit wherever a constructed statement is expected; the eval intercept
/// errors before any value is produced, and the compiled body is unreachable
/// for the same reason as every other shim.
export fn synth_unsupported_stmt(variant: string) -> Stmt {
    synth_shim_unreachable("synth_unsupported_stmt")
    Stmt.NoOp
}

// ── Read shims (id → node): introspection inverse of the write shims ──
// Identity at eval; the received child is already a boxed, matchable
// node Value, so the shim only re-types it for `match`.

/// Node view of an expression id — comptime-only identity shim.
/// Lets a macro `match synth_deref_expr(child_id) { ... }` a flipped
/// `ExprId` child it received.
export fn synth_deref_expr(id: ExprId) -> Expr {
    synth_shim_unreachable("synth_deref_expr")
    Expr.None
}

/// Node view of a statement id — comptime-only identity shim. Lets a
/// macro `match synth_deref_stmt(child_id) { ... }` a flipped `StmtId`
/// child it received (e.g. a `ComponentBlock` body row).
export fn synth_deref_stmt(id: StmtId) -> Stmt {
    synth_shim_unreachable("synth_deref_stmt")
    Stmt.NoOp
}

/// Node view of a statement-id list — comptime-only identity shim.
/// The whole-list convenience for iterating a `body: List<StmtId>`:
/// `for child in synth_deref_stmt_ids(body) { match child { ... } }`.
export fn synth_deref_stmt_ids(ids: List<StmtId>) -> List<Stmt> {
    synth_shim_unreachable("synth_deref_stmt_ids")
    []
}

/// Raw text of a `body: TokenStream` instance body (vez6.9) — the
/// single TokenBody row's verbatim source, or "" when the body isn't a
/// raw token body. @comptime (unlike the name-intercepted shims): the
/// evaluator interprets this body, and the deref inside resolves
/// through the same intercepts every macro uses.
@comptime
export fn token_body_text(body: List<StmtId>) -> string {
    if body.length != 1 { return "" }
    match synth_deref_stmt(body[0]) {
        .TokenBody(text) -> text
        _ -> ""
    }
}
