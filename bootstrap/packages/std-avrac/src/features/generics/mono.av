// WHY: monomorphization pass — transforms generic declarations into
// concrete specializations and rewrites call sites. Runs after type
// checking and before codegen. After this pass, the AST contains no
// generic declarations — codegen sees only concrete code.

use core.{Expr, SExpr, sexpr, sexpr_at, sstmt, sstmt_at, Stmt, SStmt, ParamEntry, FieldEntry, FieldInit, Variant, MatchArm, TypeArg, TypeParamEntry, ValueType, type_param_has, variant_lookup, vtype_display, vtype_render_full, vtype_from_name, vtype_is_unknown, vtype_eq, find_type_pipe, union_type_list_merge, SelectArm, Annotation}
use diagnostics.{DiagCode, DiagnosticBag, bag_new, bag_report, bag_has_errors, diag_error, diag_warning, span_new}
use typeck.{TraitImplEntry, type_implements_trait}
use core.{mangle_join, type_short_name}

// ── Registries ──

/// Bundle of registries built from a program's generic
/// declarations. Threaded through every monomorphization pass.
///
/// @field fns     — generic-fn registry.
/// @field enums   — generic-enum registry.
/// @field structs — generic-struct registry.
type GenRegs = {
    fns: List<GenericFnEntry>,
    enums: List<GenericEnumEntry>,
    structs: List<GenericStructEntry>,
}

/// One entry in the generic-fn registry. Pairs the name with the
/// declaration's List<TypeParamEntry>, params, return type, and body —
/// everything needed to specialise it later.
type GenericFnEntry = {
    name: string,
    tp: List<TypeParamEntry>,
    params: List<ParamEntry>,
    ret_vt: ValueType,
    body: List<SStmt>,
}
/// One entry in the generic-enum registry.
type GenericEnumEntry = {
    name: string,
    tp: List<TypeParamEntry>,
    variants: List<Variant>,
}
/// One entry in the generic-struct registry.
type GenericStructEntry = {
    name: string,
    tp: List<TypeParamEntry>,
    fields: List<FieldEntry>,
}

/// Find a generic fn by name. Returns the matching entry, or
/// `null` when the fn isn't generic. Scans from the tail so the
/// most-recently-registered entry wins on duplicate names —
/// matches the cons-list "newest-at-head" shadowing.
fn generic_fn_lookup(reg: List<GenericFnEntry>, name: string) -> GenericFnEntry? {
    mut i = reg.length - 1
    while i >= 0 {
        let e = reg[i]
        if e.name == name { return e }
        i = i - 1
    }
    null
}
/// Find a generic enum by name. Mirror of `generic_fn_lookup`.
fn generic_enum_lookup(reg: List<GenericEnumEntry>, name: string) -> GenericEnumEntry? {
    mut i = reg.length - 1
    while i >= 0 {
        let e = reg[i]
        if e.name == name { return e }
        i = i - 1
    }
    null
}
/// Find a generic struct by name. Mirror of `generic_fn_lookup`.
fn generic_struct_lookup(reg: List<GenericStructEntry>, name: string) -> GenericStructEntry? {
    mut i = reg.length - 1
    while i >= 0 {
        let e = reg[i]
        if e.name == name { return e }
        i = i - 1
    }
    null
}

// ── Type arguments ──

/// Concrete bindings for one set of type parameters at a call
/// site. e.g. `T=int, E=string` for `f::<int, string>()`.
// `TypeArg` lives in core/ast.av so typeck can use the same shape
// without a circular import on this module. `List<TypeArg>` replaces
// the retired `enum TypeArgList`.

/// Look up the concrete ValueType bound to a type parameter.
/// Returns a placeholder `Struct(name)` when not found so the
/// caller can detect unbound params during specialisation.
/// Walks head-to-tail so cons-prepend semantics hold (the most
/// recently bound entry wins).
fn type_arg_lookup(args: List<TypeArg>, name: string) -> ValueType {
    mut i = 0
    while i < args.length {
        let entry = args[i]
        if entry.param_name == name { return entry.concrete_vt }
        i = i + 1
    }
    ValueType.Struct(name, 0)
}

/// One specialisation request: original name, mangled name, and
/// the per-param type bindings. The monomorphization pass walks
/// this list emitting one specialised decl per entry.
type Inst = {
    orig_name: string,
    mangled: string,
    type_args: List<TypeArg>,
}

/// Membership test for an inst list by mangled name.
fn inst_has(insts: List<Inst>, mangled: string) -> bool {
    mut i = 0
    while i < insts.length {
        if insts[i].mangled == mangled { return true }
        i = i + 1
    }
    false
}

/// Concatenate two inst lists, deduping on mangled names so a
/// specialisation that already exists in `rest` isn't doubled.
/// Returns a fresh list — callers may keep references to the
/// original `prefix`/`rest`, so we don't mutate either.
fn append_insts(prefix: List<Inst>, rest: List<Inst>) -> List<Inst> {
    mut out: List<Inst> = []
    mut i = 0
    while i < prefix.length {
        let p = prefix[i]
        if !(p.mangled != "" && inst_has(rest, p.mangled)) {
            out.push(p)
        }
        i = i + 1
    }
    mut j = 0
    while j < rest.length {
        out.push(rest[j])
        j = j + 1
    }
    out
}

/// Length of an inst list — kept as a helper so call sites read
/// at the same abstraction level as the rest of the pass.
fn inst_list_len(insts: List<Inst>) -> int { insts.length }

/// Look up the mangled name for a given orig fn/type name.
/// Returns the original name unchanged when no specialisation
/// exists — non-generic decls keep their bare names.
fn inst_mangled(insts: List<Inst>, name: string) -> string {
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        if e.orig_name == name { return e.mangled }
        i = i + 1
    }
    name
}

/// Merge partial type args into compatible existing entries
/// for the same generic name. Two entries are compatible when
/// no param maps to two different concrete types. The partial
/// is merged into EVERY compatible entry that needs its info,
/// and only appended as a new entry when no compatible entry
/// existed.
fn merge_partial(name: string, partial_ta: List<TypeArg>, insts: List<Inst>) -> List<Inst> {
    if !has_compatible_entry(name, partial_ta, insts) {
        // No compatible entry exists — append as new
        return append_new_inst(name, partial_ta, insts)
    }
    // Merge into every compatible entry that needs new info
    merge_into_all(name, partial_ta, insts)
}

/// True when an inst list contains an entry for `name` whose
/// type-args are compatible with the partial info — i.e. no
/// conflicting param→type bindings.
fn has_compatible_entry(name: string, partial_ta: List<TypeArg>, insts: List<Inst>) -> bool {
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        if e.orig_name == name && type_args_compatible(e.type_args, partial_ta) { return true }
        i = i + 1
    }
    false
}

/// Walk the inst list merging `partial_ta` into every entry for
/// `name` that's compatible with it. Used by `merge_partial`
/// once compatibility is established.
fn merge_into_all(name: string, partial_ta: List<TypeArg>, insts: List<Inst>) -> List<Inst> {
    mut out: List<Inst> = []
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        if e.orig_name == name && type_args_compatible(e.type_args, partial_ta) && adds_new_info(e.type_args, partial_ta) {
            let merged = merge_type_args(e.type_args, partial_ta)
            out.push(Inst { orig_name: name, mangled: "", type_args: merged })
        } else {
            out.push(e)
        }
        i = i + 1
    }
    out
}

/// Append a fresh inst entry. The mangled name is left empty
/// when `ta` is partial; finalize_insts fills it in later.
fn append_new_inst(name: string, ta: List<TypeArg>, insts: List<Inst>) -> List<Inst> {
    mut out: List<Inst> = []
    mut i = 0
    while i < insts.length {
        out.push(insts[i])
        i = i + 1
    }
    out.push(Inst { orig_name: name, mangled: "", type_args: ta })
    out
}

// Check if merging partial_ta into existing adds any new type arg bindings.
/// True when `partial` would update at least one binding in
/// `existing`. Used to skip redundant merges that wouldn't
/// produce any new info.
fn adds_new_info(existing: List<TypeArg>, partial: List<TypeArg>) -> bool {
    mut i = 0
    while i < partial.length {
        let name = partial[i].param_name
        if vtype_eq(type_arg_lookup(existing, name), ValueType.Struct(name, 0)) { return true }
        i = i + 1
    }
    false
}

/// Two type-arg lists are compatible when every shared param
/// name maps to the same concrete type (or one side leaves it
/// unbound). Used by `has_compatible_entry`.
fn type_args_compatible(a: List<TypeArg>, b: List<TypeArg>) -> bool {
    mut i = 0
    while i < b.length {
        let entry = b[i]
        let a_ty = type_arg_lookup(a, entry.param_name)
        if !vtype_eq(a_ty, ValueType.Struct(entry.param_name, 0)) && !vtype_eq(a_ty, entry.concrete_vt) { return false }
        i = i + 1
    }
    true
}

/// Union two type-arg lists into one. Caller has already
/// verified compatibility — this just deduplicates by name.
/// Cons-prepend semantics preserved: each new binding lands at
/// the head so subsequent `type_arg_lookup`s see it first.
fn merge_type_args(a: List<TypeArg>, b: List<TypeArg>) -> List<TypeArg> {
    mut out = a
    mut i = 0
    while i < b.length {
        let entry = b[i]
        if vtype_eq(type_arg_lookup(out, entry.param_name), ValueType.Struct(entry.param_name, 0)) {
            mut prepended: List<TypeArg> = []
            prepended.push(entry)
            mut j = 0
            while j < out.length {
                prepended.push(out[j])
                j = j + 1
            }
            out = prepended
        }
        i = i + 1
    }
    out
}

// Pre-finalization: merge compatible partial entries with the same generic name
// across function scopes. E.g. ok_emit's {T=EmitValue} + err_emit's {E=string}
// → {T=EmitValue, E=string}. This is needed for generic Result<T, E> where
// Ok and Err constructors live in different helper functions.
/// Cross-scope merge — propagate type-arg info from one
/// instantiation to another within the same generic. Lets
/// downstream calls see info that earlier sites resolved.
fn merge_across_scopes(insts: List<Inst>) -> List<Inst> {
    mut out: List<Inst> = []
    mut i = insts.length - 1
    while i >= 0 {
        let e = insts[i]
        out = merge_partial(e.orig_name, e.type_args, out)
        i = i - 1
    }
    out
}

// After merging, finalize: compute mangled names and validate resolution.
/// Final pass over the InstList: resolve every entry's mangled
/// name from its type-args, drop the still-partial ones, and
/// run trait-bound checks for each. Diagnostics accumulate in
/// the returned CollectState's bag.
fn finalize_insts(insts: List<Inst>, regs: GenRegs, bag: DiagnosticBag, ti: List<TraitImplEntry>) -> CollectState {
    mut out: List<Inst> = []
    mut acc_bag = bag
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        let tp = lookup_type_params(e.orig_name, regs)
        acc_bag = check_resolved(tp, e.type_args, e.orig_name, 0, 0, acc_bag, ti)
        let mangled = mangle_name_ordered(e.orig_name, tp, e.type_args)
        out.push(Inst { orig_name: e.orig_name, mangled, type_args: e.type_args })
        i = i + 1
    }
    CollectState { insts: out, bag: acc_bag, line: 0, col: 0, trait_impls: ti }
}

/// Find the List<TypeParamEntry> for a generic decl by name across
/// every registry (fns / enums / structs).
fn lookup_type_params(name: string, regs: GenRegs) -> List<TypeParamEntry> {
    let fn_e = generic_fn_lookup(regs.fns, name)
    if fn_e != null { return fn_e!.tp }
    let enum_e = generic_enum_lookup(regs.enums, name)
    if enum_e != null { return enum_e!.tp }
    let struct_e = generic_struct_lookup(regs.structs, name)
    if struct_e != null { return struct_e!.tp }
    let empty: List<TypeParamEntry> = []
    empty
}

// ── Helpers ──

/// True when a statement is a generic-yielding declaration
/// (fn / type / enum with non-empty type params). Used by
/// `monomorphize` to filter the AST before specialisation.
fn is_generic_decl(stmt: Stmt) -> bool {
    match stmt {
        .Function(_, tp, _, _, _) if tp.length > 0 -> true
        .EnumDecl(_, tp, _) if tp.length > 0 -> true
        .TypeDecl(_, tp, _) if tp.length > 0 -> true
        .Annotated(_, inner) -> is_generic_decl(inner)
        _ -> false
    }
}

/// Build the mangled name for a specialisation. Joins the
/// base name with the concrete types in List<TypeParamEntry> order
/// (so two sites with the same args produce the same mangled
/// name even when the resolver visits them differently).
fn mangle_name_ordered(base: string, tp: List<TypeParamEntry>, ta: List<TypeArg>) -> string {
    mangle_join(type_short_name(base), mangle_ordered(tp, ta))
}

/// Worker for `mangle_name_ordered` — concatenate the
/// concrete type names following the List<TypeParamEntry> order.
/// Uses `vtype_mangle_slug` (a qualifier-stripping renderer) so
/// every Struct / Enum / Newtype name gets short-named regardless
/// of how deeply it is nested inside `List<…>` / `Task<…>` /
/// `Tuple<…>` wrappers. The previous code did
/// `type_short_name(vtype_render_full(…))` which split the entire
/// rendered string on `::` and took the last part — that turned
/// `List<@std::lsp::Sym>` into `Sym>` because the trailing `>`
/// fell out of the last `::`-separated part, then divergently
/// matched at lookup sites where the qualifier survived through
/// a different rewrite path.
fn mangle_ordered(tp: List<TypeParamEntry>, ta: List<TypeArg>) -> string {
    mut out = ""
    mut i = 0
    while i < tp.length {
        let name = tp[i].name
        let ty = vtype_mangle_slug(type_arg_lookup(ta, name))
        if out == "" { out = ty } else { out = mangle_join(out, ty) }
        i = i + 1
    }
    out
}

/// Structural slug renderer for monomorphization names. Strips
/// `::` qualifiers PER-TYPE (so `@std::lsp::Sym` becomes `Sym`)
/// and recurses into containers so nested type-args get the same
/// treatment. Both monomorphization DECL emission and call-site
/// LOOKUP rewriting go through `mangle_name_ordered` → here, so
/// the names always match regardless of whether the caller passed
/// qualified or unqualified Struct names.
fn vtype_mangle_slug(t: ValueType) -> string {
    match t {
        .Struct(n, _) -> type_short_name(n)
        .Newtype(n, _, _) -> type_short_name(n)
        .Trait(n, _) -> "dyn ${type_short_name(n)}"
        .Enum(n, args, _) -> {
            let short = type_short_name(n)
            if args.length == 0 { short } else { "${short}<${mangle_arg_list(args)}>" }
        }
        .List(elem) -> "List<${vtype_mangle_slug(elem)}>"
        .Task(inner) -> "Task<${vtype_mangle_slug(inner)}>"
        .Tuple(elems) -> "Tuple<${mangle_arg_list(elems)}>"
        .NarrowedEnum(en, vn, _) -> "${type_short_name(en)}.${vn}"
        _ -> vtype_render_full(t)
    }
}

fn mangle_arg_list(args: List<ValueType>) -> string {
    mut out = ""
    mut i = 0
    while i < args.length {
        let part = vtype_mangle_slug(args[i])
        if i == 0 { out = part } else { out = "${out}, ${part}" }
        i = i + 1
    }
    out
}


// ── Type reading (from typeck-annotated SExpr.ty) ──

/// Infer concrete type-args for an enum / struct constructor
/// by pairing the declared field types with the arg
/// expressions and binding any T params that appear.
fn infer_from_fields(tp: List<TypeParamEntry>, fields: List<FieldEntry>, args: List<SExpr>, acc: List<TypeArg>) -> List<TypeArg> {
    mut out = acc
    let n = if fields.length < args.length { fields.length } else { args.length }
    mut i = 0
    while i < n {
        out = unify_param(tp, fields[i].resolved, args[i].ty, out)
        i = i + 1
    }
    out
}

/// Recursively unify a declared param type against a concrete arg
/// type, binding any type parameter that appears anywhere in the
/// param type. Peels `List<T>`, `Task<T>`, and `fn(T...) -> U`
/// constructors so generic list combinators like
/// `list_map<T,U>(xs: List<T>, f: fn(T) -> U)` can infer T and U
/// from the call site without an explicit turbofish.
///
/// Falls back to no-binding when the constructors don't match —
/// the monomorphizer's later `check_resolved` reports F1002 if a
/// param ended up unbound.
fn unify_param(tp: List<TypeParamEntry>, param_ty: ValueType, arg_ty: ValueType, acc: List<TypeArg>) -> List<TypeArg> {
    let name = vtype_display(param_ty)
    if type_param_has(tp, name) {
        // Cons-prepend: new binding lands at the head so
        // `type_arg_lookup` finds it before any earlier entry.
        mut out: List<TypeArg> = []
        out.push(TypeArg { param_name: name, concrete_vt: arg_ty })
        mut i = 0
        while i < acc.length {
            out.push(acc[i])
            i = i + 1
        }
        return out
    }
    match param_ty {
        .List(p_inner) -> match arg_ty {
            .List(a_inner) -> unify_param(tp, p_inner, a_inner, acc)
            _ -> acc
        }
        .Task(p_inner) -> match arg_ty {
            .Task(a_inner) -> unify_param(tp, p_inner, a_inner, acc)
            _ -> acc
        }
        .FnTyped(p_params, p_ret) -> match arg_ty {
            .FnTyped(a_params, a_ret) -> {
                let acc1 = unify_param(tp, p_ret, a_ret, acc)
                unify_type_lists(tp, p_params, a_params, acc1)
            }
            // Closures/typeck-Fn carry the return type only; recurse on
            // it so generic-fn calls passed a lambda can still bind the
            // return-type param. Their param-types come from the param
            // declaration itself, which still has a chance to bind via
            // earlier args (e.g. list_map: T bound by xs, U bound here).
            .Closure(_, a_ret) -> unify_param(tp, p_ret, a_ret, acc)
            .Fn(a_ret) -> unify_param(tp, p_ret, a_ret, acc)
            _ -> acc
        }
        _ -> acc
    }
}

/// Pairwise unify two type lists (used for fn-param recursion).
fn unify_type_lists(tp: List<TypeParamEntry>, params: List<ValueType>, args: List<ValueType>, acc: List<TypeArg>) -> List<TypeArg> {
    let n = if params.length < args.length { params.length } else { args.length }
    mut out = acc
    mut i = 0
    while i < n {
        out = unify_param(tp, params[i], args[i], out)
        i = i + 1
    }
    out
}

// If the typecheck-annotated arg type is Unknown (which happens when the
// call site lives in a context the annotate pass doesn't visit, like spec
// test bodies), fall back to inferring from the literal expression itself
// so monomorphization can still resolve generic type parameters.
/// Best-effort static type inference for an argument
/// expression. Used during type-arg inference at call sites.
fn arg_concrete_ty(arg: SExpr) -> ValueType {
    if !vtype_is_unknown(arg.ty) { return arg.ty }
    infer_lit_ty(arg.node)
}

/// Map a literal expression to its ValueType (Int / Bool /
/// Float / Str). Used by `arg_concrete_ty` for the trivial
/// cases. For `List<T>` inference at call sites we also peek at
/// `[a, b, c]` (taking the first element's inferred type) and
/// `(x: T) -> body` (synthesising `fn(T) -> Unknown` so
/// `unify_param` can still bind T).
fn infer_lit_ty(e: Expr) -> ValueType {
    match e {
        .Number(_) -> ValueType.Int
        .FloatLit(_) -> ValueType.Float
        .String(_) -> ValueType.Str
        .Bool(_) -> ValueType.Bool
        .StructLit(name, _) if name != "" -> ValueType.Struct(name, 0)
        .EnumCtor(tn, _, _) if tn != "" -> {
            let empty: List<ValueType> = []
            ValueType.Enum(tn, empty, 0)
        }
        .Grouping(inner) -> infer_lit_ty(inner)
        .ListLit(elements) -> ValueType.List(infer_list_elem_ty(elements))
        .Lambda(params, _) -> ValueType.FnTyped(param_types(params), ValueType.Unknown)
        _ -> ValueType.Unknown
    }
}

/// Pick the first element's inferred type as the list's element
/// type. Empty / all-unknown lists fall back to Unknown — the
/// monomorphizer then reports F1002 and the user adds a turbofish.
fn infer_list_elem_ty(elements: List<SExpr>) -> ValueType {
    if elements.length == 0 { return ValueType.Unknown }
    let t = arg_concrete_ty(elements[0])
    if vtype_is_unknown(t) { ValueType.Unknown } else { t }
}

/// Project a `List<ParamEntry>` down to its declared types (in
/// declaration order). Used to synthesise an FnTyped from a lambda
/// literal so generic-fn inference can bind its `T` parameters.
fn param_types(params: List<ParamEntry>) -> List<ValueType> {
    mut out: List<ValueType> = []
    mut i = 0
    while i < params.length {
        out.push(params[i].vtype)
        i = i + 1
    }
    out
}

/// Infer concrete type-args for a generic fn call by walking
/// the params + args lists pairwise. `unify_param` recurses into
/// generic constructors (`List<T>`, `Task<T>`, `fn(T) -> U`) so
/// type params nested inside them are bound from the call's
/// concrete arg types.
fn infer_from_params(tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>, acc: List<TypeArg>) -> List<TypeArg> {
    mut out = acc
    mut i = 0
    let n = if params.length < args.length { params.length } else { args.length }
    while i < n {
        out = unify_param(tp, params[i].vtype, arg_concrete_ty(args[i]), out)
        i = i + 1
    }
    out
}

/// Infer type-args from a struct literal's field initializers
/// by matching each init against its declared field type.
fn infer_from_field_inits(tp: List<TypeParamEntry>, fields: List<FieldEntry>, inits: List<FieldInit>, acc: List<TypeArg>) -> List<TypeArg> {
    mut out_acc = acc
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        let field_ty = field_type_for(fields, init.name)
        if type_param_has(tp, field_ty) {
            // Cons-prepend: most-recent binding lives at the head so
            // `type_arg_lookup` finds it first. Match the prior
            // recursion's ordering: head = first init that bound.
            mut prepended: List<TypeArg> = []
            prepended.push(TypeArg { param_name: field_ty, concrete_vt: init.value.ty })
            mut j = 0
            while j < out_acc.length {
                prepended.push(out_acc[j])
                j = j + 1
            }
            out_acc = prepended
        }
        i = i + 1
    }
    out_acc
}

/// Look up a field's declared type-name (as a string) by
/// field name. Returns "" when not found.
fn field_type_for(fields: List<FieldEntry>, name: string) -> string {
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        if e.name == name { return vtype_display(e.resolved) }
        i = i + 1
    }
    ""
}

// Validate that all type params are resolved. Emit F1002 for each missing one.
/// Verify every type param in `tp` got bound and that every
/// concrete arg satisfies the param's trait bounds. Emits
/// F1002 (cannot infer) for unbound params and F1000 for
/// bound violations.
fn check_resolved(tp: List<TypeParamEntry>, ta: List<TypeArg>, name: string, line: int, col: int, bag: DiagnosticBag, ti: List<TraitImplEntry>) -> DiagnosticBag {
    mut acc = bag
    mut i = 0
    while i < tp.length {
        let pname = tp[i].name
        let bounds = tp[i].bounds
        let concrete = type_arg_lookup(ta, pname)
        let concrete_str = vtype_render_full(concrete)
        acc = if vtype_eq(concrete, ValueType.Struct(pname, 0)) {
            bag_report(acc, diag_error(DiagCode.CannotInferTypeParam, "cannot infer type parameter `${pname}` in `${name}<...>`", span_new(0, 0, line, col)))
        } else if bounds != "" {
            // Check trait bounds: "T: Display + Debug" → check each bound
            check_type_bounds(concrete_str, bounds, name, pname, line, col, acc, ti)
        } else { acc }
        i = i + 1
    }
    acc
}

/// Walk a `+`-separated bound clause checking that the
/// concrete type implements each named trait. Each bound
/// failure adds its own diagnostic.
fn check_type_bounds(concrete: string, bounds: string, fn_name: string, param_name: string, line: int, col: int, bag: DiagnosticBag, ti: List<TraitImplEntry>) -> DiagnosticBag {
    // bounds is "Trait1 + Trait2" — split on " + "
    let plus = bounds.index_of(" + ")
    if plus >= 0 {
        let first = bounds.substring(0, plus)
        let rest = bounds.substring(plus + 3, bounds.length)
        let after_first = check_one_bound(concrete, first, fn_name, param_name, line, col, bag, ti)
        check_type_bounds(concrete, rest, fn_name, param_name, line, col, after_first, ti)
    } else {
        check_one_bound(concrete, bounds, fn_name, param_name, line, col, bag, ti)
    }
}

/// True when `name` is a primitive type. Used by trait-bound
/// checking to consult the built-in-impl table instead of the
/// user's `impl Trait for Type` decls.
fn is_builtin_type(name: string) -> bool {
    name == "int" || name == "i64" || name == "string" || name == "str" ||
    name == "float" || name == "f64" || name == "bool" || name == "ptr"
}

/// Verify a single trait bound on a concrete type. Emits
/// F1000 with a "trait bound not satisfied" message when the
/// type doesn't implement the trait.
fn check_one_bound(concrete: string, trait_name: string, fn_name: string, param_name: string, line: int, col: int, bag: DiagnosticBag, ti: List<TraitImplEntry>) -> DiagnosticBag {
    // Built-in types have implicit trait implementations (no explicit impl blocks).
    // Check against known built-in trait impls rather than blanket-accepting all.
    if is_builtin_type(concrete) {
        if builtin_implements(concrete, trait_name) { return bag }
        return bag_report(bag, diag_error(DiagCode.TypeMismatch, "built-in type `${concrete}` does not implement trait `${trait_name}` (required by `${param_name}` in `${fn_name}`)", span_new(0, 0, line, col)))
    }
    if !type_implements_trait(ti, concrete, trait_name) {
        bag_report(bag, diag_error(DiagCode.TypeMismatch, "type `${concrete}` does not implement trait `${trait_name}` (required by `${param_name}` in `${fn_name}`)", span_new(0, 0, line, col)))
    } else { bag }
}

// Check if a built-in type has an implicit implementation of a trait.
/// Built-in type / trait impl table. Hard-coded so primitives
/// like `int`, `string`, `bool` can satisfy generic bounds
/// (`Display`, `Eq`, `Ord`, `Hash`) without explicit `impl` blocks.
fn builtin_implements(ty: string, trait_name: string) -> bool {
    // All built-in types implement these universal traits
    if trait_name == "Display" { return true }
    if trait_name == "Debug" { return true }
    if trait_name == "Clone" { return true }
    if trait_name == "Copy" { return true }
    if trait_name == "Sized" { return true }
    // Numeric types implement Eq, Ord, Hash
    if ty == "int" || ty == "i64" || ty == "float" || ty == "f64" || ty == "bool" {
        if trait_name == "Eq" || trait_name == "Ord" || trait_name == "Hash" { return true }
    }
    // String implements Eq, Hash
    if ty == "string" || ty == "str" {
        if trait_name == "Eq" || trait_name == "Hash" { return true }
    }
    false
}

/// True when every param in `tp` has a binding in `ta`. Used
/// to decide whether an inst is fully resolved and can become
/// a real specialisation.
fn all_resolved(tp: List<TypeParamEntry>, ta: List<TypeArg>) -> bool {
    mut i = 0
    while i < tp.length {
        let pname = tp[i].name
        if vtype_eq(type_arg_lookup(ta, pname), ValueType.Struct(pname, 0)) { return false }
        i = i + 1
    }
    true
}

/// Convert an explicit `f::<int, string>` argument list into
/// a `List<TypeArg>` by zipping with the declared
/// List<TypeParamEntry>. Zips stop at whichever side ends first — same
/// shortest-zip semantics as the prior recursive shape.
fn explicit_to_type_args(tp: List<TypeParamEntry>, names: List<string>) -> List<TypeArg> {
    // Zip stops at whichever side ends first — matches the prior
    // shortest-zip semantics. Source-order push keeps the order
    // type_arg_lookup callers expect (callers don't rely on a
    // particular ordering, but keeping it stable avoids surprises).
    mut out: List<TypeArg> = []
    let limit = if tp.length < names.length { tp.length } else { names.length }
    mut i = 0
    while i < limit {
        out.push(TypeArg { param_name: tp[i].name, concrete_vt: vtype_from_type_string(names[i]) })
        i = i + 1
    }
    out
}

/// Infer enum-constructor type-args from the variant's
/// declared field types and the constructor call's args.
fn resolve_enum_type_args(tp: List<TypeParamEntry>, variants: List<Variant>, variant: string, args: List<SExpr>) -> List<TypeArg> {
    let vl = variant_lookup(variants, variant)
    let empty: List<TypeArg> = []
    infer_from_fields(tp, vl.fields, args, empty)
}

/// Rewrite a type-name string by replacing every generic
/// reference with its mangled specialisation name. Handles
/// both bare names (`Option`) and angle-bracket forms
/// (`Result<int, string>`).
fn rewrite_type_name(ty: string, regs: GenRegs, insts: List<Inst>) -> string {
    // First try exact match (non-generic types like "Option").
    if generic_enum_lookup(regs.enums, ty) != null { return inst_mangled(insts, ty) }
    if generic_struct_lookup(regs.structs, ty) != null { return inst_mangled(insts, ty) }
    // Handle explicit type args in annotation: "Result<EmitValue, string>"
    // Extract base name and mangle using the annotation's type args.
    let angle = find_char(ty, "<")
    if angle >= 0 {
        let base = ty.substring(0, angle)
        let enum_e = generic_enum_lookup(regs.enums, base)
        if enum_e != null {
            return mangle_annotation(base, enum_e!.tp, ty.substring(angle + 1, ty.length - 1), regs, insts)
        }
        let struct_e = generic_struct_lookup(regs.structs, base)
        if struct_e != null {
            return mangle_annotation(base, struct_e!.tp, ty.substring(angle + 1, ty.length - 1), regs, insts)
        }
    }
    ty
}

/// Mangle a generic type annotation like `Result<EmitValue,
/// string>` into `Result__EmitValue__string`. `args_str` is
/// the comma-separated type-arg list inside the brackets.
fn mangle_annotation(base: string, tp: List<TypeParamEntry>, args_str: string, regs: GenRegs, insts: List<Inst>) -> string {
    let ta = split_annotation_args(tp, args_str, regs, insts)
    mangle_name_ordered(base, tp, ta)
}

/// Split a comma-separated type-arg string (`"EmitValue,
/// string"`) into a `List<TypeArg>` matched against the
/// declaration's List<TypeParamEntry>. Respects nested generics —
/// the comma in `Map<string, int>` doesn't split.
fn split_annotation_args(tp: List<TypeParamEntry>, args_str: string, regs: GenRegs, insts: List<Inst>) -> List<TypeArg> {
    mut out: List<TypeArg> = []
    mut remaining = args_str
    mut i = 0
    while i < tp.length {
        let split = top_level_split_idx(remaining)
        let head_arg = if split < 0 { remaining.trim() } else { remaining.substring(0, split).trim() }
        let tail = if split < 0 { "" } else { remaining.substring(split + 1, remaining.length) }
        out.push(TypeArg { param_name: tp[i].name, concrete_vt: vtype_from_type_string(rewrite_type_name(head_arg, regs, insts)) })
        remaining = tail
        i = i + 1
    }
    out
}

/// Linear search for a single character in a string. Returns
/// its byte index or -1 when absent.
fn find_char(s: string, ch: string) -> int {
    mut i = 0
    while i < s.length {
        if s.substring(i, i + 1) == ch { return i }
        i = i + 1
    }
    -1
}

/// Find the index of the first top-level comma in a type-arg
/// string. Respects nesting: `Map<string, int>, string` returns
/// the index of the comma after `>`, not the inner one.
fn top_level_split_idx(s: string) -> int {
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s.substring(i, i + 1)
        if ch == "<" || ch == "(" { depth = depth + 1 }
        if ch == ">" || ch == ")" { depth = depth - 1 }
        if ch == "," && depth == 0 { return i }
        i = i + 1
    }
    -1
}

/// Walk a `List<ParamEntry>` rewriting every type annotation through
/// `rewrite_type_name`. Used during specialisation so the
/// generated fn body sees the concrete (mangled) types.
fn rewrite_param_types(params: List<ParamEntry>, regs: GenRegs, insts: List<Inst>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        let p = params[i]
        let vt = if vtype_is_unknown(p.vtype) { p.vtype } else {
            let ty_name = vtype_display(p.vtype)
            let rewritten = rewrite_type_name(ty_name, regs, insts)
            if rewritten != ty_name { vtype_from_type_string(rewritten) } else { p.vtype }
        }
        out.push(ParamEntry { name: p.name, vtype: vt })
        i = i + 1
    }
    out
}

// ── Pass 1: Collect generic declarations ──

/// Pass 1 entry: walk the AST collecting every generic decl
/// into the `GenRegs` registries. Recurses into modules.
fn collect_generics(stmts: List<SStmt>, regs: GenRegs) -> GenRegs {
    mut cur = regs
    mut i = 0
    while i < stmts.length {
        cur = collect_generic_stmt(stmts[i].node, cur)
        i = i + 1
    }
    cur
}

/// Per-statement collector. `Function`/`EnumDecl`/`TypeDecl`
/// with non-empty type params land in the matching registry;
/// other stmts pass through.
fn collect_generic_stmt(stmt: Stmt, regs: GenRegs) -> GenRegs {
    match stmt {
        .Function(name, tp, params, ret_vt, body) if tp.length > 0 -> {
            mut fns = regs.fns
            fns.push(GenericFnEntry { name, tp, params, ret_vt, body })
            regs with { fns }
        }
        .EnumDecl(name, tp, variants) if tp.length > 0 -> {
            mut enums = regs.enums
            enums.push(GenericEnumEntry { name, tp, variants })
            regs with { enums }
        }
        .TypeDecl(name, tp, fields) if tp.length > 0 -> {
            mut structs = regs.structs
            structs.push(GenericStructEntry { name, tp, fields })
            regs with { structs }
        }
        .Module(_, body) -> collect_generics(body, regs)
        .Annotated(_, inner) -> collect_generic_stmt(inner, regs)
        _ -> regs
    }
}

/// True when any generic registry is non-empty. Used to skip
/// the entire monomorphization pass for non-generic programs.
fn has_generics(regs: GenRegs) -> bool {
    regs.fns.length > 0 || regs.enums.length > 0 || regs.structs.length > 0
}

// ── Pass 2: Collect instantiation sites + validate ──

/// Per-pass collector state. Threaded through every walker so
/// instantiation requests + trait-bound diagnostics + the
/// current source span all flow together.
///
/// @field insts        — running list of instantiation requests.
/// @field bag          — diagnostics bag.
/// @field line / col   — current source line/col for diagnostics.
/// @field trait_impls  — registered trait impls, for bound checks.
type CollectState = { insts: List<Inst>, bag: DiagnosticBag, line: int, col: int, trait_impls: List<TraitImplEntry> }

/// Pass 2 entry: walk a List<SStmt> collecting instantiation
/// requests at every call / constructor site.
fn collect_inst_stmts(stmts: List<SStmt>, regs: GenRegs, st: CollectState) -> CollectState {
    mut cur = st
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        cur = collect_inst_stmt(ss.node, regs, cur with { line: ss.line, col: ss.col })
        i = i + 1
    }
    cur
}

/// Per-statement instantiation collector. Recurses into every
/// expression payload + nested body. Function bodies use a
/// fresh inst-list so per-fn merging behaves locally.
fn collect_inst_stmt(stmt: Stmt, regs: GenRegs, st: CollectState) -> CollectState {
    match stmt {
        .Let(_, _, init) -> collect_inst_expr(init, regs, st)
        .Mut(_, _, init) -> collect_inst_expr(init, regs, st)
        .Expr(e) -> collect_inst_expr(e, regs, st)
        .Return(val) -> collect_inst_expr(val, regs, st)
        .Defer(body) -> collect_inst_expr(body, regs, st)
        .Block(body) -> collect_inst_stmts(body, regs, st)
        .Module(_, body) -> collect_inst_stmts(body, regs, st)
        .Function(_, tp, _, ret_vt, body) -> {
            if tp.length > 0 { return st }
            // Scope merging to this function: collect body's instantiations
            // independently so enum ctors merge within the function, not globally.
            let fn_state = collect_inst_stmts(body, regs, CollectState { insts: [], bag: st.bag, line: st.line, col: st.col, trait_impls: st.trait_impls })
            // Also collect instantiation from the return type annotation.
            // This handles functions that return Result<T, E> but only construct
            // one variant (e.g., only Err paths — T is inferred from annotation).
            let with_ret = scope_insts_for_ret(vtype_render_full(ret_vt), regs, fn_state.insts)
            CollectState { insts: append_insts(with_ret, st.insts), bag: fn_state.bag, line: st.line, col: st.col, trait_impls: st.trait_impls }
        }
        .If(cond, then_b, else_b) -> {
            let a = collect_inst_stmt(then_b, regs, collect_inst_expr(cond, regs, st))
            if else_b != null { collect_inst_stmt(else_b!, regs, a) } else { a }
        }
        .While(cond, body) -> collect_inst_stmt(body, regs, collect_inst_expr(cond, regs, st))
        .For(_, start, end, body) -> collect_inst_stmt(body, regs, collect_inst_expr(end, regs, collect_inst_expr(start, regs, st)))
        .ForIn(_, coll, body) -> collect_inst_stmt(body, regs, collect_inst_expr(coll, regs, st))
        .Match(subj, arms) -> collect_inst_arms(arms, regs, collect_inst_expr(subj, regs, st))
        .Annotated(_, inner) -> collect_inst_stmt(inner, regs, st)
        .Impl(_, methods) -> collect_inst_stmts(methods, regs, st)
        .SpecBlock(_, body) -> collect_inst_stmts(body, regs, st)
        .GivenBlock(_, body) -> collect_inst_stmts(body, regs, st)
        .ThenBlock(_, cond) -> collect_inst_expr(cond, regs, st)
        .Parallel(body) -> collect_inst_stmts(body, regs, st)
        .Select(arms) -> collect_inst_select_arms(arms, regs, st)
        .Const(_, _, init) -> collect_inst_expr(init, regs, st)
        .Errdefer(body) -> collect_inst_expr(body, regs, st)
        _ -> st
    }
}

/// Walk every arm of a `select { ... }` collecting
/// instantiations from each channel + body.
fn collect_inst_select_arms(arms: List<SelectArm>, regs: GenRegs, st: CollectState) -> CollectState {
    mut cur = st
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let after_ch = collect_inst_expr(arm.channel, regs, cur)
        cur = collect_inst_stmts(arm.body, regs, after_ch)
        i = i + 1
    }
    cur
}

/// Per-expression instantiation collector. Recognises Call /
/// GenericCall / EnumCtor / StructLit / FieldAccess as
/// possible instantiation sites and registers their inferred
/// type-args with the InstList.
fn collect_inst_expr(expr: Expr, regs: GenRegs, st: CollectState) -> CollectState {
    match expr {
        .Call(callee, args) -> {
            let s = collect_inst_exprs(args, regs, st)
            match callee {
                .Ident(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null { try_add_fn_inst(name, fn_e!.tp, fn_e!.params, args, s) } else { s }
                }
                .QualifiedIdent(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null { try_add_fn_inst(name, fn_e!.tp, fn_e!.params, args, s) } else { s }
                }
                _ -> collect_inst_expr(callee, regs, s)
            }
        }
        .GenericCall(callee, type_names, args) -> {
            let s = collect_inst_exprs(args, regs, st)
            match callee {
                .Ident(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null { add_resolved_inst(name, fn_e!.tp, explicit_to_type_args(fn_e!.tp, type_names), s) } else { s }
                }
                .QualifiedIdent(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null { add_resolved_inst(name, fn_e!.tp, explicit_to_type_args(fn_e!.tp, type_names), s) } else { s }
                }
                _ -> collect_inst_expr(callee, regs, s)
            }
        }
        .EnumCtor(tn, variant, args) ->
            try_add_enum_inst(tn, variant, args, regs, collect_inst_exprs(args, regs, st))
        .StructLit(name, inits) ->
            try_add_struct_inst(name, inits, regs, collect_inst_field_inits(inits, regs, st))
        .FieldAccess(obj, variant_name) -> match obj {
            // Bare variant access (e.g. Option.None) — no args to infer from.
            // Valid only if another ctor site already provided type args via merging.
            // We don't error here — finalize_insts will catch missing instantiations.
            // But we DO add a merge-partial with empty args so finalize knows this
            // enum was referenced.
            .Ident(ename) -> {
                if generic_enum_lookup(regs.enums, ename) != null {
                    let empty_ta: List<TypeArg> = []
                    st with { insts: merge_partial(ename, empty_ta, st.insts) }
                } else {
                    collect_inst_expr(obj, regs, st)
                }
            }
            // Module-qualified bare variant access (resolver
            // rewrote `RgmList.End` → `mod::RgmList.End`).
            .QualifiedIdent(ename) -> {
                if generic_enum_lookup(regs.enums, ename) != null {
                    let empty_ta: List<TypeArg> = []
                    st with { insts: merge_partial(ename, empty_ta, st.insts) }
                } else {
                    collect_inst_expr(obj, regs, st)
                }
            }
            _ -> collect_inst_expr(obj, regs, st)
        }
        .Binary(l, _, r) -> collect_inst_expr(r, regs, collect_inst_expr(l, regs, st))
        .Logical(l, _, r) -> collect_inst_expr(r, regs, collect_inst_expr(l, regs, st))
        .NullCoalesce(l, r) -> collect_inst_expr(r, regs, collect_inst_expr(l, regs, st))
        .FieldAssign(l, _, r) -> collect_inst_expr(r, regs, collect_inst_expr(l, regs, st))
        .Index(obj, idx) -> collect_inst_expr(idx, regs, collect_inst_expr(obj, regs, st))
        .IfExpr(c, t, e) -> collect_inst_expr(e, regs, collect_inst_expr(t, regs, collect_inst_expr(c, regs, st)))
        .Unary(_, e) -> collect_inst_expr(e, regs, st)
        .Grouping(e) -> collect_inst_expr(e, regs, st)
        .Try(e) -> collect_inst_expr(e, regs, st)
        .Assign(_, val) -> collect_inst_expr(val, regs, st)
        .With(obj, inits) -> collect_inst_field_inits(inits, regs, collect_inst_expr(obj, regs, st))
        .Lambda(_, body) -> collect_inst_expr(body, regs, st)
        .Block(body) -> collect_inst_stmts(body, regs, st)
        .MatchExpr(subj, arms) -> collect_inst_arms(arms, regs, collect_inst_expr(subj, regs, st))
        .ListLit(elems) -> collect_inst_exprs(elems, regs, st)
        .Tuple(elems) -> collect_inst_exprs(elems, regs, st)
        .MapLit(entries) -> collect_inst_exprs(entries, regs, st)
        .ListComp(body, _, coll, filter) -> {
            let s1 = collect_inst_expr(body, regs, st)
            let s2 = collect_inst_expr(coll, regs, s1)
            if filter != null { collect_inst_expr(filter!, regs, s2) } else { s2 }
        }
        .Catch(inner, _, body, _, _) -> collect_inst_expr(body, regs, collect_inst_expr(inner, regs, st))
        _ -> st
    }
}

/// Map `collect_inst_expr` over a `List<SExpr>`.
fn collect_inst_exprs(exprs: List<SExpr>, regs: GenRegs, st: CollectState) -> CollectState {
    mut acc = st
    mut i = 0
    while i < exprs.length {
        let se = exprs[i]
        acc = collect_inst_expr(se.node, regs, acc with { line: se.line, col: se.col })
        i = i + 1
    }
    acc
}

/// Walk every match arm collecting instantiations from arm
/// bodies. Patterns themselves don't register instantiations.
fn collect_inst_arms(arms: List<MatchArm>, regs: GenRegs, st: CollectState) -> CollectState {
    mut acc = st
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard != null {
            acc = collect_inst_expr(arm.guard!.node, regs, acc)
        }
        acc = collect_inst_expr(arm.body.node, regs, acc)
        i = i + 1
    }
    acc
}

/// Walk a `List<FieldInit>` collecting instantiations from each
/// field's initializer expression.
fn collect_inst_field_inits(inits: List<FieldInit>, regs: GenRegs, st: CollectState) -> CollectState {
    mut acc = st
    mut i = 0
    while i < inits.length {
        acc = collect_inst_expr(inits[i].value.node, regs, acc)
        i = i + 1
    }
    acc
}

// Merge partial inference — full resolution is checked later in finalize_insts.
// Add a fully-resolved instantiation, or emit F0400 for unresolved params.
/// Append a fully-resolved instantiation (every param has a
/// concrete binding) to the InstList. Used by `GenericCall`
/// where the user supplied explicit type args.
fn add_resolved_inst(name: string, tp: List<TypeParamEntry>, ta: List<TypeArg>, st: CollectState) -> CollectState {
    if all_resolved(tp, ta) {
        let mangled = mangle_name_ordered(name, tp, ta)
        let new_insts = if inst_has(st.insts, mangled) {
            st.insts
        } else {
            // Prepend the new inst so subsequent merge passes see it
            // first — mirrors the cons-list InstList.Node(new, old)
            // semantics the old code relied on.
            mut prepended: List<Inst> = []
            prepended.push(Inst { orig_name: name, mangled, type_args: ta })
            mut i = 0
            while i < st.insts.length {
                prepended.push(st.insts[i])
                i = i + 1
            }
            prepended
        }
        st with { insts: new_insts }
    } else {
        st with { bag: check_resolved(tp, ta, name, st.line, st.col, st.bag, st.trait_impls) }
    }
}

/// Add (or merge) a generic-fn instantiation inferred from
/// the call args. Falls back to `merge_partial` so partial
/// info from one call site can complete another's bindings.
fn try_add_fn_inst(name: string, tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>, st: CollectState) -> CollectState {
    let empty_ta: List<TypeArg> = []
    add_resolved_inst(name, tp, infer_from_params(tp, params, args, empty_ta), st)
}

/// Add (or merge) a generic-enum instantiation inferred from
/// a constructor call. Looks up the variant's fields in the
/// generic enum registry and infers from there.
fn try_add_enum_inst(tn: string, variant: string, args: List<SExpr>, regs: GenRegs, st: CollectState) -> CollectState {
    let e = generic_enum_lookup(regs.enums, tn)
    if e == null { return st }
    let entry = e!
    st with { insts: merge_partial(tn, resolve_enum_type_args(entry.tp, entry.variants, variant, args), st.insts) }
}

/// Add (or merge) a generic-struct instantiation inferred
/// from a struct literal's field initializers.
fn try_add_struct_inst(name: string, inits: List<FieldInit>, regs: GenRegs, st: CollectState) -> CollectState {
    let e = generic_struct_lookup(regs.structs, name)
    if e == null { return st }
    let entry = e!
    let empty_ta: List<TypeArg> = []
    add_resolved_inst(name, entry.tp, infer_from_field_inits(entry.tp, entry.fields, inits, empty_ta), st)
}

// ── Pass 3: Generate concrete specializations ──

/// Specialise a generic fn for one `List<TypeArg>`. Returns a
/// fresh `Function` AST node with the mangled name +
/// substituted param/return types + substituted body.
fn specialize_fn(mangled: string, params: List<ParamEntry>, ret_vt: ValueType, body: List<SStmt>, ta: List<TypeArg>) -> Stmt {
    let concrete_ret_vt = substitute_vtype(ret_vt, ta)
    let empty_tp: List<TypeParamEntry> = []
    let fn_stmt = Stmt.Function(mangled, empty_tp, substitute_params(params, ta), concrete_ret_vt, substitute_stmts(body, ta))
    // Wrap with @mono_spec so codegen knows to emit `linkonce_odr`
    // linkage. Each consuming .o that monomorphizes the same generic
    // would otherwise emit a duplicate global symbol, breaking the
    // final link in library-mode (multiple packages share specs).
    let empty_args: List<SExpr> = []
    mut annots: List<Annotation> = []
    annots.push(Annotation { name: "mono_spec", args: empty_args })
    Stmt.Annotated(annots, fn_stmt)
}
/// Specialise a generic enum — mirror of `specialize_fn` but
/// for enum decls. Substitutes type params in every variant's
/// payload fields.
fn specialize_enum(mangled: string, variants: List<Variant>, ta: List<TypeArg>) -> Stmt {
    let empty_tp: List<TypeParamEntry> = []
    Stmt.EnumDecl(mangled, empty_tp, substitute_variants(variants, ta))
}
/// Specialise a generic struct — mirror of `specialize_fn`.
/// Substitutes type params in every field's declared type.
fn specialize_struct(mangled: string, fields: List<FieldEntry>, ta: List<TypeArg>) -> Stmt {
    let empty_tp: List<TypeParamEntry> = []
    Stmt.TypeDecl(mangled, empty_tp, substitute_fields(fields, ta))
}

/// Generate one specialised AST node for each fully-resolved
/// inst in `insts`. Calls `specialize_fn` / `specialize_enum`
/// / `specialize_struct` based on which registry the inst's
/// origin name lives in.
fn generate_specializations(insts: List<Inst>, regs: GenRegs) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        let name = e.orig_name
        let mangled = e.mangled
        let ta = e.type_args
        let fn_e = generic_fn_lookup(regs.fns, name)
        if fn_e != null {
            let fe = fn_e!
            out.push(sstmt(specialize_fn(mangled, fe.params, fe.ret_vt, fe.body, ta), 0, 0))
        } else {
            let enum_e = generic_enum_lookup(regs.enums, name)
            if enum_e != null {
                out.push(sstmt(specialize_enum(mangled, enum_e!.variants, ta), 0, 0))
            } else {
                let struct_e = generic_struct_lookup(regs.structs, name)
                if struct_e != null {
                    out.push(sstmt(specialize_struct(mangled, struct_e!.fields, ta), 0, 0))
                }
            }
        }
        i = i + 1
    }
    out
}

// ── Substitution ──

// Substitute type params in a ValueType (for monomorphization).
/// Substitute type-args into a single ValueType. Replaces
/// every `Struct(name)` placeholder whose name matches a
/// type-param with its concrete binding; recurses into
/// container types.
fn substitute_vtype(vt: ValueType, ta: List<TypeArg>) -> ValueType {
    match vt {
        .Struct(name, _) -> {
            let concrete = type_arg_lookup(ta, name)
            if !vtype_eq(concrete, vt) { concrete } else { vt }
        }
        .List(elem) -> ValueType.List(substitute_vtype(elem, ta))
        .Union(types) -> ValueType.Union(substitute_vtype_list(types, ta))
        .FnTyped(params, ret) -> ValueType.FnTyped(substitute_vtype_list(params, ta), substitute_vtype(ret, ta))
        .Newtype(name, inner, _) -> ValueType.Newtype(name, substitute_vtype(inner, ta), 0)
        .Enum(name, args, _) -> ValueType.Enum(name, substitute_vtype_list(args, ta), 0)
        .Tuple(elems) -> ValueType.Tuple(substitute_vtype_list(elems, ta))
        .Fn(ret) -> ValueType.Fn(substitute_vtype(ret, ta))
        .Closure(n, ret) -> ValueType.Closure(n, substitute_vtype(ret, ta))
        _ -> vt
    }
}

/// Map `substitute_vtype` over a `List<ValueType>`.
fn substitute_vtype_list(types: List<ValueType>, ta: List<TypeArg>) -> List<ValueType> {
    mut out: List<ValueType> = []
    mut i = 0
    while i < types.length {
        out.push(substitute_vtype(types[i], ta))
        i = i + 1
    }
    out
}

/// Substitute type-args into every param's declared type.
fn substitute_params(params: List<ParamEntry>, ta: List<TypeArg>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        let p = params[i]
        out.push(ParamEntry { name: p.name, vtype: substitute_vtype(p.vtype, ta) })
        i = i + 1
    }
    out
}
/// Substitute type-args into every field's declared type.
fn substitute_fields(fields: List<FieldEntry>, ta: List<TypeArg>) -> List<FieldEntry> {
    mut out: List<FieldEntry> = []
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        out.push(FieldEntry { name: e.name, resolved: substitute_vtype(e.resolved, ta) })
        i = i + 1
    }
    out
}
/// Substitute type-args into every variant's payload fields.
fn substitute_variants(variants: List<Variant>, ta: List<TypeArg>) -> List<Variant> {
    mut out: List<Variant> = []
    mut i = 0
    while i < variants.length {
        let v = variants[i]
        out.push(Variant { name: v.name, fields: substitute_fields(v.fields, ta) })
        i = i + 1
    }
    out
}
/// Map `substitute_stmt` over a List<SStmt>.
fn substitute_stmts(stmts: List<SStmt>, ta: List<TypeArg>) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        out.push(sstmt_at(substitute_stmt(ss.node, ta), ss.line, ss.col, ss.file))
        i = i + 1
    }
    out
}
/// Map `substitute_expr` over a `List<SExpr>`.
fn substitute_expr_list(exprs: List<SExpr>, ta: List<TypeArg>) -> List<SExpr> {
    mut out: List<SExpr> = []
    mut i = 0
    while i < exprs.length {
        let se = exprs[i]
        out.push(sexpr_at(substitute_expr(se.node, ta), se.line, se.col, se.file))
        i = i + 1
    }
    out
}

/// Substitute type-args into a single statement. Recurses into
/// expression payloads + nested bodies.
fn substitute_stmt(stmt: Stmt, ta: List<TypeArg>) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, substitute_vtype(vt, ta), substitute_expr(init, ta))
        .Mut(name, vt, init) -> .Mut(name, substitute_vtype(vt, ta), substitute_expr(init, ta))
        .Expr(e) -> .Expr(substitute_expr(e, ta))
        .Return(val) -> .Return(substitute_expr(val, ta))
        .ReturnEmpty -> stmt
        .Block(body) -> .Block(substitute_stmts(body, ta))
        .If(cond, then_b, else_b) -> {
            if else_b != null { .If(substitute_expr(cond, ta), substitute_stmt(then_b, ta), substitute_stmt(else_b!, ta)) }
            else { .If(substitute_expr(cond, ta), substitute_stmt(then_b, ta), null) }
        }
        .While(cond, body) -> .While(substitute_expr(cond, ta), substitute_stmt(body, ta))
        .For(v, s, e, body) -> .For(v, substitute_expr(s, ta), substitute_expr(e, ta), substitute_stmt(body, ta))
        .ForIn(v, coll, body) -> .ForIn(v, substitute_expr(coll, ta), substitute_stmt(body, ta))
        .Match(subj, arms) -> .Match(substitute_expr(subj, ta), substitute_match_arms(arms, ta))
        .Defer(body) -> .Defer(substitute_expr(body, ta))
        _ -> stmt
    }
}

/// Substitute type-args into a single expression. Recurses
/// into every compound shape; literals and idents are
/// untouched.
fn substitute_expr(expr: Expr, ta: List<TypeArg>) -> Expr {
    match expr {
        .Call(callee, a) -> .Call(substitute_expr(callee, ta), substitute_expr_list(a, ta))
        .GenericCall(callee, tn, a) -> .GenericCall(substitute_expr(callee, ta), tn, substitute_expr_list(a, ta))
        .Binary(l, op, r) -> .Binary(substitute_expr(l, ta), op, substitute_expr(r, ta))
        .Logical(l, op, r) -> .Logical(substitute_expr(l, ta), op, substitute_expr(r, ta))
        .Unary(op, e) -> .Unary(op, substitute_expr(e, ta))
        .Grouping(e) -> .Grouping(substitute_expr(e, ta))
        .Block(body) -> .Block(substitute_stmts(body, ta))
        .IfExpr(c, t, e) -> .IfExpr(substitute_expr(c, ta), substitute_expr(t, ta), substitute_expr(e, ta))
        .MatchExpr(subj, arms) -> .MatchExpr(substitute_expr(subj, ta), substitute_match_arms(arms, ta))
        .Index(obj, idx) -> .Index(substitute_expr(obj, ta), substitute_expr(idx, ta))
        .FieldAccess(obj, f) -> .FieldAccess(substitute_expr(obj, ta), f)
        .Assign(name, val) -> .Assign(name, substitute_expr(val, ta))
        .FieldAssign(obj, f, val) -> .FieldAssign(substitute_expr(obj, ta), f, substitute_expr(val, ta))
        .ListLit(elems) -> .ListLit(substitute_expr_list(elems, ta))
        .Tuple(elems) -> .Tuple(substitute_expr_list(elems, ta))
        .MapLit(entries) -> .MapLit(substitute_expr_list(entries, ta))
        .Lambda(params, body) -> .Lambda(substitute_params(params, ta), substitute_expr(body, ta))
        .NullCoalesce(l, r) -> .NullCoalesce(substitute_expr(l, ta), substitute_expr(r, ta))
        .Try(e) -> .Try(substitute_expr(e, ta))
        .With(obj, inits) -> .With(substitute_expr(obj, ta), inits)
        .ListComp(body, v, coll, filter) -> {
            if filter != null {
                .ListComp(substitute_expr(body, ta), v, substitute_expr(coll, ta), substitute_expr(filter!, ta))
            } else {
                .ListComp(substitute_expr(body, ta), v, substitute_expr(coll, ta), null)
            }
        }
        .Catch(inner, b, body, cl, cc) -> .Catch(substitute_expr(inner, ta), b, substitute_expr(body, ta), cl, cc)
        _ -> expr
    }
}

/// Map `substitute_expr` over each guard + body of a match
/// arm list. Patterns themselves don't carry types.
fn substitute_match_arms(arms: List<MatchArm>, ta: List<TypeArg>) -> List<MatchArm> {
    mut out: List<MatchArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let new_guard = if arm.guard != null {
            let g = arm.guard!
            sexpr_at(substitute_expr(g.node, ta), g.line, g.col, g.file)
        } else { null }
        let new_body = sexpr_at(substitute_expr(arm.body.node, ta), arm.body.line, arm.body.col, arm.body.file)
        out.push(MatchArm { pattern: arm.pattern, guard: new_guard, body: new_body })
        i = i + 1
    }
    out
}

// Scope the instantiation list for a function body based on its return type.
// When a function returns Result<EmitValue, string>, all Result enum ctors
// in its body must map to Result__EmitValue__string — not whichever Result
// instantiation happens to appear first in the global list.
/// Add per-fn return-type instantiations. Functions that
/// return `Result<T, E>` but only construct one variant need
/// the missing param inferred from the annotation — this
/// scopes the inference to that fn's own InstList.
fn scope_insts_for_ret(ret_ty: string, regs: GenRegs, insts: List<Inst>) -> List<Inst> {
    let angle = find_char(ret_ty, "<")
    if angle < 0 { return insts }
    let base = ret_ty.substring(0, angle)
    let args_str = ret_ty.substring(angle + 1, ret_ty.length - 1)
    mut tp: List<TypeParamEntry> = []
    let enum_e = generic_enum_lookup(regs.enums, base)
    if enum_e != null {
        tp = enum_e!.tp
    } else {
        let struct_e = generic_struct_lookup(regs.structs, base)
        if struct_e != null {
            tp = struct_e!.tp
        } else {
            return insts
        }
    }
    let ta = split_annotation_args(tp, args_str, regs, insts)
    let mangled = mangle_name_ordered(base, tp, ta)
    // Prepend the fresh scoped inst so subsequent merge/lookup
    // passes see it first — mirrors the cons-list head ordering
    // the old code relied on.
    let filtered = remove_insts_for(base, insts)
    mut out: List<Inst> = []
    out.push(Inst { orig_name: base, mangled, type_args: ta })
    mut i = 0
    while i < filtered.length {
        out.push(filtered[i])
        i = i + 1
    }
    out
}

/// Remove every entry from `insts` matching `name`. Used by
/// `scope_insts_for_ret` to swap out per-fn entries when
/// adopting a more-specific return-type-derived inst.
fn remove_insts_for(name: string, insts: List<Inst>) -> List<Inst> {
    mut out: List<Inst> = []
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        if e.orig_name != name { out.push(e) }
        i = i + 1
    }
    out
}

/// Parse a type-name string back into a ValueType. Used to
/// turn rewritten / mangled annotations back into structured
/// types for downstream codegen.
fn vtype_from_type_string(ty: string) -> ValueType {
    // Handle nullable "T?"
    if ty.ends_with("?") && ty.length > 1 {
        return vtype_from_type_string(ty.substring(0, ty.length - 1))
    }
    // Handle tuple type strings like "(int, string)" — produced by
    // `vtype_render_full(.Tuple(types))`. Without this, the round-
    // trip through mono's rewrite_fn_ret (which renders ValueType
    // to string and parses back) lands at `vtype_from_name` and
    // falls into `_ -> Struct(name, 0)`, corrupting the tuple
    // into a struct whose name is the tuple's text representation
    // ("(int, T)"). Downstream codegen then sees Struct and tries
    // to look it up — bs2 hits "method call / field access on
    // non-struct value" at the destructure site. Sibling of the
    // List<T> / Task<T> peel below.
    if ty.length >= 2 && ty.substring(0, 1) == "(" && ty.ends_with(")") {
        let inner = ty.substring(1, ty.length - 1)
        return ValueType.Tuple(parse_type_args_to_list(inner))
    }
    // Handle mangled names like "Result__int__string" — when `__` appears
    // BEFORE any `<`, the name is a monomorphized slug, not a generic
    // annotation. The earlier-position check matters because a nested
    // generic arg like `Result__List<int>__string` has BOTH separators;
    // the outer mangling (`__`) must win or we'd mis-parse the base as
    // "Result__List" and the args as "int>__string".
    let angle = find_char(ty, "<")
    let dunder = find_dunder(ty)
    if dunder >= 0 && (angle < 0 || dunder < angle) {
        let args = parse_dunder_args(ty, dunder + 2)
        return ValueType.Enum(ty, args, 0)
    }
    // Handle generic type strings like "Result<int, string>"
    if angle >= 0 {
        let base = ty.substring(0, angle)
        let args_str = ty.substring(angle + 1, ty.length - 1)
        let args = parse_type_args_to_list(args_str)
        // Mirror type_expr_to_vtype: List<T> and Task<T> have dedicated
        // ValueType variants. Without this, the round-trip through
        // vtype_render_full → vtype_from_type_string corrupts them into
        // ValueType.Enum("List", ...) which fails every downstream
        // List/Task type check (vtype_is_list, .length codegen, ...).
        // Tracked under forge-crafting-intepreters-gvq3.
        if base == "List" {
            let elem = if args.length > 0 { args[0] } else { ValueType.Unknown }
            return ValueType.List(elem)
        }
        if base == "Task" {
            let inner = if args.length > 0 { args[0] } else { ValueType.Unknown }
            return ValueType.Task(inner)
        }
        return ValueType.Enum(base, args, 0)
    }
    // Handle union types "A | B" — checked AFTER mangled names
    // so "Result__X__A|B" is treated as a mangled name, not a union
    let pipe = find_type_pipe(ty)
    if pipe >= 0 {
        let left = vtype_from_type_string(ty.substring(0, pipe).trim())
        let right = vtype_from_type_string(ty.substring(pipe + 1, ty.length).trim())
        return ValueType.Union(union_type_list_merge(left, right))
    }
    vtype_from_name(ty)
}

/// Locate the first `__` separator in a mangled name. Used to
/// split `Foo__Int__Bool` into base + type-arg slugs.
fn find_dunder(s: string) -> int { find_dunder_from(s, 0) }

/// Parse the `__`-separated type-arg slugs from a mangled name
/// into a `List<ValueType>`. Reverse of mangling — used when
/// rewriting mangled annotations back into ValueTypes.
fn parse_dunder_args(s: string, start: int) -> List<ValueType> {
    mut out: List<ValueType> = []
    mut pos = start
    while true {
        let next_dunder = find_dunder_from(s, pos)
        if next_dunder >= 0 {
            let arg = s.substring(pos, next_dunder)
            out.push(vtype_from_type_string(arg))
            pos = next_dunder + 2
        } else {
            let arg = s.substring(pos, s.length)
            out.push(vtype_from_type_string(arg))
            return out
        }
    }
    out
}

/// Find the next `__` boundary in `s` starting from `start`.
fn find_dunder_from(s: string, start: int) -> int {
    if start >= s.length - 1 { return -1 }
    mut idx = start
    while idx < s.length - 1 {
        if s.substring(idx, idx + 2) == "__" { return idx }
        idx = idx + 1
    }
    -1
}

/// Parse a comma-separated type-arg list (`"int, string"`) into a
/// `List<ValueType>`. Mirror of `split_annotation_args` for the
/// pre-rewrite path.
fn parse_type_args_to_list(args_str: string) -> List<ValueType> {
    mut out: List<ValueType> = []
    if args_str == "" { return out }
    mut rest = args_str
    while true {
        let comma = top_level_split_idx(rest)
        if comma >= 0 {
            let head = rest.substring(0, comma)
            out.push(vtype_from_type_string(head.trim()))
            rest = rest.substring(comma + 1, rest.length)
        } else {
            out.push(vtype_from_type_string(rest.trim()))
            return out
        }
    }
    out
}

/// Rewrite a fn's return-type annotation, replacing every
/// generic reference with its mangled specialisation.
fn rewrite_fn_ret(ret_ty: string, regs: GenRegs, insts: List<Inst>) -> ValueType {
    vtype_from_type_string(rewrite_type_name(ret_ty, regs, insts))
}

/// Rewrite an entire fn declaration: param types, return
/// type, body — all forwarded through `rewrite_*` helpers.
/// Used by the per-fn pass to convert generic decls into
/// non-generic ones referencing mangled specialisations.
fn rewrite_function(name: string, tp: List<TypeParamEntry>, params: List<ParamEntry>, ret_ty: string, body: List<SStmt>, regs: GenRegs, insts: List<Inst>) -> Stmt {
    let scoped = scope_insts_for_ret(ret_ty, regs, insts)
    Stmt.Function(name, tp, rewrite_param_types(params, regs, scoped), rewrite_fn_ret(ret_ty, regs, insts), rewrite_stmts(body, regs, scoped))
}

// ── Pass 4: Rewrite call sites and remove generic declarations ──

/// Map `rewrite_stmt` over a List<SStmt>.
fn rewrite_stmts(stmts: List<SStmt>, regs: GenRegs, insts: List<Inst>) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        if !is_generic_decl(ss.node) {
            out.push(sstmt_at(rewrite_stmt(ss.node, regs, insts), ss.line, ss.col, ss.file))
        }
        i = i + 1
    }
    out
}

/// Rewrite a `let`/`mut` binding's type annotation + init.
/// Used by `rewrite_stmt` so type annotations referencing
/// generic types pick up their mangled specialisations.
fn rewrite_let_binding(name: string, vt: ValueType, init: Expr, regs: GenRegs, insts: List<Inst>, is_mut: bool) -> Stmt {
    let rendered = vtype_render_full(vt)
    let rewritten = rewrite_type_name(rendered, regs, insts)
    let new_vt = if rewritten != rendered { vtype_from_type_string(rewritten) } else { vt }
    if is_mut {
        Stmt.Mut(name, new_vt, rewrite_expr(init, regs, insts))
    } else {
        Stmt.Let(name, new_vt, rewrite_expr(init, regs, insts))
    }
}

/// Per-statement rewrite. Recurses into expression payloads +
/// nested bodies; rewrites generic type references in any
/// annotation it touches.
fn rewrite_stmt(stmt: Stmt, regs: GenRegs, insts: List<Inst>) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> rewrite_let_binding(name, vt, init, regs, insts, false)
        .Mut(name, vt, init) -> rewrite_let_binding(name, vt, init, regs, insts, true)
        .Expr(e) -> .Expr(rewrite_expr(e, regs, insts))
        .Return(val) -> .Return(rewrite_expr(val, regs, insts))
        .Block(body) -> .Block(rewrite_stmts(body, regs, insts))
        .If(cond, then_b, else_b) -> {
            if else_b != null { .If(rewrite_expr(cond, regs, insts), rewrite_stmt(then_b, regs, insts), rewrite_stmt(else_b!, regs, insts)) }
            else { .If(rewrite_expr(cond, regs, insts), rewrite_stmt(then_b, regs, insts), null) }
        }
        .While(cond, body) -> .While(rewrite_expr(cond, regs, insts), rewrite_stmt(body, regs, insts))
        .For(v, s, e, body) -> .For(v, rewrite_expr(s, regs, insts), rewrite_expr(e, regs, insts), rewrite_stmt(body, regs, insts))
        .ForIn(v, coll, body) -> .ForIn(v, rewrite_expr(coll, regs, insts), rewrite_stmt(body, regs, insts))
        .Function(name, tp, params, ret_vt, body) -> rewrite_function(name, tp, params, vtype_render_full(ret_vt), body, regs, insts)
        .ExternFn(name, params, ret_vt) ->
            .ExternFn(name, rewrite_param_types(params, regs, insts), rewrite_fn_ret(vtype_render_full(ret_vt), regs, insts))
        .Match(subj, arms) -> .Match(rewrite_expr(subj, regs, insts), rewrite_arms(arms, regs, insts))
        .Module(name, body) -> .Module(name, rewrite_stmts(body, regs, insts))
        .Annotated(annots, inner) -> .Annotated(annots, rewrite_stmt(inner, regs, insts))
        .Impl(name, methods) -> .Impl(name, rewrite_stmts(methods, regs, insts))
        .Defer(body) -> .Defer(rewrite_expr(body, regs, insts))
        .Errdefer(body) -> .Errdefer(rewrite_expr(body, regs, insts))
        .SpecBlock(name, body) -> .SpecBlock(name, rewrite_stmts(body, regs, insts))
        .GivenBlock(name, body) -> .GivenBlock(name, rewrite_stmts(body, regs, insts))
        .ThenBlock(name, cond) -> .ThenBlock(name, rewrite_expr(cond, regs, insts))
        .Parallel(body) -> .Parallel(rewrite_stmts(body, regs, insts))
        .Select(arms) -> .Select(rewrite_select_arms_mono(arms, regs, insts))
        .Const(n, vt, init) -> .Const(n, vt, rewrite_expr(init, regs, insts))
        _ -> stmt
    }
}

/// Walk every `select` arm rewriting type references in the
/// channel + body.
fn rewrite_select_arms_mono(arms: List<SelectArm>, regs: GenRegs, insts: List<Inst>) -> List<SelectArm> {
    mut out: List<SelectArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        out.push(SelectArm {
            binding: arm.binding,
            channel: rewrite_expr(arm.channel, regs, insts),
            body: rewrite_stmts(arm.body, regs, insts),
        })
        i = i + 1
    }
    out
}

/// Per-expression rewrite. Calls + EnumCtors + StructLits
/// dispatch to dedicated helpers so their target names are
/// mangled correctly. Other shapes recurse over their payloads.
fn rewrite_expr(expr: Expr, regs: GenRegs, insts: List<Inst>) -> Expr {
    match expr {
        .Call(callee, args) -> {
            let new_args = rewrite_expr_list(args, regs, insts)
            let empty_ta: List<TypeArg> = []
            match callee {
                .Ident(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null {
                        let fe = fn_e!
                        Expr.Call(.Ident(mangle_name_ordered(name, fe.tp, infer_from_params(fe.tp, fe.params, args, empty_ta))), new_args)
                    } else {
                        Expr.Call(callee, new_args)
                    }
                }
                .QualifiedIdent(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null {
                        let fe = fn_e!
                        Expr.Call(.Ident(mangle_name_ordered(name, fe.tp, infer_from_params(fe.tp, fe.params, args, empty_ta))), new_args)
                    } else {
                        Expr.Call(callee, new_args)
                    }
                }
                _ -> Expr.Call(rewrite_expr(callee, regs, insts), new_args)
            }
        }
        .GenericCall(callee, type_names, args) -> {
            // Explicit type args — use them directly, no inference needed
            let new_args = rewrite_expr_list(args, regs, insts)
            match callee {
                .Ident(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null {
                        let fe = fn_e!
                        Expr.Call(.Ident(mangle_name_ordered(name, fe.tp, explicit_to_type_args(fe.tp, type_names))), new_args)
                    } else {
                        Expr.Call(callee, new_args)
                    }
                }
                .QualifiedIdent(name) -> {
                    let fn_e = generic_fn_lookup(regs.fns, name)
                    if fn_e != null {
                        let fe = fn_e!
                        Expr.Call(.Ident(mangle_name_ordered(name, fe.tp, explicit_to_type_args(fe.tp, type_names))), new_args)
                    } else {
                        Expr.Call(callee, new_args)
                    }
                }
                _ -> Expr.Call(rewrite_expr(callee, regs, insts), new_args)
            }
        }
        .EnumCtor(tn, variant, args) -> rewrite_enum_ctor(tn, variant, args, regs, insts)
        .StructLit(name, inits) -> rewrite_struct_lit(name, inits, regs, insts)
        .FieldAccess(obj, f) -> match obj {
            .Ident(ename) -> {
                if generic_enum_lookup(regs.enums, ename) != null {
                    Expr.FieldAccess(.Ident(inst_mangled(insts, ename)), f)
                } else {
                    Expr.FieldAccess(rewrite_expr(obj, regs, insts), f)
                }
            }
            // Module-qualified enum reference (resolver rewrote
            // `RgmList` → `mod::RgmList`). Same mangling logic.
            .QualifiedIdent(ename) -> {
                if generic_enum_lookup(regs.enums, ename) != null {
                    Expr.FieldAccess(.QualifiedIdent(inst_mangled(insts, ename)), f)
                } else {
                    Expr.FieldAccess(rewrite_expr(obj, regs, insts), f)
                }
            }
            _ -> Expr.FieldAccess(rewrite_expr(obj, regs, insts), f)
        }
        .Binary(l, op, r) -> .Binary(rewrite_expr(l, regs, insts), op, rewrite_expr(r, regs, insts))
        .Logical(l, op, r) -> .Logical(rewrite_expr(l, regs, insts), op, rewrite_expr(r, regs, insts))
        .Unary(op, e) -> .Unary(op, rewrite_expr(e, regs, insts))
        .Grouping(e) -> .Grouping(rewrite_expr(e, regs, insts))
        .Block(body) -> .Block(rewrite_stmts(body, regs, insts))
        .IfExpr(c, t, e) -> .IfExpr(rewrite_expr(c, regs, insts), rewrite_expr(t, regs, insts), rewrite_expr(e, regs, insts))
        .MatchExpr(subj, arms) -> .MatchExpr(rewrite_expr(subj, regs, insts), rewrite_arms(arms, regs, insts))
        .Index(obj, idx) -> .Index(rewrite_expr(obj, regs, insts), rewrite_expr(idx, regs, insts))
        .Assign(name, val) -> .Assign(name, rewrite_expr(val, regs, insts))
        .FieldAssign(obj, f, val) -> .FieldAssign(rewrite_expr(obj, regs, insts), f, rewrite_expr(val, regs, insts))
        .ListLit(elems) -> .ListLit(rewrite_expr_list(elems, regs, insts))
        .Tuple(elems) -> .Tuple(rewrite_expr_list(elems, regs, insts))
        .MapLit(entries) -> .MapLit(rewrite_expr_list(entries, regs, insts))
        .Lambda(params, body) -> .Lambda(params, rewrite_expr(body, regs, insts))
        .NullCoalesce(l, r) -> .NullCoalesce(rewrite_expr(l, regs, insts), rewrite_expr(r, regs, insts))
        .Try(e) -> .Try(rewrite_expr(e, regs, insts))
        .With(obj, overrides) -> .With(rewrite_expr(obj, regs, insts), rewrite_field_inits(overrides, regs, insts))
        .ListComp(body, v, coll, filter) -> {
            if filter != null {
                .ListComp(rewrite_expr(body, regs, insts), v, rewrite_expr(coll, regs, insts), rewrite_expr(filter!, regs, insts))
            } else {
                .ListComp(rewrite_expr(body, regs, insts), v, rewrite_expr(coll, regs, insts), null)
            }
        }
        .Catch(inner, b, body, cl, cc) -> .Catch(rewrite_expr(inner, regs, insts), b, rewrite_expr(body, regs, insts), cl, cc)
        _ -> expr
    }
}

/// Map `rewrite_expr` over a `List<SExpr>`.
fn rewrite_expr_list(exprs: List<SExpr>, regs: GenRegs, insts: List<Inst>) -> List<SExpr> {
    mut out: List<SExpr> = []
    mut i = 0
    while i < exprs.length {
        let se = exprs[i]
        out.push(sexpr_at(rewrite_expr(se.node, regs, insts), se.line, se.col, se.file))
        i = i + 1
    }
    out
}

/// Map `rewrite_expr` over each guard + body in a match-arm
/// list.
fn rewrite_arms(arms: List<MatchArm>, regs: GenRegs, insts: List<Inst>) -> List<MatchArm> {
    mut out: List<MatchArm> = []
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let new_guard = if arm.guard != null {
            let g = arm.guard!
            sexpr_at(rewrite_expr(g.node, regs, insts), g.line, g.col, g.file)
        } else { null }
        let new_body = sexpr_at(rewrite_expr(arm.body.node, regs, insts), arm.body.line, arm.body.col, arm.body.file)
        out.push(MatchArm { pattern: arm.pattern, guard: new_guard, body: new_body })
        i = i + 1
    }
    out
}

/// Map `rewrite_expr` over every value in a struct-literal /
/// `with` field-init list.
fn rewrite_field_inits(inits: List<FieldInit>, regs: GenRegs, insts: List<Inst>) -> List<FieldInit> {
    mut out: List<FieldInit> = []
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        let new_val = sexpr_at(rewrite_expr(init.value.node, regs, insts), init.value.line, init.value.col, init.value.file)
        out.push(FieldInit { name: init.name, value: new_val })
        i = i + 1
    }
    out
}

/// Compute the mangled enum name for a constructor call site
/// from its arg-inferred `List<TypeArg>`. Falls back to existing
/// inst entries when site-local inference can't fully resolve.
fn mangle_enum_at_site(tn: string, variant: string, tp: List<TypeParamEntry>, variants: List<Variant>, args: List<SExpr>, insts: List<Inst>) -> string {
    let partial = resolve_enum_type_args(tp, variants, variant, args)
    let result = inst_mangled_compatible(insts, tn, partial)
    // If compatible match failed (returned raw name), fall back to any entry
    // for this generic. Better to use a potentially wrong instantiation than
    // leave the name unmangled (which causes "undefined enum type" errors).
    if result == tn { inst_mangled(insts, tn) } else { result }
}

/// Rewrite an `EnumCtor(Tn, Variant, args)` site, replacing
/// the type name with the mangled specialisation that matches
/// the inferred type-args.
fn rewrite_enum_ctor(tn: string, variant: string, args: List<SExpr>, regs: GenRegs, insts: List<Inst>) -> Expr {
    let new_args = rewrite_expr_list(args, regs, insts)
    let e = generic_enum_lookup(regs.enums, tn)
    if e == null { return Expr.EnumCtor(tn, variant, new_args) }
    let entry = e!
    Expr.EnumCtor(mangle_enum_at_site(tn, variant, entry.tp, entry.variants, args, insts), variant, new_args)
}

/// Variant of `inst_mangled` that prefers the inst whose
/// type-args are compatible with the call site's partial
/// inference. Lets multi-instantiation enums (e.g. `Result`)
/// resolve to the right specialisation per call.
fn inst_mangled_compatible(insts: List<Inst>, name: string, partial: List<TypeArg>) -> string {
    mut i = 0
    while i < insts.length {
        let e = insts[i]
        if e.orig_name == name && type_args_compatible(e.type_args, partial) { return e.mangled }
        i = i + 1
    }
    name
}

/// Rewrite a `StructLit(name, inits)` site, replacing the
/// struct name with its mangled specialisation. Recurses
/// through every initialiser to rewrite nested generic refs.
fn rewrite_struct_lit(name: string, inits: List<FieldInit>, regs: GenRegs, insts: List<Inst>) -> Expr {
    let new_inits = rewrite_field_inits(inits, regs, insts)
    let e = generic_struct_lookup(regs.structs, name)
    if e == null { return Expr.StructLit(name, new_inits) }
    let entry = e!
    let empty_ta: List<TypeArg> = []
    Expr.StructLit(mangle_name_ordered(name, entry.tp, infer_from_field_inits(entry.tp, entry.fields, inits, empty_ta)), new_inits)
}

// ── Entry point ──

/// Public output of `monomorphize`. The rewritten program's
/// AST plus any diagnostics raised during the pass.
///
/// @field stmts — the program with generics specialised away.
/// @field bag   — diagnostics accumulated during monomorphization.
export type MonoResult = { stmts: List<SStmt>, bag: DiagnosticBag }

/// Public entry: run the monomorphization pass over a
/// program. Phase 1 collects generic decls + instantiation
/// requests; phase 2 generates specialised AST nodes; phase 3
/// rewrites every reference to use the mangled names. Iterates
/// to a fixed point so transitively-required specialisations
/// are pulled in.
export fn monomorphize(stmts: List<SStmt>, trait_impls: List<TraitImplEntry>) -> MonoResult {
    let regs = collect_generics(stmts, GenRegs { fns: [], enums: [], structs: [] })
    if !has_generics(regs) { return MonoResult { stmts, bag: bag_new() } }

    // Pass 2: collect partial type args (enums merge across constructors)
    let collected = collect_inst_stmts(stmts, regs, CollectState { insts: [], bag: bag_new(), line: 0, col: 0, trait_impls })
    if bag_has_errors(collected.bag) {
        return MonoResult { stmts, bag: collected.bag }
    }

    // Merge partial entries across function scopes before finalizing.
    let merged = merge_across_scopes(collected.insts)
    let finalized = finalize_insts(merged, regs, collected.bag, trait_impls)
    if bag_has_errors(finalized.bag) {
        return MonoResult { stmts, bag: finalized.bag }
    }

    // Transitive monomorphization: specializations may contain nested
    // generic calls. Converge by recursively collecting + generating
    // until no new instantiations are found.
    let initial_specs = generate_specializations(finalized.insts, regs)
    let converged = mono_converge(initial_specs, regs, finalized.insts, initial_specs, finalized.bag, 0, trait_impls)

    let rewritten = rewrite_stmts(stmts, regs, converged.all_insts)
    let rewritten_specs = rewrite_stmts(converged.all_specs, regs, converged.all_insts)
    MonoResult { stmts: prepend_stmts(rewritten_specs, rewritten), bag: converged.bag }
}

/// Per-iteration output of `mono_converge`. Carries the
/// running inst list + accumulated specialisations + diagnostics.
///
/// @field all_insts — every inst seen across iterations.
/// @field all_specs — every emitted specialisation AST node.
/// @field bag       — accumulated diagnostics.
type ConvergeResult = { all_insts: List<Inst>, all_specs: List<SStmt>, bag: DiagnosticBag }

/// Iteration step of the monomorphization fixed-point. Walks
/// the freshly-emitted specialisations looking for further
/// instantiations they need; recurses until no new insts get
/// added. `depth` is bounded to prevent runaway recursion.
fn mono_converge(new_specs: List<SStmt>, regs: GenRegs, all_insts: List<Inst>, all_specs: List<SStmt>, b: DiagnosticBag, depth: int, ti: List<TraitImplEntry>) -> ConvergeResult {
    if depth >= 10 { return ConvergeResult { all_insts, all_specs, bag: b } }
    let trans = collect_inst_stmts(new_specs, regs, CollectState { insts: [], bag: b, line: 0, col: 0, trait_impls: ti })
    let trans_final = finalize_insts(trans.insts, regs, trans.bag, ti)
    let new_count = inst_list_len(trans_final.insts)
    if new_count == 0 {
        ConvergeResult { all_insts, all_specs, bag: trans_final.bag }
    } else {
        let next_specs = generate_specializations(trans_final.insts, regs)
        let merged_insts = append_insts(trans_final.insts, all_insts)
        let merged_all_specs = prepend_stmts(next_specs, all_specs)
        mono_converge(next_specs, regs, merged_insts, merged_all_specs, trans_final.bag, depth + 1, ti)
    }
}

/// Concatenate two List<SStmt>s. Specialisations get prepended to
/// the original program so generated decls precede their uses.
fn prepend_stmts(prefix: List<SStmt>, rest: List<SStmt>) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < prefix.length {
        out.push(prefix[i])
        i = i + 1
    }
    mut j = 0
    while j < rest.length {
        out.push(rest[j])
        j = j + 1
    }
    out
}
