// WHY: parsing for generic type parameters and explicit type arguments.
// parse_type_params: called from fn_decl/struct_decl/enum_decl for `<T, U>` declarations.
// try_parse_generic_call: called from the postfix loop for `f<int, string>(x)` calls.

use core.{TypeParamEntry, Expr, Tk}
use parse.{Parser}

impl Parser {
    // Parse type parameters in declarations: `<T>`, `<A, B>`, `<T: Display>`.
    fn parse_type_params(self) -> List<TypeParamEntry> {
        self.advance()  // consume `<`
        let result = self.parse_type_param_entries()
        if !self.consume(Tk.Greater, "expected `>` after type parameters") {
            let empty: List<TypeParamEntry> = []
            return empty
        }
        result
    }

    fn parse_type_param_entries(self) -> List<TypeParamEntry> {
        mut out: List<TypeParamEntry> = []
        if self.check(Tk.Greater) { return out }
        if !self.check(Tk.Identifier) {
            self.set_error("expected type parameter name")
            return out
        }
        mut continue_parsing = true
        while continue_parsing {
            let name = self.current_lexeme
            self.advance()
            let bounds = if self.check(Tk.Colon) {
                self.advance()
                if !self.check(Tk.Identifier) {
                    self.set_error("expected trait bound after `:`")
                    return out
                }
                let b = self.current_lexeme
                self.advance()
                b
            } else { "" }
            out.push(TypeParamEntry { name: name, bounds: bounds })
            if !self.check(Tk.Comma) {
                continue_parsing = false
            } else {
                self.advance()
                if !self.check(Tk.Identifier) {
                    self.set_error("expected type parameter name")
                    return out
                }
            }
        }
        out
    }

    // Speculatively try to parse `<type, type, ...>(args)` as a generic call.
    // Returns the GenericCall expr if successful, null if not a generic call
    // (parser state is restored on failure).
    fn try_parse_generic_call(self, callee: Expr) -> Expr? {
        let saved = self.save_state()

        self.advance()  // consume `<`
        let type_args = self.parse_type_name_list()

        if !self.check(Tk.Greater) {
            self.restore_state(saved)
            return null
        }
        self.advance()  // consume `>`

        if !self.check(Tk.LeftParen) {
            self.restore_state(saved)
            return null
        }
        self.advance()  // consume `(`

        let args = self.parse_arg_list()
        if args == null {
            self.restore_state(saved)
            return null
        }
        if !self.consume(Tk.RightParen, "expected `)` after arguments") {
            self.restore_state(saved)
            return null
        }

        Expr.GenericCall(callee, type_args, args!)
    }

    fn parse_type_name_list(self) -> List<string> {
        mut out: List<string> = []
        if self.check(Tk.Greater) { return out }
        if !self.check(Tk.Identifier) && !self.check(Tk.KwFn) { return out }
        out.push(self.current_lexeme)
        self.advance()
        while self.check(Tk.Comma) {
            self.advance()
            if !self.check(Tk.Identifier) && !self.check(Tk.KwFn) { return out }
            out.push(self.current_lexeme)
            self.advance()
        }
        out
    }
}
