// WHY: regression for a cross-module monomorphization mangle collision. Two
// modules each declaring a generic with the SAME short name but a DIFFERENT
// layout (`Box<V> = { items }` vs `Box<T> = { val }`), both instantiated at
// `Box<int>`, used to mangle to one flat name `Box__int` (the module qualifier
// was stripped). Codegen then registered a single struct under that name and
// the other module's field access resolved against the wrong layout — a hard
// `codegen error: unknown field` whenever both modules compiled in one unit
// (a bundled test shard, or a program that `mod`s both). The monomorphizer now
// qualifies a short name shared across modules (`xmgc_box_a__Box__int` vs
// `xmgc_box_b__Box__int`), so each instance keeps its own layout. Collision-free
// programs mangle by short name exactly as before (byte-identical IR), so the
// fix is exercised here through a genuine multi-module fixture compiled as one
// unit via `mod`/`use` — the form a real program hits.
//
// Covers all three faces of the same collision:
//   - generic STRUCTS (`Box` field access),
//   - generic FNS (`which<T>` mangles through the same path → `which__int`),
//   - a NESTED generic arg (`Wrapper<Box<int>>`), whose slug must keep its type
//     args even after the base is module-flattened (`a__Box__int`, not `a__Box`).

use @std.avrac.test_runner.{write_fixture, write_fixture_and_run}

spec "cross-module generic mangle collision" {
    then "same-named generics in different modules each keep their own identity" {
        // Sibling module files live next to the main fixture; `mod` is
        // file-based (the module name is the file's basename), so both are
        // pulled into main's compilation unit and monomorphized together.
        write_fixture("/tmp/xmgc_box_a.av",
            "export type Box<V> = { items: List<V> }\n" +
            "export type Wrapper<T> = { inner: T }\n" +
            "export fn mk_a() -> Box<int> { Box { items: [1, 2, 3] } }\n" +
            "export fn count_items(b: Box<int>) -> int { b.items.length }\n" +
            // a generic fn whose short name also exists in module B
            "export fn which<T>(x: T) -> int { 1 }\n" +
            "export fn call_which_a() -> int { which(5) }\n" +
            // a NESTED generic arg: Wrapper<Box<int>> exercises mangle_slug_named,
            // whose slug must stay `Wrapper__xmgc_box_a__Box__int` (args kept)
            // and not collapse to `Wrapper__xmgc_box_a__Box`.
            "export fn wrapped_count() -> int { let w: Wrapper<Box<int>> = Wrapper { inner: mk_a() }  w.inner.items.length }\n")
        write_fixture("/tmp/xmgc_box_b.av",
            "export type Box<T> = { val: T }\n" +
            "export fn mk_b() -> Box<int> { Box { val: 7 } }\n" +
            "export fn get_val(b: Box<int>) -> int { b.val }\n" +
            "export fn which<T>(x: T) -> int { 2 }\n" +
            "export fn call_which_b() -> int { which(5) }\n")
        let out = write_fixture_and_run("/tmp/xmgc_main.av",
            "mod xmgc_box_a\n" +
            "mod xmgc_box_b\n" +
            "use xmgc_box_a.{mk_a, count_items, call_which_a, wrapped_count}\n" +
            "use xmgc_box_b.{mk_b, get_val, call_which_b}\n" +
            "fn main() {\n" +
            "    println(\"a=\" + string(count_items(mk_a())))\n" +     // struct A: {items} → 3
            "    println(\"b=\" + string(get_val(mk_b())))\n" +         // struct B: {val} → 7
            "    println(\"wa=\" + string(call_which_a()))\n" +         // fn A → 1
            "    println(\"wb=\" + string(call_which_b()))\n" +         // fn B → 2
            "    println(\"wc=\" + string(wrapped_count()))\n" +        // nested Wrapper<Box<int>> → 3
            "}\n")
        // Pre-fix, the shared `Box__int` / `which__int` mangle made one decl
        // shadow the other (wrong layout → `unknown field`, or wrong fn body).
        out.contains("a=3") && out.contains("b=7")
            && out.contains("wa=1") && out.contains("wb=2")
            && out.contains("wc=3")
            && !out.contains("unknown field") && !out.contains("F9999")
    }
}
