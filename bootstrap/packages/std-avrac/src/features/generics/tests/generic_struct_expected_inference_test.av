// WHY: regression for forge-crafting-intepreters-qcvb — a generic struct
// whose type params CAN'T be pinned down from its field initializers must
// still construct when the EXPECTED type (a `let`/return annotation) supplies
// them. Two cases the literal alone can't solve:
//   * a PHANTOM param — appears in no field (only in method sigs / as a
//     newtype-style tag), so no initializer can ever bind it;
//   * an EMPTY-COLLECTION field — `nodes: []` carries no element type, so the
//     param behind `List<N>` stays Unknown.
// Before the fix both raised `F1002: cannot infer type parameter`, which
// blocked expressing the L1 single generic `Arena<N, Id>` / `DenseTable<Id, V>`
// (ps3t.3.6 / agcv).
//
// Root cause in features/generics/mono.av: struct-literal inference
// (try_add_struct_inst / rewrite_struct_lit) only unified each field's
// declared type against its initializer — it never looked at the construction's
// expected type. The fix threads `expected` through the SAME two-pass channel
// the fn-side already uses for return-position type params (so07.7.16):
// collect_inst_expr_with_expected + rewrite_expr_with_expected now have a
// `.StructLit` arm that unifies the struct's own `Name<tp…>` against the
// annotation (infer_from_field_inits_with_expected). Both passes share the
// worker, so the mangled name matches the registered instantiation.
//
// These `then` blocks run the constructed values, so a regression fails at
// compile time (F1002 returns) OR at runtime (a wrong field value), never
// silently.

// A param behind an empty-collection field (N) AND a phantom param (Id, in no
// field) — the exact shape of the L1 arena that motivated qcvb.
type EiArena<N, Id> = { nodes: List<N>, count: int }

// Phantom param used in a method signature: `first_or` makes `V` load-bearing
// while `Id` appears in no field — the canonical "wholly uninferrable from the
// literal" param.
type EiTab<Id, V> = { vals: List<V>, n: int }
impl EiTab<Id, V> {
    fn first_or(self, d: V) -> V {
        if self.vals.length > 0 { self.vals[0] } else { d }
    }
}

// A param fully determined by a NON-empty field — the no-annotation path that
// must keep working. Constructed in normal fn context (below) where the
// annotate pass populates each initializer's type.
type EiBox<T> = { val: T }

// The real L1 shape: the phantom param is a NEWTYPE (`ExprId = int`), nominally
// distinct from StmtId/PatId. The annotation must bind the phantom to the
// newtype itself — this is exactly `DenseTable<ExprId, V>`, the construction
// ps3t.3.6 needs.
type EiNodeId = int

// Two params, BOTH behind empty-collection fields, so NEITHER can bind from the
// literal — the annotation must supply both, positionally (A→xs, B→ys). The
// `first_x_or` method is typed by A: a positional swap (B landing in A's slot)
// would make it take `string`, so `first_x_or(7)` would fail to type-check —
// turning a mis-ordered unify into a loud compile error rather than a silent
// mismatch.
type EiPair<A, B> = { xs: List<A>, ys: List<B> }
impl EiPair<A, B> {
    fn first_x_or(self, d: A) -> A {
        if self.xs.length > 0 { self.xs[0] } else { d }
    }
}

// Return-position annotation: the tail expression is a bare struct literal
// whose params come only from the declared return type.
fn ei_make_arena() -> EiArena<int, string> {
    EiArena { nodes: [], count: 42 }
}

fn ei_make_tab() -> EiTab<int, string> {
    EiTab { vals: [], n: 0 }
}

// No annotation anywhere — T binds purely from the non-empty initializer. This
// is the pre-existing field-inference path; it must not regress. (Done in a
// normal fn, not a `then` block, because spec-body initializers aren't
// type-annotated — the annotation-free path needs the annotate pass.)
fn ei_box_from_field() -> int {
    let b = EiBox { val: 9 }
    b.val
}

spec "generic struct infers type params from the expected type" {
    given "an empty-collection field plus a phantom param" {
        then "a let annotation drives construction (empty field, phantom Id)" {
            let a: EiArena<int, int> = EiArena { nodes: [], count: 7 }
            a.count == 7 && a.nodes.length == 0
        }
        then "distinct phantom and value params both bind from the annotation" {
            let t: EiTab<int, string> = EiTab { vals: [], n: 5 }
            t.n == 5 && t.vals.length == 0
        }
    }
    given "a return-type annotation" {
        then "the tail struct literal binds params from the return type" {
            let a = ei_make_arena()
            a.count == 42 && a.nodes.length == 0
        }
        then "a phantom-param struct returns from an annotated fn" {
            let t = ei_make_tab()
            t.n == 0 && t.vals.length == 0
        }
    }
    given "the annotation-free field-inference path" {
        then "a non-empty field still infers WITHOUT an annotation (no regression)" {
            ei_box_from_field() == 9
        }
    }
    given "a phantom param exercised through a method" {
        then "the method body type-checks and runs on the inferred instance" {
            let t: EiTab<int, string> = EiTab { vals: ["a", "b"], n: 2 }
            t.first_or("z") == "a"
        }
        then "the same instance falls back when the collection is empty" {
            let t: EiTab<int, string> = EiTab { vals: [], n: 0 }
            t.first_or("z") == "z"
        }
    }
    given "a newtype as the phantom param (the DenseTable<ExprId, V> shape)" {
        then "the annotation binds the phantom to the newtype, not just a primitive" {
            let t: EiTab<EiNodeId, string> = EiTab { vals: [], n: 9 }
            t.n == 9 && t.vals.length == 0
        }
    }
    given "a mut binding and two params both supplied by the annotation" {
        then "a mut binding threads its annotation exactly like let (collect .Mut arm)" {
            mut a: EiArena<int, int> = EiArena { nodes: [], count: 3 }
            a.count = a.count + 1
            a.count == 4 && a.nodes.length == 0
        }
        then "two empty-collection params bind positionally from the annotation" {
            let p: EiPair<int, string> = EiPair { xs: [], ys: [] }
            p.first_x_or(7) == 7 && p.ys.length == 0
        }
    }
}

// Precision guard: the expected-type channel may only RESOLVE a real
// annotation — it must never paper over a genuinely unconstrained param. With
// NO annotation, a phantom (or empty-collection-only) param must STILL fail
// F1002. This locks in the `vtype_is_unknown(expected)` short-circuit; deleting
// it would silently start accepting un-inferrable constructions.
extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

// Shell out to a fresh bs2 so the construction is compiled in a child process
// whose failure we can observe: capture its combined output and assert on the
// rendered F-code. `|| true` keeps the non-zero compile exit from aborting the
// capture. (The `fn main` in each fixture lives inside a string literal, so the
// discovery classifier — which only flags a top-level `fn` *token* — never sees
// it; no need to obfuscate the entry point.)
fn ei_compile_out(source: string) -> string {
    let path = "/tmp/avra_ei_phantom_neg.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 compile '${path}' 2>&1 || true")
}

spec "an unconstrained phantom param without an annotation still errors" {
    then "no annotation + empty field + phantom Id is F1002" {
        let out = ei_compile_out("type Arena<N, Id> = { nodes: List<N>, count: int }
fn main() { let a = Arena { nodes: [], count: 7 } }")
        out.contains("F1002") && out.contains("Id")
    }
    then "the SAME construction with an annotation compiles (positive control)" {
        let out = ei_compile_out("type Arena<N, Id> = { nodes: List<N>, count: int }
fn main() { let a: Arena<int, int> = Arena { nodes: [], count: 7 } }")
        !out.contains("F1002")
    }
}

// Memory-safety guard: the expected-type channel resolves params the FIELDS
// can't, but it must never OVERRIDE a param a field bound concretely. An
// annotation whose generic arg is layout-incompatible with a field's value
// (`Box<string>` with an `int` field) is an invalid program — it must be a clean
// F1000, NOT a construction that stamps the int field as a string/ptr slot and
// stores `9` as a wild `inttoptr` pointer (the regression this locks out).
spec "a generic-struct annotation that conflicts with a field type is rejected" {
    then "Box<string> with an int field is F1000, not a wild-pointer store" {
        let out = ei_compile_out("type Box<T> = { val: T }
fn main() { let b: Box<string> = Box { val: 9 } }")
        out.contains("F1000")
    }
    then "the layout-matching annotation Box<int> still compiles (positive control)" {
        let out = ei_compile_out("type Box<T> = { val: T }
fn main() { let b: Box<int> = Box { val: 9 } }")
        !out.contains("F1000")
    }
}
