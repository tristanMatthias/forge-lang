// WHY: regression spec for generic-ENUM impl-method monomorphization (nofy).
//
// `generate_specializations` (features/generics/mono.av) emits a specialised
// `MangledType__method` for every method of every impl targeting a generic
// instantiation — but the ENUM branch only specialised the enum's VARIANTS and
// skipped its impl methods (the `specialize_impl_methods` call the STRUCT branch
// already made). So calling ANY method on a generic-enum value — `e.is_full()`,
// `e.unwrap_or(d)` — failed codegen with `undefined method EnumName__int.method`:
// the monomorphized owner resolved, but the method body was never generated.
//
// The fix makes the enum branch symmetric with the struct branch (one shared
// `specialize_impl_methods` call), so a generic-enum method dispatches exactly
// like a generic-struct method.
//
// Covered: both arms of a multi-variant enum; a method returning the bound type
// param `T` (payload extraction); the non-local receiver positions a value can
// hold a generic enum in (param / let / struct field); a two-type-param generic
// enum; and two distinct instantiations of the same enum (int + string payload),
// proving per-instantiation method emission rather than a single shared body.
// Plus an IR check that the generic enum impl is DROPPED from the rewrite pass
// (`is_generic_impl`) so only the specialised `EBox__int__method` is emitted —
// not a stray unspecialised `EBox__method` strong symbol that bloats the output
// and can collide across files in a bundled shard.

use @std.avrac.core.{avra_shell_exec, avra_selfhost_write_file}

// Multi-variant generic enum: one method matches both arms (bool), the other
// returns the bound type param T (extracts the payload, the harder path).
enum Holder<T> {
    Empty,
    Full(value: T),
}
impl Holder<T> {
    fn is_full(self) -> bool {
        match self {
            .Empty -> false
            .Full(value) -> true
        }
    }
    fn unwrap_or(self, d: T) -> T {
        match self {
            .Empty -> d
            .Full(value) -> value
        }
    }
}

// Two type params: the method must mangle BOTH into the owner slug and still
// dispatch (Either<int, string> -> Either__int__string__is_left).
enum Either<A, B> {
    Left(a: A),
    Right(b: B),
}
impl Either<A, B> {
    fn is_left(self) -> bool {
        match self {
            .Left(a) -> true
            .Right(b) -> false
        }
    }
}

// Non-local receiver positions: a param, and a generic enum reached through a
// struct field. (The let-bound case is exercised inline in a `then` below.)
fn full_via_param(h: Holder<int>) -> int { h.unwrap_or(-1) }
fn is_full_via_param(h: Holder<int>) -> bool { h.is_full() }
type FieldHolder = { h: Holder<int> }
fn full_via_field(fh: FieldHolder) -> int { fh.h.unwrap_or(-1) }
fn either_is_left(e: Either<int, string>) -> bool { e.is_left() }

spec "generic enum methods dispatch on non-local receivers" {
    then "bool method, Full arm, param receiver" {
        is_full_via_param(Holder.Full(7)) == true
    }
    then "bool method, Empty arm, param receiver" {
        is_full_via_param(Holder.Empty) == false
    }
    then "type-param return extracts the wrapped value, param receiver" {
        full_via_param(Holder.Full(7)) == 7
    }
    then "type-param return falls back to the default on Empty" {
        full_via_param(Holder.Empty) == -1
    }
    then "method on a LET-bound generic enum" {
        let h = Holder.Full(9)
        h.unwrap_or(0) == 9
    }
    then "method on a generic enum reached through a struct field" {
        full_via_field(FieldHolder { h: Holder.Full(5) }) == 5
    }
    then "two-type-param generic enum method dispatches, Left" {
        either_is_left(Either.Left(3)) == true
    }
    then "two-type-param generic enum method dispatches, Right" {
        either_is_left(Either.Right("x")) == false
    }
}

// Combinatorial: a generic-enum method exercised alongside the constructs it
// must compose with. Each case here is one a generic STRUCT method already
// handles — these assert the enum reaches the same parity.
fn opt_describe(o: Holder<int>) -> int { if o.is_full() { 1 } else { 0 } }

spec "generic enum methods compose with the rest of the language" {
    then "a method calling ANOTHER method on self dispatches both" {
        // is_full() is itself a specialised method; calling it from a second
        // method proves intra-instantiation method-to-method dispatch works.
        opt_describe(Holder.Full(1)) == 1 && opt_describe(Holder.Empty) == 0
    }
    then "a method on an element of a List<generic-enum>" {
        let xs = [Holder.Full(1), Holder.Full(2)]
        xs[0].unwrap_or(0) + xs[1].unwrap_or(0) == 3
    }
    then "the method result flows through an if-expr and a normal match" {
        let h = Holder.Full(8)
        let viaif = if h.is_full() { h.unwrap_or(0) } else { -1 }
        let viamatch = match h { .Empty -> -1  .Full(v) -> v }
        viaif == 8 && viamatch == 8
    }
}

spec "generic enum methods are emitted per instantiation" {
    // A SECOND instantiation of the same enum (string/ptr payload) must get its
    // OWN specialised method body — proves the emission is per-inst, not one
    // shared body, and that a pointer-typed payload round-trips through the
    // specialised `match self`.
    then "a string-payload instantiation extracts its pointer value" {
        let hs = Holder.Full("hi")
        hs.unwrap_or("?") == "hi"
    }
    then "the same string instantiation falls back to its default" {
        // Reached via Full (so T=string is inferred from the payload, not an
        // annotation) but compared against the default arm's value to show the
        // ptr-typed default also round-trips.
        let hs2 = Holder.Full("a")
        hs2.unwrap_or("def") == "a"
    }
}

// Build a tiny generic-enum-method program and return its emitted IR. The
// generic `impl EBox<T>` must be DROPPED from the rewrite pass (is_generic_impl
// now matches enums, not just structs), so codegen sees ONLY the per-instance
// `EBox__int__is_wrap` — never the un-specialised `EBox__is_wrap`, whose `self`
// is the bare generic enum that never gets a concrete layout (a stray, unused
// strong symbol that bloats output and can collide across bundled files).
fn ge_emitted_ir() -> string {
    let fixture = "build/_ge_stray_fixture.av"
    let src = "enum EBox<T> { Wrap(value: T) }\n" +
        "impl EBox<T> { fn is_wrap(self) -> bool { match self { .Wrap(value) -> true } } }\n" +
        "fn f(b: EBox<int>) -> bool { b.is_wrap() }\n" +
        "fn main() { let x = f(EBox.Wrap(5)) }\n"
    let _ = avra_selfhost_write_file(fixture, src)
    let _ = avra_shell_exec("./build/bs2 build ${fixture} 2>&1")
    avra_shell_exec("cat ${fixture}.ll 2>&1")
}

spec "a generic enum impl is dropped from the rewrite pass — no stray unspecialised method" {
    then "the specialised per-instance method is emitted" {
        ge_emitted_ir().contains("EBox__int__is_wrap")
    }
    then "the un-specialised generic-enum method is NOT emitted" {
        // `@EBox__is_wrap(` is the bare-generic symbol; it must be absent. (It is
        // not a substring of `@EBox__int__is_wrap(`, so this distinguishes them.)
        let ir = ge_emitted_ir()
        ir.contains("EBox__int__is_wrap") && !ir.contains("@EBox__is_wrap(")
    }
}
