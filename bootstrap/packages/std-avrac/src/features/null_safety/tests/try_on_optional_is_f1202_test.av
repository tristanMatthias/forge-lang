// WHY: the `?`-split (spec Axis 10 §1.3) — `?` should be Result-only, and
// applying it to an optional `T?` is reserved as F1202
// (DiagCode.TryOnOptional, already wired in diagnostics + check_try). The
// GATE is currently DEFERRED until the @comptime Value→AST decoder in
// features/eval/mod.av migrates off `?`-on-optional to `Result`; until then
// `?` on a `T?` stays permissive. This test pins the current contract and the
// always-valid Result behaviour, and is flipped to assert F1202 when the gate
// turns on.

use @std.avrac.test_runner.{write_fixture}
use @std.avrac.core.{avra_shell_exec}

spec "`?`-split contract (gate deferred)" {
    then "`?` on a Result is accepted (no F1202)" {
        let fixture = "/tmp/avra_null_try_on_result_test.av"
        write_fixture(fixture,
            "fn fallible(x: int) -> Result<int, string> {\n" +
            "    if x > 0 { return .Ok(x) }\n" +
            "    .Err(\"neg\")\n" +
            "}\n" +
            "fn use_it(x: int) -> Result<int, string> {\n" +
            "    let v = fallible(x)?\n" +
            "    .Ok(v)\n" +
            "}\n" +
            "fn main() -> int { 0 }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        !out.contains("F1202")
    }
}
