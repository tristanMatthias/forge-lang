// WHY: the `?`-split (spec Axis 10 §1.3) — `?` is Result-only. Applying `?`
// to a `T?` optional is F1202 (DiagCode.TryOnOptional). The gate is ENABLED:
// the recursive-descent parser and the @comptime Value->AST decoder/folder
// were migrated off `?`-on-optional (to `Result` / `match`+`!`) so the whole
// compiler self-hosts with the gate on. This test pins both halves of the
// split: `?` on Result is accepted, `?` on an optional is rejected as F1202.

use @std.avrac.test_runner.{write_fixture}
use @std.avrac.core.{avra_shell_exec}

spec "`?`-split: `?` is Result-only (F1202 on optional)" {
    then "`?` on a Result is accepted (no F1202)" {
        let fixture = "/tmp/avra_null_try_on_result_test.av"
        write_fixture(fixture,
            "fn fallible(x: int) -> Result<int, string> {\n" +
            "    if x > 0 { return .Ok(x) }\n" +
            "    .Err(\"neg\")\n" +
            "}\n" +
            "fn use_it(x: int) -> Result<int, string> {\n" +
            "    let v = fallible(x)?\n" +
            "    .Ok(v)\n" +
            "}\n" +
            "fn main() -> int { 0 }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        !out.contains("F1202")
    }
    then "`?` on an optional `T?` is rejected with F1202" {
        let fixture = "/tmp/avra_null_try_on_optional_test.av"
        write_fixture(fixture,
            "fn maybe(x: int) -> int? {\n" +
            "    if x > 0 { return x }\n" +
            "    null\n" +
            "}\n" +
            "fn use_it(x: int) -> int? {\n" +
            "    let v = maybe(x)?\n" +
            "    v\n" +
            "}\n" +
            "fn main() -> int { 0 }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        out.contains("F1202")
    }
}
