// WHY: the `?`-split (spec Axis 10 §1.3) — `?` is Result-only. Applying it
// to an optional `T?` must be a compile error (F1202) steering the user to
// `??` / `?.` / `!` / `match`. Mirrors the migrated try_* tests, which use
// the explicit none-guard idiom instead.

use @std.avrac.test_runner.{write_fixture}
use @std.avrac.core.{avra_shell_exec}

spec "`?` on an optional is F1202" {
    then "f()? where f returns int? reports F1202 with a remedy" {
        let fixture = "/tmp/avra_null_try_on_optional_test.av"
        write_fixture(fixture,
            "fn maybe(x: int) -> int? {\n" +
            "    if x > 0 { return x }\n" +
            "    none\n" +
            "}\n" +
            "fn use_it(x: int) -> int? {\n" +
            "    let v = maybe(x)?\n" +
            "    v\n" +
            "}\n" +
            "fn main() -> int { 0 }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        // The exact F-code is the stable contract; the message must carry the
        // remedy (the alternatives to `?`).
        out.contains("F1202") && out.contains("??")
    }

    then "`?` on a Result is still accepted (no F1202)" {
        let fixture = "/tmp/avra_null_try_on_result_test.av"
        write_fixture(fixture,
            "fn fallible(x: int) -> Result<int, string> {\n" +
            "    if x > 0 { return .Ok(x) }\n" +
            "    .Err(\"neg\")\n" +
            "}\n" +
            "fn use_it(x: int) -> Result<int, string> {\n" +
            "    let v = fallible(x)?\n" +
            "    .Ok(v)\n" +
            "}\n" +
            "fn main() -> int { 0 }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        !out.contains("F1202")
    }
}
