// WHY: the core value-type-optional guarantee — a present `Some(v)` is
// distinct from `none` for EVERY `v`, including the zero values `0`,
// `false`, and `0.0`. Value-inner optionals (`int?` / `bool?` / `float?`)
// box a present value into a non-null heap cell, so `none` (the null
// pointer) can never collide with `Some(0)` / `Some(false)` / `Some(0.0)`.
// Under the old everything-is-zero repr these all aliased to absence and the
// distinction was lost; this test is the regression oracle for that fix.
// The load-bearing assertion is `present != none` for a zero payload — it
// is TRUE only when the present value is boxed, FALSE under the old repr.

fn int_opt(present: bool) -> int? {
    if present { 0 } else { none }
}

fn bool_opt(present: bool) -> bool? {
    if present { false } else { none }
}

fn float_opt(present: bool) -> float? {
    if present { 0.0 } else { none }
}

spec "value-type optionals distinguish none from a zero payload" {
    then "Some(0) is present, not none" {
        let a: int? = 0
        a != none
    }
    then "Some(0) unwraps to 0" {
        let a: int? = 0
        a! == 0
    }
    then "none int? is none" {
        let n: int? = none
        n == none
    }
    then "Some(false) is present, not none" {
        let b: bool? = false
        b != none
    }
    then "Some(false) unwraps to false" {
        let b: bool? = false
        b! == false
    }
    then "Some(0.0) is present, not none" {
        let f: float? = 0.0
        f != none
    }
    then "Some(0.0) unwraps to 0.0" {
        let f: float? = 0.0
        f! == 0.0
    }
    then "a fn returning Some(0) is present, not none" {
        int_opt(true) != none
    }
    then "a fn returning Some(0) unwraps to 0" {
        int_opt(true)! == 0
    }
    then "a fn returning none int? is none" {
        int_opt(false) == none
    }
    then "a fn returning Some(false) is present, not none" {
        bool_opt(true) != none
    }
    then "a fn returning Some(0.0) is present, not none" {
        float_opt(true) != none
    }
    then "?? keeps a present Some(0) (does not fall through to default)" {
        (int_opt(true) ?? 99) == 0
    }
    then "?? on none falls through to the default" {
        (int_opt(false) ?? 99) == 99
    }
}
