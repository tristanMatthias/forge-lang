// WHY: bind-fresh guard `let v = x else { … }` (spec Axis 10.4, Rust
// let-else — no `guard` keyword). Binds the present value of an optional
// for the rest of the scope; the else-block must diverge. Desugars to a
// block-expression initializer:
//   let v = { let __t = x; if __t == none { ELSE } else { __t! } }
// so `v` stays at the outer scope and the subject is evaluated once. Plus
// the `ifnz` guard: an `if let` / comparison of a tagged-scalar
// non-optional to `none` is a compile error.

use @std.avrac.test_runner.{write_fixture, cached_fixture_check_no_metadata}

fn le_pick(x: int?) -> int {
    let v = x else { return -1 }
    v + 100
}

type LePoint = { x: int, y: int }

// PTR-typed optionals were the broken case: the desugared if-expr's THEN arm
// is the diverging else-block (type `.Unknown`), and emit_if_expr returned
// that arm's type — so `v` was typed `.Unknown`. For `int?` the empty layout
// coincidentally lowered to i64 and worked; for a `string?`/`struct?` the
// later field/method access ICE'd (F9999 "field access on non-struct value,
// ty=" — empty). These exercise the surviving-branch type now flowing to `v`.
fn le_pick_str(x: string?) -> int {
    let v = x else { return -1 }
    v.length
}

fn le_pick_struct(p: LePoint?) -> int {
    let v = p else { return -99 }
    v.x + v.y
}

// A `List<T>?` is another ptr-typed optional shape: `.length` must dispatch on
// the resolved `List` type, not the empty layout of an `.Unknown` binding.
fn le_pick_list(xs: List<int>?) -> int {
    let v = xs else { return -1 }
    v.length
}

// `mut v = x else` on a ptr-typed optional then reassigning — the reassign
// must see `v`'s real `string` type, not `.Unknown`.
fn le_mut_str(x: string?) -> string {
    mut v = x else { return "absent" }
    v = v + "!"
    v
}

fn le_break(xs: List<int?>) -> int {
    mut total = 0
    for x in xs {
        let v = x else { break }
        total = total + v
    }
    total
}

// `panic(...)` is a divergence form (the F1203 help text promises it) — the
// else must be accepted, not rejected.
fn le_panic(x: int?) -> int {
    let v = x else { panic("absent") }
    v + 1
}

// `mut v = x else { … }` binds a reassignable present value (Rust's
// `let mut … else`). The fresh binding stays sound — nothing can invalidate
// an already-unwrapped value.
fn le_mut(x: int?) -> int {
    mut v = x else { return -1 }
    v = v + 10
    v
}

spec "let-else — bind-fresh guard" {
    then "binds the present value for the continuation" {
        le_pick(7) == 107
    }
    then "runs the diverging else on none" {
        le_pick(none) == -1
    }
    then "else can break out of a loop" {
        // [1, 2, none, 4] -> 1 + 2, then break
        le_break([1, 2, none, 4]) == 3
    }
    then "a `panic` else is accepted (divergence) and runs the body when present" {
        le_panic(6) == 7
    }
    then "`mut v = x else` binds a reassignable present value" {
        le_mut(5) == 15
    }
    then "`mut v = x else` takes the diverging else on none" {
        le_mut(none) == -1
    }
    then "a `string?` binds with its real type — `.length` reads (was an F9999 ICE)" {
        // Pre-fix: `v` typed `.Unknown` (the diverging then-arm's type), so
        // `v.length` ICE'd on an empty layout. The functions compiling into
        // this shard AND the round-trip together guard the fix.
        le_pick_str("hello") == 5
    }
    then "a `string?` else on none diverges" {
        le_pick_str(none) == -1
    }
    then "a `struct?` binds with its real type — fields read back" {
        let p: LePoint? = LePoint { x: 3, y: 4 }
        le_pick_struct(p) == 7
    }
    then "a `struct?` else on none diverges" {
        le_pick_struct(none) == -99
    }
    then "a `List<int>?` binds with its real type — `.length` reads" {
        le_pick_list([10, 20, 30]) == 3
    }
    then "a `List<int>?` else on none diverges" {
        le_pick_list(none) == -1
    }
    then "`mut v = string? else` binds a reassignable present string" {
        le_mut_str("hi") == "hi!"
    }
    then "`mut v = string? else` takes the diverging else on none" {
        le_mut_str(none) == "absent"
    }
}

spec "let-else — a non-diverging else is rejected (F1203)" {
    then "`let v = x else { 0 }` (no divergence) reports F1203" {
        let f = "/tmp/avra_letelse_f1203.av"
        write_fixture(f,
            "fn u(x: int?) -> int { let v = x else { 0 }\n v }\n" +
            "fn main() -> int { 0 }\n")
        let out = cached_fixture_check_no_metadata(f)
        out.contains("F1203")
    }
    then "a diverging else (`return`) does NOT report F1203" {
        let f = "/tmp/avra_letelse_ok.av"
        write_fixture(f,
            "fn u(x: int?) -> int { let v = x else { return -1 }\n v }\n" +
            "fn main() -> int { 0 }\n")
        let out = cached_fixture_check_no_metadata(f)
        !out.contains("F1203")
    }
}

spec "let-else — the binding carries the unwrapped type into typeck" {
    then "`v` from `string? else` is typed `string`, so `let n: int = v` is F1000" {
        // Typeck-side guard: pre-fix the diverging THEN arm's `.Unknown` type
        // flowed to `v`, so typeck was permissive and this mismatch slipped
        // through (only to miscompile in codegen). Now typeck sees `v: string`
        // and rejects the `int` annotation — matching codegen's type.
        let f = "/tmp/avra_letelse_typed.av"
        write_fixture(f,
            "fn u(x: string?) -> int { let v = x else { return -1 }\n" +
            " let n: int = v\n n }\n" +
            "fn main() -> int { 0 }\n")
        let out = cached_fixture_check_no_metadata(f)
        out.contains("F1000")
    }
}

spec "ifnz — non-optional `none` comparison is rejected" {
    then "`if let v = 5` (non-optional int) is F1000" {
        let f = "/tmp/avra_ifnz_iflet.av"
        write_fixture(f,
            "fn u() -> int { if let v = 5 { v } else { 0 } }\n" +
            "fn main() -> int { 0 }\n")
        let out = cached_fixture_check_no_metadata(f)
        out.contains("F1000")
    }
    then "a real optional `if let` is accepted (no F1000)" {
        let f = "/tmp/avra_ifnz_ok.av"
        write_fixture(f,
            "fn u(x: int?) -> int { if let v = x { v } else { 0 } }\n" +
            "fn main() -> int { 0 }\n")
        let out = cached_fixture_check_no_metadata(f)
        !out.contains("F1000")
    }
}
