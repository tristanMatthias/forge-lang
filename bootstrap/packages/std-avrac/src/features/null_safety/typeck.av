// WHY: type checking for null-safety features (catch, null coalesce).

use core.{Expr, ValueType, vtype_eq, vtype_display, vtype_assignable}
use core.{is_result_enum_name}
use typeck.{check_expr, tc_er, tc_catch_ok_type, tc_report_at}
use diagnostics.{DiagCode}

/// Type-check a `expr() catch { fallback }`. The catch body must
/// produce a value assignable to the fallible expression's `Ok`
/// type — anything else surfaces as an F1000 mismatch with a
/// span pointing at the catch keyword.
export fn check_catch(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Catch(inner, _, body, cl, cc) -> {
            let ci = check_expr(tc, inner)
            let cb = check_expr(ci.tc, body)
            let maybe_ok = tc_catch_ok_type(ci.tc, inner)
            if maybe_ok != null {
                let ok_ty = maybe_ok!
                if !vtype_eq(ok_ty, cb.ty) && !vtype_assignable(cb.ty, ok_ty) {
                    let msg = "catch body type `${vtype_display(cb.ty)}` does not match expected type `${vtype_display(ok_ty)}`"
                    return tc_er(tc_report_at(cb.tc, DiagCode.TypeMismatch, msg, cl, cc, 5), ok_ty)
                }
                return tc_er(cb.tc, ok_ty)
            }
            tc_er(cb.tc, cb.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Type-check a `expr?` try operator. Valid on `Result<T, E>`
/// (unwraps to `T`, propagates `E`) and on `T?` nullable
/// (unwraps to `T`, propagates null). Generic enums and Unknown
/// types pass through unchanged so generic code that uses `?`
/// type-checks at the use site.
export fn check_try(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Try(inner) -> {
            let r = check_expr(tc, inner)
            // Two extraction paths for Result: (1) structural — peel
            // the first type-arg off the inner expression's
            // ValueType (works for method calls, indexed-list
            // returns, anything whose .ty is already a concrete
            // `Result<Ok, Err>`); (2) name-based — look up the
            // callee's registered return type. Always prefer
            // structural — `tc_catch_ok_type` can only see the
            // fn's pre-substitution ret_ty, which loses generic
            // bindings for method calls and chained generic calls.
            match r.ty {
                .Enum(name, args, _) if is_result_enum_name(name) -> {
                    if args.length > 0 {
                        let ok_ty = args[0]
                        if !vtype_is_unknown(ok_ty) { return tc_er(r.tc, ok_ty) }
                    }
                }
                _ -> {}
            }
            let inner_name = match r.ty { .Enum(n, _, _) -> n, _ -> "" }
            if is_result_enum_name(inner_name) {
                let maybe_ok = tc_catch_ok_type(r.tc, inner)
                if maybe_ok != null {
                    return tc_er(r.tc, maybe_ok!)
                }
            }
            // For enums, nullable types, and Unknown — pass through (? is valid)
            tc_er(r.tc, r.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Type-check `left ?? right`. Result type is the right side
/// (the guaranteed non-null fallback) when both sides are known;
/// falls back to whichever side has a non-Unknown type
/// otherwise.
export fn check_null_coalesce(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .NullCoalesce(left, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            // `left ?? right` — result type is the right side (fallback value).
            // If both sides have known non-Unknown types, prefer the more specific one.
            if l.ty is .Unknown { return tc_er(r.tc, r.ty) }
            if r.ty is .Unknown { return tc_er(r.tc, l.ty) }
            // Both known — use right side (the guaranteed non-null fallback)
            tc_er(r.tc, r.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
