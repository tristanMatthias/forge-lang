// The while LanguageFeature definition (features/while_stmt/mod.av): the
// definition carries title/docs/snippet + the pass hooks, its keyword
// DERIVES from the declared grammar, and the declared rule reaches the
// composed statement + whole-program views through
// feature_stmt_grammar_fragments — the t-47hc.8 flip's guard: ONE
// definition in the feature file, zero spine copies. The lowering rides
// the manifest's first `spanned` row (build_while), so the row's shape is
// pinned here too.
use @std.avrac.features.while_stmt.{while_lang}
use @std.avrac.features.{feature_keywords, feature_gram, feature_builders}
use @std.avrac.features.grammar.{render_grammar, avra_program_grammar, grammar_build_refs}

spec "while as a LanguageFeature" {
    then "the keyword derives from the declared grammar" {
        let kws = feature_keywords(while_lang())
        kws.length == 1 && kws[0] == "while"
    }
    then "title, docs, and editor snippet are carried" {
        let f = while_lang()
        f.title.length > 0 && f.docs.contains("flow-narrows") && f.snippet.contains("while")
    }
    then "the declared rule reaches the composed statement view, spelling and all" {
        // The DISPLAY render omits item markers (@onfail/@off/@require live
        // only in rule_identity), so the pinned string is the marker-free
        // head + the feature-owned lowering.
        let rule = "while_stmt = \"while\" c:expression body:block -> build_while(c, body)"
        render_grammar(feature_gram(while_lang())).contains(rule)
            && render_grammar(avra_program_grammar()).contains(rule)
    }
    then "the rules and their builds are STRUCTURALLY present, not merely spelled" {
        // The #1243 discipline, applied here too: render_grammar(...).contains(...)
        // above pins the SPELLING, but a rendered substring can match inside a
        // DIFFERENT rule's text, so containment alone does not prove the rule
        // exists under that name. g.rules proves the rule NAME is defined and
        // grammar_build_refs proves the lowering is attached at the right arity.
        mut ok = true
        for g in [feature_gram(while_lang()), avra_program_grammar()] {
            mut has_while_stmt = false
            for r in g.rules {
                if r.name == "while_stmt" { has_while_stmt = true }
            }
            mut ref_build_while = false
            for br in grammar_build_refs(g) {
                if br.name == "build_while" && br.argc == 2 { ref_build_while = true }
            }
            if !has_while_stmt || !ref_build_while { ok = false }
        }
        ok
    }
    then "the whole-program view lowers through the same builder" {
        let prod = render_grammar(avra_program_grammar())
        prod.contains("build_while(") && !prod.contains("-> While(")
    }
    then "build_while rides the manifest as the first SPANNED stmt row" {
        // spanned: the generated parser threads the `while` keyword's byte
        // as st.build_sp and the ADAPTER stamps the While's SrcPos there;
        // the interpreter path stays span-free. The typed fn never sees it.
        mut row = ""
        for b in feature_builders() {
            if b.name == "build_while" { row = "${b.kind}/${string(b.arity)}/${if b.spanned { "spanned" } else { "flat" }}/${b.export_name}" }
        }
        row == "stmt/2/spanned/build_while_abi"
    }
}
