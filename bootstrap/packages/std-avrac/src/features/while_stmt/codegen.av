// WHY: emits LLVM IR for `while cond { body }` with break/continue
// support via the scoped loop stack in Ctx.

use core.{Expr, Stmt, VarBinding}
use codegen.{Ctx, LoopStackFrame, StmtResult,  ok_stmt, emit_value_ptr, push_loop_frame}
use codegen.{emit_expr, emit_stmt, ok_sr, err_sr}

/// Codegen entry for `while cond { body }`. Pattern-matches the
/// `While` AST node and forwards to `emit_while_inner`.
export fn emit_while(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .While(condition, body) -> emit_while_inner(ctx, env, condition, body)
        _ -> err_sr("expected While")
    }
}

/// Inner emitter: lay out cond/body/exit basic blocks, push a
/// LoopStack frame onto the scoped Ctx so `break` / `continue`
/// resolve correctly inside the body. Falls through to `exit_bb`
/// when the body ends without an early exit.
fn emit_while_inner(ctx: Ctx, env: List<VarBinding>, condition: Expr, body: Stmt) -> Result<StmtResult, string> {
    ctx.cov_line()
    let cond_bb = ctx.bb("while.cond")
    let body_bb = ctx.bb("while.body")
    let exit_bb = ctx.bb("while.exit")
    ctx.br(cond_bb)

    ctx.position(cond_bb)
    let cond = ctx.emit(env, condition)?
    let cond_i1 = ctx.truthy(emit_value_ptr(cond), "while_cond")
    ctx.cond_br(cond_i1, body_bb, exit_bb)

    // Scoped loop stack: snapshot ctx.loops + append this loop's
    // frame. The body sees the new list; the outer ctx.loops is
    // untouched (push_loop_frame snapshots before appending, so the
    // heap-shared list the caller passed in isn't mutated and the
    // frame doesn't leak out of this scope).
    ctx.position(body_bb)
    let body_cg = ctx.with_loops(push_loop_frame(ctx.loops, LoopStackFrame { cond_bb, exit_bb }))
    let body_sr = emit_stmt(body_cg, env, body)?
    ctx.br_if_open(cond_bb)

    ctx.position(exit_bb)
    ok_sr(ctx, env)
}
