// while — conditional loop (spec Axis 28). The definition carries the
// feature whole: syntax, docs, editor surface, hooks, and the grammar rule
// the statement views compose (gram_family = GramFamily.Stmt, t-47hc.8). The
// lowering (build_while) is feature-owned via the builder manifest with a
// `spanned` row — the ADAPTER stamps the statement's SrcPos at the `while`
// keyword (st.build_sp); the typed fn never sees the span.
// dir-as-module (g2eo.1): codegen.av auto-loads as a sibling (emit_while).
use core.{vtype_render_full, vtype_eq, vtype_is_unknown}
use typeck.{check_expr, check_stmt, tc_report, narrow_guard_of, tc_narrow_true_branch}
use features.grammar.{parse_grammar, GramFamily}

/// Type-check hook for `while`. The condition must be Bool (Int
/// accepted for legacy compatibility); anything else surfaces as
/// `F1000 TypeMismatch`. The body is checked unconditionally.
fn while_check(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .While(cond_id, body_id) -> {
            let cond = tc.nodes.exprs.get(cond_id)
            let body = tc.nodes.stmts.get(body_id)
            let c = check_expr(tc, cond)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "while condition must be `bool`, got `${vtype_render_full(c.ty)}`")
            } else { c.tc }
            let guard = narrow_guard_of(tc.nodes, cond)
            // Fast path: no `none`-guard → check the body directly.
            if guard.var == "" { return check_stmt(after_cond, body) }
            // Optional flow-narrowing: in `while x != none { … }` the body
            // only runs while `x` is present, so narrow it to `T` for the
            // body, then reset the env so the narrowing does not leak past
            // the loop. Only `!= none` narrows — a `while x == none` body
            // runs while `x` is absent. (Permissive variable-narrowing;
            // see the `tc_narrow_present` block in typeck for the
            // soundness caveat.)
            let baseline = after_cond.types
            let after_body = check_stmt(tc_narrow_true_branch(after_cond, guard), body)
            after_body with { types: baseline }
        }
        _ -> tc
    }
}

/// `while cond { body }`. Pure shape — the SrcPos stamp at the `while`
/// keyword rides the bind's `spanned` row (the ADAPTER stamps itself at
/// st.build_sp via mk_stamp_stmt_at), never this fn. Home in the feature file
/// (t-47hc.8 dissolution) — the engine's checked-in `_gb_` adapter imports
/// it back.
@language_feature
export fn while_lang() -> LanguageFeature {
    LanguageFeature while_def {
        name = "while",
        title = "while — loop while a condition holds",
        docs = """
`while cond { body }` re-evaluates `cond` before every iteration and runs
the body while it is true. The condition must be `bool` (a bare `int` is
accepted for legacy compatibility); the body must be a `{ }` block —
`while x break` is rejected (F0010), matching every other control-flow
header.

Struct literals are disabled in the condition, so `while foo { }` reads
`foo` as the condition and `{ }` as the body, never as a struct literal
`foo { }`. Exit early with `break`, skip to the next test with
`continue`. A `while x != none { … }` condition flow-narrows `x` to its
present type inside the body.
""",
        // TWO @expect keys, ONE message: `@require body:block` is keyed by
        // block's single-literal FIRST (`{`) once the fragment composes into
        // the full grammar — that key is what the emitted abort looks up. But
        // the fragment validates STANDALONE (register_lang), where `block` is
        // a spine rule it cannot resolve, so the validator demands the
        // rule-name key instead. Declaring both (same wording, same F0010)
        // satisfies the standalone check and keeps the composed emit
        // byte-identical to the spine-era rule.
        gram = grammar { while_stmt = "while" @onfail(bail) @off(allow_struct_lit) c:expression @require body:block @expect("{", "expected `{` after while condition", F0010) @expect("block", "expected `{` after while condition", F0010) -> build_while(c, body) },
        snippet = r"while ${1:cond} {\n    ${2:body}\n}",
        stmt_tag = Stmt.While(ExprId(0), StmtId(0)),
        emit_stmt = emit_while,
        resolve_stmt = while_resolve,
        check_stmt = while_check,
        eval_stmt = while_eval,
        gram_family = GramFamily.Stmt,
    }
    while_def
}
