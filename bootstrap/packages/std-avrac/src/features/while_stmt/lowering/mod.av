// The while_stmt feature's LOWERINGS — typed build fns + their ABI adapters +
// manifest rows, in a dedicated SUBMODULE so the generated parser imports
// them directly (t-kd4y.3 Batch A, the wrapper-free shape). This module
// imports ONLY features.grammar + core — both already in every generated
// parser's closure — so the F4012 import-closure invariant holds by
// construction; the feature's passes/hooks stay in ../mod.av.

use core.{ModulePath, Stmt, ExprId, StmtId}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_stmt_val, capval_to_expr, capval_to_stmt, mk_stamp_stmt_at, BuildKind}

export fn build_while(c: ExprId, body: StmtId) -> Stmt { Stmt.While(c, body) }

export fn build_while_abi(st: PState, vals: List<CapVal>) -> CapVal {
    // spanned row: the adapter owns its span placement — stamp the While at
    // st.build_sp (the `while` keyword; -1 on the interpreter path, which
    // stays span-free like its retired central arm).
    mk_stamp_stmt_at(st, st.build_sp, capval_stmt_val(st, build_while(capval_to_expr(st, vals[0]), capval_to_stmt(st, vals[1]))))
}

export fn while_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.while_stmt.lowering"), [bind_row("build_while", BuildKind.Stmt, 2, true, "build_while_abi", build_while_abi)])
}
