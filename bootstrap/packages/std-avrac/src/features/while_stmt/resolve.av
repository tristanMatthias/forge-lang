// The `while` feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Stmt}
use resolve.{Resolver, resolve_expr, resolve_stmt}

/// Resolver hook for `while`. Resolves the condition first, then
/// the body in the post-condition scope so any names bound in the
/// condition (rare but legal) flow into the body.
fn while_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .While(condition, body) -> {
            let after_cond = resolve_expr(r, r.nodes.exprs.get(condition))
            resolve_stmt(after_cond, r.nodes.stmts.get(body))
        }
        _ -> r
    }
}
