// WHY: codegen for tuple literals, tuple indexing, and let-destructuring.
//
// In the bootstrap's i64 model, a tuple (a, b, c) is a heap-allocated
// buffer of i64 values. Tuple index t.0 loads from offset 0*8, etc.
// Destructuring `let (x, y) = expr` loads each element into a local.
//
// Type tracking: tuple EmitResult carries a .Tuple(List<ValueType>)
// so that tuple indexing can return the correct element type
// (critical for match on enum tuple elements).

use core.{Expr, SExpr, ParamList, VarBinding, env_extend, ValueType, vtype_tuple_at}
use codegen.{Ctx, EmitValue,  ok_emit, err_emit, ok_stmt}

/// Sugar for an i64-typed tuple slot load — wraps `ctx.load_slot`
/// so tuple-specific call sites read more naturally.
fn tuple_load(ctx: Ctx, base: ptr, idx: int, name: string) -> ptr { ctx.load_slot(base, idx, name) }
/// Sugar for an i64-typed tuple slot store — wraps `ctx.store_slot`
/// with the canonical Int field type.
fn tuple_store(ctx: Ctx, base: ptr, idx: int, value: ptr) { ctx.store_slot(base, idx, value, .Int) }

// ── Emit functions ──

/// Codegen entry for `(a, b, c)`. Pattern-matches the AST node
/// and forwards to `emit_tuple_inner`.
export fn emit_tuple(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Tuple(elements) -> emit_tuple_inner(ctx, env, elements)
        _ -> err_emit("expected Tuple")
    }
}

/// Allocate `count * 8` bytes via the arena allocator and fill
/// each i64 slot with the corresponding element. Returns an
/// `EmitValue` typed as `Tuple<T0, T1, ...>` so downstream
/// consumers see the precise element types.
fn emit_tuple_inner(ctx: Ctx, env: List<VarBinding>, elements: List<SExpr>) -> Result<EmitValue, string> {
    let count = elements.length
    let buf = ctx.arena_alloc(ctx.i64(count * 8))
    mut types_acc: List<ValueType> = []
    mut i = 0
    while i < elements.length {
        let r = ctx.emit(env, elements[i].node)?
        tuple_store(ctx, buf, i, r.value)
        types_acc.push(r.ty)
        i = i + 1
    }
    let ty = .Tuple(types_acc)
    ok_emit(ctx.to_i64(buf, "tuple_i64"), ty)
}

/// Codegen entry for `t.0`, `t.1`, ... Pattern-matches the AST
/// node and forwards to `emit_tuple_index_inner`.
export fn emit_tuple_index(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .TupleIndex(obj, idx) -> emit_tuple_index_inner(ctx, env, obj, idx)
        _ -> err_emit("expected TupleIndex")
    }
}

/// Emit the receiver, load slot `idx` from its tuple buffer, and
/// return the value typed as `vtype_tuple_at(...)` so downstream
/// match arms see the right element type.
fn emit_tuple_index_inner(ctx: Ctx, env: List<VarBinding>, obj: Expr, idx: int) -> Result<EmitValue, string> {
    let r = ctx.emit(env, obj)?
    let ptr = ctx.to_ptr(r.value, "tup_ptr")
    let loaded = tuple_load(ctx, ptr, idx, "tup_val")
    let elem_ty = vtype_tuple_at(r.ty, idx)
    ok_emit(loaded, elem_ty)
}

/// Codegen for `let (a, b, c) = expr`. Emits the initializer
/// once, then walks `names` binding each to the matching tuple
/// slot via `destructure_names`.
export fn emit_let_destructure(ctx: Ctx, env: List<VarBinding>, names: ParamList, initializer: Expr) -> Result<List<VarBinding>, string> {
    let r = ctx.emit(env, initializer)?
    let ptr = ctx.to_ptr(r.value, "destruct_ptr")
    destructure_names(ctx, env, names, ptr, r.ty, 0)
}

/// Recursive worker for `emit_let_destructure`. Loads slot `idx`,
/// stores it in a fresh i64 alloca, and extends the env with the
/// name bound to that alloca and the matching element type.
fn destructure_names(ctx: Ctx, env: List<VarBinding>, names: ParamList, base: ptr, tuple_ty: ValueType, idx: int) -> Result<List<VarBinding>, string> {
    match names {
        .End -> ok_stmt(env)
        .Node(name, _, next) -> {
            let loaded = tuple_load(ctx, base, idx, name)
            let alloca = ctx.alloca_i64(name)
            ctx.store(loaded, alloca)
            let elem_ty = vtype_tuple_at(tuple_ty, idx)
            let new_env = env_extend(env, name, alloca, elem_ty)
            destructure_names(ctx, new_env, next, base, tuple_ty, idx + 1)
        }
    }
}
