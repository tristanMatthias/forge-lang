// The tuple-index LOWERING (t-kd4y.3.5.8): the postfix `.0` step's core +
// ABI adapter + manifest row. The core threads the engine's chain state
// (postfix_step_node reads the frozen step base), NOT st.build_sp — the
// row is FLAT and the chain loop's snap owns the span. Imports ONLY
// features.grammar + core (F4012).
use core.{BuildName, ModulePath, Expr, ExprId, TypeExpr}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_tok_text, postfix_step_node, capval_to_texpr_list, BuildKind}

/// `expr.0` — tuple index (t-47hc.33 form 4). The hand takes the NUMBER lexeme and
/// `int()`s it, so a float-shaped `.0.1` lexes as one NUMBER and would differ; the
/// grammar terminal is the same NUMBER kind, so the same lexeme reaches `int` here.
export fn mk_tuple_index(st: PState, tcap: CapVal) -> ExprId {
    postfix_step_node(st, Expr.TupleIndex(st.postfix_step_base, int(capval_tok_text(tcap))))
}

export fn mk_tuple_index_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_tuple_index(st, vals[0]))
}

/// tuple_index_lang's row (its `tuple_suffix` rule spells it).
export fn tuple_index_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.tuples.lowering"), [bind_row(BuildName("MkTupleIndex"), BuildKind.Expr, 1, false, "mk_tuple_index_abi", mk_tuple_index_abi)])
}

/// A parenthesised type — the `TyParen` build's core (t-kd4y.3.5.10).
/// Exactly one element is a grouping (the type itself); zero or >=2 are a
/// tuple `Generic("__tuple", ...)`, matching parse_type_atom's paren
/// branch — the type-position face of the tuple family.
export fn mk_paren_type(tes: List<TypeExpr>) -> CapVal {
    if tes.length == 1 { return CapVal.TExpr(tes[0]) }
    CapVal.TExpr(TypeExpr.Generic("__tuple", tes))
}

export fn ty_paren_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_paren_type(capval_to_texpr_list(vals[0]))
}

export fn tuple_type_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.tuples.lowering"), [bind_row(BuildName("TyParen"), BuildKind.Type, 1, false, "ty_paren_abi", ty_paren_abi)])
}
