// WHY: tuple literals `(a, b, c)`, tuple indexing `t.0`, and `let (x, y) =
// expr` destructuring — fixed, compile-time-known arity.
//
// A tuple is an arena buffer of `count * 8` bytes: every element is CAST to
// i64 on store (`store_slot(…, .Int)`) and reloaded as i64, so the slots are
// uniformly 8 bytes wide regardless of element type. Element ValueTypes ride
// the EmitValue's `.Tuple(List<ValueType>)` instead — that is what lets
// `t.0` and destructuring hand back the right element type (load-bearing for
// match over enum tuple elements).
//
// dir-as-module (g2eo.1): codegen.av + lowering/ auto-load as siblings,
// surface flat at `features.tuples.{...}`.
use core.{vtype_tuple_at, vtype_eq}
use core.{ExprId}
use features.tuples.lowering.{tuple_index_builds, paren_type_builds}
use resolve.{resolve_expr, resolve_expr_list_ids}
use typeck.{check_expr, check_expr_list_types, tc_er, tc_report, tc_gate_unthreaded_lambda}
use diagnostics.{DiagCode}
use features.eval.{Runtime, StepResult, Value, eval_expr, ok_result, error_result, value_list}
use features.grammar.{parse_grammar}

/// Register the `(a, b, c)` tuple literal feature. Wires up
/// resolver, type-checker, codegen, and the tree-walk evaluator.
/// `(a, b)` tuples — the SYNTAX lives in the closures feature's paren
/// fragment (`paren_expr`'s tuple branch + MkTupleFR ride closures_lang,
/// one gram owning the whole `(`-led alternation — t-kd4y.3.5.3), so this
/// definition carries the Tuple hooks alone.
export fn tuples_lang() -> LanguageFeature {
    LanguageFeature tuples_def {
        name = "tuple",
        title = "tuples — fixed-arity value groups",
        expr_tag = Expr.Tuple([]),
        emit_expr = emit_tuple,
        resolve_expr = tuple_resolve,
        check_expr = tuple_check,
        eval_expr = tuple_eval,
    }
    tuples_def
}

/// `t.0`, `t.1`, … — tuple indexing. Distinct AST tag from field access
/// on structs because tuple elements are positional. The definition
/// carries its postfix-chain branch (t-kd4y.3.5.8): the spine's
/// `postfix_suffix` dispatches here behind a zero-width
/// `@peek(dot_number)` gate — the lookahead that partitions `.0` from
/// `.field` BEFORE either `.`-led rule is entered, and what lets this
/// rule sort ahead of field_suffix's unguarded `.` fallback.
/// `gram_family = "expr"`.
export fn tuple_index_lang() -> LanguageFeature {
    LanguageFeature tuple_index_def {
        name = "tuple_index",
        title = ".0 — tuple indexing",
        docs = """
`t.0` reads a tuple's first element, `t.1` its second, and so on. The
index is a literal — tuples are fixed-arity, so positions are checked at
compile time.
""",
        gram = grammar {
  tuple_suffix = @peek(dot_number) @when(dot_postfix_ok) "." t:NUMBER -> MkTupleIndex(t)
        },
        builders = tuple_index_builds(),
        snippet = r"${1:tuple}.${2:0}",
        expr_tag = Expr.TupleIndex(ExprId(0), 0),
        emit_expr = emit_tuple_index,
        resolve_expr = tuple_index_resolve,
        check_expr = tuple_index_check,
        gram_family = "expr",
    }
    tuple_index_def
}

/// Type-check hook for `Tuple` literals. Type-checks each element
/// and packs the resulting types into a `Tuple<T0, T1, ...>`.
fn tuple_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Tuple(elements) -> {
            // Row 15 (ps3t.4.5): tuple elements never thread param
            // types into a lambda — annotate or F1006.
            mut gated = tc
            for id in elements {
                gated = tc_gate_unthreaded_lambda(gated, gated.nodes.exprs.get(id))
            }
            let pair = check_expr_list_types(gated, elements)
            tc_er(pair.tc, .Tuple(pair.types))
        }
        _ -> tc_er(tc, .Unknown)
    }
}


/// Type-check hook for `TupleIndex`. Pulls the element type out
/// of the receiver's `Tuple<...>` type using the literal index.
fn tuple_index_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .TupleIndex(obj, idx) -> {
            let o = check_expr(tc, tc.nodes.exprs.get(obj))
            // §6 layout totality (ps3t.4.9): a tuple-index `.N` on a `.Void`
            // receiver — the common case being a value read from a function that
            // omits `-> Type` and so returns void (the ticket's `let t = g()  t.0`
            // repro) — has no tuple elements. Report a clean F1000 here instead of
            // the codegen "tuple index on non-tuple value" F9999 ICE. `.Unknown`
            // is left alone (upstream under-determination whose own diagnostic must
            // not be masked). Mirror of the field-access / index / method Void gates.
            if vtype_eq(o.ty, .Void) {
                return tc_er(tc_report(o.tc, DiagCode.TypeMismatch,
                    "cannot access tuple element `.${string(idx)}` on a value of type `Void` — the receiver produces no value (a function used here may omit its `-> Type` and return void)"), .Unknown)
            }
            tc_er(o.tc, vtype_tuple_at(o.ty, idx))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// `(A, B)` in TYPE position (t-kd4y.3.5.10) — the tuple family's
/// type-position face, so the rule + its TyParen row live here. One
/// element is a grouping; zero or several are a tuple type.
/// `gram_family = "type"`; the type spine's `type_atom` dispatches by name.
export fn tuple_type_lang() -> LanguageFeature {
    LanguageFeature tuple_type_def {
        name = "tuple_type",
        title = "(A, B) — tuple + grouping types",
        docs = """
`(A, B)` names a tuple type by position; `(T)` is grouping and means
`T` itself. `()` is the empty tuple.
""",
        gram = grammar {
  paren_type = "(" ( t:type_expr ( "," t:type_expr )* )? ")" -> TyParen(t)
        },
        builders = paren_type_builds(),
        gram_family = "type",
    }
    tuple_type_def
}
