// dir-as-module (g2eo.1): grammar.av + lowering/ auto-load as siblings,
// surface flat at `features.impl_decl.{...}`
use features.{composed}
use features.impl_decl.lowering.{impl_builds}
use features.grammar.{parse_grammar}

/// The `impl` block feature. Owns the `impl` keyword (both inherent —
/// `impl Type { ... }` — and trait — `impl Trait for Type { ... }`), its
/// method + associated-type-definition rules, and their lowerings.
@language_feature
export fn impl_decl_lang() -> LanguageFeature {
    LanguageFeature impl_def {
        name = "impl_decl",
        title = "impl — attach methods to a type",
        docs = """
`impl Type { fn method(self) { ... } }` adds methods to a type; each is
lowered to a top-level `Type__method` whose `self` receiver is typed as the
impl's owner. `impl Trait for Type { ... }` implements a trait for a type.
Multiple blocks for one type are allowed and merge at link time.
""",
        gram = grammar {
  // t-myz7: `impl` OWNS its recovery — `@try` + `@cut` after the keyword, its own
  // `@expect`s. `parse_impl_declaration` bails at each of them (`consume(…)?` /
  // `return .Err`), so every one is `@require`d here.
  //
  // The `for` clause carries its OWN `@expect("IDENT", …)`: the hand words the two type
  // positions differently ("after `impl`" vs "after `for`") and `@expect` keys on the
  // token, so one shared annotation set could only ever carry one of them. A group
  // branch's annotations now MERGE with the inherited ones rather than replacing them,
  // which is what makes a second message expressible at all.
  // t-47hc.4.3 — BOTH type positions are `name_or_splice`, not bare `IDENT`, because the
  // hand's are: `parse_impl_decl` calls `consume_name_or_splice` for each. A `~name`
  // splice in either slot is legal inside a quote body, and `@expand` macros that emit
  // `impl Trait for ~nm { … }` per instance depend on it.
  //
  // It read `IDENT` until now only because `@hand(decl_hand)` was silently covering the
  // gap: inside a quote body the `@cut` does not fire (`had_error`/diags have already
  // moved by then), so the splice failure rolled the whole branch back and the HAND
  // parsed it. Deleting the leaf removed that cover and turned a latent expressibility
  // gap into a hard "expected type name after `for`" on valid macro source — the exact
  // defect shape the routing discipline calls "a form the routed rule cannot EXPRESS".
  // `type_decl` was given the same treatment when `fn` routed, for the same reason.
  impl_decl   = @try "impl" @cut ( "<" ( tparam ( "," tparam )* )? ">" )? @require itn:name_or_splice ( "<" ( type_expr ( "," type_expr )* )? ">" )? ( "for" @require ifortn:name_or_splice ( "<" ( type_expr ( "," type_expr )* )? ">" )? @expect("name_or_splice", "expected type name after `for`") @expect("IDENT", "expected type name after `for`") )? @require "{" ( @peek(not_rbrace) @gate imethods:impl_member )* @require "}"
                @expect("name_or_splice", "expected type name after `impl`")
                @expect("IDENT", "expected type name after `impl`")
                @expect("{", "expected `{` after impl type name")
                @expect("}", "expected `}` after impl block") -> MkImpl(itn, ifortn, imethods)
  // The associated-type DEFINITION (`type Name = Concrete`) was missing entirely — the
  // hand accepts it in an impl body and the fragment did not, so routing without it would
  // have broken every impl that defines one. Committed after its keyword for the same
  // reason `trait`'s members are: without it, `impl F { type }` binds the `}` AS THE NAME.
  //
  // `@expect("impl_member", …)` is the message the GATED call above reports with — an
  // alternation-led rule has no leading terminal to key on, so without it the gate says
  // "expected impl_member", a grammar rule name printed at a user.
  impl_member = d:DOC ( d:DOC )* im:impl_method -> MkDocAnnotated(d, im)
              | impl_assoc
              | impl_method
                @expect("impl_member", "expected `fn` or `type` inside impl block")
  impl_assoc  = @try "type" @cut @require aname:IDENT @require "=" @require aty:type_expr
                @expect("IDENT", "expected associated type name")
                @expect("=", "expected `=` after associated type name")
                @expect("type_expr", "expected type after `=`") -> MkAssocTypeDef(aname, aty)
  // The parameter list is GATED so a `(` that never closes reports about the PARAMETER,
  // which is what the hand does: `impl F { fn m( }` is "expected parameter name", not
  // "expected `)`". The gate is what lets the loop be entered on a token the parameter's
  // own FIRST refuses (EOF, `}`), and the gated FIRST re-check is what reports for it.
  impl_method   = @try "fn" @cut @require imname:IDENT @require "(" ( @peek(not_rparen) @gate imparams:param ( @peek(comma_not_rparen) "," imparams:param )* ( "," )? )? @require ")" ( "->" @require imret:type_expr )? @require "{" imbody:body_item* @require "}"
                  @expect("IDENT", "expected method name")
                  @expect("(", "expected `(` after method name")
                  @expect(")", "expected `)` after method parameters")
                  @expect("type_expr", "expected return type after `->`")
                  @expect("{", "expected `{` for method body")
                  @expect("}", "expected `}` after method body") -> MkMethod(imname, imparams, imret, imbody)
            },
        builders = impl_builds(),
        snippet = r"impl ${1:Type} {\n    ${2:body}\n}",
    }
    impl_def
}
