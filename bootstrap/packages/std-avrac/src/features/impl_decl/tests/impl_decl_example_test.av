/// Test fixture: minimal struct used by the `impl` example test.
/// One mutable counter, plus inherent `increment` / `value`
/// methods to exercise method-call codegen.
///
/// @field count — running call count.
type ExIdCounter = {
    count: int
}

impl ExIdCounter {
    fn increment(self) {
        self.count = self.count + 1
    }

    fn value(self) -> int {
        self.count
    }
}

spec "impl decl example" {
    then "method increments mutable receiver three times" {
        mut c = ExIdCounter { count: 0 }
        c.increment()
        c.increment()
        c.increment()
        c.value() == 3
    }
}
