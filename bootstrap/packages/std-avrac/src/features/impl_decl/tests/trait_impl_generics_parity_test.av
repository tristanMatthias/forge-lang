// WHY: t-47hc slice 10.7 (t-myz7) — `trait` and `impl` accept generics.
//
// These two differ from enum / type / fn: their nodes have NOWHERE to put type params.
// `Stmt.TraitDecl(name, members)` and the impl's `"Trait:Type"` encoding carry no
// type-param list, and the hand does not build one — `parse_impl_declaration` calls
// `skip_angle_brackets()` at three positions (after `impl`, after the target name, after
// the `for` type) and throws the tokens away. So the grammar CONSUMES them unlabelled and
// builds the same node, rather than capturing into a builder that has no field for them.
//
// A MEASURED NARROWING, pinned rather than hidden. `skip_angle_brackets` is a balanced
// token skip — it tolerates anything between the angles. The DSL has no negated-terminal
// class, so it cannot express "any token that is not `>`"; the rules use `tparam` for the
// parameter positions and `type_expr` for the argument positions, which is precise and
// handles nesting but is strictly narrower:
//
//     impl Foo<+> { … }    hand ACCEPTS (blind skip)    DSL REJECTS
//     trait T<+> { … }     hand ACCEPTS (blind skip)    DSL REJECTS
//
// No valid program contains those, so this does not block routing — but it is a real
// divergence and belongs on the record, the same way `type X =` was pinned in
// diagnostic_equivalence_test until slice 10.5 closed it. If it ever needs closing, the
// capability is a negated terminal class, not a change to these rules.
//
// `impl` with a GENERIC METHOD inside (`impl P { fn g<T>(x: T) … }`) fails in BOTH
// engines. Not a gap — `impl_method` has no type params in the hand either.

use @std.avrac.features.grammar.{avra_program_grammar, run_grammar_stmt, avra_decl_dispatch_grammar, emit_parser_source_ex}
use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{render_stmt_ids, Stmt}

fn dsl_program(src: string) -> string {
    let r = run_grammar_stmt(avra_program_grammar(), src)
    if r.had_error { return "<dsl parse error>" }
    match r.store.stmts.get(r.root) {
        .Block(ids) -> render_stmt_ids(r.store, ids)
        _ -> "<not a program block>"
    }
}

fn hand_program(src: string) -> string {
    let p = parse_program_source(src)
    if p.had_error != 0 { return "<hand parse error>" }
    if p.ids == null { return "<hand no ids>" }
    render_stmt_ids(p.store, p.ids!)
}

fn agrees(src: string) -> bool {
    let d = dsl_program(src)
    d == hand_program(src) && !d.contains("parse error")
}

spec "t-47hc slice 10.7: `trait` accepts type params and builds the same node" {
    then "a generic and a bounded trait agree with the hand" {
        agrees("trait Conv<T> {\n    fn conv() -> T\n}\n") &&
            agrees("trait C<T: Show> {\n    fn c() -> T\n}\n")
    }

    then "the non-generic trait, its assoc types and default methods are untouched" {
        agrees("trait Show {\n    fn show() -> string\n}\n") &&
            agrees("trait It {\n    type Item\n    fn next() -> int\n}\n") &&
            agrees("trait D {\n    fn d() -> int {\n        return 1\n    }\n}\n")
    }
}

spec "t-47hc slice 10.7: `impl` accepts type params AND type arguments" {
    then "params on the impl, args on the target, and args after `for` all agree" {
        // Three separate angle-bracket positions, which is why the hand skips three times.
        agrees("impl<T> Show for Box<T> {\n    fn show() -> string {\n        return x\n    }\n}\n") &&
            agrees("impl Pair<int, string> {\n    fn m() -> int {\n        return 1\n    }\n}\n")
    }

    then "NESTED type arguments parse — the reason these use type_expr, not a flat IDENT" {
        // `Box<List<T>>` is what rules out matching a single IDENT inside the angles.
        agrees("impl<T> Show for Box<List<T>> {\n    fn show() -> string {\n        return x\n    }\n}\n")
    }

    then "the non-generic forms are untouched" {
        agrees("impl Show for Point {\n    fn show() -> string {\n        return x\n    }\n}\n") &&
            agrees("impl Point {\n    fn m() -> int {\n        return 1\n    }\n}\n")
    }
}

spec "t-myz7: an EMPTY `<>` is accepted, as the blind skip always accepted it" {
    then "`trait T<> { … }` parses on both engines" {
        // A NARROWING that was neither measured nor pinned, unlike the token-soup one
        // below. `skip_angle_brackets` counts depth and discards, so `<>` is a
        // zero-token skip the hand accepts silently — while the native rule's list
        // began with a MANDATORY `tparam` and answered `expected \`IDENT\``. Routing a
        // keyword must leave the acceptance frontier exactly where the hand had it,
        // and this one had moved: the native rule rejected a program the hand compiles.
        //
        // Invisible to the invalid corpus by construction. This is VALID input to the
        // hand, so it belongs to no malformed-form spec, and the F-code oracles compare
        // an EMPTY hand signature against a non-empty native one only if someone
        // thought to write the case down. It surfaced from sweeping every routed
        // keyword's type-parameter list, which is the coverage gap it also closes.
        agrees("trait T<> {\n    fn m() -> int\n}\n") &&
            agrees("impl<> Show for Point {\n    fn show() -> string {\n        return x\n    }\n}\n")
    }

    then "the non-empty and absent lists are unchanged — the control" {
        agrees("trait T<A> {\n    fn m() -> A\n}\n") &&
            agrees("trait T {\n    fn m() -> int\n}\n")
    }
}

spec "t-47hc slice 10.7: the blind-skip NARROWING, pinned" {
    then "token soup between angles: the hand tolerates it, the DSL does not" {
        // Measured, not assumed. Asserted so that if a future capability closes it, this
        // fails loudly and gets converted to parity — exactly how `type X =` was handled.
        dsl_program("impl Foo<+> {\n    fn m() -> int {\n        return 1\n    }\n}\n").contains("parse error") &&
            !hand_program("impl Foo<+> {\n    fn m() -> int {\n        return 1\n    }\n}\n").contains("parse error")
    }
}

// ── ROUTING (t-47hc slice 10.13) ─────────────────────────────────────────────
//
// `trait` and `impl` leave `@hand(decl_hand)` as `@try` branches — native for VALID
// input, rolling back into the hand gate the moment they report, so error recovery stays
// the hand parser's byte-for-byte (t-myz7.2, #1061). With these two the LAST decl keyword
// is native; `@hand(decl_hand)` survives only for the doc/annotation/`export` wrapping
// and the component-vs-expression IDENT disambiguation, which is why --hand-leaves does
// not move on this slice.
//
// Seven malformed trait/impl forms are in the invalid corpus
// (error_recovery_differential_test), F-code and recovery-TREE both.
fn decl_src_routing() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}

spec "t-47hc slice 10.13: `trait` and `impl` are routed onto the production path" {
    then "both parse fns exist and dispatch BEFORE the decl_hand gate" {
        let src = decl_src_routing()
        let tr_at = src.index_of("parse_trait_decl(st)")
        let im_at = src.index_of("parse_impl_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        src.contains("fn parse_trait_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_impl_decl(st: PState) -> CapVal") &&
            tr_at >= 0 && im_at >= 0 && hand_at >= 0 && tr_at < hand_at && im_at < hand_at
    }

    then "both branches are SPECULATIVE — on any diagnostic they roll back into the gate" {
        let src = decl_src_routing()
        src.contains("s_last = parse_trait_decl(st)") &&
            src.contains("s_last = parse_impl_decl(st)") &&
            src.contains("st.store.truncate_to_mark(s_mark)") &&
            src.contains("st.restore_hand_state(s_hand)")
    }

    then "the member lists lower to the SHARED cores, not executor-only builds" {
        // The trap this slice hit four separate times: an executor-only build passes every
        // interpreter-driven parity spec above and emits nothing usable.
        let src = decl_src_routing()
        src.contains("mk_trait_decl(") && src.contains("mk_trait_method(") &&
            src.contains("mk_assoc_type(") && src.contains("mk_impl(") && src.contains("mk_method(")
    }

    then "the alternation TAIL is still native `statement`, not a promoted @hand" {
        let src = decl_src_routing()
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        let tail_at = src.index_of("    parse_statement(st)\n}")
        tail_at >= 0 && hand_at >= 0 && tail_at > hand_at
    }
}

// WHY: t-myz7 — a doc comment on an `impl` MEMBER attaches, it does not skip.
//
// `impl_member = d:DOC ( d:DOC )* im:impl_method -> MkDocAnnotated(d, im) | impl_method`.
// The hand builds `Stmt.Annotated([@doc(…)], inner)`, so the doc reaches the AST and
// `docs --gen` can read it. The enum fragment's `( DOC )*` SKIP would have compiled,
// passed every parity spec, and silently DISCARDED the documentation — which is why
// tree-equality alone is not enough here: if BOTH engines dropped the doc they would
// still agree. `renders_doc` is the anti-vacuity half, asserting the annotation is
// actually THERE. Blocked until t-iu1n (an F9999 in the metadata lib build) was fixed.

fn renders_doc(src: string) -> bool {
    hand_program(src).contains("@doc(") && dsl_program(src).contains("@doc(")
}

spec "t-myz7: a doc comment on an impl member is ATTACHED, not skipped" {
    then "a documented method agrees with the hand AND keeps its doc" {
        let one = "impl T {\n    /// d\n    fn m(self) -> int { 1 }\n}\n"
        agrees(one) && renders_doc(one)
    }

    then "consecutive doc lines all attach — the `.Star` half of the binding" {
        let many = "impl T {\n    /// one\n    /// two\n    fn m(self) -> int { 1 }\n}\n"
        agrees(many) && renders_doc(many) &&
            hand_program(many).contains("one") && dsl_program(many).contains("two")
    }

    then "a documented method sits alongside an undocumented one" {
        agrees("impl T {\n    /// d\n    fn a(self) -> int { 1 }\n    fn b(self) -> int { 2 }\n}\n")
    }

    then "the UNDOCUMENTED method is unaffected — the bare tail still owns it" {
        let undoc = "impl T {\n    fn m(self) -> int { 1 }\n}\n"
        agrees(undoc) && !hand_program(undoc).contains("@doc(")
    }

    // A dangling doc before `}` must be REJECTED by both. The widened member loop
    // now enters on DOC, so the native rule could have been error-TOLERANT here where
    // the hand aborts — the exact failure class @try exists to catch. `agrees` cannot
    // express this (it requires a clean parse on both sides), so assert the rejection
    // directly rather than letting a green `agrees` hide it.
    then "a trailing doc with no method is REJECTED by both engines" {
        let dang = "impl T {\n    fn m(self) -> int { 1 }\n    /// dangling\n}\n"
        hand_program(dang).contains("parse error") && dsl_program(dang).contains("parse error")
    }
}
