// The impl feature's LOWERINGS — the normalized builder ABI
// (`fn(PState, List<CapVal>) -> CapVal`) plus the manifest rows binding
// them, in a dedicated SUBMODULE so the generated parser imports them
// directly (t-kd4y.3, the Batch A shape). This module imports ONLY
// features.grammar + core — both already in every generated parser's
// closure — so the F4012 import-closure invariant holds by construction;
// the feature's grammar fragment stays in ../grammar.av.
//
// No row here is `spanned`: the retired central arms took no sp_start, so
// every node is a span-free `add_leaf` row on BOTH engines.
//
// `MkMethodShorthand` is NOT here despite the family ticket listing it: its
// only grammar reference is `comp_block_item` (the component instance body),
// so it is component-owned and flips with t-kd4y.3.3.5 — the ticket's own
// "follow the gram refs, not intuition" rule, which `builder_validation_error`
// enforces (a supplied builder no rule in its gram references is a startup
// failure).

use core.{ParamEntry, Stmt, StmtId, TypeParamEntry, ValueType, byte_span_none, method_mangled_name, type_expr_to_vtype, vtype_from_name}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_present, capval_to_pentry_list, capval_to_stmt_list, capval_to_texpr, capval_tok_text, BuildKind}

/// `fn name ( params? ) ( "->" ret )? { body }` — one impl method, built with
/// its PLAIN name (the `MkMethod` build); `impl_build` re-keys it to the
/// mangled `Type__method` where the impl target is in scope.
export fn method_build(st: PState, vals: List<CapVal>) -> CapVal {
    let ret_vt = if capval_present(vals[2]) { type_expr_to_vtype(capval_to_texpr(st, vals[2])) } else { ValueType.Void }
    let no_tp: List<TypeParamEntry> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Function(capval_tok_text(vals[0]), no_tp, capval_to_pentry_list(vals[1]), ret_vt, capval_to_stmt_list(vals[3]))))
}

/// `impl Type { … }` / `impl Trait for Type { … }` — the `MkImpl` build.
/// The mangling TARGET is the `for` type when present, else the header type;
/// each plain-named method is re-keyed to `target__method` and its `self`
/// receiver retyped to the target — the two context-dependent steps.
export fn impl_build(st: PState, vals: List<CapVal>) -> CapVal {
    let header = capval_tok_text(vals[0])
    let has_for = capval_present(vals[1])
    let target = if has_for { capval_tok_text(vals[1]) } else { header }
    let impl_name = if has_for { "${header}:${target}" } else { header }
    mut mangled_ids: List<StmtId> = []
    for id in capval_to_stmt_list(vals[2]) {
        match st.store.stmts.get(id) {
            .Function(nm, tp, ps, rv, bd) -> mangled_ids.push(st.store.stmts.add_leaf(Stmt.Function(method_mangled_name(target, nm), tp, retype_self_param(st, ps, target), rv, bd)))
            _ -> mangled_ids.push(id)
        }
    }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Impl(impl_name, mangled_ids)))
}

/// Retype a leading `self` receiver to the impl's target type — the other
/// half of the re-keying `impl_build` performs. A method whose first
/// parameter is not `self` (an associated fn) is handed back untouched.
fn retype_self_param(st: PState, params: List<ParamEntry>, target: string) -> List<ParamEntry> {
    if params.length == 0 { return params }
    if params[0].name != "self" { return params }
    let self_vt = vtype_from_name(target)
    mut out: List<ParamEntry> = [ParamEntry { name: "self", vtype: self_vt, ty_id: st.store.ingest_type(self_vt, byte_span_none()) }]
    mut i = 1
    while i < params.length {
        out.push(params[i])
        i = i + 1
    }
    out
}

/// `type Name = Concrete` — the IMPL-side associated type. Same
/// `Stmt.AssocType` row as the trait-side member (`MkAssocType`,
/// features/trait_decl/lowering), with the type FILLED IN rather than left
/// Unknown: a trait DECLARES the association and an impl DEFINES it, and
/// `render_stmt` already tells the two apart on exactly that field.
///
/// A separate build NAME rather than a second arity of `MkAssocType`,
/// because emit dispatches on the name alone — a 2-arg call rendered
/// through the 1-arg arm would put the type where nothing reads it,
/// silently, in the generated parser only (t-gnk7). Here rather than
/// trait_decl by the referencing-rule doctrine: `impl_assoc` (this
/// feature's gram) is the rule that spells it.
export fn mk_assoc_type_def(st: PState, name: string, ty_cv: CapVal) -> CapVal {
    let ty = type_expr_to_vtype(capval_to_texpr(st, ty_cv))
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.AssocType(name, ty)))
}

export fn mk_assoc_type_def_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_assoc_type_def(st, capval_tok_text(vals[0]), vals[1])
}

/// The impl feature's rows — bound under the EXISTING `Mk` names, so the
/// gram text is untouched by the flip (the row name IS the gram ref).
export fn impl_decl_builds() -> List<BuilderBind> {
    bind_rows("features.impl_decl.lowering", [bind_row("MkImpl", BuildKind.Stmt, 3, false, "impl_build", impl_build),
     bind_row("MkMethod", BuildKind.Stmt, 4, false, "method_build", method_build),
     bind_row("MkAssocTypeDef", BuildKind.Stmt, 2, false, "mk_assoc_type_def_abi", mk_assoc_type_def_abi)])
}
