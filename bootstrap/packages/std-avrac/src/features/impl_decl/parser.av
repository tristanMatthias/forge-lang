// WHY: parses `impl Type { fn method(self) { ... } }` blocks. Each
// method is desugared to a free function named `Type__method`.

use core.{Stmt, ParamEntry, TypeParamEntry, ValueType, type_expr_to_vtype, vtype_from_name, Expr, Annotation, NodeRef, StmtId, SrcPos, byte_span_none}
use parse.{Parser}
use core.{method_mangled_name}
use core.{Tk}

/// One parse of an impl body: the arena rows backing each element, in
/// source order — the Impl payload (F3a: element ids ARE the children).
type MethodsParsed = {
    ids: List<StmtId>,
}

impl Parser {
    fn parse_impl_declaration(self) -> Result<StmtId, string> {
        self.advance()
        // Optional generic parameters on impl: `impl<T> ...`
        if self.check(Tk.Less) {
            self.skip_angle_brackets()
        }
        let type_name = self.consume_name_or_splice("expected type name after `impl`")?
        // Skip generic args on the type name: `impl Foo<T> { ... }`
        if self.check(Tk.Less) {
            self.skip_angle_brackets()
        }
        // Handle `impl Trait for Type { ... }` — encoded as "Trait:Type"
        // in impl_name. Typeck uses the trait name for conformance checking.
        // Methods are desugared to `Type__method`.
        mut target_name = type_name
        if self.check(Tk.KwFor) {
            self.advance()
            let for_type = self.consume_name_or_splice("expected type name after `for`")?
            if self.check(Tk.Less) {
                self.skip_angle_brackets()
            }
            target_name = for_type
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after impl type name") {
            return .Err("parse error")
        }
        let methods = self.parse_impl_methods(target_name)?
        if !self.consume(Tk.RightBrace, "expected `}` after impl block") {
            return .Err("parse error")
        }
        // Encode trait info in the type_name: "Trait:Type" for trait impls,
        // just "Type" for plain impls. Downstream can split on ':'.
        let impl_name = if type_name != target_name {
            "${type_name}:${target_name}"
        } else {
            target_name
        }
        .Ok(self.alloc_stmt_leaf(Stmt.Impl(impl_name, methods.ids)))
    }

    fn parse_impl_methods(self, type_name: string) -> Result<MethodsParsed, string> {
        mut ids: List<StmtId> = []
        mut pending_doc: string = ""
        mut has_pending_doc = false
        while !self.check(Tk.RightBrace) {
            // Doc comments inside an impl block attach to the next method
            // (or associated type). Mirror the top-level declaration
            // parser's `@doc` wrapping so renderers / docs --gen pick
            // them up exactly like free-function docs.
            if self.check(Tk.DocComment) {
                pending_doc = if has_pending_doc { pending_doc + "\n" + self.current_lexeme } else { self.current_lexeme }
                has_pending_doc = true
                self.advance()
                continue
            }
            // Associated type definition: `type Name = ConcreteType`
            if self.check(Tk.KwType) {
                let line = self.current_line
                let col = self.current_column
                self.advance()
                let name = self.consume_identifier("expected associated type name")?
                if !self.consume(Tk.Equal, "expected `=` after associated type name") {
                    return .Err("parse error")
                }
                let te = self.parse_type_expr("expected type after `=`")?
                let ty_vt = type_expr_to_vtype(te)
                let raw = Stmt.AssocType(name, ty_vt)
                let wrapped = if has_pending_doc {
                    let doc_annots: List<Annotation> = [Annotation { name: "doc", arg_ids: [self.alloc_leaf(Expr.String("\"${pending_doc}\""))] }]
                    let raw_id = self.glue_ingest_stmt(raw)
                    self.store.stmts.record_pos(raw_id, SrcPos { line: line, col: col, file: self.file })
                    Stmt.Annotated(doc_annots, raw_id)
                } else { raw }
                let elem_id = self.glue_ingest_stmt(wrapped)
                self.store.stmts.record_pos(elem_id, SrcPos { line: line, col: col, file: self.file })
                ids.push(elem_id)
                has_pending_doc = false
                pending_doc = ""
                continue
            }
            if !self.check(Tk.KwFn) {
                self.set_error("expected `fn` or `type` inside impl block")
                return .Err("parse error")
            }
            // Snapshot the `fn` position BEFORE parsing — the parse advances
            // the cursor past the whole method, so current_line/col would
            // otherwise stamp the method row past its own body.
            let m_line = self.current_line
            let m_col = self.current_column
            let method_id = self.parse_method_declaration(type_name)?
            self.store.stmts.record_pos(method_id, SrcPos { line: m_line, col: m_col, file: self.file })
            // A doc-wrapped method mirrors the top-level converted pattern:
            // the inner decl rides as the Annotated row's id payload.
            mut elem_id = method_id
            if has_pending_doc {
                let doc_annots: List<Annotation> = [Annotation { name: "doc", arg_ids: [self.alloc_leaf(Expr.String("\"${pending_doc}\""))] }]
                elem_id = self.alloc_stmt_leaf(Stmt.Annotated(doc_annots, method_id))
            }
            ids.push(elem_id)
            has_pending_doc = false
            pending_doc = ""
        }
        if has_pending_doc {
            self.set_error("doc comment must precede a method or associated type")
            return .Err("parse error")
        }
        .Ok(MethodsParsed { ids: ids })
    }

    fn parse_method_declaration(self, type_name: string) -> Result<StmtId, string> {
        self.advance()
        let name = self.consume_identifier("expected method name")?
        if !self.consume(Tk.LeftParen, "expected `(` after method name") {
            return .Err("parse error")
        }
        // The first parameter is conventionally `self` (implicitly
        // typed as the impl's owner type). Skip it if present and
        // synthesize a properly-typed self param ourselves.
        let params = self.parse_method_param_list(type_name)?
        if !self.consume(Tk.RightParen, "expected `)` after parameters") {
            return .Err("parse error")
        }
        mut ret_vtype = ValueType.Void
        if self.check(Tk.Arrow) {
            self.advance()
            let te = self.parse_type_expr("expected return type after `->`")?
            ret_vtype = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after method parameters") {
            return .Err("parse error")
        }
        let body = self.parse_statement_list_ids(true)?
        if !self.consume(Tk.RightBrace, "expected `}` after method body") {
            return .Err("parse error")
        }
        let mangled = method_mangled_name(type_name, name)
        let empty_tp: List<TypeParamEntry> = []
        // Walker order: the bare return-type field contributes a TypeRef
        // (body rows are id payloads — no edges; the
        // parse_function_declaration shape).
        let edges: List<NodeRef> = [NodeRef.TypeRef(self.glue_ingest_type(ret_vtype))]
        .Ok(self.alloc_stmt(Stmt.Function(mangled, empty_tp, params, ret_vtype, body.ids), byte_span_none(), edges))
    }

    fn parse_method_param_list(self, type_name: string) -> Result<List<ParamEntry>, string> {
        mut out: List<ParamEntry> = []
        if self.check(Tk.RightParen) {
            return .Ok(out)
        }
        // Detect leading `self` and prepend it as a typed parameter.
        if self.check(Tk.Identifier) && self.current_lexeme == "self" {
            self.advance()
            // Optional `: Type` after self — consumed but not used (self type is inferred from impl block).
            if self.check(Tk.Colon) {
                self.advance()
                self.parse_type_expr("expected type after `:`")?
            }
            // The receiver type is resolved from the impl header — a real
            // type the parser has in hand, so it gets a real (orphan) row.
            out.push(self.param_entry_typed("self", vtype_from_name(type_name)))
            if self.check(Tk.Comma) {
                self.advance()
                let rest = self.parse_param_list()?
                mut i = 0
                while i < rest.length {
                    out.push(rest[i])
                    i = i + 1
                }
            }
            return .Ok(out)
        }
        self.parse_param_list()
    }
}
