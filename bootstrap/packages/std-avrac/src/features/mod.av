// WHY: aggregator for all language features. Each subdirectory is
// one feature with its own parser.av, codegen.av, example.av.
//
// Each feature subdirectory is auto-discovered as a submodule
// (g2eo.1 directory-as-module). This file just imports and
// registers their factory functions.

use features.closures.{closures_feature}
use features.enum_decl.{enum_decl_feature}
use features.extern_decl.{extern_decl_feature}
use features.fn_decl.{fn_decl_feature}
use features.for_stmt.{for_feature, for_in_feature}
use features.grammar.{grammar_feature, Grammar, feature_decl_grammar_fragments}
use features.if_stmt.{if_stmt_feature}
use features.impl_decl.{impl_decl_feature}
use features.is_keyword.{is_keyword_feature}
use features.in_operator.{in_operator_feature}
use features.let_stmt.{let_destructure_feature, let_keyword_feature, const_keyword_feature, mut_keyword_feature}
use features.list_comp.{list_comp_feature}
use features.list_lit.{list_lit_feature}
use features.map_lit.{map_lit_feature}
use features.modules.{mod_feature, use_feature}
use features.null_safety.{null_coalesce_feature, optional_chain_feature, optional_method_call_feature, try_feature, catch_feature}
use features.parallel_stmt.{parallel_feature}
use features.spawn_expr.{spawn_expr_feature}
use features.channels.{channels_feature}
use features.isolated_expr.{isolated_expr_feature}
use features.quote_expr.{quote_expr_feature}
use features.return_stmt.{return_lang}
use features.select_stmt.{select_feature}
use features.spec_test.{spec_feature, given_feature, then_feature}
use features.struct_decl.{struct_lit_feature, field_access_feature, enum_ctor_feature, field_assign_feature, type_decl_feature, shape_decl_feature}
use features.trait_decl.{trait_decl_feature}
use features.tuples.{tuple_feature, tuple_index_feature}
use features.while_stmt.{while_feature}
use features.with_expr.{with_expr_feature}
use features.component_decl.{component_decl_feature}
use core.{register}
use features.defer.{defer_lang, errdefer_lang}
use features.match.{match_lang, when_lang}
use core.{noop_emit_expr, noop_emit_stmt, noop_resolve_expr, noop_resolve_stmt, noop_check_expr, noop_check_stmt, noop_eval_expr, noop_eval_stmt, noop_parse_expr}
use features.grammar.{Rule, build_rule_index, GrammarParse, BuilderBind, BuildKindRow, grammar_startup_fail}

// ── What a feature IS ──
//
// The `LanguageFeature` component: every feature instantiates it to describe
// itself in one place — title, reference docs, the grammar rules it owns,
// the F-codes it can raise, an editor snippet, and its pass hooks. The
// schema lives HERE (the module parent) because component declarations must
// parse before any sibling file instantiates them; the adapter + derived
// surfaces live in lang.av, the instances in one file per feature.

/// One diagnostic a feature owns: the stable F-code, a one-line title, and
/// the explanation `avra explain <code>` renders.
export type DiagSpec = { code: string, title: string, explain: string }

/// Default for features that own no grammar rules — constructed directly
/// (`parse_grammar` rejects rule-less sources by design).
fn no_grammar() -> GrammarParse {
    let rules: List<Rule> = []
    let no_rows: List<BuildKindRow> = []
    GrammarParse { grammar: Grammar { name: "", rules, rule_idx: build_rule_index(rules), builder_kinds: no_rows }, error: "" }
}

export component LanguageFeature {
    config {
        title: string = "",
        docs: string = "",
        gram: GrammarParse = no_grammar(),
        // Which composed VIEW FAMILY this gram's rules join (t-47hc.8): ""
        // means the gram is composed elsewhere (shared multi-family fragments
        // like match's, wired by name in avra_grammar.av) or is empty; "stmt"
        // means the statement views compose it via
        // feature_stmt_grammar_fragments — so a lowering flip is pure
        // feature-file metadata: declare the gram, name its family.
        gram_family: string = "",
        diags: List<DiagSpec> = [],
        snippet: string = "",
        // Build lowerings this feature OWNS (t-kd4y.3): one BuilderBind per
        // build name its gram references that the engine's central tables
        // should NOT carry. Validated against the gram at registry build.
        builders: List<BuilderBind> = [],
        expr_tag: Expr? = null,
        stmt_tag: Stmt? = null,
        expr_keyword: string = "",
        parse_expr: fn(Parser, int) -> Result<ExprId, string> = noop_parse_expr,
        emit_expr: fn(Ctx, List<VarBinding>, Expr) -> Result<EmitValue, string> = noop_emit_expr,
        emit_stmt: fn(Ctx, List<VarBinding>, Stmt) -> Result<StmtResult, string> = noop_emit_stmt,
        resolve_expr: fn(Resolver, Expr) -> Resolver = noop_resolve_expr,
        resolve_stmt: fn(Resolver, Stmt) -> Resolver = noop_resolve_stmt,
        check_expr: fn(TC, Expr) -> ExprResult = noop_check_expr,
        check_stmt: fn(TC, Stmt) -> TC = noop_check_stmt,
        eval_expr: fn(Runtime, Expr) -> StepResult = noop_eval_expr,
        eval_stmt: fn(Runtime, Stmt) -> StepResult = noop_eval_stmt,
    }
}

/// Register every built-in language feature with the compiler's
/// dispatch registry. Called once during compiler init; each
/// feature module exposes a `<name>_feature()` builder. Order
/// doesn't matter — features dispatch by AST tag, not declaration
/// position.
/// Returns the composed builder manifest alongside registration so
/// `build_registry` can store it from the SAME factory run — a second
/// `language_features()` call here re-parses every definition gram, and a
/// registry builds once per NodeStore, so that cost multiplies by the
/// hundreds of stores a package compile creates (the rc-strict +2GB
/// regression this signature exists to prevent).
export fn init_features(reg: Registry) -> List<BuilderBind> {
    // ── Statements ──
    let feats = language_features()
    for f in feats { register_lang(reg, f) }
    let binds = fold_builders(feats)
    register(reg, if_stmt_feature())
    register(reg, while_feature())
    register(reg, for_feature())
    register(reg, for_in_feature())
    register(reg, let_destructure_feature())
    register(reg, select_feature())
    register(reg, parallel_feature())

    // ── Expressions ──
    register(reg, closures_feature())
    register(reg, is_keyword_feature())
    register(reg, in_operator_feature())
    register(reg, spawn_expr_feature())
    register(reg, channels_feature())
    register(reg, isolated_expr_feature())
    register(reg, quote_expr_feature())
    register(reg, with_expr_feature())
    register(reg, tuple_feature())
    register(reg, tuple_index_feature())
    register(reg, list_lit_feature())
    register(reg, list_comp_feature())
    register(reg, map_lit_feature())
    register(reg, null_coalesce_feature())
    register(reg, optional_chain_feature())
    register(reg, optional_method_call_feature())
    register(reg, try_feature())
    register(reg, catch_feature())
    register(reg, struct_lit_feature())
    register(reg, field_access_feature())
    register(reg, enum_ctor_feature())
    register(reg, field_assign_feature())

    // ── Declarations (parse-only) ──
    register(reg, fn_decl_feature())
    register(reg, enum_decl_feature())
    register(reg, impl_decl_feature())
    register(reg, extern_decl_feature())
    register(reg, trait_decl_feature())
    register(reg, type_decl_feature())
    register(reg, shape_decl_feature())
    register(reg, let_keyword_feature())
    register(reg, const_keyword_feature())
    register(reg, mut_keyword_feature())
    register(reg, spec_feature())
    register(reg, given_feature())
    register(reg, then_feature())

    // ── Infrastructure ──
    register(reg, mod_feature())
    register(reg, use_feature())
    register(reg, component_decl_feature())
    register(reg, grammar_feature())
    binds
}

/// Every LanguageFeature definition, in registration order — the ONE list
/// the registry, grammar composition, docs, diagnostics, and editor
/// surfaces fold over. Migrating a feature = writing its definition file
/// and adding it here.
export fn language_features() -> List<LanguageFeature> {
    [defer_lang(), errdefer_lang(), match_lang(), when_lang(), return_lang()]
}

/// The composed builder manifest — every feature-supplied build lowering,
/// in registration order. BOTH engines consume this one fold: the executor
/// via `Registry.builder_binds` (populated by `build_registry`), emit
/// directly at regen time — so the two cannot disagree about who owns a
/// name. A name supplied twice is two features claiming one lowering:
/// hard-fail, same policy as a malformed compiled-in grammar.
export fn feature_builders() -> List<BuilderBind> {
    fold_builders(language_features())
}

/// The one dedup fold both manifest producers share: a build name supplied
/// by two features is one lowering with two owners — hard-fail, naming it.
fn fold_builders(feats: List<LanguageFeature>) -> List<BuilderBind> {
    mut all: List<BuilderBind> = []
    for f in feats {
        for b in f.builders {
            for seen in all {
                if seen.name == b.name {
                    grammar_startup_fail("build `${b.name}` is supplied by two features — one lowering, one owner")
                    return all
                }
            }
            all.push(b)
        }
    }
    all
}

/// The per-feature grammar fragments, folded straight out of the feature
/// DEFINITIONS: every LanguageFeature's non-empty `gram`, in registration
/// order, plus the decl-keyword fragments (collected in
/// features/grammar/avra_grammar.av — the one list the whole-program grammar
/// composes from, so the two views cannot drift).
/// Rule-disjointness is guarded by `fragment_rule_conflicts` in the specs.
export fn feature_grammar_fragments() -> List<Grammar> {
    mut all: List<Grammar> = []
    for f in language_features() {
        // Validate FIRST — a malformed gram must F9999 here, never be
        // silently dropped by the empty-rules filter below.
        let g = feature_gram(f)
        if g.rules.length > 0 { all.push(g) }
    }
    for g in feature_decl_grammar_fragments() {
        all.push(g)
    }
    all
}

/// The STATEMENT-family fragments: every feature whose gram declares
/// `gram_family = "stmt"`, in registration order. The statement views
/// (avra_stmt_flip_grammar / avra_stmt_dispatch_grammar and the §2 shadows)
/// compose this list, so a feature's statement rules live ONLY in its own
/// file — adding one here is a feature-file edit, never a view edit.
export fn feature_stmt_grammar_fragments() -> List<Grammar> {
    mut stmts: List<Grammar> = []
    for f in language_features() {
        if f.gram_family == "stmt" {
            stmts.push(feature_gram(f))
        }
    }
    stmts
}
