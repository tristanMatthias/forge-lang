// WHY: Component expansion — transforms ComponentDef and ComponentBlock
// Avra code (structs, functions, builder calls).
//
// Two categories:
// - Data components (no init hook): generate struct type + factory function
// - Template components (with init hook): inline init body with self-rewriting
//
// self.name → instance name string (implicit, always available)
// self.config.field → resolved config value (user override or schema default)
// self.__parent → parent accumulator variable
// self.__parent_name → parent instance name string

use core.{Expr, Stmt, SExpr, SStmt, sexpr, sexpr_dummy, sstmt, sstmt_at, FieldEntry, FieldInit, ParamEntry, ValueType, CompConfig, CompConfigPair, ChildrenSlot, TypeParamEntry, find_annotation}
use core.{has_fn, find_fn_body}
use list_ops.{list_concat}

// ── Public API ──

/// Public entry: expand every `component` declaration + usage
/// in `stmts`. Two-phase: collect every `ComponentDef` first,
/// then walk the tree splicing in templates / instantiations.
///
/// Empty-registry fast-path: programs that declare zero
/// components (the overwhelming majority — components are a
/// niche UI feature) pay zero cost beyond the registry scan.
/// Without this, `expand_stmt_list` rebuilt the entire stmt
/// tree even when there was nothing to expand (4szi.1 perf
/// pass — every check_source / `bs2 check` call runs this).
export fn expand_components(stmts: List<SStmt>) -> List<SStmt> {
    let reg = collect_component_defs(stmts)
    if reg.length == 0 { return stmts }
    let empty_slots: List<ChildrenSlot> = []
    let root = CompNestCtx { parent_var: "", parent_name: "", parent_children: empty_slots }
    expand_stmt_list(stmts, reg, root)
}

// ── Component definition registry ──

/// Per-program registry entry: one `component` declaration's name +
/// schema + body. The full registry is `List<CompDefEntry>`.
export type CompDefEntry = {
    name: string,
    config: List<CompConfig>,
    children: List<ChildrenSlot>,
    body: List<SStmt>,
}

/// Result of a component lookup. `found` distinguishes hit
/// from miss; the schema + body are zeroed on miss.
///
/// @field found    — 1 when the component was registered.
/// @field config   — its config schema.
/// @field children — its child-slot schema (vez6.7).
/// @field body     — the body AST.
type CompDefLookup = {
    found: bool,
    config: List<CompConfig>,
    children: List<ChildrenSlot>,
    body: List<SStmt>,
}

/// Linear lookup of a component definition by name.
export fn comp_reg_lookup(reg: List<CompDefEntry>, name: string) -> CompDefLookup {
    for e in reg {
        if e.name == name {
            return CompDefLookup { found: true, config: e.config, children: e.children, body: e.body }
        }
    }
    let empty_slots: List<ChildrenSlot> = []
    let empty_cfg: List<CompConfig> = []
    let empty_body: List<SStmt> = []
    CompDefLookup { found: false, config: empty_cfg, children: empty_slots, body: empty_body }
}

/// Walk the AST once collecting every `ComponentDef` into a
/// flat registry. Recurses into modules + function bodies and
/// peels `Annotated` wrappers (doc comments) off each statement.
///
/// vez6.8.5: ComponentDefs annotated with `@expand(macro_fn)` are
/// SKIPPED here — their instances should route through the
/// @expand pipeline (features/comptime/expand_macro.av), not the
/// legacy template path. Skipping them at the registry level means
/// expand_stmt_list's ComponentBlock arm won't find them, so the
/// instance passes through unchanged for expand_macros to consume.
export fn collect_component_defs(stmts: List<SStmt>) -> List<CompDefEntry> {
    mut acc: List<CompDefEntry> = []
    for ss in stmts {
        let has_expand = find_annotation(ss.node, "expand") != null
        let inner = stmt_unwrap_deep(ss.node)
        match inner {
            .ComponentDef(name, _, config, children, _, body) -> {
                if !has_expand { acc = acc.push(CompDefEntry { name, config, children, body }) }
            }
            .Module(_, mod_body) -> acc = list_concat(acc, collect_component_defs(mod_body))
            .Function(_, _, _, _, fn_body) -> acc = list_concat(acc, collect_component_defs(fn_body))
            _ -> {}
        }
    }
    acc
}

/// Extract the names of every registered component. Used by the
/// parser to recognise component instantiations like `<MyComp>(...)`.
export fn comp_reg_names(reg: List<CompDefEntry>) -> List<string> {
    mut acc: List<string> = []
    for e in reg { acc = acc.push(e.name) }
    acc
}

/// Membership test for the comp-name list.
export fn comp_name_has(list: List<string>, name: string) -> bool {
    mut i = 0
    while i < list.length {
        if list[i] == name { return true }
        i = i + 1
    }
    false
}

/// Strip every layer of `Annotated` wrappers from a statement.
/// Component scanning needs the raw statement so doc comments
/// + `@export` etc. don't hide a `ComponentDef` from collection.
fn stmt_unwrap_deep(s: Stmt) -> Stmt {
    match s {
        .Annotated(_, inner) -> stmt_unwrap_deep(inner)
        _ -> s
    }
}

// ── Nesting context ──

/// Nesting context for nested component blocks.
///
/// @field parent_var      — accumulator var of the enclosing block ("" at root).
/// @field parent_name     — instance name of the enclosing block ("" at root).
/// @field parent_children — children-schema of the enclosing parent
///                          ComponentDef. Used by auto-push (vez6.7.6) to
///                          decide which list field a nested ComponentBlock
///                          gets pushed into. Empty at root and for legacy
///                          parents that didn't declare a schema.
export type CompNestCtx = {
    parent_var: string,
    parent_name: string,
    parent_children: List<ChildrenSlot>,
}

// ── Self-rewriting ──

/// Rewrite-time context threaded through the per-instance
/// expansion. Carries the current instance name + parent
/// accumulator so `@self` / `@parent` references resolve.
type RewriteCtx = {
    inst: string,
    parent_var: string,
    parent_name: string,
}

/// Walk a body rewriting every `@self` / `@parent` reference
/// to the right per-instance variable. The entry point for
/// per-instance expansion of a component body.
fn rewrite_self(stmts: List<SStmt>, ctx: RewriteCtx) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        out.push(sstmt_at(rw_stmt(ss.node, ctx), ss.line, ss.col, ss.file))
        i = i + 1
    }
    out
}

/// Per-statement self-rewrite. Recurses into expression
/// payloads + nested bodies; preserves decl-only statements.
fn rw_stmt(stmt: Stmt, ctx: RewriteCtx) -> Stmt {
    match stmt {
        .Expr(e) -> .Expr(rw_expr(e, ctx))
        .Let(name, vt, init) -> .Let(name, vt, rw_expr(init, ctx))
        .Mut(name, vt, init) -> .Mut(name, vt, rw_expr(init, ctx))
        .Return(e) -> .Return(rw_expr(e, ctx))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(rw_expr(cond, ctx), rw_stmt(then_b, ctx), rw_stmt(else_b!, ctx))
            } else {
                .If(rw_expr(cond, ctx), rw_stmt(then_b, ctx), null)
            }
        }
        .Block(body) -> .Block(rewrite_self(body, ctx))
        .While(cond, body) -> .While(rw_expr(cond, ctx), rw_stmt(body, ctx))
        _ -> stmt
    }
}

/// Per-expression self-rewrite. `@self` and `@parent` Ident
/// references rewrite to the matching per-instance var; other
/// shapes recurse into their payloads.
fn rw_expr(expr: Expr, ctx: RewriteCtx) -> Expr {
    match expr {
        .FieldAccess(obj, field) -> {
            match obj {
                .Ident(name) -> {
                    if name == "self" {
                        if field == "__parent" { return Expr.Ident(ctx.parent_var) }
                        if field == "__parent_name" { return Expr.String("\"${ctx.parent_name}\"") }
                        Expr.FieldAccess(Expr.Ident(ctx.inst), field)
                    } else { Expr.FieldAccess(rw_expr(obj, ctx), field) }
                }
                .FieldAccess(inner_obj, inner_field) -> {
                    match inner_obj {
                        .Ident(name) -> {
                            if name == "self" && inner_field == "config" {
                                Expr.FieldAccess(Expr.Ident(ctx.inst), field)
                            } else { Expr.FieldAccess(rw_expr(obj, ctx), field) }
                        }
                        _ -> Expr.FieldAccess(rw_expr(obj, ctx), field)
                    }
                }
                _ -> Expr.FieldAccess(rw_expr(obj, ctx), field)
            }
        }
        .Assign(name, val) -> Expr.Assign(name, rw_expr(val, ctx))
        .FieldAssign(obj, field, val) -> {
            match obj {
                .Ident(name) -> {
                    if name == "self" && field == "__parent" {
                        Expr.Assign(ctx.parent_var, rw_expr(val, ctx))
                    } else { Expr.FieldAssign(rw_expr(obj, ctx), field, rw_expr(val, ctx)) }
                }
                _ -> Expr.FieldAssign(rw_expr(obj, ctx), field, rw_expr(val, ctx))
            }
        }
        .Ident(name) -> if name == "self" { Expr.Ident(ctx.inst) } else { expr }
        .Call(callee, args) -> Expr.Call(rw_expr(callee, ctx), rw_expr_list(args, ctx))
        .Binary(l, op, r) -> Expr.Binary(rw_expr(l, ctx), op, rw_expr(r, ctx))
        .Unary(op, r) -> Expr.Unary(op, rw_expr(r, ctx))
        .Logical(l, op, r) -> Expr.Logical(rw_expr(l, ctx), op, rw_expr(r, ctx))
        .IfExpr(c, t, e) -> Expr.IfExpr(rw_expr(c, ctx), rw_expr(t, ctx), rw_expr(e, ctx))
        .Block(body) -> Expr.Block(rewrite_self(body, ctx))
        _ -> expr
    }
}

/// Map `rw_expr` over a `List<SExpr>`.
fn rw_expr_list(list: List<SExpr>, ctx: RewriteCtx) -> List<SExpr> {
    mut out: List<SExpr> = []
    mut i = 0
    while i < list.length {
        let se = list[i]
        out.push(sexpr(rw_expr(se.node, ctx), se.line, se.col))
        i = i + 1
    }
    out
}

// ── Template self-rewriting (inlines config values) ──

/// Walk a template body substituting every `@cfg.field`
/// reference with the user-supplied config value (falling back
/// to the schema default). Threads the rewrite ctx so nested
/// `@self` references still resolve.
fn rw_template(stmts: List<SStmt>, inst: string, uc: List<CompConfigPair>, schema: List<CompConfig>, ctx: RewriteCtx) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        out.push(sstmt(rw_tpl_stmt(ss.node, inst, uc, schema, ctx), ss.line, ss.col))
        i = i + 1
    }
    out
}

/// Per-statement template rewrite — same shape as `rw_stmt`
/// but with the config substitution active.
fn rw_tpl_stmt(stmt: Stmt, inst: string, uc: List<CompConfigPair>, schema: List<CompConfig>, ctx: RewriteCtx) -> Stmt {
    match stmt {
        .Expr(e) -> .Expr(rw_tpl_expr(e, inst, uc, schema, ctx))
        .Let(name, vt, init) -> .Let(name, vt, rw_tpl_expr(init, inst, uc, schema, ctx))
        .Mut(name, vt, init) -> .Mut(name, vt, rw_tpl_expr(init, inst, uc, schema, ctx))
        .Return(e) -> .Return(rw_tpl_expr(e, inst, uc, schema, ctx))
        .Block(body) -> .Block(rw_template(body, inst, uc, schema, ctx))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(rw_tpl_expr(cond, inst, uc, schema, ctx), rw_tpl_stmt(then_b, inst, uc, schema, ctx), rw_tpl_stmt(else_b!, inst, uc, schema, ctx))
            } else {
                .If(rw_tpl_expr(cond, inst, uc, schema, ctx), rw_tpl_stmt(then_b, inst, uc, schema, ctx), null)
            }
        }
        _ -> stmt
    }
}

/// Per-expression template rewrite. `@cfg.field` references
/// resolve via `resolve_config_value`; other shapes recurse.
fn rw_tpl_expr(expr: Expr, inst: string, uc: List<CompConfigPair>, schema: List<CompConfig>, ctx: RewriteCtx) -> Expr {
    match expr {
        .FieldAccess(obj, field) -> {
            match obj {
                .Ident(name) -> {
                    if name == "self" {
                        if field == "name" { return Expr.String("\"${inst}\"") }
                        if field == "__parent" { return Expr.Ident(ctx.parent_var) }
                        if field == "__parent_name" { return Expr.String("\"${ctx.parent_name}\"") }
                        return resolve_config_value(field, uc, schema)
                    }
                    Expr.FieldAccess(rw_tpl_expr(obj, inst, uc, schema, ctx), field)
                }
                .FieldAccess(inner_obj, inner_field) -> {
                    match inner_obj {
                        .Ident(name) -> {
                            if name == "self" && inner_field == "config" {
                                return resolve_config_value(field, uc, schema)
                            }
                        }
                        _ -> {}
                    }
                    Expr.FieldAccess(rw_tpl_expr(obj, inst, uc, schema, ctx), field)
                }
                _ -> Expr.FieldAccess(rw_tpl_expr(obj, inst, uc, schema, ctx), field)
            }
        }
        .FieldAssign(obj, field, val) -> {
            match obj {
                .Ident(name) -> {
                    if name == "self" && field == "__parent" {
                        return Expr.Assign(ctx.parent_var, rw_tpl_expr(val, inst, uc, schema, ctx))
                    }
                }
                _ -> {}
            }
            Expr.FieldAssign(rw_tpl_expr(obj, inst, uc, schema, ctx), field, rw_tpl_expr(val, inst, uc, schema, ctx))
        }
        .Call(callee, args) -> Expr.Call(rw_tpl_expr(callee, inst, uc, schema, ctx), rw_tpl_expr_list(args, inst, uc, schema, ctx))
        .Binary(l, op, r) -> Expr.Binary(rw_tpl_expr(l, inst, uc, schema, ctx), op, rw_tpl_expr(r, inst, uc, schema, ctx))
        .With(base, overrides) -> Expr.With(rw_tpl_expr(base, inst, uc, schema, ctx), rw_tpl_field_inits(overrides, inst, uc, schema, ctx))
        .StructLit(name, inits) -> Expr.StructLit(name, rw_tpl_field_inits(inits, inst, uc, schema, ctx))
        .Ident(name) -> if name == "self" { Expr.String("\"${inst}\"") } else { expr }
        _ -> expr
    }
}

/// Map `rw_tpl_expr` over every field initializer in a struct
/// literal embedded in a template body.
fn rw_tpl_field_inits(inits: List<FieldInit>, inst: string, uc: List<CompConfigPair>, schema: List<CompConfig>, ctx: RewriteCtx) -> List<FieldInit> {
    mut out: List<FieldInit> = []
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        let new_val = rw_tpl_expr(init.value.node, inst, uc, schema, ctx)
        out.push(FieldInit { name: init.name, value: sexpr(new_val, init.value.line, init.value.col) })
        i = i + 1
    }
    out
}

/// Map `rw_tpl_expr` over a `List<SExpr>` in a template body.
fn rw_tpl_expr_list(list: List<SExpr>, inst: string, uc: List<CompConfigPair>, schema: List<CompConfig>, ctx: RewriteCtx) -> List<SExpr> {
    mut out: List<SExpr> = []
    mut i = 0
    while i < list.length {
        let se = list[i]
        out.push(sexpr(rw_tpl_expr(se.node, inst, uc, schema, ctx), se.line, se.col))
        i = i + 1
    }
    out
}

/// Resolve a `@cfg.field` reference: prefer the user's
/// instantiation override, fall back to the schema's default,
/// finally `Expr.Null` when neither exists.
export fn resolve_config_value(field: string, user_config: List<CompConfigPair>, schema: List<CompConfig>) -> Expr {
    mut i = 0
    while i < user_config.length {
        let pair = user_config[i]
        if pair.key == field { return pair.value }
        i = i + 1
    }
    mut j = 0
    while j < schema.length {
        let entry = schema[j]
        if entry.key == field {
            if entry.default_val != null { return entry.default_val! }
            return Expr.String("\"\"")
        }
        j = j + 1
    }
    Expr.String("\"\"")
}

// ── Helpers ──

/// Upper-case the first character of `s` (ASCII only). Used to
/// derive the synthesized struct's PascalCase name from a
/// component's snake_case identifier.
fn capitalize(s: string) -> string {
    if s.length == 0 { return "" }
    let first = s.substring(0, 1)
    let rest = s.substring(1, s.length)
    let upper = match first {
        "a" -> "A"  "b" -> "B"  "c" -> "C"  "d" -> "D"
        "e" -> "E"  "f" -> "F"  "g" -> "G"  "h" -> "H"
        "i" -> "I"  "j" -> "J"  "k" -> "K"  "l" -> "L"
        "m" -> "M"  "n" -> "N"  "o" -> "O"  "p" -> "P"
        "q" -> "Q"  "r" -> "R"  "s" -> "S"  "t" -> "T"
        "u" -> "U"  "v" -> "V"  "w" -> "W"  "x" -> "X"
        "y" -> "Y"  "z" -> "Z"  _ -> first
    }
    "${upper}${rest}"
}

/// Convert a component's config schema into struct fields for
/// the synthesized backing struct. Each schema entry's
/// declared type becomes a field type.
fn config_to_fields(config: List<CompConfig>) -> List<FieldEntry> {
    // List<FieldEntry> uses .push for forward growth — walk source
    // order, no reversal needed.
    mut out: List<FieldEntry> = []
    mut i = 0
    while i < config.length {
        let entry = config[i]
        out.push(FieldEntry { name: entry.key, resolved: entry.ty_vt })
        i = i + 1
    }
    out
}

/// Convert a config schema to the `Foo { field: cfg.field, …}`
/// FieldInitList used when instantiating the synthesized struct
/// from inside the factory function. Walks back-to-front for the
/// same source-order reason as `config_to_fields`.
fn config_to_factory_inits(config: List<CompConfig>) -> List<FieldInit> {
    // List<FieldInit>.push appends forward — walk source order.
    mut out: List<FieldInit> = []
    mut i = 0
    while i < config.length {
        let entry = config[i]
        let val = if entry.default_val != null { entry.default_val! } else { Expr.Null }
        out.push(FieldInit { name: entry.key, value: sexpr(val, 0, 0) })
        i = i + 1
    }
    out
}

/// Walk a component body collecting every method-shaped fn
/// (i.e. one whose first param is `self`) into a list suitable
/// for inclusion in the synthesized `impl ComponentName { ... }`.
fn extract_methods(body: List<SStmt>, comp_name: string) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < body.length {
        let ss = body[i]
        match ss.node {
            .Function(fn_name, tp, params, rvt, fn_body) -> {
                if !(fn_name == "init" || fn_name == "drop" || fn_name.starts_with("__on_") || fn_name.starts_with("__event_")) {
                    let new_fn = Stmt.Function("${comp_name}_${fn_name}", tp, params, rvt, fn_body)
                    out.push(sstmt(new_fn, ss.line, ss.col))
                }
            }
            _ -> {}
        }
        i = i + 1
    }
    out
}


/// Prepend a single statement onto `rest`, attaching the given
/// line/col span info. Used by the splice helpers when emitting
/// synthetic statements that don't have natural source spans.
fn prepend_stmt(stmt: Stmt, line: int, col: int, rest: List<SStmt>) -> List<SStmt> {
    mut out: List<SStmt> = [sstmt(stmt, line, col)]
    mut i = 0
    while i < rest.length {
        out.push(rest[i])
        i = i + 1
    }
    out
}

/// Wrap a base expression in a struct-literal `with { ... }`
/// override using the supplied config pairs. Used to pass an
/// instance's user config to the factory.
fn apply_config_pairs(base: Expr, config: List<CompConfigPair>) -> Expr {
    if config.length == 0 { return base }
    Expr.With(base, config_pairs_to_field_inits(config))
}

/// Convert a `List<CompConfigPair>` (user instantiation config)
/// into a FieldInitList for direct splicing into a struct
/// literal.
fn config_pairs_to_field_inits(pairs: List<CompConfigPair>) -> List<FieldInit> {
    // List<FieldInit>.push appends forward — walk source order.
    mut out: List<FieldInit> = []
    mut i = 0
    while i < pairs.length {
        let pair = pairs[i]
        out.push(FieldInit { name: pair.key, value: sexpr(pair.value, 0, 0) })
        i = i + 1
    }
    out
}

// ── ComponentDef splice ──

/// Expand a `component Name { ... }` declaration into the
/// triple `type Name`, `impl Name { … }`, and a factory
/// `fn make_name(cfg) -> Name`. Spliced ahead of `rest` so the
/// surrounding code sees the synthesized definitions.
export fn splice_component_def(name: string, params: List<ParamEntry>, config: List<CompConfig>, children: List<ChildrenSlot>, body: List<SStmt>, line: int, col: int, rest: List<SStmt>) -> List<SStmt> {
    // Template components (with init hooks): no type/factory generation
    if has_fn(body, "init") {
        let methods = extract_methods(body, name)
        return list_concat(methods, rest)
    }

    // Data components: generate struct type + factory function
    // Fields: implicit `name` + config + children-slot lists (vez6.7).
    let type_name = capitalize(name)
    let config_fields = config_to_fields(config)
    let with_children = append_children_fields(config_fields, children)
    // Prepend the implicit `name: Str` field. List<FieldEntry> uses
    // forward growth, so build a fresh list starting with `name`,
    // then push every existing entry.
    mut name_field: List<FieldEntry> = []
    name_field.push(FieldEntry { name: "name", resolved: ValueType.Str })
    mut nf_i = 0
    while nf_i < with_children.length {
        name_field.push(with_children[nf_i])
        nf_i = nf_i + 1
    }

    let empty_tp: List<TypeParamEntry> = []
    let type_decl = Stmt.TypeDecl(type_name, empty_tp, name_field)

    // Factory: comp_new(name: string) -> TypeName { TypeName { name, config_defaults..., empty_lists... } }
    let name_param: List<ParamEntry> = [ParamEntry { name: "name", vtype: ValueType.Str }]
    let config_inits = config_to_factory_inits(config)
    let with_child_inits = append_children_inits(config_inits, children)
    // Prepend the implicit `name: name` init. List<FieldInit> grows
    // forward, so build a fresh list with `name` first, then push
    // the existing entries.
    mut name_init: List<FieldInit> = []
    name_init.push(FieldInit { name: "name", value: sexpr(Expr.Ident("name"), 0, 0) })
    mut ni_i = 0
    while ni_i < with_child_inits.length {
        name_init.push(with_child_inits[ni_i])
        ni_i = ni_i + 1
    }
    let struct_lit = Expr.StructLit(type_name, name_init)
    let factory_body: List<SStmt> = [sstmt(Stmt.Return(struct_lit), 0, 0)]
    let factory = Stmt.Function("${name}_new", empty_tp, name_param, ValueType.Struct(type_name, 0), factory_body)

    let methods = extract_methods(body, name)

    mut out: List<SStmt> = [sstmt(type_decl, line, col), sstmt(factory, line, col)]
    let with_methods = list_concat(methods, rest)
    mut wi = 0
    while wi < with_methods.length {
        out.push(with_methods[wi])
        wi = wi + 1
    }
    out
}

// ── vez6.7.6: children-slot fields + auto-push ──

/// Append a `slot_name: List<elem>` FieldList entry for every entry
/// in the children schema. Threads through the existing config/name
/// fields so the resulting struct carries every list slot the
/// component declared.
fn append_children_fields(fields: List<FieldEntry>, children: List<ChildrenSlot>) -> List<FieldEntry> {
    // Copy `fields` then push each child-slot entry. List<T>.push
    // appends in O(1) amortised, so the prior linked-list tail-walk
    // helper (`field_list_append`) is gone — direct push covers it.
    mut out: List<FieldEntry> = []
    mut i = 0
    while i < fields.length {
        out.push(fields[i])
        i = i + 1
    }
    for slot in children {
        out.push(FieldEntry { name: slot.slot_name, resolved: slot.child_ty })
    }
    out
}

/// Initialize each slot to an empty list literal `[]` in the
/// factory's struct literal, paired with the slot field added by
/// `append_children_fields`. Copy + push appends; the prior linked
/// `field_init_list_append` tail-walker is gone (List<T>.push is
/// O(1) amortised).
fn append_children_inits(inits: List<FieldInit>, children: List<ChildrenSlot>) -> List<FieldInit> {
    mut out: List<FieldInit> = []
    mut i = 0
    while i < inits.length {
        out.push(inits[i])
        i = i + 1
    }
    for slot in children {
        let empty_elems: List<SExpr> = []
        let empty_list = sexpr(Expr.ListLit(empty_elems), 0, 0)
        out.push(FieldInit { name: slot.slot_name, value: empty_list })
    }
    out
}

/// Look up the slot name in `schema` whose element type matches
/// `child_comp`. Returns "" when no slot matches — caller treats
/// the empty string as "no auto-push needed".
fn slot_name_for_child(schema: List<ChildrenSlot>, child_comp: string) -> string {
    mut i = 0
    while i < schema.length {
        let entry = schema[i]
        if vtype_elem_name(entry.child_ty) == child_comp { return entry.slot_name }
        i = i + 1
    }
    ""
}

/// Build the auto-push statement: `parent_var.<slot>.push(child_inst)`.
/// Emitted by splice_data_block when the parent's children schema
/// matched the child's type.
fn build_push_stmt(parent_var: string, slot: string, child_inst: string, line: int, col: int) -> SStmt {
    let push_target = Expr.FieldAccess(
        Expr.FieldAccess(Expr.Ident(parent_var), slot),
        "push"
    )
    let push_args: List<SExpr> = [sexpr(Expr.Ident(child_inst), line, col)]
    let push_call = Expr.Call(push_target, push_args)
    sstmt(Stmt.Expr(push_call), line, col)
}

// ── ComponentBlock splice ──

/// Expand a `<Component>(cfg) { children }` block. Looks up the
/// component definition, then dispatches to either
/// `splice_template_block` or `splice_data_block` based on the
/// template-vs-data classification of the body.
export fn splice_component_block(comp: string, inst: string, config: List<CompConfigPair>, body: List<SStmt>, line: int, col: int, rest: List<SStmt>, reg: List<CompDefEntry>, nest: CompNestCtx) -> List<SStmt> {
    let def = comp_reg_lookup(reg, comp)
    // vez6.7: validate every nested ComponentBlock matches a declared
    // child slot. Mismatches are reported via eprintln (proper
    // DiagnosticBag plumbing comes in a follow-up cleanup pass).
    if def.found { validate_children_in_body(comp, def.children, body) }
    let has_init = def.found && has_fn(def.body, "init")

    if has_init {
        return splice_template_block(comp, inst, config, body, line, col, rest, reg, nest, def)
    }
    splice_data_block(comp, inst, config, body, line, col, rest, reg, nest, def)
}

// ── vez6.7: child-type validation ──

/// Walk `body` looking for nested ComponentBlock instantiations and
/// verify each matches a declared slot in `parent_children`. Opt-in
/// only: when the parent declares no `children { ... }` schema (i.e.
/// `parent_children == End`) we don't validate — that's the legacy
/// behaviour where any nested component is permitted. Once the
/// parent opts in, every nested type must match a declared slot or
/// eprintln a diagnostic.
fn validate_children_in_body(parent_comp: string, parent_children: List<ChildrenSlot>, body: List<SStmt>) {
    if parent_children.length == 0 { return }
    validate_children_against_schema(parent_comp, parent_children, body)
}

fn validate_children_against_schema(parent_comp: string, schema: List<ChildrenSlot>, body: List<SStmt>) {
    mut i = 0
    while i < body.length {
        let ss = body[i]
        let inner = stmt_unwrap_deep(ss.node)
        match inner {
            .ComponentBlock(child_comp, _, _, _) -> {
                if slot_name_for_child(schema, child_comp) == "" {
                    eprintln("error: type `${child_comp}` is not a valid child of `${parent_comp}`${schema_hint(schema, parent_comp)}")
                }
            }
            _ -> {}
        }
        i = i + 1
    }
}

/// Extract the element-type name from a slot's `List<T>` ValueType.
/// Returns the empty string when the slot type isn't `List<T>` or
/// `T` isn't a nominal struct/enum — neither shape models "accepts a
/// component instance", so they can't match by definition. Single
/// source of truth used by both slot-name lookup (auto-push +
/// validation) and the diagnostic hint formatter.
fn vtype_elem_name(vt: ValueType) -> string {
    match vt {
        .List(elem) -> {
            match elem {
                .Struct(n, _) -> n
                .Enum(n, _, _) -> n
                _ -> ""
            }
        }
        _ -> ""
    }
}

/// Build a `; expected X (slot1) or Y (slot2)` hint string from the
/// parent's children schema for inclusion in the diagnostic.
fn schema_hint(schema: List<ChildrenSlot>, parent: string) -> string {
    if schema.length == 0 {
        return "; `${parent}` declares no `children { ... }` schema"
    }
    "; expected one of ${join_slot_names(schema)}"
}

fn join_slot_names(schema: List<ChildrenSlot>) -> string {
    mut out = ""
    mut i = 0
    while i < schema.length {
        let entry = schema[i]
        let elem_part = vtype_elem_name(entry.child_ty)
        let elem_str = if elem_part == "" { "?" } else { elem_part }
        if i > 0 { out = out + ", " }
        out = out + "${elem_str} (${entry.slot_name})"
        i = i + 1
    }
    out
}

/// Splice the template-flavour expansion of a component block.
/// The component's body is rewritten via `rw_template` (for
/// `@cfg`) and `rewrite_self` (for `@self`), then the result
/// inlines into the surrounding scope.
fn splice_template_block(comp: string, inst: string, config: List<CompConfigPair>, body: List<SStmt>, line: int, col: int, rest: List<SStmt>, reg: List<CompDefEntry>, nest: CompNestCtx, def: CompDefLookup) -> List<SStmt> {
    let is_root = nest.parent_var == ""
    let accum_var = if is_root { inst } else { nest.parent_var }
    let rw_ctx = RewriteCtx { inst, parent_var: accum_var, parent_name: nest.parent_name }

    mut stmts: List<SStmt> = []

    if has_fn(def.body, "drop") {
        let rewritten = rw_template(find_fn_body(def.body, "drop"), inst, config, def.config, rw_ctx)
        stmts = prepend_stmt(Stmt.Defer(Expr.Block(rewritten)), line, col, stmts)
    }

    if has_fn(def.body, "__on_after_children") {
        let rewritten = rw_template(find_fn_body(def.body, "__on_after_children"), inst, config, def.config, rw_ctx)
        stmts = list_concat(rewritten, stmts)
    }

    let child_nest = CompNestCtx { parent_var: accum_var, parent_name: inst, parent_children: def.children }
    let expanded_body = expand_stmt_list(body, reg, child_nest)
    stmts = list_concat(expanded_body, stmts)

    if has_fn(def.body, "init") {
        let rewritten = rw_template(find_fn_body(def.body, "init"), inst, config, def.config, rw_ctx)
        stmts = list_concat(rewritten, stmts)
    }

    if is_root {
        stmts = prepend_stmt(Stmt.Mut(inst, ValueType.Unknown, Expr.Number("0")), line, col, stmts)
    }

    list_concat(stmts, rest)
}

/// Splice the data-flavour expansion of a component block.
/// Emits a `let inst = <factory>(cfg)` binding plus any nested
/// component blocks expanded recursively under the new
/// nesting context.
fn splice_data_block(comp: string, inst: string, config: List<CompConfigPair>, body: List<SStmt>, line: int, col: int, rest: List<SStmt>, reg: List<CompDefEntry>, nest: CompNestCtx, def: CompDefLookup) -> List<SStmt> {
    let rw_ctx = RewriteCtx { inst, parent_var: nest.parent_var, parent_name: nest.parent_name }

    let call_args: List<SExpr> = [sexpr(Expr.String("\"${inst}\""), 0, 0)]
    let call_expr = Expr.Call(
        Expr.Ident("${comp}_new"),
        call_args
    )
    let init_expr = apply_config_pairs(call_expr, config)

    mut stmts: List<SStmt> = []

    if def.found && has_fn(def.body, "drop") {
        let rewritten = rewrite_self(find_fn_body(def.body, "drop"), rw_ctx)
        stmts = prepend_stmt(Stmt.Defer(Expr.Block(rewritten)), line, col, stmts)
    }

    if def.found && has_fn(def.body, "__on_after_children") {
        let rewritten = rewrite_self(find_fn_body(def.body, "__on_after_children"), rw_ctx)
        stmts = list_concat(rewritten, stmts)
    }

    // Children expand inside this block see THIS instance as their
    // parent (so auto-push targets `inst.<slot>`), and inherit the
    // current component's children schema for slot resolution.
    let child_nest = CompNestCtx { parent_var: inst, parent_name: inst, parent_children: def.children }
    let expanded_body = expand_stmt_list(body, reg, child_nest)
    stmts = list_concat(expanded_body, stmts)

    if def.found && has_fn(def.body, "init") {
        let rewritten = rewrite_self(find_fn_body(def.body, "init"), rw_ctx)
        stmts = list_concat(rewritten, stmts)
    }

    // Auto-push (vez6.7.6): if this nested instance fills a slot in
    // the enclosing parent's children schema, emit
    // `parent_var.<slot>.push(inst)` after the let binding so the
    // accumulator picks it up.
    let push_slot = slot_name_for_child(nest.parent_children, comp)
    let with_push: List<SStmt> = if push_slot != "" && nest.parent_var != "" {
        mut wp: List<SStmt> = [build_push_stmt(nest.parent_var, push_slot, inst, line, col)]
        let tail = list_concat(stmts, rest)
        mut wpi = 0
        while wpi < tail.length {
            wp.push(tail[wpi])
            wpi = wpi + 1
        }
        wp
    } else {
        list_concat(stmts, rest)
    }

    // When the component declares a children schema, the binding must
    // be `mut` so the auto-push (`inst.<slot>.push(child)`) emitted by
    // nested ComponentBlocks compiles — the resolver rejects mutating
    // methods on immutable bindings.
    let binding = if has_any_slot(def.children) {
        Stmt.Mut(inst, ValueType.Unknown, init_expr)
    } else {
        Stmt.Let(inst, ValueType.Unknown, init_expr)
    }
    mut out: List<SStmt> = [sstmt(binding, line, col)]
    mut oi = 0
    while oi < with_push.length {
        out.push(with_push[oi])
        oi = oi + 1
    }
    out
}

fn has_any_slot(schema: List<ChildrenSlot>) -> bool {
    schema.length > 0
}

// ── Statement list expansion (called by desugar) ──

/// Recursive expansion driver: walk every statement,
/// dispatching `ComponentDef` to `splice_component_def` and
/// `ComponentBlock` to `splice_component_block`. Other
/// statements pass through untouched.
///
/// vez6.8.5: when a stmt carries `@expand(macro)`, the legacy
/// template path defers to the macro pipeline (expand_macros,
/// runs later in the compile sequence). The annotated stmt
/// passes through unchanged here; ComponentBlock instances of
/// @expand'd defs likewise pass through because their parent
/// def is absent from `reg` (collect_component_defs skipped it).
export fn expand_stmt_list(stmts: List<SStmt>, reg: List<CompDefEntry>, nest: CompNestCtx) -> List<SStmt> {
    // Walk backward so that splice_* helpers — which take the
    // already-expanded tail as their `rest` — see the right successor.
    mut tail: List<SStmt> = []
    mut i = stmts.length - 1
    while i >= 0 {
        let ss = stmts[i]
        let has_expand = find_annotation(ss.node, "expand") != null
        if has_expand {
            mut new_tail: List<SStmt> = [ss]
            mut ti = 0
            while ti < tail.length {
                new_tail.push(tail[ti])
                ti = ti + 1
            }
            tail = new_tail
            i = i - 1
            continue
        }
        let inner = stmt_unwrap_deep(ss.node)
        tail = match inner {
            .ComponentDef(name, params, config, children, _, body) -> {
                splice_component_def(name, params, config, children, body, ss.line, ss.col, tail)
            }
            .ComponentBlock(comp, inst, config, body) -> {
                let lookup = comp_reg_lookup(reg, comp)
                if !lookup.found {
                    // Component def absent from registry — either
                    // legitimately undefined (caught later) or
                    // routed through @expand. Pass through.
                    mut nt: List<SStmt> = [ss]
                    mut ti = 0
                    while ti < tail.length {
                        nt.push(tail[ti])
                        ti = ti + 1
                    }
                    nt
                } else {
                    splice_component_block(comp, inst, config, body, ss.line, ss.col, tail, reg, nest)
                }
            }
            _ -> {
                // Recurse into nested statement lists. Preserve
                // SStmt.file so g2eo's per-file metadata path can
                // attribute decls to their origin file.
                let expanded_stmt = expand_stmt(ss.node, reg, nest)
                mut nt: List<SStmt> = [sstmt_at(expanded_stmt, ss.line, ss.col, ss.file)]
                mut ti = 0
                while ti < tail.length {
                    nt.push(tail[ti])
                    ti = ti + 1
                }
                nt
            }
        }
        i = i - 1
    }
    tail
}

/// Per-statement expansion. Recurses into module / fn / impl /
/// block bodies so component blocks at any nesting depth are
/// spliced in place.
fn expand_stmt(stmt: Stmt, reg: List<CompDefEntry>, nest: CompNestCtx) -> Stmt {
    match stmt {
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, expand_stmt_list(body, reg, nest))
        .Block(body) -> .Block(expand_stmt_list(body, reg, nest))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(cond, expand_stmt(then_b, reg, nest), expand_stmt(else_b!, reg, nest))
            } else {
                .If(cond, expand_stmt(then_b, reg, nest), null)
            }
        }
        .While(cond, body) -> .While(cond, expand_stmt(body, reg, nest))
        .For(v, start, end, body) -> .For(v, start, end, expand_stmt(body, reg, nest))
        .ForIn(v, coll, body) -> .ForIn(v, coll, expand_stmt(body, reg, nest))
        .Module(name, body) -> .Module(name, expand_stmt_list(body, reg, nest))
        .Annotated(annots, inner) -> .Annotated(annots, expand_stmt(inner, reg, nest))
        _ -> stmt
    }
}
