// WHY: Component expansion — transforms `component` declarations and
// instance blocks into plain Avra.
//
// Data components ONLY: a `component foo { config {…} children {…} }`
// declaration becomes `type Foo` + `fn foo_new(name) -> Foo` + one free
// fn per body method; an instance block `foo inst { … }` becomes
// `let inst = foo_new("inst") with { overrides }` plus recursive child
// expansion and auto-push into the parent's children slots. Anything
// richer (per-instance behaviour, trait impls, generated dispatch) is
// library-authored via `@expand(macro)` — annotated defs and their
// instances pass through untouched for the comptime macro pipeline
// (features/comptime/expand_macro.av) to consume. The former template
// flavour (init-body inlining, `self.__parent` accumulator threading,
// `__on_*` event hooks) is gone per the Components V2 design (§3.8):
// construction is the factory, post-construction work is an explicit
// method call, and children land in typed list fields.

use core.{Expr, Stmt, FieldEntry, FieldInit, ParamEntry, ValueType, CompConfig, CompConfigPair, ChildrenSlot, TypeParamEntry, find_annotation, vtype_struct}
use core.{NodeStore, StmtId, ExprId, SrcPos}
use diagnostics.{DiagnosticBag, DiagCode, bag_new, bag_report, diag_error, span_at}
use list_ops.{list_concat, list_map}

/// Allocate a synthesized statement row carrying `(line, col)` and an
/// empty file — the id-native equivalent of the old `sstmt(node, line,
/// col)` wrapper (which likewise dropped the file). Synthesized nodes
/// have no originating source file, so diagnostics on them cite the
/// component decl's line/col only.
fn synth_row(store: NodeStore, node: Stmt, line: int, col: int) -> StmtId {
    let id = store.stmts.add_leaf(node)
    store.stmts.record_pos(id, SrcPos { line: line, col: col, file: "" })
    id
}

// ── Public API ──

/// Result of expanding component decls + instances. `stmts` is the
/// rewritten AST; `bag` carries any child-slot validation diagnostics
/// (F4100). Callers (check_source / build_binary / cli/main.av)
/// render bag through the unified renderer.
export type ComponentExpandResult = {
    stmts: List<StmtId>,
    bag: DiagnosticBag,
}

/// Public entry: expand every `component` declaration + usage in
/// `stmts`. Two-phase: validate child-slot constraints into the bag
/// (F4100), then splice in component definitions / instances. The
/// split keeps the splicer pure and lets the validator return a
/// bag without threading it through every helper. The validator
/// walks against `collect_component_defs(stmts)` — the same
/// registry the splicer uses — so they agree on which parents have
/// schemas.
///
/// Empty-registry fast-path: programs that declare zero components
/// (the overwhelming majority — components are a niche UI feature)
/// pay zero cost beyond the registry scan. Without this,
/// `expand_stmt_list` rebuilt the entire stmt tree even when there
/// was nothing to expand (4szi.1 perf pass — every check_source /
/// `bs2 check` call runs this).
/// B-final: the whole pass is arena-id-native — the program vector
/// arrives as `List<StmtId>` (the flipped inject_intrinsics upstream hands
/// ids straight in), the registry scan / validator / splicer all thread
/// ids, and it leaves as `List<StmtId>` (derive_marshal downstream takes
/// ids). The empty-registry fast-path returns the original `ids`
/// unchanged (identity); the spliced path allocates rewritten/synthesized
/// rows into the store.
export fn expand_components(ids: List<StmtId>, store: NodeStore) -> ComponentExpandResult {
    let reg = collect_component_defs(store, ids)
    if reg.length == 0 { return ComponentExpandResult { stmts: ids, bag: bag_new() } }
    let bag = validate_component_tree(store, ids, reg)
    let empty_slots: List<ChildrenSlot> = []
    let root = CompNestCtx { parent_var: "", parent_children: empty_slots }
    let spliced = expand_stmt_list(store, ids, reg, root)
    ComponentExpandResult { stmts: spliced, bag }
}

// ── Component definition registry ──

/// Per-program registry entry: one `component` declaration's name +
/// schema + body. The full registry is `List<CompDefEntry>`.
type CompDefEntry = {
    name: string,
    config: List<CompConfig>,
    children: List<ChildrenSlot>,
    body: List<StmtId>,
}

/// Result of a component lookup. `found` distinguishes hit
/// from miss; the schema + body are zeroed on miss.
///
/// @field found    — 1 when the component was registered.
/// @field config   — its config schema.
/// @field children — its child-slot schema (vez6.7).
/// @field body     — the body AST.
type CompDefLookup = {
    found: bool,
    config: List<CompConfig>,
    children: List<ChildrenSlot>,
    body: List<StmtId>,
}

/// Linear lookup of a component definition by name.
fn comp_reg_lookup(reg: List<CompDefEntry>, name: string) -> CompDefLookup {
    for e in reg {
        if e.name == name {
            return CompDefLookup { found: true, config: e.config, children: e.children, body: e.body }
        }
    }
    let empty_slots: List<ChildrenSlot> = []
    let empty_cfg: List<CompConfig> = []
    let empty_body: List<StmtId> = []
    CompDefLookup { found: false, config: empty_cfg, children: empty_slots, body: empty_body }
}

/// Walk the AST once collecting every `ComponentDef` into a
/// flat registry. Recurses into modules + function bodies and
/// peels `Annotated` wrappers (doc comments) off each statement.
///
/// vez6.8.5: ComponentDefs annotated with `@expand(macro_fn)` are
/// SKIPPED here — their instances should route through the
/// @expand pipeline (features/comptime/expand_macro.av), not this
/// data-component path. Skipping them at the registry level means
/// expand_stmt_list's ComponentBlock arm won't find them, so the
/// instance passes through unchanged for expand_macros to consume.
fn collect_component_defs(store: NodeStore, stmts: List<StmtId>) -> List<CompDefEntry> {
    mut acc: List<CompDefEntry> = []
    for id in stmts {
        let node = store.stmts.get(id)
        let has_expand = find_annotation(store, node, "expand") != null
        let inner = stmt_unwrap_deep(store, node)
        match inner {
            .ComponentDef(name, _, config, children, _, body) -> {
                if !has_expand { acc = acc.push(CompDefEntry { name, config, children, body: body }) }
            }
            .Module(_, mod_body) -> acc = list_concat(acc, collect_component_defs(store, mod_body))
            .Function(_, _, _, _, fn_body) -> acc = list_concat(acc, collect_component_defs(store, fn_body))
            _ -> {}
        }
    }
    acc
}

/// Strip every layer of `Annotated` wrappers from a statement.
/// Component scanning needs the raw statement so doc comments
/// + `@export` etc. don't hide a `ComponentDef` from collection.
fn stmt_unwrap_deep(store: NodeStore, s: Stmt) -> Stmt {
    match s {
        .Annotated(_, inner) -> stmt_unwrap_deep(store, store.stmts.get(inner))
        _ -> s
    }
}

// ── Nesting context ──

/// Nesting context for nested component blocks.
///
/// @field parent_var      — instance var of the enclosing block ("" at root).
/// @field parent_children — children-schema of the enclosing parent
///                          ComponentDef. Used by auto-push (vez6.7.6) to
///                          decide which list field a nested ComponentBlock
///                          gets pushed into. Empty at root and for legacy
///                          parents that didn't declare a schema.
type CompNestCtx = {
    parent_var: string,
    parent_children: List<ChildrenSlot>,
}

// ── Helpers ──

/// Upper-case the first character of `s` (ASCII only). Used to
/// derive the synthesized struct's PascalCase name from a
/// component's snake_case identifier.
fn capitalize(s: string) -> string {
    if s.length == 0 { return "" }
    let first = s.substring(0, 1)
    let rest = s.substring(1, s.length)
    let upper = match first {
        "a" -> "A"  "b" -> "B"  "c" -> "C"  "d" -> "D"
        "e" -> "E"  "f" -> "F"  "g" -> "G"  "h" -> "H"
        "i" -> "I"  "j" -> "J"  "k" -> "K"  "l" -> "L"
        "m" -> "M"  "n" -> "N"  "o" -> "O"  "p" -> "P"
        "q" -> "Q"  "r" -> "R"  "s" -> "S"  "t" -> "T"
        "u" -> "U"  "v" -> "V"  "w" -> "W"  "x" -> "X"
        "y" -> "Y"  "z" -> "Z"  _ -> first
    }
    "${upper}${rest}"
}

/// Convert a component's config schema into struct fields for
/// the synthesized backing struct. Each schema entry's
/// declared type becomes a field type.
fn config_to_fields(config: List<CompConfig>) -> List<FieldEntry> {
    list_map(config, (entry: CompConfig) -> FieldEntry { name: entry.key, resolved: entry.ty_vt })
}

/// Convert a config schema to the `Foo { field: cfg.field, …}`
/// FieldInitList used when instantiating the synthesized struct
/// from inside the factory function.
fn config_to_factory_inits(store: NodeStore, config: List<CompConfig>) -> List<FieldInit> {
    list_map(config, (entry: CompConfig) -> FieldInit {
        name: entry.key,
        value_id: store.exprs.add_leaf(if entry.default_id != none { store.exprs.get(entry.default_id!) } else { Expr.None }),
    })
}

/// Walk a component body collecting every fn declaration into a
/// prefixed free function (`fn describe` in `component user` becomes
/// `fn user_describe`). No name is special: `init`/`drop` receive no
/// hook treatment — construction is the factory, cleanup is the Drop
/// trait, post-construction work is an explicit method call.
fn extract_methods(store: NodeStore, body: List<StmtId>, comp_name: string) -> List<StmtId> {
    mut out: List<StmtId> = []
    mut i = 0
    while i < body.length {
        let id = body[i]
        match store.stmts.get(id) {
            .Function(fn_name, tp, params, rvt, fn_body) -> {
                let new_fn = Stmt.Function("${comp_name}_${fn_name}", tp, params, rvt, fn_body)
                let p = store.stmt_pos(id)
                out.push(synth_row(store, new_fn, p.line, p.col))
            }
            _ -> {}
        }
        i = i + 1
    }
    out
}

/// Wrap a base expression in a struct-literal `with { ... }`
/// override using the supplied config pairs. Used to pass an
/// instance's user config to the factory.
fn apply_config_pairs(store: NodeStore, base: Expr, config: List<CompConfigPair>) -> Expr {
    if config.length == 0 { return base }
    // Flipped With.obj is an ExprId — ingest the base leaf.
    Expr.With(store.exprs.add_leaf(base), config_pairs_to_field_inits(store, config))
}

/// Convert a `List<CompConfigPair>` (user instantiation config)
/// into a FieldInitList for direct splicing into a struct
/// literal.
fn config_pairs_to_field_inits(store: NodeStore, pairs: List<CompConfigPair>) -> List<FieldInit> {
    // List<FieldInit>.push appends forward — walk source order.
    mut out: List<FieldInit> = []
    mut i = 0
    while i < pairs.length {
        let pair = pairs[i]
        out.push(FieldInit { name: pair.key, value_id: store.exprs.add_leaf(pair.value) })
        i = i + 1
    }
    out
}

// ── ComponentDef splice ──

/// Expand a `component Name { ... }` declaration into the
/// triple `type Name`, its prefixed method fns, and a factory
/// `fn name_new(name) -> Name`. Spliced ahead of `rest` so the
/// surrounding code sees the synthesized definitions.
fn splice_component_def(store: NodeStore, name: string, params: List<ParamEntry>, config: List<CompConfig>, children: List<ChildrenSlot>, body: List<StmtId>, line: int, col: int, rest: List<StmtId>) -> List<StmtId> {
    // Fields: implicit `name` + config + children-slot lists (vez6.7).
    let type_name = capitalize(name)
    let config_fields = config_to_fields(config)
    let with_children = append_children_fields(config_fields, children)
    // Prepend the implicit `name: Str` field. List<FieldEntry> uses
    // forward growth, so build a fresh list starting with `name`,
    // then push every existing entry.
    mut name_field: List<FieldEntry> = []
    name_field.push(FieldEntry { name: "name", resolved: ValueType.Str })
    mut nf_i = 0
    while nf_i < with_children.length {
        name_field.push(with_children[nf_i])
        nf_i = nf_i + 1
    }

    let empty_tp: List<TypeParamEntry> = []
    let type_decl = Stmt.TypeDecl(type_name, empty_tp, name_field)

    // Factory: comp_new(name: string) -> TypeName { TypeName { name, config_defaults..., empty_lists... } }
    let name_param: List<ParamEntry> = [ParamEntry { name: "name", vtype: ValueType.Str }]
    let config_inits = config_to_factory_inits(store, config)
    let with_child_inits = append_children_inits(store, config_inits, children)
    // Prepend the implicit `name: name` init. List<FieldInit> grows
    // forward, so build a fresh list with `name` first, then push
    // the existing entries.
    mut name_init: List<FieldInit> = []
    name_init.push(FieldInit { name: "name", value_id: store.exprs.add_leaf(Expr.Ident("name")) })
    mut ni_i = 0
    while ni_i < with_child_inits.length {
        name_init.push(with_child_inits[ni_i])
        ni_i = ni_i + 1
    }
    let struct_lit = Expr.StructLit(type_name, name_init)
    let factory_body: List<StmtId> = [store.stmts.add_leaf(Stmt.Return(store.exprs.add_leaf(struct_lit)))]
    let factory = Stmt.Function("${name}_new", empty_tp, name_param, vtype_struct(type_name, 0), factory_body)

    let methods = extract_methods(store, body, name)

    mut out: List<StmtId> = [synth_row(store, type_decl, line, col), synth_row(store, factory, line, col)]
    let with_methods = list_concat(methods, rest)
    mut wi = 0
    while wi < with_methods.length {
        out.push(with_methods[wi])
        wi = wi + 1
    }
    out
}

// ── vez6.7.6: children-slot fields + auto-push ──

/// Append a `slot_name: List<elem>` FieldList entry for every entry
/// in the children schema. Threads through the existing config/name
/// fields so the resulting struct carries every list slot the
/// component declared.
fn append_children_fields(fields: List<FieldEntry>, children: List<ChildrenSlot>) -> List<FieldEntry> {
    // Copy `fields` then push each child-slot entry. List<T>.push
    // appends in O(1) amortised, so the prior linked-list tail-walk
    // helper (`field_list_append`) is gone — direct push covers it.
    mut out: List<FieldEntry> = []
    mut i = 0
    while i < fields.length {
        out.push(fields[i])
        i = i + 1
    }
    for slot in children {
        out.push(FieldEntry { name: slot.slot_name, resolved: slot.child_ty })
    }
    out
}

/// Initialize each slot to an empty list literal `[]` in the
/// factory's struct literal, paired with the slot field added by
/// `append_children_fields`. Copy + push appends; the prior linked
/// `field_init_list_append` tail-walker is gone (List<T>.push is
/// O(1) amortised).
fn append_children_inits(store: NodeStore, inits: List<FieldInit>, children: List<ChildrenSlot>) -> List<FieldInit> {
    mut out: List<FieldInit> = []
    mut i = 0
    while i < inits.length {
        out.push(inits[i])
        i = i + 1
    }
    for slot in children {
        let empty_elems: List<ExprId> = []
        let empty_list_id = store.exprs.add_leaf(Expr.ListLit(empty_elems))
        out.push(FieldInit { name: slot.slot_name, value_id: empty_list_id })
    }
    out
}

/// Look up the slot name in `schema` whose element type matches
/// `child_comp`. Returns "" when no slot matches — caller treats
/// the empty string as "no auto-push needed".
fn slot_name_for_child(schema: List<ChildrenSlot>, child_comp: string) -> string {
    mut i = 0
    while i < schema.length {
        let entry = schema[i]
        if vtype_elem_name(entry.child_ty) == child_comp { return entry.slot_name }
        i = i + 1
    }
    ""
}

/// Build the auto-push statement: `parent_var.<slot>.push(child_inst)`.
/// Emitted by splice_component_block when the parent's children schema
/// matched the child's type.
fn build_push_stmt(store: NodeStore, parent_var: string, slot: string, child_inst: string, line: int, col: int) -> StmtId {
    let push_target = Expr.FieldAccess(
        store.exprs.add_leaf(Expr.FieldAccess(store.exprs.add_leaf(Expr.Ident(parent_var)), slot)),
        "push"
    )
    let push_call = Expr.Call(store.exprs.add_leaf(push_target), [store.exprs.add_leaf(Expr.Ident(child_inst))])
    synth_row(store, Stmt.Expr(store.exprs.add_leaf(push_call)), line, col)
}

// ── vez6.7: child-type validation ──

/// Pre-splice walker that emits F4100 diagnostics for every nested
/// ComponentBlock whose type isn't declared in the parent's
/// `children { ... }` schema. Returns the accumulated bag for the
/// caller to render through the unified diagnostic path. Pure
/// (no side effects); the splicer ignores validation and processes
/// every ComponentBlock regardless — error rendering happens via
/// the bag, not via eprintln-on-the-fly.
fn validate_component_tree(store: NodeStore, stmts: List<StmtId>, reg: List<CompDefEntry>) -> DiagnosticBag {
    mut bag = bag_new()
    for id in stmts {
        bag = validate_stmt(store, id, reg, bag)
    }
    bag
}

fn validate_stmt(store: NodeStore, id: StmtId, reg: List<CompDefEntry>, in_bag: DiagnosticBag) -> DiagnosticBag {
    let inner = stmt_unwrap_deep(store, store.stmts.get(id))
    let mut bag = in_bag
    match inner {
        .ComponentBlock(comp, _, _, body) -> {
            let def = comp_reg_lookup(reg, comp)
            if def.found && def.children.length > 0 {
                let p = store.stmt_pos(id)
                bag = validate_children_bag(store, comp, def.children, body, p.line, p.col, p.file, bag)
            }
            // Recurse into body to catch nested-of-nested mismatches.
            for child in body {
                bag = validate_stmt(store, child, reg, bag)
            }
        }
        .ComponentDef(_, _, _, _, _, body) -> {
            for child in body {
                bag = validate_stmt(store, child, reg, bag)
            }
        }
        .Module(_, body) -> {
            for child in body {
                bag = validate_stmt(store, child, reg, bag)
            }
        }
        .Function(_, _, _, _, body) -> {
            for child in body {
                bag = validate_stmt(store, child, reg, bag)
            }
        }
        .Block(body) -> {
            for child in body {
                bag = validate_stmt(store, child, reg, bag)
            }
        }
        _ -> {}
    }
    bag
}

fn validate_children_bag(store: NodeStore, parent_comp: string, schema: List<ChildrenSlot>, body: List<StmtId>, line: int, col: int, file: string, in_bag: DiagnosticBag) -> DiagnosticBag {
    mut bag = in_bag
    mut i = 0
    while i < body.length {
        let id = body[i]
        let inner = stmt_unwrap_deep(store, store.stmts.get(id))
        match inner {
            .ComponentBlock(child_comp, _, _, _) -> {
                if slot_name_for_child(schema, child_comp) == "" {
                    let p = store.stmt_pos(id)
                    bag = bag_report(bag, diag_error(
                        DiagCode.ComponentChildInvalid,
                        "type `${child_comp}` is not a valid child of `${parent_comp}`${schema_hint(schema, parent_comp)}",
                        span_at(0, 0, p.line, p.col, p.file)
                    ))
                }
            }
            _ -> {}
        }
        i = i + 1
    }
    bag
}

/// Extract the element-type name from a slot's `List<T>` ValueType.
/// Returns the empty string when the slot type isn't `List<T>` or
/// `T` isn't a nominal struct/enum — neither shape models "accepts a
/// component instance", so they can't match by definition. Single
/// source of truth used by both slot-name lookup (auto-push +
/// validation) and the diagnostic hint formatter.
fn vtype_elem_name(vt: ValueType) -> string {
    match vt {
        .List(elem) -> {
            match elem {
                .Struct(n, _, _) -> n
                .Enum(n, _, _) -> n
                _ -> ""
            }
        }
        _ -> ""
    }
}

/// Build a `; expected X (slot1) or Y (slot2)` hint string from the
/// parent's children schema for inclusion in the diagnostic.
fn schema_hint(schema: List<ChildrenSlot>, parent: string) -> string {
    if schema.length == 0 {
        return "; `${parent}` declares no `children { ... }` schema"
    }
    "; expected one of ${join_slot_names(schema)}"
}

fn join_slot_names(schema: List<ChildrenSlot>) -> string {
    mut out = ""
    for (i, entry) in schema.enumerate() {
        let elem_part = vtype_elem_name(entry.child_ty)
        let elem_str = if elem_part == "" { "?" } else { elem_part }
        if i > 0 { out = out + ", " }
        out = out + "${elem_str} (${entry.slot_name})"
    }
    out
}

// ── ComponentBlock splice ──

/// Expand a `<comp> <inst> { config, children }` instance block.
/// Emits a `let inst = <comp>_new("inst") with { overrides }` binding,
/// expands nested component blocks recursively under this instance's
/// nesting context, and auto-pushes the instance into the enclosing
/// parent's matching children slot. Child-type validation ran earlier
/// in `validate_component_tree` (diagnostics land in the bag, not on
/// stderr) — the splicer just splices.
fn splice_component_block(store: NodeStore, comp: string, inst: string, config: List<CompConfigPair>, body: List<StmtId>, line: int, col: int, rest: List<StmtId>, reg: List<CompDefEntry>, nest: CompNestCtx) -> List<StmtId> {
    let def = comp_reg_lookup(reg, comp)

    let call_expr = Expr.Call(
        store.exprs.add_leaf(Expr.Ident("${comp}_new")),
        [store.exprs.add_leaf(Expr.String("\"${inst}\""))]
    )
    let init_expr = apply_config_pairs(store, call_expr, config)

    // Children expand inside this block see THIS instance as their
    // parent (so auto-push targets `inst.<slot>`), and inherit the
    // current component's children schema for slot resolution.
    let child_nest = CompNestCtx { parent_var: inst, parent_children: def.children }
    let stmts = expand_stmt_list(store, body, reg, child_nest)

    // Auto-push (vez6.7.6): if this nested instance fills a slot in
    // the enclosing parent's children schema, emit
    // `parent_var.<slot>.push(inst)` after the let binding so the
    // accumulator picks it up.
    let push_slot = slot_name_for_child(nest.parent_children, comp)
    let with_push: List<StmtId> = if push_slot != "" && nest.parent_var != "" {
        mut wp: List<StmtId> = [build_push_stmt(store, nest.parent_var, push_slot, inst, line, col)]
        let tail = list_concat(stmts, rest)
        mut wpi = 0
        while wpi < tail.length {
            wp.push(tail[wpi])
            wpi = wpi + 1
        }
        wp
    } else {
        list_concat(stmts, rest)
    }

    // When the component declares a children schema, the binding must
    // be `mut` so the auto-push (`inst.<slot>.push(child)`) emitted by
    // nested ComponentBlocks compiles — the resolver rejects mutating
    // methods on immutable bindings.
    let binding = if has_any_slot(def.children) {
        Stmt.Mut(inst, ValueType.Unknown, store.exprs.add_leaf(init_expr))
    } else {
        Stmt.Let(inst, ValueType.Unknown, store.exprs.add_leaf(init_expr))
    }
    mut out: List<StmtId> = [synth_row(store, binding, line, col)]
    mut oi = 0
    while oi < with_push.length {
        out.push(with_push[oi])
        oi = oi + 1
    }
    out
}

fn has_any_slot(schema: List<ChildrenSlot>) -> bool {
    schema.length > 0
}

// ── Statement list expansion ──

/// Recursive expansion driver: walk every statement,
/// dispatching `ComponentDef` to `splice_component_def` and
/// `ComponentBlock` to `splice_component_block`. Other
/// statements pass through untouched.
///
/// vez6.8.5: when a stmt carries `@expand(macro)`, this pass
/// defers to the macro pipeline (expand_macros, runs later in
/// the compile sequence). The annotated stmt passes through
/// unchanged here; ComponentBlock instances of @expand'd defs
/// likewise pass through because their parent def is absent
/// from `reg` (collect_component_defs skipped it).
fn expand_stmt_list(store: NodeStore, stmts: List<StmtId>, reg: List<CompDefEntry>, nest: CompNestCtx) -> List<StmtId> {
    // Walk backward so that splice_* helpers — which take the
    // already-expanded tail as their `rest` — see the right successor.
    mut tail: List<StmtId> = []
    mut i = stmts.length - 1
    while i >= 0 {
        let id = stmts[i]
        let node = store.stmts.get(id)
        let has_expand = find_annotation(store, node, "expand") != null
        if has_expand {
            mut new_tail: List<StmtId> = [id]
            mut ti = 0
            while ti < tail.length {
                new_tail.push(tail[ti])
                ti = ti + 1
            }
            tail = new_tail
            i = i - 1
            continue
        }
        let p = store.stmt_pos(id)
        let inner = stmt_unwrap_deep(store, node)
        tail = match inner {
            .ComponentDef(name, params, config, children, _, body) -> {
                splice_component_def(store, name, params, config, children, body, p.line, p.col, tail)
            }
            .ComponentBlock(comp, inst, config, body) -> {
                let lookup = comp_reg_lookup(reg, comp)
                if !lookup.found {
                    // Component def absent from registry — either
                    // legitimately undefined (caught later) or
                    // routed through @expand. Pass through.
                    mut nt: List<StmtId> = [id]
                    mut ti = 0
                    while ti < tail.length {
                        nt.push(tail[ti])
                        ti = ti + 1
                    }
                    nt
                } else {
                    splice_component_block(store, comp, inst, config, body, p.line, p.col, tail, reg, nest)
                }
            }
            _ -> {
                // Recurse into nested statement lists. Re-allocate
                // against the source row so g2eo's per-file metadata
                // path keeps attributing decls to their origin file.
                let expanded_stmt = expand_stmt(store, node, reg, nest)
                mut nt: List<StmtId> = [store.restmt(expanded_stmt, id)]
                mut ti = 0
                while ti < tail.length {
                    nt.push(tail[ti])
                    ti = ti + 1
                }
                nt
            }
        }
        i = i - 1
    }
    tail
}

/// Per-statement expansion. Recurses into module / fn / impl /
/// block bodies so component blocks at any nesting depth are
/// spliced in place.
fn expand_stmt(store: NodeStore, stmt: Stmt, reg: List<CompDefEntry>, nest: CompNestCtx) -> Stmt {
    match stmt {
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, expand_stmt_list(store, body, reg, nest))
        .Block(body) -> .Block(expand_stmt_list(store, body, reg, nest))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(cond, expand_stmt_id(store, then_b, reg, nest), expand_stmt_id(store, else_b!, reg, nest))
            } else {
                .If(cond, expand_stmt_id(store, then_b, reg, nest), null)
            }
        }
        .While(cond, body) -> .While(cond, expand_stmt_id(store, body, reg, nest))
        .For(v, start, end, body) -> .For(v, start, end, expand_stmt_id(store, body, reg, nest))
        .ForIn(v, coll, body) -> .ForIn(v, coll, expand_stmt_id(store, body, reg, nest))
        .Module(name, body) -> .Module(name, expand_stmt_list(store, body, reg, nest))
        .Annotated(annots, inner) -> .Annotated(annots, expand_stmt_id(store, inner, reg, nest))
        _ -> stmt
    }
}

/// Row twin of `expand_stmt`: resolve, expand, re-allocate.
fn expand_stmt_id(store: NodeStore, id: StmtId, reg: List<CompDefEntry>, nest: CompNestCtx) -> StmtId {
    store.restmt(expand_stmt(store, store.stmts.get(id), reg, nest), id)
}
