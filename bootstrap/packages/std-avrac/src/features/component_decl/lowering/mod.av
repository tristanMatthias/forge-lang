// The component_decl feature's LOWERINGS — the definition/instantiation
// cores + their ABI adapters + manifest rows (t-kd4y.3.3.5, the largest
// decl family: thirteen rows). This module imports ONLY features.grammar +
// core — the F4012 import-closure invariant holds by construction.
//
// ONE core stays central: `mk_component_def_with_params` (the shared
// definition body) REGISTERS the component name for keyword-free
// instantiation through the host Parser, whose type lives in the `parse`
// module — importing it here would put `parse` in a lowering's closure
// while `parse` (gen_parser.av) imports every lowering: a module cycle.
// So the registration core is EXPORTED from features.grammar (the
// binding_stmt_row / fn_decl_edges precedent) and the two thin def cores
// here drive it — one implementation, no new module edges.
use core.{BuildName, ModulePath, ChildrenSlot, CompConfig, CompConfigPair, Expr, ExprId, ParamEntry, Stmt, StmtId, Tk, TypeParamEntry, ValueType, byte_span_none, type_expr_to_vtype}
use features.grammar.{PState, CapVal, Token, BuilderBind, bind_row, bind_rows, binding_stmt_row, capval_present, capval_to_children_slot_list, capval_to_comp_config_list, capval_to_comp_config_pair_list, capval_to_expr, capval_to_pentry_list, capval_to_stmt_list, capval_to_texpr, capval_tok_list, capval_tok_text, capval_tok_texts, expr_id_is_error, fn_decl_edges, mk_component_def_with_params, BuildKind, GKind}

/// One `key: ty ( = default )?` config-schema entry — the MkCompConfig
/// build's core. Mirrors the retired parse_comp_config_schema's row exactly,
/// including the `glue_ingest_type` dual (ty_vt + ty_id).
export fn mk_comp_config_g(st: PState, key: string, ty_cv: CapVal, d_cv: CapVal, d_present: bool) -> CapVal {
    let vt = type_expr_to_vtype(capval_to_texpr(st, ty_cv))
    let default_id: ExprId? = if d_present { capval_to_expr(st, d_cv) } else { none }
    CapVal.CCfg(CompConfig { key: key, ty_vt: vt, default_id: default_id, ty_id: st.store.ingest_type(vt, byte_span_none()) })
}

export fn mk_comp_config_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_comp_config_g(st, capval_tok_text(vals[0]), vals[1], vals[2], capval_present(vals[2]))
}

/// One `slot: ty` children-schema entry — the MkChildrenSlot build's core.
export fn mk_children_slot_g(st: PState, slot: string, ty_cv: CapVal) -> CapVal {
    CapVal.CSlot(ChildrenSlot { slot_name: slot, child_ty: type_expr_to_vtype(capval_to_texpr(st, ty_cv)) })
}

export fn mk_children_slot_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_children_slot_g(st, capval_tok_text(vals[0]), vals[1])
}

/// The component-body `let field: ty ( = init )?` row — the MkCompField
/// build's core. NOT the general binding: the annotation is REQUIRED (the
/// grammar rule enforces it) and the row is the hand's `alloc_binding_stmt`
/// (TypeRef edge), with an Expr.None initializer when none was written.
export fn mk_comp_field_g(st: PState, name: string, ty_cv: CapVal, init_cv: CapVal, init_present: bool) -> CapVal {
    let vt = type_expr_to_vtype(capval_to_texpr(st, ty_cv))
    let init_id = if init_present { capval_to_expr(st, init_cv) } else { st.store.exprs.add_leaf(Expr.None) }
    CapVal.SNode(binding_stmt_row(st, Stmt.Let(name, vt, init_id), vt))
}

export fn mk_comp_field_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_comp_field_g(st, capval_tok_text(vals[0]), vals[1], vals[2], capval_present(vals[2]))
}

/// The `config { … }` / `children { … }` blocks' values — the entries the
/// enclosing component build folds in. Explicit builds because a rule that
/// yields a LIST cannot rely on a build-less sequence to carry its
/// accumulator out as the rule's result (see `mk_trait_list`).
export fn mk_comp_config_list(v: CapVal) -> CapVal {
    CapVal.CCfgs(capval_to_comp_config_list(v))
}

export fn mk_comp_config_list_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_comp_config_list(vals[0])
}

export fn mk_children_slot_list(v: CapVal) -> CapVal {
    CapVal.CSlots(capval_to_children_slot_list(v))
}

export fn mk_children_slot_list_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_children_slot_list(vals[0])
}

/// `body: <type>` — the raw-token-body marker, validated WHERE IT IS PARSED:
/// the only valid type is `TokenStream`, anything else reports and aborts
/// (the `@gate` at the reference site carries the abort out), so the
/// component never reaches its closing `}` and the stray-`}` diagnostic can
/// appear.
export fn mk_comp_body_marker(st: PState, marker: string) -> CapVal {
    if marker != "TokenStream" {
        st.report("`body:` in a component declares a raw token body — the only valid type is `TokenStream`, got `${marker}`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    CapVal.Tok(Token { kind: GKind.IDENT, text: marker, pos: st.cur().pos, tk: Tk.Identifier })
}

export fn mk_comp_body_marker_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_comp_body_marker(st, capval_tok_text(vals[0]))
}

/// The `implements A, B` clause's value — the trait NAMES as a token list.
/// A rule that yields a list needs an explicit build; a build-less sequence
/// does not reliably carry its accumulator out as the rule's result.
export fn mk_trait_list(v: CapVal) -> CapVal {
    CapVal.Toks(capval_tok_list(v))
}

export fn mk_trait_list_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_trait_list(vals[0])
}

/// `component NAME ( params ) { config? body }` — the LEGACY paren form.
/// It differs from the brace form in exactly two ways: it carries
/// PARAMETERS, and it admits no `children` block and no `body:` marker. So
/// it is the shared definition core with the params filled in — the
/// registration + validation logic must not exist twice.
export fn mk_component_paren_def_g(st: PState, name: string, params_cv: CapVal, implements: List<string>, cfg_cv: CapVal, body: List<StmtId>) -> CapVal {
    let ps = capval_to_pentry_list(params_cv)
    mk_component_def_with_params(st, name, ps, implements, cfg_cv, CapVal.Nil, "", false, body)
}

export fn mk_component_paren_def_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_component_paren_def_g(st, capval_tok_text(vals[0]), vals[1], capval_tok_texts(vals[2]), vals[3], capval_to_stmt_list(vals[4]))
}

/// `component name [implements …] { config? children? body:TokenStream? … }`
/// — the MkComponentDef build's core (modern form). The shared central core
/// validates the marker/children exclusion, synthesizes the marker's Let
/// row, and REGISTERS the name for keyword-free instantiation through the
/// host Parser (see the module WHY for why that core stays central).
export fn mk_component_def_g(st: PState, name: string, implements: List<string>, cfg_cv: CapVal, cs_cv: CapVal, marker: string, marker_present: bool, body: List<StmtId>) -> CapVal {
    let empty_p: List<ParamEntry> = []
    mk_component_def_with_params(st, name, empty_p, implements, cfg_cv, cs_cv, marker, marker_present, body)
}

export fn mk_component_def_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_component_def_g(st, capval_tok_text(vals[0]), capval_tok_texts(vals[1]), vals[2], vals[3], capval_tok_text(vals[4]), capval_present(vals[4]), capval_to_stmt_list(vals[5]))
}

/// One `key value` / `key = expr` INSTANTIATION config pair — the
/// MkCompConfigPair build's core. CompConfigPair carries the value as a
/// boxed `Expr` rather than an ExprId, so the captured node is read back out
/// of the store. Which surface form produced it is already decided by the
/// `@peek` gate on the branch.
export fn mk_comp_config_pair_g(st: PState, key: string, value_id: ExprId) -> CapVal {
    // A FAILED value makes the pair a failure, so `@onfail(bail)` at the
    // reference site can end the instantiation — `component C inst { key = }`
    // never reaches its closing brace, leaving the `}` for the caller to
    // report. Building a CPair around an error node swallowed it.
    if expr_id_is_error(st, value_id) { return CapVal.Node(st.error_node_silent()) }
    CapVal.CPair(CompConfigPair { key: key, value: st.store.exprs.get(value_id) })
}

export fn mk_comp_config_pair_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_comp_config_pair_g(st, capval_tok_text(vals[0]), capval_to_expr(st, vals[1]))
}

/// The `component C inst { pairs… body… }` INSTANTIATION — a LEAF row:
/// Stmt.ComponentBlock is walker-opaque, so the body ids deliberately do
/// not become arena edges. RAW-BODY instances have their own core below —
/// the decision between them is registry state, made in the
/// `comp_nested_raw_*` conds rather than here.
export fn mk_component_block_g(st: PState, name: string, instance: string, pairs: List<CompConfigPair>, body: List<StmtId>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ComponentBlock(name, instance, pairs, body)))
}

export fn mk_component_block_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_component_block_g(st, capval_tok_text(vals[0]), capval_tok_text(vals[1]), capval_to_comp_config_pair_list(vals[2]), capval_to_stmt_list(vals[3]))
}

/// A NESTED instance of a `body: TokenStream` component. The verbatim slice
/// arrives already scanned by `@rawbrace`, so the only work left is the
/// exact two-row shape: a `TokenBody` leaf wrapped in a config-pair-less
/// `ComponentBlock`.
export fn mk_raw_component_block_g(st: PState, name: string, instance: string, raw: string) -> CapVal {
    let empty_cfg: List<CompConfigPair> = []
    let body_ids: List<StmtId> = [st.store.stmts.add_leaf(Stmt.TokenBody(raw))]
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ComponentBlock(name, instance, empty_cfg, body_ids)))
}

export fn mk_raw_component_block_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_raw_component_block_g(st, capval_tok_text(vals[0]), capval_tok_text(vals[1]), capval_tok_text(vals[2]))
}

/// `name() { … }` inside a component-instance body — the METHOD SHORTHAND
/// (spec §4.1), parsed as a NULLARY `Function` that the `@expand` macro
/// later rewrites into a real signature. The `Int` return and the
/// `fn_decl_edges` allocation are load-bearing: an `add_leaf` here would
/// drop the return-type edge and silently change what the walker traverses.
export fn mk_method_shorthand_g(st: PState, name: string, body: List<StmtId>) -> CapVal {
    let empty_tp: List<TypeParamEntry> = []
    let empty_p: List<ParamEntry> = []
    let ret = ValueType.Int
    CapVal.SNode(st.store.stmts.add(Stmt.Function(name, empty_tp, empty_p, ret, body), fn_decl_edges(st, ret), byte_span_none()))
}

export fn mk_method_shorthand_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_method_shorthand_g(st, capval_tok_text(vals[0]), capval_to_stmt_list(vals[1]))
}

/// ALL of the component feature's rows — span-free (leaf rows and schema
/// values; the statement-list loop stamps the outermost node).
export fn component_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.component_decl.lowering"), [bind_row(BuildName("MkComponentDef"), BuildKind.Stmt, 6, false, "mk_component_def_abi", mk_component_def_abi),
     bind_row(BuildName("MkComponentParenDef"), BuildKind.Stmt, 5, false, "mk_component_paren_def_abi", mk_component_paren_def_abi),
     bind_row(BuildName("MkComponentBlock"), BuildKind.Stmt, 4, false, "mk_component_block_abi", mk_component_block_abi),
     bind_row(BuildName("MkRawComponentBlock"), BuildKind.Stmt, 3, false, "mk_raw_component_block_abi", mk_raw_component_block_abi),
     bind_row(BuildName("MkMethodShorthand"), BuildKind.Stmt, 2, false, "mk_method_shorthand_abi", mk_method_shorthand_abi),
     bind_row(BuildName("MkCompField"), BuildKind.Stmt, 3, false, "mk_comp_field_abi", mk_comp_field_abi),
     bind_row(BuildName("MkCompBodyMarker"), BuildKind.Tok, 1, false, "mk_comp_body_marker_abi", mk_comp_body_marker_abi),
     bind_row(BuildName("MkTraitList"), BuildKind.Toks, 1, false, "mk_trait_list_abi", mk_trait_list_abi),
     bind_row(BuildName("MkCompConfig"), BuildKind.Ccfg, 3, false, "mk_comp_config_abi", mk_comp_config_abi),
     bind_row(BuildName("MkCompConfigPair"), BuildKind.Cpair, 2, false, "mk_comp_config_pair_abi", mk_comp_config_pair_abi),
     bind_row(BuildName("MkCompConfigList"), BuildKind.Ccfgs, 1, false, "mk_comp_config_list_abi", mk_comp_config_list_abi),
     bind_row(BuildName("MkChildrenSlot"), BuildKind.Cslot, 2, false, "mk_children_slot_abi", mk_children_slot_abi),
     bind_row(BuildName("MkChildrenSlotList"), BuildKind.Cslots, 1, false, "mk_children_slot_list_abi", mk_children_slot_list_abi)])
}
