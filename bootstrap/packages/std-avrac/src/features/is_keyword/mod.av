// dir-as-module (g2eo.1): codegen.av + lowering/ auto-load as siblings,
// surface flat at `features.is_keyword.{...}`.
use core.{feature_new, Feature, ExprId}
use resolve.{resolve_expr}
use features.grammar.{parse_grammar}
use features.is_keyword.codegen.{emit_is_check}
use features.is_keyword.lowering.{is_keyword_builds}
use features.eval.{eval_expr, ok_result, error_result, value_bool, Runtime, StepResult, step_had_error, step_runtime, step_value, value_is_enumish}
use typeck.{check_expr, tc_er}

/// `x is .Some` — the runtime variant check (produces a Bool). The
/// definition carries `is_tail`, one branch of the spine's `eq_tail`
/// dispatch (t-kd4y.3.5.7): the rule builds a PARTIAL `IsCheck` whose
/// subject is a MISSING sentinel, and the `equality` stratum's rebind_eq
/// (features/struct_decl) installs the real subject. Wired to the
/// resolver, type-checker, codegen, and the @comptime evaluator via the
/// standard tag-based dispatch. `gram_family = "expr"`.
export fn is_keyword_lang() -> LanguageFeature {
    LanguageFeature is_keyword_def {
        name = "is",
        title = "is — runtime variant check",
        docs = """
`value is .Variant` is true when an enum value currently holds that
variant. Mutually exclusive with `==` chains and `in` at the same
precedence — one check per comparison.
""",
        gram = grammar {
  is_tail = "is" "." v:IDENT
            @expect(".", "expected `.Variant` after `is`") -> mk_is(v)
        },
        builders = is_keyword_builds(),
        snippet = r"${1:value} is .${2:Variant}",
        expr_tag = Expr.IsCheck(ExprId(0), ""),
        emit_expr = emit_is_check,
        resolve_expr = is_resolve,
        check_expr = is_check,
        eval_expr = is_eval,
        gram_family = "expr",
    }
    is_keyword_def
}

/// Resolver hook for `IsCheck`. The variant name on the right-hand
/// side resolves later (during typeck against the enum type), so
/// here we only need to walk the subject expression.
fn is_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .IsCheck(subject, _) -> resolve_expr(r, r.nodes.exprs.get(subject))
        _ -> r
    }
}

/// Type-check hook for `IsCheck`. Walks the subject (so its
/// errors are reported), then declares the result Bool — variant
/// existence is verified separately by the enum exhaustiveness
/// check.
fn is_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .IsCheck(subject, _) -> {
            let s = check_expr(tc, tc.nodes.exprs.get(subject))
            tc_er(s.tc, .Bool)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// @comptime eval hook for `IsCheck`. so07.7.6 needed `k is .Scalar`
/// inside derive_walker; the noop_eval_expr dispatch was firing
/// 'no eval_expr handler' because no feature registered an eval for
/// IsCheck. Eval the subject, compare its enum_variant to the
/// pattern's variant name. Non-enum subjects always evaluate false
/// (matches runtime semantics).
fn is_eval(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .IsCheck(subject, variant_name) -> {
            let s = eval_expr(rt, rt.nodes.exprs.get(subject))
            if step_had_error(s) { return s }
            let v = step_value(s)
            let matched = value_is_enumish(v) && v.enum_variant == variant_name
            ok_result(step_runtime(s), value_bool(matched))
        }
        _ -> error_result(rt, "is_eval: expected IsCheck expression")
    }
}
