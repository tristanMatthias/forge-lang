// The `is` feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Expr}
use resolve.{Resolver, resolve_expr}

/// Resolver hook for `IsCheck`. The variant name on the right-hand
/// side resolves later (during typeck against the enum type), so
/// here we only need to walk the subject expression.
fn is_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .IsCheck(subject, _) -> resolve_expr(r, r.nodes.exprs.get(subject))
        _ -> r
    }
}
