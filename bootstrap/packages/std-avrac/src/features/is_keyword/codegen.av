// WHY: codegen for `expr is .Variant` — checks enum tag at runtime.

use core.ast.{Expr, VarEnv, variant_lookup, vtype_display, vtype_enum_name}
use codegen.{Ctx, EmitValue, err_emit, ok_emit}

/// Codegen entry for the `is` operator. Pattern-matches the
/// `IsCheck` AST node and forwards to `emit_is_check_inner`.
export fn emit_is_check(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .IsCheck(subject, vname) -> emit_is_check_inner(ctx, env, subject, vname)
        _ -> err_emit("expected IsCheck")
    }
}

/// Inner emitter: evaluate the subject, look up the variant's tag
/// hash, and compare the loaded tag to the constant. Returns Bool.
/// Errors when the subject isn't an enum or the named variant
/// doesn't exist on its enum.
fn emit_is_check_inner(ctx: Ctx, env: VarEnv, subject: Expr, vname: string) -> Result<EmitValue, string> {
    let r = ctx.emit(env, subject)?
    let enum_name = vtype_enum_name(r.ty)
    if enum_name == "" {
        return err_emit("`is` requires an enum value, got `${vtype_display(r.ty)}`")
    }
    let lookup = ctx.lookup_enum(enum_name)
    if !lookup.found {
        return err_emit("unknown enum `${enum_name}`")
    }
    let v = variant_lookup(lookup.variants, vname)
    if !v.found {
        return err_emit("unknown variant `${vname}` in enum `${enum_name}`")
    }
    let tag = ctx.enum_tag(r.value, enum_name)
    ok_emit(ctx.icmp_eq(tag, ctx.i64(v.tag), "is_eq"), .Bool)
}
