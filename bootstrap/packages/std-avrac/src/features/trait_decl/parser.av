// WHY: parses `trait Name { fn method(self) -> Type ... }` declarations.
// Methods are stored as ExternFn statements (signatures only, no body).
// The trait declaration itself is a no-op at codegen — the methods
// are implemented by `impl Trait for Type { ... }` blocks.

use core.{Stmt, TypeParamEntry, ValueType, type_expr_to_vtype, StmtId, SrcPos}
use parse.{Parser}
use core.{Tk}

/// One parse of a trait body: the arena rows backing each element, in
/// source order — the TraitDecl payload (F3a: element ids ARE the children).
type TraitMethodsParsed = {
    ids: List<StmtId>,
}

impl Parser {
    fn parse_trait_declaration(self) -> Result<StmtId, string> {
        self.advance()  // consume `trait`
        let name = self.consume_identifier("expected trait name")?
        // Optional generic parameters: trait Name<T> { ... }
        if self.check(Tk.Less) {
            self.skip_angle_brackets()
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after trait name") {
            return .Err("parse error")
        }
        let methods = self.parse_trait_methods()?
        if !self.consume(Tk.RightBrace, "expected `}` after trait body") {
            return .Err("parse error")
        }
        .Ok(self.alloc_stmt_leaf(Stmt.TraitDecl(name, methods.ids)))
    }

    // Parse method signatures and associated type declarations inside a trait body.
    // Methods are stored as ExternFn (name, params, ret_ty) — they have no body.
    // Associated types are stored as AssocType(name, "").
    // Every element is a boxed producer (signature stmts) — each is bridged
    // whole via glue_ingest_stmt; only the TraitDecl node itself is native.
    fn parse_trait_methods(self) -> Result<TraitMethodsParsed, string> {
        mut ids: List<StmtId> = []
        while !self.check(Tk.RightBrace) {
            // Associated type declaration: `type Name`
            if self.check(Tk.KwType) {
                let line = self.current_line
                let col = self.current_column
                self.advance()
                let name = self.consume_identifier("expected associated type name")?
                let assoc = Stmt.AssocType(name, ValueType.Unknown)
                let assoc_id = self.glue_ingest_stmt(assoc)
                self.store.stmts.record_pos(assoc_id, SrcPos { line: line, col: col, file: self.file })
                ids.push(assoc_id)
                continue
            }
            let method = self.parse_trait_method_sig()?
            let method_id = self.glue_ingest_stmt(method)
            self.store.stmts.record_pos(method_id, SrcPos { line: self.current_line, col: self.current_column, file: self.file })
            ids.push(method_id)
        }
        .Ok(TraitMethodsParsed { ids: ids })
    }

    fn parse_trait_method_sig(self) -> Result<Stmt, string> {
        if !self.consume(Tk.KwFn, "expected `fn` in trait method") {
            return .Err("parse error")
        }
        let name = self.consume_identifier("expected method name")?
        // Optional generic parameters on the method itself
        if self.check(Tk.Less) {
            self.skip_angle_brackets()
        }
        if !self.consume(Tk.LeftParen, "expected `(` after method name") {
            return .Err("parse error")
        }
        let params = self.parse_param_list()?
        if !self.consume(Tk.RightParen, "expected `)` after parameters") {
            return .Err("parse error")
        }
        mut ret_vtype = ValueType.Void
        if self.check(Tk.Arrow) {
            self.advance()
            let te = self.parse_type_expr("expected return type after `->`")?
            ret_vtype = type_expr_to_vtype(te)
        }
        // Default method: if there's a body `{ ... }`, parse it as a Function.
        // Otherwise it's a signature only (ExternFn).
        if self.check(Tk.LeftBrace) {
            self.advance()
            let body = self.parse_statement_list_ids(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after default method body") {
                return .Err("parse error")
            }
            let empty_tp: List<TypeParamEntry> = []
            return .Ok(Stmt.Function(name, empty_tp, params, ret_vtype, body.ids))
        }
        .Ok(Stmt.ExternFn(name, params, ret_vtype))
    }
}
