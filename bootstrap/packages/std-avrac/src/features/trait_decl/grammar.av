// WHY: t-47hc slice 9 — the decl-keyword half of the per-feature grammar
// FRAGMENT registry (see features/fn_decl/grammar.av for the full rationale).
// The `trait` feature owns its declaration rule AND its member sub-structure:
// the associated-type member (`type Item`) and the method member, whose body is
// OPTIONAL (`tmlb` present distinguishes a defaulted method from a signature).
use features.grammar.{parse_grammar, grammar_checked, Grammar}

/// The `trait` declaration and its member rules.
export fn avra_trait_decl_grammar() -> Grammar {
    let gp = grammar {
  trait_decl  = @try "trait" @cut @require trname:IDENT ( "<" tparam ( "," tparam )* ">" )? @require "{" ( @peek(not_rbrace) @gate tmembers:trait_member )* @require "}"
                @expect("IDENT", "expected trait name")
                @expect("{", "expected `{` after trait name")
                @expect("}", "expected `}` after trait body") -> MkTraitDecl(trname, tmembers)
  trait_member  = assoc_member | method_member
  // Both members COMMIT after their keyword, and both had to: without a `@require`
  // on the name each one consumed whatever token was present, on the promise that
  // its caller proved FIRST. `trait T { type }` bound the `}` AS THE ASSOCIATED TYPE
  // NAME and built `(assoc-type })`; `trait T { fn m( }` built a whole member,
  // `(extern m () -> void)`, out of a header that never closed. The hand aborts both
  // and builds nothing, so these were silent ACCEPTS of invalid input — the same
  // class as the gated `enum E { 5 }`, reached through a different door.
  assoc_member  = @try "type" @cut @require atname:IDENT
                  @expect("IDENT", "expected associated type name") -> MkAssocType(atname)
  method_member = @try "fn" @cut @require tmname:IDENT @require "(" ( tmparams:param ( @peek(comma_not_rparen) "," tmparams:param )* ( "," )? )? @require ")" ( "->" tmret:type_expr )? ( tmlb:"{" tmbody:body_item* "}" )?
                  @expect("IDENT", "expected method name")
                  @expect("(", "expected `(` after method name")
                  @expect(")", "expected `)` after method parameters") -> MkTraitMethod(tmname, tmparams, tmret, tmlb, tmbody)
    }
    grammar_checked(gp)
}
