// WHY: parses `parallel { body }` blocks.

use parse.{Parser}
use core.{Stmt}
use core.{Tk}

impl Parser {
    fn parse_parallel_statement(self) -> Result<Stmt, string> {
        self.advance()  // consume `parallel`
        if !self.consume(Tk.LeftBrace, "expected `{` after parallel") {
            return .Err("parse error")
        }
        let body = self.parse_statement_list(true)?
        if !self.consume(Tk.RightBrace, "expected `}` to close parallel block") {
            return .Err("parse error")
        }
        .Ok(Stmt.Parallel(body))
    }
}
