// WHY: parses `parallel { body }` blocks.

use parse.{Parser}
use core.{Stmt, byte_span_none}
use core.{Tk}

impl Parser {
    fn parse_parallel_statement(self) -> Result<StmtId, string> {
        self.advance()  // consume `parallel`
        if !self.consume(Tk.LeftBrace, "expected `{` after parallel") {
            return .Err("parse error")
        }
        let body = self.parse_statement_list_ids(true)?
        if !self.consume(Tk.RightBrace, "expected `}` to close parallel block") {
            return .Err("parse error")
        }
        // Walker order: one StmtRef per body statement.
        .Ok(self.alloc_stmt(Stmt.Parallel(body.wrapped), byte_span_none(), self.edges_of_stmt_ids(body.ids)))
    }
}
