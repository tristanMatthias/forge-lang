// WHY: t-kd4y.3.2.4 — the `parallel` keyword's grammar FRAGMENT, owned by
// the feature that owns the keyword (see features/fn_decl/grammar.av for
// the registry's full rationale). The rule moved here verbatim from the
// central §-view; `declaration` is a cross-fragment reference that binds by
// name after the merge, exactly as `variant` already references `field`.
use features.grammar.{Grammar, grammar_checked, parse_grammar}

/// The `parallel { … }` block. A keyword + a brace-delimited statement list
/// held as RAW ids under a LEAF Parallel row (parse_statement_list_ids →
/// Stmt.Parallel(ids) — no Block wrapper).
export fn avra_parallel_grammar() -> Grammar {
    let gp = grammar {
  parallel_decl = @try "parallel" @cut @require "{" body:declaration* @require "}"
                  @expect("{", "expected `{` after parallel")
                  @expect("}", "expected `}` to close parallel block") -> MkParallel(body)
    }
    grammar_checked(gp)
}
