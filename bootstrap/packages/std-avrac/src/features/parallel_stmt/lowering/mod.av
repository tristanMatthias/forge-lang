// The parallel feature's LOWERING — the ABI fn + its manifest row, in a
// dedicated SUBMODULE so the generated parser imports it directly
// (t-kd4y.3 Batch A shape). Only features.grammar + core are imported —
// both already in every generated parser's closure — so the F4012
// import-closure invariant holds by construction; the feature's passes
// and hooks stay in ../mod.av.

use core.{Stmt}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_to_stmt_list, BuildKind}

/// `parallel { … }` (`MkParallel`, arity 1). The statement list is held as
/// RAW ids under a LEAF Parallel row — the hand's
/// `alloc_stmt_leaf(Stmt.Parallel(body.ids))`, no Block wrapper. The body
/// capture is a repetition, so it arrives wrapped (CapVal.SNodes from the
/// generated parser's accumulator, the executor's env value otherwise) and
/// `capval_to_stmt_list` unwraps both singleton-preservingly.
export fn parallel_build(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Parallel(capval_to_stmt_list(vals[0]))))
}

export fn parallel_builds() -> List<BuilderBind> {
    bind_rows("features.parallel_stmt.lowering", [bind_row("MkParallel", BuildKind.Stmt, 1, false, "parallel_build", parallel_build)])
}
