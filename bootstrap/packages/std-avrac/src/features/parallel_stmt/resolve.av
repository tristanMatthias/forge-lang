// The `parallel { … }` feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Stmt}
use resolve.{Resolver, resolve_stmt_ids}

/// Resolver hook for `parallel { ... }`. Walks the body's statement
/// list so name resolution still happens inside the parallel block.
fn parallel_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Parallel(body) -> resolve_stmt_ids(r, body), _ -> r }
}
