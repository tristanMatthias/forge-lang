// WHY: feature registration for `spawn { body }` expression.
// Per spec Axis 18: green-thread task spawning.
//
// dir-as-module (g2eo.1): codegen.av + parser.av auto-load as siblings,
// surface flat at `features.spawn_expr.{...}`.
use core.{ExprId}
use typeck.{check_expr, tc_er}
use features.grammar.{parse_grammar}

/// `spawn { body }` — the definition carries the feature whole
/// (t-kd4y.3.5.1): syntax, docs, its one lowering, and the pass hooks.
/// Yields a typed `Task<T>` handle (T = the body's result type; ps3t.4.8)
/// that is auto-awaited at scope exit. Spec Axis 18 (concurrency).
/// `gram_family = "expr"`: the expression views compose the rule; the
/// spine's `unary` alternation references `spawn_expr` by name. The
/// `@expect` is declared twice, keyed both ways, because the rule lives in
/// a FRAGMENT: `block_expr` is external here, so the standalone gram cannot
/// derive its single-literal FIRST and `@require` on the ref demands a
/// rule-NAME key (the quote_expr precedent); composed, the token-keyed
/// message is the one both engines read.
@language_feature
export fn spawn_lang() -> LanguageFeature {
    LanguageFeature spawn_def {
        name = "spawn",
        title = "spawn — green-thread task spawning",
        docs = """
`spawn { body }` runs the block as a concurrent green-thread task and
yields a `Task<T>` handle (T = the body's result type). Tasks are
auto-awaited at scope exit; `.await` / `.cancel()` control them
explicitly (spec Axis 18).
""",
        // The `@require body:block_expr` gate is t-rd44's: without it a
        // truncated `spawn` diverged across the engines (1 vs 2 reports).
        gram = grammar {
  spawn_expr   = "spawn" @require body:block_expr
                 @expect("{", "expected `{` after spawn")
                 @expect("block_expr", "expected `{` after spawn") -> MkSpawn(body)
        },
        snippet = r"spawn { ${1:body} }",
        expr_tag = Expr.Spawn(ExprId(0)),
        emit_expr = spawn_emit_expr,
        resolve_expr = spawn_resolve,
        check_expr = spawn_check,
        gram_family = "expr",
    }
    spawn_def
}

/// Type-check hook for `Spawn`. Walks the body for its errors
/// then declares the result as a `.Task` handle carrying the body's type.
fn spawn_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Spawn(body) -> {
            let b = check_expr(tc, tc.nodes.exprs.get(body))
            // spawn yields a `Task<T>` handle, where T is the body's result
            // type — matching what codegen emits (`ok_emit(handle, .Task(...))`)
            // and the `Task<T>` surface type (ps3t.4.8). Previously this returned
            // a bare `.Int` handle, disagreeing with codegen; harmless while
            // `Task<T>` annotations were the nominal `Enum("Task")` (int→Enum was
            // ungated), but a structural `Task<T>` annotation needs the value to
            // actually type as `.Task` to unify.
            tc_er(b.tc, ValueType.Task(b.ty))
        }
        _ -> tc_er(tc, .Unknown)
    }
}
