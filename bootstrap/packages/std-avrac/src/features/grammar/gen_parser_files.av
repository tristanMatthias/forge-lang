// THE regen driver (t-47hc.8) — the single source of truth for the text of
// all four CHECKED-IN production static-parser modules:
//
//   parse/gen_decl_parser.av   ← emit_decl_parser_file()   (family "decl")
//   parse/gen_expr_parser.av   ← emit_expr_parser_file()   (family "expr")
//   parse/gen_type_parser.av   ← emit_type_parser_file()   (family "type")
//   parse/gen_pat_parser.av    ← emit_pat_parser_file()    (family "pat")
//
// Formerly four sibling files (gen_{decl,expr,pat,type}_file.av), each with
// its own copy of the same three lines; the drivers differed only in which
// emit family they asked the pipeline for and what their banner says, so
// they are ONE file now — a banner table plus one build fn. Existing
// importers are untouched: dir-as-module resolution binds `use
// features.grammar.{emit_decl_parser_file}` to the directory, not the file.
//
// NON-PRODUCTION: imported ONLY by the regenerators (diagnose.sh
// --emit-regen-{decl,expr,pat,type}) and the regen guards
// (parse/tests/gen_*_parser_regen_test.av), so this file — and transitively
// emit.av — never enters the production compiler graph (parse/mod.av
// imports the GENERATED files, which pull only the grammar builders, not
// the emitter). Editing any grammar changes these texts — run the matching
// `bash scripts/diagnose.sh --emit-regen-<family>` to rewrite the
// checked-in file, then commit it; the guard test fails until you do.
//
// The emitted files use RELATIVE imports (features.grammar / core), NOT the
// absolute `@std.avrac.` form the emit-gen-check STANDALONE harness uses:
// they are globbed in-package compiler-src modules, and an absolute
// self-import of the package being built double-expands every
// @derive/@expand type (F4012).

use features.grammar.{assemble_language, emit_parser_source_ex, derived_import_lines}

/// One generated module's text: provenance banner + the DERIVED import
/// header (computed from the emitted source — generator-owns-imports,
/// t-47hc.8, so nothing can drift from what the body references) + the
/// exported generated body from the pipeline's emit view for `family`.
fn parser_file_text(family: string, banner: string) -> string {
    let src = emit_parser_source_ex(assemble_language().emit(family), true)
    banner + derived_import_lines(src, "features.grammar", "core") + "\n" + src
}

/// The BANNERS — provenance comments only, one per generated module. Kept
/// as fns (not a data table) so each guard test can pin its own banner.
export fn gen_decl_parser_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-decl` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: the §2 declaration/statement/expression grammars in\n" +
    "// features/grammar/avra_grammar.av (avra_decl_flip_grammar). This is the PRODUCTION\n" +
    "// declaration parser under AVRA_PARSER_DECL_STATIC=1 (ps3t.6.7 Phase 2);\n" +
    "// parse/tests/gen_decl_parser_regen_test.av asserts it equals emit_decl_parser_file()\n" +
    "// so a grammar edit that isn't regenerated fails the suite.\n\n"
}

export fn gen_expr_parser_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-expr` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: the §2 expression grammar in features/grammar/avra_grammar.av.\n" +
    "// This is the PRODUCTION expression parser under AVRA_PARSER_EXPR_STATIC=1 (ps3t.6.7\n" +
    "// Step G); parse/tests/gen_expr_parser_regen_test.av asserts it equals\n" +
    "// emit_expr_parser_file() so a grammar edit that isn't regenerated fails the suite.\n\n"
}

export fn gen_type_parser_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-type` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: avra_type_grammar() in features/grammar/avra_grammar.av.\n" +
    "// This is the PRODUCTION type parser under AVRA_PARSER_TYPE_STATIC=1 (t-47hc.4.4\n" +
    "// Phase 3d); parse/tests/gen_type_parser_regen_test.av asserts it equals\n" +
    "// emit_type_parser_file() so a grammar edit that isn't regenerated fails the suite.\n\n"
}

export fn gen_pat_parser_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-pat` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: avra_pat_grammar() in features/match.av.\n" +
    "// This is the PRODUCTION pattern parser;\n" +
    "// parse/tests/gen_pat_parser_regen_test.av asserts it equals\n" +
    "// emit_pat_parser_file() so a grammar edit that isn't regenerated fails the suite.\n\n"
}

/// The complete text of each checked-in parser module. Both the
/// regenerators and the guards read from HERE.
export fn emit_decl_parser_file() -> string { parser_file_text("decl", gen_decl_parser_header()) }
export fn emit_expr_parser_file() -> string { parser_file_text("expr", gen_expr_parser_header()) }
export fn emit_type_parser_file() -> string { parser_file_text("type", gen_type_parser_header()) }
export fn emit_pat_parser_file() -> string { parser_file_text("pat", gen_pat_parser_header()) }
