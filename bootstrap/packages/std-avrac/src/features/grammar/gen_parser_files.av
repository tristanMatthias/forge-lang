// THE regen driver (t-47hc.8) — the single source of truth for the text of
// the ONE checked-in production static parser, parse/gen_parser.av.
//
// One grammar → one generated file. Every rule of the language is emitted
// exactly once. Each family's production entry — parse_declaration /
// parse_statement / parse_expression / parse_type_expr / parse_pattern_or —
// is a MODULE-PRIVATE fn entered by name the way the interpreter enters the
// same grammar by rule name: the static-entry boundary modules live in the
// same flat `parse` module, so nothing needs `export` (only the start rule,
// parse_program, is exported — tighter than the historical per-file exports).
// The historical four files (gen_{decl,expr,pat,type}_parser.av) existed only
// because the families flipped to generated code in different months; the
// per-family "dispatch" emit subsets existed only so those four files would
// not emit the same functions twice. One file needs neither.
//
// NON-PRODUCTION: imported ONLY by the regenerator (diagnose.sh
// --emit-regen-parsers) and the regen guard (parse/tests/
// gen_parser_regen_test.av), so this file — and transitively emit.av —
// never enters the production compiler graph (parse/mod.av imports the
// GENERATED file, which pulls only the grammar builders, not the emitter).
// Editing ANY grammar changes this text — run `bash scripts/diagnose.sh
// --emit-regen-parsers` to rewrite the checked-in file, then commit it; the
// guard test fails until you do.
//
// The emitted file uses RELATIVE imports (features.grammar / core), NOT the
// absolute `@std.avrac.` form the emit-gen-check STANDALONE harness uses:
// it is a globbed in-package compiler-src module, and an absolute
// self-import of the package being built double-expands every
// @derive/@expand type (F4012).

use features.grammar.{assemble_language, emit_parser_source_ex, derived_import_lines}
use core.{avra_selfhost_read_file}

/// The BANNER — provenance comments only. The import header is not
/// hand-kept: it derives from the emitted source itself
/// (derived_import_lines, generator-owns-imports), so nothing here can
/// drift from what the body references.
export fn gen_parser_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-parsers` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: THE grammar — the engine-core fragments (features/grammar/\n" +
    "// avra_grammar.av) + every feature's gram, composed by the Language pipeline\n" +
    "// (features/grammar/language.av). This is the PRODUCTION static parser for every\n" +
    "// family; parse/tests/gen_parser_regen_test.av asserts it equals\n" +
    "// emit_parser_file() so a grammar edit that isn't regenerated fails the suite.\n\n"
}

/// The production static parser's TEXT, for emit-shape tests to grep — read
/// from the CHECKED-IN parse/gen_parser.av (cwd = bootstrap root, the test
/// convention gen_parser_regen_test documents), NOT re-emitted. The file is a
/// derived artifact with a byte-equality freshness proof (the regen guard
/// asserts file == emit_parser_file()), so reading it is exact — and a fresh
/// emission per spec is what it replaces: tests used to emit pruned per-family
/// dispatch views (whose cross-family refs leaned on emit.av's now-deleted
/// declared-FIRST table); re-emitting the FULL grammar per then-block instead
/// stalled whole shards. If the grammar changed without a regen, the guard
/// reds the suite — these greps never see silently-stale text unflagged.
export fn checked_in_parser_source() -> string {
    avra_selfhost_read_file("packages/std-avrac/src/parse/gen_parser.av")
}

/// The complete text of parse/gen_parser.av: banner + the DERIVED import
/// header + every parse fn of the language, EMITTED FRESH from the one
/// composed grammar — never read back from disk, or the regen guard's
/// file == emit_parser_file() comparison would be vacuous. Both the
/// regenerator and the guard read from HERE.
export fn emit_parser_file() -> string {
    let src = emit_parser_source_ex(assemble_language().full(), true)
    gen_parser_header() + derived_import_lines(src, "features.grammar", "core") + "\n" + src
}
