// Checked-in derived builder surfaces for BOOTSTRAP features (t-kd4y.3):
// defer/errdefer today, each migrating feature adds its rows here.
//
// WHY this file exists, and why it lives in the ENGINE module: the
// generated parsers call feature builders through their manifest-derived
// import, and that import edge is CONSTRAINED — it must stay inside the
// closure the parse module already has. Importing a feature module
// directly (features.defer pulls typeck/resolve/codegen) widens the parse
// closure, and on the metadata lib path that re-visits modules whose
// derives already ran — every @derive in them reports the F4012 "already
// derived in this compile" cycle (bisected: base parser clean, a parser
// importing features.defer red with 14 errors). features.grammar is
// already in every generated parser's fixed header, so rows living here
// add ZERO import edges.
//
// The typed build fns + `_gb_` adapters + BuilderBind rows are DERIVED
// output checked in as source — the same audit-surface rule as the
// generated parsers themselves. Comptime synthesis (typed_builders.av)
// stays the path for EXTERNAL programs; it skips instances that already
// declare `builders` (explicit wins — rewrite_init's has_field probe), so
// these rows and the pass cannot double-apply. The feature's mod.av keeps
// the SEMANTIC hooks (emit/resolve/check) and references these builds by
// name in its gram — the reference is still the registration.
use core.{Stmt, ExprId, WhenArm}
use features.grammar.{PState, CapVal, BuilderBind, capval_stmt_val, capval_warm_val, capval_to_expr, capval_to_expr_opt}

export fn build_defer(e: ExprId) -> Stmt { Stmt.Defer(e) }
export fn build_errdefer(e: ExprId) -> Stmt { Stmt.Errdefer(e) }

/// `return ( value )?` — an absent same-line value is a bare
/// `Stmt.ReturnEmpty`; a present one is `Stmt.Return(value)`. The
/// same-line/FIRST gating lives in the rule (feature-owned, return_stmt's
/// gram); this build only folds presence.
export fn build_return(e: ExprId?) -> Stmt {
    if e == null { Stmt.ReturnEmpty } else { Stmt.Return(e!) }
}

export fn _gb_build_defer(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_defer(capval_to_expr(st, vals[0])))
}
export fn _gb_build_errdefer(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_errdefer(capval_to_expr(st, vals[0])))
}
export fn _gb_build_return(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_return(capval_to_expr_opt(st, vals[0])))
}

// ── match/when (t-kd4y.3 match slice) — the arms whose central helpers
// were already PURE over unwrapped values (mk_when_arm/mk_when_default
// constructed records, no arena, no span threading). MkMatch/MkArm and
// the rest stay central: MkArm reads the boxed Pattern back from the
// arena and the others thread sp_start spans — both need the
// store-access/span-injection marshalling rows recorded for the wide
// migration. MkMatch additionally has no feature-gram reference (it is
// spine-only), so a bind row would be an orphan to the validator.
export fn build_when_arm(c: ExprId, b: ExprId) -> WhenArm {
    WhenArm { cond_id: c, body_id: b }
}
export fn build_when_default(b: ExprId) -> WhenArm {
    WhenArm { cond_id: none, body_id: b }
}

export fn _gb_build_when_arm(st: PState, vals: List<CapVal>) -> CapVal {
    capval_warm_val(st, build_when_arm(capval_to_expr(st, vals[0]), capval_to_expr(st, vals[1])))
}
export fn _gb_build_when_default(st: PState, vals: List<CapVal>) -> CapVal {
    capval_warm_val(st, build_when_default(capval_to_expr(st, vals[0])))
}

export fn when_arm_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_when_arm", kind: "warm", arity: 2,
                   module: "features.grammar", export_name: "_gb_build_when_arm",
                   build: _gb_build_when_arm },
     BuilderBind { name: "build_when_default", kind: "warm", arity: 1,
                   module: "features.grammar", export_name: "_gb_build_when_default",
                   build: _gb_build_when_default }]
}

export fn defer_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_defer", kind: "stmt", arity: 1,
                   module: "features.grammar", export_name: "_gb_build_defer",
                   build: _gb_build_defer }]
}
export fn errdefer_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_errdefer", kind: "stmt", arity: 1,
                   module: "features.grammar", export_name: "_gb_build_errdefer",
                   build: _gb_build_errdefer }]
}
export fn return_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_return", kind: "stmt", arity: 1,
                   module: "features.grammar", export_name: "_gb_build_return",
                   build: _gb_build_return }]
}
