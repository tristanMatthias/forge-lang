// The checked-in ADAPTER SURFACE for bootstrap features (t-kd4y.3, slimmed
// by the t-47hc.8 dissolution): `_gb_` CapVal adapters + BuilderBind row
// fns ONLY. The TYPED LOWERING FNS live in their feature files
// (features/defer, features/return_stmt, …) — this file imports them back,
// so the meaningful logic sits with its feature and only the mechanical
// marshalling stays engine-side.
//
// WHY the adapters live in the ENGINE module: the generated parsers call
// them through their manifest-derived import, and that import edge is
// CONSTRAINED — it must stay inside the closure the parse module already
// has. A PARSE-side file importing a feature module (features.defer pulls
// typeck/resolve/codegen) widens the parse closure and F4012s on the
// metadata lib path (bisected: base parser clean, a parser importing
// features.defer red with 14 errors). features.grammar is already in every
// generated parser's fixed header, so adapters living here add ZERO import
// edges to parse/. The features.grammar → features.X edges THIS file takes
// instead are probe-verified safe (the same edge class the statement-view
// composition uses) — the F4012 class binds parse/-side files only.
//
// The adapters + rows are DERIVED output checked in as source — the same
// audit-surface rule as the generated parsers. Comptime synthesis
// (typed_builders.av) stays the path for EXTERNAL programs; it skips
// instances that already declare `builders` (explicit wins), so these rows
// and the pass cannot double-apply. The eventual endpoint (recorded on
// t-47hc.8) is regen-time INLINING of the pure typed fns into the
// generated parsers, which deletes this file entirely.
use core.{Stmt, ExprId, StmtId, WhenArm, NodeRef, byte_span_none}
use features.grammar.{PState, CapVal, BuilderBind, capval_stmt_val, capval_warm_val, capval_to_expr, capval_to_expr_opt, capval_to_stmt, capval_to_stmt_opt, capval_tok_text, capval_to_pat, capval_to_arm_list, capval_arm_val}
// The typed fns live in their FEATURE FILES (t-47hc.8 dissolution, slice
// b): this surface imports them back. The features.grammar → features.X
// file-level edges (with each feature file importing features.grammar in
// return — a dir-module cycle) are probe-verified safe on the metadata lib
// path.
use features.defer.{build_defer, build_errdefer}
use features.return_stmt.{build_return}
use features.while_stmt.{build_while}
use features.if_stmt.{build_if}
use features.for_stmt.{build_for}
use features.break_continue.{build_break, build_continue}
use features.match.{build_when_arm, build_when_default, build_arm, build_match}

export fn _gb_build_defer(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_defer(capval_to_expr(st, vals[0])))
}
export fn _gb_build_errdefer(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_errdefer(capval_to_expr(st, vals[0])))
}
export fn _gb_build_break(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_break())
}
export fn _gb_build_continue(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_continue())
}
export fn _gb_build_return(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_return(capval_to_expr_opt(st, vals[0])))
}
export fn _gb_build_while(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_while(capval_to_expr(st, vals[0]), capval_to_stmt(st, vals[1])))
}
export fn _gb_build_if(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, build_if(capval_to_expr(st, vals[0]), capval_to_stmt(st, vals[1]), capval_to_stmt_opt(st, vals[2])))
}
export fn _gb_build_for(st: PState, vals: List<CapVal>) -> CapVal {
    // Coercion ORDER mirrors the retired mk_for_loop exactly — var, lo,
    // BODY, then the optional hi (which mk_for_loop only touched inside its
    // presence match) — so any coercion-time effect sequences identically.
    let v = capval_tok_text(vals[0])
    let lo = capval_to_expr(st, vals[1])
    let body = capval_to_stmt(st, vals[3])
    capval_stmt_val(st, build_for(v, lo, capval_to_expr_opt(st, vals[2]), body))
}

export fn _gb_build_when_arm(st: PState, vals: List<CapVal>) -> CapVal {
    capval_warm_val(st, build_when_arm(capval_to_expr(st, vals[0]), capval_to_expr(st, vals[1])))
}
export fn _gb_build_when_default(st: PState, vals: List<CapVal>) -> CapVal {
    capval_warm_val(st, build_when_default(capval_to_expr(st, vals[0])))
}

export fn _gb_build_arm(st: PState, vals: List<CapVal>) -> CapVal {
    // The boxed-Pattern read lives HERE, not in the typed fn — adapters are
    // the marshalling layer, and the arena is marshalling (t-kd4y.3).
    let pid = capval_to_pat(st, vals[0])
    capval_arm_val(st, build_arm(st.store.pats.get(pid), pid, capval_to_expr_opt(st, vals[1]), capval_to_expr(st, vals[2])))
}
export fn _gb_build_match(st: PState, vals: List<CapVal>) -> CapVal {
    // The arms' PatRef EDGES are part of the production row (the retired
    // emit-side mk_match recorded them; the faithfulness oracle reads them
    // back) — edges are arena marshalling, so they live in the adapter.
    let arms = capval_to_arm_list(vals[1])
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.SNode(st.store.add_stmt(build_match(capval_to_expr(st, vals[0]), arms), byte_span_none(), refs))
}

/// ALL of the match feature's rows — when-arms (the first flip) plus the
/// t-kd4y.3 core pair. One list per feature.
export fn match_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_when_arm", kind: "warm", arity: 2, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_when_arm",
                   build: _gb_build_when_arm },
     BuilderBind { name: "build_when_default", kind: "warm", arity: 1, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_when_default",
                   build: _gb_build_when_default },
     BuilderBind { name: "build_arm", kind: "arm", arity: 3, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_arm",
                   build: _gb_build_arm },
     BuilderBind { name: "build_match", kind: "stmt", arity: 2, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_match",
                   build: _gb_build_match }]
}

export fn defer_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_defer", kind: "stmt", arity: 1, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_defer",
                   build: _gb_build_defer }]
}
export fn errdefer_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_errdefer", kind: "stmt", arity: 1, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_errdefer",
                   build: _gb_build_errdefer }]
}
export fn return_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_return", kind: "stmt", arity: 1, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_return",
                   build: _gb_build_return }]
}
export fn while_builds() -> List<BuilderBind> {
    // spanned: the generated parser stamps the While at the `while` keyword
    // (rule entry), byte-identical to the retired central mk_while core; the
    // interpreter path stays span-free like its central arm was.
    [BuilderBind { name: "build_while", kind: "stmt", arity: 2, spanned: true,
                   module: "features.grammar", export_name: "_gb_build_while",
                   build: _gb_build_while }]
}
export fn if_builds() -> List<BuilderBind> {
    // spanned like build_while — the stamp lands at the `if` keyword, the
    // retired mk_if's add_stmt_at anchor.
    [BuilderBind { name: "build_if", kind: "stmt", arity: 3, spanned: true,
                   module: "features.grammar", export_name: "_gb_build_if",
                   build: _gb_build_if }]
}
export fn for_builds() -> List<BuilderBind> {
    // spanned — the stamp lands at the `for` keyword, mk_for_loop's
    // add_stmt_at anchor (both the For and ForIn shapes).
    [BuilderBind { name: "build_for", kind: "stmt", arity: 4, spanned: true,
                   module: "features.grammar", export_name: "_gb_build_for",
                   build: _gb_build_for }]
}
export fn break_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_break", kind: "stmt", arity: 0, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_break",
                   build: _gb_build_break }]
}
export fn continue_builds() -> List<BuilderBind> {
    [BuilderBind { name: "build_continue", kind: "stmt", arity: 0, spanned: false,
                   module: "features.grammar", export_name: "_gb_build_continue",
                   build: _gb_build_continue }]
}
