// WHY: ps3t.6.5.11 — the code-generation face of the generator. Where
// executor.av INTERPRETS a Grammar value as error-tolerant recursive
// descent, emit.av RENDERS the same lowering as a STATIC parser's
// *source*: one straight-line `fn parse_<rule>(st: PState) -> CapVal`
// per rule (Nystrom's grammar→RD correspondence, GRAMMAR_DSL.md §4), no
// interpreter and no Grammar value at run time.
//
// The emitted text is REAL, COMPILABLE Avra that drives the executor
// vocabulary now exported for exactly this (ps3t.6.5.11 GAP-1): a PState
// (the real-lexer token cursor + shared NodeStore), the `CapVal` capture
// union, and the existing build helpers (fold_binary_expr / fold_logical_expr
// / unary_expr / fold_postfix_expr) + leaf builders (literal_node, run_hand).
// The GOLDEN REFERENCE this must match, behaviourally, is the hand-written
// tests/gen_expr_parser_test.av; the emitter's output is verified by
// COMPILING + RUNNING it against the same differential oracle
// (tests/emit_generated_run_test.av) — the ticket's "generated fns compile +
// pass the differential test", proven behaviourally rather than by a brittle
// byte-for-byte format match.
//
// The lowering, construct by construct (mirrors executor.av's model):
//   rule name = …             → fn parse_name(st: PState) -> CapVal { … }
//   nonterminal foo           → parse_foo(st)                (returns a CapVal)
//   terminal "+" / NUMBER      → st.advance() under a st.cur().text/kind guard
//   l:X ( op:(…) r:X )* -> B  → a fold loop: seed `let l =`, `mut`-list
//                               accumulators, `while <FIRST>`, then B(…)
//   a | b   (alternation)     → an if/else-if chain on each branch's FIRST,
//                               a bare-ref last branch as the fallthrough tail
//   ( … )?                    → if <FIRST> { … }
//   -> Ctor(a, b)             → apply_build's twin: one emission per build name
//   @hand(fn)                 → run_hand / run_hand_expr / run_hand_stmt /
//                               run_hand_stmt/run_hand_expr by rule class
//   @expect / @recover        → a checked consume with st.report + st.synchronize
//
// The build-name → emission map (emit_call_build) is the single
// target-specific seam, mirroring executor.av's apply_build one-to-one — so
// a build added there is added HERE, in lockstep (rule 8: one seam, not a
// forest of special cases).

use features.grammar.{Grammar, Rule, GNode, GSeq, GItem, GRep, GPrim, GBuild, GAnnot, rule_index_of, is_base_pred}
// t-zrn3: the UNGUARDED-TAIL predicate is SHARED with executor.exec_node — see ast.av.
// The local wrappers below delegate to it so the two engines cannot drift.
use features.grammar.{dispatch_has_tail, seq_lone_item_index, seq_is_bare_ref, seq_is_leading_hand, rule_owns_recovery}
use features.grammar.{ExpectHit, expect_for, rule_own_expect_msg, rule_first_expect_msg, rule_first_expect_msg_leaf, gated_ref_of}
use features.grammar.{is_hand_stmt_leaf, is_hand_expr_leaf}
use features.grammar.{rule_result_kind, rule_kind_v, node_kind, seq_kind, build_kind, prim_is_pred_e, rep_is_one, str_in, emit_lookup_rule, hand_kind}

// ── Pratt collapse of the uniform binary-operator ladder (ps3t.6.7 Step G, slice 1) ──
//
// The grammar spells the operator precedence ladder as a CHAIN of uniform
// left-assoc fold rules — `bitor = l:bitxor ( op:("|") r:bitxor )* -> fold_binary`,
// `bitxor = l:bitand …`, … down to `factor = l:unary …`. Emitting one parse fn per
// rule makes the generated parser DESCEND all N frames per leaf — exactly the cost
// the hand parser shed by collapsing those same levels into ONE `parse_binary_pratt`
// loop (mod.av). We give the GENERATED parser the same collapse: detect the chain,
// emit a single precedence-climbing loop over a binding-power table, and lower each
// chain rule to a one-line wrapper `parse_<rule>(st) = parse_binary_pratt_g(st, <lbp>)`
// so every call site keeps its exact entry precedence. Byte/tree-identical to the
// fold descent (both build left-assoc `Expr.Binary` via the shared `binop_of`), and
// N frames per leaf become 1.
type ChainRule = { name: string, operand: string, ops: List<string>, lbp: int }

/// The rule name a `.Ref` primary points at (else "").
fn prim_ref_name(prim: GPrim) -> string {
    match prim { .Ref(n) -> n  _ -> "" }
}

/// The `Call` build's helper name (else "").
fn build_call_name(build: GBuild) -> string {
    match build { .Call(n, _) -> n  _ -> "" }
}

/// Every literal-terminal text reachable from a primary: a bare `.Lit`, or the
/// branches of a `( "a" | "b" | … )` group (each a one-item Lit seq). Used to pull
/// a fold rule's operator set out of its `op:( … )` group.
fn lits_of_prim(prim: GPrim) -> List<string> {
    mut out: List<string> = []
    match prim {
        .Lit(t) -> out.push(t)
        .Group(inner) -> {
            match inner {
                .Alt(branches) -> {
                    for b in branches {
                        for it in b.items {
                            match it.prim { .Lit(t) -> out.push(t)  _ -> {} }
                        }
                    }
                }
            }
        }
        _ -> {}
    }
    out
}

/// A uniform binary-ladder fold rule: the `l:X ( op:(…) r:X )* -> fold_binary(…)`
/// shape whose seed ref and accumulator operand ref are the SAME rule X. Returns
/// (operand X, operator texts) or ("", []) when the rule isn't one.
fn binary_fold_of(seq: GSeq) -> ChainRule {
    let no_chain = ChainRule { name: "", operand: "", ops: [], lbp: 0 }
    if !is_fold(seq) || build_call_name(seq.build) != "fold_binary" { return no_chain }
    let seed_ref = prim_ref_name(seq.items[0].prim)
    if seed_ref == "" { return no_chain }
    let inner = group_inner_seq(seq.items[1].prim)
    mut operand = ""
    mut ops: List<string> = []
    for it in inner.items {
        if prim_is_ref(it.prim) { operand = prim_ref_name(it.prim) }
        else {
            for l in lits_of_prim(it.prim) { ops.push(l) }
        }
    }
    if operand != seed_ref || ops.length == 0 { return no_chain }
    ChainRule { name: "", operand, ops, lbp: 0 }
}

/// True iff `name` is any binary-fold rule's operand — i.e. it sits BELOW some
/// fold in the ladder (so it is not the loosest/head level).
fn is_some_fold_operand(g: Grammar, name: string) -> bool {
    for r in g.rules {
        match r.body {
            .Alt(branches) -> {
                if branches.length == 1 {
                    let cr = binary_fold_of(branches[0])
                    if cr.operand == name && r.name != name { return true }
                }
            }
        }
    }
    false
}

/// The single-branch fold body of a rule, or a null-name ChainRule.
fn rule_binary_fold(r: Rule) -> ChainRule {
    match r.body {
        .Alt(branches) -> {
            if branches.length == 1 {
                let cr = binary_fold_of(branches[0])
                if cr.operand != "" { return ChainRule { name: r.name, operand: cr.operand, ops: cr.ops, lbp: 0 } }
            }
            ChainRule { name: "", operand: "", ops: [], lbp: 0 }
        }
    }
}

/// Detect the binary-operator ladder as an ORDERED chain, loosest first. The head
/// is the fold rule that is no other fold's operand; we then follow operand links
/// down to the leaf. Each level's lbp = 10 + 2*index (matching the hand parser's
/// bitor=10 … factor=22). Empty when the grammar has no such ladder.
fn binary_fold_chain(g: Grammar) -> List<ChainRule> {
    mut folds: List<ChainRule> = []
    for r in g.rules {
        let cr = rule_binary_fold(r)
        if cr.name != "" { folds.push(cr) }
    }
    mut chain: List<ChainRule> = []
    if folds.length == 0 { return chain }
    // Head = a fold whose name is not any fold's operand.
    mut head = ""
    for f in folds {
        if !is_some_fold_operand(g, f.name) { head = f.name }
    }
    if head == "" { return chain }
    // Follow operand links from head to the leaf, assigning lbp per depth.
    mut cur = head
    mut idx = 0
    mut guard = 0
    while cur != "" && guard < folds.length + 1 {
        mut found = ChainRule { name: "", operand: "", ops: [], lbp: 0 }
        for f in folds {
            if f.name == cur { found = f }
        }
        if found.name == "" { break }
        chain.push(ChainRule { name: found.name, operand: found.operand, ops: found.ops, lbp: 10 + 2 * idx })
        cur = found.operand
        idx = idx + 1
        guard = guard + 1
    }
    chain
}

fn chain_lbp_of(chain: List<ChainRule>, name: string) -> int {
    for c in chain { if c.name == name { return c.lbp } }
    -1
}

/// The ExprId-returning call for the ladder's leaf (ps3t.6.7 Step G slice 2). When
/// the leaf rule is a bare `@hand` expression delegation (`unary = @hand(hand_unary)`),
/// call `run_hand_expr` DIRECTLY — it already yields an `ExprId`, so the Pratt loop
/// skips the `CapVal.Node` box + `capval_to_expr` unbox round-trip per leaf. Any
/// other leaf shape falls back to the boxed `capval_to_expr(parse_<leaf>)`.
fn leaf_exprid_call(g: Grammar, leaf: string) -> string {
    for r in g.rules {
        if r.name == leaf {
            match r.body {
                .Alt(branches) -> {
                    // Only a STRICT bare delegation gets the inline: one branch, one
                    // item, `One` repetition (not `*`/`+`), and NO build. Otherwise a
                    // repetition or a `-> build` on the leaf would be silently dropped
                    // by inlining run_hand_expr — fall back to the boxed parse_<leaf>.
                    if branches.length == 1 && branches[0].items.length == 1 &&
                        rep_is_one(branches[0].items[0].rep) && build_is_none(branches[0].build) {
                        match branches[0].items[0].prim {
                            .Hand(hf) -> {
                                if is_hand_expr_leaf(hf) { return "run_hand_expr(\"${hf}\", st)" }
                            }
                            _ -> {}
                        }
                    }
                }
            }
        }
    }
    "capval_to_expr(st, parse_${leaf}(st))"
}

/// The emitted Pratt prelude: `binary_lbp_g` (generated from the chain's operators)
/// + the precedence-climbing loop, the generated twin of the hand `parse_binary_pratt`
/// (incl. the table-cell `+`/`-` newline guard). Slice 2: the loop is emitted
/// ExprId-internal (`parse_binary_pratt_g_id`) — no `CapVal.Node` box on the leaf or
/// the recursion, dropping a malloc + rc_set per node — with ONE thin `CapVal`
/// wrapper (`parse_binary_pratt_g`) at the boundary the per-rule wrappers call.
fn emit_pratt_prelude(g: Grammar, chain: List<ChainRule>, leaf: string) -> string {
    // ps3t.6.7 perf: the precedence table dispatches on the Tk enum too (same
    // tk_guard rule) — every binary operator in the chain is punctuation with a
    // 1:1 Tk variant, so `t.tk == Tk.X` is byte-identical to `t.text == "X"` but
    // free of the per-iteration streq. An operator tk_variant_for can't name
    // falls back to the text compare (none today, but keeps the invariant safe).
    mut lbp = "fn binary_lbp_g(t: Token) -> int {\n"
    for c in chain {
        mut cond = ""
        mut j = 0
        for op in c.ops {
            if j > 0 { cond = cond + " || " }
            let tkv = tk_variant_for(op)
            if tkv == "" {
                cond = cond + "t.text == \"${op}\""
            } else {
                cond = cond + "t.tk == Tk.${tkv}"
            }
            j = j + 1
        }
        lbp = lbp + "    if ${cond} { return ${string(c.lbp)} }\n"
    }
    lbp = lbp + "    0\n}\n\n"
    let leaf_call = leaf_exprid_call(g, leaf)
    let loop = "fn parse_binary_pratt_g_id(st: PState, min_bp: int) -> ExprId {\n" +
        "    let sp_start = st.cur().pos\n" +
        "    mut lhs = ${leaf_call}\n" +
        "    while true {\n" +
        "        let lbp = binary_lbp_g(st.cur())\n" +
        "        if lbp == 0 || lbp < min_bp { break }\n" +
        "        let tx = st.cur().text\n" +
        "        if (tx == \"+\" || tx == \"-\") && st.modes.cell_mode && st.pos > 0 && st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line != st.store.lines.to_linecol(st.cur().pos).line { break }\n" +
        "        let _ = st.advance()\n" +
        "        let rhs = parse_binary_pratt_g_id(st, lbp + 1)\n" +
        "        lhs = mk_binary(st, sp_start, lhs, tx, rhs)\n" +
        "    }\n" +
        "    lhs\n}\n\n" +
        "fn parse_binary_pratt_g(st: PState, min_bp: int) -> CapVal { CapVal.Node(parse_binary_pratt_g_id(st, min_bp)) }\n\n"
    lbp + loop
}

/// Render the whole grammar as parser-fn source — one function per rule. When the
/// grammar carries a uniform binary-operator ladder (a chain of `fold_binary` rules),
/// that chain is collapsed into ONE emitted `parse_binary_pratt_g` loop + per-rule
/// wrappers (ps3t.6.7 Step G); every other rule emits one fn as before.
export fn emit_parser_source(g: Grammar) -> string {
    emit_parser_source_ex(g, false)
}

/// Like `emit_parser_source`, but when `export_start` the START rule's fn is
/// emitted `export fn` — the module's public entry. ps3t.6.7 Step G: the
/// checked-in PRODUCTION static parser (parse/gen_expr_parser.av) exposes
/// `parse_<start>` to its boundary runner (static_expr_entry.av); every other
/// rule stays module-private. `emit_parser_source(g)` is the unchanged
/// `export_start = false` form used by the emit tests + emit-gen-check.
export fn emit_parser_source_ex(g: Grammar, export_start: bool) -> string {
    let chain = binary_fold_chain(g)
    let start = if g.rules.length > 0 { g.rules[0].name } else { "" }
    mut out = "// generated recursive-descent parser for grammar `${g.name}`\n"
    if chain.length > 0 {
        let leaf = chain[chain.length - 1].operand
        out = out + emit_pratt_prelude(g, chain, leaf)
    }
    for r in g.rules {
        let pfx = if export_start && r.name == start { "export " } else { "" }
        let bp = chain_lbp_of(chain, r.name)
        if bp >= 0 {
            out = out + "${pfx}fn parse_${r.name}(st: PState) -> CapVal { parse_binary_pratt_g(st, ${string(bp)}) }\n\n"
        } else {
            out = out + pfx + emit_rule_fn_in(g, r) + "\n"
        }
    }
    out
}

/// Render one rule as its `parse_<name>` function. Takes the grammar so a
/// referenced rule's FIRST set (a repetition/optional guard) resolves.
export fn emit_rule_fn(g: Grammar, r: Rule) -> string {
    emit_rule_fn_in(g, r)
}

fn emit_rule_fn_in(g: Grammar, r: Rule) -> string {
    // A rule whose branches build POSTFIX STEPS freezes the chain accumulator on entry —
    // the emit twin of exec_rule's snap_postfix_step call. Without it a suffix that
    // recurses into `expression` (`[i]`, `(args)`, `<T>(args)`) folds onto whatever the
    // NESTED chain last produced: `stats[i]` built `Index(i, i)`.
    let snap = if rule_has_postfix_step_build_e(g, r) { "    st.snap_postfix_step()\n" } else { "" }
    // t-myz7: the START rule is the PER-ITEM entry, so it is where `abort_prop` dies.
    // The flag must SURVIVE an unwind within one item (that is its whole job) and be
    // gone before the next item starts — the PState is shared for a whole file, so a
    // leaked `true` makes every later declaration return a silent error node at its
    // first gated check.
    //
    // Chosen over resetting in `clear_error` on SCOPE, not on measurement: clear_error
    // also fires per BODY ITEM, which is inside a declaration, so it can cut an unwind
    // short before it reaches the enclosing rule. Both placements measure IDENTICALLY
    // today (production 78/114, leaf-refusal 53) — the hypothesis that the clear_error
    // placement caused the 56 -> 53 refusal drop was TESTED HERE AND REFUTED. That drop
    // comes from something else in the same commit, most likely `@require` newly raising
    // the flag, which genuinely changes how far an abort unwinds. Still open.
    //
    // Scoped to gate-bearing grammars (see `grammar_has_gate`): emit.av renders four
    // production parsers, and only the decl view's start rule is a per-item entry.
    let reset = if grammar_has_gate(g) && g.rules.length > 0 && g.rules[0].name == r.name { "    st.set_abort_prop(false)\n" } else { "" }
    let body = "fn parse_${r.name}(st: PState) -> CapVal {\n${reset}${snap}${emit_rule_body(g, r.body)}}\n"
    if !rule_seeds_postfix_e(g, r) { return body }
    // CHAIN NEUTRALITY (emit twin of exec_rule's save/restore; see
    // PState.restore_postfix_chain). The chain rule saves its four chain fields and puts
    // them back on exit, so a NESTED chain — the `expression` inside `[i]`, every `(args)`
    // argument — cannot overwrite the frozen base an outer suffix step has yet to build
    // from. Emitted as a WRAPPER around the real rule fn rather than inline, because the
    // body has many `return` points and the restore must run after EVERY one of them.
    let inner = "fn parse_${r.name}_chain(st: PState) -> CapVal {\n${snap}${emit_rule_body(g, r.body)}}\n"
    // `reset` rides the WRAPPER, not the inner chain fn: the wrapper is what callers
    // enter, so that is where the per-item entry is. Omitting it here (the body path
    // above has it) would mean a gate-bearing grammar whose first rule ALSO seeds the
    // postfix chain never cleared a stale `abort_prop`. No grammar is in that shape
    // today — the decl view's first rule is `declaration`, and only `unary` seeds the
    // chain — so this is a consistency fix, not a live one, and the regenerated
    // parsers are byte-identical. CodeRabbit.
    "fn parse_${r.name}(st: PState) -> CapVal {\n${reset}" +
        "    let c_step_base = st.postfix_step_base\n" +
        "    let c_step_sp = st.postfix_step_sp\n" +
        "    let out = parse_${r.name}_chain(st)\n" +
        "    st.restore_postfix_chain(c_step_base, c_step_sp)\n" +
        "    out\n}\n" + inner
}

/// Emit twin of executor.rule_seeds_postfix — THE chain rule (`unary`), whose single
/// branch build is `fold_postfix_with`.
fn rule_seeds_postfix_e(g: Grammar, r: Rule) -> bool {
    match r.body {
        .Alt(branches) -> {
            for b in branches { if seq_seeds_postfix_e(b) { return true } }
            false
        }
    }
}

/// Emit twin of executor.rule_has_postfix_step_build. The build-name list is duplicated
/// rather than shared because emit and the executor are deliberately separate modules;
/// the pair is asserted in postfix_flip_test.
fn rule_has_postfix_step_build_e(g: Grammar, r: Rule) -> bool {
    match r.body {
        .Alt(branches) -> {
            for b in branches {
                match b.build {
                    .Call(bn, _) -> {
                        if bn == "MkTrySuffix" || bn == "MkCatchSuffix" || bn == "MkIndexSuffix" || bn == "MkOptChain" ||
                            bn == "MkFieldAccess" || bn == "MkTupleIndex" || bn == "MkIndexSuffix" || bn == "MkCallSuffix" ||
                            bn == "MkGenericCallSuffix" || bn == "MkEnumCtorSuffix" ||
                            bn == "MkOptMethodCall" || bn == "MkForceUnwrap" { return true }
                    }
                    _ -> {}
                }
            }
            false
        }
    }
}

// ── Rule body: single-branch (pass-through / fold / general) or dispatch ──

fn emit_rule_body(g: Grammar, node: GNode) -> string {
    match node {
        .Alt(branches) -> {
            // A LONE `@try` branch must still go through emit_dispatch (t-myz7).
            // emit_single_branch lowers the body straight into the rule fn with no
            // surrounding dispatch loop — so a speculative lone branch emitted the
            // caller's bookkeeping (`s_diags` / `s_err` / `s_cut`, plus `break`) with
            // nothing declaring it, and the generated parser failed to compile
            // (`undefined variable s_diags`). Silent until now only because no rule
            // had the shape: `@try` was written on alternatives, never on a rule's
            // only branch. It is the shape a fragment rule needs to own its own
            // recovery — `mod_decl = @try "mod" @cut @require …` referenced BARE, so
            // the `@try` and its `@cut` share a branch (the `@cut` commit flag is
            // per-rule-invocation and cannot reach a caller's `@try`).
            //
            // Dispatch is already correct for it: one speculative branch with no tail
            // tracks `tried_spec` and returns CapVal.Nil on no-match, i.e. the rule
            // rolls back and the CALLER's alternation moves on — exactly `@try`'s
            // contract. Dormant for every existing grammar (no lone-`@try` rule
            // exists, since one could not have compiled), hence byte-identical.
            if branches.length == 1 && !branches[0].speculative {
                emit_single_branch(g, branches[0])
            } else {
                emit_dispatch(g, branches)
            }
        }
    }
}

/// A single-branch rule. Three shapes, in order of specificity:
///   pass-through (`a = b`)         → `parse_b(st)`
///   fold (`l:X ( … )* -> Build`)   → seed + accumulator loop + build
///   general sequence               → item statements then the build as the tail
/// Emit a lone-ref result, honoring an `@off(flag)` marker on the item: save
/// modes, clear the flag via modes_with_flag_off (the SAME fn the executor calls),
/// run the ref, restore. The SHARED core of every emit path that consumes a lone
/// ref by BYPASSING emit_item — the single-branch passthrough AND emit_dispatch's
/// two `is_bare_ref` shortcuts (guarded + catch-all tail) — all of which must
/// reproduce exec_item's @off handling themselves (exec_seq runs the branch's item
/// through exec_item, so the executor honors @off on a bare-ref dispatch branch;
/// emit must match or it's the lockstep hole this whole primitive prevents).
/// `as_return` prefixes `return ` (dispatch arms return; a single-branch tail is a
/// bare expression). Empty mode_off (every production grammar) → the plain call,
/// byte-identical.
/// The `@on(flag)` / `@on_if(pred, flag)` SET line — ONE definition, because there are
/// two emit sites (emit_item for a normal item, emit_ref_result for the bare-reference /
/// passthrough fast path) and a guard added to only one of them is precisely the
/// engine-divergence this marker exists to avoid: the interpreter gates every set through
/// `pred_ok`, so an unconditional emit on either path makes the generated parser disagree
/// with the interpreter for that rule shape. The guard string comes from the shared
/// `pred_guard`, so a base predicate lands as a `base_pred(...)` CALL into the executor.
fn mode_on_set_line(item: GItem, ind: string) -> string {
    let set_on = "${ind}st.set_modes(modes_with_flag_on(st.modes, \"${item.mode_on}\"))\n"
    if item.mode_on_if == "" { return set_on }
    "${ind}if ${pred_guard(item.mode_on_if)} {\n" +
        "${ind}    st.set_modes(modes_with_flag_on(st.modes, \"${item.mode_on}\"))\n" +
        "${ind}}\n"
}

fn emit_ref_result(item: GItem, ind: string, as_return: bool) -> string {
    let call = emit_ref_call(item.prim)
    let ret = if as_return { "return " } else { "" }
    if item.mode_on != "" {
        // The SET-ON twin of the mode_off branch below (mutually exclusive per
        // GItem): re-enable the flag around the sub-parse, then restore. The SET goes
        // through mode_on_set_line so `@on_if`'s predicate gate applies HERE too — a
        // passthrough rule (`r = @on_if(p, f) child`) reaches this path, not emit_item.
        return "${ind}let __m = st.modes\n" +
            mode_on_set_line(item, ind) +
            "${ind}let __r = ${call}\n" +
            "${ind}st.set_modes(__m)\n" +
            "${ind}${ret}__r\n"
    }
    if item.mode_off == "" {
        return "${ind}${ret}${call}\n"
    }
    "${ind}let __m = st.modes\n" +
        "${ind}st.set_modes(modes_with_flag_off(st.modes, \"${item.mode_off}\"))\n" +
        "${ind}let __r = ${call}\n" +
        "${ind}st.set_modes(__m)\n" +
        "${ind}${ret}__r\n"
}

fn emit_single_branch(g: Grammar, seq: GSeq) -> string {
    if is_passthrough(seq) {
        // A `@off(flag)` on the lone-ref passthrough must still set/restore the mode
        // around the sub-parse (exec_item honors it; the passthrough fast-path would
        // otherwise bypass it). Shared with emit_dispatch's bare-ref shortcuts.
        //
        // The VALUE item, not `items[0]`: a leading `@peek`/`@when` gate occupies
        // slot 0 and carries no value, so `lone_item_index` (the same accessor the
        // dispatch shortcuts use) is what names the ref to pass through.
        return emit_ref_result(seq.items[lone_item_index(seq)], "    ", false)
    }
    if is_fold(seq) {
        return emit_fold(g, seq)
    }
    if is_fold(seq) {
        return emit_fold(g, seq)
    }
    // General: emit the item statements, then the build as the (returned) tail.
    // A span-stamping build (mk_assign / fold_pipe / rebind_eq) captures the
    // rule-entry byte first — before any item (the leftmost operand) is parsed.
    let sp_prelude = if seq_build_uses_sp_start(seq.build) { "    let sp_start = st.cur().pos\n" } else { "" }
    sp_prelude + emit_seq_stmts(g, seq, "    ") + "    ${emit_seq_result(g, seq)}\n"
}

/// True for `name = otherrule` — one One-item nonterminal, no build. THE SAME
/// predicate the dispatch path uses (`is_bare_ref`), because they decide the same
/// thing about the same shape and a divergence is invisible on valid input.
///
/// It used to be a naive `seq.items.length == 1`, which counted a zero-width GATE
/// as an item and so failed the test for `@peek(c) ref`. The dispatch path had
/// already migrated to the shared `seq_lone_item_index` (which skips gates), so
/// the two disagreed on exactly one shape — a single-alternative rule with a
/// leading `@peek`. `comp_block_item = @peek(comp_body_plain) declaration` was
/// it: emit fell to the general sequence path, ran `declaration` for its side
/// effect, and returned the build-less `CapVal.Nil`. `capval_to_stmt` reports on
/// Nil, so EVERY component-instance body item raised a diagnostic, which rolled
/// the enclosing `@try comp_inst` back to the hand parser — the native rule
/// committed only for bodies with ZERO statements, and `body:comp_block_item*`
/// was dead code for a month. Nothing caught it: the hand produces identical
/// trees, positions and IR, so the tree, F-code, count and SrcPos oracles were
/// all green on a path none of them was actually reaching (see the routing spec
/// in comp_inst_native_routing_test).
fn is_passthrough(seq: GSeq) -> bool { seq_is_bare_ref(seq) }

/// True for the operator-fold shape `l:X ( <accumulators> )* -> Build(…)`:
/// a leading labelled One item (the seed) followed by a starred group, with a
/// LEGACY expr-fold Call build. The build restriction matters: emit_fold's
/// accumulator args are CapVal-wrapped (`CapVal.Toks`/`CapVal.Nodes`) because
/// the fold_binary_expr/fold_logical_expr/fold_postfix_expr helpers take CapVals
/// and always yield an Expr. A fold-SHAPED rule with any other build (e.g. the
/// type grammar's `TyUnion`, whose helper takes a raw `List<TypeExpr>`) instead
/// flows through the GENERAL path — which types the `_list` accumulator per the
/// referenced rule's kind and routes the build through emit_call_build.
fn is_fold(seq: GSeq) -> bool {
    seq.items.length == 2 &&
        rep_is_one(seq.items[0].rep) && seq.items[0].label != "" &&
        rep_is_star(seq.items[1].rep) && prim_is_group(seq.items[1].prim) &&
        build_is_expr_fold(seq.build)
}

/// The legacy expr-fold builds whose helpers take CapVal-wrapped accumulators
/// (fold_binary_expr / fold_logical_expr / fold_postfix_expr) — the only builds
/// that take the specialised emit_fold path.
fn build_is_expr_fold(build: GBuild) -> bool {
    match build {
        .Call(name, _) -> name == "fold_binary" || name == "fold_logical" || name == "fold_nullish" || name == "fold_postfix"
        _ -> false
    }
}

// ── Fold rules ──

fn emit_fold(g: Grammar, seq: GSeq) -> string {
    let seed = seq.items[0]
    let inner = group_inner_seq(seq.items[1].prim)
    let guard = seq_first_guard(g, inner, [])
    // Capture the rule-entry byte BEFORE the seed is parsed (the leftmost operand's
    // first token) when the fold build stamps spans — the operator-absent fast-path
    // below returns the seed unchanged and doesn't reference it.
    mut out = if seq_build_uses_sp_start(seq.build) { "    let sp_start = st.cur().pos\n" } else { "" }
    out = out + "    let ${seed.label} = ${emit_ref_call(seed.prim)}\n"
    // ps3t.6.7 Step G perf: fast-path the operator-ABSENT case (the common one for
    // every expression that isn't a `??`/`||`/`&&` chain) — return the seed directly
    // with ZERO list allocation and no fold call, matching the hand parser's bare-ExprId
    // threading. Byte-identical: fold_X_expr(seed, [], []) folds nothing and returns
    // capval_to_expr(seed), and the seed is already a CapVal.Node (every parse_<rule>
    // returns one), so `seed` == `CapVal.Node(fold_X_expr(seed, [], []))`. The list
    // allocations + fold only happen when an operator is actually present.
    out = out + "    if !(${guard}) { return ${seed.label} }\n"
    // One accumulator list per labelled item inside the starred group.
    for it in inner.items {
        if it.label != "" {
            let ty = if prim_yields_token(it.prim) { "Token" } else { "ExprId" }
            out = out + "    mut ${it.label}s: List<${ty}> = []\n"
        }
    }
    out = out + "    while ${guard} {\n"
    for it in inner.items {
        out = out + emit_accumulate(it, "        ")
    }
    out = out + "    }\n"
    out = out + "    ${emit_fold_build(seq.build, seed.label, inner)}\n"
    out
}

/// One loop-body line per starred-group item: a labelled terminal pushes the
/// consumed token, a labelled ref pushes its coerced node, an unlabelled
/// item (a separator) is consumed and dropped.
fn emit_accumulate(it: GItem, ind: string) -> string {
    if it.label == "" {
        return "${ind}let _ = st.advance()\n"
    }
    if prim_yields_token(it.prim) {
        "${ind}${it.label}s.push(st.advance())\n"
    } else {
        "${ind}${it.label}s.push(capval_to_expr(st, ${emit_ref_call(it.prim)}))\n"
    }
}

/// A fold's build call: the seed label maps to its scalar CapVal var, an
/// accumulator label to CapVal.Toks(<l>s) / CapVal.Nodes(<l>s).
fn emit_fold_build(build: GBuild, seed_label: string, inner: GSeq) -> string {
    match build {
        .Call(name, args) -> {
            mut rendered: List<string> = []
            for a in args {
                rendered.push(emit_fold_arg(a, seed_label, inner))
            }
            // fold_logical/fold_nullish take the rule-entry sp_start (emit_fold
            // captures it); fold_binary→Pratt and fold_postfix→@hand do not.
            let sp_arg = if build_uses_sp_start(name) { "sp_start, " } else { "" }
            "CapVal.Node(${build_fn(name)}(st, ${sp_arg}${join_commas(rendered)}))"
        }
        _ -> "CapVal.Node(st.error_node(\"fold rule without a build\"))"
    }
}

/// The DSL compound builders that take the hand parser's rule-entry `sp_start`
/// (executor.av) to stamp [production-entry, next-token) byte spans — the twin
/// of the executor builders' new signatures. Rules whose build is one of these
/// emit `let sp_start = st.cur().pos` at fn entry (emit_fold / emit_single_branch);
/// fold_binary (→Pratt, sp_start captured in the loop) and the span-free
/// fold_postfix / mk_is / etc. are excluded.
fn build_uses_sp_start(name: string) -> bool {
    // `-> return v` in a match arm stamps the SYNTHESIZED return row at the `return`
    // keyword — the rule's entry byte. The hand snapshots that position before parsing
    // the value for the same reason: stamping after the parse points the row at the
    // delimiter or the next arm instead of the `return`.
    name == "MkArmReturn" ||
    name == "fold_logical" || name == "fold_nullish" || name == "fold_pipe" ||
        name == "fold_with" || name == "fold_postfix_with" || name == "mk_assign" || name == "rebind_eq" ||
        name == "mk_enum_ctor" ||
        // `[ … ]` list literal + comprehension capture sp_start at their OWNING RULE's
        // entry byte (t-47hc.4, DORMANT). That anchor is the `[` for MkListLit (built in
        // list_expr, rule entry = `[`) but the BODY's first byte for MkListComp (built in
        // the list_comp sub-rule, entered AFTER `[` is consumed) — the two-level span
        // asymmetry matching hand parse_list_expr (@ `[`) vs parse_list_elements (@ body).
        name == "MkListLit" || name == "MkListComp" || name == "MkChannel" || name == "MkWhen" || name == "MkWhenStmt" ||
        // MkMatchExpr spans from the `match` keyword, like the hand alloc_at.
        name == "MkMatchExpr" ||
        // MkIfExpr spans from the `if` keyword — hand parse_if_expression's sp_start.
        name == "MkIfExpr" ||
        name == "MkQuote" || name == "MkQuoteType" || name == "MkQuoteArm" || name == "MkExprBlock" || name == "MkSpawn" || name == "MkIsolated" ||
        // `( a, b, … )` tuple spans sp_start = the `(` byte (t-47hc paren prep, DORMANT) —
        // its owning rule enters at `(`, like MkListLit's at `[`.
        name == "MkTuple" ||
        // `( … ) -> body` untyped lambda spans sp_start = the `(` byte (t-47hc paren prep,
        // DORMANT) — same owning-rule-entry anchor as the tuple.
        name == "MkLambda" ||
        // `( x: T, … ) -> body` typed lambda spans sp_start = the `(` byte (t-47hc paren
        // prep, DORMANT) — same owning-rule-entry anchor as the untyped lambda / tuple.
        name == "MkLambdaTyped" ||
        // `( e )` grouping / `()` empty tuple spans sp_start = the `(` byte (t-47hc paren
        // spend) — its owning paren_expr rule enters at `(`, like the tuple/lambda builds.
        name == "MkGroupOrEmpty" ||
        name == "MkTupleFR" ||
        // Statement control-flow builds thread the rule-entry byte so the generated
        // static parser records per-statement SrcPos byte-identical to the hand
        // parser (t-47hc.12); the interpreter passes 0 - 1 (span-free).
        //
        // `Block` is NOT one of them, and threading it here was a divergence from BOTH
        // other engines. The hand builds its only `Stmt.Block` with `alloc_stmt_leaf`
        // (parse/mod.av) — `add_leaf`, no `record_pos` — and the interpreter passes
        // `0 - 1`. Only emit stamped it, at the `{` byte, which is the rule's entry but
        // NOT a statement start: the enclosing statement-list loop already stamps the
        // `while`/`if` itself at the keyword. So the generated parser recorded a row the
        // other two do not, and `Ctx.source_line` — which retains its previous value for
        // an unstamped node — inherited from it, shifting `avra_null_deref_trap` lines
        // in every emitted control-flow body. Measured against the hand:
        //     hand = 2:5 4:9 3:5 6:5
        //     emit = 2:5 4:9 3:18 3:5 6:5      <-- 3:18 is the `{`
        // The While/If/ForLoop entries stay: their rule entry IS the statement start, so
        // the stamp agrees with the list loop's rather than adding a row.
        name == "While" || name == "If" || name == "ForLoop" ||
        name == "MkForDestructure" ||
        // A `with { … }` suffix spans sp_start = the `with` byte (t-47hc.17): its owning
        // with_suffix rule enters there, and rebind_with reads the partial node's `.hi`
        // to stamp each rebuilt `With` in a chained `a with { } with { }`.
        name == "MkWithSuffix" ||
        name == "MkMapLit" ||
        name == "MkSplice" ||
        name == "MkSpliceStruct" ||
        name == "MkQualExpr" ||
        // The outer table literal spans from the `table` keyword — the hand's
        // `alloc_at(Expr.ListLit(row_ids), sp_start)`.
        name == "MkTableLit" ||
        // The expression match TABLE anchors at the `match` keyword, like MkMatchExpr.
        name == "MkMatchTableExpr" ||
        // t-47hc slice 8 — both IDENT-led primaries span from the NAME token, so they
        // thread the rule-entry byte exactly as MkQualExpr does (a tagged template's
        // Call node must start at the tag, not at the template literal).
        name == "MkGrammarBlock" ||
        name == "MkStructLit" ||
        name == "MkTaggedTemplate" ||
        // A prefix WRAPPER's inner declaration carries its OWN position, stamped from
        // the byte where the inner starts — the hand captures it right after consuming
        // the prefix. The build is the identity plus that side-table write, so its
        // owning rule must begin exactly at the inner declaration.
        name == "MkStampAt" ||
        // `//!` module docs wrap a NoOp the hand stamps AFTER the doc lines; sp_start
        // here is only the emit/interpreter discriminator (the build reads st.cur()).
        name == "MkModuleDoc"
}

/// The GBuild-level predicate for whether a rule's build threads sp_start.
fn seq_build_uses_sp_start(build: GBuild) -> bool {
    match build {
        .Call(name, _) -> build_uses_sp_start(name)
        _ -> false
    }
}

fn emit_fold_arg(arg: string, seed_label: string, inner: GSeq) -> string {
    if arg == seed_label { return arg }
    for it in inner.items {
        if it.label == arg {
            if prim_yields_token(it.prim) { return "CapVal.Toks(${arg}s)" }
            return "CapVal.Nodes(${arg}s)"
        }
    }
    arg
}

// ── Multi-branch dispatch ──

/// An alternation → an if/else chain guarded by each branch's FIRST. The LAST
/// branch, if it is a bare nonterminal, becomes the UNGUARDED fallthrough tail
/// (unary's `| postfix`, statement's `| expr_stmt` — the catch-all delegate);
/// an EARLIER bare-nonterminal branch (statement's `break_stmt | continue_stmt
/// | …`) is a FIRST-guarded dispatch to that rule. Otherwise the tail is a
/// whole-construct error node (executor.exec_node's no-match arm).
fn emit_dispatch(g: Grammar, branches: List<GSeq>) -> string {
    // A `@try` (speculative) branch snapshots the parse state, runs, and COMMITS
    // only if it added no diagnostic — else it rolls the cursor + node store back
    // and falls through to the next alternative. When ANY branch is speculative
    // the dispatch tracks `tried_spec` and, on total no-match, returns a clean
    // CapVal.Nil (a rolled-back attempt already restored diags/had_error — the
    // caller decides) instead of synthesising an error node. This mirrors
    // executor.exec_node's speculative arm one-for-one so the generated parser and
    // the interpreter agree — the same lockstep discipline as @when's mode preds.
    //
    // …but ONLY when the alternation has no UNGUARDED TAIL (t-myz7.2). The three tail
    // forms below (bare-ref-to-a-hand-owning rule / `@fallback` / leading-`@hand`) exist
    // precisely because the catch-all delegate must see a token no branch's FIRST
    // matched — that is what routes a stray top-level token (`* 5`, `else`) into the
    // hand parser's F0040 recovery instead of the alternation's own generic F0001. Those
    // cases used to require `!has_spec`, which silently DELETED the tail the moment any
    // sibling became `@try`: adding `@try use_decl` to `declaration` turned its
    // `| statement` tail into a FIRST-guarded branch and regressed stray-token recovery
    // across the board. The tail's role has nothing to do with speculation, so it now
    // wins, and `tried_spec` is tracked only when there is no tail to fall into.
    //
    // No existing grammar moves: the two `@try`-bearing alternations (list_expr,
    // paren_expr) both END in a full sequence, which is not a tail form under any of the
    // three tests — so their emitted text is byte-identical either way.
    let has_spec = any_speculative(branches)
    let track_spec = has_spec && !dispatch_has_tail(g, branches)
    mut out = ""
    if track_spec { out = out + "    mut tried_spec = false\n" }
    mut tail = ""
    let last = branches.length - 1
    mut i = 0
    for b in branches {
        if b.speculative {
            out = out + emit_speculative_branch(g, b, track_spec)
        } else if is_bare_ref(b) && i == last && rule_self_validates(g, prim_ref_name(b.items[lone_item_index(b)].prim), []) {
            // UNGUARDED catch-all tail — ONLY when the referenced rule reaches an
            // `@hand` delegate that owns recovery (unary's `| postfix`, statement's
            // `| expr_stmt`). A pure-native last ref (`type_atom … | named_type`) falls
            // to the FIRST-guarded branch below + the no-match error tail, so a
            // non-FIRST token sets had_error (⇒ the caller's hand fallback fires)
            // instead of being swallowed into a bogus node — matching the interpreter,
            // which FIRST-guards every branch (the type error-recovery oracle's catch).
            // emit_ref_result honors a `@off(flag)` on the bare ref (exec_item does),
            // reproducing the passthrough's save/clear/restore in this shortcut path.
            tail = emit_ref_result(b.items[lone_item_index(b)], "    ", false)
        } else if is_bare_ref(b) {
            out = out + "    if ${seq_first_guard(g, b, [])} {\n"
            out = out + emit_ref_result(b.items[lone_item_index(b)], "        ", true)
            out = out + "    }\n"
        } else if b.fallback && i == last {
            // t-47hc.33 `@fallback`: the UNCONDITIONAL tail, emitted with no FIRST guard
            // and no trailing error node — the native twin of the trailing-`@hand` case
            // below. The branch itself owns the diagnostic for "nothing matched", which
            // is what lets a rule whose alternatives are ALL native reproduce a hand
            // parser's own message (`index_tail`'s two closing-`]` wordings) instead of
            // the alternation's generic "expected expression".
            let fb_pre = if seq_build_uses_sp_start(b.build) { "    let sp_start = st.cur().pos\n" } else { "" }
            tail = fb_pre + emit_seq_stmts_from(g, b, "    ", 1) + "    ${emit_seq_result(g, b)}\n"
        } else if is_leading_hand(b) && i == last {
            // A LEADING-`@hand` LAST branch is the UNGUARDED tail — the delegate owns
            // every case earlier branches didn't match, INCLUDING error recovery
            // (its own diagnostics), exactly like the single-branch `x = @hand(f)`
            // form. Guarding it with the delegate's FIRST + a grammar error_node
            // tail would divert a stray token (e.g. `* 5`) to a DSL error instead of
            // the hand parser's recovery — the recovery-tree oracle's exact catch.
            // Covers both a BARE `@hand` tail (`| @hand(hand_unary)`) and a `@hand`-
            // BASE tail with trailing postfix folds (`base:@hand(call_leaf) ( … )* ->
            // fold_with`): the trailing items only post-process the base, and never
            // consume the stray token, so recovery still flows through the leading
            // @hand. The sp_start prelude + item statements emit exactly as the
            // guarded general branch below, minus the `if`-guard and error tail.
            let sp_pre = if seq_build_uses_sp_start(b.build) { "    let sp_start = st.cur().pos\n" } else { "" }
            tail = sp_pre + emit_seq_stmts(g, b, "    ") + "    ${emit_seq_result(g, b)}\n"
        } else if is_bare_hand(b) {
            out = out + "    if ${seq_first_guard(g, b, [])} {\n"
            out = out + "        return ${emit_seq_result(g, b)}\n"
            out = out + "    }\n"
        } else {
            out = out + "    if ${seq_first_guard(g, b, [])} {\n"
            // A span-stamping build (e.g. fold_with) captures the rule-entry byte
            // FIRST — before any item (the leftmost operand) is parsed. In a dispatch
            // branch the guard is FALSE-when-not-taken (no token consumed), so the
            // branch entry byte == the rule entry byte, exactly as emit_single_branch /
            // emit_fold capture it for the single-branch case.
            if seq_build_uses_sp_start(b.build) { out = out + "        let sp_start = st.cur().pos\n" }
            out = out + emit_seq_stmts(g, b, "        ")
            out = out + "        return ${emit_seq_result(g, b)}\n"
            out = out + "    }\n"
        }
        i = i + 1
    }
    if tail != "" {
        // The unguarded catch-all tail OWNS every token no branch matched, including
        // one a rolled-back `@try` left behind — the delegate's recovery is exactly what
        // the tail exists to reach.
        out = out + tail
    } else if has_spec {
        // No tail: a rolled-back attempt is a clean "no match" (diags/had_error already
        // restored) — yield Nil and let the caller decide, rather than synthesising a
        // spurious parse error. Mirrors executor.exec_node's speculative arm.
        out = out + "    if tried_spec { return CapVal.Nil }\n"
        out = out + "    CapVal.Node(st.error_node_coded(\"F0040\", \"expected expression\"))\n"
    } else {
        out = out + "    CapVal.Node(st.error_node_coded(\"F0040\", \"expected expression\"))\n"
    }
    out
}


/// True when any branch is a `@try` speculative alternative.
fn any_speculative(branches: List<GSeq>) -> bool {
    for b in branches {
        if b.speculative { return true }
    }
    false
}

/// Emit one `@try` branch: a FIRST-guarded block that snapshots the parse state,
/// runs the branch body, and commits (returns) only if no diagnostic was added;
/// otherwise it rewinds the node store + cursor + diagnostics and falls through.
/// The twin of executor.exec_node's speculative arm.
///
/// TWO shapes (both roll back on a reported diagnostic — identical snapshot/commit
/// scaffold): a FLAT terminal/ref recognizer (`emit_speculative_branch_flat`, the
/// incumbent — list_expr's `@try "[" list_comp "]" -> cb`) and a RICH sequence
/// (`emit_speculative_branch_rich`) with groups / repetitions (`_list` accumulators)
/// / `@hand` / `@on`-`@off` mode items — the twin of exec_node's speculative arm over
/// exec_seq's FULL item vocabulary. Dispatch on `spec_branch_is_flat` so an existing
/// flat @try emits BYTE-IDENTICALLY (the rich path is dormant until a grammar uses a
/// complex @try branch — e.g. the paren spend's paren_tail).
fn emit_speculative_branch(g: Grammar, b: GSeq, track_spec: bool) -> string {
    if spec_branch_is_flat(b) { return emit_speculative_branch_flat(g, b, track_spec) }
    emit_speculative_branch_rich(g, b, track_spec)
}

/// The `tried_spec = true` marker line — emitted only when the enclosing dispatch
/// actually READS the flag (no unguarded tail). See emit_dispatch's `track_spec`.
fn spec_tracker_line(track_spec: bool) -> string {
    if track_spec { return "        tried_spec = true\n" }
    ""
}

/// A @try branch is FLAT when every token-bearing item is a One-rep terminal or rule
/// ref with NO mode marker — the incumbent recognizer shape the flat emitter's
/// straight-line `s_last` body handles. A repetition (Opt/Star/Plus → `_list`
/// accumulator), a group, a `@hand` leaf, or an `@on`/`@off` mode item needs the rich
/// emitter (it reuses emit_seq_stmts). Zero-width predicates (`@when`/`@peek`) are
/// skipped by BOTH emitters, so they don't force the rich path.
fn spec_branch_is_flat(seq: GSeq) -> bool {
    for item in seq.items {
        // A `@cut` needs the rich path: emit_spec_item is a straight-line
        // recognizer with no `s_cut` in scope, and the commit is emitted by
        // emit_item. Checked BEFORE the pred skip so a cut can never be lost.
        if item.cut { return false }
        // Same reason, for `@require`: the flat emitter is a straight-line `s_last`
        // recognizer with no place to put the marker's guard, and emit_spec_item's
        // `.Ref` path would silently DROP it — no FIRST check, no report, just the
        // bare call. The executor aborts there, so a flat branch would diverge from
        // its own oracle. Routing to the rich emitter (which already handles
        // @require for terminals AND refs, pre- and post-cut) keeps the marker
        // meaningful everywhere it is legal, without duplicating the guard logic.
        // Checked BEFORE the pred skip so it can never be lost, exactly like @cut.
        if item.require { return false }
        if prim_is_pred_e(item.prim) { continue }
        if item.mode_off != "" || item.mode_on != "" || item.mode_bump != "" { return false }
        if !rep_is_one(item.rep) { return false }
        match item.prim {
            .Lit(_) -> {}
            .Named(_) -> {}
            .Ref(_) -> {}
            _ -> return false
        }
    }
    true
}

/// True when this sequence contains a `@cut` anywhere the branch body will emit —
/// its own items plus any nested `( … )` group (groups emit INLINE, so their cut
/// writes the same `s_cut` local). Does NOT follow rule refs: a called rule emits a
/// separate function with its own scope, matching the executor's fresh-per-rule
/// CapEnv. Drives the `mut s_cut` declaration + commit guard.
fn seq_has_cut(seq: GSeq) -> bool {
    for item in seq.items {
        if item.cut { return true }
        match item.prim {
            .Group(inner) -> { if node_has_cut(inner) { return true } }
            _ -> {}
        }
    }
    false
}

fn node_has_cut(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                if seq_has_cut(b) { return true }
            }
        }
    }
    false
}

/// The RICH speculative branch: the snapshot/commit/rollback scaffold wrapping
/// emit_seq_stmts (the SAME per-item emitter the non-speculative path uses — list
/// accumulators, opt-scalars, `@on`/`@off`, `@hand`, groups) + emit_seq_result (the
/// branch's `-> build` reading those bound labels on commit). A later-item MISMATCH
/// reports a diagnostic (emit_one's checked terminal / a failed sub-rule), which grows
/// st.diags → the commit guard fails → truncate_to_mark + restore rolls back and the
/// next alternative is tried. Labels are `let`/`mut` locals inside the `{ }` block, so
/// a rolled-back branch's bindings never leak (the emit twin of exec_node's env.caps
/// snapshot). EMIT-ONLY: the executor already handles complex @try (exec_node's
/// speculative arm over exec_seq), so no executor change accompanies this.
fn emit_speculative_branch_rich(g: Grammar, b: GSeq, track_spec: bool) -> string {
    let has_cut = seq_has_cut(b)
    mut out = "    if ${seq_first_guard(g, b, [])} {\n"
    out = out + spec_tracker_line(track_spec)
    out = out + "        let s_pos = st.pos\n"
    out = out + "        let s_mark = st.store.mark()\n"
    out = out + "        let s_diags = st.diags.length\n"
    out = out + "        let s_err = st.had_error\n"
    // t-47hc.21 COMMIT POINT: only a cut-bearing branch declares `s_cut`, so every
    // existing grammar regenerates byte-identically.
    if has_cut { out = out + "        mut s_cut = false\n" }
    out = out + "        let s_hand = st.save_hand_state()\n"
    // The PState's own hygiene counter rolls back with the store truncation —
    // the emit twin of the executor's s_gensym (see PState.fresh's WHY).
    out = out + "        let s_gensym = st.gensym_seq\n"
    // t-drl0 / t-x2fb: the postfix-chain accumulator is part of the state a `@try`
    // touches. An item that runs `st.seed_postfix(...)` does so DURING parsing, before
    // any build is gated on the diagnostic count — so a branch destined to roll back can
    // still point `postfix_base` at a row `truncate_to_mark` then discards, and the next
    // dereference indexes past the end of the store (a hard `index N out of bounds`
    // crash, not a wrong parse). #1065 fixed exactly this in exec_node
    // (save_postfix_state / restore_postfix_state) and left emit without it; the
    // executor's note that "the generated parser never had the bug" was wrong — the
    // generated parser gates the BUILDER on the diag count, but a doomed branch's nested
    // `parse_expression` reseeds the accumulator regardless of any builder.
    out = out + "        let s_postfix = st.save_postfix_state()\n"
    // Same span prelude as the flat path / the non-speculative branch: a span-stamping
    // build reads `sp_start` = the rule-entry byte (guard matched but consumed nothing).
    if seq_build_uses_sp_start(b.build) { out = out + "        let sp_start = st.cur().pos\n" }
    // t-x2fb: a CUT-BEARING branch gets a `while true { … break }` scaffold so the cut
    // abort (`if !s_cut { break }`, emit_item) has somewhere to jump — straight to the
    // shared rollback below, skipping the provably-wasted remainder. Non-cut branches
    // emit exactly as before, so every generated parser except the ONE cut-bearing branch
    // in the whole grammar (paren_expr's lambda alternative) stays byte-identical.
    let bi = if has_cut { "            " } else { "        " }
    if has_cut { out = out + "        while true {\n" }
    out = out + emit_seq_stmts(g, b, bi)
    // Past a `@cut` the branch OWNS its diagnostics — commit regardless of what it
    // reported, so the error is kept instead of being read as "wrong branch".
    let guard = if has_cut { "s_cut || (st.diags.length == s_diags && st.had_error == s_err)" } else { "st.diags.length == s_diags && st.had_error == s_err" }
    out = out + "${bi}if ${guard} {\n"
    out = out + "${bi}    return ${emit_seq_result(g, b)}\n"
    out = out + "${bi}}\n"
    if has_cut { out = out + "            break\n        }\n" }
    out = out + "        st.store.truncate_to_mark(s_mark)\n"
    out = out + "        st.restore_to(s_pos, s_diags, s_err)\n"
    out = out + "        st.restore_hand_state(s_hand)\n"
    out = out + "        st.set_gensym_seq(s_gensym)\n"
    out = out + "        st.restore_postfix_state(s_postfix)\n"
    out = out + "    }\n"
    out
}

/// The FLAT speculative branch (incumbent): a straight-line terminal/ref recognizer
/// whose body updates `s_last` (exec_seq's build-less return = its last item) and whose
/// `-> build` reads any labeled locals on commit. Unchanged from the original
/// emit_speculative_branch — kept so an existing flat @try (list_expr) regens
/// byte-identically.
fn emit_speculative_branch_flat(g: Grammar, b: GSeq, track_spec: bool) -> string {
    mut out = "    if ${seq_first_guard(g, b, [])} {\n"
    out = out + spec_tracker_line(track_spec)
    out = out + "        let s_pos = st.pos\n"
    out = out + "        let s_mark = st.store.mark()\n"
    out = out + "        let s_diags = st.diags.length\n"
    out = out + "        let s_err = st.had_error\n"
    out = out + "        let s_hand = st.save_hand_state()\n"
    // The PState's own hygiene counter rolls back with the store truncation —
    // the emit twin of the executor's s_gensym (see PState.fresh's WHY).
    out = out + "        let s_gensym = st.gensym_seq\n"
    // t-drl0 / t-x2fb: the postfix-chain accumulator is part of the state a `@try`
    // touches. An item that runs `st.seed_postfix(...)` does so DURING parsing, before
    // any build is gated on the diagnostic count — so a branch destined to roll back can
    // still point `postfix_base` at a row `truncate_to_mark` then discards, and the next
    // dereference indexes past the end of the store (a hard `index N out of bounds`
    // crash, not a wrong parse). #1065 fixed exactly this in exec_node
    // (save_postfix_state / restore_postfix_state) and left emit without it; the
    // executor's note that "the generated parser never had the bug" was wrong — the
    // generated parser gates the BUILDER on the diag count, but a doomed branch's nested
    // `parse_expression` reseeds the accumulator regardless of any builder.
    out = out + "        let s_postfix = st.save_postfix_state()\n"
    out = out + "        mut s_last: CapVal = CapVal.Nil\n"
    // A span-stamping build (`mk_assign`/`fold_logical`/`Block`/…) reads `sp_start`,
    // the rule-entry byte — the twin of the non-speculative branch's prelude
    // (emit_single_branch / the guarded dispatch branch). Capture it at branch entry
    // (the guard FIRST-matched but consumed nothing, so `st.cur().pos` == the rule
    // entry byte), BEFORE any item parses. A build that never spans (or a build-less
    // @try) omits it — byte-identical to the incumbent recognizer.
    if seq_build_uses_sp_start(b.build) { out = out + "        let sp_start = st.cur().pos\n" }
    mut idx = 0
    for item in b.items {
        // A `@when` predicate is zero-width — it neither consumes a token nor
        // advances the guard idx (the first token-bearing item stays idx 0).
        if prim_is_pred_e(item.prim) { continue }
        out = out + emit_spec_item(item, idx)
        idx = idx + 1
    }
    out = out + "        if st.diags.length == s_diags && st.had_error == s_err {\n"
    // GAP3 @try-with-builds: on commit, apply the branch's `-> build` (reading the
    // labels bound as locals above) exactly like emit_seq_result — the twin of the
    // interpreter's exec_seq applying the build inside the speculative attempt. A
    // build-less branch commits `s_last` (the incumbent, byte-identical shape).
    match b.build {
        .None -> out = out + "            return s_last\n"
        .Var(name) -> out = out + "            return ${name}\n"
        .Call(name, args) -> out = out + "            return ${emit_call_build(name, args)}\n"
    }
    out = out + "        }\n"
    out = out + "        st.store.truncate_to_mark(s_mark)\n"
    out = out + "        st.restore_to(s_pos, s_diags, s_err)\n"
    out = out + "        st.restore_hand_state(s_hand)\n"
    out = out + "        st.set_gensym_seq(s_gensym)\n"
    out = out + "        st.restore_postfix_state(s_postfix)\n"
    out = out + "    }\n"
    out
}

/// One item inside a `@try` branch. A rule ref self-reports (call it — its own
/// diagnostics grow st.diags on failure); the guard terminal (idx 0, already
/// FIRST-matched by the enclosing `if`) is consumed unconditionally; a later
/// terminal is checked and REPORTS on mismatch — the reported diagnostic is the
/// speculative rollback's failure signal, the twin of exec_primary's
/// handle_missing. Every item updates `s_last` so the committed value equals
/// exec_seq's build-less `last`.
fn emit_spec_item(item: GItem, idx: int) -> string {
    // GAP3 @try-with-builds: a labeled item binds a LOCAL `let <label>` (auto-scoped,
    // so a rolled-back branch never leaks — the emit twin of the interpreter's
    // env.caps snapshot/restore) that the branch's `-> build` reads on commit. The
    // value ALSO feeds `s_last` so a build-less @try (the incumbent shape) is
    // byte-identical. `spec_bind` centralises "assign to `<label>` if labeled".
    if prim_is_ref(item.prim) {
        return spec_bind(item.label, emit_ref_call(item.prim))
    }
    if idx == 0 {
        return spec_bind(item.label, "CapVal.Tok(st.advance())")
    }
    let cond = term_guard(item.prim)
    let t = prim_lit_text(item.prim)
    if item.label != "" {
        // A checked terminal that binds a label must bind it on BOTH the match and
        // the mismatch path so the build never reads an unbound local (the mismatch
        // reports → the speculative branch rolls back, but the local must still exist).
        return "        let ${item.label} = if ${cond} { CapVal.Tok(st.advance()) } else { st.report(\"expected `${t}`\"); CapVal.Tok(st.cur()) }\n" +
            "        s_last = ${item.label}\n"
    }
    "        if ${cond} { s_last = CapVal.Tok(st.advance()) } else { st.report(\"expected `${t}`\") }\n"
}

/// Bind a @try item's value: to a local `let <label>` (feeding the branch's build)
/// AND to `s_last` when labeled; to `s_last` alone when not — so a build-less @try
/// branch emits exactly the incumbent `s_last = <value>` (byte-identical).
fn spec_bind(label: string, value: string) -> string {
    if label == "" { return "        s_last = ${value}\n" }
    "        let ${label} = ${value}\n        s_last = ${label}\n"
}

/// True for `| otherrule` — a lone One nonterminal branch (no build).
/// Index of a branch's single VALUE item, skipping zero-width GATES (`@peek`/`@when`
/// consume nothing, so `@peek(c) ref` is still a lone ref — just guarded). -1 when the
/// branch carries none or more than one value item. The gate itself is already folded
/// into seq_first_guard, so the shortcut paths below stay correct.
fn lone_item_index(seq: GSeq) -> int { seq_lone_item_index(seq) }

fn is_bare_ref(seq: GSeq) -> bool { seq_is_bare_ref(seq) }

/// True for `| @hand(fn)` — a lone One @hand-delegation branch (no build). As the
/// LAST branch it is the unguarded tail (the delegate owns every unmatched case +
/// its own error recovery), matching the single-branch `x = @hand(f)` lowering.
fn is_bare_hand(seq: GSeq) -> bool {
    seq.items.length == 1 && rep_is_one(seq.items[0].rep) &&
        prim_is_hand(seq.items[0].prim) && build_is_none(seq.build)
}

/// True for a branch whose FIRST item is a One `@hand` delegate AND whose remaining
/// items are all NULLABLE (Star/Opt) postfix folds — the catch-all tail shape, a
/// SUPERSET of is_bare_hand: the bare form (`| @hand(f)`) AND a `@hand`-BASE with
/// trailing NULLABLE postfix folds (`base:@hand(call_leaf) ( s:@hand(with_suffix)
/// )* -> fold_with`). As the LAST dispatch branch it emits UNGUARDED (emit_dispatch):
/// the leading @hand owns error recovery, and the nullable trailing items only
/// post-process its result — so a stray token still reaches the hand parser's
/// recovery, not a DSL error node (the recovery-tree oracle's invariant).
///
/// A REQUIRED trailing item (One/Plus) after the leading @hand would make the branch
/// a genuine sequence whose @hand must NOT run on tokens outside its FIRST set (that
/// would bypass dispatch and diverge from executor.exec_node) — so such a branch is
/// NOT a leading-hand tail; it must be FIRST-guarded like any other. Only nullable
/// (Star/Opt) trailing items qualify.
fn is_leading_hand(seq: GSeq) -> bool { seq_is_leading_hand(seq) }

// ── Sequence statements (a dispatch branch's / general seq's body) ──

/// The statement lines for a sequence: list accumulators declared once at the
/// top (for every label captured under a repetition anywhere in the branch),
/// then one emission per item in order. A lone primary with no build is
/// consumed BY its result (literal_node / run_hand), so it emits no statements.
fn emit_seq_stmts(g: Grammar, seq: GSeq, ind: string) -> string {
    emit_seq_stmts_from(g, seq, ind, 0)
}

/// emit_seq_stmts with an explicit starting item INDEX — see emit_seq_items_from.
/// `idx_base = 1` is for an UNGUARDED branch (`@fallback`, t-47hc.33): nothing proved
/// its first token, so that token must be VALIDATED like any later item instead of
/// consumed unconditionally. Without it the tail swallows whatever is there and its
/// `@expect` message — the entire reason the marker exists — is never emitted.
fn emit_seq_stmts_from(g: Grammar, seq: GSeq, ind: string, idx_base: int) -> string {
    if is_lone_primary_result(seq) { return "" }
    let labels = list_labels_of(seq)
    let opts = opt_scalar_labels_of(seq, labels)
    mut out = ""
    for l in labels {
        out = out + "${ind}mut ${l}_list: List<${list_decl_type(g, seq, l)}> = []\n"
    }
    // Optional-scalar captures (a One label inside `( … )?`) start Nil and are
    // ASSIGNED when the option fires — the conditional build reads the Nil.
    for s in opts {
        out = out + "${ind}mut ${s}: CapVal = CapVal.Nil\n"
    }
    out = out + emit_seq_items_from(g, seq, seq.annots, ind, labels, opts, idx_base, spec_none())
    out
}

/// A sequence whose result consumes its sole primary itself: a lone unlabelled
/// terminal (the default literal build) or a lone @hand primary. These emit no
/// pre-consume — emit_seq_result's `st.advance()` / run_hand does it.
///
/// Keyed on `lone_item_index`, so a leading zero-width `@peek`/`@when` gate does not
/// hide the lone primary. It MUST agree with emit_seq_result's own lone check: if this
/// says "not lone" while that one says "lone", the primary is emitted twice (the item
/// body runs it, then the result runs it AGAIN); if the reverse, the item runs and its
/// value is discarded for a `CapVal.Nil`. Both were live with a raw `items.length == 1`
/// check the moment a `@peek`-gated `@hand` appeared.
fn is_lone_primary_result(seq: GSeq) -> bool {
    let lone = lone_item_index(seq)
    if lone < 0 || !rep_is_one(seq.items[lone].rep) || !build_is_none(seq.build) {
        return false
    }
    let p = seq.items[lone].prim
    (prim_is_terminal(p) && seq.items[lone].label == "") || prim_is_hand(p)
}

/// The per-item lines (no list declarations — those are hoisted by the
/// enclosing emit_seq_stmts so a nested group shares the branch's lists).
/// True iff a sequence's build is `fold_postfix_with` (emit twin of executor.
/// seq_seeds_postfix) — its item 0 is the postfix-chain BASE.
fn seq_seeds_postfix_e(seq: GSeq) -> bool {
    match seq.build {
        .Call(name, _) -> name == "fold_postfix_with"
        _ -> false
    }
}

/// A nested group carries no annotations of its own, so an `@expect` written on the
/// OWNING sequence must still reach items inside its `( … )*`. Prefer the inner seq's
/// own annots when it has them; otherwise inherit the outer sequence's.
/// The annotations in scope for a sequence's items: its OWN first, then the inherited
/// ones. A branch's `@expect` therefore wins for the token it names while every message
/// declared on the enclosing rule stays reachable — which is what lets two branches of one
/// group each own a DIFFERENT message for the SAME token. `type X = { … }` and
/// `type X = Base without { … }` both close on `}` and the hand words them differently
/// ("expected `}` after fields" / "after type operator fields"), and there is no other
/// seam to say that in: `@expect` keys on the token, so one shared annotation set can
/// only carry one of the two.
///
/// Previously inner REPLACED outer, which made a branch that declared anything lose every
/// inherited message at once — so the only safe branch annotation was a complete one.
/// `expect_for` / `handle_missing` both take the FIRST match, so ordering is the whole
/// mechanism.
fn annots_or(inner: List<GAnnot>, outer: List<GAnnot>) -> List<GAnnot> {
    if inner.length == 0 { return outer }
    if outer.length == 0 { return inner }
    mut out: List<GAnnot> = []
    for a in inner { out.push(a) }
    for a in outer { out.push(a) }
    out
}

fn emit_seq_items(g: Grammar, seq: GSeq, outer_annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>) -> string {
    emit_seq_items_from(g, seq, outer_annots, ind, list_labels, opts, 0, spec_none())
}

/// The three speculative contexts a `@require` can sit in. Small named constants
/// rather than a bool pair so the intent reads at every call site.
fn spec_none() -> int { 0 - 1 }
fn spec_pre_cut() -> int { 0 }
fn spec_committed() -> int { 1 }

/// emit_seq_items with an explicit starting item INDEX. `idx == 0` marks the
/// sequence's GUARD token — already FIRST-matched by the enclosing `if`/`while`, so
/// emit_one_terminal consumes it unconditionally. Pass `idx_base = 1` when nothing
/// proved the first token (an UNGUARDED single-branch structural group), so it is
/// VALIDATED like any later item instead of being swallowed whole.
fn emit_seq_items_from(g: Grammar, seq: GSeq, outer_annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, idx_base: int, spec_ctx_in: int) -> string {
    let seeds_postfix = seq_seeds_postfix_e(seq)
    mut out = ""
    mut idx = idx_base
    // `@require` may emit an early `return` — but inside a `@try` branch BEFORE its
    // `@cut` that would jump straight past the rollback scaffold, stranding the
    // speculative snapshot. There it degrades to plain reporting, which is already the
    // right behaviour: the report fails the commit guard, so the ROLLBACK is the abort.
    // Predictive branches, and everything past a cut, abort for real.
    //
    // `spec_ctx` carries that state DOWN into nested groups. A group's own sequence is
    // never `speculative` (only a branch is), so deriving abortability from it alone
    // would let a pre-cut `@require` inside a `@try` branch's group emit the early
    // return — exactly the rollback bypass this guards against. Values: SPEC_NONE
    // predictive, SPEC_PRE_CUT inside a speculative branch before its cut,
    // SPEC_COMMITTED past the cut.
    mut ctx = if seq.speculative { spec_pre_cut() } else { spec_ctx_in }
    for item in seq.items {
        if item.cut && ctx == spec_pre_cut() { ctx = spec_committed() }
        // A `@when` predicate is zero-width: it emits no code and consumes no
        // idx slot, so the first token-bearing item stays the guard token (idx 0).
        if prim_is_pred_e(item.prim) { continue }
        let abortable = ctx != spec_pre_cut()
        // `seq.speculative` is true ONLY for a branch's own item list — a nested group's
        // sequence is never speculative — so it is exactly the "safe to `break`" test the
        // cut abort needs (t-x2fb).
        out = out + emit_item(g, item, idx, annots_or(seq.annots, outer_annots), ind, list_labels, opts, abortable, ctx, seq.speculative)
        // Phase 3a base-threading (twin of exec_seq's hook): after a grammar-BUILT base
        // (fold_postfix_with item 0 that is NOT @hand — a literal terminal), seed
        // st.postfix_base so the ( postfix_suffix )* loop wraps it. The @hand base seeds
        // itself inside run_hand_expr, so it is skipped (no redundant seed on the hot path).
        if seeds_postfix && idx == idx_base && !prim_is_hand(item.prim) {
            out = out + "${ind}st.seed_postfix(capval_to_expr(st, ${item.label}), sp_start)\n"
        }
        idx = idx + 1
    }
    out
}


/// One item. `idx == 0` is the branch's guard token (already matched by the
/// enclosing `if`/`while`), so it is consumed unconditionally; a later
/// terminal is consumed defensively (checked), honouring @expect/@recover.
fn emit_item(g: Grammar, item: GItem, idx: int, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, abortable: bool, spec_ctx: int, cut_breaks: bool) -> string {
    // `@cut` COMMIT POINT (t-47hc.21): the twin of exec_item's `env.cut = true`.
    // `s_cut` is a `mut` local of the enclosing speculative branch's block, so the
    // write reaches it from a nested group too (groups emit inline). Emitted BEFORE
    // the item, so the commit covers the item's own failure. validate_cuts already
    // proved a cut only ever appears where `s_cut` is in scope.
    // The commit fires only if the branch is STILL on its happy path. Both engines
    // are error-TOLERANT — a mismatched item reports and execution carries on to the
    // next one — so a cut placed after a failure would otherwise commit a branch that
    // had already proved itself wrong (`@try "+" "-" @cut "*"` on `+ / *` must still
    // roll back to the `"+"` sibling). `s_diags`/`s_err` are the enclosing
    // speculative branch's entry snapshot, already in scope.
    let cut_pre = if item.cut { "${ind}if st.diags.length == s_diags && st.had_error == s_err { s_cut = true }\n" } else { "" }
    // t-x2fb: ABORT A DOOMED BRANCH AT ITS CUT, instead of parsing on and discarding the
    // result. The commit guard below is `s_cut || (no new diagnostics)`; diagnostics only
    // ever GROW, so once `s_cut` is false here the second disjunct is false too and can
    // never recover — the branch is provably going to roll back, and every item past this
    // point is provably wasted.
    //
    // The waste is not a constant factor. The wasted item is typically a full
    // sub-expression parse — `paren_expr`'s cut-guarded lambda BODY parses the entire
    // remaining expression — so a doomed branch parses the whole suffix, discards it, and
    // the caller parses that same suffix again: 2x per parenthesised group, i.e. 2^n.
    // Measured `parse_paren_expr` entries for `if a == 1 && (b == 2) || …`, n terms:
    // 7,15,31,63,255,1023,4095 (exactly 2^n - 1) BEFORE, 3,4,5,6,8,10,12 (exactly n) AFTER.
    // It only bites when the ENCLOSING construct ALSO fails — a successful outer parse
    // never re-descends — which is why no gate caught it: diff-test compiles only VALID
    // programs, so the whole safety net is blind to this class by construction.
    //
    // `break` targets the `while true` scaffold emit_speculative_branch_rich wraps a
    // cut-bearing branch in, landing on the shared rollback. Emitted ONLY at the BRANCH's
    // own top level (`cut_breaks`): inside a nested group `break` would bind to that
    // group's own repeat loop instead — a silent miscompile rather than a build error.
    let cut_abort = if item.cut && cut_breaks { "${ind}if !s_cut { break }\n" } else { "" }
    // The cut markers sit OUTSIDE the mode wrapper below, and that placement is load-bearing.
    // `cut_abort` is a `break`, and a wrapper emits its restore (`st.set_modes(__modes_N)`)
    // AFTER the item body — so a `break` emitted INSIDE the wrapper jumps straight past its
    // own restore. The branch rollback cannot compensate: it restores pos / store mark /
    // diags / hand / postfix state and deliberately not `st.modes`, so the next alternative
    // would parse with a leaked `@on`/`@off`/`@bump` flag. That is the same silent-miscompile
    // class as the `cut_breaks` guard above — wrong output, no build error — and the reason
    // both live here rather than inside emit_item_body.
    //
    // Hoisting is byte-identical for every grammar today: no production item carries a `@cut`
    // AND a mode marker, so one side or the other is always empty. It closes the trap for the
    // first item that carries both.
    let cut_marks = cut_pre + cut_abort
    let body = emit_item_body(g, item, idx, annots, ind, list_labels, opts, abortable, spec_ctx)
    // `@off(flag)` mode-SET marker: the emit twin of exec_item's push/restore —
    // save modes, clear the flag via modes_with_flag_off (the SAME fn the executor
    // calls, so they can't disagree), emit the item, restore. `__modes_${idx}` is
    // safe as a plain per-position name because within ONE emit_seq_items call `idx`
    // is unique, and a NESTED group's items emit inside their own `{ }` block (the
    // `if`/`while` scaffolding of emit_opt/emit_repeat_group) where a `let __modes_N`
    // legally SHADOWS any same-idx outer binding — a same-scope collision is
    // impossible. (Post-#995 validate_mode_markers ALLOWS @try + nested-group markers;
    // this per-item wrap is exactly what makes that sound.) Empty mode_off (every
    // production grammar today) returns the item's code unchanged → generated parsers
    // stay byte-identical.
    if item.mode_off != "" {
        return cut_marks +
            "${ind}let __modes_${idx} = st.modes\n" +
            "${ind}st.set_modes(modes_with_flag_off(st.modes, \"${item.mode_off}\"))\n" +
            body +
            "${ind}st.set_modes(__modes_${idx})\n"
    }
    // `@bump(counter)` counter-SET marker: save modes, INCREMENT via
    // modes_with_counter_bumped (the SAME fn the executor calls), emit the item, restore.
    if item.mode_bump != "" {
        return cut_marks +
            "${ind}let __modes_${idx} = st.modes\n" +
            "${ind}st.set_modes(modes_with_counter_bumped(st.modes, \"${item.mode_bump}\"))\n" +
            body +
            "${ind}st.set_modes(__modes_${idx})\n"
    }
    // `@on(flag)` mode-SET marker: the SET-ON twin — save modes, set the flag ON via
    // modes_with_flag_on (the SAME fn the executor calls), emit the item, restore.
    if item.mode_on != "" {
        // `@on_if(pred, flag)` (t-47hc.34): the SET is guarded, the save/restore is not.
        // Restoring modes that were never changed is a no-op, so hoisting the save out of
        // the branch keeps this a single emitted shape instead of two. The guard itself
        // comes from the SHARED `pred_guard` — the same string `@when` emits — so the two
        // markers cannot disagree about what a predicate name means, and a base predicate
        // lands as a `base_pred(...)` CALL into the executor rather than a second spelling.
        return cut_marks +
            "${ind}let __modes_${idx} = st.modes\n" +
            mode_on_set_line(item, ind) +
            body +
            "${ind}st.set_modes(__modes_${idx})\n"
    }
    cut_marks + body
}

/// The CALL itself for a `.Ref` item, in whichever of the four capture shapes the label
/// is in: accumulate into the branch's parallel list, assign an optional's slot, discard,
/// or bind. Factored out because `@onfail(skip)` needs the same call under an `else` —
/// two copies would be the drift hazard where a capture shape is fixed on one path only,
/// and a wrong capture shape is silent tree corruption (see the `.Gensym` arm below).
fn emit_ref_capture(g: Grammar, item: GItem, name: string, ind: string, list_labels: List<string>, opts: List<string>) -> string {
    emit_ref_capture_of(g, item, name, "parse_${name}(st)", ind, list_labels, opts)
}

/// `emit_ref_capture` over an arbitrary result EXPRESSION rather than the call itself, so
/// a policy that must inspect the result before capturing it can bind the call to a temp
/// first. Same four shapes, one definition — the capture shape must not be decided twice.
fn emit_ref_capture_of(g: Grammar, item: GItem, name: string, expr: string, ind: string, list_labels: List<string>, opts: List<string>) -> string {
    if str_in(list_labels, item.label) {
        return "${ind}${item.label}_list.push(${kind_coerce(rule_result_kind(g, name))}(st, ${expr}))\n"
    }
    if str_in(opts, item.label) { return "${ind}${item.label} = ${expr}\n" }
    if item.label == "" { return "${ind}let _ = ${expr}\n" }
    "${ind}let ${item.label} = ${expr}\n"
}

fn emit_item_body(g: Grammar, item: GItem, idx: int, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, abortable: bool, spec_ctx: int) -> string {
    match item.rep {
        .One -> emit_one(g, item, idx, annots, ind, list_labels, opts, abortable, spec_ctx)
        .Opt -> emit_opt(g, item, annots, ind, list_labels, opts, spec_ctx)
        .Star -> emit_repeat_group(g, item, idx, annots, ind, list_labels, opts, spec_ctx)
        .Plus -> emit_repeat_group(g, item, idx, annots, ind, list_labels, opts, spec_ctx)
    }
}

fn emit_one(g: Grammar, item: GItem, idx: int, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, abortable: bool, spec_ctx: int) -> string {
    match item.prim {
        .Ref(name) -> {
            // `@require <rule>` (t-47hc.24): the rule must START here, or the enclosing
            // rule reports and ABORTS. Checked on the rule's FIRST BEFORE the call — not
            // on whether the callee errored, which cannot tell an ABSENT sub-rule from a
            // sub-rule whose BODY was malformed (the hand recovers the latter). This is
            // the emit twin of the executor's .Ref branch in exec_item, and the same
            // s_cut guard the terminal abort needs: a @try branch that fails before its
            // cut must still roll back rather than return past the rollback scaffold.
            let req = if !item.require { "" } else {
                // The message key is the rule's single-literal FIRST when it has one,
                // and otherwise the RULE NAME — see seed_parser's `seq_expects_key`,
                // which refuses the marker unless one of the two supplies wording.
                // The FIRST-set GUARD below is unchanged either way; only what the
                // diagnostic says is keyed differently.
                let lit = rule_first_literal(g, name)
                let key = if lit != "" { lit } else { name }
                let exp = expect_for(annots, key)
                let rmsg = if exp.found { exp.msg } else { "expected ${key}" }
                // Raise the propagation flag, exactly as the required-TERMINAL abort
                // does (`abort_ret` in emit_one_terminal). Omitting it here meant a
                // required REF aborted its own rule and stopped: `enum E { A(x: ) }`
                // reported the missing type and then let `variant` finish, building
                // `(enum E (A(:<unknown>)))` where the hand aborts to `(error)`. The
                // gated unwinds in `variant` and `enum_decl` are what carry it out, and
                // they were reading a flag nobody set.
                let rraise = if grammar_has_gate(g) { "${ind}    st.set_abort_prop(true)\n" } else { "" }
                let rret = rraise + "${ind}    return CapVal.Node(st.error_node_silent())\n"
                let body = "${ind}    st.report(\"${rmsg}\")\n" +
                    (if !abortable { "" }
                     else if spec_ctx == spec_committed() { "${ind}    if s_cut {\n    ${rret}${ind}    }\n" }
                     else { rret })
                "${ind}if !(${rule_first_guard(g, name, [])}) {\n${body}${ind}}\n"
            }
            // t-myz7 `@onfail(skip)` — `@require`'s recovering dual, and the same FIRST
            // test: report that the sub-rule is absent, then step OVER it. The call is
            // what has to be skipped, not merely the abort — a rule reference consumes
            // its leading token on the promise that some caller proved its FIRST, and a
            // NON-LEADING ref makes no such promise, so calling it on a token it does not
            // start BINDS that token (`enum E< { A }` took the `{` as a type-parameter
            // name). Guarding the call is therefore the whole fix; leaving the abort off
            // is what lets the rest of the sequence still report (the hand's second
            // diagnostic, "expected `>` after type parameters") and still build a node.
            // The message is keyed EXACTLY as `@require`'s is — the rule's single-literal
            // FIRST when it has one, else the rule NAME, looked up in the caller's
            // `@expect` — so the two markers cannot report differently for the same
            // absent sub-rule, and `seq_expects_key` refuses the marker unless one of
            // the two supplies wording (validate_cuts).
            if item.onfail == "skip" {
                let lit = rule_first_literal(g, name)
                let key = if lit != "" { lit } else { name }
                let exp = expect_for(annots, key)
                let smsg = if exp.found { exp.msg } else { "expected ${key}" }
                // An IDENT position keeps the hand's reserved-keyword diagnostic (so07.2),
                // the same split `handle_missing` makes in the interpreter.
                let rep = if key == "IDENT" { "report_ident" } else { "report" }
                return "${ind}if !(${rule_first_guard(g, name, [])}) {\n" +
                    "${ind}    st.${rep}(\"${smsg}\")\n" +
                    "${ind}} else {\n" +
                    emit_ref_capture(g, item, name, ind + "    ", list_labels, opts) +
                    "${ind}}\n"
            }
            // t-myz7 `@onfail(close)`: the abort is read BEFORE the result is captured,
            // because capturing it is itself a report. `capval_to_select_arm` (and every
            // other `capval_to_*`) answers a non-matching CapVal by reporting — and an
            // aborted sub-parse returns exactly that, a silent error node — so pushing
            // the failed arm and popping it afterwards left two diagnostics behind for
            // a case the hand reports once. Bind the call, decide, then capture.
            // t-myz7 `@onfail(bail)`: the CALLEE owns the message, the caller owns the
            // control flow. Detected by "did diagnostics grow", which is exactly what
            // `@require` does for a non-ref item — and deliberately NOT `@require`'s
            // FIRST check, because that reports for the callee and so replaces its
            // message. `select { x <- }` must stay the expression view's F0040.
            if item.onfail == "bail" {
                let braise = if grammar_has_gate(g) { "${ind}    st.set_abort_prop(true)\n" } else { "" }
                let bret = braise + "${ind}    return CapVal.Node(st.error_node_silent())\n"
                let bbody = if !abortable { "" }
                    else if spec_ctx == spec_committed() { "${ind}    if s_cut {\n    ${bret}${ind}    }\n" }
                    else { bret }
                return "${ind}let __bres = parse_${name}(st)\n" +
                    "${ind}if capval_is_error_expr(st, __bres) {\n" +
                    bbody +
                    "${ind}}\n" +
                    emit_ref_capture_of(g, item, name, "__bres", ind, list_labels, opts)
            }
            // A GATED element's result is inspected BEFORE it is captured, because
            // capturing it is itself a report: every `capval_to_*` answers a
            // non-matching CapVal with one ("expected a variant", "expected a select
            // arm"), and an aborted sub-parse returns exactly that — a silent error
            // node. So the abort produced a SECOND diagnostic the hand never emits,
            // on top of the one that caused it. The caller-side `gated_abort_unwind`
            // could not prevent it: it runs after the push, which is where the
            // coercion already happened.
            //
            // What the abort DOES is the policy's business — unwind the rule (the
            // default, and what `enum`/`trait` need so the caller still sees the stray
            // `}`) or end the repetition and let the rule close (`@onfail(close)`).
            if item.gate {
                let gact = if item.onfail == "close" {
                    "${ind}    st.set_abort_prop(false)\n${ind}    break\n"
                } else {
                    "${ind}    return CapVal.Node(st.error_node_silent())\n"
                }
                // `abort_prop` is scoped to gate-bearing grammars (`grammar_has_gate`), so a
                // CROSS-VIEW callee cannot raise it: `param` is generated into the
                // EXPRESSION parser, where the flag is deliberately never written. Its
                // `@require` therefore aborted invisibly — the decl-side caller saw no
                // flag, coerced the silent error node, and `capval_to_pentry` reported
                // "expected a parameter" on top of the callee's own message.
                //
                // The error NODE is the signal that crosses views, and it is the same one
                // `@onfail(bail)` reads. Same meaning either way: this element failed.
                return "${ind}let __gres = parse_${name}(st)\n" +
                    "${ind}if st.abort_prop || capval_is_error_expr(st, __gres) {\n" +
                    gact +
                    "${ind}}\n" +
                    emit_ref_capture_of(g, item, name, "__gres", ind, list_labels, opts)
            }
            req + emit_ref_capture(g, item, name, ind, list_labels, opts)
        }
        .Hand(hf) -> {
            // A `@hand` primary captured under a repetition (`( s:@hand(f) )*`)
            // accumulates into the branch's list (the emit twin of the .Ref list
            // case, and of the executor's bind→append_node). run_hand_* yields a
            // raw id boxed by emit_hand_result; coerce it back to the list element.
            if str_in(list_labels, item.label) {
                return "${ind}${item.label}_list.push(${kind_coerce(hand_kind(hf))}(st, ${emit_hand_result(hf)}))\n"
            }
            if str_in(opts, item.label) { return "${ind}${item.label} = ${emit_hand_result(hf)}\n" }
            if item.label == "" { return "${ind}let _ = ${emit_hand_result(hf)}\n" }
            "${ind}let ${item.label} = ${emit_hand_result(hf)}\n"
        }
        // `@gensym` mints in PARSE ORDER, which is the whole reason it is a positional
        // primary rather than a build helper — see GPrim.Gensym. It emits a plain `let`
        // of the shared `gensym_token`, so the generated parser and the interpreter mint
        // the same name from the same counter.
        .Gensym(tag) -> {
            // The capture shapes, in the same order and for the same reasons as the
            // .Ref/.Hand arms above. `@gensym` rejects a repetition suffix on ITSELF,
            // but an enclosing GROUP may still repeat (`( t:@gensym(x) "," )*`), and
            // then `list_labels_of` puts the label in the list set via `under_multi`
            // and `list_decl_type` declares `t_list: List<Token>`. Emitting a plain
            // `let` there would leave that list permanently empty while the executor's
            // generic `bind()` filled it — an engine divergence, in the feature whose
            // whole design is about not having those.
            if str_in(list_labels, item.label) {
                return "${ind}${item.label}_list.push(gensym_token(st, \"${tag}\"))\n"
            }
            // An optional group (`( t:@gensym(x) )?`) pre-declares `mut t` in the
            // enclosing scope; a `let` here would SHADOW it and leave it Nil.
            if str_in(opts, item.label) {
                return "${ind}${item.label} = CapVal.Tok(gensym_token(st, \"${tag}\"))\n"
            }
            if item.label == "" { return "${ind}let _ = gensym_token(st, \"${tag}\")\n" }
            "${ind}let ${item.label} = CapVal.Tok(gensym_token(st, \"${tag}\"))\n"
        }
        // `@rawbrace` emits a call to the SAME shared scan the executor runs
        // (rawbrace_scan) — the whole point of centralising it: the generated parser
        // and the interpreter capture the same slice and report the same
        // unterminated-EOF message from one body. Capture shapes mirror `@gensym`'s,
        // and for the same reasons (an enclosing group may repeat or be optional even
        // though a suffix on the item itself is a grammar-parse error).
        .RawBrace(tag) -> {
            if str_in(list_labels, item.label) {
                return "${ind}${item.label}_list.push(rawbrace_scan(st, \"${tag}\"))\n"
            }
            if str_in(opts, item.label) {
                return "${ind}${item.label} = CapVal.Tok(rawbrace_scan(st, \"${tag}\"))\n"
            }
            if item.label == "" { return "${ind}let _ = rawbrace_scan(st, \"${tag}\")\n" }
            "${ind}let ${item.label} = CapVal.Tok(rawbrace_scan(st, \"${tag}\"))\n"
        }
        // A One group: a terminal alternation (`op:("!"|"-")`) yields a token
        // (bind it); a STRUCTURAL group (a nested alternation / sub-sequence,
        // e.g. variant_pat's `binds:IDENT … | subs:variant_pat …`) is inlined
        // via emit_node_items (an if/else-if dispatch for a multi-branch one).
        .Group(inner) -> {
            if prim_yields_token(item.prim) {
                return emit_one_terminal(g, item, idx, annots, ind, list_labels, opts, abortable, spec_ctx)
            }
            emit_node_items(g, inner, annots, ind, list_labels, opts, 1, spec_ctx)
        }
        // A `@when`/`@peek` predicate emits nothing (zero-width); emit_seq_items already
        // skips it, so this is a defensive no-op for any other caller.
        .Pred(_) -> ""
        .Peek(_) -> ""
        _ -> emit_one_terminal(g, item, idx, annots, ind, list_labels, opts, abortable, spec_ctx)
    }
}

/// A One terminal (Lit / Named / a terminal group). The guard token (idx 0) is
/// consumed unconditionally in every capture form (its FIRST already proved it).
/// A later (idx > 0) MANDATORY terminal — scalar, list-captured, optional-captured,
/// OR a terminal-alternation group — is VALIDATED strict-by-default, matching the
/// interpreter's exec_primary/handle_missing: it st.reports on a mismatch
/// (→ had_error → the authoritative hand fallback); @expect swaps the message,
/// @recover synchronises. The guard is `prim_first_guard` (not `term_guard`) so a
/// mandatory `("a" | "b")` group emits its FIRST disjunction rather than a bogus
/// always-failing `false`.
fn emit_one_terminal(g: Grammar, item: GItem, idx: int, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, abortable: bool, spec_ctx: int) -> string {
    // The primary's FIRST-set guard. For .Lit/.Named this is the SAME single-token
    // compare `term_guard` produced (byte-identical); for a terminal-alternation
    // .Group it is the FIRST disjunction (`term_guard` returned `false` for a group
    // — an always-failing check that rejected valid input; this is the fix).
    let t = prim_lit_text(item.prim)
    let base_cond = prim_first_guard(g, item.prim, [])
    // A ">" terminal (the generic-arg-list close) ALSO matches ">>" (Tk.Shr) and
    // splits it — consuming ONE ">" and leaving the second in-slot for the enclosing
    // generic's own close — the emit mirror of the interpreter's exec split_gt
    // (executor.av) and the hand parser's maybe_split_shr. Without it, List<List<T>> /
    // Map<K, List<V>> (the pervasive nested-generic close) errors on the merged ">>"
    // and re-parses through the hand fallback instead of natively. `adv` is the
    // token-consuming expression (split-aware for ">", a plain advance otherwise);
    // `cond` widens the ">" FIRST guard to accept the ">>" slot.
    let cond = if t == ">" { "(" + base_cond + " || st.cur().text == \">>\")" } else { base_cond }
    let adv = if t == ">" { "(if st.cur().text == \">>\" { st.split_gt() } else { st.advance() })" } else { "st.advance()" }
    let exp = expect_for(annots, t)
    // The message is DISCARDED on the production fallback (only had_error matters),
    // so a plain `expected <t>` (no backticks) is deterministic; a group has no
    // single lexeme (t == "") → a generic label.
    let msg = if exp.found { exp.msg } else if t == "" { "expected token" } else { "expected ${t}" }
    // so07.2 / 1rzz: an IDENT binding position keeps the hand parser's
    // RESERVED-KEYWORD diagnostic ("`move` is a reserved keyword …") instead of
    // reporting the generic `@expect` message at a `Tk.KwReserved` token. Routed via
    // the PState method so the generated parser and the executor's `handle_missing`
    // produce the same text from the same code. Non-IDENT terminals are untouched,
    // so every other rule regenerates byte-identical.
    let rep = if t == "IDENT" { "st.report_ident(\"${msg}\")" } else { "st.report(\"${msg}\")" }
    let sync = recover_target(annots)
    // `@require` ABORT: leave the rule instead of reporting and building on. The value
    // is the same error node emit already uses for "no branch matched", so callers
    // (capval_to_stmt / capval_to_expr) need no new case — the executor's exec_seq
    // returns exactly this on `env.abort`.
    // Past a `@cut` inside a `@try`, `abortable` is a STATIC fact ("this item sits after
    // the cut in the source") standing in for a RUNTIME one ("the cut actually fired").
    // They differ whenever the branch failed BEFORE reaching the cut: `s_cut` is still
    // false, the branch is destined to roll back, and an unguarded `return` here would
    // jump straight past the rollback scaffold — reporting an error where the executor
    // (whose exec_node clears env.abort on rollback) correctly falls through to the next
    // alternative. So a committed-context abort is GUARDED on s_cut; a predictive branch
    // has no rollback to bypass and returns outright.
    // A COMMITTED `@require` failure raises the propagation flag for the same reason
    // the gated FIRST check does: the caller cannot otherwise tell an abort from an
    // ordinary result and keeps consuming. Without it `shape S = { a int, b: int }`
    // reported the missing colon, re-entered parse_field, took `int` as the next field
    // name and reported AGAIN — where the hand stops the field list at the first
    // failure. Only the committed path raises it; a pre-cut failure still rolls back.
    let raise = if grammar_has_gate(g) { "${ind}    st.set_abort_prop(true)\n" } else { "" }
    let abort_ret = "${raise}${ind}    return CapVal.Node(st.error_node_silent())\n"
    let abort_line = if !item.require || !abortable { "" }
        else if spec_ctx == spec_committed() { "${ind}    if s_cut {\n    ${abort_ret}${ind}    }\n" }
        else { abort_ret }
    // t-myz7 `@onfail(discard, <label>)`: report the missing closer, then THROW AWAY the
    // list the bracket was collecting, and carry on. `parse_type_params` is exactly this
    // — `if !consume(Greater, …) { return empty }` — so `enum E<T { A }` is
    // `(enum E (A()))` on the hand: `T` is parsed and then dropped with the unterminated
    // bracket. Emitted into the same mismatch `else` every other terminal policy uses, so
    // the report still happens and nothing else about the position changes.
    //
    // Re-bound to a fresh `[]` rather than `.clear()`: the accumulator is a `mut` local
    // with a declared element type, so assignment is exact, and it keeps the generated
    // parser inside the SEED compiler's vocabulary. (`clear` is in the list method list
    // and now has a codegen arm, but a seed built before it cannot compile a caller —
    // emitted code has to be buildable by the seed, not only by HEAD.)
    let discard_line = if item.onfail != "discard" { "" } else { "${ind}    ${item.onfail_cap}_list = []\n" }

    // A repetition-captured terminal (`( … x:IDENT … )*`). idx==0 is the loop guard
    // (the enclosing `while` FIRST proved it) → unconditional push; a non-first
    // captured terminal validates first — the sibling of the executor's per-item
    // exec_primary inside a repetition (strict there too).
    if str_in(list_labels, item.label) {
        if idx == 0 { return "${ind}${item.label}_list.push(${adv})\n" }
        mut o = "${ind}if ${cond} { ${item.label}_list.push(${adv}) } else {\n"
        o = o + "${ind}    ${rep}\n"
        if sync != "" { o = o + "${ind}    st.synchronize(\"${sync}\")\n" }
        o = o + discard_line
        o = o + abort_line
        o = o + "${ind}}\n"
        return o
    }
    // An optional-captured scalar terminal — same idx discipline.
    if str_in(opts, item.label) {
        if idx == 0 { return "${ind}${item.label} = CapVal.Tok(${adv})\n" }
        mut o = "${ind}if ${cond} { ${item.label} = CapVal.Tok(${adv}) } else {\n"
        o = o + "${ind}    ${rep}\n"
        if sync != "" { o = o + "${ind}    st.synchronize(\"${sync}\")\n" }
        o = o + discard_line
        o = o + abort_line
        o = o + "${ind}}\n"
        return o
    }
    if idx == 0 {
        if item.label == "" { return "${ind}let _ = ${adv}\n" }
        return "${ind}let ${item.label} = CapVal.Tok(${adv})\n"
    }
    // A MANDATORY non-first SCALAR terminal. BYTE-IDENTICAL on VALID input: the
    // token is present, the `if` is taken, the `else` is dead; and on a mismatch the
    // cursor does not advance either way, so the built tree is identical — only
    // had_error flips (→ the fallback, which re-parses with the hand oracle).
    if item.label != "" {
        // Bind the label to the current token in the else so downstream
        // capval_tok_text stays safe (does NOT advance — mirrors the hand leaf).
        mut outl = "${ind}let ${item.label} = if ${cond} { CapVal.Tok(${adv}) } else {\n"
        outl = outl + "${ind}    ${rep}\n"
        if sync != "" { outl = outl + "${ind}    st.synchronize(\"${sync}\")\n" }
        // A CAPTURED `@require` aborts too — the unlabeled sibling below has always
        // emitted this, and omitting it here is why the two engines consumed different
        // amounts of input after the SAME failure (t-47hc.5). `@require b:IDENT` in
        // `if_expr` reported and then PARSED ON, swallowing `= x { 1 }`, while the
        // interpreter's `@require` set env.abort and stopped — so recovery started from
        // two different cursors and the statement-list loops could not converge. The
        // label is still bound on the non-aborting path, so downstream `capval_tok_text`
        // stays safe exactly as before.
        outl = outl + discard_line
        outl = outl + abort_line
        outl = outl + "${ind}    CapVal.Tok(st.cur())\n"
        outl = outl + "${ind}}\n"
        return outl
    }
    mut out = "${ind}if ${cond} { let _ = ${adv} } else {\n"
    out = out + "${ind}    ${rep}\n"
    if sync != "" { out = out + "${ind}    st.synchronize(\"${sync}\")\n" }
    out = out + discard_line
    out = out + abort_line
    out = out + "${ind}}\n"
    out
}

/// The emit twin of the executor's `sameline_ok` (executor.av): a `^`-marked
/// item's newline gate, folded into the enclosing `if`/`while` FIRST guard. When
/// the item is NOT `^`-marked (every production grammar today — the only `^` in
/// avra_grammar.av is the bitxor operator) it returns the guard UNCHANGED, so the
/// generated parsers regen byte-identical. When marked it WRAPS the guard in
/// parens (so `&&` binds over the whole FIRST disjunction, not just its last `||`
/// term) and ANDs the exact LineIndex comparison `sameline_ok` runs: the current
/// token must sit on the same source line as the previously-consumed one, else
/// the optional/repetition stops (the cross-line postfix cutoff). This closes the
/// latent lockstep gap where a `^` rule would parse differently under the
/// generated static parser than under the interpreter.
fn same_line_wrap(item: GItem, guard: string) -> string {
    if !item.sameline { return guard }
    "(" + guard + ") && (st.pos == 0 || st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line == st.store.lines.to_linecol(st.cur().pos).line)"
}

/// An optional group `( … )?` → an if guarded by the group's FIRST. The
/// group's captures accumulate into the branch's already-declared lists.
fn emit_opt(g: Grammar, item: GItem, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, spec_ctx: int) -> string {
    match item.prim {
        .Group(inner) -> {
            // A GATED optional needs the same FIRST re-check a gated repetition does —
            // `@gate` replaced the group's FIRST with a cond, so the callee's
            // "my caller proved FIRST" promise is broken here too. Without it
            // `enum E { 5 }` bound `5` as a variant name and compiled clean.
            "${ind}if ${same_line_wrap(item, node_first_guard(g, inner, []))} {\n" +
                gated_abort_arm(g, inner, ind + "    ") +
                gated_first_check(g, inner, ind + "    ") +
                emit_node_items(g, inner, annots, ind + "    ", list_labels, opts, 0, spec_ctx) +
                gated_abort_unwind(g, inner, ind + "    ") +
                "${ind}}\n"
        }
        _ -> {
            "${ind}if ${same_line_wrap(item, prim_first_guard(g, item.prim, []))} { let _ = st.advance() }\n"
        }
    }
}

/// A starred/plus group `( … )*` → a while guarded by the group's FIRST.
/// True iff a repeat group's body is a SINGLE @hand item (one branch, one item,
/// a `.Hand`). Such a body can consume NOTHING (a @hand delegate whose entry guard
/// is a superset of its own precise predicate — the Phase-3a postfix chain), so its
/// emitted `while` needs a no-progress break to mirror the interpreter's exec_repeat
/// (which already breaks on no progress). Always-progressing single-@hand loops
/// (with_suffix) get a dead-but-harmless break.
/// True iff the group is a single `@hand` delegate — INCLUDING one reached through a
/// one-line delegate rule (`postfix_suffix = @hand(postfix_suffix)`).
///
/// This gates the no-progress break emitted below, which is LOAD-BEARING: a hand step
/// that consumes nothing must END the chain, because the loop's FIRST guard can stay
/// true while the step declines to consume (the postfix chain guards on `Tk.Less`, so
/// `a < b` re-enters forever once the generic-call step decides it is a comparison).
///
/// Sharing one delegate behind a named rule — so 19 FIRST-disjoint bases reference it
/// once instead of duplicating it — is a SPELLING change, not a semantic one, so the
/// guard must survive it. Resolving one level of bare-ref indirection here keeps the
/// emitted loop identical whether the delegate is written inline or named.
fn group_is_single_hand(g: Grammar, node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            if branches.length != 1 || branches[0].items.length != 1 { return false }
            let p = branches[0].items[0].prim
            if prim_is_hand(p) { return true }
            match p {
                .Ref(nm) -> rule_reaches_hand(g, nm)
                _ -> false
            }
        }
    }
}

/// True iff rule `name` has an alternative that can return WITHOUT consuming a token,
/// so a `( name )*` loop over it needs the no-progress break or it spins forever.
///
/// TWO productions can do this, and the second was missed until the delegate was
/// actually deleted (t-47hc.33.2):
///
///   - a `@hand` delegate, which may decline and return the base unchanged; and
///   - a SPECULATIVE `@try` branch, which is entered when its FIRST holds and then
///     ROLLS BACK on failure, restoring the cursor it started from. `postfix_suffix`'s
///     `<T>(args)` generic call is exactly that: `a < b` enters on the `<` and un-decides.
///
/// The old comment here asserted the opposite — "a NATIVE alternative cannot: it is
/// entered only when its FIRST holds and then consumes" — which is true of every native
/// form EXCEPT a speculative one. While `@hand(postfix_suffix)` was still the tail the
/// error was masked: the hand disjunct alone kept the predicate true, so the break was
/// emitted anyway. Deleting the delegate dropped it, leaving `a < b` to spin.
///
/// Widening it is DORMANT on any grammar that still has the hand tail (a rule with both
/// keeps returning true), so it is byte-identical until the deletion spends it.
///
/// `postfix_suffix`'s
/// `parse_postfix_suffix` returns the base UNCHANGED for its three former loop-exit
/// paths (entry guard not matched, generic-call speculation failed, trailing non-postfix
/// arm); the break is what turns that into the hand `while` loop's exit. A NATIVE
/// alternative cannot: it is entered only when its FIRST holds and then consumes.
///
/// Widened from "the rule is EXACTLY `name = @hand(f)`" for t-47hc.33, which flips
/// `postfix_suffix`'s forms to native one at a time while keeping `@hand(postfix_suffix)`
/// as the tail alternative. Under the old bare-hand test the very first native
/// alternative silently DROPPED the break from every `( postfix_suffix )*` loop in the
/// generated parser — an infinite loop the moment the hand tail declined to consume.
/// Byte-identical today: every rule the old test admitted is still admitted (a bare hand
/// rule is a rule with a hand alternative), and no other repeated rule has one.
/// The pieces of the break-BEFORE-accumulate repeat body (see emit_repeat_group's
/// single-hand arm): a single-hand group qualifies when its one item is a PLAIN
/// labeled/unlabeled `.Ref` (no marker, rep One, no build/annots on the branch)
/// whose rule has NO actual @hand alternative — such a rule's only no-progress
/// exit is the all-speculative decline, which returns `CapVal.Nil`, and Nil must
/// break the loop BEFORE any coercion reports on it. A hand-reaching rule keeps
/// the historical order: its delegate returns a real node even on a decline, and
/// the byte-identical trees depend on that push.
type SinglePlainRef = { applies: bool, rule: string, acc: string }

fn single_plain_ref_group(g: Grammar, node: GNode, list_labels: List<string>) -> SinglePlainRef {
    let no = SinglePlainRef { applies: false, rule: "", acc: "" }
    match node {
        .Alt(branches) -> {
            if branches.length != 1 { return no }
            let b = branches[0]
            if b.items.length != 1 || !build_is_none(b.build) || b.annots.length != 0 || b.speculative || b.fallback { return no }
            let it = b.items[0]
            if !rep_is_one(it.rep) || it.sameline || it.cut || it.require { return no }
            if it.mode_off != "" || it.mode_on != "" || it.mode_bump != "" || it.mode_on_if != "" || it.bound != "" { return no }
            match it.prim {
                .Ref(nm) -> {
                    if rule_has_hand_alt(g, nm) { return no }
                    let acc = if it.label != "" && str_in(list_labels, it.label) {
                        "${it.label}_list.push(${kind_coerce(rule_result_kind(g, nm))}(st, __rep_cv))"
                    } else {
                        "let _ = __rep_cv"
                    }
                    SinglePlainRef { applies: true, rule: nm, acc }
                }
                _ -> no
            }
        }
    }
}

/// True iff `name`'s alternation has an ACTUAL `@hand` alternative — the
/// hand-only half of rule_reaches_hand's disjunction, splitting the two
/// no-progress shapes single_plain_ref_group must tell apart.
fn rule_has_hand_alt(g: Grammar, name: string) -> bool {
    let i = rule_index_of(g, name)
    if i < 0 { return false }
    match g.rules[i].body {
        .Alt(branches) -> {
            for b in branches {
                if b.items.length == 1 && prim_is_hand(b.items[0].prim) { return true }
            }
            false
        }
    }
}

/// Does this node carry a `@gate`d item? Drives the mandatory no-progress break on
/// a gated repetition — see emit_repeat_group. Structural and shallow on purpose: a
/// gate inside a NESTED group is that group's own loop's problem, and its loop gets
/// the same treatment when it is emitted.
/// The gated item in this node, if any — the rule REFERENCE name and the message its
/// own rule would use when its FIRST token is missing.
///
/// SOUNDNESS (t-myz7). A generated `parse_X` consumes its leading terminal
/// UNCONDITIONALLY (`let n = CapVal.Tok(st.advance())`) because emit's convention is
/// that the CALLER proved FIRST(X). `@gate` deliberately replaces that FIRST with a
/// cond, so under a gate the convention no longer holds and the callee swallows
/// whatever token is there: `enum E { 5 }` bound `5` as a variant name and COMPILED
/// CLEAN, where the hand rejects it. A gated call therefore has to re-establish what
/// the gate removed — check the rule's FIRST at the call site and report with the
/// RULE's own `@expect`, not the enclosing sequence's (enum_decl's IDENT expect says
/// "expected enum name"; the message owed here is variant's "expected variant name").
/// Re-establish, at a GATED call site, the FIRST check the gate removed.
///
/// `parse_X` consumes its leading terminal unconditionally on the promise that its
/// caller proved FIRST(X). `@gate` replaces that FIRST with a cond, so the promise is
/// broken and the callee swallows whatever token is present — `enum E { 5 }` bound
/// `5` as a variant name and compiled CLEAN. Emitting the check here restores the
/// invariant without giving up what the gate bought (entry on a token the FIRST
/// rejects, e.g. EOF), and reports with the CALLED rule's own message.
/// The caller-side half of abort propagation: after a gated element's sub-parse,
/// unwind if it aborted. Without this the abort stops at the callee and the
/// enclosing rule carries on consuming — `enum E { A( }` ate the `}` that the hand
/// leaves behind, losing the hand's second diagnostic. Emitted only where a gate is
/// present, so every existing grammar is untouched.
fn gated_abort_unwind(g: Grammar, inner: GNode, ind: string) -> string {
    let gr = gated_ref_of(inner)
    if !gr.found { return "" }
    // t-myz7 `@onfail(close)` unwinds NOWHERE: the abort ends the repetition and the
    // enclosing rule carries on to its own closer. `select { x }` is the shape — the hand
    // reports the missing `<-` and still builds `(select ())`, so the `}` must be left for
    // the rule's `@require "}"` rather than abandoned for the caller to report as a
    // second, spurious F0013. The break itself is emitted at the ELEMENT (emit_one's
    // `.Ref` arm), before its result is captured, because capturing an aborted result is
    // itself a report.
    if gr.onfail == "skip" || gr.onfail == "close" { return "" }
    "${ind}if st.abort_prop {\n" +
    "${ind}    return CapVal.Node(st.error_node_silent())\n" +
    "${ind}}\n"
}

/// ARM the flag: clear it immediately BEFORE a gated sub-parse, so the matching
/// `gated_abort_unwind` reads THAT sub-parse's outcome and nothing else.
///
/// Without this the check is not "did the gated callee abort" but "has anything
/// aborted anywhere in this item since the start rule reset" — `@require` raises
/// the flag grammar-wide, so an unrelated earlier abort in the same declaration
/// made a later gated element unwind on someone else's failure and swallow the
/// caller's own resync diagnostic. `for` was the caught case: its header abort
/// must leave TWO diagnostics (the header error, then the caller's resync), and a
/// stale flag cut the second one.
///
/// It composes upward: an enclosing gated caller cleared before ITS sub-parse, and
/// the inner raise happens during it, so a genuine abort still propagates out
/// through every gated frame — only the STALE reads are removed.
fn gated_abort_arm(g: Grammar, inner: GNode, ind: string) -> string {
    let gr = gated_ref_of(inner)
    if !gr.found { return "" }
    "${ind}st.set_abort_prop(false)\n"
}

fn gated_first_check(g: Grammar, inner: GNode, ind: string) -> string {
    let gr = gated_ref_of(inner)
    if !gr.found { return "" }
    let fg = rule_first_guard(g, gr.rule, [])
    if fg == "" || fg == "false" { return "" }
    // The guard is emitted whenever the rule HAS a usable FIRST — never made
    // conditional on the message existing. Returning "" for a missing `@expect`
    // would reopen the exact silent-ACCEPT this check exists to close: the callee
    // consumes its leading token unconditionally, so with no guard a gated call
    // binds whatever is there (`enum E { 5 }` took `5` as a variant name and
    // compiled clean). A rule with no `@expect` gets a generic message — worse
    // wording, still a rejection. Only an unusable FIRST declines, and that is the
    // case where there is genuinely nothing to test.
    // t-myz7 `@onfail(close)`: an element that does not even START is a failing element,
    // and this policy's answer to a failing element is to end the repetition and let the
    // rule close — SILENTLY, because the rule's own closer is what reports. That is the
    // hand, exactly: `parse_select_arm_list` answers a non-IDENT head with a bare
    // `return out`, and `select { 5 }` is then "expected `}` to close select" and nothing
    // else. Reporting here as well would name the element the hand never mentions.
    // `@onfail(skip)` owns this position itself (emit_one's `.Ref` arm renders the
    // FIRST test, the report and the step-over), and it must NOT abort. The gate's
    // only remaining job is the ENTRY decision — `@peek` narrows a branch's FIRST,
    // `@gate` replaces it, and replacing is what lets the loop be entered on a token
    // the element's own FIRST refuses so the element can report about it.
    if gr.onfail == "skip" { return "" }
    if gr.onfail == "close" { return "${ind}if !(${fg}) { break }\n" }
    let em = rule_first_expect_msg(g, gr.rule)
    let msg = if em == "" { "expected ${gr.rule}" } else { em }
    "${ind}if !(${fg}) {\n" +
    "${ind}    st.report(\"${msg}\")\n" +
    "${ind}    st.set_abort_prop(true)\n" +
    "${ind}    return CapVal.Node(st.error_node_silent())\n" +
    "${ind}}\n"
}



fn node_has_gate(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.gate { return true }
                }
            }
            false
        }
    }
}

/// `abort_prop` is READ in exactly one place — `gated_abort_unwind`, which is
/// emitted only where a `@gate` is present. So the flag's WRITES are scoped to
/// the same grammars: a view with no gate can never observe the value, and
/// emitting the reset/raise there would be a pure blast radius. This is not
/// hypothetical tidiness — `emit.av` renders FOUR checked-in production parsers
/// (decl / expr / type / pattern) from one emitter, and an unscoped write put
/// `st.set_abort_prop(…)` into all four while only the decl grammar has gates.
///
/// The `g.rules[0]` reset in particular is only sound at a PER-ITEM entry, which
/// is what the decl view's start rule is. The expr/type/pattern start rules are
/// NESTED entries — reached mid-declaration, many times per item — so resetting
/// there states something false about the flag's lifetime even where it happens
/// to be harmless.
fn grammar_has_gate(g: Grammar) -> bool {
    for r in g.rules {
        if rule_body_has_gate(r.body) { return true }
    }
    false
}

/// The recursive form of `node_has_gate`: a gate can sit inside a `( … )*` /
/// `( … )?` group (that is where `enum_decl` and `trait_decl` put theirs), so a
/// top-level-only scan would miss every real one.
fn rule_body_has_gate(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.gate { return true }
                    match it.prim {
                        .Group(inner) -> { if rule_body_has_gate(inner) { return true } }
                        _ -> {}
                    }
                }
            }
            false
        }
    }
}

fn rule_reaches_hand(g: Grammar, name: string) -> bool {
    let i = rule_index_of(g, name)
    if i < 0 { return false }
    match g.rules[i].body {
        .Alt(branches) -> {
            for b in branches {
                if b.items.length == 1 && prim_is_hand(b.items[0].prim) { return true }
                // A rolled-back `@try` consumes nothing — same hazard as a declining hand.
                if b.speculative { return true }
            }
            false
        }
    }
}

/// The generated twin of the hand parser's `parse_statement_list_ids`
/// (parse/mod.av:821): a labeled bare-ref `*`/`+` over a STATEMENT rule — a
/// block's `stmts:statement*` — parses statements until `}`/EOF, records each
/// child's SrcPos (entry byte → to_linecol, the add_stmt_at twin), and on a
/// failed child runs panic-mode resync (`synchronize_stmt`) + a positioned
/// `Stmt.Error` placeholder, byte-identical to the hand recovery. Unlike the
/// interpreter's `exec_repeat` (a span-free FIRST-guard loop with no recovery),
/// this mirrors the HAND loop directly — the generated static parser owns the
/// block's statement-list recovery. No other emitted grammar uses this shape
/// today, so wiring it into emit_repeat_group is additive (emit-gen-check proves
/// existing grammars are byte-identical). (t-47hc.13 — the control-flow flip.)
fn emit_stmt_list_loop(name: string, label: string, ind: string, drop_failed: bool) -> string {
    // had_error is a SINGLE PState flag reused across children (unlike the single-
    // statement flip path, which gets a fresh PState per statement). So we CAPTURE
    // any pre-loop error (e.g. from an if/for/while header condition parsed before
    // this block) into `__pre_err`, then CLEAR before each child parse so `if
    // st.had_error` detects only THIS child's failure (never the leaked condition
    // error misclassifying the first body statement). `__any_err` accumulates
    // pre-loop | per-child failures and is RESTORED to the flag at loop exit, so a
    // condition/body error stays visible to the caller — the diagnostics themselves
    // live in `diags` (clear_error touches only the flag), matching the hand
    // parser's monotonic had_error over parse_statement_list_ids.
    "${ind}let __pre_err = st.had_error\n" +
        "${ind}mut __any_err = __pre_err\n" +
        "${ind}while true {\n" +
        "${ind}    if st.at_end() || st.cur().text == \"}\" { break }\n" +
        "${ind}    let __sp = st.cur().pos\n" +
        "${ind}    let __before_i = st.pos\n" +
        "${ind}    st.clear_error()\n" +
        "${ind}    let __cv = parse_${name}(st)\n" +
        // WHICH children count as failed differs by policy, and the difference is the
        // whole of `@onfail(drop)` (t-myz7):
        //
        //   default — ANY reported error. The child gets an `(error)` row, so a block
        //     whose body merely recovered still shows the failure in the tree.
        //   drop    — only an ABORT. A child that reported and then RECOVERED is KEPT,
        //     because that is what the hand does: `parse_spec_body` returns its partial
        //     item list, so an inner failure loses the inner item and nothing more.
        //     Keying `drop` on had_error instead threw away every ANCESTOR too —
        //     `spec "s" { given "g" { then } }` lost the whole `given`, since the body
        //     loop's own `note_had_error` re-raises the flag on the way out.
        (if drop_failed { "${ind}    if st.abort_prop {\n" } else { "${ind}    if st.had_error {\n" }) +
        "${ind}        __any_err = true\n" +
        "${ind}        st.synchronize_stmt()\n" +
        // t-47hc.5: step out of a group the CHILD opened and never closed. Without this
        // `synchronize_stmt` parks on a brace that closes the child's group rather than
        // this block's, and the scan then skips a following VALID statement instead of
        // resuming on it — the interpreter's twin keeps it, so the two engines built
        // different trees for the same recovery.
        "${ind}        mut __ob = st.brace_delta(__before_i, st.pos)\n" +
        "${ind}        while __ob > 0 && !st.at_end() && st.cur().tk == Tk.RightBrace {\n" +
        "${ind}            let _ = st.advance()\n" +
        "${ind}            __ob = __ob - 1\n" +
        "${ind}        }\n" +
        "${ind}        if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }\n" +
        // `@onfail(drop)`: the aborted child is OMITTED rather than standing an `(error)`
        // row in its place, and the abort is CLEARED — it has been handled here, and
        // leaving it raised would abort this rule's own caller in turn. Everything else
        // in the arm is shared: the diagnostics stay, the resync is the same one.
        (if drop_failed {
            "${ind}        st.set_abort_prop(false)\n"
        } else {
            "${ind}        let __elc = st.store.lines.to_linecol(__sp)\n" +
            "${ind}        let __e = st.store.stmts.add_leaf(Stmt.Error)\n" +
            "${ind}        st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })\n" +
            "${ind}        ${label}_list.push(__e)\n"
        }) +
        "${ind}        st.clear_error()\n" +
        "${ind}        continue\n" +
        "${ind}    }\n" +
        // A `drop` child that reported and RECOVERED reaches here and is kept, so its
        // error has to be carried out by hand — the default loop got that for free from
        // the branch above, which it never falls out of.
        (if drop_failed { "${ind}    if st.had_error { __any_err = true }\n" } else { "" }) +
        "${ind}    let __sid = capval_to_stmt(st, __cv)\n" +
        "${ind}    let __lc = st.store.lines.to_linecol(__sp)\n" +
        "${ind}    st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })\n" +
        "${ind}    ${label}_list.push(__sid)\n" +
        "${ind}}\n" +
        "${ind}if __any_err { st.note_had_error() }\n"
}

/// t-47hc.28 `x{#cap}` — the generated twin of exec_repeat's cap. Three pieces that
/// must be placed around the loop, returned separately because each of
/// emit_repeat_group's three arms assembles its `while` differently:
///   `.decl`  — the counter, declared just BEFORE the loop (so a bounded loop nested
///              in an outer repetition resets per outer iteration, exactly as a fresh
///              exec_repeat call does).
///   `.guard` — the `break`, FIRST statement in the body, mirroring exec_repeat's
///              `if cap >= 0 && taken >= cap { return }` before the primary runs.
///   `.step`  — the increment, LAST statement in the body.
/// A counter is used rather than the capture's own length because a bounded item
/// inside a repeating group accumulates ACROSS iterations into one flat parallel
/// list (`match … table`'s cells over all rows), so the list length is not the
/// per-loop count. Named `__bnd_<idx>` on the same footing as `__modes_<idx>` above:
/// within ONE emit_seq_items call `idx` is unique, and a nested group's items emit
/// inside their own `{ }` block where a same-idx binding legally shadows — so a
/// same-scope collision is impossible. (A label-derived name would not do: the bound
/// commonly sits on an UNLABELLED group whose captures are on its inner items.)
type BoundEmit = { decl: string, guard: string, step: string }

fn bound_emit(item: GItem, idx: int, ind: string) -> BoundEmit {
    if item.bound == "" { return BoundEmit { decl: "", guard: "", step: "" } }
    let v = "__bnd_${idx}"
    BoundEmit {
        decl: "${ind}mut ${v} = 0\n",
        guard: "${ind}    if ${v} >= ${item.bound}_list.length { break }\n",
        step: "${ind}    ${v} = ${v} + 1\n",
    }
}

fn emit_repeat_group(g: Grammar, item: GItem, idx: int, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, spec_ctx: int) -> string {
    let bnd = bound_emit(item, idx, ind)
    match item.prim {
        // A labeled bare-ref `*`/`+` over a STATEMENT rule → the statement-list-with-
        // recovery loop (emit_stmt_list_loop). Non-matching refs keep the pre-existing
        // discard behaviour (byte-identical to the old `_` arm that caught `.Ref`).
        .Ref(name) -> {
            if item.label != "" && str_in(list_labels, item.label) && rule_result_kind(g, name) == "stmt" && item.bound != "" {
                // emit_stmt_list_loop builds its own loop with recovery and has no
                // seam for a cap, so honouring the bound here would mean silently
                // dropping it — the same failure the sibling branch below guards.
                // No grammar needs a bounded statement list today; fail loud rather
                // than generate a parser whose bound does nothing.
                "${ind}// GRAMMAR ERROR: `${item.label}:${name}*{#${item.bound}}` — a bounded statement-list repetition is unsupported (emit_stmt_list_loop has no cap seam)\n" +
                    "${ind}let _ = emit_unsupported_bounded_stmt_list\n"
            } else if item.label != "" && str_in(list_labels, item.label) && rule_result_kind(g, name) == "stmt" {
                emit_stmt_list_loop(name, item.label, ind, item.onfail == "drop")
            } else if item.label != "" && str_in(list_labels, item.label) {
                // A labeled bare-ref `*`/`+` over a NON-statement rule: its `<label>_list`
                // accumulator is declared but the discard loop below would never populate
                // it → silent data loss. Unreachable today (only block's `stmts:statement*`
                // uses this shape), so FAIL LOUD at generation (the generated file won't
                // compile, naming the unsupported construct) instead of dropping captures.
                // A future author wanting `xs:rule*` should wrap it in `( … )*` (the .Group
                // path) or add an accumulation branch for that result kind here.
                "${ind}// GRAMMAR ERROR: labeled bare-ref `${item.label}:${name}*` over a non-statement rule is unsupported — wrap in `( … )*` or extend emit_repeat_group\n" +
                    "${ind}let _ = emit_unsupported_labeled_bare_ref_star\n"
            } else if item.bound == "" {
                "${ind}while ${same_line_wrap(item, prim_first_guard(g, item.prim, []))} { let _ = st.advance() }\n"
            } else {
                bnd.decl + "${ind}while ${same_line_wrap(item, prim_first_guard(g, item.prim, []))} {\n" +
                    bnd.guard + "${ind}    let _ = st.advance()\n" + bnd.step + "${ind}}\n"
            }
        }
        .Group(inner) -> {
            // `+` (Plus) requires ≥1 repetition. emit_repeat_group otherwise lowers Star
            // and Plus IDENTICALLY (a plain `while`, 0+), diverging from the executor,
            // whose exec_item_body forces a first `.Plus` iteration. That divergence is
            // latent for a NON-speculative Plus — it is entered only when its FIRST holds
            // (the dispatch/optional guard), so ≥1 is guaranteed and `req` never fires
            // (byte-identical, e.g. eq_tail's `( op r )+`). But inside a `@try` branch a
            // 0-match Plus would wrongly COMMIT instead of rolling back — so require the
            // first here: reporting a diagnostic when the FIRST is absent grows st.diags,
            // which the speculative commit-guard reads to roll back (the emit twin of the
            // forced first iteration). Message text is irrelevant: it never surfaces —
            // non-spec never fires it, spec discards it on rollback (truncate/restore).
            // A `+` needs ≥1 match. The default message never surfaces (a non-speculative Plus is
    // entered only when its FIRST holds; a speculative one discards it on rollback), but a
    // Plus that is REQUIRED mid-sequence — `@pkg::name`'s `( "::" IDENT )+` — does report,
    // and must match the hand parser's wording. `@expect("+", msg)` overrides it.
    let req_msg = { let e = expect_for(annots, "+")  if e.found { e.msg } else { "expected at least one repetition" } }
    let req = match item.rep { .Plus -> "${ind}if !(${same_line_wrap(item, node_first_guard(g, inner, []))}) { st.report(\"${req_msg}\") }\n"  _ -> "" }
            // The bound pieces are empty strings when unbounded, so splicing them into
            // this multi-line shape leaves the generated text byte-identical.
            if group_is_single_hand(g, inner) {
                // Two body orders, split by WHAT a no-progress iteration hands back.
                //
                // A rule with an actual @hand alternative returns a REAL node even when
                // the delegate declines, so the historical accumulate-THEN-break order
                // is byte-identical and stays.
                //
                // A rule whose decline is all-SPECULATIVE (`postfix_suffix` once its
                // hand tail was retired) hands back a no-progress `CapVal.Nil` — and
                // coercing THAT before the break made capval_to_* REPORT. On valid
                // input (`a < b` after a callable base: the generic-call `@try` enters
                // on `<` and un-decides) the spurious report failed the whole enclosing
                // item branch, which then rode the interpreter fallback on EVERY such
                // expression — and when the item's already-parsed header held a split
                // `>>`, the rollback re-parsed a mutated token stream and real errors
                // surfaced (t-47hc Phase 4). Parse first, break on no progress, and
                // only then accumulate — the emit twin of exec_repeat's silent exit.
                let spr = single_plain_ref_group(g, inner, list_labels)
                if spr.applies {
                    req + bnd.decl + "${ind}while ${same_line_wrap(item, node_first_guard(g, inner, []))} {\n" +
                        bnd.guard +
                        "${ind}    let __rep_before = st.pos\n" +
                        "${ind}    let __rep_cv = parse_${spr.rule}(st)\n" +
                        "${ind}    if st.pos == __rep_before { break }\n" +
                        "${ind}    ${spr.acc}\n" +
                        bnd.step +
                        "${ind}}\n"
                } else {
                    req + bnd.decl + "${ind}while ${same_line_wrap(item, node_first_guard(g, inner, []))} {\n" +
                        bnd.guard +
                        "${ind}    let __rep_before = st.pos\n" +
                        emit_node_items(g, inner, annots, ind + "    ", list_labels, opts, 0, spec_ctx) +
                        "${ind}    if st.pos == __rep_before { break }\n" +
                        bnd.step +
                        "${ind}}\n"
                }
            } else if node_has_gate(inner) {
                // t-myz7: a GATED repetition MUST carry the no-progress break. `@gate`
                // drops the element's FIRST from the loop condition, and that FIRST was
                // also what terminated the loop — so `while lookahead_ok(cond, st)` over
                // an element that consumes nothing spins forever. Measured: `enum E {`
                // with a gated variant loop HUNG (exit 124), it did not merely report the
                // wrong message. The break is the same one group_is_single_hand emits for
                // the hand-delegate shape, required here for the same reason: the loop
                // condition no longer implies progress.
                req + bnd.decl + "${ind}while ${same_line_wrap(item, node_first_guard(g, inner, []))} {\n" +
                    bnd.guard +
                    "${ind}    let __rep_before = st.pos\n" +
                    gated_abort_arm(g, inner, ind + "    ") +
                    gated_first_check(g, inner, ind + "    ") +
                    emit_node_items(g, inner, annots, ind + "    ", list_labels, opts, 0, spec_ctx) +
                    gated_abort_unwind(g, inner, ind + "    ") +
                    "${ind}    if st.pos == __rep_before { break }\n" +
                    bnd.step +
                    "${ind}}\n"
            } else {
                req + bnd.decl + "${ind}while ${same_line_wrap(item, node_first_guard(g, inner, []))} {\n" +
                    bnd.guard +
                    emit_node_items(g, inner, annots, ind + "    ", list_labels, opts, 0, spec_ctx) +
                    bnd.step +
                    "${ind}}\n"
            }
        }
        _ -> {
            let req = match item.rep { .Plus -> "${ind}if !(${same_line_wrap(item, prim_first_guard(g, item.prim, []))}) { st.report(\"expected at least one repetition\") }\n"  _ -> "" }
            if item.bound == "" {
                req + "${ind}while ${same_line_wrap(item, prim_first_guard(g, item.prim, []))} { let _ = st.advance() }\n"
            } else {
                req + bnd.decl + "${ind}while ${same_line_wrap(item, prim_first_guard(g, item.prim, []))} {\n" +
                    bnd.guard + "${ind}    let _ = st.advance()\n" + bnd.step + "${ind}}\n"
            }
        }
    }
}

/// Emit a group's items. A single-branch group inlines its sequence; a
/// MULTI-branch group (an inline alternation, e.g. variant_pat's
/// `binds:IDENT … | subs:variant_pat …`) becomes an if/else-if dispatch on
/// each branch's FIRST — the executor's exec_node branch selection, inlined.
/// `idx_base` says whether this group's first token was already PROVEN by the caller.
/// 0 — the caller emitted a FIRST guard (emit_opt's `if`, emit_repeat_group's `while`),
/// so the group's leading terminal is consumed unconditionally. 1 — the group is
/// entered UNGUARDED (a structural group sitting mid-sequence), so its leading terminal
/// must be validated too. The multi-branch case always emits its own per-branch guard,
/// so it proves the token itself and ignores `idx_base`.
fn emit_node_items(g: Grammar, node: GNode, annots: List<GAnnot>, ind: string, list_labels: List<string>, opts: List<string>, idx_base: int, spec_ctx: int) -> string {
    match node {
        .Alt(branches) -> {
            if branches.length == 0 { return "" }
            if branches.length == 1 {
                return emit_seq_items_from(g, branches[0], annots, ind, list_labels, opts, idx_base, spec_ctx)
            }
            mut out = ""
            mut i = 0
            for b in branches {
                let kw = if i == 0 { "if" } else { "} else if" }
                out = out + "${ind}${kw} ${seq_first_guard(g, b, [])} {\n"
                out = out + emit_seq_items_from(g, b, annots, ind + "    ", list_labels, opts, 0, spec_ctx)
                i = i + 1
            }
            out = out + "${ind}}\n"
            out
        }
    }
}

// ── A sequence's result (the build), apply_build's emission twin ──

fn emit_seq_result(g: Grammar, seq: GSeq) -> string {
    // `lone_item_index`, NOT `items.length == 1`: a leading `@peek`/`@when` is a
    // ZERO-WIDTH gate, so `@peek(c) @hand(f)` is still a LONE hand primary. Counting
    // raw items made both checks below miss it, and the sequence fell through to the
    // build-less `.None` arm — emitting `let _ = run_hand_stmt(…)` and returning
    // CapVal.Nil, i.e. running the leaf and THROWING ITS RESULT AWAY. (Caught peeling
    // the match table sub-language off behind `@peek(match_table) @hand(match_table)`.)
    let lone = lone_item_index(seq)
    // A lone unlabelled terminal with no build is the default literal build
    // (executor coerces the boundary Tok via literal_node).
    if lone >= 0 && rep_is_one(seq.items[lone].rep) &&
        seq.items[lone].label == "" && prim_is_terminal(seq.items[lone].prim) &&
        build_is_none(seq.build) {
        return "CapVal.Node(literal_node(st, st.advance()))"
    }
    // A lone @hand primary is its own result.
    if lone >= 0 && rep_is_one(seq.items[lone].rep) &&
        prim_is_hand(seq.items[lone].prim) && build_is_none(seq.build) {
        return emit_hand_result(hand_name(seq.items[lone].prim))
    }
    match seq.build {
        .None -> "CapVal.Nil"
        .Var(name) -> name
        .Call(name, args) -> emit_call_build(name, args)
    }
}

/// The build-name → emission map — executor.apply_build's one-to-one twin.
/// Scalar captures are their CapVal vars; a `_list` suffix names an
/// accumulated arg (only call_suffix's, which takes the whole arg list).
fn emit_call_build(name: string, args: List<string>) -> string {
    match name {
        // ── Expression builds (target: Expr) ──
        "fold_binary" -> "CapVal.Node(fold_binary_expr(st, ${arg3(args)}))"
        // sp_start (the rule fn's entry byte, emitted below by build_uses_sp_start)
        // threads the hand parser's [production-entry, next-token) span into the
        // DSL compound builders — see executor.av. fold_binary→Pratt and
        // fold_postfix→@hand keep their span-free signatures.
        "fold_logical" -> "CapVal.Node(fold_logical_expr(st, sp_start, ${arg3(args)}))"
        "fold_nullish" -> "CapVal.Node(fold_nullish_expr(st, sp_start, ${arg3(args)}))"
        "fold_postfix" -> "CapVal.Node(fold_postfix_expr(st, ${arg2(args)}))"
        "mk_assign" -> "CapVal.Node(mk_assign_expr(st, sp_start, ${args[0]}, ${args[1]}))"
        "fold_pipe" -> "CapVal.Node(fold_pipe_expr(st, sp_start, ${args[0]}, CapVal.Nodes(${args[1]}_list)))"
        // The `with` postfix fold (Phase 3a-3): `base` is a scalar CapVal, `s` a
        // repetition list of PARTIAL `with_suffix` nodes; fold_with_expr rebinds
        // each onto the accumulated base with the per-step span.
        "fold_with" -> "CapVal.Node(fold_with_expr(st, sp_start, ${args[0]}, CapVal.Nodes(${args[1]}_list)))"
        // The Phase-3a postfix+with fold: `base` is a scalar CapVal, `p` the postfix-
        // step list, `s` the with-suffix list. fold_postfix_with_expr takes the last
        // postfix node (the complete chain) then rebinds each `with` suffix over it.
        "fold_postfix_with" -> "CapVal.Node(fold_postfix_with_expr(st, sp_start, ${args[0]}, CapVal.Nodes(${args[1]}_list), CapVal.Nodes(${args[2]}_list)))"
        // The is/in/==-chain equality suffix (ps3t.6.7 Step C). mk_inlist's `a`
        // and mk_eqchain's `op`/`r` are repetition captures (list accumulators).
        "rebind_eq" -> "CapVal.Node(rebind_eq_expr(st, sp_start, ${args[0]}, ${args[1]}))"
        "mk_is" -> "CapVal.Node(mk_is_expr(st, ${args[0]}))"
        "mk_inlist" -> "CapVal.Node(mk_inlist_expr(st, CapVal.Nodes(${args[0]}_list)))"
        // `[ … ]` list literal + comprehension (t-47hc.4 — DORMANT builds; see executor
        // mk_list_lit/mk_list_comp). `a` is the comma-list repetition accumulator (like
        // mk_inlist's). Both span at sp_start = their OWNING RULE's entry byte: the `[`
        // for MkListLit (built in list_expr), but the BODY's first byte for MkListComp
        // (built in the list_comp sub-rule entered after `[`). MkListComp's body/v/coll
        // are scalars; the optional `filt` (arity 4) is Nil when the `( if … )?` is absent.
        "MkListLit" -> "CapVal.Node(mk_list_lit(st, sp_start, CapVal.Nodes(${args[0]}_list)))"
        // `( a, b, … )` tuple (t-47hc paren prep — DORMANT). Structural twin of MkListLit:
        // `a` is the comma-list accumulator, spanned at sp_start = the owning rule's `(`.
        "MkTuple" -> "CapVal.Node(mk_tuple(st, sp_start, CapVal.Nodes(${args[0]}_list)))"
        // `( … ) -> body` untyped lambda (t-47hc paren prep — DORMANT). args[0] = the
        // param-name comma-list accumulator, args[1] = the body scalar (→ ExprId).
        "MkLambda" -> "CapVal.Node(mk_lambda(st, sp_start, CapVal.Nodes(${args[0]}_list), capval_to_expr(st, ${args[1]})))"
        // `( x: T, … ) -> body` typed lambda (t-47hc paren prep — DORMANT). args[0] = the
        // PENTRY-list accumulator (MkParam-built, already typed List<ParamEntry> in the
        // generated parser — passed directly like MkFnDecl), args[1] = the body scalar.
        "MkLambdaTyped" -> "CapVal.Node(mk_lambda_typed(st, sp_start, ${args[0]}_list, capval_to_expr(st, ${args[1]})))"
        // `( e )` grouping OR `()` empty tuple — args[0] is the OPT-SCALAR grouping expr (a
        // `mut <e>: CapVal = CapVal.Nil` local, NOT a `_list` accumulator), passed as-is so
        // mk_group_or_empty reads Nil→Tuple([]) / else→Grouping(e).
        "MkGroupOrEmpty" -> "CapVal.Node(mk_group_or_empty(st, sp_start, ${args[0]}))"
        // `( first, rest… )` tuple — args[0] is the SCALAR first element (a `let <first>` local),
        // args[1] the REST list accumulator (`<rest>_list`); mk_tuple_fr prepends first.
        "MkTupleFR" -> "CapVal.Node(mk_tuple_fr(st, sp_start, ${args[0]}, CapVal.Nodes(${args[1]}_list)))"
        "MkListComp" -> {
            let filt = if args.length == 4 { args[3] } else { "CapVal.Nil" }
            "CapVal.Node(mk_list_comp(st, sp_start, capval_to_expr(st, ${args[0]}), capval_tok_text(${args[1]}), capval_to_expr(st, ${args[2]}), ${filt}))"
        }
        "MkChannel" -> "mk_channel(st, sp_start, ${args[0]}, ${args[1]})"
        "MkExprBlock" -> "mk_expr_block(st, sp_start, CapVal.SNodes(${args[0]}_list))"
        "MkQuoteArm" -> "mk_quote_arm(st, sp_start, ${args[0]}, ${args[1]}, ${args[2]}, ${args[3]})"
        "MkQuoteType" -> "mk_quote_type(st, sp_start, ${args[0]}, ${args[1]})"
        "MkQuote" -> "mk_quote(st, sp_start, ${args[0]}, ${args[1]})"
        "MkSpawn" -> "mk_spawn(st, sp_start, ${args[0]})"
        "MkIsolated" -> "mk_isolated(st, sp_start, ${args[0]})"
        "MkWhenArm" -> "mk_when_arm(st, ${args[0]}, ${args[1]})"
        "MkWhenDefault" -> "mk_when_default(st, ${args[0]})"
        "MkWhen" -> "mk_when(st, sp_start, CapVal.WArms(${args[0]}_list))"
        "MkMatchExpr" -> "mk_match_expr(st, sp_start, ${args[0]}, CapVal.Arms(${args[1]}_list))"
        "MkIfExpr" -> "mk_if_expr(st, sp_start, ${args[0]}, ${args[1]}, ${args[2]})"
        "MkIfLet" -> "mk_if_let(st, ${args[0]}, ${args[1]}, ${args[2]}, ${args[3]}, ${args[4]})"
        // No `sp_start`: `build_if_let_stmt` uses `add_stmt_leaf` (unstamped), matching
        // the hand's `parse_if_let_statement`. Stamping here would record a row the
        // other two paths do not — the SrcPos divergence the While/If note above
        // describes, which `agree_pos` would then catch.
        "MkIfLetStmt" -> "mk_if_let_stmt(st, ${args[0]}, ${args[1]}, ${args[2]}, ${args[3]}, ${args[4]})"
        "MkWhenStmt" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, mk_when(st, sp_start, CapVal.WArms(${args[0]}_list))))))"
        "mk_inrange" -> "CapVal.Node(mk_inrange_expr(st, ${args[0]}, ${args[1]}))"
        // Contextual enum ctor `.Variant`/`.Variant(args)` (Phase 3a-7 slice 4): `v` is
        // the scalar variant IDENT, `a` the repetition args-list accumulator (empty ⇒
        // nullary). sp_start = the `.` byte, spanned like the hand alloc_at.
        "mk_enum_ctor" -> "CapVal.Node(mk_enum_ctor_expr(st, sp_start, ${args[0]}, CapVal.Nodes(${args[1]}_list)))"
        "mk_eqchain" -> "CapVal.Node(mk_eqchain_expr(st, CapVal.Toks(${args[0]}_list), CapVal.Nodes(${args[1]}_list)))"
        "Unary" -> "CapVal.Node(unary_expr(st, ${args[0]}, ${args[1]}))"
        "Grouping" -> "CapVal.Node(st.store.exprs.add_leaf(Expr.Grouping(capval_to_expr(st, ${args[0]}))))"
        "field_suffix" -> "CapVal.Node(st.store.exprs.add_leaf(Expr.FieldAccess(st.missing_node(), capval_tok_text(${args[0]}))))"
        "index_suffix" -> "CapVal.Node(st.store.exprs.add_leaf(Expr.Index(st.missing_node(), capval_to_expr(st, ${args[0]}))))"
        "call_suffix" -> "CapVal.Node(st.store.exprs.add_leaf(Expr.Call(st.missing_node(), ${args[0]}_list)))"
        // ── Statement builds (target: Stmt) ──
        "Break" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.Break))"
        "Continue" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.Continue))"
        "ReturnEmpty" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.ReturnEmpty))"
        "Return" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.Return(capval_to_expr(st, ${args[0]}))))"
        // `return ^( value )?` — the conditional Return/ReturnEmpty core, shared with
        // apply_build's MkReturn arm so interpreter + generated parser stay in lockstep.
        "MkReturn" -> "mk_return_opt(st, ${args[0]})"
        "MkDefer" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.Defer(capval_to_expr(st, ${args[0]}))))"
        "MkErrdefer" -> "CapVal.SNode(st.store.stmts.add_leaf(Stmt.Errdefer(capval_to_expr(st, ${args[0]}))))"
        // A statement-position expression that FAILED (st.had_error set by
        // parse_expression's report/error_node) recovers as a bare Stmt.Error —
        // the twin of the hand parser's `parse_expression()?` yielding .Err (the
        // whole-program loop then synchronises identically via parse_declaration's
        // .Error arm). Without this the static parser wraps the failed expression
        // as Stmt.Expr(Expr.Error), diverging from hand's recovery tree (the 5c
        // gap the recovery-TREE oracle characterises). had_error is per-item fresh
        // (run_static_snode_at_shared builds a clean PState), so an absolute check
        // == "THIS expression failed" — no earlier-error false positive.
        "ExprStmt" -> "if st.had_error { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error)) } else { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, ${args[0]})))) }"
        // ── Pattern builds (target: Pattern) — conditional on optional/list
        //    captures, mirroring executor.apply_build one-to-one. ──
        "OrMaybe" -> "match ${args[1]} { .Nil -> ${args[0]}  _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.Or(capval_to_pat(st, ${args[0]}), capval_to_pat(st, ${args[1]})))) }"
        "IdentPat" -> "match ${args[1]} { .Nil -> CapVal.PNode(ident_pat_bare(st, capval_tok_text(${args[0]})))  _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.TypePattern(capval_tok_text(${args[0]}), capval_tok_text(${args[1]})))) }"
        "MkVariant" -> "if ${args[2]}_list.length > 0 { CapVal.PNode(st.store.pats.add_leaf(Pattern.NestedVariant(capval_tok_text(${args[0]}), ${args[2]}_list))) } else { CapVal.PNode(st.store.pats.add_leaf(Pattern.Variant(capval_tok_text(${args[0]}), param_entries_from_toks(CapVal.Toks(${args[1]}_list), ValueType.Int)))) }"
        "PatBool" -> "CapVal.PNode(pat_bool_node(st, capval_tok_text(${args[0]})))"
        "PatStr" -> "CapVal.PNode(pat_str_node(st, capval_tok_text(${args[0]})))"
        "PatNum" -> "CapVal.PNode(pat_num_node(st, capval_tok_text(${args[0]}), false))"
        "PatNegNum" -> "CapVal.PNode(pat_num_node(st, capval_tok_text(${args[0]}), true))"
        // The optional-match arm surface — SHARED reducer cores (apply_build's twins).
        "OptPresent" -> "CapVal.PNode(st.store.pats.add_leaf(pattern_optional_present(capval_tok_text(${args[0]}))))"
        "OptAbsent" -> "CapVal.PNode(st.store.pats.add_leaf(pattern_optional_absent()))"
        // ── Type-expression builds (target: TypeExpr) — delegate to the SHARED
        //    constructor cores (executor.apply_build's exact twins). args[N]_list
        //    names a rep/list capture; a bare arg is a scalar/opt-scalar CapVal. ──
        "TyUnion" -> "fold_type_union(st, ${args[0]}, ${args[1]}_list)"
        // The name is captured as a repeated `.Toks` (`name:IDENT ( "." name:IDENT )*`,
        // the dotted type path Self.Item / a.b.C), so join it via CapVal.Toks — the
        // emit twin of the executor's `capval_tok_text(env.get("name"))`, which
        // reconstructs the flat dotted name. A single-segment name is a one-element
        // list, joined to itself. (ps3t.6.7 — was `capval_tok_text(name)`, undefined
        // once the dotted star made `name` a list label.)
        "MkNamed" -> "mk_named_type(capval_tok_text(CapVal.Toks(${args[0]}_list)), ${args[1]}_list.length > 0, ${args[1]}_list, capval_present(${args[2]}))"
        "MkQualified" -> "mk_qualified_type(${args[0]}_list, ${args[1]}_list.length > 0, ${args[1]}_list, capval_present(${args[2]}))"
        "TyList" -> "CapVal.TExpr(TypeExpr.ListType(capval_to_texpr(st, ${args[0]})))"
        "TyParen" -> "mk_paren_type(${args[0]}_list)"
        "TyDyn" -> "mk_dyn_type(capval_tok_text(${args[0]}), capval_present(${args[1]}))"
        "MkFn" -> "mk_fn_type(st, capval_present(${args[0]}), ${args[1]}_list, capval_present(${args[2]}), ${args[2]})"
        // ── Control-flow + declaration builds (target: Stmt / component CapVals)
        //    — delegate to the SHARED constructor cores (executor.apply_build's
        //    exact twins). ${args[N]}_list names a rep/list capture; a bare arg
        //    is a scalar or opt-scalar CapVal. ──
        // `0 - 1` (span-free) — the SAME argument the interpreter passes, and the
        // hand's unstamped `alloc_stmt_leaf`. See the `Block` note in build_uses_sp_start.
        "Block" -> "mk_block(st, 0 - 1, ${args[0]}_list)"
        "While" -> "mk_while(st, sp_start, ${args[0]}, ${args[1]})"
        "If" -> "mk_if(st, sp_start, ${args[0]}, ${args[1]}, ${args[2]})"
        "ForLoop" -> "mk_for_loop(st, sp_start, ${args[0]}, ${args[1]}, ${args[2]}, ${args[3]})"
        "MkForBinding" -> "mk_for_binding(${args[0]}, CapVal.Toks(${args[1]}_list))"
        "MkForDestructure" -> "mk_for_destructure(st, sp_start, ${args[0]}, ${args[1]}, ${args[2]})"
        "MkTemplate" -> "CapVal.Node(mk_template(st, ${args[0]}))"
        "MkQualExpr" -> "CapVal.Node(mk_qualified(st, sp_start, ${args[0]}, CapVal.Toks(${args[1]}_list), ${args[2]}, CapVal.FInits(${args[3]}_list)))"
        // ── the `table { … }` literal (t-myz7) ──
        // The header build yields CapVal.Nil (it PUSHES the row/column context the row
        // build reads); only the row and the outer literal mint nodes.
        "MkPrimaryFail" -> "CapVal.Node(mk_primary_fail(st))"
        "MkTableHeader" -> "mk_table_header(st, ${args[0]}, CapVal.Toks(${args[1]}_list))"
        "MkTableRow" -> "CapVal.Node(mk_table_row(st, CapVal.Nodes(${args[0]}_list)))"
        "MkTableLit" -> "CapVal.Node(mk_table_lit(st, sp_start, CapVal.Nodes(${args[0]}_list)))"
        // t-47hc slice 8 — the field-init list arrives as a repetition capture, so it is
        // boxed as CapVal.FInits over the accumulated `_list`, exactly as MkQualExpr's
        // struct-literal half does.
        "MkGrammarBlock" -> "CapVal.Node(mk_grammar_block(st, sp_start, ${args[0]}))"
        "MkStructLit" -> "CapVal.Node(mk_struct_lit(st, sp_start, ${args[0]}, CapVal.FInits(${args[1]}_list)))"
        "MkTaggedTemplate" -> "CapVal.Node(mk_tagged_template(st, sp_start, ${args[0]}, ${args[1]}))"
        "MkMapLit" -> "CapVal.Node(mk_map_lit(st, sp_start, CapVal.Nodes(${args[0]}_list), CapVal.Nodes(${args[1]}_list)))"
        "MkSplice" -> "CapVal.Node(mk_splice(st, sp_start, ${args[0]}))"
        "MkSpliceStruct" -> "CapVal.Node(mk_splice_struct(st, sp_start, ${args[0]}, CapVal.FInits(${args[1]}_list)))"
        // Native `postfix_suffix` steps (t-47hc.33). No `sp_start` arg — the builder
        // reads `st.postfix_sp_start`, so these are deliberately absent from
        // build_uses_sp_start and no `let sp_start = …` is emitted for them.
        "MkTrySuffix" -> "CapVal.Node(mk_try_suffix(st))"
        "MkForceUnwrap" -> "CapVal.Node(mk_force_unwrap(st))"
        "MkCallArg" -> "CapVal.Node(mk_call_arg(st, ${args[0]}))"
        "MkCallSuffix" -> "CapVal.Node(mk_call_suffix(st, CapVal.Nodes(${args[0]}_list)))"
        // The type-arg capture is ALREADY a `List<TypeExpr>` here (same as MkNamed's
        // gen_args), so it passes raw — only the interpreter routes through
        // capval_to_texpr_list.
        "MkGenericCallSuffix" -> "CapVal.Node(mk_generic_call_suffix(st, ${args[0]}_list, CapVal.Nodes(${args[1]}_list)))"
        "MkTupleIndex" -> "CapVal.Node(mk_tuple_index(st, ${args[0]}))"
        "MkIndexSuffix" -> "CapVal.Node(mk_index_suffix(st, ${args[0]}, ${args[1]}))"
        "MkNone" -> "mk_none_cap(st)"
        "MkOptChain" -> "CapVal.Node(mk_opt_chain(st, ${args[0]}))"
        "MkOptMethodCall" -> "CapVal.Node(mk_opt_method_call(st, ${args[0]}, CapVal.Nodes(${args[1]}_list)))"
        "MkTupleIndex" -> "CapVal.Node(mk_tuple_index(st, ${args[0]}))"
        "MkFieldAccess" -> "CapVal.Node(mk_field_access(st, ${args[0]}))"
        "MkEnumCtorSuffix" -> "CapVal.Node(mk_enum_ctor_suffix(st, ${args[0]}, CapVal.Nodes(${args[1]}_list)))"
        "MkCatchSuffix" -> "CapVal.Node(mk_catch_suffix(st, ${args[0]}, ${args[1]}, CapVal.SNodes(${args[2]}_list)))"
        "MkArmReturn" -> "mk_arm_return(st, sp_start, ${args[0]})"
        "MkArm" -> "mk_arm(st, ${args[0]}, ${args[1]}, ${args[2]})"
        "MkMatch" -> "mk_match(st, ${args[0]}, CapVal.Arms(${args[1]}_list))"
        // t-47hc.29 — every table capture is a LIST: the value-column headers (`Toks`),
        // the row patterns (`PNodes`), and the flattened cells (`Nodes`). The builder
        // re-chunks the cells by the header count, so the generated call passes the three
        // accumulators verbatim and shares one implementation with the interpreter.
        "MkMatchTable" -> "mk_match_table(st, ${args[0]}, CapVal.Toks(${args[1]}_list), CapVal.PNodes(${args[2]}_list), CapVal.Nodes(${args[3]}_list))"
        // The EXPRESSION twin (slice 12): same three list captures, plus the `match`-keyword
        // sp_start the hand anchors its span at.
        "MkMatchTableExpr" -> "mk_match_table_expr(st, sp_start, ${args[0]}, CapVal.Toks(${args[1]}_list), CapVal.PNodes(${args[2]}_list), CapVal.Nodes(${args[3]}_list))"
        // t-47hc.17 — `name: value` / shorthand `name`, and the `with { … }` suffix
        // that folds the accumulated list. Unlike the interpreter oracle (span-free),
        // the generated parser threads the real `sp_start`, so each partial `Expr.With`
        // carries the `[with-start, next-token)` span rebind_with reads back.
        "MkFieldInit" -> "mk_field_init(st, ${args[0]}, ${args[1]})"
        "MkWithSuffix" -> "CapVal.Node(mk_with_suffix(st, sp_start, CapVal.FInits(${args[0]}_list)))"
        // The GENERIC decl forms are distinguished by ARITY, not by name — same build
        // name, one extra type-param list. These arms must come FIRST: emit dispatches
        // on the name alone, so without them a 3-arg `MkEnumDecl` in a grammar renders
        // the 2-arg call and passes the type-param list where the variants go. That
        // asymmetry is why the executor's generic arms were dormant capability with no
        // emit twin (t-47hc slice 10, t-myz7); both now call one shared core.
        "MkFnDecl" if args.length == 5 -> "mk_fn_decl_g(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}_list, ${args[3]}, capval_present(${args[3]}), ${args[4]}_list)"
        "MkTypeDeclAny" -> "mk_type_decl_any(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}_list, ${args[3]}, capval_present(${args[3]}), ${args[4]}, capval_present(${args[4]}), ${args[5]}_list)"
        "MkTypeDecl" if args.length == 3 -> "mk_type_decl_g(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}_list)"
        "MkEnumDecl" if args.length == 3 -> "mk_enum_decl_g(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}_list)"
        "MkTypeParam" -> "mk_type_param(capval_tok_text(${args[0]}), ${args[1]}, capval_present(${args[1]}))"
        "MkExtern" -> "mk_extern_fn(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}, capval_present(${args[2]}))"
        "MkShapeDecl" -> "mk_shape_decl(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkExport" -> "mk_export_decl(st, ${args[0]})"
        "MkStampAt" -> "mk_stamp_stmt_at(st, sp_start, ${args[0]})"
        // ── The prefix WRAPPERS (t-47hc Phase 4). The doc lines are a repeated
        // TERMINAL label (List<Token>), the annotations a repeated RULE label whose
        // accumulator is typed by kind "ann" (List<Annotation>), and the args an
        // external EXPR-rule list — all passed to the shared cores verbatim, so the
        // generated call and the interpreter drive ONE implementation. ──
        "MkDocAnnotated" -> "mk_doc_annotated(st, ${args[0]}_list, ${args[1]})"
        "MkModuleDoc" -> "mk_module_doc(st, sp_start, ${args[0]}_list)"
        // ── The binding declarations (t-47hc Phase 4): `let`/`mut`/`const`. The
        // optional `mut` modifier, type annotation, and `else` guard group all
        // arrive as presence-tested CapVals; the `@gensym(letelse)` mint rides the
        // guard group as an ordinary captured token. Both engines drive the ONE
        // shared core (mk_let_binding_g / mk_const_binding_g). ──
        "MkLetBinding" -> "mk_let_binding_g(st, capval_present(${args[0]}), capval_tok_text(${args[1]}), ${args[2]}, capval_present(${args[2]}), ${args[3]}, ${args[4]}, capval_present(${args[4]}), ${args[5]})"
        "MkMutBinding" -> "mk_let_binding_g(st, true, capval_tok_text(${args[0]}), ${args[1]}, capval_present(${args[1]}), ${args[2]}, ${args[3]}, capval_present(${args[3]}), ${args[4]})"
        "MkConstBinding" -> "mk_const_binding_g(st, capval_tok_text(${args[0]}), ${args[1]}, capval_present(${args[1]}), ${args[2]})"
        "MkDestructure" -> "mk_let_destructure_g(st, ${args[0]}_list, ${args[1]})"
        "MkParallel" -> "mk_parallel_g(st, ${args[0]}_list)"
        "MkSelect" -> "mk_select_g(st, CapVal.SArms(${args[0]}_list))"
        "MkSelectArm" -> "mk_select_arm_g(st, capval_tok_text(${args[0]}), ${args[1]}, ${args[2]}_list)"
        "MkSpecBlock" -> "mk_spec_block_g(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkGivenBlock" -> "mk_given_block_g(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkThenBlock" -> "mk_then_block_g(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkCompConfig" -> "mk_comp_config_g(st, capval_tok_text(${args[0]}), ${args[1]}, ${args[2]}, capval_present(${args[2]}))"
        "MkCompConfigPair" -> "mk_comp_config_pair_g(st, capval_tok_text(${args[0]}), capval_to_expr(st, ${args[1]}))"
        "MkComponentBlock" -> "mk_component_block_g(st, capval_tok_text(${args[0]}), capval_tok_text(${args[1]}), ${args[2]}_list, ${args[3]}_list)"
        "MkRawComponentBlock" -> "mk_raw_component_block_g(st, capval_tok_text(${args[0]}), capval_tok_text(${args[1]}), capval_tok_text(${args[2]}))"
        "MkMethodShorthand" -> "mk_method_shorthand_g(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkChildrenSlot" -> "mk_children_slot_g(st, capval_tok_text(${args[0]}), ${args[1]})"
        "MkCompField" -> "mk_comp_field_g(st, capval_tok_text(${args[0]}), ${args[1]}, ${args[2]}, capval_present(${args[2]}))"
        "MkComponentDef" -> "mk_component_def_g(st, capval_tok_text(${args[0]}), capval_tok_texts(CapVal.Toks(${args[1]}_list)), CapVal.CCfgs(${args[2]}_list), CapVal.CSlots(${args[3]}_list), capval_tok_text(${args[4]}), capval_present(${args[4]}), ${args[5]}_list)"
        "MkAnn" -> "mk_ann_g(capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkAnnotatedArgs" -> "mk_annotated_args_g(st, ${args[0]}_list, ${args[1]})"
        "MkFnDecl" -> "mk_fn_decl(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}, capval_present(${args[2]}), ${args[3]}_list)"
        "MkTypeDecl" -> "mk_type_decl(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkEnumDecl" -> "mk_enum_decl(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkTraitDecl" -> "mk_trait_decl(st, capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkImpl" -> "mk_impl(st, capval_tok_text(${args[0]}), ${args[1]}, capval_present(${args[1]}), ${args[2]}_list)"
        "MkUse" -> "mk_use(st, capval_present(${args[0]}), ${args[1]}_list, ${args[2]}_list)"
        "MkUseBare" -> "mk_use(st, false, ${args[0]}_list, ${args[1]}_list)"
        "MkUsePkg" -> "mk_use_pkg(st, capval_tok_list(${args[0]}), ${args[1]}_list, ${args[2]}_list)"
        "MkModule" -> "mk_module(st, capval_tok_text(${args[0]}))"
        "MkField" -> "mk_field(st, capval_tok_text(${args[0]}), ${args[1]})"
        "MkEVariant" -> "mk_evariant(capval_tok_text(${args[0]}), ${args[1]}_list)"
        "MkParam" -> "mk_param(st, capval_tok_text(${args[0]}), ${args[1]}, capval_present(${args[1]}))"
        "MkAssocType" -> "mk_assoc_type(st, capval_tok_text(${args[0]}))"
        "MkAssocTypeDef" -> "mk_assoc_type_def(st, capval_tok_text(${args[0]}), ${args[1]})"
        "MkTraitMethod" -> "mk_trait_method(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}, capval_present(${args[2]}), capval_present(${args[3]}), ${args[4]}_list)"
        "MkMethod" -> "mk_method(st, capval_tok_text(${args[0]}), ${args[1]}_list, ${args[2]}, capval_present(${args[2]}), ${args[3]}_list)"
        _ -> "CapVal.Node(st.error_node(\"unknown build `${name}`\"))"
    }
}

fn arg3(args: List<string>) -> string { "${args[0]}, ${args[1]}, ${args[2]}" }
fn arg2(args: List<string>) -> string { "${args[0]}, ${args[1]}" }

fn build_fn(name: string) -> string {
    if name == "fold_binary" { return "fold_binary_expr" }
    if name == "fold_logical" { return "fold_logical_expr" }
    if name == "fold_nullish" { return "fold_nullish_expr" }
    if name == "fold_postfix" { return "fold_postfix_expr" }
    if name == "Unary" { return "unary_expr" }
    name
}

// ── @hand → the run_hand* family (executor.exec_primary's Hand dispatch) ──

fn emit_hand_result(hf: string) -> string {
    if is_hand_stmt_leaf(hf) { return "CapVal.SNode(run_hand_stmt(\"${hf}\", st))" }
    if is_hand_expr_leaf(hf) { return "CapVal.Node(run_hand_expr(\"${hf}\", st))" }
    "CapVal.Node(run_hand(\"${hf}\", st))"
}

// The rule classes come straight from the shared hand-leaf table
// (hand_leaves.av), the same one the executor dispatches through — so the
// emitted parser and the interpreter cannot disagree about which class a leaf
// belongs to. These were hand-maintained copies of executor.av's predicates,
// kept in sync by a comment; adding a leaf now touches ONE table (rule 8).

// ── FIRST-set guards (branch selection + repetition guards) ──
//
// A guard is a boolean over `st.cur()`: a literal tests `.text`, a named
// terminal `.kind`. A ref crosses into the referenced rule (cycle-guarded);
// a group unions its branches. Nullable leading items (Opt/Star) are crossed
// so a guard spans them (executor.tok_starts_seq).

// ── ps3t.6.7 perf: Tk-enum terminal dispatch ──
//
// A literal terminal (`"+"`, `"|>"`) was matched by string-comparing the token
// `text` (`st.cur().text == "|>"`) — an avra_streq PER descent level, the #1
// cost of the generated parser (~+17M Ir vs the hand parser). The real lexer
// already tags every token with its `Tk` enum kind, and for OPERATOR /
// PUNCTUATION lexemes that tag is 1:1 with the text (a `|>` is ALWAYS
// `Tk.PipeGt`, and nothing else is), so `text == "|>"` ⟺ `tk == Tk.PipeGt` —
// an int compare that is byte-identical in behaviour but drops the streq.
//
// KEYWORDS are deliberately EXCLUDED: a keyword lexeme could (contextually) lex
// as an identifier, so `text == "is"` is NOT guaranteed equivalent to
// `tk == Tk.KwIs`; those fall back to the string compare (`tk_variant_for`
// returns "" → the caller emits the `.text` form). This keeps the fast path
// provably safe while covering the hot operator guards.
fn tk_variant_for(text: string) -> string {
    // punctuation
    if text == "(" { return "LeftParen" }
    if text == ")" { return "RightParen" }
    if text == "{" { return "LeftBrace" }
    if text == "}" { return "RightBrace" }
    if text == "[" { return "LeftBracket" }
    if text == "]" { return "RightBracket" }
    if text == "," { return "Comma" }
    if text == "." { return "Dot" }
    if text == ".." { return "DotDot" }
    if text == ":" { return "Colon" }
    if text == "->" { return "Arrow" }
    if text == "<-" { return "LeftArrow" }
    if text == "@" { return "At" }
    if text == "~" { return "Tilde" }
    if text == "?" { return "Question" }
    if text == "?." { return "QuestionDot" }
    if text == "??" { return "QuestionQuestion" }
    // operators
    if text == "+" { return "Plus" }
    if text == "-" { return "Minus" }
    if text == "*" { return "Star" }
    if text == "/" { return "Slash" }
    if text == "%" { return "Percent" }
    if text == "=" { return "Equal" }
    if text == "==" { return "EqualEqual" }
    if text == "!" { return "Bang" }
    if text == "!=" { return "BangEqual" }
    if text == "<" { return "Less" }
    if text == "<=" { return "LessEqual" }
    if text == ">" { return "Greater" }
    if text == ">=" { return "GreaterEqual" }
    if text == "&" { return "Amp" }
    if text == "&&" { return "AmpAmp" }
    if text == "|" { return "Pipe" }
    if text == "||" { return "PipePipe" }
    if text == "|>" { return "PipeGt" }
    if text == "^" { return "Caret" }
    if text == "<<" { return "Shl" }
    if text == ">>" { return "Shr" }
    ""
}

/// Emit a single-terminal FIRST guard over `st.cur()`. Operator/punctuation
/// terminals dispatch on the `Tk` enum (fast int compare, byte-identical);
/// keywords and everything else keep the `.text` string compare.
fn tk_guard(text: string) -> string {
    let v = tk_variant_for(text)
    if v == "" { return "st.cur().text == \"${text}\"" }
    "st.cur().tk == Tk.${v}"
}

/// Emit a NAMED-terminal guard (IDENT / NUMBER / STRING / BOOL / TEMPLATE / …)
/// as a `Tk`-enum compare instead of the `.kind` string compare — t-47hc.4.1.9,
/// the perf payoff for the whole expr-leaf migration's accumulated FIRST guards.
/// BYTE-IDENTICAL by construction: each returned disjunction matches EXACTLY the
/// `Tk` set `tk_to_grammar_kind` (real_lex.av) folds into that kind string, so a
/// token selects the same branch either way. NUMBER (Number|Float) and BOOL
/// (KwTrue|KwFalse) are the two many-to-one kinds → parenthesised disjunctions
/// (safe when inlined into a larger `||` FIRST chain). Any kind outside the known
/// vocabulary keeps the `.kind` string compare (defensive; the set is closed).
fn named_tk_guard(tok: string) -> string {
    if tok == "IDENT"    { return "st.cur().tk == Tk.Identifier" }
    // The one terminal that is NOT a `tk_to_grammar_kind` kind string: the field-name
    // set `consume_field_name` accepts. Spelled inline as the Tk disjunction rather
    // than as a call to `tk_is_field_name` because the generated file's import header
    // (gen_expr_file.av) is fixed and a guard is emitted into FIRST chains where a
    // bare comparison composes; the executor's `named_tok_matches` reads the shared
    // predicate, and reserved_kw_field_test asserts the two stay the same set.
    if tok == "FIELDNAME" { return "(st.cur().tk == Tk.Identifier || st.cur().tk == Tk.KwReserved)" }
    if tok == "NUMBER"   { return "(st.cur().tk == Tk.Number || st.cur().tk == Tk.Float)" }
    if tok == "STRING"   { return "st.cur().tk == Tk.String" }
    if tok == "BOOL"     { return "(st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse)" }
    if tok == "TEMPLATE" { return "st.cur().tk == Tk.Template" }
    if tok == "EOF"      { return "st.cur().tk == Tk.Eof" }
    if tok == "DOC"      { return "st.cur().tk == Tk.DocComment" }
    if tok == "MODDOC"   { return "st.cur().tk == Tk.ModDocComment" }
    if tok == "ERROR"    { return "st.cur().tk == Tk.Error" }
    "st.cur().kind == \"${tok}\""
}

fn prim_first_guard(g: Grammar, prim: GPrim, visited: List<string>) -> string {
    match prim {
        .Lit(t) -> tk_guard(t)
        .Named(tok) -> named_tk_guard(tok)
        .Hand(hf) -> hand_first_guard(hf)
        .Group(inner) -> node_first_guard(g, inner, visited)
        .Ref(name) -> rule_first_guard(g, name, visited)
        // A zero-width `@when` predicate: its guard is the mode conjunct. Reached
        // only if a predicate is used outside a leading position (seq_first_guard
        // folds leading ones); here it stands alone as its own gate.
        .Pred(flag) -> pred_guard(flag)
        // `@peek` is the same shape — its guard is the lookahead conjunct (peek_guard).
        .Peek(cond) -> peek_guard(cond)
        // `@gensym` gates nothing: it binds. Reached only from a NON-leading position
        // (seq_first_guard skips leading ones), where the identity conjunct is what
        // "this contributes no condition" means.
        .Gensym(_) -> "true"
        // `@rawbrace` accepts any current token (an immediate `}` is a legal empty
        // body), so its guard is the identity conjunct too — and like the executor's
        // tok_starts arm, it is never a branch head in practice.
        .RawBrace(_) -> "true"
    }
}

/// Mirrors executor.hand_starts as a guard expression.
fn hand_first_guard(hf: string) -> string {
    if hf == "ident" { return named_tk_guard("IDENT") }
    if hf == "number" { return named_tk_guard("NUMBER") }
    if hf == "component_decl" { return "st.cur().text == \"component\"" }
    if hf == "let_stmt" { return "st.cur().text == \"let\"" }
    if hf == "return_stmt" { return "st.cur().text == \"return\"" }
    if hf == "match_table" { return "st.cur().text == \"match\"" }
    if hf == "quote_expr" { return "st.cur().text == \"quote\"" }
    // Keyword-led expression primaries (Phase 3a-11) — byte-side twins of the
    // executor hand_starts FIRST guards (kept in lockstep).
    if hf == "match_expr" { return "st.cur().text == \"match\"" }
    if hf == "if_expr" { return "st.cur().text == \"if\"" }
    // Clean-FIRST bracket/qualified primaries — byte-side twins (Tk compares, 1:1
    // with the punctuation text) of the executor hand_starts FIRST guards.
    if hf == "list_expr" { return tk_guard("[") }
    if hf == "paren_expr" { return tk_guard("(") }
    if hf == "ident_primary" { return named_tk_guard("IDENT") }
    if hf == "ident_expr" { return "${named_tk_guard("IDENT")} || ${tk_guard("@")}" }
    if hf == "more_primary" { return "${tk_guard(".")} || ${tk_guard("[")}" }
    // The leaf's FIRST is the shared exported predicate (executor's
    // tok_starts_expr_leaf) — the emitted static parser calls it directly, so
    // the FIRST-set has ONE source of truth across both consumers (rule 8).
    if hf == "hand_unary" { return "tok_starts_expr_leaf(st.cur())" }
    // The `with`-base leaf shares that same FIRST (parse_unary_leaf); a `with { … }`
    // postfix step's FIRST is the `with` keyword (a keyword — text compare, like `not`).
    if hf == "call_leaf" { return "tok_starts_expr_leaf(st.cur())" }
    // Phase 3a: the primary base shares the leaf FIRST (parse_primary_base); a
    // postfix suffix's FIRST is the postfix-op set (Tk-dispatched, a SUPERSET of
    // postfix_step's precise guard — the no-progress break exits when a step
    // consumes nothing). Mirrors executor.hand_starts("postfix_suffix").
    if hf == "primary_base" { return "tok_starts_expr_leaf(st.cur())" }
    if hf == "postfix_suffix" { return "${tk_guard(".")} || ${tk_guard("(")} || ${tk_guard("[")} || ${tk_guard("!")} || ${tk_guard("?")} || ${tk_guard("?.")} || ${tk_guard("<")} || ${tk_guard("catch")}" }
    // The lambda body's FIRST is the same leaf FIRST (`{` block ∪ FIRST(expression)) —
    // byte-side twin of executor.hand_starts("lambda_body"). t-47hc paren flip prep,
    // DORMANT (no live grammar references @hand(lambda_body), so unemitted today).
    if hf == "lambda_body" { return "tok_starts_expr_leaf(st.cur())" }
    if hf == "lambda_block_body" { return tk_guard("{") }
    // ps3t.6.7 Phase 2 — the whole-statement / whole-declaration dispatch FIRST
    // sets, mirroring executor.hand_starts("stmt_hand" / "decl_hand") exactly so
    // the generated static parser routes to run_hand_stmt on the same tokens the
    // interpreter flip does (byte-identical dispatch).
    if hf == "stmt_hand" {
        return "st.cur().text == \"{\" || st.cur().text == \"if\" || st.cur().text == \"while\" || st.cur().text == \"return\""
    }
    if hf == "decl_hand" {
        return "st.cur().kind == \"IDENT\" || st.cur().kind == \"DOC\" || st.cur().kind == \"MODDOC\" || st.cur().text == \"@\" || st.cur().text == \"export\" || st.cur().text == \"fn\" || st.cur().text == \"type\" || st.cur().text == \"enum\" || st.cur().text == \"trait\" || st.cur().text == \"impl\" || st.cur().text == \"use\" || st.cur().text == \"mod\" || st.cur().text == \"const\" || st.cur().text == \"let\" || st.cur().text == \"mut\" || st.cur().text == \"extern\" || st.cur().text == \"shape\" || st.cur().text == \"spec\" || st.cur().text == \"parallel\" || st.cur().text == \"select\" || st.cur().text == \"component\""
    }
    "false"
}

fn node_first_guard(g: Grammar, node: GNode, visited: List<string>) -> string {
    match node {
        .Alt(branches) -> {
            mut parts: List<string> = []
            for b in branches {
                parts.push(seq_first_guard(g, b, visited))
            }
            guard_join_dedup(parts)
        }
    }
}

/// The emitted guard for a `@when(flag)` mode predicate — the byte-side twin of
/// executor.modes_flag (kept in lockstep; the differential test catches drift).
/// `cell_mode` is a real bool; the `allow_*` flags are int-as-bool.
fn pred_guard(flag: string) -> string {
    if flag == "cell_mode" { return "st.modes.cell_mode" }
    // `at_quote_top` = NOT inside a quote body — quote_depth is a COUNTER (not an
    // int-as-bool), so it needs its own guard (== 0), the byte-side twin of
    // executor.modes_flag's at_quote_top case. Gates the grammar-owned `~` bitnot.
    if flag == "at_quote_top" { return "st.modes.quote_depth == 0" }
    // The complement — see executor.modes_flag's in_quote_body case. Gates the splice
    // reading of `~`, which is what the `primary_base` leaf still owns.
    if flag == "in_quote_body" { return "st.modes.quote_depth > 0" }
    // A POSTFIX-BASE predicate is not a mode field at all — emit a call to the SAME
    // executor.base_pred the interpreter uses, exactly as peek_guard does for @peek, so
    // the two engines share one definition instead of two spellings of it.
    if is_base_pred(flag) { return "base_pred(\"${flag}\", st)" }
    "st.modes.${flag} != 0"
}

/// The `@peek(cond)` guard expression — the emit twin of pred_guard, but a LOOKAHEAD
/// conjunct. Emits a call to the SAME executor.lookahead_ok the interpreter's
/// branch_pred_ok uses, so the generated parser and interpreter can never disagree on a
/// cond's meaning (the discipline modes_flag gives @when, applied to the token side).
fn peek_guard(cond: string) -> string {
    "lookahead_ok(\"${cond}\", st)"
}

/// AND-join predicate guards (`a && b`), dropping empties.
fn and_join(parts: List<string>) -> string {
    mut out = ""
    mut i = 0
    for p in parts {
        if p == "" { continue }
        if i > 0 { out = out + " && " }
        out = out + p
        i = i + 1
    }
    out
}

/// Combine a branch's `@when` predicate conjuncts (AND) with its FIRST-token
/// disjunction (OR) — `pred && (first || …)` — matching the executor's
/// `branch_pred_ok(b, st) && tok_starts_seq(...)`.
fn combine_pred_guard(preds: List<string>, parts: List<string>) -> string {
    let first = guard_join_dedup(parts)
    if preds.length == 0 { return first }
    // A predicate-only branch (no consuming item) NEVER matches via FIRST —
    // mirror the executor's tok_starts_seq, which skips the Pred and returns
    // false. Returning the mode read alone would emit an always-true guard and,
    // wrapped in a repeat, spin forever (`while st.modes.x { }`). Such a branch
    // is rejected at parse time anyway (parse_seq); this stays as defense.
    if parts.length == 0 { return "false" }
    let p = and_join(preds)
    "${p} && (${first})"
}

fn seq_first_guard(g: Grammar, seq: GSeq, visited: List<string>) -> string {
    mut preds: List<string> = []
    mut parts: List<string> = []
    for item in seq.items {
        match item.prim {
            // A `@when` predicate is a zero-width AND-conjunct on the branch: it
            // contributes no FIRST token and never stops the scan.
            .Pred(flag) -> preds.push(pred_guard(flag))
            // `@peek` is the same zero-width AND-conjunct, via the lookahead guard.
            .Peek(cond) -> preds.push(peek_guard(cond))
            // `@gensym` is zero-width with NO conjunct at all — skipped entirely, so the
            // scan continues to the item that actually starts the branch. The executor's
            // tok_starts_seq skips it by the same rule (prim_is_pred); if these two ever
            // disagree, one engine dispatches to a branch the other does not.
            .Gensym(_) -> {}
            _ -> {
                // t-myz7 GATE: a `@gate`d item's FIRST is NOT part of the dispatch
                // condition — the preceding `@peek` cond REPLACES it. Returning the
                // preds alone is what lets a loop enter on a token the element's FIRST
                // rejects (EOF for `fn f(`), which is the whole point: the hand's
                // `while !check(CLOSER)` enters there and reports about the ELEMENT.
                // Checked BEFORE parts.push so the FIRST never joins the guard.
                if item.gate { return and_join(preds) }
                // `^` is part of the DISPATCH condition, not just of the item's own
                // match (t-47hc.33). A branch led by a same-line item cannot start on a
                // token that sits on the next line, so folding the gate in here is what
                // makes the branch fall through to its siblings instead of being entered
                // and then failing mid-sequence. Byte-identical for every grammar today:
                // same_line_wrap returns the guard unchanged for an unmarked item, and
                // the only `^` in a production grammar (`return ^( e:expression )?`) sits
                // AFTER a mandatory item, so this scan has already returned.
                parts.push(same_line_wrap(item, prim_first_guard(g, item.prim, visited)))
                match item.rep {
                    .One -> return combine_pred_guard(preds, parts)
                    .Plus -> return combine_pred_guard(preds, parts)
                    _ -> {}
                }
            }
        }
    }
    combine_pred_guard(preds, parts)
}

fn rule_first_guard(g: Grammar, name: string, visited: List<string>) -> string {
    if str_in(visited, name) { return "false" }
    mut v2: List<string> = []
    for x in visited { v2.push(x) }
    v2.push(name)
    let r = emit_lookup_rule(g, name)
    if r.name == "" {
        // Dispatch-only production grammars intentionally leave `expression`
        // external so the checked-in declaration parser calls the separately
        // generated expression parser. Its FIRST set is nevertheless required
        // when that reference is optional/repeated (for example the same-line
        // optional operand of native `return`). Keep this on the shared leaf
        // predicate used by the expression dispatch itself.
        if name == "expression" { return "tok_starts_expr_leaf(st.cur())" }
        if name == "pattern_or" { return "tok_starts_pattern(st.cur())" }
        // The shared match-ARM fragment (features/match_expr/grammar.av) is DEFINED in the
        // declaration dispatch view and referenced from the expression view's `match_expr`.
        // Both generated parsers live in the `parse/` module namespace, which MERGES — so
        // the expression parser calls the declaration parser's parse_match_arm directly,
        // exactly as it already calls parse_pattern_or. Defining the rules in both views
        // instead would emit two `parse_match_when_arm` functions into one namespace and
        // fail the build with a duplicate-function FATAL. What crossing that boundary needs
        // is a DECLARED FIRST, which is what these two lines are (t-47hc.25).
        if name == "match_arm" { return "tok_starts_pattern(st.cur())" }
        if name == "match_when_arm" { return "(st.cur().text == \"_\" || tok_starts_expr_leaf(st.cur()))" }
        // t-47hc.29, the match-table flip, crossing the boundary the other way: `table_cell`
        // is DEFINED in the expression view (it is hand `parse_primary`, whose alternatives
        // are all local there) and CALLED from `match_table_stmt` in the declaration view.
        // Its FIRST is parse_primary's own — the shared expression-leaf predicate. `pattern`
        // is the row-pattern reference from the same rule, and is the pattern family's
        // predicate, exactly as `pattern_or` above.
        if name == "table_cell" { return "tok_starts_expr_leaf(st.cur())" }
        // t-47hc slice 10.9 — routing the decl keywords makes `field`\'s `ftype:type_expr`
        // reachable from the declaration view, where the TYPE family is deliberately not
        // composed (dispatch-only) so the generated declaration parser calls the
        // separately generated type parser. Same crossing as `expression` above, same fix.
        if name == "type_expr" { return "tok_starts_type(st.cur())" }
        // `match_table_expr` is DEFINED in the declaration view (beside match_table_stmt, so
        // the `{#cols}` stays in a string fragment) and CALLED from the expression view's
        // `match_expr` — the same crossing match_arm makes, so it needs a declared FIRST.
        if name == "match_table_expr" { return "(st.cur().text == \"match\")" }
        if name == "pattern" { return "tok_starts_pattern(st.cur())" }
        // t-47hc slice 10.13 — routing `fn` / `extern` / `trait` / `impl` makes their
        // parameter lists reachable from the declaration view, and `param` is defined in
        // the EXPRESSION view (it is paren_expr's typed-lambda parameter, shared rather
        // than duplicated). Same crossing as `expression` and `type_expr` above. Its FIRST
        // is a bare IDENT: `param = pname:IDENT ( ":" pt:type_expr )?`.
        // Delegated to `named_tk_guard` rather than spelled inline: that is the ONE place
        // mapping the `IDENT` terminal to `Tk.Identifier`, and the neighbouring declared
        // FIRSTs all route through a shared predicate too. Output is byte-identical.
        if name == "param" { return named_tk_guard("IDENT") }
        // t-47hc Phase 4 — routing the `@annotation` wrapper makes its arg list
        // reachable from the declaration view, and `call_arg` is defined in the
        // EXPRESSION view (it is the call-suffix argument, shared rather than
        // duplicated). Its FIRST is `expression`'s own leaf predicate — a call_arg is
        // `@on(allow_dot_postfix) e:expression`.
        if name == "call_arg" { return "tok_starts_expr_leaf(st.cur())" }
        // Any OTHER external rule has no declared FIRST, and falling back to `false`
        // here is SILENT and destructive: `( r )*` emits `while false` and never loops,
        // `( r )?` is never taken, and the generated parser DROPS the whole construct
        // while still compiling and reporting no error. (Caught red-handed adding
        // subjectless `match { … }`: `when_arm` is an expression-family rule, so the
        // statement dispatch emitted `while false { a_list.push(…) }` — every arm
        // dropped, `bs2 check` still said `ok`, and the match feature suite stayed
        // green because nothing covered that form.)
        //
        // Emit an UNDEFINED call instead, so regen -> build fails loudly and names the
        // rule. No production grammar reaches this today (no generated parser contains
        // a `false` guard), so every checked-in parser regenerates byte-identically —
        // this only fires the moment someone adds a cross-family reference and forgets
        // to declare its FIRST above.
        return "avra_grammar_external_first_undeclared_${name}(st.cur())"
    }
    node_first_guard(g, r.body, v2)
}

/// Join FIRST-set guard fragments with `||`, dropping `false`/empty and
/// de-duplicating (a deep expression FIRST re-collects the same terminals).
fn guard_join_dedup(parts: List<string>) -> string {
    mut seen: List<string> = []
    for p in parts {
        if p != "false" && p != "" && !str_in(seen, p) { seen.push(p) }
    }
    if seen.length == 0 { return "false" }
    mut out = ""
    mut i = 0
    for p in seen {
        if i > 0 { out = out + " || " }
        out = out + p
        i = i + 1
    }
    out
}

// ── Small structural helpers ──

/// Every label captured under a repetition (`*`/`+`) anywhere in the sequence
/// — these become list accumulators (`<label>_list`), shared across the branch
/// so a scalar-then-repeated label (`a:expr ( "," a:expr )*`) collects into one.
export fn list_labels_of(seq: GSeq) -> List<string> {
    mut out: List<string> = []
    for item in seq.items {
        let multi = rep_is_star(item.rep) || rep_is_plus(item.rep)
        if item.label != "" && multi && !str_in(out, item.label) { out.push(item.label) }
        for l in prim_labels_of(item.prim, multi) {
            if !str_in(out, l) { out.push(l) }
        }
    }
    out
}

fn prim_labels_of(prim: GPrim, under_multi: bool) -> List<string> {
    match prim {
        .Group(inner) -> node_labels_of(inner, under_multi)
        _ -> []
    }
}

fn node_labels_of(node: GNode, under_multi: bool) -> List<string> {
    match node {
        .Alt(branches) -> {
            mut out: List<string> = []
            for b in branches {
                for item in b.items {
                    let multi = under_multi || rep_is_star(item.rep) || rep_is_plus(item.rep)
                    if item.label != "" && multi && !str_in(out, item.label) { out.push(item.label) }
                    for l in prim_labels_of(item.prim, multi) {
                        if !str_in(out, l) { out.push(l) }
                    }
                }
            }
            out
        }
    }
}

fn emit_ref_call(prim: GPrim) -> string {
    match prim {
        .Ref(name) -> "parse_${name}(st)"
        _ -> "st.error_node(\"expected a nonterminal\")"
    }
}

fn group_inner_seq(prim: GPrim) -> GSeq {
    match prim {
        .Group(inner) -> match inner {
            .Alt(branches) -> {
                if branches.length == 0 { return empty_seq() }
                branches[0]
            }
        }
        _ -> empty_seq()
    }
}

fn empty_seq() -> GSeq { GSeq { items: [], build: GBuild.None, annots: [], speculative: false, fallback: false } }

/// A primary whose match yields a Token (a terminal or an all-terminal group)
/// vs a node (a ref / hand rule).
fn prim_yields_token(prim: GPrim) -> bool {
    match prim {
        .Lit(_) -> true
        .Named(_) -> true
        .Group(inner) -> node_all_terminal(inner)
        _ -> false
    }
}

/// True only for the TERMINAL-ALTERNATION shape `("!" | "-")` — every branch is
/// exactly ONE plain One-rep terminal, which emit_one_terminal renders as a single
/// FIRST-disjunction token consume. A branch carrying MORE than one item, a
/// repetition, or a marker is a STRUCTURAL group: rendering it as one token would
/// silently DROP everything after the first item (the executor, which runs the whole
/// inner sequence via exec_node, would then disagree with the generated parser). Those
/// take the inlined emit_node_items path instead. An empty alternation is not a
/// terminal group either — there is no token to consume.
fn node_all_terminal(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            if branches.length == 0 { return false }
            for b in branches {
                if b.items.length != 1 { return false }
                let item = b.items[0]
                if !prim_is_terminal(item.prim) { return false }
                if !rep_is_one(item.rep) { return false }
                if item.cut || item.require || item.sameline || item.mode_off != "" || item.mode_on != "" || item.mode_bump != "" { return false }
            }
            true
        }
    }
}

fn prim_is_terminal(prim: GPrim) -> bool {
    match prim {
        .Lit(_) -> true
        .Named(_) -> true
        _ -> false
    }
}

fn prim_lit_text(prim: GPrim) -> string {
    match prim {
        .Lit(t) -> t
        .Named(tok) -> tok
        _ -> ""
    }
}

/// A single terminal's guard (no rule crossing) — a literal on `.text`, a
/// named terminal on the `Tk` enum (t-47hc.4.1.9).
fn term_guard(prim: GPrim) -> string {
    match prim {
        .Lit(t) -> tk_guard(t)
        .Named(tok) -> named_tk_guard(tok)
        _ -> "false"
    }
}

fn prim_is_ref(prim: GPrim) -> bool {
    match prim { .Ref(_) -> true  _ -> false }
}

fn prim_is_group(prim: GPrim) -> bool {
    match prim { .Group(_) -> true  _ -> false }
}

fn prim_is_hand(prim: GPrim) -> bool {
    match prim { .Hand(_) -> true  _ -> false }
}

fn hand_name(prim: GPrim) -> string {
    match prim { .Hand(hf) -> hf  _ -> "" }
}

/// Does rule `name` SELF-VALIDATE — i.e. when invoked on a token OUTSIDE its FIRST
/// set, does it set `had_error` (rather than blindly consuming into a bogus node)?
/// This decides whether the LAST bare-ref branch of a dispatch may be the UNGUARDED
/// catch-all tail: a self-validating rule can (unary's `| postfix`, statement's
/// `| expr_stmt` — the delegate recovers), a non-self-validating one must be
/// FIRST-guarded with the no-match error node instead (type_atom's `| named_type`:
/// unguarded it would swallow `,`/`?`/`=` into a bogus TypeExpr.Named WITHOUT
/// had_error, so the caller's hand fallback never fires and recovery diverges from
/// the interpreter, which FIRST-guards EVERY branch — the type recovery-oracle catch).
///
/// The cases, mirroring what emit_dispatch itself produces:
///  - EXTERNAL ref (not a rule in THIS grammar, e.g. expr_stmt's `expression` →
///    the separately-generated parse_expression): self-validates (that generated
///    delegate reports its own errors). Returned as TRUE so the emit keeps the ref an
///    unguarded tail — guarding it would emit `if <FIRST=false> { … }`, dead code.
///  - MULTI-BRANCH dispatch: ALWAYS self-validates — emit_dispatch gives it either an
///    error-node tail or a self-validating catch-all, so an unmatched token sets
///    had_error either way.
///  - SINGLE sequence: self-validates iff its LEADING primary does — `@hand` (the
///    delegate reports) or another self-validating rule; a leading TERMINAL does not
///    (linear sequences emit the first terminal UNGUARDED, assuming the caller's
///    dispatch guaranteed it — false for an unguarded fallthrough).
fn rule_self_validates(g: Grammar, name: string, visited: List<string>) -> bool { rule_owns_recovery(g, name, visited) }







/// The capture-coercion fn for a node kind (`capval_to_expr` / `_pat` / …).
fn kind_coerce(kind: string) -> string {
    if kind == "pat" { return "capval_to_pat" }
    if kind == "stmt" { return "capval_to_stmt" }
    if kind == "type" { return "capval_to_texpr" }
    if kind == "pentry" { return "capval_to_pentry" }
    if kind == "tparam" { return "capval_to_tparam" }
    if kind == "field" { return "capval_to_field" }
    if kind == "variant" { return "capval_to_variant" }
    if kind == "arm" { return "capval_to_arm" }
    if kind == "finit" { return "capval_to_finit" }
    if kind == "warm" { return "capval_to_when_arm" }
    if kind == "sarm" { return "capval_to_select_arm" }
    if kind == "ccfg" { return "capval_to_comp_config" }
    if kind == "cpair" { return "capval_to_comp_config_pair" }
    if kind == "cslot" { return "capval_to_children_slot" }
    if kind == "ann" { return "capval_to_ann" }
    "capval_to_expr"
}

/// The id/value type of a node kind's list element.
fn kind_elem_type(kind: string) -> string {
    if kind == "pat" { return "PatId" }
    if kind == "stmt" { return "StmtId" }
    if kind == "type" { return "TypeExpr" }
    if kind == "pentry" { return "ParamEntry" }
    if kind == "tparam" { return "TypeParamEntry" }
    if kind == "field" { return "FieldEntry" }
    if kind == "variant" { return "Variant" }
    if kind == "arm" { return "MatchArm" }
    if kind == "finit" { return "FieldInit" }
    if kind == "warm" { return "WhenArm" }
    if kind == "sarm" { return "SelectArm" }
    if kind == "ccfg" { return "CompConfig" }
    if kind == "cpair" { return "CompConfigPair" }
    if kind == "cslot" { return "ChildrenSlot" }
    if kind == "ann" { return "Annotation" }
    "ExprId"
}

/// The declared element type of a label's accumulator list: a terminal label
/// collects Tokens, a ref/hand label collects the referenced rule's node ids.
fn list_decl_type(g: Grammar, seq: GSeq, label: string) -> string {
    let p = find_label_prim_seq(seq, label)
    match p {
        .Lit(_) -> "Token"
        .Named(_) -> "Token"
        .Group(_) -> "Token"
        .Ref(name) -> kind_elem_type(rule_result_kind(g, name))
        .Hand(hf) -> kind_elem_type(hand_kind(hf))
        // A zero-width `@when`/`@peek` predicate is never captured into a list; these
        // arms exist only for exhaustiveness.
        .Pred(_) -> "Token"
        .Peek(_) -> "Token"
        // `@gensym` IS captured — but never into a list, since a repetition on it is a
        // grammar-parse error (seed_parser). Token is the honest element type anyway:
        // it binds a synthetic `CapVal.Tok`.
        .Gensym(_) -> "Token"
        // `@rawbrace` binds a synthetic `CapVal.Tok` too (text = the captured slice).
        .RawBrace(_) -> "Token"
    }
}

/// Find the primary of the first item bound to `label` anywhere in the seq
/// (recursing into groups). Returns a Lit("") sentinel when absent.
fn find_label_prim_seq(seq: GSeq, label: string) -> GPrim {
    for item in seq.items {
        if item.label == label { return item.prim }
        match item.prim {
            .Group(inner) -> {
                let p = find_label_prim_node(inner, label)
                if !prim_is_empty_lit(p) { return p }
            }
            _ -> {}
        }
    }
    GPrim.Lit("")
}

fn find_label_prim_node(node: GNode, label: string) -> GPrim {
    match node {
        .Alt(branches) -> {
            for b in branches {
                let p = find_label_prim_seq(b, label)
                if !prim_is_empty_lit(p) { return p }
            }
            GPrim.Lit("")
        }
    }
}

fn prim_is_empty_lit(prim: GPrim) -> bool {
    match prim { .Lit(t) -> t == ""  _ -> false }
}

/// Optional-scalar labels: One-captured labels reachable inside a `( … )?`
/// group (assigned when the option fires), excluding repetition labels (which
/// are lists). These are declared `mut … = CapVal.Nil` at the branch top.
fn opt_scalar_labels_of(seq: GSeq, list_labels: List<string>) -> List<string> {
    mut out: List<string> = []
    for item in seq.items {
        for l in item_opt_scalars(item, false, list_labels) {
            if !str_in(out, l) { out.push(l) }
        }
    }
    out
}

fn item_opt_scalars(item: GItem, in_opt: bool, list_labels: List<string>) -> List<string> {
    mut out: List<string> = []
    if in_opt && rep_is_one(item.rep) && item.label != "" && !str_in(list_labels, item.label) {
        out.push(item.label)
    }
    match item.prim {
        .Group(inner) -> {
            let child_in_opt = in_opt || rep_is_opt(item.rep)
            for l in node_opt_scalars(inner, child_in_opt, list_labels) {
                if !str_in(out, l) { out.push(l) }
            }
        }
        _ -> {}
    }
    out
}

fn node_opt_scalars(node: GNode, in_opt: bool, list_labels: List<string>) -> List<string> {
    match node {
        .Alt(branches) -> {
            mut out: List<string> = []
            for b in branches {
                for item in b.items {
                    for l in item_opt_scalars(item, in_opt, list_labels) {
                        if !str_in(out, l) { out.push(l) }
                    }
                }
            }
            out
        }
    }
}


fn join_commas(xs: List<string>) -> string {
    mut out = ""
    mut i = 0
    for x in xs {
        if i > 0 { out = out + ", " }
        out = out + x
        i = i + 1
    }
    out
}


// ── @expect / @recover lookup ──


fn recover_target(annots: List<GAnnot>) -> string {
    for a in annots {
        match a {
            .Recover(sync_to) -> return sync_to
            _ -> {}
        }
    }
    ""
}
