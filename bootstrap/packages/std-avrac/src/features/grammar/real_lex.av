// WHY: the REAL-lexer bridge for the grammar-DSL executor (ps3t.6.5.8).
// Retires the proof-slice demo tokeniser (`lex_expr`, lex.av) from the
// execution path: the DSL-generated parser now consumes EXACTLY the token
// stream the hand-written parser sees, produced by the shipping streaming
// lexer (parse/lexer.av, driven through `parser_new`).
//
// The streaming lexer is pull-based — a `Parser` holds `current_kind` /
// `current_lexeme` / `current_start` and advances in place via
// `advance_token()`. This bridge drives it to completion and materialises
// the whole stream as executor `Token`s (kind / text / byte-offset), the
// vocabulary `executor.av` matches grammar terminals against.
//
// Why this closes real divergences (not just plumbing):
//   * Reserved words. The demo lexer classified EVERY word as `IDENT`, so a
//     bare `IDENT` terminal matched reserved words like `bare` / `async` that
//     the hand lexer rejects (`Tk.KwReserved`). Here keywords map to a
//     non-`IDENT` kind, so the DSL and hand parsers now AGREE (both reject).
//   * String escapes. The real lexer resolves `\n` etc. into the lexeme; the
//     hand parser stores that resolved text, so the DSL (same tokens) matches
//     it exactly instead of carrying the demo lexer's raw backslashes.
//   * Multi-char operators, comments, numeric bases / durations — all handled
//     once, by the real lexer, identically for both parsers.
//
// Kind vocabulary the executor cares about is the set of NAMED terminals
// (`IDENT NUMBER STRING BOOL EOF`); every other token (keywords, operators,
// punctuation) is matched by TEXT, so its kind only has to avoid colliding
// with a named-terminal kind — `KW` for keywords, `PUNCT` for operators.
use core.{Tk, tk_keyword_str, tk_is_number_lit, tk_is_bool_lit}
use parse.{Parser, parser_new_lex_only}
use features.grammar.{Token, terminal_rules}
use diagnostics.{Diagnostic, error_def}

impl Parser {
    /// Drive this parser's streaming lexer from its current position to EOF,
    /// returning the whole stream bridged to executor `Token`s. Lives as a
    /// `Parser` method (like `parse_grammar_block`) so it can call the
    /// lexer's own `advance_token` / read `current_*` without exporting them.
    fn lex_all_grammar_tokens(self) -> List<Token> {
        self.lex_all_grammar(). toks
    }

    /// The same drive, keeping the lexer's own DIAGNOSTICS and the token index each
    /// one belongs to.
    ///
    /// The streaming lexer reports as it scans (`unexpected character \`;\``,
    /// `unterminated string`, a bad number), into the `Parser.bag` this bridge builds
    /// and then throws away. On the HAND path those land interleaved with the parser's
    /// own diagnostics, because the hand pulls one token at a time and the lexer
    /// reports mid-pull. On the native path the whole stream is lexed up front, so a
    /// discarded bag is a diagnostic the user never sees: `let z = ;` is F0001
    /// `unexpected character \`;\`` + F0041 on the hand and F0041 alone natively.
    ///
    /// Attribution is EXACT and needs no byte→token mapping: the bag is measured
    /// either side of each `advance_token()`, so anything new belongs to the token
    /// that call produced. Byte spans would have to be re-searched against token
    /// starts and would tie on a zero-width report.
    fn lex_all_grammar(self) -> LexedSource {
        mut toks: List<Token> = []
        mut diags: List<LexDiag> = []
        // `parser_new` already primed the first token, so `current_*` is valid before
        // the first advance — and anything already in the bag was reported while
        // producing token 0.
        mut seen = 0
        while seen < self.bag.diagnostics.length {
            diags.push(lex_diag_at(0, self.bag.diagnostics[seen]))
            seen = seen + 1
        }
        while true {
            let k = self.current_kind
            toks.push(Token {
                kind: tk_to_grammar_kind(k),
                text: self.current_lexeme,
                pos: self.current_start,
                tk: k,
            })
            if k == Tk.Eof { break }
            self.advance_token()
            // Whatever the lexer just reported belongs to the token it just produced,
            // which is the one about to be pushed — index `toks.length`.
            while seen < self.bag.diagnostics.length {
                diags.push(lex_diag_at(toks.length, self.bag.diagnostics[seen]))
                seen = seen + 1
            }
        }
        LexedSource { toks, diags }
    }
}

/// One lexer diagnostic, tagged with the index of the token it was reported while
/// producing. `code` is the F-code STRING, matching `GDiag` — the vocabulary the DSL
/// diagnostics channel speaks, so a flushed lexer diagnostic is indistinguishable from
/// a rule's own by the time the flip seam re-reports it.
export type LexDiag = { at: int, code: string, msg: string }

/// A lexed source: the token stream plus the lexer diagnostics, positioned.
export type LexedSource = { toks: List<Token>, diags: List<LexDiag> }

fn lex_diag_at(at: int, d: Diagnostic) -> LexDiag {
    LexDiag { at, code: error_def(d.code).code, msg: d.message }
}

/// Tokenise `src` through the shipping streaming lexer and hand back the
/// executor token stream — the drop-in replacement for `lex_expr`.
export fn lex_real(src: string) -> List<Token> {
    // Lex-only construction: no registry build per lex (lexing never
    // consults features/lang — see parser_new_lex_only).
    mut p = parser_new_lex_only(src)
    p.lex_all_grammar_tokens()
}

/// `lex_real` plus the positioned lexer diagnostics — what a PState is built from, so
/// the native parser can flush each one at the point the hand would have reported it.
export fn lex_real_full(src: string) -> LexedSource {
    mut p = parser_new_lex_only(src)
    p.lex_all_grammar()
}

/// True for the keyword family (all `Kw*` variants), including the reserved
/// future keywords `tk_keyword_str` folds into its `""` tail (`bare`, `async`,
/// …). Reuses the existing keyword table so there's ONE source of truth for
/// keyword-ness — this only patches the one variant that table omits.
fn tk_is_keyword(tk: Tk) -> bool {
    match tk {
        .Keyword(.Reserved) -> true
        _ -> tk_keyword_str(tk) != ""
    }
}

/// Map a lexer `Tk` to the executor's terminal-matching kind string. Only the
/// NAMED-terminal kinds (`IDENT NUMBER STRING BOOL EOF`) are semantically
/// load-bearing; keyword/operator tokens are matched by their `text`, so their
/// kind just has to be non-`IDENT` (keywords) or otherwise distinct.
export fn tk_to_grammar_kind(tk: Tk) -> string {
    // ONE declaration serves both engines: the emitter takes each row's `guard`,
    // this takes its `matches`. Neither can drift from the other, because there
    // is no other to drift from.
    //
    // KW and PUNCT stay OUT of the table deliberately — they are catch-alls with
    // no emitted guard, and `terminal_guard` uses "" as its not-a-terminal
    // sentinel, so a row with an empty guard would be indistinguishable from an
    // absent one.
    for t in terminal_rules() { if t.matches(tk) { return t.name } }
    if tk_is_keyword(tk) { "KW" } else { "PUNCT" }
}
