// WHY: the grammar-AST — the shared contract between the grammar-DSL
// seed parser (ps3t.6.3, seed_parser.av) and the generator/executor
// (ps3t.6.4, executor.av + emit.av). One small EBNF notation
// (Crafting Interpreters Ch5 metasyntax + captures + build +
// @expect/@recover) is read into these types, then lowered to an
// error-tolerant recursive-descent parser. See
// docs/2026_06_14_GRAMMAR_DSL.md and
// docs/2026_07_15_L4_DERIVE_FRAMEWORK_DESIGN.md §2.
//
// The grammar body is a small mutually-recursive tree:
//   Grammar -> Rule -> GNode(Alt) -> GSeq -> GItem -> GPrim -> GNode
// mirroring the metasyntax: a grammar is rules; a rule is an
// alternation; an alternation is sequences; a sequence is labelled
// postfix items plus an optional build + error annotations; a postfix
// item is a primary with a repetition; a primary is a nonterminal ref,
// a terminal (literal text or a named token), or a parenthesised group
// (another alternation).

// ── The grammar tree ──

/// A whole grammar: a name + its rules. The first rule is the start
/// symbol (Nystrom's convention). `rule_idx` is a precomputed
/// name->index lookup map (build_rule_index) so rule resolution is O(1)
/// instead of a linear scan of `rules` on every rule descent — see
/// build_rule_index / rule_index_of below. Built ONCE at construction
/// (the two Grammar constructors: parse_grammar_body + compose_grammars).
export type Grammar = { name: string, rules: List<Rule>, rule_idx: ptr }

/// One production `name = body`, where `body` is always an Alt.
export type Rule = { name: string, body: GNode }

// The C-side string->int hash map backing the rule index (runtime.c).
// Redeclared here (as in core/registry.av + features/comptime) — an extern
// decl is just a reference to the C symbol, not a definition.
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

/// Build a rule-name -> index (into `rules`) lookup map, so a rule can be
/// resolved by name in O(1) instead of lookup_rule's O(rules) linear
/// `r.name == name` scan (which, run per rule descent, was ~5% of the
/// grammar-DSL flip's instructions). FIRST occurrence wins — a duplicate
/// name keeps the EARLIER rule, exactly matching the linear scan's
/// first-match semantics, so a composed grammar (compose_grammars) that
/// re-lists a shared rule still resolves to the head's definition.
/// Called ONCE per Grammar at construction.
export fn build_rule_index(rules: List<Rule>) -> ptr {
    let m = avra_map_new_cstr()
    mut i = 0
    while i < rules.length {
        let nm = rules[i].name
        if avra_map_has_cstr(m, nm) == 0 {
            avra_map_set_cstr(m, nm, i)
        }
        i = i + 1
    }
    m
}

/// Resolve a rule name to its index in `g.rules` via the precomputed
/// `rule_idx` map, or -1 if absent. The O(1) core of lookup_rule.
export fn rule_index_of(g: Grammar, name: string) -> int {
    if avra_map_has_cstr(g.rule_idx, name) == 0 { return -1 }
    avra_map_get_cstr(g.rule_idx, name)
}

/// The grammar body node. Kept as an enum (not a bare Alt) so the tree
/// has an obvious recursion point and can grow node kinds later
/// (e.g. a `@hand(fn)` escape-hatch primary is a GPrim, not a GNode).
export enum GNode {
    /// `a | b | c` — one-or-more sequence branches, tried in order
    /// (first-match, per recursive descent).
    Alt(branches: List<GSeq>)
}

/// A single alternative: an ordered list of labelled postfix items,
/// an optional build directive, and any error annotations.
///
/// `speculative` (the `@try` branch marker, t-47hc.3) makes this alternative
/// BOUNDED-BACKTRACKING: the executor snapshots the cursor + node store before
/// running it and, if it fails (adds a diagnostic), ROLLS BACK and tries the
/// next alternative — the grammar analogue of the hand parser's
/// save_state/restore_state (f<T> generic-call vs `<` less-than). A non-`@try`
/// branch stays predictive (first-match, no backtracking); default false.
export type GSeq = {
    items: List<GItem>,
    build: GBuild,
    annots: List<GAnnot>,
    speculative: bool,
}

/// A postfix item: an optional capture label + a repetition + a
/// primary. `label == ""` means uncaptured. Repetition is one of
/// GRep (One / Star / Plus / Opt).
export type GItem = {
    label: string,
    rep: GRep,
    prim: GPrim,
    // ps3t.6.7 newline-sensitivity (the `^` marker): when true, this item matches
    // only if its first token is on the SAME source line as the previously-
    // consumed token — the postfix-chain / bare-return cutoff the hand parser
    // does with `current_line == prev_line`. Default false (line-insensitive).
    sameline: bool,
    // t-47hc mode-SET marker (`@off(flag)`): the name of an ExprModes flag to
    // turn OFF for the DURATION of this item's sub-parse, then restore — the
    // executor+emit twin of the hand parser's `saved = allow_struct_lit;
    // allow_struct_lit = false; … = saved` around a control-header condition
    // (the `while foo {` struct-literal-vs-body disambiguation). Empty = no set
    // (every item today). The write-side complement of `@when`'s modes_flag READ.
    mode_off: string,
    // t-47hc mode-SET marker (`@on(flag)`): the SET-ON twin of `mode_off` — the name
    // of an ExprModes flag to turn ON for the duration of this item's sub-parse, then
    // restore. Mirrors the hand parser's `saved = allow_dot_postfix; allow_dot_postfix
    // = true; … = saved` (parse_paren_expr re-enables dot-postfix inside `(...)`).
    // Empty = no set. mode_off and mode_on are mutually exclusive on one item.
    mode_on: string,
    // t-47hc.21 COMMIT POINT (`@cut`, the PEG cut): when true, reaching this item
    // COMMITS the enclosing `@try` branch. Past the cut a diagnostic is a real
    // parse error — reported and recovered from — instead of the "wrong branch,
    // roll back" signal `@try` otherwise reads it as. That conflation is why a
    // speculative branch could never own its own error path, and why every
    // ambiguous statement form needed an `@hand(*_edge)` fallback purely to hold
    // the diagnostics. Place the cut right after the tokens that make the branch
    // unambiguous (`… lo:expression ".." @cut hi:expression`). The commit is
    // IRREVOCABLE once reached, and only meaningful inside `@try` — a cut on a
    // predictive branch is rejected at grammar-parse time (validate_cuts).
    cut: bool,
    // t-47hc.21 ABORT (`@require`, `@cut`'s dual): when true, a MISMATCH on this
    // terminal stops the rule instead of reporting and carrying on. Both engines are
    // error-TOLERANT by default — a missing token reports and the sequence keeps
    // building a partial node — but the hand parser `return .Err`s and lets the
    // statement-list loop synchronise. Without a way to say that, a malformed header
    // runs away and swallows the next declaration (`impl for Foo { }` parsed as a
    // for-in over `Foo` whose body ate the following `fn`), which is the whole reason
    // the `@hand(*_edge)` oracles exist. `@require` is a BARE marker: the message
    // still comes from the sequence's `@expect(tok, msg)`, so there is one seam for
    // diagnostics and one for control flow. Inside a `@try` branch BEFORE a `@cut` it
    // degrades to plain reporting — the rollback already IS the abort.
    require: bool,
}

/// Repetition suffix on a primary: none / `*` / `+` / `?`.
export enum GRep { One, Star, Plus, Opt }

/// A primary — the atom a postfix wraps.
export enum GPrim {
    /// A nonterminal reference — recurse into that rule.
    Ref(name: string)
    /// A literal terminal — exact source text (`"+"`, `"true"`).
    Lit(text: string)
    /// A named terminal from the lexer (`NUMBER`, `STRING`, `IDENT`).
    Named(tok: string)
    /// `( … )` — a parenthesised group, itself an alternation.
    Group(inner: GNode)
    /// `@hand(fn)` — the ESCAPE HATCH. A rule position that delegates to
    /// a hand-written parse function, for the gnarly 5% a small CFG
    /// can't cleanly express (`<T>` generic-vs-less-than, the `~`
    /// context-overload; GRAMMAR_DSL.md §5, ps3t.6.7). Keeps the DSL
    /// minimal — the hard cases live in code the grammar merely *calls*,
    /// not in new notation. Whole-rule granularity only (no inline
    /// semantic actions — the §1 hard line holds).
    Hand(fn_name: string)
    /// `@when(flag)` — a zero-width SEMANTIC PREDICATE (t-47hc.3). Consumes
    /// no token; it GATES its branch on a parse MODE flag (`allow_struct_lit`,
    /// `allow_dot_postfix`, `allow_it_sugar`, `cell_mode`), read from the live
    /// `ExprModes` the executor already threads through `PState`. This is how a
    /// grammar rule expresses the context-sensitivity the hand parser does with
    /// a mode flag — e.g. `if Foo { … }`: inside a control-header the `{` is the
    /// body, so a struct-literal alternative is gated `@when(allow_struct_lit)`.
    /// Predicates AND (all must hold) where FIRST-token alternatives OR; a
    /// leading `@when` is nullable (it never contributes a FIRST token).
    Pred(mode: string)
    /// `@peek(cond)` — a zero-width LOOKAHEAD SEMANTIC PREDICATE (t-47hc paren prep).
    /// The token-stream sibling of `@when`: same zero-width / nullable / AND-gating /
    /// no-repetition shape, but instead of reading an `ExprModes` flag it inspects the
    /// upcoming TOKENS. This is how a grammar expresses the hand parser's fixed-lookahead
    /// disambiguations — e.g. `parse_paren_expr`'s `peek_after_ident_is_colon()`, which
    /// distinguishes a typed lambda `(x: int) -> …` from a grouping/tuple by peeking past
    /// the first IDENT for a `:`. `cond` names the lookahead check (validated against
    /// seed_parser.peek_cond_supported; executor.lookahead_ok maps it to a token test).
    Peek(cond: string)
}

/// The `-> …` build that constructs the result from captures.
///   None       — pass-through of the single sub-result (`a = b`).
///   Var(name)  — return a named capture (`-> e`).
///   Call(n,as) — construct a node / call a fixed helper: `-> Unary(op,
///                operand)`, `-> fold_binary(l, op, r)`. The executor
///                dispatches on `name` (helper vocabulary vs node ctor).
export enum GBuild {
    None
    Var(name: string)
    Call(name: string, args: List<string>)
}

/// Error annotations lifted from Nystrom's by-hand `synchronize()` into
/// the grammar (GRAMMAR_DSL.md §1). `@expect(tok, msg)` asserts the
/// next token or reports `msg`; `@recover(sync_to: tok)` marks a
/// panic-mode synchronize target.
export enum GAnnot {
    Expect(tok: string, msg: string)
    Recover(sync_to: string)
}

// ── Small constructors / probes (keep call sites readable) ──

/// A plain uncaptured One-item from a primary.
export fn gitem(prim: GPrim) -> GItem {
    GItem { label: "", rep: GRep.One, prim, sameline: false, mode_off: "", mode_on: "", cut: false, require: false }
}

/// True when a sequence has no explicit build — the executor then
/// applies the default build (pass-through of the single sub-result, or
/// a literal from a lone terminal). See executor.av `default_build`.
export fn gbuild_is_none(b: GBuild) -> bool {
    match b {
        .None -> true
        _ -> false
    }
}

/// True for the collecting repetitions (`*` / `+`) — captures inside
/// them accumulate into parallel lists rather than binding a scalar.
export fn grep_is_multi(r: GRep) -> bool {
    match r {
        .Star or .Plus -> true
        _ -> false
    }
}
