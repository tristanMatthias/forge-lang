// WHY: the grammar-AST — the shared contract between the grammar-DSL
// seed parser (ps3t.6.3, seed_parser.av) and the generator/executor
// (ps3t.6.4, executor.av + emit.av). One small EBNF notation
// (Crafting Interpreters Ch5 metasyntax + captures + build +
// @expect/@recover) is read into these types, then lowered to an
// error-tolerant recursive-descent parser. See
// docs/2026_06_14_GRAMMAR_DSL.md and
// docs/2026_07_15_L4_DERIVE_FRAMEWORK_DESIGN.md §2.
//
// The grammar body is a small mutually-recursive tree:
//   Grammar -> Rule -> GNode(Alt) -> GSeq -> GItem -> GPrim -> GNode
// mirroring the metasyntax: a grammar is rules; a rule is an
// alternation; an alternation is sequences; a sequence is labelled
// postfix items plus an optional build + error annotations; a postfix
// item is a primary with a repetition; a primary is a nonterminal ref,
// a terminal (literal text or a named token), or a parenthesised group
// (another alternation).

// ── The grammar tree ──

/// A whole grammar: a name + its rules. The first rule is the start
/// symbol (Nystrom's convention). `rule_idx` is a precomputed
/// name->index lookup map (build_rule_index) so rule resolution is O(1)
/// instead of a linear scan of `rules` on every rule descent — see
/// build_rule_index / rule_index_of below. Built ONCE at construction
/// (the two Grammar constructors: parse_grammar_body + compose_grammars).
/// One feature-supplied build row, stamped onto a composed grammar (t-kd4y.3).
/// The kind ANALYSIS (seq_kind below) must classify a manifest-only build
/// (`build_defer` → "stmt") by its registration, not the lenient "expr"
/// default — `declaration`'s Alt-kind takes the first non-empty branch answer,
/// so one misclassified feature rule can flip a whole family's accumulator
/// typing. The row also carries the EMISSION-visible projection (arity /
/// module / export_name) so a stamped grammar is self-sufficient for emit —
/// re-running the feature factories per emitted call name was a measured
/// arena-accumulation source (Batch A). A narrow row (not BuilderBind)
/// because that type carries executor values (PState/CapVal) this AST hub
/// must not depend on.
export type BuildKindRow = { name: string, kind: string, spanned: bool, arity: int, module: string, export_name: string }

export type Grammar = { name: string, rules: List<Rule>, rule_idx: ptr, builder_kinds: List<BuildKindRow> }

/// Stamp manifest kind rows onto a composed grammar. Applied at the seams
/// that HAVE the manifest (gen_*_file entries, the Parser's cached-grammar
/// build) — never fetched per analysis call (feature_builders() re-runs the
/// feature factories; see the #1232 rc-strict RSS regression).
export fn grammar_with_builder_kinds(g: Grammar, rows: List<BuildKindRow>) -> Grammar {
    Grammar { name: g.name, rules: g.rules, rule_idx: g.rule_idx, builder_kinds: rows }
}

/// One production `name = body`, where `body` is always an Alt.
export type Rule = { name: string, body: GNode }

/// The single LITERAL token that starts `name`, or "" when its FIRST is not a
/// singleton literal (t-47hc.24).
///
/// WHY it must be a singleton literal, not merely a computable FIRST: this is the
/// message key for `@require <rule>`. `@expect(tok, msg)` and the executor's
/// `handle_missing(st, expected, annots)` are both keyed by TOKEN TEXT, so a required
/// rule reference can only report "expected X" when there is exactly one X it could
/// have started with. A rule whose FIRST is a disjunction or a named-terminal KIND has
/// no single answer, and silently picking one would put a wrong token in the
/// diagnostic — so those are rejected at grammar-parse time instead.
///
/// ONE definition, three consumers — seed_parser validates against it, emit renders the
/// guard's message from it, the executor reports with it. A second copy would be the
/// same drift hazard the FIRST-set computation already avoids by being shared.
export fn rule_first_literal(g: Grammar, name: string) -> string {
    for r in g.rules {
        if r.name == name { return node_first_literal(r.body) }
    }
    ""
}

/// Every branch must lead with the SAME literal, else there is no single expected token.
fn node_first_literal(n: GNode) -> string {
    match n {
        .Alt(branches) -> {
            mut lit = ""
            for seq in branches {
                let s = seq_first_literal(seq)
                if s == "" { return "" }
                if lit == "" { lit = s }
                else if lit != s { return "" }
            }
            lit
        }
    }
}

/// The leading literal of one branch, skipping the zero-width markers the emitters
/// skip (`@when` / `@peek`) exactly as branch selection does.
fn seq_first_literal(seq: GSeq) -> string {
    for item in seq.items {
        if prim_is_zero_width(item.prim) { continue }
        match item.prim {
            .Lit(t) -> { return t }
            _ -> { return "" }
        }
    }
    ""
}

/// `@when` / `@peek` / `@gensym` — consume no token, so they never contribute a FIRST.
///
/// `@gensym` is here for `rule_first_literal`'s sake (via seq_first_literal): a rule that
/// mints before its keyword must still resolve to that keyword, or `@require` on a
/// reference to it could not name the token it expected.
fn prim_is_zero_width(prim: GPrim) -> bool {
    match prim {
        .Pred(_) -> true
        .Peek(_) -> true
        .Gensym(_) -> true
        _ -> false
    }
}

// The C-side string->int hash map backing the rule index (runtime.c).
// Redeclared here (as in core/registry.av + features/comptime) — an extern
// decl is just a reference to the C symbol, not a definition.
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

/// Build a rule-name -> index (into `rules`) lookup map, so a rule can be
/// resolved by name in O(1) instead of lookup_rule's O(rules) linear
/// `r.name == name` scan (which, run per rule descent, was ~5% of the
/// grammar-DSL flip's instructions). FIRST occurrence wins — a duplicate
/// name keeps the EARLIER rule, exactly matching the linear scan's
/// first-match semantics, so a composed grammar (compose_grammars) that
/// re-lists a shared rule still resolves to the head's definition.
/// Called ONCE per Grammar at construction.
/// Every literal terminal appearing anywhere in `g`, in declaration order,
/// duplicates kept (callers dedup). The grammar-DERIVED surfaces — feature
/// keywords, highlighting — build on this instead of re-walking GNode.
export fn grammar_literals(g: Grammar) -> List<string> {
    mut out: List<string> = []
    for r in g.rules { out = node_literals(out, r.body) }
    out
}

fn node_literals(acc: List<string>, node: GNode) -> List<string> {
    mut out = acc
    match node {
        .Alt(branches) -> {
            for b in branches {
                for item in b.items {
                    out = match item.prim {
                        .Lit(text) -> out.push(text)
                        .Group(inner) -> node_literals(out, inner)
                        _ -> out
                    }
                }
            }
        }
    }
    out
}

/// One `-> Name(args)` build reference in a grammar: the rule it appears in
/// (for diagnostics), the build name, and its argument count. The unit
/// `grammar_build_refs` collects and builder validation (features/lang.av
/// register_lang) checks resolution against — t-kd4y.3.
export type BuildRef = { rule: string, name: string, argc: int }

/// Every `.Call` build reference anywhere in `g`, in declaration order,
/// duplicates kept (one per referencing sequence). The sibling of
/// `grammar_literals`: builds sit on sequences (`GSeq.build`), including
/// sequences nested inside `Group`s, so the walk covers both.
export fn grammar_build_refs(g: Grammar) -> List<BuildRef> {
    mut out: List<BuildRef> = []
    for r in g.rules { out = node_build_refs(out, r.name, r.body) }
    out
}

fn node_build_refs(acc: List<BuildRef>, rule: string, node: GNode) -> List<BuildRef> {
    mut out = acc
    match node {
        .Alt(branches) -> {
            for b in branches {
                match b.build {
                    .Call(name, args) -> out.push(BuildRef { rule: rule, name: name, argc: args.length })
                    _ -> {}
                }
                for item in b.items {
                    match item.prim {
                        .Group(inner) -> out = node_build_refs(out, rule, inner)
                        _ -> {}
                    }
                }
            }
        }
    }
    out
}

export fn build_rule_index(rules: List<Rule>) -> ptr {
    let m = avra_map_new_cstr()
    mut i = 0
    while i < rules.length {
        let nm = rules[i].name
        if avra_map_has_cstr(m, nm) == 0 {
            avra_map_set_cstr(m, nm, i)
        }
        i = i + 1
    }
    m
}

/// Resolve a rule name to its index in `g.rules` via the precomputed
/// `rule_idx` map, or -1 if absent. The O(1) core of lookup_rule.
export fn rule_index_of(g: Grammar, name: string) -> int {
    if avra_map_has_cstr(g.rule_idx, name) == 0 { return -1 }
    avra_map_get_cstr(g.rule_idx, name)
}

/// The grammar body node. Kept as an enum (not a bare Alt) so the tree
/// has an obvious recursion point and can grow node kinds later
/// (e.g. a `@hand(fn)` escape-hatch primary is a GPrim, not a GNode).
export enum GNode {
    /// `a | b | c` — one-or-more sequence branches, tried in order
    /// (first-match, per recursive descent).
    Alt(branches: List<GSeq>)
}

/// A single alternative: an ordered list of labelled postfix items,
/// an optional build directive, and any error annotations.
///
/// `speculative` (the `@try` branch marker, t-47hc.3) makes this alternative
/// BOUNDED-BACKTRACKING: the executor snapshots the cursor + node store before
/// running it and, if it fails (adds a diagnostic), ROLLS BACK and tries the
/// next alternative — the grammar analogue of the hand parser's
/// save_state/restore_state (f<T> generic-call vs `<` less-than). A non-`@try`
/// branch stays predictive (first-match, no backtracking); default false.
/// `fallback` (the `@fallback` branch marker, t-47hc.33) makes this alternative the
/// UNCONDITIONAL tail: it runs when no earlier branch's FIRST matched, instead of the
/// alternation reporting "expected an expression". Only a trailing `@hand` branch had
/// that role before, which meant a rule whose alternatives are all NATIVE could not own
/// its own error message — the `index_tail` shape, where `[i]` and `[a..b]` need the two
/// different closing-`]` diagnostics the hand parser emits, and `@expect` keys on the
/// token so each needs its own sequence. Must be the LAST branch (a guarded branch after
/// it would be dead) and at most one; both enforced at grammar-parse time.
/// A gated rule reference found inside a node — see emit.gated_ref_of. `onfail` is that
/// item's failure POLICY (`GItem.onfail`) and `label` its capture, both carried here
/// because the caller-side unwind is emitted at the GROUP level, where the gated item
/// itself is no longer in hand: the policy decides whether the abort unwinds the rule or
/// closes the repetition, and the label names the accumulator a closed repetition must
/// take its half-built element back off.
export type GatedRef = { found: bool, rule: string, onfail: string, label: string }

export type GSeq = {
    items: List<GItem>,
    build: GBuild,
    annots: List<GAnnot>,
    speculative: bool,
    fallback: bool,
}

/// A postfix item: an optional capture label + a repetition + a
/// primary. `label == ""` means uncaptured. Repetition is one of
/// GRep (One / Star / Plus / Opt).
export type GItem = {
    label: string,
    rep: GRep,
    prim: GPrim,
    // ps3t.6.7 newline-sensitivity (the `^` marker): when true, this item matches
    // only if its first token is on the SAME source line as the previously-
    // consumed token — the postfix-chain / bare-return cutoff the hand parser
    // does with `current_line == prev_line`. Default false (line-insensitive).
    sameline: bool,
    // t-47hc mode-SET marker (`@off(flag)`): the name of an ExprModes flag to
    // turn OFF for the DURATION of this item's sub-parse, then restore — the
    // executor+emit twin of the hand parser's `saved = allow_struct_lit;
    // allow_struct_lit = false; … = saved` around a control-header condition
    // (the `while foo {` struct-literal-vs-body disambiguation). Empty = no set
    // (every item today). The write-side complement of `@when`'s modes_flag READ.
    mode_off: string,
    // t-47hc mode-SET marker (`@on(flag)`): the SET-ON twin of `mode_off` — the name
    // of an ExprModes flag to turn ON for the duration of this item's sub-parse, then
    // restore. Mirrors the hand parser's `saved = allow_dot_postfix; allow_dot_postfix
    // = true; … = saved` (parse_paren_expr re-enables dot-postfix inside `(...)`).
    // Empty = no set. mode_off and mode_on are mutually exclusive on one item.
    mode_on: string,
    // t-47hc.32 counter-SET marker (`@bump(counter)`): the INT twin of mode_off/mode_on.
    // Those set a settable BOOL for the item's sub-parse; a counter is incremented and
    // restored by the same save/restore, which is what `quote_depth` needs — the hand
    // parse_quote bumps it on entering a quote body and restores on leaving. Empty = no
    // bump. Mutually exclusive with mode_off/mode_on on one item.
    mode_bump: string,
    // t-47hc.34 CONDITIONAL mode-SET (`@on_if(pred, flag)`): the name of a `@when`
    // PREDICATE gating `mode_on`. Empty = the set is unconditional (every `@on` today).
    //
    // The hand parser has shapes where a mode is set only when a condition holds —
    // `allow_it_sugar = is_method || saved_it` around a call's argument list, where
    // is_method asks whether the RECEIVER is a field access. Spelling that as two
    // grammar branches makes them share a FIRST token, split only by a `@when`, which
    // the ambiguity guard rejects (correctly: `@when` reads ambient state, so it does
    // not partition the INPUT the way `@peek`/`@try` do). And it cannot move into the
    // builder either, because the mode PROPAGATES into nested sub-parses — the very
    // thing a build-time decision cannot reproduce. So the set itself has to be
    // conditional, which is this field.
    mode_on_if: string,
    // t-47hc.21 COMMIT POINT (`@cut`, the PEG cut): when true, reaching this item
    // COMMITS the enclosing `@try` branch. Past the cut a diagnostic is a real
    // parse error — reported and recovered from — instead of the "wrong branch,
    // roll back" signal `@try` otherwise reads it as. That conflation is why a
    // speculative branch could never own its own error path, and why every
    // ambiguous statement form needed an `@hand(*_edge)` fallback purely to hold
    // the diagnostics. Place the cut right after the tokens that make the branch
    // unambiguous (`… lo:expression ".." @cut hi:expression`). The commit is
    // IRREVOCABLE once reached, and only meaningful inside `@try` — a cut on a
    // predictive branch is rejected at grammar-parse time (validate_cuts).
    cut: bool,
    // t-47hc.21 ABORT (`@require`, `@cut`'s dual): when true, a MISMATCH on this
    // terminal stops the rule instead of reporting and carrying on. Both engines are
    // error-TOLERANT by default — a missing token reports and the sequence keeps
    // building a partial node — but the hand parser `return .Err`s and lets the
    // statement-list loop synchronise. Without a way to say that, a malformed header
    // runs away and swallows the next declaration (`impl for Foo { }` parsed as a
    // for-in over `Foo` whose body ate the following `fn`), which is the whole reason
    // the `@hand(*_edge)` oracles exist. `@require` is a BARE marker: the message
    // still comes from the sequence's `@expect(tok, msg)`, so there is one seam for
    // diagnostics and one for control flow. Inside a `@try` branch BEFORE a `@cut` it
    // degrades to plain reporting — the rollback already IS the abort.
    require: bool,
    // t-47hc.28 BOUNDED REPETITION (`x{#cap}`): the name of a capture whose LIST
    // LENGTH caps this repetition — "repeat `x`, at most `#cap` times". Empty = no
    // bound (every item before this, and today's only behaviour).
    //
    // This is what a COLUMNAR sub-language needs and a plain `*` cannot say: a
    // table's body rows take as many cells as the header row declared, so the count
    // is not a constant in the grammar — it is a property of something already
    // parsed. Captures inside `( … )*` ALREADY collect into parallel lists, so that
    // count is already in hand as a capture's length; binding it needs no integer
    // expressions inside the DSL and no attribute-evaluation engine, just this one
    // name. (`match … table` is the first spender: its cell loop is literally
    // `while i < value_count` — a BOUND, not the row-width VALIDATION it was long
    // recorded as; that check belongs to the separate `table { }` literal.)
    //
    // Deliberately a field rather than a `GRep` variant: a bounded star IS a star —
    // same list-collecting capture semantics, same FIRST-set guard, same emitted loop
    // shape — differing only by one extra exit condition. Keeping `GRep` at four
    // variants means no exhaustiveness churn across executor/emit/render. Legal only
    // on `*`/`+` (rejected at grammar-parse time otherwise), and the named capture
    // must be bound EARLIER in the same branch (validate_bounds).
    // t-myz7 GATE marker (`@gate(cond)`): a `@peek` whose cond REPLACES the branch's
    // FIRST guard instead of being ANDed onto it. A plain `@peek` can only NARROW a
    // branch's entry — `lookahead_ok(c, st) && (FIRST)` — so it can never make a loop
    // enter on a token the element's FIRST rejects. That is exactly what the hand's
    // `while !self.check(CLOSER)` element loops need: at EOF the hand ENTERS and
    // reports about the ELEMENT ("expected parameter name" for `fn f(`), while a
    // grammar `( x )*` exits and the enclosing `@require CLOSER` answers instead.
    // With `gate` set, the FIRST conjunct is dropped and the cond alone decides.
    gate: bool,
    // t-myz7 NON-ABORTING FAILURE POLICY (`@onfail(policy)`): what this position does
    // when its sub-parse fails. Empty = ABORT, which is what `@require` and `@gate`
    // both do today and what `enum`/`trait` want (a malformed member aborts the whole
    // declaration, so the caller still sees the stray `}` the hand leaves behind).
    //
    // WHY IT MUST BE STATED RATHER THAN INFERRED. The hand parsers do not agree on what
    // a malformed element does, and the disagreement is not a property of the INPUT:
    //
    //     enum with a bad variant field   -> (error)         ABORTS
    //     trait with a bad member         -> (error)         ABORTS
    //     select with a bad arm           -> (select ())     recovers, keeps the node
    //     spec with a bad given           -> (spec "s" )     recovers, DROPS the item
    //
    // A structural discriminator was derived from the first four cases and REFUTED by
    // measurement (the "unbalanced group opener" rule — `PState.group_delta` — took the
    // recovery corpus 109/114 -> 108/114; see the t-myz7 ticket, which records it so it
    // is not re-attempted). What each hand parser happens to do is per-rule POLICY, so
    // the DSL says it:
    //
    //     skip   on a rule REF        — check its FIRST; on failure report and step OVER
    //                                   it. Do not call it, do not consume, do not abort;
    //                                   the sequence continues. `@require`'s non-aborting
    //                                   twin, and what `enum E< { A }` needs: the hand
    //                                   reports "expected type parameter name" AND
    //                                   "expected `>`" and still builds `(enum E (A()))`,
    //                                   where calling `parse_tparam` on an unproven FIRST
    //                                   BINDS the `{` as a type-parameter name.
    //     halt   on a GATED element   — report, then ABANDON the rest of the enclosing
    //                                   GROUP, without aborting the rule. `close`'s
    //                                   reporting twin, and what a bracketed LIST needs:
    //                                   `parse_type_param_entries` answers a bad entry with
    //                                   `set_error(…); return out`, so the caller's
    //                                   `consume(Greater)` still runs and still reports.
    //                                   `enum E<,T>` is four diagnostics on the hand for
    //                                   exactly that reason — abandon consumes nothing, so
    //                                   `>`, `{` and the stray `}` each get their say.
    //     close  on a GATED element   — an aborting element ENDS the repetition instead
    //                                   of unwinding the rule, and its partial result is
    //                                   not pushed. `select { x }`: report the missing
    //                                   `<-`, close the arm list, let the rule's own `}`
    //                                   consume the brace, build `(select ())`.
    //     drop   on a stmt-list rep   — a failed child is OMITTED from the list rather
    //                                   than kept as an `(error)` row. `spec "s" { given }`
    //                                   builds `(spec "s" )`; `parse_spec_body` swallows
    //                                   the Err and returns the partial item list.
    //     bail   on a rule REF        — the callee reports; if it DID, abort. `@require`'s
    //                                   other half: `@require` tests whether the sub-rule
    //                                   STARTS here and reports for it, this tests whether
    //                                   it SUCCEEDED and lets it keep its own message.
    //                                   `parse_select_arm` is the shape — a channel
    //                                   expression that fails to parse ends the arm
    //                                   (`.Err(_) -> return out`), so `select { x <- }` is
    //                                   the expression view's F0040 and nothing more,
    //                                   where carrying on adds the `->` mismatch too.
    //     discard on a CLOSING terminal — report the missing closer, then THROW AWAY the
    //                                   list the bracket was collecting, and carry on.
    //                                   `parse_type_params` is literally this: a missing
    //                                   `>` returns an empty list, so `enum E<T { A }` is
    //                                   `(enum E (A()))` on the hand — `T` is parsed and
    //                                   then dropped with the unterminated bracket.
    //
    // Each policy is legal only on the shape it names (validate_onfail in seed_parser).
    onfail: string,
    // The capture `@onfail(discard, <label>)` throws away — empty for every other policy.
    //
    // NAMED rather than derived from the enclosing group because the emitters reach a
    // terminal with the BRANCH's capture sets in hand, not the group's, and "the labels
    // this bracket collected" is not recoverable from there. Naming it also puts the
    // consequence at the use site, where a reader of the grammar can see which list the
    // missing closer costs them — the same reason `x{#cap}` names its bound.
    onfail_cap: string,
    bound: string,
}

/// The failure POLICIES `@onfail(p)` may name — the single source of truth shared by
/// seed_parser's validation, emit and the executor, so a policy cannot be spelled in
/// the grammar that only one engine understands. See `GItem.onfail`.
/// The body of ONE emitted rule fn, sliced out of a generated parser source by its
/// `fn parse_<rule>(st: PState) -> CapVal` header. Empty when the header is absent.
///
/// Exists because every structural assertion over emitted source needs it and NONE of
/// them can be trusted without it: `index_of`/`contains` search the whole file, and the
/// emitter renders byte-identical scaffolding (`mut s_cut = false`,
/// `st.store.truncate_to_mark(s_mark)`, `run_hand_stmt("decl_hand"`) into dozens of
/// rules. A file-wide check therefore passes off some OTHER rule's copy and cannot fail
/// for the rule it names — the vacuity class these guards exist to prevent. One shared
/// slicer so the tests cannot each re-derive it slightly differently.
export fn emitted_rule_body(src: string, head: string) -> string {
    let at = src.index_of(head)
    if at < 0 { return "" }
    let rest = src.substring(at, src.length)
    let end = rest.index_of("\n}\n")
    if end > 0 { rest.substring(0, end) } else { rest }
}

/// True iff the emitted rule named by `head` carries the `@try` scaffolding — a commit
/// flag, a node-store truncate, and a cursor/diagnostic rollback — within ITS OWN body.
export fn emitted_rule_speculates(src: string, head: string) -> bool {
    let rule = emitted_rule_body(src, head)
    rule.contains("mut s_cut = false") &&
        rule.contains("st.store.truncate_to_mark(s_mark)") &&
        rule.contains("st.restore_to(s_pos, s_diags, s_err)")
}

export fn onfail_policy_supported(p: string) -> bool {
    p == "skip" || p == "close" || p == "drop" || p == "discard" || p == "bail" || p == "halt" || p == "abort"
}

/// True for the policies that NAME a capture — `@onfail(discard, <label>)`. One list
/// so the parser, its validation and the error text cannot disagree about which
/// policies take an argument.
export fn onfail_policy_takes_capture(p: string) -> bool {
    p == "discard"
}

/// Repetition suffix on a primary: none / `*` / `+` / `?`.
export enum GRep { One, Star, Plus, Opt }

/// A primary — the atom a postfix wraps.
export enum GPrim {
    /// A nonterminal reference — recurse into that rule.
    Ref(name: string)
    /// A literal terminal — exact source text (`"+"`, `"true"`).
    Lit(text: string)
    /// A named terminal from the lexer (`NUMBER`, `STRING`, `IDENT`).
    Named(tok: string)
    /// `( … )` — a parenthesised group, itself an alternation.
    Group(inner: GNode)
    /// `@when(flag)` — a zero-width SEMANTIC PREDICATE (t-47hc.3). Consumes
    /// no token; it GATES its branch on a parse MODE flag (`allow_struct_lit`,
    /// `allow_dot_postfix`, `allow_it_sugar`, `cell_mode`), read from the live
    /// `ExprModes` the executor already threads through `PState`. This is how a
    /// grammar rule expresses the context-sensitivity the hand parser does with
    /// a mode flag — e.g. `if Foo { … }`: inside a control-header the `{` is the
    /// body, so a struct-literal alternative is gated `@when(allow_struct_lit)`.
    /// Predicates AND (all must hold) where FIRST-token alternatives OR; a
    /// leading `@when` is nullable (it never contributes a FIRST token).
    Pred(mode: string)
    /// `@peek(cond)` — a zero-width LOOKAHEAD SEMANTIC PREDICATE (t-47hc paren prep).
    /// The token-stream sibling of `@when`: same zero-width / nullable / AND-gating /
    /// no-repetition shape, but instead of reading an `ExprModes` flag it inspects the
    /// upcoming TOKENS. This is how a grammar expresses the hand parser's fixed-lookahead
    /// disambiguations — e.g. `parse_paren_expr`'s `peek_after_ident_is_colon()`, which
    /// distinguishes a typed lambda `(x: int) -> …` from a grouping/tuple by peeking past
    /// the first IDENT for a `:`. `cond` names the lookahead check (validated against
    /// seed_parser.peek_cond_supported; executor.lookahead_ok maps it to a token test).
    Peek(cond: string)
    /// `@gensym(tag)` — a zero-width GENERATOR. Consumes no token and gates nothing;
    /// it MINTS a fresh name (`__<tag>_<n>` from the PState counter) and binds it to
    /// this item's label, for a rule that DESUGARS rather than merely parses.
    ///
    /// `if let v = x { … }` is the case that forced it: the hand lowers it to a temp
    /// binding, a none-check condition, and an unwrap-bind row prepended to the
    /// then-block, and the temp's name comes from `self.fresh("iflet")`. A `-> build`
    /// cannot mint it, because a build fires AFTER its whole sequence has parsed —
    /// so a NESTED `if let` inside the subject or then-block would take a lower
    /// number than its parent, inverting the hand's outer-first order. Minting at a
    /// POSITION is the only way to reproduce that ordering, which is why this is a
    /// primary rather than a build helper.
    ///
    /// It binds a `CapVal.Tok` carrying a synthetic token, so it reuses the ordinary
    /// `tok` capture kind end to end — no new CapVal variant, no new `rule_kind_v`
    /// entry, and `capval_tok_text` reads it like any other captured name. A wrong
    /// capture kind is the silent-corruption failure mode #1075 documented, so the
    /// cheapest thing here is to add no kind at all.
    Gensym(tag: string)
    /// `@rawbrace(tag)` — a RAW BALANCED-BRACE CAPTURE (t-47hc.31). Consumes every
    /// token from the current position up to (not including) the `}` that balances an
    /// already-consumed `{`, and binds the verbatim SOURCE SLICE between them,
    /// trimmed — the grammar-DSL spelling of the hand parser's
    /// `capture_balanced_brace_body`. The canonical consumer is a feature block whose
    /// body is NOT Avra syntax and is handed to a runtime engine as a string:
    ///
    ///   grammar_expr = "grammar" "{" body:@rawbrace(grammar) "}" -> MkGrammarBlock(body)
    ///
    /// Depth counting is TOKEN-level (`Tk.LeftBrace`/`Tk.RightBrace`), exactly like
    /// the hand's — a `{` inside a string or template literal is part of that one
    /// token and never miscounts the depth. The cursor is left AT the balancing `}`
    /// so the rule's own trailing `"}"` literal consumes it, keeping the close brace
    /// (and its diagnostics) in the grammar where a reviewer can see it.
    ///
    /// `tag` names the construct in the unterminated-EOF diagnostic ("unterminated
    /// `<tag> { }` block — …"), matching the hand's per-construct message. It is a bare
    /// NAME like every other marker argument (no escaping question).
    ///
    /// Like `@gensym`, it binds a synthetic `CapVal.Tok` (text = the captured slice),
    /// reusing the ordinary `tok` capture kind end to end — no new CapVal variant, no
    /// new `rule_kind_v` entry. Both engines lower to the ONE shared
    /// `rawbrace_scan` (executor.av), so the scan cannot drift between them.
    RawBrace(tag: string)
}

/// The `-> …` build that constructs the result from captures.
///   None       — pass-through of the single sub-result (`a = b`).
///   Var(name)  — return a named capture (`-> e`).
///   Call(n,as) — construct a node / call a fixed helper: `-> Unary(op,
///                operand)`, `-> fold_binary(l, op, r)`. The executor
///                dispatches on `name` (helper vocabulary vs node ctor).
export enum GBuild {
    None
    Var(name: string)
    Call(name: string, args: List<string>)
}

/// Error annotations lifted from Nystrom's by-hand `synchronize()` into
/// the grammar (GRAMMAR_DSL.md §1). `@expect(tok, msg)` asserts the
/// next token or reports `msg`; `@recover(sync_to: tok)` marks a
/// panic-mode synchronize target.
export enum GAnnot {
    /// `@expect(tok, msg)` — the message a missing `tok` reports, and optionally the
    /// F-CODE it reports under (`@expect(tok, msg, F0010)`).
    ///
    /// The code is on the ANNOTATION rather than the rule because that is the grain the
    /// message already has: one rule's positions can want different codes (`if cond expr`
    /// is F0010 `ExpectedBlock` while the same rule's other closers are plain F0001), and
    /// a rule-wide code would have to pick one. Empty means UNCODED — every existing
    /// `@expect` — which the seam already handles as `set_error`, so widening the variant
    /// changes nothing that does not opt in.
    Expect(tok: string, msg: string, code: string)
    Recover(sync_to: string)
}

// ── Small constructors / probes (keep call sites readable) ──


/// True when a sequence has no explicit build — the executor then
/// applies the default build (pass-through of the single sub-result, or
/// a literal from a lone terminal). See executor.av `default_build`.
export fn gbuild_is_none(b: GBuild) -> bool {
    match b {
        .None -> true
        _ -> false
    }
}

/// True for the collecting repetitions (`*` / `+`) — captures inside
/// them accumulate into parallel lists rather than binding a scalar.
export fn grep_is_multi(r: GRep) -> bool {
    match r {
        .Star or .Plus -> true
        _ -> false
    }
}

// ── The UNGUARDED-TAIL predicate (t-zrn3) ────────────────────────────────────
//
// SHARED between the two engines, and that sharing is the point. An alternation's
// LAST branch takes the UNGUARDED TAIL role when it is a bare ref to a rule that owns
// its own recovery, an `@fallback`, or a leading-`@hand`. The tail runs on a token NO
// branch's FIRST matched — which is how a stray top-level token (`then`, `)`, `* 5`)
// reaches the hand parser's F0040 recovery instead of the alternation's generic F0001.
//
// emit_dispatch has always honoured the tail; exec_node did NOT, so the interpreter
// answered F0001 where the hand parser and the generated parser both answered F0040 —
// and because the production path re-parses a failed item with the interpreter, the
// interpreter's answer is what shipped. Both engines now read THIS predicate, so they
// cannot drift: #1061 had already fixed a tail-role bug on the emit side alone, which
// is exactly the kind of one-sided fix a shared predicate prevents.
//
// Lives in ast.av rather than emit.av because emit.av is deliberately OUT of the
// production compiler graph (only the regenerator imports it) while executor.av is on
// it — so the shared home has to be the AST module both already depend on.

fn str_list_has(xs: List<string>, s: string) -> bool {
    for x in xs {
        if x == s { return true }
    }
    false
}

/// True for a One repetition.
export fn grep_is_one(r: GRep) -> bool { match r { .One -> true  _ -> false } }

/// True for a `+` repetition.
export fn grep_is_plus(r: GRep) -> bool { match r { .Plus -> true  _ -> false } }

/// True for a nonterminal-reference primary.
export fn gprim_is_ref(p: GPrim) -> bool { match p { .Ref(_) -> true  _ -> false } }

/// The referenced rule name of a `.Ref` primary (else "").
export fn gprim_ref_name(p: GPrim) -> string { match p { .Ref(n) -> n  _ -> "" } }

/// Index of a branch's single VALUE item, skipping zero-width GATES (`@peek`/`@when`
/// consume nothing, so `@peek(c) ref` is still a lone ref — just guarded). -1 when the
/// branch carries none or more than one value item.
export fn seq_lone_item_index(seq: GSeq) -> int {
    mut idx = 0 - 1
    mut i = 0
    for it in seq.items {
        match it.prim {
            .Peek(_) -> {}
            .Pred(_) -> {}
            _ -> {
                if idx >= 0 { return 0 - 1 }
                idx = i
            }
        }
        i = i + 1
    }
    idx
}

/// True for `| otherrule` — a lone One nonterminal branch with no build.
export fn seq_is_bare_ref(seq: GSeq) -> bool {
    let i = seq_lone_item_index(seq)
    i >= 0 && grep_is_one(seq.items[i].rep) &&
        gprim_is_ref(seq.items[i].prim) && gbuild_is_none(seq.build)
}

/// True when rule `name` reports its OWN diagnostics on an unmatched token, so it is
/// safe as an unguarded tail. External refs (not a rule in THIS grammar) count — the
/// separately-generated delegate reports for itself. A multi-branch dispatch always
/// counts (it ends in an error node or a self-validating catch-all). A single sequence
/// counts iff its LEADING primary does: `@hand` (the delegate reports) or another
/// self-validating rule; a leading TERMINAL does not.
export fn rule_owns_recovery(g: Grammar, name: string, visited: List<string>) -> bool {
    if str_list_has(visited, name) { return false }
    mut v2: List<string> = []
    for x in visited { v2.push(x) }
    v2.push(name)
    let idx = rule_index_of(g, name)
    if idx < 0 { return true }
    match g.rules[idx].body {
        .Alt(branches) -> {
            if branches.length == 0 { return false }
            if branches.length > 1 { return true }
            if branches[0].items.length == 0 { return false }
            prim_owns_recovery(g, branches[0].items[0].prim, v2)
        }
    }
}

fn prim_owns_recovery(g: Grammar, prim: GPrim, visited: List<string>) -> bool {
    match prim {
        .Ref(nm) -> rule_owns_recovery(g, nm, visited)
        .Group(inner) -> match inner {
            .Alt(brs) -> {
                if brs.length == 0 { return false }
                if brs.length > 1 { return true }
                if brs[0].items.length == 0 { return false }
                prim_owns_recovery(g, brs[0].items[0].prim, visited)
            }
        }
        _ -> false
    }
}

/// True when this alternation's LAST branch takes the UNGUARDED TAIL role. A
/// speculative (`@try`) last branch never does — it can roll back, so there would be
/// nothing to fall into.
export fn dispatch_has_tail(g: Grammar, branches: List<GSeq>) -> bool {
    if branches.length == 0 { return false }
    let b = branches[branches.length - 1]
    if b.speculative { return false }
    if seq_is_bare_ref(b) { return rule_owns_recovery(g, gprim_ref_name(b.items[seq_lone_item_index(b)].prim), []) }
    b.fallback
}


// ── grammar RESULT-KIND inference (moved from emit.av, t-47hc.5) ──
// Shared ground: the executor needs the same "is this a statement list?" answer
// emit uses to pick its recovery loop, and emit.av is deliberately unreachable from
// executor.av (production). One copy here keeps the engines in lockstep instead of a
// name-matching heuristic in the interpreter.

export fn rule_result_kind(g: Grammar, name: string) -> string {
    rule_kind_v(g, name, [])
}

export fn rule_kind_v(g: Grammar, name: string, visited: List<string>) -> string {
    if str_in(visited, name) { return "expr" }
    let r = emit_lookup_rule(g, name)
    // Dispatch-only family grammars intentionally leave cross-family refs
    // external so generated files call one another instead of re-emitting
    // duplicate rules. Preserve the external rule's typed capture when it is
    // repeated (expression block -> statement*) rather than defaulting its
    // accumulator to ExprId.
    if r.name == "" {
        if name == "statement" || name == "declaration" { return "stmt" }
        // The shared match-ARM fragment, external in the expression view (t-47hc.25).
        // Without these the accumulator defaults to ExprId and the generated parser
        // coerces arms with capval_to_expr — which does not even compile
        // (`CapVal.WArms` wants List<WhenArm>), but a kind mismatch that DID compile
        // would be a silent tree corruption, so declare them beside their FIRSTs.
        if name == "match_arm" { return "arm" }
        if name == "match_when_arm" { return "warm" }
        // The PATTERN family, external in every dispatch view (t-47hc.29). The match-table
        // flip is the first rule to REPEAT a pattern capture (`( p:pattern … )*`), and
        // without this its accumulator declares `List<ExprId>` and coerces each row's
        // pattern through `capval_to_expr` — the exact failure this block was written for.
        // A scalar `p:pattern_or` (match_arm) never noticed because the builder coerces at
        // the use-site; both are declared here so the next repeat cannot re-open the trap.
        if name == "pattern" || name == "pattern_or" { return "pat" }
        // The GENERIC type parameter, external in the declaration view (t-47hc slice
        // 10.9). Without this a repeated `tparams:tparam` capture declares
        // `List<ExprId>` and coerces each entry through `capval_to_expr` — caught the
        // moment `declaration` first named a native decl rule, and the same trap the
        // `pattern` and `match_arm` entries above were written for.
        if name == "tparam" { return "tparam" }
        // The TYPE family, external in the expression view. `f<T, U>(args)` (t-47hc.33
        // form 8) is the first rule to REPEAT a type capture (`( ta:type_expr … )*`), and
        // without this its accumulator declares `List<ExprId>` and coerces each type
        // argument through `capval_to_expr` — the identical trap the `pattern`, `tparam`
        // and `match_arm` entries above were written for. The scalar `elem:type_expr`
        // (channel_expr) never noticed, for the same reason the scalar `p:pattern_or`
        // did not: its builder coerces at the use-site, via capval_to_texpr.
        if name == "type_expr" { return "type" }
        // The PARAMETER, external in the declaration view (t-47hc slice 10.13 — routing
        // `fn` / `extern` / `trait` / `impl`). `param` is defined in the EXPRESSION view
        // (paren_expr's typed lambda) and shared rather than duplicated, so the four
        // parameter lists cross the boundary. Without this the accumulator declares
        // `List<ExprId>` and coerces each entry through `capval_to_expr`, which the
        // builders reject as a layout conflict — the same trap as `tparam` above, one
        // rule over. Declared BESIDE its FIRST in rule_first_guard; a cross-view
        // reference always needs both.
        if name == "param" { return "pentry" }
        return "expr"
    }
    mut v2: List<string> = []
    for x in visited { v2.push(x) }
    v2.push(name)
    node_kind(g, r.body, v2)
}

export fn node_kind(g: Grammar, node: GNode, visited: List<string>) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                let k = seq_kind(g, b, visited)
                if k != "" { return k }
            }
            "expr"
        }
    }
}

export fn seq_kind(g: Grammar, seq: GSeq, visited: List<string>) -> string {
    match seq.build {
        .Call(bn, bargs) -> build_kind_with(g.builder_kinds, bn, bargs.length)
        // A PASSTHROUGH build (`-> n`) has the kind of whatever `n` captured. Left
        // unresolved this defaults the rule to "expr", and the mistyping CASCADES:
        // `use_decl = "use" ut:use_tail -> ut` made `declaration` non-statement, which
        // turned `stmts:declaration*` in `stmt_block` into the emit bailout
        // `labeled bare-ref over a non-statement rule is unsupported`. Resolving only
        // the case that is decidable here — the label names a rule REF or a @hand leaf
        // — leaves every existing Var build (whose captures are terminal alternations,
        // e.g. `null_cell`) returning "" exactly as before, so no emitted output moves.
        .Var(vn) -> {
            mut k = ""
            for it in seq.items {
                if it.label == vn && k == "" {
                    match it.prim {
                        .Ref(rn) -> k = rule_kind_v(g, rn, visited)
                        _ -> {}
                    }
                }
            }
            k
        }
        .None -> {
            // Zero-width PREDICATES (`@peek` / `@when`) carry no capture and cannot
            // change what a rule yields, so they are skipped when looking for the
            // single significant item. Counting them made a gated passthrough like
            // the then-shape of `comp_block_item` (`@peek(cond) declaration`) fall
            // through to "expr", which then turned `body:comp_block_item*` into the
            // `labeled bare-ref over a non-statement rule is unsupported` bailout —
            // the same mistyping CASCADE the `.Var` arm above documents, reached by
            // a different route. `is_passthrough` needed the SAME skip for the same
            // shape and did not get it until t-47hc.5.1 B2b; see its WHY.
            mut sig: List<GItem> = []
            for gi in seq.items {
                if !prim_is_pred_e(gi.prim) { sig.push(gi) }
            }
            if sig.length == 1 && rep_is_one(sig[0].rep) {
                match sig[0].prim {
                    .Ref(rn) -> rule_kind_v(g, rn, visited)
                    _ -> "expr"
                }
            } else { "" }
        }
    }
}

/// The engine's central build-name → result-kind rows, EXACT: "" means the
/// engine does not know this name. The builder-manifest validation
/// (features/lang.av) needs the exact answer; `build_kind` below keeps the
/// historical lenient "expr" default for the grammar-analysis callers.
/// The engine's result-kind vocabulary — the RANGE of `central_build_kind`
/// below (kept adjacent so a new kind lands in both). Builder-manifest
/// validation rejects a declared kind outside this set.
export fn engine_build_kinds() -> List<string> {
    ["expr", "stmt", "arm", "warm", "sarm", "pat", "type", "tok", "toks",
     "pentry", "tparam", "field", "variant", "finit", "ccfg", "cpair",
     "cslot", "ccfgs", "cslots", "ann"]
}

/// t-kd4y.3.1 — the PURITY LEDGER. Every name the central tables know is
/// classified by ONE question: does a user's program SPELL the syntax this
/// build lowers? Spelled -> it belongs to a FEATURE and sits on the
/// unflipped list until its family PR moves it out of the engine. Never
/// spelled — the build exists only inside the grammar engine's execution —
/// -> engine-core, documented per name below. `diagnose.sh
/// --check-central-domain` (spec: central_domain_lint_test) enforces
/// totality and exactness: central == engine-core ∪ unflipped, lists
/// disjoint, no stale entries. A family flip deletes its names from
/// `unflipped_builds` in the same diff; that list reaching [] IS the old
/// system fully deleted (t-kd4y.3.6).
export fn engine_core_builds() -> List<string> {
    // fold_binary / fold_postfix — the DSL's own fold semantics: a rule's
    //   repetition-fold and the postfix-chain fold execute THROUGH these,
    //   like `*` or `@try`. The operator/suffix rules riding them are
    //   feature content (t-kd4y.3.5.7/.8); the folds are the machine.
    // Block / ExprStmt — how the DSL lowers a `{ stmt* }` capture and a
    //   bare-expression statement: the glue between any feature's body and
    //   the statement list. No syntax of their own.
    // MkPrimaryFail — the error-recovery node emitted where NO rule
    //   matched; it exists precisely where no feature applies.
    // MkStampAt — SrcPos-stamp plumbing invoked by wrapper rules; writes a
    //   side-table row, builds nothing a user spells. (Tableless: exec/emit
    //   arms only, no kind row — see central_tableless_builds.)
    // MkNone — the absent-optional-capture marshalling value. (Tableless.)
    ["fold_binary", "fold_postfix", "Block", "ExprStmt", "MkPrimaryFail",
     "MkStampAt", "MkNone"]
}

/// Every FEATURE-OWNED central build, grouped by the family ticket that
/// deletes it. The order is the ticket order; a flip PR removes its group
/// and the domain lint keeps the remainder exact.
export fn unflipped_builds() -> List<string> {
    [
     // t-kd4y.3.2.1 if-let (if_stmt)
     "MkIfLet", "MkIfLetStmt",
     // t-kd4y.3.2.2 for completion (for_stmt)
     "MkForDestructure", "MkForBinding",
     // t-kd4y.3.2.3 let family (let/mut/const/destructure)
     "MkLetBinding", "MkMutBinding", "MkConstBinding", "MkDestructure",
     "MkLet", "MkMut", "MkConst",
     // t-kd4y.3.2.4 select + parallel
     "MkSelect", "MkSelectArm", "MkParallel",
     // t-kd4y.3.2.5 spec/given/then
     "MkSpecBlock", "MkGivenBlock", "MkThenBlock",
     // t-kd4y.3.2.6 patterns (match's pat fragment)
     "OrMaybe", "IdentPat", "MkVariant", "PatBool", "PatStr", "PatNum",
     "PatNegNum", "OptPresent", "OptAbsent",
     // t-kd4y.3.3.1 fn + extern decls (+ param plumbing)
     "MkFnDecl", "MkExtern", "MkParam", "MkTypeParam", "MkWhereParam",
     // t-kd4y.3.3.2 type + shape decls (+ field rows)
     "MkTypeDecl", "MkTypeDeclAny", "MkShapeDecl", "MkField", "MkTypeAlias",
     "MkTypeRHS",
     // t-kd4y.3.3.4 impl decls. `MkAssocTypeDef` is grouped here, not with
     // the trait rows it was filed under: `impl_assoc` (features/impl_decl)
     // is the rule that references it, and a feature may only supply a
     // builder its OWN gram references (builder_validation_error's orphan
     // contract). Ownership follows the referencing rule, never the name.
     "MkImpl", "MkMethod", "MkMethodShorthand", "MkAssocTypeDef",
     // t-kd4y.3.3.5 component decls. `MkTraitList` is grouped here for the
     // same reason: its one reference is `comp_implements` — the component
     // header's `implements A, B` clause — so it flips with component.
     "MkComponentDef", "MkComponentParenDef", "MkComponentBlock",
     "MkRawComponentBlock", "MkCompField", "MkCompBodyMarker",
     "MkCompConfig", "MkCompConfigPair", "MkCompConfigList",
     "MkChildrenSlot", "MkChildrenSlotList", "MkTraitList",
     // t-kd4y.3.4 quote + splices
     "MkQuote", "MkQuoteType", "MkQuoteArm", "MkSplice", "MkSpliceStruct",
     "MkSpliceArm", "MkSpliceName", "MkSpliceType", "MkPlainName",
     // t-kd4y.3.5.1 concurrency primaries
     "MkSpawn", "MkIsolated", "MkChannel",
     // t-kd4y.3.5.2 when/match/if expression forms
     "MkWhen", "MkMatchExpr", "MkIfExpr",
     // t-kd4y.3.5.3 paren family (closures/tuple)
     "MkTuple", "MkLambda", "MkLambdaTyped", "MkGroupOrEmpty", "MkTupleFR",
     "Grouping",
     // t-kd4y.3.5.4 collections
     "MkListLit", "MkListComp", "MkMapLit",
     // t-kd4y.3.5.5 tables
     "MkTableLit", "MkTableHeader", "MkTableRow",
     // t-kd4y.3.5.6 ident-led + struct/with + enum-ctor + block-expr
     "MkStructLit", "MkWithSuffix", "MkGrammarBlock", "MkTaggedTemplate",
     "MkQualExpr", "mk_enum_ctor", "MkEnumCtorSuffix", "MkFieldInit",
     "MkExprBlock",
     // t-kd4y.3.5.7 operator families
     "fold_logical", "fold_nullish", "fold_pipe", "fold_with",
     "fold_postfix_with", "mk_assign", "rebind_eq", "mk_eqchain", "mk_is",
     "mk_inlist", "mk_inrange", "Unary",
     // t-kd4y.3.5.8 postfix/call families
     "field_suffix", "index_suffix", "call_suffix", "MkCallSuffix",
     "MkIndexSuffix", "MkGenericCallSuffix", "MkCallArg", "MkFieldAccess",
     "MkTupleIndex", "MkOptChain", "MkOptMethodCall", "MkForceUnwrap",
     "MkTrySuffix", "MkCatchSuffix",
     // t-kd4y.3.5.9 templates + decl wrappers
     "MkTemplate", "MkAnn", "MkAnnotatedArgs", "MkAnnotated", "MkExport",
     "MkDocAnnotated", "MkModuleDoc",
     // t-kd4y.3.5.10 type expressions
     "TyUnion", "TyDyn", "TyList", "TyParen", "MkFn", "MkNamed",
     "MkQualified"
    ]
}

/// Names with executor/emit arms but NO `central_build_kind` row — their
/// kind flows through the lenient analysis default. They classify in the
/// ledger like every other central name; the domain lint expects exactly
/// this set to be ledgered-but-tableless.
export fn central_tableless_builds() -> List<string> {
    ["MkAnnotated", "MkConst", "MkGroupOrEmpty", "MkLet", "MkMut", "MkNone",
     "MkStampAt", "MkTupleFR", "MkTypeAlias", "MkTypeRHS"]
}

export fn central_build_kind(bn: string) -> string {
    match bn {
        "fold_binary" or "fold_logical" or "fold_nullish" or "fold_pipe" or "fold_with"
            or "fold_postfix_with" or "fold_postfix" or "mk_assign" or "rebind_eq" or "mk_is"
            or "mk_inlist" or "mk_inrange" or "mk_enum_ctor" or "mk_eqchain" or "MkListLit"
            or "MkListComp" or "MkChannel" or "MkWhen" or "MkMatchExpr" or "MkIfExpr"
            or "MkIfLet" or "MkQuote" or "MkQuoteType" or "MkQuoteArm" or "MkExprBlock"
            or "MkSpawn" or "MkIsolated" or "MkTuple" or "MkLambda" or "MkLambdaTyped"
            or "Unary" or "Grouping" or "field_suffix" or "index_suffix" or "call_suffix"
            or "MkWithSuffix" or "MkMapLit" or "MkSplice" or "MkSpliceStruct" or "MkQualExpr"
            or "MkTemplate" or "MkTrySuffix" or "MkCatchSuffix" or "MkOptChain" or "MkTupleIndex"
            or "MkFieldAccess" or "MkIndexSuffix" or "MkCallSuffix" or "MkGenericCallSuffix"
            or "MkEnumCtorSuffix" or "MkOptMethodCall" or "MkForceUnwrap" or "MkCallArg" or "MkStructLit"
            or "MkGrammarBlock" or "MkTaggedTemplate" or "MkTableHeader" or "MkTableRow" or "MkTableLit"
            or "MkPrimaryFail" -> "expr"
        "ExprStmt" or "Block"
            or "MkForDestructure"
            or "MkIfLetStmt" -> "stmt"
        // `MkSpliceArm` yields an arm too (t-47hc.4.3). Without this the alternation's kind
        // is inferred from the OTHER branch alone in some orders and from this one in others,
        // and a `( arms:match_arm )*` accumulator silently declares `List<ExprId>` — the
        // capval_to_expr default. That is the same silent tree-corruption trap the annotation
        // accumulator was written for; here it surfaces as a hard F1000 layout conflict.
        "MkSpliceArm" -> "arm"
        // The destructure-loop binding carrier (a packed token list: gensym
        // temp + user names — see mk_for_binding). The row was MISSING while
        // the for rules were spine-composed: no validator ran against that
        // fragment, and the lenient analysis default ("expr") was never
        // consulted for the fb capture. The for_lang flip routes the gram
        // through register_lang's exact validation, which requires every
        // referenced engine build to classify — so the engine's own table
        // now states what the build always was.
        "MkForBinding" -> "toks"
        "MkFieldInit" -> "finit"
        "MkSelectArm" -> "sarm"
        "MkCompConfig" -> "ccfg"
        "MkCompConfigPair" -> "cpair"
        "MkChildrenSlot" -> "cslot"
        // Declaration builds (whole-program grammar, ps3t.6.5.11) — all Stmt-target
        // except the component CapVals (MkParam → PEntry, MkField → Field).
        "MkFnDecl" or "MkExtern" or "MkShapeDecl" or "MkExport" or "MkTypeDecl"
            or "MkTypeDeclAny" or "MkImpl"
            or "MkAssocTypeDef"
            or "MkMethod" or "MkAnnotatedArgs" or "MkDocAnnotated" or "MkModuleDoc"
            or "MkLetBinding" or "MkMutBinding" or "MkConstBinding" or "MkDestructure" or "MkParallel"
            or "MkSelect" or "MkSpecBlock" or "MkGivenBlock" or "MkThenBlock" or "MkComponentDef"
            or "MkComponentParenDef" or "MkComponentBlock" or "MkRawComponentBlock" or "MkMethodShorthand" or "MkCompField" -> "stmt"
        "MkAnn" -> "ann"
        "MkParam" -> "pentry"
        // `MkWhereParam` yields the SAME TypeParamEntry a `tparam` does — a where entry is
        // a type parameter that names its bounds after the parameter list instead of inside
        // it — so it must classify identically or the accumulator's element coercion drifts.
        // `MkSpliceName` yields a TOKEN — the hand encodes a name-slot splice as the ordinary
        // name string with a `~` prefix, so it must classify as `tok` and flow through
        // `capval_tok_text` exactly as a bare IDENT does.
        // A splice in TYPE position yields a TypeExpr, not a token — it is `named_type`'s
        // sibling atom, not a name-slot splice (t-47hc.4.3).
        "MkSpliceType" -> "type"
        "MkSpliceName" or "MkPlainName" -> "tok"
        "MkTraitList" -> "toks"
        "MkCompBodyMarker" -> "tok"
        "MkCompConfigList" -> "ccfgs"
        "MkChildrenSlotList" -> "cslots"
        "MkTypeParam" or "MkWhereParam" -> "tparam"
        "MkField" -> "field"
        "OrMaybe" or "IdentPat" or "MkVariant" or "PatBool" or "PatStr"
            or "PatNum" or "PatNegNum" or "OptPresent" or "OptAbsent" -> "pat"
        "TyUnion" or "MkFn" or "TyDyn" or "TyList" or "TyParen"
            or "MkNamed" or "MkQualified" -> "type"
        _ -> ""
    }
}

/// Result-kind classification with the historical default: a name neither
/// the central rows nor the supplied manifest rows list classifies as
/// "expr". Grammar analysis (accumulator typing, alternation kind
/// inference) keeps this leniency; exact membership questions go to
/// `central_build_kind`, manifest validation to features/lang.av.
export fn build_kind_with(rows: List<BuildKindRow>, bn: string, arity: int) -> string {
    let k = central_build_kind(bn)
    if k != "" { return k }
    let r = manifest_row(rows, bn, arity)
    if r != null { return r!.kind }
    "expr"
}

/// THE manifest lookup. (name, arity) is the dispatch key everywhere — the
/// executor consult, emit_call_build, span capture, kind analysis, and
/// fold_builders' dedup — and every consult resolves through here, so the
/// key exists in exactly one place. A name may carry rows at several arities
/// (MkEnumDecl's generic/plain pair was the design case); matching by name
/// alone would answer every call from whichever row folded first.
export fn manifest_row(rows: List<BuildKindRow>, name: string, arity: int) -> BuildKindRow? {
    for r in rows { if r.name == name && r.arity == arity { return r } }
    null
}

/// The manifest-free view — callers with no composed grammar in hand
/// (validation preambles, specs pinning the central table alone).
export fn build_kind(bn: string) -> string {
    let empty: List<BuildKindRow> = []
    build_kind_with(empty, bn, 0)
}

/// True iff the primary is a zero-width predicate (emit side) — `@when(flag)` mode read
/// OR `@peek(cond)` token lookahead. Both emit no per-item body (the guard is folded).
export fn prim_is_pred_e(prim: GPrim) -> bool {
    match prim { .Pred(_) -> true  .Peek(_) -> true  _ -> false }
}

export fn rep_is_one(rep: GRep) -> bool { match rep { .One -> true  _ -> false } }
fn rep_is_star(rep: GRep) -> bool { match rep { .Star -> true  _ -> false } }
fn rep_is_plus(rep: GRep) -> bool { match rep { .Plus -> true  _ -> false } }
fn rep_is_opt(rep: GRep) -> bool { match rep { .Opt -> true  _ -> false } }

fn build_is_none(build: GBuild) -> bool { match build { .None -> true  _ -> false } }

// ── Node-kind of a rule's result (its Nystrom target) — drives the coercion,
// the CapVal wrapper, and the list element type PER referenced rule, so the
// emitter works across Expr / Stmt / Pattern / Type node kinds. Determined
// from the rule's build (apply_build's target), crossing pass-throughs. ──


export fn str_in(xs: List<string>, s: string) -> bool {
    if s == "" { return false }
    for x in xs { if x == s { return true } }
    false
}

export fn emit_lookup_rule(g: Grammar, name: string) -> Rule {
    for r in g.rules {
        if r.name == name { return r }
    }
    Rule { name: "", body: GNode.Alt([]) }
}

// ── @expect lookup + the gated-call FIRST message (SHARED) ──
//
// These live here, not in emit.av, because BOTH engines need them and emit.av is
// deliberately unreachable from executor.av (the production parser). emit renders
// `gated_first_check` from them; the executor's `gated_first_ok` reads the same
// message for the same gated call. Split across the two modules they would drift,
// and a gate-message drift is invisible on VALID input by construction — which is
// the whole reason routing bugs in this area ship green.

/// Is every branch of `name` led by the `IDENT` named terminal? The structural test
/// behind "this position binds a NAME", which is what decides whether a missing token
/// there keeps the hand's RESERVED-KEYWORD diagnostic (so07.2) instead of the rule's
/// generic wording. Shared, because emit's gated FIRST check and the interpreter's twin
/// must make the same call — a position that says "`move` is a reserved keyword" on one
/// engine and "expected parameter name" on the other is a divergence no valid input can
/// reveal.
///
/// Conservative by construction: a rule whose branches disagree, or that leads with
/// anything else, answers false and keeps the plain report.
export fn rule_first_is_ident(g: Grammar, name: string) -> bool {
    let i = rule_index_of(g, name)
    // A CROSS-VIEW rule is not in this grammar at all — `param` is defined in the
    // expression view and called from the declaration view — so there is nothing to
    // inspect and the declared answer is the only one available. Same shape as the
    // declared FIRSTs `rule_first_guard` keeps for exactly these names, and kept HERE
    // rather than beside them so both engines read one list: emit renders a guard
    // string, the interpreter walks tokens, and neither can consult the other's table.
    if i < 0 { return external_rule_first_is_ident(name) }
    match g.rules[i].body {
        .Alt(branches) -> {
            if branches.length == 0 { return false }
            for b in branches {
                if !seq_leads_with_ident(b) { return false }
            }
            true
        }
    }
}

/// The cross-view rules whose FIRST is the bare `IDENT` terminal. One entry today:
/// `param = pname:IDENT ( ":" pt:type_expr )?`, reachable from the declaration view since
/// `fn` / `extern` / `trait` / `impl` routed. Add a name here when a new external rule
/// binds a NAME in its first position — the cost of missing one is only the generic
/// message instead of the reserved-keyword one, never a wrong parse.
fn external_rule_first_is_ident(name: string) -> bool {
    name == "param"
}

fn seq_leads_with_ident(seq: GSeq) -> bool {
    for item in seq.items {
        if prim_is_zero_width(item.prim) { continue }
        match item.prim {
            .Named(tok) -> { return tok == "IDENT" }
            _ -> { return false }
        }
    }
    false
}

export type ExpectHit = { found: bool, msg: string, code: string }

export fn expect_for(annots: List<GAnnot>, tok: string) -> ExpectHit {
    for a in annots {
        match a {
            .Expect(t, m, c) -> {
                if t == tok { return ExpectHit { found: true, msg: m, code: c } }
            }
            _ -> {}
        }
    }
    ExpectHit { found: false, msg: "", code: "" }
}


/// The message a rule uses when its own FIRST token is absent — its first branch's
/// `@expect` for that token's kind. Empty when the rule declares none.
/// One hop of `rule_first_expect_msg` with NO further `.Ref` following — the
/// recursion stopper. Keeps the walk bounded at a single delegation step.
/// A rule-name-keyed `@expect` describes the RULE, not one of its branches, so
/// it is found wherever the author wrote it.
///
/// Reading it off `branches[0]` alone made the message depend on which side of
/// the `|` it happened to sit on. `trait_member = assoc_member | method_member
/// @expect("trait_member", …)` binds the annotation to the LAST branch, so the
/// lookup missed it and `gated_first_check` fell back to printing the GRAMMAR
/// RULE NAME at the user — the exact "expected trait_member" this convention
/// exists to prevent. Scanning every branch is what makes the annotation mean
/// what it reads as.
export fn rule_own_expect_msg(branches: List<GSeq>, name: string) -> string {
    for b in branches {
        let own = expect_for(b.annots, name)
        if own.found { return own.msg }
    }
    ""
}

/// The `@expect` message for a rule DEFINED IN ANOTHER VIEW — the pair of
/// rule_first_guard's declared-FIRST table.
///
/// Such a rule is genuinely absent from this grammar, so its `@expect` cannot be read
/// no matter how the annotation is written: the decl parser calls the separately
/// generated expression parser for these. `param` is the caught instance (its declared
/// FIRST was added by slice 10.13, when routing fn/extern/trait/impl made parameter
/// lists reachable from the decl view) — a gated call on it fell back to the generic
/// "expected param" while `field` and `variant`, which ARE local, resolved correctly.
///
/// ONE table, consulted by BOTH `rule_first_expect_msg` and its `_leaf` twin. It lived
/// only in the former, so a delegation through a leading `.Ref("param")` — the leaf's
/// entire job — dropped the message and printed the grammar rule name at a user. No
/// production rule leads with that ref today, so this is a latent hole rather than a
/// live bug; a second copy of the table would be the durable defect, which is why it
/// moves here instead.
fn cross_view_expect_msg(name: string) -> string {
    if name == "param" { return "expected parameter name" }
    ""
}

export fn rule_first_expect_msg_leaf(g: Grammar, name: string) -> string {
    let r = emit_lookup_rule(g, name)
    if r.name == "" { return cross_view_expect_msg(name) }
    match r.body {
        .Alt(branches) -> {
            if branches.length == 0 { return "" }
            let b = branches[0]
            let own_msg = rule_own_expect_msg(branches, name)
            if own_msg != "" { return own_msg }
            for it in b.items {
                match it.prim {
                    .Named(tok) -> {
                        let e = expect_for(b.annots, tok)
                        if e.found { return e.msg }
                        return ""
                    }
                    .Lit(text) -> {
                        let e = expect_for(b.annots, text)
                        if e.found { return e.msg }
                        return ""
                    }
                    _ -> {}
                }
            }
            ""
        }
    }
}

export fn rule_first_expect_msg(g: Grammar, name: string) -> string {
    let r = emit_lookup_rule(g, name)
    if r.name == "" { return cross_view_expect_msg(name) }
    match r.body {
        .Alt(branches) -> {
            if branches.length == 0 { return "" }
            let b = branches[0]
            // A message keyed on the RULE'S OWN NAME. The token-keyed lookups below can
            // only answer for a rule whose first branch LEADS with a terminal; an
            // ALTERNATION-led rule (`trait_member = assoc_member | method_member`) has
            // no single leading token, so it fell through to `gated_first_check`'s
            // generic fallback and printed a GRAMMAR RULE NAME at the user
            // ("expected trait_member"). Same convention `@require` on a rule reference
            // uses, so one spelling covers both markers.
            let own_msg = rule_own_expect_msg(branches, name)
            if own_msg != "" { return own_msg }
            for it in b.items {
                match it.prim {
                    .Named(tok) -> {
                        let e = expect_for(b.annots, tok)
                        if e.found { return e.msg }
                        return ""
                    }
                    .Lit(text) -> {
                        let e = expect_for(b.annots, text)
                        if e.found { return e.msg }
                        return ""
                    }
                    // Follow ONE leading rule reference, then stop. A branch that begins
                    // by delegating (`x = y …`) has its wording on `y`, and resolving it
                    // is what keeps the derivation general instead of accumulating a
                    // hardcode per rule. Bounded to one hop rather than guarded by a
                    // visited set: a single step cannot cycle, and an unbounded walk
                    // through a left-recursive grammar could.
                    .Ref(inner) -> {
                        if inner == name { return "" }
                        return rule_first_expect_msg_leaf(g, inner)
                    }
                    _ -> {}
                }
            }
            ""
        }
    }
}


/// True when any item DIRECTLY in this node carries the named `@onfail` policy. One level
/// only: a nested group is its own scope, and its policy is that group's business.
///
/// Shared by seed_parser (which validates `close`'s repetition requirement), emit (which
/// wraps a `halt`-bearing optional in a breakable scope) and the executor. A second copy
/// would let the three disagree about which groups a policy governs.
export fn node_has_onfail(node: GNode, policy: string) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.onfail == policy { return true }
                }
            }
            false
        }
    }
}

/// `abort_prop` is the CROSS-RULE abort signal, and it is scoped to grammars that
/// actually have a `@gate` — one emitter renders FOUR checked-in parsers (decl /
/// expr / type / pattern) and only the decl view gates, so an unscoped write would
/// put the flag into all four for no reader. This predicate is that scope, shared:
/// the emitter asks it to decide what to EMIT, the interpreter asks it to decide
/// what to CHECK, and the two must never answer differently about the same grammar.
export fn grammar_has_gate(g: Grammar) -> bool {
    for r in g.rules {
        if rule_body_has_gate(r.body) { return true }
    }
    false
}

/// The recursive form of `node_has_gate`: a gate can sit inside a `( … )*` /
/// `( … )?` group (that is where `enum_decl` and `trait_decl` put theirs), so a
/// top-level-only scan would miss every real one.
export fn rule_body_has_gate(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.gate { return true }
                    match it.prim {
                        .Group(inner) -> { if rule_body_has_gate(inner) { return true } }
                        _ -> {}
                    }
                }
            }
            false
        }
    }
}

export fn gated_ref_of(node: GNode) -> GatedRef {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.gate {
                        match it.prim {
                            .Ref(nm) -> return GatedRef { found: true, rule: nm, onfail: it.onfail, label: it.label }
                            _ -> {}
                        }
                    }
                }
            }
            GatedRef { found: false, rule: "", onfail: "", label: "" }
        }
    }
}


/// Does this rule body COMMIT anywhere — i.e. contain a `@cut`?
///
/// The pair of `speculative` on a dispatcher branch, and the reason both live here:
/// `@try X` where `X` commits internally is INERT. The branch snapshots diagnostics and
/// rolls back the instant the rule reports, so the `@cut` — whose entire purpose is "do
/// not roll back past this point" — is discarded by a wrapper one level up, and the
/// `@hand` gate below answers exactly as it did before.
///
/// That combination is undetectable from behaviour: the emitted parser changes, the
/// rule genuinely commits, and every recovery oracle still agrees, BECAUSE the hand is
/// still the one recovering. It was measured as "corpus unchanged, therefore the commit
/// is clean" when the truth was "corpus unchanged, therefore the commit did nothing"
/// (t-myz7). Recurses into groups — a `@cut` nested in a `( … )` counts, which is where
/// every committed decl rule puts its own.
export fn rule_body_has_cut(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.cut { return true }
                    match it.prim {
                        .Group(inner) -> { if rule_body_has_cut(inner) { return true } }
                        _ -> {}
                    }
                }
            }
            false
        }
    }
}
