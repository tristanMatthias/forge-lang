// WHY: ps3t.6.4 — the grammar-DSL *generator*, in its executable form.
// It lowers a `Grammar` (ast.av, produced by the seed parser) to an
// error-tolerant recursive-descent parser and RUNS it over a token
// stream, producing real `Expr` nodes — the GRAMMAR_DSL.md §8 proof
// ("build the generator … run it, and show it producing real Expr
// nodes"). Each rule executes exactly the RD algorithm its generated
// function would (Nystrom's grammar→RD correspondence, GRAMMAR_DSL.md
// §4): terminal → match/consume, nonterminal → call its rule, `|` →
// first-match by FIRST-set, `*`/`+` → loop, `?` → optional, `->` →
// build the node, `@recover` → panic-mode synchronize. emit.av renders
// the same lowering as parser-fn source (the structural correspondence).
//
// The semantic actions (how a `build` constructs a target node) are the
// one target-specific seam — mirroring the derive engine's pluggable
// emitters. Here they build `Expr` for the expression slice: literals,
// `Unary(op, operand)`, and `fold_binary(l, op, r)` (left-assoc chains).

use core.{lookup_expr_parser, Expr, ExprId, Stmt, StmtId, Pattern, PatId, ParamEntry, TypeParamEntry, FieldEntry, FieldInit, Variant, MatchArm, WhenArm, Annotation, ValueType, TypeExpr, TypeId, type_expr_to_vtype, method_mangled_name, vtype_from_name, pattern_optional_present, pattern_optional_absent, BinOp, UnOp, LogicOp, NodeStore, NodeRef, new_node_store, build_line_index, ByteSpan, byte_span, byte_span_none, SrcPos, Tk, gensym_name, render_type_name_list, FORCE_UNWRAP_FN}
use features.grammar.{Grammar, Rule, GNode, GSeq, GItem, GRep, GPrim, GBuild, GAnnot}
use features.grammar.{Token, lex_real, rule_index_of}
// t-zrn3: the UNGUARDED-TAIL predicate, SHARED with emit_dispatch (see ast.av).
use features.grammar.{dispatch_has_tail}
// The field-name acceptance set, shared with the hand parser (t-47hc.33.1).
use core.{tk_is_field_name}
// The SHARED if-let desugar, also called by the hand's parse_if_let_expression — one
// definition of the rows, so the native rule and the oracle cannot lower differently.
use core.{build_if_let_expr}
use core.{build_let_else_init, stmt_ids_diverge}
use core.{SelectArm}
use core.{CompConfig, ChildrenSlot, register_component_name, register_raw_body_component, component_is_raw_body, body_declares_token_stream, vtype_struct, lookup_stmt_parser}
use features.grammar.{code_at, is_ident_start_code}
// The RAW-SOURCE lookahead cores (t-47hc.5.1 slice B1), SHARED with the hand
// parser's Parser.peek_after_ident_is_* wrappers. The component config-pair
// `@peek` conds below run the IDENTICAL scan over the IDENTICAL bytes rather
// than re-deriving it at token level, which is not equivalent — see the note
// at the cores in chars.av for the four divergences that depends on.
use features.grammar.{word_excluded_as_instance_name, src_next_nonws_is_quote, src_next_nonws_is_digit, src_next_nonws_starts_with, src_next_nonws_is_single_eq, src_next_nonws_is_lbrace, src_next_nonws_is_value_word, src_at_empty_call_block}
use features.grammar.{hand_stmt_leaf, hand_expr_leaf, is_hand_stmt_leaf, is_hand_expr_leaf}
use parse.{parser_new_with_file, parser_new_with_store, Parser, ParserState, desugar_template_store}
use diagnostics.{DiagnosticBag}
use list_ops.{lower_bound}
use features.closures.{expr_contains_it, wrap_in_it_lambda}

extern fn avra_process_env_get(name: string) -> string
extern fn avra_gensym() -> int

// ── Capture values + environment ──

/// The value a grammar construct yields: a matched token, a built node,
/// or (inside a `*`/`+`) a parallel list of either. `Nil` is the empty
/// value of a repetition/optional that produced nothing.
///
/// EXPORTED (ps3t.6.5.11): the generated static parser fns (the emit target)
/// live in their own module and speak this same capture vocabulary.
export enum CapVal {
    Nil
    Tok(t: Token)
    Node(id: ExprId)
    // A built STATEMENT node (the statement-family target seam, ps3t.6.5.2).
    // A rule whose build constructs a Stmt yields this; capval_to_stmt
    // coerces it at the use-site, mirroring capval_to_expr for Node.
    SNode(id: StmtId)
    Toks(ts: List<Token>)
    Nodes(ns: List<ExprId>)
    // A parallel list of built STATEMENT nodes — the block/statement-list
    // capture (ps3t.6.5.3). A `*`/`+` over a statement rule accumulates
    // into this, mirroring `Nodes` for expressions; `capval_to_stmt_list`
    // reads it at a `Block(stmts)` build.
    SNodes(ns: List<StmtId>)
    // A built PATTERN node + a parallel list of them (the pattern-family
    // target seam, ps3t.6.5.5). A rule whose build constructs a Pattern
    // yields `PNode`; a `*`/`+` over a pattern rule (a nested-variant's
    // sub-pattern list) accumulates into `PNodes`. capval_to_pat /
    // capval_to_pat_list coerce at the use-site, mirroring the Expr + Stmt
    // families.
    PNode(id: PatId)
    PNodes(ns: List<PatId>)
    // A built TYPE-EXPRESSION + a parallel list of them (the type-family
    // target seam, ps3t.6.5.6). The hand parser builds a surface `TypeExpr`
    // then lowers it to a `ValueType` via `type_expr_to_vtype`; the DSL
    // mirrors that — builds the SAME `TypeExpr` (carried inline, not arena'd,
    // since TypeExpr is a boxed recursive enum), and run_grammar_type shares
    // the exact same lowering. `TExprs` collects a comma-list (generic args /
    // fn params / tuple elements).
    TExpr(te: TypeExpr)
    TExprs(tes: List<TypeExpr>)
    // A built MATCH ARM + a parallel list of them (statement-`match`,
    // ps3t.6.5.4). An arm composes a pattern (from the pattern family), an
    // optional guard expression, and a body expression; a `*` over the arm
    // rule accumulates `Arms`, which a `Match` build folds into Stmt.Match.
    Arm(a: MatchArm)
    Arms(xs: List<MatchArm>)
    // A built STRUCT FIELD-INIT + a parallel list of them (t-47hc.17). Carried
    // inline like `Arm` (FieldInit is a small record, not an arena node), so a
    // `*` over the field_init rule accumulates `FInits`, which a `MkWithSuffix`
    // build folds into the `Expr.With` overrides list. This is the seam that lets
    // the grammar OWN a `{ name: value, … }` init list — the single gap that kept
    // `with_suffix` (and `brace_expr`'s struct-literal half) behind `@hand`.
    FInit(f: FieldInit)
    FInits(fs: List<FieldInit>)
    // A subjectless `when` arm + repetition list. Unlike MatchArm, WhenArm
    // carries only an optional condition id and a body id; Expr.When is
    // walker-opaque, so these ids deliberately do not become arena edges.
    WArm(a: WhenArm)
    WArms(xs: List<WhenArm>)
    // A `select` arm + repetition list (t-47hc Phase 4), parallel to WArm:
    // binding name + channel expr id + body stmt ids. Stmt.Select is
    // walker-opaque (SelectArm is not a registered container struct), so
    // these ids deliberately do not become arena edges either.
    SArm(a: SelectArm)
    SArms(xs: List<SelectArm>)
    // Component-definition schema entries (t-47hc slice A), parallel to SArm:
    // a `config { key: ty = default }` row and a `children { slot: ty }` row.
    CCfg(c: CompConfig)
    CCfgs(xs: List<CompConfig>)
    CSlot(c: ChildrenSlot)
    CSlots(xs: List<ChildrenSlot>)
    // A component INSTANTIATION config pair (t-47hc.5.1 slice B) — `key value`
    // or `key = expr` inside `component C inst { … }`. Distinct from CCfg: that
    // is the DEFINITION's schema row (`key: ty = default`), this is the
    // instance's supplied value. `value` is a boxed Expr, not an ExprId,
    // because CompConfigPair carries the node inline.
    CPair(p: CompConfigPair)
    CPairs(xs: List<CompConfigPair>)
    // A built PARAMETER ENTRY + a parallel list of them (declaration family,
    // ps3t.6.5.7). A fn parameter is a name + an optional `: type` annotation
    // (defaulting to Int, the hand parser's parse_param_list default); a `*`
    // over the param rule accumulates `PEntries`, folded into Stmt.Function.
    PEntry(p: ParamEntry)
    PEntries(ps: List<ParamEntry>)
    // A built STRUCT FIELD + a parallel list (type/enum declarations,
    // ps3t.6.5.7). A field is `name : type`; a `*` accumulates `Fields`,
    // folded into Stmt.TypeDecl (struct) or a Variant's field list.
    Field(f: FieldEntry)
    Fields(fs: List<FieldEntry>)
    // A built ENUM VARIANT + a parallel list. A variant is a name + an
    // optional `( field, … )` payload; a `*` accumulates `Vars`, folded
    // into Stmt.EnumDecl.
    Var(v: Variant)
    Vars(vs: List<Variant>)
    // A built ANNOTATION (name + arg expression ids) + a parallel list
    // (declaration family, ps3t.6.5.7). `@name(args)` needs the args built —
    // unlike the bare-`@name` MkAnnotated, which captures names as plain Toks.
    // A `( "@" name args? )+` accumulates `Anns`, folded into Stmt.Annotated.
    Ann(a: Annotation)
    Anns(xs: List<Annotation>)
    // A built TYPE PARAMETER (name + optional single trait bound) + a parallel
    // list (declaration generics, ps3t.6.5.7). `<T, U: Bound>` on fn/type/enum
    // is STORED in the decl's type-param list (rendered `<…>`); a `*`/`+` over
    // the tparam rule accumulates `TParams`, folded into the generic decl build.
    TParam(tp: TypeParamEntry)
    TParams(tps: List<TypeParamEntry>)
}

type Cap = { name: string, val: CapVal }

/// The capture environment for ONE rule invocation. Scalar captures bind
/// a single Tok/Node; captures made inside a repetition accumulate into
/// parallel Toks/Nodes lists. Rebuilt on each mutation via `.push`
/// (list index-assignment and payload mutation aren't available), which
/// is cheap — a rule has a handful of captures.
/// `cut` is the live `@cut` commit flag for the rule invocation this env belongs
/// to (exec_rule mints one per call). Set by exec_item when it reaches a cut item,
/// read + reset by exec_node's speculative arm — the interpreter twin of the
/// generated parser's function-local `mut s_cut`.
type CapEnv = { caps: List<Cap>, cut: bool, cut_diags: int, cut_err: bool, abort: bool }

impl CapEnv {
    fn get(self, name: string) -> CapVal {
        for c in self.caps {
            if c.name == name { return c.val }
        }
        CapVal.Nil
    }

    /// Restore the whole capture list (self-ptr mutator, like set_scalar) — the
    /// GAP3 @try-with-builds rollback: reset env.caps to a pre-attempt snapshot so a
    /// rolled-back speculative branch's label bindings don't leak to a sibling.
    fn restore_caps(self, caps: List<Cap>) {
        self.caps = caps
    }

    /// `@cut` commit flag — set by exec_item on reaching a cut item, read + reset
    /// by exec_node's speculative arm. Methods (not direct field writes) because
    /// `env` reaches those call sites as an immutable binding; `self` is by-pointer.
    fn set_cut(self, v: bool) {
        self.cut = v
    }

    /// Record the enclosing speculative branch's entry snapshot — the twin of the
    /// generated parser's `s_diags`/`s_err` locals. A cut fires only while the
    /// branch still matches this (i.e. it has reported nothing yet).
    fn set_cut_frame(self, diags: int, err: bool) {
        self.cut_diags = diags
        self.cut_err = err
    }

    /// `@require` abort flag — raised when a required terminal was missing, checked
    /// by exec_seq after every item so the rest of the sequence is skipped. Shared
    /// across a rule's groups (one CapEnv per rule invocation), so an abort inside a
    /// nested group stops the sequence that encloses it too.
    fn set_abort(self, v: bool) {
        self.abort = v
    }

    fn set_scalar(self, name: string, v: CapVal) {
        mut out: List<Cap> = []
        mut found = false
        for c in self.caps {
            if c.name == name {
                out.push(Cap { name, val: v })
                found = true
            } else {
                out.push(c)
            }
        }
        if !found { out.push(Cap { name, val: v }) }
        self.caps = out
    }

    fn append_tok(self, name: string, t: Token) {
        let existing = self.get(name)
        mut ts: List<Token> = []
        // Promote a prior scalar into the list — the `first ( "," rest )*`
        // comma-list shape reuses one label (first bound scalar, then
        // list-appended); seed the list with the scalar so it isn't lost.
        match existing {
            .Toks(prev) -> {
                for x in prev { ts.push(x) }
            }
            .Tok(prev) -> ts.push(prev)
            _ -> {}
        }
        ts.push(t)
        self.set_scalar(name, CapVal.Toks(ts))
    }

    fn append_node(self, name: string, id: ExprId) {
        let existing = self.get(name)
        mut ns: List<ExprId> = []
        match existing {
            .Nodes(prev) -> {
                for x in prev { ns.push(x) }
            }
            .Node(prev) -> ns.push(prev)
            _ -> {}
        }
        ns.push(id)
        self.set_scalar(name, CapVal.Nodes(ns))
    }

    // Statement-list twin of append_node (ps3t.6.5.3): a `*`/`+` over a
    // statement rule accumulates its built Stmt nodes here. Same
    // scalar→list promotion as append_node, so a `first ( … rest )*`
    // shape over statements reuses one label without losing the first.
    fn append_snode(self, name: string, id: StmtId) {
        let existing = self.get(name)
        mut ns: List<StmtId> = []
        match existing {
            .SNodes(prev) -> {
                for x in prev { ns.push(x) }
            }
            .SNode(prev) -> ns.push(prev)
            _ -> {}
        }
        ns.push(id)
        self.set_scalar(name, CapVal.SNodes(ns))
    }

    // Pattern-list twin of append_node/append_snode (ps3t.6.5.5): a `*`/`+`
    // over a pattern rule (a nested variant's sub-pattern list) accumulates
    // its built Pattern nodes here, with the same scalar→list promotion.
    fn append_pnode(self, name: string, id: PatId) {
        let existing = self.get(name)
        mut ns: List<PatId> = []
        match existing {
            .PNodes(prev) -> {
                for x in prev { ns.push(x) }
            }
            .PNode(prev) -> ns.push(prev)
            _ -> {}
        }
        ns.push(id)
        self.set_scalar(name, CapVal.PNodes(ns))
    }

    // Type-expression-list twin of append_node/append_snode/append_pnode
    // (ps3t.6.5.6): a `*`/`+` over a type rule (generic args, fn params,
    // tuple elements) accumulates its built TypeExprs here.
    fn append_texpr(self, name: string, te: TypeExpr) {
        let existing = self.get(name)
        mut tes: List<TypeExpr> = []
        match existing {
            .TExprs(prev) -> {
                for x in prev { tes.push(x) }
            }
            .TExpr(prev) -> tes.push(prev)
            _ -> {}
        }
        tes.push(te)
        self.set_scalar(name, CapVal.TExprs(tes))
    }

    // Match-arm-list accumulator (statement-`match`, ps3t.6.5.4): a `*` over
    // the arm rule collects each built MatchArm here.
    fn append_arm(self, name: string, a: MatchArm) {
        let existing = self.get(name)
        mut xs: List<MatchArm> = []
        match existing {
            .Arms(prev) -> {
                for x in prev { xs.push(x) }
            }
            .Arm(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(a)
        self.set_scalar(name, CapVal.Arms(xs))
    }

    // Struct field-init accumulator (t-47hc.17), parallel to append_arm: a `*`
    // over the field_init rule collects each built FieldInit here.
    fn append_finit(self, name: string, f: FieldInit) {
        let existing = self.get(name)
        mut xs: List<FieldInit> = []
        match existing {
            .FInits(prev) -> {
                for x in prev { xs.push(x) }
            }
            .FInit(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(f)
        self.set_scalar(name, CapVal.FInits(xs))
    }

    // Subjectless-when-arm accumulator, parallel to append_arm.
    fn append_warm(self, name: string, a: WhenArm) {
        let existing = self.get(name)
        mut xs: List<WhenArm> = []
        match existing {
            .WArms(prev) -> {
                for x in prev { xs.push(x) }
            }
            .WArm(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(a)
        self.set_scalar(name, CapVal.WArms(xs))
    }

    // Select-arm accumulator, parallel to append_warm.
    fn append_sarm(self, name: string, a: SelectArm) {
        let existing = self.get(name)
        mut xs: List<SelectArm> = []
        match existing {
            .SArms(prev) -> {
                for x in prev { xs.push(x) }
            }
            .SArm(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(a)
        self.set_scalar(name, CapVal.SArms(xs))
    }

    // Component config-entry accumulator, parallel to append_sarm.
    fn append_ccfg(self, name: string, c: CompConfig) {
        let existing = self.get(name)
        mut xs: List<CompConfig> = []
        match existing {
            .CCfgs(prev) -> {
                for x in prev { xs.push(x) }
            }
            .CCfg(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(c)
        self.set_scalar(name, CapVal.CCfgs(xs))
    }

    // Component instantiation config-PAIR accumulator, parallel to append_ccfg.
    fn append_cpair(self, name: string, p: CompConfigPair) {
        let existing = self.get(name)
        mut xs: List<CompConfigPair> = []
        match existing {
            .CPairs(prev) -> {
                for x in prev { xs.push(x) }
            }
            .CPair(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(p)
        self.set_scalar(name, CapVal.CPairs(xs))
    }

    // Component children-slot accumulator, parallel to append_sarm.
    fn append_cslot(self, name: string, c: ChildrenSlot) {
        let existing = self.get(name)
        mut xs: List<ChildrenSlot> = []
        match existing {
            .CSlots(prev) -> {
                for x in prev { xs.push(x) }
            }
            .CSlot(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(c)
        self.set_scalar(name, CapVal.CSlots(xs))
    }

    // Parameter-list accumulator (declaration family, ps3t.6.5.7): a `*` over
    // the param rule collects each built ParamEntry here.
    fn append_pentry(self, name: string, p: ParamEntry) {
        let existing = self.get(name)
        mut ps: List<ParamEntry> = []
        match existing {
            .PEntries(prev) -> {
                for x in prev { ps.push(x) }
            }
            .PEntry(prev) -> ps.push(prev)
            _ -> {}
        }
        ps.push(p)
        self.set_scalar(name, CapVal.PEntries(ps))
    }

    // Field-list accumulator (type/enum declarations, ps3t.6.5.7): a `*` over
    // the field rule collects each built FieldEntry here.
    fn append_field(self, name: string, f: FieldEntry) {
        let existing = self.get(name)
        mut fs: List<FieldEntry> = []
        match existing {
            .Fields(prev) -> {
                for x in prev { fs.push(x) }
            }
            .Field(prev) -> fs.push(prev)
            _ -> {}
        }
        fs.push(f)
        self.set_scalar(name, CapVal.Fields(fs))
    }

    // Variant-list accumulator (enum declarations, ps3t.6.5.7): a `*` over the
    // variant rule collects each built Variant here.
    fn append_var(self, name: string, v: Variant) {
        let existing = self.get(name)
        mut vs: List<Variant> = []
        match existing {
            .Vars(prev) -> {
                for x in prev { vs.push(x) }
            }
            .Var(prev) -> vs.push(prev)
            _ -> {}
        }
        vs.push(v)
        self.set_scalar(name, CapVal.Vars(vs))
    }

    // Annotation-list accumulator (@name(args) declarations, ps3t.6.5.7): a `+`
    // over the annotation rule collects each built Annotation here.
    fn append_ann(self, name: string, a: Annotation) {
        let existing = self.get(name)
        mut xs: List<Annotation> = []
        match existing {
            .Anns(prev) -> {
                for x in prev { xs.push(x) }
            }
            .Ann(prev) -> xs.push(prev)
            _ -> {}
        }
        xs.push(a)
        self.set_scalar(name, CapVal.Anns(xs))
    }

    // Type-parameter-list accumulator (declaration generics, ps3t.6.5.7): a
    // `*`/`+` over the tparam rule collects each built TypeParamEntry here.
    fn append_tparam(self, name: string, tp: TypeParamEntry) {
        let existing = self.get(name)
        mut tps: List<TypeParamEntry> = []
        match existing {
            .TParams(prev) -> {
                for x in prev { tps.push(x) }
            }
            .TParam(prev) -> tps.push(prev)
            _ -> {}
        }
        tps.push(tp)
        self.set_scalar(name, CapVal.TParams(tps))
    }
}

// ── Parser state ──

/// The result of running a grammar over source: the store the nodes
/// live in, the root node, and any diagnostics (error-tolerant — a
/// malformed input yields a partial tree + diagnostics, never a bail).
export type RunResult = { store: NodeStore, root: ExprId, had_error: bool, diags: List<string> }

// `src` is the ORIGINAL source text (when known) — carried so a `@hand`
// statement rule can delegate a whole declaration to the real hand parser
// over that source (the token list alone can't reconstruct a raw body /
// char-level lookahead). Empty on the caller-provided-token path (the
// eventual swap-in uses a real Parser for @hand, not this interpreter).
// EXPORTED (ps3t.6.5.11): the generated static parser drives a PState directly.
//
// `modes` (ps3t.6.7 Step B) carries the caller parser's context-sensitive modes
// so an `@hand` expression delegation (run_hand_expr → a fresh hand parser)
// reproduces the ORIGINAL parse: `allow_struct_lit` (a `{` in an if/while/for
// header is a block, not a struct literal), `allow_dot_postfix` (match-arm
// bodies), `allow_it_sugar` (the `it` pronoun), `quote_depth` (a leading `~` is
// splice, not bit-not), `cell_mode` (a leading `+`/`-` on a table-cell's next
// line ends the cell). Every non-expr-flip PState defaults these to a fresh hand
// parser's values, so the already-promoted type/pattern @hand paths are unchanged.
export type ExprModes = { allow_struct_lit: int, allow_dot_postfix: int, allow_it_sugar: int, quote_depth: int, cell_mode: bool }

/// The modes of a freshly-constructed hand parser (parser_new_with_file) — the
/// default for every PState that isn't the expression flip, so run_hand_expr's
/// delegated parser behaves exactly as it does today on those paths.
export fn default_expr_modes() -> ExprModes {
    ExprModes { allow_struct_lit: true, allow_dot_postfix: true, allow_it_sugar: false, quote_depth: 0, cell_mode: false }
}

export type PState = { toks: List<Token>, pos: int, store: NodeStore, src: string, diags: List<string>, had_error: bool, postfix_base: ExprId, postfix_sp_start: int, modes: ExprModes, file: string, gensym_seq: int, postfix_step_base: ExprId, postfix_step_sp: int, hand_delegate: Parser?, tok_edits: List<TokEdit>, table_cols: List<TableCtx> }

/// One in-place token-stream mutation (today: only `split_gt`'s `>>` → `>`),
/// journalled so a rollback can UNDO it. The stream is SHARED — across the
/// static parse, the interpreter fallback re-parse, and the type/pattern flips
/// all running over one per-file lex — so a mutation that survives the parse
/// that made it corrupts every later re-read: a rollback across a split `>>`
/// used to leave a single `>` in the slot, and the re-parse of
/// `List<MemoEntry<V>>` then failed at the `)` with the first `>` simply gone.
export type TokEdit = { idx: int, orig: Token }

/// Full procedural-delegate snapshot for a grammar `@try`. `ParserState.bag`
/// aliases the parser's mutable bag record, so it cannot by itself preserve the
/// pre-branch diagnostics; keep an explicit value-copy of the bag beside it.
export type HandTryState = { parser: ParserState, bag: DiagnosticBag, gensym: int }

/// Postfix-chain accumulator snapshot for a grammar `@try` — see save_postfix_state.
/// Plain ids/offsets, so a value copy IS the snapshot.
export type PostfixTryState = { base: ExprId, sp_start: int, step_base: ExprId, step_sp: int }

impl PState {
    fn cur(self) -> Token { self.toks[self.pos] }

    fn at_end(self) -> bool { self.cur().kind == "EOF" }

    fn advance(self) -> Token {
        let t = self.toks[self.pos]
        if self.pos + 1 < self.toks.length { self.pos = self.pos + 1 }
        t
    }

    /// Split a `>>` (Tk.Shr) token when a single `>` is expected — the
    /// gnarly-5% nested-generic close (`List<List<T>>`), the executor-side
    /// analogue of the hand parser's `maybe_split_shr` (ps3t.6.5.10). The lexer
    /// merges two adjacent `>` into ONE `>>`; here we CONSUME the first half
    /// (return a synthetic `>`) and leave the second `>` in the current slot —
    /// WITHOUT advancing — so the next `>` match takes it. Deeper nesting works
    /// too: `>>>` lexes as `>> >`, and each `>>` splits once. The mutated slot's
    /// pos is the second `>`'s byte offset, so spans stay honest.
    fn split_gt(self) -> Token {
        let cur = self.cur()
        // Journal the original `>>` BEFORE overwriting the slot: the stream is
        // shared across engines and re-parses, and this is a DESTRUCTIVE edit — the
        // first `>` exists only in the returned synthetic token. restore_to undoes
        // journalled edits at/after its rollback point (see TokEdit's WHY), and the
        // shared runners undo the remainder on an errored exit, so no abandoned
        // parse can leave a half-consumed `>>` for the next one to trip over.
        self.tok_edits.push(TokEdit { idx: self.pos, orig: cur })
        self.toks.set(self.pos, Token { kind: "PUNCT", text: ">", pos: cur.pos + 1, tk: Tk.Greater })
        Token { kind: "PUNCT", text: ">", pos: cur.pos, tk: Tk.Greater }
    }

    fn report(self, msg: string) {
        self.diags.push(msg)
        self.had_error = true
    }

    /// Mark the DSL run as errored WITHOUT recording a diagnostic (ps3t.6.7
    /// Slice 5.4). Used to mirror a @hand delegate's error STATE back onto this
    /// PState when the delegate recovered internally (returned .Ok while its own
    /// bag holds the diagnostic): the boolean gate makes the flip fall back to the
    /// authoritative hand parser, which OWNS the reporting — so copying the diag
    /// here would double-report.
    fn note_had_error(self) {
        self.had_error = true
    }

    /// Clear the had_error FLAG (leaving the diagnostics in `diags` intact). A
    /// self-ptr mutator (not a direct `st.had_error = false`) so it works on the
    /// immutable `st` param of a generated parse fn, exactly like st.advance()/
    /// st.report(). The statement-list recovery loop clears the flag per child so
    /// `if st.had_error` detects only THIS child's failure.
    fn clear_error(self) {
        self.had_error = false
    }

    /// Push / pop the `table { … }` header context (self-ptr mutators, for the same
    /// reason as `clear_error`: a GENERATED parse fn's `st` param is immutable, so a
    /// direct `st.table_cols.push(…)` does not compile). A STACK, because a table cell
    /// may hold a table and the hand keeps `row_type`/`col_names` as locals.
    fn push_table_ctx(self, c: TableCtx) {
        self.table_cols.push(c)
    }

    fn pop_table_ctx(self) {
        if self.table_cols.length > 0 { self.table_cols.pop() }
    }

    /// Replace the parse modes (self-ptr mutator) — the emit twin of the executor's
    /// @off save/clear/restore, so a GENERATED parser (immutable `st` param) can push
    /// and restore modes around a control-flow header condition. A direct
    /// `st.modes = …` field-write does NOT compile on the generated fn's immutable
    /// `st`, so the @off emit MUST route through this (exactly like st.advance()/
    /// st.report()/st.clear_error()).
    fn set_modes(self, m: ExprModes) {
        self.modes = m
    }

    /// Phase 3a base-threading (self-ptr mutators): `seed_postfix` records the
    /// primary base + the chain's start byte (`@hand(primary_base)` result);
    /// `set_postfix_base` updates the accumulator after each `postfix_suffix` step.
    /// Via self-ptr so both the shared-delegate production path and the fresh-parser
    /// interpreter path carry the base across the grammar's ( postfix_suffix )* loop.
    fn seed_postfix(self, base: ExprId, sp: int) {
        self.postfix_base = base
        self.postfix_sp_start = sp
    }
    fn set_postfix_base(self, base: ExprId) {
        self.postfix_base = base
    }

    /// Freeze the chain accumulator for ONE `postfix_suffix` step (t-47hc.33).
    ///
    /// A suffix that RECURSES into `expression` — `[i]`, `(args)`, `<T>(args)` — runs a
    /// whole nested chain, whose own `( postfix_suffix )*` loop calls seed_postfix /
    /// set_postfix_base and overwrites `postfix_base`. By the time the outer build runs,
    /// the accumulator points at whatever the INNER expression last produced: `stats[i]`
    /// built `Index(i, i)`, the loop counter indexed by itself.
    ///
    /// The suffix always folds onto the base as of the moment it was ENTERED, so that is
    /// what gets frozen here — at the top of the generated/interpreted rule, before any
    /// item runs. No restore is needed: the next step re-snapshots, and the live
    /// `postfix_base` keeps threading the chain as before. Inert for a suffix that
    /// consumes tokens only (`?`, `catch`, `?.field`, `.field`), where the snapshot and
    /// the live value are equal.
    fn snap_postfix_step(self) {
        self.postfix_step_base = self.postfix_base
        self.postfix_step_sp = self.postfix_sp_start
    }
    /// Put the per-step FREEZE back exactly as a chain rule found it (t-47hc.33).
    ///
    /// The snapshot above freezes ONE step, but the freeze slot is PState state, not a
    /// stack — so a nested chain's own `snap_postfix_step` overwrites the OUTER step's
    /// frozen base before that step's build reads it. `f((p) -> p.name)` built
    /// `Call(p, …)` (the lambda body's chain won the slot) and the resolver then rejected
    /// a perfectly good program with `undefined variable p`. Nesting is the norm, not the
    /// exception — every suffix that recurses into `expression` (`[i]`, `(args)`) does it.
    ///
    /// The invariant that makes it sound is CHAIN NEUTRALITY: a chain rule (`unary`, build
    /// `fold_postfix_with`) leaves the freeze exactly as it found it, so an inner chain is
    /// invisible to the outer step whose build has yet to run — the hand parser gets this
    /// for free by keeping `rid` as a LOCAL of parse_call. Restored at chain EXIT, after
    /// the fold, so the rule's own `( postfix_suffix )*` loop still threads normally.
    ///
    /// DELIBERATELY only the freeze. `postfix_base` self-heals — every step's build ends in
    /// `postfix_step_node`, which re-seeds it — and `postfix_sp_start` is the chain's SPAN
    /// anchor, so restoring it would move recorded positions and is a separate, IR-visible
    /// change rather than part of this correctness fix.
    fn restore_postfix_chain(self, step_base: ExprId, step_sp: int) {
        self.postfix_step_base = step_base
        self.postfix_step_sp = step_sp
    }
    /// The `@off(flag)` mode-SET marker's set half: save the current modes, clear
    /// the named flag, return the SAVED modes for restore_modes. The executor twin
    /// of the hand parser's `saved = allow_struct_lit; allow_struct_lit = false`.
    fn push_mode_off(self, flag: string) -> ExprModes {
        let saved = self.modes
        self.modes = modes_with_flag_off(self.modes, flag)
        saved
    }
    /// The `@bump(counter)` twin: save modes, INCREMENT the named counter, return the
    /// saved modes for restore_modes. Restore is the same call — the counter is an int
    /// cell in ExprModes, so save/restore is identical to the bool markers and nesting
    /// falls out for free (`quote { quote { } }` bumps to 2 and unwinds correctly).
    fn push_mode_bump(self, counter: string) -> ExprModes {
        let saved = self.modes
        self.modes = modes_with_counter_bumped(self.modes, counter)
        saved
    }
    /// Mint a hygienic temp name for a build action's desugar (`if let`, `let-else`).
    /// The format is core.gensym_name's — `$tag$N` — and the `$` is the whole point: the
    /// lexer admits only letters / digits / `_` in identifiers, so user source can NEVER
    /// produce a `$`-bearing name and the temp cannot shadow or be shadowed.
    ///
    /// `gensym_seq` lives on PState and NOT in ExprModes, deliberately. ExprModes is
    /// saved/restored by the `@off`/`@on`/`@bump` markers; the counter is MONOTONIC
    /// across the COMMITTED parse, because rolling it back there would re-mint a name
    /// a surviving node carries. The one context that rolls it back is SPECULATIVE
    /// rollback (`@try`, and the flip driver's interpreter fallback): every temp the
    /// abandoned attempt minted dies with the store truncation, so the counter must
    /// die with it — otherwise the retry mints `$letelse$2` where the pure-hand
    /// oracle mints `$letelse$1` (the malformed-binding recovery corpus's catch).
    /// The hand parser's save_state keeps its exclusion ("NOT snapshotted, by
    /// design") for its OWN internal backtracks; the speculative snapshots carry the
    /// counter explicitly (HandTryState.gensym / s_gensym).
    fn fresh(self, tag: string) -> string {
        self.gensym_seq = self.gensym_seq + 1
        gensym_name(tag, self.gensym_seq)
    }

    /// Restore the hygiene counter to a speculative snapshot — the write half the
    /// `@try` scaffolds use (`st` is an immutable param there, so the field write
    /// needs a self-by-pointer method exactly like restore_to's).
    fn set_gensym_seq(self, n: int) {
        self.gensym_seq = n
    }
    /// The `@on(flag)` SET-ON twin of push_mode_off: save modes, turn the flag ON,
    /// return the saved modes for restore_modes.
    fn push_mode_on(self, flag: string) -> ExprModes {
        let saved = self.modes
        self.modes = modes_with_flag_on(self.modes, flag)
        saved
    }
    /// Restore modes saved by push_mode_off (`… = saved`).
    fn restore_modes(self, saved: ExprModes) {
        self.modes = saved
    }

    /// Roll the cursor + diagnostics + error flag back to a pre-speculation
    /// snapshot (the node store is truncated separately by the caller via
    /// store.truncate_to_mark). The `@try` bounded-backtracking restore.
    fn restore_to(self, pos: int, diags_len: int, err: bool) {
        // Un-split any `>>` the abandoned parse split at/after the rollback point.
        // A speculation only moves FORWARD from its snapshot, so exactly the edits
        // with idx >= pos belong to it — edits before it are committed ground.
        // Without this, a rollback across a split left the slot holding only the
        // second `>` (the first exists solely in split_gt's returned token), and
        // the retry mis-parsed the nested-generic close it could no longer see.
        mut n = self.tok_edits.length
        while n > 0 && self.tok_edits[n - 1].idx >= pos {
            let e = self.tok_edits[n - 1]
            self.toks.set(e.idx, e.orig)
            n = n - 1
        }
        if n < self.tok_edits.length { self.tok_edits = list_take(self.tok_edits, n) }
        self.pos = pos
        self.diags = list_take(self.diags, diags_len)
        self.had_error = err
    }

    /// Undo EVERY journalled token edit — called at EVERY shared-runner exit,
    /// success and failure alike. On failure the caller is about to re-parse this
    /// run's region over the SAME shared token list (the interpreter fallback, the
    /// hand's decl_lead re-parse, a type-flip retry), so a surviving split would
    /// corrupt the re-read. On success the splits lie BEHIND the caller's resync
    /// point and are never re-read forward — but an ENCLOSING speculation (a
    /// `@try`'d wrapper around the whole item) may still roll back across them,
    /// and its journal cannot know about edits made in this run's own PState (the
    /// nested type/pattern flips build fresh ones). Restoring the stream to
    /// pristine at every exit closes that cross-PState leak: an outer rollback
    /// re-reads the original `>>` and simply re-splits on the retry.
    fn undo_all_tok_edits(self) {
        mut n = self.tok_edits.length
        while n > 0 {
            let e = self.tok_edits[n - 1]
            self.toks.set(e.idx, e.orig)
            n = n - 1
        }
        if self.tok_edits.length > 0 {
            let empty: List<TokEdit> = []
            self.tok_edits = empty
        }
    }

    /// Snapshot the POSTFIX CHAIN ACCUMULATOR alongside a grammar `@try` — the sibling
    /// of save_hand_state, for the same reason and against the same failure.
    ///
    /// `exec_seq` is error-TOLERANT: a speculative branch that mismatches a terminal
    /// reports and keeps going, so its `-> build` STILL RUNS, on whatever the captures
    /// happen to hold. When that build is a postfix step it calls `set_postfix_base` with
    /// a row the rollback is about to discard via `truncate_to_mark`, leaving
    /// `postfix_base` dangling past the end of the store. The next `base_pred` — which
    /// dereferences it with `store.exprs.get(postfix_base)` — then indexes out of bounds.
    ///
    /// Latent until a speculative branch was ALSO a postfix step, which `f<T>(args)` is
    /// the first to be. It is a no-op for every other `@try` in the grammar: the primary
    /// speculations (list_comp, lambda, tuple) run BEFORE the enclosing chain calls
    /// seed_postfix, so the accumulator they restore is the one about to be overwritten.
    /// The generated parser never had the bug — it gates the builder call on the diag
    /// count, so a doomed branch never builds at all.
    fn save_postfix_state(self) -> PostfixTryState {
        PostfixTryState {
            base: self.postfix_base,
            sp_start: self.postfix_sp_start,
            step_base: self.postfix_step_base,
            step_sp: self.postfix_step_sp,
        }
    }

    fn restore_postfix_state(self, saved: PostfixTryState) {
        self.postfix_base = saved.base
        self.postfix_sp_start = saved.sp_start
        self.postfix_step_base = saved.step_base
        self.postfix_step_sp = saved.step_sp
    }

    /// The `@hand` delegate, built ON FIRST USE. Production threads one in at
    /// construction and this returns it unchanged; the interpreter entries construct with
    /// `null` and materialise here, which is what lets a REGISTRY-driven `@peek` predicate
    /// (`ident_lbrace_plain` asking `lookup_expr_parser` whether a feature owns
    /// `name { … }`) get a truthful answer on the oracle paths instead of the conservative
    /// one that routed the form to the `@hand` tail and left the native branch it guards
    /// unmeasured (t-47hc.31).
    ///
    /// LAZY, not eager, and that is not a micro-optimisation: `parser_new_with_store`
    /// builds a full feature Registry (~53 registrations), and `run_grammar_expr` is
    /// called per ASSERTION across the oracle suite — attaching one at every entry grew
    /// the grammar suite's peak past 12 GB and tripped the watchdog. Only a parse that
    /// actually meets an `IDENT {` reaches this, so the rest pay nothing.
    ///
    /// The delegate always starts at byte 0, so it is never AHEAD of the grammar cursor
    /// and `run_hand_expr`'s forward-advance is still monotonic no matter when it is
    /// built — including inside a `@try` that later rolls back.
    ///
    /// A token-only entry has no source for a hand parser to read, so it stays null and
    /// the registry question keeps its conservative answer.
    fn delegate(self) -> Parser? {
        if self.hand_delegate != null { return self.hand_delegate }
        if self.src == "" { return null }
        mut d = parser_new_with_store(self.src, self.file, self.store)
        d.records_roots = 0
        d.stmt_flip = false
        d.decl_flip = false
        d.expr_flip = false
        d.expr_static = false
        self.hand_delegate = d
        self.hand_delegate
    }

    /// Snapshot the threaded procedural delegate alongside a grammar `@try`.
    /// A speculative native branch may call an expression `@hand` leaf, which
    /// advances this parser independently of `PState.pos`; rolling back only the
    /// token index would leave the fallback delegate ahead of the retry point.
    fn save_hand_state(self) -> HandTryState? {
        if self.hand_delegate == null { return null }
        let d = self.hand_delegate!
        let bag = DiagnosticBag {
            diagnostics: list_take(d.bag.diagnostics, d.bag.diagnostics.length),
            error_count: d.bag.error_count,
            warning_count: d.bag.warning_count,
        }
        HandTryState { parser: d.save_state(), bag, gensym: d.gensym_seq }
    }

    /// Restore the procedural half of a failed grammar `@try`: cursor,
    /// mode/error fields, shared-store mark, and the separately copied bag.
    fn restore_hand_state(self, saved: HandTryState?) {
        if saved == null || self.hand_delegate == null { return }
        mut d = self.hand_delegate!
        d.restore_state(saved!.parser)
        d.bag = saved!.bag
        // The hygiene counter rolls back WITH the store truncation the caller
        // performs: every temp the abandoned branch minted dies with its rows, so
        // NOT restoring re-mints later temps one-off from the pure-hand oracle
        // ($letelse$2 where FLIP=0 mints $letelse$1 — the malformed-binding
        // recovery corpus is the guard). ParserState itself still excludes the
        // counter by design; the speculative snapshot is the one context where
        // the discard makes rolling it back sound.
        d.gensym_seq = saved!.gensym
    }

    /// A whole-construct error placeholder (no matching alternative).
    fn error_node(self, msg: string) -> ExprId {
        self.report(msg)
        self.store.exprs.add_leaf(Expr.Error)
    }

    /// An `Expr.Error` placeholder WITHOUT reporting — the `@require` abort's value.
    /// The mismatch already reported (with the `@expect` message), so `error_node`
    /// here would emit the SAME diagnostic a second time. Both engines use this.
    fn error_node_silent(self) -> ExprId {
        self.store.exprs.add_leaf(Expr.Error)
    }

    /// An absent-but-required-position placeholder (a missing terminal).
    fn missing_node(self) -> ExprId {
        self.store.exprs.add_leaf(Expr.Missing)
    }

    /// Panic-mode synchronize: advance until `tok` (consumed) or EOF.
    fn synchronize(self, tok: string) {
        while !self.at_end() && self.cur().text != tok { let _ = self.advance() }
        if self.cur().text == tok { let _ = self.advance() }
    }

    /// Statement-boundary synchronize — the PState twin of the hand parser's
    /// no-arg `Parser.synchronize` (parse/mod.av:3658): advance until a statement
    /// LEAD keyword or `}`, WITHOUT consuming it. Matches by `Tk` (NOT text) so a
    /// string/ident token whose text spells a keyword can't wrongly halt the scan —
    /// byte-identical to the hand boundary set (fn/let/const/mut/type/enum/impl/if/
    /// while/for/match/return/extern/trait/defer/spec/given/then/select + RightBrace;
    /// errdefer and break/continue are deliberately NOT boundaries). Dormant: wired
    /// in when the generated block statement-list-with-recovery loop lands (t-47hc.13).
    fn synchronize_stmt(self) {
        while !self.at_end() {
            let k = self.cur().tk
            if k == Tk.KwFn || k == Tk.KwLet || k == Tk.KwConst || k == Tk.KwMut ||
                k == Tk.KwType || k == Tk.KwEnum || k == Tk.KwImpl || k == Tk.KwIf ||
                k == Tk.KwWhile || k == Tk.KwFor || k == Tk.KwMatch || k == Tk.KwReturn ||
                k == Tk.KwExtern || k == Tk.KwTrait || k == Tk.KwDefer || k == Tk.KwSpec ||
                k == Tk.KwGiven || k == Tk.KwThen || k == Tk.KwSelect || k == Tk.RightBrace {
                return
            }
            let _ = self.advance()
        }
    }
}

// ── FIRST-set membership (branch selection + repetition guards) ──

fn list_has(xs: List<string>, s: string) -> bool {
    for x in xs { if x == s { return true } }
    false
}

/// Does the CURRENT token start `prim`? Structural, cycle-guarded FIRST membership.
///
/// Takes the whole PState rather than a bare Token (t-47hc.33) because `^` is part of a
/// sequence's FIRST — see tok_starts_seq. Every call site already passed `st.cur()`, so
/// this is the same question with the state the newline gate needs in reach.
/// Match a NAMED terminal against a token. Every terminal but one is a `kind`
/// string straight out of `tk_to_grammar_kind` (real_lex.av); `FIELDNAME` is the
/// exception, and it exists because that mapping is too COARSE to spell what the
/// hand accepts after a `.` — `Tk.KwReserved` folds into `KW` along with every
/// other keyword, so `IDENT` is narrower than `consume_field_name` and `KW` is
/// vastly wider. `FIELDNAME` reads the shared `tk_is_field_name` (core/ast.av)
/// instead, which is the hand's own predicate (t-47hc.33.1).
///
/// LOCKSTEP: emit's `named_tk_guard` must lower `FIELDNAME` to the SAME Tk set.
/// That pairing is asserted by reserved_kw_field_test — the two engines drifting
/// is the recurring failure mode in this slice (`base_field_access`, `dot_number`).
fn named_tok_matches(name: string, tok: Token) -> bool {
    if name == "FIELDNAME" { return tk_is_field_name(tok.tk) }
    tok.kind == name
}

fn tok_starts_prim(g: Grammar, prim: GPrim, st: PState, visited: List<string>) -> bool {
    let tok = st.cur()
    match prim {
        .Lit(t) -> tok.text == t
        .Named(name) -> named_tok_matches(name, tok)
        .Ref(name) -> tok_starts_rule(g, name, st, visited)
        .Group(inner) -> tok_starts_node(g, inner, st, visited)
        .Hand(hf) -> hand_starts(hf, tok)
        // A `@when` predicate is zero-width — it starts no token. It never
        // reaches here for a LEADING position (tok_starts_seq skips it); this
        // arm covers a non-leading predicate, which contributes no FIRST token.
        .Pred(_) -> false
        // `@peek` is the same zero-width shape — starts no token.
        .Peek(_) -> false
        // `@gensym` mints a name and consumes nothing — starts no token either.
        .Gensym(_) -> false
        // `@rawbrace` accepts ANY current token: the scan runs to the balancing `}`
        // whatever the body starts with, and an immediate `}` is a legal EMPTY body.
        // In practice it is never a branch head (it always follows the `"{"` literal
        // that opened the block), so this arm only matters for exhaustiveness.
        .RawBrace(_) -> true
    }
}

/// True iff the primary is ZERO-WIDTH — a `@when(flag)` mode read, a `@peek(cond)`
/// token lookahead, or a `@gensym(tag)` mint. All three are skipped by tok_starts_seq's
/// leading scan: none consumes a token, so none contributes a FIRST.
///
/// `@gensym` belongs here even though it BINDS rather than gates. It is skipped for the
/// same reason and by the same rule — a rule that mints before its keyword (which is
/// exactly where the hand mints, between consuming `if` and consuming `let`) would
/// otherwise compute an empty FIRST and never be dispatched to.
fn prim_is_pred(prim: GPrim) -> bool {
    match prim { .Pred(_) -> true  .Peek(_) -> true  .Gensym(_) -> true  _ -> false }
}

fn tok_starts_rule(g: Grammar, name: string, st: PState, visited: List<string>) -> bool {
    if list_has(visited, name) { return false }   // cycle guard
    mut v2: List<string> = []
    for x in visited { v2.push(x) }
    v2.push(name)
    let r = lookup_rule(g, name)
    if r.name == "" { return false }
    tok_starts_node(g, r.body, st, v2)
}

fn tok_starts_node(g: Grammar, node: GNode, st: PState, visited: List<string>) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                if tok_starts_seq(g, b, st, visited) { return true }
            }
            false
        }
    }
}

/// FIRST of a sequence: the first item's FIRST, extended through any
/// nullable (Opt/Star) leading items.
fn tok_starts_seq(g: Grammar, seq: GSeq, st: PState, visited: List<string>) -> bool {
    for item in seq.items {
        // A `@when` predicate is zero-width: it contributes no FIRST token and
        // never stops the scan — skip past it to the next item. (Its mode gate
        // is checked separately in branch_pred_ok, ANDed onto the branch.)
        if prim_is_pred(item.prim) { continue }
        // `^` is part of the FIRST, not just of the item's own match (t-47hc.33). A
        // same-line item cannot start on a token that sits on the next line, so a branch
        // led by one must NOT be selected there — it has to fall through to its siblings
        // instead of being entered and then failing mid-sequence. Emit's twin is the
        // same_line_wrap in seq_first_guard; keeping the two in lockstep is what stops
        // the interpreter and the generated parser picking different branches.
        if tok_starts_prim(g, item.prim, st, visited) && sameline_ok(st, item) { return true }
        // A One/Plus item is non-nullable — FIRST stops here.
        match item.rep {
            .One -> return false
            .Plus -> return false
            _ -> {}   // Opt/Star are nullable — consider the next item too
        }
    }
    false
}

fn lookup_rule(g: Grammar, name: string) -> Rule {
    // O(1) resolution via the Grammar's precomputed name->index map
    // (build_rule_index), replacing the former O(rules) linear name scan
    // that ran on every rule descent. First-match semantics preserved:
    // build_rule_index keeps the earliest index for a duplicated name.
    let idx = rule_index_of(g, name)
    if idx >= 0 { return g.rules[idx] }
    Rule { name: "", body: GNode.Alt([]) }
}

// ── The executor ──

/// Run `grammar` over `src`, starting at the first rule (the start
/// symbol). Returns the store + root + diagnostics.
/// Build a fresh PState over `src` (real lexer + fresh store), the setup a
/// GENERATED static parser (ps3t.6.5.11) runs against: `let st = new_pstate(src)`
/// then `parse_<start>(st)`, then `capval_to_expr(st, …)` for the root — exactly
/// the `run_grammar_expr_src` boundary, minus the interpreter.
export fn new_pstate(src: string) -> PState {
    let store = new_node_store(build_line_index(src))
    // Attach ONE reusable @hand delegate (sharing the store) so run_hand_expr
    // forward-advances a SINGLE parser across the whole parse — O(source) — rather
    // than building a fresh parser (~53 build_registry registrations) AND re-lexing
    // from byte 0 to the leaf on EVERY @hand leaf, which is O(source^2). That
    // quadratic fallback made the emit-gen generated parser ~72x slower than the
    // hand parser (measured, callgrind); the reused delegate closes that gap. Leaf
    // positions are visited monotonically (predictive LL, no backtracking), so the
    // delegate advances each token once. Tree-equivalent to the fresh-parser path
    // (only line/span accounting differs, which dump-based equivalence ignores).
    //
    // EAGER here, unlike PState.delegate()'s lazy materialisation: this is the
    // generated-parser setup, where `@hand` leaves are the common case and
    // `run_hand_expr` reads `hand_delegate` directly — deferring it would just hand
    // every leaf the fresh-parser fallback this exists to avoid.
    mut d = parser_new_with_store(src, "", store)
    d.records_roots = 0
    d.stmt_flip = false
    d.decl_flip = false
    d.expr_flip = false
    d.expr_static = false
    PState { toks: lex_real(src), pos: 0, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: d, tok_edits: [], table_cols: [] }
}

export fn run_grammar_expr(grammar: Grammar, src: string) -> RunResult {
    run_grammar_expr_src(grammar, lex_real(src), new_node_store(build_line_index(src)), src)
}

/// The caller-provided-store form of `run_grammar_expr` (ps3t.6.5.8): the
/// token stream and destination `NodeStore` are supplied by the caller, so
/// the DSL parser builds INTO an existing store (the eventual swap-in point —
/// the real parser hands its own store + token stream). `run_grammar_expr`
/// is the thin `(real lexer + fresh store)` wrapper over this. No source is
/// threaded — a `@hand` EXPRESSION rule that needs it (e.g. `quote`) is
/// unavailable on this path (the swap-in serves those from a real Parser).
export fn run_grammar_expr_toks(grammar: Grammar, toks: List<Token>, store: NodeStore) -> RunResult {
    run_grammar_expr_src(grammar, toks, store, "")
}

/// Shared core of the expression entry. `src` is threaded (empty on the
/// token-only path) so a `@hand` EXPRESSION rule can delegate to the real hand
/// parser over the original source — the `run_hand_expr` analogue of
/// `run_grammar_stmt_src`. `quote { … }` is the case: a leading `~` inside a
/// quote body is `Expr.Splice`, which the hand parser decides on its
/// `quote_depth` mode counter (a parser mode the token-grammar can't carry;
/// ps3t.6.5.10).
fn run_grammar_expr_src(grammar: Grammar, toks: List<Token>, store: NodeStore, src: string) -> RunResult {
    mut st = PState { toks, pos: 0, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    if grammar.rules.length == 0 {
        let root = st.error_node("empty grammar")
        return RunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
    }
    let root = capval_to_expr(st, exec_rule(grammar, grammar.rules[0].name, st))
    st.undo_all_tok_edits()
    RunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
}

/// The statement-family analogue of `RunResult` — a `StmtId` root instead
/// of `ExprId` (ps3t.6.5.2).
export type StmtRunResult = { store: NodeStore, root: StmtId, had_error: bool, diags: List<string> }

/// Run `grammar` over `src` starting at the first rule and coerce the
/// root to a STATEMENT node — the statement-family entry, mirroring
/// `run_grammar_expr`. The grammar's start rule must build a Stmt; its
/// sub-rules may build Exprs (embedded expressions) or Stmts.
export fn run_grammar_stmt(grammar: Grammar, src: string) -> StmtRunResult {
    run_grammar_stmt_src(grammar, lex_real(src), new_node_store(build_line_index(src)), src)
}

/// Caller-provided-store form of `run_grammar_stmt` (ps3t.6.5.8). See
/// `run_grammar_expr_toks`. No source is threaded — a `@hand` statement rule
/// that needs the source (e.g. `component`) is unavailable on this path (the
/// swap-in serves those from a real Parser, not this interpreter).
export fn run_grammar_stmt_toks(grammar: Grammar, toks: List<Token>, store: NodeStore) -> StmtRunResult {
    run_grammar_stmt_src(grammar, toks, store, "")
}

/// Shared core of the statement entry. `src` is threaded (empty on the
/// token-only path) so a `@hand` statement rule can delegate a whole
/// declaration to the real hand parser over the original source — the token
/// list alone can't reconstruct a raw body / char-level lookahead. (ps3t.6.5.8
/// store + ps3t.6.5.7/6.5.10 @hand delegation.)
fn run_grammar_stmt_src(grammar: Grammar, toks: List<Token>, store: NodeStore, src: string) -> StmtRunResult {
    mut st = PState { toks, pos: 0, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    if grammar.rules.length == 0 {
        st.report("empty grammar")
        let root = st.store.stmts.add_leaf(Stmt.Error)
        return StmtRunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
    }
    let root = capval_to_stmt(st, exec_rule(grammar, grammar.rules[0].name, st))
    st.undo_all_tok_edits()
    StmtRunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
}

/// The pattern-family analogue of `RunResult` — a `PatId` root (ps3t.6.5.5).
export type PatRunResult = { store: NodeStore, root: PatId, had_error: bool, diags: List<string> }

/// Run `grammar` over `src` starting at the first rule and coerce the root
/// to a PATTERN node — the pattern-family entry, mirroring run_grammar_stmt.
/// The start rule must build a Pattern; its sub-rules build Patterns (and
/// may capture bare tokens for names/bindings).
export fn run_grammar_pat(grammar: Grammar, src: string) -> PatRunResult {
    run_grammar_pat_toks(grammar, lex_real(src), new_node_store(build_line_index(src)))
}

/// Caller-provided-store form of `run_grammar_pat` (ps3t.6.5.8). See
/// `run_grammar_expr_toks`.
export fn run_grammar_pat_toks(grammar: Grammar, toks: List<Token>, store: NodeStore) -> PatRunResult {
    mut st = PState { toks, pos: 0, store, src: "", diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    if grammar.rules.length == 0 {
        st.report("empty grammar")
        let root = st.store.pats.add_leaf(Pattern.Wildcard)
        return PatRunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
    }
    let root = capval_to_pat(st, exec_rule(grammar, grammar.rules[0].name, st))
    st.undo_all_tok_edits()
    PatRunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
}

/// The type-family analogue of `RunResult` — a `TypeId` root (ps3t.6.5.6).
/// The `TypeId` indexes the store's type arena; render via `render_type_id`.
export type TypeRunResult = { store: NodeStore, root: TypeId, had_error: bool, diags: List<string> }

/// Run `grammar` over `src` starting at the first rule, coerce the root to a
/// surface `TypeExpr`, then lower it to a `ValueType` via the SHARED
/// `type_expr_to_vtype` (exactly what the hand parser does) and ingest into
/// the type arena — so equivalence reduces to building the same `TypeExpr`.
export fn run_grammar_type(grammar: Grammar, src: string) -> TypeRunResult {
    run_grammar_type_src(grammar, lex_real(src), new_node_store(build_line_index(src)), src)
}

/// Caller-provided-store form of `run_grammar_type` (ps3t.6.5.8).
export fn run_grammar_type_toks(grammar: Grammar, toks: List<Token>, store: NodeStore) -> TypeRunResult {
    run_grammar_type_src(grammar, toks, store, "")
}

/// Shared core of the type entry. `src` remains available to the common PState.
fn run_grammar_type_src(grammar: Grammar, toks: List<Token>, store: NodeStore, src: string) -> TypeRunResult {
    mut st = PState { toks, pos: 0, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    if grammar.rules.length == 0 {
        st.report("empty grammar")
        let root = st.store.types.add_leaf(ValueType.Unknown)
        return TypeRunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
    }
    let te = capval_to_texpr(st, exec_rule(grammar, grammar.rules[0].name, st))
    let root = st.store.types.add_leaf(type_expr_to_vtype(te))
    st.undo_all_tok_edits()
    TypeRunResult { store: st.store, root, had_error: st.had_error, diags: st.diags }
}

/// Execute a rule with a FRESH capture environment (rule scope) and
/// return its RAW capture value — an Expr node, a Stmt node, or a bare
/// token. Coercion is deferred to the use-site (`capval_to_expr` /
/// `capval_to_stmt`), so a rule can target either node kind; the
/// expression family already relied on use-site coercion (operator
/// captures stay `Tok`, folds/ctors coerce their node args, and the
/// run entry coerces the root), so this is behaviour-preserving for it.
/// True iff any branch of rule `name` builds a POSTFIX STEP — the family whose builds
/// fold onto the threaded chain accumulator rather than onto a capture. Kept as one list
/// so the executor and the emitter cannot disagree about which rules need the snapshot.
fn build_is_postfix_step(bn: string) -> bool {
    bn == "MkTrySuffix" || bn == "MkCatchSuffix" || bn == "MkOptChain" ||
        bn == "MkFieldAccess" || bn == "MkTupleIndex" || bn == "MkIndexSuffix" || bn == "MkCallSuffix" ||
        bn == "MkGenericCallSuffix" || bn == "MkEnumCtorSuffix" || bn == "MkOptMethodCall" || bn == "MkForceUnwrap"
}

fn rule_has_postfix_step_build(g: Grammar, name: string) -> bool {
    let idx = rule_index_of(g, name)
    if idx < 0 { return false }
    match g.rules[idx].body {
        .Alt(branches) -> {
            for b in branches {
                match b.build {
                    .Call(bn, _) -> if build_is_postfix_step(bn) { return true }
                    _ -> {}
                }
            }
            false
        }
    }
}

fn exec_rule(g: Grammar, name: string, st: PState) -> CapVal {
    // Freeze the chain accumulator BEFORE any item runs (t-47hc.33). See
    // PState.snap_postfix_step: a suffix that recurses into `expression` would otherwise
    // build onto whatever the nested chain last produced. Emit's twin is the
    // `st.snap_postfix_step()` line at the top of the generated rule fn.
    if rule_has_postfix_step_build(g, name) { st.snap_postfix_step() }
    let r = lookup_rule(g, name)
    if r.name == "" { return CapVal.Node(st.error_node("unknown rule `${name}`")) }
    // Chain neutrality (see PState.restore_postfix_chain): a chain rule restores the four
    // chain fields on exit so a NESTED chain — every `[i]` index, every `(args)` argument —
    // is invisible to the outer step whose build has yet to run. Emit's twin is the
    // save/restore wrapper around the generated `parse_<rule>` fn.
    mut env = CapEnv { caps: [], cut: false, cut_diags: 0, cut_err: false, abort: false }
    let chain_rule = rule_seeds_postfix(g, r)
    let c_step_base = st.postfix_step_base
    let c_step_sp = st.postfix_step_sp
    let v = exec_node_at(g, r.body, st, env, false, [], true)
    if chain_rule { st.restore_postfix_chain(c_step_base, c_step_sp) }
    // "A nonterminal binds its NODE" (README): a rule that bottoms out in a
    // bare terminal yields a `Tok`, so coerce that to a literal Expr node
    // HERE, at the rule boundary — otherwise a rule reference captured in a
    // repetition (`r:unary`) routes to the `Toks` list instead of `Nodes`
    // (bind) and the fold loses its operands. Node and SNode (statement)
    // results already carry a node id and pass through unchanged. This is
    // exactly the old boundary coercion, minus the Tok→literal step being
    // the ONLY coercion (so SNode survives for the statement family).
    match v {
        .Tok(t) -> CapVal.Node(literal_node(st, t))
        _ -> v
    }
}

/// Read a parse-MODE flag by name off the live ExprModes (the `@when(flag)`
/// semantics). The `allow_*` flags are int-as-bool; `cell_mode` is a real bool.
/// An unknown flag is ungated (true) — a typo is caught byte-side because the
/// emitted guard `modes_flag(st.modes, "flag")` shares THIS function, so the
/// interpreter and the generated parser can never disagree on a flag's meaning.
export fn modes_flag(modes: ExprModes, flag: string) -> bool {
    if flag == "allow_struct_lit" { return modes.allow_struct_lit != 0 }
    if flag == "allow_dot_postfix" { return modes.allow_dot_postfix != 0 }
    if flag == "allow_it_sugar" { return modes.allow_it_sugar != 0 }
    if flag == "cell_mode" { return modes.cell_mode }
    // `at_quote_top` = NOT inside a quote body (quote_depth == 0). Gates the
    // grammar-owned `~` bitnot: at quote_depth > 0 `~` is the quote SPLICE
    // operator (hand parse_leaf_common), and the production static parser DOES
    // run inside quote bodies, so a grammar-owned `~` must fire ONLY at depth 0.
    if flag == "at_quote_top" { return modes.quote_depth == 0 }
    // `in_quote_body` = the exact complement, `quote_depth > 0`. Both directions are
    // needed because `~` is TWO different operators either side of the line: bitnot at
    // depth 0 (grammar-owned, gated `at_quote_top`) and quote SPLICE inside a body.
    // Spelled as its own predicate rather than a negation form because the DSL has no
    // `!` on predicates, and inventing one would need a matching emit twin for a single
    // use — the two named readings stay trivially checkable against each other.
    if flag == "in_quote_body" { return modes.quote_depth > 0 }
    true
}

/// True for the `@when` predicates that read the POSTFIX BASE rather than a parse MODE.
/// Kept as its own list so `pred_ok` can route them, and so `modes_flag` stays a pure
/// function of `ExprModes` (a base read needs the whole PState).
export fn is_base_pred(flag: string) -> bool {
    flag == "base_callable" || flag == "base_upper_ident" || flag == "dot_postfix_ok" || flag == "base_field_access"
}

/// Read a predicate off the accumulated POSTFIX BASE (`st.postfix_base`) — the base the
/// `( postfix_suffix )*` loop is folding onto. Two of `postfix_step`'s eight entry-guard
/// branches ask about the base rather than the token stream, and neither is expressible
/// as a mode flag:
///   `base_callable`    — the generic-call branch's `is_callable(result)`: only an Ident,
///                        a QualifiedIdent, or a field access can take `<T>` type args, so
///                        `a < b` stays a comparison.
///   `base_upper_ident` — the `.Variant` half of `dot_is_postfix`: inside a match arm
///                        (`allow_dot_postfix` off) a `.Upper` continuation is a postfix
///                        only when the base is ITSELF an uppercase ident (an enum-type
///                        prefix like `Foo.Bar`); otherwise it is the NEXT arm's pattern.
///
/// Reads the store directly rather than importing the hand parser's `is_callable` /
/// `expr_is_upper_ident`: `parse_grammar` is reachable from comptime macro expansion, and
/// a cross-module non-`@comptime` callee there resolves to a type_marker (F4005). The
/// duplication is deliberate — see the note on seed_parser's `name_in`.
///
/// SHARED by both engines: emit.pred_guard emits a call to THIS function, exactly as the
/// `@peek` guard emits `lookahead_ok(...)`, so interpreter and generated parser cannot
/// disagree on a predicate's meaning.
export fn base_pred(flag: string, st: PState) -> bool {
    // NO BASE YET => the predicate is false, not a crash. `postfix_base` holds
    // `ExprId(0)` — the arena's NULL NICHE — until `seed_postfix` runs, and arena ids
    // are 1-based (`get` indexes `raw() - 1`), so dereferencing it reads index -1.
    // Compared, never peeled: ids are opaque handles (F3106 gates `.raw()` to `core`),
    // and `ExprId(0)` is the same sentinel every PState constructor here writes.
    // Nothing stops a grammar from writing `@when(base_callable)` on a branch outside a
    // postfix chain: the predicate is validated by NAME, not by position, and
    // `branch_pred_ok` runs it wherever it appears. "Is the base callable" has one honest
    // answer when there is no base.
    if st.postfix_base == ExprId(0) { return false }
    let e = st.store.exprs.get(st.postfix_base)
    if flag == "base_callable" {
        return match e {
            .Ident(_) -> true
            .QualifiedIdent(_) -> true
            .FieldAccess(_, _) -> true
            _ -> false
        }
    }
    // The `.` arm's ENTIRE entry-guard conjunct from the hand postfix_step:
    //   check(Tk.Dot) && dot_is_postfix(result) && (!cell_mode || same_line)
    // Folded into ONE predicate rather than spelled as `@when(cell_mode)` + `^` + a base
    // read, because `dot_is_postfix` is not a conjunction of those — it is a decision
    // TREE (cross-line-uppercase rejects outright; otherwise allow_dot_postfix short-
    // circuits true; otherwise a lowercase field is always a field; only an uppercase
    // field with the flag off consults the base). Expressing that as separate markers
    // would need a negated `@when`, which the DSL does not have and should not grow for
    // one caller. `peek_next_is_upper` reads the SOURCE char after the `.` in the hand;
    // on the token stream the next token's first char is the same question.
    if flag == "dot_postfix_ok" {
        if st.cur().tk != Tk.Dot { return false }
        let same_line = st.pos == 0 ||
            st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line == st.store.lines.to_linecol(st.cur().pos).line
        // cell_mode confines a `.` postfix to its own line (table cells).
        if st.modes.cell_mode != 0 && !same_line { return false }
        let next_upper = st.pos + 1 < st.toks.length && grammar_starts_upper(st.toks[st.pos + 1].text)
        // A bare `.UpperIdent` opening a NEW line is a fresh enum-ctor statement, not a
        // postfix on the previous expression (forge-crafting-intepreters-3r6q).
        if !same_line && next_upper { return false }
        if st.modes.allow_dot_postfix != 0 { return true }
        // Inside a match arm: `.lower` is always a field, `.Upper` only when the base is
        // itself an uppercase ident (an enum-TYPE prefix like `Foo.Bar`).
        if !next_upper { return true }
        return base_pred("base_upper_ident", st)
    }
    // `obj.method(...)` vs `f(...)`. The hand sets `allow_it_sugar = is_method || saved_it`
    // where is_method is "the receiver is a FieldAccess". That disjunction is exactly two
    // grammar alternatives: this predicate picks the one that turns the mode ON, and the
    // unguarded sibling leaves it at whatever it already was.
    if flag == "base_field_access" {
        return match st.store.exprs.get(st.postfix_base) {
            .FieldAccess(_, _) -> true
            _ -> false
        }
    }
    if flag == "base_upper_ident" {
        return match e {
            .Ident(n) -> grammar_starts_upper(n)
            // The LAST path segment: a qualified type reference (`@std::…::Result`)
            // begins with `@`, so testing the whole string reads every qualified name as
            // lowercase — which stopped the chain at the type and leaked `.Err(c)` into
            // the next match arm. Mirrors the hand's expr_is_upper_ident.
            .QualifiedIdent(n) -> grammar_starts_upper(grammar_last_segment(n))
            _ -> false
        }
    }
    false
}

/// A `@when` predicate against the live PState — mode flags and base reads under one
/// entry point, so `branch_pred_ok` has a single call and neither kind can be forgotten.
export fn pred_ok(flag: string, st: PState) -> bool {
    if is_base_pred(flag) { return base_pred(flag, st) }
    modes_flag(st.modes, flag)
}

/// Uppercase-ASCII-initial test — Avra's type/variant naming convention.
fn grammar_starts_upper(name: string) -> bool {
    if name.length < 1 { return false }
    let c = code_at(name, 0)
    c >= 65 && c <= 90
}

/// The TYPE-name segment of a qualified path — the last `::` segment, and for an
/// UN-namespaced id the part after the leading `@`.
///
/// Both skips are needed. `mk_qualified` builds `@` + the head name, so a single-segment
/// reference is `@Result` with no `::` at all; testing that raw would see `@` and report
/// lowercase, which made `base_upper_ident` answer false for every un-namespaced type and
/// silently stop a `.Variant` chain. The hand parser's `type_short_name` skips the same
/// leading segment, which is the behaviour being mirrored.
export fn grammar_last_segment(path: string) -> string {
    mut start = 0
    mut i = 0
    while i + 1 < path.length {
        if code_at(path, i) == 58 && code_at(path, i + 1) == 58 { start = i + 2 }
        i = i + 1
    }
    // No `::` found and the path leads with `@` (`@Result`) — skip just the sigil.
    if start == 0 && path.length > 0 && code_at(path, 0) == 64 { start = 1 }
    path.substring(start, path.length)
}

/// The `IDENT {` forms a FEATURE owns, which stay `@hand(primary_base)`'s: `table`
/// (parse_ident_expr checks it before any postfix) and any name a feature registered an
/// expression parser for (`grammar { … }`, …).
///
/// No delegate means no registry to consult, and the answer is CONSERVATIVE — treat the
/// name as feature-owned, so a native branch can never swallow a construct whose feature
/// owns the block. `PState.delegate()` materialises one from the source, so that only
/// happens on the token-only entries, where an `@hand` rule is unavailable by contract
/// anyway. It used to happen on `run_grammar_expr` too, and that is why the struct-literal
/// branch was unreachable in every interpreter oracle — `Foo { x: 1 }` fell past it to the
/// `@hand(primary_base)` tail, so the specs covering struct literals were measuring the
/// hand parser (t-47hc.31, the t-6u9b vacuous-agreement shape).
fn ident_lbrace_is_feature_form(st: PState) -> bool {
    let name = st.cur().text
    if name == "table" { return true }
    let d = st.delegate()
    if d == null { return true }
    lookup_expr_parser(d!.features, name) != null
}

/// Does some OTHER `IDENT {`-led branch own the form at the cursor? The shared half of
/// the two sibling predicates below, so they cannot disagree about who takes an
/// identifier followed by `{`: a feature form (above) belongs to the hand, anything else
/// is a STRUCT LITERAL — and only when `allow_struct_lit` is on, which is the gate
/// `unary`'s struct-lit branch carries itself.
///
/// The mode read is what `ident_plain` was missing. With `allow_struct_lit` OFF — a
/// `match` subject, an `if`/`while` condition — NO branch owns `IDENT {`, so the `x` in
/// `match x { … }` is a plain identifier and nothing else. `ident_plain` declined anyway
/// (it excluded a following `{` unconditionally) and the `@hand(primary_base)` tail
/// absorbed every one of them, which is why removing that tail turned every mode-gated
/// subject into `unexpected token`.
fn ident_lbrace_owned_elsewhere(st: PState) -> bool {
    if st.cur().kind != "IDENT" { return false }
    if st.pos + 1 >= st.toks.length { return false }
    if st.toks[st.pos + 1].text != "{" { return false }
    if ident_lbrace_is_feature_form(st) { return true }
    // Through modes_flag, the same reader `@when(allow_struct_lit)` uses on the
    // struct-lit branch — so the two cannot answer differently.
    modes_flag(st.modes, "allow_struct_lit")
}

/// Evaluate a `@peek(cond)` LOOKAHEAD predicate against the live token stream — the
/// token-stream twin of modes_flag. Shared by the executor (branch_pred_ok) AND, via
/// emit.peek_guard emitting the SAME `lookahead_ok(...)` call, the generated parser, so
/// the two can never disagree. Kept in lockstep with seed_parser.peek_cond_supported.
///   ident_colon — the current token is an IDENT and the NEXT token is `:` (PUNCT). The
///     hand parse_paren_expr's peek_after_ident_is_colon: a typed lambda `(x: …) -> …`
///     vs a grouping/tuple. (The current-is-IDENT half is redundant with the branch's
///     own IDENT FIRST token, but included so the predicate fully mirrors the hand check
///     and is correct in any position.)
///   stmt_block — the current token is `{` and the next two tokens are not STRING `:`;
///     the statement-position twin of Parser.is_stmt_map_literal.
///   for_destructure — current is `for` and next is `(`.
///   comma_ident — current is `,` and next is IDENT, separating it from a trailing comma.
///   double_colon — current and next are adjacent `:` tokens.
/// An unknown cond is ungated (true) — a typo is
///     caught at parse time (peek_cond_supported), so this is unreachable-by-contract.
export fn lookahead_ok(cond: string, st: PState) -> bool {
    // Statement-position brace disambiguation, the token-level twin of
    // Parser.is_stmt_map_literal: only a string-keyed `{ "key": ... }` is a map
    // expression here. Empty braces and every other leading token are blocks.
    if cond == "stmt_block" {
        if st.cur().text != "{" { return false }
        if st.pos + 2 >= st.toks.length { return true }
        // TEMPLATE as well as STRING — an INTERPOLATED key (`{"k${s}": "v"}`) opens a
        // map exactly as a plain one does. `brace_map` five lines below has always
        // tested `STRING || TEMPLATE`; this sibling tested only STRING, so in
        // STATEMENT position a template-keyed map was claimed as a block, failed, and
        // fell to `@hand(decl_hand)`. Either half alone was already native — a plain
        // key in bare position, or a template key in `let` position — which is why it
        // survived: only the combination reached the gap (t-myz7).
        let k = st.toks[st.pos + 1]
        return !((k.kind == "STRING" || k.kind == "TEMPLATE") && st.toks[st.pos + 2].text == ":")
    }
    // Expression-position brace: the token twin of Parser.is_map_literal. `{ }` is an
    // EMPTY MAP here (unlike statement position, where it stays a block), otherwise a
    // map needs a string/template key followed by `:`. Everything else is a block.
    if cond == "brace_map" {
        if st.cur().text != "{" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        if st.toks[st.pos + 1].text == "}" { return true }
        if st.pos + 2 >= st.toks.length { return false }
        let k = st.toks[st.pos + 1]
        return (k.kind == "STRING" || k.kind == "TEMPLATE") && st.toks[st.pos + 2].text == ":"
    }
    // `IDENT {` — the token twin of Parser.peek_after_ident_is_lbrace. Distinguishes the
    // `~Name { … }` splice (which splices only the CONSTRUCTOR NAME of a struct literal)
    // from the greedy `~expr` form that would otherwise swallow the whole literal as one
    // spliced node carrying a hardcoded type name. The hand version scans SOURCE bytes
    // past the ident for the first non-space char; on the token stream the whitespace is
    // already gone, so "the next token is `{`" is the same question — the same equivalence
    // ident_colon relies on.
    // `?.field` WITHOUT a call — the half of the hand's QuestionDot arm that builds
    // `Expr.OptionalChain`. Three conjuncts, each excluding a case the hand keeps:
    //   - the field must lex as IDENT, because consume_field_name also accepts a
    //     RESERVED keyword and the grammar's "KW" kind is every keyword, not just those;
    //   - a same-line `(` after it is `?.m(args)` => Expr.OptionalMethodCall, a different
    //     node built from an arg list with `it`-sugar;
    //   - a CROSS-line `(` is not a call at all (the hand checks prev_line there too), so
    //     that stays this branch.
    // Everything excluded falls through to the `@hand` tail, which handles it verbatim.
    // `.field` that is NOT an enum construction. The hand builds `Expr.EnumCtor` when the
    // base is a PascalCase Ident / qualified path with a PascalCase last segment AND a `(`
    // follows the field name; that form needs an argument list, so it stays hand-owned.
    // Everything else with an IDENT field name is a plain FieldAccess.
    // `,` that is followed by ANOTHER element, not by the CLOSER — the trailing-comma
    // guard. `f(a, b,)` is legal (parse_arg_list_ids_inner advances past the comma and
    // stops when `)` follows), so the element loop must NOT enter on a trailing
    // separator: without this it consumed the `,` and then demanded an expression at the
    // closer, turning a valid call into `(call f (a, b, (error)))`.
    //
    // There is no compiler-inserted backtracking in the executor (deliberately — see the
    // t-47hc.10 note in CLAUDE.md), so a repetition that enters on the trailing comma
    // cannot un-consume it. The guard IS the mechanism, which is why every bracketed
    // comma-separated list needs one; `( "," )?` after the repetition never gets reached.
    //
    // One core, three closers. The `)` form was written first and the `]`/`}` siblings
    // were missing for months — a `[1, 2,]` or `{ a: 1, }` fell through to
    // `@hand(decl_hand)` and was silently absorbed, which is exactly the class the leaf
    // frontier probe (t-myz7) exists to surface.
    if cond == "comma_not_rparen" { return comma_not_closer(st, Tk.RightParen) }
    if cond == "comma_not_rbracket" { return comma_not_closer(st, Tk.RightBracket) }
    if cond == "comma_not_rbrace" { return comma_not_closer(st, Tk.RightBrace) }
    // `.0` tuple index — a second-token guard, same reason every `.`-led branch needs one.
    if cond == "dot_number" {
        if st.cur().tk != Tk.Dot { return false }
        if st.pos + 1 >= st.toks.length { return false }
        return st.toks[st.pos + 1].kind == "NUMBER"
    }
    if cond == "dot_plain_field" {
        if st.cur().tk != Tk.Dot { return false }
        if st.pos + 1 >= st.toks.length { return false }
        // The field name is whatever `consume_field_name` accepts — an identifier OR a
        // reserved-but-inactive keyword (`x.ref`, `x.owned`). Reading the shared
        // `tk_is_field_name` rather than the grammar's coarse `kind` is what lets the
        // native branch cover the hand's full acceptance set (t-47hc.33.1).
        if !tk_is_field_name(st.toks[st.pos + 1].tk) { return false }
        if st.pos + 2 >= st.toks.length { return true }
        if st.toks[st.pos + 2].tk != Tk.LeftParen { return true }
        // A `(` follows: this is an enum ctor only if the BASE reads as a type name.
        return !base_pred("base_upper_ident", st)
    }
    // The EXACT COMPLEMENT of dot_plain_field's last clause (t-47hc.33 form 6): the
    // `Type.Variant(args)` reading the `.field` branch declines. Deliberately does NOT
    // test the base itself — `@when(base_upper_ident)` on the branch does that, so the
    // two halves of `dot_plain_field`'s `!base_pred(...)` stay ONE predicate rather than
    // being restated here and drifting. Shape only: `.` IDENT `(`.
    if cond == "dot_enum_ctor" {
        if st.cur().tk != Tk.Dot { return false }
        if st.pos + 2 >= st.toks.length { return false }
        if !tk_is_field_name(st.toks[st.pos + 1].tk) { return false }
        return st.toks[st.pos + 2].tk == Tk.LeftParen
    }
    if cond == "qdot_plain_field" {
        if st.cur().tk != Tk.QuestionDot { return false }
        if st.pos + 1 >= st.toks.length { return false }
        if !tk_is_field_name(st.toks[st.pos + 1].tk) { return false }
        if st.pos + 2 >= st.toks.length { return true }
        let after = st.toks[st.pos + 2]
        if after.tk != Tk.LeftParen { return true }
        return st.store.lines.to_linecol(st.toks[st.pos + 1].pos).line != st.store.lines.to_linecol(after.pos).line
    }
    // The EXACT COMPLEMENT of qdot_plain_field: `?.` IDENT with a SAME-LINE `(`.
    // qdot_plain_field returns TRUE (a plain optional chain) when the `(` opens the NEXT
    // line, because the hand gates the call on `current_line == prev_line` — a `(` on the
    // following line is a new statement, not this call's argument list. Both halves read
    // the same two token positions, so keeping them mutually exclusive is a matter of
    // testing the same line relation in opposite directions, which is what this does.
    if cond == "qdot_method_call" {
        if st.cur().tk != Tk.QuestionDot { return false }
        if st.pos + 2 >= st.toks.length { return false }
        if !tk_is_field_name(st.toks[st.pos + 1].tk) { return false }
        let after = st.toks[st.pos + 2]
        if after.tk != Tk.LeftParen { return false }
        return st.store.lines.to_linecol(st.toks[st.pos + 1].pos).line == st.store.lines.to_linecol(after.pos).line
    }
    if cond == "ident_lbrace" {
        if st.cur().kind != "IDENT" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        return st.toks[st.pos + 1].text == "{"
    }
    // `~Name {` seen FROM the tilde — the quote-body splice-struct lookahead
    // (parse_leaf_common's `check(Identifier) && peek_after_ident_is_lbrace()`,
    // evaluated after consuming `~`). BRANCH-LEADING by design: emit renders only
    // leading predicates into a branch guard, so a mid-sequence `@peek` after the
    // `~` was silently dropped from the generated parser — the splice-struct arm
    // then swallowed EVERY `~` and the greedy splice below it was dead code (the
    // interpreter fallback masked it; the emit/exec divergence class).
    if cond == "tilde_ident_lbrace" {
        if st.cur().text != "~" { return false }
        if st.pos + 2 >= st.toks.length { return false }
        if st.toks[st.pos + 1].kind != "IDENT" { return false }
        return st.toks[st.pos + 2].text == "{"
    }
    // `Ident {` that is a PLAIN STRUCT LITERAL — i.e. `ident_lbrace` MINUS the two
    // IDENT-led forms that share those exact two tokens but mean something else
    // (t-47hc slice 8). The hand `parse_ident_expr` (parse/mod.av) tests all three
    // in this order, so a native struct-literal branch must exclude the other two
    // or it silently captures them:
    //   1. `table { … }` / `table<Row> { … }` — the TABLE literal, checked FIRST by
    //      the hand precisely because it also starts ident+`{`.
    //   2. a REGISTERED `kw { … }` feature construct (`grammar { … }` today) —
    //      dispatched to the feature's own parse_expr, which owns the block.
    // Both stay with the `@hand` tail; only what is left is a struct literal.
    //
    // The registered-keyword half is answered by the REGISTRY, not by matching
    // names: `lookup_expr_parser` is the same table `parse_ident_expr` consults,
    // so a package registering a new `kw { }` construct is excluded automatically
    // and this predicate can never drift from the dispatch it mirrors. (`table` is
    // not registry-driven — it is built into parse_ident_expr — so it is named
    // here exactly as the hand names it, which is transcription, not a heuristic.)
    //
    // With NO delegate threaded there is no registry to consult, so the answer is
    // CONSERVATIVE: not plain. Failing toward the hand parser is the safe
    // direction — a false negative merely leaves a struct literal to the hand
    // (which parses it correctly, byte-identically), whereas a false positive
    // would let a native branch swallow a `kw { … }` construct whose feature owns
    // the block. Absence of information must never widen what the grammar claims.
    // `IDENT` immediately followed by a TEMPLATE — a TAGGED TEMPLATE, `` tag`…` ``
    // (t-47hc slice 8). Needed because a grammar branch is dispatched on its FIRST
    // TOKEN only: without this, an `n:IDENT t:TEMPLATE` branch would be ENTERED on
    // every identifier and then fail matching the second token, rather than falling
    // through to the plain-identifier branch beside it. (That is the exact failure
    // #1037 hit and documented on the `.`-led postfix forms.)
    // A PLAIN identifier — an IDENT that is NOT the head of any other IDENT-led form,
    // i.e. not followed by `{` and not followed by a TEMPLATE (t-47hc slice 8).
    // Load-bearing, not an optimisation: without it the bare-identifier branch is
    // entered on `table {` / `grammar {` too, yields a bare `Ident`, and leaves the
    // `{ … }` unconsumed — so those constructs would silently stop reaching the
    // `@hand(primary_base)` tail that parses them. Excluding both suffixed shapes here
    // is what makes the fall-through to the hand parser correct by construction.
    if cond == "ident_plain" {
        if st.cur().kind != "IDENT" { return false }
        if st.pos + 1 >= st.toks.length { return true }
        let nx = st.toks[st.pos + 1]
        // A TYPED table literal `table<Row> { … }` is NOT a bare ident followed by a
        // comparison — decline so it falls through to `@hand(ident_primary)`, which owns
        // every IDENT-led disambiguation (parse_ident_expr checks the table form BEFORE
        // any postfix). The sibling `ident_lbrace_plain` right below already excludes the
        // UNTYPED `table { … }` for exactly this reason; the typed form was missed.
        //
        // Consequence of the miss: `table` was consumed as a plain IDENT and the `<` left
        // to the postfix generic-call speculation, which parses `Row`, finds `>`, expects
        // `(`, sees `{`, and rolls back — leaving `table` as a bare reference, i.e.
        // `undefined variable table`. Only in STATEMENT position, because a `let`
        // initializer reaches the hand first, which is what made it look positional
        // rather than a predicate gap (tests/table_cells_test.av, reachable once #1075
        // routed fn bodies natively).
        //
        // Token-level mirror of the hand's `peek_is_table_row_type`: `<` IDENT `>` `{`.
        // emit lowers `@peek` to this same `lookahead_ok`, so both engines get the fix.
        if st.cur().text == "table" && nx.text == "<" && st.pos + 4 < st.toks.length
            && tok_starts_word(st.toks[st.pos + 2])
            && st.toks[st.pos + 3].text == ">"
            && st.toks[st.pos + 4].text == "{" { return false }
        if nx.kind == "TEMPLATE" { return false }
        // Decline a following `{` only when a sibling branch actually takes it. See
        // ident_lbrace_owned_elsewhere: with `allow_struct_lit` off nobody does, and a
        // blanket decline sent the subject of every `match`/`if`/`while` to the tail.
        return nx.text != "{" || !ident_lbrace_owned_elsewhere(st)
    }
    if cond == "ident_template" {
        if st.cur().kind != "IDENT" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        return st.toks[st.pos + 1].kind == "TEMPLATE"
    }
    if cond == "ident_lbrace_plain" {
        if st.cur().kind != "IDENT" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        if st.toks[st.pos + 1].text != "{" { return false }
        return !ident_lbrace_is_feature_form(st)
    }
    // The exact COMPLEMENT of ident_lbrace_plain's exclusion, plus the TYPED table
    // literal — i.e. the two `parse_ident_expr` forms no native branch claims:
    // `table { … }` / `table<Row> { … }`, and a REGISTERED `kw { … }` feature
    // construct (grammar / sql / regex, via lookup_expr_parser).
    //
    // t-myz7. Measured, not assumed: refusing BOTH production leaves across all 249
    // non-test compiler sources attributes 117 refusals to exactly 10 files, and every
    // one of those files contains one of these two literals. They are the whole
    // valid-input residue of `@hand(primary_base)` AND of `@hand(decl_hand)` — the two
    // leaves are reached at the SAME sites, which is why refusing either one alone
    // measures zero (the other silently covers).
    //
    // The typed-table test is the token-level mirror `ident_plain` already carries
    // (`<` WORD `>` `{`), NOT the hand's raw-byte `peek_is_table_row_type` scan — one
    // spelling of the discrimination, reused, so the two cannot drift.
    if cond == "ident_lbrace_feature" {
        if st.cur().kind != "IDENT" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        let nx = st.toks[st.pos + 1]
        if nx.text == "{" { return ident_lbrace_is_feature_form(st) }
        // `table<Row> {` — the typed form, whose `<` would otherwise be read as a
        // comparison against a variable named `table`.
        return st.cur().text == "table" && nx.text == "<" && st.pos + 4 < st.toks.length
            && tok_starts_word(st.toks[st.pos + 2])
            && st.toks[st.pos + 3].text == ">"
            && st.toks[st.pos + 4].text == "{"
    }
    // Tuple-destructure `for (a, b) in ...`, checked before consuming `for`.
    if cond == "for_destructure" {
        return st.cur().text == "for" && st.pos + 1 < st.toks.length && st.toks[st.pos + 1].text == "("
    }
    // `match {` with no subject. The hand parse_match_statement decides it the same way:
    // `match`, then an immediate `{`.
    if cond == "match_subjectless" {
        return st.cur().text == "match" && st.pos + 1 < st.toks.length && st.toks[st.pos + 1].tk == Tk.LeftBrace
    }
    // `match <subject> table { … }` — the TABLE sub-language. The hand decides this AFTER
    // parsing the subject (`check(Tk.Identifier) && current_lexeme == "table"`), which a
    // FIRST-set guard cannot see. Equivalent, and decidable from tokens alone: scan to the
    // body `{` and ask whether the token just before it is the identifier `table`. The
    // subject cannot itself contain a `{` because the header parses with allow_struct_lit
    // off, so the first depth-0 `{` IS the body brace; `(`/`[` nesting is tracked so a
    // subject like `f(x)[0]` cannot end the scan early. Bounded by the header's length.
    if cond == "match_table" {
        if st.cur().text != "match" { return false }
        mut i = st.pos + 1
        mut depth = 0
        while i < st.toks.length {
            let t = st.toks[i]
            if t.kind == "EOF" { return false }
            if t.tk == Tk.LeftParen || t.tk == Tk.LeftBracket { depth = depth + 1 }
            else if t.tk == Tk.RightParen || t.tk == Tk.RightBracket { depth = depth - 1 }
            else if t.tk == Tk.LeftBrace && depth <= 0 {
                // The body brace. The table form is exactly `… table {`.
                return i > st.pos + 1 && st.toks[i - 1].kind == "IDENT" && st.toks[i - 1].text == "table"
            }
            i = i + 1
        }
        false
    }
    // `if let v = x { … }` — the BIND-FRESH form, which desugars to a temp + a
    // none-check + an unwrap-bind prepended to the then-block, and stays the hand's.
    // The hand decides it the same way, one token later: advance past `if`, then
    // `check(Tk.KwLet)`. Checked here BEFORE consuming `if`, so the ordinary branch's
    // FIRST stays a plain `if`.
    if cond == "if_let" {
        return st.cur().tk == Tk.KwIf && st.pos + 1 < st.toks.length && st.toks[st.pos + 1].tk == Tk.KwLet
    }
    // t-bwjg: the two quote kinds whose BODY is not a block expression, split so each can
    // be routed on its own. `type` parses a type_expr into an Expr.TypeLit carrier and is
    // NATIVE (quote_type_expr); `arm` builds a synthetic single-armed MatchExpr envelope
    // and is still the hand's. Both are checked BEFORE `quote` is consumed, so the plain
    // block-bodied branch's FIRST stays a bare `quote`. The hand decides the same thing
    // one token later, in parse_quote_kind.
    if cond == "quote_arm" {
        if st.cur().text != "quote" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        return st.toks[st.pos + 1].text == "arm"
    }
    if cond == "quote_type" {
        if st.cur().text != "quote" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        return st.toks[st.pos + 1].text == "type"
    }
    if cond == "comma_ident" {
        return st.cur().text == "," && st.pos + 1 < st.toks.length && st.toks[st.pos + 1].kind == "IDENT"
    }
    // The component-def `body: TokenStream` marker gate (t-47hc slice A):
    // the WORD `body` followed by a colon — the hand's `current_lexeme ==
    // "body" && peek_after_ident_is_colon()`. Both halves matter: without
    // the colon check a VALID `body()` call statement in a def body would
    // enter the marker group, fail `":"`, and roll the whole component back
    // to the hand on well-formed input.
    if cond == "body_marker" {
        return st.cur().text == "body" && st.cur().kind == "IDENT" &&
            st.pos + 1 < st.toks.length && st.toks[st.pos + 1].text == ":"
    }
    // The component-body `let` gate (t-47hc slice A): comp_field owns EVERY
    // `let` inside a component def — the annotation-less `let x = 5` must fail
    // comp_field's `":"` (the hand's parse_comp_def_body error), never fall
    // through to `declaration`'s routed let_decl, which would accept it. The
    // gate is the guard-sanctioned spelling of that total shadow: branch
    // selection is unchanged (comp_field already won on `let` by order), but
    // the dispatch is now a declared lookahead, not a silent FIRST overlap.
    if cond == "kw_let" {
        return st.cur().tk == Tk.KwLet
    }
    // ── component INSTANTIATION config pairs (t-47hc.5.1 slice B) ──
    //
    // `parse_comp_config_pairs` is a hand-rolled `while` whose continuation
    // depends on RAW-SOURCE peeks at the current key token. Expressed here as
    // two `@peek`-gated alternatives over `( config_pair )*`: the loop simply
    // ends when neither cond matches, which is what the hand's `keep_going =
    // false` does.
    //
    // The ORDER of the hand's bails is load-bearing and is reproduced exactly
    // in `cfg_pair_common`: `on` is not a config key, `fn`/`component`/`let`
    // end the pairs, and a following `{` means a NESTED BLOCK rather than a
    // value — that brace test must come before any value test, or `key {`
    // would be read as a pair.
    if cond == "cfg_pair_value" {
        if !cfg_pair_common(st) { return false }
        let at = cfg_pair_after(st)
        // string / number / true / false — the four value leads, each decided
        // by the SHARED core so the hand and this cond cannot disagree.
        return src_next_nonws_is_quote(st.src, st.src.length, at)
            || src_next_nonws_is_digit(st.src, st.src.length, at)
            || src_next_nonws_starts_with(st.src, st.src.length, at, "true")
            || src_next_nonws_starts_with(st.src, st.src.length, at, "false")
    }
    if cond == "cfg_pair_eq" {
        if !cfg_pair_common(st) { return false }
        return src_next_nonws_is_single_eq(st.src, st.src.length, cfg_pair_after(st))
    }
    // A body item the native instantiation rule may own. `parse_comp_block_body`
    // has four special arms BEFORE it falls through to parse_declaration —
    // nested `component …`, `ident name {`, `ident {`, and the `ident() { … }`
    // method shorthand — and each ABORTS on a malformed form where a plain
    // `declaration` would happily read the pieces as expression statements.
    // `component C inst { nested name }` is the witness: the hand reports
    // F0001/F0013, while an ungated body parsed it clean as two expr statements
    // and, reporting nothing, COMMITTED the @try with the wrong tree.
    //
    // So the native rule declines them: the body loop stops, the rule then
    // fails to find `}`, reports, and @try rolls back into the hand — which
    // owns these forms verbatim. Porting the four arms faithfully is slice B2b;
    // this cond is the seam that keeps the split honest meanwhile.
    // The keyword-prefixed INSTANTIATION shape: `component <name> <inst> {`.
    //
    // `implements` must be excluded explicitly. It lexes as an ordinary IDENT,
    // so without this `component Cmd implements { }` matches the instantiation
    // shape and parses as an instance NAMED `implements` — silently swallowing
    // the hand's "expected trait name after `implements`" error, because a
    // clean parse never rolls the @try back. The hand tests for the word
    // before it ever considers the instance form; so does this.
    if cond == "comp_inst_shape" {
        if st.pos + 3 >= st.toks.length { return false }
        if st.toks[st.pos + 1].kind != "IDENT" { return false }
        let inst = st.toks[st.pos + 2]
        if inst.kind != "IDENT" || inst.text == "implements" { return false }
        return st.toks[st.pos + 3].tk == Tk.LeftBrace
    }
    // ── Slice C: the BARE-IDENT instantiation, `name inst { … }` ──
    //
    // Same shape as `comp_inst_shape` minus the `component` keyword, plus the
    // registry check that makes it decidable at all. The raw/structured split moves
    // into the cond for the same reason the nested arms' does: the hand asks the
    // registry AFTER consuming `name inst {`, and a grammar cannot branch on a parse
    // result — but the component name is the current token either way, so the two are
    // equivalent.
    if cond == "bare_comp_inst" || cond == "bare_comp_inst_raw" {
        if st.cur().kind != "IDENT" { return false }
        if !comp_name_is_registered(st) { return false }
        let want_raw = cond == "bare_comp_inst_raw"
        if comp_name_is_raw_body(st) != want_raw { return false }
        if st.pos + 2 >= st.toks.length { return false }
        if st.toks[st.pos + 1].kind != "IDENT" { return false }
        return st.toks[st.pos + 2].tk == Tk.LeftBrace
    }
    // ── The four `parse_comp_block_body` arms, as dispatch conds (t-47hc.5.1 B2b) ──
    //
    // Each is gated on the SAME shared raw-source core the hand's own arm reads
    // (chars.av), so the two front ends cannot disagree about what counts as a
    // following word / brace / empty call block. The hand decides RAW vs STRUCTURED
    // *after* consuming `name inst {`, by asking the feature registry; a grammar
    // cannot branch on a parse RESULT, so the split moves up here into the cond —
    // equivalent, because the component name is the current token either way.
    //
    // Arm 2: `ident name {` — a nested block with its own instance name.
    if cond == "comp_nested_named" {
        if st.cur().kind != "IDENT" || comp_name_is_raw_body(st) { return false }
        return src_next_nonws_is_value_word(st.src, st.src.length, cfg_pair_after(st))
    }
    // Arm 3: `ident {` — the brace form, whose instance name IS the component
    // name (parse_comp_block_body passes comp_name twice, not a fresh name).
    if cond == "comp_nested_bare" {
        if st.cur().kind != "IDENT" || comp_name_is_raw_body(st) { return false }
        return src_next_nonws_is_lbrace(st.src, st.src.length, cfg_pair_after(st))
    }
    // The RAW-BODY twins of arms 2/3: a component registered with `body: TokenStream`
    // has its instance body captured VERBATIM rather than parsed, so the same two
    // surface shapes route to a `@rawbrace` rule instead.
    if cond == "comp_nested_raw_named" {
        if st.cur().kind != "IDENT" || !comp_name_is_raw_body(st) { return false }
        return src_next_nonws_is_value_word(st.src, st.src.length, cfg_pair_after(st))
    }
    if cond == "comp_nested_raw_bare" {
        if st.cur().kind != "IDENT" || !comp_name_is_raw_body(st) { return false }
        return src_next_nonws_is_lbrace(st.src, st.src.length, cfg_pair_after(st))
    }
    // Arm 4: `name() { … }` — the method shorthand (spec §4.1), distinguished from
    // a `name()` CALL statement by the trailing block.
    if cond == "comp_method" {
        if st.cur().kind != "IDENT" { return false }
        return src_at_empty_call_block(st.src, st.src.length, cfg_pair_after(st))
    }
    if cond == "double_colon" {
        return st.cur().text == ":" && st.pos + 1 < st.toks.length &&
            st.toks[st.pos + 1].text == ":" && st.toks[st.pos + 1].pos == st.cur().pos + 1
    }
    if cond == "ident_colon" {
        if st.cur().kind != "IDENT" { return false }
        if st.pos + 1 >= st.toks.length { return false }
        return st.toks[st.pos + 1].text == ":"
    }
    // `( IDENT :` — the TYPED-LAMBDA paren opener, checked from BEFORE `(` (at the branch
    // entry, cur == `(`), so `paren_expr` can be an unfactored `@peek(lparen_ident_colon)
    // "(" param … ` whose builds SPAN from the `(` byte (mirroring the hand parse_paren_expr,
    // whose Tuple/Grouping/Lambda alloc_at anchors at `(`). It is the position-0 twin of
    // `ident_colon` (which the hand's peek_after_ident_is_colon checks AFTER consuming `(`):
    // cur is `(`, the NEXT token an IDENT, the one after that `:`. Byte-identical to the hand
    // modulo the `::` edge (a `( x :: y )` grouping — same edge `ident_colon` already carries).
    if cond == "lparen_ident_colon" {
        if st.cur().text != "(" { return false }
        if st.pos + 2 >= st.toks.length { return false }
        if st.toks[st.pos + 1].kind != "IDENT" { return false }
        return st.toks[st.pos + 2].text == ":"
    }
    // t-47hc.24 — "is this token position a DECLARATION lead?", the narrowing that
    // takes IDENT off `@hand(decl_hand)`'s unconditional FIRST.
    //
    // decl_hand's FIRST claimed a bare IDENT because parse_declaration_hand handles
    // ONE identifier-led declaration — the component instantiation `Comp inst { … }`
    // — and falls through to `self.parse_statement()` for everything else. That
    // fall-through made the hand parser the entry point for EVERY identifier-led
    // statement (`x = 1`, `f(a)`, `x.m()`): the DSL handed the item to a Parser
    // delegate purely so the delegate could hand it straight back to the DSL.
    //
    // The gate keeps the component form on the hand path and routes the rest to the
    // `statement` alternative directly. It is deliberately a token-level SUPERSET of
    // Parser.peek_after_ident_is_ident_not_keyword (which additionally excludes a
    // keyword list, at char level): a false POSITIVE is inert — parse_declaration_hand
    // re-checks precisely and still falls through to parse_statement, reproducing
    // today's path exactly — while a false NEGATIVE would silently re-route a real
    // component instantiation. Asymmetric risk, so the gate errs wide.
    if cond == "decl_lead" {
        // Non-IDENT leads (doc comments, `@`, `export`, the decl keywords) are the
        // hand's unconditionally — the narrowing is IDENT-only.
        if st.cur().kind != "IDENT" { return true }
        if st.pos + 2 >= st.toks.length { return false }
        // `Comp inst {`: an instance NAME (the hand scans a raw word starting with a
        // letter or `_`, so keyword-kinded tokens count too) then the block brace.
        if !tok_starts_word(st.toks[st.pos + 1]) { return false }
        // ...and NOT a keyword that cannot name an instance. This used to be omitted
        // deliberately — the gate erred wide because a false positive was inert, the
        // delegate re-checking precisely and falling through. That is only true while
        // the delegate exists, and it made `t with { … }` (plus `x match {`, `x if {`,
        // …) reach `@hand(decl_hand)` for no reason but to be handed straight back.
        // Shares the hand's ONE list, so the gate cannot be narrower than the check it
        // fronts — which is the false NEGATIVE the original comment rightly feared.
        if word_excluded_as_instance_name(st.toks[st.pos + 1].text) { return false }
        return st.toks[st.pos + 2].tk == Tk.LeftBrace
    }
    true
}

/// The byte offset just past the staged token's lexeme — where every raw-source
/// config-pair scan begins. The grammar twin of the hand's
/// `current_start + current_lexeme.length`: `Token.pos` IS the source byte
/// offset, so the two are the same number over the same bytes.
fn cfg_pair_after(st: PState) -> int {
    st.cur().pos + st.cur().text.length
}

/// Is the CURRENT token the name of a component registered with `body: TokenStream`?
/// The one question in `parse_comp_block_body` that tokens cannot answer: the hand
/// asks the feature REGISTRY (`component_is_raw_body`), which an earlier
/// `component … { body: TokenStream }` declaration in this same parse populated —
/// on the native path too, since mk_component_def_g registers through the very same
/// delegate this reads. No delegate (the pure-grammar harnesses) means no registry
/// and so no raw-body component can have been declared: false is not a guess there,
/// it is the only reachable answer.
fn comp_name_is_raw_body(st: PState) -> bool {
    if st.hand_delegate == null { return false }
    component_is_raw_body(st.hand_delegate!.features, st.cur().text)
}

/// Is the current identifier a REGISTERED component name? (t-47hc.5.1 slice C)
///
/// The hand reaches the bare-IDENT instantiation by looking the current lexeme up
/// in the registry's `stmt_parsers` map — `register_component_def` puts every
/// component name there via `register_component_name`. So this asks the SAME map
/// rather than re-deriving a token-level notion of "component-like name", which is
/// not decidable: `acct_sr a { … }` and `foo bar { … }` are the same token shape
/// and differ only by whether a `component` declaration registered the name.
fn comp_name_is_registered(st: PState) -> bool {
    if st.hand_delegate == null { return false }
    lookup_stmt_parser(st.hand_delegate!.features, st.cur().text) != null
}

/// The shared prefix of both config-pair conds — every reason
/// `parse_comp_config_pairs` STOPS before it even looks at a value, in the
/// hand's own order. Keep this in lockstep with that loop's head.
fn cfg_pair_common(st: PState) -> bool {
    // `fn` / `component` / `let` end the pairs and begin the block body.
    let tk = st.cur().tk
    if tk == Tk.KwFn || tk == Tk.KwComponent || tk == Tk.KwLet { return false }
    if st.cur().kind != "IDENT" { return false }
    // `on` is reserved for the event-handler form, never a config key.
    if st.cur().text == "on" { return false }
    // A following `{` is a NESTED BLOCK, not a value — checked BEFORE any
    // value test, matching the hand.
    !src_next_nonws_is_lbrace(st.src, st.src.length, cfg_pair_after(st))
}

/// True when a token's lexeme begins with a letter or `_` — the token-level twin of
/// Parser.peek_after_ident_is_ident_not_keyword's raw-char `is_alpha` scan. Kind is
/// deliberately NOT consulted: the hand reads a WORD out of the source, so a
/// keyword-kinded token (`in`, `defer`, …) is a word there too, and the `decl_lead`
/// gate must not be narrower than the hand check it fronts.
fn tok_starts_word(t: Token) -> bool {
    if t.text == "" { return false }
    is_ident_start_code(code_at(t.text, 0))
}

/// The WRITE twin of modes_flag: a copy of `modes` with the named flag turned OFF.
/// The `@off(flag)` mode-SET marker's core, shared by the executor (push_mode_off)
/// AND the emitted parser (emit lockstep), so the two can never disagree — the
/// same discipline modes_flag gives @when. The mapped names MUST match
/// `seed_parser.off_flag_supported` (the single source of truth for the @off flag
/// SET), which the seed parser enforces: an unsupported flag (typo, or the READ-only
/// `at_quote_top` predicate) is REJECTED at parse time, so the trailing
/// `modes` fall-through here is an unreachable-by-contract defensive default,
/// never a silent no-op on a live grammar.
export fn modes_with_flag_off(modes: ExprModes, flag: string) -> ExprModes {
    if flag == "allow_struct_lit" { return modes with { allow_struct_lit: false } }
    if flag == "allow_dot_postfix" { return modes with { allow_dot_postfix: false } }
    if flag == "allow_it_sugar" { return modes with { allow_it_sugar: false } }
    if flag == "cell_mode" { return modes with { cell_mode: false } }
    modes
}

/// Mint a hygienic temp name — the free-function form of PState.fresh, so a grammar
/// BUILD ACTION and the emitted parser can both call it by the same name. Shared, not
/// re-spelled: the counter must be one sequence per parse or two desugars could collide.
export fn fresh_name(st: PState, tag: string) -> string {
    st.fresh(tag)
}

/// The `@bump(counter)` twin of modes_with_flag_off/on — INCREMENTS an int cell rather
/// than setting a bool. `quote_depth` is the only one today: the read side already ships
/// (`@when(at_quote_top)` is `== 0`, `@when(in_quote_body)` is `> 0`, #1033), and this is
/// the set side those predicates were waiting on. Kept in lockstep with
/// seed_parser.bump_counter_supported — a new bumpable counter is added in both.
export fn modes_with_counter_bumped(modes: ExprModes, counter: string) -> ExprModes {
    if counter == "quote_depth" { return modes with { quote_depth: modes.quote_depth + 1 } }
    modes
}

/// The `@on(flag)` SET-ON twin of modes_with_flag_off — turns the named settable
/// ExprModes flag TRUE. Kept in lockstep with seed_parser.on_flag_supported.
export fn modes_with_flag_on(modes: ExprModes, flag: string) -> ExprModes {
    if flag == "allow_struct_lit" { return modes with { allow_struct_lit: true } }
    if flag == "allow_dot_postfix" { return modes with { allow_dot_postfix: true } }
    if flag == "allow_it_sugar" { return modes with { allow_it_sugar: true } }
    if flag == "cell_mode" { return modes with { cell_mode: true } }
    modes
}

/// True iff every `@when(flag)` predicate on the branch holds under the live
/// modes. Predicates AND — all must hold for the branch to apply. A branch with
/// no predicate is trivially ok. This is the executor half of `@when`; the emit
/// half folds the same `modes_flag(...)` conjuncts into the branch guard.
fn branch_pred_ok(seq: GSeq, st: PState) -> bool {
    for item in seq.items {
        match item.prim {
            .Pred(flag) -> { if !pred_ok(flag, st) { return false } }
            // `@peek(cond)` gates on an upcoming-token test rather than a mode — the
            // token-stream sibling; emit folds the equivalent guard (peek_guard).
            .Peek(cond) -> { if !lookahead_ok(cond, st) { return false } }
            _ -> {}
        }
    }
    true
}

/// The first `n` elements of `xs` (for rolling `st.diags` back after a failed
/// speculative parse — the list analogue of NodeStore.truncate_to_mark).
fn list_take<T>(xs: List<T>, n: int) -> List<T> {
    mut out: List<T> = []
    mut i = 0
    for x in xs {
        if i >= n { return out }
        out.push(x)
        i = i + 1
    }
    out
}

/// Execute an alternation: pick the first branch whose predicate gate holds AND
/// whose FIRST matches the current token (recursive descent), execute it. A
/// `@try` branch is BOUNDED-BACKTRACKING — snapshot before, roll back + try the
/// next branch if it fails (adds a diagnostic). No match → an Error node +
/// diagnostic (error-tolerant), unless a speculative branch rolled back (then a
/// clean Nil — the caller decides, and diags/had_error are already restored).
/// The executor twin of emit's `annots_or`: a nested group carries no annotations of
/// its own, so an `@expect` on the OWNING sequence must still reach items inside its
/// `( … )*`. Keeping these two in lockstep is what stops the interpreter reporting a
/// different diagnostic than the generated parser for the same grammar.
fn exec_annots_or(inner: List<GAnnot>, outer: List<GAnnot>) -> List<GAnnot> {
    if inner.length > 0 { return inner }
    outer
}

/// A GROUP's alternation — never a rule body, so the no-match tail behaviours below stay
/// off (see exec_node_at's `rule_body`).
fn exec_node(g: Grammar, node: GNode, st: PState, env: CapEnv, multi: bool, outer_annots: List<GAnnot>) -> CapVal {
    exec_node_at(g, node, st, env, multi, outer_annots, false)
}

/// `rule_body` is true ONLY when this alternation IS a rule's body (exec_rule), false for
/// a GROUP inlined inside a sequence (exec_primary's `.Group`). The two no-match fallbacks
/// below — the unguarded TAIL and the single-branch run — are RULE-level behaviours that
/// mirror how emit lowers a rule (emit_single_branch / emit_dispatch). A GROUP is not
/// lowered that way and has its own pinned semantics: a mandatory One group whose FIRST
/// fails is NOT entered, it reports the alternation's no-branch error and the enclosing
/// sequence carries on. `require_abort_test`'s "a @require on a group's LEAD item is
/// unreachable when the group's FIRST fails" pins exactly that, and running a group's lone
/// branch unconditionally would turn its two reports into one abort.
fn exec_node_at(g: Grammar, node: GNode, st: PState, env: CapEnv, multi: bool, outer_annots: List<GAnnot>, rule_body: bool) -> CapVal {
    match node {
        .Alt(branches) -> {
            let empty: List<string> = []
            mut tried_spec = false
            // A rolled-back `@try` restores the delegate UNCONDITIONALLY (t-3keo).
            //
            // This used to be armed only when some NON-speculative branch LED with an
            // `@hand` leaf — a question about the RETRY branch. But the thing that moves
            // the delegate is the SPECULATIVE branch's own body reaching a hand leaf,
            // which is unrelated. `paren_expr` is where the two come apart: its native
            // branches lead with the literal `"("`, so nothing armed, while its `@try`
            // branches parse `a:expression` and reach `@hand(ident_primary)` on any bare
            // IDENT. The rollback then rewound `st.pos` and left the delegate ahead, so
            // `(v)` failed to parse where `(1)` / `(true)` / `("s")` / `([1])` — native
            // primaries that never touch the delegate — all succeeded.
            //
            // Restoring is simply what `@try` means: on failure the branch must leave no
            // trace, and the delegate is part of the state it touched. `save_hand_state`
            // already no-ops when no delegate is threaded, so an alternation that cannot
            // reach one pays nothing.
            for b in branches {
                if branch_pred_ok(b, st) && tok_starts_seq(g, b, st, empty) {
                    if b.speculative {
                        // Snapshot the cursor + node store + diagnostics, run the
                        // branch, and commit only if it added no diagnostic;
                        // otherwise roll everything back and try the next branch
                        // (the save_state/restore_state analogue for f<T>).
                        tried_spec = true
                        let s_pos = st.pos
                        let s_mark = st.store.mark()
                        let s_diags = st.diags.length
                        let s_err = st.had_error
                        let s_hand = st.save_hand_state()
                        let s_postfix = st.save_postfix_state()
                        // The PState's OWN hygiene counter (native `@gensym` mints)
                        // rolls back with the store, same argument as the delegate's
                        // in restore_hand_state: the branch's minted-into rows die
                        // with s_mark, so keeping the bump would drift every later
                        // mint off the pure-hand oracle.
                        let s_gensym = st.gensym_seq
                        // GAP3 @try-with-builds: snapshot the capture env so a
                        // rolled-back speculative branch's label bindings (now
                        // permitted, to feed a `-> build`) cannot leak to a sibling.
                        // bind()/set_scalar/append_* reassign env.caps to a fresh
                        // list, so the old reference is an immutable snapshot; the
                        // emit side never leaks (labels are auto-scoped locals).
                        let s_caps = env.caps
                        // t-47hc.21: run with a FRESH cut flag (a sibling branch's
                        // commit says nothing about this one) and restore the outer
                        // value afterwards, so an inner `@try` inside a group cannot
                        // commit the branch that encloses it.
                        let s_cut = env.cut
                        let s_cut_diags = env.cut_diags
                        let s_cut_err = env.cut_err
                        env.set_cut(false)
                        env.set_cut_frame(s_diags, s_err)
                        let v = exec_seq(g, b, st, env, multi, outer_annots)
                        let committed = env.cut
                        env.set_cut(s_cut)
                        env.set_cut_frame(s_cut_diags, s_cut_err)
                        // Past a `@cut` the branch OWNS its diagnostics: report and
                        // keep them instead of reading them as "wrong branch".
                        if committed || (st.diags.length == s_diags && st.had_error == s_err) {
                            return v
                        }
                        env.restore_caps(s_caps)
                        env.set_abort(false)
                        st.store.truncate_to_mark(s_mark)
                        st.restore_to(s_pos, s_diags, s_err)
                        st.restore_hand_state(s_hand)
                        st.restore_postfix_state(s_postfix)
                        st.set_gensym_seq(s_gensym)
                    } else {
                        return exec_seq(g, b, st, env, multi, outer_annots)
                    }
                }
            }
            // No branch's FIRST matched. A `@fallback` branch is the UNCONDITIONAL tail:
            // run it instead of reporting, so the RULE owns its diagnostic. This is the
            // native twin of the trailing-`@hand` tail role (emit's is_leading_hand
            // last-branch case), for a rule whose alternatives are all native — without
            // it such a rule can only ever emit the generic message below, and the two
            // closing-`]` diagnostics `index_tail` must reproduce are unreachable.
            // Checked AFTER the loop, so an earlier matching branch still wins.
            //
            // …but NOT after a speculation DECLINED (t-lqzu). "No branch's FIRST matched"
            // and "a branch matched, ran, and rolled back" are different states, and only
            // the first entitles the fallback to report. A `@fallback` is scoped to its own
            // led-form family — it owns the message for a token that starts neither of ITS
            // forms — so handing it an unrelated token makes it report on something it was
            // never about. With `@hand(postfix_suffix)` as the tail this was invisible: a
            // declining hand accepts any token and returns the base unchanged. Once the
            // delegate was deleted the tail became a `.`-requiring branch, so `a < b` —
            // whose generic-call branch enters on the `<` and un-decides — fell in here,
            // was told to find a FIELDNAME, reported, and the `@require` abort turned the
            // whole chain into `error_node_silent()`. The comparison then rendered
            // `(< <error> b)` with its LHS replaced.
            //
            // The `tried_spec` return below is the correct answer for that state: a clean
            // "no match" the caller decides about. A leading-`@hand` or recovery-owning
            // bare-ref tail is different and still runs after a rollback — that IS the
            // `@try`-rolls-back-into-the-hand-gate contract, and the decl routing needs it.
            // A fallback also only owns tokens its OWN guard admits. `postfix_suffix`'s FIRST
            // is the whole postfix-op set (`. ( [ ! ? ?. < catch`) — a deliberate SUPERSET of
            // what any branch can complete — so the `( postfix_suffix )*` loop enters on a
            // `<` even when nothing can consume it (`1 < 2`: the generic-call branch needs
            // `base_callable`, and a NUMBER base is not). The `@hand` tail used to absorb
            // that by declining; a `.`-led `@fallback` must not inherit the job, or every
            // comparison against a non-callable base reports "expected field name". So run
            // the fallback only when `branch_pred_ok` says its guard holds (for the `.`
            // branch that is `dot_postfix_ok`, which tests `st.cur().tk == Tk.Dot`), and
            // treat a guard-declining fallback as "this rule does not apply" — the same
            // clean no-match a rolled-back speculation yields, which is what lets the
            // repetition's no-progress break end the chain instead of reporting.
            //
            // An UNGUARDED fallback (index_tail's `]` branch) has no Pred items, so
            // branch_pred_ok is trivially true and it still runs exactly as before.
            mut fb_declined = false
            if !tried_spec {
                for fb in branches {
                    if fb.fallback {
                        if branch_pred_ok(fb, st) { return exec_seq(g, fb, st, env, multi, outer_annots) }
                        fb_declined = true
                    }
                }
            }
            // A SINGLE-branch alternation is run UNCONDITIONALLY by emit — there is
            // nothing to dispatch between, so `emit_single_branch` (and emit_node_items'
            // 1-branch case) emits the body with no FIRST guard and lets the branch's own
            // item validation own the diagnostic. exec_node FIRST-guarded it instead, and
            // that is where a stray token's recovery stopped: `expr_stmt = e:expression ->
            // ExprStmt(e)` declined to run, so this arm's generic "unexpected token"
            // replaced the expression ladder's own "expected expression" (t-zrn3).
            //
            // Only a PLAIN branch qualifies: a `@try` needs its rollback scaffold above,
            // and a `@peek`/`@when` gate is a real precondition, not a dispatch guard.
            if rule_body && branches.length == 1 && !branches[0].speculative && branch_pred_ok(branches[0], st) {
                return exec_seq(g, branches[0], st, env, multi, outer_annots)
            }
            // …and the OTHER two tail forms, which `@fallback` above is one third of
            // (t-zrn3). A bare ref to a rule that owns its own recovery, or a
            // leading-`@hand`, is equally the UNGUARDED TAIL: it runs on a token no
            // branch's FIRST matched, which is how a stray top-level token reaches the
            // hand parser's recovery. emit_dispatch honoured all three; this arm honoured
            // only `@fallback`, so `declaration`'s `| statement` tail was reachable in the
            // generated parser and unreachable here — and since a failed item is re-parsed
            // with the INTERPRETER, this arm's generic "unexpected token" was what shipped
            // (`then` / `)` / `,` / `* 5` all reported F0001 where the hand parser and the
            // generated parser both reported F0040). `dispatch_has_tail` is the SHARED
            // predicate both engines read, so the two cannot drift again.
            if rule_body && dispatch_has_tail(g, branches) {
                return exec_seq(g, branches[branches.length - 1], st, env, multi, outer_annots)
            }
            // A rolled-back speculative attempt is a clean "no match" (diags/had_error
            // already restored) — let the caller (an enclosing alternation, a `*`/`?`, or
            // a required position) decide; do NOT synthesise a spurious parse error.
            // `fb_declined` joins it for the same reason: a guarded fallback that declined is
            // this rule saying "not mine", not a parse error to synthesise (t-lqzu).
            if tried_spec || fb_declined { return CapVal.Nil }
            CapVal.Node(st.error_node("unexpected token `${st.cur().text}`"))
        }
    }
}

/// Execute one alternative: run each item (threading the shared env),
/// then apply the build.
fn exec_seq(g: Grammar, seq: GSeq, st: PState, env: CapEnv, multi: bool, outer_annots: List<GAnnot>) -> CapVal {
    // Phase 3a base-threading (executor twin of the emit seed): a fold_postfix_with
    // seq's item 0 is the postfix-chain BASE; seed st.postfix_base from it AFTER it
    // parses and BEFORE the ( postfix_suffix )* repetition, so each postfix_step wraps
    // the right base — whether the base is @hand(primary_base) (redundant: run_hand_expr
    // already seeded the same id + start_byte) or a grammar-BUILT literal (the ONLY path
    // that otherwise leaves st.postfix_base stale). sp_start = the base's start byte.
    let seeds_postfix = seq_seeds_postfix(seq)
    let sp_start = st.cur().pos
    mut last = CapVal.Nil
    mut count = 0
    for item in seq.items {
        last = exec_item(g, item, st, env, multi, exec_annots_or(seq.annots, outer_annots))
        // `@require` ABORT: a required terminal was missing, so stop building. The
        // rest of the sequence would consume tokens that belong to whatever comes
        // NEXT (the runaway `impl for Foo { }` body-swallow), and the caller's
        // statement-list loop is the thing that should synchronise. The flag lives on
        // the shared CapEnv, so an abort inside a nested group stops this sequence too
        // — the executor twin of the generated parser's early `return`.
        if env.abort { return CapVal.Node(st.error_node_silent()) }
        // A zero-width predicate (`@when` mode read / `@peek` lookahead) is NOT the base:
        // it consumes nothing and captures nothing, so skip it when locating item 0 —
        // exactly as the emit twin does with its `continue` BEFORE `idx` increments (so
        // there the first token-bearing item is idx 0). Without this the two sides drift
        // apart the moment a `fold_postfix_with` branch LEADS with a guard: the executor
        // seeds the base from the guard's Nil capture, `capval_to_expr` yields an error
        // node, and every postfix chain folded over it renders `(. <error> b)` while the
        // generated parser gets it right. `sp_start` needs no adjustment — predicates
        // consume no tokens, so the base's start byte is unchanged.
        if prim_is_pred(item.prim) { continue }
        // Seed ONLY for a grammar-BUILT base (item 0 not @hand): the @hand(primary_base)
        // base seeds itself inside run_hand_expr, so re-seeding it is dead work.
        if seeds_postfix && count == 0 && !prim_is_hand(item.prim) {
            st.seed_postfix(capval_to_expr(st, last), sp_start)
        }
        count = count + 1
    }
    match seq.build {
        // Pass-through: the sole item's value. A bare terminal stays a
        // Tok here; the Tok→literal conversion happens only when a RULE
        // yields it (capval_to_expr), so operator captures stay tokens.
        .None -> last
        .Var(name) -> env.get(name)
        .Call(name, args) -> apply_build(g, name, args, env, st)
    }
}

/// True iff a sequence's build is `fold_postfix_with` — its item 0 is the postfix-chain
/// BASE that must seed st.postfix_base before the ( postfix_suffix )* repetition runs.
/// True for THE chain rule — the one whose single branch folds a postfix chain
/// (`unary`). Its four chain fields are saved and restored around the rule body so a
/// nested chain can't be seen by the outer one (PState.restore_postfix_chain).
fn rule_seeds_postfix(g: Grammar, r: Rule) -> bool {
    match r.body {
        .Alt(branches) -> {
            for b in branches { if seq_seeds_postfix(b) { return true } }
            false
        }
    }
}

fn seq_seeds_postfix(seq: GSeq) -> bool {
    match seq.build {
        .Call(name, _) -> name == "fold_postfix_with"
        _ -> false
    }
}

/// ps3t.6.7 newline-sensitivity gate: true unless `item.sameline` (the `^`
/// marker) requires the current token to be on the same source line as the
/// previously-consumed token and it isn't. The line of a byte offset comes from
/// the store's LineIndex (built from the same source `Token.pos` indexes into),
/// so this is the executor mirror of the hand parser's `current_line ==
/// prev_line` postfix gate — a cross-line postfix (`.method` / `(` / `[` on the
/// next line) ends the chain instead of continuing it.
fn sameline_ok(st: PState, item: GItem) -> bool {
    if !item.sameline { return true }
    if st.pos == 0 { return true }
    let prev_line = st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line
    let cur_line = st.store.lines.to_linecol(st.cur().pos).line
    prev_line == cur_line
}

/// Execute one postfix item, honouring its repetition, and bind its
/// capture (scalar in a normal position, list-append inside `*`/`+`).
fn exec_item(g: Grammar, item: GItem, st: PState, env: CapEnv, multi: bool, annots: List<GAnnot>) -> CapVal {
    // `@cut` COMMIT POINT (t-47hc.21): reaching this item commits the enclosing
    // `@try`, so a diagnostic from here on is a real parse error rather than the
    // rollback signal. Recorded BEFORE the sub-parse — the commit covers this
    // item's own failure, which is the whole point (`… ".." @cut hi:expression`
    // must report a bad `hi`, not silently re-try the next branch). Lives on the
    // CapEnv because exec_rule mints a fresh one per rule invocation, so a cut
    // inside a called rule cannot leak out to its caller's `@try` — exactly the
    // function-scope isolation the generated parser gets for free from `s_cut`
    // being a local. Groups share the env, so a cut nested in one propagates up.
    if item.cut && st.diags.length == env.cut_diags && st.had_error == env.cut_err { env.set_cut(true) }
    // t-a9oy: ABORT A DOOMED BRANCH AT ITS CUT — the executor mirror of emit's
    // `if !s_cut { break }` (emit.av `cut_abort`, t-x2fb). WITHOUT this the executor
    // sets the commit flag above and then parses every remaining item anyway before
    // the speculative arm discards them, which for `paren_expr`'s cut-guarded lambda
    // BODY is a parse of the entire remaining expression: 2x per parenthesised group,
    // i.e. 2^n. Measured on `fn f() { if (…) || … {` with n terms, executor vs emit at
    // n=12: 9848ms vs 38ms; n=16 did not finish inside 60s.
    //
    // The commit guard is `cut || (no new diagnostics)` and diagnostics only ever GROW,
    // so once the flag is still false HERE the second disjunct can never recover — the
    // branch is provably going to roll back and everything past this point is wasted.
    // `env.cut` is sticky within the branch (a FRESH flag per speculative arm, restored
    // after), so an earlier cut that did commit correctly suppresses the abort, exactly
    // as emit's `s_cut` local does.
    //
    // Routed via the EXISTING `@require` abort channel rather than a new one: exec_seq
    // already stops on it and the speculative arm's rollback already clears it
    // (`env.set_abort(false)`), so a doomed branch lands on the same rollback path emit's
    // `break` targets. Silent error node — the branch is being discarded, so reporting
    // here would add a diagnostic the emit side never produces.
    //
    // WHY THIS WAS INVISIBLE (t-zrn3): both recovery oracles disable the static fallback,
    // so between them they measure emit and nothing else — while on invalid input the
    // DEFAULT production path re-parses the item with THIS executor. emit got the t-x2fb
    // fix; its mirror here was missed.
    if item.cut && !env.cut {
        env.set_abort(true)
        return CapVal.Node(st.error_node_silent())
    }
    // `@require`: a mismatch on this terminal ABORTS the rule. Detected by whether the
    // item reported — exec_primary's handle_missing already emits the sequence's
    // `@expect` message, so `@require` adds control flow only, never a second seam for
    // diagnostics. exec_seq reads the flag and stops.
    if item.require {
        // A RULE REFERENCE aborts on its FIRST, checked BEFORE the call — not on
        // "did diags grow" (t-47hc.24). The callee reports its OWN errors, so a
        // malformed block BODY is indistinguishable from an ABSENT block under the
        // diag test, and the hand recovers the former while aborting only the
        // latter: `if !check(Tk.LeftBrace) { report; return .Err }`. Same signal,
        // same order.
        match item.prim {
            .Ref(rname) -> {
                let seen: List<string> = []
                if !tok_starts_rule(g, rname, st, seen) {
                    handle_missing(st, rule_first_literal(g, rname), annots)
                    env.set_abort(true)
                    return CapVal.Node(st.error_node_silent())
                }
                return exec_item_marked(g, item, st, env, multi, annots)
            }
            _ -> {}
        }
        let before = st.diags.length
        let r = exec_item_marked(g, item, st, env, multi, annots)
        if st.diags.length != before { env.set_abort(true) }
        return r
    }
    exec_item_marked(g, item, st, env, multi, annots)
}

/// exec_item minus the `@cut`/`@require` markers — the mode-SET wrapper + the body.
fn exec_item_marked(g: Grammar, item: GItem, st: PState, env: CapEnv, multi: bool, annots: List<GAnnot>) -> CapVal {
    // `@off(flag)` mode-SET marker: set the flag OFF for the DURATION of this
    // item's sub-parse (all reps + the .Opt FIRST-check), then restore — the
    // executor twin of the hand parser's save/set/restore around a control-header
    // condition. Empty mode_off (every item today) is a zero-cost passthrough.
    if item.mode_off != "" {
        let saved = st.push_mode_off(item.mode_off)
        let r = exec_item_body(g, item, st, env, multi, annots)
        st.restore_modes(saved)
        return r
    }
    // `@bump(counter)` counter-SET marker: increment for the item's sub-parse, then
    // restore — the hand parse_quote's save/bump/restore around a quote body.
    if item.mode_bump != "" {
        let saved = st.push_mode_bump(item.mode_bump)
        let r = exec_item_body(g, item, st, env, multi, annots)
        st.restore_modes(saved)
        return r
    }
    // `@on(flag)` mode-SET marker: the SET-ON twin — set the flag ON for the item's
    // sub-parse, then restore (parse_paren_expr's `allow_dot_postfix = true`).
    if item.mode_on != "" {
        // `@on_if(pred, flag)` (t-47hc.34): the set is CONDITIONAL. The predicate is
        // read through the SAME `pred_ok` a `@when` guard uses, so the two markers can
        // never disagree about what a name means. A false predicate leaves the modes
        // untouched — NOT set-then-restore, which would be observably identical here but
        // would diverge the moment a sub-parse read the flag mid-item.
        if item.mode_on_if != "" && !pred_ok(item.mode_on_if, st) {
            return exec_item_body(g, item, st, env, multi, annots)
        }
        let saved = st.push_mode_on(item.mode_on)
        let r = exec_item_body(g, item, st, env, multi, annots)
        st.restore_modes(saved)
        return r
    }
    exec_item_body(g, item, st, env, multi, annots)
}

fn exec_item_body(g: Grammar, item: GItem, st: PState, env: CapEnv, multi: bool, annots: List<GAnnot>) -> CapVal {
    let empty: List<string> = []
    match item.rep {
        .One -> {
            let v = exec_primary(g, item.prim, st, env, multi, annots)
            bind(env, item.label, v, multi)
            v
        }
        .Opt -> {
            if tok_starts_prim(g, item.prim, st, empty) && sameline_ok(st, item) {
                let v = exec_primary(g, item.prim, st, env, multi, annots)
                bind(env, item.label, v, multi)
                return v
            }
            CapVal.Nil
        }
        .Star -> {
            exec_repeat(g, item, st, env, annots)
            CapVal.Nil
        }
        .Plus -> {
            // require ≥1: one forced iteration, then like Star — EXCEPT when a bound
            // already caps this loop at zero. The emitted twin has no forced iteration;
            // its counter guard breaks before the first one. Without this check a
            // `+{#cap}` over an empty capture would take one iteration here and none
            // there. Reachable whenever the bound names a `*` capture that matched
            // nothing.
            //
            // The forced iteration also COUNTS toward the cap — it is one of the at-most-N,
            // not a freebie before them — so it is carried into the loop as `already`.
            // Otherwise a `+{#h}` with cap 2 would take 1 + 2 = 3 here against the
            // emitted loop's 2.
            mut already = 0
            if item_bound_cap(item, env) != 0 {
                let v0 = exec_primary(g, item.prim, st, env, true, annots)
                bind(env, item.label, v0, true)
                already = 1
            }
            exec_repeat_from(g, item, st, env, annots, already)
            CapVal.Nil
        }
    }
}

/// The `*` loop body shared by Star and Plus: keep taking the primary
/// while the current token starts it, binding into list captures.
/// Bounded — a non-consuming iteration breaks the loop.
fn exec_repeat(g: Grammar, item: GItem, st: PState, env: CapEnv, annots: List<GAnnot>) {
    exec_repeat_from(g, item, st, env, annots, 0)
}

/// `already` is how many iterations the caller has taken toward this item's cap —
/// nonzero only for `.Plus`, whose forced first iteration counts toward the at-most-N.
fn exec_repeat_from(g: Grammar, item: GItem, st: PState, env: CapEnv, annots: List<GAnnot>, already: int) {
    let empty: List<string> = []
    // t-47hc.28 `x{#cap}`: the cap is read ONCE, before the loop. Reading it per
    // iteration would be wrong the moment the repetition's own captures share a
    // label with the bound (self-limiting), and the count it stands for — "how many
    // columns did the header declare" — is fixed by the time the bounded loop starts.
    let cap = item_bound_cap(item, env)
    mut taken = already
    // ps3t.6.7: a `^`-marked repetition stops at a cross-line token — the DSL
    // mirror of the hand parser's newline-terminated postfix loop.
    while tok_starts_prim(g, item.prim, st, empty) && sameline_ok(st, item) {
        if cap >= 0 && taken >= cap { return }
        let before = st.pos
        let v = exec_primary(g, item.prim, st, env, true, annots)
        bind(env, item.label, v, true)
        taken = taken + 1
        if st.pos == before { return }
    }
}

/// This item's repetition cap, or `-1` when unbounded — which keeps the hot comparison
/// a single int test. ONE reader for the bound so `exec_repeat` and the `.Plus` forced
/// iteration can never disagree about what the cap is.
fn item_bound_cap(item: GItem, env: CapEnv) -> int {
    if item.bound == "" { return -1 }
    capval_len(env.get(item.bound))
}

/// How many elements a capture holds — the value `x{#cap}` bounds against. TOTAL over
/// `CapVal`: every list variant reports its length, a scalar is 1, and an absent
/// capture is 0. Scalars cannot actually reach here (validate_bounds rejects a bound
/// naming a non-list capture at grammar-parse time), but answering 1 rather than 0
/// keeps this honest as a general "size of" should the validator ever loosen.
fn capval_len(v: CapVal) -> int {
    match v {
        .Nil -> 0
        .Toks(ts) -> ts.length
        .Nodes(ns) -> ns.length
        .SNodes(ns) -> ns.length
        .PNodes(ns) -> ns.length
        .TExprs(ts) -> ts.length
        .Arms(a) -> a.length
        .WArms(a) -> a.length
        .SArms(a) -> a.length
        .CCfgs(a) -> a.length
        .CSlots(a) -> a.length
        .CPairs(a) -> a.length
        .FInits(f) -> f.length
        .PEntries(p) -> p.length
        .Fields(f) -> f.length
        .Vars(v2) -> v2.length
        .Anns(a) -> a.length
        .TParams(tp) -> tp.length
        _ -> 1
    }
}

/// Execute a primary. Terminals match+consume (or trigger @expect /
/// @recover when a required terminal is missing); a ref calls its rule;
/// a group recurses the enclosing env so its captures propagate out.
fn exec_primary(g: Grammar, prim: GPrim, st: PState, env: CapEnv, multi: bool, annots: List<GAnnot>) -> CapVal {
    match prim {
        .Lit(t) -> {
            if st.cur().text == t { return CapVal.Tok(st.advance()) }
            // >>-split (ps3t.6.5.10): a nested generic close lexes two `>` as one
            // `>>`; when a single `>` is expected, consume the first half and
            // leave the second for the next match (the maybe_split_shr analogue).
            if t == ">" && st.cur().text == ">>" { return CapVal.Tok(st.split_gt()) }
            handle_missing(st, t, annots)
            CapVal.Node(st.missing_node())
        }
        .Named(name) -> {
            if named_tok_matches(name, st.cur()) { return CapVal.Tok(st.advance()) }
            handle_missing(st, name, annots)
            CapVal.Node(st.missing_node())
        }
        .Ref(name) -> exec_rule(g, name, st)
        .Group(inner) -> exec_node(g, inner, st, env, multi, annots)
        // Statement/declaration hand rules delegate to the real hand parser and
        // yield a Stmt node; expression hand rules (`ident`/`number`) yield an
        // Expr node. Dispatch on the rule name so a mixed declaration grammar
        // (pure rules + a `@hand(component_decl)` alternative) routes each to
        // the right builder.
        .Hand(hf) -> {
            if is_hand_stmt_leaf(hf) { CapVal.SNode(run_hand_stmt(hf, st)) }
            else if is_hand_expr_leaf(hf) { CapVal.Node(run_hand_expr(hf, st)) }
            else { CapVal.Node(run_hand(hf, st)) }
        }
        // A `@when` predicate is zero-width — the branch gate already decided
        // this alternative applies (branch_pred_ok in exec_node); executing the
        // predicate itself consumes no token and yields no value.
        .Pred(_) -> CapVal.Nil
        // `@peek` is the same zero-width shape — the gate already ran (branch_pred_ok);
        // executing it consumes no token and yields no value.
        .Peek(_) -> CapVal.Nil
        // `@gensym` is zero-width but NOT valueless: it mints here, in parse order, and
        // the result is bound to the item's label by the ordinary bind() path.
        //
        // The name rides in a synthetic `CapVal.Tok` positioned at the CURRENT token, so
        // a build reads it with `capval_tok_text` exactly like a captured IDENT and the
        // capture-kind machinery needs no new entry. `pos` is the cursor rather than 0
        // because a Tok's position is what span logic reads if anything ever does; a
        // zero would place the minted name at the start of the file.
        .Gensym(tag) -> CapVal.Tok(gensym_token(st, tag))
        // `@rawbrace` consumes to the balancing `}` and binds the verbatim source
        // slice as a synthetic Tok — the same no-new-capture-kind shape as `@gensym`.
        // The scan itself is the shared `rawbrace_scan`, which emit also renders a
        // call to, so the two engines cannot drift.
        .RawBrace(tag) -> CapVal.Tok(rawbrace_scan(st, tag))
    }
}

/// The synthetic token a `@gensym(tag)` binds. Shared by both engines — emit renders a
/// call to this same function, so the minted name and its token shape cannot drift.
export fn gensym_token(st: PState, tag: string) -> Token {
    Token { kind: "IDENT", text: fresh_name(st, tag), pos: st.cur().pos, tk: Tk.Identifier }
}

/// The raw balanced-brace capture a `body:@rawbrace(tag)` binds (t-47hc.31). Shared by
/// both engines — emit renders a call to this same function — so the scan, the captured
/// slice, and the unterminated-EOF diagnostic cannot drift between them.
///
/// The exact mirror of the hand parser's `capture_balanced_brace_body`: the enclosing
/// `{` has ALREADY been consumed (by the rule's `"{"` literal), so the scan starts at
/// depth 1, counts brace TOKENS (a `{` inside a string/template literal is part of that
/// one token and never miscounts), and stops AT the balancing `}` without consuming it —
/// the rule's trailing `"}"` literal owns that token and its diagnostics. The bound
/// token's text is `src[start .. close_brace_start].trim()`, verbatim otherwise, which
/// is what makes the desugared `parse_grammar("…")` string byte-identical to the hand's.
///
/// On EOF the scan reports the hand's per-construct message and yields an empty-text
/// token; `had_error` is set, so on the production path the item falls back to the hand
/// parser exactly like any other native diagnostic.
export fn rawbrace_scan(st: PState, tag: string) -> Token {
    let start = st.cur().pos
    mut depth = 1
    while true {
        if st.at_end() {
            st.report("unterminated `${tag} { }` block — no balancing `}` before end of file")
            return Token { kind: "RAW", text: "", pos: start, tk: Tk.String }
        }
        if st.cur().tk == Tk.LeftBrace { depth = depth + 1 }
        if st.cur().tk == Tk.RightBrace {
            depth = depth - 1
            if depth == 0 {
                let body = st.src.substring(start, st.cur().pos).trim()
                return Token { kind: "RAW", text: body, pos: start, tk: Tk.String }
            }
        }
        let _ = st.advance()
    }
    Token { kind: "RAW", text: "", pos: start, tk: Tk.String }
}

// ── The escape-hatch (@hand) — hand-written rules the grammar calls ──
//
// The gnarly 5% (GRAMMAR_DSL.md §5) lives in hand-written code the
// grammar delegates to by name, not in the DSL notation. In the
// executor these are a small built-in registry; in the spliced-parser
// integration (ps3t.6.5) each `@hand(fn)` lowers to a call of a real
// hand-written Avra parse function (emit.av already renders it that
// way). Here `ident`/`number` demonstrate the mechanism — a primary the
// pure expression grammar deliberately omits, added via the hatch.

fn hand_starts(name: string, tok: Token) -> bool {
    if name == "ident" { return tok.kind == "IDENT" }
    if name == "number" { return tok.kind == "NUMBER" }
    // A declaration/statement hand rule's FIRST is its leading keyword.
    if name == "component_decl" { return tok.text == "component" }
    if name == "let_stmt" { return tok.text == "let" }
    if name == "return_stmt" { return tok.text == "return" }
    // The residual match-statement edge oracle (subjectless/table/bare-return/
    // quote-splice arms) is intentionally narrower than the generic stmt leaf.
    if name == "match_table" { return tok.text == "match" }
    // (Statement blocks are grammar-native — stmt_block's body is `declaration*`,
    // so an inline module's component parses without a hand fallback.)
    // An expression hand rule's FIRST is its leading keyword.
    if name == "quote_expr" { return tok.text == "quote" }
    // The keyword-led expression primaries (Phase 3a-11): each FIRST is its
    // leading keyword, routed to the feature's hand parser via run_hand_expr.
    if name == "match_expr" { return tok.text == "match" }
    if name == "if_expr" { return tok.text == "if" }
    // Clean-FIRST bracket/qualified primaries (Phase 3a-10/11): FIRST is the
    // opening delimiter — `[` list, `@` qualified (`{` brace_expr is above).
    if name == "list_expr" { return tok.text == "[" }
    if name == "paren_expr" { return tok.text == "(" }
    // The identifier-led primary (bare ident / struct-lit / table / feature-kw /
    // tagged-template) — FIRST is an IDENT.
    if name == "ident_primary" { return tok.kind == "IDENT" }
    // (Interpolated strings and brace primaries are grammar-native now — template_lit
    // t-47hc.19, brace_expr t-47hc.18 — so neither has a hand_starts entry.)
    // The ident-primary (bare ident / struct literal / qualified @pkg::T /
    // generic call) starts with IDENT or `@` (ps3t.6.7). parse_primary handles
    // the struct-lit / qualified / generic-turbofish forms; the DSL postfix then
    // adds field/index/call suffixes.
    if name == "ident_expr" { return tok.kind == "IDENT" || tok.text == "@" }
    // The remaining primaries served by parse_primary: enum constructors
    // (`.Variant(..)`) and list literals (`[ .. ]`) (ps3t.6.7 Step C).
    if name == "more_primary" { return tok.text == "." || tok.text == "[" }
    // The whole procedural leaf (unary/postfix/primary) — its FIRST is the
    // shared exported predicate, mirrored by emit's hand_first_guard.
    if name == "hand_unary" { return tok_starts_expr_leaf(tok) }
    // The `with`-base leaf shares the same leaf FIRST (parse_unary_leaf).
    if name == "call_leaf" { return tok_starts_expr_leaf(tok) }
    // The Phase-3a primary base shares the leaf FIRST (parse_primary_base).
    if name == "primary_base" { return tok_starts_expr_leaf(tok) }
    // A postfix suffix's FIRST is the postfix-op set (`. ( [ ! ? ?. < catch`) — a
    // SUPERSET of postfix_step's precise entry guard (which adds sameline/mode/base
    // checks). The grammar `( )*` loop enters on any of these, postfix_step then
    // decides precisely, and the no-progress break exits when it consumes nothing
    // (byte-identical to parse_call's `while` guard being false).
    if name == "postfix_suffix" { return tok.text == "." || tok.text == "(" || tok.text == "[" || tok.text == "!" || tok.text == "?" || tok.text == "?." || tok.text == "<" || tok.text == "catch" }
    // A `with { … }` postfix step's FIRST is the `with` keyword.
    // A pipe RHS bottoms out in the same leaf FIRST (parse_or -> … -> unary).
    // The lambda BODY (t-47hc paren flip prep — DORMANT). parse_lambda_body is a
    // block `{ … }` OR a bare expression, so its FIRST is `{` ∪ FIRST(expression) —
    // exactly tok_starts_expr_leaf (which includes `{`). Registered so an Opt/Star/Alt
    // use of `@hand(lambda_body)` selects correctly; the paren flip's mandatory
    // `"->" b:@hand(lambda_body)` never consults it, but the registration must be
    // complete (byte-side twin: emit.av hand_first_guard). DORMANT: no live grammar
    // references it, so this branch is never queried on the production type_flip path.
    if name == "lambda_body" { return tok_starts_expr_leaf(tok) }
    if name == "lambda_block_body" { return tok.text == "{" }
    // ps3t.6.7 G.4 — the whole-statement dispatch leaf's FIRST: `{` (block OR a
    // map-literal statement, disambiguated inside parse_statement) plus the
    // statement KEYWORDS parse_statement routes to feature parsers. `break` /
    // `continue` are DSL-native alternatives ordered BEFORE this one; every
    // other token is an expression statement handled by the `expr_stmt`
    // alternative ordered AFTER it. The keyword list mirrors the registered
    // stmt_keyword set (if/while/for/match/defer/errdefer/return) exactly.
    if name == "stmt_hand" {
        let t = tok.text
        return t == "{" || t == "if" || t == "while" || t == "return"
    }
    // ps3t.6.7 G.4b — the whole-declaration dispatch leaf's FIRST: exactly the
    // tokens parse_declaration handles itself (doc-comment wrapping, `@`
    // annotation OR a qualified `@pkg::T` it forwards, `export`, every decl
    // keyword, and a bare IDENT — component instantiation OR an expression
    // statement, disambiguated inside parse_declaration). Every OTHER token (the
    // stmt keywords, `{`, non-ident expression leaves) is routed to the
    // `statement` alternative ordered after this one. A reserved keyword matches
    // neither → the alternation errors → hand fallback rejects it identically.
    if name == "decl_hand" {
        if tok.kind == "IDENT" || tok.kind == "DOC" || tok.kind == "MODDOC" { return true }
        let t = tok.text
        return t == "@" || t == "export" ||
               t == "fn" || t == "type" || t == "enum" || t == "trait" || t == "impl" ||
               t == "use" || t == "mod" || t == "const" || t == "let" || t == "mut" ||
               t == "extern" || t == "shape" || t == "spec" || t == "parallel" ||
               t == "select" || t == "component"
    }
    false
}

// Which names are STATEMENT/DECLARATION hand rules (delegated via
// `run_hand_stmt`) vs EXPRESSION ones (`run_hand_expr`), and the delegate each
// one runs, live in the shared hand-leaf table — hand_leaves.av, which also
// records WHY each form is an escape hatch the pure grammar does not re-express.
// One seam, read by both this executor and emit.av, instead of a local
// `name == "…" || …` chain here and a hand-synced copy there.

/// Run a STATEMENT/DECLARATION hand rule by delegating to the real hand
/// parser (ps3t.6.5.7 component / ps3t.6.5.10 gnarly-5%). A `Parser` is built
/// over the PState's ORIGINAL source, SHARING the PState's store (so the
/// returned id is valid in it — the parse_program_source_shared pattern) and
/// repositioned at the current token's byte offset; after the hand parse the
/// DSL cursor is resynced past the tokens it consumed. This is the executor's
/// mini swap-in: proving the generated parser can hand off to `@hand` code
/// over a shared store (the foundation 6.5.12 generalises).
/// Is this `@hand` leaf REFUSED for this process? `AVRA_REFUSE_HAND_LEAF` names the
/// leaf to refuse (`decl_hand`, `primary_base`), or `*` for every one. Unset — the
/// default, and every production build — refuses nothing, so the emitted parsers and
/// the IR are untouched.
///
/// Deliberately a NAME rather than a boolean: the two remaining leaves are retired by
/// separate slices, and a per-leaf switch lets each one's frontier be measured without
/// the other's failures drowning it out.
/// The trailing-comma guard's shared core: is the cursor on a `,` that is followed by
/// ANOTHER element rather than by `closer`? Used by `comma_not_rparen` /
/// `comma_not_rbracket` / `comma_not_rbrace` so the three differ only in their closer
/// and cannot drift apart.
fn comma_not_closer(st: PState, closer: Tk) -> bool {
    if st.cur().tk != Tk.Comma { return false }
    if st.pos + 1 >= st.toks.length { return false }
    st.toks[st.pos + 1].tk != closer
}

export fn hand_leaf_refused(name: string) -> bool {
    let want = avra_process_env_get("AVRA_REFUSE_HAND_LEAF")
    if want == "" { return false }
    want == "*" || want == name
}

export fn run_hand_stmt(name: string, st: PState) -> StmtId {
    // ONE table lookup answers both "is this a statement leaf?" and "which
    // parser?" — the class check and the dispatch used to be separate scans over
    // the same six names.
    let leaf = hand_stmt_leaf(name)
    if leaf == null {
        st.report("no hand statement rule `${name}`")
        return st.store.stmts.add_leaf(Stmt.Error)
    }
    // ── The FRONTIER probe (t-myz7): the delegate, refusable ──────────────────
    //
    // `--hand-leaves` counts the leaves that REMAIN; nothing measured what still
    // DEPENDS on one. Every existing decl_flip spec asserts dispatch ORDER in the
    // emitted source, which says where a native rule sits — not which inputs fall
    // past it into the delegate. Those are different questions, and only the second
    // one tells you what deleting the leaf would break.
    //
    // It is unmeasurable by comparison, for the same reason the component-body
    // routing bug hid for a month: the delegate and the native rules agree on every
    // input they both accept, so trees, diagnostics, positions and IR are identical
    // whichever answers. The only way to see the dependency is to REMOVE the
    // delegate and watch what fails — which is the deletion itself.
    //
    // So this is the deletion, behind a flag. With the flag set the leaf reports
    // instead of delegating, and every form that still needs it surfaces as a real
    // diagnostic naming the leaf. That makes the retirement corpus writable BEFORE
    // the retirement: the fail-before/pass-after set is exactly the forms this
    // rejects today, and the slice is done when the set is empty.
    //
    // Read only on the leaf path (once per delegated statement, not per token), and
    // opt-in — the default path is byte-identical.
    if hand_leaf_refused(name) {
        st.report("`@hand(${name})` is refused (AVRA_REFUSE_HAND_LEAF) — this form still depends on the hand leaf")
        return st.store.stmts.add_leaf(Stmt.Error)
    }
    if st.src == "" {
        // Token-only path: no source to delegate over. (The swap-in serves
        // @hand from a real Parser instead of this interpreter, so this only
        // trips a caller that ran a @hand-statement grammar via the *_toks
        // entry — which the differential oracle never does.)
        st.report("`@hand(${name})` needs the source, unavailable on the token-only path")
        return st.store.stmts.add_leaf(Stmt.Error)
    }
    let start_byte = st.cur().pos
    // REUSE the delegate threaded from the outer Parser (st.hand_delegate) when
    // present — created once per file and SYNCED to the outer parser's cursor +
    // line before this statement (see parse_statement's flip), so it lexes each
    // token once (O(source), not O(source²)) AND carries the accumulated line/
    // column/gensym state the continuous hand parse would have. This is the
    // statement-family mirror of run_hand_expr's delegate reuse. Fallback to a
    // fresh parser when no delegate is threaded (the differential oracle + unit
    // tests): a fresh gensym counter at 0 matches a single-statement oracle
    // parse, so a `let … else` desugar mints the identical temp name.
    mut bp = if st.hand_delegate == null {
        parser_new_with_store(st.src, "", st.store)
    } else {
        st.hand_delegate!
    }
    bp.records_roots = 0
    bp.had_error = false
    bp.error_message = ""
    // EXPRESSION flips OFF: the procedural expression leaf owns its whole sub-tree,
    // so a nested expression must not re-enter the expr flip. STATEMENT/DECLARATION
    // flips are LEFT AS-IS on bp: the production delegate (ensure_hand_delegate) has
    // them ON so a body loop re-enters the DSL (ps3t.6.7 Slice 5.1 full-program
    // flip); the differential oracle's delegate (new_pstate) has them OFF so the
    // oracle stays pure-hand. The `stmt_hand`/`decl_hand` dispatch below calls the
    // *_hand entry for the CURRENT item, so bp flipping its BODIES never re-parses
    // the same item (no infinite recursion).
    bp.expr_flip = false
    bp.expr_static = false
    // Reproduce the ORIGINAL parse context (a no-op on the fresh-parser oracle
    // path, where st.modes are a fresh parser's defaults).
    bp.allow_struct_lit = st.modes.allow_struct_lit
    bp.allow_dot_postfix = st.modes.allow_dot_postfix
    bp.allow_it_sugar = st.modes.allow_it_sugar
    bp.quote_depth = st.modes.quote_depth
    bp.cell_mode = st.modes.cell_mode
    // `advance()`, NOT `advance_token()`: only the former maintains `prev_line`
    // (`advance` is literally `prev_line = current_line; advance_token()`). The hand's
    // postfix entry guard is newline-sensitive — `(` / `[` on a NEW line starts a new
    // statement rather than continuing a chain — so a delegate walked here with
    // `advance_token` arrives holding a stale `prev_line` and rejects a suffix that is
    // in fact on the same line. Before the IDENT base went native this was harmless:
    // the hand consumed the callee ITSELF via `advance()`, which set `prev_line` on the
    // way past. Now the grammar consumes it off the shared token stream and the
    // delegate only gets walked to the `(`, so the line state has to be maintained here.
    // Invisible on line 1, where a stale line still compares equal to the real one.
    while bp.current_start < start_byte && !bp.is_at_end() { bp.advance() }
    let bp_diag_before = bp.bag.diagnostics.length
    // Dispatch to the real hand-parser entry — the leaf's delegate, a free
    // function taking `bp` as its explicit parse state, so `bp`'s cursor advances
    // in place for the resync below. Each builds into bp's (== the DSL's) shared
    // store.
    let run: fn(Parser) -> Result<StmtId, string> = leaf!.run
    let result = run(bp)
    // Resync the DSL token cursor past everything the hand parser consumed (its
    // cursor now sits on the next token's byte offset) — on BOTH success AND
    // failure: a failed hand parse still advanced `bp`, so leaving st.pos on the
    // stale keyword token would make a following grammar item / repetition
    // reprocess it and cascade.
    while !st.at_end() && st.cur().pos < bp.current_start { let _ = st.advance() }
    // Propagate the delegate's error STATE even when it returned .Ok (ps3t.6.7
    // Slice 5.4). A @hand delegate that parses a body-bearing form (fn / impl /
    // block via parse_declaration_hand → parse_statement_list_ids) does
    // ERROR-TOLERANT recovery internally: a malformed body statement (e.g.
    // `let await = 1` — a reserved keyword at a binding site) is rejected into the
    // DELEGATE's bag + had_error, then RECOVERED as a `Stmt.Error` placeholder so
    // the enclosing form still returns .Ok. Without mirroring that had_error onto
    // `st`, the outer flip sees had_error=false, keeps the Error-bearing tree, and
    // codegen ICEs (F9999 "no emitter for statement kind Stmt.Error"). Mirroring it
    // makes DslStmtResult.had_error true, so the flip falls back to the
    // authoritative hand parser — which re-parses and re-reports the real
    // diagnostic into the OUTER parser's own bag (the diag home the flip relies
    // on), byte-identical to the hand-only path. The diagnostic itself is NOT
    // copied (st.diags stays the DSL's) — only the boolean gate — because the
    // fallback owns the reporting; copying would double-report.
    if bp.had_error {
        st.note_had_error()
    }
    match result {
        .Ok(id) -> id
        .Err(m) -> {
            // The delegate's parser bag already owns a precise diagnostic for
            // ordinary parse failures (`consume`/`set_error`). Preserve that
            // F-code/message through the outer bag merge instead of adding a
            // second generic grammar error. Only synthesize a grammar diagnostic
            // for a silent `.Err`, where no delegate diagnostic exists.
            if bp.bag.diagnostics.length == bp_diag_before { st.report(m) }
            st.store.stmts.add_leaf(Stmt.Error)
        }
    }
}

/// The result of `run_dsl_type_at`: the built type, the byte offset the DSL
/// stopped at (so a hand-parser caller can resync its token cursor), and the
/// error channel.
export type DslTypeResult = { te: TypeExpr, stop_byte: int, had_error: bool, diag: string }

/// Inverse type runner (ps3t.6.5.12 slice 1): lets the hand parser delegate a
/// whole type expression to the DSL. It runs the unified program grammar's `type_expr`
/// rule over `src` starting at byte `start_byte`, and reports the byte where the
/// DSL stopped (`stop_byte`) so a caller can resync its own cursor.
///
/// It is PURE w.r.t. any live `Parser` (it takes `src` + a byte offset, not a
/// mutable parser), so ONE function serves both consumers of the swap-in:
///   * the FLIP — the caller advances its token cursor to `stop_byte`;
///   * the SHADOW canary — the caller compares `te` to its own parse and
///     discards `stop_byte`, leaving the authoritative parser untouched.
/// Byte positions align exactly because `lex_real` drives the SAME shipping
/// lexer the hand parser streams (so `Token.pos` == `Parser.current_start` at
/// every boundary), and `PState.cur()` returns the trailing EOF token — whose
/// `pos` is the end-of-source byte — so `stop_byte` is valid even at EOF.
///
/// The PROGRAM grammar is used so this runner exercises the same complete type
/// family as declarations, including native qualified names.
export fn run_dsl_type_at(src: string, start_byte: int) -> DslTypeResult {
    run_dsl_type_at_toks(lex_real(src), start_byte, src)
}

/// Token-sharing form of `run_dsl_type_at` (the "lex-once" layer, ps3t.6.5.12
/// Step D). Takes a PRE-LEXED `toks` list so a caller that parses many type
/// annotations from ONE source (the flip inside `parse_type_expr`) lexes it
/// exactly once and reuses the list — instead of `run_dsl_type_at` re-lexing the
/// whole file per annotation (the O(n²) + per-call allocation that OOM'd the
/// full-selfhost flip compile). `src` is still threaded for the line index.
/// Behaviour is otherwise identical to `run_dsl_type_at`.
export fn run_dsl_type_at_toks(toks: List<Token>, start_byte: int, src: string) -> DslTypeResult {
    run_dsl_type_at_shared(toks, start_byte, src, new_node_store(build_line_index(src)), avra_program_grammar())
}

/// Fully-shared form (ps3t.6.5.12 Step D) — takes a caller-owned `store` AND
/// `grammar` in addition to pre-lexed `toks`, so a caller parsing many type
/// annotations from one source builds NONE of the three per annotation. The
/// `run_dsl_type_at_toks` layer still re-lexed once but rebuilt a fresh node
/// store (a fresh ARENA) + the 41-rule grammar + a line index PER call — fresh
/// arenas never free, so across a selfhost compile's thousands of annotations
/// they accumulated to ~7.5GB over the hand baseline. Reusing one store + one
/// grammar per parser bounds it. The store is the DSL's OWN scratch arena
/// (isolated from the hand parser's, so the real parse's node-id space is
/// unaffected — byte-identity preserved); accumulation across a file's
/// annotations is bounded and harmless (each call returns a fresh TypeExpr
/// value, never a store id).
export fn run_dsl_type_at_shared(toks: List<Token>, start_byte: int, src: string, store: NodeStore, grammar: Grammar) -> DslTypeResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    let te = capval_to_texpr(st, exec_rule(grammar, "type_expr", st))
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslTypeResult { te, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// t-47hc.4.4 Phase 3d — the STATIC type-parser boundary. IDENTICAL PState setup to
/// `run_dsl_type_at_shared`, but drives the CHECKED-IN generated static
/// type parser (parse/gen_type_parser.av's `parse_type_expr`, passed in as `parse` so
/// this module needs no import back into `parse`) instead of the Grammar-tree
/// interpreter (`exec_rule`). Same builders and same PState yield a
/// byte-identical TypeExpr to both the interpreter flip AND the hand parser, at
/// straight-line speed (no per-node Grammar dispatch / capture-env allocation).
export fn run_static_type_at_shared(toks: List<Token>, start_byte: int, src: string, store: NodeStore, parse: fn(PState) -> CapVal) -> DslTypeResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    let te = capval_to_texpr(st, parse(st))
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslTypeResult { te, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// The result of `run_dsl_pattern_at_shared`: the built pattern (a `PatId` VALID
/// in the caller's shared `store` — patterns are arena-backed, unlike types),
/// the stop byte for cursor resync, and the error channel.
export type DslPatResult = { pat: PatId, stop_byte: int, had_error: bool, diag: string }

/// INVERSE-@hand PATTERN runner (ps3t.6.5.12) — the pattern-family sibling of
/// `run_dsl_type_at_shared`. Runs `grammar`'s `rule` (`pattern_or` for the
/// or-pattern top entry, `pattern` for a bare atom entry) over the pre-lexed
/// `toks` at byte `start_byte`, returning the built PatId + the resync stop
/// byte. UNLIKE the type runner, patterns are arena-backed, so it allocates into
/// the caller-owned `store` and returns an id VALID in it (the hand parser reads
/// the id straight back) — the `run_hand_stmt`/`run_grammar_pat_toks` store-
/// sharing shape. Reuses the caller's token + grammar caches (lex-once), so a
/// file's many patterns cost one lex + one grammar build.
export fn run_dsl_pattern_at_shared(toks: List<Token>, start_byte: int, src: string, store: NodeStore, grammar: Grammar, rule: string) -> DslPatResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    let pat = capval_to_pat(st, exec_rule(grammar, rule, st))
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslPatResult { pat, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// t-47hc.4.4 Phase 3d (pattern half) — the STATIC pattern-parser boundary. IDENTICAL
/// PState setup to `run_dsl_pattern_at_shared` (null delegate — the pattern grammar has
/// NO @hand), but drives the CHECKED-IN generated static parser (parse/gen_pat_parser.av's
/// `parse_pattern_or`, passed in as `parse`) instead of the Grammar-tree interpreter
/// (`exec_rule`). Same builders, same PState ⇒ byte-identical PatId (arena-backed, valid
/// in the caller's shared `store`) to both the interpreter flip AND the hand parser, at
/// straight-line speed.
export fn run_static_pat_at_shared(toks: List<Token>, start_byte: int, src: string, store: NodeStore, parse: fn(PState) -> CapVal) -> DslPatResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes: default_expr_modes(), file: "", gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: null, tok_edits: [], table_cols: [] }
    let pat = capval_to_pat(st, parse(st))
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslPatResult { pat, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// The result of `run_dsl_expr_at_shared`: the built expression (an `ExprId`
/// VALID in the caller's shared `store` — expressions are arena-backed, like
/// patterns), the stop byte for cursor resync, and the error channel.
export type DslExprResult = { expr: ExprId, stop_byte: int, had_error: bool, diag: string }

/// INVERSE-@hand EXPRESSION runner (ps3t.6.5.12) — the expression-family sibling
/// of `run_dsl_pattern_at_shared`. Runs `grammar`'s `expression` rule over the
/// pre-lexed `toks` at byte `start_byte`, SHARING the caller-owned `store` (the
/// returned id is valid in it — the hand parser reads it straight back), and
/// threads the caller's parser `modes` into the PState so the `@hand(hand_unary)`
/// leaf reproduces the original mode-sensitive parse (allow_struct_lit in
/// control-flow headers, etc.). Reuses the caller's token + grammar caches
/// (lex-once), so a file's many expressions cost one lex + one grammar build.
export fn run_dsl_expr_at_shared(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, grammar: Grammar, modes: ExprModes, delegate: Parser?) -> DslExprResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    // t-bwjg: the hygiene counter is SEEDED FROM and WRITTEN BACK TO the delegate, so the
    // grammar and the hand share ONE monotonic sequence per parse. Without this, every
    // `run_*_expr_at_shared` call starts a fresh PState at 0 — and since this runs ONCE
    // PER EXPRESSION, two desugars in the same function would both mint `$tag$1`, and
    // none of them would match the names the hand parser produces for the same source.
    // The delegate is the right home because it is the exact Parser `run_hand_expr`
    // dispatches into, so a hand-parsed leaf and a native build action advance the same
    // counter in parse order. Behaviour-neutral until something calls `fresh_name`
    // (nothing does yet — the capability is dormant), which is why this lands byte-identical.
    let seq0 = if delegate == null { 0 } else { delegate!.gensym_seq }
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes, file, gensym_seq: seq0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: delegate, tok_edits: [], table_cols: [] }
    let expr = capval_to_expr(st, exec_rule(grammar, "expression", st))
    if delegate != null { delegate!.gensym_seq = st.gensym_seq }
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslExprResult { expr, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// ps3t.6.7 Step G — the STATIC-parser boundary. IDENTICAL PState setup to
/// run_dsl_expr_at_shared, but drives the CHECKED-IN generated static parser
/// (parse/gen_expr_parser.av's `parse_expression`, passed in as `parse` so this
/// module needs no import back into `parse` — the generated module imports THIS
/// one's builders, not the reverse) instead of the Grammar-tree interpreter
/// (`exec_rule`). Same builders, same PState, same `@hand` leaf ⇒ byte-identical
/// AST to both the interpreter flip AND the hand parser, at straight-line speed
/// (no per-node Grammar dispatch / capture-env allocation). Proven byte-identical
/// by the selfhost + corpus differential under AVRA_PARSER_EXPR_STATIC=1.
export fn run_static_expr_at_shared(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, modes: ExprModes, delegate: Parser?, parse: fn(PState) -> CapVal) -> DslExprResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    // t-bwjg: the hygiene counter is SEEDED FROM and WRITTEN BACK TO the delegate, so the
    // grammar and the hand share ONE monotonic sequence per parse. Without this, every
    // `run_*_expr_at_shared` call starts a fresh PState at 0 — and since this runs ONCE
    // PER EXPRESSION, two desugars in the same function would both mint `$tag$1`, and
    // none of them would match the names the hand parser produces for the same source.
    // The delegate is the right home because it is the exact Parser `run_hand_expr`
    // dispatches into, so a hand-parsed leaf and a native build action advance the same
    // counter in parse order. Behaviour-neutral until something calls `fresh_name`
    // (nothing does yet — the capability is dormant), which is why this lands byte-identical.
    let seq0 = if delegate == null { 0 } else { delegate!.gensym_seq }
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes, file, gensym_seq: seq0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: delegate, tok_edits: [], table_cols: [] }
    let expr = capval_to_expr(st, parse(st))
    if delegate != null { delegate!.gensym_seq = st.gensym_seq }
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslExprResult { expr, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// The result of `run_dsl_stmt_at_shared`: the built statement (a `StmtId` VALID
/// in the caller's shared `store` — statements are arena-backed, like
/// expressions/patterns), the stop byte for cursor resync, and the error channel.
export type DslStmtResult = { stmt: StmtId, stop_byte: int, had_error: bool, diag: string }

/// Shared core of the statement- and declaration-family runners: runs `grammar`'s
/// `rule` over the pre-lexed `toks` at byte `start_byte`, SHARING the caller-owned
/// `store` (the returned id is valid in it — the hand parser reads it straight
/// back), and threads the caller's parser `modes` + `@hand` delegate into the
/// PState. Both statements and declarations build a `StmtId` (a declaration IS a
/// Stmt — Function/TypeDecl/Annotated/…), so ONE core serves both entries; they
/// differ only in the start rule.
fn run_dsl_snode_at_shared(rule: string, toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, grammar: Grammar, modes: ExprModes, delegate: Parser?) -> DslStmtResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes, file, gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: delegate, tok_edits: [], table_cols: [] }
    let stmt = capval_to_stmt(st, exec_rule(grammar, rule, st))
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslStmtResult { stmt, stop_byte: stop_pos, had_error: st.had_error, diag }
}

/// INVERSE-@hand STATEMENT runner (ps3t.6.7 Step G slice 4) — the statement-
/// family sibling of `run_dsl_expr_at_shared`. Runs `grammar`'s `statement` rule
/// over the pre-lexed `toks`. The gnarly statement forms (block, `if`/`while`/
/// `for`/`match`/`defer`/`errdefer`/`return` — the feature parsers, and their
/// position-recorded nested bodies) delegate wholesale via `@hand(stmt_hand)` →
/// `parse_statement`; only `break`/`continue` and the fall-through expression-
/// statement are DSL-native. The expr-stmt's `@hand(hand_unary)` leaf reproduces
/// the original mode-sensitive parse byte-identically. Reuses the caller's token
/// + grammar caches (lex-once), so a file's many statements cost one lex + one
/// grammar build.
export fn run_dsl_stmt_at_shared(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, grammar: Grammar, modes: ExprModes, delegate: Parser?) -> DslStmtResult {
    run_dsl_snode_at_shared("statement", toks, start_byte, src, file, store, grammar, modes, delegate)
}

/// INVERSE-@hand DECLARATION runner (ps3t.6.7 Step G slice 4b) — the declaration/
/// whole-program-family sibling. Runs `grammar`'s `declaration` rule. The gnarly
/// declaration forms (doc/annotation/export wrapping, the decl keywords fn/type/
/// enum/…/let/mut/const, and the component-vs-expression IDENT disambiguation —
/// all stateful lookahead + recursive-wrapping + position-recording the stateless
/// grammar cannot reproduce) delegate wholesale via `@hand(decl_hand)` →
/// `parse_declaration`; the fall-through to a non-declaration item routes to the
/// same `statement` grammar the statement flip uses (break/continue/stmt-keyword/
/// block/expr-stmt), so a function body's statements go through the DSL. Byte-
/// identical: each arm's builder IS the hand parser's, only routed by the grammar.
export fn run_dsl_decl_at_shared(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, grammar: Grammar, modes: ExprModes, delegate: Parser?) -> DslStmtResult {
    run_dsl_snode_at_shared("declaration", toks, start_byte, src, file, store, grammar, modes, delegate)
}

/// ps3t.6.7 Phase 2 — the STATIC-parser boundary for the statement/declaration
/// family. IDENTICAL PState setup to run_dsl_snode_at_shared, but drives the
/// CHECKED-IN generated static parser (parse/gen_decl_parser.av's `parse` fn,
/// passed in so this module needs no import back into `parse`) instead of the
/// Grammar-tree interpreter (`exec_rule`). Same builders (capval_to_stmt), same
/// PState, same `@hand` leaves (run_hand_stmt for decl_hand/stmt_hand) ⇒
/// byte-identical AST to both the interpreter flip AND the hand parser, at
/// straight-line speed (no per-node Grammar dispatch). The declaration entry
/// (run_static_decl, static_decl_entry.av) binds gen_decl_parser.parse_declaration.
export fn run_static_snode_at_shared(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, modes: ExprModes, delegate: Parser?, parse: fn(PState) -> CapVal) -> DslStmtResult {
    let idx = lower_bound(toks, start_byte, (t: Token) -> t.pos)
    mut st = PState { toks, pos: idx, store, src, diags: [], had_error: false, postfix_base: ExprId(0), postfix_sp_start: 0, modes, file, gensym_seq: 0, postfix_step_base: ExprId(0), postfix_step_sp: 0, hand_delegate: delegate, tok_edits: [], table_cols: [] }
    let stmt = capval_to_stmt(st, parse(st))
    // The resync byte must be read BEFORE the undo: the cursor may sit ON a
    // split slot, and restoring `>>` rewinds that token's pos by one — the hand
    // would then re-lex the whole `>>` where it already consumed the first `>`
    // (caught by channel_type_enforcement_test: `channel<GenOpt<int>>` resynced
    // onto the restored `>>` and the hand's consume(Greater) met Tk.Shr).
    let stop_pos = st.cur().pos
    st.undo_all_tok_edits()
    mut diag = ""
    if st.had_error && st.diags.length > 0 {
        diag = st.diags[0]
    }
    DslStmtResult { stmt, stop_byte: stop_pos, had_error: st.had_error, diag }
}

// Which names build an EXPRESSION via REAL hand delegation (`run_hand_expr` →
// ExprId over the shared store) — as distinct from the leaf-building `run_hand`
// (`ident`/`number`) — is the expression half of the shared hand-leaf table in
// hand_leaves.av, alongside each delegate and the reason it stays hand-parsed.

/// The FIRST-set of a leaf expression — every token that can begin the
/// procedural unary/postfix/primary layer the DSL delegates wholesale via
/// `@hand(hand_unary)` (→ `parse_unary`). Kept as ONE exported predicate so the
/// executor's `hand_starts` AND the emitted static parser's FIRST-guard share a
/// single source of truth (rule 8). It is the union of `parse_unary`'s prefix
/// operators (`! - ~ not` + quote-only `~`splice) and `parse_primary`'s FIRST
/// tokens (parse/mod.av) — literals by kind, keyword/enum/delimiter primaries by
/// text. WHY delegate the whole leaf rather than express it in the DSL: the hand
/// postfix loop (`parse_call`) is NEWLINE-SENSITIVE (`.UpperIdent` / `[` / `(` on
/// a new line = a new statement, `dot_is_postfix`) and mode-stateful
/// (`allow_struct_lit` / `allow_dot_postfix` / `allow_it_sugar` / `quote_depth`),
/// which the stateless token-grammar cannot reproduce byte-identically.
/// The FIRST set of the TYPE family's `type_expr`, for the same reason
/// `tok_starts_expr_leaf` exists: the dispatch-only declaration view leaves `type_expr`
/// EXTERNAL so the generated declaration parser calls the separately generated type
/// parser across the merged `parse/` namespace, and a crossing reference needs a declared
/// FIRST (t-47hc slice 10.9). Mirrors `type_atom`'s alternatives — qualified_type `@`,
/// fn_type `fn`, dyn_type `dyn`, list_type `[`, paren_type `(`, named_type IDENT.
export fn tok_starts_type(tok: Token) -> bool {
    if tok.kind == "IDENT" { return true }
    let t = tok.text
    t == "@" || t == "fn" || t == "dyn" || t == "[" || t == "("
}

export fn tok_starts_expr_leaf(tok: Token) -> bool {
    if tok.kind == "IDENT" || tok.kind == "NUMBER" || tok.kind == "STRING" || tok.kind == "BOOL" || tok.kind == "TEMPLATE" { return true }
    let t = tok.text
    t == "~" || t == "!" || t == "-" || t == "not" || t == "@" || t == "." ||
    t == "(" || t == "[" || t == "{" ||
    t == "match" || t == "if" || t == "spawn" || t == "channel" || t == "isolated" || t == "when" || t == "quote" ||
    t == "null" || t == "none"
}

/// Run an EXPRESSION hand rule by delegating to the real hand parser over the
/// PState's ORIGINAL source, SHARING the store (so the returned id is valid in
/// it — the `run_hand_stmt` pattern, for the Expr arena) and resyncing the DSL
/// cursor past what it consumed. This is the ExprId sibling of `run_hand_stmt`.
/// `parse_quote` tracks `quote_depth` internally, so
/// a `~` splice in the quote body is decided identically to the oracle parse.
///
/// A leaf that produces a POSTFIX-CHAIN BASE (which the grammar's
/// `( postfix_suffix )*` loop then wraps) must seed `st.postfix_base` from its
/// result — emit skips the seed for @hand bases, so the base self-seeds here.
/// That is the `seeds_postfix` COLUMN of the leaf record, so it can no longer
/// drift from the delegate beside it.

export fn run_hand_expr(name: string, st: PState) -> ExprId {
    // Split preconditions so each reports its OWN cause (a bad rule name vs a
    // missing source), and rely solely on error_node — which reports the
    // message itself — so each diagnostic is recorded exactly once. ONE table
    // lookup serves the class check, the dispatch, and the postfix-seed column.
    let leaf = hand_expr_leaf(name)
    if leaf == null {
        return st.error_node("no hand expression rule `${name}`")
    }
    if st.src == "" {
        return st.error_node("`@hand(${name})` needs the source, unavailable here")
    }
    // The EXPRESSION half of the frontier probe — see run_hand_stmt's WHY. `primary_base`
    // is the other remaining production leaf, and it is retired by its own slice, so it
    // gets the same refusable treatment.
    if hand_leaf_refused(name) {
        return st.error_node("`@hand(${name})` is refused (AVRA_REFUSE_HAND_LEAF) — this form still depends on the hand leaf")
    }
    let start_byte = st.cur().pos
    // REUSE the delegate threaded from the outer Parser (st.hand_delegate) — created
    // once per file and SYNCED to the outer parser's cursor+line before this
    // expression (see parse_expression). It forward-advances from its CURRENT
    // position to the leaf (WITHIN this expression), never from byte 0, so it lexes
    // each token once (O(source) over a file, not O(source²)) AND carries the
    // accumulated line — including the deliberate is_map_literal nudges — so the
    // leaf's nodes get the SAME line the hand parser would. Building a fresh parser
    // per leaf instead would (a) pay build_registry() ~53 registrations per leaf
    // (the OOM) and (b) re-derive line from offset 0, LOSING the accumulated nudge.
    // Fallback to a fresh parser when no delegate is threaded (the type/pattern
    // @hand paths + unit tests, which need no cross-expression line continuity).
    mut bp = if st.hand_delegate == null {
        parser_new_with_store(st.src, st.file, st.store)
    } else {
        st.hand_delegate!
    }
    bp.records_roots = 0
    bp.had_error = false
    bp.error_message = ""
    // ps3t.6.7 Step B — reproduce the ORIGINAL parse context. On the type/pattern
    // @hand paths PState carries a fresh parser's defaults (no-op); on the
    // expression flip these are the caller's live modes, so an `@hand(hand_unary)`
    // in an `if Foo { … }` condition sees allow_struct_lit=false (Foo-then-block,
    // not a struct literal) — the difference that makes the flip byte-identical.
    bp.allow_struct_lit = st.modes.allow_struct_lit
    bp.allow_dot_postfix = st.modes.allow_dot_postfix
    bp.allow_it_sugar = st.modes.allow_it_sugar
    bp.quote_depth = st.modes.quote_depth
    bp.cell_mode = st.modes.cell_mode
    // The @hand leaf IS the hand parser — it must NOT re-enter the expression
    // flip/static path for its nested sub-expressions (a `f(arg)` call's args, a
    // slice index, …), or the runner would recurse into itself per nested expr.
    // Force ALL delegate toggles off; the top operator ladder stays DSL/static, the
    // whole leaf-and-below is hand-parsed (byte-identical, since the ladders match).
    // stmt_flip too: a leaf's nested block (closure body, `if`-expr arm) parses
    // statements by hand, never re-entering the statement flip on this delegate.
    bp.stmt_flip = false
    bp.decl_flip = false
    bp.expr_flip = false
    bp.expr_static = false
    // `advance()`, NOT `advance_token()`: only the former maintains `prev_line`
    // (`advance` is literally `prev_line = current_line; advance_token()`). The hand's
    // postfix entry guard is newline-sensitive — `(` / `[` on a NEW line starts a new
    // statement rather than continuing a chain — so a delegate walked here with
    // `advance_token` arrives holding a stale `prev_line` and rejects a suffix that is
    // in fact on the same line. Before the IDENT base went native this was harmless:
    // the hand consumed the callee ITSELF via `advance()`, which set `prev_line` on the
    // way past. Now the grammar consumes it off the shared token stream and the
    // delegate only gets walked to the `(`, so the line state has to be maintained here.
    // Invisible on line 1, where a stale line still compares equal to the real one.
    while bp.current_start < start_byte && !bp.is_at_end() { bp.advance() }
    // Phase 3a base-threading: seed the delegate's postfix accumulator from PState so
    // parse_postfix_suffix runs its step on the grammar-threaded base. Harmless for
    // every other name — only parse_postfix_suffix reads bp.postfix_base.
    bp.postfix_base = st.postfix_base
    bp.postfix_sp_start = st.postfix_sp_start
    // Dispatch to the leaf's delegate — a free function taking `bp` as its
    // explicit parse state. Which parse each leaf opts out of, and why, is
    // documented on the delegates in hand_leaves.av.
    let run: fn(Parser) -> Result<ExprId, string> = leaf!.run
    let result = run(bp)
    while !st.at_end() && st.cur().pos < bp.current_start { let _ = st.advance() }
    // Phase 3a base-threading (write-back): primary_base seeds the postfix
    // accumulator on PState (sp_start = the base's start byte, the chain's constant
    // span `lo`); each postfix_suffix step updated bp.postfix_base, copied back so
    // the NEXT ( postfix_suffix )* iteration — and the interpreter's fresh-parser
    // path — sees it. Threaded via PState so both the shared-delegate production
    // path and the equivalence-test path carry the base across the grammar loop.
    if leaf!.seeds_postfix {
        match result {
            .Ok(id) -> st.seed_postfix(id, start_byte)
            .Err(_) -> {}
        }
    } else if name == "postfix_suffix" {
        st.set_postfix_base(bp.postfix_base)
    }
    // Propagate the delegate's error STATE even on .Ok (ps3t.6.7 Slice 5.4) — the
    // expression-family mirror of run_hand_stmt's guard. An expression leaf can
    // hand-parse a nested STATEMENT body (a closure body, an if-expr/match arm),
    // and parse_statement_list_ids does error-tolerant recovery there: a malformed
    // body statement is reported into the DELEGATE's bag + had_error, then
    // recovered as a `Stmt.Error` placeholder so the leaf still returns .Ok.
    // Mirroring had_error onto `st` makes the expression flip fall back to the
    // authoritative hand parser (which re-reports into the OUTER bag) instead of
    // keeping an Error-bearing tree that would ICE in codegen. Only the boolean
    // gate is copied; the fallback owns the reporting.
    if bp.had_error {
        st.note_had_error()
    }
    match result {
        .Ok(id) -> id
        .Err(m) -> st.error_node(m)
    }
}

export fn run_hand(name: string, st: PState) -> ExprId {
    if name == "ident" {
        if st.cur().kind == "IDENT" {
            let t = st.advance()
            return st.store.exprs.add_leaf(Expr.Ident(t.text))
        }
        return st.error_node("expected an identifier")
    }
    if name == "number" {
        if st.cur().kind == "NUMBER" {
            let t = st.advance()
            return st.store.exprs.add_leaf(Expr.Number(t.text))
        }
        return st.error_node("expected a number")
    }
    st.error_node("no hand rule `${name}`")
}

/// A required terminal was absent: report the matching @expect message
/// (or a default), then panic-mode synchronize to the @recover target.
fn handle_missing(st: PState, expected: string, annots: List<GAnnot>) {
    mut msg = "expected `${expected}`"
    for a in annots {
        match a {
            .Expect(tok, m) -> {
                if tok == expected { msg = m }
            }
            _ -> {}
        }
    }
    st.report(msg)
    for a in annots {
        match a {
            .Recover(sync_to) -> st.synchronize(sync_to)
            _ -> {}
        }
    }
}

/// Bind a capture: no-op if unlabelled; list-append inside a repetition;
/// scalar otherwise.
fn bind(env: CapEnv, label: string, v: CapVal, multi: bool) {
    if label == "" { return }
    if multi {
        match v {
            .Tok(t) -> env.append_tok(label, t)
            .Node(id) -> env.append_node(label, id)
            .SNode(id) -> env.append_snode(label, id)
            .PNode(id) -> env.append_pnode(label, id)
            .TExpr(te) -> env.append_texpr(label, te)
            .Arm(a) -> env.append_arm(label, a)
            .WArm(a) -> env.append_warm(label, a)
            .SArm(a) -> env.append_sarm(label, a)
            .CCfg(c) -> env.append_ccfg(label, c)
            .CSlot(c) -> env.append_cslot(label, c)
            .CPair(p) -> env.append_cpair(label, p)
            .FInit(f) -> env.append_finit(label, f)
            .PEntry(p) -> env.append_pentry(label, p)
            .Field(f) -> env.append_field(label, f)
            .Var(v) -> env.append_var(label, v)
            .Ann(a) -> env.append_ann(label, a)
            .TParam(tp) -> env.append_tparam(label, tp)
            _ -> {}
        }
    } else {
        env.set_scalar(label, v)
    }
}

// ── Semantic actions (targets: Expr + Stmt) ──

/// Coerce a capture value to an Expr node: a node passes through; a bare
/// token becomes a literal; anything else is an error node.
export fn capval_to_expr(st: PState, v: CapVal) -> ExprId {
    match v {
        .Node(id) -> id
        .Tok(t) -> literal_node(st, t)
        _ -> st.error_node("expected an expression")
    }
}

export fn literal_node(st: PState, t: Token) -> ExprId {
    // INTERN (hash-cons) to match the hand parser's alloc_leaf (parse_primary), so
    // repeat literals/idents share ONE arena row byte-for-byte (§14.4) — a bare
    // grammar terminal (NUMBER/STRING/…) must produce the SAME id the hand parser
    // does or two `5`s diverge. `store.intern_expr_leaf` is `store.exprs.add_leaf`'s
    // interning twin (arena.av); non-eligible content falls through to add_leaf inside.
    // `Tk.Float` folds INTO the coarse "NUMBER" kind (real_lex.av: both `.Number` and
    // `.Float` map to it, "the lexeme carries the dot"), so the KIND alone cannot tell
    // `2` from `2.0` — the split must come off the TOKEN, exactly as hand parse_primary
    // does it (`Tk.Number -> Expr.Number`, `Tk.Float -> Expr.FloatLit`). Building every
    // NUMBER as `Expr.Number` silently truncated a float literal to its integer part:
    // `f(2.0)` lowered to `call %fn_ptr(i64 2)` with no `avra_float_parse` at all, so
    // the callee reinterpreted the i64 as a double (~1e-323) and returned a wrong
    // NUMBER rather than crashing (t-9bz3). Only literals reaching a build through this
    // core were affected — a float via a binding was fine, which is what made it look
    // like a codegen bug rather than a parse one.
    if t.kind == "NUMBER" {
        if t.tk == Tk.Float { return st.store.intern_expr_leaf(Expr.FloatLit(t.text)) }
        return st.store.intern_expr_leaf(Expr.Number(t.text))
    }
    if t.kind == "STRING" { return st.store.intern_expr_leaf(Expr.String(t.text)) }
    if t.kind == "BOOL" { return st.store.intern_expr_leaf(Expr.Bool(t.text)) }
    // `null` / `none` are keyword tokens (Tk.KwNull/KwNone → the generic "KW" grammar
    // kind), so they match by tk here rather than kind — byte-identical to hand
    // parse_primary's `Tk.KwNull|KwNone -> alloc_leaf(Expr.None)` (the absence literal).
    if t.tk == Tk.KwNull || t.tk == Tk.KwNone { return st.store.intern_expr_leaf(Expr.None) }
    st.store.intern_expr_leaf(Expr.Ident(t.text))
}

/// Apply a build helper / node constructor, returning a `CapVal` so the
/// vocabulary spans BOTH target families: expression builds wrap their
/// `ExprId` in `CapVal.Node`, statement builds their `StmtId` in
/// `CapVal.SNode`. The fixed expression vocabulary (GRAMMAR_DSL.md §1):
/// `fold_binary`/`fold_logical`/`fold_postfix` (left-assoc chains) + node
/// ctors (`Unary`, `Grouping`, `*_suffix`). The statement vocabulary
/// (ps3t.6.5.2): the simplest Stmt ctors — `Break`, `Continue`,
/// `ReturnEmpty`, `Return(e)`, `ExprStmt(e)`. Unknown names are a reported
/// error, not a silent miss.
/// Re-type a method's leading `self` receiver to the concrete impl target,
/// mirroring parse_method_param_list — which types `self` as
/// `vtype_from_name(target)` (the receiver type), not as MkMethod's plain-param
/// default. A static method (no leading `self`) is returned unchanged. Keeps
/// the DSL's built AST structurally equal to the hand parser's, not merely
/// render-equal (render_param_list omits param types).
/// `st` is needed because retyping `self` must maintain the F1d DUAL: a param in a
/// type-carrying position owns a real type ROW alongside its vtype, and rewriting the
/// vtype without re-ingesting leaves `ty_id` pointing at the pre-retype type — or, as
/// here, at nothing at all. The hand parser stamps both; so must this.
/// (f1a_container_duals_test's "self's ty_id carries the impl header type".)
fn retype_self_param(st: PState, params: List<ParamEntry>, target: string) -> List<ParamEntry> {
    if params.length == 0 { return params }
    if params[0].name != "self" { return params }
    let self_vt = vtype_from_name(target)
    mut out: List<ParamEntry> = [ParamEntry { name: "self", vtype: self_vt, ty_id: st.store.ingest_type(self_vt, byte_span_none()) }]
    mut i = 1
    while i < params.length {
        out.push(params[i])
        i = i + 1
    }
    out
}

fn apply_build(g: Grammar, name: string, args: List<string>, env: CapEnv, st: PState) -> CapVal {
    // Dispatch on the build name — one arm per grammar `-> Build(...)`, the
    // one target-specific seam (mirroring the derive engine's pluggable
    // emitters). Each arm is arity-guarded (`if args.length == N`); an
    // unknown name OR a wrong arity falls to the `_` arm (an error node),
    // exactly as the prior long if-chain fell through.
    match name {
        // ── Expression builds (target: Expr) ──
        "fold_binary" if args.length == 3 -> CapVal.Node(fold_binary_expr(st, env.get(args[0]), env.get(args[1]), env.get(args[2])))
        "Unary" if args.length == 2 -> CapVal.Node(unary_expr(st, env.get(args[0]), env.get(args[1])))
        // sp_start = 0 - 1 (negative → span-free): the INTERPRETER is the differential
        // oracle (AVRA_PARSER_EXPR_FLIP), default-off and span-untested — exec_rule
        // doesn't thread a rule-entry byte here, so these fold to byte_span_none exactly
        // as their prior add_leaf did. The GENERATED static parser passes the real
        // rule-entry sp_start (emit) so its production spans match the hand parser.
        "fold_logical" if args.length == 3 -> CapVal.Node(fold_logical_expr(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2])))
        "fold_nullish" if args.length == 3 -> CapVal.Node(fold_nullish_expr(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2])))
        "mk_assign" if args.length == 2 -> CapVal.Node(mk_assign_expr(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "fold_pipe" if args.length == 2 -> CapVal.Node(fold_pipe_expr(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "fold_with" if args.length == 2 -> CapVal.Node(fold_with_expr(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "fold_postfix_with" if args.length == 3 -> CapVal.Node(fold_postfix_with_expr(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2])))
        "rebind_eq" if args.length == 2 -> CapVal.Node(rebind_eq_expr(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "mk_is" if args.length == 1 -> CapVal.Node(mk_is_expr(st, env.get(args[0])))
        "mk_inlist" if args.length == 1 -> CapVal.Node(mk_inlist_expr(st, env.get(args[0])))
        // `name: value` / shorthand `name` struct field-init, and the `with { … }`
        // suffix that folds a list of them (t-47hc.17). The interpreter is the
        // differential oracle, so the suffix is span-free (sp_start = 0 - 1) exactly
        // like the sibling builds; the GENERATED parser passes the real chain start.
        "MkFieldInit" if args.length == 2 -> mk_field_init(st, env.get(args[0]), env.get(args[1]))
        "MkWithSuffix" if args.length == 1 -> CapVal.Node(mk_with_suffix(st, 0 - 1, env.get(args[0])))
        // `[ … ]` list literal + comprehension (t-47hc.4 — DORMANT builds; the interpreter
        // is the differential oracle so sp_start = 0 - 1 span-free, exactly like the folds).
        "MkListLit" if args.length == 1 -> CapVal.Node(mk_list_lit(st, 0 - 1, env.get(args[0])))
        "MkTemplate" if args.length == 1 -> CapVal.Node(mk_template(st, env.get(args[0])))
        "MkQualExpr" if args.length == 4 -> CapVal.Node(mk_qualified(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]), env.get(args[3])))
        // t-47hc slice 8 — the two IDENT-led primaries the `ident_primary` flip needs.
        // Dormant until a grammar references them.
        "MkGrammarBlock" if args.length == 1 -> CapVal.Node(mk_grammar_block(st, 0 - 1, env.get(args[0])))
        "MkStructLit" if args.length == 2 -> CapVal.Node(mk_struct_lit(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        // ── the `table { … }` literal (t-myz7) ──
        // `MkTableHeader` yields CapVal.Nil, not a node: its whole job is to PUSH the
        // header context the row build reads, so it must not mint an arena row.
        "MkTableHeader" if args.length == 2 -> mk_table_header(st, env.get(args[0]), env.get(args[1]))
        "MkTableRow" if args.length == 1 -> CapVal.Node(mk_table_row(st, env.get(args[0])))
        "MkTableLit" if args.length == 1 -> CapVal.Node(mk_table_lit(st, 0 - 1, env.get(args[0])))
        "MkTaggedTemplate" if args.length == 2 -> CapVal.Node(mk_tagged_template(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "MkMapLit" if args.length == 2 -> CapVal.Node(mk_map_lit(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "MkSplice" if args.length == 1 -> CapVal.Node(mk_splice(st, 0 - 1, env.get(args[0])))
        "MkSpliceStruct" if args.length == 2 -> CapVal.Node(mk_splice_struct(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        // ── Native `postfix_suffix` steps (t-47hc.33) ──
        // These take NO `sp_start` build arg: they read `st.postfix_sp_start`, the chain
        // start the `( postfix_suffix )*` loop threads. So unlike every sibling above,
        // the INTERPRETER's spans here are real rather than `0 - 1` span-free — the
        // anchor is parse state, not a rule-entry byte exec_rule would have to supply.
        "MkTrySuffix" if args.length == 0 -> CapVal.Node(mk_try_suffix(st))
        "MkForceUnwrap" if args.length == 0 -> CapVal.Node(mk_force_unwrap(st))
        "MkCallArg" if args.length == 1 -> CapVal.Node(mk_call_arg(st, env.get(args[0])))
        "MkCallSuffix" if args.length == 1 -> CapVal.Node(mk_call_suffix(st, env.get(args[0])))
        "MkGenericCallSuffix" if args.length == 2 -> CapVal.Node(mk_generic_call_suffix(st, capval_to_texpr_list(env.get(args[0])), env.get(args[1])))
        "MkTupleIndex" if args.length == 1 -> CapVal.Node(mk_tuple_index(st, env.get(args[0])))
        "MkIndexSuffix" if args.length == 2 -> CapVal.Node(mk_index_suffix(st, env.get(args[0]), env.get(args[1])))
        "MkNone" if args.length == 0 -> mk_none_cap(st)
        "MkOptChain" if args.length == 1 -> CapVal.Node(mk_opt_chain(st, env.get(args[0])))
        "MkOptMethodCall" if args.length == 2 -> CapVal.Node(mk_opt_method_call(st, env.get(args[0]), env.get(args[1])))
        "MkTupleIndex" if args.length == 1 -> CapVal.Node(mk_tuple_index(st, env.get(args[0])))
        "MkFieldAccess" if args.length == 1 -> CapVal.Node(mk_field_access(st, env.get(args[0])))
        "MkEnumCtorSuffix" if args.length == 2 -> CapVal.Node(mk_enum_ctor_suffix(st, env.get(args[0]), env.get(args[1])))
        "MkCatchSuffix" if args.length == 3 -> CapVal.Node(mk_catch_suffix(st, env.get(args[0]), env.get(args[1]), env.get(args[2])))
        // `( a, b, … )` tuple (t-47hc paren prep — DORMANT; interpreter oracle, sp_start
        // = 0 - 1 span-free, exactly like MkListLit).
        "MkTuple" if args.length == 1 -> CapVal.Node(mk_tuple(st, 0 - 1, env.get(args[0])))
        // `( … ) -> body` untyped lambda (t-47hc paren prep — DORMANT; interpreter oracle,
        // sp_start = 0 - 1 span-free). args[0] = the param-name capture, args[1] = the body.
        "MkLambda" if args.length == 2 -> CapVal.Node(mk_lambda(st, 0 - 1, env.get(args[0]), capval_to_expr(st, env.get(args[1]))))
        // `( x: T, … ) -> body` typed lambda (t-47hc paren prep — DORMANT; interpreter
        // oracle, sp_start = 0 - 1). args[0] = the PENTRY-list capture (MkParam-built),
        // args[1] = the body. capval_to_pentry_list is the same converter MkFnDecl uses.
        "MkLambdaTyped" if args.length == 2 -> CapVal.Node(mk_lambda_typed(st, 0 - 1, capval_to_pentry_list(env.get(args[0])), capval_to_expr(st, env.get(args[1]))))
        // `( e )` grouping OR `()` empty tuple (t-47hc paren spend). args[0] = the OPT-SCALAR
        // grouping expr — env.get yields CapVal.Nil when absent → Tuple([]), else Grouping(e).
        "MkGroupOrEmpty" if args.length == 1 -> CapVal.Node(mk_group_or_empty(st, 0 - 1, env.get(args[0])))
        // `( first, rest… )` tuple built from a SCALAR first + a REST list (t-47hc paren
        // spend). args[0] = the mandatory-comma-preceded first element, args[1] = the rest.
        "MkTupleFR" if args.length == 2 -> CapVal.Node(mk_tuple_fr(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "MkListComp" if args.length == 3 -> CapVal.Node(mk_list_comp(st, 0 - 1, capval_to_expr(st, env.get(args[0])), capval_tok_text(env.get(args[1])), capval_to_expr(st, env.get(args[2])), CapVal.Nil))
        "MkListComp" if args.length == 4 -> CapVal.Node(mk_list_comp(st, 0 - 1, capval_to_expr(st, env.get(args[0])), capval_tok_text(env.get(args[1])), capval_to_expr(st, env.get(args[2])), env.get(args[3])))
        "MkChannel" if args.length == 2 -> mk_channel(st, 0 - 1, env.get(args[0]), env.get(args[1]))
        "MkExprBlock" if args.length == 1 -> mk_expr_block(st, 0 - 1, env.get(args[0]))
        "MkQuoteArm" if args.length == 4 -> mk_quote_arm(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]), env.get(args[3]))
        "MkQuoteType" if args.length == 2 -> mk_quote_type(st, 0 - 1, env.get(args[0]), env.get(args[1]))
        "MkQuote" if args.length == 2 -> mk_quote(st, 0 - 1, env.get(args[0]), env.get(args[1]))
        "MkSpawn" if args.length == 1 -> mk_spawn(st, 0 - 1, env.get(args[0]))
        "MkIsolated" if args.length == 1 -> mk_isolated(st, 0 - 1, env.get(args[0]))
        "MkWhenArm" if args.length == 2 -> mk_when_arm(st, env.get(args[0]), env.get(args[1]))
        "MkWhenDefault" if args.length == 1 -> mk_when_default(st, env.get(args[0]))
        "MkWhen" if args.length == 1 -> mk_when(st, 0 - 1, env.get(args[0]))
        // The concurrency statements (t-47hc Phase 4) — both engines lower
        // through the shared cores.
        "MkParallel" if args.length == 1 -> mk_parallel_g(st, capval_to_stmt_list(env.get(args[0])))
        "MkSelect" if args.length == 1 -> mk_select_g(st, env.get(args[0]))
        "MkSelectArm" if args.length == 3 -> mk_select_arm_g(st, capval_tok_text(env.get(args[0])), env.get(args[1]), capval_to_stmt_list(env.get(args[2])))
        "MkSpecBlock" if args.length == 2 -> mk_spec_block_g(st, capval_tok_text(env.get(args[0])), capval_to_stmt_list(env.get(args[1])))
        "MkGivenBlock" if args.length == 2 -> mk_given_block_g(st, capval_tok_text(env.get(args[0])), capval_to_stmt_list(env.get(args[1])))
        "MkThenBlock" if args.length == 2 -> mk_then_block_g(st, capval_tok_text(env.get(args[0])), capval_to_stmt_list(env.get(args[1])))
        // The component definition (t-47hc slice A) — shared cores.
        "MkCompConfig" if args.length == 3 -> mk_comp_config_g(st, capval_tok_text(env.get(args[0])), env.get(args[1]), env.get(args[2]), capval_present(env.get(args[2])))
        "MkChildrenSlot" if args.length == 2 -> mk_children_slot_g(st, capval_tok_text(env.get(args[0])), env.get(args[1]))
        "MkCompField" if args.length == 3 -> mk_comp_field_g(st, capval_tok_text(env.get(args[0])), env.get(args[1]), env.get(args[2]), capval_present(env.get(args[2])))
        "MkComponentDef" if args.length == 6 -> mk_component_def_g(st, capval_tok_text(env.get(args[0])), capval_tok_texts(env.get(args[1])), env.get(args[2]), env.get(args[3]), capval_tok_text(env.get(args[4])), capval_present(env.get(args[4])), capval_to_stmt_list(env.get(args[5])))
        "MkCompConfigPair" if args.length == 2 -> mk_comp_config_pair_g(st, capval_tok_text(env.get(args[0])), capval_to_expr(st, env.get(args[1])))
        "MkComponentBlock" if args.length == 4 -> mk_component_block_g(st, capval_tok_text(env.get(args[0])), capval_tok_text(env.get(args[1])), capval_to_comp_config_pair_list(env.get(args[2])), capval_to_stmt_list(env.get(args[3])))
        "MkRawComponentBlock" if args.length == 3 -> mk_raw_component_block_g(st, capval_tok_text(env.get(args[0])), capval_tok_text(env.get(args[1])), capval_tok_text(env.get(args[2])))
        "MkMethodShorthand" if args.length == 2 -> mk_method_shorthand_g(st, capval_tok_text(env.get(args[0])), capval_to_stmt_list(env.get(args[1])))
        // EXPRESSION `match subj { arms }` (t-47hc.25). The interpreter has no
        // sequence-start byte, so -1 => byte_span_none, matching every sibling build.
        "MkMatchExpr" if args.length == 2 -> mk_match_expr(st, 0 - 1, env.get(args[0]), env.get(args[1]))
        // `if c { … } else …` (t-47hc.24). An ABSENT else arrives as CapVal.Nil, which
        // mk_if_expr turns into the hand's synthesized empty (Void) block.
        "MkIfExpr" if args.length == 3 -> mk_if_expr(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]))
        "MkIfLet" if args.length == 5 -> mk_if_let(st, env.get(args[0]), env.get(args[1]), env.get(args[2]), env.get(args[3]), env.get(args[4]))
        // Subjectless `match { … }` at STATEMENT position: the hand builds Expr.When and
        // boxes it in Stmt.Expr (parse_match_statement), so this does exactly that pair.
        "MkWhenStmt" if args.length == 1 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, mk_when(st, 0 - 1, env.get(args[0]))))))
        "mk_inrange" if args.length == 2 -> CapVal.Node(mk_inrange_expr(st, env.get(args[0]), env.get(args[1])))
        "mk_enum_ctor" if args.length == 2 -> CapVal.Node(mk_enum_ctor_expr(st, 0 - 1, env.get(args[0]), env.get(args[1])))
        "mk_eqchain" if args.length == 2 -> CapVal.Node(mk_eqchain_expr(st, env.get(args[0]), env.get(args[1])))
        "Grouping" if args.length == 1 -> {
            // Preserve the parenthesisation node so the produced AST matches
            // the hand-written parser (which wraps `(e)` in Expr.Grouping),
            // not merely a grouping-normalised form.
            CapVal.Node(st.store.exprs.add_leaf(Expr.Grouping(capval_to_expr(st, env.get(args[0])))))
        }
        "field_suffix" if args.length == 1 -> {
            // A partial FieldAccess with a sentinel receiver; fold_postfix
            // rebinds the receiver to the accumulated base.
            CapVal.Node(st.store.exprs.add_leaf(Expr.FieldAccess(st.missing_node(), capval_tok_text(env.get(args[0])))))
        }
        "index_suffix" if args.length == 1 -> CapVal.Node(st.store.exprs.add_leaf(Expr.Index(st.missing_node(), capval_to_expr(st, env.get(args[0])))))
        "call_suffix" if args.length == 1 -> {
            // A partial Call with a sentinel callee + the captured arg list
            // (a single arg arrives as a scalar Node, many as Nodes, none as
            // Nil — normalise to a list). fold_postfix rebinds the callee.
            CapVal.Node(st.store.exprs.add_leaf(Expr.Call(st.missing_node(), capval_to_node_list(env.get(args[0])))))
        }
        "fold_postfix" if args.length == 2 -> CapVal.Node(fold_postfix_expr(st, env.get(args[0]), env.get(args[1])))
        // ── Statement builds (target: Stmt, ps3t.6.5.2) ──
        "Break" if args.length == 0 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Break))
        "Continue" if args.length == 0 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Continue))
        "ReturnEmpty" if args.length == 0 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.ReturnEmpty))
        "Return" if args.length == 1 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Return(capval_to_expr(st, env.get(args[0])))))
        // `return` with an OPTIONAL operand: absent ⇒ ReturnEmpty, present ⇒
        // Return(e). A bare `return` before `}` / EOF simply doesn't match the
        // optional expression (its FIRST-set rejects those tokens), so it folds
        // to ReturnEmpty with no newline info needed. The remaining
        // newline-sensitive case — `return\n<expr>` where the value sits on the
        // NEXT line (the hand parser's `current_line != prev_line` guard) — is a
        // lexer-mode disambiguation for the gnarly-5% catalogue (ps3t.6.5.10).
        "MkReturn" if args.length == 1 -> mk_return_opt(st, env.get(args[0]))
        // A statement-position expression that FAILED recovers as a bare `Stmt.Error`,
        // the twin of the hand parser's `parse_expression()?` yielding `.Err` — the
        // enclosing list-parser then synchronises identically. Without it a failed
        // expression is wrapped as `Stmt.Expr(Expr.Error)`, so a stray top-level token
        // renders `(expr (error))` where the hand renders `<err>`.
        //
        // emit's apply_build twin has carried this check since the 5c recovery-tree work;
        // the executor never needed it because `exec_node` FIRST-guarded its way out
        // before ever reaching `expr_stmt` on a stray token. Giving the executor the
        // unguarded tail (t-zrn3) makes that path reachable, which is what exposed the
        // third instance of the same emit/executor asymmetry.
        "ExprStmt" if args.length == 1 -> {
            if st.had_error { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error)) }
            else { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, env.get(args[0]))))) }
        }
        // ── Control-flow + block builds (target: Stmt, ps3t.6.5.3) — each arm
        //    delegates to the SHARED constructor core (mk_block / mk_while /
        //    mk_if / mk_for_loop), so apply_build and the generated static
        //    whole-program parser build byte-identical trees. ──
        // sp_start = 0 - 1 (span-free): the interpreter is the differential oracle and
        // records no positions, exactly like the fold builds above; the GENERATED static
        // parser passes the real rule-entry sp_start (emit) so its per-statement SrcPos
        // side-table matches the hand parser's parse_statement_list_ids. (t-47hc.12)
        "Block" if args.length == 1 -> mk_block(st, 0 - 1, capval_to_stmt_list(env.get(args[0])))
        "While" if args.length == 2 -> mk_while(st, 0 - 1, env.get(args[0]), env.get(args[1]))
        "If" if args.length == 3 -> mk_if(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]))
        "ForLoop" if args.length == 4 -> mk_for_loop(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]), env.get(args[3]))
        "MkForBinding" if args.length == 2 -> mk_for_binding(env.get(args[0]), env.get(args[1]))
        "MkForDestructure" if args.length == 3 -> mk_for_destructure(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]))
        // ── Pattern builds (target: Pat, ps3t.6.5.5) ──
        "OrMaybe" if args.length == 2 -> {
            // `l ( "or" r )?` — the right-recursive or-pattern (parse_pattern_or).
            // Absent `or` ⇒ just the left pattern; present ⇒ `Pattern.Or(l, r)`
            // (right-associative, since `r` is itself a pattern_or).
            match env.get(args[1]) {
                .Nil -> env.get(args[0])
                _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.Or(capval_to_pat(st, env.get(args[0])), capval_to_pat(st, env.get(args[1])))))
            }
        }
        "IdentPat" if args.length == 2 -> {
            // A bare identifier pattern: `_` ⇒ Wildcard, `rest` ⇒ Rest (both
            // contextual — only when NOT followed by `(`), and `name(binding)`
            // ⇒ TypePattern. The Nil-arm core is `ident_pat_bare` (shared with
            // the generated static pattern parser).
            let nm = capval_tok_text(env.get(args[0]))
            match env.get(args[1]) {
                .Nil -> CapVal.PNode(ident_pat_bare(st, nm))
                _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.TypePattern(nm, capval_tok_text(env.get(args[1])))))
            }
        }
        "MkVariant" if args.length == 3 -> {
            // `.Name` / `.Name(bind, …)` / `.Name(.Sub, …)`. A sub-pattern
            // payload (first token `.`) ⇒ NestedVariant; a binding payload
            // (identifiers) or none ⇒ Variant — mirroring the hand parser's
            // is_pattern_start (`.`-only) branch.
            let nm = capval_tok_text(env.get(args[0]))
            match env.get(args[2]) {
                .Nil -> CapVal.PNode(st.store.pats.add_leaf(Pattern.Variant(nm, param_entries_from_toks(env.get(args[1]), ValueType.Int))))
                _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.NestedVariant(nm, capval_to_pat_list(env.get(args[2])))))
            }
        }
        "PatStr" if args.length == 1 -> CapVal.PNode(pat_str_node(st, capval_tok_text(env.get(args[0]))))
        "PatBool" if args.length == 1 -> CapVal.PNode(pat_bool_node(st, capval_tok_text(env.get(args[0]))))
        "PatNum" if args.length == 1 -> CapVal.PNode(pat_num_node(st, capval_tok_text(env.get(args[0])), false))
        "PatNegNum" if args.length == 1 -> CapVal.PNode(pat_num_node(st, capval_tok_text(env.get(args[0])), true))
        // The optional-match arm surface (spec Axis 10.4): `let <name> ->` binds the
        // present value (lowers to `.Some(name)`), `none`/`null ->` matches absence
        // (`.None`). Both delegate to the SHARED reducer cores the hand parser uses
        // (pattern_optional_present / pattern_optional_absent), so the trees coincide.
        "OptPresent" if args.length == 1 -> CapVal.PNode(st.store.pats.add_leaf(pattern_optional_present(capval_tok_text(env.get(args[0])))))
        "OptAbsent" if args.length == 0 -> CapVal.PNode(st.store.pats.add_leaf(pattern_optional_absent()))
        // ── Type-expression builds (target: TypeExpr, ps3t.6.5.6) — each arm
        //    delegates to the SHARED constructor core (fold_type_union /
        //    mk_named_type / mk_paren_type / mk_fn_type), so apply_build and the
        //    generated static type parser build byte-identical trees. ──
        "TyUnion" if args.length == 2 -> fold_type_union(st, env.get(args[0]), capval_to_texpr_list(env.get(args[1])))
        "MkNamed" if args.length == 3 -> mk_named_type(capval_tok_text(env.get(args[0])), capval_present(env.get(args[1])), capval_to_texpr_list(env.get(args[1])), capval_present(env.get(args[2])))
        "MkQualified" if args.length == 3 -> mk_qualified_type(capval_toks(env.get(args[0])), capval_present(env.get(args[1])), capval_to_texpr_list(env.get(args[1])), capval_present(env.get(args[2])))
        "TyList" if args.length == 1 -> CapVal.TExpr(TypeExpr.ListType(capval_to_texpr(st, env.get(args[0]))))
        "TyParen" if args.length == 1 -> mk_paren_type(capval_to_texpr_list(env.get(args[0])))
        "TyDyn" if args.length == 1 -> mk_dyn_type(capval_tok_text(env.get(args[0])), false)
        "TyDyn" if args.length == 2 -> mk_dyn_type(capval_tok_text(env.get(args[0])), capval_present(env.get(args[1])))
        "MkFn" if args.length == 3 -> mk_fn_type(st, capval_present(env.get(args[0])), capval_to_texpr_list(env.get(args[1])), capval_present(env.get(args[2])), env.get(args[2]))
        // ── Binding + remaining statement builds (target: Stmt, ps3t.6.5.4) ──
        // `let`/`mut`/`const name (":" T)? "=" init`. The optional annotation
        // lowers through the SHARED type family (a captured TExpr → ValueType via
        // type_expr_to_vtype); absent ⇒ Unknown — exactly the hand parser's
        // `ty_vt = Unknown` default. `let mut` and a bare `mut` both build Mut.
        "MkLet" if args.length == 3 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Let(capval_tok_text(env.get(args[0])), ann_to_vtype(env.get(args[1])), capval_to_expr(st, env.get(args[2])))))
        "MkMut" if args.length == 3 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Mut(capval_tok_text(env.get(args[0])), ann_to_vtype(env.get(args[1])), capval_to_expr(st, env.get(args[2])))))
        "MkConst" if args.length == 3 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Const(capval_tok_text(env.get(args[0])), ann_to_vtype(env.get(args[1])), capval_to_expr(st, env.get(args[2])))))
        // `let (a, b, …) = init` — delegates to the SHARED core (t-47hc Phase 4:
        // this build is on the PRODUCTION path now, so apply_build and the
        // generated static parser must lower through one implementation).
        "MkDestructure" if args.length == 2 -> mk_let_destructure_g(st, capval_tok_list(env.get(args[0])), env.get(args[1]))
        "MkDefer" if args.length == 1 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Defer(capval_to_expr(st, env.get(args[0])))))
        "MkErrdefer" if args.length == 1 -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.Errdefer(capval_to_expr(st, env.get(args[0])))))
        // ── Match statement builds (target: Stmt, ps3t.6.5.4) ──
        "MkArmReturn" if args.length == 1 -> mk_arm_return(st, 0 - 1, env.get(args[0]))
        "MkArm" if args.length == 3 -> {
            // `pattern ( "if" guard )? "->" body` — one match arm. MatchArm carries
            // the boxed Pattern (read back from the arena — render_match_arm renders
            // it) AND its PatId; the guard is nullable (absent ⇒ none).
            let pat_id = capval_to_pat(st, env.get(args[0]))
            mut guard: ExprId? = none
            if capval_present(env.get(args[1])) { guard = capval_to_expr(st, env.get(args[1])) }
            CapVal.Arm(MatchArm { pattern: st.store.pats.get(pat_id), pattern_id: pat_id, guard_id: guard, body_id: capval_to_expr(st, env.get(args[2])) })
        }
        "MkMatchTable" if args.length == 4 -> mk_match_table(st, env.get(args[0]), env.get(args[1]), env.get(args[2]), env.get(args[3]))
        "MkMatchTableExpr" if args.length == 4 -> mk_match_table_expr(st, 0 - 1, env.get(args[0]), env.get(args[1]), env.get(args[2]), env.get(args[3]))
        "MkMatch" if args.length == 2 -> {
            // `match subject { arm* }` — statement-position match.
            CapVal.SNode(st.store.stmts.add_leaf(Stmt.Match(capval_to_expr(st, env.get(args[0])), capval_to_arm_list(env.get(args[1])))))
        }
        // ── Declaration builds (target: Stmt, ps3t.6.5.7) — the non-generic
        //    arms delegate to SHARED constructor cores (mk_param / mk_fn_decl /
        //    mk_field / mk_type_decl / … / mk_impl), so apply_build and the
        //    generated static whole-program parser build byte-identical trees.
        //    The GENERIC arms (extra type-param list) stay inline — the 6.5.11
        //    whole-program grammar has no generic-decl slice. ──
        "MkParam" if args.length == 2 -> mk_param(st, capval_tok_text(env.get(args[0])), env.get(args[1]), capval_present(env.get(args[1])))
        "MkTypeParam" if args.length == 2 -> mk_type_param(capval_tok_text(env.get(args[0])), env.get(args[1]), capval_present(env.get(args[1])))
        "MkFnDecl" if args.length == 4 -> mk_fn_decl(st, capval_tok_text(env.get(args[0])), capval_to_pentry_list(env.get(args[1])), env.get(args[2]), capval_present(env.get(args[2])), capval_to_stmt_list(env.get(args[3])))
        // Generic form: `fn name < tparams > ( params? ) ( "->" ret )? { body }`.
        // Args shift by one for the type-param list (args[1]); the rest match the
        // 4-arg form. Shares mk_fn_decl_g with the emitted parser.
        "MkFnDecl" if args.length == 5 -> mk_fn_decl_g(st, capval_tok_text(env.get(args[0])), capval_to_tparam_list(env.get(args[1])), capval_to_pentry_list(env.get(args[2])), env.get(args[3]), capval_present(env.get(args[3])), capval_to_stmt_list(env.get(args[4])))
        "MkField" if args.length == 2 -> mk_field(st, capval_tok_text(env.get(args[0])), env.get(args[1]))
        "MkTypeDecl" if args.length == 2 -> mk_type_decl(st, capval_tok_text(env.get(args[0])), capval_to_field_list(env.get(args[1])))
        // Generic struct: `type Name < tparams > = { field* }` — the type-param
        // list (args[1]) is stored + rendered `<…>`. Shares mk_type_decl_g with emit.
        "MkShapeDecl" if args.length == 2 -> mk_shape_decl(st, capval_tok_text(env.get(args[0])), capval_to_field_list(env.get(args[1])))
        "MkTypeDeclAny" if args.length == 6 -> mk_type_decl_any(st, capval_tok_text(env.get(args[0])), capval_to_tparam_list(env.get(args[1])), capval_to_field_list(env.get(args[2])), env.get(args[3]), capval_present(env.get(args[3])), env.get(args[4]), capval_present(env.get(args[4])), capval_tok_list(env.get(args[5])))
        "MkTypeDecl" if args.length == 3 -> mk_type_decl_g(st, capval_tok_text(env.get(args[0])), capval_to_tparam_list(env.get(args[1])), capval_to_field_list(env.get(args[2])))
        "MkEVariant" if args.length == 2 -> mk_evariant(capval_tok_text(env.get(args[0])), capval_to_field_list(env.get(args[1])))
        "MkEnumDecl" if args.length == 2 -> mk_enum_decl(st, capval_tok_text(env.get(args[0])), capval_to_var_list(env.get(args[1])))
        // Generic enum: `enum Name < tparams > { variant* }` — the type-param list
        // (args[1]) is stored + rendered `<…>`. Shares mk_enum_decl_g with emit.
        "MkEnumDecl" if args.length == 3 -> mk_enum_decl_g(st, capval_tok_text(env.get(args[0])), capval_to_tparam_list(env.get(args[1])), capval_to_var_list(env.get(args[2])))
        "MkUse" if args.length == 3 -> mk_use(st, capval_present(env.get(args[0])), capval_tok_list(env.get(args[1])), capval_tok_list(env.get(args[2])))
        "MkUseBare" if args.length == 2 -> mk_use(st, false, capval_tok_list(env.get(args[0])), capval_tok_list(env.get(args[1])))
        "MkUsePkg" if args.length == 3 -> mk_use_pkg(st, capval_tok_list(env.get(args[0])), capval_tok_list(env.get(args[1])), capval_tok_list(env.get(args[2])))
        "MkModule" if args.length == 1 -> mk_module(st, capval_tok_text(env.get(args[0])))
        // ── Trait declaration builds (target: Stmt, ps3t.6.5.7) ──
        "MkAssocType" if args.length == 1 -> mk_assoc_type(st, capval_tok_text(env.get(args[0])))
        "MkTraitMethod" if args.length == 5 -> mk_trait_method(st, capval_tok_text(env.get(args[0])), capval_to_pentry_list(env.get(args[1])), env.get(args[2]), capval_present(env.get(args[2])), capval_present(env.get(args[3])), capval_to_stmt_list(env.get(args[4])))
        "MkTraitDecl" if args.length == 2 -> mk_trait_decl(st, capval_tok_text(env.get(args[0])), capval_to_stmt_list(env.get(args[1])))
        // ── Impl declaration builds (target: Stmt, ps3t.6.5.7) ──
        "MkMethod" if args.length == 4 -> mk_method(st, capval_tok_text(env.get(args[0])), capval_to_pentry_list(env.get(args[1])), env.get(args[2]), capval_present(env.get(args[2])), capval_to_stmt_list(env.get(args[3])))
        "MkImpl" if args.length == 3 -> mk_impl(st, capval_tok_text(env.get(args[0])), env.get(args[1]), capval_present(env.get(args[1])), capval_to_stmt_list(env.get(args[2])))
        // ── Modifier declaration builds (target: Stmt, ps3t.6.5.7) ──
        "MkExtern" if args.length == 3 -> mk_extern_fn(st, capval_tok_text(env.get(args[0])), capval_to_pentry_list(env.get(args[1])), env.get(args[2]), capval_present(env.get(args[2])))
        "MkExport" if args.length == 1 -> mk_export_decl(st, env.get(args[0]))
        // Span-free in the interpreter (`0 - 1`), exactly like Block / While / MkIfExpr:
        // the oracle records no positions.
        "MkStampAt" if args.length == 1 -> mk_stamp_stmt_at(st, 0 - 1, env.get(args[0]))
        // ── Prefix-wrapper builds (target: Stmt, t-47hc Phase 4) ──
        "MkDocAnnotated" if args.length == 2 -> mk_doc_annotated(st, capval_tok_list(env.get(args[0])), env.get(args[1]))
        // Span-free in the interpreter, like MkStampAt: the NoOp's position is
        // recorded only on the emitted path.
        "MkModuleDoc" if args.length == 1 -> mk_module_doc(st, 0 - 1, capval_tok_list(env.get(args[0])))
        // ── Binding declaration builds (target: Stmt, t-47hc Phase 4) — the
        //    PRODUCTION `let`/`mut`/`const` rules. Distinct from the §2 oracle-era
        //    MkLet/MkMut/MkConst above: these build the hand's alloc_binding_stmt
        //    row (TypeRef edge) and carry the `else` guard form. ──
        "MkLetBinding" if args.length == 6 -> mk_let_binding_g(st, capval_present(env.get(args[0])), capval_tok_text(env.get(args[1])), env.get(args[2]), capval_present(env.get(args[2])), env.get(args[3]), env.get(args[4]), capval_present(env.get(args[4])), env.get(args[5]))
        "MkMutBinding" if args.length == 5 -> mk_let_binding_g(st, true, capval_tok_text(env.get(args[0])), env.get(args[1]), capval_present(env.get(args[1])), env.get(args[2]), env.get(args[3]), capval_present(env.get(args[3])), env.get(args[4]))
        "MkConstBinding" if args.length == 3 -> mk_const_binding_g(st, capval_tok_text(env.get(args[0])), env.get(args[1]), capval_present(env.get(args[1])), env.get(args[2]))
        // `type Name = base ( ("without"|"only") "{" fields "}" )?` — the non-brace RHS
        // only, kept for the grammar-string consumers that predate `MkTypeDeclAny`
        // (decl_type_op_test). It DELEGATES rather than reimplementing: slice 10.5 grew
        // `mk_type_decl_any` to cover every `type` RHS the hand produces, which made this
        // arm a second implementation of the same trifurcation — and the older one was
        // subtly wrong, building the alias nodes with `add_leaf` where the hand uses
        // `alloc_stmt(..., [NodeRef.TypeRef(...)])`, so the walker's only child was
        // dropped. One core, one behaviour.
        //
        // No type params and no brace fields at this arity: an empty list and an absent
        // alias flag reproduce exactly what this arm built before.
        "MkTypeRHS" if args.length == 4 -> {
            let no_tp: List<TypeParamEntry> = []
            let no_fields: List<FieldEntry> = []
            mk_type_decl_any(st, capval_tok_text(env.get(args[0])), no_tp, no_fields, env.get(args[1]), true, env.get(args[2]), capval_present(env.get(args[2])), capval_tok_list(env.get(args[3])))
        }
        "MkTypeAlias" if args.length == 2 -> {
            // `type Name = <type_expr>` (NON-brace RHS). A Union RHS
            // (`type X = A | B`) → Stmt.UnionAliasDecl; anything else
            // (`type X = Other`, a nominal/container type) → Stmt.NewtypeDecl
            // (a nominal wrapper) — mirroring parse_type_declaration's
            // non-brace branch, which matches on TypeExpr.Union. (The brace
            // struct form and the `without`/`only` type operators are
            // separate slices.)
            let name = capval_tok_text(env.get(args[0]))
            let te = capval_to_texpr(st, env.get(args[1]))
            let vt = type_expr_to_vtype(te)
            match te {
                .Union(_, _) -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.UnionAliasDecl(name, vt)))
                _ -> CapVal.SNode(st.store.stmts.add_leaf(Stmt.NewtypeDecl(name, vt)))
            }
        }
        "MkAnn" if args.length == 2 -> {
            // One annotation `@name ( "(" args ")" )?` — a name + its built
            // argument EXPRESSIONS (arg_ids), exactly parse_annotations. Absent
            // args ⇒ empty arg_ids (a bare `@name`), so this build subsumes the
            // bare case too. The args reuse the DSL expression family.
            mk_ann_g(capval_tok_text(env.get(args[0])), capval_to_node_list(env.get(args[1])))
        }
        "MkAnnotatedArgs" if args.length == 2 -> {
            // `( "@" name args? )+ <decl>` — one or more annotations (WITH args)
            // wrapping a declaration → Stmt.Annotated(annotations, inner), the
            // args-carrying sibling of MkAnnotated. Since render_annotation_list
            // drops arg_ids, arg equivalence is asserted directly in the test.
            mk_annotated_args_g(st, capval_to_ann_list(env.get(args[0])), env.get(args[1]))
        }
        "MkAnnotated" if args.length == 2 -> {
            // `( "@" name )+ <decl>` — one or more BARE annotations wrapping a
            // declaration → Stmt.Annotated(annotations, inner), exactly
            // parse_declaration's `@`-branch (parse_annotations stacks them in
            // source order). Bare only: an annotation with args (`@name(a, b)`)
            // isn't parsed here — its arg_ids would be empty while the hand
            // parser populates them, and the render (render_annotation_list =
            // name-only) would hide the divergence. Each annotation carries
            // empty arg_ids, matching a bare `@name`.
            mut anns: List<Annotation> = []
            match env.get(args[0]) {
                .Toks(ts) -> { for t in ts { anns.push(Annotation { name: t.text, arg_ids: [] }) } }
                .Tok(t) -> anns.push(Annotation { name: t.text, arg_ids: [] })
                _ -> {}
            }
            CapVal.SNode(st.store.stmts.add_leaf(Stmt.Annotated(anns, capval_to_stmt(st, env.get(args[1])))))
        }
        _ -> CapVal.Node(st.error_node("unknown build `${name}`"))
    }
}

/// An optional `: type` annotation capture → the declared `ValueType`, via
/// the SHARED `type_expr_to_vtype` (ps3t.6.5.4). Absent (or non-type) ⇒
/// `Unknown`, exactly the hand parser's un-annotated binding default.
fn ann_to_vtype(v: CapVal) -> ValueType {
    match v {
        .TExpr(te) -> type_expr_to_vtype(te)
        _ -> ValueType.Unknown
    }
}

/// True when a capture is present (bound to anything but `Nil`) — the
/// optionality probe for `( … )?` groups whose marker/inner capture drives a
/// build decision (ps3t.6.5.6: generic-args / `?` / fn param-list presence).
export fn capval_present(v: CapVal) -> bool {
    match v {
        .Nil -> false
        _ -> true
    }
}

/// Build an integer- or float-literal pattern from a NUMBER token's text.
/// The DSL lexer lexes `42` and `3.14` both as NUMBER (no separate Float
/// token — that awaits the real-lexer wiring, ps3t.6.5.8), so a `.` in the
/// text selects `LitFloat` (stored as the string, sign included) vs
/// `LitInt`, reproducing the hand parser's Number-vs-Float split exactly.
export fn pat_num_node(st: PState, text: string, negative: bool) -> PatId {
    if text.contains(".") {
        let v = if negative { "-" + text } else { text }
        return st.store.pats.add_leaf(Pattern.LitFloat(v))
    }
    let n = int(text)
    let iv = if negative { 0 - n } else { n }
    st.store.pats.add_leaf(Pattern.LitInt(iv))
}

/// A boolean literal pattern from its token text — the `PatBool` build's core
/// (shared by apply_build + the generated static pattern parser, ps3t.6.5.11).
export fn pat_bool_node(st: PState, text: string) -> PatId {
    let v = if text == "true" { 1 } else { 0 }
    st.store.pats.add_leaf(Pattern.LitBool(v))
}

/// A string literal pattern from the raw (bookend-quoted) token text — the
/// `PatStr` build's core; stores the unquoted content (render re-quotes).
export fn pat_str_node(st: PState, raw: string) -> PatId {
    let content = if raw.length >= 2 { raw.substring(1, raw.length - 1) } else { raw }
    st.store.pats.add_leaf(Pattern.LitString(content))
}

/// A bare identifier pattern (no `(binding)`): `_` ⇒ Wildcard, `rest` ⇒ Rest
/// (both contextual), any other bare identifier is not a valid top-level
/// pattern (reported, falls back to Wildcard). The `IdentPat` build's Nil-arm
/// core.
export fn ident_pat_bare(st: PState, nm: string) -> PatId {
    if nm == "_" { return st.store.pats.add_leaf(Pattern.Wildcard) }
    if nm == "rest" { return st.store.pats.add_leaf(Pattern.Rest) }
    st.report("`${nm}` is not a valid pattern (bare identifiers cannot bind at pattern top level)")
    st.store.pats.add_leaf(Pattern.Wildcard)
}

/// Coerce a capture value to a Stmt node — the statement twin of
/// `capval_to_expr`. Only a built statement node (`SNode`) is a valid
/// statement; anything else is a reported error yielding `Stmt.Error`.
export fn capval_to_stmt(st: PState, v: CapVal) -> StmtId {
    match v {
        .SNode(id) -> id
        _ -> {
            st.report("expected a statement")
            st.store.stmts.add_leaf(Stmt.Error)
        }
    }
}

/// A capture as a statement list (ps3t.6.5.3): the block-body `*` yields
/// `SNodes` for ≥2, a scalar `SNode` for exactly 1, `Nil` for none — the
/// statement twin of `capval_to_node_list`.
fn capval_to_stmt_list(v: CapVal) -> List<StmtId> {
    match v {
        .SNodes(ns) -> ns
        .SNode(id) -> [id]
        _ -> []
    }
}

/// Coerce a capture value to a Pattern node — the pattern twin of
/// `capval_to_stmt` (ps3t.6.5.5). Only a built pattern (`PNode`) is a
/// valid pattern; anything else is a reported error yielding a neutral
/// `Wildcard` (the Pattern enum has no Error variant, and Wildcard is the
/// natural error-tolerant placeholder — it matches anything, binds nothing).
export fn capval_to_pat(st: PState, v: CapVal) -> PatId {
    match v {
        .PNode(id) -> id
        _ -> {
            st.report("expected a pattern")
            st.store.pats.add_leaf(Pattern.Wildcard)
        }
    }
}

/// A capture as a pattern list (ps3t.6.5.5): a nested variant's sub-pattern
/// `*` yields `PNodes` for ≥2, a scalar `PNode` for exactly 1, `Nil` for
/// none — the pattern twin of capval_to_stmt_list.
export fn capval_to_pat_list(v: CapVal) -> List<PatId> {
    match v {
        .PNodes(ns) -> ns
        .PNode(id) -> [id]
        _ -> []
    }
}

/// Coerce a capture value to a surface `TypeExpr` — the type twin of
/// `capval_to_pat` (ps3t.6.5.6). Anything that isn't a built type expression
/// is a reported error yielding `TypeExpr.Infer` (the neutral under-determined
/// type, exactly what a missing annotation lowers to).
export fn capval_to_texpr(st: PState, v: CapVal) -> TypeExpr {
    match v {
        .TExpr(te) -> te
        _ -> {
            st.report("expected a type")
            TypeExpr.Infer
        }
    }
}

/// A capture as a type-expression list (ps3t.6.5.6): a comma-list `*` yields
/// `TExprs` for ≥2, a scalar `TExpr` for exactly 1, `Nil` for none.
export fn capval_to_texpr_list(v: CapVal) -> List<TypeExpr> {
    match v {
        .TExprs(tes) -> tes
        .TExpr(te) -> [te]
        _ -> []
    }
}

/// Fold a `l ( "|" r )*` union — the `TyUnion` build's core, shared by
/// apply_build + the generated static type parser (ps3t.6.5.11). No right
/// atoms ⇒ the left CapVal unchanged; otherwise a left-associative chain of
/// `TypeExpr.Union`, mirroring parse_type_expr's while-loop.
export fn fold_type_union(st: PState, l: CapVal, rs: List<TypeExpr>) -> CapVal {
    if rs.length == 0 { return l }
    mut acc = capval_to_texpr(st, l)
    for rt in rs { acc = TypeExpr.Union(acc, rt) }
    CapVal.TExpr(acc)
}

/// A named type (optionally generic, optionally nullable) — the `MkNamed`
/// build's core. `has_gen` ⇒ `Generic(nm, gen_args)`, else `Named(nm)`; an
/// `is_opt` wrap makes it `Optional`. Mirrors parse_type_atom's identifier
/// branch.
export fn mk_named_type(nm: string, has_gen: bool, gen_args: List<TypeExpr>, is_opt: bool) -> CapVal {
    mut base = if has_gen { TypeExpr.Generic(nm, gen_args) } else { TypeExpr.Named(nm) }
    if is_opt { base = TypeExpr.Optional(base) }
    CapVal.TExpr(base)
}

/// A package-qualified type atom. Punctuation is structural in the grammar, so
/// rebuild the canonical `@pkg::mod::Type` spelling from captured segments,
/// then apply the same generic/optional wrappers as a bare named type.
export fn mk_qualified_type(segments: List<Token>, has_gen: bool, gen_args: List<TypeExpr>, is_opt: bool) -> CapVal {
    mut name = "@"
    mut i = 0
    for segment in segments {
        if i > 0 { name = name + "::" }
        name = name + segment.text
        i = i + 1
    }
    mk_named_type(name, has_gen, gen_args, is_opt)
}

/// A typed channel constructor. The element type is represented both inline on
/// Expr.ChannelNew and as the sole walker edge; capacity remains walker-opaque,
/// exactly matching the retired hand parser.
export fn mk_channel(st: PState, sp_start: int, elem_cv: CapVal, cap_cv: CapVal) -> CapVal {
    let elem = type_expr_to_vtype(capval_to_texpr(st, elem_cv))
    mut cap: ExprId? = null
    if capval_present(cap_cv) { cap = capval_to_expr(st, cap_cv) }
    let elem_id = st.store.ingest_type(elem, byte_span_none())
    CapVal.Node(st.store.add_expr(
        Expr.ChannelNew(elem, cap),
        byte_span(sp_start, st.cur().pos),
        [NodeRef.TypeRef(elem_id)]
    ))
}

/// A `{ statement* }` expression body. Its statement ids are the payload and
/// remain walker-opaque, exactly like the retired parse_block_expression path.
export fn mk_expr_block(st: PState, sp_start: int, stmts_cv: CapVal) -> CapVal {
    CapVal.Node(st.store.add_expr(
        Expr.Block(capval_to_stmt_list(stmts_cv)),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

/// Grammar-native `spawn { ... }`, preserving the hand parser's span and
/// walker-opaque body id.
/// Grammar-native `quote { … }` / `quote stmt|stmts|decl { … }` (t-bwjg).
///
/// Mirrors the hand `Parser.parse_quote` for the BLOCK-BODIED kinds only. The two
/// non-block kinds — `quote type { <type> }` (a TypeLit carrier) and `quote arm
/// { pat -> body }` (a synthetic single-armed MatchExpr envelope) — are declined by
/// `@peek(quote_type)` and `@peek(quote_arm)`, each routed to its own native rule, so
/// this build never sees either.
///
/// `kind_cv` is the OPTIONAL kind keyword; absent means the hand's default, `"expr"`
/// (parse_quote_kind's fallthrough). `Expr.Quote`'s body is an ExprId SCALAR and is
/// walker-opaque, so this allocs as a LEAF with no child refs — matching the hand's
/// `alloc_at`, which passes none either. Adding an edge here would give the walker a
/// child the hand never registered.
/// Grammar-native `quote type { <type> }` (t-bwjg slice 4b).
///
/// Mirrors hand `parse_quote` + `parse_quote_type_body` EXACTLY, and the two spans are
/// deliberately different: the inner `Expr.TypeLit` carrier spans from the `{` (the hand
/// takes `sp_start` at the brace, inside parse_quote_type_body), while the outer
/// `Expr.Quote` spans from the `quote` keyword. `lb_cv` is the captured `{` token, which
/// is the only way the build can recover that inner byte.
///
/// NOTE the deliberate difference from `mk_channel`, the other build that carries a
/// type: channel INGESTS its element (`ingest_type` + a `NodeRef.TypeRef` edge) because
/// its hand twin does. `parse_quote_type_body` does NOT — it is a plain `alloc_at` with
/// no refs — so ingesting here would add a type-table row and a walker edge the hand
/// never created, and the IR would diverge.
/// Grammar-native `quote arm { pat (if guard)? -> body ,? }` (t-bwjg slice 4b).
///
/// Mirrors hand `parse_quote_arm_body` exactly. The arm is wrapped in a SYNTHETIC
/// single-armed `Expr.MatchExpr` so the `Quote(kind, body)` shape stays uniform across
/// every kind; the lowering pass picks the arm back out via the `arm` discriminator.
///
/// THREE things here are byte-identity-critical and each has a hand line behind it:
///
/// 1. The synthetic subject is `intern_expr_leaf`, NOT `add_expr`. The hand uses
///    `alloc_leaf`, which IS `intern_expr_leaf` — an interned row, so repeated
///    `quote arm`s share one `Expr.None`. Using add_expr would mint a fresh row each
///    time and the arena would diverge.
/// 2. The edge set is EXACTLY `[PatRef(pat_id)]`. `MatchArm` is a MIXED walker node:
///    only the pattern is a walked child, while guard and body ride as walker-opaque
///    `ExprId` scalars, and the subject is opaque too. Adding any of them would hand the
///    walker a child set the hand never built — the same rule mk_match_expr documents.
/// 3. The inner MatchExpr spans from the `{` (the hand's sp_start is taken inside
///    parse_quote_arm_body), while the outer Quote spans from the `quote` keyword.
export fn mk_quote_arm(st: PState, sp_start: int, lb_cv: CapVal, pat_cv: CapVal, guard_cv: CapVal, body_cv: CapVal) -> CapVal {
    let pat_id = capval_to_pat(st, pat_cv)
    let guard = if capval_present(guard_cv) { capval_to_expr(st, guard_cv) } else { null }
    let arm = MatchArm {
        pattern: st.store.pats.get(pat_id),
        pattern_id: pat_id,
        guard_id: guard,
        body_id: capval_to_expr(st, body_cv)
    }
    let arms: List<MatchArm> = [arm]
    let subject_id = st.store.intern_expr_leaf(Expr.None)
    let edges: List<NodeRef> = [NodeRef.PatRef(pat_id)]
    let lb = capval_tok_pos(lb_cv)
    let inner = st.store.add_expr(
        Expr.MatchExpr(subject_id, arms),
        if lb < 0 { byte_span_none() } else { byte_span(lb, st.cur().pos) },
        edges
    )
    CapVal.Node(st.store.add_expr(
        Expr.Quote("arm", inner),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

export fn mk_quote_type(st: PState, sp_start: int, lb_cv: CapVal, t_cv: CapVal) -> CapVal {
    let vt = type_expr_to_vtype(capval_to_texpr(st, t_cv))
    let lb = capval_tok_pos(lb_cv)
    let body = st.store.add_expr(
        Expr.TypeLit(vt),
        if lb < 0 { byte_span_none() } else { byte_span(lb, st.cur().pos) },
        []
    )
    CapVal.Node(st.store.add_expr(
        Expr.Quote("type", body),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

export fn mk_quote(st: PState, sp_start: int, kind_cv: CapVal, body_cv: CapVal) -> CapVal {
    let kind = if capval_present(kind_cv) { capval_tok_text(kind_cv) } else { "expr" }
    CapVal.Node(st.store.add_expr(
        Expr.Quote(kind, capval_to_expr(st, body_cv)),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

export fn mk_spawn(st: PState, sp_start: int, body_cv: CapVal) -> CapVal {
    CapVal.Node(st.store.add_expr(
        Expr.Spawn(capval_to_expr(st, body_cv)),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

/// Grammar-native `isolated { ... }`, the process-isolation twin of spawn.
export fn mk_isolated(st: PState, sp_start: int, body_cv: CapVal) -> CapVal {
    CapVal.Node(st.store.add_expr(
        Expr.Isolated(capval_to_expr(st, body_cv)),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

/// One conditional arm of a subjectless `when` expression.
export fn mk_when_arm(st: PState, cond_cv: CapVal, body_cv: CapVal) -> CapVal {
    CapVal.WArm(WhenArm {
        cond_id: capval_to_expr(st, cond_cv),
        body_id: capval_to_expr(st, body_cv)
    })
}

/// The `_` / `else` arm of a subjectless `when` expression.
export fn mk_when_default(st: PState, body_cv: CapVal) -> CapVal {
    CapVal.WArm(WhenArm { cond_id: none, body_id: capval_to_expr(st, body_cv) })
}

/// Fold grammar-built when arms into the walker-opaque Expr.When leaf.
export fn mk_when(st: PState, sp_start: int, arms_cv: CapVal) -> CapVal {
    CapVal.Node(st.store.add_expr(
        Expr.When(capval_to_when_arm_list(arms_cv)),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

/// A repeated `when_arm` capture is WArms for many, WArm for one, Nil for none.
export fn capval_to_when_arm_list(v: CapVal) -> List<WhenArm> {
    match v {
        .WArms(xs) -> xs
        .WArm(a) -> [a]
        _ -> []
    }
}

/// Coerce one generated arm result for a repeated when-arm capture.
export fn capval_to_when_arm(st: PState, v: CapVal) -> WhenArm {
    match v {
        .WArm(a) -> a
        _ -> {
            st.report("expected a when arm")
            WhenArm { cond_id: none, body_id: st.error_node("expected a when arm") }
        }
    }
}

/// `parallel { … }` — the MkParallel build's core (t-47hc Phase 4). The
/// statement list is held as RAW ids under a LEAF Parallel row — the hand's
/// `alloc_stmt_leaf(Stmt.Parallel(body.ids))`, no Block wrapper.
export fn mk_parallel_g(st: PState, body: List<StmtId>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Parallel(body)))
}

/// One `binding <- channel -> { body }` select arm — the MkSelectArm build's
/// core. Mirrors parse_select_arm_list's row exactly: binding name text,
/// channel expr id, body stmt ids.
export fn mk_select_arm_g(st: PState, binding: string, ch_cv: CapVal, body: List<StmtId>) -> CapVal {
    CapVal.SArm(SelectArm { binding: binding, chan_id: capval_to_expr(st, ch_cv), body_ids: body })
}

/// Fold grammar-built select arms into the walker-opaque Stmt.Select LEAF —
/// the hand's `alloc_stmt_leaf(Stmt.Select(arms))`: SelectArm is not a
/// registered container struct, so the canonical ingest records no children
/// and the native alloc mirrors that.
export fn mk_select_g(st: PState, arms_cv: CapVal) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Select(capval_to_select_arm_list(arms_cv))))
}

/// A repeated `select_arm` capture is SArms for many, SArm for one, Nil for none
/// (`select { }` is VALID — zero arms).
export fn capval_to_select_arm_list(v: CapVal) -> List<SelectArm> {
    match v {
        .SArms(xs) -> xs
        .SArm(a) -> [a]
        _ -> []
    }
}

/// `spec "name" { items }` — the MkSpecBlock build's core (t-47hc Phase 4).
/// A LEAF SpecBlock row over the natively-parsed item ids, exactly the hand's
/// `alloc_stmt_leaf(Stmt.SpecBlock(name, body.ids))`.
export fn mk_spec_block_g(st: PState, name: string, body: List<StmtId>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.SpecBlock(name, body)))
}

/// `given "name" { items }` — the MkGivenBlock build's core, the SpecBlock
/// shape one level down.
export fn mk_given_block_g(st: PState, name: string, body: List<StmtId>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.GivenBlock(name, body)))
}

/// `then "name" { stmts }` — the MkThenBlock build's core. The body rows fold
/// into a walker-opaque Expr.Block cond LEAF (the hand's parse_then_block:
/// the rows ARE the structure), under a LEAF ThenBlock row.
export fn mk_then_block_g(st: PState, name: string, body: List<StmtId>) -> CapVal {
    let cond_id = st.store.exprs.add_leaf(Expr.Block(body))
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ThenBlock(name, cond_id)))
}

/// One `key: ty ( = default )?` config-schema entry — the MkCompConfig build's
/// core (t-47hc slice A). Mirrors parse_comp_config_schema's row exactly,
/// including the `glue_ingest_type` dual (ty_vt + ty_id, the F1a mid-migration
/// shape that hand comment documents).
export fn mk_comp_config_g(st: PState, key: string, ty_cv: CapVal, d_cv: CapVal, d_present: bool) -> CapVal {
    let vt = type_expr_to_vtype(capval_to_texpr(st, ty_cv))
    let default_id: ExprId? = if d_present { capval_to_expr(st, d_cv) } else { none }
    CapVal.CCfg(CompConfig { key: key, ty_vt: vt, default_id: default_id, ty_id: st.store.ingest_type(vt, byte_span_none()) })
}

/// One `slot: ty` children-schema entry — the MkChildrenSlot build's core.
export fn mk_children_slot_g(st: PState, slot: string, ty_cv: CapVal) -> CapVal {
    CapVal.CSlot(ChildrenSlot { slot_name: slot, child_ty: type_expr_to_vtype(capval_to_texpr(st, ty_cv)) })
}

/// The component-body `let field: ty ( = init )?` row — the MkCompField build's
/// core. NOT the general binding: the annotation is REQUIRED (the grammar rule
/// enforces it) and the row is the hand's `alloc_binding_stmt` (TypeRef edge),
/// with an Expr.None initializer when none was written.
export fn mk_comp_field_g(st: PState, name: string, ty_cv: CapVal, init_cv: CapVal, init_present: bool) -> CapVal {
    let vt = type_expr_to_vtype(capval_to_texpr(st, ty_cv))
    let init_id = if init_present { capval_to_expr(st, init_cv) } else { st.store.exprs.add_leaf(Expr.None) }
    CapVal.SNode(binding_stmt_row(st, Stmt.Let(name, vt, init_id), vt))
}

/// `component name [implements …] { config? children? body:TokenStream? … }` —
/// the MkComponentDef build's core (modern form only; slice A). Validates the
/// `body:` marker (only `TokenStream` is legal — anything else reports, and the
/// enclosing @try hands the input back to the hand's coded diagnostic), then
/// synthesizes the marker's Let row AHEAD of the body rows, enforces the
/// children-vs-raw-body exclusion, REGISTERS the name for keyword-free
/// instantiation exactly as the hand's register_component_def does (raw-body
/// defs route instances to the RAW token capture), and allocs the LEAF
/// ComponentDef row. Registration reaches the registry through the hand
/// delegate; a delegate-less PState (pure-executor harness) skips it, which no
/// current harness exercises — both PRODUCTION paths always carry the delegate.
export fn mk_component_def_g(st: PState, name: string, implements: List<string>, cfg_cv: CapVal, cs_cv: CapVal, marker: string, marker_present: bool, body: List<StmtId>) -> CapVal {
    if marker_present && marker != "TokenStream" {
        st.report("`body:` in a component declares a raw token body — the only valid type is `TokenStream`")
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error))
    }
    mut all_ids: List<StmtId> = []
    if marker_present {
        let vt = vtype_struct("TokenStream", 0)
        all_ids.push(binding_stmt_row(st, Stmt.Let("body", vt, st.store.exprs.add_leaf(Expr.None)), vt))
    }
    for id in body { all_ids.push(id) }
    let children = capval_to_children_slot_list(cs_cv)
    if children.length > 0 && body_declares_token_stream(st.store, all_ids) {
        st.report("component `${name}` declares both `children { … }` and `body: TokenStream` — a raw token body has no structured children; pick one")
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error))
    }
    if st.hand_delegate != null {
        let p = st.hand_delegate!
        if body_declares_token_stream(st.store, all_ids) {
            register_component_name(p.features, name, (q: Parser) -> q.parse_component_block_raw())
            register_raw_body_component(p.features, name)
        } else {
            register_component_name(p.features, name, (q: Parser) -> q.parse_component_block_bare())
        }
    }
    let empty_p: List<ParamEntry> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ComponentDef(name, empty_p, capval_to_comp_config_list(cfg_cv), children, implements, all_ids)))
}

/// One `key value` / `key = expr` INSTANTIATION config pair — the
/// MkCompConfigPair build's core (t-47hc.5.1 slice B). CompConfigPair carries
/// the value as a boxed `Expr` rather than an ExprId, so the captured node is
/// read back out of the store, exactly as the hand's parse_expression_boxed
/// does. Which of the two surface forms produced it is already decided by the
/// `@peek` gate on the branch, so there is nothing to disambiguate here.
export fn mk_comp_config_pair_g(st: PState, key: string, value_id: ExprId) -> CapVal {
    CapVal.CPair(CompConfigPair { key: key, value: st.store.exprs.get(value_id) })
}

/// The `component C inst { pairs… body… }` INSTANTIATION — the
/// MkComponentBlock build's core (t-47hc.5.1 slice B). A LEAF row, matching
/// the hand's alloc_stmt_leaf: Stmt.ComponentBlock is walker-opaque, so the
/// body ids deliberately do not become arena edges (the same disposition
/// mk_component_def_g gives ComponentDef).
///
/// RAW-BODY instances have their own core below — the decision between them is
/// registry state rather than tokens, so it is made in the `comp_nested_raw_*`
/// conds (which read the same registry the hand's arm does) rather than here.
export fn mk_component_block_g(st: PState, name: string, instance: string, pairs: List<CompConfigPair>, body: List<StmtId>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ComponentBlock(name, instance, pairs, body)))
}

/// A NESTED instance of a `body: TokenStream` component — the grammar twin of the
/// hand's `parse_raw_block_after_brace`. The verbatim slice arrives already scanned
/// by `@rawbrace` (which IS the hand's `capture_balanced_brace_body`), so the only
/// work left is the hand's exact two-row shape: a `TokenBody` leaf wrapped in a
/// config-pair-less `ComponentBlock`.
export fn mk_raw_component_block_g(st: PState, name: string, instance: string, raw: string) -> CapVal {
    let empty_cfg: List<CompConfigPair> = []
    let body_ids: List<StmtId> = [st.store.stmts.add_leaf(Stmt.TokenBody(raw))]
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ComponentBlock(name, instance, empty_cfg, body_ids)))
}

/// `name() { … }` inside a component-instance body — the METHOD SHORTHAND (spec
/// §4.1), parsed as a NULLARY `Function` that the `@expand` macro later rewrites
/// into a real signature (expand_command turns `run() { … }` into
/// `fn run(self, args: CliResult) -> int { … }`). The `Int` return and the
/// `fn_decl_edges` allocation are the hand's, verbatim: an `add_leaf` here would
/// drop the return-type edge and silently change what the walker traverses.
export fn mk_method_shorthand_g(st: PState, name: string, body: List<StmtId>) -> CapVal {
    let empty_tp: List<TypeParamEntry> = []
    let empty_p: List<ParamEntry> = []
    let ret = ValueType.Int
    CapVal.SNode(st.store.stmts.add(Stmt.Function(name, empty_tp, empty_p, ret, body), fn_decl_edges(st, ret), byte_span_none()))
}

/// A repeated `config_pair` capture is CPairs for many, CPair for one, Nil for
/// none — the CompConfigPair twin of capval_to_comp_config_list.
export fn capval_to_comp_config_pair_list(v: CapVal) -> List<CompConfigPair> {
    match v {
        .CPairs(xs) -> xs
        .CPair(p) -> [p]
        _ -> []
    }
}

/// A repeated bare-IDENT capture as its lexeme list (the implements clause).
export fn capval_tok_texts(v: CapVal) -> List<string> {
    mut out: List<string> = []
    for t in capval_tok_list(v) { out.push(t.text) }
    out
}

/// A repeated `config_entry` capture is CCfgs for many, CCfg for one, Nil for none.
export fn capval_to_comp_config_list(v: CapVal) -> List<CompConfig> {
    match v {
        .CCfgs(xs) -> xs
        .CCfg(c) -> [c]
        _ -> []
    }
}

/// A repeated `children_slot` capture is CSlots for many, CSlot for one, Nil for none.
export fn capval_to_children_slot_list(v: CapVal) -> List<ChildrenSlot> {
    match v {
        .CSlots(xs) -> xs
        .CSlot(c) -> [c]
        _ -> []
    }
}

/// Coerce one generated entry for a repeated config-entry capture.
/// One INSTANTIATION config pair out of a capture — the scalar twin of
/// capval_to_comp_config, used by the emitted parser's repeat accumulator.
export fn capval_to_comp_config_pair(st: PState, v: CapVal) -> CompConfigPair {
    match v {
        .CPair(p) -> p
        _ -> {
            st.report("expected a component config pair")
            CompConfigPair { key: "", value: Expr.Missing }
        }
    }
}

export fn capval_to_comp_config(st: PState, v: CapVal) -> CompConfig {
    match v {
        .CCfg(c) -> c
        _ -> {
            st.report("expected a config entry")
            CompConfig { key: "", ty_vt: ValueType.Unknown, default_id: none, ty_id: st.store.ingest_type(ValueType.Unknown, byte_span_none()) }
        }
    }
}

/// Coerce one generated entry for a repeated children-slot capture.
export fn capval_to_children_slot(st: PState, v: CapVal) -> ChildrenSlot {
    match v {
        .CSlot(c) -> c
        _ -> {
            st.report("expected a children slot")
            ChildrenSlot { slot_name: "", child_ty: ValueType.Unknown }
        }
    }
}

/// Coerce one generated arm result for a repeated select-arm capture.
export fn capval_to_select_arm(st: PState, v: CapVal) -> SelectArm {
    match v {
        .SArm(a) -> a
        _ -> {
            st.report("expected a select arm")
            SelectArm { binding: "", chan_id: st.error_node("expected a select arm"), body_ids: [] }
        }
    }
}

/// A `dyn Trait` type — the TyDyn build's core. Matches the hand parser
/// (parse_type_atom's `dyn` branch, mod.av): `dyn Trait` → TypeExpr.Named(trait) (the
/// hand parser drops the dyn-ness to a bare Named — there is no distinct dyn
/// TypeExpr variant), and the NULLABLE `dyn Trait?` → TypeExpr.Optional(Named). The
/// `?` suffix is what the earlier `-> TyDyn(t)` build dropped (nullable dyn parsed as
/// non-nullable, leaving `?` for the caller); threading `is_opt` restores parity.
export fn mk_dyn_type(nm: string, is_opt: bool) -> CapVal {
    mut base = TypeExpr.Named(nm)
    if is_opt { base = TypeExpr.Optional(base) }
    CapVal.TExpr(base)
}

/// A parenthesised type — the `TyParen` build's core. Exactly one element is a
/// grouping (the type itself); zero or ≥2 are a tuple `Generic("__tuple", …)`,
/// matching parse_type_atom's paren branch.
export fn mk_paren_type(tes: List<TypeExpr>) -> CapVal {
    if tes.length == 1 { return CapVal.TExpr(tes[0]) }
    CapVal.TExpr(TypeExpr.Generic("__tuple", tes))
}

/// A `fn` type — the `MkFn` build's core. A bare `fn` (neither param parens
/// nor an arrow) is the under-determined `Named("fn")`; any `(`/`->` makes it a
/// `FnType` (params default [], ret defaults `Infer`). Mirrors parse_type_atom's
/// `fn` branch.
export fn mk_fn_type(st: PState, has_params: bool, params: List<TypeExpr>, has_ret: bool, ret_cv: CapVal) -> CapVal {
    if !has_params && !has_ret { return CapVal.TExpr(TypeExpr.Named("fn")) }
    let ret = if has_ret { capval_to_texpr(st, ret_cv) } else { TypeExpr.Infer }
    CapVal.TExpr(TypeExpr.FnType(params, ret))
}

// ── Declaration coercions + shared constructor cores (ps3t.6.5.7, ps3t.6.5.11)
//    The generated static whole-program parser accumulates rep captures per
//    element (capval_to_pentry / _field / _variant), then hands the built lists
//    to the SAME constructor helpers apply_build calls — so the generated
//    parser and the executor build byte-identical declaration trees. ──

/// A capture as one fn parameter — the per-element twin of capval_to_pentry_list.
export fn capval_to_pentry(st: PState, v: CapVal) -> ParamEntry {
    match v {
        .PEntry(p) -> p
        _ -> {
            st.report("expected a parameter")
            ParamEntry { name: "", vtype: ValueType.Unknown }
        }
    }
}

/// A capture as ONE annotation — the scalar coercion the EMITTED parser's
/// `( an:annot )*` accumulator applies per iteration (kind_coerce("ann")), the
/// Annotation twin of capval_to_pentry above.
export fn capval_to_ann(st: PState, v: CapVal) -> Annotation {
    match v {
        .Ann(a) -> a
        _ -> {
            st.report("expected an annotation")
            Annotation { name: "", arg_ids: [] }
        }
    }
}

/// A capture as one struct/variant field — the per-element twin of
/// capval_to_field_list.
export fn capval_to_field(st: PState, v: CapVal) -> FieldEntry {
    match v {
        .Field(f) -> f
        _ -> {
            st.report("expected a field")
            FieldEntry { name: "", resolved: ValueType.Unknown }
        }
    }
}

/// A capture as one enum variant — the per-element twin of capval_to_var_list.
export fn capval_to_variant(st: PState, v: CapVal) -> Variant {
    match v {
        .Var(vv) -> vv
        _ -> {
            st.report("expected a variant")
            Variant { name: "", fields: [] }
        }
    }
}

/// `{ stmt* }` → a brace block (the `Block` build's core).
/// Stamp a built statement into the store WITH its source position — the grammar
/// twin of parse_statement_list_ids' record_pos (parse/mod.av). `sp_start` is the
/// statement rule's entry byte: the GENERATED static parser threads the real byte
/// (so its per-statement positions match the hand parser), the INTERPRETER passes
/// `0 - 1` (span-free — it is the differential oracle and records no positions,
/// exactly like the expr fold builds). to_linecol maps the byte to (line, col) via
/// the store's LineIndex; record_pos itself no-ops on a non-positive line, so a
/// `-1` start is a clean skip. (t-47hc.12 — the SrcPos side-table capability.)
fn add_stmt_at(st: PState, s: Stmt, sp_start: int) -> CapVal {
    let id = st.store.stmts.add_leaf(s)
    if sp_start >= 0 {
        let lc = st.store.lines.to_linecol(sp_start)
        st.store.stmts.record_pos(id, SrcPos { line: lc.line, col: lc.col, file: st.file })
    }
    CapVal.SNode(id)
}

export fn mk_block(st: PState, sp_start: int, body: List<StmtId>) -> CapVal {
    add_stmt_at(st, Stmt.Block(body), sp_start)
}

/// `while cond body` (the `While` build's core).
export fn mk_while(st: PState, sp_start: int, cond: CapVal, body: CapVal) -> CapVal {
    add_stmt_at(st, Stmt.While(capval_to_expr(st, cond), capval_to_stmt(st, body)), sp_start)
}

/// `if cond then ( "else" else )?` (the `If` build's core). An absent else is a
/// null else_branch; a present else (a block or a nested if for `else if`) is an
/// SNode.
export fn mk_if(st: PState, sp_start: int, cond: CapVal, then_cv: CapVal, else_cv: CapVal) -> CapVal {
    let c = capval_to_expr(st, cond)
    let then_s = capval_to_stmt(st, then_cv)
    mut else_opt: StmtId? = none
    match else_cv {
        .SNode(eid) -> else_opt = eid
        _ -> {}
    }
    add_stmt_at(st, Stmt.If(c, then_s, else_opt), sp_start)
}

/// `for v in lo ( ".." hi )? body` (the `ForLoop` build's core). A present `..`
/// picks the integer-range `For`, absent the collection `ForIn`.
export fn mk_for_loop(st: PState, sp_start: int, var_cv: CapVal, lo_cv: CapVal, hi_cv: CapVal, body_cv: CapVal) -> CapVal {
    let var = capval_tok_text(var_cv)
    let lo = capval_to_expr(st, lo_cv)
    let body = capval_to_stmt(st, body_cv)
    match hi_cv {
        .Nil -> add_stmt_at(st, Stmt.ForIn(var, lo, body), sp_start)
        _ -> {
            let hi = capval_to_expr(st, hi_cv)
            add_stmt_at(st, Stmt.For(var, lo, hi, body), sp_start)
        }
    }
}

/// Capture a tuple-destructure loop binding before parsing its collection/body.
/// The hand parser reserves the gensym immediately after `for (`; doing that in
/// this sub-rule preserves allocation order for nested destructure loops. The
/// synthetic first token carries both the temp name and the opening-paren byte;
/// the remaining tokens are the user binding names.
export fn mk_for_binding(lp_cv: CapVal, names_cv: CapVal) -> CapVal {
    let lp = match lp_cv {
        .Tok(t) -> t
        _ -> Token { kind: "PUNCT", text: "(", pos: 0, tk: Tk.LeftParen }
    }
    mut packed: List<Token> = [Token {
        kind: "IDENT",
        text: "__forpair_${avra_gensym()}",
        pos: lp.pos,
        tk: Tk.Identifier,
    }]
    for name in capval_tok_list(names_cv) { packed.push(name) }
    CapVal.Toks(packed)
}

/// Finish `for (a, b, …) in collection { body }` using the hand parser's exact
/// desugaring and node-allocation order. `binding_cv` was created before parsing
/// the collection/body, so its temp name has the same process-wide gensym order.
export fn mk_for_destructure(st: PState, sp_start: int, binding_cv: CapVal, coll_cv: CapVal, body_cv: CapVal) -> CapVal {
    let packed = capval_tok_list(binding_cv)
    if packed.length == 0 {
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error))
    }
    let tmp_tok = packed[0]
    mut names: List<Token> = []
    mut i = 1
    while i < packed.length {
        names.push(packed[i])
        i = i + 1
    }
    let tmp_ident_id = st.store.exprs.add_leaf(Expr.Ident(tmp_tok.text))
    let entries = param_entries_from_toks(CapVal.Toks(names), ValueType.Unknown)
    let unpack_id = st.store.stmts.add_leaf(Stmt.LetDestructure(entries, tmp_ident_id))
    let lc = st.store.lines.to_linecol(tmp_tok.pos)
    st.store.stmts.record_pos(unpack_id, SrcPos { line: lc.line, col: lc.col, file: st.file })
    let body_id = capval_to_stmt(st, body_cv)
    let block_id = st.store.stmts.add_leaf(Stmt.Block([unpack_id, body_id]))
    add_stmt_at(st, Stmt.ForIn(tmp_tok.text, capval_to_expr(st, coll_cv), block_id), sp_start)
}

/// `return ^( value )?` (the `MkReturn` build's core). An ABSENT same-line value
/// (`val_cv == Nil`) is a bare `Stmt.ReturnEmpty`; a PRESENT value is
/// `Stmt.Return(value)`. The `^`-gated optional (same-line) + its FIRST guard
/// (which rejects `}` / Eof — not expression starts) together reproduce the hand
/// parser's `current_kind in [RightBrace, Eof] || current_line != prev_line` test.
/// Uses a fresh `add_leaf` (no interning, no sp_start) to match the hand's
/// `alloc_stmt_leaf`. The SHARED core so apply_build (interpreter) and the
/// generated static parser build byte-identical trees.
/// `-> return v` / `-> return` as a match ARM body (the `MkArmReturn` build's core).
///
/// `MatchArm.body_id` is an ExprId and `return` is a STATEMENT, so the hand bridges the
/// two by wrapping it: `Expr.Block([Stmt.Return(v)])`. Its comment calls the wrap
/// "stmt-bearing, so it bridges at its boundary" — reproduced here rather than invented,
/// because the arm body has nowhere else to put a statement.
///
/// The bare form is `Stmt.ReturnEmpty`, and WHICH form applies is newline-sensitive: the
/// hand takes the empty branch when the next token is `}`, `,` or EOF, or sits on a LATER
/// LINE. Without that, an arm folds the NEXT arm's pattern into its return value. The
/// grammar spells the same rule as `^( e:expression )?` — the same-line marker
/// `return_stmt` already uses — so the two engines decide it identically.
///
/// The synthesized row is stamped at the `return` KEYWORD (sp_start), not at the cursor
/// after parsing the value: a post-advance stamp points a field-access null-trap at the
/// delimiter or the next token instead of the `return` (the hand records the same
/// caveat, having hit it).
export fn mk_arm_return(st: PState, sp_start: int, val_cv: CapVal) -> CapVal {
    let ret_id = if capval_present(val_cv) {
        st.store.stmts.add_leaf(Stmt.Return(capval_to_expr(st, val_cv)))
    } else {
        st.store.stmts.add_leaf(Stmt.ReturnEmpty)
    }
    if sp_start >= 0 {
        let lc = st.store.lines.to_linecol(sp_start)
        st.store.stmts.record_pos(ret_id, SrcPos { line: lc.line, col: lc.col, file: st.file })
    }
    let body: List<StmtId> = [ret_id]
    CapVal.Node(st.store.exprs.add_leaf(Expr.Block(body)))
}

export fn mk_return_opt(st: PState, val_cv: CapVal) -> CapVal {
    if capval_present(val_cv) {
        CapVal.SNode(st.store.stmts.add_leaf(Stmt.Return(capval_to_expr(st, val_cv))))
    } else {
        CapVal.SNode(st.store.stmts.add_leaf(Stmt.ReturnEmpty))
    }
}

/// `fn name ( params? ) ( "->" ret )? { body }` (the `MkFnDecl` build's core,
/// non-generic slice). Absent return type defaults to Void.
export fn mk_fn_decl(st: PState, name: string, params: List<ParamEntry>, ret_cv: CapVal, has_ret: bool, body: List<StmtId>) -> CapVal {
    let ret_vt = if has_ret { type_expr_to_vtype(capval_to_texpr(st, ret_cv)) } else { ValueType.Void }
    let no_tp: List<TypeParamEntry> = []
    CapVal.SNode(st.store.stmts.add(Stmt.Function(name, no_tp, params, ret_vt, body), fn_decl_edges(st, ret_vt), byte_span_none()))
}

/// A `Stmt.Function`'s walker edge set: EXACTLY one `TypeRef` for the bare return-type
/// field. Body rows are id payloads and contribute no edges — the hand's
/// `fn_decl/parser.av` says so verbatim ("the bare return-type field contributes a
/// TypeRef (body rows are id payloads — no edges)"), and this must match it or the two
/// parsers disagree about the tree's shape.
///
/// The native builders used `add_leaf`, which records ZERO edges, so every routed fn was
/// stored as a LEAF: `children_of()` came back empty and the L1 non-leaf side-table
/// counted 0 where the hand counted 3 (`nonleaf=0` vs `nonleaf=3`,
/// core/tests/side_table_test.av). `dense=` matched throughout, which is the tell that
/// the STATEMENTS were all present and only their edges were missing.
///
/// Void counts: a fn with no declared return still ingests a row for `Void` and carries
/// its TypeRef, exactly as the hand does, so `fn c() { return }` is non-leaf too.
fn fn_decl_edges(st: PState, ret_vt: ValueType) -> NodeEdges {
    NodeEdges { refs: [NodeRef.TypeRef(st.store.ingest_type(ret_vt, byte_span_none()))] }
}

/// `type Name = { field* }` (the `MkTypeDecl` build's core, non-generic slice).
export fn mk_type_decl(st: PState, name: string, fields: List<FieldEntry>) -> CapVal {
    let no_tp: List<TypeParamEntry> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.TypeDecl(name, no_tp, fields)))
}

/// `enum Name { variant* }` (the `MkEnumDecl` build's core, non-generic slice).
export fn mk_enum_decl(st: PState, name: string, vars: List<Variant>) -> CapVal {
    let no_tp: List<TypeParamEntry> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.EnumDecl(name, no_tp, vars)))
}

/// The GENERIC siblings of the three decl cores above. Each is the same node with a
/// real type-param list instead of the empty one — extracted so the executor and the
/// EMITTED parser call ONE constructor rather than the executor building the node
/// inline (which it did, arity-guarded) and emit having no twin at all. That asymmetry
/// is why the generic arms were executor-only dormant capability: emit dispatches on
/// build NAME, so a 3-arg `MkEnumDecl` in a grammar would have rendered the 2-arg call
/// and passed the type-param list where the variants go. Cores + arity-guarded emit
/// arms close it in lockstep (t-47hc slice 10, ticket t-myz7).
export fn mk_fn_decl_g(st: PState, name: string, tps: List<TypeParamEntry>, params: List<ParamEntry>, ret_cv: CapVal, has_ret: bool, body: List<StmtId>) -> CapVal {
    let ret_vt = if has_ret { type_expr_to_vtype(capval_to_texpr(st, ret_cv)) } else { ValueType.Void }
    // Same edge set as the non-generic core — the type-param list is a payload, not an edge.
    CapVal.SNode(st.store.stmts.add(Stmt.Function(name, tps, params, ret_vt, body), fn_decl_edges(st, ret_vt), byte_span_none()))
}

/// `type Name < tparam* > = { field* }` (the 3-arg `MkTypeDecl` build's core).
export fn mk_type_decl_g(st: PState, name: string, tps: List<TypeParamEntry>, fields: List<FieldEntry>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.TypeDecl(name, tps, fields)))
}

/// `enum Name < tparam* > { variant* }` (the 3-arg `MkEnumDecl` build's core).
export fn mk_enum_decl_g(st: PState, name: string, tps: List<TypeParamEntry>, vars: List<Variant>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.EnumDecl(name, tps, vars)))
}

/// `name ( ":" bound )?` — ONE generic type parameter (the `MkTypeParam` build's core).
/// A single trait bound only, matching parse_type_param_entries; absent => "" (unbounded).
/// Multi-bound `T: A + B` is a where-clause and out of scope.
export fn mk_type_param(name: string, bound_cv: CapVal, has_bound: bool) -> CapVal {
    let bound = if has_bound { capval_tok_text(bound_cv) } else { "" }
    CapVal.TParam(TypeParamEntry { name: name, bounds: bound })
}

/// The WHOLE `type Name < tp > = …` declaration — every form the hand's
/// `parse_type_declaration` produces, in one core, because the hand itself decides
/// between them AFTER parsing the right-hand side and a grammar cannot branch on a
/// parse RESULT.
///
/// Four outcomes, in the hand's own order:
///   `= { field* }`               Stmt.TypeDecl        (fields captured, no alias)
///   `= A | B`                    Stmt.UnionAliasDecl  (the TypeExpr came back .Union)
///   `= Base without { f, g }`    Stmt.TypeDecl with a SYNTHETIC field list
///   `= OtherType`                Stmt.NewtypeDecl     (the nominal wrapper)
///
/// The grammar reaches this with the brace form and the alias form as two OPTIONAL
/// groups rather than two alternation branches: they are FIRST-disjoint after the `=`
/// (`{` versus IDENT / `fn` / `[`), so exactly one fires, and left-factoring a shared
/// `"type" name ( "<" tp ">" )? "="` prefix — which the DSL cannot do without a new
/// CapVal to carry a partial declaration — is avoided entirely.
///
/// The `without` / `only` shape is CODEGEN-COUPLED: codegen/setup.av's
/// `resolve_type_operator` walks exactly `__base`, then `__without` / `__only`, then the
/// user's field names. The marker is `"__" + op`, never `__op`.
///
/// Both alias outcomes carry a `NodeRef.TypeRef` over an INGESTED type, matching the
/// hand's `alloc_stmt(..., [NodeRef.TypeRef(self.glue_ingest_type(vt))])` — a leaf node
/// here would drop the walker's only child.
export fn mk_type_decl_any(st: PState, name: string, tps: List<TypeParamEntry>, fields: List<FieldEntry>, alias_cv: CapVal, has_alias: bool, op_cv: CapVal, has_op: bool, opf: List<Token>) -> CapVal {
    if !has_alias {
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.TypeDecl(name, tps, fields)))
    }
    let te = capval_to_texpr(st, alias_cv)
    let vt = type_expr_to_vtype(te)
    if has_op {
        // `type X = Base without { a, b }` — the synthetic FieldEntry list codegen reads.
        mut derived: List<FieldEntry> = []
        derived.push(FieldEntry { name: "__base", resolved: vt })
        derived.push(FieldEntry { name: "__" + capval_tok_text(op_cv), resolved: ValueType.Str })
        for t in opf { derived.push(FieldEntry { name: t.text, resolved: ValueType.Unknown }) }
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.TypeDecl(name, tps, derived)))
    }
    let ty_id = st.store.ingest_type(vt, byte_span_none())
    match te {
        .Union(_, _) -> CapVal.SNode(st.store.stmts.add(Stmt.UnionAliasDecl(name, vt), NodeEdges { refs: [NodeRef.TypeRef(ty_id)] }, byte_span_none()))
        _ -> CapVal.SNode(st.store.stmts.add(Stmt.NewtypeDecl(name, vt), NodeEdges { refs: [NodeRef.TypeRef(ty_id)] }, byte_span_none()))
    }
}

/// `extern fn name ( params? ) ( "->" ret )?` — a bodyless FFI signature
/// (the `MkExtern` build's core). An absent return type defaults to Void, matching
/// `parse_extern_declaration`.
///
/// Extracted for the same reason the generic decl cores were (slice 10.2): the executor
/// had this build inline and emit had NO twin at all, so a grammar naming `MkExtern`
/// worked in the interpreter — which is why decl_export_extern_test passes — and would
/// have produced nothing usable in the generated parser. One core, both engines.
export fn mk_extern_fn(st: PState, name: string, params: List<ParamEntry>, ret_cv: CapVal, has_ret: bool) -> CapVal {
    let ret_vt = if has_ret { type_expr_to_vtype(capval_to_texpr(st, ret_cv)) } else { ValueType.Void }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ExternFn(name, params, ret_vt)))
}

/// `shape Name = { field* }` (the `MkShapeDecl` build's core) — the STRUCTURAL sibling
/// of `type`. Its own node (`Stmt.ShapeDecl`) and its own keyword, so it is a separate
/// rule rather than a widening of `type_decl`: `shape` is in `decl_lead`'s FIRST but no
/// fragment covered it, which is why it went unnoticed until the `type` measurement in
/// slice 10.4 turned it up.
///
/// No type params — `parse_shape_declaration` has none, unlike every other decl keyword.
export fn mk_shape_decl(st: PState, name: string, fields: List<FieldEntry>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ShapeDecl(name, fields)))
}

/// `export <decl>` — the inner exportable declaration wrapped in a bare `@export`
/// annotation (empty args) so name resolution can enforce visibility (the `MkExport`
/// build's core).
///
/// Extracted for the third time in this slice for the same reason: `MkExport` existed in
/// the EXECUTOR only, and emit dispatches on the build NAME, so a grammar naming it would
/// have worked under the interpreter oracle and emitted nothing usable. It is what the
/// `export`-WRAPPING increment spends, so the core lands before the flip does — the
/// dormant-capability shape the roadmap uses everywhere else.
///
/// The hand ALSO stamps the wrapped declaration's own source position
/// (`store.stmts.record_pos(inner_id, …)`, captured after consuming `export`). That is a
/// side-table write on a node the builder receives already-built, so it does not belong
/// here — `mk_stamp_stmt_at` does it, driven by the inner rule's own entry byte. See its
/// WHY for what happens when it is skipped.
export fn mk_export_decl(st: PState, inner: CapVal) -> CapVal {
    let no_args: List<ExprId> = []
    let exp: List<Annotation> = [Annotation { name: "export", arg_ids: no_args }]
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Annotated(exp, capval_to_stmt(st, inner))))
}

/// `let` / `mut` / `const` bindings go native (t-47hc Phase 4) — the shared core of
/// the `MkLetBinding` / `MkMutBinding` builds. A plain binding builds the hand's
/// `alloc_binding_stmt` row (`binding_stmt_row` below — NOT the edge-free `add_leaf`
/// the §2 oracle-era `MkLet` uses); the guard form (`let v = x else { … }`) delegates
/// every desugar row to `build_let_else_init` (core/arena.av), the SAME core the
/// hand's `build_let_else` calls, so the two engines cannot drift in what they lower
/// to.
///
/// The divergence REPORT is deliberately message-only, carrying no DiagCode: under
/// `@try` ANY report rolls the branch back, so the hand re-parses the item and owns
/// the coded `LetElseMustDiverge` diagnostic byte-for-byte (the t-47hc.31
/// no-code-channel discipline — the native rule never needs a diagnostics channel of
/// its own).
///
/// `tmp_cv` is the `@gensym(letelse)` mint, already performed AFTER the
/// else-statement parse (its position in the rule's sequence), which is exactly where
/// the hand mints (`build_let_else` parses the else, checks divergence, THEN calls
/// `fresh`). Reading it here as an ordinary captured token keeps the hygiene
/// sequences aligned across all engines.
export fn mk_let_binding_g(st: PState, has_mut: bool, name: string, ty_cv: CapVal, has_ty: bool, init_cv: CapVal, else_cv: CapVal, has_else: bool, tmp_cv: CapVal) -> CapVal {
    mut ty_vt = ValueType.Unknown
    if has_ty { ty_vt = type_expr_to_vtype(capval_to_texpr(st, ty_cv)) }
    mut init_id = capval_to_expr(st, init_cv)
    if has_else {
        // The else-arm body rows: a parsed else-Block's rows are reused verbatim
        // (never re-walked); any other stmt shape wraps as the block's single
        // element — exactly the hand's readback.
        let else_sid = capval_to_stmt(st, else_cv)
        let else_ids: List<StmtId> = match st.store.stmts.get(else_sid) {
            .Block(b) -> b
            _ -> [else_sid]
        }
        if !stmt_ids_diverge(st.store, else_ids) {
            st.report("the `else` of a `let … else` must diverge")
        }
        init_id = build_let_else_init(st.store, capval_tok_text(tmp_cv), init_id, else_ids)
    }
    let node = if has_mut { Stmt.Mut(name, ty_vt, init_id) } else { Stmt.Let(name, ty_vt, init_id) }
    CapVal.SNode(binding_stmt_row(st, node, ty_vt))
}

/// `const NAME (":" T)? "=" init` — the same row shape, no guard form (the hand's
/// `parse_const_statement` has no else branch).
export fn mk_const_binding_g(st: PState, name: string, ty_cv: CapVal, has_ty: bool, init_cv: CapVal) -> CapVal {
    mut ty_vt = ValueType.Unknown
    if has_ty { ty_vt = type_expr_to_vtype(capval_to_texpr(st, ty_cv)) }
    CapVal.SNode(binding_stmt_row(st, Stmt.Const(name, ty_vt, capval_to_expr(st, init_cv)), ty_vt))
}

/// The hand's `alloc_binding_stmt` row, verbatim: a byte_span_none stmt whose one
/// edge is the declared type's TypeRef (walker order — the initializer is an id
/// payload, so it records no edge; the payload IS the child mechanism).
fn binding_stmt_row(st: PState, node: Stmt, ty_vt: ValueType) -> StmtId {
    st.store.add_stmt(node, byte_span_none(), [NodeRef.TypeRef(st.store.ingest_type(ty_vt, byte_span_none()))])
}

/// `let (a, b, …) = init` — the destructure binding (t-47hc Phase 4), the shared
/// core of the `MkDestructure` build. The ident list becomes ParamEntry bindings
/// (names only, Unknown vtype — exactly parse_destructure_names' inferred-later
/// rows; an EMPTY list is valid, matching the hand's `let () = t`) under a LEAF
/// LetDestructure row — the hand's `alloc_stmt_leaf`, NOT `binding_stmt_row`:
/// destructure bindings cannot carry a type annotation, so no TypeRef edge exists.
export fn mk_let_destructure_g(st: PState, names: List<Token>, init_cv: CapVal) -> CapVal {
    let entries = param_entries_from_toks(CapVal.Toks(names), ValueType.Unknown)
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.LetDestructure(entries, capval_to_expr(st, init_cv))))
}

/// Stamp an ALREADY-BUILT statement with its own source position and return it
/// unchanged (the `MkStampAt` build's core). The identity build, plus one side-table
/// write.
///
/// WHY IT EXISTS. A prefix WRAPPER (`export <decl>`, and the doc / annotation wrappers
/// after it) yields a node whose recorded position is the wrapper's, while the hand
/// parser ALSO stamps the wrapped declaration itself — captured after consuming the
/// prefix, so it points at the inner keyword. Nothing else supplies that: the top-level
/// statement-list loop stamps only the outermost node it pushed, which for a wrapper is
/// the `Stmt.Annotated`.
///
/// SKIPPING IT IS NOT COSMETIC. `Ctx.source_line` is stamped from a node's recorded
/// SrcPos and RETAINS its previous value when a node has none, so an unstamped
/// declaration silently inherits whatever statement was emitted before it — and every
/// diagnostic position inside that declaration, including the `avra_null_deref_trap`
/// line baked into the IR, moves with it. Caught by diff-test as line numbers drifting
/// by 2, 3 and 41 across the selfhost compile; the arbitrary deltas are the tell that a
/// position is being inherited rather than shifted.
///
/// The position is the OWNING RULE's entry byte, so the rule that names this build must
/// begin exactly where the inner declaration does. The interpreter passes `0 - 1` and
/// records nothing, matching every other span-stamping build (`mk_block`, `mk_while`, …):
/// it is the differential oracle and carries no spans.
export fn mk_stamp_stmt_at(st: PState, sp_start: int, inner: CapVal) -> CapVal {
    let id = capval_to_stmt(st, inner)
    if sp_start >= 0 {
        let lc = st.store.lines.to_linecol(sp_start)
        st.store.stmts.record_pos(id, SrcPos { line: lc.line, col: lc.col, file: st.file })
    }
    CapVal.SNode(id)
}

/// One `@name ( "(" args ")" )?` annotation (the `MkAnn` build's core) — a name +
/// its built argument EXPRESSIONS, exactly parse_annotations' entry shape. Absent
/// args ⇒ empty arg_ids (a bare `@name`), so this subsumes the bare case too.
export fn mk_ann_g(name: string, arg_ids: List<ExprId>) -> CapVal {
    CapVal.Ann(Annotation { name: name, arg_ids: arg_ids })
}

/// `( "@" name args? )+ <decl>` — one or more annotations wrapping a declaration
/// (the `MkAnnotatedArgs` build's core) → Stmt.Annotated(annotations, inner),
/// exactly parse_declaration_hand's `@`-branch. The inner's own position is
/// `mk_stamp_stmt_at`'s job, driven by the inner rule's entry byte, exactly as
/// `mk_export_decl` splits it.
export fn mk_annotated_args_g(st: PState, anns: List<Annotation>, inner: CapVal) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Annotated(anns, capval_to_stmt(st, inner))))
}

/// `///`-doc lines wrapping a declaration (the `MkDocAnnotated` build's core):
/// consecutive DOC tokens join with `\n` into ONE `@doc("…")` annotation around the
/// inner declaration — exactly parse_declaration_hand's DocComment branch. The doc
/// STRING leaf must intern (`intern_expr_leaf`): the hand builds it with alloc_leaf,
/// and an add_leaf here would give a repeated doc text a second arena row —
/// byte-divergent ids downstream (the t-9bz3 literal-node lesson).
export fn mk_doc_annotated(st: PState, docs: List<Token>, inner: CapVal) -> CapVal {
    mut doc_text = ""
    mut i = 0
    for t in docs {
        if i > 0 { doc_text = doc_text + "\n" + t.text } else { doc_text = t.text }
        i = i + 1
    }
    let arg_id = st.store.intern_expr_leaf(Expr.String("\"${doc_text}\""))
    let anns: List<Annotation> = [Annotation { name: "doc", arg_ids: [arg_id] }]
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Annotated(anns, capval_to_stmt(st, inner))))
}

/// `//!` module-doc lines (the `MkModuleDoc` build's core): joined into ONE
/// `@module_doc("…")` annotation around a `Stmt.NoOp` — module docs wrap no
/// declaration (parse_declaration_hand's ModDocComment branch). The hand stamps the
/// NoOp at its CURRENT token after consuming the doc lines — i.e. whatever follows
/// them — so the emitted path records `st.cur().pos`; the interpreter passes
/// `sp_start < 0` and records nothing, the span-free-oracle convention of
/// `mk_stamp_stmt_at`.
export fn mk_module_doc(st: PState, sp_start: int, docs: List<Token>) -> CapVal {
    mut doc_text = ""
    mut i = 0
    for t in docs {
        if i > 0 { doc_text = doc_text + "\n" + t.text } else { doc_text = t.text }
        i = i + 1
    }
    let arg_id = st.store.intern_expr_leaf(Expr.String("\"${doc_text}\""))
    let anns: List<Annotation> = [Annotation { name: "module_doc", arg_ids: [arg_id] }]
    let noop_id = st.store.stmts.add_leaf(Stmt.NoOp)
    if sp_start >= 0 {
        let lc = st.store.lines.to_linecol(st.cur().pos)
        st.store.stmts.record_pos(noop_id, SrcPos { line: lc.line, col: lc.col, file: st.file })
    }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Annotated(anns, noop_id)))
}

/// `trait Name { member* }` (the `MkTraitDecl` build's core).
export fn mk_trait_decl(st: PState, name: string, members: List<StmtId>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.TraitDecl(name, members)))
}

/// `mod name` — a module STUB (the `MkModule` build's core); the resolver fills
/// the body from the `.av` file later.
export fn mk_module(st: PState, name: string) -> CapVal {
    let empty_body: List<StmtId> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Module(name, empty_body)))
}

/// `name : type` — a struct/variant field (the `MkField` build's core).
export fn mk_field(st: PState, name: string, ftype: CapVal) -> CapVal {
    CapVal.Field(FieldEntry { name: name, resolved: type_expr_to_vtype(capval_to_texpr(st, ftype)) })
}

/// `Name ( "(" field* ")" )?` — an enum variant (the `MkEVariant` build's core).
export fn mk_evariant(name: string, fields: List<FieldEntry>) -> CapVal {
    CapVal.Var(Variant { name: name, fields: fields })
}

/// `name ( ":" type )?` — a fn parameter (the `MkParam` build's core). An
/// UN-annotated param defaults to Int (parse_param_list's default, NOT Unknown).
export fn mk_param(st: PState, name: string, pt_cv: CapVal, has_pt: bool) -> CapVal {
    let pvt = if has_pt { type_expr_to_vtype(capval_to_texpr(st, pt_cv)) } else { ValueType.Int }
    // Type-carrying parameter positions maintain the F1d dual exactly like
    // Parser.param_entry_typed: even the default Int owns a real orphan type
    // row, while syntax-only ParamEntry producers explicitly leave ty_id null.
    let ty_id = st.store.ingest_type(pvt, byte_span_none())
    CapVal.PEntry(ParamEntry { name: name, vtype: pvt, ty_id: ty_id })
}

/// `type Name` — a trait associated-type member (the `MkAssocType` build's core).
export fn mk_assoc_type(st: PState, name: string) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.AssocType(name, ValueType.Unknown)))
}

/// `fn name ( params? ) ( "->" ret )? ( "{" body "}" )?` — a trait method member
/// (the `MkTraitMethod` build's core). A present brace body ⇒ default method
/// (Function, plain name); absent ⇒ signature-only ExternFn.
export fn mk_trait_method(st: PState, name: string, params: List<ParamEntry>, ret_cv: CapVal, has_ret: bool, has_body: bool, body: List<StmtId>) -> CapVal {
    let ret_vt = if has_ret { type_expr_to_vtype(capval_to_texpr(st, ret_cv)) } else { ValueType.Void }
    if has_body {
        let no_tp: List<TypeParamEntry> = []
        CapVal.SNode(st.store.stmts.add_leaf(Stmt.Function(name, no_tp, params, ret_vt, body)))
    } else {
        CapVal.SNode(st.store.stmts.add_leaf(Stmt.ExternFn(name, params, ret_vt)))
    }
}

/// `fn name ( params? ) ( "->" ret )? { body }` — one impl method, built with
/// its PLAIN name (the `MkMethod` build's core); MkImpl re-keys it to the
/// mangled `Type__method` where the impl target is in scope.
export fn mk_method(st: PState, name: string, params: List<ParamEntry>, ret_cv: CapVal, has_ret: bool, body: List<StmtId>) -> CapVal {
    let ret_vt = if has_ret { type_expr_to_vtype(capval_to_texpr(st, ret_cv)) } else { ValueType.Void }
    let no_tp: List<TypeParamEntry> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Function(name, no_tp, params, ret_vt, body)))
}

/// `impl Type { … }` / `impl Trait for Type { … }` — the `MkImpl` build's core.
/// The mangling TARGET is the `for` type when present, else the header type;
/// each plain-named method is re-keyed to `target__method` and its `self`
/// receiver retyped to the target — the two context-dependent steps.
export fn mk_impl(st: PState, header: string, for_cv: CapVal, has_for: bool, methods: List<StmtId>) -> CapVal {
    let target = if has_for { capval_tok_text(for_cv) } else { header }
    let impl_name = if has_for { "${header}:${target}" } else { header }
    mut mangled_ids: List<StmtId> = []
    for id in methods {
        match st.store.stmts.get(id) {
            .Function(nm, tp, ps, rv, bd) -> mangled_ids.push(st.store.stmts.add_leaf(Stmt.Function(method_mangled_name(target, nm), tp, retype_self_param(st, ps, target), rv, bd)))
            _ -> mangled_ids.push(id)
        }
    }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Impl(impl_name, mangled_ids)))
}

/// `use ( "@" )? seg ( "." seg )* { names }` — an import (the `MkUse` build's
/// core). The path is dot-joined (leading `@` for a package path); the names
/// reuse the bare-name ParamEntry list.
export fn mk_use(st: PState, at_present: bool, segs: List<Token>, names: List<Token>) -> CapVal {
    mut path = ""
    for t in segs { path = if path == "" { t.text } else { path + "." + t.text } }
    if at_present { path = "@" + path }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Use(path, param_entries_from_toks(CapVal.Toks(names), ValueType.Unknown))))
}

/// The `@pkg`-prefixed `use` (the `MkUsePkg` build's core). The package SCOPE is a
/// separate capture from the path segments — not another `useg` — because a label
/// bound by two `.One` items is REPLACED, not accumulated, by the executor's `bind`
/// (emit declares one `_list` and pushes at both sites, so the two engines would
/// disagree). Joining here keeps the divergence impossible rather than merely untested.
export fn mk_use_pkg(st: PState, pkg: List<Token>, segs: List<Token>, names: List<Token>) -> CapVal {
    mut all: List<Token> = []
    for t in pkg { all.push(t) }
    for t in segs { all.push(t) }
    mk_use(st, true, all, names)
}

/// Generated-parser twin of the `MkArm` executor build.
export fn mk_arm(st: PState, pat_cv: CapVal, guard_cv: CapVal, body_cv: CapVal) -> CapVal {
    let pat_id = capval_to_pat(st, pat_cv)
    let guard = if capval_present(guard_cv) { capval_to_expr(st, guard_cv) } else { null }
    CapVal.Arm(MatchArm { pattern: st.store.pats.get(pat_id), pattern_id: pat_id, guard_id: guard, body_id: capval_to_expr(st, body_cv) })
}

/// The EXPRESSION twin of `mk_match` (t-47hc.25). Same arms, same child refs — only
/// the node kind and the span differ.
///
/// REFS are identical to mk_match's, for the same reason: `MatchArm` is a MIXED walker
/// node — only the PATTERN is a walked child, while guard and body ride as walker-opaque
/// `ExprId` scalars, and the subject is opaque too so it contributes no edge. That is
/// exactly the set the hand builds (`alloc_expr(node, span, parsed.refs)` where
/// parsed.refs is the arms' patterns). Adding the subject, or guard/body, would hand the
/// walker a different child set than the hand parser produces.
///
/// SPAN: the hand anchors at the `match` keyword (`alloc_at(..., sp_start)`), so this
/// takes sp_start and spans to the current token, with mk_when's `sp_start < 0` guard for
/// the interpreter path (which has no sequence-start byte to pass).
export fn mk_match_expr(st: PState, sp_start: int, subject_cv: CapVal, arms_cv: CapVal) -> CapVal {
    let arms = capval_to_arm_list(arms_cv)
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.Node(st.store.add_expr(
        Expr.MatchExpr(capval_to_expr(st, subject_cv), arms),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        refs
    ))
}

/// `if c { … } else …` in EXPRESSION position (t-47hc.24) — the ordinary form only;
/// the bind-fresh `if let` stays behind `@peek(if_let) @hand(if_expr)`.
///
/// The whole reason this needs a build rather than a bare 3-capture node ctor is the
/// ABSENT else. The hand (if_stmt/parser.av:190-202) synthesizes an EMPTY BLOCK — NOT a
/// `0` literal — so the if-expr types `.Void` on the fall-through path, which is what
/// keeps `if c { return X }` valid in value position and lets a diverging then-branch
/// hand back the real ELSE type instead of a synthesized `int`. That empty block goes
/// through `intern_expr_leaf` (hash-consed, spanless), exactly as `alloc_leaf` does, and
/// is allocated BEFORE the IfExpr row so arena ids stay in the hand's order.
export fn mk_if_expr(st: PState, sp_start: int, cond_cv: CapVal, then_cv: CapVal, else_cv: CapVal) -> CapVal {
    let empty_rows: List<StmtId> = []
    let else_id = match else_cv {
        .Nil -> st.store.intern_expr_leaf(Expr.Block(empty_rows))
        _ -> capval_to_expr(st, else_cv)
    }
    CapVal.Node(st.store.add_expr(
        Expr.IfExpr(capval_to_expr(st, cond_cv), capval_to_expr(st, then_cv), else_id),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

/// The bind-fresh `if let v = x { … } else { … }` in EXPRESSION position (t-47hc.26).
///
/// A DESUGAR, not a parse. Every row is built by `build_if_let_expr` (core/arena.av),
/// the SAME shared core the hand's `parse_if_let_expression` calls — so the native rule
/// and the hand oracle lower to identical rows in identical order, and neither can drift
/// from the other by editing one site.
///
/// `tmp_cv` is the `@gensym(iflet)` mint, already performed AT ITS POSITION in the
/// sequence (between `if` and `let`), which is where the hand mints. Reading it here as
/// an ordinary captured token is the whole point of making gensym a primary: by the time
/// this build runs, the number is already fixed.
///
/// The absent-else case builds the SAME Void empty block `mk_if_expr` does, and BEFORE
/// the desugar rows, matching the hand's order (parse_if_let_expression synthesises the
/// else, then calls the builder). Not a `0` literal: an empty block types `.Void`, which
/// is what keeps `if let v = x { return v }` valid in value position instead of a
/// synthesized int hijacking the result type.
export fn mk_if_let(st: PState, tmp_cv: CapVal, bind_cv: CapVal, subj_cv: CapVal, then_cv: CapVal, else_cv: CapVal) -> CapVal {
    let empty_rows: List<StmtId> = []
    let else_id = match else_cv {
        .Nil -> st.store.intern_expr_leaf(Expr.Block(empty_rows))
        _ -> capval_to_expr(st, else_cv)
    }
    CapVal.Node(build_if_let_expr(
        st.store,
        capval_tok_text(tmp_cv),
        capval_tok_text(bind_cv),
        capval_to_expr(st, subj_cv),
        capval_to_expr(st, then_cv),
        else_id
    ))
}

/// Generated-parser twin of the `MkMatch` executor build.
export fn mk_match(st: PState, subject_cv: CapVal, arms_cv: CapVal) -> CapVal {
    let arms = capval_to_arm_list(arms_cv)
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.SNode(st.store.add_stmt(Stmt.Match(capval_to_expr(st, subject_cv), arms), byte_span_none(), refs))
}

/// t-47hc.29 — the match TABLE's arms, desugared exactly as the hand
/// `parse_match_table_arms` / `parse_match_table_rows` do (features/match_expr/parser.av).
///
/// The header's FIRST column names the PATTERN column and is DISCARDED; the rest are the
/// value columns, so `#cols` IS the hand's `value_count = header_count - 1`. That identity
/// is what lets the grammar express the row width as a bounded repetition `x{#cols}`
/// (t-47hc.28) rather than the data-dependent `while i < value_count` loop the roadmap
/// once read as inexpressible.
///
/// Rows arrive FLATTENED — one alternation branch owns the whole table, because a repetition
/// bound may only name a capture collected earlier in the SAME branch and `exec_rule` mints a
/// fresh CapEnv per rule. So the cells are re-chunked here by `cols.length`, which is sound
/// precisely because the cap guarantees no row exceeds it; a SHORT row (the hand's
/// `if check(RightBrace) break`) is tolerated by clamping, never by reading past the end.
///
/// Each key is `Expr.String` whose lexeme KEEPS its surrounding quotes — the hand writes
/// `"\"${col}\""` because codegen's `strip_quotes` removes them again. Dropping them here
/// would silently change every generated map key. Keys, values and bodies are all
/// span-free `alloc_leaf` rows, matching the hand.
fn build_table_arms(st: PState, cols_cv: CapVal, pats_cv: CapVal, vals_cv: CapVal) -> List<MatchArm> {
    let cols = capval_tok_list(cols_cv)
    let pats = capval_to_pat_list(pats_cv)
    let vals = capval_to_node_list(vals_cv)
    mut out: List<MatchArm> = []
    // `header_count < 2` (i.e. no value columns) yields NO arms — the hand's early return.
    if cols.length == 0 { return out }
    // t-qhbz: REQUIRE the declared width. The row's cell repetition is `*{#cols}`, and a
    // `{#cap}` bound is AT MOST N — never a requirement (`item_bound_cap` stops at the cap
    // but nothing demands it). So a token starting none of `table_cell`'s alternatives —
    // a prefix operator like `-1`, which cells deliberately exclude — simply ENDS the row
    // rather than reporting, and the outer row loop then consumes it as the NEXT row's
    // `p:pattern`, because a negative literal IS a valid pattern. Everything is consumed
    // and nothing complains, so
    //
    //     match e table { pat | delta
    //         .A | -1
    //         .B | 2
    //     }
    //
    // checked CLEAN on both native engines (pats=[.A, -1, 2], vals=[.B]) while the hand
    // parser rejected it F0040. A latent hole since t-47hc.29 — unreachable until fn
    // bodies were routed natively, because a hand-parsed body never got here.
    //
    // This is the one place that knows BOTH the header's value-column count and the
    // flattened cell count, so it is where the width becomes checkable. `cols` holds only
    // the VALUE columns (the header's leading IDENT — the pattern column — is matched
    // unlabelled), so a well-formed table has exactly one cell per row per value column.
    if vals.length != pats.length * cols.length {
        st.report("expected expression")
        return out
    }
    mut r = 0
    while r < pats.length {
        mut ids: List<ExprId> = []
        mut c = 0
        while c < cols.length {
            let at = r * cols.length + c
            if at >= vals.length { break }
            ids.push(st.store.add_expr(Expr.String("\"${cols[c].text}\""), byte_span_none(), []))
            ids.push(vals[at])
            c = c + 1
        }
        let pid = pats[r]
        out.push(MatchArm {
            pattern: st.store.pats.get(pid),
            pattern_id: pid,
            guard_id: none,
            body_id: st.store.add_expr(Expr.MapLit(ids), byte_span_none(), []),
        })
        r = r + 1
    }
    out
}

/// The statement-form match TABLE (t-47hc.29). Node construction is byte-identical to
/// `mk_match` — `Stmt.Match` with `byte_span_none()` and one PatRef per arm — because the
/// hand's table path ends in the very same `alloc_stmt(node, byte_span_none(),
/// glue_match_arm_refs(arms))`. Only where the ARMS come from differs.
export fn mk_match_table(st: PState, subject_cv: CapVal, cols_cv: CapVal, pats_cv: CapVal, vals_cv: CapVal) -> CapVal {
    let arms = build_table_arms(st, cols_cv, pats_cv, vals_cv)
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.SNode(st.store.add_stmt(Stmt.Match(capval_to_expr(st, subject_cv), arms), byte_span_none(), refs))
}

/// The EXPRESSION twin of `mk_match_table` (t-47hc.29 slice 12). Identical arms — the
/// table desugaring is shared via `build_table_arms` — so the two forms cannot drift; only
/// the node kind and the span differ, exactly as `mk_match` / `mk_match_expr` differ.
///
/// SPAN: the hand's expression table path ends in `alloc_expr(node, span_from(sp_start),
/// glue_match_arm_refs(arms))`, anchored at the `match` keyword, so this spans
/// [sp_start, next-token) with mk_match_expr's `sp_start < 0` guard for the interpreter
/// path (which has no sequence-start byte to pass). REFS are the arms' patterns only: the
/// subject is a walker-opaque ExprId scalar and contributes no edge.
export fn mk_match_table_expr(st: PState, sp_start: int, subject_cv: CapVal, cols_cv: CapVal, pats_cv: CapVal, vals_cv: CapVal) -> CapVal {
    let arms = build_table_arms(st, cols_cv, pats_cv, vals_cv)
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.Node(st.store.add_expr(
        Expr.MatchExpr(capval_to_expr(st, subject_cv), arms),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        refs
    ))
}

/// A capture as a match-arm list (statement-`match`, ps3t.6.5.4): the arm `*`
/// yields `Arms` for ≥2, a scalar `Arm` for exactly 1, `Nil` for none.
export fn capval_to_arm_list(v: CapVal) -> List<MatchArm> {
    match v {
        .Arms(xs) -> xs
        .Arm(a) -> [a]
        _ -> []
    }
}

/// Coerce one generated match-arm result for a repeated `match_arm` capture.
export fn capval_to_arm(st: PState, v: CapVal) -> MatchArm {
    match v {
        .Arm(a) -> a
        _ -> {
            st.report("expected a match arm")
            let pid = st.store.pats.add_leaf(Pattern.Wildcard)
            MatchArm { pattern: Pattern.Wildcard, pattern_id: pid, guard_id: none, body_id: st.error_node("expected a match arm") }
        }
    }
}

/// A capture as a field-init list (t-47hc.17): the `field_init` `*` yields `FInits`
/// for ≥2, a scalar `FInit` for exactly 1, `Nil` for none — the `Arms` shape.
export fn capval_to_finit_list(v: CapVal) -> List<FieldInit> {
    match v {
        .FInits(fs) -> fs
        .FInit(f) -> [f]
        _ -> []
    }
}

/// Coerce one generated field-init result for a repeated `field_init` capture — the
/// `capval_to_arm` twin. The fallback keeps the list well-formed after a reported
/// error (an empty name + an error node), so recovery continues instead of aborting.
export fn capval_to_finit(st: PState, v: CapVal) -> FieldInit {
    match v {
        .FInit(f) -> f
        _ -> {
            st.report("expected field name")
            FieldInit { name: "", value_id: st.store.exprs.add_leaf(Expr.Error) }
        }
    }
}

/// Build ONE struct field-init. Mirrors `parse_field_init_list`'s body
/// (features/struct_decl/parser.av:143): `name: value`, or the SHORTHAND `name`
/// (no `:`) which expands to `name: Expr.Ident(name)` — so an absent value must
/// allocate that ident leaf, exactly as the hand `alloc_leaf(Expr.Ident(name))` does.
export fn mk_field_init(st: PState, name_cv: CapVal, value_cv: CapVal) -> CapVal {
    let name = capval_tok_text(name_cv)
    let value_id = match value_cv {
        .Nil -> st.store.exprs.add_leaf(Expr.Ident(name))
        _ -> capval_to_expr(st, value_cv)
    }
    CapVal.FInit(FieldInit { name, value_id })
}

/// Build ONE `with { … }` suffix as a PARTIAL `Expr.With` whose receiver is a
/// placeholder — `fold_postfix_with_expr`/`fold_with_expr` rebind it to the running
/// base via `rebind_with`. The span is `[with-start, next-token)`: `rebind_with` reads
/// this node's `.hi` to stamp each rebuilt `With`, so a chained `a with { } with { }`
/// reproduces the hand loop's per-iteration `alloc_at(…, sp_start)` spans exactly.
/// The twin of the deleted `parse_with_suffix` (parse/mod.av).
export fn mk_with_suffix(st: PState, sp_start: int, finits_cv: CapVal) -> ExprId {
    let inits = capval_to_finit_list(finits_cv)
    let recv = st.store.exprs.add_leaf(Expr.Missing)
    st.store.add_expr(Expr.With(recv, inits), byte_span(sp_start, st.cur().pos), [])
}

/// FIRST-set predicate for an EXTERNAL `pattern_or` reference in the dispatch-only
/// statement grammar. The interpreter composes the pattern fragment and computes
/// this structurally; the static emitter calls this twin so it can keep using the
/// already-generated `parse_pattern_or` without re-emitting that family.
export fn tok_starts_pattern(t: Token) -> bool {
    t.text == "let" || t.text == "none" || t.text == "null" || t.text == "." ||
    t.kind == "IDENT" || t.text == "true" || t.text == "false" ||
    t.kind == "STRING" || t.text == "-" || t.kind == "NUMBER"
}

/// A capture as a parameter list (declaration family, ps3t.6.5.7): the param
/// `*` yields `PEntries` for ≥2, a scalar `PEntry` for exactly 1, `Nil` none.
fn capval_to_pentry_list(v: CapVal) -> List<ParamEntry> {
    match v {
        .PEntries(ps) -> ps
        .PEntry(p) -> [p]
        _ -> []
    }
}

/// A capture as a struct/variant field list (ps3t.6.5.7).
fn capval_to_field_list(v: CapVal) -> List<FieldEntry> {
    match v {
        .Fields(fs) -> fs
        .Field(f) -> [f]
        _ -> []
    }
}

/// A capture as an annotation list (@name(args) declarations, ps3t.6.5.7).
fn capval_to_ann_list(v: CapVal) -> List<Annotation> {
    match v {
        .Anns(xs) -> xs
        .Ann(a) -> [a]
        _ -> []
    }
}

/// A capture as a type-parameter list (declaration generics, ps3t.6.5.7).
/// ONE type parameter out of a capture — the singular sibling of
/// capval_to_tparam_list, needed because the EMITTED parser coerces each element as
/// it pushes (kind_coerce), where the executor folds the whole list at the build.
export fn capval_to_tparam(st: PState, v: CapVal) -> TypeParamEntry {
    match v {
        .TParam(tp) -> tp
        _ -> {
            st.report("expected a type parameter")
            TypeParamEntry { name: "", bounds: "" }
        }
    }
}

export fn capval_to_tparam_list(v: CapVal) -> List<TypeParamEntry> {
    match v {
        .TParams(tps) -> tps
        .TParam(tp) -> [tp]
        _ -> []
    }
}

/// A capture as an enum-variant list (ps3t.6.5.7).
fn capval_to_var_list(v: CapVal) -> List<Variant> {
    match v {
        .Vars(vs) -> vs
        .Var(vv) -> [vv]
        _ -> []
    }
}

/// Convert captured identifier tokens to a `ParamEntry` binding list — the
/// simple-binding variant payload `.Ok(x, y)` (ps3t.6.5.5). Only the name is
/// load-bearing for render/equivalence (render_param_list renders names
/// only), so the vtype is `Unknown`, exactly as the hand parser's
/// unannotated binding.
/// `vt` is the caller's parser-default: the hand parser records `Int` for
/// unannotated VARIANT-PATTERN bindings (they ride `parse_param_list`, whose
/// no-annotation default is Int) but `Unknown` for destructure/`use` names
/// (parse_destructure_names' "no type was written" rows). The differential
/// oracle compares full ASTs through the faithful render, so the DSL must
/// reproduce each site's exact default, not a single one.
export fn param_entries_from_toks(v: CapVal, vt: ValueType) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    match v {
        .Toks(ts) -> {
            for t in ts { out.push(ParamEntry { name: t.text, vtype: vt }) }
        }
        .Tok(t) -> out.push(ParamEntry { name: t.text, vtype: vt })
        _ -> {}
    }
    out
}

/// Left-fold a `base ( suffix )*` postfix chain. Each suffix was built as
/// a partial node (FieldAccess/Index) with a sentinel receiver; here we
/// rebind each one's receiver to the accumulated left node — a
/// left-associative chain (`a.b[0].c` → `((a.b)[0]).c`). This is the
/// "partial-node with a HOLE" technique that lets a heterogeneous
/// postfix fold live in the grammar (docs/…L4_DERIVE_FRAMEWORK_DESIGN
/// §2.5). Calls (arg lists) + method dispatch are the harder remaining
/// case (list-valued builds).
export fn fold_postfix_expr(st: PState, basecap: CapVal, suffixescap: CapVal) -> ExprId {
    mut acc = capval_to_expr(st, basecap)
    for s in capval_nodes(suffixescap) {
        acc = rebind_receiver(st, acc, s)
    }
    acc
}

fn rebind_receiver(st: PState, recv: ExprId, suffix: ExprId) -> ExprId {
    match st.store.exprs.get(suffix) {
        .FieldAccess(_, field) -> st.store.exprs.add_leaf(Expr.FieldAccess(recv, field))
        .Index(_, idx) -> st.store.exprs.add_leaf(Expr.Index(recv, idx))
        .Call(_, cargs) -> st.store.exprs.add_leaf(Expr.Call(recv, cargs))
        _ -> recv
    }
}

/// A capture as a node list: many args are Nodes, a single arg a scalar
/// Node, no args Nil. (The `first ( "," rest )*` comma-list, with
/// scalar→list promotion in append_node, produces Nodes for ≥2 and a
/// scalar Node for exactly 1.)
export fn capval_to_node_list(v: CapVal) -> List<ExprId> {
    match v {
        .Nodes(ns) -> ns
        .Node(id) -> [id]
        _ -> []
    }
}

/// Left-fold `l ( op r )*` into a left-associative `Expr.Logical` chain
/// (the `&&`/`||` short-circuit ops). Sibling of fold_binary.
export fn fold_logical_expr(st: PState, sp_start: int, lcap: CapVal, opcap: CapVal, rcap: CapVal) -> ExprId {
    mut acc = capval_to_expr(st, lcap)
    let ops = capval_toks(opcap)
    let rs = capval_nodes(rcap)
    let m = if ops.length < rs.length { ops.length } else { rs.length }
    mut i = 0
    while i < m {
        // Each intermediate Logical carries [sp_start, next-token) exactly as the
        // hand parse_or/parse_and stamp it per iteration (mod.av:1564): sp_start is
        // the rule-entry byte (leftmost operand, reused), and the hi after
        // consuming rs[i] is the NEXT operator's byte (ops[i+1].pos) or, for the
        // last, the token past the whole fold (st.cur().pos). sp_start < 0 (the
        // interpreter's span-free path) folds to byte_span_none. add_expr(_, sp, [])
        // mirrors alloc_at's empty-edges spanned alloc.
        let hi = if i + 1 < m { ops[i + 1].pos } else { st.cur().pos }
        acc = st.store.add_expr(Expr.Logical(acc, logicop_of(ops[i].text), rs[i]), byte_span(sp_start, hi), [])
        i = i + 1
    }
    acc
}

fn logicop_of(sym: string) -> LogicOp {
    // Both the symbolic (`||`/`&&`) and keyword (`or`/`and`) spellings map to the
    // same LogicOp — the hand parser's parse_or/parse_and accept both (mod.av).
    if sym == "||" || sym == "or" { return LogicOp.Or }
    LogicOp.And
}

/// `l ( "=" r )?` → an assignment, RETARGETING by the LHS shape (the hand
/// parser's parse_assignment: an `Ident` LHS → `Expr.Assign`, a `FieldAccess`
/// LHS → `Expr.FieldAssign`; any other target is an F-code-worthy error). With
/// no `=` (rcap Nil) the left passes through unchanged. Right-associative — the
/// grammar's `r:assignment` recursion supplies the nested value.
export fn mk_assign_expr(st: PState, sp_start: int, lcap: CapVal, rcap: CapVal) -> ExprId {
    let l = capval_to_expr(st, lcap)
    match rcap {
        .Nil -> l
        _ -> {
            let r = capval_to_expr(st, rcap)
            // [sp_start, next-token) as the hand parse_assignment stamps (mod.av:1447).
            // Right-assoc, so a nested `a = b = c` gets its own sp_start per level via
            // the grammar's `r:assignment` recursion — each Assign spans from its own LHS.
            let sp = byte_span(sp_start, st.cur().pos)
            match st.store.exprs.get(l) {
                .Ident(name) -> st.store.add_expr(Expr.Assign(name, r), sp, [])
                .FieldAccess(obj, field) -> st.store.add_expr(Expr.FieldAssign(obj, field, r), sp, [])
                _ -> st.error_node("invalid assignment target")
            }
        }
    }
}

// ── The `is` / `in` / `==`-chain equality suffix (ps3t.6.7 Step C) ──
//
// The DSL alternation can't left-factor "parse bitor THEN branch on is/in/==",
// so the suffix rule (eq_tail) builds a PARTIAL node whose subject is a
// `Expr.Missing` sentinel, and rebind_eq_expr retargets that sentinel to the
// real `base` — the fold_postfix `rebind_receiver` pattern, lifted to the
// equality stratum. is/in are mutually exclusive with the `==`/`!=` chain
// (the hand parse_equality returns after is/in), which the eq_tail alternation
// (distinct FIRSTs: `is` / `in` / `==`|`!=`) captures exactly.

/// `is .Variant` → `Expr.IsCheck(MISSING, name)` (retargeted by rebind_eq_expr).
export fn mk_is_expr(st: PState, vcap: CapVal) -> ExprId {
    st.store.exprs.add_leaf(Expr.IsCheck(st.missing_node(), capval_tok_text(vcap)))
}

/// `in [ a, … ]` → `Expr.InCheck(MISSING, items)` (list-membership).
export fn mk_inlist_expr(st: PState, acap: CapVal) -> ExprId {
    st.store.exprs.add_leaf(Expr.InCheck(st.missing_node(), capval_to_node_list(acap)))
}

/// `[ a, b, … ]` list literal (t-47hc.4 list_lit flip — DORMANT builds, proven by a
/// test grammar; not yet wired into avra_expr_grammar). The `acap` comma-list capture
/// (`( a:expression ( "," a:expression )* )?`, scalar→list promotion via append_node)
/// becomes the element list; empty/single/multi are uniform (Nil → []). Spanned
/// [sp_start, next-token) exactly like the hand parse_list_expr alloc_at(Expr.ListLit,
/// sp_start) (mod.av:2286/2298) — sp_start is the `[` byte (emit) or 0-1 span-free
/// (interpreter oracle). `Expr.ListLit`'s id-list child is walker-opaque → empty edges.
export fn mk_list_lit(st: PState, sp_start: int, acap: CapVal) -> ExprId {
    st.store.add_expr(Expr.ListLit(capval_to_node_list(acap)), byte_span(sp_start, st.cur().pos), [])
}

/// One `table { … }` being parsed: the row-type ascription and the header's column
/// names. A STACK of these lives on `PState` because a table cell may itself hold a
/// table, and the hand keeps `row_type`/`col_names` as ordinary LOCALS — so nesting
/// scopes them for free there. Pushing on the header and popping in the outer build
/// reproduces exactly that lexical scoping.
///
/// Why threaded state rather than an intermediate per-row node: the row build needs the
/// header to pair names with cells, and it must NOT allocate a throwaway node to carry
/// its cells upward. `alloc_leaf` id parity with the hand is load-bearing (see
/// `mk_grammar_block`) and an orphan row per table would shift every later id. Threading
/// costs one PState field and mirrors what the hand already does.
export type TableCtx = { row_type: string, cols: List<string> }

/// The header half of `table [<Row>] { a | b`, run as its own rule so its build fires
/// BEFORE the rows are parsed — the rows need the column names.
///
/// Reports the hand's duplicate-column error here, at the same point the hand does
/// (`parse_table_literal`, immediately after the header loop), so the diagnostic order
/// across a table with BOTH a duplicate column and a bad row width matches.
export fn mk_table_header(st: PState, rtcap: CapVal, hcap: CapVal) -> CapVal {
    let cols = capval_tok_texts(hcap)
    mut di = 0
    while di < cols.length {
        mut dj = di + 1
        while dj < cols.length {
            if cols[di] == cols[dj] {
                st.push_table_ctx(TableCtx { row_type: capval_tok_text(rtcap), cols })
                return CapVal.Node(st.error_node("duplicate table column `${cols[di]}`"))
            }
            dj = dj + 1
        }
        di = di + 1
    }
    st.push_table_ctx(TableCtx { row_type: capval_tok_text(rtcap), cols })
    CapVal.Nil
}

/// ONE data row → the `Expr.StructLit` the hand builds, field names from the header and
/// values from this row's cells, left to right.
///
/// INTERNS (`intern_expr_leaf`), matching the hand's `alloc_leaf` for the row node.
///
/// The cell-count check lives here, not in the outer build, because only here are the
/// row's OWN cells visible. A flat cross-row cell capture cannot express it: `1|2` then
/// `3` and `1` then `2|3` both yield three cells, so the per-row "N cell(s) but the
/// header declares M" would be unreproducible — the same defect t-qhbz records in
/// `build_table_arms`'s flat `vals` indexing.
export fn mk_table_row(st: PState, vcap: CapVal) -> ExprId {
    let cells = capval_to_node_list(vcap)
    if st.table_cols.length == 0 { return st.error_node("table row outside a table header") }
    let ctx = st.table_cols[st.table_cols.length - 1]
    let n = ctx.cols.length
    if cells.length != n {
        return st.error_node("table row has ${string(cells.length)} cell(s) but the header declares ${string(n)} column(s)")
    }
    mut inits: List<FieldInit> = []
    mut ci = 0
    while ci < n {
        inits.push(FieldInit { name: ctx.cols[ci], value_id: cells[ci] })
        ci = ci + 1
    }
    st.store.intern_expr_leaf(Expr.StructLit(ctx.row_type, inits))
}

/// The whole `table [<Row>] { … }` literal → `Expr.ListLit(rows)`, spanned from the
/// `table` keyword, which is what the hand's `alloc_at(…, sp_start)` produces.
///
/// A table whose header names NO columns is an empty `ListLit` — the hand returns one
/// the moment `header_count == 0`, without looking at a single row.
export fn mk_table_lit(st: PState, sp_start: int, rowscap: CapVal) -> ExprId {
    let empty_header = st.table_cols.length > 0 && st.table_cols[st.table_cols.length - 1].cols.length == 0
    st.pop_table_ctx()
    let rows = if empty_header { [] } else { capval_to_node_list(rowscap) }
    st.store.add_expr(Expr.ListLit(rows), byte_span(sp_start, st.cur().pos), [])
}

/// A `"…${x}…"` template primary (t-47hc.19). The desugar itself is SHARED with the
/// hand parser via desugar_template_store — one implementation, two call sites — so the
/// concatenation shape and format-spec routing cannot drift. The error is reported on
/// THIS side's channel, matching the hand's set_error wording.
export fn mk_template(st: PState, tcap: CapVal) -> ExprId {
    match desugar_template_store(st.store, capval_tok_text(tcap)) {
        .Ok(id) -> id
        .Err(m) -> st.error_node(m)
    }
}

/// `Name { f: v, … }` — a plain (unqualified) STRUCT LITERAL, the grammar-expressible
/// branch of the hand `parse_ident_expr` (t-47hc slice 8). The nominal sibling of
/// `mk_qualified`'s struct-literal half: same `Expr.StructLit` payload and the same
/// `capval_to_finit_list` field decoding, with the name taken from one IDENT instead
/// of rebuilt from `@pkg::mod::` segments.
///
/// Unlike `mk_qualified` there is no `lb` capture to distinguish an EMPTY literal
/// from a bare ident, because the two are separate grammar branches here: this
/// builder is reached only when the `{` was actually matched, so `Name {}` (no
/// fields) is still a StructLit with an empty field list, exactly as the hand
/// parser builds it.
export fn mk_struct_lit(st: PState, sp_start: int, ncap: CapVal, fcap: CapVal) -> ExprId {
    st.store.add_expr(Expr.StructLit(capval_tok_text(ncap), capval_to_finit_list(fcap)), byte_span(sp_start, st.cur().pos), [])
}

/// The `grammar { … }` feature block (t-myz7) — the desugared call the hand's
/// `parse_grammar_block` (features/grammar/parser.av) builds:
///     grammar { expr = term }   ==>   parse_grammar("expr = term")
/// `bcap` is the `@rawbrace` capture: the verbatim source between the braces, from
/// the SHARED `rawbrace_scan`, so the body text cannot drift from the hand's
/// `capture_balanced_brace_body`.
///
/// The bookend quotes are added WITHOUT escaping the interior, deliberately and
/// exactly as the hand does: codegen's `strip_quotes` peels one char from each end,
/// so a grammar literal's own `"+"` quotes — and the newlines of a multi-line block —
/// survive verbatim into the runtime string. Escaping here would corrupt every
/// grammar literal that quotes a terminal, which is all of them.
/// Both leaves INTERN, matching the hand's `alloc_leaf` (= `store.intern_expr_leaf`)
/// — the §14.4 convention `literal_node` states: a grammar-built leaf must produce the
/// SAME arena id the hand parser does, or repeat content diverges. `Expr.Ident(
/// "parse_grammar")` is emitted once per `grammar { … }` block in the file, so with a
/// plain `add_leaf` every block would mint its own callee row where the hand shares one.
///
/// diff-test cannot see this: distinct-but-equal leaf rows lower to identical IR, so the
/// divergence lives purely in arena ids — which is exactly what the L6 content-id and
/// early-cutoff machinery keys on. IR equality is not evidence of id parity.
export fn mk_grammar_block(st: PState, sp_start: int, bcap: CapVal) -> ExprId {
    let str_id = st.store.intern_expr_leaf(Expr.String("\"" + capval_tok_text(bcap) + "\""))
    let callee = st.store.intern_expr_leaf(Expr.Ident("parse_grammar"))
    st.store.add_expr(Expr.Call(callee, [str_id]), byte_span(sp_start, st.cur().pos), [])
}

/// A TAGGED TEMPLATE — ``tag`…` `` — the hand `parse_ident_expr`'s template branch
/// (t-47hc slice 8). Desugars to a CALL of the tag with the interpolated template as
/// its single argument, which is exactly what the hand builds:
///     Expr.Call(Expr.Ident(tag), [desugar_template(raw)])
/// The template argument goes through the same `desugar_template_store` that
/// `mk_template` uses, so an interpolated tagged template lowers identically to a
/// bare one — only the surrounding call differs.
export fn mk_tagged_template(st: PState, sp_start: int, ncap: CapVal, tcap: CapVal) -> ExprId {
    let tag_id = st.store.exprs.add_leaf(Expr.Ident(capval_tok_text(ncap)))
    let arg_id = mk_template(st, tcap)
    st.store.add_expr(Expr.Call(tag_id, [arg_id]), byte_span(sp_start, st.cur().pos), [])
}

/// `@pkg::mod::name` and its struct-literal form `@pkg::mod::Name { f: v }` (t-47hc.18b).
/// The name is rebuilt from the `@`-IDENT plus each `::`-segment token, exactly as the
/// hand parse_qualified_at_name concatenates them. A `{ … }` suffix is taken ONLY when
/// allow_struct_lit is on (the @when gate) — `lb` present distinguishes an EMPTY struct
/// literal `@a::B {}` from a bare qualified ident, which both yield no field inits.
export fn mk_qualified(st: PState, sp_start: int, ncap: CapVal, scap: CapVal, lbcap: CapVal, fcap: CapVal) -> ExprId {
    mut name = "@" + capval_tok_text(ncap)
    for t in capval_toks(scap) { name = name + "::" + t.text }
    match lbcap {
        .Nil -> st.store.exprs.add_leaf(Expr.QualifiedIdent(name))
        _ -> st.store.add_expr(Expr.StructLit(name, capval_to_finit_list(fcap)), byte_span(sp_start, st.cur().pos), [])
    }
}

export fn mk_splice(st: PState, sp_start: int, tcap: CapVal) -> ExprId {
    st.store.add_expr(Expr.Splice(capval_to_expr(st, tcap)), byte_span(sp_start, st.cur().pos), [])
}

/// `~Name { fields }` inside a quote body splices the CONSTRUCTOR NAME of a
/// struct literal, not the whole literal — parse_leaf_common's special case: the
/// `~`-prefixed name flows through name_or_splice in the quote lowering. Without
/// this arm the greedy `~ t:unary` splice swallows the entire literal as ONE
/// spliced node (MkSplice(StructLit)) carrying a hardcoded type name, and a
/// stmts-quote then lowers that statement as a list SPLICE — `list_concat` of a
/// struct value, the F4005 the sweep caught the moment the wrapper routing put
/// `@comptime` fns on the static path. Spanned at the `~` like the hand's
/// alloc_at(…, sp_start); span-free (-1) under the interpreter oracle.
export fn mk_splice_struct(st: PState, sp_start: int, ncap: CapVal, fcap: CapVal) -> ExprId {
    st.store.add_expr(Expr.StructLit("~" + capval_tok_text(ncap), capval_to_finit_list(fcap)), byte_span(sp_start, st.cur().pos), [])
}

/// `{ "k": v, … }` map literal (t-47hc.18). `Expr.MapLit`'s payload is a FLAT id list
/// `[k1,v1,k2,v2,…]`, so the two PARALLEL captures are interleaved here — a `map_entry`
/// sub-rule can't work (a rule ref yields one CapVal, an entry needs two). Empty `{}`
/// falls out as empty lists. Spanned like the hand parse_map_literal's alloc_at.
export fn mk_map_lit(st: PState, sp_start: int, kcap: CapVal, vcap: CapVal) -> ExprId {
    let ks = capval_to_node_list(kcap)
    let vs = capval_to_node_list(vcap)
    mut ids: List<ExprId> = []
    mut i = 0
    while i < ks.length {
        ids.push(ks[i])
        if i < vs.length { ids.push(vs[i]) }
        i = i + 1
    }
    st.store.add_expr(Expr.MapLit(ids), byte_span(sp_start, st.cur().pos), [])
}

/// `( a, b, … )` tuple (t-47hc paren_expr flip prep — DORMANT build, proven by a test
/// grammar; not yet wired into avra_expr_grammar). Structural twin of mk_list_lit:
/// `Expr.Tuple` and `Expr.ListLit` are the SAME shape (one `List<ExprId>` child), so
/// the `acap` comma-list capture becomes the element list identically (empty/single/
/// multi uniform, Nil → []). Spanned [sp_start, next-token) exactly like the hand
/// parse_paren_expr alloc_at(Expr.Tuple, sp_start) (mod.av:2324/2362) — sp_start is the
/// `(` byte (emit) or 0-1 span-free (interpreter oracle). Like ListLit, `Expr.Tuple`'s
/// id-list child is walker-opaque, and the hand alloc_at passes `[]` edges for every
/// compound node → empty edges here is byte-identical.
export fn mk_tuple(st: PState, sp_start: int, acap: CapVal) -> ExprId {
    st.store.add_expr(Expr.Tuple(capval_to_node_list(acap)), byte_span(sp_start, st.cur().pos), [])
}

/// The hand parse_paren_expr's `exprs_to_params` (mod.av:495) — REPLICATED here rather
/// than imported. It lives in the hand parser `parse/mod.av`, a universally-imported
/// module; adding a new `export` there risks the diff-test monomorphization-ORDERING
/// trap (a new exported symbol in a core module reorders monomorphized types in CI's
/// hermetic build → non-byte-identical, invisible locally). Keeping the copy in this
/// LEAF module sidesteps that. It MUST stay in lockstep with the hand version: extract
/// the bare name from each param expr (Ident/QualifiedIdent → name, else "_"); the
/// UNTYPED-lambda position carries no type syntax (the typed `(x: int)` path goes
/// through parse_param_list), so every row is `vtype: Unknown, ty_id: none`.
fn lambda_exprs_to_params(st: PState, ids: List<ExprId>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    for id in ids {
        let name = match st.store.exprs.get(id) {
            .Ident(n) -> n
            .QualifiedIdent(n) -> n
            _ -> "_"
        }
        out.push(ParamEntry { name: name, vtype: ValueType.Unknown, ty_id: none })
    }
    out
}

/// `( x ) -> body` / `( a, b ) -> body` / `() -> body` UNTYPED lambda (t-47hc paren_expr
/// flip prep — DORMANT build, proven by a test grammar; not yet wired into
/// avra_expr_grammar). Mirrors the hand parse_paren_expr's `alloc_at(Expr.Lambda(
/// exprs_to_params(combined_ids), body), sp_start)` (mod.av:2321/2358/2373): the params
/// come from PARSED exprs (bare Ident names — `(x)` is ambiguous with `(expr)` grouping
/// until the `->` is seen), converted by lambda_exprs_to_params; `body` is the lambda
/// body ExprId. sp_start = the `(` byte (emit) or 0-1 span-free (interpreter oracle);
/// alloc_at passes `[]` edges for every compound node → empty edges here is byte-
/// identical. The TYPED `(x: int) ->` path is a separate primitive (parse_param_list).
export fn mk_lambda(st: PState, sp_start: int, params_cap: CapVal, body: ExprId) -> ExprId {
    let params = lambda_exprs_to_params(st, capval_to_node_list(params_cap))
    st.store.add_expr(Expr.Lambda(params, body), byte_span(sp_start, st.cur().pos), [])
}

/// `( expr )` grouping OR `()` empty tuple (t-47hc paren spend). The paren_tail's final
/// branch `( @on(allow_dot_postfix) e:expression )? ")" -> MkGroupOrEmpty(e)` captures `e`
/// as an OPT-SCALAR — `CapVal.Nil` when the optional expression is absent. Mirrors the hand
/// parse_paren_expr's two no-comma-no-arrow outcomes: `()` → `alloc_at(Expr.Tuple([]),
/// sp_start)` (mod.av:2324) and `(x)` → `alloc_at(Expr.Grouping(x), sp_start)` (mod.av:2375).
/// This is the empty/grouping twin the EMITTER needs: `MkTuple(a)` cannot build the empty
/// tuple because the emitter only declares `<label>_list` for a repetition-captured label,
/// so a build reading an UNCAPTURED `a` references an undeclared `a_list` — the empty case
/// routes here on the opt-scalar `e` instead. sp_start = the `(` byte (emit) or 0-1 span-free
/// (interpreter oracle); `[]` edges match alloc_at for every compound node (byte-identical).
export fn mk_group_or_empty(st: PState, sp_start: int, e: CapVal) -> ExprId {
    match e {
        .Nil -> st.store.add_expr(Expr.Tuple([]), byte_span(sp_start, st.cur().pos), [])
        _ -> st.store.add_expr(Expr.Grouping(capval_to_expr(st, e)), byte_span(sp_start, st.cur().pos), [])
    }
}

/// `( a, b, … )` tuple from a FIRST element + a REST list (t-47hc paren spend). Distinct
/// from mk_tuple, which takes a single accumulated list: the paren tuple branch
/// `"(" @on first:expression ( "," ( @on rest:expression )? )+ ")"` keeps the FIRST element
/// as a SCALAR capture (`first`) and the remainder as a list (`rest`), then PREPENDS. This
/// sidesteps the executor capture pitfall a single-list `MkTuple(a)` hits here — a TOP-LEVEL
/// One `a` mixed with a nested list `a` drops the first element when the nested repetition
/// matches 0 times (e.g. `(x,)`). The `+` enforces the mandatory tuple comma (so `(x)` rolls
/// back to grouping via the #995 Plus-in-@try guard) and the nested `( rest )?` tolerates a
/// trailing comma with no element after it. Building Tuple([first] + rest) is byte-identical
/// to the hand parse_paren_expr's `[expr] ++ parse_tuple_rest` (mod.av:2354/2360), covering
/// `(x,)` / `(x,y)` / `(x,y,)` / `(x,y,z)` uniformly. sp_start = the `(` byte; `[]` edges
/// match alloc_at.
export fn mk_tuple_fr(st: PState, sp_start: int, first: CapVal, rest_cap: CapVal) -> ExprId {
    mut ids: List<ExprId> = [capval_to_expr(st, first)]
    for id in capval_to_node_list(rest_cap) { ids.push(id) }
    st.store.add_expr(Expr.Tuple(ids), byte_span(sp_start, st.cur().pos), [])
}

/// `( x: T, y: U ) -> body` TYPED lambda (t-47hc paren_expr flip prep — DORMANT). The
/// TYPED twin of mk_lambda: its params come from PENTRIES (name:type pairs built by the
/// existing MkParam via the grammar-native `param = pname:IDENT ( ":" pt:type_expr )?`
/// rule) rather than from bare Ident exprs, so it takes a `List<ParamEntry>` directly —
/// the same capval_to_pentry_list contract MkFnDecl / MkMethod use. Mirrors the hand
/// parse_paren_expr's typed-lambda alloc_at(Expr.Lambda(params, body), sp_start)
/// (mod.av:2338), where params come from parse_param_list. sp_start = the `(` byte
/// (emit) or 0-1 span-free (interpreter oracle); `[]` edges match alloc_at, byte-
/// identical. The UNTYPED `(x) ->` path is mk_lambda; the two are distinguished at the
/// grammar level (@peek(ident_colon) picks the typed branch), never here.
export fn mk_lambda_typed(st: PState, sp_start: int, params: List<ParamEntry>, body: ExprId) -> ExprId {
    st.store.add_expr(Expr.Lambda(params, body), byte_span(sp_start, st.cur().pos), [])
}

/// `[ body for v in collection ( if filter )? ]` comprehension (t-47hc.4 — DORMANT).
/// The twin of the hand parse_list_elements' `Expr.ListComp(expr_id, var_name,
/// collection_id, filter)` (list_lit/parser.av). body/collection/filter are ExprId
/// scalars + a nullable filter — all walker-opaque, so the comp is a leaf row (empty
/// edges). `filt_cv` is Nil when the `( if … )?` clause is absent (→ filter none),
/// else the parsed filter expression. Spanned [sp_start, next-token); the hand parser
/// anchors sp_start at the FIRST ELEMENT (the byte after `[`), which the eventual @try/
/// left-factored spend supplies as the sub-rule / branch entry byte.
export fn mk_list_comp(st: PState, sp_start: int, body: ExprId, variable: string, collection: ExprId, filt_cv: CapVal) -> ExprId {
    mut filter: ExprId? = none
    match filt_cv {
        .Nil -> {}
        _ -> filter = capval_to_expr(st, filt_cv)
    }
    st.store.add_expr(Expr.ListComp(body, variable, collection, filter), byte_span(sp_start, st.cur().pos), [])
}

/// `in s..e` → the range-membership desugar `MISSING >= s && MISSING <= e`, a
/// `Logical(Binary(_, Ge, s), And, Binary(_, Le, e))`. rebind_eq_expr swaps BOTH
/// sentinels for `base` (one shared id, as the hand parser does).
export fn mk_inrange_expr(st: PState, scap: CapVal, ecap: CapVal) -> ExprId {
    let s = capval_to_expr(st, scap)
    let e = capval_to_expr(st, ecap)
    let ge = st.store.exprs.add_leaf(Expr.Binary(st.missing_node(), BinOp.Ge, s))
    let le = st.store.exprs.add_leaf(Expr.Binary(st.missing_node(), BinOp.Le, e))
    st.store.exprs.add_leaf(Expr.Logical(ge, LogicOp.And, le))
}

/// Build a contextual enum constructor `.Variant` / `.Variant(args)` (Phase 3a-7
/// slice 4). Matches hand parse_primary's `Expr.EnumCtor("", variant, args)` — the
/// EMPTY enum name is the contextual marker (the enum is inferred from the expected
/// type). `vcap` is the variant IDENT; `acap` is the optional args list (Nil ⇒ empty
/// nullary ctor). Spanned `[sp_start, next-token)` exactly like the hand `alloc_at`
/// (sp_start = the `.` byte); sp_start < 0 is the interpreter's span-free sentinel.
export fn mk_enum_ctor_expr(st: PState, sp_start: int, vcap: CapVal, acap: CapVal) -> ExprId {
    let variant = capval_tok_text(vcap)
    let args = capval_to_node_list(acap)
    let sp = byte_span(sp_start, st.cur().pos)
    st.store.add_expr(Expr.EnumCtor("", variant, args), sp, [])
}

/// `( == | != ) r )+` → the left-assoc `Expr.Binary` chain seeded with a MISSING
/// left; rebind_eq_expr retargets the spine-bottom sentinel to `base`. Reuses
/// fold_binary_expr so the chain matches the plain `==`/`!=` fold byte-for-byte.
export fn mk_eqchain_expr(st: PState, opcap: CapVal, rcap: CapVal) -> ExprId {
    fold_binary_expr(st, CapVal.Node(st.missing_node()), opcap, rcap)
}

/// Retarget the eq_tail partial's `Expr.Missing` subject(s) to `base` — the
/// equality-stratum sibling of fold_postfix_expr. With no suffix (tailcap Nil)
/// the base passes through unchanged.
export fn rebind_eq_expr(st: PState, sp_start: int, basecap: CapVal, tailcap: CapVal) -> ExprId {
    let base = capval_to_expr(st, basecap)
    match tailcap {
        .Nil -> base
        _ -> rebind_missing_subject(st, sp_start, capval_to_expr(st, tailcap), base)
    }
}

/// Rebuild `tail` with its `Expr.Missing` subject replaced by `base` — the FINAL
/// equality node(s), stamped [sp_start, next-token) exactly as the hand
/// parse_equality stamps IsCheck/InCheck/the in-range Logical/the ==-chain
/// (mod.av:1620-1630) with its rule-entry sp_start. The discardable partial rows
/// (mk_is/mk_inlist/mk_inrange/mk_eqchain) stay span-free — only these rebound
/// finals reach the tree. Dispatches on the partial's shape; the `==`-chain
/// recurses down the left spine to the sentinel seed (a chained `a==b==c`'s
/// intermediate node shares this hi — rare, span-untested; single `a==b` is exact).
fn rebind_missing_subject(st: PState, sp_start: int, tail_id: ExprId, base: ExprId) -> ExprId {
    let sp = byte_span(sp_start, st.cur().pos)
    match st.store.exprs.get(tail_id) {
        .IsCheck(_, v) -> st.store.add_expr(Expr.IsCheck(base, v), sp, [])
        .InCheck(_, items) -> st.store.add_expr(Expr.InCheck(base, items), sp, [])
        .Logical(ge, op, le) -> {
            let ge2 = rebind_bin_subject(st, sp_start, ge, base)
            let le2 = rebind_bin_subject(st, sp_start, le, base)
            st.store.add_expr(Expr.Logical(ge2, op, le2), sp, [])
        }
        .Binary(l, op, r) -> st.store.add_expr(Expr.Binary(rebind_missing_subject(st, sp_start, l, base), op, r), sp, [])
        _ -> base
    }
}

/// Replace the left of a single range-comparison `Binary(_, op, r)` with `base`.
fn rebind_bin_subject(st: PState, sp_start: int, id: ExprId, base: ExprId) -> ExprId {
    match st.store.exprs.get(id) {
        .Binary(_, op, r) -> st.store.add_expr(Expr.Binary(base, op, r), byte_span(sp_start, st.cur().pos), [])
        _ -> id
    }
}

/// Left-fold `l ( "|>" r )*` into the pipe desugar — the hand parse_pipe: `a |> f`
/// → `f(a)`; `a |> f(b)` → `f(a, b)` (prepend); `a |> f(_, b)` → `f(a, b)` (the `_`
/// placeholder takes the piped value). Each `r` is a grammar-native logic_or
/// parsed with `it`-sugar. Left-associative: `a |> f |> g` = `g(f(a))`.
export fn fold_pipe_expr(st: PState, sp_start: int, lcap: CapVal, rcap: CapVal) -> ExprId {
    mut acc = capval_to_expr(st, lcap)
    // [sp_start, next-token) as the hand parse_pipe stamps each desugared Call
    // (mod.av:1477/1481/1486). The pipe rule captures no `|>` tokens, so a
    // per-step hi isn't recoverable; st.cur().pos is EXACT for the outermost
    // (single) pipe — the common case — and only a chained `a |> f |> g` shares
    // this hi across its intermediate Call (rare, span-untested). sp_start < 0
    // (interpreter) folds to span-free.
    let sp = byte_span(sp_start, st.cur().pos)
    for rid in capval_nodes(rcap) {
        acc = match st.store.exprs.get(rid) {
            .Call(callee, args) -> {
                if pipe_has_placeholder(st, args) {
                    st.store.add_expr(Expr.Call(callee, pipe_replace_placeholder(st, args, acc)), sp, [])
                } else {
                    mut prepended: List<ExprId> = [acc]
                    for a in args { prepended.push(a) }
                    st.store.add_expr(Expr.Call(callee, prepended), sp, [])
                }
            }
            _ -> st.store.add_expr(Expr.Call(rid, [acc]), sp, [])
        }
    }
    acc
}

/// Left-fold the `with` POSTFIX (Phase 3a-3): rebind each PARTIAL `with_suffix`
/// (`Expr.With(placeholder, overrides)`) onto the accumulated base, stamping the
/// hand `parse_unary` with-loop's `[base-start, next-token)` span per step — the
/// twin of fold_pipe_expr/fold_nullish_expr's sp_start threading. Each partial's OWN
/// span `.hi` is exactly that iteration's end byte (parse_with_suffix stamps `[with-
/// start, next-token)`), so a chained `a with { } with { }` gets precise per-`With`
/// spans, not one shared hi. With no suffix the base passes through unchanged (byte-
/// identical to a plain `parse_call` result). sp_start < 0 is the interpreter's span-
/// free path (the differential oracle), exactly like the sibling folds.
export fn fold_with_expr(st: PState, sp_start: int, baseCap: CapVal, suffixesCap: CapVal) -> ExprId {
    mut acc = capval_to_expr(st, baseCap)
    for s in capval_nodes(suffixesCap) {
        acc = rebind_with(st, sp_start, acc, s)
    }
    acc
}

/// The Phase-3a postfix+with fold: the grammar's `unary` rule collects the primary
/// base, the postfix-chain steps, and the `with` suffixes, and this picks the final
/// node. Each `postfix_suffix` returns the FULLY-accumulated base after that step
/// (postfix_step wraps the running `rid`), so the LAST postfix node IS the complete
/// postfix-chain result — already precisely spanned by postfix_step's `alloc_at`, so
/// there is NO re-span here. `pCap` empty ⇒ no postfix ⇒ the base passes through.
/// The `with` suffixes then fold over it via rebind_with exactly as fold_with_expr
/// does (sp_start = the chain start; sp_start < 0 = the interpreter's span-free
/// oracle path, like the sibling folds).
export fn fold_postfix_with_expr(st: PState, sp_start: int, baseCap: CapVal, pCap: CapVal, sCap: CapVal) -> ExprId {
    let ps = capval_nodes(pCap)
    mut acc = if ps.length == 0 { capval_to_expr(st, baseCap) } else { ps[ps.length - 1] }
    for s in capval_nodes(sCap) {
        acc = rebind_with(st, sp_start, acc, s)
    }
    acc
}

/// ONE native `postfix_suffix` step's shared tail (t-47hc.33): stamp `node` with the
/// CHAIN's span and re-seed the base so the next `( postfix_suffix )*` iteration folds
/// onto it.
///
/// Two things every native suffix must get right, both of which the `@hand` delegate
/// (`parse_postfix_suffix`) did for free:
///
///   1. The span is `[postfix_sp_start, next-token)` — the chain's start byte, NOT this
///      suffix's. Every suffix in `a.b.c()` shares one `lo`, which is what the hand's
///      `alloc_at(result, sp_start)` does with a `sp_start` held constant across the
///      whole `postfix_step` loop. A per-suffix `lo` would span `.c()` alone and every
///      chained expression's SrcPos would shift.
///   2. `set_postfix_base` — the accumulator IS the parse state. `fold_postfix_with_expr`
///      reads only the LAST suffix's node, so a step that skipped this would build its
///      successor onto a stale base and silently drop the intervening suffixes.
fn postfix_step_node(st: PState, node: Expr) -> ExprId {
    let rid = st.store.add_expr(node, byte_span(st.postfix_step_sp, st.cur().pos), [])
    st.set_postfix_base(rid)
    rid
}

/// `expr?` — error propagation (t-47hc.33 form 1), the hand postfix_step's
/// `if self.check(Tk.Question)` arm. No captures: the whole suffix is the token, and
/// the subject is the threaded base.
/// `expr?.field` — optional chaining WITHOUT a call (t-47hc.33 form 3). The `?.m(args)`
/// sibling builds a different node (`Expr.OptionalMethodCall`, from an arg list under
/// `it`-sugar) and is native too. `@peek(qdot_plain_field)` and `@peek(qdot_method_call)`
/// — the same same-line test read in opposite directions — keep the two apart before
/// either branch is entered.
/// `expr?.m(args)` — the optional METHOD CALL, the sibling mk_opt_chain declines.
///
/// A different NODE, not a different spelling: `?.field` keeps `Expr.OptionalChain`, while
/// this builds `Expr.OptionalMethodCall`, which has no dedicated codegen and desugars to
/// the if-let shape (`{ let $t = recv; if $t != none { $t!.m(args) } else none }`). Getting
/// the two confused would silently drop the argument list.
///
/// `it`-sugar is ON for the argument list, UNCONDITIONALLY — the hand sets
/// `allow_it_sugar = true` here rather than the plain call's `is_method || saved_it`
/// disjunction, which is why the branch carries a bare `@on(allow_it_sugar)` where the
/// call form carries `@on_if(base_field_access, allow_it_sugar)`. The receiver of a `?.`
/// call is a method receiver by construction, so the condition is already decided.
///
/// SPANNED via postfix_step_node, matching the hand's alloc_at.
export fn mk_opt_method_call(st: PState, ncap: CapVal, acap: CapVal) -> ExprId {
    postfix_step_node(st, Expr.OptionalMethodCall(st.postfix_step_base, capval_tok_text(ncap), capval_to_node_list(acap)))
}

export fn mk_opt_chain(st: PState, ncap: CapVal) -> ExprId {
    postfix_step_node(st, Expr.OptionalChain(st.postfix_step_base, capval_tok_text(ncap)))
}

/// `expr.0` — tuple index (t-47hc.33 form 4). The hand takes the NUMBER lexeme and
/// `int()`s it, so a float-shaped `.0.1` lexes as one NUMBER and would differ; the
/// grammar terminal is the same NUMBER kind, so the same lexeme reaches `int` here.
export fn mk_tuple_index(st: PState, tcap: CapVal) -> ExprId {
    postfix_step_node(st, Expr.TupleIndex(st.postfix_step_base, int(capval_tok_text(tcap))))
}

/// `expr.field` — plain field access (t-47hc.33 form 4). The ENUM-CONSTRUCTOR reading of
/// the same syntax (`Type.Variant(args)`, when the base is a PascalCase ident and a `(`
/// follows) builds a different node from an argument list, and stays with the `@hand`
/// tail; `@peek(dot_plain_field)` keeps the two apart before the branch is entered.
export fn mk_field_access(st: PState, ncap: CapVal) -> ExprId {
    postfix_step_node(st, Expr.FieldAccess(st.postfix_step_base, capval_tok_text(ncap)))
}

/// `Type.Variant(args)` — the ENUM-CTOR reading of `.` (t-47hc.33 form 6), the sibling
/// the `.field` branch above declines whenever `dot_plain_field` sees a `(` after a
/// type-shaped base.
///
/// The base is NOT a child here: `Expr.EnumCtor` carries the type NAME as a string, so
/// the receiver is consumed into `enum_type` and the node is a leaf whose only edges are
/// its argument ids. That is why the whole reading has to be one branch — a `.field`
/// step followed by a call step would build `Call(FieldAccess(Type, Variant), args)`,
/// a method call on a type, which is a different node and a different program.
///
/// UNLIKE mk_generic_call_suffix, this DOES use postfix_step_node: the hand `alloc_at`s
/// the ctor with the chain's `[base-start, next-token)` span, where the generic call is
/// `alloc_leaf`-interned and span-free. Same family, opposite allocation — matching each
/// one to its hand arm is the whole job.
///
/// The name reads off the frozen step base, mirroring the hand's match on `result`:
/// a bare `Ident` contributes its own text, a `QualifiedIdent` its full `::` path (the
/// renderer emits resolved ctors that way, and the LAST segment is what
/// `base_upper_ident` gated on). Anything else cannot reach here — the branch's
/// `@when(base_upper_ident)` already rejected it — so an empty name would be a grammar
/// bug, and an empty `enum_type` is exactly the untyped `.Variant` primary's encoding.
export fn mk_enum_ctor_suffix(st: PState, ncap: CapVal, acap: CapVal) -> ExprId {
    let type_name = match st.store.exprs.get(st.postfix_step_base) {
        .Ident(n) -> n
        .QualifiedIdent(n) -> n
        _ -> ""
    }
    postfix_step_node(st, Expr.EnumCtor(type_name, capval_tok_text(ncap), capval_to_node_list(acap)))
}

/// `expr[i]` / `expr[a..b]` (t-47hc.33 form 5) — the FIRST form that recurses into
/// `expression`, which is what made `snap_postfix_step` necessary: the receiver is the
/// chain base as of this step's ENTRY, not whatever the nested index expression left in
/// the live accumulator.
export fn mk_index_suffix(st: PState, icap: CapVal, tcap: CapVal) -> ExprId {
    let i = capval_to_expr(st, icap)
    if capval_present(tcap) {
        return postfix_step_node(st, Expr.Slice(st.postfix_step_base, i, capval_to_expr(st, tcap)))
    }
    postfix_step_node(st, Expr.Index(st.postfix_step_base, i))
}

/// The ABSENT half of an optional tail, spelled explicitly: a branch with no build
/// returns its last item's value (here the `]` token), which `capval_present` would read
/// as PRESENT, so `[i]` and `[a..b]` could not be told apart by the thing that decides.
export fn mk_none_cap(st: PState) -> CapVal {
    CapVal.Nil
}

/// ONE call argument, reproducing parse_arg_list_ids_inner's `it` sugar: under
/// `allow_it_sugar` an argument that MENTIONS `it` becomes `(it) -> arg`, so
/// `xs.map(it * 2)` means `xs.map((it) -> it * 2)`. An argument that is already a lambda
/// is left alone — wrapping it would double-bind.
export fn mk_call_arg(st: PState, ecap: CapVal) -> ExprId {
    let id = capval_to_expr(st, ecap)
    if st.modes.allow_it_sugar == 0 { return id }
    match st.store.exprs.get(id) {
        .Lambda(_, _) -> id
        _ -> {
            if expr_contains_it(st.store, st.store.exprs.get(id)) {
                return st.store.intern_expr_leaf(wrap_in_it_lambda(id))
            }
            id
        }
    }
}

/// `expr(args)`. The receiver is the chain base as of this step's ENTRY, not the live
/// accumulator — the argument list recurses into `expression` and runs its own chain.
export fn mk_call_suffix(st: PState, acap: CapVal) -> ExprId {
    postfix_step_node(st, Expr.Call(st.postfix_step_base, capval_to_node_list(acap)))
}

/// `f<T, U>(args)` — the explicit-type-argument call.
///
/// NOT `postfix_step_node`, which every sibling suffix uses. try_parse_generic_call ends
/// in `alloc_leaf` (→ `intern_expr_leaf`), so the GenericCall row is INTERNED and carries
/// NO byte span, while `postfix_step_node` would `add_expr` a freshly spanned row. The
/// difference is observable: an interned row is shared by structural identity and a
/// spanned one is not, and the span feeds every diagnostic anchored on this node. Chain
/// threading still has to happen by hand, hence the explicit `set_postfix_base`.
///
/// The type arguments arrive as TypeExprs and are lowered through the SHARED
/// type_expr_to_vtype, exactly as parse_type_name_list does — so `id<List<int>>(x)` yields
/// `List(Int)` rather than a bare `List` with the `<int>` orphaned. Taking `List<TypeExpr>`
/// rather than a CapVal follows MkNamed: a repeated type capture is already a
/// `List<TypeExpr>` in the generated parser, so only the interpreter needs a conversion.
export fn mk_generic_call_suffix(st: PState, targs: List<TypeExpr>, acap: CapVal) -> ExprId {
    mut vts: List<ValueType> = []
    for te in targs { vts.push(type_expr_to_vtype(te)) }
    let rid = st.store.intern_expr_leaf(
        Expr.GenericCall(st.postfix_step_base, vts, capval_to_node_list(acap)))
    st.set_postfix_base(rid)
    rid
}

/// `expr!` — force-unwrap. A no-op pass-through at runtime (nullability is not tracked in
/// the value tag), encoded as `Call(Ident($force_unwrap), [subject])` with a FRESH interned
/// callee leaf, exactly as the hand builds it.
///
/// The hand runs `!` as a LOOP and then FALLS THROUGH to the `?`/`catch`/`.` dispatch in
/// the SAME step, without re-testing the entry guard — so `x!?` is one hand step. This
/// branch is a single step instead, and the chain loop re-enters for whatever follows.
/// That is equivalent on one line (the re-entry guard measures same-line against the `!`
/// just consumed, which passes) and `x!!` simply becomes two steps building the same two
/// nodes. It is NOT equivalent when the follower sits on the next line — `x!` then a bare
/// `?` — where the hand consumes without re-testing and the re-entry declines. The `@hand`
/// tail still covers that, which is one of the reasons it cannot be deleted yet.
export fn mk_force_unwrap(st: PState) -> ExprId {
    let callee = st.store.intern_expr_leaf(Expr.Ident(FORCE_UNWRAP_FN))
    postfix_step_node(st, Expr.Call(callee, [st.postfix_step_base]))
}

export fn mk_try_suffix(st: PState) -> ExprId {
    postfix_step_node(st, Expr.Try(st.postfix_step_base))
}

/// `expr catch { … }` / `expr catch (e) { … }` (t-47hc.33 form 2, spec Axis 12.5-12.6).
///
/// Three details the hand arm carries that are easy to lose:
///   - The line/col stamped into the node are the `catch` KEYWORD's, captured before
///     anything is consumed. They come off the captured token's byte offset here, which
///     is the same position through the shared LineIndex.
///   - The handler `Expr.Block` is INTERNED (`alloc_leaf` → `intern_expr_leaf`), not
///     `add_expr`'d. `mk_expr_block` would allocate a fresh spanned row instead, so the
///     handler cannot be routed through the `block_expr` rule.
///   - An ABSENT `(e)` binding is the empty string, which is what `capval_tok_text`
///     yields for a `Nil` capture.
export fn mk_catch_suffix(st: PState, ccap: CapVal, bcap: CapVal, bodycap: CapVal) -> ExprId {
    let lc = st.store.lines.to_linecol(capval_tok_pos(ccap))
    let handler_id = st.store.intern_expr_leaf(Expr.Block(capval_to_stmt_list(bodycap)))
    postfix_step_node(st, Expr.Catch(st.postfix_step_base, capval_tok_text(bcap), handler_id, lc.line, lc.col))
}

/// A scalar token capture's SOURCE BYTE OFFSET — the anchor for a build that needs the
/// keyword's own position rather than the sequence's. Non-token captures answer 0, the
/// start of file, which `to_linecol` maps to 1:1 (a build that reaches this arm has a
/// grammar bug, and a wild offset would be worse than a deterministic one).
export fn capval_tok_pos(v: CapVal) -> int {
    match v {
        .Tok(t) -> t.pos
        _ -> 0
    }
}

/// Rebuild a partial `Expr.With(_, overrides)` with `recv` as the receiver, spanned
/// `[sp_start, <this suffix's end byte>)` — the suffix's own `.hi`, which parse_with_
/// suffix set to the byte past its `}` (== the hand with-loop's `self.current_start`
/// at its `alloc_at`). A non-With suffix (never produced) passes `recv` through.
fn rebind_with(st: PState, sp_start: int, recv: ExprId, suffix: ExprId) -> ExprId {
    match st.store.exprs.get(suffix) {
        .With(_, overrides) -> st.store.add_expr(Expr.With(recv, overrides), byte_span(sp_start, st.store.exprs.span_of(suffix).hi), [])
        _ -> recv
    }
}

/// True iff any arg is the `_` pipe placeholder — mirrors mod.av's
/// pipe_args_has_placeholder over the shared store.
fn pipe_has_placeholder(st: PState, args: List<ExprId>) -> bool {
    for a in args {
        match st.store.exprs.get(a) {
            .Ident(n) -> if n == "_" { return true }
            _ -> {}
        }
    }
    false
}

/// Replace the first `_` placeholder(s) with the piped value — mirrors mod.av's
/// pipe_replace_placeholder.
fn pipe_replace_placeholder(st: PState, args: List<ExprId>, repl: ExprId) -> List<ExprId> {
    mut out: List<ExprId> = []
    for a in args {
        let is_ph = match st.store.exprs.get(a) {
            .Ident(n) -> n == "_"
            _ -> false
        }
        if is_ph { out.push(repl) } else { out.push(a) }
    }
    out
}

/// Left-fold `l ( "??" r )*` into a left-associative `Expr.NullCoalesce` chain
/// (`a ?? b ?? c` = `(a ?? b) ?? c`) — the hand parser's parse_null_coalesce
/// shape. Sibling of fold_binary_expr / fold_logical_expr.
export fn fold_nullish_expr(st: PState, sp_start: int, lcap: CapVal, opcap: CapVal, rcap: CapVal) -> ExprId {
    mut acc = capval_to_expr(st, lcap)
    let ops = capval_toks(opcap)
    let rs = capval_nodes(rcap)
    let m = if ops.length < rs.length { ops.length } else { rs.length }
    mut i = 0
    while i < m {
        // [sp_start, next-token) per the hand parse_null_coalesce (mod.av:1549):
        // hi after rs[i] is the next `??`'s byte, or st.cur().pos for the last.
        let hi = if i + 1 < m { ops[i + 1].pos } else { st.cur().pos }
        acc = st.store.add_expr(Expr.NullCoalesce(acc, rs[i]), byte_span(sp_start, hi), [])
        i = i + 1
    }
    acc
}

/// Left-fold `l ( op r )*` into a left-associative `Expr.Binary` chain.
/// With no operators, `l` passes through unchanged.
export fn fold_binary_expr(st: PState, lcap: CapVal, opcap: CapVal, rcap: CapVal) -> ExprId {
    mut acc = capval_to_expr(st, lcap)
    let ops = capval_toks(opcap)
    let rs = capval_nodes(rcap)
    let m = if ops.length < rs.length { ops.length } else { rs.length }
    mut i = 0
    while i < m {
        acc = st.store.exprs.add_leaf(Expr.Binary(acc, binop_of(ops[i].text), rs[i]))
        i = i + 1
    }
    acc
}

export fn unary_expr(st: PState, opcap: CapVal, opndcap: CapVal) -> ExprId {
    let operand = capval_to_expr(st, opndcap)
    // Stamp the SAME [op-start, next-token) byte span the hand parse_unary stamps
    // via alloc_at(Expr.Unary, sp_start) (mod.av:1747) — sp_start there is the op
    // token's start (self.current_start captured at parse_unary entry), which IS
    // the op capture's Token.pos here; st.cur().pos is the next-unconsumed byte
    // (== hand's self.current_start at the alloc). Mirrors mk_binary (add_expr with
    // an empty-edges span) so a grammar-owned prefix Unary is byte-identical to the
    // hand-parsed one, not span-free.
    match opcap {
        .Tok(t) -> st.store.add_expr(Expr.Unary(unop_of(t.text), operand), byte_span(t.pos, st.cur().pos), [])
        _ -> st.store.exprs.add_leaf(Expr.Unary(unop_of(capval_tok_text(opcap)), operand))
    }
}

export fn capval_toks(v: CapVal) -> List<Token> {
    match v {
        .Toks(ts) -> ts
        _ -> []
    }
}

/// A capture as a token list, single OR many: `.Toks` for ≥2, a scalar `.Tok`
/// for exactly 1 (mk_use's dot-path segments and import names, where a
/// one-segment `use @std {…}` captures a single `.Tok`), `Nil`/other → empty.
/// Distinct from capval_toks (which only unwraps the ≥2 `.Toks`, for the
/// always-repeated expr-fold operator accumulator).
export fn capval_tok_list(v: CapVal) -> List<Token> {
    match v {
        .Toks(ts) -> ts
        .Tok(t) -> [t]
        _ -> []
    }
}

export fn capval_nodes(v: CapVal) -> List<ExprId> {
    match v {
        .Nodes(ns) -> ns
        _ -> []
    }
}

export fn capval_tok_text(v: CapVal) -> string {
    match v {
        .Tok(t) -> t.text
        // A dotted type path `A.B.C` — an associated-type projection
        // (`Self.Item`) or a module-qualified name (`core.ast.BinOp`) — captures
        // its segments into ONE repeated `.Toks` label (`tn:IDENT ( "." tn:IDENT
        // )*`); join them with `.` to reconstruct the flat dotted name the hand
        // parser's parse_type_atom folds into `Named("A.B.C")`. This arm is a
        // pure EXTENSION of the previous `_ -> ""`: no other caller passes a
        // `.Toks` here (every other repeated capture reads through the `_list`
        // accessors), and a `.Toks` used to collapse to "" — so nothing that
        // works today changes.
        .Toks(ts) -> {
            mut out = ""
            mut i = 0
            for t in ts {
                if i > 0 { out = out + "." }
                out = out + t.text
                i = i + 1
            }
            out
        }
        _ -> ""
    }
}

/// The emitted Pratt loop's ONE build step (ps3t.6.7 Step G, slice 1): fold a
/// left operand, an operator token's text, and a right operand into an
/// `Expr.Binary`, mapping the operator via the shared `binop_of` — the exact
/// node the RD-ladder fold (`fold_binary_expr`) and the hand `parse_binary_pratt`
/// build. Exported so the GENERATED expression parser can collapse the 7 chained
/// fold rules (bitor→…→factor) into one precedence-climbing loop instead of a
/// 7-frame descent, without importing `BinOp`/`Expr` into the generated module.
export fn mk_binary(st: PState, sp_start: int, lhs: ExprId, op_text: string, rhs: ExprId) -> ExprId {
    // Stamp the SAME [start, next-token) byte span the hand `parse_binary_pratt`
    // stamps via `alloc_at` (mod.av:1674) — `sp_start` is the byte the Pratt loop
    // captured at ITS entry (leftmost operand's first token, reused for every
    // left-assoc fold), and `st.cur().pos` is the next-unconsumed token's byte
    // (== the hand parser's `self.current_start`). §14.2's bare-compound-span
    // half, for the DSL binary ladder. add_expr(node, sp, []) mirrors alloc_at's
    // empty-edges spanned alloc.
    st.store.add_expr(Expr.Binary(lhs, binop_of(op_text), rhs), byte_span(sp_start, st.cur().pos), [])
}

fn binop_of(sym: string) -> BinOp {
    if sym == "-" { return BinOp.Sub }
    if sym == "*" { return BinOp.Mul }
    if sym == "/" { return BinOp.Div }
    if sym == "%" { return BinOp.Mod }
    if sym == "==" { return BinOp.Eq }
    if sym == "!=" { return BinOp.Ne }
    if sym == "<" { return BinOp.Lt }
    if sym == "<=" { return BinOp.Le }
    if sym == ">" { return BinOp.Gt }
    if sym == ">=" { return BinOp.Ge }
    if sym == "&" { return BinOp.BitAnd }
    if sym == "|" { return BinOp.BitOr }
    if sym == "^" { return BinOp.BitXor }
    if sym == "<<" { return BinOp.Shl }
    if sym == ">>" { return BinOp.Shr }
    BinOp.Add
}

fn unop_of(sym: string) -> UnOp {
    if sym == "!" { return UnOp.Not }
    if sym == "not" { return UnOp.Not }
    if sym == "~" { return UnOp.BitNot }
    UnOp.Neg
}

// ── Debug rendering (canonical prefix form for assertions) ──

/// Render an Expr subtree as an unambiguous prefix form, e.g.
/// `1 + 2 * 3` → `(+ 1 (* 2 3))`, `!x` → `(not x)`. Used by tests to
/// assert precedence + associativity crisply.
export fn dump_expr(store: NodeStore, id: ExprId) -> string {
    match store.exprs.get(id) {
        .Number(v) -> v
        .String(v) -> v
        .Bool(v) -> v
        .None -> "none"
        .Ident(n) -> n
        .Unary(op, r) -> "(${unop_sym(op)} ${dump_expr(store, r)})"
        .Binary(l, op, r) -> "(${binop_sym(op)} ${dump_expr(store, l)} ${dump_expr(store, r)})"
        .Logical(l, op, r) -> "(${logicop_sym(op)} ${dump_expr(store, l)} ${dump_expr(store, r)})"
        .FieldAccess(obj, field) -> "(. ${dump_expr(store, obj)} ${field})"
        .Index(obj, idx) -> "([] ${dump_expr(store, obj)} ${dump_expr(store, idx)})"
        .Call(callee, cargs) -> "(call ${dump_expr(store, callee)}${dump_args(store, cargs)})"
        // The turbofish call. Type args are rendered through the SHARED
        // render_type_name_list, so a dump difference reflects a real ValueType
        // difference and not a second spelling of one.
        .GenericCall(callee, targs, cargs) ->
            "(gcall ${dump_expr(store, callee)}<${render_type_name_list(targs)}>${dump_args(store, cargs)})"
        // The enum constructor. The type name is a STRING on the node, not a child, so it
        // is printed rather than recursed into — and printing it is the point: an empty
        // enum_type (the untyped `.Variant` primary) must not compare equal to a typed
        // `Type.Variant`, which is exactly the distinction the postfix reading carries.
        .EnumCtor(type_name, variant, cargs) ->
            "(ctor ${type_name}.${variant}${dump_args(store, cargs)})"
        // Render Grouping EXPLICITLY (never unwrap) so the dump is a
        // lossless view of the tree — `((1))` must not collapse to `1`.
        // Both `?.` readings. NEITHER was modelled before, so the existing `?.field`
        // form compared `<unmodelled-variant>` against itself and asserted nothing — the
        // same hole closed for GenericCall and EnumCtor. They must render DIFFERENTLY:
        // dropping an argument list turns one into the other.
        .OptionalChain(obj, field) -> "(?. ${dump_expr(store, obj)} ${field})"
        .OptionalMethodCall(obj, method, cargs) ->
            "(?.call ${dump_expr(store, obj)} ${method}${dump_args(store, cargs)})"
        .Grouping(e) -> "(group ${dump_expr(store, e)})"
        .Error -> "<error>"
        .Missing -> "<missing>"
        // A variant the dump doesn't model explicitly. Kept as a loud,
        // greppable marker; the equivalence test asserts it never appears
        // so an unmodelled variant can't silently "agree".
        _ -> "<unmodelled-variant>"
    }
}

fn dump_args(store: NodeStore, cargs: List<ExprId>) -> string {
    mut out = ""
    for a in cargs {
        out = out + " " + dump_expr(store, a)
    }
    out
}

fn binop_sym(op: BinOp) -> string {
    match op {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .Mod -> "%"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Le -> "<="
        .Gt -> ">"
        .Ge -> ">="
        .BitAnd -> "&"
        .BitOr -> "|"
        .BitXor -> "^"
        .Shl -> "<<"
        .Shr -> ">>"
    }
}

fn unop_sym(op: UnOp) -> string {
    match op {
        .Neg -> "neg"
        .Not -> "not"
        .BitNot -> "bitnot"
    }
}

fn logicop_sym(op: LogicOp) -> string {
    match op {
        .And -> "&&"
        .Or -> "||"
    }
}
