// WHY: manifest validation used to answer with a `""`-sentinel STRING holding
// the FIRST defect, and `register_lang` handed that to `grammar_startup_fail`,
// which `exit(99)`s. With 70 features that means: fix one manifest, rebuild the
// compiler, discover the next. Three broken features cost three full cycles.
//
// It answers with DATA now — `ManifestDefect` carries the rule, the build and
// the arity as FIELDS rather than interpolated prose, `FeatureDefect` pairs one
// with its owning feature, and `manifest_defects_for` collects every defect
// instead of returning at the first. `init_features` reports the lot in one go.
//
// These specs drive the value-level core directly (toy grams + toy manifests),
// which is what lets them exercise rejection paths a test shard cannot reach by
// instantiating the real cross-package component.

use @std.avrac.features.{manifest_defects_for, render_manifest_defect, render_manifest_defects, FeatureDefect, ManifestDefect}
use @std.avrac.features.grammar.{parse_grammar, grammar_checked, BuilderBind, bind_row, PState, CapVal, Grammar, BuildKind}
use @std.avrac.core.{BuildName, FeatureName}

fn toy_gram(src: string) -> Grammar { grammar_checked(parse_grammar(src)) }

fn noop_abi(st: PState, vals: List<CapVal>) -> CapVal { CapVal.Nil }

/// A manifest row that no rule references — the orphan case.
fn orphan_rows() -> List<BuilderBind> {
    [bind_row(BuildName("MkNeverReferenced"), BuildKind.Expr, 1, false, "noop_abi", noop_abi)]
}

spec "manifest defects are DATA, not a first-error string" {
    given "a manifest with an orphan builder" {
        then "the defect names the build and its arity as fields" {
            let ds = manifest_defects_for(FeatureName("toy"), toy_gram("r = \"a\" -> MkNone()"), orphan_rows())
            // The orphan is reported, and the RENDERED form still reads well.
            ds.length >= 1 && render_manifest_defect(ds[0]).contains("MkNeverReferenced")
        }
        then "the defect carries its owning feature, so a report can group by it" {
            let ds = manifest_defects_for(FeatureName("toy"), toy_gram("r = \"a\" -> MkNone()"), orphan_rows())
            ds[0].feature == FeatureName("toy")
        }
    }
    given "a coherent manifest" {
        then "no defects — the check is not vacuous in the passing direction either" {
            manifest_defects_for(FeatureName("ok"), toy_gram("r = \"a\" -> MkNone()"), []).length == 0
        }
    }
}

spec "the report aggregates ACROSS features rather than stopping at the first" {
    then "two broken features both appear, and the count names how many" {
        // The whole point of the change: one run, every broken feature.
        mut all: List<FeatureDefect> = []
        for d in manifest_defects_for(FeatureName("alpha"), toy_gram("r = \"a\" -> MkNone()"), orphan_rows()) { all.push(d) }
        for d in manifest_defects_for(FeatureName("beta"), toy_gram("r = \"b\" -> MkNone()"), orphan_rows()) { all.push(d) }
        let out = render_manifest_defects(all)
        out.contains("alpha") && out.contains("beta") && out.contains("2 feature(s)")
    }
    then "an empty defect list renders empty — no report when nothing is wrong" {
        let empty: List<FeatureDefect> = []
        render_manifest_defects(empty) == ""
    }
}
