// ps3t.6.5.10 — the gnarly-5% catalogue, entry 6: the `~` PREFIX (splice vs
// bitnot), and the first EXPRESSION-level REAL @hand delegation.
//
// The `~` token is overloaded on a parser MODE the grammar can't carry: inside
// a `quote { … }` body (quote_depth > 0) a leading `~` is `Expr.Splice`
// (greedy — `~f(x)` splices the whole call), everywhere else it is bitwise-NOT
// (`Expr.Unary(BitNot, …)`). A stateless token-grammar has no quote_depth
// counter, so it can't decide which `~` it's looking at.
//
// The bitnot side is already PURE grammar (parser_equivalence_test covers
// `~5` / `~a + 2` / `~~3` as `Unary`). The gnarly side is the SPLICE, reachable
// only inside a quote — and `quote { … }` is itself parser-mode-stateful
// (`parse_quote` bumps quote_depth). So the route is to delegate the whole
// `quote` construct to the hand parser via an EXPRESSION-level @hand:
// run_hand_expr — the ExprId sibling of run_hand_stmt. It shares the DSL store, delegates to
// `parse_quote`, and the inner `~`→Splice falls out by construction (the
// delegated parse tracks quote_depth). The `@hand` delegation now spans all
// remaining live expression/statement node kinds.
//
// Oracle: run the DSL expression parser (with `@hand(quote_expr)` as a primary
// alternative and a pure `~`/`-`/`!` unary rule) AND the hand parser
// (parse_expression_native_probe), and assert identical Exprs via the TOTAL
// render_expr_id (which models Quote/Splice/Block — dump_expr does not).
use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr}
use @std.avrac.parse.{parse_expression_native_probe}
use @std.avrac.core.{render_expr_id}

fn expr_grammar_src() -> string {
    "grammar Expr {\n" +
    "  expression = l:unary ( op:(\"+\") r:unary )* -> fold_binary(l, op, r)\n" +
    // `~` splits on quote depth: bitwise-NOT outside a quote, splice inside one.
    "  unary      = op:(\"!\" | \"-\") operand:unary -> Unary(op, operand)\n" +
    "             | @when(at_quote_top) op:(\"~\") operand:unary -> Unary(op, operand)\n" +
    "             | @when(in_quote_body) \"~\" t:unary -> MkSplice(t)\n" +
    "             | postfix\n" +
    "  postfix    = base:primary ( s:suffix )* -> fold_postfix(base, s)\n" +
    "  suffix     = \".\" name:IDENT -> field_suffix(name)\n" +
    "             | \"(\" ( a:expression ( \",\" a:expression )* )? \")\" -> call_suffix(a)\n" +
    "  primary    = quote_expr | NUMBER | IDENT\n" +
    "  quote_expr = \"quote\" ( qk:(\"stmt\" | \"stmts\" | \"decl\") )? @bump(quote_depth) qb:quote_body -> MkQuote(qk, qb)\n" +
    "  quote_body = \"{\" ( qs:qstatement )* \"}\" -> MkExprBlock(qs)\n" +
    "  qstatement = let_stmt | qexpr_stmt\n" +
    "  let_stmt   = @try \"let\" @cut @require n:IDENT @require \"=\" @onfail(bail) init:expression -> MkLetBinding(m, n, ty, init, e, tmp)\n" +
    "  qexpr_stmt = qe:expression -> ExprStmt(qe)\n" +
    "}"
}

fn dsl_expr(src: string) -> string {
    let gp = parse_grammar(expr_grammar_src())
    let r = run_grammar_expr(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_expr_id(r.store, r.root)
}

fn hand_expr(src: string) -> string {
    let probe = parse_expression_native_probe(src)
    if probe.had_error != 0 { return "<parse error>" }
    render_expr_id(probe.store, probe.root)
}

fn agree(src: string) -> bool { dsl_expr(src) == hand_expr(src) }

spec "grammar-DSL: ~ splice-vs-bitnot == production parser (ps3t.6.5.10)" {
    given "`~` OUTSIDE a quote is bitwise-NOT (pure grammar, no false splice)" {
        then "the bitnot / neg / not prefixes agree with the hand parser" {
            agree("~5") &&
            agree("~x") &&
            agree("~a") &&
            agree("-x") &&
            agree("!y") &&
            // canonical: an outside-quote `~` renders as a bitnot unary, NOT a splice.
            dsl_expr("~x") == "(~ x)" &&
            !dsl_expr("~x").contains("splice")
        }
    }
    given "`~` INSIDE a quote body is a Splice" {
        then "the quote construct + inner splice agree with the hand parser" {
            agree("quote { ~x }") &&
            agree("quote { ~foo }") &&
            // greedy: `~f(x)` splices the WHOLE call inside the quote.
            agree("quote { ~f(x) }") &&
            agree("quote { ~a + ~b }") &&
            // an explicit quote KIND keyword (stmt) — the splice fires the same.
            agree("quote stmt { ~x }") &&
            // a splice buried in a binding initializer inside the quote body.
            agree("quote { let a = ~b }") &&
            // canonical: the delegated parse REALLY built a Splice (not swallowed
            // to an error / bitnot) — reaching past the render.
            dsl_expr("quote { ~x }").contains("(splice ") &&
            !dsl_expr("quote { ~x }").contains("(~ ")
        }
    }
    given "a quote WITHOUT a splice still routes and agrees (no false splice)" {
        then "a plain quote body carries no splice" {
            agree("quote { x }") &&
            agree("quote { 1 + 2 }") &&
            !dsl_expr("quote { x }").contains("splice")
        }
    }
    given "`quote_expr` composes with the pure grammar around it" {
        then "the quote nests as one primary among the pure unary/postfix rules" {
            // A splice inside a quote differs from a bitnot outside it — the two
            // meanings of `~` are routed to the two different builders.
            dsl_expr("quote { ~x }") != dsl_expr("~x") &&
            // bare atoms and outside-quote unary are unchanged by the new route.
            agree("42") &&
            agree("~~3") &&
            agree("!~-1")
        }
    }
}
