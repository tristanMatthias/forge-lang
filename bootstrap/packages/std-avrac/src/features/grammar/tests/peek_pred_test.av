// WHY: t-47hc (paren_expr flip prep) — the `@peek(cond)` LOOKAHEAD predicate, the
// token-stream sibling of `@when(flag)`. Where `@when` gates a branch on an ExprModes
// flag, `@peek` gates it on an upcoming-token test (executor.lookahead_ok). This is how
// a grammar expresses the hand parser's fixed-lookahead disambiguations — specifically
// parse_paren_expr's `peek_after_ident_is_colon()`, which distinguishes a typed lambda
// `(x: int) -> …` from a grouping/tuple by peeking past the first IDENT for a `:`.
//
// Production also uses `@peek(stmt_block)` to distinguish a standalone block from a
// string-keyed map expression at statement position. Executor (branch_pred_ok →
// lookahead_ok) and emit
// (peek_guard emits the SAME lookahead_ok call) route through one shared function, so
// the interpreter and the generated parser can't disagree — the lockstep discipline
// `@when` has via modes_flag. This pins: parse + validation, interpreter branch-gating,
// and the emitted guard.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr, emit_rule_fn, new_pstate, lookahead_ok, peek_cond_supported}
// The RAW-SOURCE lookahead cores (t-47hc.5.1 slice B1) — folded in here rather than
// standing up their own test file, because the per-file runner shards per FILE and
// rc-strict runs at jobs=1, so every extra file lands on the wall clock 1:1.
use @std.avrac.features.grammar.{src_skip_ws, src_next_nonws_is_quote, src_next_nonws_is_digit, src_next_nonws_starts_with, src_next_nonws_is_single_eq, src_next_nonws_is_lbrace, src_next_nonws_is_value_word, src_at_empty_call_block}
use @std.avrac.core.{render_expr_id}

fn run_render(grammar_src: string, input: string) -> string {
    let gp = parse_grammar(grammar_src)
    let r = run_grammar_expr(gp.grammar, input)
    render_expr_id(r.store, r.root)
}

fn emit_rule(grammar_src: string, rule: string) -> string {
    let gp = parse_grammar(grammar_src)
    for gr in gp.grammar.rules {
        if gr.name == rule { return emit_rule_fn(gp.grammar, gr) }
    }
    ""
}

fn perr(gsrc: string) -> string { parse_grammar(gsrc).error }

// Two IDENT-led branches; branch 1 is gated by `@peek(ident_colon)`. On `foo: bar` the
// lookahead holds → branch 1 fires (consumes `foo : bar`, wraps foo in Grouping); on a
// bare `foo` it fails → branch 1 is skipped and branch 2 (bare ident) fires. The distinct
// results (`(group foo)` vs `foo`) prove @peek gates branch selection, not just FIRST.
fn peek_g() -> string { "r = @peek(ident_colon) x:@hand(ident) \":\" @hand(ident) -> Grouping(x)\n  | x:@hand(ident) -> x" }

spec "t-47hc: @peek(ident_colon) — parse-time acceptance + validation" {
    then "a valid @peek is accepted" {
        perr(peek_g()) == ""
    }
    then "an unknown cond is a HARD error (not a silent dead guard)" {
        perr("r = @peek(nonsense) x:@hand(ident) -> x") != ""
    }
    then "the parentheses are required — `@peek cond` without `(` fails" {
        perr("r = @peek ident_colon x:@hand(ident) -> x") != ""
    }
    then "peek_cond_supported accepts the known conditions, rejects a typo and empty" {
        peek_cond_supported("ident_colon") && peek_cond_supported("stmt_block") &&
        peek_cond_supported("for_destructure") &&
        !peek_cond_supported("ident_coln") && !peek_cond_supported("")
    }
}

spec "t-47hc: @peek(for_destructure) — loop binding disambiguation" {
    then "tuple bindings select the destructure branch" {
        mut tuple = new_pstate("for (a, b) in pairs { }")
        lookahead_ok("for_destructure", tuple)
    }
    then "ordinary identifier bindings skip it" {
        mut plain = new_pstate("for item in items { }")
        !lookahead_ok("for_destructure", plain)
    }
    then "comma-ident distinguishes a separator from a trailing comma" {
        mut separator = new_pstate(", b")
        mut trailing = new_pstate(", )")
        lookahead_ok("comma_ident", separator) && !lookahead_ok("comma_ident", trailing)
    }
    then "double-colon requires adjacent package separators" {
        mut adjacent = new_pstate("::Type")
        mut spaced = new_pstate(": : Type")
        lookahead_ok("double_colon", adjacent) && !lookahead_ok("double_colon", spaced) &&
        peek_cond_supported("double_colon")
    }
}

spec "t-47hc: @peek(stmt_block) — statement brace disambiguation" {
    then "ordinary and empty braces are blocks" {
        mut ordinary = new_pstate("{ value }")
        mut empty = new_pstate("{}")
        lookahead_ok("stmt_block", ordinary) && lookahead_ok("stmt_block", empty)
    }
    then "a string-keyed brace is a map expression, not a block" {
        mut keyed = new_pstate("{ \"key\": value }")
        !lookahead_ok("stmt_block", keyed)
    }
}

spec "t-47hc: @peek(ident_colon) — lookahead_ok token test (shared eval)" {
    then "lookahead_ok holds when current is IDENT and next is `:`" {
        mut st = new_pstate("foo : bar")
        lookahead_ok("ident_colon", st)
    }
    then "lookahead_ok fails on a bare IDENT (no following `:`)" {
        mut st = new_pstate("foo")
        !lookahead_ok("ident_colon", st)
    }
    then "lookahead_ok fails when current is not an IDENT" {
        mut st = new_pstate("123 : bar")
        !lookahead_ok("ident_colon", st)
    }
}

spec "t-47hc: @peek(ident_colon) — interpreter gates branch selection" {
    then "the @peek branch fires when the lookahead holds (`foo: bar` -> Grouping)" {
        run_render(peek_g(), "foo : bar") == "(group foo)"
    }
    then "the @peek branch is skipped when the lookahead fails (`foo` -> bare ident)" {
        run_render(peek_g(), "foo") == "foo"
    }
}

spec "t-47hc: @peek(ident_colon) — emit folds the lookahead guard" {
    then "the emitted branch guard calls the shared lookahead_ok (emit↔exec lockstep)" {
        emit_rule(peek_g(), "r").contains("lookahead_ok(\"ident_colon\", st)")
    }
    then "WITHOUT @peek, no lookahead_ok is emitted — byte-identical for grammars not using it" {
        !emit_rule("r = x:@hand(ident) -> x", "r").contains("lookahead_ok(")
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// WHY: t-47hc.5.1 slice B1 — pin the RAW-SOURCE lookahead cores that the
// component config-pair disambiguation runs on.
//
// These cores (features/grammar/chars.av) were lifted verbatim out of
// `impl Parser` so the hand parser and the grammar engine's `@peek` conds can
// share ONE implementation when the keyword-prefixed instantiation goes native
// (slice B2). The whole point of sharing them is that four of their behaviours
// are NOT what a token-level re-derivation would produce — and each is
// load-bearing for how `component C inst { … }` parses today:
//
//   1. comments are NOT skipped (the scan is whitespace-only)
//   2. the keyword test is a PREFIX match, not a word-boundary one
//   3. the number test reads the first BYTE, so `-5` is not a number
//   4. the string test wants a literal `"`, so `r"s"` is not a string
//
// A future tidy-up that "fixes" any of these would silently change how real
// component blocks parse. These specs are the tripwire: they assert the
// surprising behaviour ON PURPOSE. If one goes red, the core drifted from the
// hand parser it was extracted from — do not update the expectation without
// changing `parse_comp_config_pairs` in the same breath.
// ─────────────────────────────────────────────────────────────────────────────

// Each helper mirrors the hand's call site: the source is `key` followed by
// whatever trails it, and the scan starts one past the staged lexeme (offset 3).
/// The staged lexeme every case scans past — the `key` in `key <value>`.
///
/// A `fn` rather than the obvious `const KEY = "key"` because a module-level
/// `const` bound to a string is typed `int` at codegen, so `KEY.length` is a
/// hard error (t-8xte). Revert this to a plain `const` when that lands.
fn key() -> string { "key" }

fn is_quote(rest: string) -> bool {
    let src = key() + rest
    src_next_nonws_is_quote(src, src.length, key().length)
}

fn is_digit(rest: string) -> bool {
    let src = key() + rest
    src_next_nonws_is_digit(src, src.length, key().length)
}

fn starts_with(rest: string, word: string) -> bool {
    let src = key() + rest
    src_next_nonws_starts_with(src, src.length, key().length, word)
}

fn is_eq(rest: string) -> bool {
    let src = key() + rest
    src_next_nonws_is_single_eq(src, src.length, key().length)
}

fn is_lbrace(rest: string) -> bool {
    let src = key() + rest
    src_next_nonws_is_lbrace(src, src.length, key().length)
}

fn is_value_word(rest: string) -> bool {
    let src = key() + rest
    src_next_nonws_is_value_word(src, src.length, key().length)
}

fn empty_call_block(rest: string) -> bool {
    let src = key() + rest
    src_at_empty_call_block(src, src.length, key().length)
}

spec "t-47hc.5.1: the four divergences a token-level rewrite would lose" {
    // 1. Comments are not whitespace to these scans. A token peek never sees a
    // comment at all and would read this as a string-valued config pair.
    then "a comment before the value hides it — `key /* c */ \"v\"` is not a string" {
        !is_quote(" /* c */ \"v\"") && !is_quote(" // c\n\"v\"")
    }
    then "...and the same for a commented-out number" { !is_digit(" /* c */ 5") }

    // 2. Prefix match, not word boundary: `trueish` begins with `true`.
    then "`trueish` matches the `true` keyword test by PREFIX" { starts_with(" trueish", "true") }
    then "`falsey` likewise matches `false`" { starts_with(" falsey", "false") }
    then "a genuine prefix miss still fails" { !starts_with(" truthy", "true") }

    // 3. First BYTE, so a sign is not part of the number.
    then "`-5` is NOT a number value — the `-` byte fails the digit test" { !is_digit(" -5") }
    then "`+5` likewise" { !is_digit(" +5") }
    then "a bare `5` is" { is_digit(" 5") }

    // 4. Literal quote byte, so a raw string does not read as a string.
    then "`r\"s\"` is NOT a string value — it leads with `r`" { !is_quote(" r\"s\"") }
    then "a plain `\"s\"` is" { is_quote(" \"s\"") }
}

spec "t-47hc.5.1: whitespace handling is exactly space/tab/CR/LF" {
    then "each whitespace byte is skipped" {
        is_quote(" \"s\"") && is_quote("\t\"s\"") && is_quote("\n\"s\"") && is_quote("\r\"s\"")
    }
    then "runs of mixed whitespace are skipped" { is_quote(" \t\n\r \"s\"") }
    then "no value at all is a miss, not a crash" { !is_quote("") && !is_quote("   ") }
    then "src_skip_ws lands on the first non-space byte" {
        src_skip_ws("  x", 3, 0) == 2 && src_skip_ws("x", 1, 0) == 0
    }
    then "src_skip_ws returns the length when the tail is blank" {
        src_skip_ws("  ", 2, 0) == 2 && src_skip_ws("", 0, 0) == 0
    }
}

spec "t-47hc.5.1: `=` distinguishes assignment from comparison" {
    then "a single `=` is a config assignment" { is_eq(" = 1") && is_eq("=1") }
    then "`==` is NOT — that is a comparison" { !is_eq(" == 1") }
    then "a trailing `=` at end of source still counts" { is_eq("=") }
    then "any other byte is not" { !is_eq(" : 1") && !is_eq(" 5") }
}

spec "t-47hc.5.1: `{` marks a nested block rather than a value" {
    then "a following brace is detected across whitespace" { is_lbrace(" {") && is_lbrace("\n  {") }
    then "a non-brace is not" { !is_lbrace(" \"s\"") && !is_lbrace("") }
}

spec "t-47hc.5.1: a value word is an identifier that is not a literal keyword" {
    then "an ordinary word is a nested block name" { is_value_word(" child") && is_value_word(" _x9") }
    then "the three literal keywords are values, not block names" {
        !is_value_word(" true") && !is_value_word(" false") && !is_value_word(" null")
    }
    then "the exclusion is a WHOLE-word test, unlike the keyword prefix test above" {
        is_value_word(" trueish") && is_value_word(" nullable")
    }
    then "a non-identifier lead is not a word" {
        !is_value_word(" 9x") && !is_value_word(" \"s\"") && !is_value_word("")
    }
}

spec "t-47hc.5.1: the `ident() { … }` method shorthand" {
    then "empty parens then a block is the shorthand" {
        empty_call_block("() { }") && empty_call_block(" ( ) \n { }")
    }
    then "a call with no trailing block is NOT" { !empty_call_block("()") && !empty_call_block("() 5") }
    then "non-empty parens are NOT the shorthand" { !empty_call_block("(a) { }") }
    then "a truncated form runs off the end safely" {
        !empty_call_block("(") && !empty_call_block("()  ") && !empty_call_block("")
    }
}
