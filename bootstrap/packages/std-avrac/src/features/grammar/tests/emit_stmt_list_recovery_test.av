// t-47hc.13 — STEP 2/3 of the production control-flow flip: emit.av renders a
// statement-list-WITH-RECOVERY loop for a labeled bare-ref `*` over a STATEMENT
// rule (a block's `stmts:statement*`), the generated twin of the hand parser's
// parse_statement_list_ids (parse/mod.av:821).
//
// avra_stmt_flip_grammar() carries the `block = "{" stmts:statement* "}" -> Block`
// rule (landed #983), so emitting IT exercises emit_stmt_list_loop. This is a
// STRUCTURAL guard on the emitter — proving the loop shape is byte-identical to
// parse_statement_list_ids (loop-until-`}`/EOF, per-child SrcPos via to_linecol,
// panic-mode synchronize_stmt + positioned Stmt.Error on a failed child). It is
// DORMANT: the PRODUCTION static parser (gen_decl_parser) is emitted from
// avra_stmt_dispatch_grammar, which has NO block rule, so this changes no
// production emit (diagnose.sh --emit-gen-check stays GENPASS). The BEHAVIOURAL
// byte-identity proof lands at STEP 4 (the recovery-tree oracle over the real
// static parser once block/if/for/while mirror into the dispatch grammar).
use @std.avrac.features.grammar.{avra_stmt_flip_grammar, emit_parser_source}

fn emit_flip() -> string {
    emit_parser_source(avra_stmt_flip_grammar())
}

spec "t-47hc.13 STEP2: emit renders the statement-list-with-recovery loop for a block" {
    then "the block body loops until `}`/EOF (the hand parse_statement_list_ids stop condition)" {
        let src = emit_flip()
        // The generated parse_block collects the body — NOT the interpreter's
        // FIRST-guard loop, but a loop-until-`}` that mirrors the hand recovery loop.
        //
        // The per-item call is `parse_declaration`, not `parse_statement`, and that is
        // the FAITHFUL reading of the rule this guard names: `parse_statement_list_ids`
        // calls `self.parse_declaration()` per item. `block` used to be `statement*`,
        // which excluded every binding (`let`/`mut`/`const` live only in `declaration`)
        // and sent them to the `@hand(decl_hand)` gate — see the WHY on `block` in
        // avra_grammar.av.
        src.contains("if st.at_end() || st.cur().text == \"}\" { break }") &&
        src.contains("let __cv = parse_declaration(st)")
    }

    then "per-child SrcPos is recorded from the entry byte (the add_stmt_at twin)" {
        let src = emit_flip()
        src.contains("let __sp = st.cur().pos") &&
        src.contains("let __sid = capval_to_stmt(st, __cv)") &&
        src.contains("let __lc = st.store.lines.to_linecol(__sp)") &&
        src.contains("st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })") &&
        src.contains("stmts_list.push(__sid)")
    }

    then "a failed child triggers panic-mode resync + a positioned Stmt.Error placeholder" {
        let src = emit_flip()
        // The failure test is "did this child FAIL", not "did anything REPORT" — the hand
        // asks the first (`parse_declaration()` returning `.Err`), so a child that
        // reported and still produced a node is KEPT (t-47hc.5). `had_error` is still
        // read, separately, to carry the diagnostic out.
        src.contains("if st.had_error { __any_err = true }") &&
        src.contains("if st.abort_prop || capval_is_error_expr(st, __cv) || capval_is_error_stmt(st, __cv) {") &&
        src.contains("st.synchronize_stmt()") &&
        // forward-progress guard: a zero-width errored parse must still advance.
        src.contains("if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }") &&
        // The recovery row REUSES the error the child already produced when it produced
        // one — allocating unconditionally left an orphan in the store (see error_stmt_of).
        src.contains("let __e = error_stmt_of(st, __cv)") &&
        src.contains("st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })") &&
        src.contains("st.clear_error()")
    }

    // had_error is a SINGLE flag reused across children (the block reuses one PState),
    // so a pre-loop error (e.g. an if/for/while header condition) must NOT misclassify
    // the first body statement, and must NOT be lost. Capture `__pre_err`, clear per
    // child (fresh detection), propagate `__any_err` at loop exit via note_had_error.
    then "a pre-loop (condition) error is captured, not reused per-child, and restored" {
        let src = emit_flip()
        src.contains("let __pre_err = st.had_error") &&
        src.contains("mut __any_err = __pre_err") &&
        src.contains("if __any_err { st.note_had_error() }")
    }
}
