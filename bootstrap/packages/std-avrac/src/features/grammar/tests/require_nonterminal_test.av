// WHY: t-47hc.24 — `@require` extended from a TERMINAL to a RULE REFERENCE.
//
// The marker means "this must be here, or the enclosing rule reports and ABORTS" — the
// hand parser's `if !check(Tk.LeftBrace) { report(…); return .Err }`. It was terminal-only
// because the terminal implementation detects failure by asking whether the item REPORTED,
// and seed_parser said so out loud: "a rule reference reports its own failure".
//
// That rejection is right about the mechanism and wrong about the conclusion. A rule
// reference DOES report its own errors — which is exactly why the diag-growth test cannot
// serve it: a sub-rule whose BODY is malformed reports too, and the hand RECOVERS that
// while aborting only an ABSENT sub-rule. So the required-rule form checks the rule's
// FIRST *before* the call. Same signal the hand uses, same order.
//
// That absent-vs-malformed distinction is the load-bearing property here, and the reason
// widening the terminal path would have been wrong rather than merely incomplete. It is
// the first thing these specs pin.
//
// The single-literal-FIRST restriction is not fussiness: `@expect(tok, msg)` and
// handle_missing are keyed by TOKEN TEXT, so a required rule can only say "expected X"
// when there is exactly one X it could have started with. A disjunction has no single
// answer, and picking one would put a wrong token in a user-facing diagnostic — so it is
// a grammar-parse error instead.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr, emit_parser_source}

fn perr(src: string) -> string { parse_grammar(src).error }

fn emitted(src: string) -> string { emit_parser_source(parse_grammar(src).grammar) }

fn diags(src: string, input: string) -> int {
    run_grammar_expr(parse_grammar(src).grammar, input).diags.length
}

fn errs(src: string, input: string) -> bool {
    run_grammar_expr(parse_grammar(src).grammar, input).had_error
}

// `blk` has a single-literal FIRST (`{`), so it is a legal @require target. The trailing
// `"!"` exists to detect a RUNAWAY: if the abort does not fire, the sequence keeps going
// and reports a second, different error.
fn g_req() -> string {
    "r = \"+\" @require blk \"!\" @expect(\"{\", \"expected `{` after plus\")\n" +
    "blk = \"{\" \"}\""
}

spec "t-47hc.24: @require on a rule reference aborts when the rule is ABSENT" {
    then "the grammar is accepted — a single-literal FIRST is a legal target" {
        perr(g_req()) == ""
    }
    then "an absent sub-rule reports the @expect message" {
        // Keyed off the rule's FIRST literal `{`, so the sequence's @expect("{", …) is
        // what surfaces — the same message seam the terminal form uses.
        errs(g_req(), "+ 9")
    }
    then "and ABORTS — exactly one diagnostic, not a runaway into the next item" {
        // Without the abort the rule would carry on to `"!"` and report that too. One
        // diagnostic is the whole point of the marker.
        diags(g_req(), "+ 9") == 1
    }
    then "the emitted parser guards on the rule's FIRST and returns" {
        let src = emitted(g_req())
        src.contains("expected `{` after plus") &&
            src.contains("return CapVal.Node(st.error_node_silent())")
    }
}

spec "t-47hc.24: a MALFORMED body is not an absent rule — it must NOT abort" {
    then "the sub-rule's own error does not abort the enclosing rule" {
        // THE distinction. `{` is present, so the rule STARTED: the abort must not fire,
        // `blk` reports its own missing `}`, and the enclosing sequence continues to `!`
        // and matches it. Under a diag-growth test this would abort and swallow the `!`.
        // The hand behaves as this does — it aborts only on the absent brace.
        !errs(g_req(), "+ { } !")
    }
    then "a malformed body reports but the enclosing rule still reaches its next item" {
        // `{` present, `}` missing: blk reports. If the enclosing rule had aborted we
        // would see only that one error; reaching `!` and finding `9` adds a second.
        diags(g_req(), "+ { 9") > 1
    }
}

spec "t-47hc.24: the target must have a single-literal FIRST" {
    then "a disjunction FIRST is a grammar-parse ERROR, not a silent guess" {
        // `two` starts with `{` OR `[` — "expected X" has no single answer, so the
        // marker is rejected rather than naming one of them in a user-facing message.
        let e = perr("r = \"+\" @require two \"!\"\ntwo = \"{\" \"}\" | \"[\" \"]\"")
        e.contains("single-literal FIRST")
    }
    then "a named-terminal (KIND) FIRST is rejected too" {
        let e = perr("r = \"+\" @require nt \"!\"\nnt = IDENT")
        e.contains("single-literal FIRST")
    }
    then "the error names the offending rule" {
        perr("r = \"+\" @require two \"!\"\ntwo = \"{\" \"}\" | \"[\" \"]\"").contains("two")
    }
}

spec "t-47hc.24: the existing terminal restrictions are untouched" {
    then "a repetition still cannot carry @require" {
        perr("r = \"+\" @require blk* \"!\"\nblk = \"{\" \"}\"").contains("repetition")
    }
    then "the leading item still cannot carry it" {
        perr("r = @require blk \"!\"\nblk = \"{\" \"}\"").contains("leading item")
    }
    then "a plain terminal still works exactly as before" {
        perr("r = \"+\" @require \"-\" @expect(\"-\", \"need a minus\")") == ""
    }
}

// ── t-myz7: `@soft`, the NON-ABORTING complement ──────────────────────────────────
//
// `@require` and `@soft` are the two halves of one axis, which is why they are specced
// in one file against the SAME grammar shape: an absent sub-rule ABORTS under the first
// and is REPORTED-AND-SKIPPED under the second. Asserting them as a contrast is what
// makes these non-vacuous — a `@soft` that quietly behaved like `@require` (or like the
// error-tolerant default) would pass a test that only counted "did it report".
//
// Why the capability exists: a plain non-leading rule ref is called with its FIRST
// UNPROVEN, and the generated `parse_<rule>` opens by consuming. `parse_tparam` is the
// caught instance — `let tpn = CapVal.Tok(st.advance())` — so on `enum E< { A }` the `{`
// is bound as a type-parameter name and EATEN, and the rule then fails to find both `>`
// and the `{` it already swallowed. The hand reports, consumes NOTHING, and carries on.
//
// The SKIP is the load-bearing half. Reporting and then calling anyway is exactly what
// the ungated ref already did; the damage was the CONSUMPTION, not the missing message.
fn g_soft() -> string {
    "r = \"+\" @soft blk \"!\"\n" +
    "blk = \"{\" \"}\" @expect(\"{\", \"expected a block\")"
}

spec "t-myz7: @soft reports an absent rule and CONTINUES" {
    then "the grammar is accepted" {
        perr(g_soft()) == ""
    }
    then "an absent sub-rule reports — using the REFERENCED rule's own @expect" {
        // Not the enclosing sequence's annotations: `@soft`'s message comes from
        // `rule_first_expect_msg`, the same function emit renders the gated check from,
        // so the two engines cannot word it differently.
        emitted(g_soft()).contains("expected a block")
    }
    then "and does NOT abort — the sequence reaches its next item" {
        // THE contrast with @require, which returns here and yields exactly 1. Reaching
        // `!` and finding `9` adds a second diagnostic. If @soft ever regressed into an
        // abort this drops back to 1 and fails.
        diags(g_soft(), "+ 9") > 1
    }
    then "a well-formed continuation after the skip is consumed normally" {
        // blk absent, `!` present: report once, skip, match `!`. Exactly one diagnostic
        // — proof the skip did not derail the rest of the sequence.
        diags(g_soft(), "+ !") == 1
    }
    then "a PRESENT sub-rule is called as usual — the guard is not a rejection" {
        !errs(g_soft(), "+ { } !")
    }
}

spec "t-myz7: @soft SKIPS the call — it does not report-then-call" {
    then "the absent case does not also raise the callee's own error" {
        // If the call still happened after reporting, `blk` would report its missing `{`
        // too and the count would be 3 (soft + blk + `!`). Skipping keeps it at 2.
        // This is the assertion that distinguishes a real skip from a bare message.
        diags(g_soft(), "+ 9") == 2
    }
    then "the emitted parser WRAPS the call rather than prefixing it" {
        // @require emits guard-then-call (the call runs regardless, after a return);
        // @soft must emit an else-arm so the call is genuinely skipped. Asserted on the
        // emitted SOURCE per the t-47hc discipline — routing and skipping are both
        // invisible on valid input, so behaviour alone cannot witness the shape.
        let src = emitted(g_soft())
        src.contains("} else {") && src.contains("parse_blk(st)")
    }
    then "and does not emit the abort scaffold @require uses" {
        // The two markers share a FIRST guard and must NOT share the return.
        let soft_src = emitted(g_soft())
        let req_src = emitted(g_req())
        req_src.contains("return CapVal.Node(st.error_node_silent())") &&
            !soft_src.contains("return CapVal.Node(st.error_node_silent())")
    }
}
