// WHY: map-vs-block disambiguation at a leading `{` — a two-engine
// differential (interpreter vs the generated static parser) over map literals,
// empty braces, and block bodies, so the two engines cannot drift on the one
// token where an expression and a statement collide.

use @std.avrac.features.grammar.{avra_program_grammar, run_grammar_expr_at}

use @std.avrac.parse.{oracle_expr}
use @std.avrac.core.{render_expr_id}

fn dsl_brace(src: string) -> string {
    let r = run_grammar_expr_at(avra_program_grammar(), "expression", src)
    if r.had_error { return "<err>" }
    render_expr_id(r.store, r.root)
}

// The PRODUCTION parser's answer for the same source. This used to call the hand
// `parse_primary`; that ladder is deleted (t-47hc.4.1), so the counterpart is now the
// generated static parser reached through `parse_expression`. The comparison stays a
// real two-ENGINE differential — interpreter above, emitted parser here — rather than
// the vacuous native-against-native shape, because the two are separate code paths
// compiled from the same grammar.
fn prod_brace(src: string) -> string {
    oracle_expr(src) ?? "<err>"
}

fn agree(src: string) -> bool {
    dsl_brace(src) == prod_brace(src)
}

spec "t-47hc.18: grammar-native map-vs-block — interpreter == generated parser" {
    given "map literals (string key + colon)" {
        then "single and multi-entry maps agree and are not errors" {
            dsl_brace("{ \"k\": 1 }") != "<err>" &&
            agree("{ \"k\": 1 }") &&
            agree("{ \"a\": 1, \"b\": 2 }")
        }
    }
    given "the empty brace is a map (is_map_literal treats { } as an empty map)" {
        then "{ } agrees" {
            agree("{ }")
        }
    }
    given "blocks (no string-key-colon lookahead)" {
        then "a bare-expr block and a statement block agree" {
            dsl_brace("{ y }") != "<err>" &&
            agree("{ y }") &&
            agree("{ let z = 1 }")
        }
    }
}
