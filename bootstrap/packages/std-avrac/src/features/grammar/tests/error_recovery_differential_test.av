// WHY: ps3t.6.7 slice 5a — the ERROR-RECOVERY differential ORACLE.
//
// Slice 5 (retiring the hand RD driver) hinges on the static generated parser
// producing byte-identical error-recovery DIAGNOSTICS to the hand parser, so the
// interpreter re-parse fallback in parse_declaration (gated by the diagnostic
// AVRA_NO_STATIC_FALLBACK) can be removed. This spec MEASURES that gap directly:
// for a corpus of INVALID programs, the static parser WITHOUT the fallback
// (AVRA_NO_STATIC_FALLBACK=1) must emit the SAME diagnostics — same F-codes, in
// the same recovery order — as the hand parser (AVRA_PARSER_DECL_FLIP=0, the
// ultimate oracle). Because typeck gates on parse errors (no codegen runs for an
// invalid program), the diagnostics ARE the observable output.
//
// Finding (2026-07-21): they already AGREE across this corpus — including
// multi-error recovery — which reshapes the slice-5 estimate: the fallback is a
// candidate for outright removal. Removing it would also FIX a latent bug — the
// interpreter fallback SWALLOWS stray-top-level-token errors that both the static
// parser and the hand parser catch (recorded on the ps3t.6.7 ticket). This oracle
// is the gate that must stay green (and grow) before slice 5c removes the fallback.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

// The occurrence-ordered F-code signature of `bs2 check <src>` under `env`.
// Comparing the ORDERED list (duplicates preserved) captures both the error SET
// and the recovery ORDER + COUNT — a dropped or reordered error diverges.
fn errcodes(env: string, source: string) -> string {
    let path = "/tmp/avra_errdiff.av"
    write_fixture(path, source)
    avra_shell_exec("${env} ./build/bs2 check '${path}' 2>&1 | grep -oE 'F[0-9]{4}' | tr '\\n' ' '")
}

fn static_raw(source: string) -> string { errcodes("AVRA_NO_STATIC_FALLBACK=1", source) }
fn hand_oracle(source: string) -> string { errcodes("AVRA_PARSER_DECL_FLIP=0", source) }
fn agree(source: string) -> bool { static_raw(source) == hand_oracle(source) }

spec "ps3t.6.7 slice 5a: static parser error recovery == hand oracle (invalid corpus)" {
    // ps3t.6.7 slice 5b — the corpus GREW to a broad, category-diverse invalid set
    // (stray tokens, malformed decls of every keyword, control-flow, expressions,
    // multi-error, EOF-unclosed). All AGREE: static-raw error recovery is
    // byte-identical to hand across the board — the proof that gates slice 5c
    // (removing the interpreter re-parse fallback).
    then "stray top-level tokens: static-raw diagnostics match hand" {
        agree("fn a() -> int { 1 }\nthen\nfn b() -> int { 2 }") &&
        agree("fn a() -> int { 1 }\n)\nfn b() -> int { 2 }") &&
        agree("fn a() -> int { 1 }\n,\nfn b() -> int { 2 }") &&
        agree("fn a() -> int { 1 }\n* 5\nfn b() -> int { 2 }") &&
        agree("else\nfn b() -> int { 2 }")
    }
    then "malformed function declarations" {
        agree("fn () -> int { 1 }\nfn b() -> int { 2 }") &&
        agree("fn a( -> int { 1 }\nfn b() -> int { 2 }") &&
        agree("fn a(x: ) -> int { 1 }\nfn b() -> int { 2 }") &&
        agree("fn a() -> { 1 }\nfn b() -> int { 2 }") &&
        agree("fn a() -> int\nfn b() -> int { 2 }")
    }
    then "malformed type / enum / trait / impl declarations" {
        agree("type T = { x: , y: int }\nfn f() -> int { 1 }") &&
        agree("type T = { x: int\nfn f() -> int { 1 }") &&
        agree("type = { x: int }\nfn f() -> int { 1 }") &&
        agree("enum E { A, , B }\nfn f() -> int { 1 }") &&
        agree("enum E A B }\nfn f() -> int { 1 }") &&
        agree("trait T { fn m( }\nfn f() -> int { 1 }") &&
        agree("impl for Foo { }\nfn f() -> int { 1 }")
    }
    then "malformed bindings and control-flow statements" {
        agree("fn f() -> int {\n let x = \n return 1\n}") &&
        agree("fn f() -> int {\n let = 5\n return 1\n}") &&
        agree("fn f() -> int {\n const C\n return 1\n}") &&
        agree("fn f() -> int {\n if { return 1 }\n return 2\n}") &&
        agree("fn f() -> int {\n while return 2\n}") &&
        agree("fn f() -> int {\n for x { return 3 }\n}") &&
        agree("fn f() -> int {\n match { 1 -> 2 }\n}")
    }
    then "malformed expressions: dangling operators and unclosed delimiters" {
        agree("fn f() -> int {\n let x = 1 +\n return x\n}") &&
        agree("fn f() -> int {\n let y = (1 + 2\n return y\n}") &&
        agree("fn f() -> int {\n let z = [1, 2\n return 0\n}") &&
        agree("fn f() -> int {\n let w = foo(1,\n return 0\n}") &&
        agree("fn f() -> int {\n let q = a.\n return 0\n}") &&
        agree("fn f() -> int {\n return * 3\n}")
    }
    then "multi-error recovery: static-raw finds the SAME ordered error set as hand" {
        // Each program has 3-6 parse errors; recovery must resynchronise and find
        // every one, in the same order, under both parsers.
        agree("fn a() -> int { 1 + }\nfn b() -> int { 2 }\nthen\nfn c() -> int { * 3 }") &&
        agree("type T = { x: , y: }\nfn f(a: , b: int) -> int { return a }\nfn g() -> int { let z = ; return z }") &&
        agree("fn h() -> int {\n  if { return 1 }\n  while return 2\n  for x { return 3 }\n}")
    }
    then "unclosed constructs at EOF" {
        agree("fn f() -> int {\n return 1\n") &&
        agree("fn f() -> int {\n let x = (1 + 2 * 3\n") &&
        agree("type T = {\n x: int,\n")
    }
    then "a valid program produces no diagnostics under either mode (sanity)" {
        static_raw("fn ok() -> int { 1 + 2 }") == "" && hand_oracle("fn ok() -> int { 1 + 2 }") == ""
    }
}
