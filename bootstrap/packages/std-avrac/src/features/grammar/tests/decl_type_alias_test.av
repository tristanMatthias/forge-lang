// ps3t.6.5.7 — the DECLARATION family, non-brace `type` RHS slice: the
// newtype and union-alias forms. `type Name = <type_expr>` with a NON-brace
// RHS builds:
//   - `type X = A | B`  (a Union type)     → Stmt.UnionAliasDecl(name, vt)
//   - `type X = Other`  (anything else)    → Stmt.NewtypeDecl(name, vt)
// exactly parse_type_declaration's non-brace branch, which switches on the
// parsed TypeExpr being a `.Union`. Both reuse the type family (6.5.6) for the
// RHS, so the vtype (and its render) come from the shared type_expr_to_vtype /
// vtype_render_full.
//
// Oracle: run the DSL-generated parser AND the shipping hand-written parser
// (parser_new(src).parse_declaration()) over a corpus and assert identical
// ASTs via render_stmt_id.
//
// Scope: the newtype + union-alias non-brace forms. The struct form
// `type X = { fields }` is already covered (type/enum slice); the `without` /
// `only` type operators (`type X = Base without { f }`, which build a
// synthetic-marker TypeDecl) are a follow-up slice.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_stmt}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id}

fn alias_grammar_src() -> string {
    "grammar Decl {\n" +
    "  type_alias = \"type\" tname:IDENT \"=\" rhs:type_expr -> MkTypeAlias(tname, rhs)\n" +
    // ── type family ──
    "  type_expr  = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom  = fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  fn_type    = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" tr:type_expr )? -> MkFn(lp, p, tr)\n" +
    "  dyn_type   = \"dyn\" dt:IDENT -> TyDyn(dt)\n" +
    "  list_type  = \"[\" el:type_expr \"]\" -> TyList(el)\n" +
    "  paren_type = \"(\" ( pt2:type_expr ( \",\" pt2:type_expr )* )? \")\" -> TyParen(pt2)\n" +
    "  named_type = tn:IDENT ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(tn, a, opt)\n" +
    "}"
}

fn dsl_stmt(src: string) -> string {
    let gp = parse_grammar(alias_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_stmt_id(r.store, r.root)
}

fn hand_stmt(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    dsl_stmt(src) == hand_stmt(src)
}

spec "grammar-DSL declaration family: newtype + union-alias == hand-written parser (ps3t.6.5.7)" {
    given "newtype wrappers (type X = Other → NewtypeDecl)" {
        then "primitive, nominal, container, and nullable inner types agree" {
            agree("type UserId = string") &&
            agree("type Count = int") &&
            agree("type Wrapper = Foo") &&
            agree("type Names = List<string>") &&
            agree("type MaybeId = int?")
        }
    }
    given "union aliases (type X = A | B → UnionAliasDecl)" {
        then "two-way and multi-way unions agree" {
            agree("type Num = int | float") &&
            agree("type Tri = A | B | C") &&
            agree("type Mixed = int | string | bool")
        }
    }
    given "the DSL trees are the expected shapes (sanity: newtype vs union-alias)" {
        then "canonical renders of representative forms" {
            dsl_stmt("type UserId = string") == "(newtype UserId = string)" &&
            dsl_stmt("type Count = int") == "(newtype Count = int)" &&
            dsl_stmt("type Names = List<string>") == "(newtype Names = List<string>)" &&
            dsl_stmt("type Num = int | float") == "(union-alias Num = int|float)"
        }
    }
}
