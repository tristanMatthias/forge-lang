// ps3t.6.5 (validation slice) — the differential test that gates the
// parser migration: the grammar-DSL-generated expression parser must
// produce the SAME AST as the hand-written parser. Here we run both on a
// corpus of expressions (the subset the §2 grammar covers) and compare
// their trees via the canonical prefix dump. This is the acceptance
// oracle for scaling the DSL to the full grammar rule-family by
// rule-family — expressions are the first family, proven equivalent.

use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr, dump_expr}
use @std.avrac.parse.{parse_expression_native_probe}

// Avra's full binary-operator precedence, mirrored from the hand-written
// parser (parse_or → and → equality → bitor → bitxor → bitand →
// comparison → shift → term → factor → unary). The differential test
// below is what proves this stratification matches, operator for
// operator, level for level.
fn expr_grammar_src() -> string {
    "grammar Expr {\n" +
    "  expression = logic_or\n" +
    "  logic_or   = l:logic_and ( op:(\"||\") r:logic_and )* -> fold_logical(l, op, r)\n" +
    "  logic_and  = l:equality ( op:(\"&&\") r:equality )* -> fold_logical(l, op, r)\n" +
    "  equality   = l:bitor ( op:(\"!=\" | \"==\") r:bitor )* -> fold_binary(l, op, r)\n" +
    "  bitor      = l:bitxor ( op:(\"|\") r:bitxor )* -> fold_binary(l, op, r)\n" +
    "  bitxor     = l:bitand ( op:(\"^\") r:bitand )* -> fold_binary(l, op, r)\n" +
    "  bitand     = l:comparison ( op:(\"&\") r:comparison )* -> fold_binary(l, op, r)\n" +
    "  comparison = l:shift ( op:(\"<\" | \"<=\" | \">\" | \">=\") r:shift )* -> fold_binary(l, op, r)\n" +
    "  shift      = l:term ( op:(\"<<\" | \">>\") r:term )* -> fold_binary(l, op, r)\n" +
    "  term       = l:factor ( op:(\"+\" | \"-\") r:factor )* -> fold_binary(l, op, r)\n" +
    "  factor     = l:unary ( op:(\"*\" | \"/\" | \"%\") r:unary )* -> fold_binary(l, op, r)\n" +
    "  unary      = op:(\"!\" | \"-\") operand:unary -> Unary(op, operand) | postfix\n" +
    "  postfix    = base:primary ( s:suffix )* -> fold_postfix(base, s)\n" +
    "  suffix     = \".\" name:IDENT -> field_suffix(name)\n" +
    "             | \"[\" idx:expression \"]\" -> index_suffix(idx)\n" +
    "  primary    = NUMBER | \"true\" | \"false\" | @hand(ident)\n" +
    "             | \"(\" e:expression \")\" @expect(\")\", \"expected ')'\") @recover(sync_to: \")\") -> e\n" +
    "}"
}

// The generated parser's tree for `src`, as a prefix dump.
fn grammar_tree(src: string) -> string {
    let gp = parse_grammar(expr_grammar_src())
    let r = run_grammar_expr(gp.grammar, src)
    dump_expr(r.store, r.root)
}

// The hand-written parser's tree for `src`, dumped the SAME way (dump_expr
// walks any Expr, whichever parser built it).
fn handwritten_tree(src: string) -> string {
    let probe = parse_expression_native_probe(src)
    if probe.had_error != 0 { return "<parse error>" }
    dump_expr(probe.store, probe.root)
}

// True when both parsers agree on the tree for `src`.
fn agree(src: string) -> bool {
    grammar_tree(src) == handwritten_tree(src)
}

spec "grammar-DSL parser == hand-written parser (expression family, ps3t.6.5)" {
    given "arithmetic + precedence" {
        then "literals and flat operators agree" {
            agree("42") &&
            agree("1 + 2") &&
            agree("7 - 3") &&
            agree("6 * 7") &&
            agree("8 / 2")
        }
        then "mixed precedence agrees" {
            agree("1 + 2 * 3") &&
            agree("1 * 2 + 3 * 4") &&
            agree("10 - 2 * 3 + 1")
        }
        then "left-associativity agrees" {
            agree("1 - 2 - 3") &&
            agree("1 + 2 + 3 + 4") &&
            agree("8 / 4 / 2")
        }
    }
    given "grouping + unary + comparison" {
        then "parentheses agree (Grouping normalises away in both)" {
            agree("(1 + 2) * 3") &&
            agree("2 * (3 + 4)") &&
            agree("((1))")
        }
        then "prefix unary agrees" {
            agree("-5") &&
            agree("-2 + 3") &&
            agree("!0") &&
            agree("- -5")
        }
        then "comparison + equality stratification agrees" {
            agree("1 < 2") &&
            agree("1 + 2 < 3 * 4") &&
            agree("1 < 2 == 3")
        }
    }
    given "logical operators (&& / ||)" {
        then "logical-and/or agree and stratify below equality" {
            agree("1 && 2") &&
            agree("1 || 2") &&
            agree("1 == 2 && 3") &&
            agree("1 && 2 || 3") &&
            agree("1 < 2 && 3 + 4 == 7")
        }
        then "logical-and binds tighter than logical-or" {
            agree("1 || 2 && 3") &&
            agree("0 && 1 || 2 && 3")
        }
    }
    given "bitwise, shift, and modulo (the full binary chain)" {
        then "modulo sits with * /" {
            agree("7 % 3") &&
            agree("10 % 3 + 1") &&
            agree("2 * 3 % 4")
        }
        then "bitwise or/xor/and stratify (| looser than ^ looser than &)" {
            agree("5 | 2") &&
            agree("5 ^ 1") &&
            agree("6 & 3") &&
            agree("1 | 2 & 3") &&
            agree("1 ^ 2 | 3 & 4")
        }
        then "shift sits between comparison and term" {
            agree("1 << 4") &&
            agree("256 >> 2") &&
            agree("1 + 2 << 3") &&
            agree("1 << 2 + 3") &&
            agree("1 < 2 << 3")
        }
        then "a deep mixed expression across every level agrees" {
            agree("1 | 2 ^ 3 & 4 == 5 < 6 << 7 + 8 * 9 % 2") &&
            agree("(1 + 2) * 3 & 4 | 5 && 6 == 7")
        }
    }
    given "identifiers via the @hand(ident) escape-hatch" {
        then "bare identifiers parse equivalently to the real parser" {
            agree("x") &&
            agree("foo + bar") &&
            agree("a * b + c") &&
            agree("(x + y) * z") &&
            agree("a < b && c == d")
        }
    }
    given "postfix field-access + index (partial-node rebind fold)" {
        then "single field / index agree" {
            agree("a.b") &&
            agree("a[0]") &&
            agree("x[i]")
        }
        then "left-associative chains agree" {
            agree("a.b.c") &&
            agree("a[0][1]") &&
            agree("a.b[0]") &&
            agree("a[0].b")
        }
        then "postfix binds tighter than the binary operators" {
            agree("a.b + c[0]") &&
            agree("a[0] * b.c") &&
            agree("-a.b") &&
            agree("a.b < c.d && e[0] == f")
        }
    }
}
