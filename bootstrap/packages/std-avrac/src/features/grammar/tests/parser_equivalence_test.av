// ps3t.6.5 (validation slice) — the differential test that gates the
// parser migration: the grammar-DSL-generated expression parser must
// produce the SAME AST as the hand-written parser. Here we run both on a
// corpus of expressions (the subset the §2 grammar covers) and compare
// their trees via the canonical prefix dump. This is the acceptance
// oracle for scaling the DSL to the full grammar rule-family by
// rule-family — expressions are the first family, proven equivalent.

use @std.avrac.features.grammar.{avra_expr_grammar, run_grammar_expr, dump_expr}
use @std.avrac.parse.{parse_expression_native_probe}

// Avra's full binary-operator precedence, mirrored from the hand-written
// parser (parse_or → and → equality → bitor → bitxor → bitand →
// comparison → shift → term → factor → unary). The differential test
// below is what proves this stratification matches, operator for
// operator, level for level. The grammar itself is the SOURCE-OF-TRUTH
// `grammar { }` block dogfooded into compiler src/ (avra_grammar.av,
// ps3t.6.5.11) — this test runs it through the executor as the oracle.

// The generated parser's tree for `src`, as a prefix dump.
fn grammar_tree(src: string) -> string {
    let r = run_grammar_expr(avra_expr_grammar(), src)
    dump_expr(r.store, r.root)
}

// The hand-written parser's tree for `src`, dumped the SAME way (dump_expr
// walks any Expr, whichever parser built it).
fn handwritten_tree(src: string) -> string {
    let probe = parse_expression_native_probe(src)
    if probe.had_error != 0 { return "<parse error>" }
    dump_expr(probe.store, probe.root)
}

// True when both parsers agree on the tree for `src`. The dump is a
// LOSSLESS view (Grouping is rendered explicitly, never unwrapped), and
// we additionally reject the "<unmodelled-variant>" marker on either
// side so an unhandled Expr variant can't silently compare equal.
fn agree(src: string) -> bool {
    let g = grammar_tree(src)
    let h = handwritten_tree(src)
    g == h && !g.contains("<unmodelled-variant>") && !h.contains("<unmodelled-variant>")
}

spec "grammar-DSL parser == hand-written parser (expression family, ps3t.6.5)" {
    given "arithmetic + precedence" {
        then "literals and flat operators agree" {
            agree("42") &&
            agree("1 + 2") &&
            agree("7 - 3") &&
            agree("6 * 7") &&
            agree("8 / 2")
        }
        then "mixed precedence agrees" {
            agree("1 + 2 * 3") &&
            agree("1 * 2 + 3 * 4") &&
            agree("10 - 2 * 3 + 1")
        }
        then "left-associativity agrees" {
            agree("1 - 2 - 3") &&
            agree("1 + 2 + 3 + 4") &&
            agree("8 / 4 / 2")
        }
    }
    given "grouping + unary + comparison" {
        then "parentheses produce matching Grouping nodes (losslessly)" {
            // Grouping is preserved on BOTH sides now, so `((1))` keeps
            // its two Grouping nodes rather than collapsing to `1`.
            agree("(1 + 2) * 3") &&
            agree("2 * (3 + 4)") &&
            agree("((1))") &&
            agree("(1)")
        }
        then "prefix unary agrees (incl. bitwise-not ~)" {
            agree("-5") &&
            agree("-2 + 3") &&
            agree("!0") &&
            agree("- -5") &&
            agree("~5") &&
            agree("~a + 2") &&
            agree("~~3") &&
            agree("!~-1")
        }
        then "comparison + equality stratification agrees" {
            agree("1 < 2") &&
            agree("1 + 2 < 3 * 4") &&
            agree("1 < 2 == 3")
        }
    }
    given "logical operators (&& / ||)" {
        then "logical-and/or agree and stratify below equality" {
            agree("1 && 2") &&
            agree("1 || 2") &&
            agree("1 == 2 && 3") &&
            agree("1 && 2 || 3") &&
            agree("1 < 2 && 3 + 4 == 7")
        }
        then "logical-and binds tighter than logical-or" {
            agree("1 || 2 && 3") &&
            agree("0 && 1 || 2 && 3")
        }
    }
    given "bitwise, shift, and modulo (the full binary chain)" {
        then "modulo sits with * /" {
            agree("7 % 3") &&
            agree("10 % 3 + 1") &&
            agree("2 * 3 % 4")
        }
        then "bitwise or/xor/and stratify (| looser than ^ looser than &)" {
            agree("5 | 2") &&
            agree("5 ^ 1") &&
            agree("6 & 3") &&
            agree("1 | 2 & 3") &&
            agree("1 ^ 2 | 3 & 4")
        }
        then "shift sits between comparison and term" {
            agree("1 << 4") &&
            agree("256 >> 2") &&
            agree("1 + 2 << 3") &&
            agree("1 << 2 + 3") &&
            agree("1 < 2 << 3")
        }
        then "a deep mixed expression across every level agrees" {
            agree("1 | 2 ^ 3 & 4 == 5 < 6 << 7 + 8 * 9 % 2") &&
            agree("(1 + 2) * 3 & 4 | 5 && 6 == 7")
        }
    }
    given "identifiers via the @hand(ident) escape-hatch" {
        then "bare identifiers parse equivalently to the real parser" {
            agree("x") &&
            agree("foo + bar") &&
            agree("a * b + c") &&
            agree("(x + y) * z") &&
            agree("a < b && c == d")
        }
    }
    given "string literals" {
        then "string literals parse equivalently (quotes retained)" {
            agree("\"hello\"") &&
            agree("\"a\" == \"b\"") &&
            agree("x + \"lit\"")
        }
    }
    given "postfix field-access + index (partial-node rebind fold)" {
        then "single field / index agree" {
            agree("a.b") &&
            agree("a[0]") &&
            agree("x[i]")
        }
        then "left-associative chains agree" {
            agree("a.b.c") &&
            agree("a[0][1]") &&
            agree("a.b[0]") &&
            agree("a[0].b")
        }
        then "postfix binds tighter than the binary operators" {
            agree("a.b + c[0]") &&
            agree("a[0] * b.c") &&
            agree("-a.b") &&
            agree("a.b < c.d && e[0] == f")
        }
    }
    given "function calls (list-valued args via scalar→list promotion)" {
        then "zero / one / many args agree" {
            agree("f()") &&
            agree("f(1)") &&
            agree("f(1, 2, 3)") &&
            agree("g(a + b, c * d)")
        }
        then "call chains and calls mixed with field/index agree" {
            agree("f(1)(2)") &&
            agree("f(a)[0]") &&
            agree("f(g(x), h(y, z))")
        }
        then "calls compose with the binary operators" {
            agree("f(1) + g(2)") &&
            agree("f(a) * 2 + b[0]")
        }
        then "method calls fall out of field+call (no special node needed)" {
            // a.b(c) is Call(FieldAccess(a, b), [c]) — the rebind fold
            // composes field + call with no method-specific machinery,
            // and it matches the hand-written parser.
            agree("a.b(c)") &&
            agree("a.b(c).d(e)") &&
            agree("f(x).y") &&
            agree("obj.method(1, 2)")
        }
    }
}
