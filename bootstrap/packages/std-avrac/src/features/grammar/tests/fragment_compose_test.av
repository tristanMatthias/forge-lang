// WHY: t-47hc.8 — proves the per-feature grammar-fragment COMPOSITION seam
// (features/grammar/compose.av). Fragments authored in DIFFERENT feature modules
// (the expression ladder in features.grammar, the pattern grammar in
// features.match_expr) compose into one Grammar: the rule set is their union,
// the first fragment's start rule leads, and rule-name clashes across fragments
// are detected. This is the mechanism the whole modular-grammar epic sits on —
// adding a feature adds only its fragment; the composer joins them, no central
// edit. The cross-MODULE compose (grammar + match_expr) is the load-bearing
// assertion: fragments genuinely live with their owning features.
use @std.avrac.features.grammar.{compose_fragments, compose_grammars, fragment_rule_conflicts, avra_expr_dispatch_grammar, avra_type_grammar, Grammar, parse_grammar}
use @std.avrac.features.{avra_pat_grammar}

// Two tiny fragments that intentionally CLASH on a rule name (`shared`), to
// exercise the conflict detector. Authored via the `grammar { }` surface (parsed
// only — the build targets are never executed here).
fn frag_x() -> Grammar {
    let g = grammar {
  shared = "a" -> Mk()
  only_x = "x" -> Mk()
    }
    g.grammar
}
fn frag_y() -> Grammar {
    let g = grammar {
  shared = "b" -> Mk()
  only_y = "y" -> Mk()
    }
    g.grammar
}

spec "t-47hc.8: per-feature grammar fragments compose cross-module" {
    then "compose_fragments of a single fragment is identity on the rule set" {
        let e = avra_expr_dispatch_grammar()
        let c = compose_fragments([e])
        c.rules.length == e.rules.length && c.name == e.name
    }
    then "expr (features.grammar) + pat (features.match_expr) compose; rule set is the union" {
        let e = avra_expr_dispatch_grammar()
        let p = avra_pat_grammar()
        let c = compose_fragments([e, p])
        c.rules.length == e.rules.length + p.rules.length
    }
    then "THREE disjoint fragments (expr + pat + type) compose to the ordered union" {
        // Exercises the N-ary path beyond the legacy 2-fragment case: an impl
        // that dropped fragment 3+ would pass the pair test but fail here. expr
        // (features.grammar), pat (features.match_expr), and type (features.grammar)
        // are rule-disjoint, so the composed rule set is exactly their sum, the
        // FIRST fragment's start rule still leads, and there are no conflicts.
        // The interpreter expression view already includes the type family for
        // typed-lambda resolution; use its dispatch/core view when composing the
        // expression and type fragments as separate, disjoint modules.
        let e = avra_expr_dispatch_grammar()
        let p = avra_pat_grammar()
        let t = avra_type_grammar()
        let c = compose_fragments([e, p, t])
        c.rules.length == e.rules.length + p.rules.length + t.rules.length
            && c.rules[0].name == e.rules[0].name
            && c.name == e.name
            && fragment_rule_conflicts([e, p, t]).length == 0
    }
    then "the FIRST fragment's start rule leads the composition" {
        let e = avra_expr_dispatch_grammar()
        let p = avra_pat_grammar()
        let c = compose_fragments([e, p])
        c.rules[0].name == e.rules[0].name && c.name == e.name
    }
    then "disjoint cross-module fragments report NO conflicts" {
        fragment_rule_conflicts([avra_expr_dispatch_grammar(), avra_pat_grammar()]).length == 0
    }
    then "compose_grammars is the 2-fragment case of compose_fragments" {
        let e = avra_expr_dispatch_grammar()
        let p = avra_pat_grammar()
        compose_grammars(e, p).rules.length == compose_fragments([e, p]).rules.length
    }
    then "fragment_rule_conflicts detects a rule name shared by two fragments" {
        let dups = fragment_rule_conflicts([frag_x(), frag_y()])
        dups.length == 1 && dups[0] == "shared"
    }
}
