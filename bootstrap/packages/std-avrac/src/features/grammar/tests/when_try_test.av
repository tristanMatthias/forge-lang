// WHY: t-47hc.3 (Phase 2) slice 3b — `@try` BOUNDED SPECULATION. A `@try` branch
// snapshots the cursor + node store, runs, and ROLLS BACK on failure to try the
// next alternative — the grammar analogue of the hand parser's save_state/
// restore_state (the f<T> generic-call vs `<` less-than decision). Without @try,
// predictive ordered choice commits to the first FIRST-matching branch and
// cannot fall back; with @try, a failed longer branch rewinds and a shorter
// alternative matches. The differential (same grammar ± @try) is the proof.
//
// Two-sided in lockstep: the INTERPRETER (run_grammar_expr) is the oracle and the
// EMITTER lowers the same branch to a static snapshot→run→commit-or-rollback
// block. Post-#995 a `@try` branch handles the full item vocabulary (repetitions,
// groups, mode markers) via emit_speculative_branch_rich — the rich path
// reuses emit_seq_stmts, so both sides agree by construction.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr, emit_rule_fn, Grammar, Rule}

fn errs(grammar_src: string, input: string) -> bool {
    let gp = parse_grammar(grammar_src)
    run_grammar_expr(gp.grammar, input).had_error
}

// True iff `grammar_src` is REJECTED at parse time (GrammarParse.error is set).
fn rejects(grammar_src: string) -> bool {
    parse_grammar(grammar_src).error != ""
}

// Emit the named rule's generated static parse fn from `grammar_src`.
fn emit_rule(grammar_src: string, rule: string) -> string {
    let gp = parse_grammar(grammar_src)
    for r in gp.grammar.rules {
        if r.name == rule { return emit_rule_fn(gp.grammar, r) }
    }
    ""
}

spec "t-47hc.3: @try bounded speculation" {
    then "a @try branch that fails rolls back and the next branch matches" {
        // `1 "x"`: branch 1 (@try) tries NUMBER STRING NUMBER — matches 1 and
        // "x", then fails on the missing 3rd NUMBER → rolls back → branch 2
        // (NUMBER STRING) matches. No error.
        !errs("r = @try NUMBER STRING NUMBER | NUMBER STRING", "1 \"x\"")
    }
    then "WITHOUT @try the same grammar commits to branch 1 and errors" {
        // Predictive ordered choice picks branch 1 by FIRST (NUMBER), consumes 1
        // and "x", then errors on the missing 3rd NUMBER — no fallback.
        errs("r = NUMBER STRING NUMBER | NUMBER STRING", "1 \"x\"")
    }
    then "a @try branch that fully matches commits (no needless fallback)" {
        // `1 "x" 2`: branch 1 (@try) matches NUMBER STRING NUMBER → commits.
        !errs("r = @try NUMBER STRING NUMBER | NUMBER STRING", "1 \"x\" 2")
    }
}

// The EMITTER lowers a `@try` branch to the SAME snapshot→run→commit-or-rollback
// block the interpreter runs (executor.exec_node's speculative arm). Source-level
// pins on the generated static parser so the two sides can never drift.
spec "t-47hc.3: @try emit — generated parser mirrors the interpreter" {
    then "a @try branch emits the snapshot + commit-or-rollback machinery" {
        let src = emit_rule("r = @try NUMBER STRING NUMBER | NUMBER STRING", "r")
        src.contains("mut tried_spec = false") &&
        src.contains("tried_spec = true") &&
        src.contains("let s_mark = st.store.mark()") &&
        src.contains("if st.diags.length == s_diags && st.had_error == s_err {") &&
        src.contains("st.store.truncate_to_mark(s_mark)") &&
        src.contains("st.restore_to(s_pos, s_diags, s_err)") &&
        src.contains("if tried_spec { return CapVal.Nil }")
    }
    then "a later terminal in a @try branch REPORTS on mismatch (the rollback signal)" {
        // The idx>0 terminal is checked-and-reporting (not the lenient consume) so
        // st.diags grows on a shape mismatch — the twin of exec_primary.handle_missing.
        emit_rule("r = @try NUMBER STRING NUMBER | NUMBER STRING", "r").contains("st.report(")
    }
    then "a non-speculative dispatch emits NO speculation machinery" {
        let src = emit_rule("r = NUMBER STRING NUMBER | NUMBER STRING", "r")
        !src.contains("tried_spec") && !src.contains("truncate_to_mark")
    }
}

// Post-#995 (t-47hc GAP-3) a `@try` branch handles the FULL item vocabulary — capture
// labels, a `-> build`, repetitions (list accumulators), groups/opt, `@on`/`@off` mode
// items — via the emitter's rich speculative path
// (emit_speculative_branch_rich, reusing emit_seq_stmts) and the interpreter's exec_seq.
// So NO branch SHAPE is rejected anymore; the only residual @try-specific rules are the
// LABEL constraints below (a bound label becomes a generated local). The flat path is a
// fast case of the same lowering, not a different capability.
spec "t-47hc.3: @try admits the full item vocabulary (post-#995 rich lowering)" {
    then "a repetition inside a @try branch is ACCEPTED (`*` / `+` / `?`), lowered via emit_item" {
        !rejects("r = @try NUMBER* | STRING") &&
        !rejects("r = @try NUMBER+ | STRING") &&
        !rejects("r = @try NUMBER? | STRING") &&
        // the Plus lowers to the #995 required-first guard so a 0-match rolls back
        emit_rule("r = @try NUMBER+ | STRING", "r").contains("expected at least one repetition")
    }
    then "a group inside a @try branch is ACCEPTED (emit_node_items inlines the dispatch)" {
        !rejects("r = @try ( NUMBER | STRING ) | STRING")
    }
    then "a well-formed flat terminal/ref @try branch is accepted (the fast path)" {
        !rejects("r = @try NUMBER STRING NUMBER | NUMBER STRING")
    }
    then "a @try label colliding with the branch scaffolding is rejected" {
        // Each label lowers to an auto-scoped `let <label>` in the emitted branch;
        // one named after the scaffolding (`s_last`/`sp_start`/`tried_spec`/…) would
        // shadow/redeclare it, so it is rejected at parse time (both sides agree).
        rejects("r = @try s_last:NUMBER STRING | STRING") &&
        rejects("r = @try sp_start:NUMBER STRING | STRING") &&
        rejects("r = @try tried_spec:NUMBER STRING | STRING")
    }
    then "a @try branch binding the same label twice is rejected" {
        // `let x` twice won't compile in the generated branch; the interpreter would
        // silently last-wins it — REJECT so emit and interp stay in lockstep.
        rejects("r = @try x:NUMBER x:STRING | STRING")
    }
    then "distinct labels + a non-reserved name stay accepted" {
        !rejects("r = @try a:NUMBER b:STRING | STRING")
    }
}

// GAP3 @try-with-builds (t-47hc.13): a @try branch may now bind labels + apply a
// build on commit. Byte-identity across rollback is closed on both sides — the
// interpreter snapshots/restores env.caps around the speculative exec_seq, and emit
// binds each label as an auto-scoped local. Build-less @try stays byte-identical
// (the incumbent `s_last` path), proven by the differential tests above + emit-gen-check.
spec "t-47hc.13: @try-with-builds — labels + build now accepted (GAP3)" {
    then "a `-> build` on a @try branch is now ACCEPTED" {
        !rejects("r = @try o:\"-\" v:NUMBER -> Unary(o, v) | NUMBER")
    }
    then "capture labels inside a @try branch are now ACCEPTED" {
        !rejects("r = @try x:NUMBER STRING | STRING") &&
        !rejects("r = @try NUMBER y:STRING | STRING")
    }
    then "the emitted @try branch binds each label to an auto-scoped local" {
        let src = emit_rule("r = @try o:\"-\" v:NUMBER -> Unary(o, v) | NUMBER", "r")
        src.contains("let o = ") && src.contains("let v = ")
    }
    then "the emitted @try branch applies the build on commit (not the build-less s_last)" {
        // Unary lowers via emit_call_build's `unary_expr(...)` — the committed value is
        // the BUILD, reading the labels bound above, not the recognizer's `s_last`.
        let src = emit_rule("r = @try o:\"-\" v:NUMBER -> Unary(o, v) | NUMBER", "r")
        src.contains("unary_expr(")
    }
    then "the interpreter's @try-with-build rolls back cleanly (no env leak)" {
        // `1`: branch 1 (@try `stale:NUMBER STRING`) binds stale=1, then FAILS on the
        // missing STRING → rolls back. Branch 2 (`NUMBER -> stale`) matches and its
        // build reads `stale` — a capture ONLY the failed branch bound. WITH
        // env.restore_caps the binding is gone, so the build reads Nil →
        // capval_to_expr → error_node → had_error (errs == true). WITHOUT restore the
        // leaked `1` would satisfy the build with no error (errs == false). So this
        // asserts the ERROR is observed, which holds IFF the rollback restored the
        // capture env — the discriminating twin the previous (unread-capture) test lacked.
        errs("r = @try stale:NUMBER STRING | NUMBER -> stale", "1")
    }
}
