// ps3t.6.5.7 — the DECLARATION family, trait slice: `trait Name { … }`.
// A trait body holds three kinds of member, each a Stmt id under the
// TraitDecl:
//   - signature-only method   `fn m(self) -> T`      → Stmt.ExternFn
//   - default-body method      `fn m(self) -> T { … }` → Stmt.Function (plain
//                                                        name — trait defaults
//                                                        are NOT mangled)
//   - associated type          `type Item`            → Stmt.AssocType(_, Unknown)
// `self` is a plain parameter here (parse_trait_method_sig calls
// parse_param_list, not the receiver-synthesising method variant), so it
// renders as just `self`. The seam adds MkTraitDecl / MkTraitMethod /
// MkAssocType; the method+return types reuse the type family (6.5.6) and the
// default-body statements reuse the statement subset (6.5.3/.4).
//
// Oracle: run the DSL-generated parser AND the shipping hand-written parser
// (parser_new(src).parse_declaration()) over a trait corpus and assert
// identical ASTs via render_stmt_id.
//
// Scope: the core `trait Name { members }`. Generic params `trait Name<T>` and
// method-level generics (skip_angle_brackets in the hand parser — they don't
// reach the render) are a follow-up generics slice; `impl` is the next slice.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_stmt}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id}

fn trait_grammar_src() -> string {
    "grammar Trait {\n" +
    "  trait_decl    = \"trait\" name:IDENT \"{\" ( members:trait_member )* \"}\" -> MkTraitDecl(name, members)\n" +
    "  trait_member  = assoc_member | method_member\n" +
    "  assoc_member  = \"type\" atname:IDENT -> MkAssocType(atname)\n" +
    "  method_member = \"fn\" mname:IDENT \"(\" ( params:param ( \",\" params:param )* )? \")\" ( \"->\" ret:type_expr )? ( lb:\"{\" ( body:statement )* \"}\" )? -> MkTraitMethod(mname, params, ret, lb, body)\n" +
    "  param         = pname:IDENT ( \":\" pt:type_expr )? -> MkParam(pname, pt)\n" +
    // ── body statement subset (default methods) ──
    "  statement     = break_stmt | continue_stmt | return_stmt | expr_stmt\n" +
    "  break_stmt    = \"break\" -> Break()\n" +
    "  continue_stmt = \"continue\" -> Continue()\n" +
    "  return_stmt   = \"return\" re:expression -> Return(re)\n" +
    "  expr_stmt     = es:expression -> ExprStmt(es)\n" +
    // ── type family (param + return annotations) ──
    "  type_expr     = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom     = fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  fn_type       = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" tr:type_expr )? -> MkFn(lp, p, tr)\n" +
    "  dyn_type      = \"dyn\" dt:IDENT -> TyDyn(dt)\n" +
    "  list_type     = \"[\" el:type_expr \"]\" -> TyList(el)\n" +
    "  paren_type    = \"(\" ( pt2:type_expr ( \",\" pt2:type_expr )* )? \")\" -> TyParen(pt2)\n" +
    "  named_type    = tn:IDENT ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(tn, a, opt)\n" +
    // ── expression family (default-method bodies) ──
    "  expression    = equality\n" +
    "  equality      = l:comparison ( op:(\"!=\" | \"==\") r:comparison )* -> fold_binary(l, op, r)\n" +
    "  comparison    = l:term ( op:(\"<\" | \"<=\" | \">\" | \">=\") r:term )* -> fold_binary(l, op, r)\n" +
    "  term          = l:factor ( op:(\"+\" | \"-\") r:factor )* -> fold_binary(l, op, r)\n" +
    "  factor        = l:un ( op:(\"*\" | \"/\") r:un )* -> fold_binary(l, op, r)\n" +
    "  un            = op:(\"!\" | \"-\") operand:un -> Unary(op, operand) | primary\n" +
    "  primary       = NUMBER | STRING | \"true\" | \"false\" | @hand(ident)\n" +
    "                | \"(\" e:expression \")\" @expect(\")\", \"expected ')'\") @recover(sync_to: \")\") -> Grouping(e)\n" +
    "}"
}

fn dsl_stmt(src: string) -> string {
    let gp = parse_grammar(trait_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_stmt_id(r.store, r.root)
}

fn hand_stmt(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    dsl_stmt(src) == hand_stmt(src)
}

spec "grammar-DSL declaration family: trait == hand-written parser (ps3t.6.5.7)" {
    given "signature-only methods (→ ExternFn)" {
        then "empty trait, single/multi sig methods, params + return types agree" {
            agree("trait Empty { }") &&
            agree("trait Greet { fn hello(self) -> string }") &&
            agree("trait Shape { fn area(self) -> int fn name(self) -> string }") &&
            agree("trait Convert { fn to(self, target: string) -> bool }") &&
            agree("trait Nullary { fn make() -> int }")
        }
    }
    given "associated types (→ AssocType)" {
        then "assoc type alone and mixed with methods agree" {
            agree("trait Iter { type Item fn next(self) -> int }") &&
            agree("trait Container { type Elem type Key }") &&
            agree("trait Producer { type Output fn produce(self) -> string }")
        }
    }
    given "default-body methods (→ Function, plain name)" {
        then "default bodies (incl. empty) mixed with sig methods agree" {
            agree("trait WithDefault { fn base(self) -> int fn helper(self) -> int { return 5 } }") &&
            agree("trait EmptyDefault { fn noop(self) { } }") &&
            agree("trait Mixed { type T fn req(self) -> bool fn opt(self) -> int { return 1 } }")
        }
    }
    given "the DSL trees are the expected shapes (sanity: really built a TraitDecl)" {
        then "canonical renders of representative forms" {
            // render_stmt_ids joins members with a newline (no wrapping
            // parens/commas); an empty body renders as the bare `(trait N )`.
            dsl_stmt("trait Greet { fn hello(self) -> string }") == "(trait Greet (extern hello (self) -> string))" &&
            dsl_stmt("trait Empty { }") == "(trait Empty )" &&
            dsl_stmt("trait Iter { type Item fn next(self) -> int }") == "(trait Iter (assoc-type Item)\n(extern next (self) -> int))"
        }
    }
}
