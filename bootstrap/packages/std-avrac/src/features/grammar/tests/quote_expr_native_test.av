// WHY: t-bwjg — EVERY `quote` shape is grammar-native, and `@hand(quote_expr)` is retired
// from the production path (`--hand-leaves` 5 -> 4). Three rules, because the three bodies
// are structurally different:
//   quote_expr      `quote { … }` / `stmt` / `stmts` / `decl`  → a block expression
//   quote_type_expr `quote type { <type> }`                    → an Expr.TypeLit carrier
//   quote_arm_expr  `quote arm { pat (if g)? -> b ,? }`        → a synthetic single-armed
//                                                                 MatchExpr envelope
// `@peek(quote_type)` / `@peek(quote_arm)` do the routing, both checked BEFORE `quote` is
// consumed so the plain rule's FIRST stays a bare `quote` and it can serve as the
// unguarded catch-all.
//
// THE TRAP THIS FILE EXISTS FOR, and why the gate list here is unusual: the previous
// attempt at a quote-adjacent leaf (the primary_base splice, t-47hc.5 comment 2026-07-27)
// built green and passed build-quick, --emit-gen-check AND diff-test while being broken —
// because `@comptime` → `@expand` → `value_to_expr_node` is covered by NONE of them. An
// INT spliced correctly; STRING, FLOAT and BOOL did not. So the assertions below are
// deliberately about the QUOTE BODY surviving lowering, not just about parsing, and the
// feature suite (features/quote_expr/tests/*) is part of this slice's gate rather than an
// afterthought.

use @std.avrac.parse.{mode_parse, rendered, ModeRun}
use @std.avrac.features.grammar.{checked_in_parser_source}

/// Both engines build the SAME tree, and the source is valid under both.
/// The legs come from the testkit's `mode_parse` — the earlier shape here
/// took a `static_raw` flag and PINNED NOTHING, so both "sides" ran the
/// production engine and every comparison in this file was same-vs-same
/// (the t-bw9s vacuity class, discovered while centralizing; the testkit
/// pins every routing field so the flag means what it says again).
fn agree(source: string) -> bool {
    let e = mode_parse("emit", source, null)
    let x = mode_parse("exec", source, e.r.store)
    let sr = rendered(e.r)
    let xr = rendered(x.r)
    if sr != xr {
        println("quote tree mismatch")
        println(source)
        println(sr)
        println(xr)
    }
    sr == xr
}

/// The ordered diagnostic MESSAGES of one leg, joined — the message-level
/// twin of the differential's `msgs_agree_bad`, in-process (no shell-out):
/// count equality falls out of string equality, and message equality closes
/// the hole where both paths report the same NUMBER of different errors.
fn msgs(m: ModeRun) -> string {
    mut out = ""
    for d in m.r.bag.diagnostics { out = out + d.message + "|" }
    out
}

/// An invalid quote form must REPORT on both paths, with the SAME MESSAGES
/// in the same order, and recover to the same tree — two parsers agreeing on
/// SILENCE is the one outcome a differential oracle cannot interpret
/// (t-6u9b). Messages and tree come from the SAME pair of parses on one
/// shared store.
fn agree_bad(source: string) -> bool {
    let e = mode_parse("emit", source, null)
    let x = mode_parse("exec", source, e.r.store)
    let em = msgs(e)
    let xm = msgs(x)
    if em == "" || em != xm {
        println("quote recovery MESSAGE divergence")
        println(source)
        println("emit=" + em)
        println("exec=" + xm)
    }
    let sr = rendered(e.r)
    let xr = rendered(x.r)
    if sr != xr {
        println("quote tree mismatch")
        println(source)
        println(sr)
        println(xr)
    }
    em != "" && em == xm && sr == xr
}

fn wrap(body: string) -> string { "fn f() -> int {\n let q = ${body}\n return 0\n}\n" }

spec "t-bwjg: the block-bodied quote kinds are grammar-native" {
    given "every valid block-bodied form" {
        then "the default `expr` kind agrees with hand" {
            agree(wrap("quote { 1 + 2 }")) &&
            agree(wrap("quote { }"))
        }
        then "the explicit block kinds agree with hand" {
            agree(wrap("quote stmt { let a = 1 }")) &&
            agree(wrap("quote stmts { let a = 1\n let b = 2 }")) &&
            agree(wrap("quote decl { fn g() -> int { 1 } }"))
        }
        then "a quote is still a postfix BASE, not a special case" {
            agree(wrap("quote { 1 }.kind"))
        }
    }
    given "the two kinds with a NON-block body, each on its own native rule" {
        // These are declined by the block-bodied rule via @peek(quote_type)/@peek(quote_arm)
        // and routed to quote_type_expr / quote_arm_expr. If a peek ever stopped declining
        // them, the plain rule would try `block_expr` on a type or an arm body and the tree
        // would change — so agreement with the hand oracle here is the routing proof.
        then "`quote type` parses identically to the hand" {
            agree(wrap("quote type { int }")) &&
            agree(wrap("quote type { List<int> }")) &&
            agree(wrap("quote type { fn(int) -> int }"))
        }
        then "`quote arm` parses identically to the hand" {
            agree("fn f(v: int) -> int {\n let q = quote arm { 1 -> 2 }\n return 0\n}\n")
        }
    }
    given "nesting — the reason this needs the scoped COUNTER and not a boolean" {
        // `@bump(quote_depth)` increments an INT cell across the body and restores it
        // after. The already-native splice branches read that cell:
        //   @when(at_quote_top)  "~" → bitnot   (depth 0)
        //   @when(in_quote_body) "~" → splice   (depth > 0)
        // A boolean flag would be indistinguishable from an int for ONE level and wrong
        // for two, so a flat quote proves nothing here — the nested case is the assertion.
        then "a splice inside a nested quote agrees with hand" {
            agree("fn f(x: int) -> int {\n let q = quote { quote { ~x } }\n return 0\n}\n")
        }
        then "`~` OUTSIDE any quote is still bitnot, not a splice" {
            agree("fn f(x: int) -> int {\n let y = ~x\n return y\n}\n")
        }
        then "the counter is RESTORED after the body, so a later `~` is bitnot again" {
            // HONEST SCOPE, measured: this does NOT discriminate against dropping `@bump`
            // — removing the marker removes the bump and the restore together, so `~y`
            // reads as bitnot either way and this stays green. (Verified by running the
            // negative control: deleting `@bump` fails the nested-splice case and the
            // emitted-source check, not this one.) What it DOES guard is a future emit
            // change that bumps without restoring — then `~y` would be read as a splice
            // and this diverges. Kept for that, not claimed as proof of the marker.
            agree("fn f(y: int) -> int {\n let q = quote { 1 }\n let z = ~y\n return z\n}\n")
        }
    }
    given "malformed quote forms" {
        // Both paths must REPORT, the same number of times, and recover to the same tree.
        then "truncated quote headers and bodies are reported on BOTH paths" {
            // Each on its own line of history: `quote` and `quote stmt` (a
            // header ending BEFORE the body's `{`) diverged 1-vs-2 until
            // quote_expr gained the spawn-idiom `@require body:block_expr`
            // gate (t-rd44 — surfaced the day this file's legs were actually
            // pinned; the pre-testkit `tree(static_raw, …)` ignored its flag
            // and every comparison here was one engine against itself).
            agree_bad(wrap("quote")) &&
            agree_bad(wrap("quote {")) &&
            agree_bad(wrap("quote stmt")) &&
            agree_bad(wrap("quote stmt {"))
        }
        then "malformed `type` / `arm` forms are reported on BOTH paths" {
            agree_bad(wrap("quote type")) &&
            agree_bad(wrap("quote type {")) &&
            agree_bad(wrap("quote arm {"))
        }
        then "an unknown kind word falls to the `{`-gate error, identically" {
            // An unrecognised kind word is not stmt/stmts/decl (and the
            // type/arm peeks declined), so the optional kind is skipped and
            // the @require `{` gate reports at the kind word. Pre-t-rd44 the
            // engines even RECOVERED differently here (emit collapsed the
            // program to one error node; exec kept the fn and localized) —
            // agree_bad now asserts count AND tree equality.
            agree_bad(wrap("quote badkind { 1 }"))
        }
        then "spawn/isolated truncated headers — the sibling gates (t-rd44)" {
            // `isolated` had the identical missing-@require divergence as the
            // bare `quote` (spawn already carried the gate and served as the
            // aligned-behavior control while diagnosing).
            agree_bad(wrap("spawn")) &&
            agree_bad(wrap("isolated"))
        }
        then "the gates report their PRECISE @expect text, not a cascade" {
            // agree_bad proves both engines say the same thing; this pins
            // WHAT they say — the gate's own message at the truncation, not
            // the outer `expected `}` after function body` cascade that was
            // the only survivor pre-t-rd44.
            msgs(mode_parse("emit", wrap("quote"), null)).contains("expected `{` to open the quote body") &&
            msgs(mode_parse("emit", wrap("quote stmt"), null)).contains("expected `{` to open the quote body") &&
            msgs(mode_parse("emit", wrap("isolated"), null)).contains("expected `{` after isolated")
        }
    }
}

// The ROUTING assertion, on the EMITTED SOURCE rather than by inference. t-47hc's routing
// discipline (slice 10) records the failure mode this catches: if the native rule's parse
// fn were emitted AFTER the `@hand` gate, the gate would swallow `quote` first and the
// native rule would be dead code with correct output and no diagnostic (#1028). Here the
// order is deliberately the OTHER way round — the hand gate is guarded by
// @peek(quote_special) and must come FIRST, with the unguarded native branch after it.
spec "t-bwjg: the emitted dispatch routes quote correctly" {
    then "the native rule fn is emitted at all" {
        checked_in_parser_source().contains("fn parse_quote_expr(")
    }
    then "the native rule bumps and RESTORES the counter around the body" {
        let src = checked_in_parser_source()
        src.contains("modes_with_counter_bumped(st.modes, \"quote_depth\")") &&
        // t-kd4y.3.4 — the lowering is feature-owned now, so the call is the
        // manifest ABI form: the rule-entry byte arrives as st.build_sp through
        // call_with_build_sp instead of as a positional `sp_start` argument.
        // Everything else about this fn is byte-identical through the flip.
        src.contains("call_with_build_sp(st, sp_start, mk_quote_abi,")
    }
    then "both guarded gates precede the unguarded native branch" {
        // Ordered choice: `quote arm` (still the hand's) and `quote type` (native, its own
        // rule) are BOTH peek-guarded and must be emitted BEFORE the unguarded
        // `parse_quote_expr` catch-all — otherwise the plain branch consumes `quote` first
        // and the two special kinds become dead code with no diagnostic (the #1028 failure
        // mode). Asserted on the EMITTED SOURCE rather than inferred from the grammar text.
        let src = checked_in_parser_source()
        let arm_gate = src.index_of("lookahead_ok(\"quote_arm\", st)")
        let type_gate = src.index_of("lookahead_ok(\"quote_type\", st)")
        let native = src.index_of("parse_quote_expr(st)")
        arm_gate >= 0 && type_gate >= 0 && native >= 0 &&
        arm_gate < native && type_gate < native
    }
    then "both non-block kinds lower to their own native rules, not to a hand leaf" {
        let src = checked_in_parser_source()
        src.contains("fn parse_quote_type_expr(") && src.contains("call_with_build_sp(st, sp_start, mk_quote_type_abi,") &&
        src.contains("fn parse_quote_arm_expr(") && src.contains("call_with_build_sp(st, sp_start, mk_quote_arm_abi,")
    }
    then "the generator derives the feature import, so nothing hand-lists it" {
        // The flip's other half: the adapters live in features/quote_expr/lowering
        // and the header line naming them is DERIVED from the manifest rows the
        // grammar carries (derived_import_lines_for) — there is no hand-kept
        // import list to drift. The engine no longer exports the cores at all.
        let src = checked_in_parser_source()
        src.contains("use features.quote_expr.lowering.{mk_quote_abi, mk_quote_arm_abi, mk_quote_type_abi}")
    }
}
