// ps3t.6.5.7 — the DECLARATION family, second slice: `type` (struct) and
// `enum` declarations. `type Foo = { field: T, … }` builds a Stmt.TypeDecl
// with a FieldEntry list; `enum Foo { Variant, Variant(field: T), … }` builds
// a Stmt.EnumDecl with a Variant list (each variant carrying its own
// FieldEntry payload). Both reuse the type family (6.5.6) for the field /
// variant-field types. The seam adds a struct-field target (CapVal.Field/
// Fields) and an enum-variant target (CapVal.Var/Vars).
//
// Oracle: run the DSL-generated parser AND the shipping hand-written parser
// (parser_new(src).parse_declaration()) over a corpus and assert identical
// ASTs via render_stmt_id.
//
// Scope: the struct form `type Name = { fields }` and `enum Name { variants }`.
// The non-brace `type` RHS forms (union alias `type X = A | B`, newtype/alias
// `type X = Other`, the `without`/`only` type operators), generic params
// `<T>`, trait associated types, and doc comments on variants are follow-up
// slices. Field / variant-field types render via vtype_display (which drops
// generic args — `List<int>` → `List`); both parsers use it, so `agree` holds.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_stmt}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id}

fn type_enum_grammar_src() -> string {
    "grammar Decl {\n" +
    "  decl       = type_decl | enum_decl\n" +
    "  type_decl  = \"type\" tname:IDENT \"=\" \"{\" ( fields:field \",\"? )* \"}\" -> MkTypeDecl(tname, fields)\n" +
    "  enum_decl  = \"enum\" ename:IDENT \"{\" ( vars:variant \",\"? )* \"}\" -> MkEnumDecl(ename, vars)\n" +
    "  field      = fname:IDENT \":\" ftype:type_expr -> MkField(fname, ftype)\n" +
    "  variant    = vname:IDENT ( \"(\" ( vfields:field \",\"? )* \")\" )? -> MkEVariant(vname, vfields)\n" +
    // ── type family (field + variant-field types) ──
    "  type_expr  = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom  = fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  fn_type    = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" tr:type_expr )? -> MkFn(lp, p, tr)\n" +
    "  dyn_type   = \"dyn\" dt:IDENT -> TyDyn(dt)\n" +
    "  list_type  = \"[\" el:type_expr \"]\" -> TyList(el)\n" +
    "  paren_type = \"(\" ( pt2:type_expr ( \",\" pt2:type_expr )* )? \")\" -> TyParen(pt2)\n" +
    "  named_type = tn:IDENT ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(tn, a, opt)\n" +
    "}"
}

fn dsl_stmt(src: string) -> string {
    let gp = parse_grammar(type_enum_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_stmt_id(r.store, r.root)
}

fn hand_stmt(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    dsl_stmt(src) == hand_stmt(src)
}

spec "grammar-DSL declaration family: type + enum == hand-written parser (ps3t.6.5.7)" {
    given "struct declarations" {
        then "single/multi-field, empty, and container/nominal field types agree" {
            agree("type P = { x: int }") &&
            agree("type Point = { x: int, y: int }") &&
            agree("type Named = { name: string, active: bool }") &&
            agree("type Empty = { }") &&
            agree("type Box = { items: List<int> }") &&
            agree("type Wrap = { inner: Foo, tag: string }")
        }
    }
    given "enum declarations — bare and payload variants" {
        then "all-bare, payload variants, and mixed agree" {
            agree("enum Color { Red, Green, Blue }") &&
            agree("enum Single { Only }") &&
            agree("enum Result { Ok(value: int), Err(msg: string) }") &&
            agree("enum Mixed { A, B(x: int), C }") &&
            agree("enum Pair { Both(a: int, b: string) }")
        }
    }
    given "the DSL trees are the expected shapes (sanity: really built the decl)" {
        then "canonical renders of representative forms" {
            dsl_stmt("type Point = { x: int, y: int }") == "(type Point (x:int, y:int))" &&
            dsl_stmt("type Empty = { }") == "(type Empty ())" &&
            dsl_stmt("enum Color { Red, Green, Blue }") == "(enum Color (Red(), Green(), Blue()))" &&
            dsl_stmt("enum Result { Ok(value: int), Err(msg: string) }") == "(enum Result (Ok(value:int), Err(msg:string)))"
        }
    }
}
