// SPLIT per t-kdyj.13's whale precedent (t-u602): as ONE file this
// differential's unit peaked 8773 MB under AVRA_RC_STRICT=1 (measured solo,
// quiet box) — past the solo-retry's runner-survival ceiling (~7871 MB), so
// its batch died as a MEMORY CEILING red on every rc-strict run while the
// blamed first-of-batch file used 75 MB. Each slice keeps the shared
// harness verbatim; coverage is the union of the three files.
// ps3t.6.7 / Step C — the grammar-DSL EXPRESSION family, grown toward selfhost
// fidelity. avra_expr_grammar has the full operator-precedence spine (logic_or ->
// ... -> unary -> postfix -> primary); this test proves it builds the same tree
// as the hand parser's parse_expression over the covered surface, and grows with
// the grammar. The mode primitives (interpolation @hand(template_expr), map/block
// @hand(brace_expr)) are wired into the primary here.
//
// Interpolated sources are built by concatenating a lone "$" with "{...}", so no
// interpolation syntax appears in this file (which would interpolate here).
use @std.avrac.features.grammar.{avra_expr_grammar, avra_program_grammar, run_grammar_expr_at}
use @std.avrac.parse.{oracle_expr}
use @std.avrac.core.{render_expr_id}

fn dsl(src: string) -> string {
    let r = run_grammar_expr_at(avra_program_grammar(), "expression", src)
    if r.had_error { return "<err>" }
    render_expr_id(r.store, r.root)
}

fn hand(src: string) -> string {
    oracle_expr(src) ?? "<err>"
}

fn agree(src: string) -> bool {
    let got = dsl(src)
    let want = hand(src)
    if got != want {
        println("expression grammar mismatch: ${src}")
        println("generated: ${got}")
        println("hand:      ${want}")
    }
    got == want
}

spec "ps3t.6.7/StepC: avra_expr_grammar == hand parse_expression (slice 1: literals, operators, postfix, modes)" {
    given "literals and identifiers" {
        then "numbers, bools, idents agree and are not errors" {
            dsl("1") != "<err>" &&
            agree("1") && agree("42") && agree("true") && agree("false") && agree("a") && agree("foo")
        }
    }
    given "binary operators across every precedence level" {
        then "arithmetic, comparison, equality, bitwise, shift, logical agree" {
            agree("1 + 2") && agree("1 - 2 - 3") && agree("1 * 2") && agree("1 / 2") && agree("1 % 2") &&
            agree("1 + 2 * 3") && agree("1 * 2 + 3") &&
            agree("1 < 2") && agree("1 <= 2") && agree("1 == 2") && agree("1 != 2") &&
            agree("1 | 2") && agree("1 & 2") && agree("1 ^ 2") && agree("1 << 2") && agree("1 >> 2") &&
            agree("a && b") && agree("a || b") && agree("a && b || c")
        }
    }
    given "grouping and postfix (field / index / call)" {
        then "parenthesised precedence and field/index/call suffixes agree" {
            agree("(1 + 2) * 3") && agree("1 * (2 + 3)") &&
            agree("a.b") && agree("a.b.c") && agree("f(1)") && agree("f(1, 2)") &&
            agree("a[0]") && agree("a[0][1]") && agree("f(a + 1)")
        }
    }
    given "the wired mode primitives (interpolation, map/block)" {
        then "interpolated strings and brace literals agree" {
            let d = "$"
            agree("\"" + "hi " + d + "{x}" + "\"") &&
            agree("{ \"k\": 1 }") &&
            agree("{ y }")
        }
    }
    given "the ident-primary @hand: struct literals (Ident { ... }) + postfix" {
        then "struct literals, nested fields, and struct-then-postfix agree" {
            dsl("Foo { x: 1 }") != "<err>" &&
            agree("Foo { x: 1 }") &&
            agree("Point { x: 1, y: 2 }") &&
            agree("Foo { x: a + 1 }") &&
            agree("Foo { x: 1 }.x")
        }
    }
    given "prefix unary operators (logical not, bitwise not, negation)" {
        then "unary on idents and nesting agree" {
            agree("!x") && agree("~b") && agree("-a") &&
            agree("!!x") && agree("- -a") && agree("!(a && b)") &&
            agree("-a + b") && agree("!x || y")
        }
        then "the `not` keyword prefix (Phase 3a: grammar-owned) agrees" {
            // `not` joins `!`/`-` as a grammar-owned prefix op (unary rule). `not`
            // is NOT dogfooded in compiler src/, so the selfhost diff-test never
            // exercises it — this equivalence check is the real guard. `~` bitnot at
            // quote_depth==0 is ALSO grammar-owned now (Phase 3a-5, @when(at_quote_top));
            // the `~b`/`~a * ~b`/`~(a + b)` cases exercise the grammar branch, while the
            // SPLICE path (`~` at quote_depth>0) is guarded by composed_program_test's
            // splice-in-quote case (falls through to @hand there).
            agree("not x") && agree("not not x") &&
            agree("not a && b") && agree("not a || b") &&
            agree("not (a == b)") && agree("not ~a") &&
            agree("~a * ~b") && agree("~(a + b)")
        }
    }
    given "literal-base postfix chains (Phase 3a-7: grammar-owned NUMBER/STRING/BOOL/null/none/.Variant base + seeding)" {
        then "string/number/bool/null/none/.Variant literals thread into the postfix + `with` loop identically to hand" {
            // The grammar now OWNS NUMBER/STRING as the postfix-loop BASE (before the
            // @hand tail). This exercises the exec_seq base-seeding hook: a grammar-built
            // literal base must seed st.postfix_base so the first postfix_suffix wraps it,
            // exactly like the @hand base does via run_hand_expr. Repeated constants also
            // check the literal_node interning fix (hash-cons parity with hand alloc_leaf).
            agree("\"hi\".length") && agree("\"a\"[0]") && agree("\"x\".foo(1)") &&
            agree("\"a\".b.c") && agree("\"p\" with { x: 1 }") &&
            agree("5?") && agree("5!") && agree("42[0]") &&
            agree("1 + 1") && agree("\"a\" + \"a\"") &&
            // bool literal base (slice 2: grammar-owned BOOL → literal_node)
            agree("true") && agree("false") && agree("true && false") &&
            agree("true.foo") && agree("false == true") && agree("!true") &&
            agree("true with { x: 1 }") &&
            // null/none literal base (slice 3: grammar-owned via string terminal → Expr.None)
            agree("null") && agree("none") && agree("null ?? 1") &&
            agree("none ?? x") && agree("null.foo") && agree("null == none") &&
            // .Variant enum-ctor base (slice 4: grammar-owned variant_ctor rule → mk_enum_ctor)
            agree(".None") && agree(".Some(1)") && agree(".Pair(1, 2)") &&
            agree(".Some(1).foo") && agree(".Ok(x) ?? y") && agree(".Wrap(.Inner(x))") &&
            agree(".Point(1, 2).x") && agree(".Some(a + 1)")
        }
    }
    given "string literals and mixed nesting" {
        then "plain strings, deep grouping, and mixed operators agree" {
            agree("\"hi\"") && agree("\"\"") &&
            agree("((1 + 2) * (3 - 4))") &&
            agree("a.b.c + f(1)[2]") &&
            agree("a && b == c + d * e")
        }
    }
}
