// ps3t.6.5.7 — the DECLARATION family, first slice: `fn` declarations. This
// is the COMPOSING family: a `fn name(params) -> ret { body }` threads the
// type family (6.5.6, for each param's `: type` annotation and the return
// type) into the statement family (6.5.3/.4, for the body statement list).
// The seam adds a parameter-entry target (CapVal.PEntry/PEntries + MkParam)
// and the MkFnDecl build → Stmt.Function.
//
// Oracle: run the DSL-generated parser AND the shipping hand-written parser
// (parser_new(src).parse_declaration() — `fn` is a decl_keyword parser) over
// a fn corpus and assert identical ASTs via render_stmt_id.
//
// Scope (fn first, the rest of the family follows): the core
// `fn name(params) -> ret { body }`. `export fn`, generic `fn<T: Bound>`,
// `extern fn`, `where` clauses, and the type/enum/trait/impl/use decls are
// separate follow-up slices. Un-annotated params default to Int and an absent
// return type to Void, matching parse_param_list / parse_function_declaration.
// Bodies use a modest statement subset (break/continue/return-expr/expr-stmt),
// enough to prove the type→statement composition; the full body statement set
// is already proven in 6.5.2/6.5.3/6.5.4.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_stmt}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id}

fn fn_grammar_src() -> string {
    "grammar Decl {\n" +
    "  fn_decl    = \"fn\" name:IDENT \"(\" ( params:param ( \",\" params:param )* )? \")\" ( \"->\" ret:type_expr )? \"{\" ( body:statement )* \"}\" -> MkFnDecl(name, params, ret, body)\n" +
    "  param      = pname:IDENT ( \":\" pt:type_expr )? -> MkParam(pname, pt)\n" +
    // ── body statement subset ──
    "  statement  = break_stmt | continue_stmt | return_stmt | expr_stmt\n" +
    "  break_stmt = \"break\" -> Break()\n" +
    "  continue_stmt = \"continue\" -> Continue()\n" +
    "  return_stmt = \"return\" re:expression -> Return(re)\n" +
    "  expr_stmt  = es:expression -> ExprStmt(es)\n" +
    // ── type family (param + return annotations) ──
    "  type_expr  = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom  = fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  fn_type    = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" tr:type_expr )? -> MkFn(lp, p, tr)\n" +
    "  dyn_type   = \"dyn\" dt:IDENT -> TyDyn(dt)\n" +
    "  list_type  = \"[\" el:type_expr \"]\" -> TyList(el)\n" +
    "  paren_type = \"(\" ( pt2:type_expr ( \",\" pt2:type_expr )* )? \")\" -> TyParen(pt2)\n" +
    "  named_type = tn:IDENT ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(tn, a, opt)\n" +
    // ── expression family (bodies) ──
    "  expression = equality\n" +
    "  equality   = l:comparison ( op:(\"!=\" | \"==\") r:comparison )* -> fold_binary(l, op, r)\n" +
    "  comparison = l:term ( op:(\"<\" | \"<=\" | \">\" | \">=\") r:term )* -> fold_binary(l, op, r)\n" +
    "  term       = l:factor ( op:(\"+\" | \"-\") r:factor )* -> fold_binary(l, op, r)\n" +
    "  factor     = l:un ( op:(\"*\" | \"/\") r:un )* -> fold_binary(l, op, r)\n" +
    "  un         = op:(\"!\" | \"-\") operand:un -> Unary(op, operand) | primary\n" +
    "  primary    = NUMBER | STRING | \"true\" | \"false\" | @hand(ident)\n" +
    "             | \"(\" e:expression \")\" @expect(\")\", \"expected ')'\") @recover(sync_to: \")\") -> Grouping(e)\n" +
    "}"
}

fn dsl_stmt(src: string) -> string {
    let gp = parse_grammar(fn_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_stmt_id(r.store, r.root)
}

fn hand_stmt(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    dsl_stmt(src) == hand_stmt(src)
}

spec "grammar-DSL declaration family: fn == hand-written parser (ps3t.6.5.7)" {
    given "signatures — params + return types" {
        then "no-arg, return types, single/multi params, and annotations agree" {
            agree("fn f() { }") &&
            agree("fn f() -> int { }") &&
            agree("fn f(x: int) { }") &&
            agree("fn add(a: int, b: int) -> int { }") &&
            agree("fn g(items: List<int>) -> bool { }") &&
            agree("fn h(s: string, n: int) -> string { }")
        }
    }
    given "un-annotated params (default Int) + nullable/fn param types" {
        then "bare param, nullable annotation, and a fn-typed param agree" {
            agree("fn f(x) { }") &&
            agree("fn f(x: int?) { }") &&
            agree("fn apply(cb: fn(int) -> bool) -> bool { }")
        }
    }
    given "bodies — the type→statement composition" {
        then "return-expr, break, expr-stmt, and multi-statement bodies agree" {
            agree("fn h() -> int { return 5 }") &&
            agree("fn k() { break }") &&
            agree("fn m(a: int) -> int { return a }") &&
            agree("fn p() { 1 + 2 }") &&
            agree("fn q() { break continue }")
        }
    }
    given "the DSL trees are the expected shapes (sanity: really built a Function)" {
        then "canonical renders of representative forms" {
            dsl_stmt("fn f() { }") == "(fn f () -> void )" &&
            dsl_stmt("fn add(a: int, b: int) -> int { }") == "(fn add (a:int, b:int) -> int )" &&
            dsl_stmt("fn f(x) { }") == "(fn f (x:int) -> void )" &&
            dsl_stmt("fn k() { break }") == "(fn k () -> void (break))"
        }
    }
}
