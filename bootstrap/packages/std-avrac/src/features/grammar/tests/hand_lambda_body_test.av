// WHY: t-47hc (paren_expr flip prep) — the DORMANT @hand(lambda_body) expr delegate.
// The paren_expr flip's lambda body (`( … ) -> body`) can be a block `{ … }` (which
// parse_block_expression builds as Expr.Block over a STATEMENT list — coupled to the
// still-@hand statement machinery, NOT grammar-native) OR a bare expression. So the flip
// delegates the body to the exact hand parse_lambda_body (closures/parser.av) via this
// @hand(lambda_body) leaf rather than re-expressing it — the byte-identity-safe choice.
//
// DORMANT: no production grammar references `lambda_body` yet, so the generated parsers
// regen byte-identical (emit-gen-check GENPASS). This wires the delegate consistently
// across BOTH consumers — the executor (is_expr_hand + hand_starts + run_hand_expr →
// bp.parse_lambda_body) and the emitter (is_expr_hand_name + hand_first_guard, FIRST =
// tok_starts_expr_leaf) — and proves it dispatches BOTH parse_lambda_body branches (bare
// expression AND block), so the paren spend can compose `"->" b:@hand(lambda_body)` and
// get either body form for free.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr}
use @std.avrac.core.{render_expr_id}

// `-> body` where body is @hand(lambda_body). The leading `->` is a fixed literal so the
// delegate is entered at the body (non-FIRST position, exactly as the paren flip uses it).
fn body_g() -> string { "r = \"->\" b:@hand(lambda_body) -> b" }

fn run_render(input: string) -> string {
    let gp = parse_grammar(body_g())
    let r = run_grammar_expr(gp.grammar, input)
    render_expr_id(r.store, r.root)
}

spec "t-47hc: @hand(lambda_body) delegate dispatches the EXPRESSION body" {
    then "a bare-expression body parses as the expression" {
        run_render("-> 5") == "5"
    }
    then "an arithmetic-expression body parses through" {
        run_render("-> 1 + 2") == "(+ 1 2)"
    }
}

spec "t-47hc: @hand(lambda_body) delegate dispatches the BLOCK body (parse_block_expression)" {
    // parse_lambda_body's OTHER branch: a `{ … }` body becomes an Expr.Block over a hand-
    // parsed STATEMENT list. run_grammar_expr threads the real source and — with
    // hand_delegate == null — builds a FRESH statement-capable Parser (parser_new_with_store),
    // whose stmt_flip=false routes the block's body through the normal hand statement
    // machinery. So BOTH parse_lambda_body branches are exercised here, not just the
    // expression one (the paren flip needs both — a lambda's body is routinely a `{ … }`).
    then "a single-statement block body builds an Expr.Block over the statement list" {
        run_render("-> { 5 }") == "(block-expr (expr 5))"
    }
    then "a multi-statement block body parses every statement in source order" {
        run_render("-> { 5\n 6 }") == "(block-expr (expr 5)\n(expr 6))"
    }
    then "a block with a real declaration statement parses through the hand statement machinery" {
        run_render("-> { let x: int = 1\n x + 2 }") == "(block-expr (let x:int 1)\n(expr (+ x 2)))"
    }
    then "an empty block body builds an empty Expr.Block" {
        run_render("-> { }") == "(block-expr )"
    }
}
