// WHY: features/WHY.md declares an EXHAUSTIVE canonical file set for a feature
// directory. Until `diagnose.sh --check-feature-layout` existed, that was a doc
// claim — and both WHY.md and CLAUDE.md asserted the layout was "enforced"
// while nothing enforced it. A rule that reads as a gate and cannot fail is
// worse than no rule, so this spec exists to keep the gate honest.
//
// It mirrors codegen/tests/layout_boundary_lint_test.av: drive the real script,
// assert it PASSES on the tree as it stands, and assert it FAILS when the
// invariant is broken — the anti-vacuity half, without which a lint that always
// returned 0 would look identical to a lint that works.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int

spec "the feature-layout lint is real" {
    then "it passes on the tree as it stands" {
        avra_shell_exec_status("bash scripts/diagnose.sh --check-feature-layout >/dev/null 2>&1") == 0
    }
    then "an OFF-LIST file makes it FAIL — the anti-vacuity half" {
        // Plant a file that is on no canonical name and no allowlist entry.
        // `defer` is not available here (the shell-out is the cleanup), so the
        // removal is unconditional and runs before the assertion is evaluated.
        let planted = "packages/std-avrac/src/features/tuples/not_a_canonical_name.av"
        let _ = avra_shell_exec("printf '// planted by feature_layout_lint_test\\n' > '${planted}'")
        let rc = avra_shell_exec_status("bash scripts/diagnose.sh --check-feature-layout >/dev/null 2>&1")
        let _ = avra_shell_exec("rm -f '${planted}'")
        rc != 0
    }
    then "and it passes again once the planted file is gone" {
        // Proves the previous case cleaned up after itself, so a failure here
        // means the planted file leaked rather than the lint being wrong.
        avra_shell_exec_status("bash scripts/diagnose.sh --check-feature-layout >/dev/null 2>&1") == 0
    }
}

spec "the lint names non-feature directories rather than mis-reporting them" {
    then "a subsystem directory is named as ACCEPTED, not as drift and not as a missing mod.av" {
        // derive/, marshal/, walker/, comptime/ and friends define ZERO
        // *_lang() and are not registered in features/mod.av. They are @derive
        // and comptime MACHINERY. Requiring mod.av of them would report a
        // missing FILE when the real finding is a misplaced DIRECTORY.
        //
        // They used to be reported as "(not a feature … P4c)" — i.e. as work
        // pending relocation. P4c relocated only `eval` (a genuine pass) and
        // the user ruled the rest STAY, so that label described work that will
        // not happen. They are ACCEPTED now: still listed, because "features/
        // means a language feature" having named exceptions is the point, but
        // no longer counted as drift.
        let out = avra_shell_exec("bash scripts/diagnose.sh --check-feature-layout --list 2>&1")
        out.contains("ACCEPTED here by decision") && out.contains("derive") && out.contains("walker")
    }
    then "an UNLISTED non-feature directory is still DRIFT — the acceptance is not a blanket exemption" {
        // The accepted set only means something if a NEW non-feature directory
        // still FAILS. Otherwise "ACCEPTED" would have quietly become a blanket
        // exemption for the whole category, which is the opposite of the point.
        // Same plant-and-clean idiom as the OFF-LIST case above.
        let d = "packages/std-avrac/src/features/zz_unlisted_probe"
        let _ = avra_shell_exec("mkdir -p '${d}' && printf 'export fn zz_helper() -> int { 1 }\n' > '${d}/mod.av'")
        let out = avra_shell_exec("bash scripts/diagnose.sh --check-feature-layout --list 2>&1")
        let rc = avra_shell_exec_status("bash scripts/diagnose.sh --check-feature-layout >/dev/null 2>&1")
        let _ = avra_shell_exec("rm -rf '${d}'")
        rc != 0 && out.contains("no decision on record")
    }
    then "and it passes again once the planted directory is gone" {
        avra_shell_exec_status("bash scripts/diagnose.sh --check-feature-layout >/dev/null 2>&1") == 0
    }
}
