// ps3t.6.5.11 (whole-program) — emit.av RENDERS the generated static parser for
// the UNIFIED whole-program grammar (avra_program_grammar's 41 rules): the
// declarations + their sub-structure, the control-flow statements, the type
// atoms, and the expression precedence chain, with the gnarly-5% via @hand. Every
// declaration + control-flow build lowers to the SHARED constructor cores the
// executor calls (mk_fn_decl / mk_type_decl / mk_use / mk_impl / mk_while / … ),
// and the component rep captures type per their new element kinds (ParamEntry /
// FieldEntry / Variant). This is the ≈6.5.12 swap-in. Fast in-suite structural
// guard on the emitter; the executor differential is composed_program_test and
// the airtight behavioural gate is diagnose.sh --emit-gen-check (whole-program family).

use @std.avrac.features.grammar.{avra_program_grammar, emit_parser_source}

fn emit_all() -> string {
    emit_parser_source(avra_program_grammar())
}

spec "grammar emitter: renders the whole-program generated static parser" {
    then "the program + declaration rules emit their parse fns" {
        let src = emit_all()
        src.contains("fn parse_program(st: PState) -> CapVal") &&
        src.contains("fn parse_declaration(st: PState) -> CapVal") &&
        src.contains("fn parse_fn_decl(st: PState) -> CapVal") &&
        src.contains("fn parse_impl_decl(st: PState) -> CapVal") &&
        src.contains("fn parse_use_decl(st: PState) -> CapVal")
    }

    then "the component rep captures type per their new element kinds" {
        let src = emit_all()
        src.contains("mut params_list: List<ParamEntry> = []") &&
        src.contains("mut fields_list: List<FieldEntry> = []") &&
        src.contains("mut vars_list: List<Variant> = []") &&
        // `field` and `variant` are GATED, so their capture is two-step (t-myz7): the
        // call binds to `__gres<idx>` and the abort is read BEFORE the coercion, which would
        // otherwise report over an aborted sub-parse's silent error node. `param` is
        // ungated and keeps the direct form — which is the contrast worth pinning.
        src.contains("params_list.push(capval_to_pentry(st, parse_param(st)))") &&
        src.contains("fields_list.push(capval_to_field(st, __gres0))") &&
        src.contains("vars_list.push(capval_to_variant(st, __gres0))")
    }

    then "the declaration builds lower to the SHARED constructor cores" {
        let src = emit_all()
        // `0 - 1`, not `sp_start`: a `Stmt.Block` is NOT stamped. The hand builds its
        // only one with `alloc_stmt_leaf` (no record_pos) and the interpreter passes
        // `0 - 1`; emit threading the `{` byte was a divergence from both, and the extra
        // row it recorded is what `Ctx.source_line` then inherited. See the `Block` note
        // in emit.av's build_uses_sp_start.
        src.contains("mk_block(st, 0 - 1, d_list)") &&
        // `fn` carries an optional type-param list since t-47hc slice 10.6, so it lowers
        // to the GENERIC core — one rule serves both forms, with an empty capture when
        // no `<…>` is present. Since t-47hc.5 it also carries an optional WHERE clause,
        // which is why the core is the `_where_` one: the clause MERGES into the
        // bracket parameters (a fold nothing in the DSL can express), so it needs a
        // build that sees both lists, not a wider capture. `extern fn` is a SEPARATE
        // rule (different lead keyword, bodyless, different node), and its core was
        // executor-only until 10.6.
        src.contains("mk_fn_decl_where_g(st, capval_tok_text(name), tparams_list, params_list, ret, capval_present(ret), body_list, wp_list)") &&
        src.contains("mk_extern_fn(st, capval_tok_text(ename)") &&
        // `type` lowers to ONE core covering every RHS the hand produces (10.5): the
        // brace form, the newtype wrapper, the union alias, and the `without` / `only`
        // operators. The hand picks between them AFTER parsing the RHS — from the
        // resulting TypeExpr, not from tokens — so the trifurcation has to live in the
        // builder, and there is a single build rather than four.
        src.contains("mk_type_decl_any(st, capval_tok_text(tname), tparams_list, fields_list,") &&
        // `use` SPLITS on the `@`-package prefix (t-47hc slice 10.1): the two branches
        // are FIRST-disjoint inside `use_tail`, so the package scope is its own capture
        // and each lowers to a distinct core rather than one call with a presence flag.
        src.contains("mk_use_pkg(st, capval_tok_list(upkg), useg_list, unames_list)") &&
        src.contains("mk_use(st, false, useg_list, unames_list)") &&
        src.contains("mk_impl(st, capval_tok_text(itn), ifortn, capval_present(ifortn), imethods_list)") &&
        src.contains("mk_trait_method(st, capval_tok_text(tmname), tmparams_list, tmret, capval_present(tmret), capval_present(tmlb), tmbody_list)")
    }

    then "the control-flow builds lower to the SHARED statement cores" {
        let src = emit_all()
        src.contains("mk_while(st, sp_start, c, body)") &&
        src.contains("mk_if(st, sp_start, c, t, e)") &&
        src.contains("mk_for_loop(st, sp_start, v, lo, hi, body)")
    }

    then "every form is native — let, quote, qualified types, return" {
        let src = emit_all()
        src.contains("fn parse_let_decl(st: PState) -> CapVal") &&
        src.contains("fn parse_quote_expr(st: PState) -> CapVal") &&
        src.contains("mk_qualified_type(qname_list, qa_list.length > 0, qa_list, capval_present(qopt))") &&
        src.contains("fn parse_return_stmt(st: PState) -> CapVal") &&
        src.contains("mk_return_opt(st, e)")
    }
}
