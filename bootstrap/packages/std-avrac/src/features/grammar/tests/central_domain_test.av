// WHY: t-kd4y.3.1 — the purity ledger's guard. The engine's central build
// surface is classified by ONE question (does a user's program SPELL it?):
// never-spelled DSL mechanism lives in engine_core_builds (12 names, each
// documented at the list); everything feature-owned sits in unflipped_builds
// until its family PR deletes it. `diagnose.sh --check-central-domain` is the
// textual equation (central_build_kind's domain == ledger minus tableless,
// executor arm heads all classified) — mutation-verified at landing: planting
// an overlap and deleting a ledger entry each failed the lint naming the
// exact name. The in-process arms below keep the semantic invariants in the
// suite without shelling per assertion.
//
// @@fixture-stateful@@ — shells out to the SHARED scripts/diagnose.sh
// (external state not in the fixture-cache key); opt out of failure caching
// so a repaired lint re-probes instead of replaying a stale `: FAIL`.

use @std.avrac.core.{avra_shell_exec_status}
use @std.avrac.features.grammar.{engine_core_builds, unflipped_builds, central_tableless_builds, central_build_kind, str_in}

fn dup_free(xs: List<string>) -> bool {
    mut i = 0
    while i < xs.length {
        mut j = i + 1
        while j < xs.length {
            if xs[i] == xs[j] { return false }
            j = j + 1
        }
        i = i + 1
    }
    true
}

fn disjoint(a: List<string>, b: List<string>) -> bool {
    for x in a { if str_in(b, x) { return false } }
    true
}

spec "t-kd4y.3.1: the purity ledger classifies the central surface exactly" {
    then "the domain lint is green on the real tree" {
        avra_shell_exec_status("bash scripts/diagnose.sh --check-central-domain >/dev/null 2>&1") == 0
    }
    then "engine-core and unflipped are disjoint, both dup-free" {
        disjoint(engine_core_builds(), unflipped_builds()) &&
            dup_free(engine_core_builds()) && dup_free(unflipped_builds()) &&
            dup_free(central_tableless_builds())
    }
    then "every ledgered name is REAL: it classifies centrally or is declared tableless" {
        // A flip that deletes a table row but forgets the ledger line dies
        // here (and in the lint) — no stale countdown entries.
        mut ok = true
        for n in engine_core_builds() {
            if central_build_kind(n) == "" && !str_in(central_tableless_builds(), n) { ok = false }
        }
        for n in unflipped_builds() {
            if central_build_kind(n) == "" && !str_in(central_tableless_builds(), n) { ok = false }
        }
        ok
    }
    then "tableless names never silently gain a kind row" {
        // If one does, it must LEAVE central_tableless_builds — the lint's
        // ghost-set equation enforces the same from the textual side.
        mut ok = true
        for n in central_tableless_builds() {
            if central_build_kind(n) != "" { ok = false }
        }
        ok
    }
    then "the engine core stays EXACTLY the DSL mechanism — growing it is a deliberate act" {
        // The purity ratchet: adding an engine-core name means editing this
        // spec too, so it cannot happen as a side effect of a flip. The
        // deliberate eighth (t-kd4y.3.5.7): fold_postfix_with RECLASSIFIED
        // from the .3.5.7 unflipped group — it is the postfix+with FOLD the
        // ~24 spine `unary` branches spell, the same machine class as
        // fold_binary/fold_postfix, and ownership follows the referencing
        // rule (the spine), never the ticket a name was filed under.
        // The deliberate ninth-through-twelfth (t-kd4y.3.5.8):
        //   field_suffix / index_suffix / call_suffix — the PARTIAL-suffix
        //   vocabulary of the DSL's own fold_postfix (missing-subject
        //   FieldAccess/Index/Call the fold rebinds). Spelled only by
        //   user/test grammars, never by a feature or the spine — a user
        //   cannot use fold_postfix without them, so they are the machine.
        //   NOT the production rules of the same names (those are grammar
        //   RULES in feature fragments; builds and rules are separate
        //   namespaces).
        //   MkExprBlock — `{ stmt* }` in expression position, spelled ONLY
        //   by the spine's block_expr primary: the fold_postfix_with
        //   rationale verbatim.
        // The deliberate thirteenth and fourteenth (t-kd4y.3.5.9):
        //   MkDocAnnotated — spelled by TWO features' rules (annotations'
        //   doc_decl AND impl_decl's impl_member), so no single feature may
        //   supply it without orphaning the other's reference: shared
        //   vocabulary, the MkStampAt class.
        //   MkAnnotated — spelled ONLY by decl_annotation_test's toy
        //   grammar (production annotations are annot_decl ->
        //   MkAnnotatedArgs, feature-owned): toy vocabulary, the
        //   field_suffix class. Tableless, so it also rides
        //   central_tableless_builds.
        engine_core_builds().length == 14
    }
}
