// WHY: t-47hc Phase 4 — `let` / `mut` / `const` leave `@hand(decl_hand)`.
//
// The bindings are the highest-traffic residue of the hand delegate: every binding
// statement in every routed body used to detour through `@hand(decl_hand)`. What this
// file pins is the same set of properties the `use`/`mod` increment pinned
// (decl_flip_use_mod_native_test — the #1028 dead-code and #1054/#1059 recovery
// regressions are the reason each is asserted structurally rather than inferred),
// plus the two properties NEW to this slice:
//
//  1. THE GENSYM MINT ORDER. The guard form desugars through a fresh `$letelse$N`
//     name, and the hand mints it AFTER parsing the else statement
//     (`build_let_else`: parse, check divergence, THEN `fresh`). The rule places
//     `tmp:@gensym(letelse)` after `e:statement` to match, and the emitted source is
//     the only place that ordering is visible — a regeneration that reorders it
//     desynchronizes the hygiene sequences the moment any other mint lands between.
//
//  2. THE SPECULATIVE SCAFFOLD RESTORES THE GENSYM COUNTER. A rolled-back
//     `let … else` has already minted; without `set_gensym_seq` in the rollback the
//     hand's re-parse mints `$letelse$2` where the pure hand path mints `$letelse$1`
//     — IR-divergent on the SAME valid program, which diff-test reads as a compiler
//     bug. (Caught live on the non-diverging-else corpus case.)
//
// Recovery parity for malformed forms lives in error_recovery_differential_test
// (the routed-keyword blocks, both specs); this file owns dispatch, scaffold and
// acceptance-frontier structure, and the valid forms the compiler's own source uses.

use @std.avrac.features.grammar.{avra_decl_dispatch_grammar, emit_parser_source_ex, emitted_rule_body, emitted_rule_speculates}
use @std.avrac.core.{avra_shell_exec_status, avra_selfhost_write_file, avra_selfhost_read_file}

fn decl_src() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}

// Same status-plus-log shape as decl_flip_use_mod_native_test: the exit code is half
// the assertion, and `|| true` would throw it away.
fn check_out(name: string, env: string, src: string) -> string {
    let fixture = "build/_decl_binding_${name}.av"
    let log = "build/_decl_binding_${name}.log"
    let _ = avra_selfhost_write_file(fixture, src)
    let rc = avra_shell_exec_status("${env} ./build/bs2 check '${fixture}' > '${log}' 2>&1")
    "__status=${rc}\n" + avra_selfhost_read_file(log)
}

fn clean(out: string) -> bool { out.contains("__status=0\n") }

/// Compile-clean on all FOUR parser paths (default, emit-raw, executor, hand) —
/// the split_gt_rollback_test shape. The default path alone can hide a native-rule
/// failure behind the interpreter fallback; emit-raw (`AVRA_NO_STATIC_FALLBACK=1`)
/// is the assertion that the GENERATED rule itself owns the form.
fn clean_all_paths(name: string, src: string) -> bool {
    // t-bw9s: two DISTINCT routings survive here — production (the generated static
    // parser) and the grammar EXECUTOR. The `_emit` and `_hand` legs pinned
    // AVRA_NO_STATIC_FALLBACK and AVRA_PARSER_DECL_FLIP; both flags are dead (the
    // interpreter re-parse fallback went in t-47hc.4.3, the decl hand parser with the
    // `@hand(decl_hand)` leaf), so those legs had become empty-env duplicates of
    // `_dflt`. Keeping them would report four paths while exercising two.
    clean(check_out("${name}_dflt", "", src)) &&
        clean(check_out("${name}_exec", "AVRA_PARSER_DECL_STATIC=0", src))
}

spec "t-47hc Phase 4: the bindings are emitted as native rules" {
    then "all three parse fns exist in the production declaration parser" {
        let src = decl_src()
        src.contains("fn parse_let_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_mut_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_const_decl(st: PState) -> CapVal")
    }

    then "they are dispatched, and NO decl_hand gate survives (t-47hc.4.3)" {
        let src = decl_src()
        let let_at = src.index_of("parse_let_decl(st)")
        let mut_at = src.index_of("parse_mut_decl(st)")
        let const_at = src.index_of("parse_const_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        // t-47hc.4.3 — the leaf is DELETED, so this no longer asserts "dispatches before
        // the `decl_hand` gate"; it asserts there is no gate to dispatch before. That is
        // strictly stronger: an ordering claim is satisfiable by a gate that still exists,
        // `hand_at < 0` only by its absence. The positive half stays — the rule must still
        // be reached from the dispatcher, or it is dead code with correct output.
        let_at >= 0 && mut_at >= 0 && const_at >= 0 && hand_at < 0
    }

    then "each routed branch is SPECULATIVE and its rollback restores the gensym counter" {
        let src = decl_src()
        // Sliced PER RULE, never file-wide: the emitter renders byte-identical
        // speculative scaffolding into dozens of rules, so a `src.contains(...)` here
        // passes off some other rule's copy and cannot fail for the rule it names.
        //
        // The `@try`/`@cut` pair lives INSIDE each binding rule now (routing `let`
        // moved it there, so the dispatcher references all three bare — the shape
        // `mut`/`const` already had). The property asserted is unchanged: the branch
        // is speculative, and its rollback restores the store, the cursor, the hand
        // state AND the hygiene counter (property 2 in the WHY).
        mut ok = true
        for head in ["fn parse_let_decl(st: PState) -> CapVal",
                     "fn parse_mut_decl(st: PState) -> CapVal",
                     "fn parse_const_decl(st: PState) -> CapVal"] {
            let body = emitted_rule_body(src, head)
            if !(emitted_rule_speculates(src, head) &&
                 body.contains("if st.diags.length == s_diags && st.had_error == s_err {") &&
                 body.contains("st.restore_hand_state(s_hand)") &&
                 body.contains("st.set_gensym_seq(s_gensym)")) {
                println("not speculative / incomplete rollback: ${head}")
                ok = false
            }
        }
        ok
    }

    then "the guard form mints its gensym AFTER the else statement, as the hand does" {
        // Property 1 in the WHY: within parse_let_decl, `parse_statement` (the else
        // arm) must precede the `letelse` mint. index_of finds the FIRST mint, which
        // lives in parse_let_decl (parse_mut_decl's copy follows it).
        let src = decl_src()
        let let_fn = src.index_of("fn parse_let_decl(st: PState)")
        let mint = src.index_of("gensym_token(st, \"letelse\")")
        let else_parse = src.index_of("e = parse_statement(st)")
        let_fn >= 0 && mint > let_fn && else_parse > let_fn && else_parse < mint
    }

    then "the alternation TAIL is still native `statement`, not a promoted @hand" {
        let src = decl_src()
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        let tail_at = src.index_of("    parse_statement(st)\n}")
        // t-47hc.4.3: the gate this used to sit after is deleted, so the claim is now
        // simply that the tail IS `parse_statement(st)` and NO hand leaf survives.
        tail_at >= 0 && hand_at < 0
    }

    then "the destructure rule is PREDICTIVE and dispatches BEFORE let_decl (no hand gate remains)" {
        // letdes_decl used to sit AFTER let_decl and be reached by ROLLBACK: `let (` made
        // let_decl's `n:IDENT` report, the dispatcher's `@try` unwound, and this rule got
        // its turn. Routing `let` (t-47hc.5 Phase 4) ends that — `@try "let" @cut` commits
        // let_decl at the keyword, so there is no rollback left to fall through.
        //
        // It is dispatched FIRST instead, and predictively: its own body opens with
        // `@peek(let_destructure)`, which consumes nothing when the form is not a
        // destructure, so `let x = 1` still reaches let_decl on the next branch. The
        // failure this ordering fixes is visible: `let (a, b) =` (missing initializer)
        // reported let_decl's "expected variable name" on the `(` instead of the hand's
        // F0040 for the absent expression.
        let src = decl_src()
        let des_at = src.index_of("parse_letdes_decl(st)")
        let let_at = src.index_of("parse_let_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        // The gate is emitted at the DISPATCH SITE, not inside the rule: a leading
        // `@peek` is the branch's FIRST guard, so emit hoists it to the caller and the
        // rule fn body starts at the `let`. Asserted as the exact guarded dispatch, so
        // a regeneration that drops the lookahead (leaving a bare `text == "let"` that
        // swallows every binding) fails here rather than only in the recovery corpus.
        src.contains("fn parse_letdes_decl(st: PState) -> CapVal") &&
            src.contains("if lookahead_ok(\"let_destructure\", st) && (st.cur().text == \"let\") {\n        return parse_letdes_decl(st)") &&
            des_at >= 0 && let_at >= 0 && hand_at < 0 &&
            des_at < let_at
    }
}

spec "t-47hc Phase 4: every binding form the compiler itself writes parses on all four paths" {
    then "plain, annotated, `let mut`, bare `mut`, and `const` bindings compile clean" {
        clean_all_paths("plain",
            "fn main() {\n" +
            "    let a = 1\n" +
            "    let b: int = 2\n" +
            "    let mut c = 3\n" +
            "    mut d: int = 4\n" +
            "    const E = 5\n" +
            "    c = a + b + d + E\n" +
            "    println(string(c))\n" +
            "}\n")
    }

    then "the guard form `let v = x else { … }` compiles clean everywhere" {
        clean_all_paths("letelse",
            "fn pick(o: int?) -> int {\n" +
            "    let v = o else { return 0 }\n" +
            "    v\n" +
            "}\n" +
            "fn main() { println(string(pick(7))) }\n")
    }

    then "`export` and doc wrappers accept a binding inner — the widened alternations" {
        clean_all_paths("wrapped",
            "export let shared = 1\n" +
            "/// documented\n" +
            "const DOCD = 2\n" +
            "fn main() { println(string(shared + DOCD)) }\n")
    }

    then "the destructure form parses natively — plain, `let mut (`, and trailing comma" {
        // Routed in the follow-up slice (letdes_decl): the list shape is
        // for_binding's, `let mut (a, b)` is a plain destructure (the hand never
        // reads is_mut for this form), and the trailing comma survives.
        clean_all_paths("destructure",
            "fn pair() -> (int, int) { (1, 2) }\n" +
            "fn main() {\n" +
            "    let (a, b) = pair()\n" +
            "    println(string(a + b))\n" +
            "}\n") &&
        clean_all_paths("des_mut",
            "fn pair() -> (int, int) { (1, 2) }\n" +
            "fn main() {\n" +
            "    let mut (a, b) = pair()\n" +
            "    println(string(a + b))\n" +
            "}\n") &&
        clean_all_paths("des_trail",
            "fn pair() -> (int, int) { (1, 2) }\n" +
            "fn main() {\n" +
            "    let (a, b,) = pair()\n" +
            "    println(string(a + b))\n" +
            "}\n") &&
        clean_all_paths("des_export",
            "export let (sa, sb) = (1, 2)\n" +
            "fn main() { println(string(sa + sb)) }\n")
    }

    then "an EMPTY destructure list still parses and fails at TYPECK, on every path" {
        // The hand's parse_destructure_names accepts `let () = t` (entries are
        // typed at check time), so the parse must succeed everywhere and the
        // SAME typeck rejection (F1000) must follow — a parse-time F0001 here
        // would mean the native rule narrowed the language.
        let src = "fn pair() -> (int, int) { (1, 2) }\n" +
            "fn main() {\n" +
            "    let () = pair()\n" +
            "    println(string(1))\n" +
            "}\n"
        // Two distinct routings (t-bw9s): the `_emit` and `_hand` legs pinned flags
        // that no longer exist, leaving them empty-env duplicates of `_dflt`.
        let d = check_out("des_empty_dflt", "", src)
        let x = check_out("des_empty_exec", "AVRA_PARSER_DECL_STATIC=0", src)
        !clean(d) && d.contains("error[F1000]") && !d.contains("error[F0001]") &&
            !clean(x) && x.contains("error[F1000]") && !x.contains("error[F0001]")
    }
}

spec "t-47hc Phase 4: the binding frontier did not widen" {
    then "a non-diverging `else` still reports the CODED diagnostic, on ALL FOUR paths" {
        // F1203 survives routing. It used to reach the user by ROLLBACK: the native
        // builder reported message-only, any report unwound the dispatcher-level
        // `@try`, and the hand re-parsed the item owning the code. `@try "let" @cut`
        // ends that — the branch commits at the keyword, so the native builder now
        // reports the code itself (mk_let_binding_g). Checked on every path, because
        // the default one can be answered by the executor fallback and say nothing
        // about what the GENERATED rule does.
        let src = "fn f(o: int?) -> int {\n" +
            "    let v = o else { 1 }\n" +
            "    v\n" +
            "}\n" +
            "fn main() { println(string(f(none))) }\n"
        mut ok = true
        for path in [["nondiverge_dflt", ""], ["nondiverge_emit", ""],
                     ["nondiverge_exec", "AVRA_PARSER_DECL_STATIC=0"], ["nondiverge_hand", ""]] {
            let out = check_out(path[0], path[1], src)
            if clean(out) || !out.contains("error[F1203]") {
                println("F1203 missing on path ${path[0]}: " + out)
                ok = false
            }
        }
        ok
    }

    then "`let 5 = 1` stays a PARSE error — the native rule aborts, never builds" {
        let out = check_out("numname", "",
            "fn main() {\n    let 5 = 1\n}\n")
        !clean(out) && out.contains("error[F0001]")
    }

    then "a BARE `mut (` stays an error — only `let` opens a destructure" {
        // parse_mut_statement demands an identifier, so mut_decl has no
        // destructure sibling; routing must not widen this.
        let out = check_out("mutparen", "",
            "fn pair() -> (int, int) { (1, 2) }\n" +
            "fn main() {\n    mut (a, b) = pair()\n}\n")
        !clean(out) && out.contains("error[F0001]")
    }
}
