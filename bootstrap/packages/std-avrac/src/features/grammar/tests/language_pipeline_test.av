// WHY: t-47hc.8 — the LANGUAGE PIPELINE record (language.av). Language is
// the one object consumers ask for the composed grammar or the dispatch
// registry: Parser holds one per NodeStore (production), the regen driver
// assembles one fresh. Since the one-grammar consolidation the surface is
// ONE accessor: `full()` — every rule of the language, stamped with the
// builder manifest, shared by all four interpreter seams (which differ only
// by the start-rule name they enter at) AND by the parser generator (which
// emits it once into the one checked-in static parser). These specs pin
// that contract; BYTE-level equivalence with the emitted parser stays
// pinned by gen_parser_regen_test, which routes through the same record.

use @std.avrac.features.grammar.{assemble_language, language_for, Language, Grammar}
use @std.avrac.features.{feature_builders}
use @std.avrac.features.{build_registry}

fn has_rule(g: Grammar, name: string) -> bool {
    for r in g.rules {
        if r.name == name { return true }
    }
    false
}

spec "t-47hc.8: ONE grammar — every production entry resolves in full()" {
    given "one assembled pipeline record" {
        let lang = assemble_language()
        let g = lang.full()

        then "the four seam start rules and the whole-program start all resolve by name" {
            // The seams enter by NAME (executor.av: "declaration",
            // "statement", "expression", "type_expr"); pattern_or is the
            // generated pattern entry. This is the exact property that lets
            // one grammar serve every entry.
            has_rule(g, "program")
                && has_rule(g, "declaration")
                && has_rule(g, "statement")
                && has_rule(g, "expression")
                && has_rule(g, "type_expr")
                && has_rule(g, "pattern_or")
        }

        then "full() carries the FULL manifest projection — one stamping" {
            lang.kind_rows.length == feature_builders().length
                && g.builder_kinds.length == feature_builders().length
        }
    }
}

spec "t-47hc.8: full() is LAZY — composed on first ask, memoised after" {
    given "a fresh record, the grammar asked twice" {
        let lang = assemble_language()
        let before_null = lang.full_v == null
        let first = lang.full()
        let after_set = lang.full_v != null
        let second = lang.full()

        then "the slot fills exactly at the first ask and the second ask agrees" {
            before_null && after_set
                && first.rules.length == second.rules.length
                && first.builder_kinds.length == second.builder_kinds.length
        }
    }
}

spec "t-47hc.8: language_for wraps a caller-owned registry; assemble_language builds fresh" {
    given "both constructors over the same manifest fold" {
        let reg = build_registry()
        let wrapped = language_for(reg)
        let fresh = assemble_language()

        then "the wrapped record projects the registry's own manifest" {
            wrapped.kind_rows.length == reg.builder_binds.length
        }

        then "wrap and fresh agree on the projection and on the composed grammar" {
            wrapped.kind_rows.length == fresh.kind_rows.length
                && wrapped.full().rules.length == fresh.full().rules.length
        }
    }
}
