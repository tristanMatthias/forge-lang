// t-x2fb — a doomed `@try` branch must ABORT AT ITS CUT, not parse on and discard.
//
// THE BUG: the commit guard on a cut-bearing speculative branch is
// `s_cut || (no new diagnostics)`. Diagnostics only ever grow, so once `s_cut` is
// false at the cut point the branch is PROVABLY going to roll back — yet emit kept
// emitting the remaining items, and for `paren_expr` the remaining item is the lambda
// BODY, i.e. a parse of the entire rest of the expression. The branch parsed the whole
// suffix, threw it away, and the caller parsed that same suffix again. Nested, that is
// 2x per parenthesised group:
//
//     parse_paren_expr -> parse_lambda_body -> parse_expression -> ... -> parse_paren_expr
//
// Measured `parse_paren_expr` entries for `if a == 1 && (b == 2) || ...` with n terms:
//
//     before   7, 15, 31, 63, 255, 1023, 4095     (exactly 2^n - 1)
//     after    3,  4,  5,  6,   8,   10,   12     (exactly n)
//
// WHY NOTHING CAUGHT IT: the second parse only happens when the ENCLOSING construct
// ALSO fails — a successful outer parse never re-descends. So VALID programs are flat
// and diff-test, which compiles only valid programs, is blind to it by construction.
// In practice it fired on every mid-edit compile: the compiler's own generated parsers
// carry FIRST-set guards with 32 parenthesised terms.
//
// These specs pin the BEHAVIOUR (a bounded compile) rather than the emitted text, so
// they keep meaning if the scaffold is rewritten. The `timeout` is the assertion: at
// 2^20 the unfixed compiler does not finish, so a regression fails loudly instead of
// wedging the suite.

// avra_shell_exec_status, NOT the popen-based avra_shell_exec: the assertion here
// IS the exit status, and extracting it from a compound `cmd; echo rc=$?` through
// popen is the unreliable pattern this repo already ruled out (PR #1039). `timeout`
// reports 124 when it expires, which is precisely the regression signal — before the
// fix a 20-term recovery is 2^20 and never returns.
extern fn avra_shell_exec_status(cmd: string) -> int
use @std.avrac.test_runner.{write_fixture}

/// An UNTERMINATED `if` whose condition is `n` parenthesised `||` terms — the shape
/// that made the branch doomed (no `->` follows the parens, so the lambda alternative
/// always fails) AND the enclosing construct fail (no closing `}`).
fn unterminated_if(n: int) -> string {
    mut cond = ""
    mut i = 0
    while i < n {
        if i > 0 { cond = cond + " || " }
        cond = cond + "st.a == 1 && (st.b == 2)"
        i = i + 1
    }
    "fn f() {\n    if " + cond + " {\n"
}

/// Compile-check the fixture under a wall-clock bound, returning bs2's exit status
/// (124 if `timeout` expired — the regression signal).
fn check_bounded(tag: string, secs: string, source: string) -> int {
    let path = "/tmp/avra_x2fb_${tag}.av"
    write_fixture(path, source)
    avra_shell_exec_status("timeout ${secs} ./build/bs2 check '${path}' >/dev/null 2>&1")
}

spec "t-x2fb: a doomed @try aborts at its cut instead of parsing the whole suffix" {
    then "20 parenthesised terms in an unterminated `if` finish fast (2^20 before)" {
        let rc = check_bounded("n20", "30", unterminated_if(20))
        rc == 1
    }
    then "30 terms still finish — the cost is linear, so more terms stay cheap" {
        let rc = check_bounded("n30", "30", unterminated_if(30))
        rc == 1
    }
    then "the equivalent VALID program is unaffected (it never re-descended)" {
        let src = unterminated_if(20) + "    }\n}\n"
        let rc = check_bounded("valid", "30", src)
        rc == 1 || rc == 0
    }
    then "a real lambda still parses — the cut abort must not break the committed path" {
        // Every lambda FORM the cut-bearing branch can commit: typed params, the
        // multi-param tuple shape, and zero-arg. Params are annotated because a
        // STANDALONE lambda's parameter types are not inferable — an untyped `(x) -> …`
        // here is an F1000 type error, not a parse failure, and asserting on it would
        // test the type checker rather than this branch.
        let rc = check_bounded("lambda", "30",
            "fn f() {\n" +
            "    let g = (x: int) -> x + 1\n" +
            "    let h = (a: int, b: int) -> a + b\n" +
            "    let z = () -> 7\n" +
            "    let n = g(1) + h(2, 3) + z()\n" +
            "}\n")
        rc == 0
    }
    then "a parenthesised expression that is NOT a lambda still parses as grouping" {
        let rc = check_bounded("group", "30",
            "fn f(a: int, b: int) -> int {\n    let x = (a + b) * 2\n    return x\n}\n")
        rc == 0
    }
}
