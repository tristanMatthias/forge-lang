// t-47hc — grammar-native `@pkg::T` qualified types.
//
// The renderer emits resolved names this way, including inside shipped
// @comptime bodies. The native rule preserves adjacent `::`, generic/optional
// suffixes, nesting, and fused `>>` closes.
//
// Oracle: run the DSL type parser AND the pinned generated parser (parse_type_expr →
// parse_type_atom's `@` branch), lower both via the shared type_expr_to_vtype,
// and assert identical ValueTypes via render_type_id.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_type}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_type_id, type_expr_to_vtype}

fn type_grammar_src() -> string {
    "grammar Type {\n" +
    "  type_expr  = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom  = qualified_type | fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  qualified_type = \"@\" q:IDENT ( @peek(double_colon) \":\" \":\" q:IDENT )+ ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkQualified(q, a, opt)\n" +
    "  fn_type    = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" r:type_expr )? -> MkFn(lp, p, r)\n" +
    "  dyn_type   = \"dyn\" t:IDENT ( topt:\"?\" )? -> TyDyn(t, topt)\n" +
    "  list_type  = \"[\" e:type_expr \"]\" -> TyList(e)\n" +
    "  paren_type = \"(\" ( t:type_expr ( \",\" t:type_expr )* )? \")\" -> TyParen(t)\n" +
    "  named_type = name:IDENT ( \".\" name:IDENT )* ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(name, a, opt)\n" +
    "}"
}

fn dsl_type(src: string) -> string {
    let gp = parse_grammar(type_grammar_src())
    let r = run_grammar_type(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_type_id(r.store, r.root)
}

fn hand_type(src: string) -> string {
    mut p = parser_new(src)
    // make the "== hand parser" oracle tautological. Pin the hand parser.
    // t-47hc.37 — was `parse_type_expr_hand`, which is DELETED (the last of the three ITEM-LEVEL
    // hand tails). The oracle half is the INTERPRETER engine now: `type_static = false`
    // selects run_dsl_type_at_shared over the generated run_static_type. Two engines,
    // one grammar — and the interpreter is still PRODUCTION for the type family, so this
    // is a live differential rather than a museum piece.
    p.type_static = false
    match p.parse_type_expr("expected type") {
        .Ok(te) -> {
            let tid = p.store.types.add_leaf(type_expr_to_vtype(te))
            render_type_id(p.store, tid)
        }
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool { dsl_type(src) == hand_type(src) }

spec "grammar-native @pkg::T qualified types == hand parser" {
    given "package-qualified type names" {
        then "plain / multi-segment / generic / nullable qualified forms agree" {
            agree("@std::core::Foo") &&
            agree("@pkg::Type") &&
            agree("@std::core::ExprId?") &&
            agree("@pkg::Result<T, E>") &&
            agree("@a::b::c::Deep") &&
            // canonical: the qualified name round-trips through the render.
            dsl_type("@std::core::Foo") == "@std::core::Foo" &&
            dsl_type("@pkg::Result<T, E>") == "@pkg::Result<T, E>"
        }
        then "spaced colons remain invalid, matching the hand parser's adjacency rule" {
            dsl_type("@pkg : : Type") == "<dsl parse error>" &&
            hand_type("@pkg : : Type") == "<parse error>"
        }
    }
    given "qualified types nested in a generic" {
        then "the outer generic and qualified atom both parse natively" {
            agree("List<@std::core::Foo>") &&
            agree("Map<@pkg::K, @pkg::V>") &&
            agree("Box<@std::core::ExprId?>")
        }
    }
    given "qualified + nested generics stack with the >>-split" {
        then "List<List<@std::core::Foo>> agrees — both mechanisms fire" {
            agree("List<List<@std::core::Foo>>") &&
            agree("Map<string, List<@std::core::ExprId>>")
        }
    }
    given "a QUALIFIED GENERIC whose own `>` fuses with the outer `>` (ps3t.6.7 db_new)" {
        // The gnarliest close: the qualified atom itself carries generic
        // args, so ITS `>` and the enclosing generic's `>` lex as ONE `>>`. The
        // executor splits the `>>` token in place so the outer
        // generic keeps its close. Without the split the outer `List` loses its
        // `>`, back-tracks to a bare `Named("List")`, and the type is corrupted
        // — the exact shape of @std::query::db_new's body annotation
        // `List<@std::avrac::query::FamilyMemo<V>>` that returned a null Db under
        // the metadata round-trip (ps3t.6.7).
        then "List<@pkg::Box<V>> and deeper fusions agree with the hand parser" {
            agree("List<@pkg::Box<V>>") &&
            agree("List<@std::core::Result<T, E>>") &&
            agree("Map<int, @pkg::Box<V>>") &&
            agree("List<List<@pkg::Box<V>>>") &&
            agree("List<@a::b::Cell<@a::b::Inner<V>>>")
        }
    }
    given "a DOTTED type path `A.B.C` — associated-type projection + qualified name (ps3t.6.7)" {
        // A `.`-joined type path has no pure-grammar production in `named_type`
        // (a bare IDENT): an associated-type projection `Self.Item` in a trait
        // method return, or a module-qualified `core.ast.BinOp`, must fold to
        // `Named("Self.Item")` / `Named("core.ast.BinOp")` exactly as the hand
        // parser's parse_type_atom dotted-path loop does. The DSL `named_type`
        // now carries `( "." tn:IDENT )*` and `capval_tok_text` joins the `.Toks`
        // — without it the flip parsed `Self` and left `.Item`, F0001-ing
        // `bootstrap/tests/assoc_types_test.av` under the type flip.
        then "bare, generic, nullable, and generic-nested dotted paths agree" {
            agree("Self.Item") &&
            agree("core.ast.BinOp") &&
            agree("a.b.c.Deep") &&
            agree("Self.Item?") &&
            agree("List<Self.Item>") &&
            agree("Map<Self.Key, Self.Value>") &&
            agree("List<a.b.Cell<Self.Item>>") &&
            // canonical: the dotted name round-trips flat through the render.
            dsl_type("Self.Item") == "Self.Item" &&
            dsl_type("core.ast.BinOp") == "core.ast.BinOp"
        }
    }
    given "qualified types in union / list positions" {
        then "the native atom composes with the other type forms" {
            agree("@pkg::A | @pkg::B") &&
            agree("[@std::core::Foo]") &&
            agree("@pkg::Foo | int")
        }
    }
    given "bare (non-qualified) types are unchanged" {
        then "the pure-grammar atoms still agree" {
            agree("int") &&
            agree("List<int>") &&
            agree("Foo") &&
            agree("dyn Show") &&
            // sanity: qualified really differs from the bare short name.
            dsl_type("@std::core::Foo") != dsl_type("Foo")
        }
    }
}
