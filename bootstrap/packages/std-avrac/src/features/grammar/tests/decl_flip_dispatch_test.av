// ps3t.6.7 Step G slice 4b — the DECLARATION / whole-program-family FLIP dispatch
// (parse_declaration → grammar-DSL run_dsl_decl_at_shared).
//
// parse_declaration routes through run_dsl_decl_at_shared (the inverse-@hand
// declaration runner over avra_decl_flip_grammar's `declaration` rule:
// `@hand(decl_hand) | statement`) when the parser's `decl_flip` field is set,
// falling back to the hand parser (parse_declaration_hand) on a DSL error. The
// field is read once from AVRA_PARSER_DECL_FLIP at construction but is a plain
// `mut bool` a test can set directly (the full-selfhost flip proof is memory-
// heavy and lives in the promotion step; this pins the dispatch + fallback +
// both arms — decl_hand for real declarations / wrapping / IDENT, and the
// statement arm for a top-level non-declaration item).
//
// Parity = same tree AND same accept/reject: for every VALID form the flip path
// (DSL) and the hand path (parse_declaration_hand — called explicitly so it
// stays a real hand baseline under an eventual promoted default) build the same
// Stmt; both render through the same TOTAL render_stmt_id, so equal trees ⇒
// equal strings (no golden strings).
extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id, avra_selfhost_write_file}
use @std.avrac.features.grammar.{hand_leaf_refused, avra_program_grammar, Grammar, GNode, GAnnot, emit_parser_source_ex, avra_decl_dispatch_grammar, avra_expr_grammar}
use @std.avrac.features.grammar.{emit_lookup_rule, rule_body_has_cut}

fn flip_decl(src: string) -> string {
    mut p = parser_new(src)
    p.decl_flip = true
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<err>"
    }
}

fn hand_decl(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration_hand() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<err>"
    }
}

fn agree(src: string) -> bool {
    flip_decl(src) == hand_decl(src)
}

spec "ps3t.6.7 G.4b: parse_declaration flip dispatch == hand path (decl_flip field)" {
    given "the field toggles the path (sanity: flip really took the DSL branch)" {
        then "flip builds a real tree and agrees with hand for a representative decl" {
            flip_decl("fn f() -> int { 1 }") != "<err>" &&
            flip_decl("fn f() -> int { 1 }") == hand_decl("fn f() -> int { 1 }")
        }
    }
    given "the decl_hand arm: type / enum / trait / impl / const declarations" {
        then "each declaration shape agrees" {
            agree("type P = { x: int, y: int }") &&
            agree("enum E { A(v: int)\n B }") &&
            agree("trait T { fn m(self) -> int }") &&
            agree("impl T for P { fn m(self) -> int { self.x } }") &&
            agree("impl P { fn n(self) -> int { self.y } }") &&
            agree("const K = 7")
        }
    }
    given "the decl_hand arm: functions (plain / export / generic) + let/mut" {
        then "each function/binding shape agrees" {
            agree("fn plain(a: int) -> int { a }") &&
            agree("export fn ex(a: int) -> int { a }") &&
            agree("fn gen<T>(v: T) -> T { v }") &&
            agree("let g = 1") && agree("mut h = 2")
        }
    }
    given "the decl_hand arm: use imports + doc-commented declarations" {
        then "use and /// doc wrapping agree" {
            agree("use core.{ Foo, Bar }") &&
            agree("/// doc line\nfn documented() -> int { 1 }")
        }
    }
    given "the statement arm: a top-level non-declaration item (if/while/for/match)" {
        then "each top-level statement agrees (routed to the statement grammar)" {
            agree("if a { b }") &&
            agree("while a { b }") &&
            agree("for i in 0..n { s }") &&
            agree("match n { 0 -> a\n _ -> b }")
        }
    }
    given "reject parity: both parsers reject the same malformed declaration" {
        then "a dangling operator rejects on both" {
            flip_decl("= 5") == "<err>" && hand_decl("= 5") == "<err>"
        }
    }
}


// ── The `@hand` leaf FRONTIER (t-myz7) ────────────────────────────────────────
//
// `--hand-leaves` counts the leaves that REMAIN. Nothing counted what still
// DEPENDS on one, and the two are different questions: the first says where a
// native rule sits, the second says what deleting the leaf would break. Only the
// second can tell you whether a retirement slice is finished.
//
// It is unmeasurable by comparison. The delegate and the native rules agree on
// every input they both accept — that is what parity work bought — so trees,
// diagnostics, positions and IR are identical whichever one answers. The only way
// to see a dependency is to REMOVE the delegate and watch what fails, which is the
// deletion itself. `AVRA_REFUSE_HAND_LEAF` (executor.av) is that deletion behind a
// flag: the named leaf reports instead of delegating, so every form still needing
// it surfaces as a real diagnostic. Default-unset refuses nothing, so the emitted
// parsers and the IR are untouched (diff-test byte-identical).
//
// The corpus below is the MEASURED frontier. Every entry is native today; each is
// here so that a change which pushes it back onto the delegate goes red instead of
// passing silently — the failure mode this whole probe exists to make visible.
/// A BARE-IDENT component INSTANTIATION (`acct_sr a { balance = 40 }`) — NATIVE, and
/// sitting in the corpus below. A fn rather than a `const` — a module-level string
/// const is typed `int` (t-8xte).
///
/// THIS FIXTURE USED TO BE THE ANTI-VACUITY ANCHOR, AND IT WAS MALFORMED. Its field
/// read `balance: int = 100`, with no `let` — and `comp_field` REQUIRES the `let`, so
/// the DECLARATION half was `error[F0040]: expected expression` under a plain compile
/// and under `AVRA_PARSER_DECL_FLIP=0` alike. Invalid syntax, rejected identically by
/// both parsers. The anchor was therefore green off ERROR RECOVERY, while its comment
/// claimed it named a valid form that slice C had deliberately left hand-owned.
/// Bisected, with a well-formed field:
///
///   component acct_sr { balance: int = 100 }         REFUSES   <- the malformed half
///   component acct_sr { config { balance: int } }    native
///   acct_sr a { balance = 40 }            (fn body)  native
///   acct_sr a { balance = 40 }          (top level)  native
///   component acct_sr a { balance = 40 }  (keyword)  native
///
/// (An earlier draft of this note listed a "legacy paren" form `acct_sr a(…) {}` as a
/// third case. There is no such form — `comp_inst` is `"component" IDENT IDENT "{"`,
/// and the paren spelling parses as a call, then fails resolve with `undefined
/// variable`. It was asserted from the previous comment's wording rather than from the
/// grammar, which is the same mistake in miniature as the fixture itself.)
///
/// So slice C's form had ALREADY gone native and nothing here was measuring it. The
/// lesson is the one this file exists to enforce, turned on itself: a guard that
/// cannot distinguish the failure it is named for is worth nothing, and a fixture
/// whose refusal comes from a typo looks exactly like one whose refusal comes from a
/// gap. Check a frontier fixture COMPILES (modulo the form under test) before reading
/// anything into which path answered it.
///
/// Its predecessors, each closed in turn and now sitting in the corpus below:
/// `while lo < 3 { let m = 1 … }` -> a doc comment on an `impl` method (#1147) ->
/// a `mut` struct field -> a trailing comma in a parameter list. That last one was the
/// same already-solved bug as #1140 in its third delimiter (the list rule carried a
/// `( "," )?` the repetition ate; call args were guarded with
/// `@peek(comma_not_rparen)`; #1140 did `]`; params never got it).
/// A component's SETTABLE fields live in a `config { … }` block — `let` inside the
/// component body is a private binding, not an instantiable field, so the `let` form
/// parses but then fails typeck with `no field 'balance'`. Found by the parse gate
/// below on its first run, which is the gate doing its job on the very commit that
/// introduced it: the first repair of this fixture swapped `balance: int = 100` for
/// `let balance: int = 100`, fixing the F0040 and leaving a fixture that still did not
/// typecheck. The parse claim was sound both times; the fixture was not.
fn BARE_IDENT_COMP_INST() -> string {
    "component acct_sr { config { balance: int = 100 } }\nfn use_it() -> int {\n acct_sr a { balance = 40 }\n 0\n}"
}

/// The anti-vacuity anchor, and — unlike every fixture in the lineage above — one that
/// does NOT graduate. A malformed declaration still reaches `@hand(decl_hand)`.
///
/// This is the `@try` CONTRACT, not a gap: a `@try` branch snapshots and commits only
/// if it reported nothing, "and otherwise rolls back into the `@hand` gate below — so
/// the native rule owns VALID input and recovery stays the hand parser's,
/// byte-for-byte" (CLAUDE.md). Which means `decl_hand`'s remaining production role is
/// ERROR RECOVERY, for every declaration keyword at once:
///
///   fn foo() -> int { 1 }   valid      native
///   fn foo(                 malformed  REFUSES
///   type Foo = {            malformed  REFUSES
///   enum E {                malformed  REFUSES
///   impl Foo {              malformed  REFUSES
///   let = 5                 malformed  REFUSES
///
/// That makes it a STABLE anchor: it cannot be closed by routing one more form, so it
/// will not need replacing next slice the way its four predecessors did. It closes
/// when the native rules own recovery — the `@recover(sync_to:)` work this ticket's
/// design field anticipates — which is the actual gate on deleting the leaf.
///
/// t-myz7 UPDATE — the "cannot be closed by routing one more form" claim was WRONG,
/// and the anchor did graduate. Owning recovery per keyword is exactly what this
/// slice does, so the table above is now split rather than uniform. Measured under
/// `AVRA_REFUSE_HAND_LEAF=decl_hand`:
///
///   trait T {   shape S = {   (+ mod use const)               GRADUATED
///   fn foo(   enum E {   select { x }   spec "s" { given }
///   type Foo = {   impl Foo {   component C {                    still REFUSES
///
/// So the anchor moves to `impl`, and the assertions below split in two: the
/// still-refusing keywords keep the anti-vacuity role, and each graduated form moves
/// into `recovery_without_delegate` in the recovery spec — coverage GROWS as the
/// frontier advances instead of quietly thinning. When `impl` lands, re-point this at
/// whatever still refuses and move `impl`'s malformed forms across; when NOTHING
/// refuses, this file's frontier specs are what say the leaf can be deleted.
///
/// `fn` is on the REFUSING side deliberately, and the reason generalises to every
/// keyword with a STATEMENT BODY. Committing `fn_decl` (`@try "fn" @cut …`) is what
/// makes it own its header diagnostics — but the `@try` that used to sit in the
/// `declaration` alternation commits only when the branch "reported nothing", so ANY
/// diagnostic anywhere in the fn, including deep in its body, used to roll the whole
/// declaration back and let the hand own recovery. A committed rule never rolls back.
/// You cannot have both: commit early to own the header, and roll back late to
/// borrow the hand's body recovery. Measured — committing `fn` moved 27 corpus and
/// straggler specs red, every one of them an EXPRESSION-view case (`with_suffix`,
/// `map_literal`, `qualified_expr`, `template_lit`) that is merely WRAPPED in
/// `fn f() -> int { … }`. So `fn` graduates only once native statement-body recovery
/// is byte-equal to the hand's, which is what the recovery corpus measures.
fn MALFORMED_DECL() -> string {
    // RE-POINTED as the frontier moves (t-myz7): this must name a form that STILL needs
    // the leaf, or the control it anchors goes vacuous. Was `impl Foo {` until `impl`
    // graduated, then `fn foo(` until `fn` did (t-47hc.5) — that one really did change
    // the ENCLOSING recovery for every expression-view case wrapped in
    // `fn f() -> int { … }`, which is why it took the statement-body work with it.
    // Then `let = 5`, until `let` graduated too (t-47hc.5 Phase 4).
    //
    // With every KEYWORD native (`--parser-frontier` lists none), the form that still
    // reaches the leaf is no longer a malformed declaration at all — it is the bare
    // IDENT lead the `@peek(decl_lead)` gate admits: `Foo bar { … }`, a component
    // INSTANTIATION whose component is not declared. `bare_comp_inst` declines it, and
    // `decl_lead` still hands it to `decl_hand`. Measured: 3 refusals, all attributed
    // to the fixture, and a clean parse without the refusal.
    //
    // The name is now slightly off — this is not "malformed", it is "not a routed
    // form" — but it is kept because every reference to it means "the anchor that
    // still needs the leaf", and renaming it across the file would obscure the lineage
    // this comment exists to record.
    "Foo bar { x: 1 }\n"
}

fn fixture_path(name: string) -> string {
    "build/_frontier_${name}.av"
}

fn refuse_out(refusal: string, name: string, src: string) -> string {
    let fixture = fixture_path(name)
    let _ = avra_selfhost_write_file(fixture, src)
    avra_shell_exec("AVRA_REFUSE_HAND_LEAF=${refusal} ./build/bs2 check '${fixture}' 2>&1")
}

/// Does any refusal reach THIS file (as opposed to an imported module)? Refusals
/// reported inside an IMPORTED module are another file's dependency, not this form's
/// — counting them measures the import closure instead of the input, which is exactly
/// the wrong answer (an early version of this probe reported `use` as
/// delegate-dependent on that basis; the refusal was coming from a `@std` source the
/// import pulled in). This ticket records hitting that trap twice.
///
/// ATTRIBUTION, not a marker string. The previous filter was
/// `!line.contains("error in module")`, and it does NOTHING here: that text is not
/// emitted at all for this diagnostic shape. Measured —
/// `use @std.avrac.core.{Expr}` plus a trivial `fn` reports 11 refusals under `*`
/// (7 `decl_hand` + 4 `primary_base`), every one of them located in
/// `features/modules/grammar.av`, and the string "error in module" appears zero
/// times in that output. The corpus was safe only because no fixture has a `use` —
/// an accident, not a guard, and the kind that fails the moment someone adds one.
///
/// So attribute instead: a refusal counts only when the LOCATION line that follows it
/// names the fixture under test. The message line carries no path (the renderer puts
/// it on the next `╭─[…]` line), which is why a per-line predicate could never have
/// worked.
fn refusal_in_file(out: string, fixture: string) -> bool {
    let lines = out.split("\n")
    mut i = 0
    while i < lines.length {
        if lines[i].contains("is refused") {
            // Scan forward for this diagnostic's location line. A small window: the
            // renderer emits it immediately after the message, and stopping at the
            // first one found keeps a LATER diagnostic's path from being credited here.
            mut j = i + 1
            while j < lines.length && j < i + 5 {
                if lines[j].contains(".av:") {
                    if lines[j].contains(fixture) { return true }
                    j = lines.length
                } else {
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    false
}

/// The shared core of both frontier helpers — parameterised on the refusal so the `*`
/// branch is exercised by a real parse rather than only by the pure predicate.
fn refused_here(refusal: string, name: string, src: string) -> bool {
    refusal_in_file(refuse_out(refusal, name, src), fixture_path(name))
}

/// Did `src` fail to PARSE? Raised in review, and it is the ROOT CAUSE of the defect
/// this file's anchor had: "no refusal" alone cannot tell "the native rule handled it"
/// from "it never parsed at all", so a fixture with a typo reads as NATIVE. That is
/// exactly how `BARE_IDENT_COMP_INST` sat here malformed — its `F0040` was invisible
/// to a predicate that only looked for the word "refused".
///
/// Gated on the PARSE phase specifically (`F0001`–`F0999`, less the two codes in that
/// range that are not parse failures) rather than on the process exit status, and the
/// distinction is deliberate:
///
///   fixture                              fails with   phase      parse claim
///   component acct { balance: int }      F0040        PARSE      INVALID — must fail
///   mod m { fn g() -> int { 1 } }        F3100        resolve    valid
///   acct a { balance = 40 }              F1000        typeck     valid
///
/// Only the first is a broken fixture. `mod m { … }` parses exactly as intended and
/// then fails to RESOLVE, because `mod` names a FILE module — the inline body is
/// well-formed input that no single-file fixture can satisfy. Requiring exit 0 would
/// force this corpus to drop `mod` coverage entirely, or to weaken fixtures until they
/// are semantically complete programs, which is a cost paid for no extra protection:
/// resolve and typeck run AFTER parsing and cannot say which parser answered.
fn parse_failed(out: string) -> bool {
    for line in out.split("\n") {
        if line.contains("error[F0") &&
           !line.contains("error[F0801") &&    // unused-variable lint, not a parse failure
           !line.contains("error[F0900") {     // spec-test failure, not a parse failure
            return true
        }
    }
    false
}

/// Does `src` parse, and parse WITHOUT the `decl_hand` delegate? BOTH halves are
/// load-bearing — see `parse_failed`. One shell exec answers both.
fn native_without_delegate(name: string, src: string) -> bool {
    let out = refuse_out("decl_hand", name, src)
    !parse_failed(out) && !refusal_in_file(out, fixture_path(name))
}

/// The RECOVERY twin of `native_without_delegate`: did `src` fail to parse, and fail
/// WITHOUT the delegate? Both halves are load-bearing for the same reason the valid-
/// input probe needs both — "the leaf was not refused" ALSO holds when nothing
/// reported at all, so a negative alone would stay green if a converted keyword
/// started silently ACCEPTING its malformed forms. That is not hypothetical: a gated
/// `enum E { 5 }` did exactly that during this slice (bound `5` as a variant name,
/// exit 0), which is what this asserts against.
fn recovery_without_delegate(name: string, src: string) -> bool {
    let out = refuse_out("decl_hand", name, src)
    parse_failed(out) && !refusal_in_file(out, fixture_path(name))
}

/// The `@expect` message the grammar declares for `key` on rule `rule`, or "".
/// Reads the GRAMMAR OBJECT, which is the single source of truth — the annotation
/// on a rule's LEADING item never lowers to emitted parser text (the caller proved
/// FIRST, so that item is advanced unconditionally), so it cannot be read back out
/// of any generated file.
/// `declared_expect` against the EXPRESSION view — where the second definition of
/// `param` actually lives.
fn declared_expect_expr(rule: string, key: string) -> string {
    declared_expect_in(avra_expr_grammar(), rule, key)
}

fn declared_expect(rule: string, key: string) -> string {
    declared_expect_in(avra_program_grammar(), rule, key)
}

fn declared_expect_in(g: Grammar, rule: string, key: string) -> string {
    for r in g.rules {
        if r.name == rule {
            match r.body {
                .Alt(branches) -> {
                    for b in branches {
                        for a in b.annots {
                            match a {
                                .Expect(tok, msg, _) -> { if tok == key { return msg } }
                                _ -> {}
                            }
                        }
                    }
                }
            }
        }
    }
    ""
}

spec "t-myz7: the cross-view `param` message is not allowed to drift" {
    then "emit's declared message is the string the `param` grammar annotation carries" {
        // `param` is DEFINED in the expression view, so `rule_first_expect_msg` cannot
        // read its `@expect` from the DECLARATION grammar at all — the decl parser calls
        // the separately generated expression parser for it. emit therefore declares the
        // wording in code, beside the FIRST it pairs with, and nothing otherwise binds
        // the two: editing the annotation in avra_grammar.av would silently leave the
        // decl view on the stale string, visible only to a diagnostic-TEXT oracle.
        //
        // This reads the GRAMMAR OBJECT rather than a generated file, because the
        // annotation sits on `param`'s LEADING item and so lowers to no emitted text at
        // all — two earlier drafts of this guard asserted on generated sources and were
        // guards that could not fail. Change the annotation, and this goes red.
        declared_expect("param", "IDENT") == "expected parameter name" &&
            // The TYPE position's wording, and the SECOND definition of `param`. The rule
            // is written twice — the program view and the EXPRESSION view, which never
            // compose each other — and only the program view's IDENT message was pinned,
            // so the other copy and this message could drift silently. Asserting the two
            // views are EQUAL is the point: either one drifting turns this red.
            //
            // The second copy is in the EXPRESSION view, not the declaration one: the
            // decl dispatch grammar defines no `param` rule at all (measured — both
            // lookups come back empty there), so a decl-keyed guard would have been one
            // that could never fail.
            declared_expect("param", "type_expr") == "expected parameter type after `:`" &&
            declared_expect_expr("param", "IDENT") == declared_expect("param", "IDENT") &&
            declared_expect_expr("param", "type_expr") == declared_expect("param", "type_expr")
    }

    then "the guard is not vacuous — the lookup really finds annotations" {
        // The positive control the two failed drafts lacked. A key the grammar does NOT
        // declare must come back empty, so a `declared_expect` that silently returned ""
        // for everything (a renamed rule, a changed annot shape) cannot satisfy the
        // assertion above by accident.
        declared_expect("param", "NOT_A_REAL_KEY") == "" &&
            declared_expect("no_such_rule", "IDENT") == ""
    }
}

spec "t-myz7: a rule-name-keyed @expect reaches the EMITTED parser" {
    then "the gated call on `trait_member` carries the declared wording, not the rule name" {
        // The guard the `param` spec above CANNOT be. That one compares the grammar with
        // a string, so it stays green no matter what emit does with the annotation — and
        // that blind spot is exactly where a bug lived: `rule_first_expect_msg` read the
        // rule-name-keyed `@expect` off `branches[0]` only, while `trait_member =
        // assoc_member | method_member @expect("trait_member", …)` binds it to the LAST
        // branch. The lookup missed it, `gated_first_check` fell back to its generic
        // path, and the emitted parser reported `expected trait_member` — a GRAMMAR RULE
        // NAME, printed at a user.
        //
        // Note `declared_expect` below scans EVERY branch (it always did). The emitter
        // scanning only the first is what the two disagreed about, so a guard that reads
        // the grammar on both sides could never see it. This one reads the EMITTED
        // source, so it can.
        let declared = declared_expect("trait_member", "trait_member")
        let src = emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
        declared != "" &&
            src.contains(declared) &&
            !src.contains("expected trait_member")
    }
}

/// Every `declaration` branch that is `@try` AND refers to a rule containing `@cut`.
/// Empty is the invariant; each entry is an inert commit.
fn inert_committed_branches() -> List<string> {
    let g = avra_decl_dispatch_grammar()
    mut out: List<string> = []
    let d = emit_lookup_rule(g, "declaration")
    match d.body {
        .Alt(branches) -> {
            for b in branches {
                if b.speculative {
                    for it in b.items {
                        match it.prim {
                            .Ref(rname) -> {
                                let r = emit_lookup_rule(g, rname)
                                if r.name != "" && rule_body_has_cut(r.body) { out.push(rname) }
                            }
                            _ -> {}
                        }
                    }
                }
            }
        }
    }
    out
}

spec "t-myz7: a `@cut`-committed rule is never dispatched under `@try`" {
    then "no `declaration` branch is both speculative and committed" {
        // THE INERT-COMMIT TRAP, made detectable. `@try X` where `X` commits internally
        // is a no-op: the branch snapshots diagnostics and rolls back the instant the
        // rule reports, so the `@cut` — whose entire purpose is "do not roll back past
        // this point" — is discarded by a wrapper one level up, and the `@hand(decl_hand)`
        // gate below answers exactly as it did before.
        //
        // Nothing else in this suite can see that. The emitted parser changes, the rule
        // genuinely commits, `--hand-leaves` does not move, and every recovery oracle
        // still AGREES — because the hand is still the one recovering. It was measured as
        // "corpus unchanged before and after, therefore the commit is clean" when the
        // truth was "corpus unchanged, therefore the commit did nothing", and the two are
        // indistinguishable from output alone. The refusal probe below distinguishes them
        // for a keyword you already suspect; this says which keywords to suspect.
        //
        // The FIX when this fires is not to drop the `@cut` — it is to dispatch the rule
        // BARE, which is how `use` / `mod` / `shape` / `trait` / `const` are already
        // wired. Their own leading `@try … @cut` is what makes "not my keyword" roll back,
        // so the dispatcher wrapper is redundant there and destructive here.
        let inert = inert_committed_branches()
        if inert.length > 0 { println("inert @try over committed rule(s): " + inert.join(", ")) }
        inert.length == 0
    }

    then "the scan DISCRIMINATES — it finds the committed rules it is looking at" {
        // Anti-vacuity: an `inert_committed_branches` that never detected anything would
        // satisfy the assertion above perfectly. `rule_body_has_cut` must actually answer
        // true for a rule that commits (every routed keyword does) and false for one that
        // does not, or the invariant is a guard that cannot fail.
        // The false case is keyed on `field` / `variant` — SUB-rules, never dispatched
        // as declaration branches, so they have no reason to ever gain a `@cut`. Keying
        // it on a decl keyword instead would make this arm flip red the day that keyword
        // is legitimately committed, i.e. it would fail for being RIGHT.
        let g = avra_decl_dispatch_grammar()
        rule_body_has_cut(emit_lookup_rule(g, "shape_decl").body) &&
            rule_body_has_cut(emit_lookup_rule(g, "trait_decl").body) &&
            !rule_body_has_cut(emit_lookup_rule(g, "field").body) &&
            !rule_body_has_cut(emit_lookup_rule(g, "variant").body)
    }
}

spec "t-myz7: the decl_hand frontier — what still depends on the leaf" {
    then "the probe is DORMANT unless asked" {
        // A guard that cannot fail is worth nothing, and a probe that fires by
        // accident is worse: it would refuse the leaf in every production build.
        !hand_leaf_refused("decl_hand") && !hand_leaf_refused("primary_base")
    }

    then "`*` refuses EVERY leaf — exercised by a real parse, not just the predicate" {
        // The predicate assertion above runs in a process with no refusal set, so it
        // only ever reaches the early return — the `want == "*"` branch is never
        // executed by it. This runs a real compile under `*` and requires the known
        // gap to report, which is the only thing that proves the wildcard is wired to
        // the leaf rather than merely present in the source.
        //
        // Uses the same recovery anchor as the discriminating assertion below, so this
        // control cannot go vacuous when a form graduates — the failure that retired
        // the previous fixture (see BARE_IDENT_COMP_INST).
        refused_here("*", "wildcard", MALFORMED_DECL()) &&
        // ...and the SAME wildcard reports NOTHING for a valid file that merely IMPORTS.
        //
        // HONEST LABEL: this case does NOT fail against the previous filter *here*, and
        // it is kept anyway. Under `bs2 test` the `@std` import is served from the
        // metadata fast-path rather than re-parsed, so no imported source runs under the
        // refusal and there is nothing to contaminate — both filters see an empty
        // result. It is a same-environment invariant, not a fail-before demonstration,
        // and calling it one would be the vacuity this file exists to police.
        //
        // It is still worth pinning, because the contamination is REAL in the other
        // environment. Running the identical command from a shell, where `@std` IS
        // parsed from source, that fixture reports 11 refusals under `*` (7 `decl_hand`
        // + 4 `primary_base`), every one located in `features/modules/grammar.av` and
        // none in the fixture — and the string "error in module" appears ZERO times, so
        // the previous `!line.contains("error in module")` filter counted all 11. That
        // is the trap t-myz7 records having been believed TWICE, and the corpus avoided
        // it only because no fixture had a `use`: an accident, not a guard.
        //
        // Hence the predicate is now attribution-based (`refusal_in_file`) — correct by
        // construction in both environments rather than by which one it runs in.
        !refused_here("*", "import_closure",
            "use @std.avrac.core.{Expr}\nfn f() -> int { 1 }")
    }

    then "the declaration keywords parse with the delegate REFUSED" {
        native_without_delegate("fn", "fn f() -> int { 1 }") &&
        native_without_delegate("exportfn", "export fn f() -> int { 1 }") &&
        native_without_delegate("genfn", "fn f<T>(x: T) -> T { x }") &&
        native_without_delegate("externfn", "extern fn e(a: int) -> int") &&
        native_without_delegate("typestruct", "type T = { x: int }") &&
        native_without_delegate("newtype", "type U = int") &&
        native_without_delegate("enum", "enum E { A, B }") &&
        native_without_delegate("trait", "trait Tr { fn m(self) -> int }")
    }

    then "the probe DISCRIMINATES — a malformed declaration still needs the delegate" {
        // THE ANTI-VACUITY HALF. Every assertion above is "no refusal", which a helper
        // that never detects one would satisfy perfectly. These are the cases that must
        // come back false.
        //
        // ERROR RECOVERY is what `decl_hand` still owns — see MALFORMED_DECL. Asserted
        // across SEVERAL keywords rather than one, because the point is that this is a
        // property of the `@try` gate itself and not of any single rule: if it were one
        // rule's gap, closing that rule would silently make this assertion vacuous
        // again, which is the exact trap the previous anchor fell into.
        //
        // The set is the STILL-REFUSING keywords, re-pointed this slice: `enum`
        // graduated (its malformed forms now report natively and are asserted as such
        // in the recovery spec below), so keeping it here would have been a guard that
        // cannot fail — the precise vacuity this half exists to prevent. `fn` stays,
        // for the statement-body reason recorded on MALFORMED_DECL.
        !native_without_delegate("malformed_let", MALFORMED_DECL()) &&
        !native_without_delegate("malformed_type", "type Foo = {\n") &&
        !native_without_delegate("malformed_component", "component C {\n") &&
        !native_without_delegate("malformed_fn", "fn foo(\n") &&
        !native_without_delegate("malformed_enum", "enum E {\n") &&
        // ...and the VALID counterpart of the same keyword does NOT report, which is
        // what pins the discriminator to malformed-ness rather than to the keyword.
        native_without_delegate("wellformed_fn", "fn foo() -> int { 1 }")
    }

    then "and the wrappers, bindings, and block forms" {
        // `while { let … }` sits here rather than in the gap assertion because the
        // `block` rule now reads its body as `declaration*`, matching the hand's
        // `parse_statement_list_ids`. Kept as corpus so it cannot silently regress.
        native_without_delegate("while_let",
            "fn f() -> int {\n mut lo = 0\n while lo < 3 {\n  let m = 1\n  lo = m\n }\n lo\n}") &&
        native_without_delegate("for_let",
            "fn f() -> int {\n mut lo = 0\n for i in 0..3 {\n  let m = 1\n  lo = m\n }\n lo\n}") &&
        native_without_delegate("doc", "/// d\nfn f() -> int { 1 }") &&
        native_without_delegate("mut_struct_field", "type S = {\n mut a: int,\n b: int\n}") &&
        // t-myz7: a TRAILING COMMA in a parameter list — the third and last delimiter
        // of the #1140 bug (call args were guarded, #1140 did `]`, params never got it).
        // These 37 sites across 5 files were the whole remaining compiler-source
        // frontier; a file-by-file sweep of all 249 non-test sources now reports ZERO.
        // Asserted HERE rather than through a `dsl_program` parity helper because that
        // helper runs `avra_program_grammar()` — a reduced view that lags production and
        // rejects a trailing comma even in a CALL, which has carried the guard for ages.
        native_without_delegate("tc_params_fn", "fn f(a: int, b: int,) -> int {\n a\n}") &&
        native_without_delegate("tc_params_multiline", "fn f(\n a: int,\n b: int,\n) -> int {\n a\n}") &&
        native_without_delegate("tc_params_extern", "extern fn e(a: int, b: int,) -> int") &&
        native_without_delegate("tc_params_impl", "type T = { x: int }\nimpl T {\n fn m(self, a: int,) -> int {\n a\n }\n}") &&
        native_without_delegate("tc_params_trait", "trait Tr {\n fn m(self, a: int,) -> int\n}") &&
        native_without_delegate("doc_impl_method",
            "type T = { x: int }\nimpl T {\n /// doc\n fn m(self) -> int { 1 }\n}") &&
        native_without_delegate("annot", "@inline\nfn f() -> int { 1 }") &&
        native_without_delegate("mod", "mod m { fn g() -> int { 1 } }") &&
        native_without_delegate("shape", "shape S = { n: string }") &&
        native_without_delegate("const", "const C = 1\nfn main() { }") &&
        native_without_delegate("spec", "spec \"s\" {\n then \"t\" { true }\n}") &&
        // The component INSTANTIATION forms, graduated from the anti-vacuity anchor
        // (t-47hc.5.1 slice C: `bare_comp_inst` / `bare_comp_inst_raw`). Both the BARE
        // form (`acct a { … }`, the `decl_lead` IDENT branch) and the KEYWORD-PREFIXED
        // one (`component acct a { … }`, rule `comp_inst`), in statement AND top-level
        // position — because the discriminator for this family has historically been
        // POSITION rather than shape: a bare-tail `with` and a statement-position map
        // literal were both frontier items that their `let`-init siblings were not.
        native_without_delegate("bare_ident_comp_inst", BARE_IDENT_COMP_INST()) &&
        native_without_delegate("bare_comp_inst_toplevel",
            "component acct { config { balance: int = 100 } }\nacct a { balance = 40 }") &&
        native_without_delegate("kw_comp_inst_toplevel",
            "component acct { config { balance: int = 100 } }\ncomponent acct a { balance = 40 }") &&
        native_without_delegate("kw_comp_inst_stmt",
            "component acct { config { balance: int = 100 } }\nfn u() -> int {\n component acct a { balance = 40 }\n 0\n}") &&
        // SURFACE COVERAGE, added with the anchor correction. These are not previously
        // refusing forms being graduated — every one measured native the first time it
        // was probed. They are here because the recovery anchor above is only "the ONLY
        // thing left" if valid input is genuinely clean across the whole declaration
        // surface, and a corpus assembled purely from forms that once refused proves
        // nothing about the forms that never did.
        //
        // The sweep behind that claim is all 1019 `packages/**/*.av`, not the 249
        // non-test compiler sources earlier sweeps used. But a sweep only ever sees
        // forms PRESENT in the corpus (t-axu9, one level up: the test corpus is not
        // representative either), so these were picked to hit surface the compiler's
        // own sources and its tests happen not to exercise much.
        native_without_delegate("assoc_type", "trait Tr {\n type Item\n fn m(self) -> int\n}") &&
        native_without_delegate("generic_impl",
            "type B<T> = { v: T }\nimpl<T> B<T> {\n fn get(self) -> T { self.v }\n}") &&
        native_without_delegate("impl_for",
            "trait Tr { fn m(self) -> int }\ntype T = { x: int }\nimpl Tr for T {\n fn m(self) -> int { 1 }\n}") &&
        native_without_delegate("union_type", "type E = int | string") &&
        native_without_delegate("comp_method",
            "component c {\n let a: int = 1\n fn m(self) -> int { 1 }\n}") &&
        native_without_delegate("export_mut", "export mut G = 1") &&
        native_without_delegate("module_doc", "//! module doc\nfn f() -> int { 1 }") &&
        native_without_delegate("spec_given", "spec \"s\" {\n given \"g\" {\n  then \"t\" { true }\n }\n}")
    }

    // ── The two leaves are a MUTUAL FALLBACK, and that changes what a zero means ──
    //
    // Raised in review on the `primary_base` corpus (#1157): parity assertions cannot
    // show WHICH leaf answered, so the attribution belongs here, where the refusal
    // harness lives. Asserting it turned up something the corpus alone could not.
    //
    // The feature-form literals — `grammar { … }` / `table { … }`, the seam t-47hc.5
    // flagged on 2026-08-01 — WERE served by the hand through EITHER leaf:
    //
    //   fixture              refuse=decl_hand  refuse=primary_base  refuse=*
    //   grammar { r = "a" }  0                 0                    4   <- NOW 0, native
    //   table { }            0                 0                    4
    //   fn f() -> int { 1 }  0                 0                    0   <- control
    //
    // Refusing one leaf proves nothing here: the other covers. Only removing both
    // exposes the dependency. That is why a BY-NAME sweep reports `primary_base` at
    // zero across all 1005 corpus files while `*` reports 96 refusals in 10 of the 249
    // compiler sources — the numbers answer different questions, and reading the
    // by-name zero as "unreached" is wrong.
    //
    // The distinction is load-bearing for the retirement, in BOTH directions:
    //   * deleting ONE leaf   — by-name zero is the right evidence, and it is green
    //   * deleting BOTH       — needs the feature-form seam built first
    //
    // THE SEAM IS NOW FULLY CLOSED (t-myz7). Both feature forms are native:
    // `grammar { … }` via `grammar_expr` (`@rawbrace`'s canonical consumer), and
    // `table { … }` via `table_lit` / `table_head` / `table_row` — a real rule rather
    // than a capture, because `parse_table_literal` is line-sensitive.
    //
    // This spec red-lit TWICE, once per form, each time the routing landed — which is
    // the evidence it was never vacuous. It pinned a dependency, the dependency was
    // removed, and the assertion inverted rather than quietly staying green. The
    // `table` half is the second of those inversions.
    //
    // CONSEQUENCE, and the reason this matters beyond the two forms: NO valid input in
    // the tree reaches a production leaf any more. The whole compiler compiles under
    // `AVRA_REFUSE_HAND_LEAF='*'` (exit 0), and test_runner/mod.av — the last holdout,
    // 17 refusals, every one a `table<…> { … }` literal — is at 0. Both leaves now
    // survive ONLY as the error-recovery tail, which is what t-47hc.5 has left to do.
    then "the feature-form literals need NEITHER leaf — the seam is closed" {
        // Neither leaf alone is required...
        native_without_delegate("feat_grammar_dh",
            "fn g() -> int {\n let gp = grammar {\n  r = \"a\"\n }\n 0\n}") &&
        native_without_delegate("feat_table_dh",
            "fn t() -> int {\n let x = table { }\n 0\n}") &&
        // ...and now NEITHER form needs either leaf, so even `*` leaves both untouched.
        !refused_here("*", "feat_grammar_all",
            "fn g() -> int {\n let gp = grammar {\n  r = \"a\"\n }\n 0\n}") &&
        !refused_here("*", "feat_table_all",
            "fn t() -> int {\n let x = table { }\n 0\n}") &&
        // ...and a plain fn needs neither, which pins the discriminator to the feature
        // form rather than to "any program reaches a leaf under `*`".
        //
        // ANTI-VACUITY: every assertion in this `then` is now NEGATIVE, so on its own it
        // would also pass if `refused_here` had simply stopped detecting refusals. The
        // POSITIVE evidence lives one spec up — "the probe DISCRIMINATES — a malformed
        // declaration still needs the delegate" — which asserts a refusal that must FIRE.
        // Both leaves remain reachable for error recovery, so that probe stays live and
        // keeps this one honest. If it is ever deleted, these negatives go vacuous.
        !refused_here("*", "feat_control_all", "fn f() -> int { 1 }")
    }

    // t-myz7 — the FIRST MALFORMED form to stop needing the leaf.
    //
    // Valid input already needs neither leaf (the spec above). RECOVERY is the part
    // still outstanding: every routed decl keyword delegates its aborts to
    // `@hand(decl_hand)`, because a native rule that reports rolls back under `@try`
    // and the hand re-parses. `mod_decl` is the first to OWN its abort, via
    // `@try … @cut @require` inside the fragment rule — referenced BARE from
    // `declaration` so the `@try` and its `@cut` share a branch. They have to: a
    // `@cut`'s commit flag is per-RULE-INVOCATION (executor.av CapEnv) and cannot
    // reach a caller's `@try`, so a cut written in a rule invoked as `@try mod_decl`
    // is rejected outright.
    //
    // That shape required the emit fix landing in this same change: a LONE `@try`
    // branch was lowered by emit_single_branch, straight into the rule fn with no
    // dispatch loop, so it emitted the caller's bookkeeping (`s_diags` / `s_err` /
    // `s_cut`, plus a `break`) with nothing declaring it — the generated parser did
    // not compile. Silent until now only because no rule had the shape.
    then "malformed `mod` and `use` own their recovery — the first forms off the leaf" {
        // All three of the hand's abort paths for `mod` are native now. Each asserts
        // BOTH halves — reports, and reports without the delegate.
        recovery_without_delegate("mod_bare", "mod\nfn f() -> int { 1 }") &&
        recovery_without_delegate("mod_num", "mod 5\nfn f() -> int { 1 }") &&
        recovery_without_delegate("mod_brace", "mod {\nfn f() -> int { 1 }") &&
        // `use` follows, via `@try … @cut` on use_decl plus `@fallback` on the bare
        // branch so a token that starts NEITHER form still reports "expected module
        // path after `use`" instead of falling through un-owned.
        recovery_without_delegate("use_bare", "use\nfn f() -> int { 1 }") &&
        recovery_without_delegate("use_dot", "use .{x}\nfn f() -> int { 1 }") &&
        recovery_without_delegate("use_no_brace", "use foo\nfn f() -> int { 1 }") &&
        recovery_without_delegate("use_pkg_noname", "use @std.{}\nfn f() -> int { 1 }") &&
        recovery_without_delegate("use_pkg_dotdot", "use @std..{x}\nfn f() -> int { 1 }") &&
        // The keywords that GRADUATED this slice. Each was previously an anti-vacuity
        // anchor in the spec above (asserted to still need the leaf); moving them here
        // rather than deleting them is what keeps the frontier's coverage monotone —
        // the claim changes from "still needs the leaf" to "reports WITHOUT it", and
        // both directions stay under test the whole way across.
        recovery_without_delegate("trait_open", "trait T {\nfn f() -> int { 1 }") &&
        recovery_without_delegate("trait_noname", "trait {\nfn f() -> int { 1 }") &&
        recovery_without_delegate("shape_open", "shape S = {\nfn f() -> int { 1 }") &&
        // `impl` GRADUATED (t-myz7) — its malformed forms move here rather than being
        // deleted, so the frontier's coverage grows with it instead of thinning.
        recovery_without_delegate("impl_open", "impl Foo {\nfn f() -> int { 1 }") &&
        recovery_without_delegate("impl_noname", "impl {\nfn f() -> int { 1 }") &&
        recovery_without_delegate("impl_badmember", "impl Foo { 5 }\nfn f() -> int { 1 }") &&
        // `component` GRADUATED (t-47hc.5) — all four header shapes, the config /
        // children / body-marker blocks, and both body loops.
        recovery_without_delegate("comp_field", "component acct_sr { balance: int = 100 }\nfn f() -> int { 1 }") &&
        recovery_without_delegate("comp_noname", "component\nfn f() -> int { 1 }") &&
        recovery_without_delegate("comp_nobrace", "component C\nfn f() -> int { 1 }") &&
        recovery_without_delegate("comp_config", "component C { config }\nfn f() -> int { 1 }") &&
        // `let` GRADUATED (t-47hc.5 Phase 4) — the last KEYWORD off the leaf. Its
        // malformed forms move here rather than being deleted, same as every keyword
        // before it, so the frontier's coverage grows instead of thinning. All eight
        // are the forms the binding specs cover: missing name, missing `=`, missing
        // initializer, a non-name where the name goes, the empty type annotation on
        // all three binding keywords, and the destructure list.
        recovery_without_delegate("let_eq", "let = 5\nfn f() -> int { 1 }") &&
        recovery_without_delegate("let_bare", "let\nfn f() -> int { 1 }") &&
        recovery_without_delegate("let_noeq", "let x\nfn f() -> int { 1 }") &&
        recovery_without_delegate("let_noinit", "let x =\nfn f() -> int { 1 }") &&
        recovery_without_delegate("let_num", "let 5 = 1\nfn f() -> int { 1 }") &&
        recovery_without_delegate("let_notype", "let x: = 1\nfn f() -> int { 1 }") &&
        recovery_without_delegate("mut_notype", "mut x: = 1\nfn f() -> int { 1 }") &&
        recovery_without_delegate("const_notype", "const X: = 1\nfn f() -> int { 1 }") &&
        recovery_without_delegate("letdes_bad", "let (a b) = t\nfn f() -> int { 1 }") &&
        // ANTI-VACUITY: negatives alone would also pass if `refused_here` simply
        // stopped detecting refusals, so one form must still refuse. `enum` held this
        // role, then `impl`, then `component`, then `let` — every one of them a
        // KEYWORD, and all have converted.
        //
        // The successor is NOT a keyword, because none is left. It is the bare-IDENT
        // lead `@peek(decl_lead)` admits — a component instantiation whose component
        // is undeclared, which `bare_comp_inst` declines and the gate hands to
        // `decl_hand`. That is the leaf's remaining production role, and the honest
        // statement of what deleting it will have to account for.
        //
        // Note what this ANCHOR's move corrects: the doc block on BARE_IDENT_COMP_INST
        // says `decl_hand`'s remaining role is "ERROR RECOVERY, for every declaration
        // keyword at once", because a `@try` branch rolls back on any report. That
        // stopped being true as each keyword took a `@cut` — a committed rule owns its
        // recovery and never rolls back — and `let = 5` refusing ZERO times is the
        // measurement that says so.
        refused_here("decl_hand", "bare_inst_still_needs_leaf", "Foo bar { x: 1 }\nfn f() -> int { 1 }")
    }
}
