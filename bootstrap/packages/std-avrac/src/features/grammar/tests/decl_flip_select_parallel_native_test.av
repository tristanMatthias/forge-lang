use @std.avrac.features.grammar.{avra_decl_dispatch_grammar, emit_parser_source_ex}
use @std.avrac.features.grammar.{emitted_rule_speculates}
use @std.avrac.core.{avra_shell_exec_status, avra_selfhost_write_file, avra_selfhost_read_file}

fn decl_src() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}

fn check_out(name: string, env: string, src: string) -> string {
    let fixture = "build/_decl_selpar_${name}.av"
    let log = "build/_decl_selpar_${name}.log"
    let _ = avra_selfhost_write_file(fixture, src)
    let rc = avra_shell_exec_status("${env} ./build/bs2 check '${fixture}' > '${log}' 2>&1")
    "__status=${rc}\n" + avra_selfhost_read_file(log)
}

fn clean(out: string) -> bool { out.contains("__status=0\n") }

fn clean_all_paths(name: string, src: string) -> bool {
    // t-bw9s: two DISTINCT routings survive here — production (the generated static
    // parser) and the grammar EXECUTOR. The `_emit` and `_hand` legs pinned
    // AVRA_NO_STATIC_FALLBACK and AVRA_PARSER_DECL_FLIP; both flags are dead (the
    // interpreter re-parse fallback went in t-47hc.4.3, the decl hand parser with the
    // `@hand(decl_hand)` leaf), so those legs had become empty-env duplicates of
    // `_dflt`. Keeping them would report four paths while exercising two.
    clean(check_out("${name}_dflt", "", src)) &&
        clean(check_out("${name}_exec", "AVRA_PARSER_DECL_STATIC=0", src))
}

/// Thin wrapper over the SHARED `emitted_rule_speculates` (ast.av) — the slicing and
/// the scaffolding strings live there so this file and its sibling cannot drift apart.
fn rule_speculates(head: string) -> bool {
    emitted_rule_speculates(decl_src(), head)
}

/// A malformed fixture must report `needle` on EVERY native path, not just the
/// default. The default path answers invalid input with the EXECUTOR (static ->
/// had_error -> re-parse), so a `default`-only assertion measures the executor and
/// leaves the emitted static parser untested — the t-zrn3 blind spot in reverse.
fn reports_all_paths(name: string, src: string, needle: string) -> bool {
    let d = check_out("${name}_dflt", "", src)
    let e = check_out("${name}_emit", "", src)
    let x = check_out("${name}_exec", "AVRA_PARSER_DECL_STATIC=0", src)
    !clean(d) && d.contains(needle) &&
        !clean(e) && e.contains(needle) &&
        !clean(x) && x.contains(needle)
}

spec "t-47hc Phase 4: select / parallel are emitted as native rules" {
    then "all three parse fns exist in the production declaration parser" {
        let src = decl_src()
        src.contains("fn parse_select_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_parallel_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_select_arm(st: PState) -> CapVal")
    }

    then "they are dispatched, and NO decl_hand gate survives (t-47hc.4.3)" {
        let src = decl_src()
        let sel_at = src.index_of("parse_select_decl(st)")
        let par_at = src.index_of("parse_parallel_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        // BOTH reach the dispatcher by a direct predictive `return parse_X(st)` now:
        // each one's `@try` lives INSIDE its rule (a `@cut`'s commit flag is
        // per-rule-invocation and cannot reach a caller's `@try`), so neither lowers to
        // the speculative `s_last = …` bookkeeping in the dispatcher any more.
        //
        // The forms are asserted EXPLICITLY rather than dropping the check, because
        // "routed as `@try`, never bare" is the invariant — see the speculation
        // assertions below, which read each rule BODY for it. Pinning only `s_last = `
        // would have quietly stopped testing a keyword the moment it committed, which is
        // what this assertion is here to prevent.
        // Bound to the `decl_hand` POSITION, not merely present: index the EXACT
        // dispatch text and compare that index with `hand_at`. `contains` alone would
        // pass if the direct return sat AFTER the hand gate, or in some other fn
        // entirely — which is the #1028 dead-code failure this assertion exists for.
        let sel_ret = src.index_of("return parse_select_decl(st)")
        let par_ret = src.index_of("return parse_parallel_decl(st)")
        hand_at < 0 && sel_ret >= 0 && par_ret >= 0 && sel_at >= 0 && par_at >= 0
    }

    then "`select` / `parallel` are routed as `@try`, never bare — each rule owns its rollback" {
        // The other half of the dispatch check above. A direct `return parse_X(st)`
        // is only safe when the rule ITSELF speculates: it must snapshot, and on a
        // pre-`@cut` failure roll the cursor, node store and diagnostics back so the
        // `@hand` gate below still sees untouched input. A BARE branch would be
        // error-TOLERANT and build partial nodes where the hand aborts.
        rule_speculates("fn parse_select_decl(st: PState)") &&
            rule_speculates("fn parse_parallel_decl(st: PState)")
    }

    then "the select-arm accumulator is typed List<SelectArm>, not the ExprId default" {
        // The kind-plumbing trap the `pattern` / `tparam` / `match_arm` emit
        // entries were written for: a mis-kinded repeat coerces arms through
        // capval_to_expr and corrupts the tree (or fails to compile).
        let src = decl_src()
        src.contains("List<SelectArm>") && src.contains("capval_to_select_arm(st,")
    }
}

spec "t-47hc Phase 4: the concurrency forms parse on all four paths" {
    then "a parallel block with a body compiles clean everywhere" {
        clean_all_paths("par",
            "fn main() {\n" +
            "    parallel {\n" +
            "        println(\"a\")\n" +
            "        println(\"b\")\n" +
            "    }\n" +
            "}\n")
    }

    then "an EMPTY parallel block compiles clean everywhere" {
        clean_all_paths("par_empty", "fn main() {\n    parallel { }\n}\n")
    }

    then "a single-arm select compiles clean everywhere" {
        clean_all_paths("sel",
            "fn main() {\n" +
            "    let ch = channel<int>(1)\n" +
            "    ch.send(1)\n" +
            "    select { v <- ch -> { println(string(v)) } }\n" +
            "}\n")
    }

    then "a multi-arm select compiles clean everywhere" {
        clean_all_paths("sel_multi",
            "fn main() {\n" +
            "    let a = channel<int>(1)\n" +
            "    let b = channel<string>(1)\n" +
            "    a.send(1)\n" +
            "    select {\n" +
            "        v <- a -> { println(string(v)) }\n" +
            "        s <- b -> { println(s) }\n" +
            "    }\n" +
            "}\n")
    }

    then "an EMPTY select compiles clean everywhere — zero arms is valid" {
        clean_all_paths("sel_empty", "fn main() {\n    select { }\n}\n")
    }
}

spec "t-47hc Phase 4: the concurrency frontier did not widen" {
    then "`parallel x` stays a parse error on the default path" {
        let out = check_out("par_junk", "", "fn main() {\n    parallel x\n}\n")
        !clean(out) && out.contains("error[F0001]")
    }

    then "`select { x }` reports the missing-`<-` diagnostic on every native path" {
        // OWNED NATIVELY now (t-myz7): `@cut` sits right after `select`, so the arm's
        // `@expect("<-", …)` reports instead of the branch rolling back to
        // select_stmt/parser.av. Asserted on all three native paths rather than the
        // default alone, because the default answers invalid input with the EXECUTOR —
        // a default-only check leaves the emitted static parser unmeasured.
        reports_all_paths("sel_noarrow", "fn main() {\n    select { x }\n}\n",
            "expected `<-` after select arm binding")
    }

    then "`select { 5 }` stays a parse error — a non-IDENT never starts an arm" {
        // The `@gate` on the arm repetition is what makes this REPORT rather than
        // silently ending the arm list; `@expect("IDENT", …)` supplies its wording.
        reports_all_paths("sel_num", "fn main() {\n    select { 5 }\n}\n", "error[F0001]")
    }
}
