// WHY: `template_lit = t:TEMPLATE -> MkTemplate(t)` — interpolated strings as
// a two-engine differential (interpreter vs generated parser), covering nested
// interpolation, adjacent templates, and the plain-string boundary.

use @std.avrac.features.grammar.{run_grammar_expr, avra_expr_grammar}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_expr_id}

// The DSL's rendered expr for `src` under the production expression grammar, whose
// `template_lit` rule owns the TEMPLATE token natively.
fn dsl_expr(src: string) -> string {
    let r = run_grammar_expr(avra_expr_grammar(), src)
    if r.had_error { return "<dsl err>" }
    render_expr_id(r.store, r.root)
}

// The PRODUCTION parser's rendered expr for the same `src`. Was the hand
// `parse_primary` (its Tk.Template arm); that ladder is deleted (t-47hc.4.1), so this
// is the generated static parser via `parse_expression`. Interpreter-vs-emit remains a
// genuine differential: two engines, one grammar.
fn prod_expr(src: string) -> string {
    mut p = parser_new(src)
    // PIN the engine — see the sibling note in brace_hand_test. An ambient
    // AVRA_PARSER_EXPR_FLIP=1 would route this into the same interpreter `dsl_expr`
    // drives, collapsing the differential onto one engine.
    p.expr_flip = false
    match p.parse_expression() {
        .Ok(id) -> render_expr_id(p.store, id)
        .Err(_) -> "<prod err>"
    }
}

fn agree(src: string) -> bool {
    dsl_expr(src) == prod_expr(src)
}

// Build the SOURCE of an interpolated string literal WITHOUT the "${" appearing
// contiguously in THIS file (which would interpolate here). `d` is a lone "$".
fn interp(body: string) -> string {
    "\"" + body + "\""
}

// NOTE: no interpolation syntax appears in ANY string literal here (not even in
// descriptions) — the interpolated SOURCE under test is built by concatenating a
// lone "$" with "{...}", so this file itself never triggers interpolation.
spec "t-47hc.19: grammar-native template_lit — interpreter == generated parser" {
    given "a lone interpolation" {
        then "hi-x interpolation agrees and is not a DSL error" {
            let d = "$"
            let s = interp("hi " + d + "{x}")
            dsl_expr(s) != "<dsl err>" && agree(s)
        }
    }
    given "multiple interpolations + surrounding text" {
        then "a-and-b interpolation agrees" {
            let d = "$"
            let s = interp(d + "{a} and " + d + "{b}!")
            agree(s)
        }
    }
    given "a nested-call interpolation expression" {
        then "v-equals-f-of-y interpolation agrees" {
            let d = "$"
            let s = interp("v=" + d + "{f(y)}")
            agree(s)
        }
    }
    given "a PLAIN (non-interpolated) string still routes through STRING" {
        then "plain string agrees (matched by the STRING terminal)" {
            agree("\"plain\"")
        }
    }
}
