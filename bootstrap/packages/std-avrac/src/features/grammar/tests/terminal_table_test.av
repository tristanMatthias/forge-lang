// t-y2i7.8 deliverable (1): the grammar's TERMINAL set is declared ONCE.
//
// It used to be written twice, as inverse ladders kept in lockstep by hand:
//
//     emit.av  `named_tk_guard`       NAME -> the guard TEXT the parser tests
//     real_lex `tk_to_grammar_kind`   Tk   -> NAME, for the executor
//
// Drift between them is the recurring failure in this area — #1336 and #1338
// each fixed one terminal (FIELDNAME, then NUMBER and BOOL) where the two sides
// had come to disagree. One row now carries BOTH halves, so agreement is
// STRUCTURAL: there is no second declaration to drift from.
//
// (An earlier attempt at this shipped and was reverted: the shared predicate
// column tripped a real ABI bug — a bool-returning fn value read as i64 with
// undefined high bits — which made every token classify as the first row on
// x86-64. That is t-21gy, fixed in #1356, and the column is back on top of it.
// If this file ever goes red on Linux only, re-read that ticket first.)
//
// These specs pin the PROPERTIES that make one declaration safe, not the
// particular contents, so adding a terminal does not force a test edit.

use @std.avrac.features.grammar.{terminal_rules, terminal_guard, tk_to_grammar_kind}
use @std.avrac.core.{Tk, KwId}

spec "the terminal set is declared once (t-y2i7.8)" {
    then "every row carries a name" {
        mut ok = true
        for t in terminal_rules() { if t.name == "" { ok = false } }
        ok
    }
    then "names are unique — two rows claiming one terminal is the drift this removes" {
        mut dupes = 0
        let rs = terminal_rules()
        mut i = 0
        while i < rs.length {
            mut j = i + 1
            while j < rs.length {
                if rs[i].name == rs[j].name { dupes = dupes + 1 }
                j = j + 1
            }
            i = i + 1
        }
        dupes == 0
    }
    then "the emitter's lookup answers from the SAME rows" {
        mut ok = true
        for t in terminal_rules() { if terminal_guard(t.name) != t.guard { ok = false } }
        ok
    }
    then "an unknown terminal has no guard, so the emitter falls back to a kind compare" {
        terminal_guard("NOT_A_TERMINAL") == ""
    }
    then "the EXECUTOR answers from those same rows too — structural, not merely equal" {
        // Drives the real classifier and requires its answer to BE a declared
        // row's name (or a documented catch-all). Nothing here re-describes the
        // terminal set, which is the whole point: a second description is the
        // thing that used to drift.
        let rs = terminal_rules()
        mut bad = 0
        for tk in [Tk.Identifier, Tk.Number, Tk.String, Tk.Eof, Tk.Error,
                   Tk.Template, Tk.DocComment, Tk.ModDocComment,
                   Tk.Keyword(KwId.True), Tk.Keyword(KwId.False), Tk.Keyword(KwId.If)] {
            let k = tk_to_grammar_kind(tk)
            mut found = k == "KW" || k == "PUNCT"
            for t in rs { if t.name == k { found = true } }
            if !found { bad = bad + 1 }
        }
        bad == 0
    }
    then "every row's own predicate agrees with the classifier's answer" {
        // The structural claim, tested directly: if a row's `matches` accepts a
        // token, the classifier must return THAT row's name — i.e. both engines
        // really are reading one row, not two that happen to coincide.
        let rs = terminal_rules()
        mut bad = 0
        for tk in [Tk.Identifier, Tk.Number, Tk.String, Tk.Eof, Tk.Error,
                   Tk.Template, Tk.DocComment, Tk.ModDocComment,
                   Tk.Keyword(KwId.True), Tk.Keyword(KwId.False)] {
            mut first = ""
            for t in rs { if first == "" && t.matches(tk) { first = t.name } }
            if first != "" && first != tk_to_grammar_kind(tk) { bad = bad + 1 }
        }
        bad == 0
    }
    then "literals classify as literals, not as keywords" {
        // The exact drift #1338 fixed, and the exact symptom t-21gy produced:
        // a number or bool falling through to a catch-all or to the first row.
        tk_to_grammar_kind(Tk.Number) == "NUMBER"
            && tk_to_grammar_kind(Tk.Keyword(KwId.True)) == "BOOL"
            && tk_to_grammar_kind(Tk.Keyword(KwId.False)) == "BOOL"
    }
    then "EMITTER-ONLY rows never claim a token" {
        // WORD tests the token's TEXT and FIELDNAME is reached through the
        // executor's own fall-through. Either claiming a token here would
        // mis-classify it — and because they sit FIRST in the table, they would
        // claim EVERY token. That is precisely what t-21gy did.
        mut ok = true
        for t in terminal_rules() {
            if t.name == "WORD" || t.name == "FIELDNAME" {
                if t.matches(Tk.Identifier) || t.matches(Tk.Number) || t.matches(Tk.Eof) { ok = false }
            }
        }
        ok
    }
}
