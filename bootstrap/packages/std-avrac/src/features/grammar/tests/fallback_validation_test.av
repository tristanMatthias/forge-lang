// WHY: pins validate_fallbacks' position/combination semantics, which became
// load-bearing when grammar_checked made grammar-parse errors fatal (they were
// silently swallowed by every `.grammar` accessor before): the production
// postfix_suffix rule carries a GUARDED non-last `@fallback` alongside a `@try`
// sibling, so the validator must accept exactly that shape while still
// rejecting the forms the engines genuinely diverge on. See the WHY comments in
// seed_parser.validate_fallbacks for the per-form engine analysis.
use @std.avrac.features.grammar.{parse_grammar}

spec "validate_fallbacks: position and @try-combination semantics" {
    given "a GUARDED non-last fallback (the postfix_suffix shape)" {
        then "it is accepted — ordered dispatch under its own guard in both engines" {
            let gp = parse_grammar("r = @when(allow_struct_lit) \"a\" | @fallback @when(allow_struct_lit) \".\" \"b\" | \"c\"")
            gp.error == ""
        }
    }
    given "an UNGUARDED non-last fallback" {
        then "it is rejected — emit silently drops the marker outside last position" {
            let gp = parse_grammar("r = \"a\" | @fallback \".\" \"b\" | \"c\"")
            gp.error != "" && gp.error.contains("must be the LAST alternative")
        }
    }
    given "an unguarded LAST fallback (the index_tail shape)" {
        then "it stays accepted" {
            let gp = parse_grammar("r = \"a\" | @fallback \"]\" \"b\"")
            gp.error == ""
        }
    }
    given "a LAST fallback with a @try sibling" {
        then "the combination is still rejected — the emitted tail is has_spec-suppressed" {
            let gp = parse_grammar("r = @try \"a\" \"x\" | @fallback \"]\" \"b\"")
            gp.error != "" && gp.error.contains("combines `@try` and `@fallback`")
        }
    }
    given "a GUARDED non-last fallback with a @try sibling (postfix_suffix exactly)" {
        then "it is accepted — no emitted tail is involved" {
            let gp = parse_grammar("r = @try \"a\" \"x\" | @fallback @when(allow_struct_lit) \".\" \"b\" | \"c\"")
            gp.error == ""
        }
    }
    given "@require on a fallback's LEADING item (index_tail's `]`)" {
        then "it is accepted — a fallback's leading item is NOT FIRST-proved" {
            let gp = parse_grammar("r = \"a\" | @fallback @require \"]\" @expect(\"]\", \"expected `]`\") -> MkNone()")
            gp.error == ""
        }
    }
    given "@require on an ordinary branch's leading item" {
        then "it stays rejected — that position is the FIRST-set guard" {
            let gp = parse_grammar("r = @require \"a\" \"x\" | \"b\"")
            gp.error != "" && gp.error.contains("cannot sit on a sequence's leading item")
        }
    }
}
