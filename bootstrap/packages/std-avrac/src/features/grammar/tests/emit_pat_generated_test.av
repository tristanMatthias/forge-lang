// ps3t.6.5.11 (pattern family) — emit.av RENDERS the generated static parser
// for the pattern family: `parse_pattern_or` folds the right-recursive
// or-pattern and the Pattern builds (OrMaybe / IdentPat / MkVariant / PatBool /
// PatStr / PatNum / PatNegNum / OptPresent / OptAbsent) lower through the
// MANIFEST — since t-kd4y.3.2.6 they are feature-owned rows in
// features/match/lowering, so each emits as its normalized-ABI adapter call
// (`<export_name>(st, [args…])`) rather than a central template. Fast in-suite
// structural guard on the emitter over avra_pat_grammar(); the executor
// differential is pattern_equivalence_test and the airtight behavioural gate is
// diagnose.sh --emit-gen-check (which covers patterns too).
//
// These assertions are the EMIT half of the flip-parity contract: the executor
// reaches the very same adapters through apply_build's manifest consult, so
// pinning the call spelling here pins both engines to one lowering.

use @std.avrac.features.grammar.{emit_parser_source}
use @std.avrac.core.{OpId, tk_is_op}
// t-47hc.8: the pattern grammar fragment is owned by the match feature (features/match.av).
use @std.avrac.features.match.{avra_pat_grammar}

fn emit_all() -> string {
    emit_parser_source(avra_pat_grammar())
}

spec "grammar emitter: renders the pattern family's generated static parser" {
    then "the pattern rules emit their parse fns" {
        let src = emit_all()
        src.contains("fn parse_pattern_or(st: PState) -> CapVal") &&
        src.contains("fn parse_pattern(st: PState) -> CapVal") &&
        src.contains("fn parse_variant_pat(st: PState) -> CapVal")
    }

    then "the pattern dispatch guards the leading forms and delegates" {
        let src = emit_all()
        // ps3t.6.7 perf: the `.` (variant) guard dispatches on the Tk enum (tk_guard);
        // the STRING named terminal now dispatches on the Tk enum too (t-47hc.4.1.9).
        // t-47hc.8 one-file dedup: the dispatch site calls the rule's shared FIRST
        // predicate; the Tk test lives in the predicate body — both pinned.
        src.contains("if starts_variant_pat(st) {") &&
        src.contains("return parse_variant_pat(st)") &&
        src.contains("fn starts_variant_pat(st: PState) -> bool {\n    tk_is_op(st.cur().tk, OpId.Dot)\n}") &&
        src.contains("fn starts_str_pat(st: PState) -> bool {\n    st.cur().tk == Tk.String\n}")
    }

    then "the or-pattern routes its optional right side through the manifest adapter" {
        let src = emit_all()
        // OrMaybe's optional `r` stays a bare CapVal var (`.Nil` when absent) —
        // the adapter, not the generated fn, decides passthrough-vs-Pattern.Or.
        src.contains("or_maybe_abi(st, [l, r])")
    }

    then "the leaf builds emit as their manifest ABI calls" {
        let src = emit_all()
        src.contains("pat_bool_abi(st, [b])") &&
        src.contains("pat_str_abi(st, [s])") &&
        src.contains("pat_neg_num_abi(st, [n])") &&
        src.contains("pat_num_abi(st, [n])") &&
        src.contains("ident_pat_abi(st, [name, b])")
    }

    then "variant_pat dispatches its nested-alternation payload (binds | subs)" {
        let src = emit_all()
        // A structural (multi-branch) group becomes an if/else-if on each
        // branch's FIRST (the shared predicate); the MkVariant row then takes
        // BOTH accumulators, each wrapped in its kind's CapVal list ctor, and
        // picks Variant-vs-NestedVariant inside the adapter.
        src.contains("} else if starts_variant_pat(st) {") &&
        src.contains("mk_variant_abi(st, [name, CapVal.Toks(binds_list), CapVal.PNodes(subs_list)])")
    }

    then "the optional-match arm surface routes through the manifest adapters" {
        let src = emit_all()
        // `let <name>` → .Some(name); `none`/`null` → .None (spec Axis 10.4),
        // both via core/ast's shared reducers inside the adapters. Dispatch via
        // the shared FIRST predicates; keyword tests in their bodies. OptAbsent
        // is the arity-0 row — its call carries an empty arg list.
        src.contains("if starts_opt_present(st) {") &&
        src.contains("fn starts_opt_present(st: PState) -> bool {\n    st.cur().text == \"let\"\n}") &&
        src.contains("opt_present_abi(st, [name])") &&
        src.contains("if starts_opt_absent(st) {") &&
        src.contains("fn starts_opt_absent(st: PState) -> bool {\n    st.cur().text == \"none\" || st.cur().text == \"null\"\n}") &&
        src.contains("opt_absent_abi(st, [])")
    }

}
