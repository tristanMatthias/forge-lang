// WHY: t-47hc (paren_expr flip prep) — the DORMANT `( a, b, … )` tuple BUILD
// (mk_tuple), proven here via a test grammar BEFORE it is spent to nativize the tuple
// branches of @hand(paren_expr) in avra_expr_grammar. The build is referenced by NO
// production grammar yet, so emit-gen-check + diff-test stay byte-identical (the #988
// dormant-primitive discipline: build the primitive, prove it, spend it later). Both
// sides are exercised: the INTERPRETER (run_grammar_expr) builds the real Expr.Tuple
// (render-checked), and the EMITTER (emit_rule_fn) lowers the same build to a mk_tuple
// call in the generated static parser.
//
// mk_tuple is the structural twin of mk_list_lit (#989): Expr.Tuple and Expr.ListLit
// are the SAME shape (one `List<ExprId>` child, walker-opaque, alloc_at `[]` edges), so
// the only difference is the node ctor. This pins that equivalence + the `(` span anchor
// (matching hand parse_paren_expr alloc_at(Expr.Tuple, sp_start), mod.av:2324/2362).
use @std.avrac.features.grammar.{parse_grammar, run_grammar_expr, emit_rule_fn}
use @std.avrac.core.{render_expr_id}

// Parse `grammar_src`, run rule 0 over `input`, render the resulting expression.
fn run_render(grammar_src: string, input: string) -> string {
    let gp = parse_grammar(grammar_src)
    let r = run_grammar_expr(gp.grammar, input)
    render_expr_id(r.store, r.root)
}

// Emit the named rule's generated static parse fn from `grammar_src`.
fn emit_rule(grammar_src: string, rule: string) -> string {
    let gp = parse_grammar(grammar_src)
    for gr in gp.grammar.rules {
        if gr.name == rule { return emit_rule_fn(gp.grammar, gr) }
    }
    ""
}

// The tuple grammar: `(` optional-comma-list `)` -> MkTuple. Elements are a node-
// producing `paren` sub-rule (`( NUMBER )` -> Grouping) because append_node collects
// Expr NODES, not bare terminal tokens — exactly the trick list_builds_test uses, and
// exactly what the real paren_expr's `a:expression` yields (Expr nodes). Empty/single/
// multi are uniform (Nil -> []). Uses `[ ]` as the outer delimiter so the inner `paren`
// sub-rule's `( )` don't collide with the tuple's own brackets in this synthetic test.
fn tup_g() -> string { "r = \"[\" ( a:paren ( \",\" a:paren )* )? \"]\" -> MkTuple(a)\n paren = \"(\" e:NUMBER \")\" -> Grouping(e)" }

spec "t-47hc: DORMANT tuple build (mk_tuple) — interpreter builds Expr.Tuple" {
    then "a multi-element tuple builds Expr.Tuple in source order" {
        run_render(tup_g(), "[(1), (2), (3)]") == "(tuple ((group 1), (group 2), (group 3)))"
    }
    then "a single-element tuple builds a one-element Expr.Tuple" {
        run_render(tup_g(), "[(7)]") == "(tuple ((group 7)))"
    }
    then "an empty tuple builds an empty Expr.Tuple" {
        run_render(tup_g(), "[]") == "(tuple ())"
    }
}

spec "t-47hc: DORMANT tuple build (mk_tuple) — emitter lowers to a mk_tuple call" {
    then "the emitter lowers MkTuple to a mk_tuple call spanned at sp_start" {
        let src = emit_rule(tup_g(), "r")
        src.contains("mk_tuple(st, sp_start,") && src.contains("let sp_start = st.cur().pos")
    }
    then "the emitted MkTuple passes the comma-list accumulator (a_list)" {
        emit_rule(tup_g(), "r").contains("CapVal.Nodes(a_list)")
    }
    then "WITHOUT a build, no mk_tuple call is emitted (byte-identical for grammars not using it)" {
        // The `paren` sub-rule builds Grouping, not MkTuple — so its emitted fn has no
        // mk_tuple. Confirms mk_tuple appears ONLY where MkTuple is written.
        !emit_rule(tup_g(), "paren").contains("mk_tuple(")
    }
}
