// ps3t.6.5.7 — the DECLARATION family, annotation-ARGS slice: `@name(args)`
// annotations. This is the args-carrying sibling of the bare-`@name` slice.
// `@name(a, b) <decl>` builds Stmt.Annotated([Annotation{name, arg_ids}], _)
// where arg_ids are the built argument EXPRESSIONS (parse_annotations →
// parse_arg_list_ids), reusing the DSL expression family.
//
// Because render_annotation_list prints only the annotation NAME (arg_ids are
// dropped from the render), the differential `agree()` alone can't see the
// args — a DSL that mis-built or dropped them would still render identically
// (the render-hides-detail trap). So a dedicated block reaches PAST the render:
// it asserts the first annotation's arg COUNT and the first arg's rendered
// EXPRESSION match the hand parser directly. Args here are idents / numbers
// (Expr.Ident / Expr.Number) — no string-quote handling to differ on.
//
// Oracle: run the DSL-generated parser AND the shipping hand-written parser
// (parser_new(src).parse_declaration()) over a corpus and assert identical
// ASTs via render_stmt_id, plus the direct arg checks.
use @std.avrac.features.grammar.{parse_grammar, run_grammar_stmt}
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id, render_expr_id, NodeStore, StmtId}

fn ann_args_grammar_src() -> string {
    "grammar Decl {\n" +
    "  declaration    = annotated_decl | member\n" +
    "  annotated_decl = ( ann:annotation )+ inner:member -> MkAnnotatedArgs(ann, inner)\n" +
    "  annotation     = \"@\" aname:IDENT ( \"(\" ( aargs:expression ( \",\" aargs:expression )* )? \")\" )? -> MkAnn(aname, aargs)\n" +
    "  member         = fn_decl | type_decl | enum_decl\n" +
    "  fn_decl        = \"fn\" fname:IDENT \"(\" ( params:param ( \",\" params:param )* )? \")\" ( \"->\" ret:type_expr )? \"{\" ( body:statement )* \"}\" -> MkFnDecl(fname, params, ret, body)\n" +
    "  type_decl      = \"type\" tname:IDENT \"=\" \"{\" ( fields:field \",\"? )* \"}\" -> MkTypeDecl(tname, fields)\n" +
    "  enum_decl      = \"enum\" edname:IDENT \"{\" ( vars:variant \",\"? )* \"}\" -> MkEnumDecl(edname, vars)\n" +
    "  field          = fldname:IDENT \":\" ftype:type_expr -> MkField(fldname, ftype)\n" +
    "  variant        = vname:IDENT ( \"(\" ( vfields:field \",\"? )* \")\" )? -> MkEVariant(vname, vfields)\n" +
    "  param          = pname:IDENT ( \":\" pt:type_expr )? -> MkParam(pname, pt)\n" +
    // ── body statement subset ──
    "  statement      = break_stmt | continue_stmt | return_stmt | expr_stmt\n" +
    "  break_stmt     = \"break\" -> Break()\n" +
    "  continue_stmt  = \"continue\" -> Continue()\n" +
    "  return_stmt    = \"return\" re:expression -> Return(re)\n" +
    "  expr_stmt      = es:expression -> ExprStmt(es)\n" +
    // ── type family ──
    "  type_expr      = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom      = fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  fn_type        = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" tr:type_expr )? -> MkFn(lp, p, tr)\n" +
    "  dyn_type       = \"dyn\" dt:IDENT -> TyDyn(dt)\n" +
    "  list_type      = \"[\" el:type_expr \"]\" -> TyList(el)\n" +
    "  paren_type     = \"(\" ( pt2:type_expr ( \",\" pt2:type_expr )* )? \")\" -> TyParen(pt2)\n" +
    "  named_type     = tn:IDENT ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(tn, a, opt)\n" +
    // ── expression family (annotation args + bodies) ──
    "  expression     = equality\n" +
    "  equality       = l:comparison ( op:(\"!=\" | \"==\") r:comparison )* -> fold_binary(l, op, r)\n" +
    "  comparison     = l:term ( op:(\"<\" | \"<=\" | \">\" | \">=\") r:term )* -> fold_binary(l, op, r)\n" +
    "  term           = l:factor ( op:(\"+\" | \"-\") r:factor )* -> fold_binary(l, op, r)\n" +
    "  factor         = l:un ( op:(\"*\" | \"/\") r:un )* -> fold_binary(l, op, r)\n" +
    "  un             = op:(\"!\" | \"-\") operand:un -> Unary(op, operand) | primary\n" +
    "  primary        = NUMBER | STRING | \"true\" | \"false\" | @hand(ident)\n" +
    "                 | \"(\" e:expression \")\" @expect(\")\", \"expected ')'\") @recover(sync_to: \")\") -> Grouping(e)\n" +
    "}"
}

fn dsl_stmt(src: string) -> string {
    let gp = parse_grammar(ann_args_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    render_stmt_id(r.store, r.root)
}

fn hand_stmt(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    dsl_stmt(src) == hand_stmt(src)
}

// First annotation's arg count — reaches past the (arg-dropping) render.
fn first_ann_argc(store: NodeStore, id: StmtId) -> int {
    match store.stmts.get(id) {
        .Annotated(anns, _) -> if anns.length == 0 { -1 } else { anns[0].arg_ids!.length }
        _ -> -2
    }
}

// The first annotation's FIRST arg rendered as an expression — proves the arg
// expressions were actually built (not just counted), past the render.
fn first_ann_first_arg(store: NodeStore, id: StmtId) -> string {
    match store.stmts.get(id) {
        .Annotated(anns, _) -> {
            if anns.length == 0 { return "<no ann>" }
            let ids = anns[0].arg_ids!
            if ids.length == 0 { return "<no args>" }
            render_expr_id(store, ids[0])
        }
        _ -> "<not annotated>"
    }
}

fn dsl_argc(src: string) -> int {
    let gp = parse_grammar(ann_args_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return -3 }
    first_ann_argc(r.store, r.root)
}
fn hand_argc(src: string) -> int {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> first_ann_argc(p.store, id)
        .Err(_) -> -3
    }
}
fn dsl_arg0(src: string) -> string {
    let gp = parse_grammar(ann_args_grammar_src())
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    first_ann_first_arg(r.store, r.root)
}
fn hand_arg0(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_declaration() {
        .Ok(id) -> first_ann_first_arg(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

spec "grammar-DSL declaration family: @name(args) == hand-written parser (ps3t.6.5.7)" {
    given "annotations WITH args parse + wrap (render drops args, so these check name/inner)" {
        then "single-arg, multi-arg, number-arg, over-type, and bare-via-args-grammar agree" {
            // (fn names avoid reserved words like `bare` — the DSL's demo lexer
            // doesn't know the hand lexer's keyword table; that's the 6.5.8
            // real-lexer concern, not a parser-equivalence gap.)
            agree("@derive(walker) fn f() { }") &&
            agree("@config(a, b) fn h() { }") &&
            agree("@version(2) fn g() -> int { return 1 }") &&
            agree("@derive(marshal) type P = { x: int }") &&
            agree("@inline fn myfunc() { }")
        }
    }
    given "the arg COUNT matches PAST the render" {
        then "0 / 1 / 2 args agree on both DSL and hand" {
            dsl_argc("@inline fn myfunc() { }") == 0 &&
            hand_argc("@inline fn myfunc() { }") == 0 &&
            dsl_argc("@derive(walker) fn f() { }") == 1 &&
            hand_argc("@derive(walker) fn f() { }") == 1 &&
            dsl_argc("@config(a, b) fn h() { }") == 2 &&
            hand_argc("@config(a, b) fn h() { }") == 2
        }
    }
    given "the arg EXPRESSIONS match PAST the render (really built, not just counted)" {
        then "the first arg renders identically on DSL and hand" {
            dsl_arg0("@derive(walker) fn f() { }") == "walker" &&
            hand_arg0("@derive(walker) fn f() { }") == "walker" &&
            dsl_arg0("@version(2) fn g() -> int { return 1 }") == hand_arg0("@version(2) fn g() -> int { return 1 }") &&
            dsl_arg0("@config(a, b) fn h() { }") == hand_arg0("@config(a, b) fn h() { }")
        }
    }
    given "the DSL trees are the expected shapes (sanity: Annotated, args rendered faithfully)" {
        then "canonical render + arg count" {
            dsl_stmt("@derive(walker) fn f() { }") == "(@annotated @derive(walker)  (fn f () -> void ))" &&
            dsl_argc("@config(a, b) fn h() { }") == 2
        }
    }
}
