// ps3t.6.5.11 (precursor) — the COMPOSED whole-program grammar. The rule
// families (expression 6.5.1/2, statement 6.5.3/4, pattern 6.5.5, type 6.5.6,
// declaration 6.5.7) were each proven byte-equivalent to the hand parser in
// ISOLATION, each test inlining a simplified copy of the others. This assembles
// them into ONE canonical grammar with a `program = ( declaration )*` start and
// proves the COMPOSITION parses whole programs equivalently — the precursor to
// dogfooding the grammar into compiler src/ (6.5.11) and the swap-in (6.5.12).
//
// The whole-program oracle: the DSL start rule folds the top-level declarations
// into a Stmt.Block (the 6.5.3 Block build) whose children we render via
// render_stmt_ids; the hand parser's parse_program_source yields ids: the two
// rendered statement lists must match. The gnarly-5% forms compose via @hand
// (return newline-sensitivity, let-else, @pkg::T types, quote expressions with
// the ~ splice-vs-bitnot overload) exactly as in their own slices — the
// composition doesn't re-express them, it reuses the escape hatch. The `use`
// path also accepts the real dotted import form (`@std.core.{…}`).
use @std.avrac.features.grammar.{parse_grammar, run_grammar_stmt}
use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{render_stmt_ids, Stmt}

// The unified Avra grammar (the subset the families cover). One canonical
// version of each shared rule (type_expr / statement / the expression
// precedence chain / param), all declaration forms, `program` on top.
fn avra_grammar_src() -> string {
    "grammar Avra {\n" +
    "  program     = ( d:declaration )* -> Block(d)\n" +
    // Declarations — fn/type/enum/trait/impl/use/mod. Gnarly forms via @hand.
    "  declaration = fn_decl | type_decl | enum_decl | trait_decl | impl_decl | use_decl | mod_decl\n" +
    "  fn_decl     = \"fn\" name:IDENT \"(\" ( params:param ( \",\" params:param )* )? \")\" ( \"->\" ret:type_expr )? \"{\" ( body:statement )* \"}\" -> MkFnDecl(name, params, ret, body)\n" +
    "  type_decl   = \"type\" tname:IDENT \"=\" \"{\" ( fields:field \",\"? )* \"}\" -> MkTypeDecl(tname, fields)\n" +
    "  enum_decl   = \"enum\" ename:IDENT \"{\" ( vars:variant \",\"? )* \"}\" -> MkEnumDecl(ename, vars)\n" +
    "  trait_decl  = \"trait\" trname:IDENT \"{\" ( tmembers:trait_member )* \"}\" -> MkTraitDecl(trname, tmembers)\n" +
    "  impl_decl   = \"impl\" itn:IDENT ( \"for\" ifortn:IDENT )? \"{\" ( imethods:impl_method )* \"}\" -> MkImpl(itn, ifortn, imethods)\n" +
    // The path allows a trailing `.` before `{` (the real import form
    // `@std.core.{…}`); the segment IDENT after each `.` is optional so the
    // greedy `*` absorbs that trailing dot without erroring on `{`. The hand
    // parser renders `@std.core.{…}` and `@std.core {…}` identically.
    "  use_decl    = \"use\" ( uat:\"@\" )? useg:IDENT ( \".\" ( useg:IDENT )? )* \"{\" ( unames:IDENT \",\"? )* \"}\" -> MkUse(uat, useg, unames)\n" +
    "  mod_decl    = \"mod\" mdname:IDENT -> MkModule(mdname)\n" +
    // Declaration sub-structure.
    "  field       = fname:IDENT \":\" ftype:type_expr -> MkField(fname, ftype)\n" +
    "  variant     = vname:IDENT ( \"(\" ( vfields:field \",\"? )* \")\" )? -> MkEVariant(vname, vfields)\n" +
    "  param       = pname:IDENT ( \":\" pt:type_expr )? -> MkParam(pname, pt)\n" +
    "  trait_member  = assoc_member | method_member\n" +
    "  assoc_member  = \"type\" atname:IDENT -> MkAssocType(atname)\n" +
    "  method_member = \"fn\" tmname:IDENT \"(\" ( tmparams:param ( \",\" tmparams:param )* )? \")\" ( \"->\" tmret:type_expr )? ( tmlb:\"{\" ( tmbody:statement )* \"}\" )? -> MkTraitMethod(tmname, tmparams, tmret, tmlb, tmbody)\n" +
    "  impl_method   = \"fn\" imname:IDENT \"(\" ( imparams:param ( \",\" imparams:param )* )? \")\" ( \"->\" imret:type_expr )? \"{\" ( imbody:statement )* \"}\" -> MkMethod(imname, imparams, imret, imbody)\n" +
    // Statements — control flow (6.5.3) + the simple forms (6.5.2) + return via
    // @hand (newline-sensitive, 6.5.10) + let via @hand (let-else desugar).
    "  statement   = @hand(return_stmt) | @hand(let_stmt) | block_stmt | while_stmt | if_stmt | for_stmt | break_stmt | continue_stmt | expr_stmt\n" +
    // Control-flow bodies reference `block_stmt` (a single Block SNode) — the
    // If/While/ForLoop builds take a scalar statement body, not a raw list.
    "  block_stmt  = \"{\" ( bs:statement )* \"}\" -> Block(bs)\n" +
    "  while_stmt  = \"while\" wc:expression wb:block_stmt -> While(wc, wb)\n" +
    "  if_stmt     = \"if\" ic:expression it:block_stmt ( \"else\" ie:else_target )? -> If(ic, it, ie)\n" +
    "  else_target = if_stmt | block_stmt\n" +
    "  for_stmt    = \"for\" fv:IDENT \"in\" flo:expression ( \"..\" fhi:expression )? fb:block_stmt -> ForLoop(fv, flo, fhi, fb)\n" +
    "  break_stmt  = \"break\" -> Break()\n" +
    "  continue_stmt = \"continue\" -> Continue()\n" +
    "  expr_stmt   = es:expression -> ExprStmt(es)\n" +
    // Types (6.5.6) — with the @pkg::T qualified atom (6.5.10) as the first atom.
    "  type_expr   = l:type_atom ( \"|\" r:type_atom )* -> TyUnion(l, r)\n" +
    "  type_atom   = @hand(qualified_type) | fn_type | dyn_type | list_type | paren_type | named_type\n" +
    "  fn_type     = \"fn\" ( lp:\"(\" ( p:type_expr ( \",\" p:type_expr )* )? \")\" )? ( \"->\" tr:type_expr )? -> MkFn(lp, p, tr)\n" +
    "  dyn_type    = \"dyn\" dt:IDENT -> TyDyn(dt)\n" +
    "  list_type   = \"[\" el:type_expr \"]\" -> TyList(el)\n" +
    "  paren_type  = \"(\" ( pt2:type_expr ( \",\" pt2:type_expr )* )? \")\" -> TyParen(pt2)\n" +
    "  named_type  = tn:IDENT ( \"<\" a:type_expr ( \",\" a:type_expr )* \">\" )? ( opt:\"?\" )? -> MkNamed(tn, a, opt)\n" +
    // Expressions — the full precedence chain (6.5.1/2), ident via @hand.
    "  expression  = equality\n" +
    "  equality    = l:comparison ( op:(\"!=\" | \"==\") r:comparison )* -> fold_binary(l, op, r)\n" +
    "  comparison  = l:term ( op:(\"<\" | \"<=\" | \">\" | \">=\") r:term )* -> fold_binary(l, op, r)\n" +
    "  term        = l:factor ( op:(\"+\" | \"-\") r:factor )* -> fold_binary(l, op, r)\n" +
    "  factor      = l:un ( op:(\"*\" | \"/\") r:un )* -> fold_binary(l, op, r)\n" +
    // `~` outside a quote is bitwise-NOT (pure grammar); inside a quote body it
    // is Splice — handled by @hand(quote_expr) below (the 6.5.10 ~ slice).
    "  un          = op:(\"!\" | \"-\" | \"~\") operand:un -> Unary(op, operand) | postfix\n" +
    "  postfix     = base:primary ( s:suffix )* -> fold_postfix(base, s)\n" +
    "  suffix      = \".\" sn:IDENT -> field_suffix(sn)\n" +
    "              | \"(\" ( ca:expression ( \",\" ca:expression )* )? \")\" -> call_suffix(ca)\n" +
    "  primary     = NUMBER | STRING | \"true\" | \"false\" | @hand(quote_expr) | @hand(ident)\n" +
    "}"
}

// The DSL start rule folds top-level declarations into a Stmt.Block; render its
// children as the top-level statement list.
fn dsl_program(src: string) -> string {
    let gp = parse_grammar(avra_grammar_src())
    if gp.error != "" { return "<grammar error: ${gp.error}>" }
    let r = run_grammar_stmt(gp.grammar, src)
    if r.had_error { return "<dsl parse error>" }
    match r.store.stmts.get(r.root) {
        .Block(ids) -> render_stmt_ids(r.store, ids)
        _ -> "<not a program block>"
    }
}

fn hand_program(src: string) -> string {
    let p = parse_program_source(src)
    if p.had_error != 0 { return "<hand parse error>" }
    if p.ids == null { return "<hand no ids>" }
    render_stmt_ids(p.store, p.ids!)
}

fn agree(src: string) -> bool { dsl_program(src) == hand_program(src) }

spec "grammar-DSL composed whole-program == hand parser (ps3t.6.5.11 precursor)" {
    given "single declarations of each kind" {
        then "fn / type / enum / mod agree at the program level" {
            agree("fn f() {\n}\n") &&
            agree("type Point = { x: int, y: int }\n") &&
            agree("enum Color { Red, Green, Blue }\n") &&
            agree("mod inner\n")
        }
    }
    given "a program with MULTIPLE top-level declarations" {
        then "the declaration sequence renders identically" {
            agree("fn a() {\n}\nfn b() {\n}\n") &&
            agree("type T = { v: int }\nenum E { A, B }\nfn go() {\n}\n")
        }
    }
    given "fn bodies with composed statements (control-flow + exprs + @hand)" {
        then "return/if/while/for/let bodies agree across the families" {
            agree("fn f() {\n    return 1 + 2\n}\n") &&
            agree("fn f() {\n    if a {\n        return\n    }\n}\n") &&
            agree("fn f() {\n    while a {\n        b()\n    }\n}\n") &&
            agree("fn f() {\n    for i in a {\n        i\n    }\n}\n")
        }
    }
    given "signatures composing the type family (incl. @pkg::T)" {
        then "param and return types agree, including qualified types" {
            agree("fn f(x: int, y: List<int>) -> bool {\n}\n") &&
            agree("fn f(a: @std::core::Foo) -> @pkg::Bar {\n}\n")
        }
    }
    given "trait / impl / use declarations compose" {
        then "the remaining declaration forms agree" {
            agree("trait Show {\n    fn show() -> string\n}\n") &&
            agree("impl Show for Point {\n    fn show() -> string {\n        return x\n    }\n}\n") &&
            agree("use @std.core { List, Map }\n") &&
            // the real dotted import form (`@std.core.{…}`) + a deep path.
            agree("use @std.core.{ List, Map }\n") &&
            agree("use @std.avrac.features.grammar.{ parse_grammar, run_grammar_stmt }\n")
        }
    }
    given "quote expressions + the ~ prefix compose (the 6.5.10 ~ slice)" {
        then "bitwise-NOT, bare quote, and splice-in-quote agree at the program level" {
            // `~x` outside a quote → un's `~` → Unary(BitNot) (pure grammar).
            agree("fn f() {\n    ~x\n}\n") &&
            agree("fn f() {\n    return ~y\n}\n") &&
            // a bare quote expression-statement → @hand(quote_expr) → parse_quote.
            agree("fn f() {\n    quote {\n        x\n    }\n}\n") &&
            // splice inside a quote (quote_depth-gated) + bitnot outside, together.
            agree("fn f() {\n    let q = quote {\n        ~x + 1\n    }\n    return ~q\n}\n")
        }
    }
    given "multi-statement fn bodies (the statement list composes)" {
        then "several statements in sequence agree" {
            agree("fn f() {\n    a()\n    b()\n    return c\n}\n") &&
            agree("fn f() {\n    let x = 1\n    let y = x + 2\n    return y\n}\n")
        }
    }
    given "NESTED control flow (blocks compose recursively across families)" {
        then "if-in-while, while-in-for, if/else chains agree" {
            agree("fn f() {\n    while a {\n        if b {\n            break\n        }\n    }\n}\n") &&
            agree("fn f() {\n    for i in xs {\n        while g {\n            continue\n        }\n    }\n}\n") &&
            agree("fn f() {\n    if a {\n        return 1\n    } else {\n        return 2\n    }\n}\n") &&
            agree("fn f() {\n    if a {\n        x()\n    } else if b {\n        y()\n    }\n}\n")
        }
    }
    given "let bindings inside bodies via @hand (the let-else desugar composes)" {
        then "let / let mut / let-else in a fn body agree" {
            agree("fn f() {\n    let a = 1\n    let mut b = 2\n    return a\n}\n") &&
            agree("fn f() {\n    let v = x else {\n        return\n    }\n    return v\n}\n")
        }
    }
    given "richer signatures + a whole small program" {
        then "multi-param / union / dyn types and a mixed program agree" {
            agree("fn f(a: int, b: string, c: bool) -> int {\n    return a\n}\n") &&
            agree("fn f(x: A | B) -> dyn Show {\n}\n") &&
            agree("type Pair = { a: int, b: int }\nenum Opt { Some(v: int), None }\nfn use_it(p: Pair) -> int {\n    return p\n}\n")
        }
    }
}
