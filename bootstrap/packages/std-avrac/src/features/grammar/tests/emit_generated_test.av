// ps3t.6.5.11 — emit.av RENDERS the GENERATED STATIC PARSER: real, compilable
// `fn parse_<rule>(st: PState) -> CapVal` source (not the retired pseudo-syntax
// `p.match(...)` / `collect x +=` / `p.node(...)`). These specs pin, per rule
// family, that the emitted text is the CapVal/PState static form.
//
// ps3t.6.7 Step C: avra_expr_grammar now owns only the DECLARATIVE operator
// ladder (logic_or → factor); the PROCEDURAL leaf (unary/postfix/primary) is a
// single `@hand(hand_unary)` delegation — the hand postfix chain is newline-
// sensitive + mode-stateful, so it is NOT expressible byte-identically in the
// stateless token-grammar. The emitter lowers that leaf to a guarded
// `run_hand_expr("hand_unary", st)` call, mirrored here.
//
// This is the fast in-suite regression guard on the emitter; the airtight
// "generated fns compile + pass the differential test" gate is the diagnose
// mode (a full nested compile+run, too heavy for every `bs2 test`).

use @std.avrac.features.grammar.{avra_expr_dispatch_grammar, emit_parser_source, emit_rule_fn, Grammar, Rule, GNode}

// The canonical §2 expression grammar is the SOURCE-OF-TRUTH `grammar { }`
// block dogfooded into compiler src/ (avra_grammar.av, ps3t.6.5.11); the
// emitter lowers each of its rules to a static parse fn.
fn emit_all() -> string {
    emit_parser_source(avra_expr_dispatch_grammar())
}

fn rule_named(g: Grammar, name: string) -> Rule {
    for r in g.rules {
        if r.name == name { return r }
    }
    Rule { name: "", body: GNode.Alt([]) }
}

spec "grammar emitter: renders the GENERATED STATIC PARSER (CapVal/PState) per rule family" {
    then "every rule lowers to `fn parse_<name>(st: PState) -> CapVal`" {
        let src = emit_all()
        src.contains("fn parse_expression(st: PState) -> CapVal") &&
        src.contains("fn parse_assignment(st: PState) -> CapVal") &&
        src.contains("fn parse_pipe(st: PState) -> CapVal") &&
        src.contains("fn parse_null_coalesce(st: PState) -> CapVal") &&
        src.contains("fn parse_logic_or(st: PState) -> CapVal") &&
        src.contains("fn parse_logic_and(st: PState) -> CapVal") &&
        src.contains("fn parse_equality(st: PState) -> CapVal") &&
        src.contains("fn parse_eq_tail(st: PState) -> CapVal") &&
        src.contains("fn parse_in_rhs(st: PState) -> CapVal") &&
        src.contains("fn parse_comparison(st: PState) -> CapVal") &&
        src.contains("fn parse_term(st: PState) -> CapVal") &&
        src.contains("fn parse_factor(st: PState) -> CapVal") &&
        src.contains("fn parse_unary(st: PState) -> CapVal")
    }

    then "the retired pseudo-syntax is GONE (real primitives only)" {
        let src = emit_all()
        !src.contains("p.match(") && !src.contains("p.check(") &&
        !src.contains("p.node(") && !src.contains("collect ") &&
        !src.contains("(p: Parser)") && !src.contains("p.expect(") &&
        !src.contains("p.recover_to(")
    }

    then "a pass-through rule is a bare delegating call (`expression = assignment`)" {
        emit_all().contains("fn parse_expression(st: PState) -> CapVal {\n    parse_assignment(st)\n}")
    }

    then "the equality stratum retargets is/in/==-chain via rebind_eq_expr" {
        // `equality = base:bitor ( tail:eq_tail )? -> rebind_eq(base, tail)` with
        // the eq_tail partial (is / in-list / in-range / ==-chain) retargeted.
        let src = emit_all()
        src.contains("CapVal.Node(rebind_eq_expr(st, sp_start, base, tail))") &&
        src.contains("CapVal.Node(mk_is_expr(st, v))") &&
        src.contains("mk_eqchain_expr(st, CapVal.Toks(op_list), CapVal.Nodes(r_list))") &&
        src.contains("mk_inrange_expr(st, s, e)")
    }

    then "assignment guards `=` (opt-scalar) then retargets via mk_assign_expr" {
        // `assignment = l:null_coalesce ( "=" r:assignment )? -> mk_assign(l, r)`
        // ps3t.6.7 perf: the `=` guard dispatches on the Tk enum (tk_guard), not text.
        let src = emit_all()
        src.contains("let l = parse_pipe(st)") &&
        src.contains("if st.cur().tk == Tk.Equal {") &&
        src.contains("r = parse_assignment(st)") &&
        src.contains("CapVal.Node(mk_assign_expr(st, sp_start, l, r))")
    }

    then "the pipe stratum folds `|>` with native logic_or operands under it-sugar mode" {
        // `pipe = l:null_coalesce ( "|>" r:pipe_arg )* -> fold_pipe(l, r)` with
        // `pipe_arg = @on(allow_it_sugar) logic_or`. The `|>` guard is Tk-dispatched.
        let src = emit_all()
        src.contains("while st.cur().tk == Tk.PipeGt {") &&
        src.contains("parse_logic_or(st)") &&
        src.contains("modes_with_flag_on(st.modes, \"allow_it_sugar\")") &&
        !src.contains("run_hand_expr(\"pipe_rhs\", st)") &&
        src.contains("CapVal.Node(fold_pipe_expr(st, sp_start, l, CapVal.Nodes(r_list)))")
    }

    then "the channel keyword primary is generated, not a hand delegate" {
        let src = emit_all()
        src.contains("fn parse_channel_expr(st: PState) -> CapVal {") &&
        src.contains("let base = parse_channel_expr(st)") &&
        src.contains("mk_channel(st, sp_start, elem, cap)") &&
        !src.contains("run_hand_expr(\"channel_expr\", st)")
    }

    then "subjectless when arms and their default are generated, not hand delegated" {
        let src = emit_all()
        src.contains("fn parse_when_expr(st: PState) -> CapVal {") &&
        src.contains("fn parse_when_arm(st: PState) -> CapVal {") &&
        src.contains("mk_when_arm(st, cond, body)") &&
        src.contains("mk_when_default(st, body)") &&
        src.contains("mk_when(st, sp_start, CapVal.WArms(a_list))") &&
        !src.contains("run_hand_expr(\"when_expr\", st)")
    }

    then "lambda expression and block bodies recurse entirely through generated rules" {
        let src = emit_all()
        src.contains("fn parse_lambda_body(st: PState) -> CapVal {") &&
        src.contains("return parse_block_expr(st)") &&
        src.contains("parse_expression(st)") &&
        !src.contains("run_hand_expr(\"lambda_body\", st)") &&
        !src.contains("run_hand_expr(\"lambda_block_body\", st)")
    }

    then "expression blocks power generated spawn and isolated primaries" {
        let src = emit_all()
        src.contains("fn parse_block_expr(st: PState) -> CapVal {") &&
        src.contains("mut stmts_list: List<StmtId> = []") &&
        src.contains("let __cv = parse_declaration(st)") &&
        src.contains("mk_expr_block(st, sp_start, CapVal.SNodes(stmts_list))") &&
        src.contains("mk_spawn(st, sp_start, body)") &&
        src.contains("mk_isolated(st, sp_start, body)") &&
        !src.contains("run_hand_expr(\"spawn_expr\", st)") &&
        !src.contains("run_hand_expr(\"isolated_expr\", st)")
    }

    then "the null-coalesce stratum folds `??` via fold_nullish_expr" {
        let src = emit_all()
        src.contains("while st.cur().tk == Tk.QuestionQuestion {") &&
        src.contains("CapVal.Node(fold_nullish_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))")
    }

    then "the uniform binary ladder collapses to ONE Pratt loop (Step G slice 1)" {
        // bitor→bitxor→bitand→comparison→shift→term→factor are no longer 7
        // descending fold fns — each is a one-line wrapper into the shared
        // precedence-climbing loop parse_binary_pratt_g at its binding power
        // (bitor=10 … factor=22, matching the hand parse_binary_pratt), so the
        // generated parser does one loop frame per leaf instead of seven.
        let src = emit_all()
        src.contains("fn parse_bitor(st: PState) -> CapVal { parse_binary_pratt_g(st, 10) }") &&
        src.contains("fn parse_term(st: PState) -> CapVal { parse_binary_pratt_g(st, 20) }") &&
        src.contains("fn parse_factor(st: PState) -> CapVal { parse_binary_pratt_g(st, 22) }") &&
        // the old per-level fold loop is gone (no accumulate-then-fold_binary_expr)
        !src.contains("rs.push(capval_to_expr(st, parse_factor(st)))")
    }

    then "the logical strata use fold_logical_expr and accept keyword spellings" {
        // ps3t.6.7 Step C: `||`/`or` and `&&`/`and` both spell the same LogicOp
        // (logicop_of maps both) — the guard unions the operator's Tk (tk_guard,
        // ps3t.6.7 perf) with the keyword text (keywords stay on the text compare).
        let src = emit_all()
        src.contains("while st.cur().tk == Tk.PipePipe || st.cur().text == \"or\" {") &&
        src.contains("while st.cur().tk == Tk.AmpAmp || st.cur().text == \"and\" {") &&
        src.contains("CapVal.Node(fold_logical_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))")
    }

    then "the Pratt loop climbs precedence ExprId-internal (leaf via parse_unary)" {
        // parse_binary_pratt_g_id returns ExprId directly: the leaf is the grammar
        // `unary` rule parse_unary(st) (Phase 3a: it OWNS the !/- prefix ops and
        // delegates the rest to @hand(hand_unary)), unboxed via capval_to_expr — an
        // IR-NEUTRAL CapVal round-trip (diff-test stays byte-identical; the box is
        // optimised away). The recursion is ExprId→ExprId, left-assoc via rbp =
        // lbp+1, one Expr.Binary per operator via mk_binary; binary_lbp_g maps each
        // operator's Tk to its level (factor ops *,/,% → 22; ps3t.6.7 perf: the
        // precedence table is Tk-dispatched too). The outer CapVal box lives at the
        // thin boundary wrapper parse_binary_pratt_g.
        let src = emit_all()
        src.contains("fn parse_binary_pratt_g_id(st: PState, min_bp: int) -> ExprId {") &&
        src.contains("let sp_start = st.cur().pos") &&
        src.contains("mut lhs = capval_to_expr(st, parse_unary(st))") &&
        src.contains("let lbp = binary_lbp_g(st.cur())") &&
        src.contains("let rhs = parse_binary_pratt_g_id(st, lbp + 1)") &&
        src.contains("lhs = mk_binary(st, sp_start, lhs, tx, rhs)") &&
        src.contains("if t.tk == Tk.Star || t.tk == Tk.Slash || t.tk == Tk.Percent { return 22 }") &&
        src.contains("fn parse_binary_pratt_g(st: PState, min_bp: int) -> CapVal { CapVal.Node(parse_binary_pratt_g_id(st, min_bp)) }")
    }

    then "the procedural leaf `unary` owns ! - not ~ + NUMBER/STRING/BOOL/null/none/.Variant literals + the postfix chain + `with`, delegating other leaves to @hand" {
        // Phase 3a (Option B): the `unary` rule OWNS the `!` `-` `not` prefix ops
        // directly (unary_expr build). Phase 3a-4 gives the grammar the POSTFIX CHAIN
        // + the `with` postfix: the non-prefix branch is
        // `base:@hand(primary_base) ( p:postfix_suffix )* ( s:with_suffix )*
        //  -> fold_postfix_with(base, p, s)`. primary_base (→ parse_primary_base) is the
        // splice/prefix + parse_primary base WITHOUT the postfix loop; the grammar owns
        // the postfix loop as `( postfix_suffix )*` — each step runs ONE postfix_step over
        // the base threaded on PState, guarded by the postfix FIRST-set (a SUPERSET of
        // postfix_step's precise guard) with a no-progress break (postfix_step can consume
        // nothing). fold_postfix_with_expr takes the final postfix node then folds the
        // `with` suffixes over it, stamping the hand `[base-start, next-token)` span. `not`
        // renders as a `.text` compare (keyword spelling). `~` bitnot is grammar-owned
        // (Phase 3a-5) via a SEPARATE @when(at_quote_top) branch — the guard is
        // `st.modes.quote_depth == 0 && Tk.Tilde` — so at quote_depth>0 (where `~` is the
        // quote SPLICE) it falls through to @hand(primary_base). This is the FIRST @when
        // use in the production expression grammar (grammar-native mode gating, #954).
        let src = emit_all()
        src.contains("fn parse_unary(st: PState) -> CapVal {") &&
        src.contains("if st.cur().tk == Tk.Bang || st.cur().tk == Tk.Minus || st.cur().text == \"not\" {") &&
        src.contains("if st.modes.quote_depth == 0 && (st.cur().tk == Tk.Tilde) {") &&
        src.contains("CapVal.Node(unary_expr(st, op, operand))") &&
        // Phase 3a-7: NUMBER + STRING (slice 1) + BOOL (slice 2) + null/none (slice 3)
        // literal primaries are grammar-owned via branches BEFORE the @hand(primary_base)
        // tail — each a `b:<lit> ( postfix_suffix )* ( with_suffix )* -> fold_postfix_with(b,p,s)`.
        // The token base is captured (`let b = CapVal.Tok(st.advance())`) then the
        // postfix loop is SEEDED off it (`st.seed_postfix(capval_to_expr(st, b), sp_start)`)
        // so the grammar-built base threads into postfix_step exactly like the @hand base.
        // t-47hc.4.1.9: named-terminal FIRST guards lower to `Tk` enum compares
        // (NUMBER/BOOL are many-to-one → parenthesised disjunctions).
        src.contains("if (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) {") &&
        src.contains("if st.cur().tk == Tk.String {") &&
        src.contains("if (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) {") &&
        // null/none are keyword tokens (no distinct grammar kind), matched by text.
        src.contains("if st.cur().text == \"null\" || st.cur().text == \"none\" {") &&
        src.contains("let b = CapVal.Tok(st.advance())") &&
        src.contains("st.seed_postfix(capval_to_expr(st, b), sp_start)") &&
        src.contains("CapVal.Node(fold_postfix_with_expr(st, sp_start, b, CapVal.Nodes(p_list), CapVal.Nodes(s_list)))") &&
        // Phase 3a-7 slice 4: the contextual enum ctor `.Variant`/`.Variant(args)` is a
        // grammar-owned RULE (variant_ctor) captured as the postfix-loop base — a `Tk.Dot`-
        // guarded branch before the @hand tail. The rule fn parses `.`, the variant IDENT,
        // and an optional args list, building Expr.EnumCtor via mk_enum_ctor_expr.
        src.contains("fn parse_variant_ctor(st: PState) -> CapVal {") &&
        src.contains("let base = parse_variant_ctor(st)") &&
        src.contains("CapVal.Node(mk_enum_ctor_expr(st, sp_start, v, CapVal.Nodes(a_list)))") &&
        // The non-prefix branch is the unguarded fallthrough tail (leading @hand
        // primary_base owns error recovery, so NO FIRST-guard on the branch). The
        // postfix loop's FIRST-set is Tk-dispatched with a no-progress break.
        src.contains("let base = CapVal.Node(run_hand_expr(\"primary_base\", st))") &&
        // t-47hc.33: the loop guard is the UNION of `postfix_suffix`'s branch FIRSTs, so
        // it GROWS as forms go native — the `?` form contributes its full entry guard
        // (mode + token + same-line) and `catch` its keyword, both ordered before the
        // `@hand` tail's raw postfix-op set. It stays a SUPERSET of the hand entry guard,
        // which is what the loop needs: the per-branch guards inside parse_postfix_suffix
        // do the precise work, and the no-progress break ends the chain. Asserted as the
        // native prefix plus the unchanged hand tail rather than one long literal, so a
        // later form adding a disjunct does not require rewriting the whole string.
        // CAVEAT, learned the hard way: the "append-safe" note above only holds for a
        // form added at the END. The union is emitted in BRANCH ORDER, so a form added as
        // the FIRST alternative changes the LEADING disjunct — `!` (t-47hc.33, the last
        // form to flip) did exactly that, moving the head from Tk.Question to Tk.Bang.
        // `!` and `?` carry the same mode+same-line guard shape and their FIRST tokens are
        // disjoint, so the order between them is free; the head is pinned here only to
        // keep the assertion specific rather than to fix a required order.
        src.contains("while st.modes.allow_dot_postfix != 0 && ((st.cur().tk == Tk.Bang) && (st.pos == 0 || st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line == st.store.lines.to_linecol(st.cur().pos).line))") &&
        src.contains("st.cur().tk == Tk.Dot || st.cur().tk == Tk.LeftParen || st.cur().tk == Tk.LeftBracket || st.cur().tk == Tk.Bang || st.cur().tk == Tk.Question || st.cur().tk == Tk.QuestionDot || st.cur().tk == Tk.Less || st.cur().text == \"catch\" {") &&
        // Both stateful hand steps are SHARED delegate rules (`postfix_suffix = @hand(…)`,
        // `with_suffix = @hand(…)`), so each of the 19 FIRST-disjoint bases CALLS the one
        // generated fn instead of re-inlining run_hand_expr.
        src.contains("p_list.push(capval_to_expr(st, parse_postfix_suffix(st)))") &&
        src.contains("fn parse_postfix_suffix(st: PState) -> CapVal {") &&
        src.contains("fn parse_with_suffix(st: PState) -> CapVal {") &&
        // …and sharing must NOT cost the no-progress break where it is LOAD-BEARING. The
        // two loops differ, and the difference is exactly `rule_is_bare_hand`:
        //
        //   postfix_suffix — still a BARE @hand delegate. The hand step may consume
        //     NOTHING while the loop's FIRST guard stays true (it guards `Tk.Less`, so
        //     `a < b` re-enters forever once the generic-call step decides it is a
        //     comparison). The guard is REQUIRED, and survives the named-rule indirection.
        //
        //   with_suffix — GRAMMAR-NATIVE since t-47hc.17, so NOT transparent: it does its
        //     own consuming, unconditionally advancing past `with` on entry. Progress is
        //     therefore structural and no guard is emitted. That asymmetry is the point of
        //     restricting transparency to `name = @hand(f)` — pin BOTH halves so neither a
        //     dropped guard nor a spurious one slips through.
        src.contains("            let __rep_before = st.pos\n            p_list.push(capval_to_expr(st, parse_postfix_suffix(st)))\n            if st.pos == __rep_before { break }") &&
        src.contains("        while st.cur().text == \"with\" {\n            s_list.push(capval_to_expr(st, parse_with_suffix(st)))\n        }") &&
        // t-47hc.17: `with_suffix` is GRAMMAR-NATIVE now (hand parse_with_suffix deleted),
        // so its delegate rule must no longer route through run_hand_expr — it parses the
        // field list itself and folds it via mk_with_suffix. Assert the absence too, so a
        // regression back to the @hand leaf fails loudly here.
        !src.contains("run_hand_expr(\"with_suffix\"") &&
        src.contains("f_list.push(capval_to_finit(st, parse_field_init(st)))") &&
        src.contains("CapVal.Node(mk_with_suffix(st, sp_start, CapVal.FInits(f_list)))") &&
        // The two field-list diagnostics reproduce the hand exactly: the `{` message, and
        // `expected field name` on the closer — which covers BOTH a junk token and EOF,
        // because the hand's own `expected \`}\` after with fields` was unreachable.
        src.contains("st.report(\"expected `{` after `with`\")") &&
        src.contains("st.report(\"expected field name\")") &&
        src.contains("s_list.push(capval_to_expr(st, parse_with_suffix(st)))") &&
        src.contains("CapVal.Node(fold_postfix_with_expr(st, sp_start, base, CapVal.Nodes(p_list), CapVal.Nodes(s_list)))") &&
        // ORDERING: the literal branches MUST be emitted before the @hand(primary_base)
        // fallback, else the guarded branches would be unreachable (the fallback tail
        // matches anything). gen_expr_parser_regen pins the exact file, but assert the
        // order here too so a generator-order regression fails loudly at this layer.
        // Check the first (BOOL), and the last two guarded branches (null/none, then the
        // .Variant enum-ctor) all precede the tail.
        src.index_of("if (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) {") < src.index_of("run_hand_expr(\"primary_base\", st)") &&
        src.index_of("if st.cur().text == \"null\" || st.cur().text == \"none\" {") < src.index_of("run_hand_expr(\"primary_base\", st)") &&
        src.index_of("let base = parse_variant_ctor(st)") < src.index_of("run_hand_expr(\"primary_base\", st)")
    }

    then "the single-rule entry keeps grammar context (ref FIRST-sets resolve)" {
        // emit_rule_fn(g, term) needs the grammar to resolve factor's FIRST set
        // for its `while` guard — the operator group here (Tk-dispatched, ps3t.6.7 perf).
        let g = avra_expr_dispatch_grammar()
        let term = emit_rule_fn(g, rule_named(g, "term"))
        term.contains("while st.cur().tk == Tk.Plus || st.cur().tk == Tk.Minus {")
    }
}
