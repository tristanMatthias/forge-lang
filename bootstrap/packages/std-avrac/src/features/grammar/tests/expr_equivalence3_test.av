// SPLIT per t-kdyj.13's whale precedent (t-u602): as ONE file this
// differential's unit peaked 8773 MB under AVRA_RC_STRICT=1 (measured solo,
// quiet box) — past the solo-retry's runner-survival ceiling (~7871 MB), so
// its batch died as a MEMORY CEILING red on every rc-strict run while the
// blamed first-of-batch file used 75 MB. Each slice keeps the shared
// harness verbatim; coverage is the union of the three files.
// ps3t.6.7 / Step C — the grammar-DSL EXPRESSION family, grown toward selfhost
// fidelity. avra_expr_grammar has the full operator-precedence spine (logic_or ->
// ... -> unary -> postfix -> primary); this test proves it builds the same tree
// as the hand parser's parse_expression over the covered surface, and grows with
// the grammar. The mode primitives (interpolation @hand(template_expr), map/block
// @hand(brace_expr)) are wired into the primary here.
//
// Interpolated sources are built by concatenating a lone "$" with "{...}", so no
// interpolation syntax appears in this file (which would interpolate here).
use @std.avrac.features.grammar.{avra_expr_grammar, run_grammar_expr}
use @std.avrac.parse.{oracle_expr}
use @std.avrac.core.{render_expr_id}

fn dsl(src: string) -> string {
    let r = run_grammar_expr(avra_expr_grammar(), src)
    if r.had_error { return "<err>" }
    render_expr_id(r.store, r.root)
}

fn hand(src: string) -> string {
    oracle_expr(src) ?? "<err>"
}

fn agree(src: string) -> bool {
    let got = dsl(src)
    let want = hand(src)
    if got != want {
        println("expression grammar mismatch: ${src}")
        println("generated: ${got}")
        println("hand:      ${want}")
    }
    got == want
}

spec "ps3t.6.7/StepC: avra_expr_grammar == hand parse_expression (slice 3: operator strata — or/and, assign, is/in, chains, pipe)" {
    given "struct-update `with` (Phase 3a-3: grammar-owned fold_with over the leaf)" {
        then "single, multi-field, and chained struct updates agree" {
            agree("a with { x: 1 }") && agree("p with { x: 1, y: 2 }") &&
            agree("a with { x: 1 } with { y: 2 }")
        }
        then "`with` folds OVER the postfix-chain base (call / field), not under it" {
            agree("f(x) with { a: 1 }") && agree("a.b with { c: 2 }") &&
            agree("f(x) with { a: 1 } with { b: 2 }") && agree("a.b.c with { d: 3 }")
        }
    }
    // ── ps3t.6.7 Step C: the DSL-owned infix layers ABOVE the operator ladder.
    given "null-coalescing `??` (the null_coalesce stratum)" {
        then "single, chained, and mixed-with-ops null-coalesce agree" {
            dsl("a ?? b") != "<err>" &&
            agree("a ?? b") && agree("a ?? b ?? c") &&
            agree("a ?? b + c") && agree("f() ?? 0") && agree("a.b ?? c.d")
        }
    }
    given "keyword logical operators (`or` / `and`)" {
        then "or/and keywords fold to the same LogicOp as ||/&& and agree" {
            agree("a or b") && agree("a and b") &&
            agree("a and b or c") && agree("a or b and c") &&
            agree("a and b == c") && agree("not a or b")
        }
    }
    given "assignment `=` (retargeting Assign / FieldAssign, right-assoc)" {
        then "ident and field-access targets, chained, and rhs expressions agree" {
            dsl("x = 1") != "<err>" &&
            agree("x = 1") && agree("a.b = 1") && agree("a.b.c = 1") &&
            agree("x = y = 1") && agree("x = 1 + 2") && agree("obj.field = f(1)")
        }
    }
    given "the `is` type-check (`expr is .Variant`)" {
        then "is-checks on idents, fields, and calls agree" {
            dsl("a is .Some") != "<err>" &&
            agree("a is .Some") && agree("x.y is .None") && agree("f() is .Ok") &&
            agree("a + b is .Big")
        }
    }
    given "the `in` membership (list and range, via missing-node rebind)" {
        then "list-membership and range-membership desugars agree" {
            dsl("x in [1, 2, 3]") != "<err>" &&
            agree("x in [1, 2, 3]") && agree("a in [b, c]") && agree("x in []") &&
            agree("x in 1..10") && agree("i in a..b") && agree("n + 1 in [0, 1]")
        }
    }
    given "the `==`/`!=` chain still folds after the equality restructure" {
        then "equality chains and comparison-below-equality agree" {
            agree("a == b") && agree("a != b") && agree("a == b == c") &&
            agree("a < b == c") && agree("1 + 2 == 3") && agree("a == b != c")
        }
    }
    given "the pipe `|>` (desugar to Call, prepend / placeholder / it-sugar)" {
        then "bare, arg-prepend, placeholder, chained, and it-sugar pipes agree" {
            dsl("a |> f") != "<err>" &&
            agree("a |> f") && agree("a |> f(b)") && agree("a |> f(_, b)") &&
            agree("a |> f |> g") && agree("xs |> filter(it > 2)") &&
            agree("x |> g(1) |> h")
        }
    }
}
