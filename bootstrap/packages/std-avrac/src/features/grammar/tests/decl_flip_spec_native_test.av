// WHY: pins the routing of the SPEC-TEST blocks (t-47hc Phase 4: `spec`, with
// its `given` / `then` inner keywords) out of `@hand(decl_hand)`. Same property
// set as the binding / destructure / select-parallel increments (the #1028
// dead-code and #1054/#1059 recovery lessons): the rules must be EMITTED,
// dispatch BEFORE the hand gate, stay SPECULATIVE, own the valid forms on all
// four parser paths, and leave the acceptance frontier exactly where the hand
// had it — including the missing-name diagnostics the corpus work added to the
// hand (spec_test/tests/spec_block_missing_name_test.av pins that fix itself).

use @std.avrac.features.grammar.{avra_decl_dispatch_grammar, emit_parser_source_ex}
use @std.avrac.core.{avra_shell_exec_status, avra_selfhost_write_file, avra_selfhost_read_file}

fn decl_src() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}

fn check_out(name: string, env: string, src: string) -> string {
    let fixture = "build/_decl_spec_${name}.av"
    let log = "build/_decl_spec_${name}.log"
    let _ = avra_selfhost_write_file(fixture, src)
    let rc = avra_shell_exec_status("${env} ./build/bs2 check '${fixture}' > '${log}' 2>&1")
    "__status=${rc}\n" + avra_selfhost_read_file(log)
}

fn clean(out: string) -> bool { out.contains("__status=0\n") }

fn clean_all_paths(name: string, src: string) -> bool {
    clean(check_out("${name}_dflt", "", src)) &&
        clean(check_out("${name}_emit", "AVRA_NO_STATIC_FALLBACK=1", src)) &&
        clean(check_out("${name}_exec", "AVRA_PARSER_DECL_STATIC=0", src)) &&
        clean(check_out("${name}_hand", "AVRA_PARSER_DECL_FLIP=0", src))
}

/// True iff the emitted rule fn identified by `head` carries the `@try` scaffolding:
/// a commit flag, a node-store truncate, and a cursor/diagnostic rollback.
///
/// Scoped to that ONE rule's body. `index_of` finds the first match in the whole
/// file, and every other speculative branch emits byte-identical rollback lines, so
/// a file-wide `contains` would pass regardless of what this rule lowered to.
fn rule_speculates(head: string) -> bool {
    let src = decl_src()
    let at = src.index_of(head)
    if at < 0 { return false }
    let body = src.substring(at, src.length)
    let end = body.index_of("\n}\n")
    let rule = if end > 0 { body.substring(0, end) } else { body }
    rule.contains("mut s_cut = false") &&
        rule.contains("st.store.truncate_to_mark(s_mark)") &&
        rule.contains("st.restore_to(s_pos, s_diags, s_err)")
}

spec "t-47hc Phase 4: spec / given / then are emitted as native rules" {
    then "all four parse fns exist in the production declaration parser" {
        let src = decl_src()
        src.contains("fn parse_spec_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_spec_item(st: PState) -> CapVal") &&
            src.contains("fn parse_given_blk(st: PState) -> CapVal") &&
            src.contains("fn parse_then_blk(st: PState) -> CapVal")
    }

    then "spec_decl dispatches BEFORE the decl_hand gate — else it would be dead code" {
        let src = decl_src()
        let spec_at = src.index_of("parse_spec_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        // The dispatcher reaches `spec_decl` by a DIRECT predictive call now, not the
        // speculative `s_last = …` bookkeeping it used to emit: `spec_decl`'s `@try`
        // moved INSIDE the rule, because a `@cut`'s commit flag is per-rule-invocation
        // and cannot reach a caller's `@try`. The routing invariant is unchanged and
        // still asserted (dispatch precedes the hand gate, else the rule is dead
        // code); the speculation half moved to its own assertion below, so committing
        // a keyword can no longer silently retire the check.
        src.contains("return parse_spec_decl(st)") &&
            spec_at >= 0 && hand_at >= 0 && spec_at < hand_at
    }

    then "`spec` is routed as `@try`, never bare — the rule owns the rollback" {
        // A direct `return parse_spec_decl(st)` is only safe when the rule itself
        // speculates: snapshot, and on a pre-`@cut` failure restore the cursor, node
        // store and diagnostics so the `@hand` gate below still sees untouched input.
        // Scoped to the rule's OWN body — `index_of` finds the FIRST match in the
        // file, and the dispatcher's other speculative branches emit the identical
        // rollback lines, so a whole-file `contains` here would pass no matter what
        // `spec_decl` lowered to.
        rule_speculates("fn parse_spec_decl(st: PState)")
    }

    then "the spec-item accumulators are typed List<StmtId> via capval_to_stmt" {
        // The kind-plumbing trap the `pattern` / `tparam` / `match_arm` emit
        // entries were written for: `spec_item` is an alternation whose kind
        // must derive "stmt" through its given/then builds — a mis-kinded
        // repeat would coerce items through capval_to_expr. (The SPECULATIVE
        // property itself is proven BEHAVIORALLY: the corpus red-check turns
        // the recovery-tree spec red when the routing is flipped to bare.)
        let src = decl_src()
        src.contains("mk_spec_block_g(st, capval_tok_text(") &&
            src.contains("mk_given_block_g(st, capval_tok_text(") &&
            src.contains("mk_then_block_g(st, capval_tok_text(")
    }
}

spec "t-47hc Phase 4: every spec form the suite itself writes parses on all four paths" {
    then "a spec with given nesting, then blocks, and setup declarations compiles clean" {
        clean_all_paths("full",
            "fn helper() -> int { 41 }\n" +
            "spec \"native spec routing\" {\n" +
            "    let base = helper()\n" +
            "    given \"a setup\" {\n" +
            "        then \"asserts through the base\" { base + 1 == 42 }\n" +
            "        then \"multi-statement body\" {\n" +
            "            let x = 2\n" +
            "            x * 21 == 42\n" +
            "        }\n" +
            "    }\n" +
            "    then \"top-level then\" { true }\n" +
            "}\n")
    }

    then "an EMPTY spec block parses clean everywhere" {
        clean_all_paths("empty", "spec \"empty\" { }\nfn f() -> int { 1 }\n")
    }

    then "given nested in given parses clean everywhere" {
        clean_all_paths("nested",
            "spec \"s\" {\n" +
            "    given \"outer\" {\n" +
            "        given \"inner\" {\n" +
            "            then \"t\" { 1 == 1 }\n" +
            "        }\n" +
            "    }\n" +
            "}\n")
    }
}

spec "t-47hc Phase 4: the spec frontier did not widen" {
    then "`given` at TOP level stays an error — it is a spec-body keyword only" {
        // Outside a spec body the keyword falls through to expression parsing
        // and reports F0040 (`expected expression`) — the routing must not
        // teach the top level to accept it.
        let out = check_out("topgiven", "", "given \"g\" { }\nfn f() -> int { 1 }\n")
        !clean(out) && out.contains("error[F0040]")
    }

    then "a spec missing its name reports the hand's SPECIFIC message on the default path" {
        // The native STRING miss reports generically, the @try rolls back, and
        // the hand's message must own the output — same shape as the guard
        // form's coded diagnostic in the binding slice.
        let out = check_out("noname", "", "spec\nfn f() -> int { 1 }\n")
        !clean(out) && out.contains("expected spec name string after `spec`")
    }
}
