// WHY: t-47hc.33 — `postfix_suffix`'s eight forms leaving the `@hand` delegate for
// grammar alternatives, one at a time. One spec per form; they accumulate here.
//
// The thing that makes a postfix form flippable at all is that the CHAIN's state is
// already threaded on PState: `postfix_base` (the accumulated receiver) and
// `postfix_sp_start` (the chain's start byte, the constant `lo` every suffix in
// `a.b.c()` shares). A native form must use BOTH — a per-suffix `lo` would re-span every
// chained expression, and skipping `set_postfix_base` would build the next suffix onto a
// stale receiver and silently drop this one, since `fold_postfix_with_expr` reads only
// the LAST suffix's node.
//
// The guard has to be the hand entry guard verbatim (`postfix_step`, parse/mod.av):
// `check(Tk.Question) && allow_dot_postfix && current_line == prev_line`. Dropping any
// conjunct changes what parses: without `allow_dot_postfix` a `?` inside a match arm is
// eaten as a Try instead of ending the arm; without the line test a `?` opening the next
// line is folded onto the previous expression.
//
// `@hand(postfix_suffix)` IS GONE (t-47hc.33.2). Every form is native — `?` · `catch` ·
// `?.field` · `?.m(args)` · `.field` · `.0` · `[i]`/`[a..b]` · `(args)` · `<T>(args)` ·
// `Type.Variant(args)` · `!` — and the two things this header used to list as blockers
// are both closed, NEITHER of them for the reason it gave:
//
//   1. The `FIELDNAME` terminal (t-47hc.33.1). `consume_field_name` accepts
//      `Tk.KwReserved` as well as an identifier, and the native `.`-led branches matched
//      `IDENT` alone, so `x.ref` / `x?.owned` fell to the delegate. NOTE the example this
//      comment carried before was WRONG: it said `x.if` / `x?.match`, but `if` and `match`
//      are ACTIVE keywords (Tk.KwIf / Tk.KwMatch) which the hand REJECTS in field
//      position. Getting that backwards mattered — it made the gap look like the DSL
//      matching too WIDELY when in fact `IDENT` was too NARROW. See reserved_kw_field_test.
//   2. The `!`-loop fallthrough was NOT the blocker. The real one was a TRAILING DOT:
//      every `.`-led branch is `@peek`-gated on a valid field name, so `a.` completed none
//      of them and fell to the delegate, which owns "expected field name after `.`". The
//      `@fallback` `.` branch owns it now.
//
// THE FALLTHROUGH WAS REAL, AND IS NOW CLOSED — but note what the history cost.
// This header once said every compound was "measured with the delegate actually deleted"
// and agreed. Asserted as corpus (error_recovery_differential_test), five of six did;
// `x!` + a NEXT-LINE `?` did not — the hand rejected it while production folded it into a
// Try, because `postfix_step` consumed the `!` run and re-dispatched on `?` without
// re-testing the entry guard's `allow_dot_postfix && current_line == prev_line`.
//
// The fallthrough re-tests those conjuncts now, so all six agree — measured on all four
// paths: `x!\n[0]`, `x!\n(1)`, `x!\n.f`, `x!!`, `x!?` clean everywhere, and `x!\n?` F0040
// everywhere. Note the second sentence of this header was itself stale for a while: it
// described the pre-fix divergence as current long after the re-guard landed. A prose
// claim about behaviour goes out of date silently, which is the whole reason those six
// are corpus. Do not re-derive any of it from this file; the spec is the record.

// THE CHAIN IS PURE DISPATCH NOW (t-kd4y.3.5.8). `postfix_suffix` keeps only
// WHICH rules the chain tries, and in what order; every form's branch lives
// with its feature (unwrap_suffix + catch_suffix + optcall_suffix +
// optchain_suffix — features/null_safety; enum_ctor_suffix + field_suffix —
// features/struct_decl; tuple_suffix — features/tuples; index_suffix +
// call_suffix + call_arg + index_tail — features/calls) and lowers through
// the manifest ABI adapter its owner supplies. Each pin below therefore
// anchors on the OWNING rule's emission (`rule_src`), and the dispatch-level
// properties (order, zero-width gates, no builds/no snap of its own) get
// their own spec. The per-step snap moved WITH the builds: each sub-rule
// carrying a postfix-step build freezes the chain at ITS entry — only
// zero-width gates run between dispatch entry and sub-rule entry, so the
// frozen base is byte-identical to the retired inline form's.

use @std.avrac.features.grammar.{avra_expr_dispatch_grammar, emit_rule_fn, emit_parser_source, Grammar}

/// The emitted ENTRY GUARD (`fn starts_<name>`) of one rule, cut from the
/// full emitted source. A SINGLE-branch rule's leading zero-width gates
/// (peeks, base preds, the same-line `^`) are emitted HERE — the guard the
/// dispatcher consults — not into the parse fn's body, so gate pins must
/// anchor on this and not on rule_src (a multi-branch rule keeps its
/// branch conditions inline, which is why the unwrap/catch pins read the
/// body). Empty string when the rule has no emitted guard.
fn guard_src(name: string) -> string {
    let s = emit_parser_source(avra_expr_dispatch_grammar())
    let start = s.index_of("fn starts_${name}(")
    if start < 0 { return "" }
    // index_of has no from-offset arity — cut the tail first, then find the
    // guard fn's closing brace inside it.
    let rest = s.substring(start, s.length)
    let end = rest.index_of("\n}")
    if end < 0 { return rest }
    rest.substring(0, end)
}

fn rule_src(name: string) -> string {
    let g = avra_expr_dispatch_grammar()
    for gr in g.rules {
        if gr.name == name { return emit_rule_fn(g, gr) }
    }
    ""
}

fn postfix_rule_src() -> string {
    rule_src("postfix_suffix")
}

spec "t-47hc.33: `expr?` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("unwrap_suffix").contains("mk_try_suffix_abi(st, [])")
    }
    then "the guard carries the mode read — `?` in a match arm is not a Try" {
        rule_src("unwrap_suffix").contains("st.modes.allow_dot_postfix != 0")
    }
    then "and the token test" {
        rule_src("unwrap_suffix").contains("st.cur().tk == Tk.Question")
    }
    then "and the SAME-LINE test — a `?` opening the next line ends the chain" {
        rule_src("unwrap_suffix").contains("to_linecol(st.toks[st.pos - 1].pos).line")
    }
    then "the loop over the rule keeps its no-progress break" {
        // The hand tail can return WITHOUT consuming (guard unmatched / generic-call
        // speculation failed / trailing non-postfix arm). The break is the loop's exit;
        // losing it when the rule went partly-native would spin forever.
        let g = avra_expr_dispatch_grammar()
        mut src = ""
        for gr in g.rules {
            if gr.name == "unary" { src = emit_rule_fn(g, gr) }
        }
        src.contains("if st.pos == __rep_before { break }")
    }
}

// Form 3 — `expr?.field`, optional chaining WITHOUT a call. The `?.m(args)` sibling builds
// a DIFFERENT node (Expr.OptionalMethodCall, from an argument list under `it`-sugar); it is
// native now too, and `@peek(qdot_plain_field)` vs `@peek(qdot_method_call)` — the same
// same-line test read in opposite directions — is what separates them before either branch
// is entered.

spec "t-47hc.33: `expr?.field` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("optchain_suffix").contains("mk_opt_chain_abi(st, [")
    }
    then "it is gated by the lookahead, not by the `?.` token alone" {
        // Without the peek the branch would swallow `?.m(args)` and build the wrong node.
        guard_src("optchain_suffix").contains("lookahead_ok(\"qdot_plain_field\", st)")
    }
    then "the field terminal is FIELDNAME — a reserved-keyword field is native too" {
        // Was IDENT, which is `Tk.Identifier` ALONE and therefore NARROWER than
        // consume_field_name — so `?.ref` / `?.owned` declined here and fell to the
        // `@hand` tail. t-47hc.33.1 widened it to the shared `tk_is_field_name` set.
        // Asserted as the full disjunction, not the `Tk.Identifier` substring: that
        // prefix matches BOTH spellings, so it would have passed against the old
        // IDENT-only guard and proved nothing.
        rule_src("optchain_suffix").contains("st.cur().tk == Tk.Identifier || st.cur().tk == Tk.KwReserved")
    }
}

// Form 4 — `expr.field`. The lesson this form encodes: a branch is dispatched on its
// FIRST TOKEN ONLY. A `"." t:NUMBER` branch is therefore ENTERED on every `.`, including
// `.field`, and then fails on the NUMBER — it does NOT fall through to the `@hand` tail.
// Any `.`-led branch needs a SECOND-token lookahead, which is what @peek(dot_plain_field)
// is. Getting that wrong broke comptime expansion (which generates `.field` everywhere)
// while build-quick, --emit-regen-expr and --emit-gen-check all stayed green.

spec "t-47hc.33: `expr.field` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("field_suffix").contains("mk_field_access_abi(st, [")
    }
    then "it is gated on the SECOND token, not just the dot" {
        rule_src("field_suffix").contains("lookahead_ok(\"dot_plain_field\", st)")
    }
    then "and on the whole hand entry-guard conjunct" {
        // dot_is_postfix is a decision TREE, not a conjunction of markers, so it is one
        // shared base predicate rather than @when(cell_mode) + ^ + a base read.
        rule_src("field_suffix").contains("base_pred(\"dot_postfix_ok\", st)")
    }
}

// Form 5 — `expr[i]` / `expr[a..b]`, the FIRST form that RECURSES into `expression`.
//
// That recursion is why `snap_postfix_step` exists. The chain accumulator
// (`st.postfix_base`) is threaded through `( postfix_suffix )*`, but a nested expression
// runs its OWN postfix loop, which seeds and overwrites it. Building the receiver from
// the live accumulator therefore folded onto whatever the INNER expression last
// produced: `stats[i]` became `Index(i, i)` — the loop counter indexed by itself — which
// surfaced as F1206 "cannot index a `int`" in modules nobody had touched.
//
// The suffix always folds onto the base as of the moment it was ENTERED, so that is what
// is frozen, at the top of the rule fn, before any item runs. Inert for the forms that
// consume tokens only, where the snapshot and the live value are equal.

spec "t-47hc.33: the chain base is frozen at step ENTRY" {
    then "each step-building rule freezes it — the recursing form first among them" {
        // The snap follows the BUILDS (rule_has_postfix_step_build keys on the
        // branch's build name), so it moved into the sub-rules with the flip.
        // index_suffix is the rule the hazard was found on (`stats[i]` built
        // `Index(i, i)` without it); every sibling that recurses gets the same
        // treatment by the same mechanism.
        rule_src("index_suffix").contains("st.snap_postfix_step()") &&
            rule_src("call_suffix").contains("st.snap_postfix_step()") &&
            rule_src("catch_suffix").contains("st.snap_postfix_step()")
    }
    then "and the freeze is the FIRST statement — before anything can recurse" {
        // Anchored on the `[` consume: the single-branch rule's gates live
        // in its starts_ guard, so the body opens with the snap and then
        // advances — nothing may run between them.
        let s = rule_src("index_suffix")
        let snap = s.index_of("st.snap_postfix_step()")
        snap >= 0 && snap < s.index_of("let _ = st.advance()")
    }
    then "the DISPATCHER has no freeze of its own — only zero-width gates run before a sub-rule snaps" {
        // postfix_suffix carries no builds, so the mechanism gives it no snap; the
        // frozen base each sub-rule reads is therefore taken at (equivalently) the
        // dispatch entry, since peeks consume nothing.
        !postfix_rule_src().contains("st.snap_postfix_step()")
    }
    then "both engines agree on WHICH rules need it" {
        // emit's rule_has_postfix_step_build_e and executor's rule_has_postfix_step_build
        // carry the same build-name list in separate modules. If they drift, one engine
        // snapshots and the other does not — the exact divergence class this suite exists
        // for. A rule with no postfix-step build must emit no snapshot at all.
        let g = avra_expr_dispatch_grammar()
        mut with_suffix_src = ""
        for gr in g.rules {
            if gr.name == "with_suffix" { with_suffix_src = emit_rule_fn(g, gr) }
        }
        !with_suffix_src.contains("snap_postfix_step")
    }
}

spec "t-47hc.33: `expr[i]` / `expr[a..b]` are grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("index_suffix").contains("mk_index_suffix_abi(st, [")
    }
    then "the index expression is same-line gated — a `[` on a NEW line is a list literal" {
        guard_src("index_suffix").contains("to_linecol(st.toks[st.pos - 1].pos).line")
    }
    then "the two closing-`]` messages are the hand parser's, kept distinct" {
        // One arm in the hand, two sequences here: @expect keys on the token, so each
        // wording needs its own sequence. Dispatch is on `..`, not speculation — the hand
        // parses the index expression exactly once and a @try would parse it twice.
        let g = avra_expr_dispatch_grammar()
        mut tail = ""
        for gr in g.rules {
            if gr.name == "index_tail" { tail = emit_rule_fn(g, gr) }
        }
        tail.contains("expected `]` after slice") && tail.contains("expected `]` after index")
    }
    then "the `]` branch is the unguarded @fallback tail — it owns `a[1 2]`" {
        let g = avra_expr_dispatch_grammar()
        mut tail = ""
        for gr in g.rules {
            if gr.name == "index_tail" { tail = emit_rule_fn(g, gr) }
        }
        !tail.contains("expected an expression")
    }
}

// Form 2 — `expr catch { … }` / `expr catch (e) { … }` (spec Axis 12.5-12.6). Unlike the
// `?` form this one has REAL structure: an optional binding, a statement-list body under
// `allow_dot_postfix`, and four abort points whose messages are the hand parser's.

spec "t-47hc.33: `expr catch { … }` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("catch_suffix").contains("mk_catch_suffix_abi(st, [")
    }
    then "the body parses under allow_dot_postfix ON, and RESTORES after" {
        // The hand saves/sets/restores around parse_statement_list_ids; a leak here
        // would silently change how the REST of the enclosing expression parses.
        rule_src("catch_suffix").contains("modes_with_flag_on(st.modes, \"allow_dot_postfix\")") &&
            rule_src("catch_suffix").contains("st.set_modes(__modes_")
    }
    then "the four abort messages are the hand parser's, verbatim" {
        let s = rule_src("catch_suffix")
        s.contains("expected error binding name after `catch (`") &&
            s.contains("expected `)` after catch binding") &&
            s.contains("expected `{` after catch") &&
            s.contains("expected `}` after catch body")
    }
    then "each of them ABORTS rather than reporting and continuing" {
        // `@require`: the hand returns .Err("parse error"), so the rest of the sequence
        // must not run and consume tokens belonging to whatever follows.
        rule_src("catch_suffix").contains("return CapVal.Node(st.error_node_silent())")
    }
    then "the binding is OPTIONAL — bare `catch {` needs no parens" {
        rule_src("catch_suffix").contains("if st.cur().tk == Tk.LeftParen {")
    }
    then "the mode restore precedes the closing-brace check — no leak on abort" {
        // Ordering matters: were the `}` abort emitted INSIDE the @on wrapper, a missing
        // `}` would return with allow_dot_postfix still forced on.
        let s = rule_src("catch_suffix")
        let restore = s.index_of("st.set_modes(__modes_")
        let close = s.index_of("expected `}` after catch body")
        restore >= 0 && close >= 0 && restore < close
    }
}

// Form 6 — `t.0`, the tuple index. It shares its FIRST token with `.field`, which is
// already native, so it is second-token dispatched via `@peek(dot_number)` — and the peek
// must LEAD the branch, or the ambiguity guard sees an unresolved overlap (it inspects
// only `items[0].prim`).

spec "t-47hc.33: `t.0` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("tuple_suffix").contains("mk_tuple_index_abi(st, [")
    }
    then "and it is second-token dispatched, not FIRST-token dispatched" {
        // `.` is shared with `.field`: dispatch is on the branch's FIRST TOKEN ALONE, so
        // without `@peek(dot_number)` this branch would be entered for EVERY `.` and then
        // fail at `expected NUMBER` instead of falling through to the field-access
        // sibling — comptime expansion writes `.field` everywhere, so the whole compiler
        // stops building. That failure mode is invisible to build-quick, --emit-gen-check
        // and diff-test alike; the peek is what keeps the two `.` readings apart.
        guard_src("tuple_suffix").contains("lookahead_ok(\"dot_number\", st)")
    }
}

// The invariant the recursing forms forced into the open: CHAIN NEUTRALITY.

spec "t-47hc.33: a nested chain is invisible to the chain that contains it" {
    then "the chain rule saves and restores the per-step FREEZE" {
        // `postfix_step_base` freezes ONE step's receiver, but it is a PState SLOT, not a
        // stack — so the chain a suffix recurses into (`xs[<expr>]` today, an argument list
        // once the call form lands) used to overwrite the frozen base before the outer
        // step's build read it, leaving the suffix folded onto the WRONG node. The hand
        // parser has no such hazard because its `rid` is a LOCAL of parse_call.
        let g = avra_expr_dispatch_grammar()
        mut u = ""
        for gr in g.rules {
            if gr.name == "unary" { u = emit_rule_fn(g, gr) }
        }
        u.contains("let c_step_base = st.postfix_step_base") &&
            u.contains("let c_step_sp = st.postfix_step_sp") &&
            u.contains("st.restore_postfix_chain(c_step_base, c_step_sp)")
    }
    then "the restore runs AFTER the fold, not before it" {
        // Restoring early would undo the chain's own ( postfix_suffix )* threading and
        // the fold would pick up the pre-chain base.
        let g = avra_expr_dispatch_grammar()
        mut u = ""
        for gr in g.rules {
            if gr.name == "unary" { u = emit_rule_fn(g, gr) }
        }
        u.index_of("parse_unary_chain(st)") < u.index_of("st.restore_postfix_chain(")
    }
    then "the wrapper delegates to a SEPARATE fn rather than inlining the restore" {
        // The body has many `return` points and the restore has to run after every one
        // of them — a wrapper is the only shape that gets that for free.
        let g = avra_expr_dispatch_grammar()
        mut u = ""
        for gr in g.rules {
            if gr.name == "unary" { u = emit_rule_fn(g, gr) }
        }
        u.contains("fn parse_unary_chain(st: PState) -> CapVal {")
    }
}

spec "t-47hc.33: `f<T>(args)` is grammar-native" {
    then "the owning rule emits the manifest adapter, type args marshalled as TExprs" {
        // The repeated type capture rides the "type" kind's CapVal.TExprs list
        // ctor — the marshalling row grown FOR this flip (it was the one kind
        // with no CapVal list form; manifest_arg_spelling would have emitted
        // the loud unmapped marker).
        rule_src("call_suffix").contains("mk_generic_call_suffix_abi(st, [CapVal.TExprs(ta_list),")
    }
    then "the guard carries the is_callable conjunct — `a < b` stays a comparison" {
        rule_src("call_suffix").contains("base_pred(\"base_callable\", st)")
    }
    then "and the token test" {
        rule_src("call_suffix").contains("st.cur().tk == Tk.Less")
    }
    then "the type arguments are TYPES, not expressions" {
        // The capture is a repeated `type_expr`, so its accumulator must be declared
        // `List<TypeExpr>` and filled through capval_to_texpr. Defaulting to
        // `List<ExprId>` + capval_to_expr (what an UNDECLARED external rule kind gives)
        // is a silent tree corruption, not a compile error, on any build that accepts it.
        rule_src("call_suffix").contains("mut ta_list: List<TypeExpr>") &&
            rule_src("call_suffix").contains("capval_to_texpr(st, parse_type_expr(st))")
    }
    then "the branch is SPECULATIVE — `<` is also the comparison operator" {
        // Without the @try, `a < b` commits to a generic call on sight of `<` and the
        // comparison operator becomes unparseable.
        rule_src("call_suffix").contains("let s_pos = st.pos")
    }
    then "there is NO cut — the hand backtracks on every failure past the `<`" {
        // try_parse_generic_call restores on a bad type list, a missing `(`, a bad arg
        // list AND a missing `)`, so the branch never owns its diagnostics. A cut after
        // `">" "("` would report where the hand re-reads the tokens as a comparison.
        //
        // Assert on `s_cut`, the marker the EMITTER produces — `seq_has_cut` drives a
        // `mut s_cut` declaration plus its commit guard, and emits neither when no
        // branch of the rule cuts. Do NOT assert on `env.set_cut`: that is the
        // INTERPRETER's vocabulary (CapEnv, executor.av) and never appears in emitted
        // source at all, so such a check passes unconditionally and would not notice a
        // `@cut` being added here later. This one fails the moment one is.
        !rule_src("call_suffix").contains("s_cut")
    }
    then "POSITIVE CONTROL: `s_cut` really is what a cut emits" {
        // Without this, the assertion above is only as good as the marker name — a
        // rename would silently turn it back into a check that cannot fail. paren_expr
        // DOES cut (`")" "->" @cut lb:lambda_body`), so its emitted source must contain
        // the marker that postfix_suffix's must not.
        rule_src("paren_expr").contains("s_cut")
    }
    then "the builder call is GATED on the diagnostic count" {
        // The generated parser must not run the build for a doomed speculative branch:
        // mk_generic_call_suffix advances the chain accumulator, and on a branch that is
        // about to roll back that leaves postfix_base pointing past the truncated store.
        rule_src("call_suffix").contains("if st.diags.length == s_diags && st.had_error == s_err")
    }
}

spec "t-47hc.33: `Type.Variant(args)` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("enum_ctor_suffix").contains("mk_enum_ctor_suffix_abi(st, [")
    }
    then "it is gated on the SHAPE — `.` IDENT `(`" {
        guard_src("enum_ctor_suffix").contains("lookahead_ok(\"dot_enum_ctor\", st)")
    }
    then "and on the BASE reading as a type name" {
        // Without this, `obj.method(1)` — a lowercase receiver — would build an EnumCtor
        // instead of a Call. That is a different node, not a different spelling.
        guard_src("enum_ctor_suffix").contains("base_pred(\"base_upper_ident\", st)")
    }
    then "and it carries the `.` arm's whole entry guard" {
        guard_src("enum_ctor_suffix").contains("base_pred(\"dot_postfix_ok\", st)")
    }
    then "the ctor rule is dispatched BEFORE the plain-field rule" {
        // Both families lead with `.`. dot_plain_field DECLINES when a `(` follows a
        // type-shaped base, so the two are disjoint by construction — but only while
        // the ctor rule is reached first: field_suffix carries the unguarded @fallback
        // `.` branch, which would otherwise claim `Type.Variant(` and report. The order
        // lives in the DISPATCHER now, as does the zero-width dot_enum_ctor gate the
        // ambiguity guard keys on.
        let s = postfix_rule_src()
        s.index_of("parse_enum_ctor_suffix(st)") >= 0 &&
            s.index_of("parse_enum_ctor_suffix(st)") < s.index_of("parse_field_suffix(st)")
    }
    then "the ctor is SPANNED, not interned — its rule snapshots the chain base" {
        // The hand alloc_at's this one (unlike the generic call, which alloc_leaf's).
        // Both go through builders, so the assertion is that the owning rule still
        // snapshots the chain base the spanned helper reads.
        rule_src("enum_ctor_suffix").contains("st.snap_postfix_step()")
    }
}

spec "t-47hc.33: `expr?.m(args)` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("optcall_suffix").contains("mk_opt_method_call_abi(st, [")
    }
    then "it is gated on the SAME-LINE `(`, not on `?.` alone" {
        // The hand gates the call on `current_line == prev_line`: a `(` opening the NEXT
        // line is a new statement, and the `?.` reading stays a plain chain. This peek is
        // the exact complement of qdot_plain_field's last clause.
        guard_src("optcall_suffix").contains("lookahead_ok(\"qdot_method_call\", st)")
    }
    then "the method-call rule is dispatched BEFORE the plain-chain rule" {
        // Both lead with `?.`. They are disjoint only because the two peeks test the same
        // line relation in opposite directions — and only while this one is consulted
        // first. The order is the DISPATCHER's now, with the zero-width
        // qdot_method_call gate at the earlier branch's head for the ambiguity guard.
        let s = postfix_rule_src()
        s.index_of("parse_optcall_suffix(st)") >= 0 &&
            s.index_of("parse_optcall_suffix(st)") < s.index_of("parse_optchain_suffix(st)")
    }
    then "`it` sugar is turned ON unconditionally for the arg list" {
        // NOT the plain call's @on_if(base_field_access, …) disjunction: a `?.` receiver is
        // a method receiver by construction, so the hand sets allow_it_sugar = true flat.
        // Losing this silently un-sugars `xs?.map(it * 2)`. Rule-scoped now — the owning
        // rule has exactly this one branch, so the old substring-windowing is unneeded.
        rule_src("optcall_suffix").contains("modes_with_flag_on(st.modes, \"allow_it_sugar\")")
    }
    then "the two `?.` readings build DIFFERENT nodes" {
        // OptionalMethodCall desugars to the if-let shape; OptionalChain has its own node.
        // Confusing them drops the argument list, which no span or token check would catch.
        rule_src("optcall_suffix").contains("mk_opt_method_call_abi(st, [") &&
            rule_src("optchain_suffix").contains("mk_opt_chain_abi(st, [")
    }
}

spec "t-47hc.33: `expr!` is grammar-native" {
    then "the owning rule emits the manifest adapter" {
        rule_src("unwrap_suffix").contains("mk_force_unwrap_abi(st, [])")
    }
    then "it carries the hand entry guard — mode read AND same-line" {
        // `check(Tk.Bang) && allow_dot_postfix && current_line == prev_line`.
        let s = rule_src("unwrap_suffix")
        let start = s.index_of("st.cur().tk == Tk.Bang")
        start >= 0 && s.contains("st.modes.allow_dot_postfix != 0")
    }
}

// The .3.5.8 endpoint, pinned structurally: the chain rule itself.

spec "t-kd4y.3.5.8: postfix_suffix is PURE DISPATCH over feature-owned rules" {
    then "it references the nine sub-rules and builds NOTHING itself" {
        let s = postfix_rule_src()
        s.contains("parse_unwrap_suffix(st)") && s.contains("parse_catch_suffix(st)") &&
            s.contains("parse_optcall_suffix(st)") && s.contains("parse_optchain_suffix(st)") &&
            s.contains("parse_enum_ctor_suffix(st)") && s.contains("parse_tuple_suffix(st)") &&
            s.contains("parse_field_suffix(st)") && s.contains("parse_index_suffix(st)") &&
            s.contains("parse_call_suffix(st)") && !s.contains("_abi(st,")
    }
    then "the `.`-led order is ctor, tuple, field — the fallback owner LAST" {
        // field_suffix carries the unguarded @fallback `.` branch (it owns the
        // trailing-dot diagnostic), so both peek-gated `.` readings must be
        // consulted before it. Sorting tuple_suffix after field_suffix would
        // send `.0` into the fallback's "expected field name after `.`".
        let s = postfix_rule_src()
        s.index_of("parse_enum_ctor_suffix(st)") < s.index_of("parse_tuple_suffix(st)") &&
            s.index_of("parse_tuple_suffix(st)") < s.index_of("parse_field_suffix(st)")
    }
    then "the overlapping heads carry their zero-width gates AT THE DISPATCH" {
        // first_follow's ambiguity guard exempts an overlapping pair only when
        // the EARLIER branch leads with @peek (seq_is_peek_led inspects
        // items[0].prim) — a bare rule reference does not, so the dispatch
        // spells the gates itself. Zero-width and ANDed with the rules' own
        // leading peeks, so the duplication accepts exactly the same inputs.
        let s = postfix_rule_src()
        let ctor_call = s.index_of("parse_enum_ctor_suffix(st)")
        let tuple_call = s.index_of("parse_tuple_suffix(st)")
        s.substring(0, ctor_call).contains("lookahead_ok(\"dot_enum_ctor\", st)") &&
            s.substring(0, tuple_call).contains("lookahead_ok(\"dot_number\", st)")
    }
}
