// WHY: t-47hc.3 (Phase 2) slice 2 — the FIRST/FIRST ambiguity REGRESSION GUARD
// over the REAL grammars. Slice 1 (first_follow.av) built the analysis; this
// asserts every production grammar is UNAMBIGUOUS at the FIRST-set level (no
// alternative silently shadows a sibling on a shared lead token — the PEG
// ordered-choice hazard). All the gnarly disambiguation the grammar genuinely
// needs is behind `@hand`, which the analysis treats as OPAQUE (not a concrete
// overlap), so a clean result here means "the CFG structure the grammar exposes
// is LL(1)". This is the safety net the Phase-3 leaf migrations ride: when a
// migration replaces an `@hand` leaf with real alternatives, any FIRST overlap
// it introduces trips THIS guard instead of silently shadowing a branch at
// runtime. (Not in the compile path → byte-identical.)
use @std.avrac.features.grammar.{grammar_ambiguities, render_ambiguities, GAmbiguity, Grammar, avra_expr_grammar, avra_stmt_grammar, avra_type_grammar, avra_program_grammar, avra_decl_flip_grammar, avra_decl_dispatch_grammar, parse_grammar}

// The ONE intended ordered-choice shadow the guard tolerates: `in_rhs`'s membership
// branch 0 (`"[" … "]"`) legitimately takes precedence over its range branch 1
// (`s:bitor ".." e:bitor`) on a leading `[`. A list literal after `in` is ALWAYS
// membership, never the lower bound of a range — the hand parse resolves it
// identically (diff-test byte-identical). This overlap was HIDDEN while list_expr was
// `@hand` (opaque FIRST); the list_expr flip (t-47hc.4.5) made `bitor`'s FIRST include
// `[`, EXPOSING the pre-existing intended shadow. Filtered PRECISELY (rule + branch
// pair 0/1) so every OTHER shadow — including any future real `in_rhs` overlap — still
// trips the guard.
fn is_intended_shadow(a: GAmbiguity) -> bool {
    a.rule == "in_rhs" && a.i == 0 && a.j == 1 ||
    // t-47hc.18: `brace_expr` went grammar-native, so its `{` is a CONCRETE FIRST where
    // `@hand(brace_expr)` used to be opaque. That EXPOSES two pre-existing ordered-choice
    // shadows (it does not create them): at a `{`, a lambda body and a statement are a
    // BLOCK, never a map expression — `lambda_body = block_expr | expression` and
    // statement's block branch before expr_stmt. Both match the hand parse (verified
    // differentially: `(x) -> { "a": 1 }` yields the same F0040 under both parsers).
    // Filtered by exact rule + branch pair, so any OTHER `{` overlap still trips.
    a.rule == "lambda_body" && a.i == 0 && a.j == 1 ||
    a.rule == "statement" && a.i == 9 && a.j == 10 ||
    // t-47hc.25: the SAME class again, from the match_expr flip. `expression` now has a
    // CONCRETE `match` in its FIRST where `@hand(match_expr)` was opaque, which EXPOSES
    // (does not create) the pre-existing ordered choice: at a leading `match` in
    // statement position, `match_stmt` wins over `expr_stmt`. That is what the hand
    // parser does and what the ordered choice already did — verified directly: the tree
    // is `(match n (0 -> 1; _ -> 2))`, a match STATEMENT, not `(expr (match …))`, and
    // identical under AVRA_PARSER_DECL_FLIP=0. diff-test is byte-identical across the
    // flip, which is the same evidence the list_expr and brace_expr entries above rest on.
    //
    // TWO branch pairs because `statement` is defined in two views with different arities:
    //   5/10 — the production rule (break continue if for while MATCH defer errdefer
    //          return stmt_block EXPR_STMT)
    //   2/6  — the §2 emit-gen-check view (break continue MATCH defer errdefer return
    //          EXPR_STMT)
    // Pinned by exact rule + branch pair, so any OTHER `match` overlap still trips.
    a.rule == "statement" && a.i == 5 && a.j == 10 ||
    a.rule == "statement" && a.i == 2 && a.j == 6
}

// True iff `g` has no FIRST/FIRST ambiguity beyond the intended-shadow allowlist; on
// failure the report is printed so the shadowed rule/branches/tokens are visible.
fn is_unambiguous(g: Grammar) -> bool {
    mut ambs: List<GAmbiguity> = []
    for a in grammar_ambiguities(g) {
        if !is_intended_shadow(a) { ambs.push(a) }
    }
    if ambs.length > 0 { eprintln(render_ambiguities(g, ambs)) }
    ambs.length == 0
}

spec "t-47hc.3: the production grammars are FIRST/FIRST unambiguous" {
    then "the expression ladder has no silently-shadowed alternatives" {
        is_unambiguous(avra_expr_grammar())
    }
    then "the statement grammar is unambiguous" {
        is_unambiguous(avra_stmt_grammar())
    }
    then "the type grammar is unambiguous" {
        is_unambiguous(avra_type_grammar())
    }
    then "the declaration flip + dispatch grammars are unambiguous" {
        // Evaluate BOTH before combining: is_unambiguous prints the report on
        // failure, so a short-circuit && would suppress the second grammar's
        // diagnostics when the first is ambiguous.
        let flip_ok = is_unambiguous(avra_decl_flip_grammar())
        let dispatch_ok = is_unambiguous(avra_decl_dispatch_grammar())
        flip_ok && dispatch_ok
    }
    then "the whole-program grammar is unambiguous" {
        is_unambiguous(avra_program_grammar())
    }
}

// t-47hc.16 (paren-flip prep): grammar_ambiguities exempts a `@peek(cond)`-LED branch
// from the shadow check, like a `@try` branch. `@peek` is a zero-width TOKEN-LOOKAHEAD, so
// it partitions the INPUT — it takes the branch only for inputs the lookahead accepts,
// leaving the rest to a later same-FIRST branch (genuine LL(k) disambiguation, not a silent
// shadow). This is the shape the flipped `paren_expr` needs: its
// `@peek(lparen_ident_colon) "(" …` typed-lambda branch shares FIRST `{(}` with the
// `@try "(" …` / `"(" …` siblings, but the peek only takes it when `( IDENT :` holds.
// A `@when(flag)` MODE-read is NOT exempt (the flag is uncorrelated with the token, so the
// token-level overlap is real) — contrasted below and pinned by when_predicate_test.
spec "t-47hc.16: a @peek-led branch does not shadow (but a @when-led branch still does)" {
    then "two branches both leading `(`, branch 0 @peek-gated, are NOT flagged ambiguous" {
        let gp = parse_grammar("r = @peek(lparen_ident_colon) \"(\" IDENT \":\" IDENT | \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 0
    }
    then "a @when-led branch is NOT exempt — the mode-read token overlap is STILL flagged" {
        // Contrast with @peek: @when reads a parse MODE flag, uncorrelated with the input
        // token, so BOTH branches match the shared `(` at the token level (the mode merely
        // picks one) — a real overlap the check reports (seq_is_peek_led matches only .Peek).
        let gp = parse_grammar("r = @when(at_quote_top) \"(\" IDENT | \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
    then "CONTROL: two PLAIN branches both leading `(` ARE still flagged (the guard is intact)" {
        let gp = parse_grammar("r = \"(\" \")\" | \"(\" IDENT")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
}
