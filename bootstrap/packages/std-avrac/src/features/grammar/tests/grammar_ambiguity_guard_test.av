// WHY: t-47hc.3 (Phase 2) slice 2 — the FIRST/FIRST ambiguity REGRESSION GUARD
// over the REAL grammars. Slice 1 (first_follow.av) built the analysis; this
// asserts every production grammar is UNAMBIGUOUS at the FIRST-set level (no
// alternative silently shadows a sibling on a shared lead token — the PEG
// ordered-choice hazard). All the gnarly disambiguation the grammar genuinely
// needs is behind `@hand`, which the analysis treats as OPAQUE (not a concrete
// overlap), so a clean result here means "the CFG structure the grammar exposes
// is LL(1)". This is the safety net the Phase-3 leaf migrations ride: when a
// migration replaces an `@hand` leaf with real alternatives, any FIRST overlap
// it introduces trips THIS guard instead of silently shadowing a branch at
// runtime. (Not in the compile path → byte-identical.)
use @std.avrac.features.grammar.{grammar_ambiguities, render_ambiguities, GAmbiguity, Grammar, avra_type_grammar, avra_program_grammar, parse_grammar}

// The ONE intended ordered-choice shadow the guard tolerates: `in_rhs`'s membership
// branch 0 (`"[" … "]"`) legitimately takes precedence over its range branch 1
// (`s:bitor ".." e:bitor`) on a leading `[`. A list literal after `in` is ALWAYS
// membership, never the lower bound of a range — the hand parse resolves it
// identically (diff-test byte-identical). This overlap was HIDDEN while list_expr was
// `@hand` (opaque FIRST); the list_expr flip (t-47hc.4.5) made `bitor`'s FIRST include
// `[`, EXPOSING the pre-existing intended shadow. Filtered PRECISELY (rule + branch
// pair 0/1) so every OTHER shadow — including any future real `in_rhs` overlap — still
// trips the guard.
fn is_intended_shadow(a: GAmbiguity) -> bool {
    a.rule == "in_rhs" && a.i == 0 && a.j == 1 ||
    // t-47hc: `~` is TWO operators sharing one token, so a FIRST/FIRST overlap on
    // `lit:~` between unary's `~`-led branches is unavoidable — and it is resolved by
    // predicates the FIRST-set analysis cannot see (the guard deliberately does NOT
    // exempt @when-led branches, which is why this needs naming):
    //   branch 1  @when(at_quote_top)  `~` → BITNOT         (quote_depth == 0)
    //   branch 2  @when(in_quote_body) `~IDENT{` → SPLICE-STRUCT (quote_depth > 0)
    //   branch 3  @when(in_quote_body) `~` → SPLICE          (quote_depth  > 0)
    // 1-vs-{2,3} are PROVABLY disjoint, not merely ordered: at_quote_top and
    // in_quote_body are exact complements over one counter (executor.modes_flag), so
    // at most one side can ever hold — a stronger guarantee than the ordered-choice
    // entries below rest on. 2-vs-3 is the hand parser's own check-then-greedy
    // cascade (parse_leaf_common: `~Name {` splices only the constructor name,
    // everything else is the greedy splice), partitioned by @peek(tilde_ident_lbrace)
    // — a lookahead over tokens the FIRST-set analysis cannot consult (the t-47hc.16
    // exemption applies to peek-led branches in the analysis's own terms, and this
    // branch leads with a @when, so all three pairs need naming). Byte-parity with
    // the hand is pinned by splice_name_positions_test + quote_expr_value_splice.
    a.rule == "unary" && a.i == 1 && a.j == 2 ||
    a.rule == "unary" && a.i == 1 && a.j == 3 ||
    a.rule == "unary" && a.i == 2 && a.j == 3 ||
    // The §2 whole-program view's `un` carries the same complementary pair
    // (branch 1 at_quote_top `~` → BITNOT, branch 2 in_quote_body `~` → SPLICE).
    a.rule == "un" && a.i == 1 && a.j == 2 ||
    // t-47hc.18: `brace_expr` went grammar-native, so its `{` is a CONCRETE FIRST where
    // `@hand(brace_expr)` used to be opaque. That EXPOSES two pre-existing ordered-choice
    // shadows (it does not create them): at a `{`, a lambda body and a statement are a
    // BLOCK, never a map expression — `lambda_body = block_expr | expression` and
    // statement's block branch before expr_stmt. Both match the hand parse (verified
    // differentially: `(x) -> { "a": 1 }` yields the same F0040 under both parsers).
    // Filtered by exact rule + branch pair, so any OTHER `{` overlap still trips.
    a.rule == "lambda_body" && a.i == 0 && a.j == 1 ||
    a.rule == "statement" && a.i == 10 && a.j == 11 ||
    // t-47hc.25: the SAME class again, from the match_expr flip. `expression` now has a
    // CONCRETE `match` in its FIRST where `@hand(match_expr)` was opaque, which EXPOSES
    // (does not create) the pre-existing ordered choice: at a leading `match` in
    // statement position, `match_stmt` wins over `expr_stmt`. That is what the hand
    // parser does and what the ordered choice already did — verified directly: the tree
    // is `(match n (0 -> 1; _ -> 2))`, a match STATEMENT, not `(expr (match …))`, and
    // identical under AVRA_PARSER_DECL_FLIP=0. diff-test is byte-identical across the
    // flip, which is the same evidence the list_expr and brace_expr entries above rest on.
    //
    // TWO branch pairs because `statement` is defined in two views with different arities:
    //   5/10 — the production rule (break continue if for while MATCH defer errdefer
    //          return stmt_block EXPR_STMT)
    //   2/6  — the §2 emit-gen-check view (break continue MATCH defer errdefer return
    //          EXPR_STMT)
    // Pinned by exact rule + branch pair, so any OTHER `match` overlap still trips.
    a.rule == "statement" && a.i == 6 && a.j == 11 ||
    a.rule == "statement" && a.i == 2 && a.j == 6 ||
    // t-47hc.24: the same class a third time, from the if_expr flip. `expression` now has
    // a CONCRETE `if` in its FIRST where `@hand(if_expr)` was opaque, EXPOSING three
    // pre-existing ordered choices. All three are the hand parser's own cascade, and the
    // else_tail pair is precisely why that rule cannot collapse into `expression`:
    //
    //   else_tail 0/2 (`if`) — at a leading `if` the else is an if_expr, entered by
    //     RECURSION as the hand does (parse_if_expression calls itself and returns), NOT
    //     through the expression ladder. Routing it through branch 2 would enter unary's
    //     `base:if_expr ( postfix_suffix )*` and bind trailing postfix to the ELSE-IF.
    //     Measured: `else if b { 2 }.foo` is `(field (if-expr …) foo)` under both engines
    //     — the postfix belongs to the OUTER if.
    //   else_tail 1/2 (`{`) — at a leading `{` the else is a BLOCK, never a map. The hand
    //     calls parse_block_expression unconditionally; going through `expression` would
    //     hit brace_expr's `@peek(brace_map)` first. Structurally identical to the
    //     lambda_body 0/1 entry above, which is the same rule shape at the same token.
    //   statement 2/10 (`if`) — at a leading `if` in statement position the IF STATEMENT
    //     wins over expr_stmt, exactly as the `match` twin at 5/10 does. Verified: the
    //     tree is `(if a (block (return 1)))`, not `(expr (if-expr …))`, and identical
    //     under AVRA_PARSER_DECL_FLIP=0.
    //
    // No `statement` twin is needed in the §2 emit-gen-check view: that view's `statement`
    // has no `if` branch at all. diff-test is byte-identical across the flip, the same
    // evidence the entries above rest on. Pinned by exact branch pair, so any OTHER `if`
    // or `{` overlap still trips the guard.
    a.rule == "else_tail" && a.i == 0 && a.j == 2 ||
    a.rule == "else_tail" && a.i == 1 && a.j == 2 ||
    a.rule == "statement" && a.i == 3 && a.j == 11
}

// INDEX SHIFT (t-myz7): `statement` gained a leading `@peek(if_let) iflet_stmt`
// branch at index 2, so every entry above with an index >= 2 moved by +1
// (9/10 -> 10/11, 5/10 -> 6/11, 2/10 -> 3/11). The 2/6 entry is NOT shifted: it
// belongs to `avra_program_grammar()`, a different view whose `statement` rule this
// change does not touch. The shadows themselves
// are unchanged and still the ones documented above — this allowlist is pinned by
// exact branch PAIR by design, so inserting a branch necessarily renumbers it.
//
// The new branch needs no entry of its own: it is `@peek`-led, and t-47hc.16 (below)
// pins that a @peek-gated branch does not count as a shadower. Plain `if` still
// reaches `if_stmt` — the guard is `if` followed by `let` — so the intended
// "IF STATEMENT wins over expr_stmt" behaviour documented above is untouched.

// True iff `g` has no FIRST/FIRST ambiguity beyond the intended-shadow allowlist; on
// failure the report is printed so the shadowed rule/branches/tokens are visible.
fn is_unambiguous(g: Grammar) -> bool {
    mut ambs: List<GAmbiguity> = []
    for a in grammar_ambiguities(g) {
        if !is_intended_shadow(a) { ambs.push(a) }
    }
    if ambs.length > 0 { eprintln(render_ambiguities(g, ambs)) }
    ambs.length == 0
}

spec "t-47hc.3: the production grammars are FIRST/FIRST unambiguous" {
    then "the expression ladder has no silently-shadowed alternatives" {
        is_unambiguous(avra_program_grammar())
    }
    then "the statement grammar is unambiguous" {
        is_unambiguous(avra_program_grammar())
    }
    then "the type grammar is unambiguous" {
        is_unambiguous(avra_type_grammar())
    }
    then "the declaration flip + dispatch grammars are unambiguous" {
        // Evaluate BOTH before combining: is_unambiguous prints the report on
        // failure, so a short-circuit && would suppress the second grammar's
        // diagnostics when the first is ambiguous.
        let flip_ok = is_unambiguous(avra_program_grammar())
        let dispatch_ok = is_unambiguous(avra_program_grammar())
        flip_ok && dispatch_ok
    }
    then "the whole-program grammar is unambiguous" {
        is_unambiguous(avra_program_grammar())
    }
}

// t-47hc.16 (paren-flip prep): grammar_ambiguities exempts a `@peek(cond)`-LED branch
// from the shadow check, like a `@try` branch. `@peek` is a zero-width TOKEN-LOOKAHEAD, so
// it partitions the INPUT — it takes the branch only for inputs the lookahead accepts,
// leaving the rest to a later same-FIRST branch (genuine LL(k) disambiguation, not a silent
// shadow). This is the shape the flipped `paren_expr` needs: its
// `@peek(lparen_ident_colon) "(" …` typed-lambda branch shares FIRST `{(}` with the
// `@try "(" …` / `"(" …` siblings, but the peek only takes it when `( IDENT :` holds.
// A `@when(flag)` MODE-read is NOT exempt (the flag is uncorrelated with the token, so the
// token-level overlap is real) — contrasted below and pinned by when_predicate_test.
spec "t-47hc.16: a @peek-led branch does not shadow (but a @when-led branch still does)" {
    then "two branches both leading `(`, branch 0 @peek-gated, are NOT flagged ambiguous" {
        let gp = parse_grammar("r = @peek(lparen_ident_colon) \"(\" IDENT \":\" IDENT | \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 0
    }
    then "a @when-led branch is NOT exempt — the mode-read token overlap is STILL flagged" {
        // Contrast with @peek: @when reads a parse MODE flag, uncorrelated with the input
        // token, so BOTH branches match the shared `(` at the token level (the mode merely
        // picks one) — a real overlap the check reports (seq_is_peek_led matches only .Peek).
        let gp = parse_grammar("r = @when(at_quote_top) \"(\" IDENT | \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
    then "CONTROL: two PLAIN branches both leading `(` ARE still flagged (the guard is intact)" {
        let gp = parse_grammar("r = \"(\" \")\" | \"(\" IDENT")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
}

// t-47hc.5 Phase 4 — the exemption follows a BARE REFERENCE one level. `declaration`'s
// two `let` branches are `letdes_decl | let_decl`, and the `@peek(let_destructure)` that
// partitions them is written inside `letdes_decl` (it is referenced from three
// alternations, so the gate belongs with the form it selects). Read only at the dispatch
// site, that branch is a plain `.Ref` and the pair reads as a silent shadow on `let`.
//
// Widening a guard's exemption is the direction that needs the discriminating cases, so
// all three bounds are pinned here: it applies through a single-item ref to an
// all-peek-led callee, and NOT when the callee has any un-peeked branch, NOT when the
// branch carries trailing items, and NOT for a plain ref.
spec "t-47hc.5: the @peek exemption follows a single bare rule reference, one level" {
    then "a branch delegating to an all-@peek-led rule is NOT flagged" {
        let gp = parse_grammar("r = sub | \"let\" IDENT\nsub = @peek(let_destructure) \"let\" \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 0
    }
    then "CONTROL: the callee having ANY un-peeked branch keeps the shadow flagged" {
        // `sub`'s second alternative is reachable on a bare `let` with no lookahead, so
        // the delegating branch really can swallow input the later branch wanted.
        let gp = parse_grammar("r = sub | \"let\" IDENT\nsub = @peek(let_destructure) \"let\" \"(\" \")\" | \"let\" \"mut\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
    then "CONTROL: a branch with TRAILING items past the ref is not exempt" {
        // The peek partitions only what the callee consumes; the rest of the branch is
        // un-gated, so the pair is a genuine overlap again.
        let gp = parse_grammar("r = sub IDENT | \"let\" IDENT\nsub = @peek(let_destructure) \"let\" \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
    then "CONTROL: a plain (non-peeked) callee is still flagged" {
        let gp = parse_grammar("r = sub | \"let\" IDENT\nsub = \"let\" \"(\" \")\"")
        gp.error == "" && grammar_ambiguities(gp.grammar).length == 1
    }
}
