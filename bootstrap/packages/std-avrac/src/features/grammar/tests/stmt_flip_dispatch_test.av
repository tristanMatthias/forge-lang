// ps3t.6.7 Step G slice 4 / t-47hc.37 — the STATEMENT-family ENGINE differential.
//
// `parse_statement` is UNCONDITIONAL now: it runs the statement grammar through
// run_dsl_stmt_at_shared (the tree INTERPRETER over avra_stmt_flip_grammar's
// `statement` rule) and owns its own recovery. The `stmt_flip` field and the hand
// dispatcher `parse_statement_hand` it used to fall through to are both DELETED.
//
// WHICH TWO ENGINES THIS COMPARES, because the answer is not obvious and getting it
// wrong makes the file vacuous:
//
//   INTERPRETER — `parse_statement`, above.
//   GENERATED   — `parse_declaration` driving the CHECKED-IN static parser. The
//                 statement rules ARE generated: avra_decl_dispatch_grammar composes
//                 avra_stmt_dispatch_grammar into the declaration one, so they are
//                 emitted into parse/gen_decl_parser.av (parse_statement at :3467,
//                 called 6x) and `declaration` carries a `statement` tail. A bare
//                 statement therefore reaches the generated statement rules through
//                 the declaration entry. There is no separate gen_stmt_parser.av file
//                 — which is a packaging fact, not an absence of an implementation,
//                 and mistaking the two is what t-47hc.37's retracted first draft did.
//
// Parity = same tree AND same accept/reject: for every VALID statement form both
// engines build the same Stmt; for INVALID forms both must REJECT. Both helpers
// return the SAME "<err>" sentinel, so a mutual rejection is agreement, and both
// render through the same TOTAL render_stmt_id, so equal trees ⇒ equal strings (no
// golden strings).
//
// ONE ASYMMETRY, deliberate and asserted below rather than papered over: `let` is a
// DECLARATION in this grammar (`--parser-frontier` reports it native), so
// `parse_statement` declines it while the declaration entry accepts it. That is the
// two entries having different jobs, not the two engines disagreeing.
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_stmt_id}

/// The INTERPRETER engine, through the statement entry.
fn flip_stmt(src: string) -> string {
    mut p = parser_new(src)
    match p.parse_statement() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<err>"
    }
}

/// The GENERATED engine, through the declaration entry (whose `statement` tail
/// reaches the generated statement rules). `decl_static` is pinned rather than left
/// ambient — an ambient flag would let this collapse onto the interpreter and the
/// whole file would compare a path against itself.
fn gen_stmt(src: string) -> string {
    mut p = parser_new(src)
    p.decl_static = true
    match p.parse_declaration() {
        .Ok(id) -> render_stmt_id(p.store, id)
        .Err(_) -> "<err>"
    }
}

fn agree(src: string) -> bool {
    flip_stmt(src) == gen_stmt(src)
}

spec "t-47hc.37: parse_statement (interpreter) == the generated statement rules" {
    given "both engines really run (sanity: neither side is an error node)" {
        then "a representative form builds a real tree on both" {
            flip_stmt("if x { break }") != "<err>" &&
            gen_stmt("if x { break }") != "<err>" &&
            flip_stmt("if x { break }") == gen_stmt("if x { break }")
        }
    }
    // The asymmetry named in the header, PINNED so it cannot drift into a silent
    // divergence: `let` belongs to the declaration entry, not the statement one.
    given "`let` is a declaration, so the two ENTRIES differ (not the two engines)" {
        then "parse_statement declines it and parse_declaration accepts it" {
            flip_stmt("let x = 1") == "<err>" && gen_stmt("let x = 1") != "<err>"
        }
    }
    given "the DSL-native leaves (break / continue)" {
        then "each agrees across engines" {
            agree("break") && agree("continue")
        }
    }
    given "the grammar-native statement forms" {
        then "each keyword statement agrees" {
            agree("if a { b }") &&
            agree("if a { b } else { c }") &&
            agree("while a { b }") &&
            agree("for i in 0..n { s }") &&
            agree("for x in xs { s }") &&
            agree("match n { 0 -> a\n _ -> b }") &&
            agree("defer { cleanup }") &&
            agree("errdefer cleanup()") &&
            agree("return") && agree("return v") &&
            agree("{ a\n b }")
        }
    }
    given "the residual statement edge oracles" {
        then "subjectless/table match still agree" {
            agree("match { ok -> a\n _ -> b }")
        }
    }
    given "let / mut / const are DECLARATION keywords — the ENTRIES differ, not the engines" {
        // This used to assert `agree(…)` on all three, on the reasoning that "whichever
        // path each ends up on, the outcome is identical". That held while the second
        // helper was `parse_statement_hand`, which shares parse_statement's entry and so
        // declined them too. It does NOT hold against the DECLARATION entry, which owns
        // these keywords natively (`--parser-frontier`: let / const native). Asserting
        // agreement here would now be asserting that two entries with different jobs
        // answer the same, and the honest form is to pin the split.
        then "parse_statement declines each and parse_declaration accepts each" {
            flip_stmt("let x = 1") == "<err>" && gen_stmt("let x = 1") != "<err>" &&
            flip_stmt("const Z = 3") == "<err>" && gen_stmt("const Z = 3") != "<err>"
        }
    }
    given "native lookahead-gated blocks and brace-expression fallback" {
        then "blocks, nested blocks, and string-keyed maps agree" {
            agree("{ { inner } }") && agree("{ \"k\": 1 }")
        }
    }
    given "expression statements (the DSL-native fall-through, over the shared expr grammar)" {
        then "assignment / call / field-assign / pipe agree" {
            agree("x = 1") && agree("f(a, b)") && agree("obj.field = v") &&
            agree("xs |> f")
        }
    }
    given "reject parity: both parsers reject the same malformed statement" {
        then "a dangling operator rejects on both" {
            flip_stmt("= 5") == "<err>" && gen_stmt("= 5") == "<err>"
        }
    }
}
