// WHY: t-47hc — two things, both about `@when(flag)`.
//
// 1. `in_quote_body` — the complement of `at_quote_top`. `~` is TWO operators either
//    side of the quote boundary: bitnot at depth 0 (already grammar-owned, gated
//    `@when(at_quote_top)`) and quote SPLICE inside a body. The splice reading is the
//    residue the `primary_base` @hand leaf still owns, so the grammar needs to be able
//    to ASK for `quote_depth > 0`. The read side is all that is needed here: the hand
//    `quote_expr` leaf still maintains the counter, so nothing has to SET it yet.
//    Landed DORMANT — no production grammar spends it, so emitted parsers are unchanged.
//
// 2. `@when` now VALIDATES its predicate name. It was the one marker that did not
//    (`@off`, `@on` and `@peek` all reject an unknown name), and `modes_flag` answers
//    TRUE for anything it does not recognise — so a typo parsed clean and emitted a
//    guard that was always true. A dead gate admits every branch silently, which is
//    strictly worse than a parse error.
//
// Both engines must agree: the interpreter reads via executor.modes_flag, the generated
// parser via the string emit.pred_guard produces. Asserting only one would let them drift,
// which is precisely how three divergences shipped in #1032 — so the emit side is checked
// against the emitted SOURCE and the executor side by RUNNING it.

use @std.avrac.features.grammar.{parse_grammar, emit_rule_fn, run_grammar_expr}

fn rejects(grammar_src: string) -> bool {
    parse_grammar(grammar_src).error != ""
}

fn err_of(grammar_src: string) -> string {
    parse_grammar(grammar_src).error
}

// A rule gated on `flag`, delegating to a hand leaf that can consume `{ }`.
fn gated_errs(flag: string, src: string) -> bool {
    let gp = parse_grammar("gated = @when(${flag}) @hand(primary_base)")
    run_grammar_expr(gp.grammar, src).had_error
}

fn emitted(flag: string) -> string {
    // TWO alternatives: with a single branch the emitter elides the guard
    // entirely (nothing to discriminate), so the predicate would be untestable.
    let gp = parse_grammar("gated = @when(${flag}) NUMBER | STRING")
    for gr in gp.grammar.rules {
        if gr.name == "gated" { return emit_rule_fn(gp.grammar, gr) }
    }
    ""
}

spec "t-47hc: `in_quote_body` reads quote_depth > 0" {
    then "it is accepted as a @when predicate" {
        !rejects("r = @when(in_quote_body) NUMBER")
    }
    then "the emitted guard tests the counter, not an int-as-bool field" {
        // The default `st.modes.<flag> != 0` form would be wrong for a counter: it
        // would read `quote_depth != 0`, which is accidentally right here but wrong
        // for at_quote_top — both are spelled explicitly so neither depends on luck.
        emitted("in_quote_body").contains("st.modes.quote_depth > 0")
    }
    then "it is the exact complement of at_quote_top" {
        emitted("at_quote_top").contains("st.modes.quote_depth == 0")
    }
    then "the interpreter agrees — at depth 0 the in_quote_body branch does NOT fire" {
        // Default modes are quote_depth == 0, so a rule gated in_quote_body is dead and
        // the `{ }` never parses. The at_quote_top twin is live and parses it.
        gated_errs("in_quote_body", "{ }") && !gated_errs("at_quote_top", "{ }")
    }
}

spec "t-47hc: @when validates its predicate name" {
    then "an unknown predicate is a HARD error, not a silently-true guard" {
        rejects("r = @when(nonsense) NUMBER")
    }
    then "a typo of a real flag is rejected rather than ungated" {
        // The exact failure this closes: modes_flag returns true for anything it does
        // not know, so `allow_strct_lit` used to emit a guard that always held.
        rejects("r = @when(allow_strct_lit) NUMBER")
    }
    then "the message names the offending predicate and lists the legal set" {
        let e = err_of("r = @when(allow_strct_lit) NUMBER")
        e.contains("allow_strct_lit") && e.contains("at_quote_top")
    }
    then "every legal predicate is still accepted" {
        !rejects("r = @when(allow_struct_lit) NUMBER") &&
            !rejects("r = @when(allow_dot_postfix) NUMBER") &&
            !rejects("r = @when(allow_it_sugar) NUMBER") &&
            !rejects("r = @when(cell_mode) NUMBER") &&
            !rejects("r = @when(at_quote_top) NUMBER") &&
            !rejects("r = @when(in_quote_body) NUMBER")
    }
    then "a DERIVED predicate is readable but still not settable" {
        // The asymmetry that needs two lists: @when may READ a value computed from the
        // quote_depth counter; @off/@on may only name a settable bool.
        !rejects("r = @when(in_quote_body) NUMBER") &&
            rejects("r = @off(in_quote_body) NUMBER") &&
            rejects("r = @on(in_quote_body) NUMBER")
    }
}

// `@peek(ident_lbrace)` — the token twin of Parser.peek_after_ident_is_lbrace, which the
// hand parser uses to tell `~Name { … }` (splice the struct CONSTRUCTOR NAME) apart from
// the greedy `~expr` splice. Landed ahead of the primary_base flip that will spend it,
// because the flip needs a real diagnosis first (see t-47hc.5) and this half is
// independently correct and testable.
fn peek_rejects(cond: string) -> bool {
    parse_grammar("r = @peek(${cond}) IDENT | NUMBER").error != ""
}

spec "t-47hc: @peek(ident_lbrace) lookahead" {
    then "it is accepted as a @peek condition" {
        !peek_rejects("ident_lbrace")
    }
    then "an unknown @peek condition is still rejected" {
        peek_rejects("ident_lbrace_typo")
    }
    then "IDENT followed by `{` takes the gated branch" {
        // `x {` — the shape `~Name { … }` hinges on. The gated branch consumes the IDENT.
        let gp = parse_grammar("r = @peek(ident_lbrace) n:IDENT -> Grouping(n) | n:NUMBER -> Grouping(n)")
        !run_grammar_expr(gp.grammar, "x {").had_error
    }
    then "IDENT NOT followed by `{` does NOT take it" {
        // `x +` — falls past the gated branch, and NUMBER cannot match an IDENT either,
        // so the rule fails. That failure IS the evidence the lookahead discriminated.
        let gp = parse_grammar("r = @peek(ident_lbrace) n:IDENT -> Grouping(n) | n:NUMBER -> Grouping(n)")
        run_grammar_expr(gp.grammar, "x +").had_error
    }
}

// t-47hc.30 — `@when` predicates over the POSTFIX BASE. Two of `postfix_step`'s eight
// entry-guard branches ask about the base being folded onto rather than about a token or
// a mode, so `@when` (which resolved against `ExprModes` only) could not express them:
//   base_callable    — the generic-call branch's `is_callable(result)`, so `a < b` stays
//                      a comparison and only Ident/QualifiedIdent/FieldAccess take `<T>`
//   base_upper_ident — the `.Variant` half of `dot_is_postfix`
// Landed DORMANT; the postfix_suffix flip spends them.
//
// The emit side is a CALL to the shared executor.base_pred (the @peek pattern) rather
// than a field test, so the two engines share one definition. Asserted on the emitted
// source, since a divergence here is exactly what shipped three times in #1032.

spec "t-47hc.30: postfix-BASE predicates" {
    then "both are accepted as @when predicates" {
        !rejects("r = @when(base_callable) NUMBER") &&
            !rejects("r = @when(base_upper_ident) NUMBER")
    }
    then "the emitted guard CALLS the shared executor fn, not a mode field" {
        // A `st.modes.base_callable != 0` fallthrough would compile against a field that
        // does not exist; the call form is what keeps both engines on one definition.
        emitted("base_callable").contains("base_pred(\"base_callable\", st)") &&
            !emitted("base_callable").contains("st.modes.base_callable")
    }
    then "base_upper_ident emits the same call shape" {
        emitted("base_upper_ident").contains("base_pred(\"base_upper_ident\", st)")
    }
    then "a base predicate is READ-only — @off/@on still reject it" {
        // Same asymmetry as at_quote_top/in_quote_body: readable, not settable.
        rejects("r = @off(base_callable) NUMBER") && rejects("r = @on(base_callable) NUMBER")
    }
    then "the @when diagnostic lists the base predicates" {
        err_of("r = @when(base_callble) NUMBER").contains("base_callable")
    }
}

// t-47hc.32 — `@bump(counter)`, the scoped COUNTER mode. `@on`/`@off` set a settable
// BOOL for an item's sub-parse and restore it; `quote_depth` is an INT the hand
// parse_quote bumps on entering a quote body and restores on leaving. Same save/restore
// machinery, different cell type — which is the set side the `at_quote_top` /
// `in_quote_body` READ predicates (#1033) were waiting on. Landed DORMANT; the
// quote_expr flip spends it.

fn bumped_src(inner: string) -> string {
    // The bump scopes the GROUP, so the predicate inside observes the incremented value.
    "r = \"[\" @bump(quote_depth) ( ${inner} ) \"]\" -> Grouping(x)"
}

spec "t-47hc.32: @bump(counter) scoped counter mode" {
    then "it parses and validates against its own allowlist" {
        !rejects("r = @bump(quote_depth) NUMBER")
    }
    then "an unknown counter is a HARD error naming the legal set" {
        let e = err_of("r = @bump(quote_dpeth) NUMBER")
        e.contains("quote_dpeth") && e.contains("quote_depth")
    }
    then "a settable BOOL is NOT a bumpable counter — the lists stay distinct" {
        // allow_struct_lit is @off/@on-able; bumping it is meaningless, so reject.
        rejects("r = @bump(allow_struct_lit) NUMBER")
    }
    then "a COUNTER is not @off/@on-able either — the asymmetry holds both ways" {
        rejects("r = @off(quote_depth) NUMBER") && rejects("r = @on(quote_depth) NUMBER")
    }
    then "two set-markers on one item is rejected rather than silently dropped" {
        // exec_item honours mode_off FIRST, so a co-present bump would be dead code.
        rejects("r = @off(allow_struct_lit) @bump(quote_depth) NUMBER")
    }
    then "the emitted code CALLS the shared executor fn, not an inline increment" {
        // Same lockstep rule as the base predicates: one definition, two engines.
        let gp = parse_grammar(bumped_src("x:NUMBER"))
        mut src = ""
        for gr in gp.grammar.rules {
            if gr.name == "r" { src = emit_rule_fn(gp.grammar, gr) }
        }
        src.contains("modes_with_counter_bumped(st.modes, \"quote_depth\")")
    }
    then "the emitted code RESTORES the saved modes after the item" {
        let gp = parse_grammar(bumped_src("x:NUMBER"))
        mut src = ""
        for gr in gp.grammar.rules {
            if gr.name == "r" { src = emit_rule_fn(gp.grammar, gr) }
        }
        src.contains("let __modes_") && src.contains("st.set_modes(__modes_")
    }
    then "the INTERPRETER composes with the read side: in_quote_body sees the bump" {
        // At depth 0 `in_quote_body` is false, so this gated item only parses when the
        // enclosing @bump incremented the counter. That is the read+set round trip.
        let gp = parse_grammar(bumped_src("@when(in_quote_body) x:NUMBER"))
        !run_grammar_expr(gp.grammar, "[ 7 ]").had_error
    }
    then "and the bump is RESTORED — outside it, in_quote_body is false again" {
        // Same item gated OUTSIDE the bumped group: depth is back to 0, so it must fail.
        let gp = parse_grammar("r = \"[\" @bump(quote_depth) ( a:NUMBER ) \"]\" @when(in_quote_body) b:NUMBER -> Grouping(a)")
        run_grammar_expr(gp.grammar, "[ 7 ] 8").had_error
    }
}
