// One slice of the error-recovery differential corpus (t-kdyj.13).
// The corpus was ONE file whose unit process measured 8.4GB resident —
// each un-paired in-process oracle call builds a fresh store + registry
// (~30MB) and arena memory is process-permanent, so the ONLY bound the
// runner offers is fewer cases per PROCESS: per-scenario files, spread
// across shard processes by the stride batcher. Oracle helpers + the
// engine-pinning WHYs live in ONE home: parse/differential.av
// (@std.avrac.parse). Specs are VERBATIM from the original file.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.parse.{CDEF, agree, agree_all, agree_bad, agree_error, agree_pos, agree_tree, dbrace, default_path, errcodes, errmsgs, exec_oracle, mode_env, msgs_agree_bad, pin, pin_pos, pin_tree, poslist, poslist_from, rdiags, rtree, rtree_at, sig_has_parse_code, static_raw, tpl_src, tree_agrees_everywhere, mode_parse, ModeRun, rendered}

spec "t-47hc.3.1: malformed mandatory-terminal constructors recover == exec" {
    // These six forms MUST set had_error (a missing mandatory terminal), so assert a
    // NONEMPTY, matching F-code signature — not just parser parity (which an
    // all-clean pair would satisfy vacuously).
    then "malformed enum-ctor / is-check constructors REPORT and agree" {
        agree_error("fn f() -> int {\n let x = .\n return 0\n}") &&
        agree_error("fn f() -> int {\n let x = .Some(1\n return 0\n}") &&
        agree_error("fn f() -> int {\n let b = x is Foo\n return 0\n}") &&
        agree_error("fn f() -> int {\n let b = x is .\n return 0\n}")
    }
    then "malformed in-membership constructors REPORT and agree" {
        agree_error("fn f() -> int {\n let b = x in [1, 2\n return 0\n}") &&
        agree_error("fn f() -> int {\n let b = x in 1 2\n return 0\n}")
    }
    then "`.(1)`: strict validation fires internally AND the hand fallback now agrees with it" {
        // `.` then `(` (not IDENT) trips the IDENT validation → had_error → fallback
        // to the hand parser. This block used to assert the fallback parsed `.(1)`
        // CLEANLY — no diagnostic under either parser — and read that as proof the
        // validation "never invents an error the hand parser wouldn't raise."
        //
        // The premise was wrong, and t-6u9b's count oracle is what exposed it: hand
        // was not ACCEPTING `.(1)`, it was SILENTLY DROPPING the `.` and parsing the
        // remaining `(1)` as a group. The grammar's strict validation had been right
        // all along; the oracle it deferred to was the broken one, and because both
        // paths ended up quiet the parity assertion passed. Empty-vs-empty agreement
        // is the one shape a differential oracle cannot interpret.
        //
        // With `parse_primary` fixed to report a `.` it cannot use, the two paths
        // still AGREE — which is what this spec is actually for — but now they agree
        // on REPORTING. The non-invention property is unchanged and better evidenced:
        // it is `agree`/`agree_bad` parity across the whole corpus that establishes it,
        // never a single quiet case.
        agree("fn f() -> int {\n let x = .(1)\n return 0\n}") &&
        static_raw("fn f() -> int {\n let x = .(1)\n return 0\n}") != ""
    }
    then "the recovered TREES agree with hand (strictly stronger than F-codes)" {
        agree_bad("fn f() -> int {\n let x = .\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let x = .(1)\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let x = .Some(1\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let b = x is Foo\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let b = x is .\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let b = x in [1, 2\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let b = x in 1 2\n return 0\n}")
    }
}

spec "t-47hc.4.5: grammar-native list_expr recovers == exec oracle" {
    then "malformed list literals REPORT and agree (unclosed, stray/missing comma)" {
        agree_error("fn f() -> int {\n let z = [1, 2\n return 0\n}") &&
        agree_error("fn f() -> int {\n let z = [1,,2]\n return 0\n}") &&
        agree_error("fn f() -> int {\n let z = [1 2]\n return 0\n}")
    }
    then "malformed comprehensions REPORT and agree (missing var / collection)" {
        agree_error("fn f() -> int {\n let z = [a for]\n return 0\n}") &&
        agree_error("fn f() -> int {\n let z = [a for x]\n return 0\n}") &&
        agree_error("fn f() -> int {\n let z = [a for x in]\n return 0\n}")
    }
    then "the recovered TREES agree with hand (strictly stronger than F-codes)" {
        agree_bad("fn f() -> int {\n let z = [1, 2\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let z = [1,,2]\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let z = [a for]\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let z = [a for x in]\n return 0\n}")
    }
    then "well-formed list + comprehension produce NO diagnostics under either mode" {
        agree("fn f() -> int {\n let z = [1, 2, 3]\n let w = [x for x in z]\n return 0\n}") &&
        static_raw("fn f() -> int {\n let z = [1, 2, 3]\n let w = [x for x in z]\n return 0\n}") == ""
    }
}

spec "t-47hc.36: grammar-native paren/tuple recovers == exec oracle" {
    then "a stray comma REPORTS — it is not absorbed into a smaller tuple" {
        // `(1,,2)` built `(tuple (1, 2))` on BOTH engines with NO diagnostic —
        // indistinguishable from the valid `(1,2)`. The tuple branch spelled its
        // separator `( "," ( rest:expression )? )+`, and that optional element
        // swallows an empty slot ANYWHERE, not just a trailing one. Every sibling
        // construct (list_expr, call_suffix, fn_decl params) already used
        // `( @peek(comma_not_r*) "," @onfail(bail) elem )* ( "," )?`, which routes
        // a TRAILING comma to its own slot and makes a MISSING element a hard
        // failure; the tuple was the one rule that diverged from it.
        //
        // agree_bad is the assertion that catches this class: agree_tree alone
        // passes a silent drop, because both engines agree on the wrong tree.
        agree_error("fn f() -> int {\n let z = (1,,2)\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let z = (1,,2)\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let z = (1,,)\n return 0\n}")
    }
    then "trailing comma, 1-tuple and group still parse — the fix does not over-reject" {
        // The optional element existed to permit `(1,)` and `(1, 2,)`; the
        // replacement must keep both, keep `(1)` a GROUP rather than a 1-tuple,
        // and keep the arity of a well-formed tuple unchanged.
        let ok = "fn f() -> int {\n let a = (1,)\n let b = (1, 2,)\n let c = (1, 2)\n let d = (1)\n return 0\n}"
        agree(ok) && static_raw(ok) == ""
    }
}

spec "t-47hc.19: grammar-native template_lit recovers == exec oracle" {
    then "malformed interpolations REPORT and agree" {
        // unterminated `${x` and an invalid sub-expression `${(}`
        agree_error(tpl_src("let b = \"v=" + dbrace() + "x\"")) &&
        agree_error(tpl_src("let b = \"v=" + dbrace() + "(}\""))
    }
    then "the recovered TREES agree with hand (strictly stronger than F-codes)" {
        agree_bad(tpl_src("let b = \"v=" + dbrace() + "x\"")) &&
        agree_bad(tpl_src("let b = \"v=" + dbrace() + "(}\""))
    }
    then "well-formed templates agree (plain, single, multiple, empty, format specs)" {
        agree(tpl_src("let a = \"plain\"")) &&
        agree(tpl_src("let b = \"v=" + dbrace() + "x}\"")) &&
        agree(tpl_src("let c = \"" + dbrace() + "x} and " + dbrace() + "x}\"")) &&
        agree(tpl_src("let d = \"\"")) &&
        agree(tpl_src("let e = \"pi=" + dbrace() + "x:.2f} n=" + dbrace() + "x:d}\"")) &&
        static_raw(tpl_src("let b = \"v=" + dbrace() + "x}\"")) == ""
    }
}

spec "t-47hc.18b: grammar-native qualified_expr recovers == exec oracle" {
    then "malformed qualified references REPORT and agree" {
        agree_error("fn f() -> int {\n let q = @foo\n return 0\n}") &&
        agree_error("fn f() -> int {\n let q = @pkg::\n return 0\n}") &&
        agree_error("fn f() -> int {\n let q = @pkg::T { x: }\n return 0\n}")
    }
    then "the recovered TREES agree with hand" {
        agree_bad("fn f() -> int {\n let q = @foo\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let q = @pkg::T { x: }\n return 0\n}")
    }
    then "well-formed qualified idents and struct literals agree" {
        agree("fn f() -> int {\n let q = @pkg::mod::name\n return 0\n}") &&
        agree("fn f() -> int {\n let q = @pkg::T { x: 1 }\n return 0\n}")
    }
}

spec "t-47hc.18: grammar-native brace_expr / map_literal recover == exec oracle" {
    then "malformed map literals REPORT and agree (missing colon, unclosed, stray comma)" {
        agree_error("fn f() -> int {\n let m = { \"a\": 1, \"b\" 2 }\n return 0\n}") &&
        agree_error("fn f() -> int {\n let m = { \"a\": 1\n return 0\n}") &&
        agree_error("fn f() -> int {\n let m = { \"a\": , \"b\": 2 }\n return 0\n}")
    }
    then "the recovered TREES agree with hand" {
        agree_bad("fn f() -> int {\n let m = { \"a\": 1, \"b\" 2 }\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let m = { \"a\": 1\n return 0\n}")
    }
    then "well-formed maps, blocks and the map-vs-block split agree" {
        // `{}` is an EMPTY MAP in expression position but a BLOCK in statement position;
        // a `{` with a non-string first token is always a block. Trailing comma allowed.
        agree("fn f() -> int {\n let a = { \"k\": 1, \"j\": 2 }\n let b = { \"k\": 1, }\n let c = {}\n return 0\n}") &&
        agree("fn f() -> int {\n let x = 1\n let b = { x + 1 }\n return 0\n}") &&
        // `{ "a" 1 }` is NOT a malformed map: no `:` after the key, so @peek(brace_map)
        // declines and it is a BLOCK of two expression statements — exactly as hand.
        agree("fn f() -> int {\n let m = { \"a\" 1 }\n return 0\n}") &&
        static_raw("fn f() -> int {\n let a = { \"k\": 1 }\n let c = {}\n return 0\n}") == ""
    }
}

spec "t-47hc.17: grammar-native with_suffix recovers == exec oracle" {
    then "malformed with-field lists REPORT and agree (junk token, unclosed)" {
        agree_error("fn f() -> int {\n let a = P { x: 1 }\n let b = a with { 1 }\n return 0\n}") &&
        agree_error("fn f() -> int {\n let a = P { x: 1 }\n let b = a with { x: 2\n return 0\n}") &&
        agree_error("fn f() -> int {\n let a = P { x: 1 }\n let b = a with x: 2 }\n return 0\n}")
    }
    then "the recovered TREES agree with hand (strictly stronger than F-codes)" {
        agree_bad("fn f() -> int {\n let a = P { x: 1 }\n let b = a with { 1 }\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let a = P { x: 1 }\n let b = a with { x: 2\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let a = P { x: 1 }\n let b = a with x: 2 }\n return 0\n}")
    }
    then "well-formed `with` — including SHORTHAND, comma-less and CHAINED — agrees" {
        // The hand loop needs no comma between fields (`{ x y }` is two shorthand
        // inits), and `mk_field_init` must expand a bare `name` to `name: Ident(name)`.
        // Chaining exercises the span contract: rebind_with reads each partial With's
        // `.hi`, so a wrong sp_start would corrupt the second suffix's span.
        agree("fn f() -> int {\n let a = P { x: 1, y: 2 }\n let b = a with { x: 10 } with { y: 20 }\n return 0\n}") &&
        agree("fn f() -> int {\n let a = P { x: 1, y: 2 }\n let x = 5\n let b = a with { x }\n return 0\n}") &&
        agree("fn f() -> int {\n let a = P { x: 1, y: 2 }\n let x = 5\n let y = 6\n let b = a with { x y }\n return 0\n}") &&
        static_raw("fn f() -> int {\n let a = P { x: 1, y: 2 }\n let b = a with { x: 10 } with { y: 20 }\n return 0\n}") == ""
    }
}

spec "t-47hc.16: grammar-native paren_expr recovers == exec oracle" {
    then "unclosed grouping REPORTS exactly like hand" {
        agree_error("fn f() -> int {\n let a = (1 + 2\n return a\n}")
    }
    then "unclosed tuple REPORTS exactly like hand" {
        agree_error("fn f() -> int {\n let pair = (1, 2\n return 0\n}")
    }
    then "untyped and typed lambda failures REPORT exactly like hand" {
        agree_error("fn f() -> int {\n let id = (x -> x\n return 0\n}") &&
        agree_error("fn f() -> int {\n let id = (x) ->\n return 0\n}") &&
        agree_error("fn f() -> int {\n let id = (x: ) -> x\n return 0\n}") &&
        agree_error("fn f() -> int {\n let id = (x: int) ->\n return 0\n}")
    }
    then "a missing lambda body keeps the binding rather than erasing it" {
        agree_bad("let a = (1) ->") &&
        agree_bad("let a = (x) ->") &&
        agree_bad("let a = (1, 2) ->") &&
        // The committed forms must be UNAFFECTED — a valid lambda still wins over the
        // grouping fallback at every arity, typed and untyped.
        agree_tree("let f = (x) -> x + 1") &&
        agree_tree("let g = (a, b) -> a") &&
        agree_tree("let h = (x: int) -> x") &&
        agree_tree("let e = () -> 1") &&
        agree_tree("let t = (1, 2)")
    }
    then "every malformed paren form recovers to the identical tree" {
        agree_bad("fn f() -> int {\n let a = (1 + 2\n return a\n}") &&
        agree_bad("fn f() -> int {\n let pair = (1, 2\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let id = (x -> x\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let id = (x) ->\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let id = (x: ) -> x\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let id = (x: int) ->\n return 0\n}")
    }
    then "well-formed group tuple and lambda forms produce no diagnostics" {
        agree("fn f() -> int {\n let a = (1 + 2)\n let pair = (1, 2)\n let typed = (x: int) -> x\n return a\n}") &&
        static_raw("fn f() -> int {\n let a = (1 + 2)\n let pair = (1, 2)\n let typed = (x: int) -> x\n return a\n}") == ""
    }
}

spec "t-6u9b: no token is discarded without a diagnostic" {
    // The ticket's own case, verbatim. `let a = (1) ->` leaves the `->` behind once
    // t-oejs stops erasing the binding; the statement loop must REPORT it, not step
    // over it. Counted, not just shaped: a silent drop and a clean recovery differ
    // only in the diagnostic, and only on one of the two paths.
    then "a stray `->` left inside a fn body is reported on BOTH paths" {
        // `agree_bad` already fails on a zero count from either engine (its
        // SILENT DROP branch) — the count intent, without two more parses.
        agree_bad("fn f() -> int {\n let a = (1) ->\n return 0\n}")
    }
    // The second instance, found by the count oracle. `parse_primary` consumed the
    // `.` for the contextual enum-variant shorthand (`.Variant` / `.Variant(args)`),
    // found no identifier after it, and fell through to the rest of the dispatch —
    // with the `.` already eaten. So `.(1)` parsed as the group `(1)`, `.[1]` as a
    // list, `."s"` as a string: whatever followed simply absorbed the position and
    // the `.` was gone. Zero diagnostics, on BOTH paths, which is why `agree_tree`
    // never saw it. In primary position a `.` can only open the variant shorthand
    // (a postfix `.field` needs an operand to its left and is `dot_is_postfix`'s
    // job; `..` lexes as its own token), so a non-identifier after it is an error.
    then "a `.` not followed by a variant name is reported, not swallowed" {
        agree_bad("fn f() -> int {\n let x = .(1)\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let x = .[1]\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let x = .\"s\"\n return 0\n}") &&
        agree_bad("fn f() -> int {\n let x = .5\n return 0\n}")
    }
    // The token must not merely be reported — it must not be silently ABSORBED into
    // a well-formed-looking node either. `.(1)` recovering as `(group 1)` would be
    // the same bug wearing a diagnostic: the tree would still claim the user wrote
    // something they did not.
    then "the swallowed form recovers to `(error)`, exactly like a bare trailing `.`" {
        let dotted = rtree(false, "fn f() -> int {\n let x = .(1)\n return 0\n}")
        let plain = rtree(false, "fn f() -> int {\n let x = .\n return 0\n}")
        dotted == plain && dotted.contains("(error)") && !dotted.contains("(group 1)")
    }
    // The shorthand itself is untouched — the fix rejects only the forms that had no
    // reading, so every valid `.Variant` shape still parses with no diagnostic.
    then "the valid variant shorthand still parses at every shape" {
        rdiags(false, "fn f() -> E {\n return .A\n}") == 0 &&
        rdiags(false, "fn f() -> E {\n return .Some(1)\n}") == 0 &&
        rdiags(false, "fn f() -> E {\n return .Pair(1, 2)\n}") == 0 &&
        rdiags(true, "fn f() -> E {\n return .Some(1)\n}") == 0
    }
}
