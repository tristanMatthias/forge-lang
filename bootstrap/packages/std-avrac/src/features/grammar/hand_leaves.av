// WHY: the `@hand(<leaf>)` escape hatch's SEAM — one table of hand leaves,
// each carrying a FREE FUNCTION over an explicit parse state instead of an
// `impl Parser` method reached through a receiver.
//
// The gnarly 5% (GRAMMAR_DSL.md §5) lives in hand-written code the grammar
// delegates to by name. Until now that delegation was a hardcoded
// `match name { "quote_expr" -> bp.parse_quote() … }` inside `run_hand_expr` /
// `run_hand_stmt`, mirrored by a `name == "…" || …` class predicate in the
// executor AND a second copy of that predicate in emit.av. Five parallel
// tables keyed on the same string, none of them reachable by a feature:
// a method is not a value, so nothing could hold `bp.parse_quote` and hand it
// to a registry. Adding a leaf meant editing the central engine in several
// places — the opposite of the per-feature ownership `feature_grammar_fragments`
// established for grammar FRAGMENTS.
//
// This module closes that seam. Each leaf becomes a free function of the shape
// `fn(Parser) -> Result<…, string>` — the same shape `Feature.parse_decl`
// already uses for keyword parsers (`kw_parse_let`, features/let_stmt/mod.av) —
// and one lookup returns it together with the leaf's metadata. The delegate is
// now a VALUE, so a later slice can move an entry into the feature that owns it
// and collect them through a registry, exactly as fragments are collected.
//
// The functions are deliberately thin forwarders: this slice moves the SEAM,
// not the parsers. The hand parser they call is unchanged, so every parse stays
// byte-identical.
//
// This table is also the catalogue of the gnarly 5% — the forms the pure
// grammar deliberately does NOT re-express, and why. The recurring reasons:
// parser-mode STATEFULNESS a stateless token-grammar cannot carry (`quote { … }`
// bumps `quote_depth`, which is what makes a leading `~` a splice rather than
// bitwise-NOT; the postfix loop reads `allow_struct_lit` / `allow_dot_postfix` /
// `allow_it_sugar`), NEWLINE-SENSITIVITY (a bodyless `return\n<expr>` is
// ReturnEmpty plus a separate statement, decided by the hand parser's
// `current_line != prev_line` guard; the postfix chain likewise refuses to
// attach a `.`/`[`/`(` that begins on a new line), hygienic DESUGARS that mint
// a fresh temp name (`let … else` → `build_let_else`, `if let`), and stateful
// registry mutation with char-level lookahead (`component`).

use core.{ExprId, StmtId}
use parse.{Parser}

// ── The leaf records ──
//
// Two record types rather than one with a nullable/no-op half: a statement leaf
// and an expression leaf differ in their return arena (StmtId vs ExprId) and an
// expression leaf carries one extra column, so the split keeps both total — no
// entry can name a delegate of the wrong kind.

/// A STATEMENT/DECLARATION `@hand` leaf: the name the grammar delegates by,
/// and the free function that parses it over the delegate parse state.
export type HandStmtLeaf = {
    name: string,
    run: fn(Parser) -> Result<StmtId, string>,
}

/// An EXPRESSION `@hand` leaf. `seeds_postfix` marks the leaves that produce a
/// primary BASE for the grammar's `( postfix_suffix )*` fold to wrap (Phase 3a
/// base-threading) — the column that was `hand_seeds_postfix`.
export type HandExprLeaf = {
    name: string,
    seeds_postfix: bool,
    run: fn(Parser) -> Result<ExprId, string>,
}

// ── The delegates ──
//
// One free function per leaf, over the explicit parse state. Each forwards to
// the hand parser entry the `@hand` name has always meant; the comments record
// WHICH parse the grammar is opting out of, so the table reads as the catalogue
// of what the DSL cannot yet say.

/// `component` declarations (ps3t.6.5.7) — a component's raw/structured body
/// is registry-sensitive, so the whole declaration stays hand-parsed.
fn hand_component_decl(p: Parser) -> Result<StmtId, string> { p.parse_component_decl() }

/// `let` / `mut` / `const` bindings, including the `let … else` bind-fresh
/// desugar (which mints a hygienic temp name).
fn hand_let_stmt(p: Parser) -> Result<StmtId, string> { p.parse_let_statement() }

/// `return` statements.
fn hand_return_stmt(p: Parser) -> Result<StmtId, string> { p.parse_return_statement() }

/// The residual match-STATEMENT edge oracle (subjectless / table / bare-return /
/// quote-splice arms) — narrower than the generic statement leaf.
fn hand_match_table(p: Parser) -> Result<StmtId, string> { p.parse_match_statement() }

/// The whole STATEMENT dispatch (block, if/while/for/match/defer/errdefer/
/// return). The `_hand` entry, so the delegate does not re-flip THIS statement —
/// only its nested bodies flip, via the delegate's own delegate.
fn hand_stmt_hand(p: Parser) -> Result<StmtId, string> { p.parse_statement_hand() }

/// The whole DECLARATION dispatch (doc/annotation/export wrapping + the decl
/// keywords + the component-vs-expression IDENT disambiguation + the statement
/// fall-through). The `_hand` entry, same recursion guard as `stmt_hand`.
fn hand_decl_hand(p: Parser) -> Result<StmtId, string> { p.parse_declaration_hand() }

/// `quote { … }` — bumps `quote_depth`, which is what makes a leading `~`
/// inside the body parse as `Expr.Splice` instead of bitwise-NOT.
fn hand_quote_expr(p: Parser) -> Result<ExprId, string> { p.parse_quote() }

/// `match` as an EXPRESSION (Phase 3a-11 keyword-led primary).
fn hand_match_expr(p: Parser) -> Result<ExprId, string> { p.parse_match_expression() }

/// `if` as an EXPRESSION, including the `if let` desugar.
fn hand_if_expr(p: Parser) -> Result<ExprId, string> { p.parse_if_expression() }

/// `[ … ]` list literals and comprehensions.
fn hand_list_expr(p: Parser) -> Result<ExprId, string> { p.parse_list_expr() }

/// `( … )` — the paren/tuple/lambda-parameter ambiguity.
fn hand_paren_expr(p: Parser) -> Result<ExprId, string> { p.parse_paren_expr() }

/// A lambda BODY: a block `{ … }` or a bare expression. Block-as-expression
/// couples to the statement machinery, so the paren flip delegates it here.
fn hand_lambda_body(p: Parser) -> Result<ExprId, string> { p.parse_lambda_body() }

/// A lambda body known to be a BLOCK.
fn hand_lambda_block_body(p: Parser) -> Result<ExprId, string> { p.parse_block_expression() }

/// The identifier-led primary (bare ident / struct literal / table / feature
/// keyword / tagged template).
fn hand_ident_primary(p: Parser) -> Result<ExprId, string> { p.parse_ident_expr() }

/// The ident-or-`@`-led primary, via the full primary dispatch.
fn hand_ident_expr(p: Parser) -> Result<ExprId, string> { p.parse_primary() }

/// The remaining primaries served by `parse_primary`: enum constructors
/// (`.Variant(…)`) and list literals.
fn hand_more_primary(p: Parser) -> Result<ExprId, string> { p.parse_primary() }

/// The WHOLE procedural leaf: prefix unary ops + `with`/splice + the
/// newline-sensitive postfix chain + every primary form. The DSL owns only the
/// declarative binary/infix ladder above this.
fn hand_hand_unary(p: Parser) -> Result<ExprId, string> { p.parse_unary() }

/// The `with`-BASE leaf: `parse_unary` WITHOUT the `with` loop. Not
/// `parse_call` — the `~` splice/BitNot prefix must stay here so splice-in-quote
/// stays byte-identical.
fn hand_call_leaf(p: Parser) -> Result<ExprId, string> { p.parse_unary_leaf() }

/// The primary BASE (splice/prefix + `parse_primary`, NO postfix chain); the
/// grammar's `unary` rule owns the postfix loop over it.
fn hand_primary_base(p: Parser) -> Result<ExprId, string> { p.parse_primary_base() }

/// ONE postfix step over the grammar-threaded base.
fn hand_postfix_suffix(p: Parser) -> Result<ExprId, string> { p.parse_postfix_suffix() }

// ── The table ──
//
// A `match` rather than a built `List`, so a lookup costs the same string
// comparisons the two hardcoded matches cost before and allocates only the one
// record it returns. One lookup now answers BOTH questions the callers used to
// ask separately ("is this a leaf of my kind?" then "which parser?"), so the
// hot `@hand` path does one scan where it used to do two.

/// The STATEMENT/DECLARATION leaf named `name`, or null when `name` names none.
export fn hand_stmt_leaf(name: string) -> HandStmtLeaf? {
    match name {
        "component_decl" -> HandStmtLeaf { name, run: hand_component_decl }
        "let_stmt"       -> HandStmtLeaf { name, run: hand_let_stmt }
        "return_stmt"    -> HandStmtLeaf { name, run: hand_return_stmt }
        "match_table"    -> HandStmtLeaf { name, run: hand_match_table }
        "stmt_hand"      -> HandStmtLeaf { name, run: hand_stmt_hand }
        "decl_hand"      -> HandStmtLeaf { name, run: hand_decl_hand }
        _                -> null
    }
}

/// The EXPRESSION leaf named `name`, or null when `name` names none.
export fn hand_expr_leaf(name: string) -> HandExprLeaf? {
    match name {
        "quote_expr"        -> HandExprLeaf { name, seeds_postfix: true,  run: hand_quote_expr }
        "match_expr"        -> HandExprLeaf { name, seeds_postfix: true,  run: hand_match_expr }
        "if_expr"           -> HandExprLeaf { name, seeds_postfix: true,  run: hand_if_expr }
        "list_expr"         -> HandExprLeaf { name, seeds_postfix: true,  run: hand_list_expr }
        "paren_expr"        -> HandExprLeaf { name, seeds_postfix: true,  run: hand_paren_expr }
        "ident_primary"     -> HandExprLeaf { name, seeds_postfix: true,  run: hand_ident_primary }
        "primary_base"      -> HandExprLeaf { name, seeds_postfix: true,  run: hand_primary_base }
        "lambda_body"       -> HandExprLeaf { name, seeds_postfix: false, run: hand_lambda_body }
        "lambda_block_body" -> HandExprLeaf { name, seeds_postfix: false, run: hand_lambda_block_body }
        "ident_expr"        -> HandExprLeaf { name, seeds_postfix: false, run: hand_ident_expr }
        "more_primary"      -> HandExprLeaf { name, seeds_postfix: false, run: hand_more_primary }
        "hand_unary"        -> HandExprLeaf { name, seeds_postfix: false, run: hand_hand_unary }
        "call_leaf"         -> HandExprLeaf { name, seeds_postfix: false, run: hand_call_leaf }
        "postfix_suffix"    -> HandExprLeaf { name, seeds_postfix: false, run: hand_postfix_suffix }
        _                   -> null
    }
}

/// True when `name` is a STATEMENT/DECLARATION `@hand` leaf. The ONE class
/// predicate — the executor's dispatch and emit.av's rule-class routing both
/// read it, so the two can no longer drift apart.
export fn is_hand_stmt_leaf(name: string) -> bool { hand_stmt_leaf(name) != null }

/// True when `name` is an EXPRESSION `@hand` leaf.
export fn is_hand_expr_leaf(name: string) -> bool { hand_expr_leaf(name) != null }
