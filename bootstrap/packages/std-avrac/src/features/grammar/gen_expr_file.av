// WHY: ps3t.6.7 Step G — the single source of truth for the CHECKED-IN production
// expression static-parser module (parse/gen_expr_parser.av). This module is NON-
// PRODUCTION: it is imported ONLY by the regenerator (diagnose.sh --emit-regen-expr)
// and the regen guard (parse/tests/gen_expr_parser_regen_test.av), so it — and
// transitively emit.av — never enters the production compiler graph (mod.av imports
// the GENERATED file, which pulls only the grammar builders, not the emitter).
//
// `emit_expr_parser_file()` returns the COMPLETE module text: a provenance banner + the DERIVED
// import header (computed from the emitted source) + `emit_parser_source_ex(_, true)`
// (the exported static parser fns). Editing the §2 expression grammar (avra_grammar.av)
// changes this text — run `bash scripts/diagnose.sh --emit-regen-expr` to rewrite the
// checked-in file, then commit it; the guard test fails until you do.

use features.grammar.{assemble_language, emit_parser_source_ex, derived_import_lines}

/// The BANNER of this generated parser module — provenance comments only.
/// The import header is no longer hand-kept: it derives from the emitted
/// source itself (derived_import_lines, t-47hc.8 generator-owns-imports),
/// so nothing here can drift from what the body references.
export fn gen_expr_parser_header() -> string {
    // RELATIVE imports (features.grammar / core), NOT the absolute `@std.avrac.`
    // form the emit-gen-check STANDALONE harness uses: this file is a globbed
    // in-package compiler-src module, and an absolute self-import of the package
    // being built makes the metadata lib build's module graph process the whole
    // package a SECOND time — every @derive/@expand type double-expands (F4012).
    // The rest of compiler src/ imports relatively for exactly this reason.
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-expr` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: the §2 expression grammar in features/grammar/avra_grammar.av.\n" +
    "// This is the PRODUCTION expression parser under AVRA_PARSER_EXPR_STATIC=1 (ps3t.6.7\n" +
    "// Step G); parse/tests/gen_expr_parser_regen_test.av asserts it equals\n" +
    "// emit_expr_parser_file() so a grammar edit that isn't regenerated fails the suite.\n\n"
}

/// The complete text of parse/gen_expr_parser.av: header + the exported generated
/// body. Both the regenerator and the guard read from HERE.
export fn emit_expr_parser_file() -> string {
    // The LANGUAGE PIPELINE (language.av): load → compose → build, one
    // call; the expression dispatch view arrives stamped with the
    // manifest's kind rows.
    let src = emit_parser_source_ex(assemble_language().expr_dispatch(), true)
    gen_expr_parser_header() + derived_import_lines(src, "features.grammar", "core") + "\n" + src
}
