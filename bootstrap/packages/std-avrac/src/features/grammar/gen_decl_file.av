// WHY: ps3t.6.7 Phase 2 — the single source of truth for the CHECKED-IN production
// DECLARATION static-parser module (parse/gen_decl_parser.av). Sibling of
// gen_expr_file.av. NON-PRODUCTION: imported ONLY by the regenerator
// (diagnose.sh --emit-regen-decl) and the regen guard
// (parse/tests/gen_decl_parser_regen_test.av), so it — and transitively emit.av —
// never enters the production compiler graph (mod.av imports the GENERATED file,
// which pulls only the grammar builders + @hand runners, not the emitter).
//
// `emit_decl_parser_file()` returns the COMPLETE module text: a fixed import header
// (the grammar builders + @hand runners the generated body calls) +
// `emit_parser_source_ex(avra_decl_flip_grammar(), true)` (the exported static parser
// fns: parse_declaration / parse_statement + the composed statement + expression
// ladder). avra_decl_flip_grammar is the PRODUCTION router `declaration =
// @hand(decl_hand) | statement`, so the generated parser drives the identical
// top-level dispatch (run_hand_stmt on the exact FIRST sets) the interpreter flip
// does — at straight-line speed. Editing the §2 grammars (avra_grammar.av) changes
// this text — run `bash scripts/diagnose.sh --emit-regen-decl` to rewrite the
// checked-in file, then commit it; the guard test fails until you do.

use features.grammar.{avra_decl_dispatch_grammar, emit_parser_source_ex}

/// The fixed import header of the production declaration static-parser module:
/// exactly the features.grammar builders + @hand runners + core types the generated
/// body references (verified against the emitted source — an extra import is only an
/// F9002 warning, but a MISSING one is a hard undefined-symbol error). Superset of
/// gen_expr_parser_header: adds `run_hand_stmt` (the @hand(decl_hand)/@hand(stmt_hand)
/// dispatch) + `Stmt` (the Break/Continue/Expr statement constructors).
export fn gen_decl_parser_header() -> string {
    // RELATIVE imports (features.grammar / core), NOT the absolute `@std.avrac.` form:
    // this is a globbed in-package compiler-src module, and an absolute self-import of
    // the package being built double-expands every @derive/@expand type (F4012) — the
    // same reason gen_expr_file.av documents.
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-decl` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: the §2 declaration/statement/expression grammars in\n" +
    "// features/grammar/avra_grammar.av (avra_decl_flip_grammar). This is the PRODUCTION\n" +
    "// declaration parser under AVRA_PARSER_DECL_STATIC=1 (ps3t.6.7 Phase 2);\n" +
    "// parse/tests/gen_decl_parser_regen_test.av asserts it equals emit_decl_parser_file()\n" +
    "// so a grammar edit that isn't regenerated fails the suite.\n" +
    "use features.grammar.{Token, CapVal, PState, capval_to_expr, capval_to_stmt, capval_to_arm, run_hand_expr, run_hand_stmt, lookahead_ok, mk_binary, mk_assign_expr, fold_pipe_expr, fold_nullish_expr, fold_logical_expr, rebind_eq_expr, mk_is_expr, mk_inlist_expr, mk_inrange_expr, mk_eqchain_expr, tok_starts_expr_leaf, tok_starts_pattern, mk_block, mk_while, mk_if, mk_if_let_stmt, mk_for_loop, mk_for_binding, mk_for_destructure, mk_return_opt, mk_arm, mk_arm_return, mk_match, mk_match_table, mk_match_table_expr, capval_to_pat, mk_use, mk_use_pkg, mk_module, capval_present, capval_tok_text, capval_tok_list, mk_fn_decl_g, mk_type_decl_g, mk_type_decl_any, mk_enum_decl_g, mk_type_param, mk_extern_fn, mk_shape_decl, mk_impl, mk_method, mk_trait_decl, mk_trait_method, mk_assoc_type, mk_when, mk_when_arm, mk_when_default, capval_to_when_arm, mk_export_decl, mk_stamp_stmt_at, mk_ann_g, mk_annotated_args_g, mk_doc_annotated, mk_module_doc, mk_let_binding_g, mk_const_binding_g, mk_let_destructure_g, gensym_token, mk_parallel_g, mk_select_g, mk_select_arm_g, capval_to_select_arm, mk_spec_block_g, mk_given_block_g, mk_then_block_g, mk_comp_config_g, mk_children_slot_g, mk_comp_field_g, mk_component_def_g, mk_comp_config_pair_g, mk_component_block_g, mk_raw_component_block_g, mk_method_shorthand_g, rawbrace_scan, capval_to_comp_config_pair, capval_to_comp_config_pair_list, capval_to_comp_config, capval_to_children_slot, capval_tok_texts, capval_to_ann, mk_evariant, mk_field, capval_to_tparam, capval_to_field, capval_to_variant, capval_to_pentry, capval_to_texpr, tok_starts_type, modes_with_flag_off}\n" +
    "use core.{ExprId, Stmt, MatchArm, SelectArm, CompConfig, CompConfigPair, ChildrenSlot, Tk, SrcPos, TypeParamEntry, Annotation}\n\n"
}

/// The complete text of parse/gen_decl_parser.av: header + the exported generated
/// body. Both the regenerator and the guard read from HERE.
export fn emit_decl_parser_file() -> string {
    gen_decl_parser_header() + emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}
