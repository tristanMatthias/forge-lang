// WHY: ps3t.6.7 Phase 2 — the single source of truth for the CHECKED-IN production
// DECLARATION static-parser module (parse/gen_decl_parser.av). Sibling of
// gen_expr_file.av. NON-PRODUCTION: imported ONLY by the regenerator
// (diagnose.sh --emit-regen-decl) and the regen guard
// (parse/tests/gen_decl_parser_regen_test.av), so it — and transitively emit.av —
// never enters the production compiler graph (mod.av imports the GENERATED file,
// which pulls only the grammar builders, not the emitter).
//
// `emit_decl_parser_file()` returns the COMPLETE module text: a derived import header
// (the grammar builders the generated body calls) +
// `emit_parser_source_ex(assemble_language().decl_dispatch(), true)` (the exported
// static parser fns: parse_declaration / parse_statement + the composed statement +
// expression ladder). Editing the §2 grammars (avra_grammar.av) changes
// this text — run `bash scripts/diagnose.sh --emit-regen-decl` to rewrite the
// checked-in file, then commit it; the guard test fails until you do.

use features.grammar.{assemble_language, emit_parser_source_ex, derived_import_lines}

/// The BANNER of the production declaration static-parser module — provenance
/// comments only. The import header is no longer hand-kept: it derives from
/// the emitted source itself (derived_import_lines, t-47hc.8 generator-owns-
/// imports), so nothing here can drift from what the body references.
export fn gen_decl_parser_header() -> string {
    // RELATIVE imports (features.grammar / core), NOT the absolute `@std.avrac.` form:
    // this is a globbed in-package compiler-src module, and an absolute self-import of
    // the package being built double-expands every @derive/@expand type (F4012) — the
    // same reason gen_expr_file.av documents.
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-decl` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: the §2 declaration/statement/expression grammars in\n" +
    "// features/grammar/avra_grammar.av (avra_decl_flip_grammar). This is the PRODUCTION\n" +
    "// declaration parser under AVRA_PARSER_DECL_STATIC=1 (ps3t.6.7 Phase 2);\n" +
    "// parse/tests/gen_decl_parser_regen_test.av asserts it equals emit_decl_parser_file()\n" +
    "// so a grammar edit that isn't regenerated fails the suite.\n\n"
}

/// The complete text of parse/gen_decl_parser.av: banner + the DERIVED
/// import header (computed from the emitted source — generator-owns-imports)
/// + the exported generated body. Both the regenerator and the guard read
/// from HERE.
export fn emit_decl_parser_file() -> string {
    // The LANGUAGE PIPELINE (language.av): load → compose → build, one
    // call; the declaration dispatch view arrives stamped with the
    // manifest's kind rows.
    let src = emit_parser_source_ex(assemble_language().decl_dispatch(), true)
    gen_decl_parser_header() + derived_import_lines(src, "features.grammar", "core") + "\n" + src
}
