// THE LANGUAGE PIPELINE (t-47hc.8) — the one place the language assembles.
// Four stages, and this file is their spine:
//
//   1. LOAD     language_features() — every feature's self-description
//               (gram + typed lowering + hooks + docs), one factory run.
//   2. COMPOSE  the fragment fns (avra_grammar.av) assemble the engine-core
//               rules + the feature registry into ONE grammar.
//   3. BUILD    build_registry() registers the features (dispatch tables +
//               the builder manifest); the composed grammar is stamped with
//               the manifest's kind rows.
//   4. RUN      the entries drive the built system — the static parsers /
//               the executor over this grammar (parse), then the pass
//               families over the registry (resolve → typeck → codegen,
//               routed through the query engine on the CLI front pipeline).
//
// There is ONE grammar (`full()` — every rule of the language, each defined
// once, deduped by rule_identity). WHERE parsing starts is not a property of
// the grammar: each interpreter entry names its start rule ("declaration",
// "statement", "expression", "type_expr" — executor.av), the way a hand
// parser's entry point is just which function you call — and the parser
// GENERATOR emits this same grammar once into the one checked-in static
// parser (gen_parser_files.av → parse/gen_parser.av), whose per-family
// entries are module-private fns entered by name from the same-module
// static-entry boundaries.
//
// The record is LAZY (the one composition happens on the first ask and is
// shared by every seam — the ps3t.6.5.12 lex-once cost profile); the
// registry itself is cached per NodeStore (parse_features), so
// `language_for(reg)` wraps the cached one and `assemble_language()` builds
// fresh (regen drivers, tools).
use core.{Registry}
use features.{build_registry}
use features.grammar.{Grammar, BuildKindRow, grammar_with_builder_kinds, builder_kind_rows, avra_program_grammar}

export type Language = {
    // Stage 3's dispatch product: tag→hook tables + the builder manifest.
    registry: Registry,
    // The manifest's (name → kind, spanned) projection the grammar is
    // stamped with — computed once per record.
    kind_rows: List<BuildKindRow>,
    // Stage 2+3's parse product, lazy: null until a consumer asks.
    mut full_v: Grammar?,
}

/// Wrap an already-built registry (the per-NodeStore cached one) — the
/// parse layer's constructor. Stages 1+3's registry work happened when the
/// registry was built; this record adds the composed-grammar surface.
export fn language_for(reg: Registry) -> Language {
    Language { registry: reg, kind_rows: builder_kind_rows(reg.builder_binds), full_v: null }
}

/// Build the whole system fresh — stages 1 through 3 in one call. The
/// regen drivers and standalone tools use this; production parsing goes
/// through `language_for(store.parse_features())` so the registry stays
/// program-wide.
export fn assemble_language() -> Language {
    language_for(build_registry())
}

impl Language {
    /// THE grammar — every rule of the language, composed once and stamped
    /// with the builder manifest. All four production interpreter seams run
    /// this one value (parse/mod.av), each entering at its own start rule.
    fn full(self) -> Grammar {
        if self.full_v == null {
            self.full_v = grammar_with_builder_kinds(avra_program_grammar(), self.kind_rows)
        }
        self.full_v ?? avra_program_grammar()
    }

}
