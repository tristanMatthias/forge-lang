// WHY: t-47hc.4.4 Phase 3d (pattern half) — the single source of truth for the
// CHECKED-IN production pattern static-parser module (parse/gen_pat_parser.av). Like
// gen_expr_file.av / gen_decl_file.av / gen_type_file.av this module is NON-PRODUCTION:
// it is imported ONLY by the regenerator (diagnose.sh --emit-regen-pat) and the regen
// guard (parse/tests/gen_pat_parser_regen_test.av), so it — and transitively emit.av —
// never enters the production compiler graph (production imports the
// GENERATED file via static_pat_entry, which pulls only the grammar pattern-builders).
//
// `emit_pat_parser_file()` returns the COMPLETE module text: a fixed import header
// (the pattern-builders the generated body calls) + `emit_parser_source_ex(_, true)`
// (the exported static parser fns, `parse_pattern_or` first). The pattern grammar is
// FEATURE-OWNED (features/match.av, t-47hc.8), so this emitter imports
// avra_pat_grammar from there. Editing that grammar changes this text — run
// `bash scripts/diagnose.sh --emit-regen-pat` to rewrite the checked-in file, then
// commit it; the guard test fails until you do.

use features.match.{avra_pat_grammar}
use features.grammar.{emit_parser_source_ex, builder_import_lines_for, grammar_with_builder_kinds, builder_kind_rows}
use features.{feature_builders}

/// The fixed import header of the production pattern static-parser module: exactly the
/// features.grammar pattern-builders + core types the generated body references. An
/// extra import is only an F9002 warning, but a MISSING one is a hard undefined-symbol
/// error — keep this in lockstep with the pattern build helpers avra_pat_grammar's
/// rules name (OrMaybe → Pattern.Or, IdentPat → ident_pat_bare/Pattern.TypePattern,
/// MkVariant → Pattern.Variant/NestedVariant + param_entries_from_toks, PatBool/PatStr/
/// PatNum/PatNegNum → pat_*_node, OptPresent/OptAbsent → pattern_optional_*). The
/// pattern grammar has NO @hand, so no run_hand* import is needed.
export fn gen_pat_parser_header() -> string {
    // RELATIVE imports (features.* / core), NOT the absolute `@std.avrac.` form the
    // emit-gen-check STANDALONE harness uses: this file is a globbed in-package
    // compiler-src module, and an absolute self-import of the package being built makes
    // the metadata lib build's module graph process the whole package a SECOND time
    // (F4012). The rest of compiler src/ imports relatively for exactly this reason.
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-pat` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: avra_pat_grammar() in features/match.av.\n" +
    "// This is the PRODUCTION pattern parser;\n" +
    "// parse/tests/gen_pat_parser_regen_test.av asserts it equals\n" +
    "// emit_pat_parser_file() so a grammar edit that isn't regenerated fails the suite.\n" +
    "use features.grammar.{Token, CapVal, PState, capval_to_pat, capval_tok_text, pat_num_node, pat_bool_node, pat_str_node, ident_pat_bare, param_entries_from_toks}\n" +
    "use core.{Pattern, PatId, ValueType, Tk, pattern_optional_present, pattern_optional_absent}\n\n"
}

/// The complete text of parse/gen_pat_parser.av: header + the exported generated body.
/// Both the regenerator and the guard read from HERE.
export fn emit_pat_parser_file() -> string {
    let g = avra_pat_grammar()
    let binds = feature_builders()
    gen_pat_parser_header() + builder_import_lines_for(g, binds)
        + emit_parser_source_ex(grammar_with_builder_kinds(g, builder_kind_rows(binds)), true)
}
