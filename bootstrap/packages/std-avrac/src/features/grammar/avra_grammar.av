// WHY: ps3t.6.5.11 — Avra's grammar, DOGFOODED into compiler `src/` as an
// actual `grammar { … }` surface-syntax block (design §2.5), out of the test
// strings it used to live in. This is the single source of truth the whole
// migration consumes: the executor runs it as the differential oracle
// (parser_equivalence_test), and emit.av RENDERS it as the generated static
// parser (emit_generated_test, diagnose.sh --emit-gen-check). Centralising it
// here (rule 8) retires the duplicated grammar strings those consumers carried.
//
// SEED-GATED, and the gate is already OPEN: the `grammar { }` surface parser
// (ps3t.6.5.1) has been in the pinned seed since well before v245, so this
// block compiles from the seed with no cycle — verified before landing. The
// block desugars to a runtime `parse_grammar(<body>)` call (features/grammar/
// parser.av), so it needs no new AST node and emits identical IR.
//
// This is the §2 EXPRESSION family — the proof slice. Statements, patterns,
// types, and declarations join it here as their families migrate (§2.5's
// family-by-family strategy), building toward the 6.5.12 swap-in.

use features.grammar.{parse_grammar, grammar_checked, Grammar, compose_grammars, compose_fragments}
use features.match_expr.{avra_pat_grammar, avra_match_arm_grammar, avra_match_table_grammar}
// t-47hc slice 9 — the DECL-keyword grammar fragments, each owned by the feature
// that owns the keyword (the same colocation `match_expr` already has for
// patterns). Imported here rather than assembled in features/mod.av because this
// file is where the whole-program grammar is composed; features/mod.av's
// `feature_grammar_fragments` re-exports the same list, so there is ONE
// definition of "which features contribute decl fragments".
use features.fn_decl.{avra_fn_decl_grammar}
use features.struct_decl.{avra_struct_decl_grammar}
use features.enum_decl.{avra_enum_decl_grammar}
use features.trait_decl.{avra_trait_decl_grammar}
use features.impl_decl.{avra_impl_decl_grammar}
use features.modules.{avra_modules_grammar}
// t-47hc slice 10.3 — `tparam`, shared by every generic decl keyword.
use features.generics.{avra_generics_grammar}

/// The canonical §2 Avra expression grammar as a `grammar { }` block. The DSL
/// owns the DECLARATIVE operator-precedence ladder (logical → bitwise → shift →
/// comparison → additive → multiplicative), folding left-associatively via the
/// build helpers, AND the `!` `-` `not` prefix-unary operators directly, via the
/// `Unary` build (Phase 3a leaf migration, Option B). `not` is safe to own here
/// because it has NO context overload — it is logical `Not` at every quote depth.
/// Phase 3a-4 gives the grammar the POSTFIX CHAIN + the `with` postfix: `unary`'s
/// non-prefix branch is
/// `base:@hand(primary_base) ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )*
///  -> fold_postfix_with(base, p, s)`. The grammar OWNS the postfix loop as
/// `( postfix_suffix )*`: each `postfix_suffix` (→ `parse_postfix_suffix`) runs ONE
/// hand `postfix_step` over the base threaded on PState (`postfix_base`), so the 8
/// interleaving forms (call / `[index]` / `?` / `!` / `?.` / dot / generic-call /
/// `catch`) share the hand loop body byte-for-byte; a step that consumes nothing ends
/// the chain (the emitted loop's no-progress break). `fold_postfix_with` takes the
/// final postfix node then folds the `with` suffixes over it, each rebuilt with the
/// hand `alloc_at`'s `[base-start, next-token)` span. `primary_base` (→ `parse_primary_
/// base` = `parse_leaf_common(false)`) is the splice/prefix + `parse_primary` base
/// WITHOUT the postfix loop. `~` is CONTEXT-OVERLOADED: at `quote_depth == 0` it is the
/// bitwise-NOT prefix, grammar-owned via a `@when(at_quote_top)` branch (Phase 3a-5) →
/// `Unary(BitNot, …)`; at `quote_depth > 0` it is the quote SPLICE, and the production
/// static parser DOES run inside a `quote` body (hand `parse_quote` bumps `quote_depth`
/// then re-enters `parse_expression`, which stays on the static path), so the `@when`
/// fails there and `~`/splice falls through to `@hand(primary_base)` (`parse_leaf_common`
/// reads `quote_depth`). `@when(at_quote_top)` (`modes_flag`/`pred_guard`, executor+emit
/// lockstep) is the grammar-native mode gate (#954) that makes the split byte-identical.
/// Phase 3a-7 gives the grammar the single-token LITERAL primaries as the postfix-loop
/// BASE: `b:NUMBER` / `b:STRING` / `b:BOOL` / `b:("null"|"none")` branches sit BEFORE the
/// `@hand(primary_base)` tail (each `b:<lit> ( postfix_suffix )* ( with_suffix )* ->
/// fold_postfix_with(b,p,s)`), so `is_leading_hand` stays true and `@hand` still owns error
/// recovery. The token base is seeded into the postfix loop via `seed_postfix` (exec_seq /
/// emit lockstep) and built by `literal_node` (interning, matching hand `alloc_leaf`).
/// `postfix_suffix` and `with_suffix` are each a single delegate rule around their
/// stateful hand step; every base references those rules, so the remaining frontier is
/// represented once instead of duplicated across all 19 FIRST-disjoint primary
/// alternatives. Both loops stay `( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )*` at every
/// base, so the shape is unchanged — only the duplication is gone, and nativizing
/// either step is now a ONE-LINE edit to its delegate rule instead of 19 edits.
/// `Tk.Float` projects to the `NUMBER` kind (its lexeme keeps the dot), so the `NUMBER`
/// branch owns floats too; `null`/`none` are keyword tokens (no distinct grammar kind) so
/// they use a string-alternation terminal and `literal_node` builds `Expr.None` by `tk`.
/// `parse_unary` / `parse_call` / `parse_primary` are retained as the differential oracle
/// (Option B — no deletion). That leaf is NOT expressible in the stateless
/// token-grammar byte-identically: `parse_call`'s
/// postfix loop is newline-sensitive (`.UpperIdent`/`[`/`(` on a new line = a new
/// statement) and mode-stateful (`allow_struct_lit`, `allow_dot_postfix`,
/// `allow_it_sugar`, `quote_depth`), so the @hand escape hatch (GRAMMAR_DSL.md §5)
/// is the correct — and byte-identity-preserving — home for it (ps3t.6.7 Step C).
///
/// avra_expr_core is the RULE SET (the emit view via avra_expr_dispatch_grammar); the
/// INTERPRETER view (avra_expr_grammar) composes the type family so paren_expr's typed-lambda
/// `param -> type_expr` resolves in-grammar. (t-47hc.16 paren flip: `paren_expr` replaced the
/// `@hand(paren_expr)` leaf — the hand parse_paren_expr is deleted.)
fn avra_expr_core() -> Grammar {
    let gp = grammar {
  expression    = assignment
  // `@onfail(bail)` on the LHS is the exact mirror of the hand's
  // `let left = self.parse_pipe()?` (parse/mod.av:1673). Without it a FAILED left operand
  // was still built on: `if let = x { 1 }` reported the missing binding name, then
  // `assignment` consumed the `=`, parsed the rest of the fn body as an RHS ("expected
  // }"), and `mk_assign_expr` added "invalid assignment target" on top — three
  // diagnostics where the hand emits one. `bail` keys on the sub-parse FAILING, not on it
  // reporting, which is required: `let a = (1) ->` reports and still yields `(group 1)`,
  // a value the hand keeps.
  assignment    = @onfail(bail) l:pipe ( "=" r:assignment )? -> mk_assign(l, r)
  pipe          = l:null_coalesce ( "|>" r:pipe_arg )* -> fold_pipe(l, r)
  pipe_arg      = @on(allow_it_sugar) logic_or
  null_coalesce = l:logic_or ( op:("??") r:logic_or )* -> fold_nullish(l, op, r)
  logic_or      = l:logic_and ( op:("||" | "or") r:logic_and )* -> fold_logical(l, op, r)
  logic_and     = l:equality ( op:("&&" | "and") r:equality )* -> fold_logical(l, op, r)
  equality      = base:bitor ( tail:eq_tail )? -> rebind_eq(base, tail)
  eq_tail       = "is" "." v:IDENT -> mk_is(v)
                | "in" ir:in_rhs -> ir
                | ( op:("==" | "!=") r:bitor )+ -> mk_eqchain(op, r)
  in_rhs        = "[" ( a:expression ( "," a:expression )* )? "]" -> mk_inlist(a)
                | s:bitor ".." e:bitor -> mk_inrange(s, e)
  bitor      = l:bitxor ( op:("|") r:bitxor )* -> fold_binary(l, op, r)
  bitxor     = l:bitand ( op:("^") r:bitand )* -> fold_binary(l, op, r)
  bitand     = l:comparison ( op:("&") r:comparison )* -> fold_binary(l, op, r)
  comparison = l:shift ( op:("<" | "<=" | ">" | ">=") r:shift )* -> fold_binary(l, op, r)
  shift      = l:term ( op:("<<" | ">>") r:term )* -> fold_binary(l, op, r)
  term       = l:factor ( op:("+" | "-") r:factor )* -> fold_binary(l, op, r)
  factor     = l:unary ( op:("*" | "/" | "%") r:unary )* -> fold_binary(l, op, r)
  unary      = op:("!" | "-" | "not") operand:unary -> Unary(op, operand)
             | @when(at_quote_top) op:("~") operand:unary -> Unary(op, operand)
             | @when(in_quote_body) @peek(tilde_ident_lbrace) @when(allow_struct_lit) "~" n:IDENT "{" ( @onfail(bail) f:field_init )* "}" -> MkSpliceStruct(n, f)
             | @when(in_quote_body) "~" t:unary -> MkSplice(t)
             | b:NUMBER ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | b:STRING ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | b:BOOL ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | b:("null" | "none") ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | base:variant_ctor ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:match_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:if_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:spawn_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:channel_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:isolated_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:when_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(quote_arm) base:quote_arm_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(quote_type) base:quote_type_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:quote_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:list_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:brace_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:qualified_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:paren_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:template_lit ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_lbrace_feature) base:grammar_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_lbrace_feature) base:table_lit ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_lbrace_plain) @when(allow_struct_lit) base:struct_lit_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_template) base:tagged_template ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_plain) b:IDENT ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
  // t-myz7 — the `grammar { … }` feature block, native. This is `@rawbrace`'s canonical
  // consumer (ast.av:322 gives this exact rule as the marker's example): the body is NOT
  // Avra syntax, so it is captured verbatim and handed to the runtime engine as a string.
  //
  // Byte-for-byte the hand's `parse_grammar_block` (features/grammar/parser.av), which is
  // only ever `{` + `capture_balanced_brace_body` + `}` + build-the-desugared-call —
  // and `@rawbrace` IS that capture, sharing `rawbrace_scan` with the hand rather than
  // re-deriving the depth count.
  //
  // The `@peek(ident_lbrace_feature)` gate is the REGISTRY check, not a keyword test: the
  // hand reaches this through `lookup_expr_parser(self.features, name)`, so a program that
  // has not registered the feature must still read `grammar` as an ordinary identifier.
  // The gate asks the same registry, through `PState.hand_delegate`'s `.features`. Pairing
  // it with the leading `"grammar"` literal is what keeps the sibling feature form
  // (`table { … }`, which the same cond also admits) out of this branch.
  grammar_expr = "grammar" "{" body:@rawbrace(grammar) "}" -> MkGrammarBlock(body)
  // t-myz7 — the `table [<Row>] { … }` literal, the LAST valid input in the compiler
  // that reached a production `@hand` leaf. Unlike `grammar { … }` this is not a raw
  // capture: the hand's `parse_table_literal` (parse/mod.av:1284) parses a header row
  // then data rows, and is LINE-SENSITIVE, so it needs a real rule.
  //
  // Split into three rules because the ROW build needs the header's column names, and a
  // build only fires when its rule completes: `table_head` finishes (and pushes the
  // TableCtx) before the first row is parsed.
  //
  // `^` is the line bound. `sameline_ok` compares the previous token's line to the
  // current one, which is the executor mirror of the hand's `current_line == row_line`;
  // a `^`-gated item inside `( … )*` fails on the next line's first token and so ENDS
  // the repetition there. The FIRST header ident is deliberately NOT `^`-gated: the hand
  // sets `header_line` from the token AFTER `{`, so a header on the line below the brace
  // is legal. The `|` separators are ungated for the same reason — the hand consumes a
  // pipe unconditionally, checking the line only before each IDENT.
  //
  // `bitxor` IS the hand's `parse_binary_pratt(12)`: emit lowers the ladder with
  // `lbp = 10 + 2*index` and `bitor = 10`, so entering at bitxor stops before `|` and
  // the column separator is never eaten as a bitwise-or operand.
  // Both sub-rules are `@onfail(bail)`: a header with a duplicate column and a row whose
  // width disagrees with the header are reported by their BUILDS (mk_table_header /
  // mk_table_row), and the hand answers either with `return .Err("parse error")` — which
  // leaves the table's `}` UNCONSUMED. That matters beyond the table: the enclosing fn's
  // statement list then takes the `}` as its own closer, `0` becomes a top-level
  // statement, and the function's real `}` is the hand's second diagnostic
  // (F0013 `unexpected }`). Without the bail the repetition merely ended, `"}"` below
  // consumed the brace, and that whole tail — a diagnostic and two statements' placement
  // — was silently different.
  table_lit  = "table" @onfail(bail) table_head ( @onfail(bail) rows:table_row )* "}"
               @expect("}", "expected `}` to close table") -> MkTableLit(rows)
  table_head = ( "<" rt:IDENT ">" )? "{" ( h:IDENT ( "|" )? ( ^h:IDENT ( "|" )? )* )?
               @expect(">", "expected `>` after table row type")
               @expect("{", "expected `{` to open table") -> MkTableHeader(rt, h)
  // `@on(cell_mode)` is a PER-ITEM marker, so it must be repeated on the loop's cell:
  // the hand sets `self.cell_mode = true` around the WHOLE row loop, and without this
  // cells 2..N parse with cell_mode OFF. `parse_binary_pratt_g_id` only refuses a
  // cross-line `+`/`-` while cell_mode is set, so the last cell of a multi-column row
  // could otherwise take the NEXT row's leading sign as a binary operand.
  table_row  = @on(cell_mode) v:bitxor ( ^"|" ^@on(cell_mode) v:bitxor )* -> MkTableRow(v)
  struct_lit_expr = n:IDENT "{" ( @onfail(bail) f:field_init )* "}" -> MkStructLit(n, f)
  tagged_template = n:IDENT t:TEMPLATE -> MkTaggedTemplate(n, t)
  // The segment name after `::` is `@require`d: unrequired it reported a bare
  // "expected IDENT" and PARSED ON, so `@pkg::mod::name` — where `mod` is a keyword, not
  // an identifier — left the cursor on `mod` for the declaration dispatch to pick up and
  // added "expected module name after `mod`" on top of the hand's single message.
  qualified_expr = "@" n:IDENT ( @peek(double_colon) ":" ":" @require s:IDENT )+
                   ( @when(allow_struct_lit) lb:"{" ( @onfail(bail) f:field_init )* "}" )?
                   @expect("IDENT", "expected identifier after `::` in qualified reference")
                   @expect("+", "expected `::` after the package name — a qualified reference is `@pkg::mod::name`; `@name` alone is annotation syntax")
                   @expect("}", "expected `}` after struct fields") -> MkQualExpr(n, s, lb, f)
  template_lit = t:TEMPLATE -> MkTemplate(t)
  brace_expr   = @peek(brace_map) map_literal | block_expr
  // The VALUE propagates, like `field_init`'s: `{ "a": , … }` built a map entry over an
  // error node where the hand aborts the literal and its enclosing fn.
  map_literal  = "{" ( k:expression @require ":" @onfail(bail) v:expression ( "," )? )* @require "}"
                 @expect(":", "expected `:` after map key")
                 @expect("}", "expected `}` after map") -> MkMapLit(k, v)
  // t-47hc.33 — the postfix chain, going native one FORM at a time. `@hand(postfix_suffix)`
  // stays the TAIL alternative until all eight are grammar-owned, so it keeps the
  // unguarded error-recovery role (t-47hc.31) and every form not yet flipped still runs
  // the hand code verbatim. `--hand-leaves` therefore moves only on the commit that
  // deletes the delegate, not on the intermediate ones.
  //
  // A native form reproduces the hand ENTRY GUARD exactly (postfix_step, parse/mod.av):
  // token + same-line (`^`) + mode reads. Where the hand guard is WEAKER inside the body
  // than at entry — it re-dispatches on the current token after the leading `!` loop has
  // consumed, without re-testing same-line or dot_is_postfix — the delegate tail still
  // covers that compound case, because a native alternative whose guard fails simply
  // falls through to it.
  postfix_suffix = @when(allow_dot_postfix) ^"!" -> MkForceUnwrap()
                 | @when(allow_dot_postfix) ^"?" -> MkTrySuffix()
                 | c:"catch" ( "(" @require b:IDENT @require ")" )? @require "{"
                   @on(allow_dot_postfix) body:declaration* @require "}"
                   @expect("IDENT", "expected error binding name after `catch (`")
                   @expect(")", "expected `)` after catch binding")
                   @expect("{", "expected `{` after catch")
                   @expect("}", "expected `}` after catch body") -> MkCatchSuffix(c, b, body)
                 | @peek(qdot_method_call) "?." n:FIELDNAME "(" @on(allow_it_sugar) ( @onfail(bail) a:call_arg ( @peek(comma_not_rparen) "," @onfail(bail) a:call_arg )* ( "," )? )? @require ")" @expect(")", "expected `)` after arguments") -> MkOptMethodCall(n, a)
                 | @peek(qdot_plain_field) "?." n:FIELDNAME -> MkOptChain(n)
                 | @peek(dot_enum_ctor) @when(base_upper_ident) @when(dot_postfix_ok) "." n:FIELDNAME "(" ( @onfail(bail) a:call_arg ( @peek(comma_not_rparen) "," @onfail(bail) a:call_arg )* ( "," )? )? @require ")" @expect(")", "expected `)` after arguments") -> MkEnumCtorSuffix(n, a)
                 | @peek(dot_plain_field) @when(dot_postfix_ok) "." n:FIELDNAME -> MkFieldAccess(n)
                 | ^"[" i:expression t:index_tail -> MkIndexSuffix(i, t)
                 | @peek(dot_number) @when(dot_postfix_ok) "." t:NUMBER -> MkTupleIndex(t)
                 // A `.` that starts a postfix step but COMPLETES none. Every `.`-led branch
                 // above is @peek-gated on a valid field name, so `a.` (trailing dot, or a dot
                 // followed by anything unusable) satisfies none of them. The hand has no such
                 // gate — its entry guard is `Tk.Dot && dot_is_postfix` alone, so it ENTERS its
                 // `.` arm and `consume_field_name` reports. While `@hand(postfix_suffix)` was
                 // the tail that difference was invisible; without it NO branch owns the
                 // diagnostic and the stray `.` is re-read at statement level (emit F0001 vs
                 // the hand's F0040, and a different recovery tree). @fallback makes this the
                 // unguarded last native `.` branch, exactly as index_tail's `]` branch owns
                 // the message for a token that starts neither of ITS forms.
                 | @fallback @when(dot_postfix_ok) "." @require n:FIELDNAME @expect("FIELDNAME", "expected field name after `.`") -> MkFieldAccess(n)
                 | ^"(" @on_if(base_field_access, allow_it_sugar) ( @onfail(bail) a:call_arg ( @peek(comma_not_rparen) "," @onfail(bail) a:call_arg )* ( "," )? )? @require ")" @expect(")", "expected `)` after arguments") -> MkCallSuffix(a)
                 | @try @when(base_callable) "<" ( ta:type_expr ( "," ta:type_expr )* )? ">" "(" ( @onfail(bail) a:call_arg ( @peek(comma_not_rparen) "," @onfail(bail) a:call_arg )* ( "," )? )? ")" -> MkGenericCallSuffix(ta, a)
  call_arg = @on(allow_dot_postfix) e:expression -> MkCallArg(e)
  // The `f<T>(args)` branch is the ONE speculative form in the chain, and every marker on
  // it is chosen against try_parse_generic_call (features/generics/parser.av) rather than
  // against its `(`-led neighbour:
  //   `@try` and NO `@cut`. `<` is also the comparison operator, so the branch must be
  //     able to un-decide: `a < b` is not a generic call. The hand backtracks on EVERY
  //     failure past the `<` — a type list that doesn't close, a missing `(`, a bad arg
  //     list, a missing `)` all hit the same `restore_state` — so there is no point at
  //     which it owns its diagnostics, and a `@cut` would invent one. Placing a cut after
  //     `">" "("` reads as the natural commit point and is exactly the divergence to
  //     avoid: it would report on `f<int>(` + garbage where the hand rolls back and lets
  //     the tokens re-read as a comparison chain. A rolled-back `@try` falls through to
  //     the `@hand` tail, which re-runs the same hand code and reaches the same answer.
  //   No `@require` / `@expect` for the same reason: inside a `@try` before a cut they
  //     degrade to plain reporting (the rollback already IS the abort), so they would be
  //     dead markers that only suggest a commit point exists.
  //   No `^`. The `[` and `(` branches are same-line gated; the hand's `Tk.Less` arm is
  //     not (`check(Tk.Less) && is_callable(result)` is the whole entry guard), so adding
  //     one here would reject a line-broken turbofish the hand accepts.
  //   `@when(base_callable)` is the `is_callable(result)` conjunct — Ident, QualifiedIdent
  //     or FieldAccess. It reads the folded BASE, not a mode, which is why it is a
  //     base_pred (executor.av) shared by both engines rather than a modes_flag.
  //   The type list is OPTIONAL as a whole: parse_type_name_list returns early on `>`, so
  //     `f<>(x)` parses, and a bare `ta:type_expr ( "," ta:type_expr )*` would reject it.
  //   No `@on_if(base_field_access, allow_it_sugar)`. The plain-call branch carries it
  //     because parse_postfix's `(` arm sets `allow_it_sugar = is_method || saved_it`;
  //     try_parse_generic_call never touches the mode, so the sugar must stay at whatever
  //     the enclosing context already had. `call_arg` is still the right body — the hand
  //     reaches the same arg list through parse_arg_list_ids, which sets allow_dot_postfix
  //     and leaves the it-wrap to the same `allow_it_sugar` read mk_call_arg performs.
  // FIELDNAME, not IDENT, in every field-name position (t-47hc.33.1). `consume_field_name`
  // accepts a reserved-but-inactive keyword as well as an identifier, so `x.ref` /
  // `x?.owned` / `Type.move(1)` are legal field access the hand has always parsed. The DSL
  // could not spell that set: `IDENT` is `Tk.Identifier` alone (too narrow) and the coarse
  // `KW` kind is EVERY keyword (far too wide, and it would swallow `x.if`, which the hand
  // rejects). `FIELDNAME` reads the shared `tk_is_field_name` — the hand's own predicate —
  // in the executor, and lowers to the same Tk pair in emit. Widening these four branches
  // is what lets the `@hand(postfix_suffix)` tail go: until it landed, every `.`-led native
  // branch declined on a reserved-keyword field and the delegate silently covered for it.
  // MARKER ORDER IS LOAD-BEARING on the two `.`-led branches. `.field` and `.0` share a
  // FIRST token, and the ambiguity guard exempts a pair only when the earlier branch LEADS
  // with `@peek` — first_follow.seq_is_peek_led inspects `items[0].prim` and nothing else.
  // Both guards are zero-width and ANDed, so `@peek @when` and `@when @peek` accept exactly
  // the same inputs; only the first spelling tells the guard the overlap is resolved by
  // LOOKAHEAD (which partitions the input) rather than by ambient state (which does not).
  // Two sequences because the closing `]` message differs by whether a `..` was seen and
  // `@expect` keys on the token. Dispatch is on `..` (FIRST), not speculation — the hand
  // parses the index expression exactly once. The `]` branch is `@fallback` so it owns
  // the message for a token that starts NEITHER (`a[1 2]`).
  index_tail  = ".." e:expression @require "]" @expect("]", "expected `]` after slice") -> e
              | @fallback @require "]" @expect("]", "expected `]` after index") -> MkNone()
  // At least ONE field: the hand's `parse_field_init_list` opens with
  // `consume_identifier("expected field name")?`, so `a with { 1 }` is an ERROR there.
  // A `@peek`-gated `*` made it optional instead — the loop took zero iterations, `with`
  // succeeded with no overrides, and `{ 1 }` fell out as a separate block statement with
  // NO diagnostic at all. A zero-match `+` fails the rule, which is exactly the hand's
  // behaviour.
  with_suffix = "with" @require "{" ( @onfail(bail) f:field_init )+ @require "}" @expect("{", "expected `{` after `with`") @expect("+", "expected field name") @expect("}", "expected `}` after struct fields") -> MkWithSuffix(f)
  // The VALUE propagates, mirroring `parse_expression()?` in the hand's
  // `parse_field_init_list` (features/struct_decl/parser.av:154) — a failed value aborts
  // the whole literal. Unrequired, `T { x: }` built `(struct T (x=(error)))`, a literal
  // asserting a field was initialised, instead of taking out the literal, the binding and
  // the enclosing fn as the hand does. The NAME cannot carry `@require`: it is the
  // sequence's leading item and therefore the FIRST-set guard, which the DSL rejects
  // outright — and it needs no guard, since the rule is only entered when that FIRST holds.
  field_init  = n:IDENT ( ":" @onfail(bail) v:expression )? ( "," )? -> MkFieldInit(n, v)
  variant_ctor = "." @require v:IDENT ( "(" ( a:expression ( "," a:expression )* )? @require ")" )?
                 @expect("IDENT", "expected a variant name after `.`", F0040)
                 @expect(")", "expected `)` after arguments") -> mk_enum_ctor(v, a)
  channel_expr = "channel" "<" elem:type_expr ">" "(" ( cap:expression )? ")" -> MkChannel(elem, cap)
  // t-bwjg — `quote { … }` and the block-bodied kinds. `quote type { <type> }` and
  // ALL THREE quote shapes are native now: this rule owns the block-bodied kinds, while
  // @peek(quote_type)/@peek(quote_arm) route the two whose body is not a block —
  // a TypeLit carrier and a synthetic single-armed MatchExpr envelope respectively.
  // @bump(quote_depth) reproduces the hand's bump/restore around the body, which is
  // what the already-native splice branches (@when(at_quote_top) / @when(in_quote_body))
  // read — so a NESTED quote still sees the right depth.
  // `quote type { <type> }` — native as of slice 4b. @bump wraps the TYPE parse so a
  // splice inside it (`quote type { ~T }`, quote_splice_type_ident_test) still sees a
  // nonzero depth; the braces themselves do not care.
  // Every mandatory terminal is `@require`d with the hand's exact wording. Unrequired,
  // a missing `{` reported a generic "expected {" and the rule CARRIED ON — parsing an
  // empty type and then reporting the missing `}` too, so `quote type` alone came out
  // three diagnostics where `parse_quote_type_body` reports one and returns `.Err`.
  // (Invisible until `let` routed: the initializer's `@try` rolled the whole item back
  // to the hand, which owned the message.)
  quote_type_expr = "quote" "type" @require lb:"{" @require @bump(quote_depth) t:type_expr @require "}"
                    @expect("{", "expected `{` after `quote type`")
                    @expect("type_expr", "expected a type inside `quote type { ... }`")
                    @expect("}", "expected `}` after the type in `quote type`") -> MkQuoteType(lb, t)
  // `quote arm { pat (if guard)? -> body ,? }` — the last quote shape, native as of
  // slice 4b. `pattern_or` is the same rule the match families use; the trailing comma
  // is optional exactly as parse_quote_arm_body allows it.
  // Same treatment as quote_type_expr, and the pattern position is the same shape as
  // its type position: `@require` under the `@bump`, so a missing pattern aborts with
  // the hand's `parse_pattern_or()?` message instead of reporting a generic F0040 and
  // then the missing `->` on top of it.
  quote_arm_expr = "quote" "arm" @require lb:"{" @require @bump(quote_depth) p:pattern_or ( "if" g:expression )? @require "->" b:expression ( "," )? @require "}"
                   @expect("{", "expected `{` after `quote arm`")
                   @expect("pattern_or", "expected `.`, `_`, literal, or type pattern to start pattern")
                   @expect("->", "expected `->` after pattern in quote arm")
                   @expect("}", "expected `}` after quote arm body") -> MkQuoteArm(lb, p, g, b)
  quote_expr   = "quote" ( k:("stmt" | "stmts" | "decl") )? @bump(quote_depth) body:block_expr -> MkQuote(k, body)
  spawn_expr   = "spawn" body:block_expr -> MkSpawn(body)
  isolated_expr = "isolated" body:block_expr -> MkIsolated(body)
  block_expr   = "{" @on(allow_dot_postfix) stmts:declaration* "}" -> MkExprBlock(stmts)
  when_expr    = "when" "{" ( a:when_arm )* "}" -> MkWhen(a)
  // t-47hc.25 — the EXPRESSION `match`, mirroring the already-native match_stmt. Same
  // three shapes, same gates, all of them already proven on the statement side:
  //   1. SUBJECTLESS `match { … }` builds Expr.When — the very node when_expr above
  //      builds — so it reuses MkWhen. Its arms are match_when_arm, NOT when_arm: the
  //      hand parse_when_arm_list takes `_` as the ONLY default, never `else`.
  //   2. The TABLE sub-language is GRAMMAR-NATIVE as of t-47hc.29. It was long recorded
  //      here as "@hand BY NATURE — data-dependent and not a grammar rule at any level of
  //      DSL power"; that was wrong. The row width is a BOUND, not a computation, and
  //      `x{#cap}` expresses it. `@peek(match_table)` still peels the form off, but the
  //      branch now names `match_table_expr` (features/match_expr/grammar.av) instead of
  //      a hand leaf. Its statement twin is `match_table_stmt`; both share one builder
  //      helper, so the two forms cannot drift.
  //   3. The ordinary form is PREDICTIVE (table already peeled) and owns both of its
  //      diagnostics via @require + @expect — exactly what the hand does with
  //      `consume(...) else return .Err`.
  // match_arm / match_when_arm are EXTERNAL here: they are defined once in the shared
  // fragment, emitted into the declaration parser, and called across the merged `parse/`
  // module namespace (like parse_pattern_or). Their FIRSTs are declared in
  // emit.rule_first_guard.
  match_expr   = @peek(match_subjectless) "match" "{" ( a:match_when_arm ","? )* @require "}" @expect("}", "expected `}` after match arms") -> MkWhen(a)
               | @peek(match_table) match_table_expr
               | "match" @off(allow_struct_lit) subj:expression @require "{" ( arms:match_arm ","? )* @require "}" @expect("{", "expected `{` after match subject") @expect("}", "expected `}` after match arms") -> MkMatchExpr(subj, arms)
  // t-47hc.24 — the EXPRESSION `if`. The bind-fresh `if let v = x { … }` stays @hand:
  // it is not a parse at all but a DESUGARING (a fresh temp, a none-check condition, and
  // an unwrap-bind row PREPENDED to the then-block), so `@peek(if_let)` peels it off at
  // the `if` and hands the whole leaf over — the same shape match_expr uses for its
  // table form. The ordinary branch is then PREDICTIVE on a bare `if`.
  //
  // `@require t:block_expr` is the first production spend of @require on a RULE
  // REFERENCE: the hand reports "expected `{` after if condition" and `return .Err`s,
  // and the marker checks block_expr's FIRST (`{`) BEFORE the call, so an ABSENT block
  // aborts while a MALFORMED one recovers — which is exactly the hand's split.
  //
  // else_tail must keep `if_expr` as its own FIRST branch rather than folding into
  // `expression` (which already reaches if_expr via unary). Measured, not assumed:
  // `else if b { 2 }.foo` parses as `(field (if-expr …) foo)` — the postfix binds to the
  // OUTER if, because the hand's `else if` RECURSION returns from parse_if_expression
  // directly. Routing the else through `expression` would enter unary's
  // `base:if_expr ( postfix_suffix )*` and bind `.foo` to the ELSE-IF instead.
  // `block_expr` likewise cannot fold in: brace_expr peeks brace_map first, so
  // `else { "a": 1 }` would become a MAP where the hand calls parse_block_expression
  // unconditionally.
  // t-47hc.26 — the bind-fresh form goes native, spending `@gensym`. It is a DESUGAR,
  // not a parse: `build_if_let_expr` (core/arena.av) turns it into a temp binding, a
  // none-check condition, and an unwrap-bind row prepended to the then-block. That
  // builder is SHARED with the hand's parse_if_let_expression — the same rows in the
  // same order — so the two cannot drift in what they lower to.
  //
  // `tmp:@gensym(iflet)` sits between `"if"` and `"let"` because that is exactly where
  // the hand mints (`parse_if_let_header`'s first line, after parse_if_expression has
  // advanced past `if`). Position is load-bearing, not cosmetic: a build-minted temp
  // would number a NESTED `if let` before its parent, inverting the hand's order.
  //
  // The three `@require`s are the hand's three `return .Err` points, in order —
  // consume_identifier for the binding, consume(Equal), and the `{` check. An ABSENT
  // piece aborts the whole leaf, which is what the hand does; a MALFORMED subject or
  // block still recovers inside its own rule.
  if_expr      = @peek(if_let) "if" tmp:@gensym(iflet) "let" @require b:IDENT @require "="
                 @off(allow_struct_lit) s:expression @require t:block_expr ( "else" e:else_tail )?
                 @expect("IDENT", "expected a binding name after `if let`")
                 @expect("=", "expected `=` after the `if let` binding")
                 @expect("{", "expected `{` after the `if let` binding", F0010) -> MkIfLet(tmp, b, s, t, e)
               // The condition is `@onfail(bail)`: a condition that FAILED means there is no
               // `if` to finish, and the hand's `parse_expression()?` says so by propagating.
               // Without it `else if` with nothing after it reported the missing condition
               // (F0040) and then went on to report the missing block too — two diagnostics
               // where the hand emits one.
               | "if" @onfail(bail) @off(allow_struct_lit) c:expression @require t:block_expr ( "else" e:else_tail )?
                 // F0010 `ExpectedBlock`, matching the hand (`DiagCode.ExpectedBlock`) AND the
                 // statement view's twin below. The expression view carried an uncoded
                 // `@expect` and so rendered F0001 — invisible while `let`'s dispatcher-level
                 // `@try` rolled `let v = if { 1 }` back to the hand, which owned the code.
                 @expect("{", "expected `{` after if condition", F0010) -> MkIfExpr(c, t, e)
  else_tail    = if_expr | block_expr | expression
  when_arm     = ( "_" | "else" ) "->" body:expression -> MkWhenDefault(body)
               | cond:expression "->" body:expression -> MkWhenArm(cond, body)
  // PREDICTIVE, by the same scan `paren_expr` uses. The `@try` rewound the cursor to
  // before `[`, so a malformed comprehension failed the list-LITERAL branch's closer with
  // the cursor sitting ON `for`, and statement-level resync then parsed a for-LOOP out of
  // the leftovers — `[a for]` came back as two `(error)` rows and a `(for-in …)` against
  // the hand's one. The hand never gets there: `parse_list_elements` CONSUMES `for` before
  // aborting, so its resync starts after it. Control that isolates it: `[a while]` and
  // `[a return]` already agreed on both parsers, because only `for` is a token the hand
  // had already eaten.
  list_expr    = @peek(list_comp_ahead) "[" @require cb:list_comp @require "]"
                 @expect("list_comp", "expected a comprehension body")
                 @expect("]", "expected `]` after list") -> cb
               | "[" ( a:expression ( @peek(comma_not_rbracket) "," a:expression )* ( "," )? )? @require "]"
                 @expect("]", "expected `]` after list") -> MkListLit(a)
  list_comp    = b:expression "for" @require v:IDENT @require "in" c:expression ( "if" f:expression )?
                 @expect("IDENT", "expected variable name after `for`")
                 @expect("in", "expected `in` after loop variable") -> MkListComp(b, v, c, f)
  // A FAILED param ends the lambda. `param` already reports "expected parameter type
  // after `:`" and aborts, and the MESSAGES matched exactly — but the branch built
  // `(lambda () x)` around the aborted param anyway, dropping it silently where the hand
  // yields `(error)`. A message-only probe calls that agreement; only the TREE shows it.
  // `paren_lambda_ahead` guards the TYPED branch too, for the same reason it guards the
  // untyped one: `(x: int) ->` with no body must come back `(error)` like the hand's
  // `try_lambda_body()` returning null, not `(lambda (x:int) (error))`. The scan is
  // token-level, so a typed parameter list is no different to it.
  paren_expr   = @peek(lparen_ident_colon) @peek(paren_arrow_ahead) "(" @onfail(bail) ps:param ( "," @onfail(bail) ps:param )* ")" "->" lb:lambda_body -> MkLambdaTyped(ps, lb)
               // PREDICTIVE, by a SCAN — the non-speculative decision this branch needed
               // (t-47hc.5). `paren_lambda_ahead` walks to the matching `)` and checks two
               // tokens: an `->` follows, and the token after it is in the shared
               // expression FIRST set (`tok_starts_expr_leaf`, which admits `{`, so
               // `lambda_body`'s two alternatives are covered by one predicate).
               //
               // `let a = (1) ->` with no body therefore never ENTERS here: the token
               // after `->` cannot start a body, so the group branch answers and yields
               // `(group 1)` with the `->` left for the caller — the hand's
               // `try_lambda_body()` returning null, reached without imitating its
               // speculation. This is what let `let` route.
               //
               // Deciding it by PARSING is the trap, and both obvious spellings fall into
               // it: dropping the `@cut`, and `@require lb:lambda_body`. Inside a `@try`
               // the emitted `@require` reports without aborting (emit.av's `abortable`
               // guard), and the `@cut`'s own `if !s_cut { break }` is what otherwise
               // stops a plain group before the body parse. Without that early exit every
               // parenthesised group parses the whole remaining expression and unwinds,
               // which nesting multiplies — measured 25/65/160/636ms at 10/12/14
               // `(a == N) ||` terms against a flat ~24ms, and a 12GB F4014 while the
               // compiler merely parsed its own `gen_expr_parser.av`. The `@cut` stays:
               // the peek decides ENTRY, the cut still stops a malformed body committing.
               | @try @peek(paren_lambda_ahead) "(" ( @on(allow_dot_postfix) a:expression ( "," a:expression )* )? ")" "->" @cut lb:lambda_body -> MkLambda(a, lb)
               | @try "(" @on(allow_dot_postfix) first:expression ( "," ( @on(allow_dot_postfix) rest:expression )? )+ ")" -> MkTupleFR(first, rest)
               | "(" ( @on(allow_dot_postfix) e:expression )? @require ")"
                 @expect(")", "expected `)` after expression") -> MkGroupOrEmpty(e)
  lambda_body  = block_expr | expression
  // The TYPE position is `@require`d, keyed on the rule NAME because `type_expr`'s FIRST
  // is a disjunction with no single token to name (t-myz7) — the same treatment `field`
  // already has, for the same reason. Unrequired, a missing type did not abort: the
  // expression view reported its own generic F0040 and the type view added "expected a
  // type", so `fn foo(x: ) -> int { 1 }` came out F0040 + F0001 where the hand reports
  // "expected parameter type after `:`" and stops.
  param        = pname:IDENT ( ":" @require pt:type_expr )?
                 @expect("IDENT", "expected parameter name") 
                 @expect("type_expr", "expected parameter type after `:`") -> MkParam(pname, pt)
  // t-47hc.29 — a match-table CELL: exactly hand `parse_primary` (parse/mod.av:2528), in
  // its own dispatch order, and deliberately NOT `@hand(primary_base)`. That leaf resolves
  // to `parse_leaf_common(false)`, which handles a quote SPLICE and the PREFIX operators
  // (`!`, `-`, `not`, `~`) BEFORE delegating to parse_primary — a strict superset. Measured
  // against the hand: a cell of `1` reaches typecheck, a cell of `-1` is
  // `error[F0040]: expected expression`. Binding cells to primary_base would start
  // ACCEPTING `-1` and silently widen the language.
  //
  // It lives HERE, in the expression family, rather than beside its `match_table_stmt`
  // caller: every alternative below is LOCAL to this view but EXTERNAL to the statement
  // view, so defining it there would demand a declared FIRST for all seventeen. Defined
  // once here it is emitted as `parse_table_cell` into the expression parser and CALLED
  // from the declaration parser across the merged `parse/` namespace — the same crossing
  // `parse_pattern_or` and `parse_match_arm` already make (its own FIRST is declared in
  // emit.rule_first_guard). Every branch is grammar-native or an @hand leaf ALREADY on the
  // production path, so cells cost no new leaf — which is what lets the flip retire one.
  // `n:` on the null/none alternation is LOAD-BEARING, not decoration. NUMBER/STRING/BOOL
  // are token-CLASS primaries and emit `CapVal.Node(literal_node(…))` unlabelled, but a
  // literal ALTERNATION emits `advance(); CapVal.Nil` — the token is consumed and the value
  // dropped, so `capval_to_expr` reports "expected an expression" for a `null` cell that the
  // hand parse_primary accepts as Expr.None. The label retains a `CapVal.Tok`, which
  // capval_to_expr routes through the same `literal_node` (which builds Expr.None by `tk`).
  // Caught in review on #1039; pinned by match_table_native_test.
  table_cell   = qualified_expr | NUMBER | STRING | BOOL | null_cell | variant_ctor
               | @peek(ident_lbrace_plain) @when(allow_struct_lit) struct_lit_expr
               | @peek(ident_template) tagged_template
               | @peek(ident_plain) IDENT
               // The FEATURE forms (t-47hc.5). `ident_plain` and `ident_lbrace_plain` both
               // consult the registry and DECLINE `table { … }` / `grammar { … }`, so with
               // no branch for their complement a feature-form cell had no rule at all:
               // the row loop read `table` as the NEXT row's pattern and reported
               // "`table` is not a valid pattern". It only surfaced once `fn` routed —
               // until then the enclosing function rolled the whole item back to the hand.
               //
               // Routed to the NATIVE rules `unary` already uses for the same cond, NOT to
               // `@hand(primary_base)`: that leaf is RETIRED from the expression parser and
               // emit_generated_test fails the build if it reappears. Same two rules, same
               // guard, one more caller.
               | @peek(ident_lbrace_feature) grammar_expr
               | @peek(ident_lbrace_feature) table_lit
               | paren_expr | list_expr | match_expr | if_expr
               | spawn_expr | channel_expr | isolated_expr | when_expr
               | @peek(quote_arm) quote_arm_expr | @peek(quote_type) quote_type_expr | quote_expr
               | template_lit | brace_expr
  // A `-> n` Var build (the `eq_tail`/`-> ir` form): labelling alone still returns Nil,
  // because a branch with no build yields Nil regardless. The build hands back the captured
  // `CapVal.Tok`, which capval_to_expr routes through literal_node.
  null_cell    = n:( "null" | "none" ) -> n
    }
    grammar_checked(gp)
}

/// The §2 expression grammar the INTERPRETER runs (run_grammar_expr / the inverse-@hand
/// dsl_expr_grammar cache in parse/mod.av / the equivalence oracles) — SELF-CONTAINED:
/// it composes declarations/statements for expression blocks, types for typed lambdas and
/// channels, and patterns for match statements nested in those blocks. The EMIT view keeps
/// those families EXTERNAL (avra_expr_dispatch_grammar), so the checked-in parser calls the
/// already-emitted parse_declaration / parse_type_expr functions rather than re-emitting them.
/// This is the same interpreter/dispatch split used by the statement family.
/// The declaration edge shared by every interpreter composition that can enter
/// an expression block. Keeping this as one fragment avoids duplicating the
/// existing hand-declaration frontier while block bodies call `declaration*`.
///
/// t-47hc.24 — the `@peek(decl_lead)` gate is what makes the second alternative
/// carry real weight. `@hand(decl_hand)`'s FIRST includes a bare IDENT (the
/// component instantiation `Comp inst { … }` is a declaration), but
/// parse_declaration_hand handles ONLY that form itself and falls through to
/// `parse_statement` for every other identifier-led item — so an unqualified IDENT
/// in the FIRST routed `x = 1`, `f(a)` and `x.m()` into a Parser delegate whose only
/// job was to hand them straight back to this same grammar. The gate keeps the
/// component shape on the hand path and lets the rest reach `statement` directly,
/// which is where they were always going to be parsed.
/// t-47hc slice 10 (t-myz7) — the `decl_hand` flip, INCREMENT 1: `use` and `mod`.
///
/// The flip is deliberately keyword-at-a-time, because `@hand(decl_hand)` is not one
/// thing — `parse_declaration_hand` owns the doc/annotation/`export` WRAPPING, the
/// component-vs-expression IDENT disambiguation, and the statement fall-through as
/// well as the seven decl keywords. Each keyword moves out from under it on its own,
/// gated on its own; `@hand(decl_hand)` stays as the fall-through for the ones not
/// yet native, and is deleted when the last one leaves.
///
/// `use` / `mod` go first because they are the two with no surface beyond the simple
/// form: neither takes generics, neither is `export`able (only fn/type/enum/trait/
/// extern are), so slice 9's fragment already accepts the whole language for them —
/// nothing to widen. The keywords with real surface (fn's generics, type/enum/trait's
/// bodies) come in later increments.
///
/// The modules fragment is composed HERE rather than at the call sites, so the rules
/// travel with the rule that references them. `declaration` is composed into five
/// different views (expr / stmt-flip / decl-flip / decl-dispatch / program); if
/// `use_decl` were external to any of them, emit would demand a declared FIRST for it
/// in `rule_first_guard` — the cross-view cost `table_cell` already pays. Keeping the
/// definition adjacent to its only reference avoids that entirely.
fn avra_decl_edge_grammar() -> Grammar {
    let gp = grammar {
  // t-myz7: a CONVERTED keyword is referenced BARE — its `@try` lives inside the
  // fragment, sharing a branch with the `@cut` that lets it own its own recovery.
  // `let_decl` PRECEDES `letdes_decl`, and that works only because `let_decl` carries
  // NO `@cut`: its `n:IDENT` fails on `(`, the `@try` rewinds, and the destructuring
  // form gets its turn. Giving `let_decl` a `@cut` (as its conversion will) makes
  // `letdes_decl` UNREACHABLE — at that point the two must swap, with the more
  // specific `let (` form first. Recorded because the breakage would be silent:
  // destructuring would simply stop parsing, with no diagnostic naming the cause.
  // `~name` in a NAME slot — legal ONLY inside a quote body, where it splices a
  // macro-scope variable into the position (t-47hc.5). The hand's
  // `consume_name_or_splice` is the oracle: it encodes the splice by PREFIXING the name
  // with `~` and carrying it as an ordinary name string, which the quote LOWERER reads
  // back out — so this rule must produce the same string rather than a new node kind.
  //
  // It became reachable when `fn` routed: a `quote stmt { type ~name = … }` sits inside a
  // function body, and while the body rolled back to the hand this slot was never the
  // native rule's problem. The `@when` is what keeps `type ~name` a parse error OUTSIDE a
  // quote, which is the other half of the hand's contract.
  name_or_splice = @when(in_quote_body) "~" sn:IDENT -> MkSpliceName(sn)
                 | pn:IDENT -> MkPlainName(pn)
  declaration = use_decl | mod_decl | shape_decl | enum_decl | type_decl | extern_decl | fn_decl | trait_decl | impl_decl | export_decl | @try doc_decl | mdoc_decl | @try annot_decl | letdes_decl | let_decl | mut_decl | const_decl | select_decl | parallel_decl | spec_decl | comp_header | @try bare_comp_inst_raw | @try bare_comp_inst | @peek(decl_lead) @hand(decl_hand) | statement
  // `export <decl>` — the first of `decl_hand`'s prefix WRAPPERS to go native.
  //
  // The inner is NOT `declaration`: the hand's export branch looks the NEXT token's
  // keyword up in the feature decl-parser table and calls that handler directly, so it
  // does NOT re-enter parse_declaration and therefore does NOT stack (`export @foo fn`
  // is "expected declaration after `export`" on the hand path, not a nested wrap). A
  // recursive inner would accept that and diverge on invalid input, which is precisely
  // the class the corpus additions in error_recovery_differential_test exist to catch.
  //
  // `exportable_decl` covers the keywords that already have native rules (the nine
  // decls plus the `let`/`mut`/`const` bindings and the destructure form). The hand
  // table is wider — spec / component / select / parallel are decl keywords too —
  // so those forms fail this alternation, the `@try` rolls the whole branch back,
  // and `@hand(decl_hand)` below parses them exactly as before. That is the point
  // of routing as `@try` rather than bare: the native rule owns the input it can
  // express and hands everything else, valid or malformed, back to the hand parser
  // untouched.
  // THE INNER CARRIES ITS OWN POSITION, which is why `exportable_decl` is a rule in its
  // own right rather than the alternation inlined into `export_decl`. The hand stamps
  // the WRAPPED declaration with the position it captured right after consuming
  // `export`, and nothing else supplies that: the statement-list loop stamps only the
  // outermost node, which for a wrapper is the `Stmt.Annotated`. `MkStampAt` reads its
  // OWNING RULE's entry byte, so that rule has to begin exactly where the inner
  // declaration does — one literal later than `export_decl`.
  //
  // Skipping it is not cosmetic: `Ctx.source_line` retains its previous value for a node
  // with no recorded position, so an unstamped declaration inherits whatever statement
  // was emitted before it, and every diagnostic position inside it — including the
  // `avra_null_deref_trap` line baked into the IR — moves with it. diff-test caught it as
  // selfhost line numbers drifting by 2, 3 and 41; arbitrary deltas are the tell that a
  // position is inherited rather than shifted.
  // t-myz7: `export` owns its recovery. The inner is `@require`d with a declared message
  // because `exportable_decl`'s FIRST is a disjunction of keywords — there is no single
  // token to name, which is exactly the case `@expect("<rule>", …)` exists for.
  export_decl      = @try "export" @cut @require ed:exportable_decl
                     @expect("exportable_decl", "expected declaration after `export`") -> MkExport(ed)
  exportable_decl  = ei:exportable_inner -> MkStampAt(ei)
  // t-47hc.5: this alternation MIRRORS `declaration`'s, tail role included. A `@try`
  // branch commits only if the callee reported NOTHING, so a keyword whose native rule
  // reports and then rolls back leaves the alternation with no branch at all — and with
  // no tail that is `Nil`, which `MkStampAt`'s `capval_to_stmt` answers with a generic
  // "expected a statement" ON TOP of a re-parse of the same keyword by the caller.
  // `export let` showed both: the hand says "expected variable name" once, the native
  // path said "expected a statement" and then, having consumed only `export`, let the
  // top-level loop hand `let` to the hand parser for the real message.
  //
  // So the unrouted keywords keep the SAME tail they have at the top level: the hand.
  // It is the same `@hand(decl_hand)` leaf `declaration` ends with — one leaf, two
  // references — and it dies with that one when the last keyword routes. The keywords
  // already BARE in `declaration` are bare here too, because a routed rule owns its
  // recovery and must not be given a rollback it does not have at the top level.
  //
  // The tail is `@peek`-NARROWED, and that is load-bearing rather than tidy: a bare
  // `@hand` tail's FIRST is UNIVERSAL, and `export_decl`'s `@require` reads exactly
  // that FIRST to decide whether a declaration follows. Unguarded, `export export fn
  // g() { }` parsed as a nested export where the hand rejects it — the hand looks the
  // inner keyword up in the feature registry's declaration table, and `export` is not
  // in that table. `decl_table_kw` asks the registry the SAME question, so this rule's
  // acceptance frontier is the table's, not a keyword list that can drift from it.
  // The branch list is `declaration`'s, MINUS the four prefix wrappers (`export`,
  // `///`, `@ann`, `//!`) and the IDENT-led component instantiations — neither is in
  // the decl table, so the hand's `export` branch cannot reach them either — and minus
  // the `statement` tail, which is not a declaration. Same `@try`/bare split, same
  // order (`let_decl` before `letdes_decl` for the reason `declaration` records), so
  // the two alternations cannot disagree about who owns a keyword.
  exportable_inner = use_decl | mod_decl | shape_decl | enum_decl | type_decl | extern_decl | fn_decl | trait_decl | impl_decl | letdes_decl | let_decl | mut_decl | const_decl | select_decl | parallel_decl | spec_decl | comp_header | @peek(decl_table_kw) @hand(decl_hand)
  // The remaining three prefix wrappers (t-47hc Phase 4), same shape as `export_decl`
  // with ONE deliberate difference: their inner IS recursive. The hand's doc and
  // annotation branches re-enter `parse_declaration` (unlike export's direct table
  // lookup), so wrappers STACK — `/// doc` over `@a` over `export fn` really parses,
  // as Annotated(doc, Annotated(a, Annotated(export, fn))). `wrapped_inner` mirrors
  // that: the native decls (bindings and destructure included) plus the wrappers
  // themselves, all `@try`, so any form it cannot express (a keyword-named
  // annotation, `//!` under `@a`) fails the alternation, the outer `@try` rewinds,
  // and `@hand(decl_hand)` parses the WHOLE wrapped item exactly as before.
  //
  // `docable_decl` / `annotable_decl` exist for the same reason `exportable_decl`
  // does: `MkStampAt` reads its OWNING RULE's entry byte, and the hand stamps the
  // wrapped declaration at the position captured right after consuming the prefix —
  // so the stamping rule must begin exactly where the inner declaration does.
  //
  // `mdoc_decl` wraps no declaration at all (`//!` is `@module_doc` around a NoOp);
  // the NoOp's stamp lives in the build (`MkModuleDoc` reads the token AFTER the doc
  // lines, matching the hand's post-consume current position).
  //
  // `annot`'s name is `IDENT` — narrower than the hand, which accepts ANY lexeme
  // (`@type x` really annotates). Those roll back to the hand path, byte-identically;
  // the arg list is the call-suffix group verbatim, because on the hand side it IS
  // parse_arg_list_ids (allow_dot_postfix on via call_arg's own `@on`, no it-sugar
  // toggle — annotations read the ambient mode, exactly like a plain `f(args)` call).
  doc_decl       = d:DOC ( d:DOC )* dd:docable_decl -> MkDocAnnotated(d, dd)
  docable_decl   = di:wrapped_inner -> MkStampAt(di)
  mdoc_decl      = m:MODDOC ( m:MODDOC )* -> MkModuleDoc(m)
  annot_decl     = an:annot ( an:annot )* ad:annotable_decl -> MkAnnotatedArgs(an, ad)
  annotable_decl = ai:wrapped_inner -> MkStampAt(ai)
  annot          = "@" n:IDENT ( "(" ( @onfail(bail) a:call_arg ( @peek(comma_not_rparen) "," @onfail(bail) a:call_arg )* ( "," )? )? ")" )? -> MkAnn(n, a)
  // `component_decl` is in this set (t-myz7): an ANNOTATED or DOC-COMMENTED
  // component had no native path, so `@expand(expand_cli) component cli {}` fell to
  // `@hand(decl_hand)` — 157 sites in packages/cli/src/main.av, the last form still
  // holding the delegate. It is not `@expand`-specific: a plain `@inline` on a
  // component refused identically, while the bare `component cli {}` was already
  // native and `@expand` on a `fn` was fine. Its FIRST (`component`) collides with
  // nothing else here, and `wrapped_inner` is shared by both `annot_decl` and
  // `doc_decl`, so this covers the doc-comment form too.
  wrapped_inner  = fn_decl | type_decl | enum_decl | @try trait_decl | extern_decl | @try shape_decl | impl_decl | @try comp_header | @try use_decl | @try mod_decl | export_decl | @try doc_decl | @try annot_decl | letdes_decl | let_decl | @try mut_decl | @try const_decl
  // The `let` / `mut` / `const` BINDINGS (t-47hc Phase 4) — the highest-traffic
  // residue of `@hand(decl_hand)`: every binding statement in every routed body
  // used to detour through the hand delegate. The rules mirror the hand parsers
  // shape-for-shape (features/let_stmt/parser.av):
  //
  //   * `let ( m:"mut" )?` — `let mut v` binds a reassignable `v` (MkLetBinding
  //     reads the modifier's presence); a BARE `mut` is its own rule. Both build
  //     Stmt.Mut through the one shared core.
  //   * The optional annotation lowers through the shared type family; absent ⇒
  //     Unknown — exactly the hand's `ty_vt` default.
  //   * The guard form `… else <stmt>`: `tmp:@gensym(letelse)` sits AFTER the
  //     else statement because that is where the hand mints (`build_let_else`
  //     parses the else, checks divergence, THEN calls `fresh`) — the same
  //     mint-order discipline as if_expr's `@gensym(iflet)`. The divergence
  //     check itself lives in the BUILD (mk_let_binding_g), which reports the
  //     CODED F1203 — it has to, now that the rule commits: the diagnostic used
  //     to reach the user by ROLLBACK (report message-only, let the `@try` unwind,
  //     let the hand re-parse and own the code), and a `@cut` leaves no rollback
  //     to hand it off to.
  //   * `const` has no guard form and no `mut` modifier, matching the hand.
  //   * The DESTRUCTURE form has its own rule below, dispatched BEFORE this one
  //     and selected predictively by its own `@peek(let_destructure)`. It used to
  //     sit after `let_decl` and be reached by ROLLBACK (`n:IDENT` failing on the
  //     `(`), which a committed rule no longer provides.
  // t-47hc.5: `let` is ROUTED, and it was the LAST keyword under `@hand(decl_hand)` —
  // `--parser-frontier` now reports none. The `@try`/`@cut` pair lives INSIDE the rule so
  // the dispatcher references it bare, exactly as `mut` and `const` already do.
  //
  // Committing it measured 32 divergences and NONE of them were about bindings: the
  // initializer position is a hole through which every expression-level gap shows, and a
  // dispatcher-level `@try` had been hiding all of them by rolling the whole item back to
  // the hand. What it took to close them is spread across the rules that actually owned
  // each gap — `paren_expr`'s predictive lambda gates, `quote type`/`quote arm`'s required
  // terminals, `table_lit`'s bailing header and rows, `if_expr`'s bailed condition, the
  // lexer-diagnostic bridge (`lex_real_full` -> `PState.lex_diags` -> `boundary_diags`),
  // and the flip seam reporting at its own byte. The invalid corpus
  // (error_recovery_differential_test) is 117/117 with `let` routed, which is the gate
  // this keyword was held behind.
  //
  // `@onfail(bail)` on the initializer is keyed on the sub-parse having FAILED **or**
  // REPORTED — the union the hand's `?` propagates. It was failure-only, carved out for
  // `let a = (1) ->`, where the expression view reported the missing lambda body and still
  // handed back `(group 1)` that the hand KEEPS. `paren_expr`'s `@peek(paren_lambda_ahead)`
  // removed that input (the group now parses clean and the dangling `->` is the next
  // statement's F0040), so the carve-out went with it — and without the union
  // `let b = x is Foo` survived as a binding where the hand aborts the statement.
  //
  // The TYPE position is `@require`d and keyed on the rule NAME, exactly as `param`'s is
  // and for the same reason: `type_expr`'s FIRST is a disjunction with no single token to
  // name. Unrequired, `let x: = 1` did not abort — the type view reported its own generic
  // F0040 "expected expression" and the binding survived as `(let x:<unknown> 1)`, where
  // the hand reports "expected type after `:`" and the whole statement becomes `(error)`.
  let_decl   = @try "let" @cut ( m:"mut" )? @require n:IDENT ( ":" @require ty:type_expr )? @require "=" @onfail(bail) init:expression ( "else" e:statement tmp:@gensym(letelse) )?
               @expect("IDENT", "expected variable name")
               @expect("type_expr", "expected type after `:`")
               @expect("=", "expected `=` after variable name") -> MkLetBinding(m, n, ty, init, e, tmp)
  mut_decl   = @try "mut" @cut @require n:IDENT ( ":" @require ty:type_expr )? @require "=" @onfail(bail) init:expression ( "else" e:statement tmp:@gensym(letelse) )?
               @expect("IDENT", "expected variable name")
               @expect("type_expr", "expected type after `:`")
               @expect("=", "expected `=` after variable name") -> MkMutBinding(n, ty, init, e, tmp)
  const_decl = @try "const" @cut @require n:IDENT ( ":" @require ty:type_expr )? @require "=" @onfail(bail) init:expression
               @expect("IDENT", "expected constant name")
               @expect("type_expr", "expected type after `:`")
               @expect("=", "expected `=` after constant name") -> MkConstBinding(n, ty, init)
  // `let (a, b, …) = init` — the destructure binding, completing the binding
  // family's exit from `@hand(decl_hand)`. The list shape is `for_binding`'s,
  // verbatim: `@peek(comma_ident)` gates each repeat iteration so a trailing
  // comma survives to the `","?` (the hand's parse_destructure_names tolerates
  // `(a, b,)`), and the whole names group is optional because the hand accepts
  // an EMPTY list (`let () = t` parses — entries are typed at check time).
  // `( m:"mut" )?` mirrors the hand exactly: parse_let_statement consumes an
  // optional `mut` BEFORE testing for `(`, and parse_let_destructure never
  // reads is_mut — so `let mut (a, b) = t` is a plain destructure on both
  // engines. A BARE `mut (` stays an error (parse_mut_statement demands an
  // identifier), which is why mut_decl has no destructure sibling.
  letdes_decl = @peek(let_destructure) "let" ( m:"mut" )? "(" ( n:IDENT ( @peek(comma_ident) "," n:IDENT )* ","? )? @require ")" @require "=" @onfail(bail) init:expression
                @expect(")", "expected `)` after destructure names")
                @expect("=", "expected `=` after destructure pattern") -> MkDestructure(n, init)
  // The CONCURRENCY statements (t-47hc Phase 4). `parallel` is a keyword + a
  // brace-delimited statement list held as RAW ids under a LEAF Parallel row
  // (the hand's parse_statement_list_ids → Stmt.Parallel(ids) — no Block
  // wrapper). `select` mirrors parse_select_arm_list: arms are
  // `binding <- channel -> { body }`, ZERO arms is valid (`select { }`), and
  // the arm list folds into the walker-opaque Stmt.Select leaf. The binding is
  // Tk.Identifier only.
  //
  // `select` OWNS its recovery now (t-myz7): `@cut` sits directly after the keyword,
  // so a malformed arm COMMITS and reports through `select_arm`'s own `@expect`s
  // instead of rolling back to select_stmt/parser.av. `@gate` on the arm repetition
  // is what lets the loop be entered on a token the arm's own FIRST would refuse —
  // without it a non-IDENT arm head silently ended the list — and the gated FIRST
  // re-check emit inserts is what reports for it. `@expect("IDENT", …)` on
  // `select_arm` supplies that check's message; with no declared message it would
  // fall back to a generic "expected select_arm", naming a grammar rule at the user.
  parallel_decl = @try "parallel" @cut @require "{" body:declaration* @require "}"
                  @expect("{", "expected `{` after parallel")
                  @expect("}", "expected `}` to close parallel block") -> MkParallel(body)
  // NOT committed, for the reason recorded on `enum_decl`: `select { x }` must report
  // the missing `<-` and still build `(select ())`, while a committed rule ABORTS to
  // `(error)` and additionally leaves the `}` unconsumed so the caller adds a spurious
  // F0013. A gated element's failure needs to SKIP the element and let the rule close,
  // which is a non-aborting mode the DSL does not have.
  select_decl   = @try "select" @cut @require "{" ( @peek(not_rbrace) @gate @onfail(close) arms:select_arm )* @require "}"
                  @expect("{", "expected `{` after select")
                  @expect("}", "expected `}` to close select") -> MkSelect(arms)
  select_arm    = b:IDENT @require "<-" @onfail(bail) ch:expression @require "->" @require "{" body:declaration* @require "}"
                  @expect("IDENT", "expected select arm binding name")
                  @expect("<-", "expected `<-` after select arm binding")
                  @expect("->", "expected `->` after channel in select arm")
                  @expect("{", "expected `{` for select arm body")
                  @expect("}", "expected `}` to close select arm") -> MkSelectArm(b, ch, body)
  // The SPEC-TEST blocks (t-47hc Phase 4). `spec_item` mirrors parse_spec_body's
  // dispatch — given-block | then-block | any declaration — and both nesting
  // levels stamp per-item positions via the shared stmt-repetition loop (the
  // hand stamps record_pos per spec item too). A `then` body is a plain
  // statement list whose rows fold into a walker-opaque Expr.Block cond (the
  // hand's parse_block_expression shape); all three nodes are LEAF rows.
  //
  // All three missing-name diagnostics are OWNED NATIVELY (t-myz7). `@cut` sits
  // directly after each keyword, so a missing STRING COMMITS the branch and reports
  // through its own `@expect` rather than rolling back to spec_test/parser.av. The
  // `given`/`then` messages are the hand's, verbatim, because a nested block is
  // exactly where rolling back was never enough: `parse_spec_body` swallows the Err
  // and returns the partial item list, so `spec "s" { given }` closed cleanly with
  // the malformed `given` SILENTLY DROPPED. A rule with no `@expect` at all reported
  // the generic "expected `STRING`", which named neither the construct nor the fix.
  // NOT committed, same reason: `spec "s" { given }` must DROP the malformed item and
  // build `(spec "s" )`, where the committed rule keeps `(spec "s" (error))`. Item-drop
  // is a third recovery shape the DSL cannot yet express.
  spec_decl  = @try "spec" @cut @require n:STRING @require "{" @onfail(drop) body:spec_item* @require "}"
               @expect("STRING", "expected spec name string after `spec`")
               @expect("{", "expected `{` after spec name")
               @expect("}", "expected `}` to close spec block") -> MkSpecBlock(n, body)
  spec_item  = given_blk | then_blk | declaration
  given_blk  = @try "given" @cut @require n:STRING @require "{" @onfail(drop) body:spec_item* @require "}"
               @expect("STRING", "expected given name string after `given`")
               @expect("{", "expected `{` after given name")
               @expect("}", "expected `}` to close given block") -> MkGivenBlock(n, body)
  then_blk   = @try "then" @cut @require n:STRING @require "{" body:declaration* @require "}"
               @expect("STRING", "expected then name string after `then`")
               @expect("{", "expected `{` after then name")
               @expect("}", "expected `}` to close then block") -> MkThenBlock(n, body)
  // The COMPONENT definition, MODERN form only (t-47hc Phase 4 slice A):
  // `component name [implements A, B] { config? children? body:TokenStream? … }`.
  // The legacy paren form (`component C(params) {`), the keyword-prefixed
  // instantiation (`component C inst {`), and the bare-IDENT instantiation stay
  // with the hand — each fails this rule's header (`"{"` after the name /
  // implements list), the `@try` rolls back, and `@hand(decl_hand)` owns them
  // (including the coded implements-then-instance diagnostic). The implements
  // list is parse_implements_list's shape: first trait required, trailing comma
  // legal only before the body brace. `comp_field` is the component-body `let`,
  // which REQUIRES the `: type` annotation (parse_comp_def_body errors on a
  // bare `let x = 5`) — it must dispatch BEFORE `declaration`, whose routed
  // let_decl would wrongly accept the annotation-less form. The MkComponentDef
  // build REGISTERS the name for keyword-free instantiation at the same point
  // the hand does (end of the def parse) — under @try speculation that can
  // leave a registration behind on rollback, which is byte-for-byte the
  // status quo (a hand-parsed def inside a rolled-back @try branch already
  // does this; see the t-47hc hazard-1 comment).
  // The LEGACY paren form, `component C(a: int) { config? body }` (t-47hc.5). The hand
  // still accepts it, so it is VALID input the grammar could not express — which blocks
  // committing `component` outright, not merely its recovery. Dispatched on a LOOKAHEAD
  // rather than left to a `@try`, because the header it shares with the brace form is
  // variable-length (`implements A, B`) and a committed rule cannot back out of it.
  // No `children` block and no `body:` marker here: parse_component_decl's paren branch
  // admits neither, and the shared build enforces the rest.
  // The `implements A, B` clause as its OWN rule, referenced by all three header forms
  // (t-47hc.5). Not tidiness: `@expect` is keyed by TOKEN, and the header has TWO IDENT
  // positions wanting different wording — the component NAME ("expected component name")
  // and the first trait ("expected trait name after `implements`"). One rule cannot say
  // both, so the clause moves to where its own message is unambiguous. That is the same
  // reference-site keying `@require` already uses for rule references.
  // ONE `component` entry point, four shapes (t-47hc.5). The dispatcher must see a
  // SINGLE `component`-led branch or the FIRST/FIRST guard rightly flags four rules that
  // all start with the same literal; the discrimination is a LOOKAHEAD, so it belongs on
  // branches inside a rule where the guard can see it, not spread across the dispatcher.
  //
  // Referenced by `declaration`, `exportable_inner` AND `wrapped_inner`, which is the
  // other half of the fix: the hand's export/doc/annotation wrappers look `component` up
  // in the decl table and get `parse_component_decl`, i.e. ALL FOUR forms. Pointing those
  // wrappers at `component_decl` alone quietly excluded `export component C(a: int) {}`.
  comp_header = @peek(comp_inst_shape) comp_inst
              | @peek(comp_paren_shape) comp_paren_decl
              | @peek(comp_implements_inst) comp_impl_inst
              | component_decl
  // The `config { … }` and `children { … }` blocks as their OWN rules (t-47hc.5), for
  // the reason `comp_implements` is one: `@expect` is keyed by TOKEN, and the header has
  // THREE `{` positions wanting different wording — the component body's ("expected `{`
  // after component name"), config's, and children's. `component C { config }` came out
  // with the body's message where the hand says "expected `{` after `config`".
  comp_config_block   = "config" @require "{" ( @peek(not_rbrace) @gate ccfg:config_entry )* @require "}"
                        @expect("{", "expected `{` after `config`")
                        @expect("}", "expected `}` after config entries") -> MkCompConfigList(ccfg)
  comp_children_block = "children" @require "{" ( @peek(not_rbrace) @gate ccs:children_slot ( @peek(comma_ident) "," ccs:children_slot )* ","? )? @require "}"
                        @expect("{", "expected `{` after `children`")
                        @expect("}", "expected `}` after children entries") -> MkChildrenSlotList(ccs)
  // `body: TokenStream` as its OWN rule so the type check runs WHEN THE MARKER IS PARSED
  // (t-47hc.5). The hand validates it there and returns `.Err`, leaving the component's
  // closing `}` for statement-level recovery; validating in the enclosing build instead
  // runs AFTER `@require "}"` has already consumed the brace, so the hand's second
  // diagnostic could not appear no matter what the build did.
  comp_body_marker = "body" @require ":" @require bmn:IDENT
                     @expect(":", "expected `:` after `body`")
                     @expect("IDENT", "expected a type after `body:`") -> MkCompBodyMarker(bmn)
  comp_implements = "implements" @require ctr:IDENT ( @peek(comma_ident) "," ctr:IDENT )* ","?
                    @expect("IDENT", "expected trait name after `implements`") -> MkTraitList(ctr)
  comp_paren_decl = @peek(comp_paren_shape) "component" @require pn:IDENT ( @peek(kw_implements) @gate pci:comp_implements )?
                    @require "(" ( @peek(not_rparen) @gate pps:param ( @peek(comma_not_rparen) "," pps:param )* ( "," )? )? @require ")"
                    @require "{" ( @peek(kw_config) @gate pcfg:comp_config_block )? @onfail(abort) pbody:comp_item* @require "}"
                    @expect("IDENT", "expected component name")
                    @expect("(", "expected `(` after component name")
                    @expect(")", "expected `)` after component params")
                    @expect("{", "expected `{` after component header")
                    @expect("}", "expected `}` at end of component") -> MkComponentParenDef(pn, pps, pci, pcfg, pbody)
  // The one header shape the hand answers with a MESSAGE rather than a parse: an
  // implements clause followed by an instance name. Its `@require "{"` can only FAIL —
  // the cond admits this branch precisely when an IDENT sits where the `{` belongs — so
  // the rule is a reporter, and the body after it exists to give the sequence a shape,
  // not to run. Written as its own branch because the message is CONTEXTUAL: the same
  // missing `{` is "expected `{` after component name" without an implements clause, and
  // one `@expect` per token cannot say both.
  // NO BUILD, deliberately: the `@require "{"` is the last item and it can only fail, so
  // there is nothing to construct. Giving it `MkComponentDef` would mean declaring
  // captures nothing ever binds purely to satisfy an arity.
  comp_impl_inst = @peek(comp_implements_inst) "component" @require iname:IDENT ici:comp_implements
                   @require "{"
                   @expect("{", "`implements` clause must be followed by `{` or `(` — if you meant another trait name, add a `,` (instance-prefix component blocks may not carry an `implements` clause)")
  component_decl = "component" @require n:IDENT ( @peek(kw_implements) @gate ci:comp_implements )? @require "{" ( @peek(kw_config) @gate cfg:comp_config_block )? ( @peek(kw_children) @gate cs:comp_children_block )? ( @peek(body_marker) @gate bm:comp_body_marker )? @onfail(abort) body:comp_item* @require "}"
                   @expect("IDENT", "expected component name")
                   @expect("{", "expected `{` after component name")
                   @expect("}", "expected `}` at end of component") -> MkComponentDef(n, ci, cfg, cs, bm, body)
  // `@require ":"` with the hand's own message: `parse_comp_config_schema` consumes the
  // colon with `expected `:` after config key` and RETURNS `.Err`, so a keyless entry
  // ends the config block rather than going on to look for a type (t-47hc.5).
  // The IDENT message is declared HERE, on the callee, because that is where the gated
  // entry re-check reads it from (`rule_first_expect_msg`) — a caller-side
  // `@expect("config_entry", …)` is inert. Without it the fallback printed the GRAMMAR
  // RULE NAME at the user: `component C { config { 5 } }` said "expected config_entry"
  // where the hand says "expected config key".
  config_entry  = k:IDENT @require ":" @require ty:type_expr ( "=" d:expression )? ( "@" ( a:IDENT )? )* ","?
                  @expect("IDENT", "expected config key")
                  @expect(":", "expected `:` after config key")
                  @expect("type_expr", "expected config type") -> MkCompConfig(k, ty, d)
  children_slot = k:IDENT @require ":" @require ty:type_expr
                  @expect("IDENT", "expected child slot name")
                  @expect(":", "expected `:` after slot name")
                  @expect("type_expr", "expected slot type") -> MkChildrenSlot(k, ty)
  // The `@peek(kw_let)` gate declares the dispatch the ambiguity guard would
  // otherwise flag as a silent FIRST/FIRST shadow: `declaration` also derives
  // `let` (the routed let_decl), and comp_field must own it TOTALLY so the
  // annotation-less form stays an error instead of leaking through.
  // The COMPONENT INSTANTIATION, keyword-prefixed form (t-47hc.5.1 slice B):
  // `component C inst { key value… body… }`. Sits AFTER component_decl in the
  // alternation, so a definition (`component C {`) is matched first and this
  // rule only sees the two-name shape.
  //
  // The config-pair loop mirrors parse_comp_config_pairs: each pair is
  // `@peek`-gated, and the loop ends when neither cond matches — which is what
  // the hand's `keep_going = false` does. Both conds run the SHARED raw-source
  // cores (chars.av), so `key -5`, `key trueish`, `key /* c */ "v"` and
  // `key r"s"` are all decided identically to the hand rather than
  // re-derived at token level.
  comp_inst   = @peek(comp_inst_shape) "component" n:IDENT i:IDENT "{" ( @onfail(bail) p:config_pair )* @onfail(abort) body:comp_block_item* @require "}" @expect("}", "expected `}` at end of component block") -> MkComponentBlock(n, i, p, body)
  // Slice C — the same instantiation WITHOUT the `component` keyword. Decidable only
  // via the registry (see the `bare_comp_inst` cond), because `acct_sr a { … }` and
  // `foo bar { … }` are the same token shape. The raw twin mirrors the nested
  // raw arms above: a `body: TokenStream` component captures its instance body
  // verbatim rather than parsing it.
  bare_comp_inst     = @peek(bare_comp_inst) n:IDENT i:IDENT "{" ( @onfail(bail) p:config_pair )* @onfail(abort) body:comp_block_item* @require "}" @expect("}", "expected `}` at end of component block") -> MkComponentBlock(n, i, p, body)
  bare_comp_inst_raw = @peek(bare_comp_inst_raw) rn:IDENT ri:IDENT "{" rb:@rawbrace(component) "}" -> MkRawComponentBlock(rn, ri, rb)
  config_pair = @peek(cfg_pair_value) k:IDENT v:expression ","? -> MkCompConfigPair(k, v)
              | @peek(cfg_pair_eq) k:IDENT "=" v:expression ","? -> MkCompConfigPair(k, v)
  // The four arms of the hand's parse_comp_block_body, routed (t-47hc.5.1 B2b).
  // ORDER IS THE SPEC: raw-body before structured (the same name can only be one,
  // and the conds are mutually exclusive on the registry, but reading raw-first
  // matches the hand's "decide after the brace" order), named before bare (`n i {`
  // is a prefix of neither, but `n {` would otherwise capture `n` and stop), and
  // `declaration` LAST as the honest unguarded tail. Every arm is routed, so the
  // tail no longer needs a gate to decline into — which is what makes it honest:
  // a `@peek` on the last branch is silently dropped (dispatch_has_tail), so the
  // previous `@peek(comp_body_plain) declaration` was a guard that never ran.
  // Every position the hand `consume`s with a message is `@require`d, with that message
  // (t-47hc.5). Per-BRANCH `@expect`s, which is what makes the two IDENT slots in the
  // named arm expressible: the component name is guaranteed by the branch's own `@peek`,
  // so the only IDENT that can fail there is the INSTANCE name.
  comp_block_item = @peek(comp_nested_raw_named) rn:IDENT @require ri:IDENT @require "{" rb:@rawbrace(component) @require "}"
                    @expect("IDENT", "expected instance name")
                    @expect("{", "expected `{` after nested block name")
                    @expect("}", "expected `}` at end of nested block") -> MkRawComponentBlock(rn, ri, rb)
                  | @peek(comp_nested_raw_bare) rn:IDENT @require "{" rb:@rawbrace(component) @require "}"
                    @expect("{", "expected `{` after nested block name")
                    @expect("}", "expected `}` at end of nested block") -> MkRawComponentBlock(rn, rn, rb)
                  | @peek(comp_nested_named) n:IDENT @require i:IDENT @require "{" ( @onfail(bail) p:config_pair )* @onfail(abort) body:comp_block_item* @require "}"
                    @expect("IDENT", "expected instance name")
                    @expect("{", "expected `{` after nested block name")
                    @expect("}", "expected `}` at end of nested block") -> MkComponentBlock(n, i, p, body)
                  | @peek(comp_nested_bare) n:IDENT @require "{" ( @onfail(bail) p:config_pair )* @onfail(abort) body:comp_block_item* @require "}"
                    @expect("{", "expected `{` after nested block name")
                    @expect("}", "expected `}` at end of nested block") -> MkComponentBlock(n, n, p, body)
                  | @peek(comp_method) m:IDENT @require "(" @require ")" @require "{" mb:declaration* @require "}"
                    @expect("(", "expected `(` in method shorthand")
                    @expect(")", "expected `)` in method shorthand")
                    @expect("{", "expected `{` after method header")
                    @expect("}", "expected `}` after method body") -> MkMethodShorthand(m, mb)
                  | declaration
  comp_item     = @peek(kw_let) @gate comp_field | declaration
  // `parse_comp_def_body`'s `let` arm consumes the colon with `expected `:` after field
  // name` and returns `.Err`, so a bare `let x` ends the component and leaves its `}` for
  // statement-level recovery (t-47hc.5).
  comp_field    = "let" @require f:IDENT @require ":" @require ty:type_expr ( "=" init:expression )?
                  @expect("IDENT", "expected field name")
                  @expect(":", "expected `:` after field name")
                  @expect("type_expr", "expected field type") -> MkCompField(f, ty, init)
  // See the §2 twin above: on the PRODUCTION path a routed body is a DECLARATION list,
  // matching the hand's parse_statement_list_ids (which re-enters parse_declaration per
  // item) and the precedent `stmt_block` / `block_expr` already set. Using `statement`
  // here silently drops the component instantiation, which decl_lead_gate_test caught.
  body_item   = declaration
    }
    // Flat list, not a seven-deep `compose_grammars` nest: `compose_grammars(head, tail)`
    // IS `compose_fragments([head, tail])`, and compose_fragments concatenates rules in
    // list order, so the two spellings are provably identical — this one just doesn't
    // grow a paren layer per decl fragment.
    compose_fragments([
        grammar_checked(gp),
        avra_modules_grammar(),
        avra_struct_decl_grammar(),
        avra_generics_grammar(),
        avra_enum_decl_grammar(),
        avra_fn_decl_grammar(),
        avra_trait_decl_grammar(),
        avra_impl_decl_grammar(),
    ])
}

export fn avra_expr_grammar() -> Grammar {
    compose_grammars(
        compose_grammars(
            compose_grammars(avra_expr_core(), avra_decl_dispatch_grammar()),
            avra_type_flip_grammar()
        ),
        avra_pat_grammar()
    )
}

/// The DISPATCH-only expression grammar the STATIC production parser is EMITTED from
/// (gen_expr_file.emit_expr_parser_file): == avra_expr_core, so `type_expr` in paren_expr's
/// `param` and block-expression `declaration` stay EXTERNAL references → the emitted parser
/// calls parse_type_expr / parse_declaration from the other generated files in the same flat
/// `parse` module instead of re-emitting either family. The emit twin of
/// avra_stmt_dispatch_grammar.
export fn avra_expr_dispatch_grammar() -> Grammar {
    avra_expr_core()
}

/// The §2 statement family (ps3t.6.5.2 scope — break / continue / `return
/// <expr>` / bare expression-statements) composed with the shared expression
/// grammar. Statements embed FULL Avra expressions, reused not re-defined:
/// `return e:expression` / `e:expression` resolve to avra_expr_grammar()'s
/// `expression` rule. Later statement forms (block, if/for/while, let/mut/
/// const, match) join this block as their slices land (§2.5).
export fn avra_stmt_grammar() -> Grammar {
    let gp = grammar {
  statement     = break_stmt | continue_stmt | match_stmt | defer_stmt | errdefer_stmt | return_stmt | expr_stmt
  break_stmt    = "break" -> Break()
  continue_stmt = "continue" -> Continue()
  match_stmt    = "match" @off(allow_struct_lit) subj:expression "{" ( arms:match_arm ","? )* "}" -> MkMatch(subj, arms)
  // This §2 view is SELF-CONTAINED (its own simplified match_stmt / match_arm, not the
  // production ones) because emit-gen-check compiles the statement parser ALONE, with no
  // sibling generated file to call into. It now composes an expression grammar whose
  // native `match_expr` reaches match_when_arm, so this view must define that rule too —
  // isolated-view duplication, like the `let_stmt` --hand-leaves already reports as
  // grammar-text-only. The PRODUCTION views get it from the shared fragment (t-47hc.25).
  match_when_arm = "_" "->" @off(allow_dot_postfix) b:expression -> MkWhenDefault(b)
                 | c:expression "->" @off(allow_dot_postfix) b:expression -> MkWhenArm(c, b)
  match_arm     = p:pattern_or ( "if" g:expression )? "->" @off(allow_dot_postfix) b:expression -> MkArm(p, g, b)
  defer_stmt    = "defer" e:expression -> MkDefer(e)
  errdefer_stmt = "errdefer" e:expression -> MkErrdefer(e)
  return_stmt   = "return" ( @peek(return_value) @gate @onfail(bail) e:expression )? -> MkReturn(e)
  expr_stmt     = e:expression -> ExprStmt(e)
    }
    // The match-table fragment is composed IN (not left external) for the same
    // reason this view defines its own match_when_arm: the composed expr core's
    // match branch references `match_table_expr`, and emit-gen-check compiles
    // this view STANDALONE — an external reference has no sibling generated
    // file to land on there (parse_match_table_expr is module-private in
    // gen_decl_parser.av), so the harness died with an undefined fn.
    compose_grammars(compose_grammars(compose_grammars(compose_grammars(compose_grammars(grammar_checked(gp), avra_expr_core()), avra_decl_edge_grammar()), avra_type_flip_grammar()), avra_pat_grammar()), avra_match_table_grammar())
}

/// ps3t.6.7 Step G slice 4 — the PRODUCTION statement grammar the statement
/// flip (`AVRA_PARSER_STMT_FLIP`, parse_statement) runs. Unlike the §2
/// avra_stmt_grammar above (a family-ISOLATED oracle view whose `return_stmt`
/// is structural), this is the byte-identical production dispatch:
///
///   * `break` / `continue` — trivial DSL-native leaves (a single position-
///     free Stmt.Break / Stmt.Continue; the outer parse_statement_list_ids
///     records their SrcPos, exactly as for the hand parser).
///   * `if_stmt` / `for_stmt` / `while_stmt` — grammar-native control-flow
///     HEADERS. The `@off(allow_struct_lit)` marker reproduces the hand parsers'
///     save/clear/restore around the condition (the `while foo {` struct-literal-
///     vs-body disambiguation); the BODY is the grammar-native `block` rule
///     (`"{" statement* "}" -> Block`) — a `{`-required block, so a bare-statement
///     body (`while c break`) is a parse error, exactly as the hand header parsers
///     reject it (they require `{` before `parse_statement`). The inner `statement*`
///     dispatches each body statement through this same grammar. A standalone block
///     is lookahead-gated: string-keyed map literals route into `expr_stmt`, while
///     `{}` and ordinary statement blocks remain blocks. The if-then uses `block`;
///     the recursive `else statement` remains unrestricted (accepts `else if …`,
///     `else { … }`, and a bare `else <stmt>`).
///
///     POSITION NOTE: this interpreter grammar compares structure only. Its
///     dispatch-only emitted twin uses emit_stmt_list_loop + sp_start-aware builders
///     to reproduce the hand parser's per-child SrcPos side table.
///   * `for_stmt` — ordinary range/collection loops and tuple-destructure bindings
///     are native. The binding sub-rule reserves its gensym before parsing the body,
///     preserving nested-loop temp ordering without allocating AST rows early.
///   * `match_stmt` — the ordinary subject/pattern/guard/expression-body form is
///     grammar-native and PREDICTIVE. The table sub-language is peeled off by
///     `@peek(match_table)` into `@hand(match_table)`
///     only for the distinct subjectless/table/bare-return/quote-splice paths.
///   * `return_stmt` — native and newline-sensitive: its optional expression uses
///     `^` so a value on the next line is not consumed as the return operand.
///   * `stmt_block` — native standalone blocks, gated by `@peek(stmt_block)` so
///     string-keyed map literals retain the expression path.
///   * `expr_stmt` — the fall-through expression statement, over the SAME
///     shared expression grammar (byte-identical to parse_expression), then
///     wrapped as Stmt.Expr exactly as the hand parser does.
///
/// The alternation order (break/continue, the control-flow headers, return/block,
/// then expr_stmt) matches parse_statement's dispatch order.
///
/// The interpreter and static-emitter views differ only in `for_stmt`: the
/// static parser needs bounded `@try` plus its malformed-header edge oracle,
/// while the interpreter can report those errors directly. Keep every other
/// statement rule in one fragment so their native/hand frontier cannot drift.
fn avra_stmt_common_grammar() -> Grammar {
    let gp = grammar {
  // `@peek(if_let) iflet_stmt` comes BEFORE `if_stmt` deliberately, and the ORDER is
  // the load-bearing part: `if_stmt`'s FIRST is a bare `"if"`, so without the gate it
  // matches first, fails parsing `let v = x` as a condition expression, and drops the
  // whole statement to `@hand(decl_hand)`. That single shadowing accounted for 73 of
  // the delegate's remaining dependents (t-myz7).
  //
  // `iflet_stmt` is a rule of its OWN rather than a reference to the expression-view
  // `if_expr`: that rule lives in the expression view and the emitter has no FIRST set
  // for it across views. It previously routed to `expression` for exactly that reason,
  // which parsed the form correctly but lowered it to the EXPRESSION shape — see the
  // WHY on `iflet_stmt` itself for why statement position needs its own lowering.
  statement     = break_stmt | continue_stmt | @peek(if_let) iflet_stmt | if_stmt | for_stmt | while_stmt | match_stmt | defer_stmt | errdefer_stmt | return_stmt | @peek(stmt_block) stmt_block | expr_stmt
  // The CONTROL-FLOW body (`while`/`for`/`if`). `declaration*`, not `statement*`,
  // because that is what the hand does: every one of those parsers ends at
  // `parse_statement_list_ids`, whose per-item call is `self.parse_declaration()`.
  //
  // `statement` carries NO binding alternatives — `let`/`mut`/`const` live only in
  // `declaration` — so with `statement*` here every binding inside a loop or an `if`
  // fell out of the repetition and was absorbed by the `@hand(decl_hand)` gate. That
  // is invisible by comparison (the delegate builds the same tree the native rules
  // would), which is why `while lo < hi { let mid = … }` — one of the most ordinary
  // shapes in the language, and all over this compiler own source — was still
  // hand-parsed. The frontier probe (AVRA_REFUSE_HAND_LEAF, executor.av) surfaced it.
  //
  // It also FIXED ~6000 wrong diagnostic line attributions. The delegate bridge
  // re-syncs by advancing to a byte offset, so nodes built during a delegated parse
  // took whatever line its cursor had reached — arbitrarily far past the construct
  // (measured: a trap for `item.prim` reported a COMMENT 20 lines below it). Native
  // parsing stamps each item from its own entry byte, which is right by construction.
  //
  // Still a SEPARATE rule from `stmt_block` — the two have different roles
  // (`stmt_block` is `@peek`-gated inside `statement`; this is the control-flow body)
  // and the note below rightly warns against deduping them. Same item rule, two rules.
  block         = "{" stmts:declaration* "}" -> Block(stmts)
  // A bare `{ … }` statement body may contain DECLARATIONS, not just statements — an
  // inline module's component is the case that proves it (`declaration = @hand(decl_hand)
  // | statement`, so declaration is the superset). block_expr already uses declaration*
  // for exactly this reason; using statement* here silently dropped that case, which the
  // full suite caught. NOT the same body as `block` — do not "dedupe" the two.
  stmt_block    = "{" stmts:declaration* "}" -> Block(stmts)
  break_stmt    = "break" -> Break()
  continue_stmt = "continue" -> Continue()
  // t-47hc.5: `@require t:block` with the hand's own message AND its F-CODE. Both
  // halves were missing and neither shows until `fn` routes: while the function body
  // rolled back to the hand, `if cond expr` was answered by the hand and this rule's
  // silence never surfaced. Without the `@require` the missing block is not an error at
  // all here, so the rule builds an `if` with no consequent and the enclosing body then
  // reports about ITS closer instead — two diagnostics, neither the hand's one.
  if_stmt       = "if" @onfail(bail) @off(allow_struct_lit) c:expression @require t:block ( "else" e:statement )?
                  @expect("{", "expected `{` after if condition", F0010) -> If(c, t, e)
  for_binding   = lp:"(" ( names:IDENT ( @peek(comma_ident) "," names:IDENT )* ","? )? ")" -> MkForBinding(lp, names)
  // `@onfail(bail)` on the CONDITION: the hand's `parse_expression()?` propagates, so a
  // failed condition ends the rule and the missing block is never reported. `while return
  // 2` is the shape — one F0040 on the hand, and without the bail the native rule went on
  // to report about the `{` too.
  while_stmt    = "while" @onfail(bail) @off(allow_struct_lit) c:expression @require body:block
                  @expect("{", "expected `{` after while condition", F0010) -> While(c, body)
  // t-47hc.22: the SUBJECTLESS form `match { cond -> body }` is grammar-native. Its arms
  // are NOT the expression family's `when_arm`: the hand parse_when_arm_list this mirrors
  // takes `_` as the ONLY default (never `else`, which `when { … }` does accept), so
  // match_when_arm is defined LOCALLY here rather than reusing when_arm — reusing it would
  // silently widen the accepted language. Local also means its FIRST and its `warm` result
  // kind are both derived, with no cross-family declarations. The `@peek` is decisive
  // (`match` then `{`), so the branch is predictive and owns its own `}` diagnostic.
  // What is LEFT for the edge oracle is `match e table { … }`, whose rows must supply
  // exactly as many values as the header row declared — data-dependent, so not a grammar
  // rule at any level of DSL power.
  match_stmt    = @peek(match_subjectless) "match" "{" ( a:match_when_arm ","? )* @require "}" @expect("}", "expected `}` after match arms") -> MkWhenStmt(a)
                // The TABLE sub-language, peeled off by lookahead (`@peek(match_table)` scans
                // to the body brace and asks whether `table` precedes it) and now GRAMMAR-
                // NATIVE (t-47hc.29). The old comment here claimed the row width was "data-
                // dependent and therefore not a grammar rule at any level of DSL power" —
                // that was wrong, and it is what made Phase 4 look structurally impossible.
                // The width is a BOUND, not a computation: the header's first column names
                // the pattern column and the rest are the value columns, so `#cols` IS the
                // hand's `value_count`, and `x{#cols}` (t-47hc.28) expresses it exactly.
                //
                // Header and rows live in ONE branch because a repetition bound may only
                // name a capture collected earlier in the same branch (validate_bounds) and
                // exec_rule mints a fresh CapEnv per rule — so the cells arrive flattened and
                // MkMatchTable re-chunks them by the header count.
                // The rule itself lives in the feature's own fragment (match_expr/grammar.av,
                // t-47hc.8) and is built from a grammar STRING, not a surface `grammar { }`
                // block: its row width is `( … )*{#cols}`, and `#` is not an Avra token, so a
                // `{#cols}` written HERE dies in the lexer (F0001 `unexpected character '#'`)
                // long before parse_grammar ever sees it. Bounded repetition is therefore
                // spendable only from string-built fragments today — the reference below keeps
                // this dogfooded block free of the sigil.
                | @peek(match_table) match_table_stmt
                // With table peeled off, the ordinary form no longer needs to speculate: it
                // is PREDICTIVE and owns BOTH of its diagnostics. Previously the `@try` was
                // load-bearing only because a table header had to be able to roll back
                // through it, which cost every ordinary `match` a snapshot and left the
                // missing-`{` message with the oracle.
                | "match" @off(allow_struct_lit) subj:expression @require "{" ( arms:match_arm ","? )* @require "}" @expect("{", "expected `{` after match subject") @expect("}", "expected `}` after match arms") -> MkMatch(subj, arms)
  // match_when_arm + match_arm moved to features/match_expr/grammar.av
  // (avra_match_arm_grammar) — the expression `match_expr` needs the SAME rules and
  // each family's emitted parser is generated from its own dispatch grammar, so one
  // shared fragment composed into both is the only home that serves both (t-47hc.25).
  defer_stmt    = "defer" e:expression -> MkDefer(e)
  errdefer_stmt = "errdefer" e:expression -> MkErrdefer(e)
  return_stmt   = "return" ( @peek(return_value) @gate @onfail(bail) e:expression )? -> MkReturn(e)
  // STATEMENT-position `if let` — the hand's `parse_if_let_statement`, not its
  // expression twin. Routing this to `expression` (which reaches `if_expr`) parsed the
  // form correctly but lowered it to the WRONG SHAPE: an `ExprStmt(Block-expr)` holding
  // an `if-expr`, where the hand builds a `Stmt.Block` holding a `Stmt.If`. Both run,
  // which is why every diagnostic oracle in error_recovery_differential_test stayed
  // green — a VALID program has no diagnostics to compare, so only the TREE sees it.
  // The two shapes are not interchangeable: with no `else`, the expression form has to
  // SYNTHESISE an empty else block (an if-expr needs a value) while the hand leaves
  // `else_opt` absent, so `if let v = x { … }` grew an else arm the source never wrote.
  //
  // `build_if_let_stmt` (core/arena.av) is the shared core the hand already calls —
  // its header says the native rule lowers to exactly these rows — so the desugar
  // lives in ONE place for both engines, the same discipline `MkIfLet` follows for
  // the expression form.
  //
  // Shape mirrors the `if_expr` if-let branch with STATEMENT bodies (`block` /
  // `statement`, as `if_stmt` uses). The three `@require`s stay the hand's three
  // `return .Err` points, and `tmp:@gensym(iflet)` keeps its position between `"if"`
  // and `"let"` so a nested `if let` still numbers after its parent.
  iflet_stmt    = "if" tmp:@gensym(iflet) "let" @require b:IDENT @require "="
                 @off(allow_struct_lit) s:expression @require t:block ( "else" e:statement )?
                 @expect("IDENT", "expected a binding name after `if let`")
                 @expect("=", "expected `=` after the `if let` binding")
                 @expect("{", "expected `{` after the `if let` binding", F0010) -> MkIfLetStmt(tmp, b, s, t, e)
  expr_stmt     = e:expression -> ExprStmt(e)
    }
    grammar_checked(gp)
}

fn avra_stmt_flip_for_grammar() -> Grammar {
    let gp = grammar {
  for_stmt = @peek(for_destructure) "for" fb:for_binding @require "in" @off(allow_struct_lit) coll:expression body:block @expect("in", "expected `in` after for destructure pattern") -> MkForDestructure(fb, coll, body)
           | "for" v:IDENT @require "in" @off(allow_struct_lit) lo:expression @off(allow_struct_lit) ( ".." hi:expression )? body:block @expect("in", "expected `in` after loop variable") -> ForLoop(v, lo, hi, body)
    }
    grammar_checked(gp)
}

// t-47hc.21: the dispatch view is now IDENTICAL to the flip view above — `@hand(for_stmt_edge)`
// is gone and the branches are predictive, not speculative. Two fixes made that possible:
// `@require` aborts a malformed header before a body is built (no more runaway that ate the
// next declaration), and the flip's error path now surfaces a GRAMMAR-NATIVE diagnostic and
// adopts the DSL's stop byte, so a native rule owns its own message and resync point instead
// of borrowing a hand leaf's.
fn avra_stmt_dispatch_for_grammar() -> Grammar {
    let gp = grammar {
  // t-47hc.21: `@require` (the abort) exists now and fixes the RUNAWAY here — a
  // malformed `for Foo { }` header no longer parses `{ … }` as the collection and
  // swallows the next declaration. It is NOT spent yet: on `impl for Foo { }` the
  // hand oracle resyncs and re-parses `Foo { }` as a struct-literal expr-stmt
  // (F0001 F0001 F0013, two nodes) where the abort yields one (F0001). Spending the
  // capability waits on matching that resync — the oracle is the gate, per the
  // opt-in-primitive discipline.
  for_stmt = @peek(for_destructure) "for" fb:for_binding @require "in" @off(allow_struct_lit) coll:expression body:block @expect("in", "expected `in` after for destructure pattern") -> MkForDestructure(fb, coll, body)
           | "for" v:IDENT @require "in" @off(allow_struct_lit) lo:expression @off(allow_struct_lit) ( ".." hi:expression )? body:block @expect("in", "expected `in` after loop variable") -> ForLoop(v, lo, hi, body)
    }
    grammar_checked(gp)
}

export fn avra_stmt_flip_grammar() -> Grammar {
    let stmt = compose_grammars(avra_stmt_common_grammar(), avra_stmt_flip_for_grammar())
    // The INTERPRETER walks the composed Grammar, so every rule match_stmt references
    // must be DEFINED here — there is no cross-file linking to fall back on the way the
    // emitted parsers have. Missing avra_match_arm_grammar() would leave match_arm /
    // match_when_arm unresolved, the DSL would error on every `match` statement, and the
    // flip would silently fall back to the hand parser: correct output, no diagnostic,
    // and the flip quietly disabled. Caught in review on #1028.
    compose_grammars(compose_grammars(compose_grammars(compose_grammars(compose_grammars(compose_grammars(stmt, avra_expr_core()), avra_decl_edge_grammar()), avra_type_flip_grammar()), avra_pat_grammar()), avra_match_arm_grammar()), avra_match_table_grammar())
}

/// ps3t.6.7 Step G slice 4b — the PRODUCTION declaration / whole-program grammar
/// the declaration flip (`AVRA_PARSER_DECL_FLIP`, parse_declaration) runs. The
/// declaration dispatch splits cleanly by FIRST-set into two arms:
///
///   * `@hand(decl_hand)` — everything parse_declaration handles itself:
///     doc-comment + `@`-annotation + `export` RECURSIVE WRAPPING (position-
///     recorded on the wrapped inner), the decl KEYWORDS (fn/type/enum/…/let/
///     mut/const, each a feature parser), and a bare IDENT — the component-
///     instantiation-vs-expression-statement disambiguation (2-token lookahead
///     the stateless grammar FIRST-set cannot do). All of these MUST stay @hand.
///   * `statement` — the fall-through: every non-declaration item (stmt keywords
///     if/while/for/match/…, `break`/`continue`, `{` blocks, non-ident expression
///     statements), routed to the SAME proven statement grammar the statement
///     flip uses. This is where the real structuralization lives — a function
///     body's statements parse through the DSL, not a blanket @hand.
///
/// The alternation order (decl_hand first, then statement) + hand_starts(
/// "decl_hand") being the exact declaration-lead FIRST-set is what keeps IDENT/`@`
/// on the parse_declaration path (component/annotation) and everything else on
/// the statement path. Byte-identical: each arm's builder IS the hand parser's.
export fn avra_decl_flip_grammar() -> Grammar {
    compose_grammars(avra_decl_edge_grammar(), avra_stmt_flip_grammar())
}

/// ps3t.6.7 Phase 2 — the DISPATCH-ONLY statement grammar the STATIC production
/// parser is emitted from (gen_decl_file.emit_decl_parser_file). It shares
/// avra_stmt_flip_grammar's dispatch SHAPE (break/continue/expr_stmt leaves, same
/// alternation order + FIRST-set) but WITHOUT composing the expression grammar, so
/// `expression` in expr_stmt is an EXTERNAL reference: emitting from this produces
/// only the statement dispatch fns (parse_statement / parse_break_stmt /
/// parse_continue_stmt / parse_expr_stmt) and calls the already-generated
/// `parse_expression` (gen_expr_parser.av, same `parse` module) — so the expr ladder
/// is NOT re-emitted (which would collide fn-for-fn in the flat `parse` module). The
/// INTERPRETER path keeps using the COMPOSED avra_stmt_flip_grammar (exec_rule must
/// walk `expression` in-grammar); both drive the identical builders, and
/// gen_expr_parser's parse_expression is itself proven byte-identical to the
/// interpreter's expr walk.
///
/// PRODUCTION CONTROL-FLOW FLIP (t-47hc.13 STEP 4): mirrors avra_stmt_flip_grammar's
/// grammar-native `if`/`for`/`while` + native `block` — the STATIC production parser
/// now parses control-flow ITSELF instead of delegating to `@hand(stmt_hand)`. The
/// block's inner `statement*` emits the statement-list-with-recovery loop
/// (emit_stmt_list_loop, #984): loop-until-`}`/EOF, per-child SrcPos via to_linecol,
/// panic-mode `synchronize_stmt` + a positioned `Stmt.Error` on a failed child — the
/// generated twin of parse_statement_list_ids, so the per-child positions the
/// position-SENSITIVE static path needs are recorded byte-identically. The
/// `@off(allow_struct_lit)` headers reproduce the hand parsers' struct-literal
/// disambiguation (emit twin: modes save / clear via modes_with_flag_off / restore).
/// A top-level `{` is lookahead-routed to a native block or to the expression path
/// for a string-keyed map literal; defer/errdefer/return are native. Match's
/// ordinary form is native with a narrow edge oracle, and if-ELSE recursively
/// enters the native statement rule. Both `for` families are native outright —
/// `@require` owns the malformed-header abort and the flip surfaces the grammar's own
/// diagnostic, so no edge oracle remains.
/// This is an `intended-ir-change`: the generated
/// parser SOURCE changes, but its OUTPUT AST + SrcPos are byte-identical to the hand
/// parser — gated on `--emit-gen-check` (generated == hand over the selfhost) + the
/// recovery-tree oracle (invalid programs) + run-equiv cold diff-test.
export fn avra_stmt_dispatch_grammar() -> Grammar {
    // The match ARM fragment is composed in rather than defined inline: the
    // expression family needs the identical rules and is emitted from its OWN
    // dispatch grammar, so one shared fragment is the only home that serves both
    // (t-47hc.25). Composed LAST so the statement rules keep leading the merged
    // rule set — the emitted function order is observable.
    compose_grammars(
        compose_grammars(
            compose_grammars(avra_stmt_common_grammar(), avra_stmt_dispatch_for_grammar()),
            avra_match_arm_grammar()
        ),
        avra_match_table_grammar()
    )
}

/// ps3t.6.7 Phase 2 — the DISPATCH-ONLY declaration grammar (the static-emit twin of
/// avra_decl_flip_grammar): `declaration = @hand(decl_hand) | statement` composed
/// with the dispatch-only statement grammar (expression EXTERNAL). This is what
/// gen_decl_file emits the checked-in production declaration static parser from.
export fn avra_decl_dispatch_grammar() -> Grammar {
    compose_grammars(avra_decl_edge_grammar(), avra_stmt_dispatch_grammar())
}

// The §2 match-pattern family (`avra_pat_grammar`) now lives with its owning
// feature at features/match_expr/grammar.av (t-47hc.8 modular fragments) — the
// `match` feature owns its pattern syntax. It composes cleanly here via
// `compose_fragments` (compose.av) if ever needed, but patterns are
// self-contained (they embed no expressions), so no composition is required.

/// The §2 type-expression family (ps3t.6.5.6): union types `A | B`, `fn`
/// types, `dyn T`, list `[T]`, tuple/paren `(A, B)`, and named types with
/// generic args + nullable `T<A>?`. SELF-CONTAINED — types don't embed value
/// expressions. The entry `type_expr` mirrors parse_type_expr (left-assoc
/// union over type atoms).
export fn avra_type_grammar() -> Grammar {
    let gp = grammar {
  type_expr  = l:type_atom ( "|" r:type_atom )* -> TyUnion(l, r)
  type_atom  = qualified_type | fn_type | dyn_type | list_type | paren_type | named_type
  qualified_type = "@" qname:IDENT ( @peek(double_colon) ":" ":" qname:IDENT )+ ( "<" qa:type_expr ( "," qa:type_expr )* ">" )? ( qopt:"?" )? -> MkQualified(qname, qa, qopt)
  fn_type    = "fn" ( lp:"(" ( p:type_expr ( "," p:type_expr )* )? ")" )? ( "->" r:type_expr )? -> MkFn(lp, p, r)
  dyn_type   = "dyn" t:IDENT ( opt:"?" )? -> TyDyn(t, opt)
  list_type  = "[" e:type_expr "]" -> TyList(e)
  paren_type = "(" ( t:type_expr ( "," t:type_expr )* )? ")" -> TyParen(t)
  named_type = name:IDENT ( "." name:IDENT )* ( "<" a:type_expr ( "," a:type_expr )* ">" )? ( opt:"?" )? -> MkNamed(name, a, opt)
    }
    grammar_checked(gp)
}

/// The PRODUCTION type-expression grammar (t-47hc.4.4 Phase 3d — the static
/// type-parser source). It includes the native `@pkg::T` qualified-type form used
/// by the whole-program grammar. This is the family-isolated production view,
/// the sibling of avra_stmt_flip_grammar / avra_decl_flip_grammar: a self-contained grammar the
/// generated static type parser (parse/gen_type_parser.av, via run_static_type) is
/// emitted from, byte-identical to the whole-program grammar's type path (same
/// rules) and to the hand parser (diff-test-gated). `avra_type_grammar()` stays the
/// isolated NO-@hand view the emit-gen-check differential uses unchanged.
export fn avra_type_flip_grammar() -> Grammar {
    let gp = grammar {
  type_expr  = l:type_atom ( "|" r:type_atom )* -> TyUnion(l, r)
  type_atom  = qualified_type | fn_type | dyn_type | list_type | paren_type | named_type
  qualified_type = "@" qname:IDENT ( @peek(double_colon) ":" ":" qname:IDENT )+ ( "<" qa:type_expr ( "," qa:type_expr )* ">" )? ( qopt:"?" )? -> MkQualified(qname, qa, qopt)
  fn_type    = "fn" ( lp:"(" ( p:type_expr ( "," p:type_expr )* )? ")" )? ( "->" r:type_expr )? -> MkFn(lp, p, r)
  dyn_type   = "dyn" t:IDENT ( opt:"?" )? -> TyDyn(t, opt)
  list_type  = "[" e:type_expr "]" -> TyList(e)
  paren_type = "(" ( t:type_expr ( "," t:type_expr )* )? ")" -> TyParen(t)
  named_type = name:IDENT ( "." name:IDENT )* ( "<" a:type_expr ( "," a:type_expr )* ">" )? ( opt:"?" )? -> MkNamed(name, a, opt)
    }
    grammar_checked(gp)
}

/// t-47hc slice 9 — the DECL-keyword fragment registry: every feature that owns a
/// declaration keyword contributes its rule(s) from its own directory, and this
/// is the ONE list they are collected in. Adding a decl keyword is one line here
/// plus a `grammar { }` block in the feature — never an edit to the central
/// grammar body, which is the property the `decl_hand` flip spends.
///
/// Ordering is irrelevant to meaning (nonterminals bind by name after the flat
/// merge) but IS stable here, so the composed rule list is deterministic.
///
/// `param` is deliberately NOT here: it is referenced by `fn_decl`,
/// `method_member` and `impl_method`, so no single feature owns it — it stays in
/// the shared base beside the expression ladder and the type spine.
export fn feature_decl_grammar_fragments() -> List<Grammar> {
    [
        avra_fn_decl_grammar(),      // fn_decl
        avra_struct_decl_grammar(),  // type_decl, field
        avra_enum_decl_grammar(),    // enum_decl, variant
        avra_trait_decl_grammar(),   // trait_decl, trait_member, assoc_member, method_member
        avra_impl_decl_grammar(),    // impl_decl, impl_method
        avra_modules_grammar(),      // use_decl, mod_decl
        avra_generics_grammar(),     // tparam — shared by every generic decl keyword
    ]
}

/// The UNIFIED whole-program Avra grammar (ps3t.6.5.7 / the 6.5.11 composed
/// slice): declarations on top, folding into a `program`, with one canonical
/// version of each shared rule (declarations + their sub-structure, the
/// statement forms incl. control-flow, the type atoms, and the expression
/// precedence chain). The gnarly-5% forms delegate via @hand — `return`
/// (newline-sensitive), `let` (let-else desugar), `@pkg::T` (qualified type),
/// `~`/quote (splice-vs-bitnot), and `ident`. This is the whole-program grammar
/// dogfooded into src/ (distinct from the per-family avra_*_grammar() blocks,
/// which are the family-ISOLATED views the equivalence tests use); the 6.5.12
/// swap-in consolidates onto one. NOTE the rule bodies carry literal `"{"` /
/// `"}"` block delimiters — balanced, so the `grammar { }` surface capture
/// finds the block's real closing brace correctly.
export fn avra_program_grammar() -> Grammar {
    let gp = grammar {
  program     = ( d:declaration )* -> Block(d)
  declaration = fn_decl | extern_decl | type_decl | shape_decl | enum_decl | trait_decl | impl_decl | use_decl | mod_decl
  // Defined in BOTH views, like every other rule the shared decl fragments reach: the
  // §2 program grammar and the production decl view compose different rule sets, and
  // `type_decl` (a shared fragment) names this one, so a definition in only one view
  // leaves the other with an unknown rule and a hard parse failure.
  name_or_splice = @when(in_quote_body) "~" sn:IDENT -> MkSpliceName(sn)
                 | pn:IDENT -> MkPlainName(pn)
  // t-20wd — the BODY nonterminal, defined per VIEW. This §2 `declaration` is
  // declarations-ONLY (no `statement` tail), so a body here must be a statement list.
  // The production view (avra_decl_edge_grammar) defines it as `declaration`, whose tail
  // IS `statement` — a superset that also reaches the `decl_lead` component gate, which
  // is what a fn body needs and what the hand parser does. The two views never compose
  // each other, so each owns its own definition and the shared fragments stay body-agnostic.
  body_item   = statement
  // The TYPE position is `@require`d, keyed on the rule NAME because `type_expr`'s FIRST
  // is a disjunction with no single token to name (t-myz7) — the same treatment `field`
  // already has, for the same reason. Unrequired, a missing type did not abort: the
  // expression view reported its own generic F0040 and the type view added "expected a
  // type", so `fn foo(x: ) -> int { 1 }` came out F0040 + F0001 where the hand reports
  // "expected parameter type after `:`" and stops.
  param       = pname:IDENT ( ":" @require pt:type_expr )?
                 @expect("IDENT", "expected parameter name") 
                 @expect("type_expr", "expected parameter type after `:`") -> MkParam(pname, pt)
  statement   = return_stmt | @hand(let_stmt) | defer_stmt | errdefer_stmt | block_stmt | while_stmt | if_stmt | for_stmt | break_stmt | continue_stmt | expr_stmt
  return_stmt = "return" ( @peek(return_value) @gate @onfail(bail) rv:expression )? -> MkReturn(rv)
  defer_stmt  = "defer" de:expression -> MkDefer(de)
  errdefer_stmt = "errdefer" ee:expression -> MkErrdefer(ee)
  block_stmt  = "{" ( bs:statement )* "}" -> Block(bs)
  while_stmt  = "while" wc:expression wb:block_stmt -> While(wc, wb)
  if_stmt     = "if" ic:expression it:block_stmt ( "else" ie:else_target )? -> If(ic, it, ie)
  else_target = if_stmt | block_stmt
  for_stmt    = "for" fv:IDENT "in" flo:expression ( ".." fhi:expression )? fb:block_stmt -> ForLoop(fv, flo, fhi, fb)
  break_stmt  = "break" -> Break()
  continue_stmt = "continue" -> Continue()
  expr_stmt   = es:expression -> ExprStmt(es)
  type_expr   = l:type_atom ( "|" r:type_atom )* -> TyUnion(l, r)
  type_atom   = qualified_type | fn_type | dyn_type | list_type | paren_type | named_type
  qualified_type = "@" qn:IDENT ( @peek(double_colon) ":" ":" qn:IDENT )+ ( "<" qargs:type_expr ( "," qargs:type_expr )* ">" )? ( qopt:"?" )? -> MkQualified(qn, qargs, qopt)
  fn_type     = "fn" ( lp:"(" ( p:type_expr ( "," p:type_expr )* )? ")" )? ( "->" tr:type_expr )? -> MkFn(lp, p, tr)
  dyn_type    = "dyn" dt:IDENT ( opt:"?" )? -> TyDyn(dt, opt)
  list_type   = "[" el:type_expr "]" -> TyList(el)
  paren_type  = "(" ( pt2:type_expr ( "," pt2:type_expr )* )? ")" -> TyParen(pt2)
  named_type  = tn:IDENT ( "." tn:IDENT )* ( "<" a:type_expr ( "," a:type_expr )* ">" )? ( opt:"?" )? -> MkNamed(tn, a, opt)
  expression  = equality
  equality    = l:comparison ( op:("!=" | "==") r:comparison )* -> fold_binary(l, op, r)
  comparison  = l:term ( op:("<" | "<=" | ">" | ">=") r:term )* -> fold_binary(l, op, r)
  term        = l:factor ( op:("+" | "-") r:factor )* -> fold_binary(l, op, r)
  factor      = l:un ( op:("*" | "/") r:un )* -> fold_binary(l, op, r)
  un          = op:("!" | "-" | "not" | "~") operand:un -> Unary(op, operand) | postfix
  postfix     = base:primary ( s:suffix )* -> fold_postfix(base, s)
  suffix      = "." sn:IDENT -> field_suffix(sn)
              | "(" ( ca:expression ( "," ca:expression )* )? ")" -> call_suffix(ca)
  primary     = NUMBER | STRING | "true" | "false" | @hand(quote_expr) | IDENT
    }
    // The DECLARATION rules are no longer here: each decl keyword's rule is owned
    // by its own feature (features/<name>/grammar.av) and collected through the
    // registry, exactly as the pattern rules already are. `declaration` above
    // still names them — cross-fragment nonterminal references bind by name
    // against the merged rule set, so the composed grammar is the same language.
    // This block stays FIRST so `program` remains the start symbol.
    mut frags: List<Grammar> = [grammar_checked(gp)]
    for g in feature_decl_grammar_fragments() {
        frags.push(g)
    }
    compose_fragments(frags)
}
