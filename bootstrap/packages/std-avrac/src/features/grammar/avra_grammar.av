// WHY: ps3t.6.5.11 — Avra's grammar, DOGFOODED into compiler `src/` as an

use features.grammar.{Grammar, compose_fragments, compose_grammars, grammar_checked, parse_grammar}
use features.match.{avra_pat_grammar, avra_match_arm_grammar, avra_match_stmt_grammar, avra_match_table_grammar}
// t-47hc.8 — the statement-family registry: every feature whose gram declares
// `gram_family = "stmt"`, in registration order. The statement views fold it
// in below, so a statement keyword's rules live ONLY in its feature file.
// t-kd4y.3.4 added its EXPRESSION twin: every feature whose gram declares
// `gram_family = "expr"`, folded in by `avra_expr_core`, so an expression
// keyword's rules live ONLY in its feature file while the ladder that
// DISPATCHES to them stays here.
use features.{feature_stmt_grammar_fragments, feature_expr_grammar_fragments, feature_type_grammar_fragments}
// t-47hc slice 9 — the DECL-keyword grammar fragments, each owned by the feature
// that owns the keyword (the same colocation `match` already has for
// patterns). Imported here rather than assembled in features/mod.av because this
// file is where the whole-program grammar is composed; features/mod.av's
// `feature_grammar_fragments` re-exports the same list, so there is ONE
// definition of "which features contribute decl fragments".
use features.fn_decl.{avra_fn_decl_grammar}
use features.struct_decl.{avra_struct_decl_grammar}
use features.enum_decl.{avra_enum_decl_grammar}
use features.trait_decl.{avra_trait_decl_grammar}
use features.impl_decl.{avra_impl_decl_grammar}
use features.annotations.{avra_annotations_grammar}
use features.modules.{avra_modules_grammar, avra_export_grammar}
use features.select_stmt.{avra_select_grammar}
use features.parallel_stmt.{avra_parallel_grammar}
use features.spec_test.{avra_spec_grammar}
use features.let_stmt.{avra_let_grammar}
use features.component_decl.{avra_component_grammar}
// t-47hc slice 10.3 — `tparam`, shared by every generic decl keyword.
use features.generics.{avra_generics_grammar}

/// The canonical §2 Avra expression grammar as a `grammar { }` block. The DSL
///
/// The ENGINE's own expression rules: the precedence ladder, the postfix
/// chain, the primary dispatch skeleton, and `table_cell` — structure, not
/// syntax any one feature owns. NO feature fragments are folded in here;
/// `avra_expr_core` below composes those on top. The two are split so the
/// disjointness property (spine ∩ feature fragments = ∅) stays checkable as
/// expression families migrate out (t-kd4y.3.4/.3.5) — this function is what
/// SHRINKS with each flip, and what must eventually be ladder-only.
export fn avra_expr_spine_grammar() -> Grammar {
    let gp = grammar {
  expression    = assignment
  // The OPERATOR LADDER threads through feature-owned strata BY NAME
  // (t-kd4y.3.5.7); only the dispatch skeleton stays here:
  //   `assignment` + `equality` — features/struct_decl's field_assign_lang
  //     (the LHS-bail posture and the rebind_eq retargeting ride their
  //     comments there);
  //   `pipe` / `pipe_arg` — features/pipe_op;
  //   `null_coalesce` — features/null_safety's null_coalesce_lang;
  //   `logic_or` / `logic_and` — features/logical_op;
  //   `is_tail` / `in_tail` (+ `in_rhs`) / `eqchain_tail` — the eq_tail
  //     branches, with features/is_keyword, features/in_operator, and
  //     features/eq_chain.
  // eq_tail is PURE DISPATCH over those three tails — distinct FIRSTs
  // (`is` / `in` / `==`|`!=`), the hand parse_equality's mutual
  // exclusion. Each tail builds a PARTIAL with a MISSING subject;
  // `equality`'s rebind_eq installs the real base and stamps the final.
  eq_tail       = is_tail | in_tail | eqchain_tail
  bitor      = l:bitxor ( op:("|") r:bitxor )* -> fold_binary(l, op, r)
  bitxor     = l:bitand ( op:("^") r:bitand )* -> fold_binary(l, op, r)
  bitand     = l:comparison ( op:("&") r:comparison )* -> fold_binary(l, op, r)
  comparison = l:shift ( op:("<" | "<=" | ">" | ">=") r:shift )* -> fold_binary(l, op, r)
  shift      = l:term ( op:("<<" | ">>") r:term )* -> fold_binary(l, op, r)
  term       = l:factor ( op:("+" | "-") r:factor )* -> fold_binary(l, op, r)
  factor     = l:unary ( op:("*" | "/" | "%") r:unary )* -> fold_binary(l, op, r)
  // The SPLICE branches lead and `unary_prefix` (features/unary_op — the
  // `!`/`-`/`not`/`~` prefix ops, t-kd4y.3.5.7) follows: `~` is two
  // operators either side of the quote-depth line, and the gates are
  // exact complements (`in_quote_body` = depth > 0, `at_quote_top` =
  // depth == 0 inside unary_prefix), so no input satisfies both and this
  // order is behavior-identical to the retired in-spine one — while
  // keeping the referenced rule's broad FIRST (`~` included) from
  // swallowing an in-quote splice.
  // The @peek LEADS the marker run (marker order is semantically
  // insignificant, but the ambiguity guard's peek-exemption reads the
  // branch's LEAD item — @when-first read as an unpartitioned `~` shadow
  // over the later splice/prefix branches and went red at the first full
  // gate on this slice).
  unary      = @peek(tilde_ident_lbrace) @when(in_quote_body) @when(allow_struct_lit) "~" n:IDENT "{" ( @onfail(bail) f:field_init )* "}" -> MkSpliceStruct(n, f)
             | @when(in_quote_body) "~" t:unary -> MkSplice(t)
             | unary_prefix
             | b:NUMBER ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | b:STRING ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | b:BOOL ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | b:("null" | "none") ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
             | base:variant_ctor ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:match_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:if_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:spawn_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:channel_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:isolated_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:when_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(quote_arm) base:quote_arm_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(quote_type) base:quote_type_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:quote_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:list_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:brace_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:qualified_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:paren_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | base:template_lit ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_lbrace_feature) base:grammar_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_lbrace_feature) base:table_lit ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_lbrace_plain) @when(allow_struct_lit) base:struct_lit_expr ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_template) base:tagged_template ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(base, p, s)
             | @peek(ident_plain) b:IDENT ( p:postfix_suffix )* ( @onfail(bail) s:with_suffix )* -> fold_postfix_with(b, p, s)
  // `grammar_expr` lives with the grammar feature (features/grammar's
  // grammar_block_lang, gram_family = "expr", t-kd4y.3.5.6) — the
  // @peek(ident_lbrace_feature) REGISTRY-gate history rides its comments.
  // The `table [<Row>] { … }` literal (table_lit / table_head / table_row)
  // lives with the table_lit feature (gram_family = "expr", t-kd4y.3.5.5)
  // — dispatched from the ladder above by name behind
  // @peek(ident_lbrace_feature); the line-sensitivity and bail history
  // ride the rules' own comments there.
  // `struct_lit_expr` + the shared `field_init` live with the struct_lit
  // feature (features/struct_decl's struct_lit_lang, gram_family = "expr",
  // t-kd4y.3.5.6); qualified_expr / with_suffix / the splice-struct branch
  // reference `field_init` cross-fragment by name.
  // `tagged_template` + `template_lit` live with the templates feature
  // (templates_lang, gram_family = "expr", t-kd4y.3.5.9) — the primary
  // alternation dispatches to them by name (TEMPLATE-led, and IDENT-led
  // behind @peek(ident_template)).
  // `qualified_expr` lives with the modules feature (qualified_ref_lang,
  // gram_family = "expr", t-kd4y.3.5.6) — the @require'd-segment reporting
  // posture rides its comments there.
  brace_expr   = @peek(brace_map) map_literal | block_expr
  // `map_literal` lives with the map_lit feature (gram_family = "expr",
  // t-kd4y.3.5.4) — `brace_expr` above dispatches to it by name.
  // t-47hc.33 — the postfix chain, as PURE DISPATCH (t-kd4y.3.5.8).
  //
  // Every suffix form lives with its feature — unwrap_suffix (`!`/`?`) +
  // catch_suffix + optcall_suffix/optchain_suffix ride features/null_safety,
  // enum_ctor_suffix rides features/struct_decl's enum_ctor_lang,
  // tuple_suffix features/tuples, field_suffix (`.field` + the `@fallback`
  // `.` diagnostic owner) features/struct_decl's field_access_lang, and
  // index_suffix / call_suffix / call_arg / index_tail features/calls. The
  // spine keeps only WHICH rules the chain tries, and in what order — the
  // same skeleton/content split as `unary` and `eq_tail`.
  //
  // ORDER + the zero-width gates are load-bearing on the `.`-led branches:
  // enum_ctor_suffix / tuple_suffix / field_suffix share the `.` FIRST, and
  // the ambiguity guard exempts an overlapping pair only when the earlier
  // branch LEADS with `@peek` (first_follow.seq_is_peek_led inspects
  // items[0].prim and nothing else) — hence the explicit dispatch-level
  // peeks, each duplicating the referenced rule's own leading gate
  // (zero-width and ANDed, so the duplication accepts exactly the same
  // inputs). field_suffix goes LAST of the three because its `@fallback`
  // branch owns the diagnostic for a `.` that completes no step — sorted
  // earlier it would swallow `.0` / `.Variant(` before their peeks ran.
  // The `?.`-led pair is the same shape read in opposite directions:
  // optcall_suffix leads with @peek(qdot_method_call), optchain_suffix
  // takes the remainder. Every step build is chain-threaded
  // (postfix_step_node), so each sub-rule gets the snap at ITS entry —
  // between dispatch entry and sub-rule entry only zero-width gates run,
  // so the frozen base is byte-identical to the retired inline form's.
  postfix_suffix = unwrap_suffix
                 | catch_suffix
                 | @peek(qdot_method_call) optcall_suffix
                 | optchain_suffix
                 | @peek(dot_enum_ctor) enum_ctor_suffix
                 | @peek(dot_number) tuple_suffix
                 | field_suffix
                 | index_suffix
                 | call_suffix
  // At least ONE field: `parse_field_init_list` opens with
  // `consume_identifier("expected field name")?`, so `a with { 1 }` is an ERROR there.
  // A `@peek`-gated `*` made it optional instead — the loop took zero iterations, `with`
  // succeeded with no overrides, and `{ 1 }` fell out as a separate block statement with
  // NO diagnostic at all. A zero-match `+` fails the rule, which is exactly that
  // behaviour.
  // `with_suffix` lives with the with feature (with_expr_lang,
  // gram_family = "expr", t-kd4y.3.5.6) — every unary branch's suffix
  // tail references it by name; fold_postfix_with stays engine-core.
  // `variant_ctor` + the postfix `.Variant(args)` SUFFIX rule
  // (enum_ctor_suffix) live with the enum_ctor feature (features/
  // struct_decl's enum_ctor_lang, gram_family = "expr", t-kd4y.3.5.6 +
  // .3.5.8).
  // channel_expr lives with its feature (features/channels, gram_family =
  // "expr", t-kd4y.3.5.1) — referenced from the ladder above by name.
  // The `quote` family lives with its feature (features/quote_expr, gram_family
  // = "expr", t-kd4y.3.4): quote_expr / quote_type_expr / quote_arm_expr are ONE
  // definition each in features/quote_expr/mod.av and reach every expression view
  // through feature_expr_grammar_fragments below. The three references above —
  // @peek(quote_arm) / @peek(quote_type) / the unguarded catch-all, in that order —
  // are the ENGINE LADDER's dispatch and stay here: which primaries `unary` tries,
  // and in what order, is spine structure. The rules they name are not.
  //
  // The `unary` splice branches above stay too, and they READ what the moved
  // rules write: `@bump(quote_depth)` wraps every quote body, so
  // `@when(at_quote_top)` sees bitnot and `@when(in_quote_body)` sees a splice
  // — a COUNTER, so a nested quote still resolves at the right depth.
  // spawn_expr / isolated_expr live with their features (features/spawn_expr
  // + features/isolated_expr, gram_family = "expr", t-kd4y.3.5.1) — both
  // referenced from the ladder above by name, both carrying the t-rd44
  // `@require body:block_expr` gate (double-keyed @expect in fragment form).
  block_expr   = "{" @on(allow_dot_postfix) stmts:declaration* "}"
                 @expect("}", "expected `}` after block expression") -> MkExprBlock(stmts)
  // when_expr + when_arm live with the when feature (features/match's
  // when_lang, gram_family = "expr", t-kd4y.3.5.2) — referenced from the
  // ladder above by name.
  // match_expr lives with its feature (features/match's stmt fragment,
  // t-kd4y.3.5.2) — same three shapes as match_stmt, referenced from the
  // ladder above by name. match_arm / match_when_arm remain the shared
  // fragment's rules (their FIRSTs declared in emit.rule_first_guard).
  // if_expr + else_tail live with the if feature (features/if_stmt's
  // avra_if_expr_grammar, composed into if_lang's gram — t-kd4y.3.5.2);
  // referenced from the ladder above by name, like iflet_expr always was.
  // The `[`-led family (list_expr / list_comp) lives with the list_lit
  // feature (gram_family = "expr", t-kd4y.3.5.4) — referenced from the
  // ladder above by name; the comp-branch resync history rides the rules'
  // own comments there.
  // The `(`-led paren family (paren_expr / lambda_body) lives with the
  // closures feature (gram_family = "expr", t-kd4y.3.5.3) — referenced
  // from the ladder above by name. The F4014 exponential-backtracking
  // history rides the rules' own comments there.
  // The shared `param` rule lives there too (MkParam is closures' row);
  // fn/trait/impl/component reference it cross-fragment by name.
  // t-47hc.29 — a match-table CELL, in
  // its own dispatch order, and deliberately NARROWER than the full expression
  // primary: a quote SPLICE and the PREFIX operators
  // (`!`, `-`, `not`, `~`) are excluded. Measured:
  // a cell of `1` reaches typecheck, a cell of `-1` is
  // `error[F0040]: expected expression`. Widening cells to the full primary would start
  // ACCEPTING `-1` and silently widen the language.
  //
  // It lives HERE, in the expression family, rather than beside its `match_table_stmt`
  // caller: every alternative below is LOCAL to this view but EXTERNAL to the statement
  // view, so defining it there would demand a declared FIRST for all seventeen. Defined
  // once here it is emitted as `parse_table_cell` into the expression parser and CALLED
  // from the declaration parser across the merged `parse/` namespace — the same crossing
  // `parse_pattern_or` and `parse_match_arm` already make (its own FIRST is declared in
  // emit.rule_first_guard).
  // `n:` on the null/none alternation is LOAD-BEARING, not decoration. NUMBER/STRING/BOOL
  // are token-CLASS primaries and emit `CapVal.Node(literal_node(…))` unlabelled, but a
  // literal ALTERNATION emits `advance(); CapVal.Nil` — the token is consumed and the value
  // dropped, so `capval_to_expr` reports "expected an expression" for a `null` cell that
  // must parse as Expr.None. The label retains a `CapVal.Tok`, which
  // capval_to_expr routes through the same `literal_node` (which builds Expr.None by `tk`).
  // Caught in review on #1039; pinned by match_table_native_test.
  table_cell   = qualified_expr | NUMBER | STRING | BOOL | null_cell | variant_ctor
               | @peek(ident_lbrace_plain) @when(allow_struct_lit) struct_lit_expr
               | @peek(ident_template) tagged_template
               | @peek(ident_plain) IDENT
               // The FEATURE forms (t-47hc.5). `ident_plain` and `ident_lbrace_plain` both
               | @peek(ident_lbrace_feature) grammar_expr
               | @peek(ident_lbrace_feature) table_lit
               | paren_expr | list_expr | match_expr | if_expr
               | spawn_expr | channel_expr | isolated_expr | when_expr
               | @peek(quote_arm) quote_arm_expr | @peek(quote_type) quote_type_expr | quote_expr
               | template_lit | brace_expr
  // A `-> n` Var build (the `eq_tail`/`-> ir` form): labelling alone still returns Nil,
  // because a branch with no build yields Nil regardless. The build hands back the captured
  // `CapVal.Tok`, which capval_to_expr routes through literal_node.
  null_cell    = n:( "null" | "none" ) -> n
    }
    grammar_checked(gp)
}

/// The expression family as every view consumes it: the engine spine above,
/// then every feature-owned expression fragment the registry collects.
/// Composed rather than concatenated by hand for the same reason
/// `avra_decl_edge_grammar` composes its decl fragments — a feature's rules
/// bind by NAME against the merged rule set, so the ladder can reference
/// `quote_expr` without defining it.
fn avra_expr_core() -> Grammar {
    mut frags: List<Grammar> = [avra_expr_spine_grammar()]
    for g in feature_expr_grammar_fragments() { frags.push(g) }
    compose_fragments(frags)
}

/// The §2 expression grammar the INTERPRETER runs (run_grammar_expr / the
/// Language record's `exprs()` view / the equivalence oracles) — SELF-CONTAINED:
/// it composes declarations/statements for expression blocks, types for typed lambdas and
/// channels, and patterns for match statements nested in those blocks. The EMIT view keeps
/// those families EXTERNAL (avra_expr_dispatch_grammar), so the checked-in parser calls the
/// already-emitted parse_declaration / parse_type_expr functions rather than re-emitting them.
/// This is the same interpreter/dispatch split used by the statement family.
/// The declaration edge shared by every interpreter composition that can enter
/// an expression block. Keeping this as one fragment avoids duplicating the
/// declaration alternation while block bodies call `declaration*`.
///
/// t-47hc.24 — the `@peek(decl_lead)` gate is what makes the second alternative
/// carry real weight: for an identifier lead the only declaration-shaped form is the
/// component instantiation `Comp inst { … }`, so the gate keeps the
/// component shape on the component path and lets every other identifier-led item
/// (`x = 1`, `f(a)`, `x.m()`) reach `statement` directly,
/// which is where they were always going to be parsed.
///
/// The modules fragment is composed HERE rather than at the call sites, so the rules
/// travel with the rule that references them. `declaration` is composed into five
/// different views (expr / stmt-flip / decl-flip / decl-dispatch / program); if
/// `use_decl` were external to any of them, emit would demand a declared FIRST for it
/// in `rule_first_guard` — the cross-view cost `table_cell` already pays. Keeping the
/// definition adjacent to its only reference avoids that entirely.
fn avra_decl_edge_grammar() -> Grammar {
    let gp = grammar {
  // t-myz7: a CONVERTED keyword is referenced BARE — its `@try` lives inside the
  // fragment, sharing a branch with the `@cut` that lets it own its own recovery.
  // `let_decl` PRECEDES `letdes_decl`, and that works only because `let_decl` carries
  // NO `@cut`: its `n:IDENT` fails on `(`, the `@try` rewinds, and the destructuring
  // form gets its turn. Giving `let_decl` a `@cut` (as its conversion will) makes
  // `letdes_decl` UNREACHABLE — at that point the two must swap, with the more
  // specific `let (` form first. Recorded because the breakage would be silent:
  // destructuring would simply stop parsing, with no diagnostic naming the cause.
  // `~name` in a NAME slot — legal ONLY inside a quote body, where it splices a
  // macro-scope variable into the position (t-47hc.5).
  // `consume_name_or_splice` is the oracle: it encodes the splice by PREFIXING the name
  // with `~` and carrying it as an ordinary name string, which the quote LOWERER reads
  // back out — so this rule must produce the same string rather than a new node kind.
  //
  // The `@when` is what keeps `type ~name` a parse error OUTSIDE a
  // quote, which is the other half of the contract.
  name_or_splice = @when(in_quote_body) "~" sn:IDENT -> MkSpliceName(sn)
                 | pn:IDENT -> MkPlainName(pn)
  declaration = use_decl | mod_decl | shape_decl | enum_decl | type_decl | extern_decl | fn_decl | trait_decl | impl_decl | export_decl | doc_decl | mdoc_decl | annot_decl | letdes_decl | let_decl | mut_decl | const_decl | select_decl | parallel_decl | spec_decl | comp_header | bare_comp_inst_raw | @try bare_comp_inst | statement
  // The prefix WRAPPERS live with their features now (t-kd4y.3.5.9):
  // `export_decl` / `exportable_decl` / `exportable_inner` with the modules
  // feature (export_lang — the no-stack inner, the MkStampAt split, and the
  // mirrored-alternation contract ride its comments), and `doc_decl` /
  // `mdoc_decl` / `annot_decl` / `annot` / `wrapped_inner` with the
  // annotations feature (annotations_lang — the stacking recursion, the
  // F0040 reporting posture, and the component-in-wrapped_inner note ride
  // there). `declaration` above dispatches to them by name, cross-fragment.
  // The `let` / `mut` / `const` BINDINGS live in their feature now
  // (t-kd4y.3.2.3): `let_decl` / `mut_decl` / `const_decl` / `letdes_decl`
  // in features/let_stmt/grammar.av — composed in below, referenced from
  // the alternations above by name (their lowerings are the let feature's
  // manifest rows).
  // The CONCURRENCY statements (t-47hc Phase 4) live in their features now
  // (t-kd4y.3.2.4): `parallel_decl` in features/parallel_stmt/grammar.av,
  // `select_decl` + `select_arm` in features/select_stmt/grammar.av — both
  // composed in below, both referenced from the alternations above by name.
  // The SPEC-TEST blocks (spec_decl / spec_item / given_blk / then_blk) live in
  // features/spec_test/grammar.av and are composed in below (t-kd4y.3.2.5).
  // The COMPONENT family lives in its feature now (t-kd4y.3.3.5): the
  // whole definition + instantiation rule set (comp_header / component_decl
  // / comp_paren_decl / comp_impl_inst / the config/children/body blocks /
  // comp_inst / bare_comp_inst(_raw) / config_pair / comp_block_item /
  // comp_item / comp_field) in features/component_decl/grammar.av —
  // composed in below, referenced from the alternations above by name
  // (their lowerings are the component feature's manifest rows).
  // `body_item` STAYS here: fn/trait/impl method bodies reference it — it
  // is shared base, not component surface.
  // On the PRODUCTION path a routed body is a DECLARATION list,
  // matching parse_statement_list_ids (which re-enters parse_declaration per
  // item) and the precedent `stmt_block` / `block_expr` already set. Using `statement`
  // here silently drops the component instantiation, which decl_lead_gate_test caught.
  body_item   = declaration
    }
    // Flat list, not a seven-deep `compose_grammars` nest: `compose_grammars(head, tail)`
    // IS `compose_fragments([head, tail])`, and compose_fragments concatenates rules in
    // list order, so the two spellings are provably identical — this one just doesn't
    // grow a paren layer per decl fragment.
    // NOTE this list and `feature_decl_grammar_fragments` (below) carry the
    // SAME fragment set in DIFFERENT orders — this one is what the
    // production decl views compose, that one is what features/mod.av's
    // registry folds; the orders differ historically and the emitted fn
    // order is observable, so they are extended in lockstep rather than
    // unified (a new decl fragment goes in BOTH — t-kd4y.3.5.9 was caught
    // by exactly this: the export/annotations fragments landed in one list
    // and the regenerated parser silently lost parse_export_decl).
    compose_fragments([
        grammar_checked(gp),
        avra_modules_grammar(),
        avra_export_grammar(),
        avra_annotations_grammar(),
        avra_struct_decl_grammar(),
        avra_generics_grammar(),
        avra_enum_decl_grammar(),
        avra_fn_decl_grammar(),
        avra_trait_decl_grammar(),
        avra_impl_decl_grammar(),
        avra_select_grammar(),
        avra_parallel_grammar(),
        avra_spec_grammar(),
        avra_let_grammar(),
        avra_component_grammar(),
    ])
}

export fn avra_expr_grammar() -> Grammar {
    compose_grammars(
        compose_grammars(
            compose_grammars(avra_expr_core(), avra_decl_dispatch_grammar()),
            avra_type_grammar()
        ),
        avra_pat_grammar()
    )
}

/// The DISPATCH-only expression grammar (== avra_expr_core): `type_expr` in paren_expr's
/// `param` and block-expression `declaration` stay EXTERNAL references. Historically the
/// per-family static parser was emitted from this view; production emission now runs over
/// THE full grammar (Language.full() → parse/gen_parser.av), and this view survives as a
/// composition internal + test surface. The dispatch twin of avra_stmt_dispatch_grammar.
export fn avra_expr_dispatch_grammar() -> Grammar {
    avra_expr_core()
}


/// The statement-family tail every statement view composes — the match
/// fragments plus the feature registry, written ONCE. A view adds only what
/// distinguishes it (the flip view: the expr/decl/type/pat rule sets its
/// interpreter needs defined locally; the dispatch view: nothing). The for
/// rules ride the registry now (for_lang's gram, t-47hc.8).
fn stmt_family_fragments() -> List<Grammar> {
    mut fr: List<Grammar> = [avra_match_arm_grammar(), avra_match_stmt_grammar(), avra_match_table_grammar()]
    for g in feature_stmt_grammar_fragments() { fr.push(g) }
    fr
}

/// ps3t.6.7 Step G slice 4 — the PRODUCTION statement grammar the statement
fn avra_stmt_common_grammar() -> Grammar {
    let gp = grammar {
  // `@peek(if_let) iflet_stmt` comes BEFORE `if_stmt` deliberately, and the ORDER is
  statement     = break_stmt | continue_stmt | @peek(if_let) iflet_stmt | if_stmt | for_stmt | while_stmt | match_stmt | defer_stmt | errdefer_stmt | return_stmt | @peek(stmt_block) stmt_block | expr_stmt
  // The CONTROL-FLOW body (`while`/`for`/`if`). `declaration*`, not `statement*`,
  // because that is what parse_statement_list_ids does: its
  // per-item call is `parse_declaration()`.
  //
  // `statement` carries NO binding alternatives — `let`/`mut`/`const` live only in
  // `declaration` — so with `statement*` here every binding inside a loop or an `if`
  // (`while lo < hi { let mid = … }`, one of the most ordinary
  // shapes in the language) fell out of the repetition.
  //
  // Native parsing stamps each item from its own entry byte, which is right by
  // construction.
  //
  // Still a SEPARATE rule from `stmt_block` — the two have different roles
  // (`stmt_block` is `@peek`-gated inside `statement`; this is the control-flow body)
  // and the note below rightly warns against deduping them. Same item rule, two rules.
  block         = "{" stmts:declaration* "}" -> Block(stmts)
  // A bare `{ … }` statement body may contain DECLARATIONS, not just statements — an
  // inline module's component is the case that proves it (`declaration` is the native
  // declaration arms followed by a `statement` tail, so declaration is the superset). block_expr already uses declaration*
  // for exactly this reason; using statement* here silently dropped that case, which the
  // full suite caught. NOT the same body as `block` — do not "dedupe" the two.
  stmt_block    = "{" stmts:declaration* "}" -> Block(stmts)
  // match_stmt / match_when_arm / match_arm live with their owning feature
  // (avra_match_stmt_grammar / avra_match_arm_grammar, features/match); the
  // rest of the statement family — defer / errdefer / return / while / if /
  // iflet / for / break / continue — rides the feature_stmt_grammar_fragments
  // registry (t-47hc.8): the `statement` alternation above names each rule
  // and the reference binds against the composed rule set. ONE definition
  // each, in the feature's own file; the views only choose dispatch order.
  expr_stmt     = e:expression -> ExprStmt(e)
    }
    grammar_checked(gp)
}



export fn avra_stmt_flip_grammar() -> Grammar {
    let stmt = avra_stmt_common_grammar()
    // The INTERPRETER walks the composed Grammar, so every rule match_stmt references
    // must be DEFINED here — there is no cross-file linking to fall back on the way the
    // emitted parsers have. Missing avra_match_arm_grammar() would leave match_arm /
    // match_when_arm unresolved and the DSL would error on every `match`
    // statement. Caught in review on #1028.
    mut frags: List<Grammar> = [stmt, avra_expr_core(), avra_decl_edge_grammar(), avra_type_grammar(), avra_pat_grammar()]
    for g in stmt_family_fragments() { frags.push(g) }
    compose_fragments(frags)
}

/// ps3t.6.7 Step G slice 4b — the PRODUCTION declaration / whole-program grammar
export fn avra_decl_flip_grammar() -> Grammar {
    compose_grammars(avra_decl_edge_grammar(), avra_stmt_flip_grammar())
}

/// ps3t.6.7 Phase 2 — the DISPATCH-ONLY statement grammar the STATIC production
export fn avra_stmt_dispatch_grammar() -> Grammar {
    // The feature fragments are composed in rather than defined inline: the
    // expression family needs the identical arm rules and is emitted from its
    // OWN dispatch grammar, so one shared fragment is the only home that serves
    // both (t-47hc.25). Composed LAST so the statement rules keep leading the
    // merged rule set — the emitted function order is observable.
    mut frags: List<Grammar> = [avra_stmt_common_grammar()]
    for g in stmt_family_fragments() { frags.push(g) }
    compose_fragments(frags)
}

/// ps3t.6.7 Phase 2 — the DISPATCH-ONLY declaration grammar (the static-emit twin of
/// avra_decl_flip_grammar): `declaration` = the native declaration arms + a `statement`
/// tail, composed
/// with the dispatch-only statement grammar (expression EXTERNAL). This is what
/// gen_parser_files emits the checked-in production declaration static parser from.
export fn avra_decl_dispatch_grammar() -> Grammar {
    compose_grammars(avra_decl_edge_grammar(), avra_stmt_dispatch_grammar())
}

// The §2 match-pattern family (`avra_pat_grammar`) now lives with its owning
// feature at features/match.av (t-47hc.8 modular fragments) — the
// `match` feature owns its pattern syntax. It composes cleanly here via
// `compose_fragments` (compose.av) if ever needed, but patterns are
// self-contained (they embed no expressions), so no composition is required.

/// The §2 type-expression family (ps3t.6.5.6): union types `A | B`, `fn`
/// types, `dyn T`, list `[T]`, tuple/paren `(A, B)`, and named types with
/// generic args + nullable `T<A>?`. SELF-CONTAINED — types don't embed value
/// expressions. The entry `type_expr` mirrors parse_type_expr (left-assoc
/// union over type atoms).
/// The type SPINE — exactly "the type rules no feature owns" (the dispatch
/// skeleton `type_atom` and the splice atom; splice doctrine: `~` is
/// referenced from the engine ladder, so its build stays central). Every
/// owned rule lives in its feature's "type"-family fragment
/// (t-kd4y.3.5.10). Exported for the disjointness properties, which must
/// inspect spine + fragments each exactly ONCE — passing the composed
/// `avra_type_grammar` view there double-counts every migrated type rule
/// (the same reason the expression side exports its spine, t-kd4y.3.4).
export fn avra_type_spine_grammar() -> Grammar {
    let gp = grammar {
  // t-47hc.4.3 — `~var` in TYPE position, as its own atom rather than a widened
  // `named_type`. `consume_name_or_splice`'s encoding is the
  // ordinary name string PREFIXED with `~` for the quote lowerer to read back; this
  // builds the same `TypeExpr.Named("~var")`.
  //
  // An atom, not a wider `named_type`, because `named_type`'s name slot is a REPEATED
  // capture (the dotted path) and its accumulator type is inferred from the first item —
  // leading with a rule reference silently redeclared it `List<ExprId>` and the generated
  // parser then pushed a Token into it. A splice is a single name with no dotted tail, so
  // it has no business in that list.
  //
  // `@when(in_quote_body)` keeps `~` a parse error outside a quote, so valid input is
  // untouched. Placed BEFORE `named_type` because `~` starts no other atom.
  splice_type = @when(in_quote_body) "~" sn:IDENT ( opt:"?" )? -> MkSpliceType(sn, opt)
  type_atom  = splice_type | qualified_type | fn_type | dyn_type | list_type | paren_type | named_type
    }
    grammar_checked(gp)
}

export fn avra_type_grammar() -> Grammar {
    // The composed TYPE VIEW: the spine plus every "type"-family feature
    // fragment. Consumers keep calling THIS fn; the spine/view split is
    // internal (t-kd4y.3.5.10).
    //
    // compose contract: the FIRST fragment's start rule is the START SYMBOL,
    // and run_grammar_type execs rules[0] as the entry. The entry `type_expr`
    // is union_type's rule (ownership follows the referencing rule), so its
    // fragment must LEAD — spine-first led with the @when(in_quote_body)-gated
    // splice_type and gated the WHOLE view (type_equivalence_test went 0/8:
    // even `int` failed at the entry).
    mut frags: List<Grammar> = []
    mut rest: List<Grammar> = [avra_type_spine_grammar()]
    for g in feature_type_grammar_fragments() {
        if g.rules.length > 0 && g.rules[0].name == "type_expr" {
            frags.push(g)
        } else {
            rest.push(g)
        }
    }
    for g in rest { frags.push(g) }
    compose_fragments(frags)
}


/// t-47hc slice 9 — the DECL-keyword fragment registry: every feature that owns a
/// declaration keyword contributes its rule(s) from its own directory, and this
/// is the ONE list they are collected in. Adding a decl keyword is one line here
/// plus a `grammar { }` block in the feature — never an edit to the central
/// grammar body.
///
/// Ordering is irrelevant to meaning (nonterminals bind by name after the flat
/// merge) but IS stable here, so the composed rule list is deterministic.
///
/// `param` is deliberately NOT here: it is referenced by `fn_decl`,
/// `method_member` and `impl_method`, so no single feature owns it — it stays in
/// the shared base beside the expression ladder and the type spine.
export fn feature_decl_grammar_fragments() -> List<Grammar> {
    [
        avra_fn_decl_grammar(),      // fn_decl
        avra_struct_decl_grammar(),  // type_decl, field
        avra_enum_decl_grammar(),    // enum_decl, variant
        avra_trait_decl_grammar(),   // trait_decl, trait_member, assoc_member, method_member
        avra_impl_decl_grammar(),    // impl_decl, impl_method
        avra_modules_grammar(),      // use_decl, mod_decl
        avra_export_grammar(),       // export_decl + the MkStampAt split (t-kd4y.3.5.9)
        avra_annotations_grammar(),  // doc/mdoc/annot wrappers + wrapped_inner (t-kd4y.3.5.9)
        avra_spec_grammar(),         // spec_decl, spec_item, given_blk, then_blk
        avra_generics_grammar(),     // tparam — shared by every generic decl keyword
        avra_select_grammar(),       // select_decl, select_arm
        avra_parallel_grammar(),     // parallel_decl
        avra_let_grammar(),          // let_decl, mut_decl, const_decl, letdes_decl
        avra_component_grammar(),    // comp_header + the whole component family
    ]
}

/// The UNIFIED whole-program Avra grammar (t-47hc.8): ONE rule of its own —
/// the start — and everything else IS the production declaration grammar.
/// avra_decl_flip_grammar is self-contained (decl edge + statement family +
/// expression core + type spine + pattern/match/for fragments + the feature
/// registry), so a grammar edit lands in exactly one place and propagates to
/// every consumer of this view: the §2 whole-program gen-check leg, the
/// executor seams (this view backs the TYPE family via the Language record's
/// `program()` view), and the differential harnesses. The historical §2 shadows this view carried —
/// its own simplified expression ladder, type spine, and statement rules,
/// with drifted capture names and a type_atom missing splice_type — are gone;
/// the executor now runs the same type rules the static parser is emitted
/// from.
export fn avra_program_grammar() -> Grammar {
    let gp = grammar {
  program     = ( d:declaration )* -> Block(d)
    }
    compose_fragments([grammar_checked(gp), avra_decl_flip_grammar()])
}
