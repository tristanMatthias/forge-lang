// WHY: ps3t.6.3 — the grammar-DSL *seed* parser. A small, stable,
// hand-written recursive-descent parser for the grammar-of-grammars
// (GRAMMAR_DSL.md §6), written ONCE (EBNF is stable, so it never
// churns — exactly as yacc has a hand-written parser for yacc input,
// tree-sitter for its grammar DSL). It reads grammar *text* into a
// `Grammar` value (ast.av); the generator (executor.av / emit.av,
// ps3t.6.4) turns that into a parser.
//
// Reading grammar text as a *string* (not new Avra surface syntax)
// keeps this bootstrap-window-clean: no seed cycle is needed to build
// and test it. The `grammar Foo { … }` *block* as Avra surface syntax
// is folded into the parser-migration step (ps3t.6.5).
//
// The grammar-of-grammars it implements (self-describing):
//   grammar  = "grammar" NAME "{" rule+ "}"
//   rule     = NAME "=" alt
//   alt      = seq ( "|" seq )*
//   seq      = labeled+ ( "->" build )? annot*
//   labeled  = ( NAME ":" )? postfix
//   postfix  = primary ( "*" | "+" | "?" )? ( "{" "#" NAME "}" )?
//   primary  = NAME | STRING | "(" alt ")"
//   build    = NAME ( "(" ( NAME ( "," NAME )* )? ")" )?
//   annot    = "@expect" "(" STRING "," STRING ")"
//            | "@recover" "(" "sync_to" ":" STRING ")"

use features.grammar.{Grammar, Rule, GNode, GSeq, GItem, GRep, GPrim, GBuild, GAnnot}
use features.grammar.{code_at, is_space_code, is_ident_start_code, is_ident_cont_code}
use features.grammar.{build_rule_index}

// ── The DSL token stream ──

/// One token of the grammar-of-grammars. `kind` ∈ {NAME, STRING,
/// PUNCT, ARROW, EOF}; for PUNCT `text` is the single char; for STRING
/// `text` is the unquoted contents.
export type GTok = { kind: string, text: string }

/// The parse outcome: the grammar plus an error string ("" == ok). A
/// nonempty `error` means `grammar` is a best-effort partial.
export type GrammarParse = { grammar: Grammar, error: string }

// ── Character classification (byte-level, ASCII) ──
// The generic char helpers (code_at / is_space_code / is_ident_*) live
// in chars.av and are imported above (shared with lex.av).

/// True when every char of `s` is an uppercase letter, digit, or `_`
/// (and it starts with a letter) — the EBNF convention marking a
/// *named terminal* (NUMBER, STRING) apart from a lowercase rule ref.
export fn is_terminal_name(s: string) -> bool {
    if s.length == 0 { return false }
    let first = code_at(s, 0)
    if !((first >= 65 && first <= 90) || first == 95) { return false }
    mut i = 0
    while i < s.length {
        let c = code_at(s, i)
        let ok = (c >= 65 && c <= 90) || c == 95 || (c >= 48 && c <= 57)
        if !ok { return false }
        i = i + 1
    }
    true
}

// ── Scanner: grammar text → List<GTok> ──

/// Tokenise the whole grammar source up front. Skips whitespace and
/// `// line comments`. Recognises identifiers, `"strings"`, the `->`
/// arrow, and single-char punctuation (`= | ( ) { } * + ? : , @`).
export fn scan_grammar(src: string) -> List<GTok> {
    mut toks: List<GTok> = []
    let n = src.length
    mut i = 0
    while i < n {
        let c = code_at(src, i)
        if is_space_code(c) {
            i = i + 1
            continue
        }
        // line comment
        if c == 47 && i + 1 < n && code_at(src, i + 1) == 47 {
            while i < n && code_at(src, i) != 10 { i = i + 1 }
            continue
        }
        // arrow `->`
        if c == 45 && i + 1 < n && code_at(src, i + 1) == 62 {
            toks.push(GTok { kind: "ARROW", text: "->" })
            i = i + 2
            continue
        }
        // identifier
        if is_ident_start_code(c) {
            let start = i
            i = i + 1
            while i < n && is_ident_cont_code(code_at(src, i)) { i = i + 1 }
            toks.push(GTok { kind: "NAME", text: src.substring(start, i) })
            continue
        }
        // string literal — contents without the surrounding quotes. A
        // backslash escapes the next char (so `\"` is not a terminator).
        // An unterminated literal (EOF before the closing quote) becomes
        // an ERROR token the parser rejects, rather than a silent STRING.
        if c == 34 {
            i = i + 1
            let start = i
            while i < n && code_at(src, i) != 34 {
                if code_at(src, i) == 92 && i + 1 < n {
                    i = i + 2
                    continue
                }
                i = i + 1
            }
            if i >= n {
                toks.push(GTok { kind: "ERROR", text: src.substring(start, i) })
                continue
            }
            let text = src.substring(start, i)
            i = i + 1  // consume closing quote
            toks.push(GTok { kind: "STRING", text })
            continue
        }
        // single-char punctuation
        toks.push(GTok { kind: "PUNCT", text: src.substring(i, i + 1) })
        i = i + 1
    }
    toks.push(GTok { kind: "EOF", text: "" })
    toks
}

// ── The recursive-descent seed parser ──

/// Parser state over the pre-scanned token list. `pos` is the cursor;
/// `error` accumulates the first diagnostic (best-effort partial after
/// that).
type GP = { toks: List<GTok>, pos: int, error: string }

impl GP {
    fn peek(self) -> GTok { self.toks[self.pos] }

    fn at_end(self) -> bool { self.peek().kind == "EOF" }

    fn advance(self) -> GTok {
        let t = self.toks[self.pos]
        if self.pos + 1 < self.toks.length { self.pos = self.pos + 1 }
        t
    }

    /// True when the cursor is a PUNCT with this exact text.
    fn is_punct(self, ch: string) -> bool {
        let t = self.peek()
        t.kind == "PUNCT" && t.text == ch
    }

    /// Consume a PUNCT `ch` if present; report `msg` otherwise.
    fn expect_punct(self, ch: string, msg: string) {
        if self.is_punct(ch) { let _ = self.advance() } else { self.fail(msg) }
    }

    fn fail(self, msg: string) {
        if self.error == "" {
            self.error = "${msg} (at `${self.peek().text}`)"
        }
    }
}

/// Parse a whole grammar string into a `Grammar`. Returns a
/// `GrammarParse` carrying the (possibly partial) grammar + an error
/// string ("" on success).
export fn parse_grammar(src: string) -> GrammarParse {
    let toks = scan_grammar(src)
    mut p = GP { toks, pos: 0, error: "" }
    let g = parse_grammar_body(p)
    // Validate `@off(flag)`/`@on(flag)` mode-SET marker POSITIONS after the tree is
    // built (the fold/@try shape is structural) — only when the parse itself was
    // clean, so a syntax error isn't masked by a position error on a half-built tree.
    if p.error == "" {
        let oe = validate_mode_markers(g)
        if oe != "" { p.error = oe }
    }
    // t-47hc.21: a `@cut` outside a `@try` branch is DEAD notation (a predictive
    // branch never rolls back, so there is nothing to commit), and `@require` only
    // means anything on a plain terminal. Reject either rather than accept a marker
    // that silently does nothing.
    if p.error == "" {
        let ce = validate_cuts(g)
        if ce != "" { p.error = ce }
    }
    // t-47hc.28: a repetition bound `x{#cap}` must name a capture the SAME branch has
    // already collected. Unbound or later-bound, the cap would read an empty list and
    // silently clamp the loop to zero iterations — a whole repetition vanishing with no
    // diagnostic, which is the exact failure mode the emit-regen review step exists to
    // catch. Make it a grammar-parse error instead.
    if p.error == "" {
        let be = validate_bounds(g)
        if be != "" { p.error = be }
    }
    GrammarParse { grammar: g, error: p.error }
}

fn parse_grammar_body(p: GP) -> Grammar {
    // Optional `grammar NAME { … }` wrapper.
    mut name = "grammar"
    mut wrapped = false
    if p.peek().kind == "NAME" && p.peek().text == "grammar" {
        wrapped = true
        let _ = p.advance()
        if p.peek().kind == "NAME" {
            name = p.advance().text
        } else {
            p.fail("expected grammar name after `grammar`")
        }
        p.expect_punct("{", "expected `{` to open grammar body")
    }
    mut rules: List<Rule> = []
    while !p.at_end() && !p.is_punct("}") {
        let before = p.pos
        rules.push(parse_rule(p))
        // Guard against a stuck cursor on malformed input — always
        // make progress so a bad rule can't spin forever (bounded).
        if p.pos == before { let _ = p.advance() }
    }
    // Envelope validation: a wrapped grammar MUST close its `}` and
    // declare at least one rule; nothing may trail the close.
    if wrapped {
        p.expect_punct("}", "expected `}` to close the grammar body")
        if !p.at_end() {
            p.fail("unexpected trailing tokens after `}`")
        }
    } else if p.is_punct("}") {
        let _ = p.advance()
    }
    if rules.length == 0 {
        p.fail("a grammar must declare at least one rule")
    }
    Grammar { name, rules, rule_idx: build_rule_index(rules) }
}

// rule = NAME "=" alt
fn parse_rule(p: GP) -> Rule {
    mut rname = ""
    if p.peek().kind == "NAME" {
        rname = p.advance().text
    } else {
        p.fail("expected a rule name")
        let _ = p.advance()
    }
    p.expect_punct("=", "expected `=` after rule name `${rname}`")
    let body = parse_alt(p)
    Rule { name: rname, body }
}

// alt = seq ( "|" seq )*
fn parse_alt(p: GP) -> GNode {
    mut branches: List<GSeq> = []
    branches.push(parse_seq(p))
    while p.is_punct("|") {
        let _ = p.advance()
        branches.push(parse_seq(p))
    }
    GNode.Alt(branches)
}

// seq = labeled+ ( "->" build | annot )*
//
// The build and the error annotations may appear in either order after
// the items — GRAMMAR_DSL.md §2 writes `@expect … @recover … -> e`
// (annots before build), so parse them interleaved rather than fixing
// a rigid build-then-annots order.
/// True when the cursor is the `@try` branch marker — a leading, BRANCH-level
/// speculation flag (bounded backtracking), distinct from the `@hand`/`@when`
/// primaries and the `@expect`/`@recover` annotations.
fn at_try_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "try"
}

fn parse_seq(p: GP) -> GSeq {
    // A leading `@try` marks this alternative BOUNDED-BACKTRACKING (snapshot →
    // run → roll back + try the next branch on failure). Consumed here, before
    // the items, so it prefixes the branch rather than being an item.
    mut speculative = false
    if at_try_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "try"
        speculative = true
    }
    mut items: List<GItem> = []
    while seq_can_continue(p) {
        let before = p.pos
        items.push(parse_labeled(p))
        if p.pos == before { let _ = p.advance() }  // bounded progress
    }
    // A sequence must have at least one item — an empty alternative
    // (`x = | "a"`) would otherwise lower to a `true` guard that shadows
    // every following alternative. Reject it here.
    if items.length == 0 {
        p.fail("expected at least one item in a sequence (empty alternative)")
    }
    // `@when(flag)` predicates are LEADING branch gates: they must precede every
    // consuming item, and a branch must have a consuming item for a predicate to
    // gate (a predicate-only branch can never be selected — and wrapped in a
    // repeat it would spin). Enforcing "leading" also keeps the two consumers
    // aligned: emit's seq_first_guard folds LEADING preds, while the executor's
    // branch_pred_ok scans ALL items — identical only when every pred is leading.
    mut ff_consuming = 0
    mut ff_pred_after = false
    for it in items {
        match it.prim {
            .Pred(_) -> if ff_consuming > 0 { ff_pred_after = true }
            // `@peek` is the same zero-width leading gate as `@when` (same leading-only
            // rule so emit's seq_first_guard and the executor's branch_pred_ok agree).
            .Peek(_) -> if ff_consuming > 0 { ff_pred_after = true }
            _ -> ff_consuming = ff_consuming + 1
        }
    }
    if ff_pred_after {
        p.fail("`@when`/`@peek` must be a leading branch gate (before any consuming item)")
    }
    if ff_consuming == 0 {
        p.fail("`@when`/`@peek` must gate a branch that consumes input (a predicate-only branch never matches)")
    }
    mut build = GBuild.None
    mut annots: List<GAnnot> = []
    while true {
        if p.peek().kind == "ARROW" {
            let _ = p.advance()
            build = parse_build(p)
        } else if p.is_punct("@") {
            annots.push(parse_annot(p))
        } else {
            break
        }
    }
    // A `@try` branch is a bounded-speculation RECOGNIZER: emit lowers it to a
    // snapshot → run → commit-or-rollback block. Post-#995 (t-47hc GAP-3) that lowering
    // is faithful for the FULL item vocabulary — capturing builds, repetitions (list
    // accumulators), groups/opt, `@on`/`@off` mode items, and `@hand` leaves — via the
    // emitter's rich speculative path (emit_speculative_branch_rich, which reuses
    // emit_seq_stmts + emit_seq_result inside the rollback scaffold) and the interpreter's
    // exec_seq (which snapshots+restores env.caps across the speculative run so a
    // rolled-back branch's bindings can't leak to a sibling). So NO branch SHAPE is
    // rejected here anymore; the only residual @try-specific rules are the label
    // constraints below (a bound label becomes a generated local, so it must not collide
    // with the branch scaffolding nor repeat within the branch — the same lockstep
    // discipline, now narrowed from "shape" to "labels").
    if speculative {
        // A bound label becomes an auto-scoped `let <label>` local in the generated
        // speculative branch (emit_spec_item). It must not (a) collide with the branch
        // scaffolding (`s_pos`/`s_mark`/`s_diags`/`s_err`/`s_last`/`sp_start`/`tried_spec`)
        // nor (b) repeat within the branch — `let x` twice won't compile. The interpreter
        // would silently last-wins a duplicate (set_scalar) and never see the scaffolding,
        // so both sides diverge unless we REJECT here (the same lockstep discipline).
        mut seen_labels: List<string> = []
        for lab_it in items {
            if lab_it.label == "" { continue }
            if try_label_reserved(lab_it.label) {
                p.fail("a `@try` branch label cannot be a reserved name (`s_pos`/`s_mark`/`s_diags`/`s_err`/`s_last`/`sp_start`/`tried_spec`) — it would collide with the speculative branch scaffolding")
            }
            if str_in_seq(seen_labels, lab_it.label) {
                p.fail("a `@try` branch cannot bind the label `${lab_it.label}` twice — each label becomes a distinct generated local")
            }
            seen_labels.push(lab_it.label)
        }
    }
    GSeq { items, build, annots, speculative }
}

/// True iff `name` is a local the generated speculative branch already binds
/// (emit_speculative_branch's snapshot scaffolding + span byte). A `@try` label
/// colliding with one of these would shadow/redeclare it in the emitted block.
fn try_label_reserved(name: string) -> bool {
    name == "s_pos" || name == "s_mark" || name == "s_diags" || name == "s_err" ||
        name == "s_last" || name == "sp_start" || name == "tried_spec"
}

/// Membership test over a `List<string>` (seed_parser-local; emit.av's `str_in`
/// is module-private there).
fn str_in_seq(xs: List<string>, s: string) -> bool {
    for x in xs {
        if x == s { return true }
    }
    false
}

/// A sequence keeps taking items until a FOLLOW token: `|`, `)`, `}`,
/// `->`, a trailing `@`-annotation, or EOF — or the start of the NEXT
/// rule. Because the scanner strips newlines, a rule boundary is
/// detected by lookahead: a `NAME "="` ahead begins the next
/// production, not another item.
fn seq_can_continue(p: GP) -> bool {
    if p.at_end() { return false }
    if p.peek().kind == "ARROW" { return false }
    if p.is_punct("|") || p.is_punct(")") || p.is_punct("}") { return false }
    // `@hand(...)` / `@when(...)` are PRIMARIES (items) and `@off(...)` is a
    // leading item MARKER — keep going; `@expect`/`@recover` are trailing
    // annotations — stop the item list.
    if p.is_punct("@") { return at_hand_primary(p) || at_when_primary(p) || at_peek_primary(p) || at_off_marker(p) || at_on_marker(p) || at_cut_marker(p) || at_require_marker(p) }
    if p.peek().kind == "NAME" && p.pos + 1 < p.toks.length {
        let nxt = p.toks[p.pos + 1]
        if nxt.kind == "PUNCT" && nxt.text == "=" { return false }
    }
    true
}

/// True when the cursor is `@hand` — the escape-hatch primary, distinct
/// from the `@expect`/`@recover` sequence annotations.
fn at_hand_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "hand"
}

/// True when the cursor is `@when` — the zero-width mode-predicate primary
/// (t-47hc.3), distinct from `@hand` and the `@expect`/`@recover` annotations.
fn at_when_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "when"
}

/// True when the cursor is `@peek` — the zero-width LOOKAHEAD-predicate primary
/// (t-47hc paren prep), the token-stream sibling of `@when`.
fn at_peek_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "peek"
}

/// The lookahead conditions a `@peek(cond)` marker may name — the single source of
/// truth for the @peek cond SET, consulted by parse_primary (a typo is rejected at
/// parse time). Kept in lockstep with executor.lookahead_ok (which maps each name to
/// a token test) and emit.peek_guard (which emits the equivalent generated guard) — a
/// new cond is added in all three. `ident_colon`: the current token is an IDENT and the
/// next is `:` — the hand parse_paren_expr's `peek_after_ident_is_colon` (typed lambda).
/// `stmt_block` is the statement-position non-map-brace predicate;
/// `for_destructure` and `comma_ident` select tuple-loop bindings and their
/// non-trailing separator commas. `double_colon` preserves the hand parser's
/// no-whitespace `::` requirement for qualified type names.
export fn peek_cond_supported(cond: string) -> bool {
    // `lparen_ident_colon`: the position-0 twin of `ident_colon` — cur is `(`, the next
    // token an IDENT, the one after `:` (the TYPED-LAMBDA opener, checked from before `(`
    // so the paren rule spans from the `(` byte). See executor.lookahead_ok.
    // `decl_lead`: "is this a DECLARATION lead?" — true for every non-IDENT lead,
    // and for an IDENT only in the component-instantiation shape `Comp inst {`
    // (t-47hc.24). See executor.lookahead_ok.
    // `if_let`: `if` immediately followed by `let` — the bind-fresh if-let form,
    // which stays the hand's. See executor.lookahead_ok.
    cond == "ident_colon" || cond == "lparen_ident_colon" || cond == "stmt_block" || cond == "brace_map" || cond == "for_destructure" || cond == "match_subjectless" || cond == "match_table" || cond == "comma_ident" || cond == "double_colon" || cond == "decl_lead" || cond == "if_let"
}

/// The parse-MODE flags a `@off(flag)` marker (GItem.mode_off) may turn off —
/// exactly the SETTABLE ExprModes bools (executor.av). The single source of truth
/// for the @off flag SET, consulted by parse_labeled: every `@off(NAME)` is
/// validated against it and anything else is rejected at parse time, so a typo
/// (`allow_strct_lit`) or the READ-only `@when` predicate `at_quote_top` (derived
/// from `quote_depth`, not a settable bool) is a HARD grammar error, never a silent
/// no-op. `executor.modes_with_flag_off` maps exactly these names to their fields —
/// the two lists MUST stay in lockstep (a new @off-able flag is added in both).
/// Lives here (with its only consumer) rather than in the universally-imported
/// core ast.av, keeping the core module's export surface minimal.
export fn off_flag_supported(flag: string) -> bool {
    flag == "allow_struct_lit" || flag == "allow_dot_postfix" ||
        flag == "allow_it_sugar" || flag == "cell_mode"
}

/// The predicates a `@when(flag)` marker may READ — the single source of truth for the
/// @when SET, in lockstep with `executor.modes_flag` (which maps each name to its
/// reading) and `emit.pred_guard` (its byte-side twin).
///
/// This is WIDER than off_flag_supported: `@off`/`@on` may only name a SETTABLE bool,
/// while `@when` may also read a DERIVED predicate — `at_quote_top` / `in_quote_body`
/// are computed from the `quote_depth` counter, so they are legal to read and illegal
/// to set. That asymmetry is the reason for two lists rather than one.
///
/// Validating at all is the point: `modes_flag` answers TRUE for an unrecognised flag
/// (an unknown predicate is ungated), so before this existed a typo — `@when(allow_strct_lit)`
/// — parsed clean and emitted a guard that was always true. A dead gate that silently
/// admits every branch is exactly the silent-failure class `@off`, `@on` and `@peek`
/// each already reject by name, and `@when` was the one marker that did not.
export fn when_pred_supported(flag: string) -> bool {
    flag == "allow_struct_lit" || flag == "allow_dot_postfix" ||
        flag == "allow_it_sugar" || flag == "cell_mode" ||
        flag == "at_quote_top" || flag == "in_quote_body"
}

/// The parse-MODE flags a `@on(flag)` marker (GItem.mode_on) may turn ON — the
/// SET-ON twin of off_flag_supported (the same settable ExprModes bools). Kept in
/// lockstep with executor.modes_with_flag_on (a new @on-able flag is added in both).
export fn on_flag_supported(flag: string) -> bool {
    flag == "allow_struct_lit" || flag == "allow_dot_postfix" ||
        flag == "allow_it_sugar" || flag == "cell_mode"
}

/// True when the cursor is `@off` — the leading mode-SET item marker (t-47hc),
/// distinct from the `@hand`/`@when` primaries and the `@expect`/`@recover`
/// annotations. It prefixes the item it scopes, so seq_can_continue must treat
/// it as an item-start (else the item-list loop stops before it).
fn at_off_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "off"
}

/// True when the cursor is `@cut` — the COMMIT-POINT marker (t-47hc.21). Bare (no
/// parens), so it needs no argument validation. Same item-start role as `@off`/`@on`,
/// so seq_can_continue must treat it as an item-start too.
fn at_cut_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "cut"
}

/// True when the cursor is `@require` — the ABORT marker (t-47hc.21). Bare, like
/// `@cut`: the diagnostic still comes from the sequence's `@expect`.
fn at_require_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "require"
}

/// True when the cursor is `@on` — the SET-ON twin of at_off_marker. Same item-start
/// role, so seq_can_continue must treat it as an item-start too.
fn at_on_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == "NAME" && nxt.text == "on"
}

// ── @off / @on mode-SET marker POSITION validation (t-47hc) ──

/// Reject `@off(flag)`/`@on(flag)` in any position the GENERATED parser can't honor
/// identically to the executor. The executor runs EVERY item through exec_item (so it
/// honors the marker everywhere), but emit has specialised paths that BYPASS emit_item
/// — emit_fold (a fold branch's seed + accumulators) and emit_speculative_branch (a
/// `@try` branch's items) — and inlines structural `( … )` groups with a per-sequence
/// item index that RESTARTS when nested (so two nested mode markers would emit a
/// colliding `__modes_N` binding). So a mode marker is supported ONLY on a DIRECT item
/// of a TOP-LEVEL, non-`@try`, non-fold rule branch, and never on a `@hand`/`@when`
/// primary. Everything else is a HARD grammar error — keeping the executor and the
/// generated parser in lockstep (BOTH reject the same grammars) instead of silently
/// diverging. Runs after the tree is built (the fold/@try shape is structural).
/// Returns "" when clean.
fn validate_mode_markers(g: Grammar) -> string {
    for rule in g.rules {
        let e = check_mode_node(rule.body, rule.name, false)
        if e != "" { return e }
    }
    ""
}

/// Validate `@off`/`@on` mode-SET marker POSITIONS. Post-#995 (t-47hc GAP-3) a mode
/// marker is HONORED on every emit path that routes through emit_item — the general
/// dispatch (emit_seq_items), a `@try` branch (emit_speculative_branch_rich reuses
/// emit_seq_stmts → emit_seq_items → emit_item), AND inside a nested group (emit_opt /
/// emit_repeat_group → emit_node_items → emit_seq_items → emit_item, recursively). The
/// executor's exec_item wraps every item's sub-parse in push/restore identically. So
/// `@try` and nested-group markers are NO LONGER rejected. Two restrictions remain, both
/// real correctness gates, threaded down via `in_fold`:
///   (1) an EXPR-FOLD branch (fold_binary/…): emit_fold bypasses emit_item entirely, so a
///       mode marker anywhere inside it would be silently DROPPED from the generated parser
///       (a divergence the span-blind gates wouldn't catch) — reject it.
///   (2) a marker wrapping a `@hand`/`@when`/`@peek` primary: @hand manages its own parser
///       modes and @when/@peek are zero-width — a mode-set around them is meaningless.
fn check_mode_node(node: GNode, rule: string, in_fold: bool) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                // `in_fold` carries the enclosing branch's fold context DOWN through groups:
                // a group inside a fold branch also takes the fold emit path, so its markers
                // are dropped too. A group's OWN inner branches almost always build `.None`,
                // so branch_is_expr_fold(inner) is false — the outer context is what matters.
                let this_fold = in_fold || branch_is_expr_fold(b)
                for item in b.items {
                    // The two mode-SET markers are mutually exclusive on one item
                    // (enforced at parse), share identical emit/exec positions, so
                    // validate whichever is present with the same rule.
                    let mk = if item.mode_off != "" { "@off" } else { "@on" }
                    let fl = if item.mode_off != "" { item.mode_off } else { item.mode_on }
                    if item.mode_off != "" || item.mode_on != "" {
                        if this_fold {
                            return "`${mk}(${fl})` cannot appear on (or inside a group of) an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the mode set"
                        }
                        if prim_is_hand_or_pred(item.prim) {
                            return "`${mk}(${fl})` cannot wrap a `@hand`/`@when`/`@peek` primary (rule `${rule}`)"
                        }
                    }
                    // A structural group is a NESTED sequence: recurse to validate its
                    // markers too (now ALLOWED unless we're inside a fold branch), carrying
                    // the fold context so a fold-branch group is still rejected.
                    match item.prim {
                        .Group(inner) -> {
                            let e = check_mode_node(inner, rule, this_fold)
                            if e != "" { return e }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    ""
}

/// Is `s` one of `xs`? DELIBERATELY FILE-PRIVATE, and it must stay that way.
///
/// This feature carries several near-identical copies of this loop (`list_has` in
/// executor.av, `ffs_has` in first_follow.av, `frag_name_in` in compose.av, `str_in`
/// in emit.av — which additionally treats `""` as absent). That looks like textbook
/// duplication to remove, and removing it BREAKS THE BUILD in a way no ordinary gate
/// catches: hoisting one shared `export fn` into ast.av and calling it across files
/// makes every `@expand(...)` comptime macro fail with
///
///     F4005 … can only call functions (callee=@std::avrac::features::grammar::name_in
///     kind=type_marker)
///
/// because `parse_grammar` is reachable from comptime macro expansion, and the
/// comptime evaluator resolves a cross-module callee that is not `@comptime` to a
/// type_marker rather than a function (features/eval/mod.av `value_type_marker`; the
/// same trap is recorded at features/derive/emit.av `name_vtype`). A plain
/// compile, `--emit-gen-check`, and even a byte-identical `diff-test` all stay GREEN —
/// the comptime path is only exercised on the manifest-driven build, which is why
/// CLAUDE.md insists the metadata lib build is the real smoke test.
///
/// So the duplication is load-bearing, not rot. If it is ever genuinely consolidated,
/// the shared helper has to be `@comptime` AND the change has to be validated by
/// building a package that uses `@expand`, not by the parser gates alone.
fn name_in(xs: List<string>, s: string) -> bool {
    for x in xs {
        if x == s { return true }
    }
    false
}

/// Reject every repetition bound (`x{#cap}`) whose capture is not already collected
/// at that point in the branch. Scope is one alternation BRANCH scanned left to
/// right, which is exactly what both engines see: the executor binds into a shared
/// per-rule CapEnv as it walks the items, and the generated parser declares one
/// `<label>_list` accumulator per branch and fills it in the same order. A bound
/// naming a capture that appears LATER (or not at all) would read an empty list and
/// clamp the loop to zero iterations silently.
///
/// A bound is only honoured against a LIST capture — one collected by a `*`/`+`, or
/// by a label repeated across items. A scalar capture has no length, so naming one is
/// rejected too rather than being counted as 1.
fn validate_bounds(g: Grammar) -> string {
    // `parse_grammar` runs on the production parse path, so this pass must cost
    // effectively nothing for the grammars that DON'T use a bound — which today is
    // all of them. The visibility scan below allocates two lists per branch, so gate
    // it on a bound existing at all: one allocation-free walk, then out.
    if !grammar_has_bound(g) { return "" }
    for rule in g.rules {
        let e = check_bound_node(rule.body, rule.name)
        if e != "" { return e }
    }
    ""
}

fn grammar_has_bound(g: Grammar) -> bool {
    for rule in g.rules {
        if node_has_bound(rule.body) { return true }
    }
    false
}

fn node_has_bound(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for item in b.items {
                    if item.bound != "" { return true }
                    match item.prim {
                        .Group(inner) -> {
                            if node_has_bound(inner) { return true }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    false
}

fn check_bound_node(node: GNode, rule: string) -> string {
    let no_lists: List<string> = []
    let no_seen: List<string> = []
    check_bound_node_in(node, rule, no_lists, no_seen, false)
}

/// `outer_lists`/`outer_seen` are the captures already collected to the LEFT of this
/// node by the ENCLOSING branch. Threading them is what lets a bound written INSIDE a
/// group see the enclosing branch's captures — which is not an edge case but the
/// headline shape: `match … table`'s per-row cell loop is
/// `( h:IDENT )+ ( p:pattern c:cell{#h} )*`, where the bound sits inside the row group
/// and `h` comes from the header row outside it. Restarting the scope at each group
/// made that grammar unparseable.
///
/// `under_multi` says this node sits inside a repeating group, which makes every
/// capture within it list-shaped — mirroring emit's `node_labels_of(inner, under_multi)`,
/// because the two must agree on what a `<label>_list` accumulator exists for.
fn check_bound_node_in(node: GNode, rule: string, outer_lists: List<string>, outer_seen: List<string>, under_multi: bool) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                // Labels that are LIST-shaped by the time each item is reached. Seeded
                // from the enclosing scope, then built incrementally so a bound can only
                // ever see captures to its LEFT.
                mut lists: List<string> = []
                mut seen: List<string> = []
                for l in outer_lists { lists.push(l) }
                for l in outer_seen { seen.push(l) }
                for item in b.items {
                    if item.bound != "" {
                        // A repetition bounded by a capture IT ITSELF writes is
                        // self-limiting, and the two engines would not agree on it:
                        // exec_repeat reads the cap ONCE up front, while the emitted
                        // loop compares against a `_list` that the loop keeps growing.
                        // Reject rather than pick a winner. The capture is usually on
                        // an INNER item of an unlabelled group, so the item's own label
                        // is not enough — ask what the whole item writes.
                        if name_in(item_written_labels(item), item.bound) {
                            return "`{#${item.bound}}` in rule `${rule}` bounds a repetition by a capture that repetition itself writes"
                        }
                        if name_in(lists, item.bound) {
                            // fine — a list capture bound earlier in this branch
                        } else if name_in(seen, item.bound) {
                            return "`{#${item.bound}}` in rule `${rule}` names a scalar capture — a bound needs a list capture (one collected by `*`/`+`)"
                        } else {
                            return "`{#${item.bound}}` in rule `${rule}` names `${item.bound}`, which is not captured earlier in this branch"
                        }
                    }
                    if item.label != "" {
                        // LIST-shaped means exactly what the EMITTER declares a
                        // `<label>_list` accumulator for: a label under a `*`/`+`, own
                        // or inherited from an enclosing repeating group (emit's
                        // list_labels_of / node_labels_of). A label merely REPEATED
                        // across two `One` items is NOT one — the emitter declares no
                        // accumulator for it, so accepting a bound on it would emit a
                        // reference to an undeclared `<label>_list` and the generated
                        // file would not compile, while the interpreter's capval_len saw
                        // a last-wins scalar and answered 1. Both engines must agree on
                        // what a bindable list is.
                        let multi = under_multi || match item.rep { .Star -> true  .Plus -> true  _ -> false }
                        if multi {
                            if !name_in(lists, item.label) { lists.push(item.label) }
                        }
                        if !name_in(seen, item.label) { seen.push(item.label) }
                    }
                    match item.prim {
                        .Group(inner) -> {
                            let multi = under_multi || match item.rep { .Star -> true  .Plus -> true  _ -> false }
                            // Recurse BEFORE merging the group's own labels outward, so a
                            // bound inside the group sees only what is genuinely to its
                            // LEFT — the enclosing branch's captures plus, via the inner
                            // walk's own accumulation, the group items preceding it.
                            let e = check_bound_node_in(inner, rule, lists, seen, multi)
                            if e != "" { return e }
                            // A group's items bind into the SAME env, so its labels are
                            // visible to later items of THIS branch.
                            let sub = group_label_shapes(inner, multi)
                            for l in sub.lists {
                                if !name_in(lists, l) { lists.push(l) }
                            }
                            for l in sub.all {
                                if !name_in(seen, l) { seen.push(l) }
                            }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    ""
}

/// Every capture label an item writes — its own, plus all of them inside it when the
/// item is a group. This is what a bound must not name (see check_bound_node).
fn item_written_labels(item: GItem) -> List<string> {
    mut out: List<string> = []
    if item.label != "" { out.push(item.label) }
    match item.prim {
        .Group(inner) -> {
            for l in group_label_shapes(inner, false).all {
                if !name_in(out, l) { out.push(l) }
            }
        }
        _ -> {}
    }
    out
}

/// The capture labels a group contributes to its ENCLOSING branch, split by shape:
/// `lists` are list-collecting (bindable as a bound), `all` is every label seen.
/// A group's items bind into the same env as the branch around it, so these are
/// visible to a later bound in that branch. `multi` is true when the group itself
/// repeats, which makes every capture inside it list-shaped regardless of the inner
/// item's own repetition. Returned rather than accumulated through parameters —
/// `List` params are immutable, and a pure result keeps the visibility rule readable.
type LabelShapes = { lists: List<string>, all: List<string> }

fn group_label_shapes(node: GNode, multi: bool) -> LabelShapes {
    mut lists: List<string> = []
    mut all: List<string> = []
    match node {
        .Alt(branches) -> {
            for b in branches {
                for item in b.items {
                    if item.label != "" {
                        // Same rule as check_bound_node_in: list-shaped ⇔ under a
                        // `*`/`+`, never merely repeated across `One` items.
                        let item_multi = match item.rep { .Star -> true  .Plus -> true  _ -> false }
                        if multi || item_multi {
                            if !name_in(lists, item.label) { lists.push(item.label) }
                        }
                        if !name_in(all, item.label) { all.push(item.label) }
                    }
                    match item.prim {
                        .Group(inner) -> {
                            let sub = group_label_shapes(inner, multi)
                            for l in sub.lists {
                                if !name_in(lists, l) { lists.push(l) }
                            }
                            for l in sub.all {
                                if !name_in(all, l) { all.push(l) }
                            }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    LabelShapes { lists, all }
}

/// Reject every `@cut` the executor and the generated parser would not honor
/// identically. `in_try` carries the enclosing `@try` DOWN through groups: a group
/// nested in a speculative branch is still inside that branch's rollback scope, so a
/// cut there is honored (both emitters inline the group into the branch body, and the
/// executor shares one CapEnv across the whole rule). Returns "" when clean.
fn validate_cuts(g: Grammar) -> string {
    for rule in g.rules {
        let e = check_cut_node(g, rule.body, rule.name, false)
        if e != "" { return e }
    }
    ""
}

// `g` is threaded so a `@require` on a rule REFERENCE can look up that rule's
// single-literal FIRST — the message key the marker needs (t-47hc.24).
fn check_cut_node(g: Grammar, node: GNode, rule: string, in_try: bool) -> string {
    check_cut_node_ctx(g, node, rule, in_try, false)
}

fn check_cut_node_ctx(g: Grammar, node: GNode, rule: string, in_try: bool, in_fold: bool) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                let this_try = in_try || b.speculative
                // A fold branch takes emit_fold, which bypasses emit_item — carried
                // DOWN through groups, exactly like check_mode_node does, because a
                // group inside a fold branch takes the fold path too.
                let this_fold = in_fold || branch_is_expr_fold(b)
                // Item index, skipping the zero-width predicates the emitters skip —
                // so index 0 is the sequence's GUARD token.
                mut idx = 0
                for item in b.items {
                    if item.cut {
                        if !this_try {
                            return "`@cut` is only meaningful inside a `@try` branch (rule `${rule}`) — a predictive branch never rolls back, so there is nothing to commit"
                        }
                        // A fold branch takes emit_fold, which bypasses emit_item —
                        // the cut would vanish from the generated parser while the
                        // executor still honored it (a silent divergence).
                        if this_fold {
                            return "`@cut` cannot appear on an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the commit"
                        }
                        // Both emitters SKIP zero-width predicates in their item
                        // loops, so a cut riding one would never be emitted.
                        if prim_is_pred_e_sp(item.prim) {
                            return "`@cut` cannot wrap a `@when`/`@peek` predicate (rule `${rule}`) — put it on the next token-bearing item"
                        }
                    }
                    // `@require` is a TERMINAL-mismatch abort: both engines detect
                    // "the token isn't there" on a Lit/Named, not on a rule ref (whose
                    // failure is its own internal report) or a zero-width predicate.
                    if item.require {
                        // t-47hc.24: a RULE REFERENCE is also legal, provided its FIRST is a
                        // single literal — that literal is the message key `@expect` and
                        // handle_missing are both indexed by, so without one there is no
                        // single "expected X" to report. This is what lets `@require
                        // block_expr` say the hand's `if !check(LeftBrace) { report; return
                        // .Err }` without inlining (and mis-spanning) the block.
                        if !prim_is_terminal_sp(item.prim) {
                            match item.prim {
                                .Ref(rname) -> {
                                    if rule_first_literal(g, rname) == "" {
                                        return "`@require` on rule reference `${rname}` (in rule `${rule}`) needs a single-literal FIRST — its FIRST is a disjunction or a token KIND, so there is no one token to name in the diagnostic"
                                    }
                                }
                                _ -> {
                                    return "`@require` only applies to a terminal or a rule reference (rule `${rule}`)"
                                }
                            }
                        }
                        if !rep_is_one_sp(item.rep) {
                            return "`@require` cannot carry a repetition (rule `${rule}`) — an absent optional/repeated item is not a mismatch"
                        }
                        // Same fold hazard as `@cut`: emit_fold consumes its terminals
                        // through emit_accumulate, never emit_item, so the abort would
                        // vanish from the generated parser while the executor honoured it.
                        if this_fold {
                            return "`@require` cannot appear on an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the abort"
                        }
                        // Index 0 is the sequence's GUARD position. In a rule branch and
                        // in a terminal-alternation group the enclosing FIRST check has
                        // already proved that token, so both engines consume it
                        // unconditionally and it can never mismatch; in an unguarded
                        // structural group it IS validated. Rather than make the marker's
                        // meaning depend on which of those the emitters picked, reject it
                        // outright — mark the item that must FOLLOW the guard.
                        if idx == 0 {
                            return "`@require` cannot sit on a sequence's leading item (rule `${rule}`) — that position is the FIRST-set guard; mark the item that must follow it"
                        }
                    }
                    match item.prim {
                        .Group(inner) -> {
                            let e = check_cut_node_ctx(g, inner, rule, this_try, this_fold)
                            if e != "" { return e }
                        }
                        _ -> {}
                    }
                    if !prim_is_pred_e_sp(item.prim) { idx = idx + 1 }
                }
            }
        }
    }
    ""
}

fn prim_is_terminal_sp(prim: GPrim) -> bool {
    match prim {
        .Lit(_) -> true
        .Named(_) -> true
        _ -> false
    }
}

fn rep_is_one_sp(r: GRep) -> bool {
    match r { .One -> true  _ -> false }
}

/// The zero-width predicates the emitters skip (`@when`/`@peek`). Named apart from
/// prim_is_hand_or_pred, which also counts `@hand` — a cut BEFORE a `@hand` leaf is
/// legitimate (the leaf goes through emit_item, so the commit is emitted).
fn prim_is_pred_e_sp(prim: GPrim) -> bool {
    match prim {
        .Pred(_) -> true
        .Peek(_) -> true
        _ -> false
    }
}

/// True iff a branch's build is one of the legacy expr-fold helpers that take the
/// SPECIALISED emit_fold path (which bypasses emit_item, so a @off on such a branch
/// would be dropped from the generated parser). Mirrors emit.av `build_is_expr_fold`.
fn branch_is_expr_fold(b: GSeq) -> bool {
    match b.build {
        .Call(name, _) -> name == "fold_binary" || name == "fold_logical" || name == "fold_nullish" || name == "fold_postfix"
        _ -> false
    }
}

/// True for the primaries a @off marker must not wrap: a `@hand` delegate (manages
/// its own parser modes) and a `@when` predicate (zero-width, consumes nothing).
fn prim_is_hand_or_pred(prim: GPrim) -> bool {
    match prim {
        .Hand(_) -> true
        .Pred(_) -> true
        .Peek(_) -> true
        _ -> false
    }
}

// labeled = ( NAME ":" )? postfix
fn parse_labeled(p: GP) -> GItem {
    // t-47hc.21 COMMIT POINT: a leading `@cut` commits the enclosing `@try` branch
    // as of this item. Bare marker (no parens) — it takes no argument, so it is
    // consumed here and recorded on the item that FOLLOWS it (the cut point sits
    // BETWEEN items; attaching it to the next one is the same position and keeps
    // the emitters' `continue`-heavy item loops free of index arithmetic). A
    // trailing `@cut` has no following item to attach to and is rejected below.
    mut cut = false
    if at_cut_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "cut"
        cut = true
        if !seq_can_continue(p) {
            p.fail("`@cut` must be followed by an item — it marks the point a `@try` branch commits")
        }
    }
    // t-47hc.21 ABORT: `@require` makes a mismatch on this terminal stop the rule
    // rather than report-and-continue. Bare marker (no parens) — the message is the
    // sequence's `@expect`, so diagnostics keep ONE seam.
    mut require = false
    if at_require_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "require"
        require = true
        if !seq_can_continue(p) {
            p.fail("`@require` must be followed by an item — it marks a terminal whose absence aborts the rule")
        }
    }
    // ps3t.6.7 newline-sensitivity: a leading `^` marks the item same-line — it
    // matches only on the same source line as the previous token (the
    // postfix-chain cutoff). `^` lexes as a single-char PUNCT here.
    mut sameline = false
    if p.peek().kind == "PUNCT" && p.peek().text == "^" {
        let _ = p.advance()
        sameline = true
    }
    // t-47hc mode-SET marker `@off(flag)`: turn a settable ExprModes flag OFF for
    // this item's sub-parse (the `while foo {` struct-literal disambiguation the
    // hand parser does with `allow_struct_lit = false`). Distinguished from the
    // `@hand`/`@when`/`@try` primaries by the second token being `off` (parsed
    // later as the primary / branch marker). STRICT grammar: `@` `off` `(` NAME `)`
    // — the parens are required and the flag NAME is validated against
    // off_flag_supported. The raw NAME is interpolated into emitted source
    // (modes_with_flag_off(st.modes, "<NAME>")), so a typo or the READ-only
    // `at_quote_top` predicate must be a hard error here, not a silent no-op that
    // generates a dead mode-set. Malformed forms (missing `(`/`)`, non-NAME flag)
    // fail via p.fail rather than being accepted verbatim.
    mut mode_off = ""
    if at_off_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "off"
        p.expect_punct("(", "expected `(` after `@off`")
        if p.peek().kind == "NAME" {
            let fl = p.advance().text
            if off_flag_supported(fl) {
                mode_off = fl
            } else {
                p.fail("unknown `@off` flag `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode)")
            }
        } else {
            p.fail("expected a flag name in `@off(flag)`")
        }
        p.expect_punct(")", "expected `)` to close `@off(flag)`")
    }
    // t-47hc mode-SET marker `@on(flag)`: the SET-ON twin of `@off` — turn a settable
    // ExprModes flag ON for this item's sub-parse (parse_paren_expr re-enables
    // allow_dot_postfix inside `(...)`). Same STRICT grammar `@` `on` `(` NAME `)`,
    // validated against on_flag_supported. mode_off and mode_on can't both be set.
    mut mode_on = ""
    if at_on_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "on"
        p.expect_punct("(", "expected `(` after `@on`")
        if p.peek().kind == "NAME" {
            let fl = p.advance().text
            if on_flag_supported(fl) {
                mode_on = fl
            } else {
                p.fail("unknown `@on` flag `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode)")
            }
        } else {
            p.fail("expected a flag name in `@on(flag)`")
        }
        p.expect_punct(")", "expected `)` to close `@on(flag)`")
    }
    // Enforce the mutual-exclusion invariant the comments assert: emit_item /
    // exec_item honour mode_off FIRST and would silently drop a co-present
    // mode_on, so reject `@off(x) @on(y)` on one item as a hard parse error
    // rather than generate a dead mode-set.
    if mode_off != "" && mode_on != "" {
        p.fail("`@off` and `@on` cannot both apply to one item")
    }
    mut label = ""
    // A capture label is `NAME ":"` — needs one-token lookahead so a
    // bare NAME primary isn't mistaken for a label.
    if p.peek().kind == "NAME" && p.pos + 1 < p.toks.length {
        let nxt = p.toks[p.pos + 1]
        if nxt.kind == "PUNCT" && nxt.text == ":" {
            label = p.advance().text   // NAME
            let _ = p.advance()        // ":"
        }
    }
    let base = parse_postfix(p)
    GItem { label, rep: base.rep, prim: base.prim, sameline, mode_off, mode_on, cut, require, bound: base.bound }
}

// postfix = primary ( "*" | "+" | "?" )? ( "{" "#" NAME "}" )?
type Postfix = { rep: GRep, prim: GPrim, bound: string }

fn parse_postfix(p: GP) -> Postfix {
    let prim = parse_primary(p)
    mut rep = GRep.One
    if p.is_punct("*") {
        let _ = p.advance()
        rep = GRep.Star
    } else if p.is_punct("+") {
        let _ = p.advance()
        rep = GRep.Plus
    } else if p.is_punct("?") {
        let _ = p.advance()
        rep = GRep.Opt
    }
    // t-47hc.28 BOUNDED REPETITION `x{#cap}` — cap this repetition at the LENGTH of
    // an already-collected capture list. STRICT grammar `{` `#` NAME `}`: the `#`
    // sigil keeps the bound unmistakably a COUNT-OF rather than a rule reference, and
    // the braces cannot collide with anything else in postfix position (a `{` never
    // followed a postfix primary before this). Both delimiters are required, so a
    // malformed bound is a hard error, never a silently-dropped cap.
    mut bound = ""
    if p.is_punct("{") {
        let _ = p.advance()
        p.expect_punct("#", "expected `#` in a repetition bound — the form is `x{#capture}`")
        if p.peek().kind == "NAME" {
            bound = p.advance().text
        } else {
            p.fail("expected a capture name in `{#capture}`")
        }
        p.expect_punct("}", "expected `}` to close `{#capture}`")
        // A bound is only meaningful on a repetition that can run more than once.
        // On `?` or a bare item the cap is either vacuous or a contradiction, and
        // neither engine has anywhere to put it — reject rather than generate a
        // dead guard. (That the capture EXISTS and is bound earlier in the same
        // branch is checked once the whole grammar is parsed — validate_bounds.)
        match rep {
            .Star -> {}
            .Plus -> {}
            _ -> p.fail("`{#${bound}}` is only meaningful on a `*` or `+` repetition")
        }
    }
    // A `@when(flag)` predicate is a zero-width, One-repetition gate; a `*`/`+`/`?`
    // suffix is meaningless and both consumers mishandle it (the interpreter never
    // fires it; emit would `st.advance()` on a mode read). Reject it at parse time.
    match prim {
        .Pred(_) -> match rep { .One -> {}  _ -> p.fail("`@when(flag)` cannot take a `*`/`+`/`?` repetition suffix") }
        .Peek(_) -> match rep { .One -> {}  _ -> p.fail("`@peek(cond)` cannot take a `*`/`+`/`?` repetition suffix") }
        _ -> {}
    }
    Postfix { rep, prim, bound }
}

// primary = NAME | STRING | "(" alt ")"
fn parse_primary(p: GP) -> GPrim {
    let t = p.peek()
    if t.kind == "ERROR" {
        p.fail("unterminated string literal")
        let _ = p.advance()
        return GPrim.Lit("")
    }
    if t.kind == "STRING" {
        let _ = p.advance()
        return GPrim.Lit(t.text)
    }
    if t.kind == "NAME" {
        let _ = p.advance()
        if is_terminal_name(t.text) { return GPrim.Named(t.text) }
        return GPrim.Ref(t.text)
    }
    if p.is_punct("(") {
        let _ = p.advance()
        let inner = parse_alt(p)
        p.expect_punct(")", "expected `)` to close a group")
        return GPrim.Group(inner)
    }
    // Escape-hatch primary: `@hand(fn)` delegates to a hand-written rule.
    if at_hand_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "hand"
        p.expect_punct("(", "expected `(` after `@hand`")
        mut hf = ""
        if p.peek().kind == "NAME" { hf = p.advance().text }
        p.expect_punct(")", "expected `)` to close `@hand`")
        return GPrim.Hand(hf)
    }
    // Zero-width mode predicate: `@when(flag)` gates its branch on a parse mode.
    if at_when_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "when"
        p.expect_punct("(", "expected `(` after `@when`")
        mut flag = ""
        if p.peek().kind == "NAME" {
            let fl = p.advance().text
            // Validated for the same reason `@off`/`@on`/`@peek` validate theirs: the
            // name is interpolated into emitted source, and modes_flag ungates (returns
            // true for) anything it does not recognise — so an unvalidated typo becomes
            // an always-true guard rather than an error.
            if when_pred_supported(fl) {
                flag = fl
            } else {
                p.fail("unknown `@when` predicate `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode / at_quote_top / in_quote_body)")
            }
        }
        else { p.fail("expected a flag name in `@when(flag)`") }
        p.expect_punct(")", "expected `)` to close `@when`")
        return GPrim.Pred(flag)
    }
    // Zero-width LOOKAHEAD predicate: `@peek(cond)` gates its branch on an upcoming-token
    // test (executor.lookahead_ok). STRICT `@ peek ( NAME )`; the cond NAME is validated
    // against peek_cond_supported (a typo is a HARD error, never a silent no-op that
    // generates a dead guard — the raw name is interpolated into emitted source).
    if at_peek_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "peek"
        p.expect_punct("(", "expected `(` after `@peek`")
        mut cond = ""
        if p.peek().kind == "NAME" {
            let c = p.advance().text
            if peek_cond_supported(c) { cond = c }
            else { p.fail("unknown `@peek` cond `${c}` (expected: ident_colon, lparen_ident_colon, stmt_block, brace_map, for_destructure, match_subjectless, match_table, comma_ident, double_colon, decl_lead, if_let)") }
        }
        else { p.fail("expected a cond name in `@peek(cond)`") }
        p.expect_punct(")", "expected `)` to close `@peek`")
        return GPrim.Peek(cond)
    }
    p.fail("expected a rule reference, terminal, `(`, `@hand(fn)`, `@when(flag)`, or `@peek(cond)`")
    let _ = p.advance()
    GPrim.Lit("")
}

// build = NAME ( "(" ( NAME ( "," NAME )* )? ")" )?
fn parse_build(p: GP) -> GBuild {
    if p.peek().kind != "NAME" {
        p.fail("expected a build (constructor or helper name) after `->`")
        return GBuild.None
    }
    let name = p.advance().text
    if !p.is_punct("(") {
        return GBuild.Var(name)   // `-> e` : return the named capture
    }
    let _ = p.advance()  // "("
    // Args are comma-separated NAMEs. Commas are REQUIRED between args —
    // `Node(a b)` (missing comma) is rejected: after `a` with no comma
    // the loop stops and expect_punct fails on `b`.
    mut args: List<string> = []
    if !p.is_punct(")") {
        args.push(parse_build_arg(p))
        while p.is_punct(",") {
            let _ = p.advance()
            args.push(parse_build_arg(p))
        }
    }
    p.expect_punct(")", "expected `,` or `)` in a build's argument list")
    GBuild.Call(name, args)
}

fn parse_build_arg(p: GP) -> string {
    if p.peek().kind == "NAME" { return p.advance().text }
    p.fail("expected a capture name in a build's argument list")
    ""
}

// annot = "@expect" "(" STRING "," STRING ")"
//       | "@recover" "(" "sync_to" ":" STRING ")"
fn parse_annot(p: GP) -> GAnnot {
    let _ = p.advance()   // "@"
    mut kind = ""
    if p.peek().kind == "NAME" { kind = p.advance().text }
    // Only `@expect` / `@recover` are known — reject anything else
    // (e.g. `@foo(...)`) rather than silently treating it as @expect.
    if kind != "expect" && kind != "recover" {
        p.fail("unknown annotation `@${kind}` (expected `@expect` or `@recover`)")
    }
    p.expect_punct("(", "expected `(` after `@${kind}`")
    if kind == "recover" {
        // `sync_to` ":" STRING — the key MUST be `sync_to`.
        if p.peek().kind == "NAME" {
            let key = p.advance().text
            if key != "sync_to" {
                p.fail("expected `sync_to` in @recover(sync_to: …), got `${key}`")
            }
        } else {
            p.fail("expected `sync_to` in @recover(sync_to: …)")
        }
        p.expect_punct(":", "expected `:` in @recover(sync_to: …)")
        mut tok = ""
        if p.peek().kind == "STRING" { tok = p.advance().text } else { p.fail("expected a string token in @recover") }
        p.expect_punct(")", "expected `)` to close @recover")
        return GAnnot.Recover(tok)
    }
    // @expect(tok, msg) — both string operands required, comma between.
    mut tok = ""
    if p.peek().kind == "STRING" { tok = p.advance().text } else { p.fail("expected a token string in @expect") }
    p.expect_punct(",", "expected `,` between @expect's token and message")
    mut msg = ""
    if p.peek().kind == "STRING" { msg = p.advance().text } else { p.fail("expected a message string in @expect") }
    p.expect_punct(")", "expected `)` to close @expect")
    GAnnot.Expect(tok, msg)
}
