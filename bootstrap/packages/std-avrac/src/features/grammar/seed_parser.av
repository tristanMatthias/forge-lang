// WHY: ps3t.6.3 — the grammar-DSL *seed* parser. A small, stable,
// hand-written recursive-descent parser for the grammar-of-grammars
// (GRAMMAR_DSL.md §6), written ONCE (EBNF is stable, so it never
// churns — exactly as yacc has a hand-written parser for yacc input,
// tree-sitter for its grammar DSL). It reads grammar *text* into a
// `Grammar` value (ast.av); the generator (executor.av / emit.av,
// ps3t.6.4) turns that into a parser.
//
// Reading grammar text as a *string* (not new Avra surface syntax)
// keeps this bootstrap-window-clean: no seed cycle is needed to build
// and test it. The `grammar Foo { … }` *block* as Avra surface syntax
// is folded into the parser-migration step (ps3t.6.5).
//
// The grammar-of-grammars it implements (self-describing):
//   grammar  = "grammar" NAME "{" rule+ "}"
//   rule     = NAME "=" alt
//   alt      = seq ( "|" seq )*
//   seq      = labeled+ ( "->" build )? annot*
//   labeled  = ( NAME ":" )? postfix
//   postfix  = primary ( "*" | "+" | "?" )? ( "{" "#" NAME "}" )?
//   primary  = NAME | STRING | "(" alt ")"
//   build    = NAME ( "(" ( NAME ( "," NAME )* )? ")" )?
//   annot    = "@expect" "(" STRING "," STRING ")"
//            | "@recover" "(" "sync_to" ":" STRING ")"

use features.grammar.{Grammar, Rule, GNode, GSeq, GItem, GRep, GPrim, GBuild, GAnnot, BuildKindRow}
use features.grammar.{code_at, is_space_code, is_ident_start_code, is_ident_cont_code}
use features.grammar.{build_rule_index}
use features.grammar.{rep_is_one, grep_is_multi, onfail_policy_supported, onfail_policy_takes_capture}
use features.grammar.{gprim_ref_name, emit_lookup_rule, rule_result_kind, rule_result_kind_known}
use features.grammar.{list_labels_of, node_has_onfail}
use diagnostics.{diag_ice, render_diagnostic}

// ── The DSL token stream ──

/// One token of the grammar-of-grammars. `kind` ∈ {NAME, STRING,
/// PUNCT, ARROW, EOF}; for PUNCT `text` is the single char; for STRING
/// `text` is the unquoted contents.
/// The KIND of a grammar-DSL source token.
///
/// A bare `string` until t-y2i7 §13, compared against "NAME" / "ARROW" / "PUNCT"
/// / "STRING" / "EOF" / "ERROR" at 49 sites in this file, with nothing checking
/// the spelling — a typo compiled and silently never matched.
///
/// DISTINCT from `GKind`, which is the kind of an AVRA source token. The two
/// vocabularies overlap in spelling but not in meaning: this one has `NAME` and
/// `ARROW` (grammar-DSL surface), `GKind` has `IDENT` and the literal terminals.
/// They are deliberately separate enums, not one shared with unused arms.
export enum GTokKind { NAME, ARROW, PUNCT, STRING, EOF, ERROR }

export type GTok = { kind: GTokKind, text: string }

/// The parse outcome: the grammar plus an error string ("" == ok). A
/// nonempty `error` means `grammar` is a best-effort partial.
export type GrammarParse = { grammar: Grammar, error: string }

// ── Character classification (byte-level, ASCII) ──
// The generic char helpers (code_at / is_space_code / is_ident_*) live
// in chars.av and are imported above (shared with lex.av).

/// True when every char of `s` is an uppercase letter, digit, or `_`
/// (and it starts with a letter) — the EBNF convention marking a
/// *named terminal* (NUMBER, STRING) apart from a lowercase rule ref.
export fn is_terminal_name(s: string) -> bool {
    if s.length == 0 { return false }
    let first = code_at(s, 0)
    if !((first >= 65 && first <= 90) || first == 95) { return false }
    mut i = 0
    while i < s.length {
        let c = code_at(s, i)
        let ok = (c >= 65 && c <= 90) || c == 95 || (c >= 48 && c <= 57)
        if !ok { return false }
        i = i + 1
    }
    true
}

// ── Scanner: grammar text → List<GTok> ──

/// Tokenise the whole grammar source up front. Skips whitespace and
/// `// line comments`. Recognises identifiers, `"strings"`, the `->`
/// arrow, and single-char punctuation (`= | ( ) { } * + ? : , @`).
export fn scan_grammar(src: string) -> List<GTok> {
    mut toks: List<GTok> = []
    let n = src.length
    mut i = 0
    while i < n {
        let c = code_at(src, i)
        if is_space_code(c) {
            i = i + 1
            continue
        }
        // line comment
        if c == 47 && i + 1 < n && code_at(src, i + 1) == 47 {
            while i < n && code_at(src, i) != 10 { i = i + 1 }
            continue
        }
        // arrow `->`
        if c == 45 && i + 1 < n && code_at(src, i + 1) == 62 {
            toks.push(GTok { kind: GTokKind.ARROW, text: "->" })
            i = i + 2
            continue
        }
        // identifier
        if is_ident_start_code(c) {
            let start = i
            i = i + 1
            while i < n && is_ident_cont_code(code_at(src, i)) { i = i + 1 }
            toks.push(GTok { kind: GTokKind.NAME, text: src.substring(start, i) })
            continue
        }
        // string literal — contents without the surrounding quotes. A
        // backslash escapes the next char (so `\"` is not a terminator).
        // An unterminated literal (EOF before the closing quote) becomes
        // an ERROR token the parser rejects, rather than a silent STRING.
        if c == 34 {
            i = i + 1
            let start = i
            while i < n && code_at(src, i) != 34 {
                if code_at(src, i) == 92 && i + 1 < n {
                    i = i + 2
                    continue
                }
                i = i + 1
            }
            if i >= n {
                toks.push(GTok { kind: GTokKind.ERROR, text: src.substring(start, i) })
                continue
            }
            let text = src.substring(start, i)
            i = i + 1  // consume closing quote
            toks.push(GTok { kind: GTokKind.STRING, text })
            continue
        }
        // single-char punctuation
        toks.push(GTok { kind: GTokKind.PUNCT, text: src.substring(i, i + 1) })
        i = i + 1
    }
    toks.push(GTok { kind: GTokKind.EOF, text: "" })
    toks
}

// ── The recursive-descent seed parser ──

/// Parser state over the pre-scanned token list. `pos` is the cursor;
/// `error` accumulates the first diagnostic (best-effort partial after
/// that).
type GP = { toks: List<GTok>, pos: int, error: string }

impl GP {
    fn peek(self) -> GTok { self.toks[self.pos] }

    fn at_end(self) -> bool { self.peek().kind == GTokKind.EOF }

    fn advance(self) -> GTok {
        let t = self.toks[self.pos]
        if self.pos + 1 < self.toks.length { self.pos = self.pos + 1 }
        t
    }

    /// True when the cursor is a PUNCT with this exact text.
    fn is_punct(self, ch: string) -> bool {
        let t = self.peek()
        t.kind == GTokKind.PUNCT && t.text == ch
    }

    /// Consume a PUNCT `ch` if present; report `msg` otherwise.
    fn expect_punct(self, ch: string, msg: string) {
        if self.is_punct(ch) { let _ = self.advance() } else { self.fail(msg) }
    }

    fn fail(self, msg: string) {
        if self.error == "" {
            self.error = "${msg} (at `${self.peek().text}`)"
        }
    }
}

/// Parse a whole grammar string into a `Grammar`. Returns a
/// `GrammarParse` carrying the (possibly partial) grammar + an error
/// string ("" on success).
export fn parse_grammar(src: string) -> GrammarParse {
    let toks = scan_grammar(src)
    mut p = GP { toks, pos: 0, error: "" }
    let g = parse_grammar_body(p)
    // Validate `@off(flag)`/`@on(flag)` mode-SET marker POSITIONS after the tree is
    // built (the fold/@try shape is structural) — only when the parse itself was
    // clean, so a syntax error isn't masked by a position error on a half-built tree.
    if p.error == "" {
        let oe = validate_mode_markers(g)
        if oe != "" { p.error = oe }
    }
    // t-47hc.21: a `@cut` outside a `@try` branch is DEAD notation (a predictive
    // branch never rolls back, so there is nothing to commit), and `@require` only
    // means anything on a plain terminal. Reject either rather than accept a marker
    // that silently does nothing.
    if p.error == "" {
        let ce = validate_cuts(g)
        if ce != "" { p.error = ce }
    }
    // t-myz7: a `@gate` with no `@when`/`@peek` ahead of it in the SAME branch is
    // worse than dead — `seq_first_guard` returns the preds alone for a gated item,
    // so with no preds the guard is the EMPTY STRING and emit renders `if  {`, or the
    // group's guard collapses entirely. Reject it here, next to the `@cut` check,
    // for the same reason: a marker that silently produces a broken guard is the
    // failure mode these validators exist to prevent.
    if p.error == "" {
        let ge = validate_gates(g)
        if ge != "" { p.error = ge }
    }
    // t-myz7: `@onfail(drop)`'s shape check that needs the whole grammar — the referenced
    // rule's RESULT KIND. The per-item half (labelled, repeated, a rule reference) is
    // checked in parse_labeled where the item is built.
    if p.error == "" {
        let de = validate_onfail_drop(g)
        if de != "" { p.error = de }
    }
    // t-47hc.28: a repetition bound `x{#cap}` must name a capture the SAME branch has
    // already collected. Unbound or later-bound, the cap would read an empty list and
    // silently clamp the loop to zero iterations — a whole repetition vanishing with no
    // diagnostic, which is the exact failure mode the emit-regen review step exists to
    // catch. Make it a grammar-parse error instead.
    if p.error == "" {
        let be = validate_bounds(g)
        if be != "" { p.error = be }
    }
    // t-47hc.33: `@fallback` must be the LAST alternative, and unique. Both violations
    // are silent at runtime — a branch after it is simply never reached — so they are
    // grammar errors rather than surprises in the generated parser.
    if p.error == "" {
        let fe = validate_fallbacks(g)
        if fe != "" { p.error = fe }
    }
    GrammarParse { grammar: g, error: p.error }
}

extern fn avra_process_exit(code: int)

/// The PRODUCTION unwrap for a `grammar { }` block's parse result. A compiled-in
/// grammar is compiler source, so a parse/validation error in one is an ICE —
/// never a value to limp past. Every production accessor routes through this
/// instead of reading `.grammar` raw: the raw read is how an unknown `@peek`
/// cond (`body_marker`, pre-allowlist) silently degraded to an ungated
/// `Peek("")` in both the executor walk and the emitted static parser — the
/// exact "validation gate with a bypass path" failure mode. `parse_grammar`
/// itself stays non-fatal: the DSL's own error tests assert on `.error`.
/// The ICE renders through the diagnostics path (diag_ice → render_diagnostic,
/// the F9999 shape) per the zero-raw-errors policy; the dummy span skips the
/// snippet section, which is right — there is no user source to point at.
export fn grammar_checked(gp: GrammarParse) -> Grammar {
    if gp.error != "" {
        grammar_startup_fail("compiled-in grammar failed to parse: ${gp.error}")
    }
    gp.grammar
}

/// The shared hard-fail for compiled-in grammar INVARIANTS — grammar_checked's
/// parse gate above and the builder-manifest validation (features/lang.av,
/// t-kd4y.3) both die through here: the F9999 render, then exit. Compiler
/// source violating its own grammar contract is never a value to limp past.
export fn grammar_startup_fail(msg: string) {
    render_diagnostic("", "<compiled-in grammar>", diag_ice(msg))
    avra_process_exit(99)
}

fn parse_grammar_body(p: GP) -> Grammar {
    // Optional `grammar NAME { … }` wrapper.
    mut name = "grammar"
    mut wrapped = false
    if p.peek().kind == GTokKind.NAME && p.peek().text == "grammar" {
        wrapped = true
        let _ = p.advance()
        if p.peek().kind == GTokKind.NAME {
            name = p.advance().text
        } else {
            p.fail("expected grammar name after `grammar`")
        }
        p.expect_punct("{", "expected `{` to open grammar body")
    }
    mut rules: List<Rule> = []
    while !p.at_end() && !p.is_punct("}") {
        let before = p.pos
        rules.push(parse_rule(p))
        // Guard against a stuck cursor on malformed input — always
        // make progress so a bad rule can't spin forever (bounded).
        if p.pos == before { let _ = p.advance() }
    }
    // Envelope validation: a wrapped grammar MUST close its `}` and
    // declare at least one rule; nothing may trail the close.
    if wrapped {
        p.expect_punct("}", "expected `}` to close the grammar body")
        if !p.at_end() {
            p.fail("unexpected trailing tokens after `}`")
        }
    } else if p.is_punct("}") {
        let _ = p.advance()
    }
    if rules.length == 0 {
        p.fail("a grammar must declare at least one rule")
    }
    let no_rows: List<BuildKindRow> = []
    Grammar { name, rules, rule_idx: build_rule_index(rules), builder_kinds: no_rows }
}

// rule = NAME "=" alt
fn parse_rule(p: GP) -> Rule {
    mut rname = ""
    if p.peek().kind == GTokKind.NAME {
        rname = p.advance().text
    } else {
        p.fail("expected a rule name")
        let _ = p.advance()
    }
    p.expect_punct("=", "expected `=` after rule name `${rname}`")
    let body = parse_alt(p)
    Rule { name: rname, body }
}

// alt = seq ( "|" seq )*
fn parse_alt(p: GP) -> GNode {
    mut branches: List<GSeq> = []
    branches.push(parse_seq(p))
    while p.is_punct("|") {
        let _ = p.advance()
        branches.push(parse_seq(p))
    }
    GNode.Alt(branches)
}

// seq = labeled+ ( "->" build | annot )*
//
// The build and the error annotations may appear in either order after
// the items — GRAMMAR_DSL.md §2 writes `@expect … @recover … -> e`
// (annots before build), so parse them interleaved rather than fixing
// a rigid build-then-annots order.
/// True when the cursor is the `@try` branch marker — a leading, BRANCH-level
/// speculation flag (bounded backtracking), distinct from the `@when`-style
/// primaries and the `@expect`/`@recover` annotations.
fn at_try_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "try"
}

/// `@fallback` — the UNCONDITIONAL-tail branch marker (t-47hc.33). Same leading position
/// as `@try`, and mutually exclusive with it: a speculative branch is one that may roll
/// back and let a sibling try, which is the opposite of being the last resort.
fn at_fallback_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "fallback"
}

fn parse_seq(p: GP) -> GSeq {
    // A leading `@try` marks this alternative BOUNDED-BACKTRACKING (snapshot →
    // run → roll back + try the next branch on failure). Consumed here, before
    // the items, so it prefixes the branch rather than being an item.
    mut speculative = false
    if at_try_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "try"
        speculative = true
    }
    // `@fallback` marks this alternative the UNCONDITIONAL tail — run when no earlier
    // branch's FIRST matched, so the branch owns the rule's error message instead of the
    // alternation's generic one. Same leading position as `@try`, and rejected alongside
    // it: "may roll back so a sibling can try" and "is the last resort" cannot both hold.
    mut fallback = false
    if at_fallback_marker(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "fallback"
        fallback = true
        if speculative {
            p.fail("`@try` and `@fallback` cannot mark the same branch — a speculative branch rolls back so a SIBLING can run, which is the opposite of being the unconditional tail")
        }
    }
    mut items: List<GItem> = []
    while seq_can_continue(p) {
        let before = p.pos
        items.push(parse_labeled(p))
        if p.pos == before { let _ = p.advance() }  // bounded progress
    }
    // A sequence must have at least one item — an empty alternative
    // (`x = | "a"`) would otherwise lower to a `true` guard that shadows
    // every following alternative. Reject it here.
    if items.length == 0 {
        p.fail("expected at least one item in a sequence (empty alternative)")
    }
    // `@when(flag)` predicates are LEADING branch gates: they must precede every
    // consuming item, and a branch must have a consuming item for a predicate to
    // gate (a predicate-only branch can never be selected — and wrapped in a
    // repeat it would spin). Enforcing "leading" also keeps the two consumers
    // aligned: emit's seq_first_guard folds LEADING preds, while the executor's
    // branch_pred_ok scans ALL items — identical only when every pred is leading.
    mut ff_consuming = 0
    mut ff_pred_after = false
    for it in items {
        match it.prim {
            .Pred(_) -> if ff_consuming > 0 { ff_pred_after = true }
            // `@peek` is the same zero-width leading gate as `@when` (same leading-only
            // rule so emit's seq_first_guard and the executor's branch_pred_ok agree).
            .Peek(_) -> if ff_consuming > 0 { ff_pred_after = true }
            _ -> ff_consuming = ff_consuming + 1
        }
    }
    if ff_pred_after {
        p.fail("`@when`/`@peek` must be a leading branch gate (before any consuming item)")
    }
    // EXEMPT `@fallback` (t-47hc.5). The rule below is about FIRST-set dispatch: a
    // predicate-only branch contributes no FIRST token, so a DISPATCHED branch built
    // only from `@when`/`@peek` could never be selected. A `@fallback` branch is not
    // dispatched by FIRST at all — it is the UNCONDITIONAL tail, run precisely when no
    // earlier branch matched — so "never matches" is false for it, and a zero-width
    // tail is the only way an all-native alternation can own the "this token starts
    // nothing" position.
    if ff_consuming == 0 && !fallback {
        p.fail("`@when`/`@peek` must gate a branch that consumes input (a predicate-only branch never matches)")
    }
    mut build = GBuild.None
    mut annots: List<GAnnot> = []
    while true {
        if p.peek().kind == GTokKind.ARROW {
            let _ = p.advance()
            build = parse_build(p)
        } else if p.is_punct("@") {
            annots.push(parse_annot(p))
        } else {
            break
        }
    }
    // A `@try` branch is a bounded-speculation RECOGNIZER: emit lowers it to a
    // snapshot → run → commit-or-rollback block. Post-#995 (t-47hc GAP-3) that lowering
    // is faithful for the FULL item vocabulary — capturing builds, repetitions (list
    // accumulators), groups/opt, and `@on`/`@off` mode items — via the
    // emitter's rich speculative path (emit_speculative_branch_rich, which reuses
    // emit_seq_stmts + emit_seq_result inside the rollback scaffold) and the interpreter's
    // exec_seq (which snapshots+restores env.caps across the speculative run so a
    // rolled-back branch's bindings can't leak to a sibling). So NO branch SHAPE is
    // rejected here anymore; the only residual @try-specific rules are the label
    // constraints below (a bound label becomes a generated local, so it must not collide
    // with the branch scaffolding nor repeat within the branch — the same lockstep
    // discipline, now narrowed from "shape" to "labels").
    if speculative {
        // A bound label becomes an auto-scoped `let <label>` local in the generated
        // speculative branch (emit_spec_item). It must not (a) collide with the branch
        // scaffolding (`s_pos`/`s_mark`/`s_diags`/`s_err`/`s_last`/`sp_start`/`tried_spec`)
        // nor (b) repeat within the branch — `let x` twice won't compile. The interpreter
        // would silently last-wins a duplicate (set_scalar) and never see the scaffolding,
        // so both sides diverge unless we REJECT here (the same lockstep discipline).
        mut seen_labels: List<string> = []
        for lab_it in items {
            if lab_it.label == "" { continue }
            if try_label_reserved(lab_it.label) {
                p.fail("a `@try` branch label cannot be a reserved name (`s_pos`/`s_mark`/`s_diags`/`s_err`/`s_last`/`sp_start`/`tried_spec`) — it would collide with the speculative branch scaffolding")
            }
            if str_in_seq(seen_labels, lab_it.label) {
                p.fail("a `@try` branch cannot bind the label `${lab_it.label}` twice — each label becomes a distinct generated local")
            }
            seen_labels.push(lab_it.label)
        }
    }
    GSeq { items, build, annots, speculative, fallback }
}

/// True iff `name` is a local the generated speculative branch already binds
/// (emit_speculative_branch's snapshot scaffolding + span byte). A `@try` label
/// colliding with one of these would shadow/redeclare it in the emitted block.
fn try_label_reserved(name: string) -> bool {
    name == "s_pos" || name == "s_mark" || name == "s_diags" || name == "s_err" ||
        name == "s_last" || name == "sp_start" || name == "tried_spec"
}

/// Membership test over a `List<string>` (seed_parser-local; emit.av's `str_in`
/// is module-private there).
fn str_in_seq(xs: List<string>, s: string) -> bool {
    for x in xs {
        if x == s { return true }
    }
    false
}

/// A sequence keeps taking items until a FOLLOW token: `|`, `)`, `}`,
/// `->`, a trailing `@`-annotation, or EOF — or the start of the NEXT
/// rule. Because the scanner strips newlines, a rule boundary is
/// detected by lookahead: a `NAME "="` ahead begins the next
/// production, not another item.
fn seq_can_continue(p: GP) -> bool {
    if p.at_end() { return false }
    if p.peek().kind == GTokKind.ARROW { return false }
    if p.is_punct("|") || p.is_punct(")") || p.is_punct("}") { return false }
    // `@when(...)`-style forms are PRIMARIES (items) and `@off(...)` is a
    // leading item MARKER — keep going; `@expect`/`@recover` are trailing
    // annotations — stop the item list.
    if p.is_punct("@") { return at_when_primary(p) || at_peek_primary(p) || at_gensym_primary(p) || at_rawbrace_primary(p) || at_off_marker(p) || at_on_marker(p) || at_on_if_marker(p) || at_bump_marker(p) || at_cut_marker(p) || at_require_marker(p) || at_gate_marker(p) || at_onfail_marker(p) }
    if p.peek().kind == GTokKind.NAME && p.pos + 1 < p.toks.length {
        let nxt = p.toks[p.pos + 1]
        if nxt.kind == GTokKind.PUNCT && nxt.text == "=" { return false }
    }
    true
}

/// True when the cursor is `@when` — the zero-width mode-predicate primary
/// (t-47hc.3), distinct from the `@expect`/`@recover` sequence annotations.
fn at_when_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "when"
}

/// True when the cursor is `@gensym` — the zero-width GENERATOR primary. Same
/// consumes-nothing shape as `@when`/`@peek`, but it BINDS rather than gates: it mints
/// a fresh name into its label at the position it appears (t-47hc.26).
fn at_gensym_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "gensym"
}

/// True when the cursor is `@rawbrace` — the raw balanced-brace CAPTURE primary
/// (t-47hc.31). Unlike the zero-width markers it CONSUMES tokens (everything up to
/// the balancing `}`), binding the verbatim source slice.
fn at_rawbrace_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "rawbrace"
}

/// True when the cursor is `@peek` — the zero-width LOOKAHEAD-predicate primary
/// (t-47hc paren prep), the token-stream sibling of `@when`.
fn at_gate_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "gate"
}

fn at_peek_primary(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "peek"
}

/// The single source of truth for the `@peek(cond)` NAME set. BOTH the validator
/// below and the "unknown cond" diagnostic in `parse_primary` read this one list —
/// hand-maintaining a second copy for the message is exactly how `comma_not_rbrace`
/// came to be accepted-but-unlisted, telling a user with a typo that a legal cond was
/// illegal. There is no second copy now.
export fn peek_cond_names() -> List<string> {
    [
        "ident_colon", "lparen_ident_colon", "stmt_block", "brace_map", "for_destructure",
        "match_subjectless", "match_table", "comma_ident", "not_gt", "double_colon",
        "decl_lead", "if_let", "ident_lbrace", "tilde_ident_lbrace", "ident_lbrace_plain",
        "ident_lbrace_feature", "ident_template", "ident_plain", "qdot_plain_field",
        "qdot_method_call", "dot_plain_field", "dot_enum_ctor", "dot_number",
        "comma_not_rparen", "not_rparen", "not_rbrace", "comma_not_rbracket",
        "comma_not_rbrace", "quote_arm", "quote_type", "body_marker", "kw_let",
        "cfg_pair_value", "cfg_pair_eq", "comp_inst_shape", "comp_nested_named",
        "comp_nested_bare", "comp_nested_raw_named", "comp_nested_raw_bare", "comp_method",
        "bare_comp_inst", "bare_comp_inst_raw", "always", "return_value",
        "cur_ident", "paren_lambda_ahead", "paren_arrow_ahead", "paren_comma_ahead", "list_comp_ahead", "comp_paren_shape",
        "comp_implements_inst", "kw_implements", "let_destructure", "kw_config", "kw_children",
        "annot_lead", "bare_inst_lead"
    ]
}

/// The joined, comma-separated rendering of `peek_cond_names` — the `expected: …`
/// tail of the unknown-cond diagnostic.
export fn peek_cond_expected_list() -> string {
    peek_cond_names().join(", ")
}

/// The lookahead conditions a `@peek(cond)` marker may name — membership in
/// `peek_cond_names` above, which is the SET's single source of truth. Consulted by
/// parse_primary (a typo is rejected at parse time).
/// Kept in lockstep with executor.lookahead_ok (which maps each name to
/// a token test) and emit.peek_guard (which emits the equivalent generated guard) — a
/// new cond is added in all three. `ident_colon`: the current token is an IDENT and the
/// next is `:` — Parser.peek_after_ident_is_colon's question (typed lambda).
/// `stmt_block` is the statement-position non-map-brace predicate;
/// `for_destructure` and `comma_ident` select tuple-loop bindings and their
/// non-trailing separator commas. `double_colon` preserves the
/// no-whitespace `::` requirement for qualified type names.
export fn peek_cond_supported(cond: string) -> bool {
    // `lparen_ident_colon`: the position-0 twin of `ident_colon` — cur is `(`, the next
    // token an IDENT, the one after `:` (the TYPED-LAMBDA opener, checked from before `(`
    // so the paren rule spans from the `(` byte). See executor.lookahead_ok.
    // `decl_lead`: "is this a DECLARATION lead?" — true for every non-IDENT lead,
    // and for an IDENT only in the component-instantiation shape `Comp inst {`
    // (t-47hc.24). See executor.lookahead_ok.
    // `if_let`: `if` immediately followed by `let` — the bind-fresh if-let form.
    // See executor.lookahead_ok.
    // `ident_lbrace`: cur is an IDENT and the next token is `{` — the token twin of
    // Parser.peek_after_ident_is_lbrace, which distinguishes the `~Name { … }`
    // constructor-name splice from the greedy `~expr` form. See executor.lookahead_ok.
    // `ident_lbrace_plain`: the same two tokens MINUS the table literal and any
    // registered `kw { … }` construct — i.e. the ident+`{` that really is a struct
    // literal, which a native struct-lit branch must gate on so it does not capture
    // `table { … }` or `grammar { … }` (t-47hc slice 8).
    // `ident_lbrace_feature`: the exact COMPLEMENT of that exclusion (plus the TYPED
    // `table<Row> { … }`) — the feature-form seam. See executor.lookahead_ok (t-myz7).
    // `dot_number`: cur is `.` and the next token is a NUMBER — the tuple-index reading
    // `t.0`, kept apart from the `.field` branch that shares its FIRST token. See
    // executor.lookahead_ok.
    // `comma_not_rparen`: a `,` followed by another argument rather than the closing
    // `)` — the trailing-comma guard for an argument list. LIVE: spent by the native
    // call form, and reused verbatim by every argument list since (generic call,
    // enum ctor, optional method call), which is why `f(a, b,)` closes instead of
    // looking for a fourth argument.
    // `body_marker`: the component-def `body: TokenStream` marker gate — the word
    // `body` followed by `:` (t-47hc slice A). `kw_let`: the current token is the
    // `let` keyword — comp_field's declared-dispatch gate over `declaration`'s
    // routed let_decl. See executor.lookahead_ok for both.
    mut ok = false
    for c in peek_cond_names() { if c == cond { ok = true } }
    ok
}

/// The parse-MODE flags a `@off(flag)` marker (GItem.mode_off) may turn off —
/// exactly the SETTABLE ExprModes bools (executor.av). The single source of truth
/// for the @off flag SET, consulted by parse_labeled: every `@off(NAME)` is
/// validated against it and anything else is rejected at parse time, so a typo
/// (`allow_strct_lit`) or the READ-only `@when` predicate `at_quote_top` (derived
/// from `quote_depth`, not a settable bool) is a HARD grammar error, never a silent
/// no-op. `executor.modes_with_flag_off` maps exactly these names to their fields —
/// the two lists MUST stay in lockstep (a new @off-able flag is added in both).
/// Lives here (with its only consumer) rather than in the universally-imported
/// core ast.av, keeping the core module's export surface minimal.
export fn off_flag_supported(flag: string) -> bool {
    flag == "allow_struct_lit" || flag == "allow_dot_postfix" ||
        flag == "allow_it_sugar" || flag == "cell_mode"
}

/// The predicates a `@when(flag)` marker may READ — the single source of truth for the
/// @when SET, in lockstep with `executor.modes_flag` (which maps each name to its
/// reading) and `emit.pred_guard` (its byte-side twin).
///
/// This is WIDER than off_flag_supported: `@off`/`@on` may only name a SETTABLE bool,
/// while `@when` may also read a DERIVED predicate — `at_quote_top` / `in_quote_body`
/// are computed from the `quote_depth` counter, so they are legal to read and illegal
/// to set. That asymmetry is the reason for two lists rather than one.
///
/// Validating at all is the point: `modes_flag` answers TRUE for an unrecognised flag
/// (an unknown predicate is ungated), so before this existed a typo — `@when(allow_strct_lit)`
/// — parsed clean and emitted a guard that was always true. A dead gate that silently
/// admits every branch is exactly the silent-failure class `@off`, `@on` and `@peek`
/// each already reject by name, and `@when` was the one marker that did not.
export fn when_pred_supported(flag: string) -> bool {
    flag == "allow_struct_lit" || flag == "allow_dot_postfix" ||
        flag == "allow_it_sugar" || flag == "cell_mode" ||
        flag == "at_quote_top" || flag == "in_quote_body" ||
        flag == "base_callable" || flag == "base_upper_ident" || flag == "dot_postfix_ok" ||
        flag == "base_field_access"
}

/// The parse-MODE flags a `@on(flag)` marker (GItem.mode_on) may turn ON — the
/// SET-ON twin of off_flag_supported (the same settable ExprModes bools). Kept in
/// lockstep with executor.modes_with_flag_on (a new @on-able flag is added in both).
export fn on_flag_supported(flag: string) -> bool {
    flag == "allow_struct_lit" || flag == "allow_dot_postfix" ||
        flag == "allow_it_sugar" || flag == "cell_mode"
}

/// True when the cursor is `@off` — the leading mode-SET item marker (t-47hc),
/// distinct from the `@when`-style primaries and the `@expect`/`@recover`
/// annotations. It prefixes the item it scopes, so seq_can_continue must treat
/// it as an item-start (else the item-list loop stops before it).
fn at_off_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "off"
}

/// True when the cursor is `@cut` — the COMMIT-POINT marker (t-47hc.21). Bare (no
/// parens), so it needs no argument validation. Same item-start role as `@off`/`@on`,
/// so seq_can_continue must treat it as an item-start too.
fn at_cut_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "cut"
}

/// True when the cursor is `@require` — the ABORT marker (t-47hc.21). Bare, like
/// `@cut`: the diagnostic still comes from the sequence's `@expect`.
fn at_require_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "require"
}

/// True when the cursor is `@onfail` — the NON-ABORTING FAILURE-POLICY marker (t-myz7),
/// `@require`'s recovering dual. Takes an argument (the policy), so unlike `@cut` /
/// `@require` it validates it — against `onfail_policy_supported`, the one list both
/// engines read.
fn at_onfail_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "onfail"
}

/// The COUNTERS a `@bump(counter)` marker may increment — an int cell in ExprModes, NOT
/// a settable bool, which is why this is its own list rather than a reuse of
/// off_flag_supported/on_flag_supported. The same read/set asymmetry already exists on
/// the `@when` side (when_pred_supported is wider than off_flag_supported because it
/// also admits values DERIVED from this counter). Lockstep with
/// executor.modes_with_counter_bumped.
export fn bump_counter_supported(counter: string) -> bool {
    counter == "quote_depth"
}

/// True when the cursor is `@bump` — the counter-SET marker (t-47hc.32), the int twin of
/// at_off_marker/at_on_marker. Same item-start treatment: it PREFIXES the item it scopes.
fn at_bump_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "bump"
}

/// True when the cursor is `@on` — the SET-ON twin of at_off_marker. Same item-start
/// role, so seq_can_continue must treat it as an item-start too.
fn at_on_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "on"
}

/// True when the cursor is `@on_if` — the CONDITIONAL twin of at_on_marker (t-47hc.34).
/// A distinct NAME from `on`, so the two detectors cannot both fire on one marker.
fn at_on_if_marker(p: GP) -> bool {
    if !p.is_punct("@") { return false }
    if p.pos + 1 >= p.toks.length { return false }
    let nxt = p.toks[p.pos + 1]
    nxt.kind == GTokKind.NAME && nxt.text == "on_if"
}

// ── @off / @on mode-SET marker POSITION validation (t-47hc) ──

/// Reject `@off(flag)`/`@on(flag)` in any position the GENERATED parser can't honor
/// identically to the executor — see check_mode_node for the restrictions.
/// A violation is a HARD grammar error — keeping the executor and the
/// generated parser in lockstep (BOTH reject the same grammars) instead of silently
/// diverging. Runs after the tree is built (the fold/@try shape is structural).
/// Returns "" when clean.
fn validate_mode_markers(g: Grammar) -> string {
    for rule in g.rules {
        let e = check_mode_node(rule.body, rule.name, false)
        if e != "" { return e }
    }
    ""
}

/// Validate `@off`/`@on` mode-SET marker POSITIONS. Post-#995 (t-47hc GAP-3) a mode
/// marker is HONORED on every emit path that routes through emit_item — the general
/// dispatch (emit_seq_items), a `@try` branch (emit_speculative_branch_rich reuses
/// emit_seq_stmts → emit_seq_items → emit_item), AND inside a nested group (emit_opt /
/// emit_repeat_group → emit_node_items → emit_seq_items → emit_item, recursively). The
/// executor's exec_item wraps every item's sub-parse in push/restore identically. So
/// `@try` and nested-group markers are NO LONGER rejected. Two restrictions remain, both
/// real correctness gates, threaded down via `in_fold`:
///   (1) an EXPR-FOLD branch (fold_binary/…): emit_fold bypasses emit_item entirely, so a
///       mode marker anywhere inside it would be silently DROPPED from the generated parser
///       (a divergence the span-blind gates wouldn't catch) — reject it.
///   (2) a marker wrapping a `@when`/`@peek`/`@gensym`/`@rawbrace` primary: they are
///       zero-width — a mode-set around them is meaningless.
fn check_mode_node(node: GNode, rule: string, in_fold: bool) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                // `in_fold` carries the enclosing branch's fold context DOWN through groups:
                // a group inside a fold branch also takes the fold emit path, so its markers
                // are dropped too. A group's OWN inner branches almost always build `.None`,
                // so branch_is_expr_fold(inner) is false — the outer context is what matters.
                let this_fold = in_fold || branch_is_expr_fold(b)
                for item in b.items {
                    // The THREE mode-SET markers are mutually exclusive on one item
                    // (enforced at parse) and share identical emit/exec positions, so
                    // validate whichever is present with the same rule. `@bump` is here
                    // for exactly the reason `@off`/`@on` are: emit_item is the ONLY
                    // place the wrapper is generated, so a marker in a position that
                    // bypasses emit_item is silently dropped rather than diagnosed.
                    let mk = if item.mode_off != "" { "@off" } else if item.mode_on != "" { "@on" } else { "@bump" }
                    let fl = if item.mode_off != "" { item.mode_off } else if item.mode_on != "" { item.mode_on } else { item.mode_bump }
                    if item.mode_off != "" || item.mode_on != "" || item.mode_bump != "" {
                        if this_fold {
                            return "`${mk}(${fl})` cannot appear on (or inside a group of) an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the mode set"
                        }
                        if prim_rejects_mode_wrap(item.prim) {
                            return "`${mk}(${fl})` cannot wrap a `@when`/`@peek`/`@gensym`/`@rawbrace` primary (rule `${rule}`)"
                        }
                        // A mode marker on a `@require` item USED to be rejected here: the
                        // emitted wrapper is `save; set; <item>; restore`, a failed
                        // `@require` emits an early `return` from inside <item>, and that
                        // skipped the restore — so the set mode leaked into the rest of the
                        // parse. The note said "rather than thread cleanup through every
                        // emitted return path, reject the combination — it has no use
                        // today".
                        //
                        // The cleanup IS threaded now, on both engines, and the combination
                        // HAS a use. emit wraps the body through `restore_modes_before_aborts`
                        // (emit.av), which inserts `st.set_modes(__modes_N)` ahead of every
                        // abort return inside the wrapper; the executor never had the hole,
                        // because its abort is a FLAG set on the way out (`env.set_abort`)
                        // rather than an early return, so `exec_item_marked`'s restore always
                        // runs — and a `@require` on a rule REF checks FIRST *before* calling
                        // it, so a failure there never entered the wrapper at all.
                        //
                        // The use is `quote type { <type> }`: the type position needs
                        // `@require` to abort with "expected a type inside
                        // `quote type { ... }`" instead of reporting a generic F0040 and then
                        // reporting the missing `}` too, and it needs `@bump(quote_depth)` so
                        // a splice inside it still sees a nonzero depth. Rejecting the pair
                        // forced picking one.
                        //
                        // Guarded by `mode_restore_on_abort_test.av`, which asserts BOTH the
                        // emitted restore-before-abort ordering and that a real parse of the
                        // aborting form leaves `quote_depth` unleaked.
                    }
                    // A structural group is a NESTED sequence: recurse to validate its
                    // markers too (now ALLOWED unless we're inside a fold branch), carrying
                    // the fold context so a fold-branch group is still rejected.
                    match item.prim {
                        .Group(inner) -> {
                            let e = check_mode_node(inner, rule, this_fold)
                            if e != "" { return e }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    ""
}

/// Is `s` one of `xs`? DELIBERATELY FILE-PRIVATE, and it must stay that way.
///
/// This feature carries several near-identical copies of this loop (`list_has` in
/// executor.av, `ffs_has` in first_follow.av, `frag_name_in` in compose.av, `str_in`
/// in emit.av — which additionally treats `""` as absent). That looks like textbook
/// duplication to remove, and removing it BREAKS THE BUILD in a way no ordinary gate
/// catches: hoisting one shared `export fn` into ast.av and calling it across files
/// makes every `@expand(...)` comptime macro fail with
///
///     F4005 … can only call functions (callee=@std::avrac::features::grammar::name_in
///     kind=type_marker)
///
/// because `parse_grammar` is reachable from comptime macro expansion, and the
/// comptime evaluator resolves a cross-module callee that is not `@comptime` to a
/// type_marker rather than a function (features/eval/mod.av `value_type_marker`; the
/// same trap is recorded at features/derive/emit.av `name_vtype`). A plain
/// compile, `--emit-gen-check`, and even a byte-identical `diff-test` all stay GREEN —
/// the comptime path is only exercised on the manifest-driven build, which is why
/// CLAUDE.md insists the metadata lib build is the real smoke test.
///
/// So the duplication is load-bearing, not rot. If it is ever genuinely consolidated,
/// the shared helper has to be `@comptime` AND the change has to be validated by
/// building a package that uses `@expand`, not by the parser gates alone.
fn name_in(xs: List<string>, s: string) -> bool {
    for x in xs {
        if x == s { return true }
    }
    false
}

/// Reject every repetition bound (`x{#cap}`) whose capture is not already collected
/// at that point in the branch. Scope is one alternation BRANCH scanned left to
/// right, which is exactly what both engines see: the executor binds into a shared
/// per-rule CapEnv as it walks the items, and the generated parser declares one
/// `<label>_list` accumulator per branch and fills it in the same order. A bound
/// naming a capture that appears LATER (or not at all) would read an empty list and
/// clamp the loop to zero iterations silently.
///
/// A bound is only honoured against a LIST capture — one collected by a `*`/`+`, or
/// by a label repeated across items. A scalar capture has no length, so naming one is
/// rejected too rather than being counted as 1.
/// `@fallback` must be the LAST alternative, and there may be only one. A guarded branch
/// ordered AFTER it is dead — the fallback runs whenever nothing earlier matched, so the
/// sibling can never be reached — and two fallbacks make "which is the tail" positional
/// rather than declared. Both are silent misbehaviour at runtime, so they are grammar
/// errors here.
fn validate_fallbacks(g: Grammar) -> string {
    for r in g.rules {
        match r.body {
            .Alt(branches) -> {
                // COUNT first, then check position. Two fallbacks necessarily also
                // violate "must be last", so checking position inside the loop would
                // report that instead and the duplicate would never be named.
                mut seen = 0
                for b in branches { if b.fallback { seen = seen + 1 } }
                if seen > 1 {
                    return "rule `${r.name}` has more than one `@fallback` branch — only the last alternative can be the unconditional tail"
                }
                // `@fallback` must be the LAST alternative. THE DECLARED SEMANTIC
                // (t-47hc.35), implemented identically in emit_dispatch and
                // exec_node:
                //
                //   A `@fallback` branch is the alternation's UNCONDITIONAL TAIL.
                //   It runs when no branch's FIRST matched — including after a
                //   `@try` sibling rolled back. If it carries a `@when`/`@peek`
                //   guard and the guard declines, the rule yields a clean
                //   no-match rather than a synthesised error.
                //
                // Requiring LAST is what makes the marker mean one thing. emit
                // honours it only in last position (`b.fallback && i == last`);
                // elsewhere the branch emits as an ordinary FIRST-guarded one and
                // the marker is a silent no-op. The executor used to scan for a
                // fallback at ANY position, so a non-last one meant two different
                // things depending on which engine read it.
                //
                // The previous exemption for a GUARDED non-last fallback existed
                // for `postfix_suffix`'s `.` branch. That rule no longer has a
                // fallback at all — the postfix flip rewrote it as an alternation
                // of named suffix rules — so the exemption guarded nothing and was
                // the last surface on which the engines could disagree. Rejecting
                // it outright is the "reject only genuinely-meaningless spellings"
                // reduction: a marker emit drops IS meaningless, and a reader
                // cannot tell that from the grammar text.
                mut i = 0
                for b in branches {
                    if b.fallback && i != branches.length - 1 {
                        return "`@fallback` must be the LAST alternative of rule `${r.name}` — emit honours it only in last position, so ordering it earlier is a silent no-op in the generated parser while the interpreter would still run it as the tail"
                    }
                    i = i + 1
                }
            }
        }
    }
    ""
}

fn validate_bounds(g: Grammar) -> string {
    // `parse_grammar` runs on the production parse path, so this pass must cost
    // effectively nothing for the grammars that DON'T use a bound — which today is
    // all of them. The visibility scan below allocates two lists per branch, so gate
    // it on a bound existing at all: one allocation-free walk, then out.
    if !grammar_has_bound(g) { return "" }
    for rule in g.rules {
        let e = check_bound_node(rule.body, rule.name)
        if e != "" { return e }
    }
    ""
}

fn grammar_has_bound(g: Grammar) -> bool {
    for rule in g.rules {
        if node_has_bound(rule.body) { return true }
    }
    false
}

/// True when anything in the grammar NAMES a capture — a `{#cap}` bound or an
/// `@onfail(discard, <label>)`. Both are checked by the same visibility walk (a discard
/// names a capture under exactly the rule a bound does: a LIST collected earlier in the
/// same branch), so one detector gates both rather than two that could drift.
fn node_has_bound(node: GNode) -> bool {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for item in b.items {
                    if item.bound != "" || item.onfail_cap != "" { return true }
                    match item.prim {
                        .Group(inner) -> {
                            if node_has_bound(inner) { return true }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    false
}

fn check_bound_node(node: GNode, rule: string) -> string {
    let no_lists: List<string> = []
    let no_seen: List<string> = []
    check_bound_node_in(node, rule, no_lists, no_seen, false)
}

/// `outer_lists`/`outer_seen` are the captures already collected to the LEFT of this
/// node by the ENCLOSING branch. Threading them is what lets a bound written INSIDE a
/// group see the enclosing branch's captures — which is not an edge case but the
/// headline shape: `match … table`'s per-row cell loop is
/// `( h:IDENT )+ ( p:pattern c:cell{#h} )*`, where the bound sits inside the row group
/// and `h` comes from the header row outside it. Restarting the scope at each group
/// made that grammar unparseable.
///
/// `under_multi` says this node sits inside a repeating group, which makes every
/// capture within it list-shaped — mirroring emit's `node_labels_of(inner, under_multi)`,
/// because the two must agree on what a `<label>_list` accumulator exists for.
fn check_bound_node_in(node: GNode, rule: string, outer_lists: List<string>, outer_seen: List<string>, under_multi: bool) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                // Labels that are LIST-shaped by the time each item is reached. Seeded
                // from the enclosing scope, then built incrementally so a bound can only
                // ever see captures to its LEFT.
                mut lists: List<string> = []
                mut seen: List<string> = []
                for l in outer_lists { lists.push(l) }
                for l in outer_seen { seen.push(l) }
                for item in b.items {
                    if item.onfail_cap != "" {
                        // Consult the EMITTER's own answer (`list_labels_of`) rather than the
                        // incremental `lists` prefix: emit declares every `<label>_list`
                        // accumulator at BRANCH level, including labels bound inside nested
                        // groups, and the discard assigns to exactly that local. The prefix scan
                        // is right for `{#cap}` (which must only see captures to its LEFT) and
                        // wrong here — `( "<" ( … tparams … )? @onfail(discard, tparams) ">" )?`
                        // binds through a nested group, which the prefix cannot see.
                        if name_in(list_labels_of(b), item.onfail_cap) {
                            // fine — the branch declares a `<label>_list` accumulator
                        } else if name_in(seen, item.onfail_cap) {
                            return "`@onfail(discard, ${item.onfail_cap})` in rule `${rule}` names a scalar capture — discard throws away a LIST (one collected by `*`/`+`)"
                        } else {
                            return "`@onfail(discard, ${item.onfail_cap})` in rule `${rule}` names `${item.onfail_cap}`, which is not captured earlier in this branch"
                        }
                    }
                    if item.bound != "" {
                        // A repetition bounded by a capture IT ITSELF writes is
                        // self-limiting, and the two engines would not agree on it:
                        // exec_repeat reads the cap ONCE up front, while the emitted
                        // loop compares against a `_list` that the loop keeps growing.
                        // Reject rather than pick a winner. The capture is usually on
                        // an INNER item of an unlabelled group, so the item's own label
                        // is not enough — ask what the whole item writes.
                        if name_in(item_written_labels(item), item.bound) {
                            return "`{#${item.bound}}` in rule `${rule}` bounds a repetition by a capture that repetition itself writes"
                        }
                        if name_in(lists, item.bound) {
                            // fine — a list capture bound earlier in this branch
                        } else if name_in(seen, item.bound) {
                            return "`{#${item.bound}}` in rule `${rule}` names a scalar capture — a bound needs a list capture (one collected by `*`/`+`)"
                        } else {
                            return "`{#${item.bound}}` in rule `${rule}` names `${item.bound}`, which is not captured earlier in this branch"
                        }
                    }
                    if item.label != "" {
                        // LIST-shaped means exactly what the EMITTER declares a
                        // `<label>_list` accumulator for: a label under a `*`/`+`, own
                        // or inherited from an enclosing repeating group (emit's
                        // list_labels_of / node_labels_of). A label merely REPEATED
                        // across two `One` items is NOT one — the emitter declares no
                        // accumulator for it, so accepting a bound on it would emit a
                        // reference to an undeclared `<label>_list` and the generated
                        // file would not compile, while the interpreter's capval_len saw
                        // a last-wins scalar and answered 1. Both engines must agree on
                        // what a bindable list is.
                        let multi = under_multi || match item.rep { .Star -> true  .Plus -> true  _ -> false }
                        if multi {
                            if !name_in(lists, item.label) { lists.push(item.label) }
                        }
                        if !name_in(seen, item.label) { seen.push(item.label) }
                    }
                    match item.prim {
                        .Group(inner) -> {
                            let multi = under_multi || match item.rep { .Star -> true  .Plus -> true  _ -> false }
                            // Recurse BEFORE merging the group's own labels outward, so a
                            // bound inside the group sees only what is genuinely to its
                            // LEFT — the enclosing branch's captures plus, via the inner
                            // walk's own accumulation, the group items preceding it.
                            let e = check_bound_node_in(inner, rule, lists, seen, multi)
                            if e != "" { return e }
                            // A group's items bind into the SAME env, so its labels are
                            // visible to later items of THIS branch.
                            let sub = group_label_shapes(inner, multi)
                            for l in sub.lists {
                                if !name_in(lists, l) { lists.push(l) }
                            }
                            for l in sub.all {
                                if !name_in(seen, l) { seen.push(l) }
                            }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    ""
}

/// Every capture label an item writes — its own, plus all of them inside it when the
/// item is a group. This is what a bound must not name (see check_bound_node).
fn item_written_labels(item: GItem) -> List<string> {
    mut out: List<string> = []
    if item.label != "" { out.push(item.label) }
    match item.prim {
        .Group(inner) -> {
            for l in group_label_shapes(inner, false).all {
                if !name_in(out, l) { out.push(l) }
            }
        }
        _ -> {}
    }
    out
}

/// The capture labels a group contributes to its ENCLOSING branch, split by shape:
/// `lists` are list-collecting (bindable as a bound), `all` is every label seen.
/// A group's items bind into the same env as the branch around it, so these are
/// visible to a later bound in that branch. `multi` is true when the group itself
/// repeats, which makes every capture inside it list-shaped regardless of the inner
/// item's own repetition. Returned rather than accumulated through parameters —
/// `List` params are immutable, and a pure result keeps the visibility rule readable.
type LabelShapes = { lists: List<string>, all: List<string> }

fn group_label_shapes(node: GNode, multi: bool) -> LabelShapes {
    mut lists: List<string> = []
    mut all: List<string> = []
    match node {
        .Alt(branches) -> {
            for b in branches {
                for item in b.items {
                    if item.label != "" {
                        // Same rule as check_bound_node_in: list-shaped ⇔ under a
                        // `*`/`+`, never merely repeated across `One` items.
                        let item_multi = match item.rep { .Star -> true  .Plus -> true  _ -> false }
                        if multi || item_multi {
                            if !name_in(lists, item.label) { lists.push(item.label) }
                        }
                        if !name_in(all, item.label) { all.push(item.label) }
                    }
                    match item.prim {
                        .Group(inner) -> {
                            let sub = group_label_shapes(inner, multi)
                            for l in sub.lists {
                                if !name_in(lists, l) { lists.push(l) }
                            }
                            for l in sub.all {
                                if !name_in(all, l) { all.push(l) }
                            }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    LabelShapes { lists, all }
}

/// Reject every `@cut` the executor and the generated parser would not honor
/// identically. `in_try` carries the enclosing `@try` DOWN through groups: a group
/// nested in a speculative branch is still inside that branch's rollback scope, so a
/// cut there is honored (both emitters inline the group into the branch body, and the
/// executor shares one CapEnv across the whole rule). Returns "" when clean.
/// Every `@gate` must have a branch-local `@when`/`@peek` BEFORE it — that predicate
/// is what replaces the FIRST it removes. See the call site for why an unguarded gate
/// is a broken guard rather than a no-op.
fn validate_gates(g: Grammar) -> string {
    for rule in g.rules {
        let e = check_gate_node(g, rule.body, rule.name)
        if e != "" { return e }
    }
    ""
}

fn check_gate_node(g: Grammar, node: GNode, rule: string) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                mut seen_pred = false
                for it in b.items {
                    if prim_is_pred(it.prim) { seen_pred = true }
                    if it.gate && !seen_pred {
                        return "`@gate` needs a `@when`/`@peek` before it in the same branch (rule `${rule}`) — the gate REPLACES the item's FIRST with that predicate, so without one the branch guard is empty"
                    }
                    match it.prim {
                        .Group(inner) -> {
                            let e = check_gate_node(g, inner, rule)
                            if e != "" { return e }
                        }
                        _ -> {}
                    }
                }
            }
            ""
        }
    }
}

/// t-myz7: `@onfail(drop)` drops a failed child from the STATEMENT-LIST recovery loop —
/// the only loop that has a failed child to drop, because it is the only one that mints
/// an `(error)` row for one. On any other repetition there is no such row and the policy
/// would parse clean and do NOTHING, which is the silent-no-op class every other marker
/// validator exists to reject.
///
/// Checked only for a rule DEFINED in this grammar whose kind is actually DERIVABLE here.
/// Fragments are parsed before the merge (features/*/grammar.av), so a cross-fragment
/// reference resolves to `rule_kind_v`'s default rather than its real kind, and rejecting
/// on that would fail a correct grammar. `rule_kind_known` extends the same principle to
/// the other defaulted answer: a FEATURE-owned build's kind lives in the manifest, which a
/// fragment does not carry until stamped, so a flipped family's rules would otherwise read
/// as the lenient "expr" and be rejected (t-kd4y.3.2.5 — features/spec_test hit exactly
/// this). Where the kind IS derivable the check is live, as before.
/// The kind-DEPENDENT grammar validations, re-runnable once a manifest is in
/// hand. `parse_grammar` runs these too, but a FEATURE fragment is parsed
/// BEFORE its builder rows are stamped, so `rule_result_kind_known` defers there
/// rather than rejecting on the lenient "expr" default (see
/// `validate_onfail_drop`). Deferring is only sound if the check actually RUNS
/// once the answer exists — so `grammar_with_builder_kinds` calls this on every
/// stamped grammar, which is the point where a genuinely `"expr"`-kinded
/// `@onfail(drop)` reference becomes decidable and must be rejected. Returns ""
/// when clean, so specs can exercise every rejection without a child process.
export fn validate_grammar_kinds(g: Grammar) -> string {
    validate_onfail_drop(g)
}

fn validate_onfail_drop(g: Grammar) -> string {
    for rule in g.rules {
        let e = check_drop_node(g, rule.body, rule.name)
        if e != "" { return e }
    }
    ""
}

fn check_drop_node(g: Grammar, node: GNode, rule: string) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                for it in b.items {
                    if it.onfail == "drop" {
                        let nm = gprim_ref_name(it.prim)
                        if nm != "" && emit_lookup_rule(g, nm).name != "" && rule_result_kind_known(g, nm) && rule_result_kind(g, nm) != BuildKind.Stmt {
                            return "`@onfail(drop)` needs a STATEMENT repetition (rule `${rule}`) — `${nm}` builds a `${rule_result_kind(g, nm)}`, and only the statement-list loop mints the `(error)` row there would be to drop"
                        }
                    }
                    match it.prim {
                        .Group(inner) -> {
                            let e = check_drop_node(g, inner, rule)
                            if e != "" { return e }
                        }
                        _ -> {}
                    }
                }
            }
            ""
        }
    }
}

fn validate_cuts(g: Grammar) -> string {
    for rule in g.rules {
        let e = check_cut_node(g, rule.body, rule.name, false)
        if e != "" { return e }
    }
    ""
}

/// True when the sequence declares `@expect(key, …)`. The message-existence half of
/// the `@require`-on-a-rule-reference rule: a ref with no single-literal FIRST has no
/// token to name, so it may only be required when the author supplied the wording.
fn seq_expects_key(seq: GSeq, key: string) -> bool {
    for a in seq.annots {
        match a {
            .Expect(tok, _, _) -> { if tok == key { return true } }
            _ -> {}
        }
    }
    false
}

// `g` is threaded so a `@require` on a rule REFERENCE can look up that rule's
// single-literal FIRST — the message key the marker needs (t-47hc.24).
fn check_cut_node(g: Grammar, node: GNode, rule: string, in_try: bool) -> string {
    let no_annots: List<GAnnot> = []
    check_cut_node_ctx(g, node, rule, in_try, false, no_annots)
}

/// True when the sequence — or any ENCLOSING one — declares `@expect(key, …)`. A group's
/// items are checked against the annotations that will actually reach them: both emitters
/// thread the rule sequence's `annots` down through every group (emit_node_items /
/// exec_seq's outer_annots), so a message declared on the rule is in scope for a marker
/// nested inside one. Checking only the immediate branch would reject
/// `( "<" @onfail(skip) tparams:tparam )?` for want of a message the emitters do find.
/// The annotations in scope INSIDE a group: the ones already inherited plus the branch's
/// own, in that order — the same accumulation the emitters make when they thread `annots`
/// down. Separate from `seq_expects_key_in` so the walk builds the scope once per descent
/// rather than re-deriving it at every lookup.
fn concat_annots(outer: List<GAnnot>, inner: List<GAnnot>) -> List<GAnnot> {
    mut out: List<GAnnot> = []
    for a in outer { out.push(a) }
    for a in inner { out.push(a) }
    out
}

fn seq_expects_key_in(seq: GSeq, inherited: List<GAnnot>, key: string) -> bool {
    if seq_expects_key(seq, key) { return true }
    for a in inherited {
        match a {
            .Expect(tok, _, _) -> { if tok == key { return true } }
            _ -> {}
        }
    }
    false
}

fn check_cut_node_ctx(g: Grammar, node: GNode, rule: string, in_try: bool, in_fold: bool, inherited: List<GAnnot>) -> string {
    match node {
        .Alt(branches) -> {
            for b in branches {
                let this_try = in_try || b.speculative
                // A fold branch takes emit_fold, which bypasses emit_item — carried
                // DOWN through groups, exactly like check_mode_node does, because a
                // group inside a fold branch takes the fold path too.
                let this_fold = in_fold || branch_is_expr_fold(b)
                // Item index, skipping the zero-width predicates the emitters skip —
                // so index 0 is the sequence's GUARD token.
                // A branch entered on a zero-width PREDICATE is not entered on its first
                // ITEM's FIRST — `@peek`/`@when` decide it, and the item behind them is
                // never pre-proved. So the leading-item rule below, whose whole premise is
                // "that position is the FIRST-set guard", does not apply to such a branch
                // (t-myz7). `( @peek(not_gt) @onfail(skip) tparams:tparam … )?` is the shape:
                // the peek says only that the token is not the closing `>`, which leaves
                // "…and it had better be a type parameter name" for the marker to say.
                mut pred_led = false
                for pit in b.items {
                    if prim_is_pred(pit.prim) { pred_led = true }
                    break
                }
                mut idx = 0
                for item in b.items {
                    if item.cut {
                        if !this_try {
                            return "`@cut` is only meaningful inside a `@try` branch (rule `${rule}`) — a predictive branch never rolls back, so there is nothing to commit"
                        }
                        // A fold branch takes emit_fold, which bypasses emit_item —
                        // the cut would vanish from the generated parser while the
                        // executor still honored it (a silent divergence).
                        if this_fold {
                            return "`@cut` cannot appear on an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the commit"
                        }
                        // Both emitters SKIP zero-width predicates in their item
                        // loops, so a cut riding one would never be emitted.
                        if prim_is_pred_e_sp(item.prim) {
                            return "`@cut` cannot wrap a `@when`/`@peek` predicate (rule `${rule}`) — put it on the next token-bearing item"
                        }
                    }
                    // `@require` is a TERMINAL-mismatch abort: both engines detect
                    // "the token isn't there" on a Lit/Named, not on a rule ref (whose
                    // failure is its own internal report) or a zero-width predicate.
                    if item.require {
                        // t-47hc.24: a RULE REFERENCE is also legal, provided its FIRST is a
                        // single literal — that literal is the message key `@expect` and
                        // handle_missing are both indexed by, so without one there is no
                        // single "expected X" to report. This is what lets `@require
                        // block_expr` report-and-abort on a missing `{`
                        // without inlining (and mis-spanning) the block.
                        if !prim_is_terminal_sp(item.prim) {
                            match item.prim {
                                .Ref(rname) -> {
                                    // t-myz7: a ref whose FIRST is NOT a single literal is
                                    // legal too, PROVIDED the sequence declares its message
                                    // as `@expect("<rule-name>", …)` — keyed on the rule name
                                    // rather than a token. The restriction's own stated reason
                                    // is "there is no one token to name in the diagnostic"; a
                                    // declared message is exactly that reason removed, so the
                                    // rule stays "never report a token you did not derive".
                                    //
                                    // This is what lets a TYPE position abort. `field` is
                                    // `fname:IDENT @require ":" ftype:type_expr`, and with the
                                    // type ref unrequired a missing type reported the type
                                    // view's own generic F0040 and yielded Unknown — so
                                    // `enum E { A(x: ) }` BUILT `(enum E (A(x:<unknown>)))`
                                    // instead of aborting the whole declaration.
                                    if rule_first_literal(g, rname) == "" && !seq_expects_key_in(b, inherited, rname) {
                                        return "`@require` on rule reference `${rname}` (in rule `${rule}`) needs a single-literal FIRST or a declared `@expect(\"${rname}\", …)` — its FIRST is a disjunction or a token KIND, so there is no one token to name in the diagnostic and no message was supplied"
                                    }
                                }
                                _ -> {
                                    return "`@require` only applies to a terminal or a rule reference (rule `${rule}`)"
                                }
                            }
                        }
                        if !rep_is_one_sp(item.rep) {
                            return "`@require` cannot carry a repetition (rule `${rule}`) — an absent optional/repeated item is not a mismatch"
                        }
                        // Same fold hazard as `@cut`: emit_fold consumes its terminals
                        // through emit_accumulate, never emit_item, so the abort would
                        // vanish from the generated parser while the executor honoured it.
                        if this_fold {
                            return "`@require` cannot appear on an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the abort"
                        }
                        // Index 0 is the sequence's GUARD position. In a rule branch and
                        // in a terminal-alternation group the enclosing FIRST check has
                        // already proved that token, so both engines consume it
                        // unconditionally and it can never mismatch; in an unguarded
                        // structural group it IS validated. Rather than make the marker's
                        // meaning depend on which of those the emitters picked, reject it
                        // outright — mark the item that must FOLLOW the guard. EXCEPT on
                        // a `@fallback` branch: the fallback runs precisely when NO
                        // earlier branch's FIRST matched, so its leading item is NOT
                        // pre-proved — both engines validate it, and `@require` there is
                        // how the rule owns its whole-alternation mismatch message
                        // (index_tail's "expected `]` after index" on `a[1 2]`). This
                        // exemption was implicit while the accessors swallowed grammar
                        // errors; grammar_checked made the validator's over-reach loud.
                        if idx == 0 && !b.fallback && !pred_led {
                            return "`@require` cannot sit on a sequence's leading item (rule `${rule}`) — that position is the FIRST-set guard; mark the item that must follow it"
                        }
                    }
                    // t-myz7: `@onfail(skip)` reports through the SAME message key
                    // `@require` does, so it inherits the same rule about having one. Its
                    // other two positional constraints are `@require`'s too, and for the
                    // same reasons: a leading item's FIRST is already proved by the
                    // enclosing guard (so the check is dead), and an expr-fold branch
                    // never reaches emit_item (so the skip would exist in one engine
                    // only). The prim/rep half is checked in parse_labeled.
                    if item.onfail == "skip" {
                        let sname = gprim_ref_name(item.prim)
                        if rule_first_literal(g, sname) == "" && !seq_expects_key_in(b, inherited, sname) {
                            return "`@onfail(skip)` on rule reference `${sname}` (in rule `${rule}`) needs a single-literal FIRST or a declared `@expect(\"${sname}\", …)` — its FIRST is a token KIND or a disjunction, so there is no one token to name in the diagnostic and no message was supplied"
                        }
                        if this_fold {
                            return "`@onfail(skip)` cannot appear on an expr-fold branch (rule `${rule}`) — the fold emit path bypasses emit_item and would drop the skip"
                        }
                        if idx == 0 && !b.fallback && !pred_led {
                            return "`@onfail(skip)` cannot sit on a sequence's leading item (rule `${rule}`) — that position is the FIRST-set guard, which has already proved the reference starts here"
                        }
                    }
                    // t-myz7: `@onfail(close)` ENDS a repetition, so it needs one. The
                    // gate is on an item INSIDE the group and the repetition is on the
                    // group, so this is the level that can see both — and without the
                    // check the emitted `break` would land in an `if` (`( … )?`), which
                    // is a generated-source error rather than a diagnostic.
                    match item.prim {
                        .Group(inner) -> {
                            if node_has_onfail(inner, "close") && !grep_is_multi(item.rep) {
                                return "`@onfail(close)` needs a REPEATED group (rule `${rule}`) — it ends the repetition its gated element failed in, and a `( … )?` has none to end"
                            }
                        }
                        _ -> {}
                    }
                    match item.prim {
                        .Group(inner) -> {
                            let e = check_cut_node_ctx(g, inner, rule, this_try, this_fold, concat_annots(inherited, b.annots))
                            if e != "" { return e }
                        }
                        _ -> {}
                    }
                    if !prim_is_pred_e_sp(item.prim) { idx = idx + 1 }
                }
            }
        }
    }
    ""
}

fn prim_is_terminal_sp(prim: GPrim) -> bool {
    match prim {
        .Lit(_) -> true
        .Named(_) -> true
        _ -> false
    }
}

fn rep_is_one_sp(r: GRep) -> bool {
    match r { .One -> true  _ -> false }
}

/// The zero-width predicates the emitters skip (`@when`/`@peek`). Narrower than
/// prim_is_zero_width: `@gensym`/`@rawbrace` go through emit_item.
fn prim_is_pred_e_sp(prim: GPrim) -> bool {
    match prim {
        .Pred(_) -> true
        .Peek(_) -> true
        _ -> false
    }
}

/// True iff a branch's build is one of the legacy expr-fold helpers that take the
/// SPECIALISED emit_fold path (which bypasses emit_item, so a @off on such a branch
/// would be dropped from the generated parser). Mirrors emit.av `build_is_expr_fold`.
fn branch_is_expr_fold(b: GSeq) -> bool {
    match b.build {
        .Call(name, _) -> name == "fold_binary" || name == "fold_logical" || name == "fold_nullish" || name == "fold_postfix"
        _ -> false
    }
}

/// True for the primaries a mode marker must not wrap: the zero-width ones that
/// consume nothing — `@when`, `@peek`, `@gensym`, and `@rawbrace`.
fn prim_rejects_mode_wrap(prim: GPrim) -> bool {
    match prim {
        .Pred(_) -> true
        .Peek(_) -> true
        // Zero-width too: there is no sub-parse for a mode to be set around.
        .Gensym(_) -> true
        // A raw capture reads bytes, not modes — a mode set around it is dead by
        // construction, so reject it loudly rather than let it imply an effect.
        .RawBrace(_) -> true
        _ -> false
    }
}

// labeled = ( NAME ":" )? postfix
fn parse_labeled(p: GP) -> GItem {
    // t-47hc.21 COMMIT POINT: a leading `@cut` commits the enclosing `@try` branch
    // as of this item. Bare marker (no parens) — it takes no argument, so it is
    // consumed here and recorded on the item that FOLLOWS it (the cut point sits
    // BETWEEN items; attaching it to the next one is the same position and keeps
    // the emitters' `continue`-heavy item loops free of index arithmetic). A
    // trailing `@cut` has no following item to attach to and is rejected below.
    mut cut = false
    mut gate = false
    mut require = false
    mut onfail = ""
    mut onfail_cap = ""
    mut sameline = false
    mut mode_off = ""
    mut mode_on = ""
    mut mode_on_if = ""
    mut mode_bump = ""
    // MARKER ORDER IS IRRELEVANT (t-47hc.5). Each `@`-marker below annotates the item
    // that follows it, and two of them on one item mean the same thing in either order —
    // but a straight-line `if` chain accepts only the chain's own order, so
    // `@bump(quote_depth) @require t:type_expr` failed to parse while
    // `@require @bump(quote_depth) t:type_expr` succeeded. The rejection surfaced as
    // `parse_primary`'s generic "expected a rule reference, terminal, …(at `@`)", which
    // names neither marker and does not hint that ORDER was the problem.
    //
    // Looping until a pass consumes nothing makes every permutation parse. The
    // mutual-exclusion checks below still run once, afterwards, on the collected set —
    // they are about which markers may COMBINE, which is a different question from the
    // order they are written in, and only the first has a reason to be a hard error.
    while true {
        let __m_before = p.pos
        if at_cut_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "cut"
            cut = true
            if !seq_can_continue(p) {
                p.fail("`@cut` must be followed by an item — it marks the point a `@try` branch commits")
            }
        }
        // t-47hc.21 ABORT: `@require` makes a mismatch on this terminal stop the rule
        // rather than report-and-continue. Bare marker (no parens) — the message is the
        // sequence's `@expect`, so diagnostics keep ONE seam.
        // t-myz7 GATE: `@gate(cond)` is `@peek(cond)` whose cond REPLACES the FIRST
        // guard rather than narrowing it. Recorded on the item it precedes, exactly as
        // `@cut` is — the gate sits BETWEEN the guard and the item it admits.
        if at_gate_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "gate"
            gate = true
            if !seq_can_continue(p) {
                p.fail("`@gate(cond)` must be followed by an item — it replaces that item's FIRST guard")
            }
        }
        if at_require_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "require"
            require = true
            if !seq_can_continue(p) {
                p.fail("`@require` must be followed by an item — it marks a terminal whose absence aborts the rule")
            }
        }
        // t-myz7 NON-ABORTING FAILURE POLICY: `@onfail(policy)` says what this position does
        // when its sub-parse fails, for the positions that must RECOVER where `@require`
        // and `@gate` abort. STRICT grammar `@` `onfail` `(` NAME `)`, the policy validated
        // against onfail_policy_supported — an unknown policy is a hard error rather than a
        // silent fall-through to the aborting default, which would look exactly like the bug
        // the marker was added to fix.
        if at_onfail_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "onfail"
            p.expect_punct("(", "expected `(` after `@onfail`")
            if p.peek().kind == GTokKind.NAME {
                let pol = p.advance().text
                if onfail_policy_supported(pol) {
                    onfail = pol
                } else {
                    p.fail("unknown `@onfail` policy `${pol}` (expected skip / close / halt / drop / bail / discard / abort)")
                }
            } else {
                p.fail("expected a policy name in `@onfail(policy)`")
            }
            // `@onfail(discard, <label>)` — the one policy that names what it throws away.
            // Required for `discard` and refused for the rest, both ways round, so the marker
            // can never read as "discard something unspecified" or carry a capture no code
            // path will look at.
            if p.is_punct(",") {
                let _ = p.advance()
                if !onfail_policy_takes_capture(onfail) {
                    p.fail("`@onfail(${onfail})` takes no capture — only `discard` names the list it throws away")
                }
                if p.peek().kind == GTokKind.NAME {
                    onfail_cap = p.advance().text
                } else {
                    p.fail("expected a capture name in `@onfail(discard, <label>)`")
                }
            } else if onfail_policy_takes_capture(onfail) {
                p.fail("`@onfail(discard)` must name the capture it throws away (`@onfail(discard, tparams)`) — a bracket's closer is not enough to say which list it was collecting")
            }
            p.expect_punct(")", "expected `)` to close `@onfail(policy)`")
            if !seq_can_continue(p) {
                p.fail("`@onfail(policy)` must be followed by an item — it marks the position whose failure it governs")
            }
        }
        if onfail != "" && require {
            p.fail("`@require` and `@onfail` are opposite answers to the same question — an item aborts on failure or it recovers, not both")
        }
        // ps3t.6.7 newline-sensitivity: a leading `^` marks the item same-line — it
        // matches only on the same source line as the previous token (the
        // postfix-chain cutoff). `^` lexes as a single-char PUNCT here.
        if p.peek().kind == GTokKind.PUNCT && p.peek().text == "^" {
            let _ = p.advance()
            sameline = true
        }
        // t-47hc mode-SET marker `@off(flag)`: turn a settable ExprModes flag OFF for
        // this item's sub-parse (the `while foo {` struct-literal disambiguation
        // via `allow_struct_lit = false`). Distinguished from the
        // `@when`/`@try` primaries by the second token being `off` (parsed
        // later as the primary / branch marker). STRICT grammar: `@` `off` `(` NAME `)`
        // — the parens are required and the flag NAME is validated against
        // off_flag_supported. The raw NAME is interpolated into emitted source
        // (modes_with_flag_off(st.modes, "<NAME>")), so a typo or the READ-only
        // `at_quote_top` predicate must be a hard error here, not a silent no-op that
        // generates a dead mode-set. Malformed forms (missing `(`/`)`, non-NAME flag)
        // fail via p.fail rather than being accepted verbatim.
        if at_off_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "off"
            p.expect_punct("(", "expected `(` after `@off`")
            if p.peek().kind == GTokKind.NAME {
                let fl = p.advance().text
                if off_flag_supported(fl) {
                    mode_off = fl
                } else {
                    p.fail("unknown `@off` flag `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode)")
                }
            } else {
                p.fail("expected a flag name in `@off(flag)`")
            }
            p.expect_punct(")", "expected `)` to close `@off(flag)`")
        }
        // t-47hc mode-SET marker `@on(flag)`: the SET-ON twin of `@off` — turn a settable
        // ExprModes flag ON for this item's sub-parse (parse_paren_expr re-enables
        // allow_dot_postfix inside `(...)`). Same STRICT grammar `@` `on` `(` NAME `)`,
        // validated against on_flag_supported. mode_off and mode_on can't both be set.
        if at_on_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "on"
            p.expect_punct("(", "expected `(` after `@on`")
            if p.peek().kind == GTokKind.NAME {
                let fl = p.advance().text
                if on_flag_supported(fl) {
                    mode_on = fl
                } else {
                    p.fail("unknown `@on` flag `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode)")
                }
            } else {
                p.fail("expected a flag name in `@on(flag)`")
            }
            p.expect_punct(")", "expected `)` to close `@on(flag)`")
        }
        // t-47hc.34 CONDITIONAL mode-SET `@on_if(pred, flag)`: set `flag` for this item's
        // sub-parse ONLY when `pred` holds, then restore. STRICT `@` `on_if` `(` NAME `,`
        // NAME `)`. Both names are validated, each against the list that already owns it —
        // the predicate against when_pred_supported (the same list `@when` uses) and the flag
        // against on_flag_supported (the same list `@on` uses) — so a typo in either half is
        // a hard grammar-parse error rather than a guard that silently never fires.
        if at_on_if_marker(p) {
            // Both markers write `mode_on`, so accepting the pair would silently keep only
            // the second — a mode that looks gated and is not, or the reverse.
            if mode_on != "" { p.fail("`@on` and `@on_if` cannot both mark the same item — they set the same flag") }
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "on_if"
            p.expect_punct("(", "expected `(` after `@on_if`")
            if p.peek().kind == GTokKind.NAME {
                let pr = p.advance().text
                if when_pred_supported(pr) { mode_on_if = pr }
                else { p.fail("unknown `@on_if` predicate `${pr}` — it must be a `@when` predicate name") }
            } else {
                p.fail("expected a predicate name in `@on_if(pred, flag)`")
            }
            p.expect_punct(",", "expected `,` between the predicate and the flag in `@on_if(pred, flag)`")
            if p.peek().kind == GTokKind.NAME {
                let fl = p.advance().text
                if on_flag_supported(fl) { mode_on = fl }
                else { p.fail("unknown `@on_if` flag `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode)") }
            } else {
                p.fail("expected a flag name in `@on_if(pred, flag)`")
            }
            p.expect_punct(")", "expected `)` to close `@on_if(pred, flag)`")
        }
        // t-47hc.32 counter-SET marker `@bump(counter)`: increment an ExprModes int cell for
        // this item's sub-parse, then restore — the quote body's save/bump/restore
        // (quote_depth). Same STRICT grammar `@` `bump` `(` NAME `)`, validated against
        // bump_counter_supported (its OWN list: a counter is not a settable bool).
        if at_bump_marker(p) {
            let _ = p.advance()   // "@"
            let _ = p.advance()   // "bump"
            p.expect_punct("(", "expected `(` after `@bump`")
            if p.peek().kind == GTokKind.NAME {
                let cn = p.advance().text
                if bump_counter_supported(cn) {
                    mode_bump = cn
                } else {
                    p.fail("unknown `@bump` counter `${cn}` (expected quote_depth)")
                }
            } else {
                p.fail("expected a counter name in `@bump(counter)`")
            }
            p.expect_punct(")", "expected `)` to close `@bump(counter)`")
        }
        if p.pos == __m_before { break }
    }
    // Enforce the mutual-exclusion invariant the comments assert: emit_item /
    // exec_item honour mode_off FIRST and would silently drop a co-present
    // mode_on or mode_bump, so reject two set-markers on one item as a hard parse
    // error rather than generate a dead mode-set.
    if mode_off != "" && mode_on != "" {
        p.fail("`@off` and `@on` cannot both apply to one item")
    }
    if mode_bump != "" && (mode_off != "" || mode_on != "") {
        p.fail("`@bump` cannot share an item with `@off` or `@on`")
    }
    mut label = ""
    // A capture label is `NAME ":"` — needs one-token lookahead so a
    // bare NAME primary isn't mistaken for a label.
    if p.peek().kind == GTokKind.NAME && p.pos + 1 < p.toks.length {
        let nxt = p.toks[p.pos + 1]
        if nxt.kind == GTokKind.PUNCT && nxt.text == ":" {
            label = p.advance().text   // NAME
            let _ = p.advance()        // ":"
        }
    }
    let base = parse_postfix(p)
    // An UNLABELLED `@gensym` mints a name nothing can read — always a mistake, and the
    // silent kind: a build would see an absent capture and substitute an empty name, so
    // the desugar would emit a binding literally called "". Checked here rather than in
    // parse_primary because only this level knows the label.
    match base.prim {
        .Gensym(_) -> if label == "" { p.fail("`@gensym(tag)` must be LABELLED — the minted name is its only product (`t:@gensym(iflet)`)") }
        // Same reasoning: the captured slice is the item's only product. An unlabelled
        // `@rawbrace` would consume the whole block and bind nothing — the silent kind
        // of mistake, since the following `"}"` still matches and the rule "works".
        .RawBrace(_) -> if label == "" { p.fail("`@rawbrace(tag)` must be LABELLED — the captured slice is its only product (`body:@rawbrace(grammar)`)") }
        _ -> {}
    }
    // t-myz7: each `@onfail` policy is legal only on the SHAPE it describes. A policy on
    // the wrong shape has no code path to run in, so without this it would parse clean
    // and do nothing — the silent-no-op failure mode `@off`/`@when`/`@peek` each already
    // reject by name. The stmt-kind half of `drop` needs the whole grammar and is checked
    // in validate_onfail_kinds; what is checkable from one item is checked here.
    if onfail == "skip" {
        match base.prim {
            .Ref(_) -> {}
            _ -> p.fail("`@onfail(skip)` is only meaningful on a rule REFERENCE — it steps over a sub-rule whose FIRST is absent (`@onfail(skip) tparams:tparam`)")
        }
        if !rep_is_one(base.rep) {
            p.fail("`@onfail(skip)` is only meaningful on a single reference — a repetition already stops when its element's FIRST fails")
        }
    }
    if onfail == "close" && !gate {
        p.fail("`@onfail(close)` governs a GATED element's abort — put it with the `@gate` whose failure should end the repetition")
    }
    if onfail == "halt" && !gate {
        p.fail("`@onfail(halt)` governs a GATED element's failure — put it with the `@gate` whose miss should abandon the rest of the group")
    }
    if onfail == "drop" {
        match base.prim {
            .Ref(_) -> {}
            _ -> p.fail("`@onfail(drop)` drops a failed CHILD from a captured list — it needs a rule reference (`@onfail(drop) body:spec_item*`)")
        }
        if label == "" || !grep_is_multi(base.rep) {
            p.fail("`@onfail(drop)` is only meaningful on a LABELLED repetition — the list it drops from is the capture (`@onfail(drop) body:spec_item*`)")
        }
    }
    if onfail == "bail" {
        match base.prim {
            .Ref(_) -> {}
            _ -> p.fail("`@onfail(bail)` aborts on a SUB-RULE's own failure — it needs a rule reference (`@onfail(bail) ch:expression`)")
        }
        if !rep_is_one(base.rep) {
            p.fail("`@onfail(bail)` cannot carry a repetition — an absent optional/repeated item is not a failure")
        }
    }
    // t-myz7/t-47hc.5 `@onfail(abort)` — `drop`'s ABORTING sibling, for a body loop that
    // PROPAGATES a child failure instead of recovering from it. The default
    // loop stands an `(error)` row and carries on (`parse_statement_list_ids`); `drop`
    // omits the row and carries on (`parse_spec_body`); this one ends the enclosing rule
    // (`parse_comp_block_body`, whose `parse_declaration()?` returns `.Err`), so the
    // caller's closer is never consumed and the stray `}` reaches statement-level
    // recovery.
    if onfail == "abort" {
        match base.prim {
            .Ref(_) -> {}
            _ -> p.fail("`@onfail(abort)` ends the rule on a failed CHILD — it needs a rule reference (`@onfail(abort) body:comp_block_item*`)")
        }
        if label == "" || !grep_is_multi(base.rep) {
            p.fail("`@onfail(abort)` is only meaningful on a LABELLED repetition — it governs a body LOOP (`@onfail(abort) body:comp_block_item*`)")
        }
    }
    if onfail == "discard" {
        if !prim_is_terminal_sp(base.prim) {
            p.fail("`@onfail(discard, <label>)` marks a bracket's CLOSING TERMINAL — the token whose absence costs the list (`@onfail(discard, tparams) \">\"`)")
        }
        if !rep_is_one(base.rep) {
            p.fail("`@onfail(discard, <label>)` cannot carry a repetition — a bracket has one closer")
        }
    }
    GItem { label, rep: base.rep, prim: base.prim, sameline, mode_off, mode_on, mode_bump, mode_on_if, cut, require, gate, onfail, onfail_cap, bound: base.bound }
}

// postfix = primary ( "*" | "+" | "?" )? ( "{" "#" NAME "}" )?
type Postfix = { rep: GRep, prim: GPrim, bound: string }

fn parse_postfix(p: GP) -> Postfix {
    let prim = parse_primary(p)
    mut rep = GRep.One
    if p.is_punct("*") {
        let _ = p.advance()
        rep = GRep.Star
    } else if p.is_punct("+") {
        let _ = p.advance()
        rep = GRep.Plus
    } else if p.is_punct("?") {
        let _ = p.advance()
        rep = GRep.Opt
    }
    // t-47hc.28 BOUNDED REPETITION `x{#cap}` — cap this repetition at the LENGTH of
    // an already-collected capture list. STRICT grammar `{` `#` NAME `}`: the `#`
    // sigil keeps the bound unmistakably a COUNT-OF rather than a rule reference, and
    // the braces cannot collide with anything else in postfix position (a `{` never
    // followed a postfix primary before this). Both delimiters are required, so a
    // malformed bound is a hard error, never a silently-dropped cap.
    mut bound = ""
    if p.is_punct("{") {
        let _ = p.advance()
        p.expect_punct("#", "expected `#` in a repetition bound — the form is `x{#capture}`")
        if p.peek().kind == GTokKind.NAME {
            bound = p.advance().text
        } else {
            p.fail("expected a capture name in `{#capture}`")
        }
        p.expect_punct("}", "expected `}` to close `{#capture}`")
        // A bound is only meaningful on a repetition that can run more than once.
        // On `?` or a bare item the cap is either vacuous or a contradiction, and
        // neither engine has anywhere to put it — reject rather than generate a
        // dead guard. (That the capture EXISTS and is bound earlier in the same
        // branch is checked once the whole grammar is parsed — validate_bounds.)
        match rep {
            .Star -> {}
            .Plus -> {}
            _ -> p.fail("`{#${bound}}` is only meaningful on a `*` or `+` repetition")
        }
    }
    // A `@when(flag)` predicate is a zero-width, One-repetition gate; a `*`/`+`/`?`
    // suffix is meaningless and both consumers mishandle it (the interpreter never
    // fires it; emit would `st.advance()` on a mode read). Reject it at parse time.
    match prim {
        .Pred(_) -> match rep { .One -> {}  _ -> p.fail("`@when(flag)` cannot take a `*`/`+`/`?` repetition suffix") }
        .Peek(_) -> match rep { .One -> {}  _ -> p.fail("`@peek(cond)` cannot take a `*`/`+`/`?` repetition suffix") }
        // Same reasoning: minting N names for one item has no meaning, and the two
        // engines would disagree about N (the interpreter's repeat loop makes no
        // progress on a zero-width item, emit's would mint once).
        .Gensym(_) -> match rep { .One -> {}  _ -> p.fail("`@gensym(tag)` cannot take a `*`/`+`/`?` repetition suffix") }
        // A repetition on a raw capture has no meaning either: the scan already
        // consumes to the balancing `}` in ONE match, so a second iteration would
        // start on the close brace and the two engines would disagree about what
        // an empty match means.
        .RawBrace(_) -> match rep { .One -> {}  _ -> p.fail("`@rawbrace(tag)` cannot take a `*`/`+`/`?` repetition suffix") }
        _ -> {}
    }
    Postfix { rep, prim, bound }
}

// primary = NAME | STRING | "(" alt ")"
fn parse_primary(p: GP) -> GPrim {
    let t = p.peek()
    if t.kind == GTokKind.ERROR {
        p.fail("unterminated string literal")
        let _ = p.advance()
        return GPrim.Lit("")
    }
    if t.kind == GTokKind.STRING {
        let _ = p.advance()
        return GPrim.Lit(t.text)
    }
    if t.kind == GTokKind.NAME {
        let _ = p.advance()
        if is_terminal_name(t.text) { return GPrim.Named(t.text) }
        return GPrim.Ref(t.text)
    }
    if p.is_punct("(") {
        let _ = p.advance()
        let inner = parse_alt(p)
        p.expect_punct(")", "expected `)` to close a group")
        return GPrim.Group(inner)
    }
    // Zero-width GENERATOR: `@gensym(tag)` mints a fresh name at THIS position.
    //
    // The tag is a bare NAME, not a string literal, for the same reason every other
    // marker argument is: it is interpolated into emitted source, so keeping it to the
    // grammar's identifier shape means there is no escaping question. An unlabelled
    // `@gensym` is a grammar-parse ERROR rather than a no-op — the whole point of the
    // primary is the binding, so minting a name nothing can read is always a mistake,
    // and it is exactly the silent kind (a build would see an absent capture and
    // substitute an empty name).
    if at_gensym_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "gensym"
        p.expect_punct("(", "expected `(` after `@gensym`")
        mut tag = ""
        if p.peek().kind == GTokKind.NAME { tag = p.advance().text }
        if tag == "" { p.fail("`@gensym` needs a tag name — `@gensym(iflet)`") }
        p.expect_punct(")", "expected `)` to close `@gensym`")
        return GPrim.Gensym(tag)
    }
    // Raw balanced-brace CAPTURE: `@rawbrace(tag)` consumes to the balancing `}` and
    // binds the verbatim source slice (t-47hc.31). The tag is a bare NAME for the same
    // no-escaping reason as `@gensym`'s: it is interpolated into the unterminated-EOF
    // diagnostic and into emitted source.
    if at_rawbrace_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "rawbrace"
        p.expect_punct("(", "expected `(` after `@rawbrace`")
        mut tag = ""
        if p.peek().kind == GTokKind.NAME { tag = p.advance().text }
        if tag == "" { p.fail("`@rawbrace` needs a construct tag — `@rawbrace(grammar)` names the block in its unterminated-EOF diagnostic") }
        p.expect_punct(")", "expected `)` to close `@rawbrace`")
        return GPrim.RawBrace(tag)
    }
    // Zero-width mode predicate: `@when(flag)` gates its branch on a parse mode.
    if at_when_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "when"
        p.expect_punct("(", "expected `(` after `@when`")
        mut flag = ""
        if p.peek().kind == GTokKind.NAME {
            let fl = p.advance().text
            // Validated for the same reason `@off`/`@on`/`@peek` validate theirs: the
            // name is interpolated into emitted source, and modes_flag ungates (returns
            // true for) anything it does not recognise — so an unvalidated typo becomes
            // an always-true guard rather than an error.
            if when_pred_supported(fl) {
                flag = fl
            } else {
                p.fail("unknown `@when` predicate `${fl}` (expected allow_struct_lit / allow_dot_postfix / allow_it_sugar / cell_mode / at_quote_top / in_quote_body / base_callable / base_upper_ident / dot_postfix_ok)")
            }
        }
        else { p.fail("expected a flag name in `@when(flag)`") }
        p.expect_punct(")", "expected `)` to close `@when`")
        return GPrim.Pred(flag)
    }
    // Zero-width LOOKAHEAD predicate: `@peek(cond)` gates its branch on an upcoming-token
    // test (executor.lookahead_ok). STRICT `@ peek ( NAME )`; the cond NAME is validated
    // against peek_cond_supported (a typo is a HARD error, never a silent no-op that
    // generates a dead guard — the raw name is interpolated into emitted source).
    if at_peek_primary(p) {
        let _ = p.advance()   // "@"
        let _ = p.advance()   // "peek"
        p.expect_punct("(", "expected `(` after `@peek`")
        mut cond = ""
        if p.peek().kind == GTokKind.NAME {
            let c = p.advance().text
            if peek_cond_supported(c) { cond = c }
            else { p.fail("unknown `@peek` cond `${c}` (expected: " + peek_cond_expected_list() + ")") }
        }
        else { p.fail("expected a cond name in `@peek(cond)`") }
        p.expect_punct(")", "expected `)` to close `@peek`")
        return GPrim.Peek(cond)
    }
    p.fail("expected a rule reference, terminal, `(`, `@when(flag)`, or `@peek(cond)`")
    let _ = p.advance()
    GPrim.Lit("")
}

// build = NAME ( "(" ( NAME ( "," NAME )* )? ")" )?
fn parse_build(p: GP) -> GBuild {
    if p.peek().kind != GTokKind.NAME {
        p.fail("expected a build (constructor or helper name) after `->`")
        return GBuild.None
    }
    let name = p.advance().text
    if !p.is_punct("(") {
        return GBuild.Var(name)   // `-> e` : return the named capture
    }
    let _ = p.advance()  // "("
    // Args are comma-separated NAMEs. Commas are REQUIRED between args —
    // `Node(a b)` (missing comma) is rejected: after `a` with no comma
    // the loop stops and expect_punct fails on `b`.
    mut args: List<string> = []
    if !p.is_punct(")") {
        args.push(parse_build_arg(p))
        while p.is_punct(",") {
            let _ = p.advance()
            args.push(parse_build_arg(p))
        }
    }
    p.expect_punct(")", "expected `,` or `)` in a build's argument list")
    GBuild.Call(name, args)
}

fn parse_build_arg(p: GP) -> string {
    if p.peek().kind == GTokKind.NAME { return p.advance().text }
    p.fail("expected a capture name in a build's argument list")
    ""
}

// annot = "@expect" "(" STRING "," STRING ")"
//       | "@recover" "(" "sync_to" ":" STRING ")"
fn parse_annot(p: GP) -> GAnnot {
    let _ = p.advance()   // "@"
    mut kind = ""
    if p.peek().kind == GTokKind.NAME { kind = p.advance().text }
    // Only `@expect` / `@recover` are known — reject anything else
    // (e.g. `@foo(...)`) rather than silently treating it as @expect.
    if kind != "expect" && kind != "recover" {
        p.fail("unknown annotation `@${kind}` (expected `@expect` or `@recover`)")
    }
    p.expect_punct("(", "expected `(` after `@${kind}`")
    if kind == "recover" {
        // `sync_to` ":" STRING — the key MUST be `sync_to`.
        if p.peek().kind == GTokKind.NAME {
            let key = p.advance().text
            if key != "sync_to" {
                p.fail("expected `sync_to` in @recover(sync_to: …), got `${key}`")
            }
        } else {
            p.fail("expected `sync_to` in @recover(sync_to: …)")
        }
        p.expect_punct(":", "expected `:` in @recover(sync_to: …)")
        mut tok = ""
        if p.peek().kind == GTokKind.STRING { tok = p.advance().text } else { p.fail("expected a string token in @recover") }
        p.expect_punct(")", "expected `)` to close @recover")
        return GAnnot.Recover(tok)
    }
    // @expect(tok, msg) — both string operands required, comma between.
    mut tok = ""
    if p.peek().kind == GTokKind.STRING { tok = p.advance().text } else { p.fail("expected a token string in @expect") }
    p.expect_punct(",", "expected `,` between @expect's token and message")
    mut msg = ""
    if p.peek().kind == GTokKind.STRING { msg = p.advance().text } else { p.fail("expected a message string in @expect") }
    // @expect(tok, msg, F0010) — the OPTIONAL third operand is the F-CODE the missing
    // token reports under (t-47hc.5). A bare NAME, not a string, because it names a
    // DiagCode rather than carrying user-facing text, and because a typo must be a hard
    // error: validated against `syntax_diag_code`'s range here rather than reaching the
    // seam as an unmapped string that silently degrades to F0001 — which is exactly the
    // failure this operand exists to fix, and would be invisible without the check.
    mut code = ""
    if p.peek().text == "," {
        let _ = p.advance()
        if p.peek().kind == GTokKind.NAME {
            let c = p.advance().text
            if expect_code_supported(c) { code = c }
            else { p.fail("unknown `@expect` code `${c}` — must be a SYNTAX code the seam can map (F0001, F0002, F0003, F0006, F0010, F0011, F0012, F0013, F0014, F0030, F0031, F0040, F0041)") }
        }
        else { p.fail("expected an F-code name in `@expect(tok, msg, CODE)`") }
    }
    p.expect_punct(")", "expected `)` to close @expect")
    GAnnot.Expect(tok, msg, code)
}

/// The F-codes `@expect`'s third operand accepts — exactly the range
/// `diagnostics.syntax_diag_code` can map back to a `DiagCode`, duplicated for the same
/// reason `name_in` is (see its note): the seed parser runs under comptime macro
/// expansion, where a cross-module non-`@comptime` callee resolves to a type_marker
/// (F4005). A code outside this set would reach the seam, answer `null` there, and
/// degrade silently to F0001 — so it is rejected at grammar-parse time instead.
fn expect_code_supported(c: string) -> bool {
    c == "F0001" || c == "F0002" || c == "F0003" || c == "F0006" || c == "F0010" ||
    c == "F0011" || c == "F0012" || c == "F0013" || c == "F0014" || c == "F0030" ||
    c == "F0031" || c == "F0040" || c == "F0041"
}
