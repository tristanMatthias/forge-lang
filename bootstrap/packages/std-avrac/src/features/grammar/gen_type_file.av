// WHY: t-47hc.4.4 Phase 3d — the single source of truth for the CHECKED-IN production
// type-expression static-parser module (parse/gen_type_parser.av). Like gen_expr_file.av
// / gen_decl_file.av this module is NON-PRODUCTION: it is imported ONLY by the
// regenerator (diagnose.sh --emit-regen-type) and the regen guard
// (parse/tests/gen_type_parser_regen_test.av), so it — and transitively emit.av —
// never enters the production compiler graph (mod.av imports the GENERATED file via
// static_type_entry, which pulls only the grammar type-builders, not the emitter).
//
// `emit_type_parser_file()` returns the COMPLETE module text: a fixed import header
// (the type-builders the generated body calls) + `emit_parser_source_ex(_, true)`
// (the exported static parser fns). Editing avra_type_flip_grammar (avra_grammar.av)
// changes this text — run `bash scripts/diagnose.sh --emit-regen-type` to rewrite the
// checked-in file, then commit it; the guard test fails until you do.

use features.grammar.{avra_type_flip_grammar, emit_parser_source_ex}

/// The fixed import header of the production type static-parser module: exactly the
/// features.grammar type-builders + core types the generated body references. An extra
/// import is only an F9002 warning, but a MISSING one is a hard undefined-symbol error —
/// keep this in lockstep with the build helpers avra_type_flip_grammar's rules name
/// (fold_type_union / mk_named_type / mk_paren_type / mk_fn_type + TyDyn/TyList inline
/// builds via capval_* + mk_qualified_type) and the Tk/lookahead guards.
export fn gen_type_parser_header() -> string {
    // RELATIVE imports (features.grammar / core), NOT the absolute `@std.avrac.` form
    // the emit-gen-check STANDALONE harness uses: this file is a globbed in-package
    // compiler-src module, and an absolute self-import of the package being built makes
    // the metadata lib build's module graph process the whole package a SECOND time
    // (F4012). The rest of compiler src/ imports relatively for exactly this reason.
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-type` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: avra_type_flip_grammar() in features/grammar/avra_grammar.av.\n" +
    "// This is the PRODUCTION type parser under AVRA_PARSER_TYPE_STATIC=1 (t-47hc.4.4\n" +
    "// Phase 3d); parse/tests/gen_type_parser_regen_test.av asserts it equals\n" +
    "// emit_type_parser_file() so a grammar edit that isn't regenerated fails the suite.\n" +
    "use features.grammar.{Token, CapVal, PState, capval_to_texpr, capval_present, capval_tok_text, lookahead_ok, fold_type_union, mk_named_type, mk_splice_type, mk_qualified_type, mk_paren_type, mk_fn_type, mk_dyn_type}\n" +
    "use core.{TypeExpr, Tk}\n\n"
}

/// The complete text of parse/gen_type_parser.av: header + the exported generated
/// body. Both the regenerator and the guard read from HERE.
export fn emit_type_parser_file() -> string {
    gen_type_parser_header() + emit_parser_source_ex(avra_type_flip_grammar(), true)
}
