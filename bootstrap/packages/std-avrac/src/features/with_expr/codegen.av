// WHY: codegen for `expr with { field: value, ... }` — functional
// struct update. Creates a copy of the struct with specified fields
// overridden. The original is not mutated.
//
// Implementation: malloc new struct, copy all fields from original,
// then overwrite the specified fields with new values.

use core.{Expr, FieldEntry, FieldInit, VarEnv, field_index_of, vtype_struct_name, vtype_display}
use codegen.{Ctx, EmitValue, ok_emit, err_emit}
use features.union_type.{emit_union_wrap, needs_union_wrap}

/// Codegen entry for `obj with { field: val, ... }`. Pattern-
/// matches the `With` AST node and forwards to `emit_with_inner`.
export fn emit_with(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .With(obj, overrides) -> emit_with_inner(ctx, env, obj, overrides)
        _ -> err_emit("expected With")
    }
}

/// Inner emitter: evaluate the source object, allocate a new
/// struct buffer (or reuse the Copy-type stack target when set —
/// spec 9.12), copy every field, then overwrite the named ones
/// with their override expressions.
fn emit_with_inner(ctx: Ctx, env: VarEnv, obj: Expr, overrides: List<FieldInit>) -> Result<EmitValue, string> {
    let r = ctx.emit(env, obj)?

    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        return err_emit("`with` requires a struct value (got ty=${vtype_display(r.ty)})")
    }
    let lookup = ctx.lookup_struct(struct_name)
    if !lookup.found {
        return err_emit("unknown struct `${struct_name}` in with expression")
    }

    // Count fields and allocate new struct
    // Copy-type stack allocation (spec 9.12): if a pre-allocated stack
    // target exists (set by emit_var_decl), write directly into it.
    let new_buf = if ctx.copy_alloc_target != null {
        ctx.copy_alloc_target
    } else {
        ctx.arena_alloc(ctx.i64(lookup.fields.length * 8))
    }
    let src_ptr = ctx.to_ptr(r.value, "with_src")

    // Copy all fields from original
    copy_struct_fields(ctx, src_ptr, new_buf, struct_name, lookup.fields)

    // Override specified fields
    apply_overrides(ctx, env, new_buf, struct_name, lookup.fields, overrides)?

    ok_emit(ctx.to_i64(new_buf, "with_result"), r.ty)
}

/// Copy every field of a struct from `src` to `dst` via per-field
/// load/store. Respects each field's LLVM type via `store_field`
/// so packed bool/i1 fields don't overwrite adjacent slots
/// (ticket 14s7 was a 64-bit store clobbering a neighbouring i1).
fn copy_struct_fields(ctx: Ctx, src: ptr, dst: ptr, struct_name: string, fields: List<FieldEntry>) {
    let st_ty = ctx.get_type(struct_name)
    mut i = 0
    while i < fields.length {
        let resolved = fields[i].resolved
        let src_gep = ctx.gep(st_ty, src, i, "with_cp_src")
        let val = ctx.load_typed(resolved, src_gep, "with_cp_val")
        let dst_gep = ctx.gep(st_ty, dst, i, "with_cp_dst")
        // store_field respects the destination field's LLVM type
        // (i1 for bool, ptr for refs, etc.). Plain ctx.store would
        // write 8 bytes and clobber adjacent packed bool fields
        // (forge-crafting-intepreters-14s7).
        ctx.store_field(val, dst_gep, resolved)
        i = i + 1
    }
}

/// Apply each `field: value` override to the freshly-copied
/// struct buffer. Walks the override list in source order, looks
/// up each field's index, emits the override expression, and
/// stores it via `store_field`. Union-typed fields receive a
/// `union_wrap` first when needed.
fn apply_overrides(ctx: Ctx, env: VarEnv, dst: ptr, struct_name: string, fields: List<FieldEntry>, overrides: List<FieldInit>) -> Result<int, string> {
    mut i = 0
    while i < overrides.length {
        let ov = overrides[i]
        let idx = field_index_of(fields, ov.name)
        if idx >= 0 {
            let r = ctx.emit(env, ov.value.node)?
            let st_ty = ctx.get_type(struct_name)
            let gep = ctx.gep(st_ty, dst, idx, "with_ovr")
            let fld_ty = ctx.resolve_field_type(fields, ov.name)
            // store_field truncates / casts to the field's LLVM type
            // (e.g. i64 → i1 for bool fields). Plain ctx.store would
            // write 8 bytes and clobber adjacent fields when the
            // destination is i1 (forge-crafting-intepreters-14s7).
            if needs_union_wrap(r.ty, fld_ty) {
                let wrapped = emit_union_wrap(ctx, r.value, r.ty, fld_ty)?
                ctx.store_field(wrapped.value, gep, fld_ty)
            } else {
                ctx.store_field(r.value, gep, fld_ty)
            }
        }
        i = i + 1
    }
    .Ok(0)
}
