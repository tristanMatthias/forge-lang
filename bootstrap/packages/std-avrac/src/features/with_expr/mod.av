// dir-as-module (g2eo.1): codegen.av auto-loads as a sibling, surfaces
// flat at `features.with_expr.{...}`; the manifest row lives in lowering/.
use core.{vtype_struct_name, ExprId}
use resolve.{resolve_expr, resolve_field_init_list}
use features.struct_decl.{check_field_inits, check_struct_lit_fields}
use features.grammar.{parse_grammar}
use features.with_expr.lowering.{with_expr_builds}
use typeck.{check_expr, tc_er}

/// `point with { x: 5 }` — a shallow-copied struct value with selected
/// fields overridden (spec axis 28). The definition carries the
/// `with_suffix` rule + the MkWithSuffix row (t-kd4y.3.5.6): every unary
/// branch's `( @onfail(bail) s:with_suffix )*` tail references it
/// cross-fragment by name, and the fold that rebinds the partial nodes
/// (fold_postfix_with) stays engine-core. `gram_family = "expr"`.
export fn with_expr_lang() -> LanguageFeature {
    LanguageFeature with_expr_def {
        name = "with",
        title = "with — struct update expressions",
        docs = """
`value with { field: new, … }` builds a copy of a struct value with the
named fields replaced; the update is intentionally partial (no
completeness gate — that is the literal's job).
""",
        gram = grammar {
  with_suffix = "with" @require "{" ( @onfail(bail) f:field_init )+ @require "}" @expect("{", "expected `{` after `with`") @expect("+", "expected field name") @expect("}", "expected `}` after struct fields") -> MkWithSuffix(f)
        },
        builders = with_expr_builds(),
        snippet = r"${1:value} with { ${2:field}: ${3:new} }",
        expr_tag = Expr.With(ExprId(0), []),
        emit_expr = emit_with,
        resolve_expr = with_resolve,
        check_expr = with_check,
        gram_family = "expr",
    }
    with_expr_def
}

/// Resolver hook for `With`. Walks the source object, then the
/// override field-init list so any names in either side resolve.
fn with_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .With(obj, overrides) -> {
            let after_obj = resolve_expr(r, r.nodes.exprs.get(obj))
            resolve_field_init_list(after_obj, overrides)
        }
        _ -> r
    }
}

/// Type-check hook for `With`. Checks the source object, then validates each
/// override against the source struct's DECLARED fields — name, scalar
/// string-mismatch, and generic-arg layout conflict — via the same
/// `check_struct_lit_fields` a struct literal uses. Previously it only checked
/// the override value expressions (`check_field_inits`), so `s with { b:
/// Box{val:9} }` on `b: Box<string>` stored a Box<int> in the slot — a wild
/// store read later as a pointer (lb81). Falls back to the lenient value-only
/// check when the source isn't a known struct (generic / forward ref).
/// Result type matches the source — `with` is a shallow copy, not a coercion.
fn with_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .With(obj, overrides) -> {
            let o = check_expr(tc, tc.nodes.exprs.get(obj))
            let name = vtype_struct_name(o.ty)
            let checked = if name == "" { check_field_inits(o.tc, overrides) } else { check_struct_lit_fields(o.tc, o.ty, name, overrides) }
            tc_er(checked, o.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
