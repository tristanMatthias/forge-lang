// The `with` feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Expr}
use resolve.{Resolver, resolve_expr, resolve_field_init_list}

/// Resolver hook for `With`. Walks the source object, then the
/// override field-init list so any names in either side resolve.
fn with_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .With(obj, overrides) -> {
            let after_obj = resolve_expr(r, r.nodes.exprs.get(obj))
            resolve_field_init_list(after_obj, overrides)
        }
        _ -> r
    }
}
