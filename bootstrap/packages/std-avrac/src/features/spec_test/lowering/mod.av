// The spec_test feature's LOWERINGS — ABI fns + manifest rows in the
// closure-safe lowering submodule the generated parser imports directly
// (t-kd4y.3.2.5). Only features.grammar + core are imported, so the F4012
// import-closure invariant holds by construction: the feature's own mod.av
// pulls typeck/resolve/eval for its pass hooks and must never enter a parse
// closure, but this submodule adds no edge the generated parser lacks.
//
// All three builds are SPAN-FREE leaf rows — the central arms they replace
// took no sp_start, so no row declares `spanned` and the two engines agree
// by construction (the flip-parity contract, PR #1259).

use core.{Expr, Stmt, StmtId}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_stmt_val, capval_to_stmt_list, capval_tok_text, BuildKind}

/// `spec "name" { items }` (`MkSpecBlock`) — a LEAF SpecBlock row over the
/// natively-parsed item ids, exactly the hand's
/// `alloc_stmt_leaf(Stmt.SpecBlock(name, body.ids))`.
export fn spec_block_build(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, Stmt.SpecBlock(capval_tok_text(vals[0]), capval_to_stmt_list(vals[1])))
}

/// `given "name" { items }` (`MkGivenBlock`) — the SpecBlock shape one level
/// down.
export fn given_block_build(st: PState, vals: List<CapVal>) -> CapVal {
    capval_stmt_val(st, Stmt.GivenBlock(capval_tok_text(vals[0]), capval_to_stmt_list(vals[1])))
}

/// `then "name" { stmts }` (`MkThenBlock`). The body rows fold into a
/// walker-opaque Expr.Block cond LEAF (the hand's parse_then_block: the rows
/// ARE the structure), under a LEAF ThenBlock row.
export fn then_block_build(st: PState, vals: List<CapVal>) -> CapVal {
    let body: List<StmtId> = capval_to_stmt_list(vals[1])
    let cond_id = st.store.exprs.add_leaf(Expr.Block(body))
    capval_stmt_val(st, Stmt.ThenBlock(capval_tok_text(vals[0]), cond_id))
}

/// The spec-test feature's rows — bound under the EXISTING Mk names, so the
/// gram fragment moves verbatim and no rule text changes.
export fn spec_builds() -> List<BuilderBind> {
    bind_rows("features.spec_test.lowering", [bind_row("MkSpecBlock", BuildKind.Stmt, 2, false, "spec_block_build", spec_block_build),
     bind_row("MkGivenBlock", BuildKind.Stmt, 2, false, "given_block_build", given_block_build),
     bind_row("MkThenBlock", BuildKind.Stmt, 2, false, "then_block_build", then_block_build)])
}
