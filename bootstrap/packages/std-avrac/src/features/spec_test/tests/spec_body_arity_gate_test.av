// WHY: qm8l regression — a spec/given/then body is a real statement list, so a
// call inside it MUST get the same F1001 call-arity gating as a fn body. It did
// not until #682's 4d5r fix wired `check_stmt_list` into the spec/given/then
// type-check hooks; before that a wrong-arity call inside a `then` compiled
// clean and SIGSEGV'd at runtime (a missed 3-arg call-site update slipped
// through as a garbage third argument). These specs pin the arity gate at every
// spec-body position so a future refactor of the hooks (e.g. dropping the
// `check_stmt_list` recursion) can't silently reopen the crash.
//
// Uses `bs2 check` on a fixture and asserts the F-code in captured output. This
// is a typecheck-level gate, so `check` (not `compile`) is the right tool: it
// runs the arity check without codegen — and a spec-only program has no `main`,
// so it can't be `compile`d anyway (its `spec` lowers to a test-runner unit).
// `check` prints `ok` on a clean program, or the F-coded error otherwise.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

fn arity_out(tag: string, source: string) -> string {
    let path = "/tmp/avra_qm8l_arity_${tag}.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 check '${path}' 2>&1 || true")
}

spec "a wrong-arity call inside a spec body is gated as F1001 (qm8l)" {
    then "a wrong-arity call directly in a then is F1001" {
        let out = arity_out("then", "fn three(a: int, b: string, c: int) -> int { a + c }
spec \"s\" { then \"t\" { three(1, \"hi\") == 2 } }")
        out.contains("F1001")
    }
    then "the correct-arity call in a then is not flagged (positive control)" {
        let out = arity_out("then_ok", "fn three(a: int, b: string, c: int) -> int { a + c }
spec \"s\" { then \"t\" { three(1, \"hi\", 3) == 4 } }")
        out.contains("ok") && !out.contains("F1001")
    }
    then "a wrong-arity call in a given SETUP statement is F1001" {
        let out = arity_out("given", "fn three(a: int, b: string, c: int) -> int { a + c }
spec \"s\" { given \"g\" { let x = three(9) }  then \"t\" { true } }")
        out.contains("F1001")
    }
    then "a wrong-arity call in a then nested in a given is F1001" {
        let out = arity_out("given_then", "fn three(a: int, b: string, c: int) -> int { a + c }
spec \"s\" { given \"g\" { then \"t\" { three(1, \"hi\") == 2 } } }")
        out.contains("F1001")
    }
    then "a wrong-arity call guarded by an if inside a then is F1001" {
        let out = arity_out("if_then", "fn three(a: int, b: string, c: int) -> int { a + c }
spec \"s\" { then \"t\" {
    if 1 == 1 { three(1, \"hi\") == 2 } else { false }
} }")
        out.contains("F1001")
    }
    then "too MANY arguments in a then is also F1001" {
        let out = arity_out("too_many", "fn one(a: int) -> int { a }
spec \"s\" { then \"t\" { one(1, 2, 3) == 1 } }")
        out.contains("F1001")
    }
}
