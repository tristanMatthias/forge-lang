// hkms.3: per-spec crash isolation.
//
// A SIGABRT raised inside the first spec block's body MUST be caught
// by `avra_test_run_spec_guarded` so the bundle keeps running. The
// later specs in the same file confirm the orchestrator advanced
// past the crash with all attribution machinery intact:
//   * the crashed spec is recorded once (one crash for THIS file)
//   * the crashed spec's name + signal land in the C-side crash list
//   * subsequent spec blocks pass normally — they ran AFTER the crash

// `avra_test_raise_signal`, `avra_test_expect_crash`, and the
// SIGABRT constant come from the inlined spec_test reporter. Only the
// crash-list getters need explicit extern decls.
//
// 4m1e: the crash list is process-global, so under the in-process parallel
// workers this file's deliberate crashes interleave with the OTHER
// crash-isolation file's — a global-count / absolute-index read would race.
// Filter every introspection read by THIS file's basename so the assertions
// see only our own crashes.
const CIT_FILE: string = "crash_isolation_test.av"
extern fn avra_test_crash_count_for_file(frag: string) -> int
extern fn avra_test_crash_spec_for_file(frag: string, idx: int) -> string
extern fn avra_test_crash_signal_for_file(frag: string, idx: int) -> int

spec "crash isolation: a spec that aborts is caught" {
    given "first spec triggers SIGABRT mid-body" {
        then "raising SIGABRT does not kill the bundle" {
            // Arm the imminent crash as expected, THEN raise: the guard's
            // crash path records it (per-file introspection below still sees
            // it) AND drops the live count atomically on this thread, so no
            // separate later ack is needed. raise(SIGABRT) → signal handler
            // longjmps back to avra_test_run_spec_guarded → never returns
            // here. The `true` is structurally unreachable, kept only so the
            // then-block parses.
            avra_test_expect_crash()
            avra_test_raise_signal(SIGABRT)
            true
        }
    }
}

spec "crash isolation: later specs still run" {
    given "post-crash spec executes" {
        then "this then-block ran after the prior spec crashed" {
            true
        }
    }
}

spec "crash isolation: crash bookkeeping" {
    given "the C-side crash list has the right shape" {
        then "exactly one crash was recorded for this file" {
            avra_test_crash_count_for_file(CIT_FILE) == 1
        }
        then "the crashed spec name was captured" {
            avra_test_crash_spec_for_file(CIT_FILE, 0).contains("aborts is caught")
        }
        then "the recorded signal is SIGABRT" {
            avra_test_crash_signal_for_file(CIT_FILE, 0) == SIGABRT
        }
        then "the deliberate crash was already acked at record time" {
            // The first spec armed its crash (avra_test_expect_crash) before
            // raising, so the guard dropped the global live count when it
            // recorded the crash — no separate ack here, and no window for the
            // count to leak to the summary. The recorded entry is RETAINED for
            // introspection, which this asserts (a per-file, race-free check).
            avra_test_crash_count_for_file(CIT_FILE) == 1
        }
    }
}
