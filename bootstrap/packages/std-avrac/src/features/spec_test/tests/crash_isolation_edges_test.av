// hkms.3 red-team: harder shapes for the per-spec crash guard.
//
//   * Multiple specs crash in a row — each is recorded, counted, and
//     attributed independently; ack drains them all so the suite
//     exits green.
//   * A spec with an empty body wraps cleanly and runs without
//     hitting the guard's crash path (the lambda returns 0 normally).
//   * A spec whose ONLY content is a crashing `then` — no given —
//     still gets caught and named.

// `avra_test_raise_signal`, `avra_test_expect_crash`, and the
// SIG* constants come from the inlined spec_test reporter.
//
// 4m1e: the crash list is process-global, so under the in-process parallel
// workers this file's two deliberate crashes interleave with the OTHER
// crash-isolation file's — a global-count / absolute-index read would race.
// Filter every introspection read by THIS file's basename.
const CIE_FILE: string = "crash_isolation_edges_test.av"
extern fn avra_test_crash_count_for_file(frag: string) -> int
extern fn avra_test_crash_spec_for_file(frag: string, idx: int) -> string
extern fn avra_test_crash_signal_for_file(frag: string, idx: int) -> int

spec "crash isolation edges: spec with empty body wraps without crashing" {
}

spec "crash isolation edges: first deliberate crash (SIGABRT)" {
    then "crash one" {
        avra_test_expect_crash()
        avra_test_raise_signal(SIGABRT)
        true
    }
}

spec "crash isolation edges: second deliberate crash (SIGFPE)" {
    then "crash two" {
        avra_test_expect_crash()
        avra_test_raise_signal(SIGFPE)
        true
    }
}

spec "crash isolation edges: both crashes were recorded with distinct signals" {
    given "the crash list has two entries" {
        then "count is exactly 2 for this file" {
            avra_test_crash_count_for_file(CIE_FILE) == 2
        }
        then "crash 0 was SIGABRT" {
            avra_test_crash_signal_for_file(CIE_FILE, 0) == SIGABRT
        }
        then "crash 1 was SIGFPE" {
            avra_test_crash_signal_for_file(CIE_FILE, 1) == SIGFPE
        }
        then "crashed spec 0 name was captured" {
            avra_test_crash_spec_for_file(CIE_FILE, 0).contains("first deliberate crash")
        }
        then "crashed spec 1 name was captured" {
            avra_test_crash_spec_for_file(CIE_FILE, 1).contains("second deliberate crash")
        }
        then "both deliberate crashes were already acked at record time" {
            // Each crash armed itself (avra_test_expect_crash) before raising,
            // so the guard dropped the global live count as it recorded them —
            // no separate acks here, and no window for the counts to leak to
            // the summary. Both entries are RETAINED for introspection, which
            // this asserts (per-file, race-free).
            avra_test_crash_count_for_file(CIE_FILE) == 2
        }
    }
}
