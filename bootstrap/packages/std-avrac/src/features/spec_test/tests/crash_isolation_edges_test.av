// hkms.3 red-team: harder shapes for the per-spec crash guard.
//
//   * Multiple specs crash in a row — each is recorded, counted, and
//     attributed independently; ack drains them all so the suite
//     exits green.
//   * A spec with an empty body wraps cleanly and runs without
//     hitting the guard's crash path (the lambda returns 0 normally).
//   * A spec whose ONLY content is a crashing `then` — no given —
//     still gets caught and named.

extern fn avra_test_raise_signal(sig: int) -> int
extern fn avra_test_crash_count() -> int
extern fn avra_test_crash_spec(idx: int) -> string
extern fn avra_test_crash_signal(idx: int) -> int
extern fn avra_test_ack_expected_crash()

const SIGABRT: int = 6
const SIGFPE:  int = 8

spec "crash isolation edges: spec with empty body wraps without crashing" {
}

spec "crash isolation edges: first deliberate crash (SIGABRT)" {
    then "crash one" {
        avra_test_raise_signal(SIGABRT)
        true
    }
}

spec "crash isolation edges: second deliberate crash (SIGFPE)" {
    then "crash two" {
        avra_test_raise_signal(SIGFPE)
        true
    }
}

spec "crash isolation edges: both crashes were recorded with distinct signals" {
    given "the crash list has two entries" {
        then "count is exactly 2" {
            avra_test_crash_count() == 2
        }
        then "crash 0 was SIGABRT" {
            avra_test_crash_signal(0) == SIGABRT
        }
        then "crash 1 was SIGFPE" {
            avra_test_crash_signal(1) == SIGFPE
        }
        then "crashed spec 0 name was captured" {
            avra_test_crash_spec(0).contains("first deliberate crash")
        }
        then "crashed spec 1 name was captured" {
            avra_test_crash_spec(1).contains("second deliberate crash")
        }
        then "drain both acks so CI stays green" {
            avra_test_ack_expected_crash()
            avra_test_ack_expected_crash()
            avra_test_crash_count() == 0
        }
    }
}
