// WHY: parses spec test syntax:
//   spec "name" { given "setup" { then "assertion" { expr } } }

// Imports resolved by bootstrap's module-qualified name resolution.

use core.{SrcPos}
use core.{Tk}
use parse.{StmtListIds}
impl Parser {

    fn parse_spec_body(self) -> StmtListIds {
        mut ids: List<StmtId> = []
        while !(self.current_kind in [Tk.RightBrace, Tk.Eof]) {
            let line = self.current_line
            let col = self.current_column
            mut stmt_res: Result<StmtId, string> = .Err("")
            if self.check(Tk.KwGiven) {
                stmt_res = self.parse_given_block()
            } else if self.check(Tk.KwThen) {
                stmt_res = self.parse_then_block()
            } else {
                stmt_res = self.parse_declaration()
            }
            let sid = match stmt_res {
                .Ok(s) -> s
                .Err(_) -> return StmtListIds { ids: ids }
            }
            self.store.stmts.record_pos(sid, SrcPos { line: line, col: col, file: self.file })
            ids.push(sid)
        }
        StmtListIds { ids: ids }
    }

    fn parse_given_block(self) -> Result<StmtId, string> {
        self.advance()  // consume `given`
        // MUST report before bailing: parse_spec_body swallows the Err and
        // returns the partial item list, so a bare return here let
        // `spec "s" { given }` close cleanly with the malformed given DROPPED
        // and no diagnostic — the same silent-drop class the select arm had
        // (both caught by the error-recovery corpus while routing t-47hc
        // Phase 4).
        if !self.check(Tk.String) {
            self.set_error("expected given name string after `given`")
            return .Err("parse error")
        }
        let name = self.current_lexeme
        self.advance()
        if !self.consume(Tk.LeftBrace, "expected `{` after given name") {
            return .Err("parse error")
        }
        let body = self.parse_spec_body()
        if !self.consume(Tk.RightBrace, "expected `}` to close given block") {
            return .Err("parse error")
        }
        .Ok(self.alloc_stmt_leaf(Stmt.GivenBlock(name, body.ids)))
    }

    fn parse_then_block(self) -> Result<StmtId, string> {
        self.advance()  // consume `then`
        // Same silent-drop hazard as the given block above.
        if !self.check(Tk.String) {
            self.set_error("expected then name string after `then`")
            return .Err("parse error")
        }
        let name = self.current_lexeme
        self.advance()
        if !self.consume(Tk.LeftBrace, "expected `{` after then name") {
            return .Err("parse error")
        }
        // Parse as a block: multiple statements, last expression is the assertion
        let body = self.parse_statement_list_ids(true)?
        if !self.consume(Tk.RightBrace, "expected `}` to close then block") {
            return .Err("parse error")
        }
        // Flipped Expr.Block holds List<StmtId> (walker-opaque leaf, the
        // parse_block_expression shape) — the body rows ARE the structure,
        // so the Block cond is a leaf row.
        let cond = Expr.Block(body.ids)
        let cond_id = self.alloc_leaf(cond)
        .Ok(self.alloc_stmt_leaf(Stmt.ThenBlock(name, cond_id)))
    }
}
