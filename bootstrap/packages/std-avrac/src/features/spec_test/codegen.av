// WHY: emits spec test runtime calls for spec/given/then blocks.

use core.{sstmt_dummy}
use codegen.{err_stmt, ok_stmt, StmtResult}
use codegen.{emit_block_loop}
use codegen.{ok_sr, err_sr}
/// Codegen entry for the test feature. Dispatches Spec / Given /
/// Then blocks to the corresponding emitter; everything else is
/// an internal mismatch.
export fn spec_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .SpecBlock(name, body) -> emit_spec_block(ctx, env, name, body)
        .GivenBlock(name, body) -> emit_given_block(ctx, env, name, body)
        // file/line come from `ctx` (set per-stmt by the codegen
        // walkers); the reporter uses them to record failure
        // locations for the summary block.
        .ThenBlock(name, cond) -> emit_then_block(ctx, env, name, cond, ctx.source_file, ctx.source_line)
        _ -> err_sr("spec_emit_stmt: unexpected statement")
    }
}

/// Emit a `spec` block: call into the Avra reporter's
/// `test_render_spec_start` (which prints the colored header and
/// records the current spec name in C state for later failure
/// attribution), then walk the body. No `_end_spec` call — the
/// reporter doesn't need a close marker.
fn emit_spec_block(ctx: Ctx, env: VarEnv, name: string, body: StmtList) -> Result<StmtResult, string> {
    let name_val = ctx.global_str(name, "spec_str")
    ctx.call("test_render_spec_start", [name_val])
    let r = emit_spec_stmts(ctx, env, body)?
    ok_sr(ctx, env)
}

/// Emit a `given` block: call `test_render_given_start` and walk
/// the body. Threads the env so `let` bindings flow into later
/// `then` arms.
fn emit_given_block(ctx: Ctx, env: VarEnv, name: string, body: StmtList) -> Result<StmtResult, string> {
    let name_val = ctx.global_str(name, "spec_str")
    ctx.call("test_render_given_start", [name_val])
    let new_env = emit_spec_stmts(ctx, env, body)?
    ok_sr(ctx, new_env)
}

/// Emit a `then` arm: evaluate the condition expression, hand
/// the boolean result + name + file/line to the Avra reporter's
/// `test_render_then`. File/line lets the reporter record
/// failures with their source location for the summary block.
fn emit_then_block(ctx: Ctx, env: VarEnv, name: string, cond: Expr, file: string, line: int) -> Result<StmtResult, string> {
    let r = ctx.emit(env, cond)?
    // Coerce cond to i1: tests historically relied on nonzero/non-null
    // == truthy because the original C-side runner took an int. Without
    // this, LLVM's call coerce truncates ints/ptrs to i1 (LSB), which
    // miscounts non-bool results (e.g. `?? 0 == 8080` parses as
    // `?? (0 == 8080)` and yields the int 8080, whose LSB is 0 → FAIL).
    let cond_bool = ctx.truthy(r.value, "then_truthy")
    let file_val = ctx.global_str(file, "spec_file")
    ctx.call("test_render_then", [ctx.global_str(name, "spec_str"), cond_bool, file_val, ctx.i64(line)])
    ok_sr(ctx, env)
}

/// Walk a spec/given body emitting each child statement. Threads
/// the VarEnv through so `let` bindings flow into later arms.
/// Updates `ctx.source_file` / `ctx.source_line` from each SStmt
/// so the reporter records the correct location for each `then`
/// arm — the outer codegen walker only updates ctx at top-level
/// stmt boundaries, but `then` arms are nested inside `spec` /
/// `given` bodies and need their own per-stmt update.
fn emit_spec_stmts(ctx: Ctx, env: VarEnv, stmts: StmtList) -> Result<VarEnv, string> {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let line_ctx = ctx with { source_line: ss.line, source_file: ss.file }
            let new_env = emit_spec_single(line_ctx, env, ss.node)?
            emit_spec_stmts(ctx, new_env, next)
        }
    }
}

/// Per-statement spec emitter. SpecBlock / GivenBlock / ThenBlock
/// dispatch to their dedicated emitters; anything else (regular
/// `let`, `mut`, function calls inside `given`) is wrapped and
/// emitted as a normal block-loop statement.
fn emit_spec_single(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<VarEnv, string> {
    match stmt {
        .SpecBlock(name, body) -> {
            let sr = emit_spec_block(ctx, env, name, body)?
            ok_stmt(sr.env)
        }
        .GivenBlock(name, body) -> {
            let sr = emit_given_block(ctx, env, name, body)?
            ok_stmt(sr.env)
        }
        .ThenBlock(name, cond) -> {
            let sr = emit_then_block(ctx, env, name, cond, ctx.source_file, ctx.source_line)?
            ok_stmt(sr.env)
        }
        _ -> {
            let wrapped = StmtList.Node(sstmt_dummy(stmt), StmtList.End)
            emit_block_loop(ctx, env, wrapped, ctx.i64(0), .Unknown)?
            ok_stmt(env)
        }
    }
}
