// WHY: spec/given/then test rendering. State (counters, failure
// list, current spec/given) lives in runtime.c — see TODO in
// runtime.c referencing forge-crafting-intepreters-3uy9.
//
// This file is inlined into the test program at the bundle's top
// level (test runner reads + parses + prepends), so its `use`
// imports must resolve at that scope — not via @std.avrac. Until
// the test runner can guarantee @std.avrac is loaded, the failure
// summary uses plain ANSI rendering rather than the diagnostics
// framework (which would give us source snippets per failure).
// Future: switch to diagnostics::render_bag once the bundle
// always loads @std.avrac.

extern fn avra_test_pass_inc() -> int
extern fn avra_test_fail_inc() -> int
extern fn avra_test_get_pass() -> int
extern fn avra_test_get_fail() -> int
extern fn avra_uptime_ms() -> int
extern fn avra_test_record_failure(spec_name: string, given_name: string, then_name: string, file: string, ln: int) -> int
extern fn avra_test_failure_count() -> int
extern fn avra_test_failure_spec(idx: int) -> string
extern fn avra_test_failure_given(idx: int) -> string
extern fn avra_test_failure_then(idx: int) -> string
extern fn avra_test_failure_file(idx: int) -> string
extern fn avra_test_failure_line(idx: int) -> int
extern fn avra_test_set_current_spec(name: string) -> int
extern fn avra_test_set_current_given(name: string) -> int
extern fn avra_test_get_current_spec() -> string
extern fn avra_test_get_current_given() -> string
// hkms.3: per-spec crash isolation. `avra_test_run_spec_guarded`
// (declared in prepend_test_externs) calls these to record any spec
// block that died on a fatal signal so the summary block can list
// crashes alongside failures.
extern fn avra_test_crash_count() -> int
extern fn avra_test_crash_spec(idx: int) -> string
extern fn avra_test_crash_file(idx: int) -> string
extern fn avra_test_crash_line(idx: int) -> int
extern fn avra_test_crash_signal(idx: int) -> int
extern fn avra_test_crash_signal_name(idx: int) -> string
extern fn avra_process_env_get(name: string) -> string
extern fn avra_selfhost_write_file(path: string, content: string) -> int
extern fn avra_selfhost_write_file_bytes(path: string, b: bytes) -> int
// nce6.1.F: hand-rolled writers for the @marshal TestResults wire
// format. The reporter is inlined into every test bundle and we
// don't want to drag @std/process in for every test binary, so
// the byte primitives are extern-decl'd directly. Format must
// stay in sync with BytesBuilder.write_int / @marshal's
// generated TestResults.to_bytes() — 4 × little-endian i64 with
// no padding or length prefix.
extern fn avra_int_to_bytes_le(n: int) -> bytes
extern fn avra_bytes_concat(a: bytes, b: bytes) -> bytes
extern fn avra_bytes_empty() -> bytes

fn ansi_green(s: string) -> string { "\x1b[32m${s}\x1b[0m" }
fn ansi_red(s: string) -> string { "\x1b[31m${s}\x1b[0m" }
fn ansi_yellow(s: string) -> string { "\x1b[33m${s}\x1b[0m" }
fn ansi_dim(s: string) -> string { "\x1b[2m${s}\x1b[0m" }
fn ansi_bold(s: string) -> string { "\x1b[1m${s}\x1b[0m" }
fn ansi_cyan(s: string) -> string { "\x1b[36m${s}\x1b[0m" }

export fn test_render_spec_start(name: string) {
    avra_test_set_current_spec(name)
    avra_test_set_current_given("")
    println("${ansi_bold("spec")} ${ansi_cyan(name)}")
}

export fn test_render_given_start(name: string) {
    avra_test_set_current_given(name)
    println("  ${ansi_dim("given")} ${name}")
}

export fn test_render_then(name: string, result: bool, file: string, ln: int) {
    if result {
        avra_test_pass_inc()
        println("    ${ansi_green("PASS")} ${name}")
    } else {
        avra_test_fail_inc()
        let cur_spec = avra_test_get_current_spec()
        let cur_given = avra_test_get_current_given()
        avra_test_record_failure(cur_spec, cur_given, name, file, ln)
        println("    ${ansi_red("FAIL")} ${name} ${ansi_dim("(${file}:${string(ln)})")}")
    }
}

export fn test_render_summary() -> int {
    let pass = avra_test_get_pass()
    let fail = avra_test_get_fail()
    let crashes = avra_test_crash_count()
    let total = pass + fail
    let elapsed_ms = avra_uptime_ms()
    // ylye: structured JSON results to AVRA_TEST_RESULTS_PATH when
    // the orchestrator set one. Keeps the `[shard-summary]` line as
    // a transitional fallback until orchestrator + reporter both
    // ship the JSON path (single seed cycle).
    let results_path = avra_process_env_get("AVRA_TEST_RESULTS_PATH")
    if results_path != "" {
        let _ = avra_selfhost_write_file(results_path, render_results_json(pass, fail, total, elapsed_ms, crashes))
    }
    // nce6.1.F: @marshal-compatible binary results. Format matches
    // BytesBuilder.write_int — 5 i64s concatenated, no header.
    // hkms.3: 5th i64 is the crash count so the orchestrator can
    // distinguish caught-spec-crashes from assertion fails.
    // Orchestrator decodes via from_bytes_TestResults (cli/main.av).
    let bin_path = avra_process_env_get("AVRA_TEST_RESULTS_BIN_PATH")
    if bin_path != "" {
        let buf = avra_bytes_concat(
            avra_bytes_concat(
                avra_bytes_concat(avra_int_to_bytes_le(pass), avra_int_to_bytes_le(fail)),
                avra_bytes_concat(avra_int_to_bytes_le(total), avra_int_to_bytes_le(elapsed_ms))
            ),
            avra_int_to_bytes_le(crashes)
        )
        let _ = avra_selfhost_write_file_bytes(bin_path, buf)
    }
    let crash_kv = if crashes > 0 { " crashes=${string(crashes)}" } else { "" }
    println("[shard-summary] pass=${string(pass)} fail=${string(fail)} total=${string(total)} elapsed_ms=${string(elapsed_ms)}${crash_kv}")
    if total == 0 && crashes == 0 {
        println("${ansi_yellow("No tests ran.")}")
        return 0
    }
    if fail > 0 {
        println("")
        println("${ansi_bold(ansi_red("Failures:"))}")
        let count = avra_test_failure_count()
        render_failure_list(count, 0)
    }
    if crashes > 0 {
        println("")
        println("${ansi_bold(ansi_red("Crashed specs:"))}")
        render_crash_list(crashes, 0)
    }
    println("")
    let elapsed_s = render_elapsed(elapsed_ms)
    let summary = "${string(pass)}/${string(total)} tests passed in ${elapsed_s}"
    let red_note = if fail > 0 && crashes > 0 {
        " (${string(fail)} failed, ${string(crashes)} crashed)"
    } else if fail > 0 {
        " (${string(fail)} failed)"
    } else if crashes > 0 {
        " (${string(crashes)} crashed)"
    } else {
        ""
    }
    if fail > 0 || crashes > 0 {
        println("${ansi_red(ansi_bold(summary))} ${ansi_red(red_note)}")
        return 1
    }
    println("${ansi_green(ansi_bold(summary))}")
    0
}

/// t2uk: render wall-clock duration as a human-friendly string.
/// Integer math only — Avra eval doesn't have floats. Sub-second
/// reads as `Xms`, anything bigger as `X.Ys`.
fn render_elapsed(ms: int) -> string {
    if ms < 1000 { return "${string(ms)}ms" }
    let s = ms / 1000
    let frac = (ms % 1000) / 100
    "${string(s)}.${string(frac)}s"
}

/// Walk the C-side failure list, printing each one's spec/given/
/// then names + source location. Plain-text rendering — no source
/// snippet (which would require the diagnostics framework). Future:
/// upgrade to render_bag once the test bundle always loads
/// @std.avrac so `use diagnostics.{...}` resolves cleanly.
/// Build the per-binary results JSON. Shape:
///
///     {"pass": N, "fail": N, "total": N, "elapsed_ms": N,
///      "crashes": N,
///      "failures": [{"spec": "...", "given": "...", "then": "...",
///                    "file": "...", "line": N}, ...],
///      "crashed_specs": [{"spec": "...", "file": "...", "line": N,
///                         "signal": N, "signal_name": "..."}, ...]}
///
/// Hand-rolled rather than via @std.json because the reporter is
/// inlined into each test bundle — its imports must resolve at the
/// test program's scope, which doesn't include @std.avrac.json
/// reliably until the bundle assembler always pulls in @std.
fn render_results_json(pass: int, fail: int, total: int, elapsed_ms: int, crashes: int) -> string {
    let header = "{\"pass\":${string(pass)},\"fail\":${string(fail)},\"total\":${string(total)},\"elapsed_ms\":${string(elapsed_ms)},\"crashes\":${string(crashes)},\"failures\":["
    let fail_body = render_failures_json(avra_test_failure_count(), 0, "")
    let crash_body = render_crashes_json(crashes, 0, "")
    "${header}${fail_body}],\"crashed_specs\":[${crash_body}]}"
}

/// hkms.3 sibling of render_failures_json — one JSON entry per
/// crashed spec.
fn render_crashes_json(count: int, idx: int, acc: string) -> string {
    if idx >= count { return acc }
    let s  = json_escape(avra_test_crash_spec(idx))
    let f  = json_escape(avra_test_crash_file(idx))
    let l  = avra_test_crash_line(idx)
    let sg = avra_test_crash_signal(idx)
    let sn = json_escape(avra_test_crash_signal_name(idx))
    let entry = "{\"spec\":\"${s}\",\"file\":\"${f}\",\"line\":${string(l)},\"signal\":${string(sg)},\"signal_name\":\"${sn}\"}"
    let sep = if idx == 0 { "" } else { "," }
    render_crashes_json(count, idx + 1, "${acc}${sep}${entry}")
}

/// Walk the C-side failure list emitting one JSON object per
/// failure, comma-separated. Recursive so we don't need a mutable
/// accumulator in reporter scope.
fn render_failures_json(count: int, idx: int, acc: string) -> string {
    if idx >= count { return acc }
    let s = json_escape(avra_test_failure_spec(idx))
    let g = json_escape(avra_test_failure_given(idx))
    let t = json_escape(avra_test_failure_then(idx))
    let f = json_escape(avra_test_failure_file(idx))
    let l = avra_test_failure_line(idx)
    let entry = "{\"spec\":\"${s}\",\"given\":\"${g}\",\"then\":\"${t}\",\"file\":\"${f}\",\"line\":${string(l)}}"
    let sep = if idx == 0 { "" } else { "," }
    render_failures_json(count, idx + 1, "${acc}${sep}${entry}")
}

/// Minimal JSON string escaper — handles the printable-ASCII
/// quote/backslash plus newline, tab, CR. Test spec/given/then
/// names are author-controlled English text, file paths are
/// filesystem strings, so we don't need full \uXXXX coverage.
fn json_escape(s: string) -> string {
    mut out = ""
    for ch in s {
        if ch == "\"" { out = out + "\\\"" }
        else if ch == "\\" { out = out + "\\\\" }
        else if ch == "\n" { out = out + "\\n" }
        else if ch == "\r" { out = out + "\\r" }
        else if ch == "\t" { out = out + "\\t" }
        else { out = out + ch }
    }
    out
}

fn render_failure_list(count: int, idx: int) {
    if idx >= count { return }
    let s = avra_test_failure_spec(idx)
    let g = avra_test_failure_given(idx)
    let t = avra_test_failure_then(idx)
    let f = avra_test_failure_file(idx)
    let l = avra_test_failure_line(idx)
    let chain = if g != "" {
        "${s} / ${ansi_dim("given")} ${g} / ${ansi_dim("then")} ${t}"
    } else {
        "${s} / ${ansi_dim("then")} ${t}"
    }
    println("  ${ansi_red("✗")} ${chain}")
    if f != "" {
        println("    ${ansi_dim("at ${f}:${string(l)}")}")
    }
    render_failure_list(count, idx + 1)
}

/// hkms.3: print every crashed spec — name, source location, and
/// the signal label so the reader sees segfault vs abort vs FPE at
/// a glance. Recursive walk mirroring `render_failure_list`.
fn render_crash_list(count: int, idx: int) {
    if idx >= count { return }
    let s = avra_test_crash_spec(idx)
    let f = avra_test_crash_file(idx)
    let l = avra_test_crash_line(idx)
    let sn = avra_test_crash_signal_name(idx)
    println("  ${ansi_red("💥")} ${s} ${ansi_dim("(${sn})")}")
    if f != "" {
        println("    ${ansi_dim("at ${f}:${string(l)}")}")
    }
    render_crash_list(count, idx + 1)
}
