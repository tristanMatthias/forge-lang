// The spec/given/then family's EVALUATOR hooks — the @comptime tree-walk path.
// One file per pass (features/WHY.md); module-private, reached from mod.av
// through the dir-as-module flat namespace.
use core.{Stmt}
use features.eval.{Runtime, StepResult, error_result, ok_result, value_null}

/// Tree-walk evaluator hook for `SpecBlock`. The eval path
/// doesn't run tests — return null and skip.
fn spec_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .SpecBlock(_, _) -> ok_result(rt, value_null())
        _ -> error_result(rt, "expected SpecBlock")
    }
}

/// Tree-walk evaluator hook for `GivenBlock`. Mirror of
/// `spec_eval_stmt`.
fn given_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .GivenBlock(_, _) -> ok_result(rt, value_null())
        _ -> error_result(rt, "expected GivenBlock")
    }
}

/// Tree-walk evaluator hook for `ThenBlock`. Mirror of
/// `spec_eval_stmt`.
fn then_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .ThenBlock(_, _) -> ok_result(rt, value_null())
        _ -> error_result(rt, "expected ThenBlock")
    }
}
