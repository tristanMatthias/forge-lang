// WHY: the @derive capability registry (design §3.1, ps3t.6.6) — its own
// import-free leaf module (NOT a features/derive file: that directory-module
// imports features.comptime, and the registry's consumers ARE
// features.comptime + features.modules — living there would close an import
// cycle). The ONE
// name-keyed mapping from a `@derive(Cap, …)` capability to the @comptime
// shim fn that runs its engine plan. `@derive` supersedes the per-macro
// `@expand(derive_walker)` / `@expand(derive_eq)` spellings: a capability
// is a NAME for an emitter, so adding one is a plan fn + shim + one arm
// here — no new annotation, no new pipeline pass. Dispatch stays on the
// interpreter/JIT path (design §3.2): the expander rewrites each
// capability into an `invoke_macro` of the shim, exactly how the
// `@expand` spelling runs — so `@derive` works before L2's JIT lands and
// gets faster when it does, and the two spellings cannot drift.
//
// Name-dispatch by design (mirrors `struct_list_helpers` / `anynode_ctor`):
// the capability set is closed at compiler build time.

/// Every capability `@derive(...)` accepts. The single source for both
/// dispatch (below) and the unknown-capability diagnostic's "known:"
/// list — in sync by construction.
export fn derive_capabilities() -> List<string> {
    ["Walk", "Eq", "Marshal"]
}

/// True for capabilities the expander dispatches NATIVELY (compiled
/// compiler code operating on the arena directly) instead of through a
/// @comptime shim in the interpreter. Marshal's generators are
/// arena-native builders (869 lines of NodeStore construction) — the
/// eval registry can only reach @comptime fns, and porting them to
/// value-style would be a rewrite for zero behavior gain. The
/// interpreter/JIT doctrine (design §3.2) governs USER-authored macros;
/// a compiler-built-in emitter running compiled is the end state the
/// JIT aspires to anyway.
export fn derive_capability_native(cap: string) -> bool {
    cap == "Marshal"
}

/// Capability name → the @comptime shim fn the expander invokes
/// (2-arg macro contract: (AnnotatedDecl, ResolverCtx) -> ResolvedDecls).
/// "" ⇔ unknown capability — the caller owns the diagnostic (F4011) so
/// the message carries the @derive site's span; the registry stays a
/// pure mapping.
export fn derive_capability_macro(cap: string) -> string {
    if cap == "Walk" { return "derive_walker" }
    if cap == "Eq" { return "derive_eq" }
    // Marshal is native (derive_capability_native) — no shim to name.
    ""
}

/// Capability name → the module the implicit-import injection pulls
/// from. For interpreted capabilities that's where the shim lives
/// (beside its plan: Walk in the walker feature, Eq in the eq
/// emitter); for native Marshal it's where the generated impls'
/// TRAIT lives (`@std::process::Marshal` — the impl header the
/// marshal builders emit references it, so the trait must be in the
/// module tree). "" ⇔ unknown capability.
export fn derive_capability_module(cap: string) -> string {
    if cap == "Walk" { return "@std.avrac.features.walker" }
    if cap == "Eq" { return "@std.avrac.features.derive" }
    if cap == "Marshal" { return "@std.process" }
    ""
}

/// Capability name → the symbol the implicit injection names in that
/// module's `use`: the shim fn for interpreted capabilities, the
/// trait for native Marshal. Distinct from derive_capability_macro,
/// which is dispatch-only ("" for natives).
export fn derive_capability_import(cap: string) -> string {
    if cap == "Marshal" { return "Marshal" }
    derive_capability_macro(cap)
}

/// Render the known-capability list for diagnostics: "Walk, Eq".
export fn derive_capabilities_rendered() -> string {
    mut out = ""
    let caps = derive_capabilities()
    for c in caps {
        out = if out == "" { c } else { "${out}, ${c}" }
    }
    out
}
