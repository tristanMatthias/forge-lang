// WHY: `@marshal` derive — Phase C of the `isolated { body }` epic
// (nce6.C / nce6.1.A). When a user annotates a `type` declaration
// with `@marshal`, this pass synthesises an `impl T { fn to_bytes;
// fn from_bytes }` block next to it so callers can ship typed
// values across an `isolated` fork boundary without hand-rolling
// the bytes layer.
//
// Phase 1 scope (this slice):
//   - Struct TypeDecls with fields of type int / bool / string.
//   - Generates `fn to_bytes(self) -> bytes` only.
//   - `from_bytes` + nested types + List<T> + enums live in
//     follow-up sub-tickets (nce6.1.B–F).
//
// Pipeline placement: this pass runs after expand_components and
// before resolve_names. Synthesising pre-resolution lets the
// resolver bind both the original TypeDecl and the synthesised
// methods in the same pass; the call sites in the generated bodies
// use unqualified names (`bytes_builder`, `write_int`) that the
// resolver wires up to @std/process the same way a hand-written
// impl would.

use core.{Stmt, StmtId, ExprId, Expr, FieldEntry, FieldInit, ParamEntry, ValueType, TypeParamEntry, Variant, Pattern, MatchArm, BinOp, find_annotation, rewrap_annotations, stmt_unwrap, vtype_struct, type_short_name, FORCE_UNWRAP_FN}
use core.{NodeStore}

// ── Public entry ──

/// Walk `stmts`, emit a paired `impl` next to every `@marshal`-
/// annotated TypeDecl. Original decls stay in place — the resolver
/// sees the type AND its methods together.
///
/// Fast-path: when no `@marshal` annotation is present, returns
/// the input unchanged (matches the expand_macros zero-cost
/// pattern).
export fn derive_marshal(ids: List<StmtId>, store: NodeStore) -> List<StmtId> {
    if !any_marshal_annotation(store, ids) { return ids }
    walk(store, ids)
}

fn walk(store: NodeStore, ids: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    mut i = 0
    while i < ids.length {
        let id = ids[i]
        // Module bodies host TypeDecls too — recurse so a
        // `@marshal type T` declared inside a submodule still
        // gets its impl synthesised. Match on the PEELED node so
        // annotated module wrappers (e.g. the test assembler's
        // @deferred_init) stay transparent, and rebuild inside
        // the original annotation layers so the wrapper survives.
        // Module bodies are already `List<StmtId>`, so the recursion
        // stays arena-native — no sstmts_of/rows_of round-trip.
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Module(name, body) -> {
                let walked = walk(store, body)
                let new_mod = rewrap_annotations(store, store.stmts.get(id), Stmt.Module(name, walked))
                out.push(store.stmts.add_leaf(new_mod))
            }
            _ -> {
                out.push(id)
                let derived = derive_for(store, store.stmts.get(id))
                mut di = 0
                while di < derived.length {
                    out.push(derived[di])
                    di = di + 1
                }
            }
        }
        i = i + 1
    }
    out
}

// ── Annotation detection ──

fn any_marshal_annotation(store: NodeStore, ids: List<StmtId>) -> bool {
    mut i = 0
    while i < ids.length {
        let id = ids[i]
        if has_marshal(store, store.stmts.get(id)) { return true }
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Module(_, body) -> {
                if any_marshal_annotation(store, body) { return true }
            }
            _ -> {}
        }
        i = i + 1
    }
    false
}

fn has_marshal(store: NodeStore, stmt: Stmt) -> bool {
    find_annotation(store, stmt, "marshal") != null
}

// ── Synthesis ──

/// If `stmt` is an `@marshal`-annotated TypeDecl, return the
/// synthesised `[impl T {...}, fn from_bytes_T(b) -> T {...}]`
/// as arena `StmtId`s. Empty list when no synthesis applies.
fn derive_for(store: NodeStore, stmt: Stmt) -> List<StmtId> {
    let empty: List<StmtId> = []
    if !has_marshal(store, stmt) { return empty }
    derive_marshal_stmts_for(store, stmt_unwrap(store, stmt))
}

/// The per-decl seam for the `Marshal` capability — the same
/// impls this file has always built, minus the @marshal-annotation gate
/// (the @derive dispatcher has already routed the decl here). Returns []
/// for non-type/enum decls, mirroring the annotation path's silent skip
/// — behavior parity between the `@marshal` and `@derive(Marshal)`
/// spellings by construction.
export fn derive_marshal_stmts_for(store: NodeStore, inner: Stmt) -> List<StmtId> {
    let empty: List<StmtId> = []
    match inner {
        .TypeDecl(name, _, fields) -> derive_stmts(store, name, fields)
        .EnumDecl(name, _, variants) -> derive_enum_stmts(store, name, variants)
        _ -> empty
    }
}


/// Mangle a generated artifact name from a type name. The builders run
/// POST-resolve (inside the unified derive pass), so `type_name` arrives
/// module-QUALIFIED (`mod::MPoint`) — the mangle must use the SHORT name
/// (`from_bytes_MPoint`, declared inside the same module and qualified by
/// the re-resolve like any sibling), while type REFERENCES keep the
/// qualified form. Mirrors the walker engine's `method_symbol` short-name
/// rule.
fn marshal_artifact_name(prefix: string, type_name: string) -> string {
    prefix + type_short_name(type_name)
}

/// Build the synthesised stmts for a `@marshal type T = {...}`:
///   - `impl T { fn to_bytes(self) -> bytes { ... } }` (instance method)
///   - `fn from_bytes_T(b: bytes) -> T { ... }` (top-level fn)
///
/// from_bytes lives at module scope (not inside impl) because
/// Avra has no static-method syntax — `T.from_bytes(...)` parses
/// as enum-variant access. The naming convention `<Type>_from_bytes`
/// mirrors what generic `isolated<T: Marshal>(body)` will look up
/// once generic marshal bounds land.
///
/// Field types outside {int, bool, string} fall through to a
/// no-op write so the impl still type-checks but the round-trip
/// would be lossy; the codec-table extensions handle
/// List<T> / nested @marshal / enums.
///
/// Returns a 3-element List<StmtId>: [impl_stmt, from_bytes_fn, isolated_fn].
fn derive_stmts(store: NodeStore, type_name: string, fields: List<FieldEntry>) -> List<StmtId> {
    let to_bytes_fn = build_to_bytes_fn(store, fields)
    let methods: List<StmtId> = [store.stmts.add_leaf(to_bytes_fn)]
    // Cleanup #1: emit `impl Marshal for T` instead of bare `impl T`
    // so @marshal-annotated types are nominal members of the
    // Marshal trait — unblocks `fn f<T: Marshal>(...)` bounds.
    let impl_stmt = Stmt.Impl("@std::process::Marshal:" + type_name, methods)
    let from_bytes_fn = build_from_bytes_fn(store, type_name, fields)
    let isolated_fn = build_isolated_fn(store, type_name, vtype_struct(type_name, 0))
    [store.stmts.add_leaf(impl_stmt), store.stmts.add_leaf(from_bytes_fn), store.stmts.add_leaf(isolated_fn)]
}

fn build_to_bytes_fn(store: NodeStore, fields: List<FieldEntry>) -> Stmt {
    // Body: return bytes_builder().write_X(self.f1).write_Y(self.f2)…finish()
    let chain = build_chain(store, fields)
    let body: List<StmtId> = [store.stmts.add_leaf(Stmt.Return(store.exprs.add_leaf(chain)))]
    let params: List<ParamEntry> = [ParamEntry { name: "self", vtype: ValueType.Unknown }]
    let empty_tp: List<TypeParamEntry> = []
    Stmt.Function("to_bytes", empty_tp, params, ValueType.Bytes, body)
}

/// `receiver.field` — the receiver is a synthesised boxed node, so it
/// must be allocated into the arena (FieldAccess holds an ExprId). One
/// place to remember the leaf-wrap, so a new access site can't drop it.
fn field_access(store: NodeStore, receiver: Expr, field: string) -> Expr {
    Expr.FieldAccess(store.exprs.add_leaf(receiver), field)
}

/// `callee(args)` — synthesise a flipped `Expr.Call`: the callee is
/// leaf-wrapped into the arena; each arg is already an `ExprId`.
fn mk_call(store: NodeStore, callee: Expr, args: List<ExprId>) -> Expr {
    Expr.Call(store.exprs.add_leaf(callee), args)
}

/// `receiver.method(args)` — the call wrapper over `field_access`.
fn method_call(store: NodeStore, receiver: Expr, method: string, args: List<ExprId>) -> Expr {
    mk_call(store, field_access(store, receiver, method), args)
}

fn build_chain(store: NodeStore, fields: List<FieldEntry>) -> Expr {
    // Qualified call so callers don't need `use bytes_builder`. The
    // resolver short-circuits on QualifiedIdent and binds straight
    // to @std::process. Bare Ident here would force every consumer
    // of @marshal to import the byte primitives explicitly.
    let start = mk_call(store, Expr.QualifiedIdent("@std::process::bytes_builder"), [])
    let written = chain_writes(store, start, fields, true)
    // Cap with `.finish()` so the chain produces a `bytes` value.
    method_call(store, written, "finish", [])
}

/// `from_self == true` references each field via `self.<name>`
/// (struct-method codegen); `false` references the bare `<name>`
/// binding (enum-variant codegen, where match-arm bindings expose
/// payload fields as local idents). Iterates source-order with a
/// mutable accumulator `base`, replacing the prior tail-recursive
/// cons walk.
fn chain_writes(store: NodeStore, base: Expr, fields: List<FieldEntry>, from_self: bool) -> Expr {
    mut acc = base
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        let value_expr = if from_self {
            field_access(store, Expr.Ident("self"), e.name)
        } else {
            Expr.Ident(e.name)
        }
        acc = write_one(store, acc, value_expr, e.resolved, e.name)
        i = i + 1
    }
    acc
}

/// Write one value of type `ty` into the builder expr `acc`, returning the new
/// builder expr. `uniq` seeds block-local variable names so sibling fields
/// don't collide. This is the single per-value write dispatch shared by struct
/// fields and enum-variant payloads; `Optional` recurses through it under a
/// presence flag, so an optional over any inner the table already handles
/// round-trips instead of being silently dropped.
fn write_one(store: NodeStore, acc: Expr, value_expr: Expr, ty: ValueType, uniq: string) -> Expr {
    // Optional (T?): a presence bool, then the inner value only when present.
    // An unsupported inner falls through to the shared skip below (no presence
    // byte written) so write/read stay symmetric — same lossy contract as an
    // unsupported non-optional field.
    match ty {
        .Optional(inner) -> {
            if codec_supported(inner) { return optional_write_block(store, acc, value_expr, inner, uniq) }
            return acc
        }
        _ -> {}
    }
    // Nested @marshal struct (nce6.1.C): the field's own to_bytes() returns a
    // `bytes` payload embedded length-prefixed via write_bytes. Emitted
    // optimistically — a missing inner to_bytes surfaces as a clear type error.
    if ty is .Struct {
        let inner_bytes = method_call(store, value_expr, "to_bytes", [])
        return method_call(store, acc, "write_bytes", [store.exprs.add_leaf(inner_bytes)])
    }
    // List<NestedMarshalStruct>: BytesBuilder has no generic write_struct_list,
    // so inline a for-loop block-expr that yields the builder for the chain.
    let list_struct = match ty {
        .List(elem) -> elem is .Struct
        _ -> false
    }
    if list_struct { return list_of_struct_block(store, acc, value_expr, uniq) }
    let writer = writer_for(ty)
    // Unsupported non-optional field type (writer == "") is skipped so the impl
    // still type-checks; round-trip stays lossy until the codec table extends.
    // Optional is handled above, so a supported inner is never silently dropped.
    if writer != "" { return method_call(store, acc, writer, [store.exprs.add_leaf(value_expr)]) }
    acc
}

/// `{ mut __ob_<u> = acc.write_bool(v != null); if v != null { __ob_<u> =
/// <write v! : inner> }; __ob_<u> }` — a presence bool, then (only when present)
/// the inner value written through the shared `write_one` dispatch. The block
/// yields the advanced builder so the enclosing chain continues naturally.
fn optional_write_block(store: NodeStore, acc: Expr, value_expr: Expr, inner: ValueType, uniq: string) -> Expr {
    let bvar = "__ob_" + uniq
    // mut __ob = acc.write_bool(v != null)
    let present_init = Expr.Binary(store.exprs.add_leaf(value_expr), BinOp.Ne, store.exprs.add_leaf(Expr.None))
    let init_call = method_call(store, acc, "write_bool", [store.exprs.add_leaf(present_init)])
    let init_stmt = Stmt.Mut(bvar, ValueType.Unknown, store.exprs.add_leaf(init_call))
    // if v != null { __ob = <write v! : inner> }
    let forced = mk_call(store, Expr.Ident(FORCE_UNWRAP_FN), [store.exprs.add_leaf(value_expr)])
    let inner_write = write_one(store, Expr.Ident(bvar), forced, inner, uniq)
    let assign = Stmt.Expr(store.exprs.add_leaf(Expr.Assign(bvar, store.exprs.add_leaf(inner_write))))
    let if_body_stmts: List<StmtId> = [store.stmts.add_leaf(assign)]
    let if_body = store.stmts.add_leaf(Stmt.Block(if_body_stmts))
    let present_cond = Expr.Binary(store.exprs.add_leaf(value_expr), BinOp.Ne, store.exprs.add_leaf(Expr.None))
    let if_stmt = Stmt.If(store.exprs.add_leaf(present_cond), if_body, null)
    // yield __ob
    let yield_stmt = Stmt.Expr(store.exprs.add_leaf(Expr.Ident(bvar)))
    let block_body: List<StmtId> = [store.stmts.add_leaf(init_stmt), store.stmts.add_leaf(if_stmt), store.stmts.add_leaf(yield_stmt)]
    Expr.Block(block_body)
}

/// Build a block-expr that returns a BytesBuilder after appending
/// every nested-struct element's `to_bytes()` payload to `base`:
///
///     {
///         mut __b_<n> = base.write_int(value_expr.length)
///         for __x_<n> in value_expr {
///             __b_<n> = __b_<n>.write_bytes(__x_<n>.to_bytes())
///         }
///         __b_<n>
///     }
///
/// The chained writer reuses this block-expr as its new base, so
/// downstream field writes append naturally. Unique-per-field
/// variable names keep multiple List<Struct> fields in the same
/// struct from colliding on the accumulator.
fn list_of_struct_block(store: NodeStore, base: Expr, value_expr: Expr, field_name: string) -> Expr {
    let bvar = "__b_" + field_name
    let xvar = "__x_" + field_name
    // mut __b_<n> = base.write_int(value_expr.length)
    let len_expr = field_access(store, value_expr, "length")
    let init_call = method_call(store, base, "write_int", [store.exprs.add_leaf(len_expr)])
    let init_stmt = Stmt.Mut(bvar, ValueType.Unknown, store.exprs.add_leaf(init_call))
    // body: __b_<n> = __b_<n>.write_bytes(__x_<n>.to_bytes())
    let x_to_bytes = method_call(store, Expr.Ident(xvar), "to_bytes", [])
    let new_b = method_call(store, Expr.Ident(bvar), "write_bytes", [store.exprs.add_leaf(x_to_bytes)])
    let assign_stmt = Stmt.Expr(store.exprs.add_leaf(Expr.Assign(bvar, store.exprs.add_leaf(new_b))))
    let assign_body: List<StmtId> = [store.stmts.add_leaf(assign_stmt)]
    let body = store.stmts.add_leaf(Stmt.Block(assign_body))
    let for_stmt = Stmt.ForIn(xvar, store.exprs.add_leaf(value_expr), body)
    let yield_stmt = Stmt.Expr(store.exprs.add_leaf(Expr.Ident(bvar)))
    let block_body: List<StmtId> = [store.stmts.add_leaf(init_stmt), store.stmts.add_leaf(for_stmt), store.stmts.add_leaf(yield_stmt)]
    Expr.Block(block_body)
}

fn writer_for(ty: ValueType) -> string {
    match ty {
        .Int -> "write_int"
        .Bool -> "write_bool"
        .Str -> "write_string"
        .Float -> "write_float"
        .List(elem) -> list_writer_for(elem)
        _ -> ""
    }
}

fn reader_for(ty: ValueType) -> string {
    match ty {
        .Int -> "read_int"
        .Bool -> "read_bool"
        .Str -> "read_string"
        .Float -> "read_float"
        .List(elem) -> list_reader_for(elem)
        _ -> ""
    }
}

/// nce6.1.B + extensions: List<T> codec. Pairs with @std/process's
/// per-element-type writers. List<NestedMarshalStruct> still
/// pending — needs a generic write_struct_list / read_struct_list
/// since @marshal can't synthesise generic methods on
/// @std/process's types.
fn list_writer_for(elem: ValueType) -> string {
    match elem {
        .Int -> "write_int_list"
        .Bool -> "write_bool_list"
        .Str -> "write_string_list"
        .Float -> "write_float_list"
        _ -> ""
    }
}

fn list_reader_for(elem: ValueType) -> string {
    match elem {
        .Int -> "read_int_list"
        .Bool -> "read_bool_list"
        .Str -> "read_string_list"
        .Float -> "read_float_list"
        _ -> ""
    }
}

/// True when the codec table can actually round-trip `ty` — i.e. write_one /
/// read_one emit real work and bind a value for it. Used to gate the Optional
/// paths so an optional over an UNSUPPORTED inner (e.g. `Map?`, `Tuple?`) falls
/// back to the same skip-and-default behavior as an unsupported non-optional
/// field, instead of emitting a presence-guarded read that binds nothing (which
/// would reference an unbound temp — a raw F3000 leaking a synthesised name).
/// For a non-optional `ty` this is equivalent to the prior
/// `reader_for(ty) != "" || ty is .Struct || list_of_struct_elem(ty)` binding
/// test (writer_for and reader_for share arms), so build_field_inits stays
/// byte-identical for every already-supported field type.
fn codec_supported(ty: ValueType) -> bool {
    match ty {
        .Optional(inner) -> codec_supported(inner)
        .Struct(_, _, _) -> true
        .List(elem) -> (elem is .Struct) || list_writer_for(elem) != ""
        _ -> writer_for(ty) != ""
    }
}

// ── from_bytes synthesis ──

/// Build `fn from_bytes(b: bytes) -> T { let r = bytes_reader(b); let (f1, r) = r.read_*(); … ; T { f1: f1, … } }`.
/// Reuses the `r` binding across reads (Avra's let-rebinding
/// shadows the outer `r`), keeping the body flat.
fn build_from_bytes_fn(store: NodeStore, type_name: string, fields: List<FieldEntry>) -> Stmt {
    // Param: b: bytes
    let params: List<ParamEntry> = [ParamEntry { name: "b", vtype: ValueType.Bytes }]
    // Body stmts:
    //   let r = bytes_reader(b)
    //   let (f1, r) = r.read_*()  -- per field (skipped if no reader)
    //   T { fields }
    // Qualified bytes_reader call — same reasoning as build_chain.
    // `mut r` because list-of-struct reads need to reassign the
    // cursor across loop iterations, and primitive reads thread
    // via explicit reassignment (avoids the let-shadow that
    // would hide the mut from inner scopes).
    let init_call = mk_call(store, Expr.QualifiedIdent("@std::process::bytes_reader"),
        [store.exprs.add_leaf(Expr.Ident("b"))])
    let init_let = Stmt.Mut("r", ValueType.Unknown, store.exprs.add_leaf(init_call))
    let reads_then_ctor = build_reads_and_ctor(store, type_name, fields)
    mut body: List<StmtId> = [store.stmts.add_leaf(init_let)]
    mut bi = 0
    while bi < reads_then_ctor.length {
        body.push(reads_then_ctor[bi])
        bi = bi + 1
    }
    // Top-level fn named `from_bytes_<T>` (no static-method syntax
    // in Avra). nce6.1.E will route generic `isolated<T: Marshal>`
    // through this naming convention.
    let fn_name = marshal_artifact_name("from_bytes_", type_name)
    let empty_tp: List<TypeParamEntry> = []
    Stmt.Function(fn_name, empty_tp, params,
        vtype_struct(type_name, 0), body)
}

/// Builds the per-field read sequence followed by the final
/// struct-literal constructor. Both parts are emitted as one
/// List<StmtId> because the reader has to thread `r` through every
/// step and produce the value at the end.
fn build_reads_and_ctor(store: NodeStore, type_name: string, fields: List<FieldEntry>) -> List<StmtId> {
    let reads = build_reads(store, fields)
    let ctor = build_ctor(store, type_name, fields)
    let tail: List<StmtId> = [store.stmts.add_leaf(Stmt.Return(store.exprs.add_leaf(ctor)))]
    append_ids(reads, tail)
}

fn build_reads(store: NodeStore, fields: List<FieldEntry>) -> List<StmtId> {
    // Indexed walk produces the per-field read sequences and
    // concatenates them into a single row list — source order preserved.
    mut out: List<StmtId> = []
    mut i = 0
    while i < fields.length {
        out = append_ids(out, read_one(store, fields[i].name, fields[i].resolved))
        i = i + 1
    }
    out
}

/// Emit the read sequence that binds `name` to a value of type `ty`, threading
/// the `mut r` cursor. Shared by struct fields and enum-variant payloads;
/// `Optional` recurses through it under a presence flag. An unsupported
/// non-optional type emits nothing (lossy) so the impl still compiles.
fn read_one(store: NodeStore, name: string, ty: ValueType) -> List<StmtId> {
    let empty: List<StmtId> = []
    match ty {
        // Optional (T?): presence bool, then the inner value only when present.
        // An unsupported inner skips entirely (empty) so it stays symmetric with
        // the write side, which writes no presence byte for it.
        .Optional(inner) -> if codec_supported(inner) { optional_read_stmts(store, name, inner) } else { empty }
        // Nested @marshal struct (nce6.1.C): emit three stmts.
        //   let (__nested_<n>, __r_<n>) = r.read_bytes()
        //   r = __r_<n>
        //   let <n> = from_bytes_<InnerT>(__nested_<n>)
        .Struct(inner_name, _, _) -> {
            let stmts = read_then_reassign(store, name, "__nested_" + name, "read_bytes")
            let from_bytes_call = mk_call(store, Expr.Ident(marshal_artifact_name("from_bytes_", inner_name)),
                [store.exprs.add_leaf(Expr.Ident("__nested_" + name))])
            let bind_stmt = Stmt.Let(name, ValueType.Unknown, store.exprs.add_leaf(from_bytes_call))
            let tail: List<StmtId> = [store.stmts.add_leaf(bind_stmt)]
            append_ids(stmts, tail)
        }
        .List(elem) -> {
            if elem is .Struct {
                list_of_struct_reads(store, name, elem)
            } else {
                let reader = reader_for(ty)
                if reader == "" { empty } else { read_then_reassign(store, name, name, reader) }
            }
        }
        _ -> {
            let reader = reader_for(ty)
            // Unsupported field type (reader == "") skips the read so the impl
            // still compiles; round-trip is lossy until the codec table extends.
            if reader == "" { empty } else { read_then_reassign(store, name, name, reader) }
        }
    }
}

/// Read an optional (T?): a presence bool, then the inner value only when
/// present.
///   let (__present_<f>, r) = r.read_bool(); r = ...
///   mut <f>: <inner>? = null
///   if __present_<f> { <read inner -> __someval_<f>>; <f> = __someval_<f> }
/// The inner read reuses `read_one`, binding a temp we then assign into the
/// annotated nullable slot (so widening `inner` -> `inner?` type-checks).
fn optional_read_stmts(store: NodeStore, field_name: string, inner: ValueType) -> List<StmtId> {
    let present = "__present_" + field_name
    let presence = read_then_reassign(store, "present_" + field_name, present, "read_bool")
    // mut <f>: inner? = null — annotated so the later `= inner` widens cleanly.
    let init_stmt = Stmt.Mut(field_name, ValueType.Optional(inner), store.exprs.add_leaf(Expr.None))
    // if __present_<f> { <read inner -> tmp>; <f> = tmp }
    let tmp = "__someval_" + field_name
    let inner_read = read_one(store, tmp, inner)
    let assign = Stmt.Expr(store.exprs.add_leaf(Expr.Assign(field_name, store.exprs.add_leaf(Expr.Ident(tmp)))))
    let assign_tail: List<StmtId> = [store.stmts.add_leaf(assign)]
    let if_body_stmts = append_ids(inner_read, assign_tail)
    let if_body = store.stmts.add_leaf(Stmt.Block(if_body_stmts))
    let if_stmt = Stmt.If(store.exprs.add_leaf(Expr.Ident(present)), if_body, null)
    let trailer: List<StmtId> = [store.stmts.add_leaf(init_stmt), store.stmts.add_leaf(if_stmt)]
    append_ids(presence, trailer)
}

/// Emit `let (<value_name>, __r_<n>) = r.<reader>(); r = __r_<n>`
/// — extracts a value AND advances the cursor explicitly. The
/// explicit reassignment lets list-of-struct loops + while-loops
/// inside the same fn body share `mut r` without let-shadow
/// hiding the mut.
fn read_then_reassign(store: NodeStore, field_name: string, value_name: string, reader: string) -> List<StmtId> {
    let r_next = "__r_" + field_name
    let read_call = method_call(store, Expr.Ident("r"), reader, [])
    let destruct_names: List<ParamEntry> = [
        ParamEntry { name: value_name, vtype: ValueType.Unknown },
        ParamEntry { name: r_next, vtype: ValueType.Unknown },
    ]
    let destruct_stmt = Stmt.LetDestructure(destruct_names, store.exprs.add_leaf(read_call))
    let reassign_stmt = Stmt.Expr(store.exprs.add_leaf(Expr.Assign("r", store.exprs.add_leaf(Expr.Ident(r_next)))))
    [store.stmts.add_leaf(destruct_stmt), store.stmts.add_leaf(reassign_stmt)]
}

/// Synthesise the read sequence for a `field: List<NestedStruct>`:
///
///     let (__count_<n>, r) = r.read_int()
///     mut __acc_<n>: List<Inner> = []
///     mut __i_<n> = 0
///     while __i_<n> < __count_<n> {
///         let (__raw_<n>, r2) = r.read_bytes()
///         __acc_<n> = __acc_<n>.push(from_bytes_<Inner>(__raw_<n>))
///         r = r2
///         __i_<n> = __i_<n> + 1
///     }
///     let <n> = __acc_<n>
///
/// `<Inner>` is read off the .Struct(name, _) of the elem type.
fn list_of_struct_reads(store: NodeStore, field_name: string, elem: ValueType) -> List<StmtId> {
    let inner_name = match elem {
        .Struct(n, _, _) -> n
        _ -> ""
    }
    let cname = "__count_" + field_name
    let aname = "__acc_" + field_name
    let iname = "__i_" + field_name
    let rname = "__r2_" + field_name
    let rawname = "__raw_" + field_name

    // Count read using explicit-reassign pattern — keeps `r`'s
    // mut binding visible inside the while-loop below.
    let count_stmts = read_then_reassign(store, "listcount_" + field_name, cname, "read_int")

    // mut __acc: List<Inner> = []
    let acc_init = Expr.ListLit([])
    let acc_stmt = Stmt.Mut(aname, ValueType.List(vtype_struct(inner_name, 0)), store.exprs.add_leaf(acc_init))

    // mut __i = 0
    let i_stmt = Stmt.Mut(iname, ValueType.Int, store.exprs.add_leaf(Expr.Number("0")))

    // while __i < __count { ... }
    let cond = Expr.Binary(store.exprs.add_leaf(Expr.Ident(iname)), BinOp.Lt, store.exprs.add_leaf(Expr.Ident(cname)))
    // let (__raw, __r2) = r.read_bytes()
    let raw_read = method_call(store, Expr.Ident("r"), "read_bytes", [])
    let raw_names: List<ParamEntry> = [
        ParamEntry { name: rawname, vtype: ValueType.Unknown },
        ParamEntry { name: rname, vtype: ValueType.Unknown },
    ]
    let raw_stmt = Stmt.LetDestructure(raw_names, store.exprs.add_leaf(raw_read))
    // __acc = __acc.push(from_bytes_<Inner>(__raw))
    let from_call = mk_call(store, Expr.Ident(marshal_artifact_name("from_bytes_", inner_name)),
        [store.exprs.add_leaf(Expr.Ident(rawname))])
    let push_call = method_call(store, Expr.Ident(aname), "push", [store.exprs.add_leaf(from_call)])
    let acc_assign = Stmt.Expr(store.exprs.add_leaf(Expr.Assign(aname, store.exprs.add_leaf(push_call))))
    // r = __r2
    let r_assign = Stmt.Expr(store.exprs.add_leaf(Expr.Assign("r", store.exprs.add_leaf(Expr.Ident(rname)))))
    // __i = __i + 1
    let i_inc = Stmt.Expr(store.exprs.add_leaf(Expr.Assign(iname,
        store.exprs.add_leaf(Expr.Binary(store.exprs.add_leaf(Expr.Ident(iname)), BinOp.Add, store.exprs.add_leaf(Expr.Number("1")))))))

    let loop_body_stmts: List<StmtId> = [
        store.stmts.add_leaf(raw_stmt),
        store.stmts.add_leaf(acc_assign),
        store.stmts.add_leaf(r_assign),
        store.stmts.add_leaf(i_inc),
    ]
    let loop_body = store.stmts.add_leaf(Stmt.Block(loop_body_stmts))
    let while_stmt = Stmt.While(store.exprs.add_leaf(cond), loop_body)

    // let <field_name> = __acc
    let bind_stmt = Stmt.Let(field_name, ValueType.Unknown, store.exprs.add_leaf(Expr.Ident(aname)))

    let trailer: List<StmtId> = [
        store.stmts.add_leaf(acc_stmt),
        store.stmts.add_leaf(i_stmt),
        store.stmts.add_leaf(while_stmt),
        store.stmts.add_leaf(bind_stmt),
    ]
    append_ids(count_stmts, trailer)
}

/// Build the final `T { f1: f1, f2: f2, … }` constructor.
fn build_ctor(store: NodeStore, type_name: string, fields: List<FieldEntry>) -> Expr {
    Expr.StructLit(type_name, build_field_inits(store, fields))
}

fn build_field_inits(store: NodeStore, fields: List<FieldEntry>) -> List<FieldInit> {
    // List<FieldInit>.push appends forward — walk source order.
    mut out: List<FieldInit> = []
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        let name = e.name
        let ty = e.resolved
        // The field has a local binding by the same name iff build_reads
        // emitted a read for it — exactly when the codec supports the type
        // (primitive, nested Struct, List<T>, or an Optional over any of those).
        // Unsupported types get no read, so the ctor falls back to a default.
        let init_expr = if codec_supported(ty) {
            Expr.Ident(name)
        } else {
            // Field type wasn't read; placeholder initializer
            // keeps the struct-literal complete until follow-up
            // sub-tickets land. Lossy round-trip for this field
            // is documented at the field-type dispatch in
            // chain_writes / build_reads.
            default_for(ty)
        }
        out.push(FieldInit { name, value_id: store.exprs.add_leaf(init_expr) })
        i = i + 1
    }
    out
}

/// Return a zero-ish initializer expression matching `ty` so the
/// synthesised struct literal type-checks for un-marshaled
/// fields. List<T>/nested-struct fields produce `[]`-style
/// placeholders; the lossy-round-trip note in build_field_inits
/// applies.
fn default_for(ty: ValueType) -> Expr {
    if ty is .Int { return Expr.Number("0") }
    if ty is .Bool { return Expr.Bool("false") }
    if ty is .Str { return Expr.String("\"\"") }
    if ty is .Float { return Expr.FloatLit("0.0") }
    if ty is .List { return Expr.ListLit([]) }
    // Fallback — `null` covers nullable / reference shapes; gets
    // tightened as the codec table expands.
    Expr.None
}

/// True when `ty` is `List<NestedMarshalStruct>` — i.e. a list
/// whose element type is itself a struct. Used to gate the
/// list-of-struct read/write block-synthesis paths.
fn list_of_struct_elem(ty: ValueType) -> bool {
    match ty {
        .List(elem) -> elem is .Struct
        _ -> false
    }
}

fn append_ids(a: List<StmtId>, b: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    mut i = 0
    while i < a.length {
        out.push(a[i])
        i = i + 1
    }
    mut j = 0
    while j < b.length {
        out.push(b[j])
        j = j + 1
    }
    out
}

// ── Enum support (nce6.1.D) ──

/// Synthesise `impl T { fn to_bytes(self) -> bytes }` +
/// `fn from_bytes_T(b: bytes) -> T` for an `@marshal enum T { ... }`.
///
/// Wire format: 8-byte tag (variant index) + concatenated payload
/// fields (using the same per-type writers as struct fields). Tag
/// ordering matches source order so adding a variant at the end
/// stays backwards-compatible — inserting in the middle does not.
fn derive_enum_stmts(store: NodeStore, type_name: string, variants: List<Variant>) -> List<StmtId> {
    let to_bytes_fn = build_enum_to_bytes_fn(store, type_name, variants)
    let methods: List<StmtId> = [store.stmts.add_leaf(to_bytes_fn)]
    // Cleanup #1: same `impl Marshal for T` form for enums.
    let impl_stmt = Stmt.Impl("@std::process::Marshal:" + type_name, methods)
    let from_bytes_fn = build_enum_from_bytes_fn(store, type_name, variants)
    let empty_args: List<ValueType> = []
    let isolated_fn = build_isolated_fn(store, type_name,
        ValueType.Enum(type_name, empty_args, 0))
    [store.stmts.add_leaf(impl_stmt), store.stmts.add_leaf(from_bytes_fn), store.stmts.add_leaf(isolated_fn)]
}

fn build_enum_to_bytes_fn(store: NodeStore, type_name: string, variants: List<Variant>) -> Stmt {
    let arms = build_variant_arms(store, variants)
    // Flipped MatchExpr.subject is an ExprId — ingest the subject leaf first.
    let match_expr = Expr.MatchExpr(store.exprs.add_leaf(Expr.Ident("self")), arms)
    let body: List<StmtId> = [store.stmts.add_leaf(Stmt.Return(store.exprs.add_leaf(match_expr)))]
    let params: List<ParamEntry> = [ParamEntry { name: "self", vtype: ValueType.Unknown }]
    let empty_tp: List<TypeParamEntry> = []
    Stmt.Function("to_bytes", empty_tp, params, ValueType.Bytes, body)
}

/// Per-variant match arms for to_bytes. Tag = source-order index;
/// each arm builds a bytes_builder().write_int(tag).<payload>.finish()
/// chain. Builds the cons-list back-to-front so source order is
/// preserved when read head-first.
fn build_variant_arms(store: NodeStore, variants: List<Variant>) -> List<MatchArm> {
    // List<MatchArm>.push appends forward — walk source order, no
    // reversal needed.
    mut out: List<MatchArm> = []
    for (i, v) in variants.enumerate() {
        let bindings = field_list_to_param_list(v.fields)
        let pattern = Pattern.Variant(v.name, bindings)
        let chain = build_variant_write_chain(store, i, v.fields)
        out.push(MatchArm { pattern, guard_id: null, body_id: store.exprs.add_leaf(chain) })
    }
    out
}

fn field_list_to_param_list(fields: List<FieldEntry>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < fields.length {
        out.push(ParamEntry { name: fields[i].name, vtype: ValueType.Unknown })
        i = i + 1
    }
    out
}

/// Build bytes_builder().write_int(<tag>).<payload-writes>.finish()
/// for a single variant. Payload fields reference the
/// match-arm-bound idents (no `self.` prefix — they're locals).
fn build_variant_write_chain(store: NodeStore, tag: int, payload: List<FieldEntry>) -> Expr {
    let tag_arg: List<ExprId> = [store.exprs.add_leaf(Expr.Number(string(tag)))]
    let start = mk_call(store, Expr.QualifiedIdent("@std::process::bytes_builder"), [])
    let with_tag = method_call(store, start, "write_int", tag_arg)
    // Variant payloads are match-arm bindings (local idents),
    // hence from_self=false. Reuses the same codec table as
    // struct fields via the shared chain_writes.
    let with_payload = chain_writes(store, with_tag, payload, false)
    method_call(store, with_payload, "finish", [])
}

/// fn from_bytes_<T>(b: bytes) -> T {
///   let r = bytes_reader(b)
///   let (tag, r) = r.read_int()
///   if tag == 0 { … return T.Variant0(…) }
///   if tag == 1 { … return T.Variant1(…) }
///   … last variant returned without an if-guard …
/// }
fn build_enum_from_bytes_fn(store: NodeStore, type_name: string, variants: List<Variant>) -> Stmt {
    let params: List<ParamEntry> = [ParamEntry { name: "b", vtype: ValueType.Bytes }]
    let init_call = mk_call(store, Expr.QualifiedIdent("@std::process::bytes_reader"),
        [store.exprs.add_leaf(Expr.Ident("b"))])
    let init_let = Stmt.Mut("r", ValueType.Unknown, store.exprs.add_leaf(init_call))
    // Tag read uses the new explicit-reassign pattern so the
    // mut r binding stays visible to the variant payload reads.
    let tag_reads = read_then_reassign(store, "tag", "tag", "read_int")
    let dispatch = build_enum_dispatch(store, type_name, variants)
    let init_part: List<StmtId> = [store.stmts.add_leaf(init_let)]
    let body = append_ids(init_part, append_ids(tag_reads, dispatch))
    let fn_name = marshal_artifact_name("from_bytes_", type_name)
    let empty_tp: List<TypeParamEntry> = []
    let empty_args: List<ValueType> = []
    Stmt.Function(fn_name, empty_tp, params,
        ValueType.Enum(type_name, empty_args, 0), body)
}

/// Cascade of `if tag == N { build variant }` stmts. The final
/// variant returns unconditionally — the type-checker enforces
/// total return coverage. Indexed walk over `variants`; builds the
/// List<StmtId> in source order.
fn build_enum_dispatch(store: NodeStore, type_name: string, variants: List<Variant>) -> List<StmtId> {
    mut out: List<StmtId> = []
    let n = variants.length
    mut i = 0
    while i < n {
        let v = variants[i]
        let read_payload_stmts = build_reads(store, v.fields)
        let ctor = build_enum_ctor(store, type_name, v.name, v.fields)
        let ret_stmt = Stmt.Return(store.exprs.add_leaf(ctor))
        let ret_tail: List<StmtId> = [store.stmts.add_leaf(ret_stmt)]
        let block_body = append_ids(read_payload_stmts, ret_tail)
        let is_last = i == n - 1
        let head_stmt: List<StmtId> = if is_last {
            // Final variant: emit the read+return body unguarded —
            // the cascade above narrowed everything but the last tag
            // away. Splicing the body directly avoids an unreachable
            // final `if`.
            block_body
        } else {
            let tag_lit = Expr.Number(string(i))
            let cmp = Expr.Binary(store.exprs.add_leaf(Expr.Ident("tag")), BinOp.Eq, store.exprs.add_leaf(tag_lit))
            let then_block = store.stmts.add_leaf(Stmt.Block(block_body))
            let if_stmt = Stmt.If(store.exprs.add_leaf(cmp), then_block, null)
            [store.stmts.add_leaf(if_stmt)]
        }
        out = append_ids(out, head_stmt)
        i = i + 1
    }
    out
}

// build_variant_reads was identical to build_reads — both read a
// FieldList field-by-field, threading the `r` reader, recursing
// into nested @marshal structs via from_bytes_<T>. Collapsed into
// build_reads (struct & enum-variant payload share the same read
// shape since match-arm bindings produce the same locals).

fn build_enum_ctor(store: NodeStore, type_name: string, variant: string, payload: List<FieldEntry>) -> Expr {
    Expr.EnumCtor(type_name, variant, field_list_to_arg_list(store, payload))
}

fn field_list_to_arg_list(store: NodeStore, payload: List<FieldEntry>) -> List<ExprId> {
    mut out: List<ExprId> = []
    mut i = 0
    while i < payload.length {
        out.push(store.exprs.add_leaf(Expr.Ident(payload[i].name)))
        i = i + 1
    }
    out
}

// ── isolated_<T>(body) synthesis (nce6.1.E) ──

/// Synthesise:
///   fn isolated_<T>(body: fn() -> T) -> Result<T, IsolatedError> {
///       match isolated_bytes(() -> body().to_bytes()) {
///           .Ok(b) -> Result.Ok(from_bytes_<T>(b))
///           .Err(e) -> Result.Err(e)
///       }
///   }
///
/// Per-T pragmatic shortcut for what would be a generic
/// `isolated<T: Marshal>(body)` if Avra had trait-bound generics
/// today. Each @marshal-annotated type gets its own
/// monomorphic `isolated_<T>` wrapper alongside to_bytes /
/// from_bytes_<T>; the user-facing DX is identical to a generic
/// trait-bound version.
fn build_isolated_fn(store: NodeStore, type_name: string, ty: ValueType) -> Stmt {
    // Param: body: fn() -> T
    let no_params: List<ValueType> = []
    let body_param_ty = ValueType.FnTyped(no_params, ty)
    let params: List<ParamEntry> = [ParamEntry { name: "body", vtype: body_param_ty }]
    // Result<T, IsolatedError> as the return type. Resolver
    // upgrades the bare Enum form once IsolatedError is bound.
    let isolated_empty_args: List<ValueType> = []
    let isolated_err_ty = ValueType.Enum("IsolatedError", isolated_empty_args, 0)
    mut result_type_args: List<ValueType> = []
    result_type_args.push(ty)
    result_type_args.push(isolated_err_ty)
    let ret_ty = ValueType.Enum("Result", result_type_args, 0)
    // Inner closure: () -> body().to_bytes()
    let body_call = mk_call(store, Expr.Ident("body"), [])
    let to_bytes_call = method_call(store, body_call, "to_bytes", [])
    let empty_lp: List<ParamEntry> = []
    // Flipped Lambda.body is an ExprId — ingest the body leaf.
    let inner_closure = Expr.Lambda(empty_lp, store.exprs.add_leaf(to_bytes_call))
    // Subject: @std::process::isolated_bytes(closure). Qualified
    // so consumers of @marshal don't need to `use isolated_bytes`
    // — only types that actually fork pay the import cost (via
    // their own use of `isolated_<T>` somewhere reachable).
    let isolated_call = mk_call(store, Expr.QualifiedIdent("@std::process::isolated_bytes"),
        [store.exprs.add_leaf(inner_closure)])
    // Ok arm: Result.Ok(from_bytes_<T>(b))
    let from_bytes_call = mk_call(store, Expr.Ident(marshal_artifact_name("from_bytes_", type_name)),
        [store.exprs.add_leaf(Expr.Ident("b"))])
    let ok_body = Expr.EnumCtor("Result", "Ok",
        [store.exprs.add_leaf(from_bytes_call)])
    let ok_bindings: List<ParamEntry> = [ParamEntry { name: "b", vtype: ValueType.Unknown }]
    let ok_pattern = Pattern.Variant("Ok", ok_bindings)
    // Err arm: Result.Err(e) — pass-through
    let err_body = Expr.EnumCtor("Result", "Err",
        [store.exprs.add_leaf(Expr.Ident("e"))])
    let err_bindings: List<ParamEntry> = [ParamEntry { name: "e", vtype: ValueType.Unknown }]
    let err_pattern = Pattern.Variant("Err", err_bindings)
    mut arms: List<MatchArm> = []
    arms.push(MatchArm { pattern: ok_pattern, guard_id: null, body_id: store.exprs.add_leaf(ok_body) })
    arms.push(MatchArm { pattern: err_pattern, guard_id: null, body_id: store.exprs.add_leaf(err_body) })
    let match_expr = Expr.MatchExpr(store.exprs.add_leaf(isolated_call), arms)
    let body_stmts: List<StmtId> = [store.stmts.add_leaf(Stmt.Return(store.exprs.add_leaf(match_expr)))]
    let fn_name = marshal_artifact_name("isolated_", type_name)
    let empty_tp: List<TypeParamEntry> = []
    Stmt.Function(fn_name, empty_tp, params, ret_ty, body_stmts)
}

