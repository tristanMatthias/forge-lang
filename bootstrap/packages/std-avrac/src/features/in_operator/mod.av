// dir-as-module (g2eo.1): codegen.av + lowering/ auto-load as siblings,
// surface flat at `features.in_operator.{...}`.
use core.{ExprId}
use features.in_operator.codegen.{emit_in_check}
use typeck.{check_expr, check_expr_list, tc_er}
use features.grammar.{parse_grammar, GramFamily}

/// `x in [1, 2, 3]` / `n in 0..10` — membership tests (produce Bool).
/// The definition carries `in_tail` (one branch of the spine's `eq_tail`
/// dispatch) and its `in_rhs` sub-rule (t-kd4y.3.5.7): the list form
/// builds a PARTIAL `InCheck`, the range form the `>= s && <= e` desugar
/// with MISSING sentinels — the `equality` stratum's rebind_eq
/// (features/struct_decl) installs the real subject into either shape.
/// `gram_family = GramFamily.Expr`.
@language_feature
export fn in_operator_lang() -> LanguageFeature {
    LanguageFeature in_operator_def {
        name = "in",
        title = "in — membership tests",
        docs = """
`x in [a, b, c]` is true when `x` equals any listed value; `n in s..e`
tests an inclusive range: it is true when `n >= s && n <= e`. Mutually
exclusive with `==` chains and `is` at the same precedence.
""",
        gram = grammar {
  in_tail = "in" ir:in_rhs -> ir
  in_rhs  = "[" ( a:expression ( "," a:expression )* )? "]" -> mk_inlist(a)
          | s:bitor @require ".." e:bitor
            @expect("..", "expected `..` in range expression after `in`") -> mk_inrange(s, e)
        },
        snippet = r"${1:value} in ${2:collection}",
        expr_tag = Expr.InCheck(ExprId(0), []),
        emit_expr = emit_in_check,
        resolve_expr = in_resolve,
        check_expr = in_check,
        gram_family = GramFamily.Expr,
    }
    in_operator_def
}

/// Type-check hook for `InCheck`. Walks the needle and items so
/// their errors are reported, then declares the result Bool.
fn in_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .InCheck(needle, items) -> {
            let s = check_expr(tc, tc.nodes.exprs.get(needle))
            let s2 = check_expr_list(s.tc, items)
            tc_er(s2, .Bool)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
