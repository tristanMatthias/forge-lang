// The `in` feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Expr}
use resolve.{Resolver, resolve_expr, resolve_expr_list_ids}

/// Resolver hook for `InCheck`. Recurses into the needle and the
/// items list so any names they reference get resolved.
fn in_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .InCheck(needle, items) -> {
            let r2 = resolve_expr(r, r.nodes.exprs.get(needle))
            resolve_expr_list_ids(r2, items)
        }
        _ -> r
    }
}
