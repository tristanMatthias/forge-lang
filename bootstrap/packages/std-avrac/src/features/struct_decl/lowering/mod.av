// The struct_decl feature's LOWERINGS — the type/shape declaration cores +
// their ABI adapters + manifest rows (t-kd4y.3.3.2). This module imports
// ONLY features.grammar + core — the F4012 import-closure invariant holds
// by construction.
//
// The fragment (../grammar.av) spells THREE builds and this manifest
// carries exactly those: MkTypeDeclAny/6 (every `type` RHS in one core),
// MkShapeDecl/2, and MkField/2 (the `field` rule lives in this fragment —
// enum's `variant` references it cross-fragment, which binds by name and
// needs no row here). The §2 oracle-era MkTypeDecl/2 and /3,
// MkTypeAlias/2, and MkTypeRHS/4 arms were DELETED with the flip (the
// convenience purity move): every toy re-points at MkTypeDeclAny/6 with
// Nil-padded captures, which reproduce each retired arm's exact
// empty-list/absent-flag defaults — and give the alias toys the
// production TypeRef edge the leaf-building MkTypeAlias arm dropped.
use core.{Expr, ExprId, FieldEntry, FieldInit, NodeEdges, NodeRef, Stmt, Token, TypeParamEntry, ValueType, byte_span, byte_span_none, type_expr_to_vtype}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_present, capval_to_expr, capval_to_field_list, capval_to_finit_list, capval_to_node_list, capval_to_texpr, capval_to_tparam_list, capval_tok_list, capval_tok_text}

/// The WHOLE `type Name < tp > = …` declaration — every form the retired
/// hand's `parse_type_declaration` produces, in one core, because the hand
/// itself decides between them AFTER parsing the right-hand side and a
/// grammar cannot branch on a parse RESULT.
///
/// Four outcomes, in the hand's own order:
///   `= { field* }`               Stmt.TypeDecl        (fields captured, no alias)
///   `= A | B`                    Stmt.UnionAliasDecl  (the TypeExpr came back .Union)
///   `= Base without { f, g }`    Stmt.TypeDecl with a SYNTHETIC field list
///   `= OtherType`                Stmt.NewtypeDecl     (the nominal wrapper)
///
/// The grammar reaches this with the brace form and the alias form as two
/// OPTIONAL groups rather than two alternation branches: they are
/// FIRST-disjoint after the `=` (`{` versus IDENT / `fn` / `[`), so exactly
/// one fires.
///
/// The `without` / `only` shape is CODEGEN-COUPLED: codegen/setup.av's
/// `resolve_type_operator` walks exactly `__base`, then `__without` /
/// `__only`, then the user's field names. The marker is `"__" + op`.
///
/// Both alias outcomes carry a `NodeRef.TypeRef` over an INGESTED type — a
/// leaf node here would drop the walker's only child.
export fn mk_type_decl_any(st: PState, name: string, tps: List<TypeParamEntry>, fields: List<FieldEntry>, alias_cv: CapVal, has_alias: bool, op_cv: CapVal, has_op: bool, opf: List<Token>) -> CapVal {
    if !has_alias {
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.TypeDecl(name, tps, fields)))
    }
    let te = capval_to_texpr(st, alias_cv)
    let vt = type_expr_to_vtype(te)
    if has_op {
        // `type X = Base without { a, b }` — the synthetic FieldEntry list codegen reads.
        mut derived: List<FieldEntry> = []
        derived.push(FieldEntry { name: "__base", resolved: vt })
        derived.push(FieldEntry { name: "__" + capval_tok_text(op_cv), resolved: ValueType.Str })
        for t in opf { derived.push(FieldEntry { name: t.text, resolved: ValueType.Unknown }) }
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.TypeDecl(name, tps, derived)))
    }
    let ty_id = st.store.ingest_type(vt, byte_span_none())
    match te {
        .Union(_, _) -> CapVal.SNode(st.store.stmts.add(Stmt.UnionAliasDecl(name, vt), NodeEdges { refs: [NodeRef.TypeRef(ty_id)] }, byte_span_none()))
        _ -> CapVal.SNode(st.store.stmts.add(Stmt.NewtypeDecl(name, vt), NodeEdges { refs: [NodeRef.TypeRef(ty_id)] }, byte_span_none()))
    }
}

export fn mk_type_decl_any_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_type_decl_any(st, capval_tok_text(vals[0]), capval_to_tparam_list(vals[1]), capval_to_field_list(vals[2]), vals[3], capval_present(vals[3]), vals[4], capval_present(vals[4]), capval_tok_list(vals[5]))
}

/// `shape Name = { field* }` — the STRUCTURAL sibling. No type params:
/// the retired `parse_shape_declaration` had none, unlike every other
/// decl keyword.
export fn mk_shape_decl(st: PState, name: string, fields: List<FieldEntry>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.ShapeDecl(name, fields)))
}

export fn mk_shape_decl_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_shape_decl(st, capval_tok_text(vals[0]), capval_to_field_list(vals[1]))
}

/// `name : type` — a struct/variant field (the `MkField` build's core).
export fn mk_field(st: PState, name: string, ftype: CapVal) -> CapVal {
    CapVal.Field(FieldEntry { name: name, resolved: type_expr_to_vtype(capval_to_texpr(st, ftype)) })
}

export fn mk_field_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_field(st, capval_tok_text(vals[0]), vals[1])
}

/// ALL of the type/shape feature's rows — span-free (leaf or
/// byte_span_none rows; the statement-list loop stamps the outermost node).
export fn type_decl_builds() -> List<BuilderBind> {
    bind_rows("features.struct_decl.lowering", [bind_row("MkTypeDeclAny", "stmt", 6, false, "mk_type_decl_any_abi", mk_type_decl_any_abi),
     bind_row("MkShapeDecl", "stmt", 2, false, "mk_shape_decl_abi", mk_shape_decl_abi),
     bind_row("MkField", "field", 2, false, "mk_field_abi", mk_field_abi)])
}

/// Build ONE struct field-init (the `MkFieldInit` build's core — the
/// `field_init` rule lives in struct_lit_lang's fragment; qualified_expr,
/// with_suffix, and the unary splice-struct branch reference it
/// cross-fragment by name). `name: value`, or the SHORTHAND `name` (no
/// `:`) which expands to `name: Expr.Ident(name)` — so an absent value
/// must allocate that ident leaf, exactly as the retired hand
/// `alloc_leaf(Expr.Ident(name))` did.
export fn mk_field_init(st: PState, name_cv: CapVal, value_cv: CapVal) -> CapVal {
    let name = capval_tok_text(name_cv)
    let value_id = match value_cv {
        .Nil -> st.store.exprs.add_leaf(Expr.Ident(name))
        _ -> capval_to_expr(st, value_cv)
    }
    CapVal.FInit(FieldInit { name, value_id })
}

export fn mk_field_init_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_field_init(st, vals[0], vals[1])
}

/// `Name { f: v, … }` — a plain (unqualified) STRUCT LITERAL. The nominal
/// sibling of mk_qualified's struct-literal half: same `Expr.StructLit`
/// payload and the same finit decoding, with the name taken from one
/// IDENT. No `lb` capture to distinguish an EMPTY literal from a bare
/// ident, because the two are separate grammar branches: this builder is
/// reached only when the `{` was actually matched, so `Name {}` is still
/// a StructLit with an empty field list.
export fn mk_struct_lit(st: PState, sp_start: int, ncap: CapVal, fcap: CapVal) -> ExprId {
    st.store.add_expr(Expr.StructLit(capval_tok_text(ncap), capval_to_finit_list(fcap)), byte_span(sp_start, st.cur().pos), [])
}

export fn mk_struct_lit_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_struct_lit(st, st.build_sp, vals[0], vals[1]))
}

/// Contextual enum constructor `.Variant` / `.Variant(args)` — the EMPTY
/// enum name is the contextual marker (the enum is inferred from the
/// expected type). `acap` is the optional args list (Nil ⇒ nullary).
/// Spanned at the `.` byte; sp_start < 0 is the interpreter's span-free
/// sentinel.
export fn mk_enum_ctor_expr(st: PState, sp_start: int, vcap: CapVal, acap: CapVal) -> ExprId {
    let variant = capval_tok_text(vcap)
    let args = capval_to_node_list(acap)
    let sp = byte_span(sp_start, st.cur().pos)
    st.store.add_expr(Expr.EnumCtor("", variant, args), sp, [])
}

export fn mk_enum_ctor_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_enum_ctor_expr(st, st.build_sp, vals[0], vals[1]))
}

/// The struct-LITERAL family's rows (t-kd4y.3.5.6): the literal is
/// spanned at its rule entry (the name IDENT); the field-init is a
/// span-free FInit value.
export fn struct_lit_builds() -> List<BuilderBind> {
    bind_rows("features.struct_decl.lowering", [bind_row("MkStructLit", "expr", 2, true, "mk_struct_lit_abi", mk_struct_lit_abi),
     bind_row("MkFieldInit", "finit", 2, false, "mk_field_init_abi", mk_field_init_abi)])
}

/// The contextual enum-ctor row (t-kd4y.3.5.6) — spanned at the `.` byte.
export fn enum_ctor_builds() -> List<BuilderBind> {
    bind_rows("features.struct_decl.lowering", [bind_row("mk_enum_ctor", "expr", 2, true, "mk_enum_ctor_abi", mk_enum_ctor_abi)])
}

/// `l ( "=" r )?` → an assignment, RETARGETING by the LHS shape (the
/// retired hand parse_assignment: an `Ident` LHS → `Expr.Assign`, a
/// `FieldAccess` LHS → `Expr.FieldAssign`; any other target is an
/// F-code-worthy error). With no `=` (rcap Nil) the left passes through
/// unchanged. Right-associative — the grammar's `r:assignment` recursion
/// supplies the nested value (t-kd4y.3.5.7).
export fn mk_assign_expr(st: PState, sp_start: int, lcap: CapVal, rcap: CapVal) -> ExprId {
    let l = capval_to_expr(st, lcap)
    match rcap {
        .Nil -> l
        _ -> {
            let r = capval_to_expr(st, rcap)
            // [sp_start, next-token) as the hand parse_assignment stamped (mod.av:1447).
            // Right-assoc, so a nested `a = b = c` gets its own sp_start per level via
            // the grammar's `r:assignment` recursion — each Assign spans from its own LHS.
            let sp = byte_span(sp_start, st.cur().pos)
            match st.store.exprs.get(l) {
                .Ident(name) -> st.store.add_expr(Expr.Assign(name, r), sp, [])
                .FieldAccess(obj, field) -> st.store.add_expr(Expr.FieldAssign(obj, field, r), sp, [])
                _ -> st.error_node("invalid assignment target")
            }
        }
    }
}

export fn mk_assign_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_assign_expr(st, st.build_sp, vals[0], vals[1]))
}

/// Retarget the eq_tail partial's `Expr.Missing` subject(s) to `base` —
/// the equality-stratum sibling of the postfix rebind. With no suffix
/// (tailcap Nil) the base passes through unchanged. The partials come
/// from the eq_tail dispatch's three feature-owned branches (`is` /
/// `in` / the `==`-chain); this fold is what installs the real subject
/// and stamps the final's span (t-kd4y.3.5.7).
export fn rebind_eq_expr(st: PState, sp_start: int, basecap: CapVal, tailcap: CapVal) -> ExprId {
    let base = capval_to_expr(st, basecap)
    match tailcap {
        .Nil -> base
        _ -> rebind_missing_subject(st, sp_start, capval_to_expr(st, tailcap), base)
    }
}

/// Rebuild `tail` with its `Expr.Missing` subject replaced by `base` — the FINAL
/// equality node(s), stamped [sp_start, next-token) exactly as the hand
/// parse_equality stamped IsCheck/InCheck/the in-range Logical/the ==-chain
/// (mod.av:1620-1630) with its rule-entry sp_start. The discardable partial rows
/// (mk_is/mk_inlist/mk_inrange/mk_eqchain) stay span-free — only these rebound
/// finals reach the tree. Dispatches on the partial's shape; the `==`-chain
/// recurses down the left spine to the sentinel seed (a chained `a==b==c`'s
/// intermediate node shares this hi — rare, span-untested; single `a==b` is exact).
fn rebind_missing_subject(st: PState, sp_start: int, tail_id: ExprId, base: ExprId) -> ExprId {
    let sp = byte_span(sp_start, st.cur().pos)
    match st.store.exprs.get(tail_id) {
        .IsCheck(_, v) -> st.store.add_expr(Expr.IsCheck(base, v), sp, [])
        .InCheck(_, items) -> st.store.add_expr(Expr.InCheck(base, items), sp, [])
        .Logical(ge, op, le) -> {
            let ge2 = rebind_bin_subject(st, sp_start, ge, base)
            let le2 = rebind_bin_subject(st, sp_start, le, base)
            st.store.add_expr(Expr.Logical(ge2, op, le2), sp, [])
        }
        .Binary(l, op, r) -> st.store.add_expr(Expr.Binary(rebind_missing_subject(st, sp_start, l, base), op, r), sp, [])
        _ -> base
    }
}

/// Replace the left of a single range-comparison `Binary(_, op, r)` with `base`.
fn rebind_bin_subject(st: PState, sp_start: int, id: ExprId, base: ExprId) -> ExprId {
    match st.store.exprs.get(id) {
        .Binary(_, op, r) -> st.store.add_expr(Expr.Binary(base, op, r), byte_span(sp_start, st.cur().pos), [])
        _ -> id
    }
}

export fn rebind_eq_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(rebind_eq_expr(st, st.build_sp, vals[0], vals[1]))
}

/// The assignment/equality strata's rows (t-kd4y.3.5.7) — both spanned
/// at their rule entry, both owned by field_assign_lang (its gram spells
/// `assignment` and `equality`; ownership follows the referencing rule).
export fn field_assign_builds() -> List<BuilderBind> {
    bind_rows("features.struct_decl.lowering", [bind_row("mk_assign", "expr", 2, true, "mk_assign_abi", mk_assign_abi),
     bind_row("rebind_eq", "expr", 2, true, "rebind_eq_abi", rebind_eq_abi)])
}
