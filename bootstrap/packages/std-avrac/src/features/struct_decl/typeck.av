// WHY: type checking for struct field access, field initialization, and field existence.
// Also handles .length on strings and lists (property access is routed here).
// Shared by struct_decl, with_expr, and null_safety features.

use core.{Expr, FieldEntry, FieldInit, ValueType, SExpr, vtype_eq, vtype_is_list}
use typeck.{TC, ExprResult, tc_er, tc_report, check_expr, StructTypeReg, struct_type_lookup, resolve_vtype}
use diagnostics.{DiagCode}

/// Type-check a `obj.field` access. Recognises `.length` on Str
/// / List as Int; everything else routes through the struct
/// registry. Generic type parameters skip the field-existence
/// check (no entry in the struct registry yet — monomorphization
/// re-checks per instantiation).
export fn check_field_access(tc: TC, obj: Expr, field: string) -> ExprResult {
    let o = check_expr(tc, obj)
    // String .length
    if vtype_eq(o.ty, .Str) && field == "length" {
        return tc_er(o.tc, .Int)
    }
    // Bytes .length
    if vtype_eq(o.ty, .Bytes) && field == "length" {
        return tc_er(o.tc, .Int)
    }
    // List .length
    if vtype_is_list(o.ty) {
        if field == "length" { return tc_er(o.tc, .Int) }
    }
    // Struct field
    let struct_name = match o.ty {
        .Struct(n, _) -> n
        _ -> ""
    }
    if struct_name.length > 0 {
        let fields = struct_type_lookup(o.tc.structs, struct_name)
        // Skip field check for generic type parameters (not in struct registry)
        if fields.length == 0 { return tc_er(o.tc, .Unknown) }
        if !tc_field_exists(fields, field) {
            let msg = "no field `${field}` on type `${struct_name}`"
            return tc_er(tc_report(o.tc, DiagCode.TypeMismatch, msg), .Unknown)
        }
        let field_ty = field_type_in(o.tc, fields, field)
        return tc_er(o.tc, field_ty)
    }
    // Map .get is handled in method call
    tc_er(o.tc, .Unknown)
}

/// Type-check every value in a `List<FieldInit>`. Field names
/// are validated separately (e.g. against the struct's declared
/// fields); this function only walks the values for type errors.
export fn check_field_inits(tc: TC, inits: List<FieldInit>) -> TC {
    mut acc = tc
    mut i = 0
    while i < inits.length {
        let r = check_expr(acc, inits[i].value.node)
        acc = r.tc
        i = i + 1
    }
    acc
}

/// Linear scan for a field by name. Used by `check_field_access`
/// to surface "no field X on type Y" diagnostics.
fn tc_field_exists(fields: List<FieldEntry>, name: string) -> bool {
    mut i = 0
    while i < fields.length {
        if fields[i].name == name { return true }
        i = i + 1
    }
    false
}

/// Return the resolved ValueType of a named field, or `.Unknown`
/// when not found. Routes the raw field type through `resolve_vtype`
/// so cross-module struct refs resolve to canonical names.
fn field_type_in(tc: TC, fields: List<FieldEntry>, name: string) -> ValueType {
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        if e.name == name { return resolve_vtype(tc, e.resolved) }
        i = i + 1
    }
    ValueType.Unknown
}
