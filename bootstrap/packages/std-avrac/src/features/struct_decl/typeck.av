// WHY: type checking for struct field access, field initialization, and field existence.
// Also handles .length on strings and lists (property access is routed here).
// Shared by struct_decl, with_expr, and null_safety features.

use core.{Expr, FieldEntry, FieldInit, ValueType, SExpr, vtype_eq, vtype_is_list, vtype_is_unknown, vtype_assignable, vtype_render_full}
use typeck.{TC, ExprResult, tc_er, tc_report, check_expr, struct_type_lookup, tc_specialize_field_ty, resolve_vtype, generic_args_layout_conflict, collection_into_value_scalar_slot}
use diagnostics.{DiagCode}

/// Type-check a `obj.field` access. Recognises `.length` on Str
/// / List as Int; everything else routes through the struct
/// registry. Generic type parameters skip the field-existence
/// check (no entry in the struct registry yet — monomorphization
/// re-checks per instantiation).
export fn check_field_access(tc: TC, obj: Expr, field: string) -> ExprResult {
    let o = check_expr(tc, obj)
    // String .length
    if vtype_eq(o.ty, .Str) && field == "length" {
        return tc_er(o.tc, .Int)
    }
    // Bytes .length
    if vtype_eq(o.ty, .Bytes) && field == "length" {
        return tc_er(o.tc, .Int)
    }
    // List .length
    if vtype_is_list(o.ty) {
        if field == "length" { return tc_er(o.tc, .Int) }
    }
    // Struct field
    let struct_name = match o.ty {
        .Struct(n, _, _) -> n
        _ -> ""
    }
    if struct_name.length > 0 {
        let fields = struct_type_lookup(o.tc.structs, struct_name)
        // Skip field check for generic type parameters (not in struct registry)
        if fields.length == 0 { return tc_er(o.tc, .Unknown) }
        if !tc_field_exists(fields, field) {
            let msg = "no field `${field}` on type `${struct_name}`"
            return tc_er(tc_report(o.tc, DiagCode.TypeMismatch, msg), .Unknown)
        }
        let field_ty = field_type_in(o.tc, fields, field)
        // When the receiver is a generic struct instance (`Box<int>`),
        // specialise the field's declared `T` to the instance's arg.
        return tc_er(o.tc, tc_specialize_field_ty(o.tc.structs, o.ty, field_ty))
    }
    // Map .get is handled in method call
    tc_er(o.tc, .Unknown)
}

/// Type-check every value in a `List<FieldInit>`. Field names
/// are validated separately (e.g. against the struct's declared
/// fields); this function only walks the values for type errors.
export fn check_field_inits(tc: TC, inits: List<FieldInit>) -> TC {
    mut acc = tc
    mut i = 0
    while i < inits.length {
        let r = check_expr(acc, acc.nodes.exprs.get(inits[i].value_id))
        acc = r.tc
        i = i + 1
    }
    acc
}

/// Type-check a struct literal's field initializers AND validate them
/// against the named struct's declared fields: every field must exist,
/// and a scalar field's value must be assignable to the field's type.
/// When the struct isn't in the registry (generic param, forward ref,
/// cross-module not-yet-resolved) field validation is skipped — only the
/// value expressions are checked, preserving the prior lenient behavior.
///
/// This is the load-bearing check for typed table literals (c080): a
/// `table<Row>` row is a StructLit(Row, …), so a header column that isn't
/// a field of Row, or a cell whose type doesn't match the field, is
/// reported here as F1000 instead of crashing codegen with an ICE.
export fn check_struct_lit_fields(tc: TC, receiver_ty: ValueType, name: string, inits: List<FieldInit>) -> TC {
    let fields = struct_type_lookup(tc.structs, name)
    mut acc = tc
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        let r = check_expr(acc, acc.nodes.exprs.get(init.value_id))
        acc = r.tc
        if fields.length > 0 {
            if !tc_field_exists(fields, init.name) {
                acc = tc_report(acc, DiagCode.TypeMismatch, "no field `${init.name}` on type `${name}`")
            } else {
                acc = check_one_field_ty(acc, receiver_ty, name, fields, init.name, r.ty)
            }
        }
        i = i + 1
    }
    acc
}

/// Validate ONE field's value against its declared type: a string↔non-string
/// scalar mismatch (numeric/bool interchange tolerated — the bootstrap stores
/// bools in int fields) OR a generic-arg layout conflict (`Box<int>` into a
/// `Box<string>` field — vtype_eq ignores generic args, so a reader would deref
/// the int as a pointer). Assumes the field exists (callers gate that). Shared
/// by struct-literal fields and direct field assignment (tokv).
///
/// `receiver_ty` is the instance type the field belongs to (e.g. `Box<string>`).
/// A generic field's declared type (`T`) is specialised to the receiver's arg
/// before the checks — otherwise `generic_args_layout_conflict` sees an
/// unresolved param and skips it, letting `b.val = 9` / `b with { val: 9 }` on a
/// `Box<string>` slip through. The read path (check_field_access) specialises
/// the same way; pass `.Unknown` to opt out (no args → no-op specialisation).
/// Like the enum-ctor payload check, a struct field uses position-appropriate
/// checks STRONGER than the narrow `assign_layout_conflict` gate (the string↔non-
/// string scalar check catches `int`/`bool`→`string` both ways), so it stays
/// here rather than routing through that gate — which would narrow coverage. The
/// generic-arg + collection→scalar checks below are the shared predicates.
export fn check_one_field_ty(tc: TC, receiver_ty: ValueType, name: string, fields: List<FieldEntry>, field: string, value_ty: ValueType) -> TC {
    let fty = tc_specialize_field_ty(tc.structs, receiver_ty, field_type_in(tc, fields, field))
    mut acc = tc
    let cross_str = vtype_is_string_like(fty) != vtype_is_string_like(value_ty)
    if vtype_is_scalar(fty) && vtype_is_scalar(value_ty) && cross_str && !vtype_assignable(value_ty, fty) {
        acc = tc_report(acc, DiagCode.TypeMismatch, "field `${field}` of `${name}` expects `${vtype_render_full(fty)}`, got `${vtype_render_full(value_ty)}`")
    }
    if generic_args_layout_conflict(acc, value_ty, fty) {
        acc = tc_report(acc, DiagCode.TypeMismatch, "field `${field}` of `${name}` expects `${vtype_render_full(fty)}`, got `${vtype_render_full(value_ty)}` (generic argument layout conflict)")
    }
    // A List/Map value into a value-scalar field slot (`S { n: [1] }`, `s.n = [1]`
    // where `n: int`) is a wild store — a collection pointer in a scalar cell.
    if collection_into_value_scalar_slot(acc, value_ty, fty) {
        acc = tc_report(acc, DiagCode.TypeMismatch, "field `${field}` of `${name}` expects `${vtype_render_full(fty)}`, got `${vtype_render_full(value_ty)}` (scalar/pointer layout conflict)")
    }
    acc
}

/// Validate a direct field assignment `obj.field = value` (tokv) — the single-
/// field analog of check_struct_lit_fields. Skips when the struct/field isn't
/// resolved (unknown-field assignment is reported on the resolve/access path).
export fn check_field_assign_ty(tc: TC, receiver_ty: ValueType, name: string, field: string, value_ty: ValueType) -> TC {
    let fields = struct_type_lookup(tc.structs, name)
    if fields.length == 0 { return tc }
    if !tc_field_exists(fields, field) { return tc }
    check_one_field_ty(tc, receiver_ty, name, fields, field, value_ty)
}

/// True for the string-category scalars (`string` / `bytes`), which
/// must not be confused with numeric/bool scalars.
fn vtype_is_string_like(t: ValueType) -> bool {
    match t {
        .Str -> true
        .Bytes -> true
        _ -> false
    }
}

/// True for concrete scalar types — the ones safe to compare a struct
/// field against without tripping over generics or nominal coercions.
fn vtype_is_scalar(t: ValueType) -> bool {
    match t {
        .Int -> true
        .Str -> true
        .Bool -> true
        .Float -> true
        .Bytes -> true
        .U8 -> true
        .U16 -> true
        .U32 -> true
        .U64 -> true
        .I8 -> true
        .I16 -> true
        .I32 -> true
        _ -> false
    }
}

/// Linear scan for a field by name. Used by `check_field_access`
/// to surface "no field X on type Y" diagnostics.
fn tc_field_exists(fields: List<FieldEntry>, name: string) -> bool {
    mut i = 0
    while i < fields.length {
        if fields[i].name == name { return true }
        i = i + 1
    }
    false
}

/// Return the resolved ValueType of a named field, or `.Unknown`
/// when not found. Routes the raw field type through `resolve_vtype`
/// so cross-module struct refs resolve to canonical names.
fn field_type_in(tc: TC, fields: List<FieldEntry>, name: string) -> ValueType {
    mut i = 0
    while i < fields.length {
        let e = fields[i]
        if e.name == name { return resolve_vtype(tc, e.resolved) }
        i = i + 1
    }
    ValueType.Unknown
}
