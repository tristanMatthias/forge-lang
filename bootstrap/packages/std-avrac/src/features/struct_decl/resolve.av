// The struct/field/enum-ctor family's RESOLVER hooks. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram, and
// which fn implements each pass — and the pass logic lives in the file named
// for that pass. These are module-PRIVATE and stay so: dir-as-module flattens
// every sibling .av into one flat namespace, so mod.av reaches them exactly as
// before the move.
use core.{Expr}
use resolve.{Resolver, resolve_expr, resolve_expr_list_ids, resolve_field_init_list, starts_with_upper}

/// Resolver hook for `StructLit`. Walks every field's value
/// expression — the field names themselves don't go through the
/// resolver.
fn struct_lit_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .StructLit(_, inits) -> resolve_field_init_list(r, inits)
        _ -> r
    }
}

/// Resolver hook for `FieldAccess`. Skips name resolution when
/// the receiver is an upper-case identifier (to leave room for
/// `Type.STATIC` / `EnumName.Variant` shorthand). Otherwise
/// resolves the receiver normally.
fn field_access_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .FieldAccess(obj, _) -> {
            let obj_expr = r.nodes.exprs.get(obj)
            match obj_expr {
                .Ident(name) -> {
                    if starts_with_upper(name) {
                        return r
                    }
                    resolve_expr(r, obj_expr)
                }
                _ -> resolve_expr(r, obj_expr)
            }
        }
        _ -> r
    }
}

/// Resolver hook for `EnumCtor`. Walks the constructor args.
fn enum_ctor_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .EnumCtor(_, _, args) -> resolve_expr_list_ids(r, args)
        _ -> r
    }
}

/// Resolver hook for `FieldAssign`. No-op — the deep-immutability
/// check happens in `resolve/mod.av` via a dedicated path.
fn field_assign_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    r
}
