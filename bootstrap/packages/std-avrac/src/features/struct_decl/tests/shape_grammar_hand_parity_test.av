// WHY: t-47hc slice 10.8 (t-myz7) — `shape`, the structural sibling of `type`.
//
// Found by accident: while measuring `type`'s gaps in 10.4 I probed
// `shape HasName = { name: string }` and the DSL rejected it outright. `shape` is in
// `decl_lead`'s FIRST — so `@hand(decl_hand)` has always handled it — but NO fragment
// covered it, and it was on nobody's list of decl keywords to migrate. It is now.
//
// It is its own rule, not a widening of `type_decl`: its own keyword, its own node
// (`Stmt.ShapeDecl`), and — alone among the decl keywords — NO type params.
// `parse_shape_declaration` is `shape NAME = { field* }` and nothing else.
//
// The builder had to be created in BOTH engines. `MkShapeDecl` existed in neither, which
// is the third time this slice has found a build present on one side only (MkExtern and
// MkExport in 10.6, the generic decl arms in 10.2) — so it was added as one shared core
// with an emit assertion, not just an executor arm that the interpreter would vouch for.

use @std.avrac.features.grammar.{avra_program_grammar, run_grammar_stmt, emit_parser_source, avra_decl_dispatch_grammar, emit_parser_source_ex}

// The PRODUCTION declaration parser source — the dispatch view the checked-in
// gen_decl_parser.av is rendered from, which is not the whole-program view used above.
fn decl_src() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}
use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{render_stmt_ids, Stmt}

fn dsl_program(src: string) -> string {
    let r = run_grammar_stmt(avra_program_grammar(), src)
    if r.had_error { return "<dsl parse error>" }
    match r.store.stmts.get(r.root) {
        .Block(ids) -> render_stmt_ids(r.store, ids)
        _ -> "<not a program block>"
    }
}

fn hand_program(src: string) -> string {
    let p = parse_program_source(src)
    if p.had_error != 0 { return "<hand parse error>" }
    if p.ids == null { return "<hand no ids>" }
    render_stmt_ids(p.store, p.ids!)
}

fn agrees(src: string) -> bool {
    let d = dsl_program(src)
    d == hand_program(src) && !d.contains("parse error")
}

spec "t-47hc slice 10.8: `shape` is native and builds the hand's node" {
    then "one field, several fields, and an empty shape all agree with the hand" {
        agrees("shape HasName = { name: string }\n") &&
            agrees("shape P = { x: int, y: int }\n") &&
            agrees("shape E = {}\n")
    }

    then "the node is a ShapeDecl, not a TypeDecl" {
        // `shape` and `type` differ only by keyword in surface syntax; if the rule built
        // the wrong node the render would say `type`, and equality with the hand would
        // still be the thing that catches it — but assert the kind directly too.
        dsl_program("shape HasName = { name: string }\n").contains("shape")
    }

    // Pinned because it is non-obvious enough that a reviewer proposed "fixing" it on
    // #1053. Avra is NEWLINE-SENSITIVE and a field list is newline-separated, so the
    // comma between fields is genuinely OPTIONAL — `parse_field_list` has no comma
    // requirement, and the newline form is how almost every struct and shape in the tree
    // is actually written. Tightening the rule to `field ( "," field )* ","?` would
    // reject all of them. Parity means matching the hand in BOTH directions: narrowing is
    // as much a defect here as the accidental widening #1046 had to fix.
    then "commas between fields are OPTIONAL, exactly as the hand has them" {
        agrees("shape S = { x: int y: int }\n") &&
            agrees("shape S = {\n    x: int\n    y: int\n}\n") &&
            agrees("shape S = { x: int, y: int }\n") &&
            agrees("shape S = { x: int, y: int, }\n")
    }

    then "emit renders the shared core — the half an executor-only build would miss" {
        emit_parser_source(avra_program_grammar()).contains("mk_shape_decl(st, capval_tok_text(shname)")
    }
}

// ROUTING — ATTEMPTED IN 10.9 (#1054), REVERTED HERE (t-myz7.2).
//
// `shape` was routed onto the production declaration path and shipped green. It should
// not have been: routing changed error RECOVERY, and the invalid corpus in
// error_recovery_differential_test had no malformed `shape` at all — so the one guard
// that watches the invalid half of a flip was blind to the only keyword that had flipped.
// Adding those cases showed the regression immediately:
//
//     shape S = { x: , y: int }    routed: (shape S (x:<unknown>, y:int))   hand: (error)
//     shape = { x: int }           routed: (shape  (x:int))                 hand: (error)
//     shape S =                    routed: (shape S ())                     hand: (error)
//
// The generated parser is error-TOLERANT and builds partial nodes where
// `parse_declaration_hand` ABORTS to a `Stmt.Error` and lets the caller synchronise. A
// malformed shape reached downstream passes as a NAMELESS declaration. Valid programs
// were unaffected — diff-test was green and every parity spec passed — which is exactly
// why nothing else caught it.
//
// ROUTED AGAIN — under `@try` (t-myz7.2, #1061).
//
// The abort/resync primitive turned out to exist already. `@try` is exactly it: the
// branch snapshots cursor + node store + diagnostics + the @hand delegate, commits only
// if it reported nothing, and otherwise rolls back and falls through to the
// `@peek(decl_lead) @hand(decl_hand)` branch below — which parses the malformed shape
// precisely as it always did. The native rule owns VALID `shape` declarations; the five
// malformed forms above recover through the hand parser, byte-for-byte.
//
// The five cases are IN the invalid corpus now (error_recovery_differential_test), so
// they are what proves this rather than a claim about it: they fail with a bare
// `shape_decl` branch and pass with the `@try`.
//
// What this asserts is the DISPATCH, structurally, on the emitted source — the failure
// mode #1028 was caught on is a routed rule emitted AFTER the decl_hand gate, which
// `decl_lead` then swallows first: correct output, no diagnostic, flip silently dead.
spec "t-myz7.2: `shape` is routed onto the production path, speculatively" {
    then "parse_shape_decl exists and dispatches BEFORE the decl_hand gate" {
        let src = decl_src()
        let shape_at = src.index_of("parse_shape_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        src.contains("fn parse_shape_decl(st: PState) -> CapVal") &&
        // t-47hc.4.3 — the leaf is DELETED, so this asserts there is no gate to dispatch
        // before, rather than an ordering against one. Strictly stronger: an ordering claim
        // is satisfiable by a gate that still exists, `hand_at < 0` only by its absence.
            shape_at >= 0 && hand_at < 0
    }

    then "the branch is SPECULATIVE — on any diagnostic it rolls back into the hand gate" {
        let src = decl_src()
        src.contains("s_last = parse_shape_decl(st)") &&
            src.contains("st.store.truncate_to_mark(s_mark)") &&
            src.contains("st.restore_hand_state(s_hand)")
    }

    then "the alternation TAIL is still native `statement`, not a promoted @hand" {
        // Routing adds a branch BEFORE the gate, so the tail must be untouched. A `@try`
        // sibling used to delete it outright (the emit bug #1061 fixed) — pinned here too
        // because this is the rule that adds the third one.
        let src = decl_src()
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        let tail_at = src.index_of("    parse_statement(st)\n}")
        // t-47hc.4.3: the gate this used to sit after is deleted, so the claim is now
        // simply that the tail IS `parse_statement(st)` and NO hand leaf survives.
        tail_at >= 0 && hand_at < 0
    }
}
