// WHY: t-47hc slice 10.4 (t-myz7) — `type_decl`'s STRUCT form reaches hand parity on
// generics, the same gap `enum_decl` closed in 10.3 and the same shape.
//
// Deliberately NOT the whole keyword. `parse_type_declaration` is bigger than
// `parse_enum_declaration`: after the `=` it branches on `{`, and the non-brace side
// yields two OTHER node kinds — `Stmt.Newtype` (`type UserId = UUID`) and
// `Stmt.UnionAliasDecl` (`type E = A | B`) — plus `consume_name_or_splice`, which accepts
// a `~`-spliced name inside a quote body. Those are a separate increment because they are
// separate nodes, not a wider version of this one; folding them in here would make a
// divergence ambiguous between "generics are wrong" and "the newtype branch is wrong".
//
// Measured before the change: `type Box<T> = { val: T }` and `type B<T: Show> = { v: T }`
// were both `<dsl parse error>` while the hand parses them.
//
// NOT a gap, and recorded so a later increment does not chase it: a doc comment on a
// struct FIELD fails in BOTH engines. Unlike enum variants — where the hand's
// `parse_variant_list` skips `Tk.DocComment` and the fragment had to learn to — the hand's
// field list has no such skip, so there is nothing to match.

use @std.avrac.features.grammar.{emitted_rule_body}
use @std.avrac.features.grammar.{avra_program_grammar, run_grammar_stmt, avra_decl_dispatch_grammar, emit_parser_source_ex}
use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{render_stmt_ids, Stmt}

fn dsl_program(src: string) -> string {
    let r = run_grammar_stmt(avra_program_grammar(), src)
    if r.had_error { return "<dsl parse error>" }
    match r.store.stmts.get(r.root) {
        .Block(ids) -> render_stmt_ids(r.store, ids)
        _ -> "<not a program block>"
    }
}

fn hand_program(src: string) -> string {
    let p = parse_program_source(src)
    if p.had_error != 0 { return "<hand parse error>" }
    if p.ids == null { return "<hand no ids>" }
    render_stmt_ids(p.store, p.ids!)
}

// Equality alone would hold if both sides broke to the same error string, so each case
// also asserts the DSL actually produced a type declaration.
fn agrees(src: string) -> bool {
    let d = dsl_program(src)
    d == hand_program(src) && !d.contains("parse error") && d.contains("type")
}

spec "t-47hc slice 10.4: the struct fragment accepts the hand's GENERIC forms" {
    then "one type param, a bounded one, and several all agree with the hand" {
        agrees("type Box<T> = { val: T }\n") &&
            agrees("type B<T: Show> = { v: T }\n") &&
            agrees("type Pair<A, B> = { a: A, b: B }\n")
    }

    then "the non-generic form is untouched" {
        // One rule serves both: with no `<…>` the type-param capture is empty and the
        // generic core builds the identical node the 2-arg one did.
        agrees("type P = { x: int, y: int }\n")
    }
}

// The non-brace right-hand sides — newtype, union-alias, and the `without` / `only`
// type operators — were pinned here as still hand-only while 10.4 was the head, so that
// 10.5 would start from a measured fact instead of a guess. 10.5 closed them, so that
// assertion is now false BY DESIGN and its coverage lives in
// struct_decl/tests/type_alias_forms_parity_test.av. Deleted rather than inverted: a
// "these are covered elsewhere" assertion tests nothing.

// ── ROUTING (t-47hc slice 10.12) ─────────────────────────────────────────────
//
// `type` is the LAST and largest decl keyword to leave `@hand(decl_hand)`, and the one
// that needed two fixes first — neither of which was about `type` acceptance:
//
//   t-myz7.1  the two RHS forms were ADJACENT OPTIONAL GROUPS, so a struct-form `type`
//             swallowed the declaration written after it (#1064).
//   t-zrn3    exec_node had no UNGUARDED TAIL, so the executor answered a stray token
//             with the alternation's generic F0001 where hand and emit both answered
//             F0040 — and the production path re-parses failed items with the executor,
//             so that was what shipped (#1067).
//
// The second one is why `type T =` followed by a `fn` declaration is in the invalid
// corpus: `tok_starts_type` includes `fn`, so the alias branch is entered on the NEXT
// declaration's lead token and the remainder becomes a stray-token item. That is the
// exact shape that exposed the executor gap, and it now agrees on all four paths.
//
// What this spec pins is the DISPATCH, structurally on the emitted source.
fn decl_src() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}

spec "t-47hc slice 10.12: `type` is routed onto the production path, COMMITTED" {
    then "parse_type_decl exists and dispatches BEFORE the decl_hand gate" {
        let src = decl_src()
        let type_at = src.index_of("parse_type_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        src.contains("fn parse_type_decl(st: PState) -> CapVal") &&
        // t-47hc.4.3 — the leaf is DELETED, so this asserts there is no gate to dispatch
        // before, rather than an ordering against one. Strictly stronger: an ordering claim
        // is satisfiable by a gate that still exists, `hand_at < 0` only by its absence.
            type_at >= 0 && hand_at < 0
    }

    // t-myz7: `type` OWNS its recovery, so the dispatcher calls it DIRECTLY and the
    // `@try` moved inside the rule, paired with the `@cut` after the keyword. The
    // rollback scaffold is still emitted, one frame in, covering only a failure BEFORE
    // the cut. Both halves are asserted: a speculative dispatch would silently un-route
    // the keyword with every parity spec above still green, and a missing `s_cut` would
    // leave the rule committing nowhere with its own `@expect` messages unreachable.
    then "the branch is COMMITTED — the dispatcher calls it directly, the rule owns the rollback" {
        // The three rollback strings are scoped to THIS rule's emitted body. They are
        // byte-identical in every speculative rule the emitter renders, so a whole-file
        // `contains` passed off `parse_mut_decl`'s or `parse_const_decl`'s copy and could
        // not fail for type_decl — the missing-`s_cut` case the note above claims to catch.
        let src = decl_src()
        let rule = emitted_rule_body(src, "fn parse_type_decl(st: PState) -> CapVal")
        src.contains("return parse_type_decl(st)") &&
            !src.contains("s_last = parse_type_decl(st)") &&
            rule.contains("mut s_cut = false") &&
            rule.contains("st.store.truncate_to_mark(s_mark)") &&
            rule.contains("st.restore_hand_state(s_hand)")
    }

    then "the RHS is ONE optional group — the brace and alias forms are EXCLUSIVE" {
        // t-myz7.1 in the emitted output: a single guard admitting either form, with the
        // alias branch as an `else if` INSIDE it. Two adjacent `if`s here would mean the
        // alias group is still tried after the brace form completed, which is the bug.
        let src = decl_src()
        src.contains("if st.cur().tk == Tk.LeftBrace || tok_starts_type(st.cur()) {") &&
            src.contains("} else if tok_starts_type(st.cur()) {")
    }

    then "the alternation TAIL is still native `statement`, not a promoted @hand" {
        let src = decl_src()
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        let tail_at = src.index_of("    parse_statement(st)\n}")
        // t-47hc.4.3: the gate this used to sit after is deleted, so the claim is now
        // simply that the tail IS `parse_statement(st)` and NO hand leaf survives.
        tail_at >= 0 && hand_at < 0
    }
}

// WHY: t-myz7 — a `mut` field in a struct body. `FieldEntry` is `{ name, resolved }`
// and carries no mutability, and the hand DISCARDS the keyword, so the rule consumes
// it UNLABELLED and builds the same node — the same shape `impl`'s type params take.
// Improving on the hand here (capturing mutability) would need an AST field that does
// not exist; per-field mutability is enforced by resolve/mod.av's deep-immutability
// check, not by the field node.
//
// This was the LAST `decl_hand` dependency in parse/mod.av — 39 of its 41 refusal
// sites were `mut` fields of `export type Parser`, and the file went 87 -> 0.
spec "t-myz7: a `mut` struct field parses, and drops the modifier as the hand does" {
    then "a mut field agrees with the hand" {
        agrees("type S = {\n mut a: int,\n b: int\n}\n")
    }

    then "the modifier is DISCARDED, not recorded — mut and plain render identically" {
        hand_program("type S = {\n mut a: int\n}\n") == hand_program("type S = {\n a: int\n}\n") &&
            dsl_program("type S = {\n mut a: int\n}\n") == dsl_program("type S = {\n a: int\n}\n")
    }

    then "every field may be mut, and a plain struct is unaffected" {
        agrees("type S = {\n mut a: int,\n mut b: string\n}\n") &&
            agrees("type S = {\n a: int,\n b: string\n}\n")
    }

    // `variant` REFERENCES this same `field` rule, so widening it reaches enum variant
    // fields too. That is parity, not a widening: the hand already accepted
    // `enum E { A(mut x: int) }` (verified against the pre-change compiler), and
    // discards the modifier there as well. Asserted because nothing else covers the
    // enum path through `field`, and a widening here is exactly the class that no
    // gate catches — both engines agree on valid input, and no fixture writes it.
    then "`enum` variant fields reach `field` too, and agree with the hand" {
        let ev = dsl_program("enum E {\n A(mut x: int),\n B\n}\n")
        ev == hand_program("enum E {\n A(mut x: int),\n B\n}\n") &&
            !ev.contains("parse error") && ev.contains("enum") &&
            ev == hand_program("enum E {\n A(x: int),\n B\n}\n")
    }

    // NOT `agrees` — that helper additionally requires the render to contain "type",
    // its own anti-vacuity guard for THIS file's type-declaration cases, and a shape
    // renders `(shape H …)`. Assert the shape equality directly, with the same
    // did-it-actually-parse half applied to the right keyword.
    then "`shape` shares the field rule, so it accepts mut on the same terms" {
        let sh = dsl_program("shape H = {\n mut n: string\n}\n")
        sh == hand_program("shape H = {\n mut n: string\n}\n") &&
            !sh.contains("parse error") && sh.contains("shape")
    }
}

