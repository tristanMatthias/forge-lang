/// Test fixture: minimal 2D integer point used by the
/// struct-decl example test. Verifies the basic
/// `Point { x: 1, y: 2 }` literal + field-access path.
///
/// @field x — horizontal coordinate.
/// @field y — vertical coordinate.
type ExSdPoint = {
    x: int,
    y: int,
}

spec "struct decl example" {
    then "Point.x access" {
        let p = ExSdPoint { x: 3, y: 4 }
        p.x == 3
    }
    then "Point.y access" {
        let p = ExSdPoint { x: 3, y: 4 }
        p.y == 4
    }
    then "field arithmetic on struct" {
        let p = ExSdPoint { x: 3, y: 4 }
        p.x + p.y == 7
    }
}
