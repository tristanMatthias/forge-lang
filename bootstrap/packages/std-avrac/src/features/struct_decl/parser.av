// WHY: parses `type Foo = { ... }` and `shape Foo = { ... }` declarations
// and the supporting field grammars (declaration + literal init).

use core.{Stmt, Expr, FieldEntry, FieldInit, SExpr, sexpr, TypeParamEntry, TypeExpr, ValueType, type_expr_to_vtype}
use parse.{Parser}
use core.{Tk}

impl Parser {
    fn parse_type_declaration(self) -> Result<Stmt, string> {
        self.advance()
        // Inside `quote { ... }`, accept `~ident` in the name slot.
        // consume_name_or_splice preserves the leading `~` sentinel so the
        // lower pass (name_or_splice in quote_expr/lower.av) resolves it to
        // the macro local's value at expansion time.
        let name = self.consume_name_or_splice("expected type name")?
        // Optional generic parameters: type Foo<T, U> = { ... }
        let tp: List<TypeParamEntry> = if self.check(Tk.Less) {
            self.parse_type_params()
        } else {
            []
        }
        if !self.consume(Tk.Equal, "expected `=` after type name") {
            return .Err("parse error")
        }
        // Struct body: type X = { fields }
        if self.check(Tk.LeftBrace) {
            self.advance()
            let fields = self.parse_field_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after fields") {
                return .Err("parse error")
            }
            return .Ok(Stmt.TypeDecl(name, tp, fields))
        }
        // Non-brace RHS: type expressions, type operators, or aliases
        // Handles: type X = int | string, type X = Base without { f }, type X = OtherType
        if self.check(Tk.Identifier) || self.check(Tk.KwFn) || self.check(Tk.LeftBracket) {
            let type_expr = self.parse_type_expr("expected type after `=`")?
            // Union type alias: type X = int | string
            // Match on the TypeExpr structure, not string content
            match type_expr {
                .Union(_, _) -> {
                    return .Ok(Stmt.UnionAliasDecl(name, type_expr_to_vtype(type_expr)))
                }
                _ -> {}
            }
            // Type operators: type X = Base without { fields }
            if self.check(Tk.Identifier) {
                let op = self.current_lexeme
                if op in ["without", "only"] {
                    self.advance()
                    if !self.consume(Tk.LeftBrace, "expected `{` after type operator") { return .Err("parse error") }
                    let op_fields = self.parse_ident_list()
                    if !self.consume(Tk.RightBrace, "expected `}` after type operator fields") { return .Err("parse error") }
                    // Synthetic FieldEntry list: a `__base` sentinel
                    // carrying the underlying type, a `__without` /
                    // `__only` marker, then the user-listed field
                    // names. codegen/setup.av's `resolve_type_operator`
                    // walks this exact shape, so the marker name needs
                    // to be `__without` / `__only`, not `__op`.
                    mut derived: List<FieldEntry> = []
                    derived.push(FieldEntry { name: "__base", resolved: type_expr_to_vtype(type_expr) })
                    derived.push(FieldEntry { name: "__" + op, resolved: ValueType.Str })
                    mut k = 0
                    while k < op_fields.length {
                        derived.push(op_fields[k])
                        k = k + 1
                    }
                    return .Ok(Stmt.TypeDecl(name, tp, derived))
                }
            }
            // Newtype wrapper: type UserId = string — nominal distinction
            return .Ok(Stmt.NewtypeDecl(name, type_expr_to_vtype(type_expr)))
        }
        let empty: List<FieldEntry> = []
        .Ok(Stmt.TypeDecl(name, tp, empty))
    }

    // shape Name = { field: Type, ... }
    // Structural type — all fields public, width subtyping (spec Axis 3.1-3.7).
    fn parse_shape_declaration(self) -> Result<Stmt, string> {
        self.advance()
        let name = self.consume_identifier("expected shape name")?
        if !self.consume(Tk.Equal, "expected `=` after shape name") {
            return .Err("parse error")
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after `=` in shape declaration") {
            return .Err("parse error")
        }
        let fields = self.parse_field_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after shape fields") {
            return .Err("parse error")
        }
        .Ok(Stmt.ShapeDecl(name, fields))
    }

    // Parse a list of identifiers separated by commas: {a, b, c}.
    // Returns a `List<FieldEntry>` whose entries have
    // `resolved: ValueType.Unknown` — the marker-list pattern used
    // by `type X = Base without { ... }` packs the names into the
    // same FieldEntry shape so `resolve_type_operator` can treat the
    // tail as a plain field list.
    fn parse_ident_list(self) -> List<FieldEntry> {
        mut out: List<FieldEntry> = []
        while !self.check(Tk.RightBrace) {
            if !self.check(Tk.Identifier) { return out }
            let id = self.current_lexeme
            self.advance()
            out.push(FieldEntry { name: id, resolved: ValueType.Unknown })
            if self.check(Tk.Comma) { self.advance() }
        }
        out
    }

    fn parse_field_list(self) -> Result<List<FieldEntry>, string> {
        // Source-order loop pushing into a growable list. The prior
        // recursion built `.Node(name, ty, .Node(...))` head-first
        // and propagated the inner `?` via cons; switching to a
        // mutable accumulator with `?`-propagation keeps the same
        // error semantics (early return on missing colon / type).
        mut out: List<FieldEntry> = []
        while !self.check(Tk.RightBrace) {
            // Optional `mut` modifier — ignored for now.
            if self.check(Tk.KwMut) { self.advance() }
            let name = self.consume_identifier("expected field name")?
            if !self.consume(Tk.Colon, "expected `:` after field name") {
                return .Err("parse error")
            }
            let te = self.parse_type_expr("expected field type")?
            let resolved = type_expr_to_vtype(te)
            out.push(FieldEntry { name, resolved })
            if self.check(Tk.Comma) { self.advance() }
        }
        .Ok(out)
    }

    fn parse_field_init_list(self) -> Result<List<FieldInit>, string> {
        // Source-order loop. `Foo { name }` shorthand expands to
        // `Foo { name: name }` so the value defaults to an
        // `Expr.Ident(name)` when the `:` is absent.
        mut out: List<FieldInit> = []
        while !self.check(Tk.RightBrace) {
            let name = self.consume_identifier("expected field name")?
            mut value = Expr.Ident(name)
            if self.check(Tk.Colon) {
                self.advance()
                value = self.parse_expression()?
            }
            out.push(FieldInit { name, value: sexpr(value, self.current_line, self.current_column) })
            if self.check(Tk.Comma) { self.advance() }
        }
        .Ok(out)
    }
}
