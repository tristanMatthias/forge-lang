// WHY: parses `type Foo = { ... }` and `shape Foo = { ... }` declarations
// and the supporting field grammars (declaration + literal init).

use core.{Stmt, Expr, FieldEntry, FieldInit, TypeParamEntry, TypeExpr, ValueType, type_expr_to_vtype, NodeRef, byte_span_none, ExprId}
use parse.{Parser, FieldInitIds}
use core.{Tk}

impl Parser {

    // shape Name = { field: Type, ... }
    // Structural type — all fields public, width subtyping (spec Axis 3.1-3.7).

    // Parse a list of identifiers separated by commas: {a, b, c}.
    // Returns a `List<FieldEntry>` whose entries have
    // `resolved: ValueType.Unknown` — the marker-list pattern used
    // by `type X = Base without { ... }` packs the names into the
    // same FieldEntry shape so `resolve_type_operator` can treat the
    // tail as a plain field list.


    fn parse_field_init_list(self) -> Result<FieldInitIds, string> {
        // Source-order loop. `Foo { name }` shorthand expands to
        // `Foo { name: name }` so the value defaults to an
        // `Expr.Ident(name)` when the `:` is absent.
        mut out: List<FieldInit> = []
        while !self.check(Tk.RightBrace) {
            let name = self.consume_identifier("expected field name")?
            mut value = Expr.Ident(name)
            mut value_id = ExprId(0)
            if self.check(Tk.Colon) {
                self.advance()
                value_id = self.parse_expression()?
            } else {
                value_id = self.alloc_leaf(value)
            }
            out.push(FieldInit { name, value_id })
            if self.check(Tk.Comma) { self.advance() }
        }
        .Ok(FieldInitIds { inits: out })
    }
}
