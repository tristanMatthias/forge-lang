// WHY: `type Foo = { x: int }` — nominal record declarations, plus the
// struct-literal / field-access expression surface. The feature owns the
// `field` rule (grammar.av — its primary definition site; enum's `variant`
// references it cross-fragment) and `field_init` (struct_lit_lang's gram,
// referenced by `with` and the splice-struct branch). `type` vs `shape` is
// the spec's nominal/structural split (Axis 3), not a missing keyword.
//
// dir-as-module (g2eo.1): codegen.av + typeck.av + grammar.av auto-load
// as siblings, surface flat at `features.struct_decl.{...}`.
use codegen.{err_emit}
use core.{vtype_struct_name, ExprId}
use features.{composed}
use features.enum_decl.{emit_enum_ctor}
use typeck.{tc_enum_find_by_variant}
use typeck.{check_expr, check_expr_list, tc_er, tc_report, tc_struct_lit_vtype}
use diagnostics.{DiagCode}
use features.grammar.{parse_grammar, GramFamily}

/// `Foo { x: 1, y: 2 }` struct literals — the definition carries syntax
/// and BOTH rows (t-kd4y.3.5.6): `struct_lit_expr` spells MkStructLit and
/// the shared `field_init` rule spells MkFieldInit, so one gram owns both
/// (the no-orphans validator; qualified_expr, with_suffix, and the unary
/// splice-struct branch reference `field_init` cross-fragment by name —
/// the `param` precedent). `gram_family = GramFamily.Expr`; the ladder dispatches
/// to `struct_lit_expr` behind @peek(ident_lbrace_plain).
@language_feature
export fn struct_lit_lang() -> LanguageFeature {
    LanguageFeature struct_lit_def {
        name = "struct_lit",
        title = "struct literals",
        docs = """
`Name { field: value, … }` builds a struct; a bare `field` is shorthand
for `field: field`. Every declared field must be initialised (F1005 —
partial updates go through `with`).
""",
        // VERBATIM from the spine. field_init's VALUE propagates: a
        // failed value aborts the whole literal — unrequired, `T { x: }`
        // built `(struct T (x=(error)))`, a literal asserting a field was
        // initialised, instead of taking out the literal, the binding and
        // the enclosing fn. The NAME cannot carry `@require`: it is the
        // sequence's leading item and therefore the FIRST-set guard, which
        // the DSL rejects outright — and it needs no guard, since the rule
        // is only entered when that FIRST holds.
        gram = grammar {
  struct_lit_expr = n:IDENT "{" ( @onfail(bail) f:field_init )* "}" -> MkStructLit(n, f)
  field_init  = n:IDENT ( ":" @onfail(bail) v:expression )? ( "," )? -> MkFieldInit(n, v)
        },
        snippet = r"${1:Name} { ${2:field}: ${3:value} }",
        expr_tag = Expr.StructLit("", []),
        emit_expr = struct_lit_emit_expr,
        resolve_expr = struct_lit_resolve_expr,
        check_expr = struct_lit_check_expr,
        contextual = ["without", "only"],
        gram_family = GramFamily.Expr,
    }
    struct_lit_def
}

/// `obj.field` — field access. Also handles the `Type.STATIC` shape when
/// the receiver starts with an upper-case ident — that case skips name
/// resolution. The definition carries the postfix chain's `.`-led CORE
/// rule (t-kd4y.3.5.8): the peek-gated `.field` branch AND the unguarded
/// `@fallback` branch that owns the diagnostic for a `.` completing no
/// step (`a.` — without it the stray `.` re-reads at statement level:
/// F0001 vs the pinned F0040, and a different recovery tree). The
/// `.Variant(` and `.0` readings are SIBLING RULES (enum_ctor_lang's
/// enum_ctor_suffix, tuple_index_lang's tuple_suffix), dispatched
/// zero-width-peek-first by the spine so this rule's fallback stays the
/// LAST `.`-led branch. FIELDNAME (not IDENT): `consume_field_name`
/// accepts reserved-but-inactive keywords (`x.ref`), a set the DSL's
/// IDENT terminal cannot spell. `gram_family = GramFamily.Expr`.
@language_feature
export fn field_access_lang() -> LanguageFeature {
    LanguageFeature field_access_def {
        name = "field_access",
        title = ". — field access",
        docs = """
`obj.field` reads a field; chains compose left-to-right. On an
upper-case receiver the same syntax reads as `Type.STATIC` /
`Type.Variant` — resolved by the type system rather than name lookup.
""",
        gram = grammar {
  field_suffix = @peek(dot_plain_field) @when(dot_postfix_ok) "." n:FIELDNAME -> MkFieldAccess(n)
               | @fallback @when(dot_postfix_ok) "." @require n:FIELDNAME @expect("FIELDNAME", "expected field name after `.`", F0040) -> MkFieldAccess(n)
        },
        snippet = r"${1:obj}.${2:field}",
        expr_tag = Expr.FieldAccess(ExprId(0), ""),
        emit_expr = field_access_emit_expr,
        resolve_expr = field_access_resolve_expr,
        check_expr = field_access_check_expr,
        gram_family = GramFamily.Expr,
    }
    field_access_def
}

/// `EnumName.Variant(args)` / leading-dot `.Variant(args)` enum
/// constructors — the definition carries the contextual `.Variant` rule
/// (t-kd4y.3.5.6) AND the postfix `Type.Variant(args)` SUFFIX reading
/// (t-kd4y.3.5.8) with both rows. Lives next to struct_lit because the
/// parsing/typeck shape is similar; the `Type.Variant` form arrives via
/// field-access rewriting. `gram_family = GramFamily.Expr`.
@language_feature
export fn enum_ctor_lang() -> LanguageFeature {
    LanguageFeature enum_ctor_def {
        name = "enum_ctor",
        title = "enum constructors",
        gram = grammar {
  variant_ctor = "." @require v:IDENT ( "(" ( a:expression ( "," a:expression )* )? @require ")" )?
                 @expect("IDENT", "expected a variant name after `.`", F0040)
                 @expect(")", "expected `)` after arguments") -> mk_enum_ctor(v, a)
  enum_ctor_suffix = @peek(dot_enum_ctor) @when(base_upper_ident) @when(dot_postfix_ok) "." n:FIELDNAME "(" ( @onfail(bail) a:call_arg ( @peek(comma_not_rparen) "," @onfail(bail) a:call_arg )* ( "," )? )? @require ")" @expect(")", "expected `)` after arguments") -> MkEnumCtorSuffix(n, a)
        },
        expr_tag = Expr.EnumCtor("", "", []),
        emit_expr = enum_ctor_emit_expr,
        resolve_expr = enum_ctor_resolve_expr,
        check_expr = enum_ctor_check_expr,
        gram_family = GramFamily.Expr,
    }
    enum_ctor_def
}

/// `obj.field = value` / `x = value` — the assignment + equality strata
/// (t-kd4y.3.5.7). The definition carries the ladder's `assignment` rule
/// (spelling mk_assign — the LHS-shape retarget into Assign/FieldAssign)
/// and the `equality` rule (spelling rebind_eq — the fold that installs
/// the real subject into the is/in/==-chain partials); one gram owns both
/// rows per the no-orphans validator, and ownership follows the
/// referencing rule. The spine keeps `eq_tail` as a pure dispatch over
/// the three feature-owned tails. The resolver-side mutability check
/// (deep immutability) is handled directly in `resolve/mod.av`, so the
/// resolver hook here is a pass-through walk. `gram_family = GramFamily.Expr`.
@language_feature
export fn field_assign_lang() -> LanguageFeature {
    LanguageFeature field_assign_def {
        name = "field_assign",
        title = "= — assignment expressions",
        docs = """
`x = v` rebinds a `mut` local; `obj.field = v` assigns through a field
access (deep immutability applies — the root binding must be `mut`).
Assignment is right-associative and yields the assigned value.
""",
        // VERBATIM from the spine. `@onfail(bail)` on the LHS: without it
        // a FAILED left operand was still built on: `if let = x { 1 }`
        // reported the missing binding name, then `assignment` consumed
        // the `=`, parsed the rest of the fn body as an RHS ("expected
        // }"), and mk_assign added "invalid assignment target" on top —
        // three diagnostics where one is pinned. `bail` keys on the
        // sub-parse FAILING, not on it reporting, which is required:
        // `let a = (1) ->` reports and still yields `(group 1)`, a value
        // that is kept.
        gram = grammar {
  assignment    = @onfail(bail) l:pipe ( "=" r:assignment )? -> mk_assign(l, r)
  equality      = base:bitor ( tail:eq_tail )? -> rebind_eq(base, tail)
        },
        snippet = r"${1:target} = ${2:value}",
        expr_tag = Expr.FieldAssign(ExprId(0), "", ExprId(0)),
        emit_expr = field_assign_emit_expr,
        resolve_expr = field_assign_resolve_expr,
        check_expr = field_assign_check_expr,
        gram_family = GramFamily.Expr,
    }
    field_assign_def
}

/// `type` — the declaration's definition carries syntax, docs, surface,
/// and ALL THREE lowerings its fragment spells (MkTypeDeclAny / MkShapeDecl
/// / MkField — t-kd4y.3.3.2). `gram_family` stays "" — declaration rules,
/// composed by the decl view + fragment registry. No stmt hooks:
/// `Stmt.TypeDecl`/`NewtypeDecl`/`UnionAliasDecl` are core passes, exactly
/// as the retired hookless `feature_new("type_decl")` register left them.
@language_feature
export fn type_decl_lang() -> LanguageFeature {
    LanguageFeature type_decl_def {
        name = "type_decl",
        title = "type — nominal type declarations",
        docs = """
`type Name = { fields }` declares a nominal struct; `type Id = UUID` a
newtype wrapper; `type N = A | B` a union alias; and `type Sub = Base
without { f }` (or `only`) derives a narrowed struct. Generics ride an
optional `<T, U: Bound>` list.
""",
        gram = grammar {
  // t-myz7: `type` OWNS its recovery — `@try` + `@cut` inside the rule, so a malformed
  // header reports through these `@expect`s instead of rolling back to `decl_hand`.
  // The type-parameter group is `parse_type_params`' shape exactly: a non-leading
  // `tparam` REPORTS and is stepped over rather than binding whatever token is there,
  // and a missing `>` throws the whole list away (`return empty`), so
  // `type Foo<T { x: int }` keeps neither `T` nor a stray brace.
  // The inner list is OPTIONAL, gated on `@peek(not_gt)` — the acceptance frontier has to
  // stay exactly where the hand's is. `parse_type_param_entries` opens with
  // `if check(Greater) { return out }` and only then demands an IDENT, so the hand
  // accepts `E<>` AND reports "expected type parameter name" for `E< {`. A bare `( … )?`
  // inner reproduces the first and silently loses the second; the peek splits them where
  // the hand does.
  type_decl   = @try "type" @cut @require tname:name_or_splice ( "<" ( @peek(not_gt) @gate @onfail(halt) tparams:tparam ( "," @onfail(skip) tparams:tparam )* )? @onfail(discard, tparams) ">" )? @require "=" ( "{" ( @peek(not_rbrace) @gate fields:field ","? )* @require "}" | talias:type_expr ( top:( "without" | "only" ) @require "{" ( topf:IDENT ","? )* @require "}" @expect("{", "expected `{` after type operator") @expect("}", "expected `}` after type operator fields") )? )?
                @expect("name_or_splice", "expected type name")
                @expect("=", "expected `=` after type name")
                @expect(">", "expected `>` after type parameters")
                @expect("tparam", "expected type parameter name")
                @expect("}", "expected `}` after fields") -> MkTypeDeclAny(tname, tparams, fields, talias, top, topf)
  shape_decl  = @try "shape" @cut @require shname:IDENT @require "=" @require "{" ( @peek(not_rbrace) @gate shfields:field ","? )* @require "}"
                @expect("IDENT", "expected shape name")
                @expect("=", "expected `=` after shape name")
                @expect("{", "expected `{` after `=` in shape declaration")
                @expect("}", "expected `}` after shape fields") -> MkShapeDecl(shname, shfields)
  // The TYPE position is `@require`d, keyed on the rule NAME because `type_expr`'s
  // FIRST is a disjunction with no single token to name (t-myz7). Unrequired, a
  // missing type did not abort: the type view reported its own generic F0040 and
  // handed back `Unknown`, so `shape S = { x: , y: int }` and `enum E { A(x: ) }`
  // both BUILT a field/variant — `(enum E (A(x:<unknown>)))` — where the hand aborts
  // the whole declaration and reports F0001. Same field rule serves `type`, `shape`
  // and `enum` payloads, so one `@require` covers all three.
  field       = ( "mut" )? fname:IDENT @require ":" @require ftype:type_expr
                @expect("IDENT", "expected field name")
                @expect(":", "expected `:` after field name")
                // The hand's wording, verbatim — `parse_type_expr("expected field type")`,
                // and it is the SAME string in struct_decl, enum_decl and component_decl,
                // which is exactly the sharing this one rule already stands for.
                @expect("type_expr", "expected field type") -> MkField(fname, ftype)
            },
        snippet = r"type ${1:Name} = {\n    ${2:field}: ${3:Type},\n}",
    }
    type_decl_def
}

/// `shape` — structural typing (width subtyping, spec Axis 1). The SYNTAX
/// lives in the type fragment (`shape_decl` beside `type_decl` — same
/// family), so this definition carries the surface alone.
@language_feature
export fn shape_lang() -> LanguageFeature {
    LanguageFeature shape_def {
        name = "shape_decl",
        title = "shape — structural type declarations",
        docs = """
`shape Name = { fields }` declares a structural type: any value carrying
at least those fields conforms (width subtyping), no `impl` needed. No
type parameters — shapes describe field sets, not generic families.
""",
        snippet = r"shape ${1:Name} = {\n    ${2:field}: ${3:Type},\n}",
    }
    shape_def
}

/// Codegen hook for `StructLit`. Forwards to `emit_struct_lit`.
fn struct_lit_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .StructLit(name, inits) -> emit_struct_lit(ctx, env, name, inits)
        _ -> err_emit("expected StructLit")
    }
}

/// Type-check hook for `StructLit`. Type-checks every field
/// initializer and declares the result as `Struct(name)`.
fn struct_lit_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .StructLit(name, inits) -> {
            // An anonymous row (name == "") is a context-free `table { ... }`
            // whose row type was never pinned (c080 Phase C). Desugar stamps
            // the row type when the binding fixes it; anything reaching here
            // had no such context. Report rather than silently producing an
            // untyped value or an opaque `undefined struct ``` codegen ICE.
            if name == "" {
                let checked = check_field_inits(tc, inits)
                return tc_er(tc_report(checked, DiagCode.TableRowTypeMissing, "table literal has no row type"), .Unknown)
            }
            // Validate field names + scalar cell types against the declared
            // struct so a bad table column / cell is F1000, not a codegen ICE.
            // A generic struct literal carries its inferred type args — pass that
            // instance type as the receiver so generic fields specialise.
            let rty = tc_struct_lit_vtype(tc, name, inits)
            // Full literal: validate provided fields (names + types), THEN gate
            // that every declared field is present (F1005 — no silent zero-fill).
            // The `with`-update path routes through with_expr and is intentionally
            // partial, so it never runs the completeness gate.
            let checked = check_struct_lit_fields(tc, rty, name, inits)
            tc_er(check_struct_lit_complete(checked, name, inits), rty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `FieldAccess`. Forwards to `emit_field_access`.
fn field_access_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .FieldAccess(obj, field) -> emit_field_access(ctx, env, ctx.nodes.exprs.get(obj), field)
        _ -> err_emit("expected FieldAccess")
    }
}

/// Type-check hook for `FieldAccess`. Forwards to
/// `check_field_access` which knows about narrowing + enum
/// shorthand.
fn field_access_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .FieldAccess(obj, field) -> check_field_access(tc, tc.nodes.exprs.get(obj), field)
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `EnumCtor`. Forwards to `emit_enum_ctor`.
fn enum_ctor_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .EnumCtor(type_name, variant, args) -> emit_enum_ctor(ctx, env, type_name, variant, args)
        _ -> err_emit("expected EnumCtor")
    }
}

/// Type-check hook for `EnumCtor`. Type-checks every arg and
/// resolves the enum name (the leading-dot shorthand is rewritten
/// to an explicit `EnumName.Variant` via the registry). Result
/// type is the enum.
fn enum_ctor_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .EnumCtor(type_name, variant, args) -> {
            let checked = check_expr_list(tc, args)
            let resolved_name = if type_name == "" { tc_enum_find_by_variant(tc.enums, variant) } else { type_name }
            let empty_args: List<ValueType> = []
            tc_er(checked, .Enum(resolved_name, empty_args, 0))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `FieldAssign`. Forwards to
/// `emit_field_assign`.
fn field_assign_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .FieldAssign(obj, field, value) -> emit_field_assign(ctx, env, ctx.nodes.exprs.get(obj), field, ctx.nodes.exprs.get(value))
        _ -> err_emit("expected FieldAssign")
    }
}

/// Type-check hook for `FieldAssign`. Checks the receiver and
/// the new value; the result type is the value's type.
fn field_assign_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .FieldAssign(obj, field, value) -> {
            let o = check_expr(tc, tc.nodes.exprs.get(obj))
            let v = check_expr(o.tc, o.tc.nodes.exprs.get(value))
            // Validate the assigned value against the field's declared type —
            // `s.b = Box{val:9}` on `b: Box<string>` was a wild store (tokv),
            // the direct-assignment twin of with-update / struct-literal field
            // checking. Skips when obj isn't a known struct.
            let name = vtype_struct_name(o.ty)
            let after = if name == "" { v.tc } else { check_field_assign_ty(v.tc, o.ty, name, field, v.ty) }
            tc_er(after, v.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Named + package-qualified type atoms (t-kd4y.3.5.10) — the type-decl
/// family's reference face (`Name`, `Name<Args>`, dotted module paths,
/// `@pkg::mod::Type`), so both rules + their rows live here, sharing one
/// constructor core (mk_qualified_type composes mk_named_type — the
/// F4012 closure keeps shared cores within one lowering).
/// `gram_family = GramFamily.Type`; the type spine's `type_atom` dispatches by name.
@language_feature
export fn named_type_lang() -> LanguageFeature {
    LanguageFeature named_type_def {
        name = "named_type",
        title = "Name<Args> / @pkg::Type — named type references",
        docs = """
A bare `Name` references a declared type; `mod.Name` crosses modules,
`Name<A, B>` applies generic arguments, a trailing `?` makes it
nullable, and `@pkg::mod::Name` addresses a package's type.
""",
        gram = grammar {
  qualified_type = "@" qname:IDENT ( @peek(double_colon) ":" ":" qname:IDENT )+ ( "<" qa:type_expr ( "," qa:type_expr )* ">" )? ( qopt:"?" )? -> MkQualified(qname, qa, qopt)
  named_type = name:IDENT ( "." name:IDENT )* ( "<" a:type_expr ( "," a:type_expr )* ">" )? ( opt:"?" )? -> MkNamed(name, a, opt)
        },
        gram_family = GramFamily.Type,
    }
    named_type_def
}
