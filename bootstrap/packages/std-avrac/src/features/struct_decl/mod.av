// dir-as-module (g2eo.1): parser.av + codegen.av + typeck.av auto-load
// as siblings, surface flat at `features.struct_decl.{...}`.
use codegen.{err_emit}
use core.{feature_new, Feature}
use resolve.{resolve_expr, resolve_expr_list, resolve_field_init_list, starts_with_upper}
use features.enum_decl.{emit_enum_ctor}
use typeck.{tc_enum_find_by_variant}
use typeck.{check_expr, check_expr_list, tc_er, tc_report}
use diagnostics.{DiagCode}

/// Register the `Foo { x: 1, y: 2 }` struct literal feature.
export fn struct_lit_feature() -> Feature {
    feature_new("struct_lit") with {
        expr_tag: Expr.StructLit("", []),
        emit_expr: struct_lit_emit_expr,
        resolve_expr: struct_lit_resolve_expr,
        check_expr: struct_lit_check_expr,
    }
}

/// Register the `obj.field` field-access feature. Also handles
/// the `Type.STATIC` shape when the receiver starts with an
/// upper-case ident — that case skips name resolution.
export fn field_access_feature() -> Feature {
    feature_new("field_access") with {
        expr_tag: Expr.FieldAccess(Expr.None, ""),
        emit_expr: field_access_emit_expr,
        resolve_expr: field_access_resolve_expr,
        check_expr: field_access_check_expr,
    }
}

/// Register the `EnumName.Variant(args)` (and leading-dot
/// `.Variant(args)`) enum constructor feature. Lives next to
/// struct_lit because the parsing/typeck shape is similar.
export fn enum_ctor_feature() -> Feature {
    feature_new("enum_ctor") with {
        expr_tag: Expr.EnumCtor("", "", []),
        emit_expr: enum_ctor_emit_expr,
        resolve_expr: enum_ctor_resolve_expr,
        check_expr: enum_ctor_check_expr,
    }
}

/// Register the `obj.field = value` field-assign feature. The
/// resolver-side mutability check (deep immutability) is handled
/// directly in `resolve/mod.av`, so the resolver hook here is a
/// pass-through.
export fn field_assign_feature() -> Feature {
    feature_new("field_assign") with {
        expr_tag: Expr.FieldAssign(Expr.None, "", Expr.None),
        emit_expr: field_assign_emit_expr,
        // FieldAssign resolution is handled directly in resolve/mod.av (deep immutability check)
        resolve_expr: field_assign_resolve_expr,
        check_expr: field_assign_check_expr,
    }
}

/// Register the `type Foo = { ... }` declaration feature.
export fn type_decl_feature() -> Feature {
    feature_new("type_decl") with {
        decl_keyword: "kw_type",
        parse_decl: (p: Parser) -> p.parse_type_declaration(),
    }
}

/// Register the structural-typing `shape Foo = { ... }`
/// declaration feature. Shapes use width subtyping (spec Axis 1).
export fn shape_decl_feature() -> Feature {
    feature_new("shape_decl") with {
        decl_keyword: "kw_shape",
        parse_decl: (p: Parser) -> p.parse_shape_declaration(),
    }
}

/// Codegen hook for `StructLit`. Forwards to `emit_struct_lit`.
fn struct_lit_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .StructLit(name, inits) -> emit_struct_lit(ctx, env, name, inits)
        _ -> err_emit("expected StructLit")
    }
}

/// Resolver hook for `StructLit`. Walks every field's value
/// expression — the field names themselves don't go through the
/// resolver.
fn struct_lit_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .StructLit(_, inits) -> resolve_field_init_list(r, inits)
        _ -> r
    }
}

/// Type-check hook for `StructLit`. Type-checks every field
/// initializer and declares the result as `Struct(name)`.
fn struct_lit_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .StructLit(name, inits) -> {
            // An anonymous row (name == "") is a context-free `table { ... }`
            // whose row type was never pinned (c080 Phase C). Desugar stamps
            // the row type when the binding fixes it; anything reaching here
            // had no such context. Report rather than silently producing an
            // untyped value or an opaque `undefined struct ``` codegen ICE.
            if name == "" {
                let checked = check_field_inits(tc, inits)
                return tc_er(tc_report(checked, DiagCode.TableRowTypeMissing, "table literal has no row type"), .Unknown)
            }
            // Validate field names + scalar cell types against the declared
            // struct so a bad table column / cell is F1000, not a codegen ICE.
            tc_er(check_struct_lit_fields(tc, name, inits), .Struct(name, 0))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `FieldAccess`. Forwards to `emit_field_access`.
fn field_access_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .FieldAccess(obj, field) -> emit_field_access(ctx, env, obj, field)
        _ -> err_emit("expected FieldAccess")
    }
}

/// Resolver hook for `FieldAccess`. Skips name resolution when
/// the receiver is an upper-case identifier (to leave room for
/// `Type.STATIC` / `EnumName.Variant` shorthand). Otherwise
/// resolves the receiver normally.
fn field_access_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .FieldAccess(obj, _) -> {
            match obj {
                .Ident(name) -> {
                    if starts_with_upper(name) {
                        return r
                    }
                    resolve_expr(r, obj)
                }
                _ -> resolve_expr(r, obj)
            }
        }
        _ -> r
    }
}

/// Type-check hook for `FieldAccess`. Forwards to
/// `check_field_access` which knows about narrowing + enum
/// shorthand.
fn field_access_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .FieldAccess(obj, field) -> check_field_access(tc, obj, field)
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `EnumCtor`. Forwards to `emit_enum_ctor`.
fn enum_ctor_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .EnumCtor(type_name, variant, args) -> emit_enum_ctor(ctx, env, type_name, variant, args)
        _ -> err_emit("expected EnumCtor")
    }
}

/// Resolver hook for `EnumCtor`. Walks the constructor args.
fn enum_ctor_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .EnumCtor(_, _, args) -> resolve_expr_list(r, args)
        _ -> r
    }
}

/// Type-check hook for `EnumCtor`. Type-checks every arg and
/// resolves the enum name (the leading-dot shorthand is rewritten
/// to an explicit `EnumName.Variant` via the registry). Result
/// type is the enum.
fn enum_ctor_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .EnumCtor(type_name, variant, args) -> {
            let checked = check_expr_list(tc, args)
            let resolved_name = if type_name == "" { tc_enum_find_by_variant(tc.enums, variant) } else { type_name }
            let empty_args: List<ValueType> = []
            tc_er(checked, .Enum(resolved_name, empty_args, 0))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `FieldAssign`. Forwards to
/// `emit_field_assign`.
fn field_assign_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .FieldAssign(obj, field, value) -> emit_field_assign(ctx, env, obj, field, value)
        _ -> err_emit("expected FieldAssign")
    }
}

/// Resolver hook for `FieldAssign`. No-op — the deep-immutability
/// check happens in `resolve/mod.av` via a dedicated path.
fn field_assign_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    r
}

/// Type-check hook for `FieldAssign`. Checks the receiver and
/// the new value; the result type is the value's type.
fn field_assign_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .FieldAssign(obj, _, value) -> {
            let o = check_expr(tc, obj)
            let v = check_expr(o.tc, value)
            tc_er(v.tc, v.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
