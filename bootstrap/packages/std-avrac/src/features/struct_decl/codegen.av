// WHY: emits struct literal construction and field-filling.

use core.{Expr, SExpr, FieldEntry, FieldInit, VarBinding, field_index_of, ValueType, vtype_struct_name, vtype_render_full, vtype_is_str, vtype_is_bytes, vtype_is_list, vtype_is_map, vtype_narrowed_variant, vtype_enum_name, variant_lookup, render_expr}
use codegen.{Ctx, EmitValue, ok_emit, err_emit, null_ptr_val}
use core.{type_registry_id_for, vtype_struct}
use features.enum_decl.{emit_enum_ctor}
use features.union_type.{emit_union_wrap, needs_union_wrap}
use codegen.{emit_optional_coerce}

/// Codegen for `Foo { x: 1, y: 2 }`. Allocates the struct's
/// LLVM type via the arena (or reuses a Copy-type stack slot when
/// one is set), fills every field via `fill_struct_fields`, and
/// returns the buffer typed as `Struct(name)`.
export fn emit_struct_lit(ctx: Ctx, env: List<VarBinding>, name: string, inits: List<FieldInit>) -> Result<EmitValue, string> {
    let lookup = ctx.lookup_struct(name)
    if !lookup.found {
        return err_emit("undefined struct type `${name}`")
    }
    let st_ty = ctx.get_type(name)
    if st_ty == null {
        return err_emit("LLVM struct type `${name}` not declared")
    }
    let buf = malloc_struct_bytes(ctx, name, lookup.fields)
    let fill = fill_struct_fields(ctx, env, st_ty, buf, inits, lookup.fields)?
    let as_i64 = ctx.to_i64(buf, "struct_i64")
    ok_emit(as_i64, vtype_struct(name, type_registry_id_for(ctx.type_reg, name)))
}

/// Allocate `count * 8` bytes for a struct via the arena
/// allocator. Reuses `ctx.copy_alloc_target` when set so Copy-type
/// locals stay on the stack (spec 9.12) instead of heap-allocating.
fn malloc_struct_bytes(ctx: Ctx, name: string, fields: List<FieldEntry>) -> ptr {
    // Copy-type stack allocation (spec 9.12): if a pre-allocated stack
    // target exists (set by emit_var_decl), write directly into it.
    if ctx.copy_alloc_target != null {
        return ctx.copy_alloc_target
    }
    ctx.arena_alloc(ctx.i64(fields.length * 8))
}

/// Walk every field initializer in `inits`, GEP into the struct
/// buffer at the field's index, and store the value via
/// `store_field` (which casts to the field's declared LLVM type).
/// Concrete values flowing into union-typed fields are
/// auto-wrapped via `emit_union_wrap`.
fn fill_struct_fields(ctx: Ctx, env: List<VarBinding>, st_ty: ptr, alloca: ptr, inits: List<FieldInit>, fields: List<FieldEntry>) -> Result<EmitValue, string> {
    mut i = 0
    while i < inits.length {
        let init = inits[i]
        let idx = field_index_of(fields, init.name)
        if idx < 0 { return err_emit("unknown field `${init.name}`") }
        mut r = ctx.emit(env, init.value.node)?
        let fld_ty = ctx.resolve_field_type(fields, init.name)
        let gep = ctx.gep(st_ty, alloca, idx, "fld_ptr")
        // Optional box/unbox into the field's slot (no-op when neither applies).
        r = emit_optional_coerce(ctx, r, fld_ty)
        // Union wrapping: if field type is union and value is a concrete member
        if needs_union_wrap(r.ty, fld_ty) {
            let wrapped = emit_union_wrap(ctx, r.value, r.ty, fld_ty)?
            ctx.store_field(wrapped.value, gep, fld_ty)
        } else {
            ctx.store_field(r.value, gep, fld_ty)
        }
        i = i + 1
    }
    ok_emit(null_ptr_val(), .Void)
}

/// Codegen for `obj.field = value`. Looks up the field's index
/// in the receiver's struct registry entry, GEPs into the
/// underlying buffer, and stores the new value via `store_field`.
/// Auto-wraps for union-typed fields. Returns the assigned value
/// so chains like `a.b = c.d = ...` work.
export fn emit_field_assign(ctx: Ctx, env: List<VarBinding>, obj: Expr, field: string, value: Expr) -> Result<EmitValue, string> {
    let r = ctx.emit(env, obj)?
    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        return err_emit("field assignment on non-struct value (ty=${vtype_render_full(r.ty)})")
    }
    let lookup = ctx.lookup_struct(struct_name)
    if !lookup.found { return err_emit("unknown struct `${struct_name}` (emitting fn `${ctx.current_fn_name}`)") }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 { return err_emit("unknown field `${field}` on struct `${struct_name}`") }
    let st_ty = ctx.get_type(struct_name)
    let obj_ptr = ctx.to_ptr(r.value, "fa_ptr")
    let gep = ctx.gep(st_ty, obj_ptr, idx, "fa_fld")
    mut v = ctx.emit(env, value)?
    let fld_ty = ctx.resolve_field_type(lookup.fields, field)
    // Optional box/unbox into the field's slot (no-op when neither applies).
    v = emit_optional_coerce(ctx, v, fld_ty)
    if needs_union_wrap(v.ty, fld_ty) {
        let wrapped = emit_union_wrap(ctx, v.value, v.ty, fld_ty)?
        ctx.store_field(wrapped.value, gep, fld_ty)
        ok_emit(wrapped.value, wrapped.ty)
    } else {
        ctx.store_field(v.value, gep, fld_ty)
        ok_emit(v.value, v.ty)
    }
}

/// Codegen for `obj.field`. Recognises three shapes ahead of a
/// regular field load: (1) `EnumName.Variant` — emits a
/// zero-arg enum constructor; (2) `task.await` — joins the
/// task and types the result as the Task's payload type;
/// (3) `.length` on Str/List/Map — routes to the runtime helper.
/// Otherwise emits a struct-field GEP + load.
export fn emit_field_access(ctx: Ctx, env: List<VarBinding>, obj: Expr, field: string) -> Result<EmitValue, string> {
    // Bare `EnumName.Variant` (zero-arg enum constructor)
    let head_name = match obj { .Ident(h) -> h, .QualifiedIdent(h) -> h, _ -> "" }
    if head_name != "" {
        let enum_l = ctx.lookup_enum(head_name)
        if enum_l.found {
            let empty: List<SExpr> = []
            return emit_enum_ctor(ctx, env, head_name, field, empty)
        }
    }

    let r = ctx.emit_member(env, obj)?
    emit_field_on_value(ctx, r, obj, field)
}

/// Field/property access on an ALREADY-EMITTED receiver `r`. Split out of
/// emit_field_access so the optional chain (`obj?.field`) can reuse the exact
/// same dispatch on the UNWRAPPED receiver instead of re-stubbing it (which
/// silently returned the receiver for non-struct targets). `obj` is kept only
/// to render the error message. Covers `.await`, the str/bytes/list/map
/// `.length` builtins, narrowed-enum payloads, and plain struct fields.
export fn emit_field_on_value(ctx: Ctx, r: EmitValue, obj: Expr, field: string) -> Result<EmitValue, string> {
    // Task.await — join the thread and return its result with the Task's result type.
    if field == "await" {
        let result = ctx.call("avra_task_await", [r.value])
        let result_ty = match r.ty { .Task(rt) -> rt, _ -> ValueType.Unknown }
        return ok_emit(result, result_ty)
    }

    // String/Bytes/List/Map .length
    if vtype_is_str(r.ty) && field == "length" {
        let str_ptr = ctx.to_ptr(r.value, "len_arg")
        return ok_emit(ctx.call("strlen", [str_ptr]), .Int)
    }
    if vtype_is_bytes(r.ty) && field == "length" {
        let bp = ctx.to_ptr(r.value, "bytes_len_arg")
        return ok_emit(ctx.call("avra_bytes_length", [bp]), .Int)
    }
    if vtype_is_list(r.ty) && field == "length" {
        return ok_emit(ctx.array_len(r.value), .Int)
    }
    if vtype_is_map(r.ty) && field == "length" {
        return ok_emit(ctx.call("avra_map_len_cstr", [r.value]), .Int)
    }

    // Flow-sensitive narrowing: NarrowedEnum(enum, variant) allows
    // direct payload field access after `if x is .Variant`.
    let narrowed_vname = vtype_narrowed_variant(r.ty)
    if narrowed_vname != "" {
        return emit_narrowed_field(ctx, r, field, narrowed_vname)
    }

    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        let obj_repr = render_expr(obj)
        return err_emit("field access on non-struct value (ty=${vtype_render_full(r.ty)}, field=${field}, obj=${obj_repr}, at=${ctx.source_file}:${string(ctx.source_line)})")
    }
    let lookup = ctx.lookup_struct(struct_name)
    if !lookup.found { return err_emit("unknown struct `${struct_name}` (emitting fn `${ctx.current_fn_name}`)") }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 { return err_emit("unknown field `${field}` on struct `${struct_name}`") }
    ctx.null_check(r.value, field, struct_name)
    let field_ty = ctx.resolve_field_type(lookup.fields, field)
    let loaded = ctx.field_typed(r.value, struct_name, idx, field_ty, field)
    ok_emit(loaded, field_ty)
}

/// Extract a payload field from a narrowed enum value. The
/// value is a `ptr` to `{i64 tag, ptr payload}`; the payload
/// itself is a heap-allocated buffer with fields at slots 0, 1, …
/// Used after `if x is .Variant` narrowing so `x.field` reads
/// the variant's payload directly without re-checking the tag.
fn emit_narrowed_field(ctx: Ctx, r: EmitValue, field: string, vname: string) -> Result<EmitValue, string> {
    let en = vtype_enum_name(r.ty)
    let lookup = ctx.lookup_enum(en)
    if !lookup.found {
        return err_emit("unknown enum `${en}` in narrowed field access")
    }
    let v = variant_lookup(lookup.variants, vname)
    if !v.found {
        return err_emit("unknown variant `${vname}` in enum `${en}`")
    }
    let fields = ctx.resolve_fields(v.fields)
    let idx = field_index_of(fields, field)
    if idx < 0 {
        return err_emit("unknown field `${field}` on variant `${en}.${vname}`")
    }
    let field_ty = ctx.resolve_field_type(v.fields, field)
    // Navigate: enum_ptr -> payload_ptr -> field
    let enum_ty = ctx.get_type(en)
    let enum_ptr = ctx.to_ptr(r.value, "narrow_eptr")
    let pay_gep = ctx.gep(enum_ty, enum_ptr, 1, "narrow_pay_slot")
    let pay_ptr = ctx.load(ctx.ptr_type, pay_gep, "narrow_payload")
    let loaded = ctx.load_slot_typed(pay_ptr, idx, field_ty, "narrow_${field}")
    ok_emit(loaded, field_ty)
}
