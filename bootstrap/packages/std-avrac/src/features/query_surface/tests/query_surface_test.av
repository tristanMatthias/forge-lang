// WHY: the @query(Fam.Variant) surface (design §3.1/§3.3 + §10.B + ps3t.8.10) —
// families are named by an enum's variants, the dense int being the variant's
// `.ordinal` (ps3t.8.13, constant-folded). ONE `enum Fam` names every query AND
// input family, so their ordinals share a dense space and cannot collide by
// construction. Covers the generated per-query boilerplate (family/fetch/compute),
// the implicit engine imports, the F4013 shape diagnostics (fail-fast, reported
// once — a failed @query strips its annotation like a failed @derive), the
// program-wide duplicate-family check, and the single-enum invariant.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture, write_fixture_and_run}

// Compile-check a fixture, capturing diagnostics + a sentinel on success.
fn query_check_out(path: string, source: string) -> string {
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 check '${path}' 2>&1 && echo __AVRA_CHECK_OK__ || true")
}

// The family enum every runtime fixture shares: `Src` (ordinal 0) is the input
// family; `TextLen` (1) and `Doubled` (2) are compute families. One enum → one
// dense ordinal space → inputs and computes can never collide.
fn query_fam_enum() -> string {
    "enum Fam { Src, TextLen, Doubled }\n\n"
}

// The shared driver tail every runtime fixture appends: a main that fetches
// twice and prints the observable memo profile. NO hand-written dispatcher
// (ps3t.8.12) — `db_new(avra_query_dispatch)` uses the compiler-generated
// program-wide dispatcher routing every @query family. The input is set on
// `Fam.Src` (ordinal 0), the same family the @query fn reads.
fn query_driver_tail() -> string {
    "fn main() {\n" +
    "    let mut db: Db<string> = db_new(avra_query_dispatch)\n" +
    "    db.set_input(qk(Fam.Src.ordinal, 7), \"hello\", 42)\n" +
    "    let r1 = db.fetch(qk(text_len_family(), 7))\n" +
    "    match r1 {\n" +
    "        .Ok(f) -> println(\"len=\" + f.value)\n" +
    "        .Err(_) -> println(\"cycle\")\n" +
    "    }\n" +
    "    let r2 = db.fetch(qk(text_len_family(), 7))\n" +
    "    match r2 {\n" +
    "        .Ok(f) -> println(\"again=\" + f.value + \" computes=\" + string(db.computes_of(text_len_family())))\n" +
    "        .Err(_) -> println(\"cycle\")\n" +
    "    }\n" +
    "}\n"
}

// The @query fn every runtime fixture shares: reads the input on `Fam.Src`,
// answers with the text's length. `@query(Fam.TextLen)` names its family.
fn query_fn_decl() -> string {
    "@query(Fam.TextLen)\n" +
    "fn text_len(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
    "    let src = ctx.fetch(qk(Fam.Src.ordinal, arg))?\n" +
    "    Result.Ok(string(src.length))\n" +
    "}\n" +
    "\n"
}

spec "@query(Fam.Variant) generates a working memoized query" {
    then "family/fetch/compute drive the engine end-to-end and the second fetch is a memo hit" {
        let out = write_fixture_and_run("/tmp/avra_query_surface_basic_test.av",
            "use @std.avrac.query.{Db, QueryCtx, QueryKey, QueryCycle, Computed, db_new, qk, computed}\n" +
            "\n" +
            query_fam_enum() +
            query_fn_decl() +
            query_driver_tail())
        out.contains("len=5") && out.contains("again=5 computes=1")
    }
}

spec "@query implicit imports dedupe against the driver's own" {
    then "a fixture importing neither `computed` nor `content_id_for` still compiles and runs" {
        // The generated compute references computed + content_id_for;
        // the driver below imports NEITHER — the injection supplies
        // exactly the missing names without doubling the ones the
        // driver does import (qk, QueryKey, …).
        let out = write_fixture_and_run("/tmp/avra_query_surface_inject_test.av",
            "use @std.avrac.query.{Db, QueryCtx, QueryKey, QueryCycle, Computed, db_new, qk}\n" +
            "\n" +
            query_fam_enum() +
            query_fn_decl() +
            query_driver_tail())
        out.contains("len=5") && out.contains("again=5 computes=1")
    }
}

spec "a user symbol shadowing an engine name cannot capture generated code" {
    then "a same-named local `computed` fn leaves the generated adapter untouched" {
        // Generated code references the engine FULLY QUALIFIED, so the
        // driver's own `computed` — a plausible name for query code —
        // neither collides nor gets captured.
        let out = write_fixture_and_run("/tmp/avra_query_surface_shadow_test.av",
            "use @std.avrac.query.{Db, QueryCtx, QueryKey, QueryCycle, Computed, db_new, qk}\n" +
            "\n" +
            query_fam_enum() +
            "fn computed(tag: string) -> string {\n" +
            "    \"user-\" + tag\n" +
            "}\n" +
            "\n" +
            query_fn_decl() +
            query_driver_tail())
        out.contains("len=5") && out.contains("again=5 computes=1")
    }
}

spec "the generated fetch helper is itself dependency-recording" {
    then "a second query reading through text_len_fetch memoizes and recomputes correctly" {
        let out = write_fixture_and_run("/tmp/avra_query_surface_fetch_helper_test.av",
            "use @std.avrac.query.{Db, QueryCtx, QueryKey, QueryCycle, Computed, db_new, qk, computed}\n" +
            "use @std.avrac.core.{content_id_for}\n" +
            "\n" +
            query_fam_enum() +
            query_fn_decl() +
            "@query(Fam.Doubled)\n" +
            "fn doubled(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    let n = text_len_fetch(ctx, arg)?\n" +
            "    Result.Ok(n + n)\n" +
            "}\n" +
            "\n" +
            "fn main() {\n" +
            "    let mut db: Db<string> = db_new(avra_query_dispatch)\n" +
            "    db.set_input(qk(Fam.Src.ordinal, 7), \"hello\", 42)\n" +
            "    let r1 = db.fetch(qk(doubled_family(), 7))\n" +
            "    match r1 {\n" +
            "        .Ok(f) -> println(\"doubled=\" + f.value)\n" +
            "        .Err(_) -> println(\"cycle\")\n" +
            "    }\n" +
            "    // Same-hash re-set: no revision bump, everything stays memoized.\n" +
            "    db.set_input(qk(Fam.Src.ordinal, 7), \"hello\", 42)\n" +
            "    let r2 = db.fetch(qk(doubled_family(), 7))\n" +
            "    match r2 {\n" +
            "        .Ok(f) -> println(\"still=\" + f.value + \" computes=\" + string(db.computes_of(doubled_family())))\n" +
            "        .Err(_) -> println(\"cycle\")\n" +
            "    }\n" +
            "    // Real edit: the input changes, the chain recomputes through\n" +
            "    // the recorded text_len dependency.\n" +
            "    db.set_input(qk(Fam.Src.ordinal, 7), \"hi\", 43)\n" +
            "    let r3 = db.fetch(qk(doubled_family(), 7))\n" +
            "    match r3 {\n" +
            "        .Ok(f) -> println(\"edited=\" + f.value)\n" +
            "        .Err(_) -> println(\"cycle\")\n" +
            "    }\n" +
            "}\n")
        out.contains("doubled=55") && out.contains("still=55 computes=1") && out.contains("edited=22")
    }
}

spec "@query coexists with @derive in one program" {
    then "one pipeline pass expands both spellings" {
        let out = write_fixture_and_run("/tmp/avra_query_surface_with_derive_test.av",
            "use @std.avrac.query.{Db, QueryCtx, QueryKey, QueryCycle, Computed, db_new, qk, computed}\n" +
            "\n" +
            "@derive(Eq)\n" +
            "type Pt = { x: int, y: int }\n" +
            "\n" +
            query_fam_enum() +
            query_fn_decl() +
            "fn main() {\n" +
            "    let a = Pt { x: 1, y: 2 }\n" +
            "    let b = Pt { x: 1, y: 2 }\n" +
            "    println(\"eq=\" + string(a.eq(b)))\n" +
            "    let mut db: Db<string> = db_new(avra_query_dispatch)\n" +
            "    db.set_input(qk(Fam.Src.ordinal, 3), \"abc\", 9)\n" +
            "    match db.fetch(qk(text_len_family(), 3)) {\n" +
            "        .Ok(f) -> println(\"len=\" + f.value)\n" +
            "        .Err(_) -> println(\"cycle\")\n" +
            "    }\n" +
            "}\n")
        out.contains("eq=true") && out.contains("len=3")
    }
}

spec "the generated dispatcher errors loudly on an unregistered family (ps3t.8.12)" {
    then "fetching a family with no @query site hits avra_query_dispatch's panic fallthrough" {
        // Families are compiler-generated; a fetch reaching compute for an
        // unregistered family is a bug, so avra_query_dispatch panics rather
        // than silently defaulting. 4242 is claimed by no @query variant.
        let out = write_fixture_and_run("/tmp/avra_query_surface_unknown_family_test.av",
            "use @std.avrac.query.{Db, QueryCtx, QueryKey, QueryCycle, Computed, db_new, qk}\n" +
            "\n" +
            query_fam_enum() +
            query_fn_decl() +
            "fn main() {\n" +
            "    let mut db: Db<string> = db_new(avra_query_dispatch)\n" +
            "    db.set_input(qk(Fam.Src.ordinal, 0), \"x\", 1)\n" +
            "    let _ = db.fetch(qk(4242, 0))\n" +
            "    println(\"UNREACHABLE\")\n" +
            "}\n")
        out.contains("no @query family 4242 is registered") && !out.contains("UNREACHABLE")
    }
}

spec "@query without a family is F4013" {
    then "the bare annotation errors once and names the expected spelling" {
        let out = query_check_out("/tmp/avra_query_surface_bare_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "@query\n" +
            "fn q(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("@query(Fam.Variant)") && !out.contains("F4000")
    }
}

spec "the old hand-picked int form is rejected" {
    then "@query(1) is F4013 — families are now enum variants, not dense ints" {
        let out = query_check_out("/tmp/avra_query_surface_intform_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "@query(1)\n" +
            "fn q(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("enum-variant family") && !out.contains("F4000")
    }
}

spec "@query on a non-fn decl is F4013" {
    then "a type declaration cannot be a query" {
        let out = query_check_out("/tmp/avra_query_surface_nonfn_test.av",
            "enum Fam { A }\n" +
            "\n" +
            "@query(Fam.A)\n" +
            "type Pt = { x: int }\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("only to `fn`")
    }
}

spec "@query with the wrong signature is F4013" {
    then "a one-parameter fn errors with the expected shape" {
        let out = query_check_out("/tmp/avra_query_surface_arity_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "enum Fam { A }\n" +
            "\n" +
            "@query(Fam.A)\n" +
            "fn q(arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("got 1 parameter")
    }
    then "a non-string value type errors with the v1 hash rationale" {
        let out = query_check_out("/tmp/avra_query_surface_vtype_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "enum Fam { A }\n" +
            "\n" +
            "@query(Fam.A)\n" +
            "fn q(ctx: QueryCtx<int>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("content_id_for")
    }
}

spec "@query family constraints" {
    then "several family args are F4013 (exactly one enum variant)" {
        let out = query_check_out("/tmp/avra_query_surface_multiarg_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "enum Fam { A, B }\n" +
            "\n" +
            "@query(Fam.A, Fam.B)\n" +
            "fn q(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("enum-variant family")
    }
    then "@query on an extern fn is F4013 (only fn declarations)" {
        let out = query_check_out("/tmp/avra_query_surface_extern_test.av",
            "enum Fam { A }\n" +
            "\n" +
            "@query(Fam.A)\n" +
            "extern fn puts(s: string) -> int\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("F4013") && out.contains("only to `fn`")
    }
    then "two @query fns claiming one variant is F4013 at the second site" {
        let out = query_check_out("/tmp/avra_query_surface_dupfam_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "enum Fam { A, B }\n" +
            "\n" +
            "@query(Fam.A)\n" +
            "fn a(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "@query(Fam.A)\n" +
            "fn b(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("duplicate @query family `Fam.A`") && !out.contains("F4000")
    }
    then "two @query fns from DIFFERENT enums is F4013 (single-enum invariant)" {
        let out = query_check_out("/tmp/avra_query_surface_crossenum_test.av",
            "use @std.avrac.query.{QueryCtx, QueryCycle}\n" +
            "\n" +
            "enum FamA { X }\n" +
            "enum FamB { Y }\n" +
            "\n" +
            "@query(FamA.X)\n" +
            "fn a(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "@query(FamB.Y)\n" +
            "fn b(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> {\n" +
            "    Result.Ok(\"\")\n" +
            "}\n" +
            "\n" +
            "fn main() {}\n")
        out.contains("different enum") && !out.contains("F4000")
    }
}
