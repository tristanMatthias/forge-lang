// WHY: the `@query` surface (design §3.1/§3.3 + §12.5) — the ergonomic
// layer over the L6 query engine (src/query/mod.av), now that L4 exists to
// host it (§10.B: hand-wrapped memo until L4; L4 is here). `@query(Fam.Variant)`
// on a fn — the family is NAMED by a variant of one `enum Fam`:
//
//     enum Fam { Src, TextLen }        // Src (0) = input family, TextLen (1) = this query
//     @query(Fam.TextLen)
//     fn text_len(ctx: QueryCtx<string>, arg: int) -> Result<string, QueryCycle> { … }
//
// generates the three per-query boilerplate pieces a hand-wrapped driver
// needs; the program-level DISPATCHER is generated too (ps3t.8.12):
//
//     fn text_len_family() -> int              — `Fam.TextLen.ordinal` (folded)
//     fn text_len_fetch(ctx, arg) -> Result<V, QueryCycle>
//         — the ergonomic call-through: `ctx.fetch(qk(family, arg))`,
//         recording the dependency edge like any engine read.
//     fn text_len_compute(ctx, q) -> Result<Computed<V>, QueryCycle>
//         — the compute-arm adapter: runs the original fn, wraps its answer
//         in `computed(v, content_id_for(v))` for the memo store.
//
// The family's dense int (the engine's §2.1 contract: `Db.family(tag)` grows a
// dense list to `tag`, so it must be small and dense) is the variant's
// declaration-order `.ordinal` (ps3t.8.13) — the surface renders
// `Fam.TextLen.ordinal` into the generated code and CODEGEN constant-folds it;
// the surface never resolves it and needs no view of the enum decl. Because one
// `enum Fam` names every query AND its inputs (`qk(Fam.Src.ordinal, …)`), all
// families are that enum's ordinals 0..n-1 and CANNOT collide — a guarantee the
// old hand-picked int could not give. The surface enforces it: exactly one
// `Fam.Variant` per site, no two sites claiming the same variant, and every
// site drawing from the SAME enum (the expansion walk's seen-set — §12.5).
//
// Generated names use SINGLE-underscore suffixes: the dispatcher references
// them by hand, and spec Axis 28 reserves `__` for compiler-generated
// dispatch symbols users never type.
//
// V is `string` OR a non-generic `Hash`-deriving type (ps3t.8.11): the
// adapter's early-cutoff key is V's CONTENT HASH — `content_id_for` for
// `string` (string-keyed, byte-identical to v1), `v.hash()` (from
// @derive(Hash)) otherwise. The engine was always generic over V; the surface
// widened once L4 grew a per-type Hash capability to key on. A generic or
// non-nominal V (int, list, tuple, a bare type param) is a precise F4013,
// never a confusing downstream typeck error; a nominal V that never derived
// Hash fails loudly at the generated `v.hash()`.
//
// Generation renders SOURCE TEXT and parses it back through
// `parse_program_source_shared` into the caller's arena — the same
// synthesize-then-parse route the metadata roundtrip trusts — so the
// generated decls flow through the expansion pipeline's re-resolve +
// re-typecheck exactly like interpreted macro output ("generated code is
// re-resolved", design §3.2). Placement note: design §3.3 names
// features/derive/ for the surface, but that directory-module imports
// features.comptime while THIS module's consumer IS features.comptime —
// the same cycle that moved the capability registry to its own leaf
// (features/derive_registry); the query surface lives beside it for the
// same reason.

use core.{NodeStore, StmtId, Stmt, Expr, ValueType, ParamEntry, find_annotation, type_short_name}
use parse.{parse_program_source_shared}

/// A `@query(Fam.Variant)` family reference: the enum name and the variant
/// naming the family. The family's dense int is the variant's ORDINAL,
/// resolved and constant-folded at codegen via the `.ordinal` accessor
/// (ps3t.8.13) — the surface never computes it, it renders `Fam.Variant.ordinal`
/// into the generated code. `key` ("Fam.Variant") is the program-wide
/// duplicate identity.
export type QueryFamilyRef = { enum_name: string, variant: string, key: string }

/// Result of one `@query` expansion: the generated decl ids (family +
/// fetch + compute, NOT the original — the caller re-splices the
/// stripped original itself, mirroring the native-Marshal contract), the
/// family's identity (`family` = "Fam.Variant" for the caller's program-wide
/// duplicate check; `family_enum` = "Fam" for the single-enum check that
/// makes cross-family collisions impossible by construction), or a
/// shape-violation message for the caller's F4013 (the caller owns the
/// diagnostic so it carries the annotation site's span). `fn_name` is the
/// BARE query fn name (short, unqualified) the generated siblings are named
/// after — the module/metadata pipeline hands the surface a module-qualified
/// name, so the caller uses `fn_name` (not the raw decl name) for the
/// dispatcher's arms + cross-module `use`.
export type QuerySurfaceOut = { stmts: List<StmtId>?, family: string, family_enum: string, fn_name: string, error: string }

/// One @query site as the dispatcher needs to see it: the fn `name` plus the
/// `module` it was declared in ("" = the program's top module). The dispatcher
/// is spliced at program level, so a site in `mod producer` (module="producer")
/// needs a generated `use producer.{name_family, name_compute}` to reach its
/// exported siblings; a top-level site is already in scope.
export type QuerySite = { module: string, name: string }

fn qs_fail(msg: string) -> QuerySurfaceOut {
    QuerySurfaceOut { stmts: null, family: "", family_enum: "", fn_name: "", error: msg }
}

/// The one shape `@query` accepts, stated once for every diagnostic. `V` is
/// the value type — `string` or a non-generic type deriving `Hash` (ps3t.8.11).
fn qs_expected() -> string {
    "`@query(Fam.Variant)` fn must be `fn name(ctx: QueryCtx<V>, arg: int) -> Result<V, QueryCycle>` (V = `string` or a `Hash`-deriving type)"
}

/// Expand one `@query`-annotated declaration. `node` is the decl WITH
/// its annotation layers (the family enum-variant lives on the annotation),
/// `inner` the same decl unwrapped.
export fn query_surface_stmts_for(store: NodeStore, node: Stmt, inner: Stmt) -> QuerySurfaceOut {
    let fam = query_family_ref(store, node)
    if fam == null {
        return qs_fail("@query needs an enum-variant family — `@query(Fam.Variant)`, where `enum Fam { … }` names every query and input family in one place. The family's dense int is the variant's `.ordinal` (its declaration-order position), so families never collide by construction")
    }
    match inner {
        .Function(name, type_params, params, ret, _) ->
            build_query_surface(store, name, fam!, type_params, params, ret)
        _ -> qs_fail("@query applies only to `fn` declarations")
    }
}

/// The `Fam.Variant` of `@query(Fam.Variant)`: the annotation's single
/// enum-variant argument, null for any other arg shape (missing, several,
/// an int, an arbitrary expression). `Fam.Variant` parses as
/// `FieldAccess(Ident("Fam"), "Variant")` (parens-less enum-ctor shape) —
/// the surface renders it back as `Fam.Variant.ordinal`, so the ordinal
/// (a dense compile-time int) is resolved by codegen, not here.
///
/// Statement-match + early returns rather than a match EXPRESSION with
/// `null` arms: the null-mix `T?` merge discipline (don't rely on
/// just-fixed arm-merge semantics in compiler src until the seed advances).
fn query_family_ref(store: NodeStore, node: Stmt) -> QueryFamilyRef? {
    let found = find_annotation(store, node, "query")
    if found == null || found!.arg_ids == none || found!.arg_ids!.length != 1 { return null }
    match store.exprs.get(found!.arg_ids![0]) {
        // `Fam.Variant` parses as a FieldAccess. Its head is a bare `Ident`
        // pre-resolve (the no-metadata single-file path) but a `QualifiedIdent`
        // once the module path qualified it (the metadata / build_binary
        // pipeline expands POST-qualification). `type_short_name` yields the
        // bare enum name in both cases — and the bare name is exactly what the
        // generated `Fam.Variant.ordinal` (spliced into the query's OWN module,
        // where `Fam` is in scope) must resolve against.
        .FieldAccess(head_id, variant) -> {
            let en = match store.exprs.get(head_id) {
                .Ident(n) -> type_short_name(n)
                .QualifiedIdent(n) -> type_short_name(n)
                _ -> ""
            }
            if en != "" { return QueryFamilyRef { enum_name: en, variant, key: "${en}.${variant}" } }
        }
        // A resolver arm may reclassify `Fam.Variant` into a zero-arg enum ctor.
        .EnumCtor(tn, variant, args) -> {
            if tn != "" && args.length == 0 {
                let en = type_short_name(tn)
                return QueryFamilyRef { enum_name: en, variant, key: "${en}.${variant}" }
            }
        }
        _ -> {}
    }
    null
}

fn build_query_surface(store: NodeStore, name: string, fam: QueryFamilyRef, type_params: List<string>, params: List<ParamEntry>, ret: ValueType) -> QuerySurfaceOut {
    if type_params.length > 0 {
        return qs_fail("@query fn cannot be generic — the memo key is `(family, arg)`, monomorphic by construction")
    }
    if params.length != 2 {
        return qs_fail("${qs_expected()} — got ${string(params.length)} parameter(s)")
    }
    // Param 0: QueryCtx<V>. Kind-agnostic base-name match (a parser-default
    // Struct and a resolved nominal of the same name are the same type
    // pre/post-rewrite), short-name so an already-qualified reference still
    // matches. V is `string` (engine-hashed via content_id_for) or a
    // non-generic `Hash`-deriving type (adapter calls `v.hash()`) — ps3t.8.11.
    let ctx_args = named_type_args(params[0].vtype, "QueryCtx")
    if ctx_args == null {
        return qs_fail("${qs_expected()} — first parameter is `${vt_debug(params[0].vtype)}`, not `QueryCtx<V>`")
    }
    if ctx_args!.length != 1 {
        return qs_fail("${qs_expected()} — `QueryCtx` takes exactly one value-type argument")
    }
    let vparam = ctx_args![0]
    let vr = query_value_render(vparam)
    if vr == null {
        return qs_fail("@query value type must be `string` or a non-generic type deriving `Hash` — `${vt_debug(vparam)}` is neither. The generated adapter's early-cutoff key needs a content hash: `content_id_for` for `string`, `v.hash()` (from `@derive(Hash)`) otherwise")
    }
    // Param 1: int — the engine's argument key.
    if !(params[1].vtype is .Int) {
        return qs_fail("${qs_expected()} — second parameter is `${vt_debug(params[1].vtype)}`, not `int` (the engine keys queries by `(family, int arg)`)")
    }
    // Return: Result<V, QueryCycle> — the SAME V as the ctx (both name the
    // one memoised value type).
    let ret_args = named_type_args(ret, "Result")
    if ret_args == null || ret_args!.length != 2 || named_type_args(ret_args![1], "QueryCycle") == null {
        return qs_fail("${qs_expected()} — return type is `${vt_debug(ret)}`, not `Result<${vr!}, QueryCycle>`")
    }
    let vret = query_value_render(ret_args![0])
    if vret == null || vret! != vr! {
        return qs_fail("@query value type mismatch — the context is `QueryCtx<${vr!}>` but the return is `Result<${vt_debug(ret_args![0])}, …>`; both must name the same value type")
    }

    // The generated siblings are named after the BARE query fn name and call
    // the original fn UNqualified — both resolve in the query's own module. The
    // module/metadata pipeline hands us a qualified name (`producer::text_len`);
    // `type_short_name` recovers `text_len`. Single-module names are already
    // short, so `sname == name` there → byte-identical.
    let sname = type_short_name(name)
    // The family's dense int is the variant's declaration-order `.ordinal`
    // (ps3t.8.13) — rendered into the generated code and constant-folded by
    // codegen, so the surface never resolves it and needs no view of the
    // enum decl. Referencing the driver's own `Fam` unqualified is correct:
    // the generated decls splice into the driver's module, where `Fam` is in
    // scope exactly as the annotation saw it.
    let fexpr = "${fam.enum_name}.${fam.variant}.ordinal"
    // Every ENGINE/CORE reference is FULLY QUALIFIED — the same rendering
    // the metadata roundtrip re-parses — so the generated code resolves
    // regardless of the driver's imports: no implicit injection to keep in
    // sync, and a user's own same-named symbol (their `computed`, say)
    // can never capture a generated reference.
    let q = "@std::avrac::query::"
    // V's rendered type + its early-cutoff hash expression (ps3t.8.11): for
    // `string` these are `string` + `content_id_for(v)` — BYTE-IDENTICAL to
    // the v1 template — so single-string @query output (and diff-test) is
    // unchanged; a `Hash`-deriving V renders its own name + `v.hash()`.
    let vhash = query_value_hash_expr(vparam)
    // `export` so a program-level dispatcher can `use` these across a module
    // boundary (ps3t.8.14). Codegen-neutral: `export` is an @export annotation
    // the resolver's visibility pass consumes and codegen peels via stmt_unwrap,
    // so a single-module program's IR is byte-identical.
    let src = "export fn ${sname}_family() -> int {\n" +
        "    ${fexpr}\n" +
        "}\n" +
        "export fn ${sname}_fetch(ctx: ${q}QueryCtx<${vr!}>, arg: int) -> Result<${vr!}, ${q}QueryCycle> {\n" +
        "    ctx.fetch(${q}qk(${fexpr}, arg))\n" +
        "}\n" +
        "export fn ${sname}_compute(ctx: ${q}QueryCtx<${vr!}>, qkey: ${q}QueryKey) -> Result<${q}Computed<${vr!}>, ${q}QueryCycle> {\n" +
        "    let v = ${sname}(ctx, qkey.arg)?\n" +
        "    Result.Ok(${q}computed(v, ${vhash}))\n" +
        "}\n"
    let parsed = parse_program_source_shared(src, "<@query ${sname}>", store)
    if parsed.had_error == 1 || parsed.ids == null {
        // Unreachable by construction — the template is closed over a
        // validated identifier + a validated `Fam.Variant`. Surfaced as an
        // error (not a silent skip) so a template regression is loud.
        return qs_fail("internal: generated @query surface for `${name}` failed to parse")
    }
    QuerySurfaceOut { stmts: parsed.ids, family: fam.key, family_enum: fam.enum_name, fn_name: sname, error: "" }
}

/// Synthesise the program-level query dispatcher (ps3t.8.12 + ps3t.8.14): ONE
/// `avra_query_dispatch(ctx, q)` routing `q.family` to each @query site's
/// generated `<name>_compute`, retiring the hand-written driver dispatcher
/// (the old §10.B "hand-wrapped memo" contract — obsolete now that the
/// whole-program derive walk collects every site). `sites` is every @query
/// site the walk saw (fn name + declaring module), in source order. Returns
/// the generated stmts (the `use` imports it needs, then the dispatcher fn),
/// or null when there are no sites (nothing to dispatch).
///
/// CROSS-MODULE (ps3t.8.14): a site in `mod producer` has its generated
/// `producer::name_compute` out of the program-level dispatcher's scope, and
/// `mod::fn()` qualified calls don't parse — so the dispatcher instead
/// `use producer.{name_family, name_compute}` (the site's siblings are
/// `export`ed) and calls them unqualified, exactly the import-based cross-module
/// path @marshal's decode uses (t-tiz0/#869). A top-level site (module "") is
/// already in scope and needs no import — so single-module output is unchanged.
///
/// Engine refs are FULLY QUALIFIED (like the per-site siblings) so the
/// dispatcher resolves regardless of the driver's imports. An unregistered
/// family `panic`s LOUDLY — families are compiler-generated and inputs are
/// `set_input`-only, so a fetch reaching compute for an unknown family is a
/// bug, never a silent default (design §10.B / the ticket's loud-error rule).
export fn build_query_dispatcher(store: NodeStore, sites: List<QuerySite>) -> List<StmtId>? {
    if sites.length == 0 { return null }
    let q = "@std::avrac::query::"
    mut uses = ""
    mut arms = ""
    for s in sites {
        if s.module != "" {
            uses = uses + "use ${s.module}.{${s.name}_family, ${s.name}_compute}\n"
        }
        arms = arms + "    if q.family == ${s.name}_family() { return ${s.name}_compute(ctx, q) }\n"
    }
    let src = uses +
        "fn avra_query_dispatch(ctx: ${q}QueryCtx<string>, q: ${q}QueryKey) -> Result<${q}Computed<string>, ${q}QueryCycle> {\n" +
        arms +
        "    panic(\"avra_query_dispatch: no @query family \" + string(q.family) + \" is registered — @query families are compiler-generated; a fetch reached compute for an unset input or unknown family\")\n" +
        "}\n"
    let parsed = parse_program_source_shared(src, "<@query dispatch>", store)
    if parsed.had_error == 1 || parsed.ids == null || parsed.ids!.length == 0 {
        // Unreachable by construction — the template is closed over validated
        // @query fn names + module paths. Surfaced as null (caller drops the
        // dispatcher, and the driver's own db_new call then fails loudly).
        return null
    }
    parsed.ids
}

// ── ValueType shape probes (local, pre/post-resolve tolerant) ──────────

/// The type args of a named (Struct/Enum) type whose SHORT base name is
/// `want`; null when `vt` isn't that named type. Kind-agnostic: the
/// parser defaults named types to Struct, resolve may re-kind them.
fn named_type_args(vt: ValueType, want: string) -> List<ValueType>? {
    match vt {
        .Struct(n, args, _) -> if type_short_name(n) == want { args } else { null }
        .Enum(n, args, _) -> if type_short_name(n) == want { args } else { null }
        _ -> null
    }
}

/// The parse-valid source rendering of a @query value type V, or null when V
/// isn't a legal query value (ps3t.8.11). A legal V is `string` — hashed by
/// the engine's built-in `content_id_for` — or a NON-GENERIC named struct/
/// enum, which must derive `Hash` (the generated adapter calls `v.hash()`).
/// The bare SHORT name is rendered: it resolves in the driver's module
/// exactly as the original fn's own `QueryCtx<V>` signature did. A generic V
/// (type args present) or any non-nominal V (int, list, tuple, a bare type
/// param) is rejected — those have no derivable content hash.
fn query_value_render(v: ValueType) -> string? {
    match v {
        .Str -> "string"
        .Struct(n, args, _) -> if args.length == 0 { type_short_name(n) } else { null }
        .Enum(n, args, _) -> if args.length == 0 { type_short_name(n) } else { null }
        _ -> null
    }
}

/// The early-cutoff value-hash EXPRESSION the compute adapter wraps V's
/// answer with (over the bound `v`). `string` hashes through the engine's
/// string-keyed `content_id_for` — byte-identical to v1; any other legal V
/// hashes through its derived `v.hash()` (`@derive(Hash)`, ps3t.8.11). A V
/// that reached here but never derived Hash fails LOUDLY at the generated
/// `.hash()` — the same generated-code error contract the derive emitters use.
fn query_value_hash_expr(v: ValueType) -> string {
    match v {
        .Str -> "@std::avrac::core::content_id_for(v)"
        _ -> "v.hash()"
    }
}

/// Render a type for shape diagnostics. Local minimal renderer: the
/// full `vtype_display` lives in core/ast.av but drops type-arg detail
/// for named types; diagnostics here need the base shape with args.
fn vt_debug(vt: ValueType) -> string {
    match vt {
        .Struct(n, args, _) -> named_debug(n, args)
        .Enum(n, args, _) -> named_debug(n, args)
        .Int -> "int"
        .Str -> "string"
        .Bool -> "bool"
        _ -> "<non-nominal type>"
    }
}

fn named_debug(n: string, args: List<ValueType>) -> string {
    if args.length == 0 { return n }
    mut inner = ""
    for a in args {
        let r = vt_debug(a)
        inner = if inner == "" { r } else { "${inner}, ${r}" }
    }
    "${n}<${inner}>"
}
