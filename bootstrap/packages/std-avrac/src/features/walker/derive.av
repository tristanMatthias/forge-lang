// WHY: derive_walker is the walk-plan client of the unified derive engine
// (features/derive, ps3t.6.2). The ~1200 lines that used to live here —
// the FieldKind classifier, the per-variant arm builders, the fn
// assemblers — moved down into the engine (classify.av / emit.av) and the
// walk emitter (walk.av), where a second emitter reuses the traversal and
// classification for free. This file keeps only the macro's public
// identity, so every `use features.walker.{derive_walker}` site and
// `@expand(derive_walker)` annotation is untouched.
//
// Emitted AST is byte-identical to the pre-engine walker (HRN diff-test
// gated): `Type__children / __all_children_spanned / __visit / __any /
// __find / __map` on any AST enum.

use features.comptime.{AnnotatedDecl, ResolverCtx, ResolvedDecls}
use features.derive.{derive_engine, walk_plan}

/// 2-arg @comptime macro: inspect the annotated enum, emit the six walker
/// methods (parser-style mangled `Type__method` names) so codegen's
/// dot-notation dispatch finds them via the standard method-lookup path.
/// On any failure (wrong stmt shape, etc.) returns the target decl
/// untouched so downstream errors are about the user's intent, not about
/// the macro hitting an internal corner case.
@comptime
export fn derive_walker(target: AnnotatedDecl, ctx: ResolverCtx) -> ResolvedDecls {
    derive_engine(target, ctx, walk_plan())
}
