// WHY: @comptime derive that auto-generates `children(self) -> List<Self>`
// on any AST enum. Replaces hand-rolled walker recursion across the
// bootstrap. First slice: `children` only; fold/map/visit/find/any
// will layer on top in follow-ups.
//
// How it works
//   1. The macro receives the EnumDecl as `target.stmt` and a
//      ResolverCtx (unused in this slice — types come straight from
//      the variant fields' `resolved` ValueType).
//   2. For each variant, classify every field: if `field.resolved`
//      is `Enum(enum_name, _, _)` or `Struct(enum_name, _)` whose
//      name matches the parent enum, it's a child; otherwise scalar.
//   3. Build one match arm per variant — pattern binds children by
//      name, scalars to `_`, body is `[c1, c2, ...]`.
//   4. Emit a top-level `Type__children` fn (parser-style mangled
//      method name) so codegen's dot-notation dispatch finds it
//      via the standard method-lookup path.

use core.{Stmt, SStmt, Expr, SExpr, ParamEntry, TypeParamEntry, Pattern, MatchArm, ValueType, Variant, FieldEntry, sexpr_dummy, sstmt_dummy, type_short_name}
use features.comptime.{AnnotatedDecl, ResolverCtx, ResolvedDecls, DeclSymbol, DeclKind, MacroProvenance}
use diagnostics.{Span}

// ── Public entry ──

/// 2-arg @comptime macro: inspect the annotated enum, emit a
/// `Type__children` fn callable as `value.children() -> List<Type>`.
/// On any failure (wrong stmt shape, etc.) returns the target decl
/// untouched so downstream errors are about the user's intent, not
/// about the macro hitting an internal corner case.
@comptime
export fn derive_walker(target: AnnotatedDecl, ctx: ResolverCtx) -> ResolvedDecls {
    let view = unwrap_enum_decl(target.stmt)
    if view.name == "" {
        return failsafe_decls(target)
    }

    // The macro emits the bare enum name in the synthesised
    // ValueType.Enum; the resolver's rewrite_vtype pass qualifies
    // each Enum-typed slot to the canonical path on its own, just
    // like a hand-written `fn children(self: Pattern) -> List<Pattern>`
    // would resolve. Pre-qualifying here produces doubly-prefixed
    // names (`@std::avrac::core::@std::avrac::core::Pattern`) when
    // the spliced fn is re-processed by the post-expand rewrite.
    let arms = build_children_arms(view.variants, view.name)
    let children_fn = build_children_fn(arms, view.name)
    let visit_fn = build_visit_fn(view.name)
    let any_fn = build_any_fn(view.name)
    let find_fn = build_find_fn(view.name)

    let decls: List<SStmt> = [
        sstmt_dummy(target.stmt),
        sstmt_dummy(children_fn),
        sstmt_dummy(visit_fn),
        sstmt_dummy(any_fn),
        sstmt_dummy(find_fn),
    ]
    let children_mangled = "${view.name}__children"
    let visit_mangled = "${view.name}__visit"
    let any_mangled = "${view.name}__any"
    let find_mangled = "${view.name}__find"
    // Mangled `Type__method` names register so the introduces-
    // validation pass can find them in the spliced decl list.
    let introduces: List<DeclSymbol> = [
        DeclSymbol {
            name: children_mangled,
            kind: DeclKind.Method(view.name),
            canonical_path: children_mangled,
        },
        DeclSymbol {
            name: visit_mangled,
            kind: DeclKind.Method(view.name),
            canonical_path: visit_mangled,
        },
        DeclSymbol {
            name: any_mangled,
            kind: DeclKind.Method(view.name),
            canonical_path: any_mangled,
        },
        DeclSymbol {
            name: find_mangled,
            kind: DeclKind.Method(view.name),
            canonical_path: find_mangled,
        },
    ]
    let provenance = MacroProvenance {
        macro_name: "derive_walker",
        target_canonical: view.name,
        target_source_span: Span { start: 0, end: 0, line: 0, col: 0, file: "" },
    }
    ResolvedDecls { decls, introduces, provenance }
}

// ── Target-decl unwrapping ──

type EnumView = { name: string, variants: List<Variant> }

/// Returns the enum's name + variants when `s` is an EnumDecl; an
/// empty view (`name == ""`) otherwise. invoke_macro already strips
/// the Annotated wrapper, so we only need to match EnumDecl directly.
@comptime
fn unwrap_enum_decl(s: Stmt) -> EnumView {
    let empty: List<Variant> = []
    match s {
        .EnumDecl(name, _, variants) -> EnumView { name, variants }
        _ -> EnumView { name: "", variants: empty }
    }
}

/// Empty-output failsafe — emits just the original decl, no methods.
/// Keeps the AST shape correct so downstream diagnostics blame the
/// user code, not a missing decl from a silent macro failure.
@comptime
fn failsafe_decls(target: AnnotatedDecl) -> ResolvedDecls {
    let decls: List<SStmt> = [sstmt_dummy(target.stmt)]
    let no_syms: List<DeclSymbol> = []
    let provenance = MacroProvenance {
        macro_name: "derive_walker",
        target_canonical: "",
        target_source_span: Span { start: 0, end: 0, line: 0, col: 0, file: "" },
    }
    ResolvedDecls { decls, introduces: no_syms, provenance }
}

// ── Per-variant arm construction ──

/// One field's role in the children() result. so07.7.6 replaced the
/// int-coded `kind` + sentinel-empty `unwrap_fn` with a proper enum.
/// WrapperListOfSelf carries its unwrap helper name on the variant
/// where it belongs.
enum FieldKind {
    Scalar,
    DirectSelf,
    ListOfSelf,
    WrapperListOfSelf(unwrap_fn: string),
}

type Binding = { binding_name: string, kind: FieldKind }

@comptime
fn build_children_arms(variants: List<Variant>, parent_name: string) -> List<MatchArm> {
    mut arms: List<MatchArm> = []
    for v in variants {
        arms.push(build_one_arm(v, parent_name))
    }
    arms
}

@comptime
fn build_one_arm(v: Variant, parent_name: string) -> MatchArm {
    let bindings = classify_variant(v, parent_name)
    let pat = pattern_for(v.name, bindings)
    let body = arm_body(bindings)
    MatchArm {
        pattern: pat,
        guard: null,
        body: sexpr_dummy(body),
    }
}

/// True when `vt` refers to the same type as the enum being walked.
/// Post-resolve, an `enum Tree { Node(left: Tree, ...) }` field has
/// `resolved = Enum("Tree", _, id)` (or `Struct("Tree", id)` if the
/// parser fell back to Struct because the type wasn't yet known to be
/// an enum). The comparison handles both shapes and tolerates the
/// canonical-vs-short-name distinction by matching either the full
/// path or a trailing `::Name` suffix.
///
/// Helpers live inline (not imported from `core`) because eval can
/// only call `@comptime` fns; copying the few lines we need keeps
/// derive_walker eval-safe without leaking @comptime onto core.
@comptime
fn is_self_type(vt: ValueType, parent_name: string) -> bool {
    let n = self_type_name(vt)
    if n == "" { return false }
    name_matches(n, parent_name)
}

@comptime
fn self_type_name(vt: ValueType) -> string {
    match vt {
        .Enum(name, _, _) -> name
        .Struct(name, _) -> name
        .NarrowedEnum(name, _, _) -> name
        _ -> ""
    }
}

/// True when `candidate` and `parent_name` refer to the same nominal
/// type. Accepts: exact match, candidate is `<...>::parent_name`, or
/// parent_name is `<...>::candidate` — the qualification can land on
/// either side depending on whether the field's `resolved` slot or
/// the enum's `view.name` carries the fully-qualified path at
/// macro-eval time. y9y4.11 hit this: wrapper_inner_type returns the
/// bare "Stmt" while view.name is the qualified
/// "@std::avrac::core::Stmt", so the original one-direction suffix
/// match (qualified ENDS WITH "::" + bare) missed in this direction.
@comptime
fn name_matches(candidate: string, parent_name: string) -> bool {
    if candidate == parent_name { return true }
    if ends_with_qualified(candidate, parent_name) { return true }
    ends_with_qualified(parent_name, candidate)
}

/// True iff `qualified` ends with `"::" + short`. Both arguments
/// non-empty; caller checks equality before calling.
@comptime
fn ends_with_qualified(qualified: string, short: string) -> bool {
    let ql = qualified.length
    let sl = short.length
    if ql < sl + 2 { return false }
    let tail = qualified.substring(ql - sl, ql)
    if tail != short { return false }
    qualified.substring(ql - sl - 2, ql - sl) == "::"
}

@comptime
fn classify_variant(v: Variant, parent_name: string) -> List<Binding> {
    mut out: List<Binding> = []
    for f in v.fields {
        let kind = classify_field_kind(f.resolved, parent_name)
        let bind = if kind is .Scalar { "_" } else { f.name }
        out.push(Binding { binding_name: bind, kind })
    }
    out
}

/// Decide what role a single field plays in `children()`. Direct
/// Self / List<Self> are detected first; wrapper-lists (List<SStmt>
/// for Stmt etc.) fall to WrapperListOfSelf carrying the unwrap
/// helper name. Anything else stays Scalar.
@comptime
fn classify_field_kind(vt: ValueType, parent_name: string) -> FieldKind {
    if is_self_type(vt, parent_name) { return FieldKind.DirectSelf }
    if is_list_of_self(vt, parent_name) { return FieldKind.ListOfSelf }
    let unwrap = wrapper_list_unwrap_fn(vt, parent_name)
    if unwrap != "" { return FieldKind.WrapperListOfSelf(unwrap) }
    FieldKind.Scalar
}

/// Extract the unwrap helper name from a WrapperListOfSelf binding;
/// returns "" for the other kinds (caller gates on `kind is .WrapperListOfSelf`
/// first, so the empty case is a defensive default).
@comptime
fn unwrap_fn_of(k: FieldKind) -> string {
    match k {
        .WrapperListOfSelf(fn_name) -> fn_name
        _ -> ""
    }
}

/// True when `vt` is `List<X>` where `X` is the parent type. Covers the
/// declared-list shapes like `Pattern.NestedVariant(_, sub_patterns:
/// List<Pattern>)` and `ValueType.Tuple(elements: List<ValueType>)`.
@comptime
fn is_list_of_self(vt: ValueType, parent_name: string) -> bool {
    match vt {
        .List(elem) -> is_self_type(elem, parent_name)
        _ -> false
    }
}

/// When `vt` is `List<Wrapper>` and `Wrapper` is a known span-wrapper
/// around the parent type (SStmt around Stmt, SExpr around Expr),
/// return the runtime unwrap helper's name. Otherwise return `""`.
/// y9y4.11 — keeps the per-wrapper unwrap table small and explicit.
/// Future wrappers (MatchArm with .body.node, FieldInit with
/// .value.node) need their own helpers + a richer projection path.
@comptime
fn wrapper_list_unwrap_fn(vt: ValueType, parent_name: string) -> string {
    let elem = list_elem_or_unknown(vt)
    let wrapper = type_short_name(self_type_name(elem))
    if wrapper == "" { return "" }
    let inner = wrapper_inner_type(wrapper)
    if inner == "" { return "" }
    if !name_matches(inner, parent_name) { return "" }
    wrapper_unwrap_helper(wrapper)
}

@comptime
fn list_elem_or_unknown(vt: ValueType) -> ValueType {
    match vt {
        .List(elem) -> elem
        _ -> ValueType.Unknown
    }
}

/// The wrapper-type → wrapped-type table. Hardcoded for the two
/// span-wrappers std-avrac uses today; extend here when adding new
/// wrapper types whose `.node` projection should be exposed by the
/// derived walkers.
@comptime
fn wrapper_inner_type(wrapper_name: string) -> string {
    if wrapper_name == "SStmt" { return "Stmt" }
    if wrapper_name == "SExpr" { return "Expr" }
    ""
}

/// The wrapper-type → runtime-unwrap-helper table. The helpers live
/// in core/ast.av next to the wrapper struct decls.
@comptime
fn wrapper_unwrap_helper(wrapper_name: string) -> string {
    if wrapper_name == "SStmt" { return "unwrap_sstmt_list" }
    if wrapper_name == "SExpr" { return "unwrap_sexpr_list" }
    ""
}


/// `.VariantName(b1, b2, b3)` pattern. Each binding becomes a
/// ParamEntry — same shape the parser produces for the simple
/// bind form `.Variant(x, y)`. `_` is a valid binding name here.
@comptime
fn pattern_for(variant_name: string, bindings: List<Binding>) -> Pattern {
    mut params: List<ParamEntry> = []
    for b in bindings {
        params.push(ParamEntry { name: b.binding_name, vtype: ValueType.Unknown })
    }
    Pattern.Variant(variant_name, params)
}

/// Build the arm body — the Expr producing the children list for this
/// variant. Shapes (in match order):
///
///   - All scalars → `__derive_walker_empty` (typed `List<Self> = []`
///     binding declared at fn-body scope so the arm has static type
///     `List<Self>`; bare `[]` would be `List<Unknown>` and fail to
///     unify with list-typed sibling arms — F1000).
///   - Only direct children → `[c1, c2, ...]`.
///   - Single direct-list-child, no direct → `field_ident`.
///   - Single wrapper-list-child, no direct → `unwrap_fn(field_ident)`.
///   - Anything mixed → fold via `list_concat([directs], list1, list2, ...)`,
///     unwrapping wrapper-list bindings on the way in.
@comptime
fn arm_body(bindings: List<Binding>) -> Expr {
    let direct_count = count_direct(bindings)
    let list_count = count_list(bindings)
    let wrap_count = count_wrap(bindings)
    let total_list = list_count + wrap_count

    if direct_count == 0 && total_list == 0 {
        return Expr.Ident(empty_binding_name())
    }

    if total_list == 0 {
        mut elems: List<SExpr> = []
        for b in bindings {
            if b.kind is .DirectSelf {
                elems.push(sexpr_dummy(Expr.Ident(b.binding_name)))
            }
        }
        return Expr.ListLit(elems)
    }

    if direct_count == 0 && total_list == 1 {
        for b in bindings {
            if b.kind is .ListOfSelf { return Expr.Ident(b.binding_name) }
            if b.kind is .WrapperListOfSelf { return unwrap_call(b.binding_name, unwrap_fn_of(b.kind)) }
        }
    }

    block_expr_for_children(bindings)
}

/// Build `unwrap_<wrapper>_list(field_name)` for a wrapper-list binding.
@comptime
fn unwrap_call(field_name: string, fn_name: string) -> Expr {
    let args: List<SExpr> = [sexpr_dummy(Expr.Ident(field_name))]
    Expr.Call(Expr.Ident(fn_name), args)
}

@comptime
fn empty_binding_name() -> string {
    "__derive_walker_empty"
}

@comptime
fn count_direct(bindings: List<Binding>) -> int {
    mut n = 0
    for b in bindings { if b.kind is .DirectSelf { n = n + 1 } }
    n
}

@comptime
fn count_list(bindings: List<Binding>) -> int {
    mut n = 0
    for b in bindings { if b.kind is .ListOfSelf { n = n + 1 } }
    n
}

@comptime
fn count_wrap(bindings: List<Binding>) -> int {
    mut n = 0
    for b in bindings { if b.kind is .WrapperListOfSelf { n = n + 1 } }
    n
}

/// Build an Expr that concatenates the direct + list children into a
/// single List<Self> via repeated `list_concat`. Avoids generating
/// `Expr.Assign` / `Expr.Block` / `mut` constructs that the @comptime
/// decoder doesn't understand — the macro return must roundtrip through
/// `value_to_resolved_decls`, which only handles a subset of Expr.
///
/// Layout: starting from the direct-children list literal, fold each
/// list-child binding through `list_concat(acc, list_child)`. The result
/// is a single Expr.Call (or Expr.ListLit when no list-children exist —
/// handled upstream by the early-return in list_lit_of_direct_children).
@comptime
fn block_expr_for_children(bindings: List<Binding>) -> Expr {
    mut direct_elems: List<SExpr> = []
    for b in bindings {
        if b.kind is .DirectSelf {
            direct_elems.push(sexpr_dummy(Expr.Ident(b.binding_name)))
        }
    }
    mut acc: Expr = Expr.ListLit(direct_elems)
    for b in bindings {
        if b.kind is .ListOfSelf {
            let args: List<SExpr> = [sexpr_dummy(acc), sexpr_dummy(Expr.Ident(b.binding_name))]
            acc = Expr.Call(Expr.Ident("list_concat"), args)
        }
        if b.kind is .WrapperListOfSelf {
            let args: List<SExpr> = [sexpr_dummy(acc), sexpr_dummy(unwrap_call(b.binding_name, unwrap_fn_of(b.kind)))]
            acc = Expr.Call(Expr.Ident("list_concat"), args)
        }
    }
    acc
}

// ── children() fn builder ──

/// Build `fn Type__children(self) -> List<Self> { match self { arms } }`.
///
/// Mangled `Type__method` matches what `parse_method_declaration` emits
/// for hand-written impls. Free-fn placement (not inside an Impl) keeps
/// the post-expand register pass simple — it already handles top-level
/// Function decls; impl-method registration through macros would need
/// extra plumbing in `collect_macro_item_from_stmt`.
///
/// Return type is the concrete `List<EnumName>` — codegen needs a
/// resolved list-element type to lower `.length` / iteration on the
/// caller side. Leaving it Unknown defers the work to the post-expand
/// resolver, but the resolver currently doesn't re-infer fn return
/// types from match-expression bodies, so we pin it here instead.
@comptime
fn build_children_fn(arms: List<MatchArm>, enum_name: string) -> Stmt {
    let no_type_args: List<ValueType> = []
    let self_ty = ValueType.Enum(enum_name, no_type_args, 0)
    let self_param = ParamEntry { name: "self", vtype: self_ty }
    let params: List<ParamEntry> = [self_param]
    let empty_tp: List<TypeParamEntry> = []
    let ret_ty = ValueType.List(self_ty)
    let match_expr = Expr.MatchExpr(Expr.Ident("self"), arms)
    // Typed-empty binding at fn-body top so scalar arms produce
    // `List<Self>`-typed values that unify with sibling list-typed
    // arms. Stmt.Let encoder preserves the resolved-vtype slot since
    // 64fe2c84.
    let empty_elems: List<SExpr> = []
    let typed_empty = Stmt.Let(empty_binding_name(), ret_ty, Expr.ListLit(empty_elems))
    let body: List<SStmt> = [
        sstmt_dummy(typed_empty),
        sstmt_dummy(Stmt.Expr(match_expr)),
    ]
    Stmt.Function("${enum_name}__children", empty_tp, params, ret_ty, body)
}

// ── Slice C: visit() — depth-first traversal callback ──

/// Build `fn Type__visit(self: Type, f: fn(Type) -> void) { f(self);
/// for c in self.children() { c.visit(f) } }`.
///
/// `f`'s vtype is FnTyped([Self], Void) — concrete signature, not a
/// generic, so codegen knows the lambda's calling convention up
/// front. Callers that want polymorphic accumulators (fold) get a
/// separate generic builder when y9y4.3's fold slice lands.
///
/// The recursive `c.visit(f)` resolves through codegen's dot-
/// dispatch lookup against the same `Type__visit` mangled name the
/// macro emits — no special handling needed.
@comptime
fn build_visit_fn(enum_name: string) -> Stmt {
    let no_type_args: List<ValueType> = []
    let self_ty = ValueType.Enum(enum_name, no_type_args, 0)
    let f_param_types: List<ValueType> = [self_ty]
    let f_ty = ValueType.FnTyped(f_param_types, ValueType.Void)
    let self_param = ParamEntry { name: "self", vtype: self_ty }
    let f_param = ParamEntry { name: "f", vtype: f_ty }
    let params: List<ParamEntry> = [self_param, f_param]
    let empty_tp: List<TypeParamEntry> = []

    // f(self)
    let f_args: List<SExpr> = [sexpr_dummy(Expr.Ident("self"))]
    let f_call = Stmt.Expr(Expr.Call(Expr.Ident("f"), f_args))

    // for c in self.children() { c.visit(f) }
    let no_call_args: List<SExpr> = []
    let children_call = Expr.Call(Expr.FieldAccess(Expr.Ident("self"), "children"), no_call_args)
    let visit_args: List<SExpr> = [sexpr_dummy(Expr.Ident("f"))]
    let visit_call = Stmt.Expr(Expr.Call(Expr.FieldAccess(Expr.Ident("c"), "visit"), visit_args))
    let for_body_stmts: List<SStmt> = [sstmt_dummy(visit_call)]
    let for_body = Stmt.Block(for_body_stmts)
    let for_loop = Stmt.ForIn("c", children_call, for_body)

    let body: List<SStmt> = [sstmt_dummy(f_call), sstmt_dummy(for_loop)]
    Stmt.Function("${enum_name}__visit", empty_tp, params, ValueType.Void, body)
}

// ── Slice C: any() — short-circuiting existence check ──

/// Build `fn Type__any(self: Type, pred: fn(Type) -> bool) -> bool {
///     if pred(self) { return true }
///     for c in self.children() { if c.any(pred) { return true } }
///     false
/// }`.
///
/// Short-circuit: `c.any(pred)` returning true exits the loop via
/// an early `return true`. The trailing `false` falls through when
/// nothing matched. Same shape as visit() but returns bool and
/// guards with if-stmts.
@comptime
fn build_any_fn(enum_name: string) -> Stmt {
    let no_type_args: List<ValueType> = []
    let self_ty = ValueType.Enum(enum_name, no_type_args, 0)
    let pred_param_types: List<ValueType> = [self_ty]
    let pred_ty = ValueType.FnTyped(pred_param_types, ValueType.Bool)
    let self_param = ParamEntry { name: "self", vtype: self_ty }
    let pred_param = ParamEntry { name: "pred", vtype: pred_ty }
    let params: List<ParamEntry> = [self_param, pred_param]
    let empty_tp: List<TypeParamEntry> = []

    // if pred(self) { return true }
    let pred_args_self: List<SExpr> = [sexpr_dummy(Expr.Ident("self"))]
    let pred_call_self = Expr.Call(Expr.Ident("pred"), pred_args_self)
    let return_true_stmts: List<SStmt> = [sstmt_dummy(Stmt.Return(Expr.Bool("true")))]
    let return_true_block = Stmt.Block(return_true_stmts)
    let if_pred_self = Stmt.If(pred_call_self, return_true_block, null)

    // for c in self.children() { if c.any(pred) { return true } }
    let no_call_args: List<SExpr> = []
    let children_call = Expr.Call(Expr.FieldAccess(Expr.Ident("self"), "children"), no_call_args)
    let any_args: List<SExpr> = [sexpr_dummy(Expr.Ident("pred"))]
    let c_any_call = Expr.Call(Expr.FieldAccess(Expr.Ident("c"), "any"), any_args)
    let inner_return_stmts: List<SStmt> = [sstmt_dummy(Stmt.Return(Expr.Bool("true")))]
    let inner_return_block = Stmt.Block(inner_return_stmts)
    let if_c_any = Stmt.If(c_any_call, inner_return_block, null)
    let for_body_stmts: List<SStmt> = [sstmt_dummy(if_c_any)]
    let for_body = Stmt.Block(for_body_stmts)
    let for_loop = Stmt.ForIn("c", children_call, for_body)

    // trailing `false` so the fn returns it when nothing matched
    let false_return = Stmt.Return(Expr.Bool("false"))

    let body: List<SStmt> = [
        sstmt_dummy(if_pred_self),
        sstmt_dummy(for_loop),
        sstmt_dummy(false_return),
    ]
    Stmt.Function("${enum_name}__any", empty_tp, params, ValueType.Bool, body)
}

// ── Slice C: find() — short-circuiting search returning first match ──

/// Build `fn Type__find(self: Type, pred: fn(Type) -> bool) -> Type {
///     if pred(self) { return self }
///     for c in self.children() {
///         let r = c.find(pred)
///         if r != null { return r }
///     }
///     null
/// }`.
///
/// Returns the matching node or null. Type? at source level lowers
/// to the same ValueType.Enum (T's nullability lives in TypeExpr,
/// not ValueType per the parser), so emitting ret_vtype = Self is
/// the correct shape; `return null` and `r != null` are accepted by
/// typeck against that return type. Mirror of any() but propagates
/// the matching value instead of just acknowledging it.
@comptime
fn build_find_fn(enum_name: string) -> Stmt {
    let no_type_args: List<ValueType> = []
    let self_ty = ValueType.Enum(enum_name, no_type_args, 0)
    let pred_param_types: List<ValueType> = [self_ty]
    let pred_ty = ValueType.FnTyped(pred_param_types, ValueType.Bool)
    let self_param = ParamEntry { name: "self", vtype: self_ty }
    let pred_param = ParamEntry { name: "pred", vtype: pred_ty }
    let params: List<ParamEntry> = [self_param, pred_param]
    let empty_tp: List<TypeParamEntry> = []

    // if pred(self) { return self }
    let pred_args_self: List<SExpr> = [sexpr_dummy(Expr.Ident("self"))]
    let pred_call_self = Expr.Call(Expr.Ident("pred"), pred_args_self)
    let return_self_stmts: List<SStmt> = [sstmt_dummy(Stmt.Return(Expr.Ident("self")))]
    let return_self_block = Stmt.Block(return_self_stmts)
    let if_pred_self = Stmt.If(pred_call_self, return_self_block, null)

    // for c in self.children() {
    //     let r = c.find(pred)
    //     if r != null { return r }
    // }
    let no_call_args: List<SExpr> = []
    let children_call = Expr.Call(Expr.FieldAccess(Expr.Ident("self"), "children"), no_call_args)
    let find_args: List<SExpr> = [sexpr_dummy(Expr.Ident("pred"))]
    let c_find_call = Expr.Call(Expr.FieldAccess(Expr.Ident("c"), "find"), find_args)
    let let_r = Stmt.Let("r", self_ty, c_find_call)
    let r_not_null = Expr.Binary(Expr.Ident("r"), BinOp.Ne, Expr.Null)
    let return_r_stmts: List<SStmt> = [sstmt_dummy(Stmt.Return(Expr.Ident("r")))]
    let return_r_block = Stmt.Block(return_r_stmts)
    let if_r_not_null = Stmt.If(r_not_null, return_r_block, null)
    let for_body_stmts: List<SStmt> = [
        sstmt_dummy(let_r),
        sstmt_dummy(if_r_not_null),
    ]
    let for_body = Stmt.Block(for_body_stmts)
    let for_loop = Stmt.ForIn("c", children_call, for_body)

    // trailing `null` — no descendant matched
    let null_return = Stmt.Return(Expr.Null)

    let body: List<SStmt> = [
        sstmt_dummy(if_pred_self),
        sstmt_dummy(for_loop),
        sstmt_dummy(null_return),
    ]
    Stmt.Function("${enum_name}__find", empty_tp, params, self_ty, body)
}
