// derive_walker recognises a single (non-list) wrapper field
// `field: W` where `W` is a 1-hop `.node` wrapper around the parent
// (SExpr → Expr, SStmt → Stmt ride this shape). This is the
// `WrapperOfSelf` field kind: the single-field analogue of the existing
// `WrapperListOfSelf` (List<W>) case.
//
//   - children() projects the one `.node` hop, so a single-wrapper field
//     contributes exactly one child (like DirectSelf, with an unwrap).
//   - map() descends one level through the wrapper via `map_node`,
//     applying f to `.node` and rewrapping with the original sibling
//     fields preserved (the wrapper's span survives untouched).
//
// This is the enabling infrastructure for the uniform-span migration:
// once the walker handles a single spanned child, bare `Expr` / `Stmt`
// AST positions can be migrated to `SExpr` / `SStmt` one variant at a
// time and still walk/rewrite mechanically.
//
// Runs on the @std metadata fast-path (the shard default): the walker
// emitter fully-qualifies its @std helper refs (y9y4.19), so a
// metadata-loaded derive_walker resolves them without the consumer
// importing @std.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "derive_walker: single wrapper field is a WrapperOfSelf child" {
    then "children() unwraps one `.node` hop; map descends + keeps siblings" {
        let out = write_fixture_and_run("/tmp/avra_walker_wrapper_single_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type SNode = {\n" +
            "    node: Tree,\n" +
            "    span: int,\n" +
            "}\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum Tree {\n" +
            "    Leaf(v: int),\n" +
            "    One(child: SNode),\n" +
            "    Pair(l: SNode, r: SNode),\n" +
            "    Mix(tag: int, head: SNode, kids: List<SNode>),\n" +
            "}\n" +
            "\n" +
            "fn sn(t: Tree) -> SNode {\n" +
            "    SNode { node: t, span: 7 }\n" +
            "}\n" +
            "\n" +
            "fn bump(t: Tree) -> Tree {\n" +
            "    match t {\n" +
            "        .Leaf(v) -> Tree.Leaf(v + 100)\n" +
            "        _ -> t\n" +
            "    }\n" +
            "}\n" +
            "\n" +
            "fn main() {\n" +
            "    let leaf = Tree.Leaf(1)\n" +
            "    println(\"leaf=\" + string(leaf.children().length))\n" +
            "    println(\"one=\" + string(Tree.One(sn(Tree.Leaf(5))).children().length))\n" +
            "    println(\"pair=\" + string(Tree.Pair(sn(Tree.Leaf(1)), sn(Tree.Leaf(2))).children().length))\n" +
            "    let mix = Tree.Mix(9, sn(Tree.Leaf(1)), [sn(Tree.Leaf(2)), sn(Tree.Leaf(3))])\n" +
            "    println(\"mix=\" + string(mix.children().length))\n" +
            "\n" +
            "    let mapped = Tree.One(sn(Tree.Leaf(5))).map(bump)\n" +
            "    match mapped {\n" +
            "        .One(child) -> {\n" +
            "            match child.node {\n" +
            "                .Leaf(v) -> println(\"mapped=\" + string(v) + \" span=\" + string(child.span))\n" +
            "                _ -> println(\"mapped=?\")\n" +
            "            }\n" +
            "        }\n" +
            "        _ -> println(\"notone\")\n" +
            "    }\n" +
            "}\n")
        out.contains("leaf=0") && out.contains("one=1") && out.contains("pair=2") &&
            out.contains("mix=3") && out.contains("mapped=105 span=7")
    }

    then "map on a mixed variant maps the WrapperOfSelf head + WrapperListOfSelf kids, keeping the scalar and every wrapper sibling; deep nesting descends without overflow" {
        let out = write_fixture_and_run("/tmp/avra_walker_wrapper_single_deep_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type SNode = { node: Tree, span: int, tag2: string }\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum Tree {\n" +
            "    Leaf(v: int),\n" +
            "    One(child: SNode),\n" +
            "    Mix(tag: int, head: SNode, kids: List<SNode>),\n" +
            "}\n" +
            "\n" +
            "fn sn(t: Tree) -> SNode { SNode { node: t, span: 7, tag2: \"keep\" } }\n" +
            "fn lv(t: Tree) -> int { match t { .Leaf(v) -> v, _ -> -1 } }\n" +
            "fn bump(t: Tree) -> Tree { match t { .Leaf(v) -> Tree.Leaf(v + 100), _ -> t } }\n" +
            "fn deep_bump(t: Tree) -> Tree {\n" +
            "    let t2 = match t { .Leaf(v) -> Tree.Leaf(v + 1), _ -> t }\n" +
            "    t2.map(deep_bump)\n" +
            "}\n" +
            "fn innermost(t: Tree) -> int { match t { .Leaf(v) -> v, .One(c) -> innermost(c.node), _ -> -1 } }\n" +
            "\n" +
            "fn main() {\n" +
            "    let mix = Tree.Mix(9, sn(Tree.Leaf(1)), [sn(Tree.Leaf(2)), sn(Tree.Leaf(3))])\n" +
            "    match mix.map(bump) {\n" +
            "        .Mix(tag, head, kids) -> println(\"m=\" + string(tag) + \",\" + string(lv(head.node)) + \",\" + string(lv(kids[0].node)) + \",\" + string(lv(kids[1].node)) + \",\" + string(head.span) + \",\" + head.tag2)\n" +
            "        _ -> println(\"notmix\")\n" +
            "    }\n" +
            "    mut deep = Tree.Leaf(0)\n" +
            "    for i in 0..250 { deep = Tree.One(sn(deep)) }\n" +
            "    println(\"deep=\" + string(innermost(deep.map(deep_bump))))\n" +
            "}\n")
        out.contains("m=9,101,102,103,7,keep") && out.contains("deep=1")
    }

    then "classifier doesn't misfire: a sibling-less wrapper still maps; a 2-hop wrapper and a non-self `node` field stay Scalar (no false WrapperOfSelf)" {
        let out = write_fixture_and_run("/tmp/avra_walker_wrapper_single_adv_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type Bare = { node: Tree }\n" +          // wrapper with no siblings
            "export type Mid = { inner: Tree }\n" +
            "export type Hop = { node: Mid }\n" +            // 2-hop: node -> Mid -> Tree
            "export type NN = { node: int }\n" +             // `node` field that isn't Self
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum Tree {\n" +
            "    Leaf(v: int),\n" +
            "    One(c: Bare),\n" +
            "    Two(c: Hop),\n" +
            "    NotNode(c: NN),\n" +
            "}\n" +
            "fn bump(t: Tree) -> Tree { match t { .Leaf(v) -> Tree.Leaf(v + 100), _ -> t } }\n" +
            "\n" +
            "fn main() {\n" +
            "    let one = Tree.One(Bare { node: Tree.Leaf(5) })\n" +
            "    let mid = Mid { inner: Tree.Leaf(1) }\n" +
            "    let two = Tree.Two(Hop { node: mid })\n" +
            "    let nn = Tree.NotNode(NN { node: 9 })\n" +
            "    println(\"one=\" + string(one.children().length))\n" +     // WrapperOfSelf -> 1
            "    println(\"two=\" + string(two.children().length))\n" +     // 2-hop -> Scalar -> 0
            "    println(\"nn=\" + string(nn.children().length))\n" +       // node:int -> Scalar -> 0
            "    match one.map(bump) {\n" +                                  // sibling-less wrapper maps
            "        .One(c) -> println(\"mapped=\" + string(match c.node { .Leaf(v) -> v, _ -> -1 }))\n" +
            "        _ -> println(\"x\")\n" +
            "    }\n" +
            "}\n")
        out.contains("one=1") && out.contains("two=0") && out.contains("nn=0") && out.contains("mapped=105")
    }
}
