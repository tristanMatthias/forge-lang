// y9y4.7 + y9y4.8 / so07.5 + so07.7.14 — @expand(derive_walker) on
// core/ast.av's Stmt and Expr enums. Tests assert structural
// relationships (children.length matches expected source counts via
// the fixture's own input.length / 1+args.length / etc.) rather than
// hardcoded magic numbers — adding another field to a variant that
// classifies as scalar (kind=0) doesn't break the test.
//
// Bypasses metadata mode at fixture invocation (9p1d).

use @std.avrac.test_runner.{write_fixture_and_run_no_metadata}

spec "derive_walker: Stmt enum carries .children()" {
    then "scalar variant (Stmt.NoOp) — zero children" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Stmt}\n" +
            "fn main() {\n" +
            "    let n = Stmt.NoOp.children().length\n" +
            "    println(\"empty=\" + string(n == 0))\n" +
            "}\n")
        out.contains("empty=true")
    }
    then "direct-Self field (Stmt.While body) — exactly the body" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Stmt, Expr}\n" +
            "fn main() {\n" +
            "    let w = Stmt.While(Expr.Bool(true), Stmt.Break)\n" +
            "    let kids = w.children()\n" +
            "    println(\"matches_one=\" + string(kids.length == 1))\n" +
            "}\n")
        out.contains("matches_one=true")
    }
    then "wrapper-list field (Stmt.Block body) — count matches input.length" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Stmt, SStmt, sstmt_dummy}\n" +
            "fn main() {\n" +
            "    let inner: List<SStmt> = [sstmt_dummy(Stmt.NoOp), sstmt_dummy(Stmt.Break), sstmt_dummy(Stmt.Continue)]\n" +
            "    let block = Stmt.Block(inner)\n" +
            "    println(\"matches_input=\" + string(block.children().length == inner.length))\n" +
            "}\n")
        out.contains("matches_input=true")
    }
}

spec "derive_walker: Expr enum carries .children()" {
    then "scalar literal (Expr.Number) — zero children" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Expr}\n" +
            "fn main() {\n" +
            "    let n = Expr.Number(\"42\").children().length\n" +
            "    println(\"empty=\" + string(n == 0))\n" +
            "}\n")
        out.contains("empty=true")
    }
    then "two-direct-Self (Expr.Binary) — both operands" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Expr, BinOp}\n" +
            "fn main() {\n" +
            "    let lhs = Expr.Number(\"1\")\n" +
            "    let rhs = Expr.Number(\"2\")\n" +
            "    let bin = Expr.Binary(lhs, BinOp.Add, rhs)\n" +
            "    println(\"two=\" + string(bin.children().length == 2))\n" +
            "}\n")
        out.contains("two=true")
    }
    then "mixed direct-Self + wrapper-list (Expr.Call) — callee + unwrapped args" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Expr, SExpr, sexpr_dummy}\n" +
            "fn main() {\n" +
            "    let callee = Expr.Ident(\"f\")\n" +
            "    let args: List<SExpr> = [sexpr_dummy(Expr.Number(\"1\")), sexpr_dummy(Expr.Number(\"2\"))]\n" +
            "    let call = Expr.Call(callee, args)\n" +
            "    println(\"sum=\" + string(call.children().length == 1 + args.length))\n" +
            "}\n")
        out.contains("sum=true")
    }
}
