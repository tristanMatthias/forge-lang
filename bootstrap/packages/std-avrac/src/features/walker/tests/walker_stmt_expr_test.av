// y9y4.7 + y9y4.8 / so07.5 + so07.7.14 — @expand(derive_walker) on
// core/ast.av's Stmt and Expr enums. Tests assert structural
// relationships (children.length matches expected source counts via
// the fixture's own input.length / 1+args.length / etc.) rather than
// hardcoded magic numbers — adding another field to a variant that
// classifies as scalar (kind=0) doesn't break the test.
//
// Bypasses metadata mode at fixture invocation (9p1d).

use @std.avrac.test_runner.{write_fixture_and_run_no_metadata}

spec "derive_walker: Stmt enum carries .children()" {
    then "scalar variant (Stmt.NoOp) — zero children" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Stmt}\n" +
            "fn main() {\n" +
            "    let n = Stmt.NoOp.children().length\n" +
            "    println(\"empty=\" + string(n == 0))\n" +
            "}\n")
        out.contains("empty=true")
    }
    then "id-payload fields (Stmt.While cond + body) — scalars to the walker (F3a)" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Stmt, Expr, new_node_store, build_line_index}\n" +
            "fn main() {\n" +
            "    let ws = new_node_store(build_line_index(\"\"))\n" +
            "    let w = Stmt.While(ws.exprs.add_leaf(Expr.Bool(\"true\")), ws.stmts.add_leaf(Stmt.Break))\n" +
            "    let kids = w.children()\n" +
            "    println(\"leaf_view=\" + string(kids.length == 0))\n" +
            "}\n")
        out.contains("leaf_view=true")
    }
    then "id-list field (Stmt.Block body: List<StmtId>) — no walker children (F3a)" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Stmt, StmtId, new_node_store, build_line_index}\n" +
            "fn main() {\n" +
            "    let ws = new_node_store(build_line_index(\"\"))\n" +
            "    let inner: List<StmtId> = [ws.stmts.add_leaf(Stmt.NoOp), ws.stmts.add_leaf(Stmt.Break), ws.stmts.add_leaf(Stmt.Continue)]\n" +
            "    let block = Stmt.Block(inner)\n" +
            "    println(\"leaf_view=\" + string(block.children().length == 0 && inner.length == 3))\n" +
            "}\n")
        out.contains("leaf_view=true")
    }
}

spec "derive_walker: Expr enum carries .children()" {
    then "scalar literal (Expr.Number) — zero children" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av", 
            "use @std.avrac.core.{Expr}\n" +
            "fn main() {\n" +
            "    let n = Expr.Number(\"42\").children().length\n" +
            "    println(\"empty=\" + string(n == 0))\n" +
            "}\n")
        out.contains("empty=true")
    }
    then "Expr.Binary — operand ids are scalar, children() skips them (F3b)" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av",
            "use @std.avrac.core.{Expr, BinOp, ExprId}\n" +
            "fn main() {\n" +
            "    let bin = Expr.Binary(ExprId(1), BinOp.Add, ExprId(2))\n" +
            "    println(\"two=\" + string(bin.children().length == 0))\n" +
            "}\n")
        out.contains("two=true")
    }
    then "id-payload callee + arg-list (Expr.Call) — scalars to the walker (F3b)" {
        // Post-flip Call carries an ExprId callee and a List<ExprId> args —
        // both scalar to the walker, so children() skips them, exactly like
        // the Binary arm's operand ids above.
        let out = write_fixture_and_run_no_metadata("/tmp/avra_walker_stmt_expr_test.av",
            "use @std.avrac.core.{Expr, new_node_store, build_line_index}\n" +
            "fn main() {\n" +
            "    let ws = new_node_store(build_line_index(\"\"))\n" +
            "    let call = Expr.Call(ws.exprs.add_leaf(Expr.Ident(\"f\")), [ws.exprs.add_leaf(Expr.Number(\"1\")), ws.exprs.add_leaf(Expr.Number(\"2\"))])\n" +
            "    println(\"leaf_view=\" + string(call.children().length == 0))\n" +
            "}\n")
        out.contains("leaf_view=true")
    }
}
