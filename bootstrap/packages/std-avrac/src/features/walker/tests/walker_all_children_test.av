// WHY: A1 (faithful cross-type arena ingest) — verify the derive_walker's
// `all_children_spanned()` returns EVERY child across the four node kinds (not
// just the same-type ones `children()` returns), in field order. Exercised
// through the @std probes `{stmt,expr,pat,type}_child_tags` (a consumer shard
// can't call the @std-internal generated method on a core type directly), which
// strip the spans and return a per-child kind-tag string E/S/P/T. Together the
// specs cover every FieldKind the real AST exercises: DirectSelf,
// WrapperListOfSelf, OptionalDirectSelf, bare ListOfSelf, and all-scalar. (The
// per-child SPANS the same walker carries are covered in arena_test.av.)

use @std.avrac.core.{PatId, StmtId, ExprId, NodeStore, new_node_store, build_line_index, Stmt, Expr, Pattern, ValueType, BinOp, SStmt, SExpr, sstmt, Annotation, ParamEntry, TypeParamEntry}
use @std.avrac.core.{stmt_child_tags, expr_child_tags, pat_child_tags, type_child_tags}
use @std.avrac.core.{wc_roundtrip_expr, wc_roundtrip_stmt, wc_roundtrip_pat, wc_roundtrip_type}
use @std.avrac.core.{AnyNode, SpannedChild, spanned_child, respan_sexpr_opt, respan_sstmt_opt, render_expr, render_stmt, render_pattern}

/// Fresh empty store for inline-AST probes — F2 renderers resolve
/// flipped pattern ids through it (never read for id-free nodes).
fn ts() -> NodeStore {
    new_node_store(build_line_index(""))
}


spec "derive all_children_spanned: cross-type children, in order" {
    then "Stmt.Let -> ValueType child only (the initializer id is a scalar, F3a)" {
        // children() (same-type Stmt) is empty; all_children_spanned adds the
        // cross-type ty_vt (ValueType). The initializer is an ExprId arena row
        // — the id payload IS the child mechanism, so the walker skips it.
        let ws = ts()
        stmt_child_tags(Stmt.Let("x", ValueType.Int, ws.exprs.add_leaf(Expr.Number("1")))) == "T"
    }
    then "Expr.Binary -> both operand ids are scalar, no walker children (F3b)" {
        // Post-F3b the operands are ExprId arena rows — the id payload IS
        // the child mechanism, so the walker skips both; only the BinOp
        // scalar remains, which is never a child.
        let ws = ts()
        expr_child_tags(Expr.Binary(ws.exprs.add_leaf(Expr.Number("1")), BinOp.Add, ws.exprs.add_leaf(Expr.Number("2")))) == ""
    }
    then "Expr.Block -> its body Stmts via wrapper-list .node unwrap" {
        let body: List<SStmt> = [sstmt(Stmt.Break, 1, 1), sstmt(Stmt.Continue, 2, 1)]
        expr_child_tags(Expr.Block(body)) == "SS"
    }
    then "a scalar-only node has no children" {
        stmt_child_tags(Stmt.Break) == ""
    }
}

// One spec per remaining FieldKind the AST actually exercises, so the boxing of
// each kind is asserted on a real node — not just the DirectSelf/WrapperList
// cases above.
spec "derive all_children_spanned: optional and bare-list field kinds" {
    then "Stmt.If with an else -> no walker children (all payloads are ids, F3a)" {
        // cond / then / else are ExprId / StmtId / StmtId? rows — every one a
        // scalar to the walker, whether the optional is present or not.
        let ws = ts()
        let cond = ws.exprs.add_leaf(Expr.Number("1"))
        let t = ws.stmts.add_leaf(Stmt.Break)
        let e = ws.stmts.add_leaf(Stmt.Continue)
        stmt_child_tags(Stmt.If(cond, t, e)) == ""
    }
    then "Stmt.If without an else -> still no walker children (absent optional id)" {
        let ws = ts()
        let cond = ws.exprs.add_leaf(Expr.Number("1"))
        let t = ws.stmts.add_leaf(Stmt.Break)
        stmt_child_tags(Stmt.If(cond, t, null)) == ""
    }
    then "Pattern.NestedVariant -> id payload is walker-opaque (F2, no children)" {
        // Post-F2 the sub-list is List<PatId> — scalars to the walker; the
        // canonical children live in the payload ids themselves.
        let ws = ts()
        let subs: List<PatId> = [ws.pats.add_leaf(Pattern.Wildcard), ws.pats.add_leaf(Pattern.Wildcard)]
        pat_child_tags(Pattern.NestedVariant("Some", subs)) == ""
    }
    then "ValueType.Struct -> its type-args (bare ListOfSelf, TT)" {
        let targs: List<ValueType> = [ValueType.Int, ValueType.Str]
        type_child_tags(ValueType.Struct("Map", targs, 0)) == "TT"
    }
}

// B1: the INVERSE walker `with_children` is the dual of `all_children_spanned`.
// The property law (spec §8) is that rebuilding a node from its OWN extracted
// children reproduces it: with_children(self, all_children_spanned(self)) == self.
// One case per FieldKind shape, exercised through the @std wc_roundtrip_* probes
// (structural compare: render for Expr/Stmt/Pattern, vtype_eq_deep for ValueType).
// This is the correctness oracle the arena's reconstruct-from-edges shim rides.
spec "derive with_children: round-trips every field-kind shape (inverse-walker law)" {
    then "all-scalar leaves rebuild identically (Stmt.Break, Expr.Number)" {
        wc_roundtrip_stmt(ts(), Stmt.Break) && wc_roundtrip_expr(ts(), Expr.Number("5"))
    }
    then "id-payload operands + scalar (Expr.Binary: two ExprIds verbatim, op passes through)" {
        let ws = ts()
        wc_roundtrip_expr(ws, Expr.Binary(ws.exprs.add_leaf(Expr.Number("1")), BinOp.Add, ws.exprs.add_leaf(Expr.Number("2"))))
    }
    then "cross-type bare single + id payload (Stmt.Let: ValueType walked, ExprId verbatim)" {
        let ws = ts()
        wc_roundtrip_stmt(ws, Stmt.Let("x", ValueType.Int, ws.exprs.add_leaf(Expr.Number("1"))))
    }
    then "wrapper-list child (Expr.Block: List<SStmt> rebuilt with recovered spans)" {
        let body: List<SStmt> = [sstmt(Stmt.Break, 1, 1), sstmt(Stmt.Continue, 2, 1)]
        wc_roundtrip_expr(ts(), Expr.Block(body))
    }
    then "id-payload callee + arg-list ids (Expr.Call: callee + args all verbatim, F3b)" {
        // Post-flip Call carries an ExprId callee and a List<ExprId> args —
        // scalars to the walker, so the round-trip pins id passthrough: the
        // rebuilt node must carry the same rows, and the store-resolved render
        // reproduces the callee + ordered args.
        let ws = ts()
        let args: List<ExprId> = [ws.exprs.add_leaf(Expr.Number("1")), ws.exprs.add_leaf(Expr.Ident("x"))]
        wc_roundtrip_expr(ws, Expr.Call(ws.exprs.add_leaf(Expr.Ident("f")), args))
    }
    then "id-payload single (Stmt.Annotated.inner: one StmtId, F3a)" {
        let ws = ts()
        let no_ann: List<Annotation> = []
        wc_roundtrip_stmt(ws, Stmt.Annotated(no_ann, ws.stmts.add_leaf(Stmt.Break)))
    }
    then "id-payload child (Pattern.NestedVariant: List<PatId>, F2 flip)" {
        // Post-F2 the sub-list is ids — a SCALAR to the walker, so the case
        // pins id passthrough: the rebuilt node must carry the same rows, and
        // the store-resolved render must reproduce distinct, ordered subs.
        let ws = ts()
        let no_b: List<ParamEntry> = []
        let subs: List<PatId> = [ws.pats.add_leaf(Pattern.LitInt(1)), ws.pats.add_leaf(Pattern.Variant("X", no_b))]
        wc_roundtrip_pat(ws, Pattern.NestedVariant("Some", subs))
    }
    then "literal-pattern leaf (Pattern.LitInt: all-scalar, render distinguishes)" {
        wc_roundtrip_pat(ts(), Pattern.LitInt(42))
    }
    then "id-list body on a block-stmt variant (Stmt.Parallel: List<StmtId>, F3a)" {
        // The body rides as ids — scalars to the walker — and render descends
        // through the store, so a dropped or reordered id diverges.
        let ws = ts()
        let pbody: List<StmtId> = [ws.stmts.add_leaf(Stmt.Break), ws.stmts.add_leaf(Stmt.Continue)]
        wc_roundtrip_stmt(ws, Stmt.Parallel(pbody))
    }
    then "optional id present (Stmt.If with else)" {
        let ws = ts()
        wc_roundtrip_stmt(ws, Stmt.If(ws.exprs.add_leaf(Expr.Number("1")), ws.stmts.add_leaf(Stmt.Break), ws.stmts.add_leaf(Stmt.Continue)))
    }
    then "optional id absent (Stmt.If, null else)" {
        let ws = ts()
        wc_roundtrip_stmt(ws, Stmt.If(ws.exprs.add_leaf(Expr.Number("1")), ws.stmts.add_leaf(Stmt.Break), null))
    }
    then "node-LIST before node-SINGLE (ValueType.FnTyped: params run, then ret)" {
        // The A1 ordering-bug shape: with_children must take params=kids[0..n-1]
        // and ret=kids[n-1], not swap them. vtype_eq_deep compares params+ret.
        let params: List<ValueType> = [ValueType.Int, ValueType.Str]
        wc_roundtrip_type(ValueType.FnTyped(params, ValueType.Bool))
    }
    then "nested (Block holds an Expr-stmt holding a Binary) round-trips at depth" {
        let ws = ts()
        let bin = ws.exprs.add_leaf(Expr.Binary(ws.exprs.add_leaf(Expr.Number("1")), BinOp.Add, ws.exprs.add_leaf(Expr.Number("2"))))
        let inner: List<SStmt> = [sstmt(Stmt.Expr(bin), 1, 1)]
        wc_roundtrip_expr(ws, Expr.Block(inner))
    }
}

// The OptionalWrapperOfSelf field kind (a `SExpr?`/`SStmt?` slot) has NO walked
// AST variant today — the only such fields live on the MatchArm/WhenArm structs,
// which the walker doesn't descend into — so the generated with_children never
// reaches the respan_*_opt rebuild helpers and the round-trip law can't cover them.
// Exercise the inverse helpers directly: present (1 child) rebuilds the wrapper
// with its recovered span, absent (empty run) yields null. Guards the codepath
// that would otherwise first execute, untested, the day such a field is added.
spec "inverse-walker: OptionalWrapperOfSelf rebuild (respan_*_opt) — present + absent" {
    then "present run rebuilds the wrapper from its node + recovered span" {
        let e_kids: List<SpannedChild> = [spanned_child(AnyNode.AnyExpr(Expr.Number("7")), 4, 2)]
        let s_kids: List<SpannedChild> = [spanned_child(AnyNode.AnyStmt(Stmt.Break), 5, 1)]
        let e = respan_sexpr_opt(e_kids)
        let s = respan_sstmt_opt(s_kids)
        e != null && e!.line == 4 && e!.col == 2 && render_expr(ts(), e!.node) == "7"
          && s != null && s!.line == 5 && render_stmt(ts(), s!.node) == "(break)"
    }
    then "absent run (empty child list) yields null" {
        let none_e: List<SpannedChild> = []
        let none_s: List<SpannedChild> = []
        respan_sexpr_opt(none_e) == null && respan_sstmt_opt(none_s) == null
    }
}

// The render arms render_pattern gained alongside the inverse walker (so the
// round-trip oracle stops collapsing patterns) are all-scalar passthroughs, so a
// round-trip can't break them — but the render LOGIC itself (LitBool int->bool,
// LitString quoting, NestedVariant sub-list descent) was unverified. Assert it.
spec "render_pattern: literal + nested arms render distinctly" {
    then "string literal renders quoted" {
        render_pattern(ts(), Pattern.LitString("hi")) == "\"hi\""
    }
    then "bool literals render true/false" {
        render_pattern(ts(), Pattern.LitBool(1)) == "true" && render_pattern(ts(), Pattern.LitBool(0)) == "false"
    }
    then "float literal renders its stored value" {
        render_pattern(ts(), Pattern.LitFloat("1.5")) == "1.5"
    }
    then "nested variant descends into its comma-joined sub-patterns (via ids)" {
        let ws = ts()
        let no_b: List<ParamEntry> = []
        let subs: List<PatId> = [ws.pats.add_leaf(Pattern.LitInt(1)), ws.pats.add_leaf(Pattern.Variant("X", no_b))]
        render_pattern(ws, Pattern.NestedVariant("Some", subs)) == ".Some(1, .X())"
    }
}

// render_stmt's binding/fn-return type annotations are WALKED ValueType children,
// so the round-trip oracle (render-equality) must render them faithfully — but they
// used the concise `vtype_display`, which collapses `List<int>`≡`List<string>`→"List"
// (etc.), making the oracle vacuous for those type slots. They now use a faithful
// renderer; assert two distinct element types diverge (and Unknown stays readable).
spec "render_stmt: binding/fn type annotations render faithfully (round-trip oracle non-vacuity)" {
    then "Let element type is faithful (List<int> != List<string>; was both 'List')" {
        let ws = ts()
        let no_el: List<ExprId> = []
        let init = ws.exprs.add_leaf(Expr.ListLit(no_el))
        let a = render_stmt(ws, Stmt.Let("x", ValueType.List(ValueType.Int), init))
        let b = render_stmt(ws, Stmt.Let("x", ValueType.List(ValueType.Str), init))
        a != b && a.contains("List<int>")
    }
    then "Function return type is faithful (List<int> not collapsed to 'List')" {
        let no_tp: List<TypeParamEntry> = []
        let no_pp: List<ParamEntry> = []
        let no_body: List<StmtId> = []
        render_stmt(ts(), Stmt.Function("f", no_tp, no_pp, ValueType.List(ValueType.Int), no_body)).contains("List<int>")
    }
    then "unresolved binding type still renders the <unknown> marker" {
        let ws = ts()
        render_stmt(ws, Stmt.Let("x", ValueType.Unknown, ws.exprs.add_leaf(Expr.Number("1")))).contains("<unknown>")
    }
    then "Fn return type is faithful (Fn<int> != Fn<string>; vtype_render_full collapses both to 'fn')" {
        let ws = ts()
        let init = ws.exprs.add_leaf(Expr.Number("0"))
        let a = render_stmt(ws, Stmt.Let("f", ValueType.Fn(ValueType.Int), init))
        let b = render_stmt(ws, Stmt.Let("f", ValueType.Fn(ValueType.Str), init))
        a != b
    }
    then "Tuple element types are faithful (compound element not collapsed to 'List')" {
        let ws = ts()
        let elems: List<ValueType> = [ValueType.List(ValueType.Int), ValueType.Str]
        render_stmt(ws, Stmt.Let("t", ValueType.Tuple(elems), ws.exprs.add_leaf(Expr.Number("0")))).contains("List<int>")
    }
    then "NESTED type child is faithful (List<Fn<int>> != List<Fn<string>>; the case a naive fix misses)" {
        let ws = ts()
        let init = ws.exprs.add_leaf(Expr.Number("0"))
        let a = render_stmt(ws, Stmt.Let("x", ValueType.List(ValueType.Fn(ValueType.Int)), init))
        let b = render_stmt(ws, Stmt.Let("x", ValueType.List(ValueType.Fn(ValueType.Str)), init))
        a != b
    }
}
