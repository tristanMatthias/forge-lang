// derive_walker's Type__map descends into wrapper-list
// fields (List<SExpr> / List<SStmt> / any List<W> where W projects to
// the parent via `.node`). It applies f to each entry's `.node` and
// rewraps with the original sibling fields via `map_node_list`'s `with`
// update, so a one-level map reaches wrapper-list children WITHOUT the
// parent losing the span info those wrappers carry.
//
// Observable: build a Branch holding a novel wrapper (node + extra),
// map a leaf-bumping fn, and confirm (a) the inner node was transformed
// and (b) the wrapper's `extra` sibling field survived untouched. If
// map still passed wrapper-lists through unchanged the node value would
// be stale; if the rewrap dropped siblings the extra would reset.
//
// Runs on the @std metadata fast-path (the shard default): the walker
// emitter fully-qualifies its @std helper refs (y9y4.19), so a
// metadata-loaded derive_walker resolves them without the consumer
// importing @std.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "derive_walker: map descends into wrapper-list children, preserving siblings" {
    then "Branch(kids: List<MyWrap>).map bumps every leaf and keeps `extra`" {
        let out = write_fixture_and_run("/tmp/avra_walker_map_wrapper_list_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type MyWrap = {\n" +
            "    node: MyTree,\n" +
            "    extra: int,\n" +
            "}\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum MyTree {\n" +
            "    Leaf(v: int),\n" +
            "    Branch(kids: List<MyWrap>),\n" +
            "}\n" +
            "\n" +
            "fn bump(t: MyTree) -> MyTree {\n" +
            "    let t2 = match t {\n" +
            "        .Leaf(v) -> MyTree.Leaf(v + 100)\n" +
            "        _ -> t\n" +
            "    }\n" +
            "    t2.map(bump)\n" +
            "}\n" +
            "\n" +
            "fn leaf_val(w: MyWrap) -> int {\n" +
            "    match w.node { .Leaf(v) -> v, _ -> -1 }\n" +
            "}\n" +
            "\n" +
            "fn main() {\n" +
            "    let inner: List<MyWrap> = [\n" +
            "        MyWrap { node: MyTree.Leaf(1), extra: 7 },\n" +
            "        MyWrap { node: MyTree.Leaf(2), extra: 9 },\n" +
            "    ]\n" +
            "    let mapped = MyTree.Branch(inner).map(bump)\n" +
            "    match mapped {\n" +
            "        .Branch(kids) -> {\n" +
            "            println(\"v0=\" + string(leaf_val(kids[0])) + \" e0=\" + string(kids[0].extra))\n" +
            "            println(\"v1=\" + string(leaf_val(kids[1])) + \" e1=\" + string(kids[1].extra))\n" +
            "        }\n" +
            "        _ -> println(\"notbranch\")\n" +
            "    }\n" +
            "}\n")
        out.contains("v0=101 e0=7") && out.contains("v1=102 e1=9")
    }

    then "empty wrapper-list maps to empty (no crash); nested wrapper-lists descend every level" {
        let out = write_fixture_and_run("/tmp/avra_walker_map_wrapper_edge_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type MyWrap = { node: MyTree, extra: int }\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum MyTree {\n" +
            "    Leaf(v: int),\n" +
            "    Branch(kids: List<MyWrap>),\n" +
            "}\n" +
            "\n" +
            "fn bump(t: MyTree) -> MyTree {\n" +
            "    let t2 = match t { .Leaf(v) -> MyTree.Leaf(v + 100), _ -> t }\n" +
            "    t2.map(bump)\n" +
            "}\n" +
            "\n" +
            "fn leaf_val(w: MyWrap) -> int { match w.node { .Leaf(v) -> v, _ -> -1 } }\n" +
            "\n" +
            "fn main() {\n" +
            "    // empty wrapper-list: maps to empty, no crash on the for-loop\n" +
            "    let empty = MyTree.Branch([]).map(bump)\n" +
            "    match empty { .Branch(kids) -> println(\"empty_len=\" + string(kids.length)), _ -> println(\"notbranch\") }\n" +
            "    // nested wrapper-lists: Branch -> Branch -> Leaf, must descend both levels\n" +
            "    let inner: List<MyWrap> = [ MyWrap { node: MyTree.Leaf(5), extra: 1 } ]\n" +
            "    let mid: List<MyWrap> = [ MyWrap { node: MyTree.Branch(inner), extra: 2 } ]\n" +
            "    let nested = MyTree.Branch(mid).map(bump)\n" +
            "    match nested {\n" +
            "        .Branch(outer) -> match outer[0].node {\n" +
            "            .Branch(deep) -> println(\"deep=\" + string(leaf_val(deep[0])) + \" mid_extra=\" + string(outer[0].extra)),\n" +
            "            _ -> println(\"notnested\")\n" +
            "        }\n" +
            "        _ -> println(\"notbranch\")\n" +
            "    }\n" +
            "}\n")
        out.contains("empty_len=0") && out.contains("deep=105 mid_extra=2")
    }

    then "stress: 1000-wide wrapper-list + 300-deep nesting map correctly without stack overflow" {
        let out = write_fixture_and_run("/tmp/avra_walker_map_wrapper_stress_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type MyWrap = { node: MyTree, extra: int }\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum MyTree { Leaf(v: int), Branch(kids: List<MyWrap>) }\n" +
            "\n" +
            "fn bump(t: MyTree) -> MyTree {\n" +
            "    let t2 = match t { .Leaf(v) -> MyTree.Leaf(v + 1), _ -> t }\n" +
            "    t2.map(bump)\n" +
            "}\n" +
            "\n" +
            "fn depth_leaf(t: MyTree) -> int {\n" +
            "    match t { .Leaf(v) -> v, .Branch(k) -> if k.length > 0 { depth_leaf(k[0].node) } else { -1 } }\n" +
            "}\n" +
            "\n" +
            "fn main() {\n" +
            "    mut wide: List<MyWrap> = []\n" +
            "    for i in 0..1000 { wide.push(MyWrap { node: MyTree.Leaf(i), extra: i }) }\n" +
            "    let mw = MyTree.Branch(wide).map(bump)\n" +
            "    match mw { .Branch(k) -> println(\"wide=\" + string(k.length) + \",\" + string(depth_leaf(k[0].node)) + \",\" + string(depth_leaf(k[999].node))), _ -> println(\"x\") }\n" +
            "    mut deep = MyTree.Leaf(0)\n" +
            "    for i in 0..300 { deep = MyTree.Branch([MyWrap { node: deep, extra: i }]) }\n" +
            "    println(\"deep=\" + string(depth_leaf(deep.map(bump))))\n" +
            "}\n")
        out.contains("wide=1000,1,1000") && out.contains("deep=1")
    }

    then "combinatorial: a variant mixing DirectSelf + WrapperListOfSelf + Scalar maps each kind right; map result feeds an if-expr with a captured closure" {
        let out = write_fixture_and_run("/tmp/avra_walker_map_wrapper_combo_fixture.av",
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "export type MyWrap = { node: MyTree, extra: int }\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "export enum MyTree {\n" +
            "    Leaf(v: int),\n" +
            "    Branch(kids: List<MyWrap>),\n" +
            "    Mixed(direct: MyTree, wrapped: List<MyWrap>, label: string),\n" +
            "}\n" +
            "\n" +
            "fn bump(t: MyTree) -> MyTree {\n" +
            "    let t2 = match t { .Leaf(v) -> MyTree.Leaf(v + 100), _ -> t }\n" +
            "    t2.map(bump)\n" +
            "}\n" +
            "\n" +
            "fn lv(t: MyTree) -> int { match t { .Leaf(v) -> v, _ -> -1 } }\n" +
            "\n" +
            "fn main() {\n" +
            "    let kids: List<MyWrap> = [ MyWrap { node: MyTree.Leaf(2), extra: 9 } ]\n" +
            "    // map must hit direct (DirectSelf) + wrapped (WrapperListOfSelf), keep label + extra (Scalars)\n" +
            "    match MyTree.Mixed(MyTree.Leaf(1), kids, \"tag\").map(bump) {\n" +
            "        .Mixed(d, w, l) -> println(\"m=\" + string(lv(d)) + \",\" + string(lv(w[0].node)) + \",\" + l + \",\" + string(w[0].extra))\n" +
            "        _ -> println(\"notmixed\")\n" +
            "    }\n" +
            "    // map result threaded through an if-expr with a captured closure\n" +
            "    let by = 100\n" +
            "    let add = (t: MyTree) -> match t { .Leaf(v) -> MyTree.Leaf(v + by), _ -> t.map(bump) }\n" +
            "    println(\"if=\" + (if lv(add(MyTree.Leaf(5))) > 100 { \"big\" } else { \"small\" }))\n" +
            "}\n")
        out.contains("m=101,102,tag,9") && out.contains("if=big")
    }
}
