// y9y4.5: @expand(derive_walker) applied to the real `Pattern` enum
// in core/ast.av. Verifies the macro fires through Module-wrapped
// imports — fix for 1pre (any_expand_annotation didn't recurse into
// Module bodies, so iter 0 saw has_exp=false even when std-avrac's
// own Pattern carried @expand, and the synth'd Pattern__children
// was missing at consumer codegen).
//
// Runs on the @std metadata fast-path (the shard default): the walker
// emitter fully-qualifies its @std helper refs (y9y4.19), so a
// metadata-loaded derive_walker resolves them without the consumer
// importing @std.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "derive_walker: applied to core/ast.av's Pattern enum" {
    then "Pattern.children() — id payloads are walker-scalars (F2)" {
        let out = write_fixture_and_run("/tmp/avra_walker_pattern_test.av", 
            "use @std.avrac.core.{Pattern, ParamEntry, PatId, new_node_store, build_line_index}\n" +
            "fn main() {\n" +
            "    let wild_ok = Pattern.Wildcard.children().length == 0\n" +
            "    let lit_ok  = Pattern.LitInt(42).children().length == 0\n" +
            "    // F2: Or/NestedVariant carry arena ids — scalars to the derive\n" +
            "    // walker, so children() sees none; the store resolves them.\n" +
            "    let ws = new_node_store(build_line_index(\"\"))\n" +
            "    let or_pat = Pattern.Or(ws.pats.add_leaf(Pattern.LitInt(1)), ws.pats.add_leaf(Pattern.LitInt(2)))\n" +
            "    let or_ok = or_pat.children().length == 0\n" +
            "    let inner: List<PatId> = [ws.pats.add_leaf(Pattern.Wildcard), ws.pats.add_leaf(Pattern.LitInt(1))]\n" +
            "    let nested = Pattern.NestedVariant(\"Some\", inner)\n" +
            "    let nested_ok = nested.children().length == 0\n" +
            "    println(\"all=\" + string(wild_ok && lit_ok && or_ok && nested_ok))\n" +
            "}\n")
        out.contains("all=true")
    }
}
