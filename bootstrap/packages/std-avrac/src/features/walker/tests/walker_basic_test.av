// Smoke test for derive_walker (sub-phase A).
//
// Annotates a tiny recursive enum with @expand(derive_walker) and
// asserts the generated `fn children(self) -> List<Self>` is callable
// at runtime and returns the right direct children for each variant.
//
// Runs on the @std metadata fast-path (the shard default): the walker
// emitter fully-qualifies its @std helper refs (y9y4.19), so a
// metadata-loaded derive_walker resolves them without the consumer
// importing @std.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "derive_walker: children() on a tiny recursive enum" {
    then "Leaf returns [], Node returns [left, right] in source order" {
        let out = write_fixture_and_run("/tmp/avra_walker_basic_test.av", 
            "use @std.avrac.features.walker.{derive_walker}\n" +
            "\n" +
            "@expand(derive_walker)\n" +
            "enum Tree {\n" +
            "    Leaf(value: int)\n" +
            "    Node(left: Tree, right: Tree)\n" +
            "}\n" +
            "\n" +
            "fn main() {\n" +
            "    let leaf = Tree.Leaf(42)\n" +
            "    let leaf_children = leaf.children()\n" +
            "    println(\"leaf=\" + string(leaf_children.length))\n" +
            "\n" +
            "    let node = Tree.Node(Tree.Leaf(1), Tree.Leaf(2))\n" +
            "    let node_children = node.children()\n" +
            "    println(\"node=\" + string(node_children.length))\n" +
            "}\n")
        out.contains("leaf=0") && out.contains("node=2")
    }
}
