// WHY: resolves names in select arms — binds channel binding variables into scope.

use core.{SelectArm}
use resolve.{Resolver, enter_resolve_scope, exit_resolve_scope, resolve_expr, resolve_stmt_list, declare_name, define_name}

/// Resolve every arm of a `select { ... }` statement. For each
/// arm, the channel expression resolves in the outer scope, then
/// a fresh scope is entered to define the binding name (the
/// received value), and finally the body resolves with that
/// binding visible.
export fn resolve_select_arms(r: Resolver, arms: List<SelectArm>) -> Resolver {
    mut cur = r
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        let after_ch = resolve_expr(cur, cur.nodes.exprs.get(arm.chan_id))
        let scoped = enter_resolve_scope(after_ch)
        let with_binding = declare_name(scoped, arm.binding)
        let defined = define_name(with_binding, arm.binding)
        let after_body = resolve_stmt_list(defined, defined.nodes.sstmts_of(arm.body_ids))
        cur = exit_resolve_scope(after_body)
        i = i + 1
    }
    cur
}
