// WHY: codegen for `select { binding <- channel -> { body } }`.
// Builds an array of channel pointers, calls avra_select to block
// until one has data, then dispatches to the matching arm.

use features.error_propagation.{Result}
use codegen.{StmtResult}
use codegen.{emit_block_loop}
use codegen.{ok_sr, err_sr}
/// Codegen entry for `select { ... }`. Pattern-matches the
/// `Select` AST node and forwards to `emit_select`.
export fn select_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .Select(arms) -> emit_select(ctx, env, arms)
        _ -> err_sr("select_emit_stmt: expected Select")
    }
}

/// Build a channel array from each arm, call `avra_select` to
/// block on whichever channel is ready first, then dispatch to
/// the matching arm via `emit_select_dispatch`.
fn emit_select(ctx: Ctx, env: List<VarBinding>, arms: List<SelectArm>) -> Result<StmtResult, string> {
    let channels = ctx.array_new()
    push_channels(ctx, env, arms, channels)?

    let result = ctx.call("avra_select", [channels, ctx.i64(arms.length)])
    let idx = ctx.call("avra_select_index", [result])
    let val = ctx.call("avra_select_value", [result])

    emit_select_dispatch(ctx, env, arms, idx, val, 0)
}

/// Walk the arms, emitting each channel expression and pushing
/// its value into `arr`.
fn push_channels(ctx: Ctx, env: List<VarBinding>, arms: List<SelectArm>, arr: ptr) -> Result<int, string> {
    mut i = 0
    while i < arms.length {
        let r = ctx.emit(env, arms[i].channel)?
        ctx.array_push(arr, ctx.to_i64(r.value, "ch_i64"))
        i = i + 1
    }
    Result.Ok(arms.length)
}

/// Emit a chained-if dispatch: compare the runtime arm index
/// against each arm's static index, branch into the matching
/// body with the received value bound, fall through otherwise.
fn emit_select_dispatch(ctx: Ctx, env: List<VarBinding>, arms: List<SelectArm>, idx: ptr, val: ptr, arm_idx: int) -> Result<StmtResult, string> {
    if arm_idx >= arms.length { return ok_sr(ctx, env) }
    let arm = arms[arm_idx]
    let cmp = ctx.eq(idx, ctx.i64(arm_idx), "sel_cmp")
    let then_bb = ctx.bb("sel_then")
    let else_bb = ctx.bb("sel_else")
    let merge_bb = ctx.bb("sel_merge")
    ctx.cond_br(cmp, then_bb, else_bb)

    ctx.position(then_bb)
    let body_env = ctx.bind(env, arm.binding, val, .Unknown)
    emit_block_loop(ctx, body_env, arm.body, ctx.i64(0), .Unknown)?
    ctx.br_if_open(merge_bb)

    ctx.position(else_bb)
    let next_r = emit_select_dispatch(ctx, env, arms, idx, val, arm_idx + 1)?
    ctx.br_if_open(merge_bb)

    ctx.position(merge_bb)
    ok_sr(ctx, env)
}
