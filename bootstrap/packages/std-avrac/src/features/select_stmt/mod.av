// dir-as-module (g2eo.1): no `mod` decls — codegen.av + parser.av +
// resolver.av auto-load as siblings, surface flat at
// `features.select_stmt.{...}`. Sibling exports are in scope without
// explicit self-imports.
use core.{feature_new, Feature}

/// Resolver hook for `select`. Forwards to `resolve_select_arms`
/// which walks each channel expression and arm body.
fn select_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Select(arms) -> resolve_select_arms(r, arms), _ -> r }
}


/// Register the `select { ... }` channel-multiplexing feature.
/// Spec Axis 18: blocks until one of the listed channels is
/// ready, then runs the matching arm.
export fn select_feature() -> Feature {
    feature_new("select") with {
        stmt_tag: Stmt.Select(SelectArmList.End),
        decl_keyword: "kw_select",
        parse_decl: (p: Parser) -> p.parse_select_statement(),
        emit_stmt: select_emit_stmt,
        resolve_stmt: select_resolve,
    }
}
