// select — channel multiplexing (spec Axis 18). The definition carries the
// feature whole: syntax, docs, editor surface, hooks, and the grammar rules
// the DECLARATION view composes (t-kd4y.3.2.4) — the lowerings are
// feature-owned via the builder manifest in lowering/.
// dir-as-module (g2eo.1): no `mod` decls — codegen.av + grammar.av +
// resolver.av auto-load as siblings, surface flat at
// `features.select_stmt.{...}`. Sibling exports are in scope without
// explicit self-imports.
use core.{SelectArm}
use typeck.{check_expr, check_stmt_ids, tc_enter, tc_exit, tc_bind}
use features.{composed}
use features.select_stmt.lowering.{select_builds}
use features.grammar.{parse_grammar}

/// Type-check hook for `select`. Each arm's channel expression is
/// checked in the enclosing scope; a typed channel (Channel<elem>)
/// gives the arm binding `elem`, a legacy raw-extern channel (ptr)
/// leaves it Unknown — same permissiveness the pre-typed runtime
/// surface had. Arm bodies are checked in a fresh scope with the
/// binding visible (they previously skipped typecheck entirely).
fn select_check(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Select(arms) -> {
            mut cur = tc
            mut i = 0
            while i < arms.length {
                let arm = arms[i]
                let c = check_expr(cur, cur.nodes.exprs.get(arm.chan_id))
                let elem = match c.ty {
                    .Channel(e) -> e
                    _ -> ValueType.Unknown
                }
                let inner = tc_enter(c.tc)
                let bound = tc_bind(inner, arm.binding, elem)
                let after = check_stmt_ids(bound, arm.body_ids)
                cur = tc_exit(after)
                i = i + 1
            }
            cur
        }
        _ -> tc
    }
}

/// The `select { ... }` channel-multiplexing feature — the definition
/// carries it whole (t-kd4y.3.2.4): syntax, docs, editor surface, hooks,
/// and the LOWERINGS its own grammar references. `gram_family` stays "" —
/// `select_decl` is a DECLARATION rule, composed by
/// `feature_decl_grammar_fragments` beside the other decl keywords, not by
/// the statement views.
@language_feature
export fn select_lang() -> LanguageFeature {
    let empty_arms: List<SelectArm> = []
    LanguageFeature select_def {
        name = "select",
        title = "select — block until one of several channels is ready",
        docs = """
`select { v <- ch -> { body } }` blocks until one of the listed channels
has a value, then binds it and runs that arm's body (spec Axis 18). Each
arm's binding takes the channel's element type — a `Channel<T>` gives
`T`, a legacy raw-extern channel leaves it unknown — and is visible only
inside that arm's body. Zero arms is legal: `select { }` blocks forever.
""",
        gram = grammar {
  // NOT committed, for the reason recorded on `enum_decl`: `select { x }` must report
  // the missing `<-` and still build `(select ())`, while a committed rule ABORTS to
  // `(error)` and additionally leaves the `}` unconsumed so the caller adds a spurious
  // F0013. A gated element's failure needs to SKIP the element and let the rule close,
  // which is a non-aborting mode the DSL does not have.
  select_decl   = @try "select" @cut @require "{" ( @peek(not_rbrace) @gate @onfail(close) arms:select_arm )* @require "}"
                  @expect("{", "expected `{` after select")
                  @expect("}", "expected `}` to close select") -> MkSelect(arms)
  select_arm    = b:IDENT @require "<-" @onfail(bail) ch:expression @require "->" @require "{" body:declaration* @require "}"
                  @expect("IDENT", "expected select arm binding name")
                  @expect("<-", "expected `<-` after select arm binding")
                  @expect("->", "expected `->` after channel in select arm")
                  @expect("{", "expected `{` for select arm body")
                  @expect("}", "expected `}` to close select arm") -> MkSelectArm(b, ch, body)
            },
        builders = select_builds(),
        snippet = r"select {\n    ${1:v} <- ${2:ch} -> {\n        ${3:body}\n    }\n}",
        stmt_tag = Stmt.Select(empty_arms),
        emit_stmt = select_emit_stmt,
        resolve_stmt = select_resolve,
        check_stmt = select_check,
    }
    select_def
}
