// WHY: parses `select { binding <- channel -> { body } }` statements.

use parse.{Parser}
use core.{Stmt, SelectArm}
use core.{Tk}

impl Parser {
    fn parse_select_statement(self) -> Result<StmtId, string> {
        self.advance()  // consume `select`
        if !self.consume(Tk.LeftBrace, "expected `{` after select") {
            return .Err("parse error")
        }
        let arms = self.parse_select_arm_list()
        if !self.consume(Tk.RightBrace, "expected `}` to close select") {
            return .Err("parse error")
        }
        // `Select` is walker-opaque (SelectArm isn't a registered container
        // struct), so the canonical ingest records NO children — the native
        // alloc mirrors that as a leaf; the arms' natively-parsed rows
        // orphan until SelectArm registers with the walker.
        .Ok(self.alloc_stmt_leaf(Stmt.Select(arms)))
    }

    fn parse_select_arm_list(self) -> List<SelectArm> {
        mut out: List<SelectArm> = []
        while !(self.current_kind in [Tk.RightBrace, Tk.Eof]) {
            // Parse: binding <- channel -> { body }
            if !self.check(Tk.Identifier) { return out }
            let binding = self.current_lexeme
            self.advance()
            // Expect `<-`. This MUST report before bailing: with the binding
            // already consumed, `select { x }` otherwise closes cleanly and the
            // arm vanishes with no diagnostic at all — the caller's `}` consume
            // only catches the bail when junk remains (the silent-drop bug the
            // error-recovery corpus caught while routing t-47hc Phase 4).
            if !self.check(Tk.LeftArrow) {
                self.set_error("expected `<-` after select arm binding")
                return out
            }
            self.advance()  // consume <-
            // Parse channel expression
            let chan_id = match self.parse_expression() {
                .Ok(c) -> c
                .Err(_) -> return out
            }
            // Expect `->`
            if !self.consume(Tk.Arrow, "expected `->` after channel in select arm") {
                return out
            }
            // Parse body block
            if !self.consume(Tk.LeftBrace, "expected `{` for select arm body") {
                return out
            }
            let body_parsed = match self.parse_statement_list_ids(true) {
                .Ok(b) -> b
                .Err(_) -> return out
            }
            if !self.consume(Tk.RightBrace, "expected `}` to close select arm") {
                return out
            }
            out.push(SelectArm { binding, chan_id, body_ids: body_parsed.ids })
        }
        out
    }
}
