// WHY: parses `select { binding <- channel -> { body } }` statements.

use parse.{Parser}
use core.{Stmt, SelectArm}
use core.{Tk}

impl Parser {
    fn parse_select_statement(self) -> Stmt? {
        self.advance()  // consume `select`
        if !self.consume(Tk.LeftBrace, "expected `{` after select") {
            return null
        }
        let arms = self.parse_select_arm_list()
        if !self.consume(Tk.RightBrace, "expected `}` to close select") {
            return null
        }
        Stmt.Select(arms)
    }

    fn parse_select_arm_list(self) -> List<SelectArm> {
        mut out: List<SelectArm> = []
        while !(self.current_kind in [Tk.RightBrace, Tk.Eof]) {
            // Parse: binding <- channel -> { body }
            if !self.check(Tk.Identifier) { return out }
            let binding = self.current_lexeme
            self.advance()
            // Expect `<-`
            if !self.check(Tk.LeftArrow) { return out }
            self.advance()  // consume <-
            // Parse channel expression
            let channel = self.parse_expression()
            if channel == null { return out }
            // Expect `->`
            if !self.consume(Tk.Arrow, "expected `->` after channel in select arm") {
                return out
            }
            // Parse body block
            if !self.consume(Tk.LeftBrace, "expected `{` for select arm body") {
                return out
            }
            let body = self.parse_statement_list(true)
            if body == null { return out }
            if !self.consume(Tk.RightBrace, "expected `}` to close select arm") {
                return out
            }
            out.push(SelectArm { binding, channel: channel!, body: body! })
        }
        out
    }
}
