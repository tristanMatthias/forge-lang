// The `select` feature's RESOLVER hook. One file per pass (features/WHY.md): a
// feature's mod.av is the CONTAINER — identity, gram, and which fn implements
// each pass — and the pass logic lives in the file named for that pass.
// Module-PRIVATE and staying so: dir-as-module flattens every sibling .av into
// one flat namespace, so mod.av reaches it exactly as before the move — and so
// does its call into the sibling `resolver.av`, which is a different thing: the
// arm walker shared with the rest of the feature, not a pass hook.
use core.{Stmt}
use resolve.{Resolver}

/// Resolver hook for `select`. Forwards to `resolve_select_arms`
/// which walks each channel expression and arm body.
fn select_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Select(arms) -> resolve_select_arms(r, arms), _ -> r }
}
