// WHY: t-47hc.8 — MODULAR per-feature grammar fragments. The `match` feature
// OWNS its pattern grammar HERE, colocated with its parser/codegen/resolver/
// typeck/tests, instead of living in the central features/grammar/ monolith
// (avra_grammar.av). This is the first proof of the epic's modularity
// constraint: each language feature contributes its OWN grammar fragment, and a
// composition step (features/grammar/compose.av `compose_fragments`) assembles
// the fragments into the whole-language grammar the generator consumes. The
// generic grammar ENGINE (executor / emit / seed_parser) stays in
// features/grammar/; only the feature-specific RULES move here — the seam that
// makes the eventual `language_feature match { ..., grammar { ... } }` component
// a mechanical bundling of the parser+codegen+tests+fragment that already live
// together in this directory.
//
// The fragment is authored as a `grammar { }` surface block (desugars to
// parse_grammar(<body>), features/grammar/parser.av) — identical IR to the
// hand-written call, so no seed cycle. Pattern builds (OrMaybe / MkVariant / …)
// are interpreted by the shared executor keyed on the build name carried in the
// grammar DATA, so moving the DEFINITION here does not move the engine.
use features.grammar.{parse_grammar, Grammar}

/// The §2 match-pattern family (ps3t.6.5.5): wildcard/`rest`, literals
/// (int/float/string/bool, incl. negatives), type patterns `int(n)`, bare and
/// bound variants `.None` / `.Ok(x, y)`, nested variants `.Some(.Ok(x))`, and
/// right-associative or-patterns `a or b or c`. SELF-CONTAINED — patterns do
/// not embed expressions, so no composition with the expression grammar. The
/// entry `pattern_or` mirrors the hand parser's parse_pattern_or.
export fn avra_pat_grammar() -> Grammar {
    let gp = grammar {
  pattern_or  = l:pattern ( "or" r:pattern_or )? -> OrMaybe(l, r)
  pattern     = opt_present | opt_absent | variant_pat | ident_pat | bool_pat | str_pat | neg_pat | num_pat
  opt_present = "let" name:IDENT -> OptPresent(name)
  opt_absent  = ( "none" | "null" ) -> OptAbsent()
  variant_pat = "." name:IDENT ( "(" ( binds:IDENT ( "," binds:IDENT )* | subs:variant_pat ( "," subs:pattern )* ) ")" )? -> MkVariant(name, binds, subs)
  ident_pat   = name:IDENT ( "(" b:IDENT ")" )? -> IdentPat(name, b)
  bool_pat    = b:("true" | "false") -> PatBool(b)
  str_pat     = s:STRING -> PatStr(s)
  neg_pat     = "-" n:NUMBER -> PatNegNum(n)
  num_pat     = n:NUMBER -> PatNum(n)
    }
    gp.grammar
}

/// The match ARM rules — the second fragment this feature owns, and the FIRST
/// fragment shared by two families (t-47hc.25). They used to live inline in the
/// statement grammar, which was fine while only `match_stmt` referenced them;
/// the expression `match_expr` needs the same rules, and each family's EMITTED
/// parser is generated from its OWN dispatch grammar (avra_expr_dispatch_grammar
/// / avra_decl_dispatch_grammar), each treating the other's rules as EXTERNAL.
/// So neither inline home works for both: whichever family did not define them
/// would emit the loud `avra_grammar_external_first_undeclared_match_arm(...)`
/// undeclared-FIRST call. Composing ONE fragment into BOTH dispatch grammars is
/// the fix — two generated `parse_match_arm` functions from one source, which is
/// what code generation is for.
///
/// `match_when_arm` must stay a SINGLE definition and must NOT be folded into
/// the expression family's `when_arm`: the hand `parse_when_arm_list` it mirrors
/// takes `_` as the ONLY default, never `else` — which `when { … }` DOES accept.
/// Merging them would silently widen the accepted language; a duplicated copy
/// would drift into the same outcome. One definition, referenced twice.
///
/// Both rules embed `expression` and `pattern_or`, which resolve after the flat
/// merge against whichever fragment defines them (compose.av) — the mechanism
/// that lets an arm reference the expression ladder without re-defining it.
export fn avra_match_arm_grammar() -> Grammar {
    let gp = grammar {
  match_when_arm = "_" "->" @off(allow_dot_postfix) b:expression -> MkWhenDefault(b)
                 | c:expression "->" @off(allow_dot_postfix) b:expression -> MkWhenArm(c, b)
  match_arm     = p:pattern_or ( "if" g:expression )? "->" @off(allow_dot_postfix) b:expression -> MkArm(p, g, b)
    }
    gp.grammar
}
