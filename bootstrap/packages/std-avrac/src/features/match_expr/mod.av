// dir-as-module (g2eo.1): parser.av + codegen.av + resolver.av +
// typeck.av auto-load as siblings, surface flat at `features.match_expr.{...}`.
// emit_match*, resolve_match_arms*, check_match_* are in scope without
// self-imports.
use codegen.types.{err_emit, err_stmt, StmtResult}
use codegen.{err_sr}
use features.eval.{error_result}
use core.registry.{feature_new, Feature}
use resolve.{resolve_expr}
use typeck.{check_expr, tc_er}

/// Register the `match` feature for both statement and
/// expression positions. Wires up parser, resolver, type-checker,
/// codegen, and eval hooks for each.
export fn match_feature() -> Feature {
    feature_new("match") with {
        expr_tag: Expr.MatchExpr(Expr.Null, MatchArmList.End),
        stmt_tag: Stmt.Match(Expr.Null, MatchArmList.End),
        emit_expr: match_emit_expr,
        emit_stmt: match_emit_stmt,
        resolve_stmt: match_resolve_stmt,
        resolve_expr: match_resolve_expr,
        check_stmt: match_check_stmt,
        check_expr: match_check_expr,
        eval_stmt: match_eval_stmt,
        eval_expr: match_eval_expr,
        stmt_keyword: "kw_match",
        parse_stmt: (p: Parser) -> p.parse_match_statement(),
    }
}

/// Register the subjectless `match { cond -> body, ... }` /
/// `when` expression feature. Distinct AST tag — no subject,
/// each arm carries its own boolean condition.
export fn when_feature() -> Feature {
    feature_new("match_when") with {
        expr_tag: Expr.When(WhenArmList.End),
        emit_expr: when_emit_expr,
        resolve_expr: when_resolve_expr,
        check_expr: when_check_expr,
        eval_expr: when_eval_expr,
    }
}

/// Resolver hook for `Match`. Resolves the subject in the
/// current scope, then walks every arm via `resolve_match_arms`.
fn match_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .Match(subject, arms) -> {
            let after_subject = resolve_expr(r, subject)
            resolve_match_arms(after_subject, arms)
        }
        _ -> r
    }
}

/// Resolver hook for `MatchExpr`. Mirror of
/// `match_resolve_stmt` for expression-position matches.
fn match_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .MatchExpr(subject, arms) -> {
            let after_subject = resolve_expr(r, subject)
            resolve_match_arms(after_subject, arms)
        }
        _ -> r
    }
}

/// Tree-walk evaluator hook for `Match`. Currently unsupported
/// — match's pattern semantics are codegen-only.
fn match_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Match(_, _) -> error_result(rt, "match statements are not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected Match")
    }
}

/// Tree-walk evaluator hook for `MatchExpr`. Mirror of
/// `match_eval_stmt`.
fn match_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .MatchExpr(_, _) -> error_result(rt, "match expressions are not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected MatchExpr")
    }
}

/// Resolver hook for `When`. Walks every arm's condition + body
/// through `resolve_when_arms`.
fn when_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .When(arms) -> resolve_when_arms(r, arms)
        _ -> r
    }
}

/// Type-check hook for `When`. Forwards to `check_when_expr`
/// which infers a unifying result type across the arms.
fn when_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .When(arms) -> check_when_expr(tc, arms)
        _ -> tc_er(tc, .Unknown)
    }
}

/// Tree-walk evaluator hook for `When`. Currently unsupported
/// — subjectless matching is codegen-only.
fn when_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .When(_) -> error_result(rt, "subjectless match is not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected When")
    }
}

/// Codegen hook for `MatchExpr`. Forwards to `emit_match_expr`.
fn match_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .MatchExpr(subject, arms) -> emit_match_expr(ctx, env, subject, arms)
        _ -> err_emit("expected MatchExpr")
    }
}

/// Codegen hook for `Match`. Forwards to `emit_match`.
fn match_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .Match(subject, arms) -> emit_match(ctx, env, subject, arms)
        _ -> err_sr("expected Match")
    }
}

/// Codegen hook for `When`. Forwards to `emit_when_expr`.
fn when_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .When(arms) -> emit_when_expr(ctx, env, arms)
        _ -> err_emit("expected When")
    }
}

/// Type-check hook for `Match`. Type-checks the subject, runs
/// exhaustiveness analysis (spec Axis 4), then walks every arm.
fn match_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Match(subject, arms) -> {
            let s = check_expr(tc, subject)
            let checked = tc_check_exhaustive(s.tc, s.ty, arms)
            check_match_arms(checked, arms)
        }
        _ -> tc
    }
}

/// Type-check hook for `MatchExpr`. Same exhaustiveness check
/// as `match_check_stmt`, but also runs `check_match_expr_infer`
/// to compute a unifying result type for the arms.
fn match_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .MatchExpr(subject, arms) -> {
            let s = check_expr(tc, subject)
            let checked = tc_check_exhaustive(s.tc, s.ty, arms)
            check_match_expr_infer(checked, arms)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
