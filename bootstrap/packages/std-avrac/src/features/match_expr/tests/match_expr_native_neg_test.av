// WHY: t-47hc.25 — the native `match_expr` owns its own diagnostics now, and diff-test
// CANNOT see them: it compares IR for VALID programs, so the error text of an invalid one
// is outside its oracle entirely. These are the isolate-run negative tests for that gap.
//
// The two messages come from `@require "{"` / `@require "}"` paired with `@expect`, which
// together reproduce what the hand does with `consume(...) else return .Err`: report, then
// ABORT the rule rather than error-tolerantly building a partial node. Getting the report
// but losing the abort is the specific regression this pins — a `match` with a malformed
// header would otherwise keep consuming and swallow whatever follows it.
//
// Each case is also checked against the HAND parser (AVRA_PARSER_DECL_FLIP=0). Asserting
// the message alone would not catch the grammar and the hand drifting apart; asserting
// only agreement would not catch BOTH regressing to the same wrong text.
extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

use @std.avrac.features.grammar.{emit_parser_source, avra_expr_dispatch_grammar}

/// The emitted expression-family parser source — where match_expr's own diagnostics live.
fn generated_match_expr_source() -> string { emit_parser_source(avra_expr_dispatch_grammar()) }

fn check_out(env: string, source: string) -> string {
    let path = "/tmp/avra_match_expr_neg.av"
    write_fixture(path, source)
    avra_shell_exec("${env} ./build/bs2 check '${path}' 2>&1")
}

fn dsl(source: string) -> string { check_out("AVRA_NO_STATIC_FALLBACK=1", source) }
fn hand(source: string) -> string { check_out("", source) }

// The occurrence-ordered F-code signature — set, order and count together.
fn codes(out: string) -> string {
    mut sig = ""
    for line in out.split("\n") {
        mut i = 0
        while i + 5 <= line.length {
            let c = line.substring(i, i + 5)
            if c.substring(0, 1) == "F" { sig = sig + c + " " }
            i = i + 1
        }
    }
    sig
}

fn agrees(source: string) -> bool { codes(dsl(source)) == codes(hand(source)) }

fn missing_open() -> string {
    "fn f(n: int) -> int {\n    let v = match n\n        0 -> 1\n        _ -> 2\n    }\n    return v\n}"
}

fn missing_close() -> string {
    "fn f(n: int) -> int {\n    let v = match n {\n        0 -> 1\n        _ -> 2\n    return v\n}"
}

spec "t-47hc.25: the native match expression reports its own brace diagnostics" {
    then "a missing `{` after the subject names the subject" {
        dsl(missing_open()).contains("expected `{` after match subject")
    }
    then "both are REJECTED, not recovered into a silent partial parse" {
        !dsl(missing_open()).contains("\nok") && !dsl(missing_close()).contains("\nok")
    }
    then "the generated parser carries BOTH brace diagnostics and aborts on each" {
        // Structural, because at whole-program level the grammar's own `}` message is not
        // observable: on ANY DSL error the flip falls back to the authoritative hand
        // parser, which then owns the reporting (by design — that is what keeps error
        // trees byte-identical). So `bs2 check` shows the HAND's diagnostic even here,
        // which is exactly why the agreement specs below are the load-bearing ones and a
        // message assertion alone would prove little. What IS checkable is that the
        // emitted parser reports and then RETURNS rather than error-tolerantly building a
        // partial node — the `@require` abort that stops a malformed header from running
        // away and swallowing what follows.
        let gen = generated_match_expr_source()
        gen.contains("expected `{` after match subject") &&
            gen.contains("expected `}` after match arms") &&
            gen.contains("return CapVal.Node(st.error_node_silent())")
    }
}

spec "t-47hc.25: the native match expression agrees with the hand oracle on invalid input" {
    then "missing `{` recovers to the same F-code sequence" { agrees(missing_open()) }
    then "missing `}` recovers to the same F-code sequence" { agrees(missing_close()) }
    then "a malformed ARM agrees too (the arm loop's own failure path)" {
        agrees("fn f(n: int) -> int {\n    let v = match n {\n        0 -> \n        _ -> 2\n    }\n    return v\n}")
    }
    then "and a match with NO arms at all agrees" {
        agrees("fn f(n: int) -> int {\n    let v = match n {\n    }\n    return v\n}")
    }
}

spec "t-47hc.25: valid match expressions still parse clean" {
    then "ordinary subject form" {
        dsl("fn f(n: int) -> int {\n    let v = match n {\n        0 -> 1\n        _ -> 2\n    }\n    return v\n}").contains("ok")
    }
    then "subjectless form in expression position" {
        dsl("fn f(n: int) -> int {\n    let v = match {\n        n > 0 -> 1\n        _ -> 0\n    }\n    return v\n}").contains("ok")
    }
    then "a guard on an arm" {
        dsl("fn f(n: int) -> int {\n    let v = match n {\n        x if x > 3 -> 1\n        _ -> 2\n    }\n    return v\n}").contains("ok")
    }
}
