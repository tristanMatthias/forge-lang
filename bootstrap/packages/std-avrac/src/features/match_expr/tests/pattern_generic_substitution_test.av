// so07.7.4 step 2: when matching on a generic enum's variant whose
// subject_ty carries concrete type-args, the pattern bindings should
// be typed via T → concrete substitution from the enum decl's
// type-params + the subject's type_args.
//
// Honest caveat: with the current Unknown-as-wildcard escape hatch
// in `assignable_with_unknowns` (see so07.7.3) it's very hard to
// write a NEGATIVE test that fires only when W4 is present — the
// wildcard masks downstream misuse of an Unknown binding. These
// tests confirm runtime correctness (the binding's value flows
// through and arithmetic works). The typeck observability check
// proper lands when so07.7.3 removes the wildcard.

enum WResult<T, E> {
    Ok(value: T)
    Err(error: E)
}

fn wresult_unwrap_ok(r: WResult) -> int {
    match r {
        .Ok(value) -> value + 1
        .Err(_) -> 0
    }
}

fn wresult_unwrap_err(r: WResult) -> int {
    match r {
        .Err(error) -> error - 2
        .Ok(_) -> 0
    }
}

spec "pattern binding runtime correctness (so07.7.4)" {
    then "matching on Result.Ok(7) binds value as int (runtime)" {
        wresult_unwrap_ok(WResult.Ok(7)) == 8
    }
    then "matching on Result.Err(42) binds error as int (runtime)" {
        wresult_unwrap_err(WResult.Err(42)) == 40
    }
}
