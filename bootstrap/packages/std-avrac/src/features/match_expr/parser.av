// WHY: parses `match` as both a statement and an expression, plus the
// pattern syntax that match arms use.
//
// AGENT:
//   read this file when:    adding match-arm forms or new pattern shapes
//   do NOT read this file when:   the issue is expression precedence (parser.av)
//   related:                features/match_expr/codegen.av, core.ast.{Pattern, MatchArm}

use core.{Stmt, Expr, Pattern, MatchArm, WhenArm, ParamEntry, pattern_optional_present, pattern_optional_absent}
use core.{NodeRef, ExprId, StmtId, PatId, byte_span_none}
use parse.{Parser, table_zip_entries}
use diagnostics.{syntax_diag_code}
use core.{Tk}
use diagnostics.{DiagCode}
// ps3t.6.5.12 pattern-family swap-in: parse_pattern_or / parse_pattern delegate
// to the grammar-DSL when pat_flip is set (the inverse of the @hand bridge).
use features.grammar.{run_dsl_pattern_at_shared, DslPatResult, Grammar}
use parse.{run_static_pat}
use parse.{run_static_expr_cell}
// t-47hc.8: the pattern grammar fragment is owned by THIS feature (grammar.av).
use features.match_expr.{avra_pat_grammar}

/// One parse of a match-arm list, surfaced both ways: `arms` is the boxed
/// view; `refs` the arena rows backing each arm's WALKED children for the
/// parent MatchExpr's edge list. B-final F4b: MatchArm is a MIXED node, so
/// that is the pattern only (guard/body are opaque `ExprId`s) — mirroring
/// `match_arm_children_spanned`.
type MatchArmsParsed = { arms: List<MatchArm>, refs: List<NodeRef> }

impl Parser {
    fn parse_match_statement(self) -> Result<StmtId, string> {
        self.advance()
        // Subjectless match at statement level: wrap result in Stmt.Expr(Expr.When(...))
        // (`When` is walker-opaque — a leaf row, same as the expression form).
        if self.check(Tk.LeftBrace) {
            self.advance()
            let arms = self.parse_when_arm_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after match arms") { return .Err("parse error") }
            let when_id = self.alloc_leaf(Expr.When(arms))
            return .Ok(self.alloc_stmt_leaf(Stmt.Expr(when_id)))
        }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let subject = subject_opt?
        // Match table: `match expr table { pattern | col | col; .A | v | v }`
        // — arms come back boxed (the rare path); their children bridge whole.
        if self.check(Tk.Identifier) && self.current_lexeme == "table" {
            self.advance()  // consume `table`
            if !self.consume(Tk.LeftBrace, "expected `{` after match table") { return .Err("parse error") }
            let arms = self.parse_match_table_arms()?
            if !self.consume(Tk.RightBrace, "expected `}` after match table") { return .Err("parse error") }
            let node = Stmt.Match(subject, arms)
            return .Ok(self.alloc_stmt(node, byte_span_none(), self.glue_match_arm_refs(arms)))
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after match subject") {
            return .Err("parse error")
        }
        let parsed = self.parse_match_arm_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after match arms") {
            return .Err("parse error")
        }
        let node = Stmt.Match(subject, parsed.arms)
        .Ok(self.alloc_stmt(node, byte_span_none(), parsed.refs))
    }

    // Parse match table: first row is headers, remaining rows are pattern | values.
    // Desugars each row to a match arm returning a MapLit.
    fn parse_match_table_arms(self) -> Result<List<MatchArm>, string> {
        // Parse header row: identifiers separated by |
        mut headers: List<ExprId> = []
        mut header_count = 0
        let header_line = self.current_line
        while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) && self.current_line == header_line {
            if self.check(Tk.Identifier) {
                let col = self.current_lexeme
                self.advance()
                // Wrap in quotes so strip_quotes in codegen produces the correct key
                let quoted_col = "\"${col}\""
                headers.push(self.alloc_leaf(Expr.String(quoted_col)))
                header_count = header_count + 1
                if self.check(Tk.Pipe) { self.advance() }
            } else {
                break
            }
        }
        let empty_arms: List<MatchArm> = []
        if header_count < 2 { return .Ok(empty_arms) }
        // Skip the first header (pattern column) by copying from index 1
        mut value_headers: List<ExprId> = []
        mut hi = 1
        while hi < headers.length {
            value_headers.push(headers[hi])
            hi = hi + 1
        }
        let value_count = header_count - 1
        // Parse data rows: pattern | val1 | val2
        self.parse_match_table_rows(value_headers, value_count)
    }

    fn parse_match_table_rows(self, headers: List<ExprId>, value_count: int) -> Result<List<MatchArm>, string> {
        // Source-order loop appending each row's match arm directly
        // into a growable `List<MatchArm>` — arm order matters
        // (first-match-wins).
        mut out: List<MatchArm> = []
        while !(self.current_kind in [Tk.RightBrace, Tk.Eof]) {
            // Parse pattern — disable dot postfix to prevent .Variant from
            // becoming a field access on the previous expression
            let saved_dot = self.allow_dot_postfix
            self.allow_dot_postfix = false
            let table_pat_id = self.parse_pattern()?
            let pattern = self.pat_of(table_pat_id)
            self.allow_dot_postfix = saved_dot
            if self.check(Tk.Pipe) { self.advance() }
            // Parse values — one per column, stopping at | separators
            mut vals: List<ExprId> = []
            mut i = 0
            while i < value_count {
                if self.check(Tk.RightBrace) { break }
                // Table cell: the generated expression parser entered at BINDING POWER 12
                // (bitwise-XOR), the same entry `parse_table_literal` uses. Was `parse_primary()`
                // from the hand ladder.
                //
                // The entry matters and `parse_expression` is the WRONG one: `|` is a real
                // binary operator (lbp 10), so a full-precedence parse folds `1 | 2` into one
                // bitwise-or and `table_zip_entries` then silently drops the missing column.
                // Raised by review on this PR; the multi-column int row is the witness and is
                // pinned in match_table_column_separator_test.av.
                let cell_modes = self.current_modes()
                let cd = self.ensure_hand_delegate()
                cd.copy_cursor_from(self)
                let cell = run_static_expr_cell(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, cell_modes, cd)
                if cell.had_error {
                    self.had_error = true
                    return .Err("table cell parse error")
                }
                self.resync_to_stop_byte(cell.stop_byte)
                let val_id = cell.expr
                vals.push(val_id)
                i = i + 1
                if self.check(Tk.Pipe) { self.advance() }
            }
            let map_entries = table_zip_entries(headers, vals)
            let body = Expr.MapLit(map_entries)
            let table_body_id = self.alloc_leaf(body)
            if self.check(Tk.Comma) { self.advance() }
            out.push(MatchArm {
                pattern,
                pattern_id: table_pat_id,
                guard_id: none,
                body_id: table_body_id,
            })
        }
        .Ok(out)
    }

    // Parse a pattern that may be an OR of alternatives: `pat or pat or pat`.
    // Only used in normal match arms — table rows use parse_pattern directly
    // so that `|` column separators are not consumed as part of OR patterns.
    // The DSL pattern grammar for this parser, built at most once (lex-once
    // cache). The `??` fallback is unreachable — non-null after the guard.
    fn dsl_pattern_grammar(self) -> Grammar {
        if self.dsl_pat_grammar == null {
            self.dsl_pat_grammar = avra_pat_grammar()
        }
        self.dsl_pat_grammar ?? avra_pat_grammar()
    }

    // Pattern-family entry, UNCONDITIONAL (t-bgf8): the grammar owns or-patterns.
    // `pat_static` picks the CHECKED-IN generated parser (run_static_pat) or the
    // tree INTERPRETER (run_dsl_pattern_at_shared) — two engines driving the
    // identical pattern-builders, so the DslPatResult is the same either way.
    // There is no third choice: `parse_pattern_or_hand` and the `pat_flip` field
    // that used to select it are deleted, making patterns the FOURTH and last
    // family to retire its hand parser, after expressions (t-47hc.4.1),
    // statements (t-47hc.37) and types.
    //
    // MEASURED BEFORE DELETING, and the measurement corrected the premise. t-bgf8
    // was filed saying this fallback was "a LIVE production fallback, reached on
    // invalid input" — read off the `// DSL parse error → fall through` comment
    // rather than measured. A refusal probe at this entry fired ZERO times over
    // the whole @std::avrac compile, all 24 difftest corpus files, ten malformed
    // pattern fixtures, and `bs2 expr` — with the flags forced off. The probe was
    // NOT blind: refusing it turned 4 of 5 specs in pat_flip_dispatch_test red,
    // which is the positive control that makes the zeros mean something. The hand
    // chain was reachable only from tests, exactly like the statement subgraph
    // #1221 removed, because production parses `match` through the generated
    // declaration parser and never enters these `impl Parser` methods.
    fn parse_pattern_or(self) -> Result<PatId, string> {
        let dsl = if self.pat_static {
            run_static_pat(self.grammar_tokens(), self.current_start, self.source, self.store)
        } else {
            run_dsl_pattern_at_shared(self.grammar_tokens(), self.current_start, self.source, self.store, self.dsl_pattern_grammar(), "pattern_or")
        }
        if !dsl.had_error {
            // `check(Tk.Eof)`, not `is_at_end()`. They are different questions and the
            // difference is a real off-by-one: `is_at_end` is a LEXER position test
            // (`current >= source_len`, parse/lexer.av), so it goes true as soon as the
            // scanner has consumed the last byte — while a final token is still STAGED
            // and unconsumed. The resync then stops one token short and leaves it
            // current, so a caller continues on a token the pattern already covered.
            // `check(Tk.Eof)` asks about the staged TOKEN, which is what this loop means.
            //
            // The sibling type seam (parse/mod.av) has always used the token form; this
            // one used the lexer form. Raised in review on #1224, pre-existing rather
            // than introduced here — but this is the change that makes this seam the
            // sole pattern entry, so leaving a known-wrong resync in it is exactly the
            // hack-that-survives-a-commit the rules forbid.
            while self.current_start < dsl.stop_byte && !self.check(Tk.Eof) {
                self.advance_token()
            }
            return .Ok(dsl.pat)
        }
        // OWN THE RECOVERY. With no hand to fall through to, this seam is the only
        // place a pattern diagnostic can reach the user — so surface the grammar's
        // own, by span, rather than a generic stand-in. This is the defect review
        // caught on the TYPE seam in #1223 (it reported the caller's placeholder and
        // dropped `dsl.diags` entirely); the pattern seam had the same shape and it
        // is fixed here in the same change that makes it reachable.
        if dsl.diags.length == 0 {
            self.report(DiagCode.SyntaxError, "expected pattern")
        } else {
            mut gi = 0
            while gi < dsl.diags.length {
                let gd = dsl.diags[gi]
                let dc = syntax_diag_code(gd.code)
                if dc != null {
                    self.report_at_span(dc!, gd.msg, gd.byte, gd.end_byte)
                } else {
                    self.report_at_span(DiagCode.SyntaxError, gd.msg, gd.byte, gd.end_byte)
                }
                gi = gi + 1
            }
        }
        .Err("pattern parse error")
    }

    fn parse_match_arm_list(self) -> Result<MatchArmsParsed, string> {
        // Source-order loop: each iteration parses one arm and
        // pushes it into the growable list. First-match-wins arm
        // ordering is preserved by the natural forward push.
        mut out: List<MatchArm> = []
        mut refs: List<NodeRef> = []
        while !self.check(Tk.RightBrace) {
            // qa6i probe 2: `~target` in match-arm position splices
            // a `List<MatchArm>` value into the surrounding match
            // body at expansion time. Only fires inside a quote
            // (the splice marker has no meaning outside one).
            // Encoded as a sentinel arm: TypePattern("__quote_splice_arms__", "")
            // with the splice expression stashed in body. The
            // quote lowerer (construct_match_arm_list) detects the
            // sentinel and emits `list_concat` over the segments
            // between sentinels.
            if self.check(Tk.Tilde) && self.quote_depth > 0 {
                self.advance()
                // Quote-splice target: the generated expression parser. Was `parse_unary()`; a splice
                // target is `~x` / `~f(x)`, and the following `,` or `}` terminates it either way.
                let target_id = self.parse_expression()?
                if self.check(Tk.Comma) { self.advance() }
                let sentinel_pat = Pattern.TypePattern("__quote_splice_arms__", "")
                let splice = Expr.Splice(target_id)
                let sentinel_pat_id = self.alloc_pat_leaf(sentinel_pat)
                let splice_id = self.alloc_leaf(splice)
                // B-final F4b: MatchArm is MIXED — only the pattern is a walked
                // child; the body is an opaque ExprId carried structurally.
                refs.push(NodeRef.PatRef(sentinel_pat_id))
                out.push(MatchArm {
                    pattern: sentinel_pat,
                    pattern_id: sentinel_pat_id,
                    guard_id: none,
                    body_id: splice_id,
                })
                continue
            }
            let pat_id = self.parse_pattern_or()?
            let pattern = self.pat_of(pat_id)
            refs.push(NodeRef.PatRef(pat_id))
            // Optional guard: `pattern if cond ->`
            // B-final F4b: guard/body are opaque ExprIds carried structurally —
            // MatchArm is a MIXED walker node whose only walked child is the pattern.
            mut guard_id: ExprId? = none
            if self.check(Tk.KwIf) {
                self.advance()
                guard_id = self.parse_expression()?
            }
            if !self.consume(Tk.Arrow, "expected `->` after pattern") {
                return .Err("parse error")
            }
            let saved = self.allow_dot_postfix
            self.allow_dot_postfix = false
            // Allow `return expr` in bare match arm position by
            // wrapping it in a Block expression: `{ return expr }`.
            // The wrap is stmt-bearing, so it bridges at its boundary.
            mut body_id = ExprId(0)
            if self.check(Tk.KwReturn) {
                // Capture the `return` keyword's position BEFORE parsing the
                // expression, which advances the cursor past it. Stamping the
                // synthesized return row with the post-advance cursor would
                // point a field-access null-trap at the delimiter/next token
                // instead of the `return`.
                let ret_line = self.current_line
                let ret_col = self.current_column
                self.advance()
                // Bare `-> return` (no value on the same line) is Stmt.ReturnEmpty,
                // mirroring parse_return_statement's newline-sensitivity (t-uv1n).
                // Without this the arm folds the NEXT arm's pattern into the
                // return value and fails to parse. `Tk.Comma` is the arm
                // separator; `}` ends the match; a later line is a new arm.
                let ret_id = if self.current_kind in [Tk.RightBrace, Tk.Comma, Tk.Eof] || self.current_line != ret_line {
                    self.store.stmts.add_leaf(Stmt.ReturnEmpty)
                } else {
                    let rv_id = self.parse_expression()?
                    self.store.stmts.add_leaf(Stmt.Return(rv_id))
                }
                // Flipped Expr.Block holds List<StmtId> (walker-opaque leaf).
                // Stamp the synthesized return row with the `return` position +
                // originating file (not the post-advance cursor).
                self.store.set_stmt_pos(ret_id, ret_line, ret_col, self.file)
                let body_stmts: List<StmtId> = [ret_id]
                body_id = self.alloc_leaf(Expr.Block(body_stmts))
            } else {
                body_id = self.parse_expression()?
            }
            self.allow_dot_postfix = saved
            if self.check(Tk.Comma) { self.advance() }
            out.push(MatchArm {
                pattern,
                pattern_id: pat_id,
                guard_id,
                body_id,
            })
        }
        .Ok(MatchArmsParsed { arms: out, refs: refs })
    }

    fn parse_pattern(self) -> Result<PatId, string> {
        if self.check(Tk.Identifier) && self.current_lexeme == "_" {
            self.advance()
            return .Ok(self.alloc_pat_leaf(Pattern.Wildcard))
        }
        // `rest` is CONTEXTUAL: only the whole bare pattern `rest` is the
        // explicit remainder arm (ps3t.7.1). Everywhere else — bindings,
        // type patterns `rest(n)`, expression position — `rest` stays an
        // ordinary identifier, so no existing code changes meaning.
        if self.check(Tk.Identifier) && self.current_lexeme == "rest" && !self.peek_after_ident_is_paren() {
            self.advance()
            return .Ok(self.alloc_pat_leaf(Pattern.Rest))
        }
        // Optional-match surface (spec Axis 10.4). One rule everywhere:
        // `let <name>` binds the present value — here it lowers to the
        // present arm `.Some(name)`; `none` matches absence as `.None`.
        // The optional-match codegen routes these by variant name; on a
        // declared enum they read as ordinary `.Some`/`.None` variants.
        if self.check(Tk.KwLet) {
            self.advance()
            let bind = self.consume_identifier("expected binding name after `let` in pattern")?
            return .Ok(self.alloc_pat_leaf(pattern_optional_present(bind)))
        }
        if self.check(Tk.KwNone) || self.check(Tk.KwNull) {
            self.advance()
            return .Ok(self.alloc_pat_leaf(pattern_optional_absent()))
        }
        // Literal patterns: "string", 42, true, false
        if self.check(Tk.String) {
            let raw = self.current_lexeme
            self.advance()
            // Strip surrounding quotes from the lexeme
            let content = raw.substring(1, raw.length - 1)
            return .Ok(self.alloc_pat_leaf(Pattern.LitString(content)))
        }
        if self.check(Tk.Number) {
            let val = int(self.current_lexeme)
            self.advance()
            return .Ok(self.alloc_pat_leaf(Pattern.LitInt(val)))
        }
        if self.check(Tk.Float) {
            let val = self.current_lexeme
            self.advance()
            return .Ok(self.alloc_pat_leaf(Pattern.LitFloat(val)))
        }
        // Negative literal patterns: -42, -3.14
        if self.check(Tk.Minus) {
            self.advance()
            if self.check(Tk.Number) {
                let val = int(self.current_lexeme)
                self.advance()
                return .Ok(self.alloc_pat_leaf(Pattern.LitInt(0 - val)))
            }
            if self.check(Tk.Float) {
                let val = "-${self.current_lexeme}"
                self.advance()
                return .Ok(self.alloc_pat_leaf(Pattern.LitFloat(val)))
            }
            self.set_error("expected number after `-` in pattern")
            return .Err("parse error")
        }
        if self.check(Tk.KwTrue) {
            self.advance()
            return .Ok(self.alloc_pat_leaf(Pattern.LitBool(true)))
        }
        if self.check(Tk.KwFalse) {
            self.advance()
            return .Ok(self.alloc_pat_leaf(Pattern.LitBool(false)))
        }
        // Union type pattern: int(n), string(s), MyStruct(v)
        // Recognized when an identifier is followed by '(' — distinguishes from
        // enum variant patterns which start with '.'.
        if self.check(Tk.Identifier) && self.peek_after_ident_is_paren() {
            let type_name = self.current_lexeme
            self.advance()  // past type name identifier
            if !self.consume(Tk.LeftParen, "expected `(` in type pattern") { return .Err("parse error") }
            let binding = self.consume_identifier("expected binding name in type pattern")?
            if !self.consume(Tk.RightParen, "expected `)` after type pattern binding") {
                return .Err("parse error")
            }
            return .Ok(self.alloc_pat_leaf(Pattern.TypePattern(type_name, binding)))
        }
        if !self.consume(Tk.Dot, "expected `.`, `_`, literal, or type pattern to start pattern") {
            return .Err("parse error")
        }
        let name = self.consume_identifier("expected variant name in pattern")?
        if !self.check(Tk.LeftParen) {
            let empty_b: List<ParamEntry> = []
            return .Ok(self.alloc_pat_leaf(Pattern.Variant(name, empty_b)))
        }
        self.advance()
        // Detect nested patterns: if first token inside parens is `.`, `_`,
        // a literal, or `-`, parse as sub-pattern list. Otherwise simple bindings.
        if self.is_pattern_start() {
            let sub = self.parse_pattern_list()?
            if !self.consume(Tk.RightParen, "expected `)` after nested patterns") {
                return .Err("parse error")
            }
            // F2: the sub-pattern ids ARE the payload — the child mechanism
            // itself, so no PatRef edges (leaf view mirrors the ingest).
            return .Ok(self.alloc_pat_leaf(Pattern.NestedVariant(name, sub)))
        }
        let bindings = self.parse_param_list()?
        if !self.consume(Tk.RightParen, "expected `)` after binding list") {
            return .Err("parse error")
        }
        .Ok(self.alloc_pat_leaf(Pattern.Variant(name, bindings)))
    }

    fn is_pattern_start(self) -> bool {
        // Only `.` (sub-variant) triggers nested pattern mode.
        // Literals and `_` are ambiguous with simple bindings, so
        // we don't use them as triggers — they'll be parsed as
        // simple param bindings via parse_param_list.
        self.check(Tk.Dot)
    }

    fn parse_pattern_list(self) -> Result<List<PatId>, string> {
        mut out: List<PatId> = []
        while !self.check(Tk.RightParen) {
            let p = self.parse_pattern()?
            out.push(p)
            if self.check(Tk.Comma) { self.advance() }
        }
        .Ok(out)
    }

    fn parse_match_expression(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        self.advance()
        // Subjectless match: `match { cond -> body ... _ -> fallback }`.
        // `When` is walker-opaque (WhenArm isn't a registered container
        // struct), so the canonical ingest records NO children — the native
        // alloc mirrors that as a leaf; the arms' natively-parsed rows
        // orphan until WhenArm registers with the walker.
        if self.check(Tk.LeftBrace) {
            self.advance()
            let arms = self.parse_when_arm_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after match arms") { return .Err("parse error") }
            return .Ok(self.alloc_at(Expr.When(arms), sp_start))
        }
        let saved_struct = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject_opt = self.parse_expression()
        self.allow_struct_lit = saved_struct
        let subject = subject_opt?
        // Match table expression — arms come back boxed (the rare path),
        // so their children bridge whole via the glue helper.
        if self.check(Tk.Identifier) && self.current_lexeme == "table" {
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after match table") { return .Err("parse error") }
            let arms = self.parse_match_table_arms()?
            if !self.consume(Tk.RightBrace, "expected `}` after match table") { return .Err("parse error") }
            // Flipped: subject is an ExprId scalar (walker-opaque), so it records
            // NO edge — only the arms' children (glued whole on this boxed path).
            let node = Expr.MatchExpr(subject, arms)
            return .Ok(self.alloc_expr(node, self.span_from(sp_start), self.glue_match_arm_refs(arms)))
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after match subject") {
            return .Err("parse error")
        }
        let parsed = self.parse_match_arm_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after match arms") {
            return .Err("parse error")
        }
        // Flipped: subject is an ExprId scalar (walker-opaque) — no subject edge;
        // the row's children are exactly the arms' flattened children.
        let node = Expr.MatchExpr(subject, parsed.arms)
        .Ok(self.alloc_expr(node, self.span_from(sp_start), parsed.refs))
    }

    /// Edge refs for an arm list (the match-table path). B-final F4b: MatchArm
    /// is a MIXED walker node — only the pattern is a walked child; guard/body
    /// are opaque `ExprId`s carried structurally. So each arm bridges exactly
    /// its pattern, mirroring `match_arm_children_spanned`.
    fn glue_match_arm_refs(self, arms: List<MatchArm>) -> List<NodeRef> {
        mut refs: List<NodeRef> = []
        for arm in arms {
            // Reuse the arm's own pattern row so the parent edge and
            // `MatchArm.pattern_id` point at the SAME native pattern (table arms
            // already stored it); only re-ingest when no id exists.
            let pid = if arm.pattern_id != null { arm.pattern_id! } else { self.glue_ingest_pat(arm.pattern) }
            refs.push(NodeRef.PatRef(pid))
        }
        refs
    }

    // Convert subjectless match arms to an if-else chain.
    fn parse_when_arm_list(self) -> Result<List<WhenArm>, string> {
        mut out: List<WhenArm> = []
        while !self.check(Tk.RightBrace) {
            // `_` → else/wildcard arm (no condition)
            mut cond_id: ExprId? = none
            if self.check(Tk.Identifier) && self.current_lexeme == "_" {
                self.advance()
            } else {
                cond_id = self.parse_expression()?
            }
            if !self.consume(Tk.Arrow, "expected `->` in match arm") { return .Err("parse error") }
            let saved = self.allow_dot_postfix
            self.allow_dot_postfix = false
            let body_res = self.parse_expression()
            self.allow_dot_postfix = saved
            let body_id = body_res?
            if self.check(Tk.Comma) { self.advance() }
            out.push(WhenArm { cond_id, body_id })
        }
        .Ok(out)
    }
}
