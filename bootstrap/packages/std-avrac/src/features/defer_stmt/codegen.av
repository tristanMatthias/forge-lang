// WHY: codegen for `defer`, `errdefer`, and RC release (spec Axis 9.11, 12.7).
// All three use a single unified stack so they interleave in LIFO declaration
// order. defer = Frame (always runs), errdefer = ErrFrame (error only),
// Release = RC cleanup for ptr-typed locals.
// The stack lives on Ctx.defers — no mutable global needed.

use core.{VarEnv}
use codegen.{Ctx, DeferStack}
use codegen.{emit_rc_release_typed}

/// Emit scope-exit cleanup for a normal return. Walks the
/// DeferStack in LIFO order, running every `Frame` (defer body)
/// and `Release` (RC drop) entry — but skipping `ErrFrame`
/// (errdefer) entries which only fire on error returns.
export fn emit_defers(ctx: Ctx, env: VarEnv) {
    emit_stack_filtered(ctx, env, ctx.defers, false)
}

/// Emit scope-exit cleanup for an error return. Walks the
/// DeferStack in LIFO order running every entry (Frame +
/// ErrFrame + Release) — `errdefer` is the only kind that this
/// path activates beyond what `emit_defers` does.
export fn emit_defers_on_error(ctx: Ctx, env: VarEnv) {
    emit_stack_filtered(ctx, env, ctx.defers, true)
}

/// Recursive worker shared by `emit_defers` and
/// `emit_defers_on_error`. Pattern-matches each stack entry:
/// `Frame` always emits, `ErrFrame` emits only when `is_error`,
/// `Release` always loads + RC-releases. Recursion order
/// produces the required LIFO behaviour.
fn emit_stack_filtered(ctx: Ctx, env: VarEnv, stack: DeferStack, is_error: int) {
    match stack {
        .End -> {}
        .Frame(body, next) -> {
            // defer always runs
            ctx.emit(env, body.node)
            emit_stack_filtered(ctx, env, next, is_error)
        }
        .ErrFrame(body, next) -> {
            // errdefer only runs on error path
            if is_error { ctx.emit(env, body.node) }
            emit_stack_filtered(ctx, env, next, is_error)
        }
        .Release(name, alloca, ty, next) -> {
            // RC release — load and release the value
            let val = ctx.load_typed(ty, alloca, "${name}_cleanup")
            emit_rc_release_typed(ctx, val, ty)
            emit_stack_filtered(ctx, env, next, is_error)
        }
    }
}
