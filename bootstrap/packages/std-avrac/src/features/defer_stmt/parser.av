// WHY: parses `defer expr` and `errdefer expr` statements.
// defer runs at scope exit always. errdefer runs only on error exit (spec Axis 12.7).

use core.{Stmt, Expr}
use parse.{Parser}

impl Parser {
    fn parse_defer_statement(self) -> Result<Stmt, string> {
        self.advance()
        let body = self.parse_expression()?
        .Ok(Stmt.Defer(body))
    }

    fn parse_errdefer_statement(self) -> Result<Stmt, string> {
        self.advance()
        let body = self.parse_expression()?
        .Ok(Stmt.Errdefer(body))
    }
}
