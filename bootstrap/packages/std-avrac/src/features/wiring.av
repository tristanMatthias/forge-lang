// WHY: the compiler's WIRING — the `Feature` dispatch record, its no-op
// defaults, and the two functions that populate a Registry from the feature
// set. This lived in core/registry.av, which forced core/ (the layer every
// other layer imports) to depend UPWARD on codegen, typeck and features.eval
// just to name a default handler's return type. That is the t-y2i7.13
// inversion, and the fix is placement: a module that wires codegen + typeck +
// eval + features together necessarily sits ABOVE all of them.
//
// core/ keeps what is genuinely core: the `Registry` type, `registry_new`, the
// tag-keyed intmaps and the component-name helpers — data and map operations,
// no pass vocabulary.

use core.{Registry, registry_new, registry_set_add, registry_set_has, NodeStore, Expr, Stmt, Ctx, VarBinding, EmitValue, Resolver, TC, ExprResult}

// The registry's tag + intmap primitives, declared here as core/registry.av
// declares them: `extern fn` is per-file in this codebase.
extern fn avra_expr_tag(expr: int) -> int
extern fn avra_stmt_tag(stmt: int) -> int
extern fn avra_intmap_set(map: ptr, key: int, val: int)
use codegen.{err_emit, err_sr, StmtResult}
use typeck.{tc_er}
use eval.{value_null, Runtime, StepResult}


/// Codegen no-op for expressions — `err_emit("no expr handler")`.
// ── Component registry sets ──
//
// The SET NAMES live here, not in core/. core/registry.av used to carry
// `component_names`, `expr_keywords` and `raw_body_comps` as FIELDS plus five
// accessors, which meant the bottom layer knew what a "component" is and what a
// `kw { … }` expression form is — feature-specific knowledge in the layer every
// feature imports (CLAUDE.md: "core is infrastructure only"; t-y2i7.11). Core
// now stores generic named sets and knows nothing about what they mean; this
// vocabulary belongs to the features that own it.
//
// Every one of these is a PRESENCE test or a presence write. That is not a
// simplification made here — it is what the core accessors already were: all
// three reads were a bare `avra_map_has_cstr(...) != 0`, and the maps' value
// slots were a constant 1. The handler each map once claimed to store had no
// caller, which is why one generic set primitive covers all three.

/// Register a component name for keyword-free instantiation. After this,
/// `name instance { ... }` at statement level parses as a ComponentBlock — the
/// component declaration's name acts as a pseudo-keyword in the stmt parser.
export fn register_component_name(reg: Registry, name: string) {
    registry_set_add(reg, "component", name)
}

/// True when `name` was declared as a component.
export fn is_registered_component(reg: Registry, name: string) -> bool {
    registry_set_has(reg, "component", name)
}

/// Mark `name` as a `body: TokenStream` component (vez6.9): its instance
/// blocks capture raw tokens instead of structured Avra.
export fn register_raw_body_component(reg: Registry, name: string) {
    registry_set_add(reg, "raw_body", name)
}

/// True when `name` was declared with `body: TokenStream`.
export fn component_is_raw_body(reg: Registry, name: string) -> bool {
    registry_set_has(reg, "raw_body", name)
}

/// True when `keyword` leads a registered `kw { … }` expression construct
/// (e.g. `grammar`). Presence is the whole contract: it drives the
/// `ident_lbrace_plain` / `ident_lbrace_feature` peek conditions that
/// disambiguate `IDENT {` between a struct literal, `grammar { … }` and
/// `table { … }`.
export fn is_expr_keyword(reg: Registry, keyword: string) -> bool {
    registry_set_has(reg, "expr_keyword", keyword)
}

/// Register `keyword` as leading a `kw { … }` expression construct.
export fn register_expr_keyword(reg: Registry, keyword: string) {
    registry_set_add(reg, "expr_keyword", keyword)
}

export fn noop_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> { err_emit("no expr handler") }

/// Codegen no-op for statements — `err_sr("no stmt handler")`.
export fn noop_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> { err_sr("no stmt handler") }

/// Resolver no-op for expressions — pass-through.
export fn noop_resolve_expr(r: Resolver, expr: Expr) -> Resolver { r }

/// Resolver no-op for statements — pass-through.
export fn noop_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver { r }

/// Typecheck no-op for expressions — yields `Unknown`.
export fn noop_check_expr(tc: TC, expr: Expr) -> ExprResult { tc_er(tc, .Unknown) }

/// Typecheck no-op for statements — pass-through.
export fn noop_check_stmt(tc: TC, stmt: Stmt) -> TC { tc }

/// Eval no-op for expressions — error step ("no eval_expr handler").
export fn noop_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    StepResult { runtime: rt, value: value_null(), had_error: true, is_return: false, error_message: "no eval_expr handler" }
}

/// Eval no-op for statements — error step ("no eval_stmt handler").
export fn noop_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    StepResult { runtime: rt, value: value_null(), had_error: true, is_return: false, error_message: "no eval_stmt handler" }
}


/// Index `f` into every relevant map. Reads the variant tags off
/// the sentinel `expr_tag` / `stmt_tag` values when present, plus
/// the keyword strings for parser dispatch.
export fn register(reg: Registry, f: LanguageFeature) {
    if f.expr_tag != null {
        let etag = avra_expr_tag(f.expr_tag!)
        avra_intmap_set(reg.expr_emitters, etag, f.emit_expr)
        avra_intmap_set(reg.expr_resolvers, etag, f.resolve_expr)
        avra_intmap_set(reg.expr_checkers, etag, f.check_expr)
        avra_intmap_set(reg.expr_evals, etag, f.eval_expr)
    }
    if f.stmt_tag != null {
        let stag = avra_stmt_tag(f.stmt_tag!)
        avra_intmap_set(reg.stmt_emitters, stag, f.emit_stmt)
        avra_intmap_set(reg.stmt_resolvers, stag, f.resolve_stmt)
        avra_intmap_set(reg.stmt_checkers, stag, f.check_stmt)
        avra_intmap_set(reg.stmt_evals, stag, f.eval_stmt)
    }
    // stmt_keyword/parse_stmt died measured-unread (t-kd4y slice-1 evidence:
    // these writes keyed kw_*-style names the token-text lookup could never
    // match; the component_names set serves component names, written by
    // register_component_name). Batch A deleted the fields.
    if f.expr_keyword.length > 0 {
        registry_set_add(reg, "expr_keyword", f.expr_keyword)
    }
}

/// Construct + populate the Registry — EXPENSIVE: init_features re-runs
/// every LanguageFeature factory, and each definition's `grammar {}` block
/// re-parses into the program arena, which never frees. ONE registry per
/// program store is the contract (NodeStore.parse_features, lazy): every
/// pass shares it. Batch A measured the violation — four pass constructors
/// each built a FRESH registry, so every converted feature multiplied
/// arena growth across every pass construction (the #1232 regression
/// class); a 12GB+ F4014 on the GENPASS harness compile was the tell.
export fn build_registry() -> Registry {
    mut reg = registry_new()
    reg.builder_binds = init_features(reg)
    reg
}

/// The parse registry for a program's shared NodeStore — built on first
/// use, then reused by every subsequent file parsed over the same store,
/// so parse-time component registration is program-wide, not per-file.
impl NodeStore {
    fn parse_features(self) -> Registry {
        if self.parse_registry == null {
            self.parse_registry = build_registry()
        }
        self.parse_registry!
    }
}
