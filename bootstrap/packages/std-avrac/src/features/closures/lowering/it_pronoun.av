// The `it` PRONOUN desugar (t-y2i7.1): `list.map(it * 2)` becomes
// `list.map((it) -> it * 2)`. The grammar executor reaches it while building
// a call's arguments (executor.av) — it is parse-time lowering, not a hand
// parser, so it lives here rather than in a parser.av. parse/mod.av's postfix
// arg path used to reach it too; that path (`parse_arg_list_ids_inner`) was
// deleted with the rest of the hand postfix chain in this same slice.
//
// Imports ONLY core: every lowering module in the tree imports exactly
// `core` + `features.grammar` and nothing else, because the GENERATED
// parser imports these modules directly and its closure must not widen
// (F4012). That is why the two `list_any` folds below are written as
// plain loops — pulling in `list_ops` for a one-line helper would break
// the invariant for the whole package.
use core.{NodeStore, Expr, Stmt, StmtId, ParamEntry, ValueType, ExprId}

/// True when `expr` references the implicit `it` pronoun. Used
/// by `wrap_in_it_lambda` to recognise method-call sugar like
/// `xs.map(it * 2)` and rewrite it as `xs.map((it) -> it * 2)`.
export fn expr_contains_it(store: NodeStore, expr: Expr) -> bool {
    match expr {
        .Ident(n) -> n == "it"
        .Binary(l, _, r) -> expr_contains_it(store, store.exprs.get(l)) || expr_contains_it(store, store.exprs.get(r))
        .Unary(_, r) -> expr_contains_it(store, store.exprs.get(r))
        .Logical(l, _, r) -> expr_contains_it(store, store.exprs.get(l)) || expr_contains_it(store, store.exprs.get(r))
        .Call(callee, args) -> expr_contains_it(store, store.exprs.get(callee)) || expr_list_contains_it(store, args)
        .Grouping(inner) -> expr_contains_it(store, store.exprs.get(inner))
        .IfExpr(c, t, e) -> expr_contains_it(store, store.exprs.get(c)) || expr_contains_it(store, store.exprs.get(t)) || expr_contains_it(store, store.exprs.get(e))
        .Block(stmts) -> stmt_list_contains_it(store, stmts)
        .Index(obj, idx) -> expr_contains_it(store, store.exprs.get(obj)) || expr_contains_it(store, store.exprs.get(idx))
        .FieldAccess(obj, _) -> expr_contains_it(store, store.exprs.get(obj))
        .FieldAssign(obj, _, val) -> expr_contains_it(store, store.exprs.get(obj)) || expr_contains_it(store, store.exprs.get(val))
        .Assign(_, val) -> expr_contains_it(store, store.exprs.get(val))
        .NullCoalesce(l, r) -> expr_contains_it(store, store.exprs.get(l)) || expr_contains_it(store, store.exprs.get(r))
        .OptionalChain(obj, _) -> expr_contains_it(store, store.exprs.get(obj))
        .OptionalMethodCall(obj, _, args) -> expr_contains_it(store, store.exprs.get(obj)) || expr_list_contains_it(store, args)
        .Try(inner) -> expr_contains_it(store, store.exprs.get(inner))
        .Tuple(elems) -> expr_list_contains_it(store, elems)
        .TupleIndex(obj, _) -> expr_contains_it(store, store.exprs.get(obj))
        .With(obj, _) -> expr_contains_it(store, store.exprs.get(obj))
        .ListLit(elems) -> expr_list_contains_it(store, elems)
        .MapLit(entries) -> expr_list_contains_it(store, entries)
        .Slice(obj, s, e) -> expr_contains_it(store, store.exprs.get(obj)) || expr_contains_it(store, store.exprs.get(s)) || expr_contains_it(store, store.exprs.get(e))
        .MatchExpr(subj, _) -> expr_contains_it(store, store.exprs.get(subj))
        .Catch(inner, _, body, _, _) -> expr_contains_it(store, store.exprs.get(inner)) || expr_contains_it(store, store.exprs.get(body))
        _ -> false
    }
}

/// Map `expr_contains_it` over an expression-id list.
export fn expr_list_contains_it(store: NodeStore, ids: List<ExprId>) -> bool {
    for id in ids {
        if expr_contains_it(store, store.exprs.get(id)) { return true }
    }
    false
}

/// Map `expr_contains_it` over the expression payload of every
/// statement. Block bodies need this so an `it` reference deep
/// inside a `let`-init or `return` triggers the lambda wrap.
export fn stmt_list_contains_it(store: NodeStore, ids: List<StmtId>) -> bool {
    for id in ids {
        if stmt_contains_it(store, store.stmts.get(id)) { return true }
    }
    false
}

/// Per-statement `it`-presence check.
fn stmt_contains_it(store: NodeStore, s: Stmt) -> bool {
    match s {
        .Expr(e) -> expr_contains_it(store, store.exprs.get(e))
        .Let(_, _, init) -> expr_contains_it(store, store.exprs.get(init))
        .Mut(_, _, init) -> expr_contains_it(store, store.exprs.get(init))
        .Return(val) -> expr_contains_it(store, store.exprs.get(val))
        _ -> false
    }
}

/// Wrap a body that mentions `it` in an implicit
/// `(it) -> body` lambda. The parameter type is left as
/// `Unknown` so the regular type-inference path picks it up.
/// `body_id` is the already-ingested arena row of the body — the flipped
/// `Lambda.body: ExprId` holds it directly (a walker-opaque leaf).
export fn wrap_in_it_lambda(body_id: ExprId) -> Expr {
    // The `it` param is synthesized (never written) — no row backs its type.
    let ps: List<ParamEntry> = [ParamEntry { name: "it", vtype: ValueType.Unknown, ty_id: none }]
    Expr.Lambda(ps, body_id)
}

