// dir-as-module (g2eo.1): no `mod` decls — codegen.av + parser.av
// auto-load as siblings, surface flat at `features.closures.{...}`.
// `emit_lambda` and parser helpers are in scope without self-imports.
use core.{feature_new, Feature, ExprId}
use resolve.{declare_params, enter_resolve_scope, exit_resolve_scope, resolve_expr}
use typeck.{check_expr, tc_bind_params, tc_check_signature_arity_top, tc_enter, tc_er, tc_exit}

/// Register the `(x, y) -> body` lambda + closure feature.
/// Captures referenced bindings from the enclosing scope; spec
/// Axis 28.
export fn closures_feature() -> Feature {
    feature_new("lambda") with {
        expr_tag: Expr.Lambda([], ExprId(0)),
        emit_expr: emit_lambda,
        resolve_expr: closure_resolve,
        check_expr: closure_check,
    }
}

/// Resolver hook for `Lambda`. Opens a fresh scope, declares
/// every parameter, resolves the body inside that scope, then
/// exits — captures of outer names work because the outer
/// scope remains visible during body resolution.
fn closure_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .Lambda(params, body) -> {
            let entered = enter_resolve_scope(r)
            let with_params = declare_params(entered, params)
            let after_body = resolve_expr(with_params, with_params.nodes.exprs.get(body))
            exit_resolve_scope(after_body)
        }
        _ -> r
    }
}

/// Type-check hook for `Lambda`. Type-checks the body in a
/// fresh scope with each param bound to its declared type.
/// Result type is `Fn<Ret>` where `Ret` is the body's type.
fn closure_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Lambda(params, body) -> {
            let inner = tc_enter(tc)
            // F1004: a typed lambda parameter is a layout-determining position
            // like any fn param — a bare generic there is the same unguarded
            // hole. (No return annotation on a lambda, so gate params only.)
            let gated = tc_check_signature_arity_top(inner, params, ValueType.Void)
            let with_params = tc_bind_params(gated, params)
            let b = check_expr(with_params, with_params.nodes.exprs.get(body))
            let after = tc_exit(b.tc)
            tc_er(after, ValueType.Fn(b.ty))
        }
        _ -> tc_er(tc, .Unknown)
    }
}
