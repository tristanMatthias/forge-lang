// WHY: closure/lambda parser helpers.
// `expr_contains_it` supports the implicit `it` parameter sugar:
//   `list.map(it * 2)` → `list.map((it) -> { it * 2 })`
// `parse_lambda_body` handles lambda body parsing (block or single expression).

use core.{NodeStore, Expr, SExpr, SStmt, Stmt, ParamEntry, ValueType, ExprId}
use parse.{Parser}
use core.{Tk}
use list_ops.{list_any}

/// True when `expr` references the implicit `it` pronoun. Used
/// by `wrap_in_it_lambda` to recognise method-call sugar like
/// `xs.map(it * 2)` and rewrite it as `xs.map((it) -> it * 2)`.
export fn expr_contains_it(store: NodeStore, expr: Expr) -> bool {
    match expr {
        .Ident(n) -> n == "it"
        .Binary(l, _, r) -> expr_contains_it(store, l) || expr_contains_it(store, r)
        .Unary(_, r) -> expr_contains_it(store, r)
        .Logical(l, _, r) -> expr_contains_it(store, l) || expr_contains_it(store, r)
        .Call(callee, args) -> expr_contains_it(store, callee) || expr_list_contains_it(store, args)
        .Grouping(inner) -> expr_contains_it(store, inner)
        .IfExpr(c, t, e) -> expr_contains_it(store, c) || expr_contains_it(store, t) || expr_contains_it(store, e)
        .Block(stmts) -> stmt_list_contains_it(store, stmts)
        .Index(obj, idx) -> expr_contains_it(store, obj) || expr_contains_it(store, idx)
        .FieldAccess(obj, _) -> expr_contains_it(store, obj)
        .FieldAssign(obj, _, val) -> expr_contains_it(store, obj) || expr_contains_it(store, val)
        .Assign(_, val) -> expr_contains_it(store, val)
        .NullCoalesce(l, r) -> expr_contains_it(store, l) || expr_contains_it(store, r)
        .OptionalChain(obj, _) -> expr_contains_it(store, obj)
        .OptionalMethodCall(obj, _, args) -> expr_contains_it(store, obj) || expr_list_contains_it(store, args)
        .Try(inner) -> expr_contains_it(store, inner)
        .Tuple(elems) -> expr_list_contains_it(store, elems)
        .TupleIndex(obj, _) -> expr_contains_it(store, obj)
        .With(obj, _) -> expr_contains_it(store, obj)
        .ListLit(elems) -> expr_list_contains_it(store, elems)
        .MapLit(entries) -> expr_list_contains_it(store, entries)
        .Slice(obj, s, e) -> expr_contains_it(store, obj) || expr_contains_it(store, s) || expr_contains_it(store, e)
        .MatchExpr(subj, _) -> expr_contains_it(store, subj)
        .Catch(inner, _, body, _, _) -> expr_contains_it(store, inner) || expr_contains_it(store, body)
        _ -> false
    }
}

/// Map `expr_contains_it` over a `List<SExpr>`.
export fn expr_list_contains_it(store: NodeStore, list: List<SExpr>) -> bool {
    list_any(list, (se: SExpr) -> expr_contains_it(store, se.node))
}

/// Map `expr_contains_it` over the expression payload of every
/// statement. Block bodies need this so an `it` reference deep
/// inside a `let`-init or `return` triggers the lambda wrap.
export fn stmt_list_contains_it(store: NodeStore, list: List<SStmt>) -> bool {
    list_any(list, (ss: SStmt) -> stmt_contains_it(store, ss.node))
}

/// Per-statement `it`-presence check. Pulled out of the inline
/// match in `stmt_list_contains_it` so the predicate passed to
/// `list_any` stays a one-liner.
fn stmt_contains_it(store: NodeStore, s: Stmt) -> bool {
    match s {
        .Expr(e) -> expr_contains_it(store, store.exprs.get(e))
        .Let(_, _, init) -> expr_contains_it(store, store.exprs.get(init))
        .Mut(_, _, init) -> expr_contains_it(store, store.exprs.get(init))
        .Return(val) -> expr_contains_it(store, store.exprs.get(val))
        _ -> false
    }
}

/// Wrap a body that mentions `it` in an implicit
/// `(it) -> body` lambda. The parameter type is left as
/// `Unknown` so the regular type-inference path picks it up.
export fn wrap_in_it_lambda(expr: Expr) -> Expr {
    // The `it` param is synthesized (never written) — no row backs its type.
    let ps: List<ParamEntry> = [ParamEntry { name: "it", vtype: ValueType.Unknown, ty_id: none }]
    Expr.Lambda(ps, expr)
}

impl Parser {
    fn parse_lambda_body(self) -> Result<ExprId, string> {
        // Lambda body: either a block { ... } or a single expression.
        if self.check(Tk.LeftBrace) {
            return self.parse_block_expression()
        }
        self.parse_expression()
    }
}
