// WHY: codegen for lambda/closure expressions.
//
// A lambda `(x, y) -> expr` is compiled to:
// 1. A lifted top-level function `__lambda_N(x, y) -> i64`
// 2. A pointer to that function (returned as i64)
//
// Closures that capture variables from the enclosing scope pack
// the captures into a heap-allocated environment. The lifted
// function takes the environment as an extra first argument.
// The closure value is (fn_ptr, env_ptr) — a 2-element tuple.
//
// For non-capturing lambdas (the common case), the closure value
// is just the function pointer with a null environment.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldInitList, MatchArmList, WhenArmList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length, ValueType, TypeList, vtype_closure_captures, vtype_is_closure, vtype_fn_ret, vtype_eq, vtype_is_unknown}
use codegen.types.{Ctx, EmitValue, err_emit, null_ptr_val, ok_emit}
use codegen.{emit_expr}
use codegen.escape.{analyze_releasable_expr}

// ── Capture detection ──

/// List of captured variables for a lambda. Each entry tracks
/// the binding's name, original alloca, type, and mutability so
/// the lifted fn can reach back through the closure environment.
enum CaptureList {
    End,
    Node(name: string, alloca: ptr, ty: ValueType, is_mut: bool, next: CaptureList),
}

/// Length of a CaptureList.
fn capture_list_len(list: CaptureList) -> int {
    match list {
        .End -> 0
        .Node(_, _, _, _, next) -> 1 + capture_list_len(next)
    }
}

/// True when `name` is one of the lambda's declared parameters.
/// Used by capture detection to skip params (they're not
/// captures of the enclosing scope).
fn is_param(params: ParamList, name: string) -> bool {
    match params {
        .End -> false
        .Node(pname, _, _) if pname == name -> true
        .Node(_, _, next) -> is_param(next, name)
    }
}

/// Membership test for a CaptureList. Stops capture detection
/// from re-adding the same name twice.
fn is_captured(captures: CaptureList, name: string) -> bool {
    match captures {
        .End -> false
        .Node(cname, _, _, _, _) if cname == name -> true
        .Node(_, _, _, _, next) -> is_captured(next, name)
    }
}

/// True when `expr` contains an assignment that targets `target`.
/// Drives the mutability inference for captured bindings —
/// captures that get assigned must be tracked as mutable so the
/// closure write-back path runs.
fn expr_assigns(expr: Expr, target: string) -> bool {
    match expr {
        .Assign(name, val) -> name == target || expr_assigns(val, target)
        .Binary(l, _, r) -> expr_assigns(l, target) || expr_assigns(r, target)
        .Unary(_, r) -> expr_assigns(r, target)
        .Logical(l, _, r) -> expr_assigns(l, target) || expr_assigns(r, target)
        .Grouping(inner) -> expr_assigns(inner, target)
        .Call(callee, args) -> expr_assigns(callee, target) || expr_list_assigns(args, target)
        .Block(body) -> stmt_list_assigns(body, target)
        .IfExpr(c, t, e) -> expr_assigns(c, target) || expr_assigns(t, target) || expr_assigns(e, target)
        .Lambda(_, body) -> expr_assigns(body, target)
        _ -> false
    }
}

/// True when any element of an ExprList assigns to `target`.
fn expr_list_assigns(list: ExprList, target: string) -> bool {
    match list {
        .End -> false
        .Node(se, next) -> expr_assigns(se.node, target) || expr_list_assigns(next, target)
    }
}

/// True when any statement in `stmts` assigns to `target`.
fn stmt_list_assigns(stmts: StmtList, target: string) -> bool {
    match stmts {
        .End -> false
        .Node(ss, next) -> stmt_assigns(ss.node, target) || stmt_list_assigns(next, target)
    }
}

/// Per-statement assignment detector. Recognises `Assign`,
/// `FieldAssign`, and recurses into containing expressions /
/// nested bodies so deep mutations don't slip through.
fn stmt_assigns(stmt: Stmt, target: string) -> bool {
    match stmt {
        .Expr(e) -> expr_assigns(e, target)
        .Return(e) -> expr_assigns(e, target)
        .Block(body) -> stmt_list_assigns(body, target)
        .If(c, t, e) -> expr_assigns(c, target) || stmt_assigns(t, target) || (if e != null { stmt_assigns(e!, target) } else { false })
        .While(c, body) -> expr_assigns(c, target) || stmt_assigns(body, target)
        .For(_, s, e, body) -> expr_assigns(s, target) || expr_assigns(e, target) || stmt_assigns(body, target)
        .ForIn(_, coll, body) -> expr_assigns(coll, target) || stmt_assigns(body, target)
        _ -> false
    }
}

// Mark captures as mutable if the lambda body assigns to them.
/// Walk a CaptureList re-flagging any entry that gets assigned
/// inside the lambda body. Mutable captures need a write-back
/// path so the enclosing scope sees their updated values.
fn mark_mutable_captures(captures: CaptureList, body: Expr) -> CaptureList {
    match captures {
        .End -> .End
        .Node(name, alloca, ty, _, next) -> {
            let is_mut = expr_assigns(body, name)
            CaptureList.Node(name, alloca, ty, is_mut, mark_mutable_captures(next, body))
        }
    }
}

/// Walk an expression collecting captured names. A name is a
/// capture when it's referenced in the body, isn't one of the
/// declared params, isn't already in the capture list, and
/// resolves to an entry in the enclosing env. Recurses into
/// every compound expression form so nested calls and blocks
/// work.
fn find_captures(expr: Expr, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match expr {
        .Ident(name) -> {
            if is_param(params, name) { return captures }
            if is_captured(captures, name) { return captures }
            let lookup = env_lookup(env, name)
            if !lookup.found { return captures }
            CaptureList.Node(name, lookup.alloca, lookup.ty, false, captures)
        }
        .Binary(left, _, right) -> {
            let c1 = find_captures(left, params, env, captures)
            find_captures(right, params, env, c1)
        }
        .Unary(_, right) -> find_captures(right, params, env, captures)
        .Logical(left, _, right) -> {
            let c1 = find_captures(left, params, env, captures)
            find_captures(right, params, env, c1)
        }
        .Call(callee, args) -> {
            let c1 = find_captures(callee, params, env, captures)
            find_captures_list(args, params, env, c1)
        }
        .Grouping(inner) -> find_captures(inner, params, env, captures)
        .IfExpr(c, t, e) -> {
            let c1 = find_captures(c, params, env, captures)
            let c2 = find_captures(t, params, env, c1)
            find_captures(e, params, env, c2)
        }
        .Block(stmts) -> find_captures_stmts(stmts, params, env, captures)
        .Assign(_, value) -> find_captures(value, params, env, captures)
        .Index(obj, idx) -> {
            let c1 = find_captures(obj, params, env, captures)
            find_captures(idx, params, env, c1)
        }
        .MatchExpr(subj, arms) -> {
            let c1 = find_captures(subj, params, env, captures)
            find_captures_arms(arms, params, env, c1)
        }
        .EnumCtor(_, _, args) -> find_captures_list(args, params, env, captures)
        .StructLit(_, inits) -> find_captures_field_inits(inits, params, env, captures)
        .FieldAccess(obj, _) -> find_captures(obj, params, env, captures)
        .FieldAssign(obj, _, val) -> {
            let c1 = find_captures(obj, params, env, captures)
            find_captures(val, params, env, c1)
        }
        .NullCoalesce(l, r) -> {
            let c1 = find_captures(l, params, env, captures)
            find_captures(r, params, env, c1)
        }
        .Try(inner) -> find_captures(inner, params, env, captures)
        .ListLit(elems) -> find_captures_list(elems, params, env, captures)
        .Tuple(elems) -> find_captures_list(elems, params, env, captures)
        .MapLit(entries) -> find_captures_list(entries, params, env, captures)
        .With(obj, _) -> find_captures(obj, params, env, captures)
        .Slice(obj, s, e) -> {
            let c1 = find_captures(obj, params, env, captures)
            let c2 = find_captures(s, params, env, c1)
            find_captures(e, params, env, c2)
        }
        .IsCheck(subj, _) -> find_captures(subj, params, env, captures)
        .InCheck(needle, items) -> {
            let c1 = find_captures(needle, params, env, captures)
            find_captures_list(items, params, env, c1)
        }
        .OptionalChain(obj, _) -> find_captures(obj, params, env, captures)
        .TupleIndex(obj, _) -> find_captures(obj, params, env, captures)
        .ListComp(body, _, coll, filter) -> {
            let c1 = find_captures(body, params, env, captures)
            let c2 = find_captures(coll, params, env, c1)
            if filter != null { find_captures(filter!, params, env, c2) } else { c2 }
        }
        .Catch(inner, _, body, _, _) -> {
            let c1 = find_captures(inner, params, env, captures)
            find_captures(body, params, env, c1)
        }
        .When(arms) -> find_captures_when_arms(arms, params, env, captures)
        .GenericCall(callee, _, args) -> {
            let c1 = find_captures(callee, params, env, captures)
            find_captures_list(args, params, env, c1)
        }
        _ -> captures  // Number, String, Bool, FloatLit, Null, QualifiedIdent — leaf nodes
    }
}

/// Recurse `find_captures` through every match-arm body.
fn find_captures_arms(arms: MatchArmList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match arms {
        .End -> captures
        .Node(_, guard, body, next) -> {
            let c1 = if guard != null { find_captures(guard!.node, params, env, captures) } else { captures }
            let c2 = find_captures(body.node, params, env, c1)
            find_captures_arms(next, params, env, c2)
        }
    }
}

/// Recurse `find_captures` through every value in a struct
/// literal / `with` override list.
fn find_captures_field_inits(inits: FieldInitList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match inits {
        .End -> captures
        .Node(_, val, next) -> {
            let c1 = find_captures(val.node, params, env, captures)
            find_captures_field_inits(next, params, env, c1)
        }
    }
}

/// Recurse `find_captures` through every condition + body in a
/// `when` arm list.
fn find_captures_when_arms(arms: WhenArmList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match arms {
        .End -> captures
        .Node(cond, body, next) -> {
            let c1 = if cond != null { find_captures(cond!.node, params, env, captures) } else { captures }
            let c2 = find_captures(body.node, params, env, c1)
            find_captures_when_arms(next, params, env, c2)
        }
    }
}

/// Recurse `find_captures` across an ExprList — call args,
/// list literals, etc.
fn find_captures_list(exprs: ExprList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match exprs {
        .End -> captures
        .Node(se, next) -> {
            let c1 = find_captures(se.node, params, env, captures)
            find_captures_list(next, params, env, c1)
        }
    }
}

/// Per-statement capture finder. Recurses into expression
/// payloads + nested bodies. Decl-only statements pass through.
fn find_captures_stmt_body(stmt: Stmt, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match stmt {
        .Block(stmts) -> find_captures_stmts(stmts, params, env, captures)
        .Expr(e) -> find_captures(e, params, env, captures)
        .Return(e) -> find_captures(e, params, env, captures)
        .Let(_, _, init) -> find_captures(init, params, env, captures)
        .Mut(_, _, init) -> find_captures(init, params, env, captures)
        .If(cond, then_b, else_b) -> {
            let c1 = find_captures(cond, params, env, captures)
            let c2 = find_captures_stmt_body(then_b, params, env, c1)
            if else_b != null { find_captures_stmt_body(else_b!, params, env, c2) } else { c2 }
        }
        .While(cond, body) -> {
            let c1 = find_captures(cond, params, env, captures)
            find_captures_stmt_body(body, params, env, c1)
        }
        .For(_, start, end, body) -> {
            let c1 = find_captures(start, params, env, captures)
            let c2 = find_captures(end, params, env, c1)
            find_captures_stmt_body(body, params, env, c2)
        }
        .ForIn(_, coll, body) -> {
            let c1 = find_captures(coll, params, env, captures)
            find_captures_stmt_body(body, params, env, c1)
        }
        .Match(subj, arms) -> {
            let c1 = find_captures(subj, params, env, captures)
            find_captures_arms(arms, params, env, c1)
        }
        .Defer(body) -> find_captures(body, params, env, captures)
        .Errdefer(body) -> find_captures(body, params, env, captures)
        .Const(_, _, init) -> find_captures(init, params, env, captures)
        .LetDestructure(_, init) -> find_captures(init, params, env, captures)
        .Annotated(_, inner) -> find_captures_stmt_body(inner, params, env, captures)
        .Parallel(body) -> find_captures_stmts(body, params, env, captures)
        _ -> captures  // NoOp, Break, Continue, ExternFn, TypeDecl, EnumDecl, etc.
    }
}

/// Walk a StmtList collecting captures via
/// `find_captures_stmt_body`.
fn find_captures_stmts(stmts: StmtList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match stmts {
        .End -> captures
        .Node(ss, next) -> {
            // Process this statement for captures using the shared handler.
            let c1 = find_captures_stmt_body(ss.node, params, env, captures)
            // If this statement binds a local name, add it to params so subsequent
            // uses of the name won't be treated as captures from the outer scope.
            let updated_params = match ss.node {
                .Let(name, _, _) -> ParamList.Node(name, ValueType.Unknown, params)
                .Mut(name, _, _) -> ParamList.Node(name, ValueType.Unknown, params)
                .Const(name, _, _) -> ParamList.Node(name, ValueType.Unknown, params)
                .For(vname, _, _, _) -> ParamList.Node(vname, ValueType.Unknown, params)
                .ForIn(vname, _, _) -> ParamList.Node(vname, ValueType.Unknown, params)
                _ -> params
            }
            find_captures_stmts(next, updated_params, env, c1)
        }
    }
}

// ── Parameter type inference ──
//
// When a lambda has no explicit parameter types (the common case), we
// infer types from the body. If a parameter appears in a binary
// expression with a Float-typed variable (from captures or the enclosing
// env), we infer the parameter as Float. This prevents the lambda from
// treating float bits (passed as i64) as integer values and applying
// sitofp instead of bitcast.

/// Look up the declared type of a name in the enclosing env.
/// Falls through to top-level globals when the local lookup
/// misses. Returns `Unknown` if the name doesn't exist.
fn env_type_of(ctx: Ctx, env: VarEnv, name: string) -> ValueType {
    let lookup = env_lookup(env, name)
    if lookup.found { return lookup.ty }
    let g = ctx.lookup_toplevel(name)
    if g.found { return g.ty }
    ValueType.Unknown
}

/// Look up a capture's declared type by name. Returns `Unknown`
/// when not in the list — callers then fall back to env lookup.
fn capture_type_of(captures: CaptureList, name: string) -> ValueType {
    match captures {
        .End -> ValueType.Unknown
        .Node(cname, _, ty, _, _) if cname == name -> ty
        .Node(_, _, _, _, next) -> capture_type_of(next, name)
    }
}

// Check if an expression contains a Float-typed identifier (from captures, env, or globals).
/// True when `expr` references at least one float-typed name —
/// used by `infer_param_types` to widen otherwise-untyped lambda
/// params to Float when they participate in float arithmetic.
fn has_float_ident(expr: Expr, ctx: Ctx, env: VarEnv, captures: CaptureList, params: ParamList) -> bool {
    match expr {
        .Ident(name) -> {
            if is_param(params, name) { return false }
            let ty = capture_type_of(captures, name)
            if vtype_eq(ty, .Float) { return true }
            let ety = env_type_of(ctx, env, name)
            vtype_eq(ety, .Float)
        }
        .FloatLit(_) -> true
        .Binary(left, _, right) -> {
            has_float_ident(left, ctx, env, captures, params) || has_float_ident(right, ctx, env, captures, params)
        }
        .Unary(_, inner) -> has_float_ident(inner, ctx, env, captures, params)
        .Grouping(inner) -> has_float_ident(inner, ctx, env, captures, params)
        .Call(callee, args) -> has_float_ident(callee, ctx, env, captures, params) || has_float_ident_list(args, ctx, env, captures, params)
        .GenericCall(callee, _, args) -> has_float_ident(callee, ctx, env, captures, params) || has_float_ident_list(args, ctx, env, captures, params)
        .FieldAccess(obj, _) -> has_float_ident(obj, ctx, env, captures, params)
        .Index(obj, idx) -> has_float_ident(obj, ctx, env, captures, params) || has_float_ident(idx, ctx, env, captures, params)
        .IfExpr(c, t, e) -> has_float_ident(c, ctx, env, captures, params) || has_float_ident(t, ctx, env, captures, params) || has_float_ident(e, ctx, env, captures, params)
        .NullCoalesce(left, right) -> has_float_ident(left, ctx, env, captures, params) || has_float_ident(right, ctx, env, captures, params)
        .Try(inner) -> has_float_ident(inner, ctx, env, captures, params)
        .With(base, _) -> has_float_ident(base, ctx, env, captures, params)
        .TupleIndex(obj, _) -> has_float_ident(obj, ctx, env, captures, params)
        _ -> false
    }
}

/// Map `has_float_ident` over an ExprList.
fn has_float_ident_list(exprs: ExprList, ctx: Ctx, env: VarEnv, captures: CaptureList, params: ParamList) -> bool {
    match exprs {
        .End -> false
        .Node(se, next) -> has_float_ident(se.node, ctx, env, captures, params) || has_float_ident_list(next, ctx, env, captures, params)
    }
}

// Check if a parameter is used in a binary expression with a Float value.
/// True when `param_name` appears alongside a float operand in
/// an arithmetic expression. Drives the heuristic that promotes
/// otherwise-untyped lambda params to Float so `(x) -> x + 1.5`
/// works without explicit type annotations.
fn param_used_with_float(param_name: string, expr: Expr, ctx: Ctx, env: VarEnv, captures: CaptureList, params: ParamList) -> bool {
    match expr {
        .Binary(left, _, right) -> {
            let left_is_param = match left { .Ident(n) -> n == param_name, _ -> false }
            let right_is_param = match right { .Ident(n) -> n == param_name, _ -> false }
            if left_is_param && has_float_ident(right, ctx, env, captures, params) { return true }
            if right_is_param && has_float_ident(left, ctx, env, captures, params) { return true }
            param_used_with_float(param_name, left, ctx, env, captures, params) || param_used_with_float(param_name, right, ctx, env, captures, params)
        }
        .Unary(_, inner) -> param_used_with_float(param_name, inner, ctx, env, captures, params)
        .Grouping(inner) -> param_used_with_float(param_name, inner, ctx, env, captures, params)
        .Call(callee, args) -> {
            param_used_with_float(param_name, callee, ctx, env, captures, params) || param_used_with_float_list(param_name, args, ctx, env, captures, params)
        }
        .Block(stmts) -> param_used_with_float_stmts(param_name, stmts, ctx, env, captures, params)
        .IfExpr(c, t, e) -> {
            param_used_with_float(param_name, c, ctx, env, captures, params) || param_used_with_float(param_name, t, ctx, env, captures, params) || param_used_with_float(param_name, e, ctx, env, captures, params)
        }
        _ -> false
    }
}

/// Map `param_used_with_float` over an ExprList.
fn param_used_with_float_list(param_name: string, exprs: ExprList, ctx: Ctx, env: VarEnv, captures: CaptureList, params: ParamList) -> bool {
    match exprs {
        .End -> false
        .Node(se, next) -> {
            param_used_with_float(param_name, se.node, ctx, env, captures, params) || param_used_with_float_list(param_name, next, ctx, env, captures, params)
        }
    }
}

/// Map `param_used_with_float` through a statement list,
/// recursing into expression payloads + nested bodies.
fn param_used_with_float_stmts(param_name: string, stmts: StmtList, ctx: Ctx, env: VarEnv, captures: CaptureList, params: ParamList) -> bool {
    match stmts {
        .End -> false
        .Node(ss, next) -> {
            let found = match ss.node {
                .Expr(e) -> param_used_with_float(param_name, e, ctx, env, captures, params)
                .Return(e) -> param_used_with_float(param_name, e, ctx, env, captures, params)
                .Let(_, _, init) -> param_used_with_float(param_name, init, ctx, env, captures, params)
                .Mut(_, _, init) -> param_used_with_float(param_name, init, ctx, env, captures, params)
                _ -> false
            }
            if found { return true }
            param_used_with_float_stmts(param_name, next, ctx, env, captures, params)
        }
    }
}

/// Infer types for unannotated lambda params by scanning the
/// body. Defaults to Int; promotes to Float when the param is
/// used alongside another float operand. Result is a TypeList
/// matched 1:1 to the input param list.
fn infer_param_types(params: ParamList, body: Expr, ctx: Ctx, env: VarEnv, captures: CaptureList) -> TypeList {
    match params {
        .End -> TypeList.End
        .Node(name, raw_vt, next) -> {
            // Priority: explicit annotation > float inference > default Unknown
            let ty = if !vtype_is_unknown(raw_vt) && !(raw_vt is .Int) {
                ctx.resolve_codegen_vtype(raw_vt)
            } else if param_used_with_float(name, body, ctx, env, captures, params) {
                ValueType.Float
            } else {
                ValueType.Unknown
            }
            TypeList.Node(ty, infer_param_types(next, body, ctx, env, captures))
        }
    }
}

// Global lambda counter for unique names.
// This is the ONE allowed mutable global — it's a monotonic counter
// Unique lambda ID generation — uses a C-side counter to avoid mutable globals.
extern fn avra_next_lambda_id() -> int

// Compile a lambda with default parameter types (all Int).
/// Public entry for lambda codegen. Forwards to
/// `emit_lambda_typed` after letting the heuristic
/// `infer_param_types` pick a default per param.
export fn emit_lambda(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Lambda(params, body) -> emit_lambda_typed(ctx, env, params, body, TypeList.End)
        _ -> err_emit("expected Lambda")
    }
}

// Compile a lambda with explicit parameter types.
// Used by .map/.filter/.reduce to pass the list's element type
// so that int(x) / x.length / etc. work correctly inside the lambda.
/// Lambda codegen with explicit param types. Builds a lifted
/// top-level `__lambda_N` function with a hidden env-pointer
/// param prepended; emits the body inside; allocates a closure
/// array `[TAG, fn_ptr, capture0, capture1, ...]` and returns
/// it as the call's value. Non-capturing lambdas get a single-
/// slot closure with the function pointer only.
export fn emit_lambda_typed(ctx: Ctx, env: VarEnv, raw_params: ParamList, body: Expr, param_types: TypeList) -> Result<EmitValue, string> {
    let id = avra_next_lambda_id()
    let name = "__lambda_${string(id)}"
    let params = ctx.resolve_params(raw_params)

    // Detect captured variables from the enclosing scope.
    // Mark captures as mutable if the lambda body assigns to them.
    let raw_captures = find_captures(body, params, env, CaptureList.End)
    let captures = mark_mutable_captures(raw_captures, body)
    let num_captures = capture_list_len(captures)
    let num_declared = param_list_length(params)
    let arity = num_declared + num_captures

    // Compute effective parameter types BEFORE creating the LLVM function,
    // so we can build a properly-typed LLVM function signature.
    let effective_types = match param_types {
        .End -> infer_param_types(params, body, ctx, env, captures)
        _ -> param_types
    }

    // Build typed LLVM function: declared params use effective_types, captures use i64.
    let param_arr = avra_llvm_type_array_new(arity)
    ctx.fill_typed_lambda_params(param_arr, effective_types, 0, arity)
    let fn_type = ctx.fn_type(ctx.i64_type, param_arr, arity)
    ctx.type_array_free(param_arr)
    let fn_val = ctx.add_function(name, fn_type)

    let saved_bb = ctx.current_bb()

    let entry = ctx.bb_in(fn_val, "entry")
    ctx.position(entry)
    let env_with_params = bind_lambda_params_typed(ctx, env, params, fn_val, 0, effective_types)
    let body_env = bind_captures_as_params(ctx, env_with_params, captures, fn_val, num_declared)

    mut body_ctx = ctx.with_fn(fn_val, name)
    body_ctx.cov_fn_entry()
    // with_fn resets defers/rc_cleanup/rc_releasable to .End, so lambda body starts fresh.
    body_ctx.rc_releasable = analyze_releasable_expr(body)
    mut result = EmitValue { value: ctx.i64(0), ty: .Int }
    match emit_expr(body_ctx, body_env, body) {
        .Ok(v) -> { result = v }
        .Err(e) -> {
            ctx.position(saved_bb)
            return err_emit(e)
        }
    }

    if !ctx.has_terminator() {
        let lambda_ret = body_ctx.current_fn_ret()
        ctx.ret(result.value, lambda_ret)
    }
    body_ctx.cov_finalize_fn()

    ctx.position(saved_bb)

    // If there are captures, we need to pass the captured values at call time.
    // Pack: [fn_ptr, cap1, cap2, ...] into an array. The C runtime's
    // ALL lambdas use closure arrays: [TAG, fn_ptr, cap1, cap2, ...]
    // Even non-capturing ones get [TAG, fn_ptr] so the C-side
    // avra_closure_call_* trampolines can safely inspect them.
    // Only named function references (let f = my_fn) are bare pointers.
    let fn_ptr_i64 = ctx.ptr_to_int(fn_val, "lambda_ptr")
    let closure_arr = ctx.closure_array(fn_ptr_i64)
    if num_captures > 0 {
        push_captured_values(ctx, captures, closure_arr)
    }
    let closure_i64 = ctx.to_i64(closure_arr, "closure_i64")
    ok_emit(closure_i64, ValueType.Closure(num_captures, result.ty))
}

/// Bind every captured value as an extra parameter in the
/// lifted lambda's body env. Captures appear after the user-
/// declared params in the LLVM signature, so the body can read
/// them transparently via env lookup.
fn bind_captures_as_params(ctx: Ctx, env: VarEnv, captures: CaptureList, fn_val: ptr, idx: int) -> VarEnv {
    match captures {
        .End -> env
        .Node(name, _, ty, is_mut_cap, next) -> {
            let param_val = ctx.get_param(fn_val, idx)
            let new_env = if is_mut_cap {
                // Mutable capture: param is an alloca POINTER — use directly
                let alloca = ctx.int_to_ptr(param_val, "cap_alloca")
                env_extend(env, name, alloca, ty)
            } else {
                // Immutable capture: param is a value — create local alloca
                ctx.bind(env, name, param_val, ty)
            }
            bind_captures_as_params(ctx, new_env, next, fn_val, idx + 1)
        }
    }
}

/// Walk the capture list pushing each captured value onto the
/// closure's array (slots 2+ after the marker + fn pointer).
/// Loads from each capture's alloca so the snapshot reflects
/// the current value at closure-creation time.
fn push_captured_values(ctx: Ctx, captures: CaptureList, arr: ptr) {
    match captures {
        .End -> {}
        .Node(_, alloca, _, is_mut, next) -> {
            if is_mut {
                // Mutable capture: pass alloca POINTER so writes propagate
                let ptr_val = ctx.to_i64(alloca, "cap_ptr")
                ctx.array_push(arr, ptr_val)
            } else {
                // Immutable capture: pass current VALUE (copy)
                let val = ctx.load_i64(alloca, "cap_val")
                ctx.array_push(arr, val)
            }
            push_captured_values(ctx, next, arr)
        }
    }
}

// Emit a lambda argument with typed parameters. If the argument
// expression is a Lambda, compile it with explicit param types so
// that type-dependent operations (int(x), x.length, x.upper())
// work correctly inside the lambda body.
/// Emit the first arg from `args`, but if it's a Lambda,
/// compile it against the supplied `param_types` instead of
/// using the heuristic. Used by higher-order list methods
/// (`map`, `filter`, …) that know their callback's expected
/// param types.
export fn emit_typed_lambda_arg(ctx: Ctx, env: VarEnv, args: ExprList, param_types: TypeList) -> Result<EmitValue, string> {
    match args {
        .End -> err_emit("expected 1 argument, got 0")
        .Node(se, _) -> {
            match se.node {
                .Lambda(params, body) -> emit_lambda_typed(ctx, env, params, body, param_types)
                _ -> ctx.emit(env, se.node)
            }
        }
    }
}

// Call a function pointer stored in a local variable.
// Load the pointer, cast to fn ptr, build indirect call.
/// Codegen for calling a fn-typed local variable. Loads the
/// closure pointer from the alloca and dispatches via
/// `emit_closure_call` (which handles env-pointer prepend +
/// arity coercion).
export fn emit_indirect_call(ctx: Ctx, env: VarEnv, alloca: ptr, name: string, args: ExprList) -> Result<EmitValue, string> {
    let fn_i64 = ctx.load_i64(alloca, name)
    let local = env_lookup(env, name)
    let ret_ty = vtype_fn_ret(local.ty)
    // Closure values (lambda expressions) are arrays that need unpacking.
    // Fn values (named function refs) are bare pointers that can be called directly.
    if vtype_is_closure(local.ty) {
        let num_caps = vtype_closure_captures(local.ty)
        // num_caps < 0 means "closure with unknown capture count" —
        // use the trampoline which resolves captures at runtime.
        if num_caps >= 0 {
            return emit_closure_call_typed(ctx, env, fn_i64, args, num_caps, ret_ty)
        }
    }
    emit_indirect_call_typed(ctx, env, fn_i64, args, ret_ty)
}

/// Same as `emit_indirect_call` but loads the closure pointer
/// from a top-level global instead of a local alloca. Used when
/// a fn is exported as a `mut` global.
export fn emit_indirect_call_from_global(ctx: Ctx, env: VarEnv, global: ptr, name: string, args: ExprList, ty: ValueType) -> Result<EmitValue, string> {
    let fn_i64 = ctx.load_i64(global, name)
    let ret_ty = vtype_fn_ret(ty)
    if vtype_is_closure(ty) {
        let num_caps = vtype_closure_captures(ty)
        if num_caps >= 0 {
            return emit_closure_call_typed(ctx, env, fn_i64, args, num_caps, ret_ty)
        }
    }
    emit_indirect_call_typed(ctx, env, fn_i64, args, ret_ty)
}

// AvraArray:
// [0] = fn_ptr, [1..N] = captured values.
// We unpack fn_ptr, evaluate user args, append captures, and call.
/// Core indirect-call logic for closures. Reads the function
/// pointer from slot 1 of the closure array, builds the arg
/// array (prepending captured values when `num_captures > 0`),
/// and calls via `avra_closure_call_N` for the right arity.
fn emit_closure_call(ctx: Ctx, env: VarEnv, closure_val: ptr, args: ExprList, num_captures: int) -> Result<EmitValue, string> {
    // Closure array layout: [TAG, fn_ptr, cap1, cap2, ...]
    // TAG is at index 0, fn_ptr at index 1, captures start at index 2.
    let closure_ptr = ctx.to_ptr(closure_val, "closure_ptr")
    // Load fn_ptr from closure array[1] (index 0 is the TAG)
    let get_fn_call = ctx.array_get(closure_ptr, ctx.i64(1))
    let fn_ptr = ctx.int_to_ptr(get_fn_call, "fn_ptr")

    let user_arg_count = expr_list_length(args)
    let total_args = user_arg_count + num_captures

    // Fill the value array first so we can read each emitted value's
    // actual LLVM type. The lambda was declared with typed declared
    // params + i64 captures (see fill_typed_lambda_params); the call
    // site fn_type must mirror that signature or LLVM's verifier
    // flags every closure invocation as a parameter-type mismatch.
    // Tracking ticket: forge-crafting-intepreters-og68.
    let val_arr = ctx.value_array(total_args)
    match fill_lambda_args(ctx, env, val_arr, args, 0) {
        .Ok(_) -> {}
        .Err(e) -> {
            ctx.value_array_free(val_arr)
            return err_emit(e)
        }
    }
    // Fill captures from closure array (start at index 2)
    fill_closure_captures(ctx, val_arr, closure_ptr, user_arg_count, num_captures, 0)

    // Build the param-type array: declared params take whatever LLVM
    // type their emitted value carries (ptr for Expr/string/struct,
    // i64 for int/bool, double for float); captures are always i64
    // because that's what closure_array stores them as.
    let param_arr = ctx.value_array_param_types(val_arr, user_arg_count, num_captures)
    let fn_type = ctx.fn_type(ctx.i64_type, param_arr, total_args)
    ctx.type_array_free(param_arr)

    let result = ctx.build_call(fn_type, fn_ptr, val_arr, total_args, "closure_call")
    ctx.value_array_free(val_arr)
    ok_emit(result, .Int)
}

/// Copy `count` capture slots out of the closure array into
/// the call's value array starting at `start_idx`. Used by
/// `emit_closure_call` to materialise the env-pointer prepend.
fn fill_closure_captures(ctx: Ctx, val_arr: ptr, closure_val: ptr, start_idx: int, count: int, i: int) {
    if i >= count { return }
    // Captures start at array index 2 (after TAG and fn_ptr)
    let cap_val = ctx.array_get(closure_val, ctx.i64(i + 2))
    ctx.value_array_set(val_arr, start_idx + i, cap_val)
    fill_closure_captures(ctx, val_arr, closure_val, start_idx, count, i + 1)
}

/// Indirect call where the caller already has the closure as an
/// SSA i64 and knows the expected return type. Skips the
/// alloca-load step and dispatches straight through.
export fn emit_indirect_call_typed(ctx: Ctx, env: VarEnv, fn_i64: ptr, args: ExprList, ret_ty: ValueType) -> Result<EmitValue, string> {
    let r = emit_indirect_call_value(ctx, env, fn_i64, args)?
    ok_emit(r.value, ret_ty)
}

/// Variant of `emit_closure_call` for callers that already have
/// the SSA i64 and know both the capture count and return type.
/// Saves a load and types the result for the caller.
export fn emit_closure_call_typed(ctx: Ctx, env: VarEnv, fn_i64: ptr, args: ExprList, num_captures: int, ret_ty: ValueType) -> Result<EmitValue, string> {
    let r = emit_closure_call(ctx, env, fn_i64, args, num_captures)?
    ok_emit(r.value, ret_ty)
}

/// Indirect call against an i64-shaped closure value when the
/// caller doesn't yet know the expected return type. Used in
/// generic call paths where typing is deferred.
export fn emit_indirect_call_value(ctx: Ctx, env: VarEnv, fn_i64: ptr, args: ExprList) -> Result<EmitValue, string> {
    // Indirect call for values with unknown closure status at compile time.
    // This happens when a fn returns a closure but the return type says
    // Fn/FnTyped (the type system can't distinguish bare ptrs from
    // closure arrays through function boundaries).
    //
    // Uses avra_closure_call_N trampolines which handle both bare
    // function pointers and closure arrays at runtime via
    // avra_closure_dispatch in runtime.c. Supports up to 8 total
    // args (user + captures).
    let user_arg_count = expr_list_length(args)
    if user_arg_count == 0 {
        return ok_emit(ctx.call("avra_closure_call_0", [fn_i64]), .Int)
    }
    if user_arg_count == 1 {
        match args {
            .Node(se, _) -> {
                let a0 = ctx.emit(env, se.node)?
                return ok_emit(ctx.call("avra_closure_call_1", [fn_i64, a0.value]), .Int)
            }
            _ -> { return err_emit("expected 1 arg") }
        }
    }
    if user_arg_count == 2 {
        match args {
            .Node(se0, rest) -> {
                let a0 = ctx.emit(env, se0.node)?
                match rest {
                    .Node(se1, _) -> {
                        let a1 = ctx.emit(env, se1.node)?
                        return ok_emit(ctx.call("avra_closure_call_2", [fn_i64, a0.value, a1.value]), .Int)
                    }
                    _ -> { return err_emit("expected 2 args") }
                }
            }
            _ -> { return err_emit("expected 2 args") }
        }
    }
    if user_arg_count == 3 {
        match args {
            .Node(se0, rest0) -> {
                let a0 = ctx.emit(env, se0.node)?
                match rest0 {
                    .Node(se1, rest1) -> {
                        let a1 = ctx.emit(env, se1.node)?
                        match rest1 {
                            .Node(se2, _) -> {
                                let a2 = ctx.emit(env, se2.node)?
                                return ok_emit(ctx.call("avra_closure_call_3", [fn_i64, a0.value, a1.value, a2.value]), .Int)
                            }
                            _ -> { return err_emit("expected 3 args") }
                        }
                    }
                    _ -> { return err_emit("expected 3 args") }
                }
            }
            _ -> { return err_emit("expected 3 args") }
        }
    }
    err_emit("indirect calls with ${string(user_arg_count)} args not yet supported")
}

/// Walk an ExprList emitting each arg into successive slots of
/// `arr`. Lambda call paths use this to pack user-supplied
/// arguments into the value array passed to
/// `avra_closure_call_N`.
fn fill_lambda_args(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> Result<EmitValue, string> {
    match args {
        .End -> ok_emit(null_ptr_val(), .Void)
        .Node(se, next) -> {
            let r = ctx.emit(env, se.node)?
            ctx.value_array_set(arr, idx, r.value)
            fill_lambda_args(ctx, env, arr, next, idx + 1)
        }
    }
}

/// Bind each lambda parameter as an alloca + env entry,
/// pulling its declared type from the supplied `types` list (or
/// falling back to the param's annotation when the type list is
/// short). Mirror of `bind_params_inline` for closure bodies.
fn bind_lambda_params_typed(ctx: Ctx, env: VarEnv, params: ParamList, fn_val: ptr, idx: int, types: TypeList) -> VarEnv {
    match params {
        .End -> env
        .Node(name, raw_vt, next) -> {
            let param_val = ctx.get_param(fn_val, idx)
            // Priority: external TypeList > param annotation > resolved
            let ty = match types {
                .Node(t, _) -> t
                .End -> {
                    if !vtype_is_unknown(raw_vt) && !(raw_vt is .Int) {
                        ctx.resolve_codegen_vtype(raw_vt)
                    } else {
                        ValueType.Unknown
                    }
                }
            }
            let rest_types = match types {
                .Node(_, rest) -> rest
                .End -> TypeList.End
            }
            bind_lambda_params_typed(ctx, ctx.bind(env, name, param_val, ty), next, fn_val, idx + 1, rest_types)
        }
    }
}
