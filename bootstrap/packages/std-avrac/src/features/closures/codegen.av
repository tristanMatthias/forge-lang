// WHY: codegen for lambda/closure expressions.
//
// A lambda `(x, y) -> expr` is compiled to:
// 1. A lifted top-level function `__lambda_N(x, y) -> i64`
// 2. A pointer to that function (returned as i64)
//
// Closures that capture variables from the enclosing scope pack
// the captures into a heap-allocated environment. The lifted
// function takes the environment as an extra first argument.
// The closure value is (fn_ptr, env_ptr) — a 2-element tuple.
//
// For non-capturing lambdas (the common case), the closure value
// is just the function pointer with a null environment.

use core.{Expr, Stmt, StmtId, NodeStore, ParamEntry, FieldInit, MatchArm, WhenArm, VarBinding, env_lookup, env_extend, ValueType, vtype_closure_captures, vtype_is_closure, vtype_fn_ret, vtype_eq, vtype_is_unknown, vtype_fn_params}
use codegen.{Ctx, EmitValue, err_emit, null_ptr_val, ok_emit}
use codegen.{emit_expr, emit_block_loop_ctx}
use core.{stmt_unwrap}
use codegen.{analyze_releasable_expr}
use core.{avra_llvm_set_linkonce_odr}

// ── Capture detection ──

/// One captured variable for a lambda. The lifted fn reaches back
/// to the enclosing scope via this record: `alloca` is the original
/// binding's storage, `ty` carries its type into the lifted fn's
/// signature, and `is_mut` flips on after `mark_mutable_captures`
/// when the lambda body assigns to the capture.
type Capture = {
    name: string,
    alloca: ptr,
    ty: ValueType,
    is_mut: bool,
}

/// True when `name` is one of the lambda's declared parameters.
/// Used by capture detection to skip params (they're not
/// captures of the enclosing scope).
fn is_param(params: List<ParamEntry>, name: string) -> bool {
    mut i = 0
    while i < params.length {
        if params[i].name == name { return true }
        i = i + 1
    }
    false
}

/// Return a fresh list = `params` with `extra` appended. Used when
/// extending the in-scope param set across a Let/Mut/Const/For
/// without mutating the caller's view.
fn copy_params_with(params: List<ParamEntry>, extra: ParamEntry) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        out.push(params[i])
        i = i + 1
    }
    out.push(extra)
    out
}

/// Same as copy_params_with but appends a whole list.
fn copy_params_append(params: List<ParamEntry>, more: List<ParamEntry>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        out.push(params[i])
        i = i + 1
    }
    mut j = 0
    while j < more.length {
        out.push(more[j])
        j = j + 1
    }
    out
}

/// Membership test for the capture list. Stops capture detection
/// from re-adding the same name twice.
fn is_captured(captures: List<Capture>, name: string) -> bool {
    mut i = 0
    while i < captures.length {
        if captures[i].name == name { return true }
        i = i + 1
    }
    false
}

/// True when `expr` contains an assignment that targets `target`.
/// Drives the mutability inference for captured bindings —
/// captures that get assigned must be tracked as mutable so the
/// closure write-back path runs.
fn expr_assigns(store: NodeStore, expr: Expr, target: string) -> bool {
    match expr {
        .Assign(name, val) -> name == target || expr_assigns(store, store.exprs.get(val), target)
        .Binary(l, _, r) -> expr_assigns(store, store.exprs.get(l), target) || expr_assigns(store, store.exprs.get(r), target)
        .Unary(_, r) -> expr_assigns(store, store.exprs.get(r), target)
        .Logical(l, _, r) -> expr_assigns(store, store.exprs.get(l), target) || expr_assigns(store, store.exprs.get(r), target)
        .Grouping(inner) -> expr_assigns(store, store.exprs.get(inner), target)
        .Call(callee, args) -> expr_assigns(store, store.exprs.get(callee), target) || expr_list_assigns(store, args, target)
        .Block(body) -> stmt_id_list_assigns(store, body, target)
        .IfExpr(c, t, e) -> expr_assigns(store, store.exprs.get(c), target) || expr_assigns(store, store.exprs.get(t), target) || expr_assigns(store, store.exprs.get(e), target)
        .Lambda(_, body) -> expr_assigns(store, store.exprs.get(body), target)
        _ -> false
    }
}

/// True when any element of a `List<ExprId>` assigns to `target`.
fn expr_list_assigns(store: NodeStore, list: List<ExprId>, target: string) -> bool {
    mut i = 0
    while i < list.length {
        if expr_assigns(store, store.exprs.get(list[i]), target) { return true }
        i = i + 1
    }
    false
}

/// Per-statement assignment detector. Recognises `Assign`,
/// `FieldAssign`, and recurses into containing expressions /
/// nested bodies so deep mutations don't slip through.
fn stmt_assigns(store: NodeStore, stmt: Stmt, target: string) -> bool {
    match stmt {
        .Expr(e) -> expr_assigns(store, store.exprs.get(e), target)
        .Return(e) -> expr_assigns(store, store.exprs.get(e), target)
        .Block(body) -> stmt_id_list_assigns(store, body, target)
        .If(c, t, e) -> expr_assigns(store, store.exprs.get(c), target) || stmt_assigns(store, store.stmts.get(t), target) || (if e != null { stmt_assigns(store, store.stmts.get(e!), target) } else { false })
        .While(c, body) -> expr_assigns(store, store.exprs.get(c), target) || stmt_assigns(store, store.stmts.get(body), target)
        .For(_, s, e, body) -> expr_assigns(store, store.exprs.get(s), target) || expr_assigns(store, store.exprs.get(e), target) || stmt_assigns(store, store.stmts.get(body), target)
        .ForIn(_, coll, body) -> expr_assigns(store, store.exprs.get(coll), target) || stmt_assigns(store, store.stmts.get(body), target)
        _ -> false
    }
}

/// Row-list twin for flipped bodies.
fn stmt_id_list_assigns(store: NodeStore, ids: List<StmtId>, target: string) -> bool {
    for id in ids {
        if stmt_assigns(store, store.stmts.get(id), target) { return true }
    }
    false
}

// Mark captures as mutable if the lambda body assigns to them.
/// Walk the capture list re-flagging any entry that gets assigned
/// inside the lambda body. Mutable captures need a write-back path
/// so the enclosing scope sees their updated values. Mutates the
/// list in place via .set — there's no need for a fresh copy.
fn mark_mutable_captures(store: NodeStore, captures: List<Capture>, body: Expr) {
    mut local = captures
    for (i, c) in local.enumerate() {
        let is_mut = expr_assigns(store, body, c.name)
        if is_mut != c.is_mut {
            local.set(i, c with { is_mut: is_mut })
        }
    }
}

/// Walk an expression collecting captured names. A name is a
/// capture when it's referenced in the body, isn't one of the
/// declared params, isn't already in the capture list, and
/// resolves to an entry in the enclosing env. Recurses into
/// every compound expression form so nested calls and blocks
/// work. Mutates `captures` in place — no `c1`/`c2` thread-state
/// dance, just one shared list reference.
fn find_captures(store: NodeStore, expr: Expr, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    match expr {
        .Ident(name) -> {
            if is_param(params, name) { return }
            if is_captured(captures, name) { return }
            let lookup = env_lookup(env, name)
            if !lookup.found { return }
            mut local = captures
            local.push(Capture { name: name, alloca: lookup.alloca, ty: lookup.ty, is_mut: false })
        }
        .Binary(left, _, right) -> {
            find_captures(store, store.exprs.get(left), params, env, captures)
            find_captures(store, store.exprs.get(right), params, env, captures)
        }
        .Unary(_, right) -> find_captures(store, store.exprs.get(right), params, env, captures)
        .Logical(left, _, right) -> {
            find_captures(store, store.exprs.get(left), params, env, captures)
            find_captures(store, store.exprs.get(right), params, env, captures)
        }
        .Call(callee, args) -> {
            find_captures(store, store.exprs.get(callee), params, env, captures)
            find_captures_list(store, args, params, env, captures)
        }
        .Grouping(inner) -> find_captures(store, store.exprs.get(inner), params, env, captures)
        .IfExpr(c, t, e) -> {
            find_captures(store, store.exprs.get(c), params, env, captures)
            find_captures(store, store.exprs.get(t), params, env, captures)
            find_captures(store, store.exprs.get(e), params, env, captures)
        }
        .Block(stmts) -> find_captures_stmt_ids(store, stmts, params, env, captures)
        .Assign(_, value) -> find_captures(store, store.exprs.get(value), params, env, captures)
        .Index(obj, idx) -> {
            find_captures(store, store.exprs.get(obj), params, env, captures)
            find_captures(store, store.exprs.get(idx), params, env, captures)
        }
        .MatchExpr(subj, arms) -> {
            find_captures(store, store.exprs.get(subj), params, env, captures)
            find_captures_arms(store, arms, params, env, captures)
        }
        .EnumCtor(_, _, args) -> find_captures_list(store, args, params, env, captures)
        .StructLit(_, inits) -> find_captures_field_inits(store, inits, params, env, captures)
        .FieldAccess(obj, _) -> find_captures(store, store.exprs.get(obj), params, env, captures)
        .FieldAssign(obj, _, val) -> {
            find_captures(store, store.exprs.get(obj), params, env, captures)
            find_captures(store, store.exprs.get(val), params, env, captures)
        }
        .NullCoalesce(l, r) -> {
            find_captures(store, store.exprs.get(l), params, env, captures)
            find_captures(store, store.exprs.get(r), params, env, captures)
        }
        .Try(inner) -> find_captures(store, store.exprs.get(inner), params, env, captures)
        .ListLit(elems) -> find_captures_list(store, elems, params, env, captures)
        .Tuple(elems) -> find_captures_list(store, elems, params, env, captures)
        .MapLit(entries) -> find_captures_list(store, entries, params, env, captures)
        .With(obj, inits) -> {
            // Walk both obj AND field initialisers — closure that
            // uses `bag with { f: outer_var }` must capture outer_var.
            find_captures(store, store.exprs.get(obj), params, env, captures)
            find_captures_field_inits(store, inits, params, env, captures)
        }
        .Slice(obj, s, e) -> {
            find_captures(store, store.exprs.get(obj), params, env, captures)
            find_captures(store, store.exprs.get(s), params, env, captures)
            find_captures(store, store.exprs.get(e), params, env, captures)
        }
        .IsCheck(subj, _) -> find_captures(store, store.exprs.get(subj), params, env, captures)
        .InCheck(needle, items) -> {
            find_captures(store, store.exprs.get(needle), params, env, captures)
            find_captures_list(store, items, params, env, captures)
        }
        .OptionalChain(obj, _) -> find_captures(store, store.exprs.get(obj), params, env, captures)
        .OptionalMethodCall(obj, _, args) -> {
            find_captures(store, store.exprs.get(obj), params, env, captures)
            find_captures_list(store, args, params, env, captures)
        }
        .TupleIndex(obj, _) -> find_captures(store, store.exprs.get(obj), params, env, captures)
        .ListComp(body, var, coll, filter) -> {
            // Collection is evaluated in the outer scope.
            find_captures(store, store.exprs.get(coll), params, env, captures)
            // Body + filter run with `var` bound — extend params so a
            // reference to the loop variable isn't flagged as a capture.
            let inner_params = copy_params_with(params, ParamEntry { name: var, vtype: ValueType.Unknown })
            find_captures(store, store.exprs.get(body), inner_params, env, captures)
            if filter != null { find_captures(store, store.exprs.get(filter!), inner_params, env, captures) }
        }
        .Catch(inner, _, body, _, _) -> {
            find_captures(store, store.exprs.get(inner), params, env, captures)
            find_captures(store, store.exprs.get(body), params, env, captures)
        }
        .When(arms) -> find_captures_when_arms(store, arms, params, env, captures)
        .GenericCall(callee, _, args) -> {
            find_captures(store, store.exprs.get(callee), params, env, captures)
            find_captures_list(store, args, params, env, captures)
        }
        // Spawn/Isolated/Quote/Splice/Lambda were missing — closure
        // bodies that wrap their work in any of these would silently
        // skip captures for vars referenced inside.
        .Spawn(body) -> find_captures(store, store.exprs.get(body), params, env, captures)
        .Isolated(body) -> find_captures(store, store.exprs.get(body), params, env, captures)
        .Quote(_, body) -> find_captures(store, store.exprs.get(body), params, env, captures)
        .Splice(target) -> find_captures(store, store.exprs.get(target), params, env, captures)
        .Lambda(inner_params, inner_body) -> {
            // Inner lambda's body — its OWN params shadow the outer's
            // for capture detection, but captures inside it that come
            // from the outer environment must still bubble up.
            let merged = copy_params_append(params, inner_params)
            find_captures(store, store.exprs.get(inner_body), merged, env, captures)
        }
        _ -> {}  // Number, String, Bool, FloatLit, Null, QualifiedIdent — leaf nodes
    }
}

/// Recurse `find_captures` through every match-arm body.
fn find_captures_arms(store: NodeStore, arms: List<MatchArm>, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard_id != null { find_captures(store, store.exprs.get(arm.guard_id!), params, env, captures) }
        find_captures(store, store.exprs.get(arm.body_id), params, env, captures)
        i = i + 1
    }
}

/// Recurse `find_captures` through every value in a struct
/// literal / `with` override list.
fn find_captures_field_inits(store: NodeStore, inits: List<FieldInit>, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    mut i = 0
    while i < inits.length {
        find_captures(store, store.exprs.get(inits[i].value_id), params, env, captures)
        i = i + 1
    }
}

/// Recurse `find_captures` through every condition + body in a
/// `when` arm list.
fn find_captures_when_arms(store: NodeStore, arms: List<WhenArm>, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.cond_id != null { find_captures(store, store.exprs.get(arm.cond_id!), params, env, captures) }
        find_captures(store, store.exprs.get(arm.body_id), params, env, captures)
        i = i + 1
    }
}

/// Recurse `find_captures` across a `List<ExprId>` — call args,
/// list literals, etc.
fn find_captures_list(store: NodeStore, exprs: List<ExprId>, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    mut i = 0
    while i < exprs.length {
        find_captures(store, store.exprs.get(exprs[i]), params, env, captures)
        i = i + 1
    }
}

/// Per-statement capture finder. Recurses into expression
/// payloads + nested bodies. Decl-only statements pass through.
fn find_captures_stmt_body(store: NodeStore, stmt: Stmt, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    match stmt {
        .Block(stmts) -> find_captures_stmt_ids(store, stmts, params, env, captures)
        .Expr(e) -> find_captures(store, store.exprs.get(e), params, env, captures)
        .Return(e) -> find_captures(store, store.exprs.get(e), params, env, captures)
        .Let(_, _, init) -> find_captures(store, store.exprs.get(init), params, env, captures)
        .Mut(_, _, init) -> find_captures(store, store.exprs.get(init), params, env, captures)
        .If(cond, then_b, else_b) -> {
            find_captures(store, store.exprs.get(cond), params, env, captures)
            find_captures_stmt_body(store, store.stmts.get(then_b), params, env, captures)
            if else_b != null { find_captures_stmt_body(store, store.stmts.get(else_b!), params, env, captures) }
        }
        .While(cond, body) -> {
            find_captures(store, store.exprs.get(cond), params, env, captures)
            find_captures_stmt_body(store, store.stmts.get(body), params, env, captures)
        }
        .For(_, start, end, body) -> {
            find_captures(store, store.exprs.get(start), params, env, captures)
            find_captures(store, store.exprs.get(end), params, env, captures)
            find_captures_stmt_body(store, store.stmts.get(body), params, env, captures)
        }
        .ForIn(_, coll, body) -> {
            find_captures(store, store.exprs.get(coll), params, env, captures)
            find_captures_stmt_body(store, store.stmts.get(body), params, env, captures)
        }
        .Match(subj, arms) -> {
            find_captures(store, store.exprs.get(subj), params, env, captures)
            find_captures_arms(store, arms, params, env, captures)
        }
        .Defer(body) -> find_captures(store, store.exprs.get(body), params, env, captures)
        .Errdefer(body) -> find_captures(store, store.exprs.get(body), params, env, captures)
        .Const(_, _, init) -> find_captures(store, store.exprs.get(init), params, env, captures)
        .LetDestructure(_, init) -> find_captures(store, store.exprs.get(init), params, env, captures)
        .Annotated(_, inner) -> find_captures_stmt_body(store, store.stmts.get(inner), params, env, captures)
        .Parallel(body) -> find_captures_stmt_ids(store, body, params, env, captures)
        _ -> {}  // NoOp, Break, Continue, ExternFn, TypeDecl, EnumDecl, etc.
    }
}

/// Row-list twin of `find_captures_stmts` for flipped bodies —
/// threads the same local-shadow discipline.
fn find_captures_stmt_ids(store: NodeStore, ids: List<StmtId>, params: List<ParamEntry>, env: List<VarBinding>, captures: List<Capture>) {
    mut cur_params = params
    for id in ids {
        let node = store.stmts.get(id)
        find_captures_stmt_body(store, node, cur_params, env, captures)
        let extra: ParamEntry? = match node {
            .Let(name, _, _) -> ParamEntry { name: name, vtype: ValueType.Unknown }
            .Mut(name, _, _) -> ParamEntry { name: name, vtype: ValueType.Unknown }
            .Const(name, _, _) -> ParamEntry { name: name, vtype: ValueType.Unknown }
            .For(vname, _, _, _) -> ParamEntry { name: vname, vtype: ValueType.Unknown }
            .ForIn(vname, _, _) -> ParamEntry { name: vname, vtype: ValueType.Unknown }
            _ -> null
        }
        if extra != null { cur_params = copy_params_with(cur_params, extra!) }
    }
}

// ── Parameter type inference ──
//
/// Resolve each lambda param's declared type: an ANNOTATION is truth
/// (layout totality — codegen consumes declared types, it never infers
/// them from the body); a genuinely un-annotated param stays Unknown
/// (i64 at the layout boundary) until its position threads an expected
/// fn-type (emit_expected) or the typeck gates require an annotation.
/// The old body-scan heuristic that promoted un-annotated params to
/// Float when used alongside float operands is gone: a census over the
/// compiler-scale lib build plus every test dir showed the float branch
/// never fired — bare `let f = (x) -> ...` inits are F1006-gated, and
/// every float lambda in the corpus is annotated or context-threaded.
/// Result is a `List<ValueType>` matched 1:1 to the input param list.
fn declared_param_vtypes(ctx: Ctx, params: List<ParamEntry>) -> List<ValueType> {
    mut out: List<ValueType> = []
    mut i = 0
    while i < params.length {
        out.push(resolve_declared_or_unknown(ctx, params[i].vtype))
        i = i + 1
    }
    out
}

/// Resolve one declared param type, or Unknown when un-annotated.
/// Shared by `declared_param_vtypes` and `bind_lambda_params_typed`
/// so the annotation-is-truth branch exists exactly once.
fn resolve_declared_or_unknown(ctx: Ctx, vtype: ValueType) -> ValueType {
    if !vtype_is_unknown(vtype) {
        ctx.resolve_codegen_vtype(vtype)
    } else {
        ValueType.Unknown
    }
}

/// Annotation-is-truth fill for a caller-supplied param-type list:
/// an Unknown slot (e.g. the element type threaded from an EMPTY
/// list's `.map`/`.filter`/`.reduce`) is replaced by the param's
/// declared annotation when one exists. A concrete caller slot wins
/// (context and annotation agree on valid programs; context carries
/// resolved generics), so this only FILLS gaps, never overrides.
fn fill_unknown_from_declared(ctx: Ctx, params: List<ParamEntry>, supplied: List<ValueType>) -> List<ValueType> {
    mut out: List<ValueType> = []
    mut i = 0
    while i < supplied.length {
        if vtype_is_unknown(supplied[i]) && i < params.length {
            out.push(resolve_declared_or_unknown(ctx, params[i].vtype))
        } else {
            out.push(supplied[i])
        }
        i = i + 1
    }
    out
}

// Global lambda counter for unique names.
// This is the ONE allowed mutable global — it's a monotonic counter
// Unique lambda ID generation — uses a C-side counter to avoid mutable globals.
extern fn avra_next_lambda_id() -> int

/// Public entry for lambda codegen. Forwards to `emit_lambda_typed`
/// with no caller-supplied types, so each param resolves to its
/// DECLARED type via `declared_param_vtypes`.
export fn emit_lambda(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Lambda(params, body) -> {
            let empty_types: List<ValueType> = []
            emit_lambda_typed(ctx, env, params, ctx.nodes.exprs.get(body), empty_types, ValueType.Unknown)
        }
        _ -> err_emit("expected Lambda")
    }
}

/// Emit an expression under a declared/expected type: a `.Lambda` whose
/// expectation resolves to `.FnTyped` compiles against the expectation's
/// param types (the layout-totality threading — without it an
/// un-annotated lambda param stays Unknown and lays out as i64, so a
/// pointer-typed param miscompiles silently). Every other
/// expr/expected combination takes the plain emit path. This is the ONE
/// interception point shared by every position that knows its declared
/// type (let annotation, struct field, enum payload, with-override,
/// assign, call arg, …). `expected` may be raw or pre-resolved: alias
/// resolution happens here, and only for Lambda nodes, so non-lambda
/// args on hot call paths pay nothing.
export fn emit_expected(ctx: Ctx, env: List<VarBinding>, e: Expr, expected: ValueType) -> Result<EmitValue, string> {
    match e {
        .Lambda(params, body) -> {
            let resolved = ctx.resolve_codegen_vtype(expected)
            if resolved is .FnTyped {
                return emit_lambda_typed(ctx, env, params, ctx.nodes.exprs.get(body), vtype_fn_params(resolved), vtype_fn_ret(resolved))
            }
            ctx.emit(env, e)
        }
        _ -> ctx.emit(env, e)
    }
}

/// Return-type cascade (ps3t.4.5 slice B): emit a lambda's BODY with
/// its declared/threaded RETURN fn-type flowing into a nested
/// return-position lambda. `fn(int) -> fn(int) -> int` shapes —
/// `(n) -> { (x) -> x + n }` under a typed binding, or
/// `(a) -> (b) -> a + b` as a fn tail — fully declare the inner
/// lambda's param types, but without the cascade the inner emit ran
/// the no-context path and hit the F1007 refusal. Mirrors
/// fn_decl/codegen.av's emit_body_block prefix+tail threading; a
/// non-fn `ret_fn_ty` (the common case) takes the plain emit path.
fn emit_lambda_body_with_ret(ctx: Ctx, env: List<VarBinding>, body: Expr, ret_fn_ty: ValueType) -> Result<EmitValue, string> {
    if !(ret_fn_ty is .FnTyped) { return emit_expr(ctx, env, body) }
    match body {
        .Lambda(p, b) ->
            emit_lambda_typed(ctx, env, p, ctx.nodes.exprs.get(b), vtype_fn_params(ret_fn_ty), vtype_fn_ret(ret_fn_ty))
        .Block(stmts) -> {
            if stmts.length == 0 { return emit_expr(ctx, env, body) }
            let last_i = stmts.length - 1
            mut tail_lambda_params: List<ParamEntry> = []
            mut tail_lambda_body: Expr = Expr.None
            mut has_tail_lambda = false
            match stmt_unwrap(ctx.nodes, ctx.nodes.stmts.get(stmts[last_i])) {
                .Expr(e) -> {
                    match ctx.nodes.exprs.get(e) {
                        .Lambda(p, b) -> {
                            tail_lambda_params = p
                            tail_lambda_body = ctx.nodes.exprs.get(b)
                            has_tail_lambda = true
                        }
                        _ -> {}
                    }
                }
                _ -> {}
            }
            if !has_tail_lambda { return emit_expr(ctx, env, body) }
            mut prefix: List<StmtId> = []
            mut pi = 0
            while pi < last_i {
                prefix.push(stmts[pi])
                pi = pi + 1
            }
            let pre = emit_block_loop_ctx(ctx, env, prefix, ctx.i64(0), .Unknown)?
            // emit_block_loop_ctx returns an EMPTY env for an empty stmt
            // list — fall back to the caller's env so a no-prefix tail
            // lambda still sees the enclosing params for capture analysis.
            let pre_env = if last_i == 0 { env } else { pre.env }
            // Prefix ended in a terminator (early return): the tail
            // lambda is dead code — don't emit past the terminator
            // (t-83ja, mirroring emit_body_block).
            if pre.ctx.has_terminator() { return ok_emit(pre.value, pre.ty) }
            emit_lambda_typed(pre.ctx, pre_env, tail_lambda_params, tail_lambda_body, vtype_fn_params(ret_fn_ty), vtype_fn_ret(ret_fn_ty))
        }
        _ -> emit_expr(ctx, env, body)
    }
}

// Compile a lambda with explicit parameter types.
// Used by .map/.filter/.reduce to pass the list's element type
// so that int(x) / x.length / etc. work correctly inside the lambda.
/// Lambda codegen with explicit param types. Builds a lifted
/// top-level `__lambda_N` function with a hidden env-pointer
/// param prepended; emits the body inside; allocates a closure
/// array `[TAG, fn_ptr, capture0, capture1, ...]` and returns
/// it as the call's value. Non-capturing lambdas get a single-
/// slot closure with the function pointer only.
export fn emit_lambda_typed(ctx: Ctx, env: List<VarBinding>, raw_params: List<ParamEntry>, body: Expr, param_types: List<ValueType>, ret_fn_ty: ValueType) -> Result<EmitValue, string> {
    let id = avra_next_lambda_id()
    // Library-mode: prefix the lambda name with the lib_pkg_root
    // (e.g. `@std::lsp::__lambda_3`) so two different units that
    // both happen to emit `__lambda_3` don't collide. The lambda
    // ID counter is process-local — without the prefix, shard's
    // `__lambda_3` and producer's `__lambda_3` are completely
    // different bodies that the linker would pick one of and
    // crash the unpicked caller at runtime.
    let lambda_prefix = if ctx.lib_pkg_root == "" {
        ""
    } else {
        ctx.lib_pkg_root + "::"
    }
    let name = "${lambda_prefix}__lambda_${string(id)}"
    let params = ctx.resolve_params(raw_params)

    // Detect captured variables from the enclosing scope.
    // Mark captures as mutable if the lambda body assigns to them.
    mut captures: List<Capture> = []
    find_captures(ctx.nodes, body, params, env, captures)
    mark_mutable_captures(ctx.nodes, captures, body)
    let num_captures = captures.length
    let num_declared = params.length
    let arity = num_declared + num_captures

    // Compute effective parameter types BEFORE creating the LLVM function,
    // so we can build a properly-typed LLVM function signature.
    // Empty caller-supplied list means "read the declared annotations".
    // A non-empty caller list can still carry Unknown slots (an empty
    // list's `.map` threads an Unknown element type) — annotation is
    // truth (A5), so a declared param type fills any Unknown slot
    // rather than being overridden by it.
    let effective_types = if param_types.length == 0 {
        declared_param_vtypes(ctx, params)
    } else {
        fill_unknown_from_declared(ctx, params, param_types)
    }
    // F1007 (ps3t.4.5 layout totality): a parameter whose type is still
    // Unknown here has no layout — the old behavior silently laid it out
    // as i64, reinterpreting pointer params as integers (the
    // silent-miscompile class). Refuse instead. The typeck F1006 gates
    // catch every un-annotated unthreaded position with a span first, so
    // reaching this error means a threading gap (e.g. an un-annotated
    // lambda handed to an under-applied generic's template dispatch) —
    // the annotation fix applies either way.
    mut ti = 0
    while ti < effective_types.length {
        if vtype_is_unknown(effective_types[ti]) && ti < params.length {
            return err_emit("error[F1007]: cannot determine the type of lambda parameter `${params[ti].name}` — annotate it, e.g. `(${params[ti].name}: int) -> …`; a lambda parameter's layout must be fully resolved before code generation")
        }
        ti = ti + 1
    }

    // Build typed LLVM function: declared params use effective_types, captures use i64.
    let param_arr = avra_llvm_type_array_new(arity)
    ctx.fill_typed_lambda_params(param_arr, effective_types, 0, arity)
    let fn_type = ctx.fn_type(ctx.i64_type, param_arr, arity)
    ctx.type_array_free(param_arr)
    let fn_val = ctx.add_function(name, fn_type)

    let saved_bb = ctx.current_bb()

    let entry = ctx.bb_in(fn_val, "entry")
    ctx.position(entry)
    let env_with_params = bind_lambda_params_typed(ctx, env, params, fn_val, 0, effective_types)
    let body_env = bind_captures_as_params(ctx, env_with_params, captures, fn_val, num_declared)

    mut body_ctx = ctx.with_fn(fn_val, name)
    body_ctx.cov_fn_entry()
    // with_fn resets defers/rc_cleanup/rc_releasable to .End, so lambda body starts fresh.
    body_ctx.rc_releasable = analyze_releasable_expr(ctx.nodes, body)
    mut result = EmitValue { value: ctx.i64(0), ty: .Int }
    match emit_lambda_body_with_ret(body_ctx, body_env, body, ret_fn_ty) {
        .Ok(v) -> { result = v }
        .Err(e) -> {
            ctx.position(saved_bb)
            return err_emit(e)
        }
    }

    if !ctx.has_terminator() {
        let lambda_ret = body_ctx.current_fn_ret()
        ctx.ret(result.value, lambda_ret)
    }
    body_ctx.cov_finalize_fn()

    ctx.position(saved_bb)

    // If there are captures, we need to pass the captured values at call time.
    // Pack: [fn_ptr, cap1, cap2, ...] into an array. The C runtime's
    // ALL lambdas use closure arrays: [TAG, fn_ptr, cap1, cap2, ...]
    // Even non-capturing ones get [TAG, fn_ptr] so the C-side
    // avra_closure_call_* trampolines can safely inspect them.
    // Only named function references (let f = my_fn) are bare pointers.
    let fn_ptr_i64 = ctx.ptr_to_int(fn_val, "lambda_ptr")
    let closure_arr = ctx.closure_array(fn_ptr_i64)
    if num_captures > 0 {
        push_captured_values(ctx, captures, closure_arr)
    }
    let closure_i64 = ctx.to_i64(closure_arr, "closure_i64")
    ok_emit(closure_i64, ValueType.Closure(num_captures, result.ty))
}

/// Bind every captured value as an extra parameter in the
/// lifted lambda's body env. Captures appear after the user-
/// declared params in the LLVM signature, so the body can read
/// them transparently via env lookup. `start_idx` is the LLVM
/// param slot where captures begin.
fn bind_captures_as_params(ctx: Ctx, env: List<VarBinding>, captures: List<Capture>, fn_val: ptr, start_idx: int) -> List<VarBinding> {
    mut current_env = env
    for (i, c) in captures.enumerate() {
        let param_val = ctx.get_param(fn_val, start_idx + i)
        current_env = if c.is_mut {
            // Mutable capture: param is an alloca POINTER — use directly
            let alloca = ctx.int_to_ptr(param_val, "cap_alloca")
            env_extend(current_env, c.name, alloca, c.ty)
        } else {
            // Immutable capture: param is a value — create local alloca
            ctx.bind(current_env, c.name, param_val, c.ty)
        }
    }
    current_env
}

/// Walk the capture list pushing each captured value onto the
/// closure's array (slots 2+ after the marker + fn pointer).
/// Loads from each capture's alloca so the snapshot reflects
/// the current value at closure-creation time.
fn push_captured_values(ctx: Ctx, captures: List<Capture>, arr: ptr) {
    mut i = 0
    while i < captures.length {
        let c = captures[i]
        if c.is_mut {
            // Mutable capture: pass alloca POINTER so writes propagate
            let ptr_val = ctx.to_i64(c.alloca, "cap_ptr")
            ctx.array_push(arr, ptr_val)
        } else {
            // Immutable capture: pass current VALUE (copy)
            let val = ctx.load_i64(c.alloca, "cap_val")
            ctx.array_push(arr, val)
        }
        i = i + 1
    }
}

// Emit a lambda argument with typed parameters. If the argument
// expression is a Lambda, compile it with explicit param types so
// that type-dependent operations (int(x), x.length, x.upper())
// work correctly inside the lambda body.
/// Emit the first arg from `args`, but if it's a Lambda,
/// compile it against the supplied `param_types` instead of
/// using the heuristic. Used by higher-order list methods
/// (`map`, `filter`, …) that know their callback's expected
/// param types.
export fn emit_typed_lambda_arg(ctx: Ctx, env: List<VarBinding>, args: List<ExprId>, param_types: List<ValueType>) -> Result<EmitValue, string> {
    if args.length == 0 { return err_emit("expected 1 argument, got 0") }
    let se = args[0]
    match ctx.nodes.exprs.get(se) {
        .Lambda(params, body) -> emit_lambda_typed(ctx, env, params, ctx.nodes.exprs.get(body), param_types, ValueType.Unknown)
        _ -> ctx.emit(env, ctx.nodes.exprs.get(se))
    }
}

// Call a function pointer stored in a local variable.
// Load the pointer, cast to fn ptr, build indirect call.
/// Codegen for calling a fn-typed local variable. Loads the
/// closure pointer from the alloca and dispatches via
/// `emit_closure_call` (which handles env-pointer prepend +
/// arity coercion).
export fn emit_indirect_call(ctx: Ctx, env: List<VarBinding>, alloca: ptr, name: string, args: List<ExprId>) -> Result<EmitValue, string> {
    let fn_i64 = ctx.load_i64(alloca, name)
    let local = env_lookup(env, name)
    let ret_ty = vtype_fn_ret(local.ty)
    // Closure values (lambda expressions) are arrays that need unpacking.
    // Fn values (named function refs) are bare pointers that can be called directly.
    if vtype_is_closure(local.ty) {
        let num_caps = vtype_closure_captures(local.ty)
        // num_caps < 0 means "closure with unknown capture count" —
        // use the trampoline which resolves captures at runtime.
        if num_caps >= 0 {
            return emit_closure_call_typed(ctx, env, fn_i64, args, num_caps, ret_ty)
        }
    }
    emit_indirect_call_typed(ctx, env, fn_i64, args, ret_ty)
}

/// Same as `emit_indirect_call` but loads the closure pointer
/// from a top-level global instead of a local alloca. Used when
/// a fn is exported as a `mut` global.
export fn emit_indirect_call_from_global(ctx: Ctx, env: List<VarBinding>, global: ptr, name: string, args: List<ExprId>, ty: ValueType) -> Result<EmitValue, string> {
    let fn_i64 = ctx.load_i64(global, name)
    let ret_ty = vtype_fn_ret(ty)
    if vtype_is_closure(ty) {
        let num_caps = vtype_closure_captures(ty)
        if num_caps >= 0 {
            return emit_closure_call_typed(ctx, env, fn_i64, args, num_caps, ret_ty)
        }
    }
    emit_indirect_call_typed(ctx, env, fn_i64, args, ret_ty)
}

// AvraArray:
// [0] = fn_ptr, [1..N] = captured values.
// We unpack fn_ptr, evaluate user args, append captures, and call.
/// Core indirect-call logic for closures. Reads the function
/// pointer from slot 1 of the closure array, builds the arg
/// array (prepending captured values when `num_captures > 0`),
/// and calls via `avra_closure_call_N` for the right arity.
fn emit_closure_call(ctx: Ctx, env: List<VarBinding>, closure_val: ptr, args: List<ExprId>, num_captures: int) -> Result<EmitValue, string> {
    // Closure array layout: [TAG, fn_ptr, cap1, cap2, ...]
    // TAG is at index 0, fn_ptr at index 1, captures start at index 2.
    let closure_ptr = ctx.to_ptr(closure_val, "closure_ptr")
    // Load fn_ptr from closure array[1] (index 0 is the TAG)
    let get_fn_call = ctx.array_get(closure_ptr, ctx.i64(1))
    let fn_ptr = ctx.int_to_ptr(get_fn_call, "fn_ptr")

    let user_arg_count = args.length
    let total_args = user_arg_count + num_captures

    // Fill the value array first so we can read each emitted value's
    // actual LLVM type. The lambda was declared with typed declared
    // params + i64 captures (see fill_typed_lambda_params); the call
    // site fn_type must mirror that signature or LLVM's verifier
    // flags every closure invocation as a parameter-type mismatch.
    // Tracking ticket: forge-crafting-intepreters-og68.
    let val_arr = ctx.value_array(total_args)
    match fill_lambda_args(ctx, env, val_arr, args, 0) {
        .Ok(_) -> {}
        .Err(e) -> {
            ctx.value_array_free(val_arr)
            return err_emit(e)
        }
    }
    // Fill captures from closure array (start at index 2)
    fill_closure_captures(ctx, val_arr, closure_ptr, user_arg_count, num_captures)

    // Build the param-type array: declared params take whatever LLVM
    // type their emitted value carries (ptr for Expr/string/struct,
    // i64 for int/bool, double for float); captures are always i64
    // because that's what closure_array stores them as.
    let param_arr = ctx.value_array_param_types(val_arr, user_arg_count, num_captures)
    let fn_type = ctx.fn_type(ctx.i64_type, param_arr, total_args)
    ctx.type_array_free(param_arr)

    let result = ctx.build_call(fn_type, fn_ptr, val_arr, total_args, "closure_call")
    ctx.value_array_free(val_arr)
    ok_emit(result, .Int)
}

/// Copy `count` capture slots out of the closure array into
/// the call's value array starting at `start_idx`. Used by
/// `emit_closure_call` to materialise the env-pointer prepend.
fn fill_closure_captures(ctx: Ctx, val_arr: ptr, closure_val: ptr, start_idx: int, count: int) {
    // Captures start at array index 2 (after TAG and fn_ptr)
    for i in 0..count {
        let cap_val = ctx.array_get(closure_val, ctx.i64(i + 2))
        ctx.value_array_set(val_arr, start_idx + i, cap_val)
    }
}

/// Indirect call where the caller already has the closure as an
/// SSA i64 and knows the expected return type. Skips the
/// alloca-load step and dispatches straight through.
export fn emit_indirect_call_typed(ctx: Ctx, env: List<VarBinding>, fn_i64: ptr, args: List<ExprId>, ret_ty: ValueType) -> Result<EmitValue, string> {
    let r = emit_indirect_call_value(ctx, env, fn_i64, args)?
    ok_emit(r.value, ret_ty)
}

/// Variant of `emit_closure_call` for callers that already have
/// the SSA i64 and know both the capture count and return type.
/// Saves a load and types the result for the caller.
export fn emit_closure_call_typed(ctx: Ctx, env: List<VarBinding>, fn_i64: ptr, args: List<ExprId>, num_captures: int, ret_ty: ValueType) -> Result<EmitValue, string> {
    let r = emit_closure_call(ctx, env, fn_i64, args, num_captures)?
    ok_emit(r.value, ret_ty)
}

/// Indirect call against an i64-shaped closure value when the
/// caller doesn't yet know the expected return type. Used in
/// generic call paths where typing is deferred.
export fn emit_indirect_call_value(ctx: Ctx, env: List<VarBinding>, fn_i64: ptr, args: List<ExprId>) -> Result<EmitValue, string> {
    // Indirect call for values with unknown closure status at compile time.
    // This happens when a fn returns a closure but the return type says
    // Fn/FnTyped (the type system can't distinguish bare ptrs from
    // closure arrays through function boundaries).
    //
    // Uses avra_closure_call_N trampolines which handle both bare
    // function pointers and closure arrays at runtime via
    // avra_closure_dispatch in runtime.c. Supports up to 8 total
    // args (user + captures).
    let user_arg_count = args.length
    if user_arg_count == 0 {
        return ok_emit(ctx.call("avra_closure_call_0", [fn_i64]), .Int)
    }
    if user_arg_count == 1 {
        let a0 = ctx.emit(env, ctx.nodes.exprs.get(args[0]))?
        return ok_emit(ctx.call("avra_closure_call_1", [fn_i64, a0.value]), .Int)
    }
    if user_arg_count == 2 {
        let a0 = ctx.emit(env, ctx.nodes.exprs.get(args[0]))?
        let a1 = ctx.emit(env, ctx.nodes.exprs.get(args[1]))?
        return ok_emit(ctx.call("avra_closure_call_2", [fn_i64, a0.value, a1.value]), .Int)
    }
    if user_arg_count == 3 {
        let a0 = ctx.emit(env, ctx.nodes.exprs.get(args[0]))?
        let a1 = ctx.emit(env, ctx.nodes.exprs.get(args[1]))?
        let a2 = ctx.emit(env, ctx.nodes.exprs.get(args[2]))?
        return ok_emit(ctx.call("avra_closure_call_3", [fn_i64, a0.value, a1.value, a2.value]), .Int)
    }
    err_emit("indirect calls with ${string(user_arg_count)} args not yet supported")
}

/// Walk a `List<ExprId>` emitting each arg into successive slots of
/// `arr`. Lambda call paths use this to pack user-supplied
/// arguments into the value array passed to
/// `avra_closure_call_N`.
fn fill_lambda_args(ctx: Ctx, env: List<VarBinding>, arr: ptr, args: List<ExprId>, idx: int) -> Result<EmitValue, string> {
    for (i, arg) in args.enumerate() {
        let r = ctx.emit(env, ctx.nodes.exprs.get(arg))?
        ctx.value_array_set(arr, idx + i, r.value)
    }
    ok_emit(null_ptr_val(), .Void)
}

/// Bind each lambda parameter as an alloca + env entry,
/// pulling its declared type from the supplied `types` list (or
/// falling back to the param's annotation when the type list is
/// short). Mirror of `bind_params_inline` for closure bodies.
fn bind_lambda_params_typed(ctx: Ctx, env: List<VarBinding>, params: List<ParamEntry>, fn_val: ptr, idx: int, types: List<ValueType>) -> List<VarBinding> {
    mut cur_env = env
    mut i = idx
    mut type_idx = 0
    mut pi = 0
    while pi < params.length {
        let p = params[pi]
        let param_val = ctx.get_param(fn_val, i)
        let ty = if type_idx < types.length {
            // Canonicalize caller-provided expected types too: mono's
            // string-roundtripped instantiation types can carry BARE
            // nominal names (Struct("CompConfig", 0)); binding them
            // unresolved makes every later field access miss the
            // registry's module-qualified entry. resolve_codegen_vtype
            // is idempotent on already-qualified types.
            ctx.resolve_codegen_vtype(types[type_idx])
        } else {
            resolve_declared_or_unknown(ctx, p.vtype)
        }
        cur_env = ctx.bind(cur_env, p.name, param_val, ty)
        i = i + 1
        type_idx = type_idx + 1
        pi = pi + 1
    }
    cur_env
}
