spec "lambda basic" {
    then "single-param lambda" {
        let double = (x) -> x * 2
        double(5) == 10
    }
    then "two-param lambda" {
        let add = (a, b) -> a + b
        add(3, 4) == 7
    }
    then "lambda captures outer int" {
        let n = 10
        let add_n = (x) -> x + n
        add_n(5) == 15
    }
    then "lambda with block body" {
        let f = (x) -> {
            let y = x + 1
            y * 2
        }
        f(3) == 8
    }
}
