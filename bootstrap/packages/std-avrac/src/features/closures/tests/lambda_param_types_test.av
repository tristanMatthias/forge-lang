// ps3t.4.5: lambda codegen CONSUMES each parameter's declared type — it does not
// INFER it. An annotated param, including a POINTER type like `string`, reaches
// codegen with its real type (via `declared_param_vtypes`) and is slotted
// correctly. If codegen dropped the annotation to a value-scalar default (the
// failure mode of the removed body-scanning heuristic), a `string` param would
// occupy an i64 slot and `.length` would read garbage. These specs use
// `let`-bound lambdas with NO expected closure type, so they travel the
// untyped-standalone path (`emit_lambda` → `declared_param_vtypes`) — the exact
// path the heuristic used to guess. Mutating `declared_param_vtypes` to drop the
// type (e.g. return `Unknown`) makes the string/float arms fail.

spec "lambda params honor their declared type (ps3t.4.5)" {
    then "a string-typed param is slotted as a pointer, not an i64" {
        let len = (s: string) -> s.length
        len("hello") == 5
    }
    then "an int-typed param computes correctly" {
        let dbl = (n: int) -> n * 2
        dbl(21) == 42
    }
    then "a float-typed param computes correctly" {
        let inc = (x: float) -> x + 1.5
        inc(2.0) == 3.5
    }
    then "mixed pointer + value params in one lambda" {
        let f = (s: string, n: int) -> s.length + n
        f("hi", 3) == 5
    }
}
