enum CmBox { Val(n: int), Empty }

spec "capture in match" {
    then "capture inside match arm body" {
        let factor = 3
        let f = (b: CmBox) -> match b {
            .Val(n) -> n * factor
            .Empty -> 0
        }
        f(CmBox.Val(10)) == 30
    }
    then "capture inside if-else branch" {
        let default_val = 99
        let f = (x: int) -> {
            if x > 0 { x } else { default_val }
        }
        f(0 - 1) == 99
    }
    then "capture inside enum-context expression" {
        let suffix = " world"
        let f = (s: string) -> s + suffix
        f("hello") == "hello world"
    }
}
