/// Test fixture: trivial single-payload enum used to verify
/// inline lambdas can `match` on enum payloads.
///
/// Variants:
/// - Val(n: int) — single-payload variant.
enum IlmBox { Val(n: int) }

/// Test fixture: applies an inline lambda to an `IlmBox`. Used
/// to verify the higher-order-call path with a destructuring
/// lambda body.
fn ilm_apply(b: IlmBox, f: fn(IlmBox) -> int) -> int { f(b) }

/// Test fixture: tiny arithmetic expression tree used to
/// exercise recursive higher-order mapping over an enum AST.
///
/// Variants:
/// - Num(value: int) — leaf number.
/// - Add(left, right) — binary sum node.
enum IlmExpr { Num(value: int), Add(left: IlmExpr, right: IlmExpr) }

/// Test fixture: recursive map over `IlmExpr` — applies `f`
/// bottom-up. Verifies that mapping a tree with an inline
/// lambda preserves the structure.
fn ilm_map_expr(expr: IlmExpr, f: fn(IlmExpr) -> IlmExpr) -> IlmExpr {
    let mapped = match expr {
        .Num(_) -> expr
        .Add(l, r) -> IlmExpr.Add(ilm_map_expr(l, f), ilm_map_expr(r, f))
    }
    f(mapped)
}

/// Test fixture: classic interpreter for `IlmExpr` — sums leaf
/// nodes recursively. Used to assert on the result of mapping.
fn ilm_eval(expr: IlmExpr) -> int {
    match expr { .Num(v) -> v, .Add(l, r) -> ilm_eval(l) + ilm_eval(r) }
}

spec "inline lambda match" {
    then "inline lambda destructures enum payload" {
        ilm_apply(IlmBox.Val(21), (b: IlmBox) -> match b { .Val(n) -> n * 2, _ -> 0 }) == 42
    }
    then "inline lambda used by recursive higher-order mapper" {
        let factor = 3
        let tree = IlmExpr.Add(IlmExpr.Num(1), IlmExpr.Add(IlmExpr.Num(2), IlmExpr.Num(3)))
        let scaled = ilm_map_expr(tree, (e: IlmExpr) -> match e { .Num(v) -> IlmExpr.Num(v * factor), _ -> e })
        ilm_eval(scaled) == 18
    }
}
