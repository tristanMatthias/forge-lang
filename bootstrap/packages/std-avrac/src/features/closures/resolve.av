// The closures feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Expr}
use resolve.{Resolver, declare_params, enter_resolve_scope, exit_resolve_scope, resolve_expr}

/// Resolver hook for `Lambda`. Opens a fresh scope, declares
/// every parameter, resolves the body inside that scope, then
/// exits — captures of outer names work because the outer
/// scope remains visible during body resolution.
fn closure_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .Lambda(params, body) -> {
            let entered = enter_resolve_scope(r)
            let with_params = declare_params(entered, params)
            let after_body = resolve_expr(with_params, with_params.nodes.exprs.get(body))
            exit_resolve_scope(after_body)
        }
        _ -> r
    }
}
