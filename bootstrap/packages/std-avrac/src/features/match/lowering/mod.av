// The match feature's LOWERINGS — typed build fns + their ABI adapters +
// manifest rows, in a dedicated SUBMODULE so the generated parser imports
// them directly (t-kd4y.3 Batch A, the wrapper-free shape). This module
// imports ONLY features.grammar + core — both already in every generated
// parser's closure — so the F4012 import-closure invariant holds by
// construction; the feature's passes/hooks stay in ../mod.av.
//
// Batch B completes the family: the span-carrying rows (MkWhenStmt /
// MkArmReturn / MkMatchTableExpr) ride `spanned` binds — the rule-entry
// byte arrives as st.build_sp (-1 on the interpreter path, which stays
// span-free like the retired central arms) — and the table pair's cores
// live here now, mk_when included (t-kd4y.3.5.2 — the when feature's
// expression core, beside its one other caller mk_when_stmt_abi).

use core.{Stmt, StmtId, Expr, ExprId, PatId, Pattern, MatchArm, WhenArm, NodeRef, SrcPos, ValueType, byte_span, byte_span_none, pattern_optional_present, pattern_optional_absent}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_warm_val, capval_arm_val, capval_pat_val, capval_present, capval_to_expr, capval_to_expr_opt, capval_to_pat, capval_to_arm_list, capval_tok_list, capval_tok_text, capval_to_pat_list, capval_to_node_list, param_entries_from_toks, capval_to_when_arm_list}

export fn build_when_arm(c: ExprId, b: ExprId) -> WhenArm {
    WhenArm { cond_id: c, body_id: b }
}
export fn build_when_default(b: ExprId) -> WhenArm {
    WhenArm { cond_id: none, body_id: b }
}
/// One `pattern (if guard)? -> body` arm. Carries the boxed Pattern AND its
/// id (render_match_arm renders the box; passes re-resolve by id).
export fn build_arm(pattern: Pattern, pattern_id: PatId, guard: ExprId?, body: ExprId) -> MatchArm {
    MatchArm { pattern: pattern, pattern_id: pattern_id, guard_id: guard, body_id: body }
}
/// `match subject { arm* }`, statement position.
export fn build_match(subject: ExprId, arms: List<MatchArm>) -> Stmt {
    Stmt.Match(subject, arms)
}

export fn build_when_arm_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_warm_val(st, build_when_arm(capval_to_expr(st, vals[0]), capval_to_expr(st, vals[1])))
}
export fn build_when_default_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_warm_val(st, build_when_default(capval_to_expr(st, vals[0])))
}
export fn build_arm_abi(st: PState, vals: List<CapVal>) -> CapVal {
    // The boxed-Pattern read lives HERE, not in the typed fn — adapters are
    // the marshalling layer, and the arena is marshalling.
    let pid = capval_to_pat(st, vals[0])
    capval_arm_val(st, build_arm(st.store.pats.get(pid), pid, capval_to_expr_opt(st, vals[1]), capval_to_expr(st, vals[2])))
}
export fn build_match_abi(st: PState, vals: List<CapVal>) -> CapVal {
    // The arms' PatRef EDGES are part of the production row (the retired
    // emit-side mk_match recorded them; the faithfulness oracle reads them
    // back) — edges are arena marshalling, so they live in the adapter.
    let arms = capval_to_arm_list(vals[1])
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.SNode(st.store.add_stmt(build_match(capval_to_expr(st, vals[0]), arms), byte_span_none(), refs))
}

/// The subjectless `match { cond -> body }` statement — a `When` EXPRESSION
/// under a span-free `Stmt.Expr` leaf. The span belongs to the INTERIOR
/// When node (its ByteSpan, via st.build_sp), never the stmt row — the
/// shape that needed the unified span protocol to leave the engine.
export fn mk_when_stmt_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, mk_when(st, st.build_sp, vals[0])))))
}

/// `-> return v` / `-> return` as a match ARM body (the `MkArmReturn` row's core).
///
/// `MatchArm.body_id` is an ExprId and `return` is a STATEMENT, so the hand bridged the
/// two by wrapping: `Expr.Block([Stmt.Return(v)])` — "stmt-bearing, so it bridges at its
/// boundary" — reproduced here rather than invented, because the arm body has nowhere
/// else to put a statement.
///
/// The bare form is `Stmt.ReturnEmpty`, and WHICH form applies is newline-sensitive: the
/// hand took the empty branch when the next token is `}`, `,` or EOF, or sits on a LATER
/// LINE. Without that, an arm folds the NEXT arm's pattern into its return value. The
/// grammar spells the same rule as `^( e:expression )?` — the same-line marker
/// `return_stmt` already uses — so the two engines decide it identically.
///
/// The synthesized row is stamped at the `return` KEYWORD (sp_start), not at the cursor
/// after parsing the value: a post-advance stamp points a field-access null-trap at the
/// delimiter or the next token instead of the `return` (the hand recorded the same
/// caveat, having hit it).
fn mk_arm_return(st: PState, sp_start: int, val_cv: CapVal) -> CapVal {
    let ret_id = if capval_present(val_cv) {
        st.store.stmts.add_leaf(Stmt.Return(capval_to_expr(st, val_cv)))
    } else {
        st.store.stmts.add_leaf(Stmt.ReturnEmpty)
    }
    if sp_start >= 0 {
        let lc = st.store.lines.to_linecol(sp_start)
        st.store.stmts.record_pos(ret_id, SrcPos { line: lc.line, col: lc.col, file: st.file })
    }
    let body: List<StmtId> = [ret_id]
    CapVal.Node(st.store.exprs.add_leaf(Expr.Block(body)))
}

export fn mk_arm_return_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_arm_return(st, st.build_sp, vals[0])
}

/// t-47hc.29 — the match TABLE's arms, desugared exactly as the hand
/// `parse_match_table_arms` / `parse_match_table_rows` did in the hand parser.
///
/// The header's FIRST column names the PATTERN column and is DISCARDED; the rest are the
/// value columns, so `#cols` IS the hand's `value_count = header_count - 1`. That identity
/// is what lets the grammar express the row width as a bounded repetition `x{#cols}`
/// (t-47hc.28) rather than the data-dependent `while i < value_count` loop the roadmap
/// once read as inexpressible.
///
/// Rows arrive FLATTENED — one alternation branch owns the whole table, because a repetition
/// bound may only name a capture collected earlier in the SAME branch and `exec_rule` mints a
/// fresh CapEnv per rule. So the cells are re-chunked here by `cols.length`, which is sound
/// precisely because the cap guarantees no row exceeds it; a SHORT row (the hand's
/// `if check(RightBrace) break`) is tolerated by clamping, never by reading past the end.
///
/// Each key is `Expr.String` whose lexeme KEEPS its surrounding quotes — the hand writes
/// `"\"${col}\""` because codegen's `strip_quotes` removes them again. Dropping them here
/// would silently change every generated map key. Keys, values and bodies are all
/// span-free `alloc_leaf` rows, matching the hand.
fn build_table_arms(st: PState, cols_cv: CapVal, pats_cv: CapVal, vals_cv: CapVal) -> List<MatchArm> {
    let cols = capval_tok_list(cols_cv)
    let pats = capval_to_pat_list(pats_cv)
    let vals = capval_to_node_list(vals_cv)
    mut out: List<MatchArm> = []
    // `header_count < 2` (i.e. no value columns) yields NO arms — the hand's early return.
    if cols.length == 0 { return out }
    // t-qhbz: REQUIRE the declared width. The row's cell repetition is `*{#cols}`, and a
    // `{#cap}` bound is AT MOST N — never a requirement (`item_bound_cap` stops at the cap
    // but nothing demands it). So a token starting none of `table_cell`'s alternatives —
    // a prefix operator like `-1`, which cells deliberately exclude — simply ENDS the row
    // rather than reporting, and the outer row loop then consumes it as the NEXT row's
    // `p:pattern`, because a negative literal IS a valid pattern. Everything is consumed
    // and nothing complains, so
    //
    //     match e table { pat | delta
    //         .A | -1
    //         .B | 2
    //     }
    //
    // checked CLEAN on both native engines (pats=[.A, -1, 2], vals=[.B]) while the hand
    // parser rejected it F0040. A latent hole since t-47hc.29 — unreachable until fn
    // bodies were routed natively, because a hand-parsed body never got here.
    //
    // This is the one place that knows BOTH the header's value-column count and the
    // flattened cell count, so it is where the width becomes checkable. `cols` holds only
    // the VALUE columns (the header's leading IDENT — the pattern column — is matched
    // unlabelled), so a well-formed table has exactly one cell per row per value column.
    if vals.length != pats.length * cols.length {
        // CODED, because the hand rejects this as F0040 and an uncoded report reaches the
        // flip seam as the F0001 default — the same sentence under two codes depending on
        // which engine produced it. The note above is exactly right that this became
        // reachable when fn bodies routed; the code was the half still missing.
        st.report_coded("F0040", "expected expression")
        return out
    }
    mut r = 0
    while r < pats.length {
        mut ids: List<ExprId> = []
        mut c = 0
        while c < cols.length {
            let at = r * cols.length + c
            if at >= vals.length { break }
            ids.push(st.store.add_expr(Expr.String("\"${cols[c].text}\""), byte_span_none(), []))
            ids.push(vals[at])
            c = c + 1
        }
        let pid = pats[r]
        out.push(MatchArm {
            pattern: st.store.pats.get(pid),
            pattern_id: pid,
            guard_id: none,
            body_id: st.store.add_expr(Expr.MapLit(ids), byte_span_none(), []),
        })
        r = r + 1
    }
    out
}

/// The statement-form match TABLE (t-47hc.29). Node construction is byte-identical to
/// build_match's — `Stmt.Match` with `byte_span_none()` and one PatRef per arm — because
/// the hand's table path ended in the very same `alloc_stmt(node, byte_span_none(),
/// glue_match_arm_refs(arms))`. Only where the ARMS come from differs.
export fn mk_match_table_abi(st: PState, vals: List<CapVal>) -> CapVal {
    let arms = build_table_arms(st, vals[1], vals[2], vals[3])
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.SNode(st.store.add_stmt(Stmt.Match(capval_to_expr(st, vals[0]), arms), byte_span_none(), refs))
}

/// The EXPRESSION twin (t-47hc.29 slice 12). Identical arms — the table desugaring is
/// shared via `build_table_arms`, so the two forms cannot drift; only the node kind and
/// the span differ, exactly as build_match / the expr match differ.
///
/// SPAN: the hand's expression table path ended in `alloc_expr(node, span_from(sp_start),
/// glue_match_arm_refs(arms))`, anchored at the `match` keyword — st.build_sp here, with
/// the `< 0` guard for the interpreter path (which has no sequence-start byte to pass).
/// REFS are the arms' patterns only: the subject is a walker-opaque ExprId scalar and
/// contributes no edge.
export fn mk_match_table_expr_abi(st: PState, vals: List<CapVal>) -> CapVal {
    let arms = build_table_arms(st, vals[1], vals[2], vals[3])
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.Node(st.store.add_expr(
        Expr.MatchExpr(capval_to_expr(st, vals[0]), arms),
        if st.build_sp < 0 { byte_span_none() } else { byte_span(st.build_sp, st.cur().pos) },
        refs
    ))
}

// ── The PATTERN family (t-kd4y.3.2.6) ──────────────────────────────────
// The nine builds `avra_pat_grammar`'s rules name. Each retired central
// pair (executor arm + emit template) was already a thin wrapper over a
// shared core; the cores moved here with them and shed their arena
// plumbing on the way — `capval_pat_val` is the ONE `pats.add_leaf` seam
// now, so a typed fn returns a `Pattern` and nothing else allocates.

/// An integer- or float-literal pattern from a NUMBER token's text. The DSL
/// lexer lexes `42` and `3.14` both as NUMBER (no separate Float token), so a
/// `.` in the text selects `LitFloat` (stored as the string, sign included)
/// vs `LitInt` — the hand parser's Number-vs-Float split exactly.
export fn build_pat_num(text: string, negative: bool) -> Pattern {
    if text.contains(".") {
        let v = if negative { "-" + text } else { text }
        return Pattern.LitFloat(v)
    }
    let n = int(text)
    let iv = if negative { 0 - n } else { n }
    Pattern.LitInt(iv)
}

/// A boolean literal pattern from its token text.
export fn build_pat_bool(text: string) -> Pattern {
    let v = if text == "true" { 1 } else { 0 }
    Pattern.LitBool(v)
}

/// A string literal pattern from the raw (bookend-quoted) token text — stores
/// the unquoted content (render re-quotes).
export fn build_pat_str(raw: string) -> Pattern {
    let content = if raw.length >= 2 { raw.substring(1, raw.length - 1) } else { raw }
    Pattern.LitString(content)
}

/// A bare identifier pattern (no `(binding)`): `_` ⇒ Wildcard, `rest` ⇒ Rest
/// (both contextual), any other bare identifier is not a valid top-level
/// pattern (reported, falls back to Wildcard).
///
/// The HAND's wording, verbatim (t-47hc.5). Its `parse_pattern` accepts only
/// `_` and `rest` bare; every other bare identifier falls through to
/// `consume(Tk.Dot, "expected `.`, `_`, literal, or type pattern to start
/// pattern")`, so that is the message a rejected bare identifier gets —
/// `Status_Gen.Ready` (a qualified enum prefix, which is not pattern syntax)
/// is the shape that shows it. The rule reported its own sentence here, which
/// only became visible when `fn` routed and match arms inside a function body
/// routed natively.
export fn build_ident_pat_bare(st: PState, nm: string) -> Pattern {
    if nm == "_" { return Pattern.Wildcard }
    if nm == "rest" { return Pattern.Rest }
    st.report("expected `.`, `_`, literal, or type pattern to start pattern")
    Pattern.Wildcard
}

/// `l ( "or" r )?` — the right-recursive or-pattern (parse_pattern_or).
/// Absent `or` ⇒ the left pattern PASSED THROUGH unchanged (no new arena row,
/// which is why this adapter returns `vals[0]` rather than rebuilding it);
/// present ⇒ `Pattern.Or(l, r)`, right-associative since `r` is itself a
/// pattern_or.
export fn or_maybe_abi(st: PState, vals: List<CapVal>) -> CapVal {
    if !capval_present(vals[1]) { return vals[0] }
    capval_pat_val(st, Pattern.Or(capval_to_pat(st, vals[0]), capval_to_pat(st, vals[1])))
}

/// A bare identifier pattern, or `name(binding)` ⇒ TypePattern.
export fn ident_pat_abi(st: PState, vals: List<CapVal>) -> CapVal {
    let nm = capval_tok_text(vals[0])
    if !capval_present(vals[1]) { return capval_pat_val(st, build_ident_pat_bare(st, nm)) }
    capval_pat_val(st, Pattern.TypePattern(nm, capval_tok_text(vals[1])))
}

/// `.Name` / `.Name(bind, …)` / `.Name(.Sub, …)`. A sub-pattern payload (first
/// token `.`) ⇒ NestedVariant; a binding payload (identifiers) or none ⇒
/// Variant — mirroring the hand parser's is_pattern_start (`.`-only) branch.
///
/// The branch test is the SUB-LIST's LENGTH, which is what unified the two
/// retired arms: the executor asked `subs != .Nil` and emit asked
/// `subs_list.length > 0`. Those agree because the `subs` alternative binds
/// `subs:variant_pat` unconditionally — a non-Nil capture always carries at
/// least one element — and `capval_to_pat_list` maps `.Nil` to `[]`, so one
/// test now serves both engines.
export fn mk_variant_abi(st: PState, vals: List<CapVal>) -> CapVal {
    let nm = capval_tok_text(vals[0])
    let subs = capval_to_pat_list(vals[2])
    if subs.length > 0 { return capval_pat_val(st, Pattern.NestedVariant(nm, subs)) }
    capval_pat_val(st, Pattern.Variant(nm, param_entries_from_toks(vals[1], ValueType.Int)))
}

export fn pat_bool_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_pat_val(st, build_pat_bool(capval_tok_text(vals[0])))
}
export fn pat_str_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_pat_val(st, build_pat_str(capval_tok_text(vals[0])))
}
export fn pat_num_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_pat_val(st, build_pat_num(capval_tok_text(vals[0]), false))
}
export fn pat_neg_num_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_pat_val(st, build_pat_num(capval_tok_text(vals[0]), true))
}

/// The optional-match arm surface (spec Axis 10.4): `let <name> ->` binds the
/// present value (lowers to `.Some(name)`), `none`/`null ->` matches absence
/// (`.None`). Both delegate to the SHARED core/ast reducers, which are also
/// what typeck and codegen recognise through — never string-match Some/None.
export fn opt_present_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_pat_val(st, pattern_optional_present(capval_tok_text(vals[0])))
}
export fn opt_absent_abi(st: PState, vals: List<CapVal>) -> CapVal {
    capval_pat_val(st, pattern_optional_absent())
}

/// Fold grammar-built when arms into the walker-opaque Expr.When leaf
/// (moved from the engine, t-kd4y.3.5.2 — the MkWhenStmt abi above was
/// already its one importer).
export fn mk_when(st: PState, sp_start: int, arms_cv: CapVal) -> CapVal {
    CapVal.Node(st.store.add_expr(
        Expr.When(capval_to_when_arm_list(arms_cv)),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        []
    ))
}

export fn mk_when_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_when(st, st.build_sp, vals[0])
}

/// The ordinary expression `match` (moved from the engine, t-kd4y.3.5.2).
/// The edge set is EXACTLY the arms' PatRefs — adding the subject, or
/// guard/body, would hand the walker a different child set than the hand
/// parser produced. SPAN: anchors at the `match` keyword, with the
/// interpreter's `sp_start < 0` span-free default.
export fn mk_match_expr(st: PState, sp_start: int, subject_cv: CapVal, arms_cv: CapVal) -> CapVal {
    let arms = capval_to_arm_list(arms_cv)
    mut refs: List<NodeRef> = []
    for arm in arms {
        if arm.pattern_id != null { refs.push(NodeRef.PatRef(arm.pattern_id!)) }
    }
    CapVal.Node(st.store.add_expr(
        Expr.MatchExpr(capval_to_expr(st, subject_cv), arms),
        if sp_start < 0 { byte_span_none() } else { byte_span(sp_start, st.cur().pos) },
        refs
    ))
}

export fn mk_match_expr_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_match_expr(st, st.build_sp, vals[0], vals[1])
}

/// ALL of the match feature's rows — one list per feature. The Mk-named rows
/// keep their grammar-side names (the row name IS the gram ref, so the flip
/// touches no rule text); `spanned` marks the rows whose builds read
/// st.build_sp.
export fn match_builds() -> List<BuilderBind> {
    bind_rows("features.match.lowering", [bind_row("build_when_arm", "warm", 2, false, "build_when_arm_abi", build_when_arm_abi),
     bind_row("build_when_default", "warm", 1, false, "build_when_default_abi", build_when_default_abi),
     bind_row("build_arm", "arm", 3, false, "build_arm_abi", build_arm_abi),
     bind_row("build_match", "stmt", 2, false, "build_match_abi", build_match_abi),
     bind_row("MkWhenStmt", "stmt", 1, true, "mk_when_stmt_abi", mk_when_stmt_abi),
     bind_row("MkArmReturn", "expr", 1, true, "mk_arm_return_abi", mk_arm_return_abi),
     bind_row("MkMatchExpr", "expr", 2, true, "mk_match_expr_abi", mk_match_expr_abi),
     bind_row("MkWhen", "expr", 1, true, "mk_when_abi", mk_when_abi),
     bind_row("MkMatchTable", "stmt", 4, false, "mk_match_table_abi", mk_match_table_abi),
     bind_row("MkMatchTableExpr", "expr", 4, true, "mk_match_table_expr_abi", mk_match_table_expr_abi),
     bind_row("OrMaybe", "pat", 2, false, "or_maybe_abi", or_maybe_abi),
     bind_row("IdentPat", "pat", 2, false, "ident_pat_abi", ident_pat_abi),
     bind_row("MkVariant", "pat", 3, false, "mk_variant_abi", mk_variant_abi),
     bind_row("PatBool", "pat", 1, false, "pat_bool_abi", pat_bool_abi),
     bind_row("PatStr", "pat", 1, false, "pat_str_abi", pat_str_abi),
     bind_row("PatNum", "pat", 1, false, "pat_num_abi", pat_num_abi),
     bind_row("PatNegNum", "pat", 1, false, "pat_neg_num_abi", pat_neg_num_abi),
     bind_row("OptPresent", "pat", 1, false, "opt_present_abi", opt_present_abi),
     bind_row("OptAbsent", "pat", 0, false, "opt_absent_abi", opt_absent_abi)])
}
