// so07.7.4: when matching on a generic enum's variant whose
// subject_ty carries concrete type-args, pattern bindings get
// the substituted concrete type via the enum decl's type-params
// + the subject's type_args.
//
// Two fundamental bugs were uncovered while landing this:
//
//   1. Stmt.Match (statement-position match) was running ONLY
//      exhaustiveness — pattern bindings + arm bodies were never
//      type-checked. The inline arm in typeck/mod.av's check_stmt
//      pre-empted the registered match_check_stmt feature handler
//      that does the full job. The inline arm got removed so the
//      registry dispatch fires.
//
//   2. fmt_stmt was using vtype_display (lossy on List/Tuple
//      generic args) when serialising generic-fn bodies for the
//      metadata fast-path. The Unknown wildcard in
//      assignable_with_unknowns masked the resulting type-coherence
//      breakage. so07.7.3 fixed fmt to use vtype_render_full and
//      removed the wildcard.
//
// With both fixed, W4's substitution is observable: arm bodies type-
// check, and the binding's substituted type is enforced.

use @std.avrac.core.{avra_shell_exec_status, avra_selfhost_read_file}
use @std.avrac.test_runner.{write_fixture}

enum WResult<T, E> {
    Ok(value: T)
    Err(error: E)
}

fn wresult_unwrap_ok(r: WResult<int, int>) -> int {
    match r {
        .Ok(value) -> value + 1
        .Err(_) -> 0
    }
}

fn wresult_unwrap_err(r: WResult<int, int>) -> int {
    match r {
        .Err(error) -> error - 2
        .Ok(_) -> 0
    }
}

spec "pattern binding substitutes generic type-args (so07.7.4)" {
    then "match on Ok(7) binds value as int, runtime arithmetic flows" {
        wresult_unwrap_ok(WResult.Ok(7)) == 8
    }
    then "match on Err(42) binds error as int, runtime arithmetic flows" {
        wresult_unwrap_err(WResult.Err(42)) == 40
    }
    then "binding's substituted type is enforced (F1000) and strict-args sees it (F9004)" {
        // The W4 substitution binds `value` as int from FResult<int, _>.Ok,
        // and `want_str(value)` then trips BOTH checks: the gating arg check
        // rejects int→string (F1000 layout conflict — measured: the check
        // exits non-zero even without strict args), and AVRA_STRICT_ARGS=1
        // additionally surfaces F9004. Without W4 the binding would be
        // Unknown and both checks skip Unknown (still being resolved);
        // without the .Match-dispatch fix the arm body wouldn't be
        // type-checked at all. The old `|| true` capture asserted only
        // F9004 and never noticed the fixture is genuinely REJECTED.
        let fixture = "/tmp/avra_w4_observable_fixture.av"
        let log = "/tmp/avra_w4_observable_fixture.log"
        write_fixture(fixture,
            "enum FResult<T, E> {\n" +
            "    Ok(value: T)\n" +
            "    Err(error: E)\n" +
            "}\n" +
            "fn want_str(s: string) -> string { s }\n" +
            "fn misuse(r: FResult<int, int>) -> string {\n" +
            "    match r {\n" +
            "        .Ok(value) -> want_str(value)\n" +
            "        .Err(_) -> \"\"\n" +
            "    }\n" +
            "}\n" +
            "fn main() -> int { 0 }\n")
        let status = avra_shell_exec_status(
            "AVRA_STRICT_ARGS=1 ./build/bs2 check '${fixture}' > '${log}' 2>&1")
        let out = avra_selfhost_read_file(log)
        status != 0
            && out.contains("`want_str` parameter `s`: `int` is not assignable to `string`")
            && out.contains("F9004")
    }
}
