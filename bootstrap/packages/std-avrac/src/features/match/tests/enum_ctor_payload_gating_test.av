// WHY: pyly — an enum constructor with a wrong-typed payload (e.g.
// `Holder.One(42)` where the field is declared as a struct) MUST be a
// gating compile error. Before this, the mismatch slipped past the type
// checker and corrupted memory at runtime (a 112-byte enum value stored
// where a ptr is expected → SIGSEGV). typeck now checks each ctor
// argument against the variant's declared field type
// (tc_check_enum_ctor_args), skipping fields whose type mentions a type
// param (those bind via inference) and Unknown types.

use @std.avrac.core.{avra_shell_exec_status, avra_selfhost_read_file}
use @std.avrac.test_runner.{write_fixture}

// Built at runtime so the discovery glob doesn't treat embedded fixtures
// (which carry their own entry) as compiled programs.
const MAIN_HEADER: string = "fn " + "main()"

/// Compile the fixture via a child bs2. The exit STATUS pins which path
/// fired (accept vs reject) — a wrong-reason failure can't satisfy the
/// positive cases; the log carries the diagnostics for the WHY asserts.
fn run_compile(source: string) -> int {
    let path = "/tmp/avra_enum_ctor_payload_gating_test.av"
    write_fixture(path, source)
    avra_shell_exec_status("./build/bs2 compile '${path}' > /tmp/avra_enum_ctor_payload_gating_test.log 2>&1")
}
fn compile_log() -> string { avra_selfhost_read_file("/tmp/avra_enum_ctor_payload_gating_test.log") }

spec "pyly: enum-ctor payload type gating" {
    then "wrong concrete payload type is a compile error" {
        let status = run_compile(
            "type Inner = { x: int }
enum Holder { Empty, One(item: Inner) }
fn make_bad() -> Holder { Holder.One(42) }
${MAIN_HEADER} { let h = make_bad() }")
        let out = compile_log()
        status != 0 && out.contains("Holder.One") && out.contains("expects") && out.contains("Inner")
    }
    then "correct payload type compiles cleanly" {
        let status = run_compile(
            "type Inner = { x: int }
enum Holder { Empty, One(item: Inner) }
fn make_ok() -> Holder { Holder.One(Inner { x: 1 }) }
${MAIN_HEADER} { let h = make_ok() }")
        status == 0 && !compile_log().contains("expects")
    }
    then "payload-less variant is unaffected" {
        let status = run_compile(
            "type Inner = { x: int }
enum Holder { Empty, One(item: Inner) }
fn make_empty() -> Holder { Holder.Empty }
${MAIN_HEADER} { let h = make_empty() }")
        status == 0 && !compile_log().contains("expects")
    }
    then "generic field (type param) is not falsely rejected" {
        let status = run_compile(
            "enum GBox<T> { GNone, GSome(value: T) }
fn make_box() -> bool { match GBox.GSome(5) { .GSome(_) -> true, .GNone -> false } }
${MAIN_HEADER} { let b = make_box() }")
        status == 0 && !compile_log().contains("expects")
    }
}
