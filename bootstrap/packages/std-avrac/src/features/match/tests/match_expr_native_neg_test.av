// WHY: t-47hc.25 — the native `match_expr` rule owns its own diagnostics, and diff-test
// CANNOT see them: it compares IR for VALID programs, so the error text of an invalid one
// is outside its oracle entirely. These are the isolate-run negative tests for that gap.
//
// The two messages come from `@require "{"` / `@require "}"` paired with `@expect`, which
// together reproduce what the retired hand parser did with `consume(...) else return .Err`:
// report, then ABORT the rule rather than error-tolerantly building a partial node. Getting
// the report but losing the abort is the specific regression this pins — a `match` with a
// malformed header would otherwise keep consuming and swallow whatever follows it.
//
// The generated parser is the ONLY engine reachable from `bs2 check` (t-bw9s — see the
// note on `no_ice`), so the strong rows pin its SPECIFIC messages and F-code signatures;
// the `no_ice` rows are the crash floor beneath them.
extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

use @std.avrac.features.grammar.{emit_parser_source, avra_expr_dispatch_grammar}

/// The emitted expression-family parser source — where match_expr's own diagnostics live.
fn generated_match_expr_source() -> string { emit_parser_source(avra_expr_dispatch_grammar()) }

fn check_out(env: string, source: string) -> string {
    let path = "/tmp/avra_match_expr_neg.av"
    write_fixture(path, source)
    avra_shell_exec("${env} ./build/bs2 check '${path}' 2>&1")
}

fn dsl(source: string) -> string { check_out("", source) }

// The occurrence-ordered F-code signature — set, order and count together.
fn codes(out: string) -> string {
    mut sig = ""
    for line in out.split("\n") {
        mut i = 0
        while i + 5 <= line.length {
            let c = line.substring(i, i + 5)
            if c.substring(0, 1) == "F" { sig = sig + c + " " }
            i = i + 1
        }
    }
    sig
}

/// t-bw9s — THERE IS NO SECOND ENGINE reachable from `bs2 check`, so no agreement
/// check is possible in this file. Read this before trying to "restore" one.
///
/// The history: these rows pinned `AVRA_PARSER_DECL_FLIP=0`, which died with the
/// declaration hand parser. The obvious repair — pin the EXPRESSION hand instead —
/// was tried and MEASURED, and it never worked: a whole-program compile is driven
/// by the GENERATED declaration parser, which parses expressions with its own
/// generated rules and never calls `Parser.parse_expression`, so the expression
/// flags were never consulted (byte-identical output under every setting, zero
/// `[hand-fallback]` markers). The hand parsers are deleted outright now.
///
/// What this row CAN assert is that the generated parser handled the input WITHOUT
/// an internal compiler error. That is deliberately modest: an arm-less `match`
/// parses clean (measured — zero F-codes), so requiring a diagnostic would be
/// wrong. The strong assertions are the rows pinning a SPECIFIC message or
/// signature; these are the crash floor beneath them.
fn no_ice(source: string) -> bool { !codes(dsl(source)).contains("F9999") }

fn missing_open() -> string {
    "fn f(n: int) -> int {\n    let v = match n\n        0 -> 1\n        _ -> 2\n    }\n    return v\n}"
}

fn missing_close() -> string {
    "fn f(n: int) -> int {\n    let v = match n {\n        0 -> 1\n        _ -> 2\n    return v\n}"
}

spec "t-47hc.25: the native match expression reports its own brace diagnostics" {
    then "a missing `{` after the subject names the subject" {
        dsl(missing_open()).contains("expected `{` after match subject")
    }
    then "a missing `}` after the arms names the arms" {
        // Directly observable: the generated parser IS the production engine,
        // so `bs2 check` renders this rule's own message (measured).
        dsl(missing_close()).contains("expected `}` after match arms")
    }
    then "both are REJECTED, not recovered into a silent partial parse" {
        !dsl(missing_open()).contains("\nok") && !dsl(missing_close()).contains("\nok")
    }
    then "the generated parser carries BOTH brace diagnostics and aborts on each" {
        // Structural complement to the message rows above: rendered output cannot
        // show that the emitted parser reports and then RETURNS rather than
        // error-tolerantly building a partial node — the `@require` abort that
        // stops a malformed header from running away and swallowing what follows.
        // Pin the abort shape in the emitted source itself.
        let gen = generated_match_expr_source()
        gen.contains("expected `{` after match subject") &&
            gen.contains("expected `}` after match arms") &&
            gen.contains("return CapVal.Node(st.error_node_silent())")
    }
}

spec "t-47hc.25: invalid match expressions never ICE the generated parser" {
    then "missing `{` is handled without an ICE" { no_ice(missing_open()) }
    then "missing `}` is handled without an ICE" { no_ice(missing_close()) }
    then "a malformed ARM is handled without an ICE (the arm loop's own failure path)" {
        no_ice("fn f(n: int) -> int {\n    let v = match n {\n        0 -> \n        _ -> 2\n    }\n    return v\n}")
    }
    then "and a match with NO arms at all is handled without an ICE" {
        no_ice("fn f(n: int) -> int {\n    let v = match n {\n    }\n    return v\n}")
    }
}

spec "t-47hc.25: valid match expressions still parse clean" {
    then "ordinary subject form" {
        dsl("fn f(n: int) -> int {\n    let v = match n {\n        0 -> 1\n        _ -> 2\n    }\n    return v\n}").contains("ok")
    }
    then "subjectless form in expression position" {
        dsl("fn f(n: int) -> int {\n    let v = match {\n        n > 0 -> 1\n        _ -> 0\n    }\n    return v\n}").contains("ok")
    }
    then "a guard on an arm" {
        dsl("fn f(n: int) -> int {\n    let v = match n {\n        x if x > 3 -> 1\n        _ -> 2\n    }\n    return v\n}").contains("ok")
    }
}
