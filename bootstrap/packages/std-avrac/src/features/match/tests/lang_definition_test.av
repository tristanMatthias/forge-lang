// The match/when LanguageFeature definitions (features/match.av). The load-
// bearing pin: feature_grammar_fragments now folds OUT of the definitions,
// and the composed result must still carry the pattern + arm rule sets the
// hand-maintained list used to name. Also guards the instance-block `name`
// override (the binding can't be the keyword `match`).
use @std.avrac.features.match.{match_lang, when_lang}
use @std.avrac.features.{feature_grammar_fragments, feature_keywords}
use @std.avrac.features.grammar.{compose_fragments, rule_index_of}
use @std.avrac.list_ops.{list_contains_str}

spec "match as a LanguageFeature" {
    then "the definition carries name, docs, and its owned diagnostic" {
        let m = match_lang()
        m.name == "match" && m.docs.contains("EXHAUSTIVE")
            && m.diags.length == 1 && m.diags[0].code == "F9001"
    }
    then "when carries its surface and owns no rules of its own" {
        let w = when_lang()
        w.name == "match_when" && w.snippet.contains("when") && w.gram.grammar.rules.length == 0
    }
    then "the DEFINITION's gram DEFINES the pattern + arm rules (by rule index, not rendered text)" {
        // Batch A: the registry fold is composition-owned only, and match's
        // multi-family set rides the explicit stmt_family_fragments wiring —
        // so the ownership claim is asserted on the definition's OWN gram,
        // which is exactly what the no-orphans validator reads.
        let g = match_lang().gram.grammar
        rule_index_of(g, "pattern_or") >= 0 && rule_index_of(g, "match_arm") >= 0
            && rule_index_of(g, "match_when_arm") >= 0 && rule_index_of(g, "variant_pat") >= 0
    }
    then "keywords derive from the owned rules" {
        let kws = feature_keywords(match_lang())
        list_contains_str(kws, "or") && list_contains_str(kws, "if") && list_contains_str(kws, "return")
    }
}
