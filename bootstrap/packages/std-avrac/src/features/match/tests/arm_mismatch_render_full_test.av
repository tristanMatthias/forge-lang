// Continuation of the vtype_render_full sweep. The "match expression
// arms have different types" diagnostic at typeck.av:468 used to
// render both halves with `vtype_display`, so a tuple-vs-tuple
// mismatch printed `(tuple)` vs `(tuple)` — same trap that pry2's
// return-check exposed for explicit returns.

use @std.avrac.test_runner.{write_fixture}
use @std.avrac.core.{avra_shell_exec_status, avra_selfhost_read_file}

spec "match-arm type mismatch shows full element types" {
    then "(int, int) vs (string, string) — not bare `(tuple)`" {
        let fixture = "/tmp/avra_match_arm_mismatch_test.av"
        let log = "/tmp/avra_match_arm_mismatch_test.log"
        write_fixture(fixture,
            "fn main() -> int {\n" +
            "    let pair = match 1 {\n" +
            "        1 -> (1, 2)\n" +
            "        _ -> (\"a\", \"b\")\n" +
            "    }\n" +
            "    0\n" +
            "}\n")
        let status = avra_shell_exec_status("./build/bs2 check '${fixture}' > '${log}' 2>&1")
        let out = avra_selfhost_read_file(log)
        // The mismatch must actually REJECT (status pins the gating path),
        // and the rendering must carry the element types: pre-fix this read
        // `(tuple)` vs `(tuple)`.
        status != 0
            && out.contains("(int, int)") && out.contains("(string, string)")
            && !out.contains("`(tuple)` vs `(tuple)`")
    }
}
