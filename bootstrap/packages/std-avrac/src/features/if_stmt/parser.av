// WHY: parses `if` as both a statement and an expression form, plus the
// bind-fresh `if let v = x { … } else { … }` sugar (spec Axis 10.4), in
// BOTH positions. It desugars to an ordinary `if x != none` over a fresh
// temp, so the subject is evaluated once and `v` is a fresh immutable
// binding nothing can invalidate (the sound Rust/Zig model) — no new AST,
// no codegen.

use core.{Stmt, Expr, BinOp, ValueType, SStmt, sstmt_dummy, expr_force_unwrap, FORCE_UNWRAP_FN, NodeRef, ExprId, StmtId, byte_span_none}
use list_ops.{list_concat}
use parse.{Parser}
use diagnostics.{DiagCode}
use core.{Tk}


// The shared `if let <binding> = <subject>` prefix, in both positions:
// mint the once-evaluated temp, consume the binding and `=`, parse the
// subject with struct-literals disabled, and require the `{` that starts
// the then-block. `subject_id` is the subject's arena row.
type IfLetHeader = { tmp: string, binding: string, subject_id: ExprId }

impl Parser {

    fn parse_if_statement(self) -> Result<StmtId, string> {
        self.advance()
        // Bind-fresh `if let v = x { … }`: `let` right after `if`.
        if self.check(Tk.KwLet) { return self.parse_if_let_statement() }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let condition_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let cond_id = condition_opt?

        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after if condition")
            return .Err("parse error")
        }

        let then_id = self.parse_statement()?

        if self.check(Tk.KwElse) {
            self.advance()
            let else_id = self.parse_statement()?
            return .Ok(self.alloc_stmt_leaf(Stmt.If(cond_id, then_id, else_id)))
        }

        .Ok(self.alloc_stmt_leaf(Stmt.If(cond_id, then_id, none)))
    }

    // `if let v = x { THEN } else { ELSE }` desugars to
    //   { let __t = x;  if __t != none { let v = __t!;  THEN } else { ELSE } }
    // The temp evaluates the subject exactly once; `v` is a fresh immutable
    // binding of the unwrapped value (the force-unwrap is only reached when
    // present, so it never traps). Block-scoped so the temp never leaks.
    // Sound for let/mut/param uniformly — there is no narrowed mutable to
    // invalidate. `if` already consumed by the caller; `let` is current.
    fn parse_if_let_header(self) -> Result<IfLetHeader, string> {
        let tmp = self.fresh("iflet")
        self.advance()
        let binding = self.consume_identifier("expected a binding name after `if let`")?
        if !self.consume(Tk.Equal, "expected `=` after the `if let` binding") { return .Err("parse error") }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let subject_id = subject_opt?
        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after the `if let` binding")
            return .Err("parse error")
        }
        .Ok(IfLetHeader { tmp: tmp, binding: binding, subject_id: subject_id })
    }

    fn parse_if_let_statement(self) -> Result<StmtId, string> {
        let h = self.parse_if_let_header()?
        let then_id = self.parse_statement()?
        mut else_opt: StmtId? = none
        if self.check(Tk.KwElse) {
            self.advance()
            else_opt = self.parse_statement()?
        }
        let bind_id = self.iflet_bind_row(h.tmp, h.binding)
        // Prepend the unwrap-bind to the then-block: a parsed then-Block's
        // row list is reused verbatim; any other stmt shape wraps as the
        // block's second row.
        let new_then = match self.stmt_of(then_id) {
            .Block(body) -> Stmt.Block(self.iflet_prepend(bind_id, body))
            _ -> {
                let two: List<StmtId> = [bind_id, then_id]
                Stmt.Block(two)
            }
        }
        let new_then_id = self.alloc_stmt_leaf(new_then)
        let cond_id = self.iflet_cond_row(h.tmp)
        let inner_if_id = self.alloc_stmt_leaf(Stmt.If(cond_id, new_then_id, else_opt))
        let outer_let_id = self.alloc_binding_stmt(Stmt.Let(h.tmp, ValueType.Unknown, h.subject_id), ValueType.Unknown)
        let outer: List<StmtId> = [outer_let_id, inner_if_id]
        .Ok(self.alloc_stmt_leaf(Stmt.Block(outer)))
    }

    // Expression-position `if let v = x { THEN } else { ELSE }`. Same
    // bind-fresh desugar as the statement form, but lowered to a block
    // EXPRESSION whose value is the inner `if`-expression:
    //   { let __t = x;  if __t != none { let v = __t!;  THEN } else { ELSE } }
    // `if` already consumed by `parse_if_expression`; `let` is current.
    fn parse_if_let_expression(self) -> Result<ExprId, string> {
        let h = self.parse_if_let_header()?
        let then_id = self.parse_block_expression()?
        let then_expr = self.expr_of(then_id)
        // Else mirrors `parse_if_expression`: block / `else if` / bare expr;
        // a missing else yields the same `0` default a plain if-expr uses
        // (a real child row, exactly as the canonical ingest records it).
        mut else_id = ExprId(0)
        mut has_else = false
        if self.check(Tk.KwElse) {
            self.advance()
            if self.check(Tk.KwIf) {
                else_id = self.parse_if_expression()?
            } else if self.check(Tk.LeftBrace) {
                else_id = self.parse_block_expression()?
            } else {
                else_id = self.parse_expression()?
            }
            has_else = true
        }
        if !has_else { else_id = self.alloc_leaf(Expr.Number("0")) }
        let bind_id = self.iflet_bind_row(h.tmp, h.binding)
        // Prepend the unwrap-bind to the then-block. Flipped Expr.Block holds
        // List<StmtId> (walker-opaque leaf) — the rows ARE the structure, so
        // a parsed then-Block's rows are reused verbatim.
        let new_then = match then_expr {
            .Block(body) -> Expr.Block(list_concat([bind_id], body))
            _ -> {
                let then_stmt_id = self.alloc_stmt_leaf(Stmt.Expr(then_id))
                Expr.Block([bind_id, then_stmt_id])
            }
        }
        let new_then_id = self.alloc_leaf(new_then)
        let cond_id = self.iflet_cond_row(h.tmp)
        let inner_if = Expr.IfExpr(cond_id, new_then_id, else_id)
        let inner_if_id = self.alloc_leaf(inner_if)
        let outer_let_id = self.alloc_binding_stmt(Stmt.Let(h.tmp, ValueType.Unknown, h.subject_id), ValueType.Unknown)
        let inner_if_stmt_id = self.alloc_stmt_leaf(Stmt.Expr(inner_if_id))
        let outer: List<StmtId> = [outer_let_id, inner_if_stmt_id]
        .Ok(self.alloc_leaf(Expr.Block(outer)))
    }

    // The `let <binding> = __tmp!` row shared by both if-let desugars:
    // the present value, force-unwrapped (only reached on the present
    // branch). The unwrap-call subtree is [callee, subject] — Call walker
    // order — under the Let row.
    fn iflet_bind_row(self, tmp: string, binding: string) -> StmtId {
        let unwrap_id = self.alloc_force_unwrap_row(tmp)
        self.alloc_binding_stmt(Stmt.Let(binding, ValueType.Unknown, unwrap_id), ValueType.Unknown)
    }

    // Row twin of the `__tmp != none` condition.
    fn iflet_cond_row(self, tmp: string) -> ExprId {
        self.alloc_none_check_row(tmp, BinOp.Ne)
    }

    // Prepend the unwrap-bind row to a then-block's row list.
    fn iflet_prepend(self, bind: StmtId, body: List<StmtId>) -> List<StmtId> {
        let head: List<StmtId> = [bind]
        list_concat(head, body)
    }

    fn parse_if_expression(self) -> Result<ExprId, string> {
        self.advance()
        // Bind-fresh `if let v = x { … } else { … }` in expression position.
        if self.check(Tk.KwLet) {
            return self.parse_if_let_expression()
        }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let condition_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let condition = condition_opt?
        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after if condition")
            return .Err("parse error")
        }
        let then_id = self.parse_block_expression()?
        if !self.check(Tk.KwElse) {
            // The synthesized `0` else-arm is a real child row, exactly as
            // the canonical ingest would record it.
            let zero_id = self.alloc_leaf(Expr.Number("0"))
            return .Ok(self.alloc_leaf(Expr.IfExpr(condition, then_id, zero_id)))
        }
        self.advance()
        // Else can be either a block, another if-expression
        // (`else if`), or a single expression.
        if self.check(Tk.KwIf) {
            let else_id = self.parse_if_expression()?
            return .Ok(self.alloc_leaf(Expr.IfExpr(condition, then_id, else_id)))
        }
        if self.check(Tk.LeftBrace) {
            let else_id = self.parse_block_expression()?
            return .Ok(self.alloc_leaf(Expr.IfExpr(condition, then_id, else_id)))
        }
        let else_id = self.parse_expression()?
        .Ok(self.alloc_leaf(Expr.IfExpr(condition, then_id, else_id)))
    }
}
