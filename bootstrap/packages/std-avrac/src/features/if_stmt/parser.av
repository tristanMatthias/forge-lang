// WHY: parses `if` as both a statement and an expression form, plus the
// bind-fresh `if let v = x { … } else { … }` sugar (spec Axis 10.4). It
// desugars to an ordinary `if x != none` over a fresh temp, so the
// subject is evaluated once and `v` is a fresh immutable binding nothing
// can invalidate (the sound Rust/Zig model) — no new AST, no codegen.

use core.{Stmt, Expr, BinOp, ValueType, SExpr, SStmt, sexpr_dummy, sstmt_dummy}
use parse.{Parser}
use diagnostics.{DiagCode}
use core.{Tk}

impl Parser {
    fn parse_if_statement(self) -> Result<Stmt, string> {
        self.advance()
        // Bind-fresh `if let v = x { … }`: `let` right after `if`.
        if self.check(Tk.KwLet) { return self.parse_if_let_statement() }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let condition_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let condition = condition_opt?

        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after if condition")
            return .Err("parse error")
        }

        let then_branch = self.parse_statement()?

        if self.check(Tk.KwElse) {
            self.advance()
            let else_branch = self.parse_statement()?
            return .Ok(Stmt.If(condition, then_branch, else_branch))
        }

        .Ok(Stmt.If(condition, then_branch, none))
    }

    // `if let v = x { THEN } else { ELSE }` desugars to
    //   { let __t = x;  if __t != none { let v = __t!;  THEN } else { ELSE } }
    // The temp evaluates the subject exactly once; `v` is a fresh immutable
    // binding of the unwrapped value (the force-unwrap is only reached when
    // present, so it never traps). Block-scoped so the temp never leaks.
    // Sound for let/mut/param uniformly — there is no narrowed mutable to
    // invalidate. `if` already consumed by the caller; `let` is current.
    fn parse_if_let_statement(self) -> Result<Stmt, string> {
        let tmp = self.fresh("iflet")
        self.advance()
        let binding = self.consume_identifier("expected a binding name after `if let`")?
        if !self.consume(Tk.Equal, "expected `=` after the `if let` binding") { return .Err("parse error") }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let subject = subject_opt?
        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after the `if let` binding")
            return .Err("parse error")
        }
        let then_branch = self.parse_statement()?
        mut else_branch: Stmt? = none
        if self.check(Tk.KwElse) {
            self.advance()
            else_branch = self.parse_statement()?
        }
        // let <binding> = __tmp!
        let fu_args: List<SExpr> = [sexpr_dummy(Expr.Ident(tmp))]
        let unwrap = Expr.Call(Expr.Ident("__avra_force_unwrap"), fu_args)
        let bind_stmt = sstmt_dummy(Stmt.Let(binding, ValueType.Unknown, unwrap))
        // Prepend the unwrap-bind to the then-block.
        let new_then = match then_branch {
            .Block(body) -> {
                mut nb: List<SStmt> = [bind_stmt]
                mut i = 0
                while i < body.length {
                    nb.push(body[i])
                    i = i + 1
                }
                Stmt.Block(nb)
            }
            _ -> {
                let one: List<SStmt> = [bind_stmt, sstmt_dummy(then_branch)]
                Stmt.Block(one)
            }
        }
        let cond = Expr.Binary(Expr.Ident(tmp), BinOp.Ne, Expr.None)
        let inner_if = Stmt.If(cond, new_then, else_branch)
        let outer: List<SStmt> = [sstmt_dummy(Stmt.Let(tmp, ValueType.Unknown, subject)), sstmt_dummy(inner_if)]
        .Ok(Stmt.Block(outer))
    }

    fn parse_if_expression(self) -> Result<Expr, string> {
        self.advance()
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let condition_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let condition = condition_opt?
        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after if condition")
            return .Err("parse error")
        }
        let then_branch = self.parse_block_expression()?
        if !self.check(Tk.KwElse) {
            return .Ok(Expr.IfExpr(condition, then_branch, Expr.Number("0")))
        }
        self.advance()
        // Else can be either a block, another if-expression
        // (`else if`), or a single expression.
        if self.check(Tk.KwIf) {
            let else_branch = self.parse_if_expression()?
            return .Ok(Expr.IfExpr(condition, then_branch, else_branch))
        }
        if self.check(Tk.LeftBrace) {
            let else_branch = self.parse_block_expression()?
            return .Ok(Expr.IfExpr(condition, then_branch, else_branch))
        }
        let else_branch = self.parse_expression()?
        .Ok(Expr.IfExpr(condition, then_branch, else_branch))
    }
}
