// dir-as-module (g2eo.1): parser.av + codegen.av auto-load as siblings,
// surface flat at `features.if_stmt.{...}`. emit_if + emit_if_expr are
// in scope without a self-import.
use core.{ValueType, vtype_display, vtype_eq, vtype_is_unknown}
use codegen.{err_emit, err_stmt, StmtResult}
use codegen.{err_sr}
use features.eval.{error_result, is_truthy, ok_result, value_null, step_had_error, step_value, step_runtime}
use features.eval.{eval_expr, execute_stmt}
use core.{feature_new, Feature}
use resolve.{resolve_expr, resolve_stmt}
use typeck.{check_expr, check_stmt, tc_er, tc_report, narrow_guard_of, tc_narrow_true_branch, tc_narrow_false_branch, tc_narrow_after_if}

/// Register the `if` feature for both statement (`if cond { ... }`)
/// and expression (`let x = if cond a else b`) positions. Wires
/// up resolver, type-checker, codegen, and eval hooks for each.
export fn if_stmt_feature() -> Feature {
    feature_new("if") with {
        expr_tag: Expr.IfExpr(Expr.None, Expr.None, Expr.None),
        stmt_tag: Stmt.If(Expr.None, Stmt.NoOp, null),
        emit_expr: if_emit_expr,
        emit_stmt: if_emit_stmt,
        resolve_stmt: if_resolve_stmt,
        resolve_expr: if_resolve_expr,
        check_stmt: if_check_stmt,
        check_expr: if_check_expr,
        eval_stmt: if_eval_stmt,
        eval_expr: if_eval_expr,
        stmt_keyword: "kw_if",
        parse_stmt: (p: Parser) -> p.parse_if_statement(),
    }
}

/// Resolver hook for `IfExpr`. Walks condition + both branches.
fn if_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .IfExpr(c, t, e) -> {
            let after_c = resolve_expr(r, c)
            let after_t = resolve_expr(after_c, t)
            resolve_expr(after_t, e)
        }
        _ -> r
    }
}

/// Tree-walk evaluator hook for `IfExpr`. Evaluates the condition
/// and returns the value of whichever branch the truthiness picks.
/// Branches are Exprs (not Stmts), so the recursion stays in
/// `eval_expr` — important for `@comptime` macros that use
/// `if cond { a } else { b }` to choose between AST fragments.
fn if_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .IfExpr(condition, then_branch, else_branch) -> {
            let cond_result = eval_expr(rt, condition)
            if step_had_error(cond_result) {
                return cond_result
            }
            if is_truthy(step_value(cond_result)) {
                eval_expr(step_runtime(cond_result), then_branch)
            } else {
                eval_expr(step_runtime(cond_result), else_branch)
            }
        }
        _ -> error_result(rt, "expected IfExpr")
    }
}

/// Codegen hook for `IfExpr`. Forwards to `emit_if_expr` which
/// emits both branches into a result-slot phi.
fn if_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .IfExpr(condition, then_branch, else_branch) -> emit_if_expr(ctx, env, condition, then_branch, else_branch)
        _ -> err_emit("expected IfExpr")
    }
}

/// Codegen hook for `If` statements. Forwards to `emit_if`
/// which emits both branches into named basic blocks.
fn if_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .If(condition, then_branch, else_branch) -> emit_if(ctx, env, condition, then_branch, else_branch)
        _ -> err_sr("expected If")
    }
}

/// Resolver hook for `If` statements. Walks condition, then-branch,
/// then else-branch (if present).
fn if_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .If(condition, then_branch, else_branch) -> {
            let after_cond = resolve_expr(r, condition)
            let after_then = resolve_stmt(after_cond, then_branch)
            if else_branch != null {
                return resolve_stmt(after_then, else_branch!)
            }
            after_then
        }
        _ -> r
    }
}

/// Type-check hook for `If` statements. Condition must be Bool
/// (Int accepted for compat). Applies optional flow-narrowing: an
/// `x != none` / `x == none` guard retypes `x` from `T?` to `T`
/// inside the proven-present branch, and — when the none-side
/// diverges — in the continuation after the `if` (the
/// `if x == none { return … }` idiom). Branch-local narrowing is
/// scoped by resetting the env to the pre-narrow baseline before the
/// else / continuation, keeping accumulated diagnostics. (Permissive
/// variable-narrowing — see the `tc_narrow_present` block in typeck
/// for the soundness caveat; statements produce no value, so no
/// type-merging is needed.)
fn if_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .If(cond, then_branch, else_branch) -> {
            let c = check_expr(tc, cond)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "if condition must be `bool`, got `${vtype_display(c.ty)}`")
            } else { c.tc }
            let guard = narrow_guard_of(cond)
            let baseline = after_cond.types

            let after_then = check_stmt(tc_narrow_true_branch(after_cond, guard), then_branch)
            // Drop the branch-local narrowing (reset env to baseline)
            // while preserving the diagnostics gathered so far.
            let post_then = after_then with { types: baseline }

            if else_branch != null {
                let after_else = check_stmt(tc_narrow_false_branch(post_then, guard), else_branch!)
                let post_else = after_else with { types: baseline }
                return tc_narrow_after_if(post_else, guard, then_branch, else_branch)
            }
            tc_narrow_after_if(post_then, guard, then_branch, else_branch)
        }
        _ -> tc
    }
}

/// Type-check hook for `IfExpr`. Both branches must agree on a
/// type, otherwise the result is widened to a `Union<Then, Else>`
/// so callers can disambiguate via `match`. Void branches are
/// treated as "doesn't constrain", matching expectation that an
/// expression-position if can degrade to an effect-only expression.
fn if_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .IfExpr(cond, then_branch, else_branch) -> {
            let c = check_expr(tc, cond)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "if condition must be `bool`, got `${vtype_display(c.ty)}`")
            } else { c.tc }
            // Optional flow-narrowing: retype the
            // guard variable to its present `T` inside whichever arm
            // proves presence. An if-expr has no continuation, so the
            // env is reset to the pre-narrow baseline after each arm —
            // narrowing must not leak out of the branch it was proven in.
            let guard = narrow_guard_of(cond)
            let baseline = after_cond.types
            let t = check_expr(tc_narrow_true_branch(after_cond, guard), then_branch)
            let else_base = t.tc with { types: baseline }
            let e = check_expr(tc_narrow_false_branch(else_base, guard), else_branch)
            let after = e.tc with { types: baseline }
            if !vtype_eq(t.ty, e.ty) && !vtype_is_unknown(t.ty) && !vtype_is_unknown(e.ty) && !vtype_eq(t.ty, .Void) && !vtype_eq(e.ty, .Void) {
                // Both branches have concrete different types — result is a union
                mut union_members: List<ValueType> = []
                union_members.push(t.ty)
                union_members.push(e.ty)
                let union_ty = ValueType.Union(union_members)
                return tc_er(after, union_ty)
            }
            tc_er(after, t.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Tree-walk evaluator hook for `If` statements. Evaluates the
/// condition, then dispatches to the matching branch (or returns
/// null when no else-branch exists).
fn if_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .If(condition, then_branch, else_branch) -> {
            let cond_result = eval_expr(rt, condition)
            if step_had_error(cond_result) {
                return cond_result
            }
            if is_truthy(step_value(cond_result)) {
                return execute_stmt(step_runtime(cond_result), then_branch)
            }
            if else_branch != null {
                return execute_stmt(step_runtime(cond_result), else_branch!)
            }
            ok_result(step_runtime(cond_result), value_null())
        }
        _ -> error_result(rt, "expected If")
    }
}
