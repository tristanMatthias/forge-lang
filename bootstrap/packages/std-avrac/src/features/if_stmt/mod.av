// dir-as-module (g2eo.1): parser.av + codegen.av auto-load as siblings,
// surface flat at `features.if_stmt.{...}`. emit_if + emit_if_expr are
// in scope without a self-import.
use core.{Stmt, ValueType, vtype_display, vtype_eq, vtype_is_unknown}
use codegen.{err_emit, err_stmt, StmtResult}
use codegen.{err_sr}
use features.eval.{error_result, is_truthy, ok_result, value_null, step_had_error, step_value, step_runtime}
use features.eval.{eval_expr, execute_stmt}
use core.{feature_new, Feature}
use resolve.{resolve_expr, resolve_stmt}
use typeck.{check_expr, check_stmt, tc_er, tc_report, narrow_guard_of, tc_narrow_true_branch, tc_narrow_false_branch, tc_narrow_after_if}

/// Register the `if` feature for both statement (`if cond { ... }`)
/// and expression (`let x = if cond a else b`) positions. Wires
/// up resolver, type-checker, codegen, and eval hooks for each.
export fn if_stmt_feature() -> Feature {
    feature_new("if") with {
        expr_tag: Expr.IfExpr(ExprId(0), ExprId(0), ExprId(0)),
        stmt_tag: Stmt.If(ExprId(0), StmtId(0), null),
        emit_expr: if_emit_expr,
        emit_stmt: if_emit_stmt,
        resolve_stmt: if_resolve_stmt,
        resolve_expr: if_resolve_expr,
        check_stmt: if_check_stmt,
        check_expr: if_check_expr,
        eval_stmt: if_eval_stmt,
        eval_expr: if_eval_expr,
        stmt_keyword: "kw_if",
        parse_stmt: (p: Parser) -> p.parse_if_statement(),
    }
}

/// Resolver hook for `IfExpr`. Walks condition + both branches.
fn if_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .IfExpr(c, t, e) -> {
            let after_c = resolve_expr(r, r.nodes.exprs.get(c))
            let after_t = resolve_expr(after_c, r.nodes.exprs.get(t))
            resolve_expr(after_t, r.nodes.exprs.get(e))
        }
        _ -> r
    }
}

/// Tree-walk evaluator hook for `IfExpr`. Evaluates the condition
/// and returns the value of whichever branch the truthiness picks.
/// Branches are Exprs (not Stmts), so the recursion stays in
/// `eval_expr` — important for `@comptime` macros that use
/// `if cond { a } else { b }` to choose between AST fragments.
fn if_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .IfExpr(condition, then_branch, else_branch) -> {
            let cond_result = eval_expr(rt, rt.nodes.exprs.get(condition))
            if step_had_error(cond_result) {
                return cond_result
            }
            if is_truthy(step_value(cond_result)) {
                eval_expr(step_runtime(cond_result), rt.nodes.exprs.get(then_branch))
            } else {
                eval_expr(step_runtime(cond_result), rt.nodes.exprs.get(else_branch))
            }
        }
        _ -> error_result(rt, "expected IfExpr")
    }
}

/// Codegen hook for `IfExpr`. Forwards to `emit_if_expr` which
/// emits both branches into a result-slot phi.
fn if_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .IfExpr(condition, then_branch, else_branch) -> emit_if_expr(ctx, env, ctx.nodes.exprs.get(condition), ctx.nodes.exprs.get(then_branch), ctx.nodes.exprs.get(else_branch))
        _ -> err_emit("expected IfExpr")
    }
}

/// Codegen hook for `If` statements. Forwards to `emit_if`
/// which emits both branches into named basic blocks.
fn if_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .If(condition, then_branch, else_branch) -> {
            let else_s: Stmt? = if else_branch != null { ctx.nodes.stmts.get(else_branch!) } else { null }
            emit_if(ctx, env, ctx.nodes.exprs.get(condition), ctx.nodes.stmts.get(then_branch), else_s)
        }
        _ -> err_sr("expected If")
    }
}

/// Resolver hook for `If` statements. Walks condition, then-branch,
/// then else-branch (if present).
fn if_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .If(condition, then_branch, else_branch) -> {
            let after_cond = resolve_expr(r, r.nodes.exprs.get(condition))
            let after_then = resolve_stmt(after_cond, r.nodes.stmts.get(then_branch))
            if else_branch != null {
                return resolve_stmt(after_then, r.nodes.stmts.get(else_branch!))
            }
            after_then
        }
        _ -> r
    }
}

/// Type-check hook for `If` statements. Condition must be Bool
/// (Int accepted for compat). Applies optional flow-narrowing: an
/// `x != none` / `x == none` guard retypes `x` from `T?` to `T`
/// inside the proven-present branch, and — when the none-side
/// diverges — in the continuation after the `if` (the
/// `if x == none { return … }` idiom). Branch-local narrowing is
/// scoped by resetting the env to the pre-narrow baseline before the
/// else / continuation, keeping accumulated diagnostics. (Permissive
/// variable-narrowing — see the `tc_narrow_present` block in typeck
/// for the soundness caveat; statements produce no value, so no
/// type-merging is needed.)
fn if_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .If(cond_id, then_id, else_id) -> {
            let cond = tc.nodes.exprs.get(cond_id)
            let then_branch = tc.nodes.stmts.get(then_id)
            let else_branch: Stmt? = if else_id != null { tc.nodes.stmts.get(else_id!) } else { null }
            let c = check_expr(tc, cond)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "if condition must be `bool`, got `${vtype_display(c.ty)}`")
            } else { c.tc }
            let guard = narrow_guard_of(cond)
            // Fast path: no `none`-guard (the common case) → check the
            // branches directly, with no env reconstruction.
            if guard.var == "" {
                let after_then = check_stmt(after_cond, then_branch)
                if else_branch != null { return check_stmt(after_then, else_branch!) }
                return after_then
            }
            // Narrowing path: retype the guard var per branch, dropping
            // the branch-local narrowing (reset env to `baseline`) before
            // the else / continuation while keeping accumulated diagnostics.
            let baseline = after_cond.types
            let after_then = check_stmt(tc_narrow_true_branch(after_cond, guard), then_branch)
            let post_then = after_then with { types: baseline }
            if else_branch != null {
                let after_else = check_stmt(tc_narrow_false_branch(post_then, guard), else_branch!)
                return tc_narrow_after_if(after_else with { types: baseline }, guard, then_branch, else_branch)
            }
            tc_narrow_after_if(post_then, guard, then_branch, else_branch)
        }
        _ -> tc
    }
}

/// Result type of an if-expression: a `Union<Then, Else>` when both
/// branches have concrete, differing types so callers can disambiguate
/// via `match`; otherwise the then-type (`Void`/`Unknown` branches
/// don't constrain — an expression-position `if` may degrade to an
/// effect-only expression).
fn if_expr_result_type(then_ty: ValueType, else_ty: ValueType) -> ValueType {
    if !vtype_eq(then_ty, else_ty) && !vtype_is_unknown(then_ty) && !vtype_is_unknown(else_ty) && !vtype_eq(then_ty, .Void) && !vtype_eq(else_ty, .Void) {
        mut members: List<ValueType> = []
        members.push(then_ty)
        members.push(else_ty)
        return ValueType.Union(members)
    }
    then_ty
}

/// Type-check hook for `IfExpr`. The result type is computed by
/// `if_expr_result_type` (a `Union` when the branches concretely
/// differ). Applies the same optional flow-narrowing as `if_check_stmt`
/// per arm, minus the continuation (an if-expr has none); the env is
/// reset to the pre-narrow baseline after each arm so narrowing never
/// leaks out of the branch it was proven in.
fn if_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .IfExpr(cond, then_branch, else_branch) -> {
            let cond_e = tc.nodes.exprs.get(cond)
            let then_e = tc.nodes.exprs.get(then_branch)
            let else_e = tc.nodes.exprs.get(else_branch)
            let c = check_expr(tc, cond_e)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "if condition must be `bool`, got `${vtype_display(c.ty)}`")
            } else { c.tc }
            let guard = narrow_guard_of(cond_e)
            // Fast path: no `none`-guard → check both arms directly, no
            // env reconstruction.
            if guard.var == "" {
                let t = check_expr(after_cond, then_e)
                let e = check_expr(t.tc, else_e)
                return tc_er(e.tc, if_expr_result_type(t.ty, e.ty))
            }
            // Narrowing path: narrow the present arm, resetting the env
            // to `baseline` after each so narrowing stays branch-local.
            let baseline = after_cond.types
            let t = check_expr(tc_narrow_true_branch(after_cond, guard), then_e)
            let e = check_expr(tc_narrow_false_branch(t.tc with { types: baseline }, guard), else_e)
            tc_er(e.tc with { types: baseline }, if_expr_result_type(t.ty, e.ty))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Tree-walk evaluator hook for `If` statements. Evaluates the
/// condition, then dispatches to the matching branch (or returns
/// null when no else-branch exists).
fn if_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .If(condition, then_branch, else_branch) -> {
            let cond_result = eval_expr(rt, rt.nodes.exprs.get(condition))
            if step_had_error(cond_result) {
                return cond_result
            }
            if is_truthy(step_value(cond_result)) {
                return execute_stmt(step_runtime(cond_result), rt.nodes.stmts.get(then_branch))
            }
            if else_branch != null {
                return execute_stmt(step_runtime(cond_result), rt.nodes.stmts.get(else_branch!))
            }
            ok_result(step_runtime(cond_result), value_null())
        }
        _ -> error_result(rt, "expected If")
    }
}
