// if — conditional branching, statement AND expression positions (spec
// Axis 28). The definition carries the feature whole: syntax, docs, editor
// surface, hooks, and the grammar rules the views compose (gram_family =
// "stmt", t-47hc.8) with their feature-owned lowerings (build_if /
// MkIfLet / MkIfLetStmt — manifest rows, t-kd4y.3.2.1). The BIND-FRESH
// `if let` forms live here whole, in both positions: `iflet_stmt` beside
// `if_stmt`, and `iflet_expr` in its own fragment because the expression
// views need it without the statement rules. Only the plain `if_expr`
// remains a spine rule — it is woven into the expression precedence
// ladder — and it reaches the if-let form the way `statement` does, by
// referencing this feature's rule behind `@peek(if_let)`.
// dir-as-module (g2eo.1): codegen.av auto-loads as a sibling,
// surface flat at `features.if_stmt.{...}`. emit_if + emit_if_expr are
// in scope without a self-import.
use core.{Stmt, Expr, ValueType, vtype_display, vtype_eq, vtype_is_unknown, expr_diverges}
use codegen.{err_emit, StmtResult}
use codegen.{err_sr}
use typeck.{check_expr, check_stmt, tc_er, tc_report, tc_gate_unthreaded_lambda, narrow_guard_of, tc_narrow_true_branch, tc_narrow_false_branch, tc_narrow_after_if, generic_args_layout_conflict}
use features.grammar.{Grammar, grammar_checked, parse_grammar}
use features.{composed}
use features.if_stmt.lowering.{if_builds}

/// The `if` STATEMENT rules — the plain form and its bind-fresh `if let`
/// twin. The statement views compose this via the feature registry
/// (gram_family = "stmt"); `statement` names both rules and binds them
/// after the flat merge.
///
/// `@onfail(bail)` on `if_stmt`'s CONDITION: a failed condition ends the
/// rule so the missing block is never also reported (`if return 2 …` is
/// one F0040, not F0040 + F0010). `@require t:block`: without it a missing
/// block is not an error HERE — the rule builds an `if` with no consequent
/// and the enclosing body reports about ITS closer instead. Dual-key
/// @expect on that @require — same fragment-vs-compose split the while
/// rule documents: standalone validation needs the rule-name key (`block`
/// is a spine rule it cannot resolve), the composed emit looks up block's
/// FIRST literal `{`. One message, one F0010, both keys.
///
/// `iflet_stmt` is STATEMENT-position `if let` — not its expression twin.
/// Routing it to `expression` (which reaches `if_expr`) parsed the form
/// correctly but lowered it to the WRONG SHAPE: an `ExprStmt(Block-expr)`
/// holding an `if-expr`, where the pinned shape is a `Stmt.Block` holding a
/// `Stmt.If`. Both run, which is why every diagnostic oracle stayed green —
/// a VALID program has no diagnostics to compare, so only the TREE sees it.
/// The two shapes are not interchangeable: with no `else`, the expression
/// form has to SYNTHESISE an empty else block (an if-expr needs a value)
/// while the statement form leaves `else_opt` absent, so `if let v = x { … }`
/// grew an else arm the source never wrote. Its shape mirrors `iflet_expr`
/// with STATEMENT bodies (`block` / `statement`, as `if_stmt` uses); the
/// three `@require`s stay the three abort points, and `tmp:@gensym(iflet)`
/// keeps its position between `"if"` and `"let"` so a nested `if let` still
/// numbers after its parent.
export fn avra_if_stmt_grammar() -> Grammar {
    let gp = grammar {
  if_stmt = "if" @onfail(bail) @off(allow_struct_lit) c:expression @require t:block ( "else" e:statement )? @expect("{", "expected `{` after if condition", F0010) @expect("block", "expected `{` after if condition", F0010) -> build_if(c, t, e)
  iflet_stmt = "if" tmp:@gensym(iflet) "let" @require b:IDENT @require "="
               @off(allow_struct_lit) s:expression @require t:block ( "else" e:statement )?
               @expect("IDENT", "expected a binding name after `if let`")
               @expect("=", "expected `=` after the `if let` binding")
               @expect("{", "expected `{` after the `if let` binding", F0010)
               @expect("block", "expected `{` after the `if let` binding", F0010) -> MkIfLetStmt(tmp, b, s, t, e)
    }
    grammar_checked(gp)
}

/// EXPRESSION-position `if let` — the same form with expression bodies, in
/// its OWN fragment because the expression views need it without the
/// statement rules that surround it above. The spine's `if_expr` reaches it
/// exactly as `statement` reaches `iflet_stmt`: a `@peek(if_let)`-gated
/// branch naming this rule, so the lookahead that peels the form off stays
/// with the alternation that has a plain-`if` sibling to fall to.
///
/// A DESUGAR, not a parse: `build_if_let_expr` (core/arena.av) turns it into
/// a temp binding, a none-check condition, and an unwrap-bind row prepended
/// to the then-block. That core is SHARED with parse_if_let_expression — the
/// same rows in the same order — so the two cannot drift in what they lower
/// to, and `iflet_stmt` above shares the statement-shaped twin the same way.
///
/// `tmp:@gensym(iflet)` sits between `"if"` and `"let"` because that is
/// exactly where parse_if_let_header mints (its first line, after `if` has
/// been consumed). Position is load-bearing, not cosmetic: a build-minted
/// temp would number a NESTED `if let` before its parent, inverting the mint
/// order.
///
/// The three `@require`s are the three abort points, in order —
/// consume_identifier for the binding, consume(Equal), and the `{` check. An
/// ABSENT piece aborts the whole leaf; a MALFORMED subject or block still
/// recovers inside its own rule.
/// The EXPRESSION `if` (t-kd4y.3.5.2 — moved from the spine, verbatim):
/// `let x = if cond { a } else { b }`. The bind-fresh `if let` is peeled to
/// `iflet_expr` (below) at the `if`; the ordinary branch is then PREDICTIVE.
/// `else_tail` chains `else if` without a nested block requirement. The
/// spine's unary ladder references `if_expr` by name.
export fn avra_if_expr_grammar() -> Grammar {
    let gp = grammar {
  if_expr      = @peek(if_let) iflet_expr
               // The condition is `@onfail(bail)`: a condition that FAILED means there is no
               // `if` to finish — without it `else if` with nothing after it reported the
               // missing condition (F0040) and then the missing block too.
               | "if" @onfail(bail) @off(allow_struct_lit) c:expression @require t:block_expr ( "else" e:else_tail )?
                 // F0010 `ExpectedBlock`, matching the statement view's twin. The
                 // `@expect` is declared TWICE, keyed both ways, because this rule
                 // lives in a FRAGMENT: `block_expr` is external here, so the
                 // standalone gram cannot derive its single-literal FIRST and
                 // `@require` on the ref demands a rule-NAME key (the quote_expr
                 // precedent); composed, the token-keyed message is the one read.
                 @expect("{", "expected `{` after if condition", F0010)
                 @expect("block_expr", "expected `{` after if condition", F0010) -> MkIfExpr(c, t, e)
  else_tail    = if_expr | block_expr | expression
    }
    grammar_checked(gp)
}

export fn avra_iflet_expr_grammar() -> Grammar {
    let gp = grammar {
  iflet_expr = "if" tmp:@gensym(iflet) "let" @require b:IDENT @require "="
               @off(allow_struct_lit) s:expression @require t:block_expr ( "else" e:else_tail )?
               @expect("IDENT", "expected a binding name after `if let`")
               @expect("=", "expected `=` after the `if let` binding")
               @expect("{", "expected `{` after the `if let` binding", F0010)
               @expect("block_expr", "expected `{` after the `if let` binding", F0010) -> MkIfLet(tmp, b, s, t, e)
    }
    grammar_checked(gp)
}

/// The definition: the two fragments above, the manifest rows their builds
/// resolve through (`if_builds` — build_if spanned, MkIfLet / MkIfLetStmt
/// span-free), and every pass hook below.
export fn if_lang() -> LanguageFeature {
    LanguageFeature if_def {
        name = "if",
        title = "if — conditional branching",
        docs = """
`if cond { then }` runs the block when `cond` is true; an optional
`else` takes any statement, so `else { }` blocks and `else if` chains
both fall out of the same rule. The condition must be `bool` (a bare
`int` is accepted for legacy compatibility); the THEN branch must be a
`{ }` block (F0010), while the else branch is deliberately unrestricted.

Struct literals are disabled in the condition (`if foo { }` reads `foo`
as the condition, never a struct literal). An `x != none` / `x == none`
condition flow-narrows `x` inside the proven branch — and after the
whole `if`, when the none-side diverges (`if x == none { return }`).

`if let v = opt { … }` binds the unwrapped value for the branch — a
DESUGAR into a temp binding, a `none` check, and an unwrap-bind row, in
both statement and expression position.

`if` is also an EXPRESSION: `let x = if cond { a } else { b }` — that
form lives in the expression grammar, not this rule.
""",
        // Both fragments compose here because the no-orphans validator
        // reads THIS gram: `iflet_expr`'s row (MkIfLet) is supplied below,
        // so the rule referencing it must be in view. gram_family = "stmt"
        // hands the whole thing to the statement views — the expression
        // views take the expression fragment on its own, by name.
        gram = composed([avra_if_stmt_grammar(), avra_iflet_expr_grammar(), avra_if_expr_grammar()]),
        builders = if_builds(),
        snippet = r"if ${1:cond} {\n    ${2:body}\n}",
        expr_tag = Expr.IfExpr(ExprId(0), ExprId(0), ExprId(0)),
        stmt_tag = Stmt.If(ExprId(0), StmtId(0), null),
        emit_expr = if_emit_expr,
        emit_stmt = if_emit_stmt,
        resolve_stmt = if_resolve_stmt,
        resolve_expr = if_resolve_expr,
        check_stmt = if_check_stmt,
        check_expr = if_check_expr,
        eval_stmt = if_eval_stmt,
        eval_expr = if_eval_expr,
        gram_family = "stmt",
    }
    if_def
}

/// Codegen hook for `IfExpr`. Forwards to `emit_if_expr` which
/// emits both branches into a result-slot phi.
fn if_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .IfExpr(condition, then_branch, else_branch) -> emit_if_expr(ctx, env, ctx.nodes.exprs.get(condition), ctx.nodes.exprs.get(then_branch), ctx.nodes.exprs.get(else_branch))
        _ -> err_emit("expected IfExpr")
    }
}

/// Codegen hook for `If` statements. Forwards to `emit_if`
/// which emits both branches into named basic blocks.
fn if_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .If(condition, then_branch, else_branch) -> {
            let else_s: Stmt? = if else_branch != null { ctx.nodes.stmts.get(else_branch!) } else { null }
            emit_if(ctx, env, ctx.nodes.exprs.get(condition), ctx.nodes.stmts.get(then_branch), else_s)
        }
        _ -> err_sr("expected If")
    }
}

/// Type-check hook for `If` statements. Condition must be Bool
/// (Int accepted for compat). Applies optional flow-narrowing: an
/// `x != none` / `x == none` guard retypes `x` from `T?` to `T`
/// inside the proven-present branch, and — when the none-side
/// diverges — in the continuation after the `if` (the
/// `if x == none { return … }` idiom). Branch-local narrowing is
/// scoped by resetting the env to the pre-narrow baseline before the
/// else / continuation, keeping accumulated diagnostics. (Permissive
/// variable-narrowing — see the `tc_narrow_present` block in typeck
/// for the soundness caveat; statements produce no value, so no
/// type-merging is needed.)
fn if_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .If(cond_id, then_id, else_id) -> {
            let cond = tc.nodes.exprs.get(cond_id)
            let then_branch = tc.nodes.stmts.get(then_id)
            let else_branch: Stmt? = if else_id != null { tc.nodes.stmts.get(else_id!) } else { null }
            let c = check_expr(tc, cond)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "if condition must be `bool`, got `${vtype_display(c.ty)}`")
            } else { c.tc }
            let guard = narrow_guard_of(tc.nodes, cond)
            // Fast path: no `none`-guard (the common case) → check the
            // branches directly, with no env reconstruction.
            if guard.var == "" {
                let after_then = check_stmt(after_cond, then_branch)
                if else_branch != null { return check_stmt(after_then, else_branch!) }
                return after_then
            }
            // Narrowing path: retype the guard var per branch, dropping
            // the branch-local narrowing (reset env to `baseline`) before
            // the else / continuation while keeping accumulated diagnostics.
            let baseline = after_cond.types
            let after_then = check_stmt(tc_narrow_true_branch(after_cond, guard), then_branch)
            let post_then = after_then with { types: baseline }
            if else_branch != null {
                let after_else = check_stmt(tc_narrow_false_branch(post_then, guard), else_branch!)
                return tc_narrow_after_if(after_else with { types: baseline }, guard, then_branch, else_branch)
            }
            tc_narrow_after_if(post_then, guard, then_branch, else_branch)
        }
        _ -> tc
    }
}

/// Result type of an if-expression: a `Union<Then, Else>` when both
/// branches have concrete, differing types so callers can disambiguate
/// via `match`; otherwise the then-type (`Void`/`Unknown` branches
/// don't constrain — an expression-position `if` may degrade to an
/// effect-only expression).
/// Unify an if-expr's two arm types into its result type, rejecting a nested
/// LAYOUT conflict between the branches (tpbn). Two branches whose CONTAINER
/// element / generic-arg layouts disagree — e.g. `List<int>` vs `List<Node>`
/// (scalar vs pointer elements) — otherwise type-check silently and let a
/// downstream use read one layout through the other (the seam that shipped the
/// F4d.8 metadata SIGSEGV). A direct call arg with the same mismatch is already
/// F1000; this brings if-expr branch unification to parity for the container
/// case. We use `generic_args_layout_conflict` (NOT the top-level scalar↔ptr
/// check) on purpose: a top-level scalar-vs-pointer difference (`int` vs
/// `string`) is a legitimate INFERRED ad-hoc union here — the hazard is a shared
/// CONTAINER shell whose element layouts disagree, which is almost never an
/// intended union and is what the wild-store class actually corrupts.
fn unify_if_expr_branches(tc: TC, then_ty: ValueType, else_ty: ValueType) -> ExprResult {
    // NO `vtype_eq` short-circuit: `vtype_eq` ignores generic args, so it reports
    // `Box<int>` == `Box<string>` and would skip the conflict check on a
    // same-nominal argument-layout clash (int scalar slot vs string ptr slot — a
    // wild store; the F4d.8 class). `generic_args_layout_conflict` is the correct
    // guard — it returns false for genuinely-identical types (so identical
    // branches still don't error and `if_expr_result_type` collapses them) AND for
    // a legitimate top-level scalar union (`int` vs `string`), and true only for a
    // shared-nominal container/struct whose type args disagree in layout.
    if generic_args_layout_conflict(tc, then_ty, else_ty) {
        let msg = "`if` branches have incompatible layouts: `${vtype_display(then_ty)}` (then) vs `${vtype_display(else_ty)}` (else) — their element/argument types are memory-incompatible (pointer vs scalar), so the result can't be used as either"
        return tc_er(tc_report(tc, DiagCode.TypeMismatch, msg), if_expr_result_type(then_ty, else_ty))
    }
    tc_er(tc, if_expr_result_type(then_ty, else_ty))
}

/// Unify two if-expr arm types, honoring divergence: when exactly one arm
/// diverges (`return` / `break` / `continue` / `panic`) only the OTHER arm
/// reaches the merge, so the if-expr's type is that surviving arm's — never
/// the diverging arm's `.Void`/`.Unknown`. Mirrors `emit_if_expr`'s codegen
/// divergence handling so typeck and codegen agree on the type of a binding
/// like `let v = if c { return } else { real }` (else the binding would type
/// `.Unknown` and its later uses would go unchecked; §6 layout totality). An
/// else-less `if c { return X }` in value position keeps its effect-only
/// `.Void`: its synthesized empty-block else diverges=false and types `.Void`,
/// so `then diverges, else survives .Void` returns `.Void` — exactly today's
/// behavior. Both-diverge and neither-diverge fall through to the ordinary
/// (union-forming) unification.
fn unify_if_branches_diverge_aware(tc: TC, then_e: Expr, else_e: Expr, then_ty: ValueType, else_ty: ValueType) -> ExprResult {
    let then_div = expr_diverges(tc.nodes, then_e)
    let else_div = expr_diverges(tc.nodes, else_e)
    if then_div && !else_div { return tc_er(tc, else_ty) }
    if else_div && !then_div { return tc_er(tc, then_ty) }
    unify_if_expr_branches(tc, then_ty, else_ty)
}

fn if_expr_result_type(then_ty: ValueType, else_ty: ValueType) -> ValueType {
    if !vtype_eq(then_ty, else_ty) && !vtype_is_unknown(then_ty) && !vtype_is_unknown(else_ty) && !vtype_eq(then_ty, .Void) && !vtype_eq(else_ty, .Void) {
        mut members: List<ValueType> = []
        members.push(then_ty)
        members.push(else_ty)
        return ValueType.Union(members)
    }
    then_ty
}

/// Type-check hook for `IfExpr`. The result type is computed by
/// `if_expr_result_type` (a `Union` when the branches concretely
/// differ). Applies the same optional flow-narrowing as `if_check_stmt`
/// per arm, minus the continuation (an if-expr has none); the env is
/// reset to the pre-narrow baseline after each arm so narrowing never
/// leaks out of the branch it was proven in.
fn if_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .IfExpr(cond, then_branch, else_branch) -> {
            let cond_e = tc.nodes.exprs.get(cond)
            let then_e = tc.nodes.exprs.get(then_branch)
            let else_e = tc.nodes.exprs.get(else_branch)
            let c = check_expr(tc, cond_e)
            let after_cond = if !vtype_eq(c.ty, .Bool) && !vtype_eq(c.ty, .Int) && !vtype_is_unknown(c.ty) {
                tc_report(c.tc, DiagCode.TypeMismatch, "if condition must be `bool`, got `${vtype_display(c.ty)}`")
            } else { c.tc }
            // Row 11 (ps3t.4.5): if-expr branches never thread param
            // types into a lambda — annotate or F1006.
            let branch_gated = tc_gate_unthreaded_lambda(tc_gate_unthreaded_lambda(after_cond, then_e), else_e)
            let guard = narrow_guard_of(tc.nodes, cond_e)
            // Fast path: no `none`-guard → check both arms directly, no
            // env reconstruction.
            if guard.var == "" {
                let t = check_expr(branch_gated, then_e)
                let e = check_expr(t.tc, else_e)
                return unify_if_branches_diverge_aware(e.tc, then_e, else_e, t.ty, e.ty)
            }
            // Narrowing path: narrow the present arm, resetting the env
            // to `baseline` after each so narrowing stays branch-local.
            let baseline = branch_gated.types
            let t = check_expr(tc_narrow_true_branch(branch_gated, guard), then_e)
            let e = check_expr(tc_narrow_false_branch(t.tc with { types: baseline }, guard), else_e)
            unify_if_branches_diverge_aware(e.tc with { types: baseline }, then_e, else_e, t.ty, e.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}
