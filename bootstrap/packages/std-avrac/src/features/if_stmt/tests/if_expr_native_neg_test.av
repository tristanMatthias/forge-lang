// WHY: t-47hc.24 — the native `if_expr` owns its own diagnostic now, and diff-test CANNOT
// see it: diff-test compares IR for VALID programs, so the error text of an invalid one is
// outside its oracle entirely. These are the isolate-run negative tests for that gap.
//
// The message comes from `@require t:block_expr` paired with `@expect("{", …)`, which
// together reproduce the hand's `if !check(Tk.LeftBrace) { report(…); return .Err }`.
// Getting the report but losing the abort is the specific regression this pins: an `if`
// with no block would otherwise error-tolerantly build a partial node and keep consuming.
//
// This is also the first production use of `@require` on a RULE REFERENCE, whose whole
// point is the ABSENT-vs-MALFORMED split — an absent block aborts, a block that merely
// contains a bad statement recovers. Both halves are pinned below, because a `@require`
// that widened to "the sub-rule reported anything" would still pass an absent-block test
// while silently swallowing everything after a malformed one.
//
// Each case is also checked against the HAND parser (AVRA_PARSER_DECL_FLIP=0). Asserting
// the message alone would not catch the grammar and the hand drifting apart; asserting
// only agreement would not catch BOTH regressing to the same wrong text.
extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

use @std.avrac.features.grammar.{emit_parser_source, avra_expr_dispatch_grammar}

/// The emitted expression-family parser source — where if_expr's own diagnostic lives.
fn generated_if_expr_source() -> string { emit_parser_source(avra_expr_dispatch_grammar()) }

fn check_out(env: string, source: string) -> string {
    let path = "/tmp/avra_if_expr_neg.av"
    write_fixture(path, source)
    avra_shell_exec("${env} ./build/bs2 check '${path}' 2>&1")
}

fn dsl(source: string) -> string { check_out("AVRA_NO_STATIC_FALLBACK=1", source) }
fn hand(source: string) -> string { check_out("AVRA_PARSER_DECL_FLIP=0", source) }

// The occurrence-ordered F-code signature — set, order and count together.
fn codes(out: string) -> string {
    mut sig = ""
    for line in out.split("\n") {
        mut i = 0
        while i + 5 <= line.length {
            let c = line.substring(i, i + 5)
            if c.substring(0, 1) == "F" { sig = sig + c + " " }
            i = i + 1
        }
    }
    sig
}

fn agrees(source: string) -> bool { codes(dsl(source)) == codes(hand(source)) }

// No block at all after the condition — the ABSENT case the @require guard aborts on.
fn missing_block() -> string {
    "fn f(a: bool) -> int {\n    let v = if a\n    return v\n}"
}

// A block that IS there but never closes.
fn unclosed_block() -> string {
    "fn f(a: bool) -> int {\n    let v = if a {\n        1\n    return v\n}"
}

// The else branch missing its body.
fn missing_else_body() -> string {
    "fn f(a: bool) -> int {\n    let v = if a { 1 } else\n    return v\n}"
}

spec "t-47hc.24: the native if expression reports its own block diagnostic" {
    then "a missing block after the condition is REJECTED, not silently recovered" {
        !dsl(missing_block()).contains("\nok")
    }
    then "an unclosed block is rejected too" {
        !dsl(unclosed_block()).contains("\nok")
    }
    then "the generated parser carries the diagnostic and ABORTS on it" {
        // Structural, because at whole-program level the grammar's own message is not
        // observable: on ANY DSL error the flip falls back to the authoritative hand
        // parser, which then owns the reporting (by design — that is what keeps error
        // trees byte-identical). So `bs2 check` shows the HAND's diagnostic even here,
        // which is exactly why the agreement specs below are the load-bearing ones and a
        // message assertion alone would prove little. What IS checkable is that the
        // emitted parser reports and then RETURNS rather than building a partial node.
        let gen = generated_if_expr_source()
        gen.contains("expected `{` after if condition") &&
            gen.contains("return CapVal.Node(st.error_node_silent())")
    }
    then "the abort is guarded by a FIRST check, not by 'did the sub-rule report'" {
        // The absent-vs-malformed distinction, read off the emitted source: the guard is a
        // LeftBrace lookahead placed BEFORE the parse_block_expr call. A diag-growth test
        // in its place would also fire for a block that merely CONTAINS an error, which
        // the hand recovers from — see the malformed-body spec below for the behaviour.
        let gen = generated_if_expr_source()
        // `report_coded`, not `report`: the `@expect` carries F0010 now, matching the
        // hand's `DiagCode.ExpectedBlock` and the statement view's twin. The uncoded
        // spelling rendered F0001, which only became visible once `let` routed and
        // stopped handing `let v = if { 1 }` back to the hand.
        gen.contains("if !(st.cur().tk == Tk.LeftBrace) {\n            st.report_coded(\"F0010\", \"expected `{` after if condition\")")
    }
}

spec "t-47hc.24: a MALFORMED then-block is not an absent one — it must NOT abort" {
    then "an if whose block contains a bad statement still agrees with the hand" {
        // The block IS present, so the @require guard passes and block_expr reports its
        // own error while the enclosing if_expr carries on to the `else`. Under a
        // diag-growth abort the `else` would be swallowed and the F-codes would diverge.
        agrees("fn f(a: bool) -> int {\n    let v = if a { let } else { 2 }\n    return v\n}")
    }
    then "and the following declaration is still parsed, not swallowed" {
        // The runaway signature: if the malformed block aborted the rule, everything after
        // it would be consumed as part of the failed parse and `g` would go missing. The
        // hand recovers here, so the DSL must too.
        let out = dsl("fn f(a: bool) -> int {\n    let v = if a { let } else { 2 }\n    return v\n}\nfn g() -> int { 7 }")
        codes(out) == codes(hand("fn f(a: bool) -> int {\n    let v = if a { let } else { 2 }\n    return v\n}\nfn g() -> int { 7 }"))
    }
}

spec "t-47hc.24: the native if expression agrees with the hand oracle on invalid input" {
    then "a missing block recovers to the same F-code sequence" { agrees(missing_block()) }
    then "an unclosed block recovers to the same F-code sequence" { agrees(unclosed_block()) }
    then "a missing else body agrees too" { agrees(missing_else_body()) }
    then "a bare `else if` with nothing after it agrees" {
        agrees("fn f(a: bool) -> int {\n    let v = if a { 1 } else if\n    return v\n}")
    }
    then "an if with no condition at all agrees" {
        agrees("fn f(a: bool) -> int {\n    let v = if { 1 }\n    return v\n}")
    }
}

spec "t-47hc.24: valid if expressions still parse clean" {
    then "the else-less form (the synthesized Void else)" {
        dsl("fn f(a: bool) -> int {\n    let v = if a { 1 }\n    return 0\n}").contains("ok")
    }
    then "an else-if chain" {
        dsl("fn f(a: bool, b: bool) -> int {\n    let v = if a { 1 } else if b { 2 } else { 3 }\n    return v\n}").contains("ok")
    }
    then "a non-block else (the expression tail)" {
        dsl("fn f(a: bool) -> int {\n    let v = if a { 1 } else 7\n    return v\n}").contains("ok")
    }
    then "struct literals in BOTH branches — allow_struct_lit is off only for the condition" {
        dsl("type P = { x: int }\nfn f(a: bool) -> P {\n    let v = if a { P { x: 1 } } else { P { x: 2 } }\n    return v\n}").contains("ok")
    }
    then "the bind-fresh `if let` form, still the hand's behind @peek(if_let)" {
        dsl("fn f(m: int?) -> int {\n    if let g = m { return g }\n    return 0\n}").contains("ok")
    }
}
