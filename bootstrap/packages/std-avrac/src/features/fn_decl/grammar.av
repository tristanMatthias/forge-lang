// WHY: t-47hc slice 9 — the decl-keyword half of the per-feature grammar
// FRAGMENT registry. The `fn` feature OWNS its declaration rule here, colocated
// with its parser/codegen/resolver/typeck/tests, instead of living in the
// central features/grammar/avra_grammar.av monolith. This is the same motion
// `match_expr` already made for patterns (avra_pat_grammar), now applied to the
// declaration family — the step the `decl_hand` flip spends: once every decl
// keyword owns its own fragment, retiring the monolithic `@hand(decl_hand)`
// dispatch is adding rules to a registry rather than editing one central file.
//
// `param` deliberately stays in the shared base: it is referenced by `fn_decl`,
// `method_member` (trait) and `impl_method` (impl), so no single feature owns
// it — the same call already made for the expression precedence ladder and the
// type-atom spine.
//
// Authored as a `grammar { }` surface block (desugars to parse_grammar(<body>),
// features/grammar/parser.av) — identical IR to the hand-written call, so no
// seed cycle.
use features.grammar.{parse_grammar, grammar_checked, Grammar}

/// The `fn` declaration: name, parenthesised parameter list, optional `->` return
/// type, and a braced statement body. References `param` and `type_expr` from the
/// shared base and `statement` from the statement family — all bound by name
/// after the flat merge (features/grammar/compose.av `compose_fragments`).
export fn avra_fn_decl_grammar() -> Grammar {
    let gp = grammar {
  fn_decl     = "fn" name:IDENT ( "<" tparams:tparam ( "," tparams:tparam )* ">" )? "(" ( params:param ( @peek(comma_not_rparen) "," params:param )* ( "," )? )? ")" ( "->" ret:type_expr )? "{" body:body_item* "}" @expect("}", "expected `}` after function body") -> MkFnDecl(name, tparams, params, ret, body)
  // t-myz7: `extern` owns its recovery. Every position the hand `consume`s with a message
  // is `@require`d here, and the parameter list is GATED so an unclosed `(` reports about
  // the PARAMETER — `extern fn f(` is "expected parameter name" on the hand.
  extern_decl = @try "extern" @cut @require "fn" @require ename:IDENT @require "(" ( @peek(not_rparen) @gate eparams:param ( @peek(comma_not_rparen) "," eparams:param )* ( "," )? )? @require ")" ( "->" @require eret:type_expr )?
                @expect("fn", "expected `fn` after `extern`")
                @expect("IDENT", "expected extern fn name")
                @expect("(", "expected `(` after extern fn name")
                @expect(")", "expected `)` after parameters")
                @expect("type_expr", "expected return type after `->`") -> MkExtern(ename, eparams, eret)
    }
    grammar_checked(gp)
}
