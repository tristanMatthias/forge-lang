// WHY: t-47hc slice 10.6 (t-myz7) — `fn` reaches hand parity: generics, and the bodyless
// `extern fn` signature.
//
// Generics are the same shape enum (10.3) and type (10.4) used, deliberately: one `.One`
// plus one `.Star` on `tparams`, never two `.One`s, which is what keeps it clear of
// t-gnk7 (the executor REPLACES where emit ACCUMULATES).
//
// `extern fn` is its OWN rule rather than a widening of `fn_decl`, because it leads with a
// different keyword and so is FIRST-disjoint — no left-factoring needed, unlike `type`'s
// two right-hand sides in 10.5. It also builds a different node (`Stmt.ExternFn`, bodyless)
// and defaults an absent return to Void.
//
// THE PART THAT WAS ALREADY BROKEN, and why `decl_export_extern_test` did not catch it:
// `MkExtern` existed in the EXECUTOR only. Emit had no twin, and emit dispatches on the
// build name, so a grammar naming `MkExtern` worked under the interpreter — which is all
// that test exercises — and would have produced nothing usable in the generated parser.
// Same asymmetry as the generic decl builders in 10.2, closed the same way: one shared
// `mk_extern_fn` core that both engines call.
//
// `MkExport` has the identical gap and is still executor-only. It is what the `export`
// WRAPPING increment will spend, so it needs the same treatment then.

use @std.avrac.features.grammar.{emitted_rule_body, checked_in_parser_source}
use @std.avrac.features.grammar.{avra_program_grammar, run_grammar_stmt, emit_parser_source, checked_in_parser_source}
use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{render_stmt_ids, Stmt}

fn dsl_program(src: string) -> string {
    let r = run_grammar_stmt(avra_program_grammar(), src)
    if r.had_error { return "<dsl parse error>" }
    match r.store.stmts.get(r.root) {
        .Block(ids) -> render_stmt_ids(r.store, ids)
        _ -> "<not a program block>"
    }
}

fn hand_program(src: string) -> string {
    let p = parse_program_source(src)
    if p.had_error != 0 { return "<hand parse error>" }
    if p.ids == null { return "<hand no ids>" }
    render_stmt_ids(p.store, p.ids!)
}

fn agrees(src: string) -> bool {
    let d = dsl_program(src)
    d == hand_program(src) && !d.contains("parse error")
}

spec "t-47hc slice 10.6: `fn` accepts the hand's GENERIC forms" {
    then "one type param, a bounded one, and several all agree with the hand" {
        agrees("fn id<T>(x: T) -> T {\n    return x\n}\n") &&
            agrees("fn p<T: Show>(x: T) {\n}\n") &&
            agrees("fn m<A, B>(a: A, b: B) {\n}\n")
    }

    then "the non-generic forms are untouched" {
        agrees("fn f(x: int) -> int {\n    return x\n}\n") &&
            agrees("fn g() {\n}\n") &&
            agrees("fn h(a: int) {\n}\n")
    }
}

spec "t-47hc slice 10.6: `extern fn` is native, in BOTH engines" {
    then "a bodyless signature agrees with the hand, with and without a return type" {
        agrees("extern fn puts(s: string) -> int\n") &&
            agrees("extern fn abrt()\n")
    }

    then "emit renders the shared core — the half that was missing" {
        // The executor-only state would still have passed the parity assertions above,
        // since those run the interpreter. This is the half that was absent.
        emit_parser_source(avra_program_grammar()).contains("mk_extern_fn(st, capval_tok_text(ename)")
    }
}

// ── ROUTING (t-47hc slice 10.13) ─────────────────────────────────────────────
//
// `fn` and `extern fn` leave `@hand(decl_hand)` as `@try` branches — native for VALID
// input, rolling back into the hand gate the moment they report, so error recovery stays
// the hand parser's byte-for-byte (t-myz7.2, #1061).
//
// These two are the last-but-two, and they are what made the parameter list cross a view
// boundary for the first time: `param` is defined in the EXPRESSION view (it is
// paren_expr's typed-lambda parameter, shared rather than duplicated), so routing them
// needed TWO cross-view declarations in emit.av — a declared FIRST in `rule_first_guard`
// and a capture KIND in `rule_kind_v`. Without the second, the accumulator declares
// `List<ExprId>` and coerces every parameter through `capval_to_expr`; the builders
// reject that as a layout conflict, which is the loud version of a trap that has
// silently corrupted trees before (see the `tparam` and `pattern` entries beside it).
//
// Sixteen malformed forms across the four keywords are in the invalid corpus
// (error_recovery_differential_test), F-code and recovery-TREE both.
fn decl_src() -> string {
    checked_in_parser_source()
}

spec "t-47hc slice 10.13: `fn` and `extern` are routed onto the production path" {
    then "both parse fns exist and dispatch BEFORE the decl_hand gate" {
        let src = decl_src()
        let fn_at = src.index_of("parse_fn_decl(st)")
        let ex_at = src.index_of("parse_extern_decl(st)")
        src.contains("fn parse_fn_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_extern_decl(st: PState) -> CapVal") &&
        // t-47hc.4.3 — the leaf is DELETED, so this asserts there is no gate to dispatch
        // before, rather than an ordering against one. Strictly stronger: an ordering claim
        // is satisfiable by a gate that still exists, `hand_at < 0` only by its absence.
            fn_at >= 0 && ex_at >= 0
    }

    then "BOTH are COMMITTED — each rule owns its own recovery" {
        // Both rules own their recovery now (t-47hc.5): each one's `@try`/`@cut` lives
        // INSIDE the rule, so the dispatcher reaches it by a direct predictive return and
        // a diagnostic past the cut no longer rolls the whole branch back into the gate.
        //
        // `@try X` over an internally-committed X is INERT — the caller rolls back past
        // the cut — and decl_flip_dispatch_test fails the build on exactly that pairing,
        // which is why the `@cut` and the bare dispatch had to land in ONE step.
        let src = decl_src()
        let fn_rule = emitted_rule_body(src, "fn parse_fn_decl(st: PState) -> CapVal")
        let ext_rule = emitted_rule_body(src, "fn parse_extern_decl(st: PState) -> CapVal")
        fn_rule != "" && ext_rule != "" &&
            !src.contains("s_last = parse_fn_decl(st)") &&
            !src.contains("s_last = parse_extern_decl(st)") &&
            src.contains("return parse_fn_decl(st)") &&
            src.contains("return parse_extern_decl(st)") &&
            // The rollback scaffold moved INSIDE each rule, so it is asserted THERE —
            // a whole-file `contains` matches any of the dozen other speculative rules
            // that emit the same lines and could not fail for these two. The `s_cut`
            // flag is asserted here as well, which the two sibling parity specs already
            // do and this one omitted: without it the rule commits nowhere and its own
            // `@expect` wording is unreachable.
            fn_rule.contains("mut s_cut = false") &&
            fn_rule.contains("st.store.truncate_to_mark(s_mark)") &&
            ext_rule.contains("mut s_cut = false") &&
            ext_rule.contains("st.store.truncate_to_mark(s_mark)")
    }

    then "the parameter list crosses the view boundary as ParamEntry, not ExprId" {
        // The cross-view capture-kind declaration, asserted on the OUTPUT. `List<ExprId>`
        // here would be the silent-corruption form of the same mistake.
        let src = decl_src()
        src.contains("mut params_list: List<ParamEntry> = []") &&
            src.contains("params_list.push(capval_to_pentry(st, parse_param(st)))")
    }

    then "the alternation TAIL is still native `statement`, not a promoted @hand" {
        let src = decl_src()
        // t-47hc.4.3: the gate this used to sit after is deleted, so the claim is now
        // simply that the tail IS `parse_statement(st)` and NO hand leaf survives.
        // t-47hc.8: sliced to parse_declaration's OWN body — the source is the whole
        // checked-in parser now, and several emitted rules end in a delegating tail,
        // so a whole-file index proves nothing about THIS dispatcher (CodeRabbit).
        let body = emitted_rule_body(src, "fn parse_declaration(st: PState) -> CapVal")
        body != "" && body.ends_with("\n    parse_statement(st)")
    }
}
