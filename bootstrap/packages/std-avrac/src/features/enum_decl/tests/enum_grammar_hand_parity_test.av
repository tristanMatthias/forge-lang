// WHY: t-47hc slice 10.3 (t-myz7) — `enum_decl`'s fragment now accepts what the HAND
// accepts, which is the precondition for routing it off `@hand(decl_hand)`.
//
// Slice 9 moved the decl rules into per-feature fragments, but the rules it moved were
// the SIMPLE forms inherited from avra_program_grammar. `parse_enum_declaration` accepts
// two things they did not, and both were measured as `<dsl parse error>` before this:
//
//   generics       `enum Opt<T> { … }` / `enum E<T: Show> { … }` / `enum R<T, E> { … }`
//   doc comments   `parse_variant_list` skips `Tk.DocComment` before every variant
//
// Routing a keyword natively BEFORE closing its gap would not be a partial win — it
// would break the compiler, whose own source is full of both forms. So parity is
// asserted here, against the hand, as its own step.
//
// The DOC skip is deliberately OUTSIDE `variant` rather than at its head. Putting it in
// `variant` would add DOC to that rule's FIRST, and the repetition would then re-enter on
// a doc comment that precedes the closing brace — consuming it and then demanding a
// variant name it will never get. `( DOC )* ( vars:variant ","? ( DOC )* )*` keeps the
// loop's continue-check on IDENT and lets the last iteration absorb a trailing doc.
//
// `tparam` lives in features/generics, not here: fn / type / enum / trait / impl all take
// the same `<T, U: Bound>` list, so it is shared sub-structure the way `field` is.

use @std.avrac.features.grammar.{avra_program_grammar, run_grammar_stmt, avra_decl_dispatch_grammar, emit_parser_source_ex}
use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{render_stmt_ids, Stmt}

fn dsl_program(src: string) -> string {
    let r = run_grammar_stmt(avra_program_grammar(), src)
    if r.had_error { return "<dsl parse error>" }
    match r.store.stmts.get(r.root) {
        .Block(ids) -> render_stmt_ids(r.store, ids)
        _ -> "<not a program block>"
    }
}

fn hand_program(src: string) -> string {
    let p = parse_program_source(src)
    if p.had_error != 0 { return "<hand parse error>" }
    if p.ids == null { return "<hand no ids>" }
    render_stmt_ids(p.store, p.ids!)
}

// Equality alone would still hold if BOTH sides broke to the same error string, so every
// case also asserts the DSL actually parsed.
fn agrees(src: string) -> bool {
    let d = dsl_program(src)
    d == hand_program(src) && !d.contains("parse error") && d.contains("enum")
}

spec "t-47hc slice 10.3: the enum fragment accepts the hand's GENERIC forms" {
    then "one type param, a bounded one, and several all agree with the hand" {
        agrees("enum Opt<T> { Some(v: T), None }\n") &&
            agrees("enum E<T: Show> { A }\n") &&
            agrees("enum R<T, E> { Ok(v: T), Err(e: E) }\n")
    }

    then "the non-generic form is untouched" {
        // The same rule serves both: with no `<…>` the type-param capture is empty and
        // the generic core builds the identical node the 2-arg one did.
        agrees("enum E { A, B }\n")
    }
}

spec "t-47hc slice 10.3: DOC comments between variants are skipped, as the hand skips them" {
    then "a doc comment before the first, between two, and before the closing brace" {
        agrees("enum E {\n    /// the a\n    A,\n    B\n}\n") &&
            agrees("enum E {\n    A,\n    /// the b\n    B\n}\n") &&
            agrees("enum E {\n    A\n    /// trailing\n}\n")
    }
}

// ── ROUTING (t-47hc slice 10.11) ──────────────────────────────────────────────
//
// The parity above is the precondition; this is the flip. `enum` joins `use` / `mod` /
// `shape` on the production declaration path as a `@try` branch — native for VALID
// input, rolling back into `@hand(decl_hand)` the moment it reports, so error recovery
// stays the hand parser's byte-for-byte (t-myz7.2, #1061).
//
// Nine malformed enum forms are in the invalid corpus (error_recovery_differential_test)
// covering the shapes routing actually reaches: a missing name, a truncated generic
// list, an empty payload field, a non-IDENT variant. Those measure the flip; what this
// spec pins is the DISPATCH, structurally on the emitted source — a routed rule emitted
// AFTER the decl_hand gate is dead code that produces correct output and no diagnostic,
// which is the failure mode #1028 was caught on.
fn decl_src() -> string {
    emit_parser_source_ex(avra_decl_dispatch_grammar(), true)
}

spec "t-47hc slice 10.11: `enum` is routed onto the production path, COMMITTED" {
    then "parse_enum_decl and parse_variant exist and dispatch BEFORE the decl_hand gate" {
        let src = decl_src()
        let enum_at = src.index_of("parse_enum_decl(st)")
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        src.contains("fn parse_enum_decl(st: PState) -> CapVal") &&
            src.contains("fn parse_variant(st: PState) -> CapVal") &&
            enum_at >= 0 && hand_at >= 0 && enum_at < hand_at
    }

    // t-myz7: `enum` OWNS its recovery, so the dispatcher calls it DIRECTLY. The `@try`
    // moved inside the rule, paired with a `@cut` after the keyword — it has to be there,
    // because a `@cut`'s commit flag is per-rule-invocation and cannot reach a caller's
    // `@try`. So the rollback scaffold is still emitted, just one frame in: it now belongs
    // to `parse_enum_decl` and covers only a failure BEFORE the cut.
    //
    // Both halves are asserted because they fail in opposite directions. A speculative
    // `s_last = parse_enum_decl(st)` in the dispatcher would mean any diagnostic anywhere
    // inside the enum — however deep — rolls the whole declaration back and `decl_hand`
    // owns the recovery again, silently un-routing the keyword while every parity spec
    // above still passed. A missing `s_cut` would mean the rule commits nowhere and its
    // own `@expect` messages are unreachable.
    then "the branch is COMMITTED — the dispatcher calls it directly, the rule owns the rollback" {
        let src = decl_src()
        src.contains("return parse_enum_decl(st)") &&
            !src.contains("s_last = parse_enum_decl(st)") &&
            src.contains("mut s_cut = false") &&
            src.contains("st.store.truncate_to_mark(s_mark)") &&
            src.contains("st.restore_hand_state(s_hand)")
    }

    then "the variant list lowers to the SHARED cores, not an executor-only build" {
        // The recurring trap this slice has hit four times: an executor-only build passes
        // every interpreter-driven parity spec above and emits nothing usable.
        let src = decl_src()
        // A GATED element captures in TWO steps (t-myz7): the call binds to `__gres`,
        // the abort is read, and only then does the coercion run — `capval_to_*` reports
        // over a non-matching CapVal, and an aborted sub-parse hands back exactly that.
        // The coercion is still the assertion's point; what moved is where the result
        // comes from, so the SHARED-core check is unchanged in substance.
        src.contains("mk_evariant(capval_tok_text(vname), vfields_list)") &&
            src.contains("let __gres = parse_variant(st)") &&
            src.contains("vars_list.push(capval_to_variant(st, __gres))")
    }

    then "the alternation TAIL is still native `statement`, not a promoted @hand" {
        let src = decl_src()
        let hand_at = src.index_of("run_hand_stmt(\"decl_hand\"")
        let tail_at = src.index_of("    parse_statement(st)\n}")
        tail_at >= 0 && hand_at >= 0 && tail_at > hand_at
    }
}
