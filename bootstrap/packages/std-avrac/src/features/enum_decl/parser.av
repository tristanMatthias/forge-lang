// WHY: parses `enum Foo { ... }` declarations and the variant
// list syntax (with optional payload fields).

use core.{Stmt, FieldList, Variant, TypeParamEntry, ValueType, type_expr_to_vtype}
use parse.{Parser}
use core.{Tk}

impl Parser {
    fn parse_enum_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected enum name")?
        // Optional generic parameters: enum Result<T, E> { ... }
        let tp: List<TypeParamEntry> = if self.check(Tk.Less) {
            self.parse_type_params()
        } else {
            []
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after enum name") {
            return null
        }
        let variants = self.parse_variant_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after variants") {
            return null
        }
        Stmt.EnumDecl(name, tp, variants)
    }

    fn parse_variant_list(self) -> List<Variant>? {
        // Source-order loop appending into a growable List<Variant>.
        // Replaces the prior cons-list recursion (`parse_variant_list`
        // + `finish_variant`) — both shared the doc-comment skip and
        // the optional-comma / newline-separator handling. /// doc
        // comments preceding variants are skipped (we don't attach
        // them yet — widening Variant for docs is a separate change).
        mut out: List<Variant> = []
        mut done = false
        while !done {
            while self.check(Tk.DocComment) {
                self.advance()
            }
            if self.check(Tk.RightBrace) { return out }
            let name = self.consume_identifier("expected variant name")?
            mut fields = FieldList.End
            if self.check(Tk.LeftParen) {
                self.advance()
                fields = self.parse_field_list_until_paren()?
                if !self.consume(Tk.RightParen, "expected `)` after variant fields") {
                    return null
                }
            }
            out.push(Variant { name, fields })
            if self.check(Tk.Comma) {
                self.advance()
            }
            // Accept either comma-separated OR newline-separated
            // variants. After consuming the optional comma, if we
            // hit `}` we're done; otherwise expect another variant
            // (identifier or doc comment).
            if self.check(Tk.RightBrace) { return out }
            if !(self.check(Tk.Identifier) || self.check(Tk.DocComment)) {
                done = true
            }
        }
        out
    }

    fn parse_field_list_until_paren(self) -> FieldList? {
        if self.check(Tk.RightParen) {
            return FieldList.End
        }
        // Optional `mut` modifier — ignored for now.
        if self.check(Tk.KwMut) {
            self.advance()
        }
        let name = self.consume_identifier("expected field name")?
        if !self.consume(Tk.Colon, "expected `:` after field name") {
            return null
        }
        let te = self.parse_type_expr("expected field type")?
        let resolved = type_expr_to_vtype(te)
        if self.check(Tk.Comma) {
            self.advance()
            let rest = self.parse_field_list_until_paren()?
            return FieldList.Node(name, resolved, rest)
        }
        FieldList.Node(name, resolved, FieldList.End)
    }
}
