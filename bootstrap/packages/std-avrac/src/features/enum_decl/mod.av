// dir-as-module (g2eo.1): parser.av + codegen.av auto-load as siblings,
// surface flat at `features.enum_decl.{...}`.
use features.{composed}
use features.enum_decl.lowering.{enum_builds}

export fn enum_lang() -> LanguageFeature {
    LanguageFeature enum_def {
        name = "enum_decl",
        title = "enum — a closed set of variants",
        docs = """
`enum Name { A, B(field: T) }` declares a closed variant set; variants
may carry named fields. Generic enums take `<T, U: Bound>` parameters.
Matching over an enum is exhaustive (spec Axis 4).
""",
        gram = composed([avra_enum_decl_grammar()]),
        builders = enum_builds(),
        snippet = r"enum ${1:Name} { ${2:Variant} }",
    }
    enum_def
}
