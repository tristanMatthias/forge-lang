// WHY: type checking for map method calls + map-literal value-type checking.

use core.{ExprId, ValueType, vtype_render_full}
use typeck.{TC, ExprResult, tc_er, check_expr_list_types, tc_gate_unthreaded_lambda, tc_report, nested_layout_conflict}
use diagnostics.{DiagCode}

/// Row 14 (ps3t.4.5): map values never thread param types into a
/// lambda (codegen emits entries with no expected type, even under a
/// `Map<string, fn(…)>` annotation) — annotate or F1006. Entries are
/// [k0, v0, k1, v1, …]; only the value slots (odd indices) are gated.
/// Shared by the annotated (`check_map_lit_with_expected`) and
/// unannotated (`map_lit_check_expr`) paths.
export fn gate_map_value_lambdas(tc: TC, entries: List<ExprId>) -> TC {
    mut cur = tc
    mut i = 1
    while i < entries.length {
        cur = tc_gate_unthreaded_lambda(cur, cur.nodes.exprs.get(entries[i]))
        i = i + 2
    }
    cur
}

/// Map a method name to its result ValueType for type-checking.
/// Returns `.Unknown` for methods the typeck doesn't track yet —
/// the codegen path will surface unknown methods as a runtime
/// error there.
export fn check_map_method(tc: TC, method: string) -> ExprResult {
    match method {
        "get"              -> tc_er(tc, .Str)
        "has"              -> tc_er(tc, .Bool)
        "set"              -> tc_er(tc, .Void)
        "keys"             -> tc_er(tc, .List(.Str))
        "length" or "len"  -> tc_er(tc, .Int)
        _                  -> tc_er(tc, .Unknown)
    }
}

/// Bidirectional map-literal checker — the `.MapLit` analog of
/// `check_list_lit_with_expected`. Keys are string-keyed; `expected_value`
/// is the annotation's value type (callers pass `Unknown` with no hint).
/// EVERY value is checked against `expected_value` via `nested_layout_conflict`,
/// so a wrong generic annotation on a map value (`Map<string, Box<string>> =
/// {"k": Box{val:9}}`, or a later entry `{"a": Box{val:"ok"}, "b": Box{val:9}}`)
/// is rejected — closing 63wu. Construction is memory-safe regardless via the
/// mono gap-fill; this is the clean diagnostic. An empty literal adopts
/// `expected_value`.
export fn check_map_lit_with_expected(tc: TC, entries: List<ExprId>, expected_value: ValueType) -> ExprResult {
    if entries.length == 0 { return tc_er(tc, ValueType.Map(ValueType.Str, expected_value)) }
    let lr = check_expr_list_types(gate_map_value_lambdas(tc, entries), entries)
    let after = check_map_values_against(lr.tc, lr.types, expected_value)
    let v_ty = if lr.types.length >= 2 { lr.types[1] } else { ValueType.Unknown }
    tc_er(after, ValueType.Map(ValueType.Str, v_ty))
}

/// Validate every map VALUE (the odd indices of `types`, since entries are
/// [k0, v0, k1, v1, ...]) against `expected_value` via `nested_layout_conflict`
/// (the broad element/value check — top-level scalar↔ptr + nested generic-arg),
/// reporting F1000 on a layout conflict. Shared by the ANNOTATED path
/// (check_map_lit_with_expected — expected = the annotation's value type) and the
/// UNANNOTATED path (map_lit_check_expr — expected = the FIRST value's type) so a
/// heterogeneous literal is rejected either way: the map analog of list-element
/// layout checking.
export fn check_map_values_against(tc: TC, types: List<ValueType>, expected_value: ValueType) -> TC {
    mut after = tc
    mut i = 1
    while i < types.length {
        if nested_layout_conflict(after, types[i], expected_value) {
            after = tc_report(after, DiagCode.TypeMismatch, "map value of type `${vtype_render_full(types[i])}` conflicts with expected `${vtype_render_full(expected_value)}` (layout conflict)")
        }
        i = i + 2
    }
    after
}
