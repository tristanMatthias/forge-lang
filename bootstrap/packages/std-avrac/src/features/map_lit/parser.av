// WHY: parses map literal expressions `{ "key": value, ... }`.
// is_map_literal does lookahead to disambiguate map literals from blocks.

use core.{Expr, SExpr, sexpr}
use parse.{Parser}
use core.{Tk}

impl Parser {
    // Lookahead: is the current `{` the start of a map literal?
    // A map starts with `{ "string" :` or `{ }` (empty map).
    // Expression-position `{`: a bare `{}` is an empty map literal. UNCHANGED from
    // before qsqm — an advance/restore lookahead, which is fine here because it
    // runs only at the rare expression-position `{`.
    fn is_map_literal(self) -> bool {
        let saved_pos = self.current
        let saved_start = self.start
        let saved_kind = self.current_kind
        let saved_lex = self.current_lexeme

        self.advance()  // consume {
        let is_map = self.check(Tk.RightBrace) || (self.check(Tk.String) && {
            self.advance()  // consume string
            self.check(Tk.Colon)
        })

        self.current = saved_pos
        self.start = saved_start
        self.current_kind = saved_kind
        self.current_lexeme = saved_lex
        is_map
    }

    // Statement-position `{` (qsqm): is this a NON-empty string-keyed map literal?
    // A STATE-FREE raw-source peek — deliberately NOT an advance/restore lookahead.
    // parse_statement runs this on EVERY block-opening `{`, and a save_state-based
    // lookahead drifts there because the backtracking infra omits prev_line
    // (forge-crafting-intepreters-cpi6), perturbing the AST. Scanning the source
    // mutates no parser state, so real blocks and a bare `{}` parse byte-identically;
    // only `{ "key": ... }` is reclassified as a map. Mirrors peek_after_ident_is_colon.
    fn is_stmt_map_literal(self) -> bool {
        mut i = self.current_start + 1  // first byte after the `{`
        let n = self.source.length
        while i < n {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break }
            i = i + 1
        }
        if i >= n || self.source.substring(i, i + 1) != "\"" { return false }
        i = i + 1
        while i < n && self.source.substring(i, i + 1) != "\"" {
            if self.source.substring(i, i + 1) == "\\" { i = i + 1 }  // skip escaped char
            i = i + 1
        }
        if i >= n { return false }
        i = i + 1  // past the closing quote
        while i < n {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break }
            i = i + 1
        }
        i < n && self.source.substring(i, i + 1) == ":"
    }

    fn parse_map_literal(self) -> Result<Expr, string> {
        self.advance()  // consume {
        if self.check(Tk.RightBrace) {
            self.advance()
            let empty: List<SExpr> = []
            return .Ok(Expr.MapLit(empty))
        }
        let entries = self.parse_map_entries()?
        if !self.consume(Tk.RightBrace, "expected `}` after map") {
            return .Err("parse error")
        }
        .Ok(Expr.MapLit(entries))
    }

    // Parse key:value pairs into a flat list: key1, val1, key2, val2, ...
    fn parse_map_entries(self) -> Result<List<SExpr>, string> {
        mut out: List<SExpr> = []
        mut keep_going = true
        while keep_going {
            let key = self.parse_expression()?
            if !self.consume(Tk.Colon, "expected `:` after map key") {
                return .Err("parse error")
            }
            let value = self.parse_expression()?
            out.push(sexpr(key, self.current_line, self.current_column))
            out.push(sexpr(value, self.current_line, self.current_column))
            if self.check(Tk.Comma) {
                self.advance()
                if self.check(Tk.RightBrace) { keep_going = false }
            } else {
                keep_going = false
            }
        }
        .Ok(out)
    }
}
