// The map-literal feature's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Expr}
use resolve.{Resolver, resolve_expr_list_ids}

/// Resolver hook for `MapLit`. Walks every key + value
/// expression in the entries list.
fn map_lit_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .MapLit(entries) -> resolve_expr_list_ids(r, entries)
        _ -> r
    }
}
