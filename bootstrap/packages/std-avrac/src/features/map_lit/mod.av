// dir-as-module (g2eo.1): codegen.av + parser.av + typeck.av auto-load
// as siblings, surface flat at `features.map_lit.{...}`. emit_map_lit
// is in scope without a self-import.
use codegen.{err_emit}
use core.{ValueType}
use typeck.{check_expr_list_types, tc_er}
use features.grammar.{parse_grammar}

/// `{k: v, k: v}` map literals — the definition carries syntax, docs,
/// surface, and the MkMapLit lowering (t-kd4y.3.5.4). Wires resolver,
/// typeck, codegen, and the @comptime evaluator. Spec axis 28.
/// `gram_family = "expr"`; the spine's `brace_expr` dispatches to
/// `map_literal` by name behind the @peek(brace_map) scan.
@language_feature
export fn map_lit_lang() -> LanguageFeature {
    LanguageFeature map_lit_def {
        name = "map_lit",
        title = "map literals",
        docs = """
`{ "key": value, … }` builds a string-keyed map (`Map<string, V>`);
`{}` in expression position is the empty map. Template-interpolated
keys work like plain ones.
""",
        // VERBATIM from the spine: the VALUE propagates, like
        // `field_init`'s — `{ "a": , … }` built a map entry over an error
        // node instead of aborting the literal and its enclosing fn.
        gram = grammar {
  map_literal  = "{" ( k:expression @require ":" @onfail(bail) v:expression ( "," )? )* @require "}"
                 @expect(":", "expected `:` after map key")
                 @expect("}", "expected `}` after map") -> MkMapLit(k, v)
        },
        snippet = r"{ ${1:key}: ${2:value} }",
        expr_tag = Expr.MapLit([]),
        emit_expr = map_lit_emit_expr,
        resolve_expr = map_lit_resolve_expr,
        check_expr = map_lit_check_expr,
        eval_expr = map_lit_eval_expr,
        gram_family = "expr",
    }
    map_lit_def
}

/// Type-check hook for `MapLit`. Walks every entry expression so
/// errors are reported, then declares the result type
/// `Map<string, V>` — keys are string-keyed (cstr-backed), V pinned
/// from the first value (mirrors list-element inference). The pinned
/// V lets `generic_args_layout_conflict` catch a wrong map-value
/// annotation (`Map<string, Box<string>> = {"k": Box{val:9}}`, 63wu).
fn map_lit_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .MapLit(entries) -> {
            // Row 14 (ps3t.4.5): gate un-annotated lambda values.
            let lr = check_expr_list_types(gate_map_value_lambdas(tc, entries), entries)
            // entries = [k0, v0, k1, v1, ...]; pin V from the first value.
            let v_ty = if lr.types.length >= 2 { lr.types[1] } else { ValueType.Unknown }
            // Reject a heterogeneous literal even WITHOUT an annotation: every
            // later value must share the first value's layout, else a read
            // through the inferred `Map<string, V>` derefs the wrong shape
            // (the map analog of list-element checking).
            let after = check_map_values_against(lr.tc, lr.types, v_ty)
            tc_er(after, ValueType.Map(ValueType.Str, v_ty))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

/// Codegen hook for `MapLit`. Pattern-matches the AST node and
/// forwards to `emit_map_lit`.
fn map_lit_emit_expr(ctx: Ctx, env: List<VarBinding>, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .MapLit(entries) -> emit_map_lit(ctx, env, entries)
        _ -> err_emit("expected MapLit")
    }
}
