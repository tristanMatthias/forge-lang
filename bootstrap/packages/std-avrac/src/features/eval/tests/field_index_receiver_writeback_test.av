// xerh — the eval method-dispatch write-back must walk lvalue CHAINS,
// not just bare Idents. `method_result_writeback` used to re-bind only
// an Ident receiver, so `s.xs.push(1)` / `c.kv.set(k, v)` /
// `rows[0].xs.push(3)` inside a @comptime fn evaluated the method and
// silently DISCARDED the updated receiver — diverging from compiled
// in-place semantics. Now a pure Ident/FieldAccess/Index chain is
// rebuilt bottom-up (replace the field / element, recurse on the base,
// re-bind at the root Ident). Non-lvalue receivers (a call result)
// keep the old skip behavior — re-walking them would double-evaluate
// a side-effecting base.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture, write_fixture_and_run}

/// Compile `path` with the metadata fast-path env stripped and return the
/// combined diagnostics — the comptime_map_eval_test pattern for asserting
/// an F-code from a fixture that must fail compilation.
fn fw_compile_diags(path: string, source: string) -> string {
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 compile '${path}' 2>&1 || true")
}

spec "eval mutator write-back walks FieldAccess/Index receiver chains (xerh)" {
    then "struct-field push/set, nested field, and list-element field all persist" {
        let out = write_fixture_and_run("/tmp/avra_eval_field_index_writeback.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Bag = { xs: List<int> }\n" +
            "type Cfg = { kv: Map<string, int> }\n" +
            "type Inner = { xs: List<int> }\n" +
            "type Outer = { inner: Inner }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    mut score = 0\n" +
            "    mut s = Bag { xs: [] }\n" +
            "    s.xs.push(1)\n" +
            "    if s.xs.length == 1 { score = score + 1 }\n" +
            "    if s.xs[0] == 1 { score = score + 1 }\n" +
            "    s.xs.push(2)\n" +
            "    if s.xs.length == 2 { score = score + 1 }\n" +
            "    if s.xs[1] == 2 { score = score + 1 }\n" +
            "    mut c = Cfg { kv: {} }\n" +
            "    c.kv.set(\"a\", 5)\n" +
            "    if c.kv.get(\"a\") == 5 { score = score + 1 }\n" +
            "    c.kv.set(\"b\", 6)\n" +
            "    c.kv.remove(\"a\")\n" +
            "    if c.kv.len() == 1 { score = score + 1 }\n" +
            "    if c.kv.has(\"a\") { } else { score = score + 1 }\n" +
            "    if c.kv.get(\"b\") == 6 { score = score + 1 }\n" +
            "    mut o = Outer { inner: Inner { xs: [] } }\n" +
            "    o.inner.xs.push(9)\n" +
            "    if o.inner.xs.length == 1 { score = score + 1 }\n" +
            "    if o.inner.xs[0] == 9 { score = score + 1 }\n" +
            "    mut rows = [Inner { xs: [] }, Inner { xs: [7] }]\n" +
            "    rows[0].xs.push(3)\n" +
            "    if rows[0].xs.length == 1 { score = score + 1 }\n" +
            "    if rows[0].xs[0] == 3 { score = score + 1 }\n" +
            "    if rows[1].xs.length == 1 { score = score + 1 }\n" +
            "    if rows[1].xs[0] == 7 { score = score + 1 }\n" +
            "    mut ms = [{\"a\": 1}]\n" +
            "    ms[0].set(\"b\", 2)\n" +
            "    if ms[0].len() == 2 { score = score + 1 }\n" +
            "    if ms[0].get(\"b\") == 2 { score = score + 1 }\n" +
            "    match score {\n" +
            "        16 -> return [synth_stmt_id(quote stmt { println(\"FIELD_INDEX_WRITEBACK_OK\") })]\n" +
            "        _ -> return [synth_stmt_id(quote stmt { println(\"FIELD_INDEX_WRITEBACK_BAD\") })]\n" +
            "    }\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("FIELD_INDEX_WRITEBACK_OK")
    }
    then "a non-lvalue receiver (call result) still skips the write-back cleanly" {
        let out = write_fixture_and_run("/tmp/avra_eval_nonlvalue_writeback_skip.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Inner = { xs: List<int> }\n" +
            "@comptime\n" +
            "fn make_inner() -> Inner { return Inner { xs: [] } }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    mut score = 0\n" +
            "    make_inner().xs.push(1)\n" +
            "    score = score + 1\n" +
            "    if make_inner().xs.length == 0 { score = score + 1 }\n" +
            "    match score {\n" +
            "        2 -> return [synth_stmt_id(quote stmt { println(\"NONLVALUE_SKIP_OK\") })]\n" +
            "        _ -> return [synth_stmt_id(quote stmt { println(\"NONLVALUE_SKIP_BAD\") })]\n" +
            "    }\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("NONLVALUE_SKIP_OK")
    }
    // Skip-path coverage. Of writeback_lvalue's null guards, only two are
    // reachable end-to-end; the rest error BEFORE the mutator runs:
    //   - `let s; s.xs.push(1)` / `let c; c.kv.set(...)` — the resolver's
    //     static mutability gate rejects a FieldAccess chain on a `let`
    //     root as F3001 (pinned below), so the eval-side immutable-root
    //     skip is unreachable through a FieldAccess fixture.
    //   - an out-of-range Index or a missing field on the RECEIVER fails
    //     the dispatch-site probe (eval_call evaluates the receiver before
    //     the method runs) with a clean F4005 (pinned below) — never a
    //     silent skip, so writeback_lvalue's own bounds / missing-field
    //     guards are defensive depth for the probe→write-back window
    //     (an arg reshaping the base), which no fixture can express.
    then "immutable `let` root behind an Index chain skips the write-back gracefully" {
        // The static F3001 gate only sees FieldAccess roots, so an Index
        // chain on a `let` binding reaches eval: the walk bottoms out at
        // assign_binding, which refuses the immutable re-bind → skip.
        let out = write_fixture_and_run("/tmp/avra_eval_let_index_writeback_skip.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    mut score = 0\n" +
            "    let ms = [{\"a\": 1}]\n" +
            "    ms[0].set(\"b\", 2)\n" +
            "    score = score + 1\n" +
            "    if ms[0].len() == 1 { score = score + 1 }\n" +
            "    if ms[0].get(\"a\") == 1 { score = score + 1 }\n" +
            "    match score {\n" +
            "        3 -> return [synth_stmt_id(quote stmt { println(\"LET_INDEX_SKIP_OK\") })]\n" +
            "        _ -> return [synth_stmt_id(quote stmt { println(\"LET_INDEX_SKIP_BAD\") })]\n" +
            "    }\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("LET_INDEX_SKIP_OK")
    }
    then "a computed (impure) subscript in the receiver skips the write-back gracefully" {
        // `rows[zero()].xs` probes fine at dispatch, but the write-back's
        // pure-lvalue gate rejects the Call subscript (re-evaluating it
        // could double a side effect) — conservative skip, no crash.
        let out = write_fixture_and_run("/tmp/avra_eval_impure_subscript_skip.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Inner = { xs: List<int> }\n" +
            "@comptime\n" +
            "fn zero() -> int { return 0 }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    mut score = 0\n" +
            "    mut rows = [Inner { xs: [] }]\n" +
            "    rows[zero()].xs.push(1)\n" +
            "    score = score + 1\n" +
            "    if rows[0].xs.length == 0 { score = score + 1 }\n" +
            "    match score {\n" +
            "        2 -> return [synth_stmt_id(quote stmt { println(\"IMPURE_SUB_SKIP_OK\") })]\n" +
            "        _ -> return [synth_stmt_id(quote stmt { println(\"IMPURE_SUB_SKIP_BAD\") })]\n" +
            "    }\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("IMPURE_SUB_SKIP_OK")
    }
    then "a `let` root reached via FieldAccess is rejected statically (F3001) before eval" {
        let out = fw_compile_diags("/tmp/avra_eval_let_field_writeback_f3001.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Bag = { xs: List<int> }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    let s = Bag { xs: [] }\n" +
            "    s.xs.push(1)\n" +
            "    return [synth_stmt_id(quote stmt { println(\"UNREACHED\") })]\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("F3001") && out.contains("cannot call mutating method `push` on immutable variable `s`")
    }
    then "an out-of-range Index receiver fails the dispatch probe with a clean F4005, not a crash" {
        let out = fw_compile_diags("/tmp/avra_eval_oob_index_receiver_f4005.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Inner = { xs: List<int> }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    mut rows = [Inner { xs: [] }]\n" +
            "    rows[5].xs.push(1)\n" +
            "    return [synth_stmt_id(quote stmt { println(\"UNREACHED\") })]\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("F4005") && out.contains("index 5 out of range (length=1)")
    }
    then "a missing-field receiver fails the dispatch probe with a clean F4005, not a crash" {
        let out = fw_compile_diags("/tmp/avra_eval_missing_field_receiver_f4005.av",
            "use @std.avrac.core.{StmtId}\n" +
            "use @std.avrac.features.comptime.{synth_stmt_id}\n" +
            "type Bag = { xs: List<int> }\n" +
            "@comptime\n" +
            "fn build() -> List<StmtId> {\n" +
            "    mut s = Bag { xs: [] }\n" +
            "    s.nope.push(1)\n" +
            "    return [synth_stmt_id(quote stmt { println(\"UNREACHED\") })]\n" +
            "}\n" +
            "@expand(build)\n" +
            "fn placeholder() {}\n" +
            "fn main() {}\n")
        out.contains("F4005") && out.contains("no such field `nope` on struct value")
    }
}
