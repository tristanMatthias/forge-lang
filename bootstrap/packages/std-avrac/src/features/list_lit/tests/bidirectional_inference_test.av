// so07.4 (T4): bidirectional inference for list literals.
//
// Before T4: empty list literals typed as `List<Unknown>` regardless
// of context; only the assignable_with_unknowns wildcard hack let
// `let xs: List<int> = []` typecheck.
//
// After T4: when the position has a known expected `List<T>`, the
// literal types as `List<T>` directly. The wildcard hack becomes
// vestigial (defense in depth, not load-bearing) for these cases.

fn t4_first_or_zero(xs: List<int>) -> int {
    if xs.length == 0 { 0 } else { xs.get(0) }
}

fn t4_describe(xs: List<string>) -> string {
    if xs.length == 0 { "empty" } else { "non-empty" }
}

// match-position bidirectional: arm body `[]` inherits seed's
// element type from the fn's declared return.
fn t4_match_body_empty(flag: bool) -> List<int> {
    match flag {
        true  -> [9]
        false -> []
    }
}

// when-position bidirectional.
fn t4_when_body_empty(flag: bool) -> List<string> {
    when {
        flag -> ["a", "b"]
        true -> []
    }
}

spec "so07.4: bidirectional inference for list literals" {
    then "let xs: List<int> = [] types as List<int>" {
        let xs: List<int> = []
        // If T4 worked, this call typechecks (param is List<int>).
        // Pre-T4 it also worked via the assignable_with_unknowns
        // wildcard hack, but the binding's recorded type is now the
        // declared one, not List<Unknown>.
        t4_first_or_zero(xs) == 0
    }
    then "let ys: List<string> = [] types as List<string>" {
        let ys: List<string> = []
        t4_describe(ys) == "empty"
    }
    then "match arm body `[]` inherits seed element type" {
        t4_match_body_empty(false).length == 0
    }
    then "match arm with non-empty list still works" {
        t4_match_body_empty(true).length == 1
    }
    then "when arm body `[]` inherits first_ty element type" {
        t4_when_body_empty(false).length == 0
    }
    then "when arm with non-empty list still works" {
        t4_when_body_empty(true).length == 2
    }
    then "mut binding with annotation accepts push" {
        mut xs: List<int> = []
        xs.push(1)
        xs.push(2)
        xs.length == 2
    }
}
