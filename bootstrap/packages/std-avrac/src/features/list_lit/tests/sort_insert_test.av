// rlb4: List<T> gained `.sort(cmp)` and `.insert(idx, value)`
// codegen paths. Smoke-test the basic shapes — sort by ascending,
// sort by descending, insert at head/tail/middle, sort + insert
// composed.

fn cmp_asc(a: int, b: int) -> int { a - b }
fn cmp_desc(a: int, b: int) -> int { b - a }

spec "List.sort: ascending integer order" {
    then "[3, 1, 4, 1, 5, 9, 2, 6] sorts ascending" {
        mut xs = [3, 1, 4, 1, 5, 9, 2, 6]
        xs.sort(cmp_asc)
        xs[0] == 1 && xs[1] == 1 && xs[2] == 2 && xs[3] == 3 &&
        xs[4] == 4 && xs[5] == 5 && xs[6] == 6 && xs[7] == 9
    }
    then "sort returns the same list (chains)" {
        mut xs = [3, 1, 2]
        let ys = xs.sort(cmp_asc)
        ys[0] == 1 && ys[2] == 3
    }
    then "empty list sorts to empty" {
        mut xs: List<int> = []
        xs.sort(cmp_asc)
        xs.length == 0
    }
    then "single-element list is a no-op" {
        mut xs = [42]
        xs.sort(cmp_asc)
        xs[0] == 42 && xs.length == 1
    }
}

spec "List.sort: descending via swapped comparator" {
    then "[1, 5, 3] sorts to [5, 3, 1]" {
        mut xs = [1, 5, 3]
        xs.sort(cmp_desc)
        xs[0] == 5 && xs[1] == 3 && xs[2] == 1
    }
}

spec "List.insert: positional insertion" {
    then "insert at 0 prepends" {
        mut xs = [2, 3]
        xs.insert(0, 1)
        xs[0] == 1 && xs[1] == 2 && xs[2] == 3 && xs.length == 3
    }
    then "insert at length appends" {
        mut xs = [1, 2]
        xs.insert(2, 3)
        xs[0] == 1 && xs[1] == 2 && xs[2] == 3 && xs.length == 3
    }
    then "insert in middle shifts later elements right" {
        mut xs = [1, 3, 4]
        xs.insert(1, 2)
        xs[0] == 1 && xs[1] == 2 && xs[2] == 3 && xs[3] == 4 && xs.length == 4
    }
    then "insert into empty list seeds the first element" {
        mut xs: List<int> = []
        xs.insert(0, 99)
        xs[0] == 99 && xs.length == 1
    }
    then "insert returns the same list (chains)" {
        mut xs = [1, 3]
        let ys = xs.insert(1, 2)
        ys[1] == 2 && ys.length == 3
    }
}

spec "List.sort: sort-then-insert composes" {
    then "insert into a sorted list and re-sort" {
        mut xs = [5, 2, 8]
        xs.sort(cmp_asc)
        xs.insert(0, 99)
        xs.sort(cmp_asc)
        xs[0] == 2 && xs[1] == 5 && xs[2] == 8 && xs[3] == 99
    }
}
