spec "list ops" {
    then "list length" {
        let nums = [10, 20, 30]
        nums.length == 3
    }
    then "list indexing" {
        let nums = [10, 20, 30]
        nums[0] == 10 && nums[1] == 20 && nums[2] == 30
    }
    then "push increases length" {
        mut nums = [10, 20, 30]
        nums.push(40)
        nums.length == 4 && nums[3] == 40
    }
    then "pop returns last" {
        mut nums = [10, 20, 30, 40]
        let last = nums.pop()
        last == 40 && nums.length == 3
    }
    then "empty list" {
        let empty = []
        empty.length == 0
    }
    // `clear` was in the method vocabulary (resolve/mod.av) with no codegen arm, so
    // reaching it was an ICE rather than a diagnostic — green in every test because
    // nothing in the tree called it. It is the one list method whose absence a spec
    // could not have caught, which is exactly why it gets one now.
    then "clear empties the list in place" {
        mut nums = [10, 20, 30]
        nums.clear()
        nums.length == 0
    }
    then "clear leaves the list usable" {
        mut nums = [10, 20, 30]
        nums.clear()
        nums.push(99)
        nums.length == 1 && nums[0] == 99
    }
    // The RETURN VALUE, which every case above discards: `clear` hands back the same
    // `List<T>` so it can sit mid-chain, and nothing exercised that.
    then "clear is chainable — the returned list is the same list" {
        mut nums = [10, 20, 30]
        nums.clear().push(99)
        nums.length == 1 && nums[0] == 99
    }
    then "list sum via loop" {
        let nums = [10, 20, 30]
        mut sum = 0
        for i in 0..nums.length {
            sum = sum + nums[i]
        }
        sum == 60
    }
}
