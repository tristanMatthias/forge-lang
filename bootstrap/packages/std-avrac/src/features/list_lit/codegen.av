// WHY: codegen for list literals [1, 2, 3] and list higher-order methods.
// Lists are backed by the C-runtime avra_array_* functions.

use core.{vtype_is_str_repr, Expr, ExprId, VarBinding, ValueType, vtype_list_elem, vtype_fn_ret, vtype_pair_list}
use codegen.{Ctx, EmitValue, ok_emit, err_emit, emit_optional_coerce, box_into_list}
use codegen.{optional_repr_tagged, emit_optional_some, emit_optional_none}
use features.closures.{emit_lambda_typed, emit_typed_lambda_arg}
use codegen.{emit_single_arg}

/// True when an element expression is the absence literal `none`.
fn lit_is_none(e: Expr) -> bool { e is .None }

/// Codegen for `[a, b, c]`. Allocates a fresh `avra_array_new` and
/// pushes each element. The first element pins the inferred element type.
///
/// A literal that mixes `none` with present values is a `List<T?>`, not a
/// `List<T>`: each present element must be coerced into the tagged-optional
/// repr (boxed for `int?` / `bool?` / `float?`; identity for the
/// pointer-niche reprs) so a later unwrap sees a real optional, not a raw
/// scalar reinterpreted as a box pointer. `emit_optional_coerce` is a no-op
/// for `none` (stays null) and for already-optional values (no double-box).
export fn emit_list_lit(ctx: Ctx, env: List<VarBinding>, elements: List<ExprId>) -> Result<EmitValue, string> {
    if elements.length == 0 { return ok_emit(ctx.array_new(), .List(.Unknown)) }
    mut has_none = false
    mut n = 0
    while n < elements.length {
        if lit_is_none(ctx.nodes.exprs.get(elements[n])) { has_none = true }
        n = n + 1
    }
    // A literal mixing `none` with present values is a `List<T?>`: emit all
    // elements, then box via the shared `box_into_list` (inner inferred).
    if has_none {
        return emit_list_lit_expected(ctx, env, elements, .Optional(.Unknown))
    }
    let arr = ctx.array_new()
    let first_r = ctx.emit(env, ctx.nodes.exprs.get(elements[0]))?
    ctx.array_push(arr, first_r.value)
    let elem_ty = first_r.ty
    mut i = 1
    while i < elements.length {
        let r = ctx.emit(env, ctx.nodes.exprs.get(elements[i]))?
        ctx.array_push(arr, r.value)
        i = i + 1
    }
    ok_emit(arr, .List(elem_ty))
}

/// Codegen for a list literal whose `T?` element type is known from context
/// (an annotated `let xs: List<int?> = [1, 2, 3]`, a `List<T?>` call arg, or
/// a `none`-bearing literal via `.Optional(.Unknown)`). Emits each element,
/// then boxes via the shared `box_into_list` — the one list-of-optional box
/// loop. `expected_elem` is the optional element type (`.Optional(inner)`).
export fn emit_list_lit_expected(ctx: Ctx, env: List<VarBinding>, elements: List<ExprId>, expected_elem: ValueType) -> Result<EmitValue, string> {
    mut vals: List<EmitValue> = []
    mut i = 0
    while i < elements.length {
        vals.push(ctx.emit(env, ctx.nodes.exprs.get(elements[i]))?)
        i = i + 1
    }
    box_into_list(ctx, vals, expected_elem)
}

/// Codegen for `list.reduce(init, fn)`. Compiles the lambda
/// against `(acc_ty, elem_ty)` so generic-typed reducers see the
/// correct types inside the body. Hands the closure to
/// `avra_array_reduce`.
export fn emit_list_reduce_typed(ctx: Ctx, env: List<VarBinding>, list_val: ptr, args: List<ExprId>, elem_ty: ValueType) -> Result<EmitValue, string> {
    if args.length < 2 { return err_emit("reduce expects 2 arguments: initial value and function") }
    let init_id = args[0]
    let fn_id = args[1]
    let init_r = ctx.emit(env, ctx.nodes.exprs.get(init_id))?
    // Reduce fn takes (acc, elem) — acc type from init, elem from list
    mut fn_r = EmitValue { value: ctx.i64(0), ty: .Int }
    match ctx.nodes.exprs.get(fn_id) {
        .Lambda(params, body) -> {
            mut reduce_param_types: List<ValueType> = []
            reduce_param_types.push(init_r.ty)
            reduce_param_types.push(elem_ty)
            fn_r = emit_lambda_typed(ctx, env, params, ctx.nodes.exprs.get(body), reduce_param_types, ValueType.Unknown)?
        }
        _ -> {
            fn_r = ctx.emit(env, ctx.nodes.exprs.get(fn_id))?
        }
    }
    let result = ctx.call("avra_array_reduce", [list_val, init_r.value, fn_r.value])
    ok_emit(result, .Int)
}

/// Dispatch a method call on a List value. Maps method names
/// to the appropriate `avra_array_*` runtime call (or, for
/// higher-order methods, builds a typed lambda first). Unknown
/// methods produce a "not implemented" error.
export fn emit_list_method_call(ctx: Ctx, env: List<VarBinding>, list_val: ptr, list_ty: ValueType, method: string, args: List<ExprId>) -> Result<EmitValue, string> {
    match method {
        "length" or "len" -> return ok_emit(ctx.array_len(list_val), .Int)
        "push" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            // Box a present scalar into the list's `T?` element type — a raw
            // `xs.push(5)` into a `List<int?>` must store a non-null box, not a
            // bare 0/value that a later unwrap would deref as a box pointer.
            let pushed = emit_optional_coerce(ctx, arg_r, vtype_list_elem(list_ty))
            ctx.array_push(list_val, pushed.value)
            return ok_emit(list_val, list_ty)
        }
        "pop" -> {
            let elem_ty = vtype_list_elem(list_ty)
            return ok_emit(ctx.call("avra_array_pop", [list_val]), elem_ty)
        }
        // Truncates in place and yields the (now empty) list, so `xs.clear()` reads as a
        // statement and still chains like `push` does. `clear` was in the method
        // vocabulary with no codegen arm, which made it an ICE rather than a diagnostic.
        "clear" -> {
            ctx.call("avra_array_clear", [list_val])
            return ok_emit(list_val, list_ty)
        }
        "get" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            let elem_ty = vtype_list_elem(list_ty)
            return ok_emit(ctx.array_get(list_val, arg_r.value), elem_ty)
        }
        "set" -> return emit_list_set(ctx, env, list_val, list_ty, args)
        "map" -> {
            let elem_ty = vtype_list_elem(list_ty)
            mut map_param_types: List<ValueType> = []
            map_param_types.push(elem_ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, map_param_types)?
            let result = ctx.call("avra_array_map", [list_val, arg_r.value])
            return ok_emit(result, .List(vtype_fn_ret(arg_r.ty)))
        }
        "filter" -> {
            let elem_ty = vtype_list_elem(list_ty)
            mut filter_param_types: List<ValueType> = []
            filter_param_types.push(elem_ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, filter_param_types)?
            return ok_emit(ctx.call("avra_array_filter", [list_val, arg_r.value]), .List(elem_ty))
        }
        "foreach" -> {
            let elem_ty = vtype_list_elem(list_ty)
            mut foreach_param_types: List<ValueType> = []
            foreach_param_types.push(elem_ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, foreach_param_types)?
            ctx.call("avra_array_foreach", [list_val, arg_r.value])
            return ok_emit(ctx.i64(0), .Int)
        }
        "reduce" -> {
            let elem_ty = vtype_list_elem(list_ty)
            return emit_list_reduce_typed(ctx, env, list_val, args, elem_ty)
        }
        // t-xpi0: STRING elements need VALUE equality. The plain runtime forms
        // compare `data[i] == value`, i.e. by identity — right for int/bool/enum
        // tags, wrong for strings, where two equal strings at different
        // addresses compared unequal. `contains` therefore DISAGREED with `==`
        // for any needle built at runtime (concatenation, substring, trim, a
        // file read, a split); literals hid it by interning to one pointer.
        // Silent, and in the "not present" direction, so dedup loops kept
        // duplicates and membership guards passed vacuously.
        //
        // Dispatched HERE because the element type is known statically, so the
        // scalar paths keep their single-compare loop at no cost.
        "contains" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            // `vtype_is_str_repr`, NOT `is .Str` and NOT `vtype_is_str`: a
            // `List<RuleName>` holds strings and must compare BY VALUE. The bare
            // variant check picked the IDENTITY helper for every newtype element,
            // so membership answered false for equal strings at different
            // addresses — the same class as t-xpi0.
            //
            // `vtype_is_str` is the IDENTITY question and stays false for a
            // newtype; only the `_repr` form peels the wrapper. Using the wrong
            // one here silently restores the bug.
            let fname = if vtype_is_str_repr(vtype_list_elem(list_ty)) { "avra_array_contains_str" } else { "avra_array_contains" }
            return ok_emit(ctx.call(fname, [list_val, arg_r.value]), .Bool)
        }
        "index_of" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            let fname = if vtype_is_str_repr(vtype_list_elem(list_ty)) { "avra_array_index_of_str" } else { "avra_array_index_of" }
            return ok_emit(ctx.call(fname, [list_val, arg_r.value]), .Int)
        }
        "reverse" -> {
            return ok_emit(ctx.call("avra_array_reverse", [list_val]), list_ty)
        }
        // rlb4: in-place sort by a `(T, T) -> int` comparator (negative
        // ⇒ first arg sorts earlier). Closure args typed with the
        // element type so `(a: string, b: string) -> ...` infers
        // correctly. Returns the same list so the call chains.
        "sort" -> {
            let elem_ty = vtype_list_elem(list_ty)
            mut sort_param_types: List<ValueType> = []
            sort_param_types.push(elem_ty)
            sort_param_types.push(elem_ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, sort_param_types)?
            return ok_emit(ctx.call("avra_array_sort", [list_val, arg_r.value]), list_ty)
        }
        // rlb4: insert `value` at `idx`, shifting later elements
        // right. `idx == length` appends. Mirrors Python's
        // list.insert / Rust's Vec::insert.
        "insert" -> {
            let elem_ty = vtype_list_elem(list_ty)
            if args.length < 2 { return err_emit("list.insert expects 2 arguments: index and value") }
            let idx_r = ctx.emit(env, ctx.nodes.exprs.get(args[0]))?
            let val_r = ctx.emit(env, ctx.nodes.exprs.get(args[1]))?
            // Box a present scalar into the list's `T?` element type (see push).
            let ins = emit_optional_coerce(ctx, val_r, elem_ty)
            ctx.call("avra_array_insert", [list_val, idx_r.value, ins.value])
            return ok_emit(list_val, list_ty)
        }
        // ryvy: `xs.enumerate()` -> List<(int, T)>. Pairs each element
        // with its zero-based index so `for (i, x) in xs.enumerate()`
        // can destructure both. Each pair is a 2-slot tuple buffer.
        "enumerate" -> {
            return ok_emit(ctx.call("avra_array_enumerate", [list_val]), vtype_pair_list(.Int, vtype_list_elem(list_ty)))
        }
        // ryvy: `a.zip(b)` -> List<(A, B)>, truncated to the shorter
        // input. Backs `for (x, y) in a.zip(b)` for parallel iteration.
        "zip" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            return ok_emit(ctx.call("avra_array_zip", [list_val, arg_r.value]), vtype_pair_list(vtype_list_elem(list_ty), vtype_list_elem(arg_r.ty)))
        }
        // A predicate scan can miss, and `first`/`last` can see an empty
        // list, so all three answer `T?` (built by `emit_list_opt_at`).
        "find" -> {
            let elem_ty = vtype_list_elem(list_ty)
            mut find_param_types: List<ValueType> = []
            find_param_types.push(elem_ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, find_param_types)?
            let idx = ctx.call("avra_array_find_idx", [list_val, arg_r.value])
            let present = ctx.sge(idx, ctx.i64(0), "find_has")
            return emit_list_opt_at(ctx, list_val, elem_ty, idx, present)
        }
        "first" -> {
            let present = ctx.sgt(ctx.array_len(list_val), ctx.i64(0), "first_has")
            return emit_list_opt_at(ctx, list_val, vtype_list_elem(list_ty), ctx.i64(0), present)
        }
        "last" -> {
            let len = ctx.array_len(list_val)
            let present = ctx.sgt(len, ctx.i64(0), "last_has")
            let idx = ctx.sub(len, ctx.i64(1), "last_idx")
            return emit_list_opt_at(ctx, list_val, vtype_list_elem(list_ty), idx, present)
        }
        "any" or "all" -> {
            let elem_ty = vtype_list_elem(list_ty)
            mut pred_param_types: List<ValueType> = []
            pred_param_types.push(elem_ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, pred_param_types)?
            let fname = if method == "any" { "avra_array_any" } else { "avra_array_all" }
            return ok_emit(ctx.call(fname, [list_val, arg_r.value]), .Bool)
        }
        "is_empty" -> return ok_emit(ctx.eq(ctx.array_len(list_val), ctx.i64(0), "lst_empty"), .Bool)
        "slice" -> return emit_list_slice(ctx, env, list_val, list_ty, args)
        "join" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            let sep_ptr = ctx.to_ptr(arg_r.value, "join_sep")
            return ok_emit(ctx.call("avra_str_join", [list_val, sep_ptr]), .Str)
        }
        _ -> err_emit("list method `${method}` not implemented")
    }
}

/// Codegen for `list.slice(start, end)`. Emits both bounds and
/// hands them to `avra_array_slice`. Result type matches the
/// input — slicing a `List<T>` produces a `List<T>`.
fn emit_list_slice(ctx: Ctx, env: List<VarBinding>, list: ptr, list_ty: ValueType, args: List<ExprId>) -> Result<EmitValue, string> {
    if args.length < 2 { return err_emit("list.slice expects 2 arguments: start and end") }
    let start_r = ctx.emit(env, ctx.nodes.exprs.get(args[0]))?
    let end_r = ctx.emit(env, ctx.nodes.exprs.get(args[1]))?
    ok_emit(ctx.call("avra_array_slice", [list, start_r.value, end_r.value]), list_ty)
}

/// An `elem?` from `list[idx]`, guarded by `present`. Repr per spec
/// Axis 10 §3 (see map_lit's `emit_map_get`): a pointer-backed element
/// uses the null-pointer niche, a value scalar boxes via
/// `emit_optional_some` so `Some(0)` ≠ none. The fetch stays inside
/// the present branch — `avra_array_get` traps out of bounds.
fn emit_list_opt_at(ctx: Ctx, list_val: ptr, elem_ty: ValueType, idx: ptr, present: ptr) -> Result<EmitValue, string> {
    let opt_ty = ValueType.Optional(elem_ty)
    let slot = ctx.alloca_i64("lstopt_slot")
    let merge_bb = ctx.bb("lstopt_end")
    let else_bb = ctx.if_true(present, "lstopt")
    let raw = ctx.call("avra_array_get", [list_val, idx])
    let some_val = if optional_repr_tagged(elem_ty) {
        ctx.to_i64(emit_optional_some(ctx, elem_ty, raw), "lstopt_some")
    } else {
        raw
    }
    ctx.store_br_if_open(some_val, slot, merge_bb)
    ctx.position(else_bb)
    ctx.store_br_if_open(emit_optional_none(ctx), slot, merge_bb)
    ctx.position(merge_bb)
    let merged = ctx.load_i64(slot, "lstopt_val")
    if optional_repr_tagged(elem_ty) { ok_emit(merged, opt_ty) }
    else { ok_emit(ctx.cast_to(merged, opt_ty), opt_ty) }
}

/// Codegen for `list.set(idx, val)`. Emits both args and forwards
/// to `avra_array_set`. Returns the list (so the call chains). The value is
/// boxed into the list's `T?` element type (see push) before storing.
fn emit_list_set(ctx: Ctx, env: List<VarBinding>, list: ptr, list_ty: ValueType, args: List<ExprId>) -> Result<EmitValue, string> {
    if args.length < 2 { return err_emit("list.set expects 2 arguments: index and value") }
    let idx_r = ctx.emit(env, ctx.nodes.exprs.get(args[0]))?
    let val_r = ctx.emit(env, ctx.nodes.exprs.get(args[1]))?
    let stored = emit_optional_coerce(ctx, val_r, vtype_list_elem(list_ty))
    ctx.call("avra_array_set", [list, idx_r.value, stored.value])
    ok_emit(list, list_ty)
}
