// WHY: parses list literal `[expr, ...]` and list comprehension
// `[expr for x in collection if? filter]`. A comprehension is
// returned as a single-element element list whose only entry is
// the bare `Expr.ListComp`; the caller in `parse/mod.av` unwraps
// it so the comp doesn't get a spurious `ListLit` wrapper.

use core.{Expr, ExprId}
use parse.{Parser, ArgListIds}
use core.{Tk}

impl Parser {
    fn parse_list_elements(self) -> Result<ArgListIds, string> {
        let sp_start = self.current_start
        mut ids: List<ExprId> = []
        let expr_id = self.parse_expression()?

        // List comprehension: [expr for x in collection if? filter]
        if self.check(Tk.KwFor) {
            self.advance()
            let var_name = self.consume_identifier("expected variable name after `for`")?
            if !self.consume(Tk.KwIn, "expected `in` after comprehension variable") { return .Err("parse error") }
            let collection_id = self.parse_expression()?
            // Flipped ListComp holds body/collection/filter as ExprId scalars —
            // all walker-opaque, so the comp is a leaf row.
            mut filter: ExprId? = none
            if self.check(Tk.KwIf) {
                self.advance()
                filter = self.parse_expression()?
            }
            let comp = Expr.ListComp(expr_id, var_name, collection_id, filter)
            let comp_id = self.alloc_at(comp, sp_start)
            ids.push(comp_id)
            return .Ok(ArgListIds { ids: ids })
        }

        ids.push(expr_id)
        // Regular list elements — accumulate in source order
        while self.check(Tk.Comma) {
            self.advance()
            if self.check(Tk.RightBracket) { return .Ok(ArgListIds { ids: ids }) }
            let next_id = self.parse_expression()?
            ids.push(next_id)
        }
        .Ok(ArgListIds { ids: ids })
    }
}
