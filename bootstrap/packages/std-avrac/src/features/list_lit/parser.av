// WHY: parses list literal `[expr, ...]` and list comprehension
// `[expr for x in collection if? filter]`.
// Comprehensions produce Expr.ListComp — desugared by desugar/mod.av.

use core.{Expr, ExprList, SExpr, sexpr}
use parse.{Parser}
use core.{Tk}

impl Parser {
    fn parse_list_elements(self) -> ExprList? {
        let expr = self.parse_expression()?

        // List comprehension: [expr for x in collection if? filter]
        if self.check(Tk.KwFor) {
            self.advance()
            let var_name = self.consume_identifier("expected variable name after `for`")?
            if !self.consume(Tk.KwIn, "expected `in` after comprehension variable") { return null }
            let collection = self.parse_expression()?
            let filter: Expr? = if self.check(Tk.KwIf) {
                self.advance()
                self.parse_expression()?
            } else { null }
            // Wrap in a single-element ExprList. The caller wraps in ListLit.
            // The desugar pass recognizes ListLit containing a ListComp and
            // replaces the entire ListLit with the desugared Block.
            let comp = Expr.ListComp(expr, var_name, collection, filter)
            return ExprList.Node(sexpr(comp, self.current_line, self.current_column), ExprList.End)
        }

        // Regular list elements
        if self.check(Tk.Comma) {
            self.advance()
            if self.check(Tk.RightBracket) {
                return ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
            }
            let rest = self.parse_list_elements()?
            return ExprList.Node(sexpr(expr, self.current_line, self.current_column), rest)
        }
        ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
    }
}
