// WHY: type checking for list literals and list method calls.

use core.{Expr, SExpr, ValueType, vtype_list_elem, vtype_is_unknown}
use typeck.{TC, ExprResult, tc_er, tc_enter, tc_exit, tc_bind, check_expr, check_expr_list}

/// Type-check a list literal. Empty literals get `List<Unknown>`
/// (caller infers from context); non-empty literals pin the element
/// type from the first element and check the rest against it.
export fn check_list_lit(tc: TC, elements: List<SExpr>) -> ExprResult {
    if elements.length == 0 { return tc_er(tc, .List(.Unknown)) }
    let r = check_expr(tc, elements[0].node)
    let checked = check_expr_list(r.tc, elements)
    tc_er(checked, .List(r.ty))
}

/// Bidirectional variant: when the caller knows the expected element
/// type (e.g. from a `let xs: List<T> = ...` annotation, a match-arm
/// position where the seed is List<T>, or a fn argument typed
/// List<T>), the empty literal types as `List<T>` instead of
/// `List<Unknown>`. Non-empty literals still infer from elements;
/// callers rely on the broader vtype_assignable check to unify with
/// the expected type, so we don't force element-by-element checks
/// against `expected_elem` yet. so07.4 (T4).
export fn check_list_lit_with_expected(tc: TC, elements: List<SExpr>, expected_elem: ValueType) -> ExprResult {
    if elements.length == 0 {
        let elem = if vtype_is_unknown(expected_elem) { ValueType.Unknown } else { expected_elem }
        return tc_er(tc, .List(elem))
    }
    check_list_lit(tc, elements)
}

/// Map a List method name to its result ValueType. `map` is
/// special-cased: result is `List<Ret>` where `Ret` is inferred
/// from the lambda body. Unknown methods return `.Unknown` so the
/// codegen path can surface them as errors.
export fn check_list_method(tc: TC, elem: ValueType, method: string, args: List<SExpr>) -> ExprResult {
    match method {
        "length" or "len"                          -> tc_er(tc, .Int)
        "reduce"                                   -> tc_er(tc, .Unknown)
        // `push` and `set` return the list itself per codegen
        // (features/list_lit/codegen.av: ok_emit(list_val, list_ty)).
        // Returning .List(elem) here lets callers chain or re-assign
        // (`mut xs: List<T> = ...; xs = xs.push(v); xs.length`)
        // without losing the element type. `foreach` is genuinely
        // void — it returns nothing useful.
        "push" or "set"                          -> tc_er(tc, .List(elem))
        "foreach"                                -> tc_er(tc, .Void)
        "pop" or "get"                           -> tc_er(tc, elem)
        "filter"                                 -> tc_er(tc, .List(elem))
        "map"                                    -> tc_er(tc, .List(tc_infer_lambda_ret(tc, args, elem)))
        _                                        -> tc_er(tc, .Unknown)
    }
}

/// Walk into a `map(lambda)` argument and recover the lambda's
/// return type by entering a fresh scope with its single param
/// bound to the list's element type, then checking the body.
fn tc_infer_lambda_ret(tc: TC, args: List<SExpr>, elem_ty: ValueType) -> ValueType {
    if args.length == 0 { return .Unknown }
    match args[0].node {
        .Lambda(params, body) -> {
            let inner = tc_enter(tc)
            let with_params = if params.length == 0 { inner } else { tc_bind(inner, params[0].name, elem_ty) }
            let r = check_expr(with_params, body)
            tc_exit(r.tc)
            r.ty
        }
        _ -> .Unknown
    }
}
