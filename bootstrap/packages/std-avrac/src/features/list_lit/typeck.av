// WHY: type checking for list literals and list method calls.

use core.{Expr, ExprId, ValueType, vtype_list_elem, vtype_pair_list, vtype_render_full}
use typeck.{TC, ExprResult, tc_er, tc_enter, tc_exit, tc_bind, check_expr, check_expr_list_types, tc_gate_unthreaded_lambda, tc_report, nested_layout_conflict}
use diagnostics.{DiagCode}

/// Type-check a list literal. Empty literals get `List<Unknown>`
/// (caller infers from context); non-empty literals pin the element
/// type from the first element and check the rest against it.
export fn check_list_lit(tc: TC, elements: List<ExprId>) -> ExprResult {
    check_list_lit_with_expected(tc, elements, .Unknown)
}

/// Bidirectional list-literal checker. Empty literals adopt
/// `expected_elem` (callers pass `Unknown` when they have no hint).
/// Non-empty literals infer bottom-up from the first element; arm
/// unification then handles the broader assignment via vtype_assignable.
/// so07.4 (T4).
export fn check_list_lit_with_expected(tc: TC, elements: List<ExprId>, expected_elem: ValueType) -> ExprResult {
    if elements.length == 0 { return tc_er(tc, .List(expected_elem)) }
    // Row 13 (ps3t.4.5): list elements never thread param types into a
    // lambda (codegen emits elements with no expected type, even under
    // a `List<fn(…)>` annotation) — annotate or F1006.
    mut gated = tc
    for id in elements {
        gated = tc_gate_unthreaded_lambda(gated, gated.nodes.exprs.get(id))
    }
    let lr = check_expr_list_types(gated, elements)
    // An element whose layout is incompatible with the expected element type must
    // be rejected: BOTH the bare scalar↔ptr case (`[9]` for `List<string>`) and a
    // generic struct-literal element whose args mismatch (`[Box { val: 9 }]` for
    // `List<Box<string>>`). `vtype_eq` ignores generic args and the element-type
    // unification lets either slip into a layout-mismatched slot. `nested_layout_conflict`
    // is the broad element/value check (top-level scalar↔ptr + nested generic-arg),
    // applied to each element against `expected_elem` (Unknown — a non-annotated
    // literal — is never a conflict). Check EVERY element, not just the first
    // (`[Box { val: "ok" }, Box { val: 9 }]` must still flag the second).
    mut after = lr.tc
    mut i = 0
    while i < lr.types.length {
        if nested_layout_conflict(after, lr.types[i], expected_elem) {
            after = tc_report(after, DiagCode.TypeMismatch, "list element of type `${vtype_render_full(lr.types[i])}` conflicts with expected `${vtype_render_full(expected_elem)}` (layout conflict)")
        }
        i = i + 1
    }
    tc_er(after, .List(lr.types[0]))
}

/// Map a List method name to its result ValueType. `map` is
/// special-cased: result is `List<Ret>` where `Ret` is inferred
/// from the lambda body. Unknown methods return `.Unknown` so the
/// codegen path can surface them as errors.
export fn check_list_method(tc: TC, elem: ValueType, method: string, args: List<ExprId>) -> ExprResult {
    match method {
        "length" or "len"                          -> tc_er(tc, .Int)
        "reduce"                                   -> tc_er(tc, .Unknown)
        // `push` and `set` return the list itself per codegen
        // (features/list_lit/codegen.av: ok_emit(list_val, list_ty)).
        // Returning .List(elem) here lets callers chain or re-assign
        // (`mut xs: List<T> = ...; xs = xs.push(v); xs.length`)
        // without losing the element type. `foreach` is genuinely
        // void — it returns nothing useful.
        "push" or "set"                          -> tc_er(tc, .List(elem))
        "foreach"                                -> tc_er(tc, .Void)
        "pop" or "get"                           -> tc_er(tc, elem)
        "filter"                                 -> tc_er(tc, .List(elem))
        "map"                                    -> tc_er(tc, .List(tc_infer_lambda_ret(tc, args, elem)))
        // ryvy: enumerate -> List<(int, T)>; zip -> List<(T, U)> where
        // U is the element type of the argument list.
        "enumerate"                              -> tc_er(tc, vtype_pair_list(.Int, elem))
        "zip"                                    -> check_zip(tc, elem, args)
        _                                        -> tc_er(tc, .Unknown)
    }
}

/// Result type for `a.zip(b)`: `List<(A, B)>`. Recovers B by
/// type-checking the argument expression and reading its element
/// type. With no argument, B is left Unknown (codegen reports the
/// arity error).
fn check_zip(tc: TC, elem: ValueType, args: List<ExprId>) -> ExprResult {
    if args.length == 0 { return tc_er(tc, vtype_pair_list(elem, .Unknown)) }
    let o = check_expr(tc, tc.nodes.exprs.get(args[0]))
    tc_er(o.tc, vtype_pair_list(elem, vtype_list_elem(o.ty)))
}

/// Walk into a `map(lambda)` argument and recover the lambda's
/// return type by entering a fresh scope with its single param
/// bound to the list's element type, then checking the body.
fn tc_infer_lambda_ret(tc: TC, args: List<ExprId>, elem_ty: ValueType) -> ValueType {
    if args.length == 0 { return .Unknown }
    match tc.nodes.exprs.get(args[0]) {
        .Lambda(params, body) -> {
            let inner = tc_enter(tc)
            let with_params = if params.length == 0 { inner } else { tc_bind(inner, params[0].name, elem_ty) }
            let r = check_expr(with_params, with_params.nodes.exprs.get(body))
            tc_exit(r.tc)
            r.ty
        }
        _ -> .Unknown
    }
}
