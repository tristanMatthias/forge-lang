// The list feature's LOWERINGS — the `[`-led family (t-kd4y.3.5.4):
// the literal and the comprehension. One gram owns both rows because
// `list_expr` is ONE alternation whose comprehension branch spells
// MkListComp through the `list_comp` sub-rule (the no-orphans validator
// demands the gram referencing a build own its row) — the closures/paren
// precedent, with list_comp's own definition converting hook-only beside
// it. Imports ONLY features.grammar + core (F4012).
//
// Both rows are `spanned`: MkListLit anchors at the `[` byte (its owning
// list_expr rule's entry), MkListComp at the comprehension BODY's first
// byte (the list_comp sub-rule is entered after `[` — the retired hand
// parser's anchor, kept verbatim). The interpreter's bare adapter call
// reads the -1 span-free default.
use core.{ModulePath, byte_span, Expr, ExprId, TypeExpr}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, bind_rows, capval_to_expr, capval_to_node_list, capval_tok_text, expr_id_is_error, capval_to_texpr, BuildKind}

/// `[a, b, c]` list literal. A FAILED ELEMENT makes the whole literal a
/// failure, mirroring the retired hand `parse_list_elements`, whose
/// `parse_expression()?` propagated: `[1,,2]` built `(list (1, (error),
/// 2))` where the hand yields one `(error)`. Checked here rather than at
/// each element site so both engines share the one rule.
export fn mk_list_lit(st: PState, sp_start: int, acap: CapVal) -> ExprId {
    for __e in capval_to_node_list(acap) {
        if expr_id_is_error(st, __e) { return st.error_node_silent() }
    }
    st.store.add_expr(Expr.ListLit(capval_to_node_list(acap)), byte_span(sp_start, st.cur().pos), [])
}

export fn mk_list_lit_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_list_lit(st, st.build_sp, vals[0]))
}

/// `[ body for v in collection ( if filter )? ]` comprehension.
/// body/collection/filter are ExprId scalars + a nullable filter — all
/// walker-opaque, so the comp is a leaf row (empty edges). `filt_cv` is
/// Nil when the `( if … )?` clause is absent (→ filter none), else the
/// parsed filter expression.
export fn mk_list_comp(st: PState, sp_start: int, body: ExprId, variable: string, collection: ExprId, filt_cv: CapVal) -> ExprId {
    mut filter: ExprId? = none
    match filt_cv {
        .Nil -> {}
        _ -> filter = capval_to_expr(st, filt_cv)
    }
    st.store.add_expr(Expr.ListComp(body, variable, collection, filter), byte_span(sp_start, st.cur().pos), [])
}

export fn mk_list_comp_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_list_comp(st, st.build_sp, capval_to_expr(st, vals[0]), capval_tok_text(vals[1]), capval_to_expr(st, vals[2]), vals[3]))
}

/// BOTH `[`-family rows.
export fn list_lit_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.list_lit.lowering"), [bind_row("MkListLit", BuildKind.Expr, 1, true, "mk_list_lit_abi", mk_list_lit_abi),
     bind_row("MkListComp", BuildKind.Expr, 4, true, "mk_list_comp_abi", mk_list_comp_abi)])
}

/// A `[T]` list type — the `TyList` build's core (t-kd4y.3.5.10): the
/// type-position face of the list family.
export fn mk_list_type(st: PState, elem_cv: CapVal) -> CapVal {
    CapVal.TExpr(TypeExpr.ListType(capval_to_texpr(st, elem_cv)))
}

export fn ty_list_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_list_type(st, vals[0])
}

export fn list_type_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.list_lit.lowering"), [bind_row("TyList", BuildKind.Type, 1, false, "ty_list_abi", ty_list_abi)])
}
