// The engine failsafe for GENERIC decls: derives don't parameterize their
// emitted methods yet, so a decl with type params must fall back untouched
// (no methods) — the pre-engine walker silently emitted methods whose
// `self` type dropped the params, leaving mono/typeck to trip over an
// unparameterized nominal later. Locks DeclView.generic gating.

use @std.avrac.test_runner.{write_fixture_and_run_no_metadata}

spec "derive engine: a generic decl falls back untouched" {
    then "the generic enum compiles and behaves normally, with no derived methods" {
        let out = write_fixture_and_run_no_metadata("/tmp/avra_derive_generic_failsafe_test.av",
            "use @std.avrac.features.derive.{derive_eq}\n" +
            "\n" +
            "@expand(derive_eq)\n" +
            "enum Box<T> {\n" +
            "    Empty\n" +
            "    Full(value: T)\n" +
            "}\n" +
            "\n" +
            "fn main() {\n" +
            "    let b = Box.Full(41)\n" +
            "    match b {\n" +
            "        .Empty -> println(\"empty\")\n" +
            "        .Full(v) -> println(\"full=\" + string(v + 1))\n" +
            "    }\n" +
            "}\n")
        out.contains("full=42")
    }
}
