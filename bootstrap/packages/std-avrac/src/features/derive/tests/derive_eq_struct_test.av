// The eq emitter on a STRUCT — proves the engine's struct path
// (single synthetic variant, `let __eq_a<i> = self.<field>` projections,
// no match) drives the same arm hook that serves enums. Mixed leaf kinds
// (int + string) exercise the `==` leaf comparison across reprs.

use @std.avrac.test_runner.{write_fixture_and_run}

spec "derive_eq: structural equality on a struct" {
    then "field-wise comparison over int + string leaves" {
        let out = write_fixture_and_run("/tmp/avra_derive_eq_struct_test.av",
            "use @std.avrac.features.derive.{derive_eq}\n" +
            "\n" +
            "@expand(derive_eq)\n" +
            "type Pt = { x: int, y: int, tag: string }\n" +
            "\n" +
            "fn main() {\n" +
            "    let a = Pt { x: 1, y: 2, tag: \"origin\" }\n" +
            "    let b = Pt { x: 1, y: 2, tag: \"origin\" }\n" +
            "    let c = Pt { x: 1, y: 2, tag: \"other\" }\n" +
            "    let d = Pt { x: 9, y: 2, tag: \"origin\" }\n" +
            "    println(\"same=\" + string(a.eq(b)))\n" +
            "    println(\"tag_diff=\" + string(a.eq(c)))\n" +
            "    println(\"num_diff=\" + string(a.eq(d)))\n" +
            "}\n")
        out.contains("same=true") && out.contains("tag_diff=false") && out.contains("num_diff=false")
    }
}

spec "derive_eq: nullable self field none-guards through opt_eq_by" {
    then "absent/absent, absent/present, and present/present cases all answer correctly" {
        let out = write_fixture_and_run("/tmp/avra_derive_eq_optional_test.av",
            "use @std.avrac.features.derive.{derive_eq}\n" +
            "use @std.avrac.list_ops.{opt_eq_by}\n" +
            "\n" +
            "@expand(derive_eq)\n" +
            "type OChain = { v: int, next: OChain? }\n" +
            "\n" +
            "fn main() {\n" +
            "    let flat1 = OChain { v: 1, next: null }\n" +
            "    let flat2 = OChain { v: 1, next: null }\n" +
            "    let deep1 = OChain { v: 1, next: OChain { v: 2, next: null } }\n" +
            "    let deep2 = OChain { v: 1, next: OChain { v: 2, next: null } }\n" +
            "    let deep3 = OChain { v: 1, next: OChain { v: 9, next: null } }\n" +
            "    println(\"both_absent=\" + string(flat1.eq(flat2)))\n" +
            "    println(\"absent_vs_present=\" + string(flat1.eq(deep1)))\n" +
            "    println(\"present_same=\" + string(deep1.eq(deep2)))\n" +
            "    println(\"present_diff=\" + string(deep1.eq(deep3)))\n" +
            "}\n")
        out.contains("both_absent=true") &&
            out.contains("absent_vs_present=false") &&
            out.contains("present_same=true") &&
            out.contains("present_diff=false")
    }
}
