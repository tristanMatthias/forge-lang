// WHY: parses `channel<T>()` / `channel<T>(cap)` into Expr.ChannelNew.
// Spec Axis 18: typed channel construction. Capacity selects the
// semantics — absent = unbounded, 0 = rendezvous, N > 0 = bounded.

use parse.{Parser}
use core.{Expr, Tk, type_expr_to_vtype}

impl Parser {
    fn parse_channel_expression(self) -> Result<Expr, string> {
        self.advance()  // consume `channel`
        if !self.consume(Tk.Less, "expected `<` after `channel` — write `channel<T>()` or `channel<T>(cap)`") {
            return .Err("parse error")
        }
        let elem_te = self.parse_type_expr("expected channel element type after `channel<`")?
        if !self.consume(Tk.Greater, "expected `>` to close the channel element type") {
            return .Err("parse error")
        }
        let elem = type_expr_to_vtype(elem_te)
        if !self.consume(Tk.LeftParen, "expected `(` after `channel<T>` — capacity is optional but the parens are not") {
            return .Err("parse error")
        }
        if self.check(Tk.RightParen) {
            self.advance()
            return .Ok(Expr.ChannelNew(elem, null))
        }
        let cap = self.parse_expression()?
        if !self.consume(Tk.RightParen, "expected `)` after channel capacity") {
            return .Err("parse error")
        }
        .Ok(Expr.ChannelNew(elem, cap))
    }
}
