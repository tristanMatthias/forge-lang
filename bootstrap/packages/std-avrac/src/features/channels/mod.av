// WHY: feature registration for typed channels (spec Axis 18).
// `channel<T>(cap)` construction + the Channel<T> method surface
// (.send / .recv / .close). Parser/typeck/codegen live as siblings
// (dir-as-module, g2eo.1); select integration lives in select_stmt
// (which consumes the element type this feature establishes).

use core.{ValueType, vtype_display}
use features.channels.lowering.{channels_builds}
use features.grammar.{parse_grammar}

/// `channel<T>(cap)` — the definition carries the feature whole
/// (t-kd4y.3.5.1): the construction rule, its one lowering, and the pass
/// hooks. Methods (.send/.recv/.close) dispatch through the receiver-typed
/// method paths in fn_decl (codegen) and typeck's check_method_call, not
/// through the registry — same split List uses. `type_expr` and
/// `expression` are cross-fragment references, bound by name when the
/// expression views compose this gram (`gram_family = "expr"`).
@language_feature
export fn channels_lang() -> LanguageFeature {
    LanguageFeature channels_def {
        name = "channels",
        title = "channel — typed channel construction",
        docs = """
`channel<T>(cap)` constructs a bounded channel of element type `T`
(capacity optional — omit for unbounded). `.send` / `.recv` /
`.try_recv` / `.close` drive it; `recv` yields `T?` where null means
closed-and-drained (spec Axis 18).
""",
        gram = grammar {
  channel_expr = "channel" "<" elem:type_expr ">" "(" ( cap:expression )? ")" -> MkChannel(elem, cap)
        },
        builders = channels_builds(),
        snippet = r"channel<${1:T}>(${2:cap})",
        expr_tag = Expr.ChannelNew(ValueType.Unknown, null),
        emit_expr = channel_emit_expr,
        resolve_expr = channel_resolve,
        check_expr = channel_check,
        gram_family = "expr",
    }
    channels_def
}

/// The Channel method surface, rendered for "no such method" help
/// text. One definition — typeck and codegen both cite it, so the
/// help can never drift between the two pipelines (the codegen copy
/// is an ICE-grade backstop; typeck reports first in practice).
export fn channel_methods_help(elem: ValueType) -> string {
    ".send(value), .recv() -> ${vtype_display(elem)}?, .try_recv() -> ${vtype_display(elem)}?, .close()"
}
