// The modules feature's LOWERINGS — a dedicated SUBMODULE so the generated
// parser can import these directly (t-kd4y.3 Batch A, the wrapper-layer
// kill). The F4012 import-closure invariant binds feature MODULES that pull
// typeck/resolve/codegen into the parse closure; this module imports ONLY
// features.grammar + core — both already in every generated parser's
// closure — so `use features.modules.lowering.{…}` widens nothing, and the
// engine-side `_gb_` wrapper layer never needs to exist. Rows live here
// beside the fns they bind; the feature's definition (../mod.av) imports
// modules_builds back.
//
// Each fn is the normalized builder ABI — fn(PState, List<CapVal>) ->
// CapVal — with BOTH engines' unpacking folded in: the executor's env
// reads and the generated parser's accumulators arrive identically as
// CapVals (list captures wrapped by manifest_arg_spelling,
// capval_tok_list unwrapping singleton-preserving).

use core.{Stmt, StmtId, ValueType}
use features.grammar.{PState, CapVal, Token, BuilderBind, bind_row, bind_rows, capval_tok_list, capval_tok_text, param_entries_from_toks}

/// `use seg ( . seg )* { names }` — the bare-path import (`MkUseBare`).
export fn use_bare_build(st: PState, vals: List<CapVal>) -> CapVal {
    use_stmt_of(st, false, capval_tok_list(vals[0]), capval_tok_list(vals[1]))
}

/// `use @pkg.seg… { names }` (`MkUsePkg`) — the package SCOPE is a separate
/// capture from the path segments (a label bound by two `.One` items is
/// REPLACED, not accumulated, by the executor's bind; joining here keeps
/// the engine divergence impossible rather than merely untested).
export fn use_pkg_build(st: PState, vals: List<CapVal>) -> CapVal {
    mut all: List<Token> = []
    for t in capval_tok_list(vals[0]) { all.push(t) }
    for t in capval_tok_list(vals[1]) { all.push(t) }
    use_stmt_of(st, true, all, capval_tok_list(vals[2]))
}

/// The shared `use` core: dot-joined path (leading `@` for a package
/// path); the names reuse the bare-name ParamEntry list.
fn use_stmt_of(st: PState, at_present: bool, segs: List<Token>, names: List<Token>) -> CapVal {
    mut path = ""
    for t in segs { path = if path == "" { t.text } else { path + "." + t.text } }
    if at_present { path = "@" + path }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Use(path, param_entries_from_toks(CapVal.Toks(names), ValueType.Unknown))))
}

/// `mod name` — a module STUB (`MkModule`); the resolver fills the body
/// from the `.av` file later.
export fn module_build(st: PState, vals: List<CapVal>) -> CapVal {
    let empty_body: List<StmtId> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Module(capval_tok_text(vals[0]), empty_body)))
}

/// The modules feature's rows — Batch A shape: rows bind the EXISTING Mk
/// names (zero gram edits) to fns in THIS module, which the generated
/// parser imports directly.
export fn modules_builds() -> List<BuilderBind> {
    bind_rows("features.modules.lowering", [bind_row("MkUseBare", "stmt", 2, false, "use_bare_build", use_bare_build),
     bind_row("MkUsePkg", "stmt", 3, false, "use_pkg_build", use_pkg_build),
     bind_row("MkModule", "stmt", 1, false, "module_build", module_build)])
}
