// The modules feature's LOWERINGS — a dedicated SUBMODULE so the generated
// parser can import these directly (t-kd4y.3 Batch A, the wrapper-layer
// kill). The F4012 import-closure invariant binds feature MODULES that pull
// typeck/resolve/codegen into the parse closure; this module imports ONLY
// features.grammar + core — both already in every generated parser's
// closure — so `use features.modules.lowering.{…}` widens nothing, and the
// engine-side `_gb_` wrapper layer never needs to exist. Rows live here
// beside the fns they bind; the feature's definition (../mod.av) imports
// use_builds back.
//
// Each fn is the normalized builder ABI — fn(PState, List<CapVal>) ->
// CapVal — with BOTH engines' unpacking folded in: the executor's env
// reads and the generated parser's accumulators arrive identically as
// CapVals (list captures wrapped by manifest_arg_spelling,
// capval_tok_list unwrapping singleton-preserving).

use core.{ModulePath, Annotation, Expr, ExprId, Stmt, StmtId, ValueType, byte_span}
use features.grammar.{PState, CapVal, Token, BuilderBind, bind_row, bind_rows, capval_to_finit_list, capval_to_stmt, capval_tok_list, capval_tok_text, capval_toks, param_entries_from_toks, BuildKind}

/// `use seg ( . seg )* { names }` — the bare-path import (`MkUseBare`).
export fn use_bare_build(st: PState, vals: List<CapVal>) -> CapVal {
    use_stmt_of(st, false, capval_tok_list(vals[0]), capval_tok_list(vals[1]))
}

/// `use @pkg.seg… { names }` (`MkUsePkg`) — the package SCOPE is a separate
/// capture from the path segments (a label bound by two `.One` items is
/// REPLACED, not accumulated, by the executor's bind; joining here keeps
/// the engine divergence impossible rather than merely untested).
export fn use_pkg_build(st: PState, vals: List<CapVal>) -> CapVal {
    mut all: List<Token> = []
    for t in capval_tok_list(vals[0]) { all.push(t) }
    for t in capval_tok_list(vals[1]) { all.push(t) }
    use_stmt_of(st, true, all, capval_tok_list(vals[2]))
}

/// The shared `use` core: dot-joined path (leading `@` for a package
/// path); the names reuse the bare-name ParamEntry list.
fn use_stmt_of(st: PState, at_present: bool, segs: List<Token>, names: List<Token>) -> CapVal {
    mut path = ""
    for t in segs { path = if path == "" { t.text } else { path + "." + t.text } }
    if at_present { path = "@" + path }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Use(path, param_entries_from_toks(CapVal.Toks(names), ValueType.Unknown))))
}

/// `mod name` — a module STUB (`MkModule`); the resolver fills the body
/// from the `.av` file later.
export fn module_build(st: PState, vals: List<CapVal>) -> CapVal {
    let empty_body: List<StmtId> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Module(capval_tok_text(vals[0]), empty_body)))
}

/// The modules feature's rows — Batch A shape: rows bind the EXISTING Mk
/// names (zero gram edits) to fns in THIS module, which the generated
/// parser imports directly.
export fn use_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.modules.lowering"), [bind_row("MkUseBare", BuildKind.Stmt, 2, false, "use_bare_build", use_bare_build),
     bind_row("MkUsePkg", BuildKind.Stmt, 3, false, "use_pkg_build", use_pkg_build),
     bind_row("MkModule", BuildKind.Stmt, 1, false, "module_build", module_build)])
}

/// `@pkg::mod::name` and its struct-literal form `@pkg::mod::Name { f: v }`
/// (t-kd4y.3.5.6). The name is rebuilt from the `@`-IDENT plus each
/// `::`-segment token, exactly as the retired hand concatenated them. A
/// `{ … }` suffix is taken ONLY when allow_struct_lit is on (the @when
/// gate in the rule) — `lb` present distinguishes an EMPTY struct literal
/// `@a::B {}` from a bare qualified ident, which both yield no field
/// inits.
export fn mk_qualified(st: PState, sp_start: int, ncap: CapVal, scap: CapVal, lbcap: CapVal, fcap: CapVal) -> ExprId {
    mut name = "@" + capval_tok_text(ncap)
    for t in capval_toks(scap) { name = name + "::" + t.text }
    match lbcap {
        .Nil -> st.store.exprs.add_leaf(Expr.QualifiedIdent(name))
        _ -> st.store.add_expr(Expr.StructLit(name, capval_to_finit_list(fcap)), byte_span(sp_start, st.cur().pos), [])
    }
}

export fn mk_qualified_abi(st: PState, vals: List<CapVal>) -> CapVal {
    CapVal.Node(mk_qualified(st, st.build_sp, vals[0], vals[1], vals[2], vals[3]))
}

/// The qualified-reference row (t-kd4y.3.5.6) — spanned at the `@` byte.
export fn qualified_ref_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.modules.lowering"), [bind_row("MkQualExpr", BuildKind.Expr, 4, true, "mk_qualified_abi", mk_qualified_abi)])
}

/// `export <decl>` → `Stmt.Annotated([@export], inner)` (t-kd4y.3.5.9) —
/// the export wrapper is an ordinary annotation downstream, so the build
/// wraps and nothing more. The inner declaration's own position stamp is
/// `MkStampAt`'s job (spelled by `exportable_decl`, engine-tableless).
export fn mk_export(st: PState, inner: CapVal) -> CapVal {
    let no_args: List<ExprId> = []
    let exp: List<Annotation> = [Annotation { name: "export", arg_ids: no_args }]
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Annotated(exp, capval_to_stmt(st, inner))))
}

export fn mk_export_abi(st: PState, vals: List<CapVal>) -> CapVal {
    mk_export(st, vals[0])
}

/// The export-wrapper row (t-kd4y.3.5.9) — flat: the wrapper allocates no
/// spanned node of its own.
export fn export_builds() -> List<BuilderBind> {
    bind_rows(ModulePath("features.modules.lowering"), [bind_row("MkExport", BuildKind.Stmt, 1, false, "mk_export_abi", mk_export_abi)])
}
