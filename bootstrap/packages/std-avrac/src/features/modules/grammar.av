// WHY: t-47hc slice 9 — the decl-keyword half of the per-feature grammar
// FRAGMENT registry (see features/fn_decl/grammar.av for the full rationale).
// The modules feature owns BOTH module-system declarations: `use` (with its
// optional `@`-package prefix, dotted path segments, and braced name list) and
// the bare `mod` declaration. They live in one fragment because one feature
// (features/modules) owns both keywords — `use_feature()` and `mod_feature()`
// are registered from the same directory.
use features.grammar.{parse_grammar, grammar_checked, Grammar}

/// The `use` and `mod` declarations.
///
/// `use` SPLITS on the `@`-package prefix, and the split is load-bearing twice over.
///
/// FRONTIER. The hand (`parse_use_declaration`) requires a scope AND a name after
/// `@` — `consume(Tk.Dot, …)` then `consume_identifier("expected package name")` —
/// so `use @std.{x}` is a parse ERROR there. Writing the prefix as a bare
/// `( uat:"@" )?` in front of the shared dotted loop ACCEPTS it, because that loop's
/// segment is optional (it has to be, to model the hand's `if check(LeftBrace)
/// break` on a trailing dot). Measured before the split: `use @std.{x}` reached
/// F3100 `package @std not found` — a RESOLVER code, meaning the parse had already
/// succeeded where the hand stops at F0001. The `@` branch spells the scope out as
/// its own mandatory `upkg:IDENT "."`, which is exactly the hand's two consumes.
///
/// Note what does NOT work: `( "." useg:IDENT )+` for "at least one more segment".
/// The `+` loop re-enters on the TRAILING dot of `@std.core.{…}` and then demands an
/// IDENT it will never get — so the one import form the entire compiler is written in
/// would fail. The trailing dot has to stay absorbed by an optional segment INSIDE
/// the loop, which is why the mandatory segment is lifted out in front of it.
///
/// SHAPE. The obvious fix — `( uat:"@" useg:IDENT "." )?` as one optional group —
/// is WRONG in a way that only the executor shows. `bind` REPLACES for a `.One`
/// item and APPENDS for a repetition item, so a label bound by TWO `.One` items in
/// one branch loses the first: the group's `std` was overwritten by the mandatory
/// `core`, and `composed_program_test` caught `(use @core …)` against the hand's
/// `(use @std.core …)`. Emit does not have the bug (it declares one `_list` per
/// repeated label and pushes at both sites), so this is an executor/emit lockstep
/// gap — general, pre-existing, and NOT fixable here: `exec_*` is also the live
/// production parser for the type family, so changing its capture semantics is a
/// production-parser change by construction (CLAUDE.md t-47hc.10). Both branches
/// below therefore bind `useg` with at most ONE `.One` item plus repetitions — the
/// shape both engines already agree on. Filed separately.
///
/// Path SEGMENTS are `WORD` (identifier-or-keyword, t-kd4y.1) so a module —
/// i.e. a directory — may be keyword-named: `use features.defer.{…}`. The
/// package scope (`upkg`) and the imported NAMES stay IDENT: symbols cannot
/// be keyword-named, so widening them would only mask real errors.
///
/// `use_tail` exists so the two branches are FIRST-disjoint (`@` vs IDENT). Kept on
/// `use_decl` itself they would share the `"use"` FIRST, the engines would commit to
/// branch one, and every non-package import would fail on the mandatory `@`.
export fn avra_modules_grammar() -> Grammar {
    let gp = grammar {
  use_decl    = @try "use" @cut ut:use_tail -> ut
  use_tail    = "@" @require upkg:IDENT @require "." @require useg:WORD ( "." ( useg:WORD )? )* @require "{" ( unames:IDENT ","? )* @require "}"
                @expect("IDENT", "expected package name")
                @expect("WORD", "expected module path segment")
                @expect(".", "expected `.` after package scope")
                @expect("{", "expected `{` in use declaration")
                @expect("}", "expected `}` in use declaration") -> MkUsePkg(upkg, useg, unames)
              | @fallback @require useg:WORD ( "." ( useg:WORD )? )* @require "{" ( unames:IDENT ","? )* @require "}"
                @expect("WORD", "expected module path after `use`")
                @expect("{", "expected `{` in use declaration")
                @expect("}", "expected `}` in use declaration") -> MkUseBare(useg, unames)
  mod_decl    = @try "mod" @cut @require mdname:WORD
                @expect("WORD", "expected module name after `mod`") -> MkModule(mdname)
    }
    grammar_checked(gp)
}

/// The `export` wrapper fragment (t-kd4y.3.5.9) — its own Grammar (not part
/// of avra_modules_grammar) so export_lang's validation sees exactly the
/// rules whose builds it supplies: `exportable_inner`'s branches reference
/// only RULES cross-fragment, and the build refs here are MkExport (this
/// feature's row) + MkStampAt (engine). The reporting posture and the
/// mirrored-alternation contract ride export_lang's comments (../mod.av).
export fn avra_export_grammar() -> Grammar {
    let gp = grammar {
  export_decl      = @try "export" @cut @require ed:exportable_decl
                     @expect("exportable_decl", "expected declaration after `export`") -> MkExport(ed)
  exportable_decl  = ei:exportable_inner -> MkStampAt(ei)
  exportable_inner = use_decl | mod_decl | shape_decl | enum_decl | type_decl | extern_decl | fn_decl | trait_decl | impl_decl | letdes_decl | let_decl | mut_decl | const_decl | select_decl | parallel_decl | spec_decl | comp_header
    }
    grammar_checked(gp)
}
