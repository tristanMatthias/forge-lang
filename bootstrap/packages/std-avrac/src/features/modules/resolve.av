// The module system's RESOLVER hook. One file per pass (features/WHY.md): a
// feature's mod.av is the CONTAINER — identity, gram, and which fn implements
// each pass — and the pass logic lives in the file named for that pass.
// Module-PRIVATE and staying so: dir-as-module flattens every sibling .av into
// one flat namespace, so mod.av reaches it exactly as before the move. (The
// sibling `resolver.av` is a different thing: the module GRAPH loader — file
// discovery, dir-as-module bodies, metadata slots — not a pass hook.)
use core.{Stmt}
use resolve.{Resolver, resolve_stmt_ids}

/// Resolver hook for `mod`. Recursively resolves the body — name
/// resolution within the module is local to its scope.
fn mod_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Module(_, body) -> resolve_stmt_ids(r, body), _ -> r }
}
