// WHY: module system feature — mod declarations, use imports, export
// visibility.
//
// dir-as-module (g2eo.1): parser.av + resolver.av + package.av +
// graph_build.av + dir_module.av auto-load as siblings, surface flat
// at `features.modules.{...}`.
use features.eval.{ok_result, value_null}
use core.{Stmt, StmtId}
use resolve.{resolve_stmt_ids}
use features.modules.lowering.{modules_builds, qualified_builds}
use features.grammar.{parse_grammar}
use features.{composed}

/// Resolver hook for `mod`. Recursively resolves the body — name
/// resolution within the module is local to its scope.
fn mod_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Module(_, body) -> resolve_stmt_ids(r, body), _ -> r }
}

/// Tree-walk evaluator hook for `mod`. The evaluator doesn't yet
/// model module scoping — return null and let body evaluation
/// fall back to the surrounding scope.
fn mod_eval(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Module(_, _) -> ok_result(rt, value_null())
        _ -> ok_result(rt, value_null())
    }
}

/// Tree-walk evaluator hook for `use`. `use` is a compile-time
/// directive only — the evaluator returns null without effect.
fn use_eval(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Use(_, _) -> ok_result(rt, value_null())
        _ -> ok_result(rt, value_null())
    }
}

/// Register the `mod` declaration feature. Wires up the parser,
/// resolver, and eval hooks. Codegen is provided implicitly by
/// the codegen pipeline emitting `__init_<name>()` per module.
export fn mod_lang() -> LanguageFeature {
    let empty_body: List<StmtId> = []
    LanguageFeature mod_def {
        name = "mod",
        title = "mod — declare a directory-backed module",
        docs = """
`mod name` declares a module stub; the resolver fills its body from the
sibling `.av` file or directory of the same name (dir-as-module). Names
inside resolve locally to the module's scope.
""",
        snippet = r"mod ${1:name}",
        stmt_tag = Stmt.Module("", empty_body),
        resolve_stmt = mod_resolve,
        eval_stmt = mod_eval,
    }
    mod_def
}

export fn use_lang() -> LanguageFeature {
    LanguageFeature use_def {
        name = "use",
        title = "use — import names from a module or package",
        docs = """
`use path.to.module.{ names }` imports names into scope; a leading `@pkg`
segment addresses a package. Path segments may be keywords (a directory
may be named `defer`); the imported names themselves stay identifiers.
""",
        gram = composed([avra_modules_grammar()]),
        builders = modules_builds(),
        snippet = r"use ${1:path}.{${2:names}}",
        stmt_tag = Stmt.Use("", []),
        eval_stmt = use_eval,
    }
    use_def
}

/// `@pkg::mod::name` qualified references (t-kd4y.3.5.6) — the
/// EXPRESSION-side face of the package system, so the rule + its
/// MkQualExpr row live here beside `use`. The rule also carries the
/// struct-literal form behind the @when(allow_struct_lit) gate;
/// `field_init` is referenced cross-fragment (struct_lit_lang owns it).
/// `gram_family = "expr"`; the ladder dispatches on the `@` token.
export fn qualified_ref_lang() -> LanguageFeature {
    LanguageFeature qualified_ref_def {
        name = "qualified_ref",
        title = "@pkg::path — qualified package references",
        docs = """
`@pkg::mod::name` names an item through its package path; with
`{ fields }` it builds that package's struct type. `@name` alone is
annotation syntax — a qualified reference always carries `::`.
""",
        // VERBATIM from the spine, including the reporting posture: the
        // segment name after `::` is @require'd — unrequired it reported a
        // bare "expected identifier" and left the cursor mid-reference.
        gram = grammar {
  qualified_expr = "@" n:IDENT ( @peek(double_colon) ":" ":" @require s:IDENT )+
                   ( @when(allow_struct_lit) lb:"{" ( @onfail(bail) f:field_init )* "}" )?
                   @expect("IDENT", "expected identifier after `::` in qualified reference")
                   @expect("+", "expected `::` after the package name — a qualified reference is `@pkg::mod::name`; `@name` alone is annotation syntax")
                   @expect("}", "expected `}` after struct fields") -> MkQualExpr(n, s, lb, f)
        },
        builders = qualified_builds(),
        gram_family = "expr",
    }
    qualified_ref_def
}
