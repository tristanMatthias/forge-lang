// WHY: module system feature — mod declarations, use imports, export
// visibility.
//
// dir-as-module (g2eo.1): parser.av + resolver.av + package.av +
// graph_build.av + dir_module.av auto-load as siblings, surface flat
// at `features.modules.{...}`.
use features.eval.{ok_result, value_null}
use core.{Stmt, StmtId, ExprId, Annotation, ValueType}
use resolve.{resolve_stmt_ids}
use features.grammar.{PState, CapVal, Token, capval_tok_list, capval_tok_text, param_entries_from_toks, modules_builds}
use features.{composed}

/// Resolver hook for `mod`. Recursively resolves the body — name
/// resolution within the module is local to its scope.
fn mod_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Module(_, body) -> resolve_stmt_ids(r, body), _ -> r }
}

/// Tree-walk evaluator hook for `mod`. The evaluator doesn't yet
/// model module scoping — return null and let body evaluation
/// fall back to the surrounding scope.
fn mod_eval(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Module(_, _) -> ok_result(rt, value_null())
        _ -> ok_result(rt, value_null())
    }
}

/// Tree-walk evaluator hook for `use`. `use` is a compile-time
/// directive only — the evaluator returns null without effect.
fn use_eval(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Use(_, _) -> ok_result(rt, value_null())
        _ -> ok_result(rt, value_null())
    }
}

/// Register the `mod` declaration feature. Wires up the parser,
/// resolver, and eval hooks. Codegen is provided implicitly by
/// the codegen pipeline emitting `__init_<name>()` per module.
// ── ABI lowerings (t-kd4y.3 Batch A) — moved from the executor's central
// arms; each folds BOTH engines' unpacking (the executor's env reads and
// the generated parser's raw accumulators arrive identically as CapVals —
// list captures wrapped by manifest_arg_spelling, capval_tok_list unwraps
// singleton-preserving). The engine's checked-in `_gb_` wrappers import
// these back (the import-closure invariant's one-line residue).

/// `use seg ( . seg )* { names }` — the bare-path import (`MkUseBare`).
export fn use_bare_build(st: PState, vals: List<CapVal>) -> CapVal {
    use_stmt_of(st, false, capval_tok_list(vals[0]), capval_tok_list(vals[1]))
}

/// `use @pkg.seg… { names }` (`MkUsePkg`) — the package SCOPE is a separate
/// capture from the path segments (a label bound by two `.One` items is
/// REPLACED, not accumulated, by the executor's bind; joining here keeps
/// the engine divergence impossible rather than merely untested).
export fn use_pkg_build(st: PState, vals: List<CapVal>) -> CapVal {
    mut all: List<Token> = []
    for t in capval_tok_list(vals[0]) { all.push(t) }
    for t in capval_tok_list(vals[1]) { all.push(t) }
    use_stmt_of(st, true, all, capval_tok_list(vals[2]))
}

/// The shared `use` core: dot-joined path (leading `@` for a package
/// path); the names reuse the bare-name ParamEntry list.
fn use_stmt_of(st: PState, at_present: bool, segs: List<Token>, names: List<Token>) -> CapVal {
    mut path = ""
    for t in segs { path = if path == "" { t.text } else { path + "." + t.text } }
    if at_present { path = "@" + path }
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Use(path, param_entries_from_toks(CapVal.Toks(names), ValueType.Unknown))))
}

/// `mod name` — a module STUB (`MkModule`); the resolver fills the body
/// from the `.av` file later.
export fn module_build(st: PState, vals: List<CapVal>) -> CapVal {
    let empty_body: List<StmtId> = []
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Module(capval_tok_text(vals[0]), empty_body)))
}

export fn mod_lang() -> LanguageFeature {
    let empty_body: List<StmtId> = []
    LanguageFeature mod_def {
        name = "mod",
        title = "mod — declare a directory-backed module",
        docs = """
`mod name` declares a module stub; the resolver fills its body from the
sibling `.av` file or directory of the same name (dir-as-module). Names
inside resolve locally to the module's scope.
""",
        snippet = r"mod ${1:name}",
        stmt_tag = Stmt.Module("", empty_body),
        resolve_stmt = mod_resolve,
        eval_stmt = mod_eval,
    }
    mod_def
}

export fn use_lang() -> LanguageFeature {
    LanguageFeature use_def {
        name = "use",
        title = "use — import names from a module or package",
        docs = """
`use path.to.module.{ names }` imports names into scope; a leading `@pkg`
segment addresses a package. Path segments may be keywords (a directory
may be named `defer`); the imported names themselves stay identifiers.
""",
        gram = composed([avra_modules_grammar()]),
        builders = modules_builds(),
        snippet = r"use ${1:path}.{${2:names}}",
        stmt_tag = Stmt.Use("", []),
        eval_stmt = use_eval,
    }
    use_def
}
