// Behavioural tests for filter_to_target_unit (g2eo Phase A).
//
// The filter walks a resolved program and marks every Module
// wrapper outside a target source-directory with @external_unit.
// Codegen then skips body emission for those modules. These tests
// build small in-memory ASTs and assert on the post-filter shape.
//
// F3a: Module bodies are `List<StmtId>` rows whose file attribution
// lives in the store's pos column, so every probe threads the store
// its program was built in.

use @std.avrac.core.{NodeStore, StmtId, Stmt, Annotation, ParamEntry, ValueType, new_node_store, build_line_index}
use @std.avrac.features.modules.{filter_to_target_unit}

/// A filtered program (its root rows) + the store its rows live in.
type UftFiltered = { ids: List<StmtId>, store: NodeStore }

fn uft_store() -> NodeStore {
    new_node_store(build_line_index(""))
}

/// Build a `Stmt.Function` row anchored at `file` so the filter has a
/// position-column file to compare against. Body is empty — we never
/// codegen these test fixtures, only inspect their structure.
fn uft_fn_in_file(ws: NodeStore, name: string, file: string) -> StmtId {
    let empty_p: List<ParamEntry> = []
    let empty_body: List<StmtId> = []
    let id = ws.stmts.add_leaf(Stmt.Function(name, .End, empty_p, ValueType.Unknown, empty_body))
    ws.set_stmt_pos(id, 1, 1, file)
    id
}

fn uft_annotation_has(annots: List<Annotation>, target: string) -> bool {
    mut i = 0
    while i < annots.length {
        if annots[i].name == target { return true }
        i = i + 1
    }
    false
}

fn uft_is_external_module(ws: NodeStore, id: StmtId, expected_name: string) -> bool {
    match ws.stmts.get(id) {
        .Annotated(annots, inner) -> {
            let has_ext = uft_annotation_has(annots, "external_unit")
            let name_ok = match ws.stmts.get(inner) {
                .Module(n, _) -> n == expected_name
                _ -> false
            }
            has_ext && name_ok
        }
        _ -> false
    }
}

fn uft_is_module(ws: NodeStore, id: StmtId, expected_name: string) -> bool {
    match ws.stmts.get(id) {
        .Module(n, _) -> n == expected_name
        _ -> false
    }
}

fn uft_nth(ws: NodeStore, ids: List<StmtId>, idx: int) -> StmtId {
    if idx < 0 || idx >= ids.length { return ws.stmts.add_leaf(Stmt.NoOp()) }
    ids[idx]
}

/// A Module whose body rows are stamped with `files` in the pos column.
fn uft_module_with_files(ws: NodeStore, name: string, files: List<string>) -> StmtId {
    mut body_items: List<StmtId> = []
    mut i = 0
    while i < files.length {
        body_items.push(uft_fn_in_file(ws, "f${i}", files[i]))
        i = i + 1
    }
    ws.stmts.add_leaf(Stmt.Module(name, body_items))
}

/// Three sibling Modules, one per directory. Filter targets core/.
fn uft_filter_siblings() -> UftFiltered {
    let ws = uft_store()
    let prog: List<StmtId> = [
        uft_module_with_files(ws, "core", ["packages/std-avrac/src/core/ast.av"]),
        uft_module_with_files(ws, "features", ["packages/std-avrac/src/features/closures/mod.av"]),
        uft_module_with_files(ws, "build", ["packages/std-avrac/src/build/cache.av"]),
    ]
    UftFiltered { ids: filter_to_target_unit(ws, prog, "packages/std-avrac/src/core/"), store: ws }
}

spec "filter_to_target_unit: target module stays plain, others marked external" {
    then "core stays as plain Module (target hit)" {
        let f = uft_filter_siblings()
        uft_is_module(f.store, uft_nth(f.store, f.ids, 0), "core")
    }
    then "features gets @external_unit (no file in target)" {
        let f = uft_filter_siblings()
        uft_is_external_module(f.store, uft_nth(f.store, f.ids, 1), "features")
    }
    then "build gets @external_unit (no file in target)" {
        let f = uft_filter_siblings()
        uft_is_external_module(f.store, uft_nth(f.store, f.ids, 2), "build")
    }
}

/// Module body has files from two dirs, one of them target.
fn uft_filter_mixed() -> UftFiltered {
    let ws = uft_store()
    let prog: List<StmtId> = [
        uft_module_with_files(ws, "mixed", [
            "packages/std-avrac/src/typeck/mod.av",
            "packages/std-avrac/src/core/ast.av",
        ]),
    ]
    UftFiltered { ids: filter_to_target_unit(ws, prog, "packages/std-avrac/src/core/"), store: ws }
}

spec "filter_to_target_unit: any-file-in-target keeps the whole module" {
    then "the mixed module is kept (any-file-in-target wins)" {
        let f = uft_filter_mixed()
        uft_is_module(f.store, uft_nth(f.store, f.ids, 0), "mixed")
    }
}

/// Outer Module wraps inner Modules. Filter still descends.
fn uft_filter_nested() -> UftFiltered {
    let ws = uft_store()
    let core_inner = uft_module_with_files(ws, "core", ["packages/std-avrac/src/core/ast.av"])
    let features_inner = uft_module_with_files(ws, "features", ["packages/std-avrac/src/features/closures/mod.av"])
    let avrac_body: List<StmtId> = [core_inner, features_inner]
    let prog: List<StmtId> = [ws.stmts.add_leaf(Stmt.Module("avrac", avrac_body))]
    UftFiltered { ids: filter_to_target_unit(ws, prog, "packages/std-avrac/src/core/"), store: ws }
}

fn uft_outer_avrac_inner_at(f: UftFiltered, idx: int) -> StmtId {
    let outer = uft_nth(f.store, f.ids, 0)
    match f.store.stmts.get(outer) {
        .Module(_, body) -> {
            if idx < 0 || idx >= body.length { return f.store.stmts.add_leaf(Stmt.NoOp()) }
            body[idx]
        }
        _ -> f.store.stmts.add_leaf(Stmt.NoOp())
    }
}

spec "filter_to_target_unit: nested modules also get filtered" {
    then "outer avrac wrapper is kept (target reachable inside)" {
        let f = uft_filter_nested()
        uft_is_module(f.store, uft_nth(f.store, f.ids, 0), "avrac")
    }
    then "inside avrac, core stays plain" {
        let f = uft_filter_nested()
        uft_is_module(f.store, uft_outer_avrac_inner_at(f, 0), "core")
    }
    then "inside avrac, features goes external" {
        let f = uft_filter_nested()
        uft_is_external_module(f.store, uft_outer_avrac_inner_at(f, 1), "features")
    }
}

/// A Module with empty body. Filter must not annotate it (would be a
/// no-op since codegen emits nothing for empty bodies anyway).
fn uft_filter_empty() -> UftFiltered {
    let ws = uft_store()
    let empty_body: List<StmtId> = []
    let prog: List<StmtId> = [ws.stmts.add_leaf(Stmt.Module("placeholder", empty_body))]
    UftFiltered { ids: filter_to_target_unit(ws, prog, "packages/std-avrac/src/core/"), store: ws }
}

spec "filter_to_target_unit: empty body modules are not touched" {
    then "the empty Module stays plain" {
        let f = uft_filter_empty()
        uft_is_module(f.store, uft_nth(f.store, f.ids, 0), "placeholder")
    }
}
