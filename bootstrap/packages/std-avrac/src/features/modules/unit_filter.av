// WHY: per-module compile granularity (g2eo Phase A).
//
// Walks a resolved program and marks every `Module(name, body)`
// wrapper whose body originates OUTSIDE a target source directory
// with the `@external_unit` annotation. Codegen then emits stubs
// for those modules — declares `__init_<name>` so cross-unit calls
// link, but skips body emission. The result is a `.ll` containing
// only the target directory's symbols, paired with a `.meta.bin`
// describing its public surface. Multiple per-module compiles link
// together into the final binary.
//
// The filter relies on every `SStmt` carrying its source `file`
// from the parser. Empty modules (those that came in from metadata
// fast-path with no original file context) are left alone — the
// metadata path already annotates them on its own.
//
// Tracking: forge-crafting-intepreters-g2eo Phase A.

use core.{Stmt, SStmt, Annotation, SExpr, sstmt_at, avra_process_env_get}

/// Returns true iff any decl reachable from `body` carries a
/// `SStmt.file` whose path starts with `target_prefix`. Recurses
/// into nested `Module(_, body)` and `Annotated(_, inner)` so that
/// a target file deep inside a nested wrapper still wins. Necessary
/// because dir-as-module flattens many sibling files into one
/// module body, but package-load wraps everything under
/// `Module("@scope") { Module("name") { … } }` first.
fn body_has_file_under(body: List<SStmt>, target_prefix: string) -> bool {
    let debug = avra_process_env_get("AVRA_FILTER_DEBUG_DEEP") != ""
    body_has_file_under_inner(body, target_prefix, debug)
}

fn body_has_file_under_inner(body: List<SStmt>, target_prefix: string, debug: bool) -> bool {
    mut i = 0
    while i < body.length {
        if ss_reaches_target(body[i], target_prefix, debug) { return true }
        i = i + 1
    }
    false
}

fn ss_reaches_target(ss: SStmt, target_prefix: string, debug: bool) -> bool {
    if debug { eprintln("[deep] ss.file='${ss.file}' (target=${target_prefix})") }
    // Substring match — the AST stores absolute paths after the
    // resolver loads each source file, but callers most naturally
    // pass a relative project path (e.g. `packages/std-avrac/src/core/`).
    // A substring is unambiguous: the project layout never embeds
    // `<pkg>/<dir>/` inside an unrelated tree.
    if ss.file != "" && ss.file.contains(target_prefix) { return true }
    match ss.node {
        .Module(name, body) -> {
            if debug { eprintln("[deep] descend Module(${name})") }
            body_has_file_under_inner(body, target_prefix, debug)
        }
        .Annotated(_, inner) -> stmt_reaches_target(inner, target_prefix, debug)
        _ -> false
    }
}

fn stmt_reaches_target(stmt: Stmt, target_prefix: string, debug: bool) -> bool {
    match stmt {
        .Module(_, body) -> body_has_file_under_inner(body, target_prefix, debug)
        .Annotated(_, inner) -> stmt_reaches_target(inner, target_prefix, debug)
        _ -> false
    }
}

/// Attach `@external_unit` to a SStmt's inner Stmt. If the stmt is
/// already wrapped in `Stmt.Annotated`, fold the new annotation in
/// alongside the existing ones — preserves the original annotations
/// (e.g. `@export` on items inside the module body don't apply here,
/// but `@annotated` chains on the Module itself would).
fn annotate_external(ss: SStmt) -> SStmt {
    // Prepend `@external_unit` to whatever annotation list already
    // wraps the stmt — preserves the original cons-prepend semantics
    // for stmts that came in pre-Annotated, and starts a fresh
    // single-entry list for bare stmts.
    mut combined: List<Annotation> = []
    let empty_args: List<SExpr> = []
    combined.push(Annotation { name: "external_unit", args: empty_args })
    let inner_stmt = match ss.node {
        .Annotated(annots, inner) -> {
            mut i = 0
            while i < annots.length {
                combined.push(annots[i])
                i = i + 1
            }
            inner
        }
        _ -> ss.node
    }
    sstmt_at(Stmt.Annotated(combined, inner_stmt), ss.line, ss.col, ss.file)
}

/// Walk `stmts` and rewrite each top-level `Stmt.Module(name, body)`:
///   - Recurse into body, looking for the target.
///   - When body has NO files under `target_prefix` AND is non-empty,
///     mark this module as external.
///   - Otherwise keep it intact and recurse.
///
/// Empty bodies (e.g. ones from `Stmt.Module(name, [])` that never
/// got loaded — shouldn't happen post-resolve, but guard anyway)
/// are not modified: making them external would be a no-op since
/// codegen already emits nothing for empty bodies.
export fn filter_to_target_unit(stmts: List<SStmt>, target_prefix: string) -> List<SStmt> {
    let debug = avra_process_env_get("AVRA_FILTER_DEBUG") != ""
    if debug {
        let _ = dump_top_level(stmts, "  ")
    }
    filter_inner(stmts, target_prefix, debug)
}

fn dump_top_level(stmts: List<SStmt>, indent: string) -> int {
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        match ss.node {
            .Module(name, body) -> {
                eprintln("[dump] ${indent}Module(${name}) [body_empty=${body.length == 0}]")
                if body.length != 0 {
                    let _ = dump_top_level(body, indent + "  ")
                }
            }
            .Annotated(_, inner) -> match inner {
                .Module(name, _) -> eprintln("[dump] ${indent}Annotated.Module(${name})")
                _ -> {}
            }
            _ -> {}
        }
        i = i + 1
    }
    0
}

fn filter_inner(stmts: List<SStmt>, target_prefix: string, debug: bool) -> List<SStmt> {
    mut out: List<SStmt> = []
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        let head = match ss.node {
            .Module(name, body) -> {
                if body_has_file_under(body, target_prefix) {
                    if debug { eprintln("[filter] keep Module ${name}") }
                    let inner = filter_inner(body, target_prefix, debug)
                    sstmt_at(Stmt.Module(name, inner), ss.line, ss.col, ss.file)
                } else if body.length != 0 {
                    if debug { eprintln("[filter] external Module ${name}") }
                    annotate_external(ss)
                } else {
                    if debug { eprintln("[filter] empty-body Module ${name}") }
                    ss
                }
            }
            .Annotated(annots, inner) -> match inner {
                .Module(name, body) -> {
                    if body_has_file_under(body, target_prefix) {
                        if debug { eprintln("[filter] keep Annotated Module ${name}") }
                        let inner_filtered = filter_inner(body, target_prefix, debug)
                        sstmt_at(Stmt.Annotated(annots, Stmt.Module(name, inner_filtered)), ss.line, ss.col, ss.file)
                    } else if body.length != 0 {
                        if debug { eprintln("[filter] external Annotated Module ${name}") }
                        annotate_external(ss)
                    } else {
                        ss
                    }
                }
                _ -> ss
            }
            _ -> ss
        }
        out.push(head)
        i = i + 1
    }
    out
}
