// WHY: per-module compile granularity (g2eo Phase A).
//
// Walks a resolved program and marks every `Module(name, body)`
// wrapper whose body originates OUTSIDE a target source directory
// with the `@external_unit` annotation. Codegen then emits stubs
// for those modules — declares `__init_<name>` so cross-unit calls
// link, but skips body emission. The result is a `.ll` containing
// only the target directory's symbols, paired with a `.meta.bin`
// describing its public surface. Multiple per-module compiles link
// together into the final binary.
//
// The filter relies on every statement carrying its source `file` —
// the position column on the stmt arena (F3a; the parser stamps it
// where the old SStmt wrappers carried it). Empty modules (those
// that came in from metadata fast-path with no original file
// context) are left alone — the metadata path already annotates
// them on its own.
//
// Tracking: forge-crafting-intepreters-g2eo Phase A.

use core.{Stmt, StmtId, NodeStore, Annotation, avra_process_env_get}

/// Returns true iff any decl reachable from `body` carries a source
/// file whose path starts with `target_prefix`. Recurses into nested
/// `Module(_, body)` and `Annotated(_, inner)` so that a target file
/// deep inside a nested wrapper still wins. Necessary because
/// dir-as-module flattens many sibling files into one module body,
/// but package-load wraps everything under
/// `Module("@scope") { Module("name") { … } }` first.
fn body_has_file_under(store: NodeStore, body: List<StmtId>, target_prefix: string) -> bool {
    let debug = avra_process_env_get("AVRA_FILTER_DEBUG_DEEP") != ""
    body_has_file_under_inner(store, body, target_prefix, debug)
}

fn body_has_file_under_inner(store: NodeStore, body: List<StmtId>, target_prefix: string, debug: bool) -> bool {
    mut i = 0
    while i < body.length {
        if id_reaches_target(store, body[i], target_prefix, debug) { return true }
        i = i + 1
    }
    false
}

fn id_reaches_target(store: NodeStore, id: StmtId, target_prefix: string, debug: bool) -> bool {
    let pos = store.stmt_pos(id)
    if debug { eprintln("[deep] row.file='${pos.file}' (target=${target_prefix})") }
    // Substring match — the AST stores absolute paths after the
    // resolver loads each source file, but callers most naturally
    // pass a relative project path (e.g. `packages/std-avrac/src/core/`).
    // A substring is unambiguous: the project layout never embeds
    // `<pkg>/<dir>/` inside an unrelated tree.
    if pos.file != "" && pos.file.contains(target_prefix) { return true }
    stmt_reaches_target(store, store.stmts.get(id), target_prefix, debug)
}

fn stmt_reaches_target(store: NodeStore, stmt: Stmt, target_prefix: string, debug: bool) -> bool {
    match stmt {
        .Module(name, body) -> {
            if debug { eprintln("[deep] descend Module(${name})") }
            body_has_file_under_inner(store, body, target_prefix, debug)
        }
        .Annotated(_, inner) -> id_reaches_target(store, inner, target_prefix, debug)
        _ -> false
    }
}

/// Attach `@external_unit` to a statement's inner Stmt. If the stmt is
/// already wrapped in `Stmt.Annotated`, fold the new annotation in
/// alongside the existing ones — preserves the original annotations
/// (e.g. `@export` on items inside the module body don't apply here,
/// but `@annotated` chains on the Module itself would).
fn annotate_external(store: NodeStore, id: StmtId) -> StmtId {
    // Prepend `@external_unit` to whatever annotation list already
    // wraps the stmt — preserves the original cons-prepend semantics
    // for stmts that came in pre-Annotated, and starts a fresh
    // single-entry list for bare stmts. Allocates the new Annotated
    // row against the source row's span/position via `restmt`.
    mut combined: List<Annotation> = []
    combined.push(Annotation { name: "external_unit", arg_ids: [] })
    let inner_id = match store.stmts.get(id) {
        .Annotated(annots, inner) -> {
            mut i = 0
            while i < annots.length {
                combined.push(annots[i])
                i = i + 1
            }
            inner
        }
        _ -> id
    }
    store.restmt(Stmt.Annotated(combined, inner_id), id)
}

/// Walk `stmts` and rewrite each top-level `Stmt.Module(name, body)`:
///   - Recurse into body, looking for the target.
///   - When body has NO files under `target_prefix` AND is non-empty,
///     mark this module as external.
///   - Otherwise keep it intact and recurse.
///
/// Empty bodies (e.g. ones from `Stmt.Module(name, [])` that never
/// got loaded — shouldn't happen post-resolve, but guard anyway)
/// are not modified: making them external would be a no-op since
/// codegen already emits nothing for empty bodies.
/// B-final: the pass boundary is arena-id-native and so is the core
/// walker — the program vector arrives and leaves as `List<StmtId>`
/// (the flipped inject_intrinsics / expand_components pipeline hands ids
/// straight through), and `filter_inner_wrapped` now filters ids in
/// place: kept rows pass through by id, rewritten rows re-allocate
/// against their source span via `restmt`.
export fn filter_to_target_unit(store: NodeStore, ids: List<StmtId>, target_prefix: string) -> List<StmtId> {
    let debug = avra_process_env_get("AVRA_FILTER_DEBUG") != ""
    if debug {
        let _ = dump_top_level(store, ids, "  ")
    }
    filter_inner_wrapped(store, ids, target_prefix, debug)
}

fn dump_top_level(store: NodeStore, ids: List<StmtId>, indent: string) -> int {
    for id in ids {
        match store.stmts.get(id) {
            .Module(name, body) -> {
                eprintln("[dump] ${indent}Module(${name}) [body_empty=${body.length == 0}]")
                if body.length != 0 {
                    let _ = dump_top_level(store, body, indent + "  ")
                }
            }
            .Annotated(_, inner) -> match store.stmts.get(inner) {
                .Module(name, _) -> eprintln("[dump] ${indent}Annotated.Module(${name})")
                _ -> {}
            }
            _ -> {}
        }
    }
    0
}

fn filter_inner_wrapped(store: NodeStore, ids: List<StmtId>, target_prefix: string, debug: bool) -> List<StmtId> {
    mut out: List<StmtId> = []
    for id in ids {
        let head = match store.stmts.get(id) {
            .Module(name, body) -> {
                if body_has_file_under(store, body, target_prefix) {
                    if debug { eprintln("[filter] keep Module ${name}") }
                    let inner = filter_inner_wrapped(store, body, target_prefix, debug)
                    store.restmt(Stmt.Module(name, inner), id)
                } else if body.length != 0 {
                    if debug { eprintln("[filter] external Module ${name}") }
                    annotate_external(store, id)
                } else {
                    if debug { eprintln("[filter] empty-body Module ${name}") }
                    id
                }
            }
            .Annotated(annots, inner) -> match store.stmts.get(inner) {
                .Module(name, body) -> {
                    if body_has_file_under(store, body, target_prefix) {
                        if debug { eprintln("[filter] keep Annotated Module ${name}") }
                        let inner_filtered = filter_inner_wrapped(store, body, target_prefix, debug)
                        store.restmt(Stmt.Annotated(annots, store.restmt(Stmt.Module(name, inner_filtered), inner)), id)
                    } else if body.length != 0 {
                        if debug { eprintln("[filter] external Annotated Module ${name}") }
                        annotate_external(store, id)
                    } else {
                        id
                    }
                }
                _ -> id
            }
            _ -> id
        }
        out.push(head)
    }
    out
}
