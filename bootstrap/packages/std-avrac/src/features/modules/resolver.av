// WHY: resolves module file references. Walks the AST, finds
// Stmt.Module stubs, reads the corresponding .av files, parses
// them, and attaches the parsed bodies. This is the bridge between
// the pure parser (no I/O) and the file system.

use core.ast.{Stmt, StmtList, SStmt, sstmt, AnnotationList}
use parse.{parse_program_source}

/// Return the directory portion of a path (including the trailing
/// slash), or `""` when `path` has no directory part. Used to
/// build sibling/child paths during module resolution.
export fn modules_dirname(path: string) -> string {
    let len = path.length
    mut i = len
    while i > 0 {
        let prev = i - 1
        if path[prev] == "/" {
            return path.substring(0, i)
        }
        i = prev
    }
    ""
}

/// Set of file paths the resolver has already loaded — prevents
/// double-parsing when two modules import the same file.
export enum LoadedPaths {
    End
    Node(path: string, next: LoadedPaths)
}

/// Membership test for `LoadedPaths`.
fn loaded_has(paths: LoadedPaths, path: string) -> bool {
    match paths {
        .End -> false
        .Node(p, _) if p == path -> true
        .Node(_, next) -> loaded_has(next, path)
    }
}

/// Result of resolving a list of statements that may contain
/// `Module`/`Use` items.
///
/// @field stmts         — the resolved statements (with module
///                         bodies attached).
/// @field loaded        — running set of already-loaded files.
/// @field had_error     — 1 when resolution failed.
/// @field error_message — diagnostic when `had_error` is set.
export type ModListResult = {
    stmts: StmtList,
    loaded: LoadedPaths,
    had_error: int,
    error_message: string,
}

/// Result of resolving a single statement. Same shape as
/// `ModListResult` but with one statement instead of a list.
///
/// @field stmt          — the resolved single statement.
/// @field loaded        — running set of already-loaded files.
/// @field had_error     — 1 when resolution failed.
/// @field error_message — diagnostic when `had_error` is set.
type ModStmtResult = {
    stmt: Stmt,
    loaded: LoadedPaths,
    had_error: int,
    error_message: string,
}

/// Stack of files currently being resolved — for circular-import
/// detection. Separate from LoadedPaths (which tracks ALL resolved
/// files); this only tracks the active resolution chain.
enum ImportStack {
    End
    Node(path: string, next: ImportStack)
}

/// Membership test for `ImportStack`. Used to detect cycles.
fn stack_has(stack: ImportStack, path: string) -> bool {
    match stack {
        .End -> false
        .Node(p, _) if p == path -> true
        .Node(_, next) -> stack_has(next, path)
    }
}

/// Render the import stack as `a.av -> b.av -> a.av` for cycle-
/// import error messages. Stops at the first occurrence of
/// `cycle_path`, since that's where the cycle closes.
fn render_cycle(stack: ImportStack, cycle_path: string) -> string {
    mut parts = cycle_path
    mut cur = stack
    while true {
        match cur {
            .End -> { return parts }
            .Node(p, next) -> {
                parts = "${p} -> ${parts}"
                cur = next
                if p == cycle_path { return parts }
            }
        }
    }
    parts
}

/// Find the packages directory by searching upward from `dir`.
/// Three strategies in order: (1) look for `/packages/` in the
/// path itself, (2) probe `packages/std-cli/src/cli.av` from the
/// CWD, (3) walk upward looking for an ancestor `packages/`. The
/// `std-cli` probe is the canonical sentinel — if it doesn't
/// exist, the directory isn't a packages root.
export fn find_packages_dir(dir: string) -> string {
    // Strategy 1: look for `/packages/` in the path itself (when compiling from within packages/)
    let marker = "/packages/"
    let idx = dir.index_of(marker)
    if idx >= 0 {
        return dir.substring(0, idx + marker.length)
    }
    // Strategy 2: check common relative locations from the working directory
    // This handles relative paths like "regress/foo/" where walking up
    // from the relative path can't find the repo root.
    let cwd_probe = "packages/std-cli/src/cli.av"
    if avra_selfhost_file_exists(cwd_probe) {
        return "packages/"
    }
    // Strategy 3: walk upward from dir looking for a sibling `packages/` directory
    mut search = dir
    while search.length > 1 {
        let candidate = "${search}packages/"
        let probe = "${candidate}std-cli/src/cli.av"
        if avra_selfhost_file_exists(probe) {
            return candidate
        }
        // Go up one directory: strip trailing slash, then find last slash
        mut trimmed = search
        if trimmed.length > 0 && trimmed[trimmed.length - 1] == "/" {
            trimmed = trimmed.substring(0, trimmed.length - 1)
        }
        // Find last slash by scanning backward
        mut last_slash = -1
        mut si = trimmed.length - 1
        while si >= 0 {
            if trimmed[si] == "/" {
                last_slash = si
                break
            }
            si = si - 1
        }
        if last_slash < 0 { break }
        search = trimmed.substring(0, last_slash + 1)
    }
    ""
}

/// Map a @-scoped package path like `@std.cli` to its on-disk
/// file: `${packages_dir}/std-cli/src/cli.av` or, when that
/// doesn't exist, `${packages_dir}/std-cli/src/mod.av`. Returns
/// `""` when neither file exists or `packages_dir` is empty.
export fn resolve_package_path(pkg_path: string, packages_dir: string) -> string {
    // pkg_path is like "@std.cli" — extract scope ("std") and name ("cli")
    if packages_dir == "" { return "" }
    // Skip the "@" prefix
    let without_at = pkg_path.substring(1, pkg_path.length)
    // Split on first "."
    let dot = without_at.index_of(".")
    if dot < 0 { return "" }
    let scope = without_at.substring(0, dot)
    let name = without_at.substring(dot + 1, without_at.length)
    // Check for sub-path (e.g., "@std.cli.sub" → name="cli", sub="sub")
    let name_dot = name.index_of(".")
    mut pkg_name = name
    if name_dot >= 0 {
        pkg_name = name.substring(0, name_dot)
    }
    let pkg_dir = "${packages_dir}${scope}-${pkg_name}/src/"
    // Try the package-name file first, then mod.av
    let entry = "${pkg_dir}${pkg_name}.av"
    if avra_selfhost_file_exists(entry) { return entry }
    let mod_entry = "${pkg_dir}mod.av"
    if avra_selfhost_file_exists(mod_entry) { return mod_entry }
    ""
}

/// Resolve every `Stmt.Module` stub in `stmts` by reading the
/// matching .av file, parsing it, and attaching the parsed body.
/// Cycles are detected via an internal ImportStack.
///
/// The result has every `@`-prefixed package wrapper hoisted to
/// the top of the program. Without that step a `use @std.lsp.{X}`
/// at the cli's main.av could fail to resolve because the @std.lsp
/// wrapper got emitted inside a deep submodule (e.g. inside
/// `@std.avrac.indexer` which uses @std.lsp internally) — hoisting
/// guarantees package paths exist at root regardless of where they
/// were first imported.
export fn resolve_module_files(stmts: StmtList, dir: string, loaded: LoadedPaths) -> ModListResult {
    let inner = resolve_module_files_inner(stmts, dir, loaded, ImportStack.End)
    if inner.had_error { return inner }
    let split = hoist_package_modules(inner.stmts)
    ModListResult {
        stmts: append_stmt_list(split.packages, split.body),
        loaded: inner.loaded,
        had_error: false,
        error_message: "",
    }
}

/// Buckets produced by `hoist_package_modules`: every `@`-prefixed
/// `Module` lives in `packages`, the rest in `body`. The two get
/// concatenated to put package wrappers at the program root.
type HoistSplit = {
    packages: StmtList,
    body: StmtList,
}

/// Walk the resolved stmt list and pull every `@`-prefixed Module
/// (package wrapper) out to a separate list. Only @-prefixed
/// Modules are rebuilt; other statements pass through unchanged so
/// the post-resolve AST stays byte-identical to the legacy path
/// when no hoisting is needed (preserves the bs2/bs3 fixed point).
/// Recurses into both `@`-prefixed and regular Module bodies so a
/// sub-package wrapper that landed inside another package (e.g.
/// `@std.lsp` inside `@std.avrac.indexer`) also reaches the root.
fn hoist_package_modules(stmts: StmtList) -> HoistSplit {
    match stmts {
        .End -> HoistSplit { packages: StmtList.End, body: StmtList.End }
        .Node(ss, next) -> {
            let rest = hoist_package_modules(next)
            match ss.node {
                .Module(name, body) if name.length > 0 && name[0] == "@" -> {
                    let inner = hoist_package_modules(body)
                    let cleaned = sstmt(Stmt.Module(name, inner.body), ss.line, ss.col)
                    HoistSplit {
                        packages: append_stmt_list(inner.packages, StmtList.Node(cleaned, rest.packages)),
                        body: rest.body,
                    }
                }
                .Module(name, body) -> {
                    let inner = hoist_package_modules(body)
                    if has_no_packages(inner) {
                        HoistSplit {
                            packages: rest.packages,
                            body: StmtList.Node(ss, rest.body),
                        }
                    } else {
                        let cleaned = sstmt(Stmt.Module(name, inner.body), ss.line, ss.col)
                        HoistSplit {
                            packages: append_stmt_list(inner.packages, rest.packages),
                            body: StmtList.Node(cleaned, rest.body),
                        }
                    }
                }
                _ -> HoistSplit {
                    packages: rest.packages,
                    body: StmtList.Node(ss, rest.body),
                }
            }
        }
    }
}

/// True iff the inner hoist split produced no @-prefixed modules
/// to lift. Used to short-circuit the rebuild of regular Module
/// nodes when nothing inside them needed hoisting — the original
/// SStmt can pass through verbatim, preserving span identity.
fn has_no_packages(split: HoistSplit) -> bool {
    match split.packages {
        .End -> true
        _ -> false
    }
}

/// Concat two stmt lists order-preservingly. Pulled in here so
/// `resolve_module_files` can reuse it for the hoist append without
/// dragging in another module dependency.
fn append_stmt_list(a: StmtList, b: StmtList) -> StmtList {
    match a {
        .End -> b
        .Node(ss, next) -> StmtList.Node(ss, append_stmt_list(next, b))
    }
}

/// True when the use path is a `@scope.pkg` package import
/// (rather than a relative `mod.sub` reference).
export fn is_package_use(path: string) -> bool {
    path.length > 0 && path[0] == "@"
}

/// Reduce a use path to its top-level package module name.
/// Examples: `@std.cli` → `@std.cli`,
/// `@std.cli.sub` → `@std.cli`. Used to load each package once
/// even when multiple sub-paths import from it.
export fn package_module_name(path: string) -> string {
    // Skip "@" prefix, find scope.name
    let without_at = path.substring(1, path.length)
    let dot = without_at.index_of(".")
    if dot < 0 { return path }
    let scope = without_at.substring(0, dot)
    let rest = without_at.substring(dot + 1, without_at.length)
    let next_dot = rest.index_of(".")
    if next_dot >= 0 {
        let name = rest.substring(0, next_dot)
        return "@${scope}.${name}"
    }
    path
}

/// Walk every statement (recursing into Module bodies) inside a
/// package's resolved AST and rewrite each non-`@`-prefixed
/// `use X.Y.{...}` to `use ${pkg_qual}.X.Y.{...}`. This anchors
/// internal paths to the package's own root so they survive the
/// `Module("@scope") { Module(name) { ... } }` wrapping the consumer
/// puts around the package — without it, a `use codegen.X` written
/// inside std-avrac would resolve against the consumer's top-level
/// scope (and miss, or worse, latch onto a same-named local sibling
/// during the parent-walk in `resolve_use_aliases_in`).
///
/// Skips uses that are already package-qualified (`@scope.pkg.…`)
/// and uses already qualified to *this* package — those carry their
/// anchor explicitly. The recursion goes into every Module body so
/// sub-files (e.g. `features/match_expr/typeck.av`) get anchored
/// just like the package's top-level body does.
fn qualify_uses_recursively(stmts: StmtList, pkg_qual: string) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> {
            let head = qualify_use_in_stmt(ss, pkg_qual)
            StmtList.Node(head, qualify_uses_recursively(next, pkg_qual))
        }
    }
}

/// Per-statement worker: rewrite `Use` (handling Annotated wrappers)
/// and recurse into `Module` bodies. Other statements pass through.
/// Annotated wrappers transparently delegate to the inner stmt's
/// rewrite, then re-attach the annotation — `Use` and `Module`
/// arms don't need to know about Annotated.
fn qualify_use_in_stmt(ss: SStmt, pkg_qual: string) -> SStmt {
    sstmt(qualify_inner_stmt(ss.node, pkg_qual), ss.line, ss.col)
}

fn qualify_inner_stmt(stmt: Stmt, pkg_qual: string) -> Stmt {
    match stmt {
        .Use(up, names) -> Stmt.Use(anchor_use_path(up, pkg_qual), names)
        .Module(name, body) -> Stmt.Module(name, qualify_uses_recursively(body, pkg_qual))
        .Annotated(annots, inner) -> Stmt.Annotated(annots, qualify_inner_stmt(inner, pkg_qual))
        _ -> stmt
    }
}

/// Decide whether a use path needs the `${pkg_qual}.` prefix:
///   - Already starts with `@` → cross-package, leave alone.
///   - Already starts with `${pkg_qual}.` → already anchored.
///   - Otherwise → prepend `${pkg_qual}.`.
fn anchor_use_path(up: string, pkg_qual: string) -> string {
    if up.length > 0 && up[0] == "@" { return up }
    let prefix = "${pkg_qual}."
    if up.length >= prefix.length && up.substring(0, prefix.length) == prefix { return up }
    "${pkg_qual}.${up}"
}

/// Recursive worker for `resolve_module_files`. Walks each
/// statement, resolving `Module` and `Use` stubs in place;
/// non-import statements pass through unchanged. Threads the
/// LoadedPaths set + ImportStack through every recursive call.
fn resolve_module_files_inner(stmts: StmtList, dir: string, loaded: LoadedPaths, stack: ImportStack) -> ModListResult {
    match stmts {
        .End -> ModListResult { stmts: StmtList.End, loaded, had_error: false, error_message: "" }
        .Node(ss, next) -> {
            // Check for package use statements — auto-load the package module
            // Unwrap Annotated wrappers (e.g., doc comments) to find Use statements
            let is_pkg = match ss.node {
                .Use(up, _) -> is_package_use(up)
                .Annotated(_, inner) -> match inner {
                    .Use(up, _) -> is_package_use(up)
                    _ -> false
                }
                _ -> false
            }
            if is_pkg {
                return resolve_package_use_and_continue(ss, next, dir, loaded, stack)
            }
            let head = resolve_module_stmt(ss.node, dir, loaded, stack)
            if head.had_error {
                return ModListResult { stmts: StmtList.End, loaded: head.loaded, had_error: true, error_message: head.error_message }
            }
            let rest = resolve_module_files_inner(next, dir, head.loaded, stack)
            if rest.had_error { return rest }
            ModListResult {
                stmts: StmtList.Node(sstmt(head.stmt, ss.line, ss.col), rest.stmts),
                loaded: rest.loaded,
                had_error: false,
                error_message: "",
            }
        }
    }
}

/// Pull the use-path string out of a `Use` statement, peeling
/// any `Annotated` wrappers (doc comments, attributes) along the
/// way. Returns `""` when `stmt` isn't a Use.
export fn extract_use_path(stmt: Stmt) -> string {
    match stmt {
        .Use(up, _) -> up
        .Annotated(_, inner) -> extract_use_path(inner)
        _ -> ""
    }
}

/// Handle a `use @pkg` statement: locate the package source
/// file, parse it, wrap the parsed body in nested
/// `Module("@scope") { Module(name) { ... } }` so the resolver
/// sees the package's symbols at their qualified path. Continue
/// resolution on the rest of the input list.
fn resolve_package_use_and_continue(ss: SStmt, next: StmtList, dir: string, loaded: LoadedPaths, stack: ImportStack) -> ModListResult {
    let use_path = extract_use_path(ss.node)
    let pkg_mod = package_module_name(use_path)
    let packages_dir = find_packages_dir(dir)
    if packages_dir == "" {
        return ModListResult { stmts: StmtList.End, loaded, had_error: true, error_message: "cannot resolve package `${pkg_mod}`: no packages/ directory found in path" }
    }
    let pkg_file = resolve_package_path(pkg_mod, packages_dir)
    if pkg_file == "" {
        return ModListResult { stmts: StmtList.End, loaded, had_error: true, error_message: "package `${pkg_mod}` not found" }
    }
    if loaded_has(loaded, pkg_file) {
        // Already loaded — just pass through the use statement
        let rest = resolve_module_files_inner(next, dir, loaded, stack)
        if rest.had_error { return rest }
        return ModListResult {
            stmts: StmtList.Node(ss, rest.stmts),
            loaded: rest.loaded,
            had_error: false,
            error_message: "",
        }
    }
    // Load and parse the package file
    let new_loaded = LoadedPaths.Node(pkg_file, loaded)
    let pkg_source = avra_selfhost_read_file(pkg_file)
    let parsed = parse_program_source(pkg_source)
    if parsed.had_error || parsed.stmts == null {
        return ModListResult { stmts: StmtList.End, loaded: new_loaded, had_error: true, error_message: "error in package `${pkg_mod}`: ${parsed.error_message}" }
    }
    let pkg_dir = modules_dirname(pkg_file)
    let resolved = resolve_module_files_inner(parsed.stmts!, pkg_dir, new_loaded, stack)
    if resolved.had_error { return resolved }
    // Create a nested module structure: @std → cli → {body}
    let without_at = pkg_mod.substring(1, pkg_mod.length)
    let dot = without_at.index_of(".")
    let scope_name = without_at.substring(0, dot)
    let pkg_name = without_at.substring(dot + 1, without_at.length)
    // Anchor every internal `use X.Y` inside the loaded body to this
    // package's root before wrapping. Same effect graph_find_use_path's
    // ancestor walk would deliver, but doing it upfront eliminates
    // a class of corner cases where the parent walk picks a same-named
    // local sub-module before reaching the intended top-level package
    // member. Once name resolution drops the parallel ModuleNode tree
    // entirely, this upfront pass can be removed in favour of the
    // graph's lazy resolution.
    let pkg_qual = "@${scope_name}.${pkg_name}"
    let qualified_body = qualify_uses_recursively(resolved.stmts, pkg_qual)
    let inner_mod = Stmt.Module(pkg_name, qualified_body)
    let outer_mod = Stmt.Module("@${scope_name}", StmtList.Node(sstmt(inner_mod, ss.line, ss.col), StmtList.End))
    // Continue processing rest of the statement list
    let rest = resolve_module_files_inner(next, dir, resolved.loaded, stack)
    if rest.had_error { return rest }
    // Emit: [module_decl, use_stmt, ...rest]
    ModListResult {
        stmts: StmtList.Node(
            sstmt(outer_mod, ss.line, ss.col),
            StmtList.Node(ss, rest.stmts)
        ),
        loaded: rest.loaded,
        had_error: false,
        error_message: "",
    }
}

/// Resolve a single `mod name` statement: locate `name.av` or
/// `name/mod.av` relative to `dir`, parse it, recursively resolve
/// nested modules, and return a populated `Stmt.Module(name, body)`.
/// Detects circular imports via `stack` and returns F3103 in that
/// case. `Annotated` wrappers around the module decl pass through.
fn resolve_module_stmt(stmt: Stmt, dir: string, loaded: LoadedPaths, stack: ImportStack) -> ModStmtResult {
    match stmt {
        .Module(name, _) -> {
            let sibling = "${dir}${name}.av"
            let dir_mod = "${dir}${name}/mod.av"
            mut mod_path = ""
            if avra_selfhost_file_exists(sibling) { mod_path = sibling }
            if mod_path == "" && avra_selfhost_file_exists(dir_mod) { mod_path = dir_mod }
            if mod_path == "" {
                return ModStmtResult { stmt, loaded, had_error: true, error_message: "module `${name}` not found (looked for ${sibling} and ${dir_mod})" }
            }
            // Circular import detection: if mod_path is on the import
            // stack, we have a cycle. Report a clear error.
            if stack_has(stack, mod_path) {
                let cycle = render_cycle(stack, mod_path)
                return ModStmtResult { stmt, loaded, had_error: true, error_message: "[F3103] circular import detected: ${cycle}" }
            }
            if loaded_has(loaded, mod_path) {
                return ModStmtResult { stmt: Stmt.Module(name, StmtList.End), loaded, had_error: false, error_message: "" }
            }
            let new_loaded = LoadedPaths.Node(mod_path, loaded)
            let new_stack = ImportStack.Node(mod_path, stack)
            let mod_source = avra_selfhost_read_file(mod_path)
            let parsed = parse_program_source(mod_source)
            if parsed.had_error || parsed.stmts == null {
                return ModStmtResult { stmt, loaded: new_loaded, had_error: true, error_message: "error in module `${name}`: ${parsed.error_message}" }
            }
            let mod_dir = modules_dirname(mod_path)
            let resolved = resolve_module_files_inner(parsed.stmts!, mod_dir, new_loaded, new_stack)
            if resolved.had_error {
                return ModStmtResult { stmt, loaded: resolved.loaded, had_error: true, error_message: resolved.error_message }
            }
            ModStmtResult { stmt: Stmt.Module(name, resolved.stmts), loaded: resolved.loaded, had_error: false, error_message: "" }
        }
        .Annotated(annotations, inner) -> {
            let r = resolve_module_stmt(inner, dir, loaded, stack)?
            ModStmtResult { stmt: Stmt.Annotated(annotations, r.stmt), loaded: r.loaded, had_error: false, error_message: "" }
        }
        _ -> ModStmtResult { stmt, loaded, had_error: false, error_message: "" }
    }
}
