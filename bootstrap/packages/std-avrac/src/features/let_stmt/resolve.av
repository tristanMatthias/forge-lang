// The let-destructure statement's RESOLVER hook. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram,
// and which fn implements each pass — and the pass logic lives in the file
// named for that pass. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{Stmt}
use resolve.{Resolver, define_param_names, resolve_expr}

/// Resolver hook for `let (a, b, c) = ...`. Resolves the
/// initializer first, then defines each tuple-position name in
/// the post-init scope.
fn let_destructure_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .LetDestructure(names, initializer) -> {
            let after_init = resolve_expr(r, r.nodes.exprs.get(initializer))
            define_param_names(after_init, names)
        }
        _ -> r
    }
}
