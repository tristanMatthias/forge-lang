// WHY: emits LLVM IR for `let` and `mut` variable bindings.
// Handles trait boxing: `let d: Describable = Circle { ... }` creates
// a trait object with a vtable for dynamic dispatch.

use core.{Expr, SExpr, ValueType, VarBinding, vtype_is_unknown, vtype_trait_name, vtype_struct_name, vtype_enum_name, vtype_list_elem, vtype_is_list}
use core.{type_registry_id_for, method_mangled_name}
use codegen.{Ctx, ok_stmt, vtype_is_copy, releasable_has}
use features.trait_decl.{box_for_trait}
use features.union_type.{emit_union_wrap, needs_union_wrap}
use diagnostics.{DiagCode}

/// Codegen for `let / mut / const name = init`. Handles four
/// orthogonal special cases on top of the bare alloca + store:
/// (1) Copy-type stack allocation when the type qualifies and
///     the local is non-escaping (spec 9.12);
/// (2) trait boxing when the declared type is a `Trait`;
/// (3) `List<Trait>` element-by-element boxing;
/// (4) union-wrapping when the declared type is a Union and
///     the value is a concrete member.
export fn emit_var_decl(ctx: Ctx, env: List<VarBinding>, name: string, ty_vt: ValueType, initializer: Expr) -> Result<List<VarBinding>, string> {
    // Copy-type stack allocation (spec 9.12): if the initializer is
    // a struct literal, the type is Copy, and the local is releasable
    // (non-escaping), pre-allocate a stack buffer and pass it through
    // Ctx so emit_struct_lit writes directly into it. No heap alloc needed.
    let copy_target = try_copy_stack_target(ctx, name, ty_vt, initializer)
    let emit_ctx = if copy_target.active {
        ctx with { copy_alloc_target: copy_target.alloca_ptr }
    } else {
        ctx
    }
    let r = emit_ctx.emit(env, initializer)?
    // Use the type annotation when present, otherwise infer from initializer.
    let var_ty = if !vtype_is_unknown(ty_vt) {
        ctx.resolve_codegen_vtype(ty_vt)
    } else {
        r.ty
    }
    // Trait boxing: `let d: Trait = concrete_value`
    let trait_name = vtype_trait_name(var_ty)
    if trait_name != "" {
        let concrete_name = resolve_concrete_name(r.ty)
        if concrete_name != "" {
            let obj_i64 = box_for_trait(ctx, r.value, trait_name, concrete_name)
            return ok_stmt(ctx.bind(env, name, obj_i64, var_ty))
        }
    }
    // List<Trait> boxing: `let xs: List<Trait> = [concrete1, concrete2]`
    // Each element must be individually boxed as a trait object.
    if vtype_is_list(var_ty) {
        let elem_ty = vtype_list_elem(var_ty)
        let elem_trait = vtype_trait_name(elem_ty)
        if elem_trait != "" {
            match initializer {
                .ListLit(elements) -> {
                    let boxed_list = emit_trait_boxed_list(ctx, env, elements, elem_trait)?
                    return ok_stmt(ctx.bind(env, name, boxed_list, var_ty))
                }
                _ -> {
                    ctx.warn(DiagCode.TypeMismatch, "List<${elem_trait}> binding requires a list literal for trait boxing — variable assignment skips boxing")
                }
            }
        }
    }
    // Union wrapping: `let x: int | string = 42` → wrap into discriminated union
    if needs_union_wrap(r.ty, var_ty) {
        let wrapped = emit_union_wrap(ctx, r.value, r.ty, var_ty)?
        return ok_stmt(ctx.bind(env, name, wrapped.value, var_ty))
    }
    // For Copy-type stack allocations, bind without RC cleanup.
    // The struct data is on the stack — no heap free needed.
    if copy_target.active {
        let sn = vtype_struct_name(var_ty)
        if sn != "" {
            return ok_stmt(ctx.bind_copy_stack(env, name, r.value, var_ty, sn))
        }
    }
    ok_stmt(ctx.bind(env, name, r.value, var_ty))
}

/// Result of the Copy-type stack-allocation probe. `active`
/// is true when the optimisation fires; `alloca_ptr` then holds
/// the pre-allocated stack buffer that the struct/with emitter
/// should write into directly.
///
/// @field active     — 1 when stack allocation should happen.
/// @field alloca_ptr — pre-built stack buffer.
type CopyTarget = { active: bool, alloca_ptr: ptr }

/// Probe whether `let name = init` qualifies for Copy-type
/// stack allocation. Returns an inactive CopyTarget unless
/// `init` is a struct literal / `with` expr targeting a Copy
/// type and `name` is non-escaping (releasable). Spec 9.12.
fn try_copy_stack_target(ctx: Ctx, name: string, ty_vt: ValueType, init: Expr) -> CopyTarget {
    let n: ptr = null
    if !releasable_has(ctx.rc_releasable, name) {
        return CopyTarget { active: false, alloca_ptr: n }
    }
    match init {
        .StructLit(sname, _) -> try_copy_for_struct(ctx, name, ty_vt, sname)
        .With(_, _) -> {
            let var_ty = ctx.resolve_codegen_vtype(ty_vt)
            let sname = vtype_struct_name(var_ty)
            if sname != "" {
                return try_copy_for_struct(ctx, name, ty_vt, sname)
            }
            CopyTarget { active: false, alloca_ptr: n }
        }
        _ -> CopyTarget { active: false, alloca_ptr: n }
    }
}

/// Decide whether a struct-typed binding gets Copy stack
/// allocation. Skips when the struct has a custom `drop` impl
/// (drops require heap so RC can release them), otherwise
/// `alloca`s a fresh stack buffer of the struct's LLVM type.
fn try_copy_for_struct(ctx: Ctx, name: string, ty_vt: ValueType, sname: string) -> CopyTarget {
    let n: ptr = null
    let drop_fn = ctx.get_fn(method_mangled_name(sname, "drop"))
    if drop_fn != null { return CopyTarget { active: false, alloca_ptr: n } }
    let var_ty = if !vtype_is_unknown(ty_vt) { ctx.resolve_codegen_vtype(ty_vt) } else { ValueType.Struct(sname, type_registry_id_for(ctx.type_reg, sname)) }
    if vtype_is_copy(var_ty, ctx.copy_types) {
        let st_ty = ctx.get_type(sname)
        if st_ty != null {
            let buf = ctx.alloca(st_ty, "${name}_copy")
            return CopyTarget { active: true, alloca_ptr: buf }
        }
    }
    CopyTarget { active: false, alloca_ptr: n }
}

/// Pull the concrete type name from a `Struct(name)` or
/// `Enum(name)` ValueType. Returns "" for everything else —
/// caller falls back to no-op boxing.
fn resolve_concrete_name(ty: ValueType) -> string {
    let s = vtype_struct_name(ty)
    if s != "" { return s }
    let e = vtype_enum_name(ty)
    if e != "" { return e }
    ""
}

/// Build a `List<Trait>` list-literal where each element gets
/// boxed as a trait object before being pushed. Used for
/// `let xs: List<Trait> = [c1, c2]` so callers see one type at
/// runtime even when the elements have different concrete types.
fn emit_trait_boxed_list(ctx: Ctx, env: List<VarBinding>, elements: List<SExpr>, trait_name: string) -> Result<ptr, string> {
    let arr = ctx.array_new()
    push_boxed_elements(ctx, env, arr, elements, trait_name)
}

/// Recursive worker for `emit_trait_boxed_list`. Emits each
/// element, boxes it for the trait when its type is concrete,
/// and pushes the result onto `arr`.
fn push_boxed_elements(ctx: Ctx, env: List<VarBinding>, arr: ptr, elements: List<SExpr>, trait_name: string) -> Result<ptr, string> {
    mut i = 0
    while i < elements.length {
        let r = ctx.emit(env, elements[i].node)?
        let concrete_name = resolve_concrete_name(r.ty)
        let boxed = if concrete_name != "" {
            box_for_trait(ctx, r.value, trait_name, concrete_name)
        } else {
            // Already boxed or unknown type — push as-is
            r.value
        }
        ctx.array_push(arr, boxed)
        i = i + 1
    }
    .Ok(arr)
}

// build_vtable and push_vtable_entries removed — use box_for_trait from codegen/mod.av
