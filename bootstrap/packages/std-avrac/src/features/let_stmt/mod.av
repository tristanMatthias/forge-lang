// dir-as-module (g2eo.1): codegen.av + typeck.av + grammar.av auto-load
// as siblings, surface flat at `features.let_stmt.{...}` (the decl fragment, now inline on let_lang
// and bind_destructure are in scope without a self-import); the manifest
// rows live in lowering/ (t-kd4y.3.2.3).
use codegen.{StmtResult}
use codegen.{ok_sr, err_sr}
use core.{vtype_display}
use diagnostics.{DiagCode}
use features.{composed}
use features.let_stmt.lowering.{let_builds}
use features.tuples.{emit_let_destructure}
use typeck.{check_expr, tc_report}
use features.grammar.{parse_grammar}

/// `let` — the binding family's definition carries the feature whole
/// (t-kd4y.3.2.3): syntax, docs, editor surface, and ALL FOUR lowerings
/// (the `mut`/`const`/destructure rows ride here too — one gram fragment,
/// one manifest, like for_lang carrying the ForIn/destructure builds).
/// `gram_family` stays "" — the binding rules are DECLARATION rules,
/// composed by the decl view beside the other decl keywords and referenced
/// from its alternations by name. No stmt hooks: `Stmt.Let`/`Mut`/`Const`
/// codegen, resolve, and typeck are core passes, exactly as the retired
/// hookless `feature_new("let")` register left them.
export fn let_lang() -> LanguageFeature {
    LanguageFeature let_def {
        name = "let",
        title = "let — immutable bindings",
        docs = """
`let name = value` binds an immutable name; `let name: Type = value` adds
an annotation. `let mut` (or bare `mut`) makes the binding mutable, and
`let x = init else { … }` runs the diverging guard block when a nullable
initializer is null. `let (a, b) = pair` destructures a tuple by position.
""",
        gram = grammar {
  let_decl   = @try "let" @cut ( m:"mut" )? @require n:IDENT ( ":" @require ty:type_expr )? @require "=" @onfail(bail) init:expression ( "else" e:statement tmp:@gensym(letelse) )?
               @expect("IDENT", "expected variable name")
               @expect("type_expr", "expected type after `:`")
               @expect("=", "expected `=` after variable name") -> MkLetBinding(m, n, ty, init, e, tmp)
  mut_decl   = @try "mut" @cut @require n:IDENT ( ":" @require ty:type_expr )? @require "=" @onfail(bail) init:expression ( "else" e:statement tmp:@gensym(letelse) )?
               @expect("IDENT", "expected variable name")
               @expect("type_expr", "expected type after `:`")
               @expect("=", "expected `=` after variable name") -> MkMutBinding(n, ty, init, e, tmp)
  const_decl = @try "const" @cut @require n:IDENT ( ":" @require ty:type_expr )? @require "=" @onfail(bail) init:expression
               @expect("IDENT", "expected constant name")
               @expect("type_expr", "expected type after `:`")
               @expect("=", "expected `=` after constant name") -> MkConstBinding(n, ty, init)
  // `let (a, b, …) = init` — the destructure binding. The list shape is
  // `for_binding`'s, verbatim: `@peek(comma_ident)` gates each repeat
  // iteration so a trailing comma survives to the `","?` (`(a, b,)` is
  // tolerated), and the whole names group is optional because an EMPTY list
  // is accepted (`let () = t` parses — entries are typed at check time).
  // `( m:"mut" )?`: an optional `mut` is consumed BEFORE testing for `(`,
  // and the destructure build never reads is_mut — so `let mut (a, b) = t`
  // is a plain destructure on both engines. A BARE `mut (` stays an error
  // (mut_decl demands an identifier), which is why mut_decl has no
  // destructure sibling.
  letdes_decl = @peek(let_destructure) "let" ( m:"mut" )? "(" ( n:IDENT ( @peek(comma_ident) "," n:IDENT )* ","? )? @require ")" @require "=" @onfail(bail) init:expression
                @expect(")", "expected `)` after destructure names")
                @expect("=", "expected `=` after destructure pattern") -> MkDestructure(n, init)
            },
        builders = let_builds(),
        snippet = r"let ${1:name} = ${2:value}",
    }
    let_def
}

/// `mut` — mutable bindings. The SYNTAX lives in let_lang's gram
/// (`mut_decl`, plus the `let mut` modifier on `let_decl`), so this
/// definition carries the surface alone.
export fn mut_lang() -> LanguageFeature {
    LanguageFeature mut_def {
        name = "mut",
        title = "mut — mutable bindings",
        docs = """
`mut name = value` binds a name whose value may be reassigned. Equivalent
to `let mut name = value`. Module-level `mut` is a mutable global; prefer
function-local `mut` and thread state explicitly.
""",
        snippet = r"mut ${1:name} = ${2:value}",
    }
    mut_def
}

/// `const` — compile-time constant bindings. Syntax in let_lang's gram
/// (`const_decl`); surface only.
export fn const_lang() -> LanguageFeature {
    LanguageFeature const_def {
        name = "const",
        title = "const — constant bindings",
        docs = """
`const NAME = value` binds a compile-time constant (SCREAMING_SNAKE by
convention). Module-level consts are scoped per module and referenced
bare within it.
""",
        snippet = r"const ${1:NAME} = ${2:value}",
    }
    const_def
}

/// `let (a, b) = …` — the tuple-destructure statement. A distinct AST tag
/// (`Stmt.LetDestructure`) so codegen / typeck / eval dispatch pick these
/// hooks; the SYNTAX lives in let_lang's gram (`letdes_decl`), so this
/// definition carries hooks alone.
export fn let_destructure_lang() -> LanguageFeature {
    LanguageFeature letdes_def {
        name = "let_destructure",
        title = "let (…) — tuple destructuring",
        stmt_tag = Stmt.LetDestructure([], ExprId(0)),
        emit_stmt = let_destructure_emit_stmt,
        resolve_stmt = let_destructure_resolve_stmt,
        check_stmt = let_destructure_check_stmt,
        eval_stmt = let_destructure_eval_stmt,
    }
    letdes_def
}

/// Type-check hook for `let (a, b, c) = ...`. Checks the
/// initializer then binds each destructured name with its tuple-
/// position type via `bind_destructure`.
fn let_destructure_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .LetDestructure(names, init) -> {
            let r = check_expr(tc, tc.nodes.exprs.get(init))
            let n = names.length
            // §6 layout totality (ps3t.4.9): `let (…) = init` requires a tuple
            // with one element per name. `bind_destructure` → `vtype_tuple_at`
            // yields `.Unknown` for ANY non-tuple initializer OR any out-of-range
            // index, and that `.Unknown` element binding hits the codegen layout
            // boundary as an F9999 ICE (the ps3t.4.5 hard-error backstop). Catch
            // every ill-shaped CONCRETE initializer here with a clean F1000
            // instead. `.Unknown` is deliberately NOT gated: it signals an
            // upstream under-determination (an undefined callee, a failed
            // monomorphization) whose own diagnostic must not be masked by a
            // "not a tuple" message.
            //
            // Every branch then falls through to a single `bind_destructure`, so
            // the names are ALWAYS bound (to their positional element types, or
            // `.Unknown` for an ill-shaped / out-of-range slot) — the error paths
            // never leave a name type-less, which keeps downstream references to
            // them from firing spurious cascade diagnostics on top of the F1000.
            let reported = match r.ty {
                .Tuple(elems) if elems.length == n -> r.tc
                .Tuple(elems) -> tc_report(r.tc, DiagCode.TypeMismatch,
                    "destructuring pattern binds ${n} name(s) but the initializer is a ${elems.length}-tuple — the arities must match")
                .Unknown -> r.tc
                .Void -> tc_report(r.tc, DiagCode.TypeMismatch,
                    "cannot destructure a value of type `Void` — `let (…) = …` needs a ${n}-tuple; the initializer produces no value (a function used here may omit its `-> Type` and return void)")
                _ -> tc_report(r.tc, DiagCode.TypeMismatch,
                    "cannot destructure a value of type `${vtype_display(r.ty)}` — `let (…) = …` needs a ${n}-tuple, not a scalar/collection value")
            }
            bind_destructure(reported, names, r.ty)
        }
        _ -> tc
    }
}

/// Codegen hook for `let (a, b) = ...`. Forwards to the tuples
/// feature's `emit_let_destructure`, which emits per-position
/// loads from the tuple alloca.
fn let_destructure_emit_stmt(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .LetDestructure(names, initializer) -> {
            let new_env = emit_let_destructure(ctx, env, names, ctx.nodes.exprs.get(initializer))?
            ok_sr(ctx, new_env)
        }
        _ -> err_sr("expected LetDestructure")
    }
}
