// WHY: parses `let`, `mut`, and `const` variable bindings, plus the
// bind-fresh guard form `let v = x else { … }` (spec Axis 10.4): bind the
// present value of an optional for the rest of the scope, or run an
// else-block that must diverge. Desugars to a block-expression initializer
// so `v` stays at the outer level and the subject is evaluated once.

use core.{Stmt, Expr, BinOp, ValueType, type_expr_to_vtype, stmt_ids_diverge, expr_force_unwrap, FORCE_UNWRAP_FN, NodeRef, ExprId, StmtId, byte_span_none}
use parse.{Parser}
use core.{Tk}
use diagnostics.{DiagCode}

impl Parser {
    fn parse_let_statement(self) -> Result<StmtId, string> {
        self.advance()
        let is_mut = self.check(Tk.KwMut)
        if is_mut { self.advance() }
        if self.check(Tk.LeftParen) {
            return self.parse_let_destructure()
        }
        let name = self.consume_identifier("expected variable name")?
        mut ty_vt = ValueType.Unknown
        if self.check(Tk.Colon) {
            self.advance()
            let te = self.parse_type_expr("expected type after `:`")?
            ty_vt = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.Equal, "expected `=` after variable name") { return .Err("parse error") }
        let init_id = self.parse_expression()?
        // Guard form: `let v = x else { … }` (also `let mut v = x else { … }`).
        if self.check(Tk.KwElse) {
            return self.build_let_else(name, ty_vt, init_id, is_mut)
        }
        if is_mut { .Ok(self.alloc_binding_stmt(Stmt.Mut(name, ty_vt, init_id), ty_vt)) } else { .Ok(self.alloc_binding_stmt(Stmt.Let(name, ty_vt, init_id), ty_vt)) }
    }

    /// Alloc a Let/Mut/Const row — walker order: the bare declared-type
    /// field contributes a TypeRef (the initializer is an id payload,
    /// so it records no edge — the payload IS the child mechanism).
    fn alloc_binding_stmt(self, node: Stmt, ty_vt: ValueType) -> StmtId {
        self.alloc_stmt(node, byte_span_none(), [NodeRef.TypeRef(self.glue_ingest_type(ty_vt))])
    }

    // `let v = x else { ELSE }` desugars to a block-expression initializer:
    //   let v = { let __t = x;  if __t == none { ELSE } else { __t! } }
    // `v` stays at the outer scope (visible in the continuation); the
    // subject is evaluated once via `__t`; `ELSE` must diverge (so the
    // if-expr's then-branch is valueless and its type is the unwrapped T).
    // `is_mut` selects the outer binding (`let mut v = x else` / `mut v = x
    // else` bind a reassignable `v`) — the fresh binding stays sound either
    // way, since nothing can invalidate the already-unwrapped value.
    fn build_let_else(self, name: string, ty_vt: ValueType, subject_id: ExprId, is_mut: bool) -> Result<StmtId, string> {
        self.advance()
        let else_id = self.parse_statement()?
        // The else-arm body rows: a parsed else-Block's rows are reused
        // verbatim (never re-walked); any other stmt shape wraps as the
        // block's single element.
        let else_ids: List<StmtId> = match self.stmt_of(else_id) {
            .Block(b) -> b
            _ -> [else_id]
        }
        // The else runs only on absence, so `v` can't be bound there — it
        // MUST exit the scope. A non-diverging else would silently behave
        // like `?? default`; require divergence so the two stay distinct.
        if !stmt_ids_diverge(self.store, else_ids) {
            self.report(DiagCode.LetElseMustDiverge, "the `else` of a `let … else` must diverge (`return` / `break` / `continue` / `panic`)")
        }
        let tmp = self.fresh("letelse")
        let unwrap_id = self.alloc_force_unwrap_row(tmp)
        let cond_id = self.alloc_none_check_row(tmp, BinOp.Eq)
        // Flipped Expr.Block holds List<StmtId> (walker-opaque leaf) — the
        // reused else-body rows ARE the structure, so the block-expr is a leaf.
        let else_block = Expr.Block(else_ids)
        let else_block_id = self.alloc_leaf(else_block)
        let guard = Expr.IfExpr(cond_id, else_block_id, unwrap_id)
        let guard_id = self.alloc_leaf(guard)
        let tmp_let_id = self.alloc_binding_stmt(Stmt.Let(tmp, ValueType.Unknown, subject_id), ValueType.Unknown)
        let guard_stmt_id = self.alloc_stmt_leaf(Stmt.Expr(guard_id))
        // The block body rows ARE its two synthesized statements' ids.
        let init = Expr.Block([tmp_let_id, guard_stmt_id])
        let init_id = self.alloc_leaf(init)
        if is_mut { .Ok(self.alloc_binding_stmt(Stmt.Mut(name, ty_vt, init_id), ty_vt)) } else { .Ok(self.alloc_binding_stmt(Stmt.Let(name, ty_vt, init_id), ty_vt)) }
    }

    fn parse_mut_statement(self) -> Result<StmtId, string> {
        self.advance()
        let name = self.consume_identifier("expected variable name")?
        mut ty_vt = ValueType.Unknown
        if self.check(Tk.Colon) {
            self.advance()
            let te = self.parse_type_expr("expected type after `:`")?
            ty_vt = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.Equal, "expected `=` after variable name") { return .Err("parse error") }
        let init_id = self.parse_expression()?
        // `mut v = x else { … }` — bind-fresh guard binding a reassignable `v`.
        if self.check(Tk.KwElse) {
            return self.build_let_else(name, ty_vt, init_id, true)
        }
        .Ok(self.alloc_binding_stmt(Stmt.Mut(name, ty_vt, init_id), ty_vt))
    }

    fn parse_const_statement(self) -> Result<StmtId, string> {
        self.advance()
        let name = self.consume_identifier("expected constant name")?
        mut ty_vt = ValueType.Unknown
        if self.check(Tk.Colon) {
            self.advance()
            let te = self.parse_type_expr("expected type after `:`")?
            ty_vt = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.Equal, "expected `=` after constant name") { return .Err("parse error") }
        let init_id = self.parse_expression()?
        .Ok(self.alloc_binding_stmt(Stmt.Const(name, ty_vt, init_id), ty_vt))
    }

    fn parse_let_destructure(self) -> Result<StmtId, string> {
        self.advance()
        let names = self.parse_destructure_names()?
        if !self.consume(Tk.RightParen, "expected `)` after destructure names") { return .Err("parse error") }
        if !self.consume(Tk.Equal, "expected `=` after destructure pattern") { return .Err("parse error") }
        let init_id = self.parse_expression()?
        // The initializer is an id payload — the row is a leaf.
        .Ok(self.alloc_stmt_leaf(Stmt.LetDestructure(names, init_id)))
    }
}
