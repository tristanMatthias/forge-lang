// The defer/errdefer LanguageFeature definitions (features/defer.av): the
// definition carries title/docs/snippet, its keywords are DERIVED from the
// declared grammar, and the declared rules stay in lockstep with the
// production whole-program grammar — the drift guard until grammar
// composition consumes the definitions directly (t-kd4y follow-up).
use @std.avrac.features.defer.{defer_lang, errdefer_lang}
use @std.avrac.features.{feature_keywords, feature_gram}
use @std.avrac.features.grammar.{render_grammar, avra_program_grammar, avra_stmt_grammar}

spec "defer as a LanguageFeature" {
    then "keywords derive from the declared grammar" {
        let kws = feature_keywords(defer_lang())
        let ekws = feature_keywords(errdefer_lang())
        kws.length == 1 && kws[0] == "defer" && ekws.length == 1 && ekws[0] == "errdefer"
    }
    then "title, docs, and editor snippet are carried" {
        let f = defer_lang()
        let e = errdefer_lang()
        f.title.length > 0 && f.docs.contains("LIFO") && f.snippet.contains("defer")
            && e.title.length > 0 && e.docs.contains("ERROR exit") && e.snippet.contains("errdefer")
    }
    then "declared rules match the production statement grammar, spelling and all" {
        let stmt_view = render_grammar(avra_stmt_grammar())
        let defer_rule = "defer_stmt = \"defer\" e:expression -> MkDefer(e)"
        let errdefer_rule = "errdefer_stmt = \"errdefer\" e:expression -> MkErrdefer(e)"
        render_grammar(feature_gram(defer_lang())).contains(defer_rule) && stmt_view.contains(defer_rule)
            && render_grammar(feature_gram(errdefer_lang())).contains(errdefer_rule) && stmt_view.contains(errdefer_rule)
    }
    then "the whole-program view lowers through the same builders" {
        let prod = render_grammar(avra_program_grammar())
        prod.contains("MkDefer(") && prod.contains("MkErrdefer(")
    }
}
