// The defer/errdefer family's RESOLVER logic. One file per pass
// (features/WHY.md): a feature's mod.av is the CONTAINER — identity, gram, and
// which fn implements each pass — and the pass logic lives in the file named
// for that pass. The two definitions' `resolve_stmt` hooks are one-line
// tag-peeling lambdas that stay inline in mod.av beside the fields they fill;
// the walk itself is here. Module-PRIVATE and staying so: dir-as-module
// flattens every sibling .av into one flat namespace, so mod.av reaches it
// exactly as before the move.
use core.{ExprId}
use resolve.{Resolver, resolve_expr}

/// Resolve a defer/errdefer body in the current scope.
fn resolve_body(r: Resolver, body: ExprId) -> Resolver {
    resolve_expr(r, r.nodes.exprs.get(body))
}
