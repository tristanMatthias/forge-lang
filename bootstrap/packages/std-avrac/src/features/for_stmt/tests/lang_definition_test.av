// The for LanguageFeature definitions (features/for_stmt/mod.av): for_lang
// carries the gram (ONE rule, TWO statements — `..` splits For / ForIn) +
// ALL THREE lowerings + the For-tag hooks; for_in_lang carries the ForIn-tag
// hooks alone. t-kd4y.3.2.2 completed the family — the tuple-destructure
// branch's MkForDestructure / MkForBinding left the engine under their
// existing gram names, so the rule text is unchanged and the feature now
// owns every build its grammar references.
use @std.avrac.features.for_stmt.{for_lang, for_in_lang}
use @std.avrac.features.{feature_keywords, feature_gram, feature_builders}
use @std.avrac.features.grammar.{render_grammar, avra_program_grammar, grammar_build_refs, Grammar}

spec "for as a LanguageFeature (every build its gram references is feature-owned)" {
    then "the keywords derive from the declared grammar" {
        let kws = feature_keywords(for_lang())
        kws.length == 2 && kws[0] == "for" && kws[1] == "in"
    }
    then "titles, docs, and editor surface are carried; for_in is hooks-only" {
        let f = for_lang()
        let fi = for_in_lang()
        f.title.length > 0 && f.docs.contains("half-open") && f.snippet.contains("for")
            && fi.title.length > 0 && feature_gram(for_in_lang()).rules.length == 0
    }
    then "for_stmt + for_binding are DEFINED rules in the feature fragment AND the production grammar, build refs and all" {
        // Structural (the #1243 discipline): the rule table proves the rules
        // exist; grammar_build_refs proves the branch lowerings — build_for
        // at arity 4 AND the destructure pair's references — survive
        // composition. All three resolve to manifest rows now.
        mut ok = true
        for g in [feature_gram(for_lang()), avra_program_grammar()] {
            mut has_stmt = false
            mut has_binding = false
            for r in g.rules {
                if r.name == "for_stmt" { has_stmt = true }
                if r.name == "for_binding" { has_binding = true }
            }
            mut has_for = false
            mut has_destructure = false
            mut has_mkbinding = false
            for br in grammar_build_refs(g) {
                if br.name == "build_for" && br.argc == 4 { has_for = true }
                if br.name == "MkForDestructure" && br.argc == 3 { has_destructure = true }
                if br.name == "MkForBinding" && br.argc == 2 { has_mkbinding = true }
            }
            if !has_stmt || !has_binding || !has_for || !has_destructure || !has_mkbinding { ok = false }
        }
        ok
    }
    then "the whole-program view lowers the range/collection branch through build_for" {
        let prod = render_grammar(avra_program_grammar())
        prod.contains("build_for(v, lo, hi, body)") && !prod.contains("ForLoop(")
    }
    then "all three for builds ride the manifest, spans per the unified protocol" {
        // build_for + the destructure statement are SPANNED (each stamps at
        // st.build_sp); the binding carrier is FLAT "toks" — it stamps
        // nothing, and the unpack row's position comes from the temp token's
        // own pos inside mk_for_destructure, not from the span protocol.
        mut rows = ""
        for b in feature_builders() {
            if b.name == "build_for" || b.name == "MkForDestructure" || b.name == "MkForBinding" {
                rows = "${rows}${b.name}=${b.kind}/${string(b.arity)}/${if b.spanned { "spanned" } else { "flat" }}/${b.export_name} "
            }
        }
        rows.contains("build_for=stmt/4/spanned/build_for_abi ")
            && rows.contains("MkForBinding=toks/2/flat/mk_for_binding_abi ")
            && rows.contains("MkForDestructure=stmt/3/spanned/mk_for_destructure_abi ")
    }
}
