// WHY: ryvy — `for (i, x) in xs.enumerate()` paired index+element
// iteration, plus `a.zip(b)` parallel iteration. The for-header tuple
// binding desugars to a single-variable for-in whose body opens with
// `let (i, x) = <tmp>`, reusing the ForIn + LetDestructure machinery.

spec "for-enumerate" {
    then "index and element both bound" {
        avra_test_capture_start()
        let xs = ["a", "b", "c"]
        for (i, x) in xs.enumerate() {
            println("${i}:${x}")
        }
        let out = avra_test_capture_stop()
        out == "0:a\n1:b\n2:c"
    }

    then "enumerate over ints accumulates index and value" {
        let nums = [10, 20, 30]
        mut acc = 0
        for (i, n) in nums.enumerate() {
            acc = acc + i + n
        }
        // (0+10)+(1+20)+(2+30) = 63
        acc == 63
    }

    then "empty list yields zero iterations" {
        let empty: List<int> = []
        mut count = 0
        for (i, e) in empty.enumerate() {
            count = count + 1
        }
        count == 0
    }

    then "single element" {
        mut seen_index = -1
        mut seen_value = ""
        for (i, v) in ["only"].enumerate() {
            seen_index = i
            seen_value = v
        }
        seen_index == 0 && seen_value == "only"
    }

    then "break inside enumerate loop" {
        avra_test_capture_start()
        for (i, x) in [100, 200, 300, 400].enumerate() {
            if i == 2 { break }
            println("${i}=${x}")
        }
        let out = avra_test_capture_stop()
        out == "0=100\n1=200"
    }

    then "continue inside enumerate loop" {
        mut sum = 0
        for (i, x) in [1, 2, 3, 4].enumerate() {
            if i == 1 { continue }
            sum = sum + x
        }
        // skip index 1 (value 2): 1+3+4 = 8
        sum == 8
    }

    then "nested enumerate loops" {
        avra_test_capture_start()
        for (i, a) in ["x", "y"].enumerate() {
            for (j, b) in [1, 2].enumerate() {
                println("${i}${a}${j}${b}")
            }
        }
        let out = avra_test_capture_stop()
        out == "0x01\n0x12\n1y01\n1y12"
    }

    then "index is usable as an int in arithmetic" {
        let xs = [5, 5, 5]
        mut total = 0
        for (i, x) in xs.enumerate() {
            total = total + (i * x)
        }
        // 0*5 + 1*5 + 2*5 = 15
        total == 15
    }
}

spec "for-zip" {
    then "parallel iteration pairs elements" {
        avra_test_capture_start()
        let names = ["x", "y", "z"]
        let vals = [1, 2, 3]
        for (n, v) in names.zip(vals) {
            println("${n}=${v}")
        }
        let out = avra_test_capture_stop()
        out == "x=1\ny=2\nz=3"
    }

    then "zip truncates to the shorter list" {
        let a = [1, 2, 3, 4, 5]
        let b = [10, 20]
        mut count = 0
        mut sum = 0
        for (x, y) in a.zip(b) {
            count = count + 1
            sum = sum + x + y
        }
        // only 2 iterations: (1+10)+(2+20) = 33
        count == 2 && sum == 33
    }

    then "zip with empty list yields nothing" {
        let a = [1, 2, 3]
        let b: List<int> = []
        mut count = 0
        for (x, y) in a.zip(b) {
            count = count + 1
        }
        count == 0
    }
}
