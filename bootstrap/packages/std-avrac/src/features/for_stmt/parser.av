// WHY: parses `for variable in start..end { body }` (range)
// and `for variable in collection { body }` (for-in iteration).
// Also parses the tuple-destructure binding `for (a, b) in coll { body }`
// (ryvy), desugared here into a single-variable for-in whose body opens
// with `let (a, b) = <tmp>` — reusing the existing ForIn + LetDestructure
// machinery rather than introducing a parallel AST node.

use core.{Stmt, Expr, StmtId, SrcPos}
use parse.{Parser}
use diagnostics.{DiagCode}
use core.{Tk}

// Process-wide monotonic counter for synthetic names — guarantees the
// for-(a,b) loop temp can never collide with a user binding or another
// generated temp.
extern fn avra_gensym() -> int

impl Parser {
    fn parse_for_statement(self) -> Result<StmtId, string> {
        self.advance()

        // Tuple-destructure binding: `for (a, b) in coll { body }`.
        if self.check(Tk.LeftParen) {
            return self.parse_for_destructure()
        }

        let name = self.consume_identifier("expected variable name after `for`")?

        if !self.consume(Tk.KwIn, "expected `in` after loop variable") {
            return .Err("parse error")
        }

        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let expr_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let expr_id = expr_opt?

        // Range form: `for x in start..end { body }`
        if self.check(Tk.DotDot) {
            self.advance()
            let saved2 = self.allow_struct_lit
            self.allow_struct_lit = false
            let end_opt = self.parse_expression()
            self.allow_struct_lit = saved2
            let end_id = end_opt?

            if !self.check(Tk.LeftBrace) {
                self.report(DiagCode.ExpectedBlock, "expected `{` after for range")
                return .Err("parse error")
            }
            let body_id = self.parse_statement()?
            return .Ok(self.alloc_stmt_leaf(Stmt.For(name, expr_id, end_id, body_id)))
        }

        // Collection form: `for x in list { body }`
        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` or `..` after for expression")
            return .Err("parse error")
        }
        let body_id = self.parse_statement()?
        .Ok(self.alloc_stmt_leaf(Stmt.ForIn(name, expr_id, body_id)))
    }

    /// Parse `for (a, b, …) in collection { body }`. The opening `(`
    /// has already been seen by the caller. There is no range form
    /// for tuple bindings (`for (a, b) in 0..n` is meaningless), so
    /// only the collection form is accepted.
    ///
    /// Desugar:
    ///     for (a, b) in coll { BODY }
    /// becomes
    ///     for __forpair_<n> in coll {
    ///         let (a, b) = __forpair_<n>
    ///         BODY
    ///     }
    /// where <n> is a fresh gensym id (collision-proof).
    /// The synthetic loop variable holds each tuple element; the
    /// leading `let`-destructure unpacks it into the user's names.
    /// This reuses the for-in iterator codegen and the tuple
    /// destructuring path verbatim — no new AST node, codegen, or
    /// type-check rule is required.
    fn parse_for_destructure(self) -> Result<StmtId, string> {
        let tline = self.current_line
        let tcol = self.current_column
        let gid = avra_gensym()
        self.advance() // consume `(`

        let names = self.parse_destructure_names()?
        if !self.consume(Tk.RightParen, "expected `)` after for destructure names") { return .Err("parse error") }
        if !self.consume(Tk.KwIn, "expected `in` after for destructure pattern") { return .Err("parse error") }

        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let expr_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let coll_id = expr_opt?

        if !self.check(Tk.LeftBrace) {
            self.report(DiagCode.ExpectedBlock, "expected `{` after for-in expression")
            return .Err("parse error")
        }
        let body_id = self.parse_statement()?

        let tmp = "__forpair_${gid}"
        // Synthetic rows: the unpack's initializer leaf, the unpack row,
        // then the two-element Block (the parsed body nests whole as one
        // element, exactly as the boxed desugar wrapped it — no splice).
        let tmp_ident_id = self.alloc_leaf(Expr.Ident(tmp))
        let unpack_id = self.alloc_stmt_leaf(Stmt.LetDestructure(names, tmp_ident_id))
        self.store.stmts.record_pos(unpack_id, SrcPos { line: tline, col: tcol, file: self.file })
        let block_body: List<StmtId> = [unpack_id, body_id]
        let block_id = self.alloc_stmt_leaf(Stmt.Block(block_body))
        .Ok(self.alloc_stmt_leaf(Stmt.ForIn(tmp, coll_id, block_id)))
    }
}
