// WHY: parses `for variable in start..end { body }` (range)
// and `for variable in collection { body }` (for-in iteration).
// Also parses the tuple-destructure binding `for (a, b) in coll { body }`
// (ryvy), desugared here into a single-variable for-in whose body opens
// with `let (a, b) = <tmp>` — reusing the existing ForIn + LetDestructure
// machinery rather than introducing a parallel AST node.

use core.{Stmt, Expr, StmtId, SrcPos}
use parse.{Parser}
use diagnostics.{DiagCode}
use core.{Tk}

// Process-wide monotonic counter for synthetic names — guarantees the
// for-(a,b) loop temp can never collide with a user binding or another
// generated temp.
extern fn avra_gensym() -> int

impl Parser {
}
