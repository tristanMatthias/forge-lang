// The for_stmt feature's LOWERINGS — typed build fns + their ABI adapters +
// manifest rows, in a dedicated SUBMODULE so the generated parser imports
// them directly (t-kd4y.3 Batch A, the wrapper-free shape). This module
// imports ONLY features.grammar + core — both already in every generated
// parser's closure — so the F4012 import-closure invariant holds by
// construction; the feature's passes/hooks stay in ../mod.av.

use core.{Stmt, ExprId, StmtId}
use features.grammar.{PState, CapVal, BuilderBind, bind_row, capval_stmt_val, capval_to_expr, capval_to_expr_opt, capval_to_stmt, capval_tok_text}

export fn build_for(v: string, lo: ExprId, hi: ExprId?, body: StmtId) -> Stmt {
    if hi == null { Stmt.ForIn(v, lo, body) } else { Stmt.For(v, lo, hi!, body) }
}

export fn build_for_abi(st: PState, vals: List<CapVal>) -> CapVal {
    // Coercion ORDER mirrors the retired mk_for_loop exactly — var, lo,
    // BODY, then the optional hi (which mk_for_loop only touched inside its
    // presence match) — so any coercion-time effect sequences identically.
    let v = capval_tok_text(vals[0])
    let lo = capval_to_expr(st, vals[1])
    let body = capval_to_stmt(st, vals[3])
    capval_stmt_val(st, build_for(v, lo, capval_to_expr_opt(st, vals[2]), body))
}

export fn for_builds() -> List<BuilderBind> {
    // spanned — the stamp lands at the `for` keyword, mk_for_loop's
    // add_stmt_at anchor (both the For and ForIn shapes).
    [bind_row("features.for_stmt.lowering", "build_for", "stmt", 4, true, "build_for_abi", build_for_abi)]
}
