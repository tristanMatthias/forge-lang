// WHY: emits LLVM IR for `for variable in start..end { body }` with
// break/continue support via the scoped loop stack in Ctx.
// Arena-eligible loops (non-escaping allocations only) use per-scope
// bump arenas for O(1) allocation and O(1) bulk free (spec Axis 9.6).

use core.{Expr, Stmt, VarBinding, env_extend, ValueType, vtype_list_elem, vtype_is_str}
use codegen.{Ctx, LoopStackFrame, StmtResult, emit_value_ptr, emit_value_ty}
use codegen.{emit_stmt, ok_sr, err_sr}
use codegen.{is_arena_eligible}
use list_ops.{list_push_copy}

/// Codegen entry for `for i in start..end { body }`. Pattern-
/// matches the `For` AST node and forwards to `emit_for_inner`.
export fn emit_for(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .For(variable, start, end, body) -> emit_for_inner(ctx, env, variable, start, end, body)
        _ -> err_sr("expected For")
    }
}

/// Lower a range-form `for` into LLVM blocks: cond / body / incr /
/// exit. Pushes a LoopStack frame so `break` and `continue` resolve
/// to the right targets. When the body is arena-eligible (every
/// allocation non-escaping per spec Axis 9.6), wraps execution in
/// a per-iteration bump arena destroyed at exit.
fn emit_for_inner(ctx: Ctx, env: List<VarBinding>, variable: string, start: Expr, end: Expr, body: Stmt) -> Result<StmtResult, string> {
    ctx.cov_line()
    let start_r = ctx.emit(env, start)?

    let end_r = ctx.emit(env, end)?

    let counter = ctx.alloca_i64(variable)
    ctx.store(emit_value_ptr(start_r), counter)

    let end_alloca = ctx.alloca_i64("for_end")
    ctx.store(emit_value_ptr(end_r), end_alloca)

    let body_env = env_extend(env, variable, counter, .Int)

    // Arena detection (spec Axis 9.6): if all allocations in the loop
    // body are non-escaping, wrap the loop in a per-scope arena.
    let use_arena = is_arena_eligible(body)
    let arena_val = if use_arena {
        ctx.call("avra_arena_new", [])
    } else {
        let n: ptr = null
        n
    }

    // Basic blocks: condition, body, increment, exit
    let cond_bb = ctx.bb("for.cond")
    let body_bb = ctx.bb("for.body")
    let incr_bb = ctx.bb("for.incr")
    let exit_bb = ctx.bb("for.exit")
    ctx.br(cond_bb)

    // Condition: counter < end
    ctx.position(cond_bb)
    let cur = ctx.load_i64(counter, variable)
    let lim = ctx.load_i64(end_alloca, "for_end_val")
    // icmp predicate 40 = SLT (signed less than)
    let cond_i1 = ctx.slt(cur, lim, "for_cmp")
    ctx.cond_br(cond_i1, body_bb, exit_bb)

    // Body — continue jumps to incr_bb, break jumps to exit_bb.
    // list_push_copy snapshots ctx.loops then appends — see
    // while_stmt for rationale.
    ctx.position(body_bb)
    let body_ctx_base = ctx.with_loops(list_push_copy(ctx.loops, LoopStackFrame { cond_bb: incr_bb, exit_bb }))
    // If arena is active, pass it to the body context so arena_alloc is used
    let body_ctx = if use_arena {
        body_ctx_base with { arena_ptr: arena_val }
    } else {
        body_ctx_base
    }
    let body_sr = emit_stmt(body_ctx, body_env, body)?
    ctx.br_if_open(incr_bb)

    // Increment: counter = counter + 1
    ctx.position(incr_bb)
    let old = ctx.load_i64(counter, variable)
    let one = ctx.i64(1)
    let next = ctx.add(old, one, "for_next")
    ctx.store(next, counter)
    ctx.br(cond_bb)

    // Exit — destroy arena if used
    ctx.position(exit_bb)
    if use_arena {
        ctx.call("avra_arena_destroy", [arena_val])
    }
    ok_sr(ctx, env)
}

/// Codegen entry for `for x in coll { body }`. Lowers to the
/// index-based form:
/// ```
/// let __len = avra_array_len(coll)
/// for __i in 0..__len {
///     let x = avra_array_get(coll, __i)
///     body
/// }
/// ```
/// Strings are special-cased to use `strlen` + `avra_str_char_at`
/// so character iteration produces fresh single-char strings.
export fn emit_for_in(ctx: Ctx, env: List<VarBinding>, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .ForIn(variable, collection, body) -> emit_for_in_inner(ctx, env, variable, collection, body)
        _ -> err_sr("expected ForIn")
    }
}

/// Inner emitter for the iterator form. Loads the collection,
/// computes its length, then runs the same cond/body/incr/exit
/// shape as `emit_for_inner` with the loop variable rebound to
/// `array_get(coll, i)` each iteration.
fn emit_for_in_inner(ctx: Ctx, env: List<VarBinding>, variable: string, collection: Expr, body: Stmt) -> Result<StmtResult, string> {
    ctx.cov_line()
    let coll_r = ctx.emit(env, collection)?
    let coll_ty = emit_value_ty(coll_r)
    let is_string = vtype_is_str(coll_ty)

    // Get length — strings use strlen, lists use array_len
    let len_val = if is_string {
        ctx.call("strlen", [emit_value_ptr(coll_r)])
    } else {
        ctx.array_len(emit_value_ptr(coll_r))
    }
    let len_alloca = ctx.alloca_i64("forin_len")
    ctx.store(len_val, len_alloca)

    // Counter alloca
    let counter = ctx.alloca_i64("forin_i")
    ctx.store(ctx.i64(0), counter)

    // Element alloca — strings yield Str elements, lists yield elem type
    let elem_alloca = ctx.alloca_i64(variable)
    let elem_ty = if is_string { ValueType.Str } else { vtype_list_elem(coll_ty) }
    let body_env = env_extend(env, variable, elem_alloca, elem_ty)

    // Arena detection (spec Axis 9.6)
    let use_arena = is_arena_eligible(body)
    let arena_val = if use_arena {
        ctx.call("avra_arena_new", [])
    } else {
        let n: ptr = null
        n
    }

    // Basic blocks
    let cond_bb = ctx.bb("forin.cond")
    let body_bb = ctx.bb("forin.body")
    let incr_bb = ctx.bb("forin.incr")
    let exit_bb = ctx.bb("forin.exit")
    ctx.br(cond_bb)

    // Condition: counter < len
    ctx.position(cond_bb)
    let cur = ctx.load_i64(counter, "forin_i_val")
    let lim = ctx.load_i64(len_alloca, "forin_len_val")
    let cond_i1 = ctx.slt(cur, lim, "forin_cmp")
    ctx.cond_br(cond_i1, body_bb, exit_bb)

    // Body: load element, then execute body
    ctx.position(body_bb)
    let elem = if is_string {
        ctx.call("avra_str_char_at", [emit_value_ptr(coll_r), cur])
    } else {
        ctx.array_get(emit_value_ptr(coll_r), cur)
    }
    ctx.store(elem, elem_alloca)

    let body_ctx_base = ctx.with_loops(list_push_copy(ctx.loops, LoopStackFrame { cond_bb: incr_bb, exit_bb }))
    let body_ctx = if use_arena {
        body_ctx_base with { arena_ptr: arena_val }
    } else {
        body_ctx_base
    }
    let body_sr = emit_stmt(body_ctx, body_env, body)?
    ctx.br_if_open(incr_bb)

    // Increment
    ctx.position(incr_bb)
    let old = ctx.load_i64(counter, "forin_i_old")
    let next = ctx.add(old, ctx.i64(1), "forin_next")
    ctx.store(next, counter)
    ctx.br(cond_bb)

    // Exit — destroy arena if used
    ctx.position(exit_bb)
    if use_arena {
        ctx.call("avra_arena_destroy", [arena_val])
    }
    ok_sr(ctx, env)
}
