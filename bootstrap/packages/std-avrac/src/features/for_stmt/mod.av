// for — range and collection loops (spec Axis 28). The definitions carry
// the feature whole: syntax, docs, editor surface, hooks, and the grammar
// rules the statement views compose (gram_family = "stmt", t-47hc.8). ONE
// rule serves TWO statements — a present `..` builds the integer-range
// `Stmt.For`, an absent one the collection `Stmt.ForIn` — so the flip
// splits across two LanguageFeatures (one per AST tag, like
// defer/errdefer): for_lang carries the gram + the build_for lowering (a
// `spanned` manifest row), for_in_lang carries the ForIn hooks alone. The
// tuple-destructure branch (`for (a, b) in …`) keeps its CENTRAL builds
// (MkForDestructure / MkForBinding): its gensym-threaded desugar is
// mid-build arena choreography the typed marshalling rows don't express
// yet — flip what the rows cover, keep the rest central until they grow.
// dir-as-module (g2eo.1): parser.av + codegen.av auto-load as siblings,
// surface flat at `features.for_stmt.{...}`. Sibling exports (emit_for,
// emit_for_in) are in scope without explicit self-imports.
use core.{vtype_list_elem}
use resolve.{declare_name, define_name, enter_resolve_scope, exit_resolve_scope, resolve_expr, resolve_stmt}
use typeck.{check_expr, check_stmt, tc_bind, tc_enter, tc_exit}
use features.eval.{Runtime, StepResult, execute_for_range, execute_for_in, error_result}
use features.grammar.{parse_grammar, for_builds}

/// Resolver hook for `for i in start..end { body }`. Resolves
/// both bounds in the outer scope, opens a new scope for the
/// loop variable, then resolves the body.
fn for_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .For(variable, start, end, body) -> {
            let after_start = resolve_expr(r, r.nodes.exprs.get(start))
            let after_end = resolve_expr(after_start, r.nodes.exprs.get(end))
            let entered = enter_resolve_scope(after_end)
            let declared = declare_name(entered, variable)
            let defined = define_name(declared, variable)
            let after_body = resolve_stmt(defined, r.nodes.stmts.get(body))
            exit_resolve_scope(after_body)
        }
        _ -> r
    }
}

/// Resolver hook for `for x in collection { body }`. Resolves
/// the collection in the outer scope, opens a fresh scope for
/// the element binding, then resolves the body.
fn for_in_resolve(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt {
        .ForIn(variable, collection, body) -> {
            let after_coll = resolve_expr(r, r.nodes.exprs.get(collection))
            let entered = enter_resolve_scope(after_coll)
            let declared = declare_name(entered, variable)
            let defined = define_name(declared, variable)
            let after_body = resolve_stmt(defined, r.nodes.stmts.get(body))
            exit_resolve_scope(after_body)
        }
        _ -> r
    }
}

/// Type-check hook for the range form. Both bounds must be Int;
/// the loop variable enters scope as Int.
fn for_check(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .For(variable, start, end, body) -> {
            let s = check_expr(tc, tc.nodes.exprs.get(start))
            let e = check_expr(s.tc, tc.nodes.exprs.get(end))
            let inner = tc_enter(e.tc)
            let bound = tc_bind(inner, variable, .Int)
            let after = check_stmt(bound, tc.nodes.stmts.get(body))
            tc_exit(after)
        }
        _ -> tc
    }
}

/// Type-check hook for the iterator form. Pulls the element type
/// from the collection's `List(elem)` type and binds it to the
/// loop variable in a fresh scope.
fn for_in_check(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .ForIn(variable, collection, body) -> {
            let c = check_expr(tc, tc.nodes.exprs.get(collection))
            let elem_ty = vtype_list_elem(c.ty)
            let inner = tc_enter(c.tc)
            let bound = tc_bind(inner, variable, elem_ty)
            let after = check_stmt(bound, tc.nodes.stmts.get(body))
            tc_exit(after)
        }
        _ -> tc
    }
}

/// Tree-walk eval hook for the range form. Delegates the iteration
/// itself to `execute_for_range` so the loop mechanics + scope
/// discipline live alongside `execute_while` rather than spreading
/// across feature modules. Without this hook eval would fall back to
/// `noop_eval_stmt`, breaking any `@comptime` macro that iterates
/// with `for i in 0..n`.
fn for_eval(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .For(variable, start, end, body) -> execute_for_range(rt, variable, rt.nodes.exprs.get(start), rt.nodes.exprs.get(end), rt.nodes.stmts.get(body))
        _ -> error_result(rt, "expected For")
    }
}

/// Tree-walk eval hook for `for x in collection { body }`.
/// Companion to `for_eval` for the iterator form. Required for
/// `@comptime` macros that iterate over lists — derive_walker
/// uses this to walk variant lists, field lists, etc.
fn for_in_eval(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .ForIn(variable, collection, body) -> execute_for_in(rt, variable, rt.nodes.exprs.get(collection), rt.nodes.stmts.get(body))
        _ -> error_result(rt, "expected ForIn")
    }
}

export fn for_lang() -> LanguageFeature {
    LanguageFeature for_def {
        name = "for",
        title = "for — range and collection loops",
        docs = """
`for i in start..end { body }` iterates the half-open integer range
`[start, end)`; `for x in collection { body }` iterates a collection's
elements. One syntax, two statements — the `..` picks the range form.
The loop variable is scoped to the body. A tuple pattern destructures
pairs: `for (k, v) in entries { … }` desugars to a fresh temp binding
plus a `let (k, v) = …` unpack at the top of the body.

Struct literals are disabled in the header expressions (`for x in coll
{ }` reads `coll` as the collection). Exit early with `break`, skip to
the next element with `continue`.
""",
        // t-47hc.21: `@require` (the abort) fixes the RUNAWAY — a malformed
        // `for Foo { }` header no longer parses `{ … }` as the collection
        // and swallows the next declaration. It is NOT spent on the
        // destructure branch: on `impl for Foo { }` the pinned recovery
        // resyncs and re-parses `Foo { }` as a struct-literal expr-stmt
        // (F0001 F0001 F0013, two nodes) where the abort yields one
        // (F0001). Spending the capability waits on matching that resync.
        // `for_binding` lives here because only the destructure branch
        // references it; its build (MkForBinding) and the destructure's
        // (MkForDestructure) stay engine-central — see the header note.
        gram = grammar {
  for_stmt = @peek(for_destructure) "for" fb:for_binding @require "in" @off(allow_struct_lit) coll:expression body:block @expect("in", "expected `in` after for destructure pattern") -> MkForDestructure(fb, coll, body)
           | "for" v:IDENT @require "in" @off(allow_struct_lit) lo:expression @off(allow_struct_lit) ( ".." hi:expression )? body:block @expect("in", "expected `in` after loop variable") -> build_for(v, lo, hi, body)
  for_binding = lp:"(" ( names:IDENT ( @peek(comma_ident) "," names:IDENT )* ","? )? ")" -> MkForBinding(lp, names)
        },
        builders = for_builds(),
        snippet = r"for ${1:x} in ${2:items} {\n    ${3:body}\n}",
        stmt_tag = Stmt.For("", ExprId(0), ExprId(0), StmtId(0)),
        emit_stmt = emit_for,
        resolve_stmt = for_resolve,
        check_stmt = for_check,
        eval_stmt = for_eval,
        gram_family = "stmt",
    }
    for_def
}

/// The collection-iteration twin — a distinct AST tag (`Stmt.ForIn`) so
/// codegen / typeck / eval dispatch pick the right hook; the SYNTAX lives
/// in for_lang's gram (one rule, two statements), so this definition
/// carries hooks alone.
export fn for_in_lang() -> LanguageFeature {
    LanguageFeature for_in_def {
        name = "for_in",
        title = "for‑in — collection iteration (the `for` rule's second statement)",
        stmt_tag = Stmt.ForIn("", ExprId(0), StmtId(0)),
        emit_stmt = emit_for_in,
        resolve_stmt = for_in_resolve,
        check_stmt = for_in_check,
        eval_stmt = for_in_eval,
    }
    for_in_def
}
