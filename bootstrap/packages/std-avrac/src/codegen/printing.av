// WHY: codegen for println/eprintln builtins.

use core.ast.{Expr, ExprList, VarEnv, ValueType, vtype_is_str, vtype_eq}
use codegen.{Ctx, EmitValue, ok_emit, err_emit}
use codegen.{emit_concat}
use codegen.{strip_quotes}

/// Codegen for `eprintln(value)`. Strings pass through; floats route
/// to `avra_float_to_string`; everything else gets snprintf'd as a
/// signed integer into a 32-byte buffer. Union-typed args are
/// rejected — caller must `match` first.
export fn emit_eprintln(ctx: Ctx, env: VarEnv, args: ExprList) -> Result<EmitValue, string> {
    match args {
        .End -> err_emit("eprintln() expects 1 arg")
        .Node(se, _) -> {
            let r = ctx.emit(env, se.node)?
            if r.ty is .Union {
                return err_emit("cannot print union type directly — use `match` to extract the value first")
            }
            let str_ptr = match {
                vtype_is_str(r.ty) -> ctx.to_ptr(r.value, "eprint_arg")
                vtype_eq(r.ty, .Float) -> {
                    ctx.call("avra_float_to_string", [r.value])
                }
                _ -> {
                    let buf = ctx.rc_alloc(ctx.i64(32))
                    let fmt = ctx.global_str("%lld", ".eprint_fmt")
                    ctx.call("snprintf", [buf, ctx.i64(32), fmt, r.value])
                    buf
                }
            }
            ctx.call("avra_eprintln", [str_ptr])
            ok_emit(ctx.i64(0), .Void)
        }
    }
}

/// Codegen for `println(value)`. Mirrors `emit_eprintln` but writes
/// to stdout via `puts`. Special-cases the `println("literal")`
/// shape: pulls the string text out in the inner match arm directly,
/// because re-binding `text` through any extra layer clobbers the
/// payload (see TECH_DEBT.md #11 — host miscompilation).
export fn emit_println(ctx: Ctx, env: VarEnv, args: ExprList) -> Result<EmitValue, string> {
    let print_ptr = match args {
        .Node(se, _) -> {
            match se.node {
                .String(text) -> {
                    let inner = strip_quotes(text)
                    ctx.global_str(inner, ".str")
                }
                _ -> {
                    let r = ctx.emit(env, se.node)?
                    if r.ty is .Union {
                        return err_emit("cannot print union type directly — use `match` to extract the value first")
                    }
                    if vtype_eq(r.ty, .Float) {
                        ctx.call("avra_float_to_string", [r.value])
                    } else {
                        ctx.to_ptr(r.value, "print_arg")
                    }
                }
            }
        }
        .End -> {
            return err_emit("println expects 1 argument")
        }
    }
    ctx.call("puts", [print_ptr])
    ok_emit(ctx.i64(0), .Void)
}

