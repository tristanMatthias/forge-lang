// WHY: codegen for indexing (obj[idx]) and slicing (obj[start..end]).

use core.{Expr, VarBinding, vtype_eq, vtype_is_list, vtype_is_str, vtype_list_elem, vtype_render_full, vtype_newtype_underlying}
use codegen.{Ctx, EmitValue, err_emit, ok_emit, ok_emit}

/// Codegen for `obj[idx]`. Dispatches by container type:
/// - `Ptr` → load byte at `ptr + idx`, zext to Int.
/// - `List` → `avra_array_get`, returns the list's element type.
/// - `Str` → allocate a 2-byte buffer (one char + NUL) and return
///   the single-character substring.
/// Anything else is a codegen error.
export fn emit_index(ctx: Ctx, env: List<VarBinding>, obj: Expr, idx: Expr) -> Result<EmitValue, string> {
    let r0 = ctx.emit_member(env, obj)?
    // A newtype is layout-transparent — its runtime value IS the underlying
    // container (`type Nums = List<int>` → a list ptr), so index dispatch runs
    // on the peeled underlying type. typeck (the `.Index` gate) peels in lockstep.
    // Resolve through the codegen registry first so a call-returned newtype
    // (arrives as a parser-default `.Struct`) is peeled too; a real struct
    // resolves to a non-Newtype, leaving r0 unchanged (byte-identical).
    let r_resolved = ctx.resolve_codegen_vtype(r0.ty)
    let r = if r_resolved is .Newtype { r0 with { ty: vtype_newtype_underlying(r_resolved) } } else { r0 }
    // Ptr indexing: ptr[i] → load byte at (ptr + i), returns int (0-255)
    if vtype_eq(r.ty, .Ptr) {
        let i_r = ctx.emit(env, idx)?
        let off = ctx.add(ctx.to_i64(r.value, "ptr_base"), i_r.value, "ptr_off")
        let off_ptr = ctx.to_ptr(off, "ptr_idx")
        let byte = ctx.load_i8(off_ptr, "ptr_byte")
        return ok_emit(ctx.zext(byte, ctx.i64_type, "ptr_byte_ext"), .Int)
    }
    // List indexing: list[i] → avra_array_get(list, i)
    if vtype_is_list(r.ty) {
        let i_r = ctx.emit(env, idx)?
        let elem = ctx.array_get(r.value, i_r.value)
        return ok_emit(elem, vtype_list_elem(r.ty))
    }
    if !vtype_is_str(r.ty) {
        return err_emit("indexing on non-string/list value (ty=${vtype_render_full(r.ty)})")
    }
    let i_r = ctx.emit(env, idx)?
    // Route to `avra_str_char_at` which bounds-checks against strlen.
    // The inline pointer-arithmetic path was unchecked — `s[5]` on
    // `"hi"` happily loaded a heap byte from past the NUL terminator
    // and returned it as a "string". Fix routes through the helper so
    // OOB indices return "" instead of leaking memory contents.
    let result = ctx.call("avra_str_char_at", [r.value, i_r.value])
    ok_emit(result, .Str)
}

/// Codegen for `obj[start..end]`. Forwards to `avra_str_substring`
/// for Strings or `avra_array_slice` for Lists. Result keeps the
/// input ValueType (a substring is still a Str, a sublist of `[T]`
/// is still `[T]`).
export fn emit_slice(ctx: Ctx, env: List<VarBinding>, obj: Expr, start: Expr, end: Expr) -> Result<EmitValue, string> {
    let obj_r = ctx.emit(env, obj)?
    let start_r = ctx.emit(env, start)?
    let end_r = ctx.emit(env, end)?
    // Peel newtypes for the str-vs-list dispatch (layout-transparent); the
    // result keeps obj_r.ty so a slice of a newtype stays that nominal type,
    // matching typeck's `.Slice` (which returns o.ty). Resolve first so a
    // call-returned newtype (a parser-default `.Struct`) peels too.
    let base_ty = vtype_newtype_underlying(ctx.resolve_codegen_vtype(obj_r.ty))
    if vtype_is_str(base_ty) {
        let result = ctx.call("avra_str_substring", [obj_r.value, start_r.value, end_r.value])
        // Keep obj_r.ty (not bare `.Str`) so a slice of a string-NEWTYPE stays
        // that nominal type, matching typeck's `.Slice` (returns o.ty) and the
        // list branch below. A plain string's obj_r.ty IS `.Str`, so this is
        // unchanged for non-newtypes; without it, `nt[0..1].raw()` typechecks as
        // the newtype but codegen sees `.Str` and cannot dispatch `.raw()`.
        return ok_emit(result, obj_r.ty)
    }
    let result = ctx.call("avra_array_slice", [obj_r.value, start_r.value, end_r.value])
    ok_emit(result, obj_r.ty)
}

