// WHY: block expression codegen — evaluating statement blocks as values.

use core.{Expr, Stmt, StmtId, ValueType, VarBinding, stmt_unwrap, stmt_diverges}
use codegen.{BlockResult, Ctx, EmitValue, StmtResult,  err_emit, ok_emit, ok_stmt, emit_value_ptr, emit_value_ty}
use codegen.{emit_if_optional_canon, emit_cond_truthy}
use core.{ValueType}
use codegen.{emit_expr, emit_stmt}
use features.match_expr.{emit_match_expr}
use features.if_stmt.{narrow_env_for_is}
use features.defer_stmt.{defer_scope_enter, defer_scope_exit}
use core.{avra_covmap_next_branch_id}
use features.error_propagation.{Result}
use core.{avra_tag_as_result}


/// Wrap a successful block-as-expr emit (value + type + threaded
/// ctx + env) as `Result.Ok`. Exported so block-shaped emitters
/// outside this module (fn_decl's tail-lambda threading) construct
/// BlockResults through the same single path — a hand-rolled
/// intermediate BlockResult that gets dropped releases its `ty`,
/// and a registry-owned ValueType stored there dangles the type
/// registries (phantom-release class, RC_MEMORY_RUNBOOK).
export fn ok_br(value: ptr, ty: ValueType, ctx: Ctx, env: List<VarBinding>) -> Result<BlockResult, string> {
    let r = Result.Ok(BlockResult { value, ty, ctx, env })
    avra_tag_as_result(r)
    r
}

/// Wrap a block-emit failure as `Result.Err`. Pairs with `ok_br`.
fn err_br(msg: string) -> Result<BlockResult, string> {
    let r = Result.Err(msg)
    avra_tag_as_result(r)
    r
}

/// Codegen for `{ stmt; stmt; expr }` used as an expression. The
/// block's value is the value of the LAST statement when that stmt
/// is a `.Expr`; everything else (return, let, while, ...) yields
/// i64 0. Non-tail statements run for their side effects.
export fn emit_block_expr(ctx: Ctx, env: List<VarBinding>, stmts: List<StmtId>) -> Result<EmitValue, string> {
    // A block EXPRESSION is a defer scope too (t-vmkc) — this is the
    // path a `match` arm body, an `if`-in-value-position branch, and a
    // `let v = { … }` all take. The statement-position blocks are
    // scoped by `emit_stmt`'s `.Block` arm instead.
    let base = defer_scope_enter(ctx)
    let br = emit_block_loop_scoped(ctx, env, stmts, ctx.i64(0), .Unknown)?
    defer_scope_exit(br.ctx, env, base)
    ok_emit(br.value, br.ty)
}

/// Emit a statement as a value-producing expression. For `.Expr`,
/// `.Block`, `.Match`, `.If` we emit them inline with a result slot.
/// Anything else falls back to plain `emit_stmt` and inherits the
/// caller's `last_val` / `last_ty`.
export fn emit_stmt_as_value(ctx: Ctx, env: List<VarBinding>, stmt: Stmt, last_val: ptr, last_ty: ValueType) -> Result<EmitValue, string> {
    let br = emit_stmt_as_value_scoped(ctx, env, stmt, last_val, last_ty)?
    ok_emit(br.value, br.ty)
}

/// `emit_stmt_as_value` without the statement's `Ctx` thrown away, so
/// `emit_block_loop_scoped` can hand a complete ctx to the block's
/// defer-scope exit (t-vmkc). Only the `_` arm can carry a change —
/// the value-producing arms return the caller's ctx unchanged.
///
/// HONEST SCOPE: no currently-compilable program depends on this. The
/// shape that would — a block expression whose TAIL statement is a
/// `defer` — has no value type and is rejected by the layout-boundary
/// ICE before the defer matters (t-oy2p; `let v = { …; while false {} }`
/// fails the same way, so it is not a `defer` problem). It is threaded
/// anyway because a shared helper silently dropping ctx is the exact
/// bug t-vmkc was, and leaving one instance of it behind invites the
/// next one. Do not read the absence of a spec for it as an oversight:
/// `defer_scope_test.av` records why it would be a spec that cannot
/// fail.
///
/// Distinct from `emit_stmt_as_value_ctx`, which additionally emits a
/// `cov_line()` the plain path does not. Keep them separate: routing
/// this through that one would add a coverage counter to every block
/// expression and change emitted IR everywhere.
fn emit_stmt_as_value_scoped(ctx: Ctx, env: List<VarBinding>, stmt: Stmt, last_val: ptr, last_ty: ValueType) -> Result<BlockResult, string> {
    // Unwrap `Annotated` for dispatch so a documented (`///`) / `@…`-annotated
    // tail expression/if still yields its VALUE — a raw match would fall through
    // to `_` and lose it (returning the block's default `i64 0`/`.Unknown`, which
    // then ICEs at the layout boundary). Twin of `check_block_stmts`' tail unwrap;
    // a no-op for the common unannotated tail, so IR stays byte-identical there.
    match stmt_unwrap(ctx.nodes, stmt) {
        .Expr(e) -> {
            let r = ctx.emit(env, ctx.nodes.exprs.get(e))?
            ok_br(r.value, r.ty, ctx, env)
        }
        .Block(body) -> {
            let r = emit_block_expr(ctx, env, body)?
            ok_br(r.value, r.ty, ctx, env)
        }
        .Match(subject, arms) -> {
            let r = emit_match_expr(ctx, env, ctx.nodes.exprs.get(subject), arms)?
            ok_br(r.value, r.ty, ctx, env)
        }
        .If(condition, then_branch, else_branch) -> {
            let else_s: Stmt? = if else_branch != null { ctx.nodes.stmts.get(else_branch!) } else { null }
            let r = emit_stmt_if_as_value(ctx, env, ctx.nodes.exprs.get(condition), ctx.nodes.stmts.get(then_branch), else_s)?
            ok_br(r.value, r.ty, ctx, env)
        }
        _ -> {
            let sr = emit_stmt(ctx, env, stmt)?
            ok_br(last_val, last_ty, sr.ctx, sr.env)
        }
    }
}

/// Same as `emit_stmt_as_value` but threads ctx + env through and
/// returns a BlockResult. Used by `emit_block_loop_ctx` so callers
/// can recover defer state after evaluating a block.
fn emit_stmt_as_value_ctx(ctx: Ctx, env: List<VarBinding>, stmt: Stmt, last_val: ptr, last_ty: ValueType) -> Result<BlockResult, string> {
    ctx.cov_line()
    // Unwrap `Annotated` for dispatch (see `emit_stmt_as_value`): a documented /
    // annotated tail must still yield its value, not fall through to `_`.
    match stmt_unwrap(ctx.nodes, stmt) {
        .Expr(e) -> {
            let r = ctx.emit(env, ctx.nodes.exprs.get(e))?
            ok_br(r.value, r.ty, ctx, env)
        }
        .Block(body) -> {
            let r = emit_block_loop_ctx(ctx, env, body, ctx.i64(0), .Unknown)?
            ok_br(r.value, r.ty, r.ctx, r.env)
        }
        .Match(subject, arms) -> {
            let r = emit_match_expr(ctx, env, ctx.nodes.exprs.get(subject), arms)?
            ok_br(r.value, r.ty, ctx, env)
        }
        .If(condition, then_branch, else_branch) -> {
            let else_s: Stmt? = if else_branch != null { ctx.nodes.stmts.get(else_branch!) } else { null }
            let r = emit_stmt_if_as_value(ctx, env, ctx.nodes.exprs.get(condition), ctx.nodes.stmts.get(then_branch), else_s)?
            ok_br(r.value, r.ty, ctx, env)
        }
        _ -> {
            let sr = emit_stmt(ctx, env, stmt)?
            ok_br(last_val, last_ty, sr.ctx, sr.env)
        }
    }
}

/// Codegen for an `if`-statement used in expression position. Emits
/// the condition, both branches into separate basic blocks, stores
/// each branch's tail value into a slot, and merges. `is`-narrowing
/// runs on the then-branch via `narrow_env_for_is`. Branch coverage
/// counters fire on each side.
export fn emit_stmt_if_as_value(ctx: Ctx, env: List<VarBinding>, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> Result<EmitValue, string> {
    let branch_id = avra_covmap_next_branch_id()
    let cond = ctx.emit(env, condition)?
    let cond_i1 = emit_cond_truthy(ctx, emit_value_ptr(cond), emit_value_ty(cond), "sif_cond")
    let then_bb = ctx.bb("sif_then")
    let else_bb = ctx.bb("sif_else")
    let merge_bb = ctx.bb("sif_end")
    let result_slot = ctx.alloca_i64("sif_result")
    ctx.store(ctx.i64(0), result_slot)
    ctx.cond_br(cond_i1, then_bb, else_bb)

    ctx.position(then_bb)
    ctx.cov_branch_then(branch_id)
    let zero = ctx.i64(0)
    let then_env = narrow_env_for_is(ctx, env, condition)
    let t = emit_stmt_as_value(ctx, then_env, then_branch, zero, .Unknown)?
    let t_ty = emit_value_ty(t)
    // Did the then-branch diverge? Use AST-based analysis (stmt_diverges), the
    // same check typeck uses — NOT `ctx.has_terminator()`, which inspects only
    // the current LLVM block and misses a COMPOSITE divergence (a nested all-
    // returning `if`/block leaves an empty merge block open). Twin of
    // emit_if_expr; keeping both AST-based means codegen and typeck can never
    // disagree on the result type (which would ICE downstream).
    let then_diverged = stmt_diverges(ctx.nodes, then_branch)
    ctx.store_br_if_open(emit_value_ptr(t), result_slot, merge_bb)

    ctx.position(else_bb)
    ctx.cov_branch_else(branch_id)
    mut e_ty = ValueType.Void
    mut else_diverged = false
    if else_branch != null {
        let e = emit_stmt_as_value(ctx, env, else_branch!, zero, .Unknown)?
        e_ty = emit_value_ty(e)
        else_diverged = stmt_diverges(ctx.nodes, else_branch!)
        ctx.store_br_if_open(emit_value_ptr(e), result_slot, merge_bb)
    } else {
        ctx.br(merge_bb)
    }

    ctx.position(merge_bb)
    // One branch diverges → only the OTHER flows to the merge, so the result
    // value AND type are that surviving branch's — never the diverging arm's
    // `.Void`/`.Unknown`. Twin of emit_if_expr: without this a `let v = { if c
    // { return } else { <ptr value> } }` (a statement-`if` in value position,
    // e.g. a block-expr tail) types `v` as the diverging then-arm's `.Unknown`
    // and ICEs at the first `v.field`/`v.method()` (§6 layout totality).
    if then_diverged && !else_diverged {
        let sv = ctx.load_i64(result_slot, "sif_val")
        return ok_emit(sv, e_ty)
    }
    if else_diverged && !then_diverged {
        let sv = ctx.load_i64(result_slot, "sif_val")
        return ok_emit(sv, t_ty)
    }
    // Canonicalise a value-inner optional mix ({T, null} etc.) to `T?` so a
    // present value is boxed and `none` stays the null pointer (e.g. an
    // `if x > 0 { x } else { none }` function body returning `int?`).
    let canon = emit_if_optional_canon(ctx, cond_i1, result_slot, t_ty, e_ty)
    if canon != none { return ok_emit(canon!.value, canon!.ty) }
    let loaded = ctx.load_i64(result_slot, "sif_val")
    ok_emit(loaded, t_ty)
}

/// Workhorse loop for `emit_block_expr`. Walks the statement list:
/// every non-tail stmt runs via `emit_stmt`; the tail stmt runs via
/// `emit_stmt_as_value` so the block produces a value. Tracks
/// `source_line` for accurate diagnostics and coverage.
export fn emit_block_loop(ctx: Ctx, env: List<VarBinding>, stmts: List<StmtId>, last_val: ptr, last_ty: ValueType) -> Result<EmitValue, string> {
    let br = emit_block_loop_scoped(ctx, env, stmts, last_val, last_ty)?
    ok_emit(br.value, br.ty)
}

/// `emit_block_loop` with the final `Ctx` returned instead of dropped,
/// so `emit_block_expr` can close the block's defer scope (t-vmkc).
/// Identical walk and identical emission — the plain `emit_block_loop`
/// above is now a thin unwrap of this, which is what keeps the two
/// from drifting.
export fn emit_block_loop_scoped(ctx: Ctx, env: List<VarBinding>, stmts: List<StmtId>, last_val: ptr, last_ty: ValueType) -> Result<BlockResult, string> {
    if stmts.length == 0 { return ok_br(last_val, last_ty, ctx, env) }
    mut cur_ctx = ctx
    mut cur_env = env
    mut i = 0
    let last = stmts.length - 1
    while i < last {
        // Dead code past a terminator: skip — see emit_stmt_ids (t-83ja).
        if cur_ctx.has_terminator() { return ok_br(last_val, last_ty, cur_ctx, cur_env) }
        let sid = stmts[i]
        let pos = cur_ctx.nodes.stmt_pos(sid)
        let line_ctx = cur_ctx with { source_line: pos.line, source_file: pos.file }
        let sr = emit_stmt(line_ctx, cur_env, cur_ctx.nodes.stmts.get(sid))?
        cur_ctx = sr.ctx
        cur_env = sr.env
        i = i + 1
    }
    if cur_ctx.has_terminator() { return ok_br(last_val, last_ty, cur_ctx, cur_env) }
    let sid = stmts[last]
    let pos = cur_ctx.nodes.stmt_pos(sid)
    let line_ctx = cur_ctx with { source_line: pos.line, source_file: pos.file }
    emit_stmt_as_value_scoped(line_ctx, cur_env, cur_ctx.nodes.stmts.get(sid), last_val, last_ty)
}

/// `emit_block_loop` but returns BlockResult so callers see the
/// final `Ctx` (with accumulated defers). Used by features whose
/// emission needs to react to ctx changes inside the block (defer
/// stack mutations, RC pushes, etc.).
export fn emit_block_loop_ctx(ctx: Ctx, env: List<VarBinding>, stmts: List<StmtId>, last_val: ptr, last_ty: ValueType) -> Result<BlockResult, string> {
    if stmts.length == 0 {
        let e: List<VarBinding> = []
        return ok_br(last_val, last_ty, ctx, e)
    }
    mut cur_ctx = ctx
    mut cur_env = env
    mut i = 0
    let last = stmts.length - 1
    while i < last {
        // Dead code past a terminator: skip — see emit_stmt_ids (t-83ja).
        if cur_ctx.has_terminator() { return ok_br(last_val, last_ty, cur_ctx, cur_env) }
        let sid = stmts[i]
        let pos = cur_ctx.nodes.stmt_pos(sid)
        let line_ctx = cur_ctx with { source_line: pos.line, source_file: pos.file }
        let sr = emit_stmt(line_ctx, cur_env, cur_ctx.nodes.stmts.get(sid))?
        cur_ctx = sr.ctx
        cur_env = sr.env
        i = i + 1
    }
    if cur_ctx.has_terminator() { return ok_br(last_val, last_ty, cur_ctx, cur_env) }
    let sid = stmts[last]
    let pos = cur_ctx.nodes.stmt_pos(sid)
    let line_ctx = cur_ctx with { source_line: pos.line, source_file: pos.file }
    emit_stmt_as_value_ctx(line_ctx, cur_env, cur_ctx.nodes.stmts.get(sid), last_val, last_ty)
}
