// WHY: shared codegen utilities used across features.

use core.{Expr, ExprList, StmtList, ParamList, VarEnv, ValueType, TypeList, SStmt, stmt_unwrap, vtype_fn_params, vtype_trait_name}
use codegen.{Ctx, EmitValue, err_emit, null_ptr_val, ok_emit, param_type_vt_at, trait_decl_has}
use core.{vtype_is_unknown}
use features.trait_decl.{box_for_trait, resolve_concrete_type_name}
use features.closures.{emit_lambda_typed}
use features.union_type.{emit_union_wrap, needs_union_wrap}

/// Emit a single-argument call helper. Returns the first argument's
/// EmitValue or an error when the list is empty. Used by built-in
/// methods like `print` that take exactly one expression.
export fn emit_single_arg(ctx: Ctx, env: VarEnv, args: ExprList) -> Result<EmitValue, string> {
    match args {
        .End -> err_emit("expected 1 argument, got 0")
        .Node(se, _) -> ctx.emit(env, se.node)
    }
}

/// Drop the leading and trailing quote characters from a string
/// literal's text. Returns the input unchanged when its length is
/// less than 2 (defensive: no quotes to strip).
export fn strip_quotes(s: string) -> string {
    let len = s.length
    if len < 2 {
        return s
    }
    s.substring(1, len - 1)
}

/// Fill an LLVM value array with the SSA results of a list of
/// expressions, in order. No type coercion — for that, see
/// `fill_arg_array_boxing`.
export fn fill_arg_array(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> Result<EmitValue, string> {
    match args {
        .End -> ok_emit(null_ptr_val(), .Void)
        .Node(se, next) -> {
            let r = ctx.emit(env, se.node)?
            ctx.value_array_set(arr, idx, r.value)
            fill_arg_array(ctx, env, arr, next, idx + 1)
        }
    }
}

/// Fill an arg array with type-aware coercion: lambdas are compiled
/// against the callee's declared param types so enum matching works
/// inside the closure; concrete values are boxed for `dyn Trait`
/// parameters; concrete values are wrapped for union-typed
/// parameters. The full call-site coercion pipeline.
export fn fill_arg_array_boxing(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, ptypes: List<ValueType>, idx: int) -> Result<EmitValue, string> {
    match args {
        .End -> ok_emit(null_ptr_val(), .Void)
        .Node(se, next) -> {
            // When a Lambda arg is passed to a function expecting a typed fn param,
            // compile the lambda with the expected param types so enum matching works.
            mut r = EmitValue { value: ctx.i64(0), ty: .Int }
            match se.node {
                .Lambda(params, body) -> {
                    let fn_vt = ctx.resolve_codegen_vtype(param_type_vt_at(ptypes, idx))
                    let lambda_types = vtype_fn_params(fn_vt)
                    r = emit_lambda_typed(ctx, env, params, body, lambda_types)?
                }
                _ -> {
                    r = ctx.emit(env, se.node)?
                }
            }
            // Check if the parameter type is a trait and the argument is concrete
            let param_vt_raw = param_type_vt_at(ptypes, idx)
            let param_vt_resolved = ctx.resolve_codegen_vtype(param_vt_raw)
            let trait_name = vtype_trait_name(param_vt_resolved)
            mut value = if trait_name != "" {
                let concrete_name = resolve_concrete_type_name(r.ty)
                if concrete_name != "" && !trait_decl_has(ctx.trait_decls, concrete_name) {
                    box_for_trait(ctx, r.value, trait_name, concrete_name)
                } else {
                    r.value
                }
            } else {
                r.value
            }
            // Union wrapping: concrete arg → union-typed param
            let param_vt = param_type_vt_at(ptypes, idx)
            if !vtype_is_unknown(param_vt) {
                let param_ty = ctx.resolve_codegen_vtype(param_vt)
                if needs_union_wrap(r.ty, param_ty) {
                    let wrapped = emit_union_wrap(ctx, value, r.ty, param_ty)?
                    value = wrapped.value
                }
            }
            ctx.value_array_set(arr, idx, value)
            fill_arg_array_boxing(ctx, env, arr, next, ptypes, idx + 1)
        }
    }
}


/// True when `e` is the `null` literal. Used by `emit_binary` to
/// suppress string equality lowering (`"x" == null` should compare
/// pointers, not call `strcmp`).
export fn is_null_literal(e: Expr) -> bool { e is .Null }

/// Walk to the last statement of a list and unwrap it as an Expr.
/// `.Expr(e)` and `.Return(e)` both surface their payload; anything
/// else becomes `.Null`. Used to extract the implicit return value
/// of a function body during type-aware emit.
export fn stmts_last_expr(stmts: StmtList) -> Expr {
    match stmts {
        .End -> .Null
        .Node(ss, next) -> {
            match next {
                .End -> {
                    let inner = stmt_unwrap(ss.node)
                    match inner {
                        .Expr(e) -> e
                        .Return(e) -> e
                        _ -> .Null
                    }
                }
                _ -> stmts_last_expr(next)
            }
        }
    }
}

