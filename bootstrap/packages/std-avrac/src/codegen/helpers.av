// WHY: shared codegen utilities used across features.

use core.{Expr, ExprId, VarBinding, ValueType, StmtId, NodeStore, stmt_unwrap, vtype_fn_params, vtype_trait_name}
use codegen.{Ctx, EmitValue, err_emit, null_ptr_val, ok_emit, param_type_vt_at, trait_decl_has}
use core.{vtype_is_unknown}
use features.trait_decl.{box_for_trait, resolve_concrete_type_name}
use features.closures.{emit_lambda_typed}
use features.union_type.{emit_union_wrap, needs_union_wrap}
use codegen.{needs_optional_box, needs_optional_unbox, emit_optional_some, emit_optional_unwrap, box_into_list, needs_tuple_rebox, emit_tuple_rebox}
use core.{vtype_strip_optional, vtype_is_list, vtype_is_optional, vtype_list_elem}

/// Emit a single-argument call helper. Returns the first argument's
/// EmitValue or an error when the list is empty. Used by built-in
/// methods like `print` that take exactly one expression.
export fn emit_single_arg(ctx: Ctx, env: List<VarBinding>, args: List<ExprId>) -> Result<EmitValue, string> {
    if args.length == 0 { return err_emit("expected 1 argument, got 0") }
    ctx.emit(env, ctx.nodes.exprs.get(args[0]))
}

/// Drop the leading and trailing quote characters from a string
/// literal's text. Returns the input unchanged when its length is
/// less than 2 (defensive: no quotes to strip).
export fn strip_quotes(s: string) -> string {
    let len = s.length
    if len < 2 {
        return s
    }
    s.substring(1, len - 1)
}

/// Fill an LLVM value array with the SSA results of a list of
/// expressions, in order. No type coercion — for that, see
/// `fill_arg_array_boxing`.
export fn fill_arg_array(ctx: Ctx, env: List<VarBinding>, arr: ptr, args: List<ExprId>, idx: int) -> Result<EmitValue, string> {
    mut i = 0
    let n = args.length
    while i < n {
        let r = ctx.emit(env, ctx.nodes.exprs.get(args[i]))?
        ctx.value_array_set(arr, idx + i, r.value)
        i = i + 1
    }
    ok_emit(null_ptr_val(), .Void)
}

/// Fill an arg array with type-aware coercion: lambdas are compiled
/// against the callee's declared param types so enum matching works
/// inside the closure; concrete values are boxed for `dyn Trait`
/// parameters; concrete values are wrapped for union-typed
/// parameters. The full call-site coercion pipeline.
export fn fill_arg_array_boxing(ctx: Ctx, env: List<VarBinding>, arr: ptr, args: List<ExprId>, ptypes: List<ValueType>, idx: int) -> Result<EmitValue, string> {
    let n = args.length
    mut i = 0
    while i < n {
        let se = args[i]
        let slot = idx + i
        // When a Lambda arg is passed to a function expecting a typed fn param,
        // compile the lambda with the expected param types so enum matching works.
        mut r = EmitValue { value: ctx.i64(0), ty: .Int }
        match ctx.nodes.exprs.get(se) {
            .Lambda(params, body) -> {
                let fn_vt = ctx.resolve_codegen_vtype(param_type_vt_at(ptypes, slot))
                let lambda_types = vtype_fn_params(fn_vt)
                r = emit_lambda_typed(ctx, env, params, ctx.nodes.exprs.get(body), lambda_types)?
            }
            // A list-literal arg for a `List<T?>` param must box each present
            // element into the optional repr, even with no `none` in the
            // literal (`f([1, 2])` where `f(xs: List<int?>)`). Emit the
            // elements here, then box via the shared `box_into_list` primitive
            // — `codegen` never imports the `list_lit` feature (that edge is a
            // module cycle: list_lit already imports codegen.helpers).
            .ListLit(elements) -> {
                let pvt = ctx.resolve_codegen_vtype(param_type_vt_at(ptypes, slot))
                if vtype_is_list(pvt) && vtype_is_optional(vtype_list_elem(pvt)) {
                    mut vals: List<EmitValue> = []
                    mut j = 0
                    while j < elements.length {
                        vals.push(ctx.emit(env, ctx.nodes.exprs.get(elements[j]))?)
                        j = j + 1
                    }
                    r = box_into_list(ctx, vals, vtype_list_elem(pvt))?
                } else {
                    r = ctx.emit(env, ctx.nodes.exprs.get(se))?
                }
            }
            _ -> {
                r = ctx.emit(env, ctx.nodes.exprs.get(se))?
            }
        }
        // Check if the parameter type is a trait and the argument is concrete
        let param_vt_raw = param_type_vt_at(ptypes, slot)
        let param_vt_resolved = ctx.resolve_codegen_vtype(param_vt_raw)
        let trait_name = vtype_trait_name(param_vt_resolved)
        mut value = if trait_name != "" {
            let concrete_name = resolve_concrete_type_name(r.ty)
            if concrete_name != "" && !trait_decl_has(ctx.trait_decls, concrete_name) {
                box_for_trait(ctx, r.value, trait_name, concrete_name)
            } else {
                r.value
            }
        } else {
            r.value
        }
        // Union wrapping: concrete arg → union-typed param
        let param_vt = param_type_vt_at(ptypes, slot)
        if !vtype_is_unknown(param_vt) {
            let param_ty = ctx.resolve_codegen_vtype(param_vt)
            // Optional box/unbox via plain-ptr primitives (no EmitValue
            // construction in this hot loop — see optional_repr.av). Box a
            // present value-inner arg into a `T?` param; unbox a `T?` arg
            // passed to a non-optional param.
            if needs_tuple_rebox(r.ty, param_ty) {
                // Tuple arg into a tuple-of-optionals param — box elements (ai3u).
                value = emit_tuple_rebox(ctx, value, r.ty, param_ty)
            } else if needs_optional_box(r.ty, param_ty) {
                value = emit_optional_some(ctx, vtype_strip_optional(param_ty), value)
            } else if needs_optional_unbox(r.ty, param_ty) {
                value = emit_optional_unwrap(ctx, vtype_strip_optional(r.ty), value)
            }
            if needs_union_wrap(r.ty, param_ty) {
                let wrapped = emit_union_wrap(ctx, value, r.ty, param_ty)?
                value = wrapped.value
            }
        }
        ctx.value_array_set(arr, slot, value)
        i = i + 1
    }
    ok_emit(null_ptr_val(), .Void)
}


/// True when `e` is the `null` literal. Used by `emit_binary` to
/// suppress string equality lowering (`"x" == null` should compare
/// pointers, not call `strcmp`).
export fn is_null_literal(e: Expr) -> bool { e is .None }

/// Walk to the last row of a flipped body and unwrap it as an Expr.
/// `.Expr(e)` and `.Return(e)` both surface their payload; anything
/// else becomes `.None`. Used to extract the implicit return value
/// of a function body during type-aware emit.
export fn stmts_last_expr(store: NodeStore, body: List<StmtId>) -> Expr {
    if body.length == 0 { return .None }
    let inner = stmt_unwrap(store, store.stmts.get(body[body.length - 1]))
    match inner {
        .Expr(e) -> store.exprs.get(e)
        .Return(e) -> store.exprs.get(e)
        _ -> .None
    }
}

/// Emit a `List<dyn Trait>` from a list literal, boxing each concrete element
/// into a trait object so a later trait-method call reads a real vtable instead
/// of a raw struct. Shared by every position that threads a declared trait
/// element type into a list literal: the `let xs: List<Trait> = [...]` binding
/// and the struct-field `Foo { xs: [...] }` init (966j). A non-concrete element
/// (already a trait object, or an unknown type) is pushed as-is.
export fn emit_trait_boxed_list(ctx: Ctx, env: List<VarBinding>, elements: List<ExprId>, trait_name: string) -> Result<ptr, string> {
    let arr = ctx.array_new()
    push_boxed_elements(ctx, env, arr, elements, trait_name)
}

/// Recursive worker for `emit_trait_boxed_list`: emit each element, box it for
/// the trait when its type is concrete, and push the result onto `arr`.
fn push_boxed_elements(ctx: Ctx, env: List<VarBinding>, arr: ptr, elements: List<ExprId>, trait_name: string) -> Result<ptr, string> {
    mut i = 0
    while i < elements.length {
        let r = ctx.emit(env, ctx.nodes.exprs.get(elements[i]))?
        let concrete_name = resolve_concrete_type_name(r.ty)
        let boxed = if concrete_name != "" {
            box_for_trait(ctx, r.value, trait_name, concrete_name)
        } else {
            r.value
        }
        ctx.array_push(arr, boxed)
        i = i + 1
    }
    .Ok(arr)
}

