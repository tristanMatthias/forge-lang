// WHY: escape analysis for RC — determines which locals' values
// escape their defining scope. A local is "releasable" if its ONLY
// uses are field reads (p.x, p.y). Any other use (return, pass as
// argument, store into struct, etc.) means the value might be
// referenced elsewhere and must NOT be released at scope exit.
//
// Conservative: if in doubt, mark as escaped (don't release).

use core.{Expr, ExprId, FieldEntry, FieldInit, MatchArm, WhenArm, Variant, ValueType, Stmt, StmtId, NodeStore, stmt_unwrap}
use codegen.{releasable_has, StructReg, EnumReg, struct_reg_lookup, enum_reg_lookup, copy_set_has}
use list_ops.{list_push_copy}

/// Add `name` to the releasable set, deduplicating. Returns a fresh
/// copy when name is new — callers reusing `set` elsewhere stay
/// correct.
fn releasable_add(set: List<string>, name: string) -> List<string> {
    if releasable_has(set, name) { set } else { list_push_copy(set, name) }
}

/// Remove every occurrence of `name` from the releasable set.
/// Returns a fresh list so callers reusing the old reference
/// elsewhere stay correct. Used when a use-site proves the local
/// escapes (return, arg pass, etc.).
fn releasable_remove(set: List<string>, name: string) -> List<string> {
    mut out: List<string> = []
    for n in set {
        if n != name { out = out.push(n) }
    }
    out
}

/// Analyze a function body and return the set of locals whose values
/// can safely be RC-released at scope exit. A local is releasable
/// only when:
/// 1. Its initializer is an allocation (struct lit, enum ctor,
///    tuple, with-expr) — see `is_allocating_expr`.
/// 2. Its only uses are field reads (not returned, passed as arg,
///    captured in a closure, etc.).
///
/// Single-pass insight: declarations appear before uses in statement
/// order, so the algorithm walks the list once — a `let` adds the
/// name; later uses only ever remove. Forward references therefore
/// work without a second pass.
export fn analyze_releasable(store: NodeStore, body: List<StmtId>) -> List<string> {
    let empty: List<string> = []
    single_pass_escape_ids(store, body, empty)
}

/// Lambda variant of `analyze_releasable`. Lambda bodies that aren't
/// blocks have no bindings to release; otherwise descend into the
/// inner `List<StmtId>`.
export fn analyze_releasable_expr(store: NodeStore, body: Expr) -> List<string> {
    match body {
        .Block(stmts) -> analyze_releasable(store, stmts)
        _ -> {
            let empty: List<string> = []
            empty
        }
    }
}

/// Single-pass escape analysis worker. Walks `ids` left-to-right,
/// folding `single_pass_stmt` over the running List<string>.
fn single_pass_escape_ids(store: NodeStore, ids: List<StmtId>, set: List<string>) -> List<string> {
    mut cur = set
    for id in ids { cur = single_pass_stmt(store, store.stmts.get(id), cur) }
    cur
}

/// Process a `let`/`mut`/`const` binding: add the name when its
/// initializer is allocating, then sweep the initializer for any
/// uses of names already in the set (which would mark them escaped).
fn analyze_binding(store: NodeStore, name: string, init: Expr, set: List<string>) -> List<string> {
    let s1 = if is_allocating_expr(init) { releasable_add(set, name) } else { set }
    remove_escaped_expr(store, init, s1)
}

/// Per-statement worker. Bindings call `analyze_binding`; control-
/// flow statements recurse into their bodies; everything else is
/// only checked for escaping uses inside its expressions. Decl-only
/// statements (TypeDecl, TraitDecl, …) are pass-through.
fn single_pass_stmt(store: NodeStore, stmt: Stmt, set: List<string>) -> List<string> {
    let inner = stmt_unwrap(store, stmt)
    match inner {
        .Let(name, _, init) -> analyze_binding(store, name, store.exprs.get(init), set)
        .Mut(name, _, init) -> analyze_binding(store, name, store.exprs.get(init), set)
        .Const(name, _, init) -> analyze_binding(store, name, store.exprs.get(init), set)
        // Recurse into blocks
        .Block(body) -> single_pass_escape_ids(store, body, set)
        .If(cond, then_b, else_b) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(cond), set)
            let s2 = single_pass_stmt(store, store.stmts.get(then_b), s1)
            if else_b != null { single_pass_stmt(store, store.stmts.get(else_b!), s2) } else { s2 }
        }
        // Everything else: just check for escapes (same as remove_escaped_stmt)
        .Return(expr) -> remove_escaped_expr(store, store.exprs.get(expr), set)
        .Expr(expr) -> remove_escaped_expr(store, store.exprs.get(expr), set)
        .While(cond, body) -> single_pass_stmt(store, store.stmts.get(body), remove_escaped_expr(store, store.exprs.get(cond), set))
        .For(_, start, end, body) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(start), set)
            let s2 = remove_escaped_expr(store, store.exprs.get(end), s1)
            single_pass_stmt(store, store.stmts.get(body), s2)
        }
        .ForIn(_, coll, body) -> single_pass_stmt(store, store.stmts.get(body), remove_escaped_expr(store, store.exprs.get(coll), set))
        // Same bug as the MatchExpr arm in remove_escaped_expr: walk
        // the arm guards + bodies so an h returned from a match arm
        // body gets removed from rc_releasable (otherwise scope-exit
        // releases h before the caller of the fn sees the value).
        .Match(subj, arms) -> remove_escaped_match_arms(store, arms, remove_escaped_expr(store, store.exprs.get(subj), set))
        .Defer(body) -> remove_escaped_expr(store, store.exprs.get(body), set)
        .Errdefer(body) -> remove_escaped_expr(store, store.exprs.get(body), set)
        .Annotated(_, inner_id) -> single_pass_stmt(store, store.stmts.get(inner_id), set)
        .LetDestructure(_, init) -> remove_escaped_expr(store, store.exprs.get(init), set)
        .Function(_, _, _, _, _) -> set
        .ReturnEmpty -> set
        .TypeDecl(_, _, _) -> set
        .NewtypeDecl(_, _) -> set
        .UnionAliasDecl(_, _) -> set
        .ShapeDecl(_, _) -> set
        .EnumDecl(_, _, _) -> set
        .ExternFn(_, _, _) -> set
        .TraitDecl(_, _) -> set
        .Impl(_, _) -> set
        .NoOp -> set
        .Break -> set
        .Continue -> set
        .SpecBlock(_, _) -> set
        .GivenBlock(_, _) -> set
        .ThenBlock(_, _) -> set
        .Select(_) -> set
        .Parallel(_) -> set
        .Module(_, _) -> set
        .Use(_, _) -> set
        .AssocType(_, _) -> set
        .ComponentDef(_, _, _, _, _, _) -> set
        .ComponentBlock(_, _, _, _) -> set
        .TokenBody(_) -> set
        .Error -> set
        .Missing -> set
    }
}


/// True when `expr` produces a freshly allocated heap object the
/// binding owns. Currently: struct literal, enum constructor, tuple,
/// with-expr. Add new allocating forms here when introduced.
fn is_allocating_expr(expr: Expr) -> bool {
    match expr {
        .StructLit(_, _) -> true
        .EnumCtor(_, _, _) -> true
        .Tuple(_) -> true
        .With(_, _) -> true
        _ -> false
    }
}

/// Walk an expression and remove names from the releasable set when
/// they're used in a way that escapes the local. The only safe
/// pattern is `.FieldAccess(Ident(name), _)` (reading a field). Any
/// other use of `Ident(name)` removes it.
fn remove_escaped_expr(store: NodeStore, expr: Expr, set: List<string>) -> List<string> {
    match expr {
        // Field access is safe — reading a field doesn't escape the struct
        .FieldAccess(obj, _) -> {
            let obj_expr = store.exprs.get(obj)
            match obj_expr {
                .Ident(_) -> set  // p.x is safe — don't remove p
                _ -> remove_escaped_expr(store, obj_expr, set)  // nested: (expr).field
            }
        }
        // These are escaping uses:
        .Ident(name) -> releasable_remove(set, name)
        // Recurse into sub-expressions
        .Call(callee, args) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(callee), set)
            remove_escaped_arg_ids(store, args, s1)
        }
        .GenericCall(callee, _, args) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(callee), set)
            remove_escaped_arg_ids(store, args, s1)
        }
        .Binary(left, _, right) -> remove_escaped_expr(store, store.exprs.get(right), remove_escaped_expr(store, store.exprs.get(left), set))
        .Unary(_, inner) -> remove_escaped_expr(store, store.exprs.get(inner), set)
        .Logical(left, _, right) -> remove_escaped_expr(store, store.exprs.get(right), remove_escaped_expr(store, store.exprs.get(left), set))
        .Grouping(inner) -> remove_escaped_expr(store, store.exprs.get(inner), set)
        // `xs[i]` is a READ of the container `xs` — the element is
        // container-owned and, when stored into a holder, is RETAINED there
        // (expr_is_shared_alias's `.Index` arm). So a bare-ident container base
        // must stay releasable (its own __release frees the element the holder
        // retained), exactly like `.FieldAccess(Ident(_), _)` keeps its base.
        // The index sub-expr is still swept — a name used only to index does
        // not escape, but `xs[consume()]` must sweep `consume`'s idents. t-c6y7.
        .Index(obj, idx) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(idx), set)
            let obj_expr = store.exprs.get(obj)
            match obj_expr {
                .Ident(_) -> s1
                _ -> remove_escaped_expr(store, obj_expr, s1)
            }
        }
        .Assign(_, val) -> remove_escaped_expr(store, store.exprs.get(val), set)
        .FieldAssign(obj, _, val) -> remove_escaped_expr(store, store.exprs.get(val), remove_escaped_expr(store, store.exprs.get(obj), set))
        .StructLit(_, inits) -> remove_escaped_field_inits(store, inits, set)
        .ListLit(elems) -> remove_escaped_arg_ids(store, elems, set)
        // `with` reads obj field-by-field and emits rc_retain on ptr
        // fields the new struct keeps (see with_expr/codegen.av).
        // So `let u = h with { ... }` is a READ of `h` — the new
        // struct's retains keep h's ptr fields alive independently,
        // and h is still owned by its binding. Treat `Ident(h)` here
        // like FieldAccess does, so the source stays releasable and
        // its own __release_<Struct> fires at scope exit.
        .With(obj, inits) -> {
            let obj_node = store.exprs.get(obj)
            let s1 = match obj_node { .Ident(_) -> set, _ -> remove_escaped_expr(store, obj_node, set) }
            remove_escaped_field_inits(store, inits, s1)
        }
        .Lambda(_, body) -> remove_escaped_expr(store, store.exprs.get(body), set)
        .Block(body) -> single_pass_escape_ids(store, body, set)
        .IfExpr(cond, t, e) -> remove_escaped_expr(store, store.exprs.get(e), remove_escaped_expr(store, store.exprs.get(t), remove_escaped_expr(store, store.exprs.get(cond), set)))
        // Match arms must be walked: a variable used in an arm body
        // (especially as the arm's return value, which escapes) needs
        // to be removed from the releasable set. Without this the
        // scope-exit release path frees a struct the match expression
        // returned — UAF on the returned value.
        .MatchExpr(subj, arms) -> remove_escaped_match_arms(store, arms, remove_escaped_expr(store, store.exprs.get(subj), set))
        .Tuple(elems) -> remove_escaped_arg_ids(store, elems, set)
        .TupleIndex(obj, _) -> remove_escaped_expr(store, store.exprs.get(obj), set)
        .MapLit(entries) -> remove_escaped_arg_ids(store, entries, set)
        .Slice(obj, start, end) -> remove_escaped_expr(store, store.exprs.get(end), remove_escaped_expr(store, store.exprs.get(start), remove_escaped_expr(store, store.exprs.get(obj), set)))
        .Try(inner) -> remove_escaped_expr(store, store.exprs.get(inner), set)
        .Catch(inner, _, body, _, _) -> remove_escaped_expr(store, store.exprs.get(body), remove_escaped_expr(store, store.exprs.get(inner), set))
        .NullCoalesce(left, right) -> remove_escaped_expr(store, store.exprs.get(right), remove_escaped_expr(store, store.exprs.get(left), set))
        .OptionalChain(obj, _) -> remove_escaped_expr(store, store.exprs.get(obj), set)
        .OptionalMethodCall(obj, _, args) -> remove_escaped_arg_ids(store, args, remove_escaped_expr(store, store.exprs.get(obj), set))
        .IsCheck(subj, _) -> remove_escaped_expr(store, store.exprs.get(subj), set)
        .InCheck(needle, items) -> remove_escaped_arg_ids(store, items, remove_escaped_expr(store, store.exprs.get(needle), set))
        .EnumCtor(_, _, args) -> remove_escaped_arg_ids(store, args, set)
        .Spawn(body) -> remove_escaped_expr(store, store.exprs.get(body), set)
        .ChannelNew(_, capacity) -> {
            if capacity == null { set } else { remove_escaped_expr(store, store.exprs.get(capacity!), set) }
        }
        .Isolated(body) -> remove_escaped_expr(store, store.exprs.get(body), set)
        .Quote(_, body) -> remove_escaped_expr(store, store.exprs.get(body), set)
        .Splice(target) -> remove_escaped_expr(store, store.exprs.get(target), set)
        // Same as MatchExpr: when arms' bodies/conditions can escape
        // variables (return value of the arm, or pass to a fn). The
        // old "no escapes at this level" comment was wrong.
        .When(arms) -> remove_escaped_when_arms(store, arms, set)
        .ListComp(body, _, coll, filter) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(body), set)
            let s2 = remove_escaped_expr(store, store.exprs.get(coll), s1)
            if filter != null { remove_escaped_expr(store, store.exprs.get(filter!), s2) } else { s2 }
        }
        // Leaf expressions — no idents to escape
        .Number(_) -> set
        .FloatLit(_) -> set
        .String(_) -> set
        .Bool(_) -> set
        .None -> set
        .QualifiedIdent(_) -> set
        // A type carrier holds no idents (lowered away before codegen).
        .TypeLit(_) -> set
        .Error -> set
        .Missing -> set
    }
}

/// Walk each match arm's guard + body checking for escapes.
fn remove_escaped_match_arms(store: NodeStore, arms: List<MatchArm>, set: List<string>) -> List<string> {
    mut acc = set
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard_id != null {
            acc = remove_escaped_expr(store, store.exprs.get(arm.guard_id!), acc)
        }
        acc = remove_escaped_expr(store, store.exprs.get(arm.body_id), acc)
        i = i + 1
    }
    acc
}

/// Walk each when-arm's cond + body checking for escapes.
fn remove_escaped_when_arms(store: NodeStore, arms: List<WhenArm>, set: List<string>) -> List<string> {
    mut acc = set
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.cond_id != null {
            acc = remove_escaped_expr(store, store.exprs.get(arm.cond_id!), acc)
        }
        acc = remove_escaped_expr(store, store.exprs.get(arm.body_id), acc)
        i = i + 1
    }
    acc
}

/// Apply `remove_escaped_expr` to every element of a flipped `List<ExprId>`
/// (call/collection args).
fn remove_escaped_arg_ids(store: NodeStore, args: List<ExprId>, set: List<string>) -> List<string> {
    mut acc = set
    mut i = 0
    while i < args.length {
        acc = remove_escaped_expr(store, store.exprs.get(args[i]), acc)
        i = i + 1
    }
    acc
}

/// Apply `remove_escaped_expr` to every value in a struct-literal
/// `List<FieldInit>`. Used on `Foo { x: a, y: b }` and `with` exprs.
fn remove_escaped_field_inits(store: NodeStore, inits: List<FieldInit>, set: List<string>) -> List<string> {
    mut acc = set
    mut i = 0
    while i < inits.length {
        acc = remove_escaped_expr(store, store.exprs.get(inits[i].value_id), acc)
        i = i + 1
    }
    acc
}

/// OWNERSHIP-POLICY PREDICATE for a value stored into a struct field
/// (struct-literal init / with-expr override): true when the value is
/// owned by someone the current scope does NOT own outright, so the store
/// must RETAIN (the holder gets its own RC tick):
///  - a bare ident naming a PARAM or lambda CAPTURE (`foreign_names`) —
///    the caller / enclosing scope keeps its reference;
///  - a module-level global (QualifiedIdent);
///  - a field / tuple-slot READ of any pure access path — the read struct
///    keeps owning its field.
/// A bare ident naming a LOCAL is NOT foreign: escape analysis removes the
/// local from the releasable set (it escapes into the holder) and its tick
/// TRANSFERS — the historical model, load-bearing twice over: the local
/// must not be released separately, and `try_copy_stack_target` treats
/// releasable as the stack-allocation escape proof, so a transferred local
/// must drop out of that set. Chains containing calls or index reads are
/// not classified (indexed element reads are the recorded t-c6y7
/// residual of the same ownership bug).
export fn expr_is_shared_alias(store: NodeStore, expr: Expr, foreign_names: List<string>) -> bool {
    match expr {
        .Ident(name) -> is_foreign_name(foreign_names, name)
        .QualifiedIdent(_) -> true
        .FieldAccess(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .TupleIndex(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        // An indexed-element read `xs[i]` / `m[k]` of a pure access-path
        // container: the ELEMENT is owned by the container (the list/map keeps
        // it in its own backing store), so storing it into a struct field is a
        // SHARE, not a transfer — the holder must retain its own tick or its
        // recursive __release frees an element the container still owns (the
        // t-c6y7 residual: `Hold { r: xs[0] }` double-freed `xs[0]` on the
        // holder's release). The idx sub-expr is irrelevant to element
        // ownership; only the container path decides. Escape's `.Index` arm
        // keeps the container base releasable in lockstep (a bare-ident base is
        // a read, like `.FieldAccess`).
        .Index(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .Grouping(inner) -> expr_is_shared_alias(store, store.exprs.get(inner), foreign_names)
        _ -> false
    }
}

/// Membership probe for the param/capture name list. (`x in xs` is not an
/// option: the grammar's `in` membership takes a literal-list right operand
/// only — a variable there parses as a range head.)
fn is_foreign_name(names: List<string>, name: string) -> bool {
    for n in names {
        if n == name { return true }
    }
    false
}

/// A pure access path: a bare/qualified name or a chain of field reads /
/// tuple slots over one (plus parenthesised forms).
fn expr_is_access_path(store: NodeStore, expr: Expr) -> bool {
    match expr {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        .FieldAccess(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .TupleIndex(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .Grouping(inner) -> expr_is_access_path(store, store.exprs.get(inner))
        _ -> false
    }
}

// ── Arena eligibility (spec Axis 9.6) ─────────────────────────────
//
// A for-loop body is arena-eligible if it contains at least one
// allocating binding (struct lit, enum ctor, etc.) AND all such
// bindings are non-escaping (releasable). This means every allocation
// in the loop iteration can safely live in a bump arena that is
// freed in bulk at scope exit.

/// Sum the count of allocating expressions across a statement list.
fn count_allocating_in_stmt_ids(store: NodeStore, ids: List<StmtId>) -> int {
    mut total = 0
    for id in ids { total = total + count_allocating_in_stmt_single(store, store.stmts.get(id)) }
    total
}

/// How many allocating expressions one statement contributes — 1 for
/// an allocating binding, recursive for control-flow statements,
/// 0 otherwise.
fn count_allocating_in_stmt_single(store: NodeStore, stmt: Stmt) -> int {
    match stmt_unwrap(store, stmt) {
        .Block(inner) -> count_allocating_in_stmt_ids(store, inner)
        .Let(_, _, init) -> if is_allocating_expr(store.exprs.get(init)) { 1 } else { 0 }
        .Mut(_, _, init) -> if is_allocating_expr(store.exprs.get(init)) { 1 } else { 0 }
        .Const(_, _, init) -> if is_allocating_expr(store.exprs.get(init)) { 1 } else { 0 }
        .If(_, then_b, _) -> count_allocating_in_stmt_single(store, store.stmts.get(then_b))
        .While(_, wb) -> count_allocating_in_stmt_single(store, store.stmts.get(wb))
        .For(_, _, _, fb) -> count_allocating_in_stmt_single(store, store.stmts.get(fb))
        .ForIn(_, _, fib) -> count_allocating_in_stmt_single(store, store.stmts.get(fib))
        .Expr(_) -> 0
        .Return(_) -> 0
        .ReturnEmpty -> 0
        .Function(_, _, _, _, _) -> 0
        .TypeDecl(_, _, _) -> 0
        .NewtypeDecl(_, _) -> 0
        .UnionAliasDecl(_, _) -> 0
        .ShapeDecl(_, _) -> 0
        .EnumDecl(_, _, _) -> 0
        .Match(_, _) -> 0
        .Impl(_, _) -> 0
        .NoOp -> 0
        .ExternFn(_, _, _) -> 0
        .Break -> 0
        .Continue -> 0
        .TraitDecl(_, _) -> 0
        .LetDestructure(_, _) -> 0
        .Defer(_) -> 0
        .Errdefer(_) -> 0
        .Annotated(_, _) -> 0
        .SpecBlock(_, _) -> 0
        .GivenBlock(_, _) -> 0
        .ThenBlock(_, _) -> 0
        .Select(_) -> 0
        .Parallel(_) -> 0
        .Module(_, _) -> 0
        .Use(_, _) -> 0
        .AssocType(_, _) -> 0
        .ComponentDef(_, _, _, _, _, _) -> 0
        .ComponentBlock(_, _, _, _) -> 0
        .TokenBody(_) -> 0
        .Error -> 0
        .Missing -> 0
    }
}

/// True when a for-loop body can be wrapped in a per-iteration
/// bump arena (spec Axis 9.6). Eligibility: the body has at least
/// one allocating binding AND every allocating binding is
/// non-escaping. Bulk freeing the arena at scope exit then replaces
/// per-allocation RC drops.
export fn is_arena_eligible(store: NodeStore, body: Stmt) -> bool {
    let inner = stmt_unwrap(store, body)
    match inner {
        .Block(stmts) -> {
            // Must have at least one allocation
            let owned_count = count_allocating_in_stmt_ids(store, stmts)
            if owned_count == 0 { return false }
            // All allocations must be releasable (non-escaping)
            let empty: List<string> = []
            single_pass_escape_ids(store, stmts, empty).length > 0
        }
        .Let(_, _, init) -> is_allocating_expr(store.exprs.get(init))
        .Mut(_, _, init) -> is_allocating_expr(store.exprs.get(init))
        .Const(_, _, init) -> is_allocating_expr(store.exprs.get(init))
        .Expr(_) -> false
        .Return(_) -> false
        .ReturnEmpty -> false
        .Function(_, _, _, _, _) -> false
        .TypeDecl(_, _, _) -> false
        .NewtypeDecl(_, _) -> false
        .UnionAliasDecl(_, _) -> false
        .ShapeDecl(_, _) -> false
        .EnumDecl(_, _, _) -> false
        .Match(_, _) -> false
        .Impl(_, _) -> false
        .NoOp -> false
        .ExternFn(_, _, _) -> false
        .Break -> false
        .Continue -> false
        .TraitDecl(_, _) -> false
        .LetDestructure(_, _) -> false
        .Defer(_) -> false
        .Errdefer(_) -> false
        .Annotated(_, _) -> false
        .SpecBlock(_, _) -> false
        .GivenBlock(_, _) -> false
        .ThenBlock(_, _) -> false
        .Select(_) -> false
        .Parallel(_) -> false
        .Module(_, _) -> false
        .Use(_, _) -> false
        .AssocType(_, _) -> false
        .If(_, _, _) -> false
        .While(_, _) -> false
        .For(_, _, _, _) -> false
        .ForIn(_, _, _) -> false
        .ComponentDef(_, _, _, _, _, _) -> false
        .ComponentBlock(_, _, _, _) -> false
        .TokenBody(_) -> false
        .Error -> false
        .Missing -> false
    }
}

// ── Copy trait auto-derivation (spec 9.12) ────────────────────────
//
// A type is Copy if it contains only primitive (non-heap) fields.
// Primitives: int, float, bool. Structs/enums are Copy if ALL their
// fields recursively resolve to Copy types. Str, List, Map, Ptr,
// Closure, Fn, Trait are NOT Copy (heap-managed).
//
// The analysis uses a fixed-point iteration: start with all
// struct/enum names as Copy candidates, then repeatedly remove any
// whose fields reference non-Copy types until stable.

/// Compute the Copy auto-derivation set (spec 9.12). A type is Copy
/// when every (recursive) field resolves to a Copy primitive.
/// Seeds the candidate set with every named struct + enum and runs
/// `fixpoint_copy` to remove anything that touches a non-Copy
/// primitive (Str, List, Map, Ptr, Closure, Trait, Union, …).
export fn analyze_copy_types(structs: StructReg, enums: EnumReg) -> List<string> {
    let empty: List<string> = []
    let candidates = seed_struct_candidates(structs, seed_enum_candidates(enums, empty))
    fixpoint_copy(candidates, structs, enums)
}

/// Seed every struct name as a Copy candidate.
fn seed_struct_candidates(reg: StructReg, set: List<string>) -> List<string> {
    mut out = set
    for m in reg.ord { out = out.push(m.name) }
    out
}

/// Seed every enum name as a Copy candidate.
fn seed_enum_candidates(reg: EnumReg, set: List<string>) -> List<string> {
    mut out = set
    for m in reg.ord { out = out.push(m.name) }
    out
}

/// Iterate `refine_copy` until the candidate set is stable. Every
/// pass shrinks the set (or matches the prior pass), so this
/// terminates after at most `len(candidates)` passes.
fn fixpoint_copy(candidates: List<string>, structs: StructReg, enums: EnumReg) -> List<string> {
    let refined = refine_copy(candidates, structs, enums)
    if copy_set_eq(refined, candidates) { refined }
    else { fixpoint_copy(refined, structs, enums) }
}

/// One pass of the Copy fixpoint: keep only those candidates whose
/// fields/variants are themselves Copy under the current set.
fn refine_copy(candidates: List<string>, structs: StructReg, enums: EnumReg) -> List<string> {
    mut out: List<string> = []
    for name in candidates {
        if is_name_copy(name, candidates, structs, enums) {
            out = out.push(name)
        }
    }
    out
}

/// True when `name` is registered as a struct/enum and all of its
/// fields/variants are Copy under the current candidate set.
fn is_name_copy(name: string, candidates: List<string>, structs: StructReg, enums: EnumReg) -> bool {
    let sl = struct_reg_lookup(structs, name)
    if sl.found { return fields_all_copy(sl.fields, candidates) }
    let el = enum_reg_lookup(enums, name)
    if el.found { return variants_all_copy(el.variants, candidates) }
    false
}

/// True when every field in `fields` has a Copy ValueType under
/// the current candidate set.
fn fields_all_copy(fields: List<FieldEntry>, candidates: List<string>) -> bool {
    for f in fields {
        if !vtype_is_copy_in_set(f.resolved, candidates) { return false }
    }
    true
}

/// True when every variant of an enum has Copy fields under the
/// current candidate set.
fn variants_all_copy(variants: List<Variant>, candidates: List<string>) -> bool {
    for v in variants {
        if !fields_all_copy(v.fields, candidates) { return false }
    }
    true
}

/// Local Copy classifier used during the fixpoint analysis. Differs
/// from `types.av`'s `vtype_is_copy` by treating struct/enum/newtype
/// names as Copy purely based on candidate-set membership (since the
/// outer set isn't final yet). Renamed `*_in_set` to avoid colliding
/// with `vtype_is_copy` from types.av now that codegen/ is a flat
/// dir-as-module namespace (g2eo.1).
fn vtype_is_copy_in_set(vt: ValueType, candidates: List<string>) -> bool {
    match vt {
        .Int -> true
        .U8 -> true
        .U16 -> true
        .U32 -> true
        .U64 -> true
        .I8 -> true
        .I16 -> true
        .I32 -> true
        .Float -> true
        .Bool -> true
        .Str -> false
        .Bytes -> false
        .Ptr -> false
        .List(_) -> false
        .Map(_, _) -> false
        .Fn(_) -> false
        .FnTyped(_, _) -> false
        .Closure(_, _) -> false
        .Struct(name, _, _) -> copy_set_has(candidates, name)
        .Enum(name, _, _) -> copy_set_has(candidates, name)
        .Newtype(name, _, _) -> copy_set_has(candidates, name)
        .Trait(_, _) -> false
        .Union(_) -> false
        .Tuple(_) -> false
        _ -> false
    }
}

/// Copy-set equality used by `fixpoint_copy` to detect convergence.
/// Two sets are equal when same length and one is a subset of the
/// other — order doesn't matter.
fn copy_set_eq(a: List<string>, b: List<string>) -> bool {
    a.length == b.length && copy_set_subset(a, b)
}

/// True when every name in `a` also appears in `b`. O(|a| × |b|).
fn copy_set_subset(a: List<string>, b: List<string>) -> bool {
    for name in a {
        if !copy_set_has(b, name) { return false }
    }
    true
}

// ── t-k6lm: per-function RETURN OWNERSHIP ─────────────────────────────
//
// WHY: `let x = make_thing()` — the most ordinary idiom in the language
// — leaks its allocation when the callee returns a struct or enum.
// `is_allocating_expr` whitelists only the literal forms, so a `.Call`
// initializer never enters the releasable set and `Ctx.bind` never
// reaches `register_rc_cleanup`. Measured under AVRA_RC_STRICT=1 with a
// positive control: 200 leaked objects per 200 construct/drop rounds.
//
// The naive fix — admitting every `.Call` — would be an over-release
// CRASH (the t-c6y7 / #911 class), because a callee may hand back
// something it does NOT own: a field of its receiver, one of its own
// params, or a module global. Releasing the caller's local then frees
// memory another holder still references. Note which side is safe:
// NOT releasing leaks, releasing wrongly corrupts. Every "don't know"
// in here must therefore answer NOT-fresh.
//
// So a call is releasable only when the CALLEE is known to return a
// freshly allocated value. That is a per-function property, derived the
// way `analyze_copy_types` above derives Copy-ness: seed every function
// as a candidate, then shrink to a fixpoint. Optimistic seeding is
// sound here, and recursion is the case to check:
//
//   fn f() -> T { if c { f() } else { T{} } }   stays fresh — correct,
//        every actual return does produce a fresh T.
//   fn f(x: T) -> T { if c { f(x) } else { x } } drops on pass 1 — the
//        else-branch returns a param.
//   fn f() -> T { g() } / fn g() -> T { f() }   both stay candidates,
//        but neither can ever return, so nothing is emitted on it.
//
// The shrink is monotone (a name only ever leaves), so it terminates in
// at most one pass per function, exactly as `fixpoint_copy` argues.
//
// NOT VISIBLE, therefore NOT fresh: extern fns, trait/`dyn` dispatch,
// calls through fn-typed values or closures, method calls, and
// cross-module calls — the resolver rewrites those to `.QualifiedIdent`,
// so they never match the `.Ident` callee form this analysis keys on.

/// Names of functions whose every return path yields a freshly
/// allocated value the CALLER may own. Seeded optimistically from the
/// declared functions, then shrunk to a fixpoint.
export fn analyze_return_ownership(store: NodeStore, body: List<StmtId>) -> List<string> {
    let empty: List<string> = []
    let seeded = seed_fn_candidates(store, body, empty)
    // A local binding or parameter can SHADOW a function name (legal
    // since zo1a, and the binding wins lexically), so `make()` at a use
    // site may be calling a closure rather than the function this
    // analysis measured. We cannot tell the two apart from the callee
    // `.Ident` alone, so any name that is ever bound as a local or a
    // parameter anywhere loses its candidacy. Crude, and deliberately
    // so: the cost is a leak left unfixed, never an over-release.
    let bound = collect_bound_names(store, body, empty)
    let base = drop_bound_names(seeded, bound)
    fixpoint_return_fresh(store, body, base)
}

/// Seed every declared function name as a candidate.
fn seed_fn_candidates(store: NodeStore, ids: List<StmtId>, set: List<string>) -> List<string> {
    mut out = set
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Function(name, _, _, _, _) -> { out = releasable_add(out, name) }
            .Block(inner) -> { out = seed_fn_candidates(store, inner, out) }
            _ -> {}
        }
    }
    out
}

/// Every name bound as a local or a parameter anywhere in the program.
fn collect_bound_names(store: NodeStore, ids: List<StmtId>, set: List<string>) -> List<string> {
    mut out = set
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Let(n, _, init) -> {
                out = releasable_add(out, n)
                out = collect_bound_in_expr(store, store.exprs.get(init), out)
            }
            .Mut(n, _, init) -> {
                out = releasable_add(out, n)
                out = collect_bound_in_expr(store, store.exprs.get(init), out)
            }
            .Const(n, _, init) -> {
                out = releasable_add(out, n)
                out = collect_bound_in_expr(store, store.exprs.get(init), out)
            }
            // `let (a, b) = ...` binds EVERY name in the pattern.
            .LetDestructure(names, init) -> {
                for pe in names { out = releasable_add(out, pe.name) }
                out = collect_bound_in_expr(store, store.exprs.get(init), out)
            }
            // Match arms are expressions and can bind/shadow inside.
            .Match(_, arms) -> {
                for arm in arms {
                    out = collect_bound_in_expr(store, store.exprs.get(arm.body_id), out)
                }
            }
            .Expr(e) -> { out = collect_bound_in_expr(store, store.exprs.get(e), out) }
            .Return(e) -> { out = collect_bound_in_expr(store, store.exprs.get(e), out) }
            .Function(_, _, params, _, fbody) -> {
                for p in params { out = releasable_add(out, p.name) }
                out = collect_bound_names(store, fbody, out)
            }
            .Block(inner) -> { out = collect_bound_names(store, inner, out) }
            .If(_, tb, eb) -> {
                out = collect_bound_names(store, [tb], out)
                // else_branch is StmtId? — an `if` with no `else` has none.
                if eb != null { out = collect_bound_names(store, [eb!], out) }
            }
            .While(_, wb) -> { out = collect_bound_names(store, [wb], out) }
            .For(v, _, _, fb) -> {
                out = releasable_add(out, v)
                out = collect_bound_names(store, [fb], out)
            }
            .ForIn(v, _, fib) -> {
                out = releasable_add(out, v)
                out = collect_bound_names(store, [fib], out)
            }
            _ -> {}
        }
    }
    out
}

/// Names bound inside an EXPRESSION — lambda parameters, and locals
/// declared in value-position blocks / if-expressions / match arms. A
/// shadowing binder anywhere must drop the function name, because at a
/// call site `mk()` may resolve to the local rather than the function.
fn collect_bound_in_expr(store: NodeStore, expr: Expr, set: List<string>) -> List<string> {
    mut out = set
    match expr {
        .Lambda(params, body) -> {
            for p in params { out = releasable_add(out, p.name) }
            out = collect_bound_in_expr(store, store.exprs.get(body), out)
        }
        .Block(stmts) -> { out = collect_bound_names(store, stmts, out) }
        .IfExpr(_, a, b) -> {
            out = collect_bound_in_expr(store, store.exprs.get(a), out)
            out = collect_bound_in_expr(store, store.exprs.get(b), out)
        }
        .MatchExpr(_, arms) -> {
            for arm in arms { out = collect_bound_in_expr(store, store.exprs.get(arm.body_id), out) }
        }
        _ -> {}
    }
    out
}

/// Remove every shadowed name from the candidate set.
fn drop_bound_names(cands: List<string>, bound: List<string>) -> List<string> {
    mut out: List<string> = []
    for n in cands {
        if !copy_set_has(bound, n) { out = list_push_copy(out, n) }
    }
    out
}

/// Iterate `refine_return_fresh` until the candidate set is stable.
/// Every pass only shrinks it, so this terminates.
fn fixpoint_return_fresh(store: NodeStore, body: List<StmtId>, cands: List<string>) -> List<string> {
    let refined = refine_return_fresh(store, body, cands)
    if copy_set_eq(refined, cands) { refined }
    else { fixpoint_return_fresh(store, body, refined) }
}

/// One shrink pass: drop any candidate with a return path that does
/// not yield a fresh allocation.
fn refine_return_fresh(store: NodeStore, ids: List<StmtId>, cands: List<string>) -> List<string> {
    mut out = cands
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Function(name, _, _, _, fbody) -> {
                if copy_set_has(out, name) && !fn_returns_fresh(store, fbody, out) {
                    out = releasable_remove(out, name)
                }
            }
            .Block(inner) -> { out = refine_return_fresh(store, inner, out) }
            _ -> {}
        }
    }
    out
}

/// True when EVERY return path of this body yields a fresh allocation:
/// each explicit `return` anywhere inside it, plus the body's tail
/// expression (Avra returns the last expression implicitly).
fn fn_returns_fresh(store: NodeStore, body: List<StmtId>, cands: List<string>) -> bool {
    for e in collect_return_exprs(store, body) {
        if !expr_is_fresh(store, store.exprs.get(e), cands) { return false }
    }
    tail_is_fresh(store, body, cands)
}

/// Every explicitly-returned expression, recursing through control flow.
/// A bare `return` (ReturnEmpty) yields nothing to own, so it is not
/// collected — a unit return can never be a releasable binding.
fn collect_return_exprs(store: NodeStore, ids: List<StmtId>) -> List<ExprId> {
    mut out: List<ExprId> = []
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Return(v) -> { out = list_push_copy(out, v) }
            .Block(inner) -> { for e in collect_return_exprs(store, inner) { out = list_push_copy(out, e) } }
            .If(_, tb, eb) -> {
                for e in collect_return_exprs(store, [tb]) { out = list_push_copy(out, e) }
                if eb != null {
                    for e in collect_return_exprs(store, [eb!]) { out = list_push_copy(out, e) }
                }
            }
            .While(_, wb) -> { for e in collect_return_exprs(store, [wb]) { out = list_push_copy(out, e) } }
            .For(_, _, _, fb) -> { for e in collect_return_exprs(store, [fb]) { out = list_push_copy(out, e) } }
            .ForIn(_, _, fib) -> { for e in collect_return_exprs(store, [fib]) { out = list_push_copy(out, e) } }
            // A `return` inside a match ARM is a return path too. Without
            // this the arm was never examined, so `fn f(a) { match c {
            // true -> { return a } ... } }` was judged fresh — an
            // over-release. Arm bodies are expressions, so a `return`
            // inside one appears as a Block statement within it.
            .Match(_, arms) -> {
                for arm in arms {
                    for e in collect_return_exprs_in_expr(store, store.exprs.get(arm.body_id)) {
                        out = list_push_copy(out, e)
                    }
                }
            }
            // A nested function's returns belong to IT, not to us.
            .Function(_, _, _, _, _) -> {}
            _ -> {}
        }
    }
    out
}

/// `return` expressions reachable from inside an EXPRESSION — match arm
/// bodies and value-position blocks hold statements, and a `return` in
/// one belongs to the enclosing function.
fn collect_return_exprs_in_expr(store: NodeStore, expr: Expr) -> List<ExprId> {
    mut out: List<ExprId> = []
    match expr {
        .Block(stmts) -> { for e in collect_return_exprs(store, stmts) { out = list_push_copy(out, e) } }
        .IfExpr(_, a, b) -> {
            for e in collect_return_exprs_in_expr(store, store.exprs.get(a)) { out = list_push_copy(out, e) }
            for e in collect_return_exprs_in_expr(store, store.exprs.get(b)) { out = list_push_copy(out, e) }
        }
        .MatchExpr(_, arms) -> {
            for arm in arms {
                for e in collect_return_exprs_in_expr(store, store.exprs.get(arm.body_id)) {
                    out = list_push_copy(out, e)
                }
            }
        }
        // A lambda's returns belong to the LAMBDA, not to us.
        _ -> {}
    }
    out
}

/// The implicit return: a body whose last statement is an expression
/// hands that expression back. A body ending in anything else (a
/// `return` already collected above, a decl, a loop) has no tail value,
/// which is vacuously fine.
fn tail_is_fresh(store: NodeStore, body: List<StmtId>, cands: List<string>) -> bool {
    if body.length == 0 { return true }
    match stmt_unwrap(store, store.stmts.get(body.get(body.length - 1))) {
        .Expr(e) -> expr_is_fresh(store, store.exprs.get(e), cands)
        .Block(inner) -> tail_is_fresh(store, inner, cands)
        // An `if` or `match` in TAIL position is the implicit return,
        // and it arrives as a STATEMENT — `Stmt.If` / `Stmt.Match`, not
        // `Expr.IfExpr` / `Expr.MatchExpr`. Missing these was a real
        // over-release: they fell to the catch-all below, which answers
        // "no non-fresh path found", so a function whose else-branch
        // returned a PARAM was marked fresh. Caught by the branch specs
        // in codegen/tests/return_ownership_test.av. Every branch is a
        // return path, so every branch must be fresh.
        .If(_, tb, eb) -> {
            // No `else` means one path yields no value at all; deny
            // rather than reason about it.
            if eb == null { return false }
            tail_is_fresh(store, [tb], cands) && tail_is_fresh(store, [eb!], cands)
        }
        .Match(_, arms) -> {
            for arm in arms {
                if !expr_is_fresh(store, store.exprs.get(arm.body_id), cands) { return false }
            }
            true
        }
        // Anything else in tail position produces no value — a decl, a
        // loop, a `return` already collected above — so the function
        // yields unit and there is no ownership claim to get wrong.
        // (`Ctx.bind` gates on `vtype_is_ptr_type` anyway.)
        _ -> true
    }
}

/// Does this expression produce a value the caller may own?
///
/// The catch-all answers FALSE, and that is the load-bearing line in
/// this file: params, field reads, globals, method calls, indexing,
/// `dyn` dispatch and `.QualifiedIdent` cross-module calls all land
/// there. Adding a `true` arm here without proving the callee allocates
/// is how this becomes a double-free.
fn expr_is_fresh(store: NodeStore, expr: Expr, cands: List<string>) -> bool {
    match expr {
        .StructLit(_, _) -> true
        .EnumCtor(_, _, _) -> true
        .Tuple(_) -> true
        .With(_, _) -> true
        // Only a DIRECT call to a known-fresh function in this module.
        .Call(callee, _) -> {
            match store.exprs.get(callee) {
                .Ident(n) -> copy_set_has(cands, n)
                _ -> false
            }
        }
        // A value-position block/if/match hands back its own tails, so
        // every arm must be fresh for the whole to be.
        .Block(stmts) -> tail_is_fresh(store, stmts, cands)
        .IfExpr(_, a, b) -> expr_is_fresh(store, store.exprs.get(a), cands)
                         && expr_is_fresh(store, store.exprs.get(b), cands)
        .MatchExpr(_, arms) -> {
            for arm in arms {
                if !expr_is_fresh(store, store.exprs.get(arm.body_id), cands) { return false }
            }
            true
        }
        _ -> false
    }
}
