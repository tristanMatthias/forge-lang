// WHY: escape analysis for RC — determines which locals' values
// escape their defining scope. A local is "releasable" if its ONLY
// uses are field reads (p.x, p.y). Any other use (return, pass as
// argument, store into struct, etc.) means the value might be
// referenced elsewhere and must NOT be released at scope exit.
//
// Conservative: if in doubt, mark as escaped (don't release).

use core.{Expr, ExprId, type_qualified_name, FieldEntry, FieldInit, MatchArm, WhenArm, Variant, ValueType, Stmt, StmtId, NodeStore, stmt_unwrap}
use codegen.{releasable_has, StructReg, EnumReg, struct_reg_lookup, enum_reg_lookup, copy_set_has}
use list_ops.{list_push_copy}

/// Add `name` to the releasable set, deduplicating. Returns a fresh
/// copy when name is new — callers reusing `set` elsewhere stay
/// correct.
fn releasable_add(set: List<string>, name: string) -> List<string> {
    if releasable_has(set, name) { set } else { list_push_copy(set, name) }
}

/// Remove every occurrence of `name` from the releasable set.
/// Returns a fresh list so callers reusing the old reference
/// elsewhere stay correct. Used when a use-site proves the local
/// escapes (return, arg pass, etc.).
fn releasable_remove(set: List<string>, name: string) -> List<string> {
    mut out: List<string> = []
    for n in set {
        if n != name { out = out.push(n) }
    }
    out
}

/// Analyze a function body and return the set of locals whose values
/// can safely be RC-released at scope exit. A local is releasable
/// only when:
/// 1. Its initializer is an allocation (struct lit, enum ctor,
///    tuple, with-expr) — see `is_allocating_expr`.
/// 2. Its only uses are field reads (not returned, passed as arg,
///    captured in a closure, etc.).
///
/// Single-pass insight: declarations appear before uses in statement
/// order, so the algorithm walks the list once — a `let` adds the
/// name; later uses only ever remove. Forward references therefore
/// work without a second pass.
/// `tail_yields` says whether the body's TAIL EXPRESSION is the frame's
/// result — i.e. whether this fn declares a non-void return. It cannot be
/// read off the statements: `println(x.f)` and `pass_db_new(…, p.store, …)`
/// are the same `.Expr` shape as the last statement, and only the declared
/// return type says whether the value escapes or is discarded. Callers with
/// no enclosing fn (program-level statements) pass false.
export fn analyze_releasable(store: NodeStore, body: List<StmtId>, fresh: ptr, tail_yields: bool) -> List<string> {
    let empty: List<string> = []
    let swept = single_pass_escape_ids(store, body, empty, fresh)
    remove_returned_field_roots(store, body, swept, tail_yields)
}

/// Apply the "not returned" half of the rule above to FIELD READS.
///
/// `remove_escaped_expr` deliberately spares the base of `p.x` — an
/// ordinary field read does not escape the struct. That is right for a
/// value consumed inside the frame and WRONG for one that leaves it:
///
///     fn frag() -> Grammar {
///         let g = grammar { … }   // a call, so `g` is releasable
///         g.grammar               // a field of `g` is RETURNED
///     }
///
/// `__release` is recursive, so releasing `g` at scope exit frees
/// `g.grammar` — the very value handed back. The caller then reads a
/// freed box (observed as an enum tag of `0xe` reaching
/// `fragment_rule_conflicts`, t-k6lm).
///
/// So a field read in RETURN position escapes its base, and the base
/// walks down the whole chain: `g.a.b` keeps `g` alive too. This runs
/// as a post-filter rather than a flag threaded through
/// `single_pass_stmt`'s 40 arms — both passes only ever REMOVE, so the
/// order between them cannot matter.
fn remove_returned_field_roots(store: NodeStore, body: List<StmtId>, set: List<string>, tail_yields: bool) -> List<string> {
    mut cur = set
    // A `return f(x.g)` yields the CALL'S RESULT, so its arguments escape.
    // A TAIL statement escapes only when its value is the frame's result:
    // `collect_tail_exprs` returns the last STATEMENT either way, and
    // `println(string(p2.y))` ending a VOID fn discards it — treating that as
    // an escape leaks every such local (difftest_corpus/collections.av). The
    // declared return type is the only thing that separates the two, so it is
    // threaded in as `tail_yields` rather than guessed from the shape.
    for e in collect_return_exprs(store, body) {
        cur = remove_field_root_calls(store, store.exprs.get(e), cur)
    }
    for e in collect_tail_exprs(store, body) {
        if tail_yields {
            cur = remove_field_root_calls(store, store.exprs.get(e), cur)
        } else {
            cur = remove_field_root(store, store.exprs.get(e), cur)
        }
    }
    cur
}

/// Drop the root of a field-access chain from the releasable set. A
/// bare `.Ident` is already removed by the main sweep, so re-removing
/// it is a no-op; anything else the sweep has handled on its own.
///
/// This and `remove_field_root_calls` are ONE walker with a mode flag, not two
/// implementations. They were two, and the copies drifted twice: composites
/// dropped the call mode one level in, and NEITHER learned about control flow
/// (#1174, #1176 — both found in review, both the same shape). A single
/// traversal cannot drift from itself.
fn remove_field_root(store: NodeStore, expr: Expr, set: List<string>) -> List<string> {
    remove_field_root_mode(store, expr, set, false)
}

/// As `remove_field_root`, and ALSO descends through CALLS.
///
/// A callee may RETAIN what it is handed, so when its result is what we
/// return, the retained part outlives this frame:
/// `pass_db_new(parsed.ids ?? [], parsed.store, …)` stores `parsed.store`
/// inside the returned `Db`, and releasing `parsed` at scope exit frees a
/// store the caller still reads through (t-k6lm: `query_passes_test::db_for`).
///
/// We cannot see into a callee, so a field passed out is an escape
/// unconditionally — the conservative direction is a leak at worst, the other
/// is a use-after-free. That conservatism is why this is reserved for ESCAPE
/// POSITION (an explicit `return`, or a tail whose value is the frame's
/// result): applied to a discarded tail statement it leaks on every
/// `println(x.f)`, which is what difftest_corpus/collections.av caught.
fn remove_field_root_calls(store: NodeStore, expr: Expr, set: List<string>) -> List<string> {
    remove_field_root_mode(store, expr, set, true)
}

/// The shared walker. `calls` = "this expression's value ESCAPES the frame",
/// which is what licenses descending into call arguments and control-flow
/// arms; with it false the value is discarded and only the plain field-root
/// chain matters.
fn remove_field_root_mode(store: NodeStore, expr: Expr, set: List<string>, calls: bool) -> List<string> {
    match expr {
        .FieldAccess(obj, _) -> remove_field_root_mode(store, store.exprs.get(obj), set, calls)
        .Ident(name) -> releasable_remove(set, name)
        // A returned COMPOSITE carries its parts out of the frame too, so
        // the rule has to reach inside it — `TypeStructureFps { fps: st.done }`
        // hands back a field of `st` just as surely as a bare `st.done` does,
        // and releasing `st` frees what the caller was handed. Walking only
        // the top-level chain missed exactly this (t-k6lm: the `st` release
        // in `core::type_structure_fingerprints`). The mode RIDES ALONG, so a
        // call nested in one still escapes: `Holder { inner: keep(p.inner) }`.
        .StructLit(_, inits) -> remove_field_roots_inits_mode(store, inits, set, calls)
        .With(_, inits) -> remove_field_roots_inits_mode(store, inits, set, calls)
        .EnumCtor(_, _, args) -> remove_field_roots_args_mode(store, args, set, calls)
        .Tuple(elems) -> remove_field_roots_args_mode(store, elems, set, calls)
        // CONTROL FLOW in escape position: the value handed back comes from a
        // branch or arm, so each one is itself in escape position. A non-void
        // fn ending in `match` puts the arm bodies exactly there, and a
        // block-bodied arm nests one level deeper still (#1176). Only in
        // escape position — a DISCARDED `match` statement hands back nothing.
        .Block(body) -> if calls { remove_field_roots_tails(store, body, set) } else { set }
        .IfExpr(_, t, e) -> if calls {
            remove_field_root_mode(store, store.exprs.get(e), remove_field_root_mode(store, store.exprs.get(t), set, true), true)
        } else { set }
        .MatchExpr(_, arms) -> if calls { remove_field_roots_arms(store, arms, set) } else { set }
        // The CALLEE matters too when it is a field access: a returned
        // `p.method(…)` may hand back a field of `p`, exactly as `p.f` does.
        // Only field-access callees descend — a bare `.Ident` callee is a FN
        // NAME, and removing that would drop an unrelated same-named local.
        .Call(callee, args) -> if calls {
            remove_field_roots_args_mode(store, args, remove_callee_root(store, callee, set), true)
        } else { set }
        .GenericCall(_, _, args) -> if calls { remove_field_roots_args_mode(store, args, set, true) } else { set }
        .OptionalMethodCall(obj, _, args) -> if calls {
            remove_field_roots_args_mode(store, args, remove_field_root_mode(store, store.exprs.get(obj), set, true), true)
        } else { set }
        // `x.f ?? default` hands back `x.f` on the non-null path.
        .NullCoalesce(l, r) -> if calls {
            remove_field_root_mode(store, store.exprs.get(r), remove_field_root_mode(store, store.exprs.get(l), set, true), true)
        } else { set }
        _ -> set
    }
}

/// Every arm body of a returned `match` is in escape position.
fn remove_field_roots_arms(store: NodeStore, arms: List<MatchArm>, set: List<string>) -> List<string> {
    mut acc = set
    for arm in arms { acc = remove_field_root_mode(store, store.exprs.get(arm.body_id), acc, true) }
    acc
}

/// A returned BLOCK yields its tail, so the tail is in escape position.
/// Reuses `collect_tail_exprs` so block / if / nested-block tails are found
/// by the same rule the statement level already uses.
fn remove_field_roots_tails(store: NodeStore, body: List<StmtId>, set: List<string>) -> List<string> {
    mut acc = set
    for e in collect_tail_exprs(store, body) { acc = remove_field_root_mode(store, store.exprs.get(e), acc, true) }
    acc
}

/// Descend into a CALL's callee only when it is a field-access chain
/// (a method call on a local). A bare `.Ident` callee names a FUNCTION,
/// so removing it would drop an unrelated local that happens to share
/// the name — a leak for no reason.
fn remove_callee_root(store: NodeStore, callee: ExprId, set: List<string>) -> List<string> {
    match store.exprs.get(callee) {
        .FieldAccess(obj, _) -> remove_field_root(store, store.exprs.get(obj), set)
        _ -> set
    }
}

/// Fold over a composite's initializers, CARRYING the escape mode — the one
/// place that used to have a `_calls` twin, which is how the mode got dropped.
fn remove_field_roots_inits_mode(store: NodeStore, inits: List<FieldInit>, set: List<string>, calls: bool) -> List<string> {
    mut acc = set
    mut i = 0
    while i < inits.length {
        acc = remove_field_root_mode(store, store.exprs.get(inits[i].value_id), acc, calls)
        i = i + 1
    }
    acc
}

/// Fold over call arguments / tuple elements, carrying the escape mode. In
/// escape position every argument is itself in escape position, so nested
/// calls and `??` inside one escape too (`keep(p.inner ?? Inner { n: 0 })`).
fn remove_field_roots_args_mode(store: NodeStore, args: List<ExprId>, set: List<string>, calls: bool) -> List<string> {
    mut acc = set
    mut i = 0
    while i < args.length {
        acc = remove_field_root_mode(store, store.exprs.get(args[i]), acc, calls)
        i = i + 1
    }
    acc
}

/// The implicit-return expressions of a body — the mirror of
/// `tail_is_fresh`, collecting where that one tests. Same shape, so the
/// two stay comparable: a tail `if`/`match` arrives as a STATEMENT, and
/// every branch of it is a return path.
fn collect_tail_exprs(store: NodeStore, ids: List<StmtId>) -> List<ExprId> {
    let no_ids: List<ExprId> = []
    if ids.length == 0 { return no_ids }
    match stmt_unwrap(store, store.stmts.get(ids.get(ids.length - 1))) {
        .Expr(e) -> [e]
        .Block(inner) -> collect_tail_exprs(store, inner)
        .If(_, tb, eb) -> {
            mut out = collect_tail_exprs(store, [tb])
            if eb != null {
                for e in collect_tail_exprs(store, [eb!]) { out = out.push(e) }
            }
            out
        }
        .Match(_, arms) -> {
            mut out: List<ExprId> = []
            for arm in arms { out = out.push(arm.body_id) }
            out
        }
        _ -> no_ids
    }
}

/// Lambda variant of `analyze_releasable`. Lambda bodies that aren't
/// blocks have no bindings to release; otherwise descend into the
/// inner `List<StmtId>`.
export fn analyze_releasable_expr(store: NodeStore, body: Expr, fresh: ptr) -> List<string> {
    match body {
        // A lambda's block TAIL is its value — `(x) -> { … }` yields the last
        // expression — so tails escape here. True is also the safe direction
        // if a particular lambda is used for effect only: over-removing costs
        // a leak, under-removing is a use-after-free.
        .Block(stmts) -> analyze_releasable(store, stmts, fresh, true)
        _ -> {
            let empty: List<string> = []
            empty
        }
    }
}

/// Single-pass escape analysis worker. Walks `ids` left-to-right,
/// folding `single_pass_stmt` over the running List<string>.
fn single_pass_escape_ids(store: NodeStore, ids: List<StmtId>, set: List<string>, fresh: ptr) -> List<string> {
    mut cur = set
    for id in ids { cur = single_pass_stmt(store, store.stmts.get(id), cur, fresh) }
    cur
}

/// Process a `let`/`mut`/`const` binding: add the name when its
/// initializer is allocating, then sweep the initializer for any
/// uses of names already in the set (which would mark them escaped).
fn analyze_binding(store: NodeStore, name: string, init: Expr, set: List<string>, fresh: ptr) -> List<string> {
    let s1 = if is_owning_init(store, init, fresh) { releasable_add(set, name) } else { set }
    remove_escaped_expr(store, init, s1, fresh)
}

/// Per-statement worker. Bindings call `analyze_binding`; control-
/// flow statements recurse into their bodies; everything else is
/// only checked for escaping uses inside its expressions. Decl-only
/// statements (TypeDecl, TraitDecl, …) are pass-through.
fn single_pass_stmt(store: NodeStore, stmt: Stmt, set: List<string>, fresh: ptr) -> List<string> {
    let inner = stmt_unwrap(store, stmt)
    match inner {
        .Let(name, _, init) -> analyze_binding(store, name, store.exprs.get(init), set, fresh)
        .Mut(name, _, init) -> analyze_binding(store, name, store.exprs.get(init), set, fresh)
        .Const(name, _, init) -> analyze_binding(store, name, store.exprs.get(init), set, fresh)
        // Recurse into blocks
        .Block(body) -> single_pass_escape_ids(store, body, set, fresh)
        .If(cond, then_b, else_b) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(cond), set, fresh)
            let s2 = single_pass_stmt(store, store.stmts.get(then_b), s1, fresh)
            if else_b != null { single_pass_stmt(store, store.stmts.get(else_b!), s2, fresh) } else { s2 }
        }
        // Everything else: just check for escapes (same as remove_escaped_stmt)
        .Return(expr) -> remove_escaped_expr(store, store.exprs.get(expr), set, fresh)
        .Expr(expr) -> remove_escaped_expr(store, store.exprs.get(expr), set, fresh)
        .While(cond, body) -> single_pass_stmt(store, store.stmts.get(body), remove_escaped_expr(store, store.exprs.get(cond), set, fresh), fresh)
        .For(_, start, end, body) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(start), set, fresh)
            let s2 = remove_escaped_expr(store, store.exprs.get(end), s1, fresh)
            single_pass_stmt(store, store.stmts.get(body), s2, fresh)
        }
        .ForIn(_, coll, body) -> single_pass_stmt(store, store.stmts.get(body), remove_escaped_expr(store, store.exprs.get(coll), set, fresh), fresh)
        // Same bug as the MatchExpr arm in remove_escaped_expr: walk
        // the arm guards + bodies so an h returned from a match arm
        // body gets removed from rc_releasable (otherwise scope-exit
        // releases h before the caller of the fn sees the value).
        .Match(subj, arms) -> remove_escaped_match_arms(store, arms, remove_escaped_expr(store, store.exprs.get(subj), set, fresh), fresh)
        .Defer(body) -> remove_escaped_expr(store, store.exprs.get(body), set, fresh)
        .Errdefer(body) -> remove_escaped_expr(store, store.exprs.get(body), set, fresh)
        .Annotated(_, inner_id) -> single_pass_stmt(store, store.stmts.get(inner_id), set, fresh)
        .LetDestructure(_, init) -> remove_escaped_expr(store, store.exprs.get(init), set, fresh)
        .Function(_, _, _, _, _) -> set
        .ReturnEmpty -> set
        .TypeDecl(_, _, _) -> set
        .NewtypeDecl(_, _) -> set
        .UnionAliasDecl(_, _) -> set
        .ShapeDecl(_, _) -> set
        .EnumDecl(_, _, _) -> set
        .ExternFn(_, _, _) -> set
        .TraitDecl(_, _) -> set
        .Impl(_, _) -> set
        .NoOp -> set
        .Break -> set
        .Continue -> set
        .SpecBlock(_, _) -> set
        .GivenBlock(_, _) -> set
        .ThenBlock(_, _) -> set
        .Select(_) -> set
        .Parallel(_) -> set
        .Module(_, _) -> set
        .Use(_, _) -> set
        .AssocType(_, _) -> set
        .ComponentDef(_, _, _, _, _, _) -> set
        .ComponentBlock(_, _, _, _) -> set
        .TokenBody(_) -> set
        .Error -> set
        .Missing -> set
    }
}


/// True when `expr` produces a freshly allocated heap object the
/// binding owns. Currently: struct literal, enum constructor, tuple,
/// with-expr. Add new allocating forms here when introduced.
export fn is_allocating_expr(expr: Expr) -> bool {
    match expr {
        .StructLit(_, _) -> true
        .EnumCtor(_, _, _) -> true
        .Tuple(_) -> true
        .With(_, _) -> true
        _ -> false
    }
}

/// The WIDE initializer predicate (t-k6lm slice 2): does `init` hand the
/// binding a value the binding OWNS and must release at scope exit?
///
/// This is `is_allocating_expr` PLUS calls whose callee is known to return
/// a freshly allocated value (`analyze_return_ownership`). It is
/// deliberately a SEPARATE function rather than a flag on
/// `is_allocating_expr`, because the two predicates answer different
/// questions and their other callers must not drift onto the wrong one:
///
///   is_allocating_expr — "is this value allocated HERE, in this body?"
///       Used by `count_allocating_in_stmt_*` → `is_arena_eligible`, which
///       decides whether a LOOP BODY gets a per-scope arena whose reset
///       REPLACES per-allocation RC drops. A call-returned value is
///       allocated in the CALLEE, never in this body's arena, so widening
///       that predicate would arena-ize a value the arena does not own AND
///       skip the drops that would have reclaimed it. Keep it narrow.
///
///   is_owning_init — "must THIS BINDING release the value at scope exit?"
///       Used by `analyze_binding` for the releasable set. A call to a
///       known-fresh callee qualifies: the callee allocated it and handed
///       ownership over.
export fn is_owning_init(store: NodeStore, init: Expr, fresh: ptr) -> bool {
    if is_allocating_expr(init) { return true }
    match init {
        .Call(callee, _) -> {
            match store.exprs.get(callee) {
                .Ident(n) -> fresh_set_has(fresh, n)
                // The resolver qualifies same-module calls, so this form is
                // the COMMON one inside any module. Membership is an EXACT
                // match against a canonical key this analysis seeded itself,
                // so a foreign module's path can never match — a cross-module
                // `@pkg::other::mk` whose last segment happens to collide
                // stays denied, as the ticket requires.
                .QualifiedIdent(p) -> fresh_set_has(fresh, p)
                _ -> false
            }
        }
        _ -> false
    }
}

/// Walk an expression and remove names from the releasable set when
/// they're used in a way that escapes the local. The only safe
/// pattern is `.FieldAccess(Ident(name), _)` (reading a field). Any
/// other use of `Ident(name)` removes it.
fn remove_escaped_expr(store: NodeStore, expr: Expr, set: List<string>, fresh: ptr) -> List<string> {
    match expr {
        // Field access is safe — reading a field doesn't escape the struct
        .FieldAccess(obj, _) -> {
            let obj_expr = store.exprs.get(obj)
            match obj_expr {
                .Ident(_) -> set  // p.x is safe — don't remove p
                _ -> remove_escaped_expr(store, obj_expr, set, fresh)  // nested: (expr).field
            }
        }
        // These are escaping uses:
        .Ident(name) -> releasable_remove(set, name)
        // Recurse into sub-expressions
        .Call(callee, args) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(callee), set, fresh)
            remove_escaped_arg_ids(store, args, s1, fresh)
        }
        .GenericCall(callee, _, args) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(callee), set, fresh)
            remove_escaped_arg_ids(store, args, s1, fresh)
        }
        .Binary(left, _, right) -> remove_escaped_expr(store, store.exprs.get(right), remove_escaped_expr(store, store.exprs.get(left), set, fresh), fresh)
        .Unary(_, inner) -> remove_escaped_expr(store, store.exprs.get(inner), set, fresh)
        .Logical(left, _, right) -> remove_escaped_expr(store, store.exprs.get(right), remove_escaped_expr(store, store.exprs.get(left), set, fresh), fresh)
        .Grouping(inner) -> remove_escaped_expr(store, store.exprs.get(inner), set, fresh)
        // `xs[i]` is a READ of the container `xs` — the element is
        // container-owned and, when stored into a holder, is RETAINED there
        // (expr_is_shared_alias's `.Index` arm). So a bare-ident container base
        // must stay releasable (its own __release frees the element the holder
        // retained), exactly like `.FieldAccess(Ident(_), _)` keeps its base.
        // The index sub-expr is still swept — a name used only to index does
        // not escape, but `xs[consume()]` must sweep `consume`'s idents. t-c6y7.
        .Index(obj, idx) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(idx), set, fresh)
            let obj_expr = store.exprs.get(obj)
            match obj_expr {
                .Ident(_) -> s1
                _ -> remove_escaped_expr(store, obj_expr, s1, fresh)
            }
        }
        // REASSIGNMENT retargets the scope-exit release. A local admitted
        // on its initializer (`mut site = RqRef { … }`) can be reassigned to
        // a value this frame does NOT own (`site = found`, straight out of a
        // memo Db), and the release then frees the other owner's object.
        // Sweeping only the RHS leaves the name in the set under a value its
        // initializer never described. Assigning another OWNED allocation is
        // still fine, so candidacy drops only when the new value isn't one.
        // `.FieldAssign` needs no such arm — it already sweeps its object,
        // which removes the base.
        .Assign(name, val) -> {
            let v = store.exprs.get(val)
            let swept = remove_escaped_expr(store, v, set, fresh)
            if is_owning_init(store, v, fresh) { swept } else { releasable_remove(swept, name) }
        }
        .FieldAssign(obj, _, val) -> remove_escaped_expr(store, store.exprs.get(val), remove_escaped_expr(store, store.exprs.get(obj), set, fresh), fresh)
        .StructLit(_, inits) -> remove_escaped_field_inits(store, inits, set, fresh)
        .ListLit(elems) -> remove_escaped_arg_ids(store, elems, set, fresh)
        // `with` reads obj field-by-field and emits rc_retain on ptr
        // fields the new struct keeps (see with_expr/codegen.av).
        // So `let u = h with { ... }` is a READ of `h` — the new
        // struct's retains keep h's ptr fields alive independently,
        // and h is still owned by its binding. Treat `Ident(h)` here
        // like FieldAccess does, so the source stays releasable and
        // its own __release_<Struct> fires at scope exit.
        .With(obj, inits) -> {
            let obj_node = store.exprs.get(obj)
            let s1 = match obj_node { .Ident(_) -> set, _ -> remove_escaped_expr(store, obj_node, set, fresh) }
            remove_escaped_field_inits(store, inits, s1, fresh)
        }
        .Lambda(_, body) -> remove_escaped_expr(store, store.exprs.get(body), set, fresh)
        .Block(body) -> single_pass_escape_ids(store, body, set, fresh)
        .IfExpr(cond, t, e) -> remove_escaped_expr(store, store.exprs.get(e), remove_escaped_expr(store, store.exprs.get(t), remove_escaped_expr(store, store.exprs.get(cond), set, fresh), fresh), fresh)
        // Match arms must be walked: a variable used in an arm body
        // (especially as the arm's return value, which escapes) needs
        // to be removed from the releasable set. Without this the
        // scope-exit release path frees a struct the match expression
        // returned — UAF on the returned value.
        .MatchExpr(subj, arms) -> remove_escaped_match_arms(store, arms, remove_escaped_expr(store, store.exprs.get(subj), set, fresh), fresh)
        .Tuple(elems) -> remove_escaped_arg_ids(store, elems, set, fresh)
        .TupleIndex(obj, _) -> remove_escaped_expr(store, store.exprs.get(obj), set, fresh)
        .MapLit(entries) -> remove_escaped_arg_ids(store, entries, set, fresh)
        .Slice(obj, start, end) -> remove_escaped_expr(store, store.exprs.get(end), remove_escaped_expr(store, store.exprs.get(start), remove_escaped_expr(store, store.exprs.get(obj), set, fresh), fresh), fresh)
        .Try(inner) -> remove_escaped_expr(store, store.exprs.get(inner), set, fresh)
        .Catch(inner, _, body, _, _) -> remove_escaped_expr(store, store.exprs.get(body), remove_escaped_expr(store, store.exprs.get(inner), set, fresh), fresh)
        .NullCoalesce(left, right) -> remove_escaped_expr(store, store.exprs.get(right), remove_escaped_expr(store, store.exprs.get(left), set, fresh), fresh)
        .OptionalChain(obj, _) -> remove_escaped_expr(store, store.exprs.get(obj), set, fresh)
        .OptionalMethodCall(obj, _, args) -> remove_escaped_arg_ids(store, args, remove_escaped_expr(store, store.exprs.get(obj), set, fresh), fresh)
        .IsCheck(subj, _) -> remove_escaped_expr(store, store.exprs.get(subj), set, fresh)
        .InCheck(needle, items) -> remove_escaped_arg_ids(store, items, remove_escaped_expr(store, store.exprs.get(needle), set, fresh), fresh)
        .EnumCtor(_, _, args) -> remove_escaped_arg_ids(store, args, set, fresh)
        .Spawn(body) -> remove_escaped_expr(store, store.exprs.get(body), set, fresh)
        .ChannelNew(_, capacity) -> {
            if capacity == null { set } else { remove_escaped_expr(store, store.exprs.get(capacity!), set, fresh) }
        }
        .Isolated(body) -> remove_escaped_expr(store, store.exprs.get(body), set, fresh)
        .Quote(_, body) -> remove_escaped_expr(store, store.exprs.get(body), set, fresh)
        .Splice(target) -> remove_escaped_expr(store, store.exprs.get(target), set, fresh)
        // Same as MatchExpr: when arms' bodies/conditions can escape
        // variables (return value of the arm, or pass to a fn). The
        // old "no escapes at this level" comment was wrong.
        .When(arms) -> remove_escaped_when_arms(store, arms, set, fresh)
        .ListComp(body, _, coll, filter) -> {
            let s1 = remove_escaped_expr(store, store.exprs.get(body), set, fresh)
            let s2 = remove_escaped_expr(store, store.exprs.get(coll), s1, fresh)
            if filter != null { remove_escaped_expr(store, store.exprs.get(filter!), s2, fresh) } else { s2 }
        }
        // Leaf expressions — no idents to escape
        .Number(_) -> set
        .FloatLit(_) -> set
        .String(_) -> set
        .Bool(_) -> set
        .None -> set
        .QualifiedIdent(_) -> set
        // A type carrier holds no idents (lowered away before codegen).
        .TypeLit(_) -> set
        .Error -> set
        .Missing -> set
    }
}

/// Walk each match arm's guard + body checking for escapes.
fn remove_escaped_match_arms(store: NodeStore, arms: List<MatchArm>, set: List<string>, fresh: ptr) -> List<string> {
    mut acc = set
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.guard_id != null {
            acc = remove_escaped_expr(store, store.exprs.get(arm.guard_id!), acc, fresh)
        }
        acc = remove_escaped_expr(store, store.exprs.get(arm.body_id), acc, fresh)
        i = i + 1
    }
    acc
}

/// Walk each when-arm's cond + body checking for escapes.
fn remove_escaped_when_arms(store: NodeStore, arms: List<WhenArm>, set: List<string>, fresh: ptr) -> List<string> {
    mut acc = set
    mut i = 0
    while i < arms.length {
        let arm = arms[i]
        if arm.cond_id != null {
            acc = remove_escaped_expr(store, store.exprs.get(arm.cond_id!), acc, fresh)
        }
        acc = remove_escaped_expr(store, store.exprs.get(arm.body_id), acc, fresh)
        i = i + 1
    }
    acc
}

/// Apply `remove_escaped_expr` to every element of a flipped `List<ExprId>`
/// (call/collection args).
fn remove_escaped_arg_ids(store: NodeStore, args: List<ExprId>, set: List<string>, fresh: ptr) -> List<string> {
    mut acc = set
    mut i = 0
    while i < args.length {
        acc = remove_escaped_expr(store, store.exprs.get(args[i]), acc, fresh)
        i = i + 1
    }
    acc
}

/// Apply `remove_escaped_expr` to every value in a struct-literal
/// `List<FieldInit>`. Used on `Foo { x: a, y: b }` and `with` exprs.
fn remove_escaped_field_inits(store: NodeStore, inits: List<FieldInit>, set: List<string>, fresh: ptr) -> List<string> {
    mut acc = set
    mut i = 0
    while i < inits.length {
        acc = remove_escaped_expr(store, store.exprs.get(inits[i].value_id), acc, fresh)
        i = i + 1
    }
    acc
}

/// OWNERSHIP-POLICY PREDICATE for a value stored into a struct field
/// (struct-literal init / with-expr override): true when the value is
/// owned by someone the current scope does NOT own outright, so the store
/// must RETAIN (the holder gets its own RC tick):
///  - a bare ident naming a PARAM or lambda CAPTURE (`foreign_names`) —
///    the caller / enclosing scope keeps its reference;
///  - a module-level global (QualifiedIdent);
///  - a field / tuple-slot READ of any pure access path — the read struct
///    keeps owning its field.
/// A bare ident naming a LOCAL is NOT foreign: escape analysis removes the
/// local from the releasable set (it escapes into the holder) and its tick
/// TRANSFERS — the historical model, load-bearing twice over: the local
/// must not be released separately, and `try_copy_stack_target` treats
/// releasable as the stack-allocation escape proof, so a transferred local
/// must drop out of that set. Chains containing calls or index reads are
/// not classified (indexed element reads are the recorded t-c6y7
/// residual of the same ownership bug).
export fn expr_is_shared_alias(store: NodeStore, expr: Expr, foreign_names: List<string>) -> bool {
    match expr {
        .Ident(name) -> is_foreign_name(foreign_names, name)
        .QualifiedIdent(_) -> true
        .FieldAccess(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .TupleIndex(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        // An indexed-element read `xs[i]` / `m[k]` of a pure access-path
        // container: the ELEMENT is owned by the container (the list/map keeps
        // it in its own backing store), so storing it into a struct field is a
        // SHARE, not a transfer — the holder must retain its own tick or its
        // recursive __release frees an element the container still owns (the
        // t-c6y7 residual: `Hold { r: xs[0] }` double-freed `xs[0]` on the
        // holder's release). The idx sub-expr is irrelevant to element
        // ownership; only the container path decides. Escape's `.Index` arm
        // keeps the container base releasable in lockstep (a bare-ident base is
        // a read, like `.FieldAccess`).
        .Index(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .Grouping(inner) -> expr_is_shared_alias(store, store.exprs.get(inner), foreign_names)
        _ -> false
    }
}

/// Membership probe for the param/capture name list. (`x in xs` is not an
/// option: the grammar's `in` membership takes a literal-list right operand
/// only — a variable there parses as a range head.)
fn is_foreign_name(names: List<string>, name: string) -> bool {
    for n in names {
        if n == name { return true }
    }
    false
}

/// A pure access path: a bare/qualified name or a chain of field reads /
/// tuple slots over one (plus parenthesised forms).
fn expr_is_access_path(store: NodeStore, expr: Expr) -> bool {
    match expr {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        .FieldAccess(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .TupleIndex(obj, _) -> expr_is_access_path(store, store.exprs.get(obj))
        .Grouping(inner) -> expr_is_access_path(store, store.exprs.get(inner))
        _ -> false
    }
}

// ── Arena eligibility (spec Axis 9.6) ─────────────────────────────
//
// A for-loop body is arena-eligible if it contains at least one
// allocating binding (struct lit, enum ctor, etc.) AND all such
// bindings are non-escaping (releasable). This means every allocation
// in the loop iteration can safely live in a bump arena that is
// freed in bulk at scope exit.

/// Sum the count of allocating expressions across a statement list.
fn count_allocating_in_stmt_ids(store: NodeStore, ids: List<StmtId>) -> int {
    mut total = 0
    for id in ids { total = total + count_allocating_in_stmt_single(store, store.stmts.get(id)) }
    total
}

/// How many allocating expressions one statement contributes — 1 for
/// an allocating binding, recursive for control-flow statements,
/// 0 otherwise.
fn count_allocating_in_stmt_single(store: NodeStore, stmt: Stmt) -> int {
    match stmt_unwrap(store, stmt) {
        .Block(inner) -> count_allocating_in_stmt_ids(store, inner)
        .Let(_, _, init) -> if is_allocating_expr(store.exprs.get(init)) { 1 } else { 0 }
        .Mut(_, _, init) -> if is_allocating_expr(store.exprs.get(init)) { 1 } else { 0 }
        .Const(_, _, init) -> if is_allocating_expr(store.exprs.get(init)) { 1 } else { 0 }
        .If(_, then_b, _) -> count_allocating_in_stmt_single(store, store.stmts.get(then_b))
        .While(_, wb) -> count_allocating_in_stmt_single(store, store.stmts.get(wb))
        .For(_, _, _, fb) -> count_allocating_in_stmt_single(store, store.stmts.get(fb))
        .ForIn(_, _, fib) -> count_allocating_in_stmt_single(store, store.stmts.get(fib))
        .Expr(_) -> 0
        .Return(_) -> 0
        .ReturnEmpty -> 0
        .Function(_, _, _, _, _) -> 0
        .TypeDecl(_, _, _) -> 0
        .NewtypeDecl(_, _) -> 0
        .UnionAliasDecl(_, _) -> 0
        .ShapeDecl(_, _) -> 0
        .EnumDecl(_, _, _) -> 0
        .Match(_, _) -> 0
        .Impl(_, _) -> 0
        .NoOp -> 0
        .ExternFn(_, _, _) -> 0
        .Break -> 0
        .Continue -> 0
        .TraitDecl(_, _) -> 0
        .LetDestructure(_, _) -> 0
        .Defer(_) -> 0
        .Errdefer(_) -> 0
        .Annotated(_, _) -> 0
        .SpecBlock(_, _) -> 0
        .GivenBlock(_, _) -> 0
        .ThenBlock(_, _) -> 0
        .Select(_) -> 0
        .Parallel(_) -> 0
        .Module(_, _) -> 0
        .Use(_, _) -> 0
        .AssocType(_, _) -> 0
        .ComponentDef(_, _, _, _, _, _) -> 0
        .ComponentBlock(_, _, _, _) -> 0
        .TokenBody(_) -> 0
        .Error -> 0
        .Missing -> 0
    }
}

/// True when a for-loop body can be wrapped in a per-iteration
/// bump arena (spec Axis 9.6). Eligibility: the body has at least
/// one allocating binding AND every allocating binding is
/// non-escaping. Bulk freeing the arena at scope exit then replaces
/// per-allocation RC drops.
export fn is_arena_eligible(store: NodeStore, body: Stmt) -> bool {
    let inner = stmt_unwrap(store, body)
    match inner {
        .Block(stmts) -> {
            // Must have at least one allocation
            let owned_count = count_allocating_in_stmt_ids(store, stmts)
            if owned_count == 0 { return false }
            // All allocations must be releasable (non-escaping)
            let empty: List<string> = []
            // t-k6lm: the arena path passes an EMPTY fresh set on purpose.
            // With no known-fresh callees, `is_owning_init` degrades exactly
            // to `is_allocating_expr` — the narrow "allocated HERE" question
            // this predicate must ask. A call-returned value belongs to the
            // callee's allocator, never to this loop's arena.
            let no_fresh: ptr = null
            single_pass_escape_ids(store, stmts, empty, no_fresh).length > 0
        }
        .Let(_, _, init) -> is_allocating_expr(store.exprs.get(init))
        .Mut(_, _, init) -> is_allocating_expr(store.exprs.get(init))
        .Const(_, _, init) -> is_allocating_expr(store.exprs.get(init))
        .Expr(_) -> false
        .Return(_) -> false
        .ReturnEmpty -> false
        .Function(_, _, _, _, _) -> false
        .TypeDecl(_, _, _) -> false
        .NewtypeDecl(_, _) -> false
        .UnionAliasDecl(_, _) -> false
        .ShapeDecl(_, _) -> false
        .EnumDecl(_, _, _) -> false
        .Match(_, _) -> false
        .Impl(_, _) -> false
        .NoOp -> false
        .ExternFn(_, _, _) -> false
        .Break -> false
        .Continue -> false
        .TraitDecl(_, _) -> false
        .LetDestructure(_, _) -> false
        .Defer(_) -> false
        .Errdefer(_) -> false
        .Annotated(_, _) -> false
        .SpecBlock(_, _) -> false
        .GivenBlock(_, _) -> false
        .ThenBlock(_, _) -> false
        .Select(_) -> false
        .Parallel(_) -> false
        .Module(_, _) -> false
        .Use(_, _) -> false
        .AssocType(_, _) -> false
        .If(_, _, _) -> false
        .While(_, _) -> false
        .For(_, _, _, _) -> false
        .ForIn(_, _, _) -> false
        .ComponentDef(_, _, _, _, _, _) -> false
        .ComponentBlock(_, _, _, _) -> false
        .TokenBody(_) -> false
        .Error -> false
        .Missing -> false
    }
}

// ── Copy trait auto-derivation (spec 9.12) ────────────────────────
//
// A type is Copy if it contains only primitive (non-heap) fields.
// Primitives: int, float, bool. Structs/enums are Copy if ALL their
// fields recursively resolve to Copy types. Str, List, Map, Ptr,
// Closure, Fn, Trait are NOT Copy (heap-managed).
//
// The analysis uses a fixed-point iteration: start with all
// struct/enum names as Copy candidates, then repeatedly remove any
// whose fields reference non-Copy types until stable.

/// Compute the Copy auto-derivation set (spec 9.12). A type is Copy
/// when every (recursive) field resolves to a Copy primitive.
/// Seeds the candidate set with every named struct + enum and runs
/// `fixpoint_copy` to remove anything that touches a non-Copy
/// primitive (Str, List, Map, Ptr, Closure, Trait, Union, …).
export fn analyze_copy_types(structs: StructReg, enums: EnumReg) -> List<string> {
    let empty: List<string> = []
    let candidates = seed_struct_candidates(structs, seed_enum_candidates(enums, empty))
    fixpoint_copy(candidates, structs, enums)
}

/// Seed every struct name as a Copy candidate.
fn seed_struct_candidates(reg: StructReg, set: List<string>) -> List<string> {
    mut out = set
    for m in reg.ord { out = out.push(m.name) }
    out
}

/// Seed every enum name as a Copy candidate.
fn seed_enum_candidates(reg: EnumReg, set: List<string>) -> List<string> {
    mut out = set
    for m in reg.ord { out = out.push(m.name) }
    out
}

/// Iterate `refine_copy` until the candidate set is stable. Every
/// pass shrinks the set (or matches the prior pass), so this
/// terminates after at most `len(candidates)` passes.
fn fixpoint_copy(candidates: List<string>, structs: StructReg, enums: EnumReg) -> List<string> {
    let refined = refine_copy(candidates, structs, enums)
    if copy_set_eq(refined, candidates) { refined }
    else { fixpoint_copy(refined, structs, enums) }
}

/// One pass of the Copy fixpoint: keep only those candidates whose
/// fields/variants are themselves Copy under the current set.
fn refine_copy(candidates: List<string>, structs: StructReg, enums: EnumReg) -> List<string> {
    mut out: List<string> = []
    for name in candidates {
        if is_name_copy(name, candidates, structs, enums) {
            out = out.push(name)
        }
    }
    out
}

/// True when `name` is registered as a struct/enum and all of its
/// fields/variants are Copy under the current candidate set.
fn is_name_copy(name: string, candidates: List<string>, structs: StructReg, enums: EnumReg) -> bool {
    let sl = struct_reg_lookup(structs, name)
    if sl.found { return fields_all_copy(sl.fields, candidates) }
    let el = enum_reg_lookup(enums, name)
    if el.found { return variants_all_copy(el.variants, candidates) }
    false
}

/// True when every field in `fields` has a Copy ValueType under
/// the current candidate set.
fn fields_all_copy(fields: List<FieldEntry>, candidates: List<string>) -> bool {
    for f in fields {
        if !vtype_is_copy_in_set(f.resolved, candidates) { return false }
    }
    true
}

/// True when every variant of an enum has Copy fields under the
/// current candidate set.
fn variants_all_copy(variants: List<Variant>, candidates: List<string>) -> bool {
    for v in variants {
        if !fields_all_copy(v.fields, candidates) { return false }
    }
    true
}

/// Local Copy classifier used during the fixpoint analysis. Differs
/// from `types.av`'s `vtype_is_copy` by treating struct/enum/newtype
/// names as Copy purely based on candidate-set membership (since the
/// outer set isn't final yet). Renamed `*_in_set` to avoid colliding
/// with `vtype_is_copy` from types.av now that codegen/ is a flat
/// dir-as-module namespace (g2eo.1).
fn vtype_is_copy_in_set(vt: ValueType, candidates: List<string>) -> bool {
    match vt {
        .Int -> true
        .U8 -> true
        .U16 -> true
        .U32 -> true
        .U64 -> true
        .I8 -> true
        .I16 -> true
        .I32 -> true
        .Float -> true
        .Bool -> true
        .Str -> false
        .Bytes -> false
        .Ptr -> false
        .List(_) -> false
        .Map(_, _) -> false
        .Fn(_) -> false
        .FnTyped(_, _) -> false
        .Closure(_, _) -> false
        .Struct(name, _, _) -> copy_set_has(candidates, name)
        .Enum(name, _, _) -> copy_set_has(candidates, name)
        .Newtype(name, _, _) -> copy_set_has(candidates, name)
        .Trait(_, _) -> false
        .Union(_) -> false
        .Tuple(_) -> false
        _ -> false
    }
}

/// Copy-set equality used by `fixpoint_copy` to detect convergence.
/// Two sets are equal when same length and one is a subset of the
/// other — order doesn't matter.
fn copy_set_eq(a: List<string>, b: List<string>) -> bool {
    a.length == b.length && copy_set_subset(a, b)
}

/// True when every name in `a` also appears in `b`. O(|a| × |b|).
fn copy_set_subset(a: List<string>, b: List<string>) -> bool {
    for name in a {
        if !copy_set_has(b, name) { return false }
    }
    true
}

// ── t-k6lm: per-function RETURN OWNERSHIP ─────────────────────────────
//
// WHY: `let x = make_thing()` — the most ordinary idiom in the language
// — leaks its allocation when the callee returns a struct or enum.
// `is_allocating_expr` whitelists only the literal forms, so a `.Call`
// initializer never enters the releasable set and `Ctx.bind` never
// reaches `register_rc_cleanup`. Measured under AVRA_RC_STRICT=1 with a
// positive control: 200 leaked objects per 200 construct/drop rounds.
//
// The naive fix — admitting every `.Call` — would be an over-release
// CRASH (the t-c6y7 / #911 class), because a callee may hand back
// something it does NOT own: a field of its receiver, one of its own
// params, or a module global. Releasing the caller's local then frees
// memory another holder still references. Note which side is safe:
// NOT releasing leaks, releasing wrongly corrupts. Every "don't know"
// in here must therefore answer NOT-fresh.
//
// So a call is releasable only when the CALLEE is known to return a
// freshly allocated value. That is a per-function property, derived the
// way `analyze_copy_types` above derives Copy-ness: seed every function
// as a candidate, then shrink to a fixpoint. Optimistic seeding is
// sound here, and recursion is the case to check:
//
//   fn f() -> T { if c { f() } else { T{} } }   stays fresh — correct,
//        every actual return does produce a fresh T.
//   fn f(x: T) -> T { if c { f(x) } else { x } } drops on pass 1 — the
//        else-branch returns a param.
//   fn f() -> T { g() } / fn g() -> T { f() }   both stay candidates,
//        but neither can ever return, so nothing is emitted on it.
//
// The shrink is monotone (a name only ever leaves), so it terminates in
// at most one pass per function, exactly as `fixpoint_copy` argues.
//
// NOT VISIBLE, therefore NOT fresh: extern fns, trait/`dyn` dispatch,
// calls through fn-typed values or closures, method calls, and
// cross-module calls — the resolver rewrites those to `.QualifiedIdent`,
// so they never match the `.Ident` callee form this analysis keys on.

// ── The fresh-fn set is HASH-BACKED, not a list ──────────────────────
//
// This set is READ once per call-site initializer and once per function
// per fixpoint pass, and WRITTEN once per declared function plus once
// per binder anywhere in the program. On a linear `List<string>` every
// one of those is O(n), so wiring the analysis into the compile path
// made `@std::avrac` — thousands of functions, tens of thousands of
// binders — run past a 600s timeout without finishing. Not slow: it
// never produced a `.ll` at all.
//
// The resolver hit precisely this and fixed it precisely this way. Its
// global index "was a cons-list searched O(n) per identifier … nearly
// quadratic", and is now a cstr_map built once and read O(1)
// (resolve/names.av). Same primitive, same reason.
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_has_cstr(map: ptr, key: string) -> int
extern fn avra_map_remove_cstr(map: ptr, key: string)
extern fn avra_map_keys_cstr(map: ptr) -> List<string>

/// A fresh-fn set.
export fn fresh_set_new() -> ptr { avra_map_new_cstr() }

/// NULL is the EMPTY set, deliberately. `Ctx.rc_fresh_fns` is a plain
/// field, so any Ctx built without running the analysis carries null —
/// and the arena path passes null on purpose (see `is_arena_eligible`).
/// Answering "not a member" is both correct and the safe direction:
/// a miss leaks, a false hit double-frees.
export fn fresh_set_has(set: ptr, name: string) -> bool {
    if set == null { return false }
    avra_map_has_cstr(set, name) != 0
}

fn fresh_set_add(set: ptr, name: string) { avra_map_set_cstr(set, name, 1) }

fn fresh_set_remove(set: ptr, name: string) { avra_map_remove_cstr(set, name) }

/// The set's members as a plain list — for the specs, which assert on
/// membership, and for `analyze_return_ownership`'s list-shaped API.
export fn fresh_set_names(set: ptr) -> List<string> {
    let empty: List<string> = []
    if set == null { return empty }
    avra_map_keys_cstr(set)
}

/// Names of functions whose every return path yields a freshly
/// allocated value the CALLER may own. Seeded optimistically from the
/// declared functions, then shrunk to a fixpoint.
export fn analyze_return_ownership(store: NodeStore, body: List<StmtId>) -> List<string> {
    fresh_set_names(analyze_return_ownership_set(store, body))
}

/// The same analysis, handing back the SET itself. This is what codegen
/// stores in `Ctx.rc_fresh_fns`: membership is asked once per call-site
/// initializer across the whole program, which on a list was the other
/// half of the quadratic cost.
export fn analyze_return_ownership_set(store: NodeStore, body: List<StmtId>) -> ptr {
    let cands = fresh_set_new()
    seed_fn_candidates(store, body, cands, "")
    // A local binding or parameter can SHADOW a function name (legal
    // since zo1a, and the binding wins lexically), so `make()` at a use
    // site may be calling a closure rather than the function this
    // analysis measured. We cannot tell the two apart from the callee
    // `.Ident` alone, so any name that is ever bound as a local or a
    // parameter anywhere loses its candidacy. Crude, and deliberately
    // so: the cost is a leak left unfixed, never an over-release.
    let bound = fresh_set_new()
    collect_bound_names(store, body, bound)
    drop_bound_names(cands, bound)
    fixpoint_return_fresh(store, body, cands)
    cands
}

/// Seed every declared function as a candidate, under BOTH the bare
/// name and the resolver's canonical path.
///
/// Both forms are needed because a call site can arrive either way. The
/// resolver's `rewrite_ident` (resolve/names.av, "sibling in current
/// module") rewrites a call to a same-module function into
/// `Expr.QualifiedIdent("<mod>::<fn>")` whenever the caller sits inside a
/// module — which every test file and every real multi-module program
/// does. Seeding only the bare name made the whole analysis inert on
/// exactly those programs: the set was populated, but no call site ever
/// matched it.
///
/// The canonical form is built with `type_qualified_name` — the SAME
/// function the resolver uses to build `ModuleItemEntry.canonical` — so
/// the two cannot drift into a silent miss.
fn seed_fn_candidates(store: NodeStore, ids: List<StmtId>, set: ptr, mod_path: string) {
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Function(name, _, _, _, _) -> { add_fn_keys(set, mod_path, name) }
            .Block(inner) -> { seed_fn_candidates(store, inner, set, mod_path) }
            // A `mod` body holds declarations too, and nesting extends the
            // path exactly as the resolver extends it.
            .Module(mname, inner) -> {
                seed_fn_candidates(store, inner, set, type_qualified_name(mod_path, mname))
            }
            _ -> {}
        }
    }
}

/// Add both lookup keys for one function. They are added and removed as
/// a PAIR — dropping only one would leave a call site that uses the other
/// form still believing the callee is fresh, which is the over-release
/// direction.
fn add_fn_keys(set: ptr, mod_path: string, name: string) {
    fresh_set_add(set, name)
    let q = canonical_fn_key(mod_path, name)
    if q != name { fresh_set_add(set, q) }
}

/// Remove both lookup keys for one function.
fn drop_fn_keys(set: ptr, mod_path: string, name: string) {
    fresh_set_remove(set, name)
    let q = canonical_fn_key(mod_path, name)
    if q != name { fresh_set_remove(set, q) }
}

/// The canonical key for a declared function.
///
/// A `.Function` name is ALREADY fully qualified once the resolver has run,
/// and this analysis runs on the resolved tree in the compile path. Blindly
/// prefixing the enclosing module then produced doubled garbage —
/// `@std::avrac::parse::@std::avrac::parse::parse_match_stmt` — a key no call
/// site can ever match, observed directly in a dump of the real @std::avrac
/// set. Only qualify a name that is not already qualified. (The unresolved
/// tree the specs feed in still needs the prefix, which is why this is not
/// simply dropped.)
fn canonical_fn_key(mod_path: string, name: string) -> string {
    if name.contains("::") { return name }
    type_qualified_name(mod_path, name)
}

/// Every name bound as a local or a parameter anywhere in the program.
fn collect_bound_names(store: NodeStore, ids: List<StmtId>, set: ptr) {
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Let(n, _, init) -> {
                fresh_set_add(set, n)
                collect_bound_in_expr(store, store.exprs.get(init), set)
            }
            .Mut(n, _, init) -> {
                fresh_set_add(set, n)
                collect_bound_in_expr(store, store.exprs.get(init), set)
            }
            .Const(n, _, init) -> {
                fresh_set_add(set, n)
                collect_bound_in_expr(store, store.exprs.get(init), set)
            }
            // `let (a, b) = ...` binds EVERY name in the pattern.
            .LetDestructure(names, init) -> {
                for pe in names { fresh_set_add(set, pe.name) }
                collect_bound_in_expr(store, store.exprs.get(init), set)
            }
            // Match arms are expressions and can bind/shadow inside.
            .Match(_, arms) -> {
                for arm in arms {
                    collect_bound_in_expr(store, store.exprs.get(arm.body_id), set)
                }
            }
            .Expr(e) -> { collect_bound_in_expr(store, store.exprs.get(e), set) }
            .Return(e) -> { collect_bound_in_expr(store, store.exprs.get(e), set) }
            .Function(_, _, params, _, fbody) -> {
                for p in params { fresh_set_add(set, p.name) }
                collect_bound_names(store, fbody, set)
            }
            .Block(inner) -> { collect_bound_names(store, inner, set) }
            .Module(_, inner) -> { collect_bound_names(store, inner, set) }
            // Statement CONTAINERS whose bodies hold ordinary locals. Methods
            // are reached by declare_functions / emit_function_bodies, and
            // spec/given bodies bind locals like any block — stopping at the
            // wildcard made every one of those invisible to shadow detection,
            // so a local shadowing a fn name left that fn wrongly fresh
            // (caught in review on #1174).
            .Impl(_, methods) -> { collect_bound_names(store, methods, set) }
            .SpecBlock(_, sbody) -> { collect_bound_names(store, sbody, set) }
            .GivenBlock(_, gbody) -> { collect_bound_names(store, gbody, set) }
            .If(_, tb, eb) -> {
                collect_bound_names(store, [tb], set)
                // else_branch is StmtId? — an `if` with no `else` has none.
                if eb != null { collect_bound_names(store, [eb!], set) }
            }
            .While(_, wb) -> { collect_bound_names(store, [wb], set) }
            .For(v, _, _, fb) -> {
                fresh_set_add(set, v)
                collect_bound_names(store, [fb], set)
            }
            .ForIn(v, _, fib) -> {
                fresh_set_add(set, v)
                collect_bound_names(store, [fib], set)
            }
            _ -> {}
        }
    }
}

/// Names bound inside an EXPRESSION — lambda parameters, and locals
/// declared in value-position blocks / if-expressions / match arms. A
/// shadowing binder anywhere must drop the function name, because at a
/// call site `mk()` may resolve to the local rather than the function.
fn collect_bound_in_expr(store: NodeStore, expr: Expr, set: ptr) {
    match expr {
        .Lambda(params, body) -> {
            for p in params { fresh_set_add(set, p.name) }
            collect_bound_in_expr(store, store.exprs.get(body), set)
        }
        .Block(stmts) -> { collect_bound_names(store, stmts, set) }
        .IfExpr(_, a, b) -> {
            collect_bound_in_expr(store, store.exprs.get(a), set)
            collect_bound_in_expr(store, store.exprs.get(b), set)
        }
        .MatchExpr(_, arms) -> {
            for arm in arms { collect_bound_in_expr(store, store.exprs.get(arm.body_id), set) }
        }
        _ -> {}
    }
}

/// Remove every shadowed name from the candidate set.
fn drop_bound_names(cands: ptr, bound: ptr) {
    // Snapshot the keys first — removing while iterating the live map
    // would be reading a container as it is mutated.
    for n in fresh_set_names(cands) {
        if fresh_set_has(bound, n) { fresh_set_remove(cands, n) }
    }
}

/// Iterate `refine_return_fresh` until the candidate set is stable.
/// Every pass only shrinks it, so this terminates.
fn fixpoint_return_fresh(store: NodeStore, body: List<StmtId>, cands: ptr) {
    // Settles on whether a pass DROPPED anything rather than by
    // comparing the before/after sets: `copy_set_eq` was O(n^2) per
    // pass on top of an already-quadratic pass. The termination
    // argument is unchanged and now direct — a pass either removes at
    // least one key, or reports no change and ends.
    mut changed = true
    while changed { changed = refine_return_fresh(store, body, cands, "") }
}

/// One shrink pass: drop any candidate with a return path that does
/// not yield a fresh allocation.
fn refine_return_fresh(store: NodeStore, ids: List<StmtId>, cands: ptr, mod_path: string) -> bool {
    mut changed = false
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Function(name, _, _, _, fbody) -> {
                // Guarded on the BARE key, which two modules declaring the
                // same short name share. One module's non-fresh `f` therefore
                // drops the bare key both were using — a LEAK left unfixed for
                // the other, never an over-release. Canonical keys stay
                // independent, and the resolver qualifies same-module calls,
                // so the shared bare key is only consulted by top-level callers.
                if fresh_set_has(cands, name) && !fn_returns_fresh(store, fbody, cands) {
                    drop_fn_keys(cands, mod_path, name)
                    changed = true
                }
            }
            .Block(inner) -> { if refine_return_fresh(store, inner, cands, mod_path) { changed = true } }
            .Module(mname, inner) -> {
                if refine_return_fresh(store, inner, cands, type_qualified_name(mod_path, mname)) { changed = true }
            }
            _ -> {}
        }
    }
    changed
}

/// True when EVERY return path of this body yields a fresh allocation:
/// each explicit `return` anywhere inside it, plus the body's tail
/// expression (Avra returns the last expression implicitly).
fn fn_returns_fresh(store: NodeStore, body: List<StmtId>, cands: ptr) -> bool {
    for e in collect_return_exprs(store, body) {
        if !expr_is_fresh(store, store.exprs.get(e), cands) { return false }
    }
    tail_is_fresh(store, body, cands)
}

/// Every explicitly-returned expression, recursing through control flow.
/// A bare `return` (ReturnEmpty) yields nothing to own, so it is not
/// collected — a unit return can never be a releasable binding.
fn collect_return_exprs(store: NodeStore, ids: List<StmtId>) -> List<ExprId> {
    mut out: List<ExprId> = []
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Return(v) -> { out = list_push_copy(out, v) }
            .Block(inner) -> { for e in collect_return_exprs(store, inner) { out = list_push_copy(out, e) } }
            .If(_, tb, eb) -> {
                for e in collect_return_exprs(store, [tb]) { out = list_push_copy(out, e) }
                if eb != null {
                    for e in collect_return_exprs(store, [eb!]) { out = list_push_copy(out, e) }
                }
            }
            .While(_, wb) -> { for e in collect_return_exprs(store, [wb]) { out = list_push_copy(out, e) } }
            .For(_, _, _, fb) -> { for e in collect_return_exprs(store, [fb]) { out = list_push_copy(out, e) } }
            .ForIn(_, _, fib) -> { for e in collect_return_exprs(store, [fib]) { out = list_push_copy(out, e) } }
            // A `return` inside a match ARM is a return path too. Without
            // this the arm was never examined, so `fn f(a) { match c {
            // true -> { return a } ... } }` was judged fresh — an
            // over-release. Arm bodies are expressions, so a `return`
            // inside one appears as a Block statement within it.
            .Match(_, arms) -> {
                for arm in arms {
                    for e in collect_return_exprs_in_expr(store, store.exprs.get(arm.body_id)) {
                        out = list_push_copy(out, e)
                    }
                }
            }
            // A nested function's returns belong to IT, not to us.
            .Function(_, _, _, _, _) -> {}
            _ -> {}
        }
    }
    out
}

/// `return` expressions reachable from inside an EXPRESSION — match arm
/// bodies and value-position blocks hold statements, and a `return` in
/// one belongs to the enclosing function.
fn collect_return_exprs_in_expr(store: NodeStore, expr: Expr) -> List<ExprId> {
    mut out: List<ExprId> = []
    match expr {
        .Block(stmts) -> { for e in collect_return_exprs(store, stmts) { out = list_push_copy(out, e) } }
        .IfExpr(_, a, b) -> {
            for e in collect_return_exprs_in_expr(store, store.exprs.get(a)) { out = list_push_copy(out, e) }
            for e in collect_return_exprs_in_expr(store, store.exprs.get(b)) { out = list_push_copy(out, e) }
        }
        .MatchExpr(_, arms) -> {
            for arm in arms {
                for e in collect_return_exprs_in_expr(store, store.exprs.get(arm.body_id)) {
                    out = list_push_copy(out, e)
                }
            }
        }
        // A lambda's returns belong to the LAMBDA, not to us.
        _ -> {}
    }
    out
}

/// The implicit return: a body whose last statement is an expression
/// hands that expression back. A body ending in anything else (a
/// `return` already collected above, a decl, a loop) has no tail value,
/// which is vacuously fine.
fn tail_is_fresh(store: NodeStore, body: List<StmtId>, cands: ptr) -> bool {
    if body.length == 0 { return true }
    match stmt_unwrap(store, store.stmts.get(body.get(body.length - 1))) {
        .Expr(e) -> expr_is_fresh(store, store.exprs.get(e), cands)
        .Block(inner) -> tail_is_fresh(store, inner, cands)
        // An `if` or `match` in TAIL position is the implicit return,
        // and it arrives as a STATEMENT — `Stmt.If` / `Stmt.Match`, not
        // `Expr.IfExpr` / `Expr.MatchExpr`. Missing these was a real
        // over-release: they fell to the catch-all below, which answers
        // "no non-fresh path found", so a function whose else-branch
        // returned a PARAM was marked fresh. Caught by the branch specs
        // in codegen/tests/return_ownership_test.av. Every branch is a
        // return path, so every branch must be fresh.
        .If(_, tb, eb) -> {
            // No `else` means one path yields no value at all; deny
            // rather than reason about it.
            if eb == null { return false }
            tail_is_fresh(store, [tb], cands) && tail_is_fresh(store, [eb!], cands)
        }
        .Match(_, arms) -> {
            for arm in arms {
                if !expr_is_fresh(store, store.exprs.get(arm.body_id), cands) { return false }
            }
            true
        }
        // Anything else in tail position produces no value — a decl, a
        // loop, a `return` already collected above — so the function
        // yields unit and there is no ownership claim to get wrong.
        // (`Ctx.bind` gates on `vtype_is_ptr_type` anyway.)
        _ -> true
    }
}

/// Does this expression produce a value the caller may own?
///
/// The catch-all answers FALSE, and that is the load-bearing line in
/// this file: params, field reads, globals, method calls, indexing,
/// `dyn` dispatch and `.QualifiedIdent` cross-module calls all land
/// there. Adding a `true` arm here without proving the callee allocates
/// is how this becomes a double-free.
/// True when `e` may be stored in a returned composite WITHOUT the caller
/// later over-releasing it.
///
/// The distinction this draws is the one `expr_is_fresh` used to miss.
/// `__release_<T>` is RECURSIVE: releasing a returned struct also releases
/// its fields. A field initialized from a param / capture / global / field
/// read is a BORROWED alias, and the callee does NOT retain it — the retain
/// at struct_decl/codegen.av:153 is gated on `ctx.alias_retain_scope`, which
/// is set only for a releasable BINDING's initializer (let_stmt/codegen.av:52)
/// and is false for a RETURNED literal, exactly as the comment there states.
///
/// So `fn gitem(prim: GPrim) -> GItem { GItem { …, prim, … } }` returns a
/// fresh BOX holding a borrowed FIELD. Admitting it means the caller's
/// `let it = gitem(p)` recursively releases `p`, dropping a tick that was
/// never added. That is the grammar-tree corruption (t-k6lm).
///
/// Scalar literals are owned outright. Anything else must be fresh in its
/// own right. A bare `.Ident` is denied even when it names a fresh local:
/// this analysis has no per-name ownership state, and the safe direction is
/// a leak.
fn init_is_owned(store: NodeStore, e: Expr, cands: ptr) -> bool {
    match e {
        .Number(_) -> true
        .FloatLit(_) -> true
        // A string LITERAL is NOT an allocation the holder owns, so the
        // recursive `__release_<T>` would free a pointer this struct never
        // took a tick on. Every other literal here is a SCALAR — no ptr
        // field, nothing to release — so `.String` is the only arm of this
        // match that can misfire, and the only one that needs denying.
        //
        // Measured (t-k6lm): `error_def` (diagnostics) returns
        // `ErrorDef { code: "F0001", help: "…" }` from every match arm. With
        // `true` here, all-literal arms made the fn FRESH, which made
        // `lang_gen::render_one_diag`'s `let def = error_def(code)`
        // RELEASABLE — the single releasable local the fresh set adds across
        // the whole @std::avrac lib build — and its release freed the two
        // literals. Denying is the leak direction, which is this analysis's
        // stated bias: "the cost is a leak left unfixed, never an
        // over-release".
        .String(_) -> false
        .Bool(_) -> true
        .None -> true
        _ -> expr_is_fresh(store, e, cands)
    }
}

fn field_inits_all_owned(store: NodeStore, inits: List<FieldInit>, cands: ptr) -> bool {
    mut i = 0
    while i < inits.length {
        if !init_is_owned(store, store.exprs.get(inits[i].value_id), cands) { return false }
        i = i + 1
    }
    true
}

fn arg_ids_all_owned(store: NodeStore, args: List<ExprId>, cands: ptr) -> bool {
    mut i = 0
    while i < args.length {
        if !init_is_owned(store, store.exprs.get(args[i]), cands) { return false }
        i = i + 1
    }
    true
}

fn expr_is_fresh(store: NodeStore, expr: Expr, cands: ptr) -> bool {
    match expr {
        // The BOX is fresh, but a release reaches its FIELDS — see
        // `init_is_owned`. An unconditional `true` here was the over-release.
        .StructLit(_, inits) -> field_inits_all_owned(store, inits, cands)
        .EnumCtor(_, _, args) -> arg_ids_all_owned(store, args, cands)
        .Tuple(elems) -> arg_ids_all_owned(store, elems, cands)
        // `with` RETAINS the base's ptr fields unconditionally (see
        // with_expr/codegen.av), so the base may alias; the OVERRIDES go
        // through the same gated retain as struct fields, so they may not.
        .With(_, inits) -> field_inits_all_owned(store, inits, cands)
        // Only a DIRECT call to a known-fresh function in this module.
        .Call(callee, _) -> {
            match store.exprs.get(callee) {
                .Ident(n) -> fresh_set_has(cands, n)
                // The resolver qualifies same-module calls, so this form is
                // the COMMON one inside any module. Membership is an EXACT
                // match against a canonical key this analysis seeded itself,
                // so a foreign module's path can never match — a cross-module
                // `@pkg::other::mk` whose last segment happens to collide
                // stays denied, as the ticket requires.
                .QualifiedIdent(p) -> fresh_set_has(cands, p)
                _ -> false
            }
        }
        // A value-position block/if/match hands back its own tails, so
        // every arm must be fresh for the whole to be.
        .Block(stmts) -> tail_is_fresh(store, stmts, cands)
        .IfExpr(_, a, b) -> expr_is_fresh(store, store.exprs.get(a), cands)
                         && expr_is_fresh(store, store.exprs.get(b), cands)
        .MatchExpr(_, arms) -> {
            for arm in arms {
                if !expr_is_fresh(store, store.exprs.get(arm.body_id), cands) { return false }
            }
            true
        }
        _ -> false
    }
}
