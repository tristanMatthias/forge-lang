// Per-fn CGU object-cache oracle (ps3t.8.6.1 increment 4). The incremental
// win: build_binary_cgu caches each fn's .o keyed on its content fingerprint,
// so a rebuild reuses unchanged fns' objects and a one-fn edit re-emits ONLY
// that fn. Two invariants:
//   * cold → warm: rebuilding the unchanged program EMITS NOTHING (every fn is
//     a cache hit) and runs identically;
//   * one-fn blast radius: editing exactly one fn's BODY (no type change)
//     re-emits exactly ONE fn — that fn — while every other fn hits; the
//     linked binary reflects the edit.
//
// OBSERVABLE = EMISSIONS, not artifacts. build_binary_cgu writes a per-build
// `<stem>.fnN.o` only when it EMITS; a hit reuses the stored object and writes
// nothing. Counting `<stem>.fn*.o` is therefore the exact miss count. (The
// art-store entry count would NOT work: fn_unit_publish is content-addressed,
// so a re-emit of unchanged content dedupes to the same artifact — a disabled
// cache and a working one would look identical. This distinction was found by
// the /prepare-pr mutation check.) Isolated project_dir under /tmp with
// runtime.o + llvm_wrapper.o copied in for linking.
//
// @@fixture-stateful@@ — links + runs real binaries; a transient hiccup must
// re-probe, not freeze as FAIL.

use @std.avrac.core.{ avra_shell_exec, avra_getpid }
use @std.avrac.parse.{parse_program_source}
use @std.avrac.build.{build_binary_cgu, CompileTarget}

fn repo_root() -> string { avra_shell_exec("pwd").trim() }

fn mk_target(src: string, dir: string, bin: string) -> CompileTarget? {
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return null }
    CompileTarget {
        program: r.ids!,
        bin_path: "${dir}/${bin}",
        project_dir: dir,
        diag_filename: "prog.av",
        coverage: false,
        extra_objs: [],
        store: r.store,
    }
}

/// Build `src` via the CGU path into `dir/bin` and run it; "" on build error.
fn build_run(src: string, dir: string, bin: string) -> string {
    let t = mk_target(src, dir, bin)
    if t == null { return "parsefail" }
    match build_binary_cgu(t!) {
        .Ok(_) -> {}
        .Err(e) -> { return "builderr:${e}" }
    }
    avra_shell_exec("'${dir}/${bin}' 2>&1").trim()
}

/// The number of fns this build actually EMITTED (cache MISSES). build_binary_cgu
/// writes a per-build `<stem>.fnN.o` ONLY when it emits — a hit reuses the
/// content-addressed store object and writes nothing. So counting `<stem>.fn*.o`
/// for a given build's bin stem is the exact miss count — the observable that
/// distinguishes a real cache HIT (skip emission) from a content-addressed
/// re-emit-then-dedup (which the art-store count could NOT tell apart).
fn emitted_count(dir: string, stem: string) -> string {
    avra_shell_exec("ls '${dir}/${stem}'.fn*.o 2>/dev/null | wc -l").trim()
}

spec "per-fn CGU cache: warm rebuild is a no-op; a one-fn edit re-emits only that fn" {
    then "cold→warm publishes nothing new; editing add re-emits ONLY add" {
        let dir = "/tmp/avra_cgucache_${string(avra_getpid())}"
        avra_shell_exec("rm -rf '${dir}' && mkdir -p '${dir}/build'")
        // Isolated build dir needs the runtime objects to link against.
        avra_shell_exec("cp '${repo_root()}/build/runtime.o' '${repo_root()}/build/llvm_wrapper.o' '${dir}/build/'")

        // v1: twice(20) = add(20,20) = 40; +2 = 42.
        let v1 = "fn add(a: int, b: int) -> int { a + b }\nfn twice(x: int) -> int { add(x, x) }\nprintln(string(twice(20) + 2))\n"
        let out1 = build_run(v1, dir, "b1.bin")
        let cold = emitted_count(dir, "b1")   // COLD: every fn emitted (all misses)

        // Warm: same source, fresh parse → every fn is a cache HIT, emit NOTHING.
        let out2 = build_run(v1, dir, "b2.bin")
        let warm = emitted_count(dir, "b2")

        // v2: edit ONLY add's body (a+b → a+b+100, no type change). twice's IR
        // is unchanged (it just calls @add) → cache hit; only add re-emits.
        // twice(20) = 20+20+100 = 140; +2 = 142.
        let v2 = "fn add(a: int, b: int) -> int { a + b + 100 }\nfn twice(x: int) -> int { add(x, x) }\nprintln(string(twice(20) + 2))\n"
        let out3 = build_run(v2, dir, "b3.bin")
        let edited = emitted_count(dir, "b3")

        let ok = out1 == "42" && out2 == "42" && out3 == "142"
            && cold != "0"    // cold build emitted every fn
            && warm == "0"    // warm rebuild emitted NOTHING — every fn a cache hit
            && edited == "1"  // a one-fn edit re-emitted EXACTLY one fn (add), the rest hit
        if !ok {
            println("cgu-cache: out1=${out1} out2=${out2} out3=${out3} cold_emit=${cold} warm_emit=${warm} edit_emit=${edited}")
        }
        avra_shell_exec("rm -rf '${dir}'")
        ok
    }
}
