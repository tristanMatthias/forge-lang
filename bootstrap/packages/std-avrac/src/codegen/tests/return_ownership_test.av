// t-k6lm slice 1 — the RETURN-OWNERSHIP analysis, tested in isolation
// BEFORE it is wired to anything.
//
// WHY this is its own slice: `let x = make_thing()` leaks when the
// callee returns a struct or enum, because `is_allocating_expr`
// whitelists only the literal forms so a `.Call` initializer never
// enters the releasable set. The fix is to admit a call whose CALLEE is
// known to return a fresh allocation — and the whole risk of the fix
// lives in that predicate. Admitting one callee too many is not a
// leak, it is an over-release DOUBLE FREE (the t-c6y7 / #911 class),
// because a callee may hand back a field of its receiver, one of its
// params, or a global.
//
// So the predicate is landed and proven first, as dead code. Nothing
// calls `analyze_return_ownership` yet, so this slice cannot change
// emitted IR; the wiring (and its `intended-ir-change` label) is the
// next one. That ordering means a mistake here shows up as a red spec
// rather than as memory corruption in the wiring slice.
//
// The arms that matter most are the NEGATIVE ones. A predicate that
// says "fresh" too often is the dangerous direction, so most of these
// specs assert a function is NOT in the set.

use @std.avrac.parse.{parse_program_source}
use @std.avrac.core.{stmt_unwrap}
use @std.avrac.codegen.{analyze_return_ownership, analyze_releasable, analyze_return_ownership_set}

/// Sentinel injected when a fixture fails to parse. See `not_fresh`.
const PARSE_FAILED: string = "<parse-failed>"

/// Parse `src` and return the set of functions whose every return path
/// yields a freshly allocated value.
fn fresh_set(src: string) -> List<string> {
    let p = parse_program_source(src)
    let ids = p.ids
    if ids == null { return [PARSE_FAILED] }
    analyze_return_ownership(p.store, ids!)
}

fn has(set: List<string>, name: string) -> bool {
    for n in set { if n == name { return true } }
    false
}

/// Assert `name` is NOT fresh — and that the fixture actually PARSED.
///
/// Every negative arm in this file must go through here. A bare
/// `!has(fresh_set(src), name)` passes vacuously when `src` fails to
/// parse, because the empty set satisfies it: the guard would be
/// unable to fail, which is the exact defect this file exists to
/// prevent elsewhere. Note a bare sentinel does NOT fix that on its
/// own — `!has(["<parse-failed>"], "wrap")` is still true — so the
/// sentinel has to be CHECKED, which is what this helper does.
fn not_fresh(src: string, name: string) -> bool {
    let s = fresh_set(src)
    !has(s, PARSE_FAILED) && !has(s, name)
}

/// Assert `name` IS fresh. Can't pass vacuously — an empty or
/// sentinel-only set fails it — so it needs no extra guard.
fn is_fresh(src: string, name: string) -> bool {
    has(fresh_set(src), name)
}

/// The RELEASABLE set of the fn named `fname` in `src` — the bindings
/// whose scope exit emits a recursive `__release`. This is the other
/// half of the analysis: `fresh_set` says which FUNCTIONS hand back a
/// fresh value, this says which LOCALS this frame still owns at exit.
fn releasables_of(src: string, fname: string) -> List<string> {
    let p = parse_program_source(src)
    let ids = p.ids
    if ids == null { return [PARSE_FAILED] }
    let fresh = analyze_return_ownership_set(p.store, ids!)
    for sid in ids! {
        match stmt_unwrap(p.store, p.store.stmts.get(sid)) {
            .Function(n, _, _, _, body) -> {
                if n == fname { return analyze_releasable(p.store, body, fresh) }
            }
            _ -> {}
        }
    }
    [PARSE_FAILED]
}

/// Assert `name` is NOT releasable in `fname`, non-vacuously (see `not_fresh`).
fn not_releasable(src: string, fname: string, name: string) -> bool {
    let s = releasables_of(src, fname)
    !has(s, PARSE_FAILED) && !has(s, name)
}

/// Assert `name` IS releasable — the positive control for the arm above.
fn is_releasable(src: string, fname: string, name: string) -> bool {
    has(releasables_of(src, fname), name)
}

const PRELUDE: string = "type T = { v: int }\ntype Inner = { n: int }\ntype Holder = { inner: Inner }\n"

spec "t-k6lm return-ownership: fresh producers" {
    given "functions that allocate their own result" {
        then "a struct literal return is fresh" {
            is_fresh(PRELUDE + "fn mk() -> T { T { v: 1 } }\n", "mk")
        }
        then "an explicit `return` of a struct literal is fresh" {
            is_fresh(PRELUDE + "fn mk() -> T { return T { v: 1 } }\n", "mk")
        }
        then "a `with` result is fresh" {
            is_fresh(PRELUDE + "fn upd(t: T) -> T { t with { v: 2 } }\n", "upd")
        }
        then "a tuple is fresh" {
            is_fresh("fn pair() -> (int, int) { (1, 2) }\n", "pair")
        }
        then "a call to another fresh fn is fresh — the property composes" {
            let s = fresh_set(PRELUDE + "fn mk() -> T { T { v: 1 } }\nfn wrap() -> T { mk() }\n")
            has(s, "mk") && has(s, "wrap")
        }
    }
}

spec "t-k6lm return-ownership: the dangerous negatives" {
    given "functions that hand back something they do not own" {
        then "returning a PARAM is not fresh — the caller still owns it" {
            not_fresh(PRELUDE + "fn pick(a: T) -> T { a }\n", "pick")
        }
        then "returning a FIELD of a param is not fresh — the receiver owns it" {
            not_fresh(PRELUDE + "fn get(h: Holder) -> Inner { h.inner }\n", "get")
        }
        then "returning a LOCAL is not fresh — it is an alias, not a new value" {
            // The local's own allocation is already tracked by the
            // existing releasable path; handing it out makes it escape.
            not_fresh(PRELUDE + "fn esc() -> T { let t = T { v: 1 }\n t }\n", "esc")
        }
        then "ONE non-fresh path poisons the whole function" {
            // The `if` returns a param on one side. A predicate that
            // looked only at the tail, or only at the first `return`,
            // would wrongly call this fresh.
            not_fresh(PRELUDE + "fn maybe(a: T, c: bool) -> T { if c { return a }\n T { v: 0 } }\n", "maybe")
        }
        then "a call to a NON-fresh fn is not fresh — non-freshness propagates" {
            let s = fresh_set(PRELUDE + "fn pick(a: T) -> T { a }\nfn wrap(a: T) -> T { pick(a) }\n")
            !has(s, PARSE_FAILED) && !has(s, "pick") && !has(s, "wrap")
        }
        then "an unknown/undeclared callee is not fresh — the catch-all denies" {
            not_fresh(PRELUDE + "fn wrap() -> T { mystery() }\n", "wrap")
        }
        then "a `return` inside a match ARM poisons the function too" {
            // Twin of the `if` case above. `collect_return_exprs` has to
            // walk Stmt.Match arms or this path is never examined, and
            // the fn is judged fresh — an over-release.
            not_fresh(PRELUDE + "fn maybe(a: T, c: bool) -> T { match c { true -> { return a }\n false -> {} }\n T { v: 0 } }\n", "maybe")
        }
        then "a method call is not fresh — the receiver may own the result" {
            not_fresh(PRELUDE + "fn wrap(h: Holder) -> Inner { h.get_inner() }\n", "wrap")
        }
    }
}

spec "t-k6lm return-ownership: branch and recursion shapes" {
    given "control flow in return position" {
        then "an if-EXPRESSION is fresh only when BOTH arms are" {
            let both = fresh_set(PRELUDE + "fn f(c: bool) -> T { if c { T { v: 1 } } else { T { v: 2 } } }\n")
            has(both, "f") && not_fresh(PRELUDE + "fn g(c: bool, a: T) -> T { if c { T { v: 1 } } else { a } }\n", "g")
        }
        then "a match expression is fresh only when EVERY arm is" {
            let all = fresh_set(PRELUDE + "fn f(c: bool) -> T { match c { true -> T { v: 1 }\n false -> T { v: 2 } } }\n")
            has(all, "f") && not_fresh(PRELUDE + "fn g(c: bool, a: T) -> T { match c { true -> T { v: 1 }\n false -> a } }\n", "g")
        }
        then "self-recursion keeps candidacy when the base case is fresh" {
            // Every value this can actually return IS a fresh T, so
            // optimistic seeding gives the right answer here.
            is_fresh(PRELUDE + "fn f(c: bool) -> T { if c { return f(false) }\n T { v: 1 } }\n", "f")
        }
        then "self-recursion loses it when the base case is a param" {
            not_fresh(PRELUDE + "fn f(a: T, c: bool) -> T { if c { return f(a, false) }\n a }\n", "f")
        }
        then "an ANNOTATED tail is denied, not waved through" {
            // `.Annotated` never reaches the catch-alls in this file:
            // `stmt_unwrap` strips it recursively (core/ast.av:2272-2277)
            // and every traversal here calls it first. The redundant
            // `.Annotated` arm in `single_pass_stmt` is dead code, not
            // evidence to the contrary.
            //
            // Honest about the strength of this arm: it does NOT isolate
            // the annotated path, because the answer is "denied" whether
            // or not the annotation attaches. It is a cheap regression
            // guard on the outcome, and the claim it backs rests on the
            // `stmt_unwrap` reading above.
            not_fresh(PRELUDE + "fn f(a: T) -> T {\n@inline\n a }\n", "f")
        }
        then "mutual recursion through a non-fresh fn is rejected" {
            // f -> g -> param. The fixpoint must carry g's drop back to
            // f; a single pass in the wrong order would keep f.
            let s = fresh_set(PRELUDE + "fn f(a: T) -> T { g(a) }\nfn g(a: T) -> T { a }\n")
            !has(s, PARSE_FAILED) && !has(s, "f") && !has(s, "g")
        }
    }
}

spec "t-k6lm return-ownership: shadowing is conservatively denied" {
    given "a function name also used as a local or parameter" {
        then "a fn shadowed by a local loses candidacy" {
            // `let mk = ...` then `mk()` calls the LOCAL (legal since
            // zo1a, and the binding wins lexically). The callee `.Ident`
            // cannot distinguish the two, so the fn name is dropped —
            // costing a leak left unfixed rather than an over-release.
            not_fresh(PRELUDE + "fn mk() -> T { T { v: 1 } }\nfn other() -> int { let mk = 3\n mk }\n", "mk")
        }
        then "a fn shadowed by a LAMBDA PARAMETER loses candidacy" {
            // Binders inside expressions shadow too. Without the
            // expression-level walker the lambda's param was invisible.
            not_fresh(PRELUDE + "fn mk() -> T { T { v: 1 } }\nfn other() -> int { let f = (mk: int) -> mk\n 0 }\n", "mk")
        }
        then "a fn shadowed inside a MATCH ARM body loses candidacy" {
            not_fresh(PRELUDE + "fn mk() -> T { T { v: 1 } }\nfn other(c: bool) -> int { match c { true -> { let mk = 3\n mk }\n false -> 0 } }\n", "mk")
        }
        then "a fn shadowed by a DESTRUCTURING bind loses candidacy" {
            not_fresh(PRELUDE + "fn mk() -> T { T { v: 1 } }\nfn other() -> int { let (mk, z) = (1, 2)\n z }\n", "mk")
        }
        then "an unshadowed sibling in the same program keeps its candidacy" {
            // Positive control for the arm above: proves the shadowing
            // rule is targeted, not a blanket denial of everything.
            is_fresh(PRELUDE + "fn mk() -> T { T { v: 1 } }\nfn other() -> int { let z = 3\n z }\n", "mk")
        }
    }
}

spec "t-k6lm releasable set: a CALL ARGUMENT carries a local's parts out of the frame" {
    given "a local whose field is handed to a callee whose result is returned" {
        then "the local loses candidacy — the callee may RETAIN what it was passed" {
            // The `db_for` shape (query_passes_test): `pass_db_new(…, parsed.store, …)`
            // stores `parsed.store` inside the returned `Db`, so releasing
            // `parsed` at scope exit frees a store the caller still reads
            // through. The composite arms miss this because the escape route
            // is a CALL, not a literal.
            not_releasable(PRELUDE + "fn keep(i: Inner) -> Holder { Holder { inner: i } }\nfn db(h: Holder) -> Holder { let p = Holder { inner: Inner { n: 1 } }\n return keep(p.inner) }\n", "db", "p")
        }
        then "a field behind `??` escapes too" {
            // `parsed.ids ?? []` hands back `parsed.ids` on the non-null path.
            not_releasable(PRELUDE + "fn keep(i: Inner) -> Holder { Holder { inner: i } }\nfn db(x: Inner?) -> Holder { let p = Holder { inner: Inner { n: 1 } }\n return keep(p.inner ?? Inner { n: 0 }) }\n", "db", "p")
        }
        then "a returned METHOD CALL on a local escapes its receiver" {
            // `p.m()` may hand back a field of `p`, exactly as `p.f` does, so
            // the CALLEE half of a call is an escape route too.
            not_releasable(PRELUDE + "fn db() -> Inner { let p = Holder { inner: Inner { n: 1 } }\n return p.get() }\ntype H2 = { x: int }\n", "db", "p")
        }
        then "a DISCARDED tail call does NOT cost the local its candidacy" {
            // The boundary of the rule above, and the reason it is limited to
            // explicit returns: `collect_tail_exprs` yields the last STATEMENT,
            // whose value is usually discarded. `println(string(p.inner.n))`
            // ending a void fn retains nothing, so treating it as an escape
            // leaks `p` — difftest_corpus/collections.av caught exactly that.
            is_releasable(PRELUDE + "fn db() { let p = Holder { inner: Inner { n: 1 } }\n println(string(p.inner.n)) }\n", "db", "p")
        }
        then "a local passed NOWHERE keeps its candidacy" {
            // Positive control: proves the rule is targeted, not a blanket
            // denial of every local in a fn that happens to contain a call.
            is_releasable(PRELUDE + "fn side() -> int { 7 }\nfn db() -> int { let p = Holder { inner: Inner { n: 1 } }\n side() }\n", "db", "p")
        }
    }
}
