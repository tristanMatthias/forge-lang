// Write-side spec: a metadata package build publishes every emitted fn's
// IR into the package's build/cache/fnunits/ store — NO env flag. The
// cache root is threaded from the build driver (the package root), and the
// lib-root gate (fnunits.av) scopes publishing to a genuine package build
// (AVRA_LIB_PKG_ROOT set → non-empty ctx.lib_pkg_roots — exactly the path
// the compiler rebuilds itself through and the read side will accelerate):
//   * a metadata compile publishes units; a rerun of the unchanged package
//     dedupes to the SAME artifact set (content addressing), and
//   * a standalone whole-program `bs2 compile` leaves NO fnunits store —
//     it has empty lib roots and no per-package incremental story, so
//     publishing is a strict no-op (guards the "publish the inlined @std
//     into a stray /tmp store" waste+leak regression).
//
// @@fixture-stateful@@ — invokes the SHARED build/bs2; a transient
// environment hiccup must re-probe, not freeze as a permanent FAIL.

use @std.avrac.core.{
    avra_shell_exec, avra_shell_exec_status,
    avra_selfhost_write_file, avra_getpid,
}

fn bs2() -> string {
    avra_shell_exec("pwd").trim() + "/build/bs2"
}

// The package's fully-qualified module root. The metadata compile stamps
// this as both the fn-qualification prefix (--module_path) and the lib
// ownership root (AVRA_LIB_PKG_ROOT), so the package's own fns are emitted
// (not declare-only) and pass the publish gate.
fn pkg_qual() -> string { "@test::fnunits" }

/// Materialise a throwaway package dir under /tmp. Fresh per pid so probes
/// are shard-safe. Returns the package root.
fn mk_pkg() -> string {
    let dir = "/tmp/avra_fnunits_${string(avra_getpid())}"
    avra_shell_exec("rm -rf '${dir}' && mkdir -p '${dir}/src/build'")
    let _ = avra_selfhost_write_file("${dir}/src/lib.av",
        "export fn add(a: int, b: int) -> int { a + b }\nexport fn twice(x: int) -> int { add(x, x) }\n")
    dir
}

/// Run the metadata codegen path inside the package (the same shape as the
/// compiler's own @std/* package prebuild: AVRA_LIB_PKG_ROOT + --emit_metadata
/// + --module_path). Returns the shell exit status.
fn meta_compile(dir: string) -> int {
    avra_shell_exec_status(
        "cd '${dir}/src' && env -u AVRA_LIB_OBJS -u AVRA_COMPILER AVRA_USE_METADATA=1 AVRA_LIB_PKG_ROOT='${pkg_qual()}' '${bs2()}' compile --emit_metadata --module_path='${pkg_qual()}' lib.av > '${dir}/build.log' 2>&1")
}

spec "per-fn cache write side: metadata package build publishes always-on; standalone does not" {
    then "a metadata package build (no flag) publishes a pack + index; rerun is byte-identical" {
        let dir = mk_pkg()
        let rc1 = meta_compile(dir)
        // The lib-root gate hangs the store off the package cache root;
        // locate the index by find so the test is robust to the exact layout.
        let idx = avra_shell_exec("find '${dir}' -type f -path '*/fnunits/index' 2>/dev/null | head -1").trim()
        let store = avra_shell_exec("dirname '${idx}' 2>/dev/null").trim()
        let keys1 = avra_shell_exec("grep -c '^K ' '${idx}' 2>/dev/null").trim()
        let arts1 = avra_shell_exec("grep -c '^A ' '${idx}' 2>/dev/null").trim()
        let packs1 = avra_shell_exec("ls '${store}'/pack.* 2>/dev/null | wc -l").trim()
        let idxsum1 = avra_shell_exec("sha256sum '${idx}' 2>/dev/null | cut -d' ' -f1").trim()
        // A deterministic rerun re-hashes to the SAME content-addressed pack
        // (no orphan) and rewrites a byte-identical index — the dedup/
        // determinism guarantee the old per-file layout checked as counts.
        let rc2 = meta_compile(dir)
        let idxsum2 = avra_shell_exec("sha256sum '${idx}' 2>/dev/null | cut -d' ' -f1").trim()
        let packs2 = avra_shell_exec("ls '${store}'/pack.* 2>/dev/null | wc -l").trim()
        let ok = rc1 == 0 && rc2 == 0
            && idx.length > 0
            && keys1 != "0" && arts1 != "0" && packs1 == "1"
            && idxsum2 == idxsum1 && packs2 == "1"
        if !ok {
            println("fnunits meta publish: rc1=${string(rc1)} rc2=${string(rc2)} idx=${idx} keys1=${keys1} arts1=${arts1} packs1=${packs1} idxsum1=${idxsum1} idxsum2=${idxsum2} packs2=${packs2}")
            println("build.log tail: ${avra_shell_exec("tail -6 '${dir}/build.log' 2>/dev/null")}")
        }
        avra_shell_exec("rm -rf '${dir}'")
        ok
    }
    then "a standalone `bs2 compile` publishes NOTHING — no fnunits store leaked" {
        // No AVRA_LIB_PKG_ROOT → empty lib roots → the gate no-ops.
        // A scratch compile must not seed a per-fn store beside the file.
        let root = "/tmp/avra_fnunits_standalone_${string(avra_getpid())}"
        avra_shell_exec("rm -rf '${root}' && mkdir -p '${root}'")
        let _ = avra_selfhost_write_file("${root}/prog.av",
            "fn add(a: int, b: int) -> int { a + b }\nfn main() { println(string(add(20, 22))) }\n")
        let rc = avra_shell_exec_status(
            "cd '${root}' && env -u AVRA_LIB_PKG_ROOT -u AVRA_USE_METADATA '${bs2()}' compile prog.av > '${root}/compile.log' 2>&1")
        let stores = avra_shell_exec("find '${root}' -type d -name fnunits 2>/dev/null | wc -l").trim()
        let ok = rc == 0 && stores == "0"
        if !ok {
            println("fnunits standalone: rc=${string(rc)} stores=${stores}")
            println("compile.log tail: ${avra_shell_exec("tail -5 '${root}/compile.log' 2>/dev/null")}")
        }
        avra_shell_exec("rm -rf '${root}'")
        ok
    }
}
