// WHY: hygienic identifier rewriter for AST values produced by `quote { ... }`
// (Phase 5 of Components V2, vez6.5).
//
// Macros that build AST via quote risk colliding with identifiers in
// the call site:
//
//     @comptime fn make_pair(body: Expr) -> Stmt {
//         quote stmt { let result = compute_thing(); ~body + result }
//     }
//
// If the caller already has `let result = ...`, naively splicing the
// macro's AST shadows that binding. Hygiene fixes this by renaming
// every locally-introduced identifier (let / mut / const / for / lambda
// param / pattern binding) to a unique suffix at expansion time.
// Caller's `result` keeps its name; macro's `result` becomes
// `result_$0` and stays distinct.
//
// The rewriter walks the AST, tracking a scope chain of
// (orig → renamed) entries. Every `let x = ...` extends the chain
// for the REST of the enclosing block; bindings drop off when the
// block / fn / arm ends. Free variables (idents with no enclosing
// binding) pass through verbatim — those are the splice points and
// other refs to caller-level state.
//
// Pipeline position: applied by the @expand pass (Phase 6) after a
// macro fn returns its AST value, BEFORE the value is spliced into
// the call site's AST. Standalone use is also fine — call
// hygiene_rename_expr / hygiene_rename_stmts on any AST value.

use core.{
    Stmt, StmtList, SStmt, sstmt_at,
    Expr, ExprList, SExpr, sexpr,
    FieldInitList, MatchArmList, WhenArmList,
    ParamList, Pattern, PatternList,
    BinOp, UnOp, LogicOp,
    ValueType,
}

// ── Scope chain + context ──

/// Per-name link in the rename map. `orig` is the original source
/// name; `renamed` is the suffix-suffixed form (`x` → `x_$N` for some
/// monotonic N).
enum HygieneScope {
    End
    Node(orig: string, renamed: string, next: HygieneScope)
}

/// State threaded through the rewriter. `counter` is monotonic
/// across the whole hygienic transformation, ensuring every fresh
/// suffix is globally unique within the rewrite. `scope` is a
/// linked-list stack — push on binding-intro, drop by returning
/// the caller's ctx after the scope ends.
type HygieneCtx = { scope: HygieneScope, counter: int }

// Result wrappers — Avra has no first-class tuples in fn returns,
// so these structs carry the (rewritten-form, updated-ctx) pair.
type RenameExprResult = { expr: Expr, ctx: HygieneCtx }
type RenameStmtResult = { stmt: Stmt, ctx: HygieneCtx }
type RenameStmtListResult = { list: StmtList, ctx: HygieneCtx }
type RenameExprListResult = { list: ExprList, ctx: HygieneCtx }
type RenameFieldInitsResult = { list: FieldInitList, ctx: HygieneCtx }
type RenameParamsResult = { params: ParamList, ctx: HygieneCtx }
type FreshResult = { name: string, ctx: HygieneCtx }

// ── Public entry points ──

/// Rename every locally-introduced identifier inside `e` to a unique
/// suffix; free identifiers pass through verbatim.
export fn hygiene_rename_expr(e: Expr) -> Expr {
    let r = rename_expr(empty_ctx(), e)
    r.expr
}

/// Like hygiene_rename_expr, for a Stmt.
export fn hygiene_rename_stmt(s: Stmt) -> Stmt {
    let r = rename_stmt(empty_ctx(), s)
    r.stmt
}

/// Like hygiene_rename_expr, for a StmtList — typical entry for
/// macro-built blocks.
export fn hygiene_rename_stmts(stmts: StmtList) -> StmtList {
    let r = rename_stmt_list(empty_ctx(), stmts)
    r.list
}

fn empty_ctx() -> HygieneCtx {
    HygieneCtx { scope: HygieneScope.End, counter: 0 }
}

// ── Fresh-name + scope helpers ──

/// Allocate a fresh suffix for `orig` and push a (orig → renamed)
/// entry onto the scope chain. The returned ctx is what subsequent
/// rewrites must thread through.
fn fresh_name(ctx: HygieneCtx, orig: string) -> FreshResult {
    let id = ctx.counter
    let renamed = orig + "_$" + string(id)
    let new_scope = HygieneScope.Node(orig, renamed, ctx.scope)
    let new_ctx = HygieneCtx { scope: new_scope, counter: id + 1 }
    FreshResult { name: renamed, ctx: new_ctx }
}

/// Look up `name` in the scope chain. Returns the renamed form if
/// found, or null otherwise (free variable — pass through).
fn lookup_scope(scope: HygieneScope, name: string) -> string? {
    match scope {
        .End -> null
        .Node(orig, renamed, _) if orig == name -> renamed
        .Node(_, _, next) -> lookup_scope(next, name)
    }
}

// ── Statement walker ──

fn rename_stmt_list(ctx: HygieneCtx, list: StmtList) -> RenameStmtListResult {
    match list {
        .End -> RenameStmtListResult { list: StmtList.End, ctx }
        .Node(ss, next) -> {
            let r1 = rename_stmt(ctx, ss.node)
            let r2 = rename_stmt_list(r1.ctx, next)
            RenameStmtListResult {
                list: StmtList.Node(sstmt_at(r1.stmt, ss.line, ss.col, ss.file), r2.list),
                ctx: r2.ctx,
            }
        }
    }
}

fn rename_stmt(ctx: HygieneCtx, s: Stmt) -> RenameStmtResult {
    match s {
        // Bindings: rewrite the init in the CURRENT ctx (init can't see
        // the new binding), then introduce the rename for subsequent
        // stmts in the same scope.
        .Let(name, vt, init) -> {
            let ri = rename_expr(ctx, init)
            let f = fresh_name(ri.ctx, name)
            RenameStmtResult { stmt: Stmt.Let(f.name, vt, ri.expr), ctx: f.ctx }
        }
        .Mut(name, vt, init) -> {
            let ri = rename_expr(ctx, init)
            let f = fresh_name(ri.ctx, name)
            RenameStmtResult { stmt: Stmt.Mut(f.name, vt, ri.expr), ctx: f.ctx }
        }
        .Const(name, vt, init) -> {
            let ri = rename_expr(ctx, init)
            let f = fresh_name(ri.ctx, name)
            RenameStmtResult { stmt: Stmt.Const(f.name, vt, ri.expr), ctx: f.ctx }
        }
        .Expr(e) -> {
            let r = rename_expr(ctx, e)
            RenameStmtResult { stmt: Stmt.Expr(r.expr), ctx: r.ctx }
        }
        .Return(e) -> {
            let r = rename_expr(ctx, e)
            RenameStmtResult { stmt: Stmt.Return(r.expr), ctx: r.ctx }
        }
        // Block: nested scope. Bindings inside don't escape to caller.
        .Block(body) -> {
            let r = rename_stmt_list(ctx, body)
            RenameStmtResult { stmt: Stmt.Block(r.list), ctx }
        }
        .If(cond, then_b, else_b) -> {
            let rc = rename_expr(ctx, cond)
            let rt = rename_stmt(rc.ctx, then_b)
            // then-branch bindings don't escape into else.
            if else_b != null {
                let re = rename_stmt(rc.ctx, else_b!)
                RenameStmtResult { stmt: Stmt.If(rc.expr, rt.stmt, re.stmt), ctx }
            } else {
                RenameStmtResult { stmt: Stmt.If(rc.expr, rt.stmt, null), ctx }
            }
        }
        .While(cond, body) -> {
            let rc = rename_expr(ctx, cond)
            let rb = rename_stmt(rc.ctx, body)
            RenameStmtResult { stmt: Stmt.While(rc.expr, rb.stmt), ctx }
        }
        // For introduces the loop variable for the body only.
        .For(v, start, end, body) -> {
            let rs = rename_expr(ctx, start)
            let re = rename_expr(rs.ctx, end)
            let f = fresh_name(re.ctx, v)
            let rb = rename_stmt(f.ctx, body)
            RenameStmtResult { stmt: Stmt.For(f.name, rs.expr, re.expr, rb.stmt), ctx }
        }
        .ForIn(v, coll, body) -> {
            let rc = rename_expr(ctx, coll)
            let f = fresh_name(rc.ctx, v)
            let rb = rename_stmt(f.ctx, body)
            RenameStmtResult { stmt: Stmt.ForIn(f.name, rc.expr, rb.stmt), ctx }
        }
        .Defer(body) -> {
            let r = rename_expr(ctx, body)
            RenameStmtResult { stmt: Stmt.Defer(r.expr), ctx: r.ctx }
        }
        .Errdefer(body) -> {
            let r = rename_expr(ctx, body)
            RenameStmtResult { stmt: Stmt.Errdefer(r.expr), ctx: r.ctx }
        }
        // Decl-level + complex Stmts not handled in v1 — pass through.
        // Match arm pattern bindings would need a separate walker.
        _ -> RenameStmtResult { stmt: s, ctx }
    }
}

// ── Expression walker ──

fn rename_expr(ctx: HygieneCtx, e: Expr) -> RenameExprResult {
    match e {
        .Ident(name) -> {
            let renamed = lookup_scope(ctx.scope, name)
            if renamed != null {
                RenameExprResult { expr: Expr.Ident(renamed!), ctx }
            } else {
                RenameExprResult { expr: e, ctx }
            }
        }
        .Assign(name, value) -> {
            let rv = rename_expr(ctx, value)
            let renamed = lookup_scope(ctx.scope, name)
            let target = if renamed != null { renamed! } else { name }
            RenameExprResult { expr: Expr.Assign(target, rv.expr), ctx: rv.ctx }
        }
        .Binary(l, op, r) -> {
            let rl = rename_expr(ctx, l)
            let rr = rename_expr(rl.ctx, r)
            RenameExprResult { expr: Expr.Binary(rl.expr, op, rr.expr), ctx: rr.ctx }
        }
        .Unary(op, r) -> {
            let rr = rename_expr(ctx, r)
            RenameExprResult { expr: Expr.Unary(op, rr.expr), ctx: rr.ctx }
        }
        .Logical(l, op, r) -> {
            let rl = rename_expr(ctx, l)
            let rr = rename_expr(rl.ctx, r)
            RenameExprResult { expr: Expr.Logical(rl.expr, op, rr.expr), ctx: rr.ctx }
        }
        .Grouping(inner) -> {
            let r = rename_expr(ctx, inner)
            RenameExprResult { expr: Expr.Grouping(r.expr), ctx: r.ctx }
        }
        .Call(callee, args) -> {
            let rc = rename_expr(ctx, callee)
            let ra = rename_expr_list(rc.ctx, args)
            RenameExprResult { expr: Expr.Call(rc.expr, ra.list), ctx: ra.ctx }
        }
        .Index(obj, idx) -> {
            let ro = rename_expr(ctx, obj)
            let ri = rename_expr(ro.ctx, idx)
            RenameExprResult { expr: Expr.Index(ro.expr, ri.expr), ctx: ri.ctx }
        }
        .FieldAccess(obj, field) -> {
            let r = rename_expr(ctx, obj)
            RenameExprResult { expr: Expr.FieldAccess(r.expr, field), ctx: r.ctx }
        }
        .FieldAssign(obj, field, value) -> {
            let ro = rename_expr(ctx, obj)
            let rv = rename_expr(ro.ctx, value)
            RenameExprResult { expr: Expr.FieldAssign(ro.expr, field, rv.expr), ctx: rv.ctx }
        }
        .IfExpr(c, t, el) -> {
            let rc = rename_expr(ctx, c)
            let rt = rename_expr(rc.ctx, t)
            let re = rename_expr(rt.ctx, el)
            RenameExprResult { expr: Expr.IfExpr(rc.expr, rt.expr, re.expr), ctx: re.ctx }
        }
        .NullCoalesce(l, r) -> {
            let rl = rename_expr(ctx, l)
            let rr = rename_expr(rl.ctx, r)
            RenameExprResult { expr: Expr.NullCoalesce(rl.expr, rr.expr), ctx: rr.ctx }
        }
        .OptionalChain(obj, field) -> {
            let r = rename_expr(ctx, obj)
            RenameExprResult { expr: Expr.OptionalChain(r.expr, field), ctx: r.ctx }
        }
        .Try(inner) -> {
            let r = rename_expr(ctx, inner)
            RenameExprResult { expr: Expr.Try(r.expr), ctx: r.ctx }
        }
        .Tuple(elems) -> {
            let r = rename_expr_list(ctx, elems)
            RenameExprResult { expr: Expr.Tuple(r.list), ctx: r.ctx }
        }
        .ListLit(elems) -> {
            let r = rename_expr_list(ctx, elems)
            RenameExprResult { expr: Expr.ListLit(r.list), ctx: r.ctx }
        }
        .MapLit(entries) -> {
            let r = rename_expr_list(ctx, entries)
            RenameExprResult { expr: Expr.MapLit(r.list), ctx: r.ctx }
        }
        .StructLit(name, inits) -> {
            let r = rename_field_inits(ctx, inits)
            RenameExprResult { expr: Expr.StructLit(name, r.list), ctx: r.ctx }
        }
        .EnumCtor(tn, variant, args) -> {
            let r = rename_expr_list(ctx, args)
            RenameExprResult { expr: Expr.EnumCtor(tn, variant, r.list), ctx: r.ctx }
        }
        .Block(body) -> {
            let r = rename_stmt_list(ctx, body)
            // Block bindings don't escape; ctx after block == ctx before.
            RenameExprResult { expr: Expr.Block(r.list), ctx }
        }
        // Lambda introduces its parameters for the body only.
        .Lambda(params, body) -> {
            let rp = rename_param_list(ctx, params)
            let rb = rename_expr(rp.ctx, body)
            // Params + body bindings don't escape into the surrounding
            // expression; return the caller's ctx.
            RenameExprResult { expr: Expr.Lambda(rp.params, rb.expr), ctx }
        }
        .Spawn(body) -> {
            let r = rename_expr(ctx, body)
            RenameExprResult { expr: Expr.Spawn(r.expr), ctx: r.ctx }
        }
        // Splice is opaque — its target evaluates at expansion time
        // to a runtime AST value. We don't recurse into the target's
        // shape; if hygiene is wanted on the spliced-in tree, the
        // caller applies hygiene_rename_* to the spliced value before
        // splicing.
        .Splice(_) -> RenameExprResult { expr: e, ctx }
        // Quote should not normally appear at this stage (lowering
        // strips it). If it does, leave intact — its body is opaque.
        .Quote(_, _) -> RenameExprResult { expr: e, ctx }
        // Leaves and complex variants we don't yet rewrite (Match arms
        // need Pattern walking, ListComp introduces a binding, Catch
        // introduces an error binding) — pass through.
        _ -> RenameExprResult { expr: e, ctx }
    }
}

fn rename_expr_list(ctx: HygieneCtx, list: ExprList) -> RenameExprListResult {
    match list {
        .End -> RenameExprListResult { list: ExprList.End, ctx }
        .Node(se, next) -> {
            let r1 = rename_expr(ctx, se.node)
            let r2 = rename_expr_list(r1.ctx, next)
            RenameExprListResult {
                list: ExprList.Node(sexpr(r1.expr, se.line, se.col), r2.list),
                ctx: r2.ctx,
            }
        }
    }
}

fn rename_field_inits(ctx: HygieneCtx, inits: FieldInitList) -> RenameFieldInitsResult {
    match inits {
        .End -> RenameFieldInitsResult { list: FieldInitList.End, ctx }
        .Node(name, se, next) -> {
            let r1 = rename_expr(ctx, se.node)
            let r2 = rename_field_inits(r1.ctx, next)
            RenameFieldInitsResult {
                list: FieldInitList.Node(name, sexpr(r1.expr, se.line, se.col), r2.list),
                ctx: r2.ctx,
            }
        }
    }
}

fn rename_param_list(ctx: HygieneCtx, params: ParamList) -> RenameParamsResult {
    match params {
        .End -> RenameParamsResult { params: ParamList.End, ctx }
        .Node(name, vt, next) -> {
            let f = fresh_name(ctx, name)
            let rest = rename_param_list(f.ctx, next)
            RenameParamsResult {
                params: ParamList.Node(f.name, vt, rest.params),
                ctx: rest.ctx,
            }
        }
    }
}
