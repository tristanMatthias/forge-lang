// WHY: the DSL flip seam (parse/mod.av) turns a grammar-reported F-code STRING back
// into a `DiagCode` via `syntax_diag_code`, and a code it cannot reverse does not
// fail — it falls through to `set_error`, which renders as F0001. So an unreversible
// code keeps its MESSAGE and silently changes its CODE, which is invisible in every
// message-only oracle (`--parser-probe`, `msgs_agree_*`) and shows up only if some
// test happens to assert the rendered `error[Fxxxx]`.
//
// That is exactly how routing `let` broke F1203: `mk_let_binding_g` started reporting
// `report_coded("F1203", …)` because the committed native rule now owns the
// diagnostic, `syntax_diag_code` covered only F0001-F0999, and the compiler emitted
// the right sentence under the wrong code.
//
// This guard closes the class rather than the instance. It reads the two places a
// code STRING can enter the seam — the production grammar's `@expect(…, CODE)` forms
// and `report_coded("CODE", …)` calls in the executor — and asserts every one of them
// round-trips through `syntax_diag_code`. Adding a code without an entry is a red
// test here, not a silent downgrade in the field.
use @std.avrac.diagnostics.{syntax_diag_code, error_def}
use @std.avrac.core.{avra_shell_exec}
use @std.avrac.features.grammar.{avra_program_grammar}

/// The `@expect(…, CODE)` codes, read from the COMPOSED whole-program grammar
/// OBJECT — every fragment, spine and feature alike. This used to scan the
/// avra_grammar.av FILE, and the t-kd4y.3 migration drained it rule by rule
/// as families moved into feature grams (each move carried its coded @expects
/// out of the scan's view) until the pair-of-files extraction bottomed out at
/// one code on the .3.5.2 slice. The grammar STRUCTURE is the surface the
/// production parser is generated from, so a rule carries its code into this
/// guard wherever the migration homes it.
fn grammar_seam_codes() -> List<string> {
    mut out: List<string> = []
    let g = avra_program_grammar()
    for r in g.rules {
        match r.body {
            .Alt(branches) -> {
                for b in branches {
                    for a in b.annots {
                        match a {
                            .Expect(_, _, c) -> { if c != "" { out.push(c) } }
                            _ -> {}
                        }
                    }
                }
            }
        }
    }
    out
}

/// The `report_coded("CODE", …)` codes, wherever the call now lives — the
/// executor's remaining arms AND every feature lowering (mk_let_binding_g's
/// F1203, the incident this file exists for, moved to features/let_stmt with
/// its family). A recursive scan, for the same reason the grammar side reads
/// the composed object: the migration relocates these sites and a fixed file
/// list goes quietly vacuous.
fn reporter_seam_codes() -> List<string> {
    mut out: List<string> = []
    let found = avra_shell_exec("grep -rho 'report_coded(\"F[0-9][0-9][0-9][0-9]\"' packages/std-avrac/src/features packages/std-avrac/src/parse 2>/dev/null | grep -o 'F[0-9][0-9][0-9][0-9]' | sort -u")
    for c in found.split("\n") {
        if c.length == 5 { out.push(c) }
    }
    out
}

/// The union both `then`s below iterate — the codes the seam must reverse.
fn seam_codes() -> List<string> {
    mut out: List<string> = []
    for c in grammar_seam_codes() { out.push(c) }
    for c in reporter_seam_codes() { out.push(c) }
    mut uniq: List<string> = []
    for c in out {
        mut seen = false
        for u in uniq { if u == c { seen = true } }
        if !seen { uniq.push(c) }
    }
    uniq
}

spec "every F-code the parser seam can carry is reversible by syntax_diag_code" {
    given "the codes named by the production grammar and the executor's report_coded" {
        then "the extraction is NON-VACUOUS — it really found codes in both sources" {
            // Without this, a broken reader makes the round-trip below pass on an
            // empty list, which is the guard-that-cannot-fail shape. Asserted PER
            // SOURCE, not on the union's size: the union stayed >= 2 for months
            // while the grammar-file scan drained toward empty, and a single-count
            // check only fired when the whole pair bottomed out at one code.
            let gc = grammar_seam_codes()
            let rc = reporter_seam_codes()
            if gc.length == 0 { println("grammar_seam_codes found NOTHING") }
            if rc.length == 0 { println("reporter_seam_codes found NOTHING") }
            gc.length > 0 && rc.length > 0
        }

        then "each one round-trips to a DiagCode whose own code is that string" {
            mut bad: List<string> = []
            for c in seam_codes() {
                let dc = syntax_diag_code(c)
                if dc == null { bad.push(c + " (not reversible — renders as F0001)") }
                else if error_def(dc!).code != c { bad.push(c + " -> " + error_def(dc!).code) }
            }
            if bad.length > 0 {
                println("codes the seam cannot carry: " + bad.join(", "))
            }
            bad.length == 0
        }
    }

    given "F1203, the code that caught this" {
        then "LetElseMustDiverge reverses, and a genuine typeck code still does not" {
            let f1203 = syntax_diag_code("F1203")
            // F1000 is a typeck code no parser reports — it must still answer null,
            // or this table has stopped meaning anything.
            f1203 != null && error_def(f1203!).code == "F1203" &&
                syntax_diag_code("F1000") == null && syntax_diag_code("F9999") == null
        }
    }
}
