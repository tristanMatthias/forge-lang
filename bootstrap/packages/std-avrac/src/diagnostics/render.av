// WHY: renders Diagnostics to stderr with source context.
// Hybrid design inspired by ariadne (box frame), miette (severity
// symbols), Roc (Unicode separators), and codespan (connecting carets).

use diagnostics.{Diagnostic, DiagnosticBag, DiagnosticList, DiagnosticCause, Span, Severity, severity_str, diag_code_str, confidence_str}
use @std.json.{json_escape}
use core.{avra_selfhost_file_exists, avra_selfhost_read_file}

// ── ANSI colors ──

/// Wrap `s` in bold-red ANSI escapes. Used for error severity.
fn color_red(s: string) -> string { "\x1b[1;31m${s}\x1b[0m" }
/// Wrap `s` in bold-yellow ANSI escapes. Used for warnings.
fn color_yellow(s: string) -> string { "\x1b[1;33m${s}\x1b[0m" }
/// Wrap `s` in bold-cyan ANSI escapes. Used for info severity.
fn color_cyan(s: string) -> string { "\x1b[1;36m${s}\x1b[0m" }
/// Wrap `s` in bold ANSI escapes. Used for header text.
fn color_bold(s: string) -> string { "\x1b[1m${s}\x1b[0m" }
/// Wrap `s` in dim ANSI escapes. Used for file path footers.
fn color_dim(s: string) -> string { "\x1b[2m${s}\x1b[0m" }
/// Wrap `s` in bold-blue ANSI escapes. Used for hint severity.
fn color_blue(s: string) -> string { "\x1b[1;34m${s}\x1b[0m" }
/// Wrap `s` in gray ANSI escapes. Used for box-drawing chrome.
fn color_gray(s: string) -> string { "\x1b[90m${s}\x1b[0m" }
/// Wrap `s` in bold-magenta ANSI escapes. Reserved for special accents.
fn color_magenta(s: string) -> string { "\x1b[1;35m${s}\x1b[0m" }

/// Wrap `text` in the colour matching `sev` — red errors, yellow
/// warnings, cyan info, blue hints. The single dispatch point so
/// adding a new severity only requires one new arm.
fn severity_color(sev: Severity, text: string) -> string {
    match sev {
        .Error -> color_red(text)
        .Warning -> color_yellow(text)
        .Info -> color_cyan(text)
        .Hint -> color_blue(text)
    }
}

/// Pick the leading severity glyph: × for errors, ⚠ for warnings,
/// `i` for info, ☞ for hints. Returned already-coloured.
fn severity_symbol(sev: Severity) -> string {
    match sev {
        .Error -> color_red("\xc3\x97")      // × (U+00D7)
        .Warning -> color_yellow("\xe2\x9a\xa0")  // ⚠ (U+26A0)
        .Info -> color_cyan("i")
        .Hint -> color_blue("\xe2\x98\x9e")   // ☞ (U+261E)
    }
}

// ── Unicode box drawing ──

/// Vertical bar `│` (U+2502). Gutter separator between line numbers
/// and source.
fn chr_vbar() -> string { "\xe2\x94\x82" }
/// Horizontal bar `─` (U+2500). Frame top/bottom and underline
/// segments.
fn chr_hbar() -> string { "\xe2\x94\x80" }
/// Left-top corner `╭` (U+256D). Opening corner of the diagnostic
/// frame.
fn chr_ltop() -> string { "\xe2\x95\xad" }
/// Left-bottom corner `╰` (U+2570). Caret-to-message connector.
fn chr_lbot() -> string { "\xe2\x95\xb0" }
/// Right-bottom corner `╯` (U+256F). Closing corner of the frame.
fn chr_rbot() -> string { "\xe2\x95\xaf" }
/// Caret marker `┬` (U+252C). Centerpoint of the underline.
fn chr_caret() -> string { "\xe2\x94\xac" }
/// Middle-dot `·` (U+00B7). Used in the gutter for non-source
/// annotation lines.
fn chr_dot() -> string { "\xc2\xb7" }

// ── Line extraction ──

/// Pull the `target`-th line (1-based) out of `source`, excluding
/// the trailing newline. Returns `""` when the file has fewer lines
/// than `target` — the renderer treats that as "no source available"
/// and skips the source frame.
fn extract_line(source: string, target: int) -> string {
    if target <= 0 { return "" }
    mut line_num = 1
    mut line_start = 0
    mut i = 0
    while i < source.length {
        if source[i] == "\n" {
            if line_num == target {
                return source.substring(line_start, i)
            }
            line_num = line_num + 1
            line_start = i + 1
        }
        i = i + 1
    }
    if line_num == target {
        return source.substring(line_start, source.length)
    }
    ""
}

/// Repeat a string `n` times, concatenating. Returns `""` for
/// non-positive `n`. Helper for padding and bar-drawing.
fn repeat_char(ch: string, n: int) -> string {
    if n <= 0 { return "" }
    mut out = ""
    for i in 0..n {
        out = out + ch
    }
    out
}

/// Sugar for `repeat_char(chr_hbar(), n)` — common enough to warrant
/// its own name.
fn repeat_hbar(n: int) -> string {
    repeat_char(chr_hbar(), n)
}

/// Right-align a line number into a `width`-wide field of spaces.
/// Used to keep multi-line source listings cleanly aligned.
fn gutter(line: int, width: int) -> string {
    let s = string(line)
    let pad = width - s.length
    repeat_char(" ", pad) + s
}

/// Pick the gutter field width: at least 3 chars (so single-digit
/// lines stay visually consistent), or wider for big files.
fn gutter_width(line: int) -> int {
    let s = string(line)
    if s.length < 3 { return 3 }
    s.length
}

// ── Single diagnostic rendering ──

/// Render one Diagnostic to stderr with full source context — header
/// (`× error[F0010]: …`), Unicode box frame around the source line,
/// caret + underline at the offending span, the help text, and any
/// `caused by:` chain. Skips the source frame when span is dummy
/// (`line == 0`) or extraction fails.
export fn render_diagnostic(source: string, filename: string, diag: Diagnostic) {
    // When the span carries an originating file path (set by the
    // parser's `parse_program_source_at`), prefer it over the
    // caller-supplied filename + source. This is what lets test-
    // bundle errors point at the actual *_test.av rather than
    // `<test>` with no snippet.
    let span_file = diag.span.file
    let use_span_file = span_file != "" && span_file != filename && avra_selfhost_file_exists(span_file) != 0
    let eff_filename = if use_span_file { span_file } else { filename }
    let eff_source = if use_span_file { avra_selfhost_read_file(span_file) } else { source }
    let line = diag.span.line
    let col = diag.span.col
    let w = gutter_width(line)
    let vbar = color_gray(chr_vbar())
    let pad = repeat_char(" ", w)
    let code_str = diag_code_str(diag.code)

    // Header:  × error[F0010]: expected `{` after if condition
    let sym = severity_symbol(diag.severity)
    let sev = severity_str(diag.severity)
    let header = severity_color(diag.severity, `${sev}[${code_str}]`)
    eprintln(`  ${sym} ${header}${color_bold(": ${diag.message}")}`)

    if line > 0 && col > 0 {
        // Box top: ╭─[file.av:2:5]
        let loc = `${eff_filename}:${string(line)}:${string(col)}`
        eprintln(`  ${pad} ${color_gray(chr_ltop() + chr_hbar())}[${color_dim(loc)}]`)

        // Blank gutter
        eprintln(`  ${pad} ${vbar}`)

        // Source line — highlight the error span in the severity color
        let src_line = extract_line(eff_source, line)
        // Guard: if source line not found (global line number from
        // multi-module compilation), skip the source display.
        if src_line.length == 0 {
            eprintln("")
            return
        }
        let span_len = diag.span.end - diag.span.start
        let hi_len = if span_len > 0 { span_len } else { 1 }
        let hi_start = col - 1
        // Guard: if col is beyond the source line, show line without highlight
        if hi_start >= src_line.length {
            eprintln(`  ${color_gray(gutter(line, w))} ${vbar} ${src_line}`)
            eprintln(color_gray("${repeat_hbar(w + 3)}${chr_rbot()}"))
            if diag.help.length > 0 { eprintln(`  ${color_bold("help:")} ${diag.help}`) }
            eprintln("")
            return
        }
        let hi_end = if hi_start + hi_len > src_line.length { src_line.length } else { hi_start + hi_len }
        let before_span = if hi_start > 0 { src_line.substring(0, hi_start) } else { "" }
        let in_span = src_line.substring(hi_start, hi_end)
        let after_span = if hi_end < src_line.length { src_line.substring(hi_end, src_line.length) } else { "" }
        let highlighted_line = before_span + severity_color(diag.severity, in_span) + after_span
        eprintln(`  ${color_gray(gutter(line, w))} ${vbar} ${highlighted_line}`)

        // Caret line:  · │   ──┬──
        let underline_len = hi_len
        let before = repeat_char(" ", col - 1)

        if underline_len == 1 {
            // Single char: just ┬
            let caret = severity_color(diag.severity, chr_caret())
            eprintln(`  ${color_gray("${pad} ${chr_dot()}")} ${before}${caret}`)
        } else {
            // Multi char: ──┬──
            let half = underline_len / 2
            let left_bars = repeat_hbar(half)
            let right_bars = repeat_hbar(underline_len - half - 1)
            let caret_line = severity_color(diag.severity, "${left_bars}${chr_caret()}${right_bars}")
            eprintln(`  ${color_gray("${pad} ${chr_dot()}")} ${before}${caret_line}`)
        }

        // Label line:  · │   ╰── message
        let label_pad = repeat_char(" ", col - 1 + underline_len / 2)
        let connector = severity_color(diag.severity, chr_lbot() + chr_hbar() + chr_hbar())
        eprintln(`  ${color_gray("${pad} ${chr_dot()}")} ${label_pad}${connector} ${diag.message}`)

        // Box bottom: ───╯
        eprintln(color_gray("${repeat_hbar(w + 3)}${chr_rbot()}"))
    }

    // Help text
    if diag.help.length > 0 {
        eprintln(`  ${color_bold("help:")} ${diag.help}`)
    }

    // Cause chain (ticket qar) — render linked cause diagnostics
    match diag.cause {
        .None -> {}
        .Cause(cause_diag) -> {
            eprintln(`  ${color_dim("caused by:")} ${cause_diag.message}`)
        }
    }

    eprintln("")
}

// ── Bag rendering ──

/// Render every Diagnostic in a DiagnosticBag, then print a
/// `Found N error(s) and M warning(s).` summary footer when the bag
/// is non-empty. Errors print first, then up to 10 warnings (the
/// rest are summarised in the footer count).
export fn render_bag(source: string, filename: string, bag: DiagnosticBag) {
    eprintln("")
    render_list(source, filename, bag.diagnostics)
    if bag.error_count > 0 || bag.warning_count > 0 {
        mut parts = ""
        if bag.error_count > 0 {
            let label = "${string(bag.error_count)} error${if bag.error_count > 1 { "s" } else { "" }}"
            parts = color_red(label)
        }
        if bag.warning_count > 0 {
            if parts.length > 0 { parts = "${parts} and " }
            let label = "${string(bag.warning_count)} warning${if bag.warning_count > 1 { "s" } else { "" }}"
            parts = "${parts}${color_yellow(label)}"
        }
        eprintln(`${color_bold("Found")} ${parts}${color_bold(".")}`)
        eprintln("")
    }
}

/// True when the linked list has hit its End sentinel. Used by the
/// iterative renderer below to walk the list without recursion (so
/// large bags don't risk a stack overflow).
fn diag_list_is_end(list: DiagnosticList) -> bool {
    match list { .End -> true, _ -> false }
}

/// Render a DiagnosticList in two iterative passes: errors first,
/// then warnings (capped at 10). Two passes — instead of one merged
/// pass — so users see all hard errors above any noise from
/// warnings when scrolling output.
fn render_list(source: string, filename: string, list: DiagnosticList) {
    // Iterative two-pass rendering — no stack overflow regardless of count.
    // Pass 1: all errors
    mut cur = list
    while !diag_list_is_end(cur) {
        match cur {
            .Node(diag, next) -> {
                if diag.severity is .Error { render_diagnostic(source, filename, diag) }
                cur = next
            }
            _ -> {}
        }
    }
    // Pass 2: warnings (capped at 10)
    mut warn_count = 0
    cur = list
    while !diag_list_is_end(cur) && warn_count < 10 {
        match cur {
            .Node(diag, next) -> {
                if !(diag.severity is .Error) {
                    render_diagnostic(source, filename, diag)
                    warn_count = warn_count + 1
                }
                cur = next
            }
            _ -> {}
        }
    }
}

// ── JSON diagnostic output (ticket d2e) ──
// Outputs one JSON object per line to stderr.
// `json_escape` is imported from @std/json — there's no longer a
// local copy.

/// Emit a single Diagnostic as a one-line JSON object on stderr.
/// Schema: `{code, severity, message, file, line, col, help,
/// confidence}`. Used by `--diagnostic-format=json` for machine-
/// readable output (LSP, CI tooling).
export fn render_diagnostic_json(filename: string, diag: Diagnostic) {
    let code_str = diag_code_str(diag.code)
    let sev = severity_str(diag.severity)
    let msg = json_escape(diag.message)
    let hlp = json_escape(diag.help)
    let conf = confidence_str(diag.confidence)
    let line_s = string(diag.span.line)
    let col_s = string(diag.span.col)
    let fname = json_escape(filename)
    eprintln("{\"code\":\"${code_str}\",\"severity\":\"${sev}\",\"message\":\"${msg}\",\"file\":\"${fname}\",\"line\":${line_s},\"col\":${col_s},\"help\":\"${hlp}\",\"confidence\":\"${conf}\"}")
}

/// Emit every Diagnostic in a bag as ND-JSON (one object per line).
/// Iterative loop, no recursion — large bags don't blow the stack.
export fn render_bag_json(filename: string, bag: DiagnosticBag) {
    mut cur = bag.diagnostics
    while !diag_list_is_end(cur) {
        match cur {
            .Node(diag, next) -> {
                render_diagnostic_json(filename, diag)
                cur = next
            }
            _ -> {}
        }
    }
}
