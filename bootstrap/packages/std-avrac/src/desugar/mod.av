// WHY: AST-to-AST rewrite pass that runs BETWEEN component expansion and resolving.
//
// The desugar pass rewrites expression-level sugar (assert, dbg, min, max, etc.)
// into simpler AST forms. The resolver, typechecker, and codegen never see
// the sugared forms.
//
// Component expansion is a SEPARATE pass that runs before desugar.
// See features/component_decl/expand.av.

use core.{Expr, Stmt, SExpr, SStmt, sexpr, sexpr_dummy, sstmt, sstmt_at, sstmt_dummy, stmt_unwrap, FieldEntry, FieldInit, MatchArm, WhenArm, Pattern, BinOp, UnOp, ValueType, Variant, TypeParamEntry, ParamEntry, vtype_list_elem, vtype_struct_name, vtype_struct}
use core.{NodeStore, ExprId, StmtId}
use list_ops.{list_map, list_concat}

// ListComp is no longer desugared at the AST level. The AST-rewrite
// approach produced an untyped `mut __lc = []` so the result type
// was always `List<Unknown>` — nested comprehensions and any typed
// downstream op on the result fell through to codegen errors. The
// `list_comp` feature (features/list_comp/) now handles resolve,
// typeck, and codegen end-to-end with proper type inference.

// ── Public API ──

/// Top-level desugar entry. Walks the statement list rewriting
/// expression-level sugar (`assert`, `dbg`, `todo`, `unreachable`,
/// `min`, `max`, list comprehensions). Idempotent. Rewritten children
/// allocate fresh rows via the store's transform allocators
/// (`restmt`/`reexpr`), inheriting the source rows' positions.
///
/// **Intrinsic injection moved out of this entry point** — call
/// `inject_intrinsics` AFTER `resolve_module_files` so the
/// recursive `program_declares_enum` scan can see the stdlib's
/// `Result` (loaded by module resolution) and skip the synthetic
/// duplicate. Each caller does:
///   parse → lower_quotes → desugar_program → resolve_module_files
///                                          → inject_intrinsics → ...
export fn desugar_program(stmts: List<SStmt>, store: NodeStore) -> List<SStmt> {
    // Collect top-level / module fn signatures up front so call-argument
    // table inference (`f(table { ... })`) can pin the row type from the
    // matching parameter's declared `List<Row>` type. Param vtypes are
    // already populated by the parser (type_expr_to_vtype), so this works
    // pre-resolve. (c080 fn-arg inference.)
    let sigs = collect_fn_sigs(store, stmts)
    desugar_stmt_list(store, stmts, sigs)
}

/// A function's name paired with its declared parameter types. Used only
/// for call-argument table-row inference.
type FnSig = { name: string, params: List<ValueType> }

/// Collect `(name, param-types)` for every `fn` reachable at the top
/// level, inside modules, inside impls, and under annotations. Methods
/// are keyed by their bare name; a same-named free fn would shadow, but
/// table args to methods are rare and fall back to the explicit form.
fn collect_fn_sigs(store: NodeStore, stmts: List<SStmt>) -> List<FnSig> {
    mut out: List<FnSig> = []
    mut i = 0
    while i < stmts.length {
        out = collect_fn_sigs_stmt(store, stmts[i].node, out)
        i = i + 1
    }
    out
}

fn collect_fn_sigs_stmt(store: NodeStore, stmt: Stmt, acc: List<FnSig>) -> List<FnSig> {
    match stmt {
        .Function(name, _, params, _, _) -> {
            mut a = acc
            a.push(FnSig { name: name, params: list_map(params, (p: ParamEntry) -> p.vtype) })
            a
        }
        .Annotated(_, inner) -> collect_fn_sigs_stmt(store, store.stmts.get(inner), acc)
        .Module(_, body) -> collect_fn_sigs_stmt_ids(store, body, acc)
        .Impl(_, methods) -> collect_fn_sigs_stmt_ids(store, methods, acc)
        _ -> acc
    }
}

fn collect_fn_sigs_stmt_ids(store: NodeStore, ids: List<StmtId>, acc: List<FnSig>) -> List<FnSig> {
    mut a = acc
    for id in ids { a = collect_fn_sigs_stmt(store, store.stmts.get(id), a) }
    a
}

/// Find a function's parameter types by name, or null when unknown.
fn sig_lookup(sigs: List<FnSig>, name: string) -> List<ValueType>? {
    mut i = 0
    while i < sigs.length {
        if sigs[i].name == name { return sigs[i].params }
        i = i + 1
    }
    null
}

/// Stamp anonymous table-row literals passed directly as call arguments
/// using the callee's declared `List<Row>` parameter types. Non-table
/// args and unknown callees pass through unchanged.
fn stamp_call_arg_tables(store: NodeStore, callee: Expr, args: List<SExpr>, sigs: List<FnSig>) -> List<SExpr> {
    let name = match callee { .Ident(n) -> n, .QualifiedIdent(n) -> n, _ -> "" }
    if name == "" { return args }
    let params = sig_lookup(sigs, name)
    if params == null { return args }
    let ps = params!
    mut out: List<SExpr> = []
    mut i = 0
    while i < args.length {
        if i < ps.length {
            let sname = vtype_struct_name(vtype_list_elem(ps[i]))
            if sname != "" {
                out.push(sexpr(stamp_table_rows(store, args[i].node, sname), args[i].line, args[i].col))
            } else {
                out.push(args[i])
            }
        } else {
            out.push(args[i])
        }
        i = i + 1
    }
    out
}

// ── Intrinsic injection ──
// Result<T, E> ships with the language but isn't auto-loaded like a
// stdlib module. Self-compiling the bootstrap finds it via
// `features/error_propagation/mod.av`; user programs (and the test
// runner that wraps test files in Modules) wouldn't otherwise see it,
// so we synthesize the declaration when missing.
//
// This also fixes forge-crafting-intepreters-xks4: a trait impl
// returning Result inside a Module-wrapped @std package mis-qualifies
// `Result` as `<wrap>::@std::<pkg>::Result` because the resolver can't
// find Result in any module's items. Injecting it at the top level
// (outside any Module) puts it in the global index and the resolver
// keeps it bare.

/// Inject `Result<T, E>` into the program when the user hasn't
/// declared it. Self-compiling the bootstrap finds Result via
/// `features/error_propagation/mod.av`; Module-wrapped user programs
/// (and the test runner's per-file Module wrapper) wouldn't otherwise
/// see it. Putting the synthesized decl at the global scope also
/// fixes ticket xks4 (resolver mis-qualification of `Result` inside
/// trait impls).
export fn inject_intrinsics(stmts: List<SStmt>, store: NodeStore) -> List<SStmt> {
    mut out = stmts
    // Inject each intrinsic enum the program doesn't already declare.
    // Guarded independently so a program that declares one (e.g. the
    // self-hosting compiler declares Result in error_propagation) still
    // receives the other.
    if !program_declares_enum(store, out, "Option") {
        out = list_concat([sstmt_dummy(synthesize_option_enum())], out)
    }
    if !program_declares_enum(store, out, "Result") {
        out = list_concat([sstmt_dummy(synthesize_result_enum())], out)
    }
    out
}

/// Build the synthetic `enum Result<T, E> { Ok(value: T), Err(error: E) }`
/// AST node used by `inject_intrinsics`.
fn synthesize_result_enum() -> Stmt {
    let t = vtype_struct("T", 0)
    let e = vtype_struct("E", 0)
    mut ok_fields: List<FieldEntry> = []
    ok_fields.push(FieldEntry { name: "value", resolved: t })
    mut err_fields: List<FieldEntry> = []
    err_fields.push(FieldEntry { name: "error", resolved: e })
    mut variants: List<Variant> = []
    variants.push(Variant { name: "Ok", fields: ok_fields })
    variants.push(Variant { name: "Err", fields: err_fields })
    mut type_params: List<TypeParamEntry> = []
    type_params.push(TypeParamEntry { name: "T", bounds: "" })
    type_params.push(TypeParamEntry { name: "E", bounds: "" })
    Stmt.EnumDecl("Result", type_params, variants)
}

/// Build the synthetic `enum Option<T> { Some(value: T), None }` AST
/// node used by `inject_intrinsics`. This is the canonical type that
/// `T?` desugars to. Programmers write `T?` and `none`; they never
/// write `.Some`/`.None` directly. This defines the type only —
/// absence behaviour still routes through the legacy null representation
/// until the dual (value-tagged) repr is wired.
fn synthesize_option_enum() -> Stmt {
    let t = vtype_struct("T", 0)
    mut some_fields: List<FieldEntry> = []
    some_fields.push(FieldEntry { name: "value", resolved: t })
    mut none_fields: List<FieldEntry> = []
    mut variants: List<Variant> = []
    variants.push(Variant { name: "Some", fields: some_fields })
    variants.push(Variant { name: "None", fields: none_fields })
    mut type_params: List<TypeParamEntry> = []
    type_params.push(TypeParamEntry { name: "T", bounds: "" })
    Stmt.EnumDecl("Option", type_params, variants)
}

/// True when a top-level `EnumDecl` named `target` exists in the
/// program (or any nested Module). Used to skip Result injection
/// when the user has already declared it.
fn program_declares_enum(store: NodeStore, stmts: List<SStmt>, target: string) -> bool {
    mut i = 0
    while i < stmts.length {
        if stmt_declares_enum(store, stmt_unwrap(store, stmts[i].node), target) { return true }
        i = i + 1
    }
    false
}

fn stmt_declares_enum(store: NodeStore, s: Stmt, target: string) -> bool {
    match s {
        .EnumDecl(name, _, _) -> name == target
        .Module(_, body) -> {
            for id in body {
                if stmt_declares_enum(store, stmt_unwrap(store, store.stmts.get(id)), target) { return true }
            }
            false
        }
        _ -> false
    }
}

// ── Statement desugaring ──

/// Map `desugar_stmt` over every element of a `List<SStmt>`, preserving
/// span info on each rewritten node. `sigs` threads fn signatures for
/// call-argument table inference.
fn desugar_stmt_list(store: NodeStore, stmts: List<SStmt>, sigs: List<FnSig>) -> List<SStmt> {
    list_map(stmts, (ss: SStmt) -> sstmt_at(desugar_stmt(store, ss.node, sigs), ss.line, ss.col, ss.file))
}

/// Desugar a flipped `List<StmtId>` body: each rewritten child is a
/// fresh row inheriting the original's position (`restmt`).
fn desugar_stmt_ids(store: NodeStore, ids: List<StmtId>, sigs: List<FnSig>) -> List<StmtId> {
    list_map(ids, (id: StmtId) -> desugar_stmt_id(store, id, sigs))
}

fn desugar_stmt_id(store: NodeStore, id: StmtId, sigs: List<FnSig>) -> StmtId {
    store.restmt(desugar_stmt(store, store.stmts.get(id), sigs), id)
}

/// Desugar an expression row: resolve, rewrite, re-allocate.
fn desugar_expr_id(store: NodeStore, id: ExprId, sigs: List<FnSig>) -> ExprId {
    store.reexpr(desugar_expr(store, store.exprs.get(id), sigs), id)
}

/// Desugar a single statement. For control-flow / declaration
/// statements we recurse into their expression and body fields;
/// statements with no rewritable payload pass through unchanged.
fn desugar_stmt(store: NodeStore, stmt: Stmt, sigs: List<FnSig>) -> Stmt {
    match stmt {
        .Expr(e) -> .Expr(desugar_expr_id(store, e, sigs))
        // Typed table-literal inference (forge-crafting-intepreters-c080):
        // a `table { ... }` whose row type is omitted parses to a ListLit
        // of anonymous StructLit("") rows. When the binding carries a
        // `List<Row>` annotation, stamp `Row` onto each row so the rest of
        // the pipeline sees an ordinary `List<Row>`. `table<Row> { ... }`
        // already names its rows and is left untouched.
        .Let(name, vt, init) -> .Let(name, vt, store.reexpr(lower_table_rows(store, desugar_expr(store, store.exprs.get(init), sigs), vt), init))
        .Mut(name, vt, init) -> .Mut(name, vt, store.reexpr(lower_table_rows(store, desugar_expr(store, store.exprs.get(init), sigs), vt), init))
        .Const(name, vt, init) -> .Const(name, vt, store.reexpr(lower_table_rows(store, desugar_expr(store, store.exprs.get(init), sigs), vt), init))
        .Return(e) -> .Return(desugar_expr_id(store, e, sigs))
        .Block(body) -> .Block(desugar_stmt_ids(store, body, sigs))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(desugar_expr_id(store, cond, sigs), desugar_stmt_id(store, then_b, sigs), desugar_stmt_id(store, else_b!, sigs))
            } else {
                .If(desugar_expr_id(store, cond, sigs), desugar_stmt_id(store, then_b, sigs), null)
            }
        }
        .While(cond, body) -> .While(desugar_expr_id(store, cond, sigs), desugar_stmt_id(store, body, sigs))
        .For(v, start, end, body) -> .For(v, desugar_expr_id(store, start, sigs), desugar_expr_id(store, end, sigs), desugar_stmt_id(store, body, sigs))
        .ForIn(v, coll, body) -> .ForIn(v, desugar_expr_id(store, coll, sigs), desugar_stmt_id(store, body, sigs))
        .Match(subj, arms) -> .Match(desugar_expr_id(store, subj, sigs), desugar_match_arms(store, arms, sigs))
        // Function bodies: after desugaring, stamp the return type onto
        // any context-free `table { ... }` in return / tail position so a
        // `fn f() -> List<Row> { table { ... } }` infers `Row` per c080.
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, lower_fn_returns(store, desugar_stmt_ids(store, body, sigs), rvt))
        .Defer(body) -> .Defer(desugar_expr_id(store, body, sigs))
        .Errdefer(body) -> .Errdefer(desugar_expr_id(store, body, sigs))
        .Module(name, body) -> .Module(name, desugar_stmt_ids(store, body, sigs))
        .Annotated(annots, inner) -> .Annotated(annots, desugar_stmt_id(store, inner, sigs))
        .SpecBlock(name, body) -> .SpecBlock(name, desugar_stmt_ids(store, body, sigs))
        .GivenBlock(name, body) -> .GivenBlock(name, desugar_stmt_ids(store, body, sigs))
        .ThenBlock(name, cond) -> .ThenBlock(name, desugar_expr_id(store, cond, sigs))
        _ -> stmt
    }
}

// ── Typed table-literal row inference (c080) ──
//
// A `table { col | col\n v | v }` with no `<Row>` ascription parses to a
// ListLit whose rows are anonymous `StructLit("", inits)`. The row type is
// pinned from the surrounding context — a `let x: List<Row>`/`mut`/`const`
// annotation or a fn return type. These helpers stamp that struct name
// onto every anonymous row. Rows that already carry a name (the explicit
// `table<Row> { ... }` form) are left untouched; rows that never get a
// name stay anonymous and the typechecker reports the missing-row-type
// error (F1042).

/// If `expected` is `List<Struct>`, stamp the element struct's name onto
/// every anonymous table row in `expr`. Recurses into block / if / match /
/// when tail positions so a table inside a tail branch still resolves.
/// Non-table expressions and non-`List<Struct>` expectations pass through.
fn lower_table_rows(store: NodeStore, expr: Expr, expected: ValueType) -> Expr {
    let sname = vtype_struct_name(vtype_list_elem(expected))
    if sname == "" { return expr }
    stamp_table_rows(store, expr, sname)
}

/// Recursively stamp `sname` onto anonymous table rows in value position.
fn stamp_table_rows(store: NodeStore, expr: Expr, sname: string) -> Expr {
    match expr {
        .ListLit(rows) -> .ListLit(stamp_table_row_list(rows, sname))
        .Block(body) -> .Block(stamp_block_tail(store, body, sname))
        .IfExpr(c, t, e) -> .IfExpr(c, store.exprs.add_leaf(stamp_table_rows(store, store.exprs.get(t), sname)), store.exprs.add_leaf(stamp_table_rows(store, store.exprs.get(e), sname)))
        .MatchExpr(subj, arms) -> .MatchExpr(subj, stamp_table_match_arms(store, arms, sname))
        .When(arms) -> .When(stamp_table_when_arms(store, arms, sname))
        _ -> expr
    }
}

/// Map the row-stamp over each `SExpr` row in a table's ListLit.
fn stamp_table_row_list(rows: List<SExpr>, sname: string) -> List<SExpr> {
    list_map(rows, (se: SExpr) -> sexpr(stamp_table_row(se.node, sname), se.line, se.col))
}

/// Stamp `sname` onto one anonymous `StructLit("")`; leave named rows
/// (and any non-StructLit element) alone so this is safe to run over an
/// ordinary list literal that merely happens to share the position.
fn stamp_table_row(row: Expr, sname: string) -> Expr {
    match row {
        .StructLit(n, inits) -> if n == "" { Expr.StructLit(sname, inits) } else { row }
        _ -> row
    }
}

/// Stamp the tail (last) statement of a block when it is an expression.
fn stamp_block_tail(store: NodeStore, body: List<SStmt>, sname: string) -> List<SStmt> {
    let n = body.length
    if n == 0 { return body }
    mut out: List<SStmt> = []
    mut i = 0
    while i < n {
        let ss = body[i]
        if i == n - 1 {
            match ss.node {
                .Expr(e) -> out.push(sstmt_at(Stmt.Expr(store.reexpr(stamp_table_rows(store, store.exprs.get(e), sname), e)), ss.line, ss.col, ss.file))
                _ -> out.push(ss)
            }
        } else {
            out.push(ss)
        }
        i = i + 1
    }
    out
}

/// Stamp each match-arm body (arms are in tail position when the match is).
fn stamp_table_match_arms(store: NodeStore, arms: List<MatchArm>, sname: string) -> List<MatchArm> {
    list_map(arms, (arm: MatchArm) -> MatchArm {
        pattern: arm.pattern,
        guard: arm.guard,
        body: sexpr(stamp_table_rows(store, arm.body.node, sname), arm.body.line, arm.body.col),
    })
}

/// Stamp each `when`-arm body.
fn stamp_table_when_arms(store: NodeStore, arms: List<WhenArm>, sname: string) -> List<WhenArm> {
    list_map(arms, (arm: WhenArm) -> WhenArm {
        cond: arm.cond,
        body: sexpr(stamp_table_rows(store, arm.body.node, sname), arm.body.line, arm.body.col),
    })
}

/// Walk a function body stamping the return type onto tables in `return`
/// statements (at any depth reachable through block / if) and in the
/// body's tail expression.
fn lower_fn_returns(store: NodeStore, body: List<StmtId>, rvt: ValueType) -> List<StmtId> {
    let sname = vtype_struct_name(vtype_list_elem(rvt))
    if sname == "" { return body }
    lower_return_stmt_ids(store, body, sname)
}

/// Apply return/tail stamping to a body's rows; only the final row is a
/// tail (implicit-return) position. Rewritten rows re-allocate.
fn lower_return_stmt_ids(store: NodeStore, ids: List<StmtId>, sname: string) -> List<StmtId> {
    let n = ids.length
    mut out: List<StmtId> = []
    mut i = 0
    while i < n {
        let id = ids[i]
        let is_tail = i == n - 1
        out.push(store.restmt(lower_return_stmt(store, store.stmts.get(id), sname, is_tail), id))
        i = i + 1
    }
    out
}

/// Stamp tables in `return e` (always) and in a tail expression / tail
/// match (only when `is_tail`). Recurses through block and if so a
/// `return table { ... }` nested in those positions still resolves.
fn lower_return_stmt(store: NodeStore, stmt: Stmt, sname: string, is_tail: bool) -> Stmt {
    match stmt {
        .Return(e) -> Stmt.Return(store.reexpr(stamp_table_rows(store, store.exprs.get(e), sname), e))
        .Expr(e) -> if is_tail { Stmt.Expr(store.reexpr(stamp_table_rows(store, store.exprs.get(e), sname), e)) } else { stmt }
        .Block(body) -> Stmt.Block(lower_return_stmt_ids(store, body, sname))
        .If(cond, then_b, else_b) -> {
            let nt = store.restmt(lower_return_stmt(store, store.stmts.get(then_b), sname, is_tail), then_b)
            if else_b != null {
                Stmt.If(cond, nt, store.restmt(lower_return_stmt(store, store.stmts.get(else_b!), sname, is_tail), else_b!))
            } else {
                Stmt.If(cond, nt, null)
            }
        }
        .Match(subj, arms) -> if is_tail { Stmt.Match(subj, stamp_table_match_arms(store, arms, sname)) } else { stmt }
        _ -> stmt
    }
}

// ── Expression desugaring ──

/// Two-phase expression desugar: first apply local rewrites at this
/// node (`rewrite_expr`), then recurse into all sub-expressions
/// (`walk_expr`). Local-then-recurse ordering means rewritten output
/// gets desugared again — `assert(dbg(x))` works.
fn desugar_expr(store: NodeStore, expr: Expr, sigs: List<FnSig>) -> Expr {
    let rewritten = rewrite_expr(store, expr)
    walk_expr(store, rewritten, sigs)
}

/// Local rewrites that fire for one node only. Currently dispatches
/// to `rewrite_call` for sugar built-ins (assert, dbg, …). Other
/// expressions pass through to `walk_expr` for structural recursion.
fn rewrite_expr(store: NodeStore, expr: Expr) -> Expr {
    match expr {
        .Call(callee, args) -> rewrite_call(store, expr, callee, args)
        _ -> expr
    }
}

/// Dispatch a call expression to the right `desugar_*` rewriter
/// when its callee is a known sugar builtin. Plain calls pass
/// through unchanged so user-defined `assert`/`dbg` shadowing works.
fn rewrite_call(store: NodeStore, original: Expr, callee: Expr, args: List<SExpr>) -> Expr {
    let name = match callee { .Ident(n) -> n, _ -> "" }
    match name {
        "assert" -> desugar_assert(store, args)
        "dbg" -> desugar_dbg(store, args)
        "todo" -> desugar_todo(store, args)
        "unreachable" -> desugar_unreachable(store, args)
        "min" -> desugar_min_max(store, args, true)
        "max" -> desugar_min_max(store, args, false)
        _ -> original
    }
}

/// Rewrite `assert(cond)` / `assert(cond, msg)` into
/// `if !cond { panic(msg) } else null`. Default message is
/// `"assertion failed"`. Calls without args become a panic so the
/// failure surfaces immediately.
fn desugar_assert(store: NodeStore, args: List<SExpr>) -> Expr {
    if args.length == 0 {
        let panic_args: List<SExpr> = [sexpr_dummy(Expr.String("\"assert: no condition\""))]
        return Expr.Call(Expr.Ident("panic"), panic_args)
    }
    let cond = args[0].node
    let msg = if args.length > 1 { args[1].node } else { Expr.String("\"assertion failed\"") }
    let panic_args: List<SExpr> = [sexpr_dummy(msg)]
    Expr.IfExpr(
        store.exprs.add_leaf(Expr.Unary(UnOp.Not, store.exprs.add_leaf(cond))),
        store.exprs.add_leaf(Expr.Call(Expr.Ident("panic"), panic_args)),
        store.exprs.add_leaf(Expr.None)
    )
}

/// Rewrite `dbg(expr)` into `{ let __dbg = expr;
/// println("[dbg] " + string(__dbg)); __dbg }`. Side-effect-once on
/// `expr`, returns the value so `dbg` can be chained mid-pipeline.
/// The synthesized statements' payload rows are fresh leaves.
fn desugar_dbg(store: NodeStore, args: List<SExpr>) -> Expr {
    if args.length == 0 {
        let panic_args: List<SExpr> = [sexpr_dummy(Expr.String("\"dbg: no argument\""))]
        return Expr.Call(Expr.Ident("panic"), panic_args)
    }
    let val = args[0].node
    let string_args: List<SExpr> = [sexpr_dummy(Expr.Ident("__dbg"))]
    let print_arg = Expr.Binary(
        store.exprs.add_leaf(Expr.String("\"[dbg] \"")),
        BinOp.Add,
        store.exprs.add_leaf(Expr.Call(Expr.Ident("string"), string_args))
    )
    let println_args: List<SExpr> = [sexpr_dummy(print_arg)]
    let body: List<SStmt> = [
        sstmt(Stmt.Let("__dbg", ValueType.Unknown, store.exprs.add_leaf(val)), 0, 0),
        sstmt(Stmt.Expr(store.exprs.add_leaf(Expr.Call(Expr.Ident("println"), println_args))), 0, 0),
        sstmt(Stmt.Expr(store.exprs.add_leaf(Expr.Ident("__dbg"))), 0, 0),
    ]
    Expr.Block(body)
}

/// Rewrite `todo()` / `todo("message")` into a `panic` with a
/// `"not yet implemented"` prefix.
fn desugar_todo(store: NodeStore, args: List<SExpr>) -> Expr {
    let msg = if args.length > 0 {
        Expr.Binary(store.exprs.add_leaf(Expr.String("\"not yet implemented: \"")), BinOp.Add, store.exprs.add_leaf(args[0].node))
    } else {
        Expr.String("\"not yet implemented\"")
    }
    let panic_args: List<SExpr> = [sexpr_dummy(msg)]
    Expr.Call(Expr.Ident("panic"), panic_args)
}

/// Rewrite `unreachable()` / `unreachable("reason")` into a `panic`
/// with `"unreachable code reached"` prefix. For impossible code
/// paths the type-checker can't yet prove dead.
fn desugar_unreachable(store: NodeStore, args: List<SExpr>) -> Expr {
    let msg = if args.length > 0 {
        Expr.Binary(store.exprs.add_leaf(Expr.String("\"unreachable: \"")), BinOp.Add, store.exprs.add_leaf(args[0].node))
    } else {
        Expr.String("\"unreachable code reached\"")
    }
    let panic_args: List<SExpr> = [sexpr_dummy(msg)]
    Expr.Call(Expr.Ident("panic"), panic_args)
}

/// Rewrite `min(a, b)` / `max(a, b)` into a let-binding block that
/// evaluates each operand once, then picks the appropriate side via
/// `IfExpr`. `is_min` chooses the comparison op (`<` for min, `>`
/// for max). Wrong arity panics.
fn desugar_min_max(store: NodeStore, args: List<SExpr>, is_min: int) -> Expr {
    if args.length < 2 {
        let panic_args: List<SExpr> = [sexpr_dummy(Expr.String("\"min/max requires 2 arguments\""))]
        return Expr.Call(Expr.Ident("panic"), panic_args)
    }
    let a_se = args[0]
    let b_se = args[1]
    let op = if is_min { BinOp.Lt } else { BinOp.Gt }
    let pick = Expr.IfExpr(
        store.exprs.add_leaf(Expr.Binary(store.exprs.add_leaf(Expr.Ident("__a")), op, store.exprs.add_leaf(Expr.Ident("__b")))),
        store.exprs.add_leaf(Expr.Ident("__a")),
        store.exprs.add_leaf(Expr.Ident("__b"))
    )
    let body: List<SStmt> = [
        sstmt(Stmt.Let("__a", ValueType.Unknown, store.exprs.add_leaf(a_se.node)), 0, 0),
        sstmt(Stmt.Let("__b", ValueType.Unknown, store.exprs.add_leaf(b_se.node)), 0, 0),
        sstmt(Stmt.Expr(store.exprs.add_leaf(pick)), 0, 0),
    ]
    Expr.Block(body)
}

// ── Generic expression walker ──

/// Generic structural walker — recurses into every sub-expression
/// of `expr`, applying `desugar_expr` (which itself runs
/// `rewrite_expr` followed by `walk_expr`). Leaf expressions
/// without sub-nodes pass through unchanged.
fn walk_expr(store: NodeStore, expr: Expr, sigs: List<FnSig>) -> Expr {
    match expr {
        .Binary(l, op, r) -> .Binary(desugar_expr_id(store, l, sigs), op, desugar_expr_id(store, r, sigs))
        .Unary(op, r) -> .Unary(op, desugar_expr_id(store, r, sigs))
        .Logical(l, op, r) -> .Logical(desugar_expr_id(store, l, sigs), op, desugar_expr_id(store, r, sigs))
        // Call args: desugar each arg, then pin any anonymous table row
        // to the callee's declared `List<Row>` parameter type (c080).
        .Call(callee, args) -> .Call(desugar_expr(store, callee, sigs), stamp_call_arg_tables(store, callee, desugar_expr_list(store, args, sigs), sigs))
        .Grouping(inner) -> .Grouping(desugar_expr_id(store, inner, sigs))
        .Assign(name, val) -> .Assign(name, desugar_expr_id(store, val, sigs))
        .Index(obj, idx) -> .Index(desugar_expr_id(store, obj, sigs), desugar_expr_id(store, idx, sigs))
        .FieldAccess(obj, field) -> .FieldAccess(desugar_expr_id(store, obj, sigs), field)
        .FieldAssign(obj, field, val) -> .FieldAssign(desugar_expr_id(store, obj, sigs), field, desugar_expr_id(store, val, sigs))
        .IfExpr(c, t, e) -> .IfExpr(desugar_expr_id(store, c, sigs), desugar_expr_id(store, t, sigs), desugar_expr_id(store, e, sigs))
        .Block(body) -> .Block(desugar_stmt_list(store, body, sigs))
        .NullCoalesce(l, r) -> .NullCoalesce(desugar_expr_id(store, l, sigs), desugar_expr_id(store, r, sigs))
        .OptionalChain(obj, field) -> .OptionalChain(desugar_expr_id(store, obj, sigs), field)
        .OptionalMethodCall(obj, method, args) -> .OptionalMethodCall(desugar_expr(store, obj, sigs), method, desugar_expr_list(store, args, sigs))
        .Try(inner) -> .Try(desugar_expr_id(store, inner, sigs))
        .Tuple(elems) -> .Tuple(desugar_expr_list(store, elems, sigs))
        .TupleIndex(obj, idx) -> .TupleIndex(desugar_expr_id(store, obj, sigs), idx)
        .ListLit(elems) -> .ListLit(desugar_expr_list(store, elems, sigs))
        .MapLit(entries) -> .MapLit(desugar_expr_list(store, entries, sigs))
        .Slice(obj, s, e) -> .Slice(desugar_expr_id(store, obj, sigs), desugar_expr_id(store, s, sigs), desugar_expr_id(store, e, sigs))
        .With(obj, overrides) -> .With(desugar_expr(store, obj, sigs), desugar_field_inits(store, overrides, sigs))
        .Lambda(params, body) -> .Lambda(params, desugar_expr(store, body, sigs))
        .MatchExpr(subj, arms) -> .MatchExpr(desugar_expr(store, subj, sigs), desugar_match_arms(store, arms, sigs))
        .When(arms) -> .When(desugar_when_arms(store, arms, sigs))
        .InCheck(needle, items) -> .InCheck(desugar_expr(store, needle, sigs), desugar_expr_list(store, items, sigs))
        .IsCheck(subj, variant) -> .IsCheck(desugar_expr_id(store, subj, sigs), variant)
        .ListComp(body, var, coll, filter) -> {
            // Recurse into body / coll / filter so sugar inside the
            // comprehension (assert, dbg, min, max, …) still gets
            // desugared. Without this, `[assert(x > 0) for x in xs]`
            // would leave the assert call intact.
            let new_filter = if filter != null { desugar_expr(store, filter!, sigs) } else { null }
            .ListComp(desugar_expr(store, body, sigs), var, desugar_expr(store, coll, sigs), new_filter)
        }
        // Forms that hold sub-expressions and were silently dropped
        // by the old `_ -> expr` fallthrough. Same root cause as the
        // mono + escape + closure walker bugs: sugar inside any of
        // these stayed as raw calls (e.g. `Foo { x: assert(p) }` left
        // `assert` as an unresolved fn name).
        .StructLit(name, inits) -> .StructLit(name, desugar_field_inits(store, inits, sigs))
        .EnumCtor(tn, variant, args) -> .EnumCtor(tn, variant, desugar_expr_list(store, args, sigs))
        .GenericCall(callee, type_args, args) -> .GenericCall(desugar_expr(store, callee, sigs), type_args, desugar_expr_list(store, args, sigs))
        .Catch(inner, binding, body, l, c) -> .Catch(desugar_expr(store, inner, sigs), binding, desugar_expr(store, body, sigs), l, c)
        .Spawn(body) -> .Spawn(desugar_expr_id(store, body, sigs))
        .Isolated(body) -> .Isolated(desugar_expr_id(store, body, sigs))
        .Quote(kind, body) -> .Quote(kind, desugar_expr(store, body, sigs))
        .Splice(target) -> .Splice(desugar_expr_id(store, target, sigs))
        _ -> expr
    }
}

/// Map `desugar_expr` over every element of a `List<SExpr>`,
/// preserving span info on each rewritten node.
fn desugar_expr_list(store: NodeStore, list: List<SExpr>, sigs: List<FnSig>) -> List<SExpr> {
    list_map(list, (se: SExpr) -> sexpr(desugar_expr(store, se.node, sigs), se.line, se.col))
}

/// Walk a `List<MatchArm>` desugaring each arm's guard (when
/// present) and body. Patterns are not desugared — they're already
/// in canonical form.
fn desugar_match_arms(store: NodeStore, arms: List<MatchArm>, sigs: List<FnSig>) -> List<MatchArm> {
    list_map(arms, (arm: MatchArm) -> {
        let new_guard = if arm.guard != null {
            sexpr(desugar_expr(store, arm.guard!.node, sigs), arm.guard!.line, arm.guard!.col)
        } else { null }
        MatchArm {
            pattern: arm.pattern,
            guard: new_guard,
            body: sexpr(desugar_expr(store, arm.body.node, sigs), arm.body.line, arm.body.col),
        }
    })
}

/// Walk a `when` arm list desugaring each arm's condition and body.
/// `when` arms have an optional condition (the `else` arm is null).
fn desugar_when_arms(store: NodeStore, arms: List<WhenArm>, sigs: List<FnSig>) -> List<WhenArm> {
    list_map(arms, (arm: WhenArm) -> WhenArm {
        cond: if arm.cond != null { sexpr(desugar_expr(store, arm.cond!.node, sigs), arm.cond!.line, arm.cond!.col) } else { null },
        body: sexpr(desugar_expr(store, arm.body.node, sigs), arm.body.line, arm.body.col),
    })
}

/// Walk a `List<FieldInit>` (used by struct literals and `with`
/// exprs) desugaring each value while keeping field name + span
/// intact.
fn desugar_field_inits(store: NodeStore, inits: List<FieldInit>, sigs: List<FnSig>) -> List<FieldInit> {
    list_map(inits, (init: FieldInit) -> FieldInit {
        name: init.name,
        value: sexpr(desugar_expr(store, init.value.node, sigs), init.value.line, init.value.col),
    })
}
