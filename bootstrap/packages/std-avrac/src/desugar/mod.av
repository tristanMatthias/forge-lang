// WHY: AST-to-AST rewrite pass that runs BETWEEN component expansion and resolving.
//
// The desugar pass rewrites expression-level sugar (assert, dbg, min, max, etc.)
// into simpler AST forms. The resolver, typechecker, and codegen never see
// the sugared forms.
//
// Component expansion is a SEPARATE pass that runs before desugar.
// See features/component_decl/expand.av.

use core.{Expr, ExprList, Stmt, StmtList, SExpr, SStmt, sexpr, sexpr_dummy, sstmt, sstmt_at, sstmt_dummy, stmt_unwrap, FieldList, FieldInitList, MatchArmList, WhenArmList, PatternList, ParamList, Pattern, BinOp, UnOp, ValueType, VariantList, TypeParamList}

// ── Public API ──

/// Top-level desugar entry. Injects compiler intrinsics first
/// (currently `Result<T, E>` when missing — see `inject_intrinsics`),
/// then walks the statement list rewriting expression-level sugar
/// (`assert`, `dbg`, `todo`, `unreachable`, `min`, `max`, list
/// comprehensions). Idempotent: calling again on already-desugared
/// AST is a no-op.
export fn desugar_program(stmts: StmtList) -> StmtList {
    desugar_stmt_list(inject_intrinsics(stmts))
}

// ── Intrinsic injection ──
// Result<T, E> ships with the language but isn't auto-loaded like a
// stdlib module. Self-compiling the bootstrap finds it via
// `features/error_propagation/mod.av`; user programs (and the test
// runner that wraps test files in Modules) wouldn't otherwise see it,
// so we synthesize the declaration when missing.
//
// This also fixes forge-crafting-intepreters-xks4: a trait impl
// returning Result inside a Module-wrapped @std package mis-qualifies
// `Result` as `<wrap>::@std::<pkg>::Result` because the resolver can't
// find Result in any module's items. Injecting it at the top level
// (outside any Module) puts it in the global index and the resolver
// keeps it bare.

/// Inject `Result<T, E>` into the program when the user hasn't
/// declared it. Self-compiling the bootstrap finds Result via
/// `features/error_propagation/mod.av`; Module-wrapped user programs
/// (and the test runner's per-file Module wrapper) wouldn't otherwise
/// see it. Putting the synthesized decl at the global scope also
/// fixes ticket xks4 (resolver mis-qualification of `Result` inside
/// trait impls).
fn inject_intrinsics(stmts: StmtList) -> StmtList {
    if program_declares_enum(stmts, "Result") { return stmts }
    StmtList.Node(sstmt_dummy(synthesize_result_enum()), stmts)
}

/// Build the synthetic `enum Result<T, E> { Ok(value: T), Err(error: E) }`
/// AST node used by `inject_intrinsics`.
fn synthesize_result_enum() -> Stmt {
    let t = ValueType.Struct("T", 0)
    let e = ValueType.Struct("E", 0)
    let ok_fields = FieldList.Node("value", t, FieldList.End)
    let err_fields = FieldList.Node("error", e, FieldList.End)
    let variants = VariantList.Node(
        "Ok", ok_fields,
        VariantList.Node("Err", err_fields, VariantList.End)
    )
    let type_params = TypeParamList.Node(
        "T", "",
        TypeParamList.Node("E", "", TypeParamList.End)
    )
    Stmt.EnumDecl("Result", type_params, variants)
}

/// True when a top-level `EnumDecl` named `target` exists in the
/// program (or any nested Module). Used to skip Result injection
/// when the user has already declared it.
fn program_declares_enum(stmts: StmtList, target: string) -> bool {
    match stmts {
        .End -> false
        .Node(ss, next) -> {
            match stmt_unwrap(ss.node) {
                .EnumDecl(name, _, _) if name == target -> true
                .Module(_, body) if program_declares_enum(body, target) -> true
                _ -> program_declares_enum(next, target)
            }
        }
    }
}

// ── Statement desugaring ──

/// Map `desugar_stmt` over every element of a StmtList, preserving
/// span info on each rewritten node.
fn desugar_stmt_list(stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> {
            let new_stmt = desugar_stmt(ss.node)
            StmtList.Node(sstmt_at(new_stmt, ss.line, ss.col, ss.file), desugar_stmt_list(next))
        }
    }
}

/// Desugar a single statement. For control-flow / declaration
/// statements we recurse into their expression and body fields;
/// statements with no rewritable payload pass through unchanged.
fn desugar_stmt(stmt: Stmt) -> Stmt {
    match stmt {
        .Expr(e) -> .Expr(desugar_expr(e))
        .Let(name, vt, init) -> .Let(name, vt, desugar_expr(init))
        .Mut(name, vt, init) -> .Mut(name, vt, desugar_expr(init))
        .Return(e) -> .Return(desugar_expr(e))
        .Block(body) -> .Block(desugar_stmt_list(body))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(desugar_expr(cond), desugar_stmt(then_b), desugar_stmt(else_b!))
            } else {
                .If(desugar_expr(cond), desugar_stmt(then_b), null)
            }
        }
        .While(cond, body) -> .While(desugar_expr(cond), desugar_stmt(body))
        .For(v, start, end, body) -> .For(v, desugar_expr(start), desugar_expr(end), desugar_stmt(body))
        .ForIn(v, coll, body) -> .ForIn(v, desugar_expr(coll), desugar_stmt(body))
        .Match(subj, arms) -> .Match(desugar_expr(subj), desugar_match_arms(arms))
        .Function(name, tp, params, rvt, body) -> .Function(name, tp, params, rvt, desugar_stmt_list(body))
        .Defer(body) -> .Defer(desugar_expr(body))
        .Errdefer(body) -> .Errdefer(desugar_expr(body))
        .Module(name, body) -> .Module(name, desugar_stmt_list(body))
        .Annotated(annots, inner) -> .Annotated(annots, desugar_stmt(inner))
        .SpecBlock(name, body) -> .SpecBlock(name, desugar_stmt_list(body))
        .GivenBlock(name, body) -> .GivenBlock(name, desugar_stmt_list(body))
        .ThenBlock(name, cond) -> .ThenBlock(name, desugar_expr(cond))
        _ -> stmt
    }
}

// ── Expression desugaring ──

/// Two-phase expression desugar: first apply local rewrites at this
/// node (`rewrite_expr`), then recurse into all sub-expressions
/// (`walk_expr`). Local-then-recurse ordering means rewritten output
/// gets desugared again — `assert(dbg(x))` works.
fn desugar_expr(expr: Expr) -> Expr {
    let rewritten = rewrite_expr(expr)
    walk_expr(rewritten)
}

/// Local rewrites that fire for one node only. Currently dispatches
/// to `rewrite_call` for sugar built-ins (assert, dbg, …) and to
/// `rewrite_list_lit` for list comprehensions wrapped in a list
/// literal. All other expressions pass through.
fn rewrite_expr(expr: Expr) -> Expr {
    match expr {
        .Call(callee, args) -> rewrite_call(expr, callee, args)
        .ListLit(elems) -> rewrite_list_lit(expr, elems)
        _ -> expr
    }
}

/// Rewrite `[for x in coll if filter -> body]` (a single-element
/// ListLit wrapping a ListComp) into the imperative
/// `mut __lc = []; for x in coll { if filter { __lc.push(body) } }; __lc`
/// block expression. Plain list literals are untouched.
fn rewrite_list_lit(original: Expr, elems: ExprList) -> Expr {
    match elems {
        .Node(se, _) -> {
            match se.node {
                .ListComp(body, variable, collection, filter) -> {
                    let push_expr = Expr.Call(
                        Expr.FieldAccess(Expr.Ident("__lc"), "push"),
                        ExprList.Node(sexpr_dummy(body), ExprList.End)
                    )
                    let push_stmt = if filter != null {
                        Stmt.If(filter!, Stmt.Expr(push_expr), null)
                    } else {
                        Stmt.Expr(push_expr)
                    }
                    Expr.Block(StmtList.Node(
                        sstmt(Stmt.Mut("__lc", ValueType.Unknown, Expr.ListLit(ExprList.End)), 0, 0),
                        StmtList.Node(
                            sstmt(Stmt.ForIn(variable, collection, push_stmt), 0, 0),
                            StmtList.Node(
                                sstmt(Stmt.Expr(Expr.Ident("__lc")), 0, 0),
                                StmtList.End
                            )
                        )
                    ))
                }
                _ -> original
            }
        }
        _ -> original
    }
}

/// Dispatch a call expression to the right `desugar_*` rewriter
/// when its callee is a known sugar builtin. Plain calls pass
/// through unchanged so user-defined `assert`/`dbg` shadowing works.
fn rewrite_call(original: Expr, callee: Expr, args: ExprList) -> Expr {
    let name = match callee { .Ident(n) -> n, _ -> "" }
    match name {
        "assert" -> desugar_assert(args)
        "dbg" -> desugar_dbg(args)
        "todo" -> desugar_todo(args)
        "unreachable" -> desugar_unreachable(args)
        "min" -> desugar_min_max(args, true)
        "max" -> desugar_min_max(args, false)
        _ -> original
    }
}

/// Rewrite `assert(cond)` / `assert(cond, msg)` into
/// `if !cond { panic(msg) } else null`. Default message is
/// `"assertion failed"`. Calls without args become a panic so the
/// failure surfaces immediately.
fn desugar_assert(args: ExprList) -> Expr {
    match args {
        .Node(cond_se, rest) -> {
            let cond = cond_se.node
            let msg = match rest {
                .Node(msg_se, _) -> msg_se.node
                _ -> Expr.String("\"assertion failed\"")
            }
            Expr.IfExpr(
                Expr.Unary(UnOp.Not, cond),
                Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(msg), ExprList.End)),
                Expr.Null
            )
        }
        _ -> Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(Expr.String("\"assert: no condition\"")), ExprList.End))
    }
}

/// Rewrite `dbg(expr)` into `{ let __dbg = expr;
/// println("[dbg] " + string(__dbg)); __dbg }`. Side-effect-once on
/// `expr`, returns the value so `dbg` can be chained mid-pipeline.
fn desugar_dbg(args: ExprList) -> Expr {
    match args {
        .Node(val_se, _) -> {
            let val = val_se.node
            let print_arg = Expr.Binary(
                Expr.String("\"[dbg] \""),
                BinOp.Add,
                Expr.Call(Expr.Ident("string"), ExprList.Node(sexpr_dummy(Expr.Ident("__dbg")), ExprList.End))
            )
            Expr.Block(StmtList.Node(
                sstmt(Stmt.Let("__dbg", ValueType.Unknown, val), 0, 0),
                StmtList.Node(
                    sstmt(Stmt.Expr(
                        Expr.Call(Expr.Ident("println"), ExprList.Node(
                            sexpr_dummy(print_arg),
                            ExprList.End
                        ))
                    ), 0, 0),
                    StmtList.Node(
                        sstmt(Stmt.Expr(Expr.Ident("__dbg")), 0, 0),
                        StmtList.End
                    )
                )
            ))
        }
        _ -> Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(Expr.String("\"dbg: no argument\"")), ExprList.End))
    }
}

/// Rewrite `todo()` / `todo("message")` into a `panic` with a
/// `"not yet implemented"` prefix.
fn desugar_todo(args: ExprList) -> Expr {
    let msg = match args {
        .Node(se, _) -> Expr.Binary(Expr.String("\"not yet implemented: \""), BinOp.Add, se.node)
        _ -> Expr.String("\"not yet implemented\"")
    }
    Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(msg), ExprList.End))
}

/// Rewrite `unreachable()` / `unreachable("reason")` into a `panic`
/// with `"unreachable code reached"` prefix. For impossible code
/// paths the type-checker can't yet prove dead.
fn desugar_unreachable(args: ExprList) -> Expr {
    let msg = match args {
        .Node(se, _) -> Expr.Binary(Expr.String("\"unreachable: \""), BinOp.Add, se.node)
        _ -> Expr.String("\"unreachable code reached\"")
    }
    Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(msg), ExprList.End))
}

/// Rewrite `min(a, b)` / `max(a, b)` into a let-binding block that
/// evaluates each operand once, then picks the appropriate side via
/// `IfExpr`. `is_min` chooses the comparison op (`<` for min, `>`
/// for max). Wrong arity panics.
fn desugar_min_max(args: ExprList, is_min: int) -> Expr {
    match args {
        .Node(a_se, rest) -> {
            match rest {
                .Node(b_se, _) -> {
                    let op = if is_min { BinOp.Lt } else { BinOp.Gt }
                    Expr.Block(StmtList.Node(
                        sstmt(Stmt.Let("__a", ValueType.Unknown, a_se.node), 0, 0),
                        StmtList.Node(
                            sstmt(Stmt.Let("__b", ValueType.Unknown, b_se.node), 0, 0),
                            StmtList.Node(
                                sstmt(Stmt.Expr(
                                    Expr.IfExpr(
                                        Expr.Binary(Expr.Ident("__a"), op, Expr.Ident("__b")),
                                        Expr.Ident("__a"),
                                        Expr.Ident("__b")
                                    )
                                ), 0, 0),
                                StmtList.End
                            )
                        )
                    ))
                }
                _ -> Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(Expr.String("\"min/max requires 2 arguments\"")), ExprList.End))
            }
        }
        _ -> Expr.Call(Expr.Ident("panic"), ExprList.Node(sexpr_dummy(Expr.String("\"min/max requires 2 arguments\"")), ExprList.End))
    }
}

// ── Generic expression walker ──

/// Generic structural walker — recurses into every sub-expression
/// of `expr`, applying `desugar_expr` (which itself runs
/// `rewrite_expr` followed by `walk_expr`). Leaf expressions
/// without sub-nodes pass through unchanged.
fn walk_expr(expr: Expr) -> Expr {
    match expr {
        .Binary(l, op, r) -> .Binary(desugar_expr(l), op, desugar_expr(r))
        .Unary(op, r) -> .Unary(op, desugar_expr(r))
        .Logical(l, op, r) -> .Logical(desugar_expr(l), op, desugar_expr(r))
        .Call(callee, args) -> .Call(desugar_expr(callee), desugar_expr_list(args))
        .Grouping(inner) -> .Grouping(desugar_expr(inner))
        .Assign(name, val) -> .Assign(name, desugar_expr(val))
        .Index(obj, idx) -> .Index(desugar_expr(obj), desugar_expr(idx))
        .FieldAccess(obj, field) -> .FieldAccess(desugar_expr(obj), field)
        .FieldAssign(obj, field, val) -> .FieldAssign(desugar_expr(obj), field, desugar_expr(val))
        .IfExpr(c, t, e) -> .IfExpr(desugar_expr(c), desugar_expr(t), desugar_expr(e))
        .Block(body) -> .Block(desugar_stmt_list(body))
        .NullCoalesce(l, r) -> .NullCoalesce(desugar_expr(l), desugar_expr(r))
        .OptionalChain(obj, field) -> .OptionalChain(desugar_expr(obj), field)
        .Try(inner) -> .Try(desugar_expr(inner))
        .Tuple(elems) -> .Tuple(desugar_expr_list(elems))
        .TupleIndex(obj, idx) -> .TupleIndex(desugar_expr(obj), idx)
        .ListLit(elems) -> .ListLit(desugar_expr_list(elems))
        .MapLit(entries) -> .MapLit(desugar_expr_list(entries))
        .Slice(obj, s, e) -> .Slice(desugar_expr(obj), desugar_expr(s), desugar_expr(e))
        .With(obj, overrides) -> .With(desugar_expr(obj), desugar_field_inits(overrides))
        .Lambda(params, body) -> .Lambda(params, desugar_expr(body))
        .MatchExpr(subj, arms) -> .MatchExpr(desugar_expr(subj), desugar_match_arms(arms))
        .When(arms) -> .When(desugar_when_arms(arms))
        .InCheck(needle, items) -> .InCheck(desugar_expr(needle), desugar_expr_list(items))
        .IsCheck(subj, variant) -> .IsCheck(desugar_expr(subj), variant)
        _ -> expr
    }
}

/// Map `desugar_expr` over every element of an ExprList,
/// preserving span info on each rewritten node.
fn desugar_expr_list(list: ExprList) -> ExprList {
    match list {
        .End -> ExprList.End
        .Node(se, next) -> ExprList.Node(sexpr(desugar_expr(se.node), se.line, se.col), desugar_expr_list(next))
    }
}

/// Walk a MatchArmList desugaring each arm's guard (when present)
/// and body. Patterns are not desugared — they're already in
/// canonical form.
fn desugar_match_arms(arms: MatchArmList) -> MatchArmList {
    match arms {
        .End -> MatchArmList.End
        .Node(pattern, guard, body, next) -> {
            let new_guard = if guard != null { sexpr(desugar_expr(guard!.node), guard!.line, guard!.col) } else { null }
            MatchArmList.Node(pattern, new_guard, sexpr(desugar_expr(body.node), body.line, body.col), desugar_match_arms(next))
        }
    }
}

/// Walk a WhenArmList desugaring each arm's condition and body.
/// `when` arms have an optional condition (the `else` arm is null).
fn desugar_when_arms(arms: WhenArmList) -> WhenArmList {
    match arms {
        .End -> WhenArmList.End
        .Node(cond, body, next) -> {
            let new_cond = if cond != null { sexpr(desugar_expr(cond!.node), cond!.line, cond!.col) } else { null }
            WhenArmList.Node(new_cond, sexpr(desugar_expr(body.node), body.line, body.col), desugar_when_arms(next))
        }
    }
}

/// Walk a FieldInitList (used by struct literals and `with` exprs)
/// desugaring each value while keeping field name + span intact.
fn desugar_field_inits(inits: FieldInitList) -> FieldInitList {
    match inits {
        .End -> FieldInitList.End
        .Node(name, sv, next) -> {
            let new_val = desugar_expr(sv.node)
            FieldInitList.Node(name, sexpr(new_val, sv.line, sv.col), desugar_field_inits(next))
        }
    }
}
