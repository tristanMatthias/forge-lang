// WHY: generic resource admission control (uzs9.10). Build, test, coverage,
// and diff-test schedulers use this one controller surface: callers describe
// a work profile and receive leases; none of them knows whether the host is Linux,
// macOS, cgroup-limited, or merely under pressure. Concurrency is an OUTPUT
// of available capacity, not a CI AVRA_JOBS setting.
//
// Four properties, in priority order:
//   1. Back-pressure, never SIGKILL — under pressure the pool stops
//      ADMITTING; running work is never killed and never orphans.
//   2. The serial floor — with nothing in flight the next unit is ALWAYS
//      admitted, so a tight box serialises (the sweep's one good property)
//      instead of deadlocking. One unit at a time is the graceful minimum.
//   3. Measure, don't assume — observed per-unit consumption RATCHETS the
//      live estimate upward, so a wrong constant self-heals into narrower
//      admissions instead of becoming a landmine.
//   4. Decisions are observable — pressure-episode transitions log one line
//      each, and `summary()` reports what happened (never per-unit spam).
//
// The math is integer MB throughout. One formula covers both regimes:
//
//     admit iff  avail - reserve - unrealized >= estimate
//     where used       = max(0, baseline - avail)
//           unrealized = max(0, estimate * in_flight - used)
//
// While admitted units are still allocating toward their estimates
// (used < estimate * in_flight) this reduces to budgeting their FULL
// commitment against the run-start baseline — so a burst of admissions in one
// round can't all read the same roomy sample and stack past the budget. Once
// in-flight usage has materialised (used >= commitment) it reduces to
// budgeting against LIVE avail — so a unit growing past its estimate shows up
// as reduced avail and throttles further admission automatically. Memory
// consumed by anything else on the box also lands in `used`, which only
// narrows admissions: every attribution error is in the safe direction.

use resources.{ResourceProfile, ResourceSnapshot, resource_profile_seed_mb, resource_snapshot, resource_width_cap}

/// The admission state for one pool run. Counters are mutated through
/// methods (structs are self-by-pointer), so the pool threads one governor
/// through every dispatch round and reads the tallies afterwards.
export type MemGovernor = {
    width_cap: int,          // static concurrency ceiling (>= 1 by construction)
    estimate_mb: int,        // live per-unit peak estimate; ratchets up, never below static
    static_estimate_mb: int, // the mode's baseline estimate, for the summary
    reserve_mb: int,         // headroom for the un-modelled: llc/cc1plus grandchildren, page cache
    baseline_avail_mb: int,  // usable memory at run start; <= 0 = unknown -> width-only
    min_avail_mb: int,       // observability: the tightest sample seen
    peak_width: int,         // observability: widest concurrent admission reached
    deferrals: int,          // decisions where a queued unit waited on the budget
    floor_admits: int,       // serial-floor admissions the budget alone would have refused
    corrections: int,        // estimate ratchets applied
    constrained_logged: bool, // the once-per-run "backing off"/"memory floor" line fired
    pressure_deferrals: int, // admissions held by a real platform pressure signal
    pressure_logged: bool,   // the once-per-run resource-pressure line fired
    observed_mb: int,        // max measured per-unit MB this run — UNSEEDED by any
                             // prior, so a persisted estimate can decay (see the
                             // prior helpers below) instead of ratcheting forever
}

export fn governor_for(width_cap: int, estimate_mb: int, reserve_mb: int, baseline_avail_mb: int) -> MemGovernor {
    MemGovernor {
        width_cap: if width_cap < 1 { 1 } else { width_cap },
        estimate_mb: if estimate_mb < 0 { 0 } else { estimate_mb },
        static_estimate_mb: if estimate_mb < 0 { 0 } else { estimate_mb },
        reserve_mb: if reserve_mb < 0 { 0 } else { reserve_mb },
        baseline_avail_mb: baseline_avail_mb,
        min_avail_mb: baseline_avail_mb,
        peak_width: 0,
        deferrals: 0,
        floor_admits: 0,
        corrections: 0,
        constrained_logged: false,
        pressure_deferrals: 0,
        pressure_logged: false,
        observed_mb: 0,
    }
}

/// Admission by idle-worker count alone — the pre-admission pool behaviour,
/// for pool callers that aren't scheduling against memory. `estimate_mb == 0`
/// makes every budget check pass and stops the pool from even sampling.
export fn governor_width_only(width_cap: int) -> MemGovernor {
    governor_for(width_cap, 0, 0, 0 - 1)
}

/// Construct the generic controller from an execution profile and the native
/// resource snapshot. This is the one policy boundary shared by test, build,
/// coverage, and future schedulers.
export fn resource_controller_for(width_cap: int, profile: ResourceProfile, normal_estimate_mb: int, reserve_mb: int) -> MemGovernor {
    resource_controller_for_snapshot(width_cap, profile, normal_estimate_mb, reserve_mb, resource_snapshot())
}

/// Snapshot-taking sibling for callers that need the initial resource report
/// and first admission to use the identical sample.
export fn resource_controller_for_snapshot(width_cap: int, profile: ResourceProfile, normal_estimate_mb: int, reserve_mb: int, snapshot: ResourceSnapshot) -> MemGovernor {
    governor_for(resource_width_cap(width_cap, snapshot), resource_profile_seed_mb(profile, normal_estimate_mb), reserve_mb, snapshot.available_mb)
}

impl MemGovernor {
    /// Whether this governor schedules against memory at all. The pool skips
    /// sampling entirely when it doesn't.
    fn has_model(self) -> bool { self.estimate_mb > 0 }

    /// What the run has consumed since its baseline, per the kernel. Zero
    /// when either number is unknown.
    fn used_mb(self, avail_mb: int) -> int {
        if self.baseline_avail_mb <= 0 || avail_mb <= 0 { return 0 }
        let d = self.baseline_avail_mb - avail_mb
        if d > 0 { d } else { 0 }
    }

    /// The pure budget decision — see the module header for the formula.
    /// Unknown avail or no model degrades to width-only admission.
    fn budget_admits(self, avail_mb: int, in_flight: int) -> bool {
        if !self.has_model() || avail_mb <= 0 { return true }
        let used = self.used_mb(avail_mb)
        let commitment = self.estimate_mb * in_flight
        let unrealized = if commitment > used { commitment - used } else { 0 }
        avail_mb - self.reserve_mb - unrealized >= self.estimate_mb
    }

    /// Per-round measurement: track the tightest sample and ratchet the
    /// per-unit estimate when measured consumption exceeds it. The ratchet
    /// only ever RAISES the estimate — a unit exceeding its model narrows
    /// future admissions; it is never killed for it (F4014's job, not ours).
    ///
    /// The reserve is SUBTRACTED from `used` before attributing to units: it
    /// already budgets the un-modelled consumers that run alongside them
    /// (orchestrator, page cache, the fixture compiles shards shell out).
    /// Folding those into the per-unit estimate would double-count the same
    /// spike — measured live: a ~1.8GB shard whose fixture children pushed
    /// `used` to ~8.4GB ratcheted the estimate to 8442MB, and est+reserve
    /// then serialised a box the static model runs at width 5. Overuse
    /// BEYOND the reserve still narrows admissions — the safe direction.
    fn observe(self, avail_mb: int, in_flight: int) {
        if avail_mb <= 0 { return }
        if self.min_avail_mb <= 0 || avail_mb < self.min_avail_mb { self.min_avail_mb = avail_mb }
        if in_flight < 1 {
            // Quiet pool: nothing of ours is running, so whatever the kernel
            // reports now IS the environment — re-anchor the baseline.
            // Without this, page-cache/slab growth from hundreds of shards'
            // artifacts depresses MemAvailable over a long single run, `used`
            // inflates regardless of true shard cost, and the ratchet
            // collapses width permanently (measured: CI rc-strict's one
            // 35-minute invocation ran the suite at 2098s vs the ~548s
            // baseline; local per-dir sweeps masked it because every dir got
            // a fresh baseline).
            self.baseline_avail_mb = avail_mb
            return
        }
        if !self.has_model() { return }
        let attributable = self.used_mb(avail_mb) - self.reserve_mb
        if attributable <= 0 {
            self.relax_estimate(0)
            return
        }
        let per_unit = attributable / in_flight
        if per_unit > self.observed_mb { self.observed_mb = per_unit }
        if per_unit <= self.estimate_mb {
            self.relax_estimate(per_unit)
            return
        }
        // Log only meaningful jumps; small creep would spam one line per ratchet.
        if per_unit - self.estimate_mb >= 128 {
            eprintln("[admission] per-unit estimate corrected ~${string(self.estimate_mb)}MB -> ~${string(per_unit)}MB (measured across ${string(in_flight)} in flight)")
        }
        self.estimate_mb = per_unit
        self.corrections = self.corrections + 1
    }

    /// The downward half of the correction, deliberately SLOWER than the
    /// instant upward ratchet: each fresh sample below the live estimate
    /// relaxes it a quarter of the gap toward that sample, floored at the
    /// mode's static number. Monotone ratcheting turned one transient
    /// attribution spike into a life sentence — width collapsed for the
    /// REST of a long run even after the pressure passed (the second half
    /// of the CI regression above). Asymmetry keeps the safety property:
    /// overshoot narrows immediately, recovery is gradual and evidence-led.
    fn relax_estimate(self, sample_mb: int) {
        let floor = if sample_mb > self.static_estimate_mb { sample_mb } else { self.static_estimate_mb }
        if self.estimate_mb <= floor { return }
        self.estimate_mb = (self.estimate_mb * 3 + floor) / 4
    }

    /// The byte allocation exported to a unit admitted at `width` in flight
    /// (itself included): its live estimate plus an equal share of the
    /// reserve. This is the ONE budget authority (t-kdyj.1 slice 3): the
    /// pool exports it to the admitted unit as AVRA_MEM_BUDGET_MB — a SOFT
    /// grant. The runtime's F4014 poll lets the tree exceed it freely while
    /// the box has slack (a cold whole-program fixture compile legitimately
    /// peaks ~7GB — a hard shard-sized cap F4014'd exactly that on CI), and
    /// trips only when the tree is over-budget AND MemAvailable has fallen
    /// under the runtime's near-cliff floor. KNOWN LIMIT (proven by the
    /// 2026-08-01 acceptance-proof container death): the grant is computed
    /// per TREE but the F4014 poll enforces it per PROCESS — a shard whose W
    /// test workers each shell a probe is W processes each entitled to the
    /// full grant, so no member trips however bad the box gets. The bound
    /// that actually holds under pressure is the runtime's compile slot gate
    /// (avra_compile_slot_gate, slice 4): every heavy bs2 process must hold
    /// one of a small set of flock slots while MemAvailable is under the
    /// box-scaled threshold, capping concurrent heavies box-wide no matter
    /// who spawned them. The grant remains the per-process ceiling input and
    /// the sizing signal for diagnose.sh's `_default_compile_slots`.
    /// Width-only governors return 0 = "export nothing"; those pools stay
    /// byte-identical to the pre-slice-3 behaviour.
    fn allocation_mb(self, width: int) -> int {
        if !self.has_model() { return 0 }
        let w = if width < 1 { 1 } else { width }
        self.estimate_mb + self.reserve_mb / w
    }


    /// One admission decision for the NEXT queued unit. Never blocks and
    /// never kills: a `false` means "ask again after a poll tick".
    ///
    /// Logging: the FIRST budget-constrained decision logs one line, and the
    /// end-of-run summary carries the tallies. Nothing logs per round or on
    /// "recovery" — a pool under a budget steady-states AT its constrained
    /// width, so any edge-triggered pair of lines flaps once per reap/refill
    /// cycle (observed live: 37 recovered/backing-off pairs in nine dirs).
    fn try_admit(self, avail_mb: int, in_flight: int) -> bool {
        if in_flight >= self.width_cap { return false }
        if self.budget_admits(avail_mb, in_flight) {
            self.record_admit(in_flight + 1)
            return true
        }
        if in_flight == 0 {
            // Serial floor: the budget says no but nothing is running, so
            // waiting could deadlock forever on a box under external
            // pressure. Admit exactly one — serialised is the graceful
            // worst case, and the F4014 self-ceiling still bounds it.
            self.floor_admits = self.floor_admits + 1
            if !self.constrained_logged {
                self.constrained_logged = true
                eprintln("[admission] memory floor: admitting 1 at a time (est ~${string(self.estimate_mb)}MB + reserve ${string(self.reserve_mb)}MB vs avail ${string(avail_mb)}MB)")
            }
            self.record_admit(1)
            return true
        }
        self.deferrals = self.deferrals + 1
        if !self.constrained_logged {
            self.constrained_logged = true
            eprintln("[admission] backing off: holding at ${string(in_flight)} in flight (est ~${string(self.estimate_mb)}MB, avail ${string(avail_mb)}MB, reserve ${string(self.reserve_mb)}MB)")
        }
        false
    }

    /// Pressure-aware admission around the pure byte-budget decision. PSI and
    /// macOS memory-pressure events are feedback, not a replacement for
    /// reservations: critical pressure permits only the serial floor, while
    /// elevated pressure holds the widest width already reached.
    fn try_admit_snapshot(self, snapshot: ResourceSnapshot, in_flight: int) -> bool {
        let pressure_blocks = if snapshot.pressure == 3 {
            in_flight > 0
        } else if snapshot.pressure == 2 {
            in_flight >= (if self.peak_width > 0 { self.peak_width } else { 1 })
        } else { false }
        if pressure_blocks {
            self.pressure_deferrals = self.pressure_deferrals + 1
            if !self.pressure_logged {
                self.pressure_logged = true
                let label = if snapshot.pressure == 3 { "critical" } else if snapshot.pressure == 2 { "elevated" } else { "unknown" }
                eprintln("[resources] ${label} memory pressure: holding new work at ${string(in_flight)} in flight")
            }
            return false
        }
        self.try_admit(snapshot.available_mb, in_flight)
    }

    fn record_admit(self, width: int) {
        if width <= self.peak_width { return }
        self.peak_width = width
    }

    /// Seed the live estimate from a persisted prior. Only ever RAISES it —
    /// the static mode estimate stays the floor — and does not touch
    /// `observed_mb`, which stays a pure measurement of THIS run.
    fn seed_estimate(self, prior_mb: int) {
        if prior_mb <= self.estimate_mb { return }
        self.estimate_mb = prior_mb
    }

    /// One line the orchestrator prints after the pool drains: what width the
    /// run reached, whether the model was corrected, and how tight it got.
    fn summary(self) -> string {
        let est = if self.corrections > 0 {
            "est ~${string(self.static_estimate_mb)}MB -> ~${string(self.estimate_mb)}MB (corrected)"
        } else {
            "est ~${string(self.estimate_mb)}MB"
        }
        let tail = if self.min_avail_mb > 0 { ", min avail ${string(self.min_avail_mb)}MB" } else { "" }
        let pressure = if self.pressure_deferrals > 0 { ", ${string(self.pressure_deferrals)} pressure deferral(s)" } else { "" }
        "[resources] peak width ${string(self.peak_width)}/${string(self.width_cap)}, ${est}, ${string(self.deferrals)} budget deferral(s)${pressure}, ${string(self.floor_admits)} floor admit(s)${tail}"
    }
}

// ── Persisted priors (t-kdyj.1 slice 2) ────────────────────────────────
// A unit's honest cost is its whole TREE — shard + the fixture compiles it
// shells out — and that varies per shard SET, not per build mode. The mode
// estimate admitted width 4 into a fixture-heavy dir whose trees stacked
// past the cliff seconds later, before the first measurement could correct
// (a container death, logged on t-kdyj.1). The first round needs a PRIOR:
// each run persists its own measured per-unit peak, keyed by the shard set,
// and the next run seeds its estimate from it. Decay is built in: the file
// stores the RUN'S OWN measurement (`observed_mb`, unseeded), so a workload
// that shrank writes the smaller truth — or removes the file entirely when
// it measured nothing above the static estimate — instead of ratcheting
// forever on a stale peak.

/// Where a shard set's measured peak persists. `key` comes from the caller
/// (content-id over the shard slugs — composed there, per the one-hash rule).
export fn admission_prior_path(cache_root: string, key: string) -> string {
    "${cache_root}/admission/${key}.txt"
}

/// The persisted per-unit estimate; 0 when absent or unparseable (both mean
/// "no prior" — the mode's static estimate applies).
export fn read_admission_prior(path: string) -> int {
    let body = avra_selfhost_read_file(path)
    if body == "" { return 0 }
    for line in body.split("\n") {
        if line.starts_with("est_mb:") {
            let v = avra_parse_int(line.substring(7, line.length).trim())
            return if v > 0 { v } else { 0 }
        }
    }
    0
}

/// Persist the run's own measurement when it exceeds the static estimate;
/// otherwise REMOVE the prior so the next run decays back to the mode's
/// number. `complete` gates everything: a run where any unit died unmeasured
/// (a jetsam victim) must neither decay nor overwrite the prior — absence of
/// measurement is not evidence of a lighter workload, and losing the prior
/// there would let the NEXT full run repeat the unsafe admission. Whole-file
/// write of a tiny payload — torn writes just re-measure. Native mkdir and
/// remove, never a shell: the path embeds the project root, which is not
/// shell-safe.
export fn persist_admission_prior(path: string, observed_mb: int, static_mb: int, complete: bool) {
    if !complete { return }
    if observed_mb > static_mb {
        let _ = avra_mkdir_p(path_parent(path))
        let _ = avra_selfhost_write_file(path, "est_mb:${string(observed_mb)}\n")
        return
    }
    let _ = avra_remove_file(path)
}

/// Everything before the last '/', or "" when the path has no separator.
fn path_parent(p: string) -> string {
    mut i = p.length
    while i > 0 {
        let prev = i - 1
        if p.byte(prev) == 0x2F { return p.substring(0, prev) }
        i = prev
    }
    ""
}

extern fn avra_selfhost_read_file(path: string) -> string
extern fn avra_selfhost_write_file(path: string, content: string) -> int
extern fn avra_mkdir_p(path: string) -> int
extern fn avra_remove_file(path: string) -> int
