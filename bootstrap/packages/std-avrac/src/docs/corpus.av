// WHY: Pure-AST helpers for assembling the `lang` doc corpus —
// `target/lang.av` parsed via the indexer, with optional `F`-code
// filtering for the `--scope=errors` view. Plus a small set of
// SymList helpers (concat, reverse, by-name lookup) shared between
// the docs CLI command and any other tooling that needs to fold
// or query a SymList.
//
// All functions here are pure on the Sym side — no argv, no
// process exit. extract_lang_corpus returns an empty SymList when
// `target/lang.av` is missing or unparseable; callers (CLI, IDE
// plugins) decide how to surface the absence.

use core.runtime.{avra_selfhost_file_exists, avra_selfhost_read_file}
use parse.{parse_program_source}
use indexer.{extract_from_ast}
use @std.lsp.{Sym, SymList, sym_list_concat}

/// Parse `${project_dir}/target/lang.av` (generated by
/// `avra lang`) and run it through the indexer. Returns an empty
/// SymList when the file is missing, empty, or fails to parse —
/// the callers (CLI dispatch, IDE plugins) choose how to surface
/// the absence; the lib itself never exits.
export fn extract_lang_corpus(project_dir: string) -> SymList {
    let path = "${project_dir}/target/lang.av"
    if avra_selfhost_file_exists(path) == 0 { return SymList.End }
    let content = avra_selfhost_read_file(path)
    if content == "" { return SymList.End }
    let parsed = parse_program_source(content)
    if parsed.had_error || parsed.stmts == null { return SymList.End }
    extract_from_ast(parsed.stmts!, "target/lang.av")
}

/// `extract_lang_corpus`, narrowed to the F-coded error consts
/// (`F0001`..`F9999`). Drives `avra docs --scope=errors`.
export fn extract_errors_corpus(project_dir: string) -> SymList {
    sym_list_filter_errors(extract_lang_corpus(project_dir))
}

/// Keep only Syms whose name starts with `F` and is at least 5
/// chars long — i.e. the diagnostic-code consts emitted by the
/// `lang` generator.
export fn sym_list_filter_errors(list: SymList) -> SymList {
    mut acc = SymList.End
    mut cur = list
    while true {
        match cur {
            .End -> { return reverse_sym_list(acc) }
            .Node(item, next) -> {
                if item.name.starts_with("F") && item.name.length >= 5 {
                    acc = SymList.Node(item, acc)
                }
                cur = next
            }
        }
    }
    SymList.End
}

/// Reverse a SymList in place — the filter / fold helpers above
/// build their accumulator with `cons` (reversed order); a final
/// `reverse_sym_list` restores source order.
export fn reverse_sym_list(list: SymList) -> SymList {
    mut acc = SymList.End
    mut cur = list
    while true {
        match cur {
            .End -> { return acc }
            .Node(item, next) -> {
                acc = SymList.Node(item, acc)
                cur = next
            }
        }
    }
    SymList.End
}

/// Linear lookup over the project corpus for `avra docs --gen`.
/// Matches against either the bare name or the qualified path so
/// callers can disambiguate between, e.g., `parse` (bare) and
/// `parse::parse_program_source` (qualified).
export fn find_sym_for_gen(list: SymList, query: string) -> Sym? {
    match list {
        .End -> null
        .Node(s, next) -> {
            if s.name == query || s.qualified == query { return s }
            find_sym_for_gen(next, query)
        }
    }
}
