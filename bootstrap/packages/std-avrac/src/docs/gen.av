// `avra docs --gen <symbol>` — synthesise a /// doc-comment stub
// above a declaration so a developer can tab-fill instead of
// remembering the format.
//
// Three pure-formatter entry points, plus a single side-effecting
// `gen_apply` that reads the file, inserts the stub, and writes back.
// Idempotent: if the line above the decl already starts with `///`,
// the apply step is a no-op.
//
// Stub shape (matches the existing /// convention in the codebase):
//   fn:   /// summary
//         /// @param <name> ...
//         /// @returns ...
//   type: /// summary
//         /// @field <name> ...
//   enum: /// summary
//         /// variants: A, B, C
//   other: /// summary

use core.{avra_selfhost_read_file, avra_selfhost_write_file}
use @std.lsp.{Sym, SymKind}

/// Outcome of a `gen_apply` run.
///
/// @field stub    — the rendered stub that would have been inserted.
/// @field skipped — true when the line above the decl already had `///`.
/// @field reason  — human-readable why for `skipped == true`.
/// @field error   — non-empty when read/write failed; otherwise "".
export type GenStubResult = {
    stub: string,
    skipped: bool,
    reason: string,
    error: string,
}

// ── Public formatter ─────────────────────────────────────────────────

/// Render a /// stub for any `Sym`. Dispatches to per-kind helpers
/// (`stub_for_fn`, `stub_for_type`, `stub_for_enum`); falls back to
/// a single `/// summary` line for kinds that don't carry parsed
/// metadata yet.
export fn gen_stub_for_sym(s: Sym) -> string {
    match s.kind {
        .Fn(sig, ret) -> stub_for_fn(sig, ret)
        .Type(rendered) -> stub_for_type(rendered)
        .Enum(variants_csv) -> stub_for_enum(variants_csv)
        .Trait(_) -> "/// summary\n"
        .Impl(_, _) -> "/// summary\n"
        .Const(_) -> "/// summary\n"
        .Mut(_) -> "/// summary\n"
        .Let(_) -> "/// summary\n"
        .ErrorCode(_) -> "/// summary\n"
        .Keyword(_) -> "/// summary\n"
        .Module -> "/// summary\n"
    }
}

// ── Per-kind formatters ──────────────────────────────────────────────

/// Render a fn-shaped stub from its signature + return type.
/// Always emits a leading `/// summary`; appends one `/// @param`
/// line per declared param (skipping `self`) and a `/// @returns`
/// line when the return type isn't void.
fn stub_for_fn(sig: string, ret: string) -> string {
    mut out = "/// summary\n"
    let params = parse_param_names(sig)
    out = out + render_param_lines(params)
    if ret != "" && ret != "void" {
        out = out + "/// @returns ${ret} description\n"
    }
    out
}

/// Render a struct-shaped stub from a rendered `type` decl.
/// Emits `/// summary` plus one `/// @field` line per field.
fn stub_for_type(rendered: string) -> string {
    mut out = "/// summary\n"
    let fields = parse_field_names(rendered)
    out = out + render_field_lines(fields)
    out
}

/// Render an enum-shaped stub. Includes a `/// variants:` line
/// listing the variant names, since they're typically discoverable
/// only by reading the source.
fn stub_for_enum(variants_csv: string) -> string {
    if variants_csv == "" { return "/// summary\n" }
    "/// summary\n/// variants: ${variants_csv}\n"
}

// ── Signature parsing ────────────────────────────────────────────────
//
// SymKind.Fn carries a rendered signature like
//   "fn process(events: List<Event>, retry: bool) -> Result<int, IoError>"
// We pull just the param names (the bit before each `:`). Type-args
// inside angle brackets and parens are skipped via depth tracking so
// `List<Map<K,V>>` inside a parameter type doesn't fool the splitter.

/// Pull just the parameter names out of a rendered signature like
/// `"fn process(events: List<Event>, retry: bool) -> Result<int, IoError>"`.
/// Type-args inside `<...>`, `(...)`, `[...]` are skipped via depth
/// tracking so `List<Map<K, V>>` doesn't fragment.
fn parse_param_names(sig: string) -> List<string> {
    let lparen = sig.index_of("(")
    if lparen < 0 { return [] }
    let body_end = matching_close(sig, lparen)
    if body_end < 0 { return [] }
    let body = sig.substring(lparen + 1, body_end)
    if body == "" { return [] }
    let segs = split_top_level(body, ",")
    mut out = []
    mut i = 0
    while i < segs.length {
        let n = param_name_of(segs[i])
        if n != "" && n != "self" {
            out.push(n)
        }
        i = i + 1
    }
    out
}

/// Extract the name from a single `name: type` segment. Strips a
/// leading `mut ` modifier so `mut count: int` returns `count`.
fn param_name_of(seg: string) -> string {
    let trimmed = trim_str(seg)
    let colon = trimmed.index_of(":")
    if colon < 0 { return trimmed }
    let name = trim_str(trimmed.substring(0, colon))
    if name.starts_with("mut ") { trim_str(name.substring(4, name.length)) } else { name }
}

/// Render `/// @param <name> description` for every name in
/// `params`. Output ends with a trailing newline.
fn render_param_lines(params: List<string>) -> string {
    mut out = ""
    mut i = 0
    while i < params.length {
        out = "${out}/// @param ${params[i]} description\n"
        i = i + 1
    }
    out
}

/// Pull the field names out of a rendered `type Foo = { ... }`
/// decl, using the same depth-aware splitter as `parse_param_names`.
fn parse_field_names(rendered: string) -> List<string> {
    let lbrace = rendered.index_of("{")
    if lbrace < 0 { return [] }
    let rbrace = last_index_of_str(rendered, "}")
    if rbrace < 0 || rbrace <= lbrace { return [] }
    let body = rendered.substring(lbrace + 1, rbrace)
    if trim_str(body) == "" { return [] }
    let segs = split_top_level(body, ",")
    mut out = []
    mut i = 0
    while i < segs.length {
        let n = param_name_of(segs[i])
        if n != "" {
            out.push(n)
        }
        i = i + 1
    }
    out
}

/// Right-to-left substring search. Returns the byte index of the
/// rightmost occurrence of `needle` in `s`, or `-1` when absent.
fn last_index_of_str(s: string, needle: string) -> int {
    if needle.length == 0 || s.length == 0 { return -1 }
    mut i = s.length - needle.length
    while i >= 0 {
        if s.substring(i, i + needle.length) == needle { return i }
        i = i - 1
    }
    -1
}

/// Render `/// @field <name> description` for every name in
/// `fields`. Output ends with a trailing newline.
fn render_field_lines(fields: List<string>) -> string {
    mut out = ""
    mut i = 0
    while i < fields.length {
        out = "${out}/// @field ${fields[i]} description\n"
        i = i + 1
    }
    out
}

// ── Tiny string helpers ──────────────────────────────────────────────

/// Split `s` on `sep` at depth-0 only — angle brackets `<...>` and
/// parens `(...)` are skipped over so generic type args don't
/// fragment a single param. Returns segments in source order via
/// .push — no reverse pass needed.
fn split_top_level(s: string, sep: string) -> List<string> {
    mut segs = []
    mut start = 0
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s[i]
        if ch == "<" || ch == "(" || ch == "[" {
            depth = depth + 1
        } else if ch == ">" || ch == ")" || ch == "]" {
            depth = depth - 1
        } else if depth == 0 && ch == sep {
            segs.push(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    segs.push(s.substring(start, s.length))
    segs
}

/// Find the byte index of the closing `)` matching the `(` at
/// `open_idx`. Tracks paren-only depth so `fn(x: List<int>)` works
/// (the `>` doesn't affect paren depth).
fn matching_close(s: string, open_idx: int) -> int {
    mut depth = 1
    mut i = open_idx + 1
    while i < s.length {
        let ch = s[i]
        if ch == "(" { depth = depth + 1 }
        else if ch == ")" {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i + 1
    }
    -1
}

/// Strip leading/trailing spaces and tabs. Local copy because
/// `core` doesn't expose a `trim_str` and pulling in `@std/strings`
/// would create an import cycle here.
fn trim_str(s: string) -> string {
    mut start = 0
    while start < s.length && (s[start] == " " || s[start] == "\t") {
        start = start + 1
    }
    mut end = s.length
    while end > start && (s[end - 1] == " " || s[end - 1] == "\t") {
        end = end - 1
    }
    s.substring(start, end)
}

// ── File I/O — read, insert, write ───────────────────────────────────

/// Read `file`, insert `stub` immediately before `line`, write the
/// file back. Idempotent: when the line above the decl already
/// starts with `///`, returns `skipped: true` without touching the
/// file. Errors propagate via `error: ...`.
export fn gen_apply(file: string, line: int, stub: string) -> GenStubResult {
    let content = avra_selfhost_read_file(file)
    if content == "" {
        return GenStubResult { stub, skipped: false, reason: "", error: "cannot read ${file}" }
    }
    if already_documented(content, line) {
        return GenStubResult { stub, skipped: true, reason: "already documented", error: "" }
    }
    let updated = insert_at_line(content, line, stub)
    if avra_selfhost_write_file(file, updated) == 0 {
        return GenStubResult { stub, skipped: false, reason: "", error: "cannot write ${file}" }
    }
    GenStubResult { stub, skipped: false, reason: "", error: "" }
}

/// True when the line immediately preceding `line` (1-indexed) is
/// already a `///` doc comment. Idempotent guard for repeat
/// `--gen` runs and for editor batch invocations.
export fn already_documented(content: string, line: int) -> bool {
    if line <= 1 { return false }
    let prior = line_at(content, line - 1)
    let trimmed = trim_str(prior)
    trimmed.starts_with("///")
}

/// Insert `stub` so its first character lands at the start of
/// `line` (1-indexed). Existing content from that line onward
/// shifts down. Re-indents `stub` to match the leading whitespace
/// of the existing line so the doc comment aligns with the decl.
export fn insert_at_line(content: string, line: int, stub: string) -> string {
    if line <= 1 {
        return stub + content
    }
    let pos = byte_offset_of_line(content, line)
    if pos < 0 { return content + stub }
    let leading = leading_indent_of(content, pos)
    let indented = indent_stub(stub, leading)
    content.substring(0, pos) + indented + content.substring(pos, content.length)
}

/// Indent every non-empty line of `stub` with `pad`. The trailing
/// newline of `stub` is preserved so the next line of source
/// aligns at the same indent as the decl we annotated.
fn indent_stub(stub: string, pad: string) -> string {
    if pad == "" { return stub }
    mut out = ""
    mut start = 0
    mut i = 0
    while i < stub.length {
        if stub[i] == "\n" {
            let seg = stub.substring(start, i)
            let prefix = if seg == "" { "" } else { pad }
            out = "${out}${prefix}${seg}\n"
            start = i + 1
        }
        i = i + 1
    }
    if start < stub.length {
        out = "${out}${pad}${stub.substring(start, stub.length)}"
    }
    out
}

/// Return the run of spaces / tabs that starts at byte offset
/// `pos`. Used to mirror the existing line's indent when inserting
/// a doc-comment stub above it.
fn leading_indent_of(content: string, pos: int) -> string {
    mut end = pos
    while end < content.length && (content[end] == " " || content[end] == "\t") {
        end = end + 1
    }
    content.substring(pos, end)
}

/// Extract the contents of `line` (1-based) without the trailing
/// newline. Returns "" for out-of-range line numbers.
fn line_at(content: string, line: int) -> string {
    let start = byte_offset_of_line(content, line)
    if start < 0 { return "" }
    let nl = next_newline(content, start)
    let end = if nl < 0 { content.length } else { nl }
    content.substring(start, end)
}

/// Convert a 1-based line number to its byte offset in `content`.
/// Returns -1 when `line` exceeds the file's line count, 0 when
/// `line == 1`.
fn byte_offset_of_line(content: string, line: int) -> int {
    if line <= 1 { return 0 }
    mut cur_line = 1
    mut i = 0
    while i < content.length {
        if content[i] == "\n" {
            cur_line = cur_line + 1
            if cur_line == line { return i + 1 }
        }
        i = i + 1
    }
    -1
}

/// Find the byte offset of the first `\n` at or after `from`.
/// Returns -1 when none — the caller treats that as "rest of file".
fn next_newline(content: string, from: int) -> int {
    mut i = from
    while i < content.length {
        if content[i] == "\n" { return i }
        i = i + 1
    }
    -1
}
