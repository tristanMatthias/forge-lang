// vez6.4szi step 2 + wd48 regression test —
// Adding a new @std.avrac.X module + a sibling test that imports it
// should NOT break unrelated test files' relative imports in the
// bundled test compile. Specifically: docs/gen_test.av's
// `use gen.{gen_stub_for_sym, ...}` (sibling import) must still
// resolve when this file is in the bundle.

use @std.avrac.check.{check_source}
use @std.avrac.diagnostics.{bag_has_errors}

// Split the entry-point header so this file isn't excluded from the
// test set (select_test_paths skips files whose contents include the
// standalone-program signature).
const MAIN_HEADER: string = "fn " + "main()"

spec "vez6.4szi: check_source basics" {
    then "valid program produces no errors" {
        let bag = check_source(MAIN_HEADER + " -> int { 0 }")
        !bag_has_errors(bag)
    }
    then "syntax error surfaces in the bag" {
        let bag = check_source(MAIN_HEADER + " -> int { let x = }")
        bag_has_errors(bag)
    }
    then "undefined variable produces an error" {
        let bag = check_source(MAIN_HEADER + " -> int { undefined_var }")
        bag_has_errors(bag)
    }
    then "type mismatch produces an error" {
        let bag = check_source(MAIN_HEADER + " -> int {\n    let x: int = \"hello\"\n    x\n}")
        bag_has_errors(bag)
    }
    then "valid program with let + arithmetic compiles" {
        let bag = check_source(MAIN_HEADER + " -> int {\n    let x = 1 + 2\n    x\n}")
        !bag_has_errors(bag)
    }
}

// vez6.4szi.3 — red-team / edge-case pass.
//
// The primitive accepts arbitrary user input from spec tests, so each
// degenerate input shape gets pinned to a deterministic outcome: empty
// strings, whitespace-only, scale tests, and outputs from synthesized
// fixtures all go through the same path the fixture-replacement work
// of vez6.4szi relies on.
spec "vez6.4szi.3: check_source edge cases" {
    then "empty source produces a bag without errors (no entry point required for check)" {
        // check_source isn't an entry-point validator — it just runs
        // the diagnostic pipeline. Empty source has nothing to parse
        // and nothing to typecheck, so the bag stays clean.
        let bag = check_source("")
        !bag_has_errors(bag)
    }
    then "whitespace-only source produces a clean bag" {
        // Mirror of the empty-input case for the realistic shape of
        // a freshly-opened editor buffer with a trailing newline.
        let bag = check_source("   \n\t\n  ")
        !bag_has_errors(bag)
    }
    then "moderate-size input (1000 stmts) still terminates and reports no errors" {
        // 100MB (from the ticket sketch) jetsam-kills the test shard
        // and even 50000 stmts (~1MB source) blows the per-shard RSS
        // budget under bundled-test parallelism. 1000 stmts is enough
        // to detect quadratic behaviour in the parser/typeck without
        // hanging or starving sibling shards.
        mut body: string = ""
        mut i = 0
        while i < 1000 {
            body = body + "    let x" + string(i) + " = " + string(i) + "\n"
            i = i + 1
        }
        let bag = check_source(MAIN_HEADER + " -> int {\n" + body + "    0\n}")
        !bag_has_errors(bag)
    }
}
