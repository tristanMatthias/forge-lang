// WHY: in-process pipeline entry — parse + resolve + typeck + monomorphize
// a source string and return the accumulated DiagnosticBag. Replaces the
// test pattern of forking the compiler and grepping stderr.
//
// Pipeline stages run (mirrors `bs2 check` minus file-based module loading;
// Option C per docs/2026_05_25_EXPAND_PIPELINE_HANDOFF.md):
//   parse → lower_quotes → desugar → inject_intrinsics → expand_components
//   → resolve_and_expand_program → run_comptime → typecheck_program
//   → monomorphize
//
// `resolve_and_expand_program` itself is the composed Option C dance:
// resolve_names_pre_expand → expand_macros_collect →
// expand_macros_eval_with_state → register_macro_decls →
// rewrite_uses_macro_only → validate_scopes_after_expand.
//
// Monomorphization is included so the where-clause / trait-bound check
// (which surfaces during specialisation) is observable in the bag.
// Returns the final DiagnosticBag, which carries every error/warning
// raised across all stages.

use parse.{parse_program_source}
use diagnostics.{DiagnosticBag, bag_merge, bag_has_errors}
use features.quote_expr.{lower_quotes}
use desugar.{desugar_program, inject_intrinsics}
use features.component_decl.{expand_components}
use features.comptime.{resolve_and_expand_program, run_comptime}
use typeck.{typecheck_program}
use features.generics.{monomorphize}

/// Run the diagnostic pipeline against a source string and return
/// the accumulated DiagnosticBag.
export fn check_source(source: string) -> DiagnosticBag {
    let parsed = parse_program_source(source)
    if parsed.had_error || parsed.stmts == null {
        return parsed.bag
    }
    let post_quote = lower_quotes(parsed.stmts!)
    let desugared = desugar_program(post_quote)
    // check_source intentionally skips file-based module loading, so
    // the synthesized Result is needed for in-process tests that
    // don't import stdlib. inject_intrinsics is a no-op when the
    // source declares Result directly.
    let with_intrinsics = inject_intrinsics(desugared)
    let comp = expand_components(with_intrinsics)
    if bag_has_errors(comp.bag) {
        return comp.bag
    }
    // Option C pipeline: macro-introduced decls register before
    // scope validation runs. Replaces the legacy
    // `resolve_names → expand_macros` shape which was per-pass
    // non-idempotent and missed macro-emitted top-level decls.
    let named = resolve_and_expand_program(comp.stmts)
    if named.had_error {
        return bag_merge(comp.bag, named.bag)
    }
    let post_comptime = run_comptime(named.stmts)
    let tc_result = typecheck_program(post_comptime, named.type_reg, named.macro_origins)
    if bag_has_errors(tc_result.bag) {
        return tc_result.bag
    }
    // Monomorphize so where-clause / trait-bound errors that only
    // surface during specialisation land in the bag. Merge with the
    // typecheck bag so warnings from earlier stages aren't lost.
    let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
    bag_merge(tc_result.bag, mono.bag)
}
