// WHY: Pure-AST helpers for assembling a synthetic test program from a
// set of `_test.av` source files. Used by the `avra test` driver to
// stitch each test file into one List<StmtId>, hoist package modules so
// each @std package appears only once, and prepend the externs the
// test harness binds against.
//
// All functions here are pure on the AST side — no I/O, no argv, no
// process exit. Any caller (CLI driver, IDE plugin, fuzz harness) can
// reuse them to build a test program.

use core.{
    Stmt, ParamEntry, ValueType, TypeParamEntry,
    Expr, Annotation, FieldInit,
    avra_shell_exec,
    avra_selfhost_file_exists,
    avra_selfhost_read_file,
    avra_selfhost_write_file,
    avra_mkdir_p,
    avra_file_mtime,
}
use features.modules.{
    hoist_package_modules, HoistSplit,
    resolve_module_files, modules_dirname, find_packages_dir,
    dedup_modules,
}
use parse.{parse_program_source_shared, byte_at_str}
use core.{NodeStore, StmtId}
use diagnostics.{bag_has_errors, render_bag}
use pathutil.{path_tail_slug}
use build.{llvm_prefix_dir}
use list_ops.{list_concat}
use @std.crypto.{sha256_hex, sha256_file}

// 4szi.1: in-process memo for read_or_compute_toolchain_fp. The
// toolchain fp doesn't change for the lifetime of a bs2 process —
// the binary itself, runtime.o, llvm_wrapper.o, AND every
// packages/std-avrac/src .av file are all stable. With the memo,
// only the first cached_fixture_capture call per process does the
// sidecar + find-newer dance; every subsequent call returns the
// memoized string immediately, saving a fork+exec per call.
extern fn avra_process_env_get(name: string) -> string
extern fn avra_test_toolchain_fp_get() -> string
extern fn avra_test_toolchain_fp_set(fp: string)
// Advisory lock serializing concurrent cold-misses on one fixture:
// bs2 emits the fixture's .ll/.o at fixed sibling paths, so two
// simultaneous runs of the same fixture (parallel units or parallel
// shards) would race on those artifacts. Lock fd in, fd out.
extern fn avra_file_lock_exclusive(path: string) -> int
extern fn avra_file_unlock(fd: int)

// ── AST builder mini-DSL ────────────────────────────────────────────
//
// `prepend_test_externs` and `build_guarded_spec_call` both compose
// nested cons-chains by hand. The helpers below hide that ceremony so
// the call sites read top-to-bottom in declaration order rather than
// inside-out. They're test_runner-local because they allocate
// dummy-span leaf rows; other AST consumers may want real spans.

/// Single extern declaration row. Drives `prepend_test_externs`'s
/// table-driven prepend loop so the runtime contract reads as a
/// vertical list instead of five nested `List` pushes.
type RuntimeExtern = { name: string, params: List<ParamEntry>, ret: ValueType }

/// Convert `List<RuntimeExtern>` into prepended `ExternFn` stmts in
/// declaration order. Builds a fresh List with externs first, then
/// the existing stmts.
fn prepend_externs(store: NodeStore, stmts: List<StmtId>, decls: List<RuntimeExtern>) -> List<StmtId> {
    mut out: List<StmtId> = []
    for d in decls {
        out.push(store.stmts.add_leaf(Stmt.ExternFn(d.name, d.params, d.ret)))
    }
    for s in stmts {
        out.push(s)
    }
    out
}

/// Build a fresh `List<ParamEntry>` from `(name, type)` rows —
/// declaration order in, parameter list out.
type ParamSpec = { name: string, ty: ValueType }

fn param_list_from(specs: List<ParamSpec>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    for s in specs {
        out.push(ParamEntry { name: s.name, vtype: s.ty })
    }
    out
}

// ── Runtime extern table ────────────────────────────────────────────

/// The full set of runtime externs every assembled test program
/// needs to link against:
///   - `avra_test_summary()        -> int`  → final pass/fail tally
///   - `avra_test_flush()          -> void` → drain captured-output ring
///   - `avra_test_capture_start()  -> void`
///   - `avra_test_capture_stop()   -> string`
///   - `avra_test_run_spec_guarded(name, file, ln, body) -> int` →
///     hkms.3: invoke one spec block under a sigsetjmp checkpoint so
///     a fatal signal is caught and the runner advances to the next
///     spec instead of taking down the bundle. `body` is a no-arg
///     Avra closure produced by `wrap_specs_with_guard` for every
///     top-level `spec { ... }` block.
fn test_runtime_externs() -> List<RuntimeExtern> {
    let empty_p: List<ParamEntry> = []
    table<RuntimeExtern> {
        name                          | params                | ret
        "avra_test_summary"           | empty_p               | ValueType.Int
        "avra_test_flush"             | empty_p               | ValueType.Void
        "avra_test_capture_start"     | empty_p               | ValueType.Void
        "avra_test_capture_stop"      | empty_p               | ValueType.Str
        "avra_test_run_spec_guarded"  | guard_extern_params() | ValueType.Int
    }
}

/// `fn() -> int` as a structurally-typed param. The runner's source
/// decl of the guard parses to FnTyped — the table must build the
/// same shape or the two decls trip the conflicting-extern check.
fn fn_int_param_type() -> ValueType {
    let no_params: List<ValueType> = []
    ValueType.FnTyped(no_params, ValueType.Int)
}

/// Signature for the per-spec guard runtime fn. Named separately so
/// the externs table reads cleanly without an inline list literal
/// on one row.
fn guard_extern_params() -> List<ParamEntry> {
    param_list_from(table<ParamSpec> {
        name   | ty
        "name" | ValueType.Str
        "file" | ValueType.Str
        "ln"   | ValueType.Int
        "body" | fn_int_param_type()
    })
}

/// Cons-prepend the runtime extern table onto a freshly-assembled
/// test program. See `test_runtime_externs` for the full contract.
export fn prepend_test_externs(store: NodeStore, stmts: List<StmtId>) -> List<StmtId> {
    prepend_externs(store, stmts, test_runtime_externs())
}

// ── hkms.3 wrap: spec → guarded call site ──────────────────────────

/// AST transform that wraps each top-level `spec` block in a
/// crash-isolating call so a SIGSEGV / abort in one spec doesn't kill
/// the bundle.
///
/// For every top-level `Stmt.SpecBlock(name, body)` in `stmts`,
/// replace the position with:
///
///     avra_test_run_spec_guarded(name, file, line, () -> {
///         <original SpecBlock>
///         0
///     })
///
/// Why a no-arg **lambda** rather than a hoisted top-level fn:
///   - Avra closures preserve the enclosing scope, so top-level `mut`
///     globals in the test file (e.g. `mut hits_alpha: int = 0`) stay
///     visible inside the wrapped spec body — a hoisted fn would open
///     a fresh scope and lose them.
///   - The Avra closure layout (`[TAG, fn_ptr, ...captures]`) is
///     exactly what `avra_test_run_spec_guarded` consumes via the
///     existing `avra_closure_call_0` dispatch in runtime.c.
///   - One less module-level identifier per spec, no synthetic-fn
///     name to worry about (`is_mangled_method` collisions, etc).
///
/// The wrap operates only at the module top level — `spec` blocks
/// nested inside fn bodies (no realistic use today, but cheap to keep
/// untouched) compile as before, since their crash would already be
/// scoped to the enclosing fn call.
export fn wrap_specs_with_guard(store: NodeStore, stmts: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    for id in stmts {
        let rewritten = match store.stmts.get(id) {
            .SpecBlock(name, _) -> build_guarded_spec_call(store, id, name)
            _ -> id
        }
        out.push(rewritten)
    }
    out
}

/// Build the replacement call site:
///     avra_test_run_spec_guarded("spec name", "file.av", LINE,
///                                () -> { spec name { body }; 0 })
///
/// The spec name retains its outer quotes from the lexeme — codegen's
/// `strip_quotes` removes one pair so the runtime crash record gets a
/// clean name. File path is freshly wrapped in quotes for the same
/// round-trip. The body Lambda returns int (per the extern's
/// `body: fn() -> int` signature) via the trailing `0`.
fn build_guarded_spec_call(store: NodeStore, orig: StmtId, spec_name_lex: string) -> StmtId {
    let opos = store.stmt_pos(orig)
    // Block body = [the original SpecBlock node, `0`]. The SpecBlock row
    // is re-leafed so the guarded call fully owns the top-level slot.
    let body: List<StmtId> = [
        store.stmts.add_leaf(store.stmts.get(orig)),
        store.stmts.add_leaf(Stmt.Expr(store.exprs.add_leaf(Expr.Number("0")))),
    ]
    let empty_p: List<ParamEntry> = []
    // Lambda.body is an ExprId; Expr.Block holds List<StmtId>.
    let body_lambda = Expr.Lambda(empty_p, store.exprs.add_leaf(Expr.Block(body)))
    let args: List<ExprId> = [
        store.exprs.add_leaf(Expr.String(spec_name_lex)),
        store.exprs.add_leaf(Expr.String("\"" + opos.file + "\"")),
        store.exprs.add_leaf(Expr.Number(string(opos.line))),
        store.exprs.add_leaf(body_lambda),
    ]
    let call = Expr.Call(store.exprs.add_leaf(Expr.Ident("avra_test_run_spec_guarded")), args)
    // Re-allocate against the original SpecBlock row so the call keeps
    // its span/position.
    store.restmt(Stmt.Expr(store.exprs.add_leaf(call)), orig)
}

/// Outcome of splitting a stmt list into hoistable package modules
/// and the per-test body. The runner uses this to keep each
/// `@std::pkg` module unique across the assembled program.
export type PackageSplit = {
    packages: List<StmtId>,
    body: List<StmtId>,
}

/// Collect every `@`-prefixed `Module` from the stmt list and
/// return the residue. Thin wrapper over the resolver's
/// `hoist_package_modules` so the cli's `test` handler doesn't
/// need to import `features.modules.resolver` directly. Both
/// implementations agreed on the recursive walk — sharing the
/// canonical one removes a second copy that would have drifted.
export fn split_package_modules(store: NodeStore, stmts: List<StmtId>) -> PackageSplit {
    let h = hoist_package_modules(store, stmts)
    PackageSplit { packages: h.packages, body: h.body }
}

/// Resolve the absolute path of the spec_test reporter (`reporter.av`).
/// Three call sites used to assemble this concatenation by hand
/// (assemble_test_program here, make_test_inputs + prepare_test_run
/// in cli/main.av); the literal `std-avrac/src/features/spec_test/`
/// is now centralised in one place — move the reporter file and one
/// edit fixes every consumer.
export fn test_reporter_path(project_dir: string) -> string {
    find_packages_dir(project_dir) + "std-avrac/src/features/spec_test/reporter.av"
}

/// Sibling of `test_reporter_path` for the in-process parallel
/// runner. Inlined into every test bundle the same way.
export fn test_runner_path(project_dir: string) -> string {
    find_packages_dir(project_dir) + "std-avrac/src/features/spec_test/runner.av"
}


/// One test file's contribution to an assembled program. The body is
/// already guard-wrapped; the @std/* packages are split out so the
/// caller can dedup them across the whole program in one pass.
type AssembledFile = {
    mod_name: string,
    packages: List<StmtId>,
    wrapped_body: List<StmtId>,
    // Files the resolver had loaded when this one finished. Threaded to
    // the NEXT file so a package already materialised for an earlier
    // member is not rebuilt — see assemble_test_program.
    loaded: List<string>,
}

/// One module name per test path, UNIQUE within the shard.
///
/// t-kdyj.3. This was `basename_no_ext(path)` alone, computed per file, and two test
/// files with the SAME BASENAME in one shard therefore produced two
/// `Stmt.Module`s with the same name. Per-file modules are not deduped
/// (`dedup_modules` runs over the hoisted `@std/*` packages only), so the resolver
/// merged the two by name and one displaced the other: every item declared ONLY by
/// the loser came back F3000 `undefined variable`, and the shard failed to COMPILE.
///
/// The measured instance: `packages/std-cli/src/cmdgen/tests/expand_command_test.av`
/// and `packages/std-avrac/src/features/comptime/tests/expand_command_test.av` have
/// coexisted for months. Whether they land in the SAME shard depends on batch
/// composition, which shifts whenever a test file is added anywhere in the tree — so
/// the failure lands on whichever PR happens to change the file count, with nothing
/// in its diff to explain it, and reads as a flake. It cost two CI runs on #1093.
///
/// DISAMBIGUATION WALKS BACK UP THE PATH, one segment at a time, and only for the
/// names that actually collide — so an unaffected file keeps the short readable
/// `expand_command_test` and its generated symbols do not churn. Colliding files grow
/// to `cmdgen_tests_expand_command_test` / `comptime_tests_expand_command_test`.
/// Trailing segments only: an absolute-path slug would key module (and therefore
/// symbol) names to where the checkout lives.
///
/// The final index pass is the unconditional backstop for the case the walk cannot
/// resolve — two paths with identical trailing segments below different roots. It is
/// what makes the postcondition "names are unique" hold with no depth caveat.
export fn shard_mod_names(test_paths: List<string>) -> List<string> {
    mut out: List<string> = []
    mut i = 0
    while i < test_paths.length {
        mut depth = 1
        mut name = path_tail_slug(test_paths[i], depth)
        // Extend only while some OTHER path produces the same slug at this depth.
        // Both members of a colliding pair run this identically, so they extend in
        // lockstep and stay distinguishable at the depth where their paths diverge.
        while depth < 8 && slug_collides(test_paths, i, depth, name) {
            depth = depth + 1
            name = path_tail_slug(test_paths[i], depth)
        }
        out.push(name)
        i = i + 1
    }
    suffix_remaining_duplicates(out)
}

/// True when a path OTHER than `self_idx` yields `name` at this depth.
fn slug_collides(test_paths: List<string>, self_idx: int, depth: int, name: string) -> bool {
    mut j = 0
    while j < test_paths.length {
        if j != self_idx && path_tail_slug(test_paths[j], depth) == name { return true }
        j = j + 1
    }
    false
}

/// Append `_2`, `_3`, … to the second and later occurrences of any name that is
/// still repeated. Order-stable, so the assignment is deterministic.
///
/// The candidate is checked against the names ALREADY EMITTED, not against a count
/// of the original name — a suffix this pass generates has to be reserved like any
/// other. Counting occurrences of `names[i]` alone maps `["x", "x", "x_2"]` to
/// `["x", "x_2", "x_2"]`, i.e. it re-creates the very collision the pass exists to
/// remove. This is the last line of defence (reached only when the segment walk
/// hits its cap), so it must hold unconditionally or the postcondition is a lie.
export fn suffix_remaining_duplicates(names: List<string>) -> List<string> {
    mut out: List<string> = []
    mut i = 0
    while i < names.length {
        mut candidate = names[i]
        mut suffix = 2
        while name_is_used(out, candidate) {
            candidate = names[i] + "_" + string(suffix)
            suffix = suffix + 1
        }
        out.push(candidate)
        i = i + 1
    }
    out
}

fn name_is_used(names: List<string>, target: string) -> bool {
    for name in names {
        if name == target { return true }
    }
    false
}

/// Parse + resolve-module-files + hoist + spec-wrap one test file.
/// Pure on the AST side; errors travel back as Result.Err with the
/// rendered diagnostic already on stderr (via render_bag).
///
/// wd48: LoadedPaths is NOT shared across calls. A shared set made
/// sibling-Module loads return empty wrappers on second hit, breaking
/// sibling `use` imports. Cost: @std/* packages re-parsed per file;
/// `dedup_modules` collapses the duplicate package wrappers by name
/// at the program-root level.
fn assemble_one_test_file(path: string, mod_name: string, loaded: List<string>, store: NodeStore) -> Result<AssembledFile, string> {
    let content = avra_selfhost_read_file(path)
    let parsed = parse_program_source_shared(content, path, store)
    if parsed.had_error || parsed.ids == null {
        if bag_has_errors(parsed.bag) { render_bag(content, path, parsed.bag) }
        return Result.Err("error parsing ${path}")
    }
    let mod_resolved = resolve_module_files(parsed.ids!, modules_dirname(path), loaded, store)
    if mod_resolved.had_error {
        return Result.Err("module resolve error in ${path}: ${mod_resolved.error_message}")
    }
    let split = split_package_modules(store, mod_resolved.stmts)
    Result.Ok(AssembledFile {
        mod_name: mod_name,
        packages: split.packages,
        // hkms.3: rewrite each top-level `spec` block into a guarded
        // `avra_test_run_spec_guarded(...)` call so a SIGSEGV / abort
        // in one spec doesn't take down the bundle.
        wrapped_body: wrap_specs_with_guard(store, split.body),
        loaded: mod_resolved.loaded,
    })
}

/// Load + parse the spec_test reporter. Returns an empty list when
/// the file is missing or fails to parse — the caller still produces
/// a (broken) test program; the missing reporter fns surface as
/// "undefined name" diagnostics in the codegen pass, which is the
/// signal we want when something is wrong with the install.
fn load_reporter_stmts(project_dir: string, store: NodeStore) -> List<StmtId> {
    load_support_stmts(test_reporter_path(project_dir), store)
}

/// The in-process parallel runner, inlined right after the
/// reporter so the synthesized main's `run_test_suite` resolves.
fn load_runner_stmts(project_dir: string, store: NodeStore) -> List<StmtId> {
    load_support_stmts(test_runner_path(project_dir), store)
}

/// Load + parse one inlined support file (reporter, runner). An
/// empty list on missing/parse-failure keeps the caller producing a
/// (broken) program whose missing names surface as resolve
/// diagnostics — the right signal for a damaged install.
fn load_support_stmts(path: string, store: NodeStore) -> List<StmtId> {
    let empty: List<StmtId> = []
    if avra_selfhost_file_exists(path) == 0 { return empty }
    let rsrc = avra_selfhost_read_file(path)
    let rparsed = parse_program_source_shared(rsrc, path, store)
    if rparsed.had_error || rparsed.ids == null { return empty }
    rparsed.ids!
}

/// Synthetic test-bundle entry point:
///
///     fn main() -> int {
///         run_test_suite([TestUnit { name: "<mod>", run: __init_<mod> }, ...])
///         return test_render_summary()
///     }
///
/// Each test module is @deferred_init (its __init_<mod> exists but
/// is not auto-called); the runner dispatches the units across
/// worker threads. Cons-prepended onto the rest of the assembled
/// program so the declaration lands first in the rendered AST.
fn synth_test_main(store: NodeStore, mod_names: List<string>) -> StmtId {
    let empty_args_ids: List<ExprId> = []
    mut unit_lits: List<ExprId> = []
    for mod_name in mod_names {
        let inits: List<FieldInit> = [
            FieldInit { name: "name", value_id: store.exprs.add_leaf(Expr.String("\"${mod_name}\"")) },
            FieldInit { name: "run", value_id: store.exprs.add_leaf(Expr.Ident("__init_${mod_name}")) },
        ]
        unit_lits.push(store.exprs.add_leaf(Expr.StructLit("TestUnit", inits)))
    }
    let body: List<StmtId> = [
        store.stmts.add_leaf(Stmt.Expr(store.exprs.add_leaf(Expr.Call(store.exprs.add_leaf(Expr.Ident("run_test_suite")),
            [store.exprs.add_leaf(Expr.ListLit(unit_lits))])))),
        store.stmts.add_leaf(Stmt.Return(store.exprs.add_leaf(Expr.Call(store.exprs.add_leaf(Expr.Ident("test_render_summary")), empty_args_ids)))),
    ]
    let empty_tp: List<TypeParamEntry> = []
    let empty_p: List<ParamEntry> = []
    store.stmts.add_leaf(Stmt.Function("main", empty_tp, empty_p, ValueType.Int, body))
}

/// `extern fn __init_<mod>() -> int` rows for every deferred test
/// module, so the synthesized main's TestUnit literals resolve. The
/// declarations converge with the definitions codegen emits for the
/// modules (avra_llvm_add_function is get-or-create by exact type).
fn unit_init_externs(mod_names: List<string>) -> List<RuntimeExtern> {
    mut out: List<RuntimeExtern> = []
    for mod_name in mod_names {
        let empty_p: List<ParamEntry> = []
        out.push(RuntimeExtern { name: "__init_${mod_name}", params: empty_p, ret: ValueType.Int })
    }
    out
}

/// Assemble the test program for one action: parse each test file as
/// its own Stmt.Module, hoist @std packages, inline the spec_test
/// reporter, and synthesise a main() that returns test_render_summary().
///
/// Returned program layout (top-to-bottom): runtime externs,
/// reporter fns, deduped @std/* packages, per-file test modules,
/// synthesised `fn main`.
export fn assemble_test_program(test_paths: List<string>, project_dir: string, store: NodeStore) -> Result<List<StmtId>, string> {
    if test_paths.length == 0 { return Result.Err("no spec test files found") }

    // hkms.1.1 perf pass: iterate test_paths in REVERSE and push so
    // both `packages` and `modules` come out in the same reverse-of-
    // test_paths order the prior `list_concat(a.packages, packages)`
    // + `modules_fwd → modules` reverse-walk produced — without the
    // O(N²) accumulator-recopy that prepending list_concat forces.
    //
    // Why ordering matches: dedup_modules merges per-name bodies via
    // first-occurrence insertion order (group_by_module_name +
    // mod_group_merge), so changing this loop's order would shift
    // the merged module bodies' element order and break the
    // bs2≡bs3 selfhost fixed point.
    // t-kdyj.3: names are assigned across the WHOLE batch, not per file, because
    // uniqueness is a property of the shard — a per-file `basename_no_ext` cannot see
    // the sibling it is about to collide with.
    let assigned = shard_mod_names(test_paths)
    mut packages: List<StmtId> = []
    mut modules: List<StmtId> = []
    mut mod_names: List<string> = []
    // Threaded across members: the resolver already skips a package it has
    // loaded (loaded_has), but a per-file reset meant every member
    // re-decoded and re-synthesised each imported package's whole public
    // surface — N copies that dedup_modules then merged back to one.
    mut loaded: List<string> = []
    mut i = test_paths.length - 1
    while i >= 0 {
        let a = assemble_one_test_file(test_paths[i], assigned[i], loaded, store)?
        loaded = a.loaded
        for p in a.packages { packages.push(p) }
        // Every test module is deferred — codegen synthesizes
        // __init_<mod> without the top-level auto-call; the runner
        // invokes the units across worker threads.
        let deferred: List<Annotation> = [Annotation { name: "deferred_init", arg_ids: [] }]
        modules.push(store.stmts.add_leaf(Stmt.Annotated(deferred,
            store.stmts.add_leaf(Stmt.Module(a.mod_name, a.wrapped_body)))))
        mod_names.push(a.mod_name)
        i = i - 1
    }

    let body = list_concat(load_reporter_stmts(project_dir, store),
               list_concat(load_runner_stmts(project_dir, store),
               list_concat(dedup_modules(store, packages), modules)))
    let with_unit_externs = prepend_externs(store, prepend_test_externs(store, body), unit_init_externs(mod_names))
    let program = list_concat([synth_test_main(store, mod_names)], with_unit_externs)
    Result.Ok(program)
}

/// 0qmm step 3: content-keyed fixture-stdout cache. Replaces the
/// per-PPID /tmp pattern that re-ran heavy fixtures (cli_metadata_compile,
/// std_avrac_lib_build, etc.) on every session because PPID changed —
/// across sessions, nothing carried over. The hash factors in the
/// fixture source plus every toolchain input that affects its output
/// (bs2 + runtime.o + llvm_wrapper.o), so a slot is reused across
/// sessions when those bytes match and invalidated automatically when
/// they don't.
///
/// Performance: the toolchain inputs (bs2/runtime.o/llvm_wrapper.o)
/// are ~5MB combined; sha256-ing them on every `then` block would
/// burn ~100ms per call. We memoise the combined toolchain fp via a
/// sidecar file (`build/cache/fixture_stdout/.toolchain-fp`), valid
/// as long as that file is newer than every input. Same trick rqwh's
/// link_shared_fp uses in diagnose.sh.
///
/// On Hit: returns the previously-captured stdout. On Miss: runs the
/// fixture via diagnose.sh, captures stdout, persists, returns.
export fn cached_fixture_run(fixture_path: string) -> string {
    cached_fixture_capture(fixture_path, fixture_run_cmd(fixture_path), "run")
}

/// Assert a fixture emitted `PROBE <name>: ok`, and PRINT the whole capture
/// when it did not.
///
/// The fixtures that drive heavy shell-outs (`bs2 build --lib`, a metadata
/// pre-build) already dump their build-log tails and per-dep logs on failure.
/// They dump to their OWN stdout — which `cached_fixture_run` returns as a
/// string and a bare `.contains(...)` discards. The evidence was being
/// collected and then thrown away one frame above where it was needed, so CI
/// showed a lone `FAIL "build rc is zero"` and nothing else. Twice, on two
/// different fixtures, for the same underlying failure.
///
/// It matters most for exactly these probes: `bs2 build --lib` has SIX
/// distinct failure exits (pre-build a path-dep, per-module dispatch,
/// stale-artifact removal, child compile rc, no IR produced, install) and the
/// exit code alone tells them apart from none of the others.
///
/// Centralised because the pattern had already been written twice by hand and
/// was about to be written a third time.
export fn probe_ok(fixture_label: string, name: string, out: string) -> bool {
    let ok = out.contains("PROBE ${name}: ok")
    if !ok {
        println("${fixture_label}[${name}]: probe absent — fixture output follows")
        println(out)
    }
    ok
}

/// The two --run command shapes, defined once — cached_fixture_run*
/// (path-only) and write_fixture_and_run* (write-through) must invoke
/// byte-identical commands or their captures would diverge.
fn fixture_run_cmd(fixture_path: string) -> string {
    "bash scripts/diagnose.sh --run ${fixture_path} 2>&1 || true"
}

fn fixture_run_no_metadata_cmd(fixture_path: string) -> string {
    "env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS bash scripts/diagnose.sh --run ${fixture_path} 2>&1 || true"
}

/// Same content-keyed cache, but runs `./build/bs2 expand <path>`
/// instead of building/running the fixture. Used by the
/// expand_macro_* tests that exercise the macro-expansion CLI and
/// want a stable stdout snapshot. The cache key includes the verb
/// ("expand") so a fixture used with --run and `bs2 expand` doesn't
/// collide.
export fn cached_fixture_expand(fixture_path: string) -> string {
    cached_fixture_capture(fixture_path, "./build/bs2 expand '${fixture_path}' 2>&1 || true", "expand")
}

/// Write `source` to `path`, byte for byte. Returns nothing — pure side
/// effect. Used by spec tests that hand-roll their own bs2-invocation
/// commands (cmd-specific exit-code tests, warning-cap tests) and don't
/// want the cached_fixture_run wrapper.
///
/// The body is written VERBATIM, and must be: this writes fixture
/// SOURCE, so any transformation on the way in is corruption. Note that
/// means EXACTLY `source` — no trailing newline is appended, because the
/// caller did not ask for one.
///
/// **Not shell-mediated, deliberately.** This used to be a `cat` heredoc,
/// and every bug it had came from that:
///
///   1. It escaped single quotes (`.replace("'", "'\\''")`) on the stated
///      reasoning that a `'` would terminate the surrounding shell quote.
///      The delimiter was QUOTED (`<<'EOF'`) — precisely the form that
///      disables every quote rule inside the body — so the escape
///      protected nothing and wrote itself into the file. Any fixture with
///      an apostrophe came out mangled:
///          write_fixture(p, "it's fine")  ->  file: it'\''s fine
///   2. A heredoc ends at a body line equal to its delimiter. Moving off
///      `EOF` to something implausible shrank that risk but did not remove
///      it — the body is arbitrary caller data, so ANY fixed delimiter can
///      collide, and the escape hatch would silently TRUNCATE the fixture.
///
/// A direct atomic write has neither failure mode: there is no shell to
/// quote for and no terminator to collide with, so the whole class is gone
/// rather than made unlikely. Pinned by `write_fixture_roundtrip_test`,
/// which still covers the shell-hazard characters so that reintroducing a
/// shell-mediated writer goes red.
export fn write_fixture(path: string, source: string) {
    let _ = avra_selfhost_write_file(path, source)
}

/// Convenience: write `source` to `path`, then run it through
/// `cached_fixture_run`. Centralises the write-then-run dance every
/// fixture-style spec test used to inline. The source reaches the file
/// unmodified — see `write_fixture`.
export fn write_fixture_and_run(path: string, source: string) -> string {
    write_fixture(path, source)
    cached_fixture_capture_src(path, source, fixture_run_cmd(path), "run")
}


/// Content-keyed cache for `./build/bs2 check <path>` on the SHARD's @std
/// metadata FAST-PATH (metadata inherited, NOT stripped). The right default
/// for @std-importing fixtures: @std is compiled ONCE (the prebuild) and
/// stubbed here, and any @comptime/@derive/@query bodies the check needs are
/// rehydrated lazily from the metadata (9p1d) — so this is byte-identical to
/// the no-metadata strip but reuses the prebuilt @std instead of recompiling
/// all of it per fixture (~10x cheaper). Use `_no_metadata` ONLY for tests
/// that genuinely exercise the whole-program build path itself (build/cache).
///
/// Still slot-capped (diagnose.sh --slot-exec): unlike the no-metadata
/// sibling the check is now a LIGHT fast-path compile, but on a cold cache
/// (every rc-strict run) it still MISSES and shells out a real bs2 per
/// fixture across the parallel shard fan-out — so it holds one of the
/// AVRA_FIXTURE_JOBS OOM-guard slots, exactly as `--run` does for
/// write_fixture_and_run. On a cache HIT the command never runs.
export fn cached_fixture_check(fixture_path: string) -> string {
    cached_fixture_capture(fixture_path,
        "bash scripts/diagnose.sh --slot-exec ./build/bs2 check '${fixture_path}' 2>&1 || true",
        "check")
}


/// Convenience: write_fixture + cached_fixture_run_no_metadata.
/// Centralises the run_capture pattern duplicated across walker /
/// decoder tests (8+ inline copies before this helper).
export fn write_fixture_and_run_no_metadata(path: string, source: string) -> string {
    write_fixture(path, source)
    cached_fixture_capture_src(path, source, fixture_run_no_metadata_cmd(path), "run-no-metadata")
}

/// 6w6v: content-keyed cache for fixtures that need BOTH bs2 compile
/// stderr (the warning bag) AND runtime stdout. The standard
/// cached_fixture_run routes through diagnose.sh, which drops compile
/// stderr on success — so any test that asserts on a compile-time
/// warning (F9xxx, F0xxx informational) can't use it. Without a cached
/// alternative, those tests fall back to hand-rolled shell-outs that
/// pay full bs2 + llc + cc + run on every invocation (~734ms warm for
/// expand_introduces_validation_test).
///
/// The script: bs2 compile + llc + cc + run, capturing combined
/// stderr+stdout from compile and the run binary. AVRA_USE_METADATA
/// and AVRA_LIB_OBJS are preserved (caller's responsibility — usually
/// inherited from the test runner's env).
///
/// Returns concat of "compile\n + run". Same shape every hand-rolled
/// run_capture has used for the warning-bag tests; lets the test stay
/// a 1-line call with no shell escaping.
export fn cached_fixture_compile_and_run(fixture_path: string) -> string {
    let llvm_pfx = llvm_prefix_dir()
    let is_mac = avra_host_os() == "macos"
    let cxxlib = if is_mac { "-lc++" } else { "-lstdc++" }
    let ld_sel = if is_mac { "" } else { "-fuse-ld=lld" }
    // AVRA_LIB_OBJS is colon-separated; translate to a space-separated
    // string in shell. Done inside the cache cmd so the cache key
    // doesn't have to factor environment — toolchain_fp covers the
    // bs2/runtime/wrapper hashes; AVRA_LIB_OBJS contents change only
    // when those underlying .o files change.
    let extra_objs_expr = "$(printf '%s\\n' \"$AVRA_LIB_OBJS\" | tr ':' ' ')"
    // The compile rides a cross-process slot (diagnose.sh --slot-exec):
    // uncapped parallel bs2 fixture compiles OOM under the per_file
    // suite's shard × jobs fan-out.
    let cmd = "out_c=$(bash scripts/diagnose.sh --slot-exec ./build/bs2 compile '${fixture_path}' 2>&1 || true)\n" +
              "${llvm_pfx}/bin/llc -relocation-model=pic -filetype=obj '${fixture_path}.ll' -o '${fixture_path}.o' >/dev/null 2>&1 || true\n" +
              "cc '${fixture_path}.o' build/runtime.o build/llvm_wrapper.o ${extra_objs_expr} ${ld_sel} -L${llvm_pfx}/lib -lLLVM ${cxxlib} -o '${fixture_path}.bin' >/dev/null 2>&1 || true\n" +
              "out_r=$('${fixture_path}.bin' 2>&1 || true)\n" +
              "printf '%s\\n%s' \"$out_c\" \"$out_r\""
    cached_fixture_capture(fixture_path, cmd, "compile-and-run")
}

/// The fixture-stdout capture cache directory, relative to PWD. Single
/// source of truth for the layout: both the writer (cached_fixture_capture)
/// and the `bs2 cache clear-failed` evictor compose their paths from this,
/// so they can never disagree on where captures live.
/// `AVRA_FIXTURE_CACHE_DIR` redirects the capture store to a private root.
///
/// This exists so a spec that must MUTATE the cache — create captures, count
/// them, remove them — can do so without touching the shared one. Shards run
/// concurrently, so a spec that `rm -rf`s the shared directory deletes other
/// shards' captures AND their `.lock` files mid-run, which defeats the lock
/// serialisation those fixtures depend on. That is not hypothetical: the first
/// version of `fixture_cache_env_key_test` did exactly that and reddened an
/// unrelated shard on CI (`vtype_eq_no_fqn_tolerance_test_x8_…`, 6922/6923)
/// while passing locally, where the interleaving happened not to collide.
///
/// NOT part of the cache key: it changes where captures live, not what a
/// fixture emits.
export fn fixture_stdout_cache_dir() -> string {
    let custom = avra_process_env_get("AVRA_FIXTURE_CACHE_DIR")
    if custom != "" { return custom }
    "build/cache/fixture_stdout"
}

/// fxfz: source directive a fixture embeds (as a comment) to opt into
/// "stateful" cache treatment. Defined once so the producer (the fixture
/// source) and the consumer (fixture_is_stateful) key on the same token — a
/// raw duplicated sentinel would drift silently and quietly re-open the freeze.
export const FIXTURE_STATEFUL_MARKER: string = "@@fixture-stateful@@"

/// fxfz: true when the fixture's SOURCE opts into stateful cache treatment —
/// it pre-builds @std packages into the SHARED packages/*/build caches and
/// probes the resulting artifacts, build state that lives OUTSIDE the cache
/// key (toolchain fp + fixture source). Detected from the source rather than
/// the captured stdout so a run that is killed mid-capture (the OOM case fxfz
/// guards) can't drop the opt-in along with the truncated output.
export fn fixture_is_stateful(fixture_path: string) -> bool {
    avra_selfhost_read_file(fixture_path).contains(FIXTURE_STATEFUL_MARKER)
}

/// Shared helper. The verb is folded into the cache key so two
/// different command shapes against the same fixture don't share a
/// slot; everything else (toolchain fp + file hash + fixture path)
/// matches cached_fixture_run's pre-existing scheme.
///
/// cbg3.1: captured output is rejected from the cache when it carries
/// the signature of an aborted run (kernel kill notice, diagnose.sh
/// shell trap line). When the suite runs in --per_file mode several
/// `diagnose.sh --run` invocations share `$BUILD_DIR/last_run.log`;
/// if one process is jetsam-killed mid-compile, the shell's "Killed: 9"
/// message + the contents of the sibling process's last_run.log end
/// up on this fixture's stdout. Without validation we'd cache that
/// garbage forever — every later test hits a corrupted slot, fails
/// with no diff in source, and only `make clean` clears it. Refusing
/// to persist such outputs makes the next run re-execute the fixture
/// and pick up a clean stdout.
fn cached_fixture_capture(fixture_path: string, cmd: string, verb: string) -> string {
    cached_fixture_capture_src(fixture_path, null, cmd, verb)
}

/// The capture core. `source`, when non-null, is the fixture body the
/// caller intends the run to consume (the write_fixture_and_run*
/// family threads it through); it is REWRITTEN inside the lock so the
/// run provably executes those bytes even if another process clobbered
/// the shared path between the caller's write and our lock acquisition.
///
/// The 2026-07-13 walker poisoning found the gap the pre-lock write
/// left open: the per-fixture lock serializes RUNS, but write_fixture
/// happens OUTSIDE it — a concurrent process (an orphaned shard from a
/// killed suite run) rewrote the shared /tmp fixture with a DIFFERENT
/// spec's source mid-run, and the winner memoised output produced from
/// the overwriter's bytes under its own source's key. That capture
/// then replayed as a deterministic no-diff FAIL on every serial run.
/// Two closures for that hole:
///   1. rewrite-inside-lock (above) — the run consumes the keyed bytes;
///   2. the post-run TAINT GATE — re-hash the fixture after the run and
///      refuse to memoise when the bytes changed underneath us: the
///      output can't be trusted to correspond to the key. The live
///      caller still gets the (possibly wrong) output — overlapping
///      suite runs are already operator-forbidden — but the wrongness
///      can no longer OUTLIVE the overlap.
/// Environment that CHANGES what a fixture emits, folded into the cache key.
///
/// Without this, `AVRA_RC_STRICT=1 bs2 test` REPLAYS captures produced without
/// strict mode — so the run does not execute the fixtures under the very
/// instrument it was invoked to apply, and reports green. Measured on
/// `component_decl/tests/token_body_test.av`: a non-strict run published 5
/// captures, and the strict run that followed created ZERO new ones. That is
/// the mechanism behind t-k6lm's three green local strict suites over 937 warm
/// captures while cold CI failed identically twice, and behind CLAUDE.md's
/// standing instruction to `rm -rf build/cache/fixture_stdout` by hand (1608s
/// vs 506s). The instrument was disabled by the cache, silently.
///
/// Deliberately a small ALLOWLIST, not "every AVRA_* var". The resource knobs
/// — `AVRA_MEM_BUDGET_MB`, `AVRA_COMPILE_SLOT_DIR`/`_WIDTH`, `AVRA_SLOT_GATE_MB`
/// — are set PER UNIT by the admission governor and vary run to run, so
/// folding them in would key every capture uniquely and disable the cache
/// outright. These affect scheduling, not what a fixture prints; the ones
/// below affect the emitted IR or the runtime's behaviour, and so the output.
fn fixture_env_fp() -> string {
    mut s = ""
    for name in [
        "AVRA_RC_STRICT",         // poison-on-free + quarantine + foreign-release abort
        "AVRA_VERIFY_RC",         // codegen/setup.av:588 — emits verification calls, changes IR
        "AVRA_RC_NO_REGION",      // allocator path
        "AVRA_RC_TRACE",          // emits trace output
        "AVRA_CRASH_DETAIL",      // crash-report verbosity
        "AVRA_COMPTIME_LOOP_LIMIT",
        "AVRA_COMPTIME_MEM_LIMIT"
    ] {
        s = s + name + "=" + avra_process_env_get(name) + ";"
    }
    s
}

fn cached_fixture_capture_src(fixture_path: string, source: string?, cmd: string, verb: string) -> string {
    let cache_dir = fixture_stdout_cache_dir()
    let toolchain_fp = read_or_compute_toolchain_fp(cache_dir)
    let env_fp = fixture_env_fp()
    // Optimistic lock-free fast path: hash the file as-is; a warm hit
    // returns in ~10ms with no lock traffic. (If a concurrent writer
    // is mid-clobber this hash keys a slot we simply won't find — the
    // locked path below re-hashes authoritatively.)
    let fixture_h = sha256_file(fixture_path)
    let fast_key = sha256_hex("${toolchain_fp}:${env_fp}:${fixture_h}:${fixture_path}:${verb}")
    let fast_path = "${cache_dir}/${fast_key}.out"
    if avra_selfhost_file_exists(fast_path) == 1 {
        // Serve only a capture the write gate would publish TODAY — the full
        // publishability predicate, not just non-emptiness: a slot poisoned
        // before the gate existed (a frozen `Killed`, a half-materialised
        // write, a diagnose.sh error line) demotes to an honest MISS and
        // re-runs — reuse is gated on completeness, matching the
        // compile-cache discipline.
        let cached = avra_selfhost_read_file(fast_path)
        if fixture_output_is_publishable(cached, fixture_is_stateful(fixture_path)) {
            return cached
        }
    }
    let _ = avra_mkdir_p(cache_dir)
    // Serialize cold-misses per FIXTURE (not per cache slot): bs2
    // writes the fixture's .ll/.o at fixed sibling paths, so any two
    // concurrent runs of one fixture — same verb or different verbs
    // (run vs expand vs check share the same .ll!) — race on those
    // artifacts, and the loser historically captured garbage stdout.
    // The lock makes the second runner WAIT; for same-slot waiters
    // the post-acquire re-check then reuses the winner's published
    // result instead of re-running at all.
    let lock_fd = avra_file_lock_exclusive("${cache_dir}/${sha256_hex(fixture_path)}.lock")
    // Re-materialise the intended bytes now that we hold the lock; a
    // predecessor lock-holder may have left a DIFFERENT spec's source
    // at this shared path (write_fixture historically ran outside the
    // lock — the 2026-07-13 walker poisoning). sha256_file (not
    // sha256_hex(source)) keeps the key byte-identical to the
    // pre-existing scheme, so warm captures stay valid.
    if source != null {
        write_fixture(fixture_path, source!)
    }
    // The authoritative key: hashed AFTER lock + rewrite, so it names
    // the bytes the run will actually consume — never a clobberer's.
    let run_h = sha256_file(fixture_path)
    let run_key = sha256_hex("${toolchain_fp}:${env_fp}:${run_h}:${fixture_path}:${verb}")
    let cache_path = "${cache_dir}/${run_key}.out"
    if lock_fd >= 0 && avra_selfhost_file_exists(cache_path) == 1 {
        let cached = avra_selfhost_read_file(cache_path)
        if fixture_output_is_publishable(cached, fixture_is_stateful(fixture_path)) {
            avra_file_unlock(lock_fd)
            return cached
        }
    }
    let out = avra_shell_exec(cmd)
    // TAINT GATE: if the fixture's bytes changed underneath the run, the
    // output can't be trusted to correspond to the key — return it live
    // but never memoise it. (Poison from overlapping suite runs used to
    // freeze here and replay as a deterministic no-diff FAIL forever.)
    // Memoisation also requires the exclusive lock to have been HELD:
    // an unlocked run raced other writers by definition, so its capture
    // gets the same live-only treatment.
    let post_h = sha256_file(fixture_path)
    if lock_fd >= 0 && post_h == run_h && fixture_output_is_publishable(out, fixture_is_stateful(fixture_path)) {
        let _ = avra_selfhost_write_file(cache_path, out)
    }
    avra_file_unlock(lock_fd)
    out
}

/// True when a captured fixture stdout carries a PROBE failure — a LINE of the
/// form `PROBE <name>: FAIL` (optionally `PROBE <name>: FAIL <detail>`), the
/// shape the `probe()` helper emits. Anchored to that line convention (the line
/// must START with `PROBE `) rather than matching a bare `: FAIL` substring, so
/// a PASSING capture that merely mentions failure in running text — `step: FAIL
/// recovered`, `: FAILED`, `: FAILURE` — is never mistaken for a probe FAIL.
/// Shared by the cache write-gate (fixture_output_is_publishable, stateful
/// branch) and the `bs2 cache clear-failed` evictor, so the two can never
/// disagree about what counts as a frozen failure — a looser match would let
/// the evictor throw away a warm passing capture the write-gate deliberately
/// kept. (Fixture stdout is raw text with no AST to inspect, so the documented
/// `PROBE <name>: FAIL` line shape is the structural anchor available.)
export fn capture_has_probe_failure(out: string) -> bool {
    for line in out.split("\n") {
        if line.starts_with("PROBE ") && (line.ends_with(": FAIL") || line.contains(": FAIL ")) {
            return true
        }
    }
    false
}

/// cbg3.1 + zp5b: classify the captured output as safe-to-cache or
/// not. The patterns rejected here are environmental noise produced by
/// the shell/kernel/diagnose.sh when a fixture's bs2 invocation is
/// interrupted or aborts unexpectedly — they are not legitimate
/// fixture stdout, so caching them would freeze a transient failure
/// into a permanent one (the historic zp5b incident). The cache layer
/// then re-runs the fixture on the next call and gets a clean capture.
///
/// Each predicate matches a class of failure that is ALWAYS spurious
/// from the fixture's perspective:
///   - `scripts/diagnose.sh: line ` — bash trap line printed when the
///     wrapper script's compile/run step is killed mid-flight.
///   - `Killed: 9` / `Killed: 15` — macOS jetsam or external SIGKILL/
///     SIGTERM of bs2; never an intentional test outcome.
///   - `Bus error` / `Segmentation fault` — bs2 process crash.
///   - `bs2 codegen failed` / `bs2 compile failed` — diagnose.sh's
///     `die` markers (scripts/diagnose.sh:466,520,547,562,576). These
///     fire ONLY when the fixture failed to build at all — no test in
///     the suite intentionally asserts on these strings (grepped).
///
/// We deliberately do NOT filter generic "FAIL" or F-code (F0001 …
/// F9999) tokens: many spec/typeck tests intentionally assert that a
/// specific F-code fires, and rejecting them would force a re-run
/// every time. Zero-cost on the happy path is the requirement zp5b
/// reopened with. (The on-demand `bs2 cache clear-failed` command is
/// the escape hatch for a generic FAIL frozen by a one-off transient.)
///
/// fxfz: `fixture_stateful` (computed by `fixture_is_stateful` from the
/// fixture SOURCE) marks a fixture that pre-builds @std packages into the
/// SHARED `packages/*/build` caches and probes the resulting artifacts —
/// build state NOT covered by the fixture cache key (toolchain fp + fixture
/// source). A capture taken while that shared cache sat in a corrupt /
/// half-published state would otherwise be frozen and replayed forever, since
/// repairing the cache changes neither key input (the historic fxfz freeze:
/// `cli_metadata_compile`'s `PROBE std_cli_meta_present: FAIL`). So when a
/// stateful fixture reports a probe FAIL (`capture_has_probe_failure`), reject
/// the capture and let the next invocation re-probe once the build state is
/// consistent. Happy captures (every probe `: ok`) carry no probe FAIL, so they
/// cache normally — zero cost on the passing path. A fixture asserting an
/// EXPECTED failure simply omits the stateful directive, keeping its FAIL
/// cacheable.
export fn fixture_output_is_publishable(out: string, fixture_stateful: bool) -> bool {
    // A dead-silent capture — empty or whitespace-only — is a producer that
    // DIED before printing anything: every capture cmd's compile step emits
    // at least the .ll path on success or an error on failure, and a direct
    // SIGKILL of the child leaves NO shell noise line for the patterns below
    // to catch (the `|| true` steps swallow the death). Publishing one
    // freezes the silence as truth and every later run replays an
    // inexplicable no-diff FAIL. A fixture with genuinely empty output
    // simply re-runs each time — correctness over a warm hit.
    if out.trim() == "" { return false }
    if fixture_stateful && capture_has_probe_failure(out) { return false }
    if out.contains("scripts/diagnose.sh: line ") { return false }
    // An OOM kill (or any SIGKILL) is never legitimate fixture stdout, and
    // caching one freezes a transient out-of-memory failure into a permanent
    // one (the fxfz hazard): a heavy fixture OOM-killed once would fail
    // forever even after the pressure clears. Reject so the next run
    // re-captures. See output_has_kill_marker for why the match is
    // line-anchored rather than a substring.
    if output_has_kill_marker(out) { return false }
    // t-mji3: a full disk is the box failing, not the fixture speaking. The
    // shard classifier already ranked this ABOVE every other cause; this gate
    // did not test it at all, so the same run that correctly reported `DISK
    // FULL` also froze the truncated output as the fixture's answer. Because
    // this predicate gates the READ as well as the write, adding it here also
    // retires captures already poisoned by an earlier full disk — they demote
    // to an honest MISS and re-run, which is the part `cache clear-failed`
    // could not do.
    if output_has_disk_full_marker(out) { return false }
    if out.contains("compile produced no IR") { return false }
    if out.contains("Out of memory") { return false }
    if out.contains("Bus error") { return false }
    if out.contains("Segmentation fault") { return false }
    if out.contains("bs2 codegen failed") { return false }
    if out.contains("bs2 compile failed") { return false }
    // 927f: a fixture that fails to LINK (duplicate/undefined symbols
    // from a stale or inconsistent metadata/realobj state) emits the
    // linker's error to stdout instead of its PROBE lines. Caching that
    // freezes a transient build-state failure into a permanent one — the
    // same hazard as the codegen/compile markers above. These strings are
    // never legitimate fixture stdout (grepped: no test asserts on them),
    // so reject them and let the next invocation re-capture once the build
    // state is consistent.
    if out.contains("ld.lld: error:") { return false }
    if out.contains("duplicate symbol") { return false }
    if out.contains("undefined symbol") { return false }
    if out.contains("ld returned ") { return false }
    if out.contains("collect2: error:") { return false }
    if out.contains("shard compile failed") { return false }
    // t-mji3: the entries above are gcc/lld reporting a link it COMPLETED and
    // rejected. These two are the link dying instead: `link failed for <out>`
    // is diagnose.sh's own `die` from the fixture runner's link step, and cc
    // reports a linker that was signalled (OOM-killed, or aborted on a short
    // write) as `ld terminated with signal N`. Both were present in captures
    // poisoned by a full disk and passed the gate, because a violent linker
    // death prints neither `collect2: error:` nor `ld returned`.
    if out.contains("link failed for ") { return false }
    if out.contains("ld terminated with signal ") { return false }
    // jdgo: continuous dispatch (cbg3 follow-up) increased concurrent
    // diagnose.sh invocations. The shell script's `cc -o ${out}.tmp`
    // followed by `mv ${out}.tmp $out` is not race-safe under high
    // concurrency: when two shards' diagnose.sh stages write to /tmp
    // simultaneously (e.g. per-shard temp paths colliding under heavy
    // parallel cold load), the `mv` step prints `mv: rename ... : No
    // such file or directory`. The rest of the captured output is
    // typically the previous fixture's stale bin stdout — caching that
    // freezes the wrong answer. Reject it so the next test invocation
    // re-runs cleanly. Root-cause fix would isolate diagnose.sh's
    // working artifacts per-shard, but that's a separate scope.
    if out.contains("mv: rename ") { return false }
    true
}

/// Memoised hash of (bs2, runtime.o, llvm_wrapper.o). Read from the
/// sidecar when present and newer than every input; recomputed
/// otherwise. The sidecar is plain hex (64 chars), so an unrelated
/// touch (e.g. `make clean` deleting the cache dir) just forces one
/// recomputation, never a wrong hit.
///
/// 4szi.1: an in-process memo layered on top short-circuits the
/// sidecar logic entirely after the first call per process. The
/// sidecar's invariants imply that within a single bs2 invocation
/// no input can change (the binary can't rebuild itself mid-run),
/// so the first call's result holds for the whole process.
fn read_or_compute_toolchain_fp(cache_dir: string) -> string {
    let memoed = avra_test_toolchain_fp_get()
    // Trust the memo only when it is SHAPED like a real fingerprint, never
    // merely because it is non-empty. The memo is process-global and
    // write-once, and it feeds every fixture cache KEY — hence the on-disk
    // capture filenames. A value that did not come from
    // compute_or_read_toolchain_fp_sidecar (a spec probing the write-once
    // contract is the one real source) would otherwise key every capture in
    // this process under a string that NEVER changes when the toolchain
    // does, so a capture produced by an OLDER compiler replays as current —
    // an invisible stale hit, since the key is a hash nobody eyeballs
    // (t-n832; the poisoned run reported a bare assertion FAIL with no diff
    // to explain it). Every real fp is sha256_hex output.
    if is_toolchain_fp_shaped(memoed) { return memoed }
    let computed = compute_or_read_toolchain_fp_sidecar(cache_dir)
    // Write-once: if a foreign value already won the publish this set is a
    // no-op, so we recompute per call rather than key on a value we cannot
    // trust. That is the pre-memo cost, paid only in the poisoned process.
    avra_test_toolchain_fp_set(computed)
    computed
}

/// A real toolchain fp is `sha256_hex` output — exactly 64 lowercase hex
/// chars (the sidecar contract: "plain hex (64 chars)"). Anything else did
/// not come from the sidecar path and must never key a fixture capture.
/// Shape, not provenance, is the strongest check available here: the memo
/// crosses a C boundary that carries no origin.
export fn is_toolchain_fp_shaped(fp: string) -> bool {
    if fp.length != 64 { return false }
    mut i = 0
    while i < 64 {
        let b = byte_at_str(fp, i)
        let is_digit = b >= 48 && b <= 57      // '0'..'9'
        let is_hex_af = b >= 97 && b <= 102    // 'a'..'f' (sha256_hex is lowercase)
        if is_digit || is_hex_af { i = i + 1 } else { return false }
    }
    true
}

/// Publish the REAL toolchain fp into the process-global memo, returning it.
/// Idempotent (the memo is write-once), so calling it early is always safe.
///
/// Exists for the write-once spec, which must NOT be the memo's first
/// writer: a probe value winning the cold publish is exactly the t-n832
/// poisoning above. Warming first makes that spec's probe set a guaranteed
/// no-op instead of a process-wide cache-key corruption.
export fn warm_toolchain_fp() -> string {
    read_or_compute_toolchain_fp(fixture_stdout_cache_dir())
}

/// The cold-path sidecar logic. Computes the fingerprint from disk
/// (or reads it from the cache directory's sidecar when valid).
/// Carved out from `read_or_compute_toolchain_fp` so the memoised
/// fast path stays a 2-line check that's obviously a no-op when
/// the memo is warm.
fn compute_or_read_toolchain_fp_sidecar(cache_dir: string) -> string {
    let sidecar = "${cache_dir}/.toolchain-fp"
    if avra_selfhost_file_exists(sidecar) == 1
        && sidecar_newer_than_inputs(sidecar) {
        return avra_selfhost_read_file(sidecar)
    }
    mut file_h = ""
    for f in toolchain_fp_input_files() { file_h = file_h + sha256_file(f) + ":" }
    // so07.7.11: hash std-avrac source so derive_walker / quote_expr /
    // other macro-shaping edits invalidate cached fixture stdout even
    // when the resulting bs2 binary happens to hash the same (unlikely
    // but possible with cache-hit paths). `shasum` invocation is ~50ms
    // amortised across the suite — sidecar_newer_than_inputs short-
    // circuits when no src changed, so the cost only hits on miss.
    let src_h = sha256_hex(avra_shell_exec("find packages/std-avrac/src -name '*.av' -type f | sort | xargs shasum -a 256 2>/dev/null | shasum -a 256 | awk '{print $1}'"))
    let combined = sha256_hex("${file_h}${src_h}")
    let _ = avra_mkdir_p(cache_dir)
    let _ = avra_selfhost_write_file(sidecar, combined)
    combined
}

/// Every file the fixture-stdout cache's toolchain fingerprint depends on.
///
/// ONE list, consumed by BOTH the hash and the mtime short-circuit below —
/// an input present in one but not the other is either a stale hit or a
/// needless miss, and the two had already drifted once.
///
/// `scripts/diagnose.sh` belongs here and was missing: `fixture_run_cmd`
/// RUNS every fixture through it, so it is not merely an influence on the
/// output (the reason so07.7.11 added std-avrac's source), it is the thing
/// that produces the output. Editing it changed how every fixture executes
/// while leaving the key untouched, so the suite replayed captures made by
/// the previous version — a full run came back in 70s instead of ~310s and
/// reported green without re-running a single fixture. Caught while changing
/// `source_newer_than`, which is read from this very script by two specs.
export fn toolchain_fp_input_files() -> List<string> {
    ["build/bs2", "build/runtime.o", "build/llvm_wrapper.o", "scripts/diagnose.sh"]
}

/// True when `sidecar` is strictly newer than every fingerprint input, so
/// its cached value can be reused. `files` is injected so a spec can drive
/// the real comparison against a sandbox instead of the live tree.
///
/// A MISSING input rejects reuse. `avra_file_mtime` answers 0 for a path it
/// cannot stat, and 0 is older than any real sidecar — so a bare comparison
/// reads "deleted" as "unchanged" and licenses replaying a capture taken
/// against a file that is no longer there. The whole point of this check is
/// to decide whether a cached fingerprint still describes reality; an input
/// it cannot see is the one case where it certainly does not. Raised in
/// review of #1136, where the spec below documented the old behaviour as
/// current rather than fixing it.
export fn sidecar_newer_than_files(sidecar: string, files: List<string>) -> bool {
    let s_mtime = avra_file_mtime(sidecar)
    for f in files {
        let f_mtime = avra_file_mtime(f)
        if f_mtime <= 0 { return false }
        if s_mtime <= f_mtime { return false }
    }
    true
}

fn sidecar_newer_than_inputs(sidecar: string) -> bool {
    let s_mtime = avra_file_mtime(sidecar)
    if !sidecar_newer_than_files(sidecar, toolchain_fp_input_files()) { return false }
    // so07.7.11: also reject the sidecar when any std-avrac src is
    // newer. `find -newer <ref> -print -quit` returns the first match
    // and exits — O(1)-ish across the tree. Empty stdout = no src
    // changed since the last fp computation.
    let newer = avra_shell_exec("find packages/std-avrac/src -name '*.av' -type f -newer '${sidecar}' -print -quit 2>/dev/null")
    newer == ""
}

// t-65td: WHAT KIND of failure was this? Five of the six causes a red
// shard can have are ENVIRONMENTAL, and before this they all rendered
// the same way — so the first diagnostic step ("is this my code or the
// box?") was a manual log dive, and got answered wrong: a memory kill
// was once investigated as a type-gate bug that did not exist.
//
// ORDER IS THE WHOLE DESIGN. The environmental causes must be tested
// BEFORE the generic compile check, because each of them also prints
// something that matches it:
//   - F4014 (the compiler's own memory self-stop) is literally
//     `error[F4014]`, so a naive `error[F` test calls a box-pressure
//     stop a code error — exactly the wrong turn this ticket exists to
//     stop. It names the phase, which is the actionable part.
//   - ENOSPC surfaces as write failures that read like compile errors
//     (t-2qn0 shipped as false test FAILURES for this reason).
// A kill leaves a TRUNCATED log, so "no content + died" must not read
// as "passed nothing"; it reads as killed, and points at `make stray`.
//
// Pure (string in, string out) so the spec table can pin every branch
// without staging real OOMs or filling a disk.
export fn classify_shard_failure(out: string, fail: int, crashes: int) -> string {
    if output_has_disk_full_marker(out) {
        return "DISK FULL — the box ran out of space (this is not a test failure; see `make cache-gc`)"
    }
    if out.contains("error[F4014]") {
        let phase = extract_after(out, "phase: ")
        let detail = if phase == "" { "" } else { " during ${phase}" }
        return "MEMORY CEILING — the compiler stopped itself${detail} (F4014; an F4014 on normal input is a compiler bug, not a small box)"
    }
    if output_has_kill_marker(out) {
        return "KILLED — probable kernel OOM-kill; check `make stray` for survivors (the log is truncated by the kill)"
    }
    if out.contains("error[F") {
        let code = extract_after(out, "error[")
        let named = if code == "" { "" } else { " (first: ${code})" }
        return "COMPILE FAILED${named}"
    }
    if crashes > 0 {
        return "${string(crashes)} spec(s) CRASHED on a fatal signal"
    }
    if fail > 0 {
        let spec_name = extract_after(out, "FAIL \"")
        let named = if spec_name == "" { "" } else { " (first: ${spec_name})" }
        return "${string(fail)} TEST FAILURE(S)${named}"
    }
    "FAILED — cause not classified; read the log"
}

/// Did the SHELL report this output's producer as killed?
///
/// LINE-ANCHORED ON PURPOSE. A kill is announced by the shell as its own
/// record — a bare `Killed` line, or macOS's `Killed: 9` / `Killed: 15` —
/// and the shard log also carries the TEST's own stdout. Matching the bare
/// word anywhere would misread any test that merely mentions killing as a
/// kernel kill, and this tree has several that kill processes on purpose
/// (stray_reap_test). Their assertion failures would then be reported as
/// phantom OOM-kills: precisely the misattribution the cause classifier
/// exists to prevent, reintroduced by its own kill check.
///
/// The `Killed: <n>` forms stay substring matches — a shell prefixes them
/// with the job spec, so they are not line-initial, and no legitimate
/// output carries that exact shape.
///
/// ONE definition, two callers (the fixture-publish gate and the shard
/// cause classifier): both answer "did the OS reap this?", and a second
/// copy is how the two drift apart.
export fn output_has_kill_marker(out: string) -> bool {
    if out.contains("Killed: 9") || out.contains("Killed: 15") { return true }
    out.contains("\nKilled\n") || out.starts_with("Killed\n")
        || out.ends_with("\nKilled") || out == "Killed"
}

/// Did this output's producer fail because the BOX ran out of disk?
///
/// The sibling of `output_has_kill_marker`, and it exists for the same
/// stated reason: the fixture-publish gate and the shard cause classifier
/// both have to answer "was this the box, not the code?", and they have to
/// give the SAME answer. They did not. The classifier tested ENOSPC inline
/// — as its TOP-ranked cause, outranking everything — while the publish
/// gate did not test it at all. So one disk-full run could correctly print
/// `DISK FULL` in the shard summary and, in that same run, MEMOISE the
/// truncated output as though it were the fixture's real stdout.
///
/// That capture then replays as a deterministic no-diff FAIL, in tests the
/// diff never touched, long after the disk is free — and it is not evicted
/// by `bs2 cache clear-failed`, which only targets captures whose text
/// contains `: FAIL`. A disk-full capture usually has no assertion output
/// at all, so the documented recovery step silently misses it. Diagnosing
/// that from the symptom means already suspecting the cache (t-mji3).
///
/// Unlike the kill marker these need no line anchoring: `No space left on
/// device` is a strerror string, not a shell record, and it is never
/// legitimate fixture stdout — the one occurrence in the tree is a shard
/// log staged as INPUT to the classifier, not a capture.
export fn output_has_disk_full_marker(out: string) -> bool {
    out.contains("No space left on device") || out.contains("ENOSPC")
}

/// First token following `key`, stopped at the delimiter that ends the
/// field it names — `]` closes an F-code, `"` closes a quoted spec name,
/// and a newline ends anything. Returns "" when the key is absent, so
/// every caller degrades to an unadorned message rather than a lie.
export fn extract_after(out: string, key: string) -> string {
    let idx = out.index_of(key)
    if idx < 0 { return "" }
    let start = idx + key.length
    mut i = start
    while i < out.length {
        let ch = out[i]
        if ch == "\n" || ch == "]" || ch == "\"" { break }
        i = i + 1
    }
    if i == start { return "" }
    out.substring(start, i)
}

// ── t-o8pm: gate scan ───────────────────────────────────────────────
//
// WHY: "if I turn this gate on, what does it reject?" had no one-pass
// answer, so false positives arrived ONE RUN AT A TIME. The t-axu9
// argument gate was validated by a COUNT over the compiler's own source
// — 935 naive hits narrowed to 0 — and that 0 was believed. It was not
// evidence: three false-positive classes were still live (`dyn Trait`
// conformance, `shape` width subtyping, newtype-vs-underlying), and each
// surfaced from a DIFFERENT oracle on a DIFFERENT run. The compiler's
// own source never passes a struct into a shape parameter, never calls
// through a `dyn` parameter, and never pushes a raw value into a
// collection of its newtype — so a count over it proves only that THAT
// program avoids the construct, which reads like coverage and is not.
//
// The fix is to group every rejection in the corpus by its SHAPE, so N
// sites collapse to the handful of distinct conflicts a human must
// actually reason about.

/// One rejection: where it happened, what was said, and the shape it
/// belongs to. `form` is the grouping key; `message` keeps the concrete
/// text so an example can be shown verbatim. `code`/`severity` let the
/// same site serve a code-agnostic scan (t-zk6j's OLD-vs-NEW delta) as
/// well as the single-code gate scan this type was introduced for.
export type GateSite = {
    code: string, severity: string, form: string, file: string, message: string,
}

/// The SHAPE of a diagnostic — its message with call-site identity
/// removed, so the same conflict reported at forty call sites groups
/// into one row.
///
/// Two normalisations, both chosen because they vary per SITE while the
/// conflict does not:
///   - a leading ``  `fn` parameter `p`:  `` prefix (which function, which
///     parameter)
///   - a trailing `` (in function `f`) `` suffix (which caller)
/// What remains is the relation under test — `A` is not assignable to
/// `B` — different nominal types — which is exactly what a gate author
/// needs to see once per distinct pair, not once per call.
export fn diagnostic_shape(message: string) -> string {
    mut s = message
    let in_fn = s.index_of(" (in function `")
    if in_fn >= 0 { s = s.substring(0, in_fn) }
    // `<fn>` parameter `<name>`: <relation>   → keep the relation only.
    let param_mark = s.index_of("` parameter `")
    if param_mark >= 0 {
        let colon = s.index_of("`: ")
        if colon > param_mark { s = s.substring(colon + 3, s.length) }
    }
    s.trim()
}

/// Drop ANSI SGR sequences (`ESC [ … m`) so matching sees the text a
/// human reads. Anything between ESC-[ and the terminating letter is an
/// attribute payload, never content.
export fn strip_ansi(s: string) -> string {
    if s.index_of("\x1b") < 0 { return s }
    mut out = ""
    mut i = 0
    while i < s.length {
        let ch = s[i]
        if ch == "\x1b" {
            // skip through the terminating alphabetic byte
            mut j = i + 1
            while j < s.length {
                let c2 = s[j]
                if (c2 >= "a" && c2 <= "z") || (c2 >= "A" && c2 <= "Z") { break }
                j = j + 1
            }
            i = j + 1
            continue
        }
        out = out + ch
        i = i + 1
    }
    out
}

/// Every diagnostic in `log` carrying `code`, paired with the file it
/// came from. A filter over `scan_diagnostics` — one scanner, so the
/// ANSI/location/attribution handling below cannot drift between the
/// single-code gate scan and the code-agnostic delta.
///
/// ERRORS only. The gate question is "what would this reject", and a
/// warning rejects nothing. (F-code ranges make errors and warnings
/// disjoint anyway, so this is a statement of intent more than a filter.)
export fn scan_gate_diagnostics(colored_log: string, code: string) -> List<GateSite> {
    mut out: List<GateSite> = []
    for s in scan_diagnostics(colored_log) {
        if s.code == code && s.severity == "error" { out.push(s) }
    }
    out
}

/// Every diagnostic in `log`, whatever its code or severity, paired with
/// the file it came from. The renderer's `╭─[path:line:col]` line follows
/// the message, so the file is read from the NEXT location line —
/// tracking it forward rather than guessing from the message keeps a
/// diagnostic attributable even when several shards' logs are
/// concatenated.
export fn scan_diagnostics(colored_log: string) -> List<GateSite> {
    // STRIP COLOUR FIRST. The compiler renders diagnostics with ANSI
    // attributes, and it puts them BETWEEN the code and its colon:
    // `error[F1000]` ESC[0m ESC[1m `: message`. A literal
    // `error[F1000]: ` needle therefore matches a hand-written sample
    // and NOTHING the compiler actually emits — which is precisely the
    // failure this ticket exists to prevent (a synthetic oracle that
    // reads like coverage), so the specs below use real captured output.
    let log = strip_ansi(colored_log)
    mut sites: List<GateSite> = []
    mut pending: List<GateSite> = []   // diagnostics awaiting their location line
    for line in log.split("\n") {
        let d = parse_diagnostic_line(line)
        if d.code != "" {
            pending.push(d)
            continue
        }
        // `─[` is a BOX-DRAWING char (3 bytes) + `[`, so the skip must be
        // the needle's own byte length — a hardcoded 2 lands mid-character
        // and shreds the path.
        let loc_needle = "─["
        let loc = line.index_of(loc_needle)
        if loc >= 0 && pending.length > 0 {
            let file = gate_scan_file_of(line.substring(loc + loc_needle.length, line.length))
            for p in pending {
                sites.push(GateSite {
                    code: p.code, severity: p.severity, form: p.form,
                    file: file, message: p.message,
                })
            }
            pending = []
        }
    }
    // A trailing message with no location line still counts as a site —
    // dropping it would under-report, and under-reporting is the exact
    // failure this tool exists to prevent. `parse_diagnostic_line` already
    // stamped it `<unknown>`.
    for p in pending { sites.push(p) }
    sites
}

/// One rendered diagnostic line → a site, or a `code == ""` sentinel when
/// the line carries none. Recognises `error[F…]:` and `warning[F…]:`,
/// which is the whole surface `CompileError::render()` emits.
///
/// The `F` prefix is REQUIRED (spec Axis 20: F-codes are the stable
/// identifiers). Without it a log line quoting `error[` in prose — a spec
/// name, a captured fixture — would be scanned as a diagnostic and
/// inflate the delta.
fn parse_diagnostic_line(line: string) -> GateSite {
    // Try each severity INDEPENDENTLY. Committing to `error` merely because
    // the line contains `error[` somewhere lets prose shadow a real
    // diagnostic: a shard log carries test stdout, so a line can hold a
    // quoted `error[oops]:` AND a genuine `warning[F9002]:`. Under a
    // first-marker-wins rule the prose claims the line, fails the F-code
    // check, and the warning is dropped — under-reporting, which is the
    // failure this whole family of tools exists to prevent.
    let as_error = parse_diagnostic_at(line, "error")
    if as_error.code != "" { return as_error }
    parse_diagnostic_at(line, "warning")
}

/// One severity's marker on one line → a site, or a `code == ""` sentinel.
fn parse_diagnostic_at(line: string, sev: string) -> GateSite {
    let no_diag = GateSite { code: "", severity: "", form: "", file: "", message: "" }
    let at = line.index_of("${sev}[")
    if at < 0 { return no_diag }
    // Past `<sev>[` — +1 for the bracket.
    let after = line.substring(at + sev.length + 1, line.length)
    let close = after.index_of("]:")
    if close < 0 { return no_diag }
    let code = after.substring(0, close)
    if !code.starts_with("F") || code.length < 2 { return no_diag }
    let msg = after.substring(close + 2, after.length).trim()
    GateSite {
        code: code, severity: sev, form: diagnostic_shape(msg),
        file: "<unknown>", message: msg,
    }
}

/// `path:line:col]…` → `path`. Stops at the first `:` that begins the
/// line:col suffix, so a path containing no colon survives intact.
fn gate_scan_file_of(rest: string) -> string {
    mut i = 0
    while i < rest.length {
        let ch = rest[i]
        if ch == ":" || ch == "]" { break }
        i = i + 1
    }
    rest.substring(0, i)
}

/// One grouped row: a distinct conflict, how many sites share it, and
/// one example file.
export type GateGroup = { form: string, count: int, example: string }

/// The report: every rejection grouped by form, most-frequent first,
/// each row naming one example file and how many more share it.
///
///     F1000 — 4 site(s), 3 shape(s):
///       [2] `SbUser` is not assignable to `SbHasName` — different nominal types
///           e.g. packages/.../shape_basic_test.av (+1 more)
///
/// Counts lead because the decision a gate author makes is per CONFLICT:
/// three distinct conflicts is a tractable review, forty call sites of
/// one conflict is a single exemption.
export fn render_gate_scan(sites: List<GateSite>, code: string) -> string {
    if sites.length == 0 {
        return "${code} — no sites in the scanned corpus."
    }
    let groups = sort_gate_groups(group_gate_sites(sites))
    mut out = "${code} — ${string(sites.length)} site(s), ${string(groups.length)} shape(s):\n"
    for g in groups {
        let more = g.count - 1
        let extra = if more > 0 { " (+${string(more)} more)" } else { "" }
        out = out + "  [${string(g.count)}] ${g.form}\n"
        out = out + "      e.g. ${g.example}${extra}\n"
    }
    out
}

/// Collapse sites onto their distinct forms, keeping the first file seen
/// for each as the example.
export fn group_gate_sites(sites: List<GateSite>) -> List<GateGroup> {
    mut forms: List<string> = []
    for s in sites {
        if index_of_string(forms, s.form) < 0 { forms.push(s.form) }
    }
    mut out: List<GateGroup> = []
    for f in forms {
        mut n = 0
        mut example = ""
        for s in sites {
            if s.form == f {
                n = n + 1
                if example == "" { example = s.file }
            }
        }
        out.push(GateGroup { form: f, count: n, example: example })
    }
    out
}

/// Descending by count. Insertion into a fresh list (push-only) rather
/// than an in-place swap: the widest conflict is the one a gate author
/// should judge first.
fn sort_gate_groups(gs: List<GateGroup>) -> List<GateGroup> {
    mut out: List<GateGroup> = []
    for g in gs {
        mut placed: List<GateGroup> = []
        mut inserted = false
        for o in out {
            if !inserted {
                if g.count > o.count {
                    placed.push(g)
                    inserted = true
                }
            }
            placed.push(o)
        }
        if !inserted { placed.push(g) }
        out = placed
    }
    out
}

/// First index of `needle` in `hay`, or -1. Local because the grouping
/// above needs identity on plain strings and nothing else in this module
/// wants a generic list search.
fn index_of_string(hay: List<string>, needle: string) -> int {
    mut i = 0
    while i < hay.length {
        if hay[i] == needle { return i }
        i = i + 1
    }
    0 - 1
}

// ─────────────────────────────────────────────────────────────────────
// t-zk6j: what NEW says that OLD does not
// ─────────────────────────────────────────────────────────────────────
//
// diff-test has BOTH compilers compile the SAME source, so any IR
// difference is attributable to compiler source alone. Correct, and the
// reason the oracle is trustworthy — but it means a PR that makes the
// compiler REJECT something fails on a COMPILE error rather than an IR
// difference, and the harness called that "regression".
//
// It is not a regression. For a deliberate strictness change it is the
// new compiler working. What the operator needs at that moment is the
// one thing the old message did not give: WHICH diagnostics NEW raises
// that OLD does not, so they can confirm the set is the expected one.
//
// The comparison is a MULTISET difference, not a set difference. A
// conflict reported at three call sites where OLD reported it at one is
// two new rejections, and collapsing them would under-report — the same
// failure mode the scanner above is careful about.

/// The diagnostics `new_log` carries that `old_log` does not.
///
/// Identity is (severity, code, file, message): the same conflict at a
/// different file or a different call site is a different rejection to
/// judge. Grouping onto shapes happens at RENDER time, so the count here
/// stays honest.
export fn new_only_diagnostics(new_log: string, old_log: string) -> List<GateSite> {
    mut unmatched: List<string> = []
    for o in scan_diagnostics(old_log) { unmatched.push(diag_identity(o)) }
    mut out: List<GateSite> = []
    for n in scan_diagnostics(new_log) {
        let at = index_of_string(unmatched, diag_identity(n))
        if at >= 0 {
            // CONSUME the match: multiset, not set. Two identical new
            // rejections against one old occurrence leave one new.
            unmatched = list_drop_index(unmatched, at)
        } else {
            out.push(n)
        }
    }
    out
}

fn diag_identity(s: GateSite) -> string {
    "${s.severity}|${s.code}|${s.file}|${s.message}"
}

/// `xs` without the element at `at`. Rebuilt push-only — indexed
/// assignment is not an assignment target in this language.
fn list_drop_index(xs: List<string>, at: int) -> List<string> {
    mut out: List<string> = []
    mut i = 0
    while i < xs.length {
        if i != at { out.push(xs[i]) }
        i = i + 1
    }
    out
}

/// Is this delta a STRICTNESS change — the compiler deliberately
/// rejecting more programs — or a malfunction wearing its clothes?
///
/// Three things disqualify it, and all three matter because the
/// strictness landing path RELAXES the gate (it lets NEW reject OLD's
/// source), so it must not become a way to land a broken compiler:
///
///   - NO new ERROR. A delta of warnings only is not a rejection: a
///     warning rejects nothing, so nothing explains the failed compile.
///     (An empty delta is the same statement — NEW failed while saying
///     nothing OLD did not, so the failure is a crash, a signal, or a
///     truncated log.)
///   - an F9999 (ICE) or F4014 (compiler memory ceiling). Those are the
///     compiler malfunctioning or hitting a resource limit. Neither is a
///     judgement about the program, which is what a gate is.
export fn delta_is_strictness(sites: List<GateSite>) -> bool {
    mut has_error = false
    for s in sites {
        if s.code == "F9999" || s.code == "F4014" { return false }
        if s.severity == "error" { has_error = true }
    }
    has_error
}

/// The delta, grouped by code and then by conflict shape — the report
/// that answers "are these the rejections I intended?".
///
/// Per code it reuses `render_gate_scan`, so a strictness review reads
/// exactly like a gate scan (t-o8pm): widest conflict first, one example
/// file each, call-site identity normalised away.
/// ERRORS FIRST, and warnings kept but demoted. The decision this report
/// serves is "are these the rejections I intended", and only errors
/// reject. A real run put three `unused import` warnings above the one
/// rejection that mattered — correct output, useless ordering.
export fn render_strictness_delta(sites: List<GateSite>) -> string {
    mut errors: List<GateSite> = []
    mut warnings: List<GateSite> = []
    for s in sites {
        if s.severity == "error" { errors.push(s) } else { warnings.push(s) }
    }
    if errors.length == 0 {
        mut why = "NEW raises NO error that OLD does not — its compile failed for some other\n" +
                  "reason (crash, signal, or a truncated log). This is NOT a strictness change;\n" +
                  "read the compile log itself."
        if warnings.length > 0 {
            why = why + "\n(${string(warnings.length)} new warning(s) present, but a warning rejects nothing.)"
        }
        return why
    }
    mut out = "NEW raises ${string(errors.length)} error(s) that OLD does not:\n"
    out = out + render_by_code(errors)
    if warnings.length > 0 {
        out = out + "…and ${string(warnings.length)} new warning(s), which reject nothing:\n"
        out = out + render_by_code(warnings)
    }
    if !delta_is_strictness(sites) {
        out = out + "\n!! F9999 (ICE) and/or F4014 (memory ceiling) present — the compiler is\n" +
                    "!! malfunctioning or out of budget, NOT gating. This does not qualify as an\n" +
                    "!! intended strictness change.\n"
    }
    out
}

/// Group by F-code, then hand each code's sites to the gate-scan
/// renderer so a strictness review reads exactly like a gate scan.
fn render_by_code(sites: List<GateSite>) -> string {
    mut codes: List<string> = []
    for s in sites {
        if index_of_string(codes, s.code) < 0 { codes.push(s.code) }
    }
    mut out = ""
    for c in codes {
        mut of_code: List<GateSite> = []
        for s in sites { if s.code == c { of_code.push(s) } }
        out = out + render_gate_scan(of_code, c)
    }
    out
}
