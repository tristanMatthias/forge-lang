// WHY: Pure-AST helpers for assembling a synthetic test program from a
// set of `_test.av` source files. Used by the `avra test` driver to
// stitch each test file into one StmtList, hoist package modules so
// each @std package appears only once, and prepend the externs the
// test harness binds against.
//
// All functions here are pure on the AST side — no I/O, no argv, no
// process exit. Any caller (CLI driver, IDE plugin, fuzz harness) can
// reuse them to build a test program.

use core.{
    Stmt, StmtList, SStmt, ParamList, ValueType, TypeParamList,
    Expr, ExprList,
    sstmt_dummy, sstmt_at,
    sexpr_dummy,
    avra_shell_exec,
    avra_selfhost_file_exists,
    avra_selfhost_read_file,
    avra_selfhost_write_file,
    avra_mkdir_p,
    avra_file_mtime,
}
use features.modules.{
    hoist_package_modules, HoistSplit,
    resolve_module_files, modules_dirname, find_packages_dir,
    LoadedPaths, dedup_modules,
}
use parse.{parse_program_source_at}
use diagnostics.{bag_has_errors, render_bag}
use pathutil.{basename_no_ext}
use @std.crypto.{sha256_hex, sha256_file}

/// Drop every `extern fn` declaration from the list.
///
/// Test files re-import the extern declarations the runtime supplies
/// (`avra_test_*`); when we then concatenate the file's body into a
/// shared program, those externs would collide with the canonical
/// set we prepend in `prepend_test_externs`. Stripping them once on
/// each test file keeps a single declaration of each runtime hook in
/// the assembled program.
export fn strip_externs(stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> {
            match ss.node {
                .ExternFn(_, _, _) -> strip_externs(next)
                _ -> StmtList.Node(ss, strip_externs(next))
            }
        }
    }
}

/// Prepend the runtime externs that every assembled test program
/// needs to link against:
///   - `avra_test_summary()  -> int`  → final pass/fail tally
///   - `avra_test_flush()    -> void` → drain the captured-output ring
///   - `avra_test_capture_start() -> void`
///   - `avra_test_capture_stop()  -> string`
///   - `avra_test_run_spec_guarded(name, file, ln, body) -> int` →
///     hkms.3: invoke one spec block under a sigsetjmp checkpoint so
///     a fatal signal is caught and the runner advances to the next
///     spec instead of taking down the bundle. `body` is a no-arg Avra
///     closure produced by `wrap_specs_with_guard` for every top-level
///     `spec { ... }` block.
///
/// Order is reversed inside (cons-prepend) so the rendered program
/// reads top-to-bottom in declaration order (`summary` first).
export fn prepend_test_externs(stmts: StmtList) -> StmtList {
    let guard_params = ParamList.Node("name", ValueType.Str,
                       ParamList.Node("file", ValueType.Str,
                       ParamList.Node("ln",   ValueType.Int,
                       ParamList.Node("body", ValueType.Fn(ValueType.Int),
                       ParamList.End))))
    let s5 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_run_spec_guarded", guard_params, ValueType.Int)), stmts)
    let s4 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_capture_stop", ParamList.End, ValueType.Str)), s5)
    let s3 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_capture_start", ParamList.End, ValueType.Void)), s4)
    let s2 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_flush", ParamList.End, ValueType.Void)), s3)
    StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_summary", ParamList.End, ValueType.Int)), s2)
}

/// hkms.3: AST transform that wraps each top-level `spec` block in a
/// crash-isolating call so a SIGSEGV / abort in one spec doesn't kill
/// the bundle.
///
/// For every top-level `Stmt.SpecBlock(name, body)` in `stmts`,
/// replace the position with:
///
///     avra_test_run_spec_guarded(name, file, line, () -> {
///         <original SpecBlock>
///         0
///     })
///
/// Why a no-arg **lambda** rather than a hoisted top-level fn:
///   - Avra closures preserve the enclosing scope, so top-level `mut`
///     globals in the test file (e.g. `mut hits_alpha: int = 0`) stay
///     visible inside the wrapped spec body — a hoisted fn would open
///     a fresh scope and lose them.
///   - The Avra closure layout (`[TAG, fn_ptr, ...captures]`) is
///     exactly what `avra_test_run_spec_guarded` consumes via the
///     existing `avra_closure_call_0` dispatch in runtime.c.
///   - One less module-level identifier per spec, no synthetic-fn
///     name to worry about (`is_mangled_method` collisions, etc).
///
/// The wrap operates only at the module top level — `spec` blocks
/// nested inside fn bodies (no realistic use today, but cheap to keep
/// untouched) compile as before, since their crash would already be
/// scoped to the enclosing fn call.
export fn wrap_specs_with_guard(stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> {
            match ss.node {
                .SpecBlock(name, _) -> {
                    let call = build_guarded_spec_call(ss, name)
                    StmtList.Node(call, wrap_specs_with_guard(next))
                }
                _ -> StmtList.Node(ss, wrap_specs_with_guard(next))
            }
        }
    }
}

/// Build the replacement call site:
///     avra_test_run_spec_guarded("spec name", "file.av", LINE,
///                                () -> { spec name { body }; 0 })
///
/// The spec name retains its outer quotes from the lexeme — codegen's
/// `strip_quotes` removes one pair so the runtime crash record gets a
/// clean name. File path is freshly wrapped in quotes for the same
/// round-trip. The body Lambda returns int (per the extern's
/// `body: fn() -> int` signature) via the trailing `0`.
fn build_guarded_spec_call(orig: SStmt, spec_name_lex: string) -> SStmt {
    let body_stmts = StmtList.Node(
        sstmt_dummy(orig.node),
        StmtList.Node(
            sstmt_dummy(Stmt.Expr(Expr.Number("0"))),
            StmtList.End
        )
    )
    let body_lambda = Expr.Lambda(ParamList.End, Expr.Block(body_stmts))
    let file_lit = "\"" + orig.file + "\""
    let args = ExprList.Node(
        sexpr_dummy(Expr.String(spec_name_lex)),
        ExprList.Node(
            sexpr_dummy(Expr.String(file_lit)),
            ExprList.Node(
                sexpr_dummy(Expr.Number(string(orig.line))),
                ExprList.Node(
                    sexpr_dummy(body_lambda),
                    ExprList.End
                )
            )
        )
    )
    let call = Expr.Call(Expr.Ident("avra_test_run_spec_guarded"), args)
    sstmt_at(Stmt.Expr(call), orig.line, orig.col, orig.file)
}

/// Outcome of splitting a stmt list into hoistable package modules
/// and the per-test body. The runner uses this to keep each
/// `@std::pkg` module unique across the assembled program.
export type PackageSplit = {
    packages: StmtList,
    body: StmtList,
}

/// Collect every `@`-prefixed `Module` from the stmt list and
/// return the residue. Thin wrapper over the resolver's
/// `hoist_package_modules` so the cli's `test` handler doesn't
/// need to import `features.modules.resolver` directly. Both
/// implementations agreed on the recursive walk — sharing the
/// canonical one removes a second copy that would have drifted.
export fn split_package_modules(stmts: StmtList) -> PackageSplit {
    let h = hoist_package_modules(stmts)
    PackageSplit { packages: h.packages, body: h.body }
}

/// Concatenate two statement lists. Order-preserving: every node
/// from `a` comes before every node from `b`.
/// Resolve the absolute path of the spec_test reporter (`reporter.av`).
/// Three call sites used to assemble this concatenation by hand
/// (assemble_test_program here, make_test_inputs + prepare_test_run
/// in cli/main.av); the literal `std-avrac/src/features/spec_test/`
/// is now centralised in one place — move the reporter file and one
/// edit fixes every consumer.
export fn test_reporter_path(project_dir: string) -> string {
    find_packages_dir(project_dir) + "std-avrac/src/features/spec_test/reporter.av"
}

export fn append_stmt_list(a: StmtList, b: StmtList) -> StmtList {
    match a {
        .End -> b
        .Node(ss, next) -> StmtList.Node(ss, append_stmt_list(next, b))
    }
}

/// Assemble the test program for one action: parse each test file as
/// its own Stmt.Module, hoist @std packages, inline the spec_test
/// reporter, and synthesise a main() that returns test_render_summary().
///
/// wd48 fix: LoadedPaths are NOT shared across iterations. A shared
/// set made sibling-Module loads return empty wrappers on second hit,
/// breaking sibling `use` imports. Each test file's tree is
/// independent — separate Module(test_name) wrappers, distinct scopes.
/// Cost: @std/* packages get re-parsed per test file; dedup_modules
/// collapses the duplicate package wrappers by Module name and dedups
/// same-file decls within merged bodies. Same-name decls from
/// DIFFERENT files survive as a real user-level naming collision.
export fn assemble_test_program(test_paths: List<string>, project_dir: string) -> Result<StmtList, string> {
    mut modules = StmtList.End
    mut packages = StmtList.End
    mut count = 0
    mut path_i = 0
    while path_i < test_paths.length {
        let path = test_paths[path_i]
        path_i = path_i + 1
        let content = avra_selfhost_read_file(path)
        let mod_name = basename_no_ext(path)
        let parsed = parse_program_source_at(content, path)
        if parsed.had_error || parsed.stmts == null {
            if bag_has_errors(parsed.bag) {
                render_bag(content, path, parsed.bag)
            }
            return Result.Err("error parsing ${path}")
        }
        let test_dir = modules_dirname(path)
        let mod_resolved = resolve_module_files(parsed.stmts!, test_dir, LoadedPaths.End)
        if mod_resolved.had_error {
            return Result.Err("module resolve error in ${path}: ${mod_resolved.error_message}")
        }
        let split = split_package_modules(mod_resolved.stmts)
        packages = append_stmt_list(split.packages, packages)
        // hkms.3: rewrite each top-level `spec` block in this test file
        // into a guarded `avra_test_run_spec_guarded(...)` call and hoist
        // the original block into a synthetic fn. The two pieces ride
        // side-by-side in the test module so the resolver sees both as
        // siblings (the call references the freshly-minted fn by name).
        let wrapped_body = wrap_specs_with_guard(split.body)
        modules = StmtList.Node(
            sstmt_dummy(Stmt.Module(mod_name, wrapped_body)),
            modules
        )
        count = count + 1
    }
    if count == 0 {
        return Result.Err("no spec test files found")
    }

    // Reporter (features/spec_test/reporter.av) ships test_render_*
    // fns at module-root scope so spec codegen's bare
    // ctx.call("test_render_then", ...) resolves directly. State
    // (counters, current spec/given) lives in runtime.c.
    let reporter_path = test_reporter_path(project_dir)
    let reporter_stmts = if avra_selfhost_file_exists(reporter_path) != 0 {
        let rsrc = avra_selfhost_read_file(reporter_path)
        let rparsed = parse_program_source_at(rsrc, reporter_path)
        if rparsed.had_error || rparsed.stmts == null {
            StmtList.End
        } else {
            rparsed.stmts!
        }
    } else {
        StmtList.End
    }
    let deduped_packages = dedup_modules(packages)
    mut program = prepend_test_externs(append_stmt_list(reporter_stmts, append_stmt_list(deduped_packages, modules)))
    let main_body = StmtList.Node(
        sstmt_dummy(Stmt.Return(Expr.Call(Expr.Ident("test_render_summary"), ExprList.End))),
        StmtList.End
    )
    program = StmtList.Node(
        sstmt_dummy(Stmt.Function("main", TypeParamList.End, ParamList.End, ValueType.Int, main_body)),
        program
    )
    Result.Ok(program)
}

/// 0qmm step 3: content-keyed fixture-stdout cache. Replaces the
/// per-PPID /tmp pattern that re-ran heavy fixtures (cli_metadata_compile,
/// std_avrac_lib_build, etc.) on every session because PPID changed —
/// across sessions, nothing carried over. The hash factors in the
/// fixture source plus every toolchain input that affects its output
/// (bs2 + runtime.o + llvm_wrapper.o), so a slot is reused across
/// sessions when those bytes match and invalidated automatically when
/// they don't.
///
/// Performance: the toolchain inputs (bs2/runtime.o/llvm_wrapper.o)
/// are ~5MB combined; sha256-ing them on every `then` block would
/// burn ~100ms per call. We memoise the combined toolchain fp via a
/// sidecar file (`build/cache/fixture_stdout/.toolchain-fp`), valid
/// as long as that file is newer than every input. Same trick rqwh's
/// link_shared_fp uses in diagnose.sh.
///
/// On Hit: returns the previously-captured stdout. On Miss: runs the
/// fixture via diagnose.sh, captures stdout, persists, returns.
export fn cached_fixture_run(fixture_path: string) -> string {
    cached_fixture_capture(fixture_path, "bash scripts/diagnose.sh --run ${fixture_path} 2>&1 || true", "run")
}

/// Same content-keyed cache, but runs `./build/bs2 expand <path>`
/// instead of building/running the fixture. Used by the
/// expand_macro_* tests that exercise the macro-expansion CLI and
/// want a stable stdout snapshot. The cache key includes the verb
/// ("expand") so a fixture used with --run and `bs2 expand` doesn't
/// collide.
export fn cached_fixture_expand(fixture_path: string) -> string {
    cached_fixture_capture(fixture_path, "./build/bs2 expand '${fixture_path}' 2>&1 || true", "expand")
}

/// Shared helper. The verb is folded into the cache key so two
/// different command shapes against the same fixture don't share a
/// slot; everything else (toolchain fp + file hash + fixture path)
/// matches cached_fixture_run's pre-existing scheme.
fn cached_fixture_capture(fixture_path: string, cmd: string, verb: string) -> string {
    let cache_dir = "build/cache/fixture_stdout"
    let toolchain_fp = read_or_compute_toolchain_fp(cache_dir)
    let fixture_h = sha256_file(fixture_path)
    let key = sha256_hex("${toolchain_fp}:${fixture_h}:${fixture_path}:${verb}")
    let cache_path = "${cache_dir}/${key}.out"
    if avra_selfhost_file_exists(cache_path) == 1 {
        return avra_selfhost_read_file(cache_path)
    }
    let _ = avra_mkdir_p(cache_dir)
    let out = avra_shell_exec(cmd)
    let _ = avra_selfhost_write_file(cache_path, out)
    out
}

/// Memoised hash of (bs2, runtime.o, llvm_wrapper.o). Read from the
/// sidecar when present and newer than every input; recomputed
/// otherwise. The sidecar is plain hex (64 chars), so an unrelated
/// touch (e.g. `make clean` deleting the cache dir) just forces one
/// recomputation, never a wrong hit.
fn read_or_compute_toolchain_fp(cache_dir: string) -> string {
    let sidecar = "${cache_dir}/.toolchain-fp"
    if avra_selfhost_file_exists(sidecar) == 1
        && sidecar_newer_than_inputs(sidecar) {
        return avra_selfhost_read_file(sidecar)
    }
    let bs2_h = sha256_file("build/bs2")
    let runtime_h = sha256_file("build/runtime.o")
    let wrapper_h = sha256_file("build/llvm_wrapper.o")
    let combined = sha256_hex("${bs2_h}:${runtime_h}:${wrapper_h}")
    let _ = avra_mkdir_p(cache_dir)
    let _ = avra_selfhost_write_file(sidecar, combined)
    combined
}

fn sidecar_newer_than_inputs(sidecar: string) -> bool {
    let s_mtime = avra_file_mtime(sidecar)
    s_mtime > avra_file_mtime("build/bs2")
        && s_mtime > avra_file_mtime("build/runtime.o")
        && s_mtime > avra_file_mtime("build/llvm_wrapper.o")
}


