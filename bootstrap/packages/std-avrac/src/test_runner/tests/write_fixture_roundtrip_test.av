// WHY: `write_fixture` writes fixture SOURCE, so it must round-trip exactly.
// Any transformation on the way in is corruption, and corruption here is
// especially expensive: the fixture is the thing under test, so a mangled body
// makes the compiler look wrong.
//
// It used to escape single quotes (`.replace("'", "'\\''")`) before handing the
// body to a heredoc, on the stated reasoning that a `'` would otherwise
// terminate the surrounding shell quote. The delimiter is QUOTED (`<<'EOF'`),
// which is exactly the form that disables every expansion and quote rule inside
// the body — so the escape protected nothing and simply wrote itself into the
// file:
//
//     write_fixture(p, "it's fine")   ->   file contains: it'\''s fine
//
// Anything with an apostrophe was affected: a fixture whose Avra source used a
// char literal, and every prose comment with a contraction in it.
//
// This file pins round-trip fidelity for the characters that a shell-mediated
// writer is most likely to mangle. Each case asserts EQUALITY, not `contains` —
// `contains` would accept a body with extra text spliced around it, which is
// one of the shapes being guarded against.

use @std.avrac.core.{avra_selfhost_read_file, avra_getpid}
use @std.avrac.test_runner.{write_fixture}

/// Write `body`, read it back, and compare exactly. `write_fixture` terminates
/// the heredoc with a newline, so the file carries one more than the body did;
/// that single trailing newline is the writer's own framing and the only
/// difference tolerated here.
fn roundtrips(slot: string, body: string) -> bool {
    let path = "/tmp/avra_wf_roundtrip_${avra_getpid()}_${slot}.txt"
    write_fixture(path, body)
    avra_selfhost_read_file(path) == body + "\n"
}

spec "write_fixture round-trips its body verbatim" {
    given "characters a shell-mediated writer is most likely to mangle" {
        then "a single quote survives — the case that was actually broken" {
            roundtrips("squote", "let c = 'x'")
        }
        then "an apostrophe in prose survives" {
            // The most common form by far: a contraction in a comment.
            roundtrips("apostrophe", "// it's fine, isn't it")
        }
        then "several single quotes on one line survive" {
            // The old escape expanded EACH quote, so a line with several was
            // mangled several times over — worth pinning separately from the
            // single-quote case, which a partial fix could satisfy alone.
            roundtrips("many", "'a' 'b' 'c'")
        }
        then "double quotes survive" {
            roundtrips("dquote", "println(\"hello\")")
        }
        then "backslashes survive unexpanded" {
            // A quoted heredoc must not process escapes. If it did, `\n` here
            // would become a newline and `\\` a single backslash.
            roundtrips("backslash", "a\\nb \\\\ c\\t")
        }
        then "shell metacharacters are not expanded" {
            // `$HOME`, backticks and `$(...)` would all expand in an UNquoted
            // heredoc. This is the assertion that fails if someone ever drops
            // the quotes from the delimiter.
            // (No `${...}` here: that is Avra's OWN interpolation syntax, so it
            // would be substituted in this source before the shell ever saw it.)
            roundtrips("shellmeta", "$HOME `whoami` $(id -u) $$ &")
        }
        then "a mix of everything survives" {
            roundtrips("mixed", "fn f() { let s = \"it's $HOME\\n\" }")
        }
    }

    given "a body that could collide with the heredoc delimiter" {
        then "a line reading exactly `EOF` does not truncate the body" {
            // `EOF` is a plausible line in fixture source, which is why the
            // delimiter is not `EOF`. Were it, this body would be cut at the
            // second line and the tail lost silently.
            roundtrips("eof", "before\nEOF\nafter")
        }
    }

    given "bodies with unusual shape" {
        then "an empty body round-trips" {
            roundtrips("empty", "")
        }
        then "a multi-line body keeps its interior newlines" {
            roundtrips("multiline", "one\ntwo\nthree")
        }
        then "leading and interior whitespace is preserved" {
            // Indentation is significant in the Avra sources these fixtures
            // hold, so a writer that trimmed would corrupt them.
            roundtrips("indent", "fn f() {\n    let x = 1\n        // deep\n}")
        }
    }
}

// ## MUTATION RECORD — measured, both properties pinned independently
//
//   restore the single-quote escape    7/11   RED: squote, apostrophe, many, mixed
//   unquote the heredoc delimiter      8/11   RED: backslash, shellmeta, mixed
//
// The two red sets are almost disjoint, which is the point: the escape defect
// and the expansion defect are separate properties, and neither mutation can
// be repaired by a fix aimed at the other. `mixed` appears in both only
// because it deliberately contains an apostrophe AND a `$HOME`.
//
// Every case with a single quote in its body reds under the first mutation,
// and only those — which is what identifies the escape as the whole defect
// rather than one symptom of a broader writing problem.
