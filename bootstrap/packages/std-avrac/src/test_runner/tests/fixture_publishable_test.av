// WHY: the fixture-stdout cache must never freeze a TRANSIENT or stale-
// ENVIRONMENT failure into a permanent one (the zp5b/fxfz/927f hazard). This
// pins three contracts of the publishability gate plus the source-directive
// statefulness detector:
//   1. Environmental noise (OOM `Killed`, `compile produced no IR`, link
//      errors, segfaults) is never cached — a heavy fixture killed once would
//      otherwise replay that failure forever.
//   2. fxfz: a STATEFUL fixture (one probing SHARED build state outside the
//      cache key — detected from its SOURCE by `fixture_is_stateful`) must not
//      cache a `: FAIL`, so a corrupt shared-cache state re-probes next run.
//   3. zp5b: a NON-stateful `: FAIL` stays cacheable (rejecting every FAIL
//      would re-run deterministically-failing fixtures every cycle — the cost
//      the zp5b revert was about); `bs2 cache clear-failed` evicts those on
//      demand instead.
//   4. t-mji3: a FULL DISK — and the link deaths it causes — is never frozen,
//      and the publish gate and the shard cause classifier give the SAME
//      verdict on it. They did not: the classifier ranked ENOSPC top while the
//      gate ignored it, so a run could name the cause correctly and poison the
//      cache anyway. Note (3) is why that poison outlived the disk: the
//      documented escape hatch only evicts `: FAIL`, which those captures lack.

use @std.avrac.test_runner.{fixture_output_is_publishable, fixture_is_stateful, FIXTURE_STATEFUL_MARKER, capture_has_probe_failure}
use @std.avrac.test_runner.{output_has_disk_full_marker, classify_shard_failure}
use @std.avrac.core.{avra_selfhost_file_exists}

extern fn avra_shell_exec(cmd: string) -> string

spec "fixture cache: legitimate output is publishable" {
    then "normal PROBE output caches" {
        fixture_output_is_publishable("PROBE thing: ok\nmore output\n", false)
    }
    then "a dead-silent (empty) capture is NOT cached — the producer died before printing" {
        // A direct SIGKILL of the fixture child leaves no shell noise line
        // (`|| true` swallows the death), so the only trace is silence.
        // Caching it replays an inexplicable no-diff FAIL forever — the
        // 2026-07-18 incident froze six fixtures red this way after an
        // OOM-storm kill. Genuinely-empty fixtures just re-run.
        !fixture_output_is_publishable("", false)
    }
    then "a whitespace-only capture is NOT cached either" {
        !fixture_output_is_publishable("\n", false)
    }
    then "output mentioning a signal IN PROSE still caches" {
        // A test that legitimately prints the word in running text must not
        // be rejected — only the line-anchored crash reports are.
        fixture_output_is_publishable("the handler logged: process was reaped\n", false)
    }
}

spec "fixture cache: transient build-state failures are rejected" {
    then "OOM bare `Killed` mid-output is rejected" {
        !fixture_output_is_publishable("compiling...\nKilled\n", false)
    }
    then "OOM bare `Killed` at end-of-output (no trailing newline) is rejected" {
        !fixture_output_is_publishable("compiling...\nKilled", false)
    }
    then "an exactly-`Killed` capture is rejected" {
        !fixture_output_is_publishable("Killed", false)
    }
    then "`compile produced no IR` (build killed before emit) is rejected" {
        !fixture_output_is_publishable("error: compile produced no IR (looked for src/x.ll)", false)
    }
    then "`Out of memory` is rejected" {
        !fixture_output_is_publishable("Out of memory: cannot allocate\n", false)
    }
    then "an undefined-symbol link error is rejected" {
        !fixture_output_is_publishable("ld.lld: error: undefined symbol: foo\n", false)
    }
    then "a segfault is rejected" {
        !fixture_output_is_publishable("Segmentation fault\n", false)
    }
}

// t-mji3: a FULL DISK is the box failing, not the fixture speaking. The shard
// cause classifier already ranked ENOSPC above every other cause, while this
// gate did not test it at all — so one disk-full run could print `DISK FULL`
// in the summary and, in that same run, freeze the truncated output as the
// fixture's answer. It then replayed as a no-diff FAIL in untouched tests long
// after the disk was free, and `bs2 cache clear-failed` did not evict it (that
// evictor targets `: FAIL`, which a disk-full capture usually lacks entirely).
spec "fixture cache: a full disk is never frozen into a capture (t-mji3)" {
    then "the strerror string `No space left on device` is rejected" {
        !fixture_output_is_publishable("cc: error: unable to write output: No space left on device\n", false)
    }
    then "a bare ENOSPC is rejected" {
        !fixture_output_is_publishable("write failed: ENOSPC\n", false)
    }
    then "the fixture runner's own `link failed for` die message is rejected" {
        // diagnose.sh --run (the fixture runner) dies with exactly this when its
        // link step fails; the message reaches the capture via stderr.
        !fixture_output_is_publishable("[err]  link failed for /tmp/avra_probe.bin\n", false)
    }
    then "a signalled linker (`ld terminated with signal`) is rejected" {
        // The VIOLENT linker death: cc reports a signalled ld this way, and it
        // prints neither `collect2: error:` nor `ld returned`, so the pre-existing
        // clean-failure entries do not cover it.
        !fixture_output_is_publishable("cc: error: ld terminated with signal 6 [Aborted]\n", false)
    }
    then "a stateful fixture's disk-full capture is rejected too" {
        !fixture_output_is_publishable("PROBE meta_present: ok\nNo space left on device\n", true)
    }
    then "prose about disk space still caches" {
        // The anchor is the strerror string, NOT the words "space"/"disk" — a
        // fixture legitimately reporting free space must still cache, or it
        // re-runs every cycle (the false-positive perf trap the fxfz specs pin).
        fixture_output_is_publishable("PROBE disk_usage_reported: ok\nfree space: 42GB left on volume\n", false)
    }
}

// The REASON the predicate is shared rather than duplicated: both gates answer
// "was this the box, not the code?", and a disk-full run hits BOTH in the same
// run — the classifier naming the shard's cause, the publish gate deciding
// whether to memoise. They disagreed before this (classifier: inline test;
// gate: no test), which is how a correctly-named DISK FULL run still poisoned
// the cache. Pinning them together is what keeps a later edit from re-splitting
// them — the same argument output_has_kill_marker's doc comment already makes.
spec "fixture cache: the disk-full verdict agrees across both gates (t-mji3)" {
    then "the shared predicate detects the strerror string" {
        output_has_disk_full_marker("cc: error: No space left on device\n")
    }
    then "the shared predicate detects a bare ENOSPC" {
        output_has_disk_full_marker("ENOSPC")
    }
    then "the shared predicate ignores unrelated prose" {
        !output_has_disk_full_marker("PROBE x: ok\nfree space: 42GB\n")
    }
    then "one disk-full output is BOTH classified DISK FULL and refused by the cache" {
        // The end-to-end contract, on one string: the classifier must name the
        // box, and the gate must refuse to freeze it. Either one alone is the
        // bug — naming it correctly while caching it is exactly what happened.
        let out = "compiling shard 3\ncc: error: unable to write: No space left on device\n"
        classify_shard_failure(out, 0, 0).contains("DISK FULL")
            && !fixture_output_is_publishable(out, false)
    }
    then "a MEMORY-ceiling output is still classified as the ceiling, not disk" {
        // The classifier's order is load-bearing and this change touched its
        // first branch — pin that routing it through the shared predicate did
        // not widen it into the F4014 case below it.
        classify_shard_failure("error[F4014]: compiler memory ceiling exceeded\n  phase: parse x.av\n", 0, 0)
            .contains("MEMORY CEILING")
    }
}

// fxfz: a STATEFUL fixture probes SHARED build state outside the cache key, so
// a `: FAIL` from it means that shared state was corrupt/half-published, NOT a
// deterministic property of the fixture source — the capture must not freeze.
// A passing capture (every probe `: ok`) carries no `: FAIL` and still caches.
spec "fixture cache: a stateful fixture's failures are rejected (fxfz)" {
    then "stateful + a probe FAIL is rejected" {
        !fixture_output_is_publishable("PROBE std_cli_meta_present: FAIL\n", true)
    }
    then "stateful + a FAIL anywhere in the capture is rejected" {
        !fixture_output_is_publishable("PROBE a: ok\nPROBE b: FAIL detail\nPROBE c: ok\n", true)
    }
    then "stateful with every probe ok still caches" {
        fixture_output_is_publishable("PROBE avrac_meta_present: ok\nPROBE cli_main_ll_present: ok\n", true)
    }
    then "stateful with the word FAIL in prose (no `: FAIL`) still caches" {
        // Only the probe-FAIL form blocks caching — a stateful fixture that
        // prints FAIL in running text must still cache its passing capture, or
        // it would re-run every cycle (the false-positive perf trap).
        fixture_output_is_publishable("rebuilt after a prior FAILED attempt\nPROBE x: ok\n", true)
    }
    then "stateful with `: FAILED` in prose (colon, but not the probe form) still caches" {
        // The anchored predicate excludes `: FAILED` / `: FAILURE` — a passing
        // stateful capture that mentions failure in running text must cache.
        fixture_output_is_publishable("PROBE meta_present: ok\nnote: a: FAILED retry, recovered\n", true)
    }
}

// capture_has_probe_failure is the single notion of "a capture froze a failure"
// shared by the write-gate (above) and `bs2 cache clear-failed`. It anchors on
// the probe form so prose mentions of failure don't trip it — pinning that
// keeps the evictor from throwing away a warm PASSING capture.
spec "fixture cache: capture_has_probe_failure anchors on the probe FAIL form" {
    then "a probe FAIL line (terminated by newline) is a failure" {
        capture_has_probe_failure("PROBE x: FAIL\nPROBE y: ok\n")
    }
    then "a probe FAIL with trailing detail (space) is a failure" {
        capture_has_probe_failure("PROBE x: FAIL count=3\n")
    }
    then "a probe FAIL at end-of-string (no trailing newline) is a failure" {
        capture_has_probe_failure("PROBE x: FAIL")
    }
    then "`: FAILED` in prose is NOT a probe failure" {
        !capture_has_probe_failure("PROBE x: ok\nlog: a: FAILED disk write, recovered\n")
    }
    then "`: FAILURE` in prose is NOT a probe failure" {
        !capture_has_probe_failure("note: total: FAILURE rate 0%\nPROBE x: ok\n")
    }
    then "non-probe prose with `: FAIL ` (e.g. `step: FAIL recovered`) is NOT a probe failure" {
        // The line carries `: FAIL ` but does not start with `PROBE `, so it is
        // a log line, not a probe FAIL — anchoring to the line form excludes it.
        !capture_has_probe_failure("PROBE x: ok\nstep: FAIL recovered\n")
    }
    then "a real PROBE FAIL alongside `: FAIL ` prose is still a failure" {
        // Prose on one line must not mask a genuine probe FAIL on another.
        capture_has_probe_failure("step: FAIL recovered\nPROBE meta_present: FAIL\n")
    }
    then "an all-ok capture has no probe failure" {
        !capture_has_probe_failure("PROBE x: ok\nPROBE y: ok\n")
    }
}

// zp5b: a NON-stateful `: FAIL` stays publishable — rejecting every FAIL would
// re-run deterministically-failing fixtures every cycle (the zp5b revert cost).
// `bs2 cache clear-failed` is the on-demand escape hatch for those instead.
spec "fixture cache: a non-stateful FAIL remains publishable (zp5b zero-cost rule)" {
    then "a bare probe FAIL from a non-stateful fixture still caches" {
        fixture_output_is_publishable("PROBE foo_slice_smaller_than_whole: FAIL\n", false)
    }
    then "an F-code diagnostic capture still caches" {
        // F-code-assertion tests deliberately cache their error output; the
        // stateful rule keys on the fixture being marked, never on F-codes.
        fixture_output_is_publishable("error[F0012]: type mismatch: expected int\n", false)
    }
}

// fxfz: statefulness is read from the fixture SOURCE (not its stdout) so a run
// killed mid-capture can't drop the opt-in. Pins that the directive is detected
// and — the drift guard — that the two real stateful fixtures in the tree
// actually carry it, so a typo in the sentinel fails loudly here.
spec "fixture cache: fixture_is_stateful reads the source directive" {
    then "a source carrying the directive is stateful" {
        let p = "/tmp/avra_fxfz_stateful_probe.av"
        let _ = avra_shell_exec("printf '// ${FIXTURE_STATEFUL_MARKER} marker\\nfn main() -> int { 0 }\\n' > ${p}")
        let r = fixture_is_stateful(p)
        let _ = avra_shell_exec("rm -f ${p}")
        r
    }
    then "a source without the directive is not stateful" {
        let p = "/tmp/avra_fxfz_plain_probe.av"
        let _ = avra_shell_exec("printf 'fn main() -> int { 0 }\\n' > ${p}")
        let r = fixture_is_stateful(p)
        let _ = avra_shell_exec("rm -f ${p}")
        !r
    }
    then "the cli_metadata_compile fixture is registered stateful" {
        fixture_is_stateful("tests/cli_metadata_compile_fixtures/sample.av")
    }
    then "the std_avrac_lib_build fixture is registered stateful" {
        fixture_is_stateful("tests/std_avrac_lib_build_fixtures/sample.av")
    }
    then "a non-stateful fixture is not registered stateful" {
        // Existence-guarded: fixture_is_stateful also returns false for a
        // MISSING file, so without the file_exists check a moved control path
        // would pass for the wrong reason. (The positive cases above fail loudly
        // on a moved path already — false ≠ the asserted true.)
        let path = "tests/per_file_metadata_emit_fixtures/sample.av"
        avra_selfhost_file_exists(path) != 0 && !fixture_is_stateful(path)
    }
}

// The exact decision cached_fixture_capture makes before writing a capture:
// `fixture_output_is_publishable(out, fixture_is_stateful(fixture_path))`.
// Exercising the two functions COMPOSED against a real on-disk stateful fixture
// pins the end-to-end contract (a real stateful fixture's FAIL is not cached; a
// passing one is) without the cost of compiling/running the fixture.
spec "fixture cache: the composed publish decision on a real stateful fixture (fxfz)" {
    then "real stateful fixture + a FAIL capture → the capture is NOT cacheable" {
        let path = "tests/cli_metadata_compile_fixtures/sample.av"
        !fixture_output_is_publishable("PROBE std_cli_meta_present: FAIL\n", fixture_is_stateful(path))
    }
    then "real stateful fixture + an all-ok capture → the capture IS cacheable" {
        let path = "tests/cli_metadata_compile_fixtures/sample.av"
        fixture_output_is_publishable("PROBE std_cli_meta_present: ok\n", fixture_is_stateful(path))
    }
}
