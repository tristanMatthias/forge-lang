// WHY (t-65td): a red shard had one message for six different causes, so
// the first diagnostic question — "is this my code, or is it the box?" —
// was answered by diving into logs, and got answered WRONG. The recorded
// incident: a memory kill was investigated as a type-gate bug that did
// not exist, because the operator-visible output for both was identical.
//
// `classify_shard_failure` names the cause class. These specs pin the
// classification, and especially its ORDER, because the environmental
// causes each emit text that ALSO matches a later, more generic rule:
//
//   - F4014 (the compiler's own memory self-stop) prints `error[F4014]`.
//     Checked after the generic `error[F` rule it reads as COMPILE
//     FAILED — i.e. box pressure reported as a code error, which is the
//     exact wrong turn this ticket exists to prevent.
//   - ENOSPC surfaces as write failures that look like compile errors
//     (t-2qn0 shipped as false test FAILURES for precisely this).
//   - A kill truncates the log, so "no findings" must read as KILLED,
//     never as a clean run.
//
// The function is pure, so every branch is pinned from a literal log
// sample — no real OOM, no filled disk, no staged kill.

use @std.avrac.test_runner.{classify_shard_failure, output_has_ceiling_marker}

spec "t-65td: the cause class is named, not left to a log dive" {
    given "a shard that ran and reported spec failures" {
        then "it reports TEST FAILURE(S) and names the first one" {
            let log = "spec \"widening\"\n    FAIL \"accepts a narrow int\"\n[shard-summary] pass=3 fail=1 total=4\n"
            let got = classify_shard_failure(log, 1, 0)
            got.contains("TEST FAILURE") && got.contains("accepts a narrow int")
        }
        then "a crashed spec is distinguished from an assertion failure" {
            let log = "spec \"parallel\"\n✗ SPEC CRASHED\n[shard-summary] pass=2 fail=0 total=3 crashes=1\n"
            let got = classify_shard_failure(log, 0, 1)
            got.contains("CRASHED") && !got.contains("TEST FAILURE")
        }
    }

    given "a shard whose compile failed" {
        then "it reports COMPILE FAILED and surfaces the first F-code" {
            let log = "error[F1000]: type mismatch\n  expects int, got string\n"
            let got = classify_shard_failure(log, 0, 0)
            got.contains("COMPILE FAILED") && got.contains("F1000")
        }
    }

    given "the environmental causes, which all also look like something else" {
        then "an F4014 memory stop is NOT reported as a compile error, and names the phase" {
            // The ordering trap: this log contains `error[F` too.
            let log = "error[F4014]: compiler memory ceiling exceeded — 11055 MiB resident\n  phase: parse packages/std-avrac/src/parse/mod.av\n"
            let got = classify_shard_failure(log, 0, 0)
            got.contains("MEMORY CEILING")
                && got.contains("parse packages/std-avrac/src/parse/mod.av")
                && !got.contains("COMPILE FAILED")
        }
        then "the ceiling marker is the shared predicate the solo retry keys on (t-d91l)" {
            // One definition answers both the classifier and the
            // orchestrator's retry_ceiling_stopped selection: a self-stopped
            // shard is retried solo on the drained box, so a marker/classifier
            // drift would retry the wrong set or none.
            let stopped = "error[F4014]: compiler memory ceiling exceeded — 8252 MiB resident\n  budget: soft grant exceeded while the box is under pressure\n"
            let clean = "spec \"x\"\n    PASS \"y\"\n[shard-summary] pass=1 fail=0 total=1\n"
            let plain_compile_err = "error[F1000]: type mismatch\n"
            output_has_ceiling_marker(stopped)
                && !output_has_ceiling_marker(clean)
                && !output_has_ceiling_marker(plain_compile_err)
        }
        then "prose QUOTING the F-code is not a ceiling stop (no phantom solo retry)" {
            // A failing test whose assertion text mentions the code — the
            // same prose-vs-record trap the kill marker's line anchoring
            // guards (a test about killing is not a kill). The marker keys
            // on the diagnostic's rendered head, so bare-code prose stays a
            // TEST FAILURE and never selects for the solo retry.
            // (The generic `error[F` rule still classifies quoted codes as
            // COMPILE FAILED — that leniency is pre-existing and harmless;
            // what this pins is that no SOLO RETRY selects on prose.)
            let prose = "spec \"ceilings\"\n    FAIL \"reports error[F4014] when over budget\"\n[shard-summary] pass=0 fail=1 total=1\n"
            let got = classify_shard_failure(prose, 1, 0)
            !output_has_ceiling_marker(prose)
                && !got.contains("MEMORY CEILING")
        }
        then "ENOSPC is reported as DISK FULL, not as test failures (the t-2qn0 shape)" {
            // Also carries a spec FAIL and an error[F — both outranked.
            let log = "error[F0001]: write failed: No space left on device\n    FAIL \"writes the artifact\"\n"
            let got = classify_shard_failure(log, 1, 0)
            got.contains("DISK FULL")
                && !got.contains("TEST FAILURE")
                && !got.contains("COMPILE FAILED")
        }
        then "a kill is reported as a kill and points at the survivor probe" {
            let log = "compiling shard...\nKilled\n"
            let got = classify_shard_failure(log, 0, 0)
            got.contains("KILLED") && got.contains("make stray")
        }
        then "macOS's `Killed: 9` counts too" {
            let got = classify_shard_failure("bash: line 1: 4213 Killed: 9   bs2 _test_shard\n", 0, 0)
            got.contains("KILLED")
        }
        // The kill check is LINE-ANCHORED, and this is why. The shard log
        // carries the test's own stdout, and this tree has specs that kill
        // processes on purpose (stray_reap_test). Under a substring rule
        // their assertion failures report as phantom OOM-kills — the very
        // misattribution this classifier exists to prevent, reintroduced
        // by its own kill check.
        then "a FAILING test that merely mentions killing stays a TEST FAILURE" {
            let log = "spec \"reap\"\n    FAIL \"the orphan is Killed and the live build spared\"\n"
            let got = classify_shard_failure(log, 1, 0)
            got.contains("TEST FAILURE")
                && got.contains("the orphan is Killed")
                && !got.contains("KILLED —")
        }
    }

    given "a red shard whose log explains nothing" {
        then "it says so plainly rather than inventing a cause" {
            let got = classify_shard_failure("some unremarkable output\n", 0, 0)
            got.contains("not classified")
        }
    }
}

// A compile failure with NO F-code. `classify_shard_failure`'s COMPILE FAILED
// rule keys on `error[F`, so the runner's own `fail("shard compile failed: ...")`
// — raised before any diagnostic is coded, which is where module-resolve errors
// arrive — matched nothing and fell through to `cause not classified`.
//
// Observed on a real CI run: a shard reported
//   shard compile failed: module resolve error in .../scan_trivia_test.av:
//   error in module `modules`: parse error at 18:14: expected `}`
// and the summary said "cause not classified; read the log" — with the reason
// sitting in the log it declined to read. That is the t-xlf3 shape (an
// unnameable shard death) produced not by a missing log but by the classifier.
spec "a compile failure with no F-code is still named (t-xlf3)" {
    then "the shard-compile-failed message is classified, not left unnamed" {
        let log = "[batch] 8 files: a.av b.av\nshard compile failed: module resolve error in x.av: parse error at 18:14: expected `}`\n"
        let c = classify_shard_failure(log, 0, 0)
        c.contains("COMPILE FAILED") && !c.contains("cause not classified")
    }

    then "the reason is QUOTED, so the log dive is unnecessary" {
        let log = "shard compile failed: module resolve error in x.av: parse error at 18:14: expected `}`\n"
        classify_shard_failure(log, 0, 0).contains("module resolve error in x.av")
    }

    then "only the FIRST line of the reason is quoted" {
        let log = "shard compile failed: resolve error: undefined name\n  note: a whole diagnostic body follows\n"
        let c = classify_shard_failure(log, 0, 0)
        c.contains("undefined name") && !c.contains("whole diagnostic body")
    }

    then "an F-coded compile failure still wins — it names the code" {
        // The existing rule is more specific and must keep precedence.
        let log = "error[F0001]: expected `}`\nshard compile failed: parse error\n"
        classify_shard_failure(log, 0, 0).contains("F0001")
    }

    then "the ENVIRONMENTAL classes still outrank it" {
        // A disk-full box makes compiles fail; the box is the cause, not the code.
        let log = "shard compile failed: write error\nNo space left on device\n"
        classify_shard_failure(log, 0, 0).contains("DISK FULL")
    }

    then "a test that merely QUOTES the marker is NOT a compile failure" {
        // shard_basename_collision_test asserts on this exact string. A
        // substring match would report its assertion failure as a phantom
        // compile failure — the misattribution this file exists to prevent,
        // reintroduced by the new rule. Hence the line anchor.
        let log = "spec \"collision\"\n    FAIL \"no shard compile failed: appears\"\n[shard-summary] pass=0 fail=1 total=1\n"
        classify_shard_failure(log, 1, 0).contains("TEST FAILURE")
    }
}
