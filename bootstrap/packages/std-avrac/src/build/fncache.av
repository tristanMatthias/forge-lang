// WHY: the abstract per-function codegen cache unit (L6 codegen-cache design).
//
// codegen(fn) becomes cacheable: a function's emitted artifact (LLVM bitcode
// today; a MIR unit later — the interface is artifact-format-agnostic) is
// stored content-addressed and looked up by a composed key instead of being
// re-derived. Two-level layout gives identical-IR collapse for free:
//
//   <root>cache/fnunits/key/<keyhash>   -> pointer file naming an artifact hash
//   <root>cache/fnunits/art/<arthash>.unit -> the deduped artifact bytes
//
// Distinct keys whose emission produced byte-identical artifacts share ONE
// art entry (the §8 explosion control for mono instances). Artifacts are
// handled strictly by PATH — bytes never round-trip through Avra strings, so
// binary bitcode is safe end-to-end.
//
// Key discipline (v1, coarse-but-correct): body_fp alone under-keys — emitted
// IR is also a function of the shared type registries (struct layouts reached
// through GEP) and the @mono_erased layout regime. The v1 key therefore folds
// the WHOLE type-table snapshot hash: any type edit invalidates every unit
// (correct, conservative), while body-only edits — the common case — still
// hit. Narrowing to per-body referenced-type sets is a later increment.
//
// Publishing follows the cache.av atomicity rule (materialise atomically, or
// validate completeness on reuse): artifacts land via atomic_install, key
// pointers via write-tmp-then-rename, and every read validates the pointed-at
// artifact before reporting a hit — a damaged slot demotes to an honest miss.

use core.{
    avra_selfhost_file_exists,
    avra_selfhost_read_file,
    avra_selfhost_write_file,
    avra_mkdir_p,
    avra_rename,
    avra_remove_file,
    avra_file_size,
    avra_getpid,
}
use build.cache.{Cache, atomic_install}
use @std.crypto.{sha256_file, sha256_hex}

// Streaming file primitives for the batched pack store below. Appending to
// one growing pack tmp (no new inode / rename per unit) is what collapses
// ~2 files-per-fn into 2 files-per-package; read_file_from tail-reads a
// unit's byte range back out. parse_int decodes the index's offset/len.
extern fn avra_selfhost_append_file(path: string, content: string) -> int
extern fn avra_selfhost_read_file_from(path: string, offset: int) -> string
extern fn avra_parse_int(s: string) -> int
// Reference-semantics string->int map (a ptr handle) for the batch dedup
// set — the builtin Map is a value type, so mutation wouldn't persist
// through the accumulator struct. Same map the resolver/registries use.
extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

/// A composed per-function cache key. `hash` is 64-hex over the canonical
/// key string — the only identity; callers never parse it back.
export type FnUnitKey = {
    hash: string,
}

/// Filesystem view of the per-fn unit store. Derived from the build Cache
/// so the unit store lives inside the same `<root>cache/` tree (one
/// cache-gc / clean-cache surface), namespaced under `fnunits/`.
export type FnUnitStore = {
    key_dir: string,        // <root>cache/fnunits/key/
    art_dir: string,        // <root>cache/fnunits/art/
    tmp_dir: string,        // <root>cache/fnunits/_tmp/
}

/// Key for a plain (non-generic) function unit.
///
/// Components:
///   * `name`         — the fn's resolved (mangled) symbol name. body_fp
///                      deliberately excludes it (it's the typeck cutoff
///                      key), but the emitted IR EMBEDS it (`define @name`),
///                      so two identically-bodied fns need distinct keys or
///                      replay would materialize the wrong symbol. Identical
///                      IR still collapses — at the ARTIFACT level, where
///                      content-addressing dedupes bytes, not keys.
///   * `sig_fp`       — item_sig_fp(store, item): param/return types + bounds
///                      + annotations. The emitted `define` signature depends
///                      on it, and body_fp deliberately excludes it, so it is
///                      keyed explicitly (belt-and-suspenders with the name).
///   * `body_fp`      — item_body_fp(store, item): alpha-canonicalized,
///                      span-invariant body content (core/fingerprint.av).
///   * `type_table_fp` — the type_structure_fingerprints snapshot hash: the
///                      coarse stand-in for "every layout this body could
///                      reach" (see WHY).
///   * `erased`       — @mono_erased bodies lay out unbound T as wide i64;
///                      the same body text emits different IR per regime.
///   * `modes`        — a canonical fingerprint of the IR-affecting codegen
///                      flags (debug_null_checks, coverage): the same source
///                      emits DIFFERENT IR per mode, so a debug and a coverage
///                      build must not share a slot.
///   * `toolchain`    — toolchain_fingerprint(): a compiler change owes a
///                      re-emit even for identical source.
export fn fn_unit_key(name: string, sig_fp: int, body_fp: int, type_table_fp: int, erased: bool, modes: string, toolchain: string) -> FnUnitKey {
    let erased_tag = if erased { "1" } else { "0" }
    let canonical = "fnunit:v3:" + string(name.length) + ":" + name + ":"
        + string(sig_fp) + ":" + string(body_fp) + ":" + string(type_table_fp)
        + ":" + erased_tag + ":" + modes + ":" + toolchain
    FnUnitKey { hash: sha256_hex(canonical) }
}

/// One member of a bounded-K CGU: enough of its identity to make the
/// containing unit's cache key body-and-signature-exact. `erased` carries the
/// @mono_erased layout regime (unbound T lays out as wide i64), same as the
/// per-fn key's `erased` component.
export type CguMember = {
    name: string,
    sig_fp: int,
    body_fp: int,
    erased: bool,
}

/// Key for a bounded-K codegen unit (ps3t.8.6.2): the combined identity of
/// every member fn folded in stmts-appearance order, plus the same
/// whole-unit components a per-fn key carries (type table, codegen modes,
/// toolchain). A one-fn body edit changes exactly its member's body_fp → its
/// bucket's key → that ONE unit re-emits; every other unit hits. Members are
/// order-significant (emission order within the unit is the appearance order),
/// so the caller must pass them in the same order it emits them.
export fn fn_unit_key_cgu(members: List<CguMember>, type_table_fp: int, modes: string, toolchain: string) -> FnUnitKey {
    mut parts = ""
    for m in members {
        let e = if m.erased { "1" } else { "0" }
        parts = parts + string(m.name.length) + ":" + m.name + ":"
            + string(m.sig_fp) + ":" + string(m.body_fp) + ":" + e + ";"
    }
    let canonical = "cgu:v1:" + string(members.length) + ":" + parts
        + "|" + string(type_table_fp) + ":" + modes + ":" + toolchain
    FnUnitKey { hash: sha256_hex(canonical) }
}

/// Key for a monomorphized instance: the instance's mangled symbol name,
/// its signature fp, the generic base's body_fp, and each type argument's
/// structure fingerprint, order-significant. Stamped at mono time (the
/// base/args link is erased from the AST by emission time).
export fn fn_unit_key_mono(name: string, sig_fp: int, base_body_fp: int, type_arg_fps: List<int>, type_table_fp: int, modes: string, toolchain: string) -> FnUnitKey {
    mut args = ""
    for fp in type_arg_fps {
        args = args + string(fp) + ","
    }
    let canonical = "fnunit-mono:v3:" + string(name.length) + ":" + name + ":"
        + string(sig_fp) + ":" + string(base_body_fp) + ":[" + args + "]:"
        + string(type_table_fp) + ":" + modes + ":" + toolchain
    FnUnitKey { hash: sha256_hex(canonical) }
}

/// Build the store view over an existing build Cache, under an explicit
/// namespace subdir. Pure path derivation; `fn_unit_store_init` materialises
/// the directories. Distinct namespaces keep artifacts of different FORMATS
/// from colliding on the same content key — the per-fn IR-dump write side
/// ("fnunits") and the CGU per-fn OBJECT cache ("fncgu") share the keying
/// scheme but not the artifact bytes.
export fn fn_unit_store_for_ns(c: Cache, ns: string) -> FnUnitStore {
    let base = c.cache_dir + ns + "/"
    FnUnitStore {
        key_dir: base + "key/",
        art_dir: base + "art/",
        tmp_dir: base + "_tmp/",
    }
}

/// Build the store view over an existing build Cache. Pure path derivation;
/// `fn_unit_store_init` materialises the directories.
export fn fn_unit_store_for(c: Cache) -> FnUnitStore {
    fn_unit_store_for_ns(c, "fnunits")
}

export fn fn_unit_store_init(s: FnUnitStore) -> bool {
    avra_mkdir_p(s.key_dir) != 0 && avra_mkdir_p(s.art_dir) != 0 && avra_mkdir_p(s.tmp_dir) != 0
}

fn key_path(s: FnUnitStore, k: FnUnitKey) -> string {
    s.key_dir + k.hash
}

fn art_path(s: FnUnitStore, art_hash: string) -> string {
    s.art_dir + art_hash + ".unit"
}

/// Resolve a key to its artifact path, validating completeness: the pointer
/// must name an artifact that exists with non-zero size. Any damaged link in
/// the chain is an honest miss — never a half-served hit.
export fn fn_unit_lookup(s: FnUnitStore, k: FnUnitKey) -> string? {
    let kp = key_path(s, k)
    if !avra_selfhost_file_exists(kp) {
        return null
    }
    let art_hash = avra_selfhost_read_file(kp)
    // A well-formed pointer names a 64-char artifact hash (our own
    // sha256_hex output); a truncated/corrupt pointer is an honest miss.
    if art_hash.length != 64 {
        return null
    }
    let ap = art_path(s, art_hash)
    if !avra_selfhost_file_exists(ap) || avra_file_size(ap) <= 0 {
        return null
    }
    ap
}

/// Publish `artifact_src` (a file on disk — bitcode, IR, any format) under
/// `k`. Content-addresses the artifact, installs it into the art store
/// (no-op when an identical artifact is already present — the collapse),
/// then atomically writes the key pointer. Returns the stored artifact
/// path, or null when any step fails (a failed publish leaves no pointer,
/// so readers keep missing honestly).
export fn fn_unit_publish(s: FnUnitStore, k: FnUnitKey, artifact_src: string) -> string? {
    if !avra_selfhost_file_exists(artifact_src) || avra_file_size(artifact_src) <= 0 {
        return null
    }
    if !fn_unit_store_init(s) {
        return null
    }
    let art_hash = sha256_file(artifact_src)
    if art_hash.length == 0 {
        return null
    }
    let ap = art_path(s, art_hash)
    // Reinstall when the slot is absent OR a damaged zero-byte remnant —
    // a content-addressed slot should never stay corrupt-and-unpublishable.
    if !avra_selfhost_file_exists(ap) || avra_file_size(ap) <= 0 {
        if !atomic_install(artifact_src, ap) {
            return null
        }
    }
    let tmp = s.tmp_dir + k.hash + "." + string(avra_getpid())
    if avra_selfhost_write_file(tmp, art_hash) == 0 {
        let _ = avra_remove_file(tmp)
        return null
    }
    if avra_rename(tmp, key_path(s, k)) == 0 {
        // A concurrent publisher may have won the rename race with an
        // equivalent pointer (same key => same content). Trust the
        // survivor if it resolves; otherwise report failure.
        let _ = avra_remove_file(tmp)
        return fn_unit_lookup(s, k)
    }
    ap
}

// ─────────────────────────────────────────────────────────────────────
// Batched PACK store — the fnunits write path.
//
// The two-files-per-fn key/+art/ layout above is right for the fncgu
// per-fn OBJECT cache (compile.av): binary .o artifacts, handled by PATH,
// read+written one fn at a time under an incremental compile. But the
// fnunits IR-unit publish writes the WHOLE package's fns at once (~3.8k
// for @std/avrac), and at ~2 filesystem creates + renames + a hash-file
// round-trip PER fn it dominated codegen (~94s). Nothing about a bulk,
// write-all-at-once publish needs one inode per unit.
//
// So the fnunits namespace uses a PACK instead: every unit's IR is streamed
// into ONE append-only pack, and ONE text `index` maps keys -> content
// hashes -> byte ranges. A whole package publishes in 2 files, not ~7.7k.
//
// Crash-safety (materialise-atomically): the pack is CONTENT-ADDRESSED
// (`pack.<sha>`) and fully written + fsync-renamed before the index that
// names it is atomically renamed into place. The index rename is the sole
// commit point — until it lands, every reader resolves through the OLD
// index to the OLD pack (both still present), never a torn pair. A crash
// between the two renames orphans a `pack.<sha>` (reclaimed by cache-gc),
// never corrupts a live lookup. Deterministic reruns hash to the SAME
// `pack.<sha>` name, so a rebuild of unchanged sources adds no orphan.
//
// v1 handles TEXTUAL IR (ASCII — byte length == char length, so the
// `.length` offsets are byte offsets). The bitcode format the header
// promises slots in behind `avra_selfhost_*_file_bytes` + a bytes read
// with no format change (offset+len byte ranges are already binary-clean).

/// Filesystem view of a package's pack store (fnunits namespace).
export type FnUnitPack = {
    dir: string,          // <root>cache/fnunits/
    index_path: string,   // <dir>index  — the atomic commit pointer
    tmp_dir: string,      // <dir>_tmp/  — staging for atomic writes
}

export fn fn_unit_pack_for(c: Cache) -> FnUnitPack {
    let dir = c.cache_dir + "fnunits/"
    FnUnitPack { dir: dir, index_path: dir + "index", tmp_dir: dir + "_tmp/" }
}

/// One accumulated unit: content hash of its IR + the IR text.
type PackBlob = { hash: string, ir: string }
/// A cache key pointing at a content hash (many keys may share one blob).
type PackKey = { key_hash: string, art_hash: string }

/// In-memory accumulator for a package's units. Dedupes blobs by content
/// hash (the §8 identical-IR collapse — mono instances), preserving first-
/// seen order so byte offsets are stable and reruns are deterministic.
export type FnUnitBatch = {
    blobs: List<PackBlob>,   // unique blobs, first-seen order
    keys: List<PackKey>,     // key -> art_hash, one per published fn
    seen: ptr,               // C map art_hash -> blobs index (dedup set)
}

export fn fn_unit_batch_new() -> FnUnitBatch {
    FnUnitBatch { blobs: [], keys: [], seen: avra_map_new_cstr() }
}

impl FnUnitBatch {
    /// Accumulate one function's unit. Hashes the IR in memory (no temp
    /// file, no read-back), collapses identical IR to a single stored blob
    /// (the §8 identical-IR / mono-instance explosion control).
    fn add(self, key_hash: string, ir: string) {
        if ir.length == 0 {
            return
        }
        let art_hash = sha256_hex(ir)
        if avra_map_has_cstr(self.seen, art_hash) == 0 {
            avra_map_set_cstr(self.seen, art_hash, self.blobs.length)
            self.blobs.push(PackBlob { hash: art_hash, ir: ir })
        }
        self.keys.push(PackKey { key_hash: key_hash, art_hash: art_hash })
    }

    fn count(self) -> int {
        self.keys.length
    }
}

/// Materialise a batch atomically: one content-addressed pack + one index.
/// Returns the number of keys committed (0 on an empty batch or any I/O
/// failure — publishing must never fail a compile).
export fn fn_unit_pack_flush(p: FnUnitPack, b: FnUnitBatch) -> int {
    if b.blobs.length == 0 {
        return 0
    }
    if avra_mkdir_p(p.dir) == 0 {
        return 0
    }
    if avra_mkdir_p(p.tmp_dir) == 0 {
        return 0
    }
    let pid = string(avra_getpid())
    let pack_tmp = p.tmp_dir + "pack." + pid
    let _ = avra_remove_file(pack_tmp)
    // Stream every unique blob into the pack tmp, recording each byte offset.
    mut offsets: List<int> = []
    mut offset = 0
    for blob in b.blobs {
        offsets.push(offset)
        if avra_selfhost_append_file(pack_tmp, blob.ir) == 0 {
            let _ = avra_remove_file(pack_tmp)
            return 0
        }
        offset = offset + blob.ir.length
    }
    // Content-address the finished pack; commit is the index rename below.
    let pack_hash = sha256_file(pack_tmp)
    // sha256_file caches its digest in a <path>.avra-sha256 sidecar; for our
    // pid-unique temp that cache is never reused, so drop it (no _tmp litter).
    let _ = avra_remove_file(pack_tmp + ".avra-sha256")
    if pack_hash.length == 0 {
        let _ = avra_remove_file(pack_tmp)
        return 0
    }
    let pack_name = "pack." + pack_hash
    let pack_final = p.dir + pack_name
    if avra_selfhost_file_exists(pack_final) && avra_file_size(pack_final) > 0 {
        // Deterministic rerun produced identical bytes — dedupe, no orphan.
        let _ = avra_remove_file(pack_tmp)
    } else {
        if avra_rename(pack_tmp, pack_final) == 0 {
            let _ = avra_remove_file(pack_tmp)
            return 0
        }
    }
    // Build the index in a tmp: PACK header, A(rtifact) records, K(ey) records.
    let idx_tmp = p.tmp_dir + "index." + pid
    let _ = avra_remove_file(idx_tmp)
    if avra_selfhost_append_file(idx_tmp, "PACK " + pack_name + "\n") == 0 {
        let _ = avra_remove_file(idx_tmp)
        return 0
    }
    mut i = 0
    for blob in b.blobs {
        let rec = "A " + blob.hash + " " + string(offsets[i]) + " " + string(blob.ir.length) + "\n"
        if avra_selfhost_append_file(idx_tmp, rec) == 0 {
            let _ = avra_remove_file(idx_tmp)
            return 0
        }
        i = i + 1
    }
    for k in b.keys {
        if avra_selfhost_append_file(idx_tmp, "K " + k.key_hash + " " + k.art_hash + "\n") == 0 {
            let _ = avra_remove_file(idx_tmp)
            return 0
        }
    }
    // Commit: the index rename atomically switches to the new (index, pack).
    if avra_rename(idx_tmp, p.index_path) == 0 {
        let _ = avra_remove_file(idx_tmp)
        return 0
    }
    b.keys.length
}

/// Resolve a unit's IR by key hash: key -> art_hash -> (offset,len) -> pack
/// slice. Returns null on any miss (absent index/pack, unknown key, damaged
/// range). Rare today (readers are mid-migration); a replay path will parse
/// the index once and serve many, but the round-trip is correct as-is.
export fn fn_unit_pack_lookup(p: FnUnitPack, key_hash: string) -> string? {
    if !avra_selfhost_file_exists(p.index_path) {
        return null
    }
    let idx = avra_selfhost_read_file(p.index_path)
    if idx.length == 0 {
        return null
    }
    mut pack_name = ""
    mut art_hash = ""
    for line in idx.split("\n") {
        if line.starts_with("PACK ") {
            pack_name = line.substring(5, line.length)
        } else if line.starts_with("K ") {
            let parts = line.split(" ")
            if parts.length == 3 && parts[1] == key_hash {
                art_hash = parts[2]
            }
        }
    }
    if art_hash.length == 0 || pack_name.length == 0 {
        return null
    }
    mut off = 0 - 1
    mut len = 0 - 1
    for line in idx.split("\n") {
        if line.starts_with("A ") {
            let parts = line.split(" ")
            if parts.length == 4 && parts[1] == art_hash {
                off = avra_parse_int(parts[2])
                len = avra_parse_int(parts[3])
            }
        }
    }
    if off < 0 || len < 0 {
        return null
    }
    let pack_path = p.dir + pack_name
    if !avra_selfhost_file_exists(pack_path) {
        return null
    }
    let suffix = avra_selfhost_read_file_from(pack_path, off)
    if suffix.length < len {
        return null
    }
    suffix.substring(0, len)
}
