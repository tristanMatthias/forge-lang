// t-kdyj.1 slice 4 — the box-wide compile slot gate.
//
// WHY THIS EXISTS: the slice-3 budget grant is computed per admitted TREE but
// enforced per PROCESS, so a shard binary whose W test workers each shell a
// `bs2 compile` probe is W concurrent processes each entitled to the full
// grant — no member ever crosses its own budget and the soft trip's floor
// condition is unreachable. Three cold trees of under-their-own-budget probes
// took the container down in five minutes with zero diagnostics (2026-08-01,
// acceptance-proof round 1, logged on t-kdyj.1). The gate is the bound that
// holds: under memory pressure every heavy bs2 process must HOLD one of a
// small set of flock slots before doing heavy work — back-pressure by
// waiting, never a kill, crash-safe because flock dies with the process.
//
// The policy fns are pure and pinned directly (the failure is a property of
// the INPUTS, and a quiet box does not supply them — the memory_ceiling_test
// precedent). The end-to-end specs force the threshold with AVRA_SLOT_GATE_MB
// and isolate slots with AVRA_COMPILE_SLOT_DIR, so they are deterministic on
// any box, roomy or tight. Command verdicts come from avra_shell_exec_status
// with a per-spec log (the repo's exit-status idiom) — never `|| true` or a
// parsed `rc=$?`.

use @std.avrac.core.{avra_shell_exec, avra_shell_exec_status, avra_selfhost_read_file, avra_selfhost_write_file, avra_getpid}

extern fn avra_slot_gate_threshold_for(total_kb: int) -> int
extern fn avra_slot_gate_should_wait(avail_kb: int, threshold_kb: int) -> int
extern fn avra_flock_try_exclusive(path: string) -> int
extern fn avra_flock_unlock(fd: int) -> int

/// A STANDALONE file (bare `bs2 check` prints "ok"), so the success
/// assertions measure the gate and not import resolution — the difftest
/// corpus exists precisely to compile with no package context. Small enough
/// that a gated check is fast; the gate itself is what's under test. Being
/// import-free it never touches the @std metadata fast-path, so the
/// orchestration env (AVRA_USE_METADATA / AVRA_LIB_OBJS) is deliberately
/// not part of these commands.
const SMALL_FILE: string = "tests/difftest_corpus/strings_interp.av"

/// A per-spec-process slot dir so concurrent shards can't contend on these
/// specs' slots (the REAL gate uses a box-wide dir on purpose; tests must not).
fn slot_dir() -> string {
    "/tmp/avra_slot_gate_test_${string(avra_getpid())}"
}

spec "slot-gate policy: the pressure threshold scales with the box" {
    then "a 16 GiB box gates below ~6 GiB available (3/8 of MemTotal)" {
        // The box that died: MemTotal 16461176 kB. 16461176/8*3 = 6172941 kB.
        avra_slot_gate_threshold_for(16461176) == 6172941
    }
    then "a small box clamps up to the 2 GiB floor" {
        // 4 GiB * 3/8 = 1.5 GiB — below the floor; near-cliff on any box.
        avra_slot_gate_threshold_for(4194304) == 2048 * 1024
    }
    then "a huge box clamps down to the 8 GiB ceiling" {
        // 64 GiB * 3/8 = 24 GiB — a 64 GiB box with 10 GiB free is NOT under
        // pressure; without the clamp the gate would serialise healthy runs.
        avra_slot_gate_threshold_for(67108864) == 8192 * 1024
    }
    then "an unknown MemTotal disables the gate (no pressure signal to act on)" {
        avra_slot_gate_threshold_for(0) == 0 && avra_slot_gate_threshold_for(0 - 1) == 0
    }
}

spec "slot-gate policy: the wait decision" {
    then "below the threshold demands a slot" {
        avra_slot_gate_should_wait(4000000, 6172941) == 1
    }
    then "at or above the threshold does not" {
        avra_slot_gate_should_wait(6172941, 6172941) == 0
            && avra_slot_gate_should_wait(15000000, 6172941) == 0
    }
    then "a disabled threshold or unreadable avail never gates" {
        avra_slot_gate_should_wait(4000000, 0) == 0
            && avra_slot_gate_should_wait(0, 6172941) == 0
            && avra_slot_gate_should_wait(0 - 1, 6172941) == 0
    }
}

/// Run `bs2 check SMALL_FILE` with the gate's threshold forced to `mb` MiB,
/// slots isolated under `dir`, output to `log`. Returns the child's real
/// exit status; `extra` prepends more env (e.g. width). timeout_s bounds a
/// wrongly-blocking implementation instead of hanging the suite.
fn check_gated_rc(mb: string, dir: string, extra: string, timeout_s: string, log: string) -> int {
    avra_shell_exec_status("${extra}AVRA_SLOT_GATE_MB=${mb} AVRA_COMPILE_SLOT_DIR='${dir}' timeout ${timeout_s} ./build/bs2 check '${SMALL_FILE}' > '${log}' 2>&1")
}

/// Hold slot0 of a width-one `dir` from THIS spec process. Makes the bypass
/// cases observable: an implementation that wrongly engages the gate finds
/// every slot taken and blocks into the timeout, instead of silently
/// acquiring an uncontended slot and passing anyway.
fn hold_slot0(dir: string) -> int {
    let _ = avra_shell_exec("mkdir -p '${dir}'")
    avra_flock_try_exclusive("${dir}/slot0")
}

spec "slot-gate end to end: engagement follows pressure" {
    then "a roomy box never engages the gate, even with every slot held" {
        // Threshold 1 MiB is always cleared; slot0 held + width 1 means a
        // wrongly-engaging gate has nothing to acquire and times out red.
        let dir = "${slot_dir()}_roomy"
        let held = hold_slot0(dir)
        let log = "${dir}.log"
        let rc = check_gated_rc("1", dir, "AVRA_COMPILE_SLOT_WIDTH=1 ", "10", log)
        let _ = avra_flock_unlock(held)
        let out = avra_selfhost_read_file(log)
        held >= 0 && rc == 0 && !out.contains("[slot-gate]") && out.contains("ok")
    }
    then "under forced pressure an uncontended acquisition is SILENT and succeeds" {
        // Threshold far above any real MemAvailable -> the gate always engages.
        // Silence is a load-bearing property, not a missing feature: mid-suite
        // the box sits under the threshold routinely, and a fast-path line
        // would contaminate every shelled probe's captured output. Engagement
        // itself is proven by the contended specs below — only a process that
        // runs the gate can be made to WAIT.
        let dir = "${slot_dir()}_engaged"
        let log = "${dir}.log"
        let rc = check_gated_rc("999999999", dir, "", "60", log)
        let out = avra_selfhost_read_file(log)
        rc == 0 && !out.contains("[slot-gate]") && out.contains("ok")
    }
    then "AVRA_SLOT_GATE_MB=0 disables the gate even under contention" {
        let dir = "${slot_dir()}_disabled"
        let held = hold_slot0(dir)
        let log = "${dir}.log"
        let rc = check_gated_rc("0", dir, "AVRA_COMPILE_SLOT_WIDTH=1 ", "10", log)
        let _ = avra_flock_unlock(held)
        let out = avra_selfhost_read_file(log)
        held >= 0 && rc == 0 && !out.contains("[slot-gate]") && out.contains("ok")
    }
}

spec "slot-gate end to end: an occupied gate blocks, then admits" {
    then "with every slot held, a compile WAITS instead of proceeding" {
        // Width 1 + the only slot held by this spec process: the gated check
        // must sit in the wait loop until the timeout kills it. rc 124 is the
        // proof of blocking; the waiting line is the proof it said why.
        let dir = "${slot_dir()}_blocked"
        let held = hold_slot0(dir)
        let log = "${dir}.log"
        let rc = check_gated_rc("999999999", dir, "AVRA_COMPILE_SLOT_WIDTH=1 ", "3", log)
        let _ = avra_flock_unlock(held)
        let out = avra_selfhost_read_file(log)
        held >= 0 && rc == 124 && out.contains("waiting for one of 1 compile slots")
    }
    then "releasing the slot admits the next compile, without wait chatter" {
        let dir = "${slot_dir()}_released"
        let held = hold_slot0(dir)
        let _ = avra_flock_unlock(held)
        let log = "${dir}.log"
        let rc = check_gated_rc("999999999", dir, "AVRA_COMPILE_SLOT_WIDTH=1 ", "60", log)
        let out = avra_selfhost_read_file(log)
        held >= 0 && rc == 0 && !out.contains("[slot-gate]") && out.contains("ok")
    }
    then "slots are per-file: width 2 admits a second compile while slot0 is held" {
        let dir = "${slot_dir()}_width2"
        let held = hold_slot0(dir)
        let log = "${dir}.log"
        let rc = check_gated_rc("999999999", dir, "AVRA_COMPILE_SLOT_WIDTH=2 ", "60", log)
        let _ = avra_flock_unlock(held)
        let out = avra_selfhost_read_file(log)
        held >= 0 && rc == 0 && !out.contains("waiting") && out.contains("ok")
    }
}

spec "slot-gate policy: HEADROOM makes the decision predictive (t-2fe6)" {
    // THE DEFECT: the gate is REACTIVE — above the threshold it returns WITHOUT
    // taking a slot, so on a healthy box it bounds nothing and several heavy
    // compiles start inside one window. Measured on a full suite (per-process
    // peaks, commands labelled), the top consumers are FIXTURE COMPILES, not
    // shards: 4779 / 3515 / 3449 MB, all `bs2 compile /tmp/avra_*`. CI then
    // loses ~8GB inside one 30s heartbeat and the runner evicts it (exit 143).
    //
    // `avra_compile_slot_gate` adds AVRA_SLOT_GATE_HEADROOM_MB to the threshold
    // before asking, so the policy IS this arithmetic. Engagement itself was
    // verified manually against a held slot, with a headroom-off control:
    //   headroom ON  -> "[slot-gate] memory pressure (6936 MiB available <
    //                    1000000 MiB): waiting for one of 1 compile slots"
    //   headroom OFF -> no engagement
    then "with no headroom, a box above the threshold does NOT wait" {
        // Today's behaviour, and the default: 6GB avail against a 4GB threshold.
        avra_slot_gate_should_wait(6 * 1024 * 1024, 4 * 1024 * 1024) == 0
    }
    then "the SAME box waits once headroom is reserved on top" {
        // 6GB avail, 4GB threshold, 3GB headroom: the compile would leave the box
        // under the threshold, so it waits BEFORE committing rather than after.
        avra_slot_gate_should_wait(6 * 1024 * 1024, 4 * 1024 * 1024 + 3 * 1024 * 1024) == 1
    }
    then "headroom does not make a ROOMY box wait" {
        // The throughput half, and why the default is 0: two prior tunings in
        // this area were artefacts that HALVED CI wall-time. 14GB absorbs the
        // same 4GB + 3GB and must still admit immediately.
        avra_slot_gate_should_wait(14 * 1024 * 1024, 4 * 1024 * 1024 + 3 * 1024 * 1024) == 0
    }
    then "an unavailable reading still disables the wait, headroom or not" {
        // avail <= 0 is the SAMPLER-UNAVAILABLE sentinel, never a real reading;
        // failing OPEN on it is deliberate, so a blind gate cannot stall the box.
        avra_slot_gate_should_wait(0 - 1, 4 * 1024 * 1024 + 3 * 1024 * 1024) == 0
    }
}

// t-2fe6 (B): the slot gate is RE-ENTRANT, so a slot-holder's own children do
// not queue behind it.
//
// THE DEADLOCK. The slot fd is `static` and never closed, so a process HOLDS
// its slot until it exits. A spec that shells out to a child `bs2` therefore
// waits on itself under pressure: parent holds a slot, child queues for one of
// the few remaining, parent cannot exit until the child returns, child cannot
// start until a slot frees. Nothing consumes memory while this happens, so
// every memory-based guard is blind to it.
//
// Observed on CI: pool frozen at 120/151 with the same three units in flight
// and MemAvailable FLAT at 2971MB for ~40 minutes, against a ~14 minute norm —
// heading for the job timeout. Two of the three stuck units shell out to child
// compiles. Distinct from the eviction shape, where `avail` collapses ~8GB
// inside one heartbeat and the runner kills the job.
//
// A child of a slot-holder is already covered by its parent's slot. The marker
// rides the environment, which children inherit by construction.
spec "the slot gate is re-entrant — a child of a slot-holder does not queue" {
    then "with EVERY slot held, an un-marked compile blocks — the gate engages" {
        // The control, and it earned its place: a first draft used the wrong
        // width env var, so no slot was ever contended and the re-entrancy spec
        // would have passed for the wrong reason. This caught that.
        let dir = "${slot_dir()}_reentry_ctl"
        let fd = hold_slot0(dir)
        let rc = check_gated_rc("999999", dir, "AVRA_COMPILE_SLOT_WIDTH=1 ", "3", "/dev/null")
        let _ = avra_flock_unlock(fd)
        rc != 0
    }
    then "the SAME setup completes when the process is marked as already holding one" {
        // The BYPASS branch in isolation. On its own this is NOT a guard for the
        // fix — it injects the marker by hand, so it would pass even if nothing
        // ever SET it. The nested spec below is what covers that half.
        let dir = "${slot_dir()}_reentry_fix"
        let fd = hold_slot0(dir)
        let rc = check_gated_rc("999999", dir, "AVRA_SLOT_HELD=1 AVRA_COMPILE_SLOT_WIDTH=1 ", "10", "/dev/null")
        let _ = avra_flock_unlock(fd)
        rc == 0
    }

    then "a REAL slot-holder's child completes — the deadlock itself, end to end" {
        // The one that actually guards the fix. Nothing is injected: a parent
        // `bs2` takes the only slot under forced pressure, then shells out to a
        // child `bs2`. The child must see the marker its PARENT set and proceed.
        //
        // Without the setenv calls this is the CI hang in miniature — the parent
        // holds the slot, the child queues for it, the parent cannot exit until
        // the child returns, and `timeout` reaps the pair.
        let dir = "${slot_dir()}_nested"
        let _ = avra_shell_exec("mkdir -p '${dir}'")
        let fixture = "/tmp/avra_slot_nested_${string(avra_getpid())}.av"
        let child_cmd = "./build/bs2 check '${SMALL_FILE}'"
        let src = "use @std.avrac.core.{avra_shell_exec_status}\n"
            + "fn main() -> int {\n"
            + "    avra_shell_exec_status(\"${child_cmd}\")\n"
            + "}\n"
        let _ = avra_selfhost_write_file(fixture, src)
        let rc = avra_shell_exec_status(
            "AVRA_SLOT_GATE_MB=999999 AVRA_COMPILE_SLOT_WIDTH=1 AVRA_COMPILE_SLOT_DIR='${dir}' "
            + "timeout 60 ./build/bs2 run '${fixture}' > /dev/null 2>&1")
        let _ = avra_shell_exec("rm -f '${fixture}'")
        rc == 0
    }
}

