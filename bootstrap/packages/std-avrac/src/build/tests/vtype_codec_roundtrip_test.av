// WHY: the metadata codec (BytesWriter/BytesReader `.vtype`) must round-trip
// container ValueTypes including `Map(key, value)` — the encoder writes the
// VT_MAP tag then recursively encodes key + value, and the decoder reads them
// back (the Map analog of the VT_LIST arm). No exported @std / compiler
// signature currently carries a `Map`, so without this the Map codec arm would
// ship untested even though every package build round-trips its metadata.

use @std.avrac.build.{writer_new, reader_new}
use @std.avrac.core.{ValueType, vtype_render_full}

// Encode a ValueType through the writer, decode it back through the reader, and
// render the result — a string-equality assertion is byte-for-byte enough since
// vtype_render_full is injective over the structure under test.
fn rt(vt: ValueType) -> string {
    let w = writer_new()
    w.vtype(vt)
    let r = reader_new(w.finish())
    vtype_render_full(r.vtype())
}

spec "metadata codec round-trips Map(key, value)" {
    then "Map<string, int> survives the round-trip" {
        rt(ValueType.Map(ValueType.Str, ValueType.Int)) == "Map<string, int>"
    }
    then "a list-typed map value round-trips (Map<string, List<int>>)" {
        rt(ValueType.Map(ValueType.Str, ValueType.List(ValueType.Int))) == "Map<string, List<int>>"
    }
    then "a map-in-map value round-trips (Map<string, Map<string, bool>>)" {
        rt(ValueType.Map(ValueType.Str, ValueType.Map(ValueType.Str, ValueType.Bool))) == "Map<string, Map<string, bool>>"
    }
    then "the List arm still round-trips (control)" {
        rt(ValueType.List(ValueType.Int)) == "List<int>"
    }
}

// nsvk: VT_STRUCT must carry its generic type_args across the codec, mirroring
// VT_ENUM. Before the fix the encoder dropped args (name+sym_id only), so a
// generic struct decoded cross-module as the bare name with empty args and
// field-access substitution (tc_specialize_field_ty) no-op'd — `b.val` for a
// `Box<int>` imported via metadata stayed the unsubstituted `T`. These assert
// the args survive; the empty-args control proves the non-generic case is
// unchanged (byte-identical round-trip).
spec "metadata codec round-trips a generic Struct's type_args (nsvk)" {
    then "Box<int> keeps its arg through the round-trip" {
        rt(ValueType.Struct("Box", [ValueType.Int], 0)) == "Box<int>"
    }
    then "a two-arg generic struct round-trips (Pair<int, string>)" {
        rt(ValueType.Struct("Pair", [ValueType.Int, ValueType.Str], 0)) == "Pair<int, string>"
    }
    then "a nested generic arg round-trips (Box<List<int>>)" {
        rt(ValueType.Struct("Box", [ValueType.List(ValueType.Int)], 0)) == "Box<List<int>>"
    }
    then "a non-generic struct still round-trips as the bare name (control)" {
        rt(ValueType.Struct("Plain", [], 0)) == "Plain"
    }
}
