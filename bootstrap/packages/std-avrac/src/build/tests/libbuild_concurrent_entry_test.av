// WHY: t-5s7l — `bs2 build --lib` must not depend on the SHARED entry
// `<entry>.ll`, because that path is contended by every sibling build of the
// same package.
//
// The race, as it was: the driver removed `<entry>.ll` before spawning its
// child (the 18z8 freshness guarantee — "an artifact after the compile is
// necessarily the child's fresh output"), then read the child's IR back from
// that same shared path. Correct in isolation, wrong under concurrency: a
// sibling's unlink lands between THIS build's compile and its artifact read,
// and this build dies with `compile produced no IR` while everything it should
// have produced is correct on disk. pdme.7 already named the path — "the
// shared `<entry>.ll` is the one path the cache can't defend" — and named the
// remedy: per-process `--output`.
//
// That signature is exactly what CI showed on the rc-strict suite: fixture
// probe `std_avrac_build_rc_zero` FAIL with `avrac_meta_bin_present`,
// `avrac_ll_present` and both symbol probes PASS on the same run. Three test
// units shell out `bs2 build --lib` on packages/std-avrac (this fixture,
// cli_metadata, metadata_walker_method_dispatch) and the suite runs them
// across parallel shards.
//
// HOW THIS MEASURES IT. The first version of this file raced two builds of a
// two-function package and PASSED against the buggy driver — recorded as a
// negative result rather than believed, because a race whose window is "between
// a sibling's compile and its artifact read" cannot show up when the compile
// takes milliseconds. Scaling the package up to widen the window made the spec
// cost ten minutes and still left the outcome to luck.
//
// So the window is not widened — it is REMOVED. `conc_build_with_deleter` runs
// ONE build alongside a loop that deletes `<entry>.ll` continuously: the
// sibling's unlink, made continuous instead of coincidental. Against the old
// driver that is a reliable failure; against a driver that reads its own
// pid-private output it cannot matter at all. The concurrent-builds spec below
// keeps the realistic shape as a second, cheaper check.
//
// Throwaway /tmp package per pid so the probe is shard-safe and touches no
// shared build state of its own — the thing under test is contention on ONE
// package, which this fixture creates and owns.

use @std.avrac.core.{
    avra_shell_exec, avra_shell_exec_status,
    avra_selfhost_write_file, avra_selfhost_read_file,
    avra_selfhost_file_exists, avra_getpid,
}

/// Materialise a throwaway [lib] package. Small on purpose now that the
/// witness no longer depends on the compile being slow.
fn conc_mk_pkg(slug: string) -> string {
    let dir = "/tmp/avra_libconc_${slug}_${string(avra_getpid())}"
    let _ = avra_shell_exec("rm -rf '${dir}' && mkdir -p '${dir}/src'")
    let _ = avra_selfhost_write_file("${dir}/avra.toml",
        "[package]\nname = \"@test/libconc-${slug}\"\nversion = \"0.0.1\"\n\n[lib]\nname = \"libconc-${slug}\"\npath = \"src/lib.av\"\n")
    let _ = avra_selfhost_write_file("${dir}/src/lib.av",
        "export fn one() -> int { 1 }\nexport fn two() -> int { one() + 1 }\n")
    dir
}

/// The env strip mirrors libbuild_stale_ll_test: the child must not inherit the
/// test runner's metadata/lib environment, and AVRA_COMPILER is stripped so the
/// child re-exec resolves to this same bs2 via argv[0].
fn conc_build_prefix(dir: string) -> string {
    let root = avra_shell_exec("pwd").trim()
    "cd '${dir}' && env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS -u AVRA_LIB_PKG_ROOT -u AVRA_COMPILER '${root}/build/bs2'"
}

/// Run N `bs2 build --lib` on `dir` CONCURRENTLY and return their exit codes,
/// space-separated in launch order (rc.<i> files, read by index).
fn conc_build_n(dir: string, n: int) -> string {
    let pfx = conc_build_prefix(dir)
    // `&` + `wait`: the builds must OVERLAP. Sequential runs cannot exhibit the
    // race and would make this spec vacuously green.
    mut launch = ""
    mut i = 0
    while i < n {
        // `$?` is NOT escaped: Avra interpolates only on `${`, so a bare `$?`
        // passes through verbatim and the SHELL expands it. Escaping it wrote
        // the literal two characters into rc.<i> and the spec compared "$? $?"
        // against "0 0" — failing for a reason that had nothing to do with the
        // race it exists to measure. Caught by running it; a guard that cannot
        // report the thing it guards is worth nothing.
        launch = launch + "( ${pfx} build --lib --emit_metadata > '${dir}/log.${string(i)}' 2>&1 ; echo $? > '${dir}/rc.${string(i)}' ) & "
        i = i + 1
    }
    let _ = avra_shell_exec("${launch} wait")
    mut out = ""
    mut j = 0
    while j < n {
        let p = "${dir}/rc.${string(j)}"
        let rc = if avra_selfhost_file_exists(p) == 1 { avra_selfhost_read_file(p).trim() } else { "MISSING" }
        out = out + rc + " "
        j = j + 1
    }
    out.trim()
}

/// Run ONE `bs2 build --lib` while a background loop unlinks the shared entry
/// `.ll` as fast as it can — a sibling build's freshness unlink, made
/// continuous. Returns the build's exit code as a string.
///
/// The deleter is bounded by the build's own lifetime (killed on the way out)
/// and by a hard iteration cap, so a build that dies early can't leave it
/// spinning.
fn conc_build_with_deleter(dir: string) -> string {
    let pfx = conc_build_prefix(dir)
    let ll = "${dir}/src/lib.av.ll"
    // NOTHING here escapes `$`. Avra interpolates only on `${`, so a bare `$i`
    // / `$!` / `$?` reaches the shell verbatim and the SHELL expands it —
    // whereas `\$` reaches the shell as an escaped dollar and expands to a
    // LITERAL `$`. That exact slip once wrote "$?" into the rc file and made
    // this spec fail for a reason unrelated to what it measures.
    let script =
        "( i=0; while [ $i -lt 20000 ]; do rm -f '${ll}'; i=$((i+1)); done ) & DEL=$!\n" +
        "( ${pfx} build --lib --emit_metadata > '${dir}/chaos.log' 2>&1 ; echo $? > '${dir}/chaos.rc' )\n" +
        "kill $DEL 2>/dev/null; wait $DEL 2>/dev/null\n"
    let _ = avra_shell_exec(script)
    let p = "${dir}/chaos.rc"
    if avra_selfhost_file_exists(p) == 1 { avra_selfhost_read_file(p).trim() } else { "MISSING" }
}

/// Concatenated build logs, for surfacing WHY on failure rather than a bare FAIL.
fn conc_logs(dir: string, n: int) -> string {
    mut out = ""
    mut i = 0
    while i < n {
        let p = "${dir}/log.${string(i)}"
        if avra_selfhost_file_exists(p) == 1 {
            out = out + "--- build ${string(i)} ---\n" + avra_selfhost_read_file(p) + "\n"
        }
        i = i + 1
    }
    out
}

spec "t-5s7l: `bs2 build --lib` does not depend on the shared entry .ll" {
    then "a build survives an entry .ll being unlinked underneath it" {
        // THE witness. Against a driver that reads the shared path back after
        // the compile this is a reliable `compile produced no IR`; against one
        // that reads its own pid-private `--output` the deleter is irrelevant.
        let dir = conc_mk_pkg("chaos")
        let rc = conc_build_with_deleter(dir)
        let ok = rc == "0"
        if !ok {
            println("build under a concurrent entry-.ll deleter exited [${rc}] (expected 0)")
            let p = "${dir}/chaos.log"
            if avra_selfhost_file_exists(p) == 1 { println(avra_selfhost_read_file(p)) }
        }
        let _ = avra_shell_exec("rm -rf '${dir}'")
        ok
    }
    then "two simultaneous builds both succeed" {
        let dir = conc_mk_pkg("two")
        let rcs = conc_build_n(dir, 2)
        let ok = rcs == "0 0"
        if !ok {
            println("concurrent lib build rcs = [${rcs}] (expected `0 0`)")
            println(conc_logs(dir, 2))
        }
        let _ = avra_shell_exec("rm -rf '${dir}'")
        ok
    }
    then "four simultaneous builds all succeed" {
        // Four, because the suite runs more than two shards. Cheap: the
        // deterministic witness above is what actually pins the mechanism.
        let dir = conc_mk_pkg("four")
        let rcs = conc_build_n(dir, 4)
        let ok = rcs == "0 0 0 0"
        if !ok {
            println("concurrent lib build rcs = [${rcs}] (expected `0 0 0 0`)")
            println(conc_logs(dir, 4))
        }
        let _ = avra_shell_exec("rm -rf '${dir}'")
        ok
    }
    then "the orphan sweep reclaims an aged artifact and spares an in-flight one" {
        // The driver sweeps orphaned `<entry>.build-<pid>.ll` left by builds
        // that were hard-killed mid-flight. That sweep is age-gated (>1 day)
        // for a reason: this path is CONTENDED, so a blanket
        // `rm -f <entry>.build-*.ll` would delete a concurrent build's output
        // and reintroduce the race this file exists to prevent — one path over.
        //
        // BOTH halves of the age gate are asserted, because each alone is
        // satisfiable by a degenerate sweep: checking only that the fresh decoy
        // survives passes when the sweep is deleted outright, and checking only
        // that the aged one is reclaimed passes for the blanket glob the age
        // gate exists to rule out. Together they admit only the age gate.
        let dir = conc_mk_pkg("sweep")
        let decoy = "${dir}/src/lib.av.build-999999.ll"
        let _ = avra_selfhost_write_file(decoy, "; in-flight output of a concurrent build\n")
        let orphan = "${dir}/src/lib.av.build-888888.ll"
        let _ = avra_selfhost_write_file(orphan, "; abandoned by a hard-killed build\n")
        let _ = avra_shell_exec("touch -t 202001010000 '${orphan}'")
        let rcs = conc_build_n(dir, 1)
        let survived = avra_selfhost_file_exists(decoy) == 1
        let reclaimed = avra_selfhost_file_exists(orphan) == 0
        let ok = rcs == "0" && survived && reclaimed
        if !ok {
            println("orphan sweep check failed: rc=[${rcs}] fresh decoy survived=${string(survived)} aged orphan reclaimed=${string(reclaimed)}")
            println(conc_logs(dir, 1))
        }
        let _ = avra_shell_exec("rm -rf '${dir}'")
        ok
    }
    then "a successful build still installs fresh IR at the entry path" {
        // The freshness half of 18z8 must survive the fix: a build that reports
        // success leaves real IR at the entry path, produced by THIS build.
        let dir = conc_mk_pkg("artifact")
        let rcs = conc_build_n(dir, 2)
        let ll = "${dir}/src/lib.av.ll"
        let present = avra_selfhost_file_exists(ll) == 1
        let body = if present { avra_selfhost_read_file(ll) } else { "" }
        let ok = rcs == "0 0" && present && body.contains("define")
        if !ok {
            println("post-race artifact check failed: rcs=[${rcs}] present=${string(present)} bytes=${string(body.length)}")
        }
        let _ = avra_shell_exec("rm -rf '${dir}'")
        ok
    }
}
