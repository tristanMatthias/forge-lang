// WHY: t-tit7 — the cache size budget is GLOBAL, not per-root.
//
// It used to be per-root, which cannot bound the thing it exists to protect.
// The disk allowance is ONE shared resource, so N roots can each be honestly
// "under the 12G cap" while their total is far over it. Measured on the
// container: nine roots summing to 13G, 11G of free disk, and `make cache-gc`
// freed exactly 0 bytes while reporting success from every root. The ceiling
// the old semantics permitted was the PRODUCT — 9 x 12G = 108G — and it rose
// by another 12G every time a package was added.
//
// The operator cost is the part that matters: cache-gc is CLAUDE.md's advertised
// lighter-weight alternative to `make clean` under disk pressure, so it no-ops
// precisely when it is reached for. The tell was needing to hand-tune
// AVRA_CACHE_MAX_MB to make the default do anything — a default that never fires
// is not a default.
//
// These specs pin BOTH directions. The over-budget one is the regression guard:
// three roots, each individually under the cap, jointly over it — the exact shape
// per-root semantics cannot see (verified before landing: under a per-root cap the
// same fixture reports "nothing to evict" three times and sheds zero bytes). The
// under-budget one exists because a budget that evicted unconditionally would also
// pass the first spec while being just as wrong.
//
// Sandbox is a repo-local build/ subtree (NOT /tmp — t-2qn0), removed at the end.
// Sizes carry margin so directory-block accounting can't flip the verdict.
//
// @@fixture-stateful@@ — shells the SHARED build/bs2 via diagnose.sh; a transient
// hiccup must re-probe, not freeze as a permanent FAIL.

use @std.avrac.core.{avra_shell_exec, avra_shell_exec_status, avra_selfhost_read_file, avra_getpid}

/// Run cache-gc against `sb` under `cap`, asserting it EXITED 0 before its
/// output is trusted. `avra_shell_exec` captures text but discards status, so a
/// command that printed the expected line and then failed would pass a
/// text-only assertion — the log-plus-status pattern is the house rule for
/// specs that care about both.
fn run_gc(base: string, sb: string, cap: string) -> string {
    let log = "${sb}.gc.log"
    let rc = avra_shell_exec_status(
        "cd '${base}' && AVRA_CACHE_MAX_MB=${cap} bash scripts/diagnose.sh --cache-gc 30 '${sb}' > '${log}' 2>&1")
    if rc != 0 { return "GC-EXIT-${string(rc)}" }
    avra_selfhost_read_file(log)
}

/// Stand up `roots` cache roots under `sb`, each with 4 x 1MB slots aged
/// 1-4 hours so the size prune has an unambiguous oldest-first order.
fn seed_roots(sb: string) -> int {
    for r in ["", "packages/a", "packages/b"] {
        let d = if r == "" { sb } else { "${sb}/${r}" }
        avra_shell_exec("mkdir -p '${d}/build/cache'")
        for i in 1..5 {
            avra_shell_exec("mkdir -p '${d}/build/cache/s${string(i)}'")
            avra_shell_exec("head -c 1048576 /dev/zero > '${d}/build/cache/s${string(i)}/unit.ll'")
            // `touch -d '<n> hours ago'` is GNU-only: BSD/macOS touch has no
            // -d and cannot parse relative time, so on macOS the slots were
            // never aged and oldest-first eviction had no ordering to work
            // with. perl's utime takes an absolute epoch and behaves the same
            // on both hosts. (Same GNU-only class as `ar -D`, `touch -d @sec`
            // and the multi-line `awk -v` — t-y2i7.9.)
            avra_shell_exec("perl -e 'my $t = time - $ARGV[1] * 3600; utime $t, $t, $ARGV[0]' " +
                "'${d}/build/cache/s${string(i)}' ${string(i)}")
        }
    }
    0
}

fn total_mb(sb: string) -> int {
    let out = avra_shell_exec("du -sm '${sb}' 2>/dev/null | cut -f1").trim()
    if out == "" { 0 } else { int(out) }
}

spec "t-tit7: the size budget is GLOBAL — roots individually under the cap still evict when jointly over" {
    then "three 5MB roots against an 8MB budget shed down to at/under it" {
        let base = avra_shell_exec("pwd").trim()
        let sb = "${base}/build/spec_tit7_${string(avra_getpid())}"
        avra_shell_exec("rm -rf '${sb}'")
        let _ = seed_roots(sb)

        let before = total_mb(sb)
        // Each root is ~5MB — comfortably under an 8MB cap on its own, which is
        // why per-root semantics saw nothing to do. The TOTAL is ~15MB.
        let out = run_gc(base, sb, "8")
        let after = total_mb(sb)

        let ok = out.contains("exceeds the 8MB budget")
            && out.contains("across 3 root(s)")
            && before > 8
            && after <= 8
            && after < before
        avra_shell_exec("rm -rf '${sb}' '${sb}.gc.log'")
        ok
    }
}

spec "t-tit7: an under-budget total evicts nothing, and says so globally" {
    then "the same three roots against a 64MB budget keep every slot" {
        let base = avra_shell_exec("pwd").trim()
        let sb = "${base}/build/spec_tit7u_${string(avra_getpid())}"
        avra_shell_exec("rm -rf '${sb}'")
        let _ = seed_roots(sb)

        let before = total_mb(sb)
        let out = run_gc(base, sb, "64")
        let after = total_mb(sb)

        // The message must be the GLOBAL one — a per-root "nothing to evict"
        // printed once per root is what the old code said while being wrong.
        let ok = out.contains("under the 64MB budget, nothing to evict")
            && !out.contains("size cap evicted")
            && after == before
        avra_shell_exec("rm -rf '${sb}' '${sb}.gc.log'")
        ok
    }
}

spec "t-tit7: a budget smaller than the root count still evicts, and reports the shortfall" {
    // Raised in review of #1161. The proportional share is integer division, so
    // a small budget floors some roots to 0 — and `--max_size_mb=0` is the
    // DISABLED sentinel, not "keep nothing". Passed through, those roots would
    // keep their ENTIRE cache: the silent no-op this ticket exists to remove,
    // reappearing at exactly the caps an operator reaches for under pressure
    // (AVRA_CACHE_MAX_MB=3000 floors this tree's two smallest roots to 0).
    then "three 5MB roots against a 1MB budget shed to the 1MB-per-root floor" {
        let base = avra_shell_exec("pwd").trim()
        let sb = "${base}/build/spec_tit7f_${string(avra_getpid())}"
        avra_shell_exec("rm -rf '${sb}'")
        let _ = seed_roots(sb)

        let before = total_mb(sb)
        let out = run_gc(base, sb, "1")
        let after = total_mb(sb)

        // Every root evicts (the floor, not the sentinel), and because 3 roots
        // cannot fit a 1MB budget the run says so rather than claiming success.
        let ok = out.contains("exceeds the 1MB budget")
            && out.contains("still over the 1MB budget")
            // `>= 12`, not `> 12`: the seed writes exactly 12 x 1MB, and how
            // much `du -sm` adds for directory overhead is filesystem-
            // dependent — ext4 rounds this to 13, APFS reports exactly 12
            // (measured on both). The clause is here to say "the tree really
            // is far above a 1MB budget", which 12 satisfies; `> 12` was
            // asserting an ext4 accounting detail.
            && before >= 12
            && after < before
            && after <= 6
        avra_shell_exec("rm -rf '${sb}' '${sb}.gc.log'")
        ok
    }
}

spec "t-tit7: a malformed AVRA_CACHE_MAX_MB fails loudly instead of disabling the cap" {
    // `[ "$cap_mb" -gt 0 ]` on a non-numeric value fails the TEST, so before the
    // validation a typo silently skipped the whole size pass — enforcement off,
    // exit 0, no diagnostic. A knob that disables the guard when misspelled is
    // the same defect class as the per-root budget itself.
    then "AVRA_CACHE_MAX_MB=12G exits non-zero and names the variable" {
        let base = avra_shell_exec("pwd").trim()
        let sb = "${base}/build/spec_tit7b_${string(avra_getpid())}"
        avra_shell_exec("rm -rf '${sb}'")
        let _ = seed_roots(sb)

        let log = "${sb}.bad.log"
        let rc = avra_shell_exec_status(
            "cd '${base}' && AVRA_CACHE_MAX_MB=12G bash scripts/diagnose.sh --cache-gc 30 '${sb}' > '${log}' 2>&1")
        let out = avra_selfhost_read_file(log)
        let after = total_mb(sb)

        // Non-zero exit, a message naming the knob, and — the point — nothing
        // silently pruned under a cap that was never understood.
        let ok = rc != 0
            && out.contains("AVRA_CACHE_MAX_MB")
            // `>= 12` for the same filesystem-accounting reason as the spec
            // above: nothing was pruned, so the tree is still the full 12 x
            // 1MB the seed wrote. ext4 rounds that to 13, APFS to 12.
            && after >= 12
        avra_shell_exec("rm -rf '${sb}' '${log}'")
        ok
    }
}
