// t-kdyj.10: `bs2 test` must SAY, once and at the top, when the binary running
// the suite predates a compiler source.
//
// The failure this prevents: a rebase rewrites working-tree mtimes even when
// the resulting content is byte-identical, so the freshness probe reports
// `stale` (correctly, by its own rules — and `make build-quick` agrees, it
// relinks) and the suite reds with two failures that name nothing about
// rebasing: suite_bs2_guard_test, which exists to catch exactly "you are
// testing a binary that does not match your sources", plus a fixture that
// shells out to the same binary. Measured: bs2 built 08:09:28, mod.av rewritten
// by the rebase at 08:18:29, both failures cleared by a rebuild with no source
// change. The information was already in the tree; only the output lacked it.
//
// Driven against a SANDBOX source tree via the AVRA_DIAGNOSE_NO_MAIN sourcing
// hook, the same harness source_newer_than_test.av uses. That is not a
// convenience — the honest way to test this would be to back-date the real
// ./build/bs2, and mutating the suite's own compiler mid-run is precisely the
// mid-suite-rebuild hazard (t-gv3n) that the guard being reported on exists to
// prevent. Every path the reporter reads is overridden into the sandbox.

use @std.avrac.core.{avra_shell_exec}

/// Both cases share one sandbox builder, so the ONLY difference between the
/// fresh and stale runs is the target's mtime. Two separately-written scripts
/// would let an unrelated discrepancy masquerade as the signal.
fn sandbox_script(backdate_target: bool) -> string {
    let stamp = if backdate_target {
        // Strictly older than the sources, so `source_strictly_newer_than` is
        // unambiguously true — no same-second tie, which is deliberately NOT
        // the stale condition (t-kdyj.7).
        "touch -t 202001010000 \"$sandbox/bs2x\"\n"
    } else {
        // Target newer than every source: the fresh case.
        "touch \"$sandbox/bs2x\"\n"
    }
    "set -u\n" +
        "sandbox=$(mktemp -d)\n" +
        "mkdir -p \"$sandbox/cli\" \"$sandbox/lib\"\n" +
        "echo x > \"$sandbox/cli/a.av\"; echo y > \"$sandbox/lib/b.av\"\n" +
        "printf rt > \"$sandbox/runtime.c\"; printf wr > \"$sandbox/llvm_wrapper.c\"\n" +
        "touch -t 202001010001 \"$sandbox/cli/a.av\" \"$sandbox/lib/b.av\" \\\n" +
        "    \"$sandbox/runtime.c\" \"$sandbox/llvm_wrapper.c\"\n" +
        "printf bin > \"$sandbox/bs2x\"; chmod +x \"$sandbox/bs2x\"\n" +
        stamp +
        "AVRA_DIAGNOSE_NO_MAIN=1 source scripts/diagnose.sh\n" +
        // Every input the reporter reads, redirected into the sandbox — the
        // real tree must not participate in either direction.
        "CLI_SRC_DIR=\"$sandbox/cli\"; LIB_SRC_DIR=\"$sandbox/lib\"\n" +
        "RUNTIME_C=\"$sandbox/runtime.c\"; BOOTSTRAP_DIR=\"$sandbox\"\n" +
        "BS2=\"$sandbox/bs2x\"\n" +
        "echo \"BEGIN\"; mode_bs2_stale_report; echo \"END rc=$?\"\n" +
        "rm -rf \"$sandbox\"\n"
}

fn run_sandbox(backdate_target: bool) -> string {
    let script = sandbox_script(backdate_target)
    avra_shell_exec("bash -c '" + script.replace("'", "'\\''") + "' 2>&1")
}

/// Did the sandbox RUN? The script brackets its work with `BEGIN` and
/// `END rc=`, so output missing either sentinel means the run never reached
/// the reporter — it is not evidence about what the reporter printed.
///
/// This is t-fafu's first acceptance bullet, and it exists because the two
/// cases were indistinguishable. The observed failure was
/// `it tells the reader what to do about it`, which reads as "the reporter
/// dropped its advice line" and was nothing of the kind: `newest_source_entry`
/// had taken SIGPIPE and the reporter bailed before printing anything at all.
/// The investigation started from the wrong end because the output said so.
///
/// Used as the FIRST conjunct of every assertion over sandbox output, so
/// t-kdyj.5's conjunct naming reports `false: sandbox_ran(out)` — a diagnosis
/// — instead of a content mismatch against output that was never produced.
/// The captured bytes go to the shard log on the failing run, so a recurrence
/// is diagnosable from that run rather than needing a second one.
fn sandbox_ran(out: string) -> bool {
    if out.contains("BEGIN") && out.contains("END rc=") { return true }
    println("      [sandbox did not run] no BEGIN/END sentinels; captured "
        + string(out.length) + " byte(s): " + out)
    false
}

/// The last non-blank, non-comment line of the shell function opened by
/// `header`, trimmed. Used to assert a function's final statement without
/// depending on how its comments happen to wrap.
fn last_stmt_of(src: string, header: string) -> string {
    let after = src.split(header)
    if after.length < 2 { return "" }
    let body = after[1].split("\n}")[0]
    mut last = ""
    for raw in body.split("\n") {
        let line = raw.trim()
        if line != "" && !line.starts_with("#") { last = line }
    }
    last
}

spec "the runner says so when bs2 predates a compiler source (t-kdyj.10)" {
    given "a target strictly older than the sandbox sources" {
        then "it names both paths and both timestamps" {
            let out = run_sandbox(true)
            // The whole point is that the message is SELF-EXPLAINING: a reader
            // who has never seen this ticket must be able to act on it. So the
            // assertion is on the parts that carry meaning — the verdict, the
            // binary, the culprit source, and the instruction — not on an exact
            // string that would pin the wording and break on any rewording.
            // The parens are load-bearing: `&&` binds tighter than `||`, so
            // without them this reads as `(stale && bs2x && a.av) || b.av` —
            // an output containing only `b.av` would satisfy the whole
            // assertion with the other three clauses unevaluated.
            // The timestamps are asserted EXPLICITLY. Without them the spec's
            // own name ("names both paths and both timestamps") was a claim it
            // did not check — a report that dropped fmt_epoch entirely, or
            // emitted a raw epoch, passed. The sandbox pins both sides
            // (`touch -t 202001010000` on the target, `...0001` on the
            // sources), and fmt_epoch renders local time from a local-time
            // touch, so the round-trip is timezone-stable.
            sandbox_ran(out)
                && out.contains("[stale]")
                && out.contains("bs2x")
                && (out.contains("a.av") || out.contains("b.av"))
                && out.contains("(00:00:00)")
                && out.contains("(00:01:00)")
        }
        then "it tells the reader what to do about it" {
            let out = run_sandbox(true)
            sandbox_ran(out) && out.contains("rebuild before trusting this run")
        }
        // Reporting must never GATE. A non-zero rc here would propagate into
        // the runner's startup path, turning an advisory note into a failure.
        //
        // `END rc=0` doubles as this spec's own sentinel, so `sandbox_ran`
        // adds no coverage here — it splits the verdict. Without it a run that
        // died before the reporter and one that reported a non-zero rc are the
        // same red line; with it the first says `false: sandbox_ran(out)`.
        then "it still exits 0 — this reports, it does not gate" {
            let out = run_sandbox(true)
            sandbox_ran(out) && out.contains("END rc=0")
        }
    }
    given "a target newer than every sandbox source" {
        // The negative control. Without this the positive case above would be
        // satisfied by a reporter that prints unconditionally, which is a
        // guard that cannot fail.
        //
        // `sandbox_ran` leads here for the same reason it does above, and the
        // discrimination is sharper in this direction: a sandbox that never
        // ran produces no `[stale]` either, so it satisfies the FIRST clause of
        // the old assertion. The adjacency check caught it — but reported it as
        // "the output was not exactly BEGIN/END", which describes a reporter
        // that printed something. Leading with the sentinels separates
        // "did not run" from "ran and printed".
        then "it says nothing at all" {
            let out = run_sandbox(false)
            sandbox_ran(out)
                && !out.contains("[stale]")
                && out.contains("BEGIN\nEND rc=0")
        }
    }
    given "the scan's exit status under pipefail" {
        // t-fafu, the load-dependent silence. `newest_source_entry` ends with
        //
        //     compiler_source_paths | while read p; do … break; done
        //
        // and the `break` stops READING, so the still-writing producer can take
        // SIGPIPE and exit 141. This file runs under `set -o pipefail` (line
        // 12), which promotes that into the pipeline's status and therefore the
        // FUNCTION's — and the caller is `entry=$(…) || return 0`, so the
        // reporter bailed SILENTLY on a genuinely stale tree. Measured: 7
        // silent runs in 90 concurrent probes, 0 in 150 after the fix. It also
        // explains the two unexplained "no output" readings recorded on
        // t-kdyj.10.
        //
        // STRUCTURAL, not behavioural, and the limit is worth stating: the
        // trigger is scheduling pressure — whether the producer is still
        // running when the reader breaks — not anything the test can arrange.
        // Two constructions were tried and BOTH failed to discriminate: a
        // 400-source sandbox (producer fills the 64KB pipe buffer and exits
        // cleanly; ENTRY_RC=0 on 8/8 runs with the bug restored) and a plain
        // repeat of the small sandbox. A concurrent probe reproduces it at
        // only ~8%, so as a gate it would be flaky in the direction that
        // matters — passing while broken. Asserting the source shape is the
        // honest guard here, same idiom as --check-layout-boundary.
        then "both scan helpers end with an explicit `return 0`" {
            let src = avra_shell_exec("cat scripts/diagnose.sh")
            // Each helper's contract is "print the value, or print nothing";
            // neither ever signalled failure through its status, and every
            // caller distinguishes the two by testing for an empty string.
            //
            // Asserted by extracting each function BODY and checking its last
            // statement, rather than by matching the surrounding comment text.
            // A comment-matching assertion is hostage to line WRAPPING: the
            // first draft searched for "# is unaffected: …", which is correct
            // only because "The VALUE" happens to end the previous line. It
            // passed, and review still (reasonably) read it as a mismatch —
            // an assertion whose correctness depends on where a comment wraps
            // is one reflow away from silently inverting.
            // Same precondition discipline as `sandbox_ran`: `last_stmt_of`
            // answers "" for a source it could not find the header in AND for
            // one it never received, so an unreadable script would fail as a
            // content mismatch against a function it never looked at.
            src.contains("newest_source_entry() {")
                && src.contains("newest_source_mtime() {")
                && last_stmt_of(src, "newest_source_entry() {") == "return 0"
                && last_stmt_of(src, "newest_source_mtime() {") == "return 0"
        }
    }
}
