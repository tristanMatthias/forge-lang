// t-kdyj.1 — memory-aware admission control (@std.avrac.build.admission).
//
// WHY THIS EXISTS: the shard pool used to run at a fixed width picked by an
// operator (AVRA_JOBS), with an external watchdog SIGKILLing the run when the
// guess was wrong. The governor moves that decision inside the pool: admit
// the next unit only while it fits a byte budget, serialise as the graceful
// floor, ratchet the estimate from measurement, never kill. These specs pin
// the decision MATH at the numbers that actually broke (a single degraded
// shard is ~10GB while the estimate said ~1.8GB), because on a quiet box
// every plausible policy agrees and an end-to-end assertion proves nothing.
//
// The governor is pure state + integer math with an injected avail sample,
// so every regime is testable deterministically; the pool-level specs then
// prove the dispatch loop actually consults it.
//
// @@fixture-stateful@@ — the pool specs spawn real subprocesses; a transient
// hiccup must re-probe, not freeze as FAIL.

use @std.avrac.build.{governor_for, governor_width_only, pool_run_admitted,
                      admission_prior_path, read_admission_prior, persist_admission_prior}

spec "admission budget: growth regime stacks unrealized commitment" {
    given "a fresh governor (est 500MB, reserve 100MB, baseline 2000MB)" {
        then "with nothing in flight, a fitting unit is admitted" {
            let gov = governor_for(8, 500, 100, 2000)
            gov.budget_admits(2000, 0)
        }
        then "in-flight units still growing reserve their FULL estimate against the baseline" {
            // avail hasn't moved (units admitted but not yet allocating):
            // each in-flight unit stacks 500MB of unrealized commitment.
            let gov = governor_for(8, 500, 100, 2000)
            gov.budget_admits(2000, 1)          // 2000-100-500  >= 500
                && gov.budget_admits(2000, 2)   // 2000-100-1000 >= 500
                && !gov.budget_admits(2000, 3)  // 2000-100-1500 <  500
        }
        then "a burst cannot over-admit against one roomy sample" {
            // The same avail sample refuses the 4th unit even though, read
            // naively, 2000MB 'fits' four more 500MB units one at a time.
            let gov = governor_for(8, 500, 100, 2000)
            mut admitted = 0
            for k in 0..8 {
                if gov.budget_admits(2000, admitted) { admitted = admitted + 1 }
            }
            admitted == 3
        }
    }
}

spec "admission budget: realised regime budgets against live avail" {
    given "the same governor after its units' usage materialised" {
        then "commitment consumed by real usage stops double-counting" {
            // 2 units in flight, avail dropped 2000 -> 900: used (1100)
            // exceeds commitment (1000), so budget = live avail only.
            let gov = governor_for(8, 500, 100, 2000)
            gov.budget_admits(900, 2)           // 900-100 >= 500
        }
        then "a unit growing past its estimate throttles further admission" {
            let gov = governor_for(8, 500, 100, 2000)
            !gov.budget_admits(550, 2)          // 550-100 < 500
        }
    }
}

spec "admission budget: degraded inputs never wedge the pool" {
    given "unknown memory or no cost model" {
        then "unknown avail admits width-only (the pre-admission behaviour)" {
            let gov = governor_for(4, 500, 100, 0 - 1)
            gov.budget_admits(0 - 1, 3)
        }
        then "a zero estimate admits width-only" {
            let gov = governor_width_only(4)
            gov.budget_admits(50, 3)
        }
    }
}

spec "admission decisions: width cap, serial floor, deferral" {
    given "a governor with cap 2 (est 500MB, reserve 100MB, baseline 400MB)" {
        then "the width cap refuses regardless of memory" {
            let gov = governor_for(2, 500, 100, 100000)
            // A full pool is not a memory deferral, so no deferral counts.
            !gov.try_admit(100000, 2) && gov.deferrals == 0
        }
        then "the serial floor admits exactly one when nothing is in flight" {
            // 400MB avail can never fit est+reserve, but waiting with an
            // empty pool would deadlock — one unit is always admitted.
            let gov = governor_for(2, 500, 100, 400)
            gov.try_admit(400, 0) && gov.floor_admits == 1 && gov.peak_width == 1
        }
        then "with a unit in flight the same pressure defers instead" {
            let gov = governor_for(2, 500, 100, 400)
            !gov.try_admit(400, 1) && gov.deferrals == 1
        }
        then "the constrained line is once-per-run, not an episode edge" {
            // A pool under a budget steady-states AT its constrained width,
            // so ANY edge-triggered recovered/backing-off pairing flaps once
            // per reap/refill cycle (observed live: 37 pairs in nine dirs).
            // The flag latches on the first constrained decision and stays —
            // later admits and later deferrals add no lines, only tallies.
            let gov = governor_for(2, 500, 100, 400)
            let deferred = !gov.try_admit(400, 1)   // first constrained decision
            let latched = gov.constrained_logged
            let readmitted = gov.try_admit(5000, 1) // memory came back: width 2
            let serial = gov.try_admit(400, 0)      // a later serialised round
            deferred && latched && readmitted && serial
                && gov.constrained_logged && gov.peak_width == 2
        }
    }
}

spec "admission model correction: measurement ratchets the estimate" {
    given "a governor whose units outgrow their estimate" {
        then "observed per-unit usage raises the live estimate" {
            // 2 in flight consumed 4000MB total -> 2000MB each > 1800MB.
            let gov = governor_for(8, 1800, 0, 10000)
            gov.observe(6000, 2)
            gov.estimate_mb == 2000 && gov.corrections == 1
        }
        then "correction is asymmetric: instant up, gradual relaxation down" {
            // A transient spike must narrow immediately (safety) but must
            // not be a life sentence: monotone ratcheting collapsed width
            // for the REST of a long CI run after one inflated attribution.
            let gov = governor_for(8, 1800, 0, 10000)
            gov.observe(6000, 2)                    // 2000/unit -> ratchet up
            let up = gov.estimate_mb == 2000
            gov.observe(9000, 2)                    // 500/unit: floor is static 1800
            let relaxed = gov.estimate_mb == 1950   // (2000*3 + 1800) / 4
            mut i = 0
            while i < 20 { gov.observe(9000, 2) i = i + 1 }
            up && relaxed && gov.estimate_mb == 1800 && gov.corrections == 1
        }
        then "a quiet pool re-anchors the baseline (no drift attribution)" {
            // Page-cache/slab growth over a long run depresses MemAvailable
            // with the pool idle; that is the ENVIRONMENT, not our units.
            let gov = governor_for(8, 1800, 0, 10000)
            gov.observe(7000, 0)                    // quiet: re-anchor at 7000
            gov.observe(6500, 1)                    // used is 500, not 3500
            gov.baseline_avail_mb == 7000 && gov.estimate_mb == 1800
                && gov.observed_mb == 500
        }
        then "the corrected estimate narrows subsequent admissions" {
            let gov = governor_for(8, 1800, 6144, 16000)
            // At the static 1800MB estimate a 9856MB budget fits units wide...
            let roomy = gov.budget_admits(16000, 0)
            // ...then one degraded unit drives used to 10500MB: the reserve's
            // 6144MB is already budgeted, so 4356MB attributes to the unit...
            gov.observe(5500, 1)
            // ...and an admission the OLD estimate would have taken is now
            // refused. avail 9144 discriminates: used 6856 >= commitment, so
            // budget = 9144-6144 = 3000 — >= 1800 (stale: admit) but < 4356
            // (corrected: refuse). An avail where both estimates refuse would
            // pass this assertion without proving the ratchet changed anything.
            roomy && gov.estimate_mb == 4356 && !gov.budget_admits(9144, 1)
        }
        then "the reserve is not double-counted into the attribution" {
            // used 3000 with reserve 1000: the reserve already covers the
            // un-modelled consumers (fixture compiles, page cache), so only
            // 2000 attributes to the 2 units — 1000 each, not 1500. Measured
            // live: naive attribution ratcheted a ~1.8GB shard to 8442MB and
            // est+reserve then serialised a box the static model runs wide.
            let gov = governor_for(8, 500, 1000, 10000)
            gov.observe(7000, 2)
            gov.estimate_mb == 1000
        }
        then "usage within the reserve does not ratchet at all" {
            let gov = governor_for(8, 500, 1000, 10000)
            gov.observe(9200, 1)   // used 800 < reserve 1000
            gov.estimate_mb == 500 && gov.corrections == 0
        }
        then "min avail tracks the tightest sample" {
            let gov = governor_for(8, 1800, 0, 10000)
            gov.observe(6000, 1)
            gov.observe(8000, 1)
            gov.min_avail_mb == 6000
        }
    }
}

spec "admission priors: seeded estimates and unseeded measurement" {
    given "a governor seeded from a persisted prior" {
        then "the prior raises the estimate but never lowers it" {
            let gov = governor_for(8, 1800, 0, 10000)
            gov.seed_estimate(4500)
            let raised = gov.estimate_mb == 4500
            gov.seed_estimate(900)     // a prior below static is ignored
            raised && gov.estimate_mb == 4500
        }
        then "observed_mb measures THIS run, independent of the seed" {
            // Seeded to 4500 but the run measured 1000/unit: the pure
            // measurement records 1000 (what persists, so a shrunk workload
            // decays next run), and the live estimate begins relaxing from
            // the seed toward the evidence — one quarter of the gap to the
            // 1800 static floor: (4500*3 + 1800) / 4.
            let gov = governor_for(8, 1800, 0, 10000)
            gov.seed_estimate(4500)
            gov.observe(9000, 1)       // used 1000
            gov.estimate_mb == 3825 && gov.observed_mb == 1000
        }
    }
    given "the prior file lifecycle" {
        then "a measured peak above static persists and reads back" {
            let root = "/tmp/avra_admission_prior_${string(avra_getpid())}"
            let path = admission_prior_path(root, "k1")
            persist_admission_prior(path, 2500, 1800, true)
            let got = read_admission_prior(path)
            let _ = avra_shell_exec("rm -rf '${root}'")
            got == 2500
        }
        then "a measurement at/below static removes the prior (decay)" {
            let root = "/tmp/avra_admission_prior_${string(avra_getpid())}"
            let path = admission_prior_path(root, "k2")
            persist_admission_prior(path, 2500, 1800, true)
            persist_admission_prior(path, 900, 1800, true)
            let got = read_admission_prior(path)
            let _ = avra_shell_exec("rm -rf '${root}'")
            got == 0
        }
        then "an incomplete run neither decays nor overwrites the prior" {
            // A jetsam-killed shard died unmeasured: its run's observation is
            // not evidence of a lighter workload. Losing the prior there would
            // let the NEXT full run repeat the unsafe admission (review, #1102).
            let root = "/tmp/avra_admission_prior_${string(avra_getpid())}"
            let path = admission_prior_path(root, "k4")
            persist_admission_prior(path, 2500, 1800, true)
            persist_admission_prior(path, 900, 1800, false)   // no decay
            let kept = read_admission_prior(path)
            persist_admission_prior(path, 9999, 1800, false)  // no overwrite either
            let still = read_admission_prior(path)
            let _ = avra_shell_exec("rm -rf '${root}'")
            kept == 2500 && still == 2500
        }
        then "a missing or garbled prior reads as none" {
            let root = "/tmp/avra_admission_prior_${string(avra_getpid())}"
            let missing = read_admission_prior(admission_prior_path(root, "absent"))
            let garbled_path = admission_prior_path(root, "garbled")
            let _ = avra_shell_exec("mkdir -p \"$(dirname '${garbled_path}')\"")
            let _ = avra_shell_exec("printf 'est_mb:not-a-number\n' > '${garbled_path}'")
            let garbled = read_admission_prior(garbled_path)
            let _ = avra_shell_exec("rm -rf '${root}'")
            missing == 0 && garbled == 0
        }
    }
}

spec "admission summary reports the run's decisions" {
    given "a governor that deferred and corrected" {
        then "the summary names peak width, correction, and tallies" {
            let gov = governor_for(4, 500, 100, 2000)
            let _ = gov.try_admit(2000, 0)
            let _ = gov.try_admit(300, 1)     // defer
            gov.observe(1200, 1)              // used 800, reserve 100 -> ratchet 500 -> 700
            let s = gov.summary()
            s.contains("peak width 1/4")
                && s.contains("~500MB -> ~700MB (corrected)")
                && s.contains("1 deferral(s)")
        }
        then "an uneventful run reports a plain estimate" {
            let gov = governor_for(4, 500, 100, 100000)
            let _ = gov.try_admit(100000, 0)
            let s = gov.summary()
            s.contains("est ~500MB,") && !s.contains("corrected")
        }
    }
}

spec "admitted pool: the dispatch loop consults the governor" {
    given "real commands under an injected memory sample" {
        then "a roomy budget runs wide and propagates the worst rc" {
            let gov = governor_for(3, 100, 0, 100000)
            let rc = pool_run_admitted(["true", "false", "true"], gov, () -> 100000)
            rc == 1 && gov.peak_width > 0
        }
        then "a tight budget serialises and still completes everything" {
            // baseline == avail == 700: est 500 + reserve 100 fits ONE unit;
            // the second admission always sees 500MB of unrealized
            // commitment and defers until the first exits. Marker files
            // prove every command actually ran.
            let dir = "/tmp/avra_admission_pool_${string(avra_getpid())}"
            let _ = avra_shell_exec("rm -rf '${dir}' && mkdir -p '${dir}'")
            let gov = governor_for(3, 500, 100, 700)
            let cmds = [
                "sleep 0.2 && touch '${dir}/a'",
                "sleep 0.2 && touch '${dir}/b'",
                "touch '${dir}/c'",
            ]
            let rc = pool_run_admitted(cmds, gov, () -> 700)
            let ran = avra_shell_exec("ls '${dir}' | sort | tr '\n' ' '").trim()
            let _ = avra_shell_exec("rm -rf '${dir}'")
            rc == 0 && ran == "a b c" && gov.peak_width == 1 && gov.deferrals > 0
        }
    }
}

spec "one budget authority: admitted units carry their allocation (t-kdyj.1 slice 3)" {
    given "the allocation formula" {
        then "a serial admission gets its estimate plus the whole reserve" {
            let gov = governor_for(4, 1800, 6144, 15000)
            gov.allocation_mb(1) == 7944
        }
        then "width shares the reserve equally, never the estimate" {
            let gov = governor_for(4, 1800, 6144, 15000)
            gov.allocation_mb(4) == 1800 + 6144 / 4
        }
        then "a degenerate width clamps to serial" {
            let gov = governor_for(4, 1800, 6144, 15000)
            gov.allocation_mb(0) == 7944
        }
        then "a width-only governor exports nothing" {
            let gov = governor_width_only(8)
            gov.allocation_mb(1) == 0 && gov.slack_floor_mb() == 0
        }
        then "the slack floor is the run's reserve — one number, one meaning" {
            let gov = governor_for(4, 1800, 6144, 15000)
            gov.slack_floor_mb() == 6144
        }
    }
    given "the soft-grant trip decision (avra_mem_should_trip)" {
        then "under the limit never trips, hard or soft" {
            avra_mem_should_trip(500, 1000, 0, 0, 9999) == 0 &&
            avra_mem_should_trip(500, 1000, 1, 0, 9999) == 0
        }
        then "a hard ceiling trips on RSS alone — the pre-slice-3 contract" {
            avra_mem_should_trip(1000, 1000, 0, 999999, 0) == 1
        }
        then "an over-budget soft grant BORROWS while the box has slack" {
            // The CI regression this replaces: a cold whole-program fixture
            // child at ~6.7GB against a shard-sized grant, box roomy — must
            // keep running.
            avra_mem_should_trip(6900, 3300, 1, 8600, 6144) == 0
        }
        then "an over-budget soft grant trips under pressure" {
            avra_mem_should_trip(6900, 3300, 1, 5000, 6144) == 1
        }
        then "an unlimited ceiling never trips" {
            avra_mem_should_trip(99999, 0, 0, 0, 0) == 0
        }
    }
    given "a real pool run" {
        then "a modeled admission exports the budget and floor to the child, across a compound command — and never a hard LIMIT" {
            let dir = "/tmp/avra_admission_alloc_${string(avra_getpid())}"
            let _ = avra_shell_exec("rm -rf '${dir}' && mkdir -p '${dir}'")
            let inherited_lim = avra_process_env_get("AVRA_MEM_LIMIT_MB")
            // Serial (est 500 + reserve 100 vs avail 700): budget = 600,
            // floor = the reserve. `true &&` makes the command compound,
            // pinning the `export …;` form — a bare assignment prefix would
            // leave the tail of the chain ungoverned and this spec red.
            let gov = governor_for(2, 500, 100, 700)
            let rc = pool_run_admitted(
                ["true && echo \"budget=$AVRA_MEM_BUDGET_MB floor=$AVRA_MEM_SLACK_FLOOR_MB lim=[$AVRA_MEM_LIMIT_MB]\" > '${dir}/env'"],
                gov, () -> 700)
            let seen = avra_shell_exec("cat '${dir}/env' 2>/dev/null").trim()
            let _ = avra_shell_exec("rm -rf '${dir}'")
            rc == 0 && seen == "budget=600 floor=100 lim=[${inherited_lim}]"
        }
        then "a width-only pool leaves the child's environment untouched" {
            // The suite itself may run under an admitted shard whose
            // exported vars the child INHERITS — so assert the pool adds
            // nothing by comparing against this process's own values,
            // not against empty.
            let dir = "/tmp/avra_admission_noalloc_${string(avra_getpid())}"
            let _ = avra_shell_exec("rm -rf '${dir}' && mkdir -p '${dir}'")
            let inherited = avra_process_env_get("AVRA_MEM_LIMIT_MB")
            let gov = governor_width_only(2)
            let rc = pool_run_admitted(
                ["echo \"lim=[$AVRA_MEM_LIMIT_MB]\" > '${dir}/env'"],
                gov, () -> 0 - 1)
            let seen = avra_shell_exec("cat '${dir}/env' 2>/dev/null").trim()
            let _ = avra_shell_exec("rm -rf '${dir}'")
            rc == 0 && seen == "lim=[${inherited}]"
        }
    }
    given "the fixture-slot machinery consumes the exported budget" {
        then "AVRA_MEM_BUDGET_MB sizes the pool instead of MemTotal" {
            let two = avra_shell_exec("AVRA_MEM_BUDGET_MB=5800 bash scripts/diagnose.sh --print-compile-slots").trim()
            let one = avra_shell_exec("AVRA_MEM_BUDGET_MB=2000 bash scripts/diagnose.sh --print-compile-slots").trim()
            two == "2" && one == "1"
        }
        then "an unset or malformed budget falls back to the box-wide sizing" {
            // env -u: the suite may itself run under an exported budget
            // (the feature working); the fallback branch needs a genuinely
            // unset variable to be observable.
            let unset_out = avra_shell_exec("env -u AVRA_MEM_BUDGET_MB bash scripts/diagnose.sh --print-compile-slots").trim()
            let junk_out = avra_shell_exec("AVRA_MEM_BUDGET_MB=abc bash scripts/diagnose.sh --print-compile-slots").trim()
            unset_out != "" && junk_out == unset_out
        }
    }
}

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_getpid() -> int
extern fn avra_process_env_get(name: string) -> string
extern fn avra_mem_should_trip(rss_kb: int, limit_kb: int, soft: int, avail_kb: int, floor_kb: int) -> int
