// t-drl0 — the PROCESS-WIDE sibling of the per-fold comptime memory budget
// (features/comptime/tests/comptime_mem_budget_test.av).
//
// WHY THIS EXISTS: a runaway anywhere in the compiler — a quadratic re-lex, a
// pathological monomorphization, an unbounded collection outside a comptime fold
// — used to end as a kernel SIGKILL. On a small box that frequently took the
// whole container with it, so the failure was not just fatal but UNDIAGNOSABLE:
// no message, no phase, no exit code worth reading. The compiler now polls its
// own RSS from the allocation hot paths and stops itself first, with an F4014
// naming the ceiling, the measured resident size, and the phase it died in.
//
// The ceiling is AVRA_MEM_LIMIT_MB (default: the HIGHER of 90% of MemAvailable at
// startup and 75% of MemTotal; 0 disables). These specs force it low so the trap
// fires in milliseconds, and force it high to prove ordinary compiles don't
// false-trip.
//
// The large input is a REAL file from the compiler's own source rather than a
// generated fixture. Generating one in-process was a trap twice over: `{` opens
// an interpolation in an ordinary string (so the obvious fixture builder emits
// no braces at all and yields a few bytes of nonsense), and string `+` copies,
// so a loop long enough to matter makes the TEST BINARY the memory hog instead
// of the compiler under test.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_process_env_get(name: string) -> string
extern fn avra_parse_int(s: string) -> int

/// A checked-in source file large enough that parsing it costs well over
/// 100 MiB — the compiler's generated parser.
const BIG_FILE: string = "packages/std-avrac/src/parse/gen_parser.av"
/// A trivially small one, for the no-false-trip direction.
const SMALL_FILE: string = "packages/std-avrac/src/parse/gen_keyword_scanner.av"

/// Compile-check `file` with the process memory ceiling forced to `mb` MiB.
/// `timeout` bounds a regression (guard removed → a genuine OOM/hang) so it
/// fails loudly instead of wedging the suite.
fn check_with_mem_limit(mb: string, file: string) -> string {
    avra_shell_exec("AVRA_MEM_LIMIT_MB=${mb} timeout 300 ./build/bs2 check '${file}' 2>&1 || true")
}

spec "t-drl0: the compiler bounds its own memory instead of being OOM-killed" {
    then "a compile past the ceiling reports F4014, not a signal death" {
        let out = check_with_mem_limit("1", BIG_FILE)
        out.contains("F4014") && out.contains("memory ceiling exceeded")
    }
    then "the report always names a PHASE, so the failure is attributable" {
        // A 1 MiB ceiling trips on the first poll, which lands during start-up —
        // before any pass has stamped itself. That window must still report a
        // phase (the seeded default) rather than a bare byte count.
        let out = check_with_mem_limit("1", BIG_FILE)
        out.contains("phase:")
    }
    then "a ceiling above start-up RSS attributes the trip to the PARSE phase" {
        // Comfortably above the ~50 MiB start-up baseline and comfortably below
        // what parsing this file reaches, so the trip is attributable to the
        // input rather than to start-up — and names the file being read.
        let out = check_with_mem_limit("150", BIG_FILE)
        out.contains("phase: parse ") && out.contains("gen_parser.av")
    }
    then "the report states the ceiling it enforced, so it can be raised" {
        let out = check_with_mem_limit("1", BIG_FILE)
        out.contains("AVRA_MEM_LIMIT_MB")
    }
    then "an ordinary compile UNDER the ceiling is untouched (no false trip)" {
        let out = check_with_mem_limit("8192", SMALL_FILE)
        !out.contains("F4014")
    }
    then "AVRA_MEM_LIMIT_MB=0 disables the ceiling entirely" {
        let out = check_with_mem_limit("0", BIG_FILE)
        !out.contains("F4014")
    }
}

// uzs9 (2026-08-01): the phase label alone cannot distinguish "this input is
// enormous" from "the total accumulated and this input happened to be next" —
// and it reads as the former either way. 28 of 31 trips on a 16GB box named the
// same generated parser, which looked exactly like a single-input blowup; probes
// then peaked in the same band on base AND branch compilers, so the named file
// was never the cause. The report now carries the delta that tells them apart.
//
// Both specs assert against a REAL trip rather than the arithmetic, because the
// thing that can regress is the sampling (a baseline stamped at the wrong moment
// reads as zero growth), not the subtraction.
spec "the F4014 report separates in-phase growth from what preceded it" {
    then "the report states the growth and the baseline it grew from" {
        let out = check_with_mem_limit("150", BIG_FILE)
        out.contains("in-phase growth: +") && out.contains("already resident when this phase began")
    }
    then "a phase that DID consume the memory is not second-guessed" {
        // Ceiling 150 against a ~52 MiB baseline: parsing this file really is
        // responsible for the bulk, so the accumulation note must stay silent.
        // Without this direction the note could fire unconditionally and still
        // look right in the failing case it was written for.
        let out = check_with_mem_limit("150", BIG_FILE)
        out.contains("in-phase growth: +") && !out.contains("memory ACCUMULATED")
    }
    then "a phase that did NOT consume the memory says so" {
        // Ceiling just above the ~52 MiB start-up baseline, so the trip lands
        // early in the parse: the phase adds single-digit MiB of a total that is
        // mostly start-up. That is the accumulation shape in miniature — the
        // same reading as a shard that grew across 200 files and blamed the
        // 201st.
        let out = check_with_mem_limit("60", BIG_FILE)
        out.contains("memory ACCUMULATED") && out.contains("not what consumed it")
    }
    then "the help no longer asserts the phase is where the memory went" {
        // The old help said exactly that, which is the misattribution this work
        // exists to correct; it now points at the growth line instead.
        let out = check_with_mem_limit("1", BIG_FILE)
        !out.contains("is where the memory went")
    }
}

// t-d91l — the SOFT-grant trip backs off before it fires. A soft trip's
// pressure floor reads the NEIGHBOURS (a sibling shard peaking), and such
// troughs routinely pass; killing a legitimate over-grant borrower at the
// first sub-floor sample turned transient co-scheduling into deterministic
// spec failure (the ~9.6 GiB whole-program fold fixture against an inherited
// ~2 GiB shard grant — twice on one CI head). The borrower now HOLDS
// allocation and re-samples for a bounded window, resuming on recovery.
//
// The trip-after-wait and instant-trip directions are end-to-end below,
// status-aware (avra_shell_exec_status + a per-run log, the slot_gate_test
// idiom): the trip legs assert the child DIED (rc != 0) and the borrow leg
// asserts a CLEAN exit (rc == 0), so a timeout or unrelated failure cannot
// satisfy them vacuously. `timeout 60` on every command doubles as the
// silent-wait regression bound — a path that wrongly waited the 60 s default
// gets killed by timeout and fails the F4014 assertion. The RECOVERY
// direction (condition clears mid-wait → resume) has no end-to-end leg by
// the same reasoning as the pure-policy specs above: this box cannot be made
// to recover on cue, and the loop's per-iteration decision is
// avra_mem_should_trip on fresh readings — already pinned pure. The loop's
// own new state is the bound, pinned EXACTLY below (300 ms in, 300 ms
// reported — the slice-clamped sleep makes the duration deterministic).
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_selfhost_read_file(path: string) -> string
extern fn avra_getpid() -> int

use @std.avrac.test_runner.{write_fixture}

fn soft_trip_status(floor_mb: string, wait_ms: string, log: string) -> int {
    // env -u guards: the suite's own pool exports a budget and tests may run
    // under an explicit limit; both would repoint the path under test.
    // AVRA_MEM_HOLD_MARGIN_MB=999999 disables the RELEASE VALVE for these
    // legs: on a shared box a NEIGHBOUR's allocations can legitimately fall
    // past the default margin mid-wait, flipping the trip to the DEEPENING
    // exit (observed on CI: the trip leg's 'pressure never lifted' assertion
    // failed because a sibling shard was allocating during the 300 ms
    // window). The budget exit is only deterministic with the valve out of
    // reach; the valve's own boundary is pinned pure above.
    avra_shell_exec_status("env -u AVRA_MEM_LIMIT_MB AVRA_MEM_BUDGET_MB=150 AVRA_MEM_SLACK_FLOOR_MB=${floor_mb} AVRA_MEM_SOFT_WAIT_MS=${wait_ms} AVRA_MEM_HOLD_MARGIN_MB=999999 timeout 60 ./build/bs2 check '${BIG_FILE}' > '${log}' 2>&1")
}

fn backoff_log(tag: string) -> string {
    "/tmp/avra_mem_backoff_${string(avra_getpid())}_${tag}.log"
}

spec "t-d91l: a soft grant under the pressure floor backs off before tripping" {
    then "pressure that never lifts still trips F4014 — after EXACTLY the configured back-off" {
        // Floor forced astronomically high: the pressure condition is
        // permanently true, so recovery is impossible and the bound is what
        // fires. The report must carry the back-off DURATION — the reader's
        // tell between a transient trough and a genuine cliff — and it must
        // be the configured 300 ms, not a rounded-up overshoot, so a
        // regression that ignores AVRA_MEM_SOFT_WAIT_MS cannot pass.
        let log = backoff_log("trip")
        let rc = soft_trip_status("9999999", "300", log)
        let out = avra_selfhost_read_file(log)
        rc != 0 && out.contains("F4014")
            && out.contains("backed off: held allocation 300 ms")
            && out.contains("pressure never lifted")
    }
    then "AVRA_MEM_SOFT_WAIT_MS=0 keeps the instant trip — and no back-off line" {
        let log = backoff_log("instant")
        let rc = soft_trip_status("9999999", "0", log)
        let out = avra_selfhost_read_file(log)
        rc != 0 && out.contains("F4014") && !out.contains("backed off:")
    }
    then "with slack above the floor an over-grant compile still just borrows — clean exit, no trip" {
        // The pre-existing borrowing semantics, as the control: floor forced
        // to 1 MiB so availability always clears it. rc == 0 is the
        // non-vacuity half — a timeout or unrelated failure cannot pass this
        // as 'no F4014'. The input must therefore standalone-check CLEAN
        // (BIG_FILE cannot: an in-package module's relative imports don't
        // resolve standalone — its rc is 1 for reasons unrelated to memory),
        // so this leg checks a tiny self-contained program against a 1 MiB
        // grant — over-grant from the first allocation, borrowing throughout.
        let src = "/tmp/avra_mem_backoff_${string(avra_getpid())}_ok.av"
        write_fixture(src, "fn main() {\n    println(\"ok\")\n}\n")
        let log = backoff_log("borrow")
        let rc = avra_shell_exec_status("env -u AVRA_MEM_LIMIT_MB AVRA_MEM_BUDGET_MB=1 AVRA_MEM_SLACK_FLOOR_MB=1 AVRA_MEM_SOFT_WAIT_MS=300 timeout 60 ./build/bs2 check '${src}' > '${log}' 2>&1")
        let out = avra_selfhost_read_file(log)
        rc == 0 && !out.contains("F4014")
    }
    then "a HARD explicit limit is untouched by the wait knob — instant, no back-off line" {
        // The back-off must not give a runaway under a user-set quota a
        // minute of grace; the hard path bypasses the loop entirely. The
        // `timeout 60` bounds the regression where the wait wrongly applied:
        // a 60 s hold would be killed mid-wait and fail the F4014 assertion.
        let log = backoff_log("hard")
        let rc = avra_shell_exec_status("AVRA_MEM_LIMIT_MB=1 AVRA_MEM_SOFT_WAIT_MS=60000 timeout 60 ./build/bs2 check '${BIG_FILE}' > '${log}' 2>&1")
        let out = avra_selfhost_read_file(log)
        rc != 0 && out.contains("F4014") && !out.contains("backed off:")
    }
}

/// The AVRA_MEM_SOFT_WAIT_MS parse policy, pure (the avra_mem_ceiling_for
/// pattern): the complete value must be a valid integer or the default
/// stands. Pinned directly because the cached env read is per-process — a
/// spec cannot vary its own process's env after first use — and because the
/// dangerous outcomes are silent: a prefix parse ("300ms" → 300) or a typo
/// parsed to 0 would quietly DISABLE the back-off this knob configures.
extern fn avra_mem_soft_wait_parse(s: string) -> int

/// The back-off's RELEASE VALVE, pure: may a borrower keep holding at this
/// fresh MemAvailable reading, given the hold's high-water mark? Pinned at
/// the numbers that killed three CI runs: back-off v1 held unconditionally,
/// so two over-grant shards sat on ~4.6 GiB while the ~7 GiB @std prebuild
/// kept allocating — the kernel OOM-killer then took the RUNNER (exit 143,
/// "shutdown signal", three consecutive runs, same suite phase). Holding is
/// legitimate only while the box holds steady or recovers; a net fall past
/// the 256 MiB jitter margin means a neighbour is allocating into the hole
/// and the borrower must yield NOW — the pre-back-off release valve,
/// restored inside the wait loop.
extern fn avra_mem_hold_is_safe(high_water_kb: int, avail_kb: int, margin_kb: int) -> int

const VALVE_MARGIN_KB: int = 262144

spec "t-d91l: the back-off holds only while the box is not deteriorating (the release valve)" {
    then "steady or recovering availability keeps the hold legitimate" {
        // Flat, above, and within-jitter readings all hold: the trough has
        // bottomed — the exact t-d91l shape the back-off exists to ride.
        avra_mem_hold_is_safe(1536000, 1536000, VALVE_MARGIN_KB) == 1
            && avra_mem_hold_is_safe(1536000, 1800000, VALVE_MARGIN_KB) == 1
            && avra_mem_hold_is_safe(1536000, 1536000 - 262144, VALVE_MARGIN_KB) == 1
    }
    then "a net fall past the jitter margin yields — the neighbour is still allocating" {
        // One KiB past the 256 MiB margin flips it: the valve is a boundary,
        // not a vibe. At the eviction's own numbers (high water ~1.5 GiB,
        // the prebuild still climbing), the fall crosses this within a few
        // 100 ms samples — the borrower dies an attributable F4014 instead
        // of the runner dying an unattributable exit 143.
        avra_mem_hold_is_safe(1536000, 1536000 - 262145, VALVE_MARGIN_KB) == 0
            && avra_mem_hold_is_safe(1536000, 500000, VALVE_MARGIN_KB) == 0
    }
}

spec "t-d91l: the wait knob parses completely or falls back to the default" {
    then "a complete integer is taken verbatim; negatives clamp to the explicit instant-trip 0" {
        avra_mem_soft_wait_parse("300") == 300
            && avra_mem_soft_wait_parse("0") == 0
            && avra_mem_soft_wait_parse("-5") == 0
    }
    then "a prefix parse, a typo, or an out-of-range value falls back to the 60 s default — never a silent other value" {
        // The last case is one past INT64_MAX: strtoll's ERANGE branch.
        avra_mem_soft_wait_parse("300ms") == 60000
            && avra_mem_soft_wait_parse("oops") == 60000
            && avra_mem_soft_wait_parse("") == 60000
            && avra_mem_soft_wait_parse("9223372036854775808") == 60000
    }
}

/// The ceiling this process would enforce, in KiB (0 = disabled).
extern fn avra_mem_limit_kb() -> int

/// The ceiling POLICY, as a pure fn of (MemAvailable, MemTotal) in KiB.
///
/// Tested directly rather than end to end, because the failure is a property of
/// the INPUTS and this box does not supply them: on a quiet machine
/// MemAvailable is high, every plausible policy agrees, and an end-to-end
/// assertion passes just as happily against the derivation that broke. Feeding
/// the numbers from the CI failure is the only way to make the guard able to
/// fail.
extern fn avra_mem_ceiling_for(avail_kb: int, total_kb: int) -> int

// The measured CI failure, in KiB: a 16 GiB runner whose MemAvailable had dipped
// to ~3.8 GiB while sibling shards held memory.
const CI_AVAIL_KB: int = 3915776      // ~3.73 GiB — the reading that produced 3441 MiB
const CI_TOTAL_KB: int = 16777216     // 16 GiB
// What compiling the whole compiler actually peaks at, in KiB — MEASURED, by polling
// RSS with the ceiling disabled over
//
//     AVRA_MEM_LIMIT_MB=0 AVRA_USE_METADATA=1 AVRA_LIB_PKG_ROOT='@std::avrac' \
//       bs2 compile --emit_metadata --module_path='@std::avrac' src/avrac.av
//
// 7064 MiB on the integration compiler, 6978 MiB on the branch's; a CI runner
// reached 7997 MiB before the ceiling stopped it. The CI figure is the one of record
// because it is the highest OBSERVED, and because the ceiling has to survive the
// environment that actually runs it.
//
// This constant was previously 3525632 (3443 MiB) and that was the bug. It was read
// off an F4014 report's "3443 MiB resident" line, which is the size the process had
// reached when the ceiling KILLED it — a lower bound on the peak, taken for the peak
// itself. Every margin computed against it was therefore fiction. If you update this
// number, MEASURE it with the ceiling disabled; never harvest it from a trip report.
const WHOLE_COMPILER_PEAK_KB: int = 8188928   // 7997 MiB, measured on CI

spec "the DEFAULT ceiling is floored against MemTotal, not left to a load-time dip" {
    then "the default ceiling is at least three quarters of MemTotal" {
        // The default was 90% of MemAvailable sampled ONCE at startup. Under a
        // parallel build that samples the NEIGHBOURS: a child starting while sibling
        // shards hold memory bakes a low ceiling for its whole life, even as they
        // finish and the memory comes back. In CI that produced
        //
        //     error[F4014]: compiler memory ceiling exceeded
        //                   — 3443 MiB resident (ceiling 3441 MiB)
        //       phase: parse src/typeck/typeenv_cache.av
        //
        // on `bs2 build --lib` for @std/avrac: 3441 MiB is 90% of a transiently-low
        // ~3.8 GiB reading, so the ceiling landed UNDER a known-good build. It took
        // several CI runs to even see, because the build's ARTIFACTS were all fine
        // (cache hits) and only its exit code was wrong.
        //
        // MemTotal does not move under load, so the ceiling floors against it — at
        // THREE QUARTERS, not half. Half was the first attempt, and it failed the
        // same way one octave up (7997 MiB resident against a 7994 MiB ceiling),
        // because the peak it was sized against had been harvested from a trip
        // report rather than measured; see WHOLE_COMPILER_PEAK_KB.
        //
        // Asserted against /proc/meminfo rather than a baked constant so the guard
        // travels to whatever box it runs on; skipped where MemTotal is unreadable
        // (non-Linux), since the floor is only derivable there.
        //
        // NOTE: this spec must not run under a forced AVRA_MEM_LIMIT_MB — an
        // explicit setting legitimately wins over the floor (the specs above depend
        // on that, and would go vacuous otherwise), so a forced value here would
        // make this assertion measure the wrong thing.
        default_ceiling_clears_memtotal_floor()
    }
    then "at the EXACT numbers that broke CI, the ceiling clears the build's peak" {
        // The regression, stated as the property that failed. Under the old
        // derivation this is 90% of 3.73 GiB = 3441 MiB, which is BELOW the ~3.4 GiB
        // a legitimate whole-compiler build reaches — so the build died. This is the
        // assertion that goes red if the floor is removed.
        let ceiling = avra_mem_ceiling_for(CI_AVAIL_KB, CI_TOTAL_KB)
        let ok = ceiling > WHOLE_COMPILER_PEAK_KB
        if !ok {
            println("ceiling ${string(ceiling)} KiB does not clear the whole-compiler peak ${string(WHOLE_COMPILER_PEAK_KB)} KiB")
        }
        ok
    }
    then "and the OLD availability-only policy would NOT have — so that guard can fail" {
        // Non-vacuity, pinned rather than asserted in a commit message. The old
        // derivation yields (3915776/10)*9 = 3524198 KiB = 3441 MiB, against a peak
        // of 3525632 KiB = 3443 MiB — the exact pair the CI diagnostic reported:
        //
        //     — 3443 MiB resident (ceiling 3441 MiB)
        //
        // So the previous spec is decided by a ~1.4 MiB margin that falls the wrong
        // way without the floor. Delete the floor and it goes red; this `then` is
        // what proves that, and it keeps proving it as the constants evolve.
        let old_policy = (CI_AVAIL_KB / 10) * 9
        !(old_policy > WHOLE_COMPILER_PEAK_KB)
    }
    then "a dip in MemAvailable cannot drag the ceiling below three quarters of MemTotal" {
        // The floor, in isolation and at its extreme: availability near zero.
        avra_mem_ceiling_for(1, CI_TOTAL_KB) == (CI_TOTAL_KB / 4) * 3
    }
    then "the floor clears the MEASURED peak with real margin, not a rounding error" {
        // The assertion that would have caught the half-of-total floor. At the CI
        // numbers the ceiling was 7994 MiB against a build that reaches 7997 MiB —
        // it "cleared" a peak of 3443 MiB only because that number was a trip
        // report, not a measurement. Demand a margin big enough that environment
        // variance cannot decide the outcome: half the peak again.
        let ceiling = avra_mem_ceiling_for(CI_AVAIL_KB, CI_TOTAL_KB)
        let want = WHOLE_COMPILER_PEAK_KB + WHOLE_COMPILER_PEAK_KB / 2
        let ok = ceiling >= want
        if !ok {
            println("ceiling ${string(ceiling)} KiB leaves too little over the measured peak ${string(WHOLE_COMPILER_PEAK_KB)} KiB (want >= ${string(want)})")
        }
        ok
    }
    then "and the SUPERSEDED half-of-total floor would NOT have — so that guard can fail" {
        // Non-vacuity for the assertion above, and the record of what went wrong:
        // half of 16 GiB is 8388608 KiB (7994 MiB after the MiB rounding the
        // diagnostic prints), against a measured 8188928 KiB. It clears the peak by
        // under 2.5%, and on the runner it did not clear it at all.
        let old_floor = CI_TOTAL_KB / 2
        !(old_floor >= WHOLE_COMPILER_PEAK_KB + WHOLE_COMPILER_PEAK_KB / 2)
    }
    then "on a QUIET box availability still wins — the floor is a floor, not a cap" {
        // Otherwise the fix would have capped every build at half the box, which is
        // the opposite failure: a 16 GiB machine with 15 GiB free must still allow
        // ~13.5 GiB, not 8 GiB. (snw0's whole-program shard peaks at ~11.4 GiB and
        // would have started false-tripping.)
        let quiet_avail = 15728640          // 15 GiB free on a 16 GiB box
        avra_mem_ceiling_for(quiet_avail, CI_TOTAL_KB) == (quiet_avail / 10) * 9
    }
    then "an unknown MemTotal degrades to the availability-only rule" {
        // Non-Linux / unreadable /proc: no floor is derivable, so the policy must
        // fall back rather than produce a 0 ceiling and silently disable itself.
        let quiet_avail = 15728640
        avra_mem_ceiling_for(quiet_avail, 0) == (quiet_avail / 10) * 9
    }
}

/// True when the process-wide ceiling is at least three quarters of MemTotal — or when
/// the floor is not derivable/applicable here, in which case there is nothing
/// to assert. A helper fn rather than inline branches because an early `return`
/// inside a `then` block is F0901 (it would exit the whole file's initializer
/// and silently drop every later test).
fn default_ceiling_clears_memtotal_floor() -> bool {
    let total_kb_s = avra_shell_exec("awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null").trim()
    // MemTotal unreadable (non-Linux): the floor is only derivable there.
    if total_kb_s == "" { return true }
    // An explicit setting legitimately wins over the floor, so under a forced
    // AVRA_MEM_LIMIT_MB this assertion would measure the wrong thing.
    if avra_process_env_get("AVRA_MEM_LIMIT_MB") != "" { return true }
    // Same vacuity rule for a pool-exported soft grant (t-kdyj.1 slice 3):
    // under AVRA_MEM_BUDGET_MB the limit IS the grant — the budget authority
    // working as designed, not a defaulting bug. The default derivation
    // itself stays pinned by the pure avra_mem_ceiling_for specs above.
    if avra_process_env_get("AVRA_MEM_BUDGET_MB") != "" { return true }
    let floor_kb = (avra_parse_int(total_kb_s) / 4) * 3
    let got_kb = avra_mem_limit_kb()
    if got_kb < floor_kb {
        println("default ceiling ${string(got_kb)} KiB is below the MemTotal floor ${string(floor_kb)} KiB")
        return false
    }
    true
}
