// WHY: per-unit fingerprint computation.
//
// A fingerprint is a deterministic, collision-resistant 64-char hex
// digest derived from every input that, if changed, should force the
// unit to rebuild. The build cache uses fingerprints as keys: hit =>
// reuse the cached .ll/.o; miss => recompile.
//
// Inputs that participate in the fingerprint, per
// docs/spec_build_manifest.md:
//
//   1. All source files in the unit (each file's contents)
//   2. The compiler binary's own hash (so a new bs2 invalidates)
//   3. Profile flags (opt_level, debug, overflow_checks, coverage)
//   4. Target triple (e.g. arm64-apple-darwin)
//   5. Transitive dep fingerprints (a dep's rebuild forces ours)
//
// The function is pure: same inputs => same digest. No timestamps,
// no PIDs, no machine-specific paths. That property is what makes the
// cache shareable across machines and reproducible across runs.

use @std.crypto.{sha256_hex, sha256_file}
use core.{
    avra_selfhost_file_exists,
    avra_shell_exec,
    avra_pkg_fp_cache_get,
    avra_pkg_fp_cache_set,
    avra_selfhost_get_arg_cstr,
}
use build.graph.{build_graph, Unit}

/// A computed fingerprint. Wraps the raw 64-char hex string so the
/// type signature surfaces "this is a fingerprint, not just any hash"
/// and so equality / display behave consistently.
export type Fingerprint = {
    hex: string,
}

/// Build the fingerprint for a unit.
///
/// `sources` is the list of source-file paths that belong to the
/// unit, in canonical (stable) order — typically sorted alphabetically
/// by the caller. Order matters: a different order produces a
/// different fingerprint, even with identical contents. Callers are
/// responsible for sorting if they want a path-order-insensitive key.
///
/// `compiler_hash` is the hex digest of the compiler binary that
/// will produce the artifact. Use `compiler_hash_for(path)` to compute
/// it once per build.
///
/// `profile_key` is a canonical, deterministic string capture of the
/// build profile (e.g. "dev|opt=0|dbg=1|ovf=1|cov=0"). Use
/// `profile_key_of(...)` to produce it.
///
/// `target_triple` is the build target (e.g. "arm64-apple-darwin").
///
/// `dep_fps` is the list of transitive dep fingerprints, in canonical
/// (typically dependency-sorted) order.
export fn fp_for_unit(
    unit_name: string,
    sources: List<string>,
    compiler_hash: string,
    profile_key: string,
    target_triple: string,
    lib_root: string,
    dep_fps: List<string>,
) -> Fingerprint {
    // Compose a canonical input. Each section is prefixed with its
    // role so two distinct inputs cannot accidentally hash the same:
    // e.g. an empty `sources` list and an empty `dep_fps` list must
    // not collide. Length prefixes on each entry close the canonical-
    // join hole where "ab|c" and "a|bc" hash the same.
    mut composed = "avra/build/fp v1\n"
    composed = composed + "unit:" + unit_name + "\n"
    composed = composed + "compiler:" + compiler_hash + "\n"
    composed = composed + "profile:" + profile_key + "\n"
    composed = composed + "target:" + target_triple + "\n"
    // Library mode emits ONLY symbols owned by `lib_root`, so it's a build
    // input: the same sources under root A vs B (or "" whole-program) yield
    // different objects and must not share a cache slot.
    composed = composed + "lib_root:" + lib_root + "\n"

    composed = composed + "sources:\n"
    composed = composed + each_with_count(sources, "src")
    composed = composed + "deps:\n"
    composed = composed + each_with_count(dep_fps, "dep")

    Fingerprint { hex: sha256_hex(composed) }
}

/// Hash a list of paths-or-strings into a length-prefixed canonical
/// form. Used for both source files (where the entry is the file's
/// content hash) and transitive dep fingerprints (where the entry is
/// the dep's already-computed hex digest).
///
/// Iteration is a plain index walk over the built-in List<string>
/// (O(1) random access), no need for the mutable-cursor + match
/// shape the prior linked-list StrList required.
fn each_with_count(items: List<string>, kind: string) -> string {
    mut out = "  count=" + string(items.length) + "\n"
    mut idx = 0
    while idx < items.length {
        let s = items[idx]
        let entry = if kind == "src" { hash_source_entry(s) } else { s }
        out = out + "  [" + string(idx) + "]" + string(entry.length) + ":" + entry + "\n"
        idx = idx + 1
    }
    out
}


/// For a source entry: hash the file's content (so we don't bake the
/// raw content into the canonical-input string, which would balloon
/// the hash payload to whole-source-tree sizes). Missing files hash
/// as empty input — same digest as any other empty file. The build
/// driver should fail before this point if a declared source is
/// missing; this function is permissive so fingerprints stay
/// computable even mid-edit.
///
/// Fast-path for the `@@fp:<hex>` synthetic sentinel. The test-runner
/// orchestrator pre-computes a "universe fingerprint" rolling up
/// every shared input (@std/* tree, reporter, runtime objs) and
/// passes it as one synthetic path in the sources list. Each shard
/// then skips ~280 sidecar reads — the universe FP changes only when
/// shared inputs do, so cache invalidation semantics stay correct.
/// Hkms.1.1 perf pass.
fn hash_source_entry(path: string) -> string {
    let sentinel = "@@fp:"
    if path.length > sentinel.length && path.starts_with(sentinel) {
        return path.substring(sentinel.length, path.length)
    }
    if !avra_selfhost_file_exists(path) {
        return sha256_file("/__missing__")
    }
    sha256_file(path)
}

/// Compute the compiler-binary fingerprint. Read once per build and
/// reuse for every unit. Pulling this out makes the build driver
/// loop cheap (we do not re-hash the bs2 binary 50 times for 50
/// units — just once).
export fn compiler_hash_for(binary_path: string) -> string {
    sha256_file(binary_path)
}

/// pdme.8: the RUNNING compiler's content hash — the toolchain axis of
/// package_full_fingerprint. Reads argv[0], the same trust the unit
/// cache's compiler_hash axis has always placed in it (BuildInputs.
/// compiler_path = argv[0]); the hash is of CONTENT, not path, so the
/// fp stays pure/machine-portable. One binary hash subsumes the
/// runtime.o/llvm_wrapper.o inputs the pdme.8 ticket lists — bs2
/// statically links both, so any runtime.c / llvm_wrapper.c edit
/// changes the binary bytes. sha256_file rides the .avra-sha256
/// sidecar (~one stat when warm) and the result is memoised per
/// process. An unhashable argv[0] folds as "" — degrading to the
/// pre-pdme.8 source-only key rather than failing the build, matching
/// how compiler_hash_for callers already behave.
export fn toolchain_fingerprint() -> string {
    let memo_key = "toolchain:@self"
    let cached = avra_pkg_fp_cache_get(memo_key)
    if cached != "" { return cached }
    let fp = sha256_file(avra_selfhost_get_arg_cstr(0))
    if fp != "" { avra_pkg_fp_cache_set(memo_key, fp) }
    fp
}

/// Canonical profile key. Order-stable and human-readable so that:
///   1. A different opt_level forces a rebuild.
///   2. Two equivalent profiles hash to the same key (e.g. order
///      of fields cannot matter — we lay them out fixed here).
///   3. A developer can paste the key into a debug log and see at
///      a glance which profile produced the digest.
export fn profile_key_of(
    name: string,
    opt_level: int,
    debug: bool,
    overflow_checks: bool,
    coverage: bool,
) -> string {
    let dbg = if debug { "1" } else { "0" }
    let ovf = if overflow_checks { "1" } else { "0" }
    let cov = if coverage { "1" } else { "0" }
    name + "|opt=" + string(opt_level) + "|dbg=" + dbg + "|ovf=" + ovf + "|cov=" + cov
}

/// True when two fingerprints match. The cache uses this for the
/// hit / miss decision — if `fp_eq(stored, computed)` we have a hit.
export fn fp_eq(a: Fingerprint, b: Fingerprint) -> bool {
    a.hex == b.hex
}

/// Display-friendly short form for log lines. The full 64-char hex
/// is too long to put in progress UI; the first 12 chars are enough
/// for human disambiguation in any realistic project.
export fn fp_short(fp: Fingerprint) -> string {
    fp.hex.substring(0, 12)
}

/// 2wfp: whole-package fingerprint. Combines every .av source under
/// `<pkg_root>/src/` into one deterministic digest by concatenating
/// `<path>:<sha256(content)>\n` for each file, sorted by path, then
/// hashing the whole accumulator.
///
/// Returns "" when `<pkg_root>/avra.toml` is absent — that's the signal
/// the caller is looking at an ad-hoc single-file compile (e.g.
/// `bs2 compile /tmp/scratch.av`), not a real package. In that case
/// callers fall back to a file-level fingerprint scheme.
///
/// This is the right cache key for a *package's* unit-level metadata.
/// Keying on just the entry file's hash misses changes to sibling
/// files — a new `export fn` in a sub-module wouldn't bump the cache
/// slot, so consumers under AVRA_USE_METADATA=1 would synthesize stubs
/// from the stale aggregated meta and fail to resolve the new symbol.
///
/// Per-file metas (emit_per_file_metas) keep their per-file fingerprint
/// scheme — each sub-mod has its own slot keyed on its own sha256.
/// This function is exclusively for the package-aggregate slot.
/// pdme.1: dep-aware whole-package fingerprint — the cargo/go pattern.
/// `package_source_fingerprint` (fp_own) hashes only the package's OWN
/// src/ tree, so when P depends on Q and Q's source changes, P's key is
/// unchanged and consumers silently reuse P's stale aggregated meta
/// (stubs generated against Q's OLD shape). This composite folds each
/// direct dep's full fingerprint in, transitively: editing any leaf
/// changes fp_full for every reverse-dependent, so every reverse-
/// dependent's cache correctly misses.
///
///   fp_full(P) = sha256(fp_own(P) + toolchain_fp + Σ dep_name=fp_full(dep))
///
/// The dep graph comes from the manifests' declared [dependencies]
/// (build_graph — already transitive, cycle-detecting, topo-sorting),
/// not from scraping `use` statements: declarations are the contract,
/// and the graph walk is shared with the build driver.
///
/// pdme.8: `toolchain_fp` (the running compiler's content hash) is an
/// input because the aggregated metadata this fp keys is a function of
/// the EXTRACTOR too, not just the source — a bs2 whose metadata
/// emitter changed must not serve slots stamped by the old one. The
/// unit-level build cache already carried a compiler axis
/// (fp_for_unit's compiler_hash); this closes the same hole at the
/// package level. Deliberately NOT folded into the uzs9.3 content
/// stores (obj/, link/) — those key on artifact CONTENT (same IR ⇒
/// same object regardless of which bs2 produced it), and adding a
/// toolchain axis there would kill their cross-toolchain reuse.
///
/// Returns "" (like fp_own) when pkg_root has no avra.toml — ad-hoc
/// single-file compiles keep their file-level scheme. A dep-graph
/// error (cycle, missing dep manifest) also returns "" after
/// reporting: consumers degrade to fast-path-off/recompute — the
/// safe direction — rather than silently keying on a partial graph.
///
/// Memoised per (process, pkg_root) alongside fp_own under a
/// namespaced key: source can't change mid-invocation.
export fn package_full_fingerprint(pkg_root: string) -> string {
    if pkg_root == "" { return "" }
    if avra_selfhost_file_exists(pkg_root + "/avra.toml") == 0 { return "" }
    let memo_key = "full:" + pkg_root
    let cached = avra_pkg_fp_cache_get(memo_key)
    if cached != "" { return cached }
    let root = fp_trailing_slash(pkg_root)
    let g = build_graph(root)
    if g.had_error {
        eprintln("[pkg-fp] dependency graph error under ${pkg_root}: ${g.error} — dep-aware fingerprint unavailable")
        return ""
    }
    // g.units is topo-sorted (deps before dependents), so each unit's
    // direct-dep fps are already computed when its turn comes.
    //
    // pdme.8: the toolchain axis folds into EVERY unit's composed
    // string (not just the queried root), so a package's fp is
    // identical whether it's computed as the root or reached as a
    // dep in someone else's walk — one fp per (package, toolchain).
    let tc = toolchain_fingerprint()
    mut names: List<string> = []
    mut fps: List<string> = []
    mut root_fp = ""
    for u in g.units {
        mut composed = "avra/pkg-full v2\n"
        composed = composed + "own:" + package_source_fingerprint(u.project_root) + "\n"
        composed = composed + "toolchain:" + tc + "\n"
        for d in u.dep_names {
            composed = composed + "dep:" + d + "=" + full_fp_lookup(names, fps, d) + "\n"
        }
        let fp = sha256_hex(composed)
        names.push(u.name)
        fps.push(fp)
        // The root unit is the one rooted at the path we asked about —
        // matched structurally rather than assuming topo order puts it
        // last.
        if u.project_root == root { root_fp = fp }
    }
    if root_fp == "" { return "" }
    avra_pkg_fp_cache_set(memo_key, root_fp)
    root_fp
}

/// Positional lookup for the topo-walk's name→fp accumulator. A
/// missing name folds as "" — deterministic, and unreachable when
/// build_graph succeeded (every dep_name has a collected unit).
fn full_fp_lookup(names: List<string>, fps: List<string>, target: string) -> string {
    mut i = 0
    while i < names.length {
        if names[i] == target { return fps[i] }
        i = i + 1
    }
    ""
}

/// build_graph requires a trailing slash on the root path.
fn fp_trailing_slash(s: string) -> string {
    if s.length == 0 { return "/" }
    if s.substring(s.length - 1, s.length) == "/" { s } else { s + "/" }
}

export fn package_source_fingerprint(pkg_root: string) -> string {
    if pkg_root == "" { return "" }
    if avra_selfhost_file_exists(pkg_root + "/avra.toml") == 0 { return "" }
    // 73r2: in-process memoization. Source can't change mid-invocation,
    // so caching by pkg_root within ONE bs2 process is always correct.
    // Replaces the disk sidecar `.pkg-fp`, which silently went stale:
    // `find -newer` missed mtime ties (APFS second granularity), and
    // writers/readers could compute different fps for the same source
    // state — orphaning meta.bin files keyed on the older fp.
    let cached = avra_pkg_fp_cache_get(pkg_root)
    if cached != "" { return cached }
    let src_dir = pkg_root + "/src"
    let listing = avra_shell_exec("find ${src_dir} -name '*.av' -type f 2>/dev/null | sort")
    mut acc = ""
    for line in listing.split("\n") {
        if line == "" { continue }
        let hex = sha256_file(line)
        acc = acc + line + ":" + hex + "\n"
    }
    let fp = sha256_hex(acc)
    avra_pkg_fp_cache_set(pkg_root, fp)
    fp
}

