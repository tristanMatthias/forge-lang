// WHY: metadata.bin format — a compact binary record of one
// compile-unit's *public surface* (exported types, fn signatures,
// trait/impl tables, generics, constants). Downstream units consume
// metadata.bin to typecheck against this unit's API without
// re-parsing or re-typechecking the implementation.
//
// Layered build:
//   - BytesWriter / BytesReader     ← byte-level binary IO (pure Avra)
//   - encode_u32_le / decode_u32_le ← scalar encoders
//   - encode_string / decode_string ← length-prefixed UTF-8
//   - the per-section formats        ← built on top
//
// The first three layers are this file. Per-section formats are
// added as iinq's per-symbol-kind work lands.
//
// Tracked under forge-crafting-intepreters-iinq (epic
// forge-crafting-intepreters-a1el — the build system).

use core.ast.{ValueType, TypeList, FieldList, VariantList, ParamList}

extern fn avra_bytes_make(len: int) -> bytes
extern fn avra_bytes_set(b: bytes, idx: int, val: int)
extern fn avra_bytes_to_hex(b: bytes) -> string
extern fn avra_bytes_from_string(s: string) -> bytes
extern fn avra_string_from_bytes(b: bytes) -> string

/// Append-only byte builder. Internally accumulates a list of
/// chunks and concatenates on `finish()`. Linear in total output
/// size — fine for metadata.bin (typical unit ~tens of kilobytes).
///
/// All write methods mutate via `self.chunks.push(...)`; the chunk
/// list is heap-allocated, so ownership of the BytesWriter value
/// can be shared between scopes without breaking the encoding.
export type BytesWriter = {
    chunks: List<bytes>,
}

/// Construct an empty writer ready for `.u8`, `.u32_le`, `.string`,
/// etc. Idiomatic call site: `let w = writer_new(); w.u32_le(42)`.
export fn writer_new() -> BytesWriter {
    BytesWriter { chunks: [] }
}

// BytesWriter methods. Each `.u*_le(val)` writes one fixed-width
// scalar in little-endian order; `.string(s)` writes a u32 length
// prefix followed by the UTF-8 bytes; `.raw(b)` appends without
// framing. `.finish()` concatenates accumulated chunks into one
// bytes value.
impl BytesWriter {
    fn u8(self, val: int) {
        let b = avra_bytes_make(1)
        avra_bytes_set(b, 0, val)
        self.chunks.push(b)
    }

    fn u16_le(self, val: int) {
        let b = avra_bytes_make(2)
        // `>>` is arithmetic-shift on Avra's signed `int`, but `& 0xFF`
        // discards the sign-extended high bits — so the bit pattern of
        // `val` is reproduced byte-for-byte regardless of sign. Plain
        // `/256` would truncate toward zero on negative values and
        // disagree with shift on the high bytes.
        avra_bytes_set(b, 0, val & 0xFF)
        avra_bytes_set(b, 1, (val >> 8) & 0xFF)
        self.chunks.push(b)
    }

    fn u32_le(self, val: int) {
        let b = avra_bytes_make(4)
        avra_bytes_set(b, 0, val & 0xFF)
        avra_bytes_set(b, 1, (val >> 8) & 0xFF)
        avra_bytes_set(b, 2, (val >> 16) & 0xFF)
        avra_bytes_set(b, 3, (val >> 24) & 0xFF)
        self.chunks.push(b)
    }

    fn u64_le(self, val: int) {
        let b = avra_bytes_make(8)
        mut i = 0
        while i < 8 {
            avra_bytes_set(b, i, (val >> (i * 8)) & 0xFF)
            i = i + 1
        }
        self.chunks.push(b)
    }

    fn string(self, s: string) {
        let b = avra_bytes_from_string(s)
        self.u32_le(b.length)
        self.chunks.push(b)
    }

    fn raw(self, b: bytes) {
        self.chunks.push(b)
    }

    fn finish(self) -> bytes {
        finish_loop(self.chunks, 0, avra_bytes_make(0))
    }
}

fn finish_loop(chunks: List<bytes>, idx: int, acc: bytes) -> bytes {
    if idx >= chunks.length { return acc }
    finish_loop(chunks, idx + 1, acc.concat(chunks[idx]))
}

// ── Reader ──
//
// Cursor over a frozen `bytes` buffer. Each `read_*` advances the
// cursor in-place. Out-of-bounds reads return 0 (sentinel) — callers
// gate on `.remaining()` when correctness matters.

/// Cursor over a bytes buffer. The cursor lives in a one-element
/// List<int> so `.u8()` etc. can advance it without the reader
/// itself needing to be `mut` (Avra params are immutable). `pos[0]`
/// is the next byte to read.
export type BytesReader = {
    buf: bytes,
    pos: List<int>,
}

/// Create a reader positioned at offset 0 of `buf`. Idiomatic call:
/// `let r = reader_new(buf); let n = r.u32_le()`.
export fn reader_new(buf: bytes) -> BytesReader {
    BytesReader { buf: buf, pos: [0] }
}

// BytesReader methods. Each `.u*_le()` returns one fixed-width
// scalar and advances the cursor; `.string()` reads a u32 length
// prefix and the following UTF-8 bytes; `.raw(n)` reads n unframed
// bytes; `.remaining()` reports the number of unread bytes left.
impl BytesReader {
    fn remaining(self) -> int {
        let rem = self.buf.length - self.pos[0]
        if rem < 0 { 0 } else { rem }
    }

    fn u8(self) -> int {
        let p = self.pos[0]
        let v = self.buf.byte(p)
        self.pos.set(0, p + 1)
        v
    }

    fn u16_le(self) -> int {
        let lo = self.u8()
        let hi = self.u8()
        lo + hi * 256
    }

    fn u32_le(self) -> int {
        let b0 = self.u8()
        let b1 = self.u8()
        let b2 = self.u8()
        let b3 = self.u8()
        b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    }

    fn u64_le(self) -> int {
        mut v = 0
        mut shift = 1
        mut i = 0
        while i < 8 {
            v = v + self.u8() * shift
            shift = shift * 256
            i = i + 1
        }
        v
    }

    fn string(self) -> string {
        let len = self.u32_le()
        let start = self.pos[0]
        let slice = self.buf.slice(start, start + len)
        self.pos.set(0, start + len)
        avra_string_from_bytes(slice)
    }

    fn raw(self, n: int) -> bytes {
        let start = self.pos[0]
        let slice = self.buf.slice(start, start + n)
        self.pos.set(0, start + n)
        slice
    }
}

// ── Stable symbol IDs ──
//
// Every cross-unit reference in metadata.bin (a fn calling a type
// declared in another unit, a trait impl pointing at a foreign type)
// is recorded as a 64-bit hash of the symbol's fully qualified name.
// The hash MUST be deterministic across builds — two compiles of the
// same unit on the same day on the same machine must produce the
// same id, otherwise downstream units fail to resolve their
// references after a recompile.
//
// FNV-1a-64 is used: simple, well-distributed for short ASCII names,
// fits in a single u64 without external state. Crypto strength is
// not a goal — collision probability across a project's symbol set
// is the only constraint, and FNV-1a is fine for that scale.
//
// The constants below are the canonical FNV-1a-64 values. They are
// fixed and must not be changed; doing so would invalidate every
// cached metadata.bin in the wild.

const FNV64_OFFSET: int = 0xCBF29CE484222325
const FNV64_PRIME: int = 0x100000001B3

/// Hash a fully qualified symbol name (e.g. `@std::avrac::build::cache::Cache`)
/// to a stable u64. Determined by FNV-1a — see the section header above.
/// Empty input hashes to the FNV offset (the standard "empty input"
/// behaviour); collisions on real qualified names are vanishingly
/// unlikely for any realistic project's symbol count.
export fn sym_id_for(qualified_name: string) -> int {
    mut h = FNV64_OFFSET
    let b = avra_bytes_from_string(qualified_name)
    let n = b.length
    mut i = 0
    while i < n {
        h = (h ^ b.byte(i)) * FNV64_PRIME
        i = i + 1
    }
    h
}

// ── File header + section framing ──
//
// Top-level metadata.bin layout:
//
//     [u32 magic = 'AVMD' = 0x444D5641 (LE) ]
//     [u16 version_major]
//     [u16 version_minor]
//     [string unit_name           ]   length-prefixed UTF-8
//     [bytes fingerprint = 32B    ]   sha256 of the unit's source set
//     [u32 section_count          ]
//     [ section_0, section_1, ... ]
//
// Each section is framed identically:
//
//     [u8  section_kind          ]   1=TYPES 2=FNS 3=TRAITS 4=IMPLS 5=CONSTS
//     [u32 entry_count           ]
//     [u32 section_body_length   ]
//     [body...]                       opaque to the framer; per-kind format
//
// `entry_count` lets readers skip an entire section when they need
// to seek past it; `section_body_length` lets readers skip without
// parsing entries when an unknown section kind appears (forward-compat).

// Magic bytes: ASCII "AVMD" in little-endian u32.
export const METADATA_MAGIC: int = 0x444D5641
export const METADATA_VERSION_MAJOR: int = 1
export const METADATA_VERSION_MINOR: int = 0

/// Stable section IDs. Kept in this enum so the byte values are
/// pinned — adding a new section appends; never reorder or reuse a
/// retired number, otherwise old metadata.bin files mis-route their
/// sections to the wrong reader.
export enum SectionKind {
    Types,    // tag 1: type declarations (struct / enum / shape / newtype / union alias)
    Fns,      // tag 2: fn signatures (params + return type + visibility)
    Traits,   // tag 3: trait declarations
    Impls,    // tag 4: impl table — (Trait,Type) → method list
    Consts,   // tag 5: const declarations (name + type + value bytes)
}

fn section_kind_to_byte(k: SectionKind) -> int {
    match k {
        .Types -> 1
        .Fns -> 2
        .Traits -> 3
        .Impls -> 4
        .Consts -> 5
    }
}

fn byte_to_section_kind(b: int) -> SectionKind {
    match b {
        2 -> .Fns
        3 -> .Traits
        4 -> .Impls
        5 -> .Consts
        _ -> .Types
    }
}

// File-header + section-frame writers.
//   .header(unit, fp, n)   — fixed-prefix file layout (magic, version,
//                            unit name, 32-byte fingerprint, section_count).
//   .section(kind, n, body) — single section frame; body is opaque, so
//                            per-kind encoders can evolve without
//                            touching the framer.
impl BytesWriter {
    fn header(self, unit_name: string, fingerprint: bytes, section_count: int) {
        self.u32_le(METADATA_MAGIC)
        self.u16_le(METADATA_VERSION_MAJOR)
        self.u16_le(METADATA_VERSION_MINOR)
        self.string(unit_name)
        self.raw(fingerprint)
        self.u32_le(section_count)
    }

    fn section(self, kind: SectionKind, entry_count: int, body: bytes) {
        self.u8(section_kind_to_byte(kind))
        self.u32_le(entry_count)
        self.u32_le(body.length)
        self.raw(body)
    }
}

/// Decoded file header. Mirrors `BytesWriter.header`.
export type MetadataHeader = {
    magic: int,
    version_major: int,
    version_minor: int,
    unit_name: string,
    fingerprint: bytes,
    section_count: int,
}

/// Decoded section frame (header + body); the body is left raw for
/// per-kind decoders to consume separately.
export type SectionFrame = {
    kind: SectionKind,
    entry_count: int,
    body: bytes,
}

// ── ValueType encoding ──
//
// Every fn signature, every field, every variant payload, every
// generic argument inside metadata.bin is a ValueType. The encoding
// is a single tag byte plus variant-specific payload.
//
// Tag bytes are pinned. New variants append; never reorder or
// reuse a retired number, otherwise existing metadata.bin files
// route to the wrong decoder.

const VT_UNKNOWN: int = 0x00
const VT_INT: int = 0x01
const VT_BOOL: int = 0x02
const VT_FLOAT: int = 0x03
const VT_STR: int = 0x04
const VT_BYTES: int = 0x05
const VT_PTR: int = 0x06
const VT_MAP: int = 0x07
const VT_VOID: int = 0x08
const VT_U8: int = 0x10
const VT_U16: int = 0x11
const VT_U32: int = 0x12
const VT_U64: int = 0x13
const VT_I8: int = 0x14
const VT_I16: int = 0x15
const VT_I32: int = 0x16
const VT_STRUCT: int = 0x20
const VT_ENUM: int = 0x21
const VT_TRAIT: int = 0x22
const VT_NEWTYPE: int = 0x23
const VT_NARROWED_ENUM: int = 0x24
const VT_LIST: int = 0x30
const VT_TUPLE: int = 0x31
const VT_UNION: int = 0x32
const VT_FN: int = 0x33
const VT_FN_TYPED: int = 0x34
const VT_CLOSURE: int = 0x35
const VT_TASK: int = 0x36

impl BytesWriter {
    fn vtype(self, vt: ValueType) {
        match vt {
            .Unknown -> self.u8(VT_UNKNOWN)
            .Int -> self.u8(VT_INT)
            .Bool -> self.u8(VT_BOOL)
            .Float -> self.u8(VT_FLOAT)
            .Str -> self.u8(VT_STR)
            .Bytes -> self.u8(VT_BYTES)
            .Ptr -> self.u8(VT_PTR)
            .Map -> self.u8(VT_MAP)
            .Void -> self.u8(VT_VOID)
            .U8 -> self.u8(VT_U8)
            .U16 -> self.u8(VT_U16)
            .U32 -> self.u8(VT_U32)
            .U64 -> self.u8(VT_U64)
            .I8 -> self.u8(VT_I8)
            .I16 -> self.u8(VT_I16)
            .I32 -> self.u8(VT_I32)
            // Nominal types carry both name and sym_id. Decoders that
            // already have the local TypeRegistry can rebuild id from
            // the name; cross-unit decoders use sym_id to follow the
            // cross-reference.
            .Struct(name, _) -> {
                self.u8(VT_STRUCT)
                self.string(name)
                self.u64_le(sym_id_for(name))
            }
            .Enum(name, args, _) -> {
                self.u8(VT_ENUM)
                self.string(name)
                self.u64_le(sym_id_for(name))
                self.vtype_list(args)
            }
            .Trait(name, _) -> {
                self.u8(VT_TRAIT)
                self.string(name)
                self.u64_le(sym_id_for(name))
            }
            .Newtype(name, inner, _) -> {
                self.u8(VT_NEWTYPE)
                self.string(name)
                self.u64_le(sym_id_for(name))
                self.vtype(inner)
            }
            .NarrowedEnum(en, v, _) -> {
                self.u8(VT_NARROWED_ENUM)
                self.string(en)
                self.string(v)
                self.u64_le(sym_id_for(en))
            }
            .List(elem) -> {
                self.u8(VT_LIST)
                self.vtype(elem)
            }
            .Tuple(elements) -> {
                self.u8(VT_TUPLE)
                self.vtype_list(elements)
            }
            .Union(types) -> {
                self.u8(VT_UNION)
                self.vtype_list(types)
            }
            .Fn(ret) -> {
                self.u8(VT_FN)
                self.vtype(ret)
            }
            .FnTyped(params, ret) -> {
                self.u8(VT_FN_TYPED)
                self.vtype_list(params)
                self.vtype(ret)
            }
            .Closure(n, ret) -> {
                self.u8(VT_CLOSURE)
                self.u32_le(n)
                self.vtype(ret)
            }
            .Task(rt) -> {
                self.u8(VT_TASK)
                self.vtype(rt)
            }
        }
    }

    fn vtype_list(self, types: TypeList) {
        let count = type_list_length(types)
        self.u32_le(count)
        self.vtype_list_body(types)
    }

    fn vtype_list_body(self, types: TypeList) {
        match types {
            .End -> {}
            .Node(t, next) -> {
                self.vtype(t)
                self.vtype_list_body(next)
            }
        }
    }
}

fn type_list_length(types: TypeList) -> int {
    match types {
        .End -> 0
        .Node(_, next) -> 1 + type_list_length(next)
    }
}

fn field_list_length(fields: FieldList) -> int {
    match fields {
        .End -> 0
        .Node(_, _, next) -> 1 + field_list_length(next)
    }
}

fn variant_list_length(variants: VariantList) -> int {
    match variants {
        .End -> 0
        .Node(_, _, next) -> 1 + variant_list_length(next)
    }
}

fn param_list_length(params: ParamList) -> int {
    match params {
        .End -> 0
        .Node(_, _, next) -> 1 + param_list_length(next)
    }
}

// ── Composite list encoders ──
//
// FieldList / VariantList / ParamList are the building blocks of the
// per-section bodies. Each list encodes as `[u32 count][entries]`,
// where each entry is `[string name][per-element body]`.

impl BytesWriter {
    fn field_list(self, fields: FieldList) {
        self.u32_le(field_list_length(fields))
        self.field_list_body(fields)
    }

    fn field_list_body(self, fields: FieldList) {
        match fields {
            .End -> {}
            .Node(name, vt, next) -> {
                self.string(name)
                self.vtype(vt)
                self.field_list_body(next)
            }
        }
    }

    fn param_list(self, params: ParamList) {
        self.u32_le(param_list_length(params))
        self.param_list_body(params)
    }

    fn param_list_body(self, params: ParamList) {
        match params {
            .End -> {}
            .Node(name, vt, next) -> {
                self.string(name)
                self.vtype(vt)
                self.param_list_body(next)
            }
        }
    }

    fn variant_list(self, variants: VariantList) {
        self.u32_le(variant_list_length(variants))
        self.variant_list_body(variants)
    }

    fn variant_list_body(self, variants: VariantList) {
        match variants {
            .End -> {}
            .Node(name, fields, next) -> {
                self.string(name)
                self.field_list(fields)
                self.variant_list_body(next)
            }
        }
    }
}

impl BytesReader {
    fn field_list(self) -> FieldList {
        let count = self.u32_le()
        self.field_list_body(count)
    }

    fn field_list_body(self, count: int) -> FieldList {
        if count == 0 { return FieldList.End }
        let name = self.string()
        let vt = self.vtype()
        let tail = self.field_list_body(count - 1)
        FieldList.Node(name, vt, tail)
    }

    fn param_list(self) -> ParamList {
        let count = self.u32_le()
        self.param_list_body(count)
    }

    fn param_list_body(self, count: int) -> ParamList {
        if count == 0 { return ParamList.End }
        let name = self.string()
        let vt = self.vtype()
        let tail = self.param_list_body(count - 1)
        ParamList.Node(name, vt, tail)
    }

    fn variant_list(self) -> VariantList {
        let count = self.u32_le()
        self.variant_list_body(count)
    }

    fn variant_list_body(self, count: int) -> VariantList {
        if count == 0 { return VariantList.End }
        let name = self.string()
        let fields = self.field_list()
        let tail = self.variant_list_body(count - 1)
        VariantList.Node(name, fields, tail)
    }
}

// File-header + section-frame readers. Mirror the BytesWriter impls
// above. Caller validates `.magic == METADATA_MAGIC` before trusting
// the rest of the header.
impl BytesReader {
    fn vtype(self) -> ValueType {
        let tag = self.u8()
        if tag == VT_UNKNOWN { return ValueType.Unknown }
        if tag == VT_INT { return ValueType.Int }
        if tag == VT_BOOL { return ValueType.Bool }
        if tag == VT_FLOAT { return ValueType.Float }
        if tag == VT_STR { return ValueType.Str }
        if tag == VT_BYTES { return ValueType.Bytes }
        if tag == VT_PTR { return ValueType.Ptr }
        if tag == VT_MAP { return ValueType.Map }
        if tag == VT_VOID { return ValueType.Void }
        if tag == VT_U8 { return ValueType.U8 }
        if tag == VT_U16 { return ValueType.U16 }
        if tag == VT_U32 { return ValueType.U32 }
        if tag == VT_U64 { return ValueType.U64 }
        if tag == VT_I8 { return ValueType.I8 }
        if tag == VT_I16 { return ValueType.I16 }
        if tag == VT_I32 { return ValueType.I32 }
        if tag == VT_STRUCT {
            let name = self.string()
            let _id = self.u64_le()
            return ValueType.Struct(name, 0)
        }
        if tag == VT_ENUM {
            let name = self.string()
            let _id = self.u64_le()
            let args = self.vtype_list()
            return ValueType.Enum(name, args, 0)
        }
        if tag == VT_TRAIT {
            let name = self.string()
            let _id = self.u64_le()
            return ValueType.Trait(name, 0)
        }
        if tag == VT_NEWTYPE {
            let name = self.string()
            let _id = self.u64_le()
            let inner = self.vtype()
            return ValueType.Newtype(name, inner, 0)
        }
        if tag == VT_NARROWED_ENUM {
            let en = self.string()
            let v = self.string()
            let _id = self.u64_le()
            return ValueType.NarrowedEnum(en, v, 0)
        }
        if tag == VT_LIST {
            return ValueType.List(self.vtype())
        }
        if tag == VT_TUPLE {
            return ValueType.Tuple(self.vtype_list())
        }
        if tag == VT_UNION {
            return ValueType.Union(self.vtype_list())
        }
        if tag == VT_FN {
            return ValueType.Fn(self.vtype())
        }
        if tag == VT_FN_TYPED {
            let params = self.vtype_list()
            let ret = self.vtype()
            return ValueType.FnTyped(params, ret)
        }
        if tag == VT_CLOSURE {
            let n = self.u32_le()
            return ValueType.Closure(n, self.vtype())
        }
        if tag == VT_TASK {
            return ValueType.Task(self.vtype())
        }
        ValueType.Unknown
    }

    fn vtype_list(self) -> TypeList {
        let count = self.u32_le()
        self.vtype_list_body(count)
    }

    fn vtype_list_body(self, count: int) -> TypeList {
        if count == 0 { return TypeList.End }
        let head = self.vtype()
        let tail = self.vtype_list_body(count - 1)
        TypeList.Node(head, tail)
    }
}

impl BytesReader {
    fn header(self) -> MetadataHeader {
        let m = self.u32_le()
        let vmaj = self.u16_le()
        let vmin = self.u16_le()
        let name = self.string()
        let fp = self.raw(32)
        let n = self.u32_le()
        MetadataHeader { magic: m, version_major: vmaj, version_minor: vmin, unit_name: name, fingerprint: fp, section_count: n }
    }

    fn section(self) -> SectionFrame {
        let k = self.u8()
        let n = self.u32_le()
        let len = self.u32_le()
        let body = self.raw(len)
        SectionFrame { kind: byte_to_section_kind(k), entry_count: n, body: body }
    }
}

// ── TYPES section: declarations of nominal types ──
//
// Each entry in the TYPES section body:
//
//   [u64 sym_id]                — stable cross-unit reference
//   [u8  type_decl_kind]        — pinned tag (see TypeDeclKind)
//   [string canonical_name]
//   [body]                      — kind-specific
//
// Bodies:
//   StructDecl / ShapeDecl  → field_list
//   EnumDecl                → variant_list
//   NewtypeDecl             → vtype inner
//   UnionAliasDecl          → vtype unioned_type
//
// TraitDecl encoding deferred to a follow-up commit (the trait
// method list is a separate sub-record and lands cleaner on its own).

const TYPE_DECL_STRUCT: int = 1
const TYPE_DECL_ENUM: int = 2
const TYPE_DECL_TRAIT: int = 3
const TYPE_DECL_NEWTYPE: int = 4
const TYPE_DECL_UNION_ALIAS: int = 5
const TYPE_DECL_SHAPE: int = 6

export enum TypeDeclKind {
    StructDecl
    EnumDecl
    TraitDecl
    NewtypeDecl
    UnionAliasDecl
    ShapeDecl
}

fn type_decl_kind_to_byte(k: TypeDeclKind) -> int {
    if k is .StructDecl { return TYPE_DECL_STRUCT }
    if k is .EnumDecl { return TYPE_DECL_ENUM }
    if k is .TraitDecl { return TYPE_DECL_TRAIT }
    if k is .NewtypeDecl { return TYPE_DECL_NEWTYPE }
    if k is .UnionAliasDecl { return TYPE_DECL_UNION_ALIAS }
    if k is .ShapeDecl { return TYPE_DECL_SHAPE }
    return TYPE_DECL_STRUCT
}

fn byte_to_type_decl_kind(b: int) -> TypeDeclKind {
    if b == TYPE_DECL_ENUM { return TypeDeclKind.EnumDecl }
    if b == TYPE_DECL_TRAIT { return TypeDeclKind.TraitDecl }
    if b == TYPE_DECL_NEWTYPE { return TypeDeclKind.NewtypeDecl }
    if b == TYPE_DECL_UNION_ALIAS { return TypeDeclKind.UnionAliasDecl }
    if b == TYPE_DECL_SHAPE { return TypeDeclKind.ShapeDecl }
    return TypeDeclKind.StructDecl
}

export type TypeDeclEntry = {
    sym_id: int,
    kind: TypeDeclKind,
    name: string,
    fields: FieldList,
    variants: VariantList,
    inner_vt: ValueType,
    methods: MetaTraitMethodList,
}

impl BytesWriter {
    fn type_decl(self, e: TypeDeclEntry) {
        self.u64_le(e.sym_id)
        self.u8(type_decl_kind_to_byte(e.kind))
        self.string(e.name)
        if e.kind is .StructDecl { self.field_list(e.fields) }
        if e.kind is .ShapeDecl { self.field_list(e.fields) }
        if e.kind is .EnumDecl { self.variant_list(e.variants) }
        if e.kind is .NewtypeDecl { self.vtype(e.inner_vt) }
        if e.kind is .UnionAliasDecl { self.vtype(e.inner_vt) }
        if e.kind is .TraitDecl { self.meta_trait_method_list(e.methods) }
    }
}

impl BytesReader {
    fn type_decl(self) -> TypeDeclEntry {
        let sid = self.u64_le()
        let kind = byte_to_type_decl_kind(self.u8())
        let name = self.string()
        mut fields = FieldList.End
        mut variants = VariantList.End
        mut inner = ValueType.Unknown
        mut methods = MetaTraitMethodList.End
        if kind is .StructDecl { fields = self.field_list() }
        if kind is .ShapeDecl { fields = self.field_list() }
        if kind is .EnumDecl { variants = self.variant_list() }
        if kind is .NewtypeDecl { inner = self.vtype() }
        if kind is .UnionAliasDecl { inner = self.vtype() }
        if kind is .TraitDecl { methods = self.meta_trait_method_list() }
        TypeDeclEntry {
            sym_id: sid,
            kind: kind,
            name: name,
            fields: fields,
            variants: variants,
            inner_vt: inner,
            methods: methods,
        }
    }
}

// ── FNS section: fn signatures ──
//
// Each entry in the FNS section body:
//
//   [u64 sym_id]
//   [string canonical_name]
//   [u8  exported]                  — 1 if `export fn`, else 0
//   [u8  is_extern]                 — 1 for `extern fn`, else 0
//   [param_list]
//   [vtype ret]
//
// `exported` and `is_extern` are independent flags: an extern fn is
// always callable from outside (C ABI), while a regular fn is only
// reachable to consumers if `export fn`. Both bits are kept so the
// downstream visibility filter doesn't have to re-derive them.

export type FnDeclEntry = {
    sym_id: int,
    name: string,
    exported: bool,
    is_extern: bool,
    params: ParamList,
    ret: ValueType,
}

impl BytesWriter {
    fn fn_decl(self, e: FnDeclEntry) {
        self.u64_le(e.sym_id)
        self.string(e.name)
        self.u8(if e.exported { 1 } else { 0 })
        self.u8(if e.is_extern { 1 } else { 0 })
        self.param_list(e.params)
        self.vtype(e.ret)
    }
}

impl BytesReader {
    fn fn_decl(self) -> FnDeclEntry {
        let sid = self.u64_le()
        let name = self.string()
        let exp = self.u8()
        let ext = self.u8()
        let params = self.param_list()
        let ret = self.vtype()
        FnDeclEntry {
            sym_id: sid,
            name: name,
            exported: exp == 1,
            is_extern: ext == 1,
            params: params,
            ret: ret,
        }
    }
}

// ── CONSTS section: const declarations ──
//
// Each entry in the CONSTS section body:
//
//   [u64 sym_id]
//   [string canonical_name]
//   [u8  exported]
//   [vtype type]
//   [u8  value_kind]              — pinned tag (see ConstValueKind)
//   [value_payload]               — kind-specific
//
// Value payloads (cover every literal a const initializer can produce
// at parse time):
//   IntValue   → [u64 raw_int_bits]
//   StrValue   → [string body]
//   BoolValue  → [u8 0_or_1]
//   FloatValue → [u64 raw double bits]
//   Unknown    → no payload (consumer treats as opaque)
//
// Anything more complex (a const initialized from an expression that
// can't be folded to a literal) is encoded as Unknown — the typeck
// in downstream units sees only the type, not the value, which is
// the same as today's "import a fn" guarantee.

const CONST_VAL_UNKNOWN: int = 0
const CONST_VAL_INT: int = 1
const CONST_VAL_STR: int = 2
const CONST_VAL_BOOL: int = 3
const CONST_VAL_FLOAT: int = 4

export enum ConstValueKind {
    UnknownValue
    IntValue
    StrValue
    BoolValue
    FloatValue
}

fn const_value_kind_to_byte(k: ConstValueKind) -> int {
    if k is .IntValue { return CONST_VAL_INT }
    if k is .StrValue { return CONST_VAL_STR }
    if k is .BoolValue { return CONST_VAL_BOOL }
    if k is .FloatValue { return CONST_VAL_FLOAT }
    return CONST_VAL_UNKNOWN
}

fn byte_to_const_value_kind(b: int) -> ConstValueKind {
    if b == CONST_VAL_INT { return ConstValueKind.IntValue }
    if b == CONST_VAL_STR { return ConstValueKind.StrValue }
    if b == CONST_VAL_BOOL { return ConstValueKind.BoolValue }
    if b == CONST_VAL_FLOAT { return ConstValueKind.FloatValue }
    return ConstValueKind.UnknownValue
}

export type ConstDeclEntry = {
    sym_id: int,
    name: string,
    exported: bool,
    ty: ValueType,
    value_kind: ConstValueKind,
    int_value: int,           // populated when value_kind is IntValue / FloatValue (raw bits) / BoolValue (0/1)
    str_value: string,        // populated when value_kind is StrValue
}

impl BytesWriter {
    fn const_decl(self, e: ConstDeclEntry) {
        self.u64_le(e.sym_id)
        self.string(e.name)
        self.u8(if e.exported { 1 } else { 0 })
        self.vtype(e.ty)
        self.u8(const_value_kind_to_byte(e.value_kind))
        if e.value_kind is .IntValue { self.u64_le(e.int_value) }
        if e.value_kind is .FloatValue { self.u64_le(e.int_value) }
        if e.value_kind is .BoolValue { self.u8(e.int_value & 1) }
        if e.value_kind is .StrValue { self.string(e.str_value) }
    }
}

impl BytesReader {
    fn const_decl(self) -> ConstDeclEntry {
        let sid = self.u64_le()
        let name = self.string()
        let exp = self.u8()
        let ty = self.vtype()
        let kind = byte_to_const_value_kind(self.u8())
        mut iv = 0
        mut sv = ""
        if kind is .IntValue { iv = self.u64_le() }
        if kind is .FloatValue { iv = self.u64_le() }
        if kind is .BoolValue { iv = self.u8() }
        if kind is .StrValue { sv = self.string() }
        ConstDeclEntry {
            sym_id: sid,
            name: name,
            exported: exp == 1,
            ty: ty,
            value_kind: kind,
            int_value: iv,
            str_value: sv,
        }
    }
}

// Trait method list — recursive linked list mirroring the
// FieldList / VariantList / ParamList shape from core::ast. Used
// to encode TraitDecl bodies in the TYPES section.
export enum MetaTraitMethodList {
    End
    Node(name: string, params: ParamList, ret: ValueType, next: MetaTraitMethodList)
}

fn meta_trait_method_list_length(ms: MetaTraitMethodList) -> int {
    match ms {
        .End -> 0
        .Node(_, _, _, next) -> 1 + meta_trait_method_list_length(next)
    }
}

impl BytesWriter {
    fn meta_trait_method_list(self, ms: MetaTraitMethodList) {
        self.u32_le(meta_trait_method_list_length(ms))
        self.meta_trait_method_list_body(ms)
    }

    fn meta_trait_method_list_body(self, ms: MetaTraitMethodList) {
        match ms {
            .End -> {}
            .Node(name, params, ret, next) -> {
                self.string(name)
                self.param_list(params)
                self.vtype(ret)
                self.meta_trait_method_list_body(next)
            }
        }
    }
}

impl BytesReader {
    fn meta_trait_method_list(self) -> MetaTraitMethodList {
        let count = self.u32_le()
        self.meta_trait_method_list_body(count)
    }

    fn meta_trait_method_list_body(self, count: int) -> MetaTraitMethodList {
        if count == 0 { return MetaTraitMethodList.End }
        let name = self.string()
        let params = self.param_list()
        let ret = self.vtype()
        let tail = self.meta_trait_method_list_body(count - 1)
        MetaTraitMethodList.Node(name, params, ret, tail)
    }
}

// ── IMPLS section: trait impls ──
//
// Each entry in the IMPLS section body:
//
//   [u64 trait_sym_id]
//   [string trait_name]
//   [u64 type_sym_id]
//   [string type_name]
//   [u32 method_count]
//   [per method:
//     [string method_name]
//     [u64 fn_sym_id]              — points into the FNS section by sym_id
//   ]
//
// `fn_sym_id` is the sym_id of the impl fn (e.g. the
// `Type__method` entry the codegen emits). Decoders cross-reference
// the FNS section to recover the full signature without having to
// re-store params and return type on every impl entry.

// Linked-list of (method_name, fn_sym_id). Keeps the section body
// length proportional to the actual number of methods declared in
// the impl.
export enum ImplMethodRefList {
    End
    Node(method_name: string, fn_sym_id: int, next: ImplMethodRefList)
}

fn impl_method_ref_list_length(ms: ImplMethodRefList) -> int {
    match ms {
        .End -> 0
        .Node(_, _, next) -> 1 + impl_method_ref_list_length(next)
    }
}

export type ImplDeclEntry = {
    trait_sym_id: int,
    trait_name: string,
    type_sym_id: int,
    type_name: string,
    methods: ImplMethodRefList,
}

impl BytesWriter {
    fn impl_decl(self, e: ImplDeclEntry) {
        self.u64_le(e.trait_sym_id)
        self.string(e.trait_name)
        self.u64_le(e.type_sym_id)
        self.string(e.type_name)
        self.u32_le(impl_method_ref_list_length(e.methods))
        self.impl_method_refs_body(e.methods)
    }

    fn impl_method_refs_body(self, ms: ImplMethodRefList) {
        match ms {
            .End -> {}
            .Node(name, fn_id, next) -> {
                self.string(name)
                self.u64_le(fn_id)
                self.impl_method_refs_body(next)
            }
        }
    }
}

impl BytesReader {
    fn impl_decl(self) -> ImplDeclEntry {
        let trait_sid = self.u64_le()
        let trait_name = self.string()
        let type_sid = self.u64_le()
        let type_name = self.string()
        let count = self.u32_le()
        let methods = self.impl_method_refs_body(count)
        ImplDeclEntry {
            trait_sym_id: trait_sid,
            trait_name: trait_name,
            type_sym_id: type_sid,
            type_name: type_name,
            methods: methods,
        }
    }

    fn impl_method_refs_body(self, count: int) -> ImplMethodRefList {
        if count == 0 { return ImplMethodRefList.End }
        let name = self.string()
        let fn_id = self.u64_le()
        let tail = self.impl_method_refs_body(count - 1)
        ImplMethodRefList.Node(name, fn_id, tail)
    }
}

// ── Unit-level orchestration ──
//
// `UnitMetadata` aggregates everything that goes into metadata.bin
// for one compile unit: header fields plus per-section entry lists.
// `write_unit` and `read_unit` compose the per-section codec into a
// complete file. Higher-level callers (the build driver, downstream
// consumers) work in terms of UnitMetadata, not raw bytes.

// Linked-list container types — one per section. Matches the shape
// already used for FieldList / VariantList in core::ast so encoding
// is straight recursion through the writer's `match`.

export enum TypeDeclList {
    End
    Node(entry: TypeDeclEntry, next: TypeDeclList)
}

export enum FnDeclList {
    End
    Node(entry: FnDeclEntry, next: FnDeclList)
}

export enum ConstDeclList {
    End
    Node(entry: ConstDeclEntry, next: ConstDeclList)
}

export enum ImplDeclList {
    End
    Node(entry: ImplDeclEntry, next: ImplDeclList)
}

fn type_decl_list_length(xs: TypeDeclList) -> int {
    match xs {
        .End -> 0
        .Node(_, next) -> 1 + type_decl_list_length(next)
    }
}

fn fn_decl_list_length(xs: FnDeclList) -> int {
    match xs {
        .End -> 0
        .Node(_, next) -> 1 + fn_decl_list_length(next)
    }
}

fn const_decl_list_length(xs: ConstDeclList) -> int {
    match xs {
        .End -> 0
        .Node(_, next) -> 1 + const_decl_list_length(next)
    }
}

fn impl_decl_list_length(xs: ImplDeclList) -> int {
    match xs {
        .End -> 0
        .Node(_, next) -> 1 + impl_decl_list_length(next)
    }
}

/// Everything that goes into one unit's metadata.bin. The
/// `unit_name` is the canonical module path (e.g. `@std::avrac::build`);
/// `fingerprint` is the 32-byte SHA-256 of the unit's source set,
/// matching what the cache uses today.
export type UnitMetadata = {
    unit_name: string,
    fingerprint: bytes,
    types: TypeDeclList,
    fns: FnDeclList,
    consts: ConstDeclList,
    impls: ImplDeclList,
}

/// Build an empty metadata bundle. Convenience for incremental
/// callers that build the lists up step by step.
export fn unit_metadata_new(unit_name: string, fingerprint: bytes) -> UnitMetadata {
    UnitMetadata {
        unit_name: unit_name,
        fingerprint: fingerprint,
        types: TypeDeclList.End,
        fns: FnDeclList.End,
        consts: ConstDeclList.End,
        impls: ImplDeclList.End,
    }
}

// `BytesWriter.unit(m)` serializes a complete UnitMetadata to bytes
// — header + every section. Empty sections still consume their
// frame (section_count is fixed at 4, not the count of non-empty
// sections), keeping the file layout predictable for downstream
// iteration.
impl BytesWriter {
    fn unit(self, m: UnitMetadata) {
        // Always write all four sections, even when empty, so the
        // section_count field stays predictable and downstream tools
        // can iterate without skipping unrecognised tags.
        self.header(m.unit_name, m.fingerprint, 4)
        self.write_types_section(m.types)
        self.write_fns_section(m.fns)
        self.write_consts_section(m.consts)
        self.write_impls_section(m.impls)
    }

    fn write_types_section(self, xs: TypeDeclList) {
        let body_w = writer_new()
        body_w.write_type_decl_list(xs)
        self.section(SectionKind.Types, type_decl_list_length(xs), body_w.finish())
    }

    fn write_type_decl_list(self, xs: TypeDeclList) {
        match xs {
            .End -> {}
            .Node(e, next) -> {
                self.type_decl(e)
                self.write_type_decl_list(next)
            }
        }
    }

    fn write_fns_section(self, xs: FnDeclList) {
        let body_w = writer_new()
        body_w.write_fn_decl_list(xs)
        self.section(SectionKind.Fns, fn_decl_list_length(xs), body_w.finish())
    }

    fn write_fn_decl_list(self, xs: FnDeclList) {
        match xs {
            .End -> {}
            .Node(e, next) -> {
                self.fn_decl(e)
                self.write_fn_decl_list(next)
            }
        }
    }

    fn write_consts_section(self, xs: ConstDeclList) {
        let body_w = writer_new()
        body_w.write_const_decl_list(xs)
        self.section(SectionKind.Consts, const_decl_list_length(xs), body_w.finish())
    }

    fn write_const_decl_list(self, xs: ConstDeclList) {
        match xs {
            .End -> {}
            .Node(e, next) -> {
                self.const_decl(e)
                self.write_const_decl_list(next)
            }
        }
    }

    fn write_impls_section(self, xs: ImplDeclList) {
        let body_w = writer_new()
        body_w.write_impl_decl_list(xs)
        self.section(SectionKind.Impls, impl_decl_list_length(xs), body_w.finish())
    }

    fn write_impl_decl_list(self, xs: ImplDeclList) {
        match xs {
            .End -> {}
            .Node(e, next) -> {
                self.impl_decl(e)
                self.write_impl_decl_list(next)
            }
        }
    }
}

// `BytesReader.unit()` decodes a complete metadata.bin — inverse
// of `BytesWriter.unit`. Section order is fixed (Types, Fns, Consts,
// Impls) and matches the writer; magic validation is the caller's
// responsibility (this is the structural decode, not the policy gate).
impl BytesReader {
    fn unit(self) -> UnitMetadata {
        let hdr = self.header()
        // Decode each of the four sections. Section order is fixed
        // (Types, Fns, Consts, Impls) — assumes the writer side
        // emitted them in this order. A generic skip-by-kind loop is
        // straightforward to layer on later when the format gains
        // optional sections, but pinning order keeps the decoder
        // simple while the format is still 1.0.
        let types_frame = self.section()
        let fns_frame = self.section()
        let consts_frame = self.section()
        let impls_frame = self.section()
        UnitMetadata {
            unit_name: hdr.unit_name,
            fingerprint: hdr.fingerprint,
            types: read_type_decl_list(types_frame.body, types_frame.entry_count),
            fns: read_fn_decl_list(fns_frame.body, fns_frame.entry_count),
            consts: read_const_decl_list(consts_frame.body, consts_frame.entry_count),
            impls: read_impl_decl_list(impls_frame.body, impls_frame.entry_count),
        }
    }
}

fn read_type_decl_list(body: bytes, count: int) -> TypeDeclList {
    let r = reader_new(body)
    read_type_decl_list_loop(r, count)
}

fn read_type_decl_list_loop(r: BytesReader, count: int) -> TypeDeclList {
    if count == 0 { return TypeDeclList.End }
    let head = r.type_decl()
    let tail = read_type_decl_list_loop(r, count - 1)
    TypeDeclList.Node(head, tail)
}

fn read_fn_decl_list(body: bytes, count: int) -> FnDeclList {
    let r = reader_new(body)
    read_fn_decl_list_loop(r, count)
}

fn read_fn_decl_list_loop(r: BytesReader, count: int) -> FnDeclList {
    if count == 0 { return FnDeclList.End }
    let head = r.fn_decl()
    let tail = read_fn_decl_list_loop(r, count - 1)
    FnDeclList.Node(head, tail)
}

fn read_const_decl_list(body: bytes, count: int) -> ConstDeclList {
    let r = reader_new(body)
    read_const_decl_list_loop(r, count)
}

fn read_const_decl_list_loop(r: BytesReader, count: int) -> ConstDeclList {
    if count == 0 { return ConstDeclList.End }
    let head = r.const_decl()
    let tail = read_const_decl_list_loop(r, count - 1)
    ConstDeclList.Node(head, tail)
}

fn read_impl_decl_list(body: bytes, count: int) -> ImplDeclList {
    let r = reader_new(body)
    read_impl_decl_list_loop(r, count)
}

fn read_impl_decl_list_loop(r: BytesReader, count: int) -> ImplDeclList {
    if count == 0 { return ImplDeclList.End }
    let head = r.impl_decl()
    let tail = read_impl_decl_list_loop(r, count - 1)
    ImplDeclList.Node(head, tail)
}
