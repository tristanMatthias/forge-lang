// WHY: shared AST→binary pipeline. Both `bs2 test` and (eventually)
// `bs2 compile` need the same chain — lower_quotes → desugar →
// inject_intrinsics → expand_components → resolve_names →
// expand_macros → run_comptime → typecheck_program → monomorphize →
// codegen → link. Before this module that chain was inlined in both
// callers, drifting independently. Now there's one canonical
// implementation; callers do their input-specific assembly and call
// build_binary.
//
// Filed under: 03hx (extraction tracking ticket).

use core.{avra_process_forward, avra_shell_exec, avra_getpid, avra_process_env_get}
use core.{NodeStore, item_sig_fp, item_body_fp, type_table_fp}
use features.quote_expr.{lower_quotes, report_runtime_quotes}
use desugar.{desugar_program, inject_intrinsics}
use features.component_decl.{expand_components}
use features.comptime.{resolve_and_expand_program, run_comptime}
use typeck.{typecheck_program}
use features.generics.{monomorphize}
use diagnostics.{DiagnosticBag, bag_has_errors, render_bag}
use codegen.{codegen_and_emit_ir_cov, compile_one_fn_module, collect_fn_targets, partition_targets, emit_cgu_object, emit_wrapper_object, FnTarget, fn_target_is_erased, parse_pkg_roots}
use build.link.{link_objects, link_objects_with_coverage, LinkOptions, default_link_options, llvm_prefix_dir}
use build.cache.{cache_for, linked_bin_key, linked_bin_lookup, linked_bin_publish}
use build.{toolchain_fingerprint, fn_unit_store_for_ns, fn_unit_store_init, fn_unit_key_cgu, CguMember, fn_unit_lookup, fn_unit_publish}

/// Bounded-K CGU width (ps3t.8.6.2, the Rust codegen-unit model): the number
/// of codegen units a program's fns are partitioned into. Bounding the unit
/// COUNT (not the unit SIZE) caps the repeated declare-pass cost at K·program
/// regardless of fn count, so a cold CGU build stays within an acceptable
/// factor of the whole-program build while the per-unit object cache recovers
/// warm/incremental latency. 16 matches Rust's non-incremental default.
const CGU_COUNT: int = 16

/// Inputs for build_binary. The caller owns assembly (parse +
/// resolve_module_files + any test-specific wrapping) and passes the
/// final List<StmtId>; this module owns everything from quote-lowering
/// through linked binary.
export type CompileTarget = {
    program: List<StmtId>,
    bin_path: string,           // final linked binary location
    project_dir: string,        // for runtime.o, llvm_wrapper.o
    diag_filename: string,      // displayed in error diagnostics
    coverage: bool,
    // 6owa library-mode: extra .o files to link against (e.g. the
    // pre-built @std/* package libs). Per-shard test binaries
    // populate this from AVRA_LIB_OBJS so AVRA_USE_METADATA=1
    // resolved call sites have their symbols at link time. Empty
    // for whole-program builds.
    extra_objs: List<string>,
    // The bundle-wide NodeStore covering `program` (B-final F0): every
    // per-file parse and module load that fed this program allocated into
    // it, so downstream passes hold one arena for the whole build unit.
    store: NodeStore,
}

/// Run the post-assembly pipeline and link a binary. Returns Ok(bin_path)
/// on success or Err(message) after rendering the diagnostic bag inline.
///
/// Quote-lowering runs first so identifiers inside `quote { … }` bodies
/// aren't seen by resolve as runtime references — they're captured as
/// string-typed AST literals. The post-desugar program carries every
/// loaded module's contents (callers must have resolved file-based
/// modules upstream), so inject_intrinsics's program_declares_enum
/// recursion sees stdlib's Result and skips the synthetic when it's
/// present.
/// Per-stage error guard: if the pass's bag carries errors, render
/// it against `diag_filename` and surface `error_msg` as a Result.Err
/// so the caller (build_binary's `?` propagation) bails cleanly.
/// Returns Ok(()) on success — the caller threads it via `let _ = … ?`
/// at every pipeline stage.
fn guard_bag(bag: DiagnosticBag, diag_filename: string, error_msg: string) -> Result<int, string> {
    if bag_has_errors(bag) {
        render_bag("", diag_filename, bag)
        return Result.Err(error_msg)
    }
    Result.Ok(0)
}

/// Codegen's inputs after the front half of the pipeline: the
/// monomorphized statements and the resolved type registry.
type FrontendMono = {
    stmts: List<StmtId>,
    type_reg: TypeRegistry,
}

/// Run the front half of the pipeline — quote-lowering through
/// monomorphization — shared by whole-program builds (build_binary) and
/// per-fn CGU emission (build_fn_module). Each stage that carries a
/// diagnostic bag is guarded: on error the bag is rendered against
/// `diag_filename` and an Err is returned. Quote-lowering runs first so
/// identifiers inside `quote { … }` bodies aren't seen by resolve as
/// runtime references; the post-desugar program carries every loaded
/// module's contents (callers must have resolved file-based modules
/// upstream) so inject_intrinsics's program_declares_enum recursion sees
/// stdlib's Result and skips the synthetic when it's present.
fn frontend_to_mono(target: CompileTarget) -> Result<FrontendMono, string> {
    // i0yg: reject a `quote { ... }` used outside `@comptime`/`@expand` BEFORE
    // lowering explodes it into `synth_*` shims that abort at run time. Run on
    // the pre-lowering program so each quote is one node with its own span.
    let _ = guard_bag(report_runtime_quotes(target.store, target.program), target.diag_filename, "runtime quote error")?
    let post_quote = lower_quotes(target.program, target.store)
    let desugared = desugar_program(post_quote, target.store)
    let with_intrinsics = inject_intrinsics(desugared, target.store)
    let comp = expand_components(with_intrinsics, target.store)
    let _ = guard_bag(comp.bag, target.diag_filename, "component validation failed")?
    // Option C pipeline: macro-introduced decls register before
    // scope validation runs. Single source of truth in
    // features/comptime/expand_macro.av — which since ps3t.6.6 also
    // owns @marshal (aliased to @derive(Marshal)), so the former
    // pre-resolve derive_marshal splice point is gone: one
    // derive_program pass expands every derive spelling.
    let named = resolve_and_expand_program(comp.stmts, target.store)
    if bag_has_errors(named.bag) || named.had_error {
        render_bag("", target.diag_filename, named.bag)
        return Result.Err(named.error_message)
    }
    let post_comptime = run_comptime(named.stmts, target.store, named.type_reg)
    let _ = guard_bag(post_comptime.bag, target.diag_filename, "comptime fold failed")?
    let tc_result = typecheck_program(post_comptime.stmts, named.type_reg, named.macro_origins, target.store)
    let _ = guard_bag(tc_result.bag, target.diag_filename, "type check failed")?
    let mono = monomorphize(tc_result.stmts, tc_result.trait_impls, target.store)
    let _ = guard_bag(mono.bag, target.diag_filename, "monomorphization failed")?
    Result.Ok(FrontendMono { stmts: mono.stmts, type_reg: named.type_reg })
}

/// Per-fn CGU (ps3t.8.6.1): run the frontend, then emit ONLY `fn_name`'s
/// self-contained per-fn module .ll to `out_ll` — the per-fn analogue of
/// build_binary, sharing the identical frontend then compile_one_fn_module
/// instead of whole-program codegen+link. Whole-program mode (no lib
/// roots), no coverage, no null-check instrumentation.
export fn build_fn_module(target: CompileTarget, fn_name: string, out_ll: string) -> Result<int, string> {
    let fm = frontend_to_mono(target)?
    compile_one_fn_module(fn_name, fm.stmts, out_ll, false, false, target.diag_filename, fm.type_reg, false, target.store)
}

/// Bounded-K CGU build: partition the program's fns into <= CGU_COUNT codegen
/// units (each a self-contained module), emit ONE object per non-empty unit +
/// one wrapper object (the top-level entry + __release_* definitions), then
/// link them all into the binary — the whole-program module split into bounded
/// codegen units. Each unit's object is content-cached on its members'
/// combined fingerprint, so a one-fn body edit re-emits only that fn's UNIT
/// (every other is a hit). A user-defined `main` is handled: emit_cgu_module
/// injects the __bs_top_level call into main's unit. Run-equivalent to
/// build_binary, NOT byte-identical (N modules vs one → different .ll
/// structure).
///
/// Coverage is not supported on this path (the unit/wrapper objects are
/// emitted uninstrumented and the cache key hardcodes coverage-off); a
/// coverage target is rejected up front rather than silently miscompiled.
export fn build_binary_cgu(target: CompileTarget) -> Result<string, string> {
    if target.coverage {
        return Result.Err("build_binary_cgu: coverage instrumentation is not supported on the CGU path")
    }
    let fm = frontend_to_mono(target)?
    let build_dir = "${target.project_dir}/build"
    let stem = strip_bin_suffix(target.bin_path)

    // Bounded-K CGU OBJECT cache (the incrementality): each codegen UNIT's .o
    // is keyed on the combined content fingerprint of its member fns
    // (item_sig_fp ⊕ item_body_fp ⊕ erased regime per member) ⊕ type table ⊕
    // codegen modes ⊕ toolchain, in a namespace distinct from the IR-dump
    // write side. A cache HIT reuses the stored .o and SKIPS re-emission; a
    // MISS emits the unit's module → .o and publishes it. On a one-fn body
    // edit only that fn's bucket key changes, so only that ONE unit re-emits —
    // every other unit is a hit. A compiler or codegen-flag change re-emits
    // everything (toolchain/modes are in the key).
    let cache = cache_for(target.project_dir)
    let cgu_store = fn_unit_store_for_ns(cache, "fncgu")
    let _ = fn_unit_store_init(cgu_store)
    let table_fp = type_table_fp(fm.type_reg)
    let toolchain = toolchain_fingerprint()
    let modes = "d0c0"  // debug_null_checks=false, coverage=false (CGU scope)

    // Ownership filter (ps3t.8.6.2): in library mode (AVRA_LIB_PKG_ROOT set)
    // only fns OWNED by this unit are targets — matching emit_function_bodies'
    // skip set exactly, so a not-owned fn is never collected (and thus never
    // handed to emit_cgu_module, which would Err "not found (or not owned)").
    // Empty in whole-program mode → every non-external fn collected, as before.
    let roots = parse_pkg_roots(avra_process_env_get("AVRA_LIB_PKG_ROOT"))
    let empty: List<FnTarget> = []
    let targets = collect_fn_targets(target.store, fm.stmts, empty, roots)
    // Bounded-K partitioning: group fns into <= CGU_COUNT units by a stable
    // name-hash, so each unit is one object and a body edit re-emits only its
    // unit. Empty buckets (skipped) keep bucket identity index-stable.
    let buckets = partition_targets(targets, CGU_COUNT)
    mut objs: List<string> = []
    mut bi = 0
    while bi < buckets.length {
        let bucket = buckets[bi]
        if bucket.length == 0 {
            bi = bi + 1
            continue
        }
        // The unit's cache key folds every member's identity in bucket
        // (stmts-appearance) order — the same order emit_cgu_module emits them.
        mut members: List<CguMember> = []
        for t in bucket {
            members.push(CguMember {
                name: t.name,
                sig_fp: item_sig_fp(target.store, t.id),
                body_fp: item_body_fp(target.store, t.id),
                erased: fn_target_is_erased(target.store, t.id),
            })
        }
        let key = fn_unit_key_cgu(members, table_fp, modes, toolchain)
        let cached = fn_unit_lookup(cgu_store, key)
        if cached != null {
            objs.push(cached!)
        } else {
            // Per-pid scratch name: fn_unit_publish hashes this file, so two
            // concurrent builds targeting the same bin_path must not clobber
            // each other's scratch object before it's published.
            let obj = "${stem}.cgu${string(bi)}.${string(avra_getpid())}.o"
            // Unit tag "b<i>": qualifies this unit's lambda symbol names so a
            // cached unit's lambdas can never collide with another unit's or
            // the wrapper's (the process-global lambda-id counter is cache-
            // sensitive — see emit_lambda_typed).
            let _ = emit_cgu_object(bucket, fm.stmts, obj, fm.type_reg, target.store, "b${string(bi)}")?
            let pub = fn_unit_publish(cgu_store, key, obj)
            if pub != null {
                objs.push(pub!)
            } else {
                objs.push(obj)
            }
        }
        bi = bi + 1
    }
    // The wrapper object (top-level entry + __release_* defs) changes whenever
    // the top-level code or the type set does — always re-emitted, not cached.
    let wrapper_obj = "${stem}.wrapper.${string(avra_getpid())}.o"
    let _ = emit_wrapper_object(fm.stmts, wrapper_obj, fm.type_reg, target.store)?
    objs.push(wrapper_obj)

    let link_objs = prepend_extra_objs(objs, target.extra_objs)
    let opts = default_link_options()
    // Content-keyed link cache (uzs9.3, same as the whole-program path): when
    // every unit hit AND the wrapper object's content is unchanged (both
    // depend only on the program, not the pid in the scratch filename), the
    // link inputs are byte-identical and the previously-linked binary is
    // exact — skip the ~0.5s cc against libLLVM. This keeps the CGU default
    // warm-competitive with the whole-program path it replaced.
    let opts_canonical = "stack=${opts.stack_size_hex}|llvm=${llvm_prefix_dir()}|cov=0"
    let link_key = linked_bin_key(link_objs, "${build_dir}/runtime.o",
                                  "${build_dir}/llvm_wrapper.o", opts_canonical)
    if linked_bin_lookup(cache, link_key, target.bin_path) {
        return Result.Ok(target.bin_path)
    }
    if link_objects(link_objs, "${build_dir}/runtime.o", "${build_dir}/llvm_wrapper.o",
                    target.bin_path, opts) != 0 {
        return Result.Err("link failed (cgu)")
    }
    linked_bin_publish(cache, link_key, target.bin_path)
    Result.Ok(target.bin_path)
}

/// Build a linked binary from an assembled program (ps3t.8.6.2: bounded-K CGU
/// is the DEFAULT). A non-coverage build routes through build_binary_cgu — the
/// program's fns partitioned into <= CGU_COUNT codegen units, each object
/// content-cached, so a one-fn edit re-links from mostly-cached objects. This
/// is an intended-ir-change vs the old whole-program single-module build (N
/// modules vs one → different .ll structure), verified run-equivalent, not
/// byte-identical. Coverage is NOT supported on the CGU path (per-unit objects
/// are emitted uninstrumented), so a coverage target uses the whole-program
/// instrumented path below.
///
/// NOTE the seed/selfhost binary is NOT built through here — it is
/// `bs2 compile main.av` → a single self-contained main.av.ll (compile_program)
/// → llc+link, which MUST stay whole-program (the seed is one self-contained
/// .ll). This flip covers the binary-linking path (test binaries); the
/// selfhost fixed point (bs2==bs3, a compile_program .ll diff) is unaffected.
export fn build_binary(target: CompileTarget) -> Result<string, string> {
    if !target.coverage {
        return build_binary_cgu(target)
    }

    let fm = frontend_to_mono(target)?
    let build_dir = "${target.project_dir}/build"

    // Coverage path: lower instrprof intrinsics via opt, then llc to
    // .o, then link with clang_rt.profile_osx. The 16K-page-aligned
    // profile sections are essential on Darwin/arm64 — without them
    // llvm-profdata reports zero counters.
    let stem = strip_bin_suffix(target.bin_path)
    let ir_path = "${stem}.ll"
    let cov_ll = "${stem}.cov.ll"
    let obj_path = "${stem}.o"
    let cov_dir = "${build_dir}/coverage"
    avra_shell_exec("mkdir -p ${cov_dir}")
    let _ = codegen_and_emit_ir_cov(fm.stmts, ir_path, fm.type_reg, "${stem}.av", target.store, target.project_dir)?
    let llvm_prefix = llvm_prefix_dir()
    let opt_args = "[\"-passes=instrprof\", \"-mtriple=arm64-apple-macosx\", \"-o\", \"${cov_ll}\", \"-S\", \"${ir_path}\"]"
    if avra_process_forward("${llvm_prefix}/bin/opt", opt_args, "") != 0 {
        return Result.Err("opt instrprof lowering failed")
    }
    let llc_args = "[\"-O2\", \"-relocation-model=pic\", \"-filetype=obj\", \"${cov_ll}\", \"-o\", \"${obj_path}\"]"
    if avra_process_forward("${llvm_prefix}/bin/llc", llc_args, "") != 0 {
        return Result.Err("llc failed")
    }
    let darwin_dir = avra_shell_exec("ls -1 ${llvm_prefix}/lib/clang | head -1").trim()
    let prof_lib_dir = "${llvm_prefix}/lib/clang/${darwin_dir}/lib/darwin"
    let cov_libs = "-L${prof_lib_dir}"
    let cov_link_objs = prepend_extra_objs([obj_path], target.extra_objs)
    if link_objects_with_coverage(cov_link_objs, "${build_dir}/runtime.o", "${build_dir}/llvm_wrapper.o",
                                  target.bin_path, cov_libs, default_link_options()) != 0 {
        return Result.Err("link failed (coverage)")
    }
    Result.Ok(target.bin_path)
}

/// Combine the per-shard's own .o with any extra producer-library
/// .o paths. The shard's own .o stays first so its `main` (and any
/// per-test symbols) take precedence over duplicates from a stale
/// dep .o. Returns a fresh list — input lists aren't mutated.
fn prepend_extra_objs(own: List<string>, extras: List<string>) -> List<string> {
    if extras.length == 0 { return own }
    mut out = own
    mut i = 0
    while i < extras.length {
        out.push(extras[i])
        i = i + 1
    }
    out
}

/// Drop a trailing `.bin` so callers can build sibling intermediate
/// paths (`.o`, `.ll`). Returns the input unchanged when there's no
/// suffix — caller passed a stem already.
fn strip_bin_suffix(path: string) -> string {
    let suffix = ".bin"
    if path.length >= suffix.length {
        let tail = path.substring(path.length - suffix.length, path.length)
        if tail == suffix {
            return path.substring(0, path.length - suffix.length)
        }
    }
    path
}
