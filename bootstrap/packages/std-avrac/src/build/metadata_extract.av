// WHY: Walk a parsed StmtList and produce a UnitMetadata for it.
// Bridge from the in-memory AST to the metadata.bin codec — every
// exported public-surface item (type, fn, const, impl) becomes one
// entry in the corresponding section list.
//
// Tracked under forge-crafting-intepreters-iinq.

use core.ast.{
    Stmt, StmtList, SStmt, sstmt_at, Expr, ParamList, FieldList, VariantList, TypeParamList, ValueType,
    AnnotationList, stmt_unwrap,
}
use build.metadata.{
    UnitMetadata, TypeDeclList, FnDeclList, ConstDeclList, ImplDeclList,
    TypeDeclEntry, FnDeclEntry, ConstDeclEntry, ImplDeclEntry,
    TypeDeclKind, ConstValueKind,
    MetaTraitMethodList, ImplMethodRefList,
    sym_id_for, unit_metadata_new,
}
use parse.lexer.{parse_int_literal}

// Internal accumulator — each walk step folds into this and returns
// the updated record. Lists grow via prepend so traversal stays
// O(stmts); a final reverse pass restores source order.
type ExtractAcc = {
    types: TypeDeclList,
    fns: FnDeclList,
    consts: ConstDeclList,
    impls: ImplDeclList,
}

fn empty_acc() -> ExtractAcc {
    ExtractAcc {
        types: TypeDeclList.End,
        fns: FnDeclList.End,
        consts: ConstDeclList.End,
        impls: ImplDeclList.End,
    }
}

// Public entry. `unit_name` becomes the module prefix used to
// qualify every symbol (so the same fn `add` in a different module
// gets a distinct sym_id). `fingerprint` is the 32-byte sha256 of
// the source set, computed by the build driver upstream.
export fn extract_unit_metadata(unit_name: string, fingerprint: bytes, stmts: StmtList) -> UnitMetadata {
    // When the source is already wrapped in `Module(unit_name, body)`
    // (the lib path with --module_path), descend into body to avoid
    // double-prefixing qns (e.g. `@std::avrac::@std::avrac::core::X`).
    // Otherwise walk all stmts with current_module=unit_name so bare
    // decls still get qualified against the unit they belong to.
    let inner = unwrap_outer_unit_module(stmts, unit_name)
    let acc = walk_stmts(empty_acc(), inner, unit_name, false)
    UnitMetadata {
        unit_name: unit_name,
        fingerprint: fingerprint,
        types: reverse_type_list(acc.types, TypeDeclList.End),
        fns: reverse_fn_list(acc.fns, FnDeclList.End),
        consts: reverse_const_list(acc.consts, ConstDeclList.End),
        impls: reverse_impl_list(acc.impls, ImplDeclList.End),
    }
}

/// Extract metadata for ONLY the decls that came from `target_file`.
/// Walks the same resolved StmtList that `extract_unit_metadata` does
/// but accumulates a TypeDecl / FnDecl / ConstDecl / ImplDecl only
/// when its enclosing SStmt.file matches the target. Module wraps and
/// Annotated wrappers are always traversed (so a target file's decls
/// reachable through nested mod boundaries still land), but their
/// own SStmt.file is ignored — only the leaf decl's file gates
/// accumulation.
///
/// This is the per-file granularity foundation for g2eo: editing
/// one .av file invalidates only that file's metadata sidecar, not
/// the whole package's. unit_name keeps the qualified-name prefix
/// stable across all per-file slices so consumers see byte-identical
/// qns whether they load the package's whole-unit metadata or the
/// per-file slice.
export fn extract_per_file_metadata(unit_name: string, target_file: string, fingerprint: bytes, stmts: StmtList) -> UnitMetadata {
    let inner = unwrap_outer_unit_module(stmts, unit_name)
    let acc = walk_stmts_for_file(empty_acc(), inner, unit_name, false, target_file)
    UnitMetadata {
        unit_name: unit_name,
        fingerprint: fingerprint,
        types: reverse_type_list(acc.types, TypeDeclList.End),
        fns: reverse_fn_list(acc.fns, FnDeclList.End),
        consts: reverse_const_list(acc.consts, ConstDeclList.End),
        impls: reverse_impl_list(acc.impls, ImplDeclList.End),
    }
}

fn walk_stmts_for_file(acc: ExtractAcc, stmts: StmtList, current_module: string, exported: bool, target_file: string) -> ExtractAcc {
    match stmts {
        .End -> acc
        .Node(ss, next) -> {
            let after = walk_ss_for_file(acc, ss, current_module, exported, target_file)
            walk_stmts_for_file(after, next, current_module, exported, target_file)
        }
    }
}

fn walk_ss_for_file(acc: ExtractAcc, ss: SStmt, current_module: string, exported: bool, target_file: string) -> ExtractAcc {
    match ss.node {
        // Module wraps are structural — always recurse, regardless of
        // SStmt.file. The wrap's file marks where the `mod foo` decl
        // lived; the body's own SStmts carry foo.av's path.
        .Module(name, body) -> {
            let sub_path = qualify(current_module, name)
            walk_stmts_for_file(acc, body, sub_path, false, target_file)
        }
        // Annotated transparently delegates. The Annotated SStmt's
        // file matches the inner stmt's file (parser stamps both),
        // so the gating happens at the inner stmt's recursion.
        .Annotated(annots, inner) -> {
            let is_export = exported || annotation_has_export(annots)
            let inner_ss = sstmt_at(inner, ss.line, ss.col, ss.file)
            walk_ss_for_file(acc, inner_ss, current_module, is_export, target_file)
        }
        // Leaf decl: gate on file match.
        _ -> {
            if ss.file == target_file {
                walk_stmt(acc, ss.node, current_module, exported)
            } else {
                acc
            }
        }
    }
}

// Find the `Module(unit_name, body)` wrap in `stmts` and return its
// body — the unit's own decls, separate from any sibling Module wraps
// the resolver prepended for `use @pkg` paths. When no such wrap
// exists the source is treated as a flat unit, returning `stmts`
// unchanged so the legacy single-file path still works.
fn unwrap_outer_unit_module(stmts: StmtList, unit_name: string) -> StmtList {
    if unit_name == "" { return stmts }
    let body = find_unit_module_body(stmts, unit_name)
    match body {
        .End -> stmts
        _ -> body
    }
}

fn find_unit_module_body(stmts: StmtList, unit_name: string) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, rest) -> {
            let inner = stmt_unwrap(ss.node)
            match inner {
                .Module(name, body) -> {
                    if name == unit_name {
                        body
                    } else {
                        find_unit_module_body(rest, unit_name)
                    }
                }
                _ -> find_unit_module_body(rest, unit_name)
            }
        }
    }
}

fn reverse_type_list(xs: TypeDeclList, acc: TypeDeclList) -> TypeDeclList {
    match xs {
        .End -> acc
        .Node(e, next) -> reverse_type_list(next, TypeDeclList.Node(e, acc))
    }
}

fn reverse_fn_list(xs: FnDeclList, acc: FnDeclList) -> FnDeclList {
    match xs {
        .End -> acc
        .Node(e, next) -> reverse_fn_list(next, FnDeclList.Node(e, acc))
    }
}

fn reverse_const_list(xs: ConstDeclList, acc: ConstDeclList) -> ConstDeclList {
    match xs {
        .End -> acc
        .Node(e, next) -> reverse_const_list(next, ConstDeclList.Node(e, acc))
    }
}

fn reverse_impl_list(xs: ImplDeclList, acc: ImplDeclList) -> ImplDeclList {
    match xs {
        .End -> acc
        .Node(e, next) -> reverse_impl_list(next, ImplDeclList.Node(e, acc))
    }
}

fn walk_stmts(acc: ExtractAcc, stmts: StmtList, current_module: string, exported: bool) -> ExtractAcc {
    match stmts {
        .End -> acc
        .Node(ss, next) -> {
            let after = walk_stmt(acc, ss.node, current_module, exported)
            walk_stmts(after, next, current_module, exported)
        }
    }
}

fn qualify(current_module: string, name: string) -> string {
    if current_module == "" { return name }
    // resolve_names rewrites TypeDecl/EnumDecl/etc. names to their
    // fully-qualified form (e.g. `@std::lsp::LspPos`) BEFORE the
    // metadata extractor runs. Re-qualifying would double the prefix
    // — `@std::lsp::@std::lsp::LspPos` — which downstream synthesise
    // can't dedup. Detect already-qualified names by the presence of
    // `::` and return them unchanged.
    if name.index_of("::") >= 0 { return name }
    "${current_module}::${name}"
}

fn annotation_has_export(annots: AnnotationList) -> bool {
    match annots {
        .End -> false
        .Node(name, _, next) -> {
            if name == "export" { return true }
            annotation_has_export(next)
        }
    }
}

fn walk_stmt(acc: ExtractAcc, stmt: Stmt, current_module: string, exported: bool) -> ExtractAcc {
    match stmt {
        .Annotated(annots, inner) -> {
            let is_export = exported || annotation_has_export(annots)
            walk_stmt(acc, inner, current_module, is_export)
        }
        .Module(name, body) -> {
            let sub_path = qualify(current_module, name)
            walk_stmts(acc, body, sub_path, false)
        }
        .TypeDecl(name, type_params, fields) -> {
            let qn = qualify(current_module, name)
            let entry = TypeDeclEntry {
                sym_id: sym_id_for(qn),
                kind: TypeDeclKind.StructDecl,
                name: qn,
                type_params: type_params,
                fields: fields,
                variants: VariantList.End,
                inner_vt: ValueType.Unknown,
                methods: MetaTraitMethodList.End,
            }
            ExtractAcc { types: TypeDeclList.Node(entry, acc.types), fns: acc.fns, consts: acc.consts, impls: acc.impls }
        }
        .ShapeDecl(name, fields) -> {
            let qn = qualify(current_module, name)
            let entry = TypeDeclEntry {
                sym_id: sym_id_for(qn),
                kind: TypeDeclKind.ShapeDecl,
                name: qn,
                type_params: TypeParamList.End,
                fields: fields,
                variants: VariantList.End,
                inner_vt: ValueType.Unknown,
                methods: MetaTraitMethodList.End,
            }
            ExtractAcc { types: TypeDeclList.Node(entry, acc.types), fns: acc.fns, consts: acc.consts, impls: acc.impls }
        }
        .EnumDecl(name, type_params, variants) -> {
            let qn = qualify(current_module, name)
            let entry = TypeDeclEntry {
                sym_id: sym_id_for(qn),
                kind: TypeDeclKind.EnumDecl,
                name: qn,
                type_params: type_params,
                fields: FieldList.End,
                variants: variants,
                inner_vt: ValueType.Unknown,
                methods: MetaTraitMethodList.End,
            }
            ExtractAcc { types: TypeDeclList.Node(entry, acc.types), fns: acc.fns, consts: acc.consts, impls: acc.impls }
        }
        .NewtypeDecl(name, inner_vt) -> {
            let qn = qualify(current_module, name)
            let entry = TypeDeclEntry {
                sym_id: sym_id_for(qn),
                kind: TypeDeclKind.NewtypeDecl,
                name: qn,
                type_params: TypeParamList.End,
                fields: FieldList.End,
                variants: VariantList.End,
                inner_vt: inner_vt,
                methods: MetaTraitMethodList.End,
            }
            ExtractAcc { types: TypeDeclList.Node(entry, acc.types), fns: acc.fns, consts: acc.consts, impls: acc.impls }
        }
        .UnionAliasDecl(name, type_vt) -> {
            let qn = qualify(current_module, name)
            let entry = TypeDeclEntry {
                sym_id: sym_id_for(qn),
                kind: TypeDeclKind.UnionAliasDecl,
                name: qn,
                type_params: TypeParamList.End,
                fields: FieldList.End,
                variants: VariantList.End,
                inner_vt: type_vt,
                methods: MetaTraitMethodList.End,
            }
            ExtractAcc { types: TypeDeclList.Node(entry, acc.types), fns: acc.fns, consts: acc.consts, impls: acc.impls }
        }
        .TraitDecl(name, methods) -> {
            let qn = qualify(current_module, name)
            let entry = TypeDeclEntry {
                sym_id: sym_id_for(qn),
                kind: TypeDeclKind.TraitDecl,
                name: qn,
                type_params: TypeParamList.End,
                fields: FieldList.End,
                variants: VariantList.End,
                inner_vt: ValueType.Unknown,
                methods: extract_trait_methods(methods),
            }
            ExtractAcc { types: TypeDeclList.Node(entry, acc.types), fns: acc.fns, consts: acc.consts, impls: acc.impls }
        }
        .Function(name, type_params, params, ret_vt, _) -> {
            let qn = qualify(current_module, name)
            let entry = FnDeclEntry {
                sym_id: sym_id_for(qn),
                name: qn,
                exported: exported,
                is_extern: false,
                type_params: type_params,
                params: params,
                ret: ret_vt,
            }
            ExtractAcc { types: acc.types, fns: FnDeclList.Node(entry, acc.fns), consts: acc.consts, impls: acc.impls }
        }
        .ExternFn(name, params, ret_vt) -> {
            // Qualify the extern by its declaring module so the
            // synthesizer can re-emit it at the same nested-module
            // path the source-parse path resolves through. The local
            // name (used at C ABI emit time) is recovered via
            // local_name() at synthesis time. Without this, every
            // extern lands flat at the unit's root and consumer
            // `use @pkg.sub.X` paths fail (9ixv).
            let qn = qualify(current_module, name)
            let entry = FnDeclEntry {
                sym_id: sym_id_for(qn),
                name: qn,
                exported: true,
                is_extern: true,
                type_params: TypeParamList.End,
                params: params,
                ret: ret_vt,
            }
            ExtractAcc { types: acc.types, fns: FnDeclList.Node(entry, acc.fns), consts: acc.consts, impls: acc.impls }
        }
        .Const(name, ty_vt, init) -> {
            let qn = qualify(current_module, name)
            let parts = extract_const_value(init)
            let entry = ConstDeclEntry {
                sym_id: sym_id_for(qn),
                name: qn,
                exported: exported,
                ty: ty_vt,
                value_kind: parts.kind,
                int_value: parts.int_val,
                str_value: parts.str_val,
            }
            ExtractAcc { types: acc.types, fns: acc.fns, consts: ConstDeclList.Node(entry, acc.consts), impls: acc.impls }
        }
        .Impl(impl_name, methods) -> {
            let pair = split_impl_name(impl_name)
            if pair.has_trait {
                let trait_qn = qualify(current_module, pair.trait_name)
                let type_qn = qualify(current_module, pair.type_name)
                let entry = ImplDeclEntry {
                    trait_sym_id: sym_id_for(trait_qn),
                    trait_name: trait_qn,
                    type_sym_id: sym_id_for(type_qn),
                    type_name: type_qn,
                    methods: extract_impl_methods(methods, type_qn),
                }
                ExtractAcc { types: acc.types, fns: acc.fns, consts: acc.consts, impls: ImplDeclList.Node(entry, acc.impls) }
            } else {
                acc
            }
        }
        _ -> acc
    }
}

// "Trait:Type" → (trait, type, has_trait=true); "Type" → (Type, Type, has_trait=false).
// Used to recover the impl_decl shape from the mangled stmt name.
type ImplNamePair = {
    trait_name: string,
    type_name: string,
    has_trait: bool,
}

fn split_impl_name(impl_name: string) -> ImplNamePair {
    // Skip past `::` so qualified type names like
    // `@std::avrac::build::metadata::BytesWriter` (an inherent impl
    // post-resolver) aren't mis-parsed as `@std:avrac::…`. Mirrors
    // resolve.names.find_single_colon, kept inline to avoid a
    // cross-feature dependency.
    let idx = find_single_colon_after_qualification(impl_name)
    if idx < 0 {
        return ImplNamePair { trait_name: impl_name, type_name: impl_name, has_trait: false }
    }
    let t = impl_name.substring(0, idx)
    let ty = impl_name.substring(idx + 1, impl_name.length)
    ImplNamePair { trait_name: t, type_name: ty, has_trait: true }
}

fn find_single_colon_after_qualification(s: string) -> int {
    mut i = 0
    while i < s.length {
        if s.byte(i) == 0x3A {
            if i + 1 < s.length && s.byte(i + 1) == 0x3A {
                i = i + 2
                continue
            }
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn extract_trait_methods(stmts: StmtList) -> MetaTraitMethodList {
    match stmts {
        .End -> MetaTraitMethodList.End
        .Node(ss, next) -> {
            let inner = stmt_unwrap(ss.node)
            match inner {
                .Function(name, _, params, ret_vt, _) -> {
                    MetaTraitMethodList.Node(name, params, ret_vt, extract_trait_methods(next))
                }
                .ExternFn(name, params, ret_vt) -> {
                    MetaTraitMethodList.Node(name, params, ret_vt, extract_trait_methods(next))
                }
                _ -> extract_trait_methods(next)
            }
        }
    }
}

fn extract_impl_methods(stmts: StmtList, type_qn: string) -> ImplMethodRefList {
    match stmts {
        .End -> ImplMethodRefList.End
        .Node(ss, next) -> {
            let inner = stmt_unwrap(ss.node)
            match inner {
                // Impl-method names parse to mangled "Type__method"
                // form via features::impl_decl::parser. The
                // post-mangle method name is everything after the
                // final "__".
                .Function(mangled, _, _, _, _) -> {
                    let method_name = strip_mangle(mangled)
                    let fn_qn = qualify(type_qn, method_name)
                    ImplMethodRefList.Node(method_name, sym_id_for(fn_qn), extract_impl_methods(next, type_qn))
                }
                _ -> extract_impl_methods(next, type_qn)
            }
        }
    }
}

fn strip_mangle(name: string) -> string {
    let parts = name.split("__")
    if parts.length > 1 {
        parts[parts.length - 1]
    } else {
        name
    }
}

// Extract the literal value from a const initializer expression.
// Anything that isn't a bare literal falls through to UnknownValue
// — same opacity guarantee an imported fn signature gives.
type ConstValueParts = {
    kind: ConstValueKind,
    int_val: int,
    str_val: string,
}

fn extract_const_value(e: Expr) -> ConstValueParts {
    match e {
        .Number(text) -> ConstValueParts {
            kind: ConstValueKind.IntValue,
            int_val: parse_int_literal(text),
            str_val: "",
        }
        .Bool(text) -> ConstValueParts {
            kind: ConstValueKind.BoolValue,
            int_val: if text == "true" { 1 } else { 0 },
            str_val: "",
        }
        .String(text) -> ConstValueParts {
            kind: ConstValueKind.StrValue,
            int_val: 0,
            str_val: strip_quotes(text),
        }
        .Grouping(inner) -> extract_const_value(inner)
        .Unary(_, inner) -> extract_const_value(inner)
        _ -> ConstValueParts {
            kind: ConstValueKind.UnknownValue,
            int_val: 0,
            str_val: "",
        }
    }
}

// `Expr.String` keeps the surrounding quotes so the renderer can
// round-trip; the metadata wire form stores just the body.
fn strip_quotes(quoted: string) -> string {
    if quoted.length < 2 { return quoted }
    let first = quoted.byte(0)
    let last = quoted.byte(quoted.length - 1)
    if first == 0x22 && last == 0x22 {
        return quoted.substring(1, quoted.length - 1)
    }
    quoted
}

// ── 9ixv-followup / g2eo prep: per-file source discovery ─────────────
//
// Walks a resolved StmtList and collects every distinct `SStmt.file`
// value it encounters. The parser stamps each statement with the path
// of the .av file it was parsed from (parse/mod.av:481 sstmt_at), and
// resolve_module_files preserves that stamp when inlining sub-mod
// bodies. The result is the canonical list of source files contributing
// to the unit — the foundation for emitting per-file metadata sidecars
// (each gets its own .meta.bin so editing one mod doesn't invalidate
// every other mod's parse cache).
//
// Used today only by tests; the build driver picks it up under g2eo.

export fn collect_source_files(stmts: StmtList) -> List<string> {
    mut acc = []
    walk_files(stmts, acc)
}

fn walk_files(stmts: StmtList, acc: List<string>) -> List<string> {
    mut local = acc
    match stmts {
        .End -> local
        .Node(ss, next) -> {
            if ss.file != "" && !files_contain(local, ss.file) {
                local.push(ss.file)
            }
            let after_inner = walk_files_in_stmt(ss.node, local)
            walk_files(next, after_inner)
        }
    }
}

// Recurse into Module bodies (and Annotated wrappers) so files
// reached only through nested `mod` decls still get picked up.
// Other Stmt variants don't carry sub-statement lists with their
// own file stamps — function bodies / blocks do, but those stamps
// match the enclosing fn's file, so re-collecting from there is
// redundant and slow. The trade-off: declarations are what the
// metadata extractor cares about, so Module + Annotated cover the
// public-surface walk.
fn walk_files_in_stmt(stmt: Stmt, acc: List<string>) -> List<string> {
    match stmt {
        .Module(_, body) -> walk_files(body, acc)
        .Annotated(_, inner) -> walk_files_in_stmt(inner, acc)
        _ -> acc
    }
}

fn files_contain(xs: List<string>, target: string) -> bool {
    mut i = 0
    while i < xs.length {
        if xs[i] == target { return true }
        i = i + 1
    }
    false
}
