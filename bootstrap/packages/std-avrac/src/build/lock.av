// WHY: avra.lock — pinned dependency state for reproducible builds.
//
// Cargo's Cargo.lock model: a project's avra.toml lists declared deps;
// avra.lock records the EXACT resolved state (each unit's name, root
// path, and content fingerprint) so checking the file into source
// control gives every consumer the same build.
//
// v1 supports path deps only. The lockfile is therefore mostly a
// cached fingerprint table — re-running bs2 build with a fresh
// avra.lock skips the dep tree's content hashing pass when nothing
// changed. Future versioned deps will add resolver pinning here.
//
// Format: TOML-shaped, hand-rolled (we already serialise dep tables
// for the manifest reader; same idiom). One entry per unit:
//
//     # avra.lock
//     # generated by bs2 — DO NOT EDIT by hand
//     # source: avra.toml
//     # generated: 2026-04-30T03:14:15Z
//
//     [[unit]]
//     name = "@std/cli"
//     path = "packages/std-cli"
//     fp   = "abc123…"
//
//     [[unit]]
//     name = "@std/avrac"
//     path = "packages/std-avrac"
//     fp   = "def456…"
//
// Tracking ticket: forge-crafting-intepreters-8tts.

use core.runtime.{
    avra_selfhost_file_exists,
    avra_selfhost_read_file,
    avra_selfhost_write_file,
}
use build.graph.{Unit, UnitList, build_graph, DepGraph, unit_list_length}
use build.fingerprint.{Fingerprint}
use @std.crypto.{sha256_file}

/// One record per unit in the lockfile. `fp` is the SHA-256 of the
/// unit's avra.toml file content — a coarse but stable proxy for
/// "this dep at this version" until proper version resolution lands.
export type LockEntry = {
    name: string,
    path: string,
    fp: string,
}

/// In-memory view of avra.lock.
///
/// @field path     absolute path to the lockfile we read / will write.
/// @field found    true if the file existed at read time; false when
///                 callers asked for a default (no diagnostic emitted).
/// @field entries  one per dep unit, in topological order (matching
///                 graph.build_graph's output).
export type Lockfile = {
    path: string,
    found: bool,
    entries: List<LockEntry>,
}

/// Read avra.lock from `dir`. Returns a default (found=false, no
/// entries) when missing — callers can treat that as "regenerate".
export fn read_lock(dir: string) -> Lockfile {
    let lock_path = ensure_trailing_slash(dir) + "avra.lock"
    if !avra_selfhost_file_exists(lock_path) {
        return Lockfile { path: lock_path, found: false, entries: [] }
    }
    let content = avra_selfhost_read_file(lock_path)
    Lockfile {
        path: lock_path,
        found: true,
        entries: parse_lock_entries(content),
    }
}

fn parse_lock_entries(content: string) -> List<LockEntry> {
    // Walk lines, accumulate `[[unit]]` blocks. Order preserved via
    // List<LockEntry>.push (source-order append, no reverse pass).
    mut entries = []
    mut name = ""
    mut path = ""
    mut fp = ""
    mut in_block = false
    mut start = 0
    mut i = 0
    while i <= content.length {
        let at_end = i == content.length
        let is_nl = !at_end && content.byte(i) == 10
        if at_end || is_nl {
            let raw = content.substring(start, i).trim()
            if raw == "[[unit]]" {
                if in_block && name != "" {
                    entries.push(LockEntry { name: name, path: path, fp: fp })
                }
                in_block = true
                name = ""
                path = ""
                fp = ""
            } else if in_block && raw.length > 0 && !raw.starts_with("#") {
                let eq = raw.index_of("=")
                if eq > 0 {
                    let key = raw.substring(0, eq).trim()
                    let val = unquote(raw.substring(eq + 1, raw.length).trim())
                    if key == "name" { name = val }
                    else if key == "path" { path = val }
                    else if key == "fp" { fp = val }
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    if in_block && name != "" {
        entries.push(LockEntry { name: name, path: path, fp: fp })
    }
    entries
}

fn unquote(s: string) -> string {
    if s.length >= 2 && s.starts_with("\"") && s.ends_with("\"") {
        return s.substring(1, s.length - 1)
    }
    s
}

/// Build a fresh Lockfile from the current project's dep graph.
/// Caller passes `header_meta` (timestamp, generator info) for the
/// file's leading comment so test fixtures can emit deterministic
/// content.
export fn lockfile_from_graph(dir: string, graph: DepGraph) -> Lockfile {
    let lock_path = ensure_trailing_slash(dir) + "avra.lock"
    Lockfile {
        path: lock_path,
        found: false,
        entries: collect_entries(graph.units),
    }
}

fn collect_entries(units: UnitList) -> List<LockEntry> {
    mut acc = []
    mut cur = units
    mut keep_going = true
    while keep_going {
        match cur {
            .End -> keep_going = false,
            .Node(u, rest) -> {
                let manifest_path = ensure_trailing_slash(u.project_root) + "avra.toml"
                acc.push(LockEntry {
                    name: u.name,
                    path: u.project_root,
                    fp: sha256_file(manifest_path),
                })
                cur = rest
            }
        }
    }
    acc
}

/// Serialise a Lockfile to TOML-shaped text. Two-line header so a
/// human glancing at the file knows what produced it. The body is
/// `[[unit]]` blocks in topological order.
export fn render_lock(lock: Lockfile, generator: string) -> string {
    mut out = "# avra.lock\n# generated by " + generator + " — DO NOT EDIT by hand\n\n"
    mut i = 0
    while i < lock.entries.length {
        let e = lock.entries[i]
        out = out + "[[unit]]\n"
        out = out + "name = \"" + e.name + "\"\n"
        out = out + "path = \"" + e.path + "\"\n"
        out = out + "fp   = \"" + e.fp + "\"\n\n"
        i = i + 1
    }
    out
}

/// Write a Lockfile to disk. Returns true on success.
export fn write_lock(lock: Lockfile, generator: string) -> bool {
    let body = render_lock(lock, generator)
    avra_selfhost_write_file(lock.path, body) != 0
}

/// True when every entry in `lock` matches the current on-disk
/// content (the recorded fp equals the freshly-hashed avra.toml).
/// Use to short-circuit the full graph walk when nothing has changed.
export fn lock_is_fresh(lock: Lockfile) -> bool {
    if !lock.found { return false }
    mut i = 0
    while i < lock.entries.length {
        let e = lock.entries[i]
        let manifest_path = ensure_trailing_slash(e.path) + "avra.toml"
        if sha256_file(manifest_path) != e.fp { return false }
        i = i + 1
    }
    true
}

fn ensure_trailing_slash(s: string) -> string {
    if s.length == 0 { return "/" }
    let last = s.substring(s.length - 1, s.length)
    if last == "/" { s } else { s + "/" }
}
