// WHY: in-Avra worker pool — drop-in replacement for `xargs -P`
// style parallel-N execution. Each command runs in its own
// subprocess (hermetic isolation: a crash in one job can't poison
// the others), up to `jobs` concurrent workers. As workers finish,
// the pool reaps them and dispatches the next queued command.
//
// Foundation for the future per-mod build dispatcher (g2eo level-2):
// once each .av file is its own unit with its own fingerprint, the
// build driver feeds N `bs2 compile` commands into pool_run and
// waits. Cargo-style hermetic worker isolation per spec axis 18.
//
// Tracking ticket: forge-crafting-intepreters-e20h.
//
// Key shape contracts:
//   - Commands are full shell strings; the pool wraps each in
//     `/bin/sh -c <cmd>` so callers can compose `cd path && build...`
//     without escaping arg lists.
//   - Returns the worst exit code observed across all workers (0 iff
//     every worker exited 0). Callers wanting per-job rc need a
//     marker-file pattern.
//   - Polling cadence is 50ms — small enough that short jobs reap
//     promptly, large enough to not burn CPU on the polling loop.

extern fn avra_process_spawn_bg(cmd: string, args_json: string, opts_json: string) -> int
extern fn avra_process_is_alive(handle: int) -> int
extern fn avra_process_wait(handle: int) -> string
extern fn avra_sleep_ms(ms: int)
extern fn avra_parse_int(s: string) -> int
extern fn avra_uptime_ms() -> int
extern fn avra_process_env_get(name: string) -> string

use @std.json.{json_str}
use resources.{MemGovernor, governor_width_only, ResourceSnapshot, resource_snapshot_for_test}

fn pool_max_rc(a: int, b: int) -> int {
    if a > b { a } else { b }
}

// Worker slot. `handle = -1` means idle; otherwise it's the handle
// returned by avra_process_spawn_bg. `started_idx` is the queue
// index that worker is processing (only used for diagnostics).
type Worker = {
    handle: int,
    started_idx: int,
}

fn idle_worker() -> Worker { Worker { handle: 0 - 1, started_idx: 0 - 1 } }

fn workers_init(n: int) -> List<Worker> {
    mut ws: List<Worker> = []
    mut i = 0
    while i < n {
        ws.push(idle_worker())
        i = i + 1
    }
    ws
}

fn workers_has_idle(ws: List<Worker>) -> bool {
    mut i = 0
    while i < ws.length {
        if ws[i].handle < 0 { return true }
        i = i + 1
    }
    false
}

// In-flight count — what the admission governor budgets against.
// The slugs of the units currently IN FLIGHT (t-2fe6).
//
// `[pool] 113/150 done, 3 in flight` says a run wedged but not WHICH units
// wedged, and a killed run flushes no per-shard output at all — so the
// heartbeat is the only progress signal, and without names it supports an
// inference and nothing more. Three separate investigations of the same hang
// stalled on exactly that gap. `Worker.started_idx` already indexes the slug
// list, so the names cost nothing to carry.
/// The unit's identity RECOVERED FROM ITS COMMAND, for the pools that carry no
/// slug list.
///
/// Every pooled command redirects to a per-unit log — `… > "<dir>/<slug>.log"
/// 2>&1` — so the log's basename IS the slug, already in the string we hold.
/// That is why this reads the log path rather than guessing at the command's
/// shape: it is the one token guaranteed to name the unit.
///
/// Returns "" when the command has no `.log` redirect; the caller falls back to
/// the index rather than inventing a name.
fn cmd_unit_name(cmd: string) -> string {
    let at = cmd.index_of(".log")
    if at <= 0 { return "" }
    mut start = 0
    mut i = 0
    while i < at {
        let c = cmd.substring(i, i + 1)
        if c == "/" { start = i + 1 }
        i = i + 1
    }
    if start >= at { return "" }
    cmd.substring(start, at)
}

/// The units currently IN FLIGHT, named (t-2fe6).
///
/// NAMES, NOT INDICES — the whole point. `[pool] 113/150 done, 3 in flight` says
/// a run wedged but not WHICH units wedged, and a killed run flushes no
/// per-shard output at all, so the heartbeat is the only progress signal.
///
/// The first cut fell back to the bare command INDEX whenever the slug list was
/// empty — and the pools that actually WEDGE pass `[]` (`pool_run` and
/// `pool_run_resource_admitted` both call `pool_run_core` with no slugs), so the
/// naming never fired on the paths that needed it. Two consecutive evictions on
/// #1338 reported `[#25, #23, #24, #18]`, which identifies a unit only if you
/// can reconstruct the dispatch order. Recovering the name from the COMMAND
/// fixes every caller at once and needs no signature change upstream.
fn workers_active_slugs(ws: List<Worker>, slugs: List<string>, commands: List<string>) -> string {
    mut out = ""
    mut i = 0
    while i < ws.length {
        if ws[i].handle >= 0 {
            let idx = ws[i].started_idx
            // An EMPTY slug counts as unavailable, not as a name: the list
            // length can be right while an entry is "", and that would render
            // `in flight [, ]` — silently defeating the identification this
            // whole line exists to provide.
            let slugged = idx >= 0 && idx < slugs.length && slugs[idx] != ""
            let derived = if slugged { "" } else if idx >= 0 && idx < commands.length { cmd_unit_name(commands[idx]) } else { "" }
            let name = if slugged { slugs[idx] } else if derived != "" { derived } else { "#" + string(idx) }
            out = if out == "" { name } else { out + ", " + name }
        }
        i = i + 1
    }
    out
}

fn workers_active(ws: List<Worker>) -> int {
    mut n = 0
    mut i = 0
    while i < ws.length {
        if ws[i].handle >= 0 { n = n + 1 }
        i = i + 1
    }
    n
}

// Replace the first idle worker with a freshly-spawned one. Mutates
// the list in-place via `.set` — no rebuild-on-every-dispatch like
// the prior linked-list shape required.
fn workers_dispatch(ws: List<Worker>, handle: int, started_idx: int) {
    mut local = ws
    for (i, w) in local.enumerate() {
        if w.handle < 0 {
            local.set(i, Worker { handle, started_idx })
            return
        }
    }
}

type ReapResult = {
    completed: int,
    max_rc: int,
}

// Walk every active worker; when avra_process_is_alive returns 0 the
// child has exited, so wait() collects its rc and the slot is freed
// in-place (idle_worker overwrites the entry). The shared `ws` list
// is mutated; caller threads its own state across reap calls.
fn workers_reap(ws: List<Worker>) -> ReapResult {
    mut local = ws
    mut completed = 0
    mut max_rc = 0
    for (i, w) in local.enumerate() {
        if w.handle >= 0 && avra_process_is_alive(w.handle) == 0 {
            let json = avra_process_wait(w.handle)
            let rc = pool_extract_rc(json)
            local.set(i, idle_worker())
            completed = completed + 1
            max_rc = pool_max_rc(max_rc, rc)
        }
    }
    ReapResult { completed, max_rc }
}

// avra_process_wait returns JSON `{"stdout":...,"stderr":...,"code":N}`.
// Pull the int after the `"code":` key. Defaults to 0 if the key is
// absent (won't happen in practice but keep the failure mode safe).
export fn pool_extract_rc(wait_json: string) -> int {
    let key = "\"code\":"
    let idx = wait_json.index_of(key)
    if idx < 0 { return 0 }
    let from = idx + key.length
    mut to = from
    while to < wait_json.length {
        let c = wait_json.byte(to)
        if c < 0x30 || c > 0x39 {
            if to == from {
                // Allow a leading minus for negative codes.
                if c == 0x2D { to = to + 1 }
                else { break }
            } else {
                break
            }
        } else {
            to = to + 1
        }
    }
    if to == from { return 0 }
    avra_parse_int(wait_json.substring(from, to))
}

/// Run `commands` in parallel, capping concurrency at `jobs`. Each
/// command is spawned via `/bin/sh -c <cmd>`; the pool reaps
/// completed workers and dispatches new commands until every entry
/// in the queue has been run. Returns the worst exit code seen.
///
/// Takes a built-in `List<string>` (Avra's standard generic list)
/// so callers can pass any string list shape — list-literals,
/// builders, results from comprehensions — without wrapping in a
/// custom enum. `.length` and `[idx]` give O(1) random access for
/// the dispatcher's index walk.
export fn pool_run(commands: List<string>, jobs: int) -> int {
    pool_run_with_progress(commands, [], jobs, "")
}

/// Variant of `pool_run` that also writes per-job progress markers
/// into `marker_dir`. Each entry in `slugs` corresponds 1:1 with
/// `commands`; before a command spawns, the dispatcher touches
/// `<marker_dir>/<slug>.running`, and after the worker reaps it
/// touches `<marker_dir>/<slug>.done` (and removes `.running`).
/// A separate UI loop in another thread/process can poll these
/// markers to render a TTY progress bar without coupling to the
/// pool's internal state — this is how `run_pre_deps_with_progress`
/// (TTY branch of pre_build_path_deps) hooks into the pool without
/// the marker-protocol being baked into the pool's API surface.
///
/// Pass `marker_dir == ""` (or empty `slugs`) to disable markers —
/// callers that don't need progress just call `pool_run` directly.
/// When markers are enabled, `slugs.length` MUST equal
/// `commands.length`; mismatched shapes fall back to the no-marker
/// path so a one-off bug doesn't leak truncated state to the UI.
///
/// Tracking: forge-crafting-intepreters-e20h Phase 2 unification.
export fn pool_run_with_progress(commands: List<string>, slugs: List<string>, jobs: int, marker_dir: string) -> int {
    if jobs <= 0 { return 0 }
    pool_run_core(commands, slugs, marker_dir, governor_width_only(jobs), () -> resource_snapshot_for_test(0 - 1, 0 - 1, 0, 0, 0))
}

/// t-kdyj.1: run `commands` under memory-aware admission control. The
/// governor's width_cap bounds concurrency exactly like `jobs` does for
/// `pool_run`; on top of that each dispatch round samples `avail_mb` (via
/// `sampler`) and admits the next unit only while it fits the byte budget.
/// Under pressure the pool stops ADMITTING — it never kills in-flight work —
/// and with nothing in flight it always admits one (the serial floor), so a
/// tight box serialises instead of deadlocking. Callers read the decision
/// tally off the governor (`gov.summary()`) after the pool drains.
export fn pool_run_admitted(commands: List<string>, gov: MemGovernor, sampler: fn() -> int) -> int {
    pool_run_core(commands, [], "", gov, () -> resource_snapshot_for_test(0 - 1, sampler(), 0, 0, 0))
}

/// Generic resource-controller entry point. Consumers provide the same
/// platform-neutral snapshot whether it came from Linux cgroup PSI or macOS
/// memory-pressure events.
export fn pool_run_resource_admitted(commands: List<string>, gov: MemGovernor, sampler: fn() -> ResourceSnapshot) -> int {
    pool_run_core(commands, [], "", gov, sampler)
}

/// Marker-aware form of `pool_run_resource_admitted`. A foreground progress
/// renderer can observe the same pool through its marker protocol without
/// downgrading its dispatcher to a width-only shell semaphore.
export fn pool_run_resource_admitted_with_progress(commands: List<string>, slugs: List<string>, marker_dir: string, gov: MemGovernor, sampler: fn() -> ResourceSnapshot) -> int {
    pool_run_core(commands, slugs, marker_dir, gov, sampler)
}

// The one dispatch loop every entry point shares. A width-only governor
// (estimate 0) short-circuits every budget check and never invokes the
// sampler, so the plain pool_run paths behave exactly as before admission
// control existed.
fn pool_beat_ms() -> int {
    let env = avra_process_env_get("AVRA_POOL_BEAT_MS")
    if env != "" {
        let n = avra_parse_int(env)
        if n > 0 { return n }
    }
    30000
}

fn pool_run_core(commands: List<string>, slugs: List<string>, marker_dir: string, gov: MemGovernor, sampler: fn() -> ResourceSnapshot) -> int {
    let want_markers = marker_dir != "" && slugs.length == commands.length
    let workers = workers_init(gov.width_cap)
    let started_slugs = workers_started_slugs_init(gov.width_cap)
    let total = commands.length
    mut next_idx = 0
    mut completed = 0
    mut max_rc = 0
    // t-65qv: a TIME-BASED progress heartbeat, so a run that is KILLED leaves a
    // trail. Today a killed suite emits `[per-file] …` and then nothing at all —
    // the full logs zip for such a run is 44KB with zero shard detail, which is
    // why six separate mechanisms were proposed for that failure and all six
    // were refuted: there was nothing to attribute it to.
    //
    // TIME-based, NOT per-round. controller.av documents why an edge-triggered
    // pair flaps (37 recovered/backing-off pairs in nine dirs), and a per-round
    // line in this loop would be worse still — the loop spins every 50ms while
    // waiting. At 30s the cost is a handful of lines per run and the benefit is
    // that "how far did it get, and what was resident" survives the kill.
    // AVRA_POOL_BEAT_MS shrinks the interval for testing — an internal hook,
    // not an operator knob, mirroring AVRA_TEST_STALL_MS. A heartbeat nobody has
    // watched fire is not a guard, and at the 30s default a spec would have to
    // burn 30s to see one.
    let beat_ms = pool_beat_ms()
    let t0 = avra_uptime_ms()
    mut last_beat = t0
    while completed < total {
        let reaped = workers_reap_with_markers(workers, started_slugs, marker_dir, want_markers)
        completed = completed + reaped.completed
        max_rc = pool_max_rc(max_rc, reaped.max_rc)
        if completed >= total { return max_rc }
        let now = avra_uptime_ms()
        if now - last_beat >= beat_ms {
            last_beat = now
            // Sampling here rather than reusing the admission sample: the point
            // is what was true AT THE KILL, and admission may not have run for
            // a while if the pool is saturated.
            let snap = sampler()
            let inflight = workers_active_slugs(workers, slugs, commands)
            eprintln("[pool] " + string(completed) + "/" + string(total) +
                     " done, " + string(workers_active(workers)) + " in flight [" + inflight +
                     "], avail " + string(snap.available_mb) + "MB, " +
                     string((now - t0) / 1000) + "s elapsed")
        }
        let dispatched_count = dispatch_batch(commands, slugs, next_idx, total, workers, started_slugs, marker_dir, want_markers, gov, sampler)
        next_idx = next_idx + dispatched_count
        if dispatched_count == 0 && completed < total {
            avra_sleep_ms(50)
        }
    }
    max_rc
}

// Per-worker slug list, mirrors workers[]. Empty string means the
// worker is idle (no slug currently in flight). Used so the reap
// path knows which slug to flip from .running → .done — without
// this, the pool would have to re-derive the slug from the cmd
// string, which is brittle.
fn workers_started_slugs_init(n: int) -> List<string> {
    mut ss: List<string> = []
    mut i = 0
    while i < n { ss.push("") i = i + 1 }
    ss
}

// Dispatch up to `total - idx` queued commands into `workers`'s idle
// slots, gated by the governor's admission decision per unit. Returns
// the number of slots filled this call so the caller advances
// `next_idx` accordingly. When markers are enabled, also touches
// `<marker_dir>/<slug>.running` per dispatched job and stashes the
// slug in `slugs_state` so the reap can find it.
//
// Memory is sampled ONCE per round; each admission in the round then
// stacks its full estimate as unrealized commitment (see
// @std.avrac.resources),
// so a burst can't over-admit against one roomy sample. A width-only
// governor never triggers the sampler at all.
fn dispatch_batch(cmds: List<string>, slugs: List<string>, idx: int, total: int, workers: List<Worker>, slugs_state: List<string>, marker_dir: string, want_markers: bool, gov: MemGovernor, sampler: fn() -> ResourceSnapshot) -> int {
    if idx >= total { return 0 }
    let snapshot = if gov.has_model() { sampler() } else { resource_snapshot_for_test(0 - 1, 0 - 1, 0, 0, 0) }
    let avail_mb = snapshot.available_mb
    mut in_flight = workers_active(workers)
    gov.observe(avail_mb, in_flight)
    mut filled = 0
    mut i = idx
    while i < total && workers_has_idle(workers) {
        if !gov.try_admit_snapshot(snapshot, in_flight) { break }
        let cmd = cmds[i]
        // t-kdyj.1 slice 3 — one budget authority: a modeled admission
        // exports the unit's allocation into its process tree as a SOFT
        // grant (AVRA_MEM_BUDGET_MB). The runtime's F4014 poll lets a tree
        // exceed its grant while the box has slack — a cold whole-program
        // fixture compile legitimately peaks ~7GB, which a hard shard-sized
        // cap F4014'd on CI — and trips only over-budget when MemAvailable
        // is under the runtime's own near-cliff floor, so the SUM is
        // bounded exactly when it matters. Export ONLY the budget: the
        // pressure floor is the runtime's near-cliff default — a property
        // of the BOX, not of this run's schedule. Exporting the admission
        // reserve as the floor was tried and CI falsified it in one run: a
        // busy 16GB runner legitimately spends most of a suite below the
        // 6144MB reserve, so "normal load" read as "pressure" and every
        // over-grant probe tripped — the hard cap re-created through the
        // pressure branch. NEVER export AVRA_MEM_LIMIT_MB here either:
        // that is the user's hard override. Width-only governors export
        // nothing — their spawns are byte-identical.
        let alloc = gov.allocation_mb(in_flight + 1)
        // `export …;` rather than a bare assignment prefix: a pool command
        // may be a compound line (`a && b`), and a bare prefix binds only
        // to the first simple command — the tail of the chain would run
        // ungoverned. An explicit assignment inside `cmd` still wins (it
        // applies later).
        let spawn_cmd = if alloc > 0 {
            "export AVRA_MEM_BUDGET_MB=${string(alloc)}; ${cmd}"
        } else {
            cmd
        }
        let handle = avra_process_spawn_bg("/bin/sh", "[\"-c\", ${json_str(spawn_cmd)}]", "")
        if handle < 0 {
            // Spawn failure: skip the slot (rc is reported as -1 via
            // wait elsewhere; here the worst case is we under-count).
            // Advance to keep draining the queue.
            i = i + 1
            continue
        }
        workers_dispatch(workers, handle, i)
        in_flight = in_flight + 1
        if want_markers {
            let slug = slugs[i]
            workers_record_slug(workers, slugs_state, handle, slug)
            avra_shell_exec("touch ${marker_dir}/${slug}.running")
        }
        filled = filled + 1
        i = i + 1
    }
    filled
}

// Set the slug in slugs_state at the slot whose handle just got
// dispatched. Linear scan because `workers_dispatch` returns nothing
// — we re-find by handle. Tiny lists (jobs typically 4-16) so the
// O(N) cost is irrelevant.
fn workers_record_slug(ws: List<Worker>, slugs_state: List<string>, handle: int, slug: string) {
    mut local = slugs_state
    for (i, w) in ws.enumerate() {
        if w.handle == handle {
            local.set(i, slug)
            return
        }
    }
}

extern fn avra_shell_exec(cmd: string) -> string

// Marker-aware reap: for each completed worker, flip its slug
// from .running → .done. Falls back to the plain reap when markers
// aren't requested.
fn workers_reap_with_markers(ws: List<Worker>, slugs_state: List<string>, marker_dir: string, want_markers: bool) -> ReapResult {
    if !want_markers { return workers_reap(ws) }
    mut local = ws
    mut state = slugs_state
    mut completed = 0
    mut max_rc = 0
    for (i, w) in local.enumerate() {
        if w.handle >= 0 && avra_process_is_alive(w.handle) == 0 {
            let json = avra_process_wait(w.handle)
            let rc = pool_extract_rc(json)
            let slug = state[i]
            if slug != "" {
                avra_shell_exec("rm -f ${marker_dir}/${slug}.running && touch ${marker_dir}/${slug}.done")
                state.set(i, "")
            }
            local.set(i, idle_worker())
            completed = completed + 1
            max_rc = pool_max_rc(max_rc, rc)
        }
    }
    ReapResult { completed, max_rc }
}
