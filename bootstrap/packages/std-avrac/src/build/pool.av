// WHY: in-Avra worker pool — drop-in replacement for `xargs -P`
// style parallel-N execution. Each command runs in its own
// subprocess (hermetic isolation: a crash in one job can't poison
// the others), up to `jobs` concurrent workers. As workers finish,
// the pool reaps them and dispatches the next queued command.
//
// Foundation for the future per-mod build dispatcher (g2eo level-2):
// once each .av file is its own unit with its own fingerprint, the
// build driver feeds N `bs2 compile` commands into pool_run and
// waits. Cargo-style hermetic worker isolation per spec axis 18.
//
// Tracking ticket: forge-crafting-intepreters-e20h.
//
// Key shape contracts:
//   - Commands are full shell strings; the pool wraps each in
//     `/bin/sh -c <cmd>` so callers can compose `cd path && build...`
//     without escaping arg lists.
//   - Returns the worst exit code observed across all workers (0 iff
//     every worker exited 0). Callers wanting per-job rc need a
//     marker-file pattern.
//   - Polling cadence is 50ms — small enough that short jobs reap
//     promptly, large enough to not burn CPU on the polling loop.

extern fn avra_process_spawn_bg(cmd: string, args_json: string, opts_json: string) -> int
extern fn avra_process_is_alive(handle: int) -> int
extern fn avra_process_wait(handle: int) -> string
extern fn avra_sleep_ms(ms: int)
extern fn avra_parse_int(s: string) -> int

use @std.json.{json_str}

fn pool_max_rc(a: int, b: int) -> int {
    if a > b { a } else { b }
}

// Worker slot. `handle = -1` means idle; otherwise it's the handle
// returned by avra_process_spawn_bg. `started_idx` is the queue
// index that worker is processing (only used for diagnostics).
type Worker = {
    handle: int,
    started_idx: int,
}

fn idle_worker() -> Worker { Worker { handle: 0 - 1, started_idx: 0 - 1 } }

fn workers_init(n: int) -> List<Worker> {
    mut ws = []
    mut i = 0
    while i < n {
        ws.push(idle_worker())
        i = i + 1
    }
    ws
}

fn workers_has_idle(ws: List<Worker>) -> bool {
    mut i = 0
    while i < ws.length {
        if ws[i].handle < 0 { return true }
        i = i + 1
    }
    false
}

// Replace the first idle worker with a freshly-spawned one. Mutates
// the list in-place via `.set` — no rebuild-on-every-dispatch like
// the prior linked-list shape required.
fn workers_dispatch(ws: List<Worker>, handle: int, started_idx: int) {
    mut local = ws
    mut i = 0
    while i < local.length {
        if local[i].handle < 0 {
            local.set(i, Worker { handle, started_idx })
            return
        }
        i = i + 1
    }
}

type ReapResult = {
    completed: int,
    max_rc: int,
}

// Walk every active worker; when avra_process_is_alive returns 0 the
// child has exited, so wait() collects its rc and the slot is freed
// in-place (idle_worker overwrites the entry). The shared `ws` list
// is mutated; caller threads its own state across reap calls.
fn workers_reap(ws: List<Worker>) -> ReapResult {
    mut local = ws
    mut completed = 0
    mut max_rc = 0
    mut i = 0
    while i < local.length {
        let w = local[i]
        if w.handle >= 0 && avra_process_is_alive(w.handle) == 0 {
            let json = avra_process_wait(w.handle)
            let rc = pool_extract_rc(json)
            local.set(i, idle_worker())
            completed = completed + 1
            max_rc = pool_max_rc(max_rc, rc)
        }
        i = i + 1
    }
    ReapResult { completed, max_rc }
}

// avra_process_wait returns JSON `{"stdout":...,"stderr":...,"code":N}`.
// Pull the int after the `"code":` key. Defaults to 0 if the key is
// absent (won't happen in practice but keep the failure mode safe).
fn pool_extract_rc(wait_json: string) -> int {
    let key = "\"code\":"
    let idx = wait_json.index_of(key)
    if idx < 0 { return 0 }
    let from = idx + key.length
    mut to = from
    while to < wait_json.length {
        let c = wait_json.byte(to)
        if c < 0x30 || c > 0x39 {
            if to == from {
                // Allow a leading minus for negative codes.
                if c == 0x2D { to = to + 1 }
                else { break }
            } else {
                break
            }
        } else {
            to = to + 1
        }
    }
    if to == from { return 0 }
    avra_parse_int(wait_json.substring(from, to))
}

/// Run `commands` in parallel, capping concurrency at `jobs`. Each
/// command is spawned via `/bin/sh -c <cmd>`; the pool reaps
/// completed workers and dispatches new commands until every entry
/// in the queue has been run. Returns the worst exit code seen.
///
/// Takes a built-in `List<string>` (Avra's standard generic list)
/// so callers can pass any string list shape — list-literals,
/// builders, results from comprehensions — without wrapping in a
/// custom enum. `.length` and `[idx]` give O(1) random access for
/// the dispatcher's index walk.
export fn pool_run(commands: List<string>, jobs: int) -> int {
    if jobs <= 0 { return 0 }
    let workers = workers_init(jobs)
    let total = commands.length
    mut next_idx = 0
    mut completed = 0
    mut max_rc = 0
    while completed < total {
        // Reap finished workers first so any freed slots are eligible
        // to receive new dispatches in this same iteration.
        let reaped = workers_reap(workers)
        completed = completed + reaped.completed
        max_rc = pool_max_rc(max_rc, reaped.max_rc)
        if completed >= total { return max_rc }
        // Dispatch as many queued commands as there are idle slots.
        // Mutates `workers` in place.
        let dispatched_count = dispatch_batch(commands, next_idx, total, workers)
        next_idx = next_idx + dispatched_count
        // Sleep briefly when we're waiting on at least one worker —
        // skip the sleep if we just dispatched (cheap retry path).
        if dispatched_count == 0 && completed < total {
            avra_sleep_ms(50)
        }
    }
    max_rc
}

// Dispatch up to `total - idx` queued commands into `workers`'s idle
// slots. Returns the number of slots filled this call so the caller
// advances `next_idx` accordingly.
fn dispatch_batch(cmds: List<string>, idx: int, total: int, workers: List<Worker>) -> int {
    mut filled = 0
    mut i = idx
    while i < total && workers_has_idle(workers) {
        let cmd = cmds[i]
        let handle = avra_process_spawn_bg("/bin/sh", "[\"-c\", ${json_str(cmd)}]", "")
        if handle < 0 {
            // Spawn failure: skip the slot (rc is reported as -1 via
            // wait elsewhere; here the worst case is we under-count).
            // Advance to keep draining the queue.
            i = i + 1
            continue
        }
        workers_dispatch(workers, handle, i)
        filled = filled + 1
        i = i + 1
    }
    filled
}

