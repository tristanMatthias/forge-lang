// WHY: Pretty-printer for Avra source — round-trips parsed AST back to
// canonical surface syntax with consistent indentation. Used by the
// `avra fmt` subcommand and any tooling that wants to render an AST
// (codemod previews, error reporting, doc-comment scaffolding).
//
// Pure: no argv, no I/O, no globals. Takes an AST node, returns a string.
// Public entry point is `fmt_stmt_ids(store, stmts, 0)`.

use core.{
    Expr, Stmt, StmtId, ExprId, NodeStore, ParamEntry,
    FieldInit, FieldEntry,
    Variant, Pattern, MatchArm, WhenArm, Annotation,
    binop_str, unop_str, logicop_str,
    vtype_render_full, vtype_is_unknown, vtype_eq,
    render_type_param_list,
}
use list_ops.{list_map}

/// Render `depth * 4` spaces — Avra's canonical indent unit.
fn fmt_indent(depth: int) -> string {
    mut result = ""
    for i in 0..depth {
        result = result + "    "
    }
    result
}

/// Re-encode a decoded string-literal payload for rendering. The lexer
/// resolves escapes (`\n \t \r \\ \" \0 \x??`) into raw chars inside the
/// token (delimiting quotes kept), so rendering the payload verbatim
/// emits broken source for any string containing quotes, backslashes, or
/// control chars — and fmt output must re-lex identically (build
/// metadata re-parses @comptime fn bodies from it; cmdgen's `str_lit`
/// body carries `"\""` and rendered as `"""` before this). Inverse of
/// the lexer's decode; a literal `$`+`{` is split via `\x24` so decoded
/// text can't re-lex as an interpolation head.
fn fmt_string_lit(v: string) -> string {
    if v.length < 2 { return v }
    let inner = v.substring(1, v.length - 1)
    mut out = "\""
    mut i = 0
    while i < inner.length {
        let ch = inner.substring(i, i + 1)
        if ch == "\\" {
            out = out + "\\\\"
        } else if ch == "\"" {
            out = out + "\\\""
        } else if ch == "\n" {
            out = out + "\\n"
        } else if ch == "\t" {
            out = out + "\\t"
        } else if ch == "\r" {
            out = out + "\\r"
        } else if ch == "\0" {
            out = out + "\\0"
        } else if ch == "$" && i + 1 < inner.length && inner.substring(i + 1, i + 2) == "{" {
            out = out + "\\x24"
        } else {
            out = out + ch
        }
        i = i + 1
    }
    out + "\""
}

/// Render an expression node back to source. Recursive — composes with
/// the helper renderers (lists, patterns, match arms) for nested forms.
export fn fmt_expr(store: NodeStore, se: Expr) -> string {
    match se {
        .Number(v) -> v
        .String(v) -> fmt_string_lit(v)
        .Bool(v) -> v
        .None -> "none"
        .Ident(name) -> name
        .QualifiedIdent(path) -> path
        .Assign(name, value) -> "${name} = ${fmt_expr(store, store.exprs.get(value))}"
        .Grouping(inner) -> "(${fmt_expr(store, store.exprs.get(inner))})"
        .Unary(op, right) -> "${unop_str(op)}${fmt_expr(store, store.exprs.get(right))}"
        .Binary(left, op, right) -> "${fmt_expr(store, store.exprs.get(left))} ${binop_str(op)} ${fmt_expr(store, store.exprs.get(right))}"
        .Logical(left, op, right) -> "${fmt_expr(store, store.exprs.get(left))} ${logicop_str(op)} ${fmt_expr(store, store.exprs.get(right))}"
        .Call(callee, args) -> "${fmt_expr(store, store.exprs.get(callee))}(${fmt_expr_ids_comma(store, args)})"
        // Explicit-type-arg calls render as the PARSEABLE surface form
        // `f<T>(x)` — the shape `try_parse_generic_call` speculatively
        // accepts after a callee. The former `f::<T>(x)` (Rust turbofish)
        // does NOT parse in Avra, so any fmt-rendered body carrying one —
        // notably the metadata GenericBodies round-trip — silently
        // re-parsed to an EMPTY body (parse_body_source's failure
        // fallback), and every consumer-side monomorphization of that fn
        // vanished (t-jgc0's second layer).
        .GenericCall(callee, ta, args) -> "${fmt_expr(store, store.exprs.get(callee))}<${fmt_type_name_list(ta)}>(${fmt_expr_ids_comma(store, args)})"
        .StructLit(name, inits) -> "${name} { ${fmt_field_init_list(store, inits)} }"
        .FieldAccess(obj, field) -> "${fmt_expr(store, store.exprs.get(obj))}.${field}"
        .EnumCtor(tn, variant, args) -> if tn == "" { ".${variant}(${fmt_expr_ids_comma(store, args)})" } else { "${tn}.${variant}(${fmt_expr_ids_comma(store, args)})" }
        .Index(obj, idx) -> "${fmt_expr(store, store.exprs.get(obj))}[${fmt_expr(store, store.exprs.get(idx))}]"
        .Block(body) -> "{\n${fmt_stmt_ids(store, body, 1)}\n}"
        .MatchExpr(subject, arms) -> "match ${fmt_expr(store, store.exprs.get(subject))} {\n${fmt_match_arms(store, arms, 1)}\n}"
        .FieldAssign(obj, field, value) -> "${fmt_expr(store, store.exprs.get(obj))}.${field} = ${fmt_expr(store, store.exprs.get(value))}"
        .IfExpr(c, t, e) -> "if ${fmt_expr(store, store.exprs.get(c))} { ${fmt_expr(store, store.exprs.get(t))} } else { ${fmt_expr(store, store.exprs.get(e))} }"
        .NullCoalesce(left, right) -> "${fmt_expr(store, store.exprs.get(left))} ?? ${fmt_expr(store, store.exprs.get(right))}"
        .OptionalChain(obj, field) -> "${fmt_expr(store, store.exprs.get(obj))}?.${field}"
        .OptionalMethodCall(obj, method, args) -> "${fmt_expr(store, store.exprs.get(obj))}?.${method}(${fmt_expr_ids_comma(store, args)})"
        .Try(inner) -> "${fmt_expr(store, store.exprs.get(inner))}?"
        .Tuple(elements) -> "(${fmt_expr_ids_comma(store, elements)})"
        .TupleIndex(obj, idx) -> "${fmt_expr(store, store.exprs.get(obj))}.${string(idx)}"
        .With(obj, overrides) -> "${fmt_expr(store, store.exprs.get(obj))} with { ${fmt_field_init_list(store, overrides)} }"
        .ListLit(elements) -> "[${fmt_expr_ids_comma(store, elements)}]"
        .Lambda(params, body) -> "(${fmt_param_list_comma(params)}) -> ${fmt_expr(store, store.exprs.get(body))}"
        .MapLit(entries) -> "{ ${fmt_map_entries(store, entries)} }"
        .FloatLit(v) -> v
        .Slice(obj, start, end) -> "${fmt_expr(store, store.exprs.get(obj))}[${fmt_expr(store, store.exprs.get(start))}..${fmt_expr(store, store.exprs.get(end))}]"
        .IsCheck(subject, vname) -> "${fmt_expr(store, store.exprs.get(subject))} is .${vname}"
        .InCheck(needle, items) -> "${fmt_expr(store, store.exprs.get(needle))} in [${fmt_expr_ids_comma(store, items)}]"
        .ListComp(body, variable, collection, filter) -> {
            let head = "[${fmt_expr(store, store.exprs.get(body))} for ${variable} in ${fmt_expr(store, store.exprs.get(collection))}"
            if filter != null { "${head} if ${fmt_expr(store, store.exprs.get(filter!))}]" } else { "${head}]" }
        }
        .When(arms) -> "when {\n${fmt_when_arms(store, arms, 1)}\n}"
        .Catch(inner, binding, body, _, _) -> "${fmt_expr(store, store.exprs.get(inner))} catch ${binding} { ${fmt_expr(store, store.exprs.get(body))} }"
        .Spawn(body) -> "spawn ${fmt_expr(store, store.exprs.get(body))}"
        .ChannelNew(elem, capacity) -> {
            if capacity == null {
                "channel<${vtype_render_full(elem)}>()"
            } else {
                "channel<${vtype_render_full(elem)}>(${fmt_expr(store, store.exprs.get(capacity!))})"
            }
        }
        .Isolated(body) -> "isolated ${fmt_expr(store, store.exprs.get(body))}"
        .Quote(kind, body) -> if kind == "expr" { "quote ${fmt_expr(store, store.exprs.get(body))}" } else { "quote ${kind} ${fmt_expr(store, store.exprs.get(body))}" }
        .Splice(target) -> "~${fmt_expr(store, store.exprs.get(target))}"
        // The body of `quote type { T }` — render the type back inside
        // the braces so `quote type ${body}` reproduces parseable source
        // (metadata re-parses @comptime bodies from fmt output).
        .TypeLit(vt) -> "{ ${vtype_render_full(vt)} }"
        .Error -> "(error)"
        .Missing -> "(missing)"
    }
}

/// Render a single statement at the given indentation depth.
export fn fmt_stmt(store: NodeStore, ss: Stmt, depth: int) -> string {
    let ind = fmt_indent(depth)
    match ss {
        .Let(name, vt, init) -> {
            // so07.7.3: vtype_render_full not vtype_display — the latter
            // renders `List<U>` as bare `List`, lossy on round-trip
            // through the metadata fast-path's body serializer. fmt_*
            // must produce parseable source, not pretty error messages.
            let ty_part = if vtype_is_unknown(vt) { "" } else { ": ${vtype_render_full(vt)}" }
            "${ind}let ${name}${ty_part} = ${fmt_expr(store, store.exprs.get(init))}"
        }
        .Mut(name, vt, init) -> {
            let ty_part = if vtype_is_unknown(vt) { "" } else { ": ${vtype_render_full(vt)}" }
            "${ind}mut ${name}${ty_part} = ${fmt_expr(store, store.exprs.get(init))}"
        }
        .Const(name, vt, init) -> {
            let ty_part = if vtype_is_unknown(vt) { "" } else { ": ${vtype_render_full(vt)}" }
            "${ind}const ${name}${ty_part} = ${fmt_expr(store, store.exprs.get(init))}"
        }
        .Expr(se) -> "${ind}${fmt_expr(store, store.exprs.get(se))}"
        .Block(body) -> "${ind}{\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        .If(condition, then_branch, else_branch) -> {
            let base = "${ind}if ${fmt_expr(store, store.exprs.get(condition))} {\n${fmt_stmt(store, store.stmts.get(then_branch), depth + 1)}\n${ind}}"
            if else_branch == null {
                base
            } else {
                "${base} else {\n${fmt_stmt(store, store.stmts.get(else_branch!), depth + 1)}\n${ind}}"
            }
        }
        .While(condition, body) -> "${ind}while ${fmt_expr(store, store.exprs.get(condition))} {\n${fmt_stmt(store, store.stmts.get(body), depth + 1)}\n${ind}}"
        .For(variable, start, end, body) -> "${ind}for ${variable} in ${fmt_expr(store, store.exprs.get(start))}..${fmt_expr(store, store.exprs.get(end))} {\n${fmt_stmt(store, store.stmts.get(body), depth + 1)}\n${ind}}"
        .ForIn(variable, collection, body) -> "${ind}for ${variable} in ${fmt_expr(store, store.exprs.get(collection))} {\n${fmt_stmt(store, store.stmts.get(body), depth + 1)}\n${ind}}"
        .Function(name, tp, params, rvt, body) -> {
            let tp_str = render_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            let ret_part = if vtype_eq(rvt, .Void) { "" } else { " -> ${vtype_render_full(rvt)}" }
            "${ind}fn ${name}${tp_part}(${fmt_param_list_typed(params)})${ret_part} {\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        }
        .Return(value) -> "${ind}return ${fmt_expr(store, store.exprs.get(value))}"
        .ReturnEmpty -> "${ind}return"
        .TypeDecl(name, tp, fields) -> {
            let tp_str = render_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "${ind}type ${name}${tp_part} = {\n${fmt_field_decl_list(fields, depth + 1)}\n${ind}}"
        }
        .NewtypeDecl(name, inner_vt) -> "${ind}type ${name} = ${vtype_render_full(inner_vt)}"
        .UnionAliasDecl(name, type_vt) -> "${ind}type ${name} = ${vtype_render_full(type_vt)}"
        .ShapeDecl(name, fields) -> "${ind}shape ${name} = {\n${fmt_field_decl_list(fields, depth + 1)}\n${ind}}"
        .EnumDecl(name, tp, variants) -> {
            let tp_str = render_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "${ind}enum ${name}${tp_part} {\n${fmt_variant_list(variants, depth + 1)}\n${ind}}"
        }
        .Match(subject, arms) -> "${ind}match ${fmt_expr(store, store.exprs.get(subject))} {\n${fmt_match_arms(store, arms, depth + 1)}\n${ind}}"
        .Impl(name, methods) -> {
            let colon = name.index_of(":")
            let impl_header = if colon >= 0 {
                let trait_name = name.substring(0, colon)
                let type_name = name.substring(colon + 1, name.length)
                "impl ${trait_name} for ${type_name}"
            } else {
                "impl ${name}"
            }
            "${ind}${impl_header} {\n${fmt_stmt_ids(store, methods, depth + 1)}\n${ind}}"
        }
        .NoOp -> ""
        .ExternFn(name, params, rvt) -> "${ind}extern fn ${name}(${fmt_param_list_typed(params)}) -> ${vtype_render_full(rvt)}"
        .Break -> "${ind}break"
        .Continue -> "${ind}continue"
        .TraitDecl(name, methods) -> "${ind}trait ${name} {\n${fmt_stmt_ids(store, methods, depth + 1)}\n${ind}}"
        .LetDestructure(names, init) -> "${ind}let (${fmt_param_list_comma(names)}) = ${fmt_expr(store, store.exprs.get(init))}"
        .Defer(body) -> "${ind}defer ${fmt_expr(store, store.exprs.get(body))}"
        .Errdefer(body) -> "${ind}errdefer ${fmt_expr(store, store.exprs.get(body))}"
        .Annotated(annotations, inner) -> "${fmt_annotation_list(annotations, depth)}${fmt_stmt(store, store.stmts.get(inner), depth)}"
        .SpecBlock(name, body) -> "${ind}spec ${name} {\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        .GivenBlock(name, body) -> "${ind}given ${name} {\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        .ThenBlock(name, cond) -> "${ind}then ${name} { ${fmt_expr(store, store.exprs.get(cond))} }"
        .Select(_) -> "${ind}select { ... }"
        .Parallel(body) -> "${ind}parallel {\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        .Module(name, body) -> "${ind}mod ${name}\n${fmt_stmt_ids(store, body, depth)}"
        .Use(path, names) -> "${ind}use ${path}.{${fmt_param_list_comma(names)}}"
        .AssocType(name, ty_vt) -> if vtype_is_unknown(ty_vt) { "${ind}type ${name}" } else { "${ind}type ${name} = ${vtype_render_full(ty_vt)}" }
        .ComponentDef(name, params, _, _, _, body) -> "${ind}component ${name}(${fmt_param_list_comma(params)}) {\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        .ComponentBlock(comp, inst, _, body) -> {
            // A `body: TokenStream` instance carries its verbatim raw
            // text as a single TokenBody row — render it back between
            // the braces unchanged so render→reparse is a fixed point
            // (the raw capture trims outer whitespace, so the spacing
            // added here normalizes away on the next parse).
            if body.length == 1 {
                match store.stmts.get(body[0]) {
                    .TokenBody(text) -> return "${ind}${comp} ${inst} { ${text} }"
                    _ -> {}
                }
            }
            "${ind}${comp} ${inst} {\n${fmt_stmt_ids(store, body, depth + 1)}\n${ind}}"
        }
        .TokenBody(text) -> "${ind}${text}"
        .Error -> "${ind}(error)"
        .Missing -> "${ind}(missing)"
    }
}

/// Public entry point — render a statement list (each statement on one
/// source line, joined with `\n`). Also the internal renderer for every
/// nested `List<StmtId>` body (blocks, fn/impl/trait/module bodies).
export fn fmt_stmt_ids(store: NodeStore, ids: List<StmtId>, depth: int) -> string {
    list_map(ids, (id: StmtId) -> fmt_stmt(store, store.stmts.get(id), depth)).join("\n")
}

/// Render a flipped `List<ExprId>` as comma-separated expressions — used
/// inside call args, list literals, tuple elements, and generic call args.
fn fmt_expr_ids_comma(store: NodeStore, ids: List<ExprId>) -> string {
    list_map(ids, (id: ExprId) -> fmt_expr(store, store.exprs.get(id))).join(", ")
}

/// Render `List<ParamEntry>` as comma-separated names (no types).
fn fmt_param_list_comma(params: List<ParamEntry>) -> string {
    list_map(params, (p: ParamEntry) -> p.name).join(", ")
}

/// Render `List<ParamEntry>` with type annotations.
fn fmt_param_list_typed(params: List<ParamEntry>) -> string {
    list_map(params, (p: ParamEntry) -> {
        // so07.7.3: vtype_render_full preserves generic args
        // (`List<U>` not `List`) so metadata-serialized bodies
        // round-trip through the parser correctly.
        let ty_part = if vtype_is_unknown(p.vtype) { "" } else { ": ${vtype_render_full(p.vtype)}" }
        p.name + ty_part
    }).join(", ")
}

/// Render a comma-separated list of type names — for explicit
/// generic-call type arguments `f::<T, U>(x)`.
fn fmt_type_name_list(type_args: List<ValueType>) -> string {
    list_map(type_args, (t: ValueType) -> vtype_render_full(t)).join(", ")
}

/// Render a struct/with field-init list — `name: expr, name: expr`.
fn fmt_field_init_list(store: NodeStore, inits: List<FieldInit>) -> string {
    list_map(inits, (init: FieldInit) -> "${init.name}: ${fmt_expr(store, store.exprs.get(init.value_id))}").join(", ")
}

/// Render a struct-decl/shape field list — one `name: Type` per
/// indented line.
fn fmt_field_decl_list(fields: List<FieldEntry>, depth: int) -> string {
    let ind = fmt_indent(depth)
    // vtype_render_full: struct/shape decls need round-trippable
    // type info — same reason as Let/Mut/Const annotations in
    // fmt_stmt. so07.7.3.
    list_map(fields, (e: FieldEntry) -> "${ind}${e.name}: ${vtype_render_full(e.resolved)}").join("\n")
}

/// Render an enum-variant list — one `Name(field: T, ...)` per
/// indented line.
fn fmt_variant_list(variants: List<Variant>, depth: int) -> string {
    let ind = fmt_indent(depth)
    list_map(variants, (v: Variant) -> "${ind}${v.name}${fmt_variant_fields(v.fields)}").join("\n")
}

/// Render the parameter section of an enum variant — `(name: T, ...)`,
/// or empty when the variant carries no payload.
fn fmt_variant_fields(fields: List<FieldEntry>) -> string {
    if fields.length == 0 { return "" }
    "(${list_map(fields, (e: FieldEntry) -> "${e.name}: ${vtype_render_full(e.resolved)}").join(", ")})"
}

/// Render a match-arm pattern.
fn fmt_pattern(store: NodeStore, p: Pattern) -> string {
    match p {
        .Wildcard -> "_"
        .Rest -> "rest"
        .Variant(name, bindings) -> {
            let bindings_str = fmt_param_list_comma(bindings)
            if bindings_str == "" { ".${name}" } else { ".${name}(${bindings_str})" }
        }
        .LitString(value) -> value
        .LitInt(value) -> string(value)
        .LitBool(value) -> if value != 0 { "true" } else { "false" }
        .LitFloat(value) -> value
        .NestedVariant(name, sub_patterns) -> {
            let subs = list_map(sub_patterns, (pid: PatId) -> fmt_pattern(store, store.pats.get(pid))).join(", ")
            ".${name}(${subs})"
        }
        .Or(left, right) -> "${fmt_pattern(store, store.pats.get(left))} or ${fmt_pattern(store, store.pats.get(right))}"
        .TypePattern(type_name, binding) -> "${type_name}(${binding})"
    }
}

/// Render a match-arm list — one arm per indented line.
fn fmt_match_arms(store: NodeStore, arms: List<MatchArm>, depth: int) -> string {
    let ind = fmt_indent(depth)
    list_map(arms, (arm: MatchArm) -> {
        let guard_str = if arm.guard_id != null { " if ${fmt_expr(store, store.exprs.get(arm.guard_id!))}" } else { "" }
        "${ind}${fmt_pattern(store, arm.pattern)}${guard_str} -> ${fmt_expr(store, store.exprs.get(arm.body_id))}"
    }).join("\n")
}

/// Render a `when` arm list — one arm per indented line. A null
/// condition becomes `_` (the catch-all).
fn fmt_when_arms(store: NodeStore, arms: List<WhenArm>, depth: int) -> string {
    let ind = fmt_indent(depth)
    list_map(arms, (arm: WhenArm) -> {
        let cond_str = if arm.cond_id == null { "_" } else { fmt_expr(store, store.exprs.get(arm.cond_id!)) }
        "${ind}${cond_str} -> ${fmt_expr(store, store.exprs.get(arm.body_id))}"
    }).join("\n")
}

/// Render an annotation chain — `@name\n@name\n` prefix to a stmt.
fn fmt_annotation_list(annots: List<Annotation>, depth: int) -> string {
    let ind = fmt_indent(depth)
    mut out = ""
    for a in annots { out = out + "${ind}@${a.name}\n" }
    out
}

/// Render map-literal entries — flat `key: val, key: val` form.
/// Map AST stores keys and values as alternating elements; this
/// walks them pairwise.
fn fmt_map_entries(store: NodeStore, entries: List<ExprId>) -> string {
    mut out = ""
    mut i = 0
    while i < entries.length {
        let key_id = entries[i]
        if i + 1 >= entries.length {
            if out != "" { out = out + ", " }
            out = out + fmt_expr(store, store.exprs.get(key_id))
            i = i + 1
        } else {
            let val_id = entries[i + 1]
            if out != "" { out = out + ", " }
            out = out + "${fmt_expr(store, store.exprs.get(key_id))}: ${fmt_expr(store, store.exprs.get(val_id))}"
            i = i + 2
        }
    }
    out
}
