// WHY: t-47hc.2 (Phase 1) — the FIRST generated byte-scanner. It proves a scanner
// built on the byte character-classification (charclass.av) emits a token stream
// BYTE-IDENTICAL to the hand lexer over a token SUBSET — validated differentially
// THROUGH the token-stream oracle (scan_subset_test.av: scan_subset(x) ==
// lex_dump(x)). This is the "compile don't interpret" DFA lexer in miniature: it
// branches on `char_class` and reads raw bytes via `byte_at` (no per-char string
// allocation), tracking line/column exactly as the hand lexer's advance_char does.
//
// SUBSET (byte-identical here): whitespace, identifiers + keywords, PLAIN decimal
// integers, the single-char punctuation with NO compound form (, ( ) { } [ ] : @ ~
// % ^ + *), every COMPOUND-operator lead with maximal munch (`- . ? & | ! = < >`
// and their longer forms: -> .. ?? ?. && || |> != == << <= <- >> >=), AND — as of
// slice 5 — the whole `/` FAMILY: `//` line comments + `/* */` NESTED block
// comments (both trivia), `///`/`//!` doc-comment TOKENS (DocComment/ModDocComment,
// one leading space stripped, content to EOL), and bare `/` (Slash / division);
// AND — as of slice 6 — ASCII CHAR LITERALS (`'x'`/`'\n'` -> Number(codepoint)).
// AND — as of slice 7 — single-line NON-interpolated STRING literals `"..."` with
// escapes (\n \t \r \\ \" \0 \xHH; unknown escapes kept literally) -> String, the
// lexeme carrying the escape-RESOLVED content. OUT of subset (later slices, they
// need lexer modes): interpolated strings `${...}` (-> Template), `"""` multiline,
// raw `r"..."`, backtick templates, multi-byte char literals, and float / hex /
// underscore / duration numbers. scan_subset returns a
// "<out-of-subset:...>" marker when it meets an out-of-subset construct, so the
// differential test only compares in-subset inputs. Unused in production
// (byte-identical; diff-test).
use core.{Tk, tk_name, avra_char_from_hex}
use parse.{p_keyword_kind, byte_at, char_class, cc_is_ident_cont, cc_is_digit, CharClass, lex_escape}

extern fn avra_bytes_from_string(s: string) -> bytes

/// Scanner cursor over the source, threaded as a struct (no mutable globals).
/// `line`/`col` are 1-indexed and advance exactly like the hand lexer's
/// advance_char: col += 1 per byte, and a newline sets line += 1, col = 1.
type ScanState = { src: string, bytes: bytes, n: int, pos: int, line: int, col: int }

impl ScanState {
    fn at_end(self) -> bool { self.pos >= self.n }
    fn cur(self) -> int { byte_at(self.bytes, self.pos) }
    fn nxt(self) -> int { byte_at(self.bytes, self.pos + 1) }
    fn nnxt(self) -> int { byte_at(self.bytes, self.pos + 2) }

    /// Consume one byte, updating line/column like advance_char.
    fn adv(self) {
        let b = byte_at(self.bytes, self.pos)
        self.pos = self.pos + 1
        if b == 10 {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
    }

    /// Skip whitespace, `//` line comments, and `/* */` NESTED block comments —
    /// matching skip_whitespace_and_comments exactly. STOPS (returns to the scan
    /// loop) at a `///`/`//!` doc comment (those are TOKENS the `/` arm emits) and
    /// at any real token. An unterminated `/*` swallows to EOF, like the hand lexer.
    fn skip_trivia(self) {
        while !self.at_end() {
            let b = self.cur()
            if b == 32 || b == 13 || b == 9 || b == 10 {   // space, CR, tab, LF
                self.adv()
            } else if b == 47 && self.nxt() == 47 {         // `//`
                let third = self.nnxt()
                if third == 47 || third == 33 {             // `///`/`//!` doc — a TOKEN
                    return
                }
                while !self.at_end() && self.cur() != 10 {  // line comment to EOL
                    self.adv()
                }
            } else if b == 47 && self.nxt() == 42 {          // `/*` block comment
                self.adv()   // consume /
                self.adv()   // consume *
                mut depth = 1
                while depth > 0 && !self.at_end() {
                    if self.cur() == 47 && self.nxt() == 42 {      // nested `/*`
                        self.adv()  self.adv()  depth = depth + 1
                    } else if self.cur() == 42 && self.nxt() == 47 { // `*/`
                        self.adv()  self.adv()  depth = depth - 1
                    } else {
                        self.adv()
                    }
                }
            } else {
                return
            }
        }
    }
}

/// The single-char-punctuation subset: byte -> its Tk, or Tk.Error for a byte
/// that is NOT a subset punctuation (out of subset). Excludes every byte with a
/// compound form (= < > | & ? . - / !) — those need maximal-munch (a later slice).
fn subset_punct_tk(b: int) -> Tk {
    if b == 44 { return .Comma }         // ,
    if b == 40 { return .LeftParen }     // (
    if b == 41 { return .RightParen }    // )
    if b == 123 { return .LeftBrace }    // {
    if b == 125 { return .RightBrace }   // }
    if b == 91 { return .LeftBracket }   // [
    if b == 93 { return .RightBracket }  // ]
    if b == 58 { return .Colon }         // :
    if b == 64 { return .At }            // @
    if b == 126 { return .Tilde }        // ~
    if b == 37 { return .Percent }       // %
    if b == 94 { return .Caret }         // ^
    if b == 43 { return .Plus }          // +
    if b == 42 { return .Star }          // *
    .Error
}

fn is_subset_punct(b: int) -> bool {
    match subset_punct_tk(b) {
        .Error -> false
        _ -> true
    }
}

/// Maximal-munch scan of a COMPOUND-operator lead — the DFA's longest-match,
/// compiled to BRANCHES (not a runtime table), byte-identical to the hand
/// lexer's scan_token operator arms (lexer.av ~104-157). `s` is positioned at
/// the lead byte `b`; on a handled lead this consumes the lead + the longest
/// following match and returns its Tk. On a byte that is NOT a handled lead
/// (`/` — doc/block comments; string/char quotes; anything needing a lexer
/// mode) it consumes NOTHING and returns `.Error`, so the caller emits the
/// out-of-subset marker. The branch order per lead mirrors the hand lexer's
/// exactly so the longest alternative always wins first (`<<`/`<=`/`<-` before
/// `<`, `??`/`?.` before `?`, …). `s.cur()` past end is -1, matching no operator
/// byte, so a lead at EOF correctly falls through to its single-char form.
fn scan_compound_op(s: ScanState, b: int) -> Tk {
    if b == 45 {                                        // -
        s.adv()
        if s.cur() == 62 { s.adv() return .Arrow }      // ->
        return .Minus
    }
    if b == 46 {                                        // .
        s.adv()
        if s.cur() == 46 { s.adv() return .DotDot }     // ..
        return .Dot
    }
    if b == 63 {                                        // ?
        s.adv()
        if s.cur() == 63 { s.adv() return .QuestionQuestion }   // ??
        if s.cur() == 46 { s.adv() return .QuestionDot }        // ?.
        return .Question
    }
    if b == 38 {                                        // &
        s.adv()
        if s.cur() == 38 { s.adv() return .AmpAmp }     // &&
        return .Amp
    }
    if b == 124 {                                       // |
        s.adv()
        if s.cur() == 124 { s.adv() return .PipePipe }  // ||
        if s.cur() == 62 { s.adv() return .PipeGt }     // |>
        return .Pipe
    }
    if b == 33 {                                        // !
        s.adv()
        if s.cur() == 61 { s.adv() return .BangEqual }  // !=
        return .Bang
    }
    if b == 61 {                                        // =
        s.adv()
        if s.cur() == 61 { s.adv() return .EqualEqual } // ==
        return .Equal
    }
    if b == 60 {                                        // <
        s.adv()
        if s.cur() == 60 { s.adv() return .Shl }        // <<
        if s.cur() == 61 { s.adv() return .LessEqual }  // <=
        if s.cur() == 45 { s.adv() return .LeftArrow }  // <-
        return .Less
    }
    if b == 62 {                                        // >
        s.adv()
        if s.cur() == 62 { s.adv() return .Shr }        // >>
        if s.cur() == 61 { s.adv() return .GreaterEqual }   // >=
        return .Greater
    }
    .Error
}

/// One dump line in the oracle's format: `<kind>\t<line>:<col>\t<escaped-lexeme>`.
fn emit(kind: Tk, line: int, col: int, lexeme: string) -> string {
    tk_name(kind) + "\t" + string(line) + ":" + string(col) + "\t" + lex_escape(lexeme) + "\n"
}

/// Scan `source` (restricted to the subset above) into the token stream in the
/// oracle's exact `lex_dump` format, so `scan_subset(x) == lex_dump(x)` iff the
/// generated scanner is byte-identical to the hand lexer on `x`. Returns an
/// `<out-of-subset:...>` marker (never a valid dump) on any out-of-subset byte.
export fn scan_subset(source: string) -> string {
    mut s = ScanState { src: source, bytes: avra_bytes_from_string(source), n: source.length, pos: 0, line: 1, col: 1 }
    mut out = ""
    while true {
        s.skip_trivia()
        let tok_line = s.line
        let tok_col = s.col
        let start = s.pos
        if s.at_end() {
            return out + emit(Tk.Eof, tok_line, tok_col, "")
        }
        let b = s.cur()
        let cls = char_class(b)
        match cls {
            .Alpha -> {
                // A raw string `r"..."` is NOT an identifier — the hand lexer
                // (scan_token: `ch == "r" && peek == '"'`) diverts before the ident
                // scan. Raw strings have no escape/interpolation processing and are a
                // later slice, so `r"` is out of subset. (`rr`/`run`/`r ` stay idents.)
                if b == 114 && s.nxt() == 34 { return "<out-of-subset:string>" }
                s.adv()
                while !s.at_end() && cc_is_ident_cont(s.cur()) { s.adv() }
                let text = source.substring(start, s.pos)
                out = out + emit(p_keyword_kind(text), tok_line, tok_col, text)
            }
            .Digit -> {
                s.adv()
                while !s.at_end() && cc_is_digit(s.cur()) { s.adv() }
                let text = source.substring(start, s.pos)
                // A non-plain number is out of subset (the hand lexer would keep
                // scanning): `.` (float/dot), `_` (digit-group separator, kept IN
                // the number), and a 0x/0b/0o prefix — the last ONLY when the
                // digits so far are exactly "0" (else e.g. `42x` is Number + Ident,
                // which IS in subset). Matches scan_number_token's triggers.
                if !s.at_end() {
                    let after = s.cur()
                    if after == 46 || after == 95 {
                        return "<out-of-subset:number>"
                    }
                    if text == "0" && (after == 120 || after == 88 || after == 98 || after == 66 || after == 111 || after == 79) {
                        return "<out-of-subset:number>"
                    }
                    // Duration suffixes (Nd Nh Nm Ns Nms) — scan_number_token folds
                    // these into ONE transformed Number (e.g. 1d -> 86400000), so
                    // they are NOT plain integers and are out of subset. Each fires
                    // ONLY when the char after the suffix is not ident-continue, so
                    // `1down` / `5m2` stay a plain Number + Identifier (byte-identical
                    // to the hand lexer, which requires !p_is_alpha_numeric there).
                    // `Nms` is the one two-char suffix: `m` followed by `s`.
                    let after2 = s.nxt()
                    if (after == 100 || after == 104 || after == 115) && !cc_is_ident_cont(after2) {
                        return "<out-of-subset:number>"   // Nd / Nh / Ns
                    }
                    if after == 109 && (after2 == 115 || !cc_is_ident_cont(after2)) {
                        return "<out-of-subset:number>"   // Nm / Nms
                    }
                }
                out = out + emit(Tk.Number, tok_line, tok_col, text)
            }
            _ -> {
                if is_subset_punct(b) {
                    // Single-char punctuation with NO compound form.
                    s.adv()
                    let text = source.substring(start, s.pos)
                    out = out + emit(subset_punct_tk(b), tok_line, tok_col, text)
                } else if b == 47 {
                    // `/` — a `///`/`//!` doc-comment TOKEN, or bare division. A
                    // non-doc `//` line comment and a `/* */` block comment were
                    // already consumed by skip_trivia, so a `/` reaching here whose
                    // next byte is `/` MUST be a doc comment; otherwise it is Slash.
                    if s.nxt() == 47 {
                        let is_mod = s.nnxt() == 33            // `//!` -> ModDocComment
                        s.adv()  s.adv()  s.adv()             // consume `///` / `//!`
                        if !s.at_end() && s.cur() == 32 { s.adv() }   // one leading space
                        let cstart = s.pos
                        while !s.at_end() && s.cur() != 10 { s.adv() }  // content to EOL
                        let content = source.substring(cstart, s.pos)
                        let kind = if is_mod { Tk.ModDocComment } else { Tk.DocComment }
                        out = out + emit(kind, tok_line, tok_col, content)
                    } else {
                        s.adv()
                        out = out + emit(Tk.Slash, tok_line, tok_col, "/")
                    }
                } else if b == 39 {
                    // Char literal `'x'` / `'\n'` -> Number(codepoint), byte-identical
                    // to scan_char_literal (lexer.av ~295-336). IN subset: a single
                    // ASCII byte (codepoint == byte value) or one of the fixed escapes
                    // \n \t \r \0 \\ \'. OUT (marker): a multi-byte UTF-8 char (needs a
                    // codepoint decode), an unknown escape, or a missing closing `'`
                    // (the last two are invalid programs the hand lexer flags as Error).
                    s.adv()                                        // consume opening `'`
                    if s.at_end() { return "<out-of-subset:char-literal>" }
                    mut code = 0
                    let c = s.cur()
                    if c == 92 {                                   // `\` escape
                        s.adv()
                        if s.at_end() { return "<out-of-subset:char-literal>" }
                        let esc = s.cur()
                        s.adv()
                        if esc == 110 { code = 10 }                // \n
                        else if esc == 116 { code = 9 }            // \t
                        else if esc == 114 { code = 13 }           // \r
                        else if esc == 48 { code = 0 }             // \0
                        else if esc == 92 { code = 92 }            // \\
                        else if esc == 39 { code = 39 }            // \'
                        else { return "<out-of-subset:char-literal>" }   // unknown escape
                    } else if c >= 128 {
                        return "<out-of-subset:char-literal>"      // multi-byte UTF-8
                    } else {
                        code = c                                   // ASCII: codepoint == byte
                        s.adv()
                    }
                    if s.at_end() || s.cur() != 39 { return "<out-of-subset:char-literal>" }
                    s.adv()                                        // consume closing `'`
                    out = out + emit(Tk.Number, tok_line, tok_col, string(code))
                } else if b == 34 {
                    // String literal `"..."` -> String, byte-identical to
                    // scan_string_token (lexer.av ~435-529) for the single-line,
                    // NON-interpolated case. The lexeme keeps the surrounding quotes
                    // and carries the ESCAPE-RESOLVED content (\n -> a real newline,
                    // \xHH -> that byte, ...); lex_escape re-escapes it identically for
                    // both scanners in the dump. OUT of subset (marker): `"""` multiline,
                    // `${` interpolation (-> Template), and an unterminated string; raw
                    // `r"..."` is diverted at the Alpha arm. These are later slices.
                    s.adv()                                        // consume opening `"`
                    if s.cur() == 34 && s.nxt() == 34 { return "<out-of-subset:string>" }   // `"""`
                    mut content = "\""                             // keep the opening quote
                    while true {
                        if s.at_end() { return "<out-of-subset:string>" }   // unterminated
                        let sc = s.cur()
                        if sc == 34 { s.adv()  break }             // closing `"`
                        if sc == 36 && s.nxt() == 123 { return "<out-of-subset:string>" }  // `${`
                        if sc == 92 {                              // `\` escape
                            s.adv()
                            if s.at_end() { return "<out-of-subset:string>" }   // trailing `\`
                            let esc = s.cur()
                            s.adv()
                            if esc == 110 { content = content + "\n" }        // \n
                            else if esc == 116 { content = content + "\t" }   // \t
                            else if esc == 114 { content = content + "\r" }   // \r
                            else if esc == 92 { content = content + "\\" }    // \\
                            else if esc == 34 { content = content + "\"" }    // \"
                            else if esc == 48 { content = content + "\0" }    // \0
                            else if esc == 120 {                              // \xHH
                                if s.pos + 1 >= s.n { return "<out-of-subset:string>" }
                                let hi = source.substring(s.pos, s.pos + 1)
                                let lo = source.substring(s.pos + 1, s.pos + 2)
                                content = content + avra_char_from_hex(hi, lo)
                                s.adv()  s.adv()                              // consume the 2 hex digits
                            } else {                                          // unknown -> literal \+esc
                                content = content + "\\" + source.substring(s.pos - 1, s.pos)
                            }
                        } else {
                            content = content + source.substring(s.pos, s.pos + 1)
                            s.adv()
                        }
                    }
                    content = content + "\""                       // closing quote
                    out = out + emit(Tk.String, tok_line, tok_col, content)
                } else {
                    // A compound-operator lead: maximal-munch it (byte-identical
                    // to the hand lexer). `.Error` = a lead this slice doesn't
                    // own yet (template `\`` quotes, backtick) — still out of subset.
                    let op = scan_compound_op(s, b)
                    match op {
                        .Error -> { return "<out-of-subset:char>" }
                        _ -> {
                            let text = source.substring(start, s.pos)
                            out = out + emit(op, tok_line, tok_col, text)
                        }
                    }
                }
            }
        }
    }
    out
}
