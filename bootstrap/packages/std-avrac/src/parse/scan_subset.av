// WHY: t-47hc.2 (Phase 1) — the FIRST generated byte-scanner. It proves a scanner
// built on the byte character-classification (charclass.av) emits a token stream
// BYTE-IDENTICAL to the hand lexer over a token SUBSET — validated differentially
// THROUGH the token-stream oracle (scan_subset_test.av: scan_subset(x) ==
// lex_dump(x)). This is the "compile don't interpret" DFA lexer in miniature: it
// branches on `char_class` and reads raw bytes via `byte_at` (no per-char string
// allocation), tracking line/column exactly as the hand lexer's advance_char does.
//
// SUBSET (byte-identical here): whitespace, `//` line comments, identifiers +
// keywords, PLAIN decimal integers, and the single-char punctuation with NO
// compound form (, ( ) { } [ ] : @ ~ % ^ + *). OUT of subset (later slices — they
// need lexer modes or maximal-munch, and would diverge): strings, doc/block
// comments, floats / hex / underscore numbers, and every compound-operator lead
// (= < > | & ? . - / !). scan_subset returns a "<out-of-subset:...>" marker when
// it meets an out-of-subset construct, so the differential test only compares
// in-subset inputs. Unused in production (byte-identical; diff-test).
use core.{Tk, tk_name}
use parse.{p_keyword_kind, byte_at, char_class, cc_is_ident_cont, cc_is_digit, CharClass, lex_escape}

extern fn avra_bytes_from_string(s: string) -> bytes

/// Scanner cursor over the source, threaded as a struct (no mutable globals).
/// `line`/`col` are 1-indexed and advance exactly like the hand lexer's
/// advance_char: col += 1 per byte, and a newline sets line += 1, col = 1.
type ScanState = { src: string, bytes: bytes, n: int, pos: int, line: int, col: int }

impl ScanState {
    fn at_end(self) -> bool { self.pos >= self.n }
    fn cur(self) -> int { byte_at(self.bytes, self.pos) }
    fn nxt(self) -> int { byte_at(self.bytes, self.pos + 1) }
    fn nnxt(self) -> int { byte_at(self.bytes, self.pos + 2) }

    /// Consume one byte, updating line/column like advance_char.
    fn adv(self) {
        let b = byte_at(self.bytes, self.pos)
        self.pos = self.pos + 1
        if b == 10 {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
    }

    /// Skip whitespace and `//` line comments, matching
    /// skip_whitespace_and_comments for the subset. Returns false on a `///`/
    /// `//!` doc comment (out of subset — advance_token would emit a token).
    fn skip_trivia(self) -> bool {
        while !self.at_end() {
            let b = self.cur()
            if b == 32 || b == 13 || b == 9 || b == 10 {   // space, CR, tab, LF
                self.adv()
            } else if b == 47 && self.nxt() == 47 {         // `//`
                let third = self.nnxt()
                if third == 47 || third == 33 {             // `///` or `//!` (doc)
                    return false
                }
                while !self.at_end() && self.cur() != 10 {  // to end of line
                    self.adv()
                }
            } else {
                return true
            }
        }
        true
    }
}

/// The single-char-punctuation subset: byte -> its Tk, or Tk.Error for a byte
/// that is NOT a subset punctuation (out of subset). Excludes every byte with a
/// compound form (= < > | & ? . - / !) — those need maximal-munch (a later slice).
fn subset_punct_tk(b: int) -> Tk {
    if b == 44 { return .Comma }         // ,
    if b == 40 { return .LeftParen }     // (
    if b == 41 { return .RightParen }    // )
    if b == 123 { return .LeftBrace }    // {
    if b == 125 { return .RightBrace }   // }
    if b == 91 { return .LeftBracket }   // [
    if b == 93 { return .RightBracket }  // ]
    if b == 58 { return .Colon }         // :
    if b == 64 { return .At }            // @
    if b == 126 { return .Tilde }        // ~
    if b == 37 { return .Percent }       // %
    if b == 94 { return .Caret }         // ^
    if b == 43 { return .Plus }          // +
    if b == 42 { return .Star }          // *
    .Error
}

fn is_subset_punct(b: int) -> bool {
    match subset_punct_tk(b) {
        .Error -> false
        _ -> true
    }
}

/// One dump line in the oracle's format: `<kind>\t<line>:<col>\t<escaped-lexeme>`.
fn emit(kind: Tk, line: int, col: int, lexeme: string) -> string {
    tk_name(kind) + "\t" + string(line) + ":" + string(col) + "\t" + lex_escape(lexeme) + "\n"
}

/// Scan `source` (restricted to the subset above) into the token stream in the
/// oracle's exact `lex_dump` format, so `scan_subset(x) == lex_dump(x)` iff the
/// generated scanner is byte-identical to the hand lexer on `x`. Returns an
/// `<out-of-subset:...>` marker (never a valid dump) on any out-of-subset byte.
export fn scan_subset(source: string) -> string {
    mut s = ScanState { src: source, bytes: avra_bytes_from_string(source), n: source.length, pos: 0, line: 1, col: 1 }
    mut out = ""
    while true {
        if !s.skip_trivia() { return "<out-of-subset:doc-comment>" }
        let tok_line = s.line
        let tok_col = s.col
        let start = s.pos
        if s.at_end() {
            return out + emit(Tk.Eof, tok_line, tok_col, "")
        }
        let b = s.cur()
        let cls = char_class(b)
        match cls {
            .Alpha -> {
                s.adv()
                while !s.at_end() && cc_is_ident_cont(s.cur()) { s.adv() }
                let text = source.substring(start, s.pos)
                out = out + emit(p_keyword_kind(text), tok_line, tok_col, text)
            }
            .Digit -> {
                s.adv()
                while !s.at_end() && cc_is_digit(s.cur()) { s.adv() }
                let text = source.substring(start, s.pos)
                // A non-plain number is out of subset (the hand lexer would keep
                // scanning): `.` (float/dot), `_` (digit-group separator, kept IN
                // the number), and a 0x/0b/0o prefix — the last ONLY when the
                // digits so far are exactly "0" (else e.g. `42x` is Number + Ident,
                // which IS in subset). Matches scan_number_token's triggers.
                if !s.at_end() {
                    let after = s.cur()
                    if after == 46 || after == 95 {
                        return "<out-of-subset:number>"
                    }
                    if text == "0" && (after == 120 || after == 88 || after == 98 || after == 66 || after == 111 || after == 79) {
                        return "<out-of-subset:number>"
                    }
                    // Duration suffixes (Nd Nh Nm Ns Nms) — scan_number_token folds
                    // these into ONE transformed Number (e.g. 1d -> 86400000), so
                    // they are NOT plain integers and are out of subset. Each fires
                    // ONLY when the char after the suffix is not ident-continue, so
                    // `1down` / `5m2` stay a plain Number + Identifier (byte-identical
                    // to the hand lexer, which requires !p_is_alpha_numeric there).
                    // `Nms` is the one two-char suffix: `m` followed by `s`.
                    let after2 = s.nxt()
                    if (after == 100 || after == 104 || after == 115) && !cc_is_ident_cont(after2) {
                        return "<out-of-subset:number>"   // Nd / Nh / Ns
                    }
                    if after == 109 && (after2 == 115 || !cc_is_ident_cont(after2)) {
                        return "<out-of-subset:number>"   // Nm / Nms
                    }
                }
                out = out + emit(Tk.Number, tok_line, tok_col, text)
            }
            _ -> {
                if !is_subset_punct(b) { return "<out-of-subset:char>" }
                s.adv()
                let text = source.substring(start, s.pos)
                out = out + emit(subset_punct_tk(b), tok_line, tok_col, text)
            }
        }
    }
    out
}
