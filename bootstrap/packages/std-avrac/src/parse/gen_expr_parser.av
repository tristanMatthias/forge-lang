// GENERATED by `bash scripts/diagnose.sh --emit-regen-expr` — DO NOT EDIT BY HAND.
// Source of truth: the §2 expression grammar in features/grammar/avra_grammar.av.
// This is the PRODUCTION expression parser under AVRA_PARSER_EXPR_STATIC=1 (ps3t.6.7
// Step G); parse/tests/gen_expr_parser_regen_test.av asserts it equals
// emit_expr_parser_file() so a grammar edit that isn't regenerated fails the suite.
use features.grammar.{Token, CapVal, PState, capval_to_expr, run_hand_expr, mk_binary, mk_assign_expr, fold_pipe_expr, fold_nullish_expr, fold_logical_expr, rebind_eq_expr, mk_is_expr, mk_inlist_expr, mk_inrange_expr, mk_eqchain_expr, tok_starts_expr_leaf}
use core.{ExprId}

// generated recursive-descent parser for grammar `grammar`
fn binary_lbp_g(t: Token) -> int {
    let x = t.text
    if x == "|" { return 10 }
    if x == "^" { return 12 }
    if x == "&" { return 14 }
    if x == "<" || x == "<=" || x == ">" || x == ">=" { return 16 }
    if x == "<<" || x == ">>" { return 18 }
    if x == "+" || x == "-" { return 20 }
    if x == "*" || x == "/" || x == "%" { return 22 }
    0
}

fn parse_binary_pratt_g_id(st: PState, min_bp: int) -> ExprId {
    let sp_start = st.cur().pos
    mut lhs = run_hand_expr("hand_unary", st)
    while true {
        let lbp = binary_lbp_g(st.cur())
        if lbp == 0 || lbp < min_bp { break }
        let tx = st.cur().text
        if (tx == "+" || tx == "-") && st.modes.cell_mode && st.pos > 0 && st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line != st.store.lines.to_linecol(st.cur().pos).line { break }
        let _ = st.advance()
        let rhs = parse_binary_pratt_g_id(st, lbp + 1)
        lhs = mk_binary(st, sp_start, lhs, tx, rhs)
    }
    lhs
}

fn parse_binary_pratt_g(st: PState, min_bp: int) -> CapVal { CapVal.Node(parse_binary_pratt_g_id(st, min_bp)) }

export fn parse_expression(st: PState) -> CapVal {
    parse_assignment(st)
}

fn parse_assignment(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut r: CapVal = CapVal.Nil
    let l = parse_pipe(st)
    if st.cur().text == "=" {
        let _ = st.advance()
        r = parse_assignment(st)
    }
    CapVal.Node(mk_assign_expr(st, sp_start, l, r))
}

fn parse_pipe(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut r_list: List<ExprId> = []
    let l = parse_null_coalesce(st)
    while st.cur().text == "|>" {
        let _ = st.advance()
        r_list.push(capval_to_expr(st, parse_pipe_arg(st)))
    }
    CapVal.Node(fold_pipe_expr(st, sp_start, l, CapVal.Nodes(r_list)))
}

fn parse_pipe_arg(st: PState) -> CapVal {
    CapVal.Node(run_hand_expr("pipe_rhs", st))
}

fn parse_null_coalesce(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let l = parse_logic_or(st)
    if !(st.cur().text == "??") { return l }
    mut ops: List<Token> = []
    mut rs: List<ExprId> = []
    while st.cur().text == "??" {
        ops.push(st.advance())
        rs.push(capval_to_expr(st, parse_logic_or(st)))
    }
    CapVal.Node(fold_nullish_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))
}

fn parse_logic_or(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let l = parse_logic_and(st)
    if !(st.cur().text == "||" || st.cur().text == "or") { return l }
    mut ops: List<Token> = []
    mut rs: List<ExprId> = []
    while st.cur().text == "||" || st.cur().text == "or" {
        ops.push(st.advance())
        rs.push(capval_to_expr(st, parse_logic_and(st)))
    }
    CapVal.Node(fold_logical_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))
}

fn parse_logic_and(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let l = parse_equality(st)
    if !(st.cur().text == "&&" || st.cur().text == "and") { return l }
    mut ops: List<Token> = []
    mut rs: List<ExprId> = []
    while st.cur().text == "&&" || st.cur().text == "and" {
        ops.push(st.advance())
        rs.push(capval_to_expr(st, parse_equality(st)))
    }
    CapVal.Node(fold_logical_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))
}

fn parse_equality(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut tail: CapVal = CapVal.Nil
    let base = parse_bitor(st)
    if st.cur().text == "is" || st.cur().text == "in" || st.cur().text == "==" || st.cur().text == "!=" {
        tail = parse_eq_tail(st)
    }
    CapVal.Node(rebind_eq_expr(st, sp_start, base, tail))
}

fn parse_eq_tail(st: PState) -> CapVal {
    if st.cur().text == "is" {
        let _ = st.advance()
        if st.cur().text == "." { let _ = st.advance() }
        let v = CapVal.Tok(st.advance())
        return CapVal.Node(mk_is_expr(st, v))
    }
    if st.cur().text == "in" {
        let _ = st.advance()
        let ir = parse_in_rhs(st)
        return ir
    }
    if st.cur().text == "==" || st.cur().text == "!=" {
        mut op_list: List<Token> = []
        mut r_list: List<ExprId> = []
        while st.cur().text == "==" || st.cur().text == "!=" {
            op_list.push(st.advance())
            r_list.push(capval_to_expr(st, parse_bitor(st)))
        }
        return CapVal.Node(mk_eqchain_expr(st, CapVal.Toks(op_list), CapVal.Nodes(r_list)))
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_in_rhs(st: PState) -> CapVal {
    if st.cur().text == "[" {
        mut a_list: List<ExprId> = []
        let _ = st.advance()
        if tok_starts_expr_leaf(st.cur()) {
            a_list.push(capval_to_expr(st, parse_expression(st)))
            while st.cur().text == "," {
                let _ = st.advance()
                a_list.push(capval_to_expr(st, parse_expression(st)))
            }
        }
        if st.cur().text == "]" { let _ = st.advance() }
        return CapVal.Node(mk_inlist_expr(st, CapVal.Nodes(a_list)))
    }
    if tok_starts_expr_leaf(st.cur()) {
        let s = parse_bitor(st)
        if st.cur().text == ".." { let _ = st.advance() }
        let e = parse_bitor(st)
        return CapVal.Node(mk_inrange_expr(st, s, e))
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_bitor(st: PState) -> CapVal { parse_binary_pratt_g(st, 10) }

fn parse_bitxor(st: PState) -> CapVal { parse_binary_pratt_g(st, 12) }

fn parse_bitand(st: PState) -> CapVal { parse_binary_pratt_g(st, 14) }

fn parse_comparison(st: PState) -> CapVal { parse_binary_pratt_g(st, 16) }

fn parse_shift(st: PState) -> CapVal { parse_binary_pratt_g(st, 18) }

fn parse_term(st: PState) -> CapVal { parse_binary_pratt_g(st, 20) }

fn parse_factor(st: PState) -> CapVal { parse_binary_pratt_g(st, 22) }

fn parse_unary(st: PState) -> CapVal {
    CapVal.Node(run_hand_expr("hand_unary", st))
}

