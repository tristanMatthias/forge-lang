fn parse_spawn_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let _ = st.advance()
    let body = parse_block_expr(st)
    mk_spawn(st, sp_start, body)
}

fn parse_isolated_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let _ = st.advance()
    let body = parse_block_expr(st)
    mk_isolated(st, sp_start, body)
}

fn parse_block_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut stmts_list: List<StmtId> = []
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.at_end() || st.cur().text == "}" { break }
        let __sp = st.cur().pos
        st.clear_error()
        let __cv = parse_declaration(st)
        if st.had_error {
            __any_err = true
            st.synchronize_stmt()
            if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
            let __elc = st.store.lines.to_linecol(__sp)
            let __e = st.store.stmts.add_leaf(Stmt.Error)
            st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
            stmts_list.push(__e)
            st.clear_error()
            continue
        }
        let __sid = capval_to_stmt(st, __cv)
        let __lc = st.store.lines.to_linecol(__sp)
        st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
        stmts_list.push(__sid)
    }
    if __any_err { st.note_had_error() }
    st.set_modes(__modes_1)
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_expr_block(st, sp_start, CapVal.SNodes(stmts_list))
}

fn parse_when_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut a_list: List<WhenArm> = []
    let _ = st.advance()
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().text == "_" || st.cur().text == "else" || st.cur().tk == Tk.Bang || st.cur().tk == Tk.Minus || st.cur().text == "not" || st.modes.quote_depth == 0 && (st.cur().tk == Tk.Tilde) || st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) || (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) || st.cur().tk == Tk.String || (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) || st.cur().text == "null" || st.cur().text == "none" || st.cur().tk == Tk.Dot || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && ((st.cur().text == "match")) || st.cur().text == "match" || lookahead_ok("if_let", st) && (st.cur().text == "if") || st.cur().text == "if" || st.cur().text == "spawn" || st.cur().text == "channel" || st.cur().text == "isolated" || st.cur().text == "when" || st.cur().text == "quote" || st.cur().tk == Tk.LeftBracket || lookahead_ok("brace_map", st) && (st.cur().tk == Tk.LeftBrace) || st.cur().tk == Tk.LeftBrace || st.cur().tk == Tk.At || lookahead_ok("lparen_ident_colon", st) && (st.cur().tk == Tk.LeftParen) || st.cur().tk == Tk.LeftParen || st.cur().tk == Tk.Template || lookahead_ok("ident_lbrace_plain", st) && st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_template", st) && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_plain", st) && (st.cur().tk == Tk.Identifier) || tok_starts_expr_leaf(st.cur()) {
        a_list.push(capval_to_when_arm(st, parse_when_arm(st)))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_when(st, sp_start, CapVal.WArms(a_list))
}

fn parse_match_expr(st: PState) -> CapVal {
    if lookahead_ok("match_subjectless", st) && (st.cur().text == "match") {
        let sp_start = st.cur().pos
        mut a_list: List<WhenArm> = []
        let _ = st.advance()
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected {")
        }
        while (st.cur().text == "_" || tok_starts_expr_leaf(st.cur())) {
            a_list.push(capval_to_when_arm(st, parse_match_when_arm(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after match arms")
            return CapVal.Node(st.error_node_silent())
        }
        return mk_when(st, sp_start, CapVal.WArms(a_list))
    }
    if lookahead_ok("match_table", st) && ((st.cur().text == "match")) {
        return parse_match_table_expr(st)
    }
    if st.cur().text == "match" {
        let sp_start = st.cur().pos
        mut arms_list: List<MatchArm> = []
        let _ = st.advance()
        let __modes_1 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let subj = parse_expression(st)
        st.set_modes(__modes_1)
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected `{` after match subject")
            return CapVal.Node(st.error_node_silent())
        }
        while tok_starts_pattern(st.cur()) {
            arms_list.push(capval_to_arm(st, parse_match_arm(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after match arms")
            return CapVal.Node(st.error_node_silent())
        }
        return mk_match_expr(st, sp_start, subj, CapVal.Arms(arms_list))
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_if_expr(st: PState) -> CapVal {
    if lookahead_ok("if_let", st) && (st.cur().text == "if") {
        return CapVal.Node(run_hand_expr("if_expr", st))
    }
    if st.cur().text == "if" {
        let sp_start = st.cur().pos
        mut e: CapVal = CapVal.Nil
        let _ = st.advance()
        let __modes_1 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let c = parse_expression(st)
        st.set_modes(__modes_1)
        if !(st.cur().tk == Tk.LeftBrace) {
            st.report("expected `{` after if condition")
            return CapVal.Node(st.error_node_silent())
        }
        let t = parse_block_expr(st)
        if st.cur().text == "else" {
            let _ = st.advance()
            e = parse_else_tail(st)
        }
        return mk_if_expr(st, sp_start, c, t, e)
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_else_tail(st: PState) -> CapVal {
    if lookahead_ok("if_let", st) && (st.cur().text == "if") || st.cur().text == "if" {
        return parse_if_expr(st)
    }
    if st.cur().tk == Tk.LeftBrace {
        return parse_block_expr(st)
    }
    parse_expression(st)
}

fn parse_when_arm(st: PState) -> CapVal {
    if st.cur().text == "_" || st.cur().text == "else" {
        let _ = st.advance()
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected ->")
        }
        let body = parse_expression(st)
        return mk_when_default(st, body)
