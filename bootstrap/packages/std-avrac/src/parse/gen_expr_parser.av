        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.restore_hand_state(s_hand)
    }
    if st.cur().tk == Tk.LeftParen {
        tried_spec = true
        let s_pos = st.pos
        let s_mark = st.store.mark()
        let s_diags = st.diags.length
        let s_err = st.had_error
        let s_hand = st.save_hand_state()
        let sp_start = st.cur().pos
        mut rest_list: List<ExprId> = []
        let _ = st.advance()
        let __modes_1 = st.modes
        st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
        let first = parse_expression(st)
        st.set_modes(__modes_1)
        if !(st.cur().tk == Tk.Comma) { st.report("expected at least one repetition") }
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            if st.cur().tk == Tk.Bang || st.cur().tk == Tk.Minus || st.cur().text == "not" || st.modes.quote_depth == 0 && (st.cur().tk == Tk.Tilde) || st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) || (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) || st.cur().tk == Tk.String || (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) || st.cur().text == "null" || st.cur().text == "none" || st.cur().tk == Tk.Dot || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && ((st.cur().text == "match")) || st.cur().text == "match" || lookahead_ok("if_let", st) && (st.cur().text == "if") || st.cur().text == "if" || st.cur().text == "spawn" || st.cur().text == "channel" || st.cur().text == "isolated" || st.cur().text == "when" || st.cur().text == "quote" || st.cur().tk == Tk.LeftBracket || lookahead_ok("brace_map", st) && (st.cur().tk == Tk.LeftBrace) || st.cur().tk == Tk.LeftBrace || st.cur().tk == Tk.At || lookahead_ok("lparen_ident_colon", st) && (st.cur().tk == Tk.LeftParen) || st.cur().tk == Tk.LeftParen || st.cur().tk == Tk.Template || lookahead_ok("ident_lbrace_plain", st) && st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_template", st) && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_plain", st) && (st.cur().tk == Tk.Identifier) || tok_starts_expr_leaf(st.cur()) {
                let __modes_0 = st.modes
                st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
                rest_list.push(capval_to_expr(st, parse_expression(st)))
                st.set_modes(__modes_0)
            }
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected )")
        }
        if st.diags.length == s_diags && st.had_error == s_err {
            return CapVal.Node(mk_tuple_fr(st, sp_start, first, CapVal.Nodes(rest_list)))
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.restore_hand_state(s_hand)
    }
    if st.cur().tk == Tk.LeftParen {
        let sp_start = st.cur().pos
        mut e: CapVal = CapVal.Nil
        let _ = st.advance()
        if st.cur().tk == Tk.Bang || st.cur().tk == Tk.Minus || st.cur().text == "not" || st.modes.quote_depth == 0 && (st.cur().tk == Tk.Tilde) || st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) || (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) || st.cur().tk == Tk.String || (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) || st.cur().text == "null" || st.cur().text == "none" || st.cur().tk == Tk.Dot || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && ((st.cur().text == "match")) || st.cur().text == "match" || lookahead_ok("if_let", st) && (st.cur().text == "if") || st.cur().text == "if" || st.cur().text == "spawn" || st.cur().text == "channel" || st.cur().text == "isolated" || st.cur().text == "when" || st.cur().text == "quote" || st.cur().tk == Tk.LeftBracket || lookahead_ok("brace_map", st) && (st.cur().tk == Tk.LeftBrace) || st.cur().tk == Tk.LeftBrace || st.cur().tk == Tk.At || lookahead_ok("lparen_ident_colon", st) && (st.cur().tk == Tk.LeftParen) || st.cur().tk == Tk.LeftParen || st.cur().tk == Tk.Template || lookahead_ok("ident_lbrace_plain", st) && st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_template", st) && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_plain", st) && (st.cur().tk == Tk.Identifier) || tok_starts_expr_leaf(st.cur()) {
            let __modes_0 = st.modes
            st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
            e = parse_expression(st)
            st.set_modes(__modes_0)
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected )")
        }
        return CapVal.Node(mk_group_or_empty(st, sp_start, e))
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_lambda_body(st: PState) -> CapVal {
    if st.cur().tk == Tk.LeftBrace {
        return parse_block_expr(st)
    }
    parse_expression(st)
}

fn parse_param(st: PState) -> CapVal {
    mut pt: CapVal = CapVal.Nil
    let pname = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon {
        let _ = st.advance()
        pt = parse_type_expr(st)
    }
    mk_param(st, capval_tok_text(pname), pt, capval_present(pt))
}

fn parse_table_cell(st: PState) -> CapVal {
    if st.cur().tk == Tk.At {
        return parse_qualified_expr(st)
    }
    if (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if st.cur().tk == Tk.String {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if st.cur().text == "null" || st.cur().text == "none" {
        return parse_null_cell(st)
    }
    if st.cur().tk == Tk.Dot {
        return parse_variant_ctor(st)
    }
    if lookahead_ok("ident_lbrace_plain", st) && st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.Identifier) {
        return parse_struct_lit_expr(st)
    }
    if lookahead_ok("ident_template", st) && (st.cur().tk == Tk.Identifier) {
        return parse_tagged_template(st)
    }
    if lookahead_ok("ident_plain", st) && (st.cur().tk == Tk.Identifier) {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if lookahead_ok("lparen_ident_colon", st) && (st.cur().tk == Tk.LeftParen) || st.cur().tk == Tk.LeftParen {
        return parse_paren_expr(st)
    }
    if st.cur().tk == Tk.LeftBracket {
        return parse_list_expr(st)
    }
    if lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && ((st.cur().text == "match")) || st.cur().text == "match" {
        return parse_match_expr(st)
    }
    if lookahead_ok("if_let", st) && (st.cur().text == "if") || st.cur().text == "if" {
        return parse_if_expr(st)
    }
    if st.cur().text == "spawn" {
        return parse_spawn_expr(st)
    }
    if st.cur().text == "channel" {
        return parse_channel_expr(st)
    }
    if st.cur().text == "isolated" {
        return parse_isolated_expr(st)
    }
    if st.cur().text == "when" {
        return parse_when_expr(st)
    }
    if st.cur().text == "quote" {
        return CapVal.Node(run_hand_expr("quote_expr", st))
    }
    if st.cur().tk == Tk.Template {
        return parse_template_lit(st)
    }
    parse_brace_expr(st)
}

fn parse_null_cell(st: PState) -> CapVal {
    let n = CapVal.Tok(st.advance())
    n
}

