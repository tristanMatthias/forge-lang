    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected field name")
    }
    CapVal.Node(mk_with_suffix(st, sp_start, CapVal.FInits(f_list)))
}

fn parse_field_init(st: PState) -> CapVal {
    mut v: CapVal = CapVal.Nil
    let n = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon {
        let _ = st.advance()
        v = parse_expression(st)
    }
    if st.cur().tk == Tk.Comma {
        let _ = st.advance()
    }
    mk_field_init(st, n, v)
}

