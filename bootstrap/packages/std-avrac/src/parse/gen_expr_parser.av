}

fn parse_index_tail(st: PState) -> CapVal {
    if st.cur().tk == Tk.DotDot {
        let _ = st.advance()
        let e = parse_expression(st)
        if st.cur().tk == Tk.RightBracket { let _ = st.advance() } else {
            st.report("expected `]` after slice")
            return CapVal.Node(st.error_node_silent())
        }
        return e
    }
    if st.cur().tk == Tk.RightBracket { let _ = st.advance() } else {
        st.report("expected `]` after index")
        return CapVal.Node(st.error_node_silent())
    }
    mk_none_cap(st)
}

fn parse_with_suffix(st: PState) -> CapVal {
    let sp_start = st.cur().pos
