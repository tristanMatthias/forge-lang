        let _ = st.advance()
        if st.cur().tk == Tk.Bang || st.cur().tk == Tk.Minus || st.cur().text == "not" || st.modes.quote_depth == 0 && (st.cur().tk == Tk.Tilde) || st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) || (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) || st.cur().tk == Tk.String || (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) || st.cur().text == "null" || st.cur().text == "none" || st.cur().tk == Tk.Dot || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && ((st.cur().text == "match")) || st.cur().text == "match" || lookahead_ok("if_let", st) && (st.cur().text == "if") || st.cur().text == "if" || st.cur().text == "spawn" || st.cur().text == "channel" || st.cur().text == "isolated" || st.cur().text == "when" || st.cur().text == "quote" || st.cur().tk == Tk.LeftBracket || lookahead_ok("brace_map", st) && (st.cur().tk == Tk.LeftBrace) || st.cur().tk == Tk.LeftBrace || st.cur().tk == Tk.At || lookahead_ok("lparen_ident_colon", st) && (st.cur().tk == Tk.LeftParen) || st.cur().tk == Tk.LeftParen || st.cur().tk == Tk.Template || lookahead_ok("ident_lbrace_plain", st) && st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_template", st) && (st.cur().tk == Tk.Identifier) || lookahead_ok("ident_plain", st) && (st.cur().tk == Tk.Identifier) || tok_starts_expr_leaf(st.cur()) {
            a_list.push(capval_to_expr(st, parse_expression(st)))
            while st.cur().tk == Tk.Comma {
                let _ = st.advance()
                a_list.push(capval_to_expr(st, parse_expression(st)))
            }
        }
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
        if st.cur().tk == Tk.RightBracket { let _ = st.advance() } else {
            st.report("expected ]")
        }
        return CapVal.Node(mk_list_lit(st, sp_start, CapVal.Nodes(a_list)))
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_list_comp(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut f: CapVal = CapVal.Nil
    let b = parse_expression(st)
    if st.cur().text == "for" { let _ = st.advance() } else {
        st.report("expected for")
    }
    let v = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().text == "in" { let _ = st.advance() } else {
        st.report("expected in")
    }
    let c = parse_expression(st)
    if st.cur().text == "if" {
        let _ = st.advance()
        f = parse_expression(st)
    }
    CapVal.Node(mk_list_comp(st, sp_start, capval_to_expr(st, b), capval_tok_text(v), capval_to_expr(st, c), f))
}

