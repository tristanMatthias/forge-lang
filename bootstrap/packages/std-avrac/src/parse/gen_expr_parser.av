fn parse_struct_lit_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut f_list: List<FieldInit> = []
    let n = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().tk == Tk.Identifier {
        f_list.push(capval_to_finit(st, parse_field_init(st)))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    CapVal.Node(mk_struct_lit(st, sp_start, n, CapVal.FInits(f_list)))
}

fn parse_tagged_template(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let n = CapVal.Tok(st.advance())
    let t = if st.cur().tk == Tk.Template { CapVal.Tok(st.advance()) } else {
        st.report("expected TEMPLATE")
        CapVal.Tok(st.cur())
    }
    CapVal.Node(mk_tagged_template(st, sp_start, n, t))
}

fn parse_qualified_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut s_list: List<Token> = []
    mut f_list: List<FieldInit> = []
    mut lb: CapVal = CapVal.Nil
    let _ = st.advance()
    let n = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if !(lookahead_ok("double_colon", st) && (st.cur().tk == Tk.Colon)) { st.report("expected `::` after the package name — a qualified reference is `@pkg::mod::name`; `@name` alone is annotation syntax") }
    while lookahead_ok("double_colon", st) && (st.cur().tk == Tk.Colon) {
        let _ = st.advance()
        if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
            st.report("expected :")
        }
        if st.cur().tk == Tk.Identifier { s_list.push(st.advance()) } else {
            st.report("expected IDENT")
        }
    }
    if st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.LeftBrace) {
        lb = CapVal.Tok(st.advance())
        while st.cur().tk == Tk.Identifier {
            f_list.push(capval_to_finit(st, parse_field_init(st)))
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after struct fields")
        }
    }
    CapVal.Node(mk_qualified(st, sp_start, n, CapVal.Toks(s_list), lb, CapVal.FInits(f_list)))
}

fn parse_template_lit(st: PState) -> CapVal {
    let t = CapVal.Tok(st.advance())
    CapVal.Node(mk_template(st, t))
}

fn parse_brace_expr(st: PState) -> CapVal {
    if lookahead_ok("brace_map", st) && (st.cur().tk == Tk.LeftBrace) {
        return parse_map_literal(st)
    }
    if st.cur().tk == Tk.LeftBrace {
        return parse_block_expr(st)
    }
    CapVal.Node(st.error_node("expected an expression"))
}

