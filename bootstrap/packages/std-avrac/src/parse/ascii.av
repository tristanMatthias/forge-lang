// WHY: t-47hc.2 (Phase 1) — named ASCII byte constants for the generated
// byte-scanner, so its branches read `s.cur() == SLASH` instead of the opaque
// `s.cur() == 47`. These name SOURCE BYTES (what the scanner reads), which are
// NOT token kinds: byte SLASH (47) becomes Tk.Slash, byte LPAREN (40) becomes
// Tk.LeftParen. The byte->token binding lives in the scanner's branches; the
// token->name binding is tk_name (core/ast.av); this file is the byte->name
// binding. They stay compile-time CONSTS (not a runtime lookup table) so the
// scanner keeps EMITTING BRANCHES rather than interpreting a table — the design's
// "compile the grammar, don't interpret it" rule. Pure data; no behaviour.

// ── Whitespace & control ──────────────────────────────────────────
export const NUL = 0          // \0
export const TAB = 9          // \t
export const LF = 10          // \n  (newline)
export const CR = 13          // \r
export const SPACE = 32

// ── Digit / letter range bounds (char_class) ──────────────────────
export const DIGIT_0 = 48     // '0'  (also the \0 escape char)
export const DIGIT_1 = 49     // '1'  (binary-digit upper bound)
export const DIGIT_7 = 55     // '7'  (octal-digit upper bound)
export const DIGIT_9 = 57     // '9'
export const UPPER_A = 65     // 'A'
export const UPPER_Z = 90     // 'Z'
export const LOWER_A = 97     // 'a'
export const LOWER_Z = 122    // 'z'
export const UNDERSCORE = 95  // '_'
export const MULTIBYTE_MIN = 128  // first non-ASCII (UTF-8 lead/continuation) byte

// ── Specific letters the scanner tests: hex prefixes (0x/0b/0o), the
//    duration suffixes (Nd/Nh/Nm/Ns/Nms), string/char escapes, raw `r"` ──
export const LOWER_B = 98     // 'b'  (0b binary prefix)
export const LOWER_D = 100    // 'd'  (Nd duration)
export const LOWER_H = 104    // 'h'  (Nh duration)
export const LOWER_M = 109    // 'm'  (Nm / Nms duration)
export const LOWER_N = 110    // 'n'  (\n escape)
export const LOWER_O = 111    // 'o'  (0o octal prefix)
export const LOWER_R = 114    // 'r'  (\r escape; raw string r")
export const LOWER_S = 115    // 's'  (Ns duration; the s of Nms)
export const LOWER_T = 116    // 't'  (\t escape)
export const LOWER_X = 120    // 'x'  (0x hex prefix; \x hex escape)
export const UPPER_B = 66     // 'B'  (0B)
export const UPPER_C = 67     // 'C'  (hex digit)
export const UPPER_D = 68     // 'D'  (hex digit)
export const UPPER_E = 69     // 'E'  (hex digit)
export const UPPER_F = 70     // 'F'  (hex-digit upper bound)
export const UPPER_O = 79     // 'O'  (0O)
export const UPPER_X = 88     // 'X'  (0X)

// ── The rest of the lowercase alphabet — the KEYWORD recogniser branches on
//    letters, so the generated classify_keyword (parse/gen_keyword_scanner.av)
//    needs a named constant for every letter a keyword contains. Completing a–z
//    here (a/b/d/h/m/n/o/r/s/t/x/z already above) keeps the generated branches
//    reading `b0 == LOWER_I`, never `b0 == 105`. ──
export const LOWER_C = 99     // 'c'
export const LOWER_E = 101    // 'e'
export const LOWER_F = 102    // 'f'
export const LOWER_G = 103    // 'g'
export const LOWER_I = 105    // 'i'
export const LOWER_J = 106    // 'j'
export const LOWER_K = 107    // 'k'
export const LOWER_L = 108    // 'l'
export const LOWER_P = 112    // 'p'
export const LOWER_Q = 113    // 'q'
export const LOWER_U = 117    // 'u'
export const LOWER_V = 118    // 'v'
export const LOWER_W = 119    // 'w'
export const LOWER_Y = 121    // 'y'

// ── Punctuation & operators (ordered by byte value) ───────────────
export const BANG = 33        // !
export const DQUOTE = 34      // "
export const DOLLAR = 36      // $
export const PERCENT = 37     // %
export const AMP = 38         // &
export const SQUOTE = 39      // '
export const LPAREN = 40      // (
export const RPAREN = 41      // )
export const STAR = 42        // *
export const PLUS = 43        // +
export const COMMA = 44       // ,
export const MINUS = 45       // -
export const DOT = 46         // .
export const SLASH = 47       // /
export const COLON = 58       // :
export const LESS = 60        // <
export const EQUALS = 61      // =
export const GREATER = 62     // >
export const QUESTION = 63    // ?
export const AT = 64          // @
export const LBRACKET = 91    // [
export const BACKSLASH = 92   // \
export const RBRACKET = 93    // ]
export const CARET = 94       // ^
export const BACKTICK = 96    // `  (template string delimiter)
export const LBRACE = 123     // {
export const PIPE = 124       // |
export const RBRACE = 125     // }
export const TILDE = 126      // ~

// ── byte -> constant NAME (the inverse) ───────────────────────────
/// The exported constant NAME for a source byte — the inverse of the byte->value
/// constants above (e.g. `BANG` -> "BANG", `LOWER_I` -> "LOWER_I"). The scanner
/// generators (emit_lex.av) use it so GENERATED branches read `b0 == BANG` /
/// `b0 == LOWER_I`, not `b0 == 33` / `b0 == 105`: a named constant, not a magic
/// number. Written against the CONSTANTS themselves (never a bare literal), so this
/// table has no magic numbers either. Total over the operator/punctuation bytes AND
/// the lowercase alphabet (the keyword recogniser's bytes); returns "" for any other
/// byte — never reached for the operator or keyword tables.
export fn ascii_const_name(b: int) -> string {
    // Lowercase alphabet (keyword recogniser).
    if b == LOWER_A { return "LOWER_A" }
    if b == LOWER_B { return "LOWER_B" }
    if b == LOWER_C { return "LOWER_C" }
    if b == LOWER_D { return "LOWER_D" }
    if b == LOWER_E { return "LOWER_E" }
    if b == LOWER_F { return "LOWER_F" }
    if b == LOWER_G { return "LOWER_G" }
    if b == LOWER_H { return "LOWER_H" }
    if b == LOWER_I { return "LOWER_I" }
    if b == LOWER_J { return "LOWER_J" }
    if b == LOWER_K { return "LOWER_K" }
    if b == LOWER_L { return "LOWER_L" }
    if b == LOWER_M { return "LOWER_M" }
    if b == LOWER_N { return "LOWER_N" }
    if b == LOWER_O { return "LOWER_O" }
    if b == LOWER_P { return "LOWER_P" }
    if b == LOWER_Q { return "LOWER_Q" }
    if b == LOWER_R { return "LOWER_R" }
    if b == LOWER_S { return "LOWER_S" }
    if b == LOWER_T { return "LOWER_T" }
    if b == LOWER_U { return "LOWER_U" }
    if b == LOWER_V { return "LOWER_V" }
    if b == LOWER_W { return "LOWER_W" }
    if b == LOWER_X { return "LOWER_X" }
    if b == LOWER_Y { return "LOWER_Y" }
    if b == LOWER_Z { return "LOWER_Z" }
    // Operators & punctuation.
    if b == BANG { return "BANG" }
    if b == DQUOTE { return "DQUOTE" }
    if b == DOLLAR { return "DOLLAR" }
    if b == PERCENT { return "PERCENT" }
    if b == AMP { return "AMP" }
    if b == SQUOTE { return "SQUOTE" }
    if b == LPAREN { return "LPAREN" }
    if b == RPAREN { return "RPAREN" }
    if b == STAR { return "STAR" }
    if b == PLUS { return "PLUS" }
    if b == COMMA { return "COMMA" }
    if b == MINUS { return "MINUS" }
    if b == DOT { return "DOT" }
    if b == SLASH { return "SLASH" }
    if b == COLON { return "COLON" }
    if b == LESS { return "LESS" }
    if b == EQUALS { return "EQUALS" }
    if b == GREATER { return "GREATER" }
    if b == QUESTION { return "QUESTION" }
    if b == AT { return "AT" }
    if b == LBRACKET { return "LBRACKET" }
    if b == BACKSLASH { return "BACKSLASH" }
    if b == RBRACKET { return "RBRACKET" }
    if b == CARET { return "CARET" }
    if b == LBRACE { return "LBRACE" }
    if b == PIPE { return "PIPE" }
    if b == RBRACE { return "RBRACE" }
    if b == TILDE { return "TILDE" }
    ""
}
