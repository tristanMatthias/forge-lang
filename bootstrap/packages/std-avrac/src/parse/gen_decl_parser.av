fn parse_statement(st: PState) -> CapVal {
    if st.cur().text == "break" {
        return parse_break_stmt(st)
    }
    if st.cur().text == "continue" {
        return parse_continue_stmt(st)
    }
    if lookahead_ok("if_let", st) && (st.cur().text == "if") {
        return parse_iflet_stmt(st)
    }
    if st.cur().text == "if" {
        return parse_if_stmt(st)
    }
    if lookahead_ok("for_destructure", st) && (st.cur().text == "for") || st.cur().text == "for" {
        return parse_for_stmt(st)
    }
    if st.cur().text == "while" {
        return parse_while_stmt(st)
    }
    if lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && (st.cur().text == "match") || st.cur().text == "match" {
        return parse_match_stmt(st)
    }
    if st.cur().text == "defer" {
        return parse_defer_stmt(st)
    }
    if st.cur().text == "errdefer" {
        return parse_errdefer_stmt(st)
    }
    if st.cur().text == "return" {
        return parse_return_stmt(st)
    }
    if lookahead_ok("stmt_block", st) && (st.cur().tk == Tk.LeftBrace) {
        return parse_stmt_block(st)
    }
    parse_expr_stmt(st)
}

fn parse_block(st: PState) -> CapVal {
