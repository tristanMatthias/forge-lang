}

fn parse_use_decl(st: PState) -> CapVal {
    mut tried_spec = false
    if st.cur().text == "use" {
        tried_spec = true
        let s_pos = st.pos
        let s_mark = st.store.mark()
        let s_diags = st.diags.length
        let s_err = st.had_error
        mut s_cut = false
        let s_gensym = st.gensym_seq
        let s_postfix = st.save_postfix_state()
        while true {
            let _ = st.advance()
            if st.diags.length == s_diags && st.had_error == s_err { s_cut = true }
            if !s_cut { break }
            let ut = parse_use_tail(st)
            if s_cut || (st.diags.length == s_diags && st.had_error == s_err) {
                return ut
            }
            break
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.set_gensym_seq(s_gensym)
        st.restore_postfix_state(s_postfix)
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_use_tail(st: PState) -> CapVal {
    if st.cur().tk == Tk.At {
        mut useg_list: List<Token> = []
        mut unames_list: List<Token> = []
        let _ = st.advance()
        let upkg = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report_ident("expected package name")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
            CapVal.Tok(st.cur())
        }
        if st.cur().tk == Tk.Dot { let _ = st.advance() } else {
            st.report("expected `.` after package scope")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        if text_is_word(st.cur().text) { useg_list.push(st.advance()) } else {
            st.report("expected module path segment")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        while st.cur().tk == Tk.Dot {
            let _ = st.advance()
            if text_is_word(st.cur().text) {
                useg_list.push(st.advance())
            }
        }
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected `{` in use declaration")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        while st.cur().tk == Tk.Identifier {
            unames_list.push(st.advance())
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` in use declaration")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        return mk_use_pkg(st, capval_tok_list(upkg), useg_list, unames_list)
    }
    mut useg_list: List<Token> = []
    mut unames_list: List<Token> = []
    if text_is_word(st.cur().text) { useg_list.push(st.advance()) } else {
        st.report("expected module path after `use`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    while st.cur().tk == Tk.Dot {
        let _ = st.advance()
        if text_is_word(st.cur().text) {
            useg_list.push(st.advance())
        }
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` in use declaration")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    while st.cur().tk == Tk.Identifier {
        unames_list.push(st.advance())
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` in use declaration")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    mk_use(st, false, useg_list, unames_list)
}

