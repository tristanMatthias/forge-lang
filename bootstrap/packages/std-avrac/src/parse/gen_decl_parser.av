fn parse_config_entry(st: PState) -> CapVal {
    mut a_list: List<Token> = []
    mut d: CapVal = CapVal.Nil
    let k = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
        st.report("expected `:` after config key")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if !((st.modes.quote_depth > 0 && st.cur().tk == Tk.Tilde || tok_starts_type(st.cur()))) {
        st.report("expected config type")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    st.set_abort_prop(false)
    let __rres2 = parse_type_expr(st)
    if st.abort_prop || capval_is_error_expr(st, __rres2) || capval_is_error_stmt(st, __rres2) {
        return CapVal.Node(st.error_node_silent())
    }
    let ty = __rres2
    if st.cur().tk == Tk.Equal {
        let _ = st.advance()
        d = parse_expression(st)
    }
    while st.cur().tk == Tk.At {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier {
            a_list.push(st.advance())
        }
    }
