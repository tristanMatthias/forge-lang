fn parse_use_decl(st: PState) -> CapVal {
    let _ = st.advance()
    let ut = parse_use_tail(st)
    ut
}

fn parse_use_tail(st: PState) -> CapVal {
    if st.cur().tk == Tk.At {
        mut useg_list: List<Token> = []
        mut unames_list: List<Token> = []
        let _ = st.advance()
        let upkg = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report("expected IDENT")
            CapVal.Tok(st.cur())
        }
        if st.cur().tk == Tk.Dot { let _ = st.advance() } else {
            st.report("expected .")
        }
        if st.cur().tk == Tk.Identifier { useg_list.push(st.advance()) } else {
            st.report("expected IDENT")
        }
        while st.cur().tk == Tk.Dot {
            let _ = st.advance()
            if st.cur().tk == Tk.Identifier {
                useg_list.push(st.advance())
            }
        }
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected {")
        }
        while st.cur().tk == Tk.Identifier {
            unames_list.push(st.advance())
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected }")
        }
        return mk_use_pkg(st, capval_tok_list(upkg), useg_list, unames_list)
    }
    if st.cur().tk == Tk.Identifier {
        mut useg_list: List<Token> = []
        mut unames_list: List<Token> = []
        useg_list.push(st.advance())
        while st.cur().tk == Tk.Dot {
            let _ = st.advance()
            if st.cur().tk == Tk.Identifier {
                useg_list.push(st.advance())
            }
        }
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected {")
        }
        while st.cur().tk == Tk.Identifier {
            unames_list.push(st.advance())
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected }")
        }
        return mk_use(st, false, useg_list, unames_list)
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_mod_decl(st: PState) -> CapVal {
    let _ = st.advance()
    let mdname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    mk_module(st, capval_tok_text(mdname))
}

fn parse_type_decl(st: PState) -> CapVal {
    mut tparams_list: List<TypeParamEntry> = []
    mut fields_list: List<FieldEntry> = []
    mut topf_list: List<Token> = []
    mut talias: CapVal = CapVal.Nil
    mut top: CapVal = CapVal.Nil
    let _ = st.advance()
    let tname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        tparams_list.push(capval_to_tparam(st, parse_tparam(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            tparams_list.push(capval_to_tparam(st, parse_tparam(st)))
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected >")
        }
    }
    if st.cur().tk == Tk.Equal { let _ = st.advance() } else {
        st.report("expected =")
    }
    if st.cur().tk == Tk.LeftBrace || tok_starts_type(st.cur()) {
        if st.cur().tk == Tk.LeftBrace {
            let _ = st.advance()
            while st.cur().tk == Tk.Identifier {
                fields_list.push(capval_to_field(st, parse_field(st)))
                if st.cur().tk == Tk.Comma { let _ = st.advance() }
            }
            if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
                st.report("expected }")
            }
        } else if tok_starts_type(st.cur()) {
            talias = parse_type_expr(st)
            if st.cur().text == "without" || st.cur().text == "only" {
                top = CapVal.Tok(st.advance())
                if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
                    st.report("expected {")
                }
                while st.cur().tk == Tk.Identifier {
                    topf_list.push(st.advance())
                    if st.cur().tk == Tk.Comma { let _ = st.advance() }
                }
                if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
                    st.report("expected }")
                }
            }
        }
    }
    mk_type_decl_any(st, capval_tok_text(tname), tparams_list, fields_list, talias, capval_present(talias), top, capval_present(top), topf_list)
}

fn parse_shape_decl(st: PState) -> CapVal {
    mut shfields_list: List<FieldEntry> = []
    let _ = st.advance()
    let shname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Equal { let _ = st.advance() } else {
        st.report("expected =")
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().tk == Tk.Identifier {
        shfields_list.push(capval_to_field(st, parse_field(st)))
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_shape_decl(st, capval_tok_text(shname), shfields_list)
}

fn parse_field(st: PState) -> CapVal {
    let fname = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
        st.report("expected :")
    }
    let ftype = parse_type_expr(st)
    mk_field(st, capval_tok_text(fname), ftype)
}

fn parse_tparam(st: PState) -> CapVal {
    mut tpb: CapVal = CapVal.Nil
    let tpn = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { tpb = CapVal.Tok(st.advance()) } else {
            st.report("expected IDENT")
        }
    }
    mk_type_param(capval_tok_text(tpn), tpb, capval_present(tpb))
}

fn parse_enum_decl(st: PState) -> CapVal {
    mut tparams_list: List<TypeParamEntry> = []
    mut vars_list: List<Variant> = []
    let _ = st.advance()
    let ename = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        tparams_list.push(capval_to_tparam(st, parse_tparam(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            tparams_list.push(capval_to_tparam(st, parse_tparam(st)))
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected >")
        }
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().tk == Tk.DocComment {
        let _ = st.advance()
    }
    while st.cur().tk == Tk.Identifier {
        vars_list.push(capval_to_variant(st, parse_variant(st)))
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
        while st.cur().tk == Tk.DocComment {
            let _ = st.advance()
        }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_enum_decl_g(st, capval_tok_text(ename), tparams_list, vars_list)
}

fn parse_variant(st: PState) -> CapVal {
    mut vfields_list: List<FieldEntry> = []
    let vname = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.LeftParen {
        let _ = st.advance()
        while st.cur().tk == Tk.Identifier {
            vfields_list.push(capval_to_field(st, parse_field(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected )")
        }
    }
    mk_evariant(capval_tok_text(vname), vfields_list)
}

fn parse_fn_decl(st: PState) -> CapVal {
    mut tparams_list: List<TypeParamEntry> = []
    mut params_list: List<ParamEntry> = []
    mut body_list: List<StmtId> = []
    mut ret: CapVal = CapVal.Nil
    let _ = st.advance()
    let name = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        tparams_list.push(capval_to_tparam(st, parse_tparam(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            tparams_list.push(capval_to_tparam(st, parse_tparam(st)))
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected >")
        }
    }
    if st.cur().tk == Tk.LeftParen { let _ = st.advance() } else {
        st.report("expected (")
    }
    if st.cur().tk == Tk.Identifier {
        params_list.push(capval_to_pentry(st, parse_param(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            params_list.push(capval_to_pentry(st, parse_param(st)))
        }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected )")
    }
    if st.cur().tk == Tk.Arrow {
        let _ = st.advance()
        ret = parse_type_expr(st)
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().text == "break" || st.cur().text == "continue" || st.cur().text == "if" || lookahead_ok("for_destructure", st) && (st.cur().text == "for") || st.cur().text == "for" || st.cur().text == "while" || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && (st.cur().text == "match") || st.cur().text == "match" || st.cur().text == "defer" || st.cur().text == "errdefer" || st.cur().text == "return" || lookahead_ok("stmt_block", st) && (st.cur().tk == Tk.LeftBrace) || tok_starts_expr_leaf(st.cur()) {
        body_list.push(capval_to_stmt(st, parse_statement(st)))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_fn_decl_g(st, capval_tok_text(name), tparams_list, params_list, ret, capval_present(ret), body_list)
}

fn parse_extern_decl(st: PState) -> CapVal {
    mut eparams_list: List<ParamEntry> = []
    mut eret: CapVal = CapVal.Nil
    let _ = st.advance()
    if st.cur().text == "fn" { let _ = st.advance() } else {
        st.report("expected fn")
    }
    let ename = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.LeftParen { let _ = st.advance() } else {
        st.report("expected (")
    }
    if st.cur().tk == Tk.Identifier {
        eparams_list.push(capval_to_pentry(st, parse_param(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            eparams_list.push(capval_to_pentry(st, parse_param(st)))
        }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected )")
    }
    if st.cur().tk == Tk.Arrow {
        let _ = st.advance()
        eret = parse_type_expr(st)
    }
    mk_extern_fn(st, capval_tok_text(ename), eparams_list, eret, capval_present(eret))
}

fn parse_trait_decl(st: PState) -> CapVal {
    mut tmembers_list: List<StmtId> = []
    let _ = st.advance()
    let trname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        let _ = parse_tparam(st)
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            let _ = parse_tparam(st)
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected >")
        }
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().text == "type" || st.cur().text == "fn" {
        tmembers_list.push(capval_to_stmt(st, parse_trait_member(st)))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_trait_decl(st, capval_tok_text(trname), tmembers_list)
}

fn parse_trait_member(st: PState) -> CapVal {
    if st.cur().text == "type" {
        return parse_assoc_member(st)
    }
    if st.cur().text == "fn" {
        return parse_method_member(st)
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_assoc_member(st: PState) -> CapVal {
    let _ = st.advance()
    let atname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    mk_assoc_type(st, capval_tok_text(atname))
}

fn parse_method_member(st: PState) -> CapVal {
    mut tmparams_list: List<ParamEntry> = []
    mut tmbody_list: List<StmtId> = []
    mut tmret: CapVal = CapVal.Nil
    mut tmlb: CapVal = CapVal.Nil
    let _ = st.advance()
    let tmname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.LeftParen { let _ = st.advance() } else {
        st.report("expected (")
    }
    if st.cur().tk == Tk.Identifier {
        tmparams_list.push(capval_to_pentry(st, parse_param(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            tmparams_list.push(capval_to_pentry(st, parse_param(st)))
        }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected )")
    }
    if st.cur().tk == Tk.Arrow {
        let _ = st.advance()
        tmret = parse_type_expr(st)
    }
    if st.cur().tk == Tk.LeftBrace {
        tmlb = CapVal.Tok(st.advance())
        while st.cur().text == "break" || st.cur().text == "continue" || st.cur().text == "if" || lookahead_ok("for_destructure", st) && (st.cur().text == "for") || st.cur().text == "for" || st.cur().text == "while" || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && (st.cur().text == "match") || st.cur().text == "match" || st.cur().text == "defer" || st.cur().text == "errdefer" || st.cur().text == "return" || lookahead_ok("stmt_block", st) && (st.cur().tk == Tk.LeftBrace) || tok_starts_expr_leaf(st.cur()) {
            tmbody_list.push(capval_to_stmt(st, parse_statement(st)))
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected }")
        }
    }
    mk_trait_method(st, capval_tok_text(tmname), tmparams_list, tmret, capval_present(tmret), capval_present(tmlb), tmbody_list)
}

fn parse_impl_decl(st: PState) -> CapVal {
    mut imethods_list: List<StmtId> = []
    mut ifortn: CapVal = CapVal.Nil
    let _ = st.advance()
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        let _ = parse_tparam(st)
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            let _ = parse_tparam(st)
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected >")
        }
    }
    let itn = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        let _ = parse_type_expr(st)
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            let _ = parse_type_expr(st)
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected >")
        }
    }
    if st.cur().text == "for" {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { ifortn = CapVal.Tok(st.advance()) } else {
            st.report("expected IDENT")
        }
        if st.cur().tk == Tk.Less {
            let _ = st.advance()
            let _ = parse_type_expr(st)
            while st.cur().tk == Tk.Comma {
                let _ = st.advance()
                let _ = parse_type_expr(st)
            }
            if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
                st.report("expected >")
            }
        }
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().text == "fn" {
        imethods_list.push(capval_to_stmt(st, parse_impl_method(st)))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_impl(st, capval_tok_text(itn), ifortn, capval_present(ifortn), imethods_list)
}

fn parse_impl_method(st: PState) -> CapVal {
    mut imparams_list: List<ParamEntry> = []
    mut imbody_list: List<StmtId> = []
    mut imret: CapVal = CapVal.Nil
    let _ = st.advance()
    let imname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report("expected IDENT")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.LeftParen { let _ = st.advance() } else {
        st.report("expected (")
    }
    if st.cur().tk == Tk.Identifier {
        imparams_list.push(capval_to_pentry(st, parse_param(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            imparams_list.push(capval_to_pentry(st, parse_param(st)))
        }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected )")
    }
    if st.cur().tk == Tk.Arrow {
        let _ = st.advance()
        imret = parse_type_expr(st)
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected {")
    }
    while st.cur().text == "break" || st.cur().text == "continue" || st.cur().text == "if" || lookahead_ok("for_destructure", st) && (st.cur().text == "for") || st.cur().text == "for" || st.cur().text == "while" || lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && (st.cur().text == "match") || st.cur().text == "match" || st.cur().text == "defer" || st.cur().text == "errdefer" || st.cur().text == "return" || lookahead_ok("stmt_block", st) && (st.cur().tk == Tk.LeftBrace) || tok_starts_expr_leaf(st.cur()) {
        imbody_list.push(capval_to_stmt(st, parse_statement(st)))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_method(st, capval_tok_text(imname), imparams_list, imret, capval_present(imret), imbody_list)
}

fn parse_statement(st: PState) -> CapVal {
    if st.cur().text == "break" {
        return parse_break_stmt(st)
    }
    if st.cur().text == "continue" {
        return parse_continue_stmt(st)
    }
    if st.cur().text == "if" {
        return parse_if_stmt(st)
    }
    if lookahead_ok("for_destructure", st) && (st.cur().text == "for") || st.cur().text == "for" {
        return parse_for_stmt(st)
    }
    if st.cur().text == "while" {
        return parse_while_stmt(st)
    }
    if lookahead_ok("match_subjectless", st) && (st.cur().text == "match") || lookahead_ok("match_table", st) && (st.cur().text == "match") || st.cur().text == "match" {
        return parse_match_stmt(st)
    }
    if st.cur().text == "defer" {
        return parse_defer_stmt(st)
    }
    if st.cur().text == "errdefer" {
        return parse_errdefer_stmt(st)
    }
    if st.cur().text == "return" {
        return parse_return_stmt(st)
    }
    if lookahead_ok("stmt_block", st) && (st.cur().tk == Tk.LeftBrace) {
        return parse_stmt_block(st)
    }
    parse_expr_stmt(st)
}

fn parse_block(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut stmts_list: List<StmtId> = []
    let _ = st.advance()
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.at_end() || st.cur().text == "}" { break }
        let __sp = st.cur().pos
        st.clear_error()
        let __cv = parse_statement(st)
        if st.had_error {
            __any_err = true
            st.synchronize_stmt()
            if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
            let __elc = st.store.lines.to_linecol(__sp)
            let __e = st.store.stmts.add_leaf(Stmt.Error)
            st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
            stmts_list.push(__e)
            st.clear_error()
            continue
        }
        let __sid = capval_to_stmt(st, __cv)
        let __lc = st.store.lines.to_linecol(__sp)
        st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
        stmts_list.push(__sid)
    }
    if __any_err { st.note_had_error() }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_block(st, sp_start, stmts_list)
}

fn parse_stmt_block(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut stmts_list: List<StmtId> = []
    let _ = st.advance()
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.at_end() || st.cur().text == "}" { break }
        let __sp = st.cur().pos
        st.clear_error()
        let __cv = parse_declaration(st)
        if st.had_error {
            __any_err = true
            st.synchronize_stmt()
            if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
            let __elc = st.store.lines.to_linecol(__sp)
            let __e = st.store.stmts.add_leaf(Stmt.Error)
            st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
            stmts_list.push(__e)
            st.clear_error()
            continue
        }
        let __sid = capval_to_stmt(st, __cv)
        let __lc = st.store.lines.to_linecol(__sp)
        st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
        stmts_list.push(__sid)
    }
    if __any_err { st.note_had_error() }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_block(st, sp_start, stmts_list)
}

fn parse_break_stmt(st: PState) -> CapVal {
    let _ = st.advance()
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Break))
}

fn parse_continue_stmt(st: PState) -> CapVal {
    let _ = st.advance()
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Continue))
}

fn parse_if_stmt(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut e: CapVal = CapVal.Nil
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let c = parse_expression(st)
    st.set_modes(__modes_1)
    let t = parse_block(st)
    if st.cur().text == "else" {
        let _ = st.advance()
        e = parse_statement(st)
    }
    mk_if(st, sp_start, c, t, e)
}

fn parse_for_binding(st: PState) -> CapVal {
    mut names_list: List<Token> = []
    let lp = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Identifier {
        names_list.push(st.advance())
        while lookahead_ok("comma_ident", st) && (st.cur().tk == Tk.Comma) {
            let _ = st.advance()
            if st.cur().tk == Tk.Identifier { names_list.push(st.advance()) } else {
                st.report("expected IDENT")
            }
        }
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected )")
    }
    mk_for_binding(lp, CapVal.Toks(names_list))
}

fn parse_while_stmt(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let c = parse_expression(st)
    st.set_modes(__modes_1)
    let body = parse_block(st)
    mk_while(st, sp_start, c, body)
}

fn parse_match_stmt(st: PState) -> CapVal {
    if lookahead_ok("match_subjectless", st) && (st.cur().text == "match") {
        let sp_start = st.cur().pos
        mut a_list: List<WhenArm> = []
        let _ = st.advance()
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected {")
        }
        while st.cur().text == "_" || tok_starts_expr_leaf(st.cur()) {
            a_list.push(capval_to_when_arm(st, parse_match_when_arm(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after match arms")
            return CapVal.Node(st.error_node_silent())
        }
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, mk_when(st, sp_start, CapVal.WArms(a_list))))))
    }
    if lookahead_ok("match_table", st) && (st.cur().text == "match") {
        return parse_match_table_stmt(st)
    }
    if st.cur().text == "match" {
        mut arms_list: List<MatchArm> = []
        let _ = st.advance()
        let __modes_1 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let subj = parse_expression(st)
        st.set_modes(__modes_1)
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected `{` after match subject")
            return CapVal.Node(st.error_node_silent())
        }
        while tok_starts_pattern(st.cur()) {
            arms_list.push(capval_to_arm(st, parse_match_arm(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after match arms")
            return CapVal.Node(st.error_node_silent())
        }
        return mk_match(st, subj, CapVal.Arms(arms_list))
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_defer_stmt(st: PState) -> CapVal {
    let _ = st.advance()
    let e = parse_expression(st)
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Defer(capval_to_expr(st, e))))
}

fn parse_errdefer_stmt(st: PState) -> CapVal {
    let _ = st.advance()
    let e = parse_expression(st)
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Errdefer(capval_to_expr(st, e))))
}

fn parse_return_stmt(st: PState) -> CapVal {
    mut e: CapVal = CapVal.Nil
    let _ = st.advance()
    if (tok_starts_expr_leaf(st.cur())) && (st.pos == 0 || st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line == st.store.lines.to_linecol(st.cur().pos).line) {
        e = parse_expression(st)
    }
    mk_return_opt(st, e)
}

fn parse_expr_stmt(st: PState) -> CapVal {
    let e = parse_expression(st)
    if st.had_error { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error)) } else { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, e)))) }
}

fn parse_for_stmt(st: PState) -> CapVal {
    if lookahead_ok("for_destructure", st) && (st.cur().text == "for") {
        let sp_start = st.cur().pos
        let _ = st.advance()
        let fb = parse_for_binding(st)
        if st.cur().text == "in" { let _ = st.advance() } else {
            st.report("expected `in` after for destructure pattern")
            return CapVal.Node(st.error_node_silent())
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let coll = parse_expression(st)
        st.set_modes(__modes_3)
        let body = parse_block(st)
        return mk_for_destructure(st, sp_start, fb, coll, body)
    }
    if st.cur().text == "for" {
        let sp_start = st.cur().pos
        mut hi: CapVal = CapVal.Nil
        let _ = st.advance()
        let v = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report("expected IDENT")
            CapVal.Tok(st.cur())
        }
        if st.cur().text == "in" { let _ = st.advance() } else {
            st.report("expected `in` after loop variable")
            return CapVal.Node(st.error_node_silent())
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let lo = parse_expression(st)
        st.set_modes(__modes_3)
        let __modes_4 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        if st.cur().tk == Tk.DotDot {
            let _ = st.advance()
            hi = parse_expression(st)
        }
        st.set_modes(__modes_4)
        let body = parse_block(st)
        return mk_for_loop(st, sp_start, v, lo, hi, body)
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_match_when_arm(st: PState) -> CapVal {
    if st.cur().text == "_" {
        let _ = st.advance()
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected ->")
        }
        let __modes_2 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
        let b = parse_expression(st)
        st.set_modes(__modes_2)
        return mk_when_default(st, b)
    }
    if tok_starts_expr_leaf(st.cur()) {
        let c = parse_expression(st)
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected ->")
        }
        let __modes_2 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
        let b = parse_expression(st)
        st.set_modes(__modes_2)
        return mk_when_arm(st, c, b)
    }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_match_arm(st: PState) -> CapVal {
    mut g: CapVal = CapVal.Nil
    let p = parse_pattern_or(st)
    if st.cur().text == "if" {
        let _ = st.advance()
        g = parse_expression(st)
    }
    if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
        st.report("expected ->")
    }
    let __modes_3 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
    let b = parse_expression(st)
    st.set_modes(__modes_3)
    mk_arm(st, p, g, b)
}

fn parse_match_table_stmt(st: PState) -> CapVal {
    mut cols_list: List<Token> = []
    mut p_list: List<PatId> = []
    mut v_list: List<ExprId> = []
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let subj = parse_expression(st)
    st.set_modes(__modes_1)
    if st.cur().text == "table" { let _ = st.advance() } else {
        st.report("expected table")
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after match table")
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.Identifier { let _ = st.advance() } else {
        st.report("expected IDENT")
    }
    while st.cur().tk == Tk.Pipe {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { cols_list.push(st.advance()) } else {
            st.report("expected IDENT")
        }
    }
    while tok_starts_pattern(st.cur()) {
        p_list.push(capval_to_pat(st, parse_pattern(st)))
        if st.cur().tk == Tk.Pipe {
            let _ = st.advance()
        }
        mut __bnd_2 = 0
        while tok_starts_expr_leaf(st.cur()) {
            if __bnd_2 >= cols_list.length { break }
            v_list.push(capval_to_expr(st, parse_table_cell(st)))
            if st.cur().tk == Tk.Pipe {
                let _ = st.advance()
            }
            __bnd_2 = __bnd_2 + 1
        }
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` after match table")
        return CapVal.Node(st.error_node_silent())
    }
    mk_match_table(st, subj, CapVal.Toks(cols_list), CapVal.PNodes(p_list), CapVal.Nodes(v_list))
}

fn parse_match_table_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut cols_list: List<Token> = []
    mut p_list: List<PatId> = []
    mut v_list: List<ExprId> = []
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let subj = parse_expression(st)
    st.set_modes(__modes_1)
    if st.cur().text == "table" { let _ = st.advance() } else {
        st.report("expected table")
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after match table")
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.Identifier { let _ = st.advance() } else {
        st.report("expected IDENT")
    }
    while st.cur().tk == Tk.Pipe {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { cols_list.push(st.advance()) } else {
            st.report("expected IDENT")
        }
    }
    while tok_starts_pattern(st.cur()) {
        p_list.push(capval_to_pat(st, parse_pattern(st)))
        if st.cur().tk == Tk.Pipe {
            let _ = st.advance()
        }
        mut __bnd_2 = 0
        while tok_starts_expr_leaf(st.cur()) {
            if __bnd_2 >= cols_list.length { break }
            v_list.push(capval_to_expr(st, parse_table_cell(st)))
            if st.cur().tk == Tk.Pipe {
                let _ = st.advance()
            }
            __bnd_2 = __bnd_2 + 1
        }
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` after match table")
        return CapVal.Node(st.error_node_silent())
    }
    mk_match_table_expr(st, sp_start, subj, CapVal.Toks(cols_list), CapVal.PNodes(p_list), CapVal.Nodes(v_list))
}

