// generated recursive-descent parser for grammar `grammar`
export fn parse_declaration(st: PState) -> CapVal {
    if st.cur().kind == "IDENT" || st.cur().kind == "DOC" || st.cur().kind == "MODDOC" || st.cur().text == "@" || st.cur().text == "export" || st.cur().text == "fn" || st.cur().text == "type" || st.cur().text == "enum" || st.cur().text == "trait" || st.cur().text == "impl" || st.cur().text == "use" || st.cur().text == "mod" || st.cur().text == "const" || st.cur().text == "let" || st.cur().text == "mut" || st.cur().text == "extern" || st.cur().text == "shape" || st.cur().text == "spec" || st.cur().text == "parallel" || st.cur().text == "select" || st.cur().text == "component" {
        return CapVal.SNode(run_hand_stmt("decl_hand", st))
    }
    parse_statement(st)
}

fn parse_statement(st: PState) -> CapVal {
    if st.cur().text == "break" {
        return parse_break_stmt(st)
    }
    if st.cur().text == "continue" {
        return parse_continue_stmt(st)
    }
    if st.cur().text == "if" {
        return parse_if_stmt(st)
    }
    if st.cur().text == "for" {
        return parse_for_stmt(st)
    }
    if st.cur().text == "while" {
        return parse_while_stmt(st)
    }
    if st.cur().text == "{" || st.cur().text == "if" || st.cur().text == "while" || st.cur().text == "match" || st.cur().text == "defer" || st.cur().text == "errdefer" || st.cur().text == "return" {
        return CapVal.SNode(run_hand_stmt("stmt_hand", st))
    }
    parse_expr_stmt(st)
}

fn parse_block(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut stmts_list: List<StmtId> = []
    let _ = st.advance()
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.at_end() || st.cur().text == "}" { break }
        let __sp = st.cur().pos
        st.clear_error()
        let __cv = parse_statement(st)
        if st.had_error {
            __any_err = true
            st.synchronize_stmt()
            if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
            let __elc = st.store.lines.to_linecol(__sp)
            let __e = st.store.stmts.add_leaf(Stmt.Error)
            st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
            stmts_list.push(__e)
            st.clear_error()
            continue
        }
        let __sid = capval_to_stmt(st, __cv)
        let __lc = st.store.lines.to_linecol(__sp)
        st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
        stmts_list.push(__sid)
    }
    if __any_err { st.note_had_error() }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected }")
    }
    mk_block(st, sp_start, stmts_list)
}

fn parse_break_stmt(st: PState) -> CapVal {
    let _ = st.advance()
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Break))
}

fn parse_continue_stmt(st: PState) -> CapVal {
    let _ = st.advance()
    CapVal.SNode(st.store.stmts.add_leaf(Stmt.Continue))
}

fn parse_if_stmt(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut e: CapVal = CapVal.Nil
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let c = parse_expression(st)
    st.set_modes(__modes_1)
    let t = parse_block(st)
    if st.cur().text == "else" {
        let _ = st.advance()
        e = CapVal.SNode(run_hand_stmt("stmt_hand", st))
    }
    mk_if(st, sp_start, c, t, e)
}

fn parse_for_stmt(st: PState) -> CapVal {
    mut tried_spec = false
    if st.cur().text == "for" {
        tried_spec = true
        let s_pos = st.pos
        let s_mark = st.store.mark()
        let s_diags = st.diags.length
        let s_err = st.had_error
        let s_hand = st.save_hand_state()
        let sp_start = st.cur().pos
        mut hi: CapVal = CapVal.Nil
        let _ = st.advance()
        let v = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report("expected IDENT")
            CapVal.Tok(st.cur())
        }
        if st.cur().text == "in" { let _ = st.advance() } else {
            st.report("expected in")
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let lo = parse_expression(st)
        st.set_modes(__modes_3)
        let __modes_4 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        if st.cur().tk == Tk.DotDot {
            let _ = st.advance()
            hi = parse_expression(st)
        }
        st.set_modes(__modes_4)
        let body = parse_block(st)
        if st.diags.length == s_diags && st.had_error == s_err {
            return mk_for_loop(st, sp_start, v, lo, hi, body)
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.restore_hand_state(s_hand)
    }
    if st.cur().text == "for" {
        return CapVal.SNode(run_hand_stmt("for_stmt_edge", st))
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node("expected an expression"))
}

fn parse_while_stmt(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let c = parse_expression(st)
    st.set_modes(__modes_1)
    let body = parse_block(st)
    mk_while(st, sp_start, c, body)
}

fn parse_expr_stmt(st: PState) -> CapVal {
    let e = parse_expression(st)
    if st.had_error { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error)) } else { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, e)))) }
}

