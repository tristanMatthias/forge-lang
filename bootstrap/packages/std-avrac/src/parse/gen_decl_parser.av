fn parse_iflet_stmt(st: PState) -> CapVal {
    mut e: CapVal = CapVal.Nil
    let _ = st.advance()
    let tmp = CapVal.Tok(gensym_token(st, "iflet"))
    if st.cur().text == "let" { let _ = st.advance() } else {
