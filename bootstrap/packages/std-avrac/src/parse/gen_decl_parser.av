                return CapVal.Node(st.error_node_silent())
                }
            }
            if st.cur().tk == Tk.Arrow {
                let _ = st.advance()
                if !((st.modes.quote_depth > 0 && st.cur().tk == Tk.Tilde || tok_starts_type(st.cur()))) {
                    st.report("expected return type after `->`")
