    }
    parse_declaration(st)
}

fn parse_comp_field(st: PState) -> CapVal {
    mut init: CapVal = CapVal.Nil
    let _ = st.advance()
    let f = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected field name")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
        st.report("expected `:` after field name")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if !((st.modes.quote_depth > 0 && st.cur().tk == Tk.Tilde || tok_starts_type(st.cur()))) {
        st.report("expected field type")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    st.set_abort_prop(false)
    let __rres3 = parse_type_expr(st)
    if st.abort_prop || capval_is_error_expr(st, __rres3) || capval_is_error_stmt(st, __rres3) {
        return CapVal.Node(st.error_node_silent())
    }
    let ty = __rres3
    if st.cur().tk == Tk.Equal {
        let _ = st.advance()
        init = parse_expression(st)
    }
    mk_comp_field_g(st, capval_tok_text(f), ty, init, capval_present(init))
}

fn parse_body_item(st: PState) -> CapVal {
