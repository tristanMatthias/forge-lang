fn parse_for_binding(st: PState) -> CapVal {
    mut names_list: List<Token> = []
    let lp = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Identifier {
        names_list.push(st.advance())
        while lookahead_ok("comma_ident", st) && (st.cur().tk == Tk.Comma) {
            let _ = st.advance()
            if st.cur().tk == Tk.Identifier { names_list.push(st.advance()) } else {
                st.report_ident("expected `IDENT`")
            }
        }
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected `)`")
    }
    mk_for_binding(lp, CapVal.Toks(names_list))
}

