fn parse_impl_member(st: PState) -> CapVal {
    if st.cur().tk == Tk.DocComment {
        mut d_list: List<Token> = []
        d_list.push(st.advance())
        while st.cur().tk == Tk.DocComment {
            d_list.push(st.advance())
        }
        let im = parse_impl_method(st)
        return mk_doc_annotated(st, d_list, im)
    }
    if st.cur().text == "type" {
        return parse_impl_assoc(st)
    }
    if st.cur().text == "fn" {
        return parse_impl_method(st)
    }
    CapVal.Node(st.error_node_expected_expr())
}

