    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_match_arm(st: PState) -> CapVal {
    if st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) {
        let _ = st.advance()
        let t = parse_unary(st)
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
        return mk_splice_arm(st, t)
    }
    if tok_starts_pattern(st.cur()) {
        mut g: CapVal = CapVal.Nil
        let p = parse_pattern_or(st)
        if st.cur().text == "if" {
            let _ = st.advance()
            g = parse_expression(st)
        }
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected `->`")
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
        let b = parse_arm_body(st)
        st.set_modes(__modes_3)
        return mk_arm(st, p, g, b)
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_arm_body(st: PState) -> CapVal {
    if st.cur().text == "return" {
        let sp_start = st.cur().pos
        mut e: CapVal = CapVal.Nil
        let _ = st.advance()
        if (tok_starts_expr_leaf(st.cur())) && (st.pos == 0 || st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line == st.store.lines.to_linecol(st.cur().pos).line) {
            e = parse_expression(st)
        }
        return mk_arm_return(st, sp_start, e)
    }
    parse_expression(st)
}

fn parse_match_table_stmt(st: PState) -> CapVal {
    mut cols_list: List<Token> = []
    mut p_list: List<PatId> = []
    mut v_list: List<ExprId> = []
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let subj = parse_expression(st)
    st.set_modes(__modes_1)
    if st.cur().text == "table" { let _ = st.advance() } else {
        st.report("expected `table`")
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after match table")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.Identifier { let _ = st.advance() } else {
        st.report_ident("expected `IDENT`")
    }
    while st.cur().tk == Tk.Pipe {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { cols_list.push(st.advance()) } else {
            st.report_ident("expected `IDENT`")
        }
    }
    while tok_starts_pattern(st.cur()) {
        p_list.push(capval_to_pat(st, parse_pattern(st)))
        if st.cur().tk == Tk.Pipe {
            let _ = st.advance()
        }
        mut __bnd_2 = 0
        while tok_starts_expr_leaf(st.cur()) {
            if __bnd_2 >= cols_list.length { break }
            v_list.push(capval_to_expr(st, parse_table_cell(st)))
            if st.cur().tk == Tk.Pipe {
                let _ = st.advance()
            }
            __bnd_2 = __bnd_2 + 1
        }
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` after match table")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    mk_match_table(st, subj, CapVal.Toks(cols_list), CapVal.PNodes(p_list), CapVal.Nodes(v_list))
}

fn parse_match_table_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut cols_list: List<Token> = []
    mut p_list: List<PatId> = []
    mut v_list: List<ExprId> = []
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let subj = parse_expression(st)
    st.set_modes(__modes_1)
    if st.cur().text == "table" { let _ = st.advance() } else {
        st.report("expected `table`")
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after match table")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.Identifier { let _ = st.advance() } else {
        st.report_ident("expected `IDENT`")
    }
    while st.cur().tk == Tk.Pipe {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { cols_list.push(st.advance()) } else {
            st.report_ident("expected `IDENT`")
        }
    }
    while tok_starts_pattern(st.cur()) {
        p_list.push(capval_to_pat(st, parse_pattern(st)))
        if st.cur().tk == Tk.Pipe {
            let _ = st.advance()
        }
        mut __bnd_2 = 0
        while tok_starts_expr_leaf(st.cur()) {
            if __bnd_2 >= cols_list.length { break }
            v_list.push(capval_to_expr(st, parse_table_cell(st)))
            if st.cur().tk == Tk.Pipe {
                let _ = st.advance()
            }
            __bnd_2 = __bnd_2 + 1
        }
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` after match table")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    mk_match_table_expr(st, sp_start, subj, CapVal.Toks(cols_list), CapVal.PNodes(p_list), CapVal.Nodes(v_list))
}

