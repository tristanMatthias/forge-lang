// WHY: recursive-descent parser with integrated lexer. Scans source
// text one token at a time and builds an AST. Precedence is encoded
// in the call chain: assignment → pipe → null_coalesce → or → and →
// equality → comparison → term → factor → unary → call → primary.
// Feature-specific parsers extend Parser via cross-file impl blocks.
//
// NEVER add feature-specific parsing to this file. New syntax belongs
// in features/<name>/parser.av as an impl Parser block. This file is
// infrastructure only: the expression precedence chain, statement
// dispatch, and token consumption helpers.

// dir-as-module (g2eo.1): lexer.av auto-loads as a sibling, surfaces
// flat at `parse.{...}`.
use core.{Expr, Stmt, ParamEntry, Pattern, MatchArm, WhenArm, BinOp, UnOp, LogicOp, SExpr, SStmt, sexpr, sexpr_at, sexpr_dummy, sstmt, sstmt_at, Annotation, Tk, tk_keyword_str, TypeExpr}
use core.{Registry, build_registry, lookup_decl_parser, lookup_stmt_parser}
use features.closures.{expr_contains_it, wrap_in_it_lambda}
use diagnostics.{Span, DiagCode, Diagnostic, DiagnosticBag, bag_new, bag_report, diag_error, diag_with_help, span_new}

/// Output of `parse_expression_source`. `expr` is null on parse
/// failure; consult `had_error` / `error_message` for the cause.
/// `bag` mirrors ProgramParseResult — it carries every F-code
/// diagnostic the parser emitted (lexer + grammar errors) so the
/// CLI can render structured source-frame output rather than just
/// the one-line `error_message`. Empty for clean parses.
export type ParseResult = {
    expr: Expr?,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
}

/// Output of `parse_program_source`. Same shape as ParseResult but
/// carries a `List<SStmt>` plus the full DiagnosticBag so later passes
/// can render multi-error messages.
export type ProgramParseResult = {
    stmts: List<SStmt>?,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
}

/// Saved parser state used by speculative parses (e.g. generic call
/// disambiguation). Pair with `parser.save_state` /
/// `parser.restore_state` to back out of an attempted parse.
export type ParserState = {
    start: int,
    current: int,
    line: int,
    column: int,
    current_kind: Tk,
    current_lexeme: string,
    current_line: int,
    current_column: int,
    current_start: int,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
}

/// Mutable parser state. Tracks lexer position, the currently-staged
/// token, error state, the diagnostic bag, and a few mode flags
/// that gate context-sensitive parses.
/// @field source             — the entire program text.
/// @field start / current    — lexer byte offsets (start = current
///                              token's first byte).
/// @field line / column      — lexer's source position.
/// @field current_kind       — Tk discriminant of the staged token.
/// @field current_lexeme     — the staged token's source text.
/// @field current_line/col   — span coordinates of the staged token.
/// @field prev_line          — line of the previously-consumed token;
///                              used to gate same-line postfix attach.
/// @field had_error          — sticky failure flag.
/// @field error_message      — first error's message (legacy).
/// @field allow_struct_lit   — when 0, `Ident { ... }` parses as
///                              Ident-then-block (inside `if` / `while`
///                              conditions); when 1, it's a struct
///                              literal.
/// @field allow_dot_postfix  — when 0, `.` doesn't attach as postfix
///                              (inside match-arm bodies, so the next
///                              `.Variant` arm isn't gobbled).
/// @field allow_it_sugar     — when 1, `it` inside an arg list wraps
///                              the expr in an implicit lambda. Set
///                              by method calls, not regular calls.
/// @field current_start      — byte offset of the staged token's start.
/// @field bag                — accumulated diagnostics.
/// @field features           — feature registry for parser dispatch.
export type Parser = {
    source: string,
    file: string,
    mut start: int,
    mut current: int,
    mut line: int,
    mut column: int,
    mut current_kind: Tk,
    mut current_lexeme: string,
    mut current_line: int,
    mut current_column: int,
    mut prev_line: int,
    mut had_error: int,
    mut error_message: string,
    // When false, `Ident { ... }` is parsed as Ident followed by a
    // separate block (used inside `if`/`while` conditions to avoid
    // grabbing the loop body brace as a struct literal). When true,
    // `Ident { ... }` becomes a struct literal expression.
    mut allow_struct_lit: int,
    // When false, parse_call's loop won't consume `.` as a postfix.
    // Disabled inside match-arm bodies so the next sibling pattern
    // (e.g. `.Variant(x)`) isn't gobbled into the previous body.
    mut allow_dot_postfix: int,
    // When true, expressions containing `it` in arg lists are wrapped
    // in implicit lambdas. Set by method call parsing (.map, etc.),
    // NOT by regular function calls (prevents double-wrapping).
    mut allow_it_sugar: int,
    // Counts open `quote { ... }` bodies the parser is currently
    // inside. When > 0, a leading `~` parses as Expr.Splice instead
    // of Expr.Unary(BitNot, ...). The same `~` token is overloaded
    // by context — outside a quote, it stays the bitwise-NOT prefix.
    mut quote_depth: int,
    mut current_start: int,   // byte offset where current token started
    mut bag: DiagnosticBag,
    features: Registry,
}

/// Parse a single expression. Used by `bs2 expr` for AST inspection
/// and by the eval interpreter's REPL-style entry.
export fn parse_expression_source(source: string) -> ParseResult {
    mut parser = parser_new(source)
    parser.parse_file_expression()
}

/// Parse a whole program (a sequence of declarations + statements).
/// Top-level entry consumed by every CLI subcommand that ingests
/// source.
export fn parse_program_source(source: string) -> ProgramParseResult {
    parse_program_source_at(source, "")
}

/// Parse a whole program with explicit file attribution. Used by
/// the test runner so each test's parsed AST nodes know which file
/// they came from — diagnostics in the bundled program can then
/// cite the originating *_test.av rather than a `<test>` placeholder.
export fn parse_program_source_at(source: string, file: string) -> ProgramParseResult {
    mut parser = parser_new_with_file(source, file)
    parser.parse_file_program()
}

/// Interleave header names and values into a flat alternating list:
/// `[k1, k2]` + `[v1, v2]` → `[k1, v1, k2, v2]`. MapLit expects this
/// flat shape; table-literal parsing produces it.
export fn table_zip_entries(headers: List<SExpr>, values: List<SExpr>) -> List<SExpr> {
    mut out: List<SExpr> = []
    let n = if headers.length < values.length { headers.length } else { values.length }
    mut i = 0
    while i < n {
        out.push(headers[i])
        out.push(values[i])
        i = i + 1
    }
    out
}

/// True iff `e` is a bare or qualified identifier — used to gate
/// promotions like Ident-to-call or Ident-to-pattern.
fn expr_is_ident(e: Expr) -> bool {
    match e {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        _ -> false
    }
}

/// True iff `e` is an identifier whose first letter is uppercase —
/// the syntactic marker the resolver uses to distinguish a type ref
/// from a value ref.
fn expr_is_upper_ident(e: Expr) -> bool {
    match e {
        .Ident(n) -> p_starts_with_upper(n)
        .QualifiedIdent(n) -> p_starts_with_upper(n)
        _ -> false
    }
}

/// Convert a list of Ident expressions into a `List<ParamEntry>` (for lambda
/// parsing). `(x, y) -> ...` parses the parens as expressions first,
/// then reinterprets the Ident names as parameter names once `->`
/// is seen.
fn exprs_to_params(exprs: List<SExpr>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < exprs.length {
        let se = exprs[i]
        let name = match se.node {
            .Ident(n) -> n
            .QualifiedIdent(n) -> n
            _ -> "_"
        }
        out.push(ParamEntry { name: name, vtype: ValueType.Unknown })
        i = i + 1
    }
    out
}

/// True iff `expr` is something that could syntactically be the
/// callee of `expr(args)` — bare ident, qualified ident, or a field
/// access (method call). Used by the postfix-call gate.
fn is_callable(expr: Expr) -> bool {
    match expr {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        .FieldAccess(_, _) -> true
        _ -> false
    }
}

/// True iff `name` starts with an uppercase ASCII letter — Avra's
/// type / variant naming convention.
fn p_starts_with_upper(name: string) -> bool {
    if name.length < 1 {
        return false
    }
    let head = name.substring(0, 1)
    head in "A".."Z"
}

/// True iff `s` is a simple identifier (alpha first, then alnum or
/// underscores). Simple idents inside `${...}` don't need a sub-
/// parser — they lower directly to `Expr.Ident`.
fn template_is_simple_ident(s: string) -> bool {
    if s.length == 0 { return false }
    // First char must be alpha (not digit) to be an identifier
    if !p_is_alpha(s[0]) { return false }
    mut i = 1
    while i < s.length {
        let ch = s[i]
        if !p_is_alpha_numeric(ch) {
            return false
        }
        i = i + 1
    }
    true
}

/// Output of `template_split_format`: the expression text and its
/// optional `:format-spec` suffix (empty when no spec).
type FormatSplit = { expr: string, fmt: string }

/// Split a template interpolation body `"${expr:fmt}"` at the last
/// colon at brace/paren depth 0. Returns the parts so the lowerer
/// can route them to the right runtime call. When no valid format
/// spec is found, the whole input is treated as the expression.
fn template_split_format(s: string) -> FormatSplit {
    mut last_colon = -1
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s[i]
        if ch in ["(", "[", "{"] { depth = depth + 1 }
        if ch in [")", "]", "}"] { depth = depth - 1 }
        if ch == ":" && depth == 0 {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon < 0 {
        return FormatSplit { expr: s, fmt: "" }
    }
    // Validate that what's after the colon looks like a format spec
    // (starts with . or digit or a format char).
    let fspec = s.substring(last_colon + 1, s.length)
    if fspec.length == 0 {
        return FormatSplit { expr: s, fmt: "" }
    }
    let first = fspec[0]
    if first == "." || p_is_digit(first) || first in ["d", "x", "X", "o", "f", "e", "E", "g", "G"] {
        FormatSplit { expr: s.substring(0, last_colon), fmt: fspec }
    } else {
        FormatSplit { expr: s, fmt: "" }
    }
}

/// Parse a sub-expression from a string. Used by template
/// desugaring — creates its own parser instance so the parent's
/// state isn't disturbed by the inner walk.
fn parse_template_expr(source: string) -> Expr? {
    mut p = parser_new(source)
    p.parse_expression()
}

/// Map a source identifier to its keyword Tk variant. Returns
/// `Tk.Identifier` when `text` isn't a reserved word. Reserved-but-
/// inactive keywords (`async`, `await`, `bare`, ...) map to
/// `Tk.KwReserved` — the lexer rejects them at the use site so we
/// reserve the name space without committing to semantics.
export fn p_keyword_kind(text: string) -> Tk {
    match text {
        "and"      -> Tk.KwAnd
        "catch"    -> Tk.KwCatch
        "const"    -> Tk.KwConst
        "else"     -> Tk.KwElse
        "errdefer" -> Tk.KwErrdefer
        "false"    -> Tk.KwFalse
        "fn"       -> Tk.KwFn
        "if"       -> Tk.KwIf
        "let"      -> Tk.KwLet
        "mut"      -> Tk.KwMut
        "not"      -> Tk.KwNot
        "null"     -> Tk.KwNull
        "or"       -> Tk.KwOr
        "return"   -> Tk.KwReturn
        "true"     -> Tk.KwTrue
        "for"      -> Tk.KwFor
        "in"       -> Tk.KwIn
        "where"    -> Tk.KwWhere
        "while"    -> Tk.KwWhile
        "type"     -> Tk.KwType
        "enum"     -> Tk.KwEnum
        "match"    -> Tk.KwMatch
        "export"   -> Tk.KwExport
        "use"      -> Tk.KwUse
        "mod"      -> Tk.KwMod
        "impl"     -> Tk.KwImpl
        "extern"   -> Tk.KwExtern
        "break"    -> Tk.KwBreak
        "continue" -> Tk.KwContinue
        "defer"    -> Tk.KwDefer
        "dyn"      -> Tk.KwDyn
        "trait"    -> Tk.KwTrait
        "with"     -> Tk.KwWith
        "when"     -> Tk.KwWhen
        "is"       -> Tk.KwIs
        "spec"     -> Tk.KwSpec
        "given"    -> Tk.KwGiven
        "then"     -> Tk.KwThen
        "select"   -> Tk.KwSelect
        "shape"    -> Tk.KwShape
        "component" -> Tk.KwComponent
        "parallel" -> Tk.KwParallel
        "spawn"    -> Tk.KwSpawn
        "isolated" -> Tk.KwIsolated
        "quote"    -> Tk.KwQuote
        // Reserved future keywords
        "async"    -> Tk.KwReserved
        "await"    -> Tk.KwReserved
        "yield"    -> Tk.KwReserved
        "move"     -> Tk.KwReserved
        "ref"      -> Tk.KwReserved
        "unsafe"   -> Tk.KwReserved
        "macro"    -> Tk.KwReserved
        "systems"  -> Tk.KwReserved
        "bare"     -> Tk.KwReserved
        "hardware" -> Tk.KwReserved
        "owned"    -> Tk.KwReserved
        "borrow"   -> Tk.KwReserved
        _          -> Tk.Identifier
    }
}

/// Construct a Parser positioned on the first token of `source`.
/// All mode flags default to permissive; feature parsers may flip
/// them transiently for context-sensitive parses.
export fn parser_new(source: string) -> Parser {
    parser_new_with_file(source, "")
}

/// Construct a Parser with explicit source-file attribution. Stamps
/// every SStmt/SExpr emitted by this parser with `file` so downstream
/// diagnostics can cite the originating file even after bundling.
export fn parser_new_with_file(source: string, file: string) -> Parser {
    mut parser = Parser {
        source,
        file,
        start: 0,
        current: 0,
        line: 1,
        column: 1,
        current_kind: Tk.Eof,
        current_lexeme: "",
        current_line: 1,
        prev_line: 1,
        current_column: 1,
        had_error: false,
        error_message: "",
        allow_struct_lit: true,
        allow_dot_postfix: true,
        allow_it_sugar: false,
        quote_depth: 0,
        current_start: 0,
        bag: bag_new(),
        features: build_registry(),
    }
    parser.advance_token()
    parser
}

impl Parser {
    fn parse_file_expression(self) -> ParseResult {
        let expr = self.parse_expression()
        if expr == null {
            return ParseResult {
                expr: null,
                had_error: self.had_error,
                error_message: self.error_message,
                bag: self.bag,
            }
        }

        if !self.check(Tk.Eof) {
            self.set_error("expected end of input")
            return ParseResult {
                expr: null,
                had_error: true,
                error_message: self.error_message,
                bag: self.bag,
            }
        }

        ParseResult {
            expr,
            had_error: self.had_error,
            error_message: self.error_message,
            bag: self.bag,
        }
    }

    fn parse_file_program(self) -> ProgramParseResult {
        let stmts = self.parse_statement_list(false)
        if stmts == null {
            return ProgramParseResult {
                stmts: null,
                had_error: self.had_error,
                error_message: self.error_message,
                bag: self.bag,
            }
        }

        if !self.check(Tk.Eof) {
            self.set_error("expected end of input")
            return ProgramParseResult {
                stmts: null,
                had_error: true,
                error_message: self.error_message,
                bag: self.bag,
            }
        }

        ProgramParseResult {
            stmts,
            had_error: self.had_error,
            error_message: self.error_message,
            bag: self.bag,
        }
    }

    fn parse_statement_list(self, stop_at_right_brace: int) -> List<SStmt>? {
        mut out: List<SStmt> = []
        while true {
            if stop_at_right_brace && self.check(Tk.RightBrace) { return out }
            if self.check(Tk.Eof) { return out }
            if !stop_at_right_brace && self.check(Tk.RightBrace) {
                self.report(DiagCode.MismatchedBrace, "unexpected `}`")
                self.advance()
                continue
            }
            let stmt_line = self.current_line
            let stmt_col = self.current_column
            let stmt = self.parse_declaration()
            if stmt == null {
                self.synchronize()
                continue
            }
            out.push(sstmt_at(stmt!, stmt_line, stmt_col, self.file))
        }
        out
    }

    fn parse_declaration(self) -> Stmt? {
        // Reserved future keywords produce an error immediately.
        if self.check(Tk.KwReserved) {
            self.reject_reserved_keyword("yet")
            return null
        }

        // Doc comments: /// and //! become @doc annotations.
        if self.check(Tk.DocComment) {
            mut doc_text = self.current_lexeme
            self.advance()
            // Collect consecutive /// lines into one doc string
            while self.check(Tk.DocComment) {
                doc_text = doc_text + "\n" + self.current_lexeme
                self.advance()
            }
            let inner = self.parse_declaration()?
            let doc_arg: List<SExpr> = [sexpr_dummy(Expr.String("\"${doc_text}\""))]
            let doc_annots: List<Annotation> = [Annotation { name: "doc", args: doc_arg }]
            return Stmt.Annotated(doc_annots, inner)
        }
        if self.check(Tk.ModDocComment) {
            mut doc_text = self.current_lexeme
            self.advance()
            while self.check(Tk.ModDocComment) {
                doc_text = doc_text + "\n" + self.current_lexeme
                self.advance()
            }
            // Module docs don't wrap a declaration — store as a NoOp with annotation
            let doc_arg: List<SExpr> = [sexpr_dummy(Expr.String("\"${doc_text}\""))]
            let mdoc_annots: List<Annotation> = [Annotation { name: "module_doc", args: doc_arg }]
            return Stmt.Annotated(mdoc_annots, Stmt.NoOp)
        }

        // Annotations: `@name` or `@name(args)` before a declaration.
        if self.check(Tk.At) {
            let annotations = self.parse_annotations()
            let inner = self.parse_declaration()?
            return Stmt.Annotated(annotations, inner)
        }

        // `export` wraps the inner declaration in an @export annotation
        // so the module system's name resolution pass can enforce visibility.
        // Only fn, type, enum, trait, and extern are exportable — no stacking.
        if self.check(Tk.KwExport) {
            self.advance()
            let export_handler_raw = lookup_decl_parser(self.features, tk_keyword_str(self.current_kind))
            let inner_opt = if export_handler_raw != null {
                let handler: fn(Parser) -> Stmt? = export_handler_raw!
                handler(self)
            } else {
                self.set_error("expected declaration after `export`")
                null
            }
            let inner = inner_opt?
            let empty_args: List<SExpr> = []
            let exp_annots: List<Annotation> = [Annotation { name: "export", args: empty_args }]
            return Stmt.Annotated(exp_annots, inner)
        }

        let decl_raw = lookup_decl_parser(self.features, tk_keyword_str(self.current_kind))
        if decl_raw != null {
            let handler: fn(Parser) -> Stmt? = decl_raw!
            return handler(self)
        }

        // Component block instantiation: `comp_name instance_name { ... }`
        // Recognized when current identifier is a registered component name
        // AND the next non-whitespace char is an identifier start (instance name).
        // This prevents false positives like `command {` in match expressions.
        if self.check(Tk.Identifier) && self.peek_after_ident_is_ident_not_keyword() {
            let comp_raw = lookup_stmt_parser(self.features, self.current_lexeme)
            if comp_raw != null {
                let handler: fn(Parser) -> Stmt? = comp_raw!
                return handler(self)
            }
        }

        self.parse_statement()
    }

    // Parse parallel block: parallel { stmt1; stmt2 }
    // Each statement runs in its own thread, all joined at block end.

    // Parse one or more annotations: @name or @name(arg1, arg2)
    fn parse_annotations(self) -> List<Annotation> {
        mut out: List<Annotation> = []
        while self.check(Tk.At) {
            self.advance()  // consume @
            let name = self.current_lexeme
            self.advance()  // consume name
            // Optional argument list
            let args: List<SExpr> = if self.check(Tk.LeftParen) {
                self.advance()  // consume (
                let a = self.parse_arg_list()
                if self.check(Tk.RightParen) { self.advance() }
                a ?? []
            } else {
                []
            }
            out.push(Annotation { name, args })
        }
        out
    }

    // Parse table literal: table { col1 | col2\n val1 | val2\n val3 | val4 }
    // Desugars to ListLit of MapLit entries.
    fn parse_table_literal(self) -> Expr? {
        self.advance()  // consume `{`
        // Parse header row: identifiers separated by `|`
        mut headers: List<SExpr> = []
        mut header_count = 0
        let header_line = self.current_line
        while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) && self.current_line == header_line {
            if self.check(Tk.Identifier) {
                let col = self.current_lexeme
                self.advance()
                let quoted_col = "\"${col}\""
                headers.push(sexpr_at(Expr.String(quoted_col), self.current_line, self.current_column, self.file))
                header_count = header_count + 1
                if self.check(Tk.Pipe) {
                    self.advance()
                }
            } else {
                break
            }
        }
        if header_count == 0 {
            if !self.consume(Tk.RightBrace, "expected `}` to close table") { return null }
            let empty: List<SExpr> = []
            return Expr.ListLit(empty)
        }
        // headers are accumulated in source order (push); no reverse needed
        let header_names = headers
        // Parse data rows in source order
        mut rows: List<SExpr> = []
        while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) {
            mut vals: List<SExpr> = []
            mut col_idx = 0
            while col_idx < header_count {
                if self.check(Tk.RightBrace) { break }
                // Use parse_bitwise_xor which stops before `|`
                let val = self.parse_bitwise_xor()?
                vals.push(sexpr_at(val, self.current_line, self.current_column, self.file))
                col_idx = col_idx + 1
                if self.check(Tk.Pipe) {
                    self.advance()
                }
            }
            if col_idx == header_count {
                let map_entries = table_zip_entries(header_names, vals)
                let row_map = Expr.MapLit(map_entries)
                rows.push(sexpr_at(row_map, self.current_line, self.current_column, self.file))
            }
        }
        if !self.consume(Tk.RightBrace, "expected `}` to close table") {
            return null
        }
        Expr.ListLit(rows)
    }

    // Module parser (parse_module_declaration, parse_use_declaration)
    // lives in features/modules/parser.av.

    // Feature-specific parsers live in features/*/parser.av.
    // They extend Parser via `impl Parser { ... }` blocks.

    fn parse_statement(self) -> Stmt? {
        if self.check(Tk.LeftBrace) {
            self.advance()
            let body = self.parse_statement_list(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after block") {
                return null
            }
            return Stmt.Block(body)
        }

        if self.check(Tk.KwBreak) {
            self.advance()
            return Stmt.Break
        }

        if self.check(Tk.KwContinue) {
            self.advance()
            return Stmt.Continue
        }

        let stmt_raw = lookup_stmt_parser(self.features, tk_keyword_str(self.current_kind))
        if stmt_raw != null {
            let handler: fn(Parser) -> Stmt? = stmt_raw!
            return handler(self)
        }

        let expr = self.parse_expression()?
        Stmt.Expr(expr)
    }

    fn parse_expression(self) -> Expr? {
        self.parse_assignment()
    }

    fn parse_assignment(self) -> Expr? {
        let left = self.parse_pipe()?

        if !self.check(Tk.Equal) {
            return left
        }

        self.advance()
        let value = self.parse_assignment()?

        match left {
            .Ident(name) -> Expr.Assign(name, value)
            .FieldAccess(obj, field) -> Expr.FieldAssign(obj, field, value)
            _ -> {
                self.set_error("invalid assignment target")
                null
            }
        }
    }

    fn parse_pipe(self) -> Expr? {
        let left = self.parse_null_coalesce()?

        mut expr = left
        while self.check(Tk.PipeGt) {
            self.advance()
            // Enable `it` sugar in pipe RHS — `xs |> filter(it > 2)` (spec 28.7+28.8)
            let saved_it = self.allow_it_sugar
            self.allow_it_sugar = true
            let rhs = self.parse_or()?
            self.allow_it_sugar = saved_it
            let se = sexpr_at(expr, self.current_line, self.current_column, self.file)
            // Desugar: `a |> f` → `f(a)`, `a |> f(b)` → `f(a, b)`
            // If any arg is `_`, replace it with the piped value (spec Axis 28.7)
            expr = match rhs {
                .Call(callee, args) -> {
                    if pipe_args_has_placeholder(args) {
                        Expr.Call(callee, pipe_replace_placeholder(args, se))
                    } else {
                        mut prepended: List<SExpr> = [se]
                        mut i = 0
                        while i < args.length {
                            prepended.push(args[i])
                            i = i + 1
                        }
                        Expr.Call(callee, prepended)
                    }
                }
                _ -> {
                    let one: List<SExpr> = [se]
                    Expr.Call(rhs, one)
                }
            }
        }

        expr
    }

}

/// True iff the pipe RHS arg list contains an `_` placeholder.
/// `x |> f(_, 2)` uses the placeholder to position the LHS at a
/// specific arg slot; without one, the LHS becomes the first arg.
fn pipe_args_has_placeholder(args: List<SExpr>) -> bool {
    mut i = 0
    while i < args.length {
        let se = args[i]
        match se.node {
            .Ident(n) -> if n == "_" { return true }
            _ -> {}
        }
        i = i + 1
    }
    false
}

/// Replace the first `_` placeholder in `args` with the pipe's LHS
/// expression. Counterpart to `pipe_args_has_placeholder`.
fn pipe_replace_placeholder(args: List<SExpr>, replacement: SExpr) -> List<SExpr> {
    mut out: List<SExpr> = []
    mut i = 0
    while i < args.length {
        let se = args[i]
        let is_placeholder = match se.node {
            .Ident(n) -> n == "_"
            _ -> false
        }
        if is_placeholder { out.push(replacement) } else { out.push(se) }
        i = i + 1
    }
    out
}

impl Parser {
    fn parse_null_coalesce(self) -> Expr? {
        let left = self.parse_or()?

        mut expr = left
        while self.check(Tk.QuestionQuestion) {
            self.advance()
            let right = self.parse_or()?
            expr = Expr.NullCoalesce(expr, right)
        }

        expr
    }

    fn parse_or(self) -> Expr? {
        let left = self.parse_and()?

        mut expr = left
        while self.current_kind in [Tk.PipePipe, Tk.KwOr] {
            self.advance()
            let right = self.parse_and()?
            expr = Expr.Logical(expr, LogicOp.Or, right)
        }

        expr
    }

    fn parse_and(self) -> Expr? {
        let left = self.parse_equality()?

        mut expr = left
        while self.current_kind in [Tk.AmpAmp, Tk.KwAnd] {
            self.advance()
            let right = self.parse_equality()?
            expr = Expr.Logical(expr, LogicOp.And, right)
        }

        expr
    }

    fn parse_equality(self) -> Expr? {
        let left = self.parse_bitwise_or()?

        if self.check(Tk.KwIs) {
            self.advance()
            if !self.consume(Tk.Dot, "expected `.Variant` after `is`") {
                return null
            }
            let vname = self.consume_identifier("expected variant name after `is .`")?
            return Expr.IsCheck(left, vname)
        }

        if self.check(Tk.KwIn) {
            self.advance()
            if self.check(Tk.LeftBracket) {
                // List membership: x in [a, b, c]
                self.advance()
                let items: List<SExpr> = if self.check(Tk.RightBracket) {
                    []
                } else {
                    self.parse_arg_list_inner()?
                }
                if !self.consume(Tk.RightBracket, "expected `]` after `in [...]`") {
                    return null
                }
                return Expr.InCheck(left, items)
            }
            // Range membership: x in start..end → x >= start && x <= end
            let start = self.parse_bitwise_or()?
            if !self.consume(Tk.DotDot, "expected `..` in range expression after `in`") {
                return null
            }
            let end = self.parse_bitwise_or()?
            return Expr.Logical(
                Expr.Binary(left, BinOp.Ge, start),
                LogicOp.And,
                Expr.Binary(left, BinOp.Le, end)
            )
        }

        mut expr = left
        while self.current_kind in [Tk.EqualEqual, Tk.BangEqual] {
            let op = if self.check(Tk.EqualEqual) { BinOp.Eq } else { BinOp.Ne }
            self.advance()
            let right = self.parse_bitwise_or()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_bitwise_or(self) -> Expr? {
        let left = self.parse_bitwise_xor()?
        mut expr = left
        while self.check(Tk.Pipe) {
            self.advance()
            let right = self.parse_bitwise_xor()?
            expr = Expr.Binary(expr, BinOp.BitOr, right)
        }
        expr
    }

    fn parse_bitwise_xor(self) -> Expr? {
        let left = self.parse_bitwise_and()?
        mut expr = left
        while self.check(Tk.Caret) {
            self.advance()
            let right = self.parse_bitwise_and()?
            expr = Expr.Binary(expr, BinOp.BitXor, right)
        }
        expr
    }

    fn parse_bitwise_and(self) -> Expr? {
        let left = self.parse_comparison()?
        mut expr = left
        while self.check(Tk.Amp) {
            self.advance()
            let right = self.parse_comparison()?
            expr = Expr.Binary(expr, BinOp.BitAnd, right)
        }
        expr
    }

    fn parse_comparison(self) -> Expr? {
        let left = self.parse_shift()?

        mut expr = left
        while self.current_kind in [Tk.Greater, Tk.GreaterEqual, Tk.Less, Tk.LessEqual] {
            let op = match {
                self.check(Tk.Less)         -> BinOp.Lt
                self.check(Tk.LessEqual)    -> BinOp.Le
                self.check(Tk.Greater)      -> BinOp.Gt
                _                           -> BinOp.Ge
            }
            self.advance()
            let right = self.parse_shift()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_shift(self) -> Expr? {
        let left = self.parse_term()?
        mut expr = left
        while self.current_kind in [Tk.Shl, Tk.Shr] {
            let op = if self.check(Tk.Shl) { BinOp.Shl } else { BinOp.Shr }
            self.advance()
            let right = self.parse_term()?
            expr = Expr.Binary(expr, op, right)
        }
        expr
    }

    fn parse_term(self) -> Expr? {
        let left = self.parse_factor()?

        mut expr = left
        while self.current_kind in [Tk.Plus, Tk.Minus] {
            let op = if self.check(Tk.Plus) { BinOp.Add } else { BinOp.Sub }
            self.advance()
            let right = self.parse_factor()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_factor(self) -> Expr? {
        let left = self.parse_unary()?

        mut expr = left
        while self.current_kind in [Tk.Star, Tk.Slash, Tk.Percent] {
            let op = match {
                self.check(Tk.Star)    -> BinOp.Mul
                self.check(Tk.Percent) -> BinOp.Mod
                _                      -> BinOp.Div
            }
            self.advance()
            let right = self.parse_unary()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_unary(self) -> Expr? {
        // Splice `~target` inside a quote body — overloads the `~`
        // token. Splice is greedy: `~f(x)` parses as
        // `Splice(Call(f, [x]))`, splicing the entire call. Users
        // who want only `~f` followed by a separate `(x)` call can
        // write `(~f)(x)` to scope the splice tightly. The greedy
        // form matches the typical metaprogramming pattern where
        // the spliced expression IS the whole quoted hole.
        if self.check(Tk.Tilde) && self.quote_depth > 0 {
            self.advance()
            let target = self.parse_unary()?
            return Expr.Splice(target)
        }
        if self.current_kind in [Tk.Bang, Tk.Minus, Tk.KwNot, Tk.Tilde] {
            let op = match {
                self.check(Tk.Minus) -> UnOp.Neg
                self.check(Tk.Tilde) -> UnOp.BitNot
                _                    -> UnOp.Not
            }
            self.advance()
            let right = self.parse_unary()?
            return Expr.Unary(op, right)
        }

        mut expr = self.parse_call()?
        // `expr with { field: value, ... }` — functional struct update (chainable)
        while self.check(Tk.KwWith) {
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after `with`") {
                return null
            }
            let overrides = self.parse_field_init_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after with fields") {
                return null
            }
            expr = Expr.With(expr, overrides)
        }
        expr
    }

    // Peek at the source character immediately after the current
    // `.` token to see whether the next identifier starts with an
    // uppercase letter.
    fn peek_next_is_upper(self) -> bool {
        if self.current >= self.source.length {
            return false
        }
        let ch = self.source[self.current]
        ch in "A".."Z"
    }

    // Should the current `.` token be consumed as a field / method
    // / enum-ctor postfix on `result`?
    //
    // Always allowed in normal context (`allow_dot_postfix == true`).
    //
    // Inside a match arm body (`allow_dot_postfix == false`):
    //   - `.lowerIdent`  → always a field / method, never a sibling
    //                       pattern, so allow it
    //   - `.UpperIdent`  → might be a sibling pattern unless
    //                       `result` is itself an uppercase Ident
    //                       (an enum-type prefix like `Foo.Bar`).
    //                       Otherwise suppress so the next pattern
    //                       can be parsed.
    //
    // Cross-line postfix rule (forge-crafting-intepreters-3r6q):
    // a bare `.UpperIdent(...)` on a NEW line is almost always a new
    // statement starting with a bare enum constructor — not a method
    // call on the previous expression. Without this, the parser eats
    // such constructors as postfix on the previous expression's value
    // (e.g. `let x = if c { a } else { b }` followed by `.B(...)`
    // becomes `b.B(...)`, silently extending the let initializer).
    // Lowercase method postfix on a new line still chains, so
    // `xs.filter(p)\n.map(f)` still works.
    fn dot_is_postfix(self, result: Expr) -> bool {
        if self.current_line != self.prev_line && self.peek_next_is_upper() {
            return false
        }
        if self.allow_dot_postfix {
            return true
        }
        if !self.peek_next_is_upper() {
            return true
        }
        expr_is_upper_ident(result)
    }

    fn parse_call(self) -> Expr? {
        let expr = self.parse_primary()?

        mut result = expr
        // If [ appears on a DIFFERENT line than the previous token,
        // it's a new statement (list literal), not postfix indexing.
        while (self.check(Tk.LeftParen) && self.current_line == self.prev_line) || (self.check(Tk.Dot) && self.dot_is_postfix(result)) || (self.check(Tk.Bang) && self.allow_dot_postfix && self.current_line == self.prev_line) || (self.check(Tk.LeftBracket) && self.current_line == self.prev_line) || self.check(Tk.QuestionDot) || (self.check(Tk.Question) && self.allow_dot_postfix && self.current_line == self.prev_line) || (self.check(Tk.Less) && is_callable(result)) || self.check(Tk.KwCatch) {
            // Force-unwrap `expr!` is a no-op pass-through since we
            // don't track nullability in the value tag.
            while self.check(Tk.Bang) {
                self.advance()
            }
            // Error propagation: `expr?` — if null, return null
            // from the enclosing function.
            if self.check(Tk.Question) {
                self.advance()
                result = Expr.Try(result)
                continue
            }
            // Catch: `expr catch { body }` or `expr catch (e) { body }` (spec Axis 12.5-12.6)
            let catch_line = self.current_line
            let catch_col = self.current_column
            if self.check(Tk.KwCatch) {
                self.advance()
                mut binding = ""
                if self.check(Tk.LeftParen) {
                    self.advance()
                    binding = self.consume_identifier("expected error binding name after `catch (`")?
                    if !self.consume(Tk.RightParen, "expected `)` after catch binding") { return null }
                }
                if !self.consume(Tk.LeftBrace, "expected `{` after catch") { return null }
                let saved_dot = self.allow_dot_postfix
                self.allow_dot_postfix = true
                let body_stmts = self.parse_statement_list(true)?
                self.allow_dot_postfix = saved_dot
                if !self.consume(Tk.RightBrace, "expected `}` after catch body") { return null }
                result = Expr.Catch(result, binding, Expr.Block(body_stmts), catch_line, catch_col)
                continue
            }
            // Optional chaining: `expr?.field`
            if self.check(Tk.QuestionDot) {
                self.advance()
                let field = self.consume_field_name("expected field name after `?.`")?
                result = Expr.OptionalChain(result, field)
            } else if self.check(Tk.LeftBracket) {
                self.advance()
                let idx = self.parse_expression()?
                // Slice: list[start..end]
                if self.check(Tk.DotDot) {
                    self.advance()
                    let end = self.parse_expression()?
                    if !self.consume(Tk.RightBracket, "expected `]` after slice") {
                        return null
                    }
                    result = Expr.Slice(result, idx, end)
                    continue
                }
                if !self.consume(Tk.RightBracket, "expected `]` after index") {
                    return null
                }
                result = Expr.Index(result, idx)
            } else if self.check(Tk.Less) && is_callable(result) {
                // Explicit type args: `f<int>(x)` — speculative parse with backtracking.
                let generic = self.try_parse_generic_call(result)
                if generic != null {
                    result = generic!
                    continue
                }
                return result
            } else if !self.check(Tk.LeftParen) && !self.check(Tk.Dot) {
                return result
            } else {
            if self.check(Tk.LeftParen) {
                self.advance()
                // Enable `it` sugar for method calls (obj.method(it * 2))
                // but not for regular function calls (to prevent
                // double-wrapping in `f(it)` inside `.map(f(it))`).
                let saved_it = self.allow_it_sugar
                let is_method = match result {
                    .FieldAccess(_, _) -> true
                    _ -> false
                }
                // Enable it sugar for method calls OR if already enabled (e.g. pipe RHS)
                self.allow_it_sugar = is_method || saved_it
                let args = self.parse_arg_list()?
                self.allow_it_sugar = saved_it
                if !self.consume(Tk.RightParen, "expected `)` after arguments") {
                    return null
                }
                result = Expr.Call(result, args)
            } else {
                self.advance()
                // Tuple index: `t.0`, `t.1` — number after dot
                if self.check(Tk.Number) {
                    let idx_text = self.current_lexeme
                    self.advance()
                    result = Expr.TupleIndex(result, int(idx_text))
                    continue
                }
                let field = self.consume_field_name("expected field name after `.`")?
                // Detect enum constructor: `Type.Variant(args)`. We
                // distinguish from method calls by requiring the
                // head Ident to start with an uppercase letter
                // Avra convention: types are PascalCase).
                let type_name = match result {
                    .Ident(n) -> {
                        if p_starts_with_upper(n) {
                            n
                        } else {
                            ""
                        }
                    }
                    _ -> ""
                }
                if type_name != "" && self.check(Tk.LeftParen) {
                    self.advance()
                    let args = self.parse_arg_list()?
                    if !self.consume(Tk.RightParen, "expected `)` after arguments") {
                        return null
                    }
                    result = Expr.EnumCtor(type_name, field, args)
                } else {
                    result = Expr.FieldAccess(result, field)
                }
            }
            }
        }

        result
    }

    fn parse_arg_list(self) -> List<SExpr>? {
        // Inside a paren-bounded arg list we're unambiguously not
        // at a sibling pattern position, so re-enable `.field`
        // postfix consumption.
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let result = self.parse_arg_list_inner()
        self.allow_dot_postfix = saved
        result
    }

    fn parse_arg_list_inner(self) -> List<SExpr>? {
        mut out: List<SExpr> = []
        if self.check(Tk.RightParen) {
            return out
        }
        mut keep_going = true
        while keep_going {
            let raw_expr = self.parse_expression()?
            // `it` parameter sugar: only wrap if allow_it_sugar is set
            // (method calls like .map/.filter set this, regular function
            // calls do not, preventing double-wrapping in `f(it)` inside
            // `.map(f(it))`).
            let expr = if self.allow_it_sugar {
                match raw_expr {
                    .Lambda(_, _) -> raw_expr
                    _ -> {
                        if expr_contains_it(raw_expr) {
                            wrap_in_it_lambda(raw_expr)
                        } else {
                            raw_expr
                        }
                    }
                }
            } else {
                raw_expr
            }
            out.push(sexpr_at(expr, self.current_line, self.current_column, self.file))
            if self.check(Tk.Comma) {
                self.advance()
                if self.check(Tk.RightParen) { keep_going = false }
            } else {
                keep_going = false
            }
        }
        out
    }

    fn parse_primary(self) -> Expr? {
        if self.check(Tk.Number) {
            let value = self.current_lexeme
            self.advance()
            return Expr.Number(value)
        }

        if self.check(Tk.Float) {
            let value = self.current_lexeme
            self.advance()
            return Expr.FloatLit(value)
        }

        if self.check(Tk.String) {
            let value = self.current_lexeme
            self.advance()
            return Expr.String(value)
        }

        if self.check(Tk.Template) {
            let raw = self.current_lexeme
            self.advance()
            return self.desugar_template(raw)
        }

        if self.current_kind in [Tk.KwTrue, Tk.KwFalse] {
            let value = self.current_lexeme
            self.advance()
            return Expr.Bool(value)
        }

        if self.check(Tk.KwNull) {
            self.advance()
            return Expr.Null
        }

        // Contextual enum variant: `.Variant` or `.Variant(args)`
        // Resolved at codegen time using the expected type from context.
        if self.check(Tk.Dot) {
            self.advance()  // consume .
            if self.check(Tk.Identifier) {
                let variant = self.current_lexeme
                self.advance()  // consume variant name
                if self.check(Tk.LeftParen) {
                    self.advance()
                    let args = self.parse_arg_list()?
                    if !self.consume(Tk.RightParen, "expected `)` after variant args") {
                        return null
                    }
                    return Expr.EnumCtor("", variant, args)
                }
                let empty: List<SExpr> = []
                return Expr.EnumCtor("", variant, empty)
            }
        }

        if self.check(Tk.Identifier) {
            let name = self.current_lexeme
            self.advance()
            // Table literal: table { col1 | col2; val1 | val2 }
            // Must check BEFORE struct literal since both start with ident + {
            if name == "table" && self.check(Tk.LeftBrace) {
                return self.parse_table_literal()
            }
            if self.allow_struct_lit && self.check(Tk.LeftBrace) {
                self.advance()
                let inits = self.parse_field_init_list()?
                if !self.consume(Tk.RightBrace, "expected `}` after struct fields") {
                    return null
                }
                return Expr.StructLit(name, inits)
            }
            // Tagged template: `tag`template with ${expr}`
            // Desugars to: tag(desugar_template(raw))
            if self.check(Tk.Template) {
                let raw = self.current_lexeme
                self.advance()
                let template_expr = self.desugar_template(raw)?
                let args: List<SExpr> = [sexpr_at(template_expr, self.current_line, self.current_column, self.file)]
                return Expr.Call(Expr.Ident(name), args)
            }
            return Expr.Ident(name)
        }

        if self.check(Tk.LeftParen) {
            self.advance()
            let saved = self.allow_dot_postfix
            self.allow_dot_postfix = true
            // Empty parens: () → could be empty tuple or zero-arg lambda
            if self.check(Tk.RightParen) {
                self.allow_dot_postfix = saved
                self.advance()
                // () -> expr  is a zero-arg lambda
                if self.check(Tk.Arrow) {
                    self.advance()
                    let body = self.parse_lambda_body()?
                    let empty_ps: List<ParamEntry> = []
                    return Expr.Lambda(empty_ps, body)
                }
                let empty: List<SExpr> = []
                return Expr.Tuple(empty)
            }
            // Typed lambda: (x: int, y: string) -> body
            // Detect by peeking: if current is identifier and next non-ws is ':'
            if self.check(Tk.Identifier) && self.peek_after_ident_is_colon() {
                self.allow_dot_postfix = saved
                let params = self.parse_param_list()?
                if !self.consume(Tk.RightParen, "expected `)` after typed parameters") {
                    return null
                }
                if !self.consume(Tk.Arrow, "expected `->` after typed lambda parameters") {
                    return null
                }
                let body = self.parse_lambda_body()?
                return Expr.Lambda(params, body)
            }
            let expr_opt = self.parse_expression()
            self.allow_dot_postfix = saved
            let expr = expr_opt?
            // (a, b, ...) — comma after first: tuple or multi-param lambda
            if self.check(Tk.Comma) {
                self.advance()
                let rest = self.parse_tuple_rest()?
                if !self.consume(Tk.RightParen, "expected `)` after tuple") {
                    return null
                }
                // (a, b) -> expr  is a lambda
                if self.check(Tk.Arrow) {
                    self.advance()
                    mut combined: List<SExpr> = [sexpr_at(expr!, self.current_line, self.current_column, self.file)]
                    mut ri = 0
                    while ri < rest.length {
                        combined.push(rest[ri])
                        ri = ri + 1
                    }
                    let params = exprs_to_params(combined)
                    let body = self.parse_lambda_body()?
                    return Expr.Lambda(params, body)
                }
                mut tuple_elems: List<SExpr> = [sexpr_at(expr!, self.current_line, self.current_column, self.file)]
                mut tj = 0
                while tj < rest.length {
                    tuple_elems.push(rest[tj])
                    tj = tj + 1
                }
                return Expr.Tuple(tuple_elems)
            }
            if !self.consume(Tk.RightParen, "expected `)` after expression") {
                return null
            }
            // (x) -> expr  is a single-param lambda
            if self.check(Tk.Arrow) {
                self.advance()
                let one: List<SExpr> = [sexpr_at(expr!, self.current_line, self.current_column, self.file)]
                let params = exprs_to_params(one)
                let body = self.parse_lambda_body()?
                return Expr.Lambda(params, body)
            }
            return Expr.Grouping(expr!)
        }

        // List literal: [expr, expr, ...]
        if self.check(Tk.LeftBracket) {
            self.advance()
            if self.check(Tk.RightBracket) {
                self.advance()
                let empty: List<SExpr> = []
                return Expr.ListLit(empty)
            }
            let elements = self.parse_list_elements()?
            if !self.consume(Tk.RightBracket, "expected `]` after list") {
                return null
            }
            // `[body for v in coll if filter]` parses as a single-element
            // SExpr list wrapping `Expr.ListComp(...)`. Unwrap so the
            // comp flows directly into the list_comp feature instead of
            // getting a spurious ListLit wrapper that downstream passes
            // would have to special-case.
            if elements.length == 1 {
                match elements[0].node {
                    .ListComp(_, _, _, _) -> return elements[0].node
                    _ -> {}
                }
            }
            return Expr.ListLit(elements)
        }

        if self.check(Tk.KwMatch) {
            return self.parse_match_expression()
        }

        if self.check(Tk.KwIf) {
            return self.parse_if_expression()
        }

        if self.check(Tk.KwSpawn) {
            return self.parse_spawn_expression()
        }

        if self.check(Tk.KwIsolated) {
            return self.parse_isolated_expression()
        }

        if self.check(Tk.KwWhen) {
            return self.parse_when_expression()
        }

        if self.check(Tk.KwQuote) {
            return self.parse_quote()
        }

        if self.check(Tk.LeftBrace) {
            // Map literal: { "key": value, ... }
            // Disambiguate from block: if first token after { is a string,
            // and the token after that is a colon, it's a map.
            if self.is_map_literal() {
                return self.parse_map_literal()
            }
            return self.parse_block_expression()
        }

        if self.current_lexeme == ";" {
            self.report(DiagCode.UnexpectedSemicolon, "unexpected `;`")
        } else {
            self.report(DiagCode.ExpectedExpression, "expected expression")
        }
        null
    }

    // Desugar `hello ${expr}!` into `"hello " + string(expr) + "!"`
    // The content between `${` and `}` is parsed as a full expression
    // by creating a sub-parser, so `${a + b}`, `${foo.bar}`, and
    // `${string(x)}` all work.
    fn desugar_template(self, raw: string) -> Expr? {
        mut result: Expr? = null
        mut i = 0
        let len = raw.length
        mut text_start = 0
        while i < len {
            if i + 1 < len && raw[i] == "$" && raw[i + 1] == "{" {
                // Flush text segment before the interpolation.
                if i > text_start {
                    let seg = "\"${raw.substring(text_start, i)}\""
                    let str_expr = Expr.String(seg)
                    if result == null {
                        result = str_expr
                    } else {
                        result = Expr.Binary(result!, BinOp.Add, str_expr)
                    }
                }
                // Find matching `}` (no nesting — braces inside
                // template expressions are not supported).
                let expr_start = i + 2
                mut j = expr_start
                mut brace_depth = 0
                while j < len {
                    if raw[j] == "{" { brace_depth = brace_depth + 1 }
                    if raw[j] == "}" {
                        if brace_depth == 0 { break }
                        brace_depth = brace_depth - 1
                    }
                    j = j + 1
                }
                if j >= len {
                    self.set_error("unterminated template expression in string")
                    return null
                }
                // Parse the content between ${ and } as an expression.
                // Simple identifiers become Expr.Ident directly. Complex
                // expressions (containing parens, dots, operators) use a
                // sub-parser. This split avoids creating a Parser struct
                // for the common case.
                let sub_source = raw.substring(expr_start, j)
                // Check for format spec: split on last ':' at depth 0
                let fmt_split = template_split_format(sub_source)
                let expr_part = fmt_split.expr
                let fmt_spec = fmt_split.fmt
                let parsed = if template_is_simple_ident(expr_part) {
                    Expr.Ident(expr_part)
                } else {
                    let sub_result = parse_template_expr(expr_part)
                    if sub_result == null {
                        self.set_error("invalid expression in template: ${expr_part}")
                        return null
                    }
                    sub_result!
                }
                // If format spec exists, use avra_format_float/int; otherwise string().
                let str_call = if fmt_spec.length > 0 {
                    // Determine if float or int format.
                    // Float: ends with f/e/E/g/G, or starts with . (precision without type letter).
                    let last_ch = fmt_spec[fmt_spec.length - 1]
                    let first_ch = fmt_spec[0]
                    let is_float_fmt = last_ch in ["f", "e", "E", "g", "G"] || first_ch == "."
                    let fmt_args: List<SExpr> = [
                        sexpr_dummy(parsed!),
                        sexpr_dummy(Expr.String("\"${fmt_spec}\""))
                    ]
                    if is_float_fmt {
                        // Float format: avra_format_float(expr, spec)
                        Expr.Call(Expr.Ident("avra_format_float"), fmt_args)
                    } else {
                        // Int format: avra_format_int(expr, spec)
                        Expr.Call(Expr.Ident("avra_format_int"), fmt_args)
                    }
                } else {
                    let str_args: List<SExpr> = [sexpr_dummy(parsed!)]
                    Expr.Call(Expr.Ident("string"), str_args)
                }
                if result == null {
                    result = str_call
                } else {
                    result = Expr.Binary(result!, BinOp.Add, str_call)
                }
                i = j + 1
                text_start = i
            } else {
                i = i + 1
            }
        }
        // Flush trailing text after last interpolation.
        if text_start < len {
            let seg = "\"${raw.substring(text_start, len)}\""
            let str_expr = Expr.String(seg)
            if result == null {
                result = str_expr
            } else {
                result = Expr.Binary(result!, BinOp.Add, str_expr)
            }
        }
        if result == null {
            result = Expr.String("\"\"")
        }
        result
    }

    fn parse_tuple_rest(self) -> List<SExpr>? {
        // After the first comma in a tuple. Parse remaining elements.
        mut out: List<SExpr> = []
        mut keep_going = true
        while keep_going {
            if self.check(Tk.RightParen) {
                keep_going = false
            } else {
                let expr = self.parse_expression()?
                out.push(sexpr_at(expr, self.current_line, self.current_column, self.file))
                if self.check(Tk.Comma) {
                    self.advance()
                } else {
                    keep_going = false
                }
            }
        }
        out
    }

    fn parse_block_expression(self) -> Expr? {
        self.advance()
        // A block expression's body is parsed as a regular statement
        // list. Re-enable `.field` postfix consumption inside —
        // we're back in normal expression-statement context.
        let saved_dot = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let body = self.parse_statement_list(true)
        self.allow_dot_postfix = saved_dot
        let body_val = body?
        if !self.consume(Tk.RightBrace, "expected `}` after block expression") {
            return null
        }
        Expr.Block(body_val)
    }

    fn check(self, kind: Tk) -> bool {
        self.current_kind == kind
    }

    // Peek ahead: after the current identifier, skip whitespace,
    // return true if the next char is ':'. For typed lambda detection.
    fn peek_after_ident_is_colon(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == ":"
            }
            i = i + 1
        }
        false
    }

    fn peek_after_ident_is_paren(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == "("
            }
            i = i + 1
        }
        false
    }

    // Peek: is the next token after current ident another identifier (not a keyword)?
    // Returns false for `{`, `(`, `=`, operators, and keyword starts like "true"/"false".
    // Used to detect `comp_name instance_name {` pattern without consuming tokens.
    fn peek_after_ident_is_ident_not_keyword(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        // Skip whitespace
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break }
            i = i + 1
        }
        if i >= self.source.length { return false }
        let ch = self.source.substring(i, i + 1)
        // Must start with letter or underscore
        let is_alpha = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
        if !is_alpha { return false }
        // Extract the full word
        mut j = i
        while j < self.source.length {
            let wc = self.source.substring(j, j + 1)
            let is_alnum = (wc >= "a" && wc <= "z") || (wc >= "A" && wc <= "Z") || (wc >= "0" && wc <= "9") || wc == "_"
            if !is_alnum { break }
            j = j + 1
        }
        let word = self.source.substring(i, j)
        // Exclude keywords that appear after identifiers in non-component contexts
        if word == "true" || word == "false" || word == "null" { return false }
        if word == "in" || word == "is" || word == "and" || word == "or" || word == "not" { return false }
        if word == "with" || word == "match" || word == "if" || word == "else" { return false }
        if word == "while" || word == "for" || word == "fn" || word == "let" || word == "mut" { return false }
        if word == "return" || word == "type" || word == "enum" || word == "trait" || word == "impl" { return false }
        // Check that the word is followed by `{` (to confirm it's instance_name + block)
        mut k = j
        while k < self.source.length {
            let sc = self.source.substring(k, k + 1)
            if sc != " " && sc != "\t" && sc != "\n" && sc != "\r" { break }
            k = k + 1
        }
        if k < self.source.length {
            return self.source.substring(k, k + 1) == "{"
        }
        false
    }

    fn advance(self) {
        self.prev_line = self.current_line
        self.advance_token()
    }

    fn consume(self, kind: Tk, message: string) -> bool {
        if self.check(kind) {
            self.advance()
            return true
        }
        self.set_error(message)
        false
    }

    /// Consume the current token's lexeme + advance. Caller is
    /// expected to have already checked the token kind.
    fn take_lexeme(self) -> string {
        let name = self.current_lexeme
        self.advance()
        name
    }

    /// Emit "`<kw>` is a reserved keyword and cannot be used
    /// <suffix>" at the current span and consume the offending
    /// token. Centralises the diagnostic shared by `parse_declaration`
    /// (top-level decl using a future-reserved keyword) and
    /// `consume_identifier` (binding site).
    fn reject_reserved_keyword(self, suffix: string) {
        let kw = self.current_lexeme
        self.set_error("`${kw}` is a reserved keyword and cannot be used ${suffix}")
        self.advance()
    }

    /// Strict identifier consumer: rejects reserved keywords at
    /// binding sites (param / let / mut / const / fn / type /
    /// variant / field names). so07.2 / 1rzz — without this check
    /// the parser silently accepted `bare`, `await`, etc. as
    /// identifiers and the use site emitted a confusing F0001.
    fn consume_identifier(self, message: string) -> string? {
        if self.check(Tk.KwReserved) {
            self.reject_reserved_keyword("as an identifier — rename the binding")
            return null
        }
        if self.check(Tk.Identifier) { return self.take_lexeme() }
        self.set_error(message)
        null
    }

    /// Parse a comma-separated destructure binding list `a, b, c`
    /// (caller has already consumed the opening `(` and consumes the
    /// closing `)`). Shared by `let (a, b) = …` and the for-in tuple
    /// binding `for (a, b) in …`. A trailing comma is tolerated.
    /// Each entry's type is left Unknown — inferred from the tuple
    /// element types at type-check time.
    fn parse_destructure_names(self) -> List<ParamEntry>? {
        mut out: List<ParamEntry> = []
        if self.check(Tk.RightParen) { return out }
        mut keep_going = true
        while keep_going {
            let name = self.consume_identifier("expected variable name in destructure")?
            out.push(ParamEntry { name: name, vtype: ValueType.Unknown })
            if self.check(Tk.Comma) {
                self.advance()
                if self.check(Tk.RightParen) { keep_going = false }
            } else {
                keep_going = false
            }
        }
        out
    }

    /// Lenient variant for field / method access positions
    /// (`task.await`, `expr?.field`): accepts reserved keywords
    /// because the dot disambiguates. Use only for `expr.<name>` /
    /// `expr?.<name>` sites — binding sites must call
    /// `consume_identifier` instead so reserved names are rejected.
    fn consume_field_name(self, message: string) -> string? {
        if self.check(Tk.Identifier) || self.check(Tk.KwReserved) { return self.take_lexeme() }
        self.set_error(message)
        null
    }

    // Consume a type reference: identifier optionally followed by
    // generic arguments `<A, B>` and/or nullable `?`.
    // Both generics and nullable are erased — we return the base name.
    // Parse a structured type expression. Returns TypeExpr AST node.
    fn parse_type_expr(self, message: string) -> TypeExpr? {
        let base = self.parse_type_atom(message)?
        // Union: A | B | C — lowest precedence in type position
        if self.check(Tk.Pipe) {
            mut result = base
            while self.check(Tk.Pipe) {
                self.advance()
                let rhs = self.parse_type_atom("expected type after `|`")?
                result = TypeExpr.Union(result, rhs)
            }
            return result
        }
        base
    }

    // Parse a single type atom (everything except union |).
    fn parse_type_atom(self, message: string) -> TypeExpr? {
        // qa6i probe 3: `~name` in type position splices a string-
        // valued local into a TypeExpr.Named at construction time.
        // The lowerer detects the leading `~` in the name field and
        // emits a runtime ctor that resolves it against the macro's
        // scope. Only fires inside a quote — outside, `~` in type
        // position is a parse error.
        if self.check(Tk.Tilde) && self.quote_depth > 0 {
            self.advance()
            if !self.check(Tk.Identifier) {
                self.set_error("expected identifier after `~` in type position")
                return null
            }
            let splice_name = self.current_lexeme
            self.advance()
            return TypeExpr.Named("~" + splice_name)
        }
        // dyn Trait — dynamic trait object
        if self.check(Tk.KwDyn) {
            self.advance()
            if !self.check(Tk.Identifier) {
                self.set_error("expected trait name after `dyn`")
                return null
            }
            let trait_name = self.current_lexeme
            self.advance()
            let te = TypeExpr.Named(trait_name)
            if self.check(Tk.Question) {
                self.advance()
                return TypeExpr.Optional(te)
            }
            return te
        }
        // fn(T, T) -> T
        if self.check(Tk.KwFn) {
            self.advance()
            mut params: List<TypeExpr> = []
            if self.check(Tk.LeftParen) {
                self.advance()
                params = self.parse_type_expr_list()?
                if self.check(Tk.RightParen) { self.advance() }
            }
            let ret = if self.check(Tk.Arrow) {
                self.advance()
                self.parse_type_expr("expected return type after `->`")?
            } else { TypeExpr.Infer }
            return TypeExpr.FnType(params, ret)
        }
        // (T, U) → Tuple type
        if self.check(Tk.LeftParen) {
            self.advance()
            let types = self.parse_type_expr_list()?
            if !self.consume(Tk.RightParen, "expected `)` after tuple type") { return null }
            // Build a Generic("__tuple", [T, U, ...]) that type_expr_to_vtype converts to Tuple
            if types.length == 1 {
                // Single-element parens: treat as grouping, not a 1-tuple
                return types[0]
            }
            return TypeExpr.Generic("__tuple", types)
        }
        // [T] → List type
        if self.check(Tk.LeftBracket) {
            self.advance()
            let inner = self.parse_type_expr("expected element type in `[T]`")?
            if !self.consume(Tk.RightBracket, "expected `]` after list type") { return null }
            return TypeExpr.ListType(inner)
        }
        if !self.check(Tk.Identifier) {
            self.set_error(message)
            return null
        }
        mut name = self.current_lexeme
        self.advance()
        // Dotted path: core.ast.BinOp
        while self.check(Tk.Dot) {
            self.advance()
            if !self.check(Tk.Identifier) {
                self.set_error("expected identifier after '.' in type path")
                return null
            }
            name = name + "." + self.current_lexeme
            self.advance()
        }
        // Generic arguments: Result<T, E>
        if self.check(Tk.Less) {
            let args = self.parse_generic_type_args()?
            let te = TypeExpr.Generic(name, args)
            if self.check(Tk.Question) {
                self.advance()
                return TypeExpr.Optional(te)
            }
            return te
        }
        let te = TypeExpr.Named(name)
        if self.check(Tk.Question) {
            self.advance()
            return TypeExpr.Optional(te)
        }
        te
    }

    fn parse_type_expr_list(self) -> List<TypeExpr>? {
        mut out: List<TypeExpr> = []
        while !self.check(Tk.RightParen) && !self.check(Tk.Eof) {
            let ty = self.parse_type_expr("expected type")?
            out.push(ty)
            if self.check(Tk.Comma) { self.advance() }
        }
        out
    }

    fn parse_generic_type_args(self) -> List<TypeExpr>? {
        self.advance()
        mut args: List<TypeExpr> = []
        mut first = true
        while !self.check(Tk.Greater) && !self.check(Tk.Eof) {
            if !first {
                if self.check(Tk.Comma) { self.advance() }
            }
            first = false
            let ty = self.parse_type_expr("expected generic type argument")?
            args.push(ty)
        }
        if self.check(Tk.Greater) { self.advance() }
        args
    }

    fn parse_quote(self) -> Expr? {
        self.advance()  // consume `quote`
        // Optional kind keyword: `stmt` / `stmts` / `type` / `decl` /
        // `arm` selects the result-type of the captured AST. Default
        // is `expr` — the captured body produces an Expr value at
        // runtime.
        let kind = self.parse_quote_kind()
        // Track quote nesting so parse_unary recognizes splice `~`.
        self.quote_depth = self.quote_depth + 1
        if kind == "arm" {
            let body = self.parse_quote_arm_body()?
            self.quote_depth = self.quote_depth - 1
            return Expr.Quote(kind, body)
        }
        let body = self.parse_block_expression()?
        self.quote_depth = self.quote_depth - 1
        Expr.Quote(kind, body)
    }

    fn parse_quote_kind(self) -> string {
        if self.check(Tk.KwType) {
            self.advance()
            return "type"
        }
        if self.check(Tk.Identifier) {
            let lex = self.current_lexeme
            if lex == "stmt" || lex == "stmts" || lex == "decl" || lex == "arm" {
                self.advance()
                return lex
            }
        }
        "expr"
    }

    /// Parse `{ pattern -> body }` for `quote arm { ... }`. Wraps the
    /// resulting arm in a single-armed `Expr.MatchExpr(Expr.Null, [arm])`
    /// so the existing Quote(kind, body) shape stays — the lowering
    /// pass picks the arm back out via its `arm` kind discriminator.
    fn parse_quote_arm_body(self) -> Expr? {
        if !self.consume(Tk.LeftBrace, "expected `{` after `quote arm`") { return null }
        let pattern = self.parse_pattern_or()?
        let guard: SExpr? = if self.check(Tk.KwIf) {
            self.advance()
            let g = self.parse_expression()?
            sexpr(g, self.current_line, self.current_column)
        } else {
            null
        }
        if !self.consume(Tk.Arrow, "expected `->` after pattern in quote arm") { return null }
        let body = self.parse_expression()?
        let body_se = sexpr(body, self.current_line, self.current_column)
        if self.check(Tk.Comma) { self.advance() }
        if !self.consume(Tk.RightBrace, "expected `}` after quote arm body") { return null }
        let arm = MatchArm { pattern, guard, body: body_se }
        let arms: List<MatchArm> = [arm]
        Expr.MatchExpr(sexpr(Expr.Null, self.current_line, self.current_column), arms)
    }

    // Parse `when { cond -> body, ... }` — subjectless match expression.
    fn parse_when_expression(self) -> Expr? {
        self.advance()  // consume `when`
        if !self.consume(Tk.LeftBrace, "expected `{` after `when`") { return null }
        let arms = self.parse_when_arms()?
        if !self.consume(Tk.RightBrace, "expected `}` after when arms") { return null }
        Expr.When(arms)
    }

    fn parse_when_arms(self) -> List<WhenArm>? {
        mut out: List<WhenArm> = []
        while !self.check(Tk.RightBrace) {
            // `_ -> body` or `else -> body` is the default arm (null condition)
            let line = self.current_line
            let col = self.current_column
            let cond = if (self.check(Tk.Identifier) && self.current_lexeme == "_") || self.check(Tk.KwElse) {
                self.advance()
                null
            } else {
                let c = self.parse_expression()?
                sexpr_at(c, line, col, self.file)
            }
            if !self.consume(Tk.Arrow, "expected `->` after when condition") { return null }
            let body_line = self.current_line
            let body_col = self.current_column
            let body = self.parse_expression()?
            let body_se = sexpr_at(body, body_line, body_col, self.file)
            out.push(WhenArm { cond, body: body_se })
        }
        out
    }

    // ── Speculative parsing (backtracking) ──

    fn save_state(self) -> ParserState {
        ParserState {
            start: self.start, current: self.current,
            line: self.line, column: self.column,
            current_kind: self.current_kind, current_lexeme: self.current_lexeme,
            current_line: self.current_line, current_column: self.current_column,
            current_start: self.current_start,
            had_error: self.had_error, error_message: self.error_message,
            bag: self.bag,
        }
    }

    fn restore_state(self, state: ParserState) {
        self.start = state.start
        self.current = state.current
        self.line = state.line
        self.column = state.column
        self.current_kind = state.current_kind
        self.current_lexeme = state.current_lexeme
        self.current_line = state.current_line
        self.current_column = state.current_column
        self.current_start = state.current_start
        self.had_error = state.had_error
        self.error_message = state.error_message
        self.bag = state.bag
    }

    // Skip a balanced `< ... >` bracket group, handling nesting.
    // Used in impl blocks where we don't yet parse type params.
    fn skip_angle_brackets(self) {
        self.advance()  // consume `<`
        mut depth = 1
        while depth > 0 && !self.check(Tk.Eof) {
            if self.check(Tk.Less) {
                depth = depth + 1
            } else if self.check(Tk.Greater) {
                depth = depth - 1
            }
            self.advance()
        }
    }

    // Collect angle-bracket content as a string: <EmitValue, string> -> "<EmitValue, string>"
    fn collect_angle_brackets(self) -> string {
        self.advance()  // consume `<`
        mut result = "<"
        mut depth = 1
        while depth > 0 && !self.check(Tk.Eof) {
            if self.check(Tk.Less) {
                depth = depth + 1
                result = "${result}<"
            } else if self.check(Tk.Greater) {
                depth = depth - 1
                result = "${result}>"
            } else if self.check(Tk.Comma) {
                result = "${result}, "
            } else {
                result = "${result}${self.current_lexeme}"
            }
            self.advance()
        }
        result
    }

    fn set_error(self, message: string) {
        self.report(DiagCode.SyntaxError, message)
    }

    fn report(self, code: DiagCode, message: string) {
        // Always add to the bag — even if we already had an error.
        // This lets us show ALL parse errors, not just the first.
        let sp = span_new(self.current_start, self.current, self.current_line, self.current_column)
        let diag = diag_error(code, message, sp)
        self.bag = bag_report(self.bag, diag)
        // Set had_error + message for backward compat (first error wins)
        if !self.had_error {
            self.had_error = true
            self.error_message = "parse error at ${string(self.current_line)}:${string(self.current_column)}: ${message}"
        }
    }

    // Panic-mode recovery: skip tokens until we find something that
    // looks like the start of a new statement. This lets us resume
    // parsing and find more errors.
    fn synchronize(self) {
        while !self.check(Tk.Eof) {
            if self.current_kind in [Tk.KwFn, Tk.KwLet, Tk.KwConst, Tk.KwMut, Tk.KwType, Tk.KwEnum, Tk.KwImpl, Tk.KwIf, Tk.KwWhile, Tk.KwFor, Tk.KwMatch, Tk.KwReturn, Tk.KwExtern, Tk.KwTrait, Tk.KwDefer, Tk.KwSpec, Tk.KwGiven, Tk.KwThen, Tk.KwSelect, Tk.RightBrace] {
                return
            }
            self.advance()
        }
    }
}
