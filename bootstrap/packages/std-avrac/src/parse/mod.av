// WHY: recursive-descent parser with integrated lexer. Scans source
// text one token at a time and builds an AST. Precedence is encoded
// in the call chain: assignment → pipe → null_coalesce → or → and →
// equality → comparison → term → factor → unary → call → primary.
// Feature-specific parsers extend Parser via cross-file impl blocks.
//
// NEVER add feature-specific parsing to this file. New syntax belongs
// in features/<name>/parser.av as an impl Parser block. This file is
// infrastructure only: the expression precedence chain, statement
// dispatch, and token consumption helpers.

// dir-as-module (g2eo.1): lexer.av auto-loads as a sibling, surfaces
// flat at `parse.{...}`.
use core.{Expr, Stmt, ParamEntry, Pattern, MatchArm, WhenArm, BinOp, UnOp, LogicOp, stmt_unwrap, Annotation, Tk, tk_keyword_str, TypeExpr, FieldInit, type_expr_to_vtype}
use core.{Registry, build_registry, lookup_decl_parser, lookup_stmt_parser, lookup_expr_parser}
use core.{gensym_name, FORCE_UNWRAP_FN, type_short_name, tk_is_field_name}
use core.{NodeStore, StoreMark, new_node_store, build_line_index, share_arenas_keep_lines}
use core.{NodeRef, NodeEdges, ExprId, StmtId, PatId, TypeId, ByteSpan, byte_span, byte_span_none, expr_ref_id, SrcPos}
use features.closures.{expr_contains_it, wrap_in_it_lambda}
// ps3t.6.5.12 (parser swap-in): the hand parser delegates a whole type
// expression to the grammar-DSL when AVRA_PARSER_TYPE_FLIP=1 — the inverse of
// the @hand bridge (grammar -> parse). The parse<->features.grammar module
// cycle is fine: the package resolves as a whole (parse<->features.closures
// already cycles the same way).
use features.grammar.{word_excluded_as_instance_name, run_dsl_type_at_shared, DslTypeResult, Token, lex_real, Grammar, avra_program_grammar, run_dsl_expr_at_shared, DslExprResult, ExprModes, avra_expr_grammar, run_dsl_stmt_at_shared, DslStmtResult, avra_stmt_flip_grammar, run_dsl_decl_at_shared, avra_decl_flip_grammar}
use parse.static_expr_entry.{run_static_expr}
use parse.static_decl_entry.{run_static_decl}
use parse.static_type_entry.{run_static_type}
// The GENERATED exact-match keyword recogniser (compiled from keyword_rules());
// p_keyword_kind is now a thin string wrapper over it.
use parse.{classify_keyword}
use diagnostics.{Span, DiagCode, Diagnostic, DiagnosticBag, bag_new, bag_report, bag_merge, diag_error, diag_with_help, span_new, span_at}

// The parser-swap-in env toggle. Declared extern here (resolves to the single C
// symbol; sibling modules declare it identically — extern decls are per-file).
extern fn avra_process_env_get(name: string) -> string
// A byte view of the source string, built once per Parser (see the `source_bytes`
// field) so the generated operator scanner reads raw bytes allocation-free.
extern fn avra_bytes_from_string(s: string) -> bytes
// t-drl0: label the current phase for the process-wide memory ceiling, so an
// F4014 report names where the memory went instead of just how much.
extern fn avra_mem_phase_set(label: string)

/// Output of `parse_expression_source`. `expr` is null on parse
/// failure; consult `had_error` / `error_message` for the cause.
/// `bag` mirrors ProgramParseResult — it carries every F-code
/// diagnostic the parser emitted (lexer + grammar errors) so the
/// CLI can render structured source-frame output rather than just
/// the one-line `error_message`. Empty for clean parses.
export type ParseResult = {
    expr: Expr?,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
    // The parse's NodeStore (B-final F2+): flipped payloads carry ids,
    // so expression consumers (eval) resolve through the same store.
    store: NodeStore,
}

/// Output of `parse_program_source`. Same shape as ParseResult but
/// carries the top-level statement rows (`List<StmtId>`) plus the full
/// DiagnosticBag so later passes can render multi-error messages.
export type ProgramParseResult = {
    // The top-level statements as arena rows (F3a). Null on a parse error.
    // A shared-store sub-parse doesn't record roots, so consumers that embed
    // the parsed statements as flipped children (the module resolver filling
    // `Stmt.Module` bodies) take their ids from here.
    ids: List<StmtId>?,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
    // The parser's NATIVE arena (B1): every parsed node has a row; on a
    // clean parse the top-level statements are recorded as `roots` with
    // conservative spans + provenance. `parse_or_fail` serves the program
    // directly from these roots — the canonical producer on the compile path.
    store: NodeStore,
}

/// One parse of a paren/bracket-bounded argument list: `ids` are the arena
/// rows backing each element (it-sugar applied), in source order, for the
/// parent's edge list.
export type ArgListIds = {
    ids: List<ExprId>,
}

/// One iteration of the postfix chain (`postfix_step`, the shared loop body of
/// `parse_call`). `rid` is the arena id after this step; `progressed` = the loop
/// should run again (a suffix was consumed and more may follow). A STOPPING step
/// (entry guard not matched, generic-call speculation failed, or a `!`-only tail
/// that reaches the non-postfix arm) still returns its accumulated `rid` — the
/// caller adopts `rid` BEFORE checking `progressed`, so the `!`-wrapped result of
/// the trailing non-postfix arm (`a!` at EOF) is never dropped.
export type PostfixStep = {
    rid: ExprId,
    progressed: bool,
}

/// One parse of a struct-literal field-init list. `inits` are the parsed
/// field initializers with shorthand expanded; each carries its value's
/// arena id in `value_id`.
export type FieldInitIds = {
    inits: List<FieldInit>,
}

/// Running state of the template-desugar fold — the boxed concatenation
/// built so far and the arena row backing it (`have` distinguishes the
/// empty fold from a real first segment).
type TemplateFold = { have: bool, result: Expr, result_id: ExprId }

/// One parse of a statement list: `ids` are the arena rows backing each
/// statement, in source order, for the parent's edge list (or the store's
/// roots). Each row carries its own (line, col, file) in the store's
/// position column, recorded during the parse.
export type StmtListIds = {
    ids: List<StmtId>,
}

/// Saved parser state used by speculative parses (e.g. generic call
/// disambiguation). Pair with `parser.save_state` /
/// `parser.restore_state` to back out of an attempted parse.
export type ParserState = {
    start: int,
    current: int,
    line: int,
    column: int,
    current_kind: Tk,
    current_lexeme: string,
    current_line: int,
    current_column: int,
    prev_line: int,
    current_start: int,
    had_error: int,
    error_message: string,
    // Context-sensitive parse-mode flags. A backtrack must restore these so a
    // failed lookahead cannot leak a mode change into the retry.
    allow_struct_lit: int,
    allow_dot_postfix: int,
    cell_mode: bool,
    allow_it_sugar: int,
    quote_depth: int,
    bag: DiagnosticBag,
    // The store half of the snapshot (B1): arena row counts at save time. A
    // backtrack truncates the arenas to these marks so an abandoned
    // speculative parse leaves no rows (a quote allocated inside a backtracked
    // arg list must not trip the flat presence scan).
    store_mark: StoreMark,
}

/// Mutable parser state. Tracks lexer position, the currently-staged
/// token, error state, the diagnostic bag, and a few mode flags
/// that gate context-sensitive parses.
/// @field source             — the entire program text.
/// @field start / current    — lexer byte offsets (start = current
///                              token's first byte).
/// @field line / column      — lexer's source position.
/// @field current_kind       — Tk discriminant of the staged token.
/// @field current_lexeme     — the staged token's source text.
/// @field current_line/col   — span coordinates of the staged token.
/// @field prev_line          — line of the previously-consumed token;
///                              used to gate same-line postfix attach.
/// @field had_error          — sticky failure flag.
/// @field error_message      — first error's message (legacy).
/// @field allow_struct_lit   — when 0, `Ident { ... }` parses as
///                              Ident-then-block (inside `if` / `while`
///                              conditions); when 1, it's a struct
///                              literal.
/// @field allow_dot_postfix  — when 0, `.` doesn't attach as postfix
///                              (inside match-arm bodies, so the next
///                              `.Variant` arm isn't gobbled).
/// @field allow_it_sugar     — when 1, `it` inside an arg list wraps
///                              the expr in an implicit lambda. Set
///                              by method calls, not regular calls.
/// @field current_start      — byte offset of the staged token's start.
/// @field bag                — accumulated diagnostics.
/// @field features           — feature registry for parser dispatch.
export type Parser = {
    source: string,
    // strlen(source), measured once at construction. `source` is never
    // reassigned, so every per-char access can bounds-check against this
    // field instead of re-deriving strlen(source) each call — the fix for
    // the lexer's quadratic-per-file scan.
    source_len: int,
    // A byte view of `source`, materialized ONCE at construction (avra_bytes_from_string).
    // The lexer's operator scanner (scan_operator, parse/gen_operator_scanner.av) reads
    // raw bytes through this with NO per-character string allocation — the hot-path win
    // the byte-scanner was built for. `source` is never reassigned, so it stays valid.
    source_bytes: bytes,
    file: string,
    mut start: int,
    mut current: int,
    mut line: int,
    mut column: int,
    mut current_kind: Tk,
    mut current_lexeme: string,
    mut current_line: int,
    mut current_column: int,
    mut prev_line: int,
    mut had_error: int,
    mut error_message: string,
    // When false, `Ident { ... }` is parsed as Ident followed by a
    // separate block (used inside `if`/`while` conditions to avoid
    // grabbing the loop body brace as a struct literal). When true,
    // `Ident { ... }` becomes a struct literal expression.
    mut allow_struct_lit: int,
    // When false, parse_call's loop won't consume `.` as a postfix.
    // Disabled inside match-arm bodies so the next sibling pattern
    // (e.g. `.Variant(x)`) isn't gobbled into the previous body.
    mut allow_dot_postfix: int,
    // When true, expression parsing is bounded to a single source line:
    // a binary `+`/`-` or a `.`-postfix that begins on the *next* line
    // does NOT continue the current expression. Set only while parsing
    // table-literal cells, so a row ending in a value followed by a next
    // row starting with `-` / `.Variant` doesn't merge across the newline.
    mut cell_mode: bool,
    // When true, expressions containing `it` in arg lists are wrapped
    // in implicit lambdas. Set by method call parsing (.map, etc.),
    // NOT by regular function calls (prevents double-wrapping).
    mut allow_it_sugar: int,
    // Counts open `quote { ... }` bodies the parser is currently
    // inside. When > 0, a leading `~` parses as Expr.Splice instead
    // of Expr.Unary(BitNot, ...). The same `~` token is overloaded
    // by context — outside a quote, it stays the bitwise-NOT prefix.
    mut quote_depth: int,
    mut current_start: int,   // byte offset where current token started
    // Base-threading for the grammar-owned postfix chain (Phase 3a,
    // t-47hc.4.1.1). The grammar's `unary` rule folds `( @hand(postfix_suffix) )*`
    // over the primary base: `@hand(primary_base)` writes the base here, and each
    // `postfix_suffix` runs ONE `postfix_step` on it and writes the updated base
    // back. Unused on the pure-hand path (`parse_call` passes rid/sp_start to
    // `postfix_step` directly); only the grammar delegate reads them. NOT part of
    // ParserState save/restore — the base flows as a `postfix_step` local, and
    // `try_parse_generic_call`'s own save/restore nests inside `postfix_step`.
    mut postfix_base: ExprId,
    mut postfix_sp_start: int,
    // Monotonic counter for hygienic temp names in parser desugars
    // (`if let` / `let-else` / `match` present-bind). Use `self.fresh(tag)`
    // to mint a guaranteed-unique `__<tag>_<n>` — collision-proof under
    // macro replication, unlike a source-position-derived name.
    mut gensym_seq: int,
    mut bag: DiagnosticBag,
    features: Registry,
    // The L1 arena the parser allocates into as it parses (B1). This IS the
    // canonical store: every production pushes its node here and returns its
    // typed id, and `parse_or_fail` (main.av) serves the program from it —
    // there is no separate ingest walk. Parents read a child's boxed node
    // back via `store.<arena>.get(id)` to embed in their own payload. Built
    // per entry parser from this parser's source; template `${...}`
    // sub-parsers share the outer store.
    store: NodeStore,
    // 1 for an ENTRY parse (parse_file_program records the top-level rows
    // as store roots); 0 for a pipeline sub-parse sharing the entry store
    // (module files, package entries, siblings — their statements merge
    // into the entry tree as children, never as program roots). Set at
    // construction, never mutated mid-parse (not backtrack-relevant).
    mut records_roots: int,
    // ps3t.6.5.12 parser swap-in: when true, parse_type_expr delegates the
    // whole type expression to the grammar-DSL (run_dsl_type_at) as
    // authoritative, falling back to the hand parser on a DSL error. Read ONCE
    // at construction (never a getenv per annotation) and settable directly by
    // tests. PROMOTED (ps3t.6.5.12): the DSL is now the DEFAULT type parser —
    // proven byte-identical to the hand parser across the whole selfhost
    // (781232 lines) + the difftest corpus. `AVRA_PARSER_TYPE_FLIP=0` restores
    // the hand path as a debug escape hatch.
    mut type_flip: bool,
    // t-47hc.4.4 Phase 3d: when true, parse_type_expr drives the CHECKED-IN generated
    // static type parser (parse/gen_type_parser.av's parse_type_expr, via
    // run_static_type) instead of the Grammar-tree interpreter (run_dsl_type_at_shared).
    // Straight-line speed, byte-identical to both the interpreter flip AND the hand
    // parser (diff-test-gated). PROMOTED default-ON (sibling of expr_static/decl_static);
    // `AVRA_PARSER_TYPE_STATIC=0` falls back to the interpreter (type_flip), then hand.
    mut type_static: bool,
    // ps3t.6.5.12 lex-once cache (Step D): the grammar-DSL token list for THIS
    // parser's source, lexed at most once (lazily, via `grammar_tokens`) and
    // reused across every type-flip delegation. Empty = not lexed yet (lex_real
    // always yields >=1 token — the trailing EOF — so empty is an unambiguous
    // sentinel). Without this the flip re-lexes the whole file per annotation
    // (O(n^2) + unbounded allocation that OOM'd the full-selfhost flip compile).
    mut grammar_toks: List<Token>,
    // ps3t.6.5.12 lex-once cache (Step D): the DSL program grammar, built at most
    // once per parser (null = not built). Rebuilding its 41 rules per annotation
    // was ~half the flip's memory blow-up; the type-flip delegation reuses this
    // one grammar AND this parser's own `store` (the type success path never
    // allocates into it, so the hand parse's node-id space is untouched).
    mut dsl_grammar: Grammar?,
    // ps3t.6.5.12 pattern-family swap-in: when true, parse_pattern_or delegates
    // the whole or-pattern to the grammar-DSL (avra_pat_grammar), with a hand
    // fallback on any DSL error. Read once at construction. PROMOTED: the DSL is
    // now the DEFAULT pattern parser — proven byte-identical to the hand parser
    // across the whole selfhost (781802 lines). `AVRA_PARSER_PAT_FLIP=0` restores
    // the hand path as a debug escape. `dsl_pat_grammar` caches avra_pat_grammar()
    // (the isolated pattern grammar — the program grammar carries no pattern
    // rules yet) lazily, once, exactly like `dsl_grammar`.
    mut pat_flip: bool,
    // t-47hc.4.4 Phase 3d (pattern half): when true, parse_pattern_or drives the
    // CHECKED-IN generated static pattern parser (parse/gen_pat_parser.av's
    // parse_pattern_or, via run_static_pat) instead of the Grammar-tree interpreter
    // (run_dsl_pattern_at_shared). Straight-line speed, byte-identical to both the
    // interpreter flip AND the hand parser (diff-test-gated). PROMOTED default-ON
    // (sibling of type_static); `AVRA_PARSER_PAT_STATIC=0` falls back to the
    // interpreter (pat_flip), then hand.
    mut pat_static: bool,
    mut dsl_pat_grammar: Grammar?,
    // ps3t.6.7 expression-family swap-in: when true, parse_expression delegates
    // the whole expression to the grammar-DSL (avra_expr_grammar's full ladder —
    // assignment/pipe/null-coalesce/or-and/is-in/==-chain over the operator strata
    // and the @hand(hand_unary) procedural leaf), threading this parser's live
    // modes so the leaf reproduces the mode-sensitive parse. Read once at
    // construction, settable by tests. Default OFF until proven byte-identical on
    // the full selfhost, then promoted (like type_flip / pat_flip).
    // dsl_expr_grammar caches avra_expr_grammar() lazily (the per-family expr view
    // carries the full ladder; the program grammar still has an older leaf).
    mut expr_flip: bool,
    mut dsl_expr_grammar: Grammar?,
    // ps3t.6.7 Step G — the STATIC expression parser (the CHECKED-IN generated
    // parser, parse/gen_expr_parser.av, driven via run_static_expr) instead of the
    // Grammar-tree interpreter. Same PState + builders + @hand leaf as expr_flip, so
    // byte-identical AST, but straight-line (no per-node dispatch / capture-env alloc)
    // — the path to promoting the expression flip on. Read once at construction,
    // settable by tests. Default OFF until proven byte-identical on the full selfhost.
    mut expr_static: bool,
    // ps3t.6.7 Phase 2 — the STATIC declaration parser: when set (with decl_flip on),
    // parse_declaration drives the CHECKED-IN generated static parser
    // (parse/gen_decl_parser.av's parse_declaration, via run_static_decl) instead of
    // the Grammar-tree interpreter (run_dsl_decl_at_shared / exec_rule). Same PState +
    // builders + @hand leaves (run_hand_stmt) ⇒ byte-identical AST, but straight-line
    // (no exec_rule grammar walk) — erasing the interpreter's top-level-dispatch tax.
    // PROMOTED default-ON: byte-identical over the full selfhost + corpus + the FULL
    // error-path suite. The static parser drives every VALID item at straight-line
    // speed; its generated fold/optional rules do NOT reproduce the interpreter's
    // exact error-RECOVERY tree (they build partial nodes where exec_rule bails), so
    // on ANY error parse_declaration ROLLS THE STORE BACK over the abandoned static
    // rows (store.mark/truncate_to_mark) and re-parses THAT item with the interpreter
    // — the incumbent byte-identical error path. Errors are rare (invalid programs
    // only), so the common valid case keeps the straight-line win while error trees
    // stay byte-identical without chasing them through emit. AVRA_PARSER_DECL_STATIC=0
    // routes back to the interpreter unconditionally (still the differential oracle).
    // Only active when decl_flip is on (the escape hatch AVRA_PARSER_DECL_FLIP=0
    // disables both, dropping to the pure hand parser).
    mut decl_static: bool,
    // ps3t.6.7 Step G slice 4 — statement-family swap-in: when true,
    // parse_statement delegates the whole statement to the grammar-DSL
    // (avra_stmt_flip_grammar: break/continue DSL-native, block + control-flow +
    // feature-keyword forms via @hand(stmt_hand) → parse_statement, and the
    // fall-through expr-statement over the shared expression grammar), with a hand
    // fallback on any DSL error. Read once at construction, settable by tests.
    // Default OFF until proven byte-identical on the full selfhost, then promoted
    // (like type_flip / pat_flip). dsl_stmt_grammar caches avra_stmt_flip_grammar()
    // lazily, once, exactly like dsl_expr_grammar.
    mut stmt_flip: bool,
    mut dsl_stmt_grammar: Grammar?,
    // ps3t.6.7 Step G slice 4b — declaration/whole-program-family swap-in: when
    // true, parse_declaration delegates to the grammar-DSL (avra_decl_flip_grammar:
    // @hand(decl_hand) for the doc/annotation/export wrapping + decl keywords +
    // component-vs-expr IDENT disambiguation, and the proven statement grammar for
    // the non-declaration fall-through), with a hand fallback on any DSL error.
    // Read once at construction, settable by tests. Default OFF until proven
    // byte-identical on the full selfhost, then promoted (like type/pat_flip).
    // dsl_decl_grammar caches avra_decl_flip_grammar() lazily, once.
    mut decl_flip: bool,
    mut dsl_decl_grammar: Grammar?,
    // ps3t.6.7 slice 5a — DIAGNOSTIC hook (AVRA_NO_STATIC_FALLBACK=1, default OFF).
    // When set, parse_declaration/parse_statement do NOT re-parse a failed static
    // parse with the interpreter; the static parser's RAW error-recovery tree is
    // used verbatim. Default OFF keeps production byte-identical (the fallback is
    // still the incumbent byte-identical error path). This is the observability the
    // error-recovery differential oracle needs to measure + close the static
    // parser's error-tree gap vs the interpreter/hand oracle (the slice-5 crux),
    // before the interpreter fallback can be retired.
    mut no_static_fallback: bool,
    // ps3t.6.7 flip: ONE reusable @hand delegate for the expression leaves, created
    // once per file (avoids build_registry() ~53 registrations per leaf — the OOM).
    // Before each flip expression its cursor+line state is SYNCED to this parser's
    // (copy_cursor_from), so it parses the leaves carrying the SAME accumulated
    // line — including the deliberate is_map_literal line nudges the hand parser
    // leaves in self.line — and this parser then ADOPTS the delegate's end state.
    // That reproduces the hand parser's line accounting byte-for-byte (a seek that
    // re-derives the "true" line instead would DIVERGE from the hand's nudged line).
    mut hand_delegate: Parser?,
}

/// Parse a single expression. Used by `bs2 expr` for AST inspection
/// and by the eval interpreter's REPL-style entry.
export fn parse_expression_source(source: string) -> ParseResult {
    mut parser = parser_new(source)
    parser.parse_file_expression()
}

/// Parse a whole program (a sequence of declarations + statements).
/// Top-level entry consumed by every CLI subcommand that ingests
/// source.
export fn parse_program_source(source: string) -> ProgramParseResult {
    parse_program_source_at(source, "")
}

/// Parse a whole program with explicit file attribution. Used by
/// the test runner so each test's parsed AST nodes know which file
/// they came from — diagnostics in the bundled program can then
/// cite the originating *_test.av rather than a `<test>` placeholder.
export fn parse_program_source_at(source: string, file: string) -> ProgramParseResult {
    // t-drl0: same phase stamp as parse_program_source_shared, but ONLY when a name
    // is actually known. `file == ""` is the ENTRY-FILE parse — deliberately unnamed,
    // because `SrcPos.file` is what distinguishes an entry node from a merged-module
    // node and the operand-span sharpening keys off it. The CLI knows that file's real
    // path and stamps the phase itself before calling in (parse_or_fail), so
    // overwriting it here with "<stdin>" would just throw that name away.
    if file != "" { avra_mem_phase_set("parse ${file}") }
    mut parser = parser_new_with_file(source, file)
    parser.parse_file_program()
}

/// Sub-parse entry for pipeline-MERGED files (module files, package
/// entries, sibling files, test-runner imports): parses `source`
/// allocating into the ENTRY parser's `store` — the single-store
/// invariant, so every node the pipeline later walks has a row in the
/// one program store (the template-sub-parser precedent, generalized).
/// Does NOT record roots: the parsed statements become children of the
/// entry program's tree. Positions ride the arena rows — each node is
/// stamped with its source `file` and span as the parser allocates it.
export fn parse_program_source_shared(source: string, file: string, store: NodeStore) -> ProgramParseResult {
    // t-drl0: name the phase for the process memory ceiling. If the compiler
    // trips F4014 while parsing, the report says WHICH file it was reading —
    // the difference between "the build died" and a reproducible bug report.
    avra_mem_phase_set("parse ${file}")
    mut parser = parser_new_with_file(source, file)
    // Arenas from the entry parse, LineIndex from THIS file. A merged file's token
    // offsets index into its own `source`; adopting the entry file's index would
    // resolve every position here against the wrong text — including the `^`
    // sameline gate. See `share_arenas_keep_lines`.
    parser.store = share_arenas_keep_lines(store, parser.store)
    parser.records_roots = 0
    parser.parse_file_program()
}

/// Parse a fn-body source rendered by `fmt_stmt_ids`. The body is
/// wrapped in a synthetic fn declaration so `parse_program_source`
/// sees a complete program; the wrapper's body stmts are returned.
/// Used by the metadata roundtrip (eager for generic bodies, lazy
/// for @comptime bodies — both flow through here). Returns `[]` on
/// any parse failure so callers treat the fn as body-less and
/// surface a clearer error downstream.
export fn parse_body_source(source: string, store: NodeStore) -> List<StmtId> {
    // The caller's store, not a fresh one: the parsed body's id payloads
    // (pattern children since F2, statement children since F3a) must
    // resolve in the arena the consumer executes against — a throwaway
    // store would leave wrong-arena ids.
    let empty: List<StmtId> = []
    if source == "" { return empty }
    let wrapped = "fn __avra_body_source_wrapper() {\n" + source + "\n}"
    let parsed = parse_program_source_shared(wrapped, "", store)
    if parsed.had_error == 1 { return empty }
    if parsed.ids == null { return empty }
    let root_ids = parsed.ids!
    if root_ids.length == 0 { return empty }
    match stmt_unwrap(store, store.stmts.get(root_ids[0])) {
        .Function(_, _, _, _, body) -> body
        _ -> empty
    }
}

/// Interleave header names and values into a flat alternating list:
/// `[k1, k2]` + `[v1, v2]` → `[k1, v1, k2, v2]`. MapLit expects this
/// flat shape; table-literal parsing produces it.
export fn table_zip_entries(headers: List<ExprId>, values: List<ExprId>) -> List<ExprId> {
    mut out: List<ExprId> = []
    let n = if headers.length < values.length { headers.length } else { values.length }
    mut i = 0
    while i < n {
        out.push(headers[i])
        out.push(values[i])
        i = i + 1
    }
    out
}

/// True iff the LAST `::`-separated segment of a qualified name starts
/// uppercase — i.e. names a type (PascalCase), not a value. Used to decide
/// whether `@pkg::mod::X.Variant(args)` is an enum constructor (X is a type)
/// or a method call on a qualified value (X is lowercase).
fn p_qualified_last_upper(n: string) -> bool {
    mut start = 0
    mut i = 0
    while i + 1 < n.length {
        if n.substring(i, i + 2) == "::" { start = i + 2 }
        i = i + 1
    }
    start < n.length && p_starts_with_upper(n.substring(start, start + 1))
}

/// True iff `e` is a bare or qualified identifier — used to gate
/// promotions like Ident-to-call or Ident-to-pattern.
fn expr_is_ident(e: Expr) -> bool {
    match e {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        _ -> false
    }
}

/// True iff `e` is an identifier whose first letter is uppercase —
/// the syntactic marker the resolver uses to distinguish a type ref
/// from a value ref.
fn expr_is_upper_ident(e: Expr) -> bool {
    match e {
        .Ident(n) -> p_starts_with_upper(n)
        // Test the LAST path segment: a qualified type reference
        // (`@std::…::Result`) begins with `@`, so the full-string test read
        // every qualified name as lowercase — `dot_is_postfix` then refused
        // the `.Variant` continuation, the chain stopped at the type, and
        // `.Err(c)` leaked into the NEXT match arm as a pattern ("expected
        // `->` after pattern"). Bit hardest in metadata round-trips, whose
        // fmt-rendered bodies qualify every enum-ctor reference.
        .QualifiedIdent(n) -> p_starts_with_upper(type_short_name(n))
        _ -> false
    }
}

/// Convert a list of Ident expressions into a `List<ParamEntry>` (for lambda
/// parsing). `(x, y) -> ...` parses the parens as expressions first,
/// then reinterprets the Ident names as parameter names once `->`
/// is seen.
fn exprs_to_params(store: NodeStore, ids: List<ExprId>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    for id in ids {
        let name = match store.exprs.get(id) {
            .Ident(n) -> n
            .QualifiedIdent(n) -> n
            _ -> "_"
        }
        // No type syntax exists in this position (the typed-lambda path goes
        // through parse_param_list) — no type was written, so no row backs it.
        out.push(ParamEntry { name: name, vtype: ValueType.Unknown, ty_id: none })
    }
    out
}

/// True iff `expr` is something that could syntactically be the
/// callee of `expr(args)` — bare ident, qualified ident, or a field
/// access (method call). Used by the postfix-call gate.
fn is_callable(expr: Expr) -> bool {
    match expr {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        .FieldAccess(_, _) -> true
        _ -> false
    }
}

/// True iff `name` starts with an uppercase ASCII letter — Avra's
/// type / variant naming convention.
fn p_starts_with_upper(name: string) -> bool {
    if name.length < 1 {
        return false
    }
    let head = name.substring(0, 1)
    head in "A".."Z"
}

/// True iff `s` is a simple identifier (alpha first, then alnum or
/// underscores). Simple idents inside `${...}` don't need a sub-
/// parser — they lower directly to `Expr.Ident`.
fn template_is_simple_ident(s: string) -> bool {
    if s.length == 0 { return false }
    // First char must be alpha (not digit) to be an identifier
    if !p_is_alpha(s[0]) { return false }
    mut i = 1
    while i < s.length {
        let ch = s[i]
        if !p_is_alpha_numeric(ch) {
            return false
        }
        i = i + 1
    }
    true
}

/// Output of `template_split_format`: the expression text and its
/// optional `:format-spec` suffix (empty when no spec).
type FormatSplit = { expr: string, fmt: string }

/// Split a template interpolation body `"${expr:fmt}"` at the last
/// colon at brace/paren depth 0. Returns the parts so the lowerer
/// can route them to the right runtime call. When no valid format
/// spec is found, the whole input is treated as the expression.
fn template_split_format(s: string) -> FormatSplit {
    mut last_colon = -1
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s[i]
        if ch in ["(", "[", "{"] { depth = depth + 1 }
        if ch in [")", "]", "}"] { depth = depth - 1 }
        if ch == ":" && depth == 0 {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon < 0 {
        return FormatSplit { expr: s, fmt: "" }
    }
    // Validate that what's after the colon looks like a format spec
    // (starts with . or digit or a format char).
    let fspec = s.substring(last_colon + 1, s.length)
    if fspec.length == 0 {
        return FormatSplit { expr: s, fmt: "" }
    }
    let first = fspec[0]
    if first == "." || p_is_digit(first) || first in ["d", "x", "X", "o", "f", "e", "E", "g", "G"] {
        FormatSplit { expr: s.substring(0, last_colon), fmt: fspec }
    } else {
        FormatSplit { expr: s, fmt: "" }
    }
}

/// Parse a sub-expression from a string. Used by template
/// desugaring — a fresh parser instance so the parent's lexer state isn't
/// disturbed, but SHARING the outer parser's store: rows the sub-parse
/// allocates live in the outer arena, so the desugared template re-parents
/// them by id — no re-ingest at the template boundary.
fn parse_template_expr(source: string, store: NodeStore) -> Result<ExprId, string> {
    mut p = parser_new(source)
    // Arenas from the caller, LineIndex from THIS fragment — `parser_new` already
    // built the latter, and the fragment's token offsets index into `source`, not
    // into the outer file. See `share_arenas_keep_lines`.
    p.store = share_arenas_keep_lines(store, p.store)
    p.parse_expression()
}

/// Append one segment to the running template concatenation: the first
/// segment starts the fold; every later one chains `prev + seg`
/// left-associatively (the shape the boxed desugar always produced),
/// allocating the Binary row over the two segment rows.
fn template_fold_store(store: NodeStore, acc: TemplateFold, node: Expr, id: ExprId) -> TemplateFold {
    if !acc.have {
        return TemplateFold { have: true, result: node, result_id: id }
    }
    let combined = Expr.Binary(acc.result_id, BinOp.Add, id)
    TemplateFold { have: true, result: combined, result_id: store.exprs.add_leaf(combined) }
}

/// The template-interpolation desugar, STORE-BASED so both parsers share ONE copy
/// (t-47hc.19). `"a ${x} b"` becomes the left-associative `"a " + string(x) + " b"`
/// concatenation, with `${x:.2f}` routing through avra_format_float/int. Errors are
/// RETURNED, not reported — the Parser wrapper set_error()s them, the grammar builder
/// st.report()s them, so each side keeps its own diagnostic channel.
export fn desugar_template_store(store: NodeStore, raw: string) -> Result<ExprId, string> {
    mut acc = TemplateFold { have: false, result: Expr.None, result_id: ExprId(0) }
    mut i = 0
    let len = raw.length
    mut text_start = 0
    while i < len {
        if i + 1 < len && raw[i] == "$" && raw[i + 1] == "{" {
            // Flush text segment before the interpolation.
            if i > text_start {
                let str_expr = Expr.String("\"${raw.substring(text_start, i)}\"")
                acc = template_fold_store(store, acc, str_expr, store.exprs.add_leaf(str_expr))
            }
            // Find matching `}` (no nesting — braces inside
            // template expressions are not supported).
            let expr_start = i + 2
            mut j = expr_start
            mut brace_depth = 0
            while j < len {
                if raw[j] == "{" { brace_depth = brace_depth + 1 }
                if raw[j] == "}" {
                    if brace_depth == 0 { break }
                    brace_depth = brace_depth - 1
                }
                j = j + 1
            }
            if j >= len {
                return .Err("unterminated template expression in string")
            }
            // Parse the content between ${ and } as an expression.
            // Simple identifiers become Expr.Ident directly. Complex
            // expressions (containing parens, dots, operators) use a
            // sub-parser. This split avoids creating a Parser struct
            // for the common case.
            let sub_source = raw.substring(expr_start, j)
            // Check for format spec: split on last ':' at depth 0
            let fmt_split = template_split_format(sub_source)
            let expr_part = fmt_split.expr
            let fmt_spec = fmt_split.fmt
            mut parsed_id = ExprId(0)
            if template_is_simple_ident(expr_part) {
                parsed_id = store.exprs.add_leaf(Expr.Ident(expr_part))
            } else {
                parsed_id = match parse_template_expr(expr_part, store) {
                    .Ok(sr) -> sr
                    .Err(_) -> {
                        return .Err("invalid expression in template: ${expr_part}")
                    }
                }
            }
            // If format spec exists, use avra_format_float/int; otherwise string().
            mut str_call = Expr.None
            mut call_id = ExprId(0)
            if fmt_spec.length > 0 {
                // Determine if float or int format.
                // Float: ends with f/e/E/g/G, or starts with . (precision without type letter).
                let last_ch = fmt_spec[fmt_spec.length - 1]
                let first_ch = fmt_spec[0]
                let is_float_fmt = last_ch in ["f", "e", "E", "g", "G"] || first_ch == "."
                let fmt_fn = if is_float_fmt { "avra_format_float" } else { "avra_format_int" }
                let spec_lit = Expr.String("\"${fmt_spec}\"")
                let callee_id = store.exprs.add_leaf(Expr.Ident(fmt_fn))
                let spec_id = store.exprs.add_leaf(spec_lit)
                str_call = Expr.Call(callee_id, [parsed_id, spec_id])
                call_id = store.exprs.add_leaf(str_call)
            } else {
                let callee_id = store.exprs.add_leaf(Expr.Ident("string"))
                str_call = Expr.Call(callee_id, [parsed_id])
                call_id = store.exprs.add_leaf(str_call)
            }
            acc = template_fold_store(store, acc, str_call, call_id)
            i = j + 1
            text_start = i
        } else {
            i = i + 1
        }
    }
    // Flush trailing text after last interpolation.
    if text_start < len {
        let str_expr = Expr.String("\"${raw.substring(text_start, len)}\"")
        acc = template_fold_store(store, acc, str_expr, store.exprs.add_leaf(str_expr))
    }
    if !acc.have {
        return .Ok(store.exprs.add_leaf(Expr.String("\"\"")))
    }
    .Ok(acc.result_id)
}

/// B1 probe: parse `source` as a single expression through the id-returning
/// chain and surface the parser's NATIVE store + root id, so spec tests can
/// run the faithfulness oracle (`store_expr_subtree_faithful`) over real
/// parses. Probe surface only — the compile path enters through
/// `parse_program_source`, whose store `parse_or_fail` serves directly.
export type NativeParseProbe = { root: ExprId, store: NodeStore, had_error: int }

/// See `NativeParseProbe`. On a parse error `root` is a dummy id — check
/// `had_error` before touching the store.
export fn parse_expression_native_probe(source: string) -> NativeParseProbe {
    mut p = parser_new(source)
    match p.parse_expression() {
        .Ok(id) -> NativeParseProbe { root: id, store: p.store, had_error: 0 }
        .Err(_) -> NativeParseProbe { root: ExprId(0), store: p.store, had_error: 1 }
    }
}

/// Map a source identifier to its keyword Tk variant. Returns
/// `Tk.Identifier` when `text` isn't a reserved word. Reserved-but-
/// inactive keywords (`async`, `await`, `bare`, ...) map to
/// `Tk.KwReserved` — the lexer rejects them at the use site so we
/// reserve the name space without committing to semantics.
export fn p_keyword_kind(text: string) -> Tk {
    // Delegates to the GENERATED exact-match byte-trie (classify_keyword,
    // parse/gen_keyword_scanner.av, compiled from keyword_rules() by emit_lex.av) —
    // now the SINGLE source of truth for the keyword set, replacing the ~59-arm
    // string-comparison ladder that used to live here (a strcmp against every keyword
    // on EVERY identifier). The production lexer (scan_identifier_token) calls
    // classify_keyword DIRECTLY on the source bytes; this string wrapper serves the
    // remaining callers that only hold the identifier text.
    classify_keyword(avra_bytes_from_string(text), 0, text.length)
}

/// Construct a Parser positioned on the first token of `source`.
/// All mode flags default to permissive; feature parsers may flip
/// them transiently for context-sensitive parses.
export fn parser_new(source: string) -> Parser {
    parser_new_with_file(source, "")
}

/// Construct a Parser with explicit source-file attribution. Stamps
/// every statement and expression row this parser allocates with `file`
/// so downstream diagnostics can cite the originating file even after bundling.
export fn parser_new_with_file(source: string, file: string) -> Parser {
    // The normal path owns a fresh store; its line index is built once here.
    parser_new_with_store(source, file, new_node_store(build_line_index(source)))
}

/// Construct a Parser over `source` that SHARES the caller's `store` instead of
/// allocating a fresh one. The `@hand` expression-leaf delegation (run_hand_expr)
/// uses this: it runs a hand parser over the ORIGINAL source at a byte offset but
/// emits into the DSL's shared arena — so rebuilding a whole-file line index per
/// leaf (parser_new_with_file's `build_line_index(source)`, then immediately
/// discarded) is pure waste. On a 787k-line whole-compiler compile that per-leaf
/// O(source) rebuild is what OOM'd the expression flip; sharing the store (whose
/// line index is already built) removes it (ps3t.6.7).
export fn parser_new_with_store(source: string, file: string, store: NodeStore) -> Parser {
    mut parser = Parser {
        source,
        source_len: source.length,
        source_bytes: avra_bytes_from_string(source),
        file,
        start: 0,
        current: 0,
        line: 1,
        column: 1,
        current_kind: Tk.Eof,
        current_lexeme: "",
        current_line: 1,
        prev_line: 1,
        current_column: 1,
        had_error: false,
        error_message: "",
        allow_struct_lit: true,
        allow_dot_postfix: true,
        cell_mode: false,
        allow_it_sugar: false,
        quote_depth: 0,
        current_start: 0,
        postfix_base: ExprId(0),
        postfix_sp_start: 0,
        gensym_seq: 0,
        bag: bag_new(),
        features: build_registry(),
        store,
        records_roots: 1,
        type_flip: avra_process_env_get("AVRA_PARSER_TYPE_FLIP") != "0",
        type_static: avra_process_env_get("AVRA_PARSER_TYPE_STATIC") != "0",
        grammar_toks: [],
        dsl_grammar: null,
        pat_flip: avra_process_env_get("AVRA_PARSER_PAT_FLIP") != "0",
        pat_static: avra_process_env_get("AVRA_PARSER_PAT_STATIC") != "0",
        dsl_pat_grammar: null,
        // Default OFF (opt-in via AVRA_PARSER_EXPR_FLIP=1) until the full-selfhost
        // byte-identity proof promotes it — unlike type/pat_flip, which are on.
        expr_flip: avra_process_env_get("AVRA_PARSER_EXPR_FLIP") == "1",
        dsl_expr_grammar: null,
        // ps3t.6.7 Step G — PROMOTED default-ON: the checked-in generated STATIC
        // parser is the production expression parser (run_static_expr), replacing
        // the hand recursive-descent expression ladder (parse_expression_hand) for
        // every VALID expression at straight-line speed. Byte-identical over the
        // full selfhost + corpus (diff-test), INCLUDING byte spans — the DSL
        // compound builders (mk_binary / fold_logical / fold_nullish / mk_assign /
        // rebind_eq) now stamp the hand parser's [start, next-token) convention
        // (expr_span_test passes under both parsers). On any DSL error it falls
        // through to parse_expression_hand, the incumbent byte-identical error path
        // (the hand parser is still the swap-in oracle). AVRA_PARSER_EXPR_STATIC=0
        // routes back to the hand ladder unconditionally.
        expr_static: avra_process_env_get("AVRA_PARSER_EXPR_STATIC") != "0",
        decl_static: avra_process_env_get("AVRA_PARSER_DECL_STATIC") != "0",
        // ps3t.6.7 Step G slice 4 — opt-in via AVRA_PARSER_STMT_FLIP=1: the
        // grammar-DSL statement parser. Default OFF until the full-selfhost
        // byte-identity proof promotes it (like type/pat_flip).
        stmt_flip: avra_process_env_get("AVRA_PARSER_STMT_FLIP") == "1",
        dsl_stmt_grammar: null,
        // ps3t.6.7 Step G slice 5.4 — PROMOTED default-ON: the grammar-DSL is now
        // the production parser. decl_flip is the OUTER flip — it drives the whole
        // TOP-LEVEL dispatch (declaration vs statement vs expr-stmt) through the
        // DSL. Each item is then routed to a @hand leaf whose shared hand-delegate
        // (ensure_hand_delegate) is a SINGLE-LEVEL, PURE-HAND oracle (its own
        // stmt_flip/decl_flip are OFF), so it parses the item — signature AND
        // nested body — by hand; bodies do NOT re-enter the DSL through the
        // delegate. Proven byte-identical over the full selfhost + corpus. Escape
        // hatch AVRA_PARSER_DECL_FLIP=0 routes back to the hand RD driver, which
        // stays the @hand leaf implementation + DSL-error fallback + test oracle.
        decl_flip: avra_process_env_get("AVRA_PARSER_DECL_FLIP") != "0",
        dsl_decl_grammar: null,
        // ps3t.6.7 slice 5a diagnostic hook — default OFF (byte-identical production).
        no_static_fallback: avra_process_env_get("AVRA_NO_STATIC_FALLBACK") == "1",
        hand_delegate: null,
    }
    parser.advance_token()
    parser
}

impl Parser {
    /// Mint a hygienic, collision-proof temp name `$<tag>$<n>` for a parser
    /// desugar (`if let` / `let-else` etc.). The `$` is the key: the lexer
    /// only admits letters / digits / `_` in identifiers, so user source can
    /// NEVER produce a `$`-bearing name — the temp cannot shadow or be
    /// shadowed by a user binding (e.g. a variable literally named
    /// `__iflet_1`). The monotonic counter keeps temps distinct from each
    /// other under nesting / macro replication.
    fn fresh(self, tag: string) -> string {
        self.gensym_seq = self.gensym_seq + 1
        gensym_name(tag, self.gensym_seq)
    }

    fn parse_file_expression(self) -> ParseResult {
        let expr = match self.parse_expression() {
            .Ok(e) -> self.expr_of(e)
            .Err(_) -> {
                return ParseResult {
                    expr: none,
                    had_error: self.had_error,
                    error_message: self.error_message,
                    bag: self.bag,
                    store: self.store,
                }
            }
        }

        if !self.check(Tk.Eof) {
            self.set_error("expected end of input")
            return ParseResult {
                expr: none,
                had_error: true,
                error_message: self.error_message,
                bag: self.bag,
                store: self.store,
            }
        }

        ParseResult {
            expr,
            had_error: self.had_error,
            error_message: self.error_message,
            bag: self.bag,
            store: self.store,
        }
    }

    fn parse_file_program(self) -> ProgramParseResult {
        let parsed = match self.parse_statement_list_ids(false) {
            .Ok(s) -> s
            .Err(_) -> return ProgramParseResult {
                ids: null,
                had_error: self.had_error,
                error_message: self.error_message,
                bag: self.bag,
                store: self.store,
            }
        }

        if !self.check(Tk.Eof) {
            self.set_error("expected end of input")
            return ProgramParseResult {
                ids: null,
                had_error: true,
                error_message: self.error_message,
                bag: self.bag,
                store: self.store,
            }
        }

        // Record the top-level rows as the native store's roots (entry
        // parses only — a shared-store sub-parse's statements merge into the
        // entry tree as children, never as program roots). Conservative
        // spans + provenance ride the store's side-tables. This is what lets
        // `parse_or_fail` serve the program from the PARSER's own arena roots.
        if self.records_roots != 0 {
            self.store.record_roots(parsed.ids, self.source_len)
        }

        ProgramParseResult {
            ids: parsed.ids,
            had_error: self.had_error,
            error_message: self.error_message,
            bag: self.bag,
            store: self.store,
        }
    }

    fn parse_statement_list_ids(self, stop_at_right_brace: int) -> Result<StmtListIds, string> {
        mut ids: List<StmtId> = []
        while true {
            if stop_at_right_brace && self.check(Tk.RightBrace) { return .Ok(StmtListIds { ids: ids }) }
            if self.check(Tk.Eof) { return .Ok(StmtListIds { ids: ids }) }
            if !stop_at_right_brace && self.check(Tk.RightBrace) {
                self.report(DiagCode.MismatchedBrace, "unexpected `}`")
                self.advance()
                continue
            }
            let stmt_line = self.current_line
            let stmt_col = self.current_column
            // Byte offset of this statement's first token. Doubles as the
            // forward-progress watermark below (the lexer stamps `current_start`
            // per token and only advances it, so equality means "consumed
            // nothing") and as the `lo` of the error node's bad-span.
            let stmt_start_byte = self.current_start
            let sid = match self.parse_declaration() {
                .Ok(s) -> s
                .Err(_) -> {
                    // Error-tolerant parse (spine §14.5): the diagnostic is
                    // already in the bag; resync to the next statement boundary
                    // and drop a `Stmt.Error` placeholder spanning the malformed
                    // text, so a broken file yields a PARTIAL tree + ALL errors
                    // (not just the first) and a walker can find the bad region
                    // via the arena's span side-table.
                    self.synchronize()
                    // Forward-progress guard: `synchronize` returns immediately
                    // when the cursor is already parked on a sync token, and a
                    // parse error can fire before consuming anything (e.g. a
                    // stray `then` at top level). If the whole iteration moved
                    // the cursor nowhere, force one token so recovery can't spin.
                    if self.current_start == stmt_start_byte && !self.check(Tk.Eof) {
                        self.advance()
                    }
                    // Span the bad region [statement start, resync point); the
                    // pos column still homes the human (line, col, file).
                    let eid = self.alloc_stmt(Stmt.Error, byte_span(stmt_start_byte, self.current_start), [])
                    self.store.stmts.record_pos(eid, SrcPos { line: stmt_line, col: stmt_col, file: self.file })
                    ids.push(eid)
                    continue
                }
            }
            // Stamp the row's position column (F3a): flipped `List<StmtId>`
            // bodies have no wrapper to carry (line, col, file), so the
            // store row is the position's home now.
            self.store.stmts.record_pos(sid, SrcPos { line: stmt_line, col: stmt_col, file: self.file })
            ids.push(sid)
        }
        .Ok(StmtListIds { ids: ids })
    }

    fn parse_declaration(self) -> Result<StmtId, string> {
        // ps3t.6.7 Step G slice 4b declaration-family swap-in — mirror
        // parse_statement's flip: delegate the whole declaration to the grammar-DSL
        // (@hand(decl_hand) for true declarations + the wrapping/dispatch, the
        // proven statement grammar for the non-declaration fall-through), threading
        // this parser's live modes + the shared @hand delegate, then resync to the
        // stop byte. A DSL error falls through to the authoritative hand parser.
        if self.decl_flip {
            let modes = self.current_modes()
            // This item's start byte — the forward-progress watermark for the error
            // path below (a zero-width errored parse must be handed back as .Err so the
            // caller advances, else the list loop re-parses the same token forever).
            let item_start = self.current_start
            mut d = self.ensure_hand_delegate()
            // The counter value the interpreter fallback restores to (see below).
            let seq0 = d.gensym_seq
            d.copy_cursor_from(self)
            // Fresh per-item diagnostic scratch on the (single-level, pure-hand)
            // delegate: any diagnostic it reports while parsing THIS item is merged
            // back into this parser's bag on the error path below, so a reset keeps
            // the merge from re-copying prior items' diagnostics.
            d.bag = bag_new()
            // ps3t.6.7 Phase 2: the STATIC generated parser (run_static_decl) when
            // decl_static, else the Grammar-tree interpreter (run_dsl_decl_at_shared).
            // Both share the token stream, modes, @hand delegate, store, and the
            // error-path handling below — they differ only in HOW they drive the
            // identical builders (straight-line generated fn vs exec_rule walk).
            // Snapshot the store so a failed STATIC parse leaves NO rows behind (its
            // partial CapVal nodes would otherwise be orphan arena rows a flat scan
            // counts) — the speculative-parse mark/truncate contract (B1).
            let store_mark = self.store.mark()
            mut dsl = if self.decl_static {
                run_static_decl(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, modes, d)
            } else {
                run_dsl_decl_at_shared(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, self.dsl_declaration_grammar(), modes, d)
            }
            // ps3t.6.7 Phase 2 — INTERPRETER FALLBACK ON ERROR. The static generated
            // parser is byte-identical to the interpreter on every VALID item (proven
            // over the full selfhost + corpus), but its CapVal fold/optional rules do
            // NOT reproduce the interpreter's exact error-RECOVERY tree (they build
            // partial nodes where exec_rule bails). Rather than chase byte-identical
            // error trees through emit, re-parse THIS item with the interpreter — the
            // incumbent byte-identical error path — on any error, resetting the
            // delegate to the item start. Errors are rare (invalid programs only), so
            // the straight-line win on the valid common case is preserved, and the
            // shared error-path handling below sees an interpreter-shaped result.
            if self.decl_static && dsl.had_error && !self.no_static_fallback {
                // Roll the store back over the abandoned static parse (no orphan rows),
                // reset the delegate to the item start, and re-parse with the
                // interpreter — the store now holds EXACTLY the interpreter's rows.
                // (ps3t.6.7 slice 5a: AVRA_NO_STATIC_FALLBACK=1 skips this re-parse so
                // the static parser's RAW error tree is observable — the oracle hook.)
                //
                // The delegate's HYGIENE COUNTER rolls back with the store. save_state
                // deliberately never snapshots gensym_seq (rolling a monotonic counter
                // back can re-mint a name a COMMITTED node carries) — but here every
                // node the abandoned attempt minted into dies with the truncate, so
                // the argument inverts: NOT restoring it makes the re-parse mint
                // `$letelse$2` where the pure-hand baseline mints `$letelse$1`, and
                // every errored item's adopted tree (and all later mints in the file)
                // drifts off the FLIP=0 oracle by however many temps the dead attempt
                // issued. Caught by the malformed-binding recovery corpus (the
                // non-diverging `let … else`, whose desugar is the first gensym user
                // on an ERROR path).
                d.gensym_seq = seq0
                self.store.truncate_to_mark(store_mark)
                d.copy_cursor_from(self)
                d.bag = bag_new()
                dsl = run_dsl_decl_at_shared(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, self.dsl_declaration_grammar(), modes, d)
            }
            if !dsl.had_error {
                d.resync_to_stop_byte(dsl.stop_byte)
                self.copy_cursor_from(d)
                return .Ok(dsl.stmt)
            }
            // Error path (ps3t.6.7 Slice 5.4). The delegate reported the diagnostic
            // into its own (fresh) bag; merge it into THIS parser's bag — the diag
            // home parse_file_program returns and codegen gates on — and mark
            // had_error, so the error is surfaced WITHOUT a re-parse (re-parsing is
            // the orphan-Error-row + cascade source the full-program flip hit).
            // A GRAMMAR-NATIVE diagnostic lives on the DSL RESULT, not on the
            // delegate's bag: the generated parser (and the interpreter) report into
            // their own PState, and `dsl.diag` carries the first message out. Merging
            // only `d.bag` therefore DROPS it, leaving had_error set with no
            // diagnostic — which is precisely why every leaf still needed an
            // `@hand(*_edge)` sibling whose only job was to own the message. Surface
            // it whenever the delegate itself reported nothing, so a native rule can
            // carry its own diagnostics. (The span is this parser's current position
            // rather than the exact mismatch byte; the F-code and message match the
            // hand parser, which is what the recovery oracle compares.)
            // The CODE comes from the rule that reported (t-47hc.5), not from a single
            // default for every grammar diagnostic. `SyntaxError` is right for the
            // declaration keywords' own messages, but the expression alternation's
            // no-match is the hand parser's F0040 `expected expression` — surfacing THAT
            // as F0001 was the single divergence keeping `@hand(primary_base)` alive.
            // An uncoded diagnostic keeps the previous default, so every rule that has
            // not opted in behaves exactly as before.
            if d.bag.diagnostics.length == 0 && dsl.diag != "" {
                if dsl.diag_code == "F0040" {
                    self.report(DiagCode.ExpectedExpression, dsl.diag)
                } else {
                    self.set_error(dsl.diag)
                }
            }
            self.bag = bag_merge(self.bag, d.bag)
            self.had_error = true
            // Distinguish a WHOLE-ITEM failure from an already-recovered BODY error.
            // A bare `Stmt.Error` means the delegate returned .Err on the item itself
            // (a malformed top-level declaration / statement) — hand it back as .Err
            // so the caller's list-parser does the authoritative synchronize +
            // spanned-Error recovery, byte-identical to the hand-only path. Adopting
            // the delegate's cursor first keeps that synchronize starting where the
            // hand parser would. A non-Error node (a fn / impl / block whose nested
            // statement list ALREADY recovered + spanned the bad region internally,
            // the pure-hand delegate being the oracle) is ADOPTED verbatim: it is
            // already byte-identical to hand, and re-parsing it would duplicate the
            // whole subtree as orphan Error rows.
            match self.stmt_of(dsl.stmt) {
                .Error -> {
                    // Adopting the DELEGATE's cursor is right when the delegate did
                    // the parsing — its synchronize then starts where the hand parser
                    // would. But on a GRAMMAR-NATIVE failure the delegate never moved,
                    // so `d` still sits at the item start and the caller resyncs from
                    // before the construct instead of from the token that failed. The
                    // DSL's own stop byte is the equivalent landing point; walk the
                    // delegate there first so the cursor means the same thing on both
                    // paths. (Guarded on forward progress, so a zero-width failure
                    // still hands back untouched and the caller's progress guard fires.)
                    if d.bag.diagnostics.length == 0 && dsl.stop_byte > item_start {
                        d.resync_to_stop_byte(dsl.stop_byte)
                    }
                    self.copy_cursor_from(d)
                    return .Err("parse error")
                }
                _ -> {
                    // No forward progress on an errored parse — hand back as .Err so
                    // the caller's list-parser forward-progress guard advances one
                    // token. The interpreter's expr_stmt alternation-failure yields a
                    // bare Stmt.Error (caught above), but the STATIC parser's
                    // parse_expr_stmt unconditionally wraps a FAILED expression as
                    // Stmt.Expr(Error) — a zero-width error node (a stray top-level
                    // non-keyword like `then`) that the shape check misses. Without
                    // this, parse_statement_list_ids re-parses the same token forever.
                    if dsl.stop_byte <= item_start {
                        self.copy_cursor_from(d)
                        return .Err("parse error")
                    }
                    d.resync_to_stop_byte(dsl.stop_byte)
                    self.copy_cursor_from(d)
                    return .Ok(dsl.stmt)
                }
            }
        }
        self.parse_declaration_hand()
    }

    /// The hand-written declaration dispatcher: the swap-in oracle, and the
    /// fallback when the declaration flip is off or errors. (Was the body of
    /// parse_declaration.)
    fn parse_declaration_hand(self) -> Result<StmtId, string> {
        // Reserved future keywords produce an error immediately.
        if self.check(Tk.KwReserved) {
            self.reject_reserved_keyword("yet")
            return .Err("parse error")
        }

        // Doc comments: /// and //! become @doc annotations.
        if self.check(Tk.DocComment) {
            mut doc_text = self.current_lexeme
            self.advance()
            // Collect consecutive /// lines into one doc string
            while self.check(Tk.DocComment) {
                doc_text = doc_text + "\n" + self.current_lexeme
                self.advance()
            }
            let inner_l = self.current_line
            let inner_c = self.current_column
            let inner_id = self.parse_declaration()?
            let doc_arg_id = self.alloc_leaf(Expr.String("\"${doc_text}\""))
            let doc_annots: List<Annotation> = [Annotation { name: "doc", arg_ids: [doc_arg_id] }]
            self.store.stmts.record_pos(inner_id, SrcPos { line: inner_l, col: inner_c, file: self.file })
            return .Ok(self.alloc_stmt_leaf(Stmt.Annotated(doc_annots, inner_id)))
        }
        if self.check(Tk.ModDocComment) {
            mut doc_text = self.current_lexeme
            self.advance()
            while self.check(Tk.ModDocComment) {
                doc_text = doc_text + "\n" + self.current_lexeme
                self.advance()
            }
            // Module docs don't wrap a declaration — store as a NoOp with annotation
            let mdoc_arg_id = self.alloc_leaf(Expr.String("\"${doc_text}\""))
            let mdoc_annots: List<Annotation> = [Annotation { name: "module_doc", arg_ids: [mdoc_arg_id] }]
            let noop_id = self.alloc_stmt_leaf(Stmt.NoOp)
            self.store.stmts.record_pos(noop_id, SrcPos { line: self.current_line, col: self.current_column, file: self.file })
            return .Ok(self.alloc_stmt_leaf(Stmt.Annotated(mdoc_annots, noop_id)))
        }

        // Annotations: `@name` or `@name(args)` before a declaration.
        // A `@pkg::mod::name` (qualified expression — e.g. a re-parsed
        // @comptime body's tail-return of a resolved name) is NOT an
        // annotation: fall through to statement/expression parsing.
        if self.check(Tk.At) && !self.peek_after_at_is_qualified() {
            let annotations = self.parse_annotations()
            let inner_l = self.current_line
            let inner_c = self.current_column
            let inner_id = self.parse_declaration()?
            self.store.stmts.record_pos(inner_id, SrcPos { line: inner_l, col: inner_c, file: self.file })
            return .Ok(self.alloc_stmt_leaf(Stmt.Annotated(annotations, inner_id)))
        }

        // `export` wraps the inner declaration in an @export annotation
        // so the module system's name resolution pass can enforce visibility.
        // Only fn, type, enum, trait, and extern are exportable — no stacking.
        if self.check(Tk.KwExport) {
            self.advance()
            let inner_l = self.current_line
            let inner_c = self.current_column
            let export_handler_raw = lookup_decl_parser(self.features, tk_keyword_str(self.current_kind))
            if export_handler_raw == none {
                self.set_error("expected declaration after `export`")
                return .Err("expected declaration after `export`")
            }
            let handler: fn(Parser) -> Result<StmtId, string> = export_handler_raw!
            let inner_res: Result<StmtId, string> = handler(self)
            let inner_id = inner_res?
            let no_arg_ids: List<ExprId> = []
            let exp_annots: List<Annotation> = [Annotation { name: "export", arg_ids: no_arg_ids }]
            self.store.stmts.record_pos(inner_id, SrcPos { line: inner_l, col: inner_c, file: self.file })
            return .Ok(self.alloc_stmt_leaf(Stmt.Annotated(exp_annots, inner_id)))
        }

        let decl_raw = lookup_decl_parser(self.features, tk_keyword_str(self.current_kind))
        if decl_raw != null {
            let handler: fn(Parser) -> Result<StmtId, string> = decl_raw!
            return handler(self)
        }

        // Component block instantiation: `comp_name instance_name { ... }`
        // Recognized when current identifier is a registered component name
        // AND the next non-whitespace char is an identifier start (instance name).
        // This prevents false positives like `command {` in match expressions.
        if self.check(Tk.Identifier) && self.peek_after_ident_is_ident_not_keyword() {
            let comp_raw = lookup_stmt_parser(self.features, self.current_lexeme)
            if comp_raw != null {
                let handler: fn(Parser) -> Result<StmtId, string> = comp_raw!
                return handler(self)
            }
        }

        self.parse_statement()
    }

    // Parse parallel block: parallel { stmt1; stmt2 }
    // Each statement runs in its own thread, all joined at block end.

    // Parse one or more annotations: @name or @name(arg1, arg2)
    fn parse_annotations(self) -> List<Annotation> {
        mut out: List<Annotation> = []
        while self.check(Tk.At) {
            self.advance()  // consume @
            let name = self.current_lexeme
            self.advance()  // consume name
            // Optional argument list — the ids-returning parse so the
            // annotation's dual arg_ids carry the args' arena rows.
            mut ids: List<ExprId> = []
            if self.check(Tk.LeftParen) {
                self.advance()  // consume (
                match self.parse_arg_list_ids() {
                    .Ok(v) -> { ids = v.ids }
                    .Err(_) -> {}
                }
                if self.check(Tk.RightParen) { self.advance() }
            }
            out.push(Annotation { name, arg_ids: ids })
        }
        out
    }

    // Parse a typed table literal:
    //   table<RowStruct> { col1 | col2\n v1a | v1b\n v2a | v2b }
    //   table          { col1 | col2\n v1a | v1b\n v2a | v2b }   (row type inferred)
    // The header row names struct fields; each data row becomes a
    // `StructLit(RowStruct, { col1: v1a, col2: v1b })`. The whole table
    // desugars to a `ListLit` of those StructLits — i.e. `List<RowStruct>`.
    // When the row type is omitted it is left empty here and resolved
    // from context (let/return/arg annotation) by the typechecker; an
    // unresolved row type is a compile error (no weak List<Map> fallback).
    fn parse_table_literal(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        // Optional `<RowStruct>` row-type ascription.
        mut row_type = ""
        if self.check(Tk.Less) {
            self.advance()  // consume `<`
            let rt = self.consume_identifier("expected row struct name after `table<`")?
            row_type = rt
            if !self.consume(Tk.Greater, "expected `>` after table row type") { return .Err("parse error") }
        }
        if !self.consume(Tk.LeftBrace, "expected `{` to open table") { return .Err("parse error") }
        // Parse header row: field-name identifiers separated by `|`.
        mut col_names: List<string> = []
        let header_line = self.current_line
        while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) && self.current_line == header_line {
            if self.check(Tk.Identifier) {
                col_names.push(self.current_lexeme)
                self.advance()
                if self.check(Tk.Pipe) {
                    self.advance()
                }
            } else {
                break
            }
        }
        let header_count = col_names.length
        if header_count == 0 {
            if !self.consume(Tk.RightBrace, "expected `}` to close table") { return .Err("parse error") }
            let empty: List<ExprId> = []
            return .Ok(self.alloc_at(Expr.ListLit(empty), sp_start))
        }
        // Reject duplicate column names — they would silently collide on the
        // same struct field.
        mut di = 0
        while di < header_count {
            mut dj = di + 1
            while dj < header_count {
                if col_names[di] == col_names[dj] {
                    self.set_error("duplicate table column `${col_names[di]}`")
                    return .Err("parse error")
                }
                dj = dj + 1
            }
            di = di + 1
        }
        // Parse data rows in source order; each row is a StructLit whose
        // field names come from the header and whose values come from
        // the cells (left-to-right, one per column). A row occupies a
        // single source line; its cell count must match the header width.
        mut row_ids: List<ExprId> = []
        // Bound each cell expression to its row's line so a value at the end
        // of one row doesn't merge with a `-`/`.Variant` starting the next.
        // Saved/restored to keep nested tables (a table cell) well-behaved.
        let saved_cell_mode = self.cell_mode
        self.cell_mode = true
        while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) {
            let row_line = self.current_line
            mut cell_ids: List<ExprId> = []
            while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) && self.current_line == row_line {
                // parse_binary_pratt(12) starts at the bitwise-XOR level, so it
                // stops before `|` (lbp 10) — the column separator is never
                // swallowed as a bitwise-or operand.
                let val_id = self.parse_binary_pratt(12)?
                cell_ids.push(val_id)
                if self.check(Tk.Pipe) {
                    self.advance()
                }
            }
            if cell_ids.length != header_count {
                self.cell_mode = saved_cell_mode
                self.set_error("table row has ${string(cell_ids.length)} cell(s) but the header declares ${string(header_count)} column(s)")
                return .Err("parse error")
            }
            mut inits: List<FieldInit> = []
            mut ci = 0
            while ci < header_count {
                inits.push(FieldInit { name: col_names[ci], value_id: cell_ids[ci] })
                ci = ci + 1
            }
            // Row StructLit: a leaf — B-final F4 FieldInit values are opaque ids
            // (carried in `inits[i].value_id`, not walked), like Block/ListLit.
            let row_node = Expr.StructLit(row_type, inits)
            row_ids.push(self.alloc_leaf(row_node))
        }
        self.cell_mode = saved_cell_mode
        if !self.consume(Tk.RightBrace, "expected `}` to close table") {
            return .Err("parse error")
        }
        .Ok(self.alloc_at(Expr.ListLit(row_ids), sp_start))
    }

    // Module parser (parse_module_declaration, parse_use_declaration)
    // lives in features/modules/parser.av.

    // Feature-specific parsers live in features/*/parser.av.
    // They extend Parser via `impl Parser { ... }` blocks.

    /// Lazily build (once per file) the reusable @hand delegate the statement /
    /// expression flips share: a parser over THIS parser's source + store, with
    /// root-recording and every flip/static toggle forced OFF so the @hand leaves
    /// parse by hand (the byte-identical oracle) and never re-enter a flip. Adding
    /// a new flip flag updates this ONE site — the two-site drift CodeRabbit
    /// flagged on #899 (parse_statement had to be hand-edited alongside
    /// parse_expression to force stmt_flip off).
    /// Snapshot this parser's live mode flags for a flip hand-off (ps3t.6.7).
    /// The single home for the `ExprModes` construction the three flip sites
    /// (parse_declaration / parse_statement / parse_expression) thread to the
    /// grammar-DSL runner — so a new `ExprModes` field can't drift across copies
    /// (the two-site drift #899 fixed, now three-site-proof).
    fn current_modes(self) -> ExprModes {
        ExprModes {
            allow_struct_lit: self.allow_struct_lit,
            allow_dot_postfix: self.allow_dot_postfix,
            allow_it_sugar: self.allow_it_sugar,
            quote_depth: self.quote_depth,
            cell_mode: self.cell_mode,
        }
    }

    fn ensure_hand_delegate(self) -> Parser {
        if self.hand_delegate == null {
            mut d = parser_new_with_store(self.source, self.file, self.store)
            d.records_roots = 0
            // Share the outer parser's REGISTRY and TOKEN STREAM with the delegate
            // (ps3t.6.7 Slice 5.1). Registry: the component DSL registers names
            // during the parse (register_component_name / raw-body components); a
            // full-program flip parses a component's DEFINITION and its
            // INSTANTIATIONS across the delegate chain, so they MUST see one
            // registry or the instantiation isn't recognised (→ its raw body is
            // mis-parsed as statements). Tokens: every delegate over the same
            // source lexes identical tokens (lex_real is a pure fn of source), so
            // sharing the one array turns the delegate chain into cursor-holders
            // over ONE token stream — no per-level re-lex (the redundant-
            // tokenization cost 0454a086 flagged), the single-pipeline shape.
            d.features = self.features
            d.grammar_toks = self.grammar_tokens()
            // Share the outer parser's source byte view too — the delegate lexes
            // the SAME source, so re-materialising it (parser_new_with_store already
            // ran avra_bytes_from_string on it) would duplicate the whole-source
            // buffer for nothing, exactly the per-file waste `features`/`grammar_toks`
            // sharing above avoids. decl_flip is default-ON, so this delegate is real.
            d.source_bytes = self.source_bytes
            // ps3t.6.7 Slice 5.4 (promoted production flip): the delegate does NOT
            // flip its bodies — every flip toggle is OFF, so it is a SINGLE-LEVEL,
            // PURE-HAND parser. When the outer flip routes a top-level item to a
            // @hand leaf (run_hand_stmt → d.parse_declaration_hand), `d` parses the
            // WHOLE item — signature AND nested body — by hand, exactly as the
            // hand-only oracle would. This is what makes the production flip
            // byte-identical on EVERY path, including error recovery: a single
            // delegate means a SINGLE diagnostic bag to merge back (parse_declaration's
            // error path), and no re-parse cascade — the Slice 5.1 full-program flip
            // (delegate flips its bodies) left orphan `Stmt.Error` rows on invalid
            // input because each enclosing level independently discarded + re-parsed
            // the malformed subtree (measured: 18 orphan Error nodes for one 2-deep
            // nested error). The DSL still drives the whole TOP-LEVEL dispatch
            // (declaration vs statement vs expr-stmt) — retiring the hand RD driver's
            // dispatch loop — while the @hand leaves own the intra-item parse. The
            // full-program flip stays proven (diff-test) for the eventual static
            // generated parser, which needs no delegate/interpreter at all.
            d.stmt_flip = false
            d.decl_flip = false
            d.expr_flip = false
            d.expr_static = false
            d.decl_static = false
            d.type_static = false
            d.pat_static = false
            // The delegate is the pure-hand differential ORACLE for @hand leaves —
            // disable pat_flip too so nested match patterns parse via parse_pattern_or_hand
            // directly, not the Grammar-tree interpreter (byte-identical, but the interpreter
            // on the oracle path is pointless: on failure it falls to the same hand parser).
            // Matches expr_flip/decl_flip/stmt_flip already being off here.
            d.pat_flip = false
            self.hand_delegate = d
        }
        self.hand_delegate!
    }

    fn parse_statement(self) -> Result<StmtId, string> {
        // ps3t.6.7 Step G slice 4 statement-family swap-in — mirror
        // parse_expression's flip: delegate the whole statement to the grammar-DSL
        // over the lex-once tokens at the current byte, threading this parser's
        // live modes + a reusable @hand delegate (SYNCED to this parser's cursor +
        // line first, its end state adopted after), then resync to the stop byte.
        // A DSL error falls through to the authoritative hand parser.
        if self.stmt_flip {
            let modes = self.current_modes()
            // One reusable @hand delegate per file (see ensure_hand_delegate),
            // SYNCED to this parser's cursor+line before the parse, its end state
            // adopted after.
            let d = self.ensure_hand_delegate()
            d.copy_cursor_from(self)
            let dsl = run_dsl_stmt_at_shared(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, self.dsl_statement_grammar(), modes, d)
            if !dsl.had_error {
                // Forward-advance the delegate to the statement's true end (past any
                // trailing structural tokens the DSL itself consumed), then adopt
                // its cursor+line so this parser continues from the statement's end
                // with the same line the hand parser would have.
                d.resync_to_stop_byte(dsl.stop_byte)
                self.copy_cursor_from(d)
                return .Ok(dsl.stmt)
            }
            // DSL parse error → fall through to the authoritative hand parser.
        }
        self.parse_statement_hand()
    }

    /// The hand-written statement dispatcher: the swap-in oracle, and the
    /// fallback when the statement flip is off or errors. (Was the body of
    /// parse_statement.)
    fn parse_statement_hand(self) -> Result<StmtId, string> {
        // qsqm: a bare map literal at statement position — a function's
        // implicit-return `{"k": v}` — must not be swallowed as a block.
        // is_stmt_map_literal fires only on a string-keyed `{ "str": ... }`; a
        // real block (`{ let x = ... }`) AND a bare `{}` (which stays a block,
        // since the compiler's own source uses `{}` block statements) both parse
        // as blocks. A map falls through to the expression path below
        // (parse_expression → parse_map_literal).
        if self.check(Tk.LeftBrace) && !self.is_stmt_map_literal() {
            self.advance()
            let body = self.parse_statement_list_ids(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after block") {
                return .Err("parse error")
            }
            return .Ok(self.alloc_stmt_leaf(Stmt.Block(body.ids)))
        }

        if self.check(Tk.KwBreak) {
            self.advance()
            return .Ok(self.alloc_stmt_leaf(Stmt.Break))
        }

        if self.check(Tk.KwContinue) {
            self.advance()
            return .Ok(self.alloc_stmt_leaf(Stmt.Continue))
        }

        let stmt_raw = lookup_stmt_parser(self.features, tk_keyword_str(self.current_kind))
        if stmt_raw != null {
            let handler: fn(Parser) -> Result<StmtId, string> = stmt_raw!
            return handler(self)
        }

        let eid = self.parse_expression()?
        .Ok(self.alloc_stmt_leaf(Stmt.Expr(eid)))
    }

    /// B1: the expression chain flows typed ids end-to-end; the parsed
    /// expression's whole subtree is in the arena and this returns its root id.
    fn parse_expression(self) -> Result<ExprId, string> {
        // ps3t.6.7 expression-family swap-in — mirror parse_type_expr's flip: when
        // expr_flip, delegate the whole expression to the grammar-DSL over the
        // lex-once tokens at the current byte, threading this parser's live modes
        // (so an `@hand(hand_unary)` in an `if Foo { … }` header sees
        // allow_struct_lit=false), then resync the token cursor to the stop byte.
        // A DSL error falls through to the authoritative hand parser.
        if self.expr_flip || self.expr_static {
            let modes = self.current_modes()
            // One reusable @hand delegate per file (see ensure_hand_delegate).
            // SYNC it to THIS parser's exact cursor + line state so it parses the
            // expression's leaves carrying the accumulated line (incl. the
            // is_map_literal nudges the hand parser leaves) — then ADOPT its end
            // state so this parser continues from the expression's end with the
            // same line the hand parser would have. This reproduces the hand
            // parser's line accounting byte-for-byte across the split parse.
            let d = self.ensure_hand_delegate()
            d.copy_cursor_from(self)
            // ps3t.6.7 Step G: the STATIC generated parser (run_static_expr) when
            // expr_static, else the Grammar-tree interpreter (run_dsl_expr_at_shared).
            // Both share the token stream, modes, @hand delegate, and resync below —
            // they differ only in HOW they drive the identical builders.
            let dsl = if self.expr_static {
                run_static_expr(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, modes, d)
            } else {
                run_dsl_expr_at_shared(self.grammar_tokens(), self.current_start, self.source, self.file, self.store, self.dsl_expression_grammar(), modes, d)
            }
            if !dsl.had_error {
                // The delegate stops at the last @hand LEAF's end; the DSL itself
                // consumed the trailing STRUCTURAL tokens after it (the `]` of `in
                // [...]`, a `)`, etc.), so the delegate lags stop_byte. Forward-
                // advance it to stop_byte (lexing those tokens — they are not blocks,
                // so they add their newlines but NO is_map_literal nudge), so its
                // position AND line match the expression's true end, then adopt.
                d.resync_to_stop_byte(dsl.stop_byte)
                self.copy_cursor_from(d)
                return .Ok(dsl.expr)
            }
            // DSL parse error → fall through to the authoritative hand parser.
        }
        self.parse_expression_hand()
    }

    /// The hand-written expression parser: the swap-in oracle, and the fallback
    /// when the DSL flip is off or errors. (Was the body of parse_expression.)
    fn parse_expression_hand(self) -> Result<ExprId, string> {
        self.parse_assignment()
    }

    /// The DSL expression grammar (the per-family view with the full ladder),
    /// built at most once per parser — the expr sibling of dsl_type_grammar.
    /// (Named distinctly from the `dsl_expr_grammar` field it caches.)
    fn dsl_expression_grammar(self) -> Grammar {
        if self.dsl_expr_grammar == null {
            self.dsl_expr_grammar = avra_expr_grammar()
        }
        self.dsl_expr_grammar ?? avra_expr_grammar()
    }

    /// The DSL statement grammar (the production dispatch: break/continue +
    /// @hand(stmt_hand) + expr_stmt over the composed expression grammar), built
    /// at most once per parser — the statement sibling of dsl_expression_grammar.
    fn dsl_statement_grammar(self) -> Grammar {
        if self.dsl_stmt_grammar == null {
            self.dsl_stmt_grammar = avra_stmt_flip_grammar()
        }
        self.dsl_stmt_grammar ?? avra_stmt_flip_grammar()
    }

    /// The DSL declaration grammar (`declaration = @hand(decl_hand) | statement`
    /// over the composed statement + expression grammars), built at most once per
    /// parser — the declaration sibling of dsl_statement_grammar.
    fn dsl_declaration_grammar(self) -> Grammar {
        if self.dsl_decl_grammar == null {
            self.dsl_decl_grammar = avra_decl_flip_grammar()
        }
        self.dsl_decl_grammar ?? avra_decl_flip_grammar()
    }

    /// Boxed readback for callers not yet converted to ids (statements,
    /// feature parsers): an O(1) row read, NOT a subtree walk — the boxed
    /// node stored in the arena row IS the built node. Each use of this
    /// wrapper disappears when its caller converts to ids.
    fn parse_expression_boxed(self) -> Result<Expr, string> {
        let id = self.parse_expression()?
        .Ok(self.store.exprs.get(id))
    }

    fn parse_assignment(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let left = self.parse_pipe()?

        if !self.check(Tk.Equal) {
            return .Ok(left)
        }

        self.advance()
        let value = self.parse_assignment()?

        // Retarget: the parsed LHS shell is discarded (an orphan row per
        // design Decision 4); its CHILDREN are re-parented by id — the
        // FieldAccess's object id comes off the shell's edge list, no re-walk.
        match self.expr_of(left) {
            // Flipped payloads are inline ids (F3b) — the node IS its own edge,
            // so these build as leaves (no recorded child edge), matching F3a's
            // alloc_stmt_leaf and the walker's scalar view of id fields.
            .Ident(name) -> .Ok(self.alloc_at(Expr.Assign(name, value), sp_start))
            .FieldAccess(obj, field) -> .Ok(self.alloc_at(Expr.FieldAssign(obj, field, value), sp_start))
            _ -> {
                self.set_error("invalid assignment target")
                .Err("invalid assignment target")
            }
        }
    }

    fn parse_pipe(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let left = self.parse_null_coalesce()?

        mut eid = left
        while self.check(Tk.PipeGt) {
            self.advance()
            // Enable `it` sugar in pipe RHS — `xs |> filter(it > 2)` (spec 28.7+28.8)
            let saved_it = self.allow_it_sugar
            self.allow_it_sugar = true
            let rhs = self.parse_or()?
            self.allow_it_sugar = saved_it
            // Desugar: `a |> f` → `f(a)`, `a |> f(b)` → `f(a, b)`
            // If any arg is `_`, replace it with the piped value (spec Axis 28.7).
            // The RHS Call shell is discarded; its callee + surviving arg ids
            // are read straight off the flipped Call's id fields (post-F3b a
            // Call row is a leaf — the ids ARE the structure, no edge list),
            // and the piped LHS id takes each placeholder's slot.
            eid = match self.expr_of(rhs) {
                .Call(callee, args) -> {
                    if pipe_args_has_placeholder(self.store, args) {
                        self.alloc_at(Expr.Call(callee, pipe_replace_placeholder(self.store, args, eid)), sp_start)
                    } else {
                        mut prepended: List<ExprId> = [eid]
                        for a in args { prepended.push(a) }
                        self.alloc_at(Expr.Call(callee, prepended), sp_start)
                    }
                }
                _ -> {
                    let one: List<ExprId> = [eid]
                    self.alloc_at(Expr.Call(rhs, one), sp_start)
                }
            }
        }

        .Ok(eid)
    }

}

/// True iff the pipe RHS arg list contains an `_` placeholder.
/// `x |> f(_, 2)` uses the placeholder to position the LHS at a
/// specific arg slot; without one, the LHS becomes the first arg.
fn pipe_args_has_placeholder(store: NodeStore, args: List<ExprId>) -> bool {
    mut i = 0
    while i < args.length {
        match store.exprs.get(args[i]) {
            .Ident(n) -> if n == "_" { return true }
            _ -> {}
        }
        i = i + 1
    }
    false
}

/// Replace the first `_` placeholder in `args` with the pipe's LHS
/// expression. Counterpart to `pipe_args_has_placeholder`.
fn pipe_replace_placeholder(store: NodeStore, args: List<ExprId>, replacement: ExprId) -> List<ExprId> {
    mut out: List<ExprId> = []
    mut i = 0
    while i < args.length {
        let id = args[i]
        let is_placeholder = match store.exprs.get(id) {
            .Ident(n) -> n == "_"
            _ -> false
        }
        if is_placeholder { out.push(replacement) } else { out.push(id) }
        i = i + 1
    }
    out
}

impl Parser {
    fn parse_null_coalesce(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let left = self.parse_or()?

        mut eid = left
        while self.check(Tk.QuestionQuestion) {
            self.advance()
            let right = self.parse_or()?
            eid = self.alloc_at(Expr.NullCoalesce(eid, right), sp_start)
        }

        .Ok(eid)
    }

    fn parse_or(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let left = self.parse_and()?

        mut eid = left
        while self.current_kind in [Tk.PipePipe, Tk.KwOr] {
            self.advance()
            let right = self.parse_and()?
            eid = self.alloc_at(Expr.Logical(eid, LogicOp.Or, right), sp_start)
        }

        .Ok(eid)
    }

    fn parse_and(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let left = self.parse_equality()?

        mut eid = left
        while self.current_kind in [Tk.AmpAmp, Tk.KwAnd] {
            self.advance()
            let right = self.parse_equality()?
            eid = self.alloc_at(Expr.Logical(eid, LogicOp.And, right), sp_start)
        }

        .Ok(eid)
    }

    fn parse_equality(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let left = self.parse_binary_pratt(10)?

        if self.check(Tk.KwIs) {
            self.advance()
            if !self.consume(Tk.Dot, "expected `.Variant` after `is`") {
                return .Err("parse error")
            }
            let vname = self.consume_identifier("expected variant name after `is .`")?
            return .Ok(self.alloc_at(Expr.IsCheck(left, vname), sp_start))
        }

        if self.check(Tk.KwIn) {
            self.advance()
            if self.check(Tk.LeftBracket) {
                // List membership: x in [a, b, c]
                self.advance()
                mut items: List<ExprId> = []
                if !self.check(Tk.RightBracket) {
                    let parsed = self.parse_arg_list_ids()?
                    items = parsed.ids
                }
                if !self.consume(Tk.RightBracket, "expected `]` after `in [...]`") {
                    return .Err("parse error")
                }
                return .Ok(self.alloc_at(Expr.InCheck(left, items), sp_start))
            }
            // Range membership: x in start..end → x >= start && x <= end.
            // `left` is SHARED by both comparisons — in the boxed tree the same
            // node value appears twice, and in the arena the same row id backs
            // both edges (a deliberate DAG; the canonical ingest would copy).
            let start = self.parse_binary_pratt(10)?
            if !self.consume(Tk.DotDot, "expected `..` in range expression after `in`") {
                return .Err("parse error")
            }
            let end = self.parse_binary_pratt(10)?
            let ge = self.alloc_at(Expr.Binary(left, BinOp.Ge, start), sp_start)
            let le = self.alloc_at(Expr.Binary(left, BinOp.Le, end), sp_start)
            return .Ok(self.alloc_at(Expr.Logical(ge, LogicOp.And, le), sp_start))
        }

        mut eid = left
        while self.current_kind in [Tk.EqualEqual, Tk.BangEqual] {
            let op = if self.check(Tk.EqualEqual) { BinOp.Eq } else { BinOp.Ne }
            self.advance()
            let right = self.parse_binary_pratt(10)?
            eid = self.alloc_at(Expr.Binary(eid, op, right), sp_start)
        }

        .Ok(eid)
    }

    // The seven uniform binary levels (bitwise-or → factor) that used to live
    // here as separate recursive-descent methods (parse_bitwise_or …
    // parse_factor) are now the single `parse_binary_pratt` loop below — same
    // trees, ~7x fewer frames per leaf. See its comment for the equivalence.

    // ── The uniform binary-operator ladder as ONE Pratt loop (ps3t.6.7 / Step G) ──
    //
    // The seven hand-written RD levels bitwise-or → factor (| ^ & < <= > >=
    // << >> + - * / %) are ALL uniform: left-associative, building
    // `Expr.Binary(l, op, r)` with the span of the leftmost operand. That is
    // exactly a Pratt (precedence-climbing) parser — a single loop over a
    // binding-power TABLE — which replaces the seven-frame descent with one
    // frame per leaf. `min_bp` selects the entry precedence, so this reproduces
    // BOTH RD entry points byte-identically: parse_bitwise_or ⇒ min_bp 10 (folds
    // every operator here), parse_bitwise_xor ⇒ min_bp 12 (the table-cell caller,
    // which must stop before the `|` column separator — 12 > lbp(`|`)=10).
    //
    // Byte-identity with the RD ladder, point by point: (1) the fold span is the
    // leftmost operand — `sp_start` captured once, matching each RD level's
    // constant per-call sp_start; (2) left-associativity via rbp = lbp + 1, so a
    // same-level operator on the right is left for the enclosing fold; (3) the
    // leaf is the same `parse_unary`; (4) the `+`/`-` cell_mode line guard
    // (parse_term) is reproduced. The `is`/`in`/`==` equality forms, the logical
    // (`&&`/`||`) and `??` levels, assignment and pipe stay in their hand rules
    // above this — only the uniform middle collapses.
    fn parse_binary_pratt(self, min_bp: int) -> Result<ExprId, string> {
        let sp_start = self.current_start
        mut lhs = self.parse_unary()?
        while true {
            let lbp = self.binary_lbp(self.current_kind)
            if lbp == 0 || lbp < min_bp { break }
            // Table-cell mode: a `+`/`-` opening the NEXT source line is the next
            // row's value, not a continuation of this cell (parse_term's guard).
            if (self.current_kind == Tk.Plus || self.current_kind == Tk.Minus)
                && self.cell_mode && self.current_line != self.prev_line { break }
            let op = self.binary_op(self.current_kind)
            self.advance()
            let rhs = self.parse_binary_pratt(lbp + 1)?
            lhs = self.alloc_at(Expr.Binary(lhs, op, rhs), sp_start)
        }
        .Ok(lhs)
    }

    // The left binding power of a uniform-ladder binary operator (0 = not one,
    // ends the Pratt loop). Precedence rises with the number, matching the RD
    // nesting depth: bitor(10) < bitxor(12) < bitand(14) < comparison(16) <
    // shift(18) < term(20) < factor(22). Even steps leave the odd rbp = lbp+1
    // for left-associativity.
    fn binary_lbp(self, k: Tk) -> int {
        match k {
            .Pipe         -> 10
            .Caret        -> 12
            .Amp          -> 14
            .Less         -> 16
            .LessEqual    -> 16
            .Greater      -> 16
            .GreaterEqual -> 16
            .Shl          -> 18
            .Shr          -> 18
            .Plus         -> 20
            .Minus        -> 20
            .Star         -> 22
            .Slash        -> 22
            .Percent      -> 22
            _             -> 0
        }
    }

    // The BinOp a uniform-ladder operator token builds — the exact mapping the
    // RD levels used (parse_bitwise_* / parse_comparison / parse_shift /
    // parse_term / parse_factor). Only ever called on a token whose binary_lbp
    // is non-zero; the `_` tail is Mod (`%`), the last factor operator.
    fn binary_op(self, k: Tk) -> BinOp {
        match k {
            .Pipe         -> BinOp.BitOr
            .Caret        -> BinOp.BitXor
            .Amp          -> BinOp.BitAnd
            .Less         -> BinOp.Lt
            .LessEqual    -> BinOp.Le
            .Greater      -> BinOp.Gt
            .GreaterEqual -> BinOp.Ge
            .Shl          -> BinOp.Shl
            .Shr          -> BinOp.Shr
            .Plus         -> BinOp.Add
            .Minus        -> BinOp.Sub
            .Star         -> BinOp.Mul
            .Slash        -> BinOp.Div
            _             -> BinOp.Mod
        }
    }

    fn parse_unary(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        mut eid = self.parse_unary_leaf()?
        // `expr with { field: value, ... }` — functional struct update (chainable).
        // The production grammar's `unary` rule now OWNS this loop (fold_with_expr,
        // over the grammar-native `with_suffix`); parse_unary stays the differential oracle
        // (Phase 3a Option B) and its behaviour is unchanged — the loop is byte-
        // identical, just factored above `parse_unary_leaf`.
        while self.check(Tk.KwWith) {
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after `with`") {
                return .Err("parse error")
            }
            let parsed = self.parse_field_init_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after with fields") {
                return .Err("parse error")
            }
            // B-final F4: With.obj is a walker-opaque ExprId and the override
            // values are opaque value_ids — a leaf, like StructLit/Block.
            eid = self.alloc_at(Expr.With(eid, parsed.inits), sp_start)
        }
        .Ok(eid)
    }

    /// The shared expression-leaf body (@hand): the `~` splice + `! - ~ not`
    /// prefix layer, then EITHER the full postfix chain (`with_postfix = true`, via
    /// `parse_call`) or just the primary (`with_postfix = false`, via
    /// `parse_primary`). `parse_call` / `parse_primary` cannot parse `~`, so the
    /// splice/bitnot handling MUST live here — `~`/splice-in-quote route through
    /// this leaf, never the grammar, and stay byte-identical. The prefix/splice
    /// branches recurse the FULL `parse_unary`, so `~x.f` / `-x!` bind their postfix
    /// inside the recursion exactly as before; the `with_postfix` split only affects
    /// the fall-through (a bare primary). Two thin @hand delegates wrap it:
    /// `parse_unary_leaf` (=true, the `call_leaf` seam — `parse_unary` WITHOUT the
    /// `with` loop) and `parse_primary_base` (=false, the Phase-3a base the grammar
    /// folds the postfix loop over). The production grammar's `unary` rule folds the
    /// postfix chain + `with` over the base, so this leaf must NOT consume `with`.
    fn parse_leaf_common(self, with_postfix: bool) -> Result<ExprId, string> {
        // Splice `~target` inside a quote body — overloads the `~`
        // token. Splice is greedy: `~f(x)` parses as
        // `Splice(Call(f, [x]))`, splicing the entire call. Users
        // who want only `~f` followed by a separate `(x)` call can
        // write `(~f)(x)` to scope the splice tightly. The greedy
        // form matches the typical metaprogramming pattern where
        // the spliced expression IS the whole quoted hole.
        let sp_start = self.current_start
        if self.check(Tk.Tilde) && self.quote_depth > 0 {
            self.advance()
            // `~Name { ... }` splices the *constructor name* of a struct
            // literal, not the whole literal. The `~Name` tag
            // flows through name_or_splice in quote lowering. Without this
            // the greedy rule below would swallow the entire struct literal
            // as one spliced node carrying a hardcoded type name.
            if self.check(Tk.Identifier) && self.allow_struct_lit && self.peek_after_ident_is_lbrace() {
                let var_name = self.take_lexeme()
                self.advance()  // consume `{`
                let parsed = self.parse_field_init_list()?
                if !self.consume(Tk.RightBrace, "expected `}` after struct fields") {
                    return .Err("parse error")
                }
                return .Ok(self.alloc_at(Expr.StructLit("~" + var_name, parsed.inits), sp_start))
            }
            let target = self.parse_unary()?
            return .Ok(self.alloc_at(Expr.Splice(target), sp_start))
        }
        if self.current_kind in [Tk.Bang, Tk.Minus, Tk.KwNot, Tk.Tilde] {
            let op = match {
                self.check(Tk.Minus) -> UnOp.Neg
                self.check(Tk.Tilde) -> UnOp.BitNot
                _                    -> UnOp.Not
            }
            self.advance()
            let right = self.parse_unary()?
            return .Ok(self.alloc_at(Expr.Unary(op, right), sp_start))
        }
        if with_postfix { self.parse_call() } else { self.parse_primary() }
    }

    /// The `call_leaf` @hand delegate: the full leaf WITH the postfix chain
    /// (`parse_unary` minus the `with` loop). Unchanged seam for the pre-Phase-3a
    /// grammar path.
    fn parse_unary_leaf(self) -> Result<ExprId, string> {
        self.parse_leaf_common(true)
    }

    /// The `primary_base` @hand delegate (Phase 3a): the leaf WITHOUT the postfix
    /// chain — splice/prefix + `parse_primary` only. The grammar's `unary` rule owns
    /// the postfix loop as `( @hand(postfix_suffix) )*` over THIS base.
    fn parse_primary_base(self) -> Result<ExprId, string> {
        self.parse_leaf_common(false)
    }

    /// The `postfix_suffix` @hand delegate (Phase 3a): ONE `postfix_step` over the
    /// grammar-threaded accumulated base (`self.postfix_base`, seeded by
    /// `primary_base` and updated per step by `run_hand_expr`). A no-progress step
    /// (guard not matched / generic-call speculation failed) returns the base
    /// UNCHANGED and consumes nothing, so the grammar `( )*` loop's no-progress
    /// break ends the chain — byte-identical to `parse_call`'s `while` exit.
    fn parse_postfix_suffix(self) -> Result<ExprId, string> {
        let s = self.postfix_step(self.postfix_base, self.postfix_sp_start)?
        self.postfix_base = s.rid
        .Ok(s.rid)
    }

    // Peek at the source character immediately after the current
    // `.` token to see whether the next identifier starts with an
    // uppercase letter.
    fn peek_next_is_upper(self) -> bool {
        if self.current >= self.source_len {
            return false
        }
        let ch = self.char_at(self.current)
        ch in "A".."Z"
    }

    // Should the current `.` token be consumed as a field / method
    // / enum-ctor postfix on `result`?
    //
    // Always allowed in normal context (`allow_dot_postfix == true`).
    //
    // Inside a match arm body (`allow_dot_postfix == false`):
    //   - `.lowerIdent`  → always a field / method, never a sibling
    //                       pattern, so allow it
    //   - `.UpperIdent`  → might be a sibling pattern unless
    //                       `result` is itself an uppercase Ident
    //                       (an enum-type prefix like `Foo.Bar`).
    //                       Otherwise suppress so the next pattern
    //                       can be parsed.
    //
    // Cross-line postfix rule (forge-crafting-intepreters-3r6q):
    // a bare `.UpperIdent(...)` on a NEW line is almost always a new
    // statement starting with a bare enum constructor — not a method
    // call on the previous expression. Without this, the parser eats
    // such constructors as postfix on the previous expression's value
    // (e.g. `let x = if c { a } else { b }` followed by `.B(...)`
    // becomes `b.B(...)`, silently extending the let initializer).
    // Lowercase method postfix on a new line still chains, so
    // `xs.filter(p)\n.map(f)` still works.
    fn dot_is_postfix(self, result: Expr) -> bool {
        if self.current_line != self.prev_line && self.peek_next_is_upper() {
            return false
        }
        if self.allow_dot_postfix {
            return true
        }
        if !self.peek_next_is_upper() {
            return true
        }
        expr_is_upper_ident(result)
    }

    /// ONE iteration of the postfix chain — the shared loop body of `parse_call`,
    /// factored out so the production grammar's `unary` rule can own the postfix
    /// loop structure while delegating each suffix to this exact hand code (Phase
    /// 3a, t-47hc.4.1.1). `rid_in` is the accumulated base; `sp_start` the chain's
    /// start byte (the constant `lo` for every suffix's `[lo, next-token)` span).
    /// The entry guard is the former `while` condition on the CURRENT token; every
    /// arm is verbatim from the old monolithic loop. Returns `progressed:false` for
    /// the three former loop-exit paths (guard not matched, generic-call `.Err`, the
    /// trailing non-postfix arm) and `progressed:true` for every consuming arm (a
    /// former `continue` or fall-through back to the loop top). `result` is
    /// recomputed from `rid_in` each call — identical to the old threaded `result`,
    /// since the guards read only the variant + name, which survive the arena
    /// round-trip.
    fn postfix_step(self, rid_in: ExprId, sp_start: int) -> Result<PostfixStep, string> {
        mut rid = rid_in
        mut result = self.expr_of(rid_in)
        // Entry guard = the former postfix `while` condition on the current token.
        // If [ appears on a DIFFERENT line than the previous token, it's a new
        // statement (list literal), not postfix indexing.
        if !((self.check(Tk.LeftParen) && self.current_line == self.prev_line) || (self.check(Tk.Dot) && self.dot_is_postfix(result) && (!self.cell_mode || self.current_line == self.prev_line)) || (self.check(Tk.Bang) && self.allow_dot_postfix && self.current_line == self.prev_line) || (self.check(Tk.LeftBracket) && self.current_line == self.prev_line) || self.check(Tk.QuestionDot) || (self.check(Tk.Question) && self.allow_dot_postfix && self.current_line == self.prev_line) || (self.check(Tk.Less) && is_callable(result)) || self.check(Tk.KwCatch)) {
            return .Ok(PostfixStep { rid: rid, progressed: false })
        }
        // Force-unwrap `expr!` is a no-op pass-through since we
        // don't track nullability in the value tag.
        while self.check(Tk.Bang) {
            self.advance()
            // Call(Ident($force_unwrap), [subject]) — fresh callee leaf,
            // the subject rides in the flipped Call's id fields (leaf row).
            let fu_callee = self.alloc_leaf(Expr.Ident(FORCE_UNWRAP_FN))
            result = Expr.Call(fu_callee, [rid])
            rid = self.alloc_at(result, sp_start)
        }
        // Error propagation: `expr?` — if null, return .Err("parse error")
        // from the enclosing function.
        //
        // t-47hc.33.2 — this re-dispatch RE-TESTS the entry guard's `?` conjuncts
        // (`allow_dot_postfix && current_line == prev_line`) rather than firing on the
        // token alone. Reached only after the `!` run above has consumed, it used to
        // fold a `?` sitting on the NEXT line into a Try, which the entry guard would
        // have rejected — so `x!` NEWLINE `?` parsed as `(? (force_unwrap x))` on the
        // native path while the hand oracle reported F0040 `expected expression`.
        // The guard belongs on every dispatch of a form, not just the first.
        if self.check(Tk.Question) && self.allow_dot_postfix && self.current_line == self.prev_line {
            self.advance()
            result = Expr.Try(rid)
            rid = self.alloc_at(result, sp_start)
            return .Ok(PostfixStep { rid: rid, progressed: true })
        }
        // Catch: `expr catch { body }` or `expr catch (e) { body }` (spec Axis 12.5-12.6)
        let catch_line = self.current_line
        let catch_col = self.current_column
        if self.check(Tk.KwCatch) {
            self.advance()
            mut binding = ""
            if self.check(Tk.LeftParen) {
                self.advance()
                binding = self.consume_identifier("expected error binding name after `catch (`")?
                if !self.consume(Tk.RightParen, "expected `)` after catch binding") { return .Err("parse error") }
            }
            if !self.consume(Tk.LeftBrace, "expected `{` after catch") { return .Err("parse error") }
            let saved_dot = self.allow_dot_postfix
            self.allow_dot_postfix = true
            let body_stmts = self.parse_statement_list_ids(true)?
            self.allow_dot_postfix = saved_dot
            if !self.consume(Tk.RightBrace, "expected `}` after catch body") { return .Err("parse error") }
            let handler = Expr.Block(body_stmts.ids)
            let handler_id = self.alloc_leaf(handler)
            // Flipped Catch.inner/.body are ExprId scalars (walker-opaque) — the
            // node holds both arena ids directly, so the Catch row is a leaf.
            result = Expr.Catch(rid, binding, handler_id, catch_line, catch_col)
            rid = self.alloc_at(result, sp_start)
            return .Ok(PostfixStep { rid: rid, progressed: true })
        }
        // Optional chaining `expr?.field` / `expr?.method(args)`.
        //   `?.field`  keeps the `OptionalChain` AST node — a clean node
        //              macros/`quote` can see — codegen'd via the shared
        //              field accessor (emit_field_on_value).
        //   `?.method(args)` has no AST node (one would need a seed cycle),
        //              so it desugars to the if-let shape, applying an
        //              ORDINARY method call to the force-unwrapped receiver:
        //              `{ let $t = recv; if $t != none { $t!.m(args) } else none }`.
        //              Both routes ultimately reuse the normal access codegen.
        if self.check(Tk.QuestionDot) {
            self.advance()
            let field = self.consume_field_name("expected field name after `?.`")?
            if self.check(Tk.LeftParen) && self.current_line == self.prev_line {
                self.advance()
                let saved_it = self.allow_it_sugar
                self.allow_it_sugar = true
                let parsed = self.parse_arg_list_ids()?
                self.allow_it_sugar = saved_it
                if !self.consume(Tk.RightParen, "expected `)` after arguments") { return .Err("parse error") }
                result = Expr.OptionalMethodCall(rid, field, parsed.ids)
                rid = self.alloc_at(result, sp_start)
            } else {
                result = Expr.OptionalChain(rid, field)
                rid = self.alloc_at(result, sp_start)
            }
        } else if self.check(Tk.LeftBracket) && self.current_line == self.prev_line {
            // t-47hc.33.2 — same re-guard as the `?` arm above, and the same reason: the
            // ENTRY guard requires `current_line == prev_line` for `[`, but this
            // re-dispatch (reached after the leading `!` run has consumed) tested the
            // token alone, so `x!` NEWLINE `[0]` folded into an INDEX of the previous
            // line where a bare `[0]` starts a fresh list-literal statement.
            //
            // This one hid longer than the `?` case because the spec that covers it
            // compared the recovery TREE through helpers that pinned only the
            // declaration flags — `expr_static` is ON by default and the gate is
            // `expr_flip || expr_static`, so the "hand" side was running the GENERATED
            // parser too and agreed with itself. It surfaced the moment `mode_flags`
            // started pinning the expression routing as well.
            self.advance()
            let idx = self.parse_expression()?
            // Slice: list[start..end]
            if self.check(Tk.DotDot) {
                self.advance()
                let end = self.parse_expression()?
                if !self.consume(Tk.RightBracket, "expected `]` after slice") {
                    return .Err("parse error")
                }
                result = Expr.Slice(rid, idx, end)
                rid = self.alloc_at(result, sp_start)
                return .Ok(PostfixStep { rid: rid, progressed: true })
            }
            if !self.consume(Tk.RightBracket, "expected `]` after index") {
                return .Err("parse error")
            }
            result = Expr.Index(rid, idx)
            rid = self.alloc_at(result, sp_start)
        } else if self.check(Tk.Less) && is_callable(result) {
            // Explicit type args: `f<int>(x)` — speculative parse with backtracking.
            match self.try_parse_generic_call(rid) {
                .Ok(g) -> {
                    rid = g
                    return .Ok(PostfixStep { rid: rid, progressed: true })
                }
                .Err(_) -> {}
            }
            return .Ok(PostfixStep { rid: rid, progressed: false })
        } else if !self.check(Tk.LeftParen) && !self.check(Tk.Dot) {
            return .Ok(PostfixStep { rid: rid, progressed: false })
        } else {
        // t-47hc.33.2 — the THIRD arm of the same re-guard (see `?` and `[` above). The
        // entry guard requires `current_line == prev_line` for `(`; this re-dispatch
        // tested the token alone, so `x!` NEWLINE `(1)` folded into a CALL of the
        // previous line where a bare `(1)` is a fresh grouping statement.
        if self.check(Tk.LeftParen) && self.current_line == self.prev_line {
            self.advance()
            // Enable `it` sugar for method calls (obj.method(it * 2))
            // but not for regular function calls (to prevent
            // double-wrapping in `f(it)` inside `.map(f(it))`).
            let saved_it = self.allow_it_sugar
            let is_method = match result {
                .FieldAccess(_, _) -> true
                _ -> false
            }
            // Enable it sugar for method calls OR if already enabled (e.g. pipe RHS)
            self.allow_it_sugar = is_method || saved_it
            let parsed = self.parse_arg_list_ids()?
            self.allow_it_sugar = saved_it
            if !self.consume(Tk.RightParen, "expected `)` after arguments") {
                return .Err("parse error")
            }
            result = Expr.Call(rid, parsed.ids)
            rid = self.alloc_at(result, sp_start)
        } else {
            // This arm is the `.` case, and it ADVANCES unconditionally — it was only
            // ever reached with a `.` current, because the `(` arm above used to take
            // every `(`. Now that `(` is line-guarded (t-47hc.33.2), a CROSS-LINE `(`
            // reaches here and would be consumed as if it were a dot, turning
            // `x!` NEWLINE `(1)` into a tuple index. Anything that is not a `.` is not
            // this step's business: report no progress and let the caller end the chain.
            if !self.check(Tk.Dot) { return .Ok(PostfixStep { rid: rid, progressed: false }) }
            self.advance()
            // Tuple index: `t.0`, `t.1` — number after dot
            if self.check(Tk.Number) {
                let idx_text = self.current_lexeme
                self.advance()
                result = Expr.TupleIndex(rid, int(idx_text))
                rid = self.alloc_at(result, sp_start)
                return .Ok(PostfixStep { rid: rid, progressed: true })
            }
            let field = self.consume_field_name("expected field name after `.`")?
            // Detect enum constructor: `Type.Variant(args)`. We
            // distinguish from method calls by requiring the
            // head Ident to start with an uppercase letter
            // Avra convention: types are PascalCase).
            let type_name = match result {
                .Ident(n) -> {
                    if p_starts_with_upper(n) {
                        n
                    } else {
                        ""
                    }
                }
                // A fully-qualified type head `@pkg::mod::Type.Variant(args)`
                // is an enum constructor too — the renderer emits resolved
                // enum ctors this way so a shipped @comptime body round-trips
                // with its enum type intact (pqc9/znl0). Without this the
                // reconstructed value carries an empty enum_type and fails to
                // decode back into a Stmt/Expr. Gated on a PascalCase LAST
                // segment, mirroring the bare-Ident rule — a lowercase last
                // segment (`@pkg::mod::a_const.method(args)`) is a method
                // call on a qualified value, not an enum construction.
                .QualifiedIdent(n) -> if p_qualified_last_upper(n) { n } else { "" }
                _ -> ""
            }
            if type_name != "" && self.check(Tk.LeftParen) {
                self.advance()
                let parsed = self.parse_arg_list_ids()?
                if !self.consume(Tk.RightParen, "expected `)` after arguments") {
                    return .Err("parse error")
                }
                // The arg ids ride verbatim in the flipped payload; the
                // ctor node itself is a leaf (its children ARE the id
                // fields, so the arena records no edges).
                result = Expr.EnumCtor(type_name, field, parsed.ids)
                rid = self.alloc_at(result, sp_start)
            } else {
                result = Expr.FieldAccess(rid, field)
                rid = self.alloc_at(result, sp_start)
            }
        }
        }
        .Ok(PostfixStep { rid: rid, progressed: true })
    }

    fn parse_call(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        // The postfix chain's dual cursor now lives in `postfix_step`, which runs
        // ONE suffix per call over the accumulated `rid` (the production grammar's
        // `unary` rule folds the same steps — Phase 3a). The primary is the chain
        // base; `sp_start` (its start byte) is the constant span `lo`.
        mut rid = self.parse_primary()?
        while true {
            let s = self.postfix_step(rid, sp_start)?
            // Adopt `rid` BEFORE the progress check so a stopping step that still
            // wrapped the base (the trailing `a!`-at-EOF arm) keeps its result.
            rid = s.rid
            if !s.progressed { break }
        }
        .Ok(rid)
    }

    fn parse_arg_list_ids(self) -> Result<ArgListIds, string> {
        // Inside a paren-bounded arg list we're unambiguously not
        // at a sibling pattern position, so re-enable `.field`
        // postfix consumption.
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let result = self.parse_arg_list_ids_inner()
        self.allow_dot_postfix = saved
        result
    }

    fn parse_arg_list_ids_inner(self) -> Result<ArgListIds, string> {
        mut ids: List<ExprId> = []
        if self.check(Tk.RightParen) {
            return .Ok(ArgListIds { ids: ids })
        }
        mut keep_going = true
        while keep_going {
            let raw_id = self.parse_expression()?
            let raw_expr = self.expr_of(raw_id)
            mut eid = raw_id
            // `it` parameter sugar: only wrap if allow_it_sugar is set
            // (method calls like .map/.filter set this, regular function
            // calls do not, preventing double-wrapping in `f(it)` inside
            // `.map(f(it))`). Flipped Lambda.body is an ExprId scalar — the
            // body row IS the structure, so the lambda is a walker leaf.
            if self.allow_it_sugar {
                match raw_expr {
                    // Already a lambda — leave it; wrapping a lambda in an
                    // `it`-lambda would double-bind. (Statement-position match:
                    // the only effect is the `_` arm's `eid` reassignment.)
                    .Lambda(_, _) -> {}
                    _ -> {
                        if expr_contains_it(self.store, raw_expr) {
                            eid = self.alloc_leaf(wrap_in_it_lambda(raw_id))
                        }
                    }
                }
            }
            ids.push(eid)
            if self.check(Tk.Comma) {
                self.advance()
                if self.check(Tk.RightParen) { keep_going = false }
            } else {
                keep_going = false
            }
        }
        .Ok(ArgListIds { ids: ids })
    }

    /// B1: primary productions hand back a typed id — the node (and its
    /// whole subtree) is in the arena. Leaves alloc directly; composites
    /// whose children flowed through the id-returning chain re-parent those
    /// ids; stmt-bearing / feature-parsed productions (match, if, quote,
    /// templates, table/map literals, blocks) still build boxed and enter
    /// via the glue bridge at their own boundary — each bridge disappears
    /// when its producer converts to ids.
    /// Read a fully-qualified `@pkg::mod::name` path into its canonical
    /// `::`-joined string. The renderer (`fmt_stmt_ids`) emits resolved
    /// names in this form, so re-parsing a shipped `@comptime` body must
    /// accept it — in expression position (→ `QualifiedIdent`) and type
    /// position (→ `Named`) alike. `::` lexes as two `Colon` tokens.
    /// Precondition: current token is `Tk.At`.
    // The `::` separator is STRICT: two ADJACENT colons (adjacency is
    // confirmed against the raw source, bounds-guarded for input
    // truncated at a lone `:`), each followed by an identifier segment —
    // a single `:` never pairs, so `@a:b` stays a parse error instead of
    // silently reading as `@a::b`. At least one `::` is required: a lone
    // `@ident` is annotation syntax everywhere Avra accepts `@`.
    fn parse_qualified_at_name(self) -> Result<string, string> {
        self.advance()  // consume `@`
        if !self.check(Tk.Identifier) {
            self.set_error("expected identifier after `@` in qualified reference")
            return .Err("parse error")
        }
        mut name = "@" + self.current_lexeme
        self.advance()  // consume first segment
        mut segments = 0
        while self.check(Tk.Colon) && self.current_start + 1 < self.source_len && self.char_at(self.current_start + 1) == ":" {
            self.advance()  // first `:`
            self.advance()  // second `:`
            if !self.check(Tk.Identifier) {
                self.set_error("expected identifier after `::` in qualified reference")
                return .Err("parse error")
            }
            name = name + "::" + self.current_lexeme
            self.advance()  // segment identifier
            segments = segments + 1
        }
        if segments == 0 {
            self.set_error("expected `::` after the package name — a qualified reference is `@pkg::mod::name`; `@name` alone is annotation syntax")
            return .Err("parse error")
        }
        .Ok(name)
    }

    /// Scan tokens to the `}` balancing the already-consumed `{`,
    /// WITHOUT consuming it, and return the verbatim source substring
    /// in between (outer whitespace trimmed). Brace TOKENS drive the
    /// depth count, so a `{` inside a string literal or comment never
    /// miscounts — the only limitation is an UNBALANCED bare brace
    /// token in the raw text. `unterminated_msg` is reported on EOF
    /// before a balancing `}`. Shared by every raw-capture construct
    /// (`body: TokenStream` components, `grammar { … }`, …).
    fn capture_balanced_brace_body(self, unterminated_msg: string) -> Result<string, string> {
        let start = self.current_start
        mut end = self.current_start
        mut depth = 1
        while depth > 0 {
            if self.check(Tk.Eof) {
                self.set_error(unterminated_msg)
                return .Err("parse error")
            }
            if self.check(Tk.LeftBrace) { depth = depth + 1 }
            if self.check(Tk.RightBrace) {
                depth = depth - 1
                if depth == 0 {
                    end = self.current_start
                    break
                }
            }
            self.advance()
        }
        .Ok(self.source.substring(start, end).trim())
    }

    // The `@pkg::mod::name` qualified-ident / qualified struct-literal primary
    // (Phase 3a-11): extracted from parse_primary so the grammar can own the `@`
    // FIRST via @hand(qualified_expr). parse_qualified_at_name is the `::`-adjacency
    // char-scan (stays hand). Fully-qualified names appear when a shipped @comptime
    // body is re-parsed (pqc9/znl0) — a QualifiedIdent the comptime evaluator looks
    // up by full path.
    fn parse_qualified_expr(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let qname = self.parse_qualified_at_name()?
        if self.allow_struct_lit && self.check(Tk.LeftBrace) {
            self.advance()
            let parsed = self.parse_field_init_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after struct fields") {
                return .Err("parse error")
            }
            return .Ok(self.alloc_at(Expr.StructLit(qname, parsed.inits), sp_start))
        }
        .Ok(self.alloc_leaf(Expr.QualifiedIdent(qname)))
    }

    // The `[expr, …]` list-literal / list-comprehension primary (Phase 3a-10):
    // extracted from parse_primary so the grammar can own the `[` FIRST via
    // @hand(list_expr). A single-element `[body for v in coll if f]` unwraps its
    // ListComp so it flows into the list_comp feature without a spurious ListLit.
    fn parse_list_expr(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        self.advance()
        if self.check(Tk.RightBracket) {
            self.advance()
            let empty: List<ExprId> = []
            return .Ok(self.alloc_at(Expr.ListLit(empty), sp_start))
        }
        let elements = self.parse_list_elements()?
        if !self.consume(Tk.RightBracket, "expected `]` after list") {
            return .Err("parse error")
        }
        if elements.ids.length == 1 {
            match self.store.exprs.get(elements.ids[0]) {
                .ListComp(_, _, _, _) -> return .Ok(elements.ids[0])
                _ -> {}
            }
        }
        .Ok(self.alloc_at(Expr.ListLit(elements.ids), sp_start))
    }

    // The `(…)` grouping / tuple / lambda primary (Phase 3a-9): extracted from
    // parse_primary so the grammar can own the `(` FIRST via @hand(paren_expr).
    // Disambiguates grouping vs tuple (trailing `,`) vs lambda (trailing `->`),
    // with typed-lambda param detection (peek_after_ident_is_colon) and
    // allow_dot_postfix toggling — all internal to this hand method, so the
    // grammar only routes the `(` and needs no new mode/speculation primitive.
    /// Speculatively consume `->` and parse a lambda BODY, returning null (with the
    /// parser and its diagnostic bag restored) when the body is missing or malformed.
    ///
    /// Seeing `->` after `( … )` is NOT enough to commit to a lambda. The hand parser
    /// used to consume it and propagate a body failure with `?`, which discarded the
    /// whole parenthesised expression — and with it whatever the caller was building, so
    /// `let a = (1) ->` collapsed to a bare error statement instead of `let a = (1)` plus
    /// a separate report for the stray `->`. Rolling back lets each arity fall through to
    /// its non-lambda reading (grouping / tuple), which is exactly what the grammar's
    /// `@try` lambda alternatives in `paren_expr` do. Restoring the bag is what keeps the
    /// abandoned attempt from adding a second diagnostic on top of the caller's (t-oejs).
    fn try_lambda_body(self) -> ExprId? {
        let s_state = self.save_state()
        mut s_diags: List<Diagnostic> = []
        for dg in self.bag.diagnostics { s_diags.push(dg) }
        let s_bag = DiagnosticBag {
            diagnostics: s_diags,
            error_count: self.bag.error_count,
            warning_count: self.bag.warning_count,
        }
        self.advance()
        match self.parse_lambda_body() {
            .Ok(body) -> body
            .Err(_) -> {
                self.restore_state(s_state)
                self.bag = s_bag
                null
            }
        }
    }

    fn parse_paren_expr(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        self.advance()
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = true
        // Empty parens: () → could be empty tuple or zero-arg lambda
        if self.check(Tk.RightParen) {
            self.allow_dot_postfix = saved
            self.advance()
            // () -> expr  is a zero-arg lambda
            if self.check(Tk.Arrow) {
                let body = self.try_lambda_body()
                if body != null {
                    let empty_ps: List<ParamEntry> = []
                    return .Ok(self.alloc_at(Expr.Lambda(empty_ps, body!), sp_start))
                }
            }
            let empty: List<ExprId> = []
            return .Ok(self.alloc_at(Expr.Tuple(empty), sp_start))
        }
        // Typed lambda: (x: int, y: string) -> body
        // Detect by peeking: if current is identifier and next non-ws is ':'
        if self.check(Tk.Identifier) && self.peek_after_ident_is_colon() {
            self.allow_dot_postfix = saved
            let params = self.parse_param_list()?
            if !self.consume(Tk.RightParen, "expected `)` after typed parameters") {
                return .Err("parse error")
            }
            if !self.consume(Tk.Arrow, "expected `->` after typed lambda parameters") {
                return .Err("parse error")
            }
            let body = self.parse_lambda_body()?
            return .Ok(self.alloc_at(Expr.Lambda(params, body), sp_start))
        }
        let expr_opt = self.parse_expression()
        self.allow_dot_postfix = saved
        let expr = expr_opt?
        // (a, b, ...) — comma after first: tuple or multi-param lambda
        if self.check(Tk.Comma) {
            self.advance()
            let rest = self.parse_tuple_rest()?
            if !self.consume(Tk.RightParen, "expected `)` after tuple") {
                return .Err("parse error")
            }
            // (a, b) -> expr  is a lambda — the param exprs are consumed
            // as names (scalar ParamEntry data); their parsed rows orphan.
            if self.check(Tk.Arrow) {
                let body = self.try_lambda_body()
                if body != null {
                    mut combined_ids: List<ExprId> = [expr]
                    for tid in rest.ids { combined_ids.push(tid) }
                    let params = exprs_to_params(self.store, combined_ids)
                    return .Ok(self.alloc_at(Expr.Lambda(params, body!), sp_start))
                }
            }
            mut tuple_ids: List<ExprId> = [expr]
            for tid in rest.ids { tuple_ids.push(tid) }
            return .Ok(self.alloc_at(Expr.Tuple(tuple_ids), sp_start))
        }
        if !self.consume(Tk.RightParen, "expected `)` after expression") {
            return .Err("parse error")
        }
        // (x) -> expr  is a single-param lambda — SPECULATIVELY. Seeing `->` is not
        // enough to commit: if the body is missing or malformed, this was never a
        // lambda, and propagating that failure with `?` discards the whole
        // parenthesised expression (and with it the binding the caller was building —
        // `let a = (1) ->` became a bare error statement instead of `let a = (1)` plus
        // a separate report for the stray `->`). Roll back to the GROUPING instead,
        // leaving `->` unconsumed for the caller to report, which is exactly what the
        // grammar's `@try` lambda alternative in `paren_expr` does for this input.
        // Restoring the diagnostic bag is what keeps it to ONE report rather than the
        // abandoned attempt's plus the caller's (t-oejs).
        if self.check(Tk.Arrow) {
            let body = self.try_lambda_body()
            if body != null {
                // Params are built only on the committed path: `exprs_to_params`
                // allocates, so doing it before the body would orphan rows on rollback.
                let one: List<ExprId> = [expr]
                let params = exprs_to_params(self.store, one)
                return .Ok(self.alloc_at(Expr.Lambda(params, body!), sp_start))
            }
        }
        .Ok(self.alloc_at(Expr.Grouping(expr), sp_start))
    }

    // The identifier-led primary (Phase 3a-8): bare `Ident`, `Ident { … }` struct
    // literal (@allow_struct_lit), `table { … }` / `table<Row> { … }` table literal
    // (peek_is_table_row_type char-lookahead), `kw { … }` feature-keyword dispatch
    // (lookup_expr_parser registry), and tagged template. Extracted from parse_primary
    // so the grammar owns the IDENT FIRST via @hand(ident_primary); all the IDENT-led
    // disambiguation stays inside this hand method (no grammar mechanism needed).
    fn parse_ident_expr(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        let name = self.current_lexeme
        self.advance()
        // Table literal: `table { ... }` / typed `table<Row> { ... }` — checked
        // BEFORE struct-lit (both start ident+{); `table<...>` is a table only when
        // the `<` leads `Ident > {` (else it's a comparison on a var named `table`).
        if name == "table" && (self.check(Tk.LeftBrace) || (self.check(Tk.Less) && self.peek_is_table_row_type())) {
            return self.parse_table_literal()
        }
        // Registered `kw { … }` feature construct (grammar / sql / regex): dispatch
        // to the feature's parse_expr (owns the block). sp_start is the keyword start
        // so the node span begins at the keyword. Gated on allow_struct_lit + placed
        // BEFORE struct-lit so `grammar {` never falls through to a StructLit.
        if self.allow_struct_lit && self.check(Tk.LeftBrace) {
            let ekw_raw = lookup_expr_parser(self.features, name)
            if ekw_raw != null {
                let handler: fn(Parser, int) -> Result<ExprId, string> = ekw_raw!
                return handler(self, sp_start)
            }
        }
        if self.allow_struct_lit && self.check(Tk.LeftBrace) {
            self.advance()
            let parsed = self.parse_field_init_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after struct fields") {
                return .Err("parse error")
            }
            return .Ok(self.alloc_at(Expr.StructLit(name, parsed.inits), sp_start))
        }
        // Tagged template: `tag`…`  → tag(desugar_template(raw))
        if self.check(Tk.Template) {
            let raw = self.current_lexeme
            self.advance()
            let template_id = self.desugar_template(raw)?
            let tag_callee = self.alloc_leaf(Expr.Ident(name))
            return .Ok(self.alloc_at(Expr.Call(tag_callee, [template_id]), sp_start))
        }
        .Ok(self.alloc_leaf(Expr.Ident(name)))
    }

    fn parse_primary(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        // Fully-qualified name `@pkg::mod::name` in expression position —
        // produced by the renderer when a shipped `@comptime` body is
        // re-parsed (pqc9/znl0). Resolves directly to a `QualifiedIdent`
        // the comptime evaluator looks up by full path, so a rehydrated
        // body needs no second resolve pass.
        if self.check(Tk.At) {
            return self.parse_qualified_expr()
        }
        if self.check(Tk.Number) {
            let value = self.current_lexeme
            self.advance()
            return .Ok(self.alloc_leaf(Expr.Number(value)))
        }

        if self.check(Tk.Float) {
            let value = self.current_lexeme
            self.advance()
            return .Ok(self.alloc_leaf(Expr.FloatLit(value)))
        }

        if self.check(Tk.String) {
            let value = self.current_lexeme
            self.advance()
            return .Ok(self.alloc_leaf(Expr.String(value)))
        }

        if self.check(Tk.Template) {
            let raw = self.current_lexeme
            self.advance()
            return self.desugar_template(raw)
        }

        if self.current_kind in [Tk.KwTrue, Tk.KwFalse] {
            let value = self.current_lexeme
            self.advance()
            return .Ok(self.alloc_leaf(Expr.Bool(value)))
        }

        // `none` (canonical) and `null` (deprecated alias) both produce
        // the absence literal `Expr.None`.
        if self.check(Tk.KwNull) || self.check(Tk.KwNone) {
            self.advance()
            return .Ok(self.alloc_leaf(Expr.None))
        }

        // Contextual enum variant: `.Variant` or `.Variant(args)`
        // Resolved at codegen time using the expected type from context.
        if self.check(Tk.Dot) {
            self.advance()  // consume .
            if self.check(Tk.Identifier) {
                let variant = self.current_lexeme
                self.advance()  // consume variant name
                if self.check(Tk.LeftParen) {
                    self.advance()
                    let parsed = self.parse_arg_list_ids()?
                    if !self.consume(Tk.RightParen, "expected `)` after variant args") {
                        return .Err("parse error")
                    }
                    let ctor = Expr.EnumCtor("", variant, parsed.ids)
                    return .Ok(self.alloc_at(ctor, sp_start))
                }
                let empty: List<ExprId> = []
                return .Ok(self.alloc_at(Expr.EnumCtor("", variant, empty), sp_start))
            }
            // The `.` is ALREADY CONSUMED, so falling through here would hand the
            // rest of the dispatch a token stream missing a token the user wrote —
            // and whatever follows would parse as if the `.` were never there. That
            // is a SILENT DROP (t-6u9b): `let x = .(1)` parsed as `(group 1)` with
            // ZERO diagnostics, so the compiler accepted text it had discarded.
            // It hid because the recovery oracles compare the two parsers to EACH
            // OTHER — both swallow it, both agree, the tree spec passes vacuously.
            // Only a diagnostic-COUNT assertion on invalid input catches this shape.
            //
            // Reporting is right rather than merely rewinding: in PRIMARY position
            // (no operand to the left — a postfix `.field` is `dot_is_postfix`'s job,
            // and `..` lexes as Tk.DotDot) a `.` can ONLY open the variant shorthand,
            // so a non-identifier after it has no other reading. F0040 is the same
            // code the tail already gives a bare trailing `.`; this only names the
            // cause instead of saying "expected expression".
            self.report(DiagCode.ExpectedExpression, "expected a variant name after `.`")
            return .Err("parse error")
        }

        if self.check(Tk.Identifier) {
            return self.parse_ident_expr()
        }

        if self.check(Tk.LeftParen) {
            return self.parse_paren_expr()
        }

        // List literal: [expr, expr, ...]
        if self.check(Tk.LeftBracket) {
            return self.parse_list_expr()
        }

        if self.check(Tk.KwMatch) {
            return self.parse_match_expression()
        }

        if self.check(Tk.KwIf) {
            return self.parse_if_expression()
        }

        if self.check(Tk.KwSpawn) {
            return self.parse_spawn_expression()
        }

        if self.check(Tk.KwChannel) {
            return self.parse_channel_expression()
        }

        if self.check(Tk.KwIsolated) {
            return self.parse_isolated_expression()
        }

        if self.check(Tk.KwWhen) {
            return self.parse_when_expression()
        }

        if self.check(Tk.KwQuote) {
            return self.parse_quote()
        }

        if self.check(Tk.LeftBrace) {
            // Map literal: { "key": value, ... }
            // Disambiguate from block: if first token after { is a string,
            // and the token after that is a colon, it's a map.
            if self.is_map_literal() {
                return self.parse_map_literal()
            }
            return self.parse_block_expression()
        }

        if self.current_lexeme == ";" {
            self.report(DiagCode.UnexpectedSemicolon, "unexpected `;`")
        } else {
            self.report(DiagCode.ExpectedExpression, "expected expression")
        }
        .Err("parse error")
    }

    /// Desugar `hello ${expr}!` into `"hello " + string(expr) + "!"`. Thin wrapper
    /// over the SHARED store-based desugar_template_store (t-47hc.19) — the grammar's
    /// native `template_lit` rule calls the same fn through mk_template, so the two
    /// parsers cannot drift. This side reports the returned message on the hand
    /// parser's own error channel.
    fn desugar_template(self, raw: string) -> Result<ExprId, string> {
        match desugar_template_store(self.store, raw) {
            .Ok(id) -> .Ok(id)
            .Err(m) -> {
                self.set_error(m)
                .Err("parse error")
            }
        }
    }


    fn parse_tuple_rest(self) -> Result<ArgListIds, string> {
        // After the first comma in a tuple. Parse remaining elements.
        mut ids: List<ExprId> = []
        mut keep_going = true
        while keep_going {
            if self.check(Tk.RightParen) {
                keep_going = false
            } else {
                let eid = self.parse_expression()?
                ids.push(eid)
                if self.check(Tk.Comma) {
                    self.advance()
                } else {
                    keep_going = false
                }
            }
        }
        .Ok(ArgListIds { ids: ids })
    }

    fn parse_block_expression(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        self.advance()
        // A block expression's body is parsed as a regular statement
        // list. Re-enable `.field` postfix consumption inside —
        // we're back in normal expression-statement context.
        let saved_dot = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let body = self.parse_statement_list_ids(true)
        self.allow_dot_postfix = saved_dot
        let body_val = body?
        if !self.consume(Tk.RightBrace, "expected `}` after block expression") {
            return .Err("parse error")
        }
        // Flipped Expr.Block holds List<StmtId> (walker-opaque, like Stmt.Block) —
        // the stmt ids ARE the structure, so the block-expr is a leaf row.
        .Ok(self.alloc_at(Expr.Block(body_val.ids), sp_start))
    }

    fn check(self, kind: Tk) -> bool {
        self.current_kind == kind
    }

    // Peek ahead: after the current identifier, skip whitespace,
    // return true if the next char is ':'. For typed lambda detection.
    /// At a `@` token: does a `::` follow the identifier — i.e. is this a
    /// qualified-name EXPRESSION (`@pkg::mod::name`), not an annotation
    /// (`@comptime`, `@expand(…)`)? Lets a statement whose tail expression
    /// is a rendered qualified name (a re-parsed `@comptime` body's implicit
    /// return) route to expression parsing instead of annotation parsing.
    fn peek_after_at_is_qualified(self) -> bool {
        mut i = self.current_start + 1  // skip `@`
        while i < self.source_len && (self.char_at(i) == " " || self.char_at(i) == "\t") { i = i + 1 }
        while i < self.source_len && p_is_alpha_numeric(self.char_at(i)) { i = i + 1 }
        while i < self.source_len && (self.char_at(i) == " " || self.char_at(i) == "\t") { i = i + 1 }
        i < self.source_len && self.char_at(i) == ":"
    }

    fn peek_after_ident_is_colon(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source_len {
            let ch = self.char_at(i)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == ":"
            }
            i = i + 1
        }
        false
    }

    // Does the next non-whitespace char after the current identifier open
    // a `{` block? Distinguishes a struct literal `~Name { ... }` from a
    // bare spliced identifier `~Name` in the quote splice path.
    fn peek_after_ident_is_lbrace(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source_len {
            let ch = self.char_at(i)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == "{"
            }
            i = i + 1
        }
        false
    }

    // At the `<` token (just after `table`): does the raw source spell
    // `< Ident > {` — i.e. a typed table literal `table<Row> { … }` — as
    // opposed to a comparison like `table < 10`? Scans source without
    // consuming. The `> {` suffix is what disambiguates the two.
    fn peek_is_table_row_type(self) -> bool {
        let n = self.source_len
        mut i = self.current_start + 1   // skip the `<`
        // skip whitespace
        while i < n {
            let c = self.char_at(i)
            if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1 } else { break }
        }
        if i >= n { return false }
        // identifier start
        let c0 = self.char_at(i)
        let is_alpha = (c0 >= "a" && c0 <= "z") || (c0 >= "A" && c0 <= "Z") || c0 == "_"
        if !is_alpha { return false }
        // consume identifier characters
        while i < n {
            let c = self.char_at(i)
            let ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
            if ok { i = i + 1 } else { break }
        }
        // skip whitespace, expect `>`
        while i < n {
            let c = self.char_at(i)
            if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1 } else { break }
        }
        if i >= n || self.char_at(i) != ">" { return false }
        i = i + 1
        // skip whitespace, expect `{`
        while i < n {
            let c = self.char_at(i)
            if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1 } else { break }
        }
        i < n && self.char_at(i) == "{"
    }

    fn peek_after_ident_is_paren(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source_len {
            let ch = self.char_at(i)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == "("
            }
            i = i + 1
        }
        false
    }

    // Peek: is the next token after current ident another identifier (not a keyword)?
    // Returns false for `{`, `(`, `=`, operators, and keyword starts like "true"/"false".
    // Used to detect `comp_name instance_name {` pattern without consuming tokens.
    fn peek_after_ident_is_ident_not_keyword(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        // Skip whitespace
        while i < self.source_len {
            let ch = self.char_at(i)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break }
            i = i + 1
        }
        if i >= self.source_len { return false }
        let ch = self.char_at(i)
        // Must start with letter or underscore
        let is_alpha = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
        if !is_alpha { return false }
        // Extract the full word
        mut j = i
        while j < self.source_len {
            let wc = self.char_at(j)
            let is_alnum = (wc >= "a" && wc <= "z") || (wc >= "A" && wc <= "Z") || (wc >= "0" && wc <= "9") || wc == "_"
            if !is_alnum { break }
            j = j + 1
        }
        let word = self.slice(i, j)
        // Exclude keywords that appear after identifiers in non-component contexts
        if word_excluded_as_instance_name(word) { return false }
        // Check that the word is followed by `{` (to confirm it's instance_name + block)
        mut k = j
        while k < self.source_len {
            let sc = self.char_at(k)
            if sc != " " && sc != "\t" && sc != "\n" && sc != "\r" { break }
            k = k + 1
        }
        if k < self.source_len {
            return self.char_at(k) == "{"
        }
        false
    }

    fn advance(self) {
        self.prev_line = self.current_line
        self.advance_token()
    }

    /// Copy the full lexer/cursor + line-tracking state from `other` (same source),
    /// WITHOUT touching the store, features, or mode flags. The ps3t.6.7 expression
    /// flip uses this to (a) SYNC the @hand delegate to this parser's exact position
    /// + accumulated line before parsing an expression's leaves, and (b) ADOPT the
    /// delegate's end state afterwards — so the deliberate is_map_literal line nudge
    /// the delegate incurs propagates into this parser's continuous line, matching a
    /// from-scratch hand parse byte-for-byte. These are exactly the ten cursor fields
    /// save_state/restore_state round-trip (minus the store mark / diagnostics).
    /// Forward-advance this parser's cursor to `stop_byte` — the DSL flip's RESYNC
    /// (the grammar parser consumed tokens off the shared stream; this walks the
    /// hand cursor over the same span so its position AND line match).
    ///
    /// The loop bound is `check(Tk.Eof)` — the CURRENT TOKEN being EOF — NOT
    /// `is_at_end()`, which asks whether the SCANNER has consumed the last source
    /// byte. Those differ on the file's final token: after scanning it,
    /// `current >= source_len` already holds while the cursor still sits ON that
    /// token. A resync bounded by `is_at_end()` therefore stops ONE TOKEN SHORT
    /// whenever the DSL's last consumed token abuts EOF — e.g. a top-level `{ … }`
    /// block in a source string with no trailing newline, which left the cursor
    /// parked on the `}` and made the caller report `unexpected }`. `advance_token`
    /// sets Eof once it runs out of bytes, so this still terminates.
    fn resync_to_stop_byte(self, stop_byte: int) {
        while self.current_start < stop_byte && !self.check(Tk.Eof) {
            self.advance_token()
        }
    }

    fn copy_cursor_from(self, other: Parser) {
        self.start = other.start
        self.current = other.current
        self.line = other.line
        self.column = other.column
        self.current_kind = other.current_kind
        self.current_lexeme = other.current_lexeme
        self.current_line = other.current_line
        self.current_column = other.current_column
        self.prev_line = other.prev_line
        self.current_start = other.current_start
    }

    fn consume(self, kind: Tk, message: string) -> bool {
        if self.check(kind) {
            self.advance()
            return true
        }
        self.set_error(message)
        false
    }

    // A nested generic close (`>>`, e.g. `List<List<int>>`) lexes as a SINGLE
    // right-shift token, but in a generic-type-arg context the first `>` closes
    // the inner list and the rest must remain for the enclosing list(s). Split
    // it: re-point the byte cursor back onto the second `>` and re-stamp the
    // current token as a single `>`, so the NEXT `advance()` re-lexes the
    // remainder — which re-forms a `>>` for `>>>` (`List<List<List<int>>>`),
    // letting each enclosing close peel one `>` in turn. Mirrors the C++/Rust
    // nested-generic close handling. No-op unless the current token is `>>`,
    // so it's only ever called from the generic-close sites (type-arg parsing
    // and `impl`/`trait`-header angle skipping) and never disturbs a real `>>`
    // shift operator, which is parsed outside any angle-bracket context.
    fn maybe_split_shr(self) {
        if self.current_kind == Tk.Shr {
            self.current = self.current - 1
            self.column = self.column - 1
            self.current_kind = Tk.Greater
            self.current_lexeme = ">"
        }
    }

    /// Consume the current token's lexeme + advance. Caller is
    /// expected to have already checked the token kind.
    fn take_lexeme(self) -> string {
        let name = self.current_lexeme
        self.advance()
        name
    }

    /// Emit "`<kw>` is a reserved keyword and cannot be used
    /// <suffix>" at the current span and consume the offending
    /// token. Centralises the diagnostic shared by `parse_declaration`
    /// (top-level decl using a future-reserved keyword) and
    /// `consume_identifier` (binding site).
    fn reject_reserved_keyword(self, suffix: string) {
        let kw = self.current_lexeme
        self.set_error("`${kw}` is a reserved keyword and cannot be used ${suffix}")
        self.advance()
    }

    /// Strict identifier consumer: rejects reserved keywords at
    /// binding sites (param / let / mut / const / fn / type /
    /// variant / field names). so07.2 / 1rzz — without this check
    /// the parser silently accepted `bare`, `await`, etc. as
    /// identifiers and the use site emitted a confusing F0001.
    fn consume_identifier(self, message: string) -> Result<string, string> {
        if self.check(Tk.KwReserved) {
            self.reject_reserved_keyword("as an identifier — rename the binding")
            return .Err("parse error")
        }
        if self.check(Tk.Identifier) { return .Ok(self.take_lexeme()) }
        self.set_error(message)
        .Err("parse error")
    }

    /// Consume an identifier in a declaration-name slot, honoring
    /// `~ident` splice syntax inside a `quote { ... }` body.
    /// Outside a quote it is a plain identifier. Inside one,
    /// `~ident` defers the name to expansion time: the leading `~` is
    /// preserved as the sentinel the quote-lowering pass (`name_or_splice`
    /// in features/quote_expr/lower.av) decodes back into a live splice.
    /// Used by every name slot that can carry a splice — type names,
    /// impl targets, and struct-literal constructors.
    fn consume_name_or_splice(self, message: string) -> Result<string, string> {
        if self.quote_depth > 0 && self.check(Tk.Tilde) {
            self.advance()
            let var_name = self.consume_identifier("expected identifier after `~` in name position")?
            return .Ok("~" + var_name)
        }
        self.consume_identifier(message)
    }

    /// Parse a comma-separated destructure binding list `a, b, c`
    /// (caller has already consumed the opening `(` and consumes the
    /// closing `)`). Shared by `let (a, b) = …` and the for-in tuple
    /// binding `for (a, b) in …`. A trailing comma is tolerated.
    /// Each entry's type is left Unknown — inferred from the tuple
    /// element types at type-check time.
    fn parse_destructure_names(self) -> Result<List<ParamEntry>, string> {
        mut out: List<ParamEntry> = []
        if self.check(Tk.RightParen) { return .Ok(out) }
        mut keep_going = true
        while keep_going {
            let name = self.consume_identifier("expected variable name in destructure")?
            // Destructure bindings can't carry a type annotation — no type was
            // written, so no row backs the inferred-later Unknown.
            out.push(ParamEntry { name: name, vtype: ValueType.Unknown, ty_id: none })
            if self.check(Tk.Comma) {
                self.advance()
                if self.check(Tk.RightParen) { keep_going = false }
            } else {
                keep_going = false
            }
        }
        .Ok(out)
    }

    /// Lenient variant for field / method access positions
    /// (`task.await`, `expr?.field`): accepts reserved keywords
    /// because the dot disambiguates. Use only for `expr.<name>` /
    /// `expr?.<name>` sites — binding sites must call
    /// `consume_identifier` instead so reserved names are rejected.
    // The acceptance set is `tk_is_field_name` (core/ast.av), NOT an inline pair of
    // checks: the grammar's `FIELDNAME` terminal reads the same predicate, so the two
    // front ends cannot drift on which names may follow a `.` (t-47hc.33.1).
    fn consume_field_name(self, message: string) -> Result<string, string> {
        if tk_is_field_name(self.current_kind) { return .Ok(self.take_lexeme()) }
        self.set_error(message)
        .Err("parse error")
    }

    // Consume a type reference: identifier optionally followed by
    // generic arguments `<A, B>` and/or nullable `?`.
    // Both generics and nullable are erased — we return the base name.
    // Parse a structured type expression. Returns TypeExpr AST node.
    // Type-family parse entry. ps3t.6.5.12 routes this through the grammar-DSL
    // when AVRA_PARSER_TYPE_FLIP=1 — run_dsl_type_at (the inverse of the @hand
    // bridge) becomes authoritative; a DSL parse error falls back to the hand
    // parser so the flip can never regress. Default (env unset) is the hand
    // parser verbatim: byte-identical, zero risk. The flip is proven by
    // diff-test byte-identity + the full suite WITH the flag on, before its
    // default is promoted. run_dsl_type_at resyncs the token cursor by byte
    // position — both surfaces share the hand lexer, so Token.pos ==
    // current_start at every boundary (the grammar/static runner mirror).
    // The grammar-DSL token list for this parser's source, lexed at most once
    // (lex-once cache, ps3t.6.5.12 Step D). Reused by every type-flip
    // delegation so a file with N type annotations is lexed once, not N times.
    fn grammar_tokens(self) -> List<Token> {
        if self.grammar_toks.length == 0 {
            self.grammar_toks = lex_real(self.source)
        }
        self.grammar_toks
    }

    // The DSL program grammar for this parser, built at most once (lex-once
    // cache, ps3t.6.5.12 Step D). The `??` fallback is unreachable — the field
    // is non-null after the guard — it only unwraps `Grammar?` to `Grammar`.
    fn dsl_type_grammar(self) -> Grammar {
        if self.dsl_grammar == null {
            self.dsl_grammar = avra_program_grammar()
        }
        self.dsl_grammar ?? avra_program_grammar()
    }

    fn parse_type_expr(self, message: string) -> Result<TypeExpr, string> {
        if self.type_static || self.type_flip {
            // t-47hc.4.4 Phase 3d: the STATIC generated type parser (run_static_type)
            // when type_static, else the Grammar-tree interpreter (run_dsl_type_at_shared).
            // Both share the token stream + store + resync below — they differ only in HOW
            // they drive the identical type-builders, so the DslTypeResult is byte-identical.
            let dsl = if self.type_static {
                run_static_type(self.grammar_tokens(), self.current_start, self.source, self.store)
            } else {
                run_dsl_type_at_shared(self.grammar_tokens(), self.current_start, self.source, self.store, self.dsl_type_grammar())
            }
            if !dsl.had_error {
                while self.current_start < dsl.stop_byte && !self.check(Tk.Eof) {
                    // Nested-generic close: the DSL splits a `>>` (Tk.Shr) into two
                    // `>`, consuming ONE to close the inner generic and leaving the
                    // second for the CALLER's own `>` (the hand channel /
                    // generic-type-args parser). stop_byte then lands BETWEEN the two
                    // `>`. Advancing the whole Shr token here would swallow that
                    // second `>` and the caller's `consume(Greater)` would fail on the
                    // next token (`channel<GenOpt<int>>()` → "expected `>`"). Split it
                    // so only the first `>` is consumed — mirrors maybe_split_shr and
                    // the DSL executor's own split (ps3t.6.5.10).
                    if self.current_kind == Tk.Shr && self.current_start + 1 == dsl.stop_byte {
                        self.maybe_split_shr()
                    }
                    self.advance_token()
                }
                return .Ok(dsl.te)
            }
            // DSL parse error → fall through to the authoritative hand parser.
        }
        self.parse_type_expr_hand(message)
    }

    // The hand-written type-expression parser: the swap-in oracle, and the
    // fallback when the DSL flip is off or errors.
    fn parse_type_expr_hand(self, message: string) -> Result<TypeExpr, string> {
        let base = self.parse_type_atom(message)?
        // Union: A | B | C — lowest precedence in type position
        if self.check(Tk.Pipe) {
            mut result = base
            while self.check(Tk.Pipe) {
                self.advance()
                let rhs = self.parse_type_atom("expected type after `|`")?
                result = TypeExpr.Union(result, rhs)
            }
            return .Ok(result)
        }
        .Ok(base)
    }

    // Parse a single type atom (everything except union |).
    fn parse_type_atom(self, message: string) -> Result<TypeExpr, string> {
        // Fully-qualified type name `@pkg::mod::Type` — the renderer emits
        // resolved type names this way, so re-parsing a shipped `@comptime`
        // body's type annotations (e.g. `List<@std::avrac::core::ExprId>`)
        // must accept them here as well as at the top level (pqc9/znl0).
        if self.check(Tk.At) {
            let qname = self.parse_qualified_at_name()?
            // Qualified GENERIC (`@pkg::mod::Result<T, E>`) and OPTIONAL
            // (`@pkg::mod::Type?`) forms — mirror the bare-identifier
            // type-atom path below, which handles both suffixes.
            if self.check(Tk.Less) {
                let qargs = self.parse_generic_type_args()?
                let qte = TypeExpr.Generic(qname, qargs)
                if self.check(Tk.Question) {
                    self.advance()
                    return .Ok(TypeExpr.Optional(qte))
                }
                return .Ok(qte)
            }
            let qte = TypeExpr.Named(qname)
            if self.check(Tk.Question) {
                self.advance()
                return .Ok(TypeExpr.Optional(qte))
            }
            return .Ok(qte)
        }
        // qa6i probe 3: `~name` in type position splices a string-
        // valued local into a TypeExpr.Named at construction time.
        // The lowerer detects the leading `~` in the name field and
        // emits a runtime ctor that resolves it against the macro's
        // scope. Only fires inside a quote — outside, `~` in type
        // position is a parse error.
        if self.check(Tk.Tilde) && self.quote_depth > 0 {
            self.advance()
            if !self.check(Tk.Identifier) {
                self.set_error("expected identifier after `~` in type position")
                return .Err("parse error")
            }
            let splice_name = self.current_lexeme
            self.advance()
            return .Ok(TypeExpr.Named("~" + splice_name))
        }
        // dyn Trait — dynamic trait object
        if self.check(Tk.KwDyn) {
            self.advance()
            if !self.check(Tk.Identifier) {
                self.set_error("expected trait name after `dyn`")
                return .Err("parse error")
            }
            let trait_name = self.current_lexeme
            self.advance()
            let te = TypeExpr.Named(trait_name)
            if self.check(Tk.Question) {
                self.advance()
                return .Ok(TypeExpr.Optional(te))
            }
            return .Ok(te)
        }
        // fn(T, T) -> T
        if self.check(Tk.KwFn) {
            self.advance()
            // A completely BARE `fn` (no parens, no arrow) is the
            // under-determined function type `Fn(Unknown)` — "some function,
            // signature unspecified". Mapping it to `FnType([], Infer)` would
            // claim EXACTLY zero parameters (`fn()`), so any real closure
            // value fails the param-arity compare against it.
            if !self.check(Tk.LeftParen) && !self.check(Tk.Arrow) {
                return .Ok(TypeExpr.Named("fn"))
            }
            mut params: List<TypeExpr> = []
            if self.check(Tk.LeftParen) {
                self.advance()
                params = self.parse_type_expr_list()?
                if self.check(Tk.RightParen) { self.advance() }
            }
            mut ret = TypeExpr.Infer
            if self.check(Tk.Arrow) {
                self.advance()
                ret = self.parse_type_expr("expected return type after `->`")?
            }
            return .Ok(TypeExpr.FnType(params, ret))
        }
        // (T, U) → Tuple type
        if self.check(Tk.LeftParen) {
            self.advance()
            let types = self.parse_type_expr_list()?
            if !self.consume(Tk.RightParen, "expected `)` after tuple type") { return .Err("parse error") }
            // Build a Generic("__tuple", [T, U, ...]) that type_expr_to_vtype converts to Tuple
            if types.length == 1 {
                // Single-element parens: treat as grouping, not a 1-tuple
                return .Ok(types[0])
            }
            return .Ok(TypeExpr.Generic("__tuple", types))
        }
        // [T] → List type
        if self.check(Tk.LeftBracket) {
            self.advance()
            let inner = self.parse_type_expr("expected element type in `[T]`")?
            if !self.consume(Tk.RightBracket, "expected `]` after list type") { return .Err("parse error") }
            return .Ok(TypeExpr.ListType(inner))
        }
        if !self.check(Tk.Identifier) {
            self.set_error(message)
            return .Err("parse error")
        }
        mut name = self.current_lexeme
        self.advance()
        // Dotted path: core.ast.BinOp
        while self.check(Tk.Dot) {
            self.advance()
            if !self.check(Tk.Identifier) {
                self.set_error("expected identifier after '.' in type path")
                return .Err("parse error")
            }
            name = name + "." + self.current_lexeme
            self.advance()
        }
        // Generic arguments: Result<T, E>
        if self.check(Tk.Less) {
            let args = self.parse_generic_type_args()?
            let te = TypeExpr.Generic(name, args)
            if self.check(Tk.Question) {
                self.advance()
                return .Ok(TypeExpr.Optional(te))
            }
            return .Ok(te)
        }
        let te = TypeExpr.Named(name)
        if self.check(Tk.Question) {
            self.advance()
            return .Ok(TypeExpr.Optional(te))
        }
        .Ok(te)
    }

    fn parse_type_expr_list(self) -> Result<List<TypeExpr>, string> {
        mut out: List<TypeExpr> = []
        while !self.check(Tk.RightParen) && !self.check(Tk.Eof) {
            let ty = self.parse_type_expr("expected type")?
            out.push(ty)
            if self.check(Tk.Comma) { self.advance() }
        }
        .Ok(out)
    }

    fn parse_generic_type_args(self) -> Result<List<TypeExpr>, string> {
        self.advance()
        mut args: List<TypeExpr> = []
        mut first = true
        while !self.check(Tk.Greater) && !self.check(Tk.Eof) {
            if !first {
                if self.check(Tk.Comma) { self.advance() }
            }
            first = false
            let ty = self.parse_type_expr("expected generic type argument")?
            args.push(ty)
            // After an arg, a `>>`/`>>>` closer lexed as one shift token — peel
            // a single `>` so this list closes and the rest stays for the parent.
            self.maybe_split_shr()
        }
        if self.check(Tk.Greater) { self.advance() }
        .Ok(args)
    }

    fn parse_quote(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        self.advance()  // consume `quote`
        // Optional kind keyword: `stmt` / `stmts` / `type` / `decl` /
        // `arm` selects the result-type of the captured AST. Default
        // is `expr` — the captured body produces an Expr value at
        // runtime.
        let kind = self.parse_quote_kind()
        // Track quote nesting so parse_unary recognizes splice `~`.
        self.quote_depth = self.quote_depth + 1
        if kind == "arm" {
            let body_id = self.parse_quote_arm_body()?
            self.quote_depth = self.quote_depth - 1
            // Flipped Quote.body is an ExprId scalar (walker-opaque) — leaf row.
            return .Ok(self.alloc_at(Expr.Quote(kind, body_id), sp_start))
        }
        if kind == "type" {
            // `quote type { <type_expr> }` — parse the body as a TYPE
            // (not a block expression), so compound types (List<T>,
            // fn(int) -> int, Result<T,E>, T?, A | B, tuples, …) are
            // captured structurally instead of collapsing to Unknown.
            // The parsed type rides as an Expr.TypeLit carrier that
            // lower_quotes turns into the ValueType construction.
            let body_id = self.parse_quote_type_body()?
            self.quote_depth = self.quote_depth - 1
            return .Ok(self.alloc_at(Expr.Quote(kind, body_id), sp_start))
        }
        let body_id = self.parse_block_expression()?
        self.quote_depth = self.quote_depth - 1
        .Ok(self.alloc_at(Expr.Quote(kind, body_id), sp_start))
    }

    /// Parse `{ <type_expr> }` for `quote type { ... }`, converting the
    /// type to a ValueType and wrapping it in an Expr.TypeLit carrier.
    fn parse_quote_type_body(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        if !self.consume(Tk.LeftBrace, "expected `{` after `quote type`") { return .Err("parse error") }
        let te = self.parse_type_expr("expected a type inside `quote type { ... }`")?
        if !self.consume(Tk.RightBrace, "expected `}` after the type in `quote type`") { return .Err("parse error") }
        .Ok(self.alloc_at(Expr.TypeLit(type_expr_to_vtype(te)), sp_start))
    }

    fn parse_quote_kind(self) -> string {
        if self.check(Tk.KwType) {
            self.advance()
            return "type"
        }
        if self.check(Tk.Identifier) {
            let lex = self.current_lexeme
            if lex == "stmt" || lex == "stmts" || lex == "decl" || lex == "arm" {
                self.advance()
                return lex
            }
        }
        "expr"
    }

    /// Parse `{ pattern -> body }` for `quote arm { ... }`. Wraps the
    /// resulting arm in a single-armed `Expr.MatchExpr(<None-leaf id>, [arm])`
    /// so the existing Quote(kind, body) shape stays — the lowering
    /// pass picks the arm back out via its `arm` kind discriminator.
    fn parse_quote_arm_body(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        if !self.consume(Tk.LeftBrace, "expected `{` after `quote arm`") { return .Err("parse error") }
        let pat_id = self.parse_pattern_or()?
        let pattern = self.pat_of(pat_id)
        mut guard_id = ExprId(0)
        mut has_guard = false
        if self.check(Tk.KwIf) {
            self.advance()
            guard_id = self.parse_expression()?
            has_guard = true
        }
        if !self.consume(Tk.Arrow, "expected `->` after pattern in quote arm") { return .Err("parse error") }
        let body_id = self.parse_expression()?
        if self.check(Tk.Comma) { self.advance() }
        if !self.consume(Tk.RightBrace, "expected `}` after quote arm body") { return .Err("parse error") }
        let arm_guard_id: ExprId? = if has_guard { guard_id } else { none }
        let arm = MatchArm { pattern, pattern_id: pat_id, guard_id: arm_guard_id, body_id }
        let arms: List<MatchArm> = [arm]
        // The synthetic envelope's subject is a real `ExprId` (a leaf `Expr.None`
        // row) — a walker-opaque scalar, so it records NO edge. B-final F4b:
        // MatchArm is a MIXED node whose only walked child is the pattern; guard/
        // body are opaque `ExprId`s carried structurally — so `match_arm_children_
        // spanned` flattens to just the pattern.
        let subject_id = self.alloc_leaf(Expr.None)
        let edges: List<NodeRef> = [NodeRef.PatRef(pat_id)]
        .Ok(self.alloc_expr(Expr.MatchExpr(subject_id, arms), self.span_from(sp_start), edges))
    }

    // Parse `when { cond -> body, ... }` — subjectless match expression.
    // `When` is walker-opaque (WhenArm isn't a registered container struct):
    // the canonical ingest records NO children, so the native alloc mirrors
    // that as a leaf; the arms' natively-parsed rows orphan until WhenArm
    // registers with the walker.
    fn parse_when_expression(self) -> Result<ExprId, string> {
        let sp_start = self.current_start
        self.advance()  // consume `when`
        if !self.consume(Tk.LeftBrace, "expected `{` after `when`") { return .Err("parse error") }
        let arms = self.parse_when_arms()?
        if !self.consume(Tk.RightBrace, "expected `}` after when arms") { return .Err("parse error") }
        .Ok(self.alloc_at(Expr.When(arms), sp_start))
    }

    fn parse_when_arms(self) -> Result<List<WhenArm>, string> {
        mut out: List<WhenArm> = []
        while !self.check(Tk.RightBrace) {
            // `_ -> body` or `else -> body` is the default arm (null condition)
            mut cond_id: ExprId? = none
            if (self.check(Tk.Identifier) && self.current_lexeme == "_") || self.check(Tk.KwElse) {
                self.advance()
            } else {
                cond_id = self.parse_expression()?
            }
            if !self.consume(Tk.Arrow, "expected `->` after when condition") { return .Err("parse error") }
            let body_id = self.parse_expression()?
            out.push(WhenArm { cond_id, body_id })
        }
        .Ok(out)
    }

    // ── B1: native arena allocation ──
    //
    // Productions push the node they just built into `self.store` and return
    // its typed id; `edges` are the already-allocated children's refs in
    // walker (field) order. This store is the CANONICAL producer:
    // `parse_or_fail` (main.av) serves the compiled program from it. The
    // glue_ingest_* helpers below bridge the few still-boxed producers into
    // the store walker-faithfully: type expressions (`glue_ingest_type` — the
    // one remaining boxed producer, everywhere a TypeRef edge is recorded)
    // and three rare-path element sites (match-table synthesized arm bodies,
    // trait/impl signature elements).

    /// Allocate a parser-built `Expr` with its children's edge refs.
    fn alloc_expr(self, node: Expr, sp: ByteSpan, edges: List<NodeRef>) -> ExprId {
        self.store.add_expr(node, sp, edges)
    }

    /// Bridge a BOXED expr subtree from a still-boxed element producer into
    /// the store, returning its root id. Walker-driven, so the subtree's
    /// edges match what a native alloc records (used by the match-table
    /// synthesized arm-body site).
    fn glue_ingest_expr(self, node: Expr) -> ExprId {
        self.store.ingest_expr(node, byte_span_none())
    }

    /// Bridge a BOXED pattern subtree into the store, returning its root id
    /// (used by the match-table synthesized arm-pattern site).
    fn glue_ingest_pat(self, node: Pattern) -> PatId {
        self.store.ingest_pat(node, byte_span_none())
    }

    /// Bridge a BOXED type subtree (type expressions are still boxed
    /// producers) into the store, returning its root id.
    fn glue_ingest_type(self, node: ValueType) -> TypeId {
        self.store.ingest_type(node, byte_span_none())
    }

    /// Boxed readback of an allocated pattern — an O(1) row read.
    fn pat_of(self, id: PatId) -> Pattern {
        self.store.pats.get(id)
    }

    /// Alloc a pattern LEAF (no node children) — the arena's one-push path,
    /// interning pure literal/wildcard patterns (§14.4; see `pat_intern_key`).
    fn alloc_pat_leaf(self, node: Pattern) -> PatId {
        self.store.intern_pat_leaf(node)
    }

    /// Row twin of `expr_force_unwrap(Ident(name))`: subject leaf + fresh
    /// callee leaf, both carried in the flipped Call's id fields (a leaf row
    /// post-F3b) — the ONE place this ordering convention lives (the if-let
    /// and let-else desugars both mint it).
    fn alloc_force_unwrap_row(self, name: string) -> ExprId {
        let subject_id = self.alloc_leaf(Expr.Ident(name))
        let callee_id = self.alloc_leaf(Expr.Ident(FORCE_UNWRAP_FN))
        self.alloc_leaf(Expr.Call(callee_id, [subject_id]))
    }

    /// Row twin of an `<ident> == none` / `!= none` test: an `<ident>` leaf
    /// and a `none` leaf under a Binary row holding their ids. `op` picks the
    /// present (`Ne`) or absent (`Eq`) comparison the optional desugars branch on.
    fn alloc_none_check_row(self, name: string, op: BinOp) -> ExprId {
        let left_id = self.alloc_leaf(Expr.Ident(name))
        let right_id = self.alloc_leaf(Expr.None)
        self.alloc_leaf(Expr.Binary(left_id, op, right_id))
    }

    /// Boxed readback of an allocated expr — an O(1) row read. The chain uses
    /// it to embed already-allocated children into a parent's boxed payload.
    fn expr_of(self, id: ExprId) -> Expr {
        self.store.exprs.get(id)
    }

    /// Alloc an expr LEAF (no node children) — the arena's one-push path,
    /// interning pure literal/ident leaves so repeat occurrences share one
    /// row (§14.4; eligibility lives in `expr_intern_key` — childful payloads
    /// like the desugar-minted Call/Binary rows fall through per-occurrence).
    fn alloc_leaf(self, node: Expr) -> ExprId {
        self.store.intern_expr_leaf(node)
    }

    /// Alloc a BARE compound expr row with a REAL byte span covering
    /// [start, current token): the production captured `start`
    /// (self.current_start) before consuming its first token, and by
    /// allocation time the lexer has staged the token AFTER the expression —
    /// the same [lo, next-token) convention Stmt.Error spans use. §14.2's
    /// missing half for bare children: Binary operands, sub-exprs, and
    /// call-shaped nodes previously kept the byte_span_none() sentinel.
    /// Only for variants OUTSIDE the intern whitelist (childful/compound
    /// nodes — never interned): pure literal/ident leaves stay span-free by
    /// design, because interned rows are shared across occurrences and must
    /// not carry any one occurrence's position.
    fn alloc_at(self, node: Expr, start: int) -> ExprId {
        self.store.add_expr(node, self.span_from(start), [])
    }

    /// The [start, current token) byte span `alloc_at` stamps — exposed for
    /// the few edge-carrying productions that go through `alloc_expr`
    /// directly (match, channel) so they use the same convention.
    fn span_from(self, start: int) -> ByteSpan {
        byte_span(start, self.current_start)
    }

    /// Edge refs for a plain id list (arg-only nodes like EnumCtor).
    fn edges_of_ids(self, ids: List<ExprId>) -> List<NodeRef> {
        mut refs: List<NodeRef> = []
        for id in ids { refs.push(NodeRef.ExprRef(id)) }
        refs
    }

    /// Edge refs `[subject, arg0, arg1, …]` — the walker order shared by
    /// Call-shaped nodes (Call, OptionalMethodCall, GenericCall).
    fn edges_subject_args(self, subject: ExprId, arg_ids: List<ExprId>) -> List<NodeRef> {
        mut refs: List<NodeRef> = [NodeRef.ExprRef(subject)]
        for id in arg_ids { refs.push(NodeRef.ExprRef(id)) }
        refs
    }


    // ── B1 stmt-side allocation ──
    // The statement mirror of the expr helpers above: stmt productions push
    // their node into `self.store` and return its typed id.

    /// Allocate a parser-built `Stmt` with its children's edge refs.
    fn alloc_stmt(self, node: Stmt, sp: ByteSpan, edges: List<NodeRef>) -> StmtId {
        self.store.add_stmt(node, sp, edges)
    }

    /// Bridge a BOXED stmt subtree from a still-boxed element producer into
    /// the store, returning its root id (see `glue_ingest_expr`; used by the
    /// trait/impl signature-element sites).
    fn glue_ingest_stmt(self, node: Stmt) -> StmtId {
        self.store.ingest_stmt(node, byte_span_none())
    }

    /// Boxed readback of an allocated stmt — an O(1) row read.
    fn stmt_of(self, id: StmtId) -> Stmt {
        self.store.stmts.get(id)
    }

    /// Alloc a stmt LEAF (no node children) — the arena's one-push path.
    fn alloc_stmt_leaf(self, node: Stmt) -> StmtId {
        self.store.stmts.add_leaf(node)
    }

    /// Edge refs for a stmt-id list (block bodies, decl bodies).
    fn edges_of_stmt_ids(self, ids: List<StmtId>) -> List<NodeRef> {
        mut refs: List<NodeRef> = []
        for id in ids { refs.push(NodeRef.StmtRef(id)) }
        refs
    }

    // ── Speculative parsing (backtracking) ──

    // Snapshot / restore the lexer+parser position for a speculative parse. The
    // two are kept symmetric: every field saved here is restored below.
    //
    // `prev_line` is in the snapshot (cpi6) because the newline-sensitivity
    // readers (cell-mode continuation, dot_is_postfix, same-line postfix-call
    // attach) consult it — a backtrack that left it stale would mis-decide on the
    // re-parse. It has no dedicated spec test because the current callers don't
    // expose the staleness: each backtrack/restore is followed by an `advance()`
    // (which refreshes prev_line) before any reader runs — `try_parse_generic_call`
    // has parse_comparison re-consume the backtracked `<`, and is_stmt_map_literal
    // is followed by parse_statement consuming the `{`. So the guard is the
    // SELFHOST DIFFERENTIAL (byte-identical IR), not a `.av` fixture (verified:
    // parsing 881 real `.av` files is unaffected by the restore). Keeping prev_line
    // in the snapshot stays correct if a future caller reads it before that advance.
    //
    // NOT snapshotted, by design: `gensym_seq` ONLY — a monotonic hygiene
    // counter, so rolling it back would re-mint an already-issued temp name.
    // Every other mutable field IS snapshotted now, including the context-mode
    // flags (allow_struct_lit / allow_dot_postfix / cell_mode / allow_it_sugar /
    // quote_depth): a backtrack must restore them so a failed lookahead cannot
    // leak a mode change into the retry (previously these were a hand-synced
    // subset that callers had to balance locally — a latent drift hazard).
    fn save_state(self) -> ParserState {
        ParserState {
            start: self.start, current: self.current,
            line: self.line, column: self.column,
            current_kind: self.current_kind, current_lexeme: self.current_lexeme,
            current_line: self.current_line, current_column: self.current_column,
            prev_line: self.prev_line,
            current_start: self.current_start,
            had_error: self.had_error, error_message: self.error_message,
            allow_struct_lit: self.allow_struct_lit, allow_dot_postfix: self.allow_dot_postfix,
            cell_mode: self.cell_mode, allow_it_sugar: self.allow_it_sugar,
            quote_depth: self.quote_depth,
            bag: self.bag,
            store_mark: self.store.mark(),
        }
    }

    fn restore_state(self, state: ParserState) {
        self.start = state.start
        self.current = state.current
        self.line = state.line
        self.column = state.column
        self.current_kind = state.current_kind
        self.current_lexeme = state.current_lexeme
        self.current_line = state.current_line
        self.current_column = state.current_column
        self.prev_line = state.prev_line
        self.current_start = state.current_start
        self.had_error = state.had_error
        self.error_message = state.error_message
        self.allow_struct_lit = state.allow_struct_lit
        self.allow_dot_postfix = state.allow_dot_postfix
        self.cell_mode = state.cell_mode
        self.allow_it_sugar = state.allow_it_sugar
        self.quote_depth = state.quote_depth
        self.bag = state.bag
        self.store.truncate_to_mark(state.store_mark)
    }

    // Skip a balanced `< ... >` bracket group, handling nesting.
    // Used in impl blocks where we don't yet parse type params.
    fn skip_angle_brackets(self) {
        self.advance()  // consume `<`
        mut depth = 1
        while depth > 0 && !self.check(Tk.Eof) {
            self.maybe_split_shr()   // a nested `>>` close counts as one `>` here
            if self.check(Tk.Less) {
                depth = depth + 1
            } else if self.check(Tk.Greater) {
                depth = depth - 1
            }
            self.advance()
        }
    }

    // Collect angle-bracket content as a string: <EmitValue, string> -> "<EmitValue, string>"
    fn collect_angle_brackets(self) -> string {
        self.advance()  // consume `<`
        mut result = "<"
        mut depth = 1
        while depth > 0 && !self.check(Tk.Eof) {
            if self.check(Tk.Less) {
                depth = depth + 1
                result = "${result}<"
            } else if self.check(Tk.Greater) {
                depth = depth - 1
                result = "${result}>"
            } else if self.check(Tk.Comma) {
                result = "${result}, "
            } else {
                result = "${result}${self.current_lexeme}"
            }
            self.advance()
        }
        result
    }

    fn set_error(self, message: string) {
        self.report(DiagCode.SyntaxError, message)
    }

    fn report(self, code: DiagCode, message: string) {
        // Always add to the bag — even if we already had an error.
        // This lets us show ALL parse errors, not just the first.
        //
        // `span_at`, not `span_new`: the parser KNOWS its file, and dropping it
        // made every parse diagnostic file-less (t-kdyj.8). `render_diagnostic`
        // already prefers `diag.span.file` over the caller-supplied path, so a
        // file-less span silently rendered a MODULE file's error against the
        // ENTRY file — reporting `src/avrac.av:296:9` for a 20-line entry,
        // with no snippet, because line 296 does not exist there. The line was
        // right and the filename was wrong, which is worse than no location.
        //
        // `self.file` is "" for the entry parse by design (see
        // `parse_program_source_at`), and `span_at` with "" is exactly
        // `span_new` — so the entry path is unchanged, and only merged-module
        // parses gain the attribution they were missing.
        let sp = span_at(self.current_start, self.current, self.current_line, self.current_column, self.file)
        let diag = diag_error(code, message, sp)
        self.bag = bag_report(self.bag, diag)
        // Set had_error + message for backward compat (first error wins)
        if !self.had_error {
            self.had_error = true
            self.error_message = "parse error at ${string(self.current_line)}:${string(self.current_column)}: ${message}"
        }
    }

    // Panic-mode recovery: skip tokens until we find something that
    // looks like the start of a new statement. This lets us resume
    // parsing and find more errors.
    fn synchronize(self) {
        while !self.check(Tk.Eof) {
            if self.current_kind in [Tk.KwFn, Tk.KwLet, Tk.KwConst, Tk.KwMut, Tk.KwType, Tk.KwEnum, Tk.KwImpl, Tk.KwIf, Tk.KwWhile, Tk.KwFor, Tk.KwMatch, Tk.KwReturn, Tk.KwExtern, Tk.KwTrait, Tk.KwDefer, Tk.KwSpec, Tk.KwGiven, Tk.KwThen, Tk.KwSelect, Tk.RightBrace] {
                return
            }
            self.advance()
        }
    }
}
