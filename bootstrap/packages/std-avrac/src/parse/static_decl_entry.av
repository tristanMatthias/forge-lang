// WHY: ps3t.6.7 Phase 2 — the production boundary binding the CHECKED-IN generated
// static parser (parse.gen_parser's `parse_declaration`) to the shared-token
// runner (run_static_snode_at_shared). Sibling of static_expr_entry.av.
// Kept as a THIN, separate module so parse/mod.av imports ONE clearly-named runner
// (`run_static_decl`) instead of the generated module's free `parse_declaration`,
// which would shadow the Parser method of the same name. The static entries are
// the only places the generated module is imported, so the emitter (emit.av /
// gen_parser_files) stays out of the production graph entirely — mod.av →
// static_decl_entry → gen_parser → grammar builders, never → emit.av.

use parse.gen_parser.{parse_declaration}
use parse.{Parser}
use features.grammar.{run_static_snode_at_shared, Token, PState, CapVal, ExprModes, DslStmtResult, LexDiag}
use core.{NodeStore}

/// Drive the generated static DECLARATION parser over the shared token stream at
/// `start_byte`, threading the outer parser's live modes + @hand delegate — the
/// static sibling of run_dsl_decl_at_shared (the Grammar-tree interpreter). Same
/// PState, same builders, same @hand leaves (run_hand_stmt for the whole-item
/// dispatch) ⇒ byte-identical AST, at straight-line speed (no exec_rule grammar
/// walk / per-node capture-env allocation). The whole top-level dispatch — the only
/// work the interpreter did in production after the single-level-delegate landing —
/// is now generated straight-line code.
export fn run_static_decl(lex_diags: List<LexDiag>, toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, modes: ExprModes, delegate: Parser?) -> DslStmtResult {
    run_static_snode_at_shared(lex_diags, toks, start_byte, src, file, store, modes, delegate, parse_declaration)
}
