use parse.{byte_at, cc_is_ident_cont, cc_is_digit, UNDERSCORE, cc_is_hex_digit, cc_is_binary_digit, cc_is_octal_digit, LF, DQUOTE, DOLLAR, LBRACE, BACKSLASH, BACKTICK, LOWER_N, LOWER_T, LOWER_R, DIGIT_0, RBRACE, SQUOTE, SLASH, STAR}

/// GENERATED byte-run scanner for the `ident` char-class run.
export fn scan_ident_run(src: bytes, start: int) -> int {
