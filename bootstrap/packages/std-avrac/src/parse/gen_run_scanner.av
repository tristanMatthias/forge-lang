/// GENERATED from escape_rules(). Resolve the escape whose LEAD byte sits at `esc_pos`
/// (just past the backslash). `delim` is the caller's own closing delimiter — the ONE
/// escape that is not universal, since a string escapes `\"` and a char literal `\\'`.
/// Everything else is identical across the three literal forms, which is why one
/// resolver can serve all of them instead of the three drifting ladders it replaced.
/// GENERATED from escape_rules(). The code point for a UNIVERSAL escape lead, or -1.
/// The char-literal form wants an int, not a lexeme, and rejects what it does not
/// recognise — so it takes this accessor and keeps its own policy.
export fn escape_code(b: int) -> int {
    if b == LOWER_N { return 10 }
    if b == LOWER_T { return 9 }
    if b == LOWER_R { return 13 }
    if b == DIGIT_0 { return 0 }
    if b == BACKSLASH { return 92 }
    -1
}

export fn resolve_escape(src: bytes, text: string, esc_pos: int, delim: int) -> EscapeRes {
    let b = byte_at(src, esc_pos)
    if b == -1 { return EscapeRes { text: "", consumed: 1 } }
    if b == delim { return EscapeRes { text: text.substring(esc_pos, esc_pos + 1), consumed: 2 } }
    if b == LOWER_N { return EscapeRes { text: "\n", consumed: 2 } }
    if b == LOWER_T { return EscapeRes { text: "\t", consumed: 2 } }
    if b == LOWER_R { return EscapeRes { text: "\r", consumed: 2 } }
    if b == DIGIT_0 { return EscapeRes { text: "\0", consumed: 2 } }
    if b == BACKSLASH { return EscapeRes { text: "\\", consumed: 2 } }
    if b == LOWER_X {
        let hi = byte_at(src, esc_pos + 1)
        let lo = byte_at(src, esc_pos + 2)
        if hi != -1 && lo != -1 {
            return EscapeRes { text: avra_char_from_hex(text.substring(esc_pos + 1, esc_pos + 2), text.substring(esc_pos + 2, esc_pos + 3)), consumed: 4 }
        }
    }
    // Unknown escape: VERBATIM, backslash included — the hand behaviour, preserved.
    EscapeRes { text: "\\" + text.substring(esc_pos, esc_pos + 1), consumed: 2 }
}
