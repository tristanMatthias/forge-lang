/// GENERATED byte-run scanner up to the `to_eol` terminator (exclusive).
export fn scan_to_eol(src: bytes, start: int) -> int {
    mut end = start
    while byte_at(src, end) != -1 && byte_at(src, end) != LF { end = end + 1 }
    end
}

/// GENERATED string-body scanner for the `dq_body` mode. Stops BEFORE the
/// close delimiter, the interpolation lead, or EOF (exclusive end).
export fn scan_dq_body(src: bytes, start: int) -> int {
    mut end = start
    while byte_at(src, end) != -1 {
        // An escape consumes the backslash AND the byte after it, so a
        // `\` + close does not terminate and `\` + interp does not suspend.
        if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {
            end = end + 2
            continue
        }
        if byte_at(src, end) == DQUOTE || (byte_at(src, end) == DOLLAR && byte_at(src, end + 1) == LBRACE) { return end }
        end = end + 1
    }
    end
}

/// GENERATED string-body scanner for the `tmpl_body` mode. Stops BEFORE the
/// close delimiter, the interpolation lead, or EOF (exclusive end).
export fn scan_tmpl_body(src: bytes, start: int) -> int {
    mut end = start
    while byte_at(src, end) != -1 {
        if byte_at(src, end) == BACKTICK { return end }
        end = end + 1
    }
    end
}

/// GENERATED string-body scanner for the `raw_body` mode. Stops BEFORE the
/// close delimiter, the interpolation lead, or EOF (exclusive end).
export fn scan_raw_body(src: bytes, start: int) -> int {
    mut end = start
    while byte_at(src, end) != -1 {
        if byte_at(src, end) == DQUOTE || byte_at(src, end) == LF { return end }
        end = end + 1
    }
    end
}

/// GENERATED string-body scanner for the `ml_body` mode. Stops BEFORE the
/// close delimiter, the interpolation lead, or EOF (exclusive end).
export fn scan_ml_body(src: bytes, start: int) -> int {
    mut end = start
    while byte_at(src, end) != -1 {
        // An escape consumes the backslash AND the byte after it, so a
        // `\` + close does not terminate and `\` + interp does not suspend.
        if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {
            end = end + 2
            continue
        }
        if (byte_at(src, end) == DQUOTE && byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE) || (byte_at(src, end) == DOLLAR && byte_at(src, end + 1) == LBRACE) { return end }
        end = end + 1
    }
    end
}

/// GENERATED string-body scanner for the `raw_ml_body` mode. Stops BEFORE the
/// close delimiter, the interpolation lead, or EOF (exclusive end).
export fn scan_raw_ml_body(src: bytes, start: int) -> int {
    mut end = start
    while byte_at(src, end) != -1 {
        if (byte_at(src, end) == DQUOTE && byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE) { return end }
        end = end + 1
    }
    end
}

/// GENERATED nesting scanner for `block_comment`. Returns the offset PAST the
/// balancing close, or EOF if the nesting never balances.
export fn scan_block_comment(src: bytes, start: int) -> int {
    mut end = start
    mut depth = 0
    while byte_at(src, end) != -1 {
        if byte_at(src, end) == SLASH && byte_at(src, end + 1) == STAR {
            depth = depth + 1
            end = end + 2
            continue
        }
        if byte_at(src, end) == STAR && byte_at(src, end + 1) == SLASH {
            depth = depth - 1
            end = end + 2
            if depth == 0 { return end }
            continue
        }
        end = end + 1
    }
    end
}

/// GENERATED interpolation-region scanner for `interp_region`. `start` is AT the
/// opening lead; returns the offset PAST the balancing close, or EOF if it never
/// balances. Depth counts BARE opens, which are not the same bytes as the lead.
export fn scan_interp_region(src: bytes, start: int) -> int {
    mut end = start
    if byte_at(src, end) == DOLLAR && byte_at(src, end + 1) == LBRACE {
        end = end + 2
    }
    mut depth = 1
    while byte_at(src, end) != -1 {
        if byte_at(src, end) == LOWER_R && byte_at(src, end + 1) == DQUOTE {
            if byte_at(src, end + 2) == DQUOTE && byte_at(src, end + 3) == DQUOTE {
                end = end + 4
                while byte_at(src, end) != -1 {
                    if byte_at(src, end) == DQUOTE && byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE {
                        end = end + 3
                        break
                    }
                    end = end + 1
                }
                continue
            }
            end = end + 2
            while byte_at(src, end) != -1 && byte_at(src, end) != DQUOTE { end = end + 1 }
            if byte_at(src, end) != -1 { end = end + 1 }
            continue
        }
        if byte_at(src, end) == SQUOTE {
            end = end + 1
            while byte_at(src, end) != -1 && byte_at(src, end) != SQUOTE {
                if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {
                    end = end + 2
                    continue
                }
                end = end + 1
            }
            if byte_at(src, end) != -1 { end = end + 1 }
            continue
        }
        if byte_at(src, end) == BACKTICK {
            end = end + 1
            while byte_at(src, end) != -1 && byte_at(src, end) != BACKTICK { end = end + 1 }
            if byte_at(src, end) != -1 { end = end + 1 }
            continue
        }
        if byte_at(src, end) == DQUOTE {
            if byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE {
                end = end + 3
                while byte_at(src, end) != -1 {
                    if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {
                        end = end + 2
                        continue
                    }
                    if byte_at(src, end) == DQUOTE && byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE {
                        end = end + 3
                        break
                    }
                    end = end + 1
                }
                continue
            }
            end = end + 1
            while byte_at(src, end) != -1 && byte_at(src, end) != DQUOTE {
                if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {
                    end = end + 2
                    continue
                }
                end = end + 1
            }
            if byte_at(src, end) != -1 { end = end + 1 }
            continue
        }
        if byte_at(src, end) == LBRACE { depth = depth + 1 }
        if byte_at(src, end) == RBRACE {
            depth = depth - 1
            if depth == 0 { return end + 1 }
