// WHY: t-47hc.2 (Phase 1) — the DECLARATIVE operator/punctuation lexical grammar.
// This is the concrete form of "just say `">>" = Shr`": every fixed-spelling
// terminal the lexer recognises, as DATA (`LitRule { spelling, tk }`), instead of
// the hand lexer's ~40 open-coded `set_current(Tk.Shr, ">>")` arms that used to
// live in `advance_token` (parse/lexer.av). It is the single SOURCE OF TRUTH for
// the spelling<->token binding — the one place a spelling names its token.
//
// This file is DATA, not the runtime scanner — it does NOT walk a table per byte
// (the "interpret a table" anti-pattern the design forbids: "the DFA lexer EMITS
// branches not a runtime table"). A later slice's GENERATOR reads these rules and
// COMPILES them into a maximal-munch branch tree (the scan_compound_op shape),
// exactly as features/grammar/emit.av compiles the parser Grammar into recursive
// descent. "Compile the grammar, don't interpret it" — this is the grammar; the
// generator is the compile.
//
// MAXIMAL MUNCH is a SEMANTIC the generator enforces by grouping rules per lead
// byte and trying them LONGEST-FIRST (`>>`/`>=` before `>`), so the `spelling`
// SET here is order-independent — the rules are listed longest-first per family
// only for human readability. token_table_test.av proves every rule is faithful to
// the hand lexer (each spelling lexes to exactly its declared token) THROUGH the
// same `lex_dump` oracle the byte-scanner uses.
use core.{KwId, Tk, OpId, kw_rows, op_rows}

/// One fixed-spelling terminal: the exact source text `spelling` lexes to token
/// kind `tk`. The declarative `">>" = Tk.Shr` binding. `spelling` is pure ASCII
/// (every operator/punctuation byte is < 128), so its byte length == its char
/// length — the generator can branch on raw bytes without a codepoint decode.
export type LitRule = { spelling: string, tk: Tk }

/// The result of matching the operator/punctuation table at a source position:
/// the token `tk`, how many bytes it consumed (`len`), and the token's canonical
/// `spelling` — a STATIC string literal in the generated scanner, so a caller uses
/// it as the lexeme with ZERO allocation (an operator's source bytes always equal
/// its canonical spelling, so this is byte-identical to slicing the source, but
/// free — matching the hand lexer's old `set_current(Tk.Arrow, "->")` constants).
/// `len == 0` is the no-match sentinel (the byte starts no operator) — `tk` is then
/// `Tk.Error`, `spelling` is `""`, and callers must not consume. Produced by the
/// generated maximal-munch scanner (parse/gen_operator_scanner.av, from emit_lex.av).
export type OpMatch = { tk: Tk, len: int, spelling: string }

/// The COMPLETE operator + single-character-punctuation table — every
/// fixed-spelling terminal `advance_token` (parse/lexer.av) can emit, save the
/// comment/quote LEADS (`//` `/*` `"` `'` `` ` ``) that open lexer MODES rather
/// than a fixed token (those are a later slice). Grouped by lead byte, longest
/// form first so the maximal-munch intent reads off the page; the generator
/// re-derives that order by sorting on spelling length, so entries may appear in
/// any order without changing behaviour.
///
/// Kept in lockstep with the hand lexer's arms — token_table_test.av fails the
/// moment a rule here disagrees with `lex_dump`, and asserts the count so a
/// dropped or stray rule can't slip through.
/// DERIVED, not declared. Every operator row is `spelling -> Tk.<variant>`, and core's
/// `op_rows()` already states that pairing as the single source `opid_spelling` and
/// `tk_name` also read. Listing the 38 pairs again here was a second declaration free to
/// drift from the first — the same duplication `keyword_rules()` shed.
///
/// The `tk` a row carries is still the BARE variant (`Tk.Comma`), not `Tk.Op(OpId.Comma)`:
/// Phase A only introduces the collapsed token, and nothing constructs it until the seed
/// train advances (t-y2i7.15).
export fn operator_rules() -> List<LitRule> {
    mut out: List<LitRule> = []
    for r in op_rows() { out.push(LitRule { spelling: r.spelling, tk: r.tk }) }
    out
}

/// The exact rule count `operator_rules` must have — a truncation/stray-entry
/// guard (token_table_test.av asserts `operator_rules().length == OPERATOR_RULE_COUNT`).
/// BUMP THIS when the operator set legitimately changes, in lockstep with the hand
/// lexer — the deliberate speed-bump that keeps this table complete.
export const OPERATOR_RULE_COUNT = 38

/// The COMPLETE keyword table — every reserved word `p_keyword_kind` recognises,
/// as the SAME declarative `LitRule { spelling, tk }` data the operators use. This
/// is the SOURCE OF TRUTH the exact-match keyword recogniser (classify_keyword,
/// parse/gen_keyword_scanner.av) is compiled from by emit_lex.av — a byte-trie that
/// replaces p_keyword_kind's ~59-arm string-comparison ladder (which strcmp'd every
/// keyword on EVERY identifier, the lexer's most common token). Keywords are pure
/// lowercase ASCII, so the trie branches on raw bytes with no codepoint decode.
///
/// Several reserved future keywords collapse to the SAME token (Tk.KwReserved); the
/// trie handles that naturally (many terminals, one tk). Kept in lockstep with
/// p_keyword_kind — token_table_test.av lexes every spelling through lex_dump and
/// asserts the count, so a dropped or renamed keyword fails the suite.
/// The RESERVED-FUTURE spellings. Twelve words the lexer recognises so they
/// cannot be used as identifiers, all mapping to the single `KwId.Reserved`.
/// They stay listed here rather than in core's `kw_rows()` because that table is
/// keyed `id -> spelling`, and twelve spellings sharing one id is not a function.
/// They are also the one class no feature owns — reserving a word means exactly
/// that — which is why `keyword_agreement_test` exempts them and nothing else.
export fn reserved_spellings() -> List<string> {
    [
        "async",
        "await",
        "yield",
        "move",
        "ref",
        "unsafe",
        "macro",
        "systems",
        "bare",
        "hardware",
        "owned",
        "borrow"
    ]
}

/// DERIVED, not declared. Every keyword row is `spelling -> Tk.Keyword(id)`, and
/// core's `kw_rows()` already states that pairing as the single source it also
/// derives `kwid_name` and `kwid_keyword_str` from. Listing them again here was
/// a second declaration of the same 47 facts, free to drift from the first.
///
/// Adding a keyword is now: one row in `kw_rows()` (core/ast.av) plus its
/// `KwId` variant. This function, both name helpers, and the generated keyword
/// scanner all follow. `keyword_agreement_test` pins the result against what the
/// feature grammars declare, so a keyword that exists here and nowhere else — or
/// vice versa — is a red test rather than a silent misfire.
export fn keyword_rules() -> List<LitRule> {
    mut out: List<LitRule> = []
    for r in kw_rows() { out.push(LitRule { spelling: r.spelling, tk: Tk.Keyword(r.id) }) }
    for sp in reserved_spellings() { out.push(LitRule { spelling: sp, tk: Tk.Keyword(KwId.Reserved) }) }
    out
}

/// The exact keyword count `keyword_rules` must have (token_table_test.av guard).
/// BUMP in lockstep with keyword_rules when the reserved-word set changes.
export const KEYWORD_RULE_COUNT = 60

// ── Character-CLASS RUN terminals ─────────────────────────────────
/// One character-class RUN terminal: a maximal run of bytes each satisfying `pred`
/// (a `cc_is_*` classifier in parse/charclass.av), OPTIONALLY also allowing the
/// separator byte named by `sep` (a byte constant in parse/ascii.av; `""` = none).
/// Scanned into `scan_<name>_run`. This is the char-class-RUN analog of `LitRule`'s
/// fixed spellings — the declarative form of the hand lexer's
/// `while cc_is_X(byte_at(...)) [|| ... == SEP] { end += 1 }` loops. `pred` names the
/// classifier the generated loop calls; `sep` (e.g. `"UNDERSCORE"`) is the digit-group
/// separator numbers allow; `name` names the emitted scanner. Unlike operators/keywords
/// there is NO trie (a run is one class, not a set of spellings); the generator emits a
/// single byte-scan loop per rule.
export type CharRun = { name: string, pred: string, sep: string }

/// The char-class RUN terminals the lexer scans, compiled to
/// `scan_<name>_run(src, start) -> end` byte-scan loops by parse/emit_lex.av
/// (parse/gen_run_scanner.av). Single source of truth for the lexer's char-class runs:
/// the identifier CONTINUATION run (no separator) and the number-family digit runs
/// (decimal/hex/binary/octal, each allowing the `_` group separator).
export fn char_run_rules() -> List<CharRun> {
    table<CharRun> {
        name    | pred                 | sep
        "ident" | "cc_is_ident_cont"   | ""
        "dec"   | "cc_is_digit"        | "UNDERSCORE"
        "hex"   | "cc_is_hex_digit"    | "UNDERSCORE"
        "bin"   | "cc_is_binary_digit" | "UNDERSCORE"
        "oct"   | "cc_is_octal_digit"  | "UNDERSCORE"
    }
}

// A DELIMITED run is the complement of a char-class run: instead of scanning WHILE a
// class holds, it scans UNTIL a terminator byte (or EOF). `term` is a byte-const name
// (parse/ascii.av). The generated `scan_<name>(src, start) -> end` returns the exclusive
// end offset of the verbatim region `[start, term|EOF)`. The caller owns line/column;
// a delim rule is wired only where the region is newline-free by construction (an
// EOL-terminated run cannot contain the LF it stops at), so the caller's take_run
// (column += length, line unchanged) is byte-identical to the old advance_byte loop.
export type DelimRun = { name: string, term: string }

/// The delimited RUN terminals the lexer scans, compiled to `scan_<name>(src, start) ->
/// end` byte-scan-until loops by parse/emit_lex.av (parse/gen_run_scanner.av). Single
/// source of truth: the to-end-of-line verbatim runs — the `///`/`//!` doc-comment body
/// and the `//` line-comment body, both scanning to the next LF (newline-free runs).
export fn delim_run_rules() -> List<DelimRun> {
    table<DelimRun> {
        name     | term
        "to_eol" | "LF"
    }
}

/// t-bw9s / lexer flip — the STRING-BODY runs.
///
/// The third rule shape, and the one `delim_run_rules`' doc calls "a later slice": a
/// quote LEAD opens a MODE, and the body inside it is not a plain scan-until because two
/// things interrupt it. An ESCAPE (`\`) consumes the next byte whatever it is, so a
/// `\"` does not close the string; and an INTERPOLATION lead (`{`) suspends the scan so
/// the parser can take over for a nested expression and resume after.
///
/// Both are expressible as data, which is what makes this a table rule rather than
/// hand-written control flow: `escape` says whether `\` is honoured, `interp` names the
/// byte that suspends (or "" for a mode that has none). The generated scanner stops
/// BEFORE the close, the interp lead, or EOF, exclusive-end like every other run here —
/// so the caller inspects `byte_at(src, end)` to learn WHICH, exactly as it does for a
/// delim run.
///
/// The four modes, and why they differ only in these two fields:
///   dq_body    `"…"`  escapes, interpolates   — the ordinary string
///   tmpl_body  `` `…` ``  escapes, interpolates — template literal, different delimiter
///   (there is deliberately NO sq_body: `'x'` is a CHARACTER literal, not a string
///   body. `lexer.av scan_char_literal` reads exactly ONE codepoint — or one escape
///   pair — and then REQUIRES the closing quote, so `'abc'` is an error, not a
///   3-byte body. A scan-until-quote run describes no lexer in this language.)
///   raw_body   `r"…"` NO escapes, NO interpolation — raw string, `\` is a literal byte
/// `interp_a`/`interp_b` are the TWO bytes of the interpolation lead. The lead is `${`,
/// not a bare `{` — a lone `{` inside a string is an ORDINARY character (spec §Strings:
/// "a bare `{` is an ordinary character and needs no escape"). A one-byte lead was the
/// original shape here and it was WRONG: it would have stopped the body at every literal
/// brace, so `"a{b}"` would have tokenised as a suspended interpolation. Both bytes must
/// match to suspend; `interp_a == ""` means the mode does not interpolate at all.
/// `stop_nl` marks a mode whose body may NOT span a newline. A single-line raw string is
/// the one such mode: `lexer.av scan_raw_string` reports F0002 `unterminated raw string`
/// at an LF, where an ordinary `"…"` body runs straight through one. Without this the
/// generated `scan_raw_body` walked past the newline to a closing quote on a LATER line —
/// a different tokenisation, and the same "describes a lexer that does not exist" defect
/// the interpolation lead and the backtick mode each had.
/// `close_rep` is how many CONSECUTIVE close bytes end the body — 1 for `"…"`, 3 for the
/// triple-quoted forms. A one-byte close cannot express `"""…"""`: a multiline body contains
/// ordinary `"` bytes, so stopping at the first would truncate it.
/// One resolved escape: the TEXT it produces and how many SOURCE bytes it spanned
/// (2 for `\\n`, 4 for `\\xNN`). `consumed` is what lets one resolver serve callers that
/// advance byte-by-byte and callers that slice.
export type EscapeRes = { text: string, consumed: int }

/// The UNIVERSAL escape map: the byte after `\\`, and the code point it produces.
///
/// Universal because these six mean the same thing in every literal form. What is NOT here
/// is deliberately not universal: the DELIMITER escape (`\\"` in a string, `\\'` in a char
/// literal) differs per run and the run already carries its own `close`, and `\\x` is
/// variable-length so it cannot be a byte→byte row.
///
/// This existed three times before — `scan_char_literal`, `scan_string_token`, and
/// `scan_multiline_string` each had their own if/else ladder, and the three had drifted
/// (the char one honours `\\'` and not `\\"`, the string ones the reverse). Three
/// implementations of one mapping is the defect this whole table exists to remove.
/// `text_src` is the escape's replacement AS IT MUST APPEAR IN GENERATED SOURCE — the two
/// characters `\\` `n`, not a newline. The emitter pastes it into a string literal, so the
/// literal form is what the table has to hold.
export type EscapeRule = { lead: string, text_src: string, code: int }

/// Compiled into TWO generated accessors, because the consumers genuinely differ in shape:
/// `resolve_escape` (text — the string forms build a lexeme) and `escape_code` (int — a
/// char literal is a code point). Two accessors, ONE table: the map itself is stated once,
/// which is the duplication that mattered. Their POLICIES still differ and should — a
/// string passes an unknown escape through verbatim, a char literal rejects it.
export fn escape_rules() -> List<EscapeRule> {
    table<EscapeRule> {
        code | lead        | text_src
        10   | "LOWER_N"   | "\\n"
        9    | "LOWER_T"   | "\\t"
        13   | "LOWER_R"   | "\\r"
        0    | "DIGIT_0"   | "\\0"
        92   | "BACKSLASH" | "\\\\"
    }
}

export type StrRun = { name: string, close: string, escape: bool, interp_a: string, interp_b: string, stop_nl: bool, close_rep: int }

/// The string-body runs, compiled to `scan_<name>(src, start) -> int` by
/// parse/emit_lex.av. Single source of truth for what interrupts a string body.
export fn str_run_rules() -> List<StrRun> {
    table<StrRun> {
        name          | close      | escape | interp_a | interp_b | stop_nl | close_rep
        "dq_body"     | "DQUOTE"   | true   | "DOLLAR" | "LBRACE" | false   | 1
        // A backtick template is VERBATIM in the production lexer: no escapes, no interp.
        "tmpl_body"   | "BACKTICK" | false  | ""       | ""       | false   | 1
        // A single-line raw string STOPS AT A NEWLINE — `stop_nl`. The triple-quoted raw
        // form is the separate rule below; it spans newlines by definition.
        "raw_body"    | "DQUOTE"   | false  | ""       | ""       | true    | 1
        // `"""…"""` — same escape/interpolation rules as `"…"`, closed by THREE quotes.
        "ml_body"     | "DQUOTE"   | true   | "DOLLAR" | "LBRACE" | false   | 3
        // `r"""…"""` — triple-quoted AND raw.
        "raw_ml_body" | "DQUOTE"   | false  | ""       | ""       | false   | 3
    }
}

/// t-bw9s / lexer flip — the NESTING runs.
///
/// `/* … */` is the one lexer construct that a scan-until cannot express at all: the
/// terminator is not the first `*/`, it is the one that balances. A depth counter is the
/// whole difference, and it is data too — `open`/`close` are two-byte sequences, so the
/// rule carries both bytes of each.
export type NestRun = { name: string, open_a: string, open_b: string, close_a: string, close_b: string }

/// An INTERPOLATION region — `${ … }` inside a string body. It is not a body run and not a
/// NestRun, and the three ways it differs are exactly why it stayed hand-written until now:
///
///   - the open is TWO bytes (`${`) and the close is ONE (`}`). NestRun's are both two.
///   - depth counts on BARE `{` / `}`, which are different bytes from the open pair.
///     NestRun counts its own open/close sequences.
///   - it must SKIP nested string literals whole, at either delimiter width, because a
///     brace inside one is content — `${"}"}` must not close at that `}`. NestRun has no
///     notion of a nested literal.
///
/// `skip_strings` turns that last part on. `raw_prefix` names the byte that marks a raw
/// nested string (`r"…"`), which takes no escapes — without it a raw nested string gets
/// escape handling applied to it and mis-scans.
///
/// `char_delim` and `tmpl_delim` name the OTHER two literal forms a brace can hide inside:
/// a char literal (`'}'`) and a backtick template. Both were unskipped until t-v126 — the
/// hand-written loop this replaced only ever skipped `"`-delimited strings — so a brace
/// inside either closed the region early.
export type InterpRun = {
    name: string,
    open_a: string, open_b: string,
    close: string,
    depth_open: string,
    skip_strings: bool,
    raw_prefix: string,
    char_delim: string,
    tmpl_delim: string
}

/// The interpolation regions, compiled to `scan_<name>(src, start) -> int`. `start` is AT
/// the opening `${`; the returned end is AFTER the balancing `}`, or EOF if it never
/// balances — the NestRun convention, since there is nothing useful at the stop byte.
export fn interp_run_rules() -> List<InterpRun> {
    table<InterpRun> {
        name            | open_a   | open_b   | close    | depth_open | skip_strings | raw_prefix | char_delim | tmpl_delim
        "interp_region" | "DOLLAR" | "LBRACE" | "RBRACE" | "LBRACE"   | true         | "LOWER_R"  | "SQUOTE"   | "BACKTICK"
    }
}

/// The nesting runs, compiled to `scan_<name>(src, start) -> int`. The returned end is
/// AFTER the balancing close (inclusive), because unlike the other runs there is nothing
/// useful for the caller to inspect at the stop byte — an unbalanced comment runs to EOF.
export fn nest_run_rules() -> List<NestRun> {
    table<NestRun> {
        name            | open_a  | open_b | close_a | close_b
        "block_comment" | "SLASH" | "STAR" | "STAR"  | "SLASH"
    }
}
