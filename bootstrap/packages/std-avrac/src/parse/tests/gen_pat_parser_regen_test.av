// WHY: t-47hc.4.4 Phase 3d (pattern half) — the REGEN GUARD for the checked-in
// production pattern static parser (parse/gen_pat_parser.av). That file MUST always
// equal emit_pat_parser_file() = the fixed import header + emit_parser_source_ex(
// avra_pat_grammar(), true). Editing the pattern grammar (features/match_expr/grammar.av)
// without running `bash scripts/diagnose.sh --emit-regen-pat` leaves the checked-in parser
// stale (silently parsing the OLD grammar in production under AVRA_PARSER_PAT_STATIC=1) —
// and this test fails until it's regenerated + committed.
//
// Fast + in-process: the emitter is already linked via the import, so no nested compile.
// The BEHAVIOURAL proof that the emitted text parses byte-equivalent to the hand parser is
// diagnose.sh --emit-gen-check plus the full-selfhost differential under
// AVRA_PARSER_PAT_STATIC=1 (the default). Sibling of gen_expr/gen_decl/gen_type_parser_regen.

use @std.avrac.features.grammar.{emit_pat_parser_file}
use @std.avrac.core.{avra_selfhost_read_file}

spec "the checked-in production pattern static parser stays current with the pattern grammar" {
    then "parse/gen_pat_parser.av == emit_pat_parser_file() (else run --emit-regen-pat)" {
        let on_disk = avra_selfhost_read_file("packages/std-avrac/src/parse/gen_pat_parser.av")
        let expected = emit_pat_parser_file()
        on_disk == expected
    }

    then "the generated file uses RELATIVE imports (no absolute `@std.avrac.` self-reference)" {
        // A globbed in-package compiler-src module MUST import relatively: an absolute
        // `@std.avrac.` self-import of the package being built makes the metadata lib
        // build's module graph process the whole package a SECOND time — every
        // @derive/@expand type double-expands (F4012). This guards the header emitted by
        // gen_pat_parser_header() directly.
        !emit_pat_parser_file().contains("use @std.avrac.")
    }
}
