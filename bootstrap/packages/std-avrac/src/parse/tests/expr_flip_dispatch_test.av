// ps3t.6.7 — the expression-family ENGINE dispatch (parse_expression's two engines).
//
// `expr_flip` selects WHICH ENGINE runs the expression grammar: the tree INTERPRETER
// (run_dsl_expr_at_shared) when set, the CHECKED-IN GENERATED static parser
// (run_static_expr) when not. Since t-47hc.4.1 that is the whole choice — the hand
// ladder this file used to compare against is deleted, so both sides below are
// grammar-driven and the differential is INTERPRETER vs EMIT. That is still two
// independent code paths compiled from one grammar, which is exactly the pair worth
// pinning: they are the two implementations that can drift.
//
// The field is read once from AVRA_PARSER_EXPR_FLIP at construction, but is a plain
// `mut bool` so a test can set it directly — exercising the interpreter path (reused
// @hand delegate, seek-based leaf positioning, seek-based cursor resync) with NO
// process-env dependency, in a single low-memory process. The full-selfhost
// byte-identity proof is memory-heavy and lives in the diff-test; this pins the
// dispatch + field wiring + the mode threading (allow_struct_lit in control-flow
// headers, etc.).
//
// Sibling of parse/tests/type_flip_dispatch_test.av + match_expr/tests/
// pat_flip_dispatch_test.av — the three family flips share one dispatch shape.
use @std.avrac.parse.{parser_new}
use @std.avrac.features.grammar.{dump_expr}

// parse_expression via the INTERPRETER engine (expr_flip set).
fn flip_expr(src: string) -> string {
    mut p = parser_new(src)
    p.expr_flip = true
    match p.parse_expression() {
        .Ok(id) -> dump_expr(p.store, id)
        .Err(_) -> "<flip parse error>"
    }
}

// parse_expression via the GENERATED static engine — pinned explicitly rather than
// left to the default, so this stays a real second baseline if the default ever moves.
fn static_expr(src: string) -> string {
    mut p = parser_new(src)
    p.expr_flip = false
    match p.parse_expression() {
        .Ok(id) -> dump_expr(p.store, id)
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    flip_expr(src) == static_expr(src)
}

spec "ps3t.6.7: parse_expression interpreter engine == generated engine (expr_flip field)" {
    given "the field toggles the engine (sanity: flip really took the interpreter branch)" {
        then "both engines build the same non-error tree for a representative form" {
            flip_expr("a + b * c") == static_expr("a + b * c") &&
            !flip_expr("a + b * c").contains("parse error")
        }
    }
    given "the operator ladder — every precedence stratum" {
        then "arithmetic, comparison, equality, bitwise, shift, logical agree" {
            agree("1 + 2") && agree("1 - 2 - 3") && agree("1 * 2 + 3") && agree("1 + 2 * 3") &&
            agree("1 % 2") && agree("1 < 2") && agree("1 <= 2 == 3") && agree("1 != 2") &&
            agree("1 | 2") && agree("1 & 2 ^ 3") && agree("1 << 2 >> 3") &&
            agree("a && b || c") && agree("a or b and c") && agree("a ?? b ?? c")
        }
    }
    given "the @hand leaves — unary / postfix / primary forms" {
        then "prefix unary, calls, field/index, closures, match/if agree" {
            agree("-a") && agree("!x") && agree("~b") && agree("not a") &&
            agree("f(1, 2)") && agree("a.b.c") && agree("a[0][1]") && agree("f(a).b(c)") &&
            agree("(x) -> x + 1") && agree("match x { _ -> 1 }") && agree("if a { 1 } else { 2 }") &&
            agree("a?.b") && agree("f() catch { 0 }") && agree("a with { x: 1 }")
        }
    }
    given "assignment / is / in / pipe (the top strata)" {
        then "retargeted assign, is-check, membership, and pipe agree" {
            agree("x = 1") && agree("a.b = f(1)") && agree("a is .Some") &&
            agree("x in [1, 2]") && agree("x in 1..10") && agree("a |> f |> g(1)")
        }
    }
    given "block bodies (the map-vs-block lookahead, is_map_literal)" {
        then "a block expression and a map literal both agree" {
            agree("{ 1 }") && agree("{ \"k\": 1 }") && agree("{ y }")
        }
    }
}
