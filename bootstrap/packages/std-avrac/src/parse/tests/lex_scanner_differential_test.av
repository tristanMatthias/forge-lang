// THE DIFFERENTIAL between the generated body scanners and the PRODUCTION lexer.
//
// gen_str_scanner_test asserts the scanners against hand-written NUMBERS. That checks the
// generator against someone's belief about the language, and it is why four separate rules
// shipped describing a lexer that does not exist — the belief and the rule came from the
// same place.
//
// This file's answer was to compare against `lexer.av` itself. That was sound while the
// hand owned its own bounds. It is NOT sound any more, and the reason is worth stating
// plainly: the lexer now CALLS these scanners for its bounds, so `scanner == lex_real(...)`
// compares the scanner against a consumer of the scanner. A scanner that stops in the wrong
// place moves BOTH sides together and the row still passes — the same tautology this file
// was written to escape, re-entered through the wiring.
//
// So every row below pins an INDEPENDENT expected position — a byte offset derived from the
// input by hand, not from either implementation — and then asserts BOTH sides against it:
//
//   1. the scanner returns that offset, and
//   2. the real lexer's token extent agrees (kind + the pos of the token after it).
//
// Two implementations agreeing with an external constant is evidence. Two implementations
// agreeing with each other, when one calls the other, is not.

use @std.avrac.features.grammar.{lex_real}
use @std.avrac.parse.{scan_dq_body, scan_tmpl_body, scan_raw_body, scan_block_comment}

extern fn avra_bytes_from_string(s: string) -> bytes

/// Where the HAND ended the first token — the pos of the token that follows it.
/// A single-literal source lexes to [literal, EOF], so token 1's pos is the extent.
fn hand_end(src: string) -> int {
    let toks = lex_real(src)
    if toks.length < 2 { return -1 }
    toks[1].pos
}

/// What the first token's KIND was — an error path must not be read as agreement.
fn hand_kind(src: string) -> string {
    let toks = lex_real(src)
    if toks.length < 1 { return "NONE" }
    toks[0].kind
}

spec "the generated body scanners stop where the PRODUCTION lexer stops" {

    // Every row: `expect` is computed BY HAND from the input, and both the scanner and the
    // real lexer are checked against it. `body_end` is the offset of the closing delimiter;
    // the token therefore ends one byte later.

    then "dq_body agrees with an independent expectation on ordinary bodies" {
        // "abc"  -> body 1..4, close at 4, token ends 5
        let c = "\"abc\""
        scan_dq_body(avra_bytes_from_string(c), 1) == 4 &&
        hand_kind(c) == "STRING" && hand_end(c) == 5 && c.length == 5
    }

    then "dq_body treats a bare brace as ordinary content" {
        // "a{b}c" -> nothing suspends; close at 6, token ends 7
        let c = "\"a{b}c\""
        scan_dq_body(avra_bytes_from_string(c), 1) == 6 &&
        hand_kind(c) == "STRING" && hand_end(c) == 7
    }

    then "dq_body runs through a newline" {
        // "a\nb" (real LF) -> close at 4, token ends 5
        let c = "\"a\nb\""
        scan_dq_body(avra_bytes_from_string(c), 1) == 4 &&
        hand_kind(c) == "STRING" && hand_end(c) == 5
    }

    // THE ESCAPE SEAM. scan_dq_body must CONSUME escape pairs: a `\"` may not end the body
    // and a `\${` may not suspend it. Asserting against c.length - 1 (the real closing
    // quote) rather than against the lexer is what makes this catch an early stop — the
    // lexer takes its bound from this scanner, so it would move in lockstep with a bug.
    then "dq_body does not end the body at an ESCAPED quote" {
        // "a\"b"  -> the only REAL close is the last byte
        let c = "\"a\\\"b\""
        scan_dq_body(avra_bytes_from_string(c), 1) == c.length - 1 &&
        hand_kind(c) == "STRING" && hand_end(c) == c.length
    }

    then "dq_body does not suspend at an ESCAPED interpolation lead" {
        let c = "\"a\\" + "$" + "{b}\""
        scan_dq_body(avra_bytes_from_string(c), 1) == c.length - 1 &&
        hand_kind(c) == "STRING" && hand_end(c) == c.length
    }

    // A genuine interpolation DOES suspend, and the whole literal still lexes as one
    // TEMPLATE ending at the closing quote — the segment loop must reassemble every piece.
    then "a multi-segment interpolated string ends at its closing quote" {
        let c = "\"a" + "$" + "{x}b" + "$" + "{y}c\""
        scan_dq_body(avra_bytes_from_string(c), 1) == 2 &&
        hand_kind(c) == "TEMPLATE" && hand_end(c) == c.length
    }

    then "tmpl_body is verbatim — no escapes, no interpolation" {
        let a = "`abc`"
        let b = "`a" + "$" + "{x}c`"
        scan_tmpl_body(avra_bytes_from_string(a), 1) == 4 && hand_end(a) == 5 &&
        scan_tmpl_body(avra_bytes_from_string(b), 1) == b.length - 1 && hand_end(b) == b.length &&
        hand_kind(a) == "TEMPLATE" && hand_kind(b) == "TEMPLATE"
    }

    then "raw_body agrees with an independent expectation" {
        // r"abc" -> body 2..5, close at 5, token ends 6
        let c = "r\"abc\""
        scan_raw_body(avra_bytes_from_string(c), 2) == 5 &&
        hand_kind(c) == "STRING" && hand_end(c) == 6
    }

    // THE REGRESSION THIS FILE EXISTS FOR. A single-line raw string may NOT span a newline:
    // `lexer.av scan_raw_string` reports F0002 at the LF. The scanner stopped only at the
    // quote, so it walked past the newline to a closing quote on a LATER LINE.
    then "raw_body STOPS at a newline, where the hand reports" {
        let c = "r\"abc\ndef\""
        // hand_end pins where the PRODUCTION lexer resumes — 6, just past the LF it
        // stopped at. Without it the row cannot tell a correct stop from one that
        // swallowed the later-line body and then errored anyway.
        scan_raw_body(avra_bytes_from_string(c), 2) == 5 && hand_kind(c) == "ERROR" &&
        hand_end(c) == 6
    }

    // A char literal is NOT a body run: scan_char_literal reads exactly one codepoint (or
    // one escape pair) and then REQUIRES the closing quote. The removed `sq_body` rule
    // called `'abc'` a 3-byte body; the hand calls it an error.
    then "a char literal is one codepoint — `'abc'` is an error" {
        hand_kind("'abc'") == "ERROR" && hand_kind("'a'") == "NUMBER"
    }

    then "block_comment spans the whole nested comment" {
        // "/* a /* b */ c */" is 17 bytes and balances at the end
        let c = "/* a /* b */ c */"
        scan_block_comment(avra_bytes_from_string(c), 0) == 17 && c.length == 17
    }
}
