// THE DIFFERENTIAL between the generated body scanners and the PRODUCTION lexer.
//
// gen_str_scanner_test asserts the scanners against hand-written NUMBERS (`dq("abc\"") == 3`).
// That checks the generator against someone's belief about the language. It cannot catch the
// defect that actually keeps shipping here — a rule that describes a lexer which does not
// exist — because the belief and the rule come from the same place. Three modes have now been
// wrong that way (`${` vs `{`, backtick escapes, and the two below), and every one of them
// passed a numbers-based spec.
//
// So this file compares against `lexer.av` itself. `lex_real` runs the REAL lexer, and the
// pos of the token AFTER a literal is exactly where the hand stopped — an oracle that cannot
// drift from the production front end, because it IS the production front end.
//
// This is the gate the wiring slice depends on: a scanner may only replace hand code once it
// is proven to stop where the hand stops.

use @std.avrac.features.grammar.{lex_real}
use @std.avrac.parse.{scan_dq_body, scan_tmpl_body, scan_raw_body, scan_block_comment}

extern fn avra_bytes_from_string(s: string) -> bytes

/// Where the HAND ended the first token — the pos of the token that follows it.
/// A single-literal source lexes to [literal, EOF], so token 1's pos is the extent.
fn hand_end(src: string) -> int {
    let toks = lex_real(src)
    if toks.length < 2 { return -1 }
    toks[1].pos
}

/// What the first token's KIND was — an error path must not be read as agreement.
fn hand_kind(src: string) -> string {
    let toks = lex_real(src)
    if toks.length < 1 { return "NONE" }
    toks[0].kind
}

spec "the generated body scanners stop where the PRODUCTION lexer stops" {

    // `"…"` — body starts after the quote; the token is body + closing quote.
    then "dq_body agrees with the hand on ordinary bodies" {
        let cases = ["\"abc\"", "\"\"", "\"a b c\"", "\"tab\\there\""]
        mut ok = true
        for c in cases {
            let scanner_end = scan_dq_body(avra_bytes_from_string(c), 1) + 1
            if scanner_end != hand_end(c) { ok = false }
        }
        ok
    }

    // The case the one-byte interpolation lead got wrong. A bare brace is content, so the
    // hand runs past it — if the scanner suspended there the two would disagree here.
    then "dq_body agrees on a bare brace, which is ordinary content" {
        let c = "\"a{b}c\""
        scan_dq_body(avra_bytes_from_string(c), 1) + 1 == hand_end(c)
    }

    // A `"…"` body MAY span a newline — the hand runs straight through one. This is the
    // property that makes `take_run`'s `column += (end - current)` unusable for string
    // bodies, and it is why the wiring needs a newline-aware advance.
    then "dq_body agrees on a body spanning a newline" {
        let c = "\"a\nb\""
        scan_dq_body(avra_bytes_from_string(c), 1) + 1 == hand_end(c)
    }

    then "tmpl_body agrees with the hand — verbatim to the backtick" {
        let cases = ["`abc`", "`a{b}c`", "`a" + "$" + "{b}c`", "`a\\b`"]
        mut ok = true
        for c in cases {
            let scanner_end = scan_tmpl_body(avra_bytes_from_string(c), 1) + 1
            if scanner_end != hand_end(c) { ok = false }
        }
        ok
    }

    // `r"…"` — the `r` and the quote are two bytes, so the body starts at 2.
    then "raw_body agrees with the hand on a single-line raw string" {
        let cases = ["r\"abc\"", "r\"\"", "r\"a\\nb\"", "r\"" + "$" + "{x}\""]
        mut ok = true
        for c in cases {
            let scanner_end = scan_raw_body(avra_bytes_from_string(c), 2) + 1
            if scanner_end != hand_end(c) { ok = false }
        }
        ok
    }

    // THE REGRESSION THIS FILE EXISTS FOR. `lexer.av scan_raw_string` reports F0002 at an
    // LF: a single-line raw string may not span a newline. The generated scanner stopped
    // only at the quote, so it walked past the newline and found a closing quote on a LATER
    // LINE — a different tokenisation, silently. `stop_nl` on the rule is the fix; this row
    // fails if it is ever dropped.
    then "raw_body STOPS at a newline, exactly where the hand reports" {
        let c = "r\"abc\ndef\""
        let body_end = scan_raw_body(avra_bytes_from_string(c), 2)
        // The LF sits at offset 5 — the scanner must stop there and NOT run on to the
        // quote at offset 9.
        body_end == 5
    }

    // The hand's answer to that input is an ERROR, which is the other half of the claim:
    // agreement on where to stop, and the caller still owning the diagnostic.
    then "and the hand's answer there is an error, not a longer string" {
        hand_kind("r\"abc\ndef\"") == "ERROR"
    }

    // A char literal is NOT a body run — `scan_char_literal` reads exactly one codepoint
    // (or one escape pair) and then REQUIRES the closing quote. The table used to carry an
    // `sq_body` scan-until-quote rule, which described no lexer in this language: it would
    // have called `'abc'` a 3-byte body where the hand calls it an error. The rule is gone;
    // this row pins the behaviour it misdescribed so its removal stays justified.
    then "a char literal is one codepoint — `'abc'` is an error, not a 3-byte body" {
        hand_kind("'abc'") == "ERROR" && hand_kind("'a'") == "NUMBER"
    }

    // The nesting scanner is called AT the opening `/*` and returns PAST the balancing
    // close, so its answer is the whole comment's extent. A comment is trivia, so the hand
    // reports the next real token — for a comment-only source that is EOF at the same offset.
    then "block_comment agrees with the hand on nested comments" {
        let cases = ["/* a */", "/* a /* b */ c */", "/**/"]
        mut ok = true
        for c in cases {
            if scan_block_comment(avra_bytes_from_string(c), 0) != hand_end(c + " x") - 2 { ok = false }
        }
        ok
    }
}
