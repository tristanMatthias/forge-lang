// WHY: ps3t.6.7 Step G — the REGEN GUARD for the checked-in production expression
// static parser (parse/gen_expr_parser.av). That file MUST always equal
// emit_expr_parser_file() = the fixed import header + emit_parser_source_ex(
// avra_expr_grammar(), true). Editing the §2 expression grammar (avra_grammar.av)
// without running `bash scripts/diagnose.sh --emit-regen-expr` leaves the checked-in
// parser stale (silently parsing the OLD grammar in production under
// AVRA_PARSER_EXPR_STATIC=1) — and this test fails until it's regenerated + committed.
//
// Fast + in-process: the emitter is already linked via the import, so no nested
// compile. Reads the file from the bootstrap root — the repo's test cwd, as the
// source lints (codegen/tests/layout_boundary_lint_test.av) rely on.
//
// Textual equality is the guard; the BEHAVIOURAL proof that the emitted text parses
// byte-equivalent to the hand parser is diagnose.sh --emit-gen-check (over emit's
// output, which this test pins to the checked-in file) plus the full-selfhost
// differential under AVRA_PARSER_EXPR_STATIC=1.

use @std.avrac.features.grammar.{emit_expr_parser_file}
use @std.avrac.core.{avra_selfhost_read_file}

spec "the checked-in production expression static parser stays current with the §2 grammar" {
    then "parse/gen_expr_parser.av == emit_expr_parser_file() (else run --emit-regen-expr)" {
        let on_disk = avra_selfhost_read_file("packages/std-avrac/src/parse/gen_expr_parser.av")
        let expected = emit_expr_parser_file()
        on_disk == expected
    }

    then "the generated file uses RELATIVE imports (no absolute `@std.avrac.` self-reference)" {
        // A globbed in-package compiler-src module MUST import relatively: an
        // absolute `@std.avrac.` self-import of the package being built makes the
        // metadata lib build's module graph process the whole package a SECOND
        // time — every @derive/@expand type double-expands (F4012), which the plain
        // compile + diff-test + emit-gen-check all pass right through. This guards
        // the header emitted by gen_expr_parser_header() directly.
        !emit_expr_parser_file().contains("use @std.avrac.")
    }
}
