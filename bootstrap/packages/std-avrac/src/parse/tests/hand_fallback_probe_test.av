// WHY: t-47hc.5 — the expression / statement / type dispatchers each still END in
// `self.parse_<family>_hand(...)`, the last of the hand parser on the production
// path. (The DECLARATION family has no such tail: `parse_declaration_hand` is
// deleted and its DSL path is unconditional.) That tail is INVISIBLE on valid
// input by construction — the grammar succeeds, so the tail never runs — and no
// green build can tell you whether it is load-bearing. This file makes the answer
// MEASURED rather than assumed, and re-measures it on every suite run.
//
// The instrument is `AVRA_REFUSE_HAND_FALLBACK` (parse/mod.av): set to `*`, every
// entry into a hand family prints `[hand-fallback] <family> at <file>:<byte>`. It
// does NOT change parse behaviour — the fall-through still happens — so a probe run
// is a normal compile whose stderr can simply be counted.
//
// TWO specs, and the second is what makes the first worth anything. Reporting
// "zero fall-throughs" from an instrument nobody proved can fire is the blind-
// instrument failure mode CLAUDE.md documents (`avra_rc_live_count` measuring
// nothing; four uniform zeros read as four confirmations). So:
//
//   1. the ZERO spec — a valid fixture and an INVALID one, both through the real
//      front end (`bs2 check`), must report no fall-through at all; and
//   2. the CONTROL spec — the instrument shown FIRING on an entry that genuinely
//      reaches the tail, and shown SILENT on the same entry once the generated
//      parser answers instead.
//
// If (2) ever stops firing, (1) has become vacuous and this file says so by going
// red — rather than reporting a comfortable zero from an instrument that was
// switched off.
//
// WHAT WAS MEASURED, and it is stronger than "the tail rarely runs": the tail is
// not reachable from the whole-program entry AT ALL, in ANY routing configuration.
// `parse_file_program` routes every item through `parse_declaration`, whose DSL
// path is unconditional and whose builders never call the `Parser.parse_*` ladder,
// so the family flags do not even change the answer. Swept over the whole
// @std::avrac package compile (6218 parser constructions) and a 264-file corpus
// (792 constructions — 240 invalid programs extracted from
// error_recovery_differential_test plus the 24 difftest corpus files), across
// valid and invalid input and with every family flag forced off: ZERO entries.
// The ladder survives only under `parse_file_expression` (the expression-only
// entry the control uses) and under `@hand` leaves, of which the production
// grammars have none.
//
// `parse_file_expression` IS a production entry, though — `bs2 expr` and
// `bs2 eval` reach it — so the tail is not dead weight yet, and the third spec
// draws that boundary exactly: over 53 expression forms, every VALID one is
// answered by the generated parser and the 19 that fall through are all
// MALFORMED. What remains is therefore error RECOVERY for one entry, not parsing.
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{avra_process_env_set}

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_selfhost_write_file(path: string, content: string) -> int

/// A VALID program touching all three families: a type annotation (`type`), a
/// binding + call statement (`stmt`), and arithmetic/comparison (`expr`).
fn valid_src() -> string {
    "fn add(a: int, b: int) -> int {\n" +
    "    let sum: int = a + b\n" +
    "    if sum > 10 { return sum }\n" +
    "    sum * 2\n" +
    "}\n"
}

/// An INVALID program — the recovery path, where a fall-through is most likely.
/// `->` at statement position starts nothing at all, so it can only be answered by
/// a dispatcher's tail (the `agree_all` case t-zrn3 was built around).
fn invalid_src() -> string {
    "fn a() -> int { 1 }\n" +
    "->\n" +
    "fn b() -> int { return * 3 }\n"
}

fn write_fixture(name: string, src: string) -> string {
    let path = "build/_handfb_${name}.av"
    let _ = avra_selfhost_write_file(path, src)
    path
}

/// Sentinel for "the probe command did not do what it was asked to" — returned
/// instead of a marker count, so it fails BOTH an `== 0` and a `> 0` assertion.
/// A count is only meaningful if the compile it came from actually happened.
const PROBE_DID_NOT_RUN = -1

/// Count `[hand-fallback]` lines from a `bs2 <cmd>` of `src` under `env`.
/// Diagnostics from the fixture itself are irrelevant — only the marker is counted,
/// so an invalid fixture (which SHOULD produce errors) measures the same thing a
/// valid one does.
///
/// `want_ok` says whether the command is expected to SUCCEED, and it is what keeps
/// the zero-assertions from passing vacuously: counting alone cannot distinguish
/// "the generated parser answered everything" from "`./build/bs2` was missing, or
/// died before it reached the parser" — both yield zero markers. So the status is
/// checked first and a mismatch returns the sentinel. Output goes through a
/// per-fixture log because `avra_shell_exec_status` yields the status, not the text.
fn fallback_lines_cmd(env: string, cmd: string, name: string, src: string, want_ok: bool) -> int {
    let path = write_fixture(name, src)
    let log = "build/_handfb_out_${name}.txt"
    let status = avra_shell_exec_status("${env} ./build/bs2 ${cmd} '${path}' > '${log}' 2>&1")
    if want_ok != (status == 0) { return PROBE_DID_NOT_RUN }
    let out = avra_shell_exec("cat '${log}' 2>/dev/null")
    // A NON-zero status is not by itself evidence the compiler ran: a missing or
    // unrunnable `./build/bs2` also exits non-zero, which would let every
    // `want_ok: false` fixture match its expected status and then count zero
    // markers. Require a rendered diagnostic, which only the compiler emits.
    // (The `want_ok: true` side needs no such witness — nothing but bs2 itself
    // reaching the end of a successful compile can exit 0 here.)
    if !want_ok && !out.contains("error[F") { return PROBE_DID_NOT_RUN }
    mut n = 0
    for line in out.split("\n") {
        if line.contains("[hand-fallback]") { n = n + 1 }
    }
    n
}

/// The whole-program front end — what `build` / `run` / `check` all go through.
fn fallback_lines(env: string, name: string, src: string, want_ok: bool) -> int {
    fallback_lines_cmd(env, "check", name, src, want_ok)
}

/// The EXPRESSION-only front end (`bs2 expr`, and `bs2 eval` alongside it): the
/// one production command that reaches `parse_expression`, via
/// `parse_expr_or_fail` -> `parse_expression_source` -> `parse_file_expression`.
/// PIN every routing field, never just the one being measured — `expr_flip` selects
/// the tree interpreter over the generated static parser, and leaving it ambient
/// would make the row mean whichever engine the environment happened to pick.
///
/// t-47hc.4.1 dropped `AVRA_PARSER_EXPR_STATIC=1` from this prefix: the variable no
/// longer exists, because there is no hand expression ladder for its off-state to
/// select. What that costs this section is stated at the positive control below.
fn expr_cmd_fallbacks(name: string, src: string, want_ok: bool) -> int {
    fallback_lines_cmd("AVRA_REFUSE_HAND_FALLBACK='*' AVRA_PARSER_EXPR_FLIP=0", "expr", name, src, want_ok)
}

/// Drive the EXPRESSION dispatcher in-process and count the marker lines the probe
/// appended to its log. `parse_file_expression` is the entry that actually reaches
/// `parse_expression` — the whole-program entry does NOT, because
/// `parse_file_program` routes every item through `parse_declaration`, whose DSL
/// path is unconditional and whose builders never call the Parser ladder. That
/// asymmetry is the finding this file records, and it is also why the control has
/// to use this entry: a control built on `parse_file_program` reports zero for the
/// same reason the assertions do, and would "pass" while proving nothing.
///
/// The routing field is pinned explicitly, per the discipline `rtree_at` documents:
/// an ambient flag would leave the engine chosen by the environment.
///
/// Drives `parse_type_expr` DIRECTLY, because `parse_type_expr_hand` is the LAST hand
/// tail left to control against — its gate is `type_static || type_flip`, so clearing
/// both reaches it. This control has now moved twice, and the moves are the point: it
/// began on `parse_file_expression` (t-47hc.4.1 deleted the expression ladder), moved to
/// `parse_statement` (t-47hc.37 deleted `parse_statement_hand`), and each time the old
/// call would have kept PASSING as a second zero while proving nothing. When the type
/// tail goes too there is no live tail left, and these rows become pure regression
/// guards — the status the whole-program rows above already carry, and the point at
/// which the probe should be deleted rather than kept as a gauge nothing can move.
fn type_entry_markers(tag: string, src: string, native: bool) -> int {
    let log = "build/_handfb_log_${tag}.txt"
    let _ = avra_shell_exec("rm -f '${log}'")
    avra_process_env_set("AVRA_REFUSE_HAND_FALLBACK", "*")
    avra_process_env_set("AVRA_REFUSE_HAND_FALLBACK_LOG", log)
    mut p = parser_new(src)
    p.type_flip = native
    p.type_static = native
    let _ = p.parse_type_expr("probe")
    // Disarm before returning: the probe is process-wide, and leaving it armed
    // would make every LATER parse in this test binary append to a stale log.
    avra_process_env_set("AVRA_REFUSE_HAND_FALLBACK", "")
    avra_process_env_set("AVRA_REFUSE_HAND_FALLBACK_LOG", "")
    mut n = 0
    for line in avra_shell_exec("cat '${log}' 2>/dev/null").split("\n") {
        if line.contains("[hand-fallback]") { n = n + 1 }
    }
    n
}

// ── t-bw9s: these three rows are REGRESSION GUARDS, not measurements ─────────
//
// Read this before quoting a zero from them. They assert that a `bs2 check` of a
// whole program logs no `[hand-fallback]` marker — and no `bs2 check` CAN log one,
// under any routing flags, on valid or invalid input. Verified directly: default;
// `EXPR_STATIC=0 EXPR_FLIP=0`; `STMT_FLIP=1` on malformed input; `TYPE_STATIC=0
// TYPE_FLIP=0`; fresh filenames to defeat the compile cache; and through the LOG
// sink as well as stderr, where the log file is never even created — so
// `note_hand_fallback` is not being called at all.
//
// That is the flip being COMPLETE, not the probe being broken. With zero production
// `@hand` leaves the generated parser never calls back into `Parser.parse_*_hand`, so
// the hand entries are unreachable from the front end. (`parse_statement`'s callers —
// while_stmt, for_stmt, let-else, component_decl — are themselves hand-path-only, so
// even a `while` body does not reach the stmt hand.)
//
// The consequence is what matters: a positive control for these rows is IMPOSSIBLE
// without reintroducing a hand leaf purely to test the probe. So a zero here is not
// evidence that "nothing reached the hand" — it cannot distinguish that from "nothing
// could have". What the rows DO catch is a regression: reintroduce a leaf, and the
// generated parser routes into it, and they go red. That is worth keeping and is all
// they claim.
//
// The rows with a real control are the `bs2 expr` ones further down: that command
// reaches the expression ladder directly, its marker demonstrably FIRES with the
// expression flags off, and its zero therefore means something.
spec "t-47hc.5 / t-bw9s: no production front-end path routes into a hand family tail (GUARD — see note above; a zero here cannot fire and so is not a measurement)" {
    given "the probe is armed and the parser runs its default routing" {
        // Nothing to set up beyond the fixtures each `then` writes — the point is
        // that the DEFAULT configuration is what gets measured.
        true
    }

    then "a valid program reaches no hand family tail" {
        fallback_lines("AVRA_REFUSE_HAND_FALLBACK='*'", "valid", valid_src(), true) == 0
    }

    // The interesting half: on INVALID input the grammar reports, and the tail is
    // exactly what used to answer. If routing ever regresses so the grammar cannot
    // recover on its own, this is where it shows up.
    then "an invalid program reaches no hand family tail either" {
        fallback_lines("AVRA_REFUSE_HAND_FALLBACK='*'", "invalid", invalid_src(), false) == 0
    }

    // Scoping: the marker must be attributable per family, not a single global
    // flag. Naming one family must not report another's.
    then "the allowlist form is scoped — naming only `type` reports no expr/stmt" {
        fallback_lines("AVRA_REFUSE_HAND_FALLBACK='type'", "scoped", valid_src(), true) == 0
    }
}

// `bs2 expr` / `bs2 eval` are the ONLY production commands that reach the
// expression ladder, and they draw the boundary the whole-program sweep cannot
// see. Measured over 53 expression forms: every VALID one is answered by the
// generated parser, and the 19 that fall through are all MALFORMED — including
// three (`a is Foo`, `spawn f()`, `dyn T`) that look valid and are not, since the
// hand parser rejects them too (`is` takes a `.Variant`, `spawn` takes a block,
// and `dyn T` is a type rather than an expression).
//
// So the expression tail is not dead weight yet: it owns error RECOVERY for this
// entry. That is the remaining work, and stating it as a measurement rather than
// an impression is the point — the tail can be deleted once the expression view
// recovers on its own, and not before.
spec "t-47hc.5: `bs2 expr` — the grammar owns VALID input; the tail owns recovery" {
    given "the expression-only front end is probed directly" {
        true
    }

    // The guard: a routing regression that pushed valid expressions back onto the
    // hand parser would be invisible everywhere else, because the two agree on
    // valid input by construction. Here it is a red test.
    then "no valid expression form falls back to the hand ladder" {
        expr_cmd_fallbacks("e_arith", "1 + 2 * 3 - 4 / 5\n", true) == 0 &&
        expr_cmd_fallbacks("e_chain", "a?.b ?? c\n", true) == 0 &&
        expr_cmd_fallbacks("e_pipe", "x |> f |> g\n", true) == 0 &&
        expr_cmd_fallbacks("e_lambda", "(x) -> x + 1\n", true) == 0 &&
        expr_cmd_fallbacks("e_match", "match v { .A -> 1, _ -> 2 }\n", true) == 0 &&
        expr_cmd_fallbacks("e_struct", "Foo { x: 1, y: 2 }\n", true) == 0 &&
        expr_cmd_fallbacks("e_post", "a.b.c(1)[2]\n", true) == 0 &&
        expr_cmd_fallbacks("e_isvar", "a is .Some\n", true) == 0 &&
        expr_cmd_fallbacks("e_in", "x in [1, 2]\n", true) == 0 &&
        expr_cmd_fallbacks("e_generic", "f<int>(3)\n", true) == 0
    }

    // The gap this row used to record is CLOSED. It asserted `> 0` — malformed
    // input still reaching the hand — above a comment promising that a red here
    // would be good news and that the fix was to delete the tail rather than the
    // assertion. The expression seam now owns its recovery (parse/mod.av), so the
    // tail is unreachable in production on invalid input too, and this is the
    // assertion that pins it: MALFORMED expressions must reach the hand ZERO times.
    //
    // This is NOT vacuous, and the thing that makes it non-vacuous is a different
    // spec: "with the expression flags OFF the probe FIRES" drives this same entry
    // with the generated parser disabled and requires a NON-zero count. A probe
    // that silently stopped working would fail there, so a zero here means the
    // grammar answered, not that nothing ran. The per-fixture exit-status check in
    // `fallback_lines_cmd` closes the other half (a bs2 that never ran cannot
    // report zero markers and pass).
    then "malformed expressions no longer reach the tail either — the gap is CLOSED" {
        expr_cmd_fallbacks("e_bad_trail", "1 +\n", false) == 0 &&
        expr_cmd_fallbacks("e_bad_open", "f(\n", false) == 0 &&
        expr_cmd_fallbacks("e_bad_lead", "* 3\n", false) == 0 &&
        expr_cmd_fallbacks("e_bad_dot", "a.\n", false) == 0 &&
        expr_cmd_fallbacks("e_bad_call", "f(1,\n", false) == 0
    }
}

spec "t-47hc.5: the fall-through probe is NOT a blind instrument (positive control)" {
    given "the type dispatcher is driven in-process through parse_type_expr" {
        true
    }

    // Without this, the zeros above are unfalsifiable. A misplaced marker, an env
    // name typo, or a probe accidentally deleted would all read as "clean" — the
    // blind-instrument failure mode, where uniform zeros get counted as
    // independent confirmations instead of as one broken gauge.
    //
    // THE CONTROL HAS MOVED TWICE, and that is the finding, not an inconvenience.
    // Expression tail (t-47hc.4.1) -> statement dispatcher (t-47hc.37) -> type family,
    // here. Each deletion silently turned the previous control into a second zero: the
    // call still ran, still returned 0, and still passed — the blind-instrument failure
    // this spec exists to prevent, arriving by deletion rather than by bug.
    //
    // It is a WEAKER control each time, and worth saying so. It proves the probe, its
    // two sinks and the family allowlist all work; it does NOT prove that an
    // expression- or statement-seam regression specifically would be seen, because
    // nothing can see those any more. Those rows are pure regression guards now.
    //
    //
    // MEASURED while making this move, and recorded because it sizes the next slice:
    // with the probe armed over the ENTIRE compiler source, the 24-file difftest
    // corpus, a wide-surface fixture (component / while / for / if / let-else /
    // channel / quote type / match / lambda / where clause) and ten MALFORMED
    // fixtures, the marker fired ZERO times. `--hand-leaves` agrees: zero production
    // `@hand` leaves. Both surviving tails — `parse_statement_hand` and
    // `parse_type_expr_hand` is the only tail left, and this in-process control is the
    // only thing that can still move the gauge.
    then "with both type-routing flags OFF the probe FIRES" {
        type_entry_markers("ctl_on", "List<int>", false) > 0
    }

    // The negative half, on the SAME entry and the SAME input: the only thing that
    // changed is which parser answered. So the count above tracks a hand tail being
    // taken, not merely "this helper writes to a log".
    then "with the native type parsers ON the same entry logs nothing" {
        type_entry_markers("ctl_off", "List<int>", true) == 0
    }
}

spec "a recovered expression parse still reports its CAUSE, not just its diagnostics" {
    // The direct `parse_file_expression` regression for the seam above. Removing the
    // hand fall-through removed the accident that used to fill `error_message` (the
    // hand re-parse reported through `report`, which sets it), so the documented
    // "consult had_error / error_message for the cause" contract silently returned
    // an empty string and the CLI printed a BLANK summary line under the frame.
    //
    // Asserted through the API rather than the CLI on purpose: the rendered frame
    // still looked right the whole time, which is exactly why the regression was
    // invisible until the summary line was read.
    then "a malformed expression fills error_message with the position and reason" {
        mut p = parser_new("1 +")
        let r = p.parse_file_expression()
        r.error_message != "" &&
            r.error_message.contains("expected expression") &&
            r.error_message.contains("1:4")
    }
    then "a VALID expression leaves it empty — the control that makes the row above mean something" {
        mut q = parser_new("1 + 2")
        let rq = q.parse_file_expression()
        rq.error_message == ""
    }
}
