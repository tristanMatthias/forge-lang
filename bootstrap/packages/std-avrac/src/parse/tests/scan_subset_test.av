// WHY: t-47hc.2 (Phase 1) — the DIFFERENTIAL proof that the generated byte-scanner
// (scan_subset.av) emits a token stream BYTE-IDENTICAL to the hand lexer, THROUGH
// the token-stream oracle: scan_subset(x) == lex_dump(x) for every in-subset x.
// This is the first slice that produces REAL generated tokens and validates them
// against the oracle — the miniature of Phase 1's end goal (a generated DFA lexer
// whose token stream is byte-identical over the whole language). It also pins the
// subset boundary: an out-of-subset construct returns an `<out-of-subset:...>`
// marker (never a valid dump), so a later slice that widens the scanner will turn
// those markers into real agreement, and this spec catches any regression in
// between.
use @std.avrac.parse.{scan_subset, lex_dump}

// The generated scanner and the hand lexer agree byte-for-byte on `src`.
fn same(src: string) -> bool { scan_subset(src) == lex_dump(src) }

spec "t-47hc.2: generated byte-scanner == hand lexer over the token subset" {
    then "identifiers, keywords, and single-char punctuation in blocks" {
        same("fn foo(a, b) { a + b }") &&
        same("if let mut return true false for in") &&
        same("arr[i] map{ k: v } @ann") &&
        same("a * b % c ^ d ~ e + f")
    }
    then "plain integers, including Number-then-Identifier boundaries" {
        same("count 42 007 0") &&
        same("42x 00y 9z") &&
        // Duration-suffix LOOKALIKES that are NOT durations (the suffix letter is
        // followed by another ident char) stay a plain Number + Identifier —
        // byte-identical, matching the hand lexer's !p_is_alpha_numeric boundary.
        same("1down") && same("5m2") && same("9dd")
    }
    then "whitespace, newlines (line/column tracking), and // line comments" {
        same("a\n  b + c\n    @ann") &&
        same("a // trailing comment\nb + c") &&
        same("")
    }
    then "compound operators: maximal munch, byte-identical to the hand lexer" {
        // `=` family (== before =), and `!` (!= before !)
        same("a == b") && same("x = 1") && same("a != b") &&
        // `<` family: << / <= / <- all beat a bare < (longest-first)
        same("a << b") && same("a <= b") && same("x <- y") && same("a < b") &&
        // `>` family: >> / >= beat a bare >
        same("a >> b") && same("a >= b") && same("a > b") &&
        // `?` family: ?? / ?. beat a bare ?
        same("x ?? y") && same("x ?. y") && same("a ? b") &&
        // `&` and `|` families
        same("a && b") && same("a & b") &&
        same("a || b") && same("a |> b") && same("a | b") &&
        // `-` (-> beats -) and `.` (.. beats .)
        same("f() -> int") && same("a - b") && same("a .. b") && same("a.b")
    }
    then "adjacent (no whitespace) operators still munch longest-first" {
        same("a==b") && same("i<<2") && same("x?.y") && same("a|>b") &&
        same("p??q") && same("a->b") && same("a..b") && same("a<=b") &&
        same("a&&b") && same("a||b")
    }
    then "the `/` family: division, `/* */` nested block comments, `///`/`//!` doc tokens" {
        // bare `/` is Slash (division), NOT the start of a comment
        same("a / b") && same("x = a / b / c") &&
        // `/* */` block comments are trivia (skipped), including NESTED and multi-line
        same("a /* c */ b") && same("a /* x /* y */ z */ b") &&
        same("/* lead */ x + y") && same("a /*\nmulti\nline\n*/ b") &&
        // `///` DocComment / `//!` ModDocComment are their own TOKENS (one leading
        // space stripped, content to end of line), distinct from skipped `//`
        same("/// a doc comment\nfn f") && same("//! a module doc\nx") &&
        same("x /// trailing doc\ny") && same("///no-space-doc\nz") &&
        // a `//` line comment is still skipped; a `///` right after is a token
        same("a // plain\n/// doc\nb")
    }
    then "out-of-subset constructs return the EXACT marker, never a partial dump" {
        // Exact `==` (not `.contains`): a partial token dump followed by a marker
        // would slip past `.contains`, contradicting "never a partial dump". (`=`,
        // `-`, and the whole `/` family are now IN subset.)
        scan_subset("1.5") == "<out-of-subset:number>" &&          // float
        scan_subset("1_000") == "<out-of-subset:number>" &&        // underscore group
        scan_subset("0xff") == "<out-of-subset:number>" &&         // hex prefix
        // Duration-suffixed numbers (Nd/Nh/Nm/Ns/Nms) fold into ONE Number.
        scan_subset("1d") == "<out-of-subset:number>" &&           // days
        scan_subset("3m") == "<out-of-subset:number>" &&           // minutes
        scan_subset("5ms") == "<out-of-subset:number>" &&          // millis
        scan_subset("say(\"hi\")") == "<out-of-subset:char>" &&    // string-literal quote
        scan_subset("'c'") == "<out-of-subset:char>"               // char literal
    }
}
