// WHY: B-final F1a — the four walker-opaque containers (WhenArm, SelectArm,
// Annotation, CompConfig) carry DUAL id fields beside their boxed children
// (nullable: null = "no arena row yet", the transform-rebuilt state). On the
// PARSE path the ids must always be present and must denote the same node
// the boxed half carries — that agreement is what lets consumers migrate
// from the boxed halves to store reads one at a time without drift. These
// specs pin it: for each container parsed from source, the dual id is
// non-null and `store.get(id)` renders identically to the boxed child.

use @std.avrac.parse.{parse_program_source, parse_expression_native_probe}
use @std.avrac.core.{Expr, Stmt, SStmt, render_expr, render_stmt, render_pattern, vtype_display, stmt_unwrap, NodeStore, ExprId}

/// Dig the first statement of the first fn's body out of a served program.
fn first_body_stmt(store: NodeStore, stmts: List<SStmt>) -> Stmt {
    match stmt_unwrap(store, stmts[0].node) {
        .Function(_, _, _, _, body) -> stmt_unwrap(store, store.stmts.get(body[0]))
        _ -> Stmt.NoOp
    }
}

/// Each then body lives in a helper fn: a bare `return` inside a then-block
/// returns out of the synthesized unit fn and silently drops registrations
/// (filed bug) — helpers own the early returns.
fn when_bodies_mirror() -> bool {
    let probe = parse_expression_native_probe("when { a > 1 -> f(a)  _ -> g() }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .When(arms) -> {
            if arms.length != 2 { return false }
            for arm in arms {
                if arm.body_id == none { return false }
                if render_expr(probe.store, probe.store.exprs.get(arm.body_id!)) != render_expr(probe.store, arm.body.node) { return false }
            }
            true
        }
        _ -> false
    }
}

fn when_conds_mirror() -> bool {
    let probe = parse_expression_native_probe("when { a > 1 -> f(a)  _ -> g() }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .When(arms) -> {
            if arms[0].cond_id == none { return false }
            if arms[0].cond == none { return false }
            if render_expr(probe.store, probe.store.exprs.get(arms[0].cond_id!)) != render_expr(probe.store, arms[0].cond!.node) { return false }
            arms[1].cond_id == none && arms[1].cond == none
        }
        _ -> false
    }
}

fn select_arm_mirrors() -> bool {
    let src = "fn f(c: Channel<int>) -> int {\n    select {\n        v <- c -> {\n            handle(v)\n            log(v)\n        }\n    }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match first_body_stmt(r.store, r.stmts!) {
        .Select(arms) -> {
            if arms.length != 1 { return false }
            let arm = arms[0]
            if arm.chan_id == none { return false }
            if render_expr(r.store, r.store.exprs.get(arm.chan_id!)) != render_expr(r.store, arm.chan) { return false }
            if arm.body_ids == none { return false }
            let ids = arm.body_ids!
            if ids.length != arm.body.length { return false }
            for (i, id) in ids.enumerate() {
                if render_stmt(r.store, r.store.stmts.get(id)) != render_stmt(r.store, arm.body[i].node) { return false }
            }
            true
        }
        _ -> false
    }
}

fn annotation_args_mirror() -> bool {
    let src = "@limit(3 + 4, name)\nfn f() -> int { 1 }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match r.stmts![0].node {
        .Annotated(annots, _) -> {
            if annots.length != 1 { return false }
            let a = annots[0]
            if a.arg_ids == none { return false }
            let ids = a.arg_ids!
            if ids.length != a.args.length || ids.length != 2 { return false }
            for (i, id) in ids.enumerate() {
                if render_expr(r.store, r.store.exprs.get(id)) != render_expr(r.store, a.args[i].node) { return false }
            }
            true
        }
        _ -> false
    }
}

fn doc_annotation_mirrors() -> bool {
    let src = "/// adds one\nfn inc(x: int) -> int { x + 1 }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match r.stmts![0].node {
        .Annotated(annots, _) -> {
            let a = annots[0]
            if a.arg_ids == none { return false }
            a.arg_ids!.length == 1
                && render_expr(r.store, r.store.exprs.get(a.arg_ids![0])) == render_expr(r.store, a.args[0].node)
        }
        _ -> false
    }
}

fn comp_config_mirrors() -> bool {
    let src = "component counter {\n    config {\n        start: int = 5\n        label: string\n    }\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match stmt_unwrap(r.store, r.stmts![0].node) {
        .ComponentDef(_, _, config, _, _, _) -> {
            if config.length != 2 { return false }
            let with_default = config[0]
            let plain = config[1]
            if with_default.ty_id == none || plain.ty_id == none { return false }
            if with_default.default_id == none || with_default.default_val == none { return false }
            if render_expr(r.store, r.store.exprs.get(with_default.default_id!)) != render_expr(r.store, with_default.default_val!) { return false }
            plain.default_id == none && plain.default_val == none
        }
        _ -> false
    }
}

spec "F1a duals: when arms carry cond/body rows that mirror the boxed halves" {
    given "a when expression parsed through the native probe" {
        then "every arm's body_id is present and renders identically" {
            when_bodies_mirror()
        }
        then "a conditioned arm carries cond_id; the wildcard arm carries none" {
            when_conds_mirror()
        }
    }
}

spec "F1a duals: select arms carry chan/body rows that mirror the boxed halves" {
    given "a select statement inside a fn body" {
        then "chan_id and per-element body_ids are present and agree" {
            select_arm_mirrors()
        }
    }
}

spec "F1a duals: annotation args carry one row per arg, in order" {
    given "an annotated declaration with expression args" {
        then "arg_ids agree element-wise with the boxed args" {
            annotation_args_mirror()
        }
        then "a doc comment's synthesized annotation carries its string row" {
            doc_annotation_mirrors()
        }
    }
}

spec "F1a duals: component config rows carry type + default ids" {
    given "a component with a defaulted and an undefaulted config key" {
        then "ty_id is always present; default_id mirrors default_val presence" {
            comp_config_mirrors()
        }
    }
}

// ── F1b: FieldInit.value_id ──

fn field_init_duals_mirror() -> bool {
    let src = "fn f() -> int {\n    let p = P { x: 1 + 2, y }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match first_body_stmt(r.store, r.stmts!) {
        .Let(_, _, init) -> match r.store.exprs.get(init) {
            .StructLit(_, inits) -> {
                if inits.length != 2 { return false }
                for fi in inits {
                    if fi.value_id == none { return false }
                    if render_expr(r.store, r.store.exprs.get(fi.value_id!)) != render_expr(r.store, fi.value.node) { return false }
                }
                true
            }
            _ -> false
        }
        _ -> false
    }
}

fn table_row_field_duals_mirror() -> bool {
    let src = "fn f() -> int {\n    let rows = table {\n        a | b\n        1 | 2\n    }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match first_body_stmt(r.store, r.stmts!) {
        .Let(_, _, init) -> match r.store.exprs.get(init) {
            .ListLit(rows) -> match rows[0].node {
                .StructLit(_, inits) -> {
                    if inits.length != 2 { return false }
                    for fi in inits {
                        if fi.value_id == none { return false }
                        if render_expr(r.store, r.store.exprs.get(fi.value_id!)) != render_expr(r.store, fi.value.node) { return false }
                    }
                    true
                }
                _ -> false
            }
            _ -> false
        }
        _ -> false
    }
}

spec "F1b duals: struct-literal field inits carry value rows" {
    given "explicit and shorthand field inits" {
        then "every value_id is present and renders identically to the boxed value" {
            field_init_duals_mirror()
        }
    }
    given "table-literal rows" {
        then "each cell's FieldInit carries its cell row" {
            table_row_field_duals_mirror()
        }
    }
}

// ── F1c: MatchArm pattern/guard/body duals ──

fn match_arm_duals_mirror() -> bool {
    let probe = parse_expression_native_probe("match x { 1 if g -> a, _ -> b }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .MatchExpr(_, arms) -> {
            if arms.length != 2 { return false }
            for arm in arms {
                if arm.pattern_id == none { return false }
                if render_pattern(probe.store, probe.store.pats.get(arm.pattern_id!)) != render_pattern(probe.store, arm.pattern) { return false }
                if arm.body_id == none { return false }
                if render_expr(probe.store, probe.store.exprs.get(arm.body_id!)) != render_expr(probe.store, arm.body.node) { return false }
            }
            let guarded = arms[0]
            if guarded.guard_id == none || guarded.guard == none { return false }
            if render_expr(probe.store, probe.store.exprs.get(guarded.guard_id!)) != render_expr(probe.store, guarded.guard!.node) { return false }
            arms[1].guard_id == none && arms[1].guard == none
        }
        _ -> false
    }
}

fn quote_arm_duals_mirror() -> bool {
    let probe = parse_expression_native_probe("quote arm { 1 if g -> 2 }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Quote(_, body) -> match body {
            .MatchExpr(_, arms) -> {
                if arms.length != 1 { return false }
                let arm = arms[0]
                if arm.pattern_id == none || arm.guard_id == none || arm.body_id == none { return false }
                if arm.guard == none { return false }
                if render_pattern(probe.store, probe.store.pats.get(arm.pattern_id!)) != render_pattern(probe.store, arm.pattern) { return false }
                if render_expr(probe.store, probe.store.exprs.get(arm.guard_id!)) != render_expr(probe.store, arm.guard!.node) { return false }
                render_expr(probe.store, probe.store.exprs.get(arm.body_id!)) == render_expr(probe.store, arm.body.node)
            }
            _ -> false
        }
        _ -> false
    }
}

fn unguarded_quote_arm_guard_dual_null() -> bool {
    let probe = parse_expression_native_probe("quote arm { 1 -> 2 }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Quote(_, body) -> match body {
            .MatchExpr(_, arms) -> {
                if arms.length != 1 { return false }
                let arm = arms[0]
                arm.guard == none && arm.guard_id == none
                    && arm.pattern_id != none && arm.body_id != none
            }
            _ -> false
        }
        _ -> false
    }
}

fn table_arm_pattern_dual_mirrors() -> bool {
    let src = "fn f(s: int) -> int {\n    let r = match s table {\n        pattern | label\n        1 | \"one\"\n    }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match first_body_stmt(r.store, r.stmts!) {
        .Let(_, _, init) -> match r.store.exprs.get(init) {
            .MatchExpr(_, arms) -> {
                if arms.length != 1 { return false }
                let arm = arms[0]
                if arm.pattern_id == none { return false }
                if render_pattern(r.store, r.store.pats.get(arm.pattern_id!)) != render_pattern(r.store, arm.pattern) { return false }
                // The MapLit body is synthesized table glue — no native row
                // until that producer converts; the guard slot doesn't exist.
                arm.body_id == none && arm.guard_id == none
            }
            _ -> false
        }
        _ -> false
    }
}

spec "F1c duals: match arms carry pattern/guard/body rows" {
    given "a guarded and a wildcard arm parsed through the native probe" {
        then "pattern_id and body_id are always present and render identically" {
            match_arm_duals_mirror()
        }
    }
    given "a quote arm with a guard" {
        then "the envelope's single arm carries all three rows" {
            quote_arm_duals_mirror()
        }
    }
    given "a quote arm without a guard" {
        then "guard_id stays null while pattern/body rows are present" {
            unguarded_quote_arm_guard_dual_null()
        }
    }
    given "a match table row" {
        then "the pattern row is real; the synthesized MapLit body stays null" {
            table_arm_pattern_dual_mirrors()
        }
    }
}

// ── F1d: ParamEntry.ty_id ──

fn fn_param_duals_mirror() -> bool {
    let src = "fn add(x: int, y) -> int { x }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match stmt_unwrap(r.store, r.stmts![0].node) {
        .Function(_, _, params, _, _) -> {
            if params.length != 2 { return false }
            // x carries the written annotation; y carries the Int default —
            // the dual mirrors BOTH (it tracks vtype, not the surface text).
            for p in params {
                if p.ty_id == none { return false }
                if vtype_display(r.store.types.get(p.ty_id!)) != vtype_display(p.vtype) { return false }
            }
            true
        }
        _ -> false
    }
}

fn method_self_param_dual_mirrors() -> bool {
    let src = "type P = { x: int }\nimpl P {\n    fn get(self) -> int { 1 }\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match stmt_unwrap(r.store, r.stmts![1].node) {
        .Impl(_, methods) -> match stmt_unwrap(r.store, r.store.stmts.get(methods[0])) {
            .Function(_, _, params, _, _) -> {
                if params.length != 1 { return false }
                let self_p = params[0]
                if self_p.ty_id == none { return false }
                vtype_display(r.store.types.get(self_p.ty_id!)) == vtype_display(self_p.vtype)
            }
            _ -> false
        }
        _ -> false
    }
}

fn typed_lambda_param_dual_mirrors() -> bool {
    let probe = parse_expression_native_probe("(x: string) -> x")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Lambda(params, _) -> {
            if params.length != 1 { return false }
            let p = params[0]
            if p.ty_id == none { return false }
            vtype_display(probe.store.types.get(p.ty_id!)) == vtype_display(p.vtype)
        }
        _ -> false
    }
}

fn untyped_lambda_param_duals_null() -> bool {
    let probe = parse_expression_native_probe("(x, y) -> x")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Lambda(params, _) -> {
            params.length == 2 && params[0].ty_id == none && params[1].ty_id == none
        }
        _ -> false
    }
}

fn name_list_param_duals_null() -> bool {
    let src = "fn f() -> int {\n    let (a, b) = t\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match first_body_stmt(r.store, r.stmts!) {
        .LetDestructure(names, _) -> {
            names.length == 2 && names[0].ty_id == none && names[1].ty_id == none
        }
        _ -> false
    }
}

fn use_name_list_duals_null() -> bool {
    let src = "use @std.avrac.core.{Expr, Stmt}\nfn f() -> int { 0 }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.stmts == null { return false }
    match stmt_unwrap(r.store, r.stmts![0].node) {
        .Use(_, names) -> {
            names.length == 2 && names[0].ty_id == none && names[1].ty_id == none
        }
        _ -> false
    }
}

fn it_lambda_param_dual_null() -> bool {
    // `it` in a method-call arg wraps the arg in a synthesized (it) -> lambda
    // (method calls parse as Call(FieldAccess(recv, name), args)).
    let probe = parse_expression_native_probe("xs.map(it + 1)")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Call(_, args) -> match args[0].node {
            .Lambda(params, _) -> {
                params.length == 1 && params[0].name == "it" && params[0].ty_id == none
            }
            _ -> false
        }
        _ -> false
    }
}

spec "F1d duals: params carry their type row where a type position exists" {
    given "an annotated and an unannotated fn param" {
        then "both ty_ids are present and display identically to vtype" {
            fn_param_duals_mirror()
        }
    }
    given "a method's self receiver" {
        then "self's ty_id carries the impl header type" {
            method_self_param_dual_mirrors()
        }
    }
    given "a typed lambda param" {
        then "ty_id mirrors the written annotation" {
            typed_lambda_param_dual_mirrors()
        }
    }
    given "positions that cannot carry a type" {
        then "untyped lambda params stay null" {
            untyped_lambda_param_duals_null()
        }
        then "destructure binding entries stay null" {
            name_list_param_duals_null()
        }
        then "use-name list entries stay null" {
            use_name_list_duals_null()
        }
        then "the synthesized it-lambda param stays null" {
            it_lambda_param_dual_null()
        }
    }
}
