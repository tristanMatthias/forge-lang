// WHY: B-final F1a/F4 — the walker-opaque containers (WhenArm, SelectArm,
// MatchArm, Annotation, CompConfig) hold their child exprs/stmts as arena ids.
// Fully-flipped child slots (WhenArm cond/body — F4c; MatchArm guard/body — F4b;
// SelectArm chan/body — F4d; CompConfig default — F4d; Annotation args — F4d)
// have dropped the boxed half entirely; their specs verify the id is present and
// resolves to the EXACT expected node. Two slots stay dual on otherwise-flipped
// containers: MatchArm's pattern, and CompConfig's ty_vt/ty_id (the
// ValueType/TypeId dual).

use @std.avrac.parse.{parse_program_source, parse_expression_native_probe}
use @std.avrac.core.{Expr, Stmt, StmtId, render_expr, render_stmt, render_pattern, vtype_display, stmt_unwrap, NodeStore, ExprId}

/// Dig the first statement of the first fn's body out of a served program.
fn first_body_stmt(store: NodeStore, stmts: List<StmtId>) -> Stmt {
    match stmt_unwrap(store, store.stmts.get(stmts[0])) {
        .Function(_, _, _, _, body) -> stmt_unwrap(store, store.stmts.get(body[0]))
        _ -> Stmt.NoOp
    }
}

/// Each then body lives in a helper fn: a bare `return` inside a then-block
/// returns out of the synthesized unit fn and silently drops registrations
/// (filed bug) — helpers own the early returns.
fn when_bodies_mirror() -> bool {
    let probe = parse_expression_native_probe("when { a > 1 -> f(a)  _ -> g() }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .When(arms) -> {
            if arms.length != 2 { return false }
            // B-final F4c: WhenArm.body is arena-only (boxed body gone). Verify
            // each body_id resolves to its EXACT expr — a miswired/swapped id
            // renders differently, so exact-match keeps the coverage the old
            // boxed-vs-id equality gave.
            if render_expr(probe.store, probe.store.exprs.get(arms[0].body_id)) != "(call f (a))" { return false }
            render_expr(probe.store, probe.store.exprs.get(arms[1].body_id)) == "(call g ())"
        }
        _ -> false
    }
}

fn when_conds_mirror() -> bool {
    let probe = parse_expression_native_probe("when { a > 1 -> f(a)  _ -> g() }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .When(arms) -> {
            // B-final F4c: cond is arena-only. arm[0]'s cond_id resolves to the
            // exact condition; arm[1] is the `_` else arm (no condition).
            if arms[0].cond_id == none { return false }
            if render_expr(probe.store, probe.store.exprs.get(arms[0].cond_id!)) != "(> a 1)" { return false }
            arms[1].cond_id == none
        }
        _ -> false
    }
}

fn select_arm_mirrors() -> bool {
    let src = "fn f(c: Channel<int>) -> int {\n    select {\n        v <- c -> {\n            handle(v)\n            log(v)\n        }\n    }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match first_body_stmt(r.store, r.ids!) {
        .Select(arms) -> {
            if arms.length != 1 { return false }
            let arm = arms[0]
            // F4d: SelectArm is arena-only (boxed chan/body dropped). chan_id
            // resolves to the exact channel expr; body_ids to the arm's stmts.
            if render_expr(r.store, r.store.exprs.get(arm.chan_id)) != render_expr(r.store, Expr.Ident("c")) { return false }
            if arm.body_ids.length != 2 { return false }
            let s0 = render_stmt(r.store, r.store.stmts.get(arm.body_ids[0]))
            let s1 = render_stmt(r.store, r.store.stmts.get(arm.body_ids[1]))
            s0.contains("handle") && s1.contains("log")
        }
        _ -> false
    }
}

fn annotation_args_mirror() -> bool {
    let src = "@limit(3 + 4, name)\nfn f() -> int { 1 }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match r.store.stmts.get(r.ids![0]) {
        .Annotated(annots, _) -> {
            if annots.length != 1 { return false }
            let a = annots[0]
            if a.arg_ids == none { return false }
            let ids = a.arg_ids!
            if ids.length != 2 { return false }
            // Args are arena-only now (boxed args dropped) — each arg_id resolves
            // to its exact expr: `@limit(3 + 4, name)` → `(+ 3 4)`, `name`.
            render_expr(r.store, r.store.exprs.get(ids[0])) == "(+ 3 4)"
                && render_expr(r.store, r.store.exprs.get(ids[1])) == "name"
        }
        _ -> false
    }
}

fn doc_annotation_mirrors() -> bool {
    let src = "/// adds one\nfn inc(x: int) -> int { x + 1 }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match r.store.stmts.get(r.ids![0]) {
        .Annotated(annots, _) -> {
            let a = annots[0]
            if a.arg_ids == none || a.arg_ids!.length != 1 { return false }
            render_expr(r.store, r.store.exprs.get(a.arg_ids![0])).contains("adds one")
        }
        _ -> false
    }
}

fn comp_config_mirrors() -> bool {
    let src = "component counter {\n    config {\n        start: int = 5\n        label: string\n    }\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match stmt_unwrap(r.store, r.store.stmts.get(r.ids![0])) {
        .ComponentDef(_, _, config, _, _, _) -> {
            if config.length != 2 { return false }
            let with_default = config[0]
            let plain = config[1]
            if with_default.ty_id == none || plain.ty_id == none { return false }
            // The defaulted key (`start: int = 5`) carries a default_id row
            // resolving to its literal; the undefaulted key (`label`) carries none.
            if with_default.default_id == none { return false }
            if render_expr(r.store, r.store.exprs.get(with_default.default_id!)) != "5" { return false }
            plain.default_id == none
        }
        _ -> false
    }
}

spec "F4c: when arms carry arena cond/body ids (boxed halves removed)" {
    given "a when expression parsed through the native probe" {
        then "each arm's body_id resolves to its exact body expr" {
            when_bodies_mirror()
        }
        then "a conditioned arm carries cond_id; the wildcard arm carries none" {
            when_conds_mirror()
        }
    }
}

spec "F1a duals: select arms carry chan/body rows that mirror the boxed halves" {
    given "a select statement inside a fn body" {
        then "chan_id and per-element body_ids are present and agree" {
            select_arm_mirrors()
        }
    }
}

spec "F4d: annotation args are arena ids (boxed args removed)" {
    given "an annotated declaration with expression args" {
        then "each arg_id resolves to its exact arg expr, in order" {
            annotation_args_mirror()
        }
        then "a doc comment's synthesized annotation carries its string row" {
            doc_annotation_mirrors()
        }
    }
}

spec "F1a duals: component config rows carry type + default ids" {
    given "a component with a defaulted and an undefaulted config key" {
        then "ty_id is always present; default_id resolves for a defaulted key, none otherwise" {
            comp_config_mirrors()
        }
    }
}

// ── F4: FieldInit.value_id (boxed `value` retired) ──

fn field_init_duals_mirror() -> bool {
    let src = "fn f() -> int {\n    let p = P { x: 1 + 2, y }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match first_body_stmt(r.store, r.ids!) {
        .Let(_, _, init) -> match r.store.exprs.get(init) {
            .StructLit(_, inits) -> {
                if inits.length != 2 { return false }
                // F4: each init's value_id resolves to its parsed value expr —
                // `x: 1 + 2` (a binary) and the shorthand `y` (an Ident).
                let x_render = render_expr(r.store, r.store.exprs.get(inits[0].value_id))
                let y_render = render_expr(r.store, r.store.exprs.get(inits[1].value_id))
                x_render != "" && x_render != y_render && y_render == render_expr(r.store, Expr.Ident("y"))
            }
            _ -> false
        }
        _ -> false
    }
}

fn table_row_field_duals_mirror() -> bool {
    let src = "fn f() -> int {\n    let rows = table {\n        a | b\n        1 | 2\n    }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match first_body_stmt(r.store, r.ids!) {
        .Let(_, _, init) -> match r.store.exprs.get(init) {
            .ListLit(rows) -> match r.store.exprs.get(rows[0]) {
                .StructLit(_, inits) -> {
                    if inits.length != 2 { return false }
                    // F4: each cell's value_id resolves to its parsed cell expr.
                    render_expr(r.store, r.store.exprs.get(inits[0].value_id)) == render_expr(r.store, Expr.Number("1"))
                        && render_expr(r.store, r.store.exprs.get(inits[1].value_id)) == render_expr(r.store, Expr.Number("2"))
                }
                _ -> false
            }
            _ -> false
        }
        _ -> false
    }
}

spec "F4: struct-literal field inits carry a resolved value_id (boxed value retired)" {
    given "explicit and shorthand field inits" {
        then "every value_id resolves to its parsed value expr" {
            field_init_duals_mirror()
        }
    }
    given "table-literal rows" {
        then "each cell's FieldInit value_id resolves to its cell expr" {
            table_row_field_duals_mirror()
        }
    }
}

// ── F1c: MatchArm pattern dual + arena-only guard/body (F4b) ──

fn match_arm_ids_resolve() -> bool {
    let probe = parse_expression_native_probe("match x { 1 if g -> a, _ -> b }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .MatchExpr(_, arms) -> {
            if arms.length != 2 { return false }
            // pattern stays dual: the id resolves to the same render as the
            // boxed pattern half.
            for arm in arms {
                if arm.pattern_id == none { return false }
                if render_pattern(probe.store, probe.store.pats.get(arm.pattern_id!)) != render_pattern(probe.store, arm.pattern) { return false }
            }
            // B-final F4b: guard/body are arena-only (boxed halves gone). Verify
            // each id resolves to its EXACT expr — a miswired/swapped id renders
            // differently, so exact-match keeps the coverage the boxed-vs-id
            // equality used to give.
            if render_expr(probe.store, probe.store.exprs.get(arms[0].body_id)) != render_expr(probe.store, Expr.Ident("a")) { return false }
            if render_expr(probe.store, probe.store.exprs.get(arms[1].body_id)) != render_expr(probe.store, Expr.Ident("b")) { return false }
            let guarded = arms[0]
            if guarded.guard_id == none { return false }
            if render_expr(probe.store, probe.store.exprs.get(guarded.guard_id!)) != render_expr(probe.store, Expr.Ident("g")) { return false }
            arms[1].guard_id == none
        }
        _ -> false
    }
}

fn quote_arm_ids_resolve() -> bool {
    let probe = parse_expression_native_probe("quote arm { 1 if g -> 2 }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Quote(_, body) -> match probe.store.exprs.get(body) {
            .MatchExpr(_, arms) -> {
                if arms.length != 1 { return false }
                let arm = arms[0]
                if arm.pattern_id == none || arm.guard_id == none { return false }
                if render_pattern(probe.store, probe.store.pats.get(arm.pattern_id!)) != render_pattern(probe.store, arm.pattern) { return false }
                if render_expr(probe.store, probe.store.exprs.get(arm.guard_id!)) != render_expr(probe.store, Expr.Ident("g")) { return false }
                render_expr(probe.store, probe.store.exprs.get(arm.body_id)) == render_expr(probe.store, Expr.Number("2"))
            }
            _ -> false
        }
        _ -> false
    }
}

fn unguarded_quote_arm_guard_null() -> bool {
    let probe = parse_expression_native_probe("quote arm { 1 -> 2 }")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Quote(_, body) -> match probe.store.exprs.get(body) {
            .MatchExpr(_, arms) -> {
                if arms.length != 1 { return false }
                let arm = arms[0]
                arm.guard_id == none && arm.pattern_id != none
                    && render_expr(probe.store, probe.store.exprs.get(arm.body_id)) == render_expr(probe.store, Expr.Number("2"))
            }
            _ -> false
        }
        _ -> false
    }
}

fn table_arm_pattern_dual_mirrors() -> bool {
    let src = "fn f(s: int) -> int {\n    let r = match s table {\n        pattern | label\n        1 | \"one\"\n    }\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match first_body_stmt(r.store, r.ids!) {
        .Let(_, _, init) -> match r.store.exprs.get(init) {
            .MatchExpr(_, arms) -> {
                if arms.length != 1 { return false }
                let arm = arms[0]
                if arm.pattern_id == none { return false }
                if render_pattern(r.store, r.store.pats.get(arm.pattern_id!)) != render_pattern(r.store, arm.pattern) { return false }
                // The body is synthesized table glue — a MapLit of the row's
                // cells — carried in body_id; table rows have no guard slot.
                if arm.guard_id != none { return false }
                match r.store.exprs.get(arm.body_id) {
                    .MapLit(_) -> true
                    _ -> false
                }
            }
            _ -> false
        }
        _ -> false
    }
}

spec "F1c: match arms carry a dual pattern + arena-only guard/body ids" {
    given "a guarded and a wildcard arm parsed through the native probe" {
        then "pattern_id mirrors the boxed pattern; body/guard ids resolve exactly" {
            match_arm_ids_resolve()
        }
    }
    given "a quote arm with a guard" {
        then "the envelope's single arm carries pattern/guard/body ids" {
            quote_arm_ids_resolve()
        }
    }
    given "a quote arm without a guard" {
        then "guard_id stays null while the body id resolves to its expr" {
            unguarded_quote_arm_guard_null()
        }
    }
    given "a match table row" {
        then "the pattern row is real; the synthesized MapLit body rides body_id" {
            table_arm_pattern_dual_mirrors()
        }
    }
}

// ── F1d: ParamEntry.ty_id ──

fn fn_param_duals_mirror() -> bool {
    let src = "fn add(x: int, y) -> int { x }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match stmt_unwrap(r.store, r.store.stmts.get(r.ids![0])) {
        .Function(_, _, params, _, _) -> {
            if params.length != 2 { return false }
            // x carries the written annotation; y carries the Int default —
            // the dual mirrors BOTH (it tracks vtype, not the surface text).
            for p in params {
                if p.ty_id == none { return false }
                if vtype_display(r.store.types.get(p.ty_id!)) != vtype_display(p.vtype) { return false }
            }
            true
        }
        _ -> false
    }
}

fn method_self_param_dual_mirrors() -> bool {
    let src = "type P = { x: int }\nimpl P {\n    fn get(self) -> int { 1 }\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match stmt_unwrap(r.store, r.store.stmts.get(r.ids![1])) {
        .Impl(_, methods) -> match stmt_unwrap(r.store, r.store.stmts.get(methods[0])) {
            .Function(_, _, params, _, _) -> {
                if params.length != 1 { return false }
                let self_p = params[0]
                if self_p.ty_id == none { return false }
                vtype_display(r.store.types.get(self_p.ty_id!)) == vtype_display(self_p.vtype)
            }
            _ -> false
        }
        _ -> false
    }
}

fn typed_lambda_param_dual_mirrors() -> bool {
    let probe = parse_expression_native_probe("(x: string) -> x")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Lambda(params, _) -> {
            if params.length != 1 { return false }
            let p = params[0]
            if p.ty_id == none { return false }
            vtype_display(probe.store.types.get(p.ty_id!)) == vtype_display(p.vtype)
        }
        _ -> false
    }
}

fn untyped_lambda_param_duals_null() -> bool {
    let probe = parse_expression_native_probe("(x, y) -> x")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Lambda(params, _) -> {
            params.length == 2 && params[0].ty_id == none && params[1].ty_id == none
        }
        _ -> false
    }
}

fn name_list_param_duals_null() -> bool {
    let src = "fn f() -> int {\n    let (a, b) = t\n    0\n}\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match first_body_stmt(r.store, r.ids!) {
        .LetDestructure(names, _) -> {
            names.length == 2 && names[0].ty_id == none && names[1].ty_id == none
        }
        _ -> false
    }
}

fn use_name_list_duals_null() -> bool {
    let src = "use @std.avrac.core.{Expr, Stmt}\nfn f() -> int { 0 }\n"
    let r = parse_program_source(src)
    if r.had_error != 0 || r.ids == null { return false }
    match stmt_unwrap(r.store, r.store.stmts.get(r.ids![0])) {
        .Use(_, names) -> {
            names.length == 2 && names[0].ty_id == none && names[1].ty_id == none
        }
        _ -> false
    }
}

fn it_lambda_param_dual_null() -> bool {
    // `it` in a method-call arg wraps the arg in a synthesized (it) -> lambda
    // (method calls parse as Call(FieldAccess(recv, name), args)).
    let probe = parse_expression_native_probe("xs.map(it + 1)")
    if probe.had_error != 0 { return false }
    match probe.store.exprs.get(probe.root) {
        .Call(_, args) -> match probe.store.exprs.get(args[0]) {
            .Lambda(params, _) -> {
                params.length == 1 && params[0].name == "it" && params[0].ty_id == none
            }
            _ -> false
        }
        _ -> false
    }
}

spec "F1d duals: params carry their type row where a type position exists" {
    given "an annotated and an unannotated fn param" {
        then "both ty_ids are present and display identically to vtype" {
            fn_param_duals_mirror()
        }
    }
    given "a method's self receiver" {
        then "self's ty_id carries the impl header type" {
            method_self_param_dual_mirrors()
        }
    }
    given "a typed lambda param" {
        then "ty_id mirrors the written annotation" {
            typed_lambda_param_dual_mirrors()
        }
    }
    given "positions that cannot carry a type" {
        then "untyped lambda params stay null" {
            untyped_lambda_param_duals_null()
        }
        then "destructure binding entries stay null" {
            name_list_param_duals_null()
        }
        then "use-name list entries stay null" {
            use_name_list_duals_null()
        }
        then "the synthesized it-lambda param stays null" {
            it_lambda_param_dual_null()
        }
    }
}
