// ps3t.6.5.12 / t-47hc.37 — the type-family ENGINE differential.
//
// `parse_type_expr` is UNCONDITIONAL now: it runs the type grammar and owns its own
// error path. The `type_flip` field and the hand parser `parse_type_expr_hand` it used
// to fall through to are both DELETED — the last of the three hand tails.
//
// WHICH TWO ENGINES: `type_static` selects the CHECKED-IN generated parser
// (run_static_type, parse/gen_type_parser.av) or the tree INTERPRETER
// (run_dsl_type_at_shared). The interpreter is still PRODUCTION for this family, so
// both sides ship and this is a live differential rather than a museum piece.
//
// Equivalence = same tree: for every type form both engines must build the same
// TypeExpr, lowered + rendered identically. This complements the run_dsl_type_at
// differential (which proves the runner) by proving the parse_type_expr DISPATCH.
//
// The helpers require a NON-error render on the valid forms. Bare equality would pass
// on a mutual error sentinel — the vacuity CodeRabbit caught in the statement sibling
// on PR #1221, fixed here at the same time rather than waiting to be caught twice.
use @std.avrac.parse.{parser_new}
use @std.avrac.core.{render_type_id, type_expr_to_vtype}

/// The INTERPRETER engine (type_static off).
fn flip_type(src: string) -> string {
    mut p = parser_new(src)
    p.type_static = false
    match p.parse_type_expr("expected type") {
        .Ok(te) -> {
            let tid = p.store.types.add_leaf(type_expr_to_vtype(te))
            render_type_id(p.store, tid)
        }
        .Err(_) -> "<flip parse error>"
    }
}

/// The GENERATED engine (type_static on) — pinned, not ambient, so the two sides
/// cannot collapse onto one engine.
fn hand_type(src: string) -> string {
    mut p = parser_new(src)
    p.type_static = true
    match p.parse_type_expr("expected type") {
        .Ok(te) -> {
            let tid = p.store.types.add_leaf(type_expr_to_vtype(te))
            render_type_id(p.store, tid)
        }
        .Err(_) -> "<parse error>"
    }
}

fn agree(src: string) -> bool {
    let interp = flip_type(src)
    interp != "<flip parse error>" && interp == hand_type(src)
}

spec "t-47hc.37: parse_type_expr — interpreter engine == generated engine" {
    given "the field toggles the path (sanity: flip really took the DSL branch)" {
        then "flip and hand render the same non-error type for a representative form" {
            flip_type("Map<string, List<int>>") == "Map<string, List<int>>" &&
            hand_type("Map<string, List<int>>") == "Map<string, List<int>>"
        }
    }
    given "the full parse_type_expr surface" {
        then "primitives, names, nullables, generics, list/tuple, unions, fn, dyn agree" {
            agree("int") && agree("string") && agree("bool") && agree("float") &&
            agree("Foo") && agree("MyType") &&
            agree("int?") && agree("Foo?") && agree("Result<int, string>?") &&
            agree("List<int>") && agree("Map<string, int>") && agree("Result<int, string>") &&
            agree("Foo<A>") && agree("Pair<A, B>") &&
            agree("[int]") && agree("[Foo]") &&
            agree("(int, string)") && agree("(int, bool, Foo)") && agree("(int)") &&
            agree("int | string") && agree("int | string | bool") && agree("List<int> | string") &&
            agree("fn(int) -> bool") && agree("fn(int, string) -> Foo") &&
            agree("fn() -> int") && agree("fn -> int") && agree("fn") &&
            agree("dyn Display") && agree("dyn Iterator")
        }
    }
    given "nested generics and qualified atoms (program-grammar-only forms)" {
        then "flip path agrees with hand on the selfhost-critical forms" {
            agree("List<List<int>>") &&
            agree("Map<string, Map<int, bool>>") &&
            agree("@std::avrac::core::ExprId") &&
            agree("List<@std::avrac::core::ExprId>") &&
            agree("@std::avrac::core::Result<int, string>")
        }
    }
}
