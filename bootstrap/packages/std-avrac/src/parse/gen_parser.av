            if !s_cut { break }
            let lb = parse_lambda_body(st)
            if s_cut || (st.diags.length == s_diags && st.had_error == s_err) {
                return CapVal.Node(mk_lambda(st, sp_start, CapVal.Nodes(a_list), capval_to_expr(st, lb)))
            }
            break
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.set_gensym_seq(s_gensym)
        st.restore_postfix_state(s_postfix)
    }
    if st.cur().tk == Tk.LeftParen {
        tried_spec = true
        let s_pos = st.pos
        let s_mark = st.store.mark()
        let s_diags = st.diags.length
        let s_err = st.had_error
        let s_gensym = st.gensym_seq
        let s_postfix = st.save_postfix_state()
        let sp_start = st.cur().pos
        mut rest_list: List<ExprId> = []
        let _ = st.advance()
        let __modes_1 = st.modes
        st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
        let first = parse_expression(st)
        st.set_modes(__modes_1)
        if !(st.cur().tk == Tk.Comma) {
            st.report("expected at least one repetition")
        }
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            if starts_expression(st) {
                let __modes_0 = st.modes
                st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
                rest_list.push(capval_to_expr(st, parse_expression(st)))
                st.set_modes(__modes_0)
            }
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected `)`")
        }
        if st.diags.length == s_diags && st.had_error == s_err {
            return CapVal.Node(mk_tuple_fr(st, sp_start, first, CapVal.Nodes(rest_list)))
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.set_gensym_seq(s_gensym)
        st.restore_postfix_state(s_postfix)
    }
    if st.cur().tk == Tk.LeftParen {
        let sp_start = st.cur().pos
        mut e: CapVal = CapVal.Nil
        let _ = st.advance()
        if starts_expression(st) {
            let __modes_0 = st.modes
            st.set_modes(modes_with_flag_on(st.modes, "allow_dot_postfix"))
            e = parse_expression(st)
            st.set_modes(__modes_0)
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected `)` after expression")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        return CapVal.Node(mk_group_or_empty(st, sp_start, e))
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_lambda_body(st: PState) -> CapVal {
    if starts_block_expr(st) {
        return parse_block_expr(st)
    }
    parse_expression(st)
}

fn parse_param(st: PState) -> CapVal {
    mut pt: CapVal = CapVal.Nil
    let pname = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon {
        let _ = st.advance()
        if !(starts_type_expr(st)) {
            st.report("expected parameter type after `:`")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        st.set_abort_prop(false)
        let __rres1 = parse_type_expr(st)
        if st.abort_prop || capval_is_error_expr(st, __rres1) || capval_is_error_stmt(st, __rres1) {
            return CapVal.Node(st.error_node_silent())
        }
        pt = __rres1
    }
    mk_param(st, capval_tok_text(pname), pt, capval_present(pt))
}

fn parse_table_cell(st: PState) -> CapVal {
    if starts_qualified_expr(st) {
        return parse_qualified_expr(st)
    }
    if (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if st.cur().tk == Tk.String {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if starts_null_cell(st) {
        return parse_null_cell(st)
    }
    if starts_variant_ctor(st) {
        return parse_variant_ctor(st)
    }
    if lookahead_ok("ident_lbrace_plain", st) && st.modes.allow_struct_lit != 0 && (starts_struct_lit_expr(st)) {
        return parse_struct_lit_expr(st)
    }
    if lookahead_ok("ident_template", st) && (starts_tagged_template(st)) {
        return parse_tagged_template(st)
    }
    if lookahead_ok("ident_plain", st) && (st.cur().tk == Tk.Identifier) {
        return CapVal.Node(literal_node(st, st.advance()))
    }
    if lookahead_ok("ident_lbrace_feature", st) && (starts_grammar_expr(st)) {
        return parse_grammar_expr(st)
    }
    if lookahead_ok("ident_lbrace_feature", st) && (starts_table_lit(st)) {
        return parse_table_lit(st)
    }
    if starts_paren_expr(st) {
        return parse_paren_expr(st)
    }
    if starts_list_expr(st) {
        return parse_list_expr(st)
    }
    if starts_match_expr(st) {
        return parse_match_expr(st)
    }
    if starts_if_expr(st) {
        return parse_if_expr(st)
    }
    if starts_spawn_expr(st) {
        return parse_spawn_expr(st)
    }
    if starts_channel_expr(st) {
        return parse_channel_expr(st)
    }
    if starts_isolated_expr(st) {
        return parse_isolated_expr(st)
    }
    if starts_when_expr(st) {
        return parse_when_expr(st)
    }
    if lookahead_ok("quote_arm", st) && (starts_quote_arm_expr(st)) {
        return parse_quote_arm_expr(st)
    }
    if lookahead_ok("quote_type", st) && (starts_quote_type_expr(st)) {
        return parse_quote_type_expr(st)
    }
    if starts_quote_expr(st) {
        return parse_quote_expr(st)
    }
    if starts_template_lit(st) {
        return parse_template_lit(st)
    }
    parse_brace_expr(st)
}

fn parse_null_cell(st: PState) -> CapVal {
    let n = CapVal.Tok(st.advance())
    n
}

fn parse_type_expr(st: PState) -> CapVal {
    mut r_list: List<TypeExpr> = []
    let l = parse_type_atom(st)
    while st.cur().tk == Tk.Pipe {
        let _ = st.advance()
        r_list.push(capval_to_texpr(st, parse_type_atom(st)))
    }
    fold_type_union(st, l, r_list)
}

fn parse_splice_type(st: PState) -> CapVal {
    mut opt: CapVal = CapVal.Nil
    let _ = st.advance()
    let sn = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected `IDENT`")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Question {
        opt = CapVal.Tok(st.advance())
    }
    mk_splice_type(capval_tok_text(sn), capval_present(opt))
}

fn parse_type_atom(st: PState) -> CapVal {
    if starts_splice_type(st) {
        return parse_splice_type(st)
    }
    if starts_qualified_type(st) {
        return parse_qualified_type(st)
    }
    if starts_fn_type(st) {
        return parse_fn_type(st)
    }
    if starts_dyn_type(st) {
        return parse_dyn_type(st)
    }
    if starts_list_type(st) {
        return parse_list_type(st)
    }
    if starts_paren_type(st) {
        return parse_paren_type(st)
    }
    if starts_named_type(st) {
        return parse_named_type(st)
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_qualified_type(st: PState) -> CapVal {
    mut qname_list: List<Token> = []
    mut qa_list: List<TypeExpr> = []
    mut qopt: CapVal = CapVal.Nil
    let _ = st.advance()
    if st.cur().tk == Tk.Identifier { qname_list.push(st.advance()) } else {
        st.report_ident("expected `IDENT`")
    }
    if !(lookahead_ok("double_colon", st) && (st.cur().tk == Tk.Colon)) {
        st.report("expected at least one repetition")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    while lookahead_ok("double_colon", st) && (st.cur().tk == Tk.Colon) {
        let _ = st.advance()
        if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
            st.report("expected `:`")
        }
        if st.cur().tk == Tk.Identifier { qname_list.push(st.advance()) } else {
            st.report_ident("expected `IDENT`")
        }
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        qa_list.push(capval_to_texpr(st, parse_type_expr(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            qa_list.push(capval_to_texpr(st, parse_type_expr(st)))
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected `>`")
        }
    }
    if st.cur().tk == Tk.Question {
        qopt = CapVal.Tok(st.advance())
    }
    mk_qualified_type(qname_list, qa_list.length > 0, qa_list, capval_present(qopt))
}

fn parse_fn_type(st: PState) -> CapVal {
    mut p_list: List<TypeExpr> = []
    mut lp: CapVal = CapVal.Nil
    mut r: CapVal = CapVal.Nil
    let _ = st.advance()
    if st.cur().tk == Tk.LeftParen {
        lp = CapVal.Tok(st.advance())
        if starts_type_expr(st) {
            p_list.push(capval_to_texpr(st, parse_type_expr(st)))
            while st.cur().tk == Tk.Comma {
                let _ = st.advance()
                p_list.push(capval_to_texpr(st, parse_type_expr(st)))
            }
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected `)`")
        }
    }
    if st.cur().tk == Tk.Arrow {
        let _ = st.advance()
        r = parse_type_expr(st)
    }
    mk_fn_type(st, capval_present(lp), p_list, capval_present(r), r)
}

fn parse_dyn_type(st: PState) -> CapVal {
    mut opt: CapVal = CapVal.Nil
    let _ = st.advance()
    let t = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected `IDENT`")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Question {
        opt = CapVal.Tok(st.advance())
    }
    mk_dyn_type(capval_tok_text(t), capval_present(opt))
}

fn parse_list_type(st: PState) -> CapVal {
    let _ = st.advance()
    let e = parse_type_expr(st)
    if st.cur().tk == Tk.RightBracket { let _ = st.advance() } else {
        st.report("expected `]`")
    }
    CapVal.TExpr(TypeExpr.ListType(capval_to_texpr(st, e)))
}

fn parse_paren_type(st: PState) -> CapVal {
    mut t_list: List<TypeExpr> = []
    let _ = st.advance()
    if starts_type_expr(st) {
        t_list.push(capval_to_texpr(st, parse_type_expr(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            t_list.push(capval_to_texpr(st, parse_type_expr(st)))
        }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected `)`")
    }
    mk_paren_type(t_list)
}

fn parse_named_type(st: PState) -> CapVal {
    mut name_list: List<Token> = []
    mut a_list: List<TypeExpr> = []
    mut opt: CapVal = CapVal.Nil
    name_list.push(st.advance())
    while st.cur().tk == Tk.Dot {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { name_list.push(st.advance()) } else {
            st.report_ident("expected `IDENT`")
        }
    }
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        a_list.push(capval_to_texpr(st, parse_type_expr(st)))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            a_list.push(capval_to_texpr(st, parse_type_expr(st)))
        }
        if (st.cur().tk == Tk.Greater || st.cur().text == ">>") { let _ = (if st.cur().text == ">>" { st.split_gt() } else { st.advance() }) } else {
            st.report("expected `>`")
        }
    }
    if st.cur().tk == Tk.Question {
        opt = CapVal.Tok(st.advance())
    }
    mk_named_type(capval_tok_text(CapVal.Toks(name_list)), a_list.length > 0, a_list, capval_present(opt))
}

fn parse_pattern_or(st: PState) -> CapVal {
    mut r: CapVal = CapVal.Nil
    let l = parse_pattern(st)
    if st.cur().text == "or" {
        let _ = st.advance()
        r = parse_pattern_or(st)
    }
    match r { .Nil -> l  _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.Or(capval_to_pat(st, l), capval_to_pat(st, r)))) }
}

fn parse_pattern(st: PState) -> CapVal {
    if starts_opt_present(st) {
        return parse_opt_present(st)
    }
    if starts_opt_absent(st) {
        return parse_opt_absent(st)
    }
    if starts_variant_pat(st) {
        return parse_variant_pat(st)
    }
    if starts_ident_pat(st) {
        return parse_ident_pat(st)
    }
    if starts_bool_pat(st) {
        return parse_bool_pat(st)
    }
    if starts_str_pat(st) {
        return parse_str_pat(st)
    }
    if starts_neg_pat(st) {
        return parse_neg_pat(st)
    }
    if starts_num_pat(st) {
        return parse_num_pat(st)
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_opt_present(st: PState) -> CapVal {
    let _ = st.advance()
    let name = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected `IDENT`")
        CapVal.Tok(st.cur())
    }
    CapVal.PNode(st.store.pats.add_leaf(pattern_optional_present(capval_tok_text(name))))
}

fn parse_opt_absent(st: PState) -> CapVal {
    let _ = st.advance()
    CapVal.PNode(st.store.pats.add_leaf(pattern_optional_absent()))
}

fn parse_variant_pat(st: PState) -> CapVal {
    mut binds_list: List<Token> = []
    mut subs_list: List<PatId> = []
    let _ = st.advance()
    let name = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected `IDENT`")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.LeftParen {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier {
            binds_list.push(st.advance())
            while st.cur().tk == Tk.Comma {
                let _ = st.advance()
                if st.cur().tk == Tk.Identifier { binds_list.push(st.advance()) } else {
                    st.report_ident("expected `IDENT`")
                }
            }
        } else if starts_variant_pat(st) {
            subs_list.push(capval_to_pat(st, parse_variant_pat(st)))
            while st.cur().tk == Tk.Comma {
                let _ = st.advance()
                subs_list.push(capval_to_pat(st, parse_pattern(st)))
            }
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected `)`")
        }
    }
    if subs_list.length > 0 { CapVal.PNode(st.store.pats.add_leaf(Pattern.NestedVariant(capval_tok_text(name), subs_list))) } else { CapVal.PNode(st.store.pats.add_leaf(Pattern.Variant(capval_tok_text(name), param_entries_from_toks(CapVal.Toks(binds_list), ValueType.Int)))) }
}

fn parse_ident_pat(st: PState) -> CapVal {
    mut b: CapVal = CapVal.Nil
    let name = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.LeftParen {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { b = CapVal.Tok(st.advance()) } else {
            st.report_ident("expected `IDENT`")
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected `)`")
        }
    }
    match b { .Nil -> CapVal.PNode(ident_pat_bare(st, capval_tok_text(name)))  _ -> CapVal.PNode(st.store.pats.add_leaf(Pattern.TypePattern(capval_tok_text(name), capval_tok_text(b)))) }
}

fn parse_bool_pat(st: PState) -> CapVal {
    let b = CapVal.Tok(st.advance())
    CapVal.PNode(pat_bool_node(st, capval_tok_text(b)))
}

fn parse_str_pat(st: PState) -> CapVal {
    let s = CapVal.Tok(st.advance())
    CapVal.PNode(pat_str_node(st, capval_tok_text(s)))
}

fn parse_neg_pat(st: PState) -> CapVal {
    let _ = st.advance()
    let n = if (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) { CapVal.Tok(st.advance()) } else {
        st.report("expected `NUMBER`")
        CapVal.Tok(st.cur())
    }
    CapVal.PNode(pat_num_node(st, capval_tok_text(n), true))
}

fn parse_num_pat(st: PState) -> CapVal {
    let n = CapVal.Tok(st.advance())
    CapVal.PNode(pat_num_node(st, capval_tok_text(n), false))
}

fn parse_match_when_arm(st: PState) -> CapVal {
    if st.cur().text == "_" {
        let _ = st.advance()
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected `->`")
        }
        let __modes_2 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
        let b = parse_expression(st)
        st.set_modes(__modes_2)
        return build_when_default_abi(st, [b])
    }
    if starts_expression(st) {
        let c = parse_expression(st)
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected `->`")
        }
        let __modes_2 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
        let b = parse_expression(st)
        st.set_modes(__modes_2)
        return build_when_arm_abi(st, [c, b])
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_match_arm(st: PState) -> CapVal {
    if st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) {
        let _ = st.advance()
        let t = parse_unary(st)
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
        return mk_splice_arm(st, t)
    }
    if starts_pattern_or(st) {
        mut g: CapVal = CapVal.Nil
        let p = parse_pattern_or(st)
        if st.cur().text == "if" {
            let _ = st.advance()
            g = parse_expression(st)
        }
        if st.cur().tk == Tk.Arrow { let _ = st.advance() } else {
            st.report("expected `->`")
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_dot_postfix"))
        let b = parse_arm_body(st)
        st.set_modes(__modes_3)
        return build_arm_abi(st, [p, g, b])
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_arm_body(st: PState) -> CapVal {
    if st.cur().text == "return" {
        let sp_start = st.cur().pos
        mut e: CapVal = CapVal.Nil
        let _ = st.advance()
        if (starts_expression(st)) && (st.pos == 0 || st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line == st.store.lines.to_linecol(st.cur().pos).line) {
            e = parse_expression(st)
        }
        return mk_arm_return(st, sp_start, e)
    }
    parse_expression(st)
}

fn parse_match_stmt(st: PState) -> CapVal {
    if lookahead_ok("match_subjectless", st) && (st.cur().text == "match") {
        let sp_start = st.cur().pos
        mut a_list: List<WhenArm> = []
        let _ = st.advance()
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected `{`")
        }
        while starts_match_when_arm(st) {
            a_list.push(capval_to_when_arm(st, parse_match_when_arm(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after match arms")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        return CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, mk_when(st, sp_start, CapVal.WArms(a_list))))))
    }
    if lookahead_ok("match_table", st) && (starts_match_table_stmt(st)) {
        return parse_match_table_stmt(st)
    }
    if st.cur().text == "match" {
        mut arms_list: List<MatchArm> = []
        let _ = st.advance()
        let __modes_1 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let subj = parse_expression(st)
        st.set_modes(__modes_1)
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected `{` after match subject")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        while starts_match_arm(st) {
            arms_list.push(capval_to_arm(st, parse_match_arm(st)))
            if st.cur().tk == Tk.Comma { let _ = st.advance() }
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}` after match arms")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        return build_match_abi(st, [subj, CapVal.Arms(arms_list)])
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_match_table_stmt(st: PState) -> CapVal {
    mut cols_list: List<Token> = []
    mut p_list: List<PatId> = []
    mut v_list: List<ExprId> = []
    let _ = st.advance()
    let __modes_1 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let subj = parse_expression(st)
    st.set_modes(__modes_1)
