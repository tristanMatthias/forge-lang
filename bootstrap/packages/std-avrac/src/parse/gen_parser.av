                st.clear_error()
                let __cv = parse_body_item(st)
                if st.had_error { __any_err = true }
                if st.abort_prop || capval_is_error_expr(st, __cv) || capval_is_error_stmt(st, __cv) {
                    __any_err = true
                    st.synchronize_stmt()
                    if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
                    st.set_abort_prop(false)
                    let __elc = st.store.lines.to_linecol(__sp)
                    let __e = error_stmt_of(st, __cv)
                    st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
                    imbody_list.push(__e)
                    st.clear_error()
                    continue
                }
                let __sid = capval_to_stmt(st, __cv)
                let __lc = st.store.lines.to_linecol(__sp)
                st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
                imbody_list.push(__sid)
                if st.pos == __before_i { break }
            }
            if __any_err { st.note_had_error() }
            if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
                st.report("expected `}` after method body")
                if s_cut {
                    st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
                }
            }
            if s_cut || (st.diags.length == s_diags && st.had_error == s_err) {
                return mk_method(st, capval_tok_text(imname), imparams_list, imret, capval_present(imret), imbody_list)
            }
            break
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.set_gensym_seq(s_gensym)
        st.restore_postfix_state(s_postfix)
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_statement(st: PState) -> CapVal {
    if starts_break_stmt(st) {
        return parse_break_stmt(st)
    }
    if starts_continue_stmt(st) {
        return parse_continue_stmt(st)
    }
    if lookahead_ok("if_let", st) && (starts_iflet_stmt(st)) {
        return parse_iflet_stmt(st)
    }
    if starts_if_stmt(st) {
        return parse_if_stmt(st)
    }
    if starts_for_stmt(st) {
        return parse_for_stmt(st)
    }
    if starts_while_stmt(st) {
        return parse_while_stmt(st)
    }
    if starts_match_stmt(st) {
        return parse_match_stmt(st)
    }
    if starts_defer_stmt(st) {
        return parse_defer_stmt(st)
    }
    if starts_errdefer_stmt(st) {
        return parse_errdefer_stmt(st)
    }
    if starts_return_stmt(st) {
        return parse_return_stmt(st)
    }
    if lookahead_ok("stmt_block", st) && (starts_stmt_block(st)) {
        return parse_stmt_block(st)
    }
    parse_expr_stmt(st)
}

fn parse_block(st: PState) -> CapVal {
    mut stmts_list: List<StmtId> = []
    let _ = st.advance()
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.at_end() || st.cur().text == "}" { break }
        let __sp = st.cur().pos
        let __before_i = st.pos
        st.clear_error()
        let __cv = parse_declaration(st)
        if st.had_error { __any_err = true }
        if st.abort_prop || capval_is_error_expr(st, __cv) || capval_is_error_stmt(st, __cv) {
            __any_err = true
            st.synchronize_stmt()
            if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
            st.set_abort_prop(false)
            let __elc = st.store.lines.to_linecol(__sp)
            let __e = error_stmt_of(st, __cv)
            st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
            stmts_list.push(__e)
            st.clear_error()
            continue
        }
        let __sid = capval_to_stmt(st, __cv)
        let __lc = st.store.lines.to_linecol(__sp)
        st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
        stmts_list.push(__sid)
        if st.pos == __before_i { break }
    }
    if __any_err { st.note_had_error() }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}`")
    }
    mk_block(st, 0 - 1, stmts_list)
}

fn parse_stmt_block(st: PState) -> CapVal {
    mut stmts_list: List<StmtId> = []
    let _ = st.advance()
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.at_end() || st.cur().text == "}" { break }
        let __sp = st.cur().pos
        let __before_i = st.pos
        st.clear_error()
        let __cv = parse_declaration(st)
        if st.had_error { __any_err = true }
        if st.abort_prop || capval_is_error_expr(st, __cv) || capval_is_error_stmt(st, __cv) {
            __any_err = true
            st.synchronize_stmt()
            if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
            st.set_abort_prop(false)
