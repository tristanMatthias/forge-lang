        }
        pci = __gres0
        if st.abort_prop {
            return CapVal.Node(st.error_node_silent())
        }
    }
    if st.cur().tk == Tk.LeftParen { let _ = st.advance() } else {
        st.report("expected `(` after component name")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if lookahead_ok("not_rparen", st) {
        st.set_abort_prop(false)
        if !(starts_param(st)) {
            st.report_ident("expected parameter name")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __gres0 = parse_param(st)
        if st.abort_prop || capval_is_error_expr(st, __gres0) {
            return CapVal.Node(st.error_node_silent())
        }
        pps_list.push(capval_to_pentry(st, __gres0))
        while lookahead_ok("comma_not_rparen", st) && (st.cur().tk == Tk.Comma) {
            let _ = st.advance()
            pps_list.push(capval_to_pentry(st, parse_param(st)))
        }
        if st.cur().tk == Tk.Comma {
            let _ = st.advance()
        }
        if st.abort_prop {
            return CapVal.Node(st.error_node_silent())
        }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected `)` after component params")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after component header")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if lookahead_ok("kw_config", st) {
        st.set_abort_prop(false)
        if !(starts_comp_config_block(st)) {
            st.report("expected comp_config_block")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __gres0 = parse_comp_config_block(st)
        if st.abort_prop || capval_is_error_expr(st, __gres0) {
            return CapVal.Node(st.error_node_silent())
        }
        pcfg = __gres0
        if st.abort_prop {
            return CapVal.Node(st.error_node_silent())
        }
    }
    let __pre_err = st.had_error
    mut __any_err = __pre_err
    while true {
        if st.cur().text == "}" { break }
        let __sp = st.cur().pos
        let __before_i = st.pos
        st.clear_error()
        let __cv = parse_comp_item(st)
        if st.had_error { __any_err = true }
        if st.abort_prop || capval_is_error_expr(st, __cv) || capval_is_error_stmt(st, __cv) {
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __sid = capval_to_stmt(st, __cv)
        let __lc = st.store.lines.to_linecol(__sp)
        st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
        pbody_list.push(__sid)
        if st.pos == __before_i { break }
    }
    if __any_err { st.note_had_error() }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` at end of component")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    mk_component_paren_def_g(st, capval_tok_text(pn), CapVal.PEntries(pps_list), capval_tok_texts(pci), pcfg, pbody_list)
}

fn parse_comp_impl_inst(st: PState) -> CapVal {
    let _ = st.advance()
    let iname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected `IDENT`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
        CapVal.Tok(st.cur())
    }
    let ici = parse_comp_implements(st)
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("`implements` clause must be followed by `{` or `(` — if you meant another trait name, add a `,` (instance-prefix component blocks may not carry an `implements` clause)")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    CapVal.Nil
}

