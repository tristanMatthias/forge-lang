                if st.pos == __before_i { break }
            }
            if __any_err { st.note_had_error() }
            if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
                st.report("expected `}` to close given block")
                if s_cut {
                    st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
                }
            }
            if s_cut || (st.diags.length == s_diags && st.had_error == s_err) {
                return mk_given_block_g(st, capval_tok_text(n), body_list)
            }
            break
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.set_gensym_seq(s_gensym)
        st.restore_postfix_state(s_postfix)
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_then_blk(st: PState) -> CapVal {
    mut tried_spec = false
    if st.cur().text == "then" {
        tried_spec = true
        let s_pos = st.pos
        let s_mark = st.store.mark()
        let s_diags = st.diags.length
        let s_err = st.had_error
        mut s_cut = false
        let s_gensym = st.gensym_seq
        let s_postfix = st.save_postfix_state()
        while true {
            mut body_list: List<StmtId> = []
            let _ = st.advance()
            if st.diags.length == s_diags && st.had_error == s_err { s_cut = true }
            if !s_cut { break }
            let n = if st.cur().tk == Tk.String { CapVal.Tok(st.advance()) } else {
                st.report("expected then name string after `then`")
                if s_cut {
                    st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
                }
                CapVal.Tok(st.cur())
            }
            if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
                st.report("expected `{` after then name")
                if s_cut {
                    st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
                }
            }
            let __pre_err = st.had_error
            mut __any_err = __pre_err
            while true {
                if st.at_end() || st.cur().text == "}" { break }
                let __sp = st.cur().pos
                let __before_i = st.pos
                st.clear_error()
                let __cv = parse_declaration(st)
                if st.had_error { __any_err = true }
                if st.abort_prop || capval_is_error_expr(st, __cv) || capval_is_error_stmt(st, __cv) {
                    __any_err = true
                    st.synchronize_stmt()
                    if st.cur().pos == __sp && !st.at_end() { let _ = st.advance() }
                    st.set_abort_prop(false)
                    let __elc = st.store.lines.to_linecol(__sp)
                    let __e = error_stmt_of(st, __cv)
                    st.store.stmts.record_pos(__e, SrcPos { line: __elc.line, col: __elc.col, file: st.file })
                    body_list.push(__e)
                    st.clear_error()
                    continue
                }
                let __sid = capval_to_stmt(st, __cv)
                let __lc = st.store.lines.to_linecol(__sp)
                st.store.stmts.record_pos(__sid, SrcPos { line: __lc.line, col: __lc.col, file: st.file })
                body_list.push(__sid)
                if st.pos == __before_i { break }
            }
            if __any_err { st.note_had_error() }
            if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
                st.report("expected `}` to close then block")
                if s_cut {
                    st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
                }
            }
            if s_cut || (st.diags.length == s_diags && st.had_error == s_err) {
                return mk_then_block_g(st, capval_tok_text(n), body_list)
            }
            break
        }
        st.store.truncate_to_mark(s_mark)
        st.restore_to(s_pos, s_diags, s_err)
        st.set_gensym_seq(s_gensym)
        st.restore_postfix_state(s_postfix)
    }
    if tried_spec { return CapVal.Nil }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_comp_header(st: PState) -> CapVal {
    if lookahead_ok("comp_inst_shape", st) && (starts_comp_inst(st)) {
        return parse_comp_inst(st)
    }
    if lookahead_ok("comp_paren_shape", st) && (starts_comp_paren_decl(st)) {
        return parse_comp_paren_decl(st)
    }
    if lookahead_ok("comp_implements_inst", st) && (starts_comp_impl_inst(st)) {
        return parse_comp_impl_inst(st)
    }
    if starts_component_decl(st) {
        return parse_component_decl(st)
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_comp_config_block(st: PState) -> CapVal {
    mut ccfg_list: List<CompConfig> = []
    let _ = st.advance()
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after `config`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    while lookahead_ok("not_rbrace", st) {
        let __rep_before = st.pos
        st.set_abort_prop(false)
        if !(starts_config_entry(st)) {
            st.report_ident("expected config key")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __gres0 = parse_config_entry(st)
        if st.abort_prop || capval_is_error_expr(st, __gres0) {
            return CapVal.Node(st.error_node_silent())
        }
        ccfg_list.push(capval_to_comp_config(st, __gres0))
        if st.abort_prop {
            return CapVal.Node(st.error_node_silent())
        }
        if st.pos == __rep_before { break }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` after config entries")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    mk_comp_config_list(CapVal.CCfgs(ccfg_list))
}

fn parse_comp_children_block(st: PState) -> CapVal {
    mut ccs_list: List<ChildrenSlot> = []
    let _ = st.advance()
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{` after `children`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if lookahead_ok("not_rbrace", st) {
        st.set_abort_prop(false)
        if !(starts_children_slot(st)) {
            st.report_ident("expected child slot name")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __gres0 = parse_children_slot(st)
        if st.abort_prop || capval_is_error_expr(st, __gres0) {
            return CapVal.Node(st.error_node_silent())
        }
        ccs_list.push(capval_to_children_slot(st, __gres0))
        while lookahead_ok("comma_ident", st) && (st.cur().tk == Tk.Comma) {
            let _ = st.advance()
            ccs_list.push(capval_to_children_slot(st, parse_children_slot(st)))
        }
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
        if st.abort_prop {
            return CapVal.Node(st.error_node_silent())
        }
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` after children entries")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    mk_children_slot_list(CapVal.CSlots(ccs_list))
}

fn parse_comp_body_marker(st: PState) -> CapVal {
    let _ = st.advance()
    if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
        st.report("expected `:` after `body`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    let bmn = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected a type after `body:`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
        CapVal.Tok(st.cur())
    }
    mk_comp_body_marker(st, capval_tok_text(bmn))
}

fn parse_comp_implements(st: PState) -> CapVal {
    mut ctr_list: List<Token> = []
    let _ = st.advance()
    if st.cur().tk == Tk.Identifier { ctr_list.push(st.advance()) } else {
        st.report_ident("expected trait name after `implements`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    while lookahead_ok("comma_ident", st) && (st.cur().tk == Tk.Comma) {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { ctr_list.push(st.advance()) } else {
            st.report_ident("expected trait name after `implements`")
        }
    }
    if st.cur().tk == Tk.Comma { let _ = st.advance() }
    mk_trait_list(CapVal.Toks(ctr_list))
}

fn parse_comp_paren_decl(st: PState) -> CapVal {
    mut pps_list: List<ParamEntry> = []
    mut pbody_list: List<StmtId> = []
    mut pci: CapVal = CapVal.Nil
    mut pcfg: CapVal = CapVal.Nil
    let _ = st.advance()
    let pn = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected component name")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
        CapVal.Tok(st.cur())
    }
    if lookahead_ok("kw_implements", st) {
        st.set_abort_prop(false)
        if !(starts_comp_implements(st)) {
            st.report("expected comp_implements")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __gres0 = parse_comp_implements(st)
        if st.abort_prop || capval_is_error_expr(st, __gres0) {
