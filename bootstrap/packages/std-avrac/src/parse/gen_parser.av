            let __bres0 = parse_with_suffix(st)
            if capval_is_error_expr(st, __bres0) || capval_is_error_stmt(st, __bres0) || st.diags.length != __bdiag0 {
                st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
            }
            s_list.push(capval_to_expr(st, __bres0))
        }
        return CapVal.Node(fold_postfix_with_expr(st, sp_start, b, CapVal.Nodes(p_list), CapVal.Nodes(s_list)))
    }
    if st.cur().tk == Tk.String {
        let sp_start = st.cur().pos
