fn binary_lbp_g(t: Token) -> int {
    if t.tk == Tk.Pipe { return 10 }
    if t.tk == Tk.Caret { return 12 }
    if t.tk == Tk.Amp { return 14 }
    if t.tk == Tk.Less || t.tk == Tk.LessEqual || t.tk == Tk.Greater || t.tk == Tk.GreaterEqual { return 16 }
    if t.tk == Tk.Shl || t.tk == Tk.Shr { return 18 }
    if t.tk == Tk.Plus || t.tk == Tk.Minus { return 20 }
    if t.tk == Tk.Star || t.tk == Tk.Slash || t.tk == Tk.Percent { return 22 }
    0
}

fn parse_binary_pratt_g_id(st: PState, min_bp: int) -> ExprId {
    let sp_start = st.cur().pos
    mut lhs = capval_to_expr(st, parse_unary(st))
    while true {
        let lbp = binary_lbp_g(st.cur())
        if lbp == 0 || lbp < min_bp { break }
        let tx = st.cur().text
        if (tx == "+" || tx == "-") && st.modes.cell_mode && st.pos > 0 && st.store.lines.to_linecol(st.toks[st.pos - 1].pos).line != st.store.lines.to_linecol(st.cur().pos).line { break }
        let _ = st.advance()
        let rhs = parse_binary_pratt_g_id(st, lbp + 1)
        lhs = mk_binary(st, sp_start, lhs, tx, rhs)
    }
    lhs
}

