fn parse_grammar_expr(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let _ = st.advance()
    if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
        st.report("expected `{`")
    }
    let body = CapVal.Tok(rawbrace_scan(st, "grammar"))
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}`")
    }
    CapVal.Node(mk_grammar_block(st, sp_start, body))
}

fn parse_table_lit(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut rows_list: List<ExprId> = []
    let _ = st.advance()
    let __bdiag1 = st.diags.length
    let __bres1 = parse_table_head(st)
    if capval_is_error_expr(st, __bres1) || capval_is_error_stmt(st, __bres1) || st.diags.length != __bdiag1 {
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    let _ = __bres1
    while starts_table_row(st) {
        let __bdiag0 = st.diags.length
        let __bres0 = parse_table_row(st)
        if capval_is_error_expr(st, __bres0) || capval_is_error_stmt(st, __bres0) || st.diags.length != __bdiag0 {
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        rows_list.push(capval_to_expr(st, __bres0))
    }
    if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
        st.report("expected `}` to close table")
    }
    CapVal.Node(mk_table_lit(st, sp_start, CapVal.Nodes(rows_list)))
}

fn parse_table_head(st: PState) -> CapVal {
    mut h_list: List<Token> = []
    mut rt: CapVal = CapVal.Nil
    if st.cur().tk == Tk.Less {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { rt = CapVal.Tok(st.advance()) } else {
            st.report_ident("expected `IDENT`")
