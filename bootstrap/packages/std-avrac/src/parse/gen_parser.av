fn parse_iflet_stmt(st: PState) -> CapVal {
    mut e: CapVal = CapVal.Nil
    let _ = st.advance()
    let tmp = CapVal.Tok(gensym_token(st, "iflet"))
    if st.cur().text == "let" { let _ = st.advance() } else {
        st.report("expected `let`")
    }
    let b = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected a binding name after `if let`")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Equal { let _ = st.advance() } else {
        st.report("expected `=` after the `if let` binding")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    let __modes_5 = st.modes
    st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
    let s = parse_expression(st)
    st.set_modes(__modes_5)
    if !(starts_block(st)) {
        st.report_coded("F0010", "expected `{` after the `if let` binding")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    st.set_abort_prop(false)
    let __rres6 = parse_block(st)
    if st.abort_prop || capval_is_error_expr(st, __rres6) || capval_is_error_stmt(st, __rres6) {
        return CapVal.Node(st.error_node_silent())
    }
    let t = __rres6
    if st.cur().text == "else" {
        let _ = st.advance()
        e = parse_statement(st)
    }
    mk_if_let_stmt(st, tmp, b, s, t, e)
}

fn parse_expr_stmt(st: PState) -> CapVal {
    let e = parse_expression(st)
    if st.had_error { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Error)) } else { CapVal.SNode(st.store.stmts.add_leaf(Stmt.Expr(capval_to_expr(st, e)))) }
}

fn parse_expression(st: PState) -> CapVal {
    parse_assignment(st)
}

fn parse_assignment(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut r: CapVal = CapVal.Nil
    let __bdiag0 = st.diags.length
    let __bres0 = parse_pipe(st)
    if capval_is_error_expr(st, __bres0) || capval_is_error_stmt(st, __bres0) || st.diags.length != __bdiag0 {
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    let l = __bres0
    if st.cur().tk == Tk.Equal {
        let _ = st.advance()
        r = parse_assignment(st)
    }
    CapVal.Node(mk_assign_expr(st, sp_start, l, r))
}

fn parse_pipe(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut r_list: List<ExprId> = []
    let l = parse_null_coalesce(st)
    while st.cur().tk == Tk.PipeGt {
        let _ = st.advance()
        r_list.push(capval_to_expr(st, parse_pipe_arg(st)))
    }
    CapVal.Node(fold_pipe_expr(st, sp_start, l, CapVal.Nodes(r_list)))
}

fn parse_pipe_arg(st: PState) -> CapVal {
    let __m = st.modes
    st.set_modes(modes_with_flag_on(st.modes, "allow_it_sugar"))
    let __r = parse_logic_or(st)
    st.set_modes(__m)
    __r
}

fn parse_null_coalesce(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let l = parse_logic_or(st)
    if !(st.cur().tk == Tk.QuestionQuestion) { return l }
    mut ops: List<Token> = []
    mut rs: List<ExprId> = []
    while st.cur().tk == Tk.QuestionQuestion {
        ops.push(st.advance())
        rs.push(capval_to_expr(st, parse_logic_or(st)))
    }
    CapVal.Node(fold_nullish_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))
}

fn parse_logic_or(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let l = parse_logic_and(st)
    if !(st.cur().tk == Tk.PipePipe || st.cur().text == "or") { return l }
    mut ops: List<Token> = []
    mut rs: List<ExprId> = []
    while st.cur().tk == Tk.PipePipe || st.cur().text == "or" {
        ops.push(st.advance())
        rs.push(capval_to_expr(st, parse_logic_and(st)))
    }
    CapVal.Node(fold_logical_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))
}

fn parse_logic_and(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    let l = parse_equality(st)
    if !(st.cur().tk == Tk.AmpAmp || st.cur().text == "and") { return l }
    mut ops: List<Token> = []
    mut rs: List<ExprId> = []
    while st.cur().tk == Tk.AmpAmp || st.cur().text == "and" {
        ops.push(st.advance())
        rs.push(capval_to_expr(st, parse_equality(st)))
    }
    CapVal.Node(fold_logical_expr(st, sp_start, l, CapVal.Toks(ops), CapVal.Nodes(rs)))
}

fn parse_equality(st: PState) -> CapVal {
    let sp_start = st.cur().pos
    mut tail: CapVal = CapVal.Nil
    let base = parse_bitor(st)
    if starts_eq_tail(st) {
        tail = parse_eq_tail(st)
    }
    CapVal.Node(rebind_eq_expr(st, sp_start, base, tail))
}

fn parse_eq_tail(st: PState) -> CapVal {
    if st.cur().text == "is" {
        let _ = st.advance()
        if st.cur().tk == Tk.Dot { let _ = st.advance() } else {
            st.report("expected `.Variant` after `is`")
        }
        let v = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report_ident("expected `IDENT`")
            CapVal.Tok(st.cur())
        }
        return CapVal.Node(mk_is_expr(st, v))
    }
    if st.cur().text == "in" {
        let _ = st.advance()
        let ir = parse_in_rhs(st)
        return ir
    }
    if st.cur().tk == Tk.EqualEqual || st.cur().tk == Tk.BangEqual {
        mut op_list: List<Token> = []
        mut r_list: List<ExprId> = []
        if !(st.cur().tk == Tk.EqualEqual || st.cur().tk == Tk.BangEqual) {
            st.report("expected at least one repetition")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        while st.cur().tk == Tk.EqualEqual || st.cur().tk == Tk.BangEqual {
            op_list.push(st.advance())
            r_list.push(capval_to_expr(st, parse_bitor(st)))
        }
        return CapVal.Node(mk_eqchain_expr(st, CapVal.Toks(op_list), CapVal.Nodes(r_list)))
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_in_rhs(st: PState) -> CapVal {
    if st.cur().tk == Tk.LeftBracket {
        mut a_list: List<ExprId> = []
        let _ = st.advance()
        if starts_expression(st) {
            a_list.push(capval_to_expr(st, parse_expression(st)))
            while st.cur().tk == Tk.Comma {
                let _ = st.advance()
                a_list.push(capval_to_expr(st, parse_expression(st)))
            }
        }
        if st.cur().tk == Tk.RightBracket { let _ = st.advance() } else {
            st.report("expected `]`")
        }
        return CapVal.Node(mk_inlist_expr(st, CapVal.Nodes(a_list)))
    }
    if starts_bitor(st) {
        let s = parse_bitor(st)
        if st.cur().tk == Tk.DotDot { let _ = st.advance() } else {
            st.report("expected `..` in range expression after `in`")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let e = parse_bitor(st)
        return CapVal.Node(mk_inrange_expr(st, s, e))
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_bitor(st: PState) -> CapVal { parse_binary_pratt_g(st, 10) }

fn parse_bitxor(st: PState) -> CapVal { parse_binary_pratt_g(st, 12) }

fn parse_bitand(st: PState) -> CapVal { parse_binary_pratt_g(st, 14) }

fn parse_comparison(st: PState) -> CapVal { parse_binary_pratt_g(st, 16) }

fn parse_shift(st: PState) -> CapVal { parse_binary_pratt_g(st, 18) }

fn parse_term(st: PState) -> CapVal { parse_binary_pratt_g(st, 20) }

fn parse_factor(st: PState) -> CapVal { parse_binary_pratt_g(st, 22) }

fn parse_unary(st: PState) -> CapVal {
    let c_step_base = st.postfix_step_base
    let c_step_sp = st.postfix_step_sp
    let out = parse_unary_chain(st)
    st.restore_postfix_chain(c_step_base, c_step_sp)
    out
}
fn parse_unary_chain(st: PState) -> CapVal {
    if st.cur().tk == Tk.Bang || st.cur().tk == Tk.Minus || st.cur().text == "not" {
        let op = CapVal.Tok(st.advance())
        let operand = parse_unary(st)
        return CapVal.Node(unary_expr(st, op, operand))
    }
    if st.modes.quote_depth == 0 && (st.cur().tk == Tk.Tilde) {
        let op = CapVal.Tok(st.advance())
        let operand = parse_unary(st)
        return CapVal.Node(unary_expr(st, op, operand))
    }
    if st.modes.quote_depth > 0 && lookahead_ok("tilde_ident_lbrace", st) && st.modes.allow_struct_lit != 0 && (st.cur().tk == Tk.Tilde) {
        let sp_start = st.cur().pos
        mut f_list: List<FieldInit> = []
        let _ = st.advance()
        let n = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report_ident("expected `IDENT`")
            CapVal.Tok(st.cur())
        }
        if st.cur().tk == Tk.LeftBrace { let _ = st.advance() } else {
            st.report("expected `{`")
        }
        while starts_field_init(st) {
            let __bdiag0 = st.diags.length
            let __bres0 = parse_field_init(st)
            if capval_is_error_expr(st, __bres0) || capval_is_error_stmt(st, __bres0) || st.diags.length != __bdiag0 {
                st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
            }
            f_list.push(capval_to_finit(st, __bres0))
        }
        if st.cur().tk == Tk.RightBrace { let _ = st.advance() } else {
            st.report("expected `}`")
        }
        return CapVal.Node(mk_splice_struct(st, sp_start, n, CapVal.FInits(f_list)))
    }
    if st.modes.quote_depth > 0 && (st.cur().tk == Tk.Tilde) {
        let sp_start = st.cur().pos
        let _ = st.advance()
        let t = parse_unary(st)
        return CapVal.Node(mk_splice(st, sp_start, t))
    }
    if (st.cur().tk == Tk.Number || st.cur().tk == Tk.Float) {
        let sp_start = st.cur().pos
        mut p_list: List<ExprId> = []
        mut s_list: List<ExprId> = []
        let b = CapVal.Tok(st.advance())
        st.seed_postfix(capval_to_expr(st, b), sp_start)
        while starts_postfix_suffix(st) {
