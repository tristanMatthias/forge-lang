fn parse_field(st: PState) -> CapVal {
    if st.cur().text == "mut" {
        let _ = st.advance()
    }
    let fname = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
        st.report_ident("expected field name")
        CapVal.Tok(st.cur())
    }
    if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
        st.report("expected `:` after field name")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if !(starts_type_expr(st)) {
        st.report("expected field type")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    st.set_abort_prop(false)
    let __rres3 = parse_type_expr(st)
    if st.abort_prop || capval_is_error_expr(st, __rres3) || capval_is_error_stmt(st, __rres3) {
        return CapVal.Node(st.error_node_silent())
    }
    let ftype = __rres3
    mk_field(st, capval_tok_text(fname), ftype)
}

fn parse_tparam(st: PState) -> CapVal {
    mut tpb: CapVal = CapVal.Nil
    let tpn = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { tpb = CapVal.Tok(st.advance()) } else {
            st.report_ident("expected trait bound after `:`")
        }
    }
    mk_type_param(capval_tok_text(tpn), tpb, capval_present(tpb))
}

