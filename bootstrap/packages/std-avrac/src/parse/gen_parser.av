fn parse_where_param(st: PState) -> CapVal {
    mut wb_list: List<Token> = []
    let wn = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Colon { let _ = st.advance() } else {
        st.report("expected `:` after type parameter in where clause")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.Identifier { wb_list.push(st.advance()) } else {
        st.report_ident("expected trait name in where clause")
