        }
        return CapVal.Node(fold_postfix_with_expr(st, sp_start, b, CapVal.Nodes(p_list), CapVal.Nodes(s_list)))
    }
    if (st.cur().tk == Tk.KwTrue || st.cur().tk == Tk.KwFalse) {
        let sp_start = st.cur().pos
        mut p_list: List<ExprId> = []
        mut s_list: List<ExprId> = []
        let b = CapVal.Tok(st.advance())
        st.seed_postfix(capval_to_expr(st, b), sp_start)
        while starts_postfix_suffix(st) {
