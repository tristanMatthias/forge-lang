fn parse_letdes_decl(st: PState) -> CapVal {
    mut n_list: List<Token> = []
    mut m: CapVal = CapVal.Nil
    let _ = st.advance()
    if st.cur().text == "mut" {
        m = CapVal.Tok(st.advance())
    }
    if st.cur().tk == Tk.LeftParen { let _ = st.advance() } else {
        st.report("expected `(`")
    }
    if st.cur().tk == Tk.Identifier {
        n_list.push(st.advance())
        while lookahead_ok("comma_ident", st) && (st.cur().tk == Tk.Comma) {
            let _ = st.advance()
            if st.cur().tk == Tk.Identifier { n_list.push(st.advance()) } else {
                st.report_ident("expected `IDENT`")
            }
        }
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected `)` after destructure names")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    if st.cur().tk == Tk.Equal { let _ = st.advance() } else {
        st.report("expected `=` after destructure pattern")
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    let __bdiag6 = st.diags.length
    let __bres6 = parse_expression(st)
    if capval_is_error_expr(st, __bres6) || capval_is_error_stmt(st, __bres6) || st.diags.length != __bdiag6 {
        st.set_abort_prop(true)
        return CapVal.Node(st.error_node_silent())
    }
    let init = __bres6
    mk_let_destructure_g(st, n_list, init)
}

