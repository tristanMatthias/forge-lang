fn parse_for_stmt(st: PState) -> CapVal {
    if lookahead_ok("for_destructure", st) && (st.cur().text == "for") {
        let sp_start = st.cur().pos
        let _ = st.advance()
        let fb = parse_for_binding(st)
        if st.cur().text == "in" { let _ = st.advance() } else {
            st.report("expected `in` after for destructure pattern")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let coll = parse_expression(st)
        st.set_modes(__modes_3)
        let body = parse_block(st)
        return mk_for_destructure(st, sp_start, fb, coll, body)
    }
    if st.cur().text == "for" {
        let sp_start = st.cur().pos
        mut hi: CapVal = CapVal.Nil
        let _ = st.advance()
        let v = if st.cur().tk == Tk.Identifier { CapVal.Tok(st.advance()) } else {
            st.report_ident("expected `IDENT`")
            CapVal.Tok(st.cur())
        }
        if st.cur().text == "in" { let _ = st.advance() } else {
            st.report("expected `in` after loop variable")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        let __modes_3 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        let lo = parse_expression(st)
        st.set_modes(__modes_3)
        let __modes_4 = st.modes
        st.set_modes(modes_with_flag_off(st.modes, "allow_struct_lit"))
        if st.cur().tk == Tk.DotDot {
            let _ = st.advance()
            hi = parse_expression(st)
        }
        st.set_modes(__modes_4)
        let body = parse_block(st)
        return mk_stamp_stmt_at(st, sp_start, build_for_abi(st, [v, lo, hi, body]))
    }
    CapVal.Node(st.error_node_expected_expr())
}

fn parse_for_binding(st: PState) -> CapVal {
    mut names_list: List<Token> = []
    let lp = CapVal.Tok(st.advance())
    if st.cur().tk == Tk.Identifier {
        names_list.push(st.advance())
        while lookahead_ok("comma_ident", st) && (st.cur().tk == Tk.Comma) {
            let _ = st.advance()
            if st.cur().tk == Tk.Identifier { names_list.push(st.advance()) } else {
                st.report_ident("expected `IDENT`")
            }
        }
        if st.cur().tk == Tk.Comma { let _ = st.advance() }
    }
    if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
        st.report("expected `)`")
    }
    mk_for_binding(lp, CapVal.Toks(names_list))
}

