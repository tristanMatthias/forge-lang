            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
        ps_list.push(capval_to_pentry(st, __bres1))
        while st.cur().tk == Tk.Comma {
            let _ = st.advance()
            let __bdiag1 = st.diags.length
            let __bres1 = parse_param(st)
            if capval_is_error_expr(st, __bres1) || capval_is_error_stmt(st, __bres1) || st.diags.length != __bdiag1 {
                st.set_abort_prop(true)
                return CapVal.Node(st.error_node_silent())
            }
            ps_list.push(capval_to_pentry(st, __bres1))
        }
        if st.cur().tk == Tk.RightParen { let _ = st.advance() } else {
            st.report("expected `)`")
        }
