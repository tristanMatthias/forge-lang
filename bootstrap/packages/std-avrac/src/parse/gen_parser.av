    while st.cur().tk == Tk.Plus {
        let _ = st.advance()
        if st.cur().tk == Tk.Identifier { wb_list.push(st.advance()) } else {
            st.report_ident("expected trait name in where clause")
            st.set_abort_prop(true)
            return CapVal.Node(st.error_node_silent())
        }
    }
    mk_where_param(capval_tok_text(wn), wb_list)
}

