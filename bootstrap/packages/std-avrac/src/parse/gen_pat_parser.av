use features.grammar.{Token, CapVal, PState, capval_to_pat, capval_tok_text, pat_num_node, pat_bool_node, pat_str_node, ident_pat_bare, param_entries_from_toks}
use core.{Pattern, PatId, ValueType, Tk, pattern_optional_present, pattern_optional_absent}

// generated recursive-descent parser for grammar `grammar`
export fn parse_pattern_or(st: PState) -> CapVal {
