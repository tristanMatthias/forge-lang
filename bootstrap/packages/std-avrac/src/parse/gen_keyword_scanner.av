        if b1 == LOWER_I {
            let b2 = byte_at(src, start + 2)
            if b2 == LOWER_E {
                let b3 = byte_at(src, start + 3)
                if b3 == LOWER_L {
                    let b4 = byte_at(src, start + 4)
                    if b4 == LOWER_D {
                        if start + 5 == end { return Tk.Keyword(KwId.Reserved) }
                    }
                }
            }
        }
    }
    return Tk.Identifier
}
