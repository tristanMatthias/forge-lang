// WHY: t-47hc.2 (Phase 1) — the GENERATOR that COMPILES the declarative operator/
// punctuation table (token_table.av `operator_rules()`) into a maximal-munch byte
// scanner (`scan_operator`), the lexer sibling of features/grammar/emit.av (which
// compiles the parser Grammar into recursive descent). This is the design's core
// rule made literal: "compile the grammar, don't interpret it — the DFA lexer EMITS
// branches, not a runtime table." Nothing here walks `operator_rules()` at scan
// time; it walks the table ONCE, at build time, to EMIT nested byte-branches.
//
// The emitted `scan_operator(src, pos)` is a TRIE of the spellings, compiled to
// nested `if byte == N { … }`: descend into longer matches FIRST, fall back to the
// shorter terminal only when no longer one matches — which IS maximal munch, for
// free, from the tree shape (no length sorting at runtime, no backtracking). All
// byte reads go through the allocation-free `byte_at`; a byte past the end reads -1
// and matches no branch, so a lead at EOF correctly yields its single-char form.
//
// This module is NON-PRODUCTION (like gen_parser_files.av): imported ONLY by the
// regenerator (diagnose.sh --emit-regen-lex) and the guard test
// (gen_operator_scanner_regen_test.av). The GENERATED file it produces
// (parse/gen_operator_scanner.av) is what production consumes. RELATIVE imports:
// this is an in-package compiler-src module (absolute `@std.avrac.` self-imports
// double-expand the package — F4012).
use parse.{operator_rules, keyword_rules, char_run_rules, delim_run_rules, str_run_rules, nest_run_rules, interp_run_rules, escape_rules, LitRule, CharRun, DelimRun, StrRun, NestRun, InterpRun, EscapeRule, byte_at, ascii_const_name}
use core.{Tk, tk_name}

extern fn avra_bytes_from_string(s: string) -> bytes

// ── The build-time trie ───────────────────────────────────────────
// One node per byte-prefix. `has_tk` marks a prefix that is itself a complete
// spelling (a terminal); `children` are the one-byte-longer prefixes. Built once
// per `emit_operator_scanner_source` call, thrown away after emission.
type OpTrie = { byte: int, has_tk: bool, tk: Tk, spelling: string, children: List<OpTrie> }

impl OpTrie {
    /// Index of the child keyed on byte `b`, or -1. Linear over `children` — at
    /// most a handful per node, and build-time only.
    fn child_index(self, b: int) -> int {
        mut i = 0
        while i < self.children.length {
            if self.children[i].byte == b { return i }
            i = i + 1
        }
        -1
    }

    /// Insert spelling bytes `sb[0..slen)` ending in token `tk`, extending the
    /// trie from `self` at `depth`. `self` is by-pointer, so the find-or-create
    /// walk mutates the shared tree in place.
    fn insert(self, sb: bytes, slen: int, depth: int, tk: Tk, spelling: string) {
        if depth == slen {
            self.has_tk = true
            self.tk = tk
            self.spelling = spelling
            return
        }
        let b = byte_at(sb, depth)
        mut idx = self.child_index(b)
        if idx == -1 {
            self.children.push(OpTrie { byte: b, has_tk: false, tk: Tk.Error, spelling: "", children: [] })
            idx = self.children.length - 1
        }
        self.children[idx].insert(sb, slen, depth + 1, tk, spelling)
    }
}

/// Build the operator trie from the declarative table. A fresh rootless node
/// (byte -1, no terminal) whose children are the lead bytes.
fn build_op_trie(rules: List<LitRule>) -> OpTrie {
    mut root = OpTrie { byte: -1, has_tk: false, tk: Tk.Error, spelling: "", children: [] }
    mut i = 0
    while i < rules.length {
        let r = rules[i]
        root.insert(avra_bytes_from_string(r.spelling), r.spelling.length, 0, r.tk, r.spelling)
        i = i + 1
    }
    root
}

/// A node's children in ASCENDING byte order — DETERMINISTIC emission (the regen
/// guard is textual equality, so branch order must be stable across runs). Bytes
/// are unique per node, so scanning 0..255 yields each child once, sorted.
fn sorted_children(kids: List<OpTrie>) -> List<OpTrie> {
    mut result: List<OpTrie> = []
    mut b = 0
    while b < 256 {
        mut i = 0
        while i < kids.length {
            if kids[i].byte == b { result.push(kids[i]) }
            i = i + 1
        }
        b = b + 1
    }
    result
}

/// Emit one trie node's branches at `depth` (the byte offset from the match
/// start). LONGER matches are emitted first (descend into children before this
/// node's own terminal), so control reaches the shorter `return` only when no
/// longer branch fired — maximal munch from the tree shape alone.
fn emit_op_node(node: OpTrie, depth: int, indent: string) -> string {
    mut out = ""
    if node.children.length > 0 {
        let kids = sorted_children(node.children)
        let idx_expr = if depth == 0 { "pos" } else { "pos + " + string(depth) }
        out = out + indent + "let b" + string(depth) + " = byte_at(src, " + idx_expr + ")\n"
        mut i = 0
        while i < kids.length {
            let c = kids[i]
            // Emit the NAMED ascii constant (`b0 == BANG`), never the raw byte
            // (`b0 == 33`) — the generated scanner reads like the hand one.
            out = out + indent + "if b" + string(depth) + " == " + ascii_const_name(c.byte) + " {\n"
            out = out + emit_op_node(c, depth + 1, indent + "    ")
            out = out + indent + "}\n"
            i = i + 1
        }
    }
    if node.has_tk {
        // The spelling is emitted as a STATIC string literal, so the caller uses it
        // as the lexeme with zero allocation (operators contain no escape-worthy
        // byte, so verbatim quoting is safe).
        out = out + indent + "return OpMatch { tk: Tk." + tk_name(node.tk) + ", len: " + string(depth) + ", spelling: \"" + node.spelling + "\" }\n"
    }
    out
}

/// The generated `scan_operator` function body (its doc comment + signature +
/// the trie branches + the no-match tail). Pure text — the compiled form of
/// `operator_rules()`.
export fn emit_operator_scanner_source() -> string {
    let root = build_op_trie(operator_rules())
    "/// GENERATED maximal-munch scanner for the operator/punctuation table.\n" +
    "/// Returns the longest matching token at `pos` and its byte length, or\n" +
    "/// `{ Tk.Error, len: 0 }` when the byte at `pos` starts no operator.\n" +
    "export fn scan_operator(src: bytes, pos: int) -> OpMatch {\n" +
    emit_op_node(root, 0, "    ") +
    "    return OpMatch { tk: Tk.Error, len: 0, spelling: \"\" }\n" +
    "}\n"
}

/// The comma-separated ascii CONSTANT names a table's generated branches reference,
/// in ascending byte order (deduped) — the tail of the generated file's
/// `use parse.{…}`. Every byte appearing in any spelling is a byte the trie branches
/// on (byte[d] of some spelling == a depth-d branch), so collecting from the
/// spellings yields exactly the branch bytes without walking the trie. Shared by the
/// operator and keyword generators.
fn const_import_list(rules: List<LitRule>) -> string {
    mut out = ""
    mut b = 0
    while b < 256 {
        mut present = false
        mut i = 0
        while i < rules.length {
            let sp = rules[i].spelling
            let sb = avra_bytes_from_string(sp)
            mut j = 0
            while j < sp.length {
                if byte_at(sb, j) == b { present = true }
                j = j + 1
            }
            i = i + 1
        }
        if present {
            if out != "" { out = out + ", " }
            out = out + ascii_const_name(b)
        }
        b = b + 1
    }
    out
}

/// The import header of the generated module: `scan_operator`'s support symbols
/// (`OpMatch` + `byte_at`, `Tk`) plus the ascii byte-constants its branches name
/// (so it reads `== BANG`, not `== 33`). RELATIVE imports — the generated file is
/// a globbed in-package module, and an absolute `@std.avrac.` self-import
/// double-expands the package (F4012).
export fn gen_operator_scanner_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-lex` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: operator_rules() in parse/token_table.av (compiled to a\n" +
    "// maximal-munch byte-branch trie by parse/emit_lex.av). Editing the operator\n" +
    "// table without regenerating fails parse/tests/gen_operator_scanner_regen_test.av.\n" +
    "use parse.{OpMatch, byte_at, " + const_import_list(operator_rules()) + "}\n" +
    "use core.{Tk}\n\n"
}

/// The COMPLETE text of parse/gen_operator_scanner.av: header + generated body.
/// Both the regenerator and the guard read from HERE — one source of truth.
export fn gen_operator_scanner_file() -> string {
    gen_operator_scanner_header() + emit_operator_scanner_source()
}

// ── The KEYWORD recogniser generator ──────────────────────────────
// Same trie builder (build_op_trie) over keyword_rules(), but EXACT-MATCH instead
// of maximal-munch: an identifier is a keyword only if its bytes spell the keyword
// EXACTLY (`if` is KwIf but `iff` is an Identifier). So a terminal returns its Tk
// only when the identifier ENDS exactly there (`start + depth == end`); anything
// else — a longer identifier, or a byte that leaves the trie — falls through to
// Tk.Identifier. The caller has already found the identifier run [start, end), so
// byte_at never reads past it in a way that could over-match (the byte at `end` is
// not an identifier byte, so it matches no keyword-continuation letter).

/// Emit one keyword-trie node at `depth` (byte offset from the identifier start).
/// Descend into longer keywords first, then this node's own terminal — but the
/// terminal fires ONLY if the identifier is exactly this long.
fn emit_kw_node(node: OpTrie, depth: int, indent: string) -> string {
    mut out = ""
    if node.children.length > 0 {
        let kids = sorted_children(node.children)
        let idx_expr = if depth == 0 { "start" } else { "start + " + string(depth) }
        out = out + indent + "let b" + string(depth) + " = byte_at(src, " + idx_expr + ")\n"
        mut i = 0
        while i < kids.length {
            let c = kids[i]
            out = out + indent + "if b" + string(depth) + " == " + ascii_const_name(c.byte) + " {\n"
            out = out + emit_kw_node(c, depth + 1, indent + "    ")
            out = out + indent + "}\n"
            i = i + 1
        }
    }
    if node.has_tk {
        // EXACT match: this is a keyword only if the identifier ends right here.
        out = out + indent + "if start + " + string(depth) + " == end { return Tk." + tk_name(node.tk) + " }\n"
    }
    out
}

/// The generated `classify_keyword` body: given the identifier byte range
/// [start, end), return its keyword Tk or Tk.Identifier. The compiled form of
/// keyword_rules() — a byte-trie that replaces p_keyword_kind's string-comparison
/// ladder (which strcmp'd every keyword on every identifier).
export fn emit_keyword_scanner_source() -> string {
    let root = build_op_trie(keyword_rules())
    "/// GENERATED exact-match keyword recogniser for the keyword table.\n" +
    "/// Returns the keyword `Tk` for the identifier bytes [start, end), or\n" +
    "/// `Tk.Identifier` when they spell no keyword.\n" +
    "export fn classify_keyword(src: bytes, start: int, end: int) -> Tk {\n" +
    emit_kw_node(root, 0, "    ") +
    "    return Tk.Identifier\n" +
    "}\n"
}

/// The import header of the generated keyword module — `byte_at`, `Tk`, and the
/// lowercase-letter constants its branches name. RELATIVE imports (F4012).
export fn gen_keyword_scanner_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-kw` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: keyword_rules() in parse/token_table.av (compiled to an\n" +
    "// exact-match byte-branch trie by parse/emit_lex.av). Editing the keyword table\n" +
    "// without regenerating fails parse/tests/gen_keyword_scanner_regen_test.av.\n" +
    "use parse.{byte_at, " + const_import_list(keyword_rules()) + "}\n" +
    "use core.{Tk}\n\n"
}

/// The COMPLETE text of parse/gen_keyword_scanner.av: header + generated body.
export fn gen_keyword_scanner_file() -> string {
    gen_keyword_scanner_header() + emit_keyword_scanner_source()
}

// ── The character-class RUN-scanner generator ─────────────────────
// Unlike operators/keywords (a SET of spellings → a byte-prefix trie), a char-class
// run is ONE class, so there is no trie: each CharRun compiles to a single maximal
// byte-scan loop `while pred(byte_at(src, end)) { end += 1 }` — the compiled form of
// the hand lexer's identifier/number-digit run loops. Byte-identical by construction.

/// Emit one `scan_<name>_run(src, start) -> int` — the end offset (exclusive) of the
/// maximal run of bytes from `start` satisfying the rule's classifier `pred`, plus (if
/// `sep` is set) the separator byte. The caller applies line/column and current from the
/// returned length.
fn emit_run_scanner(rule: CharRun) -> string {
    mut cond = rule.pred + "(byte_at(src, end))"
    if rule.sep != "" {
        cond = cond + " || byte_at(src, end) == " + rule.sep
    }
    "/// GENERATED byte-run scanner for the `" + rule.name + "` char-class run.\n" +
    "export fn scan_" + rule.name + "_run(src: bytes, start: int) -> int {\n" +
    "    mut end = start\n" +
    "    while " + cond + " { end = end + 1 }\n" +
    "    end\n" +
    "}\n"
}

/// The generated run-scanner bodies — one `scan_<name>_run` per char_run_rules() entry.
export fn emit_run_scanner_source() -> string {
    let rules = char_run_rules()
    mut out = ""
    mut i = 0
    while i < rules.length {
        if i > 0 { out = out + "\n" }
        out = out + emit_run_scanner(rules[i])
        i = i + 1
    }
    out
}

// ── The delimited RUN-scanner generator ───────────────────────────
// The complement of a char-class run: scan-UNTIL a terminator byte (or EOF) rather
// than scan-WHILE a class holds. `byte_at(src, end)` returns -1 past EOF, so the loop
// `while byte_at(src, end) != -1 && byte_at(src, end) != TERM { end += 1 }` stops at the
// terminator OR the end of source — byte-for-byte the hand lexer's `!self.is_at_end() &&
// byte_at(sb, current) != TERM` loop (byte_at == -1 iff the offset is out of bounds iff
// is_at_end). The terminator byte is NOT consumed (exclusive end), matching the hand loop.

/// Emit one `scan_<name>(src, start) -> int` — the exclusive end offset of the verbatim
/// run of bytes from `start` up to (but not including) the rule's terminator `term`, or
/// EOF. The caller applies line/column from the returned length.
fn emit_delim_scanner(rule: DelimRun) -> string {
    "/// GENERATED byte-run scanner up to the `" + rule.name + "` terminator (exclusive).\n" +
    "export fn scan_" + rule.name + "(src: bytes, start: int) -> int {\n" +
    "    mut end = start\n" +
    "    while byte_at(src, end) != -1 && byte_at(src, end) != " + rule.term + " { end = end + 1 }\n" +
    "    end\n" +
    "}\n"
}

/// The generated delimited-run bodies — one `scan_<name>` per delim_run_rules() entry.
export fn emit_delim_scanner_source() -> string {
    let rules = delim_run_rules()
    mut out = ""
    mut i = 0
    while i < rules.length {
        if i > 0 { out = out + "\n" }
        out = out + emit_delim_scanner(rules[i])
        i = i + 1
    }
    out
}

/// True iff `s` already appears in `xs` (read-only membership).
fn run_list_has(xs: List<string>, s: string) -> bool {
    mut i = 0
    while i < xs.length {
        if xs[i] == s { return true }
        i = i + 1
    }
    false
}

/// The symbols the generated run loops reference — each char-class rule's classifier
/// `pred` plus its separator constant `sep` (when set), then each delimited rule's
/// terminator constant `term` — in rule order, deduped, comma-separated. The tail of the
/// generated file's `use parse.{byte_at, …}`.
fn run_symbol_import_list() -> string {
    mut syms: List<string> = []
    let cr = char_run_rules()
    mut i = 0
    while i < cr.length {
        if !run_list_has(syms, cr[i].pred) { syms.push(cr[i].pred) }
        if cr[i].sep != "" && !run_list_has(syms, cr[i].sep) { syms.push(cr[i].sep) }
        i = i + 1
    }
    let dr = delim_run_rules()
    mut k = 0
    while k < dr.length {
        if !run_list_has(syms, dr[k].term) { syms.push(dr[k].term) }
        k = k + 1
    }
    // The string-body and nesting rules name constants too — a missing one is an
    // undefined-symbol HARD error in the generated file, not a warning, so the import
    // list is derived from the rules rather than written out by hand.
    let sr = str_run_rules()
    mut m = 0
    while m < sr.length {
        if !run_list_has(syms, sr[m].close) { syms.push(sr[m].close) }
        if sr[m].interp_a != "" && !run_list_has(syms, sr[m].interp_a) { syms.push(sr[m].interp_a) }
        if sr[m].interp_b != "" && !run_list_has(syms, sr[m].interp_b) { syms.push(sr[m].interp_b) }
        if sr[m].escape && !run_list_has(syms, "BACKSLASH") { syms.push("BACKSLASH") }
        if sr[m].stop_nl && !run_list_has(syms, "LF") { syms.push("LF") }
        m = m + 1
    }
    let er = escape_rules()
    mut e = 0
    while e < er.length {
        if !run_list_has(syms, er[e].lead) { syms.push(er[e].lead) }
        e = e + 1
    }
    let ir = interp_run_rules()
    mut q = 0
    while q < ir.length {
        if !run_list_has(syms, ir[q].open_a) { syms.push(ir[q].open_a) }
        if !run_list_has(syms, ir[q].open_b) { syms.push(ir[q].open_b) }
        if !run_list_has(syms, ir[q].close) { syms.push(ir[q].close) }
        if ir[q].skip_strings {
            if !run_list_has(syms, "DQUOTE") { syms.push("DQUOTE") }
            if !run_list_has(syms, "BACKSLASH") { syms.push("BACKSLASH") }
            if !run_list_has(syms, ir[q].raw_prefix) { syms.push(ir[q].raw_prefix) }
            if !run_list_has(syms, ir[q].char_delim) { syms.push(ir[q].char_delim) }
            if !run_list_has(syms, ir[q].tmpl_delim) { syms.push(ir[q].tmpl_delim) }
        }
        q = q + 1
    }
    let nr = nest_run_rules()
    mut q = 0
    while q < nr.length {
        if !run_list_has(syms, nr[q].open_a) { syms.push(nr[q].open_a) }
        if !run_list_has(syms, nr[q].open_b) { syms.push(nr[q].open_b) }
        if !run_list_has(syms, nr[q].close_a) { syms.push(nr[q].close_a) }
        if !run_list_has(syms, nr[q].close_b) { syms.push(nr[q].close_b) }
        q = q + 1
    }
    mut out = ""
    mut j = 0
    while j < syms.length {
        if j > 0 { out = out + ", " }
        out = out + syms[j]
        j = j + 1
    }
    out
}

/// The import header of the generated run-scanner module — `byte_at` + the `cc_is_*`
/// classifiers its loops call. RELATIVE imports (F4012). No `Tk`: a run returns an int.
// ── The STRING-BODY scanner generator ─────────────────────────────
// The delim run's escape-and-interpolation-aware sibling. A plain scan-until cannot do a
// string body: `\"` must not close it, and `{` must SUSPEND it so the parser can handle
// the nested expression and resume. Both are fields on the rule, so the difference
// between `"…"`, `` `…` ``, `'…'` and `r"…"` is data rather than four hand-written loops.
//
// Exclusive end, like every other run here: the scanner stops BEFORE the close, the
// interp lead, or EOF, and the caller inspects `byte_at(src, end)` to learn which. An
// escape consumes TWO bytes (the backslash and whatever follows, including a close
// delimiter or a newline), which is what makes `"a\"b"` one string rather than two.

/// Emit one `scan_<name>(src, start) -> int` for a string-body run.
fn emit_str_scanner(rule: StrRun) -> string {
    // The close is `close_rep` CONSECUTIVE bytes. For a triple-quoted body the first two
    // quotes are ordinary content, so a one-byte test would truncate at the first `"`.
    mut stop = "byte_at(src, end) == " + rule.close
    if rule.close_rep == 3 {
        stop = "(byte_at(src, end) == " + rule.close +
               " && byte_at(src, end + 1) == " + rule.close +
               " && byte_at(src, end + 2) == " + rule.close + ")"
    }
    // BOTH bytes of the lead must match. A one-byte test would stop the body at every
    // literal `{`, which is an ordinary character in a string.
    if rule.interp_a != "" {
        stop = stop + " || (byte_at(src, end) == " + rule.interp_a +
               " && byte_at(src, end + 1) == " + rule.interp_b + ")"
    }
    // A mode that may not span a newline stops at LF as well as at its close. The hand
    // reports there; the scanner only reports the BOUND, so the caller keeps the
    // diagnostic — matching where the hand stops is the whole contract.
    if rule.stop_nl {
        stop = stop + " || byte_at(src, end) == LF"
    }
    mut esc = ""
    if rule.escape {
        esc = "        // An escape consumes the backslash AND the byte after it, so a\n" +
              "        // `\\` + close does not terminate and `\\` + interp does not suspend.\n" +
              "        if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {\n" +
              "            end = end + 2\n" +
              "            continue\n" +
              "        }\n"
    }
    "/// GENERATED string-body scanner for the `" + rule.name + "` mode. Stops BEFORE the\n" +
    "/// close delimiter, the interpolation lead, or EOF (exclusive end).\n" +
    "export fn scan_" + rule.name + "(src: bytes, start: int) -> int {\n" +
    "    mut end = start\n" +
    "    while byte_at(src, end) != -1 {\n" +
    esc +
    "        if " + stop + " { return end }\n" +
    "        end = end + 1\n" +
    "    }\n" +
    "    end\n" +
    "}\n"
}

/// The generated string-body bodies — one `scan_<name>` per str_run_rules() entry.
export fn emit_str_scanner_source() -> string {
    let rules = str_run_rules()
    mut out = ""
    mut i = 0
    while i < rules.length {
        if i > 0 { out = out + "\n" }
        out = out + emit_str_scanner(rules[i])
        i = i + 1
    }
    out
}

// ── The NESTING scanner generator ─────────────────────────────────
// `/* … */` is the one construct no scan-until can express: the terminator is the close
// that BALANCES, not the first one. A depth counter is the entire difference.

/// Emit one `scan_<name>(src, start) -> int` for a nesting run. INCLUSIVE end (past the
/// balancing close) — unlike the other runs there is nothing useful at the stop byte, and
/// an unbalanced open simply runs to EOF.
fn emit_nest_scanner(rule: NestRun) -> string {
    "/// GENERATED nesting scanner for `" + rule.name + "`. Returns the offset PAST the\n" +
    "/// balancing close, or EOF if the nesting never balances.\n" +
    "export fn scan_" + rule.name + "(src: bytes, start: int) -> int {\n" +
    "    mut end = start\n" +
    "    mut depth = 0\n" +
    "    while byte_at(src, end) != -1 {\n" +
    "        if byte_at(src, end) == " + rule.open_a + " && byte_at(src, end + 1) == " + rule.open_b + " {\n" +
    "            depth = depth + 1\n" +
    "            end = end + 2\n" +
    "            continue\n" +
    "        }\n" +
    "        if byte_at(src, end) == " + rule.close_a + " && byte_at(src, end + 1) == " + rule.close_b + " {\n" +
    "            depth = depth - 1\n" +
    "            end = end + 2\n" +
    "            if depth == 0 { return end }\n" +
    "            continue\n" +
    "        }\n" +
    "        end = end + 1\n" +
    "    }\n" +
    "    end\n" +
    "}\n"
}

fn emit_interp_scanner(rule: InterpRun) -> string {
    mut skip = ""
    if rule.skip_strings {
        // A nested string literal is skipped WHOLE, because a brace inside it is content:
        // `${"}"}` must not close at that `}`. Both delimiter widths, and escapes consumed
        // at each — an escaped quote is not a close. A raw nested string (`r"…"`) takes NO
        // escapes, so it is matched first and skipped without them.
        skip = "        if byte_at(src, end) == " + rule.raw_prefix + " && byte_at(src, end + 1) == DQUOTE {\n" +
               // `r\"\"\"…\"\"\"` must be tested BEFORE `r\"…\"`, or the single-line branch stops at
               // the second quote of the opening triple and the raw body's braces are then
               // counted as interpolation depth — `${r\"\"\"a\" { \"\"\"}` ran to EOF.
               "            if byte_at(src, end + 2) == DQUOTE && byte_at(src, end + 3) == DQUOTE {\n" +
               "                end = end + 4\n" +
               "                while byte_at(src, end) != -1 {\n" +
               "                    if byte_at(src, end) == DQUOTE && byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE {\n" +
               "                        end = end + 3\n" +
               "                        break\n" +
               "                    }\n" +
               "                    end = end + 1\n" +
               "                }\n" +
               "                continue\n" +
               "            }\n" +
               "            end = end + 2\n" +
               "            while byte_at(src, end) != -1 && byte_at(src, end) != DQUOTE { end = end + 1 }\n" +
               "            if byte_at(src, end) != -1 { end = end + 1 }\n" +
               "            continue\n" +
               "        }\n" +
               // A CHAR literal and a BACKTICK template hide braces just as a string does.
               // The char literal takes escapes; the template is verbatim, matching
               // tmpl_body's rule in the same table.
               "        if byte_at(src, end) == " + rule.char_delim + " {\n" +
               "            end = end + 1\n" +
               "            while byte_at(src, end) != -1 && byte_at(src, end) != " + rule.char_delim + " {\n" +
               "                if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {\n" +
               "                    end = end + 2\n" +
               "                    continue\n" +
               "                }\n" +
               "                end = end + 1\n" +
               "            }\n" +
               "            if byte_at(src, end) != -1 { end = end + 1 }\n" +
               "            continue\n" +
               "        }\n" +
               "        if byte_at(src, end) == " + rule.tmpl_delim + " {\n" +
               "            end = end + 1\n" +
               "            while byte_at(src, end) != -1 && byte_at(src, end) != " + rule.tmpl_delim + " { end = end + 1 }\n" +
               "            if byte_at(src, end) != -1 { end = end + 1 }\n" +
               "            continue\n" +
               "        }\n" +
               "        if byte_at(src, end) == DQUOTE {\n" +
               "            if byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE {\n" +
               "                end = end + 3\n" +
               "                while byte_at(src, end) != -1 {\n" +
               "                    if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {\n" +
               "                        end = end + 2\n" +
               "                        continue\n" +
               "                    }\n" +
               "                    if byte_at(src, end) == DQUOTE && byte_at(src, end + 1) == DQUOTE && byte_at(src, end + 2) == DQUOTE {\n" +
               "                        end = end + 3\n" +
               "                        break\n" +
               "                    }\n" +
               "                    end = end + 1\n" +
               "                }\n" +
               "                continue\n" +
               "            }\n" +
               "            end = end + 1\n" +
               "            while byte_at(src, end) != -1 && byte_at(src, end) != DQUOTE {\n" +
               "                if byte_at(src, end) == BACKSLASH && byte_at(src, end + 1) != -1 {\n" +
               "                    end = end + 2\n" +
               "                    continue\n" +
               "                }\n" +
               "                end = end + 1\n" +
               "            }\n" +
               "            if byte_at(src, end) != -1 { end = end + 1 }\n" +
               "            continue\n" +
               "        }\n"
    }
    "/// GENERATED interpolation-region scanner for `" + rule.name + "`. `start` is AT the\n" +
    "/// opening lead; returns the offset PAST the balancing close, or EOF if it never\n" +
    "/// balances. Depth counts BARE opens, which are not the same bytes as the lead.\n" +
    "export fn scan_" + rule.name + "(src: bytes, start: int) -> int {\n" +
    "    mut end = start\n" +
    "    if byte_at(src, end) == " + rule.open_a + " && byte_at(src, end + 1) == " + rule.open_b + " {\n" +
    "        end = end + 2\n" +
    "    }\n" +
    "    mut depth = 1\n" +
    "    while byte_at(src, end) != -1 {\n" +
    skip +
    "        if byte_at(src, end) == " + rule.depth_open + " { depth = depth + 1 }\n" +
    "        if byte_at(src, end) == " + rule.close + " {\n" +
    "            depth = depth - 1\n" +
    "            if depth == 0 { return end + 1 }\n" +
    "        }\n" +
    "        end = end + 1\n" +
    "    }\n" +
    "    end\n" +
    "}\n"
}

/// The generated interpolation-region bodies — one per interp_run_rules() entry.
export fn emit_interp_scanner_source() -> string {
    let rules = interp_run_rules()
    mut out = ""
    mut i = 0
    while i < rules.length {
        if i > 0 { out = out + "\n" }
        out = out + emit_interp_scanner(rules[i])
        i = i + 1
    }
    out
}

/// GENERATED universal escape resolver. One `if` per escape_rules() row.
fn emit_escape_resolver() -> string {
    let rules = escape_rules()
    mut arms = ""
    mut codes = ""
    mut i = 0
    while i < rules.length {
        arms = arms + "    if b == " + rules[i].lead + " { return EscapeRes { text: \"" + rules[i].text_src + "\", consumed: 2 } }\n"
        codes = codes + "    if b == " + rules[i].lead + " { return " + string(rules[i].code) + " }\n"
        i = i + 1
    }
    "/// GENERATED from escape_rules(). Resolve the escape whose LEAD byte sits at `esc_pos`\n" +
    "/// (just past the backslash). `delim` is the caller's own closing delimiter — the ONE\n" +
    "/// escape that is not universal, since a string escapes `\\\"` and a char literal `\\\'`.\n" +
    "/// Everything else is identical across the three literal forms, which is why one\n" +
    "/// resolver can serve all of them instead of the three drifting ladders it replaced.\n" +
    "/// GENERATED from escape_rules(). The code point for a UNIVERSAL escape lead, or -1.\n" +
    "/// The char-literal form wants an int, not a lexeme, and rejects what it does not\n" +
    "/// recognise — so it takes this accessor and keeps its own policy.\n" +
    "export fn escape_code(b: int) -> int {\n" +
    codes +
    "    -1\n" +
    "}\n" +
    "\n" +
    "export fn resolve_escape(src: bytes, text: string, esc_pos: int, delim: int) -> EscapeRes {\n" +
    "    let b = byte_at(src, esc_pos)\n" +
    "    if b == -1 { return EscapeRes { text: \"\", consumed: 1 } }\n" +
    "    if b == delim { return EscapeRes { text: text.substring(esc_pos, esc_pos + 1), consumed: 2 } }\n" +
    arms +
    "    if b == LOWER_X {\n" +
    "        let hi = byte_at(src, esc_pos + 1)\n" +
    "        let lo = byte_at(src, esc_pos + 2)\n" +
    "        if hi != -1 && lo != -1 {\n" +
    "            return EscapeRes { text: avra_char_from_hex(text.substring(esc_pos + 1, esc_pos + 2), text.substring(esc_pos + 2, esc_pos + 3)), consumed: 4 }\n" +
    "        }\n" +
    "    }\n" +
    "    // Unknown escape: VERBATIM, backslash included — the hand behaviour, preserved.\n" +
    "    EscapeRes { text: \"\\\\\" + text.substring(esc_pos, esc_pos + 1), consumed: 2 }\n" +
    "}\n"
}

/// The generated nesting bodies — one `scan_<name>` per nest_run_rules() entry.
export fn emit_nest_scanner_source() -> string {
    let rules = nest_run_rules()
    mut out = ""
    mut i = 0
    while i < rules.length {
        if i > 0 { out = out + "\n" }
        out = out + emit_nest_scanner(rules[i])
        i = i + 1
    }
    out
}

export fn gen_run_scanner_header() -> string {
    "// GENERATED by `bash scripts/diagnose.sh --emit-regen-run` — DO NOT EDIT BY HAND.\n" +
    "// Source of truth: char_run_rules() in parse/token_table.av (compiled to byte-run\n" +
    "// scan loops by parse/emit_lex.av). Editing char_run_rules without regenerating\n" +
    "// fails parse/tests/gen_run_scanner_regen_test.av.\n" +
    "use parse.{byte_at, EscapeRes, LOWER_X, " + run_symbol_import_list() + "}\n\n"
}

/// The COMPLETE text of parse/gen_run_scanner.av: header + char-class run bodies +
/// delimited run bodies.
export fn gen_run_scanner_file() -> string {
    gen_run_scanner_header() + emit_run_scanner_source() + "\n" + emit_delim_scanner_source() +
        "\n" + emit_str_scanner_source() + "\n" + emit_nest_scanner_source() +
        "\n" + emit_interp_scanner_source() +
        "\n" + emit_escape_resolver()
}
