// WHY: t-47hc.2 (Phase 1) — the DFA lexer's byte CHARACTER-CLASSIFICATION, the
// simdjson-style class lookup a generated scanner branches on. It operates on
// raw BYTES (int), read through `avra_bytes_byte` — NO per-character string
// allocation, which is the Phase-0 spike's #1 finding: the hand lexer's
// `char_at` (parse/lexer.av) materialises a 1-char STRING for every character.
// A generated DFA scanner will classify each byte with `char_class` and index
// the source with `byte_at`, both allocation-free.
//
// This is cross-validated against the hand lexer's own `p_is_*` predicates
// (charclass_test.av) so the byte-based classes provably agree with the
// string-based ones the current lexer uses — the equivalence the DFA scanner's
// byte-identity will rest on. Unused in production yet, so byte-identical.
//
// Extern decls are re-declared here (the established pattern — see core/ast.av:
// "an extern decl is just a reference to the C symbol, not a definition").
extern fn avra_bytes_from_string(s: string) -> bytes
extern fn avra_bytes_byte(b: bytes, idx: int) -> int
extern fn avra_bytes_length(b: bytes) -> int

/// The lexical byte classes the scanner dispatches on. `Alpha` = identifier
/// START (a-z A-Z _); `Digit` = 0-9; identifier CONTINUATION is Alpha|Digit.
/// `Whitespace` excludes the newline (which the scanner tracks for line/column
/// and the grammar's `^` sameline marker), so `Newline` is its own class.
/// Everything else — operators, punctuation, quotes, and non-ASCII bytes (which
/// occur only inside string/comment lexemes) — is `Other`.
export enum CharClass { Whitespace, Newline, Digit, Alpha, Other }

/// Classify a single byte. Total over 0..255 — ASCII letters/digits/underscore
/// and the ASCII whitespace the hand lexer skips; everything else (including
/// UTF-8 lead/continuation bytes 128..255) is `Other`.
export fn char_class(b: int) -> CharClass {
    if b == 10 { return .Newline }                              // \n
    if b == 32 || b == 9 || b == 13 { return .Whitespace }      // space, tab, CR
    if b >= 48 && b <= 57 { return .Digit }                     // 0-9
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95 { return .Alpha }  // a-z A-Z _
    .Other
}

/// True iff the byte can START an identifier (`Alpha`: a letter or `_`).
export fn cc_is_ident_start(b: int) -> bool {
    match char_class(b) { .Alpha -> true, _ -> false }
}

/// True iff the byte can CONTINUE an identifier (`Alpha` or `Digit`).
export fn cc_is_ident_cont(b: int) -> bool {
    match char_class(b) {
        .Alpha -> true
        .Digit -> true
        _ -> false
    }
}

/// True iff the byte is a decimal digit (`Digit`).
export fn cc_is_digit(b: int) -> bool {
    match char_class(b) { .Digit -> true, _ -> false }
}

/// Raw byte at index `i` of an already-materialised `bytes` view — the
/// allocation-free accessor the DFA scanner reads through (the source is
/// converted to `bytes` ONCE, then indexed many times, vs the hand lexer's
/// per-char `char_at` string allocation). Returns -1 at/past the end so the
/// scanner's bounds check is a single comparison.
export fn byte_at(src: bytes, i: int) -> int {
    if i < 0 || i >= avra_bytes_length(src) { return -1 }
    avra_bytes_byte(src, i)
}

/// Convenience over `byte_at` for callers holding a `string` (tests, one-shot
/// probes). Converts per call, so it is NOT the scanner's hot path — that
/// converts to `bytes` once and reuses it.
export fn byte_at_str(src: string, i: int) -> int {
    byte_at(avra_bytes_from_string(src), i)
}
