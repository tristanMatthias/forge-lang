// WHY: t-47hc.2 (Phase 1) — the DFA lexer's byte CHARACTER-CLASSIFICATION, the
// simdjson-style class lookup a generated scanner branches on. It operates on
// raw BYTES (int), read through `avra_bytes_byte` — NO per-character string
// allocation, which is the Phase-0 spike's #1 finding: the hand lexer's
// `char_at` (parse/lexer.av) materialises a 1-char STRING for every character.
// The generated scanners classify each byte with `char_class` and index the
// source with `byte_at`, both allocation-free.
//
// This is cross-validated against the `p_is_*` string predicates
// (charclass_test.av) so the byte-based classes provably agree with the
// string-based ones — the equivalence the scanners' byte-identity rests on.
// IN PRODUCTION: `advance_token` (parse/lexer.av) dispatches its lead byte
// through `cc_is_digit` / `cc_is_ident_start`, and the generated run scanners
// (parse/gen_run_scanner.av) loop on `cc_is_ident_cont` / `cc_is_*_digit`.
//
// Extern decls are re-declared here (the established pattern — see core/ast.av:
// "an extern decl is just a reference to the C symbol, not a definition").
use parse.{LF, SPACE, TAB, CR, DIGIT_0, DIGIT_1, DIGIT_7, DIGIT_9, LOWER_A, LOWER_F, LOWER_Z, UPPER_A, UPPER_F, UPPER_Z, UNDERSCORE}
use parse.{UTF8_CONT_MIN, UTF8_CONT_MAX, UTF8_LEAD2_MIN, UTF8_LEAD2_MAX, UTF8_LEAD3_MIN, UTF8_LEAD3_MAX, UTF8_LEAD4_MIN, UTF8_LEAD4_MAX}

extern fn avra_bytes_from_string(s: string) -> bytes
extern fn avra_bytes_byte(b: bytes, idx: int) -> int
extern fn avra_bytes_length(b: bytes) -> int

/// The lexical byte classes the scanner dispatches on. `Alpha` = identifier
/// START (a-z A-Z _); `Digit` = 0-9; identifier CONTINUATION is Alpha|Digit.
/// `Whitespace` excludes the newline (which the scanner tracks for line/column
/// and the grammar's `^` sameline marker), so `Newline` is its own class.
/// Everything else — operators, punctuation, quotes, and non-ASCII bytes (which
/// occur only inside string/comment lexemes) — is `Other`.
export enum CharClass { Whitespace, Newline, Digit, Alpha, Other }

/// Classify a single byte. Total over 0..255 — ASCII letters/digits/underscore
/// and the ASCII whitespace the hand lexer skips; everything else (including
/// UTF-8 lead/continuation bytes 128..255) is `Other`.
export fn char_class(b: int) -> CharClass {
    if b == LF { return .Newline }
    if b == SPACE || b == TAB || b == CR { return .Whitespace }
    if b >= DIGIT_0 && b <= DIGIT_9 { return .Digit }                                // 0-9
    if (b >= LOWER_A && b <= LOWER_Z) || (b >= UPPER_A && b <= UPPER_Z) || b == UNDERSCORE { return .Alpha }  // a-z A-Z _
    .Other
}

// ── UTF-8 sequence width (t-47hc.2.1) ──
//
// The lexer needs these ONLY on its error path: a non-ASCII byte reaching
// `advance_token`'s fallback is outside any string/comment, so the program is
// invalid. It is still ONE character, and reporting it byte-by-byte turned a
// single `∑` into four diagnostics (three "unexpected character" plus a
// downstream "expected expression") — noise that buries the real first error.
// Classification stays here beside `char_class` rather than in the lexer, so
// the byte-range knowledge has one home.

/// The byte length of the UTF-8 sequence `b` introduces: 4 / 3 / 2 for the
/// lead ranges, and 1 for everything else — ASCII, and also a STRAY
/// continuation byte, which leads nothing and so stands alone. Total over
/// 0..255, so a caller never has to pre-check the range.
export fn utf8_seq_len(b: int) -> int {
    if b >= UTF8_LEAD4_MIN && b <= UTF8_LEAD4_MAX { return 4 }
    if b >= UTF8_LEAD3_MIN && b <= UTF8_LEAD3_MAX { return 3 }
    if b >= UTF8_LEAD2_MIN && b <= UTF8_LEAD2_MAX { return 2 }
    1
}

/// True iff `b` is a UTF-8 CONTINUATION byte (0x80-0xBF). The lexer consumes
/// only bytes that really are continuations, so a MALFORMED sequence (a lead
/// promising more bytes than follow) cannot swallow the next valid token.
export fn cc_is_utf8_cont(b: int) -> bool {
    b >= UTF8_CONT_MIN && b <= UTF8_CONT_MAX
}

/// True iff the byte can START an identifier (`Alpha`: a letter or `_`).
export fn cc_is_ident_start(b: int) -> bool {
    match char_class(b) { .Alpha -> true, _ -> false }
}

/// True iff the byte can CONTINUE an identifier (`Alpha` or `Digit`).
export fn cc_is_ident_cont(b: int) -> bool {
    match char_class(b) {
        .Alpha -> true
        .Digit -> true
        _ -> false
    }
}

/// True iff the byte is a decimal digit (`Digit`).
export fn cc_is_digit(b: int) -> bool {
    match char_class(b) { .Digit -> true, _ -> false }
}

/// True iff the byte is a hex digit (`0`-`9`, `a`-`f`, `A`-`F`) — the byte-based
/// twin of the hand lexer's p_is_hex_digit, for the `0x` number scan.
export fn cc_is_hex_digit(b: int) -> bool {
    cc_is_digit(b) || (b >= LOWER_A && b <= LOWER_F) || (b >= UPPER_A && b <= UPPER_F)
}

/// True iff the byte is a binary digit (`0` or `1`) — twin of p_is_binary_digit.
export fn cc_is_binary_digit(b: int) -> bool {
    b == DIGIT_0 || b == DIGIT_1
}

/// True iff the byte is an octal digit (`0`-`7`) — twin of p_is_octal_digit.
export fn cc_is_octal_digit(b: int) -> bool {
    b >= DIGIT_0 && b <= DIGIT_7
}

/// Raw byte at index `i` of an already-materialised `bytes` view — the
/// allocation-free accessor the DFA scanner reads through (the source is
/// converted to `bytes` ONCE, then indexed many times, vs the hand lexer's
/// per-char `char_at` string allocation). Returns -1 at/past the end so the
/// scanner's bounds check is a single comparison.
export fn byte_at(src: bytes, i: int) -> int {
    if i < 0 || i >= avra_bytes_length(src) { return -1 }
    avra_bytes_byte(src, i)
}

/// Convenience over `byte_at` for callers holding a `string` (tests, one-shot
/// probes). Converts per call, so it is NOT the scanner's hot path — that
/// converts to `bytes` once and reuses it.
export fn byte_at_str(src: string, i: int) -> int {
    byte_at(avra_bytes_from_string(src), i)
}
