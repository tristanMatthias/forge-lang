// WHY: ps3t.6.7 Step G — the production boundary binding the CHECKED-IN generated
// static parser (parse.gen_parser's `parse_expression`) to the shared-token
// runner (run_static_expr_at_shared). Kept as a THIN, separate module so
// parse/mod.av imports ONE clearly-named runner (`run_static_expr`) instead of
// the generated module's free `parse_expression`, which would shadow the Parser
// method of the same name. The static entries are the only places the generated
// module is imported, so the emitter (emit.av) stays out of the production graph
// entirely — mod.av → static_expr_entry → gen_parser → grammar builders,
// never → emit.av.

use parse.gen_parser.{parse_expression, parse_bitxor}
use parse.{Parser}
use features.grammar.{run_static_expr_at_shared, Token, ExprModes, DslExprResult}
use core.{NodeStore}

/// Drive the generated static expression parser over the shared token stream at
/// `start_byte`, threading the outer parser's live modes + @hand delegate — the
/// static sibling of run_dsl_expr_at_shared (the Grammar-tree interpreter). Same
/// PState, same builders, same leaf ⇒ byte-identical AST, at straight-line speed.
/// TABLE-CELL entry: the generated expression parser started at binding power 12
/// (`parse_bitxor`), the level that stops BEFORE `|` (lbp 10) so a table's column
/// separator is never swallowed as a bitwise-or operand. The hand ladder expressed this
/// as `parse_binary_pratt(12)`; this is the same precedence through the generated parser,
/// and exists so table literals need no hand parser (t-47hc.4.1).
export fn run_static_expr_cell(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, modes: ExprModes, delegate: Parser) -> DslExprResult {
    run_static_expr_at_shared(toks, start_byte, src, file, store, modes, delegate, parse_bitxor)
}

export fn run_static_expr(toks: List<Token>, start_byte: int, src: string, file: string, store: NodeStore, modes: ExprModes, delegate: Parser?) -> DslExprResult {
    run_static_expr_at_shared(toks, start_byte, src, file, store, modes, delegate, parse_expression)
}
