extern fn avra_uptime_ms() -> int

// ICE localization: records "what the compiler is currently processing"
// so an internal crash (segfault/null-deref while bs2 compiles source) is
// localized to a phase + function trail + span instead of an
// un-symbolizable self-host backtrace. See runtime.c "ICE localization".
extern fn avra_ice_phase(phase: string)
extern fn avra_ice_push_fn(name: string)
extern fn avra_ice_pop_fn()
extern fn avra_ice_at(file: string, line: int, col: int)

// ── Type environment ──

/// Scope-stack entry for the type checker. Each binding records
/// the variable's name, inferred type, the depth at which it was
/// declared (for scope-pop on block exit), and whether it is a
/// `mut` binding. The full env is `List<TypeEntry>` —
/// most-recently-bound at the largest index; lookup walks
/// tail-to-head so the innermost binding shadows.
///
/// `mutable` exists for flow narrowing: an immutable binding
/// (`let` / param — the resolver forbids reassigning them, F3001)
/// can never be invalidated by a later write, so narrowing it is
/// always sound; a `mut` can be reassigned, so the variable form is
/// not narrowed (use `if let` instead). See `tc_narrow_present`.
type TypeEntry = { name: string, ty: ValueType, depth: int, mutable: bool }

/// Walk the type-environment looking for `name`. Returns
/// `ValueType.Unknown` when not bound — typecheck callers branch
/// on Unknown rather than pattern-matching on Option.
fn type_lookup(env: List<TypeEntry>, name: string) -> ValueType {
    mut i = env.length - 1
    while i >= 0 {
        let e = env[i]
        if e.name == name { return e.ty }
        i = i - 1
    }
    ValueType.Unknown
}

/// True when the innermost binding of `name` is a `mut`. Unbound or
/// immutable names return false.
fn type_is_mutable(env: List<TypeEntry>, name: string) -> bool {
    mut i = env.length - 1
    while i >= 0 {
        let e = env[i]
        if e.name == name { return e.mutable }
        i = i - 1
    }
    false
}

/// Push a binding onto the type environment. Returns a fresh
/// snapshot so sibling branches (then/else of an if etc.) keep
/// the parent's env un-extended.
fn type_bind(env: List<TypeEntry>, name: string, ty: ValueType, depth: int, mutable: bool) -> List<TypeEntry> {
    list_push_copy(env, TypeEntry { name, ty, depth, mutable })
}

/// Pop every entry whose declared depth is `>= depth`. Used on
/// block / fn exit to drop bindings that left their scope. Returns
/// a fresh list containing only the entries that remain in scope.
fn type_pop_scope(env: List<TypeEntry>, depth: int) -> List<TypeEntry> {
    mut keep_len = env.length
    while keep_len > 0 {
        if env[keep_len - 1].depth < depth { break }
        keep_len = keep_len - 1
    }
    if keep_len == env.length { return env }
    mut out: List<TypeEntry> = []
    mut i = 0
    while i < keep_len {
        out = out.push(env[i])
        i = i + 1
    }
    out
}

// ── Function type registry ──

/// Per-fn metadata stored in FnTypeReg's `ord` list. Insertion order
/// is preserved so rewrite_fn_ret_tys can re-resolve every entry's
/// param/ret types deterministically.
///
/// `tp` is the generic type-parameter list (e.g. `<T, U>`). At every
/// call site, typeck uses it to substitute T's in `ret_ty` from the
/// concrete arg types — so `fn first<T>(xs: List<T>) -> T` returns
/// `Int` (not the unresolved `T`) when called with a `List<int>`,
/// letting downstream call chains and let-bindings carry the
/// concrete type forward.
type FnTypeMeta = {
    name: string,
    tp: List<TypeParamEntry>,
    params: List<ParamEntry>,
    ret_ty: ValueType,
    is_extern: bool,
}

/// Function-name → (params, return type) table. Looked up by call
/// expressions to typecheck arity + per-arg compatibility.
///
/// Implementation: parallel pair of an insertion-ordered list and a
/// cstr-keyed hash map. The map's int payload holds the index into
/// `ord` so lookups are O(1). Replaces the prior cons-list `FnTypeEntry`
/// which was O(n) per lookup — bootstrap source has ~5000 fns and
/// every typecheck operation that touched a fn name paid the linear
/// walk. See forge-crafting-intepreters-kkgf.X for the perf rationale.
///
/// The `idx` map is mutable (heap-allocated cstr_map). Every `tc with
/// { fns: <reg> }` update reuses the same ptr — the `ord` list is the
/// only piece that grows immutably across `with`-updates.
type FnTypeReg = {
    ord: List<FnTypeMeta>,
    idx: ptr,
}

extern fn avra_map_new_cstr() -> ptr
extern fn avra_map_set_cstr(map: ptr, key: string, value: int)
extern fn avra_map_get_cstr(map: ptr, key: string) -> int
extern fn avra_map_has_cstr(map: ptr, key: string) -> int

/// Fresh empty registry — empty `ord`, fresh hash map.
fn fn_type_reg_new() -> FnTypeReg {
    FnTypeReg { ord: [], idx: avra_map_new_cstr() }
}

/// Empty `List<TypeParamEntry>` — used when registering non-generic
/// fns / extern fns / ctors that carry no type params. Wrapped in
/// a helper so callers don't need to spell the type at each site.
fn empty_type_params() -> List<TypeParamEntry> {
    let out: List<TypeParamEntry> = []
    out
}

/// Append (name, params, ret_ty) to `reg`. Mutates the map in place;
/// returns a new FnTypeReg with the extended list. Map ptr is shared
/// with the prior reg — see the `idx` field doc above.
fn fn_type_reg_register(reg: FnTypeReg, name: string, tp: List<TypeParamEntry>, params: List<ParamEntry>, ret_ty: ValueType, is_extern: bool) -> FnTypeReg {
    mut ord = reg.ord
    let new_idx = ord.length
    ord.push(FnTypeMeta { name, tp, params, ret_ty, is_extern })
    avra_map_set_cstr(reg.idx, name, new_idx)
    FnTypeReg { ord, idx: reg.idx }
}

/// Single-walk lookup result: `found=false` means the name is not
/// registered (params/ret_ty hold safe sentinels); `found=true`
/// means callers can read params/ret_ty directly without re-walking.
///
/// Replaces the prior fn_type_has + fn_type_lookup + tc_fn_arity +
/// tc_fn_params quartet; folding all four into one walk is the
/// dominant kkgf typeck win because every fn-call site previously
/// re-traversed the registry 4–5 times.
type FnTypeFound = {
    found: bool,
    tp: List<TypeParamEntry>,
    params: List<ParamEntry>,
    ret_ty: ValueType,
    is_extern: bool,
}

/// True when an extern re-declaration is signature-identical to the
/// registered one: same arity, same param types, same return type.
/// Param NAMES are immaterial — only the types participate in the
/// symbol contract.
fn extern_sig_matches(prior: FnTypeFound, params: List<ParamEntry>, ret_ty: ValueType) -> bool {
    if !vtype_eq(prior.ret_ty, ret_ty) { return false }
    if prior.params.length != params.length { return false }
    for (i, p) in params.enumerate() {
        if !extern_param_compatible(prior.params[i].vtype, p.vtype) { return false }
    }
    true
}

/// Param-type compatibility for extern re-declarations. Structural
/// equality, with one carve-out: the legacy `.Fn(ret)` shape encodes
/// ONLY a return type (arity unknown), so it matches any fn-typed
/// param with the same return — the two forms describe one symbol
/// contract and lower to the same closure word.
fn extern_param_compatible(a: ValueType, b: ValueType) -> bool {
    if vtype_eq(a, b) { return true }
    vtype_is_fn(a) && vtype_is_fn(b) && vtype_eq(vtype_fn_ret(a), vtype_fn_ret(b))
}

/// Render `(T1, T2) -> R` for the conflicting-extern diagnostic.
fn render_extern_sig(params: List<ParamEntry>, ret_ty: ValueType) -> string {
    let ps = [vtype_render_full(p.vtype) for p in params]
    "(${ps.join(", ")}) -> ${vtype_render_full(ret_ty)}"
}

/// O(1) lookup via the FnTypeReg's index map. Returns `found=false`
/// when the name is unregistered (params/ret_ty hold safe sentinels).
fn fn_type_get(fns: FnTypeReg, name: string) -> FnTypeFound {
    if avra_map_has_cstr(fns.idx, name) == 0 {
        let empty_tp: List<TypeParamEntry> = []
        let empty_p: List<ParamEntry> = []
        return FnTypeFound { found: false, tp: empty_tp, params: empty_p, ret_ty: ValueType.Unknown, is_extern: false }
    }
    let i = avra_map_get_cstr(fns.idx, name)
    let m = fns.ord[i]
    FnTypeFound { found: true, tp: m.tp, params: m.params, ret_ty: m.ret_ty, is_extern: m.is_extern }
}


/// Length of an arg list. Inlined to keep the import surface tight.
fn tc_count_args(list: List<SExpr>) -> int {
    list.length
}

// ── Raw return-type string registry ──
// Stores the raw annotation string for function return types so that
// generic type parameters (e.g. the Ok type in Result<T, E>) can be
// extracted for downstream checks like `catch` body type validation.

// Look up the Ok type for a catch expression.
// Given a TC and the inner expression, determines the expected catch body type.
// Returns the Ok type as a ValueType, or null if unknown.
/// For `expr catch (e) { body }`: when `expr` is a Result-shaped
/// Try, return the Ok-arm's payload type so `body` can be checked
/// against the same type. Returns null when `expr` isn't a Result.
export fn tc_catch_ok_type(tc: TC, inner: Expr) -> ValueType? {
    let fn_name = match inner {
        .Call(callee, _) -> match tc.nodes.exprs.get(callee) {
            .Ident(name) -> name
            .QualifiedIdent(path) -> path
            _ -> ""
        }
        .GenericCall(callee, _, _) -> match tc.nodes.exprs.get(callee) {
            .Ident(name) -> name
            .QualifiedIdent(path) -> path
            _ -> ""
        }
        _ -> ""
    }
    if fn_name == "" { return null }
    // Look up the function's return type from the typed registry
    let ret_ty = fn_type_get(tc.fns, fn_name).ret_ty
    // Check if it's Result (Enum with type_args)
    match ret_ty {
        .Enum(name, args, _) -> {
            if !is_result_enum_name(name) { return null }
            // First type arg is the Ok type. List<ValueType> replaced
            // the retired TypeList cons-list — index with [] / length,
            // not .Node/.End (which match a different runtime shape
            // and cause an ICE here).
            if args.length == 0 { null } else { args[0] }
        }
        _ -> null
    }
}

/// The `Ok`-variant payload type of a user-defined Result-shaped enum
/// (one declaring both `Ok` and `Err` variants), or null when `ename`
/// isn't Result-shaped. Lets the `?` operator unwrap user Result-likes
/// (TrResult, MyResult) to their success type at typeck time — codegen
/// already unwraps them at runtime, so without this the binding
/// `let x = userResult()?` mis-typed `x` as the whole enum instead of
/// the `Ok` payload. An `Ok` with no payload yields Void.
export fn tc_result_ok_payload(tc: TC, ename: string) -> ValueType? {
    if !enum_type_has(tc.enums, ename) { return null }
    let variants = enum_type_variants(tc.enums, ename)
    if variant_find(variants, "Ok") == null { return null }
    if variant_find(variants, "Err") == null { return null }
    let okv = variant_find(variants, "Ok")!
    if okv.fields.length == 0 { return ValueType.Void }
    resolve_vtype(tc, okv.fields[0].resolved)
}

// ── Struct/Enum registries ──

/// One struct's metadata in StructTypeReg's `ord` list. `tp` carries
/// the struct's declared type parameters (empty for non-generic
/// structs / shapes) so field-access typing can map a generic
/// instance's `type_args` back onto the field's declared `T`,
/// mirroring EnumTypeMeta.
type StructTypeMeta = { name: string, tp: List<TypeParamEntry>, fields: List<FieldEntry> }

/// Struct-name → `List<FieldEntry>` table. Populated during the
/// `collect_decls` pre-pass; consulted by struct-literal and
/// field-access typecheck. Same hashmap-backed shape as FnTypeReg —
/// O(1) lookup via cstr_map index into the insertion-ordered list.
/// Replaces a cons-list that was O(n) per lookup.
type StructTypeReg = {
    ord: List<StructTypeMeta>,
    idx: ptr,
}

fn struct_type_reg_new() -> StructTypeReg {
    StructTypeReg { ord: [], idx: avra_map_new_cstr() }
}

fn struct_type_reg_register(reg: StructTypeReg, name: string, tp: List<TypeParamEntry>, fields: List<FieldEntry>) -> StructTypeReg {
    mut ord = reg.ord
    let new_idx = ord.length
    ord.push(StructTypeMeta { name, tp, fields })
    avra_map_set_cstr(reg.idx, name, new_idx)
    StructTypeReg { ord, idx: reg.idx }
}

/// Look up a struct's type-param list by name. Empty when the struct
/// isn't registered or has no generics — callers short-circuit
/// substitution in that case. Mirrors `enum_type_params`.
export fn struct_type_params(reg: StructTypeReg, name: string) -> List<TypeParamEntry> {
    if avra_map_has_cstr(reg.idx, name) == 0 {
        let empty: List<TypeParamEntry> = []
        return empty
    }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.ord[i].tp
}

/// Specialise a generic struct field's declared type to the receiver
/// instance's type args. Given the receiver `base_ty` (a generic
/// struct instance carrying `type_args`) and the field's declared type,
/// zip the struct's declared type-params with the instance args and
/// substitute. A no-op when the receiver carries no args or the struct
/// is non-generic, so non-generic field access stays a plain return.
/// Shared by the field-access fast path and the canonical path.
export fn tc_specialize_field_ty(reg: StructTypeReg, base_ty: ValueType, field_ty: ValueType) -> ValueType {
    let type_args = vtype_type_args(base_ty)
    let tps = struct_type_params(reg, vtype_struct_name(base_ty))
    if type_args.length > 0 && tps.length > 0 {
        vtype_subst_params(field_ty, tps, type_args)
    } else {
        field_ty
    }
}

/// Look up a single field's resolved type within a field list.
/// Returns ValueType.Unknown when the field name isn't found. Used
/// by the kkgf annotate fast-path to skip a redundant check_expr
/// re-walk for `obj.field` reads when obj is a bare identifier.
export fn field_type_lookup(fields: List<FieldEntry>, name: string) -> ValueType {
    for e in fields {
        if e.name == name { return e.resolved }
    }
    ValueType.Unknown
}

/// Look up a struct's field list by name. Empty list when not found.
export fn struct_type_lookup(reg: StructTypeReg, name: string) -> List<FieldEntry> {
    if avra_map_has_cstr(reg.idx, name) == 0 {
        let empty: List<FieldEntry> = []
        return empty
    }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.ord[i].fields
}

/// Membership probe for the struct registry.
fn struct_type_has(reg: StructTypeReg, name: string) -> bool {
    avra_map_has_cstr(reg.idx, name) != 0
}

/// One enum's metadata in EnumTypeReg's `ord` list. `tp` carries
/// the enum's declared type parameters so pattern-binding
/// substitution can map `T` → concrete from the subject's
/// `.Enum(_, type_args, _)` shape (so07.7.4 step 2).
type EnumTypeMeta = { name: string, tp: List<TypeParamEntry>, variants: List<Variant> }

/// Enum-name → `List<Variant>` table. Mirror of StructTypeReg for
/// enums — hashmap-backed for O(1) lookup.
type EnumTypeReg = {
    ord: List<EnumTypeMeta>,
    idx: ptr,
}

fn enum_type_reg_new() -> EnumTypeReg {
    EnumTypeReg { ord: [], idx: avra_map_new_cstr() }
}

fn enum_type_reg_register(reg: EnumTypeReg, name: string, tp: List<TypeParamEntry>, variants: List<Variant>) -> EnumTypeReg {
    mut ord = reg.ord
    let new_idx = ord.length
    ord.push(EnumTypeMeta { name, tp, variants })
    avra_map_set_cstr(reg.idx, name, new_idx)
    EnumTypeReg { ord, idx: reg.idx }
}

/// Membership probe for the enum registry.
fn enum_type_has(reg: EnumTypeReg, name: string) -> bool {
    avra_map_has_cstr(reg.idx, name) != 0
}

/// Look up an enum's variant list by enum name. Returns empty when
/// the enum isn't registered (callers fall back to legacy bind-with-
/// Unknown). so07.5 (T5).
export fn enum_type_variants(reg: EnumTypeReg, name: string) -> List<Variant> {
    if avra_map_has_cstr(reg.idx, name) == 0 {
        let empty: List<Variant> = []
        return empty
    }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.ord[i].variants
}

/// Look up an enum's type-param list by enum name. Returns empty
/// when the enum isn't registered or has no generics — callers
/// short-circuit substitution in that case. so07.7.4.
export fn enum_type_params(reg: EnumTypeReg, name: string) -> List<TypeParamEntry> {
    if avra_map_has_cstr(reg.idx, name) == 0 {
        let empty: List<TypeParamEntry> = []
        return empty
    }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.ord[i].tp
}

/// Find a variant by name within a variant list. Returns null when
/// not found. so07.5 (T5).
export fn variant_find(variants: List<Variant>, name: string) -> Variant? {
    for v in variants {
        if v.name == name { return v }
    }
    null
}

/// Reverse lookup: which enum declares `variant`? Returns "" when
/// the variant isn't registered. Used to type bare `.Variant`
/// expressions where the enum name is implicit from context.
/// Iterates REVERSE-of-insertion so most-recently-declared enums
/// win, preserving cons-list LIFO semantics
/// (forge-crafting-intepreters-q3gp).
export fn tc_enum_find_by_variant(reg: EnumTypeReg, variant: string) -> string {
    mut i = reg.ord.length - 1
    while i >= 0 {
        let m = reg.ord[i]
        if variant_has(m.variants, variant) { return m.name }
        i = i - 1
    }
    ""
}

/// True iff `name` matches any variant in the list.
fn variant_has(variants: List<Variant>, name: string) -> bool {
    list_any(variants, (v: Variant) -> v.name == name)
}

// ── Checker state ──

/// One method signature within a trait — name + parameter count
/// (including `self`). Used by `check_trait_conformance` to verify
/// impl methods have matching arity.
export type TraitMethod = {
    name: string,
    param_count: int,
}

/// One trait's metadata in TraitRegistry's `ord` list.
type TraitRegMeta = {
    name: string,
    methods: List<TraitMethod>,
    assoc_types: List<string>,
}

/// Trait-name → (methods, assoc types) table. Populated by the
/// pre-pass `collect_decls`; consulted whenever an impl block or
/// `dyn Trait` appears. Hashmap-backed for O(1) lookup, same pattern
/// as FnTypeReg / StructTypeReg / EnumTypeReg.
type TraitRegistry = {
    ord: List<TraitRegMeta>,
    idx: ptr,
}

fn trait_registry_new() -> TraitRegistry {
    TraitRegistry { ord: [], idx: avra_map_new_cstr() }
}

fn trait_registry_register(reg: TraitRegistry, name: string, methods: List<TraitMethod>, assoc_types: List<string>) -> TraitRegistry {
    mut ord = reg.ord
    let new_idx = ord.length
    ord.push(TraitRegMeta { name, methods, assoc_types })
    avra_map_set_cstr(reg.idx, name, new_idx)
    TraitRegistry { ord, idx: reg.idx }
}

/// Single-walk lookup result for the trait registry — same pattern
/// as `FnTypeFound`. `found=false` means the trait isn't registered;
/// `methods` and `assoc_types` carry safe sentinels in that case.
/// Hot-path consumers prefer `trait_get` over the legacy split
/// `trait_has` + `trait_lookup` + `trait_assoc_types` trio so each
/// call site walks the registry exactly once.
export type TraitFound = {
    found: bool,
    methods: List<TraitMethod>,
    assoc_types: List<string>,
}

/// One-walk lookup. Returns a record with `found=false` when the
/// trait is not in the registry. O(1) via the index map.
export fn trait_get(reg: TraitRegistry, name: string) -> TraitFound {
    if avra_map_has_cstr(reg.idx, name) == 0 {
        return TraitFound { found: false, methods: [], assoc_types: [] }
    }
    let i = avra_map_get_cstr(reg.idx, name)
    let m = reg.ord[i]
    TraitFound { found: true, methods: m.methods, assoc_types: m.assoc_types }
}

/// Membership probe for the trait registry. Convenience wrapper
/// over `trait_get` — prefer the latter when also reading methods
/// or assoc_types in the same code path.
export fn trait_has(reg: TraitRegistry, name: string) -> bool {
    trait_get(reg, name).found
}

/// Orphan-rule helper — true iff `name` is a type declared in this
/// compilation unit (or a primitive). Drives the impl-coherence
/// check that requires either the trait OR the type to be local.
export fn tc_owns_type(tc: TC, name: string) -> bool {
    if struct_type_has(tc.structs, name) { return true }
    if enum_type_has(tc.enums, name) { return true }
    // Primitive types are always "owned"
    if name in ["int", "string", "bool", "float", "ptr"] { return true }
    false
}

/// Set of struct names that are declared with `shape` rather than
/// `type`. Drives structural (width-subtype) compatibility checks.
/// Backed by `List<string>` — membership-only queries, no iteration.

/// Membership probe for the shape set.
fn is_shape(set: List<string>, name: string) -> bool {
    list_any(set, (n: string) -> n == name)
}

/// One newtype's metadata in NewtypeReg's `ord` list.
type NewtypeMeta = { name: string, inner_vt: ValueType }

/// Newtype-name → inner-type table. Populated by `collect_decls`,
/// consulted by `resolve_vtype` to peel newtype wrappers when
/// matching types. Hashmap-backed for O(1) lookup.
type NewtypeReg = {
    ord: List<NewtypeMeta>,
    idx: ptr,
}

fn newtype_reg_new() -> NewtypeReg {
    NewtypeReg { ord: [], idx: avra_map_new_cstr() }
}

fn newtype_reg_register(reg: NewtypeReg, name: string, inner_vt: ValueType) -> NewtypeReg {
    mut ord = reg.ord
    let new_idx = ord.length
    ord.push(NewtypeMeta { name, inner_vt })
    avra_map_set_cstr(reg.idx, name, new_idx)
    NewtypeReg { ord, idx: reg.idx }
}

/// Look up a newtype's inner type. Unknown when not found.
fn newtype_vtype_lookup(reg: NewtypeReg, name: string) -> ValueType {
    if avra_map_has_cstr(reg.idx, name) == 0 { return ValueType.Unknown }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.ord[i].inner_vt
}

/// One union-alias's metadata in UnionAliasReg's `ord` list.
type UnionAliasMeta = { name: string, type_vt: ValueType }

/// Union-alias table: `type Json = string | int | bool` → name
/// → Union ValueType. Used to expand the alias when typechecking.
/// Hashmap-backed for O(1) lookup.
type UnionAliasReg = {
    ord: List<UnionAliasMeta>,
    idx: ptr,
}

fn union_alias_reg_new() -> UnionAliasReg {
    UnionAliasReg { ord: [], idx: avra_map_new_cstr() }
}

fn union_alias_reg_register(reg: UnionAliasReg, name: string, type_vt: ValueType) -> UnionAliasReg {
    mut ord = reg.ord
    let new_idx = ord.length
    ord.push(UnionAliasMeta { name, type_vt })
    avra_map_set_cstr(reg.idx, name, new_idx)
    UnionAliasReg { ord, idx: reg.idx }
}

/// Look up a union alias's expanded type. Unknown when not registered.
fn union_alias_vtype_lookup(reg: UnionAliasReg, name: string) -> ValueType {
    if avra_map_has_cstr(reg.idx, name) == 0 { return ValueType.Unknown }
    let i = avra_map_get_cstr(reg.idx, name)
    reg.ord[i].type_vt
}

/// Associated-type definitions from `impl Trait for Type { type
/// Item = ConcreteType }`. Key shape: `"TypeName.AssocName"` (e.g.
/// `"Circle.Item"`); value is the concrete ValueType the impl
/// pinned the trait's associated type to.
type AssocTypeEntry = { key: string, concrete_vt: ValueType }

/// Look up an associated-type definition by `"TypeName.AssocName"`
/// key. Returns Unknown when the impl didn't pin that assoc type.
fn assoc_type_vt_lookup(reg: List<AssocTypeEntry>, key: string) -> ValueType {
    for e in reg {
        if e.key == key { return e.concrete_vt }
    }
    ValueType.Unknown
}

/// Mutable threaded state for the type-checker pass. Carries every
/// lookup table the checker needs plus the diagnostics bag and
/// current source position. Like Resolver, threaded purely
/// functionally despite the imperative-looking call sites.
type TC = {
    types: List<TypeEntry>,
    fns: FnTypeReg,
    structs: StructTypeReg,
    shapes: List<string>,
    enums: EnumTypeReg,
    newtypes: NewtypeReg,
    union_aliases: UnionAliasReg,
    depth: int,
    bag: DiagnosticBag,
    current_fn: string,
    current_line: int,
    current_col: int,
    traits: TraitRegistry,
    trait_impls: List<TraitImplEntry>,
    assoc_type_defs: List<AssocTypeEntry>,
    features: Registry,
    // Shared TypeId allocator from the resolver. When set, the
    // typeck-side ValueType producers (resolve_vtype's Trait/Newtype
    // newtype-ctor-return, …) stamp the registry's id instead of the
    // hard-coded 0 sentinel that forced vtype_eq to fall back to
    // name comparison. Empty registry when typeck is invoked
    // standalone (no resolver pass) — same id=0 → name-fallback
    // behaviour preserved.
    type_reg: TypeRegistry,
    // Macro-origin table from the resolver (so07.3 / T3 Phase 1).
    // Empty when typeck is invoked without macro expansion. Used by
    // tc_report_at to retag diagnostics whose `current_fn` was
    // synthesised by @expand: the message gets a "[from macro …]"
    // prefix and the span swaps to the @expand site so the caret
    // lands on the user's annotation, not the synthetic body.
    macro_origins: List<MacroFnOrigin>,
    // The program's NodeStore (B-final F2+): flipped pattern payloads
    // resolve through here (exhaustiveness, arm binding).
    nodes: NodeStore,
}

/// One `impl Trait for Type` relationship. The full registry is
/// `List<TraitImplEntry>` — built during typecheck (from `Stmt.Impl`
/// nodes) and consulted by monomorphization to verify trait bounds
/// on generic type arguments at instantiation sites.
export type TraitImplEntry = { trait_name: string, type_name: string }

/// True iff some `impl trait_name for type_name` is registered.
/// Compares on short names so a query like
/// `("module::WcInt", "WcSized")` matches a registry entry stored
/// as `("module::WcSized", "module::WcInt")` — type param bound
/// strings aren't module-qualified by the resolver.
export fn type_implements_trait(reg: List<TraitImplEntry>, type_name: string, trait_name: string) -> bool {
    let q_trait = type_short_name(trait_name)
    let q_type = type_short_name(type_name)
    for e in reg {
        if type_short_name(e.trait_name) == q_trait && type_short_name(e.type_name) == q_type {
            return true
        }
    }
    false
}

/// Output of the per-expression checker: the updated TC plus the
/// expression's inferred type.
type ExprResult = {
    tc: TC,
    ty: ValueType,
}

/// Fresh empty TC at depth 0 with a fresh feature registry.
/// `type_reg` is the resolver's TypeId allocator threaded through
/// from `typecheck_program`; an empty registry preserves the
/// id=0 sentinel behaviour for any standalone use.
fn tc_new(type_reg: TypeRegistry, macro_origins: List<MacroFnOrigin>, store: NodeStore) -> TC {
    let empty_shapes: List<string> = []
    let empty_assoc: List<AssocTypeEntry> = []
    let empty_impls: List<TraitImplEntry> = []
    let empty_types: List<TypeEntry> = []
    TC {
        types: empty_types,
        fns: fn_type_reg_new(),
        structs: struct_type_reg_new(),
        shapes: empty_shapes,
        enums: enum_type_reg_new(),
        newtypes: newtype_reg_new(),
        union_aliases: union_alias_reg_new(),
        depth: 0,
        bag: bag_new(),
        current_fn: "",
        current_line: 0,
        current_col: 0,
        traits: trait_registry_new(),
        trait_impls: empty_impls,
        assoc_type_defs: empty_assoc,
        features: build_registry(),
        type_reg,
        macro_origins,
        nodes: store,
    }
}

/// Bump scope depth — entering a new block.
export fn tc_enter(tc: TC) -> TC { tc with { depth: tc.depth + 1 } }
/// Pop bindings declared at the current depth and decrement.
export fn tc_exit(tc: TC) -> TC {
    tc with { types: type_pop_scope(tc.types, tc.depth), depth: tc.depth - 1 }
}
/// Register an immutable `name: ty` at the current depth — the
/// typecheck equivalent of `let name: ty` (also params, which the
/// resolver forbids reassigning).
export fn tc_bind(tc: TC, name: string, ty: ValueType) -> TC {
    tc with { types: type_bind(tc.types, name, ty, tc.depth, false) }
}

/// Register a mutable `mut name: ty` at the current depth. The only
/// difference from `tc_bind` is the `mutable` flag, which flow
/// narrowing consults (it never narrows the variable form of a mut).
export fn tc_bind_mut(tc: TC, name: string, ty: ValueType) -> TC {
    tc with { types: type_bind(tc.types, name, ty, tc.depth, true) }
}

// ── Flow narrowing (spec Axis 10) ──
// Ergonomic narrowing: after `if x != none { … }`, an
// `if x == none { return/break/continue }` early-exit, or
// `while x != none { … }`, the proven-present `x` is retyped from
// `T?` to `T` in the proven scope so a use site needn't repeat an
// unwrap.
//
// CAVEAT — this is the permissive *variable-narrowing* model, and it
// is NOT sound under reassignment: it retypes the variable in place,
// so a later `x = <maybe-none>` in the same scope leaves `x` wrongly
// typed `T` (it keeps the narrowed type instead of reverting). Spec
// Axis 10 mandates the sound *bind-fresh* model — the unwrapped value
// gets a fresh immutable name, so no mutable narrowed variable exists
// for a write to invalidate. This is the staged permissive predecessor
// of that; real safety must come from non-null enforcement deriving
// presence from the binding, never from trusting this flow fact across
// a reassignment or aliased mutation.

/// A nullability guard recovered from an `if`/`while` condition of
/// the form `x == none` / `x != none`. `var` is the compared
/// variable (`""` when the condition is not a recognised guard);
/// `present_when_true` is `true` for `x != none` — the branch taken
/// when the condition holds has `x` present.
export type NarrowGuard = { var: string, present_when_true: bool }

fn narrow_guard_none() -> NarrowGuard { NarrowGuard { var: "", present_when_true: false } }

/// Recognise `x == none` / `x != none` (either operand order) and
/// recover the variable plus its presence in the true-branch.
/// Conservative: only a bare identifier compared directly to the
/// `none` literal narrows — anything more complex is ignored so
/// narrowing never fires on an expression it can't prove.
export fn narrow_guard_of(store: NodeStore, cond: Expr) -> NarrowGuard {
    match cond {
        .Binary(left, op, right) -> {
            let is_ne = op is .Ne
            let is_eq = op is .Eq
            if !is_ne && !is_eq { return narrow_guard_none() }
            let left_e = store.exprs.get(left)
            let right_e = store.exprs.get(right)
            let lname = match left_e { .Ident(n) -> n, _ -> "" }
            let rname = match right_e { .Ident(n) -> n, _ -> "" }
            let l_is_none = left_e is .None
            let r_is_none = right_e is .None
            if lname != "" && r_is_none { return NarrowGuard { var: lname, present_when_true: is_ne } }
            if rname != "" && l_is_none { return NarrowGuard { var: rname, present_when_true: is_ne } }
            narrow_guard_none()
        }
        _ -> narrow_guard_none()
    }
}

/// Narrow `name` from `T?` to `T` at the current depth when it is
/// currently tracked as an *immutable* optional. A no-op for `""`,
/// unknown, already-non-optional, or `mut` bindings. Internal to the
/// narrowing helpers (`tc_narrow_true_branch` / `tc_narrow_false_branch`
/// / the continuation) — features narrow via those, not this directly.
///
/// Soundness (spec Axis 10.4): only immutable bindings (`let` / params)
/// are narrowed in the variable form. They cannot be reassigned (the
/// resolver enforces this, F3001), so no later write can invalidate the
/// narrowed type. A `mut` *can* be reassigned to a maybe-absent value,
/// so the variable form is never narrowed for it — `mut`s use the
/// bind-fresh `if let v = x` form instead, where `v` is a fresh
/// immutable binding that nothing can invalidate.
fn tc_narrow_present(tc: TC, name: string) -> TC {
    if name == "" { return tc }
    if type_is_mutable(tc.types, name) { return tc }
    let ty = type_lookup(tc.types, name)
    if !vtype_is_optional(ty) { return tc }
    tc_bind(tc, name, vtype_strip_optional(ty))
}

/// Narrow the guard variable in the branch entered when the condition
/// is TRUE (the then-branch / loop body). A no-op unless the guard
/// proves presence there (`x != none`).
export fn tc_narrow_true_branch(tc: TC, guard: NarrowGuard) -> TC {
    if guard.present_when_true { tc_narrow_present(tc, guard.var) } else { tc }
}

/// Narrow the guard variable in the branch entered when the condition
/// is FALSE (the else-branch). A no-op unless the guard proves
/// presence there (`x == none`).
export fn tc_narrow_false_branch(tc: TC, guard: NarrowGuard) -> TC {
    if guard.present_when_true { tc } else { tc_narrow_present(tc, guard.var) }
}

/// Apply *continuation* narrowing after an `if`. When the branch in
/// which the guard variable is absent (its "none-side") diverges,
/// reaching the code after the `if` proves the variable is present —
/// so narrow it for the rest of the enclosing block. This is what
/// makes the dominant `if x == none { return … }` guard retype `x`
/// to `T` in everything that follows.
export fn tc_narrow_after_if(tc: TC, guard: NarrowGuard, then_b: Stmt, else_b: Stmt?) -> TC {
    if guard.var == "" { return tc }
    let none_side_diverges = if guard.present_when_true {
        // `x != none`: the none-side is the else-branch (a bare
        // fall-through never diverges).
        else_b != null && stmt_diverges(tc.nodes, else_b!)
    } else {
        // `x == none`: the none-side is the then-branch.
        stmt_diverges(tc.nodes, then_b)
    }
    if none_side_diverges { tc_narrow_present(tc, guard.var) } else { tc }
}
/// Append a diagnostic at the TC's current line/col. Most call
/// sites use this rather than `tc_report_at` because they're
/// already tracking position via `current_line` / `current_col`.
export fn tc_report(tc: TC, code: DiagCode, msg: string) -> TC {
    tc_report_at(tc, code, msg, tc.current_line, tc.current_col, 0)
}

/// Decorate the message half of a diagnostic with the TC's per-fn /
/// macro context. so07.3 (T3 Phase 1): when `tc.current_fn` is in the
/// macro origin table, prefix the message with `[from @expand(name)]`
/// + the synthesised-fn footer so the user sees which @expand they
/// authored produced the error. Bare per-fn footer when no origin
/// matches.
///
/// Kept split from `tc_decorate_span` (instead of one tuple-returning
/// helper) because the seed compiler predates the pry2 fix that taught
/// `tc_check_stmt_returns` about mid-block let bindings — without it,
/// a tuple return through a local hits a false-positive F1000. When
/// the seed catches up (post-update-seed cycle on a commit that has
/// pry2 in the seed), this can collapse back to one helper.
fn tc_decorate_msg(tc: TC, msg: string) -> string {
    let origin = macro_origin_lookup(tc.macro_origins, tc.current_fn)
    if origin != null {
        let o = origin!
        return "[from @expand(${o.macro_name})] ${msg} (in synthesized function `${tc.current_fn}`)"
    }
    if tc.current_fn.length > 0 {
        return "${msg} (in function `${tc.current_fn}`)"
    }
    msg
}

/// Span half of the decoration. When a macro origin matches, swap to
/// the `@expand` invocation site so the caret lands on the user's
/// annotation rather than the synthesised body.
fn tc_decorate_span(tc: TC, fallback_sp: Span) -> Span {
    let origin = macro_origin_lookup(tc.macro_origins, tc.current_fn)
    if origin != null { return origin!.expand_site }
    fallback_sp
}

/// Append a diagnostic at an explicit `(line, col, len)` span.
/// Used when the offending expression has a known span that
/// differs from the TC's "current" position.
export fn tc_report_at(tc: TC, code: DiagCode, msg: string, line: int, col: int, len: int) -> TC {
    let fallback = if line > 0 { span_new(0, len, line, col) } else { span_dummy() }
    let sp = tc_decorate_span(tc, fallback)
    tc with { bag: bag_report(tc.bag, diag_error(code, tc_decorate_msg(tc, msg), sp)) }
}

/// Warning-severity sibling of `tc_report`. Goes through `bag_report`
/// like errors but doesn't cause `bag_has_errors` to fire — useful for
/// strict-mode checks that want to surface signal without blocking
/// the build (e.g. AVRA_STRICT_ARGS).
export fn tc_warn(tc: TC, code: DiagCode, msg: string) -> TC {
    let sp = tc_decorate_span(tc, span_dummy())
    tc with { bag: bag_report(tc.bag, diag_warning(code, tc_decorate_msg(tc, msg), sp)) }
}

/// Append a diagnostic with a dedicated cause message — surfaced
/// indented under the primary by the renderer.
export fn tc_report_with_cause(tc: TC, code: DiagCode, msg: string, cause_msg: string) -> TC {
    let fallback = if tc.current_line > 0 { span_new(0, 0, tc.current_line, tc.current_col) } else { span_dummy() }
    let sp = tc_decorate_span(tc, fallback)
    let primary = diag_error(code, tc_decorate_msg(tc, msg), sp)
    let cause = diag_error(code, cause_msg, span_dummy())
    tc with { bag: bag_report(tc.bag, diag_with_cause(primary, cause)) }
}

/// Build an ExprResult — convenience constructor used pervasively
/// by the per-expression checker arms.
export fn tc_er(tc: TC, ty: ValueType) -> ExprResult { ExprResult { tc, ty } }

/// Reject `obj[i]` on a receiver that has no `[]` codegen path (maps,
/// scalars): both would otherwise ICE in codegen (F9999 "indexing on
/// non-string/list value"). typeck is the gating stage, so emit the clean
/// F1206 here instead. `hint` completes the shared "cannot index a `T` with
/// `[]` — " message; `ret` is the type the checker keeps going with so a
/// rejected index produces no cascade (the F1206 already stops compilation).
fn tc_reject_index(tc: TC, obj_ty: ValueType, hint: string, ret: ValueType) -> ExprResult {
    tc_er(
        tc_report(tc, DiagCode.NotIndexable,
            "cannot index a `${vtype_render_full(obj_ty)}` with `[]` — ${hint}"),
        ret)
}

// Parse a union alias string "A | B | C" into ValueType.Union.
/// Canonicalise a ValueType against the TC's registries — peel
/// newtypes, expand union aliases, etc. Idempotent — calling
/// twice produces the same result.
export fn resolve_vtype(tc: TC, vt: ValueType) -> ValueType {
    match vt {
        .Struct(name, args, _) -> {
            // Associated type: "TypeName.AssocType" → resolve to concrete type
            let dot = name.index_of(".")
            if dot >= 0 {
                let assoc_key = name
                let concrete_vt = assoc_type_vt_lookup(tc.assoc_type_defs, assoc_key)
                if !vtype_is_unknown(concrete_vt) {
                    return resolve_vtype(tc, concrete_vt)
                }
            }
            if enum_type_has(tc.enums, name) {
                let empty_args: List<ValueType> = []
                return ValueType.Enum(name, empty_args, 0)
            }
            let ua_vt = union_alias_vtype_lookup(tc.union_aliases, name)
            if !vtype_is_unknown(ua_vt) { return resolve_vtype(tc, ua_vt) }
            let nt_vt = newtype_vtype_lookup(tc.newtypes, name)
            if !vtype_is_unknown(nt_vt) { return ValueType.Newtype(name, resolve_vtype(tc, nt_vt), type_registry_id_for(tc.type_reg, name)) }
            if struct_type_has(tc.structs, name) { return ValueType.Struct(name, resolve_vtype_list(tc, args), 0) }
            if trait_has(tc.traits, name) { return ValueType.Trait(name, type_registry_id_for(tc.type_reg, name)) }
            vt
        }
        .Enum(name, args, _) -> {
            let resolved_args = resolve_vtype_list(tc, args)
            if enum_type_has(tc.enums, name) { return ValueType.Enum(name, resolved_args, 0) }
            // A bare generic annotation like `Box<int>` lowers to Enum at
            // parse time (the parser can't tell struct from enum); reclassify
            // to a generic struct instance, carrying the type args so field
            // access can substitute them.
            if struct_type_has(tc.structs, name) { return ValueType.Struct(name, resolved_args, 0) }
            ValueType.Enum(name, resolved_args, 0)
        }
        .List(elem) -> ValueType.List(resolve_vtype(tc, elem))
        // Resolve a Map's key + value (mirrors List/Tuple/Optional): without
        // this a `Map<string, Email>` value stays an unresolved nominal shell,
        // so the map-value layout check compares against `Unknown` and SKIPS a
        // real conflict (`Map<string, Box<Email>> = {Box<int>}` slipped).
        .Map(key, value) -> ValueType.Map(resolve_vtype(tc, key), resolve_vtype(tc, value))
        .Union(types) -> ValueType.Union(resolve_vtype_list(tc, types))
        .FnTyped(params, ret) -> ValueType.FnTyped(resolve_vtype_list(tc, params), resolve_vtype(tc, ret))
        // Shortcut #6: recurse into Tuple element types. Without
        // this, a cross-package fn returning
        // `Result<(List<int>, BytesReader), E>` lost its Tuple
        // element types — they stayed un-resolved Struct shells
        // and check_try saw `(tuple)` instead of
        // `(tuple List<int>, BytesReader)`.
        .Tuple(elems) -> ValueType.Tuple(resolve_vtype_list(tc, elems))
        // Optional (T?): resolve the inner so its nominal slot upgrades
        // (Struct shell -> Enum, id stamping). Without this the inner of a
        // `T?` annotation stays unresolved and false-positive type
        // mismatches fire against the resolved body type.
        .Optional(inner) -> ValueType.Optional(resolve_vtype(tc, inner))
        _ -> vt
    }
}

/// Map `resolve_vtype` over each ValueType in a `List<ValueType>`.
fn resolve_vtype_list(tc: TC, types: List<ValueType>) -> List<ValueType> {
    list_map(types, (t: ValueType) -> resolve_vtype(tc, t))
}

// ── F1004 — under-applied generic gate (spec Axis 20; the totality rule) ──
//
// A representation/layout decision must never be made from a type that does
// not uniquely determine a representation. A declared generic used with fewer
// type arguments than it declares (`GenOpt` where `enum GenOpt<T>`) is exactly
// such a type: a single non-generic body cannot serve every instantiation's
// payload representation, so codegen would otherwise pick one by first-match —
// the silent wrong-layout / segfault class. Reject it here, before codegen,
// with a clear diagnostic instead of a guess.

/// Recursively verify every declared-generic reference inside a RESOLVED
/// ValueType is fully applied. Recurses through container / wrapper types so a
/// bare generic nested in `List<…>`, `T?`, a tuple, a union, or a fn type is
/// caught too. `scope_tp` is the in-scope type parameters (the enclosing fn's
/// or decl's): a name that IS a type param is exempt even when a declared
/// generic type SHADOWS it (`fn id<T>(x: T)` with a top-level `type T<U>` — `T`
/// here is the param, not the type). A non-shadowing type param is exempt
/// anyway, since it names no declared type (arity lookup empty).
fn tc_check_type_applied(tc: TC, vt: ValueType, scope_tp: List<TypeParamEntry>) -> TC {
    match vt {
        .Enum(name, args, _) -> tc_check_generic_arity(tc, name, args, enum_type_params(tc.enums, name), scope_tp)
        .Struct(name, args, _) -> tc_check_generic_arity(tc, name, args, struct_type_params(tc.structs, name), scope_tp)
        .List(elem) -> tc_check_type_applied(tc, elem, scope_tp)
        .Map(key, value) -> tc_check_type_applied(tc_check_type_applied(tc, key, scope_tp), value, scope_tp)
        .Optional(inner) -> tc_check_type_applied(tc, inner, scope_tp)
        .Newtype(_, inner, _) -> tc_check_type_applied(tc, inner, scope_tp)
        .Union(types) -> tc_check_type_applied_list(tc, types, scope_tp)
        .Tuple(elems) -> tc_check_type_applied_list(tc, elems, scope_tp)
        .FnTyped(params, ret) -> tc_check_type_applied(tc_check_type_applied_list(tc, params, scope_tp), ret, scope_tp)
        _ -> tc
    }
}

/// `tc_check_type_applied` folded over a list of ValueTypes.
fn tc_check_type_applied_list(tc: TC, types: List<ValueType>, scope_tp: List<TypeParamEntry>) -> TC {
    mut cur = tc
    for t in types { cur = tc_check_type_applied(cur, t, scope_tp) }
    cur
}

/// Report F1004 when a declared generic (`decl_tps.length > 0`) is given fewer
/// type arguments than it declares, then recurse into whatever args ARE
/// present so a nested bare generic (`Box<GenOpt>`) is still caught. A name
/// that is an in-scope type param is exempt — it's the param, not a shadowed
/// declared type (`fn id<T>(x: T)` with a top-level `type T<U>`); the arity
/// exemption lives here so both the Enum and Struct paths share it.
fn tc_check_generic_arity(tc: TC, name: string, args: List<ValueType>, decl_tps: List<TypeParamEntry>, scope_tp: List<TypeParamEntry>) -> TC {
    let inner = tc_check_type_applied_list(tc, args, scope_tp)
    if !type_param_has(scope_tp, name) && decl_tps.length > 0 && args.length < decl_tps.length {
        return tc_report(inner, DiagCode.UnderAppliedGeneric,
            "generic type `${name}` takes ${decl_tps.length} type argument(s) but ${args.length} given — write `${name}<…>`, or make the function generic over the missing parameter")
    }
    inner
}

/// Run the F1004 gate over a function signature: every NON-`self` parameter
/// plus the return type, with the fn's own type params in scope so a param
/// named after a type param is exempt. `self` is exempt — its concrete type is
/// the receiver, supplied (and monomorphized) at the call site. Unknown / Void
/// positions carry no layout claim, so they are skipped.
fn tc_check_signature_arity(tc: TC, params: List<ParamEntry>, ret_vt: ValueType, scope_tp: List<TypeParamEntry>) -> TC {
    mut cur = tc
    for p in params {
        if p.name != "self" && !vtype_is_unknown(p.vtype) {
            cur = tc_check_type_applied(cur, resolve_vtype(cur, p.vtype), scope_tp)
        }
    }
    if !vtype_is_unknown(ret_vt) && !vtype_eq(ret_vt, .Void) {
        cur = tc_check_type_applied(cur, resolve_vtype(cur, ret_vt), scope_tp)
    }
    cur
}

/// No-type-param entry point for callers with no enclosing generic context
/// (lambdas, externs). Exported for the closures feature.
export fn tc_check_signature_arity_top(tc: TC, params: List<ParamEntry>, ret_vt: ValueType) -> TC {
    tc_check_signature_arity(tc, params, ret_vt, empty_type_params())
}

/// Run the F1004 gate over a struct/shape's fields (or an enum variant's
/// payload — same `FieldEntry` shape). A field stores a value, so a bare
/// generic field type is the same unguarded layout hole as a bare parameter.
/// A generic decl's own type params (`items: List<V>`) are exempt — `V` is not
/// a declared type, so its arity lookup is empty. Runs in the check pass, after
/// `collect_decls` populates the registries, so forward-referenced generics
/// resolve.
fn tc_check_field_types(tc: TC, fields: List<FieldEntry>, scope_tp: List<TypeParamEntry>) -> TC {
    mut cur = tc
    for f in fields {
        if !vtype_is_unknown(f.resolved) {
            cur = tc_check_type_applied(cur, resolve_vtype(cur, f.resolved), scope_tp)
        }
    }
    cur
}

/// `tc_check_field_types` over every variant's payload in an enum.
fn tc_check_variant_types(tc: TC, variants: List<Variant>, scope_tp: List<TypeParamEntry>) -> TC {
    mut cur = tc
    for v in variants { cur = tc_check_field_types(cur, v.fields, scope_tp) }
    cur
}

/// Gate the signature of every method in a trait declaration. A default
/// method body is compiled into each impl that inherits it, and a required
/// signature is the contract every impl must match — both claim a layout, so
/// a bare generic in a trait method's params/return is gated like a free fn's.
fn tc_check_trait_method_sigs(tc: TC, methods: List<SStmt>) -> TC {
    mut cur = tc
    for ss in methods {
        // A trait method with a body parses to `Function`; a body-less required
        // signature parses to `ExternFn` (see trait_decl/parser.av). Gate both,
        // with the method's own type params in scope.
        cur = match stmt_unwrap(tc.nodes, ss.node) {
            .Function(_, mtp, params, ret_vt, _) -> tc_check_signature_arity(cur, params, ret_vt, mtp)
            .ExternFn(_, params, ret_vt) -> tc_check_signature_arity_top(cur, params, ret_vt)
            _ -> cur
        }
    }
    cur
}

// ── Entry point ──

/// Output of `typecheck_program`: the annotated stmt tree, the
/// diagnostic bag, and the trait-impl registry (consumed later by
/// the monomorphizer for trait-bound monomorphisation).
export type TypeCheckResult = {
    stmts: List<SStmt>,
    had_error: int,
    bag: DiagnosticBag,
    trait_impls: List<TraitImplEntry>,
}

/// Top-level entry: run the type-checker over `stmts`. Three
/// passes: pre-pass `collect_decls` registers types/fns; main
/// `check_stmts` walks the AST inferring + checking types;
/// `annotate_*` writes the inferred types back into SExpr.ty.
export fn typecheck_program(ids: List<StmtId>, type_reg: TypeRegistry, macro_origins: List<MacroFnOrigin>, store: NodeStore) -> TypeCheckResult {
    avra_ice_phase("typeck")
    // Per-pass wall-clock timings — emitted to stderr at the end
    // when AVRA_TIMINGS_TYPECK=1 is set, so kkgf can rank the
    // four typeck passes (collect / check / naming / annotate)
    // before optimising any one of them.
    let timings_on = avra_process_env_get("AVRA_TIMINGS_TYPECK") != ""
    let t_start = avra_uptime_ms()

    let tc0_pre = tc_new(type_reg, macro_origins, store)
    // Re-stamp registry ids on every nominal slot whose id=0.
    // Macro/comptime/monomorphizer-emitted AST nodes carry
    // parser-shape ValueTypes with id=0 even when the name IS
    // registered. The pre-stamp pass closes the gap so vtype_eq's
    // nominal arms hit the id-path for the common in-registry case
    // instead of the exact-name fallback. Residual id=0 nominals after
    // the stamp pass are type-param placeholders (T, U, S, …) —
    // legitimately id=0 because they aren't registered types.
    let stamped_stmts = stamp_ids_stmts(store, store.sstmts_of(ids), type_reg)
    // Unconditional invariant assertion: any id=0 nominal whose name
    // IS in the registry is a stamp-pass leak — codegen would fall
    // back to slower name lookup AND id-based equality would
    // mis-compare. Each leak surfaces as an F9999 (ICE) so a
    // downstream regression of any nominal-construction site (e.g.
    // resolve_vtype's Trait/Newtype branches, ctor-return synthesis,
    // a future ValueType variant added without registry plumbing)
    // fails compilation deterministically instead of corrupting
    // codegen silently.
    let tc0 = report_stamp_leaks(tc0_pre, stamped_stmts, type_reg)
    // Pass 1: collect declarations (types, enums, functions). The
    // single walk is order-sensitive — a Function whose return type
    // references an enum declared later in the AST will be registered
    // with the un-upgraded ValueType.Struct(name) instead of the
    // proper ValueType.Enum(name). Run a SECOND collect pass against
    // the now-complete registry to upgrade ret-type residue from the
    // first walk. Tracked under forge-crafting-intepreters-dnq4.
    let tc_first = collect_decls(tc0, store.sstmts_of(ids))
    let tc1 = tc_first with { fns: rewrite_fn_ret_tys(tc_first, tc_first.fns) }
    let t_collect = avra_uptime_ms()
    // Pass 2: check + annotate in one traversal.
    // check_stmt_ids validates types and accumulates errors in TC.bag.
    // annotate_stmt_ids stamps resolved types onto the expr rows (calls
    // check_expr internally for annotation, but since check_stmt_ids already
    // caught errors, the annotation pass just extracts types without
    // re-reporting).
    let tc2 = check_stmt_ids(tc1, ids)
    let t_check = avra_uptime_ms()
    // Pass 2.5: naming convention warnings
    let tc3 = check_naming_stmt_ids(tc2, ids)
    let t_naming = avra_uptime_ms()
    // Pass 3: annotate AST — uses fast paths for leaf expressions
    let annotated = annotate_stmt_ids(tc3, ids)
    let t_annotate = avra_uptime_ms()
    if timings_on {
        eprintln("[timings:typeck] collect=${string(t_collect - t_start)}ms check=${string(t_check - t_collect)}ms naming=${string(t_naming - t_check)}ms annotate=${string(t_annotate - t_naming)}ms total=${string(t_annotate - t_start)}ms")
    }
    // Hand mono + codegen the stamped form. Typeck itself ran
    // on the parser-shape AST (changing inputs mid-pipeline broke
    // shard linkage in earlier iterations — codegen looks up types
    // by name and the rebuild was load-bearing somewhere subtle).
    // Stamping AFTER annotation keeps the typeck-internal registries
    // unchanged while still letting downstream stages see the
    // resolved ids.
    let stamped_final = stamp_ids_stmt_ids(tc3.nodes, annotated, type_reg)
    // TypeCheckResult.stmts stays List<SStmt> until the mono/codegen seam
    // flips — one sstmts_of adapter here keeps every downstream consumer
    // (monomorphize + the check result structs) untouched.
    TypeCheckResult { stmts: tc3.nodes.sstmts_of(stamped_final), had_error: bag_has_errors(tc3.bag), bag: tc3.bag, trait_impls: tc3.trait_impls }
}

/// Names of registered nominals (struct/enum/newtype) that still
/// appear with id=0 in `stmts`. An empty list is the invariant the
/// typeck id-stamp pass is supposed to maintain: every nominal
/// reference whose name is in the TypeRegistry should carry its
/// non-zero TypeRegistry id, not the parser-shape 0 sentinel.
///
/// Non-empty means the stamp pass missed something — codegen will
/// fall back to the slower name-based lookup, and any caller doing
/// id-based equality will mis-compare. Used by spec tests to assert
/// the invariant directly against the post-typecheck AST.
///
/// Type-param placeholders (T, U, S, …) are NOT registered, so they
/// stay id=0 and don't appear here. This function exclusively
/// surfaces registered-name leaks.
export fn unstamped_registered_nominals(store: NodeStore, stmts: List<SStmt>, reg: TypeRegistry) -> List<string> {
    let empty: List<string> = []
    let id_zero_names = collect_id_zero_names_stmts(store, stmts, empty)
    mut out: List<string> = []
    mut i = 0
    while i < id_zero_names.length {
        let name = id_zero_names[i]
        if type_registry_has_name(reg, name) { out.push(name) }
        i = i + 1
    }
    out
}

/// Append one F9999 (ICE) diagnostic per stamp-pass leak to `tc.bag`
/// and return the updated TC. Empty result list = no leaks, TC
/// unchanged. Used right after the typeck-entry stamp pass so any
/// id=0 leak fails compilation deterministically — the alternative
/// is silent codegen corruption (name-based fallback lookup) and
/// id-based equality mis-comparison.
fn report_stamp_leaks(tc: TC, stamped: List<SStmt>, reg: TypeRegistry) -> TC {
    let leaks = unstamped_registered_nominals(tc.nodes, stamped, reg)
    if leaks.length == 0 { return tc }
    mut cur = tc
    mut i = 0
    while i < leaks.length {
        let name = leaks[i]
        cur = tc_report(cur, DiagCode.ICE,
            "typeck id-stamp pass leaked a registered nominal `${name}` (id=0 after stamp). "
            + "Codegen would fall back to name-lookup and id-equality would mis-compare. "
            + "Likely cause: a ValueType construction site (resolve_vtype Trait/Newtype, "
            + "ctor-return synthesis, or a new variant added without registry plumbing) "
            + "produced an id=0 nominal for a name that IS in the TypeRegistry. "
            + "See `unstamped_registered_nominals` in @std.avrac.typeck.")
        i = i + 1
    }
    cur
}

// ── Pass 1: Declaration collection ──

// Resolve type operator fields (without/only) against the struct registry.
/// Resolve `type Foo = TypeOp(Bar)`-shaped declarations: a field
/// list that's actually a request to compose another struct's
/// fields. Inlines the resolved fields so downstream typecheck
/// sees a flat shape.
fn tc_resolve_type_operator(fields: List<FieldEntry>, reg: StructTypeReg) -> List<FieldEntry> {
    // Same sentinel-prefixed shape as codegen-side
    // `resolve_type_operator` — [__base(base_vt), __without|__only,
    // names...] — see that function for the layout's origin.
    if fields.length < 2 { return fields }
    let head = fields[0]
    if head.name != "__base" { return fields }
    let base_name = vtype_struct_name(head.resolved)
    let op_marker = fields[1].name
    mut excluded: List<FieldEntry> = []
    mut i = 2
    while i < fields.length {
        excluded.push(fields[i])
        i = i + 1
    }
    let base_fields = struct_type_lookup(reg, base_name)
    if op_marker == "__without" { return filter_fields_without(base_fields, excluded) }
    if op_marker == "__only" { return filter_fields_only(base_fields, excluded) }
    base_fields
}

// field_list_has, filter_fields_without, filter_fields_only now in core/ast.av

/// Pre-pass: register every declaration into the right TC table
/// (struct, enum, trait, impl, fn signature, ...) before the main
/// check walks the bodies. Lets bodies forward-reference any
/// declaration regardless of source order.
/// dkfa: a registry hit alone isn't enough to flag a duplicate.
/// Bundling re-registers the SAME qualified name (e.g.
/// `gen_test::gen::GenStubResult`) when the same source file is
/// loaded under different module paths — that's a bundling
/// artifact, not a user error. The `::` check filters those out.
/// The Result-intrinsic-vs-stdlib conflict that motivated the
/// earlier `is_intrinsic_name` hack is now fixed at the source:
/// inject_intrinsics runs AFTER module resolution so it can see
/// the stdlib's Result and skip the synthetic.
fn is_duplicate_decl(idx: ptr, name: string) -> bool {
    if avra_map_has_cstr(idx, name) == 0 { return false }
    !string_contains_qualifier(name)
}

/// True iff `name` contains `::` — Avra's module-qualifier
/// separator. Used as the gate for dkfa's diagnostic.
fn string_contains_qualifier(name: string) -> bool {
    mut i = 0
    while i + 1 < name.length {
        if name.substring(i, i + 2) == "::" { return true }
        i = i + 1
    }
    false
}

/// True when `name` is already declared as a nominal type-kind in this module —
/// a struct/shape (`structs.idx`), an enum (`enums.idx`), or a newtype
/// (`newtypes.idx`). A type name is one nominal identity, so a SECOND declaration
/// under a DIFFERENT kind (`enum Color` after `type Color = {...}`) is a
/// cross-kind collision: every kind shares the one TypeRegistry id space, which
/// collapses duplicates first-write-wins, and `vtype_eq` then compares the two as
/// EQUAL — so a value of one kind flows into the other's slot and runs to garbage.
/// Each kind registers into its own index, so all three are checked here for the
/// collision to be caught whichever kind is declared first (e.g. `newtype Id` then
/// `enum Id`, where the enum-side arm must still see the newtype). Honors the dkfa
/// `::`-qualifier exemption (bundling re-registers the same qualified cross-module
/// name under each path it loads, which is not a user error).
fn is_duplicate_type_name(cur: TC, name: string) -> bool {
    is_duplicate_decl(cur.structs.idx, name)
        || is_duplicate_decl(cur.enums.idx, name)
        || is_duplicate_decl(cur.newtypes.idx, name)
        || is_duplicate_decl(cur.union_aliases.idx, name)
}

fn collect_decls(tc: TC, stmts: List<SStmt>) -> TC {
    mut cur = tc
    for ss in stmts {
        cur = match stmt_unwrap(tc.nodes, ss.node) {
            .TypeDecl(name, tp, fields) -> {
                if is_duplicate_type_name(cur, name) {
                    tc_report_at(cur, DiagCode.DuplicateDecl, "duplicate type declaration `${name}`", ss.line, ss.col, name.length)
                } else {
                    let resolved = tc_resolve_type_operator(fields, cur.structs)
                    cur with { structs: struct_type_reg_register(cur.structs, name, tp, resolved) }
                }
            }
            .NewtypeDecl(name, inner_vt) -> {
                if is_duplicate_type_name(cur, name) {
                    tc_report_at(cur, DiagCode.DuplicateDecl, "duplicate type declaration `${name}`", ss.line, ss.col, name.length)
                } else {
                    let inner_ty = resolve_vtype(cur, inner_vt)
                    let ctor_params: List<ParamEntry> = [ParamEntry { name: "value", vtype: inner_ty }]
                    cur with {
                        newtypes: newtype_reg_register(cur.newtypes, name, inner_vt),
                        fns: fn_type_reg_register(cur.fns, name, empty_type_params(), ctor_params, ValueType.Newtype(name, inner_ty, type_registry_id_for(cur.type_reg, name)), false),
                    }
                }
            }
            .UnionAliasDecl(name, type_vt) -> {
                if is_duplicate_type_name(cur, name) {
                    tc_report_at(cur, DiagCode.DuplicateDecl, "duplicate type declaration `${name}`", ss.line, ss.col, name.length)
                } else {
                    cur with { union_aliases: union_alias_reg_register(cur.union_aliases, name, type_vt) }
                }
            }
            .ShapeDecl(name, fields) -> {
                if is_duplicate_type_name(cur, name) {
                    tc_report_at(cur, DiagCode.DuplicateDecl, "duplicate type declaration `${name}`", ss.line, ss.col, name.length)
                } else {
                    cur with {
                        structs: struct_type_reg_register(cur.structs, name, empty_type_params(), fields),
                        shapes: list_push_copy(cur.shapes, name),
                    }
                }
            }
            .EnumDecl(name, tp, variants) -> {
                if is_duplicate_type_name(cur, name) {
                    tc_report_at(cur, DiagCode.DuplicateDecl, "duplicate enum declaration `${name}`", ss.line, ss.col, name.length)
                } else {
                    cur with { enums: enum_type_reg_register(cur.enums, name, tp, variants) }
                }
            }
            .Function(name, tp, params, ret_vt, _) -> {
                let final_ret = if vtype_eq(ret_vt, .Void) { ValueType.Void } else { resolve_vtype(cur, ret_vt) }
                // Reusing an extern's name for a normal fn would re-register
                // the entry with is_extern=false, silently flipping provenance
                // (the reverse of the .ExternFn case below). Reject the mix so
                // the fn-param layout gate always sees the right regime. A
                // normal re-declaration (prior also normal — inlined modules)
                // stays allowed: the guard only fires when the prior was extern.
                let prior = fn_type_get(cur.fns, name)
                if prior.found && prior.is_extern {
                    tc_report_at(cur, DiagCode.DuplicateDecl,
                        "`${name}` is already declared as an extern fn; a normal fn cannot reuse that name",
                        ss.line, ss.col, name.length)
                } else {
                    cur with { fns: fn_type_reg_register(cur.fns, name, tp, params, final_ret, false) }
                }
            }
            .ExternFn(name, params, ret_vt) -> {
                let final_ret = if vtype_eq(ret_vt, .Void) { ValueType.Void } else { resolve_vtype(cur, ret_vt) }
                // Re-declaring an extern with the SAME signature is
                // normal (inlined support files and test modules each
                // carry their own decls; they converge on one symbol).
                // A CONFLICTING signature is a user error that must be
                // reported here — left undiagnosed it reaches codegen's
                // symbol table as two types for one name, which is an
                // ICE-grade abort there.
                let prior = fn_type_get(cur.fns, name)
                if prior.found && !prior.is_extern {
                    // A prior NORMAL fn: registering as extern (is_extern=true)
                    // would flip the entry so the normal fn's later calls use
                    // the extern carve-out and skip the collection→scalar check.
                    tc_report_at(cur, DiagCode.DuplicateDecl,
                        "extern `${name}` conflicts with a prior normal fn of the same name",
                        ss.line, ss.col, name.length)
                } else if prior.found && !extern_sig_matches(prior, params, final_ret) {
                    tc_report_at(cur, DiagCode.DuplicateDecl,
                        "extern `${name}` redeclared with a conflicting signature: ${render_extern_sig(params, final_ret)} (previously ${render_extern_sig(prior.params, prior.ret_ty)})",
                        ss.line, ss.col, name.length)
                } else {
                    cur with { fns: fn_type_reg_register(cur.fns, name, empty_type_params(), params, final_ret, true) }
                }
            }
            .Impl(impl_name, methods) -> {
                let colon_idx = find_trait_separator(impl_name)
                let with_impl = if colon_idx >= 0 {
                    let trait_name = impl_name.substring(0, colon_idx)
                    let type_name = impl_name.substring(colon_idx + 1, impl_name.length)
                    let with_trait = cur with { trait_impls: list_push_copy(cur.trait_impls, TraitImplEntry { trait_name, type_name }) }
                    // Collect associated type definitions: `type Item = ConcreteType`
                    collect_impl_assoc_types(with_trait, type_name, tc.nodes.sstmts_of(methods))
                } else { cur }
                collect_decls(with_impl, tc.nodes.sstmts_of(methods))
            }
            .Module(_, body) -> collect_decls(cur, tc.nodes.sstmts_of(body))
            .TraitDecl(name, methods) -> cur with {
                traits: trait_registry_register(cur.traits, name, collect_method_names_from_stmts(tc.nodes.sstmts_of(methods)), collect_assoc_types_from_stmts(tc.nodes.sstmts_of(methods)))
            }
            _ -> cur
        }
    }
    cur
}

// Collect associated type definitions from an impl block.
// `type Item = ConcreteType` → store "TypeName.Item" → ConcreteType vtype in assoc_type_defs.
/// Walk an impl block to register its `type AssocName = Concrete`
/// definitions into `tc.assoc_type_defs`.
fn collect_impl_assoc_types(tc: TC, type_name: string, stmts: List<SStmt>) -> TC {
    mut cur = tc
    for ss in stmts {
        cur = match ss.node {
            .AssocType(name, ty_vt) -> {
                if !vtype_is_unknown(ty_vt) {
                    let key = "${type_name}.${name}"
                    let self_key = "Self.${name}"
                    let step1 = list_push_copy(cur.assoc_type_defs, AssocTypeEntry { key, concrete_vt: ty_vt })
                    cur with { assoc_type_defs: list_push_copy(step1, AssocTypeEntry { key: self_key, concrete_vt: ty_vt }) }
                } else { cur }
            }
            _ -> cur
        }
    }
    cur
}

/// Re-resolve every FnTypeEntry's ret_ty AND param types against the
/// now-complete `tc.enums` / `tc.structs` / `tc.traits` registries.
/// Used as the second collect pass to upgrade ValueType.Struct
/// residue from the first walk into the proper ValueType.Enum /
/// .Newtype / .Trait variant when the trait/enum/newtype declaration
/// came AFTER the fn that referenced it.
///
/// Both ret_ty and params need this — params are seen on every method
/// dispatch (`e: TraitName` won't dispatch as a trait until upgraded)
/// and ret_ty is seen at every call site (F1000 type-identity
/// errors).
///
/// Tracked under forge-crafting-intepreters-dnq4.
fn rewrite_fn_ret_tys(tc: TC, fns: FnTypeReg) -> FnTypeReg {
    mut out = fn_type_reg_new()
    mut i = 0
    while i < fns.ord.length {
        let m = fns.ord[i]
        let upgraded_ret = if vtype_eq(m.ret_ty, .Void) { m.ret_ty } else { resolve_vtype(tc, m.ret_ty) }
        let upgraded_params = rewrite_param_list_vts(tc, m.params)
        out = fn_type_reg_register(out, m.name, m.tp, upgraded_params, upgraded_ret, m.is_extern)
        i = i + 1
    }
    out
}

/// Map `resolve_vtype` over each `ParamEntry`'s declared type.
fn rewrite_param_list_vts(tc: TC, params: List<ParamEntry>) -> List<ParamEntry> {
    list_map(params, (p: ParamEntry) -> ParamEntry {
        name: p.name,
        vtype: if vtype_is_unknown(p.vtype) { p.vtype } else { resolve_vtype(tc, p.vtype) },
    })
}

// ── Pass 2: Statement checking ──

/// Type-check every statement in a list, threading the TC.
export fn check_stmts(tc: TC, stmts: List<SStmt>) -> TC {
    mut cur = lint_index_loops(tc, stmts)
    for ss in stmts {
        avra_ice_at(ss.file, ss.line, ss.col)
        let with_pos = cur with { current_line: ss.line, current_col: ss.col }
        cur = check_stmt(with_pos, ss.node)
    }
    cur
}

/// Row-list twin of `check_stmts` for flipped bodies — positions come
/// from the store's position column.
export fn check_stmt_ids(tc: TC, ids: List<StmtId>) -> TC {
    mut cur = lint_index_loops(tc, tc.nodes.sstmts_of(ids))
    for id in ids {
        let pos = tc.nodes.stmt_pos(id)
        avra_ice_at(pos.file, pos.line, pos.col)
        let with_pos = cur with { current_line: pos.line, current_col: pos.col }
        cur = check_stmt(with_pos, tc.nodes.stmts.get(id))
    }
    cur
}

/// True when `e` is the integer literal 0 (the `mut i = 0` seed).
fn lint_expr_is_zero(e: Expr) -> bool {
    match e { .Number(v) -> v == "0", _ -> false }
}

/// If `cond` is `i < <coll>.length`, return the collection's name;
/// otherwise "". Conservative — only the canonical index-loop guard.
fn lint_index_guard_coll(store: NodeStore, cond: Expr) -> string {
    match cond {
        .Binary(left, op, right) -> match op {
            .Lt -> match store.exprs.get(left) {
                .Ident(ln) -> if ln != "i" { "" } else {
                    match store.exprs.get(right) {
                        .FieldAccess(obj, field) -> if field != "length" { "" } else {
                            match store.exprs.get(obj) { .Ident(n) -> n, _ -> "" }
                        }
                        _ -> ""
                    }
                }
                _ -> ""
            }
            _ -> ""
        }
        _ -> ""
    }
}

/// Two structural signals collected while walking a loop body for the
/// F9005 index+element lint: whether `i` is used as a value (beyond a
/// bare `coll[i]` subscript), and whether the body indexes the guarded
/// collection as `coll[i]`. The antipattern requires BOTH — that's the
/// shape `for (i, x) in coll.enumerate()` was built to replace. An
/// element-only loop (no value-use of `i`) or a loop that never
/// subscripts `coll` is deliberately left alone.
type LintSig = { value_i: bool, elem: bool }

fn lint_sig_none() -> LintSig { LintSig { value_i: false, elem: false } }

fn lint_sig_or(a: LintSig, b: LintSig) -> LintSig {
    LintSig { value_i: a.value_i || b.value_i, elem: a.elem || b.elem }
}

/// Fold the signals over a list of expressions (call args, tuple /
/// list elements, …).
fn lint_scan_sexprs(store: NodeStore, xs: List<SExpr>, coll: string) -> LintSig {
    mut acc = lint_sig_none()
    for x in xs { acc = lint_sig_or(acc, lint_scan_expr(store, x.node, coll)) }
    acc
}

/// Fold the signals over a statement list (block body).
fn lint_scan_sstmts(store: NodeStore, xs: List<SStmt>, coll: string) -> LintSig {
    mut acc = lint_sig_none()
    for x in xs { acc = lint_sig_or(acc, lint_scan_stmt(store, x.node, coll)) }
    acc
}

/// Fold the signals over a flipped body's rows.
fn lint_scan_stmt_ids(store: NodeStore, ids: List<StmtId>, coll: string) -> LintSig {
    mut acc = lint_sig_none()
    for id in ids { acc = lint_sig_or(acc, lint_scan_stmt(store, store.stmts.get(id), coll)) }
    acc
}

/// Fold the signals over match arms (guard + body, both SExpr).
fn lint_scan_arms(store: NodeStore, arms: List<MatchArm>, coll: string) -> LintSig {
    mut acc = lint_sig_none()
    for a in arms {
        if a.guard_id != null { acc = lint_sig_or(acc, lint_scan_expr(store, store.exprs.get(a.guard_id!), coll)) }
        acc = lint_sig_or(acc, lint_scan_expr(store, store.exprs.get(a.body_id), coll))
    }
    acc
}

/// Walk an expression collecting the two F9005 signals. The `coll[i]`
/// Index node is special-cased: it sets `elem` but the `i` in the
/// subscript does NOT count as a value-use (otherwise every element
/// access would look like index+element).
fn lint_scan_expr(store: NodeStore, e: Expr, coll: string) -> LintSig {
    match e {
        .Ident(n) -> LintSig { value_i: n == "i", elem: false }
        .Index(obj, idx) -> {
            let obj_e = store.exprs.get(obj)
            let idx_e = store.exprs.get(idx)
            let o = lint_scan_expr(store, obj_e, coll)
            let obj_is_coll = match obj_e { .Ident(c) -> c == coll, _ -> false }
            let idx_is_i = match idx_e { .Ident(x) -> x == "i", _ -> false }
            if obj_is_coll && idx_is_i {
                LintSig { value_i: o.value_i, elem: true }
            } else {
                lint_sig_or(o, lint_scan_expr(store, idx_e, coll))
            }
        }
        .Assign(_, value) -> lint_scan_expr(store, store.exprs.get(value), coll)
        .Grouping(inner) -> lint_scan_expr(store, store.exprs.get(inner), coll)
        .Unary(_, right) -> lint_scan_expr(store, store.exprs.get(right), coll)
        .Binary(left, _, right) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(left), coll), lint_scan_expr(store, store.exprs.get(right), coll))
        .Logical(left, _, right) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(left), coll), lint_scan_expr(store, store.exprs.get(right), coll))
        .Call(callee, args) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(callee), coll), lint_scan_sexprs(store, store.sexprs_of(args), coll))
        .GenericCall(callee, _, args) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(callee), coll), lint_scan_sexprs(store, store.sexprs_of(args), coll))
        .FieldAccess(obj, _) -> lint_scan_expr(store, store.exprs.get(obj), coll)
        .EnumCtor(_, _, args) -> lint_scan_sexprs(store, store.sexprs_of(args), coll)
        .Block(body) -> lint_scan_stmt_ids(store, body, coll)
        .MatchExpr(subject, arms) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(subject), coll), lint_scan_arms(store, arms, coll))
        .FieldAssign(obj, _, value) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(obj), coll), lint_scan_expr(store, store.exprs.get(value), coll))
        .IfExpr(c, t, el) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(c), coll), lint_sig_or(lint_scan_expr(store, store.exprs.get(t), coll), lint_scan_expr(store, store.exprs.get(el), coll)))
        .NullCoalesce(left, right) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(left), coll), lint_scan_expr(store, store.exprs.get(right), coll))
        .OptionalChain(obj, _) -> lint_scan_expr(store, store.exprs.get(obj), coll)
        .OptionalMethodCall(obj, _, args) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(obj), coll), lint_scan_sexprs(store, store.sexprs_of(args), coll))
        .Try(inner) -> lint_scan_expr(store, store.exprs.get(inner), coll)
        .Tuple(els) -> lint_scan_sexprs(store, store.sexprs_of(els), coll)
        .TupleIndex(obj, _) -> lint_scan_expr(store, store.exprs.get(obj), coll)
        .With(obj, _) -> lint_scan_expr(store, store.exprs.get(obj), coll)
        .ListLit(els) -> lint_scan_sexprs(store, store.sexprs_of(els), coll)
        .Lambda(_, body) -> lint_scan_expr(store, store.exprs.get(body), coll)
        .MapLit(entries) -> lint_scan_sexprs(store, store.sexprs_of(entries), coll)
        .Slice(obj, start, end) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(obj), coll), lint_sig_or(lint_scan_expr(store, store.exprs.get(start), coll), lint_scan_expr(store, store.exprs.get(end), coll)))
        .IsCheck(subject, _) -> lint_scan_expr(store, store.exprs.get(subject), coll)
        .InCheck(needle, items) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(needle), coll), lint_scan_sexprs(store, store.sexprs_of(items), coll))
        _ -> lint_sig_none()
    }
}

/// Walk a statement collecting the two F9005 signals. The `i = …`
/// increment is skipped entirely — its RHS reads `i` but that is the
/// loop's own bookkeeping, not a value-use of the index.
fn lint_scan_stmt(store: NodeStore, s: Stmt, coll: string) -> LintSig {
    match s {
        .Expr(inner_id) -> {
            let inner = store.exprs.get(inner_id)
            match inner {
                .Assign(n, _) -> if n == "i" { lint_sig_none() } else { lint_scan_expr(store, inner, coll) }
                _ -> lint_scan_expr(store, inner, coll)
            }
        }
        .Let(_, _, init) -> lint_scan_expr(store, store.exprs.get(init), coll)
        .Mut(_, _, init) -> lint_scan_expr(store, store.exprs.get(init), coll)
        .Const(_, _, init) -> lint_scan_expr(store, store.exprs.get(init), coll)
        .LetDestructure(_, init) -> lint_scan_expr(store, store.exprs.get(init), coll)
        .Return(value) -> lint_scan_expr(store, store.exprs.get(value), coll)
        .Block(body) -> lint_scan_stmt_ids(store, body, coll)
        .If(c, t, el) -> {
            let base = lint_sig_or(lint_scan_expr(store, store.exprs.get(c), coll), lint_scan_stmt(store, store.stmts.get(t), coll))
            if el != null { lint_sig_or(base, lint_scan_stmt(store, store.stmts.get(el!), coll)) } else { base }
        }
        .While(c, body) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(c), coll), lint_scan_stmt(store, store.stmts.get(body), coll))
        .For(_, start, end, body) -> lint_sig_or(lint_sig_or(lint_scan_expr(store, store.exprs.get(start), coll), lint_scan_expr(store, store.exprs.get(end), coll)), lint_scan_stmt(store, store.stmts.get(body), coll))
        .ForIn(_, c, body) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(c), coll), lint_scan_stmt(store, store.stmts.get(body), coll))
        .Match(subject, arms) -> lint_sig_or(lint_scan_expr(store, store.exprs.get(subject), coll), lint_scan_arms(store, arms, coll))
        .Defer(body) -> lint_scan_expr(store, store.exprs.get(body), coll)
        .Errdefer(body) -> lint_scan_expr(store, store.exprs.get(body), coll)
        _ -> lint_sig_none()
    }
}

/// How a loop steps `i`: `total` counts every `i = …` reassignment,
/// `unit` counts only the canonical `i = i + 1`. The antipattern needs
/// `total == 1 && unit == 1` — exactly one unit step. A stride-2 walk
/// (`i = i + 2`, pairwise key/value scan) has total 1 / unit 0; a
/// conditional double-step has total 2 — both are too subtle to
/// mechanically rewrite as `enumerate()`, so the lint stays silent.
type LintStep = { total: int, unit: int }

fn lint_step_none() -> LintStep { LintStep { total: 0, unit: 0 } }

fn lint_step_add(a: LintStep, b: LintStep) -> LintStep {
    LintStep { total: a.total + b.total, unit: a.unit + b.unit }
}

/// True when `e` is `i + 1` (the unit-step RHS).
fn lint_is_unit_step(store: NodeStore, e: Expr) -> bool {
    match e {
        .Binary(left, op, right) -> match op {
            .Add -> {
                let l_is_i = match store.exprs.get(left) { .Ident(n) -> n == "i", _ -> false }
                let r_is_one = match store.exprs.get(right) { .Number(v) -> v == "1", _ -> false }
                l_is_i && r_is_one
            }
            _ -> false
        }
        _ -> false
    }
}

fn lint_step_count(store: NodeStore, s: Stmt) -> LintStep {
    match s {
        .Expr(inner_id) -> match store.exprs.get(inner_id) {
            .Assign(n, v) -> if n == "i" {
                LintStep { total: 1, unit: if lint_is_unit_step(store, store.exprs.get(v)) { 1 } else { 0 } }
            } else { lint_step_none() }
            _ -> lint_step_none()
        }
        .Block(body) -> {
            mut c = lint_step_none()
            for x in body { c = lint_step_add(c, lint_step_count(store, store.stmts.get(x))) }
            c
        }
        .If(_, t, el) -> lint_step_add(lint_step_count(store, store.stmts.get(t)), if el != null { lint_step_count(store, store.stmts.get(el!)) } else { lint_step_none() })
        .While(_, body) -> lint_step_count(store, store.stmts.get(body))
        .For(_, _, _, body) -> lint_step_count(store, store.stmts.get(body))
        .ForIn(_, _, body) -> lint_step_count(store, store.stmts.get(body))
        _ -> lint_step_none()
    }
}

/// F9005 lint: flag the manual `mut i = 0` / `while i < xs.length { … }`
/// index-loop antipattern when it is genuinely an *index+element* loop
/// over a `List`. To fire, the body must (1) read `i` as a value AND
/// (2) subscript `xs[i]`, (3) step `i` exactly once by one, and (4) walk
/// a `List` (the only thing `enumerate()` accepts — string scans index
/// `s[i]` too but cannot use it). That is precisely the shape
/// `for (i, x) in xs.enumerate()` replaces. Always on — a structural AST
/// walk (not a string heuristic). Element-only loops, string scans,
/// stride-N walks, and multi-step counters are deliberately untouched.
fn lint_index_loops(tc: TC, stmts: List<SStmt>) -> TC {
    mut cur = tc
    for (k, ss) in stmts.enumerate() {
        if k + 1 < stmts.length {
            match ss.node {
                .Mut(name, _, init) -> {
                    if name == "i" && lint_expr_is_zero(tc.nodes.exprs.get(init)) {
                        match stmts[k + 1].node {
                            .While(cond, body) -> {
                                let coll = lint_index_guard_coll(tc.nodes, tc.nodes.exprs.get(cond))
                                if coll != "" && vtype_is_list(type_lookup(cur.types, coll)) {
                                    let sig = lint_scan_stmt(tc.nodes, tc.nodes.stmts.get(body), coll)
                                    let step = lint_step_count(tc.nodes, tc.nodes.stmts.get(body))
                                    if sig.value_i && sig.elem && step.total == 1 && step.unit == 1 {
                                        cur = tc_warn(cur, DiagCode.ManualIndexLoop,
                                            "manual index loop over `${coll}` — use `for (i, x) in ${coll}.enumerate()`")
                                    }
                                }
                            }
                            _ -> {}
                        }
                    }
                }
                _ -> {}
            }
        }
    }
    cur
}

/// Bind a declaration, recording mutability so flow narrowing can
/// tell `mut` (reassignable → not narrowed in the variable form)
/// from `let`/`const`/params (immutable → safe to narrow).
fn bind_decl(tc: TC, name: string, ty: ValueType, is_mut: bool) -> TC {
    if is_mut { tc_bind_mut(tc, name, ty) } else { tc_bind(tc, name, ty) }
}

/// True when `t`'s LLVM layout is a pointer (a heap reference) rather than an
/// i64/double value scalar. A `Newtype` takes its underlying type's layout
/// (`type Id = int` is i64, not a ptr). `Unknown` / `Void` have no settled
/// layout — callers treat them as "no conflict". Mirrors the value model in
/// CLAUDE.md: `Int` / `Bool` / `Float` / sized ints are scalars; everything else
/// (`Str`, `Struct`, `Enum`, `List`, `Map`, `Optional`, …) is a ptr.
fn vtype_is_ptr_layout(t: ValueType) -> bool {
    match t {
        .Newtype(_, inner, _) -> vtype_is_ptr_layout(inner)
        .Int or .Bool or .Float or .U8 or .U16 or .U32 or .U64 or .I8 or .I16 or .I32 or .Unknown or .Void -> false
        _ -> true
    }
}

/// A layout-incompatible conflict: the two types land on opposite sides of the
/// scalar/pointer divide (one an i64/double, the other a heap ref). THIS is the
/// memory-unsafe case — codegen reads a scalar through a pointer slot (a wild
/// `inttoptr` deref) or a pointer through a scalar slot. `Unknown` (an
/// unresolved generic param, e.g. behind an empty collection) and `Void`
/// (`null`) are never a conflict; same-side mismatches (int↔bool, or two
/// different structs) share a layout and are tolerated here — a wrong nominal
/// type that shares a layout is caught downstream and can never wild-deref.
///
/// Optional is stripped from BOTH sides first: a value of type `T` widens into a
/// `T?` slot (codegen wraps it), so `int` vs `int?` is NOT a conflict — only the
/// underlying bases decide. `int` vs `string?` still conflicts (base `string` is
/// a pointer), mirroring `int_into_pointer_slot`, which strips Optional likewise.
fn layout_conflict(a: ValueType, b: ValueType) -> bool {
    let sa = vtype_strip_optional(a)
    let sb = vtype_strip_optional(b)
    if vtype_is_unknown(sa) || vtype_is_unknown(sb) { return false }
    if (sa is .Void) || (sb is .Void) { return false }
    vtype_is_ptr_layout(sa) != vtype_is_ptr_layout(sb)
}

/// True iff the SINGLE type node `x` is an unresolved nominal — a type parameter
/// that surfaces as `.Struct("T")` / `.Enum("T")` with no registry entry.
/// Registry membership is the single source of truth (mirrors resolve_vtype).
/// The per-node core shared by `vtype_mentions_unresolved` (whole tree) and
/// `top_level_layout_unresolved` (top node only).
fn vtype_node_unresolved(tc: TC, x: ValueType) -> bool {
    match x {
        .Struct(n, _, _) -> !struct_type_has(tc.structs, n) && !enum_type_has(tc.enums, n)
        .Enum(n, _, _) -> !enum_type_has(tc.enums, n) && !struct_type_has(tc.structs, n)
        _ -> false
    }
}

/// True if `t`'s type tree mentions a nominal that is NOT a registered struct or
/// enum — i.e. an unresolved type parameter, which surfaces as `.Struct("T")`.
/// The layout check below MUST skip such types: before monomorphization a param
/// `Box<T>` carries `T` as a nominal `vtype_is_ptr_layout` would call
/// pointer-shaped, so comparing it against a concrete `Box<int>` would wrongly
/// reject valid generic code (`fn id<T>(b: Box<T>)` called with `Box { val: 9 }`).
fn vtype_mentions_unresolved(tc: TC, t: ValueType) -> bool {
    t.any((x) -> vtype_node_unresolved(tc, x))
}

/// True iff the TOP-LEVEL layout of `t` is unknown — i.e. `t` itself (Optional
/// stripped) is an unresolved type parameter. Unlike `vtype_mentions_unresolved`
/// (whole tree), a resolved CONTAINER with unresolved args (`List<T>`) is NOT
/// top-level-unresolved: its layout (a pointer) is already known, so a top-level
/// scalar↔ptr conflict against it is real and must be caught.
fn top_level_layout_unresolved(tc: TC, t: ValueType) -> bool {
    vtype_node_unresolved(tc, vtype_strip_optional(t))
}

/// Layout conflict between two generic instances of the SAME nominal type:
/// their positional type-args straddle the scalar/pointer divide somewhere — the
/// memory-unsafe case, where reading one as the other derefs a scalar as a
/// pointer. Operates on already-typed values, so it catches the conflict at any
/// assignability site (call-arg / field-init / collection-element) where
/// `vtype_eq` short-circuits to "equal" because it deliberately ignores generic
/// args (that leniency is load-bearing for mono's name/id instance dedup, so it
/// can't be fixed there). Different nominals, or any `Unknown`/`Void` arg, are
/// never a conflict. Mutually recursive with `nested_layout_conflict`: this
/// function recurses into matching structure (containers / nominals / tuples),
/// and checks each aligned pair via `nested_layout_conflict` (top-level scalar↔ptr
/// OR deeper). A bare type param is skipped PER-PAIR (by the top-level guard
/// inside that predicate), NOT for the whole comparison — so `Pair<T, int>` vs
/// `Pair<T, string>` still flags the concrete `int`↔`string` pair while leaving
/// the `T`/`T` pair (unknown layout) alone.
export fn generic_args_layout_conflict(tc: TC, a: ValueType, b: ValueType) -> bool {
    // Recurse through matching List / Optional shells (their element type isn't a
    // generic arg `vtype_type_args` exposes) so a conflict nested in a container
    // field/arg (`List<Box<int>>` vs `List<Box<string>>`) is caught too.
    if (a is .List) && (b is .List) {
        return nested_layout_conflict(tc, vtype_list_elem(a), vtype_list_elem(b))
    }
    // Maps carry key+value types that `vtype_type_args` doesn't expose either, so
    // recurse through a matching `Map` shell — catches a conflict nested in a map
    // value (`Map<string, Box<int>>` vs `Map<string, Box<string>>`, 63wu) the same
    // way the List branch handles list elements.
    if (a is .Map) && (b is .Map) {
        return nested_layout_conflict(tc, vtype_map_key(a), vtype_map_key(b)) ||
               nested_layout_conflict(tc, vtype_map_value(a), vtype_map_value(b))
    }
    // Tuples carry element types `vtype_type_args` doesn't expose, so recurse
    // pairwise. Without this, ANY layout conflict is bypassed by tuple-wrapping —
    // even a bare scalar↔ptr: `let t: (int, string) = (1, 9)` would store int 9
    // in the string slot (a wild pointer read) yet compile clean.
    if (a is .Tuple) && (b is .Tuple) {
        return type_list_layout_conflict(tc, vtype_tuple_elems(a), vtype_tuple_elems(b))
    }
    // Nullable widening: a value of type `T` satisfies an expected `T?`, so a
    // real conflict can hide under a ONE-SIDED Optional (a `Box<int>` value into
    // a `Box<string>?` slot — same pointer-niche layout, but the inner field is
    // int-vs-ptr). Strip Optional from whichever side carries it and compare the
    // inner types: `T` conflicts with `U?` exactly when `T` conflicts with `U`.
    // Catches the nullable container-value hole uniformly for List elements, Map
    // values, and struct fields. (The top-level annotation's own Optional is
    // already stripped by check_expr_expected; this covers the nested ones.)
    if (a is .Optional) || (b is .Optional) {
        return nested_layout_conflict(tc, vtype_strip_optional(a), vtype_strip_optional(b))
    }
    let na = vtype_nominal_name(a)
    if na == "" || na != vtype_nominal_name(b) { return false }
    type_list_layout_conflict(tc, vtype_type_args(a), vtype_type_args(b))
}

/// Pairwise layout-conflict over two type lists — nominal generic args or tuple
/// elements: a settled scalar↔ptr mismatch OR a deeper nested conflict in any
/// aligned pair. Length-tolerant (compares the shorter arity).
fn type_list_layout_conflict(tc: TC, aa: List<ValueType>, ba: List<ValueType>) -> bool {
    let n = if aa.length < ba.length { aa.length } else { ba.length }
    mut i = 0
    while i < n {
        if nested_layout_conflict(tc, aa[i], ba[i]) { return true }
        i = i + 1
    }
    false
}

/// THE layout-conflict check between two types — a top-level scalar↔ptr conflict
/// OR one nested anywhere deeper. Mutually recursive with
/// `generic_args_layout_conflict`: this is the per-PAIR step (it recurses into
/// matching structure). It is also the public broad gate for a value flowing into
/// a RELIABLE element / value / payload slot (list element, map value, …) — so
/// those checkers call it directly instead of hand-wrapping a `List`/`Map` shell.
///
/// Broader than the narrow `assign_layout_conflict`: `layout_conflict` is the
/// FULL scalar↔ptr divide (int→struct/list too, not just int→Str), safe HERE
/// because these positions hold explicitly-written values rather than the
/// inference-artifact `.Int` fallbacks that force the narrow scoping at the
/// binding / return / call positions.
export fn nested_layout_conflict(tc: TC, a: ValueType, b: ValueType) -> bool {
    top_level_settled_layout_conflict(tc, a, b) || generic_args_layout_conflict(tc, a, b)
}

/// `layout_conflict` gated only on the operands' TOP-LEVEL resolution — NOT the
/// whole tree. A WHOLE-tree guard bails whenever any nested arg mentions an
/// unbound `T`, which would let a SETTLED top-level conflict slip when only a
/// nested arg is unresolved (`List<T>` — a known pointer — flowing into an `int`
/// slot; `generic_args_layout_conflict` can't see that either, since List-vs-Int
/// isn't a matching shell). Guarding on the top node alone catches it while still
/// skipping a bare `T` whose layout is genuinely unknown, so valid generic code
/// stays clean. (`vtype_mentions_unresolved` is the whole-tree predicate, kept for
/// the narrow int→pointer / collection→scalar checks where it is the right scope.)
fn top_level_settled_layout_conflict(tc: TC, a: ValueType, b: ValueType) -> bool {
    if top_level_layout_unresolved(tc, a) || top_level_layout_unresolved(tc, b) { return false }
    layout_conflict(a, b)
}

/// When `expr` is a generic struct literal `Name { … }` and `declared` is an
/// annotation `Name<args>` (a `let`/`mut`/`const` binding OR a function's
/// declared return type), return the literal's field-inferred type (so the
/// caller can render `Name<int>` against the annotation) IF a field's value type
/// conflicts — layout-incompatibly — with the annotation's generic argument.
/// Otherwise null.
///
/// Generic structs were never checked against their annotation (only
/// non-generic ones were, in `check_struct_lit_fields`) because `vtype_assignable`
/// doesn't compare generic-struct type args. So `let b: Box<string> = Box { val:
/// 9 }` — or `fn f() -> Box<string> { Box { val: 9 } }` — slips past typeck: the
/// literal infers `Box<int>`. Monomorphization then builds a layout-consistent
/// `Box<int>` value while the annotation/signature claims `Box<string>`, and a
/// reader of `b.val` loads the int through a string (ptr) slot — a wild pointer.
/// Catching the layout conflict here, at the universal expected-type entry
/// (`check_expr_expected`), turns that silent hole into a clean F1000 in EVERY
/// annotated position before mono runs.
fn generic_struct_annotation_conflict(tc: TC, declared: ValueType, expr: Expr) -> ValueType? {
    match expr {
        .StructLit(name, inits) if name != "" -> {
            // A generic annotation `Box<string>` lowers to Enum form, while the
            // literal is Struct form — `vtype_nominal_name` reads the name from
            // either, and `vtype_type_args` the args from either.
            if vtype_nominal_name(declared) != name { return null }
            let inferred = tc_infer_struct_type_args(tc, name, inits)
            let ann = vtype_type_args(declared)
            let n = if inferred.length < ann.length { inferred.length } else { ann.length }
            mut i = 0
            while i < n {
                let ai = inferred[i]
                let bi = ann[i]
                // Guard type params per-pair (the annotation may still mention one,
                // e.g. `let x: Box<T>` inside a generic fn), then catch a direct
                // scalar↔ptr split OR one nested inside a generic arg
                // (`Box<List<Box<int>>>` vs `Box<List<Box<string>>>`).
                let conflict = nested_layout_conflict(tc, ai, bi)
                if conflict {
                    return tc_struct_lit_vtype(tc, name, inits)
                }
                i = i + 1
            }
            null
        }
        _ -> null
    }
}

/// An int value bound to a STRING or BYTES slot is a wild store — the slot holds a
/// pointer, the int does not, so a reader derefs the int (e.g. `let y: string =
/// id(9)`, `let b: bytes = 9`). Strips Optional so `let x: int? = 9` (inner int)
/// is fine while `let x: string? = 9` (inner string) is flagged; an unresolved
/// type param (`fn id<T>(x: T)`) is excluded (no settled layout). int →
/// numeric/bool stays lenient.
///
/// SCOPED TO STRING/BYTES on purpose. Both are ALWAYS-EXPLICIT pointer types —
/// typeck never hands back `.Str`/`.Bytes` as an inference fallback (`bytes` ops
/// yield `.Bytes`, never `.Int`), so they share string's cleanliness. Generalizing
/// to the full `vtype_is_ptr_layout(inner)` (struct / list / map) false-positives
/// ~140× on the compiler's own source — NOT real wild stores but INFERENCE
/// ARTIFACTS: typeck returns `.Int` as a fallback for expressions that are actually
/// `List<int>` / `FnStats` / fn-typed (the "Int = unresolved inference" the
/// check_binding skip guards). Closing int→struct/list (w0kt) requires first
/// making inference return `.Unknown` (not `.Int`) for unresolved cases.
export fn int_into_pointer_slot(tc: TC, arg_ty: ValueType, declared: ValueType) -> bool {
    if !(arg_ty is .Int) { return false }
    let inner = vtype_strip_optional(declared)
    if vtype_mentions_unresolved(tc, inner) { return false }
    inner is .Str || inner is .Bytes
}

/// True iff `declared`, with its `Optional` stripped, is a CONCRETE value-scalar
/// slot (int/float/bool/u8-64/i8-32) — i.e. a cell that holds raw scalar bits, so
/// storing a pointer there is a layout lie. The `Optional` strip means `int?` is
/// still a scalar cell; an unresolved slot is skipped (a still-inferring type-param
/// is never proven a scalar). This is the shared SLOT half of the pointer→scalar
/// wild-store predicates below — each pairs it with its own ARG-shape guard.
fn slot_is_concrete_value_scalar(tc: TC, declared: ValueType) -> bool {
    let slot = vtype_strip_optional(declared)
    if vtype_mentions_unresolved(tc, slot) { return false }
    vtype_is_value_scalar(slot)
}

/// The inverse of `int_into_pointer_slot`: a COLLECTION value (a `List` / `Map`
/// literal — always a pointer) flowing into a value-scalar slot (int/float/bool/…)
/// is a wild store, a pointer stored in a scalar cell (`Map<string,int>.set(k, {…})`
/// stores a map ptr in an int slot; `List<int>.push([…])` likewise). Restricted to
/// List/Map args on purpose: it is the concrete "collection literal into a scalar
/// cell" case, which keeps the check free of false positives on `null`/`void`
/// (valid for nullable slots), `Optional` args, and newtype wrappers.
export fn collection_into_value_scalar_slot(tc: TC, arg_ty: ValueType, declared: ValueType) -> bool {
    if !((arg_ty is .List) || (arg_ty is .Map)) { return false }
    slot_is_concrete_value_scalar(tc, declared)
}

/// Sibling of `collection_into_value_scalar_slot`: a concrete ENUM value — always
/// the 16-byte `{tag, payload}`, pointer-passed — flowing into a value-scalar slot
/// (int/bool/float/…) is a wild store, a pointer stored in a scalar cell
/// (`let x: int = Wrap.W(…)`). Scoped to `.Enum` on purpose: an enum is never an
/// inference artifact and never a bare type-param (those are `.Struct`-form), so
/// this is false-positive-free — unlike a broad nominal check, which would flag a
/// `.Struct("T")` type-param that may instantiate to a scalar.
export fn enum_into_value_scalar_slot(tc: TC, arg_ty: ValueType, declared: ValueType) -> bool {
    if !(arg_ty is .Enum) || vtype_enum_name(arg_ty) == "" { return false }
    slot_is_concrete_value_scalar(tc, declared)
}

/// THE narrow wild-store layout-conflict predicate (nlzq). True iff storing a
/// value of type `actual` into a slot of declared type `expected` is a layout
/// lie: a generic-arg conflict (`Box<int>` vs `Box<string>`), an int into a
/// pointer slot (`incl_int`), or a `List`/`Map`/enum value into a value-scalar
/// slot (`incl_collection` — these pointer-into-scalar checks ride the same
/// toggle). Unions the wild-store checks that were hand-rolled, and individually
/// forgotten, across the binding / reassign / call / arg positions (the dominant
/// root cause behind the 63wu arc).
///
/// This is the NARROW family: the int / collection / enum checks are deliberately
/// scoped subsets (int→Str/Bytes only; List/Map/Enum arg only) because these
/// positions hold INFERENCE-ARTIFACT-prone values — typeck hands back `.Int` as
/// a fallback for ~140 unresolved exprs on the compiler's own source, so the
/// full scalar↔ptr divide (`layout_conflict`) would mass-false-positive here.
/// Reliable element / value / payload positions use the broad
/// `nested_layout_conflict` instead. The two toggles tune which subset a
/// position needs (both default on; see the three wrappers below).
///
/// The enum check rides `incl_collection` ON PURPOSE: extern C bindings declare
/// `int` for legacy pointer-ish slots that legitimately receive an enum too — the
/// compiler's own `avra_stmt_tag(stmt: int)` / `avra_expr_tag(expr: int)` are
/// called with `Stmt`/`Expr` enum values (C reads the {tag,…} payload). So the
/// extern-param carve-out (`incl_collection=false`) must drop the enum check as
/// well, exactly as it drops the List/Map check.
export fn assign_layout_conflict(tc: TC, actual: ValueType, expected: ValueType, incl_int: bool, incl_collection: bool) -> bool {
    generic_args_layout_conflict(tc, actual, expected)
        || (incl_int && int_into_pointer_slot(tc, actual, expected))
        || (incl_collection && collection_into_value_scalar_slot(tc, actual, expected))
        || (incl_collection && enum_into_value_scalar_slot(tc, actual, expected))
}

/// THE assignability gate (nlzq): the SINGLE place a "value meets an expected
/// type" wild-store check lives for the narrow family. Every artifact-prone
/// position that binds a value to a known type routes its `(actual, expected)`
/// pair through one of these three wrappers, so no position can omit a check —
/// collapsing the per-position hand-rolled checks and making the wild-store
/// class drift-proof. `ctx` names the position for the diagnostic. Returns `tc`
/// unchanged when the store is layout-safe.
///
/// The FULL gate — generic-arg + int→pointer + collection→scalar. Used at the
/// real typed value slots: reassignment and collection-mutation value args.
export fn check_assign_layout(tc: TC, actual: ValueType, expected: ValueType, ctx: string) -> TC {
    check_assign_layout_ex(tc, actual, expected, ctx, true, true)
}

/// The EXTERN-parameter variant: omits the collection/enum→scalar checks, which
/// mass-false-positive on extern C bindings that declare `int` as an i64-legacy
/// pointer-ish slot legitimately receiving a `List`/`Map` (`avra_map_set_cstr(map,
/// key, value: int)`) OR an enum (`avra_stmt_tag(stmt: int)` / `avra_expr_tag(expr:
/// int)`, called with `Stmt`/`Expr` enum values). Generic-arg + int→pointer still
/// apply. Used ONLY for params of `extern fn`s (gated on `FnTypeMeta.is_extern`); a
/// NORMAL Avra fn parameter is a real typed slot and gets the FULL
/// `check_assign_layout`, so `f([1])` into `f(x: int)` is rejected.
export fn check_assign_layout_param(tc: TC, actual: ValueType, expected: ValueType, ctx: string) -> TC {
    check_assign_layout_ex(tc, actual, expected, ctx, true, false)
}

/// The check_expr_expected variant: omits the int→pointer check. This gate feeds
/// the `let` site (where check_binding's int block catches int→pointer) and the
/// return site (where vtype_assignable catches it), so including int here would
/// DOUBLE-REPORT. Generic-arg + collection→scalar (neither caught at those
/// sites) still apply.
export fn check_assign_layout_no_int(tc: TC, actual: ValueType, expected: ValueType, ctx: string) -> TC {
    check_assign_layout_ex(tc, actual, expected, ctx, false, true)
}

fn check_assign_layout_ex(tc: TC, actual: ValueType, expected: ValueType, ctx: string, incl_int: bool, incl_collection: bool) -> TC {
    if assign_layout_conflict(tc, actual, expected, incl_int, incl_collection) {
        return tc_report(tc, DiagCode.TypeMismatch, "${ctx}: `${vtype_render_full(actual)}` is not assignable to `${vtype_render_full(expected)}` (layout conflict)")
    }
    tc
}

/// Type-check a `let` / `mut` / `const` binding: infer the
/// initializer's type, verify it matches any declared annotation,
/// and bind `name: type` into the env. `is_mut` distinguishes `mut`
/// from `let`/`const` for narrowing.
fn check_binding(tc: TC, name: string, ty_vt: ValueType, init: Expr, is_const: bool, is_mut: bool) -> TC {
    let has_annotation = !vtype_is_unknown(ty_vt)
    // so07.4 (T4): resolve the annotation BEFORE checking the init so
    // we can thread it as the expected type for ListLit-style literals.
    // Other Expr variants are unaffected — check_expr_expected falls
    // through to check_expr for them.
    let pre_declared = if has_annotation { resolve_vtype(tc, ty_vt) } else { ValueType.Unknown }
    // F1004: a bare/under-applied generic annotation (`let x: GenOpt = …`)
    // determines no layout — reject before it reaches codegen. (No enclosing
    // type params threaded to bindings; a type-param-shadowed local annotation
    // is the residual tracked under the totality lint.)
    let gated = if has_annotation { tc_check_type_applied(tc, pre_declared, empty_type_params()) } else { tc }
    let r = if has_annotation { check_expr_expected(gated, init, pre_declared) } else { check_expr(gated, init) }
    let declared_ty = if has_annotation { pre_declared } else { r.ty }
    // An int bound to a pointer-layout annotation is a wild store (ry1a/w0kt; see
    // int_into_pointer_slot). The everything-is-i64 leniency the `.Int` skip below
    // preserves for numeric coercion (`let x: u8 = 5`, `let x: float = 5`) must NOT
    // extend to string/struct/list slots. The return path already rejects this
    // (vtype_assignable); mirror it for the `let` site.
    if has_annotation && int_into_pointer_slot(r.tc, r.ty, declared_ty) {
        let msg = "type mismatch: expected `${vtype_render_full(declared_ty)}`, got `${vtype_render_full(r.ty)}`"
        return bind_decl(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty, is_mut)
    }
    // Type annotation mismatch: flag clear mismatches between primitive types.
    // Skip when RHS is Void (null), Int (unresolved inference), or Unknown.
    if has_annotation && !vtype_is_unknown(r.ty) && !vtype_is_unknown(declared_ty) && !(r.ty is .Void) && !(r.ty is .Int) {
        let mismatch = match declared_ty {
            .Int -> r.ty is .Str || r.ty is .Bool || r.ty is .Float
            .Str -> r.ty is .Int || r.ty is .Bool || r.ty is .Float
            .Bool -> r.ty is .Str || r.ty is .Float
            .Float -> r.ty is .Str || r.ty is .Bool
            _ -> false
        }
        if mismatch {
            let msg = "type mismatch: expected `${vtype_render_full(declared_ty)}`, got `${vtype_render_full(r.ty)}`"
            return bind_decl(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty, is_mut)
        }
    }
    // Note: a generic-struct-literal annotation conflict (`let b: Box<string> =
    // Box { val: 9 }`) is rejected centrally in `check_expr_expected` — the
    // `check_expr_expected(init, pre_declared)` call above already reported it
    // into `r.tc`, covering returns too (not just this binding site).
    if declared_ty is .Newtype && !(r.ty is .Newtype) && !(r.ty is .Unknown) {
        let msg = "cannot assign `${vtype_render_full(r.ty)}` to `${vtype_render_full(declared_ty)}` — use `${vtype_display(declared_ty)}(value)` constructor"
        return bind_decl(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty, is_mut)
    }
    if is_const && !is_const_expr(tc.nodes, init) {
        let msg = "`const` requires a compile-time constant expression (use `let` for runtime values)"
        return bind_decl(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty, is_mut)
    }
    // Shape subtyping: if declared type is a shape, check init value has required fields
    let after_shape = if has_annotation {
        tc_check_shape_compat(r.tc, vtype_struct_name(ty_vt), r.ty)
    } else { r.tc }
    bind_decl(after_shape, name, declared_ty, is_mut)
}

/// Type-check a single statement. Each variant routes to the
/// appropriate inference / verification path; declarations
/// recurse into their bodies and registries.
export fn check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Let(name, ty_vt, init) -> check_binding(tc, name, ty_vt, tc.nodes.exprs.get(init), false, false)
        .Mut(name, ty_vt, init) -> check_binding(tc, name, ty_vt, tc.nodes.exprs.get(init), false, true)
        .Const(name, ty_vt, init) -> check_binding(tc, name, ty_vt, tc.nodes.exprs.get(init), true, false)
        .Expr(e) -> {
            let r = check_expr(tc, tc.nodes.exprs.get(e))
            r.tc
        }
        .Return(value) -> {
            let r = check_expr(tc, tc.nodes.exprs.get(value))
            r.tc
        }
        .ReturnEmpty -> tc
        .Block(body) -> {
            let inner = tc_enter(tc)
            let checked = check_stmt_ids(inner, body)
            tc_exit(checked)
        }
        .Function(name, tp, params, ret_vt, body) -> {
            avra_ice_push_fn(name)
            let inner = tc_enter(tc) with { current_fn: name }
            let gated = tc_check_signature_arity(inner, params, ret_vt, tp)
            let with_params = tc_bind_params(gated, params)
            let checked = tc_check_fn_body(with_params, name, ret_vt, body)
            let result = tc_exit(checked)
            avra_ice_pop_fn()
            result
        }
        .Impl(impl_name, methods) -> {
            let after = check_stmt_ids(tc, methods)
            // Check trait conformance if this is `impl Trait for Type`
            // impl_name is "Trait:Type" or just "Type"
            check_trait_conformance(after, impl_name, tc.nodes.sstmts_of(methods))
        }
        .Module(_, body) -> check_stmt_ids(tc, body)
        .Annotated(_, inner) -> check_stmt(tc, tc.nodes.stmts.get(inner))
        // F1004: a stored field / variant payload / newtype inner is a
        // layout-determining position, so a bare generic there is the same
        // unguarded hole as a bare parameter. Gated here (not in collect_decls)
        // so the registries are fully populated and forward-referenced generics
        // resolve. No feature registers a check handler for these decls, so the
        // arms are purely additive over the prior dispatch no-op.
        .TypeDecl(_, tp, fields) -> tc_check_field_types(tc, fields, tp)
        .ShapeDecl(_, fields) -> tc_check_field_types(tc, fields, empty_type_params())
        .EnumDecl(_, tp, variants) -> tc_check_variant_types(tc, variants, tp)
        .NewtypeDecl(_, inner_vt) -> tc_check_type_applied(tc, resolve_vtype(tc, inner_vt), empty_type_params())
        // An extern's params + return are an FFI ABI claim codegen lowers to a
        // `declare` and coerces call args against — also a layout-determining
        // position, so a bare generic there is gated like any other.
        .ExternFn(_, params, ret_vt) -> tc_check_signature_arity_top(tc, params, ret_vt)
        .TraitDecl(_, methods) -> tc_check_trait_method_sigs(tc, tc.nodes.sstmts_of(methods))
        // .If / .While / .For / .ForIn / .Defer / .Match /
        // .LetDestructure: deferred to feature handlers (if_check_stmt,
        // while_check, for_check, for_in_check, defer_check,
        // match_check_stmt, let_destructure_check_stmt). The previous
        // inline duplicates were stripped-down (e.g. didn't validate
        // that `if`/`while` conditions are bool, and Stmt.Match
        // skipped arm-body typeck entirely — so07.7.4 root cause).
        // Falling through to dispatch_stmt_check makes the registry
        // the single source of truth and the feature handlers run.
        _ -> {
            let tag = avra_stmt_tag(stmt)
            let result = dispatch_stmt_check(tc.features, tag, tc, stmt)
            if result != null { return result! }
            tc
        }
    }
}

// Check that `impl Trait for Type` provides all required methods.
/// Type-check a function body against its declared return type.
/// Includes implicit-return checking (the body's tail expression
/// must match `ret_vt`) and explicit-return path verification.
fn tc_check_fn_body(tc: TC, name: string, ret_vt: ValueType, body: List<StmtId>) -> TC {
    let checked = check_stmt_ids(tc, body)
    // Skip return type checking for functions without a declared return type.
    if vtype_eq(ret_vt, .Void) {
        return checked
    }
    let declared_ret = resolve_vtype(checked, ret_vt)
    // Check every explicit `return expr` produces a compatible type.
    let after_explicit = tc_check_explicit_returns(checked, name, declared_ret, body)
    // Check implicit return: the last expression in the body.
    // Functions with explicit returns on every path don't need this
    // (but checking it anyway is harmless — it's the same type).
    tc_check_implicit_return(after_explicit, name, declared_ret, body)
}

// Check the type of the last expression in a function body against
// the declared return type. Only flags concrete mismatches (e.g.
// string vs int). Skips Void (statements/loops with no value) and
// functions whose last statement isn't an expression.
/// Verify that the body's tail expression matches the declared
/// return type — Avra's implicit-return rule. Skipped for void.
fn tc_check_implicit_return(tc: TC, fn_name: string, declared: ValueType, stmts: List<StmtId>) -> TC {
    // Skip when the declared type is Unknown (fallback/unreliable).
    if vtype_is_unknown(declared) { return tc }
    // so07.7.15: check the body's tail against `declared` as the expected type —
    // generic-fn tails like `unwrap_node_list(xs)` pin type-args from the return
    // position when arg types alone don't carry enough info. Crucially, KEEP
    // check_expr_expected's tc: it emits the generic-arg layout conflict for EVERY
    // tail expression kind (struct literal, list, call, ident, …), so a signature
    // lie like `-> List<Box<string>> { [Box { val: 9 }] }` is caught here. A
    // type-only query (the old tc_body_tail_type) silently dropped those.
    let tail = tc_tail_expr(tc, stmts)
    let tr = if tail != null { check_expr_expected(tc, tail!, declared) } else { tc_er(tc, ValueType.Void) }
    mut after = tr.tc
    let body_ty = tr.ty
    // A tail `match` STATEMENT carries the fn's return value in its expression
    // arms. Conflict-check them against `declared` via the match feature, which
    // binds the arm patterns correctly and skips arm-unification — the
    // non-block-arm case the explicit-return pass leaves uncovered.
    if stmts.length > 0 {
        match tc.nodes.stmts.get(stmts[stmts.length - 1]) {
            .Match(subject, arms) -> after = tc_check_match_tail_conflict(after, fn_name, tc.nodes.exprs.get(subject), arms, declared)
            _ -> {}
        }
    }
    match body_ty {
        .Void or .Unknown -> after
        _ -> {
            // Allow concrete types to satisfy trait return types (auto-boxing at codegen)
            if declared is .Trait { return after }
            if !vtype_eq(declared, body_ty) && !vtype_assignable(body_ty, declared) {
                let msg = "function `${fn_name}` returns `${vtype_render_full(declared)}`, but body produces `${vtype_render_full(body_ty)}`"
                let cause = "declared return type is `${vtype_render_full(declared)}`"
                return tc_report_with_cause(after, DiagCode.TypeMismatch, msg, cause)
            }
            after
        }
    }
}

// Get the type of the last expression in a statement list.
// Returns Void if the last statement is not an expression.
/// Compute the type of the tail expression of a block. Skips
/// trailing return / break / continue. Used to determine the
/// implicit-return value type.

/// The block's tail expression, if its last statement is an implicit-return
/// `.Expr` (not a `return` / loop / decl). Lets a caller run a node-level check
/// on the tail that `tc_body_tail_type` (which yields only a type) can't.
fn tc_tail_expr(tc: TC, stmts: List<StmtId>) -> Expr? {
    if stmts.length == 0 { return null }
    match tc.nodes.stmts.get(stmts[stmts.length - 1]) {
        .Expr(e) -> tc.nodes.exprs.get(e)
        _ -> null
    }
}

// Walk all statements and check that every `return expr` and
// `return` matches the declared return type. This is flow-insensitive
// (checks ALL returns regardless of reachability) but sound — every
// return statement must produce the right type even if dead.
/// Walk every explicit `return value` in `stmts`, verifying
/// `value`'s type matches `declared`. Recurses into nested blocks
/// and conditionals.
export fn tc_check_explicit_returns(tc: TC, fn_name: string, declared: ValueType, stmts: List<StmtId>) -> TC {
    mut cur = tc
    for id in stmts {
        cur = tc_check_stmt_returns(cur, fn_name, declared, tc.nodes.stmts.get(id))
    }
    cur
}

/// Per-stmt branch of `tc_check_explicit_returns` — the recursive
/// case that descends into If / While / Block / Match etc.
fn tc_check_stmt_returns(tc: TC, fn_name: string, declared: ValueType, stmt: Stmt) -> TC {
    match stmt {
        .Return(value) -> {
            // so07.7.3 phase-2: thread `declared` as the expected type
            // for the returned expression. Empty `[]` literals + generic
            // calls in return position pick up the fn's declared return
            // type instead of decaying to List<Unknown> / unresolved T.
            let r = check_expr_expected(tc, tc.nodes.exprs.get(value), declared)
            if !vtype_eq(declared, r.ty) && !vtype_assignable(r.ty, declared) && !vtype_is_unknown(r.ty) && !vtype_eq(r.ty, .Void) {
                let msg = "function `${fn_name}` returns `${vtype_render_full(declared)}`, but return produces `${vtype_render_full(r.ty)}`"
                let cause = "declared return type is `${vtype_render_full(declared)}`"
                return tc_report_with_cause(r.tc, DiagCode.TypeMismatch, msg, cause)
            }
            r.tc
        }
        .Block(body) -> tc_check_explicit_returns(tc, fn_name, declared, body)
        .If(_, then_branch, else_branch) -> {
            let after_then = tc_check_stmt_returns(tc, fn_name, declared, tc.nodes.stmts.get(then_branch))
            if else_branch != null {
                return tc_check_stmt_returns(after_then, fn_name, declared, tc.nodes.stmts.get(else_branch!))
            }
            after_then
        }
        .While(_, body) -> tc_check_stmt_returns(tc, fn_name, declared, tc.nodes.stmts.get(body))
        .For(_, _, _, body) -> tc_check_stmt_returns(tc, fn_name, declared, tc.nodes.stmts.get(body))
        .ForIn(_, _, body) -> tc_check_stmt_returns(tc, fn_name, declared, tc.nodes.stmts.get(body))
        .Match(_, arms) -> tc_check_match_arm_returns(tc, fn_name, declared, arms)
        .Annotated(_, inner) -> tc_check_stmt_returns(tc, fn_name, declared, tc.nodes.stmts.get(inner))
        .Defer(_) -> tc  // defer bodies should not contain return
        .Errdefer(_) -> tc
        .Parallel(body) -> tc_check_explicit_returns(tc, fn_name, declared, body)
        // pry2: let/mut/const bind locals so subsequent `.Return`
        // expressions in the same block see them. Without threading
        // these bindings, a `return (msg, o.expand_site)` after
        // `let o = origins[0]` sees `o` as Unknown — the return-check
        // pass re-runs check_expr (it doesn't trust the annotate
        // pass's SExpr.ty) but reuses the input TC verbatim, so
        // locals declared mid-block fall out of scope.
        .Let(name, ty_vt, init) -> annotate_bind(tc, name, ty_vt, tc.nodes.exprs.get(init))
        .Mut(name, ty_vt, init) -> annotate_bind(tc, name, ty_vt, tc.nodes.exprs.get(init))
        .Const(name, ty_vt, init) -> annotate_bind(tc, name, ty_vt, tc.nodes.exprs.get(init))
        _ -> tc
    }
}

/// Bind every parameter of a fn into the type environment as a
/// defined binding. Mirrors `define_param_names` in resolve/.
export fn tc_bind_params(tc: TC, params: List<ParamEntry>) -> TC {
    mut cur = tc
    for p in params {
        cur = tc_bind(cur, p.name, resolve_vtype(cur, p.vtype))
    }
    cur
}

// ── Expression checking ──

/// Reject an already-checked POINTER literal (`list` / `map` / `struct`) bound to
/// a VALUE-SCALAR slot (int/float/bool/…): each of these literal forms is always a
/// pointer, so storing it in a scalar cell is a layout lie (the inverse of the
/// scalar→ptr hole). A literal's nominal type is always concrete (a struct literal
/// names a declared type, never a bare type-param), so the value-scalar test is
/// false-positive-free — no `vtype_mentions_unresolved` guard is needed (a scalar
/// slot is never an inference artifact). Reports F1000 only for the value-scalar
/// case — a non-scalar pointer slot (`string`) is a nominal mismatch handled
/// elsewhere. `kind` is the literal word for the message ("list" / "map" /
/// "struct"). On rejection the result type collapses to `.Unknown`, NOT the
/// literal's concrete type: at a `return` position the implicit/explicit return
/// check (vtype_assignable) would otherwise see the literal type vs the annotation
/// and emit a SECOND TypeMismatch — `.Unknown` keeps the single diagnostic.
fn reject_literal_into_value_scalar(r: ExprResult, exp: ValueType, kind: string) -> ExprResult {
    if vtype_is_value_scalar(exp) {
        return tc_er(tc_report(r.tc, DiagCode.TypeMismatch, "a ${kind} literal cannot be assigned to value-scalar type `${vtype_render_full(exp)}`"), .Unknown)
    }
    r
}

/// Run the no-int layout gate over an already-checked expression result, then
/// collapse the result type to `.Unknown` when the gate reported a conflict. An
/// invalid expression must NOT propagate its concrete type — otherwise a
/// downstream return / binding re-check (vtype_assignable / tc_check_stmt_returns)
/// re-reports the same expression as a second TypeMismatch. This is the value path
/// twin of `reject_literal_into_value_scalar`: the literal arms use that, the
/// `.Call` and universal arms use this (a named enum ctor or a collection-returning
/// call in `return` position would otherwise double-report). The predicate is
/// recomputed (pure + cheap) rather than threading a fired-flag out of the gate.
fn gate_expr_no_int(r: ExprResult, exp: ValueType, ctx: string) -> ExprResult {
    let after = check_assign_layout_no_int(r.tc, r.ty, exp, ctx)
    tc_er(after, if assign_layout_conflict(r.tc, r.ty, exp, false, true) { .Unknown } else { r.ty })
}

/// Bidirectional variant of `check_expr`: threads the caller's
/// `expected` type down so generic constructors / calls can pin
/// type-args from the return position. ListLit consumes it as an
/// element-type hint (so07.4); Call threads it to generic-fn
/// inference (so07.7.15). Other expressions fall through unchanged.
export fn check_expr_expected(tc: TC, expr: Expr, expected: ValueType) -> ExprResult {
    // Auto-widen: a value of type `T` satisfies an expected `T?`.
    // Propagate the stripped (non-optional) type inward so
    // literal inference (empty lists, generic calls) pins the element /
    // return type instead of seeing `Optional` and decaying to Unknown.
    let exp = vtype_strip_optional(expected)
    match expr {
        // Parentheses are transparent to bidirectional checking: `(expr)` meets the
        // expected type exactly as `expr` does. Without this, a `.Grouping` wrapper
        // falls to the universal arm below — which loses the dedicated struct /
        // subjectless-enum gates, so a wild store hides behind one pair of parens
        // (`let x: int = (Box { val: 9 })`). Recurse on the inner with the SAME raw
        // `expected` so it re-strips the optional and lands in the right arm.
        .Grouping(inner) -> check_expr_expected(tc, tc.nodes.exprs.get(inner), expected)
        // A list/map literal (always a pointer) meeting a VALUE-SCALAR expected
        // type (int/float/bool/…) is the inverse of the ry1a scalar→ptr hole:
        // a pointer stored in a scalar slot. `let x: int = [1,2]` / `{"k":1}`
        // were silently accepted (a85d). The elements are checked first so
        // errors inside the literal surface too; `reject_literal_into_value_scalar`
        // then rejects only the value-scalar slot (a non-scalar pointer slot like
        // `string` is a nominal mismatch handled elsewhere, not a layout one).
        .ListLit(elements) -> reject_literal_into_value_scalar(check_list_lit_with_expected(tc, tc.nodes.sexprs_of(elements), vtype_list_elem(exp)), exp, "list")
        .MapLit(entries) -> reject_literal_into_value_scalar(check_map_lit_with_expected(tc, tc.nodes.sexprs_of(entries), vtype_map_value(exp)), exp, "map")
        .Call(callee, args) -> {
            let r = check_call_with_expected(tc, tc.nodes.exprs.get(callee), tc.nodes.sexprs_of(args), exp)
            // The call result meets the expected type. Route through the no-int
            // gate (generic-arg + collection→scalar): the fn-side of the hole
            // (`let b: Box<string> = make_box_int()`, `let x: int = make_list()`).
            // int→pointer is OMITTED here — it's caught downstream by
            // check_binding's int block at the let site and by vtype_assignable at
            // the return site, so including it would double-report. (so07.7.15:
            // still-inferring generic calls stay safe via the predicate's
            // type-param guard.) `gate_expr_no_int` collapses the result to
            // `.Unknown` on a conflict so a `return make_list()` can't double-report.
            gate_expr_no_int(r, exp, "call result")
        }
        // A generic struct literal whose field-inferred type args are layout-
        // incompatible with the annotation (`let`/return `Name<args>`) is a
        // memory-safety hole — mono builds a layout-consistent value the
        // annotation lies about, and a later read derefs a scalar as a pointer.
        // Reject it here, the universal expected-type entry, so EVERY annotated
        // position (let/mut/const + implicit/explicit return) is covered.
        // A struct literal is also a pointer, so into a VALUE-SCALAR slot
        // (`let x: int = Box { val: 9 }`) it is the same wild store the list/map
        // arms reject (and the enum arms below reject for enum ctors). The two
        // checks here are mutually exclusive — a value-scalar slot is never a
        // generic struct — so the scalar rejection only fires when there is no
        // generic-arg conflict.
        .StructLit(name, _) if name != "" -> {
            let r = check_expr(tc, expr)
            let conflict = generic_struct_annotation_conflict(r.tc, exp, expr)
            if conflict != null {
                let msg = "`${name}` literal of type `${vtype_render_full(conflict!)}` conflicts with expected `${vtype_render_full(exp)}` (a field's type doesn't match the generic argument)"
                tc_er(tc_report(r.tc, DiagCode.TypeMismatch, msg), r.ty)
            } else {
                reject_literal_into_value_scalar(r, exp, "struct")
            }
        }
        // enwi: a subjectless enum ctor (`.Ok(...)`, `.Some(...)`, `.W(...)`) takes
        // its enum from the EXPECTED type, not a `Type.` prefix — so check_expr's
        // tn="" path returns Unknown and the conflict escapes the no-int gate
        // below (Unknown is lenient). Resolve the enum from `exp`, infer the
        // payload type-args exactly as the explicit `Type.Variant` form does, and
        // route through the same layout gate. (`exp` is the optional-stripped
        // expected, so `.Some(x)` into a declared enum still resolves.)
        .EnumCtor(tn, variant, args) if tn == "" -> {
            let sargs = tc.nodes.sexprs_of(args)
            let after = check_expr_list(tc, sargs)
            match exp {
                .Enum(en, _, _) if en != "" -> {
                    let gated = tc_check_enum_ctor_args(after, en, variant, sargs)
                    let result_args = tc_infer_enum_ctor_type_args(gated, en, variant, sargs)
                    let rty = ValueType.Enum(en, result_args, 0)
                    tc_er(check_assign_layout_no_int(gated, rty, exp, "expression"), rty)
                }
                _ -> match expected {
                    // `.Some(x)` into a `T?` optional: the present-ctor carries the
                    // value directly (not a generic enum whose args we'd infer), so
                    // its single payload must match the optional's inner. Route it
                    // through the same layout gate so `.Some(Box<int>)` into
                    // `Box<string>?` is caught (enwi's optional form). Gated to the
                    // PRESENT ctor only (`variant_is_optional_present`): any OTHER 1-arg
                    // subjectless ctor (`.W(Box)`) is NOT an optional-present value,
                    // so it must fall through to the scalar rejection below — else
                    // `let x: int? = .W(Box{val:9})` smuggles a `Wrap` enum into the
                    // optional-stripped `int` cell.
                    .Optional(inner) if sargs.length == 1 && variant_is_optional_present(variant) -> {
                        let aty = tc_arg_concrete_ty(after, sargs[0])
                        tc_er(check_assign_layout_no_int(after, aty, inner, "expression"), expected)
                    }
                    // `.None` is the empty optional — valid for ANY `T?`, with no
                    // payload to check. It must be allowed here, else the scalar
                    // fallback below wrongly rejects `let x: int? = .None` (the
                    // optional-stripped `int` cell reads as value-scalar). The
                    // payload-carrying `.Some` is the only OTHER ctor the optional
                    // accepts; everything else is a wild store and falls through.
                    .Optional(_) if variant_is_optional_absent(variant) && sargs.length == 0 -> tc_er(after, expected)
                    _ -> {
                        // A subjectless ctor `.${variant}(…)` is an enum value —
                        // always the pointer-represented {tag,payload} — so into a
                        // value-scalar slot it is a wild store, even though without
                        // an enum expected type we can't resolve WHICH enum. (A
                        // pointer expected slot stays lenient: ptr→ptr isn't a layout
                        // lie, and the specific nominal can't be checked here.) Same
                        // concrete-value-scalar slot test the predicates above use.
                        if slot_is_concrete_value_scalar(after, expected) {
                            let msg = "expression: enum constructor `.${variant}` is not assignable to `${vtype_render_full(expected)}` (layout conflict)"
                            tc_er(tc_report(after, DiagCode.TypeMismatch, msg), .Unknown)
                        } else {
                            tc_er(after, .Unknown)
                        }
                    }
                }
            }
        }
        _ -> {
            let r = check_expr(tc, expr)
            // The universal arm: any OTHER expression meeting an expected type —
            // a named enum ctor `Wrap.W(…)`, an ident rebound to a conflicting
            // annotation (`let b: Box<string> = a`, `let x: int = xs`), etc.
            // `.StructLit` / `.ListLit` / `.MapLit` / `.Call` have dedicated arms
            // above; this gates the rest. Same no-int gate as `.Call`: int→pointer
            // is handled positionally at the binding / return sites, so it's omitted
            // here to avoid a duplicate diagnostic. `gate_expr_no_int` collapses to
            // `.Unknown` on a conflict so `return Wrap.W(…)` can't double-report.
            gate_expr_no_int(r, exp, "expression")
        }
    }
}

/// Type-check + infer-type for an Expr. Returns `(updated TC,
/// inferred ValueType)`. Each Expr variant gets its own arm; this
/// is the heart of the type checker.
export fn check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Number(_) -> tc_er(tc, .Int)
        .FloatLit(_) -> tc_er(tc, .Float)
        .String(_) -> tc_er(tc, .Str)
        .Bool(_) -> tc_er(tc, .Bool)
        .None -> tc_er(tc, .Void)
        .Ident(name) -> {
            let ty = type_lookup(tc.types, name)
            // If not found in locals, check function registry
            if vtype_is_unknown(ty) {
                let r = fn_type_get(tc.fns, name)
                if r.found { return tc_er(tc, .Fn(r.ret_ty)) }
            }
            tc_er(tc, ty)
        }
        .Binary(left, op, right) -> {
            let left_e = tc.nodes.exprs.get(left)
            let right_e = tc.nodes.exprs.get(right)
            let l = check_expr(tc, left_e)
            let r = check_expr(l.tc, right_e)
            let tc2 = check_none_compare(r.tc, left_e, op, l.ty, right_e, r.ty)
            let tc3 = check_optional_ordering(tc2, op, l.ty, r.ty)
            let tc4 = check_optional_arithmetic(tc3, op, l.ty, r.ty)
            check_binary_type(tc4, l.ty, op, r.ty)
        }
        .Unary(_, right) -> {
            let r = check_expr(tc, tc.nodes.exprs.get(right))
            tc_er(r.tc, r.ty)
        }
        .Logical(left, _, right) -> {
            let l = check_expr(tc, tc.nodes.exprs.get(left))
            let r = check_expr(l.tc, tc.nodes.exprs.get(right))
            tc_er(r.tc, .Bool)
        }
        .Grouping(inner) -> check_expr(tc, tc.nodes.exprs.get(inner))
        .Call(callee, args) -> check_call(tc, tc.nodes.exprs.get(callee), tc.nodes.sexprs_of(args))
        .GenericCall(callee, type_args, args) -> check_generic_call(tc, tc.nodes.exprs.get(callee), type_args, tc.nodes.sexprs_of(args))
        .Index(obj, idx) -> {
            let o = check_expr(tc, tc.nodes.exprs.get(obj))
            let i = check_expr(o.tc, tc.nodes.exprs.get(idx))
            // String indexing returns a string (single character)
            if vtype_eq(o.ty, .Str) {
                return tc_er(i.tc, .Str)
            }
            // Maps and value scalars (the i64/double types) have no `[]` codegen
            // path — both would ICE as F9999 "indexing on non-string/list value".
            // typeck gates, so reject them here with a clean F1206. Strings are
            // handled above; lists and pointers fall through to the element-type
            // path below. A type-param placeholder is `Struct("T", …)` and a
            // newtype is its own `Newtype(…)`, so neither is a value scalar — both
            // fall through on purpose (a newtype wrapping a list should index
            // *through* to its base, resolved where newtype transparency is
            // handled).
            match o.ty {
                .Map(_, _) -> return tc_reject_index(i.tc, o.ty, "use `.get(key)`", vtype_map_value(o.ty))
                _ if vtype_is_value_scalar(o.ty) ->
                    return tc_reject_index(i.tc, o.ty, "only strings, lists, and pointers are indexable", o.ty)
                _ -> {}
            }
            let elem_ty = vtype_list_elem(o.ty)
            tc_er(i.tc, elem_ty)
        }
        .Block(body) -> check_block(tc, tc.nodes.sstmts_of(body))
        .Slice(obj, start, end) -> {
            let o = check_expr(tc, tc.nodes.exprs.get(obj))
            let s = check_expr(o.tc, tc.nodes.exprs.get(start))
            let e = check_expr(s.tc, tc.nodes.exprs.get(end))
            tc_er(e.tc, o.ty)
        }
        .Assign(name, value) -> {
            let v = check_expr(tc, tc.nodes.exprs.get(value))
            // Reassigning an int into a pointer-layout variable is the wild-pointer
            // hole (ry1a/w0kt): the var's slot is a pointer, the int isn't.
            // (int→numeric stays lenient, matching the let site.)
            let var_ty = type_lookup(v.tc.types, name)
            // A reassignment is a value meeting an expected type — route it
            // through the single assignability gate (nlzq) so it can't omit a
            // wild-store check (`b = Box { val: 9 }` on `b: Box<string>`,
            // `x = [1]` on `x: int`, …).
            return tc_er(check_assign_layout(v.tc, v.ty, var_ty, "assignment to `${name}`"), v.ty)
        }
        .QualifiedIdent(path) -> {
            let fn_ty = fn_type_get(tc.fns, path).ret_ty
            tc_er(tc, fn_ty)
        }
        // Enum constructor — `Status.Active`, `Status.Pending(count)`.
        // Returns the enum type so callers (let-bindings, fn args,
        // string()-strictness) see the typed value instead of
        // falling through to Unknown. Mirrors how StructLit is
        // handled by the struct_decl feature hook.
        .EnumCtor(tn, variant, args) -> {
            let sargs = tc.nodes.sexprs_of(args)
            let after_args = check_expr_list(tc, sargs)
            if tn == "" { return tc_er(after_args, .Unknown) }
            let gated = tc_check_enum_ctor_args(after_args, tn, variant, sargs)
            // enwi: carry the type-args inferred from the payload (Wrap<int>, not
            // Wrap<?>) so a mismatched binding annotation is caught downstream.
            let result_args = tc_infer_enum_ctor_type_args(gated, tn, variant, sargs)
            tc_er(gated, ValueType.Enum(tn, result_args, 0))
        }
        // Parens-less `EnumType.Variant` parses as
        // FieldAccess(Ident(EnumType), Variant). When the head is a
        // registered enum, treat the access as a payload-less ctor
        // and propagate the enum type — without this `let v = E.A`
        // binds `v: Unknown` and downstream `${v}` falls through to
        // the codegen F9999 backstop instead of the typeck-side
        // F1003 (shortcut #4 — Display strictness).
        .FieldAccess(obj, _) -> {
            match tc.nodes.exprs.get(obj) {
                .Ident(type_name) if enum_type_has(tc.enums, type_name) -> {
                    let empty_args: List<ValueType> = []
                    return tc_er(tc, ValueType.Enum(type_name, empty_args, 0))
                }
                _ -> {}
            }
            let tag = avra_expr_tag(expr)
            let result = dispatch_expr_check(tc.features, tag, tc, expr)
            if result != null { return result! }
            tc_er(tc, .Unknown)
        }
        _ -> {
            let tag = avra_expr_tag(expr)
            let result = dispatch_expr_check(tc.features, tag, tc, expr)
            if result != null { return result! }
            tc_er(tc, .Unknown)
        }
    }
}

// ── Shape structural compatibility ──
// Verify that all fields of a shape exist in the argument type.
// Called when a function parameter is a shape and the argument is a struct.

/// Verify that each arg passed to a shape-typed parameter has all
/// the required fields (width-subtype check).
fn tc_check_shape_args(tc: TC, params: List<ParamEntry>, args: List<SExpr>) -> TC {
    mut cur = tc
    mut i = 0
    let limit = if params.length < args.length { params.length } else { args.length }
    while i < limit {
        let arg_ty = check_expr(cur, args[i].node).ty
        cur = tc_check_shape_compat(cur, vtype_display(params[i].vtype), arg_ty)
        i = i + 1
    }
    cur
}

// Check that newtype arguments match — UserId != OrderId even if both wrap string
/// Verify newtype-wrapped arguments: a `UserId` param doesn't
/// accept a bare `UUID` — the wrapper has to be explicit at the
/// call site.
fn tc_check_newtype_args(tc: TC, fn_name: string, params: List<ParamEntry>, args: List<SExpr>, is_extern: bool) -> TC {
    mut cur = tc
    mut i = 0
    let limit = if params.length < args.length { params.length } else { args.length }
    while i < limit {
        let p = params[i]
        let param_ty = resolve_vtype(cur, p.vtype)
        let arg_ty = check_expr(cur, args[i].node).ty
        if param_ty is .Newtype {
            if !vtype_eq(param_ty, arg_ty) && !vtype_assignable(arg_ty, param_ty) && !(arg_ty is .Unknown) {
                let msg = "`${fn_name}` parameter `${p.name}` expects `${vtype_render_full(param_ty)}`, got `${vtype_render_full(arg_ty)}`"
                cur = tc_report(cur, DiagCode.TypeMismatch, msg)
            }
        }
        // A layout-incompatible argument: a generic-arg conflict (`want(Box { val:
        // 9 })` for `want(b: Box<string>)` — vtype_eq ignores generic args), an int
        // into a pointer-layout slot (the callee derefs the int — the ry1a/w0kt
        // hole), or a `List`/`Map` into a value-scalar slot (`f([1])` for
        // `f(x: int)`). A NORMAL Avra fn is a real typed slot, so it gets the FULL
        // gate. An EXTERN C binding uses `int` as an i64-legacy value slot that
        // legitimately receives a List/Map (`avra_map_set_cstr(map, key, value: int)`),
        // so the collection→scalar check is omitted ONLY there (the param gate).
        cur = if is_extern {
            check_assign_layout_param(cur, arg_ty, param_ty, "`${fn_name}` parameter `${p.name}`")
        } else {
            check_assign_layout(cur, arg_ty, param_ty, "`${fn_name}` parameter `${p.name}`")
        }
        i = i + 1
    }
    cur
}

// Extract the first argument's type. Safe to call after check_expr_list
// because re-deriving an expression's type is idempotent (no new bindings).
/// Infer the type of the first argument in a `List<SExpr>`, or
/// Void when the list is empty. Used by newtype-ctor inference.
fn tc_first_arg_type(tc: TC, args: List<SExpr>) -> ValueType {
    if args.length == 0 { return ValueType.Void }
    check_expr(tc, args[0].node).ty
}

/// Canonical registry identity of a nominal ValueType, else 0 (non-nominal, or
/// an unregistered name like a bare type-param). Resolves FQN AND short names
/// to the same id (the registry indexes both) and is kind-agnostic (name-based),
/// so it is stable across the .Struct/.Enum and FQN-vs-short representation drift
/// that makes raw vtype_eq unsound for cross-package nominals (op3w). The sound
/// identity primitive for the nominal gates.
fn tc_nominal_id(tc: TC, t: ValueType) -> int {
    let n = vtype_nominal_name(t)
    if n == "" { return 0 }
    type_registry_id_for(tc.type_reg, n)
}

/// 703y bridge (one direction): true when `spanned` is specifically the AST
/// span wrapper SExpr/SStmt whose `node` field canonically IS `bare_ty` — the
/// spanned-of-bare relationship (SExpr = `{ node: Expr, … }`, SStmt =
/// `{ node: Stmt, … }`). Restricted to those two exact wrappers so it can't
/// bridge an unrelated `{ node: T }` user struct.
fn tc_is_spanned_of(tc: TC, spanned: ValueType, bare_ty: ValueType) -> bool {
    let sn = vtype_struct_name(spanned)
    if sn == "" { return false }
    // Only the two AST span wrappers bridge: SExpr = { node: Expr, … },
    // SStmt = { node: Stmt, … }. Gating on the exact wrapper type — not merely
    // "has a field named `node`" — is what keeps an unrelated user struct
    // `{ node: Inner }` from masking a genuine nominal payload mismatch. The
    // field name `node` is ordinary; the previous check bridged ANY struct that
    // happened to have one, silently accepting a wrong-shaped value through it.
    let short = type_short_name(sn)
    if short != "SExpr" && short != "SStmt" { return false }
    let node_ty = field_type_lookup(struct_type_lookup(tc.structs, sn), "node")
    let nid = tc_nominal_id(tc, node_ty)
    nid != 0 && nid == tc_nominal_id(tc, bare_ty)
}

/// True when `a0`/`f0` are a spanned/bare pair EITHER way — a spanned wrapper
/// flowing into a bare-declared slot (SExpr→Expr) OR a bare value flowing into a
/// spanned-declared slot (Stmt→SStmt, e.g. the quote machinery's Stmt.Annotated
/// payload). Both occur in the compiler's own code while the 703y span migration
/// is in flight; bridging keeps the nominal gate from flagging them until that
/// migration unifies the bare/spanned types. Transitional — remove with 703y.
fn tc_bridges_span(tc: TC, a0: ValueType, f0: ValueType) -> bool {
    tc_is_spanned_of(tc, a0, f0) || tc_is_spanned_of(tc, f0, a0)
}

/// pyly: a value of one registered nominal flowing into a DIFFERENT registered
/// nominal field — `Other` into an `Inner` field. Both ptr-represented (the
/// scalar-repr check already passed) with no generic-arg shells, but distinct
/// canonical types → a wrong-shaped value read through the field's slot. Skips
/// unregistered names / type-params (id 0), the SAME canonical type under
/// representation drift (fid == aid), legitimately-assignable values, and the
/// 703y bare-vs-spanned bridge.
fn tc_nominal_payload_mismatch(tc: TC, f0: ValueType, a0: ValueType) -> bool {
    let fid = tc_nominal_id(tc, f0)
    let aid = tc_nominal_id(tc, a0)
    if fid == 0 || aid == 0 { return false }
    if fid == aid { return false }
    if vtype_assignable(a0, f0) { return false }
    if tc_bridges_span(tc, a0, f0) { return false }
    true
}

/// Gate an enum constructor's payload types against the variant's declared
/// field types (pyly). A wrong-typed payload — e.g. `Holder.One(42)` where
/// the field is a struct, or `Stmt.Annotated(annots, bareStmt)` where the
/// field is `SStmt` — otherwise compiles and corrupts memory at runtime (a
/// 112-byte enum value stored where a ptr is expected → SIGSEGV). Skips
/// fields whose declared type mentions one of the enum's type params (those
/// bind via inference) and Unknown types on either side. Mirrors
/// tc_check_newtype_ctor's safe predicate.
fn tc_check_enum_ctor_args(tc: TC, tn: string, variant: string, args: List<SExpr>) -> TC {
    if !enum_type_has(tc.enums, tn) { return tc }
    let v = variant_find(enum_type_variants(tc.enums, tn), variant)
    if v == null { return tc }
    let fields = v!.fields
    let tp = enum_type_params(tc.enums, tn)
    mut cur = tc
    mut i = 0
    let limit = if fields.length < args.length { fields.length } else { args.length }
    while i < limit {
        let fty = resolve_vtype(cur, fields[i].resolved)
        let aty = check_expr(cur, args[i].node).ty
        let skip = vtype_is_unknown(fty) || vtype_is_unknown(aty) || vtype_mentions_typeparam(fty, tp)
        if !skip {
            // Representation-class check: a value scalar (int/bool/float)
            // stored where a pointer-represented field is declared — or the
            // reverse — writes the wrong kind of bits into the payload slot
            // (an i64 where a ptr is expected) and dereferences to a SIGSEGV
            // at runtime (pyly: `Holder.One(42)` where the field is a struct).
            // Optionals are stripped first so a `T?` field accepts a bare `T`.
            // Nominal ptr-vs-ptr mismatches (e.g. `Other` into an `Inner` field)
            // ARE gated below via tc_nominal_payload_mismatch, which compares
            // through canonical registry ids (op3w) so it doesn't false-positive
            // on the .Struct-vs-.Enum / FQN-vs-short representation drift raw
            // vtype_eq diverged on. (Genuinely-divergent cross-registry ids for
            // the same FQN are the residual wc5w concern; the in-process gate is
            // sound.)
            //
            // This repr-class check is STRONGER than the narrow `assign_layout_conflict`
            // gate (catches int→struct, `null`→scalar, … — the full scalar↔ptr
            // divide, safe here because a ctor arg is concrete, not an inference
            // artifact), so this position uses it directly rather than routing
            // through that gate, which would narrow coverage. + generic-arg below.
            let f0 = vtype_strip_optional(fty)
            let a0 = vtype_strip_optional(aty)
            if vtype_is_value_scalar(f0) != vtype_is_value_scalar(a0) {
                let msg = "`${tn}.${variant}` field `${fields[i].name}` expects `${vtype_render_full(fty)}`, got `${vtype_render_full(aty)}`"
                cur = tc_report(cur, DiagCode.TypeMismatch, msg)
            } else if generic_args_layout_conflict(cur, aty, fty) {
                // Same representation class (both ptr) but conflicting generic args —
                // a `Box<int>` payload where `Box<string>` is declared is a layout
                // lie (the Box's inner field is int-vs-ptr). Mirrors the
                // generic-arg conflict checks at let / fn-arg / struct-field
                // positions (q6p4). Generic-payload enums (`Box<T>` still generic
                // at ctor-check time) are skipped above and tracked as enwi.
                let msg = "`${tn}.${variant}` field `${fields[i].name}` expects `${vtype_render_full(fty)}`, got `${vtype_render_full(aty)}` (generic argument layout conflict)"
                cur = tc_report(cur, DiagCode.TypeMismatch, msg)
            } else if tc_nominal_payload_mismatch(cur, f0, a0) {
                // pyly: the ORIGINAL nominal ptr-vs-ptr class — `Other` into an
                // `Inner` field. Both ptr (the repr check passed) but distinct
                // registered types. Sound now that the comparison goes through
                // canonical registry ids (op3w) instead of raw vtype_eq, which
                // diverged on .Struct-vs-.Enum / FQN-vs-short representation.
                let msg = "`${tn}.${variant}` field `${fields[i].name}` expects `${vtype_render_full(fty)}`, got `${vtype_render_full(aty)}` (type mismatch)"
                cur = tc_report(cur, DiagCode.TypeMismatch, msg)
            }
        }
        i = i + 1
    }
    cur
}

// enwi: infer a generic enum's type-args from the constructor's payload args, so
// the ctor's RESULT type carries them (`Wrap.W(Box{val:9})` types as `Wrap<int>`,
// not `Wrap<?>`) and the existing let / return / arg layout-conflict checks fire
// against a mismatched annotation (`let w: Wrap<string> = Wrap.W(Box{val:9})` ->
// F1000). Same gap, same fix for the built-in Result/Option ctors (`.Ok`/`.Some`,
// whose payload is a naked `T`). Returns the inferred type per declared param, in
// order — `Unknown` for any the args left unbound (a partial bind still lets the
// resolved positions catch a conflict; Unknown stays lenient).
//
// Uses the shared tc_unify, which peels Struct/Enum args (g97x) — so the
// gate-local twin this once needed is retired and fn-arg and enum-ctor inference
// share one unifier. This only REFINES an otherwise-empty ctor result type, so IR
// is byte-identical and it merely adds rejections for invalid programs (deep
// Struct-in-container payloads like `List<Box<T>>` now bind, since g97x landed
// the arm in the shared unifier).
fn tc_infer_enum_ctor_type_args(tc: TC, tn: string, variant: string, args: List<SExpr>) -> List<ValueType> {
    let tp = enum_type_params(tc.enums, tn)
    if tp.length == 0 { return [] }
    let v = variant_find(enum_type_variants(tc.enums, tn), variant)
    if v == null { return [] }
    let fields = v!.fields
    mut bindings: List<TypeArg> = []
    mut i = 0
    let limit = if fields.length < args.length { fields.length } else { args.length }
    while i < limit {
        let fty = resolve_vtype(tc, fields[i].resolved)
        let aty = tc_arg_concrete_ty(tc, args[i])
        // g97x: the shared tc_unify now peels Struct/Enum args, so the gate-local
        // twin this used to call is retired — fn-arg inference and enum-ctor
        // inference share one unifier again.
        bindings = tc_unify(tp, fty, aty, bindings)
        i = i + 1
    }
    tc_project_type_args(tp, bindings)
}

// Check newtype constructor argument matches the inner type
/// Verify that the single arg to a newtype constructor matches the
/// newtype's declared inner type. `UserId(uuid)` should pass a UUID.
/// Fires ONLY when the callee IS the newtype (its ctor registers under
/// the newtype's own name) — an ordinary fn that merely RETURNS the
/// newtype (e.g. `expr_ref_id(r: NodeRef) -> ExprId`) constrains its
/// args by its own param types, not by the newtype's payload.
fn tc_check_newtype_ctor(tc: TC, name: string, ret_ty: ValueType, arg_ty: ValueType) -> TC {
    match ret_ty {
        .Newtype(nt_name, inner_ty, _) -> {
            if !tc_callee_names_type(name, nt_name) { return tc }
            if !vtype_eq(arg_ty, inner_ty) && !vtype_assignable(arg_ty, inner_ty) && !(arg_ty is .Unknown || inner_ty is .Unknown) {
                let msg = "`${name}()` expects `${vtype_render_full(inner_ty)}`, got `${vtype_render_full(arg_ty)}`"
                return tc_report(tc, DiagCode.TypeMismatch, msg)
            }
            tc
        }
        _ -> tc
    }
}

/// True when a callee name refers to the given type name — exactly, or
/// with fully-qualified module prefixes on either side (`ExprId` vs
/// `@std::avrac::core::ExprId` match in both directions).
fn tc_callee_names_type(callee: string, type_name: string) -> bool {
    if callee == type_name { return true }
    let callee_suffix = "::" + callee
    if type_name.length > callee_suffix.length && type_name.substring(type_name.length - callee_suffix.length, type_name.length) == callee_suffix {
        return true
    }
    let type_suffix = "::" + type_name
    callee.length > type_suffix.length && callee.substring(callee.length - type_suffix.length, callee.length) == type_suffix
}

/// Verify shape compatibility — the arg's struct must have all the
/// fields the shape param requires (extras are fine; that's the
/// width-subtype rule).
fn tc_check_shape_compat(tc: TC, param_ty_str: string, arg_ty: ValueType) -> TC {
    // Only check when parameter type is a shape
    if !is_shape(tc.shapes, param_ty_str) { return tc }
    // Get the shape's required fields
    let shape_fields = struct_type_lookup(tc.structs, param_ty_str)
    // Get the argument's actual fields
    let arg_name = match arg_ty {
        .Struct(n, _, _) -> n
        _ -> ""
    }
    if arg_name == "" { return tc }
    let arg_fields = struct_type_lookup(tc.structs, arg_name)
    // Check each shape field exists in the arg type
    tc_check_fields_present(tc, param_ty_str, arg_name, shape_fields, arg_fields)
}

/// Inner check for `tc_check_shape_compat` — emit an error per
/// field that's required but missing from the arg type.
fn tc_check_fields_present(tc: TC, shape_name: string, arg_name: string, required: List<FieldEntry>, available: List<FieldEntry>) -> TC {
    mut acc = tc
    mut i = 0
    while i < required.length {
        let e = required[i]
        if !field_list_has(available, e.name) {
            let msg = "type `${arg_name}` does not satisfy shape `${shape_name}` — missing field `${e.name}`"
            acc = tc_report(acc, DiagCode.TypeMismatch, msg)
        } else {
            let expected_vt = resolve_vtype(acc, e.resolved)
            let actual_vt = resolve_vtype(acc, field_vtype_of(available, e.name))
            if !vtype_is_unknown(expected_vt) && !vtype_is_unknown(actual_vt) && !vtype_eq(expected_vt, actual_vt) && !vtype_assignable(actual_vt, expected_vt) {
                let msg = "field `${e.name}` has type `${vtype_render_full(actual_vt)}` in `${arg_name}` but shape `${shape_name}` requires `${vtype_render_full(expected_vt)}`"
                acc = tc_report(acc, DiagCode.TypeMismatch, msg)
            }
        }
        i = i + 1
    }
    acc
}

// ── Binary operator type rules ──

/// Type-check a binary operator. Most return Bool (comparisons) or
/// the operand's type (arithmetic); union-arg cases dispatch to
/// the appropriate concrete branch.
/// ifnz: `x == none` / `x != none` where `x` is a concrete NON-optional
/// *tagged value type* (`int` / `bool` / `float` / sized ints) is
/// always-false / always-true — `none` only inhabits an optional `T?`,
/// and for these types `T?` is a distinct tagged `{present, value}`
/// struct, so the comparison is unambiguously a mistake (e.g. a bind-fresh
/// `if let v = 5` / `let v = 5 else` on a non-optional, which silently
/// mis-branches: `0 != none` is false). Flag it via F1000 with a remedy.
///
/// Deliberately scoped to the tagged-repr scalars: pointer-backed types
/// (`ptr`/`str`/struct/enum/list/…) use a null-pointer niche where `none`
/// and the raw value share bits, and the compiler's optional inference is
/// not yet complete for them — flagging those produces false positives on
/// the compiler's own derive-walker code. Widen once optional inference is
/// sound (tracked in ifnz / the bidirectional-typing work).
/// Reject value arithmetic (`+ - * / %`, bitwise, shifts) on an optional
/// operand. A `none` has no value, so silently computing would corrupt
/// (both-optional operates on box pointers; a none side traps). Sibling of
/// check_optional_ordering; equality stays permissive.
fn check_optional_arithmetic(tc: TC, op: BinOp, l_ty: ValueType, r_ty: ValueType) -> TC {
    if !binop_is_arithmetic(op) { return tc }
    if !vtype_is_optional(l_ty) && !vtype_is_optional(r_ty) { return tc }
    let which = if vtype_is_optional(l_ty) { vtype_render_full(l_ty) } else { vtype_render_full(r_ty) }
    let msg = "cannot do arithmetic on an optional `${which}` with `${binop_str(op)}` — a `none` has no value to compute with"
    tc_report(tc, DiagCode.ArithOnOptional, msg)
}

/// Reject an ordering comparison (`<` `<=` `>` `>=`) on an optional operand.
/// `none` has no position in an ordering, so silently answering would defeat
/// the purpose of `T?` (and is where strict non-null-by-default is headed).
/// Equality (`==`/`!=`) stays permissive — it IS well-defined on optionals.
fn check_optional_ordering(tc: TC, op: BinOp, l_ty: ValueType, r_ty: ValueType) -> TC {
    if !binop_is_ordering(op) { return tc }
    if !vtype_is_optional(l_ty) && !vtype_is_optional(r_ty) { return tc }
    let which = if vtype_is_optional(l_ty) { vtype_render_full(l_ty) } else { vtype_render_full(r_ty) }
    let msg = "cannot order an optional `${which}` with `${binop_str(op)}` — a `none` has no position in an ordering"
    tc_report(tc, DiagCode.OrderOnOptional, msg)
}

fn check_none_compare(tc: TC, left: Expr, op: BinOp, l_ty: ValueType, right: Expr, r_ty: ValueType) -> TC {
    if !(op is .Eq) && !(op is .Ne) { return tc }
    let l_none = left is .None
    let r_none = right is .None
    if l_none == r_none { return tc }   // need exactly one `none` operand
    let other = if l_none { r_ty } else { l_ty }
    if vtype_is_optional(other) { return tc }   // the intended case — fine
    if !vtype_is_value_scalar(other) { return tc }
    let always = if op is .Eq { "false" } else { "true" }
    let msg = "comparing a non-optional `${vtype_render_full(other)}` to `none` is always ${always} — `none` only inhabits an optional `T?`. Make the type `T?`, or drop the comparison (an `if let` / `let-else` here needs an optional subject)."
    tc_report(tc, DiagCode.TypeMismatch, msg)
}

fn check_binary_type(tc: TC, left: ValueType, op: BinOp, right: ValueType) -> ExprResult {
    // If either operand is Float, arithmetic produces Float.
    let arith_ty = if vtype_eq(left, .Float) || vtype_eq(right, .Float) { ValueType.Float } else { ValueType.Int }
    match op {
        .Add -> {
            if vtype_eq(left, .Str) || vtype_eq(right, .Str) { return tc_er(tc, .Str) }
            tc_er(tc, arith_ty)
        }
        .Sub -> tc_er(tc, arith_ty)
        .Mul -> tc_er(tc, arith_ty)
        .Div -> tc_er(tc, arith_ty)
        .Mod -> tc_er(tc, arith_ty)
        .Eq -> tc_er(tc, .Bool)
        .Ne -> tc_er(tc, .Bool)
        .Lt -> tc_er(tc, .Bool)
        .Le -> tc_er(tc, .Bool)
        .Gt -> tc_er(tc, .Bool)
        .Ge -> tc_er(tc, .Bool)
        _ -> tc_er(tc, .Unknown)
    }
}

// ── Call type inference ──

// Check arity and return type for a named function call.
/// Type-check a fn call by name: verify arity, walk each arg
/// against its declared param type, and return the fn's declared
/// return type. Caller has already type-checked args via
/// `check_expr_list_types`.
/// Type-check a fn call given a pre-resolved registry record. The
/// caller is expected to have already gated on `rec.found` (or to
/// pass a `found=true` record in its happy path), so this body never
/// re-walks the FnTypeEntry chain — that's the kkgf hot-path saving.
fn tc_check_fn_call_with(checked: TC, name: string, args: List<SExpr>, rec: FnTypeFound) -> ExprResult {
    tc_check_fn_call_with_expected(checked, name, args, rec, ValueType.Unknown)
}

/// Bidirectional variant — accepts the caller's `expected` return
/// type (e.g. from a let-annotation, fn-return position, or match-arm
/// expected type). Threaded to tc_subst_generic_ret_with_expected so
/// generic fns whose only T-constraint comes from the return position
/// resolve cleanly (so07.7.15).
fn tc_check_fn_call_with_expected(checked: TC, name: string, args: List<SExpr>, rec: FnTypeFound, expected: ValueType) -> ExprResult {
    let expected_param_count = rec.params.length
    let actual = tc_count_args(args)
    if expected_param_count != actual {
        let s = if expected_param_count != 1 { "s" } else { "" }
        let msg = "`${name}` expects ${string(expected_param_count)} argument${s}, got ${string(actual)}"
        return tc_er(tc_report(checked, DiagCode.WrongArgCount, msg), rec.ret_ty)
    }
    // Check shape and newtype compatibility
    let shape_checked = tc_check_shape_args(checked, rec.params, args)
    let newtype_checked = tc_check_newtype_args(shape_checked, name, rec.params, args, rec.is_extern)
    // Optional strict arg-type warnings: AVRA_STRICT_ARGS=1 surfaces
    // F9004 when a concrete arg type isn't assignable to its concrete
    // param type. Off by default — the existing typeck has gaps in
    // component-expansion-synthesised bindings that would otherwise spam.
    // Originally added during the lkze.9 list-enum→List<T> refactor to
    // catch silent ptr-shape coercions; kept around as an opt-in
    // tightness probe for future migrations.
    let strict_checked = if avra_process_env_get("AVRA_STRICT_ARGS") != "" {
        tc_strict_arg_types(newtype_checked, name, rec.tp, rec.params, args)
    } else {
        newtype_checked
    }
    let first_arg_ty = tc_first_arg_type(strict_checked, args)
    let ctor_checked = tc_check_newtype_ctor(strict_checked, name, rec.ret_ty, first_arg_ty)
    // For generic fns: infer T from the call's arg types AND the
    // caller's expected return type (so07.7.15), substitute into ret_ty
    // so downstream typeck sees `Int` for `first(nums)` instead of the
    // unresolved `T`. Non-generic fns short-circuit via the empty-tp
    // guard in tc_subst_generic_ret_with_expected.
    let resolved_ret = tc_subst_generic_ret_with_expected(newtype_checked, rec.tp, rec.params, args, rec.ret_ty, expected)
    tc_er(ctor_checked, resolved_ret)
}

/// Walks params/args pairwise, reporting F9004 warnings when a
/// concrete arg type isn't assignable to its concrete param type.
/// Generic params (containing T, U, …) skip the check — those bind
/// via inference. Unknown types skip too (still being resolved).
/// Gated by AVRA_STRICT_ARGS at the call site so the default build
/// stays quiet; turn on for refactor sessions that need fail-fast on
/// silent ptr-shape coercions.
fn tc_strict_arg_types(tc: TC, name: string, tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>) -> TC {
    mut cur_tc = tc
    mut i = 0
    let limit = if params.length < args.length { params.length } else { args.length }
    while i < limit {
        let p = params[i]
        let arg_ty = tc_arg_concrete_ty(cur_tc, args[i])
        let skip_unknown = vtype_is_unknown(p.vtype) || vtype_is_unknown(arg_ty)
        let skip_generic = vtype_mentions_typeparam(p.vtype, tp)
        if !skip_unknown && !skip_generic {
            if !vtype_eq(arg_ty, p.vtype) && !vtype_assignable(arg_ty, p.vtype) {
                let msg = "`${name}` parameter `${p.name}` expects ${vtype_render_full(p.vtype)}, got ${vtype_render_full(arg_ty)}"
                cur_tc = tc_warn(cur_tc, DiagCode.ArgTypeMismatch, msg)
            }
        }
        i = i + 1
    }
    cur_tc
}

/// True iff `ty` (or any inner type it wraps) is a `.Struct(name, _)`
/// whose name is one of the function's type parameters. Used to skip
/// strict arg-type checks on generic-parametric params — those bind
/// to whatever the arg's type is via tc_subst_generic_ret.
fn vtype_mentions_typeparam(ty: ValueType, tp: List<TypeParamEntry>) -> bool {
    if tp.length == 0 { return false }
    // A type "mentions" a param iff any node in its tree is a bare
    // Struct naming one. derive_walker's ValueType.any tests that
    // predicate on every node (self + all children), so it subsumes the
    // hand-rolled List/Task/FnTyped/Enum recursion — and additionally
    // reaches Union / Tuple / Newtype members the old walker skipped.
    ty.any((t) -> match t {
        .Struct(n, _, _) -> type_param_has(tp, n)
        _ -> false
    })
}

/// Resolve a generic-fn call's return type. Walks params/args
/// pairwise to bind every type parameter, then substitutes
/// bindings into ret_ty. For non-generic fns (`tp.End`) this is a
/// fast no-op returning ret_ty verbatim.
///
/// Mirrors mono's `unify_param` / `infer_from_params` but runs at
/// typeck time so let-bindings, call chains, and field accesses
/// downstream see the concrete result type. Without this, the
/// chain `let xs = generic_call(); other_generic_call(xs)` loses
/// the inner type at the `let` boundary and the second call's
/// type-arg can't be inferred.
fn tc_subst_generic_ret(tc: TC, tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>, ret_ty: ValueType) -> ValueType {
    tc_subst_generic_ret_with_expected(tc, tp, params, args, ret_ty, ValueType.Unknown)
}

/// Method-call variant. The method's params[0] is `self` (constrained
/// by dispatch — not part of the user-visible call). User args align
/// with params[1..], so we project that slice and forward to
/// tc_subst_generic_ret. y9y4.16 — `t.fold(0, sum_leaves)` on
/// `Tree__fold<S>(self, init: S, f: fn(S,Tree)->S) -> S` substitutes
/// S = Int from init, returns Int instead of the generic S.
/// Project a method's parameter list to drop `self` (params[0]). User-visible
/// call args align with params[1..], so both the generic-return substitution
/// (tc_subst_generic_method_ret) and the param-layout gate (the method-call arm
/// of check_method_call) compare against this projected slice. A params list of
/// length 0 yields an empty list.
fn method_params_without_self(params: List<ParamEntry>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 1
    while i < params.length {
        out.push(params[i])
        i = i + 1
    }
    out
}

/// Instantiate a generic fn/method's params by substituting resolved type-arg
/// `bindings` into each declared param type. Run BEFORE the layout gate so a
/// type-param param (`x: T`) is checked against its concrete binding (T=string)
/// rather than the unresolved `T` — otherwise `id<string>(9)` and
/// `Box<string>.m(9)` slip past the gate (the param reads as layout-unknown).
// rs0b: receiver type-param bindings for the method-param layout gate. Zips a
// generic receiver's DECLARED type params (from its struct/enum definition)
// against its concrete `type_args` — a `GcStack<string>` receiver with
// `type GcStack<T>` yields T=string. Used ONLY to refine the params the layout
// gate checks (via subst_param_types in check_method_call); it never feeds
// tc_unify / fn-call inference / mono, so emitted IR is byte-identical and the
// HRN diff-test stays green. This is a DISTINCT mechanism from tc_unify's
// Struct/Enum arm (g97x): it zips a receiver's declared params against its
// concrete type-args, rather than unifying a param type against an arg type — so
// it stays separate even though tc_unify now peels Struct/Enum.
fn tc_recv_type_bindings(tc: TC, recv: ValueType) -> List<TypeArg> {
    match recv {
        .Struct(name, args, _) -> tc_zip_type_args(struct_type_params(tc.structs, name), args)
        .Enum(name, args, _) -> tc_zip_type_args(enum_type_params(tc.enums, name), args)
        _ -> []
    }
}

// Pairwise-zip declared type params with concrete type args into TypeArg
// bindings. Truncates to the shorter list (a partially-applied or placeholder
// receiver simply contributes fewer bindings — and a placeholder arg substitutes
// to itself, a harmless no-op).
fn tc_zip_type_args(params: List<TypeParamEntry>, args: List<ValueType>) -> List<TypeArg> {
    mut out: List<TypeArg> = []
    let n = if params.length < args.length { params.length } else { args.length }
    mut i = 0
    while i < n {
        out.push(TypeArg { param_name: params[i].name, concrete_vt: args[i] })
        i = i + 1
    }
    out
}

fn subst_param_types(params: List<ParamEntry>, bindings: List<TypeArg>) -> List<ParamEntry> {
    mut out: List<ParamEntry> = []
    mut i = 0
    while i < params.length {
        let p = params[i]
        out.push(ParamEntry { name: p.name, vtype: tc_subst_vtype(p.vtype, bindings) })
        i = i + 1
    }
    out
}

fn tc_subst_generic_method_ret(tc: TC, tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>, ret_ty: ValueType) -> ValueType {
    if tp.length == 0 { return ret_ty }
    if params.length == 0 { return ret_ty }
    tc_subst_generic_ret(tc, tp, method_params_without_self(params), args, ret_ty)
}

/// Bidirectional variant: ALSO unify `ret_ty` against `expected` (the
/// caller's known return-position type) to harvest additional type-arg
/// bindings. Required when the only constraint on a type-param T comes
/// from the caller's `let xs: List<Stmt> = generic_fn(opaque_arg)` —
/// arg types alone don't pin T, but the let annotation does.
/// so07.7.15. `expected = Unknown` (the default for non-bidirectional
/// callers) is a no-op via tc_unify's Unknown wildcard.
/// Fill-only merge: keep every binding `base` already has (from the ARGS) and add
/// a binding from `fill` (derived from the expected type) ONLY for params the args
/// left unresolved. NEVER overrides an arg-bound param — overriding turns a wrong
/// annotation into a layout lie: `let y: string = id(9)` would type `id(9)` as
/// `string`, hiding the int↔string mismatch the let-binding check would otherwise
/// catch (and mono would then store the int 9 as a wild string pointer). Mirrors
/// the struct-side fill_unresolved_from_expected.
fn tc_fill_unresolved_typeargs(tp: List<TypeParamEntry>, base: List<TypeArg>, fill: List<TypeArg>) -> List<TypeArg> {
    mut out = base
    mut i = 0
    while i < tp.length {
        let pname = tp[i].name
        let fv = tc_type_arg_lookup(fill, pname)
        // Fill from `fill` only when the args left this param unresolved and the
        // expected side actually bound it. tc_unify cons-prepends the binding (the
        // mono twin does the same via unify_param).
        if vtype_is_unknown(tc_type_arg_lookup(base, pname)) && !vtype_is_unknown(fv) {
            out = tc_unify(tp, vtype_struct(pname, 0), fv, out)
        }
        i = i + 1
    }
    out
}

fn tc_subst_generic_ret_with_expected(tc: TC, tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>, ret_ty: ValueType, expected: ValueType) -> ValueType {
    if tp.length == 0 { return ret_ty }
    let empty: List<TypeArg> = []
    let arg_bindings = tc_infer_type_args(tc, tp, params, args, empty)
    // Fill-only: the expected return type may only resolve params the ARGS
    // left unresolved (the so07.7.15 gap-fill, e.g. `let xs: List<int> = empty()`),
    // never override an arg-bound one. Unify ret_ty against expected into a FRESH
    // acc, then fill only the gaps — so `id(9)` stays `int` and the let/return
    // mismatch surfaces, instead of being papered over to `string`.
    let ret_bindings = if vtype_is_unknown(expected) {
        arg_bindings
    } else {
        let exp_only = tc_unify(tp, ret_ty, expected, empty)
        tc_fill_unresolved_typeargs(tp, arg_bindings, exp_only)
    }
    tc_subst_vtype(ret_ty, ret_bindings)
}

/// Walk params/args pairwise, recursing into List/Task/FnTyped
/// constructors. Returns a `List<TypeArg>` mapping each bound T to
/// its concrete arg type. Args whose typeck-annotated `.ty` is
/// Unknown fall back to `tc_infer_lit_ty` so literal `[1,2,3]` and
/// bare lambdas still contribute bindings.
fn tc_infer_type_args(tc: TC, tp: List<TypeParamEntry>, params: List<ParamEntry>, args: List<SExpr>, acc: List<TypeArg>) -> List<TypeArg> {
    mut cur_acc = acc
    mut i = 0
    let limit = if params.length < args.length { params.length } else { args.length }
    while i < limit {
        let arg_ty = tc_arg_concrete_ty(tc, args[i])
        cur_acc = tc_unify(tp, params[i].vtype, arg_ty, cur_acc)
        i = i + 1
    }
    cur_acc
}

/// Recursively unify a param type against an arg type, binding
/// any naked type-param (Struct named "T", "U", …) that appears.
/// Peels `List<T>`, `Task<T>`, and `fn(T) -> U` so type params
/// nested inside generic constructors still bind. Cons-prepend
/// semantics preserved via a fresh list with the new entry pushed
/// before the existing bindings (innermost-binding-wins for
/// `tc_type_arg_lookup`).
fn tc_unify(tp: List<TypeParamEntry>, param_ty: ValueType, arg_ty: ValueType, acc: List<TypeArg>) -> List<TypeArg> {
    let name = vtype_display(param_ty)
    if type_param_has(tp, name) {
        mut out: List<TypeArg> = []
        out.push(TypeArg { param_name: name, concrete_vt: arg_ty })
        mut i = 0
        while i < acc.length {
            out.push(acc[i])
            i = i + 1
        }
        return out
    }
    match param_ty {
        .List(p_inner) -> match arg_ty {
            .List(a_inner) -> tc_unify(tp, p_inner, a_inner, acc)
            _ -> acc
        }
        .Task(p_inner) -> match arg_ty {
            .Task(a_inner) -> tc_unify(tp, p_inner, a_inner, acc)
            _ -> acc
        }
        // Bind K and V from a `Map<K, V>` arg — the typeck twin of mono's
        // unify_param Map branch. Without this, a generic fn over a map
        // (`fn f<V>(m: Map<string, V>) -> Map<string, V>`) never resolves V
        // from the arg, so the call's return type stays generic and a
        // conflicting `let n: Map<string, string> = f(int_map)` escapes.
        .Map(p_key, p_val) -> match arg_ty {
            .Map(a_key, a_val) -> {
                let acc1 = tc_unify(tp, p_key, a_key, acc)
                tc_unify(tp, p_val, a_val, acc1)
            }
            _ -> acc
        }
        // Unify `T?` param against `U?` arg (inner-to-inner) or against a
        // bare `U` arg (auto-widen — a present `U` satisfies `T?`).
        .Optional(p_inner) -> match arg_ty {
            .Optional(a_inner) -> tc_unify(tp, p_inner, a_inner, acc)
            _ -> tc_unify(tp, p_inner, arg_ty, acc)
        }
        .FnTyped(p_params, p_ret) -> match arg_ty {
            .FnTyped(a_params, a_ret) -> {
                let acc1 = tc_unify(tp, p_ret, a_ret, acc)
                tc_unify_lists(tp, p_params, a_params, acc1)
            }
            .Closure(_, a_ret) -> tc_unify(tp, p_ret, a_ret, acc)
            .Fn(a_ret) -> tc_unify(tp, p_ret, a_ret, acc)
            _ -> acc
        }
        // g97x: bind type params nested inside a Struct/Enum arg — `f<T>(x: Box<T>)`
        // called with `Box<int>` now binds T=int, exactly as the List/Map/Optional
        // constructors above already do. enwi's gate-local twin unifier carried this
        // arm while it was missing here; promoting it lets fn-call inference resolve a
        // type param that only appears inside a struct/enum arg, and retires that twin.
        // The generic head is matched by position, not name (like .List/.Map): head
        // identity is NOT verified here. A wrong head falls to the caller's
        // assignability check, which is lenient for structurally-compatible nominals,
        // so it does not always reject (a structural-vs-nominal gap, not a guarantee
        // this position enforces).
        //
        // CROSS-REPRESENTATION (matches the mono unify_param oracle, mono.av): pull the
        // arg's type-args via vtype_type_args, which reads them from EITHER nominal form.
        // A generic annotation `Box<T>` lowers to Enum-form (the parser can't tell struct
        // from enum) while its `Box{...}` instance is Struct-form, so a `.Struct` param
        // must still bind against an `.Enum` arg and vice versa — otherwise the two
        // unifiers diverge and a param reachable only through that field goes unbound.
        // vtype_type_args returns [] for a non-nominal arg, so tc_unify_lists is then a
        // no-op — identical to the prior kind-matched `_ -> acc`. The reachable arm
        // (binding a param through a same-kind struct/enum arg) stays exercised by the
        // g97x fn-arg-inference gate suite; the cross-KIND step this adds is unreachable
        // today (callers pre-resolve_vtype), so it is a structural parity guard, not a
        // behaviour change — selfhost + diff-test are byte-identical.
        .Struct(_, p_args, _) -> tc_unify_lists(tp, p_args, vtype_type_args(arg_ty), acc)
        .Enum(_, p_args, _) -> tc_unify_lists(tp, p_args, vtype_type_args(arg_ty), acc)
        _ -> acc
    }
}

/// Pairwise unify two `List<ValueType>`s (fn-param recursion in
/// `tc_unify`).
fn tc_unify_lists(tp: List<TypeParamEntry>, params: List<ValueType>, args: List<ValueType>, acc: List<TypeArg>) -> List<TypeArg> {
    let n = if params.length < args.length { params.length } else { args.length }
    mut out = acc
    mut i = 0
    while i < n {
        out = tc_unify(tp, params[i], args[i], out)
        i = i + 1
    }
    out
}

/// Best-effort concrete type of one argument. Re-checks the
/// expression through `check_expr` to pick up any typeck-side
/// substitutions (e.g. `let xs = first(nums)` should now type as
/// `Int`, not `T`). Falls back to a literal-shape inference for
/// list / lambda literals so call sites without surrounding
/// annotations still bind their inner types.
fn tc_arg_concrete_ty(tc: TC, arg: SExpr) -> ValueType {
    if !vtype_is_unknown(arg.ty) { return arg.ty }
    let r = check_expr(tc, arg.node)
    if !vtype_is_unknown(r.ty) { return r.ty }
    tc_infer_lit_ty(tc.nodes, arg.node)
}

/// Lightweight literal-shape inference for arg types when typeck
/// hasn't annotated. Mirrors mono's `infer_lit_ty` but uses
/// typeck-local helpers (no cross-module import).
fn tc_infer_lit_ty(store: NodeStore, e: Expr) -> ValueType {
    match e {
        .Number(_) -> ValueType.Int
        .FloatLit(_) -> ValueType.Float
        .String(_) -> ValueType.Str
        .Bool(_) -> ValueType.Bool
        .StructLit(name, _) if name != "" -> vtype_struct(name, 0)
        .EnumCtor(tn, _, _) if tn != "" -> {
            let empty_args: List<ValueType> = []
            ValueType.Enum(tn, empty_args, 0)
        }
        .Grouping(inner) -> tc_infer_lit_ty(store, store.exprs.get(inner))
        .ListLit(elements) -> ValueType.List(tc_infer_list_elem(store, store.sexprs_of(elements)))
        .Lambda(params, _) -> ValueType.FnTyped(tc_param_types(params), ValueType.Unknown)
        _ -> ValueType.Unknown
    }
}

/// True when any element of a list literal is the `none` absence literal.
/// Such a list is `List<T?>`, not `List<T>` — the codegen boxes its present
/// elements into the tagged-optional repr, so the inferred type must agree.
fn list_lit_has_none(elements: List<SExpr>) -> bool {
    mut i = 0
    while i < elements.length {
        if elements[i].node is .None { return true }
        i = i + 1
    }
    false
}

/// Wrap a known, non-optional element type in `Optional` when the literal
/// mixes in a `none`. Keeps inference consistent with `emit_list_lit`.
fn list_lit_optionalize(elements: List<SExpr>, base: ValueType) -> ValueType {
    if vtype_is_unknown(base) { return base }
    if vtype_is_optional(base) { return base }
    if list_lit_has_none(elements) { ValueType.Optional(base) } else { base }
}

fn tc_infer_list_elem(store: NodeStore, elements: List<SExpr>) -> ValueType {
    if elements.length == 0 { return ValueType.Unknown }
    // Pin the inner type from the first present element (a leading `none`
    // carries no type), then re-wrap in `T?` when a `none` is present.
    mut base = ValueType.Unknown
    mut i = 0
    while i < elements.length {
        if !(elements[i].node is .None) {
            base = tc_infer_lit_ty(store, elements[i].node)
            i = elements.length
        } else {
            i = i + 1
        }
    }
    list_lit_optionalize(elements, base)
}

fn tc_param_types(params: List<ParamEntry>) -> List<ValueType> {
    // Inline loop (vs `list_map`) — current bs2's typeck rejects the
    // generic return inference of `list_map(params, (p) -> p.vtype)`
    // ("returns List, body produces List") because the lambda's
    // closure-typed return loses the concrete element type before
    // the constraint flows back up. Same shape works in other
    // list_map call sites that pass a top-level fn instead of a
    // lambda, so the bug is in lambda return inference, not list_map.
    mut out: List<ValueType> = []
    for p in params { out.push(p.vtype) }
    out
}

/// Inspect the first element of a list literal and return its
/// inferred type; falls back to `Unknown` for an empty list.
/// Used by `annotate_sexpr`'s ListLit fast-path so `[1, 2, 3]`
/// types as `List<int>` instead of `List<unknown>`. A literal mixing in a
/// `none` is `List<T?>` — re-wrap so the fast-path agrees with `emit_list_lit`.
fn tc_first_elem_ty(tc: TC, elements: List<SExpr>) -> ValueType {
    if elements.length == 0 { return ValueType.Unknown }
    list_lit_optionalize(elements, tc_expr_or_lit_ty(tc, elements[0].node))
}

/// Type of an expr node, falling back to literal-shape inference when the
/// checker returns `Unknown` (a bare literal whose type the surrounding context
/// pins). Shared by the quick-type inference for list elements and map values.
fn tc_expr_or_lit_ty(tc: TC, node: Expr) -> ValueType {
    let r = check_expr(tc, node)
    if vtype_is_unknown(r.ty) { tc_infer_lit_ty(tc.nodes, node) } else { r.ty }
}

/// First map VALUE type for quick `MapLit` typing — the value analog of
/// `tc_first_elem_ty`. entries = [k0, v0, k1, v1, ...] so the first value
/// is at index 1; empty literals are `Unknown`.
fn tc_first_map_value_ty(tc: TC, entries: List<SExpr>) -> ValueType {
    if entries.length < 2 { return ValueType.Unknown }
    tc_expr_or_lit_ty(tc, entries[1].node)
}

/// Substitute every T occurrence in `ty` with the binding from
/// `bindings`. Recurses through List/Task/FnTyped/Enum/Union
/// constructors so a generic `Result<T, E>` returns the
/// substituted shape.
export fn tc_subst_vtype(ty: ValueType, bindings: List<TypeArg>) -> ValueType {
    // A type whose display name is a bound param resolves to its binding;
    // every other variant recurses structurally into its ValueType children
    // via the derived ValueType.map — which covers the Tuple / Newtype
    // members the hand-rolled match silently dropped (so a generic
    // `(T, int)` return now substitutes T instead of leaking it downstream).
    let bound = tc_type_arg_lookup(bindings, vtype_display(ty))
    if !vtype_is_unknown(bound) { return bound }
    ty.map((c) -> tc_subst_vtype(c, bindings))
}

/// Lookup a binding by type-param name. Returns `Unknown` on miss
/// so `tc_subst_vtype` can detect "not bound" via `vtype_is_unknown`.
/// Walks head-to-tail so the cons-prepend semantics in `tc_unify`
/// hold (innermost / most-recent binding wins).
fn tc_type_arg_lookup(args: List<TypeArg>, name: string) -> ValueType {
    for entry in args {
        if entry.param_name == name { return entry.concrete_vt }
    }
    ValueType.Unknown
}

/// Project each declared type-param's binding, in declared order, out of an
/// inference accumulator — an unbound param yields Unknown so the positional zip
/// with the params stays aligned at field-access time. This is the shared tail of
/// tc_infer_struct_type_args and tc_infer_enum_ctor_type_args; they differ only in
/// how they FOLD the args into `bindings` (by field name vs positionally), not in
/// this projection.
fn tc_project_type_args(tp: List<TypeParamEntry>, bindings: List<TypeArg>) -> List<ValueType> {
    mut out: List<ValueType> = []
    for p in tp {
        out.push(tc_type_arg_lookup(bindings, p.name))
    }
    out
}

/// Infer a generic struct construction's type args by unifying each
/// field's declared type against its initializer's actual type — the
/// typeck-side mirror of the monomorphizer's construction inference.
/// Returns empty for non-generic structs (so the common case stays a
/// single cheap registry probe). Bindings come back in declared
/// type-param order; an unbound param yields Unknown so the positional
/// zip with the params stays aligned at field-access time.
export fn tc_infer_struct_type_args(tc: TC, name: string, inits: List<FieldInit>) -> List<ValueType> {
    let tps = struct_type_params(tc.structs, name)
    let empty: List<ValueType> = []
    if tps.length == 0 { return empty }
    let fields = struct_type_lookup(tc.structs, name)
    if fields.length == 0 { return empty }
    mut acc: List<TypeArg> = []
    for init in inits {
        let fdecl = resolve_vtype(tc, field_type_lookup(fields, init.name))
        if !vtype_is_unknown(fdecl) {
            let vty = tc_arg_concrete_ty(tc, tc.nodes.sexpr_of(init.value_id))
            acc = tc_unify(tps, fdecl, vty, acc)
        }
    }
    tc_project_type_args(tps, acc)
}

/// The ValueType of a non-anonymous struct literal `Name { inits }`.
/// A generic struct carries its inferred type args; a
/// non-generic one is the bare `Struct(name, [], 0)`.
export fn tc_struct_lit_vtype(tc: TC, name: string, inits: List<FieldInit>) -> ValueType {
    ValueType.Struct(name, tc_infer_struct_type_args(tc, name, inits), 0)
}

/// Type-check a `Call` expression. Routes to `check_method_call`
/// for `obj.method(args)`, otherwise falls through to
/// `tc_check_fn_call_with` after resolving the callee name.
fn check_call(tc: TC, callee: Expr, args: List<SExpr>) -> ExprResult {
    check_call_with_expected(tc, callee, args, ValueType.Unknown)
}

/// Typecheck `f::<T, U>(args)` — explicit-type-arg generic call.
/// Pre-so07.7.1: GenericCall typeck dropped the type-args and
/// delegated to check_call, leaving generic return types as
/// Unknown. The W1 derive_walker rewrite emits GenericCall to make
/// mono's inference unambiguous; this path now matches by carrying
/// the user-supplied bindings through tc_subst_vtype on ret_ty.
fn check_generic_call(tc: TC, callee: Expr, type_args: List<string>, args: List<SExpr>) -> ExprResult {
    let name = match callee {
        .Ident(n) -> n
        .QualifiedIdent(n) -> n
        _ -> ""
    }
    if name == "" { return check_call(tc, callee, args) }
    let checked = check_expr_list(tc, args)
    let r = fn_type_get(checked.fns, name)
    if !r.found { return tc_er(checked, .Unknown) }
    if r.tp.length == 0 || type_args.length == 0 {
        // Non-generic fn or empty explicit-args — fall through to
        // the inference path so the regular F1002 / arg-type checks
        // still fire.
        return tc_check_fn_call_with(checked, name, args, r)
    }
    // Pair the declared type-params with the explicit args and
    // substitute into the return type. Extra args are ignored;
    // missing args fall back to the param's name (resolved as
    // Struct(name, 0) by vtype_from_name) which then either matches
    // a concrete type via name-suffix tolerance or leaves Unknown.
    mut bindings: List<TypeArg> = []
    let n = if r.tp.length < type_args.length { r.tp.length } else { type_args.length }
    for i in 0..n {
        bindings.push(TypeArg { param_name: r.tp[i].name, concrete_vt: resolve_vtype(checked, vtype_from_name(type_args[i])) })
    }
    // Gate args against the params INSTANTIATED with the explicit type-args
    // (mirrors the regular call path) so `g<string>([1])` into an int param —
    // and `id<string>(9)` into a `T`-typed param now bound to string — are both
    // caught. Passing raw `r.params` would leave `T` unresolved and slip past.
    let arg_checked = tc_check_newtype_args(checked, name, subst_param_types(r.params, bindings), args, r.is_extern)
    tc_er(arg_checked, tc_subst_vtype(r.ret_ty, bindings))
}

/// Bidirectional variant — accepts the caller's expected return type
/// and threads it through tc_check_fn_call_with_expected so generic
/// inference can pull type-args from the return position (so07.7.15).
fn check_call_with_expected(tc: TC, callee: Expr, args: List<SExpr>, expected: ValueType) -> ExprResult {
    match callee {
        .Ident(name) -> {
            // For `string(arg)` we need the typed arg list so we can
            // F1003 if arg is a struct/enum without display().
            // Other built-ins / user fns fall back to the type-less
            // check_expr_list path.
            if name == "string" {
                let typed = check_expr_list_types(tc, args)
                let checked = display_check_arg(typed.tc, typed.types, args)
                return tc_er(checked, .Str)
            }
            // Force-unwrap builtin (`expr!`): yields the non-optional inner.
            if name == FORCE_UNWRAP_FN {
                let typed = check_expr_list_types(tc, args)
                let arg_ty = if typed.types.length > 0 { typed.types[0] } else { ValueType.Unknown }
                return tc_er(typed.tc, vtype_strip_optional(arg_ty))
            }
            let checked = check_expr_list(tc, args)
            // Built-in functions
            match name {
                "int"    -> return tc_er(checked, .Int)
                "println" or "eprintln" or "print" or "eprint" -> return tc_er(checked, .Void)
                _ -> {}
            }
            // User-defined function
            let r = fn_type_get(checked.fns, name)
            if r.found {
                return tc_check_fn_call_with_expected(checked, name, args, r, expected)
            }
            // Variable holding a closure
            let var_ty = type_lookup(checked.types, name)
            if vtype_is_unknown(var_ty) {
                return tc_er(checked, .Unknown)
            }
            tc_er(checked, vtype_fn_ret(var_ty))
        }
        .QualifiedIdent(path) -> {
            let checked = check_expr_list(tc, args)
            let r = fn_type_get(checked.fns, path)
            if r.found {
                return tc_check_fn_call_with_expected(checked, path, args, r, expected)
            }
            tc_er(checked, .Unknown)
        }
        .FieldAccess(obj, method) -> check_method_call(tc, tc.nodes.exprs.get(obj), method, args)
        _ -> {
            // Expression callee (e.g. compose(f,g)(x))
            let c = check_expr(tc, callee)
            let checked = check_expr_list(c.tc, args)
            tc_er(checked, vtype_fn_ret(c.ty))
        }
    }
}

// ── Method call type inference ──

/// Type-check `obj.method(args)`: dispatch to type-specific
/// method tables (List / Map built-ins) or fall back to user-
/// defined impl blocks looked up by mangled name.
/// Guard a collection MUTATION method's value arg against the element/value
/// type — `push(v)` / `set(i,v)` / `insert(i,v)` / map `set(k,v)` value args
/// were previously unchecked (ibjo), so a `Box<int>` into a `List<Box<string>>`
/// (or a map value slot) compiled as a wild store. The value-arg position is
/// method-dependent (push: 0; set/insert: 1 — after the index/key). Reuses the
/// same generic-arg + scalar↔ptr predicates as the let/fn-arg/field positions.
/// `arg_types` are precomputed (check_method_call already checked the args once),
/// so this re-checks nothing and can't double-report.
fn check_collection_value_arg(tc: TC, arg_types: List<ValueType>, method: string, elem: ValueType) -> TC {
    let idx = if method == "push" { 0 } else if (method == "set") || (method == "insert") { 1 } else { -1 }
    if idx < 0 || idx >= arg_types.length { return tc }
    // The mutation value arg meets the collection's element/value type — the same
    // "value meets expected type" shape as every other slot, so route it through
    // the single assignability gate (nlzq).
    check_assign_layout(tc, arg_types[idx], elem, "`${method}` value")
}

export fn check_method_call(tc: TC, obj: Expr, method: string, args: List<SExpr>) -> ExprResult {
    let o = check_expr(tc, obj)
    let ca = check_expr_list_types(o.tc, args)
    let checked_args = ca.tc

    // String methods
    if vtype_eq(o.ty, .Str) {
        match method {
            "length" or "index_of" or "char_code" or "byte" -> return tc_er(checked_args, .Int)
            "substring" or "trim" or "upper" or "lower" or "replace"
            or "to_upper" or "to_lower" -> return tc_er(checked_args, .Str)
            "contains" or "starts_with" or "ends_with" -> return tc_er(checked_args, .Bool)
            "split" -> return tc_er(checked_args, .List(ValueType.Str))
            _ -> {}
        }
    }

    // Bytes methods. Surface mirrors string's where it makes sense
    // (length, byte access) but bytes-returning ops yield ValueType.Bytes
    // so the type system enforces the nominal distinction.
    if vtype_eq(o.ty, .Bytes) {
        match method {
            "length" or "byte" -> return tc_er(checked_args, .Int)
            "concat" or "slice" -> return tc_er(checked_args, .Bytes)
            "to_string" -> return tc_er(checked_args, .Str)
            _ -> {}
        }
    }

    // List methods — dispatched to features/list_lit/typeck.av
    if o.ty is .List {
        let elem = vtype_list_elem(o.ty)
        // ibjo: guard push/set/insert value args against the element type.
        return check_list_method(check_collection_value_arg(checked_args, ca.types, method, elem), elem, method, args)
    }

    // Map methods — dispatched to features/map_lit/typeck.av
    if o.ty is .Map {
        // ibjo: guard set's value arg against the map's value type.
        return check_map_method(check_collection_value_arg(checked_args, ca.types, method, vtype_map_value(o.ty)), method)
    }

    // Channel methods — dispatched to features/channels/typeck.av
    match o.ty {
        .Channel(elem) -> return check_channel_method(checked_args, elem, method, args)
        _ -> {}
    }

    // Method lookup — look up in fn registry as TypeName__method.
    // Works for structs, enums, newtypes, and trait types.
    let type_name = match o.ty {
        .Struct(n, _, _) -> n
        .Enum(n, _, _) -> n
        .Newtype(n, _, _) -> n
        .Trait(n, _) -> n
        _ -> ""
    }
    if type_name.length > 0 {
        let qualified = method_mangled_name(type_name, method)
        let r = fn_type_get(checked_args.fns, qualified)
        if r.found {
            // y9y4.16: for generic methods (fn Type__name<S>(self, ...)),
            // substitute S from the user-visible args before returning
            // ret_ty. params[0] is `self`; user-visible args align with
            // params[1..]. Pre-fix: ret_ty came back unsubstituted, so
            // `t.fold(0, f)` typed as `S` and `string(t.fold(...))`
            // fired F1003. Mirror of tc_check_fn_call_with's free-fn
            // substitution, projected to drop self.
            // Gate user args against params[1..] (drop self, which dispatch
            // already bound) so `obj.m([1])` into a concrete int param is caught
            // — this user-defined method path otherwise never reached the param
            // gate. A receiver-bound type param (`Box<string>.m(9)`, where the
            // method's `x: T` gets T from the receiver) is instantiated first:
            // tc_recv_type_bindings binds T from the receiver's concrete
            // type_args and subst_param_types refines the gated params, so `x: T`
            // is checked as `x: string` and `gc_string.push_one(9)` is caught.
            // Gate-local on purpose — the global tc_unify (fn-call inference +
            // mono) is left untouched, so emitted IR / the HRN diff-test are
            // unaffected; this only adds rejections for invalid programs.
            // Receiver-bound analog of the explicit-type-arg `id<string>(9)` fix
            // (#539, also subst_param_types).
            let recv_bindings = tc_recv_type_bindings(checked_args, o.ty)
            let gated_params = subst_param_types(method_params_without_self(r.params), recv_bindings)
            let arg_checked = tc_check_newtype_args(checked_args, qualified, gated_params, args, r.is_extern)
            // Substitute the return type from the ARGS first (method-level type
            // params, y9y4.16), then FILL any receiver-bound type param the args
            // left unresolved from the receiver's concrete type_args. A method
            // returning a bare impl type param — `Box<V> { fn get(self) -> V }`
            // called on a `Box<int>` — has no arg to bind V, so without this it
            // came back as the unsubstituted `V` and `fn f(b: Box<int>) -> int {
            // b.get() }` fired a bogus F1000 (body produces `V`). Receiver fill
            // is the return-type analog of the param-gate's subst_param_types
            // (rs0b): same recv_bindings, applied AFTER arg substitution so it
            // only fills gaps and never overrides an arg-bound param (the
            // fill-only discipline used everywhere else here). tc_subst_vtype is
            // a no-op once a param is concrete, so already-resolved programs are
            // unaffected — this only resolves types that were previously left
            // generic, accepting valid programs that were wrongly rejected.
            let arg_ret = tc_subst_generic_method_ret(arg_checked, r.tp, r.params, args, r.ret_ty)
            let resolved_ret = tc_subst_vtype(arg_ret, recv_bindings)
            return tc_er(arg_checked, resolved_ret)
        }
    }

    // UAP (vez6.13): when no impl method exists, look for a fn-typed
    // struct field with the same name and use its return type as the
    // call's result type. Codegen already implements the field-fn
    // dispatch path; this just keeps typecheck from emitting Unknown
    // (which would cascade Unknown through callers and lose info).
    // Methods always win over fields: we only reach this branch if
    // the impl-method lookup above missed.
    match o.ty {
        .Struct(struct_name, _, _) -> {
            let fields = struct_type_lookup(checked_args.structs, struct_name)
            let field_ty = field_type_lookup(fields, method)
            if vtype_is_fn(field_ty) {
                return tc_er(checked_args, vtype_fn_ret(field_ty))
            }
        }
        _ -> {}
    }

    // Fallback — return Unknown for unknown methods
    tc_er(checked_args, .Unknown)
}

// ── Block expression type ──

/// Type-check a block as an expression — the block's value is
/// the value of its last statement (when that's an Expr stmt) or
/// Void otherwise.
fn check_block(tc: TC, stmts: List<SStmt>) -> ExprResult {
    let inner = tc_enter(tc)
    let pair = check_block_stmts(inner, stmts)
    let after = tc_exit(pair.tc)
    tc_er(after, pair.ty)
}

/// Implementation of `check_block` — walks every stmt, returning
/// the last one's value type as the block's type.
fn check_block_stmts(tc: TC, stmts: List<SStmt>) -> ExprResult {
    if stmts.length == 0 { return tc_er(tc, .Void) }
    mut cur = tc
    mut i = 0
    let last = stmts.length - 1
    while i < last {
        avra_ice_at(stmts[i].file, stmts[i].line, stmts[i].col)
        cur = check_stmt(cur, stmts[i].node)
        i = i + 1
    }
    // Last statement — its type is the block's type
    let ss = stmts[last]
    avra_ice_at(ss.file, ss.line, ss.col)
    match ss.node {
        .Expr(e) -> check_expr(cur, tc.nodes.exprs.get(e))
        _ -> {
            let checked = check_stmt(cur, ss.node)
            tc_er(checked, .Void)
        }
    }
}

// ── Helpers ──

/// Type-check every expression in `exprs` for side effects only —
/// drops the inferred types. Use `check_expr_list_types` when the
/// caller needs the resulting type list.
export fn check_expr_list(tc: TC, exprs: List<SExpr>) -> TC {
    mut current = tc
    for se in exprs {
        current = check_expr(current, se.node).tc
    }
    current
}

/// Output of `check_expr_list_types` — the threaded TC plus the
/// inferred `List<ValueType>` for the input expressions, in source
/// order.
type ExprListResult = {
    tc: TC,
    types: List<ValueType>,
}

/// Type-check every expression in `exprs` and return the list of
/// inferred types alongside the updated TC. Used by call-site
/// arity / per-arg type checks.
/// Last-resort type inference for a `string(arg)` argument when
/// check_expr returned Unknown. Inspects the source Expr shape:
///
/// - bare Ident: look up in the type env (`tc.types`).
/// - EnumCtor: return the constructor's enum type.
/// - StructLit: return the struct type.
///
/// Returns Unknown if none of these apply; the caller short-
/// circuits without emitting F1003 in that case.
fn infer_arg_for_display(tc: TC, expr: Expr) -> ValueType {
    match expr {
        .Ident(name) -> type_lookup(tc.types, name)
        .EnumCtor(tn, _, _) -> if tn != "" {
            let empty_args: List<ValueType> = []
            ValueType.Enum(tn, empty_args, 0)
        } else { ValueType.Unknown }
        .StructLit(name, inits) -> if name != "" { tc_struct_lit_vtype(tc, name, inits) } else { ValueType.Unknown }
        // Shortcut #4 typeck-side: parens-less `EnumType.Variant`
        // parses as FieldAccess(Ident, "Variant"). If the head
        // Ident is a registered enum name, the access is the
        // payload-less ctor — recover the enum type so
        // display_check_arg can fire F1003. Doesn't disturb the
        // parser; safer than changing the AST shape globally.
        .FieldAccess(obj, _) -> match tc.nodes.exprs.get(obj) {
            .Ident(type_name) -> if enum_type_has(tc.enums, type_name) {
                let empty_args: List<ValueType> = []
                ValueType.Enum(type_name, empty_args, 0)
            } else {
                ValueType.Unknown
            }
            _ -> ValueType.Unknown
        }
        _ -> ValueType.Unknown
    }
}

/// nce6.1 / bfdq follow-up: if `string(arg)` is called with arg
/// typed as a struct/enum that doesn't define
/// `fn display(self) -> string`, emit F1003 (MissingDisplay) via
/// the bag. The codegen-level check in fn_decl/codegen.av stays
/// as a backstop, but emitting here gives the user a proper
/// typecheck-coded diagnostic instead of an F9999 (ICE).
fn display_check_arg(tc: TC, types: List<ValueType>, args: List<SExpr>) -> TC {
    let arg_ty = if types.length > 0 { types[0] } else { ValueType.Unknown }
    // Fallback when check_expr returned Unknown (a separate
    // let-binding inference gap drops enum-typed locals to
    // Unknown; the EnumCtor / StructLit literal forms below
    // catch the common shape). The right long-term fix is
    // tightening the let-binding inference.
    let resolved_ty = if vtype_is_unknown(arg_ty) {
        if args.length > 0 { infer_arg_for_display(tc, args[0].node) } else { arg_ty }
    } else {
        arg_ty
    }
    let owner = vtype_struct_name(resolved_ty)
    let enum_owner = vtype_enum_name(resolved_ty)
    let type_name = if owner != "" { owner } else { enum_owner }
    if type_name == "" { return tc }
    // Skip Result and other generic-instantiated enums — they pass
    // through string() as part of error-message formatting elsewhere
    // and aren't user-display-required.
    if is_result_enum_name(type_name) { return tc }
    let mangled = method_mangled_name(type_name, "display")
    let lookup = fn_type_get(tc.fns, mangled)
    if lookup.found { return tc }
    // No display method — emit F1003 with the first arg's span.
    let span = if args.length > 0 {
        let se = args[0]
        span_new(0, 0, se.line, se.col)
    } else {
        span_dummy()
    }
    let kind = if owner != "" { "type" } else { "enum" }
    let dollar_brace = "$" + "{"
    let msg = "${kind} `${type_name}` cannot be converted to string — `string(value)` and `" + dollar_brace + "value}` interpolation require a `fn display(self) -> string` method"
    tc with { bag: bag_report(tc.bag, diag_error(DiagCode.MissingDisplay, msg, span)) }
}

export fn check_expr_list_types(tc: TC, exprs: List<SExpr>) -> ExprListResult {
    mut cur_tc = tc
    mut types: List<ValueType> = []
    for se in exprs {
        let r = check_expr(cur_tc, se.node)
        cur_tc = r.tc
        types.push(r.ty)
    }
    ExprListResult { tc: cur_tc, types }
}

// ── Pass 3: Type annotation ──
// Walks the AST and stamps resolved ValueTypes onto SExpr.ty fields.
// Uses the TC state populated by Pass 1+2 (all bindings are in scope).

/// Annotation-pass scope-enter: bind every param into the type env
/// at the new depth. Mirror of `tc_bind_params` for the second
/// pass that writes types back into the AST.
fn annotate_enter_fn(tc: TC, params: List<ParamEntry>) -> TC {
    tc_bind_params(tc_enter(tc), params)
}

/// Annotation-pass let-binding: re-infer the initializer's type
/// (mostly free since the check pass already did the work) and
/// register the binding for downstream lookups.
fn annotate_bind(tc: TC, name: string, ty_vt: ValueType, init: Expr) -> TC {
    let r = check_expr(tc, init)
    let declared_ty = if !vtype_is_unknown(ty_vt) { resolve_vtype(tc, ty_vt) } else { r.ty }
    tc_bind(tc, name, declared_ty)
}

/// Thread the annotate scope across one statement: bindings flow into
/// their successors' lookups (shared by the wrapped and row walks).
fn annotate_scope_step(cur: TC, node: Stmt) -> TC {
    match node {
        .Let(name, ty_vt, init) -> annotate_bind(cur, name, ty_vt, cur.nodes.exprs.get(init))
        .Mut(name, ty_vt, init) -> annotate_bind(cur, name, ty_vt, cur.nodes.exprs.get(init))
        .Const(name, ty_vt, init) -> annotate_bind(cur, name, ty_vt, cur.nodes.exprs.get(init))
        // Destructured names need to flow into the annotate
        // scope too, otherwise later `.field` accesses on
        // destructured tuple elements see Unknown and ICE
        // at codegen.
        .LetDestructure(names, init) -> bind_destructure(cur, names, check_expr(cur, cur.nodes.exprs.get(init)).ty)
        _ -> cur
    }
}

/// Annotate the program's root rows — the id-native annotation walk
/// (`typecheck_program` pass 3): rewritten rows re-allocate,
/// inheriting positions.
fn annotate_stmt_ids(tc: TC, ids: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    mut cur = tc
    for id in ids {
        let node = tc.nodes.stmts.get(id)
        out.push(tc.nodes.restmt(annotate_stmt(cur, node), id))
        cur = annotate_scope_step(cur, node)
    }
    out
}

/// Per-stmt branch of the annotation pass.
fn annotate_stmt(tc: TC, stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, vt, annotate_expr_id(tc, init))
        .Mut(name, vt, init) -> .Mut(name, vt, annotate_expr_id(tc, init))
        .Const(name, vt, init) -> .Const(name, vt, annotate_expr_id(tc, init))
        .Expr(e) -> .Expr(annotate_expr_id(tc, e))
        .Return(val) -> .Return(annotate_expr_id(tc, val))
        .Block(body) -> .Block(annotate_stmt_ids(tc, body))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(annotate_expr_id(tc, cond), annotate_stmt_id(tc, then_b), annotate_stmt_id(tc, else_b!))
            } else {
                .If(annotate_expr_id(tc, cond), annotate_stmt_id(tc, then_b), null)
            }
        }
        .While(cond, body) -> .While(annotate_expr_id(tc, cond), annotate_stmt_id(tc, body))
        .For(v, start, end, body) -> {
            // For-loop binds the counter as Int — scope it for the
            // body so method-call rewrite (y9y4.16) sees the right
            // type when the body references v.method(...).
            let new_start = annotate_expr_id(tc, start)
            let new_end = annotate_expr_id(tc, end)
            let inner = tc_bind(tc, v, .Int)
            .For(v, new_start, new_end, annotate_stmt_id(inner, body))
        }
        .ForIn(v, coll, body) -> {
            // for-in over List<X> binds v as X. y9y4.16: needed so
            // `for c in t.children() { c.method(...) }` annotate
            // can resolve c's type and fire the method-call rewrite.
            let new_coll = annotate_expr_id(tc, coll)
            let coll_ty = check_expr(tc, tc.nodes.exprs.get(coll)).ty
            let elem_ty = vtype_list_elem(coll_ty)
            let inner = tc_bind(tc, v, elem_ty)
            .ForIn(v, new_coll, annotate_stmt_id(inner, body))
        }
        .Function(name, tp, params, rvt, body) ->
            .Function(name, tp, params, rvt, annotate_stmt_ids(annotate_enter_fn(tc, params), body))
        .Match(subj, arms) -> .Match(annotate_expr_id(tc, subj), annotate_match_arms(tc, arms))
        .Module(name, body) -> .Module(name, annotate_stmt_ids(tc, body))
        .Annotated(annots, inner) -> .Annotated(annots, annotate_stmt_id(tc, inner))
        .Impl(name, methods) -> .Impl(name, annotate_stmt_ids(tc, methods))
        .Defer(body) -> .Defer(annotate_expr_id(tc, body))
        .LetDestructure(names, init) -> .LetDestructure(names, annotate_expr_id(tc, init))
        .ThenBlock(name, cond) -> .ThenBlock(name, annotate_expr_id(tc, cond))
        // A spec/given body is a statement list like any other block; descend so
        // the `then` conditions (and any `let`s they reference) get their nested
        // SExprs stamped. Without this the annotate pass stopped at the spec
        // boundary, so a generic struct/enum constructed inside a `then` had no
        // field-value `.ty` for mono to infer a type param from — the same
        // construction in a top-level fn body (which IS annotated) worked.
        .SpecBlock(name, body) -> .SpecBlock(name, annotate_stmt_ids(tc, body))
        .GivenBlock(name, body) -> .GivenBlock(name, annotate_stmt_ids(tc, body))
        .Parallel(body) -> .Parallel(annotate_stmt_ids(tc, body))
        // A select arm is a block that binds the recv value, exactly like
        // for-in binds the loop var — descend so a generic construction in an
        // arm body gets its SExprs stamped (mirrors select_check's binding).
        .Select(arms) -> .Select(annotate_select_arms(tc, arms))
        _ -> stmt  // ReturnEmpty, NoOp, Break, Continue, ExternFn, TypeDecl, EnumDecl, TraitDecl, Use
    }
}

/// Row twins for the annotate pass: resolve, annotate, re-allocate.
fn annotate_stmt_id(tc: TC, id: StmtId) -> StmtId {
    tc.nodes.restmt(annotate_stmt(tc, tc.nodes.stmts.get(id)), id)
}

fn annotate_expr_id(tc: TC, id: ExprId) -> ExprId {
    tc.nodes.reexpr(annotate_expr(tc, tc.nodes.exprs.get(id)), id)
}

/// Annotate each select arm: bind the recv value to the channel's element type
/// (mirroring `select_check`) so a generic construction in an arm body gets its
/// SExprs stamped. The same hole the spec/given descent fixed, for `select`.
fn annotate_select_arms(tc: TC, arms: List<SelectArm>) -> List<SelectArm> {
    mut out: List<SelectArm> = []
    for arm in arms {
        // F4d: annotate the arena chan/body ids and stamp the chan's resolved
        // type into `arg_tys` (mirrors annotate_match_arms).
        let chan_ann = annotate_sexpr(tc, tc.nodes.sexpr_of(arm.chan_id))
        let new_chan_id = tc.nodes.reexpr(chan_ann.node, arm.chan_id)
        tc.nodes.set_arg_ty(new_chan_id, chan_ann.ty)
        let elem = match check_expr(tc, tc.nodes.exprs.get(arm.chan_id)).ty {
            .Channel(e) -> e
            _ -> ValueType.Unknown
        }
        let inner = tc_bind(tc, arm.binding, elem)
        out.push(SelectArm { binding: arm.binding, chan_id: new_chan_id, body_ids: annotate_stmt_ids(inner, arm.body_ids) })
    }
    out
}

// Recursively annotate SExpr-containing sub-structures within an Expr.
/// Recurse into nested expressions, threading the TC so SExprs
/// emerge with their `.ty` populated.
fn annotate_expr(tc: TC, expr: Expr) -> Expr {
    match expr {
        .Call(callee, args) -> annotate_call(tc, callee, args)
        .GenericCall(callee, ta, args) -> .GenericCall(tc.nodes.reexpr(annotate_expr(tc, tc.nodes.exprs.get(callee)), callee), ta, annotate_expr_list_ids(tc, args))
        .EnumCtor(tn, v, args) -> .EnumCtor(tn, v, annotate_expr_list_ids(tc, args))
        .StructLit(name, inits) -> .StructLit(name, annotate_field_inits(tc, inits))
        .MatchExpr(subj, arms) -> .MatchExpr(annotate_expr_id(tc, subj), annotate_match_arms(tc, arms))
        .ListLit(elems) -> .ListLit(annotate_expr_list_ids(tc, elems))
        .Tuple(elems) -> .Tuple(annotate_expr_list_ids(tc, elems))
        .MapLit(entries) -> .MapLit(annotate_expr_list_ids(tc, entries))
        .With(obj, inits) -> .With(annotate_expr_id(tc, obj), annotate_field_inits(tc, inits))
        .Block(body) -> .Block(annotate_stmt_ids(tc, body))
        .Binary(l, op, r) -> .Binary(annotate_expr_id(tc, l), op, annotate_expr_id(tc, r))
        .Logical(l, op, r) -> .Logical(annotate_expr_id(tc, l), op, annotate_expr_id(tc, r))
        .Unary(op, e) -> .Unary(op, annotate_expr_id(tc, e))
        .Grouping(e) -> .Grouping(annotate_expr_id(tc, e))
        .IfExpr(c, t, e) -> .IfExpr(annotate_expr_id(tc, c), annotate_expr_id(tc, t), annotate_expr_id(tc, e))
        .Index(obj, idx) -> .Index(annotate_expr_id(tc, obj), annotate_expr_id(tc, idx))
        .FieldAccess(obj, f) -> .FieldAccess(annotate_expr_id(tc, obj), f)
        .Assign(name, val) -> .Assign(name, annotate_expr_id(tc, val))
        .FieldAssign(obj, f, val) -> .FieldAssign(annotate_expr_id(tc, obj), f, annotate_expr_id(tc, val))
        .Lambda(params, body) -> .Lambda(params, annotate_expr_id(tc_bind_params(tc, params), body))
        .NullCoalesce(l, r) -> .NullCoalesce(annotate_expr_id(tc, l), annotate_expr_id(tc, r))
        .Try(e) -> .Try(annotate_expr_id(tc, e))
        .Slice(obj, start, end) -> .Slice(annotate_expr_id(tc, obj), annotate_expr_id(tc, start), annotate_expr_id(tc, end))
        .IsCheck(subj, vname) -> .IsCheck(annotate_expr_id(tc, subj), vname)
        .InCheck(needle, items) -> .InCheck(annotate_expr_id(tc, needle), annotate_expr_list_ids(tc, items))
        .ListComp(body, var, coll, filter) -> {
            if filter != null {
                .ListComp(annotate_expr_id(tc, body), var, annotate_expr_id(tc, coll), annotate_expr_id(tc, filter!))
            } else {
                .ListComp(annotate_expr_id(tc, body), var, annotate_expr_id(tc, coll), null)
            }
        }
        .Catch(inner, b, body, cl, cc) -> .Catch(annotate_expr_id(tc, inner), b, annotate_expr_id(tc, body), cl, cc)
        .OptionalChain(obj, f) -> .OptionalChain(annotate_expr_id(tc, obj), f)
        .OptionalMethodCall(obj, m, args) -> .OptionalMethodCall(annotate_expr_id(tc, obj), m, annotate_expr_list_ids(tc, args))
        .TupleIndex(obj, idx) -> .TupleIndex(annotate_expr_id(tc, obj), idx)
        .When(arms) -> .When(annotate_when_arms(tc, arms))
        .Spawn(body) -> .Spawn(annotate_expr_id(tc, body))
        .Isolated(body) -> .Isolated(annotate_expr_id(tc, body))
        .ChannelNew(elem, capacity) -> {
            if capacity == null { expr } else { .ChannelNew(elem, annotate_expr_id(tc, capacity!)) }
        }
        _ -> expr  // Leaf expressions: Number, String, Bool, Null, Ident, FloatLit, QualifiedIdent
    }
}

/// Annotate a Call expression. y9y4.16: rewrites generic-method
/// calls (`t.fold(0, f)` where `Tree__fold<S>` is a registered
/// generic free-fn) to the equivalent free-fn call
/// (`Tree__fold(t, 0, f)`). Mono then handles the instantiation
/// + name-mangling exactly the way it does for direct free-fn
/// calls — no separate mono-side method-dispatch path required.
/// Non-method calls + non-generic method calls pass through
/// unchanged.
fn annotate_call(tc: TC, callee: ExprId, args: List<ExprId>) -> Expr {
    let rewritten = method_to_free_fn_call(tc, callee, args)
    if rewritten != null { return rewritten! }
    let new_callee = tc.nodes.reexpr(annotate_expr(tc, tc.nodes.exprs.get(callee)), callee)
    Expr.Call(new_callee, annotate_expr_list_ids(tc, args))
}

/// Try to rewrite `obj.method(args)` to `Type__method(obj, args)`
/// when Type__method is a registered generic free-fn. Returns null
/// when the rewrite doesn't apply (non-method call, obj's type
/// not nominal, no matching generic free-fn).
fn method_to_free_fn_call(tc: TC, callee: ExprId, args: List<ExprId>) -> Expr? {
    match tc.nodes.exprs.get(callee) {
        .FieldAccess(obj, method) -> {
            let o = check_expr(tc, tc.nodes.exprs.get(obj))
            let type_name = match o.ty {
                .Struct(n, _, _) -> n
                .Enum(n, _, _) -> n
                .Newtype(n, _, _) -> n
                _ -> ""
            }
            if type_name == "" { return null }
            let mangled = method_mangled_name(type_name, method)
            let r = fn_type_get(tc.fns, mangled)
            // Only rewrite for GENERIC methods — the non-generic
            // case dispatches cleanly through codegen's existing
            // emit_method_call (which prepends self at the call
            // site without needing a syntactic rewrite).
            if !r.found || r.tp.length == 0 { return null }
            let annotated_obj = annotate_expr(tc, tc.nodes.exprs.get(obj))
            // Prepend `self` as an arena arg row carrying its receiver type
            // (the id twin of the old `sexpr_typed(obj, .., o.ty)` self-slot) so
            // the monomorphizer, materializing args via `sexprs_of`, reads it.
            let self_id = tc.nodes.exprs.add_leaf(annotated_obj)
            tc.nodes.set_arg_ty(self_id, o.ty)
            mut new_args: List<ExprId> = [self_id]
            for a_id in annotate_expr_list_ids(tc, args) {
                new_args.push(a_id)
            }
            Expr.Call(tc.nodes.exprs.add_leaf(Expr.Ident(mangled)), new_args)
        }
        _ -> null
    }
}

/// Run `check_expr` on `se.node`, write the inferred type back to
/// `se.ty`, and recurse into the inner Expr.
fn annotate_sexpr(tc: TC, se: SExpr) -> SExpr {
    // Annotate the inner expression tree (recurse into sub-expressions)
    let annotated_node = annotate_expr(tc, se.node)
    // Stamp this SExpr's type — fast path for common expressions avoids
    // re-running check_expr (which would double-check the entire subtree).
    let ty = match annotated_node {
        .Number(_) -> ValueType.Int
        .FloatLit(_) -> ValueType.Float
        .String(_) -> ValueType.Str
        .Bool(_) -> ValueType.Bool
        .None -> ValueType.Void
        .Ident(name) -> type_lookup(tc.types, name)
        // Comparison operators always return Bool
        .Binary(_, op, _) if binop_is_comparison(op) -> ValueType.Bool
        .Logical(_, _, _) -> ValueType.Bool
        // Arithmetic binary/unary: fall through to check_expr for float handling
        // Unary: falls through to check_expr for correct float handling
        // Call: look up return type from function registry
        .Call(callee, args) -> match tc.nodes.exprs.get(callee) {
            .Ident(name) -> {
                let rec = fn_type_get(tc.fns, name)
                tc_subst_generic_ret(tc, rec.tp, rec.params, tc.nodes.sexprs_of(args), rec.ret_ty)
            }
            .QualifiedIdent(name) -> {
                let rec = fn_type_get(tc.fns, name)
                tc_subst_generic_ret(tc, rec.tp, rec.params, tc.nodes.sexprs_of(args), rec.ret_ty)
            }
            _ -> check_expr(tc, se.node).ty
        }
        // Struct/Enum constructors. A generic struct literal carries
        // its inferred type args so a downstream `s.value`
        // specialises `T` to the instance arg.
        .StructLit(name, inits) -> if name != "" { tc_struct_lit_vtype(tc, name, inits) } else { vtype_struct(name, 0) }
        .EnumCtor(name, _, _) -> {
            if name != "" {
                let empty_args: List<ValueType> = []
                ValueType.Enum(name, empty_args, 0)
            } else { check_expr(tc, se.node).ty }
        }
        .ListLit(elements) -> ValueType.List(tc_first_elem_ty(tc, tc.nodes.sexprs_of(elements)))
        .MapLit(entries) -> ValueType.Map(ValueType.Str, tc_first_map_value_ty(tc, tc.nodes.sexprs_of(entries)))
        // Build the tuple type from the already-annotated elements'
        // stamped `.ty` (annotate_expr recursed into them). Typing the
        // literal as an empty Tuple lost the element types, which broke
        // structural type-param inference through a tuple-typed param/field.
        .Tuple(elems) -> ValueType.Tuple(list_map(tc.nodes.sexprs_of(elems), (e: SExpr) -> e.ty))
        // Lambda body type needs a real check — fall through. Cheap
        // because annotate_expr already walked the body recursively.
        .Lambda(params, body) -> ValueType.FnTyped(tc_param_types(params), check_expr(tc, tc.nodes.exprs.get(body)).ty)
        // Grouping forwards its inner expression's type. Used heavily
        // by parser-emitted parenthesised forms; falling through to
        // check_expr was a needless re-walk.
        .Grouping(inner) -> annotate_sexpr_ty(tc, tc.nodes.exprs.get(inner))
        // Range forms always produce an Int range (codegen doesn't
        // distinguish further). Avoids check_expr on every range-for.
        .Range(_, _) -> ValueType.Int
        .RangeIncl(_, _) -> ValueType.Int
        // Index/FieldAccess/Unary still need check_expr because the
        // type depends on registry/operand state — but field/method
        // calls inside InterpString are usually leaf-ish, so do them
        // directly. InterpString itself is always a string.
        .InterpString(_) -> ValueType.Str
        // kkgf: type-test variants always evaluate to Bool — no
        // operand inspection needed. These are very common in match
        // guards and conditional flows in the bootstrap source.
        .IsCheck(_, _) -> ValueType.Bool
        .InCheck(_, _) -> ValueType.Bool
        // Assign expressions return the assigned RHS type. Since
        // the RHS sub-expression was annotated by annotate_expr
        // above, looking it up via annotate_sexpr_ty is one
        // tag-dispatch instead of a full check_expr re-walk.
        .Assign(_, val) -> annotate_sexpr_ty(tc, tc.nodes.exprs.get(val))
        // kkgf: FieldAccess on a bare ident is the dominant pattern
        // in the bootstrap (self.x, ctx.foo, e.name, ...). When the
        // base is an Ident we know its type from tc.types; the field
        // type comes from the struct registry. Falls back to
        // check_expr only when the base is a more complex expression
        // (chained field accesses, calls returning structs, etc.).
        .FieldAccess(base, fname) -> match tc.nodes.exprs.get(base) {
            .Ident(obj_name) -> {
                let base_ty = type_lookup(tc.types, obj_name)
                let sname = vtype_struct_name(base_ty)
                if sname == "" {
                    check_expr(tc, se.node).ty
                } else {
                    let field_ty = field_type_lookup(struct_type_lookup(tc.structs, sname), fname)
                    if vtype_is_unknown(field_ty) {
                        check_expr(tc, se.node).ty
                    } else {
                        // Specialise a generic field type to the receiver
                        // instance's type args (`Box<int>.val` → int).
                        tc_specialize_field_ty(tc.structs, base_ty, field_ty)
                    }
                }
            }
            _ -> check_expr(tc, se.node).ty
        }
        // kkgf: Index on a bare ident — common pattern is `xs[i]`
        // where xs is a List. Falls back when base type isn't a
        // List (string indexing, map indexing, custom Index impls).
        .Index(base, _) -> match tc.nodes.exprs.get(base) {
            .Ident(obj_name) -> {
                let base_ty = type_lookup(tc.types, obj_name)
                let elem_ty = vtype_list_elem(base_ty)
                if vtype_is_unknown(elem_ty) {
                    check_expr(tc, se.node).ty
                } else {
                    elem_ty
                }
            }
            _ -> check_expr(tc, se.node).ty
        }
        // Try unwraps a Result; the unwrapped success type matches
        // the inner expression's type only when the parser desugar
        // pass has already lowered it. For now this stays in the
        // fallback so we don't regress error-propagation typeck.
        // Fallback: re-run check_expr for complex expressions
        _ -> check_expr(tc, se.node).ty
    }
    sexpr_typed(annotated_node, se.line, se.col, ty)
}

/// Cheap one-step type lookup on a bare Expr that mirrors the
/// fast-path table in annotate_sexpr but without recursing into
/// sub-expressions. Used by leaves that just forward (Grouping).
fn annotate_sexpr_ty(tc: TC, e: Expr) -> ValueType {
    match e {
        .Number(_) -> ValueType.Int
        .FloatLit(_) -> ValueType.Float
        .String(_) -> ValueType.Str
        .Bool(_) -> ValueType.Bool
        .None -> ValueType.Void
        .Ident(name) -> type_lookup(tc.types, name)
        .InterpString(_) -> ValueType.Str
        .Range(_, _) -> ValueType.Int
        .RangeIncl(_, _) -> ValueType.Int
        _ -> check_expr(tc, e).ty
    }
}

/// Annotate a flipped `List<ExprId>` (call/collection args). Reuses
/// `annotate_sexpr` so each arg's inferred type
/// is computed EXACTLY as the boxed path did, then records it on the arena via
/// `set_arg_ty` (keyed by the post-`reexpr` row) so the monomorphizer — which
/// materializes args back to `SExpr` via `sexprs_of` — reads the same `.ty` it
/// read pre-flip. This is what keeps the args flip byte-identical.
fn annotate_expr_list_ids(tc: TC, ids: List<ExprId>) -> List<ExprId> {
    mut out: List<ExprId> = []
    for id in ids {
        let annotated = annotate_sexpr(tc, tc.nodes.sexpr_of(id))
        let new_id = tc.nodes.reexpr(annotated.node, id)
        tc.nodes.set_arg_ty(new_id, annotated.ty)
        out.push(new_id)
    }
    out
}

/// Walk every match arm, binding pattern captures into the type
/// env, then annotating both guard and body.
fn annotate_match_arms(tc: TC, arms: List<MatchArm>) -> List<MatchArm> {
    // B-final F4b: annotate guard/body nodes and stamp their resolved types into
    // the arena `arg_tys` side-table (id-based successor of `SExpr.ty`).
    list_map(arms, (arm: MatchArm) -> {
        let new_guard_id = if arm.guard_id != null {
            let g_ann = annotate_sexpr(tc, tc.nodes.sexpr_of(arm.guard_id!))
            let gid = tc.nodes.reexpr(g_ann.node, arm.guard_id!)
            tc.nodes.set_arg_ty(gid, g_ann.ty)
            gid
        } else { null }
        let b_ann = annotate_sexpr(tc, tc.nodes.sexpr_of(arm.body_id))
        let new_body_id = tc.nodes.reexpr(b_ann.node, arm.body_id)
        tc.nodes.set_arg_ty(new_body_id, b_ann.ty)
        MatchArm { pattern: arm.pattern, pattern_id: arm.pattern_id, guard_id: new_guard_id, body_id: new_body_id }
    })
}

/// Map `annotate_sexpr` over each `List<FieldInit>` value.
fn annotate_field_inits(tc: TC, inits: List<FieldInit>) -> List<FieldInit> {
    // B-final F4: annotate the value's node and stamp its resolved type into
    // the arena's `arg_tys` side-table (keyed by the value_id) — the id-based
    // successor of the boxed `SExpr.ty` slot that mono reads via `arg_ty_of`.
    list_map(inits, (init: FieldInit) -> {
        let annotated = annotate_sexpr(tc, tc.nodes.sexpr_of(init.value_id))
        let new_id = tc.nodes.reexpr(annotated.node, init.value_id)
        tc.nodes.set_arg_ty(new_id, annotated.ty)
        FieldInit { name: init.name, value_id: new_id }
    })
}

/// Walk every `when` arm, annotating cond + body SExprs.
fn annotate_when_arms(tc: TC, arms: List<WhenArm>) -> List<WhenArm> {
    // B-final F4c: annotate cond/body nodes and stamp their resolved types into
    // the arena `arg_tys` side-table (keyed by id) — id-based successor of the
    // boxed `SExpr.ty` slot.
    list_map(arms, (arm: WhenArm) -> {
        let new_cond_id = if arm.cond_id != null {
            let c_ann = annotate_sexpr(tc, tc.nodes.sexpr_of(arm.cond_id!))
            let cid = tc.nodes.reexpr(c_ann.node, arm.cond_id!)
            tc.nodes.set_arg_ty(cid, c_ann.ty)
            cid
        } else { null }
        let b_ann = annotate_sexpr(tc, tc.nodes.sexpr_of(arm.body_id))
        let new_body_id = tc.nodes.reexpr(b_ann.node, arm.body_id)
        tc.nodes.set_arg_ty(new_body_id, b_ann.ty)
        WhenArm { cond_id: new_cond_id, body_id: new_body_id }
    })
}

// ── Naming convention checks ──
// PascalCase: first char uppercase, no underscores (except leading _)
// snake_case: all lowercase or underscore or digit
// SCREAMING_SNAKE: all uppercase or underscore or digit

/// True iff `ch` is an ASCII uppercase letter.
fn is_upper(ch: string) -> bool { ch in "A".."Z" }
/// True iff `ch` is an ASCII lowercase letter.
fn is_lower(ch: string) -> bool { ch in "a".."z" }
/// True iff `ch` is an ASCII digit. Local copy so the
/// naming-convention helpers don't depend on lexer/.
fn is_naming_digit(ch: string) -> bool { ch in "0".."9" }

/// True iff `name` follows the PascalCase convention: first char
/// uppercase, no underscores in the rest. Leading `_` is allowed
/// for explicitly-private types.
fn is_pascal_case(name: string) -> bool {
    if name.length == 0 { return true }
    // For qualified names like "module::TypeName", check the last segment
    if name.contains("::") {
        return is_pascal_case(type_short_name(name))
    }
    let first = name[0]
    if first == "_" { return true }  // skip private names
    if !is_upper(first) { return false }
    // PascalCase: no underscores in the rest
    mut i = 1
    while i < name.length {
        if name[i] == "_" { return false }
        i = i + 1
    }
    true
}

/// True iff `name` is snake_case: all lowercase / digits /
/// underscores. Leading `_` allowed for private bindings; a leading `$`
/// marks a compiler-generated temp (parser desugar gensym), which the user
/// never wrote, so the naming convention does not apply.
fn is_snake_case(name: string) -> bool {
    if name.length == 0 { return true }
    let first = name[0]
    if first == "_" { return true }
    if is_gensym_name(name) { return true }
    if is_upper(first) { return false }
    mut i = 0
    while i < name.length {
        let ch = name[i]
        if !is_lower(ch) && ch != "_" && ch != ":" && !is_naming_digit(ch) {
            return false
        }
        i = i + 1
    }
    true
}

/// True iff `name` is SCREAMING_SNAKE_CASE: all uppercase / digits
/// / underscores. Used for `const` declarations.
fn is_screaming_snake(name: string) -> bool {
    if name.length == 0 { return true }
    if name[0] == "_" { return true }
    mut i = 0
    while i < name.length {
        let ch = name[i]
        if !is_upper(ch) && ch != "_" && !is_naming_digit(ch) {
            return false
        }
        i = i + 1
    }
    true
}

/// Emit an `F9003 NamingConvention` warning at the TC's current
/// position with `msg` as the body.
fn naming_warn(tc: TC, msg: string) -> TC {
    let sp = span_dummy()
    let d = diag_with_confidence(diag_warning(DiagCode.NamingConvention, msg, sp), Confidence.Medium)
    tc with { bag: bag_report(tc.bag, d) }
}

/// Per-stmt branch of the naming-convention check (driven by the
/// id-native `check_naming_stmt_ids` root walk). Each declaration
/// kind has its own expected case (PascalCase for types/enums/
/// traits, snake_case for fns/lets, SCREAMING_SNAKE for consts).
fn check_naming_stmt_ids(tc: TC, ids: List<StmtId>) -> TC {
    mut cur = tc
    for id in ids { cur = check_naming_stmt(cur, tc.nodes.stmts.get(id)) }
    cur
}

fn check_naming_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Annotated(_, inner) -> check_naming_stmt(tc, tc.nodes.stmts.get(inner))
        .Function(name, _, _, _, body) -> {
            // Strip impl prefix (TypeName__method → check method part only)
            let check_name = if name.index_of("__") > 0 {
                name.substring(name.index_of("__") + 2, name.length)
            } else { name }
            let tc2 = if check_name != "main" && !is_snake_case(check_name) {
                naming_warn(tc, "function `${name}` should be snake_case")
            } else {
                tc
            }
            check_naming_stmt_ids(tc2, body)
        }
        .TypeDecl(name, _, _) -> {
            if !is_pascal_case(name) {
                naming_warn(tc, "type `${name}` should be PascalCase")
            } else {
                tc
            }
        }
        .EnumDecl(name, _, _) -> {
            if !is_pascal_case(name) {
                naming_warn(tc, "enum `${name}` should be PascalCase")
            } else {
                tc
            }
        }
        .Const(name, _, _) -> {
            if !is_screaming_snake(name) {
                naming_warn(tc, "constant `${name}` should be SCREAMING_SNAKE_CASE")
            } else {
                tc
            }
        }
        .Let(name, _, _) -> {
            if !is_snake_case(name) {
                naming_warn(tc, "variable `${name}` should be snake_case")
            } else {
                tc
            }
        }
        .Mut(name, _, _) -> {
            if !is_snake_case(name) {
                naming_warn(tc, "variable `${name}` should be snake_case")
            } else {
                tc
            }
        }
        .Block(body) -> check_naming_stmt_ids(tc, body)
        .If(_, then_br, else_br) -> {
            let tc2 = check_naming_stmt(tc, tc.nodes.stmts.get(then_br))
            if else_br != null { check_naming_stmt(tc2, tc.nodes.stmts.get(else_br!)) } else { tc2 }
        }
        .While(_, body) -> check_naming_stmt(tc, tc.nodes.stmts.get(body))
        .For(_, _, _, body) -> check_naming_stmt(tc, tc.nodes.stmts.get(body))
        .ForIn(_, _, body) -> check_naming_stmt(tc, tc.nodes.stmts.get(body))
        .Module(_, body) -> check_naming_stmt_ids(tc, body)
        .Impl(_, methods) -> check_naming_stmt_ids(tc, methods)
        _ -> tc
    }
}

