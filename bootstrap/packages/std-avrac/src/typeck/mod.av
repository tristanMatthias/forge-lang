// WHY: type checker — walks the AST after name resolution and
// computes a ValueType for every expression. Reports type errors
// via DiagnosticBag. GATES compilation — type errors stop the
// compile pipeline before codegen runs. Per spec Axis 20.

use core.ast.{BinOp, Expr, ExprList, FieldInitList, FieldList, MatchArmList, ParamList, Pattern, PatternList, SExpr, SStmt, Stmt, StmtList, TypeList, ValueType, VariantList, WhenArmList, field_list_has, field_vtype_of, filter_fields_only, filter_fields_without, param_list_length, stmt_unwrap, sexpr_typed, sstmt, vtype_display, vtype_eq, vtype_assignable, vtype_fn_ret, vtype_is_unknown, vtype_list_elem, vtype_struct_name, vtype_tuple_at}
use diagnostics.{Confidence, DiagCode, DiagnosticBag, bag_has_errors, bag_new, bag_report, diag_error, diag_warning, diag_with_cause, diag_with_confidence, span_dummy, span_new}
use core.registry.{Registry, build_registry, dispatch_stmt_check, dispatch_expr_check, avra_stmt_tag, avra_expr_tag}
use features.match_expr.{tc_check_match_arm_returns, tc_check_exhaustive}
use features.trait_decl.{check_trait_conformance, collect_method_names_from_stmts, collect_assoc_types_from_stmts, find_trait_separator}
use features.list_lit.{check_list_method}
use features.map_lit.{check_map_method}
use features.let_stmt.{is_const_expr}
use core.type_registry.{method_mangled_name, type_short_name, is_result_enum_name}
use core.runtime.{avra_process_env_get}

extern fn avra_uptime_ms() -> int

// ── Type environment ──

/// Scope-stack entry for the type checker. Each binding records
/// the variable's name, inferred type, and the depth at which it
/// was declared (for scope-pop on block exit).
enum TypeEntry {
    End
    Node(name: string, ty: ValueType, depth: int, next: TypeEntry)
}

/// Walk the type-environment chain looking for `name`. Returns
/// `ValueType.Unknown` when not bound — typecheck callers branch
/// on Unknown rather than pattern-matching on Option.
fn type_lookup(env: TypeEntry, name: string) -> ValueType {
    match env {
        .End -> ValueType.Unknown
        .Node(n, ty, _, _) if n == name -> ty
        .Node(_, _, _, next) -> type_lookup(next, name)
    }
}

/// Cons a binding onto the type environment. Innermost shadowing.
fn type_bind(env: TypeEntry, name: string, ty: ValueType, depth: int) -> TypeEntry {
    TypeEntry.Node(name, ty, depth, env)
}

/// Pop every entry whose declared depth is `>= depth`. Used on
/// block / fn exit to drop bindings that left their scope.
fn type_pop_scope(env: TypeEntry, depth: int) -> TypeEntry {
    match env {
        .End -> TypeEntry.End
        .Node(_, _, d, next) if d >= depth -> type_pop_scope(next, depth)
        _ -> env
    }
}

// ── Function type registry ──

/// Function-name → (params, return type) table. Looked up by call
/// expressions to typecheck arity + per-arg compatibility.
enum FnTypeEntry {
    End
    Node(name: string, params: ParamList, ret_ty: ValueType, next: FnTypeEntry)
}

/// Single-walk lookup result: `found=false` means the name is not
/// registered (params/ret_ty hold safe sentinels); `found=true`
/// means callers can read params/ret_ty directly without re-walking.
///
/// Replaces the prior fn_type_has + fn_type_lookup + tc_fn_arity +
/// tc_fn_params quartet; folding all four into one walk is the
/// dominant kkgf typeck win because every fn-call site previously
/// re-traversed the registry 4–5 times.
type FnTypeFound = {
    found: bool,
    params: ParamList,
    ret_ty: ValueType,
}

/// One-walk lookup. Returns a record with `found=false` when name is
/// missing from the registry. All hot-path consumers prefer this over
/// the legacy split helpers.
fn fn_type_get(fns: FnTypeEntry, name: string) -> FnTypeFound {
    match fns {
        .End -> FnTypeFound { found: false, params: ParamList.End, ret_ty: ValueType.Unknown }
        .Node(n, params, ret, _) if n == name ->
            FnTypeFound { found: true, params: params, ret_ty: ret }
        .Node(_, _, _, next) -> fn_type_get(next, name)
    }
}


/// Length of an ExprList. Local copy so typecheck doesn't depend
/// on core/ast.av's `expr_list_length` import — keeps the import
/// surface tight.
fn tc_count_args(list: ExprList) -> int {
    match list {
        .End -> 0
        .Node(_, next) -> 1 + tc_count_args(next)
    }
}

// ── Raw return-type string registry ──
// Stores the raw annotation string for function return types so that
// generic type parameters (e.g. the Ok type in Result<T, E>) can be
// extracted for downstream checks like `catch` body type validation.

// Look up the Ok type for a catch expression.
// Given a TC and the inner expression, determines the expected catch body type.
// Returns the Ok type as a ValueType, or null if unknown.
/// For `expr catch (e) { body }`: when `expr` is a Result-shaped
/// Try, return the Ok-arm's payload type so `body` can be checked
/// against the same type. Returns null when `expr` isn't a Result.
export fn tc_catch_ok_type(tc: TC, inner: Expr) -> ValueType? {
    let fn_name = match inner {
        .Call(callee, _) -> match callee {
            .Ident(name) -> name
            .QualifiedIdent(path) -> path
            _ -> ""
        }
        .GenericCall(callee, _, _) -> match callee {
            .Ident(name) -> name
            .QualifiedIdent(path) -> path
            _ -> ""
        }
        _ -> ""
    }
    if fn_name == "" { return null }
    // Look up the function's return type from the typed registry
    let ret_ty = fn_type_get(tc.fns, fn_name).ret_ty
    // Check if it's Result (Enum with type_args)
    match ret_ty {
        .Enum(name, args, _) -> {
            if !is_result_enum_name(name) { return null }
            // First type arg is the Ok type
            match args {
                .Node(ok_ty, _) -> ok_ty
                .End -> null
            }
        }
        _ -> null
    }
}

// ── Struct/Enum registries ──

/// Struct-name → FieldList table. Populated during the
/// `collect_decls` pre-pass; consulted by struct-literal and field-
/// access typecheck.
enum StructTypeReg {
    End
    Node(name: string, fields: FieldList, next: StructTypeReg)
}

/// Look up a single field's resolved type within a FieldList. Returns
/// ValueType.Unknown when the field name isn't found. Used by the
/// kkgf annotate fast-path to skip a redundant check_expr re-walk
/// for `obj.field` reads when obj is a bare identifier.
export fn field_type_lookup(fields: FieldList, name: string) -> ValueType {
    match fields {
        .End -> ValueType.Unknown
        .Node(fname, fty, _) if fname == name -> fty
        .Node(_, _, next) -> field_type_lookup(next, name)
    }
}

/// Look up a struct's FieldList by name. Empty list when not found.
export fn struct_type_lookup(reg: StructTypeReg, name: string) -> FieldList {
    match reg {
        .End -> FieldList.End
        .Node(n, fields, _) if n == name -> fields
        .Node(n, fields, next) -> {
            struct_type_lookup(next, name)
        }
    }
}

/// Membership probe for the struct registry.
fn struct_type_has(reg: StructTypeReg, name: string) -> bool {
    match reg {
        .End -> false
        .Node(n, _, _) if n == name -> true
        .Node(_, _, next) -> struct_type_has(next, name)
    }
}

/// Enum-name → VariantList table. Mirror of StructTypeReg for enums.
enum EnumTypeReg {
    End
    Node(name: string, variants: VariantList, next: EnumTypeReg)
}

/// Membership probe for the enum registry.
fn enum_type_has(reg: EnumTypeReg, name: string) -> bool {
    match reg {
        .End -> false
        .Node(n, _, _) if n == name -> true
        .Node(_, _, next) -> enum_type_has(next, name)
    }
}

/// Reverse lookup: which enum declares `variant`? Returns "" when
/// the variant isn't registered. Used to type bare `.Variant`
/// expressions where the enum name is implicit from context.
export fn tc_enum_find_by_variant(reg: EnumTypeReg, variant: string) -> string {
    match reg {
        .End -> ""
        .Node(name, variants, next) -> {
            if variant_has(variants, variant) { name } else { tc_enum_find_by_variant(next, variant) }
        }
    }
}

/// True iff `name` matches any variant in the list.
fn variant_has(variants: VariantList, name: string) -> bool {
    match variants {
        .End -> false
        .Node(vn, _, _) if vn == name -> true
        .Node(_, _, next) -> variant_has(next, name)
    }
}

// ── Checker state ──

/// One method signature within a trait — name + parameter count
/// (including `self`). Used by `check_trait_conformance` to verify
/// impl methods have matching arity.
export type TraitMethod = {
    name: string,
    param_count: int,
}

/// Trait-name → (methods, assoc types) table. Populated by the
/// pre-pass `collect_decls`; consulted whenever an impl block or
/// `dyn Trait` appears.
enum TraitRegistry {
    End
    Node(trait_name: string, methods: List<TraitMethod>, assoc_types: List<string>, next: TraitRegistry)
}

/// Single-walk lookup result for the trait registry — same pattern
/// as `FnTypeFound`. `found=false` means the trait isn't registered;
/// `methods` and `assoc_types` carry safe sentinels in that case.
/// Hot-path consumers prefer `trait_get` over the legacy split
/// `trait_has` + `trait_lookup` + `trait_assoc_types` trio so each
/// call site walks the registry exactly once.
export type TraitFound = {
    found: bool,
    methods: List<TraitMethod>,
    assoc_types: List<string>,
}

/// One-walk lookup. Returns a record with `found=false` when the
/// trait is not in the registry.
export fn trait_get(reg: TraitRegistry, name: string) -> TraitFound {
    match reg {
        .End -> TraitFound { found: false, methods: [], assoc_types: [] }
        .Node(n, methods, at, _) if n == name ->
            TraitFound { found: true, methods: methods, assoc_types: at }
        .Node(_, _, _, next) -> trait_get(next, name)
    }
}

/// Membership probe for the trait registry. Convenience wrapper
/// over `trait_get` — prefer the latter when also reading methods
/// or assoc_types in the same code path.
export fn trait_has(reg: TraitRegistry, name: string) -> bool {
    trait_get(reg, name).found
}

/// Orphan-rule helper — true iff `name` is a type declared in this
/// compilation unit (or a primitive). Drives the impl-coherence
/// check that requires either the trait OR the type to be local.
export fn tc_owns_type(tc: TC, name: string) -> bool {
    if struct_type_has(tc.structs, name) { return true }
    if enum_type_has(tc.enums, name) { return true }
    // Primitive types are always "owned"
    if name in ["int", "string", "bool", "float", "ptr"] { return true }
    false
}

/// Set of struct names that are declared with `shape` rather than
/// `type`. Drives structural (width-subtype) compatibility checks.
enum ShapeSet {
    End
    Node(name: string, next: ShapeSet)
}

/// Membership probe for the shape set.
fn is_shape(set: ShapeSet, name: string) -> bool {
    match set {
        .End -> false
        .Node(n, _) if n == name -> true
        .Node(_, next) -> is_shape(next, name)
    }
}

/// Newtype-name → inner-type table. Populated by `collect_decls`,
/// consulted by `resolve_vtype` to peel newtype wrappers when
/// matching types.
enum NewtypeReg {
    End
    Node(name: string, inner_vt: ValueType, next: NewtypeReg)
}

/// Look up a newtype's inner type. Unknown when not found.
fn newtype_vtype_lookup(reg: NewtypeReg, name: string) -> ValueType {
    match reg {
        .End -> ValueType.Unknown
        .Node(n, vt, _) if n == name -> vt
        .Node(_, _, next) -> newtype_vtype_lookup(next, name)
    }
}

/// Union-alias table: `type Json = string | int | bool` → name
/// → Union ValueType. Used to expand the alias when typechecking.
enum UnionAliasReg {
    End
    Node(name: string, type_vt: ValueType, next: UnionAliasReg)
}

/// Look up a union alias's expanded type. Unknown when not registered.
fn union_alias_vtype_lookup(reg: UnionAliasReg, name: string) -> ValueType {
    match reg {
        .End -> ValueType.Unknown
        .Node(n, vt, _) if n == name -> vt
        .Node(_, _, next) -> union_alias_vtype_lookup(next, name)
    }
}

/// Associated-type definitions from `impl Trait for Type { type
/// Item = ConcreteType }`. Key shape: `"TypeName.AssocName"` (e.g.
/// `"Circle.Item"`); value is the concrete ValueType the impl
/// pinned the trait's associated type to.
enum AssocTypeDefs {
    End
    Node(key: string, concrete_vt: ValueType, next: AssocTypeDefs)
}

/// Look up an associated-type definition by `"TypeName.AssocName"`
/// key. Returns Unknown when the impl didn't pin that assoc type.
fn assoc_type_vt_lookup(reg: AssocTypeDefs, key: string) -> ValueType {
    match reg {
        .End -> ValueType.Unknown
        .Node(k, vt, _) if k == key -> vt
        .Node(_, _, next) -> assoc_type_vt_lookup(next, key)
    }
}

/// Mutable threaded state for the type-checker pass. Carries every
/// lookup table the checker needs plus the diagnostics bag and
/// current source position. Like Resolver, threaded purely
/// functionally despite the imperative-looking call sites.
type TC = {
    types: TypeEntry,
    fns: FnTypeEntry,
    structs: StructTypeReg,
    shapes: ShapeSet,
    enums: EnumTypeReg,
    newtypes: NewtypeReg,
    union_aliases: UnionAliasReg,
    depth: int,
    bag: DiagnosticBag,
    current_fn: string,
    current_line: int,
    current_col: int,
    traits: TraitRegistry,
    trait_impls: TraitImplReg,
    assoc_type_defs: AssocTypeDefs,
    features: Registry,
}

/// Registry of `impl Trait for Type` relationships. Used to verify
/// trait bounds on generic type arguments at instantiation sites.
enum TraitImplReg {
    End
    Node(trait_name: string, type_name: string, next: TraitImplReg)
}

/// True iff some `impl trait_name for type_name` is registered.
/// Compares on short names so a query like
/// `("module::WcInt", "WcSized")` matches a registry entry stored
/// as `("module::WcSized", "module::WcInt")` — type param bound
/// strings aren't module-qualified by the resolver.
export fn type_implements_trait(reg: TraitImplReg, type_name: string, trait_name: string) -> bool {
    let q_trait = type_short_name(trait_name)
    let q_type = type_short_name(type_name)
    type_implements_trait_inner(reg, q_type, q_trait)
}

/// Implementation backing `type_implements_trait` — short-name
/// comparison after both sides have been canonicalised.
fn type_implements_trait_inner(reg: TraitImplReg, q_type: string, q_trait: string) -> bool {
    match reg {
        .End -> false
        .Node(tn, ty, _) if type_short_name(tn) == q_trait && type_short_name(ty) == q_type -> true
        .Node(_, _, next) -> type_implements_trait_inner(next, q_type, q_trait)
    }
}

/// Output of the per-expression checker: the updated TC plus the
/// expression's inferred type.
type ExprResult = {
    tc: TC,
    ty: ValueType,
}

/// Fresh empty TC at depth 0 with a fresh feature registry.
fn tc_new() -> TC {
    TC {
        types: TypeEntry.End,
        fns: FnTypeEntry.End,
        structs: StructTypeReg.End,
        shapes: ShapeSet.End,
        enums: EnumTypeReg.End,
        newtypes: NewtypeReg.End,
        union_aliases: UnionAliasReg.End,
        depth: 0,
        bag: bag_new(),
        current_fn: "",
        current_line: 0,
        current_col: 0,
        traits: TraitRegistry.End,
        trait_impls: TraitImplReg.End,
        assoc_type_defs: AssocTypeDefs.End,
        features: build_registry(),
    }
}

/// Bump scope depth — entering a new block.
export fn tc_enter(tc: TC) -> TC { tc with { depth: tc.depth + 1 } }
/// Pop bindings declared at the current depth and decrement.
export fn tc_exit(tc: TC) -> TC {
    tc with { types: type_pop_scope(tc.types, tc.depth), depth: tc.depth - 1 }
}
/// Register `name: ty` at the current depth — the typecheck
/// equivalent of `let name: ty`.
export fn tc_bind(tc: TC, name: string, ty: ValueType) -> TC {
    tc with { types: type_bind(tc.types, name, ty, tc.depth) }
}
/// Append a diagnostic at the TC's current line/col. Most call
/// sites use this rather than `tc_report_at` because they're
/// already tracking position via `current_line` / `current_col`.
export fn tc_report(tc: TC, code: DiagCode, msg: string) -> TC {
    tc_report_at(tc, code, msg, tc.current_line, tc.current_col, 0)
}

/// Append a diagnostic at an explicit `(line, col, len)` span.
/// Used when the offending expression has a known span that
/// differs from the TC's "current" position.
export fn tc_report_at(tc: TC, code: DiagCode, msg: string, line: int, col: int, len: int) -> TC {
    let message = if tc.current_fn.length > 0 {
        "${msg} (in function `${tc.current_fn}`)"
    } else { msg }
    let sp = if line > 0 { span_new(0, len, line, col) } else { span_dummy() }
    tc with { bag: bag_report(tc.bag, diag_error(code, message, sp)) }
}

/// Append a diagnostic with a dedicated cause message — surfaced
/// indented under the primary by the renderer.
export fn tc_report_with_cause(tc: TC, code: DiagCode, msg: string, cause_msg: string) -> TC {
    let message = if tc.current_fn.length > 0 {
        "${msg} (in function `${tc.current_fn}`)"
    } else { msg }
    let sp = if tc.current_line > 0 { span_new(0, 0, tc.current_line, tc.current_col) } else { span_dummy() }
    let primary = diag_error(code, message, sp)
    let cause = diag_error(code, cause_msg, span_dummy())
    tc with { bag: bag_report(tc.bag, diag_with_cause(primary, cause)) }
}

/// Build an ExprResult — convenience constructor used pervasively
/// by the per-expression checker arms.
export fn tc_er(tc: TC, ty: ValueType) -> ExprResult { ExprResult { tc, ty } }

// Parse a union alias string "A | B | C" into ValueType.Union.
/// Canonicalise a ValueType against the TC's registries — peel
/// newtypes, expand union aliases, etc. Idempotent — calling
/// twice produces the same result.
export fn resolve_vtype(tc: TC, vt: ValueType) -> ValueType {
    match vt {
        .Struct(name, _) -> {
            // Associated type: "TypeName.AssocType" → resolve to concrete type
            let dot = name.index_of(".")
            if dot >= 0 {
                let assoc_key = name
                let concrete_vt = assoc_type_vt_lookup(tc.assoc_type_defs, assoc_key)
                if !vtype_is_unknown(concrete_vt) {
                    return resolve_vtype(tc, concrete_vt)
                }
            }
            if enum_type_has(tc.enums, name) { return ValueType.Enum(name, TypeList.End, 0) }
            let ua_vt = union_alias_vtype_lookup(tc.union_aliases, name)
            if !vtype_is_unknown(ua_vt) { return resolve_vtype(tc, ua_vt) }
            let nt_vt = newtype_vtype_lookup(tc.newtypes, name)
            if !vtype_is_unknown(nt_vt) { return ValueType.Newtype(name, resolve_vtype(tc, nt_vt), 0) }
            if struct_type_has(tc.structs, name) { return ValueType.Struct(name, 0) }
            if trait_has(tc.traits, name) { return ValueType.Trait(name, 0) }
            vt
        }
        .Enum(name, args, _) -> {
            let resolved_args = resolve_vtype_list(tc, args)
            if enum_type_has(tc.enums, name) { return ValueType.Enum(name, resolved_args, 0) }
            if struct_type_has(tc.structs, name) { return ValueType.Struct(name, 0) }
            ValueType.Enum(name, resolved_args, 0)
        }
        .List(elem) -> ValueType.List(resolve_vtype(tc, elem))
        .Union(types) -> ValueType.Union(resolve_vtype_list(tc, types))
        .FnTyped(params, ret) -> ValueType.FnTyped(resolve_vtype_list(tc, params), resolve_vtype(tc, ret))
        _ -> vt
    }
}

/// Map `resolve_vtype` over each TypeList element.
fn resolve_vtype_list(tc: TC, types: TypeList) -> TypeList {
    match types {
        .End -> .End
        .Node(ty, next) -> TypeList.Node(resolve_vtype(tc, ty), resolve_vtype_list(tc, next))
    }
}

// ── Entry point ──

/// Output of `typecheck_program`: the annotated stmt tree, the
/// diagnostic bag, and the trait-impl registry (consumed later by
/// the monomorphizer for trait-bound monomorphisation).
export type TypeCheckResult = {
    stmts: StmtList,
    had_error: int,
    bag: DiagnosticBag,
    trait_impls: TraitImplReg,
}

/// Top-level entry: run the type-checker over `stmts`. Three
/// passes: pre-pass `collect_decls` registers types/fns; main
/// `check_stmts` walks the AST inferring + checking types;
/// `annotate_*` writes the inferred types back into SExpr.ty.
export fn typecheck_program(stmts: StmtList) -> TypeCheckResult {
    // Per-pass wall-clock timings — emitted to stderr at the end
    // when AVRA_TIMINGS_TYPECK=1 is set, so kkgf can rank the
    // four typeck passes (collect / check / naming / annotate)
    // before optimising any one of them.
    let timings_on = avra_process_env_get("AVRA_TIMINGS_TYPECK") != ""
    let t_start = avra_uptime_ms()

    let tc0 = tc_new()
    // Pass 1: collect declarations (types, enums, functions). The
    // single walk is order-sensitive — a Function whose return type
    // references an enum declared later in the AST will be registered
    // with the un-upgraded ValueType.Struct(name) instead of the
    // proper ValueType.Enum(name). Run a SECOND collect pass against
    // the now-complete registry to upgrade ret-type residue from the
    // first walk. Tracked under forge-crafting-intepreters-dnq4.
    let tc_first = collect_decls(tc0, stmts)
    let tc1 = tc_first with { fns: rewrite_fn_ret_tys(tc_first, tc_first.fns) }
    let t_collect = avra_uptime_ms()
    // Pass 2: check + annotate in one traversal.
    // check_stmts validates types and accumulates errors in TC.bag.
    // annotate_stmts stamps resolved types onto SExpr.ty (calls check_expr
    // internally for annotation, but since check_stmts already caught errors,
    // the annotation pass just extracts types without re-reporting).
    let tc2 = check_stmts(tc1, stmts)
    let t_check = avra_uptime_ms()
    // Pass 2.5: naming convention warnings
    let tc3 = check_naming_conventions(tc2, stmts)
    let t_naming = avra_uptime_ms()
    // Pass 3: annotate AST — uses fast paths for leaf expressions
    let annotated = annotate_stmts(tc3, stmts)
    let t_annotate = avra_uptime_ms()
    if timings_on {
        eprintln("[timings:typeck] collect=${string(t_collect - t_start)}ms check=${string(t_check - t_collect)}ms naming=${string(t_naming - t_check)}ms annotate=${string(t_annotate - t_naming)}ms total=${string(t_annotate - t_start)}ms")
    }
    TypeCheckResult { stmts: annotated, had_error: bag_has_errors(tc3.bag), bag: tc3.bag, trait_impls: tc3.trait_impls }
}

// ── Pass 1: Declaration collection ──

// Resolve type operator fields (without/only) against the struct registry.
/// Resolve `type Foo = TypeOp(Bar)`-shaped declarations: a field
/// list that's actually a request to compose another struct's
/// fields. Inlines the resolved fields so downstream typecheck
/// sees a flat shape.
fn tc_resolve_type_operator(fields: FieldList, reg: StructTypeReg) -> FieldList {
    match fields {
        .Node(marker, base_vt, rest) if marker == "__base" -> {
            let base_name = vtype_struct_name(base_vt)
            match rest {
                .Node(op_marker, _, excluded) -> {
                    let base_fields = struct_type_lookup(reg, base_name)
                    if op_marker == "__without" { return filter_fields_without(base_fields, excluded) }
                    if op_marker == "__only" { return filter_fields_only(base_fields, excluded) }
                    base_fields
                }
                _ -> fields
            }
        }
        _ -> fields
    }
}

// field_list_has, filter_fields_without, filter_fields_only now in core/ast.av

/// Pre-pass: register every declaration into the right TC table
/// (struct, enum, trait, impl, fn signature, ...) before the main
/// check walks the bodies. Lets bodies forward-reference any
/// declaration regardless of source order.
fn collect_decls(tc: TC, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .TypeDecl(name, _, fields) -> {
                    let resolved = tc_resolve_type_operator(fields, tc.structs)
                    tc with { structs: StructTypeReg.Node(name, resolved, tc.structs) }
                }
                .NewtypeDecl(name, inner_vt) -> {
                    let inner_ty = resolve_vtype(tc, inner_vt)
                    let ctor_params = ParamList.Node("value", inner_ty, ParamList.End)
                    tc with {
                        newtypes: NewtypeReg.Node(name, inner_vt, tc.newtypes),
                        fns: FnTypeEntry.Node(name, ctor_params, ValueType.Newtype(name, inner_ty, 0), tc.fns),
                    }
                }
                .UnionAliasDecl(name, type_vt) -> {
                    tc with { union_aliases: UnionAliasReg.Node(name, type_vt, tc.union_aliases) }
                }
                .ShapeDecl(name, fields) -> tc with {
                    structs: StructTypeReg.Node(name, fields, tc.structs),
                    shapes: ShapeSet.Node(name, tc.shapes),
                }
                .EnumDecl(name, _, variants) -> tc with {
                    enums: EnumTypeReg.Node(name, variants, tc.enums)
                }
                .Function(name, _, params, ret_vt, _) -> {
                    let final_ret = if vtype_eq(ret_vt, .Void) { ValueType.Void } else { resolve_vtype(tc, ret_vt) }
                    tc with {
                        fns: FnTypeEntry.Node(name, params, final_ret, tc.fns),
                    }
                }
                .ExternFn(name, params, ret_vt) -> {
                    let final_ret = if vtype_eq(ret_vt, .Void) { ValueType.Void } else { resolve_vtype(tc, ret_vt) }
                    tc with {
                        fns: FnTypeEntry.Node(name, params, final_ret, tc.fns),
                    }
                }
                .Impl(impl_name, methods) -> {
                    let colon_idx = find_trait_separator(impl_name)
                    let with_impl = if colon_idx >= 0 {
                        let trait_name = impl_name.substring(0, colon_idx)
                        let type_name = impl_name.substring(colon_idx + 1, impl_name.length)
                        let with_trait = tc with { trait_impls: TraitImplReg.Node(trait_name, type_name, tc.trait_impls) }
                        // Collect associated type definitions: `type Item = ConcreteType`
                        collect_impl_assoc_types(with_trait, type_name, methods)
                    } else { tc }
                    collect_decls(with_impl, methods)
                }
                .Module(_, body) -> collect_decls(tc, body)
                .TraitDecl(name, methods) -> tc with {
                    traits: TraitRegistry.Node(name, collect_method_names_from_stmts(methods), collect_assoc_types_from_stmts(methods), tc.traits)
                }
                _ -> tc
            }
            collect_decls(updated, next)
        }
    }
}

// Collect associated type definitions from an impl block.
// `type Item = ConcreteType` → store "TypeName.Item" → ConcreteType vtype in assoc_type_defs.
/// Walk an impl block to register its `type AssocName = Concrete`
/// definitions into `tc.assoc_type_defs`.
fn collect_impl_assoc_types(tc: TC, type_name: string, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(ss, next) -> {
            let updated = match ss.node {
                .AssocType(name, ty_vt) -> {
                    if !vtype_is_unknown(ty_vt) {
                        let key = "${type_name}.${name}"
                        let self_key = "Self.${name}"
                        let with_type = tc with { assoc_type_defs: AssocTypeDefs.Node(key, ty_vt, tc.assoc_type_defs) }
                        with_type with { assoc_type_defs: AssocTypeDefs.Node(self_key, ty_vt, with_type.assoc_type_defs) }
                    } else { tc }
                }
                _ -> tc
            }
            collect_impl_assoc_types(updated, type_name, next)
        }
    }
}

/// Re-resolve every FnTypeEntry's ret_ty AND param types against the
/// now-complete `tc.enums` / `tc.structs` / `tc.traits` registries.
/// Used as the second collect pass to upgrade ValueType.Struct
/// residue from the first walk into the proper ValueType.Enum /
/// .Newtype / .Trait variant when the trait/enum/newtype declaration
/// came AFTER the fn that referenced it.
///
/// Both ret_ty and params need this — params are seen on every method
/// dispatch (`e: TraitName` won't dispatch as a trait until upgraded)
/// and ret_ty is seen at every call site (F1000 type-identity
/// errors).
///
/// Tracked under forge-crafting-intepreters-dnq4.
fn rewrite_fn_ret_tys(tc: TC, fns: FnTypeEntry) -> FnTypeEntry {
    match fns {
        .End -> .End
        .Node(name, params, ret_ty, next) -> {
            let upgraded_ret = if vtype_eq(ret_ty, .Void) { ret_ty } else { resolve_vtype(tc, ret_ty) }
            let upgraded_params = rewrite_param_list_vts(tc, params)
            FnTypeEntry.Node(name, upgraded_params, upgraded_ret, rewrite_fn_ret_tys(tc, next))
        }
    }
}

/// Map `resolve_vtype` over each ParamList entry's declared type.
fn rewrite_param_list_vts(tc: TC, params: ParamList) -> ParamList {
    match params {
        .End -> .End
        .Node(name, ty, next) -> {
            let upgraded = if vtype_is_unknown(ty) { ty } else { resolve_vtype(tc, ty) }
            ParamList.Node(name, upgraded, rewrite_param_list_vts(tc, next))
        }
    }
}

// ── Pass 2: Statement checking ──

/// Type-check every statement in a list, threading the TC.
fn check_stmts(tc: TC, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(ss, next) -> {
            let with_pos = tc with { current_line: ss.line, current_col: ss.col }
            let updated = check_stmt(with_pos, ss.node)
            check_stmts(updated, next)
        }
    }
}

/// Type-check a `let` / `mut` / `const` binding: infer the
/// initializer's type, verify it matches any declared annotation,
/// and bind `name: type` into the env.
fn check_binding(tc: TC, name: string, ty_vt: ValueType, init: Expr, is_const: bool) -> TC {
    let has_annotation = !vtype_is_unknown(ty_vt)
    let r = check_expr(tc, init)
    let declared_ty = if has_annotation { resolve_vtype(r.tc, ty_vt) } else { r.ty }
    // Type annotation mismatch: flag clear mismatches between primitive types.
    // Skip when RHS is Void (null), Int (unresolved inference), or Unknown.
    if has_annotation && !vtype_is_unknown(r.ty) && !vtype_is_unknown(declared_ty) && !(r.ty is .Void) && !(r.ty is .Int) {
        let mismatch = match declared_ty {
            .Int -> r.ty is .Str || r.ty is .Bool || r.ty is .Float
            .Str -> r.ty is .Int || r.ty is .Bool || r.ty is .Float
            .Bool -> r.ty is .Str || r.ty is .Float
            .Float -> r.ty is .Str || r.ty is .Bool
            _ -> false
        }
        if mismatch {
            let msg = "type mismatch: expected `${vtype_display(declared_ty)}`, got `${vtype_display(r.ty)}`"
            return tc_bind(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty)
        }
    }
    if declared_ty is .Newtype && !(r.ty is .Newtype) && !(r.ty is .Unknown) {
        let msg = "cannot assign `${vtype_display(r.ty)}` to `${vtype_display(declared_ty)}` — use `${vtype_display(declared_ty)}(value)` constructor"
        return tc_bind(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty)
    }
    if is_const && !is_const_expr(init) {
        let msg = "`const` requires a compile-time constant expression (use `let` for runtime values)"
        return tc_bind(tc_report(r.tc, DiagCode.TypeMismatch, msg), name, declared_ty)
    }
    // Shape subtyping: if declared type is a shape, check init value has required fields
    let after_shape = if has_annotation {
        tc_check_shape_compat(r.tc, vtype_struct_name(ty_vt), r.ty)
    } else { r.tc }
    tc_bind(after_shape, name, declared_ty)
}

/// Type-check a single statement. Each variant routes to the
/// appropriate inference / verification path; declarations
/// recurse into their bodies and registries.
export fn check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Let(name, ty_vt, init) -> check_binding(tc, name, ty_vt, init, false)
        .Mut(name, ty_vt, init) -> check_binding(tc, name, ty_vt, init, false)
        .Const(name, ty_vt, init) -> check_binding(tc, name, ty_vt, init, true)
        .Expr(e) -> {
            let r = check_expr(tc, e)
            r.tc
        }
        .Return(value) -> {
            let r = check_expr(tc, value)
            r.tc
        }
        .ReturnEmpty -> tc
        .Block(body) -> {
            let inner = tc_enter(tc)
            let checked = check_stmts(inner, body)
            tc_exit(checked)
        }
        .Function(name, _, params, ret_vt, body) -> {
            let inner = tc_enter(tc) with { current_fn: name }
            let with_params = tc_bind_params(inner, params)
            let checked = tc_check_fn_body(with_params, name, ret_vt, body)
            tc_exit(checked)
        }
        .Impl(impl_name, methods) -> {
            let after = check_stmts(tc, methods)
            // Check trait conformance if this is `impl Trait for Type`
            // impl_name is "Trait:Type" or just "Type"
            check_trait_conformance(after, impl_name, methods)
        }
        .Module(_, body) -> check_stmts(tc, body)
        .Annotated(_, inner) -> check_stmt(tc, inner)
        .If(cond, then_b, else_b) -> {
            let c1 = check_expr(tc, cond)
            let c2 = check_stmt(c1.tc, then_b)
            if else_b != null { check_stmt(c2, else_b!) } else { c2 }
        }
        .While(cond, body) -> {
            let c1 = check_expr(tc, cond)
            check_stmt(c1.tc, body)
        }
        .For(vname, start, end, body) -> {
            let c1 = check_expr(tc, start)
            let c2 = check_expr(c1.tc, end)
            let inner = tc_enter(c2.tc)
            let bound = tc_bind(inner, vname, .Int)
            let after = check_stmt(bound, body)
            tc_exit(after)
        }
        .ForIn(vname, coll, body) -> {
            let c1 = check_expr(tc, coll)
            let elem_ty = vtype_list_elem(c1.ty)
            let inner = tc_enter(c1.tc)
            let bound = tc_bind(inner, vname, elem_ty)
            let after = check_stmt(bound, body)
            tc_exit(after)
        }
        .Match(subj, arms) -> {
            let s = check_expr(tc, subj)
            tc_check_exhaustive(s.tc, s.ty, arms)
        }
        .Defer(body) -> {
            let r = check_expr(tc, body)
            r.tc
        }
        .LetDestructure(_, init) -> {
            let r = check_expr(tc, init)
            r.tc
        }
        _ -> {
            let tag = avra_stmt_tag(stmt)
            let result = dispatch_stmt_check(tc.features, tag, tc, stmt)
            if result != null { return result! }
            tc
        }
    }
}

// Check that `impl Trait for Type` provides all required methods.
/// Type-check a function body against its declared return type.
/// Includes implicit-return checking (the body's tail expression
/// must match `ret_vt`) and explicit-return path verification.
fn tc_check_fn_body(tc: TC, name: string, ret_vt: ValueType, body: StmtList) -> TC {
    let checked = check_stmts(tc, body)
    // Skip return type checking for functions without a declared return type.
    if vtype_eq(ret_vt, .Void) {
        return checked
    }
    let declared_ret = resolve_vtype(checked, ret_vt)
    // Check every explicit `return expr` produces a compatible type.
    let after_explicit = tc_check_explicit_returns(checked, name, declared_ret, body)
    // Check implicit return: the last expression in the body.
    // Functions with explicit returns on every path don't need this
    // (but checking it anyway is harmless — it's the same type).
    tc_check_implicit_return(after_explicit, name, declared_ret, body)
}

// Check the type of the last expression in a function body against
// the declared return type. Only flags concrete mismatches (e.g.
// string vs int). Skips Void (statements/loops with no value) and
// functions whose last statement isn't an expression.
/// Verify that the body's tail expression matches the declared
/// return type — Avra's implicit-return rule. Skipped for void.
fn tc_check_implicit_return(tc: TC, fn_name: string, declared: ValueType, stmts: StmtList) -> TC {
    let body_ty = tc_body_tail_type(tc, stmts)
    // Skip when either side is Unknown (fallback/unreliable) or Void (no value).
    if vtype_is_unknown(declared) { return tc }
    match body_ty {
        .Void or .Unknown -> tc
        _ -> {
            // Allow concrete types to satisfy trait return types (auto-boxing at codegen)
            if declared is .Trait { return tc }
            if !vtype_eq(declared, body_ty) && !vtype_assignable(body_ty, declared) {
                let msg = "function `${fn_name}` returns `${vtype_display(declared)}`, but body produces `${vtype_display(body_ty)}`"
                let cause = "declared return type is `${vtype_display(declared)}`"
                return tc_report_with_cause(tc, DiagCode.TypeMismatch, msg, cause)
            }
            tc
        }
    }
}

// Get the type of the last expression in a statement list.
// Returns Void if the last statement is not an expression.
/// Compute the type of the tail expression of a block. Skips
/// trailing return / break / continue. Used to determine the
/// implicit-return value type.
fn tc_body_tail_type(tc: TC, stmts: StmtList) -> ValueType {
    match stmts {
        .End -> ValueType.Void
        .Node(ss, next) -> {
            match next {
                .End -> {
                    match ss.node {
                        .Expr(e) -> {
                            let r = check_expr(tc, e)
                            r.ty
                        }
                        .Return(_) -> ValueType.Void  // explicit return — handled elsewhere
                        .ReturnEmpty -> ValueType.Void
                        _ -> ValueType.Void
                    }
                }
                _ -> tc_body_tail_type(tc, next)
            }
        }
    }
}

// Walk all statements and check that every `return expr` and
// `return` matches the declared return type. This is flow-insensitive
// (checks ALL returns regardless of reachability) but sound — every
// return statement must produce the right type even if dead.
/// Walk every explicit `return value` in `stmts`, verifying
/// `value`'s type matches `declared`. Recurses into nested blocks
/// and conditionals.
export fn tc_check_explicit_returns(tc: TC, fn_name: string, declared: ValueType, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(ss, next) -> {
            let updated = tc_check_stmt_returns(tc, fn_name, declared, ss.node)
            tc_check_explicit_returns(updated, fn_name, declared, next)
        }
    }
}

/// Per-stmt branch of `tc_check_explicit_returns` — the recursive
/// case that descends into If / While / Block / Match etc.
fn tc_check_stmt_returns(tc: TC, fn_name: string, declared: ValueType, stmt: Stmt) -> TC {
    match stmt {
        .Return(value) -> {
            let r = check_expr(tc, value)
            if !vtype_eq(declared, r.ty) && !vtype_assignable(r.ty, declared) && !vtype_is_unknown(r.ty) && !vtype_eq(r.ty, .Void) {
                let msg = "function `${fn_name}` returns `${vtype_display(declared)}`, but return produces `${vtype_display(r.ty)}`"
                let cause = "declared return type is `${vtype_display(declared)}`"
                return tc_report_with_cause(r.tc, DiagCode.TypeMismatch, msg, cause)
            }
            r.tc
        }
        .Block(body) -> tc_check_explicit_returns(tc, fn_name, declared, body)
        .If(_, then_branch, else_branch) -> {
            let after_then = tc_check_stmt_returns(tc, fn_name, declared, then_branch)
            if else_branch != null {
                return tc_check_stmt_returns(after_then, fn_name, declared, else_branch!)
            }
            after_then
        }
        .While(_, body) -> tc_check_stmt_returns(tc, fn_name, declared, body)
        .For(_, _, _, body) -> tc_check_stmt_returns(tc, fn_name, declared, body)
        .ForIn(_, _, body) -> tc_check_stmt_returns(tc, fn_name, declared, body)
        .Match(_, arms) -> tc_check_match_arm_returns(tc, fn_name, declared, arms)
        .Annotated(_, inner) -> tc_check_stmt_returns(tc, fn_name, declared, inner)
        .Defer(_) -> tc  // defer bodies should not contain return
        .Errdefer(_) -> tc
        .Parallel(body) -> tc_check_explicit_returns(tc, fn_name, declared, body)
        _ -> tc
    }
}

/// Bind every parameter of a fn into the type environment as a
/// defined binding. Mirrors `define_param_names` in resolve/.
export fn tc_bind_params(tc: TC, params: ParamList) -> TC {
    match params {
        .End -> tc
        .Node(name, resolved, next) -> {
            let ty = resolve_vtype(tc, resolved)
            tc_bind_params(tc_bind(tc, name, ty), next)
        }
    }
}

// ── Expression checking ──

/// Type-check + infer-type for an Expr. Returns `(updated TC,
/// inferred ValueType)`. Each Expr variant gets its own arm; this
/// is the heart of the type checker.
export fn check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Number(_) -> tc_er(tc, .Int)
        .FloatLit(_) -> tc_er(tc, .Float)
        .String(_) -> tc_er(tc, .Str)
        .Bool(_) -> tc_er(tc, .Bool)
        .Null -> tc_er(tc, .Void)
        .Ident(name) -> {
            let ty = type_lookup(tc.types, name)
            // If not found in locals, check function registry
            if vtype_is_unknown(ty) {
                let r = fn_type_get(tc.fns, name)
                if r.found { return tc_er(tc, .Fn(r.ret_ty)) }
            }
            tc_er(tc, ty)
        }
        .Binary(left, op, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            check_binary_type(r.tc, l.ty, op, r.ty)
        }
        .Unary(_, right) -> {
            let r = check_expr(tc, right)
            tc_er(r.tc, r.ty)
        }
        .Logical(left, _, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            tc_er(r.tc, .Bool)
        }
        .Grouping(inner) -> check_expr(tc, inner)
        .Call(callee, args) -> check_call(tc, callee, args)
        .GenericCall(callee, _, args) -> check_call(tc, callee, args)
        .Index(obj, idx) -> {
            let o = check_expr(tc, obj)
            let i = check_expr(o.tc, idx)
            // String indexing returns a string (single character)
            if vtype_eq(o.ty, .Str) {
                return tc_er(i.tc, .Str)
            }
            let elem_ty = vtype_list_elem(o.ty)
            tc_er(i.tc, elem_ty)
        }
        .Block(body) -> check_block(tc, body)
        .Slice(obj, start, end) -> {
            let o = check_expr(tc, obj)
            let s = check_expr(o.tc, start)
            let e = check_expr(s.tc, end)
            tc_er(e.tc, o.ty)
        }
        .Assign(name, value) -> {
            let v = check_expr(tc, value)
            tc_er(v.tc, v.ty)
        }
        .QualifiedIdent(path) -> {
            let fn_ty = fn_type_get(tc.fns, path).ret_ty
            tc_er(tc, fn_ty)
        }
        _ -> {
            let tag = avra_expr_tag(expr)
            let result = dispatch_expr_check(tc.features, tag, tc, expr)
            if result != null { return result! }
            tc_er(tc, .Unknown)
        }
    }
}

// ── Shape structural compatibility ──
// Verify that all fields of a shape exist in the argument type.
// Called when a function parameter is a shape and the argument is a struct.

/// Verify that each arg passed to a shape-typed parameter has all
/// the required fields (width-subtype check).
fn tc_check_shape_args(tc: TC, params: ParamList, args: ExprList) -> TC {
    match params {
        .End -> tc
        .Node(_, param_vt, next_params) -> match args {
            .End -> tc
            .Node(arg_se, next_args) -> {
                let arg_ty = check_expr(tc, arg_se.node).ty
                let checked = tc_check_shape_compat(tc, vtype_display(param_vt), arg_ty)
                tc_check_shape_args(checked, next_params, next_args)
            }
        }
    }
}

// Check that newtype arguments match — UserId != OrderId even if both wrap string
/// Verify newtype-wrapped arguments: a `UserId` param doesn't
/// accept a bare `UUID` — the wrapper has to be explicit at the
/// call site.
fn tc_check_newtype_args(tc: TC, fn_name: string, params: ParamList, args: ExprList) -> TC {
    match params {
        .End -> tc
        .Node(param_name, param_vt, next_params) -> match args {
            .End -> tc
            .Node(arg_se, next_args) -> {
                let param_ty = resolve_vtype(tc, param_vt)
                let arg_ty = check_expr(tc, arg_se.node).ty
                // Newtype parameter check: must be same newtype or the inner type
                if param_ty is .Newtype {
                    if !vtype_eq(param_ty, arg_ty) && !vtype_assignable(arg_ty, param_ty) && !(arg_ty is .Unknown) {
                        let msg = "`${fn_name}` parameter `${param_name}` expects `${vtype_display(param_ty)}`, got `${vtype_display(arg_ty)}`"
                        return tc_check_newtype_args(tc_report(tc, DiagCode.TypeMismatch, msg), fn_name, next_params, next_args)
                    }
                }
                tc_check_newtype_args(tc, fn_name, next_params, next_args)
            }
        }
    }
}

// Extract the first argument's type. Safe to call after check_expr_list
// because re-deriving an expression's type is idempotent (no new bindings).
/// Infer the type of the first argument in an ExprList, or
/// Unknown when the list is empty. Used by newtype-ctor inference.
fn tc_first_arg_type(tc: TC, args: ExprList) -> ValueType {
    match args {
        .End -> ValueType.Void
        .Node(arg_se, _) -> check_expr(tc, arg_se.node).ty
    }
}

// Check newtype constructor argument matches the inner type
/// Verify that the single arg to a newtype constructor matches the
/// newtype's declared inner type. `UserId(uuid)` should pass a UUID.
fn tc_check_newtype_ctor(tc: TC, name: string, ret_ty: ValueType, arg_ty: ValueType) -> TC {
    match ret_ty {
        .Newtype(_, inner_ty, _) -> {
            if !vtype_eq(arg_ty, inner_ty) && !vtype_assignable(arg_ty, inner_ty) && !(arg_ty is .Unknown || inner_ty is .Unknown) {
                let msg = "`${name}()` expects `${vtype_display(inner_ty)}`, got `${vtype_display(arg_ty)}`"
                return tc_report(tc, DiagCode.TypeMismatch, msg)
            }
            tc
        }
        _ -> tc
    }
}

/// Verify shape compatibility — the arg's struct must have all the
/// fields the shape param requires (extras are fine; that's the
/// width-subtype rule).
fn tc_check_shape_compat(tc: TC, param_ty_str: string, arg_ty: ValueType) -> TC {
    // Only check when parameter type is a shape
    if !is_shape(tc.shapes, param_ty_str) { return tc }
    // Get the shape's required fields
    let shape_fields = struct_type_lookup(tc.structs, param_ty_str)
    // Get the argument's actual fields
    let arg_name = match arg_ty {
        .Struct(n, _) -> n
        _ -> ""
    }
    if arg_name == "" { return tc }
    let arg_fields = struct_type_lookup(tc.structs, arg_name)
    // Check each shape field exists in the arg type
    tc_check_fields_present(tc, param_ty_str, arg_name, shape_fields, arg_fields)
}

/// Inner check for `tc_check_shape_compat` — emit an error per
/// field that's required but missing from the arg type.
fn tc_check_fields_present(tc: TC, shape_name: string, arg_name: string, required: FieldList, available: FieldList) -> TC {
    match required {
        .End -> tc
        .Node(field_name, req_vt, next) -> {
            if !field_list_has(available, field_name) {
                let msg = "type `${arg_name}` does not satisfy shape `${shape_name}` — missing field `${field_name}`"
                tc_check_fields_present(tc_report(tc, DiagCode.TypeMismatch, msg), shape_name, arg_name, next, available)
            } else {
                let expected_vt = resolve_vtype(tc, req_vt)
                let actual_vt = resolve_vtype(tc, field_vtype_of(available, field_name))
                let after = if !vtype_is_unknown(expected_vt) && !vtype_is_unknown(actual_vt) && !vtype_eq(expected_vt, actual_vt) && !vtype_assignable(actual_vt, expected_vt) {
                    let msg = "field `${field_name}` has type `${vtype_display(actual_vt)}` in `${arg_name}` but shape `${shape_name}` requires `${vtype_display(expected_vt)}`"
                    tc_report(tc, DiagCode.TypeMismatch, msg)
                } else { tc }
                tc_check_fields_present(after, shape_name, arg_name, next, available)
            }
        }
    }
}

// ── Binary operator type rules ──

/// Type-check a binary operator. Most return Bool (comparisons) or
/// the operand's type (arithmetic); union-arg cases dispatch to
/// the appropriate concrete branch.
fn check_binary_type(tc: TC, left: ValueType, op: BinOp, right: ValueType) -> ExprResult {
    // If either operand is Float, arithmetic produces Float.
    let arith_ty = if vtype_eq(left, .Float) || vtype_eq(right, .Float) { ValueType.Float } else { ValueType.Int }
    match op {
        .Add -> {
            if vtype_eq(left, .Str) || vtype_eq(right, .Str) { return tc_er(tc, .Str) }
            tc_er(tc, arith_ty)
        }
        .Sub -> tc_er(tc, arith_ty)
        .Mul -> tc_er(tc, arith_ty)
        .Div -> tc_er(tc, arith_ty)
        .Mod -> tc_er(tc, arith_ty)
        .Eq -> tc_er(tc, .Bool)
        .Ne -> tc_er(tc, .Bool)
        .Lt -> tc_er(tc, .Bool)
        .Le -> tc_er(tc, .Bool)
        .Gt -> tc_er(tc, .Bool)
        .Ge -> tc_er(tc, .Bool)
        _ -> tc_er(tc, .Unknown)
    }
}

// ── Call type inference ──

// Check arity and return type for a named function call.
/// Type-check a fn call by name: verify arity, walk each arg
/// against its declared param type, and return the fn's declared
/// return type. Caller has already type-checked args via
/// `check_expr_list_types`.
/// Type-check a fn call given a pre-resolved registry record. The
/// caller is expected to have already gated on `rec.found` (or to
/// pass a `found=true` record in its happy path), so this body never
/// re-walks the FnTypeEntry chain — that's the kkgf hot-path saving.
fn tc_check_fn_call_with(checked: TC, name: string, args: ExprList, rec: FnTypeFound) -> ExprResult {
    let expected = param_list_length(rec.params)
    let actual = tc_count_args(args)
    if expected != actual {
        let s = if expected != 1 { "s" } else { "" }
        let msg = "`${name}` expects ${string(expected)} argument${s}, got ${string(actual)}"
        return tc_er(tc_report(checked, DiagCode.WrongArgCount, msg), rec.ret_ty)
    }
    // Check shape and newtype compatibility
    let shape_checked = tc_check_shape_args(checked, rec.params, args)
    let newtype_checked = tc_check_newtype_args(shape_checked, name, rec.params, args)
    let first_arg_ty = tc_first_arg_type(newtype_checked, args)
    let ctor_checked = tc_check_newtype_ctor(newtype_checked, name, rec.ret_ty, first_arg_ty)
    tc_er(ctor_checked, rec.ret_ty)
}

/// Type-check a `Call` expression. Routes to `check_method_call`
/// for `obj.method(args)`, otherwise falls through to
/// `tc_check_fn_call_with` after resolving the callee name.
fn check_call(tc: TC, callee: Expr, args: ExprList) -> ExprResult {
    match callee {
        .Ident(name) -> {
            let checked = check_expr_list(tc, args)
            // Built-in functions
            match name {
                "string" -> return tc_er(checked, .Str)
                "int"    -> return tc_er(checked, .Int)
                "println" or "eprintln" or "print" or "eprint" -> return tc_er(checked, .Void)
                _ -> {}
            }
            // User-defined function
            let r = fn_type_get(checked.fns, name)
            if r.found {
                return tc_check_fn_call_with(checked, name, args, r)
            }
            // Variable holding a closure
            let var_ty = type_lookup(checked.types, name)
            if vtype_is_unknown(var_ty) {
                return tc_er(checked, .Unknown)
            }
            tc_er(checked, vtype_fn_ret(var_ty))
        }
        .QualifiedIdent(path) -> {
            let checked = check_expr_list(tc, args)
            let r = fn_type_get(checked.fns, path)
            if r.found {
                return tc_check_fn_call_with(checked, path, args, r)
            }
            tc_er(checked, .Unknown)
        }
        .FieldAccess(obj, method) -> check_method_call(tc, obj, method, args)
        _ -> {
            // Expression callee (e.g. compose(f,g)(x))
            let c = check_expr(tc, callee)
            let checked = check_expr_list(c.tc, args)
            tc_er(checked, vtype_fn_ret(c.ty))
        }
    }
}

// ── Method call type inference ──

/// Type-check `obj.method(args)`: dispatch to type-specific
/// method tables (List / Map built-ins) or fall back to user-
/// defined impl blocks looked up by mangled name.
fn check_method_call(tc: TC, obj: Expr, method: string, args: ExprList) -> ExprResult {
    let o = check_expr(tc, obj)
    let checked_args = check_expr_list(o.tc, args)

    // String methods
    if vtype_eq(o.ty, .Str) {
        match method {
            "length" or "index_of" or "char_code" or "byte" -> return tc_er(checked_args, .Int)
            "substring" or "trim" or "upper" or "lower" or "replace"
            or "to_upper" or "to_lower" -> return tc_er(checked_args, .Str)
            "contains" or "starts_with" or "ends_with" -> return tc_er(checked_args, .Bool)
            "split" -> return tc_er(checked_args, .List(ValueType.Str))
            _ -> {}
        }
    }

    // Bytes methods. Surface mirrors string's where it makes sense
    // (length, byte access) but bytes-returning ops yield ValueType.Bytes
    // so the type system enforces the nominal distinction.
    if vtype_eq(o.ty, .Bytes) {
        match method {
            "length" or "byte" -> return tc_er(checked_args, .Int)
            "concat" or "slice" -> return tc_er(checked_args, .Bytes)
            "to_string" -> return tc_er(checked_args, .Str)
            _ -> {}
        }
    }

    // List methods — dispatched to features/list_lit/typeck.av
    if o.ty is .List {
        return check_list_method(checked_args, vtype_list_elem(o.ty), method, args)
    }

    // Map methods — dispatched to features/map_lit/typeck.av
    if vtype_eq(o.ty, .Map) {
        return check_map_method(checked_args, method)
    }

    // Method lookup — look up in fn registry as TypeName__method.
    // Works for structs, enums, newtypes, and trait types.
    let type_name = match o.ty {
        .Struct(n, _) -> n
        .Enum(n, _, _) -> n
        .Newtype(n, _, _) -> n
        .Trait(n, _) -> n
        _ -> ""
    }
    if type_name.length > 0 {
        let qualified = method_mangled_name(type_name, method)
        let r = fn_type_get(checked_args.fns, qualified)
        if r.found {
            return tc_er(checked_args, r.ret_ty)
        }
    }

    // Fallback — return Unknown for unknown methods
    tc_er(checked_args, .Unknown)
}

// ── Block expression type ──

/// Type-check a block as an expression — the block's value is
/// the value of its last statement (when that's an Expr stmt) or
/// Void otherwise.
fn check_block(tc: TC, stmts: StmtList) -> ExprResult {
    let inner = tc_enter(tc)
    let pair = check_block_stmts(inner, stmts)
    let after = tc_exit(pair.tc)
    tc_er(after, pair.ty)
}

/// Implementation of `check_block` — walks every stmt, returning
/// the last one's value type as the block's type.
fn check_block_stmts(tc: TC, stmts: StmtList) -> ExprResult {
    match stmts {
        .End -> tc_er(tc, .Void)
        .Node(ss, next) -> {
            match next {
                .End -> {
                    // Last statement — its type is the block's type
                    match ss.node {
                        .Expr(e) -> check_expr(tc, e)
                        _ -> {
                            let checked = check_stmt(tc, ss.node)
                            tc_er(checked, .Void)
                        }
                    }
                }
                _ -> {
                    let checked = check_stmt(tc, ss.node)
                    check_block_stmts(checked, next)
                }
            }
        }
    }
}

// ── Helpers ──

/// Type-check every expression in `exprs` for side effects only —
/// drops the inferred types. Use `check_expr_list_types` when the
/// caller needs the resulting type list.
export fn check_expr_list(tc: TC, exprs: ExprList) -> TC {
    match exprs {
        .End -> tc
        .Node(se, next) -> {
            let r = check_expr(tc, se.node)
            check_expr_list(r.tc, next)
        }
    }
}

/// Output of `check_expr_list_types` — the threaded TC plus the
/// inferred TypeList for the input expressions, in source order.
type ExprListResult = {
    tc: TC,
    types: TypeList,
}

/// Type-check every expression in `exprs` and return the list of
/// inferred types alongside the updated TC. Used by call-site
/// arity / per-arg type checks.
export fn check_expr_list_types(tc: TC, exprs: ExprList) -> ExprListResult {
    match exprs {
        .End -> ExprListResult { tc, types: TypeList.End }
        .Node(se, next) -> {
            let r = check_expr(tc, se.node)
            let rest = check_expr_list_types(r.tc, next)
            ExprListResult { tc: rest.tc, types: TypeList.Node(r.ty, rest.types) }
        }
    }
}

// ── Pass 3: Type annotation ──
// Walks the AST and stamps resolved ValueTypes onto SExpr.ty fields.
// Uses the TC state populated by Pass 1+2 (all bindings are in scope).

/// Annotation-pass scope-enter: bind every param into the type env
/// at the new depth. Mirror of `tc_bind_params` for the second
/// pass that writes types back into the AST.
fn annotate_enter_fn(tc: TC, params: ParamList) -> TC {
    tc_bind_params(tc_enter(tc), params)
}

/// Annotation-pass let-binding: re-infer the initializer's type
/// (mostly free since the check pass already did the work) and
/// register the binding for downstream lookups.
fn annotate_bind(tc: TC, name: string, ty_vt: ValueType, init: Expr) -> TC {
    let r = check_expr(tc, init)
    let declared_ty = if !vtype_is_unknown(ty_vt) { resolve_vtype(tc, ty_vt) } else { r.ty }
    tc_bind(tc, name, declared_ty)
}

/// Walk a StmtList, returning a copy with every contained SExpr's
/// `.ty` field filled in.
fn annotate_stmts(tc: TC, stmts: StmtList) -> StmtList {
    match stmts {
        .End -> .End
        .Node(ss, next) -> {
            let new_stmt = annotate_stmt(tc, ss.node)
            let updated_tc = match ss.node {
                .Let(name, ty_vt, init) -> annotate_bind(tc, name, ty_vt, init)
                .Mut(name, ty_vt, init) -> annotate_bind(tc, name, ty_vt, init)
                .Const(name, ty_vt, init) -> annotate_bind(tc, name, ty_vt, init)
                _ -> tc
            }
            StmtList.Node(sstmt(new_stmt, ss.line, ss.col), annotate_stmts(updated_tc, next))
        }
    }
}

/// Per-stmt branch of the annotation pass.
fn annotate_stmt(tc: TC, stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, vt, annotate_expr(tc, init))
        .Mut(name, vt, init) -> .Mut(name, vt, annotate_expr(tc, init))
        .Const(name, vt, init) -> .Const(name, vt, annotate_expr(tc, init))
        .Expr(e) -> .Expr(annotate_expr(tc, e))
        .Return(val) -> .Return(annotate_expr(tc, val))
        .Block(body) -> .Block(annotate_stmts(tc, body))
        .If(cond, then_b, else_b) -> {
            if else_b != null {
                .If(annotate_expr(tc, cond), annotate_stmt(tc, then_b), annotate_stmt(tc, else_b!))
            } else {
                .If(annotate_expr(tc, cond), annotate_stmt(tc, then_b), null)
            }
        }
        .While(cond, body) -> .While(annotate_expr(tc, cond), annotate_stmt(tc, body))
        .For(v, start, end, body) -> .For(v, annotate_expr(tc, start), annotate_expr(tc, end), annotate_stmt(tc, body))
        .ForIn(v, coll, body) -> .ForIn(v, annotate_expr(tc, coll), annotate_stmt(tc, body))
        .Function(name, tp, params, rvt, body) ->
            .Function(name, tp, params, rvt, annotate_stmts(annotate_enter_fn(tc, params), body))
        .Match(subj, arms) -> .Match(annotate_expr(tc, subj), annotate_match_arms(tc, arms))
        .Module(name, body) -> .Module(name, annotate_stmts(tc, body))
        .Annotated(annots, inner) -> .Annotated(annots, annotate_stmt(tc, inner))
        .Impl(name, methods) -> .Impl(name, annotate_stmts(tc, methods))
        .Defer(body) -> .Defer(annotate_expr(tc, body))
        .LetDestructure(names, init) -> .LetDestructure(names, annotate_expr(tc, init))
        .ThenBlock(name, cond) -> .ThenBlock(name, annotate_expr(tc, cond))
        .Parallel(body) -> .Parallel(annotate_stmts(tc, body))
        _ -> stmt  // ReturnEmpty, NoOp, Break, Continue, ExternFn, TypeDecl, EnumDecl, TraitDecl, Use, SpecBlock, GivenBlock, Select
    }
}

// Recursively annotate SExpr-containing sub-structures within an Expr.
/// Recurse into nested expressions, threading the TC so SExprs
/// emerge with their `.ty` populated.
fn annotate_expr(tc: TC, expr: Expr) -> Expr {
    match expr {
        .Call(callee, args) -> .Call(annotate_expr(tc, callee), annotate_expr_list(tc, args))
        .GenericCall(callee, ta, args) -> .GenericCall(annotate_expr(tc, callee), ta, annotate_expr_list(tc, args))
        .EnumCtor(tn, v, args) -> .EnumCtor(tn, v, annotate_expr_list(tc, args))
        .StructLit(name, inits) -> .StructLit(name, annotate_field_inits(tc, inits))
        .MatchExpr(subj, arms) -> .MatchExpr(annotate_expr(tc, subj), annotate_match_arms(tc, arms))
        .ListLit(elems) -> .ListLit(annotate_expr_list(tc, elems))
        .Tuple(elems) -> .Tuple(annotate_expr_list(tc, elems))
        .MapLit(entries) -> .MapLit(annotate_expr_list(tc, entries))
        .With(obj, inits) -> .With(annotate_expr(tc, obj), annotate_field_inits(tc, inits))
        .Block(body) -> .Block(annotate_stmts(tc, body))
        .Binary(l, op, r) -> .Binary(annotate_expr(tc, l), op, annotate_expr(tc, r))
        .Logical(l, op, r) -> .Logical(annotate_expr(tc, l), op, annotate_expr(tc, r))
        .Unary(op, e) -> .Unary(op, annotate_expr(tc, e))
        .Grouping(e) -> .Grouping(annotate_expr(tc, e))
        .IfExpr(c, t, e) -> .IfExpr(annotate_expr(tc, c), annotate_expr(tc, t), annotate_expr(tc, e))
        .Index(obj, idx) -> .Index(annotate_expr(tc, obj), annotate_expr(tc, idx))
        .FieldAccess(obj, f) -> .FieldAccess(annotate_expr(tc, obj), f)
        .Assign(name, val) -> .Assign(name, annotate_expr(tc, val))
        .FieldAssign(obj, f, val) -> .FieldAssign(annotate_expr(tc, obj), f, annotate_expr(tc, val))
        .Lambda(params, body) -> .Lambda(params, annotate_expr(tc, body))
        .NullCoalesce(l, r) -> .NullCoalesce(annotate_expr(tc, l), annotate_expr(tc, r))
        .Try(e) -> .Try(annotate_expr(tc, e))
        .Slice(obj, start, end) -> .Slice(annotate_expr(tc, obj), annotate_expr(tc, start), annotate_expr(tc, end))
        .IsCheck(subj, vname) -> .IsCheck(annotate_expr(tc, subj), vname)
        .InCheck(needle, items) -> .InCheck(annotate_expr(tc, needle), annotate_expr_list(tc, items))
        .ListComp(body, var, coll, filter) -> {
            if filter != null {
                .ListComp(annotate_expr(tc, body), var, annotate_expr(tc, coll), annotate_expr(tc, filter!))
            } else {
                .ListComp(annotate_expr(tc, body), var, annotate_expr(tc, coll), null)
            }
        }
        .Catch(inner, b, body, cl, cc) -> .Catch(annotate_expr(tc, inner), b, annotate_expr(tc, body), cl, cc)
        .OptionalChain(obj, f) -> .OptionalChain(annotate_expr(tc, obj), f)
        .TupleIndex(obj, idx) -> .TupleIndex(annotate_expr(tc, obj), idx)
        .When(arms) -> .When(annotate_when_arms(tc, arms))
        .Spawn(body) -> .Spawn(annotate_expr(tc, body))
        _ -> expr  // Leaf expressions: Number, String, Bool, Null, Ident, FloatLit, QualifiedIdent
    }
}

/// Run `check_expr` on `se.node`, write the inferred type back to
/// `se.ty`, and recurse into the inner Expr.
fn annotate_sexpr(tc: TC, se: SExpr) -> SExpr {
    // Annotate the inner expression tree (recurse into sub-expressions)
    let annotated_node = annotate_expr(tc, se.node)
    // Stamp this SExpr's type — fast path for common expressions avoids
    // re-running check_expr (which would double-check the entire subtree).
    let ty = match annotated_node {
        .Number(_) -> ValueType.Int
        .FloatLit(_) -> ValueType.Float
        .String(_) -> ValueType.Str
        .Bool(_) -> ValueType.Bool
        .Null -> ValueType.Void
        .Ident(name) -> type_lookup(tc.types, name)
        // Comparison operators always return Bool
        .Binary(_, op, _) if op is .Eq || op is .Ne || op is .Lt || op is .Le || op is .Gt || op is .Ge -> ValueType.Bool
        .Logical(_, _, _) -> ValueType.Bool
        // Arithmetic binary/unary: fall through to check_expr for float handling
        // Unary: falls through to check_expr for correct float handling
        // Call: look up return type from function registry
        .Call(callee, _) -> match callee {
            .Ident(name) -> fn_type_get(tc.fns, name).ret_ty
            _ -> check_expr(tc, se.node).ty
        }
        // Struct/Enum constructors
        .StructLit(name, _) -> ValueType.Struct(name, 0)
        .EnumCtor(name, _, _) -> {
            if name != "" { ValueType.Enum(name, TypeList.End, 0) } else { check_expr(tc, se.node).ty }
        }
        .ListLit(_) -> ValueType.List(ValueType.Unknown)
        .MapLit(_) -> ValueType.Map
        .Tuple(_) -> ValueType.Tuple(TypeList.End)
        .Lambda(_, _) -> ValueType.Fn(ValueType.Unknown)
        // Grouping forwards its inner expression's type. Used heavily
        // by parser-emitted parenthesised forms; falling through to
        // check_expr was a needless re-walk.
        .Grouping(inner) -> annotate_sexpr_ty(tc, inner)
        // Range forms always produce an Int range (codegen doesn't
        // distinguish further). Avoids check_expr on every range-for.
        .Range(_, _) -> ValueType.Int
        .RangeIncl(_, _) -> ValueType.Int
        // Index/FieldAccess/Unary still need check_expr because the
        // type depends on registry/operand state — but field/method
        // calls inside InterpString are usually leaf-ish, so do them
        // directly. InterpString itself is always a string.
        .InterpString(_) -> ValueType.Str
        // kkgf: type-test variants always evaluate to Bool — no
        // operand inspection needed. These are very common in match
        // guards and conditional flows in the bootstrap source.
        .IsCheck(_, _) -> ValueType.Bool
        .InCheck(_, _) -> ValueType.Bool
        // Assign expressions return the assigned RHS type. Since
        // the RHS sub-expression was annotated by annotate_expr
        // above, looking it up via annotate_sexpr_ty is one
        // tag-dispatch instead of a full check_expr re-walk.
        .Assign(_, val) -> annotate_sexpr_ty(tc, val)
        // kkgf: FieldAccess on a bare ident is the dominant pattern
        // in the bootstrap (self.x, ctx.foo, e.name, ...). When the
        // base is an Ident we know its type from tc.types; the field
        // type comes from the struct registry. Falls back to
        // check_expr only when the base is a more complex expression
        // (chained field accesses, calls returning structs, etc.).
        .FieldAccess(base, fname) -> match base {
            .Ident(obj_name) -> {
                let base_ty = type_lookup(tc.types, obj_name)
                let sname = vtype_struct_name(base_ty)
                if sname == "" {
                    check_expr(tc, se.node).ty
                } else {
                    let field_ty = field_type_lookup(struct_type_lookup(tc.structs, sname), fname)
                    if vtype_is_unknown(field_ty) {
                        check_expr(tc, se.node).ty
                    } else {
                        field_ty
                    }
                }
            }
            _ -> check_expr(tc, se.node).ty
        }
        // kkgf: Index on a bare ident — common pattern is `xs[i]`
        // where xs is a List. Falls back when base type isn't a
        // List (string indexing, map indexing, custom Index impls).
        .Index(base, _) -> match base {
            .Ident(obj_name) -> {
                let base_ty = type_lookup(tc.types, obj_name)
                let elem_ty = vtype_list_elem(base_ty)
                if vtype_is_unknown(elem_ty) {
                    check_expr(tc, se.node).ty
                } else {
                    elem_ty
                }
            }
            _ -> check_expr(tc, se.node).ty
        }
        // Try unwraps a Result; the unwrapped success type matches
        // the inner expression's type only when the parser desugar
        // pass has already lowered it. For now this stays in the
        // fallback so we don't regress error-propagation typeck.
        // Fallback: re-run check_expr for complex expressions
        _ -> check_expr(tc, se.node).ty
    }
    sexpr_typed(annotated_node, se.line, se.col, ty)
}

/// Cheap one-step type lookup on a bare Expr that mirrors the
/// fast-path table in annotate_sexpr but without recursing into
/// sub-expressions. Used by leaves that just forward (Grouping).
fn annotate_sexpr_ty(tc: TC, e: Expr) -> ValueType {
    match e {
        .Number(_) -> ValueType.Int
        .FloatLit(_) -> ValueType.Float
        .String(_) -> ValueType.Str
        .Bool(_) -> ValueType.Bool
        .Null -> ValueType.Void
        .Ident(name) -> type_lookup(tc.types, name)
        .InterpString(_) -> ValueType.Str
        .Range(_, _) -> ValueType.Int
        .RangeIncl(_, _) -> ValueType.Int
        _ -> check_expr(tc, e).ty
    }
}

/// Map `annotate_sexpr` over an ExprList.
fn annotate_expr_list(tc: TC, exprs: ExprList) -> ExprList {
    match exprs {
        .End -> .End
        .Node(se, next) -> ExprList.Node(annotate_sexpr(tc, se), annotate_expr_list(tc, next))
    }
}

/// Walk every match arm, binding pattern captures into the type
/// env, then annotating both guard and body.
fn annotate_match_arms(tc: TC, arms: MatchArmList) -> MatchArmList {
    match arms {
        .End -> .End
        .Node(pat, guard, body, next) -> {
            let new_guard = if guard != null { annotate_sexpr(tc, guard!) } else { null }
            MatchArmList.Node(pat, new_guard, annotate_sexpr(tc, body), annotate_match_arms(tc, next))
        }
    }
}

/// Map `annotate_sexpr` over each FieldInitList value.
fn annotate_field_inits(tc: TC, inits: FieldInitList) -> FieldInitList {
    match inits {
        .End -> .End
        .Node(name, val, next) -> FieldInitList.Node(name, annotate_sexpr(tc, val), annotate_field_inits(tc, next))
    }
}

/// Walk every `when` arm, annotating cond + body SExprs.
fn annotate_when_arms(tc: TC, arms: WhenArmList) -> WhenArmList {
    match arms {
        .End -> .End
        .Node(cond, body, next) -> {
            let new_cond = if cond != null { annotate_sexpr(tc, cond!) } else { null }
            WhenArmList.Node(new_cond, annotate_sexpr(tc, body), annotate_when_arms(tc, next))
        }
    }
}

// ── Naming convention checks ──
// PascalCase: first char uppercase, no underscores (except leading _)
// snake_case: all lowercase or underscore or digit
// SCREAMING_SNAKE: all uppercase or underscore or digit

/// True iff `ch` is an ASCII uppercase letter.
fn is_upper(ch: string) -> bool { ch in "A".."Z" }
/// True iff `ch` is an ASCII lowercase letter.
fn is_lower(ch: string) -> bool { ch in "a".."z" }
/// True iff `ch` is an ASCII digit. Local copy so the
/// naming-convention helpers don't depend on lexer/.
fn is_naming_digit(ch: string) -> bool { ch in "0".."9" }

/// True iff `name` follows the PascalCase convention: first char
/// uppercase, no underscores in the rest. Leading `_` is allowed
/// for explicitly-private types.
fn is_pascal_case(name: string) -> bool {
    if name.length == 0 { return true }
    // For qualified names like "module::TypeName", check the last segment
    if name.contains("::") {
        return is_pascal_case(type_short_name(name))
    }
    let first = name[0]
    if first == "_" { return true }  // skip private names
    if !is_upper(first) { return false }
    // PascalCase: no underscores in the rest
    mut i = 1
    while i < name.length {
        if name[i] == "_" { return false }
        i = i + 1
    }
    true
}

/// True iff `name` is snake_case: all lowercase / digits /
/// underscores. Leading `_` allowed for private bindings.
fn is_snake_case(name: string) -> bool {
    if name.length == 0 { return true }
    let first = name[0]
    if first == "_" { return true }
    if is_upper(first) { return false }
    mut i = 0
    while i < name.length {
        let ch = name[i]
        if !is_lower(ch) && ch != "_" && ch != ":" && !is_naming_digit(ch) {
            return false
        }
        i = i + 1
    }
    true
}

/// True iff `name` is SCREAMING_SNAKE_CASE: all uppercase / digits
/// / underscores. Used for `const` declarations.
fn is_screaming_snake(name: string) -> bool {
    if name.length == 0 { return true }
    if name[0] == "_" { return true }
    mut i = 0
    while i < name.length {
        let ch = name[i]
        if !is_upper(ch) && ch != "_" && !is_naming_digit(ch) {
            return false
        }
        i = i + 1
    }
    true
}

/// Emit an `F9003 NamingConvention` warning at the TC's current
/// position with `msg` as the body.
fn naming_warn(tc: TC, msg: string) -> TC {
    let sp = span_dummy()
    let d = diag_with_confidence(diag_warning(DiagCode.NamingConvention, msg, sp), Confidence.Medium)
    tc with { bag: bag_report(tc.bag, d) }
}

/// Walk every top-level statement and apply the per-decl naming-
/// convention check.
fn check_naming_conventions(tc: TC, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(ss, next) -> {
            let updated = check_naming_stmt(tc, ss.node)
            check_naming_conventions(updated, next)
        }
    }
}

/// Per-stmt branch of `check_naming_conventions`. Each declaration
/// kind has its own expected case (PascalCase for types/enums/
/// traits, snake_case for fns/lets, SCREAMING_SNAKE for consts).
fn check_naming_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Annotated(_, inner) -> check_naming_stmt(tc, inner)
        .Function(name, _, _, _, body) -> {
            // Strip impl prefix (TypeName__method → check method part only)
            let check_name = if name.index_of("__") > 0 {
                name.substring(name.index_of("__") + 2, name.length)
            } else { name }
            let tc2 = if check_name != "main" && !is_snake_case(check_name) {
                naming_warn(tc, "function `${name}` should be snake_case")
            } else {
                tc
            }
            check_naming_conventions(tc2, body)
        }
        .TypeDecl(name, _, _) -> {
            if !is_pascal_case(name) {
                naming_warn(tc, "type `${name}` should be PascalCase")
            } else {
                tc
            }
        }
        .EnumDecl(name, _, _) -> {
            if !is_pascal_case(name) {
                naming_warn(tc, "enum `${name}` should be PascalCase")
            } else {
                tc
            }
        }
        .Const(name, _, _) -> {
            if !is_screaming_snake(name) {
                naming_warn(tc, "constant `${name}` should be SCREAMING_SNAKE_CASE")
            } else {
                tc
            }
        }
        .Let(name, _, _) -> {
            if !is_snake_case(name) {
                naming_warn(tc, "variable `${name}` should be snake_case")
            } else {
                tc
            }
        }
        .Mut(name, _, _) -> {
            if !is_snake_case(name) {
                naming_warn(tc, "variable `${name}` should be snake_case")
            } else {
                tc
            }
        }
        .Block(body) -> check_naming_conventions(tc, body)
        .If(_, then_br, else_br) -> {
            let tc2 = check_naming_stmt(tc, then_br)
            if else_br != null { check_naming_stmt(tc2, else_br!) } else { tc2 }
        }
        .While(_, body) -> check_naming_stmt(tc, body)
        .For(_, _, _, body) -> check_naming_stmt(tc, body)
        .ForIn(_, _, body) -> check_naming_stmt(tc, body)
        .Module(_, body) -> check_naming_conventions(tc, body)
        .Impl(_, methods) -> check_naming_conventions(tc, methods)
        _ -> tc
    }
}

