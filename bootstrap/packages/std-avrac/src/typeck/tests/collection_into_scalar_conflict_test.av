// WHY: regression for a85d — a list/map literal (always a pointer) assigned to a
// VALUE-SCALAR slot (int/float/bool/…) was silently accepted: `let x: int =
// [1,2]` / `let x: int = {"k":1}` stored a pointer in a scalar cell — the
// inverse of the ry1a scalar→ptr hole. check_expr_expected's .ListLit/.MapLit
// arms now reject a value-scalar expected type. Non-scalar pointer slots (e.g.
// `string`) are a nominal mismatch handled elsewhere, so only value scalars are
// gated here — which is what keeps the check free of false positives.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

fn cs_out(source: string) -> string {
    let path = "/tmp/avra_collection_into_scalar.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 compile '${path}' 2>&1 && echo __AVRA_COMPILE_OK__ || true")
}

spec "a collection/map literal into a value-scalar slot is rejected (a85d)" {
    then "a list literal into an int slot is F1000" {
        let out = cs_out("fn main() { let x: int = [1, 2] }")
        out.contains("F1000")
    }
    then "a map literal into an int slot is F1000" {
        let out = cs_out("fn main() { let x: int = {\"k\": 1} }")
        out.contains("F1000")
    }
    then "a list literal into a float slot is F1000" {
        let out = cs_out("fn main() { let x: float = [1] }")
        out.contains("F1000")
    }
    then "a map literal into a bool slot is F1000" {
        let out = cs_out("fn main() { let b: bool = {\"k\": 1} }")
        out.contains("F1000")
    }
    then "a list VARIABLE into an int slot is F1000 (non-literal path)" {
        let out = cs_out("fn main() { let xs: List<int> = [1]  let x: int = xs }")
        out.contains("F1000")
    }
    then "a map VARIABLE into an int slot is F1000 (non-literal path)" {
        let out = cs_out("fn main() { let m: Map<string, int> = {\"a\": 1}  let x: int = m }")
        out.contains("F1000")
    }
    then "reassigning a list literal into an int var is F1000" {
        let out = cs_out("fn main() { mut x: int = 0  x = [1] }")
        out.contains("F1000")
    }
    then "a CALL returning a list into an int slot is F1000" {
        let out = cs_out("fn make_list() -> List<int> { [1] }
fn main() { let x: int = make_list() }")
        out.contains("F1000")
    }
    then "a list literal into a scalar struct FIELD is F1000" {
        let out = cs_out("type S = { n: int }
fn main() { let s = S { n: [1] } }")
        out.contains("F1000")
    }
    then "assigning a list literal to a scalar struct field is F1000" {
        let out = cs_out("type S = { n: int }
fn main() { mut s = S { n: 0 }  s.n = [1] }")
        out.contains("F1000")
    }
    // A tail-`match` arm is a return slot: a collection arm into a value-scalar
    // return type is the same wild store, caught via the full layout gate.
    then "a match arm returning a list into an int return type is F1000" {
        let out = cs_out("fn f(c: int) -> int { match c { 0 -> 1  _ -> [1] } }
fn main() { let _ = f(1) }")
        out.contains("F1000")
    }
    then "a match arm returning a map into an int return type is F1000" {
        let out = cs_out("fn f(c: int) -> int { match c { 0 -> 1  _ -> {\"k\": 1} } }
fn main() { let _ = f(1) }")
        out.contains("F1000")
    }
}

spec "valid collection bindings still compile (a85d — no false positives)" {
    then "a list literal into a List slot compiles" {
        let out = cs_out("fn main() { let xs: List<int> = [1, 2] }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a map literal into a Map slot compiles" {
        let out = cs_out("fn main() { let m: Map<string, int> = {\"k\": 1} }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "an unannotated list literal compiles" {
        let out = cs_out("fn main() { let x = [1, 2]  let _ = x.length }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a nested list-of-lists compiles (inner lists aren't scalar slots)" {
        let out = cs_out("fn main() { let xs: List<List<int>> = [[1], [2]] }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a list variable into a List slot compiles (no false positive on the non-literal path)" {
        let out = cs_out("fn main() { let xs: List<int> = [1]  let ys: List<int> = xs }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a list arg into a List PARAMETER compiles (no false positive)" {
        let out = cs_out("fn take_list(xs: List<int>) -> int { xs.length }
fn main() { let xs: List<int> = [1]  let _ = take_list(xs) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a call returning a list into a List slot compiles (no false positive)" {
        let out = cs_out("fn make_list() -> List<int> { [1] }
fn main() { let xs: List<int> = make_list() }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a list literal into a List struct field compiles (no false positive)" {
        let out = cs_out("type S = { xs: List<int> }
fn main() { let s = S { xs: [1, 2] } }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "reassigning an int var to an int compiles (no false positive)" {
        let out = cs_out("fn main() { mut x: int = 0  x = 5 }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a match arm returning a list into a List return type compiles (no false positive)" {
        let out = cs_out("fn f(c: int) -> List<int> { match c { 0 -> [0]  _ -> [1] } }
fn main() { let _ = f(1) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}

// A normal Avra fn parameter is a real typed slot, so a collection into a
// value-scalar param is a wild store (wlll). The carve-out that lets a collection
// flow into an `int` param applies ONLY to `extern fn`s, where `int` is an
// i64-legacy generic value slot (gated on FnTypeMeta.is_extern).
spec "collection into a fn parameter — normal fns gated, extern shims exempt (wlll)" {
    then "a list literal into a normal fn's int param is F1000" {
        let out = cs_out("fn f(x: int) -> int { return x }
fn main() { let _ = f([1]) }")
        out.contains("F1000")
    }
    then "a map literal into a normal fn's int param is F1000" {
        let out = cs_out("fn f(x: int) -> int { return x }
fn main() { let _ = f({\"k\": 1}) }")
        out.contains("F1000")
    }
    then "a list variable into a normal fn's int param is F1000 (non-literal path)" {
        let out = cs_out("fn f(x: int) -> int { return x }
fn main() { let xs: List<int> = [1]  let _ = f(xs) }")
        out.contains("F1000")
    }
    then "a list into an EXTERN fn's int param compiles (i64-legacy carve-out)" {
        let out = cs_out("extern fn avra_map_set_cstr(map: ptr, key: string, value: int) -> int
fn main() { let xs: List<int> = [1]  let _ = avra_map_set_cstr(0, \"k\", xs) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a map into an EXTERN fn's int param compiles (i64-legacy carve-out)" {
        let out = cs_out("extern fn avra_map_set_cstr(map: ptr, key: string, value: int) -> int
fn main() { let m: Map<string, int> = {\"k\": 1}  let _ = avra_map_set_cstr(0, \"k\", m) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "an int into a normal fn's int param compiles (no false positive)" {
        let out = cs_out("fn f(x: int) -> int { return x }
fn main() { let _ = f(5) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a list into a normal fn's List param compiles (no false positive)" {
        let out = cs_out("fn f(xs: List<int>) -> int { return xs.length }
fn main() { let _ = f([1, 2]) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}

// Finding 2 (CodeRabbit #539): the fn-param layout gate must also fire at the
// explicit-type-arg call path (g<string>([1])) and the user-defined method-call
// path (obj.m([1])) — both previously returned without reaching the gate. Methods
// compare against params[1..] (self projected out by method_params_without_self).
spec "collection into a param at method and explicit-generic call sites (wlll/#539)" {
    then "a list into a method's int param is F1000" {
        let out = cs_out("type Box = { v: int }
impl Box { fn take(self, x: int) -> int { return x } }
fn main() { let b = Box { v: 0 }  let _ = b.take([1]) }")
        out.contains("F1000")
    }
    then "a list into an explicit-generic call's int param is F1000" {
        let out = cs_out("fn g<T>(x: int) -> int { return x }
fn main() { let _ = g<string>([1]) }")
        out.contains("F1000")
    }
    then "an int into a method's int param compiles (no false positive)" {
        let out = cs_out("type Box = { v: int }
impl Box { fn take(self, x: int) -> int { return x } }
fn main() { let b = Box { v: 0 }  let _ = b.take(5) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "an int into an explicit-generic call's int param compiles (no false positive)" {
        let out = cs_out("fn g<T>(x: int) -> int { return x }
fn main() { let _ = g<string>(5) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a list into a method's List param compiles (no false positive)" {
        let out = cs_out("type Box = { v: int }
impl Box { fn take(self, xs: List<int>) -> int { return xs.length } }
fn main() { let b = Box { v: 0 }  let _ = b.take([1, 2]) }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}
