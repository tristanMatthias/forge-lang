// WHY: regression for forge-crafting-intepreters-98z0 — a constructor value that
// is pointer-represented (an ENUM's 16-byte {tag, payload}, or a STRUCT literal's
// heap record) stored into a VALUE-SCALAR slot (int/bool/float) is a wild store:
// the scalar cell holds a pointer, and a reader derefs the scalar bits as the
// pointer's target. All forms compiled clean before the fix:
//   - `let x: int = Wrap.W(...)`      (named enum ctor)
//   - `let x: int = .W(...)`          (subjectless enum ctor)
//   - `let x: int = Box { val: 9 }`   (struct literal)
//   - `let x: int = (Box { val: 9 })` (any of the above, parenthesized)
//
// The named enum form routes through the shared assign_layout_conflict gate,
// which caught int→ptr and List/Map→scalar but NOT a concrete enum→scalar — fixed
// by adding enum_into_value_scalar_slot to it. The subjectless enum form returned
// `.Unknown` from check_expr_expected and bypassed the gate entirely — fixed by
// gating that arm. The struct literal reached the StructLit arm, which only
// checked generic-arg conflicts, not the scalar slot — fixed by routing it through
// the same reject_literal_into_value_scalar the list/map arms use. Parens build a
// `.Grouping` wrapper check_expr_expected didn't see through, so a single pair
// reopened the hole — fixed by making `.Grouping` transparent (recurse on the
// inner with the same expected type).
//
// A struct VALUE (not a literal) reaches the same slot through a fn-arg, a
// variable, or a reassignment — positions that route through the shared
// assign_layout_conflict gate. That gate gains concrete_struct_into_value_scalar_slot
// so those are caught too (`take(Box{…})` into `take(n: int)`; `let s = Box{…};
// let x: int = s`).
//
// All gates are scoped so they never fire on a bare type-param: enums are never
// type-params; a struct literal always names a concrete declared type; the
// struct-VALUE gate is restricted to a CONCRETE struct (a bare `.Struct("T")` is
// skipped); a scalar slot is never an inference artifact. So a generic fn that
// binds a type-param struct arg (or returns a type-param) into an int slot stays
// lenient (asserted below).

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

// Compile and emit a sentinel ONLY on a clean compile, so the positive controls
// assert real success rather than the mere absence of an F-code.
fn z98_out(source: string) -> string {
    let path = "/tmp/avra_98z0_neg.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 compile '${path}' 2>&1 && echo __AVRA_COMPILE_OK__ || true")
}

spec "98z0: an enum ctor value into a value-scalar slot is rejected" {
    then "named: Wrap.W(...) into an int annotation is F1000 (layout conflict)" {
        let out = z98_out("type Box = { val: int }
enum Wrap { W(b: Box) }
fn main() { let x: int = Wrap.W(Box { val: 9 }) }")
        out.contains("F1000") && out.contains("layout conflict")
    }
    then "subjectless: .W(...) into an int annotation is F1000 (layout conflict)" {
        let out = z98_out("type Box = { val: int }
enum Wrap { W(b: Box) }
fn main() { let x: int = .W(Box { val: 9 }) }")
        out.contains("F1000") && out.contains("layout conflict")
    }
    then "a payload-less enum value into a bool slot is F1000" {
        let out = z98_out("enum E { A, B }
fn main() { let x: bool = E.A }")
        out.contains("F1000")
    }
}

spec "98z0: a struct literal into a value-scalar slot is rejected" {
    then "Box { val: 9 } into an int annotation is F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: int = Box { val: 9 } }")
        out.contains("F1000") && out.contains("value-scalar")
    }
    then "Box { val: 9 } into a bool annotation is F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: bool = Box { val: 9 } }")
        out.contains("F1000") && out.contains("value-scalar")
    }
    then "a struct literal RETURNED into an int slot is F1000 (return position)" {
        let out = z98_out("type Box = { val: int }
fn make() -> int { return Box { val: 9 } }
fn main() { let x = make()  println(\"ok\") }")
        out.contains("F1000") && out.contains("value-scalar")
    }
    then "a struct literal into a float annotation is F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: float = Box { val: 9 } }")
        out.contains("F1000") && out.contains("value-scalar")
    }
}

spec "98z0: a parenthesized ctor cannot smuggle past the gate" {
    // Parens build a `.Grouping` wrapper; without transparency in
    // check_expr_expected the wrapper falls to the universal arm and the
    // dedicated struct / subjectless-enum gates never run, so one pair of
    // parens reopens the wild store.
    then "(Box { val: 9 }) into an int annotation is F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: int = (Box { val: 9 }) }")
        out.contains("F1000") && out.contains("value-scalar")
    }
    then "a subjectless (.W(...)) into an int annotation is F1000" {
        let out = z98_out("type Box = { val: int }
enum Wrap { W(b: Box) }
fn main() { let x: int = (.W(Box { val: 9 })) }")
        out.contains("F1000") && out.contains("layout conflict")
    }
    then "doubly-parenthesized ((Box { val: 9 })) into int is still F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: int = ((Box { val: 9 })) }")
        out.contains("F1000") && out.contains("value-scalar")
    }
    then "(Box { val: 9 }) into a matching Box slot still compiles" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: Box = (Box { val: 9 })  println(\"ok\") }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}

spec "98z0: a struct value reaches the scalar gate at non-literal positions too" {
    // A struct literal in a let/return is caught by the StructLit arm; a struct
    // VALUE that flows through a fn-arg or a variable routes through the shared
    // assign_layout_conflict gate, which gains concrete_struct_into_value_scalar_slot
    // (type-param-safe: a bare `.Struct("T")` is skipped).
    then "a struct literal passed to an int parameter is F1000" {
        let out = z98_out("type Box = { val: int }
fn take(n: int) { println(\"${n}\") }
fn main() { take(Box { val: 9 }) }")
        out.contains("F1000") && out.contains("layout conflict")
    }
    then "a struct held in a variable, then bound to an int, is F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { let s = Box { val: 9 }  let x: int = s }")
        out.contains("F1000") && out.contains("layout conflict")
    }
    then "a CONCRETE struct value reassigned into an int (mut) is F1000" {
        let out = z98_out("type Box = { val: int }
fn main() { mut x: int = 0  let s = Box { val: 9 }  x = s }")
        out.contains("F1000")
    }
    then "passing the matching struct to a struct parameter still compiles" {
        let out = z98_out("type Box = { val: int }
fn take(b: Box) { println(\"${b.val}\") }
fn main() { take(Box { val: 9 })  println(\"ok\") }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a generic fn binding a type-param struct arg is NOT flagged" {
        let out = z98_out("type Box<T> = { val: T }
fn unbox<T>(b: Box<T>) -> T { b.val }
fn main() { let i: int = unbox(Box { val: 9 })  println(\"ok\") }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}

spec "98z0: matching slots and a type-param still check clean (no false positive)" {
    then "Wrap.W(...) into a Wrap slot compiles" {
        let out = z98_out("type Box = { val: int }
enum Wrap { W(b: Box) }
fn main() { let x: Wrap = Wrap.W(Box { val: 9 })  println(\"ok\") }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "Box { val: 9 } into a Box slot compiles" {
        let out = z98_out("type Box = { val: int }
fn main() { let x: Box = Box { val: 9 }  println(\"ok\") }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a generic fn returning a type-param into an int slot is NOT flagged" {
        let out = z98_out("fn id<T>(x: T) -> T { x }
fn main() { let x: int = id(9)  println(\"ok\") }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}
