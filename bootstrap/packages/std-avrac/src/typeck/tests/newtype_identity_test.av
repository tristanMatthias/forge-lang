// t-5qi0: newtype NOMINAL identity is a property of the TYPE, enforced
// identically in every position a value can land in.
//
// It was not. Enforcement was a property of the POSITION: the call-argument
// path tested `param_ty is .Newtype` inline (false for `Optional(Newtype)`, so
// every `T?` slot skipped the check), `check_one_field_ty` composed three
// LAYOUT checks and no identity check at all, and the let-binding path rolled
// its own third variant. Probed across 8 positions, 5 leaked — including
// struct fields in their REQUIRED form, which needed no optional wrapper to
// slip a bare `string` into a `RuleName` field.
//
// A newtype shares its underlying type's LAYOUT — that is the entire point of
// it being a compile-time distinction — so no layout gate can ever see a
// missing wrapper. `ptr_nominal_conflict` additionally exempts
// newtype-vs-its-own-underlying by design (t-axu9). Identity therefore needs
// its own predicate, and exactly one: `newtype_identity_conflict` in core.
// Every site above now routes through it.
//
// WHY THIS MATTERED: t-y2i7.3's `RuleName` pilot used `RuleName?` on the
// executor seams, went 1328/1328, and looked landed — while all 19 call sites
// still passed bare strings. A type-safety change that measured zero safety,
// made invisible by a green suite.
//
// The `null` specs are not padding. The first cut of the fix rejected `null`
// (it types as `void`), which would have made every optional newtype param
// unusable.

use @std.avrac.core.{avra_shell_exec, avra_selfhost_write_file, avra_getpid}

/// Compile a probe with the REAL bs2 and return its diagnostics.
fn onc_check(slug: string, body: string) -> string {
    let root = avra_shell_exec("pwd").trim()
    let path = "/tmp/avra_t5qi0_${slug}_${string(avra_getpid())}.av"
    let src = "type RuleName = string\n"
        + "type H = { a: RuleName, b: RuleName? }\n"
        + "fn takes_req(r: RuleName) -> string { r.raw() }\n"
        + "fn takes_opt(r: RuleName?) -> string { \"ok\" }\n"
        + "fn main() -> int {\n    ${body}\n    0\n}\n"
    let _ = avra_selfhost_write_file(path, src)
    // Remove the probe before returning: 18 specs x one file each is 18 files
    // left in /tmp per run, and this repo already carries a reclaim mechanism
    // for exactly that litter (diagnose.sh --prune-tmp-scratch).
    let out = avra_shell_exec("cd '${root}' && ./build/bs2 check '${path}' 2>&1")
    let _ = avra_shell_exec("rm -f '${path}'")
    out
}

/// A bare underlying value in this slot must be REJECTED.
fn rejects(slug: string, body: string) -> bool {
    onc_check(slug, body).contains("error[F1000]")
}

/// A correctly wrapped (or absent) value in this slot must COMPILE.
fn accepts(slug: string, body: string) -> bool {
    !onc_check(slug, body).contains("error[")
}

spec "a bare value is rejected in EVERY newtype slot (t-5qi0)" {
    then "parameter, required" {
        rejects("p_req", "let _ = takes_req(\"BARE\")")
    }
    then "parameter, OPTIONAL — the slot that started this" {
        rejects("p_opt", "let _ = takes_opt(\"BARE\")")
    }
    then "let binding, required" {
        rejects("l_req", "let x: RuleName = \"BARE\"")
    }
    then "let binding, optional" {
        rejects("l_opt", "let x: RuleName? = \"BARE\"")
    }
    then "struct field, REQUIRED — leaked without needing an optional at all" {
        rejects("f_req", "let h = H { a: \"BARE\", b: null }")
    }
    then "struct field, optional" {
        rejects("f_opt", "let h = H { a: RuleName(\"w\"), b: \"BARE\" }")
    }
    then "list element" {
        rejects("l_elem", "let xs: List<RuleName> = [\"BARE\"]")
    }
    then "map value" {
        rejects("m_val", "let m: Map<string, RuleName> = {\"k\": \"BARE\"}")
    }
    then "the rejection names the OPTIONAL param type, not the stripped inner" {
        onc_check("p_opt_msg", "let _ = takes_opt(\"BARE\")").contains("expects `RuleName?`")
    }
}

spec "the wrapper, and null, still work in every slot (t-5qi0)" {
    then "a wrapped value satisfies a required parameter" {
        accepts("ok_p_req", "let _ = takes_req(RuleName(\"W\"))")
    }
    then "a wrapped value satisfies an optional parameter" {
        accepts("ok_p_opt", "let _ = takes_opt(RuleName(\"W\"))")
    }
    then "`null` satisfies an optional parameter — the optional must stay usable" {
        accepts("ok_p_null", "let _ = takes_opt(null)")
    }
    then "`null` satisfies an optional let binding" {
        accepts("ok_l_null", "let x: RuleName? = null")
    }
    then "a wrapped value satisfies both struct fields" {
        accepts("ok_f", "let h = H { a: RuleName(\"w\"), b: RuleName(\"x\") }")
    }
    then "a wrapped element satisfies a list" {
        accepts("ok_list", "let xs: List<RuleName> = [RuleName(\"w\")]")
    }
    then "a wrapped value satisfies a map" {
        accepts("ok_map", "let m: Map<string, RuleName> = {\"k\": RuleName(\"w\")}")
    }
    then "an ORDINARY string slot is untouched — the gate is newtype-scoped" {
        accepts("ok_plain", "let xs: List<string> = [\"plain\"]")
    }
    then "an empty collection literal is not a conflict" {
        accepts("ok_empty", "let xs: List<RuleName> = []")
    }
}
