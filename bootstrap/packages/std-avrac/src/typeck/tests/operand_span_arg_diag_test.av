// A wrong-typed OPERAND must be reported AT THE OPERAND's own source
// position, not at the head of the enclosing call/ctor/binary — the arena
// records a byte span per expression id (ps3t.3.9/3.10), so the checker
// repositions itself at each operand before gating it (tc_at_operand /
// tc_report_at_expr, 703y.1.15). Hash-consed leaves (bare literals/idents)
// deliberately carry no span — a shared leaf has no single source
// occurrence — so they fall back to the enclosing head's stamp instead of
// inheriting a sibling operand's position. `opspan_`-prefixed fixtures
// against cross-shard collisions.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

fn opspan_check_out(tag: string, source: string) -> string {
    let path = "/tmp/avra_operand_span_${tag}.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 check '${path}' 2>&1 || true")
}

spec "call-arg diagnostics point at the offending argument" {
    then "a composite arg on its own line carets that line, not the call head" {
        let out = opspan_check_out("composite",
            "fn want(s: string) { println(s) }\n" +
            "fn main() {\n" +
            "    want(\n" +
            "        1 + 2)\n" +
            "}\n")
        out.contains("F1000") && out.contains(":4:9")
    }
    then "the second of two args carets its own position, not the first's" {
        let out = opspan_check_out("second",
            "fn two(a: int, b: string) { println(b) }\n" +
            "fn main() {\n" +
            "    two(1 + 1,\n" +
            "        2 + 3)\n" +
            "}\n")
        out.contains("F1000") && out.contains(":4:9")
    }
    then "a span-less leaf arg falls back to the statement head, never a sibling" {
        let out = opspan_check_out("leaf",
            "fn want(s: string) { println(s) }\n" +
            "fn main() {\n" +
            "    want(\n" +
            "        123)\n" +
            "}\n")
        out.contains("F1000") && out.contains(":3:5")
    }
    then "a method-call arg carets its own position, not the receiver" {
        let out = opspan_check_out("method",
            "type Pt = { x: int }\n" +
            "impl Pt { fn shift(self, d: string) -> int { self.x } }\n" +
            "fn main() {\n" +
            "    let p = Pt { x: 1 }\n" +
            "    let _ = p.shift(\n" +
            "        1 + 2)\n" +
            "}\n")
        out.contains("F1000") && out.contains(":6:9")
    }
}

spec "enum-ctor payload diagnostics point at the offending payload" {
    then "a composite payload on its own line carets that line, not the ctor head" {
        let out = opspan_check_out("enumctor",
            "enum Holder { One(s: string) }\n" +
            "fn main() {\n" +
            "    let h = Holder.One(\n" +
            "        1 + 2)\n" +
            "    match h { .One(v) -> println(v) }\n" +
            "}\n")
        out.contains("F1000") && out.contains(":4:9")
    }
}

spec "binary gates blame the offending side" {
    then "optional arithmetic carets the optional operand, not the binary head" {
        let out = opspan_check_out("optarith",
            "fn f() -> int? { 5 }\n" +
            "fn main() {\n" +
            "    let x = 1 +\n" +
            "        f()\n" +
            "    println(string(x ?? 0))\n" +
            "}\n")
        out.contains("F") && out.contains(":4:9")
    }
    then "a span-less optional leaf keeps the binary's own stamp" {
        let out = opspan_check_out("optleaf",
            "fn main() {\n" +
            "    let a: int? = 5\n" +
            "    let x = 1 +\n" +
            "        a\n" +
            "    println(string(x ?? 0))\n" +
            "}\n")
        out.contains("F") && out.contains(":3:13")
    }
}
