// WHY: F9005 lint — the manual `mut i = 0; while i < xs.length { … }`
// index-loop antipattern should be a `for` loop. Opt-in via
// AVRA_LINT_LOOPS=1 so it never spams normal builds. Structural AST
// match (Mut("i",_,0) followed by While(i < coll.length)), not a
// string heuristic.

extern fn avra_shell_exec(cmd: string) -> string

spec "F9005: manual index-loop lint" {
    then "fires on `mut i = 0; while i < xs.length` when opted in" {
        let src = "fn s(xs: List<int>) -> int {\n  mut t = 0\n  mut i = 0\n  while i < xs.length { t = t + xs[i]\n    i = i + 1 }\n  t\n}\nfn main() -> int { s([1,2,3]) }\n"
        avra_shell_exec("printf '%s' '${src}' > /tmp/avra_f9005_fixture.av")
        let out = avra_shell_exec("AVRA_LINT_LOOPS=1 ./build/bs2 check /tmp/avra_f9005_fixture.av 2>&1 || true")
        out.contains("F9005") && out.contains("xs")
    }

    then "is silent by default (opt-in only)" {
        let out = avra_shell_exec("./build/bs2 check /tmp/avra_f9005_fixture.av 2>&1 || true")
        !out.contains("F9005")
    }

    then "does not fire on an idiomatic for-in loop" {
        let src = "fn s(xs: List<int>) -> int {\n  mut t = 0\n  for x in xs { t = t + x }\n  t\n}\nfn main() -> int { s([1,2,3]) }\n"
        avra_shell_exec("printf '%s' '${src}' > /tmp/avra_f9005_clean.av")
        let out = avra_shell_exec("AVRA_LINT_LOOPS=1 ./build/bs2 check /tmp/avra_f9005_clean.av 2>&1 || true")
        !out.contains("F9005")
    }
}
