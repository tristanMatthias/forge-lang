// Diagnostic-detail polish: the three return / body / binding type-
// mismatch messages used `vtype_display` (concise form) which prints
// compound types as their kind name — `(tuple)`, `List`, `fn`. For a
// user staring at "returns `(tuple)`, but return produces `(tuple)`"
// the diagnostic is useless — both sides print identically when they
// differ structurally. Swap to `vtype_render_full` so tuples render
// their element types, lists their element type, fns their signature.
//
// Why this test observes the change: feed a fixture that mismatches
// a (int, string) declared return against a returned (string, int).
// Pre-fix the rendered error has `(tuple)` twice and tells the user
// nothing. Post-fix the message identifies which side has which
// element types — `(int, string)` vs `(string, int)`.

use @std.avrac.test_runner.{write_fixture}
use @std.avrac.core.{avra_shell_exec}

spec "typeck diagnostics use vtype_render_full for type-mismatch messages" {
    then "tuple return mismatch shows element types, not bare `(tuple)`" {
        let fixture = "/tmp/avra_render_full_diag_test.av"
        write_fixture(fixture,
            "fn returns_pair() -> (int, string) {\n" +
            "    if true { return (\"a\", 5) }\n" +
            "    (0, \"b\")\n" +
            "}\n" +
            "\n" +
            "fn main() -> int { 0 }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        // Pre-fix message contained `(tuple)` for both sides.
        // Post-fix should show the actual element types.
        out.contains("(int, string)") && out.contains("(string, int)")
            && !out.contains("returns `(tuple)`, but return produces `(tuple)`")
    }
    // t-meba: a fn type with an UNSPECIFIED return (explicit `fn()`,
    // no `-> R`) is FnTyped([], Unknown). vtype_render_full rendered
    // its Unknown ret as EMPTY, so the F1000 message read
    // "returns `fn() -> `" — a trailing space that looks like a
    // truncated compiler bug. The FnTyped arm now renders an unknown
    // ret as `<unknown>` (matching vtype_display/vtype_render_decl),
    // while the top-level `.Unknown -> ""` (the mangling form) is
    // untouched — diff-test stays byte-identical.
    then "an unspecified fn return renders `<unknown>`, not a truncated `fn() -> `" {
        let fixture = "/tmp/avra_render_full_fnret_test.av"
        write_fixture(fixture,
            "fn make(p: string) -> fn() {\n" +
            "    (name: string) -> { p + name }\n" +
            "}\n" +
            "fn main() { let _ = make(\"x\") }\n")
        let out = avra_shell_exec("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ./build/bs2 check '${fixture}' 2>&1 || true")
        // Post-fix: the declared side is visible. Pre-fix it was the
        // trailing-space `fn() -> ` immediately before the comma.
        out.contains("fn() -> <unknown>")
            && !out.contains("returns `fn() -> `,")
    }
}
