// WHY: §6 layout-totality caller-side gates (ps3t.4.9). Reading a value from a
// function that omits `-> Type` yields a `.Void`, and using that value in a
// layout-demanding position used to reach the codegen boundary as an F9999
// "internal compiler error" ICE. Two consumers are gated here (the destructure
// consumer, `let (…) = init`, landed separately in #802):
//   * field access `v.x` on a `.Void` receiver → clean F1000 at the access
//     (was codegen "field access on non-struct value").
//   * index `v[i]` on a `.Void` receiver → clean F1206 at the index
//     (was codegen "indexing on non-string/list value").
// `.Unknown` receivers are deliberately NOT gated (an Unknown signals an
// upstream under-determination — an undefined callee / failed mono — whose own
// diagnostic must not be masked).

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture}

fn fivg_out(source: string) -> string {
    let path = "/tmp/avra_fivg.av"
    write_fixture(path, source)
    avra_shell_exec("./build/bs2 compile '${path}' 2>&1 && echo __AVRA_COMPILE_OK__ || true")
}

spec "field access / index on a Void value is a clean error, not an F9999 ICE (ps3t.4.9)" {
    then "field access on a void-fn result is F1000 (not F9999)" {
        let out = fivg_out("type P = { x: int }
fn g() { P { x: 1 } }
fn main() { let v = g()  let z = v.x }")
        out.contains("F1000") && !out.contains("F9999")
    }
    then "indexing a void-fn result is F1206 (not F9999)" {
        let out = fivg_out("fn g() { [1, 2, 3] }
fn main() { let v = g()  let z = v[0] }")
        out.contains("F1206") && !out.contains("F9999")
    }
    then "a method call on a void-fn result is F1000 (not F9999) — impl method" {
        let out = fivg_out("type P = { x: int }
impl P { fn foo(self) -> int { self.x } }
fn g() { }
fn main() { let v = g()  let z = v.foo() }")
        out.contains("F1000") && !out.contains("F9999")
    }
    then "a method call on a void-fn result is F1000 (not F9999) — no impl" {
        let out = fivg_out("fn g() { }
fn main() { let v = g()  let z = v.bar() }")
        out.contains("F1000") && !out.contains("F9999")
    }
    then "a tuple-index `.0` on a void-fn result is F1000 (not F9999) — ps3t.4.9 acceptance repro" {
        // The ticket's exact repro: an unannotated tuple-returning fn is `.Void`
        // (the tail is discarded), so `t.0` on it used to hit the codegen
        // \"tuple index on non-tuple value\" F9999 ICE. Now a clean F1000.
        let out = fivg_out("fn g() { (1, 2) }
fn main() { let t = g()  let z = t.0 }")
        out.contains("F1000") && !out.contains("F9999")
    }
}

spec "the field / index void gates do not over-fire" {
    then "a struct field access compiles" {
        let out = fivg_out("type P = { x: int }
fn main() { let p = P { x: 5 }  let z = p.x }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a `.length` field on a list compiles" {
        let out = fivg_out("fn main() { let xs = [1, 2, 3]  let n = xs.length }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "indexing a real list compiles" {
        let out = fivg_out("fn main() { let xs = [1, 2, 3]  let z = xs[0] }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "indexing a string compiles" {
        let out = fivg_out("fn main() { let s = \"hi\"  let z = s[0] }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a tuple-index `.0` on a real tuple compiles" {
        let out = fivg_out("fn g() -> (int, int) { (1, 2) }
fn main() { let t = g()  let z = t.0 }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "field access on an annotated struct-returning fn compiles" {
        let out = fivg_out("type P = { x: int }
fn g() -> P { P { x: 1 } }
fn main() { let v = g()  let z = v.x }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "field access on a diverging-branch block value compiles (§799 typeck: v is the surviving arm, not Void)" {
        // `let v = { if c { return } else { \"x\" } }` — the then arm diverges, so
        // `v` is the else arm's String, not `.Void`. Without the check_block_stmts
        // tail-`if` typing, typeck typed `v` as Void and this `.length` false-fired
        // the field gate. Guards the typeck/codegen consistency.
        let out = fivg_out("fn f(c: bool) -> int {
  let v = { if c { return -1 } else { \"hidden\" } }
  v.length
}
fn main() { }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a flow-narrowed then-arm keeps its narrowed type through a block-tail-if" {
        // `let v = { if x != null { x } else { 0 } }` — inside the then arm `x`
        // narrows `int?` → `int`, so `v: int` and `v + 1` is valid. The value-type
        // computation must apply the same per-branch narrowing as the if-EXPR
        // checker; without it `v` was mis-typed `int?` and this over-fired F1205.
        let out = fivg_out("fn f(x: int?) -> int {
  let v = { if x != null { x } else { 0 } }
  let w = v + 1
  w
}
fn main() { }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a block-tail-if value form matches the if-expr form (else-narrowed)" {
        // Symmetric else-narrowed variant: `if x == null { 0 } else { x }`.
        let out = fivg_out("fn f(x: int?) -> int {
  let v = { if x == null { 0 } else { x } }
  let w = v + 1
  w
}
fn main() { }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a bare `else if` survivor arm is typed (not collapsed to Void)" {
        // then arm diverges; the value comes from the `else if` chain (String).
        // `tc_branch_value` must recurse into the nested `.If` (mirroring codegen)
        // — otherwise `v` typed `.Void` and `.length` false-fired the field gate.
        // The block-wrapped `else { if … }` form already worked; this brings the
        // bare `else if` form to parity.
        let out = fivg_out("fn f(a: bool, b: bool) -> int {
  let v = { if a { return -1 } else if b { \"x\" } else { \"y\" } }
  v.length
}
fn main() { }")
        out.contains("__AVRA_COMPILE_OK__")
    }
    then "a documented (`///`) tail expression keeps its value (annotated-tail unwrap)" {
        // The block tail is `Stmt.Annotated(Expr(\"abc\"))`. typeck's tail match AND
        // codegen's `emit_stmt_as_value` must unwrap it, else `v` types/emits as the
        // block default (`Void`/`i64 0`) and `.length` false-fires the field gate.
        let out = fivg_out("fn f() -> int {
  let v = {
    /// pick
    \"abc\"
  }
  v.length
}
fn main() { }")
        out.contains("__AVRA_COMPILE_OK__")
    }
}
