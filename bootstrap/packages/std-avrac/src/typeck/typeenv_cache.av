// WHY (F2 / forge-crafting-intepreters-uzs9.5.2): cache the typechecked @std
// type-environment across shards instead of re-deriving it every process.
//
// The problem: ~110 test-shard processes each import @std; each re-runs the
// collect/typeck phase over the identical @std stub decls to populate its type
// registries (fns/structs/enums/…) — measured ~1s/shard, ~115s of pure
// redundant work on a cold suite. The metadata fast-path (#877/#880) already
// killed the re-PARSE; this kills the re-TYPECK of that same @std env.
//
// The approach (what every mature compiler does — rustc .rmeta, OCaml .cmi,
// GHC .hi, Swift .swiftmodule): the ONE @std build serializes its typed
// interface; dependents LOAD it rather than re-typechecking the dependency.
// Avra's `meta.bin` already carries that typed interface (FnDeclEntry with a
// resolved `ret: ValueType`, TypeDeclEntry with fields/variants/inner_vt, …).
// So a shard can SEED its registries directly from the metadata it already
// loads, then run collect_decls only over its OWN code.
//
// Byte-identity strategy: seed by calling the SAME `*_reg_register` functions
// collect_decls uses (typeck/mod.av), fed from metadata entries instead of
// synthesized stub AST. Identical construction code ⇒ identical registries by
// construction — the strongest guarantee, verified end-to-end by the warm==cold
// differential oracle (a unit compiled seeded-from-cache must emit BYTE-IDENTICAL
// IR to one that recomputes the env). Gaps the metadata doesn't yet carry
// (newtype opaque/friends, trait/impl assoc types) are DRIVEN OUT by that oracle
// — each closed with a small meta.bin extension — never guessed.
//
// STATUS: increment 1 — reconstruction + oracle, gated OFF by default
// (AVRA_F2_TYPEENV_CACHE unset ⇒ this path is never taken ⇒ diff-test
// byte-identical). The flag flips ON only after the oracle is green.

use core.{avra_process_env_get}
use core.{content_id_for}

/// Is the F2 typeck-env cache enabled? OFF unless AVRA_F2_TYPEENV_CACHE is set
/// in the environment. While off, no shard ever seeds from metadata and the
/// compiler is byte-identical to pre-F2 — the widen-then-migrate safety valve.
export fn f2_typeenv_cache_enabled() -> bool {
    avra_process_env_get("AVRA_F2_TYPEENV_CACHE") != ""
}

/// The snapshot of the collect_decls-populated type registries — the @std
/// type-environment a shard re-derives every process. These are exactly the
/// tables collect_decls builds (typeck/mod.av): the `ord` data lists of each
/// registry (the `idx` accelerators are rebuilt on restore) plus the three
/// plain-list registries. NOT included: `type_reg` (populated by the RESOLVER,
/// not collect_decls, so it is reconstructed by the resolve pass that still
/// runs over the stubs) and the transient per-check `types` scope (starts
/// empty). Every field is plain data (strings, ValueType, the `*Meta` structs)
/// — no ptr/fn — so it round-trips.
export type SerTypeEnv = {
    fns: List<FnTypeMeta>,
    structs: List<StructTypeMeta>,
    shapes: List<string>,
    enums: List<EnumTypeMeta>,
    newtypes: List<NewtypeMeta>,
    union_aliases: List<UnionAliasMeta>,
    traits: List<TraitRegMeta>,
    trait_impls: List<TraitImplEntry>,
    assoc_type_defs: List<AssocTypeEntry>,
}

/// Capture the collect_decls-populated registries of `tc` (option (b): snapshot
/// the actual typeck output, which already carries the resolved forms + opaque
/// flags — no re-derivation from raw decls, which is where the subtle bugs
/// live). Reads the `ord` lists directly; the `idx` maps are derived and
/// rebuilt on restore.
export fn snapshot_typeenv(tc: TC) -> SerTypeEnv {
    SerTypeEnv {
        fns: tc.fns.ord,
        structs: tc.structs.ord,
        shapes: tc.shapes,
        enums: tc.enums.ord,
        newtypes: tc.newtypes.ord,
        union_aliases: tc.union_aliases.ord,
        traits: tc.traits.ord,
        trait_impls: tc.trait_impls,
        assoc_type_defs: tc.assoc_type_defs,
    }
}

// Rebuild each registry by REPLAYING the register function collect_decls uses,
// in the snapshot's insertion order — so the rebuilt registry (both `ord` and
// the `idx` accelerator) is identical to the original by construction.

fn restore_fn_reg(ms: List<FnTypeMeta>) -> FnTypeReg {
    mut r = fn_type_reg_new()
    for m in ms { r = fn_type_reg_register(r, m.name, m.tp, m.params, m.ret_ty, m.is_extern) }
    r
}
fn restore_struct_reg(ms: List<StructTypeMeta>) -> StructTypeReg {
    mut r = struct_type_reg_new()
    for m in ms { r = struct_type_reg_register(r, m.name, m.tp, m.fields) }
    r
}
fn restore_enum_reg(ms: List<EnumTypeMeta>) -> EnumTypeReg {
    mut r = enum_type_reg_new()
    for m in ms { r = enum_type_reg_register(r, m.name, m.tp, m.variants) }
    r
}
fn restore_newtype_reg(ms: List<NewtypeMeta>) -> NewtypeReg {
    mut r = newtype_reg_new()
    for m in ms { r = newtype_reg_register(r, m.name, m.inner_vt, m.opaque, m.friends) }
    r
}
fn restore_union_reg(ms: List<UnionAliasMeta>) -> UnionAliasReg {
    mut r = union_alias_reg_new()
    for m in ms { r = union_alias_reg_register(r, m.name, m.type_vt) }
    r
}
fn restore_trait_reg(ms: List<TraitRegMeta>) -> TraitRegistry {
    mut r = trait_registry_new()
    for m in ms { r = trait_registry_register(r, m.name, m.methods, m.assoc_types) }
    r
}

/// Restore a snapshot into `tc`, replacing the collect_decls registries with
/// the reconstructed ones. `type_reg`, `types` (scope) and all per-check state
/// are left as-is (the caller supplies a fresh/resolved TC). The result is
/// registry-identical to a TC that ran collect_decls over the same decls.
export fn restore_typeenv(tc: TC, ser: SerTypeEnv) -> TC {
    tc with {
        fns: restore_fn_reg(ser.fns),
        structs: restore_struct_reg(ser.structs),
        shapes: ser.shapes,
        enums: restore_enum_reg(ser.enums),
        newtypes: restore_newtype_reg(ser.newtypes),
        union_aliases: restore_union_reg(ser.union_aliases),
        traits: restore_trait_reg(ser.traits),
        trait_impls: ser.trait_impls,
        assoc_type_defs: ser.assoc_type_defs,
    }
}

// ─── Increment 2: the seeded collect + the warm==cold oracle ────────────────
//
// `typecheck_env` (typeck/mod.av) runs `collect_decls` over the WHOLE folded
// program — the @std stub decls AND the shard's own code. `collect_decls` is a
// pure left-fold (`mut cur = tc; for id: cur = register(cur, id)`) whose
// per-element step reads only the accumulator + the immutable AST arena /
// type_reg, so it is COMPOSITIONAL: collecting @std then own is registry-
// identical to collecting them together (a left-fold split at any point). The
// only non-fold step, `rewrite_fn_ret_tys`, runs once at the end over the
// merged fns and is idempotent on already-resolved signatures (an @std fn sig
// can't reference a shard-local type), so running it over the merged registry
// matches the cold path regardless of where collect was split.
//
// `typecheck_env_seeded` is the shard-side hook: instead of re-collecting the
// @std decls, it SEEDS the registries from a snapshot (produced once by the
// @std build) and collects only the shard's own ids on top. It is byte-
// identical to `typecheck_env(std ++ own)` by the argument above — the oracle
// (typeck/tests/typeenv_seeded_oracle_test.av) proves it empirically.

/// The shard-side entry: seed the collect_decls registries from `std_snapshot`
/// (the @std env, captured once) and run collect_decls only over `own_ids`.
/// Mirrors `typecheck_env` step-for-step — same tc_new / stamp / rewrite / lint
/// — but replaces the @std collect with a snapshot restore. Registry-identical
/// to `typecheck_env(std_ids ++ own_ids)`; the redundant @std collect is gone.
export fn typecheck_env_seeded(own_ids: List<StmtId>, std_snapshot: SerTypeEnv, type_reg: TypeRegistry, macro_origins: List<MacroFnOrigin>, store: NodeStore) -> TC {
    let tc0_pre = tc_new(type_reg, macro_origins, store)
    let stamped_ids = stamp_ids_stmt_ids(store, own_ids, type_reg)
    let tc0 = report_stamp_leaks(tc0_pre, stamped_ids, type_reg)
    let seeded = restore_typeenv(tc0, std_snapshot)
    let tc_first = collect_decls(seeded, own_ids)
    let collected = tc_first with { fns: rewrite_fn_ret_tys(tc_first, tc_first.fns) }
    lint_index_loops(collected, own_ids)
}

// ── structural registry equality (the oracle's assertion primitive) ──
// A full field-wise compare of two snapshots, with `vtype_eq` on every
// resolved ValueType leaf — a compositionality break would change a registry
// length or a resolved type, both of which this catches.

fn f2_strs_eq(a: List<string>, b: List<string>) -> bool {
    if a.length != b.length { return false }
    mut i = 0
    while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
    true
}
fn f2_tps_eq(a: List<TypeParamEntry>, b: List<TypeParamEntry>) -> bool {
    if a.length != b.length { return false }
    mut i = 0
    while i < a.length {
        if a[i].name != b[i].name || a[i].bounds != b[i].bounds { return false }
        i = i + 1
    }
    true
}
fn f2_params_eq(a: List<ParamEntry>, b: List<ParamEntry>) -> bool {
    if a.length != b.length { return false }
    mut i = 0
    while i < a.length {
        if a[i].name != b[i].name { return false }
        if !vtype_eq(a[i].vtype, b[i].vtype) { return false }
        i = i + 1
    }
    true
}
fn f2_fields_eq(a: List<FieldEntry>, b: List<FieldEntry>) -> bool {
    if a.length != b.length { return false }
    mut i = 0
    while i < a.length {
        if a[i].name != b[i].name { return false }
        if !vtype_eq(a[i].resolved, b[i].resolved) { return false }
        i = i + 1
    }
    true
}
fn f2_variants_eq(a: List<Variant>, b: List<Variant>) -> bool {
    if a.length != b.length { return false }
    mut i = 0
    while i < a.length {
        if a[i].name != b[i].name { return false }
        if !f2_fields_eq(a[i].fields, b[i].fields) { return false }
        i = i + 1
    }
    true
}

/// True iff two snapshots are registry-identical (all 9 registries, field-wise,
/// resolved types compared by `vtype_eq`). The warm==cold oracle's assertion.
export fn sertypeenv_eq(a: SerTypeEnv, b: SerTypeEnv) -> bool {
    // fns
    if a.fns.length != b.fns.length { return false }
    mut i = 0
    while i < a.fns.length {
        let x = a.fns[i]
        let y = b.fns[i]
        if x.name != y.name || x.is_extern != y.is_extern { return false }
        if !vtype_eq(x.ret_ty, y.ret_ty) { return false }
        if !f2_params_eq(x.params, y.params) { return false }
        if !f2_tps_eq(x.tp, y.tp) { return false }
        i = i + 1
    }
    // structs
    if a.structs.length != b.structs.length { return false }
    i = 0
    while i < a.structs.length {
        let x = a.structs[i]
        let y = b.structs[i]
        if x.name != y.name { return false }
        if !f2_tps_eq(x.tp, y.tp) { return false }
        if !f2_fields_eq(x.fields, y.fields) { return false }
        i = i + 1
    }
    // shapes
    if !f2_strs_eq(a.shapes, b.shapes) { return false }
    // enums
    if a.enums.length != b.enums.length { return false }
    i = 0
    while i < a.enums.length {
        let x = a.enums[i]
        let y = b.enums[i]
        if x.name != y.name { return false }
        if !f2_tps_eq(x.tp, y.tp) { return false }
        if !f2_variants_eq(x.variants, y.variants) { return false }
        i = i + 1
    }
    // newtypes
    if a.newtypes.length != b.newtypes.length { return false }
    i = 0
    while i < a.newtypes.length {
        let x = a.newtypes[i]
        let y = b.newtypes[i]
        if x.name != y.name || x.opaque != y.opaque { return false }
        if !vtype_eq(x.inner_vt, y.inner_vt) { return false }
        if !f2_strs_eq(x.friends, y.friends) { return false }
        i = i + 1
    }
    // union_aliases
    if a.union_aliases.length != b.union_aliases.length { return false }
    i = 0
    while i < a.union_aliases.length {
        if a.union_aliases[i].name != b.union_aliases[i].name { return false }
        if !vtype_eq(a.union_aliases[i].type_vt, b.union_aliases[i].type_vt) { return false }
        i = i + 1
    }
    // traits (name + method count + assoc types)
    if a.traits.length != b.traits.length { return false }
    i = 0
    while i < a.traits.length {
        let x = a.traits[i]
        let y = b.traits[i]
        if x.name != y.name { return false }
        if x.methods.length != y.methods.length { return false }
        if !f2_strs_eq(x.assoc_types, y.assoc_types) { return false }
        i = i + 1
    }
    // trait_impls
    if a.trait_impls.length != b.trait_impls.length { return false }
    i = 0
    while i < a.trait_impls.length {
        if a.trait_impls[i].trait_name != b.trait_impls[i].trait_name { return false }
        if a.trait_impls[i].type_name != b.trait_impls[i].type_name { return false }
        i = i + 1
    }
    // assoc_type_defs
    if a.assoc_type_defs.length != b.assoc_type_defs.length { return false }
    i = 0
    while i < a.assoc_type_defs.length {
        if a.assoc_type_defs[i].key != b.assoc_type_defs[i].key { return false }
        if !vtype_eq(a.assoc_type_defs[i].concrete_vt, b.assoc_type_defs[i].concrete_vt) { return false }
        i = i + 1
    }
    true
}

/// A parsed program partitioned at a boundary fn: `prefix` models the @std env
/// (the producer collects it), `suffix` (the marker fn onward) models the
/// shard's own code (the consumer seeds from prefix's snapshot + collects this).
export type SplitIds = { prefix: List<StmtId>, suffix: List<StmtId> }

/// Split `ids` at the first top-level fn named `marker`: that fn and everything
/// after it is the `suffix`; everything before is the `prefix`. Robust to
/// pipeline-injected stmts (intrinsics) — both the cold and seeded paths
/// partition the SAME `ids`, so an injected decl lands identically on one side.
export fn f2_split_at_marker(store: NodeStore, ids: List<StmtId>, marker: string) -> SplitIds {
    mut prefix: List<StmtId> = []
    mut suffix: List<StmtId> = []
    mut hit = false
    for id in ids {
        if !hit {
            match stmt_unwrap(store, store.stmts.get(id)) {
                .Function(name, _, _, _, _) -> { if name == marker { hit = true } }
                _ -> {}
            }
        }
        if hit { suffix.push(id) } else { prefix.push(id) }
    }
    SplitIds { prefix, suffix }
}

/// Folded top-level stmts partitioned into imported PACKAGE modules (the
/// reusable env F2 seeds from a snapshot) vs the shard's OWN code (collected
/// fresh). `std_ids` are the `@<scope>` package outers; `own_ids` is everything
/// else, in original order.
export type StdOwnSplit = { std_ids: List<StmtId>, own_ids: List<StmtId> }

/// Partition folded top-level `ids` at the package boundary: a top-level
/// `Stmt.Module` whose name starts with `@` is an imported package outer
/// (the resolver wraps every `use @scope.pkg` as a TOP-LEVEL
/// `Stmt.Module("@<scope>", [inner])` — features/modules/resolver.av:1099; the
/// bare-named per-package submodules live INSIDE that outer, never at the top
/// level, so this `@`-prefix test — the same `is_package_use` predicate — is
/// exact). Everything else (own fns/types, and pipeline-injected intrinsics) is
/// own code. The @std env a shard re-collects every process is exactly the
/// `std_ids` here; F2 seeds those from a snapshot and collects only `own_ids`.
export fn f2_partition_std_own(store: NodeStore, ids: List<StmtId>) -> StdOwnSplit {
    mut std_ids: List<StmtId> = []
    mut own_ids: List<StmtId> = []
    for id in ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Module(name, _) -> {
                if name.length > 0 && name[0] == "@" { std_ids.push(id) }
                else { own_ids.push(id) }
            }
            _ -> own_ids.push(id)
        }
    }
    StdOwnSplit { std_ids, own_ids }
}

/// F2: a cheap fingerprint of the @std IMPORT SET — the set of "@scope.pkg"
/// package paths present in `std_ids` (the outer `@scope` module wrapping each
/// imported package's inner module). This is the sidecar key DISCRIMINATOR: the
/// snapshot is the @std env collected from THESE packages, so it is reusable
/// ONLY by a shard importing the SAME package set (metadata stubs are
/// whole-package — resolver.av:1073 "the stubs already enumerate every submodule
/// that contributed" — and the universe fp fixes their CONTENT, so same package
/// set ⇒ identical collected @std env). Without this the sidecar was keyed on the
/// universe fp ALONE, so a snapshot from a shard importing FEWER @std packages
/// was wrongly reused by one importing MORE — the seeded env then lacked e.g.
/// `@std::process::Marshal` (an F1000 the warm==cold sweep oracle caught). Walks
/// only the two-level module NAMES (scope outer → package inner), never decl
/// bodies, so it stays O(packages), not O(@std size) — the collect it avoids.
///
/// Order-dependent by construction (the paths join in std_ids appearance order):
/// a shard with the same package set in a different order MISSES and recomputes —
/// correctness-safe (never a wrong HIT), and the common case (a consistent test
/// framework import order) still shares.
export fn f2_std_import_fingerprint(store: NodeStore, std_ids: List<StmtId>) -> string {
    mut paths: List<string> = []
    for id in std_ids {
        match stmt_unwrap(store, store.stmts.get(id)) {
            .Module(scope, body) -> {
                for c in body {
                    match stmt_unwrap(store, store.stmts.get(c)) {
                        .Module(inner, _) -> { paths.push("${scope}.${inner}") }
                        _ -> {}
                    }
                }
            }
            _ -> {}
        }
    }
    string(content_id_for(paths.join("|")))
}
