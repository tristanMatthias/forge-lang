// `avra docs` — project documentation rendered from the @std/lsp
// SymbolGraph.
//
// History: this file used to carry a private `DocSym` shape adapted
// from the original line-based regex extractor. Ticket
// forge-crafting-intepreters-ovm8.1 collapsed that — the renderer now
// reads @std/lsp's portable `Sym` records directly, so symbol shape
// stays consistent across the docs CLI, future LSP server, and any
// other consumer.
//
// Pipeline:
//   parse each .av in PWD → indexer.extract_from_ast → SymList
//   renderers below filter / format / paginate that list
//
// Renderer surface (kept compatible with the prior CLI flags):
//   show_overview        avra docs                (no args)
//   show_symbol          avra docs <name>
//   show_short           avra docs --short <name>
//   show_symbols         avra docs --symbols
//   show_search          avra docs --search <q>
//   show_llm             avra docs --llm
//   validate_docs        avra docs --validate

use core.runtime.{avra_selfhost_read_file, avra_shell_exec, avra_selfhost_levenshtein}
use parse.{parse_program_source}
use indexer.{extract_from_ast_at, extract_calls_from_ast_at}
use @std.lsp.{Sym, SymList, SymKind, CallEdge, CallList}
use render.{bold, dim, cyan, green, yellow, red,
            pad_right, truncate_str, rule, first_line, icase_eq, pct}
use pathutil.{relativise}

// ── Project walk ─────────────────────────────────────────────────────

// Both pieces of the project corpus the renderers need: the symbol
// graph (for documentation queries) and the call edges (for
// `--callers` reverse-lookup). Walking once means we don't pay for
// double parsing when callers are requested.
export type DocsCorpus = {
    syms: SymList,
    calls: CallList
}

export fn extract_project_corpus(dir: string) -> DocsCorpus {
    let cmd = "find ${dir} -name '*.av' -type f -not -path '*/build/*' -not -path '*/.beads/*' -not -path '*/seed/*' 2>/dev/null | sort"
    let files_text = avra_shell_exec(cmd)
    if files_text == "" {
        return DocsCorpus { syms: SymList.End, calls: CallList.End }
    }

    mut syms = SymList.End
    mut calls = CallList.End
    for path in files_text.split("\n") {
        if path == "" { continue }
        let content = avra_selfhost_read_file(path)
        if content == "" { continue }
        let parsed = parse_program_source(content)
        if parsed.had_error || parsed.stmts == null {
            // Tooling shouldn't fail on a syntactically broken
            // source file; the compiler's primary error path will
            // surface the parse error in its own time.
            continue
        }
        let rel = relativise(path, dir)
        let file_syms = extract_from_ast_at(parsed.stmts!, rel)
        let file_calls = extract_calls_from_ast_at(parsed.stmts!, rel)
        syms = sym_list_append(file_syms, syms)
        calls = call_list_append(file_calls, calls)
    }
    DocsCorpus { syms, calls }
}

// Backwards-compat wrapper for callers that only want the SymList
// half.
export fn extract_project_docs_ast(dir: string) -> SymList {
    extract_project_corpus(dir).syms
}

fn call_list_append(a: CallList, b: CallList) -> CallList {
    match a {
        .End -> b
        .Node(item, next) -> CallList.Node(item, call_list_append(next, b))
    }
}

fn sym_list_append(a: SymList, b: SymList) -> SymList {
    match a {
        .End -> b
        .Node(item, next) -> SymList.Node(item, sym_list_append(next, b))
    }
}

// ── Kind classification ─────────────────────────────────────────────
//
// Renderers group symbols into four buckets matching the prior CLI
// output: Functions / Types / Enums / Constants. The prior code used
// a `kind: int` discriminant; we now derive the bucket from SymKind.
// A 0-bucket means "skip in the renderer" (Trait / Impl / ErrorCode /
// Keyword / Module — surfaced by future flags).

fn bucket_of(s: Sym) -> int {
    match s.kind {
        .Fn(_, _) -> 1
        .Type(_) -> 2
        .Enum(_) -> 3
        .Const(_) -> 4
        .Mut(_) -> 4
        .Let(_) -> 4
        _ -> 0
    }
}

fn is_fn(s: Sym) -> bool { bucket_of(s) == 1 }
fn is_type(s: Sym) -> bool { bucket_of(s) == 2 }
fn is_enum(s: Sym) -> bool { bucket_of(s) == 3 }
fn is_var(s: Sym) -> bool { bucket_of(s) == 4 }
fn is_renderable(s: Sym) -> bool { bucket_of(s) != 0 }
fn has_doc(s: Sym) -> bool { s.doc != "" }

// ── List traversal ──────────────────────────────────────────────────

fn count_syms(list: SymList, pred: fn(Sym) -> bool) -> int {
    mut cur = list
    mut n = 0
    while true {
        match cur {
            .End -> return n
            .Node(item, next) -> {
                if pred(item) { n = n + 1 }
                cur = next
            }
        }
    }
    n
}

fn count_total(list: SymList) -> int {
    count_syms(list, is_renderable)
}

fn count_documented(list: SymList) -> int {
    count_syms(list, (item: Sym) -> is_renderable(item) && has_doc(item))
}

fn count_documented_in(list: SymList, want_bucket: int) -> int {
    count_syms(list, (item: Sym) -> bucket_of(item) == want_bucket && has_doc(item))
}

fn count_in_bucket(list: SymList, want_bucket: int) -> int {
    count_syms(list, (item: Sym) -> bucket_of(item) == want_bucket)
}

// ── Rendering ────────────────────────────────────────────────────────

// Header for the summary view: signature for fns, "type Name" for
// types, "name { variants }" for enums, "kind name: type" for vars.
fn summary_head(s: Sym) -> string {
    match s.kind {
        .Fn(sig, _) -> sig
        .Type(_) -> s.name
        .Enum(csv) -> {
            if csv == "" {
                s.name
            } else {
                let vs = "{ ${csv} }"
                "${s.name}  ${dim(vs)}"
            }
        }
        .Const(ty) -> var_signature("const", s.name, ty)
        .Mut(ty) -> var_signature("mut", s.name, ty)
        .Let(ty) -> var_signature("let", s.name, ty)
        _ -> s.name
    }
}

// "type Foo" / "enum Bar" / fn signature — used by --symbols and the
// detail view.
fn declaration_line(s: Sym) -> string {
    match s.kind {
        .Fn(sig, _) -> sig
        .Type(_) -> "type ${s.name}"
        .Enum(_) -> "enum ${s.name}"
        .Const(ty) -> var_signature("const", s.name, ty)
        .Mut(ty) -> var_signature("mut", s.name, ty)
        .Let(ty) -> var_signature("let", s.name, ty)
        _ -> s.name
    }
}

fn var_signature(kind_str: string, name: string, ty: string) -> string {
    if ty == "" || ty == "<unknown>" {
        "${kind_str} ${name}"
    } else {
        "${kind_str} ${name}: ${ty}"
    }
}

fn export_tag(s: Sym) -> string {
    if s.exported { dim(" [export]") } else { "" }
}

fn print_summary_row(s: Sym) {
    let head = summary_head(s)
    let preview = first_line(s.doc)
    if preview == "" {
        println("    ${head}${export_tag(s)}")
    } else {
        let head_padded = pad_right(head, 44)
        println("    ${head_padded} ${dim(truncate_str(preview, 30))}${export_tag(s)}")
    }
}

fn print_summary_kind(list: SymList, want_bucket: int) {
    mut cur = list
    while true {
        match cur {
            .End -> {
                return
            }
            .Node(item, next) -> {
                if bucket_of(item) == want_bucket {
                    print_summary_row(item)
                }
                cur = next
            }
        }
    }
}

// ── Overview (`avra docs`) ──────────────────────────────────────────

export fn show_overview(docs: SymList) {
    println("")
    println("  ${bold("avra docs")} ${dim("—")} Project Documentation")
    println("  ${dim(rule(37))}")

    if count_total(docs) == 0 {
        println("")
        println("  ${dim("!")} No Avra source files found in the current directory.")
        println("  Add ${cyan("///")} doc comments to your functions and types.")
        println("")
        return
    }

    let n_fns = count_in_bucket(docs, 1)
    let n_types = count_in_bucket(docs, 2)
    let n_enums = count_in_bucket(docs, 3)
    let n_vars = count_in_bucket(docs, 4)

    if n_fns > 0 {
        println("")
        println("  ${bold("Functions")} (${string(n_fns)})")
        println("")
        print_summary_kind(docs, 1)
    }
    if n_types > 0 {
        println("")
        println("  ${bold("Types")} (${string(n_types)})")
        println("")
        print_summary_kind(docs, 2)
    }
    if n_enums > 0 {
        println("")
        println("  ${bold("Enums")} (${string(n_enums)})")
        println("")
        print_summary_kind(docs, 3)
    }
    if n_vars > 0 {
        println("")
        println("  ${bold("Constants")} (${string(n_vars)})")
        println("")
        print_summary_kind(docs, 4)
    }

    let total = count_total(docs)
    let documented = count_documented(docs)
    println("")
    if documented < total {
        println("  ${yellow("Coverage:")} ${string(documented)}/${string(total)} symbols documented")
    } else {
        println("  ${bold("Coverage:")} ${string(documented)}/${string(total)} symbols documented")
    }
    println("")
    println("  Detail: ${cyan("avra docs <name>")}")
    println("")
}

// ── --symbols (flat reference with locations) ───────────────────────

export fn show_symbols(docs: SymList) {
    println("")
    println("  ${bold("Symbol Reference")}")
    println("  ${dim(rule(16))}")
    println("")

    if count_in_bucket(docs, 1) > 0 {
        println("  ${bold("Functions")}")
        print_with_loc_kind(docs, 1)
        println("")
    }
    if count_in_bucket(docs, 2) > 0 {
        println("  ${bold("Types")}")
        print_with_loc_kind(docs, 2)
        println("")
    }
    if count_in_bucket(docs, 3) > 0 {
        println("  ${bold("Enums")}")
        print_with_loc_kind(docs, 3)
        println("")
    }
    if count_in_bucket(docs, 4) > 0 {
        println("  ${bold("Constants")}")
        print_with_loc_kind(docs, 4)
        println("")
    }

    if count_total(docs) == 0 {
        println("    ${dim("(no symbols found)")}")
        println("")
    }
}

fn print_with_loc_kind(list: SymList, want_bucket: int) {
    mut cur = list
    while true {
        match cur {
            .End -> {
                return
            }
            .Node(item, next) -> {
                if bucket_of(item) == want_bucket {
                    let head = declaration_line(item)
                    let loc = "${item.file}:${string(item.span.start.line)}"
                    println("    ${pad_right(head, 44)} ${dim(loc)}")
                }
                cur = next
            }
        }
    }
}

// ── Symbol detail (`avra docs <name>`) ──────────────────────────────

// ── Callers (`--callers`) ───────────────────────────────────────────
//
// Given a target symbol name, walk the CallList for edges whose
// callee matches and render their call sites. Same shape as the
// LSP `avra/callers` request — see protocol_test.av for the
// equivalent end-to-end test.

export fn show_callers(query: string, corpus: DocsCorpus) -> bool {
    let target = sym_by_name(corpus.syms, query)
    if target == null { return false }

    let edges = call_edges_to(corpus.calls, query)
    println("")
    println("  ${bold(declaration_line(target!))}")
    println("  ${dim("Used by:")}")

    if call_list_len(edges) == 0 {
        println("    ${dim("(no callers in project)")}")
        println("")
        return true
    }

    print_call_edges(edges)
    println("    ${dim("(${string(call_list_len(edges))} callers)")}")
    println("")
    true
}

fn sym_by_name(list: SymList, name: string) -> Sym? {
    let want = name.to_lower()
    mut cur = list
    while true {
        match cur {
            .End -> {
                return null
            }
            .Node(item, next) -> {
                if is_renderable(item) && item.name.to_lower() == want {
                    return item
                }
                cur = next
            }
        }
    }
    null
}

fn call_edges_to(calls: CallList, target: string) -> CallList {
    mut acc = CallList.End
    mut cur = calls
    while true {
        match cur {
            .End -> {
                return acc
            }
            .Node(edge, next) -> {
                if edge.callee == target {
                    acc = CallList.Node(edge, acc)
                }
                cur = next
            }
        }
    }
    CallList.End
}

fn call_list_len(list: CallList) -> int {
    mut n = 0
    mut cur = list
    while true {
        match cur {
            .End -> {
                return n
            }
            .Node(_, next) -> {
                n = n + 1
                cur = next
            }
        }
    }
    n
}

fn print_call_edges(edges: CallList) {
    mut cur = edges
    while true {
        match cur {
            .End -> {
                return
            }
            .Node(edge, next) -> {
                let loc = "${edge.file}:${string(edge.line)}"
                println("    ${pad_right(edge.caller, 36)} ${dim(loc)}")
                cur = next
            }
        }
    }
}

// ── Hierarchical addressing (`avra docs core::ast::Expr`) ──────────
//
// Locally-mirrored qualified-path helpers — duplicated from
// @std/lsp.qualified_* because function imports across @std packages
// hit the resolver dedupe bug. Once that fix lands these can collapse
// to re-imports.

fn qualified_last_separator(q: string) -> int {
    mut i = q.length - 2
    while i >= 0 {
        if q.substring(i, i + 2) == "::" {
            return i
        }
        i = i - 1
    }
    -1
}

fn qualified_leaf(q: string) -> string {
    let last = qualified_last_separator(q)
    if last < 0 { return q }
    q.substring(last + 2, q.length)
}

fn qualified_breadcrumbs(q: string) -> string {
    if q == "" { return "" }
    mut acc = ""
    mut start = 0
    mut i = 0
    while i + 1 < q.length {
        if q.substring(i, i + 2) == "::" {
            let seg = q.substring(start, i)
            acc = if acc == "" { seg } else { "${acc} ▸ ${seg}" }
            start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    let last = q.substring(start, q.length)
    if acc == "" { last } else { "${acc} ▸ ${last}" }
}

// Look up a sym by either bare name OR qualified path. When the
// query contains `::`, fall back to suffix matching so partial paths
// still resolve (`ast::Expr` finds `core::ast::Expr`).
fn sym_by_path(list: SymList, path: string) -> Sym? {
    if !path.contains("::") {
        return sym_by_name(list, path)
    }
    // Exact qualified match first.
    mut cur = list
    while true {
        match cur {
            .End -> {
                break
            }
            .Node(item, next) -> {
                if is_renderable(item) && item.qualified == path {
                    return item
                }
                cur = next
            }
        }
    }
    // Suffix match: `ast::Expr` matches `core::ast::Expr`.
    let suffix = "::${path}"
    mut cur2 = list
    while true {
        match cur2 {
            .End -> {
                return null
            }
            .Node(item, next) -> {
                if is_renderable(item) && item.qualified.ends_with(suffix) {
                    return item
                }
                cur2 = next
            }
        }
    }
    null
}

// Print every direct child of a module path. Direct = one level
// deeper, not transitive. Returns false when no descendants exist
// at any depth — distinguishes "real but childless prefix" from
// "no such prefix anywhere".
export fn show_module(prefix: string, docs: SymList) -> bool {
    let direct = direct_children(docs, prefix)
    if sym_count(direct) == 0 && !has_any_descendant(docs, prefix) {
        return false
    }

    let header = if prefix == "" {
        "${bold("avra docs")} ${dim("—")} project root"
    } else {
        "${bold(qualified_breadcrumbs(prefix))}"
    }
    println("")
    println("  ${header}")
    println("  ${dim(rule(prefix.length + 8))}")
    println("")

    print_module_children(direct, docs)
    println("")
    true
}

fn has_any_descendant(list: SymList, prefix: string) -> bool {
    let pfx_dot = "${prefix}::"
    mut cur = list
    while true {
        match cur {
            .End -> {
                return false
            }
            .Node(item, next) -> {
                if item.qualified.starts_with(pfx_dot) { return true }
                cur = next
            }
        }
    }
    false
}

fn direct_children(list: SymList, prefix: string) -> SymList {
    let pfx_dot = "${prefix}::"
    let pfx_depth = if prefix == "" { -1 } else { count_path_seps(prefix) }
    sym_list_filter_local(list,
        (item: Sym) -> is_direct_child_of(item, prefix, pfx_dot, pfx_depth))
}

fn is_direct_child_of(item: Sym, prefix: string, pfx_dot: string, pfx_depth: int) -> bool {
    let q = item.qualified
    if prefix == "" {
        !q.contains("::")
    } else {
        q.starts_with(pfx_dot) && count_path_seps(q) == pfx_depth + 1
    }
}

fn count_path_seps(q: string) -> int {
    mut depth = 0
    mut i = 0
    while i + 1 < q.length {
        if q.substring(i, i + 2) == "::" {
            depth = depth + 1
            i = i + 2
        } else {
            i = i + 1
        }
    }
    depth
}

fn sym_count(list: SymList) -> int {
    count_syms(list, (_: Sym) -> true)
}

fn sym_list_filter_local(list: SymList, pred: fn(Sym) -> bool) -> SymList {
    mut acc = SymList.End
    mut cur = list
    while true {
        match cur {
            .End -> {
                return reverse_sym_list_local(acc)
            }
            .Node(item, next) -> {
                if pred(item) {
                    acc = SymList.Node(item, acc)
                }
                cur = next
            }
        }
    }
    SymList.End
}

fn reverse_sym_list_local(list: SymList) -> SymList {
    mut acc = SymList.End
    mut cur = list
    while true {
        match cur {
            .End -> {
                return acc
            }
            .Node(item, next) -> {
                acc = SymList.Node(item, acc)
                cur = next
            }
        }
    }
    SymList.End
}

fn print_module_children(direct: SymList, all: SymList) {
    mut cur = direct
    while true {
        match cur {
            .End -> {
                return
            }
            .Node(item, next) -> {
                let leaf = qualified_leaf(item.qualified)
                let kid_count = sym_count(direct_children(all, item.qualified))
                let count_str = if kid_count > 0 { dim(" (${string(kid_count)})") } else { "" }
                let preview = first_line(item.doc)
                if preview == "" {
                    println("    ${leaf}${count_str}")
                } else {
                    println("    ${pad_right(leaf, 36)}${count_str} ${dim(truncate_str(preview, 40))}")
                }
                cur = next
            }
        }
    }
}

// "Did you mean?" — best-scoring sym name above threshold, or "" if
// no candidate is plausibly close. Threshold matches @std/lsp's
// did_you_mean default: silence beats a misleading suggestion.
export fn suggest_similar(query: string, docs: SymList) -> string {
    mut best_score = 199
    mut best_name = ""
    mut cur = docs
    while true {
        match cur {
            .End -> {
                return best_name
            }
            .Node(item, next) -> {
                if is_renderable(item) {
                    let s = fuzzy_score(query, item.name)
                    if s > best_score {
                        best_score = s
                        best_name = item.name
                    }
                }
                cur = next
            }
        }
    }
    best_name
}

export fn show_symbol(query: string, docs: SymList) -> bool {
    let direct = sym_by_path(docs, query)
    if direct != null {
        show_one(direct!)
        return true
    }
    // Fallback: case-insensitive bare-name match.
    mut cur = docs
    while true {
        match cur {
            .End -> return false
            .Node(item, next) -> {
                if is_renderable(item) && icase_eq(item.name, query) {
                    show_one(item)
                    return true
                }
                cur = next
            }
        }
    }
    false
}

fn show_one(s: Sym) {
    let header = declaration_line(s)
    let rule_len = if header.length > 20 { header.length } else { 20 }

    println("")
    if s.qualified != s.name {
        println("  ${dim(qualified_breadcrumbs(s.qualified))}")
    }
    println("  ${bold(header)}")
    println("  ${dim(rule(rule_len))}")

    if s.doc != "" {
        let doc = parse_doc(s.doc)
        render_doc_block(doc)
    }

    print_variant_block(s)

    println("")
    println("  ${dim("Defined in")} ${s.file}:${string(s.span.start.line)}")
    if s.exported {
        println("  ${dim("Exported")}")
    }
    println("")
}

fn print_variant_block(s: Sym) {
    match s.kind {
        .Enum(csv) -> {
            if csv != "" {
                println("")
                println("  ${bold("Variants")}")
                for v in csv.split(",") {
                    println("    ${v.trim()}")
                }
            }
        }
        _ -> {}
    }
}

// ── Short one-liner (`--short`) ─────────────────────────────────────

export fn show_short(query: string, docs: SymList) -> bool {
    let s = sym_by_path(docs, query)
    if s != null {
        let line = first_line(s!.doc)
        let desc = if line == "" { "(undocumented)" } else { line }
        println("  ${s!.name}: ${desc}")
        return true
    }
    mut cur = docs
    while true {
        match cur {
            .End -> return false
            .Node(item, next) -> {
                if is_renderable(item) && icase_eq(item.name, query) {
                    let line = first_line(item.doc)
                    let desc = if line == "" { "(undocumented)" } else { line }
                    println("  ${item.name}: ${desc}")
                    return true
                }
                cur = next
            }
        }
    }
    false
}

// ── Search (`--search`) ─────────────────────────────────────────────
//
// Composed scoring tiers (highest first), mirrored from @std/lsp's
// fuzzy_score so `--search` gets typo-tolerant + subsequence matching:
//
//   1000  exact         800  case-insensitive exact
//    600  prefix         400  subsequence ("iu" matches "init_user")
//    300  substring      200  Levenshtein ≤ 2
//      0  no match
//
// The doc body is checked too — at half the score of a name match —
// so `avra docs --search auth` still surfaces a fn whose name doesn't
// contain "auth" but whose doc does.
//
// Duplicates @std/lsp's fuzzy_score body verbatim because the
// bootstrap module resolver dedupes function imports: a second
// `use @std.lsp.{fuzzy_score}` from this file would silently lose the
// binding (TYPE imports cross fine, FN imports don't, see ovm8.1
// commit comment in 4df15e0e). Once the resolver bug is fixed, this
// can become a one-line re-import.

fn score_match(name: string, doc: string, q: string) -> int {
    let s = fuzzy_score(q, name)
    if s > 0 { return s }
    // Doc-body fallback: any contains-match in the doc body counts as
    // a tier-100 hit so `--search` still surfaces undeclared-named
    // matches when the user remembers a description not a symbol.
    if doc.to_lower().contains(q.to_lower()) { return 100 }
    0
}

fn fuzzy_score(query: string, candidate: string) -> int {
    if query == candidate { return 1000 }
    let ql = query.to_lower()
    let cl = candidate.to_lower()
    if ql == cl { return 800 }
    if cl.starts_with(ql) {
        let len_diff = candidate.length - query.length
        let pen = if len_diff > 0 { len_diff } else { 0 - len_diff }
        return 600 - pen
    }
    if is_subsequence(ql, cl) {
        let pen = candidate.length - query.length
        return 400 - if pen > 0 { pen } else { 0 - pen }
    }
    if cl.contains(ql) {
        let pos_pen = cl.index_of(ql)
        return 300 - pos_pen
    }
    let dist = avra_selfhost_levenshtein(ql, cl, ql.length, cl.length)
    if dist <= 2 { return 200 - dist * 50 }
    0
}

fn is_subsequence(needle: string, haystack: string) -> bool {
    if needle.length == 0 { return true }
    mut ni = 0
    mut hi = 0
    while hi < haystack.length {
        if needle.substring(ni, ni + 1) == haystack.substring(hi, hi + 1) {
            ni = ni + 1
            if ni == needle.length { return true }
        }
        hi = hi + 1
    }
    false
}

export fn show_search(query: string, docs: SymList) {
    if count_total(docs) == 0 {
        println("")
        println("  No results for \"${query}\".")
        println("  Try: ${cyan("avra docs")}")
        println("")
        return
    }

    let n_fns = count_search_in_bucket(docs, query, 1)
    let n_types = count_search_in_bucket(docs, query, 2)
    let n_enums = count_search_in_bucket(docs, query, 3)
    let n_vars = count_search_in_bucket(docs, query, 4)
    let total_hits = n_fns + n_types + n_enums + n_vars

    if total_hits == 0 {
        println("")
        println("  No results for \"${query}\".")
        println("  Try: ${cyan("avra docs")}")
        println("")
        return
    }

    println("")
    println("  Search results for \"${query}\"")
    println("  ${dim(rule(20 + query.length))}")
    println("")

    if n_fns > 0 {
        println("  ${bold("Functions")}")
        print_search_kind(docs, query, 1)
        println("")
    }
    if n_types > 0 {
        println("  ${bold("Types")}")
        print_search_kind(docs, query, 2)
        println("")
    }
    if n_enums > 0 {
        println("  ${bold("Enums")}")
        print_search_kind(docs, query, 3)
        println("")
    }
    if n_vars > 0 {
        println("  ${bold("Constants")}")
        print_search_kind(docs, query, 4)
        println("")
    }

    println("  ${dim("Hint: avra docs <name> for full docs")}")
    println("")
}

fn count_search_in_bucket(list: SymList, q: string, want_bucket: int) -> int {
    count_syms(list, (item: Sym) ->
        bucket_of(item) == want_bucket && score_match(item.name, item.doc, q) > 0)
}

fn print_search_kind(list: SymList, q: string, want_bucket: int) {
    mut cur = list
    while true {
        match cur {
            .End -> {
                return
            }
            .Node(item, next) -> {
                if bucket_of(item) == want_bucket && score_match(item.name, item.doc, q) > 0 {
                    let desc = truncate_str(first_line(item.doc), 50)
                    println("    ${pad_right(item.name, 24)} ${dim(desc)}")
                }
                cur = next
            }
        }
    }
}

// ── LLM-friendly dump (`--llm`) ─────────────────────────────────────

export fn show_llm(docs: SymList) {
    println("# Project Documentation (LLM-friendly)")
    println("")

    if count_in_bucket(docs, 1) > 0 {
        println("## Functions")
        print_llm_kind(docs, 1)
        println("")
    }
    if count_in_bucket(docs, 2) > 0 {
        println("## Types")
        print_llm_kind(docs, 2)
        println("")
    }
    if count_in_bucket(docs, 3) > 0 {
        println("## Enums")
        print_llm_kind(docs, 3)
        println("")
    }
    if count_in_bucket(docs, 4) > 0 {
        println("## Constants")
        print_llm_kind(docs, 4)
        println("")
    }
}

fn print_llm_kind(list: SymList, want_bucket: int) {
    mut cur = list
    while true {
        match cur {
            .End -> {
                return
            }
            .Node(item, next) -> {
                if bucket_of(item) == want_bucket {
                    let head = llm_head(item)
                    let exp = if item.exported { " [export]" } else { "" }
                    println("${head}${exp}")
                    if item.doc != "" {
                        println("# ${first_line(item.doc)}")
                    }
                }
                cur = next
            }
        }
    }
}

fn llm_head(s: Sym) -> string {
    match s.kind {
        .Fn(sig, _) -> sig
        .Type(_) -> "type ${s.name}"
        .Enum(csv) -> {
            if csv == "" {
                "enum ${s.name}"
            } else {
                "enum ${s.name} { ${csv} }"
            }
        }
        .Const(ty) -> var_signature("const", s.name, ty)
        .Mut(ty) -> var_signature("mut", s.name, ty)
        .Let(ty) -> var_signature("let", s.name, ty)
        _ -> s.name
    }
}

// ── Validation (`--validate`) ───────────────────────────────────────

export fn validate_docs(dir: string) {
    let docs = extract_project_docs_ast(dir)
    let total = count_total(docs)
    let documented = count_documented(docs)

    println("")
    println("  ${bold("Project Documentation Coverage")}")
    println("  ${dim(rule(30))}")
    println("")
    println("  Symbols found: ${string(total)}")

    print_validation_kind(docs, 1, "Functions")
    print_validation_kind(docs, 2, "Types")
    print_validation_kind(docs, 3, "Enums")
    print_validation_kind(docs, 4, "Constants")

    let undocumented = total - documented
    let coverage = if total == 0 { 100 } else { pct(documented, total) }

    println("")
    println("  ${bold("Summary")}")
    println("    ${pad_right("Documented:", 16)} ${string(documented)}/${string(total)} symbols (${string(coverage)}%)")
    if undocumented > 0 {
        println("    ${pad_right("Undocumented:", 16)} ${string(undocumented)} symbols")
    }
    println("")
}

fn print_validation_kind(list: SymList, want_bucket: int, label: string) {
    let total = count_in_bucket(list, want_bucket)
    if total == 0 { return }
    let doc_n = count_documented_in(list, want_bucket)
    let coverage = pct(doc_n, total)

    println("")
    println("  ${bold(label)}: ${string(total)} total")
    println("    ${green("✓")} documented: ${string(doc_n)} (${string(coverage)}%)")

    let undoc_n = total - doc_n
    if undoc_n > 0 {
        let names = collect_undocumented_names(list, want_bucket)
        println("    ${red("✗")} undocumented: ${names}")
    }
}

fn collect_undocumented_names(list: SymList, want_bucket: int) -> string {
    mut cur = list
    mut acc = ""
    while true {
        match cur {
            .End -> return acc
            .Node(item, next) -> {
                if bucket_of(item) == want_bucket && !has_doc(item) {
                    acc = if acc == "" { item.name } else { acc + ", " + item.name }
                }
                cur = next
            }
        }
    }
    acc
}

// ── DocBlock parser ─────────────────────────────────────────────────
//
// Parse a /// body into structured sections so renderers can show
// summaries, params, returns, examples, and metadata distinctly. Free-
// form prose still works — anything not recognised as a directive
// rolls into the summary or `body` overflow.
//
// Supported directives (one per line):
//   @param NAME DESC    parameter description
//   @returns DESC       return-value description
//   @see PATH           cross-reference (resolved by x35m.4)
//   @since VERSION
//   @deprecated REASON
//   @example LANG       inline single-line example fence (rare)
//
// Plus fenced examples:
//   ```avra
//   ... body ...
//   ```
//
// First non-blank, non-directive paragraph becomes the summary. The
// rest accumulates as the body for renderers that want the whole tail.

export type DocBlock = {
    summary: string,
    body: string,
    params: List<string>,
    returns: string,
    examples: List<string>,
    see: List<string>,
    since: string,
    deprecated: string
}

export fn empty_doc_block() -> DocBlock {
    DocBlock {
        summary: "",
        body: "",
        params: [],
        returns: "",
        examples: [],
        see: [],
        since: "",
        deprecated: ""
    }
}

export fn parse_doc(text: string) -> DocBlock {
    if text == "" { return empty_doc_block() }
    mut block = empty_doc_block()
    mut summary_done = false
    mut summary_buf = ""
    mut body_buf = ""
    mut in_fence = false
    mut fence_buf = ""
    let lines = text.split("\n")
    mut i = 0
    while i < lines.length {
        let raw = lines[i]
        i = i + 1
        let line = raw.trim()

        // Fenced code block: ```avra ... ```
        if line.starts_with("```") {
            if in_fence {
                in_fence = false
                block.examples.push(fence_buf)
                fence_buf = ""
            } else {
                in_fence = true
                fence_buf = ""
                summary_done = true
            }
            continue
        }
        if in_fence {
            fence_buf = if fence_buf == "" { raw } else { fence_buf + "\n" + raw }
            continue
        }

        // Directives.
        if line.starts_with("@param ") {
            block.params.push(line.substring(7, line.length).trim())
            summary_done = true
            continue
        }
        if line.starts_with("@returns ") {
            block.returns = line.substring(9, line.length).trim()
            summary_done = true
            continue
        }
        if line.starts_with("@return ") {
            block.returns = line.substring(8, line.length).trim()
            summary_done = true
            continue
        }
        if line.starts_with("@see ") {
            block.see.push(line.substring(5, line.length).trim())
            summary_done = true
            continue
        }
        if line.starts_with("@since ") {
            block.since = line.substring(7, line.length).trim()
            summary_done = true
            continue
        }
        if line.starts_with("@deprecated ") {
            block.deprecated = line.substring(12, line.length).trim()
            summary_done = true
            continue
        }
        if line == "@deprecated" {
            block.deprecated = "(deprecated)"
            summary_done = true
            continue
        }

        // Plain prose. Empty line ends the summary section.
        if line == "" {
            if summary_buf != "" { summary_done = true }
            if summary_done {
                body_buf = if body_buf == "" { "" } else { body_buf + "\n" }
            }
            continue
        }
        if summary_done {
            body_buf = if body_buf == "" { line } else { body_buf + "\n" + line }
        } else {
            summary_buf = if summary_buf == "" { line } else { summary_buf + " " + line }
        }
    }
    block.summary = summary_buf
    block.body = body_buf
    block
}

fn render_doc_block(block: DocBlock) {
    if block.summary != "" {
        println("")
        println("  ${block.summary}")
    }
    if block.body != "" {
        println("")
        for line in block.body.split("\n") {
            println("  ${line}")
        }
    }
    if block.params.length > 0 {
        println("")
        println("  ${bold("Parameters")}")
        mut i = 0
        while i < block.params.length {
            println("    ${block.params[i]}")
            i = i + 1
        }
    }
    if block.returns != "" {
        println("")
        println("  ${bold("Returns")}")
        println("    ${block.returns}")
    }
    if block.examples.length > 0 {
        println("")
        println("  ${bold("Examples")}")
        mut i = 0
        while i < block.examples.length {
            for line in block.examples[i].split("\n") {
                println("    ${line}")
            }
            i = i + 1
        }
    }
    if block.see.length > 0 {
        println("")
        println("  ${bold("See also")}")
        mut i = 0
        while i < block.see.length {
            println("    ${cyan(block.see[i])}")
            i = i + 1
        }
    }
    if block.since != "" {
        println("")
        println("  ${dim("since ${block.since}")}")
    }
    if block.deprecated != "" {
        println("")
        println("  ${red("⚠ deprecated:")} ${block.deprecated}")
    }
}
