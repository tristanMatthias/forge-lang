trait ExTdPrintable {
    fn display(self) -> string
}

/// Test fixture: minimal struct used by the trait-decl example
/// to verify a concrete `impl ExTdPrintable for ExTdDog`.
///
/// @field name — the dog's name; returned verbatim by `display`.
type ExTdDog = { name: string }

impl ExTdPrintable for ExTdDog {
    fn display(self) -> string {
        self.name
    }
}

/// Test fixture: a second `ExTdPrintable` implementer with a
/// different `display` body — verifies trait dispatch picks the
/// right concrete implementation.
///
/// @field name — the cat's name; wrapped in "meow from ..."
type ExTdCat = { name: string }

impl ExTdPrintable for ExTdCat {
    fn display(self) -> string {
        "meow from ${self.name}"
    }
}

spec "trait decl example" {
    then "Dog displays its name" {
        let d = ExTdDog { name: "Rex" }
        d.display() == "Rex"
    }
    then "Cat overrides display formatting" {
        let c = ExTdCat { name: "Whiskers" }
        c.display() == "meow from Whiskers"
    }
}
