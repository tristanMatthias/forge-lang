// OR patterns in match: `pat or pat -> body`

// Enum OR patterns — multiple variants share one arm
enum Direction { North, South, East, West }

fn is_horizontal(d: Direction) -> bool {
    match d {
        .East or .West -> true
        _              -> false
    }
}

println(string(is_horizontal(Direction.East)))
println(string(is_horizontal(Direction.West)))
println(string(is_horizontal(Direction.North)))

// Three-way OR
fn describe_dir(d: Direction) -> string {
    match d {
        .North or .South or .East -> "not west"
        .West                     -> "west"
    }
}

println(describe_dir(Direction.North))
println(describe_dir(Direction.South))
println(describe_dir(Direction.East))
println(describe_dir(Direction.West))

// Integer literal OR patterns
fn parity(n: int) -> string {
    match n {
        0 or 2 or 4 or 6 or 8 -> "even single digit"
        1 or 3 or 5 or 7 or 9 -> "odd single digit"
        _                      -> "multi-digit or negative"
    }
}

println(parity(0))
println(parity(3))
println(parity(7))
println(parity(42))

// String literal OR patterns
fn is_vowel_word(s: string) -> bool {
    match s {
        "a" or "e" or "i" or "o" or "u" -> true
        _                                -> false
    }
}

println(string(is_vowel_word("a")))
println(string(is_vowel_word("e")))
println(string(is_vowel_word("b")))

// OR pattern with guard
fn describe_small(n: int) -> string {
    match n {
        1 or 2 if n > 0 -> "small positive"
        _               -> "other"
    }
}

println(describe_small(1))
println(describe_small(2))
println(describe_small(5))
