spec "method chaining" {
    then "substring result" {
        let s = "hello world"
        let sub = s.substring(0, 5)
        sub == "hello"
    }
    then "substring length" {
        let s = "hello world"
        let sub = s.substring(0, 5)
        sub.length == 5
    }
    then "chained substring length" {
        let len = "abcdef".substring(1, 4).length
        len == 3
    }
}
