/// Test fixture: classic three-way classification using an
/// `if`/`else if`/`else` chain — verifies the basic
/// `if`-statement code path end to end.
fn ex_is_classify(n: int) -> string {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else {
        "positive"
    }
}

spec "if stmt example" {
    then "negative branch" {
        ex_is_classify(0 - 1) == "negative"
    }
    then "zero branch" {
        ex_is_classify(0) == "zero"
    }
    then "positive branch" {
        ex_is_classify(1) == "positive"
    }
}
