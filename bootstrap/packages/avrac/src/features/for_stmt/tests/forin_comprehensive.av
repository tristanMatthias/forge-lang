// Comprehensive for-in tests

// Basic iteration
let words = ["hello", "world", "avra"]
for w in words {
    println(w)
}

// Accumulation
let scores = [10, 20, 30, 40, 50]
mut total = 0
for s in scores {
    total = total + s
}
total |> string |> println

// Nested for-in
let rows = [[1, 2], [3, 4], [5, 6]]
mut flat_sum = 0
for row in rows {
    for val in row {
        flat_sum = flat_sum + val
    }
}
flat_sum |> string |> println

// For-in with break
mut found = -1
for x in [10, 20, 30, 40] {
    if x == 30 {
        found = x
        break
    }
}
found |> string |> println

// For-in with continue
mut odd_sum = 0
for n in [1, 2, 3, 4, 5, 6, 7] {
    if n % 2 == 0 { continue }
    odd_sum = odd_sum + n
}
odd_sum |> string |> println

// For-in over empty list
mut count = 0
for x in [] {
    count = count + 1
}
count |> string |> println

// For-in + lambda combo
let nums = [1, 2, 3, 4, 5]
let doubled = nums.map((x) -> x * 2)
for d in doubled {
    d |> string |> println
}
