// Canonical example of `enum` declarations and constructors.

enum Option {
    Some(value: int)
    None
}

fn unwrap_or(opt: Option, default: int) -> int {
    match opt {
        .Some(v) -> v
        .None -> default
    }
}

fn main() {
    let a = Option.Some(42)
    let b = Option.None
    println(string(unwrap_or(a, 0)))
    println(string(unwrap_or(b, -1)))
}
