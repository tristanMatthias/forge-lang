enum IntList {
    Nil,
    Cons(head: int, tail: IntList),
}

fn list_sum(list: IntList) -> int {
    match list {
        .Nil -> 0
        .Cons(head, tail) -> head + list_sum(tail)
    }
}

fn list_length(list: IntList) -> int {
    match list {
        .Nil -> 0
        .Cons(_, tail) -> 1 + list_length(tail)
    }
}

spec "recursive enum" {
    then "sum of linked list" {
        let list = IntList.Cons(1, IntList.Cons(2, IntList.Cons(3, IntList.Cons(4, IntList.Nil))))
        list_sum(list) == 10
    }
    then "length of linked list" {
        let list = IntList.Cons(1, IntList.Cons(2, IntList.Cons(3, IntList.Cons(4, IntList.Nil))))
        list_length(list) == 4
    }
}
