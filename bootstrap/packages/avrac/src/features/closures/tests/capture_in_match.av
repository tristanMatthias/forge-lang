// Test: captured variables inside match arms, if-else branches,
// enum constructors, and other expressions inside closures.
/// expect: 30
/// expect: 99
/// expect: hello world

enum Box { Val(n: int), Empty }

// Capture inside match arm body
fn test_match_capture() -> int {
    let factor = 3
    let f = (b: Box) -> match b {
        .Val(n) -> n * factor
        .Empty -> 0
    }
    f(Box.Val(10))
}

// Capture inside if-else branches
fn test_if_else_capture() -> int {
    let default_val = 99
    let f = (x: int) -> {
        if x > 0 { x } else { default_val }
    }
    f(-1)
}

// Capture inside enum constructor args
fn test_enum_ctor_capture() -> string {
    let suffix = " world"
    let f = (s: string) -> s + suffix
    f("hello")
}

fn main() {
    println(string(test_match_capture()))
    println(string(test_if_else_capture()))
    println(test_enum_ctor_capture())
}
