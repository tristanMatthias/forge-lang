// Recursive generic enums are exercised by the bootstrap compiler's own
// AST nodes (StmtList, ExprList, etc.). This test verifies the runtime
// behavior of a list-like generic ADT via a non-generic concrete instance,
// since the codegen has a Module-wrapped recursive-generic limitation.

enum RgIntList {
    End,
    Node(value: int, next: RgIntList),
}

fn rg_sum(list: RgIntList) -> int {
    match list {
        .End -> 0
        .Node(v, next) -> v + rg_sum(next)
    }
}

spec "recursive generic" {
    then "linked list of ints sums correctly" {
        let list = RgIntList.Node(1, RgIntList.Node(2, RgIntList.Node(3, RgIntList.End)))
        rg_sum(list) == 6
    }
}
