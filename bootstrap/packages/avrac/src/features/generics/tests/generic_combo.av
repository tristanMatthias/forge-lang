// Test: aggressive generics combinations — chained generics, generic enum
// returned from generic fn, match on generic result, closures + generics.
/// expect: ok: 42
/// expect: err: bad
/// expect: 3
/// expect: mapped: [2, 4, 6]

// Generic Result for error handling
enum Result<T, E> { Ok(value: T), Err(error: E) }

// Generic function returning generic enum
fn safe_div(a: int, b: int) -> Result {
    if b == 0 { return Result.Err("bad") }
    Result.Ok(a / b)
}

// Generic identity chained through another generic
fn wrap<T>(x: T) -> T { x }
fn double_wrap<T>(x: T) -> T { wrap(x) }

// Generic higher-order function
fn transform<T>(x: T, f: fn(T) -> T) -> T { f(x) }

// Non-generic function using generic enum
fn show_result(r: Result) {
    match r {
        .Ok(v) -> println("ok: ${string(v)}")
        .Err(e) -> println("err: ${e}")
    }
}

fn main() {
    // Generic fn returning generic enum + match
    show_result(safe_div(84, 2))
    show_result(safe_div(1, 0))

    // Chained generics
    println(string(double_wrap(3)))

    // Generic with closure
    let doubled = transform(21, (y) -> y * 2)
    println("doubled: ${string(doubled)}")
}
