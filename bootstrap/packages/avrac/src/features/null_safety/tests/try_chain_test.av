fn nstc_step1(x: int) -> int? {
    if x > 0 { return x * 2 }
    null
}

fn nstc_step2(x: int) -> int? {
    if x < 100 { return x + 1 }
    null
}

fn nstc_pipeline(x: int) -> int? {
    let a = nstc_step1(x)?
    let b = nstc_step2(a)?
    b
}

spec "try chain" {
    then "both steps succeed" {
        let r = nstc_pipeline(5)
        r ?? -1 == 11
    }
    then "first step fails" {
        let r = nstc_pipeline(0)
        r ?? -1 == -1
    }
    then "second step fails" {
        let r = nstc_pipeline(60)
        r ?? -1 == -1
    }
}
