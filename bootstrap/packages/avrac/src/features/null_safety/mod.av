mod codegen
mod typeck
use codegen.types.{err_emit}
use core.registry.{feature_new, Feature}
use resolve.{resolve_expr, enter_resolve_scope, exit_resolve_scope, declare_name, define_name}
use features.null_safety.codegen.{emit_null_coalesce, emit_optional_chain, emit_try, emit_catch}
use features.null_safety.typeck.{check_catch, check_null_coalesce, check_try}
use features.struct_decl.typeck.{check_field_access}
use typeck.{check_expr, tc_er}

export fn null_coalesce_feature() -> Feature {
    feature_new("null_coalesce") with {
        expr_tag: Expr.NullCoalesce(Expr.Null, Expr.Null),
        emit_expr: null_coalesce_emit_expr,
        resolve_expr: null_coalesce_resolve_expr,
        check_expr: check_null_coalesce,
    }
}

export fn optional_chain_feature() -> Feature {
    feature_new("optional_chain") with {
        expr_tag: Expr.OptionalChain(Expr.Null, ""),
        emit_expr: optional_chain_emit_expr,
        resolve_expr: optional_chain_resolve_expr,
        check_expr: optional_chain_check_expr,
    }
}

export fn try_feature() -> Feature {
    feature_new("try") with {
        expr_tag: Expr.Try(Expr.Null),
        emit_expr: try_emit_expr,
        resolve_expr: try_resolve_expr,
        check_expr: (tc: TC, expr: Expr) -> check_try(tc, expr),
    }
}

export fn catch_feature() -> Feature {
    feature_new("catch") with {
        expr_tag: Expr.Catch(Expr.Null, "", Expr.Null, 0, 0),
        emit_expr: catch_emit_expr,
        resolve_expr: catch_resolve_expr,
        check_expr: check_catch,
    }
}

fn null_coalesce_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .NullCoalesce(left, right) -> {
            let after_left = resolve_expr(r, left)
            resolve_expr(after_left, right)
        }
        _ -> r
    }
}

fn optional_chain_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .OptionalChain(obj, _) -> resolve_expr(r, obj)
        _ -> r
    }
}

fn optional_chain_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .OptionalChain(obj, field) -> check_field_access(tc, obj, field)
        _ -> tc_er(tc, .Unknown)
    }
}

fn try_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .Try(inner) -> resolve_expr(r, inner)
        _ -> r
    }
}

fn catch_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .Catch(inner, binding, body, _, _) -> {
            let ri = resolve_expr(r, inner)
            let scoped = if binding.length > 0 {
                let entered = enter_resolve_scope(ri)
                define_name(declare_name(entered, binding), binding)
            } else { ri }
            let rb = resolve_expr(scoped, body)
            if binding.length > 0 { exit_resolve_scope(rb) } else { rb }
        }
        _ -> r
    }
}

fn catch_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Catch(inner, binding, body, _, _) -> emit_catch(ctx, env, inner, binding, body)
        _ -> err_emit("expected Catch")
    }
}

fn null_coalesce_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .NullCoalesce(left, right) -> emit_null_coalesce(ctx, env, left, right)
        _ -> err_emit("expected NullCoalesce")
    }
}

fn optional_chain_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .OptionalChain(obj, field) -> emit_optional_chain(ctx, env, obj, field)
        _ -> err_emit("expected OptionalChain")
    }
}

fn try_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Try(inner) -> emit_try(ctx, env, inner)
        _ -> err_emit("expected Try")
    }
}
