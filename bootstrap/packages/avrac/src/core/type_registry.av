// WHY: Central type identity system — ONE place to register, ONE place to look up.
// Every type gets a unique integer TypeId. All registries use O(1) intmap lookups.
// String names are kept only for diagnostics and LLVM type name generation.

use core.ast.{FieldList, VariantList, ValueType, TypeList}
use core.registry.{avra_intmap_new, avra_intmap_set, avra_intmap_get, avra_intmap_has, avra_map_new_cstr, avra_map_set_cstr, avra_map_get_cstr, avra_map_has_cstr}
use core.runtime.{avra_intmap_inc, avra_intmap_get_as_string}

// ── TypeKind ──

export enum TypeKind {
    StructKind,
    EnumKind,
    TraitKind,
    NewtypeKind,
    UnionAliasKind,
    ShapeKind,
}

// ── TypeInfo ──
// All information about a registered type, keyed by TypeId.

export type TypeInfo = {
    id: int,
    name: string,
    kind: TypeKind,
    fields: FieldList,
    variants: VariantList,
    inner_vt: ValueType,
}

// ── TypeRegistry ──
// The single source of truth for type identity.

export type TypeRegistry = {
    info_map: ptr,      // intmap: id → TypeInfo ptr (key 0 = next_id counter)
    name_to_id: ptr,    // map_cstr: qualified_name → id
    id_to_name: ptr,    // intmap: id → name (string ptr as int)
}


export fn type_registry_new() -> TypeRegistry {
    let m = avra_intmap_new()
    avra_intmap_set(m, 0, 1)
    TypeRegistry {
        info_map: m,
        name_to_id: avra_map_new_cstr(),
        id_to_name: avra_intmap_new(),
    }
}

// Register a new type. Returns the assigned TypeId.
export fn type_registry_register(reg: TypeRegistry, name: string, kind: TypeKind, fields: FieldList, variants: VariantList, inner_vt: ValueType) -> int {
    // If already registered, return existing id
    if avra_map_has_cstr(reg.name_to_id, name) == 1 {
        return avra_map_get_cstr(reg.name_to_id, name)
    }
    // Atomically get and increment the next_id counter at key 0
    let id = avra_intmap_inc(reg.info_map, 0)
    let info = TypeInfo {
        id,
        name,
        kind,
        fields,
        variants,
        inner_vt,
    }
    avra_intmap_set(reg.info_map, id, info)
    avra_map_set_cstr(reg.name_to_id, name, id)
    avra_intmap_set(reg.id_to_name, id, name)
    // Also register short name (last segment after ::) for codegen lookups
    if name.contains("::") {
        let parts = name.split("::")
        let short = parts[parts.length - 1]
        if avra_map_has_cstr(reg.name_to_id, short) == 0 {
            avra_map_set_cstr(reg.name_to_id, short, id)
        }
    }
    id
}

// Look up type info by id. Returns the raw intmap value (TypeInfo pointer as int).
// Returns 0 if not found. Callers cast to TypeInfo.
export fn type_registry_lookup_raw(reg: TypeRegistry, id: int) -> int {
    if id == 0 { return 0 }
    if avra_intmap_has(reg.info_map, id) == 0 { return 0 }
    avra_intmap_get(reg.info_map, id)
}

// Look up a type id by name. Returns 0 if not found.
export fn type_registry_id_for(reg: TypeRegistry, name: string) -> int {
    if avra_map_has_cstr(reg.name_to_id, name) == 0 { return 0 }
    avra_map_get_cstr(reg.name_to_id, name)
}

// Check if a type id is registered.
export fn type_registry_has(reg: TypeRegistry, id: int) -> bool {
    id > 0 && avra_intmap_has(reg.info_map, id) == 1
}


// Look up the canonical name for a TypeId. Returns "" if not found.
export fn type_registry_name_for(reg: TypeRegistry, id: int) -> string {
    if id == 0 { return "" }
    if avra_intmap_has(reg.id_to_name, id) == 0 { return "" }
    avra_intmap_get_as_string(reg.id_to_name, id)
}

// Check if a name is registered.
export fn type_registry_has_name(reg: TypeRegistry, name: string) -> bool {
    avra_map_has_cstr(reg.name_to_id, name) == 1
}

// ── Centralized name generation ──
// The ONLY functions that produce :: or __ in type/method names.
// If the naming convention ever changes, there's exactly one place to update.

// Module-qualified type name: "codegen::types::Ctx"
export fn type_qualified_name(module: string, name: string) -> string {
    if module == "" { name } else { "${module}::${name}" }
}

// Method mangling: "Point__distance"
export fn method_mangled_name(type_name: string, method: string) -> string {
    "${type_name}__${method}"
}

// Variant payload struct name: "Option__Some"
export fn variant_payload_name(enum_name: string, variant: string) -> string {
    "${enum_name}__${variant}"
}

// Join two name segments with __: "Result__int__string"
// Used by the monomorphizer for generic type mangling.
export fn mangle_join(a: string, b: string) -> string {
    "${a}__${b}"
}

// Extract the short name from a qualified name: "codegen::types::Ctx" → "Ctx"
export fn type_short_name(name: string) -> string {
    if !name.contains("::") { return name }
    let parts = name.split("::")
    parts[parts.length - 1]
}

// Check if a name is a method mangled name (contains __)
export fn is_mangled_method(name: string) -> bool {
    name.contains("__")
}

// Extract method name from mangled: "Type__method" → "method"
export fn method_from_mangled(name: string) -> string {
    let parts = name.split("__")
    if parts.length > 1 { parts[1] } else { name }
}

// Trait impl key: "Printable:Cat"
export fn trait_impl_name(trait_name: string, type_name: string) -> string {
    "${trait_name}:${type_name}"
}

// True when `name` refers to the Result enum, accepting any of:
//   "Result"                       — unqualified, non-monomorphized
//   "Result__int__string"          — unqualified, monomorphized
//   "<module>::Result"             — qualified, non-monomorphized
//   "<module>::Result__int__string" — qualified, monomorphized
// Used by `?` operator codegen and Try expression typecheck so that
// any Result-shaped enum (regardless of module wrap) is recognized.
//
// For user-defined Result-shaped enums (e.g. `enum MyResult { Ok(value: T), Err(error: E) }`),
// callers should use `is_result_shaped_enum` against the type registry.
export fn is_result_enum_name(name: string) -> bool {
    let short = type_short_name(name)
    short == "Result" || short.starts_with("Result__")
}

// Structural check: an enum is Result-shaped when it has exactly the variants
// `Ok(value)` and `Err(error)` (any payload types). This lets the `?` operator
// and errdefer routing accept user-defined Result-likes (MyResult, TrResult, etc.).
export fn is_result_shaped_enum(reg: TypeRegistry, enum_name: string) -> bool {
    if is_result_enum_name(enum_name) { return true }
    let id = type_registry_id_for(reg, enum_name)
    if id == 0 { return false }
    let raw = type_registry_lookup_raw(reg, id)
    if raw == 0 { return false }
    let info: TypeInfo = raw
    match info.kind { .EnumKind -> {}, _ -> { return false } }
    let ok = variant_list_has(info.variants, "Ok")
    let err = variant_list_has(info.variants, "Err")
    ok && err
}

fn variant_list_has(variants: VariantList, name: string) -> bool {
    match variants {
        .End -> false
        .Node(n, _, _) if n == name -> true
        .Node(_, _, next) -> variant_list_has(next, name)
    }
}
