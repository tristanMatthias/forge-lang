fn print_usage() {
    eprintln("forge-bootstrap v0.1.0")
    eprintln("Usage: bootstrapc <expr|program|eval|check|compile|run|fix|fmt|lsp|test|docs> <file.av>")
    eprintln("       bootstrapc compile --stop-after=<parse|resolve|names|check> [--json] <file.av>")
    eprintln("       bootstrapc fix <file.av>     Apply high-confidence auto-fixes")
    eprintln("       bootstrapc fmt <file.av>     Format a Avra source file")
    eprintln("       bootstrapc lsp               Start language server")
    eprintln("       bootstrapc test <file.av>    Run spec tests in a file")
    eprintln("       bootstrapc docs [name]       Project documentation from /// comments")
    eprintln("       bootstrapc docs --symbols    List every project symbol with location")
    eprintln("       bootstrapc docs --search Q   Search project docs by name or doc body")
    eprintln("       bootstrapc docs --validate   Report documentation coverage")
    eprintln("       bootstrapc docs --llm        Markdown-style dump for LLM context")
}

fn fail(message: string) {
    eprintln(message)
    exit(1)
}

// Module file resolution and name resolution live in features/modules/.

// ── Code formatter (ticket c5w) ──
// Avra syntax with consistent indentation.

fn fmt_indent(depth: int) -> string {
    mut result = ""
    for i in 0..depth {
        result = result + "    "
    }
    result
}

fn fmt_expr(se: Expr) -> string {
    match se {
        .Number(v) -> v
        .String(v) -> v
        .Bool(v) -> v
        .Null -> "null"
        .Ident(name) -> name
        .QualifiedIdent(path) -> path
        .Assign(name, value) -> "${name} = ${fmt_expr(value)}"
        .Grouping(inner) -> "(${fmt_expr(inner)})"
        .Unary(op, right) -> "${unop_str(op)}${fmt_expr(right)}"
        .Binary(left, op, right) -> "${fmt_expr(left)} ${binop_str(op)} ${fmt_expr(right)}"
        .Logical(left, op, right) -> "${fmt_expr(left)} ${logicop_str(op)} ${fmt_expr(right)}"
        .Call(callee, args) -> "${fmt_expr(callee)}(${fmt_expr_list_comma(args)})"
        .GenericCall(callee, ta, args) -> "${fmt_expr(callee)}::<${fmt_type_name_list(ta)}>(${fmt_expr_list_comma(args)})"
        .StructLit(name, inits) -> "${name} { ${fmt_field_init_list(inits)} }"
        .FieldAccess(obj, field) -> "${fmt_expr(obj)}.${field}"
        .EnumCtor(tn, variant, args) -> ".${variant}(${fmt_expr_list_comma(args)})"
        .Index(obj, idx) -> "${fmt_expr(obj)}[${fmt_expr(idx)}]"
        .Block(body) -> "{\n${fmt_stmt_list(body, 1)}\n}"
        .MatchExpr(subject, arms) -> "match ${fmt_expr(subject)} {\n${fmt_match_arms(arms, 1)}\n}"
        .FieldAssign(obj, field, value) -> "${fmt_expr(obj)}.${field} = ${fmt_expr(value)}"
        .IfExpr(c, t, e) -> "if ${fmt_expr(c)} { ${fmt_expr(t)} } else { ${fmt_expr(e)} }"
        .NullCoalesce(left, right) -> "${fmt_expr(left)} ?? ${fmt_expr(right)}"
        .OptionalChain(obj, field) -> "${fmt_expr(obj)}?.${field}"
        .Try(inner) -> "${fmt_expr(inner)}?"
        .Tuple(elements) -> "(${fmt_expr_list_comma(elements)})"
        .TupleIndex(obj, idx) -> "${fmt_expr(obj)}.${string(idx)}"
        .With(obj, overrides) -> "${fmt_expr(obj)} with { ${fmt_field_init_list(overrides)} }"
        .ListLit(elements) -> "[${fmt_expr_list_comma(elements)}]"
        .Lambda(params, body) -> "(${fmt_param_list_comma(params)}) -> ${fmt_expr(body)}"
        .MapLit(entries) -> "{ ${fmt_map_entries(entries)} }"
        .FloatLit(v) -> v
        .Slice(obj, start, end) -> "${fmt_expr(obj)}[${fmt_expr(start)}..${fmt_expr(end)}]"
        .IsCheck(subject, vname) -> "${fmt_expr(subject)} is .${vname}"
        .InCheck(needle, items) -> "${fmt_expr(needle)} in [${fmt_expr_list_comma(items)}]"
        .ListComp(body, variable, collection, _) -> "[${fmt_expr(body)} for ${variable} in ${fmt_expr(collection)}]"
        .When(arms) -> "when {\n${fmt_when_arms(arms, 1)}\n}"
        .Catch(inner, binding, body, _, _) -> "${fmt_expr(inner)} catch ${binding} { ${fmt_expr(body)} }"
        .Spawn(body) -> "spawn ${fmt_expr(body)}"
    }
}

fn fmt_stmt(ss: Stmt, depth: int) -> string {
    let ind = fmt_indent(depth)
    match ss {
        .Let(name, vt, init) -> {
            let ty_part = if vtype_display(vt) == "" { "" } else { ": ${vtype_display(vt)}" }
            "${ind}let ${name}${ty_part} = ${fmt_expr(init)}"
        }
        .Mut(name, vt, init) -> {
            let ty_part = if vtype_display(vt) == "" { "" } else { ": ${vtype_display(vt)}" }
            "${ind}mut ${name}${ty_part} = ${fmt_expr(init)}"
        }
        .Const(name, vt, init) -> {
            let ty_part = if vtype_display(vt) == "" { "" } else { ": ${vtype_display(vt)}" }
            "${ind}const ${name}${ty_part} = ${fmt_expr(init)}"
        }
        .Expr(se) -> "${ind}${fmt_expr(se)}"
        .Block(body) -> "${ind}{\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
        .If(condition, then_branch, else_branch) -> {
            let base = "${ind}if ${fmt_expr(condition)} {\n${fmt_stmt(then_branch, depth + 1)}\n${ind}}"
            if else_branch == null {
                base
            } else {
                "${base} else {\n${fmt_stmt(else_branch!, depth + 1)}\n${ind}}"
            }
        }
        .While(condition, body) -> "${ind}while ${fmt_expr(condition)} {\n${fmt_stmt(body, depth + 1)}\n${ind}}"
        .For(variable, start, end, body) -> "${ind}for ${variable} in ${fmt_expr(start)}..${fmt_expr(end)} {\n${fmt_stmt(body, depth + 1)}\n${ind}}"
        .ForIn(variable, collection, body) -> "${ind}for ${variable} in ${fmt_expr(collection)} {\n${fmt_stmt(body, depth + 1)}\n${ind}}"
        .Function(name, tp, params, rvt, body) -> {
            let tp_str = fmt_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            let ret_part = if vtype_eq(rvt, .Void) { "" } else { " -> ${vtype_display(rvt)}" }
            "${ind}fn ${name}${tp_part}(${fmt_param_list_typed(params)})${ret_part} {\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
        }
        .Return(value) -> "${ind}return ${fmt_expr(value)}"
        .ReturnEmpty -> "${ind}return"
        .TypeDecl(name, tp, fields) -> {
            let tp_str = fmt_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "${ind}type ${name}${tp_part} = {\n${fmt_field_decl_list(fields, depth + 1)}\n${ind}}"
        }
        .NewtypeDecl(name, inner_vt) -> "${ind}type ${name} = ${vtype_render_full(inner_vt)}"
        .UnionAliasDecl(name, type_vt) -> "${ind}type ${name} = ${vtype_render_full(type_vt)}"
        .ShapeDecl(name, fields) -> "${ind}shape ${name} = {\n${fmt_field_decl_list(fields, depth + 1)}\n${ind}}"
        .EnumDecl(name, tp, variants) -> {
            let tp_str = fmt_type_param_list(tp)
            let tp_part = if tp_str == "" { "" } else { "<${tp_str}>" }
            "${ind}enum ${name}${tp_part} {\n${fmt_variant_list(variants, depth + 1)}\n${ind}}"
        }
        .Match(subject, arms) -> "${ind}match ${fmt_expr(subject)} {\n${fmt_match_arms(arms, depth + 1)}\n${ind}}"
        .Impl(name, methods) -> {
            let colon = name.index_of(":")
            let impl_header = if colon >= 0 {
                let trait_name = name.substring(0, colon)
                let type_name = name.substring(colon + 1, name.length)
                "impl ${trait_name} for ${type_name}"
            } else {
                "impl ${name}"
            }
            "${ind}${impl_header} {\n${fmt_stmt_list(methods, depth + 1)}\n${ind}}"
        }
        .NoOp -> ""
        .ExternFn(name, params, rvt) -> "${ind}extern fn ${name}(${fmt_param_list_typed(params)}) -> ${vtype_display(rvt)}"
        .Break -> "${ind}break"
        .Continue -> "${ind}continue"
        .TraitDecl(name, methods) -> "${ind}trait ${name} {\n${fmt_stmt_list(methods, depth + 1)}\n${ind}}"
        .LetDestructure(names, init) -> "${ind}let (${fmt_param_list_comma(names)}) = ${fmt_expr(init)}"
        .Defer(body) -> "${ind}defer ${fmt_expr(body)}"
        .Errdefer(body) -> "${ind}errdefer ${fmt_expr(body)}"
        .Annotated(annotations, inner) -> "${fmt_annotation_list(annotations, depth)}${fmt_stmt(inner, depth)}"
        .SpecBlock(name, body) -> "${ind}spec ${name} {\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
        .GivenBlock(name, body) -> "${ind}given ${name} {\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
        .ThenBlock(name, cond) -> "${ind}then ${name} { ${fmt_expr(cond)} }"
        .Select(_) -> "${ind}select { ... }"
        .Parallel(body) -> "${ind}parallel {\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
        .Module(name, body) -> "${ind}mod ${name}\n${fmt_stmt_list(body, depth)}"
        .Use(path, names) -> "${ind}use ${path}.{${fmt_param_list_comma(names)}}"
        .AssocType(name, ty_vt) -> if vtype_is_unknown(ty_vt) { "${ind}type ${name}" } else { "${ind}type ${name} = ${vtype_render_full(ty_vt)}" }
        .ComponentDef(name, params, _, body) -> "${ind}component ${name}(${fmt_param_list_comma(params)}) {\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
        .ComponentBlock(comp, inst, _, body) -> "${ind}${comp} ${inst} {\n${fmt_stmt_list(body, depth + 1)}\n${ind}}"
    }
}

fn fmt_stmt_list(stmts: StmtList, depth: int) -> string {
    match stmts {
        .End -> ""
        .Node(ss, next) -> {
            let head = fmt_stmt(ss.node, depth)
            let tail = fmt_stmt_list(next, depth)
            if tail == "" { head } else { "${head}\n${tail}" }
        }
    }
}

fn fmt_expr_list_comma(exprs: ExprList) -> string {
    match exprs {
        .End -> ""
        .Node(se, next) -> {
            let head = fmt_expr(se.node)
            let tail = fmt_expr_list_comma_tail(next)
            "${head}${tail}"
        }
    }
}

fn fmt_expr_list_comma_tail(exprs: ExprList) -> string {
    match exprs {
        .End -> ""
        .Node(se, next) -> ", ${fmt_expr(se.node)}${fmt_expr_list_comma_tail(next)}"
    }
}

fn fmt_param_list_comma(params: ParamList) -> string {
    match params {
        .End -> ""
        .Node(name, _, next) -> {
            let tail = fmt_param_list_comma_tail(next)
            "${name}${tail}"
        }
    }
}

fn fmt_param_list_comma_tail(params: ParamList) -> string {
    match params {
        .End -> ""
        .Node(name, _, next) -> ", ${name}${fmt_param_list_comma_tail(next)}"
    }
}

fn fmt_param_list_typed(params: ParamList) -> string {
    match params {
        .End -> ""
        .Node(name, resolved, next) -> {
            let ty_part = if vtype_is_unknown(resolved) { "" } else { ": ${vtype_display(resolved)}" }
            let tail = fmt_param_list_typed_tail(next)
            "${name}${ty_part}${tail}"
        }
    }
}

fn fmt_param_list_typed_tail(params: ParamList) -> string {
    match params {
        .End -> ""
        .Node(name, resolved, next) -> {
            let ty_part = if vtype_is_unknown(resolved) { "" } else { ": ${vtype_display(resolved)}" }
            ", ${name}${ty_part}${fmt_param_list_typed_tail(next)}"
        }
    }
}

fn fmt_type_param_list(tp: TypeParamList) -> string {
    match tp {
        .End -> ""
        .Node(name, bound, next) -> {
            let bound_part = if bound == "" { "" } else { ": ${bound}" }
            let rest = fmt_type_param_list(next)
            if rest == "" { "${name}${bound_part}" } else { "${name}${bound_part}, ${rest}" }
        }
    }
}

fn fmt_type_name_list(names: TypeNameList) -> string {
    match names {
        .End -> ""
        .Node(name, next) -> {
            let rest = fmt_type_name_list(next)
            if rest == "" { name } else { "${name}, ${rest}" }
        }
    }
}

fn fmt_field_init_list(inits: FieldInitList) -> string {
    match inits {
        .End -> ""
        .Node(name, sv, next) -> {
            let head = "${name}: ${fmt_expr(sv.node)}"
            let tail = fmt_field_init_list_tail(next)
            "${head}${tail}"
        }
    }
}

fn fmt_field_init_list_tail(inits: FieldInitList) -> string {
    match inits {
        .End -> ""
        .Node(name, sv, next) -> ", ${name}: ${fmt_expr(sv.node)}${fmt_field_init_list_tail(next)}"
    }
}

fn fmt_field_decl_list(fields: FieldList, depth: int) -> string {
    let ind = fmt_indent(depth)
    match fields {
        .End -> ""
        .Node(name, vt, next) -> {
            let head = "${ind}${name}: ${vtype_display(vt)}"
            let tail = fmt_field_decl_list(next, depth)
            if tail == "" { head } else { "${head}\n${tail}" }
        }
    }
}

fn fmt_variant_list(variants: VariantList, depth: int) -> string {
    let ind = fmt_indent(depth)
    match variants {
        .End -> ""
        .Node(name, fields, next) -> {
            let fields_str = fmt_variant_fields(fields)
            let head = "${ind}${name}${fields_str}"
            let tail = fmt_variant_list(next, depth)
            if tail == "" { head } else { "${head}\n${tail}" }
        }
    }
}

fn fmt_variant_fields(fields: FieldList) -> string {
    match fields {
        .End -> ""
        .Node(name, vt, next) -> {
            let head = "${name}: ${vtype_display(vt)}"
            let tail = fmt_variant_fields_tail(next)
            "(${head}${tail})"
        }
    }
}

fn fmt_variant_fields_tail(fields: FieldList) -> string {
    match fields {
        .End -> ""
        .Node(name, vt, next) -> ", ${name}: ${vtype_display(vt)}${fmt_variant_fields_tail(next)}"
    }
}

fn fmt_pattern(p: Pattern) -> string {
    match p {
        .Wildcard -> "_"
        .Variant(name, bindings) -> {
            let bindings_str = fmt_param_list_comma(bindings)
            if bindings_str == "" { ".${name}" } else { ".${name}(${bindings_str})" }
        }
        .Or(left, right) -> "${fmt_pattern(left)} | ${fmt_pattern(right)}"
        .TypePattern(type_name, binding) -> "${type_name}(${binding})"
        _ -> "_"
    }
}

fn fmt_match_arms(arms: MatchArmList, depth: int) -> string {
    let ind = fmt_indent(depth)
    match arms {
        .End -> ""
        .Node(pattern, guard, body, next) -> {
            let guard_str = if guard != null { " if ${fmt_expr(guard!.node)}" } else { "" }
            let head = "${ind}${fmt_pattern(pattern)}${guard_str} -> ${fmt_expr(body.node)}"
            let tail = fmt_match_arms(next, depth)
            if tail == "" { head } else { "${head}\n${tail}" }
        }
    }
}

fn fmt_when_arms(arms: WhenArmList, depth: int) -> string {
    let ind = fmt_indent(depth)
    match arms {
        .End -> ""
        .Node(cond, body, next) -> {
            let cond_str = if cond == null { "_" } else { fmt_expr(cond!.node) }
            let head = "${ind}${cond_str} -> ${fmt_expr(body.node)}"
            let tail = fmt_when_arms(next, depth)
            if tail == "" { head } else { "${head}\n${tail}" }
        }
    }
}

fn fmt_annotation_list(annots: AnnotationList, depth: int) -> string {
    let ind = fmt_indent(depth)
    match annots {
        .End -> ""
        .Node(name, _, next) -> "${ind}@${name}\n${fmt_annotation_list(next, depth)}"
    }
}

fn fmt_map_entries(entries: ExprList) -> string {
    match entries {
        .End -> ""
        .Node(key_se, rest) -> {
            match rest {
                .End -> fmt_expr(key_se.node)
                .Node(val_se, next) -> {
                    let head = "${fmt_expr(key_se.node)}: ${fmt_expr(val_se.node)}"
                    let tail = fmt_map_entries(next)
                    if tail == "" { head } else { "${head}, ${tail}" }
                }
            }
        }
    }
}

// ── CLI component definitions ──
// Match the Rust std-cli component pattern exactly.
// Template components: init hooks use self.__parent to thread builder calls.

component cli(name: string) {
    config {
        description: string = ""
        version: string = "0.1.0"
    }
    fn init() {
        self.__parent = cli_new(self.name, self.config.description, self.config.version)
    }
}

component command(name: string) {
    config { description: string = "" }
    fn init() {
        self.__parent = cli_add_command(self.__parent, self.name, self.config.description)
    }
}

component flag(name: string) {
    config { short: string = "", description: string = "" }
    fn init() {
        self.__parent = cli_command_add_flag(self.__parent, self.__parent_name, "--${self.name}", self.config.short, self.config.description)
    }
}

component option(name: string) {
    config { short: string = "", description: string = "", default_val: string = "" }
    fn init() {
        self.__parent = cli_command_add_option(self.__parent, self.__parent_name, "--${self.name}", self.config.short, self.config.description, self.config.default_val)
    }
}

component arg(name: string) {
    config { description: string = "", required: bool = false }
    fn init() {
        self.__parent = cli_command_add_arg(self.__parent, self.__parent_name, self.name, self.config.description, self.config.required)
    }
}

// ── Test runner helpers ──

// Lang corpus = parse target/lang.av (generated by `avra lang`) and
// run it through the indexer. Filtered variants pull just the
// F-coded error consts.

fn extract_lang_corpus(project_dir: string) -> SymList {
    let path = "${project_dir}/target/lang.av"
    if avra_selfhost_file_exists(path) == 0 {
        eprintln("error: target/lang.av not found — run `avra lang` first")
        exit(1)
    }
    let content = avra_selfhost_read_file(path)
    if content == "" { return SymList.End }
    let parsed = parse_program_source(content)
    if parsed.had_error || parsed.stmts == null { return SymList.End }
    extract_from_ast(parsed.stmts!, "target/lang.av")
}

fn extract_errors_corpus(project_dir: string) -> SymList {
    sym_list_filter_errors(extract_lang_corpus(project_dir))
}

fn sym_list_filter_errors(list: SymList) -> SymList {
    mut acc = SymList.End
    mut cur = list
    while true {
        match cur {
            .End -> {
                return reverse_sym_list(acc)
            }
            .Node(item, next) -> {
                if item.name.starts_with("F") && item.name.length >= 5 {
                    acc = SymList.Node(item, acc)
                }
                cur = next
            }
        }
    }
    SymList.End
}

fn sym_list_concat(a: SymList, b: SymList) -> SymList {
    match a {
        .End -> b
        .Node(item, next) -> SymList.Node(item, sym_list_concat(next, b))
    }
}

fn reverse_sym_list(list: SymList) -> SymList {
    mut acc = SymList.End
    mut cur = list
    while true {
        match cur {
            .End -> {
                return acc
            }
            .Node(item, next) -> {
                acc = SymList.Node(item, acc)
                cur = next
            }
        }
    }
    SymList.End
}

fn strip_externs(stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> {
            match ss.node {
                .ExternFn(_, _, _) -> strip_externs(next)
                _ -> StmtList.Node(ss, strip_externs(next))
            }
        }
    }
}

fn prepend_test_externs(stmts: StmtList) -> StmtList {
    let s4 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_capture_stop", ParamList.End, ValueType.Str)), stmts)
    let s3 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_capture_start", ParamList.End, ValueType.Void)), s4)
    let s2 = StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_flush", ParamList.End, ValueType.Void)), s3)
    StmtList.Node(sstmt_dummy(Stmt.ExternFn("avra_test_summary", ParamList.End, ValueType.Int)), s2)
}

// Outcome of splitting a stmt list into hoistable package modules and
// the per-test body. Used by the test runner to keep each @std::pkg
// module unique across the whole program.
type PackageSplit = {
    packages: StmtList,
    body: StmtList,
}

fn split_package_modules(stmts: StmtList) -> PackageSplit {
    match stmts {
        .End -> PackageSplit { packages: StmtList.End, body: StmtList.End }
        .Node(ss, next) -> {
            let rest = split_package_modules(next)
            match ss.node {
                .Module(name, _) if name.length > 0 && name[0] == "@" -> PackageSplit {
                    packages: StmtList.Node(ss, rest.packages),
                    body: rest.body,
                }
                _ -> PackageSplit {
                    packages: rest.packages,
                    body: StmtList.Node(ss, rest.body),
                }
            }
        }
    }
}

fn append_stmt_list(a: StmtList, b: StmtList) -> StmtList {
    match a {
        .End -> b
        .Node(ss, next) -> StmtList.Node(ss, append_stmt_list(next, b))
    }
}



fn main() {
    // ── Fully declarative CLI ──
    // Matches the Rust std-cli pattern: nested component blocks, zero builder calls.
    cli app {
        description "Avra bootstrap compiler"
        version "0.1.0"

        command compile {
            description "Compile a Avra file to LLVM IR"
            flag coverage { short "-c", description "Enable coverage instrumentation" }
            flag debug_null { description "Enable null argument checks" }
            flag json { description "Output diagnostics as JSON" }
            option stop_after { description "Stop after phase (parse|resolve|names|check)" }
            arg file { description "Source file", required true }
        }

        command check {
            description "Type-check a Avra file"
            flag json { description "Output diagnostics as JSON" }
            arg file { description "Source file", required true }
        }

        command run {
            description "Compile and run a Avra file"
            arg file { description "Source file", required true }
        }

        command test {
            description "Run tests"
            option filter { short "-f", description "Filter tests by name" }
            flag coverage { short "-c", description "Enable coverage instrumentation" }
            arg file { description "Test file (optional)" }
        }

        command expr {
            description "Parse and display an expression"
            arg file { description "Source file", required true }
        }

        command program {
            description "Parse and display a program"
            arg file { description "Source file", required true }
        }

        command eval {
            description "Evaluate a Avra expression"
            arg file { description "Source file", required true }
        }

        command fix {
            description "Apply auto-fixes to a Avra file"
            arg file { description "Source file", required true }
        }

        command fmt {
            description "Format a Avra source file"
            arg file { description "Source file", required true }
        }

        command lsp {
            description "Start language server"
        }

        command features {
            description "List registered features"
        }

        command docs {
            description "Project documentation -- look up your project's functions, types, and enums"
            flag symbols { description "Show symbol/type reference" }
            flag short { description "Show just the one-liner for a symbol" }
            flag llm { description "Compact LLM-friendly project documentation" }
            flag validate { description "Validate documentation coverage for the project" }
            option search { description "Search project docs (substring match)" }
            arg query { description "Symbol to look up (function, type, enum name)" }
        }
    }

    // Handle subcommands that don't require a file argument.
    if avra_selfhost_argc() >= 2 {
        let cmd0 = avra_selfhost_get_arg_cstr(1)
        if cmd0 == "lsp" {
            // Index the project once, then enter the JSON-RPC stdio
            // loop. v1 serves a static graph; reindex-on-edit waits
            // for the cache layer (rnb9.7) to grow a watch loop.
            let project_dir = avra_process_env_get("PWD")
            run_lsp_server(project_dir)
            return
        }
        if cmd0 == "lang" {
            // Generate the language reference from compiler internals.
            // Writes to ./target/lang.av by default; --print pipes to
            // stdout so CI can diff against the checked-in copy.
            mut want_print = false
            mut k = 2
            while k < avra_selfhost_argc() {
                if avra_selfhost_get_arg_cstr(k) == "--print" {
                    want_print = true
                }
                k = k + 1
            }
            if want_print {
                println(render_lang_av())
                return
            }
            avra_shell_exec("mkdir -p target")
            let path = "target/lang.av"
            if write_lang_av(path) == 0 {
                eprintln("error: failed to write ${path}")
                exit(1)
            }
            println("wrote ${path}")
            return
        }
        if cmd0 == "docs" {
            let project_dir = avra_process_env_get("PWD")

            // Parse flags / option / positional from argv (cli_parse returns
            // the option/flag set keyed off the matched command).
            mut want_symbols = false
            mut want_short = false
            mut want_llm = false
            mut want_validate = false
            mut search_term = ""
            mut query = ""
            mut want_callers = false
            mut module_path = ""
            mut want_no_cache = false
            mut want_doctest = false
            mut scope = "project"
            mut format = "human"
            mut k = 2
            while k < avra_selfhost_argc() {
                let arg = avra_selfhost_get_arg_cstr(k)
                if arg == "--symbols" {
                    want_symbols = true
                    k = k + 1
                    continue
                }
                if arg == "--short" {
                    want_short = true
                    k = k + 1
                    continue
                }
                if arg == "--llm" {
                    want_llm = true
                    k = k + 1
                    continue
                }
                if arg == "--validate" {
                    want_validate = true
                    k = k + 1
                    continue
                }
                if arg == "--callers" || arg == "--used-by" {
                    want_callers = true
                    k = k + 1
                    continue
                }
                if arg == "--no-cache" {
                    want_no_cache = true
                    k = k + 1
                    continue
                }
                if arg == "--doctest" {
                    want_doctest = true
                    k = k + 1
                    continue
                }
                if arg == "--scope" {
                    if k + 1 < avra_selfhost_argc() {
                        scope = avra_selfhost_get_arg_cstr(k + 1)
                    }
                    k = k + 2
                    continue
                }
                if arg.starts_with("--scope=") {
                    scope = arg.substring(8, arg.length)
                    k = k + 1
                    continue
                }
                if arg == "--format" {
                    if k + 1 < avra_selfhost_argc() {
                        format = avra_selfhost_get_arg_cstr(k + 1)
                    }
                    k = k + 2
                    continue
                }
                if arg.starts_with("--format=") {
                    format = arg.substring(9, arg.length)
                    k = k + 1
                    continue
                }
                if arg == "--module" {
                    if k + 1 < avra_selfhost_argc() {
                        module_path = avra_selfhost_get_arg_cstr(k + 1)
                    }
                    k = k + 2
                    continue
                }
                if arg.starts_with("--module=") {
                    module_path = arg.substring(9, arg.length)
                    k = k + 1
                    continue
                }
                if arg == "--search" {
                    if k + 1 < avra_selfhost_argc() {
                        search_term = avra_selfhost_get_arg_cstr(k + 1)
                    }
                    k = k + 2
                    continue
                }
                if arg.starts_with("--search=") {
                    search_term = arg.substring(9, arg.length)
                    k = k + 1
                    continue
                }
                if !arg.starts_with("-") && query == "" {
                    query = arg
                }
                k = k + 1
            }

            if want_validate {
                validate_docs(project_dir)
                return
            }

            // --callers needs the call graph in addition to the
            // SymList, so cash both at once.
            if want_callers && query != "" {
                let corpus = extract_project_corpus(project_dir)
                if !show_callers(query, corpus) {
                    let suggestion = suggest_similar(query, corpus.syms)
                    eprintln("")
                    eprintln("  No symbol '${query}' found in project.")
                    if suggestion != "" {
                        eprintln("  Did you mean: ${suggestion}?")
                    }
                    eprintln("")
                    exit(1)
                }
                return
            }

            // Pick the corpus by scope:
            //   project (default) — walk PWD/*.av through the indexer
            //   lang              — read target/lang.av (generated by `avra lang`)
            //   errors            — same as lang, filtered to F-codes
            //   all               — project ∪ lang
            let docs_set = match scope {
                "project" -> extract_project_syms_cached(project_dir, want_no_cache)
                "lang" -> extract_lang_corpus(project_dir)
                "errors" -> extract_errors_corpus(project_dir)
                "all" -> sym_list_concat(
                    extract_project_syms_cached(project_dir, want_no_cache),
                    extract_lang_corpus(project_dir))
                _ -> {
                    eprintln("error: unknown scope '${scope}' (try project / lang / errors / all)")
                    exit(1)
                    SymList.End
                }
            }

            if want_doctest {
                let ok = run_doctests(docs_set)
                if !ok { exit(1) }
                return
            }

            // Non-human formats short-circuit the rest of the dispatch:
            // `--format=json` dumps the whole SymList; `--format=markdown`
            // emits a clean markdown rendering.
            if format == "json" {
                println(render_json(docs_set))
                return
            }
            if format == "markdown" {
                println(render_markdown(docs_set))
                return
            }
            if format != "human" {
                eprintln("error: unknown format '${format}' (try human / markdown / json)")
                exit(1)
            }

            if module_path != "" {
                if !show_module(module_path, docs_set) {
                    eprintln("")
                    eprintln("  No module '${module_path}' found in project.")
                    eprintln("")
                    exit(1)
                }
                return
            }
            if search_term != "" {
                show_search(search_term, docs_set)
                return
            }
            if want_llm {
                show_llm(docs_set)
                return
            }
            if want_symbols {
                show_symbols(docs_set)
                return
            }
            if query != "" {
                let found = if want_short {
                    show_short(query, docs_set)
                } else {
                    show_symbol(query, docs_set)
                }
                if !found {
                    let suggestion = suggest_similar(query, docs_set)
                    eprintln("")
                    eprintln("  No symbol '${query}' found in project.")
                    if suggestion != "" {
                        eprintln("  Did you mean: ${suggestion}?")
                    }
                    eprintln("  Hint: try `avra docs` for an overview.")
                    eprintln("")
                    exit(1)
                }
                return
            }

            show_overview(docs_set)
            return
        }
        if cmd0 == "test" {
            let project_dir = avra_process_env_get("PWD")

            // Parse args
            mut filter_arg = ""
            mut coverage_flag = false
            mut lcov_path = ""
            mut i = 2
            while i < avra_selfhost_argc() {
                let arg = avra_selfhost_get_arg_cstr(i)
                if arg == "-f" || arg == "--filter" {
                    if i + 1 < avra_selfhost_argc() {
                        filter_arg = avra_selfhost_get_arg_cstr(i + 1)
                    }
                    i = i + 2
                    continue
                }
                if arg == "-c" || arg == "--coverage" {
                    coverage_flag = true
                    i = i + 1
                    continue
                }
                if arg == "--lcov" {
                    coverage_flag = true
                    if i + 1 < avra_selfhost_argc() {
                        lcov_path = avra_selfhost_get_arg_cstr(i + 1)
                    }
                    i = i + 2
                    continue
                }
                i = i + 1
            }

            // Step 1: Discover _test.av files
            // TODO(bead wcrm): replace with proper FS walk
            let test_files = avra_shell_exec("find ${project_dir} -name '*_test.av' -type f -not -path '*/build/*' 2>/dev/null | sort")
            if test_files == "" {
                println("No test files found.")
                return
            }

            // Step 2: Parse each test file as a Module
            // Each file becomes Stmt.Module(name, body) — proper namespacing.
            // Module-level code (spec blocks) executes via __bs_top_level patching.
            //
            // @std packages are loaded once and HOISTED to the top level of the
            // program. Without hoisting, every test file would carry its own
            // copy of each @std package; the resolver's global index would then
            // contain N copies of every package-defined type and `item_lookup`
            // returns the first match, mis-qualifying types and producing
            // duplicate impl-method names (forge-crafting-intepreters-xks4).
            mut modules = StmtList.End
            mut packages = StmtList.End
            mut shared_loaded = LoadedPaths.End
            mut count = 0
            for path in test_files.split("\n") {
                if path == "" { continue }
                let content = read_file(path)
                if !content.contains("spec ") { continue }
                if content.contains("fn main()") { continue }

                let mod_name = basename_no_ext(path)
                if filter_arg != "" && !mod_name.contains(filter_arg) { continue }

                let parsed = parse_program_source(content)
                if parsed.had_error || parsed.stmts == null {
                    if bag_has_errors(parsed.bag) {
                        render_bag(content, path, parsed.bag)
                    }
                    eprintln("error parsing ${path}")
                    continue
                }

                // Resolve any `mod foo` stubs against the test file's
                // directory so sibling .av files are pulled in. Share
                // LoadedPaths across tests so each @std package is only
                // inlined the first time any test imports it.
                let test_dir = modules_dirname(path)
                let mod_resolved = resolve_module_files(parsed.stmts!, test_dir, shared_loaded)
                if mod_resolved.had_error {
                    eprintln("module resolve error in ${path}: ${mod_resolved.error_message}")
                    continue
                }
                shared_loaded = mod_resolved.loaded

                // Hoist @-prefixed package modules out of the test body and
                // into a single top-level group. Per-test bodies keep `use`
                // statements, which still resolve against the hoisted modules.
                let split = split_package_modules(mod_resolved.stmts)
                packages = append_stmt_list(split.packages, packages)
                modules = StmtList.Node(
                    sstmt_dummy(Stmt.Module(mod_name, split.body)),
                    modules
                )
                count = count + 1
            }

            if count == 0 {
                println("No spec test files found.")
                return
            }

            // Step 3: Build program — externs + packages + modules + main
            //
            // Hoisted package modules sit at the program root so the
            // resolver's module tree contains exactly one copy of each
            // @std::pkg, regardless of how many tests imported it.
            mut program = prepend_test_externs(append_stmt_list(packages, modules))

            // main() just calls avra_test_summary().
            // Module-level spec blocks run via __bs_top_level (codegen patches main to call it).
            let main_body = StmtList.Node(
                sstmt_dummy(Stmt.Expr(Expr.Call(Expr.Ident("avra_test_summary"), ExprList.End))),
                StmtList.End
            )
            program = StmtList.Node(
                sstmt_dummy(Stmt.Function("main", TypeParamList.End, ParamList.End, ValueType.Int, main_body)),
                program
            )

            // Step 4: Full pipeline
            let desugared = desugar_program(program)
            let expanded = expand_components(desugared)
            let named = resolve_names(expanded)
            if bag_has_errors(named.bag) || named.had_error {
                render_bag("", "<test>", named.bag)
                fail(named.error_message)
            }
            let tc_result = typecheck_program(named.stmts)
            if bag_has_errors(tc_result.bag) {
                render_bag("", "<test>", tc_result.bag)
                fail("type check failed")
            }
            let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
            if bag_has_errors(mono.bag) {
                render_bag("", "<test>", mono.bag)
                fail("monomorphization failed")
            }

            // Step 5: emit object + link + run.
            // Non-coverage: codegen straight to .o, link, exec.
            // Coverage: codegen IR, lower instrprof via opt, llc to .o, link
            // with profile runtime + 16K-page-aligned profile sections, exec
            // with LLVM_PROFILE_FILE set, then call llvm-cov for the report.
            // All coverage intermediates live under build/coverage/ so the
            // regular build tree stays clean.
            let build_dir = "${project_dir}/build"
            let llvm_env = avra_process_env_get("LLVM_PREFIX")
            let llvm_prefix = if llvm_env == "" { "/opt/homebrew/opt/llvm" } else { llvm_env }
            let llvm_lib = "${llvm_prefix}/lib"

            if !coverage_flag {
                let obj_path = "${build_dir}/_test.o"
                let bin_path = "${build_dir}/_test.bin"
                match codegen_and_emit_object(mono.stmts, obj_path, named.type_reg) {
                    .Ok(_) -> {}
                    .Err(e) -> { fail(e) }
                }
                let link_args = "[\"${obj_path}\", \"${build_dir}/runtime.o\", \"${build_dir}/llvm_wrapper.o\", \"-o\", \"${bin_path}\", \"-Wl,-stack_size,0x2000000\", \"-L${llvm_lib}\", \"-lLLVM\", \"-lc++\"]"
                if avra_process_forward("cc", link_args, "") != 0 { fail("link failed") }
                let exit_code = avra_process_forward(bin_path, "[]", "")
                avra_process_exit(exit_code)
                return
            }

            // ── Coverage path ──
            let cov_dir = "${build_dir}/coverage"
            avra_shell_exec("mkdir -p ${cov_dir}")
            let ir_path = "${cov_dir}/_test.ll"
            let cov_ll = "${cov_dir}/_test.cov.ll"
            let obj_path = "${cov_dir}/_test.o"
            let bin_path = "${cov_dir}/_test.bin"
            let profraw = "${cov_dir}/_test.profraw"
            let profdata = "${cov_dir}/_test.profdata"

            match codegen_and_emit_ir_cov(mono.stmts, ir_path, named.type_reg, "${cov_dir}/_test.av") {
                .Ok(_) -> {}
                .Err(e) -> { fail(e) }
            }

            // Lower llvm.instrprof.increment intrinsics to runtime counter updates.
            let opt_args = "[\"-passes=instrprof\", \"-mtriple=arm64-apple-macosx\", \"-o\", \"${cov_ll}\", \"-S\", \"${ir_path}\"]"
            if avra_process_forward("${llvm_prefix}/bin/opt", opt_args, "") != 0 {
                fail("opt instrprof lowering failed")
            }

            // Lowered IR → object.
            let llc_args = "[\"-O2\", \"-filetype=obj\", \"${cov_ll}\", \"-o\", \"${obj_path}\"]"
            if avra_process_forward("${llvm_prefix}/bin/llc", llc_args, "") != 0 {
                fail("llc failed")
            }

            // Locate clang_rt.profile_osx (path varies by LLVM version).
            let darwin_dir = avra_shell_exec("ls -1 ${llvm_prefix}/lib/clang | head -1").trim()
            let prof_lib_dir = "${llvm_prefix}/lib/clang/${darwin_dir}/lib/darwin"
            // Page-align the profile sections — clang_rt's profile runtime
            // computes counter array bounds from section addresses and
            // expects 16K alignment on Darwin/arm64. Without these flags
            // llvm-profdata reports "number of counters is zero".
            let sectalign = "\"-Wl,-sectalign,__DATA,__llvm_prf_cnts,0x4000\", \"-Wl,-sectalign,__DATA,__llvm_prf_bits,0x4000\", \"-Wl,-sectalign,__DATA,__llvm_prf_data,0x4000\""
            let link_args = "[\"${obj_path}\", \"${build_dir}/runtime.o\", \"${build_dir}/llvm_wrapper.o\", \"-o\", \"${bin_path}\", \"-Wl,-stack_size,0x2000000\", \"-L${llvm_lib}\", \"-lLLVM\", \"-lc++\", \"-L${prof_lib_dir}\", \"-lclang_rt.profile_osx\", ${sectalign}]"
            if avra_process_forward("cc", link_args, "") != 0 {
                fail("link failed")
            }

            // Run the instrumented binary directly so its stdout streams to
            // the user. We pass LLVM_PROFILE_FILE through the env-options
            // payload of avra_process_forward (avra_shell_exec would buffer
            // the entire output and can lose lines on very large suites).
            avra_shell_exec("rm -f ${profraw}")
            let run_opts = "{\"env\":{\"LLVM_PROFILE_FILE\":\"${profraw}\"}}"
            let run_rc = avra_process_forward(bin_path, "[]", run_opts)
            if run_rc != 0 { eprintln("test binary exited with code ${string(run_rc)}") }

            // Merge profraw → profdata.
            let merge_out = avra_shell_exec("${llvm_prefix}/bin/llvm-profdata merge -sparse -o ${profdata} ${profraw} 2>&1")
            if merge_out.length > 0 { eprintln(merge_out.trim()) }

            // Dump profdata to text and hand off to the Avra-side renderer
            // (coverage::render_coverage). The renderer joins our codegen-
            // emitted covmap.tsv with the per-function counts to produce
            // line/branch/MC-DC stats and an optional LCOV file.
            let dump_path = "${cov_dir}/_test.profdata.txt"
            avra_shell_exec("${llvm_prefix}/bin/llvm-profdata show --all-functions --counts ${profdata} > ${dump_path} 2>/dev/null")

            let covmap_path = "${cov_dir}/_test.av.covmap.tsv"
            println("")
            render_coverage(covmap_path, dump_path, lcov_path)

            avra_process_exit(0)
            return
        }
    }

    if avra_selfhost_argc() < 3 {
        print_usage()
        exit(1)
    }

    let command = avra_selfhost_get_arg_cstr(1)
    let path = avra_selfhost_get_arg_cstr(2)
    let is_flag = path.starts_with("--")
    if !is_flag && !file_exists(path) {
        fail("error: file not found: ${path}")
    }

    let source = if is_flag { "" } else { read_file(path) }
    match command {
        "expr" -> {
            let result = parse_expression_source(source)
            if result.had_error || result.expr == null {
                fail(result.error_message)
            }
            println(render_expr(result.expr!))
            return
        }
        "program" -> {
            let result = parse_program_source(source)
            if result.had_error || result.stmts == null {
                fail(result.error_message)
            }
            println(render_stmt_list(result.stmts!))
            return
        }
        "eval" -> {
            let result = eval_expression_source(source)
            if result.had_error || result.value == null {
                fail(result.error_message)
            }
            println(render_value(result.value!))
            return
        }
        "check" -> {
            // Parse --json flag using @std/cli
            let check_parsed = cli_parse(app)
            let check_json = result_has_flag(check_parsed, "json")
            let check_argc = avra_selfhost_argc()
            let check_path = if check_argc > 3 { avra_selfhost_get_arg_cstr(check_argc - 1) } else { path }
            let check_source = if check_path != path { read_file(check_path) } else { source }

            let parsed = parse_program_source(check_source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    if check_json { render_bag_json(check_path, parsed.bag) } else { render_bag(check_source, check_path, parsed.bag) }
                }
                fail(parsed.error_message)
            }
            let check_dir = modules_dirname(check_path)
            let check_pkg = load_package_config(check_dir)
            if check_pkg.found && !check_json {
                eprintln("[pkg] ${check_pkg.name} v${check_pkg.version}")
            }
            let desugared = desugar_program(parsed.stmts!)
            let entry_dir = modules_dirname(check_path)
            let mod_resolved = resolve_module_files(desugared, entry_dir, LoadedPaths.End)
            if mod_resolved.had_error {
                let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
                if check_json { render_bag_json(check_path, mod_bag) } else { render_bag(check_source, check_path, mod_bag) }
                fail(mod_resolved.error_message)
            }
            let expanded = expand_components(mod_resolved.stmts)
            let named = resolve_names(expanded)
            if bag_has_errors(named.bag) || bag_has_warnings(named.bag) {
                if check_json { render_bag_json(check_path, named.bag) } else { render_bag(check_source, check_path, named.bag) }
            }
            if named.had_error { fail(named.error_message) }
            let tc_result = typecheck_program(named.stmts)
            if bag_has_errors(tc_result.bag) || bag_has_warnings(tc_result.bag) {
                if check_json { render_bag_json(check_path, tc_result.bag) } else { render_bag(check_source, check_path, tc_result.bag) }
            }
            if bag_has_errors(tc_result.bag) { return }
            if !check_json { println("ok") }
            return
        }
        "run" -> {
            let result = execute_program_source(source)
            if result.had_error || result.value == null {
                fail(result.error_message)
            }
            println(render_value(result.value!))
            return
        }
        "fix" -> {
            // Ticket 8ym: autofix infrastructure.
            // Parse and check the file, then apply high-confidence fixes.
            // For v1.0: no auto-fixes are implemented yet, so we just report that.
            let parsed = parse_program_source(source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag(source, path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            let entry_dir = modules_dirname(path)
            let mod_resolved = resolve_module_files(parsed.stmts!, entry_dir, LoadedPaths.End)
            if mod_resolved.had_error {
                fail(mod_resolved.error_message)
            }
            let named = resolve_names(mod_resolved.stmts)
            if bag_has_errors(named.bag) {
                render_bag(source, path, named.bag)
            }
            println("no auto-fixes available")
            return
        }
        "fmt" -> {
            // Ticket c5w: code formatter (spec Axis 27.1).
            // Avra syntax.
            let parsed = parse_program_source(source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag(source, path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            println(fmt_stmt_list(parsed.stmts!, 0))
            return
        }
        "test" -> {
            // Ticket syu: test runner (spec Axis 27.3).
            // Compile the file (which should contain spec/given/then blocks)
            // and report the output path for linking and execution.
            let parsed = parse_program_source(source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag(source, path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            let desugared = desugar_program(parsed.stmts!)
            let entry_dir = modules_dirname(path)
            let mod_resolved = resolve_module_files(desugared, entry_dir, LoadedPaths.End)
            if mod_resolved.had_error {
                let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
                render_bag(source, path, mod_bag)
                fail(mod_resolved.error_message)
            }
            let expanded = expand_components(mod_resolved.stmts)
            let named = resolve_names(expanded)
            if bag_has_errors(named.bag) || bag_has_warnings(named.bag) {
                render_bag(source, path, named.bag)
            }
            if named.had_error { fail(named.error_message) }
            let tc_result = typecheck_program(named.stmts)
            if bag_has_errors(tc_result.bag) || bag_has_warnings(tc_result.bag) {
                render_bag(source, path, tc_result.bag)
            }
            if bag_has_errors(tc_result.bag) { fail("type check failed") }
            let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
            if bag_has_errors(mono.bag) {
                render_bag(source, path, mono.bag)
                fail("monomorphization failed")
            }
            let output = "${path}.ll"
            match compile_program(mono.stmts, output, false, false, path, named.type_reg) {
                .Ok(_) -> {}
                .Err(e) -> {
                    let ice_bag = bag_report(bag_new(), diag_ice("internal compiler error during codegen: ${e}"))
                    render_bag(source, path, ice_bag)
                    fail(e)
                }
            }
            println(output)
            return
        }
        _ -> {}
    }

    if command == "compile" {
        // Parse compile flags using @std/cli
        let parsed = cli_parse(app)
        let stop_after = result_get_option(parsed, "stop-after")
        let debug_null = result_has_flag(parsed, "debug-null")
        let enable_coverage = result_has_flag(parsed, "coverage")
        let json_output = result_has_flag(parsed, "json")
        // File path: last positional arg
        let argc = avra_selfhost_argc()
        let cpath = avra_selfhost_get_arg_cstr(argc - 1)
        if cpath.starts_with("-") {
            fail("error: compile requires a file path argument")
        }
        if !file_exists(cpath) {
            fail("error: file not found: ${cpath}")
        }
        let csource = read_file(cpath)

        // Load avra.toml package manifest if present in entry dir.
        let pkg_dir = modules_dirname(cpath)
        let pkg = load_package_config(pkg_dir)
        if pkg.found {
            eprintln("[pkg] ${pkg.name} v${pkg.version}")
        }

        let parsed = parse_program_source(csource)
        if parsed.had_error || parsed.stmts == null {
            if bag_has_errors(parsed.bag) {
                if json_output { render_bag_json(cpath, parsed.bag) }
                else { render_bag(csource, cpath, parsed.bag) }
            }
            fail(parsed.error_message)
        }
        if stop_after == "parse" {
            println("ok")
            return
        }
        // Desugar pass: rewrite syntactic sugar to simpler AST forms.
        let desugared = desugar_program(parsed.stmts!)
        // Resolve module files: walk the AST, find `mod` stubs, read
        // and parse the referenced files, attach parsed bodies.
        let entry_dir = modules_dirname(cpath)
        let mod_resolved = resolve_module_files(desugared, entry_dir, LoadedPaths.End)
        if mod_resolved.had_error {
            let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
            if json_output { render_bag_json(cpath, mod_bag) }
            else { render_bag(csource, cpath, mod_bag) }
            fail(mod_resolved.error_message)
        }
        if stop_after == "resolve" {
            println("ok")
            return
        }
        // Component expansion: runs AFTER module resolution so component
        // definitions in any module are visible to the expander.
        let expanded = expand_components(mod_resolved.stmts)
        let named = resolve_names(expanded)
        if bag_has_errors(named.bag) || bag_has_warnings(named.bag) {
            if json_output { render_bag_json(cpath, named.bag) }
            else { render_bag(csource, cpath, named.bag) }
        }
        if named.had_error { fail(named.error_message) }
        if stop_after == "names" {
            println("ok")
            return
        }
        // Type check — gates compilation on errors
        let tc_result = typecheck_program(named.stmts)
        if bag_has_errors(tc_result.bag) || bag_has_warnings(tc_result.bag) {
            if json_output { render_bag_json(cpath, tc_result.bag) }
            else { render_bag(csource, cpath, tc_result.bag) }
        }
        if bag_has_errors(tc_result.bag) { fail("type check failed") }
        if stop_after == "check" {
            println("ok")
            return
        }
        // Monomorphize: replace generic declarations with concrete specializations.
        // Uses the type-annotated AST from typeck so inference reads SExpr.ty.
        let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
        if bag_has_errors(mono.bag) {
            if json_output { render_bag_json(cpath, mono.bag) }
            else { render_bag(csource, cpath, mono.bag) }
            fail("monomorphization failed")
        }
        let output = "${cpath}.ll"
        // Ticket t2w: ICE handler — wrap codegen errors in F9999.
        match compile_program(mono.stmts, output, debug_null, enable_coverage, cpath, named.type_reg) {
            .Ok(_) -> {}
            .Err(e) -> {
                let ice_bag = bag_report(bag_new(), diag_ice("internal compiler error during codegen: ${e}"))
                if json_output { render_bag_json(cpath, ice_bag) }
                else { render_bag(csource, cpath, ice_bag) }
                fail(e)
            }
        }
        println(output)
        return
    }

    print_usage()
    exit(1)
}
