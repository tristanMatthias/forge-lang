/// expect: Hello user alice
/// expect: alice
/// expect: 42

type UserId = string
type Meters = int

fn greet(uid: UserId) -> string {
    "Hello user " + uid.raw()
}

fn main() {
    let uid = UserId("alice")
    println(greet(uid))
    println(uid.raw())

    let dist = Meters(42)
    println(string(dist.raw()))
}
