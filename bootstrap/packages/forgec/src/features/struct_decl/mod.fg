mod parser
mod codegen
mod typeck
use codegen.types.{err_emit}
use features.eval.{error_result}
use core.registry.{feature_new, Feature}
use resolve.{resolve_expr, resolve_expr_list, resolve_field_init_list, starts_with_upper}
use features.enum_decl.codegen.{emit_enum_ctor}
use features.struct_decl.codegen.{emit_field_access, emit_field_assign, emit_struct_lit}
use features.struct_decl.typeck.{check_field_access, check_field_inits}
use typeck.{tc_enum_find_by_variant}
use typeck.{check_expr, check_expr_list, tc_er}

export fn struct_lit_feature() -> Feature {
    feature_new("struct_lit") with {
        expr_tag: Expr.StructLit("", FieldInitList.End),
        emit_expr: struct_lit_emit_expr,
        resolve_expr: struct_lit_resolve_expr,
        check_expr: struct_lit_check_expr,
        eval_expr: struct_lit_eval_expr,
    }
}

export fn field_access_feature() -> Feature {
    feature_new("field_access") with {
        expr_tag: Expr.FieldAccess(Expr.Null, ""),
        emit_expr: field_access_emit_expr,
        resolve_expr: field_access_resolve_expr,
        check_expr: field_access_check_expr,
        eval_expr: field_access_eval_expr,
    }
}

export fn enum_ctor_feature() -> Feature {
    feature_new("enum_ctor") with {
        expr_tag: Expr.EnumCtor("", "", ExprList.End),
        emit_expr: enum_ctor_emit_expr,
        resolve_expr: enum_ctor_resolve_expr,
        check_expr: enum_ctor_check_expr,
        eval_expr: enum_ctor_eval_expr,
    }
}

export fn field_assign_feature() -> Feature {
    feature_new("field_assign") with {
        expr_tag: Expr.FieldAssign(Expr.Null, "", Expr.Null),
        emit_expr: field_assign_emit_expr,
        // FieldAssign resolution is handled directly in resolve/mod.fg (deep immutability check)
        resolve_expr: field_assign_resolve_expr,
        check_expr: field_assign_check_expr,
        eval_expr: field_assign_eval_expr,
    }
}

export fn type_decl_feature() -> Feature {
    feature_new("type_decl") with {
        decl_keyword: "kw_type",
        parse_decl: (p: Parser) -> p.parse_type_declaration(),
    }
}

export fn shape_decl_feature() -> Feature {
    feature_new("shape_decl") with {
        decl_keyword: "kw_shape",
        parse_decl: (p: Parser) -> p.parse_shape_declaration(),
    }
}

fn struct_lit_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .StructLit(name, inits) -> emit_struct_lit(ctx, env, name, inits)
        _ -> err_emit("expected StructLit")
    }
}

fn struct_lit_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .StructLit(_, inits) -> resolve_field_init_list(r, inits)
        _ -> r
    }
}

fn struct_lit_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .StructLit(name, inits) -> {
            let checked = check_field_inits(tc, inits)
            tc_er(checked, .Struct(name))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

fn struct_lit_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .StructLit(_, _) -> error_result(rt, "struct literals are not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected StructLit")
    }
}

fn field_access_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .FieldAccess(obj, field) -> emit_field_access(ctx, env, obj, field)
        _ -> err_emit("expected FieldAccess")
    }
}

fn field_access_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .FieldAccess(obj, _) -> {
            match obj {
                .Ident(name) -> {
                    if starts_with_upper(name) {
                        return r
                    }
                    resolve_expr(r, obj)
                }
                _ -> resolve_expr(r, obj)
            }
        }
        _ -> r
    }
}

fn field_access_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .FieldAccess(obj, field) -> check_field_access(tc, obj, field)
        _ -> tc_er(tc, .Unknown)
    }
}

fn field_access_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .FieldAccess(_, _) -> error_result(rt, "field access is not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected FieldAccess")
    }
}

fn enum_ctor_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .EnumCtor(type_name, variant, args) -> emit_enum_ctor(ctx, env, type_name, variant, args)
        _ -> err_emit("expected EnumCtor")
    }
}

fn enum_ctor_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .EnumCtor(_, _, args) -> resolve_expr_list(r, args)
        _ -> r
    }
}

fn enum_ctor_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .EnumCtor(type_name, variant, args) -> {
            let checked = check_expr_list(tc, args)
            let resolved_name = if type_name == "" { tc_enum_find_by_variant(tc.enums, variant) } else { type_name }
            tc_er(checked, .Enum(resolved_name, TypeList.End))
        }
        _ -> tc_er(tc, .Unknown)
    }
}

fn enum_ctor_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .EnumCtor(_, _, _) -> error_result(rt, "enum constructors are not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected EnumCtor")
    }
}

fn field_assign_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .FieldAssign(obj, field, value) -> emit_field_assign(ctx, env, obj, field, value)
        _ -> err_emit("expected FieldAssign")
    }
}

fn field_assign_resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    r
}

fn field_assign_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .FieldAssign(obj, _, value) -> {
            let o = check_expr(tc, obj)
            let v = check_expr(o.tc, value)
            tc_er(v.tc, v.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

fn field_assign_eval_expr(rt: Runtime, expr: Expr) -> StepResult {
    match expr {
        .FieldAssign(_, _, _) -> error_result(rt, "field assignment is not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected FieldAssign")
    }
}
