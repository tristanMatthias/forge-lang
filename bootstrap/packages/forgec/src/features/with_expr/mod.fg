mod codegen
use codegen.types.{err_emit}
use features.eval.{error_result}
use core.registry.{feature_new, Feature}
use resolve.{resolve_expr, resolve_field_init_list}
use features.struct_decl.typeck.{check_field_inits}
use features.with_expr.codegen.{emit_with}
use typeck.{check_expr, tc_er}

export fn with_expr_feature() -> Feature {
    feature_new("with") with {
        expr_tag: Expr.With(Expr.Null, FieldInitList.End),
        emit_expr: with_emit,
        resolve_expr: with_resolve,
        check_expr: with_check,
        eval_expr: with_eval,
    }
}

fn with_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .With(obj, overrides) -> emit_with(ctx, env, obj, overrides)
        _ -> err_emit("expected With")
    }
}

fn with_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .With(obj, overrides) -> {
            let after_obj = resolve_expr(r, obj)
            resolve_field_init_list(after_obj, overrides)
        }
        _ -> r
    }
}

fn with_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .With(obj, overrides) -> {
            let o = check_expr(tc, obj)
            let checked = check_field_inits(o.tc, overrides)
            tc_er(checked, o.ty)
        }
        _ -> tc_er(tc, .Unknown)
    }
}

fn with_eval(rt: Runtime, expr: Expr) -> EvalResult {
    match expr {
        .With(_, _) -> error_result(rt, "with expression is not supported by the tree-walk evaluator")
        _ -> error_result(rt, "expected With")
    }
}
