mod parser
mod codegen
use core.ast.{sexpr_dummy}
use codegen.types.{err_stmt, ok_stmt, StmtResult}
use codegen.{ok_sr, err_sr}
use features.eval.{error_result, ok_result, value_null}
use resolve.{resolve_expr}
use codegen.types.{DeferStack}
use typeck.{check_expr}

// ── Defer handlers (exported for feature component registration) ──

export fn defer_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .Defer(body) -> {
            let updated = ctx with { defers: DeferStack.Frame(sexpr_dummy(body), ctx.defers) }
            ok_sr(updated, env)
        }
        _ -> err_sr("expected Defer")
    }
}

export fn defer_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Defer(body) -> resolve_expr(r, body), _ -> r }
}

export fn defer_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Defer(body) -> {
            let r = check_expr(tc, body)
            r.tc
        }
        _ -> tc
    }
}

export fn defer_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Defer(_) -> ok_result(rt, value_null())
        _ -> error_result(rt, "expected Defer")
    }
}

// ── Errdefer handlers ──

export fn errdefer_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .Errdefer(body) -> {
            let updated = ctx with { defers: DeferStack.ErrFrame(sexpr_dummy(body), ctx.defers) }
            ok_sr(updated, env)
        }
        _ -> err_sr("expected Errdefer")
    }
}

export fn errdefer_resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    match stmt { .Errdefer(body) -> resolve_expr(r, body), _ -> r }
}

export fn errdefer_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Errdefer(body) -> {
            let r = check_expr(tc, body)
            r.tc
        }
        _ -> tc
    }
}

export fn errdefer_eval_stmt(rt: Runtime, stmt: Stmt) -> StepResult {
    match stmt {
        .Errdefer(_) -> ok_result(rt, value_null())
        _ -> error_result(rt, "expected Errdefer")
    }
}
