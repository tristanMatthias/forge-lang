// Test: generic Result<T, E> with ? operator and scoped type inference.
/// expect: 42
/// expect: propagated: division by zero

enum Result<T, E> {
    Ok(value: T),
    Err(error: E),
}

fn divide(a: int, b: int) -> Result {
    if b == 0 { return Result.Err("division by zero") }
    Result.Ok(a / b)
}

fn main() {
    match divide(84, 2) {
        .Ok(v) -> println(string(v))
        .Err(e) -> println("error: ${e}")
    }
    match divide(10, 0) {
        .Ok(v) -> println(string(v))
        .Err(e) -> println("propagated: ${e}")
    }
}
