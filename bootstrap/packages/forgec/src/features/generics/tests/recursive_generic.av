// Test: recursive/self-referential generic enum.
/// expect: 1
/// expect: 2
/// expect: 3

enum List<T> {
    End,
    Node(value: T, next: List<T>),
}

fn print_list(list: List) {
    match list {
        .End -> {}
        .Node(v, next) -> {
            println(string(v))
            print_list(next)
        }
    }
}

fn main() {
    let list = List.Node(1, List.Node(2, List.Node(3, List.End)))
    print_list(list)
}
