// Test: generics edge cases — chained generics, multi-field structs,
// pipe operator, closures, string interpolation, loops, defer.
/// expect: 42
/// expect: hello 10
/// expect: 84
/// expect: 42
/// expect: value: 42
/// expect: 1
/// expect: 2
/// expect: 3
/// expect: done

// 1. Generic calling another generic
fn identity<T>(x: T) -> T { x }
fn double_identity<T>(x: T) -> T { identity(x) }

// 2. Multi-field struct with different type params
type Pair<A, B> = { first: A, second: B }

// 3. Generic with pipe operator
fn inc<T>(x: T) -> T { x }

// 4. Generic function accepting closure
fn apply<T>(x: T, f: fn(T) -> T) -> T { f(x) }

// 5. String interpolation in generic function body
fn show(x: int) -> string { "value: ${string(x)}" }

// 6. Generic with for loop in body
fn print_all(items: List) {
    for item in items {
        println(string(item))
    }
}

fn main() {
    // 1. Chained generics
    println(string(double_identity(42)))

    // 2. Multi-field struct
    let p = Pair { first: "hello", second: 10 }
    println("${p.first} ${string(p.second)}")

    // 3. Pipe through generic
    let piped = 84 |> inc
    println(string(piped))

    // 4. Generic with closure
    let doubled = apply(21, (x) -> x * 2)
    println(string(doubled))

    // 5. String interpolation
    println(show(42))

    // 6. For loop
    print_all([1, 2, 3])

    // 7. Defer in scope
    {
        defer println("done")
    }
}
