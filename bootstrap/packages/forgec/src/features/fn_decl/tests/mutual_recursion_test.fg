fn is_even(n: int) -> int {
    if n == 0 { return 1 }
    is_odd(n - 1)
}

fn is_odd(n: int) -> int {
    if n == 0 { return 0 }
    is_even(n - 1)
}

spec "mutual recursion" {
    then "10 is even" {
        is_even(10) == 1
    }
    then "10 is not odd" {
        is_odd(10) == 0
    }
    then "7 is not even" {
        is_even(7) == 0
    }
    then "7 is odd" {
        is_odd(7) == 1
    }
}
