type Counter = { value: int }
type Point = { x: int, y: int }

enum Action { Inc(n: int), Dec(n: int), Reset }

fn maybe(x: int) -> int? {
    if x > 0 { return x }
    null
}

spec "immutability aggressive" {
    then "mut sum in loop" {
        mut total = 0
        for i in 0..10 {
            mut local = i * i
            local = local + 1
            total = total + local
        }
        total == 295
    }
    then "let shadow in nested blocks" {
        let x = 100
        let inner1 = 200
        let inner2 = 300
        x == 100
    }
    then "mut struct field" {
        mut c = Counter { value: 0 }
        c.value = 42
        c.value == 42
    }
    then "mut with enum match arms" {
        mut acc = 50
        let actions = [Action.Inc(10), Action.Dec(3), Action.Inc(7), Action.Reset, Action.Inc(5)]
        for a in actions {
            match a {
                .Inc(n) -> { acc = acc + n }
                .Dec(n) -> { acc = acc - n }
                .Reset -> { acc = 0 }
            }
        }
        acc == 5
    }
    // TODO: closure mutation capture not yet supported
    // then "mut with closures" { ... }
    then "with expression preserves original" {
        let p = Point { x: 1, y: 2 }
        let p2 = p with { x: 99 }
        p.x == 1
    }
    then "with expression creates new value" {
        let p = Point { x: 1, y: 2 }
        let p2 = p with { x: 99 }
        p2.x == 99
    }
    then "mut with null coalesce present" {
        mut result = 0
        result = maybe(42) ?? -1
        result == 42
    }
    then "mut with null coalesce absent" {
        mut result = 0
        result = maybe(-5) ?? -1
        result == -1
    }
}
