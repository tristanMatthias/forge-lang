type Point = { x: int, y: int }

fn counter() -> int {
    mut n = 0
    for i in 0..10 {
        n = n + 1
    }
    n
}

spec "immutability" {
    then "mut allows reassignment" {
        mut x = 5
        x = 10
        x == 10
    }
    then "let with complex initializer" {
        let y = 3 + 4 * 2
        y == 11
    }
    then "mut in for loop" {
        mut sum = 0
        for i in 0..5 {
            sum = sum + i
        }
        sum == 10
    }
    then "mut struct field assignment" {
        mut p = Point { x: 1, y: 2 }
        p.x = 99
        p.x == 99
    }
    then "mut inside function" {
        counter() == 10
    }
    then "let in nested scope" {
        let outer = 42
        let inner = outer + 1
        inner == 43
    }
}
