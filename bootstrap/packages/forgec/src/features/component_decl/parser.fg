// WHY: parses component definitions and component block instantiations.
//
// Definition: `component name { config { ... } fn init() { ... } ... }`
// Instantiation (keyword-free): `name instance { config_key value ... }`
//
// When a definition is parsed, the component name is dynamically registered
// in the parser's feature registry. Subsequent code can use `name instance { ... }`
// without the `component` keyword — single-pass, no ambiguity.

use core.ast.{Stmt, Expr, ExprList, SExpr, sexpr_dummy, StmtList, SStmt, sstmt, CompConfigList, CompConfigPairList, ParamList, FieldList, TypeParamList, ValueType, type_expr_to_vtype}
use parse.{Parser}
use core.ast.{Tk}
use core.registry.{register_component_name}

impl Parser {
    // `component name { ... }` — always a definition (no parens)
    fn parse_component_decl(self) -> Stmt? {
        self.advance()  // consume `component`
        let name = self.consume_identifier("expected component name")?

        // Definition: `component name {` ...
        if self.check(Tk.LeftBrace) {
            return self.parse_component_def(name)
        }

        // Legacy: `component name(params) {` — still supported for backward compat
        if self.check(Tk.LeftParen) {
            self.advance()
            let params = self.parse_param_list()?
            if !self.consume(Tk.RightParen, "expected `)` after component params") { return null }
            if !self.consume(Tk.LeftBrace, "expected `{` after component header") { return null }
            let config = if self.check(Tk.Identifier) && self.current_lexeme == "config" {
                self.advance()
                if !self.consume(Tk.LeftBrace, "expected `{` after `config`") { return null }
                let c = self.parse_comp_config_schema()?
                if !self.consume(Tk.RightBrace, "expected `}` after config entries") { return null }
                c
            } else { CompConfigList.End }
            let body = self.parse_comp_def_body()?
            if !self.consume(Tk.RightBrace, "expected `}` at end of component") { return null }
            return Stmt.ComponentDef(name, params, config, body)
        }

        // Legacy: `component comp instance {` — block with keyword prefix
        if self.check(Tk.Identifier) {
            let instance = self.current_lexeme
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after instance name") { return null }
            let config = self.parse_comp_config_pairs()?
            let body = self.parse_comp_block_body()?
            if !self.consume(Tk.RightBrace, "expected `}` at end of component block") { return null }
            return Stmt.ComponentBlock(name, instance, config, body)
        }

        self.set_error("expected `{` after component name")
        null
    }

    // Keyword-free instantiation: `comp_name inst_name { ... }`
    // Called from parse_declaration when a registered component name is detected.
    fn parse_component_block_bare(self) -> Stmt? {
        let name = self.consume_identifier("expected component name")?
        let instance = self.consume_identifier("expected instance name")?
        if !self.consume(Tk.LeftBrace, "expected `{` after instance name") { return null }
        let config = self.parse_comp_config_pairs()?
        let body = self.parse_comp_block_body()?
        if !self.consume(Tk.RightBrace, "expected `}` at end of component block") { return null }
        Stmt.ComponentBlock(name, instance, config, body)
    }

    // ── Component Definition ──

    fn parse_component_def(self, name: string) -> Stmt? {
        // `component name {` — no parens, self.name is implicit
        if !self.consume(Tk.LeftBrace, "expected `{` after component name") {
            return null
        }
        let config = if self.check(Tk.Identifier) && self.current_lexeme == "config" {
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after `config`") {
                return null
            }
            let c = self.parse_comp_config_schema()?
            if !self.consume(Tk.RightBrace, "expected `}` after config entries") {
                return null
            }
            c
        } else {
            CompConfigList.End
        }
        let body = self.parse_comp_def_body()?
        if !self.consume(Tk.RightBrace, "expected `}` at end of component") {
            return null
        }
        // Register this component name for keyword-free instantiation
        register_component_name(self.features, name, (p: Parser) -> p.parse_component_block_bare())
        Stmt.ComponentDef(name, ParamList.End, config, body)
    }

    // ── Config Schema (definition) ──

    fn parse_comp_config_schema(self) -> CompConfigList? {
        if self.check(Tk.RightBrace) { return CompConfigList.End }
        let key = self.consume_identifier("expected config key")?
        if !self.consume(Tk.Colon, "expected `:` after config key") { return null }
        let te = self.parse_type_expr("expected config type")?
        let vt = type_expr_to_vtype(te)
        let default_val = if self.check(Tk.Equal) {
            self.advance()
            let dv = self.parse_expression()?
            dv
        } else {
            null
        }
        // Skip optional annotations like @default
        while self.check(Tk.At) {
            self.advance()
            if self.check(Tk.Identifier) { self.advance() }
        }
        if self.check(Tk.Comma) { self.advance() }
        let rest = self.parse_comp_config_schema()?
        CompConfigList.Node(key, vt, default_val, rest)
    }

    // ── Definition Body ──

    fn parse_comp_def_body(self) -> StmtList? {
        if self.check(Tk.RightBrace) { return StmtList.End }
        let line = self.current_line
        let col = self.current_column

        // `on event_name { ... }` → fn __on_event_name
        if self.check(Tk.Identifier) && self.current_lexeme == "on" {
            self.advance()
            let event_name = self.consume_identifier("expected event name after `on`")?
            if !self.consume(Tk.LeftBrace, "expected `{` after event name") { return null }
            let body = self.parse_statement_list(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after event body") { return null }
            let stmt = Stmt.Function("__on_${event_name}", TypeParamList.End, ParamList.End, ValueType.Void, body)
            let rest = self.parse_comp_def_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // `event name(params)` → fn __event_name
        if self.check(Tk.Identifier) && self.current_lexeme == "event" {
            self.advance()
            let ev_name = self.consume_identifier("expected event name")?
            let ev_params = if self.check(Tk.LeftParen) {
                self.advance()
                let p = self.parse_param_list()?
                if !self.consume(Tk.RightParen, "expected `)` after event params") { return null }
                p
            } else { ParamList.End }
            let stmt = Stmt.Function("__event_${ev_name}", TypeParamList.End, ev_params, ValueType.Void, StmtList.End)
            let rest = self.parse_comp_def_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // `let field: type = init`
        if self.check(Tk.KwLet) {
            self.advance()
            let field_name = self.consume_identifier("expected field name")?
            if !self.consume(Tk.Colon, "expected `:` after field name") { return null }
            let te = self.parse_type_expr("expected field type")?
            let vt = type_expr_to_vtype(te)
            let init = if self.check(Tk.Equal) {
                self.advance()
                let v = self.parse_expression()?
                v
            } else { Expr.Null }
            let stmt = Stmt.Let(field_name, vt, init)
            let rest = self.parse_comp_def_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // Regular statement (fn declarations, etc.)
        let stmt = self.parse_declaration()
        if stmt == null { return null }
        let rest = self.parse_comp_def_body()?
        StmtList.Node(sstmt(stmt!, line, col), rest)
    }

    // ── Component Block Body ──

    // Parse config pairs: `key value` where value is a literal.
    // Uses character-level peek to decide without consuming tokens.
    fn parse_comp_config_pairs(self) -> CompConfigPairList? {
        if self.check(Tk.RightBrace) { return CompConfigPairList.End }
        if self.check(Tk.KwFn) || self.check(Tk.KwComponent) || self.check(Tk.KwLet) {
            return CompConfigPairList.End
        }
        if !self.check(Tk.Identifier) { return CompConfigPairList.End }
        let key = self.current_lexeme
        if key == "on" { return CompConfigPairList.End }
        // Peek at what follows the identifier (without consuming)
        if self.peek_after_ident_is_brace() {
            return CompConfigPairList.End  // nested block
        }
        // Check if next char is a quote (string literal) or digit (number)
        if self.peek_after_ident_is_string() || self.peek_after_ident_is_number() {
            self.advance()  // consume key
            let value = self.parse_expression()?
            if self.check(Tk.Comma) { self.advance() }
            let rest = self.parse_comp_config_pairs()?
            return CompConfigPairList.Node(key, value, rest)
        }
        // Check for `true` or `false` keywords after ident
        if self.peek_after_ident_is_keyword("true") || self.peek_after_ident_is_keyword("false") {
            self.advance()  // consume key
            let value = self.parse_expression()?
            if self.check(Tk.Comma) { self.advance() }
            let rest = self.parse_comp_config_pairs()?
            return CompConfigPairList.Node(key, value, rest)
        }
        // Anything else (identifier, etc.) → end of config pairs
        CompConfigPairList.End
    }

    fn peek_after_ident_is_string(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == "\""
            }
            i = i + 1
        }
        false
    }

    fn peek_after_ident_is_number(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch >= "0" && ch <= "9"
            }
            i = i + 1
        }
        false
    }

    // Check if the text after whitespace matches a specific keyword
    fn peek_after_ident_is_keyword(self, keyword: string) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        // Skip whitespace
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                // Check if the text starting here matches the keyword
                if i + keyword.length <= self.source.length {
                    return self.source.substring(i, i + keyword.length) == keyword
                }
                return false
            }
            i = i + 1
        }
        false
    }

    // Peek: is the next non-whitespace char after current token a `{`?
    fn peek_after_ident_is_brace(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == "{"
            }
            i = i + 1
        }
        false
    }

    // Peek: is the next non-whitespace token an identifier (not a keyword like true/false)?
    fn peek_after_ident_is_ident(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        // Skip whitespace
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                // Must be a letter or underscore (identifier start)
                let is_alpha = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
                if !is_alpha { return false }
                // Extract the full word to check against keywords
                mut j = i
                while j < self.source.length {
                    let wc = self.source.substring(j, j + 1)
                    let is_alnum = (wc >= "a" && wc <= "z") || (wc >= "A" && wc <= "Z") || (wc >= "0" && wc <= "9") || wc == "_"
                    if !is_alnum { break }
                    j = j + 1
                }
                let word = self.source.substring(i, j)
                // Exclude literal keywords — these are config values, not nested block names
                if word == "true" || word == "false" || word == "null" { return false }
                return true
            }
            i = i + 1
        }
        false
    }

    // Parse block body: nested blocks + on handlers + fn decls + statements
    fn parse_comp_block_body(self) -> StmtList? {
        if self.check(Tk.RightBrace) { return StmtList.End }
        let line = self.current_line
        let col = self.current_column

        // `on event_name(params) { ... }`
        if self.check(Tk.Identifier) && self.current_lexeme == "on" {
            self.advance()
            let event_name = self.consume_identifier("expected event name after `on`")?
            let ev_params = if self.check(Tk.LeftParen) {
                self.advance()
                let p = self.parse_param_list()?
                if !self.consume(Tk.RightParen, "expected `)` after event params") { return null }
                p
            } else { ParamList.End }
            if !self.consume(Tk.LeftBrace, "expected `{` after event handler") { return null }
            let body = self.parse_statement_list(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after event body") { return null }
            let stmt = Stmt.Function("__on_${event_name}", TypeParamList.End, ev_params, ValueType.Void, body)
            let rest = self.parse_comp_block_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // `component ...` keyword for nested blocks
        if self.check(Tk.KwComponent) {
            let stmt = self.parse_component_decl()?
            let rest = self.parse_comp_block_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // Nested block: `ident name { ... }` or `ident { ... }`
        if self.check(Tk.Identifier) && self.peek_after_ident_is_ident() {
            let comp_name = self.current_lexeme
            self.advance()
            let inst_name = self.consume_identifier("expected instance name")?
            if !self.consume(Tk.LeftBrace, "expected `{` after nested block name") { return null }
            let nested_config = self.parse_comp_config_pairs()?
            let nested_body = self.parse_comp_block_body()?
            if !self.consume(Tk.RightBrace, "expected `}` at end of nested block") { return null }
            let stmt = Stmt.ComponentBlock(comp_name, inst_name, nested_config, nested_body)
            let rest = self.parse_comp_block_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        if self.check(Tk.Identifier) && self.peek_after_ident_is_brace() {
            let comp_name = self.current_lexeme
            self.advance()
            self.advance()  // consume {
            let nested_config = self.parse_comp_config_pairs()?
            let nested_body = self.parse_comp_block_body()?
            if !self.consume(Tk.RightBrace, "expected `}` at end of nested block") { return null }
            let stmt = Stmt.ComponentBlock(comp_name, comp_name, nested_config, nested_body)
            let rest = self.parse_comp_block_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // fn declarations and other statements
        let stmt = self.parse_declaration()
        if stmt == null { return null }
        let rest = self.parse_comp_block_body()?
        StmtList.Node(sstmt(stmt!, line, col), rest)
    }
}
