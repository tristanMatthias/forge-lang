// WHY: parses `component name(params) { ... }` definitions.
// Components desugar to struct + impl + factory function.
//
// Syntax:
//   component name(param1, param2) {
//       config { key: type = default_expr }
//       fn init() { ... }
//       fn drop() { ... }
//       fn method(args) -> ret { ... }
//   }

use core.ast.{Stmt, Expr, StmtList, SStmt, sstmt, CompConfigList, CompConfigPairList, ParamList, FieldList, TypeParamList, ValueType, type_expr_to_vtype}
use parse.{Parser}
use core.ast.{Tk}

impl Parser {
    fn parse_component_decl(self) -> Stmt? {
        self.advance()  // consume `component`
        let name = self.consume_identifier("expected component name")?

        // Parse parameter list: component cli(name) { ... }
        let params = if self.check(Tk.LeftParen) {
            self.advance()
            let p = self.parse_param_list()?
            if !self.consume(Tk.RightParen, "expected `)` after component params") {
                return null
            }
            p
        } else {
            ParamList.End
        }

        if !self.consume(Tk.LeftBrace, "expected `{` after component header") {
            return null
        }

        // Parse config block if present
        let config = if self.check(Tk.Identifier) && self.current_lexeme == "config" {
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after `config`") {
                return null
            }
            let c = self.parse_comp_config_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after config entries") {
                return null
            }
            c
        } else {
            CompConfigList.End
        }

        // Parse body: fn declarations and other statements
        let body = self.parse_comp_body()?

        if !self.consume(Tk.RightBrace, "expected `}` at end of component") {
            return null
        }

        Stmt.ComponentDef(name, params, config, body)
    }

    // Parse config entries: key: type = default_expr
    fn parse_comp_config_list(self) -> CompConfigList? {
        if self.check(Tk.RightBrace) {
            return CompConfigList.End
        }
        let key = self.consume_identifier("expected config key")?
        if !self.consume(Tk.Colon, "expected `:` after config key") {
            return null
        }
        let te = self.parse_type_expr("expected config type")?
        let vt = type_expr_to_vtype(te)
        // Optional default: = expr
        let default_val = if self.check(Tk.Equal) {
            self.advance()
            let dv = self.parse_expression()?
            dv
        } else {
            null
        }
        // Skip optional annotations like @default
        while self.check(Tk.At) {
            self.advance()
            if self.check(Tk.Identifier) { self.advance() }
        }
        if self.check(Tk.Comma) { self.advance() }
        let rest = self.parse_comp_config_list()?
        CompConfigList.Node(key, vt, default_val, rest)
    }

    // Parse component body: a sequence of statements (fn decls, etc.)
    fn parse_comp_body(self) -> StmtList? {
        if self.check(Tk.RightBrace) {
            return StmtList.End
        }
        let line = self.current_line
        let col = self.current_column

        // Handle `on after_children { ... }` as a fn named __after_children
        if self.check(Tk.Identifier) && self.current_lexeme == "on" {
            self.advance()
            let event_name = self.consume_identifier("expected event name after `on`")?
            if !self.consume(Tk.LeftBrace, "expected `{` after event name") {
                return null
            }
            let body = self.parse_statement_list(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after event body") {
                return null
            }
            let fn_name = "__on_${event_name}"
            let stmt = Stmt.Function(fn_name, TypeParamList.End, ParamList.End, ValueType.Void, body)
            let rest = self.parse_comp_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // Handle `event name(params)` declarations
        if self.check(Tk.Identifier) && self.current_lexeme == "event" {
            self.advance()
            let ev_name = self.consume_identifier("expected event name")?
            let ev_params = if self.check(Tk.LeftParen) {
                self.advance()
                let p = self.parse_param_list()?
                if !self.consume(Tk.RightParen, "expected `)` after event params") {
                    return null
                }
                p
            } else {
                ParamList.End
            }
            // Store as a function declaration with __event_ prefix
            let stmt = Stmt.Function("__event_${ev_name}", TypeParamList.End, ev_params, ValueType.Void, StmtList.End)
            let rest = self.parse_comp_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // Handle `let field: type` declarations
        if self.check(Tk.KwLet) {
            self.advance()
            let field_name = self.consume_identifier("expected field name")?
            if !self.consume(Tk.Colon, "expected `:` after field name") {
                return null
            }
            let te = self.parse_type_expr("expected field type")?
            let vt = type_expr_to_vtype(te)
            let init = if self.check(Tk.Equal) {
                self.advance()
                let v = self.parse_expression()?
                v
            } else {
                Expr.Null
            }
            let stmt = Stmt.Let(field_name, vt, init)
            let rest = self.parse_comp_body()?
            return StmtList.Node(sstmt(stmt, line, col), rest)
        }

        // Regular statement parsing (fn declarations, etc.)
        let stmt = self.parse_declaration()
        if stmt == null { return null }
        let rest = self.parse_comp_body()?
        StmtList.Node(sstmt(stmt!, line, col), rest)
    }
}
