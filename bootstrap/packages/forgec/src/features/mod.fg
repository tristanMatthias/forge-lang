// WHY: aggregator for all language features. Each subdirectory is
// one feature with its own parser.fg, codegen.fg, example.fg.
//
// Features whose name collides with a reserved keyword (return, if,
// while, let, mut, fn, struct, enum, impl, extern, break, continue)
// use a `_stmt` or `_decl` suffix in the directory name.

mod match_expr
mod return_stmt
mod if_stmt
mod while_stmt
mod for_stmt
mod extern_decl
mod let_stmt
mod fn_decl
mod struct_decl
mod enum_decl
mod impl_decl
mod generics
mod error_propagation
mod null_safety
mod trait_decl
mod tuples
mod with_expr
mod list_lit
mod closures
mod map_lit
mod defer_stmt
mod is_keyword
mod in_operator
mod spec_test
mod select_stmt
mod parallel_stmt
mod spawn_expr
mod modules
mod eval
mod union_type
mod component_decl
use features.closures.{init_closures}
use features.defer_stmt.{init_defer_stmt}
use features.enum_decl.{init_enum_decl}
use features.extern_decl.{init_extern_decl}
use features.fn_decl.{init_fn_decl}
use features.for_stmt.{init_for_stmt}
use features.if_stmt.{init_if_stmt}
use features.impl_decl.{init_impl_decl}
use features.is_keyword.{init_is_keyword}
use features.in_operator.{init_in_operator}
use features.let_stmt.{init_let_stmt}
use features.list_lit.{init_list_lit}
use features.map_lit.{init_map_lit}
use features.match_expr.{init_match_expr}
use features.modules.{init_modules}
use features.null_safety.{init_null_safety}
use features.parallel_stmt.{init_parallel_stmt}
use features.spawn_expr.{init_spawn_expr}
use features.return_stmt.{init_return_stmt}
use features.select_stmt.{init_select_stmt}
use features.spec_test.{init_spec_test}
use features.struct_decl.{init_struct_decl}
use features.trait_decl.{init_trait_decl}
use features.tuples.{init_tuples}
use features.while_stmt.{init_while_stmt}
use features.with_expr.{init_with_expr}
use features.component_decl.{init_component_decl}
use core.registry.{feature_new, register, noop_emit_expr, noop_emit_stmt, noop_resolve_expr, noop_resolve_stmt, noop_check_expr, noop_check_stmt, noop_eval_expr, noop_eval_stmt, noop_parse}

// ── Feature registration components ──
// Declarative way to define and register language features.
//
// Usage in init_features:
//   feature_set all {
//       registry = reg
//       feature defer {
//           stmt_tag = Stmt.Defer(Expr.Null)
//           stmt_keyword = "kw_defer"
//           parse_stmt = (p: Parser) -> p.parse_defer_statement()
//           emit_stmt = defer_emit_stmt
//           resolve_stmt = my_resolve_fn
//           check_stmt = my_check_fn
//       }
//   }

component feature_set {
    config {
        registry: int = 0
    }
    fn init() {
        self.__parent = self.config.registry
    }
}

component feature {
    config {
        stmt_tag: Stmt? = null
        expr_tag: Expr? = null
        stmt_keyword: string = ""
        decl_keyword: string = ""
        parse_stmt: int = noop_parse
        parse_decl: int = noop_parse
        emit_expr: int = noop_emit_expr
        emit_stmt: int = noop_emit_stmt
        resolve_expr: int = noop_resolve_expr
        resolve_stmt: int = noop_resolve_stmt
        check_expr: int = noop_check_expr
        check_stmt: int = noop_check_stmt
        eval_expr: int = noop_eval_expr
        eval_stmt: int = noop_eval_stmt
    }
    fn init() {
        let f = feature_new(self.name) with {
            stmt_tag: self.config.stmt_tag,
            expr_tag: self.config.expr_tag,
            stmt_keyword: self.config.stmt_keyword,
            decl_keyword: self.config.decl_keyword,
            parse_stmt: self.config.parse_stmt,
            parse_decl: self.config.parse_decl,
            emit_expr: self.config.emit_expr,
            emit_stmt: self.config.emit_stmt,
            resolve_expr: self.config.resolve_expr,
            resolve_stmt: self.config.resolve_stmt,
            check_expr: self.config.check_expr,
            check_stmt: self.config.check_stmt,
            eval_expr: self.config.eval_expr,
            eval_stmt: self.config.eval_stmt,
        }
        register(self.__parent, f)
    }
}

export fn init_features(reg: Registry) {
    init_defer_stmt(reg)
    init_if_stmt(reg)
    init_match_expr(reg)
    init_struct_decl(reg)
    init_null_safety(reg)
    init_tuples(reg)
    init_with_expr(reg)
    init_list_lit(reg)
    init_closures(reg)
    init_map_lit(reg)
    init_is_keyword(reg)
    init_in_operator(reg)
    init_while_stmt(reg)
    init_for_stmt(reg)
    init_let_stmt(reg)
    init_spec_test(reg)
    init_select_stmt(reg)
    init_parallel_stmt(reg)
    init_spawn_expr(reg)
    init_fn_decl(reg)
    init_enum_decl(reg)
    init_impl_decl(reg)
    init_extern_decl(reg)
    init_trait_decl(reg)
    init_return_stmt(reg)
    init_modules(reg)
    init_component_decl(reg)
}
