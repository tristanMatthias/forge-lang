spec "force unwrap" {
    then "unwrap int" {
        avra_test_capture_start()
        let x = 42
        let y = x!
        y |> string |> println
        let out = avra_test_capture_stop()
        out == "42"
    }
    then "unwrap string" {
        avra_test_capture_start()
        let s = "hello"
        let s2 = s!
        println(s2)
        let out = avra_test_capture_stop()
        out == "hello"
    }
    then "chained unwrap" {
        avra_test_capture_start()
        let z = 99!!!!
        z |> string |> println
        let out = avra_test_capture_stop()
        out == "99"
    }
}
