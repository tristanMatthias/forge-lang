mod codegen
use core.ast.{vtype_tuple_at}
use codegen.types.{err_emit}
use core.registry.{feature_new, Feature}
use resolve.{resolve_expr, resolve_expr_list}
use features.tuples.codegen.{emit_tuple, emit_tuple_index}
use typeck.{check_expr, check_expr_list_types, tc_er}

export fn tuple_feature() -> Feature {
    feature_new("tuple") with {
        expr_tag: Expr.Tuple(ExprList.End),
        emit_expr: tuple_emit,
        resolve_expr: tuple_resolve,
        check_expr: tuple_check,
    }
}

export fn tuple_index_feature() -> Feature {
    feature_new("tuple_index") with {
        expr_tag: Expr.TupleIndex(Expr.Null, 0),
        emit_expr: tuple_index_emit,
        resolve_expr: tuple_index_resolve,
        check_expr: tuple_index_check,
    }
}

fn tuple_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Tuple(elements) -> emit_tuple(ctx, env, elements)
        _ -> err_emit("expected Tuple")
    }
}

fn tuple_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .Tuple(elements) -> resolve_expr_list(r, elements)
        _ -> r
    }
}

fn tuple_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Tuple(elements) -> {
            let pair = check_expr_list_types(tc, elements)
            tc_er(pair.tc, .Tuple(pair.types))
        }
        _ -> tc_er(tc, .Unknown)
    }
}


fn tuple_index_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .TupleIndex(obj, idx) -> emit_tuple_index(ctx, env, obj, idx)
        _ -> err_emit("expected TupleIndex")
    }
}

fn tuple_index_resolve(r: Resolver, expr: Expr) -> Resolver {
    match expr {
        .TupleIndex(obj, _) -> resolve_expr(r, obj)
        _ -> r
    }
}

fn tuple_index_check(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .TupleIndex(obj, idx) -> {
            let o = check_expr(tc, obj)
            tc_er(o.tc, vtype_tuple_at(o.ty, idx))
        }
        _ -> tc_er(tc, .Unknown)
    }
}
