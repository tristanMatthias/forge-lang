enum Color {
    Red
    Green
    Blue(shade: int)
}

fn describe(c: Color) -> string {
    match c {
        .Red -> "red"
        .Green -> "green"
        .Blue(s) -> "blue"
        _ -> "unknown"
    }
}

fn main() {
    println(describe(Color.Red))
    println(describe(Color.Green))
    println(describe(Color.Blue(42)))
}
