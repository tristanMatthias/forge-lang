// WHY: type checking for match statements and expressions.
// Exhaustiveness checking, pattern variable binding, arm type unification.

use core.ast.{Expr, Pattern, PatternList, MatchArmList, TypeList, WhenArmList, ParamList, Stmt, StmtList, VariantList, ValueType, stmt_unwrap, vtype_display, vtype_enum_name, vtype_eq, vtype_is_unknown, vtype_is_union, vtype_union_types}
use diagnostics.{DiagCode, diag_warning, span_new, bag_report}
use typeck.{EnumTypeReg, ExprResult, TC, check_expr, tc_bind, tc_check_explicit_returns, tc_enter, tc_er, tc_exit, tc_report, resolve_vtype}
use core.ast.{vtype_from_name}

// ── Divergence detection ──
// An arm that diverges (return/break/continue) never produces a value
// for the enclosing expression context and should not participate in
// match arm type unification.

fn stmts_diverges(stmts: StmtList) -> bool {
    match stmts {
        .End -> false
        .Node(ss, next) -> {
            match next {
                .End -> stmt_diverges(stmt_unwrap(ss.node))
                _ -> stmts_diverges(next)
            }
        }
    }
}

fn stmt_diverges(stmt: Stmt) -> bool {
    match stmt {
        .Return(_) -> true
        .ReturnEmpty -> true
        .Break -> true
        .Continue -> true
        .Block(body) -> stmts_diverges(body)
        .Expr(e) -> expr_diverges(e)
        .If(_, then_b, else_b) -> {
            if else_b == null { return false }
            stmt_diverges(then_b) && stmt_diverges(else_b!)
        }
        _ -> false
    }
}

fn expr_diverges(body: Expr) -> bool {
    match body {
        .Block(stmts) -> stmts_diverges(stmts)
        _ -> false
    }
}

// ── Arm type skip logic ──
// An arm's inferred type should be skipped in type unification when:
// - The arm diverges (return/break/continue at the end)
// - The arm's type is Void (side-effecting expression, no value produced)
// - The arm's type is Unknown (type checker's sentinel for unresolved expressions)
// - The arm's type is an unresolved named type (empty name from inference gaps)

fn arm_type_skip(body: Expr, ty: ValueType) -> bool {
    if expr_diverges(body) { return true }
    if vtype_eq(ty, .Void) { return true }
    if vtype_is_unknown(ty) { return true }
    match ty {
        .Struct(name) -> name == ""
        .Enum(name, _) -> name == ""
        _ -> false
    }
}

// ── Exhaustiveness checking ──

fn enum_type_variants(reg: EnumTypeReg, name: string) -> VariantList {
    match reg {
        .End -> VariantList.End
        .Node(n, variants, _) if n == name -> variants
        .Node(_, _, next) -> enum_type_variants(next, name)
    }
}

fn arms_has_wildcard(arms: MatchArmList) -> bool {
    match arms {
        .End -> false
        .Node(pattern, _, _, next) -> {
            match pattern {
                .Wildcard -> true
                _ -> arms_has_wildcard(next)
            }
        }
    }
}

fn arms_matched_variants(arms: MatchArmList) -> string {
    match arms {
        .End -> ""
        .Node(pattern, _, _, next) -> {
            let rest = arms_matched_variants(next)
            let vnames = pattern_variant_names(pattern)
            if vnames == "" { return rest }
            if rest == "" { vnames } else { "${rest}|${vnames}" }
        }
    }
}

// Collect all variant names covered by a pattern (handles Or chains).
fn pattern_variant_names(pattern: Pattern) -> string {
    match pattern {
        .Variant(name, _) -> name
        .NestedVariant(name, _) -> name
        .TypePattern(type_name, _) -> type_name
        .Or(left, right) -> {
            let l = pattern_variant_names(left)
            let r = pattern_variant_names(right)
            if l == "" { r } else if r == "" { l } else { "${l}|${r}" }
        }
        _ -> ""
    }
}

fn variant_in_matched(name: string, matched: string) -> bool {
    if matched == name { return true }
    if matched.contains("|${name}|") { return true }
    if matched.length >= name.length + 1 {
        if matched.substring(0, name.length + 1) == "${name}|" { return true }
        if matched.substring(matched.length - name.length - 1, matched.length) == "|${name}" { return true }
    }
    // Module-qualified name: check short form
    if name.contains("::") {
        let parts = name.split("::")
        return variant_in_matched(parts[parts.length - 1], matched)
    }
    false
}

fn find_missing_variants(variants: VariantList, matched: string) -> string {
    match variants {
        .End -> ""
        .Node(name, _, next) -> {
            let rest = find_missing_variants(next, matched)
            if variant_in_matched(name, matched) {
                rest
            } else {
                if rest == "" { ".${name}" } else { "${rest}, .${name}" }
            }
        }
    }
}

export fn tc_check_exhaustive(tc: TC, subject_ty: ValueType, arms: MatchArmList) -> TC {
    // Union exhaustiveness: check all member types are covered
    if vtype_is_union(subject_ty) {
        return tc_check_union_exhaustive(tc, subject_ty, arms)
    }
    let enum_name = vtype_enum_name(subject_ty)
    if enum_name == "" { return tc }
    let variants = enum_type_variants(tc.enums, enum_name)
    match variants { .End -> return tc, _ -> {} }
    let matched = arms_matched_variants(arms)
    let missing = find_missing_variants(variants, matched)
    if missing == "" { return tc }
    if tc.current_line == 0 { return tc }
    // Spec Axis 8.7: wildcard hiding >2 variants = warning (not error)
    if arms_has_wildcard(arms) {
        let hidden_count = count_missing(variants, matched)
        if hidden_count > 2 {
            let sp = span_new(0, 6 + enum_name.length, tc.current_line, tc.current_col)
            let msg = "wildcard arm hides ${string(hidden_count)} variants of `${enum_name}`: ${missing}"
            let diag = diag_warning(DiagCode.NonExhaustiveMatch, msg, sp)
            return tc with { bag: bag_report(tc.bag, diag) }
        }
        return tc
    }
    // No wildcard and missing variants = error (spec Axis 8.4)
    let msg = "non-exhaustive match on `${enum_name}` — missing: ${missing}"
    tc_report(tc, DiagCode.NonExhaustiveMatch, msg)
}

fn count_missing(variants: VariantList, matched: string) -> int {
    match variants {
        .End -> 0
        .Node(name, _, next) -> {
            if variant_in_matched(name, matched) {
                count_missing(next, matched)
            } else {
                1 + count_missing(next, matched)
            }
        }
    }
}

// ── Union exhaustiveness ──

fn tc_check_union_exhaustive(tc: TC, subject_ty: ValueType, arms: MatchArmList) -> TC {
    let types = vtype_union_types(subject_ty)
    let matched = arms_matched_variants(arms)
    let missing = find_missing_union_members(types, matched)
    if missing == "" { return tc }
    if tc.current_line == 0 { return tc }
    if arms_has_wildcard(arms) {
        let hidden_count = count_missing_union_members(types, matched)
        if hidden_count > 2 {
            let type_str = vtype_display(subject_ty)
            let sp = span_new(0, 6 + type_str.length, tc.current_line, tc.current_col)
            let msg = "wildcard arm hides ${string(hidden_count)} members of `${type_str}`: ${missing}"
            let diag = diag_warning(DiagCode.NonExhaustiveMatch, msg, sp)
            return tc with { bag: bag_report(tc.bag, diag) }
        }
        return tc
    }
    let type_str = vtype_display(subject_ty)
    let msg = "non-exhaustive match on `${type_str}` — missing: ${missing}"
    tc_report(tc, DiagCode.NonExhaustiveMatch, msg)
}

fn find_missing_union_members(types: TypeList, matched: string) -> string {
    match types {
        .End -> ""
        .Node(ty, next) -> {
            let name = vtype_display(ty)
            let rest = find_missing_union_members(next, matched)
            if variant_in_matched(name, matched) {
                rest
            } else {
                if rest == "" { name } else { "${name}, ${rest}" }
            }
        }
    }
}

fn count_missing_union_members(types: TypeList, matched: string) -> int {
    match types {
        .End -> 0
        .Node(ty, next) -> {
            let name = vtype_display(ty)
            if variant_in_matched(name, matched) {
                count_missing_union_members(next, matched)
            } else {
                1 + count_missing_union_members(next, matched)
            }
        }
    }
}

// ── Pattern variable binding ──

fn tc_bind_pattern(tc: TC, pattern: Pattern) -> TC {
    match pattern {
        .Wildcard -> tc
        .Variant(_, bindings) -> tc_bind_pattern_params(tc, bindings)
        .NestedVariant(_, sub_pats) -> tc_bind_pattern_list(tc, sub_pats)
        .TypePattern(type_name, binding) -> tc_bind(tc, binding, resolve_vtype(tc, vtype_from_name(type_name)))
        _ -> tc  // LitString, LitInt, LitBool, LitFloat — no bindings
    }
}

export fn tc_enter_pattern_scope(tc: TC, pattern: Pattern) -> TC {
    tc_bind_pattern(tc_enter(tc), pattern)
}

fn tc_bind_pattern_list(tc: TC, pats: PatternList) -> TC {
    match pats {
        .End -> tc
        .Node(p, next) -> tc_bind_pattern_list(tc_bind_pattern(tc, p), next)
    }
}

fn tc_bind_pattern_params(tc: TC, params: ParamList) -> TC {
    match params {
        .End -> tc
        .Node(name, _, next) -> {
            if name == "_" { return tc_bind_pattern_params(tc, next) }
            tc_bind_pattern_params(tc_bind(tc, name, .Unknown), next)
        }
    }
}

// ── Match arm checking ──

export fn check_match_arms(tc: TC, arms: MatchArmList) -> TC {
    match arms {
        .End -> tc
        .Node(pattern, guard, body, next) -> {
            let with_bindings = tc_enter_pattern_scope(tc, pattern)
            let with_guard = if guard != null {
                let g = check_expr(with_bindings, guard!.node)
                g.tc
            } else { with_bindings }
            let b = check_expr(with_guard, body.node)
            let after = tc_exit(b.tc)
            check_match_arms(after, next)
        }
    }
}

// ── Match expression type inference ──

export fn check_match_expr_arms(tc: TC, arms: MatchArmList, first_ty: ValueType) -> ExprResult {
    match arms {
        .End -> tc_er(tc, first_ty)
        .Node(pattern, guard, body, next) -> {
            let with_bindings = tc_enter_pattern_scope(tc, pattern)
            let with_guard = if guard != null {
                let g = check_expr(with_bindings, guard!.node)
                g.tc
            } else { with_bindings }
            let b = check_expr(with_guard, body.node)
            let after = tc_exit(b.tc)
            if arm_type_skip(body.node, b.ty) {
                return check_match_expr_arms(after, next, first_ty)
            }
            let checked_after = if !arm_type_skip(body.node, first_ty) && !vtype_eq(first_ty, b.ty) {
                let msg = "match expression arms have different types: `${vtype_display(first_ty)}` vs `${vtype_display(b.ty)}`"
                tc_report(after, DiagCode.TypeMismatch, msg)
            } else { after }
            check_match_expr_arms(checked_after, next, first_ty)
        }
    }
}

export fn check_match_expr_infer(tc: TC, arms: MatchArmList) -> ExprResult {
    match arms {
        .End -> tc_er(tc, .Unknown)
        .Node(pattern, guard, body, next) -> {
            let with_bindings = tc_enter_pattern_scope(tc, pattern)
            let with_guard = if guard != null {
                let g = check_expr(with_bindings, guard!.node)
                g.tc
            } else { with_bindings }
            let b = check_expr(with_guard, body.node)
            let after = tc_exit(b.tc)
            // If the first arm doesn't produce a usable type, infer from next arm
            if arm_type_skip(body.node, b.ty) {
                return check_match_expr_infer(after, next)
            }
            check_match_expr_arms(after, next, b.ty)
        }
    }
}

// ── Return type checking in match arms ──

export fn tc_check_match_arm_returns(tc: TC, fn_name: string, declared: ValueType, arms: MatchArmList) -> TC {
    match arms {
        .End -> tc
        .Node(_, _, body, next) -> {
            let after = match body.node {
                .Block(stmts) -> tc_check_explicit_returns(tc, fn_name, declared, stmts)
                _ -> tc
            }
            tc_check_match_arm_returns(after, fn_name, declared, next)
        }
    }
}

// ── When expression type checking ──
// Each condition must be bool-ish; return type unified across arms.

export fn check_when_expr(tc: TC, arms: WhenArmList) -> ExprResult {
    match arms {
        .End -> tc_er(tc, .Unknown)
        .Node(cond, body, next) -> {
            let after_cond = if cond == null { tc } else { check_expr(tc, cond!.node).tc }
            let b = check_expr(after_cond, body.node)
            check_when_arms(b.tc, next, b.ty)
        }
    }
}

fn check_when_arms(tc: TC, arms: WhenArmList, first_ty: ValueType) -> ExprResult {
    match arms {
        .End -> tc_er(tc, first_ty)
        .Node(cond, body, next) -> {
            let after_cond = if cond == null { tc } else { check_expr(tc, cond!.node).tc }
            let b = check_expr(after_cond, body.node)
            if arm_type_skip(body.node, b.ty) {
                return check_when_arms(b.tc, next, first_ty)
            }
            let checked_tc = if !arm_type_skip(body.node, first_ty) && !vtype_eq(first_ty, b.ty) {
                let msg = "match expression arms have different types: `${vtype_display(first_ty)}` vs `${vtype_display(b.ty)}`"
                tc_report(b.tc, DiagCode.TypeMismatch, msg)
            } else { b.tc }
            check_when_arms(checked_tc, next, first_ty)
        }
    }
}
