// WHY: codegen for map literals {"key": value, ...} and map operations.
// Maps are backed by the C-runtime forge_map_*_cstr functions.

use core.ast.{Expr, ExprList, VarEnv, ValueType}
use codegen.types.{Ctx, EmitValue, ok_emit, ok_emit_typed, err_emit}
use codegen.helpers.{emit_single_arg}

export fn emit_map_lit(ctx: Ctx, env: VarEnv, entries: ExprList) -> Result<EmitValue, string> {
    let map = ctx.call("forge_map_new_cstr", [])
    insert_map_entries(ctx, env, entries, map)
}

fn insert_map_entries(ctx: Ctx, env: VarEnv, entries: ExprList, map: ptr) -> Result<EmitValue, string> {
    match entries {
        .End -> ok_emit_typed(map, .Map)
        .Node(se_key, rest) -> {
            let key_r = ctx.emit(env, se_key.node)?
            match rest {
                .End -> err_emit("map literal has key without value")
                .Node(se_val, remaining) -> {
                    let val_r = ctx.emit(env, se_val.node)?
                    ctx.call("forge_map_set_cstr", [map, ctx.to_ptr(key_r.value, "map_key"), val_r.value])
                    insert_map_entries(ctx, env, remaining, map)
                }
            }
        }
    }
}

export fn emit_map_method_call(ctx: Ctx, env: VarEnv, map_ptr: ptr, method: string, args: ExprList) -> Result<EmitValue, string> {
    match method {
        "get" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            return ok_emit_typed(ctx.call("forge_map_get_cstr", [map_ptr, ctx.to_ptr(arg_r.value, "map_key")]), .Int)
        }
        "has" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            return ok_emit_typed(ctx.call("forge_map_has_cstr", [map_ptr, ctx.to_ptr(arg_r.value, "map_key")]), .Bool)
        }
        "set" -> return emit_map_set(ctx, env, map_ptr, args)
        "len" or "length" -> return ok_emit_typed(ctx.call("forge_map_len_cstr", [map_ptr]), .Int)
        "keys" -> return ok_emit_typed(ctx.call("forge_map_keys_cstr", [map_ptr]), .List(.Str))
        "values" -> return ok_emit_typed(ctx.call("forge_map_values_cstr", [map_ptr]), .List(.Unknown))
        "remove" -> {
            let arg_r = emit_single_arg(ctx, env, args)?
            return ok_emit_typed(ctx.call("forge_map_remove_cstr", [map_ptr, ctx.to_ptr(arg_r.value, "map_key")]), .Void)
        }
        _ -> err_emit("map method `${method}` not implemented")
    }
}

fn emit_map_set(ctx: Ctx, env: VarEnv, map: ptr, args: ExprList) -> Result<EmitValue, string> {
    match args {
        .Node(se_key, rest) -> {
            match rest {
                .Node(se_val, _) -> {
                    let key_r = ctx.emit(env, se_key.node)?
                    let val_r = ctx.emit(env, se_val.node)?
                    let key_ptr = ctx.to_ptr(key_r.value, "set_key")
                    ctx.call("forge_map_set_cstr", [map, key_ptr, val_r.value])
                    ok_emit_typed(map, .Map)
                }
                _ -> err_emit("map.set expects 2 arguments: key and value")
            }
        }
        _ -> err_emit("map.set expects 2 arguments: key and value")
    }
}
