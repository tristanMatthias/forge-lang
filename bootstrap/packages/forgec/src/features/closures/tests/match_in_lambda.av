// Regression: match on enum param inside lambda body
// Lambda params default to int; enum-typed params need explicit annotation.
enum Color { Red, Green, Blue }

type Handler = { action: fn(int, Color) -> int }
let h = Handler {
    action: (n: int, c: Color) -> match c {
        .Red -> n * 10
        .Green -> n * 20
        .Blue -> n * 30
    }
}

println(string(h.action(5, Color.Red)))
println(string(h.action(5, Color.Green)))
println(string(h.action(5, Color.Blue)))
