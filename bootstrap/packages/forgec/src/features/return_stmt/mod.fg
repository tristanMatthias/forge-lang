// WHY: aggregator for the return statement feature.
// Named `return_stmt` instead of `return` because `return` is a
// reserved keyword that can't appear in `mod` declarations.

mod parser
use core.registry.{feature_new, register}

export fn init_return_stmt(reg: Registry) {
    let f = feature_new("return_stmt") with {
        stmt_keyword: "kw_return",
        parse_stmt: (p: Parser) -> p.parse_return_statement(),
    }
    register(reg, f)
}
