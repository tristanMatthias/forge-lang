spec "for-in comprehensive" {
    then "basic iteration" {
        avra_test_capture_start()
        let words = ["hello", "world", "forge"]
        for w in words {
            println(w)
        }
        let out = avra_test_capture_stop()
        out == "hello\nworld\nforge"
    }
    then "accumulation" {
        let scores = [10, 20, 30, 40, 50]
        mut total = 0
        for s in scores {
            total = total + s
        }
        total == 150
    }
    then "nested for-in" {
        let rows = [[1, 2], [3, 4], [5, 6]]
        mut flat_sum = 0
        for row in rows {
            for val in row {
                flat_sum = flat_sum + val
            }
        }
        flat_sum == 21
    }
    then "break finds element" {
        mut found = -1
        for x in [10, 20, 30, 40] {
            if x == 30 {
                found = x
                break
            }
        }
        found == 30
    }
    then "continue skips evens" {
        mut odd_sum = 0
        for n in [1, 2, 3, 4, 5, 6, 7] {
            if n % 2 == 0 { continue }
            odd_sum = odd_sum + n
        }
        odd_sum == 16
    }
    then "empty list" {
        mut count = 0
        for x in [] {
            count = count + 1
        }
        count == 0
    }
    then "for-in over mapped list" {
        avra_test_capture_start()
        let nums = [1, 2, 3, 4, 5]
        let doubled = nums.map((x) -> x * 2)
        for d in doubled {
            d |> string |> println
        }
        let out = avra_test_capture_stop()
        out == "2\n4\n6\n8\n10"
    }
}
