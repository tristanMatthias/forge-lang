spec "while break" {
    then "break exits loop early" {
        mut i = 0
        mut sum = 0
        while i < 100 {
            if i == 5 {
                break
            }
            sum = sum + i
            i = i + 1
        }
        sum == 10
    }
    then "counter stops at break point" {
        mut i = 0
        while i < 100 {
            if i == 5 {
                break
            }
            i = i + 1
        }
        i == 5
    }
}
