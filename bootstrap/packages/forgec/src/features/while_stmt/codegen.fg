// WHY: emits LLVM IR for `while cond { body }` with break/continue
// support via the scoped loop stack in Ctx.

use core.ast.{Expr, Stmt, VarEnv}
use codegen.types.{Ctx, LoopStack, StmtResult,  ok_stmt, emit_value_ptr}
use codegen.{emit_expr, emit_stmt, ok_sr, err_sr}

export fn emit_while(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<StmtResult, string> {
    match stmt {
        .While(condition, body) -> emit_while_inner(ctx, env, condition, body)
        _ -> err_sr("expected While")
    }
}

fn emit_while_inner(ctx: Ctx, env: VarEnv, condition: Expr, body: Stmt) -> Result<StmtResult, string> {
    ctx.cov_line()
    let cond_bb = ctx.bb("while.cond")
    let body_bb = ctx.bb("while.body")
    let exit_bb = ctx.bb("while.exit")
    ctx.br(cond_bb)

    ctx.position(cond_bb)
    let cond = ctx.emit(env, condition)?
    let cond_i1 = ctx.truthy(emit_value_ptr(cond), "while_cond")
    ctx.cond_br(cond_i1, body_bb, exit_bb)

    // Scoped loop stack: create a new Ctx with this loop's
    // frame pushed. The body sees it; the outer cg is unchanged.
    ctx.position(body_bb)
    let body_cg = ctx.with_loops(.Frame(cond_bb, exit_bb, ctx.loops))
    let body_sr = emit_stmt(body_cg, env, body)?
    ctx.br_if_open(cond_bb)

    ctx.position(exit_bb)
    ok_sr(ctx, env)
}
