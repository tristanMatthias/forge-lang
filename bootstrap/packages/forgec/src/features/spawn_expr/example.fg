/// expect: hello from spawn
/// expect: after spawn
/// expect: 42
/// expect: result: 99

extern fn forge_thread_join(handle: int)

fn main() {
    let h = spawn {
        println("hello from spawn")
    }
    forge_thread_join(h)
    println("after spawn")

    // spawn with a captured value
    let x = 42
    let h2 = spawn {
        println(string(x))
    }
    forge_thread_join(h2)

    // task.await — spawn returns a task handle, .await joins and returns the result
    let task = spawn { 99 }
    let result = task.await
    println("result: " + string(result))
}
