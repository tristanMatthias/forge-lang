trait Printable {
    fn display(self) -> string
}

type Dog = { name: string }

impl Printable for Dog {
    fn display(self) -> string {
        self.name
    }
}

type Cat = { name: string }

impl Printable for Cat {
    fn display(self) -> string {
        "meow from ${self.name}"
    }
}

let d = Dog { name: "Rex" }
println(d.display())

let c = Cat { name: "Whiskers" }
println(c.display())
