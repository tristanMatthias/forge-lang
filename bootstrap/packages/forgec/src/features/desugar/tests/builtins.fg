/// expect: min: 3
/// expect: max: 10
/// expect: min_neg: -5
/// expect: max_same: 7
/// expect: min_expr: 4
/// expect: todo_skipped
/// expect: unreachable_skipped

fn main() {
    // min/max with integers
    println("min: ${string(min(3, 10))}")
    println("max: ${string(max(3, 10))}")

    // min/max with negatives
    println("min_neg: ${string(min(-5, 5))}")

    // min/max with equal values
    println("max_same: ${string(max(7, 7))}")

    // min/max with expressions
    let a = 4
    let b = 8
    println("min_expr: ${string(min(a, b))}")

    // todo() — we can't actually call it (it panics), but test it compiles
    let use_todo = false
    if use_todo {
        todo("implement this later")
    }
    println("todo_skipped")

    // unreachable() — same, test it compiles
    let x = 42
    if x < 0 {
        unreachable("x should be positive")
    }
    println("unreachable_skipped")
}
