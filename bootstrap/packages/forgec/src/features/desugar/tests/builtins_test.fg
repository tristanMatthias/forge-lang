spec "builtins" {
    then "min two values" {
        min(3, 10) == 3
    }
    then "max two values" {
        max(3, 10) == 10
    }
    then "min with negatives" {
        min(-5, 5) == -5
    }
    then "max with equal values" {
        max(7, 7) == 7
    }
    then "min with expressions" {
        let a = 4
        let b = 8
        min(a, b) == 4
    }
}
