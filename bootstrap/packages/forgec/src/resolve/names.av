// WHY: module-aware name resolution — builds a module tree from
// Stmt.Module nodes, resolves `use` imports into alias tables, and
// rewrites Expr.Ident references to Expr.QualifiedIdent with their
// fully-qualified canonical paths (e.g. "core::ast::render_expr").
//
// After rewriting, calls resolve_program (sibling in resolve/) to
// validate variable scopes. The two passes are unified under a
// single `resolve_names` entry point.
//
//   read this file when:    working on module visibility, use imports,
//                           or qualified name resolution
//   do NOT read this file when:   the issue is variable scoping or
//                                  type checking

use core.ast.{Expr, ExprList, FieldList, Stmt, StmtList, ParamList, FieldInitList, MatchArmList, WhenArmList, Pattern, PatternList, SExpr, SStmt, VariantList, sexpr, sexpr_dummy, sstmt, stmt_unwrap, AnnotationList, ValueType, TypeList}
use diagnostics.{Confidence, DiagCode, Span, DiagnosticBag, bag_new, bag_merge, bag_report, bag_has_errors, diag_error, diag_warning, diag_with_confidence, span_new, span_dummy}
use resolve.{resolve_program}
use core.type_registry.{TypeRegistry, TypeKind, type_registry_new, type_registry_register, type_registry_id_for, type_qualified_name, method_mangled_name, trait_impl_name, is_mangled_method, method_from_mangled}

// ── Module tree ──
//
// Hierarchical namespace built from Stmt.Module nodes. Each node
// contains the items (functions, types, enums) defined in that module
// and links to child modules.

enum ModuleItem {
    End
    Node(short_name: string, canonical: string, exported: int, next: ModuleItem)
}

enum ModuleNode {
    End
    Node(name: string, path: string, items: ModuleItem, children: ModuleNode, next: ModuleNode)
}

// ── Alias table ──
//
// Maps short names to canonical paths within a module scope.
// Built from `use` declarations.

enum AliasEntry {
    End
    Node(short_name: string, canonical: string, next: AliasEntry)
}

fn alias_lookup(aliases: AliasEntry, name: string) -> string {
    match aliases {
        .End -> ""
        .Node(short, canonical, _) if short == name -> canonical
        .Node(_, _, next) -> alias_lookup(next, name)
    }
}

// ── Module item lookup ──

fn item_lookup(items: ModuleItem, name: string) -> string {
    match items {
        .End -> ""
        .Node(short, canonical, _, _) if short == name -> canonical
        .Node(_, _, _, next) -> item_lookup(next, name)
    }
}

fn item_is_exported(items: ModuleItem, name: string) -> bool {
    match items {
        .End -> false
        .Node(short, _, exported, _) if short == name -> exported
        .Node(_, _, _, next) -> item_is_exported(next, name)
    }
}

// Build a flat index of ALL items across ALL modules. Called once
// at the start of resolve_names. Turns the O(n*m) tree traversal
// per identifier into an O(m) linked-list scan (same as alias_lookup).
fn build_global_index(tree: ModuleNode, index: ModuleItem) -> ModuleItem {
    match tree {
        .End -> index
        .Node(_, _, items, children, next) -> {
            let with_items = append_items(items, index)
            let with_children = build_global_index(children, with_items)
            build_global_index(next, with_children)
        }
    }
}

fn append_items(items: ModuleItem, rest: ModuleItem) -> ModuleItem {
    match items {
        .End -> rest
        .Node(short, canonical, exported, next) -> {
            append_items(next, ModuleItem.Node(short, canonical, exported, rest))
        }
    }
}

// Find a module node by path (e.g. "helpers" or "core::ast")
fn module_find(tree: ModuleNode, path: string) -> ModuleNode {
    match tree {
        .End -> ModuleNode.End
        .Node(_, mod_path, _, _, _) if mod_path == path -> tree
        .Node(_, _, _, children, next) -> {
            let in_children = module_find(children, path)
            match in_children {
                .End -> module_find(next, path)
                _ -> in_children
            }
        }
    }
}

// ── Pass 1: Build module tree ──
//
// Walk the AST and collect all module-level declarations (fn, type,
// enum, trait, extern fn) into a hierarchical ModuleNode tree.

fn build_module_tree(stmts: StmtList, parent_path: string, tree: ModuleNode) -> ModuleNode {
    match stmts {
        .End -> tree
        .Node(ss, next) -> {
            let updated = build_tree_from_stmt(ss.node, parent_path, tree)
            build_module_tree(next, parent_path, updated)
        }
    }
}

fn build_tree_from_stmt(stmt: Stmt, parent_path: string, tree: ModuleNode) -> ModuleNode {
    match stmt {
        .Module(name, body) -> {
            let mod_path = type_qualified_name(parent_path, name)
            // Collect items in this module
            let items = collect_module_items(body, mod_path)
            // Recursively build tree for nested modules
            let children = build_module_tree(body, mod_path, ModuleNode.End)
            // Add this module to the tree
            ModuleNode.Node(name, mod_path, items, children, tree)
        }
        .Annotated(_, inner) -> build_tree_from_stmt(inner, parent_path, tree)
        _ -> tree
    }
}

// Collect all declaration names in a module's body
fn collect_module_items(stmts: StmtList, mod_path: string) -> ModuleItem {
    match stmts {
        .End -> ModuleItem.End
        .Node(ss, next) -> {
            let rest = collect_module_items(next, mod_path)
            collect_item_from_stmt(ss.node, mod_path, false, rest)
        }
    }
}

fn collect_item_from_stmt(stmt: Stmt, mod_path: string, exported: int, rest: ModuleItem) -> ModuleItem {
    match stmt {
        .Function(name, _, _, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .ExternFn(name, _, _) -> {
            // Extern fns keep bare names (C ABI) but are registered
            // for visibility tracking
            ModuleItem.Node(name, name, true, rest)
        }
        .TypeDecl(name, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .NewtypeDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .UnionAliasDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .ShapeDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .EnumDecl(name, _, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .TraitDecl(name, _) -> {
            let canonical = type_qualified_name(mod_path, name)
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .Impl(_, methods) -> collect_impl_items(methods, mod_path, rest)
        .Annotated(annotations, inner) -> {
            let is_export = annotation_has_export(annotations)
            // Re-exports: `export use path.{name1, name2}` makes imported
            // names visible as exports of the current module.
            if is_export {
                match inner {
                    .Use(use_path, names) -> {
                        // The use path is relative to the current module, so
                        // prefix with the module path to get the canonical path.
                        let rel_path = dots_to_colons(use_path)
                        let canonical_mod = type_qualified_name(mod_path, rel_path)
                        return collect_reexport_items(names, canonical_mod, rest)
                    }
                    _ -> {}
                }
            }
            collect_item_from_stmt(inner, mod_path, is_export, rest)
        }
        _ -> rest
    }
}

// Collect re-exported names from `export use path.{name1, name2}`.
// Each imported name becomes an exported item in the current module,
// with its canonical path pointing at the source module.
fn collect_reexport_items(names: ParamList, source_mod: string, rest: ModuleItem) -> ModuleItem {
    match names {
        .End -> rest
        .Node(name, _, next) -> {
            let canonical = type_qualified_name(source_mod, name)
            ModuleItem.Node(name, canonical, true, collect_reexport_items(next, source_mod, rest))
        }
    }
}

fn collect_impl_items(stmts: StmtList, mod_path: string, rest: ModuleItem) -> ModuleItem {
    match stmts {
        .End -> rest
        .Node(ss, next) -> {
            let with_this = match stmt_unwrap(ss.node) {
                .Function(name, _, _, _, _) -> {
                    // Impl methods are already mangled as Type__method.
                    // Keep bare name — method call codegen uses Type__method directly.
                    ModuleItem.Node(name, name, true, rest)
                }
                _ -> rest
            }
            collect_impl_items(next, mod_path, with_this)
        }
    }
}

fn annotation_has_export(annotations: AnnotationList) -> bool {
    match annotations {
        .End -> false
        .Node(name, _, next) -> {
            if name == "export" { return true }
            annotation_has_export(next)
        }
    }
}

// ── Pass 2: Resolve use aliases ──
//
// Walk the AST and for each Stmt.Use, look up the imported names in
// the module tree and build an alias table for the containing scope.

fn resolve_use_aliases(stmts: StmtList, tree: ModuleNode) -> UseResult {
    match stmts {
        .End -> UseResult { aliases: AliasEntry.End, bag: bag_new() }
        .Node(ss, next) -> {
            let rest = resolve_use_aliases(next, tree)
            let unwrapped = match ss.node {
                .Annotated(_, inner) -> inner
                _ -> ss.node
            }
            match unwrapped {
                .Use(mod_path, names) -> {
                    let canonical_path = dots_to_colons(mod_path)
                    let sp = span_new(0, 0, ss.line, ss.col)
                    resolve_use_names(canonical_path, names, tree, rest, sp)
                }
                _ -> rest
            }
        }
    }
}

// Use resolution result — carries aliases + diagnostics bag.
type UseResult = {
    aliases: AliasEntry,
    bag: DiagnosticBag,
}

fn resolve_use_names(mod_path: string, names: ParamList, tree: ModuleNode, result: UseResult, sp: Span) -> UseResult {
    match names {
        .End -> result
        .Node(name, _, next) -> {
            let name_sp = sp
            let mod_node = module_find(tree, mod_path)
            let found_info = match mod_node {
                .End -> {
                    let d = diag_error(DiagCode.ImportNotFound, "`use ${mod_path}` — module not found in module tree", sp)
                    UseResult { aliases: result.aliases, bag: bag_report(result.bag, d) }
                }
                .Node(_, _, items, _, _) -> {
                    let found = item_lookup(items, name)
                    match {
                        found == "" -> {
                            let d = diag_error(DiagCode.ImportNotFound, "`${name}` not found in module `${mod_path}`", name_sp)
                            UseResult { aliases: result.aliases, bag: bag_report(result.bag, d) }
                        }
                        !item_is_exported(items, name) -> {
                            let d = diag_error(DiagCode.ImportPrivate, "`${name}` is private in module `${mod_path}`", name_sp)
                            UseResult { aliases: result.aliases, bag: bag_report(result.bag, d) }
                        }
                        _ -> UseResult { aliases: AliasEntry.Node(name, found, result.aliases), bag: result.bag }
                    }
                }
                _ -> result
            }
            resolve_use_names(mod_path, next, tree, found_info, sp)
        }
        _ -> result
    }
}

fn dots_to_colons(path: string) -> string {
    mut result = ""
    for i in 0..path.length {
        let ch = path[i]
        if ch == "." {
            result = "${result}::"
        } else {
            result = result + ch
        }
    }
    result
}

// ── Pass 3: Rewrite identifiers ──
//
// Walk all expressions in the AST. For each Expr.Ident that references
// a module-level item (via use aliases or implicit sibling access),
// rewrite it to Expr.QualifiedIdent with the canonical path.
//
// Local variables (let/mut/fn params/for/match bindings) are tracked
// in a scope stack and are NOT rewritten — they stay as Expr.Ident.

enum LocalScope {
    End
    Node(name: string, mutable: int, defined: int, depth: int, next: LocalScope)
}

fn scope_has(scope: LocalScope, name: string) -> bool {
    match scope {
        .End -> false
        .Node(n, _, _, _, _) if n == name -> true
        .Node(_, _, _, _, next) -> scope_has(next, name)
    }
}

// Builtin functions that should never be qualified
fn is_builtin_name(name: string) -> bool {
    name in ["println", "eprintln", "print", "eprint", "string", "int", "float", "panic", "exit", "self"]
}

// ── Name resolution context ──

type NameCtx = {
    tree: ModuleNode,
    aliases: AliasEntry,
    current_module: string,
    locals: LocalScope,
    // Flat index of ALL items across ALL modules — O(1) lookup
    // by short name. Built once in resolve_names, used by the
    // global search fallback in rewrite_ident.
    global_index: ModuleItem,
    // Central type registry — assigns unique TypeIds to every type.
    type_reg: TypeRegistry,
}

fn ctx_with_locals(ctx: NameCtx, locals: LocalScope) -> NameCtx {
    ctx with { locals }
}

fn ctx_with_module(ctx: NameCtx, current_module: string, aliases: AliasEntry) -> NameCtx {
    ctx with { aliases, current_module }
}

fn bind_params_ctx(ctx: NameCtx, params: ParamList) -> NameCtx {
    match params {
        .End -> ctx
        .Node(name, _, next) -> bind_params_ctx(ctx_with_locals(ctx, LocalScope.Node(name, false, true, 0, ctx.locals)), next)
    }
}

fn bind_pattern_ctx(ctx: NameCtx, pattern: Pattern) -> NameCtx {
    match pattern {
        .Wildcard -> ctx
        .Variant(_, bindings) -> bind_params_ctx(ctx, bindings)
        .NestedVariant(_, sub_pats) -> bind_pattern_list(ctx, sub_pats)
        .TypePattern(_, binding) -> ctx_with_locals(ctx, LocalScope.Node(binding, false, true, 0, ctx.locals))
        _ -> ctx  // LitString, LitInt, LitBool, LitFloat — no bindings
    }
}

fn bind_pattern_list(ctx: NameCtx, pats: PatternList) -> NameCtx {
    match pats {
        .End -> ctx
        .Node(pat, next) -> bind_pattern_list(bind_pattern_ctx(ctx, pat), next)
    }
}

fn merge_aliases(base: AliasEntry, extra: AliasEntry) -> AliasEntry {
    match extra {
        .End -> base
        .Node(short, canonical, next) -> merge_aliases(AliasEntry.Node(short, canonical, base), next)
    }
}

// ── Public entry point ──

export type NameResolveResult = {
    stmts: StmtList,
    had_error: int,
    error_message: string,
    bag: DiagnosticBag,
    type_reg: TypeRegistry,
}

export fn resolve_names(stmts: StmtList) -> NameResolveResult {
    // Pass 1: Build module tree and qualify names
    let tree = build_module_tree(stmts, "", ModuleNode.End)
    let use_result = resolve_use_aliases(stmts, tree)
    let global_index = build_global_index(tree, ModuleItem.End)
    let reg = type_registry_new()
    let ctx = NameCtx { tree, aliases: use_result.aliases, current_module: "", locals: LocalScope.End, global_index, type_reg: reg }
    let rewritten = rewrite_stmt_list(ctx, stmts)

    // Pass 2: Validate variable scopes (was separate resolve_program call)
    let resolved = resolve_program(rewritten)

    // Pass 3: Detect unused imports — collect all QualifiedIdent paths
    // from the rewritten AST and warn about imports that were never used.
    let used = collect_used_paths_stmts(rewritten, UsedPathSet.End)
    let unused_bag = check_unused_imports(use_result.aliases, used)

    // Merge diagnostics from all passes
    let merged_bag = bag_merge(bag_merge(use_result.bag, resolved.bag), unused_bag)
    let has_errors = bag_has_errors(merged_bag) || resolved.had_error
    NameResolveResult {
        stmts: rewritten,
        had_error: has_errors,
        error_message: if has_errors {
            if resolved.had_error { resolved.error_message } else { "module resolution errors" }
        } else { "" },
        type_reg: ctx.type_reg,
        bag: merged_bag,
    }
}

// ── Statement rewriting ──

fn rewrite_stmt_list(ctx: NameCtx, stmts: StmtList) -> StmtList {
    match stmts {
        .End -> .End
        .Node(ss, next) -> .Node(sstmt(rewrite_stmt(ctx, ss.node), ss.line, ss.col), rewrite_stmt_list(ctx, next))
    }
}

fn rewrite_stmt(ctx: NameCtx, stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, vt, init) -> .Let(name, rewrite_vtype(ctx, vt), rewrite_expr(ctx, init))
        .Mut(name, vt, init) -> .Mut(name, rewrite_vtype(ctx, vt), rewrite_expr(ctx, init))
        .Expr(e) -> .Expr(rewrite_expr(ctx, e))
        .Return(e) -> .Return(rewrite_expr(ctx, e))
        .Block(body) -> .Block(rewrite_stmt_list(ctx, body))
        .If(cond, then_b, else_b) -> {
            let new_else = if else_b != null { rewrite_stmt(ctx, else_b!) } else { null }
            Stmt.If(rewrite_expr(ctx, cond), rewrite_stmt(ctx, then_b), new_else)
        }
        .While(cond, body) -> .While(rewrite_expr(ctx, cond), rewrite_stmt(ctx, body))
        .For(var, start, end, body) -> .For(var, rewrite_expr(ctx, start), rewrite_expr(ctx, end), rewrite_stmt(ctx, body))
        .ForIn(var, coll, body) -> .ForIn(var, rewrite_expr(ctx, coll), rewrite_stmt(ctx, body))
        .Function(name, tp, params, rvt, body) -> {
            let is_impl_method = is_mangled_method(name)
            let qualified = if ctx.current_module != "" && name != "main" && !is_impl_method { type_qualified_name(ctx.current_module, name) } else { name }
            let rp = rewrite_param_types(ctx, params)
            Stmt.Function(qualified, tp, rp, rewrite_vtype(ctx, rvt), rewrite_stmt_list(bind_params_ctx(ctx, rp), body))
        }
        .Match(subject, arms) -> .Match(rewrite_expr(ctx, subject), rewrite_match_arms(ctx, arms))
        .Module(name, body) -> {
            let mod_path = type_qualified_name(ctx.current_module, name)
            let mod_uses = resolve_use_aliases(body, ctx.tree)
            Stmt.Module(name, rewrite_stmt_list(ctx_with_module(ctx, mod_path, merge_aliases(ctx.aliases, mod_uses.aliases)), body))
        }
        .TypeDecl(name, tp, fields) -> {
            let qn = resolve_type_in_ctx(ctx, name)
            let rf = rewrite_field_types(ctx, fields)
            type_registry_register(ctx.type_reg, qn, TypeKind.StructKind, rf, VariantList.End, ValueType.Unknown)
            Stmt.TypeDecl(qn, tp, rf)
        }
        .EnumDecl(name, tp, variants) -> {
            let qn = resolve_type_in_ctx(ctx, name)
            let rv = rewrite_variant_types(ctx, variants)
            type_registry_register(ctx.type_reg, qn, TypeKind.EnumKind, FieldList.End, rv, ValueType.Unknown)
            Stmt.EnumDecl(qn, tp, rv)
        }
        .TraitDecl(name, body) -> {
            let qn = resolve_type_in_ctx(ctx, name)
            type_registry_register(ctx.type_reg, qn, TypeKind.TraitKind, FieldList.End, VariantList.End, ValueType.Unknown)
            Stmt.TraitDecl(qn, body)
        }
        .ShapeDecl(name, fields) -> {
            let qn = resolve_type_in_ctx(ctx, name)
            let rf = rewrite_field_types(ctx, fields)
            type_registry_register(ctx.type_reg, qn, TypeKind.ShapeKind, rf, VariantList.End, ValueType.Unknown)
            Stmt.ShapeDecl(qn, rf)
        }
        .NewtypeDecl(name, inner) -> {
            let qn = resolve_type_in_ctx(ctx, name)
            let ri = rewrite_vtype(ctx, inner)
            type_registry_register(ctx.type_reg, qn, TypeKind.NewtypeKind, FieldList.End, VariantList.End, ri)
            Stmt.NewtypeDecl(qn, ri)
        }
        .Impl(type_name, methods) -> rewrite_impl_stmt(ctx, type_name, methods)
        .Annotated(annotations, inner) -> .Annotated(annotations, rewrite_stmt(ctx, inner))
        .Defer(body) -> .Defer(rewrite_expr(ctx, body))
        .Errdefer(body) -> .Errdefer(rewrite_expr(ctx, body))
        .LetDestructure(names, init) -> .LetDestructure(names, rewrite_expr(ctx, init))
        .ExternFn(name, params, rvt) -> .ExternFn(name, rewrite_param_types(ctx, params), rewrite_vtype(ctx, rvt))
        .SpecBlock(name, body) -> .SpecBlock(name, rewrite_stmt_list(ctx, body))
        .GivenBlock(name, body) -> .GivenBlock(name, rewrite_stmt_list(ctx, body))
        .ThenBlock(name, cond) -> .ThenBlock(name, rewrite_expr(ctx, cond))
        _ -> stmt
    }
}

fn rewrite_impl_stmt(ctx: NameCtx, type_name: string, methods: StmtList) -> Stmt {
    // Trait impl: "TraitName:TypeName" — qualify both parts separately
    let sep = find_single_colon(type_name)
    if sep >= 0 {
        let trait_part = type_name.substring(0, sep)
        let type_part = type_name.substring(sep + 1, type_name.length)
        let rt = resolve_type_in_ctx(ctx, trait_part)
        let tt = resolve_type_in_ctx(ctx, type_part)
        Stmt.Impl(trait_impl_name(rt, tt), rewrite_impl_methods(ctx, tt, methods))
    } else {
        let rt = resolve_type_in_ctx(ctx, type_name)
        Stmt.Impl(rt, rewrite_impl_methods(ctx, rt, methods))
    }
}

// Find single colon (trait:type separator) that isn't part of ::
fn find_single_colon(s: string) -> int {
    mut i = 0
    while i < s.length {
        if s[i] == ":" {
            if i + 1 < s.length && s[i + 1] == ":" {
                i = i + 2
                continue
            }
            return i
        }
        i = i + 1
    }
    -1
}

fn resolve_type_in_ctx(ctx: NameCtx, type_name: string) -> string {
    if type_name.contains("::") { return type_name }
    // Primitives and type parameters (single uppercase letter) stay as-is
    if type_name in ["int", "string", "bool", "float", "ptr", "void"] { return type_name }
    if type_name.length == 1 && type_name[0] in "A".."Z" { return type_name }
    let canonical = item_lookup(ctx.global_index, type_name)
    if canonical != "" { return canonical }
    let alias = alias_lookup(ctx.aliases, type_name)
    if alias != "" { return alias }
    if ctx.current_module != "" {
        return type_qualified_name(ctx.current_module, type_name)
    }
    type_name
}

// ── ValueType + param rewriting ──
// Qualify all type names inside ValueType, ParamList, and TypeList.
// After this pass, every Struct/Enum/Trait/Newtype name is fully qualified.

fn rewrite_vtype(ctx: NameCtx, vt: ValueType) -> ValueType {
    match vt {
        .Struct(name, _) if name != "" -> {
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Struct(qn, type_registry_id_for(ctx.type_reg, qn))
        }
        .Enum(name, args, _) if name != "" -> {
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Enum(qn, rewrite_vtype_list(ctx, args), type_registry_id_for(ctx.type_reg, qn))
        }
        .Trait(name, _) if name != "" -> {
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Trait(qn, type_registry_id_for(ctx.type_reg, qn))
        }
        .Newtype(name, inner, _) if name != "" -> {
            let qn = resolve_type_in_ctx(ctx, name)
            ValueType.Newtype(qn, rewrite_vtype(ctx, inner), type_registry_id_for(ctx.type_reg, qn))
        }
        .NarrowedEnum(en, v, _) if en != "" -> {
            let qn = resolve_type_in_ctx(ctx, en)
            ValueType.NarrowedEnum(qn, v, type_registry_id_for(ctx.type_reg, qn))
        }
        .List(elem) -> .List(rewrite_vtype(ctx, elem))
        .Fn(ret) -> .Fn(rewrite_vtype(ctx, ret))
        .FnTyped(params, ret) -> .FnTyped(rewrite_vtype_list(ctx, params), rewrite_vtype(ctx, ret))
        .Closure(n, ret) -> .Closure(n, rewrite_vtype(ctx, ret))
        .Union(types) -> .Union(rewrite_vtype_list(ctx, types))
        .Task(rt) -> .Task(rewrite_vtype(ctx, rt))
        _ -> vt
    }
}

fn rewrite_vtype_list(ctx: NameCtx, tl: TypeList) -> TypeList {
    match tl {
        .End -> .End
        .Node(vt, next) -> .Node(rewrite_vtype(ctx, vt), rewrite_vtype_list(ctx, next))
    }
}

fn rewrite_field_types(ctx: NameCtx, fields: FieldList) -> FieldList {
    match fields {
        .End -> .End
        .Node(name, vt, next) -> .Node(name, rewrite_vtype(ctx, vt), rewrite_field_types(ctx, next))
    }
}

fn rewrite_variant_types(ctx: NameCtx, variants: VariantList) -> VariantList {
    match variants {
        .End -> .End
        .Node(name, fields, next) -> .Node(name, rewrite_field_types(ctx, fields), rewrite_variant_types(ctx, next))
    }
}

fn rewrite_param_types(ctx: NameCtx, params: ParamList) -> ParamList {
    match params {
        .End -> .End
        .Node(name, vt, next) -> .Node(name, rewrite_vtype(ctx, vt), rewrite_param_types(ctx, next))
    }
}

fn qualify_self_param(ctx: NameCtx, params: ParamList, qualified_type: string) -> ParamList {
    match params {
        .End -> .End
        .Node(name, vt, next) -> {
            if name == "self" {
                let tid = type_registry_id_for(ctx.type_reg, qualified_type)
                ParamList.Node("self", ValueType.Struct(qualified_type, tid), next)
            } else {
                ParamList.Node(name, vt, qualify_self_param(ctx, next, qualified_type))
            }
        }
    }
}

fn rewrite_impl_methods(ctx: NameCtx, qualified_type: string, stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> {
            let new_stmt = match ss.node {
                .Function(name, tp, params, rvt, body) -> {
                    let mn = method_from_mangled(name)
                    let qualified_name = method_mangled_name(qualified_type, mn)
                    let rp = rewrite_param_types(ctx, qualify_self_param(ctx, params, qualified_type))
                    Stmt.Function(qualified_name, tp, rp, rewrite_vtype(ctx, rvt), rewrite_stmt_list(bind_params_ctx(ctx, rp), body))
                }
                _ -> rewrite_stmt(ctx, ss.node)
            }
            StmtList.Node(sstmt(new_stmt, ss.line, ss.col), rewrite_impl_methods(ctx, qualified_type, next))
        }
    }
}

// ── Expression rewriting ──

fn rewrite_expr(ctx: NameCtx, expr: Expr) -> Expr {
    if expr == null { return Expr.Null }
    match expr {
        .Ident(name) -> rewrite_ident(ctx, name, expr)
        .Call(callee, args) -> {
            // Qualify uppercase callee in Call context (newtype constructors)
            let rewritten_callee = match callee {
                .Ident(name) if name.length > 0 && name[0] in "A".."Z" -> {
                    let resolved = resolve_type_in_ctx(ctx, name)
                    if resolved != name { Expr.QualifiedIdent(resolved) } else { rewrite_ident(ctx, name, callee) }
                }
                _ -> rewrite_expr(ctx, callee)
            }
            Expr.Call(rewritten_callee, rewrite_expr_list(ctx, args))
        }
        .GenericCall(callee, ta, args) -> .GenericCall(rewrite_expr(ctx, callee), ta, rewrite_expr_list(ctx, args))
        .Binary(l, op, r) -> .Binary(rewrite_expr(ctx, l), op, rewrite_expr(ctx, r))
        .Unary(op, r) -> .Unary(op, rewrite_expr(ctx, r))
        .Logical(l, op, r) -> .Logical(rewrite_expr(ctx, l), op, rewrite_expr(ctx, r))
        .Grouping(inner) -> .Grouping(rewrite_expr(ctx, inner))
        .Assign(name, val) -> .Assign(name, rewrite_expr(ctx, val))
        .Index(obj, idx) -> .Index(rewrite_expr(ctx, obj), rewrite_expr(ctx, idx))
        .Try(inner) -> .Try(rewrite_expr(ctx, inner))
        .Block(body) -> .Block(rewrite_stmt_list(ctx, body))
        _ -> rewrite_expr_compound(ctx, expr)
    }
}

fn rewrite_expr_compound(ctx: NameCtx, expr: Expr) -> Expr {
    if expr == null { return Expr.Null }
    match expr {
        .FieldAccess(obj, field) -> {
            // Qualify uppercase Ident in FieldAccess (enum constructors: ValueType.Unknown)
            let rewritten_obj = match obj {
                .Ident(name) if name.length > 0 && name[0] in "A".."Z" -> {
                    let resolved = resolve_type_in_ctx(ctx, name)
                    if resolved != name { Expr.QualifiedIdent(resolved) } else { rewrite_ident(ctx, name, obj) }
                }
                _ -> rewrite_expr(ctx, obj)
            }
            Expr.FieldAccess(rewritten_obj, field)
        }
        .FieldAssign(obj, field, val) -> .FieldAssign(rewrite_expr(ctx, obj), field, rewrite_expr(ctx, val))
        .IfExpr(c, t, e) -> .IfExpr(rewrite_expr(ctx, c), rewrite_expr(ctx, t), rewrite_expr(ctx, e))
        .NullCoalesce(l, r) -> .NullCoalesce(rewrite_expr(ctx, l), rewrite_expr(ctx, r))
        .OptionalChain(obj, field) -> .OptionalChain(rewrite_expr(ctx, obj), field)
        .Tuple(elems) -> .Tuple(rewrite_expr_list(ctx, elems))
        .TupleIndex(obj, idx) -> .TupleIndex(rewrite_expr(ctx, obj), idx)
        .ListLit(elems) -> .ListLit(rewrite_expr_list(ctx, elems))
        .MapLit(entries) -> .MapLit(rewrite_expr_list(ctx, entries))
        .Slice(obj, s, e) -> .Slice(rewrite_expr(ctx, obj), rewrite_expr(ctx, s), rewrite_expr(ctx, e))
        .With(obj, overrides) -> .With(rewrite_expr(ctx, obj), rewrite_field_inits(ctx, overrides))
        .StructLit(name, inits) -> {
            let qn = if name != "" { resolve_type_in_ctx(ctx, name) } else { name }
            Expr.StructLit(qn, rewrite_field_inits(ctx, inits))
        }
        .EnumCtor(type_name, variant, args) -> {
            let qt = if type_name != "" { resolve_type_in_ctx(ctx, type_name) } else { type_name }
            Expr.EnumCtor(qt, variant, rewrite_expr_list(ctx, args))
        }
        .MatchExpr(subject, arms) -> .MatchExpr(rewrite_expr(ctx, subject), rewrite_match_arms(ctx, arms))
        .Lambda(params, body) -> .Lambda(params, rewrite_expr(bind_params_ctx(ctx, params), body))
        .IsCheck(subject, variant) -> .IsCheck(rewrite_expr(ctx, subject), variant)
        .InCheck(needle, items) -> .InCheck(rewrite_expr(ctx, needle), rewrite_expr_list(ctx, items))
        .When(arms) -> .When(rewrite_when_arms(ctx, arms))
        _ -> expr
    }
}

fn rewrite_ident(ctx: NameCtx, name: string, original: Expr) -> Expr {
    // 1. Local variable — don't rewrite
    if scope_has(ctx.locals, name) { return original }
    // 2. Builtin function — don't rewrite
    if is_builtin_name(name) { return original }
    // 3. Uppercase = type/enum name — leave for codegen (StructLit/EnumCtor handled separately)
    if name.length > 0 && name[0] in "A".."Z" { return original }
    // 4. Use alias (from `use path.{name}`)
    let from_alias = alias_lookup(ctx.aliases, name)
    if from_alias != "" { return Expr.QualifiedIdent(from_alias) }
    // 5. Sibling in current module
    if ctx.current_module != "" {
        let mod_node = module_find(ctx.tree, ctx.current_module)
        let from_sibling = match mod_node {
            .End -> ""
            .Node(_, _, items, _, _) -> item_lookup(items, name)
        }
        if from_sibling != "" { return Expr.QualifiedIdent(from_sibling) }
    }
    // No global fallback. Names must be imported via `use` or defined
    // in the current module. Unresolved names stay as Expr.Ident.
    original
}

fn rewrite_expr_list(ctx: NameCtx, exprs: ExprList) -> ExprList {
    match exprs {
        .End -> .End
        .Node(se, next) -> ExprList.Node(sexpr(rewrite_expr(ctx, se.node), se.line, se.col), rewrite_expr_list(ctx, next))
    }
}

fn rewrite_field_inits(ctx: NameCtx, inits: FieldInitList) -> FieldInitList {
    match inits {
        .End -> FieldInitList.End
        .Node(name, se, next) -> FieldInitList.Node(name, sexpr(rewrite_expr(ctx, se.node), se.line, se.col), rewrite_field_inits(ctx, next))
    }
}

fn rewrite_match_arms(ctx: NameCtx, arms: MatchArmList) -> MatchArmList {
    match arms {
        .End -> MatchArmList.End
        .Node(pattern, guard, body, next) -> {
            let rp = rewrite_pattern(ctx, pattern)
            let arm_ctx = bind_pattern_ctx(ctx, rp)
            let new_guard = if guard != null { sexpr(rewrite_expr(arm_ctx, guard!.node), guard!.line, guard!.col) } else { null }
            MatchArmList.Node(rp, new_guard, sexpr(rewrite_expr(arm_ctx, body.node), body.line, body.col), rewrite_match_arms(ctx, next))
        }
    }
}

// Qualify type names inside match patterns
fn is_primitive_type(name: string) -> bool {
    name in ["int", "string", "bool", "float", "ptr", "void"]
}

fn rewrite_pattern(ctx: NameCtx, pattern: Pattern) -> Pattern {
    match pattern {
        .TypePattern(type_name, binding) -> {
            if is_primitive_type(type_name) { return pattern }
            let resolved = resolve_type_in_ctx(ctx, type_name)
            Pattern.TypePattern(resolved, binding)
        }
        .NestedVariant(name, sub_pats) -> Pattern.NestedVariant(name, rewrite_pattern_list(ctx, sub_pats))
        _ -> pattern
    }
}

fn rewrite_pattern_list(ctx: NameCtx, pats: PatternList) -> PatternList {
    match pats {
        .End -> PatternList.End
        .Node(pat, next) -> PatternList.Node(rewrite_pattern(ctx, pat), rewrite_pattern_list(ctx, next))
    }
}

fn rewrite_when_arms(ctx: NameCtx, arms: WhenArmList) -> WhenArmList {
    match arms {
        .End -> WhenArmList.End
        .Node(cond, body, next) -> {
            let new_cond = if cond == null { null } else { sexpr(rewrite_expr(ctx, cond!.node), cond!.line, cond!.col) }
            WhenArmList.Node(new_cond, sexpr(rewrite_expr(ctx, body.node), body.line, body.col), rewrite_when_arms(ctx, next))
        }
    }
}

// ── Unused import detection ──
// After the rewrite pass, collect all QualifiedIdent canonical paths
// from the rewritten AST, then check each use-imported alias against
// the used set. Emit warnings for imports that were never referenced.

enum UsedPathSet {
    End
    Node(path: string, next: UsedPathSet)
}

fn used_has(set: UsedPathSet, path: string) -> bool {
    match set {
        .End -> false
        .Node(p, _) if p == path -> true
        .Node(_, next) -> used_has(next, path)
    }
}

// Collect all QualifiedIdent paths from the rewritten AST.
fn collect_used_paths_stmts(stmts: StmtList, acc: UsedPathSet) -> UsedPathSet {
    match stmts {
        .End -> acc
        .Node(ss, next) -> {
            let with_stmt = collect_used_paths_stmt(ss.node, acc)
            collect_used_paths_stmts(next, with_stmt)
        }
    }
}

fn collect_used_paths_stmt(stmt: Stmt, acc: UsedPathSet) -> UsedPathSet {
    match stmt {
        .Expr(e) -> collect_used_paths_expr(e, acc)
        .Let(_, _, init) -> collect_used_paths_expr(init, acc)
        .Mut(_, _, init) -> collect_used_paths_expr(init, acc)
        .Const(_, _, init) -> collect_used_paths_expr(init, acc)
        .Return(e) -> collect_used_paths_expr(e, acc)
        .Block(body) -> collect_used_paths_stmts(body, acc)
        .Function(_, _, _, _, body) -> collect_used_paths_stmts(body, acc)
        .If(cond, then_b, else_b) -> {
            let a = collect_used_paths_expr(cond, acc)
            let b = collect_used_paths_stmt(then_b, a)
            if else_b != null { collect_used_paths_stmt(else_b!, b) } else { b }
        }
        .While(cond, body) -> collect_used_paths_stmt(body, collect_used_paths_expr(cond, acc))
        .For(_, start, end, body) -> {
            let a = collect_used_paths_expr(start, acc)
            let b = collect_used_paths_expr(end, a)
            collect_used_paths_stmt(body, b)
        }
        .ForIn(_, coll, body) -> collect_used_paths_stmt(body, collect_used_paths_expr(coll, acc))
        .Match(subj, arms) -> collect_used_paths_match_arms(arms, collect_used_paths_expr(subj, acc))
        .Module(_, body) -> collect_used_paths_stmts(body, acc)
        .Impl(_, methods) -> collect_used_paths_stmts(methods, acc)
        .Annotated(_, inner) -> collect_used_paths_stmt(inner, acc)
        .Defer(body) -> collect_used_paths_expr(body, acc)
        .LetDestructure(_, init) -> collect_used_paths_expr(init, acc)
        _ -> acc
    }
}

fn collect_used_paths_expr(expr: Expr, acc: UsedPathSet) -> UsedPathSet {
    if expr == null { return acc }
    match expr {
        .QualifiedIdent(path) -> UsedPathSet.Node(path, acc)
        .Call(callee, args) -> collect_used_paths_expr_list(args, collect_used_paths_expr(callee, acc))
        .GenericCall(callee, _, args) -> collect_used_paths_expr_list(args, collect_used_paths_expr(callee, acc))
        .Binary(l, _, r) -> collect_used_paths_expr(r, collect_used_paths_expr(l, acc))
        .Unary(_, r) -> collect_used_paths_expr(r, acc)
        .Logical(l, _, r) -> collect_used_paths_expr(r, collect_used_paths_expr(l, acc))
        .Grouping(inner) -> collect_used_paths_expr(inner, acc)
        .Assign(_, val) -> collect_used_paths_expr(val, acc)
        .Index(obj, idx) -> collect_used_paths_expr(idx, collect_used_paths_expr(obj, acc))
        .Block(body) -> collect_used_paths_stmts(body, acc)
        .FieldAccess(obj, _) -> collect_used_paths_expr(obj, acc)
        .FieldAssign(obj, _, val) -> collect_used_paths_expr(val, collect_used_paths_expr(obj, acc))
        .IfExpr(c, t, e) -> collect_used_paths_expr(e, collect_used_paths_expr(t, collect_used_paths_expr(c, acc)))
        .NullCoalesce(l, r) -> collect_used_paths_expr(r, collect_used_paths_expr(l, acc))
        .OptionalChain(obj, _) -> collect_used_paths_expr(obj, acc)
        .Try(inner) -> collect_used_paths_expr(inner, acc)
        .Tuple(elems) -> collect_used_paths_expr_list(elems, acc)
        .ListLit(elems) -> collect_used_paths_expr_list(elems, acc)
        .MapLit(entries) -> collect_used_paths_expr_list(entries, acc)
        .StructLit(sn, inits) -> collect_used_paths_field_inits(inits, UsedPathSet.Node(sn, acc))
        .EnumCtor(tn, _, args) -> collect_used_paths_expr_list(args, UsedPathSet.Node(tn, acc))
        .MatchExpr(subj, arms) -> collect_used_paths_match_arms(arms, collect_used_paths_expr(subj, acc))
        .Lambda(_, body) -> collect_used_paths_expr(body, acc)
        .With(obj, overrides) -> collect_used_paths_field_inits(overrides, collect_used_paths_expr(obj, acc))
        .Slice(obj, s, e) -> collect_used_paths_expr(e, collect_used_paths_expr(s, collect_used_paths_expr(obj, acc)))
        .IsCheck(subj, _) -> collect_used_paths_expr(subj, acc)
        .InCheck(needle, items) -> collect_used_paths_expr_list(items, collect_used_paths_expr(needle, acc))
        .Catch(inner, _, body, _, _) -> collect_used_paths_expr(body, collect_used_paths_expr(inner, acc))
        .Spawn(body) -> collect_used_paths_expr(body, acc)
        .Ident(name) -> {
            // PascalCase identifiers may be imported type/enum names.
            // Track them as used paths by looking up their alias.
            if name.length > 0 && name[0] >= "A" && name[0] <= "Z" {
                return UsedPathSet.Node(name, acc)
            }
            acc
        }
        _ -> acc
    }
}

fn collect_used_paths_expr_list(exprs: ExprList, acc: UsedPathSet) -> UsedPathSet {
    match exprs {
        .End -> acc
        .Node(se, next) -> collect_used_paths_expr_list(next, collect_used_paths_expr(se.node, acc))
    }
}

fn collect_used_paths_field_inits(inits: FieldInitList, acc: UsedPathSet) -> UsedPathSet {
    match inits {
        .End -> acc
        .Node(_, sv, next) -> collect_used_paths_field_inits(next, collect_used_paths_expr(sv.node, acc))
    }
}

fn collect_used_paths_match_arms(arms: MatchArmList, acc: UsedPathSet) -> UsedPathSet {
    match arms {
        .End -> acc
        .Node(_, guard, body, next) -> {
            let with_guard = if guard != null { collect_used_paths_expr(guard!.node, acc) } else { acc }
            let with_body = collect_used_paths_expr(body.node, with_guard)
            collect_used_paths_match_arms(next, with_body)
        }
    }
}

// Check each alias in the use_result against the used paths set.
// Returns a DiagnosticBag with warnings for unused imports.
fn check_unused_imports(aliases: AliasEntry, used: UsedPathSet) -> DiagnosticBag {
    // Walk top-level Use stmts to match aliases to source spans
    check_unused_aliases(aliases, used, bag_new())
}

fn check_unused_aliases(aliases: AliasEntry, used: UsedPathSet, bag: DiagnosticBag) -> DiagnosticBag {
    match aliases {
        .End -> bag
        .Node(short_name, canonical, next) -> {
            let after = if !used_has(used, canonical) && !used_has(used, short_name) {
                let d = diag_with_confidence(diag_warning(DiagCode.UnusedImport, "unused import `${short_name}`", span_dummy()), Confidence.Medium)
                bag_report(bag, d)
            } else {
                bag
            }
            check_unused_aliases(next, used, after)
        }
    }
}
