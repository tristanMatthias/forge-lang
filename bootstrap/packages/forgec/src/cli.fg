// WHY: Pure-Forge CLI argument parsing library.
// Provides a builder-style API for defining commands, flags, options, and args.

extern fn forge_selfhost_argc() -> int
extern fn forge_selfhost_get_arg_cstr(idx: int) -> string
extern fn exit(code: int)

// ── Types ──

type FlagDef = { name: string, short: string, description: string }
type OptionDef = { name: string, short: string, description: string, default_val: string }
type ArgDef = { name: string, description: string, required: bool }

enum FlagList {
    End
    Node(item: FlagDef, next: FlagList)
}

enum OptionList {
    End
    Node(item: OptionDef, next: OptionList)
}

enum ArgList {
    End
    Node(item: ArgDef, next: ArgList)
}

type CommandDef = {
    name: string,
    description: string,
    flags: FlagList,
    options: OptionList,
    args: ArgList
}

enum CommandList {
    End
    Node(item: CommandDef, next: CommandList)
}

// Parsed result: which command matched, parsed flags/options/args
type ParsedFlag = { name: string, value: bool }
type ParsedOption = { name: string, value: string }
type ParsedArg = { name: string, value: string }

enum ParsedFlagList {
    End
    Node(item: ParsedFlag, next: ParsedFlagList)
}

enum ParsedOptionList {
    End
    Node(item: ParsedOption, next: ParsedOptionList)
}

enum ParsedArgList {
    End
    Node(item: ParsedArg, next: ParsedArgList)
}

export type CliResult = {
    command: string,
    flags: ParsedFlagList,
    options: ParsedOptionList,
    args: ParsedArgList,
    error: string
}

export type Cli = {
    name: string,
    description: string,
    version: string,
    commands: CommandList,
    flags: FlagList,
    options: OptionList,
    args: ArgList
}

// ── Builder ──

export fn cli_new(name: string, description: string, version: string) -> Cli {
    Cli {
        name,
        description,
        version,
        commands: CommandList.End,
        flags: FlagList.End,
        options: OptionList.End,
        args: ArgList.End
    }
}

export fn cli_add_command(cli: Cli, name: string, description: string) -> Cli {
    let cmd = CommandDef {
        name,
        description,
        flags: FlagList.End,
        options: OptionList.End,
        args: ArgList.End
    }
    cli with { commands: CommandList.Node(cmd, cli.commands) }
}

export fn cli_add_flag(cli: Cli, name: string, short: string, description: string) -> Cli {
    let f = FlagDef { name, short, description }
    cli with { flags: FlagList.Node(f, cli.flags) }
}

export fn cli_add_option(cli: Cli, name: string, short: string, description: string, default_val: string) -> Cli {
    let o = OptionDef { name, short, description, default_val }
    cli with { options: OptionList.Node(o, cli.options) }
}

export fn cli_add_arg(cli: Cli, name: string, description: string, required: bool) -> Cli {
    let a = ArgDef { name, description, required }
    cli with { args: ArgList.Node(a, cli.args) }
}

// Add flag/option/arg to a specific command
export fn cli_command_add_flag(cli: Cli, cmd_name: string, name: string, short: string, description: string) -> Cli {
    cli with { commands: update_command_flags(cli.commands, cmd_name, name, short, description) }
}

export fn cli_command_add_option(cli: Cli, cmd_name: string, name: string, short: string, description: string, default_val: string) -> Cli {
    cli with { commands: update_command_options(cli.commands, cmd_name, name, short, description, default_val) }
}

export fn cli_command_add_arg(cli: Cli, cmd_name: string, name: string, description: string, required: bool) -> Cli {
    cli with { commands: update_command_args(cli.commands, cmd_name, name, description, required) }
}

fn update_command_flags(cmds: CommandList, cmd_name: string, name: string, short: string, desc: string) -> CommandList {
    match cmds {
        .End -> CommandList.End
        .Node(cmd, next) -> {
            if cmd.name == cmd_name {
                let f = FlagDef { name, short, description: desc }
                let updated = cmd with { flags: FlagList.Node(f, cmd.flags) }
                CommandList.Node(updated, next)
            } else {
                CommandList.Node(cmd, update_command_flags(next, cmd_name, name, short, desc))
            }
        }
    }
}

fn update_command_options(cmds: CommandList, cmd_name: string, name: string, short: string, desc: string, default_val: string) -> CommandList {
    match cmds {
        .End -> CommandList.End
        .Node(cmd, next) -> {
            if cmd.name == cmd_name {
                let o = OptionDef { name, short, description: desc, default_val }
                let updated = cmd with { options: OptionList.Node(o, cmd.options) }
                CommandList.Node(updated, next)
            } else {
                CommandList.Node(cmd, update_command_options(next, cmd_name, name, short, desc, default_val))
            }
        }
    }
}

fn update_command_args(cmds: CommandList, cmd_name: string, name: string, desc: string, required: bool) -> CommandList {
    match cmds {
        .End -> CommandList.End
        .Node(cmd, next) -> {
            if cmd.name == cmd_name {
                let a = ArgDef { name, description: desc, required }
                let updated = cmd with { args: ArgList.Node(a, cmd.args) }
                CommandList.Node(updated, next)
            } else {
                CommandList.Node(cmd, update_command_args(next, cmd_name, name, desc, required))
            }
        }
    }
}

// ── Parsing ──

export fn cli_parse(cli: Cli) -> CliResult {
    let argc = forge_selfhost_argc()
    if argc < 2 {
        return CliResult {
            command: "",
            flags: ParsedFlagList.End,
            options: ParsedOptionList.End,
            args: ParsedArgList.End,
            error: ""
        }
    }

    let first_arg = forge_selfhost_get_arg_cstr(1)

    // Check for --help and --version
    if first_arg == "--help" || first_arg == "-h" {
        cli_print_help(cli)
        exit(0)
    }
    if first_arg == "--version" || first_arg == "-V" {
        println("${cli.name} v${cli.version}")
        exit(0)
    }

    // Try to match a command
    let cmd = find_command(cli.commands, first_arg)
    if cmd != null {
        // Parse command-specific + global flags/options/args starting at index 2
        return parse_args(cmd!.name, merge_flags(cmd!.flags, cli.flags),
                         merge_options(cmd!.options, cli.options),
                         merge_arg_lists(cmd!.args, cli.args), 2, argc)
    }

    // No command matched — parse as global flags/options/args starting at index 1
    parse_args("", cli.flags, cli.options, cli.args, 1, argc)
}

fn find_command(cmds: CommandList, name: string) -> CommandDef? {
    match cmds {
        .End -> null
        .Node(cmd, next) -> {
            if cmd.name == name { cmd } else { find_command(next, name) }
        }
    }
}

fn parse_args(cmd_name: string, flags: FlagList, options: OptionList, args: ArgList,
              start_idx: int, argc: int) -> CliResult {
    mut parsed_flags = ParsedFlagList.End
    mut parsed_options = ParsedOptionList.End
    mut parsed_args = ParsedArgList.End
    mut positional_idx = 0
    mut error = ""

    // Initialize options with defaults
    parsed_options = init_option_defaults(options)

    for i in start_idx..argc {
        let arg = forge_selfhost_get_arg_cstr(i)

        if arg.starts_with("--") || (arg.starts_with("-") && arg.length > 1) {
            // Check if it's a flag
            if is_flag_match(flags, arg) {
                parsed_flags = ParsedFlagList.Node(
                    ParsedFlag { name: strip_dashes(arg), value: true },
                    parsed_flags
                )
            }
            // Check if it's an option with = (--key=value)
            else if arg.contains("=") {
                let eq_idx = arg.index_of("=")
                let key = arg.substring(0, eq_idx)
                let val = arg.substring(eq_idx + 1, arg.length)
                if is_option_match(options, key) {
                    parsed_options = set_option(parsed_options, strip_dashes(key), val)
                } else {
                    error = "unknown option: ${key}"
                }
            }
            // Options use --key=value syntax only (for-loop can't skip ahead)
            else {
                error = "unknown flag: ${arg}"
            }
        } else {
            // Positional argument
            let arg_def = arg_at(args, positional_idx)
            if arg_def != null {
                parsed_args = ParsedArgList.Node(
                    ParsedArg { name: arg_def!.name, value: arg },
                    parsed_args
                )
            } else {
                parsed_args = ParsedArgList.Node(
                    ParsedArg { name: "arg${string(positional_idx)}", value: arg },
                    parsed_args
                )
            }
            positional_idx = positional_idx + 1
        }
    }

    CliResult { command: cmd_name, flags: parsed_flags, options: parsed_options, args: parsed_args, error }
}

// ── Helpers ──

fn strip_dashes(s: string) -> string {
    if s.starts_with("--") { s.substring(2, s.length) }
    else if s.starts_with("-") { s.substring(1, s.length) }
    else { s }
}

fn is_flag_match(flags: FlagList, arg: string) -> bool {
    match flags {
        .End -> false
        .Node(f, next) -> {
            if f.name == arg || (f.short != "" && f.short == arg) { true }
            else { is_flag_match(next, arg) }
        }
    }
}

fn is_option_match(options: OptionList, arg: string) -> bool {
    match options {
        .End -> false
        .Node(o, next) -> {
            if o.name == arg || (o.short != "" && o.short == arg) { true }
            else { is_option_match(next, arg) }
        }
    }
}

fn arg_at(args: ArgList, idx: int) -> ArgDef? {
    match args {
        .End -> null
        .Node(a, next) -> {
            if idx == 0 { a } else { arg_at(next, idx - 1) }
        }
    }
}

fn init_option_defaults(options: OptionList) -> ParsedOptionList {
    match options {
        .End -> ParsedOptionList.End
        .Node(o, next) -> {
            ParsedOptionList.Node(
                ParsedOption { name: strip_dashes(o.name), value: o.default_val },
                init_option_defaults(next)
            )
        }
    }
}

fn set_option(parsed: ParsedOptionList, name: string, value: string) -> ParsedOptionList {
    match parsed {
        .End -> ParsedOptionList.Node(ParsedOption { name, value }, ParsedOptionList.End)
        .Node(po, next) -> {
            if po.name == name {
                ParsedOptionList.Node(ParsedOption { name, value }, next)
            } else {
                ParsedOptionList.Node(po, set_option(next, name, value))
            }
        }
    }
}

fn merge_flags(a: FlagList, b: FlagList) -> FlagList {
    match a {
        .End -> b
        .Node(f, next) -> FlagList.Node(f, merge_flags(next, b))
    }
}

fn merge_options(a: OptionList, b: OptionList) -> OptionList {
    match a {
        .End -> b
        .Node(o, next) -> OptionList.Node(o, merge_options(next, b))
    }
}

fn merge_arg_lists(a: ArgList, b: ArgList) -> ArgList {
    match a {
        .End -> b
        .Node(arg, next) -> ArgList.Node(arg, merge_arg_lists(next, b))
    }
}

// ── Query parsed results ──

export fn result_has_flag(result: CliResult, name: string) -> bool {
    has_parsed_flag(result.flags, name)
}

fn has_parsed_flag(flags: ParsedFlagList, name: string) -> bool {
    match flags {
        .End -> false
        .Node(f, next) -> {
            if f.name == name { f.value } else { has_parsed_flag(next, name) }
        }
    }
}

export fn result_get_option(result: CliResult, name: string) -> string {
    get_parsed_option(result.options, name)
}

fn get_parsed_option(options: ParsedOptionList, name: string) -> string {
    match options {
        .End -> ""
        .Node(o, next) -> {
            if o.name == name { o.value } else { get_parsed_option(next, name) }
        }
    }
}

export fn result_get_arg(result: CliResult, name: string) -> string {
    get_parsed_arg(result.args, name)
}

fn get_parsed_arg(args: ParsedArgList, name: string) -> string {
    match args {
        .End -> ""
        .Node(a, next) -> {
            if a.name == name { a.value } else { get_parsed_arg(next, name) }
        }
    }
}

export fn result_has_error(result: CliResult) -> bool {
    result.error != ""
}

// ── Help output ──

fn cli_print_help(cli: Cli) {
    println("${cli.name} v${cli.version}")
    if cli.description != "" {
        println(cli.description)
    }
    println("")
    println("USAGE:")
    println("  ${cli.name} <command> [options]")
    println("")
    print_commands(cli.commands)
    print_flags("GLOBAL FLAGS:", cli.flags)
}

fn print_commands(cmds: CommandList) {
    match cmds {
        .End -> {}
        .Node(cmd, next) -> {
            // Print in reverse order (commands are prepended)
            print_commands(next)
            println("  ${cmd.name}  ${cmd.description}")
        }
    }
}

fn print_flags(header: string, flags: FlagList) {
    match flags {
        .End -> {}
        .Node(f, next) -> {
            if header != "" {
                println("")
                println(header)
            }
            let short_str = if f.short != "" { ", ${f.short}" } else { "" }
            println("  ${f.name}${short_str}  ${f.description}")
            print_flags("", next)
        }
    }
}
