// WHY: "did you mean?" suggestions for undefined variables and fields.
// Uses Levenshtein edit distance to find the closest match.

use core.runtime.{avra_selfhost_levenshtein}

// Levenshtein distance between two strings.
// Implemented in C (runtime.c) for performance — the bootstrap's
// string indexing is O(n) per character, making a pure-Forge
// implementation O(n*m*n).
export fn levenshtein(a: string, b: string) -> int {
    avra_selfhost_levenshtein(a, b, a.length, b.length)
}

enum StringList {
    End
    Node(value: string, next: StringList)
}

// Find the closest match to `name` among `candidates`.
// Returns the best match if edit distance <= 2, otherwise empty string.
export fn suggest_similar_from_list(name: string, candidates: StringList) -> string {
    find_best(name, candidates, "", 3)
}

fn find_best(name: string, candidates: StringList, best: string, best_dist: int) -> string {
    match candidates {
        .End -> best
        .Node(candidate, next) -> {
            let dist = levenshtein(name, candidate)
            if dist < best_dist {
                find_best(name, next, candidate, dist)
            } else {
                find_best(name, next, best, best_dist)
            }
        }
    }
}
