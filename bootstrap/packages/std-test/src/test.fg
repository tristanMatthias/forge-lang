// WHY: @std/test �� Forge test runner.
// Discovers *_test.fg files, compiles them into a single binary, runs it.
//
// Architecture:
//   1. Find all *_test.fg files in the project
//   2. Generate a temporary entry point that imports them all
//   3. Compile → one binary
//   4. Run → spec/given/then output directly
//
// Usage: forge test [-f filter] [--coverage]

extern fn forge_shell_exec(cmd: string) -> string
extern fn forge_shell_exec_status(cmd: string) -> int
extern fn forge_selfhost_file_exists(path: string) -> int
extern fn forge_selfhost_read_file(path: string) -> string
extern fn forge_selfhost_write_file(path: string, content: string) -> int
extern fn forge_process_exit(code: int)

// ── Types ──

export type TestConfig = {
    project_dir: string,
    build_dir: string,
    compiler: string,
    llc: string,
    llc_prefix: string,
    llvm_prefix: string,
    llvm_lib: string,
    runtime_o: string,
    llvm_wrapper_o: string,
    filter: string,
    coverage: bool,
}

// ── Colors ──

fn green(s: string) -> string { "\x1b[0;32m${s}\x1b[0m" }
fn red(s: string) -> string { "\x1b[0;31m${s}\x1b[0m" }
fn dim(s: string) -> string { "\x1b[2m${s}\x1b[0m" }
fn bold(s: string) -> string { "\x1b[1m${s}\x1b[0m" }

// ── Discovery ──

fn discover_test_files(config: TestConfig) -> string {
    // Find all *_test.fg files in the project
    let output = forge_shell_exec("find ${config.project_dir} -name '*_test.fg' -type f 2>/dev/null | sort")
    if output == "" { return "" }
    // Filter: skip build artifacts, and only include spec-style tests (no fn main)
    mut result = ""
    for path in output.split("\n") {
        if path == "" { continue }
        if path.contains("/build/") { continue }
        if path.contains("/seed/") { continue }
        // Only include files that use spec/given/then (no fn main)
        let content = forge_selfhost_read_file(path)
        if content.contains("fn main()") { continue }
        if !content.contains("spec ") { continue }
        result = if result == "" { path } else { "${result}\n${path}" }
    }
    result
}

// Convert a file path to a module path relative to the generated entry point.
// e.g. /project/features/defer_stmt/tests/defer_test.fg → features.defer_stmt.tests.defer_test
fn path_to_module(path: string, project_dir: string) -> string {
    // Strip project dir prefix
    mut rel = path
    if path.starts_with(project_dir) {
        rel = path.substring(project_dir.length, path.length)
        if rel.starts_with("/") {
            rel = rel.substring(1, rel.length)
        }
    }
    // Strip .fg extension
    if rel.ends_with(".fg") {
        rel = rel.substring(0, rel.length - 3)
    }
    rel
}

// Generate an entry point that imports all test modules and calls their exported test functions.
// Convention: each *_test.fg exports a function named test_<basename> (e.g., defer_test.fg exports test_defer).
fn generate_entry_point(test_files: string, config: TestConfig) -> string {
    mut mods = ""
    mut uses = ""
    mut calls = ""

    for path in test_files.split("\n") {
        if path == "" { continue }
        let rel = path_to_module(path, config.project_dir)
        let mod_name = forge_shell_exec("echo '${rel}' | tr '/-' '__'")
        // Derive the exported function name from the file basename
        // e.g., defer_test.fg → test_defer, const_test.fg → test_const
        let basename = forge_shell_exec("basename ${path} .fg")
        let fn_name = forge_shell_exec("echo '${basename}' | sed 's/_test$//'")
        let export_fn = "test_${fn_name}"
        mods = "${mods}mod ${mod_name}\n"
        uses = "${uses}use ${mod_name}.{${export_fn}}\n"
        calls = "${calls}    ${export_fn}()\n"
    }

    "extern fn forge_test_summary()\n${mods}${uses}\nfn main() {\n${calls}    forge_test_summary()\n}\n"
}

// ── Compilation ──

fn compile_and_run(config: TestConfig, test_files: string) -> int {
    let entry_dir = "${config.build_dir}/_test"
    forge_shell_exec_status("mkdir -p ${entry_dir}")

    // Create symlinks so module resolver finds test files
    for path in test_files.split("\n") {
        if path == "" { continue }
        let rel = path_to_module(path, config.project_dir)
        let mod_name = forge_shell_exec("echo '${rel}' | tr '/-' '__'")
        forge_shell_exec_status("ln -sf ${path} ${entry_dir}/${mod_name}.fg")
    }

    // Generate entry point
    let entry_source = generate_entry_point(test_files, config)
    forge_selfhost_write_file("${entry_dir}/main.fg", entry_source)

    // Compile
    let cov_flag = if config.coverage { " --coverage" } else { "" }
    let compile_status = forge_shell_exec_status("${config.compiler} compile${cov_flag} ${entry_dir}/main.fg >/dev/null 2>&1")
    if compile_status != 0 {
        let log = forge_shell_exec("${config.compiler} compile${cov_flag} ${entry_dir}/main.fg 2>&1")
        println("${red("compilation failed:")}")
        println(log)
        return 1
    }

    // Link
    let ll = "${entry_dir}/main.fg.ll"
    let obj = "${entry_dir}/test.o"
    let bin = "${entry_dir}/test.bin"

    let link_cmd = if config.coverage {
        let clang_rt = forge_shell_exec("ls -d ${config.llc_prefix}/lib/clang/*/lib/darwin 2>/dev/null | head -1")
        let cov_ll = "${entry_dir}/main.cov.ll"
        "${config.llc_prefix}/bin/opt -passes=instrprof -o ${cov_ll} -S ${ll} --mtriple=arm64-apple-macosx 2>/dev/null && ${config.llc} -O2 -filetype=obj ${cov_ll} -o ${obj} 2>/dev/null && cc -o ${bin} ${obj} ${config.runtime_o} ${config.llvm_wrapper_o} -Wl,-stack_size,0x2000000 -L${config.llvm_lib} -lLLVM -lc++ -L${clang_rt} -lclang_rt.profile_osx 2>/dev/null"
    } else {
        "${config.llc} -O2 -filetype=obj ${ll} -o ${obj} 2>/dev/null && cc -o ${bin} ${obj} ${config.runtime_o} ${config.llvm_wrapper_o} -Wl,-stack_size,0x2000000 -L${config.llvm_lib} -lLLVM -lc++ 2>/dev/null"
    }
    let link_status = forge_shell_exec_status(link_cmd)
    if link_status != 0 {
        println("${red("link failed")}")
        return 1
    }

    // Run
    let run_cmd = if config.coverage {
        let profraw = "${config.build_dir}/cov/tests.profraw"
        forge_shell_exec_status("mkdir -p ${config.build_dir}/cov")
        "LLVM_PROFILE_FILE=${profraw} ${bin}"
    } else {
        bin
    }

    // Forward output directly to terminal (passthrough)
    let exit_code = forge_shell_exec_status(run_cmd)

    // Coverage merge
    if config.coverage {
        merge_coverage(config)
    }

    exit_code
}

// ── Coverage ──

fn merge_coverage(config: TestConfig) {
    let cov_dir = "${config.build_dir}/cov"
    let profdata = "${cov_dir}/coverage.profdata"
    let profraw = "${cov_dir}/tests.profraw"

    if forge_selfhost_file_exists(profraw) == 0 {
        println("${red("no coverage data collected")}")
        return
    }

    let ms = forge_shell_exec_status("${config.llc_prefix}/bin/llvm-profdata merge -sparse ${profraw} -o ${profdata} 2>&1")
    if ms != 0 {
        println("${red("coverage: profdata merge failed")}")
        return
    }

    forge_shell_exec_status("rm -f ${profraw}")

    println("")
    let stats = forge_shell_exec("${config.llc_prefix}/bin/llvm-profdata show ${profdata} 2>&1")
    let fn_count = forge_shell_exec("echo '${stats}' | grep 'Total functions' | head -1")
    let block_count = forge_shell_exec("echo '${stats}' | grep 'Total number of blocks' | head -1")
    println("${bold("coverage:")} ${fn_count.trim()}, ${block_count.trim()}")
    println("${dim("profdata: ${profdata}")}")
}

// ── Public API ──

export fn run_tests(config: TestConfig) -> int {
    let test_files = discover_test_files(config)
    if test_files == "" {
        println("No test files found.")
        return 0
    }

    // Count tests
    mut count = 0
    for f in test_files.split("\n") {
        if f != "" { count = count + 1 }
    }
    println("${dim("found ${string(count)} test files")}")
    println("")

    compile_and_run(config, test_files)
}

export fn run_single_test(config: TestConfig, path: string) -> int {
    if forge_selfhost_file_exists(path) == 0 {
        println("${red("error")}: file not found: ${path}")
        return 1
    }
    compile_and_run(config, path)
}
