// WHY: @std/testing library — extern declarations for the spec/given/then
// test framework. The implementation is in runtime.c (C runtime).
// The spec/given/then syntax is a built-in language feature; this file
// provides additional utilities like skip, todo, and roughly.

extern fn avra_test_start_spec(name: string)
extern fn avra_test_end_spec()
extern fn avra_test_start_given(name: string)
extern fn avra_test_end_given()
extern fn avra_test_run_then(name: string, result: int)
extern fn avra_test_skip(name: string)
extern fn avra_test_todo(name: string)
extern fn avra_test_summary() -> int
extern fn avra_test_roughly(actual: float, expected: float, tolerance: float) -> int
extern fn avra_test_capture_start()
extern fn avra_test_capture_stop() -> string

/// Begin redirecting stdout into the test capture buffer. Pair with
/// `capture_stop()` to retrieve and reset.
///
/// ```avra
/// capture_start()
/// println("hello")
/// let output = capture_stop()
/// ```
export fn capture_start() { avra_test_capture_start() }

/// End the active stdout capture and return the buffered text.
/// Also re-enables direct stdout writes for subsequent code.
export fn capture_stop() -> string { avra_test_capture_stop() }
