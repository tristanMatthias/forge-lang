// WHY: @std/testing library — extern declarations for the spec/given/then
// test framework. The implementation is in runtime.c (C runtime).
// The spec/given/then syntax is a built-in language feature; this file
// provides additional utilities like skip, todo, and roughly.

extern fn forge_test_start_spec(name: string)
extern fn forge_test_end_spec()
extern fn forge_test_start_given(name: string)
extern fn forge_test_end_given()
extern fn forge_test_run_then(name: string, result: int)
extern fn forge_test_skip(name: string)
extern fn forge_test_todo(name: string)
extern fn forge_test_summary() -> int
extern fn forge_test_roughly(actual: float, expected: float, tolerance: float) -> int
