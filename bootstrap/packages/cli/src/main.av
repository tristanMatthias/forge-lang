fn fail(message: string) {
    eprintln(message)
    exit(1)
}

/// Diagnostic-rendering context shared by every pipeline-stage
/// helper. Carries the three knobs every renderer needs:
///
///   - `json_output` selects machine-readable F-code output
///     (`--json` flag) vs human-readable rendering.
///   - `source` is the program source string the renderer cites
///     when showing line-number context.
///   - `path` is the source-file path embedded in the rendered
///     diagnostic header (and used as the JSON `file` field).
///
/// Built once per command (cmd_check / cmd_fix / cmd_format /
/// cmd_expand / cmd_test / run_build_command) and threaded
/// through every pipeline-stage helper — replaces the
/// (json_output, source, path) triplet that previously appeared
/// in every helper signature.
type RenderContext = {
    json_output: bool,
    source: string,
    path: string,
}

fn render_ctx(json_output: bool, source: string, path: string) -> RenderContext {
    RenderContext { json_output, source, path }
}

/// Render a diagnostic bag in either human or JSON form, picked
/// by `ctx.json_output`. Both `compile` and `check` switch on the
/// `--json` flag at every pipeline stage; this helper centralises
/// the dispatch so each stage stays a one-liner.
fn render_bag_ctx(ctx: RenderContext, bag: DiagnosticBag) {
    if ctx.json_output { render_bag_json(ctx.path, bag) }
    else { render_bag(ctx.source, ctx.path, bag) }
}

/// Render the bag only if it carries any errors or warnings — the
/// no-op fast-path keeps the noise-free compile (zero diagnostics)
/// from emitting empty `Found 0 warnings.` separator output. Used
/// at every post-pass diagnostic-check site; folds the
/// `if bag_has_errors(b) || bag_has_warnings(b) { render_bag_ctx(...) }`
/// pattern into a single call.
fn render_bag_if_nonempty(ctx: RenderContext, bag: DiagnosticBag) {
    if bag_has_errors(bag) || bag_has_warnings(bag) {
        render_bag_ctx(ctx, bag)
    }
}

/// Render any diagnostics (errors or warnings) in the bag, then
/// abort the process when the bag carries errors. The render step
/// goes through `render_bag_if_nonempty` so a clean bag emits nothing.
/// Used at every site that wants both diagnostics-up-to-the-user
/// AND hard-stop-on-errors (typecheck, monomorphize).
fn render_and_fail_on_errors(bag: DiagnosticBag, ctx: RenderContext, msg: string) {
    render_bag_if_nonempty(ctx, bag)
    if bag_has_errors(bag) { fail(msg) }
}

/// Gate a `quote { ... }` used outside `@comptime`/`@expand` (i0yg): reported
/// on the PRE-lowering `ids` (each quote is still one node with its own span)
/// and hard-stopped BEFORE `lower_quotes` explodes it into `synth_*` shims that
/// would otherwise abort at run time. Every pipeline front that lowers quotes
/// runs this first.
fn fail_on_runtime_quotes(store: NodeStore, ids: List<StmtId>, ctx: RenderContext) {
    render_and_fail_on_errors(report_runtime_quotes(store, ids), ctx, "runtime quote error")
}

/// Wrap a codegen-side error string as an ICE diagnostic, render it,
/// and exit with the original error message. `compile_program`
/// returns `.Err(string)` for internal failures; both pipeline sites
/// previously open-coded the bag construction + render. Centralise.
fn fail_with_codegen_ice(error_msg: string, ctx: RenderContext) {
    let ice_bag = bag_report(bag_new(), diag_ice("internal compiler error during codegen: ${error_msg}"))
    render_bag_ctx(ctx, ice_bag)
    fail(error_msg)
}

/// Report a module-resolution failure and abort. Every module-resolve-using
/// command routes through this helper so the user sees a structured F-code
/// diagnostic instead of a bare error string.
///
/// NEST, NEVER REPLACE (t-kdyj.8). A module file that fails to PARSE carries a
/// real F0001 with a line and column. Substituting F3100 `ModuleNotFound` — as
/// this unconditionally did — reported a file that exists and was found as
/// missing, and offered "create the module file or remove the `mod`
/// declaration" for a syntax error. When the underlying message was empty (a
/// reserved-word error), the whole report was:
///
///     error[F3100]: error in `src/features/spec_test/codegen.av`:
///
/// A location, a code, and a fix, all describing a different failure, with
/// nothing said about the real one. That cost an hour and five wrong
/// hypotheses in one session, and manufactured a phantom constraint that got
/// written into a shipped PR as a known limitation.
///
/// So: when the failure carries diagnostics, render THOSE. F3100 is kept for
/// the case it actually names — a module that could not be found.
fn fail_on_module_resolve_error(mod_resolved: ModListResult, ctx: RenderContext) {
    if mod_resolved.had_error {
        // `bag_has_errors`, not "bag is non-empty": a bag carrying only
        // warnings explains nothing about why resolution failed, so the F3100
        // fallback below is still the honest report for it.
        if bag_has_errors(mod_resolved.bag) {
            render_bag_ctx(ctx, mod_resolved.bag)
            fail(mod_resolved.error_message)
        }
        let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
        render_bag_ctx(ctx, mod_bag)
        fail(mod_resolved.error_message)
    }
}

/// Parse `source` or render any parse-time bag entries and abort.
/// Canonical entry for every command that takes Avra source —
/// `cmd_check`, `cmd_fix`, `cmd_format`, `cmd_expand`, `cmd_test`,
/// `run_build_command` all enter the pipeline through this fn.
/// Renders bag warnings/errors when `parsed.had_error` is set
/// (the parser populates the bag with F0xxx codes before
/// reporting), then `fail`s with the parse-level error message.
/// Returns the parsed program + its parse-time store on success —
/// the caller continues from there.
fn parse_or_fail(source: string, ctx: RenderContext) -> ParsedProgram {
    // t-drl0: name the phase for the F4014 memory ceiling from the path the caller
    // already has, WITHOUT changing what the parser is told.
    //
    // The obvious version of this — `parse_program_source_at(source, ctx.path)` —
    // is a REGRESSION, and shipped as one in #1076. The entry file is parsed with an
    // EMPTY file name on purpose: `SrcPos.file` is what distinguishes an entry-file
    // node from a merged-module node, and the operand-span sharpening keys off it.
    // Filling it in re-pointed every single-file diagnostic at its enclosing
    // statement instead of the offending operand (`want(\n no_such + 1)` caretted
    // 3:5, the call head, instead of 4:9, the argument). Guarded by
    // resolve/tests/operand_span_resolve_test.av and the typeck operand-span specs
    // — 20 of them across the suite, which is how it was caught.
    //
    // The phase label needs the name; the PARSE does not. So stamp it here and leave
    // `parse_program_source` alone.
    avra_mem_phase_set(if ctx.path == "" { "parse <stdin>" } else { "parse ${ctx.path}" })
    let parsed = parse_program_source(source)
    if parsed.had_error || parsed.ids == null {
        if bag_has_errors(parsed.bag) {
            render_bag_ctx(ctx, parsed.bag)
        }
        fail(parsed.error_message)
    }
    let root_ids = parsed.ids!
    // B-final: the parser IS the arena producer. Every production allocated its
    // row (typed-id edges in walker order + byte-offset span side-tables +
    // provenance) during the parse itself, and the top-level rows were recorded
    // as roots. The program is those roots — every downstream pass takes
    // (roots, store) and reads nodes/positions/provenance straight from the
    // arena; there is no boxed serving step (`program_from_store` retired).
    let store = parsed.store
    // AVRA_L1_INGEST surfaces the parser's arena diagnostics (node counts,
    // span side-table). Debug-only and noisy, so gated; the canonical
    // serve-path above runs unconditionally.
    if avra_process_env_get("AVRA_L1_INGEST") == "1" {
        println("[l1-ingest] NodeStore: ${string(store.stmts.count())} stmt nodes")
        println("[l1-ingest] exprs: ${string(store.exprs.count())} rows, ${string(store.intern_hits)} interned")
        if store.stmts.count() > 0 {
            let last = StmtId(store.stmts.count())
            let sp = store.stmts.span_of(last)
            let lc = store.stmt_linecol(last)
            println("[l1-ingest] last stmt span [${string(sp.lo)},${string(sp.hi)}) line ${string(lc.line)} col ${string(lc.col)}")
        }
        println(l1_sidetable_summary(store))
    }
    ParsedProgram { ids: root_ids, store }
}

/// What `parse_or_fail` hands back: the program's top-level statement
/// ids plus the parser's own `NodeStore`, so early passes read the
/// arena directly (first consumer: the quote presence scan). The store
/// was built during the parse of exactly these `ids` — a caller that
/// merges in statements parsed elsewhere (sibling-file loading) must
/// not scan the store as if it covered the merged program.
type ParsedProgram = { ids: List<StmtId>, store: NodeStore }

/// Same shape as parse_or_fail but for the expression parser.
/// Used by cmd_expr / cmd_eval — both want F-code rendering on a
/// parse failure followed by a hard fail. Returns the parsed Expr
/// on success.
fn parse_expr_or_fail(source: string, ctx: RenderContext) -> ParseResult {
    let parsed = parse_expression_source(source)
    if parsed.had_error || parsed.expr == null {
        if bag_has_errors(parsed.bag) {
            render_bag_ctx(ctx, parsed.bag)
        }
        fail(parsed.error_message)
    }
    parsed
}

/// `--stop-after=<stage>` is run_build_command's debugging knob —
/// halt the pipeline after a specific phase with a green "ok"
/// signal. Four sites (parse / resolve / names / check) replicated
/// the same 4-line `if stop_after == "X" { println("ok"); return }`
/// shape; centralise the println + the comparison so each
/// callsite stays a one-line `if stop_after_matches(stop_after,
/// "X") { return }` guard. The caller still does its own `return`
/// because Avra doesn't have early-return-from-caller semantics.
fn stop_after_matches(stop_after: string, stage: string) -> bool {
    if stop_after == stage {
        println("ok")
        return true
    }
    false
}

/// Component-decl expand pass with built-in error-bag short-circuit.
/// Wraps the expand_components + bag_has_errors + render + fail
/// pattern that every compile / check / test pipeline site repeated.
/// Returns the post-expand stmt list on success; fails the process
/// (after rendering F4100 diagnostics) when the validator found
/// schema mismatches.
fn expand_components_or_fail(ids: List<StmtId>, ctx: RenderContext, store: NodeStore) -> List<StmtId> {
    let comp = expand_components(ids, store)
    if bag_has_errors(comp.bag) {
        render_bag_ctx(ctx, comp.bag)
        fail("component validation failed")
    }
    comp.stmts
}

/// Fetch the coarse RESOLVE query with built-in diagnostic rendering and
/// fail-on-hard-error short-circuit — the query-path successor of the old
/// marshal→resolve→render→fail helper (the marshal derive + name resolution
/// now run INSIDE the query, ps3t.8.3 Step A). A null fetch is an
/// engine-wiring bug (wrong variant / unexpected cycle), never a user error.
fn pass_resolved_or_fail(db: Db<PassValue>, ctx: RenderContext) -> NameResolveResult {
    let named = pass_fetch_resolved(db)
    if named == null { fail("internal: RESOLVE query produced no value") }
    render_bag_if_nonempty(ctx, named!.bag)
    if named!.had_error { fail(named!.error_message) }
    named!
}

/// Fetch the coarse comptime-FOLD query. The fold's bag rides back
/// UNRENDERED — callers gate or format it per their own policy, exactly as
/// they did around the direct run_comptime call.
fn pass_folded_or_fail(db: Db<PassValue>) -> ComptimeResult {
    let folded = pass_fetch_folded(db)
    if folded == null { fail("internal: FOLD query produced no value") }
    folded!
}

/// Fetch the coarse TYPECK query. The result's bag rides back unrendered
/// for the caller's gate, mirroring the direct typecheck_program call.
fn pass_typechecked_or_fail(db: Db<PassValue>) -> TypeCheckResult {
    let tc = pass_fetch_typechecked(db)
    if tc == null { fail("internal: TYPECK query produced no value") }
    tc!
}

/// What the parse→comptime FRONT of the pipeline hands to a subcommand:
/// the post-comptime statements (with their store), the comptime fold's
/// diagnostic bag, and the name resolution's registries. The bag rides
/// along UNRENDERED because the callers disagree on it: `check` gates on
/// it, `expand` formats best-effort (an unfoldable @comptime call keeps
/// its source form; its F4007 surfaces on check/compile/run).
type FrontEndResult = {
    store: NodeStore,
    stmts: List<StmtId>,
    comptime_bag: DiagnosticBag,
    resolved: NameResolveResult,
    // The pass database the front's queries ran in — callers that continue
    // the pipeline (check's typecheck) fetch their pass from the SAME db so
    // the dependency chain stays in one place (ps3t.8.3 Step A).
    db: Db<PassValue>,
}

/// The pipeline front shared by `check` and `expand`: parse, lower
/// quotes, desugar, resolve module files, inject intrinsics (AFTER
/// module resolution so stdlib's Result is visible to
/// program_declares_enum — avoids synthesizing a duplicate that dkfa
/// would flag), expand components, marshal + resolve names, run
/// comptime. Every stage up to comptime fails here with its own
/// rendered diagnostics.
fn front_pipeline_or_fail(fa: FileArg, ctx: RenderContext) -> FrontEndResult {
    let parsed_prog = parse_or_fail(fa.source, ctx)
    fail_on_runtime_quotes(parsed_prog.store, parsed_prog.ids, ctx)
    let post_quote = lower_quotes_via_store(parsed_prog.ids, parsed_prog.store)
    let desugared = desugar_program(post_quote, parsed_prog.store)
    let mod_resolved = resolve_module_files(desugared, modules_dirname(fa.path), empty_loaded_list(), parsed_prog.store)
    fail_on_module_resolve_error(mod_resolved, ctx)
    let with_intrinsics = inject_intrinsics(mod_resolved.stmts, parsed_prog.store)
    let expanded = expand_components_or_fail(with_intrinsics, ctx, parsed_prog.store)
    let db = pass_db_new(expanded, parsed_prog.store, content_id_for(fa.source))
    let named = pass_resolved_or_fail(db, ctx)
    let post_comptime = pass_folded_or_fail(db)
    FrontEndResult {
        store: parsed_prog.store,
        stmts: post_comptime.stmts,
        comptime_bag: post_comptime.bag,
        resolved: named,
        db,
    }
}

// Module file resolution and name resolution live in features/modules/.


// ── CLI component definitions ──

// Components V2: `cli`/`command` are data components whose expansion
// is library-authored in `@std.cli.cmdgen`. `@expand(expand_cli)` turns the
// `cli avra { … }` block into a top-level `let avra = App { commands: [Subcommand
// { meta: CommandSpec{…}, body: dyn Runnable }, …] }`; `@expand(expand_command)`
// turns each `command X { flag/arg/option … run() { … } }` into a
// `type Command_X` + `impl Runnable`. `flag`/`option`/`arg` leaf children
// parse as nested component blocks with no top-level `component` declaration;
// the macros read their instance name + config (`short`, `default`) directly.
// `option` in particular MUST NOT be declared — it would generate `type
// Option`, colliding with the built-in nullable `Option<T>`. Zero builder
// calls; `avra.run()` dispatches.
@expand(expand_cli)
component cli {}

@expand(expand_command)
component command implements Runnable {}

// A `avra docs` invocation's parsed arguments. Its fields mirror the
// declarative `command docs` schema (flags / options / arg) one-to-one; the
// command's `run()` block builds one from the parsed CliResult and hands it to
// run_docs_command.
type DocsArgs = {
    want_symbols: bool,
    want_short: bool,
    want_llm: bool,
    want_validate: bool,
    want_callers: bool,
    want_no_cache: bool,
    want_doctest: bool,
    want_gen: bool,
    want_print: bool,
    search_term: string,
    module_path: string,
    scope: string,
    format: string,
    query: string,
}

// "No symbol 'foo' found" + optional did-you-mean hint. Centralised
// because the docs handler hits this branch from --gen, --callers,
// and the bare-query miss path with identical formatting.
fn print_no_symbol(query: string, list: List<Sym>, hint: string) {
    let suggestion = suggest_similar(query, list)
    eprintln("")
    eprintln("  No symbol '${query}' found in project.")
    if suggestion != "" {
        eprintln("  Did you mean: ${suggestion}?")
    }
    if hint != "" {
        eprintln(hint)
    }
    eprintln("")
}

// `avra lang` — render the language reference (DiagCode + keyword
// table) from compiler internals. Writes `target/lang.av` by
// default; `--print` pipes the rendered source to stdout so CI can
// diff against the checked-in copy.
// `print_flag` (the `--print` switch) comes from the parsed CliResult: print the
// generated lang.av to stdout instead of writing it to target/lang.av.
fn run_lang_command(print_flag: bool) {
    if print_flag {
        println(render_lang_av())
        return
    }
    avra_shell_exec("mkdir -p target")
    let path = "target/lang.av"
    if write_lang_av(path) == 0 {
        eprintln("error: failed to write ${path}")
        exit(1)
    }
    println("wrote ${path}")
}

// Parsed view of `avra test ...` argv. -f/--filter narrows tests
// by file-name substring; -c/--coverage enables instrumentation;
// --lcov path turns on coverage AND writes an LCOV report there;
// --list (hkms.4) prints discovered tests and exits without compile.
// Built from the parsed CliResult by the declarative `command test` /
// `command _test_shard` run() bodies — no raw-argv scanning remains.
type TestArgs = { filter: string, coverage: bool, lcov_path: string, per_file: bool, list_only: bool, path_filters: List<string> }

extern fn avra_uptime_ms() -> int

/// Render per-phase compile timings as a single JSON object (one
/// line, no trailing newline added — println handles that). Stable
/// schema so CI / profiling tools can track regressions:
///   {"file":"<path>","total_ms":N,
///    "parse_ms":N,"desugar_ms":N,"resolve_mods_ms":N,
///    "expand_ms":N,"resolve_names_ms":N,"typeck_ms":N,
///    "monomorphize_ms":N,"codegen_ms":N}
/// Phase deltas are computed inline so callers don't need to know
/// the t_start / t_phase ordering. Tracked under
/// forge-crafting-intepreters-kkgf.
fn timings_json(t_start: int, t_parse: int, t_desugar: int, t_resolve_mods: int,
                t_expand: int, t_names: int, t_typeck: int, t_mono: int,
                t_codegen: int, file_path: string) -> string {
    // No string-interpolation `${X}` after `let X = …` — the resolver's
    // self-init check trips when a let-bound name is referenced from
    // a later `${…}` template within the same expression chain.
    // Inlining the deltas into each interpolation keeps the let
    // bindings out of the binding-name lookup space.
    "{\"file\":\"" + file_path + "\"" +
    ",\"total_ms\":" + string(t_codegen - t_start) +
    ",\"parse_ms\":" + string(t_parse - t_start) +
    ",\"desugar_ms\":" + string(t_desugar - t_parse) +
    ",\"resolve_mods_ms\":" + string(t_resolve_mods - t_desugar) +
    ",\"expand_ms\":" + string(t_expand - t_resolve_mods) +
    ",\"resolve_names_ms\":" + string(t_names - t_expand) +
    ",\"typeck_ms\":" + string(t_typeck - t_names) +
    ",\"monomorphize_ms\":" + string(t_mono - t_typeck) +
    ",\"codegen_ms\":" + string(t_codegen - t_mono) +
    "}"
}


/// Parsed view of `avra build ...` argv.
///   --release             select [profile.release] over [profile.dev]
///   --explain             cargo-style rebuild attribution
///   --json                emit one JSON event per line (for IDE tooling)
///                         in lieu of human-readable output
///   --timings             write build/timings/<unit>-<fp>.html with
///                         per-phase wall times (cargo --timings analogue)
///   entry (positional)    override the manifest [bin].path
// `--lib` (the BuildArgs.lib field below) selects the manifest's
// g2eo level-1: emit per-file metadata sidecars. Walks the discovered
// source-file list, computes a per-file fingerprint (sha256 of file
// contents), extracts a per-file UnitMetadata slice, and writes it to
// `<file>.meta.bin`. Entry-point file is skipped — its sidecar is
// the whole-unit slice consumers expect, written upstream.
fn emit_per_file_metas(files: List<string>, stmts: List<StmtId>, unit_name: string, entry_path: string, store: NodeStore) {
    mut i = 0
    while i < files.length {
        let file_path = files[i]
        // Skip the entry — its sidecar is the whole-unit slice
        // (consumers read that). Skip "" too: a stmt the resolver
        // synthesised mid-pipeline (no source location) shouldn't
        // produce a phantom .meta.bin.
        if file_path != entry_path && file_path != "" {
            let src = avra_selfhost_read_file(file_path)
            let fp = bytes_from_hex(sha256_hex(src))
            let m = extract_per_file_metadata(unit_name, file_path, fp, stmts, store)
            // 0qmm: write ONLY to the content-addressed cache slot.
            // No fixed-path sidecar — the cache is the single source
            // of truth. package_root_for_file handles both /src/
            // layouts and flat /tmp fixtures uniformly.
            let pkg_root = package_root_for_file(file_path)
            let cache = cache_for(pkg_root)
            let source_fp = Fingerprint { hex: sha256_hex(src) }
            let _ = ensure_source_meta_dir(cache, source_fp)
            let cache_path = entry_source_meta_path(cache, source_fp)
            if metadata_write(cache_path, m) != 1 {
                fail("per-file metadata write failed for ${cache_path}")
            }
        }
        i = i + 1
    }
}

// [lib] target instead of [bin]. Foundational for
// forge-crafting-intepreters-2f54 (split @std.avrac as a separately-
// cached unit): a library is just a build target whose entry is an
// avrac.av / lib.av root; the cache key and outputs work the same
// as for a binary.
type BuildArgs = {
    release: bool,
    explain: bool,
    json: bool,
    timings: bool,
    lib: bool,
    emit_metadata: bool,
    per_module: bool,
    entry: string,
    output: string,
}

// `avra build` — Phase 1 incremental wrapper around `avra compile`.
// Reads the project's avra.toml, computes the per-unit fingerprint,
// consults the @std.avrac.build cache, and:
//   * on a Hit, copies the cached IR to where compile would write it
//     and skips the codegen pipeline entirely
//   * on a Miss, exec's the existing `bs2 compile` flow (subprocess so
//     we get proven codegen behaviour for free), then publishes the
//     produced .ll into the cache for the next invocation
//
// Phase 1 treats the entry source as a single unit. Phase 2 (dep
// graph extractor, see ticket eh00) carves it into per-package /
// per-module units; the driver's surface (decide / record) does
// not need to change for that step.
// Walk the manifest's [dependencies] list and, for each dep with a
// resolved local `path`, recursively invoke `bs2 build --lib
// --emit_metadata` from the dep's project root. Path-less deps
// (registry versions, git refs) are skipped — they'll come back
// when resolution actually pulls them locally.
//
// Workers run through the shared resource controller. Path-deps are
// independent today (no inter-dep ordering recorded in the manifest), so a
// bounded queue is sound; the controller derives its width from the current
// CPU/memory scope and learns its cost per build profile. Once topo ordering
// matters, this queue becomes a wave scheduler (forge-crafting-intepreters-e20h
// Phase 2) without changing resource policy.
//
// Returns 0 on success; otherwise the queue's worst worker exit code.
//
// Tracking ticket: forge-crafting-intepreters-2f54 + e20h.
// pdme.5: one pre-build's cache accounting, read back from the per-dep
// child logs. `rc` carries the pool's exit status (the parent's
// existing hard-fail gate); hits/misses/detail feed the end-of-build
// `[cache]` summary line so a suspiciously fast or slow build explains
// itself without --explain re-runs.
type PreDepOutcome = {
    rc: int,
    hits: int,
    misses: int,
    detail: string,
}

fn pre_dep_outcome_empty() -> PreDepOutcome {
    PreDepOutcome { rc: 0, hits: 0, misses: 0, detail: "" }
}

/// Run a generic build work queue under the resource controller. Keeping
/// profile construction, prior persistence, and end-of-run reporting here
/// prevents every build phase from growing its own jobs/env-var policy.
fn run_build_resource_pool(commands: List<string>, project_dir: string, compiler_path: string, work_kind: string, plan_shape: string) -> int {
    if commands.length == 0 { return 0 }
    let snapshot = resource_snapshot()
    let profile = resource_profile(work_kind, sha256_file(compiler_path), plan_shape)
    let prior_path = admission_prior_path("${project_dir}/build/cache", resource_profile_key(profile))
    let gov = resource_controller_for_policy(profile, resource_build_pool_policy(profile), snapshot)
    gov.seed_estimate(read_admission_prior(prior_path))
    let rc = pool_run_resource_admitted(commands, gov, () -> resource_snapshot())
    persist_admission_prior(prior_path, gov.observed_mb, gov.static_estimate_mb, rc == 0)
    eprintln("[resources] build ${work_kind}: profile=${resource_runtime_mode_label(profile.runtime_mode)}, scope=${resource_scope_label(snapshot.scope)}, pressure=${resource_pressure_label(snapshot.pressure)}; ${gov.summary()}")
    rc
}

// Classify each per-dep child log as cache HIT or MISS, keeping the
// miss ATTRIBUTION for the summary line. Children run `bs2 build
// --explain`, so a hit prints `cached <fp> — …` and a miss prints
// `rebuild <fp> — <reason>` (both line-anchored here so prose like
// "rebuilding" can't false-match). A log with neither marker counts
// as a miss with the log's own name as the only attribution — a child
// that died pre-decision shouldn't inflate the hit count.
fn tally_dep_logs(log_dir: string) -> PreDepOutcome {
    let listing = avra_shell_exec("ls '${log_dir}'/*.log 2>/dev/null")
    mut hits = 0
    mut misses = 0
    mut detail = ""
    for f in split_by_newline(listing) {
        if f == "" { continue }
        let content = avra_selfhost_read_file(f)
        if content.starts_with("cached ") || content.contains("\ncached ")
            || content.starts_with("Cached ") || content.contains("\nCached ") {
            hits = hits + 1
        } else {
            misses = misses + 1
            // basename_no_ext: `…/pre_deps.123/std-json.log` → `std-json`.
            detail = detail + "; " + basename_no_ext(f) + " MISS [" + dep_log_miss_reason(content) + "]"
        }
    }
    PreDepOutcome { rc: 0, hits: hits, misses: misses, detail: detail }
}

// Pull the attribution out of the child's `rebuild <fp> — <reason>`
// line (--explain output). Falls back to "rebuilt" when the line is
// absent (child crashed before the decision, or an older bs2).
fn dep_log_miss_reason(content: string) -> string {
    let anchored = "\n" + content
    let ri = anchored.index_of("\nrebuild ")
    if ri < 0 { return "rebuilt" }
    let rest = anchored.substring(ri + 1, anchored.length)
    let nl = rest.index_of("\n")
    let line = if nl < 0 { rest } else { rest.substring(0, nl) }
    let dash = line.index_of(" — ")
    if dash < 0 { return "rebuilt" }
    line.substring(dash + " — ".length, line.length)
}

fn pre_build_path_deps(deps: List<Dep>, compiler_path: string, args: BuildArgs) -> PreDepOutcome {
    let path_count = count_path_deps(deps)
    if path_count == 0 { return pre_dep_outcome_empty() }
    let project_dir = avra_process_env_get("PWD")
    let plan_shape = "deps=${string(path_count)};emit_metadata=1"
    // TTY-aware split (5gvp): pipe-redirected stdout takes the
    // pure-Avra worker pool path so CI logs stay byte-identical to
    // before. An interactive terminal gets a multi-line progress bar
    // tracking running unit names + completion count (still uses the
    // marker-file approach since the pool primitive doesn't surface
    // per-job state).
    if progress_should_render() && !args.json {
        // The dep-paths list feeds ONLY this progress runner (the pool
        // branch below builds its cmds straight from `deps`), so it is
        // written here — pid-scoped, so concurrent builds can't append
        // into one shared list — and removed once its one consumer is
        // done with it.
        let paths_file = "/tmp/avra_pre_deps.${string(avra_getpid())}.list"
        avra_shell_exec("rm -f ${paths_file}")
        write_dep_paths(deps, paths_file)
        let out = run_pre_deps_with_progress(paths_file, compiler_path, path_count, project_dir, plan_shape)
        avra_shell_exec("rm -f ${paths_file}")
        return out
    }
    // Pure-Avra worker pool replaces the prior xargs -P invocation
    // (e20h Phase 2). Same parallelism semantics, no shell xargs
    // dependency, hermetic isolation per cmd. Foundation for future
    // topo-aware scheduling (g2eo level-2 per-mod build dispatch).
    // Per-dep logs (pid-scoped — the orphaned-run lesson): the tally
    // reads them back for the [cache] summary, and a failed dep's
    // output stays inspectable instead of vanishing into /dev/null.
    let log_dir = "${project_dir}/build/pre_deps.${string(avra_getpid())}"
    avra_shell_exec("rm -rf '${log_dir}' && mkdir -p '${log_dir}'")
    let cmds = build_pre_dep_cmds(deps, compiler_path, log_dir)
    let rc = run_build_resource_pool(cmds, project_dir, compiler_path, "build-path-dependency", plan_shape)
    if rc != 0 {
        eprintln("pre-build failed — per-dep logs: ${log_dir}/")
        return PreDepOutcome { rc: rc, hits: 0, misses: 0, detail: "" }
    }
    let out = tally_dep_logs(log_dir)
    avra_shell_exec("rm -rf '${log_dir}'")
    out
}

// Build the queue of `cd <path> && bs2 build --lib --emit_metadata`
// commands the pool will dispatch — one per path-dep. Skips deps
// whose `path` is empty (registry/git-ref deps not yet resolved
// locally).
//
// Each dep build sets its own AVRA_LIB_PKG_ROOT derived from the
// dep's path (`packages/std-<name>/` → `@std::<name>`) so codegen
// emits ONLY that dep's symbols — preventing duplicate-symbol
// errors when multiple dep .o files link together. The outer
// build's AVRA_LIB_PKG_ROOT would mis-bucket every dep fn as
// foreign and produce a 3-define truncated .ll; we override
// per-dep here.
fn build_pre_dep_cmds(deps: List<Dep>, compiler_path: string, log_dir: string) -> List<string> {
    mut cmds: List<string> = []
    mut i = 0
    while i < deps.length {
        let dep = deps[i]
        if dep.path != "" {
            let lib_root = derive_lib_root_for(dep.path)
            // ALWAYS explicit — '' for non-std deps: the outer lib build
            // runs with its own AVRA_LIB_PKG_ROOT in the process env
            // (derived in run_build_command), and an inherited outer root
            // would mis-bucket a non-std dep's fns exactly as described
            // above. An explicit empty root lets the dep's own
            // run_build_command derive what is right for ITS package.
            let env_prefix = "AVRA_LIB_PKG_ROOT='${lib_root}' "
            // --explain so the log carries the hit/miss line + miss
            // attribution the parent's tally reads back (pdme.5).
            let log_path = "${log_dir}/${slug_of_path(dep.path)}.log"
            cmds.push("cd \"${dep.path}\" && ${env_prefix}\"${compiler_path}\" build --lib --emit_metadata --explain > \"${log_path}\" 2>&1")
        }
        i = i + 1
    }
    cmds
}

// P6 library-mode: pre-build every `packages/std-*` package as a
// library so the per-file test runner can enable AVRA_USE_METADATA=1
// in shard commands. Without this, each shard re-parses the entire
// @std universe — the dominant cost in cold full-suite runs.
//
// Discovers packages via ls + filter on the `std-` prefix. Each
// build invocation chdirs into the package and runs `bs2 build
// --lib --emit_metadata`, which (a) emits metadata.bin in the
// per-package cache slot (P3+P4+P5: includes generic bodies) and
// (b) produces a real Mach-O .o (P1 lazy realobj). The pool
// dispatches them in parallel honouring `jobs`.
//
// Returns 0 on success, or the worst rc returned by any package
// build. Caller decides whether a non-zero rc disables the metadata
// fast-path or hard-fails — we soft-fail so a single broken
// package can't take down the whole test run.
fn pre_build_workspace_std_packages(project_dir: string, compiler_path: string) -> int {
    let listing = avra_shell_exec("ls -d '${project_dir}/packages'/std-*/ 2>/dev/null")
    if listing == "" { return 0 }
    let pkg_dirs = split_by_newline(listing)
    mut cmds: List<string> = []
    mut i = 0
    while i < pkg_dirs.length {
        let dir = pkg_dirs[i]
        if dir != "" {
            // Sanity: only enqueue if the dir actually has an
            // avra.toml. A stray dir under packages/std-* without
            // a manifest would silently skip the build and leave
            // the meta slot empty.
            if avra_selfhost_file_exists("${dir}avra.toml") != 0 {
                // P2 codegen lib-mode: each package's build sets
                // AVRA_LIB_PKG_ROOT to its qualified prefix so the
                // emitted .o contains only THIS package's symbols.
                // Without this, every package's .o is whole-program
                // and linking two packages together produces
                // thousands of duplicate-symbol errors (which is
                // exactly what 6owa's link step hit before this fix).
                //
                // Qualified prefix derives from `packages/std-<name>/`
                // → `@std::<name>`. Hard-coded here as
                // `derive_lib_root_for(dir)` rather than parsing
                // avra.toml (the [package].name field would work too
                // but adds a load_manifest call per dir).
                let lib_root = derive_lib_root_for(dir)
                // 70zy: each pkg's build reads its deps' meta.bin stubs instead
                // of re-parsing their source. std-avrac is alphabetically first
                // and has no deps that benefit (it IS the bulk of @std), so it
                // pays the full ~12s; every other std-* pkg goes 9s → 0.4s.
                cmds.push(std_prebuild_cmd(dir, lib_root, compiler_path))
            }
        }
        i = i + 1
    }
    if cmds.length == 0 { return 0 }
    // SERIAL (jobs=1): the dirs are alphabetical so std-avrac (the base every
    // other std-* reads via the AVRA_USE_METADATA fast-path) builds first, and
    // each dependent in turn sub-builds its deps. Running these in parallel
    // raced on the shared per-dep cache slot / an absent std-avrac meta.bin —
    // the pre-build failed (rc=1), the fast-path got disabled, and shards fell
    // back to whole-program compiles that OOM-killed ~40 shards (08ro). The
    // serial cost is ~2s (12s base + 6×0.4s deps) vs the racy parallel path.
    pool_run(cmds, 1)
}

/// Translate a `packages/std-NAME/` or `../std-NAME` (relative)
/// dir path into the package's canonical qualified prefix:
/// `@std::NAME`. Used by pre_build_workspace_std_packages to set
/// AVRA_LIB_PKG_ROOT per package so codegen emits only that
/// package's symbols. Also used by build_pre_dep_cmds where the
/// path is dep-relative (e.g. `../std-cli` from `packages/std-avrac/`).
///
/// Algorithm: locate `std-` in the path (with or without
/// `packages/` prefix), take everything from the next char up to
/// the next `/` or end-of-string as the package suffix. Returns
/// "" when no `std-` segment exists (non-std deps skip the env
/// var; they build whole-program as before).
fn derive_lib_root_for(dir: string) -> string {
    // Find the LAST occurrence of "/std-" or a leading "std-".
    // Walking right-to-left handles both `packages/std-cli/` and
    // `../std-cli` shapes without committing to a `packages/`
    // prefix that dep-relative paths don't have.
    let needle = "/std-"
    let lead = "std-"
    let start = compute_start(dir, needle, lead)
    if start < 0 { return "" }
    mut j = start
    while j < dir.length {
        if dir.byte(j) == 0x2F { break }
        j = j + 1
    }
    if j == start { return "" }
    "@std::" + dir.substring(start, j)
}

fn compute_start(dir: string, needle: string, lead: string) -> int {
    let li = last_index_of(dir, needle)
    if li >= 0 { return li + needle.length }
    if dir.starts_with(lead) { return lead.length }
    -1
}

/// Last-occurrence string search — `.index_of` returns the first
/// match; we need the last so `packages/std-avrac/.../std-cli`
/// resolves to `@std::cli` (the dep) rather than `@std::avrac`
/// (the dispatcher's own path). Returns -1 on miss.
fn last_index_of(s: string, needle: string) -> int {
    if needle.length == 0 { return -1 }
    if needle.length > s.length { return -1 }
    mut i = s.length - needle.length
    while i >= 0 {
        if s.substring(i, i + needle.length) == needle { return i }
        i = i - 1
    }
    -1
}

// Split a newline-separated string into a List<string>, dropping
// empty lines. Used by the workspace-package discovery walker —
// `ls -d` produces one path per line plus a trailing newline that
// `.split("\n")` would otherwise emit as a trailing empty entry.
fn split_by_newline(s: string) -> List<string> {
    mut out: List<string> = []
    for p in s.split("\n") {
        if p != "" { out.push(p) }
    }
    out
}

// g2eo Phase B: per-module compile dispatcher.
//
// Splits the package's `<root>/src/` into N units — one per
// top-level subdirectory — and runs `bs2 compile` against each in
// parallel via pool_run. Every invocation passes:
//   --module_path=@<scope>::<pkg>           — same package wrapper
//                                             every consumer sees
//   --target_module=src/<subdir>/           — the per-mod filter:
//                                             only this subdir's
//                                             bodies emit; everything
//                                             else gets @external_unit
//   --output=<out_dir>/<subdir>.ll          — distinct path per
//                                             unit so concurrent
//                                             writers don't race
//   --emit_metadata                         — sidecar describing
//                                             this unit's surface
// Outputs land in `<root>/build/per_mod/`. Each run produces an
// `.ll` (target subdir's bodies + forward decls for everything
// else) and a co-located `.meta.bin` (this unit's surface only).
//
// Skips silently when the package has no manifest, no [package].name,
// or no `src/` subdirectories — single-source packages are already
// served by the existing single-unit build path.
//
// Cache integration is deferred: this prototype emits .ll/.meta.bin
// next to the source tree so a build driver can pick them up.
// Topo ordering and per-unit fingerprint caching land in the
// follow-up Phase B.2 (driver wave scheduler) and Phase B.3 (link).
//
// Tracking ticket: forge-crafting-intepreters-g2eo Phase B.
fn pre_build_subdir_units(project_dir: string, manifest_name: string, compiler_path: string, args: BuildArgs) -> int {
    if manifest_name == "" { return 0 }
    let pkg_qual = manifest_name.replace("/", "::")
    if pkg_qual == "" { return 0 }
    let src_dir = "${project_dir}/src/"
    let subdirs = list_avra_module_subdirs(src_dir)
    if subdirs.length == 0 { return 0 }
    let out_dir = "${project_dir}/build/per_mod"
    avra_shell_exec("mkdir -p ${out_dir}")
    // The `entry` is just the package's avrac.av-style root — empty
    // body after dir-as-module migration, but the resolver still
    // needs a file to anchor module-path wrapping. Pull from manifest
    // when present, else fall back to <src>/avrac.av which exists
    // for the bootstrap's own self-build (the only consumer right now).
    let entry_path = if args.entry != "" { args.entry } else { "${src_dir}avrac.av" }
    if !file_exists(entry_path) {
        eprintln("[per-module] entry not found: ${entry_path}")
        return 1
    }
    mut cmds: List<string> = []
    mut slugs: List<string> = []
    mut hits = 0
    mut i = 0
    while i < subdirs.length {
        let sub = subdirs[i]
        let sub_name = subdir_basename(sub)
        if sub_name == "" {
            i = i + 1
            continue
        }
        // Per-mod target prefix: substring match against each row's
        // recorded source file, which the resolver stores relative to the
        // cwd of the invoking compile. Running `bs2 compile` from `project_dir`
        // makes paths look like `src/<sub>/foo.av`, so the target
        // prefix matches exactly.
        let target = "src/${sub_name}/"
        let out_ll = "${out_dir}/${sub_name}.ll"
        // g2eo Phase B.4: simple mtime-based incremental rebuild gate.
        // Skip the per-mod compile when its .o is newer than every
        // .av file in the subdir (and the entry, since the wrapper
        // affects which decls land in the unit). Conservative compared
        // to a full sha256 fingerprint cache — false misses only, no
        // false hits — and lets `bs2 build --per_module` re-runs skip
        // unchanged units without integrating with @std.avrac.build's
        // full cache layout.
        let out_o = "${out_dir}/${sub_name}.o"
        let out_meta = "${out_dir}/${sub_name}.ll.meta.bin"
        if avra_selfhost_file_exists(out_o) != 0 && avra_selfhost_file_exists(out_meta) != 0 {
            if per_mod_outputs_fresh(sub, out_o, entry_path) {
                hits = hits + 1
                i = i + 1
                continue
            }
        }
        let cmd = "cd \"${project_dir}\" && \"${compiler_path}\" compile --module_path='${pkg_qual}' --target_module='${target}' --emit_metadata --output='${out_ll}' '${entry_path}' > '${out_dir}/${sub_name}.log' 2>&1"
        cmds.push(cmd)
        slugs.push(sub_name)
        i = i + 1
    }
    if hits > 0 && !args.json {
        eprintln("[per-module] cache hit on ${string(hits)} unchanged unit(s)")
    }
    // Phase C: also run one extra compile WITHOUT --target_module
    // alongside the per-mod ones. That extra invocation produces the
    // unit-level `<entry>.meta.bin` consumers expect at the legacy
    // path — the existing AVRA_USE_METADATA fast-path looks for it
    // colocated with the entry source. Without this, a downstream
    // `bs2 compile` against `cli/main.av` can't find any std-avrac
    // metadata and falls back to a full re-parse, defeating the
    // point of having pre-built per-mod artefacts.
    //
    // Cost: one additional full-package compile per `bs2 build
    // --per_module` invocation. Tradeoff is acceptable for the
    // Phase B prototype — the merge-per-mod-metas-into-unit-meta
    // path is the right long-term answer (no extra compile pass)
    // but needs a dedicated metadata-merge function.
    let unit_meta_log = "${out_dir}/_unit_meta.log"
    let unit_meta_cmd = "cd \"${project_dir}\" && \"${compiler_path}\" compile --module_path='${pkg_qual}' --emit_metadata '${entry_path}' > '${unit_meta_log}' 2>&1"
    cmds.push(unit_meta_cmd)
    slugs.push("_unit_meta")
    let total = cmds.length
    let compile_plan = "modules=${string(total)};emit_metadata=1"
    // Phase C UI: when stdout is a TTY and --json isn't on, spawn the
    // pool as a subprocess + poll the marker_dir in the foreground
    // for a multi-line progress bar (same shape as the path-deps TTY
    // branch). Falls back to silent pool_run when stdout is piped
    // (CI logs stay byte-clean).
    let want_progress = progress_should_render() && !args.json
    let cc_rc = if want_progress {
        run_per_mod_with_progress(cmds, slugs, out_dir, total, project_dir, compiler_path, "build-module-compile", compile_plan)
    } else {
        if !args.json {
            eprintln("[per-module] dispatching ${string(total)} compile units to resource-admitted pool")
        }
        run_build_resource_pool(cmds, project_dir, compiler_path, "build-module-compile", compile_plan)
    }
    if cc_rc != 0 {
        eprintln("[per-module] one or more compile units failed (rc=${string(cc_rc)}) — see ${out_dir}/<unit>.log or ${unit_meta_log}")
        return cc_rc
    }
    // Phase B.2: llc each per-mod .ll → .o in parallel. The shared resource
    // controller owns its width. The downstream link step expects
    // object files (`link_objects` from k21v takes List<.o>), so
    // this is the final step before a multi-unit link.
    // Resolve llc the same way the coverage path does: $LLVM_PREFIX
    // when set, otherwise the probed platform install. Plain `llc`
    // rarely sits on $PATH on macOS.
    let llc_bin = "${resolve_llvm_prefix()}/bin/llc"
    mut llc_cmds = []
    mut k = 0
    while k < subdirs.length {
        let sl = subdir_basename(subdirs[k])
        if sl == "" {
            k = k + 1
            continue
        }
        let ll = "${out_dir}/${sl}.ll"
        let o = "${out_dir}/${sl}.o"
        // B.4 incremental: skip llc when .o is fresh against its .ll.
        // The compile-step gate above already handled the .ll vs
        // sources case; here we just dodge re-llc'ing an unchanged
        // .ll. Only relevant for fully cached subdirs (cmds list
        // empty for them, so the .ll never moved).
        if avra_selfhost_file_exists(o) != 0 && avra_selfhost_file_exists(ll) != 0 {
            let o_m = avra_file_mtime(o)
            let ll_m = avra_file_mtime(ll)
            if o_m > 0 && ll_m > 0 && o_m >= ll_m {
                k = k + 1
                continue
            }
        }
        // rrio: materialise the .o ATOMICALLY (llc → per-pid temp → rename),
        // so a killed/OOM'd llc can't leave a truncated `${o}` that the
        // mtime-freshness skip above would reuse as complete on the next run.
        llc_cmds.push(atomic_obj_llc_cmd(llc_bin, "-O0", ll, o, "${out_dir}/${sl}.llc.log", avra_getpid()))
        k = k + 1
    }
    if !args.json {
        eprintln("[per-module] llc'ing ${string(llc_cmds.length)} units to .o (resource-admitted)")
    }
    // rrio: sweep stale `.o.tmp.*` orphans left by a PRIOR build that was
    // hard-killed (OOM/SIGKILL) before atomic_obj_llc_cmd's own `|| rm`
    // cleanup could run. They're correctness-neutral — a `.o.tmp.<pid>`
    // never matches ar's `*.o` glob — but this tree runs under real OOM
    // pressure, so don't let them accumulate. Safe here: it runs before the
    // pool creates THIS build's fresh temps, and a package's per-module
    // out_dir has no concurrent producer (they would already collide on <sl>.o).
    let _ = avra_shell_exec("rm -f '${out_dir}'/*.o.tmp.* 2>/dev/null")
    let llc_plan = "objects=${string(llc_cmds.length)};opt=O0"
    let llc_rc = run_build_resource_pool(llc_cmds, project_dir, compiler_path, "build-module-codegen", llc_plan)
    if llc_rc != 0 {
        eprintln("[per-module] llc failed for one or more units (rc=${string(llc_rc)}) — see ${out_dir}/<unit>.llc.log")
        return llc_rc
    }
    // Phase B.3: bundle the per-mod .o files into a static archive
    // so a downstream link step (or another tool: `clang lib.a`,
    // `ld -r`, etc.) consumes them as one input rather than enumerating
    // build/per_mod/*.o by hand. The archive name follows the package's
    // [lib].name when the manifest declares one — same shape every
    // cargo-style tooling expects (`lib<name>.a`).
    let archive_name = subdir_basename(manifest_name).replace("@", "").replace("/", "_")
    let archive_path = "${out_dir}/lib${archive_name}.a"
    let ar_cmd = "ar rcs '${archive_path}' ${out_dir}/*.o > '${out_dir}/ar.log' 2>&1"
    let ar_rc = avra_shell_exec_status(ar_cmd)
    if ar_rc != 0 {
        eprintln("[per-module] ar failed (rc=${string(ar_rc)}) — see ${out_dir}/ar.log")
        return ar_rc
    }
    if !args.json {
        eprintln("[per-module] ${string(slugs.length)} .ll + .o + .meta.bin + lib${archive_name}.a written to ${out_dir}/")
    }
    0
}

// True when `out_o` is newer than every `.av` file reachable from
// `sub_dir` (recursively) AND newer than `entry_path`. The recursive
// walk covers nested feature subdirs (e.g. features/eval/, features/
// closures/) so editing any leaf invalidates its parent module's
// per-mod cache. Conservative: any source we can't stat is treated
// as newer (force rebuild). Used by pre_build_subdir_units's
// incremental-rebuild gate.
fn per_mod_outputs_fresh(sub_dir: string, out_o: string, entry_path: string) -> bool {
    let out_mtime = avra_file_mtime(out_o)
    if out_mtime <= 0 { return false }
    let entry_mtime = avra_file_mtime(entry_path)
    if entry_mtime <= 0 || entry_mtime > out_mtime { return false }
    sub_dir_mtime_le(sub_dir, out_mtime)
}

// Walk `dir` recursively; return false the moment any `.av` source
// has mtime > `cap`. Empty dirs and missing dirs return true (no
// invalidation — we built more recently than there is to read).
fn sub_dir_mtime_le(dir: string, cap: int) -> bool {
    if avra_is_dir(dir) == 0 { return true }
    let entries = avra_readdir(dir)
    let prefix = if dir.length > 0 && dir.byte(dir.length - 1) == 0x2F { dir } else { dir + "/" }
    mut i = 0
    while i < entries.length {
        let name = entries[i]
        if name == "" || name.byte(0) == 0x2E {
            i = i + 1
            continue
        }
        let path = prefix + name
        if avra_is_dir(path) != 0 {
            if !sub_dir_mtime_le(path, cap) { return false }
        } else if avra_str_ends_with(name, ".av") != 0 {
            let m = avra_file_mtime(path)
            if m <= 0 || m > cap { return false }
        }
        i = i + 1
    }
    true
}

// Return the trailing path segment of `p`, stripping any trailing
// slash. `/foo/bar/` → `bar`. Mirrors `slug_of_path` but kept local
// to the per-mod dispatcher so the caller doesn't have to navigate
// through the TTY-progress code path's helpers.
fn subdir_basename(p: string) -> string {
    if p.length == 0 { return "" }
    let trimmed = if p.byte(p.length - 1) == 0x2F { p.substring(0, p.length - 1) } else { p }
    let len = trimmed.length
    mut i = len
    while i > 0 {
        let prev = i - 1
        if trimmed.byte(prev) == 0x2F {
            return trimmed.substring(i, len)
        }
        i = prev
    }
    trimmed
}

// g2eo Phase C: TTY progress bar for the per-module dispatcher.
// Mirror of run_pre_deps_with_progress but for sub-mod units —
// spawns the dispatcher in the background (so the foreground stays
// free to render) and polls `<marker_dir>/<slug>.{running,done}`
// for a multi-line "K/N done · running: a, b, c" view.
//
// The marker_dir is the same `build/per_mod/` we already write
// .ll/.o into; tmp is unnecessary because per-mod artefacts are
// project-local. The background child runs the same generic Avra
// resource pool as pipe mode, so the renderer is observational only — it
// never substitutes a shell semaphore for admission control.
fn run_per_mod_with_progress(cmds: List<string>, slugs: List<string>, marker_dir: string, total: int, project_dir: string, compiler_path: string, work_kind: string, plan_shape: string) -> int {
    let pool_handle = spawn_resource_pool_async(cmds, slugs, marker_dir, project_dir, compiler_path, work_kind, plan_shape)
    if pool_handle < 0 {
        // Spawn failed — preserve the same resource policy synchronously.
        return run_build_resource_pool(cmds, project_dir, compiler_path, work_kind, plan_shape)
    }
    let t_start = avra_uptime_ms()
    mut prev_lines = 0
    while avra_process_is_alive(pool_handle) != 0 {
        let done = count_done_markers(marker_dir)
        let running = list_running_slugs(marker_dir)
        let elapsed = avra_uptime_ms() - t_start
        prev_lines = progress_render(prev_lines, total, done, running, elapsed)
        avra_sleep_ms(100)
    }
    let final_json = avra_process_wait(pool_handle)
    let exit_code = pool_extract_rc(final_json)
    report_resource_pool_summary(marker_dir)
    let final_done = count_done_markers(marker_dir)
    let final_elapsed = format_elapsed_seconds(avra_uptime_ms() - t_start)
    progress_clear(prev_lines)
    if exit_code == 0 {
        println("built ${string(final_done)} per-mod units in ${final_elapsed}")
    } else {
        println("per-module build failed (rc=${string(exit_code)} after ${final_elapsed}) — see logs in ${marker_dir}/")
    }
    exit_code
}

// ── 5gvp: TTY progress bar for parallel path-dep pre-build ─────────────
//
// The xargs workers each `touch ${marker_dir}/${slug}.{running,done}` so
// a polling watcher can read job state without parsing xargs's output.
// Slug = path-tail with non-alphanum collapsed to `_`. Markers live in
// /tmp under a session-unique dir (uptime-ms suffix) so concurrent
// `bs2 build` invocations don't clobber each other.
//
// Render layout (one parallel job per running line):
//   building 5 deps · 4/5 done · 3.2s
//   ⠋ std-json
//   ⠋ std-cli
// On each tick we emit `\033[<N>A\r\033[J` to wipe the previous N lines
// then re-print the current state. Suppressed when stdout isn't a TTY
// (CI logs stay clean) or when --json is on (machine-parseable contract
// trumps progress).

extern fn avra_isatty_stdout() -> int
extern fn avra_process_spawn_bg(cmd: string, args_json: string, opts_json: string) -> int
extern fn avra_process_is_alive(handle: int) -> int
extern fn avra_process_wait(handle: int) -> string
extern fn avra_sleep_ms(ms: int)
extern fn avra_parse_int(s: string) -> int
extern fn avra_stdout_write(s: string)

fn progress_should_render() -> bool {
    avra_isatty_stdout() != 0
}

fn progress_marker_dir() -> string {
    "/tmp/avra_progress_${string(avra_uptime_ms())}"
}

// Last path component with `/` stripped — keeps display short (e.g.
// `../packages/std-json` → `std-json`). Used both as user-visible name
// and as the per-job marker filename.
fn dep_unit_slug(path: string) -> string {
    mut end = path.length
    while end > 0 && path.byte(end - 1) == 0x2F { end = end - 1 }
    mut start = end
    while start > 0 && path.byte(start - 1) != 0x2F { start = start - 1 }
    path.substring(start, end)
}

fn count_done_markers(marker_dir: string) -> int {
    let raw = avra_shell_exec("ls -1 ${marker_dir}/ 2>/dev/null | grep -c '\\.done$' || echo 0")
    avra_parse_int(raw.trim())
}

// Newline-separated list of currently-running unit slugs. Returns "" if
// none — caller handles that case so we don't emit a stray empty line.
fn list_running_slugs(marker_dir: string) -> string {
    avra_shell_exec("ls -1 ${marker_dir}/ 2>/dev/null | grep '\\.running$' | sed 's/\\.running$//' || true")
}

fn render_running_lines(running: string) -> string {
    if running == "" { return "" }
    mut out = ""
    mut i = 0
    let len = running.length
    mut start = 0
    while i <= len {
        if i == len || running.byte(i) == 0x0A {
            if i > start {
                let slug = running.substring(start, i)
                out = out + "  • ${slug}\n"
            }
            start = i + 1
        }
        i = i + 1
    }
    out
}

// Emit \x1b[<n>A to move cursor up, then \x1b[J to clear from cursor to
// end of screen. Skipped when n == 0 — first-render avoids a stray
// upward jump that would scroll the previous shell output.
fn progress_clear(prev_lines: int) {
    if prev_lines <= 0 { return }
    avra_stdout_write("\x1b[${string(prev_lines)}A\r\x1b[J")
}

// Returns the line count just printed so the next tick can wipe it.
fn progress_render(prev_lines: int, total: int, done: int, running: string, elapsed_ms: int) -> int {
    progress_clear(prev_lines)
    let elapsed_s = elapsed_ms / 1000
    let elapsed_tenths = (elapsed_ms / 100) - (elapsed_s * 10)
    let header = "building ${string(total)} deps · ${string(done)}/${string(total)} done · ${string(elapsed_s)}.${string(elapsed_tenths)}s\n"
    avra_stdout_write(header)
    let lines = render_running_lines(running)
    avra_stdout_write(lines)
    1 + count_lines(lines)
}

fn count_lines(s: string) -> int {
    mut n = 0
    mut i = 0
    while i < s.length {
        if s.byte(i) == 0x0A { n = n + 1 }
        i = i + 1
    }
    n
}

// e20h Phase 2 unification: the TTY child uses the exact same generic Avra
// resource pool as the non-TTY path. Markers let the parent render progress;
// they do not become a second scheduler with independent width policy.
fn run_pre_deps_with_progress(paths_file: string, compiler_path: string, total: int, project_dir: string, plan_shape: string) -> PreDepOutcome {
    let marker_dir = progress_marker_dir()
    avra_shell_exec("rm -rf ${marker_dir} && mkdir -p ${marker_dir}")
    let dep_paths = read_paths_file_lines(paths_file)
    let slugs = slugs_from_paths(dep_paths)
    mut cmds: List<string> = []
    for (path, slug) in dep_paths.zip(slugs) {
        // Per-job log file makes failures inspectable after the run —
        // dump_failed_logs walks `${marker_dir}/*.log`. --explain so the
        // log carries the hit/miss attribution the tally reads (pdme.5).
        cmds.push("(cd \"${path}\" && \"${compiler_path}\" build --lib --emit_metadata --explain) > \"${marker_dir}/${slug}.log\" 2>&1")
    }
    // Spawn the pool in the background so the foreground can render
    // the TTY progress bar against the marker files. The child is an internal
    // CLI command so it can own a live governor while this process stays free
    // to render.
    let pool_handle = spawn_resource_pool_async(cmds, slugs, marker_dir, project_dir, compiler_path, "build-path-dependency", plan_shape)
    if pool_handle < 0 {
        // Spawn failure: preserve resource admission synchronously.
        let sync_rc = run_build_resource_pool(cmds, project_dir, compiler_path, "build-path-dependency", plan_shape)
        if sync_rc != 0 {
            avra_shell_exec("rm -rf ${marker_dir}")
            return PreDepOutcome { rc: sync_rc, hits: 0, misses: 0, detail: "" }
        }
        let sync_out = tally_dep_logs(marker_dir)
        avra_shell_exec("rm -rf ${marker_dir}")
        return sync_out
    }
    let t_start = avra_uptime_ms()
    mut prev_lines = 0
    while avra_process_is_alive(pool_handle) != 0 {
        let done = count_done_markers(marker_dir)
        let running = list_running_slugs(marker_dir)
        let elapsed = avra_uptime_ms() - t_start
        prev_lines = progress_render(prev_lines, total, done, running, elapsed)
        avra_sleep_ms(100)
    }
    let final_json = avra_process_wait(pool_handle)
    let exit_code = pool_extract_rc(final_json)
    report_resource_pool_summary(marker_dir)
    let final_done = count_done_markers(marker_dir)
    let final_elapsed = avra_uptime_ms() - t_start
    progress_clear(prev_lines)
    let elapsed_s = final_elapsed / 1000
    let elapsed_tenths = (final_elapsed / 100) - (elapsed_s * 10)
    if exit_code == 0 {
        println("built ${string(final_done)} deps in ${string(elapsed_s)}.${string(elapsed_tenths)}s")
    } else {
        println("build failed for at least one dep (rc=${string(exit_code)} after ${string(elapsed_s)}.${string(elapsed_tenths)}s) — see logs in ${marker_dir}/")
        dump_failed_logs(marker_dir)
    }
    if exit_code == 0 {
        let out = tally_dep_logs(marker_dir)
        avra_shell_exec("rm -rf ${marker_dir}")
        return out
    }
    PreDepOutcome { rc: exit_code, hits: 0, misses: 0, detail: "" }
}

// Read a newline-separated path list back into a List<string>. Used
// by run_pre_deps_with_progress to feed pool_run a real list instead
// of piping the file into xargs.
fn read_paths_file_lines(path: string) -> List<string> {
    let content = avra_selfhost_read_file(path)
    mut out: List<string> = []
    let len = content.length
    mut start = 0
    mut i = 0
    while i <= len {
        if i == len || content.byte(i) == 0x0A {
            if i > start {
                out.push(content.substring(start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    out
}

// Derive a marker slug from a dep path — the trailing path component,
// trimmed of any trailing `/`. Mirrors the prior shell `sed 's|.*/||;
// s|/$||'` so existing fixtures + the renderer's display logic see
// the same shape (cli, std-avrac, etc).
fn slugs_from_paths(paths: List<string>) -> List<string> {
    mut out: List<string> = []
    mut i = 0
    while i < paths.length {
        out.push(slug_of_path(paths[i]))
        i = i + 1
    }
    out
}

fn slug_of_path(p: string) -> string {
    if p.length == 0 { return "" }
    let trimmed = if p.byte(p.length - 1) == 0x2F { p.substring(0, p.length - 1) } else { p }
    let len = trimmed.length
    mut i = len
    while i > 0 {
        let prev = i - 1
        if trimmed.byte(prev) == 0x2F {
            return trimmed.substring(i, len)
        }
        i = prev
    }
    trimmed
}

// Write one string per line. Build queue commands and their marker slugs are
// already newline-free shell units; making the files explicit gives the child
// pool an ordinary, inspectable hand-off without squeezing command strings
// through flags or re-implementing scheduling in shell.
fn write_line_list(path: string, items: List<string>) -> bool {
    mut body = ""
    for item in items { body = body + item + "\n" }
    // The result is the CALLER's business: these files are the spawned
    // child's only queue input, and avra_selfhost_write_file returns 0 on
    // failure. Discarding it let a failed write spawn a child that read a
    // missing file, got an empty queue, ran it, and exited 0 — so the parent
    // reported success while the path-dependency pre-build was silently
    // skipped. (CodeRabbit on #1120.)
    avra_selfhost_write_file(path, body) == 1
}

// The TTY renderer needs a foreground process, but the dispatcher must still
// have a live MemGovernor. Launch an internal command in the current compiler
// instead of a shell FIFO: both TTY and piped builds now enter the exact same
// resource-pool implementation, profiles, persistence, and platform sampler.
fn spawn_resource_pool_async(cmds: List<string>, slugs: List<string>, marker_dir: string, project_dir: string, compiler_path: string, work_kind: string, plan_shape: string) -> int {
    let commands_path = "${marker_dir}/resource.commands"
    let slugs_path = "${marker_dir}/resource.slugs"
    // Fail to the SYNCHRONOUS path (which still holds `cmds` in memory) rather
    // than spawn a child whose queue we could not stage — both callers already
    // treat a negative return as "run it synchronously".
    if !write_line_list(commands_path, cmds) || !write_line_list(slugs_path, slugs) {
        eprintln("[resources] could not stage the queue hand-off in ${marker_dir} — running synchronously")
        return 0 - 1
    }
    let argv = json_string_list([
        "_resource_pool",
        "--commands", commands_path,
        "--slugs", slugs_path,
        "--marker-dir", marker_dir,
        "--project-dir", project_dir,
        "--compiler", compiler_path,
        "--work-kind", work_kind,
        "--plan-shape", plan_shape,
    ])
    avra_process_spawn_bg(compiler_path, argv, "")
}

fn report_resource_pool_summary(marker_dir: string) {
    let summary = read_file("${marker_dir}/resource.summary").trim()
    if summary != "" { eprintln(summary) }
}

// On failure we surface every per-worker log so the user sees what
// went wrong — the progress bar suppressed real-time stderr.
fn dump_failed_logs(marker_dir: string) {
    let logs = avra_shell_exec("ls -1 ${marker_dir}/*.log 2>/dev/null || true")
    if logs == "" { return }
    mut i = 0
    let len = logs.length
    mut start = 0
    while i <= len {
        if i == len || logs.byte(i) == 0x0A {
            if i > start {
                let path = logs.substring(start, i)
                let content = avra_shell_exec("cat '${path}' 2>/dev/null")
                if content != "" {
                    println("─── ${path} ───")
                    println(content)
                }
            }
            start = i + 1
        }
        i = i + 1
    }
}

fn write_dep_paths(deps: List<Dep>, out_path: string) {
    mut i = 0
    while i < deps.length {
        let dep = deps[i]
        if dep.path != "" {
            let _ = avra_selfhost_append_file(out_path, "${dep.path}\n")
        }
        i = i + 1
    }
}

/// `avra build` — the CLI half of a build. Everything about compiling,
/// caching, object materialisation and linking lives in @std.avrac.build
/// (`build_executable`); what stays here is the argv→request mapping plus
/// the two fan-outs that render their own progress UI: pre-building
/// path-deps and the experimental `--per_module` dispatch.
///
/// Exits the process on failure (the build layer itself never does — it
/// returns `ok: false` and the CLI decides).
fn run_build_command(args: BuildArgs) -> BuildReport {
    let project_dir = avra_process_env_get("PWD")
    // pdme.6: once-a-day write-time GC (stamp-gated — two stats on the
    // common path). Keeps the cache dir bounded without manual prunes.
    maybe_auto_gc(project_dir)
    let manifest = load_manifest("${project_dir}/")
    let compiler_path = resolve_compiler_path(project_dir)

    // A BARE `bs2 build --lib` must run under the same AVRA_LIB_PKG_ROOT
    // the suite prebuild exports for this package (std_prebuild_cmd /
    // build_pre_dep_cmds derive it from the package dir), or its cache
    // fingerprint can never match the prebuild's slot — the root is a
    // fingerprint axis. Every fixture that shells a bare lib build on
    // packages/std-avrac (std_avrac_lib_build, cli_metadata,
    // metadata_walker_method_dispatch) recompiled the whole package cold
    // mid-suite (~7.8GB) on a guaranteed miss, which F4014'd on CI the
    // moment box pressure coincided. Normalising the process env HERE —
    // the CLI build entrypoint, before the facade's build_ir reads it and
    // before pre-dep children inherit it — makes bare and rooted
    // invocations share one slot, and the child compile emits the same
    // pkg-scoped symbols. The facade only READS env; the CLI owns it.
    //
    // An explicit caller root always wins. The path-derived root is
    // accepted only when it AGREES with the manifest-derived one (the
    // --module_path mapping): a `std-` segment elsewhere in an absolute
    // path (e.g. a home dir) can otherwise mis-root a non-std package.
    // Non-std packages derive "" and stay whole-program.
    if is_library_target(manifest, args.lib) && manifest.found
        && avra_process_env_get("AVRA_LIB_PKG_ROOT") == "" {
        let path_root = derive_lib_root_for(project_dir)
        let manifest_root = manifest.name.replace("/", "::")
        if path_root != "" && path_root == manifest_root {
            avra_process_env_set("AVRA_LIB_PKG_ROOT", path_root)
        }
    }

    // 2f54: pre-build each [dependencies] path-dep as a lib BEFORE the
    // root build so the dep's .meta.bin and cache entries land first. The
    // root then consumes them via the metadata fast-path. Skipped when
    // --emit_metadata is off — the single-unit cycle stays the default.
    mut pre = pre_dep_outcome_empty()
    if args.emit_metadata && manifest.found {
        pre = pre_build_path_deps(manifest.deps, compiler_path, args)
        if pre.rc != 0 {
            fail("error: failed to pre-build a path-dep — see output above")
        }
    }

    // g2eo Phase B: dispatch one `bs2 compile --target_module=...` per
    // src/ subdirectory in parallel. Produces many units, so there is no
    // single artifact to link — the dispatch is the whole command.
    if args.per_module && manifest.found {
        let per_rc = pre_build_subdir_units(project_dir, manifest.name, compiler_path, args)
        if per_rc != 0 {
            fail("error: per-module dispatch failed (see logs above)")
        }
        let unit_name = unit_name_for(manifest, args.lib)
        if args.json {
            println(build_event_json("per_module_done", unit_name, "", "${project_dir}/build/per_mod", ""))
        } else {
            println("per-module units written to ${project_dir}/build/per_mod/")
        }
        return build_report_empty()
    }

    // The three output flags are one mode: json wins, then explain.
    let mode = if args.json { BuildOutput.Json }
               else if args.explain { BuildOutput.Explain }
               else { BuildOutput.Normal }
    let report = build_executable(BuildRequest {
        project_dir: project_dir,
        entry: args.entry,
        output: args.output,
        release: args.release,
        library: args.lib,
        emit_metadata: args.emit_metadata,
        timings: args.timings,
        mode: mode,
        deps: DepTally { hits: pre.hits, misses: pre.misses, detail: pre.detail },
    }, run_with_progress)
    if !report.ok {
        fail(report.error)
    }
    report
}

// `avra clean` — remove the top-level build/ directory while
// preserving build/cache/ by default. With --all, also wipes the
// cache (use to start truly fresh, e.g. after a runtime change).
//
// Cache preservation matters: `bs2 build` invalidates entries on
// any input change, so a stale cache cannot produce wrong output —
// only stale-but-now-irrelevant entries waste disk. Wiping the
// cache forces every subsequent build to repay full compile cost
// even for inputs that haven't changed, which is rarely what the
// user wants.
fn run_clean_command(all_flag: bool) {
    let project_dir = avra_process_env_get("PWD")
    let build_dir = "${project_dir}/build"
    if !avra_selfhost_file_exists(build_dir) {
        println("clean: ${build_dir} does not exist (nothing to do)")
        return
    }
    if all_flag {
        avra_shell_exec("rm -rf '${build_dir}'")
        println("clean --all: removed ${build_dir} (cache included)")
        return
    }
    // Default: rm everything under build/ except cache/. We re-create
    // build/ then move cache back, which is atomic enough for dev
    // tooling and avoids walking the artifact tree by hand.
    let cache_dir = "${build_dir}/cache"
    let cache_stash = "${project_dir}/.avra_cache_stash"
    if avra_selfhost_file_exists(cache_dir) {
        avra_shell_exec("rm -rf '${cache_stash}'")
        avra_shell_exec("mv '${cache_dir}' '${cache_stash}'")
    }
    avra_shell_exec("rm -rf '${build_dir}'")
    avra_shell_exec("mkdir -p '${build_dir}'")
    if avra_selfhost_file_exists(cache_stash) {
        avra_shell_exec("mv '${cache_stash}' '${cache_dir}'")
        println("clean: removed ${build_dir}/* (cache preserved)")
    } else {
        println("clean: removed ${build_dir}/* (no cache to preserve)")
    }
}

/// Count the cache's entries — its top-level subdirectories. Native walk
/// (avra_readdir + avra_is_dir) so the cache path, which derives from $PWD,
/// is never interpolated into a shell command (the injection ohyd closes).
fn count_cache_entries(dir: string) -> int {
    mut n = 0
    for name in avra_readdir(dir) {
        if avra_is_dir("${dir}/${name}") == 1 { n = n + 1 }
    }
    n
}

/// Render a byte count in the largest sensible whole unit (B / K / M / G) —
/// e.g. 1992294 -> "1M". Display-only; one decimal isn't worth the precision
/// for a cache-size readout.
fn format_byte_size(bytes: int) -> string {
    if bytes < 1024 { return "${string(bytes)}B" }
    if bytes < 1048576 { return "${string(bytes / 1024)}K" }
    if bytes < 1073741824 { return "${string(bytes / 1048576)}M" }
    "${string(bytes / 1073741824)}G"
}

/// True when `s` is a canonical non-negative integer within [0, 36500] days.
/// Guards `prune --max-age-days`: avra_parse_int is atoll, which silently maps
/// "abc"/"" to 0 and "-5" to -5 — a cutoff of now-or-later would then evict the
/// ENTIRE cache (the old shell `find -mtime +<bad>` errored and deleted
/// nothing). The string round-trip rejects non-numeric / empty / signed /
/// leading-zero input; the upper bound rejects values large enough to overflow
/// `days * 86400` (36500 days ≈ 100 years is already absurd for a cache).
fn valid_max_age_days(s: string) -> bool {
    let n = avra_parse_int(s)
    n >= 0 && n <= 36500 && string(n) == s
}

/// `avra cache <subcommand>` — manage the build cache.
///   prune        : evict stale entries (default: max-age 30 days).
///   info         : print cache size + entry count.
///   clear-failed : evict fixture-stdout captures that froze a `: FAIL`
///                  (zp5b) without disturbing passing captures.
// `subcommand` (prune | info | clear-failed) is a required positional, so the
// declarative parser rejects a missing one before this runs. `dry_run` and
// `max_age_days_str` come from the parsed CliResult; the `max-age-days` default
// ("30") lives in the command's `option` schema, so it arrives already filled.
// pdme.6: prune candidate collection, shared by `bs2 cache prune` and
// the once-a-day auto-GC. mtime approximates last-USE (the cache layer
// touches entries on HIT), so age-based eviction is an LRU.
//
// Two granularities:
//   * NAMESPACE dirs (meta/, obj/, link/, _tmp/, fixture_stdout/) hold
//     many independent entries whose ages differ wildly — walk them and
//     evict PER-ENTRY. Evicting the namespace dir wholesale by its own
//     mtime (the old behaviour) either killed hot entries or kept dead
//     ones alive, depending on when the dir last gained a child.
//   * everything else at the top level is a per-fingerprint slot dir —
//     wholesale eviction by the slot's mtime, as before.
// `last/` (tiny --explain attribution sidecars) and the `.last-gc`
// stamp are never candidates.
fn collect_prune_candidates(cache_dir: string, cutoff_secs: int) -> List<string> {
    mut stale: List<string> = []
    for name in avra_readdir(cache_dir) {
        let entry = "${cache_dir}/${name}"
        if avra_is_dir(entry) != 1 { continue }
        if name == "last" { continue }
        let per_entry = name == "meta" || name == "obj" || name == "link"
            || name == "_tmp" || name == "fixture_stdout"
        if per_entry {
            for sub in avra_readdir(entry) {
                let subp = "${entry}/${sub}"
                if avra_file_mtime(subp) / 1000000000 < cutoff_secs {
                    stale.push(subp)
                }
            }
        } else if avra_file_mtime(entry) / 1000000000 < cutoff_secs {
            stale.push(entry)
        }
    }
    stale
}

/// Evict collected candidates (dirs via remove_tree, files via
/// remove_file). Returns the number of entries that could not be
/// fully removed — callers surface a partial prune instead of
/// claiming success (no silent failures).
fn evict_prune_candidates(stale: List<string>) -> int {
    mut failures = 0
    for p in stale {
        let removed = if avra_is_dir(p) == 1 { avra_remove_tree(p) } else { avra_remove_file(p) }
        if removed != 1 { failures = failures + 1 }
    }
    failures
}

// t-5kek: size-bounded LRU eviction. The age prune's 30-day mtime floor
// never reclaims same-session churn: every seed cycle stamps a fresh
// full-compiler's worth of (seed+source)-fingerprinted slots, and the
// prior seed's slots are DEAD (their key can't be hit again) yet carry
// today's mtime. Across one seed-cycling session build/cache can balloon
// past the disk allowance while `cache prune --max-age-days` reclaims
// nothing. The size prune bounds the cache by total bytes, evicting
// OLDEST-mtime slots first — and because a cache HIT touches its slot,
// the oldest slots are exactly the ones no longer hit (the dead
// generations), so LRU reclaims them without needing to know which seed
// stamped each slot.

/// An enumerated cache slot with the metadata the size prune ranks on.
type PruneEntry = { path: string, mtime_secs: int, size_bytes: int }

/// Result of a size-cap sweep — evicted/failed slot counts + bytes freed.
type SizePruneResult = { evicted: int, failures: int, freed_bytes: int }

/// mtime (epoch seconds; cache hits touch it) + recursive byte size for
/// one slot, handling the mixed file/dir slots (obj/*.o and link/*.bin
/// are files; fp.hex and meta/<fp> are dirs).
fn prune_entry_for(path: string) -> PruneEntry {
    let sz = if avra_is_dir(path) == 1 { avra_dir_size(path) } else { avra_file_size(path) }
    PruneEntry { path: path, mtime_secs: avra_file_mtime(path) / 1000000000, size_bytes: sz }
}

/// Enumerate every evictable slot with its (mtime, size) — mirrors
/// collect_prune_candidates' two-level walk (flat fp.hex slots + the
/// partitioned meta/obj/link/_tmp/fixture_stdout dirs) so the size prune
/// operates on exactly the units the age prune does.
fn collect_prune_entries(cache_dir: string) -> List<PruneEntry> {
    mut out: List<PruneEntry> = []
    for name in avra_readdir(cache_dir) {
        let entry = "${cache_dir}/${name}"
        if avra_is_dir(entry) != 1 { continue }
        if name == "last" { continue }
        let per_entry = name == "meta" || name == "obj" || name == "link"
            || name == "_tmp" || name == "fixture_stdout"
        if per_entry {
            for sub in avra_readdir(entry) {
                out.push(prune_entry_for("${entry}/${sub}"))
            }
        } else {
            out.push(prune_entry_for(entry))
        }
    }
    out
}

/// Evict oldest-mtime slots until total cache size is at or under
/// cap_bytes. No-op (all-zero result) when already under budget. Honours
/// dry_run (prints the slots it would evict, mutates nothing).
fn prune_to_size_cap(cache_dir: string, cap_bytes: int, dry_run: bool) -> SizePruneResult {
    mut entries = collect_prune_entries(cache_dir)
    mut total = 0
    for e in entries { total = total + e.size_bytes }
    if total <= cap_bytes {
        return SizePruneResult { evicted: 0, failures: 0, freed_bytes: 0 }
    }
    // Oldest first — the dead (untouched) generations lead.
    entries.sort((a: PruneEntry, b: PruneEntry) ->
        if a.mtime_secs < b.mtime_secs { -1 } else if a.mtime_secs > b.mtime_secs { 1 } else { 0 })
    mut running = total
    mut evicted = 0
    mut failures = 0
    mut freed = 0
    for e in entries {
        if running <= cap_bytes { break }
        if dry_run {
            println(e.path)
            evicted = evicted + 1
            running = running - e.size_bytes
            freed = freed + e.size_bytes
            continue
        }
        let removed = if avra_is_dir(e.path) == 1 { avra_remove_tree(e.path) } else { avra_remove_file(e.path) }
        if removed == 1 {
            evicted = evicted + 1
            freed = freed + e.size_bytes
            running = running - e.size_bytes
        } else {
            failures = failures + 1
        }
    }
    SizePruneResult { evicted: evicted, failures: failures, freed_bytes: freed }
}

/// Validate --max-size-mb: a non-negative integer (0 disables the size
/// prune). Same atoll-safety rationale as valid_max_age_days — a
/// non-numeric arg must not silently become 0-and-evict-everything.
fn valid_max_size_mb(s: string) -> bool {
    if s.length == 0 { return false }
    for i in 0..s.length {
        let c = s.substring(i, i + 1)
        if c < "0" || c > "9" { return false }
    }
    true
}

// pdme.6: write-time auto-GC — at most once per day, gated on a stamp
// file so the common path costs two stats. Prunes entries older than
// 30 days (mtime == last use, so only cold entries go). The stamp is
// refreshed BEFORE sweeping so concurrent builds don't all sweep.
// Quiet unless something was evicted; failures are reported but never
// fail the build (GC is best-effort — the build itself succeeded).
fn maybe_auto_gc(project_dir: string) {
    let cache_dir = "${project_dir}/build/cache"
    if avra_is_dir(cache_dir) != 1 { return }
    let stamp = "${cache_dir}/.last-gc"
    let now = avra_datetime_now()
    if file_exists(stamp) != 0 && avra_file_mtime(stamp) / 1000000000 > now - 86400 {
        return
    }
    let _ = write_file(stamp, "")
    let stale = collect_prune_candidates(cache_dir, now - 30 * 86400)
    if stale.length == 0 { return }
    let failures = evict_prune_candidates(stale)
    let suffix = if failures > 0 { " (${string(failures)} could not be removed)" } else { "" }
    eprintln("[cache-gc] evicted ${string(stale.length - failures)} entries older than 30 days${suffix}")
}

fn run_cache_command(subcommand: string, dry_run: bool, max_age_days_str: string, max_size_mb_str: string) {
    let project_dir = avra_process_env_get("PWD")
    let cache_dir = "${project_dir}/build/cache"

    if !avra_selfhost_file_exists(cache_dir) {
        println("cache: ${cache_dir} does not exist (no cache yet)")
        return
    }

    if subcommand == "info" {
        // Native walk (count + recursive size) — no shell, so the
        // $PWD-derived cache_dir is never interpolated into a command (ohyd).
        println("cache info:")
        println("  path:    ${cache_dir}")
        println("  entries: ${string(count_cache_entries(cache_dir))}")
        println("  size:    ${format_byte_size(avra_dir_size(cache_dir))}")
        return
    }

    if subcommand == "prune" {
        // A cache entry (top-level subdir) is stale when its mtime is older
        // than max-age days. Native walk + avra_remove_tree — no shell, so the
        // $PWD-derived cache path is never interpolated into a command (ohyd,
        // the injection class clear-failed already avoids).
        //
        // Validate max-age FIRST: avra_parse_int is atoll, which maps a
        // non-numeric or negative argument to 0 / a negative — either of which
        // sets the cutoff to now-or-later and would evict the WHOLE cache. The
        // old shell `find -mtime +<bad>` errored and deleted nothing; preserve
        // that safety. (Semantics note: `-mtime +N` truncated age to whole 24h
        // periods; the direct `mtime < now - N*86400` comparison here is
        // continuous, so a boundary entry can be evicted up to ~24h younger —
        // harmless for a cache.)
        if !valid_max_age_days(max_age_days_str) {
            fail("cache prune: --max-age-days must be an integer in 0..36500, got `${max_age_days_str}`")
        }
        if !valid_max_size_mb(max_size_mb_str) {
            fail("cache prune: --max-size-mb must be a non-negative integer, got `${max_size_mb_str}`")
        }
        let max_size_mb = avra_parse_int(max_size_mb_str)
        // avra_file_mtime is epoch NANOSECONDS; avra_datetime_now is epoch
        // SECONDS. Collect candidates first so --dry-run is side-effect-free.
        // The age prune no longer returns early — a size cap (t-5kek) may
        // still have work after it, so both gates run in sequence.
        let cutoff_secs = avra_datetime_now() - avra_parse_int(max_age_days_str) * 86400
        let stale = collect_prune_candidates(cache_dir, cutoff_secs)
        if stale.length == 0 {
            println("cache prune: no entries older than ${max_age_days_str} days")
        } else if dry_run {
            println("cache prune --dry-run: would evict ${string(stale.length)} entries older than ${max_age_days_str} days:")
            for p in stale { println(p) }
        } else {
            let failures = evict_prune_candidates(stale)
            if failures > 0 {
                // Exit non-zero (fail) on a partial prune, so a script driving
                // `bs2 cache prune` never treats an incomplete deletion as success.
                fail("cache prune: evicted ${string(stale.length - failures)} entries; ${string(failures)} could not be fully removed")
            } else {
                println("cache prune: evicted ${string(stale.length)} entries older than ${max_age_days_str} days")
            }
        }

        // t-5kek: size-bounded LRU eviction, after the age prune (which
        // freed whatever it could; the size sweep re-enumerates live disk
        // state). Disabled at 0. Reclaims the OLDEST slots first — the dead
        // superseded-seed generations that same-session churn accumulates.
        if max_size_mb > 0 {
            let cap_bytes = max_size_mb * 1048576
            if dry_run {
                println("cache prune --dry-run: --max-size-mb=${max_size_mb_str} would evict (oldest first) to fit ${format_byte_size(cap_bytes)}:")
                let r = prune_to_size_cap(cache_dir, cap_bytes, true)
                println("cache prune --dry-run: would free ${format_byte_size(r.freed_bytes)} across ${string(r.evicted)} slot(s)")
            } else {
                let r = prune_to_size_cap(cache_dir, cap_bytes, false)
                if r.failures > 0 {
                    fail("cache prune: size cap freed ${format_byte_size(r.freed_bytes)} across ${string(r.evicted)} slot(s); ${string(r.failures)} could not be removed")
                } else if r.evicted > 0 {
                    println("cache prune: size cap evicted ${string(r.evicted)} oldest slot(s), freed ${format_byte_size(r.freed_bytes)} (cap ${format_byte_size(cap_bytes)})")
                } else {
                    println("cache prune: under the ${format_byte_size(cap_bytes)} size cap — nothing to evict")
                }
            }
        }
        return
    }

    if subcommand == "clear-failed" {
        // zp5b: surgically evict fixture-stdout captures that froze a `: FAIL`
        // — a transient (cold-cache jetsam, a concurrent build) or stale-
        // environment failure baked into the cache that then replays on every
        // run with no source diff to explain it. Unlike `prune` / `make clean`
        // this keeps every PASSING capture warm, so the next test run pays only
        // to re-run the handful of genuinely-failed fixtures, not the whole
        // suite. Zero cost on normal runs: it does work only when invoked.
        //
        // Walked natively (avra_readdir / avra_remove_file) rather than shelled
        // out: the cache dir derives from $PWD, and interpolating an arbitrary
        // path into a `grep … '<dir>'/*.out` shell string is both injectable (a
        // path containing a quote escapes the quoting — Avra expands the path
        // into the string before the shell sees it) and fragile (ARG_MAX on a
        // large cache; `grep -l | xargs rm` mishandling odd filenames). The
        // native walk reads each capture once and unlinks the matches directly.
        //
        // capture_has_probe_failure (shared with the cache write-gate) anchors
        // on the PROBE/spec convention (`PROBE <name>: FAIL`, `<name>: FAIL`) so
        // the evictor and the writer agree exactly on what a frozen failure is —
        // a blunt substring `: FAIL` would also evict a PASSING capture that
        // merely prints `: FAILED` / `: FAILURE` in prose, breaking the "keeps
        // passing captures warm" guarantee. Compiler diagnostics use F-codes
        // (`F0012: …`), never the probe form, so error-assertion captures are
        // untouched. Evicting a genuinely-failing capture is harmless regardless:
        // the next run re-captures the identical result.
        let fixture_dir = "${project_dir}/${fixture_stdout_cache_dir()}"
        if avra_is_dir(fixture_dir) == 0 {
            println("cache clear-failed: no fixture_stdout cache at ${fixture_dir}")
            return
        }
        mut failed: List<string> = []
        for name in avra_readdir(fixture_dir) {
            if avra_str_ends_with(name, ".out") {
                let path = "${fixture_dir}/${name}"
                if capture_has_probe_failure(avra_selfhost_read_file(path)) {
                    failed.push(path)
                }
            }
        }
        if failed.length == 0 {
            println("cache clear-failed: no frozen-FAIL captures in ${fixture_dir}")
            return
        }
        if dry_run {
            println("cache clear-failed --dry-run: would delete ${string(failed.length)} frozen-FAIL captures:")
            for p in failed { println(p) }
            return
        }
        for p in failed { let _ = avra_remove_file(p) }
        println("cache clear-failed: deleted ${string(failed.length)} frozen-FAIL captures")
        return
    }

    fail("unknown cache subcommand `${subcommand}` (expected: prune | info | clear-failed)")
}

// `avra test` — discover every `*_test.av` under PWD, parse each as
// a Module, hoist shared @std packages to the program root, link
// the assembled program, and run the spec/given/then suite.
// Coverage path lowers `llvm.instrprof.increment` intrinsics, links
// with clang_rt.profile, then feeds profdata to the Avra-side
// renderer (`coverage::render_coverage`).
// hkms.1: assemble the hermetic input set for the test action.
//
// Every file whose contents may affect the linked _test.bin must
// participate in the fingerprint, otherwise we get false-positive
// cache hits (the worst kind of cache bug — silently runs stale
// code). The set is intentionally over-broad:
//
//   - all *_test.av matching `--filter` (the test sources themselves)
//   - every .av under packages/std-avrac/src/ (the package universe;
//     a per-import-graph fingerprint is forthcoming hkms.x)
//   - the spec_test reporter (inlined into the test program)
//   - the bs2 compiler binary (any change forces a rebuild)
//   - runtime.o + llvm_wrapper.o (linked into the final binary)
//
// Coverage and filter participate via `unit_name` (the cache scopes
// per filter and per coverage flag — Cargo's pattern of test-target
// distinct from lib-target).
//
// Sorting matters: the fingerprint hashes paths in iteration order;
// `discover_tests` already returns results sorted lexicographically by
// path so the canonical-input string is stable across machines.

// filter_discovered + filter_by_path live in @std.avrac.test_runner
// .discovery so spec tests can exercise them directly with synthetic
// inputs (instead of shelling out to `bs2 test --list` per case).
// Imported at the top of this file alongside the other discovery
// types.

/// Discovery dispatch for run_test_command: when every positional path is
/// an existing literal file or directory, short-circuit to exactly those
/// (saves the whole-tree walk + ~450 token-classifications, ~15s on a
/// realistic project). Otherwise fall through to discover_tests so
/// suffix / basename-substring path filters still resolve.
///
/// Takes N paths (t-kdyj.6). The single-path form used to be an `arg file`
/// that silently DISCARDED every argument after the first: `bs2 test a.av
/// b.av` ran `a.av`, exited 0, and said nothing about `b.av` — a green
/// result that had not measured what the operator asked for.
fn discover_with_path_shortcut(project_dir: string, path_filters: List<string>) -> List<DiscoveredFile> {
    if path_filters.length == 0 { return discover_tests(project_dir) }
    mut resolved: List<DiscoveredFile> = []
    for pf in path_filters {
        // A directory argument scopes the discovery walk to that tree:
        // `bs2 test fixtures/dir` runs every spec under it. (Previously a
        // directory fell into the single-file classifier, which crashed
        // on read_file(dir) — a null deref instead of a meaning.)
        if pf != "" && avra_is_dir(pf) == 1 {
            for d in discover_tests(pf) { resolved.push(d) }
            continue
        }
        let one = discover_one_file(pf)
        // One unresolvable path (a suffix or basename form) means the walk
        // is needed anyway, and ONE walk serves every filter — filter_by_paths
        // narrows afterwards. Returning early here rather than walking
        // per-filter is what keeps the N-path cost at one walk, not N.
        if one.length == 0 { return discover_tests(project_dir) }
        for d in one { resolved.push(d) }
    }
    resolved
}

/// hkms.4: render the structurally-discovered test set for `--list`.
/// One line per entry, prefixed by file:line, so callers (IDEs,
/// `grep`, humans) can navigate directly to the source. Format is
/// stable and machine-friendly — `:` separators, no ANSI colour.
fn print_discovered(files: List<DiscoveredFile>) {
    for d in files {
        for entry in d.entries {
            println(render_discovered_entry(d.path, entry))
        }
    }
}

/// Single entry's `--list` line — picks the right "spec" / "@test fn"
/// label based on the entry variant. Pure formatter so the iteration
/// shape above stays small.
fn render_discovered_entry(path: string, entry: DiscoveredEntry) -> string {
    match entry {
        .Spec(name, line)      -> "${path}:${string(line)}: spec ${name}"
        .TestFn(fn_name, line) -> "${path}:${string(line)}: @test fn ${fn_name}"
    }
}

// Compose BuildInputs for a test action — bundled or per-shard.
//
// The fingerprint-relevant sources are identical in both shapes:
// (test files contributing to this action) + every .av under @std/avrac
// (cheap over-approximation of the transitive @std universe) +
// spec_test reporter + runtime objects. Only the unit_name and the
// per-action test_paths narrow differ.
//
// Used by:
//   - compute_test_build_inputs (bundled path, all accepted_paths)
//   - compute_test_shard_inputs (per-file path, [single_path])
fn make_test_inputs(project_dir: string, test_paths: List<string>, unit_name: string) -> BuildInputs {
    let build_dir = "${project_dir}/build"
    let reporter_path = test_reporter_path(project_dir)
    let runtime_o = "${build_dir}/runtime.o"
    let llvm_wrap_o = "${build_dir}/llvm_wrapper.o"

    // Canonical order: tests first, then std (or pre-rolled universe
    // FP), then reporter, then runtime objects. Stable across runs.
    mut sources: List<string> = []
    for p in test_paths { sources.push(p) }
    append_shared_sources(sources, project_dir, reporter_path, runtime_o, llvm_wrap_o)

    BuildInputs {
        project_root: project_dir,
        unit_name: unit_name,
        kind: "test",
        sources: sources,
        // entry_path is informational only for multi-source test units;
        // surface the first test path so --explain has a name to cite.
        entry_path: if test_paths.length > 0 { test_paths[0] } else { "" },
        compiler_path: resolve_compiler_path(project_dir),
        target_triple: "host",
        profile_name: "test",
        opt_level: 0,
        debug: true,
        overflow_checks: true,
        coverage: false,
        lib_pkg_root: avra_process_env_get("AVRA_LIB_PKG_ROOT"),
        // Test units carry no dep_fps: `sources` already rolls the whole
        // @std universe in (append_shared_sources), so dep content is
        // keyed there.
        dep_fps: [],
    }
}

/// Append the cross-shard-shared inputs (@std/* tree + reporter +
/// runtime objects) to `sources`. Pulls the orchestrator's prerolled
/// universe-fingerprint sentinel when available; otherwise enumerates
/// each path explicitly so cache invalidation stays per-file.
///
/// hkms.1.1 perf pass: when the orchestrator pre-rolls every shared
/// input into a single SHA-256 universe FP and exports it as
/// AVRA_STD_UNIVERSE_FP, drop in one synthetic `@@fp:<hex>` entry
/// instead of pushing ~280 file paths that each trigger a sidecar
/// read in `fp_for_unit`. `fp.av :: hash_source_entry` recognises
/// the sentinel and returns the hex directly without any I/O.
///
/// Falls back to the per-path listing for standalone `bs2 _test_shard`
/// invocations (no orchestrator). The universe FP MUST cover the same
/// inputs the fallback path would hash, otherwise cache invalidation
/// drifts.
fn append_shared_sources(sources_ref: List<string>, project_dir: string,
                         reporter_path: string, runtime_o: string, llvm_wrap_o: string) {
    mut sources = sources_ref
    let universe_fp = avra_process_env_get("AVRA_STD_UNIVERSE_FP")
    if universe_fp != "" {
        sources.push("@@fp:" + universe_fp)
        return
    }
    for p in std_avra_listing(project_dir) { sources.push(p) }
    sources.push(reporter_path)
    sources.push(runtime_o)
    sources.push(llvm_wrap_o)
}

/// Per-shard view of the @std/* `.av` listing. Prefers the
/// orchestrator-stashed listing file (AVRA_STD_LISTING_FILE) so 451
/// shards don't each fork-exec `find`; falls back to a shell `find`
/// for standalone shard runs.
fn std_avra_listing(project_dir: string) -> List<string> {
    let listing_file = avra_process_env_get("AVRA_STD_LISTING_FILE")
    if listing_file != "" && avra_selfhost_file_exists(listing_file) != 0 {
        return read_listing_file_paths(listing_file)
    }
    // EXCLUDES `**/tests/**` for the same reason as
    // compute_std_listing_file: test sources don't compile into test
    // binaries, so they shouldn't fold into the universe_fp. See that
    // function for the full rationale.
    let std_root = find_packages_dir(project_dir) + "std-avrac/src"
    let raw = avra_shell_exec("find ${std_root} -name '*.av' -type f -not -path '*/tests/*' 2>/dev/null | sort")
    mut out: List<string> = []
    for p in raw.split("\n") {
        if p != "" { out.push(p) }
    }
    out
}

// Bundled-action inputs: every accepted test file feeds one cache
// slot keyed on (filter, coverage) so a filter change creates a
// distinct entry (Cargo's pattern: separate unit per (target, profile)).
fn compute_test_build_inputs(project_dir: string, accepted_paths: List<string>, args: TestArgs) -> BuildInputs {
    let filter_tag = if args.filter == "" { "all" } else { "filter=" + args.filter }
    let cov_tag = if args.coverage { ":cov" } else { "" }
    make_test_inputs(project_dir, accepted_paths, "test:" + filter_tag + cov_tag)
}

// 05yc: per-shard inputs. One test file → one cache slot keyed on
// the file's basename so each shard's entry is stable across filter
// invocations (filter doesn't enter the per-shard fingerprint).
fn compute_test_shard_inputs(project_dir: string, test_paths: List<string>, args: TestArgs) -> BuildInputs {
    let cov_tag = if args.coverage { ":cov" } else { "" }
    make_test_inputs(project_dir, test_paths, "test_shard:" + batch_slug(test_paths) + cov_tag)
}

/// Deterministic, filesystem-safe identity for a shard's file set.
/// A single file keeps its historic basename slug (cache slots for
/// existing per-file shards stay addressable); a batch combines the
/// first file's slug, the count, and a content-independent digest of
/// the joined paths so two batches sharing a first file can't
/// collide.
fn batch_slug(paths: List<string>) -> string {
    if paths.length == 1 { return basename_no_ext(paths[0]) }
    let joined = paths.join("\n")
    let digest = sha256_hex(joined).substring(0, 12)
    "${basename_no_ext(paths[0])}_x${string(paths.length)}_${digest}"
}

// Compile a test unit end-to-end and return the linked binary path.
// Mirrors the in-process pipeline run_build_command would use, but
// specialised for the test mode: parses each `*_test.av` as a
// `Stmt.Module`, hoists `@std` packages once at the program root,
// inlines the spec_test reporter, and synthesises a `main()` that
// calls `test_render_summary`. Pipeline stages — quote-lower →
// desugar → expand → resolve → expand_macros → comptime → typeck →
// monomorphize → codegen → link — are exactly the ones the build
// command runs.
//
// `inputs.sources` is a fingerprint-friendly superset (test files +
// every `@std/avrac/src/*.av` + reporter + runtime objects). The
// caller supplies `test_paths` separately so the parse loop only
// touches the actual test files; std modules are pulled in by the
// resolver via `resolve_module_files`.
//
// Returns `Ok(bin_path)` on success or `Err(msg)` after rendering
// the diagnostic bag inline. The caller picks the exit policy.
fn compile_test_unit(inputs: BuildInputs, test_paths: List<string>, args: TestArgs) -> Result<string, string> {
    // "all.<pid>" not "all": two concurrent bundled runs (or a live one
    // plus an orphan) must not share _test_all.{ll,o,bin} scratch paths.
    compile_test_unit_to(inputs, test_paths, args, "all.${string(avra_getpid())}")
}

// 05yc: shard-scoped wrapper. `shard_id` distinguishes the staging
// paths so parallel per-file shard builds don't collide on the same
// `_test.o` / `_test.bin` filenames. The bundled path passes "all";
// per-file shards pass a per-test slug (basename without extension).
fn compile_test_unit_to(inputs: BuildInputs, test_paths: List<string>, args: TestArgs, shard_id: string) -> Result<string, string> {
    let project_dir = inputs.project_root
    // B-final F0: one bundle-wide store — every per-file parse, module
    // load, and support-file parse in this unit allocates into it.
    let bundle_store = new_node_store(build_line_index(""))
    let program = match assemble_test_program(test_paths, project_dir, bundle_store) {
        .Ok(p) -> p
        .Err(e) -> { return Result.Err(e) }
    }
    let bin_path = if args.coverage {
        "${project_dir}/build/coverage/_test_${shard_id}.bin"
    } else {
        "${project_dir}/build/_test_${shard_id}.bin"
    }
    let target = CompileTarget {
        program: program,
        bin_path: bin_path,
        project_dir: project_dir,
        diag_filename: "<test>",
        coverage: args.coverage,
        // 6owa library-mode: per-shard linker pulls in any pre-built
        // producer .o files listed in AVRA_LIB_OBJS (colon-separated).
        // The orchestrator (run_per_file_test_command) populates this
        // before fanning out shard commands so each shard's link step
        // resolves the mangled call sites AVRA_USE_METADATA exposed.
        extra_objs: parse_lib_objs_env(),
        store: bundle_store,
    }
    build_binary(target)
}

/// Parse AVRA_LIB_OBJS into a list of .o paths. Colon-separated for
/// shell-pipeline-friendliness (mirrors PATH / LD_LIBRARY_PATH).
/// Empty / unset env var → empty list.
/// Concatenate two List<StmtId> bodies, preserving order. Used by the
/// --module_path compile path to append dir-as-module siblings to
/// the entry file's parsed body before wrapping in Stmt.Module.
fn concat_stmt_lists(left: List<StmtId>, right: List<StmtId>) -> List<StmtId> {
    mut out: List<StmtId> = []
    mut i = 0
    while i < left.length {
        out.push(left[i])
        i = i + 1
    }
    mut j = 0
    while j < right.length {
        out.push(right[j])
        j = j + 1
    }
    out
}

fn parse_lib_objs_env() -> List<string> {
    let raw = avra_process_env_get("AVRA_LIB_OBJS")
    mut out: List<string> = []
    for p in raw.split(":") {
        if p != "" { out.push(p) }
    }
    out
}

// 05yc: parse the machine-readable `[shard-summary] pass=N fail=N
// total=N elapsed_ms=N` line a shard binary emits at end-of-run.
// Returns zeros when the marker is absent (shard crashed before
// summary). The orchestrator sums across shards and renders the
// unified count.
type ShardSummary = { pass: int, fail: int, total: int, elapsed_ms: int, crashes: int }

// nce6.1.F: structured shard summary. Reporter writes 40 bytes
// (5 × i64 little-endian: pass, fail, total, elapsed_ms, crashes) to
// AVRA_TEST_RESULTS_BIN_PATH using @std/process byte primitives.
// hkms.3: `crashes` records spec blocks that died on a fatal signal
// and were caught by the per-spec guard so the run could continue —
// distinct from `fail` (assertion mismatches).
// @marshal synthesises from_bytes_TestResults(b: bytes) →
// TestResults — symmetric with the reporter side.
@marshal
type TestResults = { pass: int, fail: int, total: int, elapsed_ms: int, crashes: int }

fn parse_shard_summary(out: string) -> ShardSummary {
    let marker = "[shard-summary] "
    let idx = out.index_of(marker)
    if idx < 0 { return ShardSummary { pass: 0, fail: 0, total: 0, elapsed_ms: 0, crashes: 0 } }
    let rest_start = idx + marker.length
    let tail = out.substring(rest_start, out.length)
    let nl = tail.index_of("\n")
    let end = if nl < 0 { tail.length } else { nl }
    let line = tail.substring(0, end)
    ShardSummary {
        pass: extract_kv_int(line, "pass="),
        fail: extract_kv_int(line, "fail="),
        total: extract_kv_int(line, "total="),
        elapsed_ms: extract_kv_int(line, "elapsed_ms="),
        // hkms.3: missing `crashes=` keeps backwards compat with cached
        // binaries that pre-date the field (extract_kv_int returns 0).
        crashes: extract_kv_int(line, "crashes="),
    }
}

fn extract_kv_int(line: string, key: string) -> int {
    let idx = line.index_of(key)
    if idx < 0 { return 0 }
    let start = idx + key.length
    mut i = start
    while i < line.length {
        let ch = line[i]
        if ch < "0" || ch > "9" { break }
        i = i + 1
    }
    if i == start { return 0 }
    avra_parse_int(line.substring(start, i))
}

// Internal `bs2 _test_shard <path> [path …]` subcommand. Compiles
// one shard binary holding every listed test file (or recovers it
// from cache) and execs it, inheriting stdio. Designed to be forked
// in parallel by the orchestrator — each child does its own compile
// + run + summary emission, so a segfault in one shard doesn't take
// down the others. With several paths, the shard binary's in-process
// runner executes them as parallel units — process isolation
// BETWEEN batches, thread-level unit isolation WITHIN one.
// `paths` + `args` arrive from the parsed CliResult of the declarative
// `command _test_shard` block (its variadic `paths` positional), so the
// missing-paths case is already a parse error before this runs.
/// Shard-side phase probe, same AVRA_TIMINGS gate as the compile pipeline.
fn shard_phase_ms(label: string, since: int) -> int {
    let now = avra_uptime_ms()
    if avra_process_env_get("AVRA_TIMINGS") != "" {
        eprintln("[phase] ${label} ${string(now - since)}ms")
    }
    now
}

fn run_test_shard_command(paths: List<string>, args: TestArgs) {
    for p in paths {
        if !avra_selfhost_file_exists(p) {
            fail("error: file not found: ${p}")
        }
    }
    let project_dir = avra_process_env_get("PWD")
    // Batch attribution: the slug alone doesn't reveal membership;
    // a compile/link failure in a batch needs its members listed to
    // be debuggable from the log.
    if paths.length > 1 {
        eprintln("[batch] ${string(paths.length)} files: ${paths.join(" ")}")
    }
    mut tsh = avra_uptime_ms()
    let _ = shard_phase_ms("child:startup_to_shard_entry", 0)
    let inputs = compute_test_shard_inputs(project_dir, paths, args)
    tsh = shard_phase_ms("shard:fingerprint_inputs", tsh)
    // pdme.7 follow-up: fold the pid into the LOCAL artifact slug. The
    // slug names this shard's pre-publish _test_<slug>.{ll,o,bin} in
    // the shared build/ dir; slug-only names let an orphaned shard from
    // a killed run (same files, still compiling) interleave with a live
    // same-slug compile — and the winner PUBLISHES whatever mixed bytes
    // survive. Cache slots stay pid-free (keyed on content fps); only
    // the scratch names are per-process.
    let shard_id = "${batch_slug(paths)}.${string(avra_getpid())}"
    // uzs9.1: the shard path is the DEFAULT per-file test path, but on a
    // cache hit it silently exec'd the cached binary — so `bs2 test <file>`
    // reruns were fast yet never printed `[test-cache] hit`, leaving cache
    // behaviour undiagnosable (a fast miss looked identical to a hit). Mirror
    // the bundled path's symmetric hit/miss logging (check_test_cache_or_miss).
    // The line lands in the shard log, which aggregate_shard_logs surfaces via
    // `println(out)`.
    let bin_path = match decide_build(inputs) {
        .Hit(fp, cached_bin) -> {
            eprintln("[test-cache] hit ${fp_short(fp)} — ${cached_bin}")
            cached_bin
        }
        .Miss(fp, _, reason) -> {
            eprintln("[test-cache] miss ${fp_short(fp)} — ${reason}")
            // Probe BEFORE the gate: this measures the decide, and the gate
            // below can block for an arbitrary time on a loaded box — folding
            // that wait into "shard:decide" would misattribute queueing as
            // cache-decision cost.
            tsh = shard_phase_ms("shard:decide", tsh)
            // Gate only the MISS: a cache hit execs an already-built binary
            // and must never queue behind the box-wide pressure semaphore.
            // The slot is held through this shard's COMPILE and dies at the
            // exec of the built test binary (O_CLOEXEC in the runtime) — the
            // test RUN is not a compile, and its probe children gate
            // themselves.
            avra_compile_slot_gate()
            let built = match compile_test_unit_to(inputs, paths, args, shard_id) {
                .Ok(b) -> b
                .Err(e) -> { fail("shard compile failed: ${e}") }
            }
            tsh = shard_phase_ms("shard:compile_unit(assemble+frontend+backend)", tsh)
            let staging_id = "${inputs.unit_name}.${fp_short(fp)}"
            let _ = record_build_result(inputs, fp, "", "", "", built, "", staging_id)
            tsh = shard_phase_ms("shard:publish_binary_to_cache", tsh)
            // Publish copies the staging bin into the cache slot, so
            // the local `_test_<shard>.{bin,o}` aren't load-bearing
            // anymore. Drop them — 317 shards × ~5MB each = ~1.5GB
            // of duplicate disk pressure otherwise. Native unlink
            // beats `avra_shell_exec("rm -f …")` per-shard (~5ms
            // fork + sh -c) — for ~451 cache-miss shards on a cold
            // build that's ~2s of shell overhead.
            let build_dir = "${inputs.project_root}/build"
            let _ = avra_remove_file("${build_dir}/_test_${shard_id}.bin")
            let _ = avra_remove_file("${build_dir}/_test_${shard_id}.o")
            cache_bin_path_for(cache_for(inputs.project_root), fp)
        }
    }
    // fxwn: only AVRA_LIB_PKG_ROOT is shard-scoped — it's the codegen
    // ownership prefix derived from the test's slug, with no meaning
    // for any /tmp/foo.av the test binary itself compiles.
    //
    // KEEP AVRA_USE_METADATA + AVRA_LIB_OBJS in the test binary's env:
    // - AVRA_USE_METADATA tells the inherited 'bs2 compile' to use the
    //   @std/* meta fast-path (38x speedup on a single-file compile).
    // - AVRA_LIB_OBJS lists @std/* producer .o files, which apply to
    //   ANY compile (they're the same .o files regardless of test).
    // This drops expand_macro_test from 117s → ~5s by letting its 10
    // inline 'bs2 compile' invocations use the meta fast-path.
    //
    // Tests that DO rely on env-off behaviour (deps_sidecar_test,
    // metadata_fast_path_size_test) opt out at the fixture level via
    // 'env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS' before the bs2
    // invocation — see those fixtures for the precise idiom.
    avra_process_env_unset("AVRA_LIB_PKG_ROOT")
    let exit_code = avra_process_forward(bin_path, "[]", "")
    avra_process_exit(exit_code)
}

// 05yc: per-file test orchestrator. The whole pipeline is three
// steps the reader can scan in one screen:
//
//   1. prepare_test_run — pull config + env from the world once
//   2. dispatch_shards  — fan out `spawn { run_shard }`, jobs-capped
//   3. aggregate_shard_logs — read each log, sum its result line
//
// Each `_test.av` runs in its own subprocess (`bs2 _test_shard <path>`),
// so a segfault in one shard doesn't touch the rest, and per-shard
// cache slots invalidate granularly when one file changes.
fn run_per_file_test_command(project_dir: string, accepted_paths: List<string>, args: TestArgs) -> int {
    let t_start = avra_uptime_ms()
    mut tp = t_start
    let cx = prepare_test_run(project_dir, args)
    tp = shard_phase_ms("parent:prepare(std prebuild probe + jobs)", tp)
    // cbg3: longest-job-first heuristic. Sort accepted_paths by
    // source file size descending so big shards (which tend to take
    // longer to compile) start in the first chunk and complete while
    // smaller shards backfill later chunks. dispatch_shards' fixed-
    // chunked-await dispatcher waits for the slowest member of each
    // chunk before starting the next; putting biggest first means
    // the slowest member is concentrated in early chunks instead of
    // straggling at the tail.
    //
    // Source file size is a coarse proxy for compile time but it's
    // free (one stat per path) and directionally correct for std-
    // avrac tests where typeck cost scales with source size.
    let shards = plan_shards(cx, accepted_paths)
    tp = shard_phase_ms("parent:plan_shards", tp)

    // t-kdyj.1 slice 2: a unit's honest cost is its TREE (shard + the
    // fixture compiles it shells out), which varies per shard SET — the mode
    // estimate once admitted width 4 into a fixture-heavy dir whose trees
    // crossed the cliff before the first measurement could correct. Seed the
    // estimate with this shard set's measured peak from the previous run;
    // afterwards persist what THIS run measured (or decay the prior when the
    // run measured nothing above the mode's static number).
    let prior_path = admission_prior_path("${project_dir}/build/cache", admission_key(cx.profile, shards))
    let gov = dispatch_shards(shards, cx, read_admission_prior(prior_path))
    // Persist only a COMPLETE run's measurement: a jetsam-killed shard died
    // unmeasured, so its run's low observation is not evidence of a lighter
    // workload — decaying the prior off it would let the NEXT full run
    // repeat the unsafe admission.
    tp = shard_phase_ms("parent:dispatch(all shards, incl. child compiles)", tp)
    persist_admission_prior(prior_path, gov.observed_mb, cx.per_shard_mb, jetsam_victims(shards).length == 0)
    // The retry inherits the CORRECTED estimate (prior-seeded + ratcheted),
    // not the static one: a jetsam kill is the strongest evidence the
    // static model under-booked, and the correction is most needed there.
    retry_jetsam_killed(shards, cx, gov.estimate_mb)
    tp = shard_phase_ms("parent:retry_check", tp)

    // Capture BEFORE the probe: this call's value is the command's exit
    // code, and a trailing statement would silently become the return
    // value instead (a timestamp), making `bs2 test` always exit non-zero.
    let rc = aggregate_shard_logs(shards, t_start)
    tp = shard_phase_ms("parent:aggregate_logs", tp)
    rc
}

/// Stable identity for a planned shard set: the content id (FNV-1a-64, the
/// same hash every other identity in the toolchain composes) over the sorted
/// member slugs. Membership striping is path-stable, so the key survives
/// edits and moves only when files are added/removed — exactly when the
/// measured peak may genuinely change.
fn admission_key(profile: ResourceProfile, shards: List<Shard>) -> string {
    mut slugs: List<string> = []
    for s in shards { slugs.push(s.slug) }
    slugs.sort((a: string, b: string) -> if a < b { -1 } else if a > b { 1 } else { 0 })
    "${resource_profile_key(profile)}-${string(content_id_for(slugs.join(";")))}"
}

/// Files per shard binary. 1 = the historic per-file mode: finest
/// cache granularity (edit one file, recompile one shard) and
/// process isolation per file. Larger batches amortize the per-shard
/// fixed costs (bs2 startup, universe fingerprint, link, fork+exec)
/// across K files while the in-process runner executes the K units
/// in parallel threads; the cost is batch-wide cache invalidation
/// when any member changes. Hard-wired policy, measured on the full
/// suite — see the commit that set it for the numbers.
const TEST_BATCH_FILES: int = 8

/// Plan the shard set. MEMBERSHIP stripes over the PATH-sorTED list
/// — paths are stable across edits, so editing one file invalidates
/// only its own batch's cache slot. (The first version striped over
/// the SIZE-sorted list: a one-byte edit changed the file's size,
/// reordered the sort, reshuffled EVERY batch's membership, and
/// invalidated every batch cache — the opposite of the design
/// intent.) DISPATCH order is longest-job-first by total member
/// size, which is free to vary run-to-run because it never touches
/// the cache key.
fn plan_shards(cx: RunCtx, accepted_paths: List<string>) -> List<Shard> {
    let k = TEST_BATCH_FILES
    if k <= 1 {
        // Per-file: LJF dispatch ordering is the whole plan.
        return list_map(sort_paths_by_size_desc(accepted_paths), (p: string) -> cx.shard_for([p]))
    }
    let stable = sort_paths_lex(accepted_paths)
    let n = stable.length
    mut nb = n / k
    if nb * k < n { nb = nb + 1 }
    if nb == 0 { nb = 1 }
    mut batches: List<Batch> = []
    for b in 0..nb {
        mut members: List<string> = []
        mut i = b
        while i < n {
            members.push(stable[i])
            i = i + nb
        }
        if members.length > 0 {
            batches.push(Batch { members: members, total_size: batch_total_size(members) })
        }
    }
    batches.sort((a: Batch, b: Batch) -> {
        if a.total_size > b.total_size { -1 } else if a.total_size < b.total_size { 1 } else { 0 }
    })
    list_map(batches, (b: Batch) -> cx.shard_for(b.members))
}

/// A planned shard's member set with its LJF dispatch weight.
type Batch = { members: List<string>, total_size: int }

/// Total on-disk source size of a batch's members — the LJF proxy
/// for dispatch ordering.
fn batch_total_size(paths: List<string>) -> int {
    mut total = 0
    for p in paths { total = total + avra_file_size(p) }
    total
}

/// Lexicographic path order — the STABLE basis for batch membership.
fn sort_paths_lex(paths: List<string>) -> List<string> {
    mut sorted: List<string> = []
    for p in paths { sorted.push(p) }
    sorted.sort((a: string, b: string) -> if a < b { -1 } else if a > b { 1 } else { 0 })
    sorted
}

/// cbg3 helper: longest-job-first ordering. Pulls each path's source-
/// file size via stat and sorts descending so the biggest file lands
/// in slot 0. Falls back to lexicographic order for any path whose
/// size lookup fails (avra_file_size returns -1 on missing/error).
fn sort_paths_by_size_desc(paths: List<string>) -> List<string> {
    mut sized: List<string> = []
    for p in paths { sized.push(p) }
    sized.sort((a: string, b: string) -> {
        let sa = avra_file_size(a)
        let sb = avra_file_size(b)
        if sa > sb { -1 } else if sa < sb { 1 } else if a < b { -1 } else if a > b { 1 } else { 0 }
    })
    sized
}

// One unit of test work — one shard binary holding one OR MORE test
// files. Built once during planning; every later step (dispatch,
// retry, aggregate) reads from this struct only — the orchestrator
// never re-derives slug/log paths.
type Shard = {
    paths: List<string>, // member *_test.av sources (1 = per-file mode)
    slug: string,        // batch_slug of the members; cache + log key
    log_path: string,    // where the shard's stdout/stderr land
    bin_path: string,    // nce6.1.F: where the shard writes @marshal TestResults
    cmd: string,         // fully-formed `env … bs2 _test_shard … > log` line
}

impl Shard {
    /// True when the shard left an output. A missing or empty log
    /// means the subprocess was killed (jetsam) before any stdout
    /// got flushed — retry territory, not a successful empty run.
    ///
    /// Uses `avra_file_size` (a single stat()) rather than reading
    /// the whole log just to check non-empty — for 451 shards the
    /// per-aggregation read was a 2x I/O hit (one in log_alive, one
    /// in the subsequent read_log) on every successful run.
    fn log_alive(self) -> bool {
        avra_file_size(self.log_path) > 0
    }

    /// Read the shard's captured stdout. Caller is expected to
    /// have checked `log_alive` first.
    fn read_log(self) -> string {
        avra_selfhost_read_file(self.log_path)
    }

    /// nce6.1.F: read the @marshal-binary TestResults the shard wrote
    /// when AVRA_TEST_RESULTS_BIN_PATH was set. Returns null when
    /// the file is missing or empty (shard crashed pre-emit, or the
    /// env var didn't propagate — orchestrator falls back to
    /// text-line parsing).
    fn read_results_bin(self) -> TestResults? {
        if avra_selfhost_file_exists(self.bin_path) != 1 { return null }
        let b = avra_selfhost_read_file_bytes(self.bin_path)
        if b.length < 40 { return null }
        from_bytes_TestResults(b)
    }

    /// Per-shard summary fetch — prefers the @marshal-binary results
    /// when the reporter wrote one (post-r-cycle shards), falls back
    /// to regex-parsing the `[shard-summary]` text line for compat
    /// with cached binaries that pre-date the bin sidecar AND for
    /// crash-before-write cases where the bin is missing.
    fn summary(self, out: string) -> ShardSummary {
        let bin = self.read_results_bin()
        if bin == null { return parse_shard_summary(out) }
        let r = bin!
        ShardSummary { pass: r.pass, fail: r.fail, total: r.total, elapsed_ms: r.elapsed_ms, crashes: r.crashes }
    }
}

// Shared knobs prepared once per `avra test` invocation. env_prefix
// is the per-shard environment, baked at startup so dispatch_shards
// just concatenates per-shard fields onto it.
type RunCtx = {
    log_dir: string,
    compiler_path: string,
    env_prefix: string,
    filter_arg: string,
    want_meta: bool,
    jobs: int,
    profile: ResourceProfile,
    snapshot: ResourceSnapshot,
    normal_per_shard_mb: int,
    per_shard_mb: int,   // profile-specific static floor for learned estimates
}

impl RunCtx {
    /// Project one test-file path to a fully-formed `Shard` ready
    /// for dispatch. AVRA_LIB_PKG_ROOT='<slug>' is the codegen
    /// ownership prefix — only the test's own __release_<Type> fns
    /// emit, @std/* fns belong to the pre-built producer .o files
    /// linked via AVRA_LIB_OBJS.
    fn shard_for(self, paths: List<string>) -> Shard {
        let slug = batch_slug(paths)
        // pdme.7 follow-up: the orchestrator's pid in the sidecar names.
        // Slug-only paths are DETERMINISTIC across invocations, so an
        // orphaned shard from a killed run (SIGKILL doesn't reap
        // grandchildren) finishing late clobbers the LIVE run's results
        // bin — the orchestrator prefers the bin over the text line, so
        // a foreign summary silently replaces the real one (observed
        // 2026-07-13: a walker shard aggregated 30/32 while its own log
        // said 32/32 — and the same clobber could just as well mask a
        // real failure). The run-start wipe of log_dir can't defend
        // against a still-LIVE writer; unique names can.
        let pid = string(avra_getpid())
        let log_path = "${self.log_dir}/${slug}.${pid}.log"
        let bin_path = "${self.log_dir}/${slug}.${pid}.bin"
        // Ownership covers EVERY member module — the codegen emits a
        // fn body iff some root prefixes it, so each member's fns
        // must be rooted or they'd be skipped as external (undefined
        // symbols at link). Comma-separated: roots are qualified
        // names whose `::` a colon split would shred.
        //
        // t-kdyj.3: these are the SAME names `assemble_test_program`
        // wraps each file's body in, so they come from the one
        // policy (`shard_mod_names`) rather than being re-derived
        // here. They used to be `basename_no_ext` on both sides,
        // which agreed BY COINCIDENCE — and stopped agreeing the
        // moment the assembler had to disambiguate a same-basename
        // pair. A root that no longer prefixes its module makes
        // codegen treat that module's fns as EXTERNAL and emit no
        // body, so the shard fails at LINK with undefined symbols
        // instead of at resolve. Fixing only the assembler moves the
        // failure; it does not remove it.
        let roots = shard_mod_names(paths).join(",")
        let pkg_root = if self.want_meta { "AVRA_LIB_PKG_ROOT='${roots}' " } else { "" }
        let quoted = list_map(paths, (p: string) -> "'${p}'")
        // nce6.1.F: propagate AVRA_TEST_RESULTS_BIN_PATH so the shard
        // reporter writes a @marshal-compatible TestResults file
        // alongside the text [shard-summary] line. Orchestrator
        // prefers the bin when present.
        let cmd = "${self.env_prefix}${pkg_root}AVRA_TEST_RESULTS_BIN_PATH='${bin_path}' '${self.compiler_path}' _test_shard ${quoted.join(" ")}${self.filter_arg} > '${log_path}' 2>&1"
        Shard { paths: paths, slug: slug, log_path: log_path, bin_path: bin_path, cmd: cmd }
    }
}

// Running pass/fail/total counters. `merge` folds one shard's
// summary into the running totals so `aggregate_shard_logs`
// reads as `totals = totals.merge(out, parsed)` instead of four
// separate field increments at the call site.
type Totals = {
    pass: int,
    fail: int,
    total: int,
    shard_failures: int,
    crashes: int,
}

impl Totals {
    /// Add one shard's parsed summary into the running totals. A
    /// shard with total==0 AND crashes==0 that didn't say "No tests
    /// ran" counts as a compile/run failure. hkms.3: spec-level
    /// crashes accumulate into `crashes` so the orchestrator can
    /// distinguish them from assertion fails AND from shard-level
    /// blow-ups (the shard with crashed specs still emits a
    /// [shard-summary], so it's NOT a shard_failure).
    fn merge(self, out: string, parsed: ShardSummary) -> Totals {
        let shard_blew_up = parsed.total == 0 && parsed.crashes == 0 && !out.contains("No tests ran")
        self with {
            pass: self.pass + parsed.pass,
            fail: self.fail + parsed.fail,
            total: self.total + parsed.total,
            shard_failures: self.shard_failures + (if shard_blew_up { 1 } else { 0 }),
            crashes: self.crashes + parsed.crashes,
        }
    }
}

// hkms.1.1 perf pass: roll up every cross-shard-shared input (every
// @std/* source under listing_file, plus reporter.av, runtime.o,
// llvm_wrapper.o) into one SHA-256 hex digest. Each individual
// sha256_file call hits the on-disk sidecar cache (~50µs), but the
// fingerprint canonical-string assembly + per-shard repeated sidecar
// reads add up across 451 shards. Hashing once at the orchestrator
// and passing the rolled digest as a single synthetic `@@fp:<hex>`
// source entry collapses that work.
fn compute_test_universe_fp(listing_file: string, reporter_path: string, runtime_o: string, llvm_wrap_o: string) -> string {
    let std_paths = if avra_selfhost_file_exists(listing_file) != 0 {
        read_listing_file_paths(listing_file)
    } else {
        []
    }
    mut paths = std_paths
    paths.push(reporter_path)
    paths.push(runtime_o)
    paths.push(llvm_wrap_o)
    fingerprint_paths(paths)
}

/// Read a newline-separated path listing produced by `find ... | sort`.
/// Drops blank lines. Shared between the orchestrator's universe-fp
/// hasher and `make_test_inputs`'s shard-side fallback.
fn read_listing_file_paths(listing_file: string) -> List<string> {
    let raw = avra_selfhost_read_file(listing_file)
    mut out: List<string> = []
    for p in raw.split("\n") {
        if p != "" { out.push(p) }
    }
    out
}

// Read env vars, resolve the compiler, prepare the log dir, kick off
// the @std/* pre-build (so each shard's metadata-fast-path is ready),
// pre-compute the @std source listing, and bake all of that into the
// per-shard env prefix. Done once — every shard then just appends its
// own AVRA_LIB_PKG_ROOT='<slug>' and runs.
//
// fxwn: library mode is the default — the full per-file suite goes
// 121s → 11s warm (10.7x) because expand_macro_test and friends stop
// paying 10s × N for their inline bs2 compiles. Set
// AVRA_USE_METADATA_LIB=0 (or AVRA_SKIP_PREBUILD=1) to opt out.
fn prepare_test_run(project_dir: string, args: TestArgs) -> RunCtx {
    let compiler_path = resolve_compiler_path(project_dir)
    // Per-run (pid-scoped) log dir. A single shared `build/test_shards`
    // was wiped by the `rm -rf` below at EVERY run start, so a nested
    // `bs2 test` (a spec fixture driving the runner end-to-end) or a
    // concurrent run in the same tree deleted the outer run's shard
    // logs mid-flight — the outer aggregate then misread every live
    // shard as jetsam-killed ("no log produced"). Scoping the dir by
    // pid and cleaning only OUR OWN slot makes runs independent; stale
    // slots from crashed runs are tiny text logs reclaimed by the next
    // `make clean`.
    let log_dir = "${project_dir}/build/test_shards/${string(avra_getpid())}"
    avra_shell_exec("rm -rf '${log_dir}' && mkdir -p '${log_dir}'")

    mut tpr = avra_uptime_ms()
    let lib = maybe_prebuild_std_libs(project_dir, compiler_path)
    tpr = shard_phase_ms("prepare:maybe_prebuild_std_libs", tpr)
    // `bs2 test` owns its resource policy. The profile describes the work
    // (including RC strict), while the platform snapshot describes the actual
    // cgroup/host capacity and pressure. No workflow needs an AVRA_JOBS guess.
    let snapshot = resource_snapshot()
    let profile = resource_profile(
        "test-shard",
        sha256_file(compiler_path),
        "batch=${string(TEST_BATCH_FILES)};metadata=${if lib.want_meta() { "1" } else { "0" }}")
    let normal_per_shard_mb = lib.per_shard_mb()
    let per_shard_mb = resource_profile_seed_mb(profile, normal_per_shard_mb)
    let jobs = compute_shard_jobs(lib.job_ceiling(), per_shard_mb, snapshot)
    // t-6flr: reports the ACHIEVED mode, plus the cause when it's degraded.
    eprintln("${lib.report(jobs, snapshot.available_mb)}\n[resources] profile=${resource_runtime_mode_label(profile.runtime_mode)} scope=${resource_scope_label(snapshot.scope)} pressure=${resource_pressure_label(snapshot.pressure)} seed=~${string(per_shard_mb)}MB/shard")
    tpr = shard_phase_ms("prepare:jobs_and_mem", tpr)
    let listing_file = compute_std_listing_file(project_dir, log_dir)
    tpr = shard_phase_ms("prepare:std_listing", tpr)
    let universe_fp = compute_test_universe_fp(listing_file, test_reporter_path(project_dir),
                                               "${project_dir}/build/runtime.o",
                                               "${project_dir}/build/llvm_wrapper.o")

    RunCtx {
        log_dir: log_dir,
        compiler_path: compiler_path,
        env_prefix: build_shard_env_prefix(lib, listing_file, universe_fp, project_dir),
        filter_arg: if args.filter == "" { "" } else { " --filter '${args.filter}'" },
        want_meta: lib.want_meta(),
        jobs: jobs,
        profile: profile,
        snapshot: snapshot,
        normal_per_shard_mb: normal_per_shard_mb,
        per_shard_mb: per_shard_mb,
    }
}

/// Profile-aware initial width. The controller may narrow this ceiling under
/// live pressure, but users and CI never tune it directly.
///
/// Both shard modes are MEMORY-bound (see the RunCtx.jobs comment for
/// the measured footprints). The historic static caps (8 metadata /
/// 2 whole-program) ignored both the box's RAM and its core count, so
/// on a tight box the full suite peaked over the OOM cliff. Here the
/// static default becomes a CEILING that available RAM can only LOWER:
///
///     jobs = min(ceiling, (avail_mb - reserve) / per_shard_mb)
///
/// `avail_mb` is the platform-neutral usable-memory sample, taken ONCE by
/// the caller after the serial prebuild freed its ~5GB — the same sample the
/// run header announces, so the number reported is the number spent. The
/// native boundary uses cgroup headroom on Linux and reclaimable VM pages on
/// macOS. When it can't be read, capacity is the fallback.
///
/// When live availability is unavailable, capacity is still an honest
/// conservative fallback. Fully unknown platforms preserve the mode ceiling.
fn compute_shard_jobs(mode_ceiling: int, per_shard_mb: int, snapshot: ResourceSnapshot) -> int {
    let ceil = resource_width_cap(mode_ceiling, snapshot)
    let avail_mb = if snapshot.available_mb > 0 { snapshot.available_mb } else { snapshot.capacity_mb }
    if avail_mb <= 0 { return ceil }
    // The reserve lives on libmode (SHARD_RESERVE_MB) beside the per-shard
    // estimates, shared with the admission governor. History of the number:
    // the no-metadata fixture compiles are `env -u AVRA_USE_METADATA bs2
    // compile`, i.e. a ~5GB WHOLE-PROGRAM compile each; those are now
    // slot-capped (#863) and the diagnostic majority fast-pathed to
    // ~1.5GB (#866), but a ~5GB @comptime-fixture compile can still
    // coincide with the shards. At a 3GB reserve the full suite once
    // peaked 14.7GB (min avail 1.3GB — a near-OOM) because ~2 of those
    // stacked on 6 metadata shards. 6GB leaves room for a fixture
    // spike so the shard count backs off to keep the combined peak
    // clear of the cliff.
    let reserve_mb = SHARD_RESERVE_MB
    // 5×1800 + 6GB reserve ≈ 15GB fits a 16GB box — why CI runs green at
    // jobs=5. (Two prior re-measurements that bumped this were both artefacts:
    // ~3.6GB taken mid-sweep under contention, ~5.4GB taken off a
    // WHOLE-PROGRAM shard. The bump halved jobs 5→2 and doubled CI wall-time.)
    let budget = avail_mb - reserve_mb
    mut by_mem = budget / per_shard_mb
    if by_mem < 1 { by_mem = 1 }
    if by_mem < ceil { by_mem } else { ceil }
}

/// F4 (uzs9.5.4): one fingerprint over EVERY input that feeds the @std/*
/// producer `.o`s — all `packages/std-*/src/**.av` (tests excluded; they
/// aren't compiled into the producers), every package `avra.toml` (a dep
/// edit changes the object), the compiler binary, and the two C runtime
/// objects. Hashing this whole set ONCE (~0.4s) is the spawn-free
/// replacement for launching `bs2 build --lib` per package (~2.7s) just to
/// re-derive per-package freshness. Because it covers ALL packages (not the
/// std-avrac-only universe_fp), a match proves NO producer .o can be stale —
/// so the prebuild gate can skip every spawn soundly. `find | sort` gives a
/// deterministic order so the digest is stable run-to-run and cross-process.
fn std_prebuild_fingerprint(project_dir: string, compiler_path: string) -> string {
    let src_listing = avra_shell_exec("find '${project_dir}/packages'/std-*/src -name '*.av' -type f -not -path '*/tests/*' 2>/dev/null | sort")
    let manifest_listing = avra_shell_exec("find '${project_dir}/packages'/std-*/ -maxdepth 2 -name 'avra.toml' 2>/dev/null | sort")
    mut paths: List<string> = []
    for p in src_listing.split("\n") { if p != "" { paths.push(p) } }
    for p in manifest_listing.split("\n") { if p != "" { paths.push(p) } }
    paths.push(compiler_path)
    paths.push("${project_dir}/build/runtime.o")
    paths.push("${project_dir}/build/llvm_wrapper.o")
    fingerprint_paths(paths)
}

/// P6 library-mode pre-build. Each @std/* package's .meta.bin + .o
/// is freshened before shards dispatch so AVRA_USE_METADATA=1 can
/// link against pre-built producer objects (paired flag — metadata-
/// only shards inline nothing for @std/*).
///
/// Serial (jobs=1 implied by the helper) because workspace packages
/// with [dependencies] sub-build their own deps; concurrent
/// outer+inner runs would race on the same per-dep cache slot.
/// One line naming both paths and both timestamps when `build/bs2` predates a
/// compiler source, or "" when it does not. t-kdyj.10.
///
/// The staleness DEFINITION stays in diagnose.sh rather than being reimplemented
/// here: that file already owns the one answer to "what counts as a compiler
/// source", and a second copy in Avra is how the runner would start reporting a
/// different file from the one that actually triggers a rebuild. The cost is a
/// single shell-out per run, against a suite measured in minutes.
///
/// Silent — deliberately — when the script is unreachable (a `bs2 test` run
/// from outside the bootstrap tree). A reporter that cannot answer should say
/// nothing, not guess.
fn bs2_staleness_note() -> string {
    avra_shell_exec("bash scripts/diagnose.sh --bs2-stale-report 2>/dev/null || true").trim()
}

fn maybe_prebuild_std_libs(project_dir: string, compiler_path: string) -> LibMode {
    // The metadata fast-path has TWO coupled halves: shards built with
    // AVRA_USE_METADATA=1 STUB every @std/* symbol as an extern, and
    // AVRA_LIB_OBJS supplies the producer .o's that DEFINE them at link.
    // LibMode.want_meta() derives the mode from those objects, so every return
    // below is honest by construction; what each adds is the CAUSE to report.
    if avra_process_env_get("AVRA_USE_METADATA_LIB") == "0" {
        return lib_mode_off(LibModeCause.OptedOut("AVRA_USE_METADATA_LIB=0"))
    }
    if avra_process_env_get("AVRA_SKIP_PREBUILD") != "" {
        return lib_mode_off(LibModeCause.OptedOut("AVRA_SKIP_PREBUILD is set"))
    }
    // F4 (uzs9.5.4): skip the 7 per-package `bs2 build --lib` spawns (~2.7s per
    // `bs2 test`, i.e. per sweep dir) when @std is UNCHANGED — the fingerprint
    // folds every input to the producer .o's, so a match proves none is stale.
    // Any miss falls through to the full prebuild, which is about to fix it, so
    // its cause is transient and discarded rather than reported.
    let prebuild_fp = std_prebuild_fingerprint(project_dir, compiler_path)
    let marker_path = "${project_dir}/build/.std_prebuild_fp"
    if prebuild_fp != "" && avra_selfhost_read_file(marker_path).trim() == prebuild_fp {
        let cached = collect_workspace_lib_objs(project_dir)
        if cached.want_meta() { return cached }
    }
    let rc = pre_build_workspace_std_packages(project_dir, compiler_path)
    if rc != 0 {
        let diag = avra_shell_exec("grep -lE 'error|abort|Killed|cannot' '${project_dir}/packages'/std-*/build/prebuild.log 2>/dev/null; tail -n 8 $(grep -lE 'error|abort|Killed|cannot' '${project_dir}/packages'/std-*/build/prebuild.log 2>/dev/null | head -1) 2>/dev/null")
        if diag != "" { eprintln("[per-file] first failing pre-build log:\n${diag}") }
        return lib_mode_off(LibModeCause.Unavailable("the @std/* pre-build failed (rc=${string(rc)}) — see packages/std-*/build/prebuild.log"))
    }
    let lib = collect_workspace_lib_objs(project_dir)
    if !lib.want_meta() { return lib }
    // Mark fresh ONLY after a fully-successful prebuild + collect. A torn
    // marker just mismatches next run → a redundant-but-safe full prebuild.
    let _ = avra_selfhost_write_file(marker_path, prebuild_fp)
    lib
}

/// Pre-compute the @std source listing ONCE. Each shard's
/// `make_test_inputs()` otherwise forks `find` over the same ~275
/// files — 7ms × 451 ≈ 3s of CPU saved.
///
/// EXCLUDES `**/tests/**` paths. Test sources under std-avrac/src
/// are not compiled into the test binaries — they're test fixtures
/// for the compiler itself. Including them in this listing folds
/// their content into the universe_fp, which keys every test-shard
/// binary cache entry. A single test-file edit would then invalidate
/// every other test's cached binary, forcing a full ~400s cold
/// recompile of all ~600 shards for what's semantically a one-test
/// change. Excluding them turns "edit one test" from O(all_tests)
/// into O(1) cache invalidation.
fn compute_std_listing_file(project_dir: string, log_dir: string) -> string {
    let std_root = find_packages_dir(project_dir) + "std-avrac/src"
    let listing_file = "${log_dir}/std-listing.txt"
    avra_shell_exec("find '${std_root}' -name '*.av' -type f -not -path '*/tests/*' 2>/dev/null | sort > '${listing_file}'")
    listing_file
}

/// One environment-variable assignment for the shard command line.
/// `value=""` means "skip this var" — used by callers that conditionally
/// include LibObjs / etc.
type EnvAssignment = { name: string, value: string }

/// Render `[EnvAssignment, ...]` into a shell-prefix string:
///   `NAME1='val1' NAME2='val2' ...` (trailing space included so
/// the caller can concatenate the next token directly). Skips
/// entries whose value is empty so optional vars stay unset.
fn format_env_prefix(vars: List<EnvAssignment>) -> string {
    list_fold(vars, "", (acc: string, v: EnvAssignment) -> {
        if v.value == "" { acc } else { "${acc}${v.name}='${v.value}' " }
    })
}

/// Bake the per-shard env once. AVRA_SKIP_ENSURE_BS2=1 stops the
/// diagnose.sh inside shards from re-running the rebuild check (10
/// concurrent rebuilds triggered jetsam mass-kills before).
fn build_shard_env_prefix(lib: LibMode, listing_file: string, universe_fp: string, project_dir: string) -> string {
    format_env_prefix([
        EnvAssignment { name: "AVRA_USE_METADATA",    value: if lib.want_meta() { "1" } else { "" } },
        EnvAssignment { name: "AVRA_LIB_OBJS",        value: lib.lib_objs },
        EnvAssignment { name: "AVRA_STD_LISTING_FILE", value: listing_file },
        EnvAssignment { name: "AVRA_STD_UNIVERSE_FP",  value: universe_fp },
        // F2 (uzs9.5.2, 3b-iii): the cross-shard @std type-env sidecar root —
        // shared, stable, keyed by the universe fp inside f2_typeenv_* as
        // <root>/cache/typeenv/<universe_fp>/. Always set (inert unless the flag
        // below is also set — f2_typeck_env_cached checks the flag first).
        EnvAssignment { name: "AVRA_F2_CACHE_DIR",     value: "${project_dir}/build" },
        // Forward the F2 flag to shards (the spawn uses an explicit env prefix,
        // not full inheritance). OFF by default — F2 stays dormant: the measured
        // win is negligible (~22ms/shard @std env-collect saving; see
        // uzs9.5.2), so the cache is not enabled. Empty when unset ⇒
        // format_env_prefix drops it ⇒ shards keep the today path ⇒
        // byte-identical. AVRA_F2_TYPEENV_CACHE=1 opts a run in (experimental).
        EnvAssignment { name: "AVRA_F2_TYPEENV_CACHE", value: avra_process_env_get("AVRA_F2_TYPEENV_CACHE") },
        EnvAssignment { name: "AVRA_SKIP_ENSURE_BS2",  value: "1" },
    ])
}

// Fan out shards via `spawn { }`, capping concurrency at `jobs` by
// chunking. Each spawn body shells out to `bs2 _test_shard <path>`
// — that subprocess writes its own log file, so the spawn's return
// value isn't load-bearing.
//
// Continuous dispatch via @std.avrac.build.pool's `pool_run`. The
// historic worry (hkms.1.1 comment) was its 50ms poll-sleep in
// workers_reap costing more than the straggler tail saved for
// uniformly-short ~80ms-per-shard workloads — but a cold suite
// histogram (jdgo investigation, 2026-06-01) reveals shard times
// are HIGHLY heterogeneous: p50 = 0ms, p90 = 434ms, p99 = 19.5s,
// max = 79s (walker_valuetype_test). With chunked dispatch, one
// 79s shard in a chunk of 8 pinned 7 workers idle for ~60s each —
// cold wall 463s while sum(shard_times) = 464s, i.e. workers ran
// almost completely serial-equivalent at 1.5 CPU usage on 8 cores.
//
// Continuous dispatch via pool_run reclaims that idle time: any
// worker grabs the next pending shard the moment it finishes. The
// 50ms poll cost is bounded at ~28s aggregate worst-case
// (562 shard finishes × 50ms each) which the wall-time floor
// (max(shard) = 79s) absorbs without consequence.
//
// LJF ordering (cbg3) is preserved: callers still sort by source
// size before invocation, so the biggest shards launch first and
// the tail of cheap shards backfills workers continuously.
//
// Generic resource-controller dispatch. Test supplies its work plan; the
// resources module owns execution-mode seeds, snapshots, reservations, and
// cross-platform pressure feedback.
fn dispatch_shards(shards: List<Shard>, cx: RunCtx, prior_mb: int) -> MemGovernor {
    let cmds = list_map(shards, (s: Shard) -> s.cmd)
    let gov = resource_controller_for_snapshot(cx.jobs, cx.profile, cx.normal_per_shard_mb, SHARD_RESERVE_MB, cx.snapshot)
    gov.seed_estimate(prior_mb)
    let _ = pool_run_resource_admitted(cmds, gov, () -> resource_snapshot())
    eprintln(gov.summary())
    gov
}

// Cold-rebuild jetsam recovery: any shard whose log is empty got
// SIGKILL'd before producing output. The surviving shards have
// already warmed the @std cache, so we redispatch the victims at a
// low width — peak RSS ~1.6GB/shard fits comfortably while still
// being faster than serial. Capped at the run's memory-aware `jobs`
// so a tight box that already dropped to jobs=1 (whole-program
// fallback) doesn't recover at a width that re-triggers the OOM.
/// Shards whose subprocess died before flushing any output — the jetsam
/// victims. Shared by the retry (which re-runs them) and the prior
/// persistence gate (which must not decay off an unmeasured run).
fn jetsam_victims(shards: List<Shard>) -> List<Shard> {
    list_filter(shards, (s: Shard) -> !s.log_alive())
}

fn retry_jetsam_killed(shards: List<Shard>, cx: RunCtx, per_shard_mb: int) {
    let victims = jetsam_victims(shards)
    if victims.length == 0 { return }
    let retry_jobs = if cx.jobs < 2 { cx.jobs } else { 2 }
    eprintln("[per-file] retrying ${string(victims.length)} jetsam-killed shard(s) (jobs=${string(retry_jobs)})")
    // No prior seed and no persistence here: the caller already passes the
    // corrected estimate, and the retry's small warmed subset would
    // UNDERCUT the main dispatch's just-persisted peak.
    let retry_cx = cx with { jobs: retry_jobs, per_shard_mb: per_shard_mb, snapshot: resource_snapshot() }
    let _ = dispatch_shards(victims, retry_cx, per_shard_mb)
}

// Walk each shard's log file, print it verbatim (preserving per-shard
// output the user expects), parse the `[shard-summary]` line for the
// aggregate counts, and render the unified pass/fail summary.
//
// t-kdyj.2 (folding t-jpjn's sweep property in): a red run ends with the
// LIST of failing shards, not just a count — the per-shard logs scroll
// past, and a bare tally sends the reader grepping for what actually
// broke. Each entry names the shard, classifies the failure (spec fails
// vs crashes vs the shard itself failing to compile/run), and points at
// the full log.
fn aggregate_shard_logs(shards: List<Shard>, t_start: int) -> int {
    mut totals = Totals { pass: 0, fail: 0, total: 0, shard_failures: 0, crashes: 0 }
    mut red: List<string> = []
    for s in shards {
        if !s.log_alive() {
            eprintln("[shard ${s.slug}] no log produced (compile likely failed before stdout)")
            totals = totals with { shard_failures: totals.shard_failures + 1 }
            red.push("${s.slug} — NO LOG PRODUCED — died before writing a byte (compile/link failure, or killed)")
            continue
        }
        let out = s.read_log()
        println(out)
        let parsed = s.summary(out)
        let prior_shard_failures = totals.shard_failures
        totals = totals.merge(out, parsed)
        // t-65td: name the CAUSE CLASS, not just "failed". The log is
        // the evidence, but the reader should not have to open it to
        // learn whether the box or the code is at fault.
        if totals.shard_failures > prior_shard_failures || parsed.fail > 0 || parsed.crashes > 0 {
            let cause = classify_shard_failure(out, parsed.fail, parsed.crashes)
            red.push("${s.slug} — ${cause} (log: ${s.log_path})")
        }
    }
    if red.length > 0 {
        println("[per-file] failing shards:")
        for line in red {
            println("  ${line}")
        }
    }
    render_test_summary(totals, avra_uptime_ms() - t_start)
}

/// Pretty-print the unified pass/fail tally + elapsed wall-time.
/// Returns the orchestrator's exit code (0 green, 1 anything red).
/// hkms.3: crashes appear as a distinct note (`Nspec(s) crashed`)
/// alongside fails and shard-level blow-ups so the reader can see
/// at a glance whether they hit assertion mismatches, fatal signals,
/// or shard compile errors.
fn render_test_summary(t: Totals, elapsed_ms: int) -> int {
    let summary = "${string(t.pass)}/${string(t.total)} tests passed in ${format_elapsed_seconds(elapsed_ms)}"
    if t.fail > 0 || t.shard_failures > 0 || t.crashes > 0 {
        let crash_note = if t.crashes > 0        { ", ${string(t.crashes)} spec(s) crashed" } else { "" }
        let shard_note = if t.shard_failures > 0 { ", ${string(t.shard_failures)} shard(s) failed to compile/run" } else { "" }
        println("\x1b[31m\x1b[1m${summary}\x1b[0m \x1b[31m(${string(t.fail)} failed${crash_note}${shard_note})\x1b[0m")
        return 1
    }
    println("\x1b[32m\x1b[1m${summary}\x1b[0m")
    0
}

/// Format a millisecond duration as `X.Ys` (one-decimal seconds).
/// Integer math only — Avra doesn't have floats in const contexts.
/// Used by both `render_test_summary` and the per-mod build progress
/// printer below; previously inlined at both call sites with the
/// same divide/mod dance.
fn format_elapsed_seconds(elapsed_ms: int) -> string {
    let s = elapsed_ms / 1000
    let tenths = (elapsed_ms / 100) - (s * 10)
    "${string(s)}.${string(tenths)}s"
}

// t-kdyj.2: the commit-gate marker, folded in from the deleted
// `diagnose.sh --sweep` (t-8rsg property). A green FULL suite run IS the
// pre-commit hook's suite evidence — record it where the hook looks
// (build/.tests_verified) so the hook skips its duplicate pass. The hash
// definition stays in diagnose.sh (`--test-input-hash`, one definition
// shared with the hook); a repo without that script (any non-bootstrap
// project) simply never writes a marker. Scoped runs (--filter or a path
// arg) prove only part of the tree and never write it.
fn commit_gate_start_hash(project_dir: string, args: TestArgs) -> string {
    if args.filter != "" || args.path_filters.length > 0 { return "" }
    if avra_selfhost_file_exists("${project_dir}/scripts/diagnose.sh") != 1 { return "" }
    suite_input_hash(project_dir)
}

/// The hook-parity suite-input hash (bs2 + every .av + runtime + seed +
/// diagnose.sh + Makefile). Empty when the script is missing or errors.
fn suite_input_hash(project_dir: string) -> string {
    avra_shell_exec("cd '${project_dir}' && bash scripts/diagnose.sh --test-input-hash 2>/dev/null").trim()
}

/// 0o8i drift guard, same as the hook's: re-hash immediately before
/// writing — a mid-run edit means this green no longer describes the
/// current tree, so the next commit must re-run, not skip.
fn write_commit_gate_marker(project_dir: string, start_hash: string, rc: int) {
    if start_hash == "" || rc != 0 { return }
    if suite_input_hash(project_dir) != start_hash {
        eprintln("[per-file] inputs changed mid-run — commit-gate marker NOT written (the pre-commit hook will re-run the suite)")
        return
    }
    if avra_selfhost_write_file("${project_dir}/build/.tests_verified", "${start_hash}\n") != 1 {
        eprintln("[per-file] commit-gate marker could NOT be written (the pre-commit hook will re-run the suite)")
        return
    }
    eprintln("[per-file] commit-gate marker written — the pre-commit hook will skip its duplicate suite run")
}

// Shim around `compile_test_unit`. The heavy work — parse, resolve,
// hoist @std, prepend reporter, synthesise main, typecheck,
// monomorphize, codegen, link — moved into compile_test_unit so this
// command and `run_build_command` (future) share one in-process
// pipeline. The command itself owns: arg parsing, test-file
// discovery + filtering, cache lookup/publish, exec, and the
// coverage-only post-run profdata/render steps.
// `args` is built from the parsed CliResult by the declarative `command test`
// block; the shard subcommand's `command _test_shard` block builds the same
// TestArgs shape from its own CliResult (variadic `paths` positional).
fn run_test_command(args: TestArgs) {
    // The bs2 executing this suite IS the compiler under test — current
    // by construction. Stamp the guard diagnose.sh's ensure_bs2 honors
    // so no descendant (shard shell → test binary → avra_shell_exec →
    // `bash scripts/diagnose.sh --run …`) can decide bs2 is stale and
    // rebuild/relink it mid-run out from under live shards (t-gv3n: on
    // Linux the old BSD-only stat made that decision ALWAYS-stale, so
    // every diagnose.sh-based fixture test rebuilt bs2 concurrently).
    // Set once here; every dispatch path (per-file, bundled, coverage)
    // and every child inherits it.
    // The bs2 executing this suite IS the compiler under test — current
    // by construction. Stamp the guard diagnose.sh's ensure_bs2 honors
    // so no descendant (shard shell → test binary → avra_shell_exec →
    // `bash scripts/diagnose.sh --run …`) can decide bs2 is stale and
    // rebuild/relink it mid-run out from under live shards (t-gv3n: on
    // Linux the old BSD-only stat made that decision ALWAYS-stale). The
    // per-file path additionally bakes this into each shard cmd
    // (build_shard_env_prefix); setting it HERE covers the bundled and
    // coverage paths too — every dispatch path forks from this process.
    avra_process_env_set("AVRA_SKIP_ENSURE_BS2", "1")
    let project_dir = avra_process_env_get("PWD")

    // Structural discovery via the @std.avrac.test_runner discovery
    // module. Walks the project tree natively (no shell fork),
    // classifies every `.av` source by tokens (so `spec` in a
    // comment doesn't false-positive, and `*_test.av` naming is no
    // longer load-bearing). Filters out files declaring their own
    // `fn main(`. Result is sorted by path for stable iteration.
    //
    // Path-filter short-circuit: when the user typed
    // `bs2 test <some/literal/path.av>` and that path exists, skip
    // the project-wide walk entirely and classify just that one
    // file. Drops the dominant cost of `bs2 test --list <file>` and
    // `bs2 test <file>` from ~15s (full tree walk + token-classify
    // ~450 .av files) to <50ms (one read + classify). Suffix /
    // substring forms fall through to the full walk because we
    // don't know which file they meant until discovery sees the
    // whole set.
    let discovered = discover_with_path_shortcut(project_dir, args.path_filters)
    let after_filter = filter_discovered(discovered, args.filter)
    // Scope discovery to the positional path args (files, dirs, or
    // path-suffix matches), unioned. Applied AFTER --filter so both
    // compose. An empty list is a no-op fast path.
    let accepted = filter_by_paths(after_filter, args.path_filters)

    // A path that selects NOTHING is an error, and it stays an error when
    // sibling paths matched. Without this, `bs2 test valid.av typo.av` runs
    // valid.av and exits 0 — a successful partial measurement that silently
    // drops a path the operator asked for, which is the same defect as the
    // discarded-argument bug this command just fixed, one level up. Raised in
    // review of #1138; the all-unmatched case exited 0 too.
    //
    // Checked against `discovered` (BEFORE --filter) so an unmatched PATH is
    // attributable to the path itself. A valid path plus a name filter that
    // excludes everything is a different situation and falls through to the
    // filter message below.
    let unmatched = list_filter(args.path_filters,
        (pf: string) -> filter_by_path(discovered, pf).length == 0)
    if unmatched.length > 0 {
        // Name every unmatched path — with N paths the operator needs to know
        // WHICH one was empty, not merely that one was.
        eprintln("error: no test files matched `${unmatched.join("`, `")}`")
        avra_process_exit(1)
        return
    }
    if discovered.length == 0 {
        println("No test files found.")
        return
    }
    if accepted.length == 0 {
        println("No spec test files matched filter.")
        return
    }

    if args.list_only {
        print_discovered(accepted)
        avra_process_exit(0)
        return
    }

    // t-kdyj.10: say it ONCE, before any dispatch path, when the binary running
    // this suite predates a compiler source. A rebase rewrites working-tree
    // mtimes even when the content is byte-identical, so `bs2` reads as stale
    // and the run reds with two failures that name nothing about rebasing — the
    // freshness guard firing correctly, plus a fixture that shells out to the
    // same binary. Both timestamps were already known; only the output lacked
    // them.
    //
    // HERE rather than in prepare_test_run, for the same reason the
    // AVRA_SKIP_ENSURE_BS2 stamp above is here: prepare_test_run is on the
    // PER-FILE path only, so bundled and coverage runs would never report a
    // stale compiler — the note would be absent exactly where a reader had no
    // other clue. After the --list return, because listing runs nothing and so
    // cannot be testing a stale binary.
    let stale = bs2_staleness_note()
    if stale != "" { eprintln(stale) }

    let accepted_paths = list_map(accepted, (d: DiscoveredFile) -> d.path)

    // 05yc: opt-in per-file shard mode. Each test file → its own
    // cache slot + binary. Coverage stays on the bundled path until
    // covmap merging across shards lands.
    if args.per_file && !args.coverage {
        let gate_hash = commit_gate_start_hash(project_dir, args)
        let rc = run_per_file_test_command(project_dir, accepted_paths, args)
        write_commit_gate_marker(project_dir, gate_hash, rc)
        avra_process_exit(rc)
        return
    }

    let inputs = compute_test_build_inputs(project_dir, accepted_paths, args)

    if args.coverage {
        run_test_coverage_path(project_dir, inputs, accepted_paths, args)
        return
    }
    run_test_cached_path(inputs, accepted_paths, args)
}

/// Non-coverage path: cache lookup, build, publish, exec.
///
/// On cache hit we exec the cached binary directly — no compile, no
/// publish. On cache miss we compile, publish the result (capturing
/// any publish failure as a non-fatal warning), then exec.
fn run_test_cached_path(inputs: BuildInputs, accepted_paths: List<string>, args: TestArgs) {
    let publish_fp = check_test_cache_or_miss(inputs)  // exits process on hit
    let bin_path = match compile_test_unit(inputs, accepted_paths, args) {
        .Ok(p) -> p
        .Err(e) -> { fail(e) }
    }
    if publish_fp != null {
        publish_test_binary(inputs, publish_fp!, bin_path)
    }
    avra_process_exit(avra_process_forward(bin_path, "[]", ""))
}

/// Look up the test bundle in the build cache. On hit: forwards to
/// the cached binary, prints the exit code, and `avra_process_exit`s
/// — never returns. On miss: returns the fingerprint the caller
/// should publish under after compiling.
fn check_test_cache_or_miss(inputs: BuildInputs) -> Fingerprint? {
    match decide_build(inputs) {
        .Hit(fp, bin_path) -> {
            eprintln("[test-cache] hit ${fp_short(fp)} — ${bin_path}")
            avra_process_exit(avra_process_forward(bin_path, "[]", ""))
            null  // unreachable — avra_process_exit doesn't return
        }
        .Miss(fp, _, reason) -> {
            eprintln("[test-cache] miss ${fp_short(fp)} — ${reason}")
            fp
        }
    }
}

/// Publish a freshly-compiled test binary into the build cache under
/// `fp`. Failures are reported but don't abort the test run — the
/// binary is still on disk and the user can re-run.
fn publish_test_binary(inputs: BuildInputs, fp: Fingerprint, bin_path: string) {
    let staging_id = "${inputs.unit_name}.${fp_short(fp)}"
    let pr = record_build_result(inputs, fp, "", "", "", bin_path, "", staging_id)
    if !pr.success {
        eprintln("[test-cache] publish failed: ${pr.error}")
    } else {
        eprintln("[test-cache] published ${fp_short(fp)}")
    }
}

/// Coverage path: compile (no cache — covmap.tsv isn't binary-cached
/// at v1), run with LLVM_PROFILE_FILE set, merge the raw profile via
/// `llvm-profdata`, dump per-function counts as text, and render the
/// coverage report via the Avra-side coverage::render_coverage.
/// Partition the accepted set for the coverage run, mirroring plan_shards'
/// stride partition so a coverage shard's membership matches what the default
/// path would co-schedule. Returns the whole set as ONE batch when batching is
/// disabled, which keeps the pre-i7gw.2 behaviour reachable.
fn coverage_batches(accepted_paths: List<string>) -> List<List<string>> {
    let k = TEST_BATCH_FILES
    if k <= 1 { return [accepted_paths] }
    let stable = sort_paths_lex(accepted_paths)
    let n = stable.length
    if n == 0 { return [] }
    mut nb = n / k
    if nb * k < n { nb = nb + 1 }
    if nb == 0 { nb = 1 }
    mut batches: List<List<string>> = []
    for b in 0..nb {
        mut members: List<string> = []
        mut i = b
        while i < n {
            members.push(stable[i])
            i = i + nb
        }
        if members.length > 0 { batches.push(members) }
    }
    batches
}

fn run_test_coverage_path(project_dir: string, inputs: BuildInputs,
                          accepted_paths: List<string>, args: TestArgs) {
    let cov_dir = "${project_dir}/build/coverage"
    let profdata = "${cov_dir}/_test.profdata"
    let llvm_prefix = resolve_llvm_prefix()
    let pid = string(avra_getpid())

    // i7gw slice 2: SHARD the coverage run. This was the last place `bs2 test`
    // still assembled one whole-program binary — the ~6000MB/shard shape t-6flr
    // measured, on the one path that also links the instrumentation runtime.
    // Each shard compiles and runs independently with its OWN profraw; the
    // counts are merged by llvm-profdata (which takes N inputs natively) and
    // the static mappings by merge_covmaps.
    let batches = coverage_batches(accepted_paths)
    mut profraws: List<string> = []
    mut covmaps: List<string> = []
    // The exit status is a FOLD, not the last shard's. Taking the last would
    // mask a red shard behind a green one that happened to run after it —
    // slice 1 already had to fix this path silently exiting 0 on a failing
    // suite, and sharding reintroduces the same hazard N-fold.
    mut worst_rc = 0
    mut idx = 0
    for batch in batches {
        let shard_id = "cov${string(idx)}.${pid}"
        idx = idx + 1
        let bin_path = match compile_test_unit_to(inputs, batch, args, shard_id) {
            .Ok(p) -> p
            .Err(e) -> { fail(e) }
        }
        let profraw = "${cov_dir}/_test_${shard_id}.profraw"
        avra_shell_exec("rm -f ${profraw}")
        // AVRA_TEST_JOBS=1: instrprof counters aren't atomic, so the coverage
        // run pins the IN-PROCESS runner to sequential execution for exact
        // counts. That pin is per-process, so sharding does not weaken it —
        // the parallelism moves to processes, which is the sanctioned model.
        let run_rc = avra_process_forward(bin_path, "[]", "{\"env\":{\"LLVM_PROFILE_FILE\":\"${profraw}\",\"AVRA_TEST_JOBS\":\"1\"}}")
        if run_rc != 0 {
            eprintln("coverage shard ${shard_id} exited with code ${string(run_rc)}")
            worst_rc = run_rc
        }
        profraws.push(profraw)
        covmaps.push(coverage_covmap_path(bin_path))
    }
    if profraws.length == 0 {
        eprintln("coverage: no test shards were built — nothing to report")
        avra_process_exit(1)
    }

    let merge_out = avra_shell_exec("${llvm_prefix}/bin/llvm-profdata merge -sparse -o ${profdata} ${profraws.join(" ")} 2>&1")
    if merge_out.length > 0 { eprintln(merge_out.trim()) }
    let merged_covmap = merge_covmaps(covmaps, "${cov_dir}/_test.merged.covmap.tsv")
    let run_rc = worst_rc

    // Dump profdata + hand off to the Avra-side coverage renderer
    // (coverage::render_coverage joins codegen's covmap.tsv with
    // per-function counts to produce line/branch/MC-DC stats + optional LCOV).
    let dump_path = "${cov_dir}/_test.profdata.txt"
    avra_shell_exec("${llvm_prefix}/bin/llvm-profdata show --all-functions --counts ${profdata} > ${dump_path} 2>/dev/null")
    println("")
    // The covmap path derives from the binary the compile just produced
    // (pid-unique stem) — never a hardcoded stem, which silently reads a
    // stale/absent covmap once staging paths change.
    // The MERGED covmap, not a per-binary one: with N shards there is no single
    // binary whose mapping describes the run.
    render_coverage(merged_covmap, dump_path, args.lcov_path)
    // A failing suite must fail the coverage run too — render the report
    // (partial coverage of a red suite is still useful), then propagate
    // the test binary's exit code instead of masking it with 0.
    avra_process_exit(run_rc)
}

/// LLVM toolchain prefix lookup — delegates to the shared probe in
/// @std.avrac.build.link so the CLI agrees with the library's linker
/// about where the toolchain lives on every platform.
fn resolve_llvm_prefix() -> string {
    llvm_prefix_dir()
}

// Top-level dispatch for `avra docs`. `args` is built from the parsed
// CliResult by the declarative `command docs` block (its schema mirrors the
// DocsArgs fields); this loads the requested corpus and routes to the matching
// renderer. Used to live inline in main(); split out so main()'s body stays
// readable as the docs surface keeps growing.
fn run_docs_command(args: DocsArgs) {
    let project_dir = avra_process_env_get("PWD")

    if args.want_validate {
        validate_docs(project_dir)
        return
    }

    // --callers needs the call graph in addition to the SymList; load
    // both so a single corpus walk feeds the reverse-lookup.
    if args.want_callers && args.query != "" {
        let corpus = extract_project_corpus(project_dir)
        if !show_callers(args.query, corpus) {
            print_no_symbol(args.query, corpus.syms, "")
            exit(1)
        }
        return
    }

    let docs_set = load_docs_corpus(project_dir, args)

    if args.want_doctest {
        if !run_doctests(docs_set) {
            exit(1)
        }
        return
    }

    if args.want_gen {
        if args.query == "" {
            eprintln("error: --gen requires a symbol name")
            exit(1)
        }
        if !gen_for_symbol(args.query, docs_set, args.want_print) {
            print_no_symbol(args.query, docs_set, "")
            exit(1)
        }
        return
    }

    // Non-human formats short-circuit. `--format=json` dumps the SymList;
    // `--format=markdown` emits clean GitHub-style markdown.
    if args.format == "json" {
        println(render_json(docs_set))
        return
    }
    if args.format == "markdown" {
        println(render_markdown(docs_set))
        return
    }
    if args.format != "human" {
        eprintln("error: unknown format '${args.format}' (try human / markdown / json)")
        exit(1)
    }

    if args.module_path != "" {
        if !show_module(args.module_path, docs_set) {
            eprintln("")
            eprintln("  No module '${args.module_path}' found in project.")
            eprintln("")
            exit(1)
        }
        return
    }
    if args.search_term != "" {
        show_search(args.search_term, docs_set)
        return
    }
    if args.want_llm {
        show_llm(docs_set)
        return
    }
    if args.want_symbols {
        show_symbols(docs_set)
        return
    }
    if args.query != "" {
        let found = if args.want_short {
            show_short(args.query, docs_set)
        } else {
            show_symbol(args.query, docs_set)
        }
        if !found {
            print_no_symbol(args.query, docs_set, "  Hint: try `avra docs` for an overview.")
            exit(1)
        }
        return
    }
    show_overview(docs_set)
}

// Pick the corpus by scope:
//   project (default) — walk PWD/*.av through the indexer
//   lang              — read target/lang.av (generated by `avra lang`)
//   errors            — same as lang, filtered to F-codes
//   all               — project ∪ lang
//
// `lang`/`errors` paths verify target/lang.av exists before calling
// the lib helper — the lib returns an empty SymList on absence so it
// stays argv-free; the CLI surfaces the missing-file diagnostic.
fn load_docs_corpus(project_dir: string, args: DocsArgs) -> List<Sym> {
    match args.scope {
        "project" -> extract_project_syms_cached(project_dir, args.want_no_cache)
        "lang" -> {
            require_lang_av(project_dir)
            extract_lang_corpus(project_dir)
        }
        "errors" -> {
            require_lang_av(project_dir)
            extract_errors_corpus(project_dir)
        }
        "all" -> {
            mut out = extract_project_syms_cached(project_dir, args.want_no_cache)
            for s in extract_lang_corpus(project_dir) { out.push(s) }
            out
        }
        _ -> {
            eprintln("error: unknown scope '${args.scope}' (try project / lang / errors / all)")
            exit(1)
            []
        }
    }
}

// CLI guard: bail with a friendly message when the lang corpus
// scopes are requested but `target/lang.av` is absent.
fn require_lang_av(project_dir: string) {
    if avra_selfhost_file_exists("${project_dir}/target/lang.av") == 0 {
        eprintln("error: target/lang.av not found — run `avra lang` first")
        exit(1)
    }
}

// Look up `query` in the project's SymList and either print a doc-stub
// to stdout (`--print`) or insert it above the symbol's decl. Returns
// false when the symbol can't be found so the caller can render a
// did-you-mean hint.
fn gen_for_symbol(query: string, docs_set: List<Sym>, want_print: bool) -> bool {
    let target = find_sym_for_gen(docs_set, query)
    if target == null { return false }
    let s = target!
    let stub = gen_stub_for_sym(s)
    if want_print {
        println(stub)
        return true
    }
    // The Sym's span anchors to the leading /// when one exists, so an
    // already-documented decl reports `doc != ""`. That's our primary
    // idempotency guard; gen_apply also re-checks line-1 to catch hand-
    // edited /// blocks that the indexer hadn't picked up yet.
    if s.doc != "" {
        println("${s.qualified}: already documented")
        return true
    }
    let r = gen_apply(s.file, s.span.start.line, stub)
    if r.error != "" {
        eprintln("error: ${r.error}")
        return false
    }
    if r.skipped {
        println("${s.qualified}: ${r.reason}")
    } else {
        println("${s.file}:${s.span.start.line}: inserted /// stub for ${s.qualified}")
    }
    true
}

// ── Subcommand handlers ──
// One `fn cmd_<name>(args: CliResult) -> int` per subcommand — the `run()` body
// of its `command <name> { … }` block in the declarative `App`. Each reads its
// flags/args from the parsed `args` and returns an exit code.

/// The `file` positional resolved to its path + contents. Every file-taking
/// subcommand shares `arg_file_source` so the read + existence check lives in
/// one place.
type FileArg = { path: string, source: string }

/// Resolve the `file` positional to an EXISTING path, failing clearly when it
/// is missing or absent on disk. The path-only tier of `arg_file_source`, for
/// subcommands that read the file through their own machinery (`metadata_show`
/// decodes binary; `compile` routes through its cache).
fn arg_file_path(args: CliResult) -> string {
    let path = result_get_arg(args, "file")
    if path == "" { fail("error: this command requires a file argument") }
    if !file_exists(path) { fail("error: file not found: ${path}") }
    path
}

/// Resolve the `file` positional to (path, source), failing clearly when it is
/// missing or unreadable.
fn arg_file_source(args: CliResult) -> FileArg {
    let path = arg_file_path(args)
    FileArg { path, source: read_file(path) }
}

/// `expr <file>` — parse the file as a single expression, print its AST.
fn cmd_expr(args: CliResult) -> int {
    let fa = arg_file_source(args)
    let parsed_e = parse_expr_or_fail(fa.source, render_ctx(false, fa.source, fa.path))
    println(render_expr(parsed_e.store, parsed_e.expr!))
    0
}

/// `program <file>` — parse the file as a full program, print its AST.
fn cmd_program(args: CliResult) -> int {
    let fa = arg_file_source(args)
    // `--recover` is the RECOVERY-TREE probe (t-47hc.5). `parse_or_fail` stops at the
    // diagnostics, so on invalid input — the only input whose tree is interesting —
    // plain `program` prints errors and no tree at all. That left the shape of a
    // recovery tree observable ONLY from inside the differential test (`rtree_at`,
    // which drives `parser_new` in-process), so comparing what the hand and the
    // native rule BUILD meant reading it out of a failing spec's output. The parse
    // itself is the same one the harness uses; only the fail-fast is skipped, and
    // the diagnostics still go to stderr so the tree on stdout stays pipeable.
    if result_has_flag(args, "recover") {
        let r = parse_program_source(fa.source)
        // The COUNT goes to stderr, not the rendered diagnostics: `--parser-probe`
        // already compares the messages, and keeping them off stdout leaves the tree
        // clean to diff. Reporting the count rather than nothing keeps a silent drop
        // (a parse that reported and still produced a full tree) visible.
        eprintln("// ${string(r.bag.error_count)} error(s), ${string(r.bag.warning_count)} warning(s)")
        match r.ids {
            null -> println("(no tree — the parse produced no statements)")
            _ -> println(render_stmt_ids(r.store, r.ids!))
        }
        return 0
    }
    let parsed_p = parse_or_fail(fa.source, render_ctx(false, fa.source, fa.path))
    println(render_stmt_ids(parsed_p.store, parsed_p.ids))
    0
}

/// `metadata_show <file>` — read a `.meta.bin`, synthesize its arena rows, and
/// print them with the same id-native renderer `program` uses (xtvc).
fn cmd_metadata_show(args: CliResult) -> int {
    let path = arg_file_path(args)
    let m = metadata_read(path)
    if m.unit_name == "" {
        fail("error: ${path} is empty or unreadable")
    }
    println("// metadata for unit `${m.unit_name}`")
    println("// fingerprint: ${avra_bytes_to_hex(m.fingerprint)}")
    let show_store = new_node_store(build_line_index(""))
    println(render_stmt_ids(show_store, synthesize_unit_stmts(m, show_store)))
    0
}

/// `eval <file>` — parse the file as an expression, evaluate it, print the value.
fn cmd_eval(args: CliResult) -> int {
    let fa = arg_file_source(args)
    let parsed = parse_expr_or_fail(fa.source, render_ctx(false, fa.source, fa.path))
    let result = eval_parsed_expression(parsed.expr!, parsed.store)
    if result.had_error || result.value == null {
        fail(result.error_message)
    }
    println(render_value(result.value!))
    0
}

/// t-o8pm: answer "if I turn this gate on, what does the corpus reject?"
/// in ONE pass, grouped by conflict rather than by call site.
///
/// Reads the shard logs a `bs2 test` run already produced — the dir-level
/// shard compile is the affordable granularity (per-file `bs2 check` over
/// 1000+ files re-parses @std each time and was heading for hours at
/// ~4.7GB/process), and the runner already keeps every shard's log.
///
/// Defaults to the newest `build/test_shards/<pid>` because that is the
/// run the operator just did; an explicit dir overrides for a saved run.
fn cmd_gate_scan(args: CliResult) -> int {
    let code = result_get_arg(args, "code")
    if code == "" { fail("error: gate-scan requires an F-code, e.g. F1000") }
    let logs = result_get_arg(args, "logs")
    let dir = if logs != "" { logs } else { newest_shard_log_dir() }
    if dir == "" {
        eprintln("gate-scan: no shard logs found — run `bs2 test` first, or pass a log dir")
        return 1
    }
    // NATIVE WALK, never a shell. `dir` is user-supplied (`--logs`), and
    // interpolating it into `cat ${dir}/*.log` both breaks on a legitimate
    // path containing a space (word-splitting silently yields "no readable
    // logs" for a perfectly good directory) and hands shell metacharacters
    // straight to a shell. count_cache_entries / collect_prune_candidates
    // already walk natively for exactly this reason (the ohyd injection);
    // this is the same rule, not a new one.
    mut listing = ""
    for name in avra_readdir(dir) {
        if avra_str_ends_with(name, ".log") != 0 {
            listing = listing + avra_selfhost_read_file("${dir}/${name}") + "\n"
        }
    }
    if listing.trim() == "" {
        eprintln("gate-scan: no readable logs in ${dir}")
        return 1
    }
    println(render_gate_scan(scan_gate_diagnostics(listing, code), code))
    0
}

/// t-zk6j: `diag_delta <new-log> <old-log>` — the diagnostics the NEW
/// compiler raises that the OLD one does not.
///
/// diff-test's selfhost leg has both compilers compile the SAME source,
/// so a PR that makes the compiler stricter fails on a COMPILE error
/// rather than an IR difference. The harness used to call that a
/// "regression" and print a 15-line log tail, which is the wrong word and
/// the wrong evidence: for a deliberate gate it is the new compiler
/// working, and what the operator needs is the REJECTION SET, to confirm
/// it is the one they intended.
///
/// Exits 0 when the delta is a genuine strictness difference, 1 when it
/// is empty or contains an ICE / memory-ceiling stop — so the harness can
/// gate on it rather than re-deriving the judgement in shell.
fn cmd_diag_delta(args: CliResult) -> int {
    let new_path = result_get_arg(args, "new_log")
    let old_path = result_get_arg(args, "old_log")
    if new_path == "" { fail("error: diag_delta requires the NEW compile log") }
    // A MISSING path must be an error, never an empty read. `read_file`
    // returns "" for a path it cannot open, so without these checks a typo'd
    // `--new_log` produces "NEW raises NO error that OLD does not" — a
    // confident verdict derived from a file that was never read — and a
    // typo'd `--old_log` silently subtracts nothing, inflating the delta so
    // it can qualify as a strictness change on evidence nobody looked at.
    // Same message shape as `arg_file_path`.
    if !file_exists(new_path) { fail("error: file not found: ${new_path}") }
    // OLD's log stays OPTIONAL: when OLD compiled cleanly it has no
    // diagnostics to subtract, and requiring the file would make the common
    // case awkward for no gain. Omitted is fine; named-but-absent is not.
    if old_path != "" && !file_exists(old_path) { fail("error: file not found: ${old_path}") }
    let old_src = if old_path == "" { "" } else { avra_selfhost_read_file(old_path) }
    let sites = new_only_diagnostics(avra_selfhost_read_file(new_path), old_src)
    println(render_strictness_delta(sites))
    if delta_is_strictness(sites) { 0 } else { 1 }
}

/// Newest `build/test_shards/<pid>` by mtime, or "" when none exists.
/// Per-pid dirs mean concurrent runs do not clobber each other, so
/// "newest" is the right selector for "the run I just did".
///
/// Native walk rather than `ls -1dt | head -1`: same reason as the reader
/// above — no path reaches a shell, and mtime ordering does not depend on
/// parsing `ls` output.
fn newest_shard_log_dir() -> string {
    let root = "${avra_process_env_get("PWD")}/build/test_shards"
    if avra_is_dir(root) != 1 { return "" }
    mut newest = ""
    mut newest_mtime = 0
    for name in avra_readdir(root) {
        let candidate = "${root}/${name}"
        if avra_is_dir(candidate) != 1 { continue }
        let m = avra_file_mtime(candidate)
        if newest == "" || m > newest_mtime {
            newest = candidate
            newest_mtime = m
        }
    }
    newest
}

/// `avra resources` — a deliberately small machine-readable boundary for
/// orchestration outside the Avra process (notably diagnose.sh diff-test).
/// Schedulers inside the compiler use ResourceSnapshot directly; shell tools
/// consume this stable key=value form instead of reimplementing /proc or Mach.
fn cmd_resources() -> int {
    let snapshot = resource_snapshot()
    println("capacity_mb=${string(snapshot.capacity_mb)}")
    println("available_mb=${string(snapshot.available_mb)}")
    println("cpu_capacity=${string(snapshot.cpu_capacity)}")
    println("pressure=${resource_pressure_label(snapshot.pressure)}")
    println("scope=${resource_scope_label(snapshot.scope)}")
    0
}

/// Internal TTY-progress dispatcher. It deliberately accepts queue metadata
/// only from its parent build process; the public surface is `avra resources`.
/// Keeping this as an Avra command lets a background dispatcher sample live
/// pressure and preserve learned observations while its parent renders markers.
fn cmd_resource_pool(args: CliResult) -> int {
    let commands_path = result_get_option(args, "commands")
    let slugs_path = result_get_option(args, "slugs")
    let marker_dir = result_get_option(args, "marker_dir")
    let project_dir = result_get_option(args, "project_dir")
    let compiler_path = result_get_option(args, "compiler")
    let work_kind = result_get_option(args, "work_kind")
    let plan_shape = result_get_option(args, "plan_shape")
    if commands_path == "" || slugs_path == "" || marker_dir == "" || project_dir == "" || compiler_path == "" || work_kind == "" {
        let _ = write_file("${marker_dir}/resource.summary", "[resources] internal progress dispatcher received incomplete queue metadata")
        return 2
    }
    let commands = read_paths_file_lines(commands_path)
    let slugs = read_paths_file_lines(slugs_path)
    if commands.length != slugs.length {
        let _ = write_file("${marker_dir}/resource.summary", "[resources] internal progress dispatcher queue/marker shape mismatch")
        return 2
    }
    let snapshot = resource_snapshot()
    let profile = resource_profile(work_kind, sha256_file(compiler_path), plan_shape)
    let prior_path = admission_prior_path("${project_dir}/build/cache", resource_profile_key(profile))
    let gov = resource_controller_for_policy(profile, resource_build_pool_policy(profile), snapshot)
    gov.seed_estimate(read_admission_prior(prior_path))
    let rc = pool_run_resource_admitted_with_progress(commands, slugs, marker_dir, gov, () -> resource_snapshot())
    persist_admission_prior(prior_path, gov.observed_mb, gov.static_estimate_mb, rc == 0)
    let summary = "[resources] build ${work_kind}: profile=${resource_runtime_mode_label(profile.runtime_mode)}, scope=${resource_scope_label(snapshot.scope)}, pressure=${resource_pressure_label(snapshot.pressure)}; ${gov.summary()}"
    let _ = write_file("${marker_dir}/resource.summary", summary)
    rc
}

/// JSON array literal of a string list — the shape `avra_process_forward`
/// expects for a child's argv.
fn json_string_list(items: List<string>) -> string {
    mut s = "["
    mut i = 0
    while i < items.length {
        if i > 0 { s = s + "," }
        s = s + json_str(items[i])
        i = i + 1
    }
    s + "]"
}

/// `avra run <file> [args...]` — compile the source to a native binary,
/// exec it, and forward the trailing args as the program's argv (so a
/// CLI built with `@std.cli` sees its subcommands/flags). Replaces the
/// old tree-interpreter path, which never built a process and so could
/// not read argv. Child flags go after a `--` terminator (the parser
/// treats everything past `--` as positional; see the run command's
/// variadic `forward` arg). Uses a private /tmp IR + binary and cleans
/// both up; the program's own exit code is propagated.
fn cmd_run(args: CliResult) -> int {
    avra_compile_slot_gate()
    let fa = arg_file_source(args)
    // Build to a private binary via the build module — same incremental
    // caches as `avra build`, so a repeat `run` of an unchanged program
    // re-runs neither the compiler nor llc/cc. `quiet` keeps a successful
    // build silent (the `go run` model): diagnostics surface only on
    // failure, so the program's own output isn't buried under @std's
    // warning stream. `check` / `compile` / `build` still show warnings.
    let tmp_bin = "/tmp/avra_run_${string(avra_getpid())}.bin"
    mut req = build_request(avra_process_env_get("PWD"))
    req.entry = fa.path
    req.output = tmp_bin
    req.mode = BuildOutput.Quiet
    let report = build_executable(req, run_with_progress)
    if !report.ok {
        let _ = avra_remove_file(tmp_bin)
        fail(report.error)
    }
    // An IR-only build is a legitimate SUCCESS for `bs2 build` (the plain
    // single-unit cycle is the documented default), but it is never one for
    // `run`: there is no binary to run. Exec'ing the path anyway is the
    // silent-127 failure mode — the shell's "command not found" code,
    // forwarded with no message at all.
    if report.binary_path == "" {
        let _ = avra_remove_file(tmp_bin)
        if report.missing_dep != "" {
            // This once prescribed NOTHING, because the obvious remedies did
            // not work: the dep lookup keyed on the `[package]` name while
            // builds record under the `[lib]`/`[bin]` name (`@std/lsp` vs
            // `std-lsp`), so the closure read as incomplete no matter what
            // the user did, and naming a command that cannot help is worse
            // than stopping at the truth. t-jc7u fixed that, so the remedy
            // is real and gets named. Guarded in build_no_executable_test —
            // if the remedy ever stops working, that guard fails rather than
            // this text quietly going stale.
            //
            // Name the COMMAND, not just the flag: `--emit_metadata` is a
            // `bs2 build` flag, and `command run` declares no flags at all, so
            // a bare "pass --emit_metadata" printed by `bs2 run` reads as an
            // option of the command the reader just ran — and typing it there
            // fails. That is the same defect one level down: a remedy the
            // reader cannot act on where they were standing when they read it.
            fail("error: nothing to run — no executable was produced\n" +
                 "  dependency `${report.missing_dep}` has no recorded build, so nothing could be linked\n" +
                 "  build that dependency first, or run `bs2 build --emit_metadata` to pre-build path-deps")
        }
        fail("error: nothing to run — the build produced no executable")
    }
    // Forward the program's argv (everything the run command captured after
    // the source path, via its variadic `forward` arg).
    let rc = avra_process_forward(tmp_bin, json_string_list(result_get_args(args, "forward")), "")
    let _ = avra_remove_file(tmp_bin)
    rc
}

/// `fix <file>` — run the same parse→comptime front `check` gates on, so
/// name resolution sees the EXPANDED program (a file using quotes or
/// components previously mis-resolved against the raw tree), then report
/// that no auto-fixes are available yet. Resolution/comptime failures exit
/// non-zero with rendered diagnostics.
fn cmd_fix(args: CliResult) -> int {
    let fa = arg_file_source(args)
    let ctx = render_ctx(false, fa.source, fa.path)
    let front = front_pipeline_or_fail(fa, ctx)
    render_and_fail_on_errors(front.comptime_bag, ctx, "comptime fold failed")
    println("no auto-fixes available")
    0
}

/// `fmt <file>` — parse and pretty-print the file (ticket c5w, spec Axis 27.1).
fn cmd_fmt(args: CliResult) -> int {
    let fa = arg_file_source(args)
    let parsed_fmt = parse_or_fail(fa.source, render_ctx(false, fa.source, fa.path))
    println(fmt_stmt_ids(parsed_fmt.store, parsed_fmt.ids, 0))
    0
}

/// `expand <file>` — print the post-macro-expansion source (macro expansion
/// made visible): parse → lower_quotes → desugar → resolve_module_files →
/// expand_components → resolve_names → run_comptime, then format. The output is
/// valid Avra that compiles to the same program.
fn cmd_expand(args: CliResult) -> int {
    let fa = arg_file_source(args)
    let front = front_pipeline_or_fail(fa, render_ctx(false, fa.source, fa.path))
    // fmt is best-effort — an unfoldable @comptime call formats as its source
    // form and its F4007 (if any) surfaces on check/compile/run, so the
    // comptime bag is deliberately dropped.
    println(fmt_stmt_ids(front.store, front.stmts, 0))
    0
}

fn cmd_check(args: CliResult) -> int {
    avra_compile_slot_gate()
    let check_json = result_has_flag(args, "json")
    let fa = arg_file_source(args)
    let ctx = render_ctx(check_json, fa.source, fa.path)
    let check_pkg = load_package_config(modules_dirname(fa.path))
    if check_pkg.found && !check_json {
        eprintln("[pkg] ${check_pkg.name} v${check_pkg.version}")
    }
    let front = front_pipeline_or_fail(fa, ctx)
    render_and_fail_on_errors(front.comptime_bag, ctx, "comptime fold failed")
    let tc_result = pass_typechecked_or_fail(front.db)
    render_and_fail_on_errors(tc_result.bag, ctx, "type check failed")
    if !check_json { println("ok") }
    0
}

fn cmd_compile(args: CliResult) -> int {
    let stop_after = result_get_option(args, "stop_after")
    let debug_null = result_has_flag(args, "debug_null")
    let enable_coverage = result_has_flag(args, "coverage")
    let json_output = result_has_flag(args, "json")
    let emit_metadata = result_has_flag(args, "emit_metadata")
    let per_file_metadata = result_has_flag(args, "per_file_metadata")
    let list_files_path = result_get_option(args, "list_files")
    let module_path = result_get_option(args, "module_path")
    let target_module = result_get_option(args, "target_module")
    let output_override = result_get_option(args, "output")
    let cpath = result_get_arg(args, "file")
    if cpath == "" || cpath.starts_with("-") {
        fail("error: compile requires a file path argument")
    }
    if !file_exists(cpath) {
        fail("error: file not found: ${cpath}")
    }
    let csource = read_file(cpath)

        // Load avra.toml package manifest if present in entry dir.
        let pkg_dir = modules_dirname(cpath)
        let pkg = load_package_config(pkg_dir)
        if pkg.found {
            eprintln("[pkg] ${pkg.name} v${pkg.version}")
        }

        // grgg: file-level compile cache via the existing build-cache.
        // Eligible only for the simple compile path (no flags or env
        // vars that mutate the output shape OR demand side-effect
        // emission). This is the load-bearing fix for the warm-test
        // bottleneck — fixture compiles HIT regardless of bs2's
        // mtime, because the cache keys on compiler binary CONTENT.
        //
        // Env-var gates: AVRA_TIMINGS / AVRA_TIMINGS_JSON expect
        // stderr emission per invocation; AVRA_DEPS_OUT expects an
        // append per producer .o; AVRA_USE_METADATA / AVRA_DIR_MODULE
        // change resolve behaviour. Skip cache when any are set.
        //
        // Source-gate: skip cache when the source has `mod ` decls
        // (sibling-file imports). The fp only hashes the entry file,
        // not transitive sources, so a sibling change wouldn't
        // invalidate the cache. Walking the import graph properly is
        // future work; this gate keeps the cache correct in the
        // common single-file case at the cost of zero benefit for
        // multi-file fixtures (rare; most fixtures are single-file).
        let cache_eligible = !emit_metadata
            && !per_file_metadata
            && list_files_path == ""
            && module_path == ""
            && target_module == ""
            && stop_after == ""
            && !debug_null
            && !enable_coverage
            && avra_process_env_get("AVRA_TIMINGS") == ""
            && avra_process_env_get("AVRA_TIMINGS_JSON") == ""
            && avra_process_env_get("AVRA_DEPS_OUT") == ""
            && avra_process_env_get("AVRA_USE_METADATA") == ""
            && avra_process_env_get("AVRA_DIR_MODULE") == ""
            && !csource.contains("\nmod ")
            && !csource.starts_with("mod ")
            // j568: /tmp/ ad-hoc fixtures are now cacheable. They used to
            // be excluded because compile_capture-style tests assert
            // diagnostic text in bs2 stderr on each invocation, and a
            // silent cache hit dropped it. The cache now captures a
            // compile's diagnostics (unit.diag, via the stderr tee) and
            // replays them on hit, so the observable output is identical
            // whether the compile ran or was served — the exclusion is
            // gone. (The fp keys on the path via unit_name AND the source
            // content, so a replayed diag's locators always match.)
        // pdme.7: --output participates in the cache — the output path is
        // not a compilation input (the fp keys sources + deps + compiler
        // content, never the destination), so a hit just materialises the
        // cached IR wherever the caller asked. This also makes per-worker
        // --output the supported answer to concurrent same-entry compiles:
        // N processes contend on ONE slot but never on each other's
        // output file (the shared <entry>.ll was the last data race).
        let dest_ll = if output_override != "" { output_override } else { "${cpath}.ll" }
        let bs2_path = avra_selfhost_get_arg_cstr(0)
        // pdme.1: key the compile unit on the entry's package full
        // fingerprint too. sources=[cpath] alone missed every edit to a
        // NON-entry file in the closure (parse/mod.av, typeck/mod.av, …),
        // so a plain rebuild served the stale .ll and re-linked the
        // PREVIOUS compiler — the "stale bs2 masks your change" dev-loop
        // bug. Ad-hoc compiles (no manifest at pkg_root) get "" → no
        // dep axis, same file-hash-only behaviour as before.
        let compile_project_root = package_root_for_file(cpath)
        let compile_full_fp = package_full_fingerprint(compile_project_root)
        let compile_inputs = BuildInputs {
            // The PACKAGE root, not the source dir: `pkg_dir` (the entry's
            // directory) parked compile-cache entries at
            // packages/<pkg>/src/build/cache — a cache dir under src/ that
            // the documented clean-cache/cache-gc sweeps over
            // packages/*/build/cache never visited. package_root_for_file
            // splits at /src/ (package layout) and degrades to the file's
            // own directory for flat/ad-hoc entries, so those keep their
            // colocated cache.
            project_root: compile_project_root,
            unit_name: "compile:" + cpath,
            kind: "bin",
            sources: [cpath],
            entry_path: cpath,
            compiler_path: bs2_path,
            target_triple: "host",
            profile_name: "dev",
            opt_level: 0,
            debug: true,
            overflow_checks: true,
            coverage: false,
            lib_pkg_root: avra_process_env_get("AVRA_LIB_PKG_ROOT"),
            dep_fps: if compile_full_fp == "" { [] } else { [compile_full_fp] },
        }
        let mut compile_publish_fp: Fingerprint? = null
        if cache_eligible {
            match decide_build(compile_inputs) {
                .Hit(fp, cached_ll_path) -> {
                    // pdme.7: VALIDATE the read — decide_build's completeness
                    // check and this read are check-then-use over a mutable
                    // path, so a concurrent evictor (wreck repair, prune,
                    // external damage) can empty the slot in between. Serving
                    // the empty read as a "successful" compile propagated
                    // 0-byte IR downstream (caught by --cache-fuzz-parallel);
                    // an empty read is a MISS — recompile honestly.
                    let cached_ll = read_file(cached_ll_path)
                    // The install write is atomic (per-pid tmp + rename in
                    // the runtime) but can still FAIL outright (disk full,
                    // unwritable destination) — success may only be
                    // reported when the artifact provably landed;
                    // otherwise recompile and let the fresh emit render
                    // the honest verdict on the destination.
                    if cached_ll != "" && avra_selfhost_write_file(dest_ll, cached_ll) == 1 {
                        // j568: replay the compile's diagnostics BEFORE the
                        // cache-machinery line, so `bs2 compile … 2>&1`
                        // sees byte-identical output to a fresh compile
                        // (fixture tests assert on this text). A slot
                        // predating j568 has no unit.diag → "" → nothing
                        // replayed, matching the pre-j568 silent hit.
                        let cache = cache_for(compile_project_root)
                        let diag = cache_read_diag(cache, fp)
                        if diag != "" { avra_stderr_write_raw(diag) }
                        eprintln("[compile-cache] hit ${fp_short(fp)} → ${dest_ll}")
                        return 0
                    }
                    eprintln("[compile-cache] stale-read miss ${fp_short(fp)} — slot emptied or uninstallable mid-read; recompiling")
                    compile_publish_fp = fp
                }
                .Miss(fp, _, _) -> {
                    compile_publish_fp = fp
                }
            }
        }

        // j568: when this compile will publish to the cache (a
        // cache-eligible miss), tee its diagnostics so we can store
        // them alongside the .ll and replay on a later hit. The tee
        // brackets ONLY the compile pipeline below — the cache-machinery
        // eprintlns (`[compile-cache] …`, `[timings] …`) sit outside it
        // and are never captured. The tee does not divert: diagnostics
        // still print live on this (miss) run.
        let capture_diag = compile_publish_fp != null
        if capture_diag { avra_stderr_tee_begin() }

        // Per-stage wall-clock timings — emitted to stderr at the
        // end when AVRA_TIMINGS=1 is set in the environment. Cheap
        // enough to leave on always (eight i64 reads), and the
        // first step toward forge-crafting-intepreters-kkgf's deeper
        // perf work (we need numbers before we can rank optimisations).
        let timings_on = avra_process_env_get("AVRA_TIMINGS") != ""
        let t_start = avra_uptime_ms()
        let ctx = render_ctx(json_output, csource, cpath)

        // The slot gate sits AFTER the cache decision on purpose: a cache
        // hit installs an already-built artifact and does no heavy work, so
        // it must never queue behind the box-wide pressure semaphore. Only
        // the real compile pipeline below is the heavy mode the gate bounds.
        avra_compile_slot_gate()
        let parsed_prog = parse_or_fail(csource, ctx)
        let parsed_stmts = parsed_prog.ids
        let t_parse = avra_uptime_ms()
        if stop_after_matches(stop_after, "parse") { return 0 }
        // 2f54: when --module_path is set, wrap the parsed body in a
        // virtual Module BEFORE resolve_module_files. The resolver
        // sees Module-with-body and recurses into it (skipping its
        // file-load path), so internal `mod core` stubs inside still
        // get loaded relative to the source dir AND nest under the
        // outer namespace. Result: top-level fns end up qualified
        // with `<module_path>::<inner_mod>::<name>`.
        //
        // ALSO load sibling .av files in the entry's directory
        // (g2eo.1 dir-as-module) when --module_path is set. Without
        // this a package with sibling files (e.g.
        // @std/crypto/src/{crypto.av, sha256_pure.av}) only exposes
        // the entry file's decls in its metadata; consumers can't
        // resolve symbols defined in siblings. Mirrors what the
        // resolver does when @pkg is loaded as an IMPORT.
        let pre_desugar_stmts = if module_path != "" {
            // Pull sibling `.av` files in the entry's directory into
            // the package body — but only when the entry actually
            // lives inside a real package's `src/` directory (parent
            // dir has an `avra.toml`). Arbitrary fixtures with a
            // `--module_path` (e.g. `/tmp/foo.av` with --module_path=foo)
            // shouldn't sweep in sibling files that aren't part of
            // any package.
            //
            // modules_dirname returns paths with trailing `/`, so to
            // find the parent we strip that first before recursing.
            let cpath_dir = modules_dirname(cpath)
            let cpath_dir_stripped = if cpath_dir.ends_with("/") {
                cpath_dir.substring(0, cpath_dir.length - 1)
            } else {
                cpath_dir
            }
            let parent_dir = modules_dirname(cpath_dir_stripped)
            let is_package_src = avra_selfhost_file_exists("${parent_dir}avra.toml") != 0
            let body_with_siblings = if is_package_src {
                let dir_load = resolve_dir_module_body(cpath_dir, [cpath], parsed_prog.store)
                if dir_load.had_error {
                    parsed_stmts
                } else {
                    concat_stmt_lists(parsed_stmts, dir_load.stmts)
                }
            } else {
                parsed_stmts
            }
            let one: List<StmtId> = [parsed_prog.store.stmts.add_leaf(Stmt.Module(module_path, body_with_siblings))]
            one
        } else {
            parsed_stmts
        }
        // Quote lowering: convert `quote { … }` into AST-construction
        // expressions BEFORE desugar/resolve so identifiers inside quote
        // bodies are captured as string-typed AST literals (not seen by
        // resolve as undefined references).
        //
        // The arena presence scan covers the whole merged body: sibling
        // files absorbed under --module_path are parsed via
        // `parse_program_source_shared` into THIS entry's store (the
        // single-store invariant), so the flat store scan sees their
        // quotes too — the boxed fallback the pre-F0 pipeline needed
        // here is gone.
        fail_on_runtime_quotes(parsed_prog.store, pre_desugar_stmts, ctx)
        let post_quote_stmts = lower_quotes_via_store(pre_desugar_stmts, parsed_prog.store)
        // Desugar pass: rewrite syntactic sugar to simpler AST forms.
        let desugared = desugar_program(post_quote_stmts, parsed_prog.store)
        let t_desugar = avra_uptime_ms()
        // Resolve module files: walk the AST, find `mod` stubs, read
        // and parse the referenced files, attach parsed bodies.
        let entry_dir = modules_dirname(cpath)
        let mod_resolved = resolve_module_files(desugared, entry_dir, empty_loaded_list(), parsed_prog.store)
        let t_resolve_mods = avra_uptime_ms()
        fail_on_module_resolve_error(mod_resolved, ctx)
        if stop_after_matches(stop_after, "resolve") { return 0 }
        // Inject intrinsics AFTER module resolution so the recursive
        // program_declares_enum scan sees stdlib's Result (now inline)
        // and skips synthesizing a duplicate. Cleanup of the earlier
        // dkfa `is_intrinsic_name` hack.
        let with_intrinsics = inject_intrinsics(mod_resolved.stmts, parsed_prog.store)
        // g2eo Phase A: per-module compile filter. Marks every Module
        // wrapper outside `target_module` as @external_unit so codegen
        // emits forward-refs, not bodies. Runs after resolve so the
        // filter has the full module tree to inspect.
        let post_filter_stmts = if target_module != "" {
            filter_to_target_unit(parsed_prog.store, with_intrinsics, target_module)
        } else {
            with_intrinsics
        }
        // Component expansion: runs AFTER module resolution so component
        // definitions in any module are visible to the expander.
        let expanded = expand_components_or_fail(post_filter_stmts, ctx, parsed_prog.store)
        let t_expand = avra_uptime_ms()
        // The coarse pass database (ps3t.8.3 Step A): resolve / comptime /
        // typeck run as chained whole-program queries. Each fetch below is
        // the pass's ONE compute for this compile; the inter-pass gates and
        // their rendering stay exactly where they were.
        let db = pass_db_new(expanded, parsed_prog.store, content_id_for(csource))
        let named = pass_resolved_or_fail(db, ctx)
        let t_names = avra_uptime_ms()
        if stop_after_matches(stop_after, "names") { return 0 }
        // Comptime fold: replace `@comptime` calls with their literal results.
        // Runs after the RESOLVE query so names are bound, before typeck
        // so the typechecker sees the post-fold (literal-typed) AST.
        let post_comptime = pass_folded_or_fail(db)
        // A genuine @comptime fold error (F4007) gates before typeck, mirroring
        // how @expand's F4005 halts — a call that couldn't fold must not slip
        // through as an unfolded runtime call.
        render_and_fail_on_errors(post_comptime.bag, ctx, "comptime fold failed")
        // Type check — gates compilation on errors
        let tc_result = pass_typechecked_or_fail(db)
        let t_typeck = avra_uptime_ms()
        render_and_fail_on_errors(tc_result.bag, ctx, "type check failed")
        if stop_after_matches(stop_after, "check") { return 0 }
        // Monomorphize: replace generic declarations with concrete specializations.
        // Uses the type-annotated AST from typeck so inference reads each node's resolved type.
        let mono = monomorphize(tc_result.stmts, tc_result.trait_impls, parsed_prog.store)
        let t_mono = avra_uptime_ms()
        render_and_fail_on_errors(mono.bag, ctx, "monomorphization failed")
        let output = dest_ll
        // 2f54: when --module_path is set we treat this as a library
        // build — skip the synthetic main() wrapper so multiple
        // unit .o files can link together without _main collisions.
        let library_mode = module_path != ""
        // xtvc: emit metadata.bin BEFORE codegen. The metadata walks
        // `named.stmts` and its `extract_unit_metadata` holds references
        // to the AST's ParamEntry/FieldEntry `ValueType` objects (no
        // deep copy). `compile_program` below runs RC cleanup that frees
        // ValueTypes shared with `named.stmts`, so serializing AFTER
        // codegen reads freed param-vtype memory and crashes
        // `BytesWriter__vtype` with a corrupt tag (927f, size-dependent
        // use-after-free). Serializing here — while the ValueTypes are
        // still live — is correct AND order-independent: the metadata is
        // a pure function of the post-resolve `named.stmts`, needing
        // nothing codegen produces.
        if emit_metadata {
            // unit_name has to be the canonical `::`-form (matching the
            // module_path the resolver wrapped the body in) — not the
            // manifest's `@scope/pkg` slash form. Otherwise the
            // extractor walks current_module="@scope/pkg" then descends
            // into Module("@scope::pkg") and triple-wraps every qn.
            // 9ixv-companion fix.
            let unit_name = if module_path != "" {
                module_path
            } else if pkg.found {
                pkg.name.replace("/", "::")
            } else {
                basename_no_ext(cpath)
            }
            // 2wfp: when compiling a real package (avra.toml present),
            // key the unit-level meta on the whole-package fingerprint
            // — the aggregated meta covers every file's surface, so any
            // source change in the package must invalidate this slot.
            // Ad-hoc single-file compiles key on the entry's file hash
            // (source_slot_fp centralises the fallback so the parent
            // build's mirror sites derive the identical key).
            let pkg_root = package_root_for_file(cpath)
            let cache = cache_for(pkg_root)
            let source_fp = Fingerprint { hex: source_slot_fp(pkg_root, cpath) }
            // pdme.2: the header carries the SLOT KEY (source_fp), not
            // the entry file's hash — the consumer's read-validation
            // gate (metadata_slot_matches) compares the stored fp
            // against the key it looked the slot up under, so producer
            // and consumer must agree on one notion. Old slots stamped
            // with the entry hash simply fail the gate once and get
            // re-emitted — self-healing.
            let fp = bytes_from_hex(source_fp.hex)
            let unit_meta = extract_unit_metadata(unit_name, fp, named.stmts, parsed_prog.store)
            let _ = ensure_source_meta_dir(cache, source_fp)
            let cache_meta_path = entry_source_meta_path(cache, source_fp)
            if metadata_write(cache_meta_path, unit_meta) != 1 {
                fail("metadata write failed for ${cache_meta_path}")
            }
            // g2eo level-1: emit per-file metadata sidecars too.
            // Each contributing .av file gets its own <src>.meta.bin
            // containing only that file's decls. Editing one mod
            // invalidates one sidecar, not the whole package's meta.
            // Entry-point file is skipped (its meta.bin is the
            // whole-unit slice consumers expect).
            if per_file_metadata {
                let files = collect_source_files(parsed_prog.store, named.stmts)
                emit_per_file_metas(files, named.stmts, unit_name, cpath, parsed_prog.store)
            }
        }
        // Ticket t2w: ICE handler — wrap codegen errors in F9999.
        // The per-fn cache hangs off the entry's package root (no flag) —
        // the same root already computed above for the compile cache.
        let cg_cache_root = compile_project_root
        match compile_program(mono.stmts, output, debug_null, enable_coverage, cpath, named.type_reg, library_mode, parsed_prog.store, cg_cache_root) {
            .Ok(_) -> {}
            .Err(e) -> { fail_with_codegen_ice(e, ctx) }
        }
        let t_codegen = avra_uptime_ms()
        // j568: close the diagnostics capture the moment codegen
        // succeeds — everything the pipeline emitted to stderr is now in
        // `compile_diag`. Ending it HERE (before the cache-machinery
        // eprintlns below) keeps those lines out of the stored artifact.
        // A failed compile exits via `fail`/`fail_with_codegen_ice`
        // above without ever publishing, so a dangling open tee on that
        // path is harmless (the process ends).
        let compile_diag = if capture_diag { avra_stderr_tee_end() } else { "" }
        // grgg: publish the freshly-compiled .ll into the per-project
        // cache so the next invocation with byte-identical inputs can
        // skip the entire pipeline. Best-effort — a publish failure
        // doesn't affect this run; only the next one's speed.
        if compile_publish_fp != null {
            let fp = compile_publish_fp!
            let ll_content = read_file(output)
            let staging_id = "compile.${fp_short(fp)}"
            let pr = record_build_result(compile_inputs, fp, ll_content, output, "", "", compile_diag, staging_id)
            if pr.success {
                eprintln("[compile-cache] published ${fp_short(fp)}")
            } else {
                eprintln("[compile-cache] publish failed: ${pr.error}")
            }
        }
        // g2eo: optionally write the resolved file list to a sidecar
        // so build drivers can enumerate compile units by
        // import-graph reachability instead of filesystem find.
        // Decoupled from --emit_metadata so it's usable on its own.
        if list_files_path != "" {
            let files = collect_source_files(parsed_prog.store, named.stmts)
            mut buf = ""
            mut fi = 0
            while fi < files.length {
                if files[fi] != "" {
                    buf = buf + files[fi] + "\n"
                }
                fi = fi + 1
            }
            let _ = avra_selfhost_write_file(list_files_path, buf)
        }
        if timings_on {
            eprintln("[timings] parse=${string(t_parse - t_start)}ms desugar=${string(t_desugar - t_parse)}ms resolve_mods=${string(t_resolve_mods - t_desugar)}ms expand=${string(t_expand - t_resolve_mods)}ms resolve_names=${string(t_names - t_expand)}ms typeck=${string(t_typeck - t_names)}ms monomorphize=${string(t_mono - t_typeck)}ms codegen=${string(t_codegen - t_mono)}ms total=${string(t_codegen - t_start)}ms")
        }
        // kkgf: structured JSON variant of the per-phase timings.
        // Tooling (CI regression trackers, profiling harnesses) reads
        // a single JSON object per compile instead of parsing the
        // human-readable line. AVRA_TIMINGS_JSON gates output to
        // stderr to keep stdout clean for pipe-friendly callers.
        if avra_process_env_get("AVRA_TIMINGS_JSON") != "" {
            eprintln(timings_json(
                t_start, t_parse, t_desugar, t_resolve_mods, t_expand,
                t_names, t_typeck, t_mono, t_codegen, cpath))
        }
        println(output)
        return 0
}

// ── The avra CLI (Components V2) ──
// Declarative: `@expand(expand_cli)` turns this block into a top-level
// `let avra = App { commands: [Subcommand{…}, …] }`; `avra.run()` in main()
// dispatches. Every command's behaviour is its `run()` body below.
cli avra {
    description "Avra bootstrap compiler"
    version "0.1.0"

    command compile {
        description "Compile a Avra file to LLVM IR"
        flag coverage { short "-c", description "Enable coverage instrumentation" }
        flag debug_null { description "Enable null argument checks" }
        flag json { description "Output diagnostics as JSON" }
        flag emit_metadata { description "Also write <file>.meta.bin (xtvc)" }
        flag per_file_metadata { description "Also emit per-file <src>.meta.bin sidecars (g2eo, level-1 incremental)" }
        option stop_after { description "Stop after phase (parse|resolve|names|check)" }
        option module_path { description "Wrap parsed stmts in Module(<name>) — pre-qualifies symbols for cross-unit linking (2f54)" }
        option list_files { description "Write the resolved source-file list (one path per line) to this path — used by per-file build drivers (g2eo)" }
        option target_module { description "Per-module compile (g2eo Phase A): emit only decls whose source path starts with this prefix; mark every other Module wrapper @external_unit" }
        option output { description "Write the emitted LLVM IR to this path instead of <entry>.ll — used by per-module build drivers (g2eo Phase B) so concurrent compiles of the same entry don't clobber each other's outputs" }
        arg file { description "Source file", required true }
        run() { cmd_compile(args) }
    }

    command check {
        description "Type-check a Avra file"
        flag json { description "Output diagnostics as JSON" }
        arg file { description "Source file", required true }
        run() { cmd_check(args) }
    }

    command run {
        description "Compile and run a Avra file"
        arg file { description "Source file", required true }
        arg forward { description "Arguments forwarded to the program's argv (put child flags after a `--` terminator)", variadic true }
        run() { cmd_run(args) }
    }

    command build {
        description "Compile a source file (or manifest [bin]) into a native executable, incrementally via the @std.avrac.build cache. Use `compile` for IR only, `--lib` for a library."
        flag release { description "Use [profile.release] instead of [profile.dev]" }
        flag explain { description "Print why each unit will rebuild (cargo --explain analogue)" }
        flag json { description "Emit build diagnostics as JSON, one event per line (for tooling)", alias "--message-format=json" }
        flag timings { description "Print per-phase timing information" }
        flag lib { description "Build the manifest's [lib] target instead of [bin]" }
        flag emit_metadata { description "Emit a .meta.bin sidecar describing the unit's public surface" }
        flag per_module { description "g2eo Phase B: dispatch one bs2 compile per src/ subdirectory in parallel via pool_run; each subdir produces its own .ll + .meta.bin under build/per_mod/. Experimental, opt-in." }
        option output { short "-o", description "Write the native executable here (default: the source basename minus .av, in the cwd). Ignored for --lib / --per_module." }
        arg file { description "Entry source file (overrides manifest [bin].path)" }
        run() {
            let report = run_build_command(BuildArgs {
                release: release,
                explain: explain,
                json: json,
                timings: timings,
                lib: lib,
                emit_metadata: emit_metadata,
                per_module: per_module,
                entry: file,
                output: output,
            })
            // A `bin` build ends in a runnable executable; `--lib` and
            // `--per_module` produce no single binary (empty binary_path).
            if report.binary_path != "" && !json {
                if report.bin_cached {
                    println("Executable: ${report.binary_path} (up to date)")
                } else {
                    println("Executable: ${report.binary_path}")
                }
            }
            0
        }
    }

    command clean {
        description "Remove build/ artifacts (preserves the cache by default)"
        flag all { description "Remove build/cache/ as well" }
        run() {
            run_clean_command(all)
            0
        }
    }

    command cache {
        description "Manage the build cache: prune | info | clear-failed"
        flag dry_run { description "Print what would change but do not modify the filesystem" }
        option max_age_days { description "prune: evict entries with mtime older than N days", default "30" }
        option max_size_mb { description "prune: after the age sweep, evict oldest slots until the cache fits N megabytes (0 = off)", default "0" }
        arg subcommand { description "prune | info | clear-failed", required true }
        run() {
            run_cache_command(subcommand, dry_run, max_age_days, max_size_mb)
            0
        }
    }

    command test {
        description "Run tests"
        option filter { short "-f", description "Filter tests by name" }
        flag coverage { short "-c", description "Enable coverage instrumentation" }
        flag per_file { description "Run each test file in its own subprocess (the default)" }
        flag bundled { description "Opt out of per-file: run all tests in one process (legacy; coverage uses it)" }
        flag list { description "List discovered tests and exit — no compile, no run" }
        option lcov { description "Enable coverage and write an LCOV report to this path" }
        arg files { description "Test files or paths to scope the run (optional, repeatable)", variadic true }
        run() {
            // per_file is the DEFAULT (per-file isolation avoids the bundled
            // path's ~10GB working set / OOM); `--bundled` opts out, `--per_file`
            // reaffirms. `|| !bundled` keeps the safe default unless bundled is
            // explicit. `--lcov <path>` implies coverage.
            run_test_command(TestArgs {
                filter: filter,
                coverage: coverage || lcov != "",
                lcov_path: lcov,
                per_file: per_file || !bundled,
                list_only: list,
                path_filters: files,
            })
            0
        }
    }

    command _test_shard {
        description "INTERNAL: compile + run one test-shard binary (forked per batch by `avra test`)"
        hidden true
        option filter { short "-f", description "Test-name filter (appended by the orchestrator after the shard paths)" }
        flag coverage { short "-c", description "Enable coverage instrumentation" }
        option lcov { description "Enable coverage and write an LCOV report to this path" }
        arg paths { description "Test files compiled into this shard", required true, variadic true }
        run() {
            // per_file / list_only / path_filters are orchestrator-level
            // concerns (`avra test` consumed them before forking this shard)
            // with no meaning inside one shard — zeroed, not parsed.
            run_test_shard_command(paths, TestArgs {
                filter: filter,
                coverage: coverage || lcov != "",
                lcov_path: lcov,
                per_file: false,
                list_only: false,
                path_filters: [],
            })
            0
        }
    }

    command _resource_pool {
        description "INTERNAL: run a marker-aware resource-admitted build queue"
        hidden true
        option commands { description "Internal newline-separated command queue" }
        option slugs { description "Internal newline-separated marker slugs" }
        option marker_dir { description "Internal marker directory" }
        option project_dir { description "Internal project root for learned observations" }
        option compiler { description "Internal compiler path for profile identity" }
        option work_kind { description "Internal resource work profile" }
        option plan_shape { description "Internal resource plan shape" }
        run() { cmd_resource_pool(args) }
    }

    command expr {
        description "Parse and display an expression"
        arg file { description "Source file", required true }
        run() { cmd_expr(args) }
    }

    command metadata_show {
        description "Decode a .meta.bin file and print its public surface (xtvc)"
        arg file { description "Path to a .meta.bin", required true }
        run() { cmd_metadata_show(args) }
    }

    command program {
        description "Parse and display a program"
        flag recover { description "Render the RECOVERY tree for invalid input instead of stopping at the diagnostics (t-47hc.5)" }
        arg file { description "Source file", required true }
        run() { cmd_program(args) }
    }

    command eval {
        description "Evaluate a Avra expression"
        arg file { description "Source file", required true }
        run() { cmd_eval(args) }
    }

    command gate_scan {
        description "t-o8pm: group every diagnostic of an F-code across shard logs by conflict shape"
        arg code { description "F-code to scan for, e.g. F1000", required true }
        arg logs { description "Directory of shard logs (default: newest build/test_shards/<pid>)", required false }
        run() { cmd_gate_scan(args) }
    }

    command diag_delta {
        description "t-zk6j: the diagnostics a NEW compile log raises that an OLD one does not"
        arg new_log { description "Compile log from the NEW/candidate compiler", required true }
        arg old_log { description "Compile log from the OLD/oracle compiler (default: none — it compiled cleanly)", required false }
        run() { cmd_diag_delta(args) }
    }

    command resources {
        description "Print the current portable CPU, memory, pressure, and scope snapshot"
        run() { cmd_resources() }
    }

    command fix {
        description "Apply auto-fixes to a Avra file"
        arg file { description "Source file", required true }
        run() { cmd_fix(args) }
    }

    command fmt {
        description "Format a Avra source file"
        arg file { description "Source file", required true }
        run() { cmd_fmt(args) }
    }

    command lsp {
        description "Start language server"
        run() {
            run_lsp_server(avra_process_env_get("PWD"))
            0
        }
    }

    command lang {
        description "Write the generated Avra language definition to target/lang.av"
        flag print { description "Print the generated lang.av to stdout instead of writing target/lang.av" }
        run() {
            run_lang_command(print)
            0
        }
    }

    command features {
        description "List registered features"
        run() {
            eprintln("`avra features` is not implemented yet")
            1
        }
    }

    command docs {
        description "Project documentation -- look up your project's functions, types, and enums"
        flag symbols { description "Show symbol/type reference" }
        flag short { description "Show just the one-liner for a symbol" }
        flag llm { description "Compact LLM-friendly project documentation" }
        flag validate { description "Validate documentation coverage for the project" }
        flag callers { description "Show the callers of a symbol (reverse call graph)", alias "--used-by" }
        flag no_cache { description "Bypass the cached symbol index and re-extract" }
        flag doctest { description "Run doc examples (```avra fences) as tests" }
        flag gen { description "Generate documentation scaffolding for a symbol" }
        flag print { description "Print generated output to stdout (with --gen)" }
        option scope { description "Documentation corpus scope (default: project)", default "project" }
        option format { description "Output format (default: human)", default "human" }
        option module { description "Restrict the lookup to a specific module path" }
        option search { description "Search project docs (substring match)" }
        arg query { description "Symbol to look up (function, type, enum name)" }
        run() {
            run_docs_command(DocsArgs {
                want_symbols: symbols,
                want_short: short,
                want_llm: llm,
                want_validate: validate,
                want_callers: callers,
                want_no_cache: no_cache,
                want_doctest: doctest,
                want_gen: gen,
                want_print: print,
                search_term: search,
                module_path: module,
                scope: scope,
                format: format,
                query: query,
            })
            0
        }
    }
    command expand {
        description "Print the post-macro-expansion source (P7 visible magic)"
        arg file { description "Source file", required true }
        run() { cmd_expand(args) }
    }
}

fn main() {
    // EVERY command — user-facing and compiler-internal alike — dispatches
    // declaratively (the vez6.12 single-`avra.run()` collapse): `avra.run()`
    // reads the real argv against the matched command's schema and calls that
    // command's `run(args)` body, which reads its flags/args off the parsed
    // `CliResult`. The `App` parser models every argv shape the commands use —
    // space-separated `--key value` options, word aliases (`--used-by` for
    // `--callers`, live in `docs`), option-form flag aliases
    // (`--message-format=json` for `--json`, live in `build`), and variadic
    // positionals (the shard paths of the internal `_test_shard`) — all landed
    // in phx5 A1/A2/B. The exit code is the matched command's return.
    exit(avra.run())
}
