fn print_usage() {
    eprintln("forge-bootstrap v0.1.0")
    eprintln("Usage: bootstrapc <expr|program|eval|check|compile|run|fix|fmt|lsp|test|docs> <file.av>")
    eprintln("       bootstrapc compile --stop-after=<parse|resolve|names|check> [--json] <file.av>")
    eprintln("       bootstrapc fix <file.av>     Apply high-confidence auto-fixes")
    eprintln("       bootstrapc fmt <file.av>     Format a Avra source file")
    eprintln("       bootstrapc lsp               Start language server")
    eprintln("       bootstrapc test <file.av>    Run spec tests in a file")
    eprintln("       bootstrapc docs [name]       Project documentation from /// comments")
    eprintln("       bootstrapc docs --symbols    List every project symbol with location")
    eprintln("       bootstrapc docs --search Q   Search project docs by name or doc body")
    eprintln("       bootstrapc docs --validate   Report documentation coverage")
    eprintln("       bootstrapc docs --llm        Markdown-style dump for LLM context")
}

fn fail(message: string) {
    eprintln(message)
    exit(1)
}

/// Render a diagnostic bag in either human or JSON form, picked
/// by `json_output`. Both `compile` and `check` switch on the
/// `--json` flag at every pipeline stage; this helper centralises
/// the dispatch so each stage stays a one-liner.
fn render_bag_either(json_output: bool, source: string, path: string, bag: DiagnosticBag) {
    if json_output { render_bag_json(path, bag) }
    else { render_bag(source, path, bag) }
}

// Module file resolution and name resolution live in features/modules/.


// ── CLI component definitions ──
// Match the Rust std-cli component pattern exactly.
// Template components: init hooks use self.__parent to thread builder calls.

component cli(name: string) {
    config {
        description: string = ""
        version: string = "0.1.0"
    }
    fn init() {
        self.__parent = cli_new(self.name, self.config.description, self.config.version)
    }
}

component command(name: string) {
    config { description: string = "" }
    fn init() {
        self.__parent = cli_add_command(self.__parent, self.name, self.config.description)
    }
}

component flag(name: string) {
    config { short: string = "", description: string = "" }
    fn init() {
        self.__parent = cli_command_add_flag(self.__parent, self.__parent_name, "--${self.name}", self.config.short, self.config.description)
    }
}

component option(name: string) {
    config { short: string = "", description: string = "", default_val: string = "" }
    fn init() {
        self.__parent = cli_command_add_option(self.__parent, self.__parent_name, "--${self.name}", self.config.short, self.config.description, self.config.default_val)
    }
}

component arg(name: string) {
    config { description: string = "", required: bool = false }
    fn init() {
        self.__parent = cli_command_add_arg(self.__parent, self.__parent_name, self.name, self.config.description, self.config.required)
    }
}

// Parsed view of `avra docs ...` argv. Keeps the main() handler from
// drowning in 100+ lines of flag-by-flag if statements.
type DocsArgs = {
    want_symbols: bool,
    want_short: bool,
    want_llm: bool,
    want_validate: bool,
    want_callers: bool,
    want_no_cache: bool,
    want_doctest: bool,
    want_gen: bool,
    want_print: bool,
    search_term: string,
    module_path: string,
    scope: string,
    format: string,
    query: string,
}

fn docs_args_default() -> DocsArgs {
    DocsArgs {
        want_symbols: false, want_short: false, want_llm: false,
        want_validate: false, want_callers: false, want_no_cache: false,
        want_doctest: false, want_gen: false, want_print: false,
        search_term: "", module_path: "", scope: "project",
        format: "human", query: "",
    }
}

// Apply a pure flag (toggle one bool, no value). matched=false means
// arg wasn't a recognised pure flag and the caller should keep parsing.
type FlagApply = { args: DocsArgs, matched: bool }

fn pure_flag_apply(arg: string, a: DocsArgs) -> FlagApply {
    match arg {
        "--symbols"  -> matched_flag(a with { want_symbols: true })
        "--short"    -> matched_flag(a with { want_short: true })
        "--llm"      -> matched_flag(a with { want_llm: true })
        "--validate" -> matched_flag(a with { want_validate: true })
        "--callers"  -> matched_flag(a with { want_callers: true })
        "--used-by"  -> matched_flag(a with { want_callers: true })
        "--no-cache" -> matched_flag(a with { want_no_cache: true })
        "--doctest"  -> matched_flag(a with { want_doctest: true })
        "--print"    -> matched_flag(a with { want_print: true })
        _            -> FlagApply { args: a, matched: false }
    }
}

fn matched_flag(a: DocsArgs) -> FlagApply { FlagApply { args: a, matched: true } }

// Read the value attached to a `--key` flag at argv[idx]: returns the
// value plus the number of argv slots consumed (1 for `--key=value`,
// 2 for `--key value`). The prefix length is computed from `key`
// rather than passed in — every caller would otherwise risk a
// hand-counted off-by-one.
type KvRead = { value: string, consumed: int }

fn read_kv_value(idx: int, key: string) -> KvRead {
    let arg = avra_selfhost_get_arg_cstr(idx)
    if arg.starts_with("${key}=") {
        return KvRead { value: arg.substring(key.length + 1, arg.length), consumed: 1 }
    }
    if idx + 1 < avra_selfhost_argc() {
        return KvRead { value: avra_selfhost_get_arg_cstr(idx + 1), consumed: 2 }
    }
    KvRead { value: "", consumed: 1 }
}

fn matches_kv_flag(arg: string, key: string) -> bool {
    arg == key || arg.starts_with("${key}=")
}

fn parse_docs_args() -> DocsArgs {
    mut a = docs_args_default()
    mut k = 2
    while k < avra_selfhost_argc() {
        let arg = avra_selfhost_get_arg_cstr(k)
        let pure = pure_flag_apply(arg, a)
        if pure.matched {
            a = pure.args
            k = k + 1
            continue
        }
        // --gen with optional positional symbol name.
        if arg == "--gen" {
            a = a with { want_gen: true }
            if k + 1 < avra_selfhost_argc() {
                let next = avra_selfhost_get_arg_cstr(k + 1)
                if !next.starts_with("-") {
                    a = a with { query: next }
                    k = k + 2
                    continue
                }
            }
            k = k + 1
            continue
        }
        // --key value / --key=value pairs.
        if matches_kv_flag(arg, "--scope") {
            let r = read_kv_value(k, "--scope")
            a = a with { scope: r.value }
            k = k + r.consumed
            continue
        }
        if matches_kv_flag(arg, "--format") {
            let r = read_kv_value(k, "--format")
            a = a with { format: r.value }
            k = k + r.consumed
            continue
        }
        if matches_kv_flag(arg, "--module") {
            let r = read_kv_value(k, "--module")
            a = a with { module_path: r.value }
            k = k + r.consumed
            continue
        }
        if matches_kv_flag(arg, "--search") {
            let r = read_kv_value(k, "--search")
            a = a with { search_term: r.value }
            k = k + r.consumed
            continue
        }
        // Positional symbol query — first non-flag token.
        if !arg.starts_with("-") && a.query == "" {
            a = a with { query: arg }
        }
        k = k + 1
    }
    a
}

// "No symbol 'foo' found" + optional did-you-mean hint. Centralised
// because the docs handler hits this branch from --gen, --callers,
// and the bare-query miss path with identical formatting.
fn print_no_symbol(query: string, list: SymList, hint: string) {
    let suggestion = suggest_similar(query, list)
    eprintln("")
    eprintln("  No symbol '${query}' found in project.")
    if suggestion != "" {
        eprintln("  Did you mean: ${suggestion}?")
    }
    if hint != "" {
        eprintln(hint)
    }
    eprintln("")
}

// `avra lang` — render the language reference (DiagCode + keyword
// table) from compiler internals. Writes `target/lang.av` by
// default; `--print` pipes the rendered source to stdout so CI can
// diff against the checked-in copy.
fn run_lang_command() {
    if has_argv_flag("--print") {
        println(render_lang_av())
        return
    }
    avra_shell_exec("mkdir -p target")
    let path = "target/lang.av"
    if write_lang_av(path) == 0 {
        eprintln("error: failed to write ${path}")
        exit(1)
    }
    println("wrote ${path}")
}

/// True iff `flag` appears anywhere in argv (skipping the program
/// name + the subcommand name at slots 0 and 1). Used by the
/// argument-light subcommands that only care about presence/absence
/// of a single switch.
fn has_argv_flag(flag: string) -> bool {
    mut k = 2
    while k < avra_selfhost_argc() {
        if avra_selfhost_get_arg_cstr(k) == flag { return true }
        k = k + 1
    }
    false
}

// Parsed view of `avra test ...` argv. -f/--filter narrows tests
// by file-name substring; -c/--coverage enables instrumentation;
// --lcov path turns on coverage AND writes an LCOV report there.
type TestArgs = { filter: string, coverage: bool, lcov_path: string }

fn parse_test_args() -> TestArgs {
    mut filter_arg = ""
    mut coverage_flag = false
    mut lcov_path = ""
    mut i = 2
    while i < avra_selfhost_argc() {
        let arg = avra_selfhost_get_arg_cstr(i)
        if arg == "-f" || arg == "--filter" {
            if i + 1 < avra_selfhost_argc() {
                filter_arg = avra_selfhost_get_arg_cstr(i + 1)
            }
            i = i + 2
            continue
        }
        if arg == "-c" || arg == "--coverage" {
            coverage_flag = true
            i = i + 1
            continue
        }
        if arg == "--lcov" {
            coverage_flag = true
            if i + 1 < avra_selfhost_argc() {
                lcov_path = avra_selfhost_get_arg_cstr(i + 1)
            }
            i = i + 2
            continue
        }
        i = i + 1
    }
    TestArgs { filter: filter_arg, coverage: coverage_flag, lcov_path }
}

extern fn avra_uptime_ms() -> int

/// Write a self-contained HTML timings report to `<root>/build/timings/<unit>-<fp>.html`.
/// Each phase row shows its start, end, and duration in ms; the page
/// header summarises total wall time. cargo --timings is the model;
/// we keep the body minimal (no external CSS / JS) so the file
/// renders in any browser without a network round trip.
fn write_timings_html(project_root: string, unit_name: string, fp_short_str: string,
                      decide_ms: int, compile_ms: int, publish_ms: int, total_ms: int,
                      outcome_label: string) -> string {
    let dir = "${project_root}/build/timings"
    avra_shell_exec("mkdir -p '${dir}'")
    let path = "${dir}/${unit_name}-${fp_short_str}.html"
    let scale_max = if total_ms == 0 { 1 } else { total_ms }
    let body = "<!doctype html>\n"
        + "<html><head><meta charset=\"utf-8\">"
        + "<title>bs2 build timings — ${unit_name} ${fp_short_str}</title>"
        + "<style>body{font-family:system-ui,sans-serif;margin:2em;color:#111}"
        + "h1{margin:0 0 .5em 0}.meta{color:#666;margin-bottom:1em}"
        + "table{border-collapse:collapse}td,th{padding:.4em 1em;text-align:left}"
        + "th{border-bottom:2px solid #333}.bar{background:#4a90e2;height:14px;display:inline-block;vertical-align:middle}"
        + ".total{font-weight:bold;border-top:1px solid #999}"
        + "</style></head><body>"
        + "<h1>bs2 build — ${unit_name}</h1>"
        + "<div class=\"meta\">fingerprint: ${fp_short_str} · outcome: ${outcome_label} · total: ${string(total_ms)}ms</div>"
        + "<table><tr><th>phase</th><th>duration</th><th></th></tr>"
        + render_timing_row("decide", decide_ms, scale_max)
        + render_timing_row("compile", compile_ms, scale_max)
        + render_timing_row("publish", publish_ms, scale_max)
        + "<tr class=\"total\"><td>total</td><td>${string(total_ms)}ms</td><td></td></tr>"
        + "</table></body></html>\n"
    avra_selfhost_write_file(path, body)
    path
}

fn render_timing_row(label: string, ms: int, scale_max: int) -> string {
    let width = if scale_max == 0 { 0 } else { (ms * 400) / scale_max }
    "<tr><td>${label}</td><td>${string(ms)}ms</td><td><span class=\"bar\" style=\"width:${string(width)}px\"></span></td></tr>"
}

/// Render a single build event as a one-line JSON object for IDE /
/// tooling consumption (`bs2 build --json` / `--message-format=json`).
/// Each call yields a complete document on its own line so consumers
/// can parse the stream as JSONL. Strings are escaped via @std/json
/// so embedded quotes / backslashes / control bytes survive intact.
///
/// Event kinds:
///   "hit"            cache hit; `path` is the .ll, `reason` is empty
///   "miss"           cache miss; `path` is the source, `reason` is the
///                    --explain attribution
///   "built"          successful publish after a Miss
///   "publish_failed" cache publish failed AFTER successful build
fn build_event_json(kind: string, unit: string, fp: string, path: string, reason: string) -> string {
    mut p = json_pairs()
    p = json_pair_add(p, "event", json_str(kind))
    p = json_pair_add(p, "unit", json_str(unit))
    p = json_pair_add(p, "fp", json_str(fp))
    p = json_pair_add(p, "path", json_str(path))
    p = json_pair_add(p, "reason", json_str(reason))
    json_object(p)
}

/// Render a UnitList as "a → b → c". Used by --explain to summarise
/// the project's dep graph in a single line. Topological order means
/// leaves come first; we display in that order so the chain reads
/// "what gets built first → ... → root".
fn render_unit_chain(units: UnitList) -> string {
    mut out = ""
    mut cur = units
    mut first = true
    mut keep_going = true
    while keep_going {
        match cur {
            .End -> keep_going = false,
            .Node(u, rest) -> {
                if !first { out = out + " → " }
                out = out + u.name
                first = false
                cur = rest
            }
        }
    }
    out
}

/// Parsed view of `avra build ...` argv.
///   --release             select [profile.release] over [profile.dev]
///   --explain             cargo-style rebuild attribution
///   --json                emit one JSON event per line (for IDE tooling)
///                         in lieu of human-readable output
///   --timings             write build/timings/<unit>-<fp>.html with
///                         per-phase wall times (cargo --timings analogue)
///   entry (positional)    override the manifest [bin].path
// `--lib` (the BuildArgs.lib field below) selects the manifest's
// [lib] target instead of [bin]. Foundational for
// forge-crafting-intepreters-2f54 (split @std.avrac as a separately-
// cached unit): a library is just a build target whose entry is an
// avrac.av / lib.av root; the cache key and outputs work the same
// as for a binary.
type BuildArgs = {
    release: bool,
    explain: bool,
    json: bool,
    timings: bool,
    lib: bool,
    entry: string,
}

fn parse_build_args() -> BuildArgs {
    mut release = false
    mut explain = false
    mut json = false
    mut timings = false
    mut lib = false
    mut entry = ""
    mut i = 2
    while i < avra_selfhost_argc() {
        let arg = avra_selfhost_get_arg_cstr(i)
        if arg == "--release" {
            release = true
            i = i + 1
            continue
        }
        if arg == "--explain" {
            explain = true
            i = i + 1
            continue
        }
        if arg == "--json" || arg == "--message-format=json" {
            json = true
            i = i + 1
            continue
        }
        if arg == "--timings" {
            timings = true
            i = i + 1
            continue
        }
        if arg == "--lib" {
            lib = true
            i = i + 1
            continue
        }
        if !arg.starts_with("-") && entry == "" {
            entry = arg
        }
        i = i + 1
    }
    BuildArgs {
        release: release,
        explain: explain,
        json: json,
        timings: timings,
        lib: lib,
        entry: entry,
    }
}

// `avra build` — Phase 1 incremental wrapper around `avra compile`.
// Reads the project's avra.toml, computes the per-unit fingerprint,
// consults the @std.avrac.build cache, and:
//   * on a Hit, copies the cached IR to where compile would write it
//     and skips the codegen pipeline entirely
//   * on a Miss, exec's the existing `bs2 compile` flow (subprocess so
//     we get proven codegen behaviour for free), then publishes the
//     produced .ll into the cache for the next invocation
//
// Phase 1 treats the entry source as a single unit. Phase 2 (dep
// graph extractor, see ticket eh00) carves it into per-package /
// per-module units; the driver's surface (decide / record) does
// not need to change for that step.
fn run_build_command() {
    let project_dir = avra_process_env_get("PWD")
    let args = parse_build_args()

    let manifest = load_manifest("${project_dir}/")
    // --lib picks [lib] over [bin]. Without --lib, [bin] is the
    // default; if [bin] is absent but [lib] is present, fall through
    // to the lib target so `bs2 build` works in library-only packages
    // (foundational for forge-crafting-intepreters-2f54).
    let prefer_lib = args.lib || (!manifest.bin.present && manifest.lib.present)
    let manifest_entry = if prefer_lib && manifest.lib.present {
        manifest.lib.path
    } else if manifest.bin.present {
        manifest.bin.path
    } else {
        ""
    }
    let entry_path = if args.entry != "" { args.entry } else { manifest_entry }
    if entry_path == "" {
        let needed = if args.lib { "[lib].path" } else { "[bin].path" }
        fail("error: bs2 build requires either a file argument or ${needed} in avra.toml")
    }
    if !file_exists(entry_path) {
        fail("error: file not found: ${entry_path}")
    }

    let profile = if args.release { manifest.profile_release } else { manifest.profile_dev }
    let unit_name = if manifest.found && prefer_lib && manifest.lib.present {
        manifest.lib.name
    } else if manifest.found && manifest.bin.present {
        manifest.bin.name
    } else {
        "main"
    }

    // bs2's own binary is the proxy for "the compiler". The bs3
    // verify path uses build/bs2; production via `make build`
    // produces the same binary. Downstream consumers will pass an
    // explicit path once the bootstrap is no longer the only consumer.
    let compiler_path = "${project_dir}/build/bs2"

    let inputs = BuildInputs {
        project_root: project_dir,
        unit_name: unit_name,
        entry_path: entry_path,
        compiler_path: compiler_path,
        target_triple: "host",
        profile_name: profile.name,
        opt_level: profile.opt_level,
        debug: profile.debug,
        overflow_checks: profile.overflow_checks,
        coverage: profile.coverage,
    }

    // When --explain is on, also surface the manifest's [dependencies]
    // graph so the user sees what units would (under Phase 3) participate
    // in the build. Today the build is single-unit, so the graph is
    // informational; once 2f54+k21v ship, each dep_unit gets its own
    // cache entry and per-unit Hit/Miss rendering replaces this summary.
    if args.explain && manifest.found && !args.json {
        let g = build_graph("${project_dir}/")
        if !g.had_error {
            let n = unit_list_length(g.units)
            if n > 1 {
                println("graph: ${string(n)} units (${render_unit_chain(g.units)})")
            }
        }
    }

    let t_start = avra_uptime_ms()
    let outcome = decide_build(inputs)
    let t_after_decide = avra_uptime_ms()
    match outcome {
        .Hit(fp, cached_ll) -> {
            let dst = "${entry_path}.ll"
            avra_shell_exec("cp '${cached_ll}' '${dst}'")
            if args.timings {
                let total = avra_uptime_ms() - t_start
                let _ = write_timings_html(project_dir, unit_name, fp_short(fp),
                    t_after_decide - t_start, 0, 0, total, "hit")
            }
            if args.json {
                println(build_event_json("hit", unit_name, fp_short(fp), dst, ""))
            } else if args.explain {
                println("cached ${fp_short(fp)} — ${entry_path}")
            } else {
                println("Cached ${fp_short(fp)}: ${dst}")
            }
            return
        }
        .Miss(fp, _, reason) -> {
            if args.json {
                println(build_event_json("miss", unit_name, fp_short(fp), entry_path, reason))
            } else if args.explain {
                println("rebuild ${fp_short(fp)} — ${reason}")
            }
            // Re-exec the existing compile pipeline as a subprocess.
            // Use `bs2 compile` so codegen behaviour is identical
            // to a non-build flow; no surprises from a parallel impl.
            // Propagate profile flags that map to `bs2 compile` flags.
            // opt_level affects the downstream llc invocation (link
            // step), not bs2's IR emission, so it stays in the
            // fingerprint but isn't passed here.
            mut compile_cmd = "${compiler_path} compile"
            if profile.coverage {
                compile_cmd = compile_cmd + " --coverage"
            }
            compile_cmd = compile_cmd + " '${entry_path}'"
            let t_before_compile = avra_uptime_ms()
            let _ = avra_shell_exec(compile_cmd)
            let t_after_compile = avra_uptime_ms()
            let ll_path = "${entry_path}.ll"
            if !file_exists(ll_path) {
                fail("error: compile produced no IR (looked for ${ll_path})")
            }
            let ll_content = read_file(ll_path)
            let metadata = ""
            let staging_id = "${unit_name}.${fp_short(fp)}"
            let pr = record_build_result(inputs, fp, ll_content, ll_path, metadata, staging_id)
            let t_after_publish = avra_uptime_ms()
            if args.timings {
                let _ = write_timings_html(project_dir, unit_name, fp_short(fp),
                    t_after_decide - t_start,
                    t_after_compile - t_before_compile,
                    t_after_publish - t_after_compile,
                    t_after_publish - t_start,
                    if pr.success { "miss-built" } else { "miss-publish-failed" })
            }
            if pr.success {
                if args.json {
                    println(build_event_json("built", unit_name, fp_short(fp), ll_path, ""))
                } else {
                    println("Built ${fp_short(fp)}: ${ll_path}")
                }
            } else {
                if args.json {
                    println(build_event_json("publish_failed", unit_name, fp_short(fp), ll_path, pr.error))
                } else {
                    eprintln("warning: cache publish failed: ${pr.error}")
                    println("Built (uncached): ${ll_path}")
                }
            }
            return
        }
    }
}

// `avra clean` — remove the top-level build/ directory while
// preserving build/cache/ by default. With --all, also wipes the
// cache (use to start truly fresh, e.g. after a runtime change).
//
// Cache preservation matters: `bs2 build` invalidates entries on
// any input change, so a stale cache cannot produce wrong output —
// only stale-but-now-irrelevant entries waste disk. Wiping the
// cache forces every subsequent build to repay full compile cost
// even for inputs that haven't changed, which is rarely what the
// user wants.
fn run_clean_command() {
    let project_dir = avra_process_env_get("PWD")
    mut all_flag = false
    mut i = 2
    while i < avra_selfhost_argc() {
        let arg = avra_selfhost_get_arg_cstr(i)
        if arg == "--all" {
            all_flag = true
        }
        i = i + 1
    }
    let build_dir = "${project_dir}/build"
    if !avra_selfhost_file_exists(build_dir) {
        println("clean: ${build_dir} does not exist (nothing to do)")
        return
    }
    if all_flag {
        avra_shell_exec("rm -rf '${build_dir}'")
        println("clean --all: removed ${build_dir} (cache included)")
        return
    }
    // Default: rm everything under build/ except cache/. We re-create
    // build/ then move cache back, which is atomic enough for dev
    // tooling and avoids walking the artifact tree by hand.
    let cache_dir = "${build_dir}/cache"
    let cache_stash = "${project_dir}/.avra_cache_stash"
    if avra_selfhost_file_exists(cache_dir) {
        avra_shell_exec("rm -rf '${cache_stash}'")
        avra_shell_exec("mv '${cache_dir}' '${cache_stash}'")
    }
    avra_shell_exec("rm -rf '${build_dir}'")
    avra_shell_exec("mkdir -p '${build_dir}'")
    if avra_selfhost_file_exists(cache_stash) {
        avra_shell_exec("mv '${cache_stash}' '${cache_dir}'")
        println("clean: removed ${build_dir}/* (cache preserved)")
    } else {
        println("clean: removed ${build_dir}/* (no cache to preserve)")
    }
}

// `avra cache <subcommand>` — manage the build cache.
//   prune  : evict stale entries (default: max-age 30 days).
//   info   : print cache size + entry count.
fn run_cache_command() {
    let project_dir = avra_process_env_get("PWD")
    let cache_dir = "${project_dir}/build/cache"

    mut subcommand = ""
    mut dry_run = false
    // Keep as a string so we can embed directly into the shell `find
    // -mtime +N` without an int<->string round trip. Defaults to 30 days.
    mut max_age_days_str = "30"
    mut i = 2
    while i < avra_selfhost_argc() {
        let arg = avra_selfhost_get_arg_cstr(i)
        if arg == "--dry-run" {
            dry_run = true
        } else if arg == "--max-age-days" {
            if i + 1 < avra_selfhost_argc() {
                max_age_days_str = avra_selfhost_get_arg_cstr(i + 1)
                i = i + 1
            }
        } else if !arg.starts_with("-") && subcommand == "" {
            subcommand = arg
        }
        i = i + 1
    }
    if subcommand == "" {
        fail("usage: bs2 cache <prune|info> [--dry-run] [--max-age-days N]")
    }
    if !avra_selfhost_file_exists(cache_dir) {
        println("cache: ${cache_dir} does not exist (no cache yet)")
        return
    }

    if subcommand == "info" {
        let count = avra_shell_exec("find '${cache_dir}' -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '")
        let size = avra_shell_exec("du -sh '${cache_dir}' 2>/dev/null | cut -f1")
        println("cache info:")
        println("  path:    ${cache_dir}")
        println("  entries: ${count}")
        println("  size:    ${size}")
        return
    }

    if subcommand == "prune" {
        // find -mtime +N matches files modified more than N*24h ago.
        // We list candidate dirs first so --dry-run is cheap and side-
        // effect-free; the actual rm is a separate exec.
        let candidates = avra_shell_exec("find '${cache_dir}' -mindepth 1 -maxdepth 1 -type d -mtime +${max_age_days_str} 2>/dev/null")
        if candidates == "" {
            println("cache prune: no entries older than ${max_age_days_str} days")
            return
        }
        let count_str = avra_shell_exec("printf '%s\\n' '${candidates}' | grep -c .")
        if dry_run {
            println("cache prune --dry-run: would evict ${count_str} entries:")
            println(candidates)
            return
        }
        // Actually evict. xargs -I keeps each path argument separate
        // so spaces (none expected, but defensive) don't break globbing.
        let _ = avra_shell_exec("find '${cache_dir}' -mindepth 1 -maxdepth 1 -type d -mtime +${max_age_days_str} -exec rm -rf {} +")
        println("cache prune: evicted ${count_str} entries older than ${max_age_days_str} days")
        return
    }

    fail("unknown cache subcommand `${subcommand}` (expected: prune | info)")
}

// `avra test` — discover every `*_test.av` under PWD, parse each as
// a Module, hoist shared @std packages to the program root, link
// the assembled program, and run the spec/given/then suite.
// Coverage path lowers `llvm.instrprof.increment` intrinsics, links
// with clang_rt.profile, then feeds profdata to the Avra-side
// renderer (`coverage::render_coverage`).
fn run_test_command() {
    let project_dir = avra_process_env_get("PWD")
    let args = parse_test_args()

    // Step 1: Discover _test.av files
    // TODO(bead wcrm): replace with proper FS walk
    // Anchor the build-artifacts exclusion to the project root so a
    // legitimate src tree containing a `build/` subdirectory (e.g.
    // packages/std-avrac/src/build/, the build-driver module) is NOT
    // skipped — only the top-level compile-output dir is.
    let test_files = avra_shell_exec("find ${project_dir} \\( -path '${project_dir}/build' -o -path '${project_dir}/build/*' \\) -prune -o -name '*_test.av' -type f -print 2>/dev/null | sort")
    if test_files == "" {
        println("No test files found.")
        return
    }

    // Step 2: Parse each test file as a Module
    // Each file becomes Stmt.Module(name, body) — proper namespacing.
    // Module-level code (spec blocks) executes via __bs_top_level patching.
    //
    // @std packages are loaded once and HOISTED to the top level of the
    // program. Without hoisting, every test file would carry its own
    // copy of each @std package; the resolver's global index would then
    // contain N copies of every package-defined type and `item_lookup`
    // returns the first match, mis-qualifying types and producing
    // duplicate impl-method names (forge-crafting-intepreters-xks4).
    mut modules = StmtList.End
    mut packages = StmtList.End
    mut shared_loaded = LoadedPaths.End
    mut count = 0
    for path in test_files.split("\n") {
        if path == "" { continue }
        let content = read_file(path)
        if !content.contains("spec ") { continue }
        if content.contains("fn main()") { continue }

        let mod_name = basename_no_ext(path)
        if args.filter != "" && !mod_name.contains(args.filter) { continue }

        // Stamp every parsed AST node with `path` so post-bundle
        // diagnostics cite the originating *_test.av — without
        // this the renderer renders the bundle placeholder
        // `<test>:N:N` and shows no source snippet (the bundle
        // never lands on disk).
        let parsed = parse_program_source_at(content, path)
        if parsed.had_error || parsed.stmts == null {
            if bag_has_errors(parsed.bag) {
                render_bag(content, path, parsed.bag)
            }
            eprintln("error parsing ${path}")
            continue
        }

        // Resolve any `mod foo` stubs against the test file's
        // directory so sibling .av files are pulled in. Share
        // LoadedPaths across tests so each @std package is only
        // inlined the first time any test imports it.
        let test_dir = modules_dirname(path)
        let mod_resolved = resolve_module_files(parsed.stmts!, test_dir, shared_loaded)
        if mod_resolved.had_error {
            eprintln("module resolve error in ${path}: ${mod_resolved.error_message}")
            continue
        }
        shared_loaded = mod_resolved.loaded

        // Hoist @-prefixed package modules out of the test body and
        // into a single top-level group. Per-test bodies keep `use`
        // statements, which still resolve against the hoisted modules.
        let split = split_package_modules(mod_resolved.stmts)
        packages = append_stmt_list(split.packages, packages)
        modules = StmtList.Node(
            sstmt_dummy(Stmt.Module(mod_name, split.body)),
            modules
        )
        count = count + 1
    }

    if count == 0 {
        println("No spec test files found.")
        return
    }

    // Step 3: Build program — externs + reporter + packages + modules + main
    //
    // Hoisted package modules sit at the program root so the
    // resolver's module tree contains exactly one copy of each
    // @std::pkg, regardless of how many tests imported it.
    //
    // The reporter (features/spec_test/reporter.av) provides the
    // Avra-side rendering for spec/given/then progress lines and
    // the failure-summary block. Inlining its body at the top of
    // the test program puts `test_render_*` fns at module-root
    // scope so spec codegen's bare `ctx.call("test_render_then", ...)`
    // resolves directly. State (counters, failure list, current
    // spec/given context) lives in runtime.c — see TODO referencing
    // forge-crafting-intepreters-3uy9.
    let reporter_path = find_packages_dir(project_dir) + "std-avrac/src/features/spec_test/reporter.av"
    let reporter_stmts = if avra_selfhost_file_exists(reporter_path) != 0 {
        let rsrc = read_file(reporter_path)
        let rparsed = parse_program_source_at(rsrc, reporter_path)
        if rparsed.had_error || rparsed.stmts == null { StmtList.End }
        else { rparsed.stmts! }
    } else {
        StmtList.End
    }
    // Dedup hoisted package wrappers by qualified name. Each test
    // file's `use @std.X` produces its own Module("@std", [Module("X", body)])
    // wrapper; without merging, the resolver registers two distinct
    // nominal scopes for `@std`, which causes F1000 type-identity
    // collisions and duplicate function definitions at codegen.
    // Tracking ticket: forge-crafting-intepreters-dnq4.
    let deduped_packages = dedup_modules(packages)
    mut program = prepend_test_externs(append_stmt_list(reporter_stmts, append_stmt_list(deduped_packages, modules)))

    // main() calls test_render_summary() from the inlined reporter.
    // Module-level spec blocks run via __bs_top_level (codegen patches main to call it).
    let main_body = StmtList.Node(
        sstmt_dummy(Stmt.Return(Expr.Call(Expr.Ident("test_render_summary"), ExprList.End))),
        StmtList.End
    )
    program = StmtList.Node(
        sstmt_dummy(Stmt.Function("main", TypeParamList.End, ParamList.End, ValueType.Int, main_body)),
        program
    )

    // Step 4: Full pipeline
    let desugared = desugar_program(program)
    let expanded = expand_components(desugared)
    let named = resolve_names(expanded)
    if bag_has_errors(named.bag) || named.had_error {
        render_bag("", "<test>", named.bag)
        fail(named.error_message)
    }
    let tc_result = typecheck_program(named.stmts)
    if bag_has_errors(tc_result.bag) {
        render_bag("", "<test>", tc_result.bag)
        fail("type check failed")
    }
    let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
    if bag_has_errors(mono.bag) {
        render_bag("", "<test>", mono.bag)
        fail("monomorphization failed")
    }

    // Step 5: emit object + link + run.
    // Non-coverage: codegen straight to .o, link, exec.
    // Coverage: codegen IR, lower instrprof via opt, llc to .o, link
    // with profile runtime + 16K-page-aligned profile sections, exec
    // with LLVM_PROFILE_FILE set, then call llvm-cov for the report.
    // All coverage intermediates live under build/coverage/ so the
    // regular build tree stays clean.
    let build_dir = "${project_dir}/build"
    let llvm_env = avra_process_env_get("LLVM_PREFIX")
    let llvm_prefix = if llvm_env == "" { "/opt/homebrew/opt/llvm" } else { llvm_env }
    let llvm_lib = "${llvm_prefix}/lib"

    if !args.coverage {
        let obj_path = "${build_dir}/_test.o"
        let bin_path = "${build_dir}/_test.bin"
        match codegen_and_emit_object(mono.stmts, obj_path, named.type_reg) {
            .Ok(_) -> {}
            .Err(e) -> { fail(e) }
        }
        let link_args = "[\"${obj_path}\", \"${build_dir}/runtime.o\", \"${build_dir}/llvm_wrapper.o\", \"-o\", \"${bin_path}\", \"-Wl,-stack_size,0x2000000\", \"-L${llvm_lib}\", \"-lLLVM\", \"-lc++\"]"
        if avra_process_forward("cc", link_args, "") != 0 { fail("link failed") }
        let exit_code = avra_process_forward(bin_path, "[]", "")
        avra_process_exit(exit_code)
        return
    }

    // ── Coverage path ──
    let cov_dir = "${build_dir}/coverage"
    avra_shell_exec("mkdir -p ${cov_dir}")
    let ir_path = "${cov_dir}/_test.ll"
    let cov_ll = "${cov_dir}/_test.cov.ll"
    let obj_path = "${cov_dir}/_test.o"
    let bin_path = "${cov_dir}/_test.bin"
    let profraw = "${cov_dir}/_test.profraw"
    let profdata = "${cov_dir}/_test.profdata"

    match codegen_and_emit_ir_cov(mono.stmts, ir_path, named.type_reg, "${cov_dir}/_test.av") {
        .Ok(_) -> {}
        .Err(e) -> { fail(e) }
    }

    // Lower llvm.instrprof.increment intrinsics to runtime counter updates.
    let opt_args = "[\"-passes=instrprof\", \"-mtriple=arm64-apple-macosx\", \"-o\", \"${cov_ll}\", \"-S\", \"${ir_path}\"]"
    if avra_process_forward("${llvm_prefix}/bin/opt", opt_args, "") != 0 {
        fail("opt instrprof lowering failed")
    }

    // Lowered IR → object.
    let llc_args = "[\"-O2\", \"-filetype=obj\", \"${cov_ll}\", \"-o\", \"${obj_path}\"]"
    if avra_process_forward("${llvm_prefix}/bin/llc", llc_args, "") != 0 {
        fail("llc failed")
    }

    // Locate clang_rt.profile_osx (path varies by LLVM version).
    let darwin_dir = avra_shell_exec("ls -1 ${llvm_prefix}/lib/clang | head -1").trim()
    let prof_lib_dir = "${llvm_prefix}/lib/clang/${darwin_dir}/lib/darwin"
    // Page-align the profile sections — clang_rt's profile runtime
    // computes counter array bounds from section addresses and
    // expects 16K alignment on Darwin/arm64. Without these flags
    // llvm-profdata reports "number of counters is zero".
    let sectalign = "\"-Wl,-sectalign,__DATA,__llvm_prf_cnts,0x4000\", \"-Wl,-sectalign,__DATA,__llvm_prf_bits,0x4000\", \"-Wl,-sectalign,__DATA,__llvm_prf_data,0x4000\""
    let link_args = "[\"${obj_path}\", \"${build_dir}/runtime.o\", \"${build_dir}/llvm_wrapper.o\", \"-o\", \"${bin_path}\", \"-Wl,-stack_size,0x2000000\", \"-L${llvm_lib}\", \"-lLLVM\", \"-lc++\", \"-L${prof_lib_dir}\", \"-lclang_rt.profile_osx\", ${sectalign}]"
    if avra_process_forward("cc", link_args, "") != 0 {
        fail("link failed")
    }

    // Run the instrumented binary directly so its stdout streams to
    // the user. We pass LLVM_PROFILE_FILE through the env-options
    // payload of avra_process_forward (avra_shell_exec would buffer
    // the entire output and can lose lines on very large suites).
    avra_shell_exec("rm -f ${profraw}")
    let run_opts = "{\"env\":{\"LLVM_PROFILE_FILE\":\"${profraw}\"}}"
    let run_rc = avra_process_forward(bin_path, "[]", run_opts)
    if run_rc != 0 { eprintln("test binary exited with code ${string(run_rc)}") }

    // Merge profraw → profdata.
    let merge_out = avra_shell_exec("${llvm_prefix}/bin/llvm-profdata merge -sparse -o ${profdata} ${profraw} 2>&1")
    if merge_out.length > 0 { eprintln(merge_out.trim()) }

    // Dump profdata to text and hand off to the Avra-side renderer
    // (coverage::render_coverage). The renderer joins our codegen-
    // emitted covmap.tsv with the per-function counts to produce
    // line/branch/MC-DC stats and an optional LCOV file.
    let dump_path = "${cov_dir}/_test.profdata.txt"
    avra_shell_exec("${llvm_prefix}/bin/llvm-profdata show --all-functions --counts ${profdata} > ${dump_path} 2>/dev/null")

    let covmap_path = "${cov_dir}/_test.av.covmap.tsv"
    println("")
    render_coverage(covmap_path, dump_path, args.lcov_path)

    avra_process_exit(0)
}

// Top-level dispatch for `avra docs`. Pulls argv via parse_docs_args,
// loads the requested corpus, then routes to the matching renderer.
// Used to live inline in main(); split out so main()'s body stays
// readable as the docs surface keeps growing.
fn run_docs_command() {
    let args = parse_docs_args()
    let project_dir = avra_process_env_get("PWD")

    if args.want_validate {
        validate_docs(project_dir)
        return
    }

    // --callers needs the call graph in addition to the SymList; load
    // both so a single corpus walk feeds the reverse-lookup.
    if args.want_callers && args.query != "" {
        let corpus = extract_project_corpus(project_dir)
        if !show_callers(args.query, corpus) {
            print_no_symbol(args.query, corpus.syms, "")
            exit(1)
        }
        return
    }

    let docs_set = load_docs_corpus(project_dir, args)

    if args.want_doctest {
        if !run_doctests(docs_set) {
            exit(1)
        }
        return
    }

    if args.want_gen {
        if args.query == "" {
            eprintln("error: --gen requires a symbol name")
            exit(1)
        }
        if !gen_for_symbol(args.query, docs_set, args.want_print) {
            print_no_symbol(args.query, docs_set, "")
            exit(1)
        }
        return
    }

    // Non-human formats short-circuit. `--format=json` dumps the SymList;
    // `--format=markdown` emits clean GitHub-style markdown.
    if args.format == "json" {
        println(render_json(docs_set))
        return
    }
    if args.format == "markdown" {
        println(render_markdown(docs_set))
        return
    }
    if args.format != "human" {
        eprintln("error: unknown format '${args.format}' (try human / markdown / json)")
        exit(1)
    }

    if args.module_path != "" {
        if !show_module(args.module_path, docs_set) {
            eprintln("")
            eprintln("  No module '${args.module_path}' found in project.")
            eprintln("")
            exit(1)
        }
        return
    }
    if args.search_term != "" {
        show_search(args.search_term, docs_set)
        return
    }
    if args.want_llm {
        show_llm(docs_set)
        return
    }
    if args.want_symbols {
        show_symbols(docs_set)
        return
    }
    if args.query != "" {
        let found = if args.want_short {
            show_short(args.query, docs_set)
        } else {
            show_symbol(args.query, docs_set)
        }
        if !found {
            print_no_symbol(args.query, docs_set, "  Hint: try `avra docs` for an overview.")
            exit(1)
        }
        return
    }
    show_overview(docs_set)
}

// Pick the corpus by scope:
//   project (default) — walk PWD/*.av through the indexer
//   lang              — read target/lang.av (generated by `avra lang`)
//   errors            — same as lang, filtered to F-codes
//   all               — project ∪ lang
//
// `lang`/`errors` paths verify target/lang.av exists before calling
// the lib helper — the lib returns an empty SymList on absence so it
// stays argv-free; the CLI surfaces the missing-file diagnostic.
fn load_docs_corpus(project_dir: string, args: DocsArgs) -> SymList {
    match args.scope {
        "project" -> extract_project_syms_cached(project_dir, args.want_no_cache)
        "lang" -> {
            require_lang_av(project_dir)
            extract_lang_corpus(project_dir)
        }
        "errors" -> {
            require_lang_av(project_dir)
            extract_errors_corpus(project_dir)
        }
        "all" -> sym_list_concat(
            extract_project_syms_cached(project_dir, args.want_no_cache),
            extract_lang_corpus(project_dir))
        _ -> {
            eprintln("error: unknown scope '${args.scope}' (try project / lang / errors / all)")
            exit(1)
            SymList.End
        }
    }
}

// CLI guard: bail with a friendly message when the lang corpus
// scopes are requested but `target/lang.av` is absent.
fn require_lang_av(project_dir: string) {
    if avra_selfhost_file_exists("${project_dir}/target/lang.av") == 0 {
        eprintln("error: target/lang.av not found — run `avra lang` first")
        exit(1)
    }
}

// Look up `query` in the project's SymList and either print a doc-stub
// to stdout (`--print`) or insert it above the symbol's decl. Returns
// false when the symbol can't be found so the caller can render a
// did-you-mean hint.
fn gen_for_symbol(query: string, docs_set: SymList, want_print: bool) -> bool {
    let target = find_sym_for_gen(docs_set, query)
    if target == null { return false }
    let s = target!
    let stub = gen_stub_for_sym(s)
    if want_print {
        println(stub)
        return true
    }
    // The Sym's span anchors to the leading /// when one exists, so an
    // already-documented decl reports `doc != ""`. That's our primary
    // idempotency guard; gen_apply also re-checks line-1 to catch hand-
    // edited /// blocks that the indexer hadn't picked up yet.
    if s.doc != "" {
        println("${s.qualified}: already documented")
        return true
    }
    let r = gen_apply(s.file, s.span.start.line, stub)
    if r.error != "" {
        eprintln("error: ${r.error}")
        return false
    }
    if r.skipped {
        println("${s.qualified}: ${r.reason}")
    } else {
        println("${s.file}:${s.span.start.line}: inserted /// stub for ${s.qualified}")
    }
    true
}

fn main() {
    // ── Fully declarative CLI ──
    // Matches the Rust std-cli pattern: nested component blocks, zero builder calls.
    cli app {
        description "Avra bootstrap compiler"
        version "0.1.0"

        command compile {
            description "Compile a Avra file to LLVM IR"
            flag coverage { short "-c", description "Enable coverage instrumentation" }
            flag debug_null { description "Enable null argument checks" }
            flag json { description "Output diagnostics as JSON" }
            option stop_after { description "Stop after phase (parse|resolve|names|check)" }
            arg file { description "Source file", required true }
        }

        command check {
            description "Type-check a Avra file"
            flag json { description "Output diagnostics as JSON" }
            arg file { description "Source file", required true }
        }

        command run {
            description "Compile and run a Avra file"
            arg file { description "Source file", required true }
        }

        command build {
            description "Incremental build via the @std.avrac.build cache (Phase 1: single-unit)"
            flag release { description "Use [profile.release] instead of [profile.dev]" }
            flag explain { description "Print why each unit will rebuild (cargo --explain analogue)" }
            arg file { description "Entry source file (overrides manifest [bin].path)" }
        }

        command clean {
            description "Remove build/ artifacts (preserves the cache by default)"
            flag all { description "Remove build/cache/ as well" }
        }

        command cache {
            description "Manage the build cache: prune | info"
            flag dry_run { description "Print what would change but do not modify the filesystem" }
            option max_age_days { description "Evict entries with mtime older than N days" }
            arg subcommand { description "prune | info", required true }
        }

        command test {
            description "Run tests"
            option filter { short "-f", description "Filter tests by name" }
            flag coverage { short "-c", description "Enable coverage instrumentation" }
            arg file { description "Test file (optional)" }
        }

        command expr {
            description "Parse and display an expression"
            arg file { description "Source file", required true }
        }

        command program {
            description "Parse and display a program"
            arg file { description "Source file", required true }
        }

        command eval {
            description "Evaluate a Avra expression"
            arg file { description "Source file", required true }
        }

        command fix {
            description "Apply auto-fixes to a Avra file"
            arg file { description "Source file", required true }
        }

        command fmt {
            description "Format a Avra source file"
            arg file { description "Source file", required true }
        }

        command lsp {
            description "Start language server"
        }

        command features {
            description "List registered features"
        }

        command docs {
            description "Project documentation -- look up your project's functions, types, and enums"
            flag symbols { description "Show symbol/type reference" }
            flag short { description "Show just the one-liner for a symbol" }
            flag llm { description "Compact LLM-friendly project documentation" }
            flag validate { description "Validate documentation coverage for the project" }
            option search { description "Search project docs (substring match)" }
            arg query { description "Symbol to look up (function, type, enum name)" }
        }
    }

    // Handle subcommands that don't require a file argument.
    if avra_selfhost_argc() >= 2 {
        let cmd0 = avra_selfhost_get_arg_cstr(1)
        if cmd0 == "lsp" {
            // Index the project once, then enter the JSON-RPC stdio
            // loop. v1 serves a static graph; reindex-on-edit waits
            // for the cache layer (rnb9.7) to grow a watch loop.
            let project_dir = avra_process_env_get("PWD")
            run_lsp_server(project_dir)
            return
        }
        if cmd0 == "lang" {
            run_lang_command()
            return
        }
        if cmd0 == "docs" {
            run_docs_command()
            return
        }
        if cmd0 == "test" {
            run_test_command()
            return
        }
        if cmd0 == "build" {
            run_build_command()
            return
        }
        if cmd0 == "clean" {
            run_clean_command()
            return
        }
        if cmd0 == "cache" {
            run_cache_command()
            return
        }
    }

    if avra_selfhost_argc() < 3 {
        print_usage()
        exit(1)
    }

    let command = avra_selfhost_get_arg_cstr(1)
    let path = avra_selfhost_get_arg_cstr(2)
    let is_flag = path.starts_with("--")
    if !is_flag && !file_exists(path) {
        fail("error: file not found: ${path}")
    }

    let source = if is_flag { "" } else { read_file(path) }
    match command {
        "expr" -> {
            let result = parse_expression_source(source)
            if result.had_error || result.expr == null {
                fail(result.error_message)
            }
            println(render_expr(result.expr!))
            return
        }
        "program" -> {
            let result = parse_program_source(source)
            if result.had_error || result.stmts == null {
                fail(result.error_message)
            }
            println(render_stmt_list(result.stmts!))
            return
        }
        "eval" -> {
            let result = eval_expression_source(source)
            if result.had_error || result.value == null {
                fail(result.error_message)
            }
            println(render_value(result.value!))
            return
        }
        "check" -> {
            // Parse --json flag using @std/cli
            let check_parsed = cli_parse(app)
            let check_json = result_has_flag(check_parsed, "json")
            let check_argc = avra_selfhost_argc()
            let check_path = if check_argc > 3 { avra_selfhost_get_arg_cstr(check_argc - 1) } else { path }
            let check_source = if check_path != path { read_file(check_path) } else { source }

            let parsed = parse_program_source(check_source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag_either(check_json, check_source, check_path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            let check_dir = modules_dirname(check_path)
            let check_pkg = load_package_config(check_dir)
            if check_pkg.found && !check_json {
                eprintln("[pkg] ${check_pkg.name} v${check_pkg.version}")
            }
            let desugared = desugar_program(parsed.stmts!)
            let entry_dir = modules_dirname(check_path)
            let mod_resolved = resolve_module_files(desugared, entry_dir, LoadedPaths.End)
            if mod_resolved.had_error {
                let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
                render_bag_either(check_json, check_source, check_path, mod_bag)
                fail(mod_resolved.error_message)
            }
            let expanded = expand_components(mod_resolved.stmts)
            let named = resolve_names(expanded)
            if bag_has_errors(named.bag) || bag_has_warnings(named.bag) {
                render_bag_either(check_json, check_source, check_path, named.bag)
            }
            if named.had_error { fail(named.error_message) }
            let tc_result = typecheck_program(named.stmts)
            if bag_has_errors(tc_result.bag) || bag_has_warnings(tc_result.bag) {
                render_bag_either(check_json, check_source, check_path, tc_result.bag)
            }
            if bag_has_errors(tc_result.bag) { return }
            if !check_json { println("ok") }
            return
        }
        "run" -> {
            let result = execute_program_source(source)
            if result.had_error || result.value == null {
                fail(result.error_message)
            }
            println(render_value(result.value!))
            return
        }
        "fix" -> {
            // Ticket 8ym: autofix infrastructure.
            // Parse and check the file, then apply high-confidence fixes.
            // For v1.0: no auto-fixes are implemented yet, so we just report that.
            let parsed = parse_program_source(source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag(source, path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            let entry_dir = modules_dirname(path)
            let mod_resolved = resolve_module_files(parsed.stmts!, entry_dir, LoadedPaths.End)
            if mod_resolved.had_error {
                fail(mod_resolved.error_message)
            }
            let named = resolve_names(mod_resolved.stmts)
            if bag_has_errors(named.bag) {
                render_bag(source, path, named.bag)
            }
            println("no auto-fixes available")
            return
        }
        "fmt" -> {
            // Ticket c5w: code formatter (spec Axis 27.1).
            // Avra syntax.
            let parsed = parse_program_source(source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag(source, path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            println(fmt_stmt_list(parsed.stmts!, 0))
            return
        }
        "test" -> {
            // Ticket syu: test runner (spec Axis 27.3).
            // Compile the file (which should contain spec/given/then blocks)
            // and report the output path for linking and execution.
            let parsed = parse_program_source(source)
            if parsed.had_error || parsed.stmts == null {
                if bag_has_errors(parsed.bag) {
                    render_bag(source, path, parsed.bag)
                }
                fail(parsed.error_message)
            }
            let desugared = desugar_program(parsed.stmts!)
            let entry_dir = modules_dirname(path)
            let mod_resolved = resolve_module_files(desugared, entry_dir, LoadedPaths.End)
            if mod_resolved.had_error {
                let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
                render_bag(source, path, mod_bag)
                fail(mod_resolved.error_message)
            }
            let expanded = expand_components(mod_resolved.stmts)
            let named = resolve_names(expanded)
            if bag_has_errors(named.bag) || bag_has_warnings(named.bag) {
                render_bag(source, path, named.bag)
            }
            if named.had_error { fail(named.error_message) }
            let tc_result = typecheck_program(named.stmts)
            if bag_has_errors(tc_result.bag) || bag_has_warnings(tc_result.bag) {
                render_bag(source, path, tc_result.bag)
            }
            if bag_has_errors(tc_result.bag) { fail("type check failed") }
            let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
            if bag_has_errors(mono.bag) {
                render_bag(source, path, mono.bag)
                fail("monomorphization failed")
            }
            let output = "${path}.ll"
            match compile_program(mono.stmts, output, false, false, path, named.type_reg) {
                .Ok(_) -> {}
                .Err(e) -> {
                    let ice_bag = bag_report(bag_new(), diag_ice("internal compiler error during codegen: ${e}"))
                    render_bag(source, path, ice_bag)
                    fail(e)
                }
            }
            println(output)
            return
        }
        _ -> {}
    }

    if command == "compile" {
        // Parse compile flags using @std/cli
        let parsed = cli_parse(app)
        let stop_after = result_get_option(parsed, "stop-after")
        let debug_null = result_has_flag(parsed, "debug-null")
        let enable_coverage = result_has_flag(parsed, "coverage")
        let json_output = result_has_flag(parsed, "json")
        // File path: last positional arg
        let argc = avra_selfhost_argc()
        let cpath = avra_selfhost_get_arg_cstr(argc - 1)
        if cpath.starts_with("-") {
            fail("error: compile requires a file path argument")
        }
        if !file_exists(cpath) {
            fail("error: file not found: ${cpath}")
        }
        let csource = read_file(cpath)

        // Load avra.toml package manifest if present in entry dir.
        let pkg_dir = modules_dirname(cpath)
        let pkg = load_package_config(pkg_dir)
        if pkg.found {
            eprintln("[pkg] ${pkg.name} v${pkg.version}")
        }

        // Per-stage wall-clock timings — emitted to stderr at the
        // end when AVRA_TIMINGS=1 is set in the environment. Cheap
        // enough to leave on always (eight i64 reads), and the
        // first step toward forge-crafting-intepreters-kkgf's deeper
        // perf work (we need numbers before we can rank optimisations).
        let timings_on = avra_process_env_get("AVRA_TIMINGS") != ""
        let t_start = avra_uptime_ms()

        let parsed = parse_program_source(csource)
        let t_parse = avra_uptime_ms()
        if parsed.had_error || parsed.stmts == null {
            if bag_has_errors(parsed.bag) {
                render_bag_either(json_output, csource, cpath, parsed.bag)
            }
            fail(parsed.error_message)
        }
        if stop_after == "parse" {
            println("ok")
            return
        }
        // Desugar pass: rewrite syntactic sugar to simpler AST forms.
        let desugared = desugar_program(parsed.stmts!)
        let t_desugar = avra_uptime_ms()
        // Resolve module files: walk the AST, find `mod` stubs, read
        // and parse the referenced files, attach parsed bodies.
        let entry_dir = modules_dirname(cpath)
        let mod_resolved = resolve_module_files(desugared, entry_dir, LoadedPaths.End)
        let t_resolve_mods = avra_uptime_ms()
        if mod_resolved.had_error {
            let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
            render_bag_either(json_output, csource, cpath, mod_bag)
            fail(mod_resolved.error_message)
        }
        if stop_after == "resolve" {
            println("ok")
            return
        }
        // Component expansion: runs AFTER module resolution so component
        // definitions in any module are visible to the expander.
        let expanded = expand_components(mod_resolved.stmts)
        let t_expand = avra_uptime_ms()
        let named = resolve_names(expanded)
        let t_names = avra_uptime_ms()
        if bag_has_errors(named.bag) || bag_has_warnings(named.bag) {
            render_bag_either(json_output, csource, cpath, named.bag)
        }
        if named.had_error { fail(named.error_message) }
        if stop_after == "names" {
            println("ok")
            return
        }
        // Type check — gates compilation on errors
        let tc_result = typecheck_program(named.stmts)
        let t_typeck = avra_uptime_ms()
        if bag_has_errors(tc_result.bag) || bag_has_warnings(tc_result.bag) {
            render_bag_either(json_output, csource, cpath, tc_result.bag)
        }
        if bag_has_errors(tc_result.bag) { fail("type check failed") }
        if stop_after == "check" {
            println("ok")
            return
        }
        // Monomorphize: replace generic declarations with concrete specializations.
        // Uses the type-annotated AST from typeck so inference reads SExpr.ty.
        let mono = monomorphize(tc_result.stmts, tc_result.trait_impls)
        let t_mono = avra_uptime_ms()
        if bag_has_errors(mono.bag) {
            render_bag_either(json_output, csource, cpath, mono.bag)
            fail("monomorphization failed")
        }
        let output = "${cpath}.ll"
        // Ticket t2w: ICE handler — wrap codegen errors in F9999.
        match compile_program(mono.stmts, output, debug_null, enable_coverage, cpath, named.type_reg) {
            .Ok(_) -> {}
            .Err(e) -> {
                let ice_bag = bag_report(bag_new(), diag_ice("internal compiler error during codegen: ${e}"))
                render_bag_either(json_output, csource, cpath, ice_bag)
                fail(e)
            }
        }
        let t_codegen = avra_uptime_ms()
        if timings_on {
            eprintln("[timings] parse=${string(t_parse - t_start)}ms desugar=${string(t_desugar - t_parse)}ms resolve_mods=${string(t_resolve_mods - t_desugar)}ms expand=${string(t_expand - t_resolve_mods)}ms resolve_names=${string(t_names - t_expand)}ms typeck=${string(t_typeck - t_names)}ms monomorphize=${string(t_mono - t_typeck)}ms codegen=${string(t_codegen - t_mono)}ms total=${string(t_codegen - t_start)}ms")
        }
        println(output)
        return
    }

    print_usage()
    exit(1)
}
