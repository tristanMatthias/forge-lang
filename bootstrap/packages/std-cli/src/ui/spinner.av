// WHY: terminal progress UI for long-running shell commands.
//
// Two flavours:
//   * `run_with_spinner(cmd, label)` — single-line braille spinner
//     that updates in place. For commands with no per-step
//     visibility (linker, llc, etc.).
//   * `run_with_progress(cmd, label, total)` — multi-line sticky
//     UI driven by per-module timing events the child appends to
//     a /tmp file. The parent polls the file every 100 ms (no
//     blocking on pipe buffers) and renders:
//       <package-header>                        ← scrollback
//         ✓ <module>          0.4s              ← scrollback
//         ✓ <module>          0.2s              ← scrollback
//         ⠋ <current>         1.6s              ← sticky line 1
//       [============------]  47/235            ← sticky line 2
//     The sticky zone is 2 lines; scrollback grows above it as
//     each `done` event arrives.
//
// File polling instead of stdout reading because bs2's stdout is
// fully buffered when piped (4 KB chunks) — events would freeze
// the UI between buffer flushes. Appending to a regular file is
// per-call flushed and the parent can tick at any cadence
// regardless of compile speed.
//
// Both fall through to a silent captured run on a non-TTY (stderr
// replayed always, stdout only on failure) so CI stdout stays
// byte-clean on success —
// and BOTH paths return the child's REAL exit status. Callers gate
// build success on this rc; an unconditional 0 here once let a
// crashed child compile masquerade as a successful build whenever a
// stale artifact satisfied the caller's existence check.

extern fn avra_isatty_stdout() -> int
extern fn avra_process_spawn_bg(cmd: string, args_json: string, opts_json: string) -> int
extern fn avra_process_is_alive(handle: int) -> int
extern fn avra_process_wait(handle: int) -> string
extern fn avra_sleep_ms(ms: int)
extern fn avra_uptime_ms() -> int
extern fn avra_stdout_write(s: string)
extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_getpid() -> int
// Tail-read the progress file from a byte offset — the whole-file
// read + file_exists probe are gone: "" covers both missing-file and
// nothing-new-since-last-poll.
extern fn avra_selfhost_read_file_from(path: string, offset: int) -> string
extern fn avra_parse_int(s: string) -> int

use @std.json.{json_str, json_extract_string}
use @std.avrac.build.{pool_extract_rc}

// Codepoint-aware string ops — declared inline like this
// package's other runtime externs (see cli.av). Backed by runtime.c.
extern fn avra_str_codepoint_count(s: string) -> int
extern fn avra_str_substring_codepoints(s: string, start: int, end: int) -> string

/// Silent (non-TTY / spawn-failure) execution shared by
/// run_with_spinner and run_with_progress: run `cmd` captured and
/// return the child's REAL exit status. Stream replay policy lives
/// in `replay_child_output`.
fn run_silent(cmd: string) -> int {
    let handle = avra_process_spawn_bg("/bin/sh", "[\"-c\", ${json_str(cmd)}]", "")
    if handle < 0 {
        // Spawn machinery unavailable: system(3)-style execution still
        // surfaces the real rc (child output passes straight through).
        return avra_shell_exec_status(cmd)
    }
    let final_json = avra_process_wait(handle)
    let rc = pool_extract_rc(final_json)
    replay_child_output(final_json, rc)
    rc
}

/// True when stdout is an interactive terminal — gates spinner /
/// progress rendering so CI logs (which pipe stdout) stay byte-clean.
export fn is_tty() -> bool {
    avra_isatty_stdout() != 0
}

/// Emit `\x1b[<n>A` to move cursor up + `\x1b[J` to clear from
/// cursor to end of screen. Skipped when n == 0 — first-render
/// avoids a stray upward jump.
export fn clear_lines(prev_lines: int) {
    if prev_lines <= 0 { return }
    avra_stdout_write("\x1b[${string(prev_lines)}A\r\x1b[J")
}

fn spinner_frames() -> List<string> {
    ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
}

/// Run `cmd` via `/bin/sh -c <cmd>` while rendering a single-line
/// `<label>  <spin> <elapsed>s` indicator on stdout.
export fn run_with_spinner(cmd: string, label: string) -> int {
    if !is_tty() {
        return run_silent(cmd)
    }
    let handle = avra_process_spawn_bg("/bin/sh", "[\"-c\", ${json_str(cmd)}]", "")
    if handle < 0 {
        return run_silent(cmd)
    }
    let frames = spinner_frames()
    let t_start = avra_uptime_ms()
    mut tick = 0
    mut prev_lines = 0
    while avra_process_is_alive(handle) != 0 {
        let elapsed = avra_uptime_ms() - t_start
        let secs = elapsed / 1000
        let tenths = (elapsed / 100) - (secs * 10)
        let frame = frames[tick % frames.length]
        clear_lines(prev_lines)
        avra_stdout_write("${label}  ${frame} ${string(secs)}.${string(tenths)}s\n")
        prev_lines = 1
        tick = tick + 1
        avra_sleep_ms(100)
    }
    let final_json = avra_process_wait(handle)
    let elapsed = avra_uptime_ms() - t_start
    let secs = elapsed / 1000
    let tenths = (elapsed / 100) - (secs * 10)
    clear_lines(prev_lines)
    let rc = pool_extract_rc(final_json)
    if rc == 0 {
        println("${label} done in ${string(secs)}.${string(tenths)}s")
    } else {
        println("${label} failed (rc=${string(rc)} after ${string(secs)}.${string(tenths)}s)")
    }
    replay_child_output(final_json, rc)
    rc
}

/// Multi-line sticky progress UI. Spawns `cmd` with
/// AVRA_BUILD_PROGRESS_FILE set to a fresh /tmp path; the resolver
/// inside bs2 appends `start <path>` / `done <path> <ms>` lines to
/// that file as each module is loaded. Parent polls every 100 ms,
/// drains new events, redraws the sticky zone, and writes scrollback
/// (one `✓ <name> <X>s` per completed module, with a package-header
/// line when the package changes).
export fn run_with_progress(cmd: string, label: string, total: int) -> int {
    if !is_tty() {
        return run_silent(cmd)
    }
    // pid + uptime so two builds starting the same millisecond (or two
    // processes with equal uptime) can't share a progress file.
    let progress_file = "/tmp/avra_progress_${string(avra_getpid())}_${string(avra_uptime_ms())}.log"
    let _ = avra_shell_exec("rm -f ${progress_file}; touch ${progress_file}")
    let progress_cmd = "AVRA_BUILD_PROGRESS_FILE='${progress_file}' ${cmd}"
    let handle = avra_process_spawn_bg("/bin/sh", "[\"-c\", ${json_str(progress_cmd)}]", "")
    if handle < 0 {
        // Nothing will ever write the file the touch above created —
        // remove it instead of orphaning one /tmp entry per failed spawn.
        let _ = avra_shell_exec("rm -f ${progress_file}")
        return run_silent(cmd)
    }
    let t_start = avra_uptime_ms()
    mut active = ""               // currently-parsing module
    mut active_t_start = 0        // when active became active (0 = no active)
    mut count = 0                 // completed count
    mut last_pkg = ""             // last printed package header
    mut bytes_seen = 0            // file offset already processed
    mut prev_lines = 0            // sticky zone height
    mut tick = 0
    while avra_process_is_alive(handle) != 0 {
        // Clear the sticky zone BEFORE draining so any new scrollback
        // emitted by drain lands cleanly above where the sticky will
        // redraw. Doing it the other way around leaves the previous
        // sticky lines stranded in scrollback.
        clear_lines(prev_lines)
        prev_lines = 0
        let drained = drain_progress_file(progress_file, bytes_seen, active, active_t_start, last_pkg, count)
        bytes_seen = drained.bytes_seen
        active = drained.active
        active_t_start = drained.active_t_start
        last_pkg = drained.last_pkg
        count = drained.count
        prev_lines = render_sticky(active, active_t_start, t_start, count, total, tick)
        tick = tick + 1
        avra_sleep_ms(100)
    }
    // One final drain to catch events that landed between the last
    // poll and the child exiting.
    clear_lines(prev_lines)
    prev_lines = 0
    let drained = drain_progress_file(progress_file, bytes_seen, active, active_t_start, last_pkg, count)
    active = drained.active
    last_pkg = drained.last_pkg
    count = drained.count
    let final_json = avra_process_wait(handle)
    let total_elapsed = avra_uptime_ms() - t_start
    let tsec = total_elapsed / 1000
    let ttenths = (total_elapsed / 100) - (tsec * 10)
    let rc = pool_extract_rc(final_json)
    let _ = avra_shell_exec("rm -f ${progress_file}")
    if rc == 0 {
        println("${label} done · ${string(count)} modules · ${string(tsec)}.${string(ttenths)}s")
    } else {
        println("${label} failed (rc=${string(rc)} after ${string(tsec)}.${string(ttenths)}s · ${string(count)} modules)")
    }
    replay_child_output(final_json, rc)
    rc
}

export type DrainResult = {
    bytes_seen: int,
    active: string,
    active_t_start: int,
    last_pkg: string,
    count: int,
}

/// Read the progress file from `bytes_seen` to EOF, parse new
/// `start`/`done` events, print scrollback for each `done`, and
/// return updated state. Idempotent on the file (caller tracks
/// bytes_seen). Exported so the tail-read + offset arithmetic is
/// unit-testable across successive polls of a growing file.
export fn drain_progress_file(path: string, bytes_seen: int, active_in: string, active_t_in: int,
                        last_pkg_in: string, count_in: int) -> DrainResult {
    // Tail-read only the bytes written since the last poll, instead of
    // re-reading the whole file from byte 0 each 100ms tick.
    // `buf` is the suffix at/after `bytes_seen`, so its indices are
    // tail-relative; a missing file OR no new bytes both yield "" →
    // return unchanged. `start`/`i` now walk the tail from 0, and the
    // new absolute offset is `bytes_seen + start`.
    let buf = avra_selfhost_read_file_from(path, bytes_seen)
    if buf.length == 0 {
        return DrainResult { bytes_seen: bytes_seen, active: active_in, active_t_start: active_t_in,
                             last_pkg: last_pkg_in, count: count_in }
    }
    mut active = active_in
    mut active_t = active_t_in
    mut last_pkg = last_pkg_in
    mut count = count_in
    mut start = 0
    mut i = 0
    while i < buf.length {
        if buf.byte(i) == 0x0A {
            // Process this line
            let line = buf.substring(start, i)
            if line.starts_with("start ") {
                active = line.substring(6, line.length)
                active_t = avra_uptime_ms()
            } else if line.starts_with("done ") {
                // done <path> <ms>
                let rest = line.substring(5, line.length)
                let last_sp = last_index_of_byte(rest, 0x20)
                if last_sp > 0 {
                    let path_part = rest.substring(0, last_sp)
                    let ms_part = rest.substring(last_sp + 1, rest.length)
                    let ms = avra_parse_int(ms_part)
                    let pkg = package_of(path_part)
                    if pkg != last_pkg {
                        println("\x1b[1;36m${pkg}\x1b[0m")
                        last_pkg = pkg
                    }
                    let display = display_name(path_part, pkg)
                    let secs = ms / 1000
                    let tenths = (ms / 100) - (secs * 10)
                    println("  \x1b[32m✓\x1b[0m ${pad_right(display, 36)} ${string(secs)}.${string(tenths)}s")
                    count = count + 1
                    if active == path_part {
                        active = ""
                        active_t = 0
                    }
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    DrainResult { bytes_seen: bytes_seen + start, active: active, active_t_start: active_t, last_pkg: last_pkg, count: count }
}

/// Render the sticky bottom region: spinner + progress bar.
/// `t_overall_start` is the wall-clock start of the whole compile —
/// used as the elapsed reference when no module is currently active
/// (the post-resolve typeck/mono/codegen phase emits no per-file
/// events, so we show overall elapsed there instead of a stale
/// per-file counter).
fn render_sticky(active: string, active_t_start: int, t_overall_start: int, count: int, total: int, tick: int) -> int {
    let frames = spinner_frames()
    let frame = frames[tick % frames.length]
    let label = if active == "" {
        "post-parse: typecheck + codegen"
    } else {
        display_name(active, package_of(active))
    }
    let ref_t = if active_t_start == 0 || active == "" { t_overall_start } else { active_t_start }
    let elapsed = avra_uptime_ms() - ref_t
    let secs = elapsed / 1000
    let tenths = (elapsed / 100) - (secs * 10)
    avra_stdout_write("  ${frame} ${pad_right(label, 36)} ${string(secs)}.${string(tenths)}s\n")
    avra_stdout_write("${render_bar(count, total)}  \x1b[1m${string(count)}/${string(total)}\x1b[0m\n")
    2
}

/// 30-char progress bar `[========------]`. Caps at 100% even when
/// count > total (caller's estimate was low).
fn render_bar(count: int, total: int) -> string {
    let width = 30
    let denom = if total <= 0 { 1 } else { total }
    let raw = count * width / denom
    let filled = if raw > width { width } else if raw < 0 { 0 } else { raw }
    mut bar = "["
    mut i = 0
    while i < filled {
        bar = bar + "="
        i = i + 1
    }
    while i < width {
        bar = bar + "-"
        i = i + 1
    }
    bar + "]"
}

/// Detect the package name from a file path, used as the group
/// header in the scrollback. `packages/std-avrac/src/core/ast.av`
/// → `@std/avrac`. `packages/cli/src/main.av` → `cli`. Falls back
/// to the file's parent dir name when no package prefix matches.
fn package_of(path: string) -> string {
    let pkg_marker = "packages/"
    let pi = path.index_of(pkg_marker)
    if pi < 0 {
        // Extract parent dir name
        let p = trim_trailing_av(path)
        mut end = p.length
        while end > 0 && p.byte(end - 1) != 0x2F { end = end - 1 }
        if end == 0 { return "(root)" }
        let dir = p.substring(0, end - 1)
        mut s = dir.length
        while s > 0 && dir.byte(s - 1) != 0x2F { s = s - 1 }
        return dir.substring(s, dir.length)
    }
    let after = path.substring(pi + pkg_marker.length, path.length)
    let slash = after.index_of("/")
    let pkg_dir = if slash < 0 { after } else { after.substring(0, slash) }
    // Map `std-avrac` / `std-cli` / etc → `@std/avrac` for nicer headers.
    if pkg_dir.starts_with("std-") {
        return "@std/" + pkg_dir.substring(4, pkg_dir.length)
    }
    pkg_dir
}

/// Strip the package prefix from the path so the scrollback entry
/// is short: `packages/std-avrac/src/core/ast.av` + pkg `@std/avrac`
/// → `core/ast.av`.
fn display_name(path: string, pkg: string) -> string {
    let pkg_marker = "packages/"
    let pi = path.index_of(pkg_marker)
    if pi < 0 { return path }
    let after = path.substring(pi + pkg_marker.length, path.length)
    let slash = after.index_of("/")
    if slash < 0 { return after }
    // Skip `<pkg-dir>/src/` prefix when present so the display starts
    // at the meaningful sub-path.
    let rest = after.substring(slash + 1, after.length)
    if rest.starts_with("src/") {
        return rest.substring(4, rest.length)
    }
    rest
}

fn last_index_of_byte(s: string, ch: int) -> int {
    mut i = s.length - 1
    while i >= 0 {
        if s.byte(i) == ch { return i }
        i = i - 1
    }
    -1
}

fn trim_trailing_av(s: string) -> string {
    if s.ends_with(".av") { return s.substring(0, s.length - 3) }
    s
}

// Pad/truncate `s` to `width` display cells, measured in CODEPOINTS so a
// multibyte UTF-8 name (module paths are ASCII today, but a package or
// flag could be non-ASCII) is never truncated mid-codepoint and the
// padding count is right. Width here is codepoint count, not terminal
// column width — a wcwidth surface for wide CJK/emoji glyphs is a further
// step, out of scope here.
fn pad_right(s: string, width: int) -> string {
    let cps = avra_str_codepoint_count(s)
    if cps > width {
        // Keep the first width-1 codepoints, then the ellipsis (1 cell).
        return avra_str_substring_codepoints(s, 0, width - 1) + "…"
    }
    mut out = s
    mut pad = width - cps
    while pad > 0 {
        out = out + " "
        pad = pad - 1
    }
    out
}

/// Replay a finished child's captured streams. Stderr replays ALWAYS:
/// it is the compiler's human channel — the `[pkg]` banner, F9xxx
/// warnings, diagnostics — and it passed straight through before
/// execution became capture-based, so swallowing it on success would
/// silently lose a build's warnings. Stdout (the chatter) replays only
/// when the child failed, keeping success logs byte-clean.
/// json_extract_string unescapes the runtime's result-JSON encoding, so
/// multi-line diagnostics render as emitted, not as one \n-escaped line.
fn replay_child_output(final_json: string, rc: int) {
    let err = json_extract_string(final_json, "stderr")
    if err != "" { eprintln(err) }
    if rc != 0 {
        let out = json_extract_string(final_json, "stdout")
        if out != "" { println(out) }
    }
}
