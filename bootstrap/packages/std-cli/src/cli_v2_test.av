// vez6.11 slice A — Runnable behaviour + Subcommand (data/behaviour split).
//
// Pins the redesigned surface: a command's BEHAVIOUR is the 1-method
// `Runnable` trait (`run`); its identity + parse schema are DATA in a
// `CommandSpec`, paired with the behaviour in a `Subcommand`. `App.run`
// reads the schema by direct field access (`c.meta.name`) and dispatches
// through the dyn `body`. The App test also exercises a `List<Subcommand>`
// — structs holding a `dyn` field — the codegen path 7io4 fixed.

use @std.cli.{Runnable, CliResult, CommandSpec, Subcommand, App}

type Foo = { greeting: string, exit_code: int }
impl Runnable for Foo {
    fn run(self, _args: CliResult) -> int {
        println(self.greeting)
        self.exit_code
    }
}

type Bar = { exit_code: int }
impl Runnable for Bar {
    fn run(self, _args: CliResult) -> int {
        println("bar ran")
        self.exit_code
    }
}

fn empty_cli_result() -> CliResult {
    CliResult { command: "", flags: [], options: [], args: [], error: "" }
}

fn named_spec(name: string) -> CommandSpec {
    CommandSpec { name: name, description: "", flags: [], args: [], options: [] }
}

spec "vez6.11 slice A: Runnable behaviour + Subcommand data/behaviour split" {
    then "concrete impl: Foo.run() returns its exit code" {
        let f = Foo { greeting: "captured", exit_code: 7 }
        f.run(empty_cli_result()) == 7
    }
    then "dyn dispatch: a type annotation auto-boxes for the vtable call" {
        let foo: dyn Runnable = Foo { greeting: "via dyn", exit_code: 3 }
        let bar: dyn Runnable = Bar { exit_code: 5 }
        foo.run(empty_cli_result()) == 3 && bar.run(empty_cli_result()) == 5
    }
    then "App dispatches by meta.name to the paired dyn body" {
        let app = App {
            name: "t", description: "", version: "",
            commands: [
                Subcommand { meta: named_spec("foo"), body: Foo { greeting: "x", exit_code: 3 } },
                Subcommand { meta: named_spec("bar"), body: Bar { exit_code: 5 } }
            ]
        }
        let rf = CliResult { command: "foo", flags: [], options: [], args: [], error: "" }
        let rb = CliResult { command: "bar", flags: [], options: [], args: [], error: "" }
        app.dispatch(rf) == 3 && app.dispatch(rb) == 5
    }
}
