// WHY: Pure-Avra CLI argument parsing library.
// Provides a builder-style API for defining commands, flags, options, and args.
// Uses avra_selfhost_argc/get_arg_cstr for raw argument access.
//
// `ui/` is auto-discovered as a sibling submodule (g2eo.1
// directory-as-module). Consumers reach helpers via
// `use @std.cli.ui.{X}` without any `mod` decls in this file.

extern fn avra_selfhost_argc() -> int
extern fn avra_selfhost_get_arg_cstr(idx: int) -> string
extern fn avra_process_exit(code: int)

// ── Types ──

/// Boolean flag declaration: `--name` / `-s`. No value — presence
/// alone toggles it. Exported: a command's schema (CommandSpec) is public
/// so App.run can parse argv against it and hand-written commands can
/// describe themselves.
export type FlagDef = { name: string, short: string, description: string }

/// Option declaration: `--name <value>` or `--name=<value>` /
/// `-s <value>`. Carries a default for when the user omits it.
export type OptionDef = { name: string, short: string, description: string, default_val: string }

/// Positional argument declaration. `required: true` means the
/// parser fails when the user doesn't supply it.
export type ArgDef = { name: string, description: string, required: bool }

/// A subcommand's full parse schema — its name, one-line description, and
/// declared flags / positional args / options. This is the DATA half of a
/// command (its identity + how to parse its argv); the BEHAVIOR half is the
/// `dyn Runnable` it is paired with in a `Subcommand`. Homogeneous data, so
/// `App.run` reads its fields DIRECTLY (`c.meta.name`, `c.meta.flags`) — no
/// vtable, no accessor methods. expand_cli builds one per command; a
/// hand-written command supplies its own.
export type CommandSpec = {
    name: string,
    description: string,
    flags: List<FlagDef>,
    args: List<ArgDef>,
    options: List<OptionDef>
}

/// One subcommand declaration: `name`, help text, and its own
/// per-command flag / option / arg sets. Top-level Cli uses the same
/// shape via its own flag / option / arg fields.
type CommandDef = {
    name: string,
    description: string,
    flags: List<FlagDef>,
    options: List<OptionDef>,
    args: List<ArgDef>
}

/// Parsed flag: `value: true` when the flag appeared in argv.
type ParsedFlag = { name: string, value: bool }

/// Parsed option: the user-supplied value (or the default).
type ParsedOption = { name: string, value: string }

/// Parsed positional arg: name from the schema, value from argv.
type ParsedArg = { name: string, value: string }

/// Output of `cli_parse`. `command` is "" for top-level invocations
/// (no subcommand matched). `error` is "" on success; non-empty
/// strings carry a user-facing error message.
export type CliResult = {
    command: string,
    flags: List<ParsedFlag>,
    options: List<ParsedOption>,
    args: List<ParsedArg>,
    error: string
}

/// Top-level CLI definition. Built up via `cli_new` + the
/// `cli_add_*` builders, then handed to `cli_parse` against argv.
export type Cli = {
    name: string,
    description: string,
    version: string,
    commands: List<CommandDef>,
    flags: List<FlagDef>,
    options: List<OptionDef>,
    args: List<ArgDef>
}

// ── Components V2 surface (vez6.11) ──
//
// The pieces below ship the post-Components-V2 cli API in parallel
// with the legacy builder above. Migration happens incrementally
// (vez6.10–vez6.12); once main.av has fully moved, the legacy
// FlagDef / OptionDef / ArgDef / CommandDef / Cli / cli_* surface
// retires and these become the only API.
//
// Shape mirrors `docs/2026_05_08_COMPONENTS_V2_DESIGN.md §4.2`, with the
// data/behaviour split below:
//   trait Runnable { fn run(self, args: CliResult) -> int }   // behaviour only
//   type CommandSpec = { name, description, flags, args, options }   // data
//   type Subcommand  = { meta: CommandSpec, body: dyn Runnable }
//   @expand(expand_command) component command implements Runnable { ... }
//   @expand(expand_cli)     component cli                          { ... }
// The @expand macros generate one `type Command_<inst>` (a behaviour marker)
// plus `impl Runnable for Command_<inst>` per declared instance, then
// `cli avra { ... }` becomes a top-level `let avra = App { ..., commands:
// [Subcommand{…}] }`. `App.run` reads each command's schema by DIRECT field
// access (`c.meta.name`) and dispatches through the dyn `body` via vtable.

/// A command's BEHAVIOUR: run it with the parsed argv, return an exit code.
/// This is the whole trait — deliberately ONE method. A command's identity
/// and parse schema live in its `CommandSpec` (data); that data is paired
/// with this behaviour in a `Subcommand`. Keeping the trait behaviour-only
/// means the schema is read by direct field access (`c.meta.flags`), never
/// smuggled through the vtable as accessor methods — the honest split of
/// homogeneous data from heterogeneous behaviour.
export trait Runnable {
    fn run(self, args: CliResult) -> int
}

/// One subcommand of an `App`: its `meta` (name + parse schema — DATA, read
/// directly) paired with its `body` (the `dyn Runnable` behaviour, called
/// through the vtable). Pairing them here is what lets `App.run` reach a
/// command's schema without a trait accessor.
export type Subcommand = {
    meta: CommandSpec,
    body: dyn Runnable
}

/// V2 dispatch container (vez6.11). Parallels the design's `Cli`
/// (docs §4.2) but named `App` so it can coexist with the legacy
/// `Cli` builder surface until main.av migrates off it (vez6.12).
/// Holds the `Subcommand` pairs expand_cli generates; `run`/`dispatch`
/// route argv to the matched command via `meta.name` then `body.run`.
export type App = {
    name: string,
    description: string,
    version: string,
    commands: List<Subcommand>
}

impl App {
    /// Run the command whose `meta.name` matches `parsed.command`;
    /// returns its exit code. Returns 1 when nothing matches (the
    /// caller may print help). The name is read by DIRECT field access
    /// off the command's `CommandSpec` (data); dispatch is then a vtable
    /// call through the `dyn Runnable` `body` (behaviour) — each command's
    /// generated `run` body executes with its flag/arg accessors bound.
    fn dispatch(self, parsed: CliResult) -> int {
        for c in self.commands {
            if c.meta.name == parsed.command {
                return c.body.run(parsed)
            }
        }
        1
    }

    /// Parse a pre-read argv (the command name followed by its args —
    /// NOT the program name) against the matched command's own schema,
    /// then dispatch. `--help`/`-h` and `--version`/`-V` in the command
    /// slot are handled here (print + return 0). Returns the command's
    /// exit code, or 1 when the slot is empty or no command matches
    /// (after printing help). Split out from `run` so the whole
    /// parse+dispatch path is testable with a synthetic argv list.
    fn run_argv(self, argv: List<string>) -> int {
        if argv.length == 0 {
            app_print_help(self)
            return 1
        }
        let first = argv[0]
        if is_help_flag(first) {
            app_print_help(self)
            return 0
        }
        if first == "--version" || first == "-V" {
            println("${self.name} v${self.version}")
            return 0
        }
        for c in self.commands {
            if c.meta.name == first {
                return self.run_matched(c, argv)
            }
        }
        app_print_help(self)
        1
    }

    /// Parse the args of an already-matched command (`argv` = the command
    /// name followed by its args) against its schema and dispatch. `<cmd>
    /// --help` short-circuits to the command's own usage; a parse error
    /// (e.g. an undeclared `--flag`) is reported and stops dispatch — a real
    /// CLI doesn't silently run a mis-parsed invocation. The command's `meta`
    /// IS the parse schema (FlagDef/OptionDef/ArgDef lists), read DIRECTLY —
    /// no accessor round-trip, no name→def rebuild.
    fn run_matched(self, c: Subcommand, argv: List<string>) -> int {
        mut tokens: List<string> = []
        mut i = 1
        while i < argv.length {
            tokens.push(argv[i])
            i = i + 1
        }
        if tokens_have_help(tokens) {
            cmd_print_help(self, c.meta)
            return 0
        }
        let parsed = parse_tokens(c.meta.name, c.meta.flags, c.meta.options, c.meta.args, tokens)
        if result_has_error(parsed) {
            eprintln(parsed.error)
            return 1
        }
        c.body.run(parsed)
    }

    /// Read the real process argv (dropping the program name at index 0)
    /// and run. Thin glue over `run_argv` — all the parse/dispatch logic
    /// lives there so it can be tested without a live process.
    fn run(self) -> int {
        let argc = avra_selfhost_argc()
        mut argv: List<string> = []
        mut i = 1
        while i < argc {
            argv.push(avra_selfhost_get_arg_cstr(i))
            i = i + 1
        }
        self.run_argv(argv)
    }
}

/// App-level `--help`: name/version, optional description, usage, and
/// the command list with each command's one-line description (read
/// directly from each `Subcommand`'s `meta`).
fn app_print_help(app: App) {
    println("${app.name} v${app.version}")
    if app.description != "" {
        println(app.description)
    }
    println("")
    println("USAGE:")
    println("  ${app.name} <command> [options]")
    println("")
    println("COMMANDS:")
    for c in app.commands {
        println("  ${c.meta.name}  ${c.meta.description}")
    }
}

/// True iff `s` is the help flag in either spelling (`--help` / `-h`).
/// One place so the two request points — the top-level command slot and a
/// command's own tokens — can't drift.
fn is_help_flag(s: string) -> bool {
    s == "--help" || s == "-h"
}

/// True iff the help flag appears among a command's argv tokens.
fn tokens_have_help(tokens: List<string>) -> bool {
    for t in tokens {
        if is_help_flag(t) { return true }
    }
    false
}

/// Per-command `--help`: the command's name + description, then its
/// declared flags, options, and positional args — read straight off the
/// command's `CommandSpec`. Only non-empty sections are printed.
fn cmd_print_help(app: App, meta: CommandSpec) {
    println("${app.name} ${meta.name}  ${meta.description}")
    println("")
    println("USAGE:")
    println("  ${app.name} ${meta.name} [flags] [options] [args]")
    print_flag_section(meta.flags)
    print_option_section(meta.options)
    print_arg_section(meta.args)
}

/// Render the `FLAGS:` block: one `--name[, -short]  description` line per
/// declared flag. Nothing printed when there are none.
fn print_flag_section(flags: List<FlagDef>) {
    if flags.length == 0 { return }
    println("")
    println("FLAGS:")
    for f in flags {
        let short = if f.short != "" { ", ${f.short}" } else { "" }
        println("  ${f.name}${short}  ${f.description}")
    }
}

/// Render the `OPTIONS:` block: one `--name[, -short]  description` line
/// per declared option. Nothing printed when there are none.
fn print_option_section(options: List<OptionDef>) {
    if options.length == 0 { return }
    println("")
    println("OPTIONS:")
    for o in options {
        let short = if o.short != "" { ", ${o.short}" } else { "" }
        println("  ${o.name}${short}  ${o.description}")
    }
}

/// Render the `ARGS:` block: one `name  description` line per declared
/// positional (positionals aren't dashed). Nothing printed when none.
fn print_arg_section(args: List<ArgDef>) {
    if args.length == 0 { return }
    println("")
    println("ARGS:")
    for a in args {
        println("  ${a.name}  ${a.description}")
    }
}

/// Construct an empty Cli. Use `cli_add_command` / `cli_add_flag`
/// / `cli_add_option` / `cli_add_arg` to populate, then `cli_parse`
/// to consume argv.
export fn cli_new(name: string, description: string, version: string) -> Cli {
    Cli {
        name,
        description,
        version,
        commands: [],
        flags: [],
        options: [],
        args: []
    }
}

/// Register a top-level subcommand. Each command starts with empty
/// flag / option / arg sets — use the `cli_command_add_*` builders
/// to populate them.
export fn cli_add_command(cli: Cli, name: string, description: string) -> Cli {
    let cmd = CommandDef {
        name,
        description,
        flags: [],
        options: [],
        args: []
    }
    mut cmds = cli.commands
    cmds.push(cmd)
    cli with { commands: cmds }
}

/// Register a top-level boolean flag (`--name` / `-s`). Visible
/// under any subcommand.
export fn cli_add_flag(cli: Cli, name: string, short: string, description: string) -> Cli {
    let f = FlagDef { name, short, description }
    mut flags = cli.flags
    flags.push(f)
    cli with { flags: flags }
}

/// Register a top-level option (`--name=value`). `default_val`
/// fills `ParsedOption.value` when the user omits the flag.
export fn cli_add_option(cli: Cli, name: string, short: string, description: string, default_val: string) -> Cli {
    let o = OptionDef { name, short, description, default_val }
    mut options = cli.options
    options.push(o)
    cli with { options: options }
}

/// Register a top-level positional argument. `required: true`
/// makes the parser produce an error when the user omits it.
export fn cli_add_arg(cli: Cli, name: string, description: string, required: bool) -> Cli {
    let a = ArgDef { name, description, required }
    mut args = cli.args
    args.push(a)
    cli with { args: args }
}

/// Register a flag scoped to a specific subcommand.
export fn cli_command_add_flag(cli: Cli, cmd_name: string, name: string, short: string, description: string) -> Cli {
    let f = FlagDef { name, short, description }
    mut cmds = cli.commands
    for (i, cmd) in cmds.enumerate() {
        if cmd.name == cmd_name {
            mut flags = cmd.flags
            flags.push(f)
            cmds.set(i, cmd with { flags: flags })
        }
    }
    cli with { commands: cmds }
}

/// Register an option scoped to a specific subcommand.
export fn cli_command_add_option(cli: Cli, cmd_name: string, name: string, short: string, description: string, default_val: string) -> Cli {
    let o = OptionDef { name, short, description, default_val }
    mut cmds = cli.commands
    for (i, cmd) in cmds.enumerate() {
        if cmd.name == cmd_name {
            mut options = cmd.options
            options.push(o)
            cmds.set(i, cmd with { options: options })
        }
    }
    cli with { commands: cmds }
}

/// Register a positional arg scoped to a specific subcommand.
export fn cli_command_add_arg(cli: Cli, cmd_name: string, name: string, description: string, required: bool) -> Cli {
    let a = ArgDef { name, description, required }
    mut cmds = cli.commands
    for (i, cmd) in cmds.enumerate() {
        if cmd.name == cmd_name {
            mut args = cmd.args
            args.push(a)
            cmds.set(i, cmd with { args: args })
        }
    }
    cli with { commands: cmds }
}

// ── Parsing ──

/// Run argv through the Cli definition. Reads `avra_selfhost_argc()` /
/// `avra_selfhost_get_arg_cstr()` directly, so call only after
/// process startup. Auto-handles `--help` / `--version` (exits the
/// process before returning).
export fn cli_parse(cli: Cli) -> CliResult {
    let argc = avra_selfhost_argc()
    if argc < 2 {
        return CliResult {
            command: "",
            flags: [],
            options: [],
            args: [],
            error: ""
        }
    }

    let first_arg = avra_selfhost_get_arg_cstr(1)

    // Check for --help and --version
    if first_arg == "--help" || first_arg == "-h" {
        cli_print_help(cli)
        avra_process_exit(0)
    }
    if first_arg == "--version" || first_arg == "-V" {
        println("${cli.name} v${cli.version}")
        avra_process_exit(0)
    }

    // Try to match a command
    let cmd = find_command(cli.commands, first_arg)
    if cmd != null {
        // Parse command-specific + global flags/options/args starting at index 2
        return parse_args(cmd!.name, merge_lists(cmd!.flags, cli.flags),
                         merge_options(cmd!.options, cli.options),
                         merge_args(cmd!.args, cli.args), 2, argc)
    }

    // No command matched — parse as global flags/options/args starting at index 1
    parse_args("", cli.flags, cli.options, cli.args, 1, argc)
}

/// Linear lookup of a CommandDef by name, or null when no match.
fn find_command(cmds: List<CommandDef>, name: string) -> CommandDef? {
    mut i = 0
    while i < cmds.length {
        if cmds[i].name == name { return cmds[i] }
        i = i + 1
    }
    null
}

/// Walk argv from `start_idx` to `argc`, classifying each token as
/// a flag (`--name`/`-s`), an option (`--key=value`), or a
/// positional. Reads the real process argv via the selfhost extern;
/// the classification itself lives in `parse_tokens` so both this
/// legacy path and the Components V2 `App.run` path share one parser.
fn parse_args(cmd_name: string, flags: List<FlagDef>, options: List<OptionDef>, args: List<ArgDef>,
              start_idx: int, argc: int) -> CliResult {
    mut tokens: List<string> = []
    for i in start_idx..argc {
        tokens.push(avra_selfhost_get_arg_cstr(i))
    }
    parse_tokens(cmd_name, flags, options, args, tokens)
}

/// The argv classifier, decoupled from the process: given already-read
/// `tokens`, build the CliResult. Each token is a flag (`--name`/`-s`),
/// an option (`--key=value`), or a positional (mapped to the arg schema
/// by declaration order). Shared by `parse_args` (legacy, reads real
/// argv) and `App.run_argv` (Components V2, testable with synthetic
/// argv) so there is a single classification code path.
fn parse_tokens(cmd_name: string, flags: List<FlagDef>, options: List<OptionDef>, args: List<ArgDef>,
                tokens: List<string>) -> CliResult {
    mut parsed_flags: List<ParsedFlag> = []
    mut parsed_options = init_option_defaults(options)
    mut parsed_args: List<ParsedArg> = []
    mut positional_idx = 0
    mut error = ""

    for arg in tokens {
        if arg.starts_with("--") || (arg.starts_with("-") && arg.length > 1) {
            // Check if it's a flag — record under its canonical (long) name so
            // a `-v` short and a `--verbose` long both set `verbose`.
            let fcanon = flag_canonical_name(flags, arg)
            if fcanon != "" {
                parsed_flags.push(ParsedFlag { name: fcanon, value: true })
            }
            // Check if it's an option with = (--key=value)
            else if arg.contains("=") {
                let eq_idx = arg.index_of("=")
                let key = arg.substring(0, eq_idx)
                let val = arg.substring(eq_idx + 1, arg.length)
                let ocanon = option_canonical_name(options, key)
                if ocanon != "" {
                    parsed_options = set_option(parsed_options, ocanon, val)
                } else {
                    error = "unknown option: ${key}"
                }
            }
            // Options use --key=value syntax only (for-loop can't skip ahead)
            else {
                error = "unknown flag: ${arg}"
            }
        } else {
            // Positional argument
            let arg_def = arg_at(args, positional_idx)
            let arg_name = if arg_def != null { arg_def!.name } else { "arg${string(positional_idx)}" }
            parsed_args.push(ParsedArg { name: arg_name, value: arg })
            positional_idx = positional_idx + 1
        }
    }

    CliResult { command: cmd_name, flags: parsed_flags, options: parsed_options, args: parsed_args, error }
}

// ── Helpers ──

/// Drop the leading `--` or `-` from a flag/option token.
fn strip_dashes(s: string) -> string {
    if s.starts_with("--") { s.substring(2, s.length) }
    else if s.starts_with("-") { s.substring(1, s.length) }
    else { s }
}

/// Normalize a flag/option token for matching: `-` and `_` inside a name are
/// treated as equivalent, so `--debug-null` and `--debug_null` are the same
/// flag (a well-established CLI convention — and the reason `compile` could
/// read both spellings). The leading dashes normalize too, but consistently on
/// both sides of every comparison, so the equivalence is unaffected.
fn norm_flag(s: string) -> string {
    s.replace("-", "_")
}

/// The canonical (long, dash-stripped) name of the flag that `arg` matches —
/// by either its `--name` or `-short` spelling, dash/underscore-insensitive —
/// or "" when no flag matches. A flag is always RECORDED under this canonical
/// name, so `result_has_flag` (which the generated run bodies call by long
/// name) resolves it regardless of which spelling the user typed (`-v` and
/// `--verbose` both set `verbose`; `--debug-null` sets `debug_null`).
fn flag_canonical_name(flags: List<FlagDef>, arg: string) -> string {
    let key = norm_flag(arg)
    mut i = 0
    while i < flags.length {
        let f = flags[i]
        if norm_flag(f.name) == key || (f.short != "" && norm_flag(f.short) == key) { return strip_dashes(f.name) }
        i = i + 1
    }
    ""
}

/// The canonical (long, dash-stripped) name of the option that `arg` matches
/// — by either its `--name` or `-short` spelling, dash/underscore-insensitive
/// — or "" when none. Mirrors `flag_canonical_name`: an option is recorded
/// (and defaulted) under this name, so `result_get_option` resolves it
/// whichever spelling was typed.
fn option_canonical_name(options: List<OptionDef>, arg: string) -> string {
    let key = norm_flag(arg)
    mut i = 0
    while i < options.length {
        let o = options[i]
        if norm_flag(o.name) == key || (o.short != "" && norm_flag(o.short) == key) { return strip_dashes(o.name) }
        i = i + 1
    }
    ""
}

/// Zero-indexed lookup into an arg list — null when out of range.
fn arg_at(args: List<ArgDef>, idx: int) -> ArgDef? {
    if idx < 0 || idx >= args.length { return null }
    args[idx]
}

/// Pre-fill a parsed-options list with each OptionDef's default value
/// — overwritten later if the user supplies the option.
fn init_option_defaults(options: List<OptionDef>) -> List<ParsedOption> {
    mut out: List<ParsedOption> = []
    mut i = 0
    while i < options.length {
        let o = options[i]
        out.push(ParsedOption { name: strip_dashes(o.name), value: o.default_val })
        i = i + 1
    }
    out
}

/// Update or insert a ParsedOption — overwrites the existing entry
/// when `name` matches, otherwise appends.
fn set_option(parsed: List<ParsedOption>, name: string, value: string) -> List<ParsedOption> {
    mut out = parsed
    for (i, opt) in out.enumerate() {
        if opt.name == name {
            out.set(i, ParsedOption { name, value })
            return out
        }
    }
    out.push(ParsedOption { name, value })
    out
}

/// Concat two lists — used to merge per-command + globals. Generic over
/// any element shape: `merge_lists`/`merge_options`/`merge_args` are
/// the same operation, kept as separate fns only because Avra has no
/// fn-level generics yet for cross-module callers.
fn merge_lists(a: List<FlagDef>, b: List<FlagDef>) -> List<FlagDef> {
    mut out = a
    mut i = 0
    while i < b.length {
        out.push(b[i])
        i = i + 1
    }
    out
}

fn merge_options(a: List<OptionDef>, b: List<OptionDef>) -> List<OptionDef> {
    mut out = a
    mut i = 0
    while i < b.length {
        out.push(b[i])
        i = i + 1
    }
    out
}

fn merge_args(a: List<ArgDef>, b: List<ArgDef>) -> List<ArgDef> {
    mut out = a
    mut i = 0
    while i < b.length {
        out.push(b[i])
        i = i + 1
    }
    out
}

// ── Query parsed results ──

/// True iff the named flag was set on argv. Convenience over
/// matching on the parsed-flag list directly.
export fn result_has_flag(result: CliResult, name: string) -> bool {
    mut i = 0
    while i < result.flags.length {
        let f = result.flags[i]
        if f.name == name { return f.value }
        i = i + 1
    }
    false
}

/// Read an option's value from the parse result, falling back to
/// the option's declared default when not set.
export fn result_get_option(result: CliResult, name: string) -> string {
    mut i = 0
    while i < result.options.length {
        let o = result.options[i]
        if o.name == name { return o.value }
        i = i + 1
    }
    ""
}

/// Read a positional arg's value by name, "" when not supplied.
export fn result_get_arg(result: CliResult, name: string) -> string {
    mut i = 0
    while i < result.args.length {
        let a = result.args[i]
        if a.name == name { return a.value }
        i = i + 1
    }
    ""
}

/// True iff the parser reported an error (unknown flag etc).
export fn result_has_error(result: CliResult) -> bool {
    result.error != ""
}

// ── Help output ──

/// Print the auto-generated `--help` panel for the CLI.
fn cli_print_help(cli: Cli) {
    println("${cli.name} v${cli.version}")
    if cli.description != "" {
        println(cli.description)
    }
    println("")
    println("USAGE:")
    println("  ${cli.name} <command> [options]")
    println("")
    print_commands(cli.commands)
    print_flags("GLOBAL FLAGS:", cli.flags)
}

/// Print the registered commands. Source-order iteration — no
/// reverse pass needed since List<T> push preserves insertion order.
fn print_commands(cmds: List<CommandDef>) {
    mut i = 0
    while i < cmds.length {
        let cmd = cmds[i]
        println("  ${cmd.name}  ${cmd.description}")
        i = i + 1
    }
}

/// Print a flag list under `header`. Header is printed once before
/// the first entry; the previous double-recursion suppression
/// (header == "") is gone with the iterative form.
fn print_flags(header: string, flags: List<FlagDef>) {
    if flags.length == 0 { return }
    println("")
    println(header)
    mut i = 0
    while i < flags.length {
        let f = flags[i]
        let short_str = if f.short != "" { ", ${f.short}" } else { "" }
        println("  ${f.name}${short_str}  ${f.description}")
        i = i + 1
    }
}
