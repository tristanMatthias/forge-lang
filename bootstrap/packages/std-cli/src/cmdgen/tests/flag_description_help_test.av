// A leaf's `description "…"` config flows through the generated
// FlagDef/OptionDef/ArgDef into the command's `--help` output. cmdgen reads
// each leaf's description the same way it reads `short`/`default`
// (config_value_or_empty), and the help renderer (cli.av print_flag_section /
// print_option_section / print_arg_section) already prints the `description`
// field — so a declared description renders under FLAGS/OPTIONS/ARGS.
//
// Source-compiled (write_fixture_and_run) so cmdgen's cross-package
// @comptime bodies are available. `fd_`-prefixed.

extern fn avra_shell_exec(cmd: string) -> string
use @std.avrac.test_runner.{write_fixture_and_run}

fn fd_src() -> string {
    "use @std.cli.{Runnable, CliResult, App}\n" +
    "use @std.cli.cmdgen.{expand_cli, expand_command}\n" +
    "\n" +
    "@expand(expand_cli)\n" +
    "component cli {}\n" +
    "@expand(expand_command)\n" +
    "component command implements Runnable {}\n" +
    "component flag {}\n" +
    "component arg {}\n" +
    "\n" +
    "cli toy {\n" +
    "    command build {\n" +
    "        flag verbose { description \"FLAGDESC show noisy output\" }\n" +
    "        option outfile { description \"OPTDESC where to write\" }\n" +
    "        arg target { description \"ARGDESC the thing to build\" }\n" +
    "        run() {\n" +
    "            return 0\n" +
    "        }\n" +
    "    }\n" +
    "}\n" +
    "\n" +
    "fn main() {\n" +
    // `build --help` prints the per-command usage; the printed text is captured
    // by the fixture runner and returned as the run output.
    "    println(string(toy.run_argv([\"build\", \"--help\"])))\n" +
    "}\n"
}

fn fd_run() -> string {
    write_fixture_and_run("/tmp/avra_flag_description_help_test.av", fd_src())
}

spec "leaf descriptions render in per-command --help" {
    then "a flag's description appears in the FLAGS section" {
        // `flag verbose { description "FLAGDESC …" }` → the FlagDef carries the
        // description → print_flag_section renders it beside `--verbose`.
        let out = fd_run()
        out.contains("FLAGDESC show noisy output")
    }
    then "an option's description appears in the OPTIONS section" {
        let out = fd_run()
        out.contains("OPTDESC where to write")
    }
    then "an arg's description appears in the ARGS section" {
        let out = fd_run()
        out.contains("ARGDESC the thing to build")
    }
    then "the per-command help still returns exit 0" {
        // run_argv prints help and returns 0 for `<cmd> --help`.
        let out = fd_run()
        out.contains("0")
    }
}
