// WHY: the @comptime macros that expand `command <inst> { … }` / `cli
// <inst> { … }` component instances into the Components V2 runtime shape:
//
//   type Command_<inst> = { marker: int }          // a behaviour marker
//   impl Runnable for Command_<inst> { fn run(self, args: CliResult) -> int { … } }
//
// and, for a cli, a top-level `let <inst> = App { …, commands:
// [Subcommand { meta: CommandSpec{…}, body: Command_<c>{…} }, …] }`.
//
// The DATA/BEHAVIOUR split: a command's identity + parse schema live in a
// `CommandSpec` (plain data), paired with its `dyn Runnable` behaviour in a
// `Subcommand`. App.run reads the schema by DIRECT field access (`c.meta.
// flags`) — the trait is behaviour-only (one method, `run`), so no accessor
// methods, no baked name-lists. The schema is constructed at expansion into
// real `@std::cli::CommandSpec` / `FlagDef` / … struct literals (the schema
// types are exported; a macro can construct them qualified).
//
// Built by DIRECT AST construction. Historical: this shape predates the
// quote foundation — repeating/computed splice landed later (#722/#723),
// and the "second walk overruns the evaluator" F4005 that forced the
// single-walk construction turned out to be an executed wildcard arm's
// `{}` body: an empty MAP literal with no eval handler, fixed by giving
// the @comptime evaluator real map support (rmzs). The one-walk
// `build_command_gen` — returning BOTH the behaviour decls and the schema
// `Subcommand` literal — is kept as the simpler shape; the design's §4.2
// quote-splice rewrite is now unblocked (znl0 / vez6.12). `Stmt.Impl`
// encodes a trait impl as the "Trait:Type" name form the parser uses.
//
// Leaf children (`flag x {}` / `arg y {}` / `option z {}`) need no
// `component` declaration (they parse as nested blocks regardless; `option`
// in particular MUST NOT be declared — it would generate `type Option`,
// colliding with the built-in `Option<T>`). These ship as exported @comptime
// fns; consumers attach them via `@expand` themselves (a lib registration
// would double-register with main.av's inline `component command`).
//
// Directory-as-module (g2eo.1): exports surface at @std.cli.cmdgen.{...}.
//
// PERF ENVELOPE (measured; see the cleanup-pass commit): expansion is
// linear in commands × children and interpreter-bound — a synthetic
// 100-command cli adds ≲1s to a compile whose @std baseline is ~17s, so
// at real scale (avra: 17 commands) the whole expansion is sub-second
// noise. Consequences, considered and deliberately NOT taken further:
// config lookups stay linear scans (≤4 pairs per leaf — a comptime map
// costs more to build than it saves); name-shadow checks stay
// O(globals × children) (globals ≈ 1); no memoization/hash-consing (each
// node is constructed exactly once, nothing repeats); the generated App
// literal builds every CommandSpec at process start (hundreds of small
// allocations once per invocation — lazy per-command construction would
// complicate dispatch for no observable gain).

use @std.avrac.core.{Stmt, Expr, ExprId, ValueType, ParamEntry, TypeParamEntry, FieldEntry, FieldInit, CompConfigPair}
use @std.avrac.features.comptime.{synth_deref_stmt, synth_stmt_ids, synth_expr_id}

// ── small single-value construction helpers ──

/// A string-literal expr (carrying its delimiting quotes — the parser's
/// `Expr.String` convention), as an ExprId ready to splice into a field
/// init.
@comptime
fn str_lit(s: string) -> ExprId {
    synth_expr_id(Expr.String("\"" + s + "\""))
}

/// One struct-literal field init — the atom every generated
/// FlagDef/ArgDef/OptionDef/CommandSpec/Subcommand literal is built from.
@comptime
fn field(name: string, value_id: ExprId) -> FieldInit {
    FieldInit { name: name, value_id: value_id }
}

/// The `key` config pair's value re-emitted as an ExprId, or `dflt` when the
/// key is absent. The single scan behind config_value_or_empty (string
/// default) and config_flag_or_false (bool default).
@comptime
fn config_value_or(config: List<CompConfigPair>, key: string, dflt: ExprId) -> ExprId {
    for pair in config {
        if pair.key == key { return synth_expr_id(pair.value) }
    }
    dflt
}

/// The `value` expr of the `key` config pair (`description "…"` →
/// key="description"), re-emitted as an ExprId; an empty-string literal when
/// the key is absent.
@comptime
fn config_value_or_empty(config: List<CompConfigPair>, key: string) -> ExprId {
    config_value_or(config, key, str_lit(""))
}

/// A boolean leaf config (`required true`) as an ExprId, defaulting to `false`
/// when the leaf omits it. Sibling of config_value_or_empty for bool-valued
/// config (whose absent default is `false`, not the empty string).
@comptime
fn config_flag_or_false(config: List<CompConfigPair>, key: string) -> ExprId {
    config_value_or(config, key, synth_expr_id(Expr.Bool("false")))
}

/// The literal truth of a boolean leaf config (`variadic true`) AT EXPANSION
/// time, false when absent. Unlike config_flag_or_false (which re-emits the
/// value expr for a runtime struct field), this reads the literal so the
/// expansion itself can branch on it — a variadic arg binds a different
/// accessor (result_get_args, List<string>) than a scalar one. Only a literal
/// `true` enables the behaviour: the expansion must know the answer, so a
/// non-literal value cannot participate and reads as false.
@comptime
fn config_bool(config: List<CompConfigPair>, key: string) -> bool {
    for pair in config {
        if pair.key == key {
            match pair.value {
                .Bool(b) -> { return b == "true" }
                _ -> {}
            }
        }
    }
    false
}

/// EVERY `key`-named config value as a `[…]` list-literal ExprId — sibling of
/// config_value_or_empty for a REPEATABLE leaf config. A flag's `alias "…"` may
/// appear more than once (`flag callers { alias "--used-by" alias "--old" }`),
/// so all matching pairs are collected in declaration order; an empty list when
/// the key is absent.
@comptime
fn config_values_list(config: List<CompConfigPair>, key: string) -> ExprId {
    mut vals: List<ExprId> = []
    for pair in config {
        if pair.key == key { vals.push(synth_expr_id(pair.value)) }
    }
    synth_expr_id(Expr.ListLit(vals))
}

/// One accessor binding in a run body: `let <name>: <vtype> =
/// <callee_fqn>(args, "<name>")`. The callee is fully qualified so the
/// generated body resolves in ANY consumer's scope. Not hygienically
/// renamed — the user's run body references it by its declared name.
@comptime
fn accessor_binding(name: string, callee_fqn: string, vtype: ValueType) -> Stmt {
    let callee = synth_expr_id(Expr.QualifiedIdent(callee_fqn))
    let a_arg = synth_expr_id(Expr.Ident("args"))
    let a_name = str_lit(name)
    let call = synth_expr_id(Expr.Call(callee, [a_arg, a_name]))
    Stmt.Let(name, vtype, call)
}

/// True iff `name` occurs in `names`.
@comptime
fn name_in(names: List<string>, name: string) -> bool {
    for n in names {
        if n == name { return true }
    }
    false
}

/// True iff an inherited global flag `gname` is SHADOWED by one of the
/// command's own flags / args / options of the same name — then the
/// command-local binding wins and the global must not be inherited (else the
/// run body gets two `let <name>` of conflicting types, and the schema and
/// bindings disagree). One predicate so the run-body bindings and the
/// CommandSpec's flag list can't drift.
@comptime
fn global_shadowed(gname: string, flag_names: List<string>, arg_names: List<string>, option_names: List<string>) -> bool {
    name_in(flag_names, gname) || name_in(arg_names, gname) || name_in(option_names, gname)
}

/// A `@std::cli::FlagDef { name: "--<n>", short: <short>, description: <desc>,
/// aliases: <aliases> }` literal (name dashed so the classifier matches `--<n>`
/// on argv). `short` is the flag leaf's `short "…"` config value (e.g. `"-v"`),
/// or the empty string when unset — the parser's `flag_canonical_name` accepts
/// either spelling. `desc` is the leaf's `description "…"` config (empty when
/// unset); it renders in the command's `--help` FLAGS section. `aliases` is the
/// leaf's `alias "…"` config values as a list literal (empty when none) — extra
/// whole-token spellings the classifier also resolves to this flag.
@comptime
fn flagdef_lit(name: string, short: ExprId, desc: ExprId, aliases: ExprId) -> ExprId {
    synth_expr_id(Expr.StructLit("@std::cli::FlagDef", [
        field("name", str_lit("--" + name)),
        field("short", short),
        field("description", desc),
        field("aliases", aliases),
    ]))
}

/// A bool-literal expr as an ExprId — sibling of str_lit for the fields whose
/// value the EXPANSION itself computed (e.g. an arg's `variadic`, read via
/// config_bool so the generated bindings can branch on it).
@comptime
fn bool_lit(b: bool) -> ExprId {
    synth_expr_id(Expr.Bool(if b { "true" } else { "false" }))
}

/// A `@std::cli::ArgDef { name: "<n>", description: <desc>, required: <req>,
/// variadic: <v> }` literal (positionals aren't dashed). `desc` is the leaf's
/// `description "…"` config (empty when unset); it renders in the `--help`
/// ARGS section. `variadic` arrives as a plain bool (not a re-emitted config
/// expr) because the expansion already branched on it for the run-body
/// binding — one comptime-known truth feeds both, so the ArgDef and the
/// accessor can't disagree.
@comptime
fn argdef_lit(name: string, desc: ExprId, required: ExprId, variadic: bool) -> ExprId {
    synth_expr_id(Expr.StructLit("@std::cli::ArgDef", [
        field("name", str_lit(name)),
        field("description", desc),
        field("required", required),
        field("variadic", bool_lit(variadic)),
    ]))
}

/// A `@std::cli::OptionDef { name: "--<n>", short: <short>, description: <desc>,
/// default_val: <default> }` literal. `short` is the option leaf's `short "…"`
/// config value (e.g. `"-f"`), or the empty string when unset — the parser's
/// `option_canonical_name` accepts either spelling, mirroring flag shorts.
/// `default_val` is the option leaf's `default "…"` config value (used to
/// pre-fill the parsed option when the user omits it — see
/// `init_option_defaults`), or the empty string when unset. `desc` is the leaf's
/// `description "…"` config (empty when unset); it renders in the `--help`
/// OPTIONS section.
@comptime
fn optiondef_lit(name: string, short: ExprId, default_val: ExprId, desc: ExprId) -> ExprId {
    synth_expr_id(Expr.StructLit("@std::cli::OptionDef", [
        field("name", str_lit("--" + name)),
        field("short", short),
        field("description", desc),
        field("default_val", default_val),
    ]))
}

/// A `@std::cli::CommandSpec { name, description, hidden, flags, args,
/// options }` literal — the command's identity + parse schema as DATA. The
/// `*_defs` are already-built `FlagDef`/`ArgDef`/`OptionDef` literal ExprIds
/// (carrying each leaf's `short` / `default` config), assembled by
/// `build_command_gen` where the leaf configs are in scope; this fn just
/// wraps them in the spec. `hidden` is the command's `hidden true` config
/// (read via config_bool — a comptime-known literal), which keeps the
/// command out of the app-level help's COMMANDS list.
@comptime
fn command_spec_lit(name: string, desc: ExprId, hidden: bool, flag_defs: List<ExprId>, arg_defs: List<ExprId>, opt_defs: List<ExprId>) -> ExprId {
    synth_expr_id(Expr.StructLit("@std::cli::CommandSpec", [
        field("name", str_lit(name)),
        field("description", desc),
        field("hidden", bool_lit(hidden)),
        field("flags", synth_expr_id(Expr.ListLit(flag_defs))),
        field("args", synth_expr_id(Expr.ListLit(arg_defs))),
        field("options", synth_expr_id(Expr.ListLit(opt_defs))),
    ]))
}

/// The set of flags a command accepts: its own flags plus inherited global
/// flags not shadowed by an own flag/arg/option. Order: globals first, then
/// own — matching the run-body binding order. Built inline; used by BOTH the
/// run bindings and the CommandSpec flags so they stay in lockstep.
@comptime
fn command_flag_names(extra_flags: List<string>, flag_names: List<string>, arg_names: List<string>, option_names: List<string>) -> List<string> {
    mut out: List<string> = []
    for g in extra_flags {
        if !global_shadowed(g, flag_names, arg_names, option_names) { out.push(g) }
    }
    for f in flag_names { out.push(f) }
    out
}

/// Everything one command generates from a SINGLE body-walk: its behaviour
/// `decls` (`type Command_<inst>` + the `Runnable` impl) and the `subcommand`
/// literal (`Subcommand { meta: CommandSpec{…}, body: Command_<inst>{…} }`)
/// for the App's command list. Returned together so a cli needn't re-walk a
/// command's children to build its schema (the re-walk also overran the
/// comptime evaluator — a `match` on the children in a second, deeper frame
/// trips it; folding both into the one proven walk here sidesteps that).
type CommandGen = {
    decls: List<Stmt>,
    subcommand: ExprId
}

/// Core per-command generation, shared by expand_command (standalone) and
/// expand_cli. Emits `type Command_<inst> = { marker: int }` (a behaviour
/// marker — the command carries no data; its schema lives in the CommandSpec)
/// + `impl Runnable for Command_<inst> { fn run(self, args) { <accessor
/// bindings> <user run body> } }`, plus the paired `Subcommand` literal.
/// `extra_flags` are the parent cli's global flag names, inherited into the
/// run bindings + schema (deduped); `extra_flag_defs` are those same globals'
/// pre-built `FlagDef` literals (index-aligned with `extra_flags`), carrying
/// each global's `short` — threaded in because a command can't see the
/// cli-level flag configs. Single body-walk.
@comptime
fn build_command_gen(s: Stmt, extra_flags: List<string>, extra_flag_defs: List<ExprId>) -> CommandGen {
    mut inst = ""
    mut run_body: List<Stmt> = []
    mut flag_names: List<string> = []
    mut arg_names: List<string> = []
    mut option_names: List<string> = []
    mut flag_shorts: List<ExprId> = []
    mut flag_aliases: List<ExprId> = []
    mut option_shorts: List<ExprId> = []
    mut option_defaults: List<ExprId> = []
    // Each leaf's `description "…"` config, collected index-aligned with its
    // names so the generated FlagDef/ArgDef/OptionDef carry it into `--help`.
    mut flag_descs: List<ExprId> = []
    mut arg_descs: List<ExprId> = []
    mut option_descs: List<ExprId> = []
    // Each `arg`'s `required true` config (defaults to false), so the generated
    // ArgDef declares it and parse_tokens can reject an omitted required arg.
    mut arg_requireds: List<ExprId> = []
    // Each `arg`'s `variadic true` config as a comptime-known bool: it steers
    // the generated run-body binding (result_get_args → List<string> instead
    // of result_get_arg → string) as well as the ArgDef literal.
    mut arg_variadics: List<bool> = []
    mut desc = str_lit("")
    // The command's `hidden true` config — display-only (see CommandSpec).
    mut hidden = false
    match s {
        .ComponentBlock(_, instance, cfg, body) -> {
            inst = instance
            desc = config_value_or_empty(cfg, "description")
            hidden = config_bool(cfg, "hidden")
            for id in body {
                let child = synth_deref_stmt(id)
                match child {
                    .Function(fname, _, _, _, fbody) -> {
                        if fname == "run" {
                            for bid in fbody {
                                run_body.push(synth_deref_stmt(bid))
                            }
                        }
                    }
                    .ComponentBlock(cn, cinst, ccfg, _) -> {
                        if cn == "flag" {
                            flag_names.push(cinst)
                            flag_shorts.push(config_value_or_empty(ccfg, "short"))
                            flag_descs.push(config_value_or_empty(ccfg, "description"))
                            flag_aliases.push(config_values_list(ccfg, "alias"))
                        }
                        if cn == "arg" {
                            arg_names.push(cinst)
                            arg_descs.push(config_value_or_empty(ccfg, "description"))
                            arg_requireds.push(config_flag_or_false(ccfg, "required"))
                            arg_variadics.push(config_bool(ccfg, "variadic"))
                        }
                        if cn == "option" {
                            option_names.push(cinst)
                            option_shorts.push(config_value_or_empty(ccfg, "short"))
                            option_defaults.push(config_value_or_empty(ccfg, "default"))
                            option_descs.push(config_value_or_empty(ccfg, "description"))
                        }
                    }
                    _ -> {}
                }
            }
        }
        _ -> {}
    }

    let tn = "Command_" + inst
    let empty_vt: List<ValueType> = []
    let empty_tp: List<TypeParamEntry> = []
    let self_ty = ValueType.Struct(tn, empty_vt, 0)
    let cli_ty = ValueType.Struct("CliResult", empty_vt, 0)
    let self_p = ParamEntry { name: "self", vtype: self_ty }
    let args_p = ParamEntry { name: "args", vtype: cli_ty }

    // The command's full flag set (own + inherited globals, deduped) — used by
    // BOTH the run bindings and the CommandSpec flags so they stay in lockstep.
    let all_flags = command_flag_names(extra_flags, flag_names, arg_names, option_names)

    // fn run(self, args: CliResult) -> int {
    //   <inherited-global + own flag bindings> <arg bindings> <option bindings>
    //   <user run body>
    // }
    mut full_run: List<Stmt> = []
    for fname in all_flags {
        full_run.push(accessor_binding(fname, "@std::cli::result_has_flag", ValueType.Bool))
    }
    // A variadic arg binds the PLURAL accessor: every positional the arg
    // absorbed, as a List<string>. Scalar args keep the singular string form.
    mut bi = 0
    while bi < arg_names.length {
        if arg_variadics[bi] {
            full_run.push(accessor_binding(arg_names[bi], "@std::cli::result_get_args", ValueType.List(ValueType.Str)))
        } else {
            full_run.push(accessor_binding(arg_names[bi], "@std::cli::result_get_arg", ValueType.Str))
        }
        bi = bi + 1
    }
    for oname in option_names {
        full_run.push(accessor_binding(oname, "@std::cli::result_get_option", ValueType.Str))
    }
    for st in run_body { full_run.push(st) }
    let run_fn = Stmt.Function("run", empty_tp, [self_p, args_p], ValueType.Int, synth_stmt_ids(full_run))

    // impl Runnable for Command_<inst> { run }  ("Trait:Type" form)
    let impl_stmt = Stmt.Impl("Runnable:" + tn, synth_stmt_ids([run_fn]))

    // type Command_<inst> = { marker: int } — a distinct behaviour type per
    // command (each needs its own Runnable impl); the field is an unused
    // marker so the struct is non-empty (its data lives in the CommandSpec).
    let marker_field = FieldEntry { name: "marker", resolved: ValueType.Int }
    let type_decl = Stmt.TypeDecl(tn, empty_tp, [marker_field])

    // Build the schema def lists. The flag defs mirror `all_flags` EXACTLY
    // (globals-not-shadowed first, then own) so the CommandSpec's flags stay in
    // lockstep with the run bindings — but carry each flag's `short` (globals
    // from the threaded pre-built defs, own from the walk-collected shorts).
    mut schema_flag_defs: List<ExprId> = []
    mut gi = 0
    while gi < extra_flags.length {
        if !global_shadowed(extra_flags[gi], flag_names, arg_names, option_names) {
            schema_flag_defs.push(extra_flag_defs[gi])
        }
        gi = gi + 1
    }
    mut fi = 0
    while fi < flag_names.length {
        schema_flag_defs.push(flagdef_lit(flag_names[fi], flag_shorts[fi], flag_descs[fi], flag_aliases[fi]))
        fi = fi + 1
    }
    mut arg_defs: List<ExprId> = []
    mut ai = 0
    while ai < arg_names.length {
        arg_defs.push(argdef_lit(arg_names[ai], arg_descs[ai], arg_requireds[ai], arg_variadics[ai]))
        ai = ai + 1
    }
    mut opt_defs: List<ExprId> = []
    mut oi = 0
    while oi < option_names.length {
        opt_defs.push(optiondef_lit(option_names[oi], option_shorts[oi], option_defaults[oi], option_descs[oi]))
        oi = oi + 1
    }

    // The Subcommand literal: schema (CommandSpec, from the SAME collected
    // data) paired with a fresh behaviour instance.
    let spec_expr = command_spec_lit(inst, desc, hidden, schema_flag_defs, arg_defs, opt_defs)
    let subcommand = subcommand_lit(inst, spec_expr)

    CommandGen { decls: [type_decl, impl_stmt], subcommand: subcommand }
}

/// Expand a standalone `command <inst> { … }` into `[type Command_<inst>,
/// impl Runnable for Command_<inst>]` — the `@expand(expand_command)` entry
/// point. No inherited globals; only expand_cli threads a parent cli's
/// globals into a command. The Subcommand half is unused standalone (a lone
/// command has no App to join).
@comptime
export fn expand_command(s: Stmt) -> List<Stmt> {
    let no_globals: List<string> = []
    let no_global_defs: List<ExprId> = []
    return build_command_gen(s, no_globals, no_global_defs).decls
}

/// A `@std::cli::Subcommand { meta: <spec>, body: Command_<inst>{ marker: 0 } }`
/// literal — the command's schema (data) paired with a fresh behaviour
/// instance (boxed to `dyn Runnable` at the field, per the struct-dyn-field
/// codegen path 7io4).
@comptime
fn subcommand_lit(inst: string, spec_expr: ExprId) -> ExprId {
    let body = synth_expr_id(Expr.StructLit("Command_" + inst, [
        field("marker", synth_expr_id(Expr.Number("0"))),
    ]))
    synth_expr_id(Expr.StructLit("@std::cli::Subcommand", [
        field("meta", spec_expr),
        field("body", body),
    ]))
}

/// Expand a `cli <inst> { command <c> { … } … }` instance into the
/// per-command `type Command_<c>` + `impl Runnable` decls plus a top-level
/// `let <inst> = App { … }`. A `flag <g> {}` declared directly in the cli
/// block is a GLOBAL flag inherited into every command (design §4.2
/// parent_chain_flags). Each command's `description "…"` config is stamped
/// into its CommandSpec; the cli's own `description`/`version` onto the App.
@comptime
export fn expand_cli(s: Stmt) -> List<Stmt> {
    mut out: List<Stmt> = []
    mut inst = ""
    mut app_desc = str_lit("")
    mut app_ver = str_lit("")
    mut global_flags: List<string> = []
    mut global_flag_defs: List<ExprId> = []
    mut sub_lits: List<ExprId> = []

    // Command child blocks, collected during the single body walk and
    // expanded AFTER it — every global flag must be known before any
    // command's schema is built (a `flag <g>` may be declared below a
    // command in source), and holding the already-deref'd nodes means no
    // child is deref'd twice.
    mut command_blocks: List<Stmt> = []
    match s {
        .ComponentBlock(_, instance, cliconfig, body) -> {
            inst = instance
            app_desc = config_value_or_empty(cliconfig, "description")
            app_ver = config_value_or_empty(cliconfig, "version")
            // ONE walk over the cli's direct children: a `flag <g> {}` is a
            // GLOBAL flag inherited into every command (capture its FlagDef
            // here, where the cli-level config is in scope, index-aligned
            // with the names); a `command` block is held for expansion below.
            for id in body {
                let child = synth_deref_stmt(id)
                match child {
                    .ComponentBlock(cn, cinst, gcfg, _) -> {
                        if cn == "flag" {
                            global_flags.push(cinst)
                            global_flag_defs.push(flagdef_lit(cinst, config_value_or_empty(gcfg, "short"), config_value_or_empty(gcfg, "description"), config_values_list(gcfg, "alias")))
                        }
                        if cn == "command" { command_blocks.push(child) }
                    }
                    _ -> {}
                }
            }
            // Each command generates its behaviour decls + its Subcommand
            // literal from a SINGLE walk of its own children
            // (build_command_gen — a re-walk once tripped the evaluator).
            // Globals thread in as inherited flags.

            // Each command generates its behaviour decls + its Subcommand
            // literal from a SINGLE walk of its own children
            // (build_command_gen — a re-walk once tripped the evaluator).
            // Globals thread in as inherited flags.
            for child in command_blocks {
                let gen = build_command_gen(child, global_flags, global_flag_defs)
                for d in gen.decls { out.push(d) }
                sub_lits.push(gen.subcommand)
            }
        }
        _ -> {}
    }

    // Top-level `let <inst> = App { name, description, version, commands:
    // [Subcommand{…}, …] }`. The Subcommand literals splice inline into the
    // `List<Subcommand>` field; each `body` boxes to `dyn Runnable` there.
    let empty_vt: List<ValueType> = []
    let app_vt = ValueType.Struct("App", empty_vt, 0)
    let app_lit = synth_expr_id(Expr.StructLit("@std::cli::App", [
        field("name", str_lit(inst)),
        field("description", app_desc),
        field("version", app_ver),
        field("commands", synth_expr_id(Expr.ListLit(sub_lits))),
    ]))
    out.push(Stmt.Let(inst, app_vt, app_lit))
    out
}
