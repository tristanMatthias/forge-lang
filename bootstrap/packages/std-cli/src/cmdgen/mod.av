// WHY: the @comptime macro that expands a `command <inst> { fn run(...)
// { ... } }` component instance into a per-instance `type Command_<inst>`
// plus a `Runnable` trait impl, so a cli's `List<dyn Runnable>` dispatch
// can call it. This is the load-bearing per-instance trait-impl
// generation the whole Components V2 declarative layer is built on.
//
// Built by DIRECT AST construction, NOT the design's §4.2 quote-splice
// form: repeating statement-splice (`~body`) and computed-value splice
// both hit F4006, and calling two sequential list-building @comptime
// helpers hits F4005 (the comptime-foundation gaps, rmzs). Direct
// construction (the derive_walker pattern — Stmt.Function/Impl/TypeDecl
// + synth_stmt_ids) plus reading the instance in a SINGLE body-walk
// sidestep all three. `Stmt.Impl` encodes a trait impl as the
// "Trait:Type" name form the parser uses.
//
// SCOPE: generates `type Command_<inst>` + `impl Runnable for
// Command_<inst>` with name()/run(). The run body is the declared
// flag/arg accessor bindings (a `flag x {}` → `let x =
// @std::cli::result_has_flag(args, "x")`, an `arg y {}` → `let y =
// @std::cli::result_get_arg(args, "y")`, callees emitted fully qualified
// so they resolve without the consumer importing them) followed by the
// user's run body verbatim. Registration (`@expand(expand_command)
// component command`) is deferred to vez6.12: packages/cli/src/main.av
// still defines `component command` inline, so registering it in the lib
// would double-register. Ships as an exported @comptime fn; consumers /
// tests attach it via @expand themselves. Still TODO for full §4.2
// parity: config fields (`description`) on the generated type + parent
// (cli) global-flag inheritance — landing with expand_cli.
//
// Directory-as-module (g2eo.1): exports surface at @std.cli.cmdgen.{...}.

use @std.avrac.core.{Stmt, Expr, ExprId, ValueType, ParamEntry, TypeParamEntry, FieldEntry, FieldInit}
use @std.avrac.features.comptime.{synth_deref_stmt, synth_stmt_ids, synth_expr_id}

/// Expand a `command <inst> { flag…/arg… fn run(args: CliResult) -> int
/// { … } }` instance into `[type Command_<inst>, impl Runnable for
/// Command_<inst>]`. The generated `run` prepends one accessor binding
/// per declared `flag`/`arg` child (`let <flag> =
/// @std::cli::result_has_flag(args, "<flag>")`, `let <arg> =
/// @std::cli::result_get_arg(args, "<arg>")`) then carries the user's run
/// body verbatim; `name` returns the instance's `name` field. Emits names
/// (`Runnable`, `CliResult`) that resolve in the consumer's scope.
@comptime
export fn expand_command(s: Stmt) -> List<Stmt> {
    // Single body-walk: read the instance name, the declared flag/arg
    // child names, and the run method body in ONE pass (calling several
    // list-returning @comptime helpers in sequence trips the evaluator
    // — rmzs gap 3, so we inline the traversal instead of reusing
    // comp_children / comp_instance_name).
    mut inst = ""
    mut run_body: List<Stmt> = []
    mut flag_names: List<string> = []
    mut arg_names: List<string> = []
    match s {
        .ComponentBlock(_, instance, _, body) -> {
            inst = instance
            for id in body {
                let child = synth_deref_stmt(id)
                match child {
                    .Function(fname, _, _, _, fbody) -> {
                        if fname == "run" {
                            for bid in fbody {
                                run_body.push(synth_deref_stmt(bid))
                            }
                        }
                    }
                    .ComponentBlock(cn, cinst, _, _) -> {
                        if cn == "flag" { flag_names.push(cinst) }
                        if cn == "arg" { arg_names.push(cinst) }
                    }
                    _ -> {}
                }
            }
        }
        _ -> {}
    }

    let tn = "Command_" + inst
    let empty_vt: List<ValueType> = []
    let empty_tp: List<TypeParamEntry> = []
    let self_ty = ValueType.Struct(tn, empty_vt, 0)
    let cli_ty = ValueType.Struct("CliResult", empty_vt, 0)
    let self_p = ParamEntry { name: "self", vtype: self_ty }

    // fn name(self) -> string { return self.name }
    let ret_name = Stmt.Return(synth_expr_id(Expr.FieldAccess(synth_expr_id(Expr.Ident("self")), "name")))
    let name_fn = Stmt.Function("name", empty_tp, [self_p], ValueType.Str, synth_stmt_ids([ret_name]))

    // fn run(self, args: CliResult) -> int { <flag/arg bindings> <user run body> }
    //
    // Prepend one accessor local per declared child (design §4.2): a
    // `flag x {}` becomes `let x = result_has_flag(args, "x")` (bool),
    // an `arg y {}` becomes `let y = result_get_arg(args, "y")` (string),
    // so the user's run body references each by its declared name. String
    // literals carry their delimiting quotes (the parser's Expr.String
    // convention). The macro-introduced binding must be visible to the
    // user body, so it is intentionally NOT hygienically renamed.
    // The accessor callees are emitted FULLY QUALIFIED so the generated
    // run body resolves in ANY consumer's scope — a library macro must
    // not require the consumer to import std-cli's internal helpers.
    let args_p = ParamEntry { name: "args", vtype: cli_ty }
    mut full_run: List<Stmt> = []
    for fname in flag_names {
        let callee = synth_expr_id(Expr.QualifiedIdent("@std::cli::result_has_flag"))
        let a_arg = synth_expr_id(Expr.Ident("args"))
        let a_name = synth_expr_id(Expr.String("\"" + fname + "\""))
        let call = synth_expr_id(Expr.Call(callee, [a_arg, a_name]))
        full_run.push(Stmt.Let(fname, ValueType.Bool, call))
    }
    for aname in arg_names {
        let callee = synth_expr_id(Expr.QualifiedIdent("@std::cli::result_get_arg"))
        let a_arg = synth_expr_id(Expr.Ident("args"))
        let a_name = synth_expr_id(Expr.String("\"" + aname + "\""))
        let call = synth_expr_id(Expr.Call(callee, [a_arg, a_name]))
        full_run.push(Stmt.Let(aname, ValueType.Str, call))
    }
    for st in run_body { full_run.push(st) }
    let run_fn = Stmt.Function("run", empty_tp, [self_p, args_p], ValueType.Int, synth_stmt_ids(full_run))

    // impl Runnable for Command_<inst> { name; run }  ("Trait:Type" form)
    let impl_stmt = Stmt.Impl("Runnable:" + tn, synth_stmt_ids([name_fn, run_fn]))

    // type Command_<inst> = { name: string }
    let name_field = FieldEntry { name: "name", resolved: ValueType.Str }
    let type_decl = Stmt.TypeDecl(tn, empty_tp, [name_field])

    return [type_decl, impl_stmt]
}

/// Expand a `cli <inst> { command <c> { … } … }` instance into the
/// per-command `type Command_<c>` + `impl Runnable for Command_<c>`
/// decls (delegating to expand_command per command) plus a builder
/// `fn <inst>() -> App` wiring the commands as `dyn Runnable` boxes.
/// Consumers call `<inst>()` for the App, then `.dispatch(parsed)` to
/// run the matched command.
///
/// A builder fn (not a top-level `let <inst> = App { … }`) because a
/// top-level let bound to a struct is mis-typed at a later top-level
/// method call (design § Non-goals). Inside the builder's function
/// scope the App dispatches correctly. The command boxes are bound
/// through a typed local first — `let cmds: List<dyn Runnable> =
/// [Command_<c> { name: "<c>" }, …]` — because a `List<dyn Trait>`
/// STRUCT FIELD does not box its inline element literals (bug 966j);
/// the `List<dyn Runnable>` let-annotation does. Config
/// (description/version) + global-flag inheritance are the next
/// increment.
@comptime
export fn expand_cli(s: Stmt) -> List<Stmt> {
    mut inst = ""
    mut out: List<Stmt> = []
    mut cmd_names: List<string> = []
    match s {
        .ComponentBlock(_, instance, _, body) -> {
            inst = instance
            for id in body {
                let child = synth_deref_stmt(id)
                match child {
                    .ComponentBlock(cn, cinst, _, _) -> {
                        if cn == "command" {
                            let decls = expand_command(child)
                            for d in decls { out.push(d) }
                            cmd_names.push(cinst)
                        }
                    }
                    _ -> {}
                }
            }
        }
        _ -> {}
    }

    // Emit a builder FUNCTION `fn <inst>() -> App { … }` rather than a
    // top-level `let <inst> = App { … }`: a top-level let bound to a
    // struct is mis-typed at a later top-level method call (design §
    // "Non-goals" line 14 — top-level template instances aren't values).
    // Built + returned inside function scope, the App dispatches
    // correctly (proven). Consumers call `<inst>()` to get the App, then
    // `.dispatch(parsed)`.
    let empty_vt: List<ValueType> = []
    let empty_tp2: List<TypeParamEntry> = []
    let empty_pe: List<ParamEntry> = []
    let app_vt = ValueType.Struct("App", empty_vt, 0)

    // Body stmt 1: let cmds: List<dyn Runnable> = [Command_<c> { name:
    // "<c>" }, …]  (the 966j-workaround typed local that boxes each elem).
    mut elems: List<ExprId> = []
    for cn in cmd_names {
        let tn = "Command_" + cn
        let name_init = FieldInit { name: "name", value_id: synth_expr_id(Expr.String("\"" + cn + "\"")) }
        elems.push(synth_expr_id(Expr.StructLit(tn, [name_init])))
    }
    let dyn_run = ValueType.Trait("Runnable", 0)
    let cmds_let = Stmt.Let("cmds", ValueType.List(dyn_run), synth_expr_id(Expr.ListLit(elems)))

    // Body stmt 2: return App { name: "<inst>", description: "",
    //                           version: "", commands: cmds }
    let f_name = FieldInit { name: "name", value_id: synth_expr_id(Expr.String("\"" + inst + "\"")) }
    let f_desc = FieldInit { name: "description", value_id: synth_expr_id(Expr.String("\"\"")) }
    let f_ver = FieldInit { name: "version", value_id: synth_expr_id(Expr.String("\"\"")) }
    let f_cmds = FieldInit { name: "commands", value_id: synth_expr_id(Expr.Ident("cmds")) }
    let app_lit = synth_expr_id(Expr.StructLit("App", [f_name, f_desc, f_ver, f_cmds]))
    let ret = Stmt.Return(app_lit)

    let builder = Stmt.Function(inst, empty_tp2, empty_pe, app_vt, synth_stmt_ids([cmds_let, ret]))
    out.push(builder)

    out
}
