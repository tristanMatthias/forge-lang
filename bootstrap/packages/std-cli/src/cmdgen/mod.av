// WHY: the @comptime macro that expands a `command <inst> { fn run(...)
// { ... } }` component instance into a per-instance `type Command_<inst>`
// plus a `Runnable` trait impl, so a cli's `List<dyn Runnable>` dispatch
// can call it. This is the load-bearing per-instance trait-impl
// generation the whole Components V2 declarative layer is built on.
//
// Built by DIRECT AST construction, NOT the design's §4.2 quote-splice
// form: repeating statement-splice (`~body`) and computed-value splice
// both hit F4006, and calling two sequential list-building @comptime
// helpers hits F4005 (the comptime-foundation gaps, rmzs). Direct
// construction (the derive_walker pattern — Stmt.Function/Impl/TypeDecl
// + synth_stmt_ids) plus reading the instance in a SINGLE body-walk
// sidestep all three. `Stmt.Impl` encodes a trait impl as the
// "Trait:Type" name form the parser uses.
//
// SCOPE: generates `type Command_<inst>` + `impl Runnable for
// Command_<inst>` with name()/run(). The run body is the accessor
// bindings — the command's own `flag x {}` / `arg y {}` children plus
// the parent cli's global flags (a `flag x {}` → `let x =
// @std::cli::result_has_flag(args, "x")`, an `arg y {}` → `let y =
// @std::cli::result_get_arg(args, "y")`, callees emitted fully qualified
// so they resolve without the consumer importing them) — followed by the
// user's run body verbatim. These macros ship as exported @comptime fns;
// consumers / tests attach them via `@expand` themselves rather than the
// lib pre-registering `@expand(expand_command) component command`,
// because packages/cli/src/main.av still declares `component command`
// inline and a lib registration would double-register (that migration is
// its own follow-up). Config fields (`description` on the generated type,
// from the block's `config` pairs) are the remaining gap to full design
// §4.2 parity.
//
// Directory-as-module (g2eo.1): exports surface at @std.cli.cmdgen.{...}.

use @std.avrac.core.{Stmt, Expr, ExprId, ValueType, ParamEntry, TypeParamEntry, FieldEntry, FieldInit, CompConfigPair}
use @std.avrac.features.comptime.{synth_deref_stmt, synth_stmt_ids, synth_expr_id}

/// The `value` expr of the `key` config pair (`description "…"` →
/// key="description"), re-emitted as an ExprId ready to splice into a
/// field init; an empty-string literal when the key is absent. Config
/// pairs live in `ComponentBlock.config`; a pair's value is a parser-form
/// Expr that round-trips intact through the macro boundary.
@comptime
fn config_value_or_empty(config: List<CompConfigPair>, key: string) -> ExprId {
    for pair in config {
        if pair.key == key { return synth_expr_id(pair.value) }
    }
    synth_expr_id(Expr.String("\"\""))
}

/// One accessor binding: `let <name>: <vtype> = <callee_fqn>(args,
/// "<name>")`. Shared by flags (result_has_flag / bool), args
/// (result_get_arg / string), and inherited global flags. The callee is
/// fully qualified so the generated run body resolves in ANY consumer's
/// scope — a library macro must not require the consumer to import
/// std-cli's internal helpers. The string literal carries its delimiting
/// quotes (the parser's Expr.String convention). The binding is
/// intentionally NOT hygienically renamed — the user run body references
/// it by its declared name.
@comptime
fn accessor_binding(name: string, callee_fqn: string, vtype: ValueType) -> Stmt {
    let callee = synth_expr_id(Expr.QualifiedIdent(callee_fqn))
    let a_arg = synth_expr_id(Expr.Ident("args"))
    let a_name = synth_expr_id(Expr.String("\"" + name + "\""))
    let call = synth_expr_id(Expr.Call(callee, [a_arg, a_name]))
    Stmt.Let(name, vtype, call)
}

/// True iff `name` occurs in `names`.
@comptime
fn name_in(names: List<string>, name: string) -> bool {
    for n in names {
        if n == name { return true }
    }
    false
}

/// A `return [<names as string literals>]` statement — the body of a
/// generated `flag_names()` / `arg_names()` accessor. Each name becomes
/// an `Expr.String` (carrying its delimiting quotes, the parser's
/// convention) inside an `Expr.ListLit`, so the schema `App.run` parses
/// against is baked from the declared children at expansion time.
@comptime
fn string_list_return(names: List<string>) -> Stmt {
    mut elems: List<ExprId> = []
    for n in names {
        elems.push(synth_expr_id(Expr.String("\"" + n + "\"")))
    }
    Stmt.Return(synth_expr_id(Expr.ListLit(elems)))
}

/// Core command-decl generation, shared by expand_command (standalone)
/// and expand_cli. `extra_flags` are inherited global-flag names (the
/// parent cli's flags — design §4.2 parent_chain_flags); each is bound
/// in the run body too, UNLESS it collides with one of the command's own
/// flag/arg names (then the command-local binding wins, no duplicate
/// `let`). Single body-walk (calling several list-returning @comptime
/// helpers in sequence trips the evaluator — rmzs gap 3 — so the
/// traversal is inlined rather than reusing comp_children).
@comptime
fn build_command_decls(s: Stmt, extra_flags: List<string>) -> List<Stmt> {
    mut inst = ""
    mut run_body: List<Stmt> = []
    mut flag_names: List<string> = []
    mut arg_names: List<string> = []
    match s {
        .ComponentBlock(_, instance, _, body) -> {
            inst = instance
            for id in body {
                let child = synth_deref_stmt(id)
                match child {
                    .Function(fname, _, _, _, fbody) -> {
                        if fname == "run" {
                            for bid in fbody {
                                run_body.push(synth_deref_stmt(bid))
                            }
                        }
                    }
                    .ComponentBlock(cn, cinst, _, _) -> {
                        if cn == "flag" { flag_names.push(cinst) }
                        if cn == "arg" { arg_names.push(cinst) }
                    }
                    _ -> {}
                }
            }
        }
        _ -> {}
    }

    let tn = "Command_" + inst
    let empty_vt: List<ValueType> = []
    let empty_tp: List<TypeParamEntry> = []
    let self_ty = ValueType.Struct(tn, empty_vt, 0)
    let cli_ty = ValueType.Struct("CliResult", empty_vt, 0)
    let self_p = ParamEntry { name: "self", vtype: self_ty }

    // fn name(self) -> string { return self.name }
    let ret_name = Stmt.Return(synth_expr_id(Expr.FieldAccess(synth_expr_id(Expr.Ident("self")), "name")))
    let name_fn = Stmt.Function("name", empty_tp, [self_p], ValueType.Str, synth_stmt_ids([ret_name]))

    // fn run(self, args: CliResult) -> int {
    //   <inherited global-flag bindings> <flag bindings> <arg bindings>
    //   <user run body>
    // }
    let args_p = ParamEntry { name: "args", vtype: cli_ty }
    mut full_run: List<Stmt> = []
    for gname in extra_flags {
        if !name_in(flag_names, gname) && !name_in(arg_names, gname) {
            full_run.push(accessor_binding(gname, "@std::cli::result_has_flag", ValueType.Bool))
        }
    }
    for fname in flag_names {
        full_run.push(accessor_binding(fname, "@std::cli::result_has_flag", ValueType.Bool))
    }
    for aname in arg_names {
        full_run.push(accessor_binding(aname, "@std::cli::result_get_arg", ValueType.Str))
    }
    for st in run_body { full_run.push(st) }
    let run_fn = Stmt.Function("run", empty_tp, [self_p, args_p], ValueType.Int, synth_stmt_ids(full_run))

    // Schema accessors so App.run can parse raw argv against this command
    // through its `dyn Runnable` box: flag_names() = own flags + inherited
    // globals (deduped, the same set the run bindings use); arg_names() =
    // positionals in declaration order; description() reads the stamped
    // field. The name lists are baked as string literals at expansion.
    mut all_flag_names: List<string> = []
    for gname in extra_flags {
        if !name_in(flag_names, gname) && !name_in(arg_names, gname) {
            all_flag_names.push(gname)
        }
    }
    for fname in flag_names { all_flag_names.push(fname) }
    let str_list_vt = ValueType.List(ValueType.Str)
    let flag_names_fn = Stmt.Function("flag_names", empty_tp, [self_p], str_list_vt, synth_stmt_ids([string_list_return(all_flag_names)]))
    let arg_names_fn = Stmt.Function("arg_names", empty_tp, [self_p], str_list_vt, synth_stmt_ids([string_list_return(arg_names)]))
    let ret_desc = Stmt.Return(synth_expr_id(Expr.FieldAccess(synth_expr_id(Expr.Ident("self")), "description")))
    let description_fn = Stmt.Function("description", empty_tp, [self_p], ValueType.Str, synth_stmt_ids([ret_desc]))

    // impl Runnable for Command_<inst> { name; run; flag_names; arg_names;
    // description }  ("Trait:Type" form)
    let impl_stmt = Stmt.Impl("Runnable:" + tn, synth_stmt_ids([name_fn, run_fn, flag_names_fn, arg_names_fn, description_fn]))

    // type Command_<inst> = { name: string, description: string }
    // (`description` carries the block's `description "…"` config; the
    // instance is stamped with the value in expand_cli's builder.)
    let name_field = FieldEntry { name: "name", resolved: ValueType.Str }
    let desc_field = FieldEntry { name: "description", resolved: ValueType.Str }
    let type_decl = Stmt.TypeDecl(tn, empty_tp, [name_field, desc_field])

    return [type_decl, impl_stmt]
}

/// Expand a standalone `command <inst> { flag…/arg… fn run(args:
/// CliResult) -> int { … } }` instance into `[type Command_<inst>, impl
/// Runnable for Command_<inst>]` — the `@expand(expand_command)` entry
/// point. Delegates to build_command_decls with no inherited global
/// flags; only expand_cli threads a parent cli's globals into a command.
@comptime
export fn expand_command(s: Stmt) -> List<Stmt> {
    let no_globals: List<string> = []
    return build_command_decls(s, no_globals)
}

/// Expand a `cli <inst> { command <c> { … } … }` instance into the
/// per-command `type Command_<c>` + `impl Runnable for Command_<c>`
/// decls (delegating to expand_command per command) plus a top-level
/// `let <inst> = App { … }` wiring the commands as `dyn Runnable` boxes.
/// Consumers reference `<inst>` directly, then `.dispatch(parsed)` to run
/// the matched command — the shape design §4.3 prescribes (`let avra =
/// Cli { … }` / `avra.dispatch(…)`).
///
/// A top-level `let` (design §4.3), not a builder fn: an unannotated
/// top-level struct let is now inferred at declare time (m8s8) and
/// initialises before `main` reads it, so a later `<inst>.dispatch(…)`
/// resolves and dispatches correctly (verified end-to-end). The command
/// struct literals are spliced inline into the `App`'s `List<dyn
/// Runnable>` field, boxing to `dyn Runnable` at the field init. A `flag
/// <g> {}` declared directly in the cli block is a GLOBAL flag, inherited
/// into every command's run bindings (design §4.2 parent_chain_flags).
/// Each command's `description "…"` config is stamped onto its instance
/// (`Command_<c> { name, description }`).
@comptime
export fn expand_cli(s: Stmt) -> List<Stmt> {
    mut inst = ""
    mut out: List<Stmt> = []
    mut cmd_names: List<string> = []
    mut global_flags: List<string> = []
    mut cmd_children: List<Stmt> = []
    mut cmd_descs: List<ExprId> = []
    mut app_desc = synth_expr_id(Expr.String("\"\""))
    mut app_ver = synth_expr_id(Expr.String("\"\""))
    // Pass 1: collect the cli's own description/version config, its global
    // flags, AND its command children, reading each command's `description`
    // config alongside its name so the two lists stay index-aligned.
    // Globals must be known before any command is generated, so command
    // generation waits for pass 2.
    match s {
        .ComponentBlock(_, instance, cliconfig, body) -> {
            inst = instance
            app_desc = config_value_or_empty(cliconfig, "description")
            app_ver = config_value_or_empty(cliconfig, "version")
            for id in body {
                let child = synth_deref_stmt(id)
                match child {
                    .ComponentBlock(cn, cinst, cconfig, _) -> {
                        if cn == "command" {
                            cmd_children.push(child)
                            cmd_names.push(cinst)
                            cmd_descs.push(config_value_or_empty(cconfig, "description"))
                        }
                        if cn == "flag" { global_flags.push(cinst) }
                    }
                    _ -> {}
                }
            }
        }
        _ -> {}
    }
    // Pass 2: generate each command's decls, inheriting the global flags.
    for child in cmd_children {
        let decls = build_command_decls(child, global_flags)
        for d in decls { out.push(d) }
    }

    // Emit a top-level `let <inst> = App { … }` (design §4.3), not a
    // builder fn. An unannotated top-level struct let is inferred at
    // declare time (m8s8) and initialises before `main` reads it, so a
    // later `<inst>.dispatch(…)` resolves + dispatches (verified). The
    // command struct literals are spliced INLINE into the `List<dyn
    // Runnable>` field — each boxes to `dyn Runnable` at the field init.
    // (This once needed a pre-boxed typed local because a `List<dyn
    // Trait>` struct field didn't box its inline elements; that codegen
    // bug, 966j, is now fixed upstream, so the inline form suffices.)
    let empty_vt: List<ValueType> = []
    let app_vt = ValueType.Struct("App", empty_vt, 0)

    mut elems: List<ExprId> = []
    mut ci = 0
    while ci < cmd_names.length {
        let cn = cmd_names[ci]
        let tn = "Command_" + cn
        let name_init = FieldInit { name: "name", value_id: synth_expr_id(Expr.String("\"" + cn + "\"")) }
        let desc_init = FieldInit { name: "description", value_id: cmd_descs[ci] }
        elems.push(synth_expr_id(Expr.StructLit(tn, [name_init, desc_init])))
        ci = ci + 1
    }
    let f_name = FieldInit { name: "name", value_id: synth_expr_id(Expr.String("\"" + inst + "\"")) }
    let f_desc = FieldInit { name: "description", value_id: app_desc }
    let f_ver = FieldInit { name: "version", value_id: app_ver }
    let f_cmds = FieldInit { name: "commands", value_id: synth_expr_id(Expr.ListLit(elems)) }
    let app_lit = synth_expr_id(Expr.StructLit("App", [f_name, f_desc, f_ver, f_cmds]))
    out.push(Stmt.Let(inst, app_vt, app_lit))

    out
}
