// Templates with expressions inside ${}
let x = 42
println(`the answer is ${string(x)}`)

// Arithmetic in template
let a = 3
let b = 4
println(`${string(a)} + ${string(b)} = ${string(a + b)}`)

// Field access in template
type Point = { x: int, y: int }
let p = Point { x: 10, y: 20 }
println(`point: ${string(p.x)}, ${string(p.y)}`)

// Function call in template
fn double(n: int) -> int { n * 2 }
println(`double 5 = ${string(double(5))}`)

// Bare variable (should still work)
let name = "world"
println(`hello ${name}`)
