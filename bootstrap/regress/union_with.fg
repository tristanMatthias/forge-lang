/// expect: updated
/// expect: first
/// expect: str:hello
/// expect: second
/// expect: a str: hello
/// expect: b bool: 1

type Box = { val: int | string, label: string }
type Multi = { a: int | string, b: int | bool }

fn main() {
    // with override on union field
    let c1 = Box { val: 42, label: "first" }
    let c2 = c1 with { val: "updated" }
    match c2.val {
        int(n) -> println(string(n))
        string(s) -> println(s)
    }
    println(c2.label)

    // with preserves union field when not overridden
    let b1 = Box { val: "hello", label: "first" }
    let b2 = b1 with { label: "second" }
    match b2.val {
        int(n) -> println("int:" + string(n))
        string(s) -> println("str:" + s)
    }
    println(b2.label)

    // multiple union fields in struct
    let m = Multi { a: "hello", b: true }
    match m.a {
        int(n) -> println("a int")
        string(s) -> println("a str: " + s)
    }
    match m.b {
        int(n) -> println("b int")
        bool(v) -> println("b bool: " + string(v))
    }
}
