enum Color { Red, Green, Blue }

type Box = {
    color: Color,
}

fn check(c: Color, expected: Color) -> bool {
    c == expected
}

fn main() {
    let b = Box { color: Color.Green }

    // Direct comparison
    if Color.Red == Color.Red { println("direct: ok") } else { println("direct: FAIL") }
    if Color.Red == Color.Green { println("direct neq: FAIL") } else { println("direct neq: ok") }

    // Struct field comparison
    if b.color == Color.Green { println("field: ok") } else { println("field: FAIL") }
    if b.color == Color.Red { println("field neq: FAIL") } else { println("field neq: ok") }

    // Via function parameter
    if check(b.color, Color.Green) { println("fn: ok") } else { println("fn: FAIL") }
    if check(Color.Red, Color.Red) { println("fn direct: ok") } else { println("fn direct: FAIL") }
}
