// Regression: closures returned through functions must preserve Closure type.
// TECH_DEBT item 27: vtype_is_closure must return true for the return value
// so the call site routes through the closure-aware path.
fn make_adder(n: int) -> fn(int) -> int {
    (x) -> x + n
}

fn main() {
    let add5 = make_adder(5)
    println(string(add5(10)))
    let add100 = make_adder(100)
    println(string(add100(42)))
}
