// Aggressive trait tests — combined with every other feature.

trait Stringable {
    fn to_str(self) -> string
}

trait Sizeable {
    fn size(self) -> int
}

// Struct with multiple trait impls
type Box = { width: int, height: int, label: string }

impl Stringable for Box {
    fn to_str(self) -> string {
        self.label + " (" + string(self.width) + "x" + string(self.height) + ")"
    }
}

impl Sizeable for Box {
    fn size(self) -> int {
        self.width * self.height
    }
}

// Trait + enum
enum Shape {
    Rect(w: int, h: int)
    Circle(r: int)
}

impl Stringable for Shape {
    fn to_str(self) -> string {
        match self {
            .Rect(w, h) -> "rect " + string(w) + "x" + string(h)
            .Circle(r) -> "circle r=" + string(r)
        }
    }
}

// Trait + closures (method returns a closure)
type Counter = { start: int }

impl Counter {
    fn make_counter(self) -> fn(int) -> int {
        let base = self.start
        (n) -> n + base
    }
}

// Trait + with expression
impl Box {
    fn resize(self, w: int, h: int) -> Box {
        self with { width: w, height: h }
    }
}

// Trait + nullable
type MaybeBox = { inner: Box? }

// Trait + is keyword
fn is_big(b: Box) -> bool {
    b.size() > 50
}

// Trait + match
fn describe_shape(s: Shape) -> string {
    if s is .Circle {
        s.to_str() + " (round)"
    } else {
        s.to_str() + " (angular)"
    }
}

// Trait + list (element type limitation: list[i] returns Int, not Box.
// Work around with explicit indexing into a known-typed variable.)
fn sum_two_boxes(a: Box, b: Box) -> int {
    a.size() + b.size()
}

// Trait + pipe
fn box_to_str(b: Box) -> string { b.to_str() }

fn main() {
    let b = Box { width: 10, height: 5, label: "main" }

    // Basic trait methods
    println(b.to_str())
    println(string(b.size()))

    // With expression preserves trait methods
    let b2 = b.resize(20, 3)
    println(b2.to_str())
    println(string(b2.size()))

    // Enum trait
    let s1 = Shape.Rect(4, 6)
    let s2 = Shape.Circle(3)
    println(s1.to_str())
    println(s2.to_str())

    // Is keyword with trait method
    println(string(is_big(b)))
    println(string(is_big(Box { width: 2, height: 2, label: "tiny" })))

    // Match + trait
    println(describe_shape(s1))
    println(describe_shape(s2))

    // Closure from method
    let c = Counter { start: 100 }
    let add = c.make_counter()
    println(string(add(5)))

    // Two boxes with trait
    let a = Box { width: 3, height: 4, label: "a" }
    let b3 = Box { width: 5, height: 6, label: "b" }
    println(string(sum_two_boxes(a, b3)))

    // Pipe + trait
    println(b |> box_to_str)

    // Template + trait
    println(`box: ${b.to_str()}, size: ${string(b.size())}`)
}
