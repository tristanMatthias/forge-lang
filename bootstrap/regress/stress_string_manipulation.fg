/// expect: fizzbuzz: 1 2 fizz 4 buzz fizz 7 8 fizz buzz 11 fizz 13 14 fizzbuzz
/// expect: reversed: !dlrow ,olleH
/// expect: words: 3
/// expect: palindrome: 1

fn fizzbuzz(n: int) -> string {
    mut result = ""
    for i in 1..n + 1 {
        let s = when {
            i % 15 == 0 -> "fizzbuzz"
            i % 3 == 0 -> "fizz"
            i % 5 == 0 -> "buzz"
            _ -> string(i)
        }
        if result == "" { result = s } else { result = result + " " + s }
    }
    result
}

fn is_palindrome(s: string) -> bool {
    s == s.reverse()
}

fn count_words(s: string) -> int {
    s.split(" ").length
}

fn main() {
    println("fizzbuzz: ${fizzbuzz(15)}")
    println("reversed: ${"Hello, world!".reverse()}")
    println("words: ${string(count_words("one two three"))}")
    println("palindrome: ${string(is_palindrome("racecar"))}")
}
