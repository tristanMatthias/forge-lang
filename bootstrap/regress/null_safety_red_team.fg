/// expect: found: 20
/// expect: fallback: -1
/// expect: chained: hello
/// expect: chained null: default
/// expect: propagated: 42
/// expect: propagated null: -1

fn find_val(items: List<int>, target: int) -> int? {
    for i in 0..items.length {
        if items.get(i) == target { return items.get(i) }
    }
    null
}

type Config = { port: int }

fn get_config(valid: bool) -> Config? {
    if valid { Config { port: 8080 } } else { null }
}

fn try_port(valid: bool) -> int? {
    let cfg = get_config(valid)?
    cfg.port
}

fn main() {
    // Basic nullable
    let r = find_val([10, 20, 30], 20)
    if r != null { println("found: ${string(r!)}") }

    // Null coalesce
    let r2 = find_val([10, 20, 30], 99)
    let v = r2 ?? -1
    println("fallback: ${string(v)}")

    // Optional chain simulation — function returning nullable
    let cfg = get_config(true)
    if cfg != null { println("chained: hello") }
    let cfg2 = get_config(false)
    let msg = if cfg2 != null { "exists" } else { "default" }
    println("chained null: ${msg}")

    // ? propagation on nullable
    let port = try_port(true)
    println("propagated: ${string(port ?? 0)}")
    let port2 = try_port(false)
    println("propagated null: ${string(port2 ?? -1)}")
}
