/// expect: error: file not found
/// expect: kind: io
/// expect: error: invalid input
/// expect: kind: parse

trait Error {
    fn message(self) -> string
    fn kind(self) -> string
}

type IoError = { msg: string, path: string }
type ParseError = { msg: string, line: int }

impl Error for IoError {
    fn message(self) -> string { self.msg }
    fn kind(self) -> string { "io" }
}

impl Error for ParseError {
    fn message(self) -> string { self.msg }
    fn kind(self) -> string { "parse" }
}

fn describe_error(e: Error) {
    println("error: " + e.message())
    println("kind: " + e.kind())
}

fn main() {
    describe_error(IoError { msg: "file not found", path: "/tmp/x" })
    describe_error(ParseError { msg: "invalid input", line: 42 })
}
