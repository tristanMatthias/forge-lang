// Test ALL comparison operators
let a = 10
let b = 20

// ==, !=
println(string(a == b))
println(string(a != b))
println(string(a == 10))

// <, <=, >, >=
println(string(a < b))
println(string(a <= b))
println(string(a > b))
println(string(a >= b))
println(string(a <= 10))
println(string(a >= 10))

// String comparisons
println(string("abc" == "abc"))
println(string("abc" != "def"))
println(string("abc" < "def"))
