/// expect: 42
/// expect: hello
/// expect: implicit: world
/// expect: mut int: 10
/// expect: mut string: reassigned
/// expect: struct field: 99

fn make(flag: bool) -> int | string {
    if flag {
        return 42
    }
    return "hello"
}

fn implicit_return() -> int | string {
    "world"
}

type Wrapper = {
    val: int | string,
}

fn main() {
    // Explicit return from union-typed function
    match make(true) {
        int(n) -> println(string(n))
        string(s) -> println(s)
    }
    match make(false) {
        int(n) -> println(string(n))
        string(s) -> println(s)
    }

    // Implicit return
    match implicit_return() {
        int(n) -> println("implicit: " + string(n))
        string(s) -> println("implicit: " + s)
    }

    // Mutable union reassignment
    mut u: int | string = 10
    match u {
        int(n) -> println("mut int: " + string(n))
        string(s) -> println("mut string: " + s)
    }
    u = "reassigned"
    match u {
        int(n) -> println("mut int: " + string(n))
        string(s) -> println("mut string: " + s)
    }

    // Union in struct field
    let w = Wrapper { val: 99 }
    match w.val {
        int(n) -> println("struct field: " + string(n))
        string(s) -> println("struct field: " + s)
    }
}
