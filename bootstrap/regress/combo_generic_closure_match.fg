/// expect: doubled: [2, 4, 6]
/// expect: error propagated
/// expect: filtered: [2, 4]
/// expect: chained: 30

enum Result<T, E> { Ok(value: T), Err(error: E) }

fn try_parse(s: string) -> Result<int, string> {
    if s == "bad" { return Result.Err("parse failed") }
    Result.Ok(s.length)
}

fn process(input: string) -> Result<string, string> {
    let len = try_parse(input)?
    Result.Ok("length: ${string(len)}")
}

fn main() {
    // Generic list methods + closure
    let nums = [1, 2, 3]
    let doubled = nums.map((x) -> x * 2)
    println("doubled: [${string(doubled.get(0))}, ${string(doubled.get(1))}, ${string(doubled.get(2))}]")

    // Result + ? propagation + match
    match process("bad") {
        .Ok(v) -> println(v)
        .Err(e) -> println("error propagated")
    }

    // Closure + filter
    let evens = [1, 2, 3, 4, 5].filter((x) -> x % 2 == 0)
    println("filtered: [${string(evens.get(0))}, ${string(evens.get(1))}]")

    // Chained: map + filter + reduce
    let result = [1, 2, 3, 4, 5]
        .map((x) -> x * 2)
        .filter((x) -> x > 4)
        .reduce(0, (acc, x) -> acc + x)
    println("chained: ${string(result)}")
}
