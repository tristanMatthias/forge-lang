// Ptr arithmetic, indexing, and byte read/write.

extern fn malloc(size: int) -> ptr
extern fn free(p: ptr)
extern fn forge_ptr_store_byte(p: ptr, offset: int, val: int)

fn main() {
    let buf: ptr = malloc(32)

    // Write "Hello" as bytes
    forge_ptr_store_byte(buf, 0, 72)   // H
    forge_ptr_store_byte(buf, 1, 101)  // e
    forge_ptr_store_byte(buf, 2, 108)  // l
    forge_ptr_store_byte(buf, 3, 108)  // l
    forge_ptr_store_byte(buf, 4, 111)  // o
    forge_ptr_store_byte(buf, 5, 0)    // null

    // Read bytes via indexing
    println(string(buf[0]))
    println(string(buf[4]))

    // Ptr arithmetic: offset then read
    let third: ptr = buf + 2
    println(string(third[0]))

    // Print as C string
    println(buf)

    // Ptr subtraction
    let end: ptr = buf + 5
    let diff = end - buf
    println(string(diff))

    free(buf)
}
