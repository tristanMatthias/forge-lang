/// expect: 42
/// expect: propagated: division by zero
/// expect: chained: 100

// Verify `?` works on Result enum: Ok(value) unwraps, Err(msg) propagates.

enum Result { Ok(value: int), Err(error: string) }

fn divide(a: int, b: int) -> Result {
    if b == 0 { return Result.Err("division by zero") }
    Result.Ok(a / b)
}

fn compute_ok() -> Result {
    let x = divide(84, 2)?
    Result.Ok(x)
}

fn compute_fail() -> Result {
    let x = divide(10, 0)?
    // Should never reach here — divide returns Err, ? propagates it.
    Result.Ok(x + 999)
}

fn chained() -> Result {
    let a = divide(200, 2)?
    let b = divide(a, 1)?
    Result.Ok(b)
}

fn main() {
    match compute_ok() {
        .Ok(v) -> println(string(v))
        .Err(e) -> println("error: ${e}")
    }

    match compute_fail() {
        .Ok(v) -> println(string(v))
        .Err(e) -> println("propagated: ${e}")
    }

    match chained() {
        .Ok(v) -> println("chained: ${string(v)}")
        .Err(e) -> println("chained error: ${e}")
    }
}
