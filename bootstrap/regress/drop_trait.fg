// Drop trait: user-defined destructor called in LIFO order
/// expect: creating r1
/// expect: creating r2
/// expect: dropping Resource 2
/// expect: dropping Resource 1

type Resource = { id: int }

impl Resource {
    fn drop(self) {
        println("dropping Resource " + string(self.id))
    }
}

fn main() {
    let r1 = Resource { id: 1 }
    println("creating r1")
    let r2 = Resource { id: 2 }
    println("creating r2")
}
