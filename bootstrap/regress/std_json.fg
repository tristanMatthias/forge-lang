// @std/json — JSON stringify and parse operations.

extern fn forge_json_stringify_int(value: int) -> string
extern fn forge_json_stringify_string(s: string) -> string
extern fn forge_json_stringify_bool(value: bool) -> string
extern fn forge_json_get_int(json: string, key: string) -> int
extern fn forge_json_get_string(json: string, key: string) -> string
extern fn forge_json_get_bool(json: string, key: string) -> bool

fn main() {
    // Stringify primitives
    println(forge_json_stringify_int(0))
    println(forge_json_stringify_int(-42))
    println(forge_json_stringify_string(""))
    println(forge_json_stringify_string("with spaces"))
    println(forge_json_stringify_bool(true))
    println(forge_json_stringify_bool(false))

    // Parse object fields
    let obj = "{\"x\": 100, \"y\": -5, \"name\": \"test\", \"ok\": false}"
    println(string(forge_json_get_int(obj, "x")))
    println(string(forge_json_get_int(obj, "y")))
    println(forge_json_get_string(obj, "name"))
    println(string(forge_json_get_bool(obj, "ok")))

    // Escape handling
    println(forge_json_stringify_string("line\none"))
    println(forge_json_stringify_string("tab\there"))
}
