/// expect: Hello user alice
/// expect: alice
/// expect: 42
/// expect: inner int: 42

type UserId = string
type Meters = int

fn greet(uid: UserId) -> string {
    "Hello user " + uid.raw()
}

fn main() {
    // Construction and .raw() access
    let uid = UserId("alice")
    println(greet(uid))
    println(uid.raw())

    // Int-based newtype
    let dist = Meters(42)
    println(string(dist.raw()))

    // Newtype preserves inner value at runtime (zero-cost)
    let m = Meters(42)
    match m.raw() {
        _ -> println("inner int: " + string(m.raw()))
    }
}
