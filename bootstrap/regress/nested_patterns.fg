// Nested pattern matching — destructure inner enum variants.

enum Inner {
    A(x: int)
    B(msg: string)
}

enum Outer {
    Wrap(inner: Inner)
    Empty
}

enum Result {
    Ok(value: int)
    Err(msg: string)
}

enum Maybe {
    Some(inner: Result)
    None
}

fn describe(m: Maybe) -> string {
    match m {
        .Some(.Ok(v)) -> "ok: " + string(v)
        .Some(.Err(msg)) -> "err: " + msg
        .None -> "nothing"
    }
}

fn main() {
    // Basic nested pattern
    let val = Outer.Wrap(Inner.A(42))
    match val {
        .Wrap(.A(x)) -> println(string(x))
        .Wrap(.B(msg)) -> println(msg)
        .Empty -> println("empty")
    }

    // Second variant
    let val2 = Outer.Wrap(Inner.B("hello"))
    match val2 {
        .Wrap(.A(n)) -> println(string(n))
        .Wrap(.B(s)) -> println(s)
        .Empty -> println("empty")
    }

    // Nested in function
    println(describe(Maybe.Some(Result.Ok(99))))
    println(describe(Maybe.Some(Result.Err("oops"))))
    println(describe(Maybe.None))
}
