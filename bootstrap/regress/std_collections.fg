// @std/collections — comprehensive list and map operations.

fn main() {
    // === List operations ===
    mut nums = [10, 20, 30, 40, 50]
    println(string(nums.length))

    // Index access
    println(string(nums[0]))
    println(string(nums[4]))

    // Push and pop
    nums.push(60)
    println(string(nums.length))
    let popped = nums.pop()
    println(string(popped))
    println(string(nums.length))

    // Slice
    let sliced = nums.slice(1, 3)
    println(string(sliced.length))
    println(string(sliced[0]))
    println(string(sliced[1]))

    // Map (higher-order)
    let doubled = nums.map((x) -> x * 2)
    println(string(doubled[0]))
    println(string(doubled[1]))

    // Filter
    let big = nums.filter((x) -> x > 25)
    println(string(big.length))
    println(string(big[0]))

    // Reduce
    let sum = nums.reduce(0, (acc, x) -> acc + x)
    println(string(sum))

    // Foreach (verify it runs without error)
    nums.foreach((x) -> { println(string(x)) })

    // === Map operations ===
    mut m = {"name": "Alice", "city": "NYC"}
    println(string(m.length))
    println(m.get("name"))
    println(string(m.has("city")))
    println(string(m.has("age")))

    // Set
    m.set("age", "30")
    println(string(m.length))
    println(m.get("age"))

    // Keys
    let k = m.keys()
    println(string(k.length))

    // Empty map
    let empty = {}
    println(string(empty.length))
    println(string(empty.has("x")))
}
