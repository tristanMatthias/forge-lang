/// expect: non_escape=45
/// expect: escape_ok=90

// Test that arena detection correctly handles escaping vs non-escaping.
// When a struct value escapes (e.g., stored in a list), it must NOT
// be arena-allocated.

type Vec2 = { x: int, y: int }

fn use_vec(v: Vec2) -> int {
    v.x + v.y
}

fn main() {
    // Non-escaping: struct only used for field access (arena-eligible)
    mut sum = 0
    for i in 0..10 {
        let v = Vec2 { x: i, y: i }
        sum = sum + v.x
    }
    println("non_escape=${sum}")

    // Escaping: struct passed as argument (NOT arena-eligible)
    mut total = 0
    for i in 0..10 {
        let v = Vec2 { x: i, y: i }
        total = total + use_vec(v)
    }
    println("escape_ok=${total}")
}
