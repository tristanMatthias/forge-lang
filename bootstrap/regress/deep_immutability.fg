/// expect: 42
/// expect: updated: 99

type Point = { x: int, y: int }

fn main() {
    // Immutable binding — reading works
    let p = Point { x: 42, y: 0 }
    println(string(p.x))
    
    // Mutable binding — field assignment works
    mut q = Point { x: 1, y: 2 }
    q.x = 99
    println("updated: " + string(q.x))
}
