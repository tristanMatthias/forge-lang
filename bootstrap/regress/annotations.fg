// Test: annotations are parsed and don't affect execution.

@test
fn greet(name: string) -> string {
    "hello " + name
}

@deprecated("use greet2 instead")
fn greet_old(name: string) -> string {
    "hi " + name
}

@primary
@auto_increment
type User = {
    id: int,
    name: string,
}

fn main() {
    println(greet("world"))
    println(greet_old("world"))
    let u = User { id: 1, name: "Alice" }
    println(u.name)
    println(string(u.id))
}
