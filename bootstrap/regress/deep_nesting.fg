// Deep nesting stress test
fn deep_if(n: int) -> int {
    if n > 10 {
        if n > 20 {
            if n > 30 {
                if n > 40 {
                    if n > 50 {
                        return 5
                    }
                    return 4
                }
                return 3
            }
            return 2
        }
        return 1
    }
    0
}

println(string(deep_if(5)))
println(string(deep_if(15)))
println(string(deep_if(25)))
println(string(deep_if(35)))
println(string(deep_if(45)))
println(string(deep_if(55)))
