/// expect: C:\Users\alice\file.txt
/// expect: \d{3}-\d{4}
/// expect: ---
/// expect: raw content
/// expect: \n is literal
/// expect: ${not interpolation}
fn main() {
    let path = r"C:\Users\alice\file.txt"
    println(path)
    let regex = r"\d{3}-\d{4}"
    println(regex)
    println("---")
    let multi = r"""
        raw content
        \n is literal
        ${not interpolation}
        """
    println(multi)
}
