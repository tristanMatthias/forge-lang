// Concurrency: spawn, join, channels.

extern fn forge_spawn(closure: int) -> int
extern fn forge_thread_join(handle: int)
extern fn forge_channel_new() -> ptr
extern fn forge_channel_send(ch: ptr, value: int)
extern fn forge_channel_recv(ch: ptr) -> int

fn worker() {
    println("thread done")
}

mut global_ch: ptr = null
fn sender() {
    forge_channel_send(global_ch, 10)
    forge_channel_send(global_ch, 20)
    forge_channel_send(global_ch, 30)
}

fn main() {
    // Spawn + join
    let h = forge_spawn(worker)
    forge_thread_join(h)

    // Channels
    global_ch = forge_channel_new()
    let h2 = forge_spawn(sender)
    let a = forge_channel_recv(global_ch)
    let b = forge_channel_recv(global_ch)
    let c = forge_channel_recv(global_ch)
    forge_thread_join(h2)
    println(string(a + b + c))
}
