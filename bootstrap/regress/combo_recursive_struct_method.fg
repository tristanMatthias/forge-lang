// COMBO: recursive enum + impl methods + for loop + templates
enum IntList {
    Nil,
    Cons(head: int, tail: IntList),
}

impl IntList {
    fn sum(self) -> int {
        match self {
            .Nil -> 0
            .Cons(h, t) -> h + t.sum()
        }
    }

    fn to_string(self) -> string {
        match self {
            .Nil -> "[]"
            .Cons(h, t) -> {
                let rest = t.to_string()
                `${string(h)} :: ${rest}`
            }
        }
    }
}

// Build a list using a for loop
mut list = IntList.Nil
for i in 0..5 {
    // Prepend (builds 4::3::2::1::0::Nil)
    list = IntList.Cons(i, list)
}

println(list.to_string())
println(string(list.sum()))
