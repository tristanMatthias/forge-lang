/// expect: hello world!
/// expect: 2+3=5
/// expect: result: yes
/// expect: count: 42
/// expect: nested: inner
/// expect: multi: a and b
fn main() {
    // Simple variable
    let name = "world"
    println("hello ${name}!")

    // Expression
    println("2+3=${string(2 + 3)}")

    // Nested quotes with if-expression
    println("result: ${if true { "yes" } else { "no" }}")

    // Variable in expression
    let x = 42
    println("count: ${string(x)}")

    // Nested string in call
    println("nested: ${if 1 > 0 { "inner" } else { "outer" }}")

    // Multiple interpolations
    let a = "a"
    let b = "b"
    println("multi: ${a} and ${b}")
}
