fn step1(x: int) -> int? {
    if x > 0 { return x * 2 }
    null
}

fn step2(x: int) -> int? {
    if x < 100 { return x + 1 }
    null
}

fn pipeline(x: int) -> int? {
    let a = step1(x)?
    let b = step2(a)?
    b
}

// 5 -> 10 -> 11
let r1 = pipeline(5)
println(string(r1 ?? -1))

// 0 -> null (step1 fails)
let r2 = pipeline(0)
println(string(r2 ?? -1))

// 60 -> 120 -> null (step2 fails, > 100)
let r3 = pipeline(60)
println(string(r3 ?? -1))
