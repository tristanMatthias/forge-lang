/// expect: small
/// expect: medium
/// expect: big
/// expect: guarded: positive 5

enum Size { Small, Medium, Large, XLarge }

fn classify(s: Size) -> string {
    match s {
        .Small or .Medium -> {
            match s { .Small -> "small", _ -> "medium" }
        }
        .Large or .XLarge -> "big"
    }
}

fn check_guard(x: int) -> string {
    match x {
        _ if x > 0 -> "positive " + string(x)
        _ if x < 0 -> "negative " + string(x)
        _ -> "zero"
    }
}

fn main() {
    println(classify(Size.Small))
    println(classify(Size.Medium))
    println(classify(Size.Large))
    println("guarded: " + check_guard(5))
}
