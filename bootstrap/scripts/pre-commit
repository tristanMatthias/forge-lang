#!/usr/bin/env bash
# Bootstrap pre-commit hook.
#
# Runs the bootstrap spec test suite when any staged file is under
# bootstrap/ or affects bootstrap's build inputs (avra/stdlib/runtime.c,
# bootstrap/llvm_wrapper.c). Skips otherwise so commits in unrelated
# parts of the repo aren't slowed down.
#
# Install: ln -sf ../../bootstrap/scripts/pre-commit .git/hooks/pre-commit
# Skip once: git commit --no-verify  (use sparingly — that's how regressions land)

set -euo pipefail

REPO_DIR=$(git rev-parse --show-toplevel)
cd "$REPO_DIR"

# Files staged in this commit.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Trigger the spec test suite for any bootstrap-affecting change.
relevant=$(echo "$staged" | grep -E '^(bootstrap/|avra/stdlib/runtime\.c|bootstrap/llvm_wrapper.c)' || true)
if [ -z "$relevant" ]; then
  exit 0
fi

# Trigger the (heavier) self-host fixed-point check only when the
# bootstrap source itself or its build inputs change. Touching just
# test files or scripts doesn't require it.
src_relevant=$(echo "$staged" | grep -E '^(bootstrap/packages/std-avrac/src/|bootstrap/packages/cli/src/|avra/stdlib/runtime\.c|bootstrap/llvm_wrapper.c)' || true)

echo "[pre-commit] bootstrap-affecting changes detected — running spec test suite"
TEST_LOG="/tmp/avra_pre_commit_test.${PPID}.log"
# Hard timeout: kill the test suite if it runs longer than 20 min. The
# baseline is ~2min warm; ~14min cold (rebuilds the bundled binary +
# runs 2227 tests + ~30 fixtures that fork bs2). Anything past 20 min
# signals a real perf regression worth blocking. Uses perl alarm
# because macOS doesn't ship /usr/bin/timeout by default.
TEST_TIMEOUT_SEC=1200
TEST_START=$(date +%s)
perl -e 'alarm shift; exec @ARGV' "$TEST_TIMEOUT_SEC" \
     sh -c 'cd bootstrap && ./build/bs2 test' > "$TEST_LOG" 2>&1
TEST_RC=$?
TEST_ELAPSED=$(( $(date +%s) - TEST_START ))
if [ $TEST_RC -ne 0 ]; then
  echo
  if [ $TEST_ELAPSED -ge $TEST_TIMEOUT_SEC ]; then
    echo "[pre-commit] spec test suite TIMED OUT after ${TEST_ELAPSED}s (limit ${TEST_TIMEOUT_SEC}s) — commit blocked"
    echo "[pre-commit] baseline ~2min warm / ~14min cold; this run exceeded that."
    echo "[pre-commit] perf regression suspected. Inspect: $TEST_LOG"
  else
    echo "[pre-commit] spec test suite failed after ${TEST_ELAPSED}s — commit blocked"
    echo "[pre-commit] full output: $TEST_LOG"
    echo "[pre-commit] failures (excerpt):"
    grep -E "✗|Failures:|tests passed" "$TEST_LOG" | tail -25
    echo "[pre-commit] fix the regression, or 'git commit --no-verify' to bypass"
  fi
  exit 1
fi
echo "[pre-commit] spec test suite passed in ${TEST_ELAPSED}s"
rm -f "$TEST_LOG"

if [ -n "$src_relevant" ]; then
  echo "[pre-commit] bootstrap source touched — verifying self-host fixed point"
  if ! bootstrap/scripts/diagnose.sh --check-fixedpoint; then
    echo
    echo "[pre-commit] SELF-HOST FIXED POINT BROKEN — commit blocked"
    echo "[pre-commit] bs2 and bs3 emit different IR for packages/cli/src/main.av"
    echo "[pre-commit] this means the last change to bootstrap source produced a"
    echo "[pre-commit] non-self-consistent compiler. Fix or 'git commit --no-verify'."
    exit 1
  fi
  echo "[pre-commit] self-host fixed point holds"
fi

# Verify the seed IR exists and hasn't been deleted.
# This is our lifeline — without it we can't bootstrap from scratch.
seed_relevant=$(echo "$staged" | grep -E '^bootstrap/seed/' || true)
if [ -n "$seed_relevant" ] || [ -n "$src_relevant" ]; then
  if [ ! -f bootstrap/seed/seed.ll ]; then
    echo
    echo "[pre-commit] SEED IR MISSING — commit blocked"
    echo "[pre-commit] bootstrap/seed/seed.ll is the bootstrap lifeline."
    echo "[pre-commit] Without it, the project cannot be built from scratch."
    echo "[pre-commit] Restore it before committing."
    exit 1
  fi
fi
