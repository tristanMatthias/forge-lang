// Phase 1 of Components V2 (vez6.1): exercise the public AST
// introspection helpers in core/ast_introspect.av. Builds a small
// AST body by hand (arena rows), then checks that the helpers find
// what's there and don't find what's not.

use @std.avrac.core.{Stmt, StmtId, NodeStore, new_node_store, build_line_index, Expr, CompConfigPair, ParamEntry, ValueType, TypeParamEntry}
use @std.avrac.core.{has_fn, find_fn_body, config_lookup, config_has}

fn ts() -> NodeStore {
    new_node_store(build_line_index(""))
}

// Build a fn-decl statement for testing.
fn mk_fn(name: string) -> Stmt {
    let empty_tp: List<TypeParamEntry> = []
    let empty_p: List<ParamEntry> = []
    let empty_body: List<StmtId> = []
    Stmt.Function(name, empty_tp, empty_p, ValueType.Void, empty_body)
}

// `let body = [fn run() {}, fn drop() {}]` as arena rows in `store`.
fn sample_body(store: NodeStore) -> List<StmtId> {
    [
        store.stmts.add_leaf(mk_fn("run")),
        store.stmts.add_leaf(mk_fn("drop")),
    ]
}

spec "ast_introspect.has_fn" {
    given "a body with run + drop fns" {
        then "finds run" {
            let store = ts()
            has_fn(store, sample_body(store), "run")
        }
        then "finds drop" {
            let store = ts()
            has_fn(store, sample_body(store), "drop")
        }
        then "doesn't find missing fn" {
            let store = ts()
            !has_fn(store, sample_body(store), "missing")
        }
    }
    given "an empty body" {
        then "finds nothing" {
            let store = ts()
            let empty: List<StmtId> = []
            !has_fn(store, empty, "anything")
        }
    }
}

spec "ast_introspect.find_fn_body" {
    given "a body with named fns" {
        then "returns empty for the (empty) run body" {
            let store = ts()
            find_fn_body(store, sample_body(store), "run").length == 0
        }
        then "returns empty when fn is missing" {
            let store = ts()
            find_fn_body(store, sample_body(store), "missing").length == 0
        }
    }
}

fn sample_pairs() -> List<CompConfigPair> {
    [
        CompConfigPair { key: "description", value: Expr.String("\"hello\"") },
        CompConfigPair { key: "version", value: Expr.String("\"1.0\"") },
    ]
}

spec "ast_introspect.config_lookup" {
    given "a config pair list" {
        then "finds existing key" {
            config_lookup(sample_pairs(), "description") != null
        }
        then "returns null for missing key" {
            config_lookup(sample_pairs(), "missing") == null
        }
        then "config_has reflects lookup" {
            config_has(sample_pairs(), "version") && !config_has(sample_pairs(), "missing")
        }
    }
}
