/// expect: 15
/// expect: hello
/// expect: true

// Test: component config pairs with `=` syntax support arbitrary expressions

fn add(a: int, b: int) -> int { a + b }

component widget {
    config {
        value: int = 0
        label: string = ""
        active: bool = false
    }
    fn init() {
        println(string(self.config.value))
        println(self.config.label)
        if self.config.active { println("true") } else { println("false") }
    }
}

fn main() {
    widget w {
        value = add(5, 10)
        label = "hello"
        active = true
    }
}
