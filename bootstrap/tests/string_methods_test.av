fn sm_run() -> string {
    let s = "hello world"
    avra_test_capture_start()
    println(string(s.contains("world")))
    println(string(s.starts_with("hello")))
    println(string(s.ends_with("world")))
    println(string(s.index_of("world")))
    let r = s.replace("world", "forge")
    println(r)
    let t = "  spaces  ".trim()
    println(t)
    println("hello".upper())
    println("HELLO".lower())
    let parts = "a,b,c".split(",")
    println(string(parts.length))
    println(parts[0])
    println(parts[1])
    println(parts[2])
    avra_test_capture_stop()
}

spec "string methods" {
    then "string methods output" {
        sm_run() == "1\n1\n1\n6\nhello forge\nspaces\nHELLO\nhello\n3\na\nb\nc"
    }
}
