// COMBO: struct + enum + match + methods + templates
type User = { name: string, age: int }

enum Role {
    Admin,
    Editor(level: int),
    Viewer,
}

impl User {
    fn greet(self) -> string {
        `${self.name} (age ${string(self.age)})`
    }
}

fn describe_role(user: User, role: Role) -> string {
    let base = user.greet()
    let role_str = match role {
        .Admin -> "admin"
        .Editor(lvl) -> `editor level ${string(lvl)}`
        .Viewer -> "viewer"
    }
    `${base} is ${role_str}`
}

let u = User { name: "Alice", age: 30 }
println(describe_role(u, Role.Admin))
println(describe_role(u, Role.Editor(3)))
println(describe_role(u, Role.Viewer))
