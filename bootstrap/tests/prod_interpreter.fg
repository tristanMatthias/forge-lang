// Mini expression interpreter — tests recursive enums + match + closures + strings
enum Expr {
    Num(n: int),
    Add(a: Expr, b: Expr),
    Mul(a: Expr, b: Expr),
    Neg(e: Expr),
}

fn eval(e: Expr) -> int {
    match e {
        .Num(n) -> n
        .Add(a, b) -> eval(a) + eval(b)
        .Mul(a, b) -> eval(a) * eval(b)
        .Neg(inner) -> -eval(inner)
    }
}

fn to_string(e: Expr) -> string {
    match e {
        .Num(n) -> string(n)
        .Add(a, b) -> `(${to_string(a)} + ${to_string(b)})`
        .Mul(a, b) -> `(${to_string(a)} * ${to_string(b)})`
        .Neg(inner) -> `(-${to_string(inner)})`
    }
}

let expr = Expr.Mul(
    Expr.Add(Expr.Num(2), Expr.Num(3)),
    Expr.Neg(Expr.Num(4))
)
println(to_string(expr))
println(string(eval(expr)))
