// WHY: spec for the stdin capture-and-relay in .beads/hooks/pre-push.
// With core.hooksPath=.beads/hooks, git hands the pushed-refs list to
// the beads hook; without the capture at the top of that file the
// refs would be consumed before the chained repo hook ran, every push
// would look like "nothing outgoing", and the bootstrap-window gate
// would be silently bypassed. The real chained hook is exercised
// end-to-end with bd neutralized via a stripped PATH (the beads block
// gates on `command -v bd`, and running real bd in a spec would side-
// effect the Dolt sync).
//
// The load-bearing case is the last one: refs whose range touches
// bootstrap/ must make the gate FIRE — that is the only observable
// that distinguishes a working relay from eaten stdin.

extern fn avra_shell_exec(cmd: string) -> string

fn run_beads_hook(env_prefix: string, stdin_content: string) -> string {
    avra_shell_exec("printf '%s\\n' '${stdin_content}' | ${env_prefix}env PATH=/usr/bin:/bin bash ../.beads/hooks/pre-push 2>&1; echo rc=$?")
}

spec ".beads/hooks/pre-push: stdin capture and relay to the repo hook" {
    given "AVRA_SKIP_WINDOW_CHECK=1 and refs on stdin" {
        then "the chain reaches the repo hook, which exits 0 with the skip message" {
            let out = run_beads_hook("AVRA_SKIP_WINDOW_CHECK=1 ", "refs/heads/x abc123 refs/heads/x def456")
            out.contains("bootstrap-window gate skipped") && out.contains("rc=0")
        }
    }
    given "an empty ref list" {
        then "the repo hook exits 0 without reaching the gate" {
            let out = run_beads_hook("", "")
            out.contains("rc=0") && !out.contains("verifying the bootstrap window")
        }
    }
    given "a ref-deletion push (all-zero local sha)" {
        then "the relay delivers the deletion marker and the gate is skipped" {
            let zero = "0000000000000000000000000000000000000000"
            let out = run_beads_hook("", "refs/heads/x ${zero} refs/heads/x feedbeef")
            out.contains("rc=0") && !out.contains("verifying the bootstrap window")
        }
    }
    given "refs whose outgoing range touches bootstrap/" {
        then "the relayed refs make the gate FIRE — a broken relay cannot pass this" {
            // HEAD~1..HEAD on this repo always touches bootstrap/; the
            // gate run itself is cheap (green verifies are cached).
            let head = avra_shell_exec("git rev-parse HEAD").trim()
            let prev = avra_shell_exec("git rev-parse HEAD~1").trim()
            let out = run_beads_hook("", "refs/heads/x ${head} refs/heads/x ${prev}")
            out.contains("verifying the bootstrap window")
        }
    }
}
