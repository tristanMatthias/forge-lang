type Point = { x: int, y: int }

enum Shape {
    Circle(radius: int)
    Rect(p: Point)
}

fn area(s: Shape) -> int {
    match s {
        .Circle(r) -> r * r * 3
        .Rect(p) -> p.x * p.y
    }
}

fn describe(s: Shape) -> string {
    match s {
        .Circle(r) -> `circle(r=${string(r)})`
        .Rect(p) -> `rect(${string(p.x)}x${string(p.y)})`
    }
}

let shapes = [
    Shape.Circle(5),
    Shape.Rect(Point { x: 3, y: 4 }),
    Shape.Circle(10)
]

let descriptions = shapes.map((s) -> { describe(s) })
let areas = shapes.map((s) -> { area(s) })

mut i = 0
while i < 3 {
    println(`${descriptions[i]}: area=${string(areas[i])}`)
    i = i + 1
}

// Total area with reduce — init value first, then function
let total = areas.reduce(0, (acc, a) -> { acc + a })
println(`total area: ${string(total)}`)
