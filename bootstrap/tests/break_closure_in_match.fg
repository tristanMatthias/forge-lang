// Closure result used in match guard
fn make_checker(threshold: int) -> fn(int) -> int {
    (x) -> {
        if x > threshold { return 1 }
        0
    }
}
let is_big = make_checker(100)

let nums = [50, 150, 75, 200]
for n in nums {
    let label = match n {
        _ if is_big(n) == 1 -> "BIG"
        _ -> "small"
    }
    println(`${string(n)}: ${label}`)
}
