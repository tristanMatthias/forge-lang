// Basic TOML parsing via C runtime.

extern fn forge_toml_get_string(toml: string, key: string) -> string
extern fn forge_toml_get_int(toml: string, key: string) -> int
extern fn forge_toml_get_bool(toml: string, key: string) -> bool

fn main() {
    let config = "name = \"forge\"\nversion = \"1.2.3\"\noptimize = true\nmax_errors = 10\n"

    println(forge_toml_get_string(config, "name"))
    println(forge_toml_get_string(config, "version"))
    println(string(forge_toml_get_bool(config, "optimize")))
    println(string(forge_toml_get_int(config, "max_errors")))
}
