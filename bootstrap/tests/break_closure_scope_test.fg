fn bcs_run() -> string {
    mut counter = 0
    let inc = () -> {
        counter = counter + 1
        counter
    }
    forge_test_capture_start()
    println(string(inc()))
    println(string(inc()))
    println(string(counter))
    forge_test_capture_stop()
}

spec "break closure scope" {
    then "closure captures mutable variable" {
        bcs_run() == "1\n2\n2"
    }
}
