// End-to-end `bs2 build --lib --emit_metadata` tests.
//
// Validates that a package with a `[lib]` section in avra.toml can
// be built standalone and produces both the cached IR (.ll) AND a
// metadata.bin describing its public surface — the producer half of
// 2f54.
//
// Memoised at the shell level so each `then` does not re-build.
// Tracking ticket: forge-crafting-intepreters-2f54.

extern fn avra_shell_exec(cmd: string) -> string


// vez6.6.4 flake fix: per-PPID cache file so concurrent
// bs2-test sessions (e.g. a commit pre-commit hook racing
// a manual run) don't collide on a shared /tmp path. PPID
// is the bs2 test runner's PID, stable across every
// avra_shell_exec call in a single test session.
const CACHE_FILE: string = "/tmp/avra_2f54_test.$" + "PPID.out"
fn lib_run_fixture() -> string {
    avra_shell_exec("if [ ! -f " + CACHE_FILE + " ]; then bash scripts/diagnose.sh --run tests/build_lib_metadata_fixtures/sample.av > " + CACHE_FILE + " 2>&1 || true; fi; cat " + CACHE_FILE + "")
}

fn lib_wipe() -> string {
    avra_shell_exec("rm -f " + CACHE_FILE + "")
}

spec "build --lib --emit_metadata: clear cached output" {
    then "wipe stale /tmp output from any prior run" {
        let _ = lib_wipe()
        true
    }
}

spec "build --lib --emit_metadata: scaffolds + builds + emits a meta.bin" {
    then "build returns rc=0 from a freshly-scaffolded [lib] package" {
        lib_run_fixture().contains("PROBE build_rc_zero: ok")
    }
    then "the .meta.bin file is non-empty next to the entry source" {
        lib_run_fixture().contains("PROBE meta_bin_present_and_nonempty: ok")
    }
    then "metadata_show finds the exported type" {
        lib_run_fixture().contains("PROBE show_has_widget_type: ok")
    }
    then "metadata_show finds the exported fn" {
        lib_run_fixture().contains("PROBE show_has_widget_id_fn: ok")
    }
    then "metadata_show finds the exported const name" {
        lib_run_fixture().contains("PROBE show_has_const_name: ok")
    }
    then "metadata_show preserves the const literal value" {
        lib_run_fixture().contains("PROBE show_has_const_value: ok")
    }
}
