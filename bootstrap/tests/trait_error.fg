// Error test: missing trait method should be caught.
/// expect-error: F1000

trait Drawable {
    fn draw(self) -> string
    fn color(self) -> string
}

type Widget = { id: int }

impl Drawable for Widget {
    fn draw(self) -> string {
        "widget " + string(self.id)
    }
    // Missing: color
}

fn main() {
    let w = Widget { id: 1 }
    println(w.draw())
}
