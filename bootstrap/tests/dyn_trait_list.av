/// expect: circle r=5
/// expect: rect 3x4
/// expect: shapes: 2
/// expect: first: circle r=5

trait Describable {
    fn describe(self) -> string
}

type Circle = { r: int }
type Rect = { w: int, h: int }

impl Describable for Circle {
    fn describe(self) -> string { "circle r=" + string(self.r) }
}

impl Describable for Rect {
    fn describe(self) -> string { "rect " + string(self.w) + "x" + string(self.h) }
}

fn main() {
    let shapes: List<Describable> = [Circle { r: 5 }, Rect { w: 3, h: 4 }]
    shapes.foreach((s) -> println(s.describe()))
    println("shapes: " + string(shapes.length))
    
    // Access individual elements
    let first: Describable = shapes.get(0)
    println("first: " + first.describe())
}
