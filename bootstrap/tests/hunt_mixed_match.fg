// Match on string with guard
fn parse_cmd(cmd: string, verbose: bool) -> string {
    match cmd {
        "help" -> "showing help"
        "run" if verbose -> "running (verbose mode)"
        "run" -> "running"
        _ -> "unknown: " + cmd
    }
}
println(parse_cmd("help", false))
println(parse_cmd("run", true))
println(parse_cmd("run", false))
println(parse_cmd("xyz", false))

// Match returning different types in branches
fn status_emoji(code: int) -> string {
    match code {
        200 -> "✓"
        404 -> "✗"
        500 -> "!"
        _ -> "?"
    }
}
println(status_emoji(200))
println(status_emoji(404))
println(status_emoji(999))
