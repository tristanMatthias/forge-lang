// First-class function references — functions as values.

fn double(n: int) -> int { n * 2 }
fn triple(n: int) -> int { n * 3 }
fn negate(n: int) -> int { 0 - n }

fn apply(f: fn(int) -> int, x: int) -> int { f(x) }

fn pick(use_double: bool) -> fn(int) -> int {
    if use_double { double } else { triple }
}

fn main() {
    // Store and call
    let f = double
    println(string(f(5)))

    // Pass as argument
    println(string(apply(double, 7)))
    println(string(apply(triple, 4)))
    println(string(apply(negate, 10)))

    // Reassign
    mut g = double
    println(string(g(3)))
    g = triple
    println(string(g(3)))

    // Return from function
    let h = pick(true)
    println(string(h(6)))
    let j = pick(false)
    println(string(j(6)))
}
