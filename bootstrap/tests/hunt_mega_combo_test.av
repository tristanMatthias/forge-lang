type HmcPoint = { x: int, y: int }

enum HmcShape {
    Circle(radius: int)
    Rect(p: HmcPoint)
}

fn hmc_area(s: HmcShape) -> int {
    match s {
        .Circle(r) -> r * r * 3
        .Rect(p) -> p.x * p.y
    }
}

fn hmc_describe(s: HmcShape) -> string {
    match s {
        .Circle(r) -> `circle(r=${string(r)})`
        .Rect(p) -> `rect(${string(p.x)}x${string(p.y)})`
    }
}

fn hmc_run() -> string {
    avra_test_capture_start()
    let shapes = [
        HmcShape.Circle(5),
        HmcShape.Rect(HmcPoint { x: 3, y: 4 }),
        HmcShape.Circle(10)
    ]
    let descriptions = shapes.map((s) -> { hmc_describe(s) })
    let areas = shapes.map((s) -> { hmc_area(s) })
    mut i = 0
    while i < 3 {
        println(`${descriptions[i]}: area=${string(areas[i])}`)
        i = i + 1
    }
    let total = areas.reduce(0, (acc, a) -> { acc + a })
    println(`total area: ${string(total)}`)
    avra_test_capture_stop()
}

spec "hunt mega combo" {
    then "area circle" {
        hmc_area(HmcShape.Circle(5)) == 75
    }
    then "area rect" {
        hmc_area(HmcShape.Rect(HmcPoint { x: 3, y: 4 })) == 12
    }
    then "full output" {
        hmc_run() == "circle(r=5): area=75\nrect(3x4): area=12\ncircle(r=10): area=300\ntotal area: 387"
    }
}
