// Fixture: validates @std/avrac builds cleanly as a separately-
// cached unit. This is the bootstrap-CLI consumption case for 2f54
// — proves the multi-mod use-anchor wiring (resolve_module_stmt's
// pre-populated body branch + qualify_uses_recursively at the
// --module_path wrap) handles the bootstrap's own source.
//
// Tracking ticket: forge-crafting-intepreters-2f54.

use @std.avrac.features.modules.{package_meta_path_for}
use @std.avrac.build.{cached_build_ll_path}

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_process_env_get(name: string) -> string
extern fn avra_selfhost_file_exists(path: string) -> int

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

fn main() -> int {
    // @@fixture-stateful@@ — fxfz: this fixture builds @std/avrac into the
    // SHARED packages/std-avrac tree and probes its meta.bin / cached IR
    // artifacts — build state outside the fixture-stdout cache key.
    // fixture_is_stateful reads this directive from the source, making any
    // `: FAIL` capture non-publishable so a capture taken against a corrupt/
    // half-published shared cache re-probes next run instead of freezing.
    // (Token: FIXTURE_STATEFUL_MARKER in @std.avrac.)
    let pwd = avra_process_env_get("PWD")
    let bs2 = "${pwd}/build/bs2"
    let std_avrac = "${pwd}/packages/std-avrac"

    // 0qmm: stop wiping. The content-addressed grgg cache + the
    // cache-hit metadata-restore in main.av's build path mean the
    // probes below (avrac_meta_bin_present etc.) work whether the
    // build ran from-scratch or from-cache. On warm runs the wipe
    // forced ~12s of unnecessary recompilation.

    // CAPTURE the build output. This probe has now failed twice in CI —
    // rc != 0 while every artifact probe below PASSED, i.e. the build produced
    // everything it should have and only its exit code was wrong — and both
    // times the investigation stalled because the output went nowhere and the
    // rc alone names none of the four `fail(...)` sites it could have come
    // from. An assertion that discards its evidence turns a reproducible CI
    // failure into a guessing exercise; the driver has several distinct
    // failure exits and only the message tells them apart.
    let build_log = "/tmp/std_avrac_lib_build.log"
    let rc = avra_shell_exec_status("cd ${std_avrac} && ${bs2} build --lib --emit_metadata > ${build_log} 2>&1")
    probe("std_avrac_build_rc_zero", rc == 0)
    if rc != 0 {
        // Tail only: a successful build prints thousands of warning lines, and
        // every `fail(...)` in the driver is the LAST thing written.
        println("--- build exited ${string(rc)}; tail of ${build_log} ---")
        println(avra_shell_exec("tail -40 ${build_log} 2>/dev/null"))
        // One of the driver's failure exits is `failed to pre-build a
        // path-dep`, whose real diagnostic lives in per-dep logs the driver
        // deliberately does NOT clean up on failure (it cleans them only on
        // success). Dump them here too: @std/avrac has five path-deps, and
        // without this the parent's message just names a directory that is
        // gone by the time anyone reads the CI log.
        println("--- surviving per-dep logs (kept only on failure) ---")
        println(avra_shell_exec("tail -n 25 ${std_avrac}/build/pre_deps.*/*.log 2>/dev/null | head -200"))
        println("--- end build log ---")
    }

    probe("avrac_meta_bin_present", avra_selfhost_file_exists(package_meta_path_for(std_avrac, bs2)) != 0)

    // uzs9.4: probe the RACE-SAFE, content-addressed cache slot, NOT the
    // shared entry `${std_avrac}/src/avrac.av.ll`. That shared path is
    // removed-then-rewritten by every concurrent `bs2 build --lib` on
    // std-avrac (main.av's pre-compile unlink — "the one path the cache
    // can't defend", pdme.7). Under the parallel test suite a sibling
    // shard building @std would empty it mid-read, so the greps below
    // intermittently observed an absent / half-written file even though
    // this build's own VALUE assertions (rc, meta.bin) passed — the
    // ordering flake this ticket roots out. cached_build_ll_path resolves
    // the slot the build published (via the `last` sidecar's fp); a
    // content-addressed slot is never removed mid-flight, so a probe here
    // never races a builder while still grepping the exact IR `build --lib`
    // emits (the slot is the source of the entry `.ll` on a cache hit).
    let cached_ll = cached_build_ll_path(std_avrac, "std-avrac")
    let ll_present = cached_ll != "" && avra_selfhost_file_exists(cached_ll) != 0
    probe("avrac_ll_present", ll_present)

    // Guard the grep target: a "" path (no `last` sidecar recorded — should
    // never happen after rc==0, but be defensive) would make `grep` read
    // STDIN and HANG. Fall back to an empty file so the greps return 0 and
    // the symbols_qualified probe fails honestly instead of hanging.
    let grep_ll = if ll_present { cached_ll } else { "/dev/null" }

    // Symbols are qualified with @std::avrac::, which the object-file
    // mangler escapes (`@`->$40, `:`->$3A) to `$40std$3A$3Aavrac$3A$3A…`.
    // Grep for one canonical fn that exists in @std/avrac/codegen.
    let qualified_grep = avra_shell_exec("grep -c '@\"$40std$3A$3Aavrac$3A$3Acodegen' ${grep_ll}").trim()
    probe("symbols_qualified_under_at_std_avrac", int(qualified_grep) > 100)

    // Unqualified `codegen::` (mangled `codegen$3A$3A`) should NOT appear at
    // the start of any define line (that would mean the wrap missed those fns).
    let unq = avra_shell_exec("grep -c '^define [a-z0-9]* @\"codegen$3A$3A' ${grep_ll}").trim()
    probe("no_unqualified_codegen_fns", int(unq) == 0)

    0
}
