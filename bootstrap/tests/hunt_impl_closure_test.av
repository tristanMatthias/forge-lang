type HicAdder = { base: int }
impl HicAdder {
    fn make(self) -> fn(int) -> int {
        let b = self.base
        (x) -> x + b
    }
}

spec "hunt impl closure" {
    then "method returning closure" {
        let a = HicAdder { base: 100 }
        let add100 = a.make()
        add100(5) == 105
    }
    then "method returning closure second call" {
        let a = HicAdder { base: 100 }
        let add100 = a.make()
        add100(42) == 142
    }
}
