// List of maps — for-in should carry Map type
let users = [
    {"name": "alice", "score": "90"},
    {"name": "bob", "score": "85"},
    {"name": "carol", "score": "95"},
]

for user in users {
    println(user.get("name"))
}

// List of structs
type Point = { x: int, y: int }
let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
for p in points {
    println(string(p.x + p.y))
}

// Indexing preserves type
let first = users[0]
println(first.get("score"))

// Filter preserves element type
let high = [90, 85, 95, 70].filter((s) -> s >= 90)
mut sum = 0
for s in high {
    sum = sum + s
}
println(string(sum))
