/// expect: 1000
/// expect: 3.14
/// expect: avra
/// expect: 500
/// expect: 1
fn main() {
    const MAX: int = 1000
    const PI: float = 3.14
    const NAME = "avra"
    const HALF = MAX / 2
    const FLAG = true
    println(string(MAX))
    println(string(PI))
    println(NAME)
    println(string(HALF))
    println(string(FLAG))
}
