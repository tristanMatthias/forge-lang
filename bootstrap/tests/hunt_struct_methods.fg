// Struct with impl methods
type Vec2 = { x: int, y: int }

impl Vec2 {
    fn add(self, other: Vec2) -> Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
    fn scale(self, factor: int) -> Vec2 {
        Vec2 { x: self.x * factor, y: self.y * factor }
    }
    fn to_string(self) -> string {
        `(${string(self.x)}, ${string(self.y)})`
    }
}

let a = Vec2 { x: 1, y: 2 }
let b = Vec2 { x: 3, y: 4 }
let c = a.add(b)
println(c.to_string())
let d = c.scale(2)
println(d.to_string())

// Method chaining
let e = Vec2 { x: 1, y: 1 }.scale(5).add(Vec2 { x: 10, y: 10 })
println(e.to_string())
