fn esq_run() -> string {
    forge_test_capture_start()
    println("hello\nworld")
    println("tab\there")
    println("quote\"inside")
    println("back\\slash")
    forge_test_capture_stop()
}

spec "escape sequences" {
    then "full output" {
        esq_run() == "hello\nworld\ntab\there\nquote\"inside\nback\\slash"
    }
}
