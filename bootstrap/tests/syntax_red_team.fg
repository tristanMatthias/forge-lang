/// expect: pipe: 11
/// expect: interp: Alice is 30
/// expect: when: medium
/// expect: slice: hel

fn double(x: int) -> int { x * 2 }
fn inc(x: int) -> int { x + 1 }

fn main() {
    let r = 5 |> double |> inc
    println("pipe: ${string(r)}")

    let name = "Alice"
    let age = 30
    println("interp: ${name} is ${string(age)}")

    let x = 50
    let label = when {
        x < 10 -> "small"
        x < 100 -> "medium"
        _ -> "large"
    }
    println("when: ${label}")

    println("slice: ${"hello"[0..3]}")
}
