// Nullable with various types
fn find_user(id: int) -> string? {
    if id == 1 { return "Alice" }
    if id == 2 { return "Bob" }
    null
}

// Null coalescing
println(find_user(1) ?? "unknown")
println(find_user(2) ?? "unknown")
println(find_user(99) ?? "unknown")

// Nested nullable
fn get_greeting(id: int) -> string {
    let name = find_user(id) ?? "stranger"
    `hello ${name}`
}
println(get_greeting(1))
println(get_greeting(99))

// Nullable in match (via guard)
let val: int? = 42
let result = if val != null { string(val!) } else { "null" }
println(result)

let empty: int? = null
let result2 = if empty != null { string(empty!) } else { "null" }
println(result2)
