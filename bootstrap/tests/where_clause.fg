// Where clauses on generic functions — syntactic sugar for inline trait bounds.
// Tests that `where T: Bound` is accepted and desugared correctly.

trait Sized {
    fn size(self) -> int
}

// Single where clause
fn identity<T>(x: T) -> T where T: Sized {
    x
}

// Multiple where clauses
fn pick_first<A, B>(a: A, b: B) -> A where A: Sized, B: Sized {
    a
}

// Where clause with no inline bounds + return type
fn wrap<T>(x: T) -> T where T: Sized {
    x
}

fn main() {
    // Monomorphization works through where-bounded generics
    println(string(identity(42)))
    println(string(pick_first(10, 20)))
    println(wrap("hello"))
}
