// ? operator inside a closure body
fn safe_parse(s: string) -> int? {
    if s == "" { return null }
    int(s)
}

fn process_all(items: List) -> int? {
    mut total = 0
    for item in items {
        let val = safe_parse(item)?
        total = total + val
    }
    total
}

let r1 = process_all(["10", "20", "30"])
println(string(r1 ?? -1))

let r2 = process_all(["10", "", "30"])
println(string(r2 ?? -1))
