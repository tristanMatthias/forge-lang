// COMBO: all operator types in one expression chain
// arithmetic + comparison + logical + pipe + null coalesce

fn clamp(val: int, lo: int, hi: int) -> int {
    if val < lo { return lo }
    if val > hi { return hi }
    val
}

fn abs(n: int) -> int {
    if n < 0 { -n } else { n }
}

// Complex expression combining many features
let x = 15
let clamped = clamp(x * 2 - 5, 0, 50)
println(string(clamped))

// Logical with comparison
let in_range = x >= 10 && x <= 20
println(string(in_range))

// Pipe + null coalesce + arithmetic
fn maybe_double(n: int) -> int {
    if n > 10 { n * 2 } else { 0 }
}
let result = 5 |> maybe_double
let safe = result ?? 99
println(string(safe))

let result2 = 15 |> maybe_double
println(string(result2))
