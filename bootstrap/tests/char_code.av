// char_code returns ASCII value of first byte
println(string("A".char_code()))
println(string("z".char_code()))
println(string("0".char_code()))
println(string(" ".char_code()))

// Use for comparison
let ch = "B"
if ch.char_code() >= 65 && ch.char_code() <= 90 {
    println("uppercase")
} else {
    println("not uppercase")
}
