trait TcStringable {
    fn to_str(self) -> string
}

trait TcSizeable {
    fn size(self) -> int
}

type TcBox = { width: int, height: int, label: string }

impl TcStringable for TcBox {
    fn to_str(self) -> string {
        self.label + " (" + string(self.width) + "x" + string(self.height) + ")"
    }
}

impl TcSizeable for TcBox {
    fn size(self) -> int {
        self.width * self.height
    }
}

enum TcShape {
    Rect(w: int, h: int)
    Circle(r: int)
}

impl TcStringable for TcShape {
    fn to_str(self) -> string {
        match self {
            .Rect(w, h) -> "rect " + string(w) + "x" + string(h)
            .Circle(r) -> "circle r=" + string(r)
        }
    }
}

type TcCounter = { start: int }

impl TcCounter {
    fn make_counter(self) -> fn(int) -> int {
        let base = self.start
        (n) -> n + base
    }
}

impl TcBox {
    fn resize(self, w: int, h: int) -> TcBox {
        self with { width: w, height: h }
    }
}

fn tc_is_big(b: TcBox) -> bool {
    b.size() > 50
}

fn tc_describe_shape(s: TcShape) -> string {
    if s is .Circle {
        s.to_str() + " (round)"
    } else {
        s.to_str() + " (angular)"
    }
}

fn tc_sum_two_boxes(a: TcBox, b: TcBox) -> int {
    a.size() + b.size()
}

fn tc_box_to_str(b: TcBox) -> string { b.to_str() }

fn tc_run() -> string {
    let b = TcBox { width: 10, height: 5, label: "main" }

    forge_test_capture_start()
    println(b.to_str())
    println(string(b.size()))

    let b2 = b.resize(20, 3)
    println(b2.to_str())
    println(string(b2.size()))

    let s1 = TcShape.Rect(4, 6)
    let s2 = TcShape.Circle(3)
    println(s1.to_str())
    println(s2.to_str())

    println(string(tc_is_big(b)))
    println(string(tc_is_big(TcBox { width: 2, height: 2, label: "tiny" })))

    println(tc_describe_shape(s1))
    println(tc_describe_shape(s2))

    let c = TcCounter { start: 100 }
    let add = c.make_counter()
    println(string(add(5)))

    let a = TcBox { width: 3, height: 4, label: "a" }
    let b3 = TcBox { width: 5, height: 6, label: "b" }
    println(string(tc_sum_two_boxes(a, b3)))

    println(b |> tc_box_to_str)
    println(`box: ${b.to_str()}, size: ${string(b.size())}`)
    forge_test_capture_stop()
}

spec "trait combo" {
    then "trait combo output" {
        tc_run() == "main (10x5)\n50\nmain (20x3)\n60\nrect 4x6\ncircle r=3\n0\n0\nrect 4x6 (angular)\ncircle r=3 (round)\n105\n42\nmain (10x5)\nbox: main (10x5), size: 50"
    }
}
