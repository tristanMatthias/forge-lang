// Fixture for resolve_dir_module_body integration tests (g2eo.1).
//
// Builds a tiny directory of .av files (no mod.av, no `mod foo`
// declarations) and confirms the resolver's directory-as-module
// loader picks them all up, parses each, and produces a combined
// flat body whose statement count equals the sum of each file's
// parsed stmt count. Probe lines are read by ../dir_module_resolver_test.av.

extern fn avra_shell_exec(cmd: string) -> string

use @std.avrac.features.modules.{resolve_dir_module_body}

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

fn empty_loaded() -> List<string> {
    let e: List<string> = []
    e
}

fn main() -> int {
    let root = "/tmp/avra_dirmod_resolver_fixture"
    avra_shell_exec("rm -rf " + root)
    avra_shell_exec("mkdir -p " + root)

    // Three sibling files, no mod.av, no `mod foo` decls. Each file
    // exports one fn — the directory-as-module loader concatenates
    // them into a single body with 3 fn stmts.
    avra_shell_exec("printf 'export fn alpha() -> int { 1 }\\n' > " + root + "/alpha.av")
    avra_shell_exec("printf 'export fn beta() -> int { 2 }\\n'  > " + root + "/beta.av")
    avra_shell_exec("printf 'export fn gamma() -> int { 3 }\\n' > " + root + "/gamma.av")

    // A _test.av sibling — must be filtered out of the loaded body.
    avra_shell_exec("printf 'export fn helper() -> int { 99 }\\n' > " + root + "/zzz_test.av")

    let result = resolve_dir_module_body(root, empty_loaded())

    // Probe 1 — load is errorless.
    probe("no_error", !result.had_error)

    // Probe 2 — three files registered as loaded (alpha, beta, gamma).
    probe("loaded_three", result.loaded.length == 3)

    // Probe 3 — body assembled (non-empty stmts).
    probe("body_non_empty", result.stmts.length > 0)

    // Probe 4 — re-running with an already-loaded set short-circuits.
    let result2 = resolve_dir_module_body(root, result.loaded)
    probe("rerun_empty_stmts", result2.stmts.length == 0)
    probe("rerun_loaded_unchanged", result2.loaded.length == result.loaded.length)

    // Probe 5 — pointing at a non-existent dir returns errorless empty.
    let result3 = resolve_dir_module_body("/tmp/avra_dirmod_resolver_does_not_exist_xx", empty_loaded())
    probe("missing_dir_no_error", !result3.had_error)
    probe("missing_dir_empty_stmts", result3.stmts.length == 0)
    probe("missing_dir_zero_loaded", result3.loaded.length == 0)

    avra_shell_exec("rm -rf " + root)
    0
}
