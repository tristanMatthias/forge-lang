// `bs2 build --emit_metadata` parallelizes path-dep pre-builds via
// xargs -P. AVRA_JOBS controls the worker count (default 4). All
// three deps in the fixture build concurrently when N≥3.
//
// Tracking ticket: forge-crafting-intepreters-e20h.

use @std.avrac.test_runner.{cached_fixture_run}

fn pp_run() -> string {
    cached_fixture_run("tests/parallel_pre_deps_fixtures/sample.av")
}

spec "parallel pre-deps: AVRA_JOBS=N runs path-dep builds concurrently" {
    then "AVRA_JOBS=3 build with three independent deps succeeds" {
        pp_run().contains("PROBE parallel_build_rc_zero: ok")
    }
    then "dep a's meta.bin lands" {
        pp_run().contains("PROBE a_meta_present: ok")
    }
    then "dep b's meta.bin lands" {
        pp_run().contains("PROBE b_meta_present: ok")
    }
    then "dep c's meta.bin lands" {
        pp_run().contains("PROBE c_meta_present: ok")
    }
    then "sequential AVRA_JOBS=1 also exits clean (cache hit)" {
        pp_run().contains("PROBE sequential_build_rc_zero: ok")
    }
}
