// `bs2 build --emit_metadata` sends independent path-dep builds through the
// shared resource controller. AVRA_JOBS is deliberately ignored here: the
// current platform scope and learned profile decide the width.
//
// Tracking ticket: forge-crafting-intepreters-e20h.

use @std.avrac.test_runner.{cached_fixture_run}

fn pp_run() -> string {
    cached_fixture_run("tests/parallel_pre_deps_fixtures/sample.av")
}

spec "parallel pre-deps: resource controller owns build width" {
    then "an invalid legacy AVRA_JOBS value cannot affect the build" {
        pp_run().contains("PROBE resource_build_rc_zero: ok")
    }
    then "dep a's meta.bin lands" {
        pp_run().contains("PROBE a_meta_present: ok")
    }
    then "dep b's meta.bin lands" {
        pp_run().contains("PROBE b_meta_present: ok")
    }
    then "dep c's meta.bin lands" {
        pp_run().contains("PROBE c_meta_present: ok")
    }
    then "a subsequent build exits clean from the same resource profile" {
        pp_run().contains("PROBE repeat_build_rc_zero: ok")
    }
}
