// Compile-error test: reserved keyword `async` is not yet a valid statement.
// Uses bs2 itself as a subprocess to assert the F-code is reported.

extern fn avra_file_write(path: string, content: string) -> int
extern fn avra_shell_exec(cmd: string) -> string

fn rk_run() -> string {
    let src = "fn entry() {\n    async\n}\n"
    avra_file_write("/tmp/_rk_compile_test.av", src)
    avra_shell_exec("./build/bs2 compile /tmp/_rk_compile_test.av 2>&1 || true")
}

spec "reserved keywords" {
    then "F0001 reported for reserved keyword `async` in fn body" {
        rk_run().contains("F0001")
    }
}
