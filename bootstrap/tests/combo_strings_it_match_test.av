fn csim_run() -> string {
    let words = ["hello", "world", "foo", "bar"]
    let uppers = words.map(it.upper())

    let items = ["apple pie", "banana split", "apple sauce", "cherry"]
    let apples = items.filter(it.contains("apple"))

    let count = 3
    let desc = match count {
        0 -> "no items"
        1 -> "one item"
        _ -> `${string(count)} items`
    }

    let csv = "Alice,30,Engineer"
    let parts = csv.split(",")

    let messy = "  hello world  "
    let clean = messy.trim().replace("world", "avra").upper()

    avra_test_capture_start()
    println(uppers[0])
    println(uppers[1])
    println(string(apples.length))
    println(apples[0])
    println(apples[1])
    println(desc)
    println(`name=${parts[0]}, age=${parts[1]}, role=${parts[2]}`)
    println(clean)
    avra_test_capture_stop()
}

spec "combo strings it match" {
    then "strings it match combo" {
        csim_run() == "HELLO\nWORLD\n2\napple pie\napple sauce\n3 items\nname=Alice, age=30, role=Engineer\nHELLO AVRA"
    }
}
