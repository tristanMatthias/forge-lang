// Fixture: end-to-end multi-unit build via the metadata fast-path.
// Producer compiled standalone with --module_path → producer.av.o.
// Consumer compiled with AVRA_USE_METADATA=1 → consumer.av.o without
// producer bodies. Link both .o files → run binary → verify exit code.
//
// This is the smoking gun for 2f54: actual cross-unit incremental
// build that produces a working binary.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_process_env_get(name: string) -> string

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

fn main() -> int {
    let dir = "/tmp/avra_2f54_link_e2e"
    avra_shell_exec("rm -rf ${dir}")
    avra_shell_exec("mkdir -p ${dir}")

    avra_shell_exec("printf 'export fn producer_value() -> int { 42 }\\n' > ${dir}/producer.av")
    avra_shell_exec("printf 'mod producer\\nuse producer.{producer_value}\\n\\nfn main() -> int { producer_value() }\\n' > ${dir}/consumer.av")

    let pwd = avra_process_env_get("PWD")
    let bs2 = "${pwd}/build/bs2"
    let llvm_prefix = avra_process_env_get("LLVM_PREFIX")
    let llc = if llvm_prefix == "" { "/opt/homebrew/opt/llvm/bin/llc" } else { "${llvm_prefix}/bin/llc" }
    let lib_dir = if llvm_prefix == "" { "/opt/homebrew/opt/llvm/lib" } else { "${llvm_prefix}/lib" }

    let rc1 = avra_shell_exec_status("${bs2} compile --emit_metadata --module_path=producer ${dir}/producer.av")
    probe("producer_compile_rc_zero", rc1 == 0)
    let rc2 = avra_shell_exec_status("${llc} -O2 -filetype=obj ${dir}/producer.av.ll -o ${dir}/producer.av.o")
    probe("producer_llc_rc_zero", rc2 == 0)

    let rc3 = avra_shell_exec_status("AVRA_USE_METADATA=1 ${bs2} compile ${dir}/consumer.av")
    probe("consumer_compile_rc_zero", rc3 == 0)
    let rc4 = avra_shell_exec_status("${llc} -O2 -filetype=obj ${dir}/consumer.av.ll -o ${dir}/consumer.av.o")
    probe("consumer_llc_rc_zero", rc4 == 0)

    let bin = "${dir}/program"
    let cc_cmd = "cc -o ${bin} ${dir}/consumer.av.o ${dir}/producer.av.o ${pwd}/build/runtime.o ${pwd}/build/llvm_wrapper.o -Wl,-stack_size,0x2000000 -L${lib_dir} -lLLVM -lc++"
    let rc5 = avra_shell_exec_status(cc_cmd)
    probe("link_rc_zero", rc5 == 0)

    let exit_code = avra_shell_exec_status(bin)
    probe("binary_exits_with_producer_value_42", exit_code == 42)

    0
}
