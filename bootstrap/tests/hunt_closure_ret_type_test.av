// The returned lambda is fully annotated (param AND the fn's declared
// return type): an annotated lambda types as FnTyped, matched here by
// the fully-stated declared shape. (A bare `fn` return would also
// accept it since #767 restored bare `fn` as the ARITY-UNKNOWN
// wildcard — that behavior is pinned by
// typeck/tests/bare_fn_wildcard_test.av; this file keeps the explicit
// form so both spellings stay covered.)
fn hunt_make_prefix(prefix: string) -> fn(string) -> string {
    (name: string) -> { prefix + " " + name }
}

spec "hunt closure ret type" {
    then "map with string-returning closure" {
        let names = ["Alice", "Bob", "Charlie"]
        let greetings = names.map((name) -> { "Hello " + name })
        greetings[0] == "Hello Alice" && greetings[1] == "Hello Bob" && greetings[2] == "Hello Charlie"
    }
    then "let-bound closure returning string" {
        let upper_fn = (s: string) -> { s + "!" }
        upper_fn("test") == "test!"
    }
    then "higher-order: fn returning fn" {
        let greeter = hunt_make_prefix("Hi")
        greeter("Dave") == "Hi Dave"
    }
}
