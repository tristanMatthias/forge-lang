/// expect: using resource
/// expect: cleanup done
/// expect: copy works: 10

type Point = { x: int, y: int }

fn use_resource() {
    defer println("cleanup done")
    println("using resource")
}

fn main() {
    use_resource()

    let p = Point { x: 10, y: 20 }
    let q = p
    println("copy works: ${string(q.x)}")
}
