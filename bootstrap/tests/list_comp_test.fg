fn lc_run_doubled() -> string {
    forge_test_capture_start()
    let nums = [1, 2, 3]
    let doubled = [x * 2 for x in nums]
    doubled.foreach((x) -> println(string(x)))
    forge_test_capture_stop()
}

fn lc_run_filtered() -> string {
    forge_test_capture_start()
    let all = [1, 2, 3, 4, 5]
    let big = [x for x in all if x > 3]
    big.foreach((x) -> println(string(x)))
    forge_test_capture_stop()
}

spec "list comp" {
    then "doubled values" {
        lc_run_doubled() == "2\n4\n6"
    }
    then "filtered values" {
        lc_run_filtered() == "4\n5"
    }
}
