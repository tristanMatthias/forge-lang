// Spec test for `bs2 clean` and `bs2 cache prune|info|clear-failed`.
//
// Builds the bs2 invocation as a shell command against a temp project
// dir, asserts the side effects via filesystem probes. We exercise:
//   1. clean: removes build/ contents but keeps build/cache/
//   2. clean --all: also removes build/cache/
//   3. cache info: reports the cache path + entry count
//   4. cache prune --dry-run: lists candidates without modifying state
//   5. cache prune (live): removes stale entries
//   6. cache clear-failed (live): evicts only frozen-`: FAIL` captures (zp5b)
//   7. cache clear-failed --dry-run: lists frozen-FAIL captures without deleting
//
// Tracking ticket: forge-crafting-intepreters-g32c (clean/prune/info),
// forge-crafting-intepreters-zp5b (clear-failed).

extern fn avra_shell_exec(cmd: string) -> string

// One shell invocation does the whole fixture rebuild — going through
// seven fork+execs per spec was the dominant cost in this test shard
// (~120ms for 5 specs × 7 setups).
fn setup_fixture() -> string {
    let project = "/tmp/avra_clean_fixture/"
    avra_shell_exec(
        "rm -rf " + project + " && " +
        "mkdir -p " + project + "build/cache/abc123 " + project + "build/cache/def456 && " +
        "printf 'fake' > " + project + "build/cache/abc123/unit.ll && " +
        "printf 'fake' > " + project + "build/cache/def456/unit.ll && " +
        "printf 'artifact' > " + project + "build/junk.bin && " +
        "printf 'artifact' > " + project + "build/main.av.ll")
    project
}

fn teardown_fixture(project: string) -> string {
    avra_shell_exec("rm -rf " + project)
}


spec "bs2 clean: preserves cache by default" {
    then "removes build/ artifacts but keeps build/cache/" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        // Run bs2 + both probes in one shell so we pay one fork, not three.
        let probe = avra_shell_exec(
            "cd " + project + " && " + bs2 + " clean >/dev/null 2>&1 && " +
            "([ -d " + project + "build/cache/abc123 ] && echo cache=yes || echo cache=no) && " +
            "([ ! -f " + project + "build/junk.bin ] && echo junk=yes || echo junk=no)")
        let _ = teardown_fixture(project)
        probe.contains("cache=yes") && probe.contains("junk=yes")
    }
}

spec "bs2 clean --all: removes everything" {
    then "wipes build/cache/ along with the rest of build/" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "cd " + project + " && " + bs2 + " clean --all >/dev/null 2>&1 && " +
            "([ ! -d " + project + "build/cache ] && echo cache=gone || echo cache=here)")
        let _ = teardown_fixture(project)
        probe.contains("cache=gone")
    }
}

// phx5 Part B: `clean` now dispatches through the declarative App (avra.run()),
// whose parser REJECTS an undeclared flag instead of silently ignoring it the
// way the old bespoke argv scan did. A rejected invocation must exit non-zero
// (so scripts see the failure), name the offending flag, and — because the
// parse error stops dispatch before the run body — leave build/ untouched.
spec "bs2 clean: rejects an unknown flag (declarative parse)" {
    then "`clean --bogus` errors, exits non-zero, and does NOT run the clean" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "cd " + project + " && (" + bs2 + " clean --bogus 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo rc=zero; else echo rc=nonzero; fi) && " +
            "echo --- && " +
            "([ -f " + project + "build/junk.bin ] && echo junk=kept || echo junk=gone)")
        let _ = teardown_fixture(project)
        // rc=nonzero: the parse error exits non-zero; "unknown flag" names the
        // offender; junk=kept: a rejected invocation must not run the clean.
        probe.contains("rc=nonzero") && probe.contains("unknown flag") && probe.contains("junk=kept")
    }
}

// phx5 Part B: `cache`'s subcommand is a `required true` positional in the
// declarative schema, so a missing one is rejected by the parser — this REPLACES
// the bespoke empty-string usage check the conversion removed. Must exit
// non-zero (so scripts see the failure) and name the missing arg.
spec "bs2 cache: a missing subcommand is rejected by the required-arg schema" {
    then "`cache` with no subcommand errors and exits non-zero" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "cd " + project + " && (" + bs2 + " cache 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo rc=zero; else echo rc=nonzero; fi)")
        let _ = teardown_fixture(project)
        probe.contains("rc=nonzero") && probe.contains("subcommand")
    }
}

spec "bs2 cache info: reports the cache state" {
    then "info output mentions the cache path and entry count" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let out = avra_shell_exec("cd " + project + " && " + bs2 + " cache info 2>&1")
        let _ = teardown_fixture(project)
        out.contains("cache info") && out.contains("entries:") && out.contains("2")
    }
}

spec "bs2 cache prune --dry-run: lists without modifying" {
    then "stale entries are reported but stay on disk" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        // Backdate the cache entries so -mtime +0 picks them up,
        // then prune --dry-run, then probe — all in one shell.
        let probe = avra_shell_exec(
            "touch -t 202001010000 " + project + "build/cache/abc123 " + project + "build/cache/def456 && " +
            "cd " + project + " && " + bs2 + " cache prune --max-age-days 0 --dry-run 2>&1 && " +
            "echo --- && " +
            "([ -d " + project + "build/cache/abc123 ] && echo still=yes || echo still=no)")
        let _ = teardown_fixture(project)
        probe.contains("would evict") && probe.contains("still=yes")
    }
}

spec "bs2 cache prune: actually evicts stale entries" {
    then "post-prune the stale entry directories are gone" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "touch -t 202001010000 " + project + "build/cache/abc123 " + project + "build/cache/def456 && " +
            "cd " + project + " && " + bs2 + " cache prune --max-age-days 0 >/dev/null 2>&1 && " +
            "([ ! -d " + project + "build/cache/abc123 ] && echo abc=gone || echo abc=here) && " +
            "([ ! -d " + project + "build/cache/def456 ] && echo def=gone || echo def=here)")
        let _ = teardown_fixture(project)
        probe.contains("abc=gone") && probe.contains("def=gone")
    }
}

// ohyd: prune/info walk the cache natively (avra_remove_tree / avra_dir_size /
// avra_file_mtime) instead of interpolating the $PWD-derived cache path into a
// shell command. These exercise the behaviours the flat-entry specs above don't:
// recursive deletion of a nested entry, the mtime cutoff with the DEFAULT
// max-age, and the recursive size readout.
spec "bs2 cache prune: recursively deletes a nested cache entry" {
    then "a stale entry containing nested subdirs is fully removed" {
        let project = "/tmp/avra_prune_nested_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "rm -rf " + project + " && " +
            "mkdir -p " + project + "build/cache/entry/nested/deep && " +
            "printf 'x' > " + project + "build/cache/entry/unit.ll && " +
            "printf 'y' > " + project + "build/cache/entry/nested/deep/obj.o && " +
            "touch -t 202001010000 " + project + "build/cache/entry && " +
            "cd " + project + " && " + bs2 + " cache prune --max-age-days 0 2>&1 && " +
            "([ ! -d " + project + "build/cache/entry ] && echo entry=gone || echo entry=here)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("evicted 1") && probe.contains("entry=gone")
    }
}

spec "bs2 cache prune: keeps recent entries under the default max-age (mtime cutoff)" {
    then "a 2020 entry is evicted while a fresh entry survives" {
        let project = "/tmp/avra_prune_recency_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        // Default max-age is 30 days: the backdated entry is stale, the fresh
        // one (mtime ≈ now) is kept — exercising avra_datetime_now + the cutoff.
        let probe = avra_shell_exec(
            "rm -rf " + project + " && " +
            "mkdir -p " + project + "build/cache/old " + project + "build/cache/fresh && " +
            "printf 'x' > " + project + "build/cache/old/u.ll && " +
            "printf 'y' > " + project + "build/cache/fresh/u.ll && " +
            "touch -t 202001010000 " + project + "build/cache/old && " +
            "cd " + project + " && " + bs2 + " cache prune 2>&1 && " +
            "([ ! -d " + project + "build/cache/old ] && echo old=gone || echo old=here) && " +
            "([ -d " + project + "build/cache/fresh ] && echo fresh=kept || echo fresh=gone)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("evicted 1") && probe.contains("old=gone") && probe.contains("fresh=kept")
    }
}

spec "bs2 cache info: reports a recursive byte size" {
    then "size sums nested files and renders a unit" {
        let project = "/tmp/avra_info_size_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        // 2048 + 1024 = 3072 bytes = 3K; the nested file must be counted.
        let out = avra_shell_exec(
            "rm -rf " + project + " && " +
            "mkdir -p " + project + "build/cache/e/nested && " +
            "head -c 2048 /dev/zero > " + project + "build/cache/e/big.ll && " +
            "head -c 1024 /dev/zero > " + project + "build/cache/e/nested/d.o && " +
            "cd " + project + " && " + bs2 + " cache info 2>&1")
        let _ = avra_shell_exec("rm -rf " + project)
        out.contains("entries: 1") && out.contains("size:") && out.contains("3K")
    }
}

// ohyd safety: avra_parse_int is atoll, so a non-numeric or negative
// --max-age-days would otherwise set the cutoff to now-or-later and evict the
// WHOLE cache. valid_max_age_days rejects it; the old shell `find -mtime +<bad>`
// likewise deleted nothing. Both cases must error AND leave the cache intact.
spec "bs2 cache prune: rejects a non-numeric --max-age-days (no deletion)" {
    then "`--max-age-days abc` errors and the cache is left intact" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "touch -t 202001010000 " + project + "build/cache/abc123 " + project + "build/cache/def456 && " +
            "cd " + project + " && (" + bs2 + " cache prune --max-age-days abc 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo rc=zero; else echo rc=nonzero; fi) && " +
            "echo --- && " +
            "([ -d " + project + "build/cache/abc123 ] && echo kept=yes || echo kept=no)")
        let _ = teardown_fixture(project)
        // rc=nonzero: the bad arg must EXIT non-zero (not just print) so scripts
        // see the failure; kept=yes: the cache is left fully intact.
        probe.contains("kept=yes") && probe.contains("--max-age-days") && probe.contains("rc=nonzero")
    }
}

spec "bs2 cache prune: rejects a negative --max-age-days (no deletion)" {
    then "`--max-age-days -5` errors and the cache is left intact" {
        let project = setup_fixture()
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let probe = avra_shell_exec(
            "touch -t 202001010000 " + project + "build/cache/abc123 " + project + "build/cache/def456 && " +
            "cd " + project + " && (" + bs2 + " cache prune --max-age-days -5 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo rc=zero; else echo rc=nonzero; fi) && " +
            "echo --- && " +
            "([ -d " + project + "build/cache/abc123 ] && echo kept=yes || echo kept=no)")
        let _ = teardown_fixture(project)
        // rc=nonzero: the bad arg must EXIT non-zero (not just print) so scripts
        // see the failure; kept=yes: the cache is left fully intact.
        probe.contains("kept=yes") && probe.contains("--max-age-days") && probe.contains("rc=nonzero")
    }
}

// zp5b: clear-failed scans build/cache/fixture_stdout/*.out and deletes
// captures carrying the `: FAIL` token (a frozen transient / stale-env
// failure) while leaving passing captures warm. We seed two .out files —
// one FAIL, one ok — and assert the surgical eviction. A distinct temp dir
// avoids the shared setup_fixture (whose `info` test pins exactly 2 dir
// entries — adding fixture_stdout there would break that count).
fn setup_fixture_stdout(project: string, marker_a: string, marker_b: string) -> string {
    avra_shell_exec(
        "rm -rf " + project + " && " +
        "mkdir -p " + project + "build/cache/fixture_stdout && " +
        "printf '" + marker_a + "\\n' > " + project + "build/cache/fixture_stdout/aaa.out && " +
        "printf '" + marker_b + "\\n' > " + project + "build/cache/fixture_stdout/bbb.out")
}

spec "bs2 cache clear-failed: evicts only frozen-FAIL captures" {
    then "a `: FAIL` capture is deleted while a passing capture survives" {
        let project = "/tmp/avra_clear_failed_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let _ = setup_fixture_stdout(project, "PROBE x: FAIL", "PROBE y: ok")
        let probe = avra_shell_exec(
            "cd " + project + " && " + bs2 + " cache clear-failed 2>&1 && " +
            "echo --- && " +
            "([ ! -f " + project + "build/cache/fixture_stdout/aaa.out ] && echo failed=gone || echo failed=here) && " +
            "([ -f " + project + "build/cache/fixture_stdout/bbb.out ] && echo ok=kept || echo ok=lost)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("deleted 1") && probe.contains("failed=gone") && probe.contains("ok=kept")
    }
}

spec "bs2 cache clear-failed --dry-run: lists without deleting" {
    then "the frozen-FAIL capture is reported but stays on disk" {
        let project = "/tmp/avra_clear_failed_dry_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let _ = setup_fixture_stdout(project, "PROBE x: FAIL", "PROBE y: ok")
        let probe = avra_shell_exec(
            "cd " + project + " && " + bs2 + " cache clear-failed --dry-run 2>&1 && " +
            "echo --- && " +
            "([ -f " + project + "build/cache/fixture_stdout/aaa.out ] && echo still=yes || echo still=no)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("would delete 1") && probe.contains("still=yes")
    }
}

// The two no-op branches: a cache with only passing captures, and a cache
// directory that has no fixture_stdout subdir at all. Both must report cleanly
// and touch nothing — the common case when a dev runs the command speculatively.
spec "bs2 cache clear-failed: a cache with only passing captures is a no-op" {
    then "reports no frozen-FAIL captures and leaves both passing captures" {
        let project = "/tmp/avra_clear_failed_clean_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let _ = setup_fixture_stdout(project, "PROBE x: ok", "PROBE y: ok")
        let probe = avra_shell_exec(
            "cd " + project + " && " + bs2 + " cache clear-failed 2>&1 && " +
            "echo --- && " +
            "([ -f " + project + "build/cache/fixture_stdout/aaa.out ] && echo a=kept || echo a=gone) && " +
            "([ -f " + project + "build/cache/fixture_stdout/bbb.out ] && echo b=kept || echo b=gone)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("no frozen-FAIL captures") && probe.contains("a=kept") && probe.contains("b=kept")
    }
}

spec "bs2 cache clear-failed: a cache with no fixture_stdout dir is handled" {
    then "reports no fixture_stdout cache when only the parent build/cache exists" {
        let project = "/tmp/avra_clear_failed_nodir_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        // build/cache exists (so the parent guard passes) but fixture_stdout does not.
        let _ = avra_shell_exec("rm -rf " + project + " && mkdir -p " + project + "build/cache/otherdir")
        let probe = avra_shell_exec("cd " + project + " && " + bs2 + " cache clear-failed 2>&1")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("no fixture_stdout cache")
    }
}

// Evictor/writer agreement: a PASSING capture that merely prints `: FAIL` in a
// non-probe log line (`step: FAIL recovered`) must NOT be evicted. A bare
// substring `: FAIL` would match it, but capture_has_probe_failure anchors on
// the `PROBE <name>: FAIL` line form. Live end-to-end regression for that
// anchoring — clear-failed keeps passing captures.
spec "bs2 cache clear-failed: a passing capture with `: FAIL` in a non-probe log line is kept" {
    then "a `step: FAIL recovered` prose capture (not a probe FAIL) survives clear-failed" {
        let project = "/tmp/avra_clear_failed_prose_fixture/"
        let bs2 = avra_shell_exec("pwd").trim() + "/build/bs2"
        let _ = setup_fixture_stdout(project, "step: FAIL recovered", "PROBE y: ok")
        let probe = avra_shell_exec(
            "cd " + project + " && " + bs2 + " cache clear-failed 2>&1 && " +
            "echo --- && " +
            "([ -f " + project + "build/cache/fixture_stdout/aaa.out ] && echo prose=kept || echo prose=gone)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("no frozen-FAIL captures") && probe.contains("prose=kept")
    }
}
