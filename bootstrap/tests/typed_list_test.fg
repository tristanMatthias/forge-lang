type TlPoint = { x: int, y: int }

fn tl_run() -> string {
    let users = [
        {"name": "alice", "score": "90"},
        {"name": "bob", "score": "85"},
        {"name": "carol", "score": "95"},
    ]

    forge_test_capture_start()
    for user in users {
        println(user.get("name"))
    }

    let points = [TlPoint { x: 1, y: 2 }, TlPoint { x: 3, y: 4 }]
    for p in points {
        println(string(p.x + p.y))
    }

    let first = users[0]
    println(first.get("score"))

    let high = [90, 85, 95, 70].filter((s) -> s >= 90)
    mut sum = 0
    for s in high {
        sum = sum + s
    }
    println(string(sum))
    forge_test_capture_stop()
}

spec "typed list" {
    then "typed list output" {
        tl_run() == "alice\nbob\ncarol\n3\n7\n90\n185"
    }
}
