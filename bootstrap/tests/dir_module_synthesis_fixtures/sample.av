// Fixture for synthesize_subdir_module_decls + filtered variant
// (g2eo.1.2 prep). Builds a tmp directory layout in /tmp and asserts
// the synthesizer's behaviour both with no filter and with a filter
// that already declares some of the subdirs.
//
// Used by ../dir_module_synthesis_test.av; that test asserts on the
// PROBE lines this fixture prints.

extern fn avra_shell_exec(cmd: string) -> string

use @std.avrac.features.modules.{
    synthesize_subdir_module_decls,
    synthesize_subdir_module_decls_filtered,
}
use @std.avrac.core.{Stmt, SStmt, sstmt_dummy}

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

// Walk the synthesized stmts and produce a comma-joined list of the
// Module names found. Lets the test assert exactly what got synthesized.
fn module_names(stmts: List<SStmt>) -> string {
    mut out = ""
    mut i = 0
    while i < stmts.length {
        let ss = stmts[i]
        let name = match ss.node {
            .Module(n, _) -> n
            _ -> ""
        }
        if name != "" {
            out = if out == "" { name } else { out + "," + name }
        }
        i = i + 1
    }
    out
}

fn count_stmts(stmts: List<SStmt>) -> int {
    stmts.length
}

fn main() -> int {
    let root = "/tmp/avra_dirmod_synth_fixture"
    avra_shell_exec("rm -rf " + root)
    avra_shell_exec("mkdir -p " + root + "/sub_a")
    avra_shell_exec("mkdir -p " + root + "/sub_b")
    avra_shell_exec("mkdir -p " + root + "/sub_c")
    // g2eo.1.2: list_avra_module_subdirs requires each candidate
    // dir to have at least one top-level .av file. Without this,
    // bare-stub directories (e.g. features/error_messages/ which
    // only hosts examples/) would get auto-loaded as empty modules.
    avra_shell_exec("touch " + root + "/sub_a/x.av")
    avra_shell_exec("touch " + root + "/sub_b/y.av")
    avra_shell_exec("touch " + root + "/sub_c/z.av")

    // ── unfiltered ─────────────────────────────────────────────
    let all = synthesize_subdir_module_decls(root)
    probe("unfiltered_count_3", count_stmts(all) == 3)
    let names_all = module_names(all)
    probe("unfiltered_has_sub_a", names_all.contains("sub_a"))
    probe("unfiltered_has_sub_b", names_all.contains("sub_b"))
    probe("unfiltered_has_sub_c", names_all.contains("sub_c"))

    let empty_body: List<SStmt> = []

    // ── filtered: one subdir already declared ──────────────────
    let existing_one: List<SStmt> = [
        sstmt_dummy(Stmt.Module("sub_a", empty_body)),
    ]
    let some = synthesize_subdir_module_decls_filtered(root, existing_one)
    probe("filtered_one_count_2", count_stmts(some) == 2)
    let names_some = module_names(some)
    probe("filtered_one_skip_sub_a", !names_some.contains("sub_a"))
    probe("filtered_one_keeps_sub_b", names_some.contains("sub_b"))
    probe("filtered_one_keeps_sub_c", names_some.contains("sub_c"))

    // ── filtered: ALL subdirs declared → empty result ──────────
    let existing_all: List<SStmt> = [
        sstmt_dummy(Stmt.Module("sub_a", empty_body)),
        sstmt_dummy(Stmt.Module("sub_b", empty_body)),
        sstmt_dummy(Stmt.Module("sub_c", empty_body)),
    ]
    let filtered_all = synthesize_subdir_module_decls_filtered(root, existing_all)
    probe("filtered_all_count_0", count_stmts(filtered_all) == 0)

    // ── filtered: missing-dir is empty ─────────────────────────
    let empty_existing: List<SStmt> = []
    let nodir = synthesize_subdir_module_decls_filtered("/tmp/avra_dirmod_synth_does_not_exist_xx", empty_existing)
    probe("missing_dir_count_0", count_stmts(nodir) == 0)

    avra_shell_exec("rm -rf " + root)
    0
}
