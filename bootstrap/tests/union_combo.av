/// expect: bool: 1
/// expect: float: 3.14
/// expect: struct: Alice
/// expect: passed int: 42
/// expect: returned: hello from union
/// expect: nested: got 7

type Person = {
    name: string,
    age: int,
}

fn show_multi(val: int | string | bool | float) -> string {
    match val {
        bool(b) -> "bool: " + string(b)
        float(f) -> "float: " + string(f)
        int(n) -> "int: " + string(n)
        string(s) -> "string: " + s
    }
}

fn show_struct(val: int | Person) -> string {
    match val {
        int(n) -> "int: " + string(n)
        Person(p) -> "struct: " + p.name
    }
}

fn passthrough(val: int | string) -> int | string {
    val
}

fn make_union(use_int: bool) -> int | string {
    if use_int {
        let x: int | string = 42
        x
    } else {
        let x: int | string = "hello from union"
        x
    }
}

fn nested_match(outer: int | string) -> string {
    match outer {
        int(n) -> {
            let inner: int | string = n + 1
            match inner {
                int(m) -> "nested: got " + string(m)
                _ -> "unexpected"
            }
        }
        _ -> "not int"
    }
}

fn main() {
    // Multi-type unions
    println(show_multi(true))
    println(show_multi(3.14))

    // Struct in union
    let p = Person { name: "Alice", age: 30 }
    println(show_struct(p))

    // Passthrough preserves union
    let v: int | string = 42
    match passthrough(v) {
        int(n) -> println("passed int: " + string(n))
        string(s) -> println("passed string: " + s)
    }

    // Function returning union
    let r = make_union(false)
    match r {
        int(n) -> println("returned: " + string(n))
        string(s) -> println("returned: " + s)
    }

    // Nested match on unions
    let x: int | string = 6
    println(nested_match(x))
}
