// COMBO: for loop + match + null coalescing + struct
type Entry = { key: string, value: int }

enum MaybeEntry {
    None,
    Some(entry: Entry),
}

fn lookup(entries: MaybeEntry) -> int {
    match entries {
        .None -> -1
        .Some(e) -> e.value
    }
}

// Sum values from a sparse sequence
mut total = 0
for i in 0..5 {
    let entry = if i == 2 || i == 4 {
        MaybeEntry.Some(Entry { key: "found", value: (i + 1) * 10 })
    } else {
        MaybeEntry.None
    }
    let val = lookup(entry)
    if val > 0 {
        total = total + val
    }
}
// i=2: value=30, i=4: value=50 => total=80
println(string(total))
