spec "bs2 eval exits non-zero + shows F-code on parse error" {
    then "exit non-zero on parse failure" {
        write_fixture("/tmp/avra_cli_exit_eval_bad.av", "1 +\n")
        avra_shell_exec_status("./build/bs2 eval /tmp/avra_cli_exit_eval_bad.av > /dev/null 2>&1") != 0
