// WHY: diff-test corpus — exercises list + map literal codegen, list
// iteration with `for x in`, map `.get`, and the `with` struct-update operator.
type Point = { x: int, y: int }

fn main() {
    let xs = [1, 2, 3, 4]
    mut sum = 0
    for v in xs { sum = sum + v }
    println(string(sum))

    let m = {"a": 1, "b": 2}
    let got = m.get("a")
    if got != null { println(string(got!)) }

    let p = Point { x: 1, y: 2 }
    let p2 = p with { y: 9 }
    println(string(p2.y))
}
