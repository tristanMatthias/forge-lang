// WHY: diff-test corpus — a small standalone repro exercising channel codegen
// (channel<T>, send, recv, try_recv, close) and the recv -> T? null-on-close
// handoff. The selfhost pass also compiles this path (the compiler's parallel
// build driver uses channels), but a divergence here surfaces against ~20
// lines instead of the 590k-line selfhost IR. No @std, no spec/given/then.
fn drain(ch: Channel<int>) -> int {
    mut sum = 0
    mut more = true
    while more {
        let v = ch.recv()
        if v == null { more = false } else { sum = sum + v! }
    }
    sum
}

fn main() {
    let ch = channel<int>(4)
    ch.send(1)
    ch.send(2)
    ch.send(3)
    let peek = ch.try_recv()
    if peek != null { println(string(peek!)) }
    ch.close()
    println(string(drain(ch)))
}
