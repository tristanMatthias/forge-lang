fn fs_format_pi() -> string {
    avra_test_capture_start()
    let pi = 3.14159265
    println("pi is ${pi:.2f}")
    println("sci ${pi:.3e}")
    avra_test_capture_stop()
}

fn fs_format_int() -> string {
    avra_test_capture_start()
    let x = 255
    println("hex ${x:x}")
    println("padded ${42:08d}")
    avra_test_capture_stop()
}

spec "format spec" {
    then "float formatting" {
        fs_format_pi() == "pi is 3.14\nsci 3.142e+00"
    }
    then "int formatting" {
        fs_format_int() == "hex ff\npadded 00000042"
    }
}
