/// expect: circle area=12.56
/// expect: rect area=6
/// expect: circle perimeter=6.28

trait Shape {
    fn area(self) -> float
    fn name(self) -> string
}

type Circle = { r: float }
type Rect = { w: float, h: float }

impl Shape for Circle {
    fn area(self) -> float { 3.14 * self.r * self.r }
    fn name(self) -> string { "circle" }
}

impl Shape for Rect {
    fn area(self) -> float { self.w * self.h }
    fn name(self) -> string { "rect" }
}

fn describe(s: Shape) {
    println(s.name() + " area=" + string(s.area()))
}

trait HasPerimeter {
    fn perimeter(self) -> float
    fn label(self) -> string
}

impl HasPerimeter for Circle {
    fn perimeter(self) -> float { 2.0 * 3.14 * self.r }
    fn label(self) -> string { "circle" }
}

fn show_perimeter(s: HasPerimeter) {
    println(s.label() + " perimeter=" + string(s.perimeter()))
}

fn main() {
    describe(Circle { r: 2.0 })
    describe(Rect { w: 2.0, h: 3.0 })
    show_perimeter(Circle { r: 1.0 })
}
