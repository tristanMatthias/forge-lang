// Fixture: validates @std.avrac.build.pool — the in-Avra worker pool
// that future iterations use to replace `xargs -P` parallel runs.
// The pool spawns up to N concurrent /bin/sh workers, each running
// one queued command, reaps completed workers, and dispatches the
// next pending command until the queue drains.
//
// Tracking ticket: forge-crafting-intepreters-e20h.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_process_env_get(name: string) -> string
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_uptime_ms() -> int

use @std.avrac.build.{pool_run}

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

// Build a queue of N sentinel commands. Each command writes a marker
// file so we can verify (a) every command ran and (b) the rc folds
// correctly when one fails.
fn cmds_with_markers(n: int, marker_dir: string) -> List<string> {
    mut cmds = []
    mut i = 0
    while i < n {
        cmds.push("touch ${marker_dir}/job${string(i)}.done; sleep 0.05; exit 0")
        i = i + 1
    }
    cmds
}

// Mix successful + failing commands to verify rc propagation.
fn cmds_mixed_rc(dir: string) -> List<string> {
    [
        "touch ${dir}/ok1.done; exit 0",
        "touch ${dir}/ok2.done; exit 0",
        "touch ${dir}/fail.done; exit 7",
        "touch ${dir}/ok3.done; exit 0",
    ]
}

fn count_files(dir: string, glob: string) -> int {
    let raw = avra_shell_exec("ls ${dir}/${glob} 2>/dev/null | wc -l | tr -d ' '")
    avra_parse_int(raw)
}

extern fn avra_parse_int(s: string) -> int

fn main() -> int {
    let dir = "/tmp/avra_e20h_pool"
    avra_shell_exec("rm -rf ${dir} && mkdir -p ${dir}")

    // Case 1: empty queue. pool_run returns 0, no-op.
    let rc_empty = pool_run([], 4)
    probe("empty_queue_rc_zero", rc_empty == 0)

    // Case 2: 8 successful commands, jobs=4. Wall time should be
    // roughly 2 sleep-windows (~100ms), not 8 (~400ms). Each worker
    // gets reused twice.
    avra_shell_exec("rm -f ${dir}/job*.done")
    let cmds_ok = cmds_with_markers(8, dir)
    probe("queue_length_eight", cmds_ok.length == 8)
    let t0 = avra_uptime_ms()
    let rc_ok = pool_run(cmds_ok, 4)
    let elapsed = avra_uptime_ms() - t0
    probe("eight_success_rc_zero", rc_ok == 0)
    probe("all_eight_markers_landed", count_files(dir, "job*.done") == 8)
    // 8 jobs × 50ms each, 4 concurrent → ~100ms theoretical minimum.
    // Allow generous slack for spawn overhead + system noise but
    // assert it's WAY under 8 × 50 = 400ms (which would imply
    // sequential execution — pool isn't actually parallelizing).
    probe("parallel_under_serial_baseline", elapsed < 350)

    // Case 3: a failing command folds into max_rc. Pool still
    // drains every job (no early-exit on failure). Wipe the WHOLE
    // dir so leftover markers from case 2 don't pollute the count.
    avra_shell_exec("rm -rf ${dir} && mkdir -p ${dir}")
    let rc_mixed = pool_run(cmds_mixed_rc(dir), 2)
    probe("mixed_rc_returns_worst_code", rc_mixed == 7)
    probe("all_four_markers_landed_despite_failure", count_files(dir, "*.done") == 4)

    // Case 4: jobs=1 falls back to serial — still correct.
    avra_shell_exec("rm -rf ${dir} && mkdir -p ${dir}")
    let cmds_serial = cmds_with_markers(3, dir)
    let rc_serial = pool_run(cmds_serial, 1)
    probe("serial_rc_zero", rc_serial == 0)
    probe("serial_all_markers", count_files(dir, "job*.done") == 3)

    // Case 5: more workers than jobs (jobs=8, cmds=2). Pool must
    // not block on idle workers waiting for nonexistent extra work.
    // Wall time should be ~one sleep window since both run
    // concurrently; the 6 idle workers stay idle and don't burn CPU.
    avra_shell_exec("rm -rf ${dir} && mkdir -p ${dir}")
    let cmds_two = cmds_with_markers(2, dir)
    let t_oversubscribed_start = avra_uptime_ms()
    let rc_oversubscribed = pool_run(cmds_two, 8)
    let elapsed_oversubscribed = avra_uptime_ms() - t_oversubscribed_start
    probe("oversubscribed_rc_zero", rc_oversubscribed == 0)
    probe("oversubscribed_both_markers", count_files(dir, "job*.done") == 2)
    // 2 jobs × 50ms each = 50ms theoretical floor; allow 250ms
    // for overhead. Way under what would happen if workers blocked
    // (the pool's poll loop would burn 50ms per tick × however many
    // ticks — could easily exceed 1s on a buggy implementation).
    probe("oversubscribed_finishes_quickly", elapsed_oversubscribed < 250)

    0
}
