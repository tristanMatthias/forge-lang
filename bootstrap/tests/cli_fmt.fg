// Test: the fmt subcommand parses and re-renders Forge syntax.
// This program exercises the formatter's output by testing the
// underlying format functions on a simple program.

fn add(a: int, b: int) -> int { a + b }

type Point = { x: int, y: int }

enum Color { Red, Green, Blue }

fn main() {
    let p = Point { x: 1, y: 2 }
    println(string(p.x + p.y))

    let c = Color.Red
    match c {
        .Red -> println("red")
        .Green -> println("green")
        .Blue -> println("blue")
    }

    let sum = add(10, 20)
    println(string(sum))

    for i in 0..3 {
        println(string(i))
    }
}
