// JSON stringify and parse via C runtime.

extern fn avra_json_stringify_int(value: int) -> string
extern fn avra_json_stringify_string(s: string) -> string
extern fn avra_json_stringify_bool(value: bool) -> string
extern fn avra_json_get_int(json: string, key: string) -> int
extern fn avra_json_get_string(json: string, key: string) -> string
extern fn avra_json_get_bool(json: string, key: string) -> bool

fn main() {
    // Stringify
    println(avra_json_stringify_int(42))
    println(avra_json_stringify_string("hello"))
    println(avra_json_stringify_bool(true))
    println(avra_json_stringify_bool(false))

    // Parse object fields
    let json = "{\"name\": \"Alice\", \"age\": 30, \"active\": true}"
    println(avra_json_get_string(json, "name"))
    println(string(avra_json_get_int(json, "age")))
    println(string(avra_json_get_bool(json, "active")))

    // Escaping
    println(avra_json_stringify_string("say \"hi\""))
}
