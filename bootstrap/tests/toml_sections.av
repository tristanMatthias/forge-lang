// Section-aware TOML parsing for avra.toml package manifests.

extern fn avra_toml_get_section_string(toml: string, section: string, key: string) -> string
extern fn avra_toml_has_section(toml: string, section: string) -> int

fn main() {
    let config = "[package]\nname = \"my-app\"\nversion = \"0.1.0\"\n\n[dependencies]\n@std/io = \"1.0\"\n@std/json = \"1.0\"\n"

    // Section-aware string extraction
    println(avra_toml_get_section_string(config, "package", "name"))
    println(avra_toml_get_section_string(config, "package", "version"))
    println(avra_toml_get_section_string(config, "dependencies", "@std/io"))
    println(avra_toml_get_section_string(config, "dependencies", "@std/json"))

    // Section existence check
    println(string(avra_toml_has_section(config, "package")))
    println(string(avra_toml_has_section(config, "dependencies")))
    println(string(avra_toml_has_section(config, "missing")))

    // Key not in section returns empty
    let missing = avra_toml_get_section_string(config, "package", "author")
    println("missing='${missing}'")
}
