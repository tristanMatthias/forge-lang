// 9ixv regression: the bootstrap CLI's own source compiles cleanly
// when AVRA_USE_METADATA=1 routes every `use @std.<pkg>` import
// through the synthesised metadata stubs instead of re-parsing the
// producer source. Before 9ixv this path produced 188 module-resolution
// + orphan-impl + trait-conformance errors because the synthesizer
// emitted a flat decl list under one Module wrap, losing the nested
// `mod` structure consumers walk via `use foo.bar.baz.X`.
//
// Tracking ticket: forge-crafting-intepreters-9ixv (closed).

use @std.avrac.test_runner.{cached_fixture_run, probe_ok}

fn cmc_run() -> string {
    cached_fixture_run("tests/cli_metadata_compile_fixtures/sample.av")
}

spec "9ixv regression: @std/avrac --lib --emit_metadata pre-builds cleanly" {
    then "build rc is zero" {
        probe_ok("cli_metadata_compile", "avrac_lib_build_rc_zero", cmc_run())
    }
    then "@std/avrac's own meta.bin lands" {
        probe_ok("cli_metadata_compile", "avrac_meta_present", cmc_run())
    }
    then "@std/lsp's meta.bin lands as a transitive pre-build" {
        probe_ok("cli_metadata_compile", "std_lsp_meta_present", cmc_run())
    }
    then "@std/json's meta.bin lands" {
        probe_ok("cli_metadata_compile", "std_json_meta_present", cmc_run())
    }
    then "@std/cli's meta.bin lands" {
        probe_ok("cli_metadata_compile", "std_cli_meta_present", cmc_run())
    }
    then "@std/crypto's meta.bin lands" {
        probe_ok("cli_metadata_compile", "std_crypto_meta_present", cmc_run())
    }
}

spec "9ixv regression: cli/main.av compiles via metadata fast-path" {
    then "compile rc is zero" {
        probe_ok("cli_metadata_compile", "cli_compile_rc_zero", cmc_run())
    }
    then "main.av.ll is emitted" {
        probe_ok("cli_metadata_compile", "cli_main_ll_present", cmc_run())
    }
    then "AVRA_DEPS_OUT sidecar records the producer .o paths" {
        probe_ok("cli_metadata_compile", "cli_deps_sidecar_present", cmc_run())
    }
    then "deps sidecar lists at least five @std/* producers" {
        probe_ok("cli_metadata_compile", "cli_deps_at_least_five_producers", cmc_run())
    }
}
