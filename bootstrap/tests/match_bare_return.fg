// Test: bare return in match arms (without braces).

fn classify(n: int) -> string {
    match n {
        0 -> return "zero"
        1 -> return "one"
        _ -> return "other"
    }
}

fn describe(s: string) -> string {
    match s {
        "a" -> return "first letter"
        "z" -> return "last letter"
        _ -> return "something else"
    }
}

fn main() {
    println(classify(0))
    println(classify(1))
    println(classify(42))
    println(describe("a"))
    println(describe("z"))
    println(describe("m"))
}
