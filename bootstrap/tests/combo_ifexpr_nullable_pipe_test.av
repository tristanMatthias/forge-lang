fn cinp_double(n: int) -> int { n * 2 }
fn cinp_negate(n: int) -> int { -n }

fn cinp_safe_div(a: int, b: int) -> int? {
    if b == 0 { return null }
    a / b
}

fn cinp_greet(name: string?) -> string {
    `hello ${name ?? "stranger"}`
}

type CinpPair = { a: int, b: int }

fn cinp_run() -> string {
    let x = 42
    avra_test_capture_start()
    println(`value: ${if x > 0 { "positive" } else { "negative" }}`)
    println(`double: ${string(if x > 20 { x * 2 } else { x })}`)
    let piped = (if true { 5 } else { 10 }) |> cinp_double |> cinp_negate
    println(string(piped))
    let r1 = cinp_safe_div(10, 2) ?? -1
    let r2 = cinp_safe_div(10, 0) ?? -1
    println(string(r1))
    println(string(r2))
    println(cinp_greet("Alice"))
    println(cinp_greet(null))
    let p = if x > 0 { CinpPair { a: 1, b: 2 } } else { CinpPair { a: 0, b: 0 } }
    println(string(p.a))
    println(string(p.b))
    avra_test_capture_stop()
}

spec "combo ifexpr nullable pipe" {
    then "if-expr nullable pipe combo" {
        cinp_run() == "value: positive\ndouble: 84\n-10\n5\n-1\nhello Alice\nhello stranger\n1\n2"
    }
}
