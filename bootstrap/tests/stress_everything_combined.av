/// expect: pipeline: processed 3 items, total=60
/// expect: tree sum: 21
/// expect: error chain: caught: divide error

enum Result<T, E> { Ok(value: T), Err(error: E) }
enum Tree { Leaf(v: int), Node(left: Tree, right: Tree) }

fn sum_tree(t: Tree) -> int {
    match t {
        .Leaf(v) -> v
        .Node(l, r) -> sum_tree(l) + sum_tree(r)
    }
}

fn safe_div(a: int, b: int) -> Result<int, string> {
    if b == 0 { Result.Err("divide error") }
    else { Result.Ok(a / b) }
}

fn chain_ops(x: int) -> Result<string, string> {
    let a = safe_div(100, x)?
    let b = safe_div(a, x)?
    Result.Ok("result: ${string(b)}")
}

fn main() {
    let data = [5, 10, 15, 20, 25]
    let processed = data
        .map((x) -> x * 2)
        .filter((x) -> x > 10)
    let total = processed.reduce(0, (acc, x) -> acc + x)
    println("pipeline: processed ${string(processed.length)} items, total=${string(total)}")

    let tree = Tree.Node(
        Tree.Node(Tree.Leaf(1), Tree.Leaf(2)),
        Tree.Node(
            Tree.Leaf(3),
            Tree.Node(Tree.Leaf(6), Tree.Leaf(9))
        )
    )
    println("tree sum: ${string(sum_tree(tree))}")

    match chain_ops(0) {
        .Ok(v) -> println("ok: ${v}")
        .Err(e) -> println("error chain: caught: ${e}")
    }
}
