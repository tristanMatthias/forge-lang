// Aggressive combinatorial test for dynamic dispatch.

trait Animal {
    fn speak(self) -> string
    fn legs(self) -> int
}

type Dog = { name: string, breed: string }
type Cat = { name: string, indoor: bool }
type Spider = { species: string }

impl Animal for Dog {
    fn speak(self) -> string { "woof from " + self.name }
    fn legs(self) -> int { 4 }
}

impl Animal for Cat {
    fn speak(self) -> string { "meow from " + self.name }
    fn legs(self) -> int { 4 }
}

impl Animal for Spider {
    fn speak(self) -> string { "..." }
    fn legs(self) -> int { 8 }
}

// Dyn dispatch + function argument
fn describe_animal(a: Animal) -> string {
    a.speak() + " (" + string(a.legs()) + " legs)"
}

// Dyn dispatch + multiple trait methods
fn total_legs(a: Animal, b: Animal) -> int {
    a.legs() + b.legs()
}

// Dyn dispatch + if expression
fn which_sound(a: Animal, loud: bool) -> string {
    if loud {
        a.speak() + "!!!"
    } else {
        a.speak()
    }
}

// Dyn dispatch + string templates
fn animal_template(a: Animal) -> string {
    `${a.speak()} has ${string(a.legs())} legs`
}

// Dyn dispatch + match
fn classify_legs(a: Animal) -> string {
    let n = a.legs()
    if n <= 4 {
        "normal"
    } else {
        "many"
    }
}

fn main() {
    let d: Animal = Dog { name: "Rex", breed: "Lab" }
    let c: Animal = Cat { name: "Whiskers", indoor: true }
    let s: Animal = Spider { species: "tarantula" }

    // Basic
    println(d.speak())
    println(c.speak())
    println(s.speak())
    println(string(d.legs()))
    println(string(s.legs()))

    // Function args
    println(describe_animal(d))
    println(describe_animal(c))
    println(describe_animal(s))

    // Multiple trait objects
    println(string(total_legs(d, s)))

    // With if
    println(which_sound(d, true))
    println(which_sound(c, false))

    // With templates
    println(animal_template(d))
    println(animal_template(s))

    // With classify
    println(classify_legs(d))
    println(classify_legs(s))
}
