// with expression + enum + match + tuple combinations
type Point = { x: int, y: int, z: int }

// with expression chain
let p1 = Point { x: 1, y: 2, z: 3 }
let p2 = p1 with { x: 10 }
let p3 = p2 with { y: 20, z: 30 }
println(`${string(p3.x)},${string(p3.y)},${string(p3.z)}`)

// Tuple + destructuring + match
let pair = (42, "hello")
let (num, text) = pair
println(string(num))
println(text)

// Enum carrying tuple
enum Result {
    Ok(value: int)
    Err(code: int, msg: string)
}

fn describe_result(r: Result) -> string {
    match r {
        .Ok(v) -> `success: ${string(v)}`
        .Err(c, m) -> `error ${string(c)}: ${m}`
    }
}
println(describe_result(Result.Ok(42)))
println(describe_result(Result.Err(404, "not found")))

// Match returning tuple
fn divide(a: int, b: int) -> Result {
    match b {
        0 -> Result.Err(1, "division by zero")
        _ -> Result.Ok(a / b)
    }
}
println(describe_result(divide(10, 3)))
println(describe_result(divide(10, 0)))

// with on match result
type Config = { width: int, height: int, title: string }
let base = Config { width: 800, height: 600, title: "default" }
let custom = base with { title: "my app", width: 1920 }
println(`${custom.title}: ${string(custom.width)}x${string(custom.height)}`)
