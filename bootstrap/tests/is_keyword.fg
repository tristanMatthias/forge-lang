// `is` keyword — enum variant type checking.

enum Color { Red, Green, Blue }

enum Option {
    Some(value: int)
    None
}

fn describe(c: Color) -> string {
    if c is .Red { return "red" }
    if c is .Green { return "green" }
    "blue"
}

fn main() {
    // Basic variant check
    let c = Color.Red
    println(string(c is .Red))
    println(string(c is .Blue))

    // In if-condition
    println(describe(Color.Red))
    println(describe(Color.Green))
    println(describe(Color.Blue))

    // With payload variants
    let opt = Option.Some(42)
    if opt is .Some {
        println("has value")
    }
    if opt is .None {
        println("empty")
    }

    // With null variant
    let empty = Option.None
    println(string(empty is .None))
    println(string(empty is .Some))

    // In logical expressions
    let x = Color.Green
    if x is .Red || x is .Green {
        println("warm color")
    }
}
