spec "substring" {
    then "first word" {
        "hello world".substring(0, 5) == "hello"
    }
    then "second word" {
        "hello world".substring(6, 11) == "world"
    }
    then "full string" {
        "hello world".substring(0, 11) == "hello world"
    }
    then "length" {
        "hello world".length == 11
    }
}
