// Concurrency: spawn, join, channels.

extern fn avra_spawn(closure: int) -> int
extern fn avra_thread_join(handle: int)
extern fn avra_channel_new() -> ptr
extern fn avra_channel_send(ch: ptr, value: int)
extern fn avra_channel_recv(ch: ptr) -> int

fn worker() {
    println("thread done")
}

mut global_ch: ptr = null
fn sender() {
    avra_channel_send(global_ch, 10)
    avra_channel_send(global_ch, 20)
    avra_channel_send(global_ch, 30)
}

fn main() {
    // Spawn + join
    let h = avra_spawn(worker)
    avra_thread_join(h)

    // Channels
    global_ch = avra_channel_new()
    let h2 = avra_spawn(sender)
    let a = avra_channel_recv(global_ch)
    let b = avra_channel_recv(global_ch)
    let c = avra_channel_recv(global_ch)
    avra_thread_join(h2)
    println(string(a + b + c))
}
