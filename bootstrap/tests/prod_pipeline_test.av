type PplStudent = { name: string, score: int }

fn ppl_run() -> string {
    let data = [
        PplStudent { name: "Alice", score: 95 },
        PplStudent { name: "Bob", score: 82 },
        PplStudent { name: "Carol", score: 91 },
        PplStudent { name: "Dave", score: 67 },
        PplStudent { name: "Eve", score: 88 },
    ]

    mut high_count = 0
    mut total = 0
    avra_test_capture_start()
    for s in data {
        total = total + s.score
        if s.score >= 90 {
            high_count = high_count + 1
            println(`${s.name}: ${string(s.score)} (high)`)
        }
    }
    println(`Total: ${string(total)}`)
    println(`High performers: ${string(high_count)}`)
    println(`Average: ${string(total / 5)}`)
    avra_test_capture_stop()
}

spec "prod pipeline" {
    then "pipeline output" {
        ppl_run() == "Alice: 95 (high)\nCarol: 91 (high)\nTotal: 423\nHigh performers: 2\nAverage: 84"
    }
}
