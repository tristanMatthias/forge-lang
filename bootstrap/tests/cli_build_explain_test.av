// `bs2 build --explain` flag. Split from cli_build_flags_test for
// per-file shard parallelism.

extern fn avra_shell_exec(cmd: string) -> string

fn bs2_path() -> string {
    avra_shell_exec("pwd").trim() + "/build/bs2"
}

fn setup_project() -> string {
    let project = "/tmp/avra_build_explain_fixture/"
    avra_shell_exec("rm -rf " + project)
    avra_shell_exec("mkdir -p " + project + "build")
    avra_shell_exec("ln -s " + bs2_path() + " " + project + "build/bs2")
    avra_shell_exec("printf '[package]\nname = \"flags-fixture\"\nversion = \"0.1.0\"\n[[bin]]\nname = \"flags-fixture\"\npath = \"main.av\"\n' > " + project + "avra.toml")
    let entry = "main"
    let body = "fn " + entry + "() -> int { 0 }"
    avra_shell_exec("printf '%s\\n' '" + body + "' > " + project + entry + ".av")
    project
}

fn teardown_project(project: string) -> string {
    avra_shell_exec("rm -rf " + project)
}

spec "bs2 build --explain: cold build reports a rebuild reason" {
    then "first build emits a `rebuild <fp> — <reason>` line" {
        let project = setup_project()
        let out = avra_shell_exec(
            "cd " + project + " && " + bs2_path() + " build --explain 2>&1 || true")
        let _ = teardown_project(project)
        out.contains("rebuild ")
    }
}

spec "bs2 build --explain: warm build reports a cached hit" {
    then "second build emits a `cached <fp>` line" {
        let project = setup_project()
        let _ = avra_shell_exec(
            "cd " + project + " && " + bs2_path() + " build 2>&1 || true")
        let out = avra_shell_exec(
            "cd " + project + " && " + bs2_path() + " build --explain 2>&1 || true")
        let _ = teardown_project(project)
        out.contains("cached ")
    }
}
