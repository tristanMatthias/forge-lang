type SwConfig = {
    host: string,
    port: int,
    debug: int,
    timeout: int,
}

fn sw_run() -> string {
    let base = SwConfig { host: "localhost", port: 80, debug: 0, timeout: 30 }

    let dev = base with { debug: 1 }
    let prod = base with { host: "prod.example.com", port: 443 }
    let staging = base with { host: "staging" } with { port: 8443 } with { debug: 1 }

    forge_test_capture_start()
    println(string(dev.debug))
    println(string(dev.port))

    println(prod.host)
    println(string(prod.port))

    println(staging.host)
    println(string(staging.port))
    println(string(staging.debug))
    println(string(staging.timeout))

    println(base.host)
    println(string(base.port))
    forge_test_capture_stop()
}

spec "stress with" {
    then "with expression output" {
        sw_run() == "1\n80\nprod.example.com\n443\nstaging\n8443\n1\n30\nlocalhost\n80"
    }
}
