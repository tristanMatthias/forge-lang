// Fixture program exercising @std.avrac.build.metadata's BytesWriter /
// BytesReader end-to-end. Compiled + run by tests/metadata_codec_test.av;
// each round-trip prints `PROBE <name>: ok` (or `: FAIL`) so the
// parent test asserts on the lines.
//
// Why a fixture rather than a direct import: same reason as
// build_cache_test.av and fingerprint_test.av — the resolver
// currently duplicates @std.avrac.X module wrappers when a test
// pool imports them (forge-crafting-intepreters-dnq4). The fixture
// is a single-program compile, so there's only ever one copy.

use @std.avrac.build.{
    BytesWriter, BytesReader, writer_new, reader_new, sym_id_for,
    SectionKind, MetadataHeader, SectionFrame,
    METADATA_MAGIC, METADATA_VERSION_MAJOR, METADATA_VERSION_MINOR,
    TypeDeclKind, TypeDeclEntry, FnDeclEntry,
    ConstValueKind, ConstDeclEntry,
    MetaTraitMethodList,
    ImplDeclEntry, ImplMethodRefList,
    UnitMetadata, TypeDeclList, FnDeclList, ConstDeclList, ImplDeclList,
    unit_metadata_new,
    metadata_write, metadata_read, metadata_file_exists,
}
use @std.avrac.core.{
    Stmt, StmtList, Expr, ExprList, TypeParamList,
    ValueType, TypeList, FieldList, VariantList, ParamList,
    AnnotationList, vtype_eq, sstmt_dummy, stmt_unwrap, find_annotation,
}
use @std.avrac.build.{extract_unit_metadata}
use @std.avrac.build.{synthesize_unit_stmts}

extern fn avra_bytes_make(len: int) -> bytes
extern fn avra_bytes_set(b: bytes, idx: int, val: int)
extern fn avra_shell_exec(cmd: string) -> string

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

fn vt_roundtrip(name: string, vt: ValueType) {
    let w = writer_new()
    w.vtype(vt)
    let r = reader_new(w.finish())
    let decoded = r.vtype()
    probe("vt_${name}", vtype_eq(vt, decoded))
}

fn field_list_count(fs: FieldList) -> int {
    match fs {
        .End -> 0
        .Node(_, _, next) -> 1 + field_list_count(next)
    }
}

fn variant_list_count(vs: VariantList) -> int {
    match vs {
        .End -> 0
        .Node(_, _, next) -> 1 + variant_list_count(next)
    }
}

fn main() -> int {
    // Scalar round-trips
    let w1 = writer_new()
    w1.u8(0x42)
    let r1 = reader_new(w1.finish())
    probe("u8_low", r1.u8() == 0x42)

    let w0 = writer_new()
    w0.u8(0)
    let buf0 = w0.finish()
    probe("u8_zero", buf0.length == 1 && reader_new(buf0).u8() == 0)

    let w16 = writer_new()
    w16.u16_le(0x1234)
    probe("u16", reader_new(w16.finish()).u16_le() == 0x1234)

    let w32 = writer_new()
    w32.u32_le(0xDEADBEEF)
    probe("u32", reader_new(w32.finish()).u32_le() == 0xDEADBEEF)

    let w64 = writer_new()
    w64.u64_le(0x1122334455667788)
    probe("u64", reader_new(w64.finish()).u64_le() == 0x1122334455667788)

    // Byte order
    let wbo = writer_new()
    wbo.u32_le(0x04030201)
    let bbo = wbo.finish()
    probe("u32_le_byte_order",
        bbo.byte(0) == 0x01 && bbo.byte(1) == 0x02 && bbo.byte(2) == 0x03 && bbo.byte(3) == 0x04)

    // Strings
    let ws = writer_new()
    ws.string("hello")
    probe("string", reader_new(ws.finish()).string() == "hello")

    let wse = writer_new()
    wse.string("")
    let bse = wse.finish()
    probe("string_empty", bse.length == 4 && reader_new(bse).string() == "")

    let wss = writer_new()
    wss.string("first")
    wss.string("second")
    let rss = reader_new(wss.finish())
    let s1 = rss.string()
    let s2 = rss.string()
    probe("string_pair", s1 == "first" && s2 == "second")

    // Mixed header-style record
    let wh = writer_new()
    wh.u32_le(0x41564D44)
    wh.string("@std::avrac::build")
    wh.u64_le(0xCAFEBABEDEADBEEF)
    let rh = reader_new(wh.finish())
    let m = rh.u32_le()
    let n = rh.string()
    let id = rh.u64_le()
    probe("header_record",
        m == 0x41564D44 && n == "@std::avrac::build" && id == 0xCAFEBABEDEADBEEF)

    // Cursor exhaustion
    let we = writer_new()
    we.u32_le(1)
    we.u32_le(2)
    let re = reader_new(we.finish())
    re.u32_le()
    re.u32_le()
    probe("remaining_zero", re.remaining() == 0)

    // Raw passthrough preserves embedded NUL
    let payload = avra_bytes_make(4)
    avra_bytes_set(payload, 0, 0xAA)
    avra_bytes_set(payload, 1, 0x00)
    avra_bytes_set(payload, 2, 0xBB)
    avra_bytes_set(payload, 3, 0x00)
    let wr = writer_new()
    wr.raw(payload)
    let rr = reader_new(wr.finish())
    let out = rr.raw(4)
    probe("raw_with_nul",
        out.length == 4 && out.byte(0) == 0xAA && out.byte(1) == 0 && out.byte(2) == 0xBB && out.byte(3) == 0)

    // Stable symbol IDs — deterministic FNV-1a-64
    let id1 = sym_id_for("@std::avrac::build::cache::Cache")
    let id2 = sym_id_for("@std::avrac::build::cache::Cache")
    probe("sym_id_deterministic", id1 == id2)

    let id_a = sym_id_for("@std::avrac::build::cache::Cache")
    let id_b = sym_id_for("@std::avrac::build::cache::CacheKey")
    probe("sym_id_distinct_for_distinct_input", id_a != id_b)

    // Empty string hashes to the FNV-1a-64 offset basis
    probe("sym_id_empty_is_offset", sym_id_for("") == 0xCBF29CE484222325)

    // Known FNV-1a-64 vector: "" → 0xCBF29CE484222325 (above), "a" → 0xAF63DC4C8601EC8C
    probe("sym_id_a", sym_id_for("a") == 0xAF63DC4C8601EC8C)

    // File header round-trip
    let fp = avra_bytes_make(32)
    mut fi = 0
    while fi < 32 {
        avra_bytes_set(fp, fi, fi)
        fi = fi + 1
    }
    let wh2 = writer_new()
    wh2.header("@std::avrac::build", fp, 3)
    let rh2 = reader_new(wh2.finish())
    let hdr = rh2.header()
    probe("header_magic", hdr.magic == METADATA_MAGIC)
    probe("header_version", hdr.version_major == METADATA_VERSION_MAJOR && hdr.version_minor == METADATA_VERSION_MINOR)
    probe("header_unit_name", hdr.unit_name == "@std::avrac::build")
    probe("header_fingerprint_len", hdr.fingerprint.length == 32)
    probe("header_fingerprint_byte0", hdr.fingerprint.byte(0) == 0)
    probe("header_fingerprint_byte31", hdr.fingerprint.byte(31) == 31)
    probe("header_section_count", hdr.section_count == 3)

    // Section framing round-trip
    let body = avra_bytes_make(5)
    avra_bytes_set(body, 0, 0xAA)
    avra_bytes_set(body, 1, 0xBB)
    avra_bytes_set(body, 2, 0xCC)
    avra_bytes_set(body, 3, 0xDD)
    avra_bytes_set(body, 4, 0xEE)
    let ws2 = writer_new()
    ws2.section(SectionKind.Fns, 7, body)
    let rs2 = reader_new(ws2.finish())
    let frame = rs2.section()
    probe("section_kind", frame.kind is .Fns)
    probe("section_entry_count", frame.entry_count == 7)
    probe("section_body_len", frame.body.length == 5)
    probe("section_body_byte0", frame.body.byte(0) == 0xAA)
    probe("section_body_byte4", frame.body.byte(4) == 0xEE)

    // Multi-section file: header + 2 sections decoded in order
    let bod1 = avra_bytes_make(2)
    avra_bytes_set(bod1, 0, 1)
    avra_bytes_set(bod1, 1, 2)
    let bod2 = avra_bytes_make(3)
    avra_bytes_set(bod2, 0, 9)
    avra_bytes_set(bod2, 1, 8)
    avra_bytes_set(bod2, 2, 7)
    let wm2 = writer_new()
    wm2.header("@std::test::two_sections", fp, 2)
    wm2.section(SectionKind.Types, 1, bod1)
    wm2.section(SectionKind.Consts, 1, bod2)
    let rm2 = reader_new(wm2.finish())
    let h2 = rm2.header()
    let f1 = rm2.section()
    let f2 = rm2.section()
    probe("multi_header_count", h2.section_count == 2)
    probe("multi_section1_kind", f1.kind is .Types)
    probe("multi_section1_body0", f1.body.byte(0) == 1)
    probe("multi_section2_kind", f2.kind is .Consts)
    probe("multi_section2_body2", f2.body.byte(2) == 7)

    // ValueType encoding round-trips
    vt_roundtrip("int", ValueType.Int)
    vt_roundtrip("bool", ValueType.Bool)
    vt_roundtrip("float", ValueType.Float)
    vt_roundtrip("str", ValueType.Str)
    vt_roundtrip("bytes", ValueType.Bytes)
    vt_roundtrip("void", ValueType.Void)
    vt_roundtrip("unknown", ValueType.Unknown)
    vt_roundtrip("u8", ValueType.U8)
    vt_roundtrip("u16", ValueType.U16)
    vt_roundtrip("u32", ValueType.U32)
    vt_roundtrip("u64", ValueType.U64)
    vt_roundtrip("i8", ValueType.I8)
    vt_roundtrip("i16", ValueType.I16)
    vt_roundtrip("i32", ValueType.I32)
    vt_roundtrip("struct", ValueType.Struct("@std::cache::Cache", 0))
    vt_roundtrip("trait", ValueType.Trait("@std::io::Reader", 0))
    vt_roundtrip("list_int", ValueType.List(ValueType.Int))
    vt_roundtrip("list_str", ValueType.List(ValueType.Str))
    vt_roundtrip("nested_list", ValueType.List(ValueType.List(ValueType.Int)))
    vt_roundtrip("newtype", ValueType.Newtype("UserId", ValueType.Int, 0))
    vt_roundtrip("task_int", ValueType.Task(ValueType.Int))
    vt_roundtrip("closure", ValueType.Closure(3, ValueType.Bool))
    vt_roundtrip("fn_ret_str", ValueType.Fn(ValueType.Str))

    let enum_args = TypeList.Node(ValueType.Int, TypeList.Node(ValueType.Str, TypeList.End))
    vt_roundtrip("enum_with_args", ValueType.Enum("Result", enum_args, 0))

    let tuple_types = TypeList.Node(ValueType.Int, TypeList.Node(ValueType.Bool, TypeList.End))
    vt_roundtrip("tuple", ValueType.Tuple(tuple_types))

    let union_types = TypeList.Node(ValueType.Int, TypeList.Node(ValueType.Str, TypeList.Node(ValueType.Bool, TypeList.End)))
    vt_roundtrip("union", ValueType.Union(union_types))

    let fn_params = TypeList.Node(ValueType.Int, TypeList.Node(ValueType.Str, TypeList.End))
    vt_roundtrip("fn_typed", ValueType.FnTyped(fn_params, ValueType.Bool))

    // TYPES section per-entry round-trips.
    // Struct: type Point = { x: int, y: int }
    let pt_fields = FieldList.Node("x", ValueType.Int, FieldList.Node("y", ValueType.Int, FieldList.End))
    let pt_entry = TypeDeclEntry {
        sym_id: sym_id_for("@test::Point"),
        kind: TypeDeclKind.StructDecl,
        name: "@test::Point",
        type_params: TypeParamList.End,
        fields: pt_fields,
        variants: VariantList.End,
        inner_vt: ValueType.Unknown,
        methods: MetaTraitMethodList.End,
    }
    let wpt = writer_new()
    wpt.type_decl(pt_entry)
    let rpt = reader_new(wpt.finish())
    let pt_decoded = rpt.type_decl()
    probe("type_struct_name", pt_decoded.name == "@test::Point")
    probe("type_struct_kind", pt_decoded.kind is .StructDecl)
    probe("type_struct_sym_id", pt_decoded.sym_id == sym_id_for("@test::Point"))
    probe("type_struct_field_count", field_list_count(pt_decoded.fields) == 2)

    // Newtype: type UserId = int
    let uid_entry = TypeDeclEntry {
        sym_id: sym_id_for("@test::UserId"),
        kind: TypeDeclKind.NewtypeDecl,
        name: "@test::UserId",
        type_params: TypeParamList.End,
        fields: FieldList.End,
        variants: VariantList.End,
        inner_vt: ValueType.Int,
        methods: MetaTraitMethodList.End,
    }
    let wuid = writer_new()
    wuid.type_decl(uid_entry)
    let ruid = reader_new(wuid.finish())
    let uid_decoded = ruid.type_decl()
    probe("type_newtype_name", uid_decoded.name == "@test::UserId")
    probe("type_newtype_kind", uid_decoded.kind is .NewtypeDecl)
    probe("type_newtype_inner", vtype_eq(uid_decoded.inner_vt, ValueType.Int))

    // Enum: enum Color { Red, Green, Blue }
    let col_variants = VariantList.Node("Red", FieldList.End,
        VariantList.Node("Green", FieldList.End,
        VariantList.Node("Blue", FieldList.End, VariantList.End)))
    let col_entry = TypeDeclEntry {
        sym_id: sym_id_for("@test::Color"),
        kind: TypeDeclKind.EnumDecl,
        name: "@test::Color",
        type_params: TypeParamList.End,
        fields: FieldList.End,
        variants: col_variants,
        inner_vt: ValueType.Unknown,
        methods: MetaTraitMethodList.End,
    }
    let wcol = writer_new()
    wcol.type_decl(col_entry)
    let rcol = reader_new(wcol.finish())
    let col_decoded = rcol.type_decl()
    probe("type_enum_name", col_decoded.name == "@test::Color")
    probe("type_enum_kind", col_decoded.kind is .EnumDecl)
    probe("type_enum_variant_count", variant_list_count(col_decoded.variants) == 3)

    // FNS section per-entry round-trips.
    // fn add(a: int, b: int) -> int  (exported)
    let add_params = ParamList.Node("a", ValueType.Int, ParamList.Node("b", ValueType.Int, ParamList.End))
    let add_entry = FnDeclEntry {
        sym_id: sym_id_for("@test::add"),
        name: "@test::add",
        type_params: TypeParamList.End,
        exported: true,
        is_extern: false,
        params: add_params,
        ret: ValueType.Int,
    }
    let wfn = writer_new()
    wfn.fn_decl(add_entry)
    let rfn = reader_new(wfn.finish())
    let add_decoded = rfn.fn_decl()
    probe("fn_name", add_decoded.name == "@test::add")
    probe("fn_sym_id", add_decoded.sym_id == sym_id_for("@test::add"))
    probe("fn_exported", add_decoded.exported)
    probe("fn_not_extern", !add_decoded.is_extern)
    probe("fn_ret_int", vtype_eq(add_decoded.ret, ValueType.Int))

    // extern fn avra_now() -> int  (extern, no params)
    let now_entry = FnDeclEntry {
        sym_id: sym_id_for("avra_now"),
        name: "avra_now",
        type_params: TypeParamList.End,
        exported: true,
        is_extern: true,
        params: ParamList.End,
        ret: ValueType.Int,
    }
    let wext = writer_new()
    wext.fn_decl(now_entry)
    let rext = reader_new(wext.finish())
    let now_decoded = rext.fn_decl()
    probe("fn_extern", now_decoded.is_extern)
    probe("fn_no_params", match now_decoded.params { .End -> true, _ -> false })

    // fn process(items: List<int>, label: string) -> Result<int, string>
    let proc_params = ParamList.Node("items", ValueType.List(ValueType.Int),
        ParamList.Node("label", ValueType.Str, ParamList.End))
    let proc_ret_args = TypeList.Node(ValueType.Int, TypeList.Node(ValueType.Str, TypeList.End))
    let proc_entry = FnDeclEntry {
        sym_id: sym_id_for("@test::process"),
        name: "@test::process",
        type_params: TypeParamList.End,
        exported: false,
        is_extern: false,
        params: proc_params,
        ret: ValueType.Enum("Result", proc_ret_args, 0),
    }
    let wproc = writer_new()
    wproc.fn_decl(proc_entry)
    let rproc = reader_new(wproc.finish())
    let proc_decoded = rproc.fn_decl()
    probe("fn_compound_param", vtype_eq(proc_decoded.ret, ValueType.Enum("Result", proc_ret_args, 0)))
    probe("fn_not_exported", !proc_decoded.exported)

    // End-to-end: header + TYPES section + FNS section
    let e2e_w = writer_new()
    let e2e_fp = avra_bytes_make(32)
    e2e_w.header("@test::e2e", e2e_fp, 2)

    // Encode TYPES body containing one struct entry
    let e2e_struct_fields = FieldList.Node("x", ValueType.Int, FieldList.End)
    let e2e_struct_entry = TypeDeclEntry {
        sym_id: sym_id_for("@test::e2e::Cell"),
        kind: TypeDeclKind.StructDecl,
        name: "@test::e2e::Cell",
        type_params: TypeParamList.End,
        fields: e2e_struct_fields,
        variants: VariantList.End,
        inner_vt: ValueType.Unknown,
        methods: MetaTraitMethodList.End,
    }
    let e2e_types_body_w = writer_new()
    e2e_types_body_w.type_decl(e2e_struct_entry)
    e2e_w.section(SectionKind.Types, 1, e2e_types_body_w.finish())

    // Encode FNS body containing one fn entry
    let e2e_fn_entry = FnDeclEntry {
        sym_id: sym_id_for("@test::e2e::cell_x"),
        name: "@test::e2e::cell_x",
        type_params: TypeParamList.End,
        exported: true,
        is_extern: false,
        params: ParamList.Node("c", ValueType.Struct("@test::e2e::Cell", 0), ParamList.End),
        ret: ValueType.Int,
    }
    let e2e_fns_body_w = writer_new()
    e2e_fns_body_w.fn_decl(e2e_fn_entry)
    e2e_w.section(SectionKind.Fns, 1, e2e_fns_body_w.finish())

    // Decode: header, then both sections, then per-entry within each
    let e2e_buf = e2e_w.finish()
    let e2e_r = reader_new(e2e_buf)
    let e2e_hdr = e2e_r.header()
    probe("e2e_magic", e2e_hdr.magic == METADATA_MAGIC)
    probe("e2e_unit_name", e2e_hdr.unit_name == "@test::e2e")
    probe("e2e_section_count", e2e_hdr.section_count == 2)

    let types_frame = e2e_r.section()
    probe("e2e_types_kind", types_frame.kind is .Types)
    probe("e2e_types_count", types_frame.entry_count == 1)
    let types_body_r = reader_new(types_frame.body)
    let decoded_struct = types_body_r.type_decl()
    probe("e2e_struct_name", decoded_struct.name == "@test::e2e::Cell")
    probe("e2e_struct_field0",
        match decoded_struct.fields {
            .Node(n, _, _) -> n == "x"
            .End -> false
        })

    let fns_frame = e2e_r.section()
    probe("e2e_fns_kind", fns_frame.kind is .Fns)
    let fns_body_r = reader_new(fns_frame.body)
    let decoded_fn = fns_body_r.fn_decl()
    probe("e2e_fn_name", decoded_fn.name == "@test::e2e::cell_x")
    probe("e2e_fn_exported", decoded_fn.exported)
    probe("e2e_remaining_zero", e2e_r.remaining() == 0)

    // CONSTS section per-entry round-trips.
    // const PI: float = 3.14
    let pi_entry = ConstDeclEntry {
        sym_id: sym_id_for("@test::PI"),
        name: "@test::PI",
        exported: true,
        ty: ValueType.Float,
        value_kind: ConstValueKind.FloatValue,
        int_value: 0x4009_1EB8_51EB_851F,  // canonical bits for 3.14
        str_value: "",
    }
    let wpi = writer_new()
    wpi.const_decl(pi_entry)
    let rpi = reader_new(wpi.finish())
    let pi_decoded = rpi.const_decl()
    probe("const_float_name", pi_decoded.name == "@test::PI")
    probe("const_float_exported", pi_decoded.exported)
    probe("const_float_kind", pi_decoded.value_kind is .FloatValue)
    probe("const_float_bits", pi_decoded.int_value == 0x4009_1EB8_51EB_851F)

    // const VERSION: string = "1.0.0"
    let ver_entry = ConstDeclEntry {
        sym_id: sym_id_for("@test::VERSION"),
        name: "@test::VERSION",
        exported: true,
        ty: ValueType.Str,
        value_kind: ConstValueKind.StrValue,
        int_value: 0,
        str_value: "1.0.0",
    }
    let wver = writer_new()
    wver.const_decl(ver_entry)
    let rver = reader_new(wver.finish())
    let ver_decoded = rver.const_decl()
    probe("const_str_name", ver_decoded.name == "@test::VERSION")
    probe("const_str_kind", ver_decoded.value_kind is .StrValue)
    probe("const_str_value", ver_decoded.str_value == "1.0.0")

    // const DEBUG: bool = false  (non-exported)
    let dbg_entry = ConstDeclEntry {
        sym_id: sym_id_for("@test::DEBUG"),
        name: "@test::DEBUG",
        exported: false,
        ty: ValueType.Bool,
        value_kind: ConstValueKind.BoolValue,
        int_value: 0,
        str_value: "",
    }
    let wdbg = writer_new()
    wdbg.const_decl(dbg_entry)
    let rdbg = reader_new(wdbg.finish())
    let dbg_decoded = rdbg.const_decl()
    probe("const_bool_kind", dbg_decoded.value_kind is .BoolValue)
    probe("const_bool_false", dbg_decoded.int_value == 0)
    probe("const_bool_not_exported", !dbg_decoded.exported)

    // const MAX_RETRIES: int = 42
    let mr_entry = ConstDeclEntry {
        sym_id: sym_id_for("@test::MAX_RETRIES"),
        name: "@test::MAX_RETRIES",
        exported: true,
        ty: ValueType.Int,
        value_kind: ConstValueKind.IntValue,
        int_value: 42,
        str_value: "",
    }
    let wmr = writer_new()
    wmr.const_decl(mr_entry)
    let rmr = reader_new(wmr.finish())
    let mr_decoded = rmr.const_decl()
    probe("const_int_kind", mr_decoded.value_kind is .IntValue)
    probe("const_int_value", mr_decoded.int_value == 42)

    // TraitDecl: trait Display { fn show(self) -> string }
    let show_method_params = ParamList.Node("self", ValueType.Struct("Self", 0), ParamList.End)
    let display_methods =
        MetaTraitMethodList.Node("show", show_method_params, ValueType.Str, MetaTraitMethodList.End)
    let display_entry = TypeDeclEntry {
        sym_id: sym_id_for("@test::Display"),
        kind: TypeDeclKind.TraitDecl,
        name: "@test::Display",
        type_params: TypeParamList.End,
        fields: FieldList.End,
        variants: VariantList.End,
        inner_vt: ValueType.Unknown,
        methods: display_methods,
    }
    let wdisp = writer_new()
    wdisp.type_decl(display_entry)
    let rdisp = reader_new(wdisp.finish())
    let disp_decoded = rdisp.type_decl()
    probe("type_trait_name", disp_decoded.name == "@test::Display")
    probe("type_trait_kind", disp_decoded.kind is .TraitDecl)
    probe("type_trait_method_present",
        match disp_decoded.methods {
            .Node(name, _, _, _) -> name == "show"
            .End -> false
        })
    probe("type_trait_method_ret",
        match disp_decoded.methods {
            .Node(_, _, ret, _) -> vtype_eq(ret, ValueType.Str)
            .End -> false
        })

    // IMPLS section per-entry round-trips.
    // impl Display for Point { fn show(self) -> string; fn debug(self) -> string }
    let imp_methods =
        ImplMethodRefList.Node("show", sym_id_for("@test::Point__show"),
        ImplMethodRefList.Node("debug", sym_id_for("@test::Point__debug"),
        ImplMethodRefList.End))
    let imp_entry = ImplDeclEntry {
        trait_sym_id: sym_id_for("@test::Display"),
        trait_name: "@test::Display",
        type_sym_id: sym_id_for("@test::Point"),
        type_name: "@test::Point",
        methods: imp_methods,
    }
    let wimp = writer_new()
    wimp.impl_decl(imp_entry)
    let rimp = reader_new(wimp.finish())
    let imp_decoded = rimp.impl_decl()
    probe("impl_trait_name", imp_decoded.trait_name == "@test::Display")
    probe("impl_trait_sym_id", imp_decoded.trait_sym_id == sym_id_for("@test::Display"))
    probe("impl_type_name", imp_decoded.type_name == "@test::Point")
    probe("impl_type_sym_id", imp_decoded.type_sym_id == sym_id_for("@test::Point"))
    probe("impl_method0_name",
        match imp_decoded.methods {
            .Node(n, _, _) -> n == "show"
            .End -> false
        })
    probe("impl_method0_fn_id",
        match imp_decoded.methods {
            .Node(_, fid, _) -> fid == sym_id_for("@test::Point__show")
            .End -> false
        })
    let imp_tail = match imp_decoded.methods {
        .Node(_, _, t) -> t
        .End -> ImplMethodRefList.End
    }
    probe("impl_method1_name",
        match imp_tail {
            .Node(n, _, _) -> n == "debug"
            .End -> false
        })

    // Empty impl (no methods) — also legal: e.g. marker traits
    let marker_entry = ImplDeclEntry {
        trait_sym_id: sym_id_for("@test::Marker"),
        trait_name: "@test::Marker",
        type_sym_id: sym_id_for("@test::Point"),
        type_name: "@test::Point",
        methods: ImplMethodRefList.End,
    }
    let wmrk = writer_new()
    wmrk.impl_decl(marker_entry)
    let rmrk = reader_new(wmrk.finish())
    let mrk_decoded = rmrk.impl_decl()
    probe("impl_marker_no_methods",
        match mrk_decoded.methods {
            .End -> true
            _ -> false
        })

    // Unit-level orchestration: build a UnitMetadata with one entry
    // in each of the four sections, write+read it as a complete file,
    // verify every entry survives.
    let unit_fp = avra_bytes_make(32)
    avra_bytes_set(unit_fp, 0, 0xAB)
    avra_bytes_set(unit_fp, 31, 0xCD)

    let unit_struct_fields = FieldList.Node("name", ValueType.Str, FieldList.End)
    let unit_struct_entry = TypeDeclEntry {
        sym_id: sym_id_for("@unit::User"),
        kind: TypeDeclKind.StructDecl,
        name: "@unit::User",
        type_params: TypeParamList.End,
        fields: unit_struct_fields,
        variants: VariantList.End,
        inner_vt: ValueType.Unknown,
        methods: MetaTraitMethodList.End,
    }
    let unit_fn_entry = FnDeclEntry {
        sym_id: sym_id_for("@unit::greet"),
        name: "@unit::greet",
        type_params: TypeParamList.End,
        exported: true,
        is_extern: false,
        params: ParamList.Node("u", ValueType.Struct("@unit::User", 0), ParamList.End),
        ret: ValueType.Str,
    }
    let unit_const_entry = ConstDeclEntry {
        sym_id: sym_id_for("@unit::DEFAULT_NAME"),
        name: "@unit::DEFAULT_NAME",
        exported: true,
        ty: ValueType.Str,
        value_kind: ConstValueKind.StrValue,
        int_value: 0,
        str_value: "anonymous",
    }
    let unit_impl_entry = ImplDeclEntry {
        trait_sym_id: sym_id_for("@unit::Display"),
        trait_name: "@unit::Display",
        type_sym_id: sym_id_for("@unit::User"),
        type_name: "@unit::User",
        methods: ImplMethodRefList.Node("show", sym_id_for("@unit::User__show"), ImplMethodRefList.End),
    }

    let mut unit = unit_metadata_new("@unit", unit_fp)
    unit = UnitMetadata {
        unit_name: unit.unit_name,
        fingerprint: unit.fingerprint,
        types: TypeDeclList.Node(unit_struct_entry, TypeDeclList.End),
        fns: FnDeclList.Node(unit_fn_entry, FnDeclList.End),
        consts: ConstDeclList.Node(unit_const_entry, ConstDeclList.End),
        impls: ImplDeclList.Node(unit_impl_entry, ImplDeclList.End),
    }

    let unit_w = writer_new()
    unit_w.unit(unit)
    let unit_buf = unit_w.finish()
    let unit_r = reader_new(unit_buf)
    let decoded = unit_r.unit()
    probe("unit_name", decoded.unit_name == "@unit")
    probe("unit_fp_byte0", decoded.fingerprint.byte(0) == 0xAB)
    probe("unit_fp_byte31", decoded.fingerprint.byte(31) == 0xCD)
    probe("unit_types_present",
        match decoded.types {
            .Node(e, _) -> e.name == "@unit::User"
            .End -> false
        })
    probe("unit_fns_present",
        match decoded.fns {
            .Node(e, _) -> e.name == "@unit::greet"
            .End -> false
        })
    probe("unit_consts_present",
        match decoded.consts {
            .Node(e, _) -> e.str_value == "anonymous"
            .End -> false
        })
    probe("unit_impls_present",
        match decoded.impls {
            .Node(e, _) -> e.trait_name == "@unit::Display" && e.type_name == "@unit::User"
            .End -> false
        })
    probe("unit_reader_exhausted", unit_r.remaining() == 0)

    // AST → UnitMetadata extractor: hand-build a small StmtList that
    // covers each handled stmt kind, run extract_unit_metadata, and
    // verify the produced lists match.
    let ext_fp = avra_bytes_make(32)

    // type Pt = { x: int }
    let pt_fields_ast = FieldList.Node("x", ValueType.Int, FieldList.End)
    let s_type = sstmt_dummy(Stmt.TypeDecl("Pt", TypeParamList.End, pt_fields_ast))

    // export fn add(a: int, b: int) -> int { ... }  (body irrelevant for extraction)
    let add_params_ast = ParamList.Node("a", ValueType.Int, ParamList.Node("b", ValueType.Int, ParamList.End))
    let s_fn_inner = Stmt.Function("add", TypeParamList.End, add_params_ast, ValueType.Int, StmtList.End)
    let s_fn = sstmt_dummy(Stmt.Annotated(
        AnnotationList.Node("export", ExprList.End, AnnotationList.End),
        s_fn_inner,
    ))

    // const VERSION: string = "1.0"
    let s_const = sstmt_dummy(Stmt.Const("VERSION", ValueType.Str, Expr.String("\"1.0\"")))

    // const N: int = 42
    let s_const_int = sstmt_dummy(Stmt.Const("N", ValueType.Int, Expr.Number("42")))

    // extern fn host_now() -> int
    let s_extern = sstmt_dummy(Stmt.ExternFn("host_now", ParamList.End, ValueType.Int))

    let ext_stmts =
        StmtList.Node(s_type,
        StmtList.Node(s_fn,
        StmtList.Node(s_const,
        StmtList.Node(s_const_int,
        StmtList.Node(s_extern, StmtList.End)))))

    let extracted = extract_unit_metadata("@ext", ext_fp, ext_stmts)
    probe("extract_unit_name", extracted.unit_name == "@ext")
    probe("extract_type_qualified",
        match extracted.types {
            .Node(e, _) -> e.name == "@ext::Pt"
            .End -> false
        })
    probe("extract_fn_qualified",
        match extracted.fns {
            .Node(e, _) -> e.name == "@ext::add"
            .End -> false
        })
    probe("extract_fn_exported",
        match extracted.fns {
            .Node(e, _) -> e.exported
            .End -> false
        })
    probe("extract_const_str_value",
        match extracted.consts {
            .Node(e, _) -> e.str_value == "1.0" && e.value_kind is .StrValue
            .End -> false
        })
    let consts_tail = match extracted.consts {
        .Node(_, t) -> t
        .End -> ConstDeclList.End
    }
    probe("extract_const_int_value",
        match consts_tail {
            .Node(e, _) -> e.int_value == 42 && e.value_kind is .IntValue
            .End -> false
        })

    // Find the extern fn in the fns list (which has the exported fn first).
    let fns_tail = match extracted.fns {
        .Node(_, t) -> t
        .End -> FnDeclList.End
    }
    probe("extract_extern_is_extern",
        match fns_tail {
            // 9ixv: externs are now qualified by their declaring module
            // (was bare-name only) so the synthesizer can re-emit them
            // at the original nested-mod path. Fixture's unit_name is
            // "@ext" (see extract_unit_metadata call upstream).
            .Node(e, _) -> e.is_extern && e.name == "@ext::host_now"
            .End -> false
        })

    // Generics: a fn with type_params + a struct with type_params
    let gen_fn_tps = TypeParamList.Node("T", "", TypeParamList.End)
    let gen_fn_entry = FnDeclEntry {
        sym_id: sym_id_for("@gen::id"),
        name: "@gen::id",
        exported: true,
        is_extern: false,
        type_params: gen_fn_tps,
        params: ParamList.Node("x", ValueType.Struct("T", 0), ParamList.End),
        ret: ValueType.Struct("T", 0),
    }
    let wgen = writer_new()
    wgen.fn_decl(gen_fn_entry)
    let rgen = reader_new(wgen.finish())
    let gen_decoded = rgen.fn_decl()
    let gen_tail = match gen_decoded.type_params {
        .Node(_, _, t) -> t
        .End -> TypeParamList.End
    }
    probe("generic_fn_tparam_count",
        match gen_tail {
            .End -> true
            _ -> false
        })
    probe("generic_fn_tparam_name",
        match gen_decoded.type_params {
            .Node(n, _, _) -> n == "T"
            .End -> false
        })

    let gen_type_tps = TypeParamList.Node("K", "", TypeParamList.Node("V", "Display", TypeParamList.End))
    let gen_type_entry = TypeDeclEntry {
        sym_id: sym_id_for("@gen::Pair"),
        kind: TypeDeclKind.StructDecl,
        name: "@gen::Pair",
        type_params: gen_type_tps,
        fields: FieldList.Node("k", ValueType.Struct("K", 0), FieldList.Node("v", ValueType.Struct("V", 0), FieldList.End)),
        variants: VariantList.End,
        inner_vt: ValueType.Unknown,
        methods: MetaTraitMethodList.End,
    }
    let wgt = writer_new()
    wgt.type_decl(gen_type_entry)
    let rgt = reader_new(wgt.finish())
    let gt_decoded = rgt.type_decl()
    let gt_tail = match gt_decoded.type_params {
        .Node(_, _, t) -> t
        .End -> TypeParamList.End
    }
    probe("generic_struct_tparam_2nd_bound",
        match gt_tail {
            .Node(_, b, _) -> b == "Display"
            .End -> false
        })

    // File IO: write a UnitMetadata to disk, read it back, verify
    // the structure survives the round trip. Uses /tmp so the test
    // doesn't pollute the project tree; rm beforehand so a stale file
    // from a previous run doesn't mask a regression.
    let io_path = "/tmp/avra_metadata_io_probe.bin"
    avra_shell_exec("rm -f ${io_path}")
    let io_fp = avra_bytes_make(32)
    avra_bytes_set(io_fp, 0, 0x77)
    avra_bytes_set(io_fp, 31, 0x88)

    let io_struct = TypeDeclEntry {
        sym_id: sym_id_for("@io::Pt"),
        kind: TypeDeclKind.StructDecl,
        name: "@io::Pt",
        type_params: TypeParamList.End,
        fields: FieldList.Node("x", ValueType.Int, FieldList.End),
        variants: VariantList.End,
        inner_vt: ValueType.Unknown,
        methods: MetaTraitMethodList.End,
    }
    let io_unit = UnitMetadata {
        unit_name: "@io",
        fingerprint: io_fp,
        types: TypeDeclList.Node(io_struct, TypeDeclList.End),
        fns: FnDeclList.End,
        consts: ConstDeclList.End,
        impls: ImplDeclList.End,
    }

    let write_rc = metadata_write(io_path, io_unit)
    probe("io_write_returns_1", write_rc == 1)
    probe("io_file_exists_after_write", metadata_file_exists(io_path))

    let loaded = metadata_read(io_path)
    probe("io_read_unit_name", loaded.unit_name == "@io")
    probe("io_read_fp_byte0", loaded.fingerprint.byte(0) == 0x77)
    probe("io_read_fp_byte31", loaded.fingerprint.byte(31) == 0x88)
    probe("io_read_struct_name",
        match loaded.types {
            .Node(e, _) -> e.name == "@io::Pt"
            .End -> false
        })

    // Missing file path returns an empty UnitMetadata sentinel — caller
    // gates on metadata_file_exists when the distinction matters.
    let missing = metadata_read("/tmp/avra_metadata_does_not_exist.bin")
    probe("io_missing_file_empty_unit_name", missing.unit_name == "")

    // Synthesizer round-trip: extract from a hand-built AST, then
    // synth back to a StmtList. The body should be a Module wrapper
    // around the original public-surface items, qualified the same
    // way they came in.
    let synth_fields = FieldList.Node("x", ValueType.Int, FieldList.End)
    let synth_stmts = StmtList.Node(
        sstmt_dummy(Stmt.TypeDecl("Cell", TypeParamList.End, synth_fields)),
        StmtList.Node(
            sstmt_dummy(Stmt.Annotated(
                AnnotationList.Node("export", ExprList.End, AnnotationList.End),
                Stmt.Function("greet", TypeParamList.End, ParamList.End, ValueType.Str, StmtList.End),
            )),
            StmtList.Node(
                sstmt_dummy(Stmt.Const("BUILD", ValueType.Str, Expr.String("\"42\""))),
                StmtList.End,
            ),
        ),
    )

    let synth_meta = extract_unit_metadata("@synth", avra_bytes_make(32), synth_stmts)
    let synth_back = synthesize_unit_stmts(synth_meta)

    // The top of synth_back should be Stmt.Module("@synth", body).
    let synth_top = match synth_back {
        .Node(ss, _) -> stmt_unwrap(ss.node)
        .End -> Stmt.NoOp
    }
    probe("synth_top_is_module",
        match synth_top {
            .Module(name, _) -> name == "@synth"
            _ -> false
        })

    // The body inside the Module should contain a TypeDecl for
    // `Cell` (local name, not `@synth::Cell` — qualification happens
    // when the consumer's resolver re-walks the Module).
    let synth_body = match synth_top {
        .Module(_, body) -> body
        _ -> StmtList.End
    }
    probe("synth_body_first_is_typedecl",
        match synth_body {
            .Node(ss, _) -> {
                match stmt_unwrap(ss.node) {
                    .TypeDecl(name, _, _) -> name == "Cell"
                    _ -> false
                }
            }
            .End -> false
        })

    // The fn (second item) should round-trip with @export annotation
    // and the local name `greet`.
    let synth_body_tail = match synth_body {
        .Node(_, t) -> t
        .End -> StmtList.End
    }
    probe("synth_body_second_is_exported_fn",
        match synth_body_tail {
            .Node(ss, _) -> {
                // ss.node here is Annotated(@export, Annotated(@external_unit, Function)).
                // stmt_unwrap walks every Annotated layer down to the bare Function.
                match stmt_unwrap(ss.node) {
                    .Function(name, _, _, _, _) -> name == "greet"
                    _ -> false
                }
            }
            .End -> false
        })

    // The synthesizer must stamp every Avra fn with @external_unit so
    // the consumer's codegen skips body emission (the body lives in
    // the producing unit's compiled .o). find_annotation walks every
    // Annotated layer.
    probe("synth_body_second_has_external_unit",
        match synth_body_tail {
            .Node(ss, _) -> find_annotation(ss.node, "external_unit") != null
            .End -> false
        })

    // The const should round-trip with the literal preserved.
    let synth_body_third = match synth_body_tail {
        .Node(_, t) -> t
        .End -> StmtList.End
    }
    probe("synth_body_third_is_const",
        match synth_body_third {
            .Node(ss, _) -> {
                match stmt_unwrap(ss.node) {
                    .Const(name, _, _) -> name == "BUILD"
                    _ -> false
                }
            }
            .End -> false
        })

    // Many small writes (chunk concat correctness)
    let wm = writer_new()
    mut i = 0
    while i < 100 {
        wm.u8(i)
        i = i + 1
    }
    let bm = wm.finish()
    probe("many_writes",
        bm.length == 100 && bm.byte(0) == 0 && bm.byte(50) == 50 && bm.byte(99) == 99)

    0
}
