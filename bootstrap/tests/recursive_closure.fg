fn make_power(exp: int) -> fn(int) -> int {
    if exp == 0 {
        return (x) -> 1
    }
    if exp == 1 {
        return (x) -> x
    }
    let sub = make_power(exp - 1)
    (x) -> x * sub(x)
}
let square = make_power(2)
let cube = make_power(3)
println(string(square(5)))
println(string(cube(3)))
