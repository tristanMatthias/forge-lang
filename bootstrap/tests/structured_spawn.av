// Structured concurrency: spawned tasks are auto-awaited at scope exit.
// No manual avra_thread_join needed — the task group handles it.

extern fn usleep(usec: int) -> int

fn spawn_sequential() {
    // Spawn a single task — it completes before the function returns
    // because the task group awaits it at scope exit.
    spawn {
        usleep(1000)
        println("task done")
    }
    // No manual join needed — structured concurrency awaits at return.
}

fn main() {
    spawn_sequential()
    // This must print AFTER "task done" because spawn_sequential
    // awaits its task group before returning.
    println("after structured spawn")
}
