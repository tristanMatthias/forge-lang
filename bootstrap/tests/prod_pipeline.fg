// Data processing pipeline — lists + maps + for-in + templates
type Student = { name: string, score: int }

let data = [
    Student { name: "Alice", score: 95 },
    Student { name: "Bob", score: 82 },
    Student { name: "Carol", score: 91 },
    Student { name: "Dave", score: 67 },
    Student { name: "Eve", score: 88 },
]

mut high_count = 0
mut total = 0
for s in data {
    total = total + s.score
    if s.score >= 90 {
        high_count = high_count + 1
        println(`${s.name}: ${string(s.score)} (high)`)
    }
}
println(`Total: ${string(total)}`)
println(`High performers: ${string(high_count)}`)
println(`Average: ${string(total / 5)}`)
