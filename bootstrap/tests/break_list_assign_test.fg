fn bla_run() -> string {
    mut nums = [10, 20, 30]
    nums.set(1, 99)
    forge_test_capture_start()
    println(string(nums[1]))
    nums.set(0, 77)
    println(string(nums[0]))
    println(string(nums.length))
    forge_test_capture_stop()
}

spec "break list assign" {
    then "list set and access work" {
        bla_run() == "99\n77\n3"
    }
}
