// Basic TOML parsing via C runtime.

extern fn avra_toml_get_string(toml: string, key: string) -> string
extern fn avra_toml_get_int(toml: string, key: string) -> int
extern fn avra_toml_get_bool(toml: string, key: string) -> bool

fn main() {
    let config = "name = \"forge\"\nversion = \"1.2.3\"\noptimize = true\nmax_errors = 10\n"

    println(avra_toml_get_string(config, "name"))
    println(avra_toml_get_string(config, "version"))
    println(string(avra_toml_get_bool(config, "optimize")))
    println(string(avra_toml_get_int(config, "max_errors")))
}
