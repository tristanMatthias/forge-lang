// extract_per_file_metadata returns a UnitMetadata containing only
// the decls whose enclosing SStmt.file matches the requested path.
// Cross-file leakage in either direction would silently break the
// per-file invalidation contract g2eo's incremental build relies on.
//
// Tracking ticket: forge-crafting-intepreters-g2eo.

use @std.avrac.test_runner.{cached_fixture_run}

fn pfm_run() -> string {
    cached_fixture_run("tests/per_file_metadata_fixtures/sample.av")
}

spec "g2eo per-file metadata: whole-package extract sees decls from every file" {
    then "fixture parses cleanly" {
        pfm_run().contains("PROBE parse_succeeded: ok")
    }
    then "resolver runs without error" {
        pfm_run().contains("PROBE resolver_succeeded: ok")
    }
    then "whole-package metadata sees top.av's `entry` fn" {
        pfm_run().contains("PROBE whole_has_entry_fn: ok")
    }
    then "whole-package metadata sees foo.av's `foo_helper` fn" {
        pfm_run().contains("PROBE whole_has_foo_helper_fn: ok")
    }
    then "whole-package metadata sees foo.av's `Foo` type" {
        pfm_run().contains("PROBE whole_has_foo_type: ok")
    }
}

spec "g2eo per-file metadata: top.av slice contains only top.av's decls" {
    then "top slice has entry fn" {
        pfm_run().contains("PROBE top_slice_has_entry: ok")
    }
    then "top slice does NOT have foo_helper" {
        pfm_run().contains("PROBE top_slice_no_foo_helper: ok")
    }
    then "top slice does NOT have Foo type" {
        pfm_run().contains("PROBE top_slice_no_foo_type: ok")
    }
}

spec "g2eo per-file metadata: foo.av slice contains only foo.av's decls" {
    then "foo slice has foo_helper" {
        pfm_run().contains("PROBE foo_slice_has_foo_helper: ok")
    }
    then "foo slice has Foo type" {
        pfm_run().contains("PROBE foo_slice_has_foo_type: ok")
    }
    then "foo slice does NOT have entry fn" {
        pfm_run().contains("PROBE foo_slice_no_entry: ok")
    }
}
