fn st_add(a: int, b: int) -> int { a + b }
fn st_multiply(a: int, b: int) -> int { a * b }

spec "spec test" {
    given "addition" {
        then "1 + 1 = 2" { st_add(1, 1) == 2 }
        then "0 + 0 = 0" { st_add(0, 0) == 0 }
        then "negative" { st_add(-1, 1) == 0 }
    }
    given "multiplication" {
        then "2 * 3 = 6" { st_multiply(2, 3) == 6 }
        then "0 * anything = 0" { st_multiply(0, 99) == 0 }
    }
    given "strings" {
        then "hello + world" { "hello " + "world" == "hello world" }
        then "length check" { ("abc").length == 3 }
    }
}
