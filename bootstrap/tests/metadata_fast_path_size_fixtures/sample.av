// Fixture: end-to-end demonstration that AVRA_USE_METADATA=1 actually
// reduces the consumer's emitted IR — the producer's fn bodies don't
// appear in the consumer's .ll because the resolver feeds in
// metadata-synthesised stubs that codegen skips emitting (via the
// @external_unit annotation).
//
// This is the smoking gun for 2f54: the consumer pays parse + codegen
// cost only for its own source, not for the producer's. Multi-unit
// incremental builds inherit this size + time saving.
//
// Tracking ticket: forge-crafting-intepreters-2f54.

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_process_env_get(name: string) -> string

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

fn count_fn_defs(ll_path: string) -> int {
    let count_str = avra_shell_exec("grep -c '^define ' ${ll_path}").trim()
    int(count_str)
}

fn count_lines(path: string) -> int {
    let count_str = avra_shell_exec("wc -l < ${path}").trim()
    int(count_str)
}

fn main() -> int {
    let dir = "/tmp/avra_2f54_size_demo"
    avra_shell_exec("rm -rf ${dir}")
    avra_shell_exec("mkdir -p ${dir}")

    // Producer: a few exported fns with non-trivial bodies so
    // codegen produces measurably more IR for them than the
    // declarations alone would.
    let producer = "${dir}/producer.av"
    avra_shell_exec("printf 'export fn producer_a(x: int) -> int { x * 2 + 1 }\\nexport fn producer_b(x: int) -> int { x * 3 - 2 }\\nexport fn producer_c(x: int) -> int { x * 5 }\\n' > ${producer}")

    // Consumer: imports producer via `mod producer` and calls the fns
    // from main.
    let consumer = "${dir}/consumer.av"
    avra_shell_exec("printf 'mod producer\\nuse producer.{producer_a, producer_b, producer_c}\\n\\nfn main() -> int { producer_a(1) + producer_b(2) + producer_c(3) }\\n' > ${consumer}")

    let pwd = avra_process_env_get("PWD")
    let bs2 = "${pwd}/build/bs2"

    // Step 1: produce metadata for the producer.
    let rc1 = avra_shell_exec_status("${bs2} compile --emit_metadata ${producer}")
    probe("producer_emit_rc_zero", rc1 == 0)

    // Step 2: compile consumer via the source path (no env var).
    // fxwn: scrub the outer test runner's AVRA_USE_METADATA + AVRA_LIB_OBJS
    // so this probe measures the legacy source-path output specifically.
    let rc2 = avra_shell_exec_status("env -u AVRA_USE_METADATA -u AVRA_LIB_OBJS ${bs2} compile ${consumer}")
    probe("consumer_source_compile_rc_zero", rc2 == 0)
    let consumer_ll = "${consumer}.ll"
    let source_fn_count = count_fn_defs(consumer_ll)
    let source_lines = count_lines(consumer_ll)

    // Step 3: compile consumer via the metadata fast path.
    let rc3 = avra_shell_exec_status("AVRA_USE_METADATA=1 ${bs2} compile ${consumer}")
    probe("consumer_metadata_compile_rc_zero", rc3 == 0)
    let meta_fn_count = count_fn_defs(consumer_ll)
    let meta_lines = count_lines(consumer_ll)

    probe("metadata_path_emits_fewer_fn_definitions", meta_fn_count < source_fn_count)
    probe("metadata_path_emits_smaller_ir", meta_lines < source_lines)
    probe("metadata_path_drops_at_least_two_fns", source_fn_count - meta_fn_count >= 2)

    0
}
