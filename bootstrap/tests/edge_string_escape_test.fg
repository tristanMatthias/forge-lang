fn esse_run() -> string {
    forge_test_capture_start()
    println("tab:\there")
    println("newline:\nhere")
    println("quote:\"here")
    println("backslash:\\here")
    println("null:\0end")
    let multiline = "line1\nline2\nline3"
    println(string(multiline.length))
    println(string(multiline.contains("\n")))
    println(string(multiline.index_of("\n")))
    forge_test_capture_stop()
}

spec "edge string escape" {
    then "tab escape" {
        "tab:\there".contains("\t") == true
    }
    then "multiline length" {
        let multiline = "line1\nline2\nline3"
        multiline.length == 17
    }
    then "multiline contains newline" {
        let multiline = "line1\nline2\nline3"
        multiline.contains("\n") == true
    }
    then "multiline index_of newline" {
        let multiline = "line1\nline2\nline3"
        multiline.index_of("\n") == 5
    }
    then "full output" {
        esse_run() == "tab:\there\nnewline:\nhere\nquote:\"here\nbackslash:\\here\nnull:\0end\n17\n1\n5"
    }
}
