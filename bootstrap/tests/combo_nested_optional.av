// COMBO: optional chaining + null coalescing + struct + if-expr
type Config = { host: string, port: int }
type App = { config: Config, name: string }

let app = App { config: Config { host: "localhost", port: 8080 }, name: "myapp" }

// Null coalesce with string fallback
let fallback = null ?? "default"
println(fallback)

// Non-null string passes through
let keep = "original" ?? "fallback"
println(keep)

// If-expr + ??
let port = if true { app.config.port } else { 0 }
println(string(port))

// Template with ??
let name = null ?? "anonymous"
println(`user: ${name}`)
