// Fixture: validates the wired --per_file_metadata flag on bs2 compile.
// Builds a two-mod package, runs `bs2 compile --emit_metadata
// --per_file_metadata --module_path=@test::pkg`, and asserts:
//   - The entry-point's <entry>.meta.bin lands (whole-unit slice)
//   - The sub-mod foo.av.meta.bin lands (per-file slice)
//   - Both sidecars are non-empty (per-file extractor produced
//     real content, not a 0-byte stub)
//
// Tracking ticket: forge-crafting-intepreters-g2eo (level-1).

extern fn avra_shell_exec(cmd: string) -> string
extern fn avra_shell_exec_status(cmd: string) -> int
extern fn avra_process_env_get(name: string) -> string
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_parse_int(s: string) -> int

fn probe(name: string, ok: bool) {
    let tag = if ok { "ok" } else { "FAIL" }
    println("PROBE ${name}: ${tag}")
}

fn file_size(path: string) -> int {
    let raw = avra_shell_exec("wc -c < '${path}' 2>/dev/null | tr -d ' '")
    avra_parse_int(raw)
}

fn main() -> int {
    let root = "/tmp/avra_g2eo_emit"
    avra_shell_exec("rm -rf ${root}")
    avra_shell_exec("mkdir -p ${root}")

    // Two-file package: top.av declares mod foo + a free fn,
    // foo.av declares its own type + helper fn.
    avra_shell_exec("printf 'mod foo\\nfn entry() -> int { 0 }\\n' > ${root}/top.av")
    avra_shell_exec("printf 'export type Bar = { value: int }\\nfn helper() -> int { 1 }\\n' > ${root}/foo.av")

    let pwd = avra_process_env_get("PWD")
    let bs2 = "${pwd}/build/bs2"

    // Compile with both --emit_metadata + --per_file_metadata.
    let cmd = "cd ${root} && ${bs2} compile --emit_metadata --per_file_metadata --module_path=@test::pkg ${root}/top.av > /tmp/avra_g2eo_emit.log 2>&1"
    let rc = avra_shell_exec_status(cmd)
    probe("compile_rc_zero", rc == 0)

    // Entry-point .meta.bin (whole-unit slice).
    let top_meta = "${root}/top.av.meta.bin"
    probe("top_meta_present", avra_selfhost_file_exists(top_meta) != 0)
    probe("top_meta_non_empty", file_size(top_meta) > 0)

    // Sub-mod .meta.bin (per-file slice — the actual g2eo deliverable).
    let foo_meta = "${root}/foo.av.meta.bin"
    probe("foo_meta_present", avra_selfhost_file_exists(foo_meta) != 0)
    probe("foo_meta_non_empty", file_size(foo_meta) > 0)

    // The per-file slice for foo.av should be SMALLER than the entry's
    // whole-unit slice (which contains both files' decls). If they're
    // equal sizes, the per-file extraction is failing and just dumping
    // the whole package into every sidecar.
    let top_size = file_size(top_meta)
    let foo_size = file_size(foo_meta)
    probe("foo_slice_smaller_than_whole", foo_size < top_size)

    // Negative control: with --per_file_metadata OFF, foo.av.meta.bin
    // should NOT be written. Wipe and re-run to confirm.
    avra_shell_exec("rm -f ${top_meta} ${foo_meta}")
    let cmd2 = "cd ${root} && ${bs2} compile --emit_metadata --module_path=@test::pkg ${root}/top.av > /tmp/avra_g2eo_emit2.log 2>&1"
    let rc2 = avra_shell_exec_status(cmd2)
    probe("compile2_rc_zero", rc2 == 0)
    probe("default_no_per_file_meta", avra_selfhost_file_exists(foo_meta) == 0)
    probe("default_still_emits_top_meta", avra_selfhost_file_exists(top_meta) != 0)

    0
}
