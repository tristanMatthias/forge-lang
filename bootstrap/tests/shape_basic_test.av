shape SbHasName = { name: string }

type SbUser = { name: string, email: string, age: int }
type SbProduct = { name: string, price: int }

fn sb_greet(thing: SbHasName) -> string {
    "hello " + thing.name
}

spec "shape basic" {
    then "user satisfies shape" {
        sb_greet(SbUser { name: "alice", email: "a@test.com", age: 30 }) == "hello alice"
    }
    then "product satisfies shape" {
        sb_greet(SbProduct { name: "widget", price: 10 }) == "hello widget"
    }
    then "shape constructed directly" {
        sb_greet(SbHasName { name: "world" }) == "hello world"
    }
}
