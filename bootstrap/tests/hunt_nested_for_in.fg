// Nested for-in with different types
type Student = { name: string, scores: List }
let students = [
    Student { name: "Alice", scores: [90, 85, 92] },
    Student { name: "Bob", scores: [78, 88, 95] },
]
for s in students {
    mut sum = 0
    for score in s.scores {
        sum = sum + score
    }
    println(`${s.name}: avg ${string(sum / 3)}`)
}
