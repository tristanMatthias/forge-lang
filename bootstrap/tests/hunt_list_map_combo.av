// List of maps
let users = [
    { "name": "Alice", "age": "30" },
    { "name": "Bob", "age": "25" }
]
println(users[0].get("name"))
println(users[1].get("age"))

// Map containing list
let data = { "numbers": "1,2,3", "label": "test" }
println(data.get("label"))

// Nested list operations
let nums = [1, 2, 3, 4, 5]
let doubled = nums.map((x) -> { x * 2 })
let big = doubled.filter((x) -> { x > 4 })
println(string(big[0]))
println(string(big[1]))
println(string(big[2]))
