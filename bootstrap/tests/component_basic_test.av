component counter_basic(name: string) {
    config {
        start: int = 0
    }
}

fn cb_run() -> string {
    avra_test_capture_start()
    component counter_basic c1 {}
    println(c1.name)
    println(string(c1.start))
    component counter_basic c2 {
        start 42
    }
    println(c2.name)
    println(string(c2.start))
    avra_test_capture_stop()
}

spec "component basic" {
    then "instantiation prints name + default + override" {
        cb_run() == "c1\n0\nc2\n42"
    }
}
