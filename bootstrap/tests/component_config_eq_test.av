// Config `=` pairs accept arbitrary expressions at instantiation, and
// absent pairs fall back to the schema defaults — pinned against the
// data-component expansion (factory fills defaults, `with` applies the
// user's overrides).

fn ceq_add(a: int, b: int) -> int { a + b }

component widget_eq {
    config {
        value: int = 0
        label: string = ""
        active: bool = false
    }
}

fn ceq_overridden() -> bool {
    widget_eq w {
        value = ceq_add(5, 10)
        label = "hello"
        active = true
    }
    w.value == 15 && w.label == "hello" && w.active
}

fn ceq_defaults() -> bool {
    widget_eq d {}
    d.value == 0 && d.label == "" && !d.active
}

spec "component config eq" {
    then "config pairs with = support arbitrary expressions" {
        ceq_overridden()
    }
    then "absent config pairs fall back to schema defaults" {
        ceq_defaults()
    }
}
