// Test: the test subcommand compiles spec/given/then test programs.
// This exercises the test runner pipeline by running spec blocks.

fn double(x: int) -> int { x * 2 }

fn main() {
    spec "math" {
        given "doubling" {
            then "double 5 is 10" { double(5) == 10 }
            then "double 0 is 0" { double(0) == 0 }
        }
    }
}
