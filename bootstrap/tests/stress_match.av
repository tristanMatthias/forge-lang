// Complex match patterns
enum Expr {
    Num(n: int),
    Add(left: Expr, right: Expr),
    Mul(left: Expr, right: Expr),
}

fn eval(e: Expr) -> int {
    match e {
        .Num(n) -> n
        .Add(l, r) -> eval(l) + eval(r)
        .Mul(l, r) -> eval(l) * eval(r)
    }
}

// (2 + 3) * 4 = 20
let expr = Expr.Mul(
    Expr.Add(Expr.Num(2), Expr.Num(3)),
    Expr.Num(4)
)
println(string(eval(expr)))

// Deeply nested
let deep = Expr.Add(
    Expr.Mul(Expr.Num(10), Expr.Num(20)),
    Expr.Add(Expr.Num(3), Expr.Num(4))
)
println(string(eval(deep)))

// Match as expression in complex positions
let label = match expr {
    .Num(_) -> "number"
    .Add(_, _) -> "addition"
    .Mul(_, _) -> "multiplication"
}
println(label)
