/// expect: init: srv on port 8080
/// expect: after: srv ready

component server(name: string) {
    config {
        port: int = 3000
    }

    fn init() {
        println("init: ${self.name} on port ${string(self.config.port)}")
    }

    on after_children {
        println("after: ${self.name} ready")
    }
}

fn main() {
    component server srv {
        port 8080
    }
}
