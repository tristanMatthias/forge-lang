// State machine — enums + match guards + closures
enum State {
    Idle,
    Running(progress: int),
    Paused(at: int),
    Done(result: int),
    Error(msg: string),
}

fn transition(state: State, action: string) -> State {
    match state {
        .Idle -> {
            match action {
                _ if action == "start" -> State.Running(0)
                _ -> State.Error("invalid action for idle")
            }
        }
        .Running(p) -> {
            match action {
                _ if action == "progress" -> {
                    if p >= 100 {
                        return State.Done(p)
                    }
                    State.Running(p + 25)
                }
                _ if action == "pause" -> State.Paused(p)
                _ -> State.Error("invalid action for running")
            }
        }
        .Paused(at) -> {
            match action {
                _ if action == "resume" -> State.Running(at)
                _ -> State.Error("invalid action for paused")
            }
        }
        _ -> state
    }
}

fn state_label(s: State) -> string {
    match s {
        .Idle -> "idle"
        .Running(p) -> `running(${string(p)})`
        .Paused(at) -> `paused(${string(at)})`
        .Done(r) -> `done(${string(r)})`
        .Error(msg) -> `error: ${msg}`
    }
}

mut state = State.Idle
let actions = ["start", "progress", "progress", "pause", "resume", "progress", "progress", "progress"]
for action in actions {
    state = transition(state, action)
    println(state_label(state))
}
