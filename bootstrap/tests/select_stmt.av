// Select statement: multiplex across channels.

extern fn avra_spawn(f: int) -> int
extern fn avra_thread_join(h: int)
extern fn avra_channel_new() -> ptr
extern fn avra_channel_send(ch: ptr, v: int)

mut ch1: ptr = null
mut ch2: ptr = null

fn send1() { avra_channel_send(ch1, 10) }
fn send2() { avra_channel_send(ch2, 20) }

fn main() {
    ch1 = avra_channel_new()
    ch2 = avra_channel_new()

    // Send to both channels
    let h1 = avra_spawn(send1)
    let h2 = avra_spawn(send2)
    avra_thread_join(h1)
    avra_thread_join(h2)

    // Select picks first ready channel (ch1 at index 0)
    select {
        v <- ch1 -> {
            println("a:" + string(v))
        }
        v <- ch2 -> {
            println("b:" + string(v))
        }
    }

    // Second select picks remaining
    select {
        v <- ch1 -> {
            println("a:" + string(v))
        }
        v <- ch2 -> {
            println("b:" + string(v))
        }
    }
}
