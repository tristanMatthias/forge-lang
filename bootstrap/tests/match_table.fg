// Match tables: match expr table { pattern | col; .A | val }
// Desugars to match arms returning maps.

enum Status { Active, Pending, Done }

fn main() {
    let s = Status.Active
    let r = match s table {
        pattern  | label      | code
        .Active  | "active"   | "A"
        .Pending | "pending"  | "P"
        .Done    | "complete" | "D"
    }
    println(r.get("label"))
    println(r.get("code"))

    let s2 = Status.Done
    let r2 = match s2 table {
        pattern  | label      | code
        .Active  | "active"   | "A"
        .Pending | "pending"  | "P"
        .Done    | "complete" | "D"
    }
    println(r2.get("label"))
    println(r2.get("code"))
}
