// Runtime validation functions.

extern fn avra_validate_not_null(value: int, name: string) -> int
extern fn avra_validate_positive(value: int, name: string) -> int
extern fn avra_validate_not_empty(s: string, name: string) -> string

fn main() {
    // These pass (no error)
    let x = avra_validate_not_null(42, "x")
    println(string(x))

    let y = avra_validate_positive(10, "y")
    println(string(y))

    let s = avra_validate_not_empty("hello", "s")
    println(s)
}
