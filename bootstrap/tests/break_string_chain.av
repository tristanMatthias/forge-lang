// Chain every string method
let result = "  Hello, World!  "
    .trim()
    .replace("World", "Forge")
    .upper()
println(result)
println(string(result.length))
println(string(result.contains("FORGE")))
println(string(result.starts_with("HELLO")))
println(string(result.index_of("FORGE")))

// Split then rejoin via reduce
let parts = "a:b:c:d".split(":")
let joined = parts.reduce("", (acc, x) -> {
    if acc == "" { return x }
    acc + "-" + x
})
println(joined)
