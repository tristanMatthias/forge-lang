// `bs2 build --lib --emit_metadata` builds @std/avrac (the bootstrap's
// own compiler library) as a separately-cached unit. Validates the
// multi-mod use-anchor wiring at scale — @std/avrac has 30+ internal
// `mod foo` declarations cross-referencing each other via `use`.
//
// Tracking ticket: forge-crafting-intepreters-2f54.

extern fn avra_shell_exec(cmd: string) -> string


// vez6.6.4 flake fix: per-PPID cache file so concurrent
// bs2-test sessions (e.g. a commit pre-commit hook racing
// a manual run) don't collide on a shared /tmp path. PPID
// is the bs2 test runner's PID, stable across every
// avra_shell_exec call in a single test session.
const CACHE_FILE: string = "/tmp/avra_2f54_std_avrac_test.$" + "PPID.out"
fn sa_run() -> string {
    avra_shell_exec("if [ ! -f " + CACHE_FILE + " ]; then bash scripts/diagnose.sh --run tests/std_avrac_lib_build_fixtures/sample.av > " + CACHE_FILE + " 2>&1 || true; fi; cat " + CACHE_FILE + "")
}

fn sa_wipe() -> string {
    avra_shell_exec("rm -f " + CACHE_FILE + "")
}

spec "std-avrac lib build: clear cached output" {
    then "wipe stale /tmp output from any prior run" {
        let _ = sa_wipe()
        true
    }
}

spec "std-avrac lib build: full bootstrap library compiles cleanly" {
    then "bs2 build --lib --emit_metadata succeeds on @std/avrac" {
        sa_run().contains("PROBE std_avrac_build_rc_zero: ok")
    }
    then "metadata.bin lands alongside the cached IR" {
        sa_run().contains("PROBE avrac_meta_bin_present: ok")
    }
    then "the .ll cache entry lands" {
        sa_run().contains("PROBE avrac_ll_present: ok")
    }
    then "every codegen fn is qualified under @std::avrac::" {
        sa_run().contains("PROBE symbols_qualified_under_at_std_avrac: ok")
    }
    then "no codegen fn leaks out at the un-qualified namespace level" {
        sa_run().contains("PROBE no_unqualified_codegen_fns: ok")
    }
}
