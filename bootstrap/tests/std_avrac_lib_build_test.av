// `bs2 build --lib --emit_metadata` builds @std/avrac (the bootstrap's
// own compiler library) as a separately-cached unit. Validates the
// multi-mod use-anchor wiring at scale — @std/avrac has 30+ internal
// `mod foo` declarations cross-referencing each other via `use`.
//
// Tracking ticket: forge-crafting-intepreters-2f54.

use @std.avrac.test_runner.{cached_fixture_run}

fn sa_run() -> string {
    cached_fixture_run("tests/std_avrac_lib_build_fixtures/sample.av")
}

/// Assert one PROBE line, and on failure PRINT the fixture's whole capture.
///
/// The fixture already dumps the build log tail and the per-dep pre-build logs
/// when `rc != 0` — but it dumps them to its OWN stdout, which
/// `cached_fixture_run` returns as a string and a bare `.contains(...)`
/// discards. So the evidence was being collected and then thrown away one
/// frame above where it was needed: CI showed a lone
/// `FAIL "bs2 build --lib --emit_metadata succeeds on @std/avrac"` and not one
/// line of the capture that exists precisely to explain it.
///
/// That matters here more than usual because the build driver has SIX distinct
/// failure exits on this path (pre-build a path-dep, per-module dispatch, stale
/// artifact removal, child compile rc, no IR produced, install) and the exit
/// code alone tells them apart from none of the others. (Same shape as
/// expand_wildcard_arm_test's `wildcard_ok` and query_surface_test's
/// `query_profile_ok`.)
fn sa_probe(name: string, out: string) -> bool {
    let ok = out.contains("PROBE ${name}: ok")
    if !ok {
        println("std_avrac_lib_build[${name}]: probe absent — fixture output follows")
        println(out)
    }
    ok
}

spec "std-avrac lib build: full bootstrap library compiles cleanly" {
    then "bs2 build --lib --emit_metadata succeeds on @std/avrac" {
        sa_probe("std_avrac_build_rc_zero", sa_run())
    }
    then "metadata.bin lands alongside the cached IR" {
        sa_probe("avrac_meta_bin_present", sa_run())
    }
    then "the .ll cache entry lands" {
        sa_probe("avrac_ll_present", sa_run())
    }
    then "every codegen fn is qualified under @std::avrac::" {
        sa_probe("symbols_qualified_under_at_std_avrac", sa_run())
    }
    then "no codegen fn leaks out at the un-qualified namespace level" {
        sa_probe("no_unqualified_codegen_fns", sa_run())
    }
}
