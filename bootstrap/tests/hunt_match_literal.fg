// Match on string literals
let cmd = "quit"
match cmd {
    "start" -> println("starting")
    "stop" -> println("stopping")
    "quit" -> println("quitting")
    _ -> println("unknown")
}

// Match on integer literals
let code = 404
match code {
    200 -> println("ok")
    404 -> println("not found")
    500 -> println("server error")
    _ -> println("other")
}

// Match on bool literals
let flag = true
match flag {
    true -> println("yes")
    false -> println("no")
}

// Match expression with literals
fn status_text(code: int) -> string {
    match code {
        200 -> "OK"
        301 -> "Moved"
        404 -> "Not Found"
        _ -> "Unknown"
    }
}
println(status_text(404))
println(status_text(200))
println(status_text(999))
