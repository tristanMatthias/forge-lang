enum CigPriority { Low, Medium, High(level: int) }

type CigTask = { name: string, priority: CigPriority, done: int }

fn cig_run() -> string {
    let tasks = [
        CigTask { name: "design", priority: CigPriority.High(5), done: 0 },
        CigTask { name: "code", priority: CigPriority.High(3), done: 1 },
        CigTask { name: "test", priority: CigPriority.Medium, done: 0 },
        CigTask { name: "docs", priority: CigPriority.Low, done: 0 },
    ]

    mut urgent_count = 0
    forge_test_capture_start()
    for t in tasks {
        let is_urgent = match t.priority {
            .High(lvl) if lvl >= 4 -> 1
            _ -> 0
        }
        if is_urgent == 1 && t.done == 0 {
            urgent_count = urgent_count + 1
            println(t.name)
        }
    }
    println(string(urgent_count))
    let undone = tasks.filter((t) -> t.done == 0)
    println(string(undone.length))
    forge_test_capture_stop()
}

spec "combo immut guard" {
    then "immutability plus match guards" {
        cig_run() == "design\n1\n3"
    }
}
