enum IntList {
    End,
    Cons(value: i64, next: i64)
}

fn sum(list: IntList) -> i64 {
    match list {
        .End -> { return 0 }
        .Cons(v, n) -> { return v + sum(n) }
    }
    return 0
}

let l3 = IntList.End
let l2 = IntList.Cons(30, l3)
let l1 = IntList.Cons(20, l2)
let l0 = IntList.Cons(10, l1)
return sum(l0)
