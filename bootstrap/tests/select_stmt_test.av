// `select` over typed channels: two `Channel<int>` producers, each select
// consumes one ready channel; the receive binding `v` is typed by the
// channel's element type (int), never under-determined (ps3t.4.5 layout
// totality — a raw-`ptr` channel left `v` Unknown at the layout boundary).

mut sel_ch1: Channel<int> = channel<int>(1)
mut sel_ch2: Channel<int> = channel<int>(1)

fn sel_run() -> int {
    sel_ch1 = channel<int>(1)
    sel_ch2 = channel<int>(1)
    let h1 = spawn { sel_ch1.send(10)  0 }
    let h2 = spawn { sel_ch2.send(20)  0 }
    h1.await
    h2.await
    mut total = 0
    select {
        v <- sel_ch1 -> { total = total + v }
        v <- sel_ch2 -> { total = total + v }
    }
    select {
        v <- sel_ch1 -> { total = total + v }
        v <- sel_ch2 -> { total = total + v }
    }
    total
}

spec "select stmt" {
    then "select consumes both channels (sum is 30)" {
        sel_run() == 30
    }
}
