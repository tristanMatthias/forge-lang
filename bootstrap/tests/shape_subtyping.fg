/// expect: Hello, Alice
/// expect: Hello, Acme
/// expect: name match

shape HasName = { name: string }

type Person = { name: string, age: int }
type Company = { name: string, id: int }

fn greet(h: HasName) {
    println("Hello, " + h.name)
}

fn main() {
    greet(Person { name: "Alice", age: 30 })
    greet(Company { name: "Acme", id: 42 })
    
    // Shape as let binding type annotation
    let x: HasName = Person { name: "Bob", age: 25 }
    if x.name == "Bob" { println("name match") }
}
