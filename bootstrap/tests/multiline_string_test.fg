fn mls_run_basic() -> string {
    forge_test_capture_start()
    let s = """
hello
world
"""
    println(s)
    forge_test_capture_stop()
}

fn mls_run_interpolated() -> string {
    let n = 42
    let t = """interpolated: ${string(n)}"""
    t
}

spec "multiline string" {
    then "basic multiline" {
        mls_run_basic() == "hello\nworld"
    }
    then "interpolated multiline" {
        mls_run_interpolated() == "interpolated: 42"
    }
}
