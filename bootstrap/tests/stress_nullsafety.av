// Chain of ?
fn step1(x: int) -> int? {
    if x < 0 { return null }
    x * 2
}

fn step2(x: int) -> int? {
    if x > 100 { return null }
    x + 10
}

fn step3(x: int) -> int? {
    if x == 42 { return null }
    x
}

fn pipeline(x: int) -> int? {
    let a = step1(x)?
    let b = step2(a)?
    let c = step3(b)?
    c
}

println(string(pipeline(5) ?? -1))
println(string(pipeline(-1) ?? -1))
println(string(pipeline(60) ?? -1))
println(string(pipeline(16) ?? -1))

// ?? with complex expressions
let result = null ?? (10 + 20)
println(string(result))

// Chained ??
let a: ptr = null
let b: ptr = null
let c = a ?? b ?? 99
println(string(c))

// ?. on struct
type User = { name: string, age: int }
let u = User { name: "Alice", age: 30 }
println(string(u?.age))

let n: ptr = null
println(string(n?.age ?? 0))
