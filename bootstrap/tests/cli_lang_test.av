// Spec test for `bs2 lang` — phx5 Part B moved it off the raw-argv guard onto
// the declarative App (avra.run()). It reads its single `--print` switch from
// the parsed CliResult. We drive the real bs2 binary against a temp CWD (the
// command writes `target/lang.av` relative to the working dir) and probe the
// side effects:
//   1. default        : writes target/lang.av (an AUTOGENERATED lang def)
//   2. --print         : prints the def to stdout, writes NO file
//   3. --bogus         : the declarative parser rejects the unknown flag (exit 1)

extern fn avra_shell_exec(cmd: string) -> string

fn lang_bs2() -> string {
    avra_shell_exec("pwd").trim() + "/build/bs2"
}

spec "bs2 lang: writes target/lang.av by default" {
    then "creates an AUTOGENERATED target/lang.av and reports the path" {
        let project = "/tmp/avra_lang_default_fixture/"
        let probe = avra_shell_exec(
            "rm -rf " + project + " && mkdir -p " + project + " && cd " + project + " && " +
            lang_bs2() + " lang 2>&1 && " +
            "([ -f " + project + "target/lang.av ] && grep -q AUTOGENERATED " + project + "target/lang.av && echo file=ok || echo file=bad)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("wrote") && probe.contains("file=ok")
    }
}

spec "bs2 lang --print: prints to stdout without writing the file" {
    then "the def is printed and no target/lang.av is created" {
        let project = "/tmp/avra_lang_print_fixture/"
        let probe = avra_shell_exec(
            "rm -rf " + project + " && mkdir -p " + project + " && cd " + project + " && " +
            lang_bs2() + " lang --print 2>&1 && " +
            "echo --- && " +
            "([ ! -f " + project + "target/lang.av ] && echo nofile=ok || echo nofile=bad)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("AUTOGENERATED") && probe.contains("nofile=ok")
    }
}

// phx5 Part B: dispatched through avra.run(), which rejects an undeclared flag
// rather than ignoring it as the old has_argv_flag scan did. Must exit non-zero.
spec "bs2 lang: rejects an unknown flag (declarative parse)" {
    then "`lang --bogus` errors and exits non-zero" {
        let project = "/tmp/avra_lang_bogus_fixture/"
        let probe = avra_shell_exec(
            "rm -rf " + project + " && mkdir -p " + project + " && cd " + project + " && (" +
            lang_bs2() + " lang --bogus 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo rc=zero; else echo rc=nonzero; fi)")
        let _ = avra_shell_exec("rm -rf " + project)
        probe.contains("rc=nonzero") && probe.contains("unknown flag")
    }
}
