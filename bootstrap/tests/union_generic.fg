/// expect: 42
/// expect: hello
/// expect: first: 1
/// expect: second: world

fn identity<T>(x: T) -> T {
    x
}

fn pair<A, B>(a: A, b: B) -> A {
    a
}

fn main() {
    let u: int | string = 42
    let v = identity(u)
    match v {
        int(n) -> println(string(n))
        string(s) -> println(s)
    }

    let u2: int | string = "hello"
    let v2 = identity(u2)
    match v2 {
        int(n) -> println(string(n))
        string(s) -> println(s)
    }

    // Two union args to generic
    let a: int | string = 1
    let b: int | string = "world"
    let r = pair(a, b)
    match r {
        int(n) -> println("first: " + string(n))
        string(s) -> println("first: " + s)
    }
    let r2 = pair(b, a)
    match r2 {
        int(n) -> println("second: " + string(n))
        string(s) -> println("second: " + s)
    }
}
