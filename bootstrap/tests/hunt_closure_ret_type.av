// Closure returning a string via .map
let names = ["Alice", "Bob", "Charlie"]
let greetings = names.map((name) -> { "Hello " + name })
println(greetings[0])
println(greetings[1])
println(greetings[2])

// Closure in a let binding  
let upper_fn = (s) -> { s + "!" }
println(upper_fn("test"))

// Higher-order: fn returning fn
fn make_prefix(prefix: string) -> fn {
    (name) -> { prefix + " " + name }
}
let greeter = make_prefix("Hi")
println(greeter("Dave"))
