// Closure with capture used in .map
fn make_scaler(factor: int) -> fn(int) -> int {
    (x) -> x * factor
}
let double = make_scaler(2)
let triple = make_scaler(3)
let nums = [1, 2, 3, 4, 5]
let doubled = nums.map(double)
let tripled = nums.map(triple)
for d in doubled { println(string(d)) }
println("---")
for t in tripled { println(string(t)) }
