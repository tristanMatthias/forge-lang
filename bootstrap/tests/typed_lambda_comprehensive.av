fn apply(f: fn(int) -> int, x: int) -> int { f(x) }

fn main() {
    let double = (x: int) -> x * 2
    println(string(double(5)))

    let add = (a: int, b: int) -> a + b
    println(string(add(3, 4)))

    let greet = (name: string) -> "hello " + name
    println(greet("world"))

    let area = (r: float) -> 3.14 * r * r
    println(string(area(10.0)))

    let n = 10
    let add_n = (x: int) -> x + n
    println(string(add_n(5)))

    let check = (x: int) -> if x > 0 { "yes" } else { "no" }
    println(check(1))

    println(string(apply((n: int) -> n * 2, 3)))
}
