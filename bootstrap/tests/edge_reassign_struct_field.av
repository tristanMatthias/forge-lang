// Reassign struct field through method
type Counter = { value: int }
impl Counter {
    fn increment(self) -> int {
        self.value = self.value + 1
        self.value
    }
}
let c = Counter { value: 0 }
println(string(c.increment()))
println(string(c.increment()))
println(string(c.increment()))
println(string(c.value))
