fn se_run() -> string {
    let ch = "a"
    let s = "hello"

    avra_test_capture_start()
    println(string(ch.length))
    println(ch)
    println(s[0])
    println(s[4])
    println(s.substring(0, 0))
    println(s.substring(0, 5))
    println(s.substring(2, 2))
    println(string(s.substring(0, 5).length))
    avra_test_capture_stop()
}

spec "string edge" {
    then "string edge cases output" {
        se_run() == "1\na\nh\no\n\nhello\n\n5"
    }
}
