extern fn avra_spawn(closure: int) -> int
extern fn avra_thread_join(handle: int)
extern fn avra_channel_new() -> ptr
extern fn avra_channel_send(ch: ptr, value: int)
extern fn avra_channel_recv(ch: ptr) -> int

mut conc_log: int = 0

fn conc_worker() {
    conc_log = conc_log + 100
}

mut conc_global_ch: ptr = null
fn conc_sender() {
    avra_channel_send(conc_global_ch, 10)
    avra_channel_send(conc_global_ch, 20)
    avra_channel_send(conc_global_ch, 30)
}

spec "concurrency" {
    then "spawn + join runs the worker body" {
        conc_log = 0
        let h = avra_spawn(conc_worker)
        avra_thread_join(h)
        conc_log == 100
    }
    then "channels deliver three values in order" {
        conc_global_ch = avra_channel_new()
        let h2 = avra_spawn(conc_sender)
        let a = avra_channel_recv(conc_global_ch)
        let b = avra_channel_recv(conc_global_ch)
        let c = avra_channel_recv(conc_global_ch)
        avra_thread_join(h2)
        (a + b + c) == 60
    }
}
