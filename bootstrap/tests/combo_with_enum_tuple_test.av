type CwetPoint = { x: int, y: int, z: int }

enum CwetResult {
    Good(value: int)
    Bad(code: int, msg: string)
}

fn cwet_describe_result(r: CwetResult) -> string {
    match r {
        .Good(v) -> `success: ${string(v)}`
        .Bad(c, m) -> `error ${string(c)}: ${m}`
    }
}

fn cwet_divide(a: int, b: int) -> CwetResult {
    match b {
        0 -> CwetResult.Bad(1, "division by zero")
        _ -> CwetResult.Good(a / b)
    }
}

type CwetConfig = { width: int, height: int, title: string }

fn cwet_run() -> string {
    avra_test_capture_start()
    let p1 = CwetPoint { x: 1, y: 2, z: 3 }
    let p2 = p1 with { x: 10 }
    let p3 = p2 with { y: 20, z: 30 }
    println(`${string(p3.x)},${string(p3.y)},${string(p3.z)}`)
    let pair = (42, "hello")
    let (num, text) = pair
    println(string(num))
    println(text)
    println(cwet_describe_result(CwetResult.Good(42)))
    println(cwet_describe_result(CwetResult.Bad(404, "not found")))
    println(cwet_describe_result(cwet_divide(10, 3)))
    println(cwet_describe_result(cwet_divide(10, 0)))
    let base = CwetConfig { width: 800, height: 600, title: "default" }
    let custom = base with { title: "my app", width: 1920 }
    println(`${custom.title}: ${string(custom.width)}x${string(custom.height)}`)
    avra_test_capture_stop()
}

spec "combo with enum tuple" {
    then "with chain" {
        let p1 = CwetPoint { x: 1, y: 2, z: 3 }
        let p3 = p1 with { x: 10 } with { y: 20, z: 30 }
        p3.x == 10 and p3.y == 20 and p3.z == 30
    }
    then "enum describe" {
        cwet_describe_result(CwetResult.Good(42)) == "success: 42"
    }
    then "divide by zero" {
        cwet_describe_result(cwet_divide(10, 0)) == "error 1: division by zero"
    }
    then "full output" {
        cwet_run() == "10,20,30\n42\nhello\nsuccess: 42\nerror 404: not found\nsuccess: 3\nerror 1: division by zero\nmy app: 1920x600"
    }
}
