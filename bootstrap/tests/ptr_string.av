// Ptr ↔ string conversions.

extern fn malloc(size: int) -> ptr
extern fn free(p: ptr)
extern fn avra_ptr_store_byte(p: ptr, offset: int, val: int)
extern fn avra_string_from_ptr(p: ptr, len: int) -> string

fn main() {
    // Build string from raw bytes
    let buf: ptr = malloc(16)
    avra_ptr_store_byte(buf, 0, 72)   // H
    avra_ptr_store_byte(buf, 1, 101)  // e
    avra_ptr_store_byte(buf, 2, 108)  // l
    avra_ptr_store_byte(buf, 3, 108)  // l
    avra_ptr_store_byte(buf, 4, 111)  // o
    let s = avra_string_from_ptr(buf, 5)
    println(s)
    println(string(s.length))
    free(buf)

    // String to ptr — direct cast (same representation)
    let msg = "World"
    let p: ptr = msg
    println(string(p[0]))
    println(string(p[4]))
}
