fn esc_run() -> string {
    forge_test_capture_start()
    let x = 1
    println(string(x))
    {
        let x = 2
        println(string(x))
        {
            let x = 3
            println(string(x))
            {
                mut x = 4
                x = x + 10
                println(string(x))
            }
            println(string(x))
        }
        println(string(x))
    }
    println(string(x))
    let val = 100
    for val in [1, 2, 3] {
        println(string(val))
    }
    println(string(val))
    forge_test_capture_stop()
}

spec "edge shadowing complex" {
    then "full output" {
        esc_run() == "1\n2\n3\n14\n3\n2\n1\n1\n2\n3\n100"
    }
}
