// String methods — no extern declarations needed!
let s = "hello world"

println(string(s.contains("world")))
println(string(s.starts_with("hello")))
println(string(s.ends_with("world")))
println(string(s.index_of("world")))

let r = s.replace("world", "avra")
println(r)

let t = "  spaces  ".trim()
println(t)

println("hello".upper())
println("HELLO".lower())

// Split
let parts = "a,b,c".split(",")
println(string(parts.length))
println(parts[0])
println(parts[1])
println(parts[2])
