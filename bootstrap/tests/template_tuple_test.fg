fn ttu_run() -> string {
    let pair = (10, 20)
    let (a, b) = (3, 7)
    forge_test_capture_start()
    println(`first: ${string(pair.0)}, second: ${string(pair.1)}`)
    println(`${string(a)} + ${string(b)} = ${string(a + b)}`)
    forge_test_capture_stop()
}

spec "template tuple" {
    then "template tuple output" {
        ttu_run() == "first: 10, second: 20\n3 + 7 = 10"
    }
}
