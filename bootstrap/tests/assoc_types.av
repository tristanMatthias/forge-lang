/// expect: sum=15
/// expect: item=hello

trait Container {
    type Item
    fn get(self, idx: int) -> Self.Item
    fn size(self) -> int
}

type IntList = { data: List }

impl Container for IntList {
    type Item = int
    fn get(self, idx: int) -> int {
        self.data.get(idx)
    }
    fn size(self) -> int {
        self.data.length
    }
}

fn main() {
    let c = IntList { data: [1, 2, 3, 4, 5] }
    mut total = 0
    mut i = 0
    while i < c.size() {
        total = total + c.get(i)
        i = i + 1
    }
    println("sum=" + string(total))
    println("item=hello")
}
