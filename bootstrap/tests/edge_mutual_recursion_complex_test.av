fn emrc_is_even(n: int) -> int {
    if n == 0 { return 1 }
    if n < 0 { return emrc_is_even(-n) }
    emrc_is_odd(n - 1)
}
fn emrc_is_odd(n: int) -> int {
    if n == 0 { return 0 }
    if n < 0 { return emrc_is_odd(-n) }
    emrc_is_even(n - 1)
}

fn emrc_run() -> string {
    avra_test_capture_start()
    for i in 0..8 {
        println(`${string(i)}: even=${string(emrc_is_even(i))} odd=${string(emrc_is_odd(i))}`)
    }
    avra_test_capture_stop()
}

spec "edge mutual recursion complex" {
    then "0 is even" {
        emrc_is_even(0) == 1
    }
    then "1 is odd" {
        emrc_is_odd(1) == 1
    }
    then "4 is even" {
        emrc_is_even(4) == 1
    }
    then "full output" {
        emrc_run() == "0: even=1 odd=0\n1: even=0 odd=1\n2: even=1 odd=0\n3: even=0 odd=1\n4: even=1 odd=0\n5: even=0 odd=1\n6: even=1 odd=0\n7: even=0 odd=1"
    }
}
