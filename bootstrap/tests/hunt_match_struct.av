// Match on enum containing struct data
type Point = { x: int, y: int }

enum Shape {
    Circle(radius: int)
    Rect(w: int, h: int)
}

fn describe(s: Shape) -> string {
    match s {
        .Circle(r) -> `circle r=${string(r)}`
        .Rect(w, h) -> `rect ${string(w)}x${string(h)}`
    }
}

println(describe(Shape.Circle(5)))
println(describe(Shape.Rect(3, 4)))

// Nested match
fn area(s: Shape) -> int {
    match s {
        .Circle(r) -> r * r * 3
        .Rect(w, h) -> w * h
    }
}
println(string(area(Shape.Circle(5))))
println(string(area(Shape.Rect(3, 4))))
