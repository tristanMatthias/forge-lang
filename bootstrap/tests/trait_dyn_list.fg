// Regression: List<Trait> heterogeneous collections with per-element auto-boxing.
// Each element in the list literal must be individually boxed as a trait object.
/// expect: circle
/// expect: rect
/// expect: triangle

trait Shape {
    fn name(self) -> string
}

type Circle = { radius: float }
type Rect = { width: float, height: float }
type Triangle = { base: float }

impl Shape for Circle {
    fn name(self) -> string { "circle" }
}

impl Shape for Rect {
    fn name(self) -> string { "rect" }
}

impl Shape for Triangle {
    fn name(self) -> string { "triangle" }
}

fn main() {
    let shapes: List<Shape> = [
        Circle { radius: 1.0 },
        Rect { width: 2.0, height: 3.0 },
        Triangle { base: 4.0 }
    ]
    for s in shapes {
        println(s.name())
    }
}
