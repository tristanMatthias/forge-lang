// Basic spec test syntax.

fn add(a: int, b: int) -> int { a + b }
fn multiply(a: int, b: int) -> int { a * b }

fn main() {
    spec "arithmetic" {
        given "addition" {
            then "1 + 1 = 2" { add(1, 1) == 2 }
            then "0 + 0 = 0" { add(0, 0) == 0 }
            then "negative" { add(-1, 1) == 0 }
        }

        given "multiplication" {
            then "2 * 3 = 6" { multiply(2, 3) == 6 }
            then "0 * anything = 0" { multiply(0, 99) == 0 }
        }
    }

    spec "strings" {
        given "concatenation" {
            then "hello + world" { "hello " + "world" == "hello world" }
            then "length check" { ("abc").length == 3 }
        }
    }
}
