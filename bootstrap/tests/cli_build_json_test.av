// `bs2 build --json` flag, its `--message-format=json` option-form alias (phx5
// A2), and unknown-flag rejection — the declarative-parse surface `build` gained
// when phx5 Part B moved it onto avra.run(). Split from cli_build_flags_test.

extern fn avra_shell_exec(cmd: string) -> string

fn bs2_path() -> string {
    avra_shell_exec("pwd").trim() + "/build/bs2"
}

fn setup_project() -> string {
    let project = "/tmp/avra_build_json_fixture/"
    avra_shell_exec("rm -rf " + project)
    avra_shell_exec("mkdir -p " + project + "build")
    avra_shell_exec("ln -s " + bs2_path() + " " + project + "build/bs2")
    avra_shell_exec("printf '[package]\nname = \"flags-fixture\"\nversion = \"0.1.0\"\n[[bin]]\nname = \"flags-fixture\"\npath = \"main.av\"\n' > " + project + "avra.toml")
    let entry = "main"
    let body = "fn " + entry + "() -> int { 0 }"
    avra_shell_exec("printf '%s\\n' '" + body + "' > " + project + entry + ".av")
    project
}

fn teardown_project(project: string) -> string {
    avra_shell_exec("rm -rf " + project)
}

spec "bs2 build --json: emits one JSON object per line" {
    then "output contains a build-event JSON line" {
        let project = setup_project()
        let out = avra_shell_exec(
            "cd " + project + " && " + bs2_path() + " build --json 2>&1 || true")
        let _ = teardown_project(project)
        out.contains("{\"event\":") || out.contains("\"event\"")
    }
}

// phx5 A2: `--message-format=json` is an option-form alias for the `json` flag
// (the Cargo-compat spelling). The whole `=json` token is matched before the
// `--key=value` option classifier, so it sets the flag rather than parsing as an
// undeclared `message-format` option.
spec "bs2 build --message-format=json: the A2 alias sets the json flag" {
    then "output is JSON, same as --json" {
        let project = setup_project()
        let out = avra_shell_exec(
            "cd " + project + " && " + bs2_path() + " build --message-format=json 2>&1 || true")
        let _ = teardown_project(project)
        out.contains("{\"event\":") || out.contains("\"event\"")
    }
}

// phx5 Part B: dispatched through avra.run(), which rejects an undeclared flag
// rather than silently ignoring it as the old parse_build_args scan did.
spec "bs2 build: rejects an unknown flag (declarative parse)" {
    then "`build --bogus` errors and exits non-zero" {
        let project = setup_project()
        let probe = avra_shell_exec(
            "cd " + project + " && (" + bs2_path() + " build --bogus 2>&1; rc=$?; if [ $rc -eq 0 ]; then echo rc=zero; else echo rc=nonzero; fi)")
        let _ = teardown_project(project)
        probe.contains("rc=nonzero") && probe.contains("unknown flag")
    }
}
