// Feature registry pattern — proves structs with fn pointer fields work
// as a foundation for the compiler's feature registry architecture.

type Transform = {
    name: string,
    apply: fn(int) -> int,
}

fn double(n: int) -> int { n * 2 }
fn triple(n: int) -> int { n * 3 }
fn negate(n: int) -> int { 0 - n }
fn square(n: int) -> int { n * n }

enum TransformList {
    End
    Node(t: Transform, next: TransformList)
}

fn run_all(transforms: TransformList, input: int) {
    match transforms {
        .End -> {}
        .Node(t, rest) -> {
            let result = t.apply(input)
            println(t.name + "(" + string(input) + ") = " + string(result))
            run_all(rest, input)
        }
    }
}

fn find_and_run(transforms: TransformList, name: string, input: int) -> int {
    match transforms {
        .End -> {
            println("not found: " + name)
            0
        }
        .Node(t, rest) -> {
            if t.name == name {
                return t.apply(input)
            }
            find_and_run(rest, name, input)
        }
    }
}

fn main() {
    // Build registry
    let registry = TransformList.Node(
        Transform { name: "double", apply: double },
        TransformList.Node(
            Transform { name: "triple", apply: triple },
            TransformList.Node(
                Transform { name: "negate", apply: negate },
                TransformList.Node(
                    Transform { name: "square", apply: square },
                    TransformList.End
                )
            )
        )
    )

    // Run all transforms on input 5
    run_all(registry, 5)

    // Lookup by name and run
    println(string(find_and_run(registry, "square", 7)))
    println(string(find_and_run(registry, "negate", 3)))
}
