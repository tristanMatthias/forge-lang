type BdnNode = { value: int, label: string }

fn bdn_run() -> string {
    let nodes = table<BdnNode> {
        value | label
        1     | "a"
        2     | "b"
        3     | "c"
        4     | "d"
    }

    let result = nodes
        .filter((n) -> n.value > 1)
        .map((n) -> n.value * 10)
        .reduce(0, (acc, x) -> acc + x)

    mut lookup = {}
    for n in nodes {
        lookup.set(n.label, string(n.value))
    }

    let (first, second) = (nodes[0], nodes[1])
    let cmp = match first.value {
        _ if first.value > second.value -> "first bigger"
        _ if first.value == second.value -> "equal"
        _ -> "second bigger"
    }

    avra_test_capture_start()
    println(string(result))
    println(lookup.get("c"))
    println(cmp)
    for n in nodes[1..3] {
        println(`${n.label}=${string(n.value)}`)
    }
    avra_test_capture_stop()
}

spec "break deeply nested" {
    then "complex nesting produces correct output" {
        bdn_run() == "90\n3\nsecond bigger\nb=2\nc=3"
    }
}
