fn bct_make_formatter(prefix: string) -> fn(int) -> string {
    (x) -> prefix + string(x)
}

fn bct_run() -> string {
    let fmt = bct_make_formatter("val=")
    forge_test_capture_start()
    println(fmt(42))
    println(fmt(99))
    forge_test_capture_stop()
}

spec "break closure template" {
    then "closure with string concat works" {
        bct_run() == "val=42\nval=99"
    }
}
