// String templates with variable interpolation
let name = "world"
let greeting = `hello ${name}`
println(greeting)

let x = string(42)
let msg = `the answer is ${x}`
println(msg)

// Multiple interpolations
let a = string(3)
let b = string(4)
let sum = string(3 + 4)
println(`${a} + ${b} = ${sum}`)

// Empty template
let empty = ``
println("[" + empty + "]")

// Template with no interpolation
let plain = `just text`
println(plain)

// Adjacent interpolations
let p1 = "ab"
let p2 = "cd"
println(`${p1}${p2}`)
