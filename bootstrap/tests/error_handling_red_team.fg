/// expect: default value
/// expect: error: io: disk full
/// expect: cleanup ran
/// expect: released resource 42
/// expect: error: write failed
/// expect: chained: parse error in config.json

enum Result<T, E> { Ok(value: T), Err(error: E) }

// Red team: catch block
fn might_fail(x: int) -> Result<string, string> {
    if x < 0 { Result.Err("negative") }
    else { Result.Ok("positive") }
}

// Red team: Error trait with cause chain
trait Error {
    fn message(self) -> string
    fn kind(self) -> string
}

type IoError = { msg: string }
impl Error for IoError {
    fn message(self) -> string { self.msg }
    fn kind(self) -> string { "io" }
}

// Red team: errdefer with both explicit and implicit returns
fn with_cleanup(fail: bool) -> Result<string, string> {
    defer println("cleanup ran")
    let resource = 42
    errdefer println("released resource ${string(resource)}")
    if fail { return Result.Err("write failed") }
    Result.Ok("success")
}

// Red team: error context chaining
type ParseError = { msg: string, file: string }
impl Error for ParseError {
    fn message(self) -> string { "${self.msg} in ${self.file}" }
    fn kind(self) -> string { "parse" }
}

fn show_error(e: Error) -> string {
    "chained: ${e.kind()} error ${e.message()}"
}

fn main() {
    // catch block
    let val = might_fail(-1) catch { "default value" }
    println(val)

    // Error trait
    let e = IoError { msg: "disk full" }
    println("error: ${e.kind()}: ${e.message()}")

    // errdefer — fail path (should print cleanup + released)
    match with_cleanup(true) {
        .Ok(v) -> println("ok: ${v}")
        .Err(e) -> println("error: ${e}")
    }

    // Error trait dispatch
    let pe = ParseError { msg: "parse error", file: "config.json" }
    println(show_error(pe))
}
