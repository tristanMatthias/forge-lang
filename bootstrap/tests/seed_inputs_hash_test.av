// WHY: spec for the seed-binary input fingerprint (seed_inputs_hash,
// exercised through diagnose.sh --seed-inputs-hash so the REAL
// implementation is under test). build/seed links the seed IR with
// runtime.o + llvm_wrapper.o, so all three inputs must key the cached
// binary — a C-side edit that doesn't invalidate it leaves a stale
// seed whose failures get misattributed downstream. The fingerprint
// must also be path-independent: the window gate fingerprints a
// COPIED tree and reuses the dev build/seed only when the values
// match, which only works if identical content hashes identically
// from different paths.

extern fn avra_shell_exec(cmd: string) -> string

fn d() -> string { "build/cache/_seed_inputs_hash" }

fn fp(seed_ll: string, runtime_c: string, wrapper_c: string) -> string {
    avra_shell_exec("bash scripts/diagnose.sh --seed-inputs-hash ${seed_ll} ${runtime_c} ${wrapper_c}").trim()
}

spec "seed_inputs_hash: seed-binary input fingerprint" {
    given "three scratch files standing in for the seed IR and the two C inputs" {
        then "the hash is stable across calls" {
            let base = d()
            avra_shell_exec("rm -rf ${base} && mkdir -p ${base}")
            avra_shell_exec("printf 'define i64 @main() { ret i64 0 }\\n' > ${base}/seed.ll")
            avra_shell_exec("printf 'int rt_init() { return 0; }\\n' > ${base}/runtime.c")
            avra_shell_exec("printf 'void wrap() {}\\n' > ${base}/wrapper.c")
            let h1 = fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper.c")
            let h2 = fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper.c")
            h1 != "" && h1 == h2
        }
        then "changing the seed IR changes the hash" {
            let base = d()
            avra_shell_exec("printf 'define i64 @main() { ret i64 1 }\\n' > ${base}/seed_b.ll")
            fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper.c")
                != fp("${base}/seed_b.ll", "${base}/runtime.c", "${base}/wrapper.c")
        }
        then "changing runtime.c changes the hash" {
            let base = d()
            avra_shell_exec("printf 'int rt_init() { return 42; }\\n' > ${base}/runtime_b.c")
            fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper.c")
                != fp("${base}/seed.ll", "${base}/runtime_b.c", "${base}/wrapper.c")
        }
        then "changing llvm_wrapper.c changes the hash" {
            let base = d()
            avra_shell_exec("printf 'void wrap2() {}\\n' > ${base}/wrapper_b.c")
            fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper.c")
                != fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper_b.c")
        }
    }
    given "identical content copied to different paths" {
        then "the hash is path-independent — the window's reuse fast path depends on it" {
            let base = d()
            avra_shell_exec("cp ${base}/seed.ll ${base}/seed_copy.ll && cp ${base}/runtime.c ${base}/runtime_copy.c && cp ${base}/wrapper.c ${base}/wrapper_copy.c")
            fp("${base}/seed.ll", "${base}/runtime.c", "${base}/wrapper.c")
                == fp("${base}/seed_copy.ll", "${base}/runtime_copy.c", "${base}/wrapper_copy.c")
        }
    }
}
