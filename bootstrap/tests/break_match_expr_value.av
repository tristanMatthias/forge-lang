// Match expression in various value positions
fn double(x: int) -> int { x * 2 }

// Match as function argument
let x = 5
println(string(double(match x { _ if x > 3 -> x, _ -> 0 })))

// Match as list element
let items = [
    match x { _ if x > 3 -> "big", _ -> "small" },
    match x { _ if x > 10 -> "huge", _ -> "normal" },
]
println(items[0])
println(items[1])

// Match in template
println(`result: ${match x { _ if x > 0 -> "positive", _ -> "negative" }}`)

// Nested match expressions
let val = match x {
    _ if x > 10 -> match x { _ if x > 100 -> "huge", _ -> "big" }
    _ if x > 0 -> "small"
    _ -> "zero"
}
println(val)
