// Dynamic trait dispatch: `let d: Trait = concrete_value` creates a
// trait object with a vtable. Method calls go through the vtable.

trait Describable {
    fn describe(self) -> string
}

type Circle = { radius: int }
type Square = { side: int }

impl Describable for Circle {
    fn describe(self) -> string {
        "circle r=" + string(self.radius)
    }
}

impl Describable for Square {
    fn describe(self) -> string {
        "square s=" + string(self.side)
    }
}

fn print_thing(d: Describable) {
    println(d.describe())
}

fn main() {
    // Basic dynamic dispatch
    let c: Describable = Circle { radius: 5 }
    let s: Describable = Square { side: 3 }
    println(c.describe())
    println(s.describe())

    // Pass trait objects to functions
    print_thing(c)
    print_thing(s)
}
