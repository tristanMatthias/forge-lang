// Deep with chains
type A = { v1: int, v2: int, v3: int, v4: int, v5: int }
let base = A { v1: 1, v2: 2, v3: 3, v4: 4, v5: 5 }
let changed = base with { v1: 10 } with { v2: 20 } with { v3: 30 } with { v4: 40 } with { v5: 50 }
println(string(changed.v1 + changed.v2 + changed.v3 + changed.v4 + changed.v5))
// Original unchanged
println(string(base.v1 + base.v2 + base.v3 + base.v4 + base.v5))
