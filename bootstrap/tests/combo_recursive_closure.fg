// Recursive enum + closure + match + template mega combo
enum Tree {
    Leaf(value: int)
    Branch(left: Tree, right: Tree)
}

fn tree_sum(t: Tree) -> int {
    match t {
        .Leaf(v) -> v
        .Branch(l, r) -> tree_sum(l) + tree_sum(r)
    }
}

fn tree_depth(t: Tree) -> int {
    match t {
        .Leaf(_) -> 1
        .Branch(l, r) -> {
            let ld = tree_depth(l)
            let rd = tree_depth(r)
            1 + if ld > rd { ld } else { rd }
        }
    }
}

fn tree_to_string(t: Tree) -> string {
    match t {
        .Leaf(v) -> string(v)
        .Branch(l, r) -> `(${tree_to_string(l)} + ${tree_to_string(r)})`
    }
}

let tree = Tree.Branch(
    Tree.Branch(Tree.Leaf(1), Tree.Leaf(2)),
    Tree.Branch(Tree.Leaf(3), Tree.Branch(Tree.Leaf(4), Tree.Leaf(5)))
)

println(tree_to_string(tree))
println(`sum=${string(tree_sum(tree))}`)
println(`depth=${string(tree_depth(tree))}`)

// Closure over recursive fn
let summer = (t) -> { tree_sum(t) }
println(string(summer(Tree.Leaf(99))))

// List of trees
let forest = [Tree.Leaf(10), Tree.Leaf(20), Tree.Leaf(30)]
let sums = forest.map(it |> tree_sum)
println(string(sums[0]))
println(string(sums[1]))
println(string(sums[2]))
