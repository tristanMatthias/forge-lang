type DlResource = { name: string }

impl DlResource {
    fn drop(self) {
        println("dropping " + self.name)
    }
}

fn dl_run() {
    let a = DlResource { name: "A" }
    println("creating A")
    let b = DlResource { name: "B" }
    println("creating B")
    defer println("defer C")
}

spec "drop lifo" {
    then "drop and defer run in correct LIFO order" {
        avra_test_capture_start()
        dl_run()
        avra_test_capture_stop() == "creating A\ncreating B\ndefer C\ndropping B\ndropping A"
    }
}
