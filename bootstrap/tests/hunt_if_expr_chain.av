// Chained if-else expressions returning different types
let x = 10
let label = if x > 100 { "big" } else if x > 50 { "medium" } else if x > 0 { "small" } else { "zero" }
println(label)

// If-expression in function return
fn classify(n: int) -> string {
    if n > 0 { "positive" } else if n < 0 { "negative" } else { "zero" }
}
println(classify(5))
println(classify(-3))
println(classify(0))

// If-expression nested in binary
let msg = "value is " + if x > 5 { "high" } else { "low" }
println(msg)

// If-expression as function argument
fn shout(s: string) -> string { s + "!" }
println(shout(if true { "yes" } else { "no" }))
