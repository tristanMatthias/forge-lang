// Match with ALL arms guarded — does the wildcard catch?
fn classify(x: int) -> string {
    match x {
        _ if x > 100 -> "huge"
        _ if x > 50 -> "big"
        _ if x > 0 -> "positive"
        _ if x == 0 -> "zero"
        _ -> "negative"
    }
}
println(classify(200))
println(classify(75))
println(classify(25))
println(classify(0))
println(classify(-10))
