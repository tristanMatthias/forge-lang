// Float combined with every major feature — the aggressive test.

// Float in structs
type Point = { x: float, y: float }

fn dist(p: Point) -> float {
    let dx = p.x * p.x
    let dy = p.y * p.y
    dx + dy
}

// Float in enums
enum Value {
    Int(n: int)
    Float(f: float)
    Str(s: string)
}

fn value_to_string(v: Value) -> string {
    match v {
        .Int(n) -> string(n)
        .Float(f) -> string(f)
        .Str(s) -> s
    }
}

// Float in lists
fn sum_floats(nums: List<float>) -> float {
    mut total = 0.0
    for i in 0..nums.length {
        total = total + float(nums[i])
    }
    total
}

// Float with closures — NOTE: float captures are broken (TECH_DEBT)
// Closures lose float type info on captured variables.
// Use non-capturing lambdas or pass float as arg instead.

// Float in match expressions
fn classify(x: float) -> string {
    match x {
        0.0 -> "zero"
        1.0 -> "one"
        _ -> "other"
    }
}

// Float with if-expressions
fn abs(x: float) -> float {
    if x > 0.0 { x } else { 0.0 - x }
}

// Float with templates
fn describe(x: float) -> string {
    `value is ${string(x)}`
}

// Float with nullable
fn safe_div(a: float, b: float) -> float? {
    if b == 0.0 { return null }
    a / b
}

// Float with pipe operator
fn double_f(x: float) -> float { x * 2.0 }

fn main() {
    // Struct
    let p = Point { x: 3.0, y: 4.0 }
    println(string(dist(p)))

    // Enum
    println(value_to_string(Value.Float(3.14)))
    println(value_to_string(Value.Int(42)))

    // Non-capturing lambda with float
    let double_val = (x) -> float(x) * 2.0
    println(string(double_val(5)))

    // Match
    println(classify(0.0))
    println(classify(1.0))
    println(classify(99.0))

    // Abs
    println(string(abs(0.0 - 5.5)))

    // Templates
    println(describe(2.718))

    // Nullable
    let r = safe_div(10.0, 3.0)
    if r != null { println(string(r!)) }
    let bad = safe_div(1.0, 0.0)
    if bad == null { println("div by zero") }

    // Pipe
    println(string(1.5 |> double_f))

    // Arithmetic edge cases
    println(string(0.1 + 0.2))
    println(string(1000000.0 * 1000000.0))

    // Negation
    println(string(0.0 - 1.0))

    // Mixed int + float
    println(string(3.14 + float(1)))
}
