// @std/io — file read/write operations via C runtime.

extern fn avra_file_read(path: string) -> string
extern fn avra_file_write(path: string, content: string) -> int
extern fn avra_file_exists(path: string) -> int

fn main() {
    let path = "/tmp/avra_std_io_test.txt"

    // Write
    let ok = avra_file_write(path, "hello forge\nline two")
    println(string(ok))

    // Exists
    println(string(avra_file_exists(path)))
    println(string(avra_file_exists("/tmp/nonexistent_avra_test_xyz.txt")))

    // Read
    let content = avra_file_read(path)
    println(content)

    // Overwrite
    avra_file_write(path, "replaced")
    println(avra_file_read(path))
}
