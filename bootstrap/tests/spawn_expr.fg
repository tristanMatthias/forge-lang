// Spawn expression: spawn { body } creates a task.

extern fn forge_thread_join(handle: int)

fn main() {
    // Basic spawn
    let h = spawn {
        println("spawned")
    }
    forge_thread_join(h)

    // Spawn with capture
    let msg = "captured"
    let h2 = spawn {
        println(msg)
    }
    forge_thread_join(h2)

    // Spawn returns a handle (int)
    let h3 = spawn {
        println("done")
    }
    forge_thread_join(h3)
}
