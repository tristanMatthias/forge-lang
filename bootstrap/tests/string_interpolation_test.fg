fn si_run() -> string {
    forge_test_capture_start()
    let name = "world"
    println(`hello ${name}`)
    let a = 2
    let b = 3
    println(`${string(a)} + ${string(b)} = ${string(a + b)}`)
    println("nested: [1, 2, 3]")
    forge_test_capture_stop()
}

spec "string interpolation" {
    then "interpolation output" {
        si_run() == "hello world\n2 + 3 = 5\nnested: [1, 2, 3]"
    }
}
