// End-to-end @std.avrac.build.metadata tests.
//
// Compiles and runs tests/metadata_codec_fixtures/sample.av which
// exercises every public method on BytesWriter / BytesReader. Each
// round-trip prints a PROBE line; this test asserts on those lines.
//
// Why a fixture program rather than a direct import: the resolver
// currently duplicates @std.avrac.X Module wrappers when a test
// pool aggregates files importing inside @std (forge-crafting-
// intepreters-dnq4). Until the dedup at the resolver level lands,
// shelling out keeps each metadata import in its own program scope
// — same workaround used by build_cache_test, fingerprint_test, etc.
//
// Memoised at the shell level so each `then` does not re-compile.
//
// Tracking ticket: forge-crafting-intepreters-iinq.

extern fn avra_shell_exec(cmd: string) -> string

fn metadata_run_fixture() -> string {
    avra_shell_exec("if [ ! -f /tmp/avra_metadata_codec.out ]; then bash scripts/diagnose.sh --run tests/metadata_codec_fixtures/sample.av > /tmp/avra_metadata_codec.out 2>&1 || true; fi; cat /tmp/avra_metadata_codec.out")
}

fn metadata_wipe() -> string {
    avra_shell_exec("rm -f /tmp/avra_metadata_codec.out")
}

spec "metadata codec: clear cached fixture output" {
    then "wipe stale /tmp output from any prior run" {
        let _ = metadata_wipe()
        true
    }
}

spec "metadata codec: scalar round-trips" {
    then "u8 round-trips a low value" {
        metadata_run_fixture().contains("PROBE u8_low: ok")
    }
    then "u8 zero survives (no strlen truncation in the bytes layer)" {
        metadata_run_fixture().contains("PROBE u8_zero: ok")
    }
    then "u16_le round-trips" {
        metadata_run_fixture().contains("PROBE u16: ok")
    }
    then "u32_le round-trips" {
        metadata_run_fixture().contains("PROBE u32: ok")
    }
    then "u64_le round-trips above the 32-bit boundary" {
        metadata_run_fixture().contains("PROBE u64: ok")
    }
    then "u32_le emits little-endian byte order" {
        metadata_run_fixture().contains("PROBE u32_le_byte_order: ok")
    }
}

spec "metadata codec: strings" {
    then "non-empty string round-trips" {
        metadata_run_fixture().contains("PROBE string: ok")
    }
    then "empty string encodes as a u32 zero" {
        metadata_run_fixture().contains("PROBE string_empty: ok")
    }
    then "two consecutive strings decode in order" {
        metadata_run_fixture().contains("PROBE string_pair: ok")
    }
}

spec "metadata codec: mixed records" {
    then "header-style record (u32 magic + string + u64 id) round-trips" {
        metadata_run_fixture().contains("PROBE header_record: ok")
    }
    then "remaining() drops to zero after the last read" {
        metadata_run_fixture().contains("PROBE remaining_zero: ok")
    }
}

spec "metadata codec: raw + bulk" {
    then "raw passthrough preserves embedded NULs" {
        metadata_run_fixture().contains("PROBE raw_with_nul: ok")
    }
    then "100 small writes concatenate correctly on finish" {
        metadata_run_fixture().contains("PROBE many_writes: ok")
    }
}

spec "metadata codec: stable symbol IDs (FNV-1a-64)" {
    then "same qualified name hashes the same twice" {
        metadata_run_fixture().contains("PROBE sym_id_deterministic: ok")
    }
    then "different names hash to different ids" {
        metadata_run_fixture().contains("PROBE sym_id_distinct_for_distinct_input: ok")
    }
    then "empty input matches the FNV-1a-64 offset basis (canonical vector)" {
        metadata_run_fixture().contains("PROBE sym_id_empty_is_offset: ok")
    }
    then "single-byte 'a' matches the canonical FNV-1a-64 vector" {
        metadata_run_fixture().contains("PROBE sym_id_a: ok")
    }
}

spec "metadata codec: file header" {
    then "magic field round-trips as 'AVMD'" {
        metadata_run_fixture().contains("PROBE header_magic: ok")
    }
    then "version major.minor pair survives" {
        metadata_run_fixture().contains("PROBE header_version: ok")
    }
    then "unit name (length-prefixed UTF-8) round-trips" {
        metadata_run_fixture().contains("PROBE header_unit_name: ok")
    }
    then "32-byte fingerprint preserves length even with embedded NULs" {
        metadata_run_fixture().contains("PROBE header_fingerprint_len: ok")
    }
    then "fingerprint byte 0 reads back unchanged" {
        metadata_run_fixture().contains("PROBE header_fingerprint_byte0: ok")
    }
    then "fingerprint byte 31 (last) reads back unchanged" {
        metadata_run_fixture().contains("PROBE header_fingerprint_byte31: ok")
    }
    then "section count round-trips" {
        metadata_run_fixture().contains("PROBE header_section_count: ok")
    }
}

spec "metadata codec: section framing" {
    then "section kind tag decodes back to the right SectionKind variant" {
        metadata_run_fixture().contains("PROBE section_kind: ok")
    }
    then "entry count round-trips" {
        metadata_run_fixture().contains("PROBE section_entry_count: ok")
    }
    then "body length round-trips" {
        metadata_run_fixture().contains("PROBE section_body_len: ok")
    }
    then "section body byte 0 round-trips" {
        metadata_run_fixture().contains("PROBE section_body_byte0: ok")
    }
    then "section body last byte round-trips" {
        metadata_run_fixture().contains("PROBE section_body_byte4: ok")
    }
}

spec "metadata codec: multi-section file" {
    then "decoded header reports both sections" {
        metadata_run_fixture().contains("PROBE multi_header_count: ok")
    }
    then "section 1 kind round-trips (Types)" {
        metadata_run_fixture().contains("PROBE multi_section1_kind: ok")
    }
    then "section 1 body byte 0 reads correctly" {
        metadata_run_fixture().contains("PROBE multi_section1_body0: ok")
    }
    then "section 2 kind round-trips (Consts)" {
        metadata_run_fixture().contains("PROBE multi_section2_kind: ok")
    }
    then "section 2 body last byte reads correctly" {
        metadata_run_fixture().contains("PROBE multi_section2_body2: ok")
    }
}
