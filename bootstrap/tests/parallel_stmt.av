// Parallel block: each expression runs in its own thread.
// Test verifies parallel completes (all threads join before "done").

fn task_a() {}
fn task_b() {}
fn task_c() {}

fn main() {
    parallel {
        task_a
        task_b
        task_c
    }
    // If we get here, all 3 threads completed
    println("3 tasks done")
}
