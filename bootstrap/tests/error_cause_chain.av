/// expect: app: service unavailable
/// expect:   caused by: connection refused
/// expect: io: connection refused

trait Error {
    fn message(self) -> string
    fn kind(self) -> string
    fn cause_msg(self) -> string
}

type IoError = { msg: string }
type AppError = { msg: string, inner: IoError }

impl Error for IoError {
    fn message(self) -> string { self.msg }
    fn kind(self) -> string { "io" }
    fn cause_msg(self) -> string { "" }
}

impl Error for AppError {
    fn message(self) -> string { self.msg }
    fn kind(self) -> string { "app" }
    fn cause_msg(self) -> string { self.inner.msg }
}

fn show(e: Error) {
    println(e.kind() + ": " + e.message())
    let c = e.cause_msg()
    if c != "" { println("  caused by: " + c) }
}

fn main() {
    let inner = IoError { msg: "connection refused" }
    let outer = AppError { msg: "service unavailable", inner }
    show(outer)
    show(inner)
}
