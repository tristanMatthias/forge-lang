// Comprehensive bitwise tests

// AND
println(string(0xFF & 0x0F))
println(string(0 & 0xFF))
println(string(0xFF & 0xFF))

// OR
println(string(0xF0 | 0x0F))
println(string(0 | 0))
println(string(0x80 | 0x01))

// XOR
println(string(0xFF ^ 0xFF))
println(string(0xFF ^ 0x00))
println(string(0xAA ^ 0x55))

// Shift
println(string(1 << 0))
println(string(1 << 8))
println(string(1 << 16))
println(string(1024 >> 2))
println(string(255 >> 4))

// NOT
println(string(~0 & 0xFF))
println(string(~0xFF & 0xFF))

// Modulo
println(string(10 % 3))
println(string(7 % 7))
println(string(100 % 17))

// Precedence: & binds tighter than |
println(string(0xF0 | 0x0F & 0x03))
// = 0xF0 | (0x0F & 0x03) = 0xF0 | 0x03 = 0xF3 = 243

// Combo: bitwise + arithmetic
println(string((1 << 4) + 3))
println(string((0xFF & 0x0F) * 2))

// Combo: bitwise + comparison
println(string((5 & 3) == 1))
println(string((5 | 3) > 5))
