// Deep nesting of everything
type Node = { value: int, label: string }

let nodes = [
    Node { value: 1, label: "a" },
    Node { value: 2, label: "b" },
    Node { value: 3, label: "c" },
    Node { value: 4, label: "d" },
]

// for-in + struct access + match guard + template + list ops
let result = nodes
    .filter((n) -> n.value > 1)
    .map((n) -> n.value * 10)
    .reduce(0, (acc, x) -> acc + x)
println(string(result))

// Build a map from struct list
let lookup = {}
for n in nodes {
    lookup.set(n.label, string(n.value))
}
println(lookup.get("c"))

// Destructure + match
let (first, second) = (nodes[0], nodes[1])
let cmp = match first.value {
    _ if first.value > second.value -> "first bigger"
    _ if first.value == second.value -> "equal"
    _ -> "second bigger"
}
println(cmp)

// Slice + for-in + method chain
for n in nodes[1..3] {
    println(`${n.label}=${string(n.value)}`)
}
