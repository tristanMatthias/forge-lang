// t-0ks0: the leak instrument must itself be guarded.
//
// `avra_rc_live_count()` reads `rc_set`, and `rc_set_add` is reached from ONE
// place — avra_rc_alloc's FALLBACK path (strict mode / oversized / region
// exhausted). Ordinary small objects come from the bump region and are never
// added, so outside AVRA_RC_STRICT=1 the counter cannot observe them leak and
// any delta assertion written against it passes vacuously. t-c6y7 closed three
// sub-cases that way, on "delta == 0" readings that could not have been
// anything else.
//
// Two defences, and this file is the second:
//   1. runtime.c now REFUSES to answer outside strict mode (a sentinel would
//      not help — any constant still gives a zero delta between two reads).
//   2. this spec pins that the counter has real SIGNAL where it is allowed to
//      run: N deliberately stranded objects must move it by exactly N.
//
// Without (2), (1) only proves the counter is reachable, not that it measures
// anything — the same mistake one layer up.

extern fn avra_rc_live_count() -> int
extern fn avra_rc_strict_enabled() -> int

type Strandable = { items: List<int>, label: string }

fn make_strandable() -> Strandable {
    Strandable { items: [1, 2, 3], label: "stranded" }
}

/// Returns its allocations so the caller can hold them alive across the read —
/// a genuine strand, not a value the scope is free to reclaim.
fn strand(n: int) -> List<Strandable> {
    mut kept: List<Strandable> = []
    mut i = 0
    while i < n {
        kept.push(make_strandable())
        i = i + 1
    }
    kept
}

spec "the leak counter has signal where it is permitted to run (t-0ks0)" {
    given "strict mode armed, so allocations take the counted malloc path" {
        then "N stranded objects move the live count by exactly N" {
            if avra_rc_strict_enabled() == 0 {
                // Not strict: `avra_rc_live_count()` would hard-error by design
                // (see runtime.c), so there is nothing to measure here. The
                // rc-strict CI job runs this same spec with the gate open, so
                // the claim IS enforced on every PR — just not in this process.
                true
            } else {
                // Warm first: one-off allocations on the first pass would
                // otherwise read as strandings.
                let warm = strand(10)

                let before = avra_rc_live_count()
                let held = strand(100)
                let after = avra_rc_live_count()

                // `held` is still live at the read, so these 100 are genuinely
                // outstanding: the counter must have seen every one of them.
                //
                // AT LEAST 100, not EXACTLY 100, and the difference is not a
                // weakening — it is what this counter can actually promise.
                // `avra_rc_live_count()` reads the PROCESS-GLOBAL `rc_set`,
                // while a shard runs its test files as parallel `@deferred_init`
                // units (d4jv). Any sibling unit allocating between the two
                // reads lands in the same counter, so the window is shared and
                // an exact delta is not this test's to observe.
                //
                // Measured, same batch, two identical runs: delta=110 and
                // delta=291, against exactly 100 when the file runs alone. The
                // equality held only while no sibling happened to allocate in
                // the window — it was passing by scheduling luck, and a change
                // that merely shifts allocation timing elsewhere in the batch
                // turns it red with nothing wrong in the diff (t-0ks0 found it
                // exactly that way).
                //
                // The guard keeps its teeth. What it exists to catch is a
                // counter that is BLIND to a whole allocation class — which
                // reads as delta=0, or as a delta short of the 100 stranded
                // objects. Both still fail. Only the unobservable upper bound
                // is dropped, and sibling allocations can only ever push the
                // delta UP, never hide a miss.
                warm.length == 10 && held.length == 100 && after - before >= 100
            }
        }
    }
    // A NEGATIVE control belongs here too — a counter that only ever increased
    // would satisfy the positive control above while being useless for
    // detecting a leak. It is deliberately absent, because writing it surfaced
    // a real and separate defect: under strict mode a non-stranding scope does
    // NOT return to its starting count. 100 loop-local temporaries and 100
    // discarded-expression temporaries each leave delta=100 — exactly one
    // object per construction, reproducibly.
    //
    // That is either a genuine per-allocation leak (invisible in default mode,
    // since the counter cannot see region objects at all) or a strict-mode
    // accounting artifact. Either way it is not this file's claim to make, and
    // asserting the observed delta==100 here would pin a suspected bug as
    // correct. Tracked as t-0ks0 item 4; the negative control lands with the
    // explanation, not before it.
}
