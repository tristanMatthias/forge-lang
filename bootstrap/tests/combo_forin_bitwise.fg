// Combo: for-in + bitwise + lists + closures
let flags = [0x01, 0x02, 0x04, 0x08]

// OR all flags together
mut combined = 0
for f in flags {
    combined = combined | f
}
println(string(combined))

// Filter flags that are set
let test_val = 0x05
let set_flags = flags.filter((f) -> (test_val & f) != 0)
println(string(set_flags.length))
println(string(set_flags[0]))
println(string(set_flags[1]))

// Numeric underscores in lists
let big_nums = [1_000, 2_000, 3_000]
let sum = big_nums.reduce(0, (acc, x) -> acc + x)
println(string(sum))
