// Complex variable shadowing
let x = 1
println(string(x))
{
    let x = 2
    println(string(x))
    {
        let x = 3
        println(string(x))
        {
            mut x = 4
            x = x + 10
            println(string(x))
        }
        println(string(x))
    }
    println(string(x))
}
println(string(x))

// Shadow in for loop
let val = 100
for val in [1, 2, 3] {
    println(string(val))
}
println(string(val))
