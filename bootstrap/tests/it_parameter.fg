// it with int list
let nums = [1, 2, 3, 4, 5]
let doubled = nums.map(it * 2)
println(string(doubled[0]))
println(string(doubled[2]))
println(string(doubled[4]))

// it with filter
let big = nums.filter(it > 3)
println(string(big.length))
println(string(big[0]))
println(string(big[1]))

// it in complex expression
let scores = [10, 20, 30]
let adjusted = scores.map(it * 2 + 1)
println(string(adjusted[0]))
println(string(adjusted[2]))

// it in reduce (two params — it should NOT trigger)
let total = nums.reduce(0, (acc, x) -> { acc + x })
println(string(total))

// Explicit lambda still works alongside it
let tripled = nums.map((x) -> { x * 3 })
println(string(tripled[0]))
println(string(tripled[2]))
