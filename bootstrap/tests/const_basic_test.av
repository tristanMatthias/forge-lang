// Test: const bindings work correctly.

fn cb_run() -> string {
    avra_test_capture_start()
    const MAX: int = 1000
    const PI: float = 3.14
    const NAME = "avra"
    const HALF = MAX / 2
    const FLAG = true
    println(string(MAX))
    println(string(PI))
    println(NAME)
    println(string(HALF))
    println(string(FLAG))
    avra_test_capture_stop()
}

spec "const basic" {
    then "const values print correctly" {
        cb_run() == "1000\n3.14\navra\n500\n1"
    }
}
