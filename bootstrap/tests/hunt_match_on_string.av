// Match on string with guards
fn categorize(s: string) -> string {
    match s {
        _ if s == "hello" -> "greeting"
        _ if s.starts_with("err") -> "error"
        _ if s.length > 10 -> "long"
        _ if s.length == 0 -> "empty"
        _ -> "other"
    }
}
println(categorize("hello"))
println(categorize("error: bad"))
println(categorize("this is a very long string"))
println(categorize(""))
println(categorize("hi"))
