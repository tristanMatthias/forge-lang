// Test: match expression returning string type
enum Color { Red, Green, Blue }
fn color_name(c: Color) -> string {
    match c {
        .Red -> "red"
        .Green -> "green"
        .Blue -> "blue"
    }
}
let name = color_name(Color.Red)
println(`color: ${name}`)

// Test: string concatenation in various positions
fn repeat(s: string, n: int) -> string {
    if n <= 0 { return "" }
    s + repeat(s, n - 1)
}
println(repeat("ha", 3))

// Test: null coalescing type propagation
let maybe: string? = null
let result = maybe ?? "default"
println(result)

// Test: struct field type
type Person = { name: string, age: int }
let p = Person { name: "Alice", age: 30 }
println(`${p.name} is ${string(p.age)}`)
