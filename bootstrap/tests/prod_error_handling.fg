// Error handling — ? operator + ?? + match + enums
enum ParseResult {
    Ok(value: int),
    Err(msg: string),
}

fn parse_int(s: string) -> ParseResult {
    if s == "" { return ParseResult.Err("empty string") }
    ParseResult.Ok(int(s))
}

fn safe_divide(a: int, b: int) -> int? {
    if b == 0 { return null }
    a / b
}

fn process(input: string) -> string {
    let parsed = parse_int(input)
    match parsed {
        .Ok(v) -> {
            let half = safe_divide(v, 2) ?? -1
            `${input} -> ${string(v)} / 2 = ${string(half)}`
        }
        .Err(msg) -> `error: ${msg}`
    }
}

println(process("42"))
println(process("100"))
println(process(""))
println(process("7"))

// Chain of nullable operations
fn step1(x: int) -> int? { if x > 0 { return x * 2 }
    null }
fn step2(x: int) -> int? { if x < 100 { return x + 1 }
    null }
fn pipeline(x: int) -> int? {
    let a = step1(x)?
    let b = step2(a)?
    b
}
println(string(pipeline(5) ?? -1))
println(string(pipeline(-1) ?? -1))
println(string(pipeline(60) ?? -1))
