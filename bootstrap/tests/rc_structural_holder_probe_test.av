// t-c6y7 re-verification. The struct-literal alias-retain fix (ps3t.8.5) and
// its indexed-element sibling (#911) are both landed and guarded. The OTHER
// three named siblings — tuple literals, enum-ctor payloads, and list literals
// — do NOT over-release: storing a param into a tuple/enum/list local and
// letting that local die leaves the caller's contents intact, so the struct
// retain must NOT be copied into those emitters (it would add a tick to a
// holder whose contents are already reclaimed — an over-retain).
//
// This file exists because CLAUDE.md asserted the opposite for months ("sibling
// emitters … still carry the bug"), which is an invitation to "fix" three
// correct emitters and break them. It pins the measurement so the correction is
// defended by a spec rather than by prose alone.
//
// SCOPE, deliberately narrow: these specs cover OVER-RELEASE only. t-c6y7 also
// concluded "no leak" for these three from an `avra_rc_live_count()` delta of
// zero — but that counter only sees `rc_set`, which `avra_rc_alloc` populates
// on its FALLBACK path, so it is blind to the bump-region allocations these
// shapes actually use. Positive control: 150 deliberately stranded InnerBoxes
// read delta=0 by default and delta=150 under AVRA_RC_STRICT=1. The leak
// question is therefore still open and is tracked as t-0ks0 — do not read
// these specs as settling it.



type InnerBox = { items: List<int>, label: string }

enum Wrap {
    W(inner: InnerBox)
}

fn make_inner() -> InnerBox {
    InnerBox { items: [1, 2, 3], label: "shared" }
}

/// Stores its PARAM into a TUPLE literal and lets the tuple local die.
fn hold_param_tuple(inner: InnerBox) -> int {
    let t = (inner, 1)
    t.0.items.length
}

/// Stores its PARAM into an ENUM-CTOR payload and lets the enum local die.
fn hold_param_enum(inner: InnerBox) -> int {
    let w = Wrap.W(inner)
    match w {
        .W(i) -> i.items.length
    }
}

/// Stores its PARAM into a LIST literal and lets the list local die.
fn hold_param_list(inner: InnerBox) -> int {
    let xs = [inner]
    xs[0].items.length
}

/// Repeated builds, each holding a FRESH heap value through all three
/// emitters — the shape the over-release specs above exercise once.
fn churn_structural_holders(rounds: int) -> int {
    mut i = 0
    mut acc = 0
    while i < rounds {
        acc = acc + hold_param_tuple(make_inner())
        acc = acc + hold_param_enum(make_inner())
        acc = acc + hold_param_list(make_inner())
        i = i + 1
    }
    acc
}

spec "structural holders do not over-release an aliased param (t-c6y7 #1-3)" {
    // The struct-literal form of this exact shape SIGSEGV'd on call 2 before
    // ps3t.8.5. One claim per `then`, so a failure names which emitter broke.
    given "a param stored into a TUPLE local by a fn called repeatedly" {
        then "the argument's contents survive every call" {
            let inner = make_inner()
            let a = hold_param_tuple(inner)
            let b = hold_param_tuple(inner)
            let c = hold_param_tuple(inner)
            a == 3 && b == 3 && c == 3 && inner.items.length == 3 && inner.label == "shared"
        }
    }
    given "a param stored into an ENUM-CTOR payload by a fn called repeatedly" {
        then "the argument's contents survive every call" {
            let inner = make_inner()
            let a = hold_param_enum(inner)
            let b = hold_param_enum(inner)
            let c = hold_param_enum(inner)
            a == 3 && b == 3 && c == 3 && inner.items.length == 3 && inner.label == "shared"
        }
    }
    given "a param stored into a LIST literal by a fn called repeatedly" {
        then "the argument's contents survive every call" {
            let inner = make_inner()
            let a = hold_param_list(inner)
            let b = hold_param_list(inner)
            let c = hold_param_list(inner)
            a == 3 && b == 3 && c == 3 && inner.items.length == 3 && inner.label == "shared"
        }
    }
}

spec "the churn helper builds what the over-release specs assume" {
    given "repeated builds each holding a FRESH heap value" {
        then "every build reads its contents back correctly" {
            // Deliberately NOT a leak assertion. `avra_rc_live_count()` counts
            // only `rc_set`, which `avra_rc_alloc` populates on its FALLBACK
            // path (strict mode / oversized / region exhausted) — normal small
            // objects come from the bump region and are never added. Measured
            // with a positive control of 150 deliberately stranded InnerBoxes:
            // delta=0 by default, delta=150 under AVRA_RC_STRICT=1. So a
            // default-mode live-count assertion here would pass whether or not
            // these emitters leak, i.e. a guard that cannot fail. The leak
            // question is tracked separately; this spec pins only that the
            // churn shape the over-release specs rely on actually round-trips.
            churn_structural_holders(5) == 45 && churn_structural_holders(50) == 450
        }
    }
}
