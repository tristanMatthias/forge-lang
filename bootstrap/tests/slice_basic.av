let nums = [10, 20, 30, 40, 50]

// Basic slice
let mid = nums[1..4]
println(string(mid.length))
println(string(mid[0]))
println(string(mid[1]))
println(string(mid[2]))

// Slice from start
let first2 = nums[0..2]
println(string(first2.length))
println(string(first2[0]))

// Slice to end
let last2 = nums[3..5]
println(string(last2.length))
println(string(last2[0]))

// Empty slice
let empty = nums[2..2]
println(string(empty.length))

// Full slice (copy)
let copy = nums[0..5]
println(string(copy.length))

// Slice + for-in
for x in nums[1..4] {
    println(string(x))
}
