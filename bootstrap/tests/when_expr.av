/// expect: negative
/// expect: zero
/// expect: normal
/// expect: large

fn classify(n: int) -> string {
    when {
        n < 0 -> "negative"
        n == 0 -> "zero"
        n > 100 -> "large"
        _ -> "normal"
    }
}

fn main() {
    println(classify(-5))
    println(classify(0))
    println(classify(42))
    println(classify(200))
}
