fn uo_run() -> string {
    avra_test_capture_start()
    println(string(-42))
    println(string(-(-10)))
    println(string(!0))
    println(string(!1))
    println(string(not true))
    println(string(not false))
    println(string(-5 + 10))
    println(string(-(5 + 10)))
    avra_test_capture_stop()
}

spec "unary ops" {
    then "unary ops output" {
        uo_run() == "-42\n10\ntrue\nfalse\nfalse\ntrue\n5\n-15"
    }
}
