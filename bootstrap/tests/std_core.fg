// @std/core — fundamental types and traits.
// Verifies int, float, bool, string, Result, Option all work correctly.

fn double(x: int) -> int { x * 2 }

fn safe_div(a: int, b: int) -> int? {
    if b == 0 { return null }
    a / b
}

fn main() {
    // Int
    let x = 42
    println(string(x))
    println(string(x + 8))
    println(string(-x))

    // Float
    let f = 3.14
    println(string(f))
    let g = f + 1.0
    println(string(g))

    // Bool
    let t = true
    let f2 = false
    println(string(t))
    println(string(f2))
    println(string(t && f2))
    println(string(t || f2))
    println(string(!f2))

    // String
    let s = "hello"
    println(s)
    println(s + " world")
    println(string(s.length))

    // Nullable (Option-like)
    let r1 = safe_div(10, 2)
    let r2 = safe_div(10, 0)
    if r1 != null { println("div ok: " + string(r1 ?? 0)) }
    if r2 == null { println("div by zero: null") }

    // Null coalesce
    let val = r2 ?? -1
    println(string(val))

    // Functions as values
    let f3 = double
    println(string(f3(21)))
}
