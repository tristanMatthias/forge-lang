// @std/channel — channel operations and spawn.

extern fn avra_spawn(closure: int) -> int
extern fn avra_thread_join(handle: int)
extern fn avra_channel_new() -> ptr
extern fn avra_channel_send(ch: ptr, value: int)
extern fn avra_channel_recv(ch: ptr) -> int
extern fn avra_channel_close(ch: ptr)

mut ch: ptr = null

fn producer() {
    avra_channel_send(ch, 1)
    avra_channel_send(ch, 2)
    avra_channel_send(ch, 3)
}

fn main() {
    // Basic channel send/recv
    ch = avra_channel_new()
    let h = avra_spawn(producer)

    let a = avra_channel_recv(ch)
    let b = avra_channel_recv(ch)
    let c = avra_channel_recv(ch)
    avra_thread_join(h)

    println(string(a))
    println(string(b))
    println(string(c))
    println(string(a + b + c))

    // Close channel
    avra_channel_close(ch)
    println("closed ok")

    // Select with two channels
    let ch1 = avra_channel_new()
    let ch2 = avra_channel_new()
    avra_channel_send(ch1, 100)

    select {
        v <- ch1 -> { println("ch1: " + string(v)) }
        v <- ch2 -> { println("ch2: " + string(v)) }
    }
}
