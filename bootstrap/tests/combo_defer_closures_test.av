fn cdc_process(items: List) -> string {
    let results = items.map(it * 2)
    if results.length == 0 { return "empty" }
    string(results[0])
}

fn cdc_classify(n: int) -> string {
    defer println("classify done")
    if n > 100 { return "huge" }
    if n > 10 { return "big" }
    if n > 0 { return "small" }
    "zero"
}

fn cdc_join_with(items: List, sep: string) -> string {
    defer println("join done")
    items.reduce("", (acc, x) -> {
        if acc == "" { return string(x) }
        acc + sep + string(x)
    })
}

fn cdc_run() -> string {
    avra_test_capture_start()
    println(cdc_process([5, 10]))
    println(cdc_classify(200))
    println(cdc_classify(50))
    println(cdc_classify(3))
    println(cdc_classify(0))
    println(cdc_join_with([1, 2, 3], "-"))
    avra_test_capture_stop()
}

spec "combo defer closures" {
    then "defer and closure combo" {
        cdc_run() == "10\nclassify done\nhuge\nclassify done\nbig\nclassify done\nsmall\nclassify done\nzero\njoin done\n1-2-3"
    }
}
