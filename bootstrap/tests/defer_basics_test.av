// Test: basic defer behavior.

fn db_basic() {
    defer println("cleanup!")
    println("working...")
}

fn db_lifo() {
    defer println("third (first deferred)")
    defer println("second")
    defer println("first (last deferred)")
    println("body")
}

fn db_early(x: int) -> string {
    defer println("always runs")
    if x > 0 {
        return "positive"
    }
    "non-positive"
}

fn db_run_basic() -> string {
    avra_test_capture_start()
    db_basic()
    avra_test_capture_stop()
}

fn db_run_lifo() -> string {
    avra_test_capture_start()
    db_lifo()
    avra_test_capture_stop()
}

fn db_run_early() -> string {
    avra_test_capture_start()
    println(db_early(5))
    println(db_early(-1))
    avra_test_capture_stop()
}

spec "defer basics" {
    then "basic cleanup runs after body" {
        db_run_basic() == "working...\ncleanup!"
    }
    then "multiple defers run in LIFO order" {
        db_run_lifo() == "body\nfirst (last deferred)\nsecond\nthird (first deferred)"
    }
    then "defer runs with early return" {
        db_run_early() == "always runs\npositive\nalways runs\nnon-positive"
    }
}
