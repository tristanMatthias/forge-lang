// Phase 3 (vez6.3) of Components V2: end-to-end test for `quote { ... }`.
// Captures small expressions as runtime AST values, verifies via the
// render_expr S-expression serializer that the captured shape matches.

use @std.avrac.core.{NodeStore, new_node_store, build_line_index, Expr, render_expr, Stmt, SStmt, render_stmt, render_stmt_list, ValueType, vtype_display}

/// Fresh empty store for inline-AST probes — F2 renderers resolve
/// flipped pattern ids through it (never read for id-free nodes).
fn ts() -> NodeStore {
    new_node_store(build_line_index(""))
}


spec "quote: literals" {
    then "number literal" {
        let e = quote { 42 }
        render_expr(ts(), e) == "42"
    }
    then "string literal" {
        let e = quote { "hi" }
        render_expr(ts(), e) == "\"hi\""
    }
    then "bool literal" {
        let e = quote { true }
        render_expr(ts(), e) == "true"
    }
    then "null literal renders canonically as none" {
        let e = quote { null }
        render_expr(ts(), e) == "none"
    }
    then "none literal" {
        let e = quote { none }
        render_expr(ts(), e) == "none"
    }
}

spec "quote: identifier capture" {
    then "bare identifier" {
        let e = quote { my_var }
        render_expr(ts(), e) == "my_var"
    }
    then "identifier in arithmetic" {
        let e = quote { x + y }
        render_expr(ts(), e) == "(+ x y)"
    }
}

spec "quote: arithmetic" {
    then "addition" {
        let e = quote { 5 + 7 }
        render_expr(ts(), e) == "(+ 5 7)"
    }
    then "nested arithmetic" {
        let e = quote { 1 + 2 * 3 }
        render_expr(ts(), e) == "(+ 1 (* 2 3))"
    }
    then "subtraction" {
        let e = quote { 10 - 3 }
        render_expr(ts(), e) == "(- 10 3)"
    }
    then "comparison" {
        let e = quote { 1 == 2 }
        render_expr(ts(), e) == "(== 1 2)"
    }
}

spec "quote: unary" {
    then "negation" {
        let e = quote { -5 }
        render_expr(ts(), e) == "(- 5)"
    }
    then "logical not" {
        let e = quote { !true }
        render_expr(ts(), e) == "(! true)"
    }
}

spec "quote: function calls" {
    then "no-arg call" {
        let e = quote { f() }
        render_expr(ts(), e) == "(call f ())"
    }
    then "single arg" {
        let e = quote { g(7) }
        render_expr(ts(), e) == "(call g (7))"
    }
    then "multiple args" {
        let e = quote { add(1, 2) }
        render_expr(ts(), e) == "(call add (1, 2))"
    }
    then "nested calls" {
        let e = quote { f(g(x)) }
        render_expr(ts(), e) == "(call f ((call g (x))))"
    }
}

spec "quote: field + index access" {
    then "field access" {
        let e = quote { obj.field }
        render_expr(ts(), e) == "(field obj field)"
    }
    then "chained field" {
        let e = quote { a.b.c }
        render_expr(ts(), e) == "(field (field a b) c)"
    }
    then "index access" {
        let e = quote { xs[0] }
        render_expr(ts(), e) == "(index xs 0)"
    }
}

spec "quote: collections" {
    then "tuple two" {
        let e = quote { (a, b) }
        render_expr(ts(), e) == "(tuple (a, b))"
    }
    then "tuple three" {
        let e = quote { (1, 2, 3) }
        render_expr(ts(), e) == "(tuple (1, 2, 3))"
    }
    then "list literal" {
        let e = quote { [1, 2, 3] }
        render_expr(ts(), e) == "(list (1, 2, 3))"
    }
    then "empty list" {
        let e = quote { [] }
        render_expr(ts(), e) == "(list ())"
    }
}

spec "quote: null safety" {
    then "null coalesce" {
        let e = quote { a ?? b }
        render_expr(ts(), e) == "(?? a b)"
    }
    then "optional chain" {
        let e = quote { obj?.field }
        render_expr(ts(), e) == "(?. obj field)"
    }
    then "optional method call (first-class node)" {
        let e = quote { obj?.m(1) }
        render_expr(ts(), e) == "(?.call obj m (1))"
    }
    then "try propagation" {
        let e = quote { fallible? }
        render_expr(ts(), e) == "(? fallible)"
    }
}

spec "quote: float literal" {
    then "simple float" {
        let e = quote { 3.14 }
        render_expr(ts(), e) == "3.14"
    }
}

spec "quote: struct literal" {
    then "single field" {
        let e = quote { Point { x: 1 } }
        render_expr(ts(), e) == "(struct Point (x=1))"
    }
    then "two fields" {
        let e = quote { Point { x: 1, y: 2 } }
        render_expr(ts(), e) == "(struct Point (x=1, y=2))"
    }
    then "three fields" {
        let e = quote { Point3 { x: 1, y: 2, z: 3 } }
        render_expr(ts(), e) == "(struct Point3 (x=1, y=2, z=3))"
    }
}

spec "quote: lambda" {
    then "no params" {
        let e = quote { () -> 42 }
        render_expr(ts(), e) == "(lambda () 42)"
    }
    then "one param" {
        let e = quote { (x) -> x + 1 }
        render_expr(ts(), e) == "(lambda (x) (+ x 1))"
    }
    then "two params" {
        let e = quote { (x, y) -> x + y }
        render_expr(ts(), e) == "(lambda (x, y) (+ x y))"
    }
}

spec "quote: map literal" {
    then "single entry" {
        let e = quote { ({"a": 1}) }
        render_expr(ts(), e) == "(group (map (\"a\", 1)))"
    }
}

spec "quote: with-update" {
    then "single override" {
        let e = quote { obj with { x: 5 } }
        render_expr(ts(), e) == "(with obj (x=5))"
    }
}

spec "quote: tuple index" {
    then "first index" {
        let e = quote { t.0 }
        render_expr(ts(), e) == "(tuple-idx t 0)"
    }
    then "third index" {
        let e = quote { t.2 }
        render_expr(ts(), e) == "(tuple-idx t 2)"
    }
}

spec "quote: is + in checks" {
    then "is-check" {
        let e = quote { x is .Some }
        render_expr(ts(), e) == "(is x .Some)"
    }
}

// Regression: lower_expr previously dropped to `_ -> expr` for many
// container variants, leaving an inner Quote unlowered. Verifies the
// walker recurses into struct-literal fields, list elements, and
// tuple elements.
spec "quote: nested quote inside container is lowered" {
    then "inner quote inside list literal" {
        // outer quote builds a list-construction Expr; inner quote
        // builds a number literal. After lowering both, evaluating
        // the outer Expr should yield a runtime Expr.ListLit value
        // whose first element is itself an Expr.Number.
        let outer = quote { [quote { 42 }] }
        // The outer Expr is .ListLit with one element. The element is
        // the LOWERED inner quote — which evaluates to Expr.Number("42").
        // We check by asserting outer's render contains the marker for
        // the lowered (constructed) form, not the unlowered Quote form.
        !render_expr(ts(), outer).contains("quote ")
    }
    then "inner quote inside struct field" {
        let outer = quote { Foo { x: quote { 7 } } }
        !render_expr(ts(), outer).contains("quote ")
    }
}

// ── Red-team / edge-case stress tests (vez6.3.8) ──

// Operator precedence preserves the parse tree exactly.
spec "quote: precedence preserved" {
    then "mul before add" {
        let e = quote { a + b * c }
        render_expr(ts(), e) == "(+ a (* b c))"
    }
    then "and before or" {
        let e = quote { a || b && c }
        render_expr(ts(), e) == "(|| a (&& b c))"
    }
    then "explicit parens override precedence" {
        let e = quote { (a + b) * c }
        render_expr(ts(), e) == "(* (group (+ a b)) c)"
    }
    then "comparison precedence" {
        let e = quote { a + b == c - d }
        render_expr(ts(), e) == "(== (+ a b) (- c d))"
    }
}

// Deeply nested recursion: lowerings are not stack-bounded.
spec "quote: deep nesting" {
    then "8-level groupings" {
        let e = quote { ((((((((1)))))))) }
        render_expr(ts(), e).contains("(group ")
    }
    then "deeply chained binary" {
        let e = quote { 1 + 2 + 3 + 4 + 5 + 6 + 7 + 8 }
        render_expr(ts(), e).contains("(+ ") && render_expr(ts(), e).contains("8")
    }
    then "list-of-lists" {
        let e = quote { [[1, 2], [3, 4], [5, 6]] }
        render_expr(ts(), e) == "(list ((list (1, 2)), (list (3, 4)), (list (5, 6))))"
    }
    then "tuple-of-tuples" {
        let e = quote { ((1, 2), (3, 4)) }
        render_expr(ts(), e) == "(tuple ((tuple (1, 2)), (tuple (3, 4))))"
    }
}

// Unary stacking should preserve order — important for `-(-x)` etc.
spec "quote: stacked unaries" {
    then "double negation" {
        let e = quote { --5 }
        render_expr(ts(), e) == "(- (- 5))"
    }
    then "double not" {
        let e = quote { !!flag }
        render_expr(ts(), e) == "(! (! flag))"
    }
    then "negated call" {
        let e = quote { -f(x) }
        render_expr(ts(), e) == "(- (call f (x)))"
    }
}

// Long identifier names, snake-case, single-char — exercise the
// string_arg path for the Ident variant.
spec "quote: identifier shapes" {
    then "snake_case identifier" {
        let e = quote { user_id_value }
        render_expr(ts(), e) == "user_id_value"
    }
    then "single-char identifier" {
        let e = quote { x }
        render_expr(ts(), e) == "x"
    }
    then "trailing-digit identifier" {
        let e = quote { x1 }
        render_expr(ts(), e) == "x1"
    }
}

// String literal edge cases — the parser stores Expr.String.value with
// surrounding quotes, and codegen's strip_quotes must round-trip.
spec "quote: string-literal shapes" {
    then "empty string" {
        let e = quote { "" }
        render_expr(ts(), e) == "\"\""
    }
    then "single space" {
        let e = quote { " " }
        render_expr(ts(), e) == "\" \""
    }
    then "longer ASCII" {
        let e = quote { "hello world" }
        render_expr(ts(), e) == "\"hello world\""
    }
}

// Number-literal edge cases.
spec "quote: number shapes" {
    then "zero" {
        let e = quote { 0 }
        render_expr(ts(), e) == "0"
    }
    then "large number" {
        let e = quote { 1000000 }
        render_expr(ts(), e) == "1000000"
    }
    then "negative literal via unary" {
        let e = quote { -1 }
        render_expr(ts(), e) == "(- 1)"
    }
}

// Quote-kind variants (vez6.3.10).
spec "quote: kind dispatch" {
    then "quote stmt yields a Stmt value" {
        let s: Stmt = quote stmt { let x = 5 }
        render_stmt(ts(), s) == "(let x:<unknown> 5)"
    }
    then "quote stmts yields a List<SStmt> value" {
        let sl: List<SStmt> = quote stmts {
            let a = 1
            let b = 2
        }
        render_stmt_list(ts(), sl).contains("let a") && render_stmt_list(ts(), sl).contains("let b")
    }
    then "quote decl with let acts like stmt" {
        let s: Stmt = quote decl { let x = 5 }
        render_stmt(ts(), s) == "(let x:<unknown> 5)"
    }
    then "quote stmt with return" {
        let s: Stmt = quote stmt { return 42 }
        render_stmt(ts(), s) == "(return 42)"
    }
    then "quote stmt with if" {
        let s: Stmt = quote stmt {
            if cond { a } else { b }
        }
        render_stmt(ts(), s).contains("(if cond")
    }
    then "quote stmts with single stmt" {
        let sl: List<SStmt> = quote stmts { let x = 1 }
        render_stmt_list(ts(), sl).contains("let x")
    }
    then "quote default kind is expr" {
        let e: Expr = quote { 42 }
        render_expr(ts(), e) == "42"
    }
}

// quote type — primitive type names (vez6.3.13 partial).
spec "quote: type primitives" {
    then "int" {
        let t: ValueType = quote type { int }
        vtype_display(t) == "int"
    }
    then "string" {
        let t: ValueType = quote type { string }
        vtype_display(t) == "string"
    }
    then "bool" {
        let t: ValueType = quote type { bool }
        vtype_display(t) == "bool"
    }
    then "float" {
        let t: ValueType = quote type { float }
        vtype_display(t) == "float"
    }
    then "void" {
        let t: ValueType = quote type { void }
        vtype_display(t) == "void"
    }
    then "unknown name → ValueType.Unknown" {
        let t: ValueType = quote type { Foo }
        vtype_display(t) == "<unknown>"
    }
}

// Splice ~target (vez6.4) — interpolate runtime AST values into quotes.
spec "quote: splice expressions" {
    then "splice ident-like value into binary expression" {
        let x: Expr = Expr.Ident("hello")
        let e = quote { ~x + 1 }
        render_expr(ts(), e) == "(+ hello 1)"
    }
    then "splice number" {
        let n: Expr = Expr.Number("42")
        let e = quote { ~n * 2 }
        render_expr(ts(), e) == "(* 42 2)"
    }
    then "splice both operands" {
        let lhs: Expr = Expr.Ident("a")
        let rhs: Expr = Expr.Ident("b")
        let e = quote { ~lhs + ~rhs }
        render_expr(ts(), e) == "(+ a b)"
    }
    then "splice into call argument" {
        let arg: Expr = Expr.Ident("user_var")
        let e = quote { f(~arg) }
        render_expr(ts(), e) == "(call f (user_var))"
    }
    then "splice paren-wrapped expression" {
        let inner: Expr = Expr.Binary(Expr.Number("3"), .Mul, Expr.Number("4"))
        let e = quote { 1 + ~(inner) }
        render_expr(ts(), e) == "(+ 1 (* 3 4))"
    }
    then "splice into nested call" {
        let v: Expr = Expr.Ident("z")
        let e = quote { f(g(~v)) }
        render_expr(ts(), e) == "(call f ((call g (z))))"
    }
    then "splice into list element" {
        let v: Expr = Expr.Number("99")
        let e = quote { [1, ~v, 3] }
        render_expr(ts(), e) == "(list (1, 99, 3))"
    }
    then "splice nested quote-built target" {
        // The splice target can be ANY expression that produces an
        // AST value at expansion time — not just a bare ident.
        let inner: Expr = Expr.Number("7")
        let e = quote { 5 + ~inner }
        render_expr(ts(), e) == "(+ 5 7)"
    }
}

// vez6.4.3 — red-team for splice.
spec "quote: splice red-team" {
    then "splice into struct field" {
        let v: Expr = Expr.Number("99")
        let e = quote { Point { x: ~v, y: 0 } }
        render_expr(ts(), e) == "(struct Point (x=99, y=0))"
    }
    then "splice into tuple element" {
        let v: Expr = Expr.Ident("z")
        let e = quote { (1, ~v, 3) }
        render_expr(ts(), e) == "(tuple (1, z, 3))"
    }
    then "splice composes with itself" {
        let a: Expr = Expr.Ident("alpha")
        let b: Expr = Expr.Ident("beta")
        let e = quote { ~a * ~b + ~a }
        render_expr(ts(), e) == "(+ (* alpha beta) alpha)"
    }
    then "tilde outside quote stays as BitNot" {
        // Outside any quote body, ~5 = -6 (bitwise NOT).
        let n = ~5
        n == 0 - 6
    }
    then "splice in negation" {
        let v: Expr = Expr.Number("3")
        let e = quote { -~v }
        render_expr(ts(), e) == "(- 3)"
    }
    then "splice in if condition" {
        let cond: Expr = Expr.Bool("true")
        let e = quote { if ~cond { 1 } else { 2 } }
        render_expr(ts(), e).contains("(if true") && render_expr(ts(), e).contains("(expr 1)") && render_expr(ts(), e).contains("(expr 2)")
    }
    then "splice as call callee — paren-grouped" {
        // Splice is greedy: `~f(x)` would splice the entire `f(x)`,
        // requiring `f` and `x` to be in scope. To splice only `f`
        // and call it with quoted-arg `x`, paren-group the splice:
        // `(~f)(my_arg)` — the parens scope the splice tightly,
        // then the call adds postfix args inside the quote.
        let f: Expr = Expr.Ident("my_fn")
        let e = quote { (~f)(my_arg) }
        render_expr(ts(), e).contains("my_fn") && render_expr(ts(), e).contains("my_arg")
    }
}

// Multi-statement quote bodies (vez6.3.9).
spec "quote: multi-statement block bodies" {
    then "let + expression" {
        let e = quote {
            let x = 5
            x + 1
        }
        render_expr(ts(), e).contains("block-expr") && render_expr(ts(), e).contains("let x") && render_expr(ts(), e).contains("(+ x 1)")
    }
    then "two lets" {
        let e = quote {
            let a = 1
            let b = 2
        }
        render_expr(ts(), e).contains("let a") && render_expr(ts(), e).contains("let b")
    }
    then "if statement inside block" {
        let e = quote {
            if cond {
                a
            } else {
                b
            }
        }
        render_expr(ts(), e).contains("(if cond")
    }
    then "while loop" {
        let e = quote {
            while x < 10 {
                x = x + 1
            }
        }
        render_expr(ts(), e).contains("(while")
    }
    then "for-in loop" {
        let e = quote {
            for x in xs {
                x
            }
        }
        render_expr(ts(), e).contains("(for-in x")
    }
    then "return statement" {
        let e = quote {
            return 42
        }
        render_expr(ts(), e).contains("(return 42)")
    }
    then "defer in block" {
        let e = quote {
            defer cleanup()
            do_work()
        }
        render_expr(ts(), e).contains("(defer ")
    }
}
