// WHY: renders Diagnostics to stderr with source context.
// Hybrid design inspired by ariadne (box frame), miette (severity
// symbols), Roc (Unicode separators), and codespan (connecting carets).

use diagnostics.{Diagnostic, DiagnosticBag, DiagnosticList, DiagnosticCause, Span, Severity, severity_str, diag_code_str, confidence_str}

// ── ANSI colors ──

fn color_red(s: string) -> string { "\x1b[1;31m${s}\x1b[0m" }
fn color_yellow(s: string) -> string { "\x1b[1;33m${s}\x1b[0m" }
fn color_cyan(s: string) -> string { "\x1b[1;36m${s}\x1b[0m" }
fn color_bold(s: string) -> string { "\x1b[1m${s}\x1b[0m" }
fn color_dim(s: string) -> string { "\x1b[2m${s}\x1b[0m" }
fn color_blue(s: string) -> string { "\x1b[1;34m${s}\x1b[0m" }
fn color_gray(s: string) -> string { "\x1b[90m${s}\x1b[0m" }
fn color_magenta(s: string) -> string { "\x1b[1;35m${s}\x1b[0m" }

fn severity_color(sev: Severity, text: string) -> string {
    match sev {
        .Error -> color_red(text)
        .Warning -> color_yellow(text)
        .Info -> color_cyan(text)
        .Hint -> color_blue(text)
    }
}

fn severity_symbol(sev: Severity) -> string {
    match sev {
        .Error -> color_red("\xc3\x97")      // × (U+00D7)
        .Warning -> color_yellow("\xe2\x9a\xa0")  // ⚠ (U+26A0)
        .Info -> color_cyan("i")
        .Hint -> color_blue("\xe2\x98\x9e")   // ☞ (U+261E)
    }
}

// ── Unicode box drawing ──

fn chr_vbar() -> string { "\xe2\x94\x82" }         // │ U+2502
fn chr_hbar() -> string { "\xe2\x94\x80" }         // ─ U+2500
fn chr_ltop() -> string { "\xe2\x95\xad" }         // ╭ U+256D
fn chr_lbot() -> string { "\xe2\x95\xb0" }         // ╰ U+2570
fn chr_rbot() -> string { "\xe2\x95\xaf" }         // ╯ U+256F
fn chr_caret() -> string { "\xe2\x94\xac" }        // ┬ U+252C
fn chr_dot() -> string { "\xc2\xb7" }              // · U+00B7

// ── Line extraction ──

fn extract_line(source: string, target: int) -> string {
    if target <= 0 { return "" }
    mut line_num = 1
    mut line_start = 0
    mut i = 0
    while i < source.length {
        if source[i] == "\n" {
            if line_num == target {
                return source.substring(line_start, i)
            }
            line_num = line_num + 1
            line_start = i + 1
        }
        i = i + 1
    }
    if line_num == target {
        return source.substring(line_start, source.length)
    }
    ""
}

fn repeat_char(ch: string, n: int) -> string {
    if n <= 0 { return "" }
    mut out = ""
    for i in 0..n {
        out = out + ch
    }
    out
}

fn repeat_hbar(n: int) -> string {
    repeat_char(chr_hbar(), n)
}

fn gutter(line: int, width: int) -> string {
    let s = string(line)
    let pad = width - s.length
    repeat_char(" ", pad) + s
}

fn gutter_width(line: int) -> int {
    let s = string(line)
    if s.length < 3 { return 3 }
    s.length
}

// ── Single diagnostic rendering ──

export fn render_diagnostic(source: string, filename: string, diag: Diagnostic) {
    let line = diag.span.line
    let col = diag.span.col
    let w = gutter_width(line)
    let vbar = color_gray(chr_vbar())
    let pad = repeat_char(" ", w)
    let code_str = diag_code_str(diag.code)

    // Header:  × error[F0010]: expected `{` after if condition
    let sym = severity_symbol(diag.severity)
    let sev = severity_str(diag.severity)
    let header = severity_color(diag.severity, `${sev}[${code_str}]`)
    eprintln(`  ${sym} ${header}${color_bold(": ${diag.message}")}`)

    if line > 0 && col > 0 {
        // Box top: ╭─[file.fg:2:5]
        let loc = `${filename}:${string(line)}:${string(col)}`
        eprintln(`  ${pad} ${color_gray(chr_ltop() + chr_hbar())}[${color_dim(loc)}]`)

        // Blank gutter
        eprintln(`  ${pad} ${vbar}`)

        // Source line — highlight the error span in the severity color
        let src_line = extract_line(source, line)
        // Guard: if source line not found (global line number from
        // multi-module compilation), skip the source display.
        if src_line.length == 0 {
            eprintln("")
            return
        }
        let span_len = diag.span.end - diag.span.start
        let hi_len = if span_len > 0 { span_len } else { 1 }
        let hi_start = col - 1
        let hi_end = hi_start + hi_len
        let before_span = if hi_start > 0 { src_line.substring(0, hi_start) } else { "" }
        let in_span = if hi_end <= src_line.length {
            src_line.substring(hi_start, hi_end)
        } else {
            src_line.substring(hi_start, src_line.length)
        }
        let after_span = if hi_end < src_line.length { src_line.substring(hi_end, src_line.length) } else { "" }
        let highlighted_line = before_span + severity_color(diag.severity, in_span) + after_span
        eprintln(`  ${color_gray(gutter(line, w))} ${vbar} ${highlighted_line}`)

        // Caret line:  · │   ──┬──
        let underline_len = hi_len
        let before = repeat_char(" ", col - 1)

        if underline_len == 1 {
            // Single char: just ┬
            let caret = severity_color(diag.severity, chr_caret())
            eprintln(`  ${color_gray("${pad} ${chr_dot()}")} ${before}${caret}`)
        } else {
            // Multi char: ──┬──
            let half = underline_len / 2
            let left_bars = repeat_hbar(half)
            let right_bars = repeat_hbar(underline_len - half - 1)
            let caret_line = severity_color(diag.severity, "${left_bars}${chr_caret()}${right_bars}")
            eprintln(`  ${color_gray("${pad} ${chr_dot()}")} ${before}${caret_line}`)
        }

        // Label line:  · │   ╰── message
        let label_pad = repeat_char(" ", col - 1 + underline_len / 2)
        let connector = severity_color(diag.severity, chr_lbot() + chr_hbar() + chr_hbar())
        eprintln(`  ${color_gray("${pad} ${chr_dot()}")} ${label_pad}${connector} ${diag.message}`)

        // Box bottom: ───╯
        eprintln(color_gray("${repeat_hbar(w + 3)}${chr_rbot()}"))
    }

    // Help text
    if diag.help.length > 0 {
        eprintln(`  ${color_bold("help:")} ${diag.help}`)
    }

    // Cause chain (ticket qar) — render linked cause diagnostics
    match diag.cause {
        .None -> {}
        .Cause(cause_diag) -> {
            eprintln(`  ${color_dim("caused by:")} ${cause_diag.message}`)
        }
    }

    eprintln("")
}

// ── Bag rendering ──

export fn render_bag(source: string, filename: string, bag: DiagnosticBag) {
    eprintln("")
    render_list(source, filename, bag.diagnostics)
    if bag.error_count > 0 || bag.warning_count > 0 {
        mut parts = ""
        if bag.error_count > 0 {
            let label = "${string(bag.error_count)} error${if bag.error_count > 1 { "s" } else { "" }}"
            parts = color_red(label)
        }
        if bag.warning_count > 0 {
            if parts.length > 0 { parts = "${parts} and " }
            let label = "${string(bag.warning_count)} warning${if bag.warning_count > 1 { "s" } else { "" }}"
            parts = "${parts}${color_yellow(label)}"
        }
        eprintln(`${color_bold("Found")} ${parts}${color_bold(".")}`)
        eprintln("")
    }
}

fn diag_list_is_end(list: DiagnosticList) -> bool {
    match list { .End -> true, _ -> false }
}

fn render_list(source: string, filename: string, list: DiagnosticList) {
    // Iterative two-pass rendering — no stack overflow regardless of count.
    // Pass 1: all errors
    mut cur = list
    while !diag_list_is_end(cur) {
        match cur {
            .Node(diag, next) -> {
                if diag.severity is .Error { render_diagnostic(source, filename, diag) }
                cur = next
            }
            _ -> {}
        }
    }
    // Pass 2: warnings (capped at 10)
    mut warn_count = 0
    cur = list
    while !diag_list_is_end(cur) && warn_count < 10 {
        match cur {
            .Node(diag, next) -> {
                if !(diag.severity is .Error) {
                    render_diagnostic(source, filename, diag)
                    warn_count = warn_count + 1
                }
                cur = next
            }
            _ -> {}
        }
    }
}

// ── JSON diagnostic output (ticket d2e) ──
// Outputs one JSON object per line to stderr.

fn json_escape(s: string) -> string {
    // Minimal JSON escaping: backslash and double-quote.
    mut out = ""
    for i in 0..s.length {
        let ch = s[i]
        if ch == "\\" {
            out = out + "\\\\"
        } else if ch == "\"" {
            out = out + "\\\""
        } else if ch == "\n" {
            out = out + "\\n"
        } else {
            out = out + ch
        }
    }
    out
}

export fn render_diagnostic_json(filename: string, diag: Diagnostic) {
    let code_str = diag_code_str(diag.code)
    let sev = severity_str(diag.severity)
    let msg = json_escape(diag.message)
    let hlp = json_escape(diag.help)
    let conf = confidence_str(diag.confidence)
    let line_s = string(diag.span.line)
    let col_s = string(diag.span.col)
    let fname = json_escape(filename)
    eprintln("{\"code\":\"${code_str}\",\"severity\":\"${sev}\",\"message\":\"${msg}\",\"file\":\"${fname}\",\"line\":${line_s},\"col\":${col_s},\"help\":\"${hlp}\",\"confidence\":\"${conf}\"}")
}

export fn render_bag_json(filename: string, bag: DiagnosticBag) {
    mut cur = bag.diagnostics
    while !diag_list_is_end(cur) {
        match cur {
            .Node(diag, next) -> {
                render_diagnostic_json(filename, diag)
                cur = next
            }
            _ -> {}
        }
    }
}
