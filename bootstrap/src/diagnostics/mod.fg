mod render
mod suggest

// WHY: structured diagnostic types for compiler error reporting.
// Every error is a Diagnostic record with error code, severity,
// source span, help text, and labels. DiagnosticBag collects
// diagnostics across an entire compilation pass without stopping.
//
// Ported from forge/packages/forgec-rust/errors/diagnostic.rs.
// The architecture supports multi-label errors, suggestions with
// confidence scores, and machine-readable JSON output — even
// though not all of those are wired up in Phase 0.

// ── Source spans ──

export type Span = {
    start: int,    // byte offset into source
    end: int,      // byte offset end
    line: int,     // 1-based line number
    col: int,      // 1-based column
}

export fn span_new(start: int, end: int, line: int, col: int) -> Span {
    Span { start, end, line, col }
}

export fn span_dummy() -> Span {
    Span { start: 0, end: 0, line: 0, col: 0 }
}

// ── Severity ──

export enum Severity {
    Error
    Warning
    Info
    Hint
}

export fn severity_str(s: Severity) -> string {
    match s {
        .Error -> "error"
        .Warning -> "warning"
        .Info -> "info"
        .Hint -> "hint"
    }
}

// ── Labels ──

export enum LabelKind {
    Primary
    Secondary
}

export type Label = {
    span: Span,
    message: string,
    kind: LabelKind,
}

export enum LabelList {
    End
    Node(label: Label, next: LabelList)
}

// ── Error codes ──
// Each error has an enum variant. All metadata (code string, help
// text) is returned from a single `error_def` match — one place
// to add a new error, one line per variant.

export enum DiagCode {
    // Syntax / Lexer (F00xx)
    SyntaxError
    ExpectedBlock
    MismatchedParen
    MismatchedBracket
    MismatchedBrace
    ExpectedArrow
    UnterminatedString
    UnterminatedTemplate
    ExpectedForVar
    ExpectedIn
    ExpectedExpression
    UnexpectedSemicolon
    // Name resolution (F01xx)
    UndefinedVariable
    ImmutableAssign
    // Type checking (F02xx) — reserved for Phase 1
    TypeMismatch
    WrongArgCount
    // Module system (F03xx)
    ModuleNotFound
    ImportNotFound
    ImportPrivate
    // Internal (F09xx)
    InternalError
    // Runtime errors (F10xx)
    RuntimeNullDeref
    RuntimeDivByZero
    RuntimeIndexOOB
    RuntimeMatchFallthrough
    RuntimeStackOverflow
    RuntimeNullArg
    // Warnings (F08xx)
    NonExhaustiveMatch
}

export type ErrorDef = { code: string, help: string }

// Single source of truth for all error metadata.
// Add a new error = 1 enum variant + 1 match arm here.
export fn error_def(d: DiagCode) -> ErrorDef {
    match d {
        .SyntaxError         -> ErrorDef { code: "F0001", help: "" }
        .ExpectedBlock       -> ErrorDef { code: "F0010", help: "blocks require braces: `if cond { ... }`, `fn name() { ... }`" }
        .MismatchedParen     -> ErrorDef { code: "F0011", help: "check for mismatched parentheses" }
        .MismatchedBracket   -> ErrorDef { code: "F0012", help: "check for mismatched brackets in list or index expression" }
        .MismatchedBrace     -> ErrorDef { code: "F0013", help: "check for mismatched braces — every `{` needs a matching `}`" }
        .ExpectedArrow       -> ErrorDef { code: "F0014", help: "match arms use `->` between pattern and body: `.Variant -> expr`" }
        .UnterminatedString  -> ErrorDef { code: "F0020", help: "add a closing `\"` to end the string literal" }
        .UnterminatedTemplate -> ErrorDef { code: "F0021", help: "add a closing backtick to end the template string" }
        .ExpectedForVar      -> ErrorDef { code: "F0030", help: "for loops need a variable: `for x in collection { ... }`" }
        .ExpectedIn          -> ErrorDef { code: "F0031", help: "for loops use `in`: `for x in list { ... }` or `for i in 0..10 { ... }`" }
        .ExpectedExpression  -> ErrorDef { code: "F0040", help: "expected a value, variable, or expression here" }
        .UnexpectedSemicolon -> ErrorDef { code: "F0041", help: "Forge doesn't use semicolons — remove the `;`" }
        .UndefinedVariable   -> ErrorDef { code: "F0100", help: "" }
        .ImmutableAssign     -> ErrorDef { code: "F0101", help: "declare with `mut` instead of `let` to allow reassignment" }
        .TypeMismatch        -> ErrorDef { code: "F0200", help: "" }
        .WrongArgCount       -> ErrorDef { code: "F0201", help: "" }
        .ModuleNotFound      -> ErrorDef { code: "F0300", help: "create the module file or remove the `mod` declaration" }
        .ImportNotFound      -> ErrorDef { code: "F0301", help: "check the spelling or add `export` to the function in the target module" }
        .ImportPrivate       -> ErrorDef { code: "F0302", help: "add `export` before the declaration to make it importable" }
        .InternalError       -> ErrorDef { code: "F0999", help: "" }
        .RuntimeNullDeref    -> ErrorDef { code: "F1000", help: "" }
        .RuntimeDivByZero    -> ErrorDef { code: "F1001", help: "" }
        .RuntimeIndexOOB     -> ErrorDef { code: "F1002", help: "" }
        .RuntimeMatchFallthrough -> ErrorDef { code: "F1003", help: "" }
        .RuntimeStackOverflow -> ErrorDef { code: "F1004", help: "" }
        .RuntimeNullArg      -> ErrorDef { code: "F1005", help: "" }
        .NonExhaustiveMatch  -> ErrorDef { code: "F0801", help: "add a wildcard `_ -> ...` arm, or handle all variants explicitly" }
    }
}

export fn diag_code_str(code: DiagCode) -> string {
    error_def(code).code
}

export fn diag_code_help(code: DiagCode) -> string {
    error_def(code).help
}

// ── Diagnostic ──

export type Diagnostic = {
    code: DiagCode,
    severity: Severity,
    message: string,
    span: Span,
    help: string,       // empty string = use default from code
}

// Create an error diagnostic. Help text auto-filled from the code.
export fn diag_error(code: DiagCode, message: string, span: Span) -> Diagnostic {
    Diagnostic { code, severity: Severity.Error, message, span, help: diag_code_help(code) }
}

export fn diag_warning(code: DiagCode, message: string, span: Span) -> Diagnostic {
    Diagnostic { code, severity: Severity.Warning, message, span, help: diag_code_help(code) }
}

export fn diag_with_help(d: Diagnostic, help: string) -> Diagnostic {
    d with { help }
}

// ── DiagnosticBag ──

export enum DiagnosticList {
    End
    Node(diag: Diagnostic, next: DiagnosticList)
}

export type DiagnosticBag = {
    diagnostics: DiagnosticList,
    error_count: int,
    warning_count: int,
}

export fn bag_new() -> DiagnosticBag {
    DiagnosticBag { diagnostics: DiagnosticList.End, error_count: 0, warning_count: 0 }
}

export fn bag_report(bag: DiagnosticBag, diag: Diagnostic) -> DiagnosticBag {
    let new_errors = match diag.severity {
        .Error -> bag.error_count + 1
        _ -> bag.error_count
    }
    let new_warnings = match diag.severity {
        .Warning -> bag.warning_count + 1
        _ -> bag.warning_count
    }
    DiagnosticBag {
        diagnostics: DiagnosticList.Node(diag, bag.diagnostics),
        error_count: new_errors,
        warning_count: new_warnings,
    }
}

export fn bag_has_errors(bag: DiagnosticBag) -> bool {
    bag.error_count > 0
}

export fn bag_has_warnings(bag: DiagnosticBag) -> bool {
    bag.warning_count > 0
}

export fn bag_merge(a: DiagnosticBag, b: DiagnosticBag) -> DiagnosticBag {
    // Prepend all of b's diagnostics onto a
    merge_lists(a, b.diagnostics, b.error_count, b.warning_count)
}

fn merge_lists(bag: DiagnosticBag, list: DiagnosticList, extra_errors: int, extra_warnings: int) -> DiagnosticBag {
    match list {
        .End -> bag with { error_count: bag.error_count + extra_errors, warning_count: bag.warning_count + extra_warnings }
        .Node(diag, next) -> {
            let updated = bag with { diagnostics: DiagnosticList.Node(diag, bag.diagnostics) }
            merge_lists(updated, next, extra_errors, extra_warnings)
        }
    }
}
