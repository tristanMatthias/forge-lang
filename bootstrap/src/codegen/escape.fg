// WHY: escape analysis for RC — determines which locals' values
// escape their defining scope. A local is "releasable" if its ONLY
// uses are field reads (p.x, p.y). Any other use (return, pass as
// argument, store into struct, etc.) means the value might be
// referenced elsewhere and must NOT be released at scope exit.
//
// Conservative: if in doubt, mark as escaped (don't release).

use core.ast.{Expr, ExprList, FieldInitList, Stmt, StmtList, SExpr, SStmt, stmt_unwrap}
use codegen.types.{ReleasableSet, releasable_has}

fn releasable_add(set: ReleasableSet, name: string) -> ReleasableSet {
    if releasable_has(set, name) { set } else { ReleasableSet.Node(name, set) }
}

fn releasable_remove(set: ReleasableSet, name: string) -> ReleasableSet {
    match set {
        .End -> .End
        .Node(n, next) if n == name -> releasable_remove(next, name)
        .Node(n, next) -> ReleasableSet.Node(n, releasable_remove(next, name))
    }
}

// Analyze a function body. A local is releasable only if:
// 1. Its initializer is an allocation (struct lit, enum ctor, tuple, with-expr)
// 2. Its only uses are field reads (not returned, passed as arg, etc.)
export fn analyze_releasable(body: StmtList) -> ReleasableSet {
    let owned = collect_owned_bindings(body, ReleasableSet.End)
    remove_escaped(body, owned)
}

// Analyze a single expression body (for lambdas).
export fn analyze_releasable_expr(body: Expr) -> ReleasableSet {
    match body {
        .Block(stmts) -> analyze_releasable(stmts)
        _ -> ReleasableSet.End
    }
}

// Only collect bindings whose initializer creates a new RC object.
fn collect_owned_bindings(stmts: StmtList, set: ReleasableSet) -> ReleasableSet {
    match stmts {
        .End -> set
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .Let(name, _, init) -> if is_allocating_expr(init) { releasable_add(set, name) } else { set }
                .Mut(name, _, init) -> if is_allocating_expr(init) { releasable_add(set, name) } else { set }
                .Const(name, _, init) -> if is_allocating_expr(init) { releasable_add(set, name) } else { set }
                .Block(body) -> collect_owned_bindings(body, set)
                .If(_, then_b, else_b) -> {
                    let s1 = collect_owned_stmt(then_b, set)
                    if else_b != null { collect_owned_stmt(else_b!, s1) } else { s1 }
                }
                _ -> set
            }
            collect_owned_bindings(next, updated)
        }
    }
}

fn collect_owned_stmt(stmt: Stmt, set: ReleasableSet) -> ReleasableSet {
    match stmt_unwrap(stmt) {
        .Block(body) -> collect_owned_bindings(body, set)
        .Let(name, _, init) -> if is_allocating_expr(init) { releasable_add(set, name) } else { set }
        .Mut(name, _, init) -> if is_allocating_expr(init) { releasable_add(set, name) } else { set }
        _ -> set
    }
}

// An allocating expression creates a new heap object that the local owns.
fn is_allocating_expr(expr: Expr) -> bool {
    match expr {
        .StructLit(_, _) -> true
        .EnumCtor(_, _, _) -> true
        .Tuple(_) -> true
        .With(_, _) -> true
        _ -> false
    }
}

// Phase 2: walk all expressions. If a name is used in any context OTHER
// than `.FieldAccess(Ident(name), _)`, remove it from releasable set.
fn remove_escaped(stmts: StmtList, set: ReleasableSet) -> ReleasableSet {
    match stmts {
        .End -> set
        .Node(ss, next) -> {
            let updated = remove_escaped_stmt(ss.node, set)
            remove_escaped(next, updated)
        }
    }
}

fn remove_escaped_stmt(stmt: Stmt, set: ReleasableSet) -> ReleasableSet {
    let inner = stmt_unwrap(stmt)
    match inner {
        .Return(expr) -> remove_escaped_expr(expr, set)
        .Expr(expr) -> remove_escaped_expr(expr, set)
        .Let(_, _, init) -> remove_escaped_expr(init, set)
        .Mut(_, _, init) -> remove_escaped_expr(init, set)
        .Const(_, _, init) -> remove_escaped_expr(init, set)
        .Block(body) -> remove_escaped(body, set)
        .If(cond, then_b, else_b) -> {
            let s1 = remove_escaped_expr(cond, set)
            let s2 = remove_escaped_stmt(then_b, s1)
            if else_b != null { remove_escaped_stmt(else_b!, s2) } else { s2 }
        }
        .While(cond, body) -> remove_escaped_stmt(body, remove_escaped_expr(cond, set))
        .For(_, start, end, body) -> {
            let s1 = remove_escaped_expr(start, set)
            let s2 = remove_escaped_expr(end, s1)
            remove_escaped_stmt(body, s2)
        }
        .ForIn(_, coll, body) -> remove_escaped_stmt(body, remove_escaped_expr(coll, set))
        .Match(subj, _) -> remove_escaped_expr(subj, set)
        .Defer(body) -> remove_escaped_expr(body, set)
        .Errdefer(body) -> remove_escaped_expr(body, set)
        .Annotated(_, inner) -> remove_escaped_stmt(inner, set)
        .LetDestructure(_, init) -> remove_escaped_expr(init, set)
        // Declarations and control that don't contain escapable ident refs at this level
        .Function(_, _, _, _, _) -> set
        .ReturnEmpty -> set
        .TypeDecl(_, _, _) -> set
        .NewtypeDecl(_, _) -> set
        .UnionAliasDecl(_, _) -> set
        .ShapeDecl(_, _) -> set
        .EnumDecl(_, _, _) -> set
        .ExternFn(_, _, _) -> set
        .TraitDecl(_, _) -> set
        .Impl(_, _) -> set
        .NoOp -> set
        .Break -> set
        .Continue -> set
        .SpecBlock(_, _) -> set
        .GivenBlock(_, _) -> set
        .ThenBlock(_, _) -> set
        .Select(_) -> set
        .Parallel(_) -> set
        .Module(_, _) -> set
        .Use(_, _) -> set
    }
}

fn remove_escaped_expr(expr: Expr, set: ReleasableSet) -> ReleasableSet {
    match expr {
        // Field access is safe — reading a field doesn't escape the struct
        .FieldAccess(obj, _) -> match obj {
            .Ident(_) -> set  // p.x is safe — don't remove p
            _ -> remove_escaped_expr(obj, set)  // nested: (expr).field
        }
        // These are escaping uses:
        .Ident(name) -> releasable_remove(set, name)
        // Recurse into sub-expressions
        .Call(callee, args) -> {
            let s1 = remove_escaped_expr(callee, set)
            remove_escaped_args(args, s1)
        }
        .GenericCall(callee, _, args) -> {
            let s1 = remove_escaped_expr(callee, set)
            remove_escaped_args(args, s1)
        }
        .Binary(left, _, right) -> remove_escaped_expr(right, remove_escaped_expr(left, set))
        .Unary(_, inner) -> remove_escaped_expr(inner, set)
        .Logical(left, _, right) -> remove_escaped_expr(right, remove_escaped_expr(left, set))
        .Grouping(inner) -> remove_escaped_expr(inner, set)
        .Index(obj, idx) -> remove_escaped_expr(idx, remove_escaped_expr(obj, set))
        .Assign(_, val) -> remove_escaped_expr(val, set)
        .FieldAssign(obj, _, val) -> remove_escaped_expr(val, remove_escaped_expr(obj, set))
        .StructLit(_, inits) -> remove_escaped_field_inits(inits, set)
        .ListLit(elems) -> remove_escaped_args(elems, set)
        .With(obj, inits) -> remove_escaped_field_inits(inits, remove_escaped_expr(obj, set))
        .Lambda(_, body) -> remove_escaped_expr(body, set)
        .Block(body) -> remove_escaped(body, set)
        .IfExpr(cond, t, e) -> remove_escaped_expr(e, remove_escaped_expr(t, remove_escaped_expr(cond, set)))
        .MatchExpr(subj, _) -> remove_escaped_expr(subj, set)
        .Tuple(elems) -> remove_escaped_args(elems, set)
        .TupleIndex(obj, _) -> remove_escaped_expr(obj, set)
        .MapLit(entries) -> remove_escaped_args(entries, set)
        .Slice(obj, start, end) -> remove_escaped_expr(end, remove_escaped_expr(start, remove_escaped_expr(obj, set)))
        .Try(inner) -> remove_escaped_expr(inner, set)
        .Catch(inner, _, body, _, _) -> remove_escaped_expr(body, remove_escaped_expr(inner, set))
        .NullCoalesce(left, right) -> remove_escaped_expr(right, remove_escaped_expr(left, set))
        .OptionalChain(obj, _) -> remove_escaped_expr(obj, set)
        .IsCheck(subj, _) -> remove_escaped_expr(subj, set)
        .InCheck(needle, items) -> remove_escaped_args(items, remove_escaped_expr(needle, set))
        .EnumCtor(_, _, args) -> remove_escaped_args(args, set)
        .When(_) -> set  // when arms don't contain ident escapes at this level
        .ListComp(body, _, coll, filter) -> {
            let s1 = remove_escaped_expr(body, set)
            let s2 = remove_escaped_expr(coll, s1)
            if filter != null { remove_escaped_expr(filter!, s2) } else { s2 }
        }
        // Leaf expressions — no idents to escape
        .Number(_) -> set
        .FloatLit(_) -> set
        .String(_) -> set
        .Bool(_) -> set
        .Null -> set
        .QualifiedIdent(_) -> set
    }
}

fn remove_escaped_args(args: ExprList, set: ReleasableSet) -> ReleasableSet {
    match args {
        .End -> set
        .Node(se, next) -> remove_escaped_args(next, remove_escaped_expr(se.node, set))
    }
}

fn remove_escaped_field_inits(inits: FieldInitList, set: ReleasableSet) -> ReleasableSet {
    match inits {
        .End -> set
        .Node(_, val_se, next) -> remove_escaped_field_inits(next, remove_escaped_expr(val_se.node, set))
    }
}
