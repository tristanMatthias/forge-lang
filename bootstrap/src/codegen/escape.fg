// WHY: escape analysis for RC — determines which locals' values
// escape their defining scope. A local is "releasable" if its ONLY
// uses are field reads (p.x, p.y). Any other use (return, pass as
// argument, store into struct, etc.) means the value might be
// referenced elsewhere and must NOT be released at scope exit.
//
// Conservative: if in doubt, mark as escaped (don't release).

use core.ast.{Expr, ExprList, FieldList, FieldInitList, VariantList, ValueType, Stmt, StmtList, SExpr, SStmt, stmt_unwrap}
use codegen.types.{ReleasableSet, releasable_has, StructReg, EnumReg, struct_reg_lookup, enum_reg_lookup, CopySet, copy_set_has}

fn releasable_add(set: ReleasableSet, name: string) -> ReleasableSet {
    if releasable_has(set, name) { set } else { ReleasableSet.Node(name, set) }
}

fn releasable_remove(set: ReleasableSet, name: string) -> ReleasableSet {
    match set {
        .End -> .End
        .Node(n, next) if n == name -> releasable_remove(next, name)
        .Node(n, next) -> ReleasableSet.Node(n, releasable_remove(next, name))
    }
}

// Analyze a function body in a single pass. A local is releasable only if:
// 1. Its initializer is an allocation (struct lit, enum ctor, tuple, with-expr)
// 2. Its only uses are field reads (not returned, passed as arg, etc.)
//
// Single-pass insight: declarations appear before uses in statement order.
// When we see `let a = Point{...}`, add a. When we later see `f(a)`, remove a.
// Uses can only REMOVE from the set, so forward references work naturally.
export fn analyze_releasable(body: StmtList) -> ReleasableSet {
    single_pass_escape(body, ReleasableSet.End)
}

// Analyze a single expression body (for lambdas).
export fn analyze_releasable_expr(body: Expr) -> ReleasableSet {
    match body {
        .Block(stmts) -> analyze_releasable(stmts)
        _ -> ReleasableSet.End
    }
}

// Single-pass escape analysis: walks statements once, adding allocating
// bindings and removing escaped ones as it encounters them in order.
fn single_pass_escape(stmts: StmtList, set: ReleasableSet) -> ReleasableSet {
    match stmts {
        .End -> set
        .Node(ss, next) -> {
            let updated = single_pass_stmt(ss.node, set)
            single_pass_escape(next, updated)
        }
    }
}

fn analyze_binding(name: string, init: Expr, set: ReleasableSet) -> ReleasableSet {
    let s1 = if is_allocating_expr(init) { releasable_add(set, name) } else { set }
    remove_escaped_expr(init, s1)
}

fn single_pass_stmt(stmt: Stmt, set: ReleasableSet) -> ReleasableSet {
    let inner = stmt_unwrap(stmt)
    match inner {
        .Let(name, _, init) -> analyze_binding(name, init, set)
        .Mut(name, _, init) -> analyze_binding(name, init, set)
        .Const(name, _, init) -> analyze_binding(name, init, set)
        // Recurse into blocks
        .Block(body) -> single_pass_escape(body, set)
        .If(cond, then_b, else_b) -> {
            let s1 = remove_escaped_expr(cond, set)
            let s2 = single_pass_stmt(then_b, s1)
            if else_b != null { single_pass_stmt(else_b!, s2) } else { s2 }
        }
        // Everything else: just check for escapes (same as remove_escaped_stmt)
        .Return(expr) -> remove_escaped_expr(expr, set)
        .Expr(expr) -> remove_escaped_expr(expr, set)
        .While(cond, body) -> single_pass_stmt(body, remove_escaped_expr(cond, set))
        .For(_, start, end, body) -> {
            let s1 = remove_escaped_expr(start, set)
            let s2 = remove_escaped_expr(end, s1)
            single_pass_stmt(body, s2)
        }
        .ForIn(_, coll, body) -> single_pass_stmt(body, remove_escaped_expr(coll, set))
        .Match(subj, _) -> remove_escaped_expr(subj, set)
        .Defer(body) -> remove_escaped_expr(body, set)
        .Errdefer(body) -> remove_escaped_expr(body, set)
        .Annotated(_, inner) -> single_pass_stmt(inner, set)
        .LetDestructure(_, init) -> remove_escaped_expr(init, set)
        .Function(_, _, _, _, _) -> set
        .ReturnEmpty -> set
        .TypeDecl(_, _, _) -> set
        .NewtypeDecl(_, _, _) -> set
        .UnionAliasDecl(_, _, _) -> set
        .ShapeDecl(_, _) -> set
        .EnumDecl(_, _, _) -> set
        .ExternFn(_, _, _) -> set
        .TraitDecl(_, _) -> set
        .Impl(_, _) -> set
        .NoOp -> set
        .Break -> set
        .Continue -> set
        .SpecBlock(_, _) -> set
        .GivenBlock(_, _) -> set
        .ThenBlock(_, _) -> set
        .Select(_) -> set
        .Parallel(_) -> set
        .Module(_, _) -> set
        .Use(_, _) -> set
        .AssocType(_, _, _) -> set
    }
}


// An allocating expression creates a new heap object that the local owns.
// Only these 4 forms allocate via arena_alloc/rc_alloc. If a new allocating
// expression type is added (e.g. MapLit, ListComp), add it here.
fn is_allocating_expr(expr: Expr) -> bool {
    match expr {
        .StructLit(_, _) -> true
        .EnumCtor(_, _, _) -> true
        .Tuple(_) -> true
        .With(_, _) -> true
        _ -> false
    }
}

// Walk expressions checking for escaping uses. If a name is used in any
// context OTHER than `.FieldAccess(Ident(name), _)`, remove from releasable set.
fn remove_escaped_expr(expr: Expr, set: ReleasableSet) -> ReleasableSet {
    match expr {
        // Field access is safe — reading a field doesn't escape the struct
        .FieldAccess(obj, _) -> match obj {
            .Ident(_) -> set  // p.x is safe — don't remove p
            _ -> remove_escaped_expr(obj, set)  // nested: (expr).field
        }
        // These are escaping uses:
        .Ident(name) -> releasable_remove(set, name)
        // Recurse into sub-expressions
        .Call(callee, args) -> {
            let s1 = remove_escaped_expr(callee, set)
            remove_escaped_args(args, s1)
        }
        .GenericCall(callee, _, args) -> {
            let s1 = remove_escaped_expr(callee, set)
            remove_escaped_args(args, s1)
        }
        .Binary(left, _, right) -> remove_escaped_expr(right, remove_escaped_expr(left, set))
        .Unary(_, inner) -> remove_escaped_expr(inner, set)
        .Logical(left, _, right) -> remove_escaped_expr(right, remove_escaped_expr(left, set))
        .Grouping(inner) -> remove_escaped_expr(inner, set)
        .Index(obj, idx) -> remove_escaped_expr(idx, remove_escaped_expr(obj, set))
        .Assign(_, val) -> remove_escaped_expr(val, set)
        .FieldAssign(obj, _, val) -> remove_escaped_expr(val, remove_escaped_expr(obj, set))
        .StructLit(_, inits) -> remove_escaped_field_inits(inits, set)
        .ListLit(elems) -> remove_escaped_args(elems, set)
        .With(obj, inits) -> remove_escaped_field_inits(inits, remove_escaped_expr(obj, set))
        .Lambda(_, body) -> remove_escaped_expr(body, set)
        .Block(body) -> single_pass_escape(body, set)
        .IfExpr(cond, t, e) -> remove_escaped_expr(e, remove_escaped_expr(t, remove_escaped_expr(cond, set)))
        .MatchExpr(subj, _) -> remove_escaped_expr(subj, set)
        .Tuple(elems) -> remove_escaped_args(elems, set)
        .TupleIndex(obj, _) -> remove_escaped_expr(obj, set)
        .MapLit(entries) -> remove_escaped_args(entries, set)
        .Slice(obj, start, end) -> remove_escaped_expr(end, remove_escaped_expr(start, remove_escaped_expr(obj, set)))
        .Try(inner) -> remove_escaped_expr(inner, set)
        .Catch(inner, _, body, _, _) -> remove_escaped_expr(body, remove_escaped_expr(inner, set))
        .NullCoalesce(left, right) -> remove_escaped_expr(right, remove_escaped_expr(left, set))
        .OptionalChain(obj, _) -> remove_escaped_expr(obj, set)
        .IsCheck(subj, _) -> remove_escaped_expr(subj, set)
        .InCheck(needle, items) -> remove_escaped_args(items, remove_escaped_expr(needle, set))
        .EnumCtor(_, _, args) -> remove_escaped_args(args, set)
        .Spawn(body) -> remove_escaped_expr(body, set)
        .When(_) -> set  // when arms don't contain ident escapes at this level
        .ListComp(body, _, coll, filter) -> {
            let s1 = remove_escaped_expr(body, set)
            let s2 = remove_escaped_expr(coll, s1)
            if filter != null { remove_escaped_expr(filter!, s2) } else { s2 }
        }
        // Leaf expressions — no idents to escape
        .Number(_) -> set
        .FloatLit(_) -> set
        .String(_) -> set
        .Bool(_) -> set
        .Null -> set
        .QualifiedIdent(_) -> set
    }
}

fn remove_escaped_args(args: ExprList, set: ReleasableSet) -> ReleasableSet {
    match args {
        .End -> set
        .Node(se, next) -> remove_escaped_args(next, remove_escaped_expr(se.node, set))
    }
}

fn remove_escaped_field_inits(inits: FieldInitList, set: ReleasableSet) -> ReleasableSet {
    match inits {
        .End -> set
        .Node(_, val_se, next) -> remove_escaped_field_inits(next, remove_escaped_expr(val_se.node, set))
    }
}

// ── Arena eligibility (spec Axis 9.6) ─────────────────────────────
//
// A for-loop body is arena-eligible if it contains at least one
// allocating binding (struct lit, enum ctor, etc.) AND all such
// bindings are non-escaping (releasable). This means every allocation
// in the loop iteration can safely live in a bump arena that is
// freed in bulk at scope exit.

fn releasable_any(set: ReleasableSet) -> bool {
    match set {
        .End -> false
        .Node(_, _) -> true
    }
}

fn count_allocating_in_stmts(stmts: StmtList) -> int {
    match stmts {
        .End -> 0
        .Node(ss, next) -> count_allocating_in_stmt_single(ss.node) + count_allocating_in_stmts(next)
    }
}

fn count_allocating_in_stmt_single(stmt: Stmt) -> int {
    match stmt_unwrap(stmt) {
        .Block(inner) -> count_allocating_in_stmts(inner)
        .Let(_, _, init) -> if is_allocating_expr(init) { 1 } else { 0 }
        .Mut(_, _, init) -> if is_allocating_expr(init) { 1 } else { 0 }
        .Const(_, _, init) -> if is_allocating_expr(init) { 1 } else { 0 }
        .If(_, then_b, _) -> count_allocating_in_stmt_single(then_b)
        .While(_, wb) -> count_allocating_in_stmt_single(wb)
        .For(_, _, _, fb) -> count_allocating_in_stmt_single(fb)
        .ForIn(_, _, fib) -> count_allocating_in_stmt_single(fib)
        .Expr(_) -> 0
        .Return(_) -> 0
        .ReturnEmpty -> 0
        .Function(_, _, _, _, _) -> 0
        .TypeDecl(_, _, _) -> 0
        .NewtypeDecl(_, _, _) -> 0
        .UnionAliasDecl(_, _, _) -> 0
        .ShapeDecl(_, _) -> 0
        .EnumDecl(_, _, _) -> 0
        .Match(_, _) -> 0
        .Impl(_, _) -> 0
        .NoOp -> 0
        .ExternFn(_, _, _) -> 0
        .Break -> 0
        .Continue -> 0
        .TraitDecl(_, _) -> 0
        .LetDestructure(_, _) -> 0
        .Defer(_) -> 0
        .Errdefer(_) -> 0
        .Annotated(_, _) -> 0
        .SpecBlock(_, _) -> 0
        .GivenBlock(_, _) -> 0
        .ThenBlock(_, _) -> 0
        .Select(_) -> 0
        .Parallel(_) -> 0
        .Module(_, _) -> 0
        .Use(_, _) -> 0
        .AssocType(_, _, _) -> 0
    }
}

// Check if a for-loop body is arena-eligible:
// - Has allocating bindings
// - All allocating bindings are non-escaping (releasable)
export fn is_arena_eligible(body: Stmt) -> bool {
    let inner = stmt_unwrap(body)
    match inner {
        .Block(stmts) -> {
            // Must have at least one allocation
            let owned_count = count_allocating_in_stmts(stmts)
            if owned_count == 0 { return false }
            // All allocations must be releasable (non-escaping)
            let releasable = single_pass_escape(stmts, ReleasableSet.End)
            releasable_any(releasable)
        }
        .Let(_, _, init) -> is_allocating_expr(init)
        .Mut(_, _, init) -> is_allocating_expr(init)
        .Const(_, _, init) -> is_allocating_expr(init)
        .Expr(_) -> false
        .Return(_) -> false
        .ReturnEmpty -> false
        .Function(_, _, _, _, _) -> false
        .TypeDecl(_, _, _) -> false
        .NewtypeDecl(_, _, _) -> false
        .UnionAliasDecl(_, _, _) -> false
        .ShapeDecl(_, _) -> false
        .EnumDecl(_, _, _) -> false
        .Match(_, _) -> false
        .Impl(_, _) -> false
        .NoOp -> false
        .ExternFn(_, _, _) -> false
        .Break -> false
        .Continue -> false
        .TraitDecl(_, _) -> false
        .LetDestructure(_, _) -> false
        .Defer(_) -> false
        .Errdefer(_) -> false
        .Annotated(_, _) -> false
        .SpecBlock(_, _) -> false
        .GivenBlock(_, _) -> false
        .ThenBlock(_, _) -> false
        .Select(_) -> false
        .Parallel(_) -> false
        .Module(_, _) -> false
        .Use(_, _) -> false
        .AssocType(_, _, _) -> false
        .If(_, _, _) -> false
        .While(_, _) -> false
        .For(_, _, _, _) -> false
        .ForIn(_, _, _) -> false
    }
}

// ── Copy trait auto-derivation (spec 9.12) ────────────────────────
//
// A type is Copy if it contains only primitive (non-heap) fields.
// Primitives: int, float, bool. Structs/enums are Copy if ALL their
// fields recursively resolve to Copy types. Str, List, Map, Ptr,
// Closure, Fn, Trait are NOT Copy (heap-managed).
//
// The analysis uses a fixed-point iteration: start with all
// struct/enum names as Copy candidates, then repeatedly remove any
// whose fields reference non-Copy types until stable.

export fn analyze_copy_types(structs: StructReg, enums: EnumReg) -> CopySet {
    // Seed: all struct and enum names are candidates
    let candidates = seed_struct_candidates(structs, seed_enum_candidates(enums, CopySet.End))
    // Fixed-point: keep removing non-Copy types until stable
    fixpoint_copy(candidates, structs, enums)
}

fn seed_struct_candidates(reg: StructReg, set: CopySet) -> CopySet {
    match reg {
        .End -> set
        .Node(name, _, next) -> seed_struct_candidates(next, CopySet.Node(name, set))
    }
}

fn seed_enum_candidates(reg: EnumReg, set: CopySet) -> CopySet {
    match reg {
        .End -> set
        .Node(name, _, next) -> seed_enum_candidates(next, CopySet.Node(name, set))
    }
}

fn fixpoint_copy(candidates: CopySet, structs: StructReg, enums: EnumReg) -> CopySet {
    let refined = refine_copy(candidates, structs, enums)
    if copy_set_eq(refined, candidates) { refined }
    else { fixpoint_copy(refined, structs, enums) }
}

fn refine_copy(candidates: CopySet, structs: StructReg, enums: EnumReg) -> CopySet {
    match candidates {
        .End -> .End
        .Node(name, next) -> {
            let rest = refine_copy(next, structs, enums)
            if is_name_copy(name, candidates, structs, enums) {
                CopySet.Node(name, rest)
            } else {
                rest
            }
        }
    }
}

fn is_name_copy(name: string, candidates: CopySet, structs: StructReg, enums: EnumReg) -> bool {
    // Check struct registry
    let sl = struct_reg_lookup(structs, name)
    if sl.found { return fields_all_copy(sl.fields, candidates) }
    // Check enum registry
    let el = enum_reg_lookup(enums, name)
    if el.found { return variants_all_copy(el.variants, candidates) }
    false
}

fn fields_all_copy(fields: FieldList, candidates: CopySet) -> bool {
    match fields {
        .End -> true
        .Node(_, vt, next) -> {
            if !vtype_is_copy(vt, candidates) { false }
            else { fields_all_copy(next, candidates) }
        }
    }
}

fn variants_all_copy(variants: VariantList, candidates: CopySet) -> bool {
    match variants {
        .End -> true
        .Node(_, fields, next) -> {
            if !fields_all_copy(fields, candidates) { false }
            else { variants_all_copy(next, candidates) }
        }
    }
}

fn vtype_is_copy(vt: ValueType, candidates: CopySet) -> bool {
    match vt {
        .Int -> true
        .Float -> true
        .Bool -> true
        .Str -> false
        .Ptr -> false
        .List(_) -> false
        .Map -> false
        .Fn(_) -> false
        .FnTyped(_, _) -> false
        .Closure(_, _) -> false
        .Struct(name) -> copy_set_has(candidates, name)
        .Enum(name, _) -> copy_set_has(candidates, name)
        .Newtype(name, _) -> copy_set_has(candidates, name)
        .Trait(_) -> false
        .Union(_) -> false
        .Tuple(_) -> false
        _ -> false
    }
}

fn copy_set_eq(a: CopySet, b: CopySet) -> bool {
    copy_set_len(a) == copy_set_len(b) && copy_set_subset(a, b)
}

fn copy_set_len(set: CopySet) -> int {
    match set {
        .End -> 0
        .Node(_, next) -> 1 + copy_set_len(next)
    }
}

fn copy_set_subset(a: CopySet, b: CopySet) -> bool {
    match a {
        .End -> true
        .Node(name, next) -> {
            if !copy_set_has(b, name) { false }
            else { copy_set_subset(next, b) }
        }
    }
}
