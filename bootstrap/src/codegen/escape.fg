// WHY: escape analysis for RC — determines which locals' values
// escape their defining scope (stored in struct fields, passed to
// functions, added to collections, captured by closures, or returned).
// Non-escaped, non-moved locals can be released at scope exit.

use core.ast.{Expr, ExprList, FieldInitList, Stmt, StmtList, SExpr, SStmt, stmt_unwrap}

// A set of variable names that escape their scope.
export enum EscapeSet {
    End
    Node(name: string, next: EscapeSet)
}

export fn escape_has(set: EscapeSet, name: string) -> bool {
    match set {
        .End -> false
        .Node(n, _) if n == name -> true
        .Node(_, next) -> escape_has(next, name)
    }
}

fn escape_add(set: EscapeSet, name: string) -> EscapeSet {
    if escape_has(set, name) { set } else { EscapeSet.Node(name, set) }
}

// Analyze a function body for escaping locals.
export fn analyze_escapes(body: StmtList) -> EscapeSet {
    analyze_stmts(body, EscapeSet.End)
}

fn analyze_stmts(stmts: StmtList, set: EscapeSet) -> EscapeSet {
    match stmts {
        .End -> set
        .Node(ss, next) -> {
            // Last statement: if it's an expression, it's the implicit return
            let updated = match next {
                .End -> analyze_last_stmt(ss.node, set)
                _ -> analyze_stmt(ss.node, set)
            }
            analyze_stmts(next, updated)
        }
    }
}

// The last statement in a function body is the implicit return value.
// Any idents in the last expression escape.
fn analyze_last_stmt(stmt: Stmt, set: EscapeSet) -> EscapeSet {
    let inner = stmt_unwrap(stmt)
    match inner {
        .Expr(expr) -> collect_escaping_idents(expr, analyze_expr_escapes(expr, set))
        .Return(expr) -> collect_escaping_idents(expr, set)
        _ -> analyze_stmt(inner, set)
    }
}

fn analyze_stmt(stmt: Stmt, set: EscapeSet) -> EscapeSet {
    let inner = stmt_unwrap(stmt)
    match inner {
        // Return: the returned expression escapes
        .Return(expr) -> collect_escaping_idents(expr, set)
        // Expression statement: check for calls with escaping args
        .Expr(expr) -> analyze_expr_escapes(expr, set)
        // Block: recurse
        .Block(body) -> analyze_stmts(body, set)
        // If: condition doesn't escape, but branches might contain returns/calls
        .If(_, then_b, else_b) -> {
            let s1 = analyze_stmt(then_b, set)
            if else_b != null { analyze_stmt(else_b!, s1) } else { s1 }
        }
        // While/For: body might contain escaping statements
        .While(_, body) -> analyze_stmt(body, set)
        .For(_, _, _, body) -> analyze_stmt(body, set)
        .ForIn(_, _, body) -> analyze_stmt(body, set)
        // Let/Mut/Const with struct literal or call initializer: the initializer
        // may contain idents that escape into the struct
        .Let(_, _, init) -> analyze_expr_escapes(init, set)
        .Mut(_, _, init) -> analyze_expr_escapes(init, set)
        .Const(_, _, init) -> analyze_expr_escapes(init, set)
        .Match(_, _) -> set  // TODO: analyze match arms
        _ -> set
    }
}

// Collect all Ident names from an expression — these are values that escape.
// Used for return expressions and struct field inits.
fn collect_escaping_idents(expr: Expr, set: EscapeSet) -> EscapeSet {
    match expr {
        .Ident(name) -> escape_add(set, name)
        .Grouping(inner) -> collect_escaping_idents(inner, set)
        _ -> set
    }
}

// Analyze an expression for sub-expressions that cause escapes.
fn analyze_expr_escapes(expr: Expr, set: EscapeSet) -> EscapeSet {
    match expr {
        // Function call: all arguments escape (callee may store them)
        .Call(_, args) -> collect_escaping_args(args, set)
        .GenericCall(_, _, args) -> collect_escaping_args(args, set)
        // Struct literal: field values escape into the struct
        .StructLit(_, inits) -> collect_escaping_field_inits(inits, set)
        // List literal: elements escape
        .ListLit(elems) -> collect_escaping_args(elems, set)
        // Lambda/closure: captured variables escape
        .Lambda(_, body) -> collect_escaping_idents(body, set)
        // With expression: field values escape
        .With(obj, inits) -> {
            let s1 = collect_escaping_idents(obj, set)
            collect_escaping_field_inits(inits, s1)
        }
        // Binary/unary: recurse but these don't cause escapes themselves
        .Binary(left, _, right) -> {
            let s1 = analyze_expr_escapes(left, set)
            analyze_expr_escapes(right, s1)
        }
        .Unary(_, inner) -> analyze_expr_escapes(inner, set)
        // Block expression
        .Block(body) -> analyze_stmts(body, set)
        // Assign: RHS escapes into the variable
        .Assign(_, value) -> collect_escaping_idents(value, set)
        .FieldAssign(_, _, value) -> collect_escaping_idents(value, set)
        _ -> set
    }
}

fn collect_escaping_args(args: ExprList, set: EscapeSet) -> EscapeSet {
    match args {
        .End -> set
        .Node(se, next) -> {
            let updated = collect_escaping_idents(se.node, set)
            collect_escaping_args(next, updated)
        }
    }
}

fn collect_escaping_field_inits(inits: FieldInitList, set: EscapeSet) -> EscapeSet {
    match inits {
        .End -> set
        .Node(_, value_se, next) -> {
            let updated = collect_escaping_idents(value_se.node, set)
            collect_escaping_field_inits(next, updated)
        }
    }
}
