// WHY: codegen for println/eprintln builtins.

use core.ast.{Expr, ExprList, VarEnv, ValueType, vtype_is_str, vtype_eq}
use codegen.types.{Ctx, EmitResult, ok_emit, err_emit}
use codegen.strings.{emit_concat}
use codegen.helpers.{strip_quotes}

export fn emit_eprintln(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("eprintln() expects 1 arg")
        .Node(se, _) -> {
            let r = ctx.emit(env, se.node)?
            let str_ptr = match {
                vtype_is_str(r.ty) -> ctx.to_ptr(r.value, "eprint_arg")
                vtype_eq(r.ty, .Float) -> {
                    ctx.call("forge_float_to_string", [r.value])
                }
                _ -> {
                    let buf = ctx.malloc(ctx.i64(32))
                    let fmt = ctx.global_str("%lld", ".eprint_fmt")
                    ctx.call("snprintf", [buf, ctx.i64(32), fmt, r.value])
                    buf
                }
            }
            ctx.call("forge_eprintln", [str_ptr])
            ok_emit(ctx.i64(0))
        }
    }
}

export fn emit_println(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // Special-case the most common shape: `println("literal")`. We
    // destructure straight to the inner string text in a single
    // match — going through any extra binding clobbers the payload
    // (host miscompilation, see TECH_DEBT.md #11).
    let print_ptr = match args {
        .Node(se, _) -> {
            match se.node {
                .String(text) -> {
                    let inner = strip_quotes(text)
                    ctx.global_str(inner, ".str")
                }
                _ -> {
                    let r = ctx.emit(env, se.node)?
                    if vtype_eq(r.ty, .Float) {
                        ctx.call("forge_float_to_string", [r.value])
                    } else {
                        ctx.to_ptr(r.value, "print_arg")
                    }
                }
            }
        }
        .End -> {
            return err_emit("println expects 1 argument")
        }
    }
    ctx.call("puts", [print_ptr])
    ok_emit(ctx.i64(0))
}

