// WHY: shared codegen utilities used across features.

use core.ast.{Expr, ExprList, StmtList, ParamList, VarEnv, ValueType, TypeList, SStmt, stmt_unwrap}
use codegen.types.{Ctx, EmitValue, ParamTypeList, err_emit, null_ptr_val, ok_emit, param_type_at, param_type_vt_at, trait_decl_has, parse_type_list_str, translate_type_ctx}
use core.ast.{vtype_is_unknown}
use features.trait_decl.codegen.{box_for_trait, resolve_concrete_type_name}
use features.closures.codegen.{emit_lambda_typed}
use features.union_type.codegen.{emit_union_wrap, needs_union_wrap}

export fn emit_single_arg(ctx: Ctx, env: VarEnv, args: ExprList) -> Result<EmitValue, string> {
    match args {
        .End -> err_emit("expected 1 argument, got 0")
        .Node(se, _) -> ctx.emit(env, se.node)
    }
}

export fn strip_quotes(s: string) -> string {
    let len = s.length
    if len < 2 {
        return s
    }
    s.substring(1, len - 1)
}

export fn fill_arg_array(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> Result<EmitValue, string> {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(se, next) -> {
            let r = ctx.emit(env, se.node)?
            ctx.value_array_set(arr, idx, r.value)
            fill_arg_array(ctx, env, arr, next, idx + 1)
        }
    }
}

export fn fill_arg_array_boxing(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, ptypes: ParamTypeList, idx: int) -> Result<EmitValue, string> {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(se, next) -> {
            // When a Lambda arg is passed to a function expecting a typed fn param,
            // compile the lambda with the expected param types so enum matching works.
            mut r = EmitValue { value: ctx.i64(0), ty: .Int }
            match se.node {
                .Lambda(params, body) -> {
                    let fn_type_str = param_type_at(ptypes, idx)
                    let lambda_types = parse_fn_param_types(ctx, fn_type_str)
                    r = emit_lambda_typed(ctx, env, params, body, lambda_types)?
                }
                _ -> {
                    r = ctx.emit(env, se.node)?
                }
            }
            let ptype_str = param_type_at(ptypes, idx)
            // Check if the parameter type is a trait and the argument is concrete
            mut value = if ptype_str != "" && trait_decl_has(ctx.trait_decls, ptype_str) {
                let concrete_name = resolve_concrete_type_name(r.ty)
                if concrete_name != "" && !trait_decl_has(ctx.trait_decls, concrete_name) {
                    // The argument is a concrete type but the parameter expects a trait.
                    // Box the value into a trait object.
                    box_for_trait(ctx, r.value, ptype_str, concrete_name)
                } else {
                    // Already a trait object or same trait — pass through.
                    r.value
                }
            } else {
                r.value
            }
            // Union wrapping: concrete arg → union-typed param
            let param_vt = param_type_vt_at(ptypes, idx)
            if !vtype_is_unknown(param_vt) {
                let param_ty = ctx.resolve_codegen_vtype(param_vt)
                if needs_union_wrap(r.ty, param_ty) {
                    let wrapped = emit_union_wrap(ctx, value, r.ty, param_ty)?
                    value = wrapped.value
                }
            } else if ptype_str != "" {
                let param_ty = translate_type_ctx(ctx, ptype_str)
                if needs_union_wrap(r.ty, param_ty) {
                    let wrapped = emit_union_wrap(ctx, value, r.ty, param_ty)?
                    value = wrapped.value
                }
            }
            ctx.value_array_set(arr, idx, value)
            fill_arg_array_boxing(ctx, env, arr, next, ptypes, idx + 1)
        }
    }
}

// Extract param types from a function type string like "fn(Box)->int" → [Enum("Box")].
fn parse_fn_param_types(ctx: Ctx, fn_type_str: string) -> TypeList {
    if !fn_type_str.starts_with("fn(") { return TypeList.End }
    // Find the closing paren
    let after_fn = fn_type_str.substring(3, fn_type_str.length)
    let close = after_fn.index_of(")")
    if close < 0 { return TypeList.End }
    let params_str = after_fn.substring(0, close)
    if params_str == "" { return TypeList.End }
    parse_type_list_str(ctx.structs, ctx.enums, params_str)
}

export fn is_null_literal(e: Expr) -> bool { e is .Null }

export fn stmts_last_expr(stmts: StmtList) -> Expr {
    match stmts {
        .End -> .Null
        .Node(ss, next) -> {
            match next {
                .End -> {
                    let inner = stmt_unwrap(ss.node)
                    match inner {
                        .Expr(e) -> e
                        .Return(e) -> e
                        _ -> .Null
                    }
                }
                _ -> stmts_last_expr(next)
            }
        }
    }
}

