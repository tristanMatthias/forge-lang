// WHY: shared codegen types and pure leaf helpers that any feature
// codegen file may depend on. Living here breaks what would
// otherwise be a circular import: codegen.fg ↔ features/<X>/codegen.fg.
//
// Both sides depend one-way on this module, forming a clean DAG.
//
// AGENT:
//   read this file when:    looking for the EmitResult / StmtResult
//                           shape, the Cg helper API, or shared
//                           ValueType conventions
//   do NOT read this file when:   the issue is feature-specific emit
//                                 logic (features/<X>/codegen.fg)
//                                 or the dispatchers (codegen.fg)

use core.ast.{Expr, SExpr, VarEnv, FieldList, VariantList, ValueType, vtype_is_str, variant_lookup, vtype_eq, field_list_length}
use core.registry.{Registry}

// ── Codegen context ──
//
// The Codegen struct carries everything an emit function needs to
// reach the LLVM C API: the context, module, builder, and the
// function whose body the builder is currently positioned in.

export type Ctx = {
    lc: ptr,
    module: ptr,
    builder: ptr,
    // The function whose body the builder is currently positioned in.
    // append_basic_block needs this; codegen for `if`/`while` and
    // function bodies all use it.
    current_fn: ptr,
    current_fn_name: string,
    i64_type: ptr,
    i1_type: ptr,
    ptr_type: ptr,
    double_type: ptr,
    // Type registries — built once by the declaration passes and
    // then threaded through every emit function via the Codegen
    // struct. No mutable globals needed.
    structs: StructReg,
    enums: EnumReg,
    fn_rets: FnRetTypes,
    fn_params: FnParamTypes,
    top_level_vars: TopLevelVars,
    loops: LoopStack,
    defers: DeferStack,
    features: Registry,
    trait_decls: TraitDeclReg,
    debug_null_checks: bool,
    source_file: string,
    source_line: int,
}

// Trait declaration registry — maps trait name to method names + return types.
export enum TraitMethodNames {
    End
    Node(name: string, ret_ty: string, next: TraitMethodNames)
}

export enum TraitDeclReg {
    End
    Node(trait_name: string, methods: TraitMethodNames, next: TraitDeclReg)
}

export fn trait_decl_lookup(reg: TraitDeclReg, name: string) -> TraitMethodNames {
    match reg {
        .End -> .End
        .Node(n, methods, _) if n == name -> methods
        .Node(_, _, next) -> trait_decl_lookup(next, name)
    }
}

export fn trait_decl_has(reg: TraitDeclReg, name: string) -> bool {
    match reg {
        .End -> false
        .Node(n, _, _) if n == name -> true
        .Node(_, _, next) -> trait_decl_has(next, name)
    }
}

export fn null_ptr_val() -> ptr {
    let n: ptr = null
    n
}

// ── EmitResult / StmtResult ──
//
// Every emit_* function returns one of these. EmitResult carries a
// value (LLVM ValueRef as ptr) plus a ValueType `ty` that tells
// later code whether to dispatch through string operations or
// integer operations. StmtResult is the same shape minus the value:
// statements emit for side effects only.

export type EmitResult = {
    value: ptr,
    ty: ValueType,
    had_error: bool,
    error_message: string,
}

export fn ok_emit(value: ptr) -> EmitResult {
    EmitResult { value, ty: .Int, had_error: false, error_message: "" }
}

export fn ok_emit_str(value: ptr) -> EmitResult {
    EmitResult { value, ty: .Str, had_error: false, error_message: "" }
}

export fn ok_emit_typed(value: ptr, ty: ValueType) -> EmitResult {
    EmitResult { value, ty, had_error: false, error_message: "" }
}

export fn err_emit(message: string) -> EmitResult {
    EmitResult { value: null_ptr_val(), ty: .Int, had_error: true, error_message: "codegen error: ${message}" }
}

// 0xDEADBEEF as signed i64 — sentinel tag in closure arrays to
// distinguish closure values from plain function pointers.
export fn closure_marker() -> int { -559038737 }

export type StmtResult = {
    env: VarEnv,
    had_error: bool,
    error_message: string,
}

export fn ok_stmt(env: VarEnv) -> StmtResult {
    StmtResult { env, had_error: false, error_message: "" }
}

export fn err_stmt(message: string) -> StmtResult {
    StmtResult { env: .End, had_error: true, error_message: message }
}

export fn err_stmt_from_expr(r: EmitResult) -> StmtResult {
    StmtResult { env: .End, had_error: true, error_message: r.error_message }
}

// ── Pure leaf helpers ──
//
// These are the small string and list utilities that everything
// uses but nothing depends on (no global state, no other helpers
// from codegen.fg). They live here because moving them up out of
// codegen.fg unblocks feature-codegen extraction without dragging
// the registry state along with them.

export fn advance_field_list(fields: FieldList) -> FieldList {
    match fields {
        .End -> .End
        .Node(_, _, next) -> next
    }
}

export fn field_type_at(fields: FieldList, idx: int) -> string {
    match fields {
        .End -> "i64"
        .Node(_, ty, _) if idx <= 0 -> ty
        .Node(_, _, next) -> field_type_at(next, idx - 1)
    }
}

// ── Type registries ──
//
// Linked-list registries for struct and enum declarations. Built
// once by the declaration passes in compile_program, then carried
// through every emit function inside the Codegen struct. No
// mutable globals — the registries are pure data threaded through
// function parameters.


export enum FnRetTypes {
    End
    Node(name: string, ret_ty: ValueType, next: FnRetTypes)
}

// Per-parameter type string list — one entry per parameter of a function.
export enum ParamTypeList {
    End
    Node(ty: string, next: ParamTypeList)
}

// Maps function name → parameter type list (type annotation strings).
export enum FnParamTypes {
    End
    Node(name: string, params: ParamTypeList, next: FnParamTypes)
}

export fn fn_param_lookup(reg: FnParamTypes, name: string) -> ParamTypeList {
    match reg {
        .End -> .End
        .Node(n, params, _) if n == name -> params
        .Node(_, _, next) -> fn_param_lookup(next, name)
    }
}

// Get the Nth type string from a ParamTypeList (0-indexed).
export fn param_type_at(list: ParamTypeList, idx: int) -> string {
    match list {
        .End -> ""
        .Node(ty, _) if idx == 0 -> ty
        .Node(_, next) -> param_type_at(next, idx - 1)
    }
}

export enum TopLevelVars {
    End
    Node(name: string, llvm_global: ptr, ty: ValueType, next: TopLevelVars)
}

export enum LoopStack {
    End
    Frame(cond_bb: ptr, exit_bb: ptr, next: LoopStack)
}

export enum DeferStack {
    End
    Frame(body: SExpr, next: DeferStack)
}

export fn ctx_with_defers(ctx: Ctx, defers: DeferStack) -> Ctx {
    ctx with { defers }
}

export enum StructReg {
    End
    Node(name: string, fields: FieldList, next: StructReg)
}

export type StructLookup = {
    found: bool,
    fields: FieldList,
}

export fn struct_reg_lookup(reg: StructReg, name: string) -> StructLookup {
    match reg {
        .End -> StructLookup { found: false, fields: .End }
        .Node(n, fields, _) if n == name -> StructLookup { found: true, fields }
        .Node(_, _, next) -> struct_reg_lookup(next, name)
    }
}

export enum EnumReg {
    End
    Node(name: string, variants: VariantList, next: EnumReg)
}

export type EnumLookup = {
    found: bool,
    variants: VariantList,
}

export fn enum_reg_lookup(reg: EnumReg, name: string) -> EnumLookup {
    match reg {
        .End -> EnumLookup { found: false, variants: .End }
        .Node(n, variants, _) if n == name -> EnumLookup { found: true, variants }
        .Node(_, _, next) -> enum_reg_lookup(next, name)
    }
}

// Find the enum type name that contains a given variant.
// Used for contextual resolution: `.Variant` → `EnumName.Variant`.
export fn enum_reg_find_by_variant(reg: EnumReg, variant: string) -> string {
    match reg {
        .End -> ""
        .Node(name, variants, _) if variant_lookup(variants, variant).found -> name
        .Node(_, _, next) -> enum_reg_find_by_variant(next, variant)
    }
}

// Find variant by name AND field count — prevents ambiguity when
// multiple enums have the same variant name with different arities.
export fn enum_reg_find_by_variant_arity(reg: EnumReg, variant: string, arity: int) -> string {
    match reg {
        .End -> ""
        .Node(name, variants, next) -> {
            let v = variant_lookup(variants, variant)
            if v.found && field_list_length(v.fields) == arity {
                name
            } else {
                enum_reg_find_by_variant_arity(next, variant, arity)
            }
        }
    }
}

// translate_param_type: converts Forge type names to the internal
// string tag used by EmitResult.ty. Uses the registries from the
// Codegen struct.

export fn fn_ret_lookup(reg: FnRetTypes, name: string) -> ValueType {
    match reg {
        .End -> .Int
        .Node(n, ty, _) if n == name -> ty
        .Node(_, _, next) -> fn_ret_lookup(next, name)
    }
}

export type TopLevelLookup = {
    found: bool,
    llvm_global: ptr,
    ty: ValueType,
}

export fn toplevel_lookup(reg: TopLevelVars, name: string) -> TopLevelLookup {
    match reg {
        .End -> {
            let n: ptr = null
            TopLevelLookup { found: false, llvm_global: n, ty: .Int }
        }
        .Node(n, g, ty, _) if n == name -> TopLevelLookup { found: true, llvm_global: g, ty }
        .Node(_, _, _, next) -> toplevel_lookup(next, name)
    }
}

export type LoopFrame = {
    found: bool,
    cond_bb: ptr,
    exit_bb: ptr,
}

export fn loops_top(stack: LoopStack) -> LoopFrame {
    match stack {
        .End -> {
            let n: ptr = null
            LoopFrame { found: false, cond_bb: n, exit_bb: n }
        }
        .Frame(c, e, _) -> LoopFrame { found: true, cond_bb: c, exit_bb: e }
    }
}

fn find_close_paren(s: string, start: int) -> int {
    mut depth = 1
    mut i = start
    while i < s.length && depth > 0 {
        let ch = s.substring(i, i + 1)
        if ch == "(" { depth = depth + 1 }
        if ch == ")" { depth = depth - 1 }
        if depth > 0 { i = i + 1 }
    }
    i
}

fn parse_type_list_str(structs: StructReg, enums: EnumReg, s: string) -> TypeList {
    if s == "" { return TypeList.End }
    // Find next comma at depth 0
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s.substring(i, i + 1)
        if ch == "(" { depth = depth + 1 }
        if ch == ")" { depth = depth - 1 }
        if ch == "," && depth == 0 {
            let head = s.substring(0, i)
            let tail = s.substring(i + 1, s.length)
            let head_ty = translate_param_type(structs, enums, head)
            return TypeList.Node(head_ty, parse_type_list_str(structs, enums, tail))
        }
        i = i + 1
    }
    // No comma found — single type
    TypeList.Node(translate_param_type(structs, enums, s), TypeList.End)
}

export fn translate_param_type(structs: StructReg, enums: EnumReg, ty: string) -> ValueType {
    match ty {
        "str" or "string" -> return ValueType.Str
        "i64" or "int"    -> return ValueType.Int
        "float" or "f64"  -> return ValueType.Float
        "bool"            -> return ValueType.Bool
        "ptr"             -> return ValueType.Ptr
        "fn"              -> return ValueType.Fn(ValueType.Int)
        "List"            -> return ValueType.List(ValueType.Int)
        "Map"             -> return ValueType.Map
        _ -> {}
    }
    // List(T) → List type with inner
    if ty.starts_with("List(") && ty.length > 6 {
        let inner_name = ty.substring(5, ty.length - 1)
        let inner = translate_param_type(structs, enums, inner_name)
        return ValueType.List(inner)
    }
    if ty.starts_with("fn") && ty.length > 2 {
        // Parse fn(...)->Ret or fn->Ret
        let rest = ty.substring(2, ty.length)
        if rest.starts_with("(") {
            // fn(A,B)->Ret — parse params and return type
            let close_idx = find_close_paren(rest, 1)
            let params_str = rest.substring(1, close_idx)
            let param_types = parse_type_list_str(structs, enums, params_str)
            let after_paren = rest.substring(close_idx + 1, rest.length)
            let ret_ty = if after_paren.starts_with("->") {
                translate_param_type(structs, enums, after_paren.substring(2, after_paren.length))
            } else {
                ValueType.Void
            }
            return ValueType.FnTyped(param_types, ret_ty)
        }
        if rest.starts_with("->") {
            let ret_name = rest.substring(2, rest.length)
            let ret_type = translate_param_type(structs, enums, ret_name)
            return ValueType.Fn(ret_type)
        }
        return ValueType.Fn(ValueType.Int)
    }
    let enum_l = enum_reg_lookup(enums, ty)
    if enum_l.found {
        return ValueType.Enum(ty)
    }
    let struct_l = struct_reg_lookup(structs, ty)
    if struct_l.found {
        return ValueType.Struct(ty)
    }
    ValueType.Int
}

// translate_param_type with trait awareness — uses Ctx for trait registry.
export fn translate_type_ctx(ctx: Ctx, ty: string) -> ValueType {
    let base = translate_param_type(ctx.structs, ctx.enums, ty)
    // If base type is Int (unknown), check if it's a trait name
    if !vtype_eq(base, ValueType.Int) { return base }
    if ty in ["", "int", "i64"] { return base }
    if trait_decl_has(ctx.trait_decls, ty) {
        return ValueType.Trait(ty)
    }
    base
}

// ── LLVM type mapping ──
//
// Maps Forge's ValueType to the correct LLVM type. This is the core
// function that eliminates the everything-is-i64 model.
//
// int, bool (for now), float (for now) → i64
// string, ptr, struct, enum, list, map, fn, closure, trait → ptr

export fn llvm_type_for_full(i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, vt: ValueType) -> ptr {
    match vt {
        .Int -> i64t
        .Bool -> i1t
        .Float -> dt
        .Str -> pt
        .Ptr -> pt
        .Struct(_) -> pt
        .Enum(_) -> pt
        .List(_) -> pt
        .Map -> pt
        .Fn(_) -> pt
        .FnTyped(_, _) -> pt
        .Closure(_, _) -> pt
        .Trait(_) -> pt
        .Void -> i64t
        _ -> i64t
    }
}

// Fallback for callers without i1/double refs — maps Bool/Float to i64.
export fn llvm_type_for(i64t: ptr, pt: ptr, vt: ValueType) -> ptr {
    match vt {
        .Int -> i64t
        .Bool -> i64t
        .Float -> i64t
        .Str -> pt
        .Ptr -> pt
        .Struct(_) -> pt
        .Enum(_) -> pt
        .List(_) -> pt
        .Map -> pt
        .Fn(_) -> pt
        .FnTyped(_, _) -> pt
        .Closure(_, _) -> pt
        .Trait(_) -> pt
        .Void -> i64t
        _ -> i64t
    }
}

// Returns true if the ValueType maps to a pointer LLVM type.
export fn vtype_is_ptr_type(vt: ValueType) -> bool {
    match vt {
        .Int -> false
        .Bool -> false
        .Float -> false
        .Void -> false
        _ -> true
    }
}

// ── Ctx copy helpers ──
//
// Functional struct update via `with`. Adding a new field to Ctx
// requires ZERO changes here.

export fn ctx_with_fn(ctx: Ctx, fn_val: ptr, fn_name: string) -> Ctx {
    ctx with { current_fn: fn_val, current_fn_name: fn_name }
}

export fn ctx_with_loops(ctx: Ctx, loops: LoopStack) -> Ctx {
    ctx with { loops }
}

export fn ctx_with_top_level(ctx: Ctx, top_level_vars: TopLevelVars) -> Ctx {
    ctx with { top_level_vars }
}

// ── Cg helpers ──
//
// Fluent wrappers that compress the LLVM builder boilerplate.
// Each eliminates ~5-8 lines of type-array/value-array ceremony.
// Pure Forge functions calling the C externs from core/llvm.fg.

// Look up a module-level function by name.
export fn get_fn(ctx: Ctx, name: string) -> ptr {
    forge_llvm_get_named_function(ctx.module, name)
}

// Call a 0-arg function by value. Infers the function type from
// the LLVM function value itself (no manual type-array needed).
export fn call_0(ctx: Ctx, fn_val: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(0)
    let result = forge_llvm_build_call_coerce(ctx.builder, ft, fn_val, arr, 0, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 1-arg function by value.
export fn call_1(ctx: Ctx, fn_val: ptr, a0: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(arr, 0, a0)
    let result = forge_llvm_build_call_coerce(ctx.builder, ft, fn_val, arr, 1, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 2-arg function by value.
export fn call_2(ctx: Ctx, fn_val: ptr, a0: ptr, a1: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(2)
    forge_llvm_value_array_set(arr, 0, a0)
    forge_llvm_value_array_set(arr, 1, a1)
    let result = forge_llvm_build_call_coerce(ctx.builder, ft, fn_val, arr, 2, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 3-arg function by value.
export fn call_3(ctx: Ctx, fn_val: ptr, a0: ptr, a1: ptr, a2: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(3)
    forge_llvm_value_array_set(arr, 0, a0)
    forge_llvm_value_array_set(arr, 1, a1)
    forge_llvm_value_array_set(arr, 2, a2)
    let result = forge_llvm_build_call_coerce(ctx.builder, ft, fn_val, arr, 3, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 4-arg function by value (snprintf).
export fn call_4(ctx: Ctx, fn_val: ptr, a0: ptr, a1: ptr, a2: ptr, a3: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(4)
    forge_llvm_value_array_set(arr, 0, a0)
    forge_llvm_value_array_set(arr, 1, a1)
    forge_llvm_value_array_set(arr, 2, a2)
    forge_llvm_value_array_set(arr, 3, a3)
    let result = forge_llvm_build_call_coerce(ctx.builder, ft, fn_val, arr, 4, name)
    forge_llvm_value_array_free(arr)
    result
}

// Convenience: look up a function by name and call it with 1 arg.
export fn call_named_1(ctx: Ctx, name: string, a0: ptr, result_name: string) -> ptr {
    call_1(ctx, get_fn(ctx, name), a0, result_name)
}

// Allocate memory for structs, enums, with-expressions.
// Uses bump allocator (no free, no reuse, no corruption).
// malloc is still declared for array/map code that needs realloc.
export fn cg_malloc(ctx: Ctx, size: ptr) -> ptr {
    call_named_1(ctx, "forge_bump_alloc", size, "buf")
}

// Allocate a new basic block and position the builder at its end.
export fn new_bb(ctx: Ctx, name: string) -> ptr {
    forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, name)
}

// Shorthand for common constants.
export fn const_i64(ctx: Ctx, value: int) -> ptr {
    forge_llvm_const_int(ctx.i64_type, value, 0)
}

export fn const_i8(ctx: Ctx, value: int) -> ptr {
    forge_llvm_const_int(forge_llvm_int8_type(ctx.lc), value, 0)
}

// i64 ↔ ptr conversions (the bootstrap's value model).
export fn to_ptr(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_int_to_ptr(ctx.builder, val, ctx.ptr_type, name)
}

export fn to_i64(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_type, name)
}

// i64 ↔ f64 conversions (float values stored as bitcast i64).
export fn to_f64(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_bitcast(ctx.builder, val, forge_llvm_double_type(ctx.lc), name)
}

export fn f64_to_i64(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_bitcast(ctx.builder, val, ctx.i64_type, name)
}

// ── Ctx builder DSL ──
// Three levels: raw LLVM wrappers, common patterns, semantic operations.
// All codegen code should use these instead of raw forge_llvm_* calls.

impl Ctx {
    // ── Level 0: lift free functions to methods ──

    fn bb(self, name: string) -> ptr { forge_llvm_append_basic_block(self.lc, self.current_fn, name) }
    fn i64(self, value: int) -> ptr { forge_llvm_const_int(self.i64_type, value, 0) }
    fn i8(self, value: int) -> ptr { forge_llvm_const_int(forge_llvm_int8_type(self.lc), value, 0) }
    fn get_fn(self, name: string) -> ptr { forge_llvm_get_named_function(self.module, name) }
    fn malloc(self, size: ptr) -> ptr { call_named_1(self, "forge_bump_alloc", size, "buf") }

    // ── Type-aware operations ──
    // These use forge_llvm_cast_to_type which handles ALL type
    // combinations: ptr↔i64, i1↔i64, double↔i64, etc.
    // No-op when value already has the target type.

    fn to_ptr(self, val: ptr, name: string) -> ptr { forge_llvm_cast_to_type(self.builder, val, self.ptr_type) }
    fn to_i64(self, val: ptr, name: string) -> ptr { forge_llvm_cast_to_type(self.builder, val, self.i64_type) }
    fn to_f64(self, val: ptr, name: string) -> ptr { forge_llvm_cast_to_type(self.builder, val, self.double_type) }

    // Cast value to match a ValueType's LLVM representation.
    fn cast_to(self, val: ptr, vt: ValueType) -> ptr { forge_llvm_cast_to_type(self.builder, val, self.type_for(vt)) }

    // Value conversions (semantic, not bit-reinterpretation):
    fn sitofp(self, val: ptr, name: string) -> ptr { forge_llvm_build_si_to_fp(self.builder, val, self.double_type, name) }
    fn fptosi(self, val: ptr, name: string) -> ptr { forge_llvm_build_fp_to_si(self.builder, val, self.i64_type, name) }

    // Map a ValueType to its LLVM type.
    fn type_for(self, vt: ValueType) -> ptr {
        llvm_type_for_full(self.i64_type, self.i1_type, self.double_type, self.ptr_type, vt)
    }

    // Typed alloca/load: use the correct LLVM type for a ValueType.
    fn alloca_typed(self, vt: ValueType, name: string) -> ptr { forge_llvm_build_alloca(self.builder, self.type_for(vt), name) }
    fn load_typed(self, vt: ValueType, src: ptr, name: string) -> ptr { forge_llvm_build_load(self.builder, self.type_for(vt), src, name) }

    // Zero/null value for a given type.
    fn zero_for(self, vt: ValueType) -> ptr {
        forge_llvm_const_null(self.type_for(vt))
    }

    // Return from the current function, casting val to match the declared return type.
    fn ret(self, val: ptr, ret_ty: ValueType) { forge_llvm_build_ret(self.builder, self.cast_to(val, ret_ty)) }
    fn ret_void(self, ret_ty: ValueType) { forge_llvm_build_ret(self.builder, self.zero_for(ret_ty)) }

    // Call any C function by name with a list of args.
    // Automatically coerces arguments to match the declared parameter types.
    fn call(self, name: string, args: [ptr]) -> ptr {
        let fn_val = forge_llvm_get_named_function(self.module, name)
        let ft = forge_llvm_fn_type_of(fn_val)
        let count = args.length
        let arr = forge_llvm_value_array_new(count)
        for i in 0..count {
            forge_llvm_value_array_set(arr, i, args[i])
        }
        let result = forge_llvm_build_call_coerce(self.builder, ft, fn_val, arr, count, "")
        forge_llvm_value_array_free(arr)
        result
    }

    // Call a function value (not by name — for local fn variables).
    fn call_fn(self, fn_val: ptr, args: [ptr]) -> ptr {
        let ft = forge_llvm_fn_type_of(fn_val)
        let count = args.length
        let arr = forge_llvm_value_array_new(count)
        for i in 0..count {
            forge_llvm_value_array_set(arr, i, args[i])
        }
        let result = forge_llvm_build_call_coerce(self.builder, ft, fn_val, arr, count, "")
        forge_llvm_value_array_free(arr)
        result
    }

    // Same but with a named result.
    fn call_fn_named(self, fn_val: ptr, args: [ptr], name: string) -> ptr {
        let ft = forge_llvm_fn_type_of(fn_val)
        let count = args.length
        let arr = forge_llvm_value_array_new(count)
        for i in 0..count {
            forge_llvm_value_array_set(arr, i, args[i])
        }
        let result = forge_llvm_build_call_coerce(self.builder, ft, fn_val, arr, count, name)
        forge_llvm_value_array_free(arr)
        result
    }

    // Emit a null-deref trap (branchless — C function checks internally).
    fn null_check(self, val: ptr, field_name: string, type_name: string) {
        let val_i64 = self.to_i64(val, "nc_val")
        let is_null_i1 = self.icmp(32, val_i64, forge_llvm_const_int(self.i64_type, 0, 0), "null_chk")
        let is_null = self.zext(is_null_i1, self.i64_type, "null_ext")
        self.call("forge_null_deref_trap", [
            self.global_str(field_name, "fld_name"), self.i64(field_name.length),
            self.global_str(type_name, "sty_name"), self.i64(type_name.length),
            is_null,
            self.global_str(self.source_file, "src_file"), self.i64(self.source_file.length),
            self.i64(self.source_line)
        ])
    }

    // ── Level 1: raw LLVM (eliminate ctx.builder repetition) ──

    fn position(self, bb: ptr) { forge_llvm_position_at_end(self.builder, bb) }
    // Type-safe store: always casts the value to match the destination's
    // allocated type. For allocas, reads the type from LLVM. For GEP
    // destinations (struct fields), the alloca type check falls back to
    // a raw store — use store_field for struct fields instead.
    fn store(self, val: ptr, dest: ptr) { forge_llvm_build_store_cast(self.builder, val, dest) }

    // Store into a struct field GEP with explicit type casting.
    // This is the ONLY safe way to store into struct fields — the
    // destination type can't be inferred from opaque pointers.
    fn store_field(self, val: ptr, gep: ptr, field_ty: ValueType) {
        forge_llvm_build_store(self.builder, self.cast_to(val, field_ty), gep)
    }
    // ── Memory ──
    fn load(self, ty: ptr, src: ptr, name: string) -> ptr { forge_llvm_build_load(self.builder, ty, src, name) }
    fn load_i64(self, src: ptr, name: string) -> ptr { forge_llvm_build_load(self.builder, self.i64_type, src, name) }
    fn load_i8(self, src: ptr, name: string) -> ptr { forge_llvm_build_load(self.builder, forge_llvm_int8_type(self.lc), src, name) }
    fn alloca(self, ty: ptr, name: string) -> ptr { forge_llvm_build_alloca(self.builder, ty, name) }
    fn alloca_i64(self, name: string) -> ptr { forge_llvm_build_alloca(self.builder, self.i64_type, name) }
    fn gep(self, ty: ptr, base: ptr, idx: int, name: string) -> ptr { forge_llvm_build_struct_gep2(self.builder, ty, base, idx, name) }
    fn global_str(self, text: string, name: string) -> ptr { forge_llvm_build_global_string_ptr(self.builder, text, name) }

    // ── Control flow ──
    fn br(self, bb: ptr) { forge_llvm_build_br(self.builder, bb) }
    fn cond_br(self, cond: ptr, then_bb: ptr, else_bb: ptr) { forge_llvm_build_cond_br(self.builder, cond, then_bb, else_bb) }
    fn build_ret(self, val: ptr) { forge_llvm_build_ret(self.builder, val) }
    fn unreachable(self) { forge_llvm_build_unreachable(self.builder) }
    fn has_terminator(self) -> bool { forge_llvm_block_has_terminator(self.builder) != 0 }
    fn current_bb(self) -> ptr { forge_llvm_get_insert_block(self.builder) }

    // ── Integer arithmetic ──
    fn add(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_add(self.builder, a, b, name) }
    fn sub(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_sub(self.builder, a, b, name) }
    fn mul(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_mul(self.builder, a, b, name) }
    fn sdiv(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_sdiv(self.builder, a, b, name) }
    fn srem(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_srem(self.builder, a, b, name) }
    fn bit_and(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_and(self.builder, a, b, name) }
    fn bit_or(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_or(self.builder, a, b, name) }
    fn bit_xor(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_xor(self.builder, a, b, name) }
    fn shl(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_shl(self.builder, a, b, name) }
    fn shr(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_ashr(self.builder, a, b, name) }
    fn bit_not(self, val: ptr, name: string) -> ptr { forge_llvm_build_not(self.builder, val, name) }

    // ── Comparisons ──
    fn icmp(self, pred: int, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_icmp(self.builder, pred, a, b, name) }
    fn fcmp(self, pred: int, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_fcmp(self.builder, pred, a, b, name) }
    fn zext(self, val: ptr, ty: ptr, name: string) -> ptr { forge_llvm_build_zext(self.builder, val, ty, name) }
    fn sext(self, val: ptr, ty: ptr, name: string) -> ptr { forge_llvm_build_sext(self.builder, val, ty, name) }

    // ── Float arithmetic ──
    fn fadd(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_fadd(self.builder, a, b, name) }
    fn fsub(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_fsub(self.builder, a, b, name) }
    fn fmul(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_fmul(self.builder, a, b, name) }
    fn fdiv(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_fdiv(self.builder, a, b, name) }
    fn frem(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_frem(self.builder, a, b, name) }
    fn fneg(self, val: ptr, name: string) -> ptr { forge_llvm_build_fneg(self.builder, val, name) }

    // ── PHI nodes ──
    fn phi_i1(self, name: string) -> ptr { forge_llvm_build_phi(self.builder, self.i1_type, name) }
    fn add_incoming(self, phi: ptr, val: ptr, bb: ptr) { forge_llvm_add_incoming(phi, val, bb) }

    // ── Constants ──
    fn const_i1(self, val: int) -> ptr { forge_llvm_const_int(self.i1_type, val, 0) }

    // ── Lookups ──
    fn get_type(self, name: string) -> ptr { forge_llvm_get_type_by_name(self.lc, name) }
    fn int_to_ptr(self, val: ptr, name: string) -> ptr { forge_llvm_build_int_to_ptr(self.builder, val, self.ptr_type, name) }
    fn ptr_to_int(self, val: ptr, name: string) -> ptr { forge_llvm_build_ptr_to_int(self.builder, val, self.i64_type, name) }

    // Deprecated — use add/sub/bit_or instead.
    fn build_add(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_add(self.builder, a, b, name) }
    fn build_sub(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_sub(self.builder, a, b, name) }
    fn build_or(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_or(self.builder, a, b, name) }

    // ── Level 2: common patterns (2-3 lines → 1) ──

    // Named comparison predicates (i1 results — for branch conditions)
    fn eq(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_icmp(self.builder, 32, a, b, name) }
    fn ne(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_icmp(self.builder, 33, a, b, name) }
    fn slt(self, a: ptr, b: ptr, name: string) -> ptr { forge_llvm_build_icmp(self.builder, 40, a, b, name) }

    // Is this value truthy (non-zero / non-null)? Handles all value types:
    // ptr → null check, i64 → zero check, i1 → use directly, double → fcmp ne 0.0
    fn truthy(self, val: ptr, name: string) -> ptr {
        let kind = forge_llvm_type_kind(forge_llvm_typeof(val))
        if kind == 14 { return forge_llvm_build_icmp(self.builder, 33, val, forge_llvm_const_null(self.ptr_type), name) }
        if kind == 3 { return forge_llvm_build_fcmp(self.builder, 6, val, forge_llvm_const_null(self.double_type), name) }
        if kind == 8 && forge_llvm_int_type_width(forge_llvm_typeof(val)) == 1 { return val }
        forge_llvm_build_icmp(self.builder, 33, val, forge_llvm_const_int(forge_llvm_typeof(val), 0, 0), name)
    }

    // Branch on truthiness: create then/else BBs, position at then, return else_bb.
    // The universal "if" primitive — replaces 5 lines everywhere.
    fn if_true(self, val: ptr, prefix: string) -> ptr {
        let cond = self.truthy(val, "${prefix}_cond")
        let then_bb = forge_llvm_append_basic_block(self.lc, self.current_fn, "${prefix}_then")
        let else_bb = forge_llvm_append_basic_block(self.lc, self.current_fn, "${prefix}_else")
        forge_llvm_build_cond_br(self.builder, cond, then_bb, else_bb)
        forge_llvm_position_at_end(self.builder, then_bb)
        else_bb
    }

    // Compare + zext to i64 in one call (for value use, not branching).
    // Casts b to match a's type before comparing.
    fn icmp_eq(self, a: ptr, b: ptr, name: string) -> ptr {
        let b2 = forge_llvm_cast_to_type(self.builder, b, forge_llvm_typeof(a))
        let cmp = forge_llvm_build_icmp(self.builder, 32, a, b2, name)
        forge_llvm_build_zext(self.builder, cmp, self.i64_type, "${name}_ext")
    }

    fn icmp_ne(self, a: ptr, b: ptr, name: string) -> ptr {
        let b2 = forge_llvm_cast_to_type(self.builder, b, forge_llvm_typeof(a))
        let cmp = forge_llvm_build_icmp(self.builder, 33, a, b2, name)
        forge_llvm_build_zext(self.builder, cmp, self.i64_type, "${name}_ext")
    }

    // Branch to bb only if current block has no terminator
    fn br_if_open(self, bb: ptr) {
        if forge_llvm_block_has_terminator(self.builder) == 0 {
            forge_llvm_build_br(self.builder, bb)
        }
    }

    // Store a value and branch — the most common expr-result pattern.
    // Casts ptr values to i64 for i64 result slots.
    fn store_br_if_open(self, val: ptr, slot: ptr, bb: ptr) {
        if forge_llvm_block_has_terminator(self.builder) == 0 {
            let store_val = self.to_i64(val, "slot_val")
            forge_llvm_build_store(self.builder, store_val, slot)
            forge_llvm_build_br(self.builder, bb)
        }
    }

    // Create a string constant — returns ptr directly (no i64 cast).
    fn string_val(self, text: string) -> ptr {
        forge_llvm_build_global_string_ptr(self.builder, text, ".str")
    }

    // ── Level 3: semantic operations (4-6 lines → 1) ──

    // Load the tag (i64 hash) from an enum value
    fn enum_tag(self, val: ptr, type_name: string) -> ptr {
        let obj = self.to_ptr(val, "tag_obj")
        let st_ty = forge_llvm_get_type_by_name(self.lc, type_name)
        let tag_gep = forge_llvm_build_struct_gep2(self.builder, st_ty, obj, 0, "tag_ptr")
        forge_llvm_build_load(self.builder, self.i64_type, tag_gep, "tag")
    }

    // Load the payload pointer from an enum value
    fn enum_payload(self, val: ptr, type_name: string) -> ptr {
        let obj = self.to_ptr(val, "pay_obj")
        let st_ty = forge_llvm_get_type_by_name(self.lc, type_name)
        let pay_gep = forge_llvm_build_struct_gep2(self.builder, st_ty, obj, 1, "pay_ptr")
        forge_llvm_build_load(self.builder, self.ptr_type, pay_gep, "payload")
    }

    // Load a struct field by index
    fn field(self, val: ptr, type_name: string, idx: int, name: string) -> ptr {
        let obj = self.to_ptr(val, "fld_obj")
        let st_ty = forge_llvm_get_type_by_name(self.lc, type_name)
        let fld_gep = forge_llvm_build_struct_gep2(self.builder, st_ty, obj, idx, "${name}_ptr")
        forge_llvm_build_load(self.builder, self.i64_type, fld_gep, name)
    }
}
