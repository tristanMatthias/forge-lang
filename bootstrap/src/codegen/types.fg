// WHY: shared codegen types and pure leaf helpers that any feature
// codegen file may depend on. Living here breaks what would
// otherwise be a circular import: codegen.fg ↔ features/<X>/codegen.fg.
//
// Both sides depend one-way on this module, forming a clean DAG.
//
// AGENT:
//   read this file when:    looking for the EmitResult / StmtResult
//                           shape, the Cg helper API, or shared
//                           ValueType conventions
//   do NOT read this file when:   the issue is feature-specific emit
//                                 logic (features/<X>/codegen.fg)
//                                 or the dispatchers (codegen.fg)

use core.ast.{Expr, SExpr, VarEnv, FieldList, VariantList, ValueType, vtype_is_str, variant_lookup, vtype_eq}
use core.registry.{Registry}

// ── Codegen context ──
//
// The Codegen struct carries everything an emit function needs to
// reach the LLVM C API: the context, module, builder, and the
// function whose body the builder is currently positioned in.

export type Ctx = {
    lc: ptr,
    module: ptr,
    builder: ptr,
    // The function whose body the builder is currently positioned in.
    // append_basic_block needs this; codegen for `if`/`while` and
    // function bodies all use it.
    current_fn: ptr,
    current_fn_name: string,
    i64_type: ptr,
    i1_type: ptr,
    ptr_type: ptr,
    // Type registries — built once by the declaration passes and
    // then threaded through every emit function via the Codegen
    // struct. No mutable globals needed.
    structs: StructReg,
    enums: EnumReg,
    fn_rets: FnRetTypes,
    fn_params: FnParamTypes,
    top_level_vars: TopLevelVars,
    loops: LoopStack,
    defers: DeferStack,
    features: Registry,
    trait_decls: TraitDeclReg,
    debug_null_checks: bool,
    source_file: string,
    source_line: int,
}

// Trait declaration registry — maps trait name to method names + return types.
export enum TraitMethodNames {
    End
    Node(name: string, ret_ty: string, next: TraitMethodNames)
}

export enum TraitDeclReg {
    End
    Node(trait_name: string, methods: TraitMethodNames, next: TraitDeclReg)
}

export fn trait_decl_lookup(reg: TraitDeclReg, name: string) -> TraitMethodNames {
    match reg {
        .End -> TraitMethodNames.End
        .Node(n, methods, next) -> {
            if n == name { return methods }
            trait_decl_lookup(next, name)
        }
    }
}

export fn trait_decl_has(reg: TraitDeclReg, name: string) -> bool {
    match reg {
        .End -> false
        .Node(n, _, next) -> {
            if n == name { return true }
            trait_decl_has(next, name)
        }
    }
}

export fn null_ptr_val() -> ptr {
    let n: ptr = null
    n
}

// ── EmitResult / StmtResult ──
//
// Every emit_* function returns one of these. EmitResult carries a
// value (LLVM ValueRef as ptr) plus a ValueType `ty` that tells
// later code whether to dispatch through string operations or
// integer operations. StmtResult is the same shape minus the value:
// statements emit for side effects only.

export type EmitResult = {
    value: ptr,
    ty: ValueType,
    had_error: bool,
    error_message: string,
}

export fn ok_emit(value: ptr) -> EmitResult {
    EmitResult { value, ty: ValueType.Int, had_error: false, error_message: "" }
}

export fn ok_emit_str(value: ptr) -> EmitResult {
    EmitResult { value, ty: ValueType.Str, had_error: false, error_message: "" }
}

export fn ok_emit_typed(value: ptr, ty: ValueType) -> EmitResult {
    EmitResult { value, ty, had_error: false, error_message: "" }
}

export fn err_emit(message: string) -> EmitResult {
    EmitResult { value: null_ptr_val(), ty: ValueType.Int, had_error: true, error_message: "codegen error: " + message }
}

export type StmtResult = {
    env: VarEnv,
    had_error: bool,
    error_message: string,
}

export fn ok_stmt(env: VarEnv) -> StmtResult {
    StmtResult { env, had_error: false, error_message: "" }
}

export fn err_stmt(message: string) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: message }
}

export fn err_stmt_from_expr(r: EmitResult) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: r.error_message }
}

// ── Pure leaf helpers ──
//
// These are the small string and list utilities that everything
// uses but nothing depends on (no global state, no other helpers
// from codegen.fg). They live here because moving them up out of
// codegen.fg unblocks feature-codegen extraction without dragging
// the registry state along with them.

export fn advance_field_list(fields: FieldList) -> FieldList {
    match fields {
        .End -> FieldList.End
        .Node(_, _, next) -> next
    }
}

export fn field_type_at(fields: FieldList, idx: int) -> string {
    match fields {
        .End -> "i64"
        .Node(_, ty, next) -> {
            if idx <= 0 {
                return ty
            }
            field_type_at(next, idx - 1)
        }
    }
}

// ── Type registries ──
//
// Linked-list registries for struct and enum declarations. Built
// once by the declaration passes in compile_program, then carried
// through every emit function inside the Codegen struct. No
// mutable globals — the registries are pure data threaded through
// function parameters.


export enum FnRetTypes {
    End
    Node(name: string, ret_ty: ValueType, next: FnRetTypes)
}

// Per-parameter type string list — one entry per parameter of a function.
export enum ParamTypeList {
    End
    Node(ty: string, next: ParamTypeList)
}

// Maps function name → parameter type list (type annotation strings).
export enum FnParamTypes {
    End
    Node(name: string, params: ParamTypeList, next: FnParamTypes)
}

export fn fn_param_lookup(reg: FnParamTypes, name: string) -> ParamTypeList {
    match reg {
        .End -> ParamTypeList.End
        .Node(n, params, next) -> {
            if n == name { return params }
            fn_param_lookup(next, name)
        }
    }
}

// Get the Nth type string from a ParamTypeList (0-indexed).
export fn param_type_at(list: ParamTypeList, idx: int) -> string {
    match list {
        .End -> ""
        .Node(ty, next) -> {
            if idx == 0 { return ty }
            param_type_at(next, idx - 1)
        }
    }
}

export enum TopLevelVars {
    End
    Node(name: string, llvm_global: ptr, ty: ValueType, next: TopLevelVars)
}

export enum LoopStack {
    End
    Frame(cond_bb: ptr, exit_bb: ptr, next: LoopStack)
}

export enum DeferStack {
    End
    Frame(body: SExpr, next: DeferStack)
}

export fn ctx_with_defers(ctx: Ctx, defers: DeferStack) -> Ctx {
    ctx with { defers }
}

export enum StructReg {
    End
    Node(name: string, fields: FieldList, next: StructReg)
}

export type StructLookup = {
    found: bool,
    fields: FieldList,
}

export fn struct_reg_lookup(reg: StructReg, name: string) -> StructLookup {
    match reg {
        .End -> StructLookup { found: false, fields: FieldList.End }
        .Node(n, fields, next) -> {
            if n == name {
                return StructLookup { found: true, fields }
            }
            struct_reg_lookup(next, name)
        }
    }
}

export enum EnumReg {
    End
    Node(name: string, variants: VariantList, next: EnumReg)
}

export type EnumLookup = {
    found: bool,
    variants: VariantList,
}

export fn enum_reg_lookup(reg: EnumReg, name: string) -> EnumLookup {
    match reg {
        .End -> EnumLookup { found: false, variants: VariantList.End }
        .Node(n, variants, next) -> {
            if n == name {
                return EnumLookup { found: true, variants }
            }
            enum_reg_lookup(next, name)
        }
    }
}

// Find the enum type name that contains a given variant.
// Used for contextual resolution: `.Variant` → `EnumName.Variant`.
export fn enum_reg_find_by_variant(reg: EnumReg, variant: string) -> string {
    match reg {
        .End -> ""
        .Node(name, variants, next) -> {
            let v = variant_lookup(variants, variant)
            if v.found { return name }
            enum_reg_find_by_variant(next, variant)
        }
    }
}

// translate_param_type: converts Forge type names to the internal
// string tag used by EmitResult.ty. Uses the registries from the
// Codegen struct.

export fn fn_ret_lookup(reg: FnRetTypes, name: string) -> ValueType {
    match reg {
        .End -> ValueType.Int
        .Node(n, ty, next) -> {
            if n == name { return ty }
            fn_ret_lookup(next, name)
        }
    }
}

export type TopLevelLookup = {
    found: bool,
    llvm_global: ptr,
    ty: ValueType,
}

export fn toplevel_lookup(reg: TopLevelVars, name: string) -> TopLevelLookup {
    match reg {
        .End -> {
            let n: ptr = null
            TopLevelLookup { found: false, llvm_global: n, ty: ValueType.Int }
        }
        .Node(n, g, ty, next) -> {
            if n == name { return TopLevelLookup { found: true, llvm_global: g, ty } }
            toplevel_lookup(next, name)
        }
    }
}

export type LoopFrame = {
    found: bool,
    cond_bb: ptr,
    exit_bb: ptr,
}

export fn loops_top(stack: LoopStack) -> LoopFrame {
    match stack {
        .End -> {
            let n: ptr = null
            LoopFrame { found: false, cond_bb: n, exit_bb: n }
        }
        .Frame(c, e, _) -> LoopFrame { found: true, cond_bb: c, exit_bb: e }
    }
}

fn find_close_paren(s: string, start: int) -> int {
    mut depth = 1
    mut i = start
    while i < s.length && depth > 0 {
        let ch = s.substring(i, i + 1)
        if ch == "(" { depth = depth + 1 }
        if ch == ")" { depth = depth - 1 }
        if depth > 0 { i = i + 1 }
    }
    i
}

fn parse_type_list_str(structs: StructReg, enums: EnumReg, s: string) -> TypeList {
    if s == "" { return TypeList.End }
    // Find next comma at depth 0
    mut depth = 0
    mut i = 0
    while i < s.length {
        let ch = s.substring(i, i + 1)
        if ch == "(" { depth = depth + 1 }
        if ch == ")" { depth = depth - 1 }
        if ch == "," && depth == 0 {
            let head = s.substring(0, i)
            let tail = s.substring(i + 1, s.length)
            let head_ty = translate_param_type(structs, enums, head)
            return TypeList.Node(head_ty, parse_type_list_str(structs, enums, tail))
        }
        i = i + 1
    }
    // No comma found — single type
    TypeList.Node(translate_param_type(structs, enums, s), TypeList.End)
}

export fn translate_param_type(structs: StructReg, enums: EnumReg, ty: string) -> ValueType {
    if ty == "str" { return ValueType.Str }
    if ty == "string" { return ValueType.Str }
    if ty == "i64" { return ValueType.Int }
    if ty == "int" { return ValueType.Int }
    if ty == "float" || ty == "f64" { return ValueType.Float }
    if ty == "bool" { return ValueType.Bool }
    if ty == "ptr" { return ValueType.Ptr }
    if ty == "fn" { return ValueType.Fn(ValueType.Int) }
    if ty.length > 2 && ty.substring(0, 2) == "fn" {
        // Parse fn(...)->Ret or fn->Ret
        let rest = ty.substring(2, ty.length)
        if rest.length > 0 && rest.substring(0, 1) == "(" {
            // fn(A,B)->Ret — parse params and return type
            let close_idx = find_close_paren(rest, 1)
            let params_str = rest.substring(1, close_idx)
            let param_types = parse_type_list_str(structs, enums, params_str)
            let after_paren = rest.substring(close_idx + 1, rest.length)
            let ret_ty = if after_paren.length > 2 && after_paren.substring(0, 2) == "->" {
                translate_param_type(structs, enums, after_paren.substring(2, after_paren.length))
            } else {
                ValueType.Void
            }
            return ValueType.FnTyped(param_types, ret_ty)
        }
        if rest.length > 2 && rest.substring(0, 2) == "->" {
            let ret_name = rest.substring(2, rest.length)
            let ret_type = translate_param_type(structs, enums, ret_name)
            return ValueType.Fn(ret_type)
        }
        return ValueType.Fn(ValueType.Int)
    }
    if ty == "List" { return ValueType.List(ValueType.Int) }
    if ty == "Map" { return ValueType.Map }
    let enum_l = enum_reg_lookup(enums, ty)
    if enum_l.found {
        return ValueType.Enum(ty)
    }
    let struct_l = struct_reg_lookup(structs, ty)
    if struct_l.found {
        return ValueType.Struct(ty)
    }
    ValueType.Int
}

// translate_param_type with trait awareness — uses Ctx for trait registry.
export fn translate_type_ctx(ctx: Ctx, ty: string) -> ValueType {
    let base = translate_param_type(ctx.structs, ctx.enums, ty)
    // If base type is Int (unknown), check if it's a trait name
    if !vtype_eq(base, ValueType.Int) { return base }
    if ty == "" || ty == "int" || ty == "i64" { return base }
    if trait_decl_has(ctx.trait_decls, ty) {
        return ValueType.Trait(ty)
    }
    base
}

// ── Ctx copy helpers ──
//
// Functional struct update via `with`. Adding a new field to Ctx
// requires ZERO changes here.

export fn ctx_with_fn(ctx: Ctx, fn_val: ptr, fn_name: string) -> Ctx {
    ctx with { current_fn: fn_val, current_fn_name: fn_name }
}

export fn ctx_with_loops(ctx: Ctx, loops: LoopStack) -> Ctx {
    ctx with { loops }
}

export fn ctx_with_top_level(ctx: Ctx, top_level_vars: TopLevelVars) -> Ctx {
    ctx with { top_level_vars }
}

// ── Cg helpers ──
//
// Fluent wrappers that compress the LLVM builder boilerplate.
// Each eliminates ~5-8 lines of type-array/value-array ceremony.
// Pure Forge functions calling the C externs from core/llvm.fg.

// Look up a module-level function by name.
export fn get_fn(ctx: Ctx, name: string) -> ptr {
    forge_llvm_get_named_function(ctx.module, name)
}

// Call a 0-arg function by value. Infers the function type from
// the LLVM function value itself (no manual type-array needed).
export fn call_0(ctx: Ctx, fn_val: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(0)
    let result = forge_llvm_build_call(ctx.builder, ft, fn_val, arr, 0, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 1-arg function by value.
export fn call_1(ctx: Ctx, fn_val: ptr, a0: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(arr, 0, a0)
    let result = forge_llvm_build_call(ctx.builder, ft, fn_val, arr, 1, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 2-arg function by value.
export fn call_2(ctx: Ctx, fn_val: ptr, a0: ptr, a1: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(2)
    forge_llvm_value_array_set(arr, 0, a0)
    forge_llvm_value_array_set(arr, 1, a1)
    let result = forge_llvm_build_call(ctx.builder, ft, fn_val, arr, 2, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 3-arg function by value.
export fn call_3(ctx: Ctx, fn_val: ptr, a0: ptr, a1: ptr, a2: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(3)
    forge_llvm_value_array_set(arr, 0, a0)
    forge_llvm_value_array_set(arr, 1, a1)
    forge_llvm_value_array_set(arr, 2, a2)
    let result = forge_llvm_build_call(ctx.builder, ft, fn_val, arr, 3, name)
    forge_llvm_value_array_free(arr)
    result
}

// Call a 4-arg function by value (snprintf).
export fn call_4(ctx: Ctx, fn_val: ptr, a0: ptr, a1: ptr, a2: ptr, a3: ptr, name: string) -> ptr {
    let ft = forge_llvm_fn_type_of(fn_val)
    let arr = forge_llvm_value_array_new(4)
    forge_llvm_value_array_set(arr, 0, a0)
    forge_llvm_value_array_set(arr, 1, a1)
    forge_llvm_value_array_set(arr, 2, a2)
    forge_llvm_value_array_set(arr, 3, a3)
    let result = forge_llvm_build_call(ctx.builder, ft, fn_val, arr, 4, name)
    forge_llvm_value_array_free(arr)
    result
}

// Convenience: look up a function by name and call it with 1 arg.
export fn call_named_1(ctx: Ctx, name: string, a0: ptr, result_name: string) -> ptr {
    call_1(ctx, get_fn(ctx, name), a0, result_name)
}

// Allocate memory for structs, enums, with-expressions.
// Uses bump allocator (no free, no reuse, no corruption).
// malloc is still declared for array/map code that needs realloc.
export fn cg_malloc(ctx: Ctx, size: ptr) -> ptr {
    call_named_1(ctx, "forge_bump_alloc", size, "buf")
}

// Allocate a new basic block and position the builder at its end.
export fn new_bb(ctx: Ctx, name: string) -> ptr {
    forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, name)
}

// Shorthand for common constants.
export fn const_i64(ctx: Ctx, value: int) -> ptr {
    forge_llvm_const_int(ctx.i64_type, value, 0)
}

export fn const_i8(ctx: Ctx, value: int) -> ptr {
    forge_llvm_const_int(forge_llvm_int8_type(ctx.lc), value, 0)
}

// i64 ↔ ptr conversions (the bootstrap's value model).
export fn to_ptr(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_int_to_ptr(ctx.builder, val, ctx.ptr_type, name)
}

export fn to_i64(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_type, name)
}

// i64 ↔ f64 conversions (float values stored as bitcast i64).
export fn to_f64(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_bitcast(ctx.builder, val, forge_llvm_double_type(ctx.lc), name)
}

export fn f64_to_i64(ctx: Ctx, val: ptr, name: string) -> ptr {
    forge_llvm_build_bitcast(ctx.builder, val, ctx.i64_type, name)
}
