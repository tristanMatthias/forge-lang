// WHY: main LLVM IR emission — three-pass compilation:
//   1. Declare all types, globals, and function signatures
//   2. Emit function bodies
//   3. Emit top-level statements into main()
// Feature-specific codegen lives in features/*/codegen.fg and is
// resolved globally by the host compiler's cross-file impl lookup.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, Pattern, MatchArmList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length, field_list_length, field_init_length, field_index_of, field_type_of, variant_lookup, variant_max_payload, ValueType, vtype_eq, vtype_is_str, vtype_is_list, vtype_is_fn, vtype_list_elem, vtype_struct_name, vtype_enum_name, vtype_display, SStmt, SExpr, sexpr_dummy, stmt_unwrap}
use core.cg.{Ctx, EmitResult, StmtResult, null_ptr_val, ok_emit, ok_emit_str, ok_emit_typed, err_emit, ok_stmt, err_stmt, err_stmt_from_expr, advance_field_list, field_type_at, EnumLookup, StructLookup, StructReg, EnumReg, FnRetTypes, FnParamTypes, ParamTypeList, TopLevelVars, LoopStack, DeferStack, TopLevelLookup, LoopFrame, TraitDeclReg, TraitMethodNames, enum_reg_lookup, struct_reg_lookup, fn_ret_lookup, fn_param_lookup, param_type_at, toplevel_lookup, loops_top, trait_decl_lookup, trait_decl_has, translate_param_type, translate_type_ctx, new_bb, const_i64, const_i8, to_ptr, to_i64, get_fn, call_0, call_1, call_2, call_3, call_4, call_named_1, cg_malloc, ctx_with_defers}
use core.registry.{build_registry, dispatch_expr_emit, dispatch_stmt_emit, forge_expr_tag, forge_stmt_tag}

// ── Direct C extern declarations ──
//
// The bootstrap codegen calls a small set of LLVM-C-API wrappers
// (the `forge_llvm_*` symbols exposed by the @std.llvm package's
// native library) plus a handful of libc helpers. We declare them
// directly as `extern fn` so the bootstrap source has no
// dependence on the host's package namespace dispatch — it just
// calls C symbols.
//
// We keep the local helper names matching the old `llvm.X` shape
// (e.g. `bs_llvm_context_create`) so the rest of this file reads
// the same as before; the helpers are thin wrappers over the
// underlying C symbols.








// ── Public API ──

export type CodegenResult = {
    had_error: bool,
    error_message: string,
}

// Shared types (Ctx, EmitResult, StmtResult, registries, helpers)
// live in core/cg.fg and are imported at the top of this file.

export fn compile_program(stmts: StmtList, output_path: string, debug_null_checks: bool, source_file: string) -> CodegenResult {
    let lc = forge_llvm_context_create()
    let m = forge_llvm_module_create("bootstrap", lc)
    let builder = forge_llvm_create_builder(lc)

    let i64t = forge_llvm_int64_type(lc)
    let i1t = forge_llvm_int1_type(lc)
    let pt = forge_llvm_pointer_type(lc)

    // Declare libc helpers we lower string ops onto.
    //   puts(ptr) -> i32        — for println(str)
    //   strlen(ptr) -> i64
    //   malloc(i64) -> ptr
    //   memcpy(ptr, ptr, i64) -> ptr
    let puts_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(puts_param_arr, 0, pt)
    let puts_type = forge_llvm_function_type(forge_llvm_int32_type(lc), puts_param_arr, 1, 0)
    forge_llvm_type_array_free(puts_param_arr)
    forge_llvm_add_function(m, "puts", puts_type)

    // forge_eprintln(ptr) -> void — write string + newline to stderr
    let eprint_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(eprint_param_arr, 0, pt)
    let eprint_type = forge_llvm_function_type(forge_llvm_void_type(lc), eprint_param_arr, 1, 0)
    forge_llvm_type_array_free(eprint_param_arr)
    forge_llvm_add_function(m, "forge_eprintln", eprint_type)

    let strlen_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(strlen_param_arr, 0, pt)
    let strlen_type = forge_llvm_function_type(i64t, strlen_param_arr, 1, 0)
    forge_llvm_type_array_free(strlen_param_arr)
    forge_llvm_add_function(m, "strlen", strlen_type)

    let malloc_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(malloc_param_arr, 0, i64t)
    let malloc_type = forge_llvm_function_type(pt, malloc_param_arr, 1, 0)
    forge_llvm_type_array_free(malloc_param_arr)
    forge_llvm_add_function(m, "malloc", malloc_type)

    // Bump allocator — used by cg_malloc for struct/enum/with allocations.
    // Same signature as malloc: (i64) -> ptr
    let bump_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(bump_param_arr, 0, i64t)
    let bump_type = forge_llvm_function_type(pt, bump_param_arr, 1, 0)
    forge_llvm_type_array_free(bump_param_arr)
    forge_llvm_add_function(m, "forge_bump_alloc", bump_type)

    let memcpy_param_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(memcpy_param_arr, 0, pt)
    forge_llvm_type_array_set(memcpy_param_arr, 1, pt)
    forge_llvm_type_array_set(memcpy_param_arr, 2, i64t)
    let memcpy_type = forge_llvm_function_type(pt, memcpy_param_arr, 3, 0)
    forge_llvm_type_array_free(memcpy_param_arr)
    forge_llvm_add_function(m, "memcpy", memcpy_type)

    let strcmp_param_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(strcmp_param_arr, 0, pt)
    forge_llvm_type_array_set(strcmp_param_arr, 1, pt)
    let strcmp_type = forge_llvm_function_type(forge_llvm_int32_type(lc), strcmp_param_arr, 2, 0)
    forge_llvm_type_array_free(strcmp_param_arr)
    forge_llvm_add_function(m, "strcmp", strcmp_type)

    // snprintf(buf, size, fmt, ...) declared as variadic for the
    // string() builtin's int → str conversion.
    let snprintf_param_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(snprintf_param_arr, 0, pt)
    forge_llvm_type_array_set(snprintf_param_arr, 1, i64t)
    forge_llvm_type_array_set(snprintf_param_arr, 2, pt)
    let snprintf_type = forge_llvm_function_type(forge_llvm_int32_type(lc), snprintf_param_arr, 3, 1)
    forge_llvm_type_array_free(snprintf_param_arr)
    forge_llvm_add_function(m, "snprintf", snprintf_type)

    // atoi(str) -> i32 for the int() builtin.
    let atoi_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(atoi_param_arr, 0, pt)
    let atoi_type = forge_llvm_function_type(forge_llvm_int32_type(lc), atoi_param_arr, 1, 0)
    forge_llvm_type_array_free(atoi_param_arr)
    forge_llvm_add_function(m, "atoi", atoi_type)

    // exit(int) for process.exit
    let exit_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(exit_param_arr, 0, forge_llvm_int32_type(lc))
    let exit_type = forge_llvm_function_type(forge_llvm_void_type(lc), exit_param_arr, 1, 0)
    forge_llvm_type_array_free(exit_param_arr)
    forge_llvm_add_function(m, "exit", exit_type)

    // forge_null_arg_check(fn_name: ptr, fn_len: i64, param_name: ptr, param_len: i64, is_null: i64) -> void
    // Called in debug mode to check for null arguments at function entry.
    // The check is done C-side so we don't need to create basic blocks in the IR.
    let null_check_arr = forge_llvm_type_array_new(5)
    forge_llvm_type_array_set(null_check_arr, 0, pt)
    forge_llvm_type_array_set(null_check_arr, 1, i64t)
    forge_llvm_type_array_set(null_check_arr, 2, pt)
    forge_llvm_type_array_set(null_check_arr, 3, i64t)
    forge_llvm_type_array_set(null_check_arr, 4, i64t)
    let null_check_type = forge_llvm_function_type(forge_llvm_void_type(lc), null_check_arr, 5, 0)
    forge_llvm_type_array_free(null_check_arr)
    forge_llvm_add_function(m, "forge_null_arg_check", null_check_type)

    // forge_null_deref_trap(field: ptr, field_len: i64, type_name: ptr, type_len: i64, is_null: i64, file: ptr, file_len: i64, line: i64) -> void
    // Called on every field access / method call to catch null pointer dereferences.
    // Branchless: the C function checks is_null internally.
    let null_deref_arr = forge_llvm_type_array_new(8)
    forge_llvm_type_array_set(null_deref_arr, 0, pt)
    forge_llvm_type_array_set(null_deref_arr, 1, i64t)
    forge_llvm_type_array_set(null_deref_arr, 2, pt)
    forge_llvm_type_array_set(null_deref_arr, 3, i64t)
    forge_llvm_type_array_set(null_deref_arr, 4, i64t)
    forge_llvm_type_array_set(null_deref_arr, 5, pt)
    forge_llvm_type_array_set(null_deref_arr, 6, i64t)
    forge_llvm_type_array_set(null_deref_arr, 7, i64t)
    let null_deref_type = forge_llvm_function_type(forge_llvm_void_type(lc), null_deref_arr, 8, 0)
    forge_llvm_type_array_free(null_deref_arr)
    forge_llvm_add_function(m, "forge_null_deref_trap", null_deref_type)

    // forge_div_by_zero_trap(is_zero: i64, file: ptr, file_len: i64, line: i64) -> void
    // Called before every sdiv/srem to catch division by zero.
    // Branchless: the C function checks is_zero internally.
    let div_zero_arr = forge_llvm_type_array_new(4)
    forge_llvm_type_array_set(div_zero_arr, 0, i64t)
    forge_llvm_type_array_set(div_zero_arr, 1, pt)
    forge_llvm_type_array_set(div_zero_arr, 2, i64t)
    forge_llvm_type_array_set(div_zero_arr, 3, i64t)
    let div_zero_type = forge_llvm_function_type(forge_llvm_void_type(lc), div_zero_arr, 4, 0)
    forge_llvm_type_array_free(div_zero_arr)
    forge_llvm_add_function(m, "forge_div_by_zero_trap", div_zero_type)

    // C-runtime: dynamic arrays (forge_array_*)
    let arr_new_type = forge_llvm_function_type(pt, forge_llvm_type_array_new(0), 0, 0)
    forge_llvm_add_function(m, "forge_array_new", arr_new_type)

    let arr_push_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(arr_push_arr, 0, pt)
    forge_llvm_type_array_set(arr_push_arr, 1, i64t)
    let arr_push_type = forge_llvm_function_type(forge_llvm_void_type(lc), arr_push_arr, 2, 0)
    forge_llvm_type_array_free(arr_push_arr)
    forge_llvm_add_function(m, "forge_array_push", arr_push_type)

    let arr_get_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(arr_get_arr, 0, pt)
    forge_llvm_type_array_set(arr_get_arr, 1, i64t)
    let arr_get_type = forge_llvm_function_type(i64t, arr_get_arr, 2, 0)
    forge_llvm_type_array_free(arr_get_arr)
    forge_llvm_add_function(m, "forge_array_get", arr_get_type)

    let arr_len_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(arr_len_arr, 0, pt)
    let arr_len_type = forge_llvm_function_type(i64t, arr_len_arr, 1, 0)
    forge_llvm_type_array_free(arr_len_arr)
    forge_llvm_add_function(m, "forge_array_len", arr_len_type)

    // forge_array_set(ptr, i64, i64) → void (3 args: arr, idx, val)
    let arr_set_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(arr_set_arr, 0, pt)
    forge_llvm_type_array_set(arr_set_arr, 1, i64t)
    forge_llvm_type_array_set(arr_set_arr, 2, i64t)
    let arr_set_type = forge_llvm_function_type(forge_llvm_void_type(lc), arr_set_arr, 3, 0)
    forge_llvm_type_array_free(arr_set_arr)
    forge_llvm_add_function(m, "forge_array_set", arr_set_type)
    forge_llvm_add_function(m, "forge_array_pop", arr_len_type)

    // forge_array_slice(ptr, i64, i64) → ptr
    let arr_slice_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(arr_slice_arr, 0, pt)
    forge_llvm_type_array_set(arr_slice_arr, 1, i64t)
    forge_llvm_type_array_set(arr_slice_arr, 2, i64t)
    let arr_slice_type = forge_llvm_function_type(pt, arr_slice_arr, 3, 0)
    forge_llvm_type_array_free(arr_slice_arr)
    forge_llvm_add_function(m, "forge_array_slice", arr_slice_type)

    // C-runtime: closure helpers
    // forge_closure_get_fn(i64) → i64
    // forge_closure_num_captures(i64) → i64
    // forge_closure_get_capture(i64, i64) → i64
    let cl_1_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(cl_1_arr, 0, i64t)
    let cl_i64_to_i64 = forge_llvm_function_type(i64t, cl_1_arr, 1, 0)
    forge_llvm_type_array_free(cl_1_arr)
    forge_llvm_add_function(m, "forge_closure_get_fn", cl_i64_to_i64)
    forge_llvm_add_function(m, "forge_closure_num_captures", cl_i64_to_i64)
    forge_llvm_add_function(m, "forge_closure_get_capture", arr_get_type)
    // Closure trampolines: (i64, i64...) → i64
    forge_llvm_add_function(m, "forge_closure_call_0", cl_i64_to_i64)

    let cl_2_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(cl_2_arr, 0, i64t)
    forge_llvm_type_array_set(cl_2_arr, 1, i64t)
    let cl_2_type = forge_llvm_function_type(i64t, cl_2_arr, 2, 0)
    forge_llvm_type_array_free(cl_2_arr)
    forge_llvm_add_function(m, "forge_closure_call_1", cl_2_type)

    let cl_3_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(cl_3_arr, 0, i64t)
    forge_llvm_type_array_set(cl_3_arr, 1, i64t)
    forge_llvm_type_array_set(cl_3_arr, 2, i64t)
    let cl_3_type = forge_llvm_function_type(i64t, cl_3_arr, 3, 0)
    forge_llvm_type_array_free(cl_3_arr)
    forge_llvm_add_function(m, "forge_closure_call_2", cl_3_type)

    let cl_4_arr = forge_llvm_type_array_new(4)
    forge_llvm_type_array_set(cl_4_arr, 0, i64t)
    forge_llvm_type_array_set(cl_4_arr, 1, i64t)
    forge_llvm_type_array_set(cl_4_arr, 2, i64t)
    forge_llvm_type_array_set(cl_4_arr, 3, i64t)
    let cl_4_type = forge_llvm_function_type(i64t, cl_4_arr, 4, 0)
    forge_llvm_type_array_free(cl_4_arr)
    forge_llvm_add_function(m, "forge_closure_call_3", cl_4_type)

    // C-runtime: higher-order list operations (map, filter, reduce, foreach)
    // All take (ptr arr, i64 fn_ptr) and return ptr or i64.
    let arr_ho_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(arr_ho_arr, 0, pt)
    forge_llvm_type_array_set(arr_ho_arr, 1, i64t)
    let arr_map_type = forge_llvm_function_type(pt, arr_ho_arr, 2, 0)
    forge_llvm_type_array_free(arr_ho_arr)
    forge_llvm_add_function(m, "forge_array_map", arr_map_type)
    forge_llvm_add_function(m, "forge_array_filter", arr_map_type)

    let arr_fe_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(arr_fe_arr, 0, pt)
    forge_llvm_type_array_set(arr_fe_arr, 1, i64t)
    let arr_fe_type = forge_llvm_function_type(forge_llvm_void_type(lc), arr_fe_arr, 2, 0)
    forge_llvm_type_array_free(arr_fe_arr)
    forge_llvm_add_function(m, "forge_array_foreach", arr_fe_type)

    let arr_red_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(arr_red_arr, 0, pt)
    forge_llvm_type_array_set(arr_red_arr, 1, i64t)
    forge_llvm_type_array_set(arr_red_arr, 2, i64t)
    let arr_reduce_type = forge_llvm_function_type(i64t, arr_red_arr, 3, 0)
    forge_llvm_type_array_free(arr_red_arr)
    forge_llvm_add_function(m, "forge_array_reduce", arr_reduce_type)

    // C-runtime: string methods
    let str2_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(str2_arr, 0, pt)
    forge_llvm_type_array_set(str2_arr, 1, pt)
    let str_str_to_i64 = forge_llvm_function_type(i64t, str2_arr, 2, 0)
    let str_str_to_str = forge_llvm_function_type(pt, str2_arr, 2, 0)
    forge_llvm_type_array_free(str2_arr)

    forge_llvm_add_function(m, "forge_str_contains", str_str_to_i64)
    forge_llvm_add_function(m, "forge_str_starts_with", str_str_to_i64)
    forge_llvm_add_function(m, "forge_str_ends_with", str_str_to_i64)
    forge_llvm_add_function(m, "forge_str_index_of", str_str_to_i64)
    forge_llvm_add_function(m, "forge_str_split", str_str_to_str)

    let str3_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(str3_arr, 0, pt)
    forge_llvm_type_array_set(str3_arr, 1, pt)
    forge_llvm_type_array_set(str3_arr, 2, pt)
    let str3_to_str = forge_llvm_function_type(pt, str3_arr, 3, 0)
    forge_llvm_type_array_free(str3_arr)
    forge_llvm_add_function(m, "forge_str_replace", str3_to_str)

    let str1_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(str1_arr, 0, pt)
    let str_to_str = forge_llvm_function_type(pt, str1_arr, 1, 0)
    forge_llvm_type_array_free(str1_arr)
    forge_llvm_add_function(m, "forge_str_trim", str_to_str)
    forge_llvm_add_function(m, "forge_str_to_upper", str_to_str)
    forge_llvm_add_function(m, "forge_str_to_lower", str_to_str)

    // C-runtime: hash maps
    let map_new_type = forge_llvm_function_type(pt, forge_llvm_type_array_new(0), 0, 0)
    forge_llvm_add_function(m, "forge_map_new_cstr", map_new_type)

    // map_set(ptr, ptr, i64) → void
    let map_set_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(map_set_arr, 0, pt)
    forge_llvm_type_array_set(map_set_arr, 1, pt)
    forge_llvm_type_array_set(map_set_arr, 2, i64t)
    let map_set_type = forge_llvm_function_type(forge_llvm_void_type(lc), map_set_arr, 3, 0)
    forge_llvm_type_array_free(map_set_arr)
    forge_llvm_add_function(m, "forge_map_set_cstr", map_set_type)

    // map_get(ptr, ptr) → i64
    forge_llvm_add_function(m, "forge_map_get_cstr", str_str_to_i64)
    forge_llvm_add_function(m, "forge_map_has_cstr", str_str_to_i64)

    // map_len(ptr) → i64, map_keys(ptr) → ptr
    forge_llvm_add_function(m, "forge_map_len_cstr", arr_len_type)

    let map_keys_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(map_keys_arr, 0, pt)
    let map_keys_type = forge_llvm_function_type(pt, map_keys_arr, 1, 0)
    forge_llvm_type_array_free(map_keys_arr)
    forge_llvm_add_function(m, "forge_map_keys_cstr", map_keys_type)

    // Int-keyed map: O(1) lookup by integer key (used for feature registry dispatch)
    forge_llvm_add_function(m, "forge_intmap_new", arr_new_type)
    let im_set_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(im_set_arr, 0, pt)
    forge_llvm_type_array_set(im_set_arr, 1, i64t)
    forge_llvm_type_array_set(im_set_arr, 2, i64t)
    let im_set_type = forge_llvm_function_type(forge_llvm_void_type(lc), im_set_arr, 3, 0)
    forge_llvm_type_array_free(im_set_arr)
    forge_llvm_add_function(m, "forge_intmap_set", im_set_type)
    forge_llvm_add_function(m, "forge_intmap_get", arr_get_type)
    forge_llvm_add_function(m, "forge_intmap_has", arr_get_type)

    // Float support: forge_float_parse(ptr) → i64, forge_float_to_string(i64) → ptr
    forge_llvm_add_function(m, "forge_float_parse", strlen_type)
    forge_llvm_add_function(m, "forge_float_to_string", cl_i64_to_i64)

    // Ptr ops
    forge_llvm_add_function(m, "forge_ptr_store_byte", im_set_type)
    forge_llvm_add_function(m, "forge_string_from_ptr", arr_get_type)

    // Trait objects
    forge_llvm_add_function(m, "forge_trait_object_new", arr_get_type)
    forge_llvm_add_function(m, "forge_trait_object_value", strlen_type)
    forge_llvm_add_function(m, "forge_trait_object_vtable", map_keys_type)

    // DateTime
    let noarg_i64_type = forge_llvm_function_type(i64t, forge_llvm_type_array_new(0), 0, 0)
    forge_llvm_add_function(m, "forge_datetime_now", noarg_i64_type)
    forge_llvm_add_function(m, "forge_datetime_format", arr_get_type)
    forge_llvm_add_function(m, "forge_datetime_year", strlen_type)
    forge_llvm_add_function(m, "forge_datetime_month", strlen_type)
    forge_llvm_add_function(m, "forge_datetime_day", strlen_type)
    forge_llvm_add_function(m, "forge_datetime_hour", strlen_type)
    forge_llvm_add_function(m, "forge_datetime_minute", strlen_type)
    forge_llvm_add_function(m, "forge_datetime_second", strlen_type)

    // JSON
    forge_llvm_add_function(m, "forge_json_stringify_int", map_keys_type)
    forge_llvm_add_function(m, "forge_json_stringify_string", map_keys_type)
    forge_llvm_add_function(m, "forge_json_stringify_bool", map_keys_type)
    forge_llvm_add_function(m, "forge_json_get_int", arr_get_type)
    forge_llvm_add_function(m, "forge_json_get_string", arr_get_type)
    forge_llvm_add_function(m, "forge_json_get_bool", arr_get_type)

    // Semver
    forge_llvm_add_function(m, "forge_semver_major", strlen_type)
    forge_llvm_add_function(m, "forge_semver_minor", strlen_type)
    forge_llvm_add_function(m, "forge_semver_patch", strlen_type)
    forge_llvm_add_function(m, "forge_semver_compare", arr_get_type)

    // Validation
    forge_llvm_add_function(m, "forge_validate_not_null", arr_get_type)
    forge_llvm_add_function(m, "forge_validate_positive", arr_get_type)
    forge_llvm_add_function(m, "forge_validate_not_empty", arr_get_type)

    // TOML
    forge_llvm_add_function(m, "forge_toml_get_string", arr_get_type)
    forge_llvm_add_function(m, "forge_toml_get_int", arr_get_type)
    forge_llvm_add_function(m, "forge_toml_get_bool", arr_get_type)

    // Concurrency
    forge_llvm_add_function(m, "forge_spawn", strlen_type)
    forge_llvm_add_function(m, "forge_thread_join", puts_type)
    forge_llvm_add_function(m, "forge_channel_new", arr_new_type)
    forge_llvm_add_function(m, "forge_channel_send", arr_push_type)
    forge_llvm_add_function(m, "forge_channel_recv", strlen_type)
    forge_llvm_add_function(m, "forge_channel_close", puts_type)

    forge_llvm_add_function(m, "forge_parallel_run", puts_type)
    forge_llvm_add_function(m, "forge_select", arr_get_type)
    forge_llvm_add_function(m, "forge_select_index", strlen_type)
    forge_llvm_add_function(m, "forge_select_value", strlen_type)

    // Spec test runtime
    forge_llvm_add_function(m, "forge_test_start_spec", puts_type)
    forge_llvm_add_function(m, "forge_test_end_spec", puts_type)
    forge_llvm_add_function(m, "forge_test_start_given", puts_type)
    forge_llvm_add_function(m, "forge_test_end_given", puts_type)
    forge_llvm_add_function(m, "forge_test_run_then", arr_get_type)
    forge_llvm_add_function(m, "forge_test_summary", puts_type)

    // Match fallthrough trap — called when no arm matches at runtime.
    // forge_match_unreachable(fn_name: ptr, tag: i64, file: ptr, line: i64) -> void
    let match_trap_arr = forge_llvm_type_array_new(4)
    forge_llvm_type_array_set(match_trap_arr, 0, pt)
    forge_llvm_type_array_set(match_trap_arr, 1, i64t)
    forge_llvm_type_array_set(match_trap_arr, 2, pt)
    forge_llvm_type_array_set(match_trap_arr, 3, i64t)
    let match_trap_type = forge_llvm_function_type(forge_llvm_void_type(lc), match_trap_arr, 4, 0)
    forge_llvm_type_array_free(match_trap_arr)
    forge_llvm_add_function(m, "forge_match_unreachable", match_trap_type)

    // Build the per-compile registries by walking the AST once.
    // These are threaded through Ctx as immutable data — no
    // mutable globals.
    let structs = declare_structs(lc, i64t, stmts, StructReg.End)
    let enums = declare_enums(lc, i64t, stmts, EnumReg.End)
    let trait_decls = collect_trait_decls(stmts, TraitDeclReg.End)
    let top_level_vars = declare_globals(m, lc, i64t, structs, enums, stmts, TopLevelVars.End)
    let fn_rets = declare_functions(m, lc, i64t, structs, enums, stmts, FnRetTypes.End)
    let fn_params = collect_fn_params(stmts, FnParamTypes.End)

    // Synthesize a wrapper function for the top-level non-function
    // statements. If the source already defines its own `fn main`,
    // use a different name (`__bs_top_level`) so we don't collide
    // — the user's main becomes the program entry point. Otherwise
    // we name the wrapper `main` so it serves as the entry.
    let user_main = forge_llvm_get_named_function(m, "main")
    let main_name = if user_main == null { "main" } else { "__bs_top_level" }
    let main_params = forge_llvm_type_array_new(0)
    let main_type = forge_llvm_function_type(i64t, main_params, 0, 0)
    forge_llvm_type_array_free(main_params)
    let main_fn = forge_llvm_add_function(m, main_name, main_type)

    let entry = forge_llvm_append_basic_block(lc, main_fn, "entry")
    forge_llvm_position_at_end(builder, entry)

    let ctx = Ctx {
        lc,
        module: m,
        builder,
        current_fn: main_fn,
        current_fn_name: main_name,
        i64_type: i64t,
        i1_type: i1t,
        ptr_type: pt,
        structs,
        enums,
        fn_rets,
        fn_params,
        top_level_vars,
        loops: LoopStack.End,
        defers: DeferStack.End,
        features: build_registry(),
        trait_decls,
        debug_null_checks,
        source_file,
        source_line: 0,
    }

    // Pass 2: emit each user-defined function's body, then emit
    // every non-function top-level statement into main.
    let body_result = emit_function_bodies(ctx, stmts)
    if body_result.had_error {
        forge_llvm_dispose_builder(builder)
        forge_llvm_module_dispose(m)
        forge_llvm_context_dispose(ctx.lc)
        return CodegenResult { had_error: true, error_message: body_result.error_message }
    }

    // After emitting any function bodies, the builder may be sitting
    // in a function-body block. Reposition it back at main's entry
    // before emitting top-level statements.
    forge_llvm_position_at_end(builder, entry)
    let initial: VarEnv = VarEnv.End
    let result = emit_top_level(ctx, initial, stmts)
    if result.had_error {
        forge_llvm_dispose_builder(builder)
        forge_llvm_module_dispose(m)
        forge_llvm_context_dispose(ctx.lc)
        return CodegenResult { had_error: true, error_message: result.error_message }
    }

    // Default return 0 if the program didn't end in an explicit return
    if forge_llvm_block_has_terminator(builder) == 0 {
        forge_llvm_build_ret(builder, forge_llvm_const_int(i64t, 0, 0))
    }

    // Verification is advisory — the bootstrap's everything-is-i64 model
    // produces benign type mismatches (i64 vs ptr) that LLVM flags but
    // llc compiles correctly. Don't block on verification failures.
    forge_llvm_verify_module_print(m)

    let write_result = forge_llvm_print_module_to_file(m, output_path)

    forge_llvm_dispose_builder(builder)
    forge_llvm_module_dispose(m)
    forge_llvm_context_dispose(ctx.lc)

    if write_result != 0 {
        return CodegenResult { had_error: true, error_message: "codegen error: failed to write IR to " + output_path }
    }

    CodegenResult { had_error: false, error_message: "" }
}

// ── Helpers ──


// ── Struct declaration pass ──

fn declare_structs(ctx: ptr, i64t: ptr, stmts: StmtList, reg: StructReg) -> StructReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .TypeDecl(name, fields) -> {
                    // Check for type operator: __base sentinel
                    let resolved_fields = resolve_type_operator(fields, reg)
                    let count = field_list_length(resolved_fields)
                    let field_arr = forge_llvm_type_array_new(count)
                    fill_i64_param_array(field_arr, i64t, 0, count)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, count, 0)
                    forge_llvm_type_array_free(field_arr)
                    StructReg.Node(name, resolved_fields, reg)
                }
                .Module(_, body) -> declare_structs(ctx, i64t, body, reg)
                _ -> reg
            }
            declare_structs(ctx, i64t, next, updated)
        }
    }
}

// ── Global declaration pass ──
//
// Top-level `let` and `mut` declarations become module-level LLVM
// globals (i64). Their initializers are deferred to a synthetic
// `bs_init_globals` function called from `main` at startup; the
// declaration pass only allocates the global slot itself, since
// initializers may reference user functions and structs that
// haven't been emitted yet.

fn declare_globals(m: ptr, ctx: ptr, i64t: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: TopLevelVars) -> TopLevelVars {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Let(name, ty, _) -> {
                    let g = forge_llvm_add_global(m, i64t, name)
                    forge_llvm_set_initializer(g, forge_llvm_const_int(i64t, 0, 0))
                    TopLevelVars.Node(name, g, translate_param_type(structs, enums, ty), reg)
                }
                .Mut(name, ty, _) -> {
                    let g = forge_llvm_add_global(m, i64t, name)
                    forge_llvm_set_initializer(g, forge_llvm_const_int(i64t, 0, 0))
                    TopLevelVars.Node(name, g, translate_param_type(structs, enums, ty), reg)
                }
                .Module(_, body) -> declare_globals(m, ctx, i64t, structs, enums, body, reg)
                _ -> reg
            }
            declare_globals(m, ctx, i64t, structs, enums, next, updated)
        }
    }
}

// ── Enum declaration pass ──

fn declare_enums(ctx: ptr, i64t: ptr, stmts: StmtList, reg: EnumReg) -> EnumReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .EnumDecl(name, variants) -> {
                    let max_fields = variant_max_payload(variants)
                    let total_fields = max_fields + 1
                    let field_arr = forge_llvm_type_array_new(total_fields)
                    forge_llvm_type_array_set(field_arr, 0, forge_llvm_int8_type(ctx))
                    fill_i64_param_array_offset(field_arr, i64t, 1, max_fields)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, total_fields, 0)
                    forge_llvm_type_array_free(field_arr)
                    EnumReg.Node(name, variants, reg)
                }
                .Module(_, body) -> declare_enums(ctx, i64t, body, reg)
                _ -> reg
            }
            declare_enums(ctx, i64t, next, updated)
        }
    }
}

fn collect_trait_decls(stmts: StmtList, reg: TraitDeclReg) -> TraitDeclReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .TraitDecl(name, methods) -> TraitDeclReg.Node(name, collect_trait_fn_names(methods), reg)
                .Module(_, body) -> collect_trait_decls(body, reg)
                _ -> reg
            }
            collect_trait_decls(next, updated)
        }
    }
}

fn collect_trait_fn_names(stmts: StmtList) -> TraitMethodNames {
    match stmts {
        .End -> TraitMethodNames.End
        .Node(ss, next) -> {
            match stmt_unwrap(ss.node) {
                .ExternFn(name, _, ret_ty) -> TraitMethodNames.Node(name, ret_ty, collect_trait_fn_names(next))
                .Function(name, _, ret_ty, _) -> TraitMethodNames.Node(name, ret_ty, collect_trait_fn_names(next))
                _ -> collect_trait_fn_names(next)
            }
        }
    }
}

// Resolve type operator fields: if fields start with __base sentinel,
// look up base type and filter. Otherwise return fields unchanged.
fn resolve_type_operator(fields: FieldList, reg: StructReg) -> FieldList {
    match fields {
        .Node(name, base_name, rest) -> {
            if name == "__base" {
                match rest {
                    .Node(op_name, op, excluded_fields) -> {
                        let base_lookup = struct_reg_lookup(reg, base_name)
                        if !base_lookup.found { return FieldList.End }
                        if op == "without" {
                            return filter_fields_without(base_lookup.fields, excluded_fields)
                        }
                        if op == "only" {
                            return filter_fields_only(base_lookup.fields, excluded_fields)
                        }
                        base_lookup.fields
                    }
                    _ -> fields
                }
            } else {
                fields
            }
        }
        _ -> fields
    }
}

fn filter_fields_without(base: FieldList, excluded: FieldList) -> FieldList {
    match base {
        .End -> FieldList.End
        .Node(name, ty, next) -> {
            if field_list_has(excluded, name) {
                filter_fields_without(next, excluded)
            } else {
                FieldList.Node(name, ty, filter_fields_without(next, excluded))
            }
        }
    }
}

fn filter_fields_only(base: FieldList, included: FieldList) -> FieldList {
    match base {
        .End -> FieldList.End
        .Node(name, ty, next) -> {
            if field_list_has(included, name) {
                FieldList.Node(name, ty, filter_fields_only(next, included))
            } else {
                filter_fields_only(next, included)
            }
        }
    }
}

fn field_list_has(list: FieldList, target: string) -> bool {
    match list {
        .End -> false
        .Node(name, _, next) -> {
            if name == target { return true }
            field_list_has(next, target)
        }
    }
}

fn fill_i64_param_array_offset(arr: ptr, i64t: ptr, base: int, count: int) {
    if count <= 0 {
        return
    }
    forge_llvm_type_array_set(arr, base, i64t)
    fill_i64_param_array_offset(arr, i64t, base + 1, count - 1)
}

// ── Helpers: detect lambda returns in function bodies ──
//
// During the declaration pass we check if a function body's last
// expression is a Lambda. If so, we mark the return type as
// Closure(-1, ret_ty) — the -1 means "closure with unknown capture
// count." At the call site, vtype_is_closure returns true so the
// codegen knows to use the closure-aware call path (trampolines that
// handle captures at runtime).

// Get the last Expr from a StmtList. Returns Expr.Null if none found.
fn stmts_last_expr(stmts: StmtList) -> Expr {
    match stmts {
        .End -> Expr.Null
        .Node(ss, next) -> {
            match next {
                .End -> {
                    let inner = stmt_unwrap(ss.node)
                    match inner {
                        .Expr(e) -> e
                        .Return(e) -> e
                        _ -> Expr.Null
                    }
                }
                _ -> stmts_last_expr(next)
            }
        }
    }
}

// Compute the return type for a function. If the function body's last
// expression is a lambda, return Closure(-1, ret_ty) so call sites
// know the value is a closure array and use the trampoline path.
fn decl_fn_ret_type(structs: StructReg, enums: EnumReg, ret_ty: string, body: StmtList) -> ValueType {
    let base = translate_param_type(structs, enums, ret_ty)
    let last = stmts_last_expr(body)
    match last {
        .Lambda(_, _) -> {
            let inner_ret = vtype_fn_ret(base)
            ValueType.Closure(-1, inner_ret)
        }
        _ -> base
    }
}

// ── Function declaration pass ──

fn declare_functions(m: ptr, ctx: ptr, i64t: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: FnRetTypes) -> FnRetTypes {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Function(name, params, ret_ty, body) -> {
                    // Names are already qualified by the name resolution pass
                    let arity = param_list_length(params)
                    let existing = forge_llvm_get_named_function(m, name)
                    if existing != null {
                        eprintln("FATAL: duplicate function `" + name + "` — rename to avoid collision")
                        exit(1)
                    }
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_i64_param_array(param_arr, i64t, 0, arity)
                    let fn_type = forge_llvm_function_type(i64t, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    FnRetTypes.Node(name, decl_fn_ret_type(structs, enums, ret_ty, body), reg)
                }
                .ExternFn(name, params, ret_ty) -> {
                    let arity = param_list_length(params)
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_i64_param_array(param_arr, i64t, 0, arity)
                    let fn_type = forge_llvm_function_type(i64t, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    FnRetTypes.Node(name, translate_param_type(structs, enums, ret_ty), reg)
                }
                .Impl(_, methods) -> declare_functions(m, ctx, i64t, structs, enums, methods, reg)
                .Module(_, body) -> declare_functions(m, ctx, i64t, structs, enums, body, reg)
                _ -> reg
            }
            declare_functions(m, ctx, i64t, structs, enums, next, updated)
        }
    }
}

// Convert a ParamList to a ParamTypeList (list of type annotation strings).
fn params_to_type_list(params: ParamList) -> ParamTypeList {
    match params {
        .End -> ParamTypeList.End
        .Node(_, ty, next) -> ParamTypeList.Node(ty, params_to_type_list(next))
    }
}

// Collect parameter type annotations for all functions.
fn collect_fn_params(stmts: StmtList, reg: FnParamTypes) -> FnParamTypes {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Function(name, params, _, _) -> {
                    FnParamTypes.Node(name, params_to_type_list(params), reg)
                }
                .Impl(_, methods) -> collect_fn_params(methods, reg)
                .Module(_, body) -> collect_fn_params(body, reg)
                _ -> reg
            }
            collect_fn_params(next, updated)
        }
    }
}

fn fill_i64_param_array(arr: ptr, i64t: ptr, idx: int, count: int) {
    if idx >= count {
        return
    }
    forge_llvm_type_array_set(arr, idx, i64t)
    fill_i64_param_array(arr, i64t, idx + 1, count)
}

// ── Function body pass ──

// emit_function_bodies, emit_function_body, bind_params_inline → features/fn_decl/codegen.fg

// ── Top-level pass (skips function decls) ──

// TopLevelResult carries an updated Ctx so emit_top_level_init
// can thread updated top_level_vars forward without changing the
// StmtResult type (which would require updating ~50 call sites).
type TopLevelResult = {
    ctx: Ctx,
    env: VarEnv,
    had_error: bool,
    error_message: string,
}

fn emit_top_level(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let tl_ctx = ctx with { source_line: ss.line }
            let stmt = stmt_unwrap(ss.node)
            match stmt {
                .Function(_, _, _, _) -> emit_top_level(ctx, env, next)
                .Module(_, body) -> {
                    let r = emit_top_level(tl_ctx, env, body)
                    if r.had_error { return r }
                    emit_top_level(ctx, r.env, next)
                }
                .Let(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)
                    if result.had_error {
                        return err_stmt(result.error_message)
                    }
                    emit_top_level(result.ctx, result.env, next)
                }
                .Mut(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)
                    if result.had_error {
                        return err_stmt(result.error_message)
                    }
                    emit_top_level(result.ctx, result.env, next)
                }
                _ -> {
                    let result = emit_stmt(tl_ctx, env, stmt)
                    if result.had_error {
                        return result
                    }
                    emit_top_level(ctx, result.env, next)
                }
            }
        }
    }
}

fn emit_top_level_init(ctx: Ctx, env: VarEnv, name: string, init: Expr) -> TopLevelResult {
    let g = toplevel_lookup(ctx.top_level_vars, name)
    if !g.found {
        return TopLevelResult { ctx, env, had_error: true, error_message: "codegen error: global `" + name + "` not declared" }
    }
    let r = emit_expr(ctx, env, init)
    if r.had_error {
        return TopLevelResult { ctx, env, had_error: true, error_message: r.error_message }
    }
    forge_llvm_build_store(ctx.builder, r.value, g.llvm_global)
    let updated_top = TopLevelVars.Node(name, g.llvm_global, r.ty, ctx.top_level_vars)
    let updated_cg = ctx_with_top_level(ctx, updated_top)
    TopLevelResult { ctx: updated_cg, env, had_error: false, error_message: "" }
}

// ── Statement emission ──

fn emit_stmt_list(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let line_ctx = ctx with { source_line: ss.line }
            let result = emit_stmt(line_ctx, env, ss.node)
            if result.had_error {
                return result
            }
            emit_stmt_list(ctx, result.env, next)
        }
    }
}

export fn emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Expr(expr) -> {
            let r = emit_expr(ctx, env, expr)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            ok_stmt(env)
        }
        .Return(value) -> {
            let r = emit_expr(ctx, env, value)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            emit_defers(ctx, env)
            forge_llvm_build_ret(ctx.builder, r.value)
            ok_stmt(env)
        }
        .ReturnEmpty -> {
            emit_defers(ctx, env)
            forge_llvm_build_ret(ctx.builder, const_i64(ctx, 0))
            ok_stmt(env)
        }
        .Let(name, ty, initializer) -> emit_var_decl(ctx, env, name, ty, initializer)
        .Mut(name, ty, initializer) -> emit_var_decl(ctx, env, name, ty, initializer)
        .Block(body) -> {
            let inner = emit_stmt_list(ctx, env, body)
            if inner.had_error {
                return inner
            }
            // Block exits restore the outer scope.
            ok_stmt(env)
        }
        // Declaration statements: handled in pre-passes, no IR emitted
        .TypeDecl(_, _) -> ok_stmt(env)
        .EnumDecl(_, _) -> ok_stmt(env)
        .Impl(_, _) -> ok_stmt(env)
        .ExternFn(_, _, _) -> ok_stmt(env)
        .NoOp -> ok_stmt(env)
        .TraitDecl(_, _) -> ok_stmt(env)
        .Module(_, _) -> ok_stmt(env)
        .Use(_, _) -> ok_stmt(env)
        .Annotated(_, inner) -> emit_stmt(ctx, env, inner)
        // Loop control: must stay in core (needs access to LoopStack)
        .Break -> {
            let frame = loops_top(ctx.loops)
            if !frame.found {
                return err_stmt("codegen error: break outside loop")
            }
            forge_llvm_build_br(ctx.builder, frame.exit_bb)
            ok_stmt(env)
        }
        .Continue -> {
            let frame = loops_top(ctx.loops)
            if !frame.found {
                return err_stmt("codegen error: continue outside loop")
            }
            forge_llvm_build_br(ctx.builder, frame.cond_bb)
            ok_stmt(env)
        }
        // All other statement types dispatch through the feature registry.
        _ -> {
            let tag = forge_stmt_tag(stmt)
            let result = dispatch_stmt_emit(ctx.features, tag, ctx, env, stmt)
            if result != null {
                return result!
            }
            err_stmt("codegen error: unsupported statement type (tag=" + string(tag) + ")")
        }
    }
}

// ── Number literal parsing ──

fn strip_underscores(s: string) -> string {
    mut out = ""
    mut i = 0
    while i < s.length {
        if s[i] != "_" {
            out = out + s[i]
        }
        i = i + 1
    }
    out
}

fn parse_int_literal(text: string) -> int {
    let clean = strip_underscores(text)
    if clean.length > 2 {
        let prefix = clean.substring(0, 2)
        if prefix == "0x" || prefix == "0X" {
            return parse_hex(clean.substring(2, clean.length))
        }
        if prefix == "0b" || prefix == "0B" {
            return parse_binary(clean.substring(2, clean.length))
        }
        if prefix == "0o" || prefix == "0O" {
            return parse_octal(clean.substring(2, clean.length))
        }
    }
    int(clean)
}

fn hex_digit_value(ch: string) -> int {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    if ch == "a" || ch == "A" { return 10 }
    if ch == "b" || ch == "B" { return 11 }
    if ch == "c" || ch == "C" { return 12 }
    if ch == "d" || ch == "D" { return 13 }
    if ch == "e" || ch == "E" { return 14 }
    if ch == "f" || ch == "F" { return 15 }
    0
}

fn parse_hex(digits: string) -> int {
    mut result = 0
    mut i = 0
    while i < digits.length {
        result = result * 16 + hex_digit_value(digits[i])
        i = i + 1
    }
    result
}

fn parse_binary(digits: string) -> int {
    mut result = 0
    mut i = 0
    while i < digits.length {
        let ch = digits[i]
        if ch == "1" {
            result = result * 2 + 1
        } else {
            result = result * 2
        }
        i = i + 1
    }
    result
}

fn parse_octal(digits: string) -> int {
    mut result = 0
    mut i = 0
    while i < digits.length {
        result = result * 8 + decimal_digit_value(digits[i])
        i = i + 1
    }
    result
}

fn decimal_digit_value(ch: string) -> int {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    0
}

// ── Expression emission ──

export fn emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr {
        .Number(text) -> {
            let value = parse_int_literal(text)
            ok_emit(const_i64(ctx, value))
        }
        .FloatLit(text) -> {
            let str_ptr = forge_llvm_build_global_string_ptr(ctx.builder, text, ".float_str")
            let bits = call_1(ctx, get_fn(ctx, "forge_float_parse"), str_ptr, "float_bits")
            ok_emit_typed(bits, ValueType.Float)
        }
        .Bool(text) -> {
            if text == "true" {
                return ok_emit(const_i64(ctx, 1))
            }
            ok_emit(const_i64(ctx, 0))
        }
        .Null -> ok_emit(const_i64(ctx, 0))
        .String(text) -> {
            let inner = strip_quotes(text)
            let str_ptr = forge_llvm_build_global_string_ptr(ctx.builder, inner, ".str")
            ok_emit_str(to_i64(ctx, str_ptr, "str_i64"))
        }
        .Grouping(inner) -> emit_expr(ctx, env, inner)
        .Unary(op, right) -> emit_unary(ctx, env, op, right)
        .Binary(left, op, right) -> emit_binary(ctx, env, left, op, right)
        .Logical(left, op, right) -> emit_logical(ctx, env, left, op, right)
        .Ident(name) -> {
            let local = env_lookup(env, name)
            if local.found {
                let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, local.alloca, name)
                return EmitResult { value: loaded, ty: local.ty, had_error: false, error_message: "" }
            }
            let g = toplevel_lookup(ctx.top_level_vars, name)
            if g.found {
                let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, g.llvm_global, name)
                return EmitResult { value: loaded, ty: g.ty, had_error: false, error_message: "" }
            }
            // First-class function reference: wrap in closure array [TAG, fn_ptr]
            // so ALL callable values have the same representation. This means
            // call sites always use forge_closure_get_fn to extract the fn ptr,
            // and the same code handles named fn refs, lambdas, and closures.
            let fn_val = forge_llvm_get_named_function(ctx.module, name)
            if fn_val != null {
                let fn_i64 = forge_llvm_build_ptr_to_int(ctx.builder, fn_val, ctx.i64_type, "fn_ref")
                let arr_fn = get_fn(ctx, "forge_array_new")
                let push_fn = get_fn(ctx, "forge_array_push")
                let closure_arr = call_0(ctx, arr_fn, "fn_wrap")
                call_2(ctx, push_fn, closure_arr, const_i64(ctx, -559038737), "")
                call_2(ctx, push_fn, closure_arr, fn_i64, "")
                let closure_i64 = to_i64(ctx, closure_arr, "fn_ref_i64")
                let ret_ty = fn_ret_lookup(ctx.fn_rets, name)
                return ok_emit_typed(closure_i64, ValueType.Closure(0, ret_ty))
            }
            err_emit("undefined variable `" + name + "`")
        }
        .QualifiedIdent(path) -> {
            let local = env_lookup(env, path)
            if local.found {
                let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, local.alloca, path)
                return EmitResult { value: loaded, ty: local.ty, had_error: false, error_message: "" }
            }
            let g = toplevel_lookup(ctx.top_level_vars, path)
            if g.found {
                let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, g.llvm_global, path)
                return EmitResult { value: loaded, ty: g.ty, had_error: false, error_message: "" }
            }
            let fn_val = forge_llvm_get_named_function(ctx.module, path)
            if fn_val != null {
                let fn_i64 = forge_llvm_build_ptr_to_int(ctx.builder, fn_val, ctx.i64_type, "fn_ref")
                let arr_fn = get_fn(ctx, "forge_array_new")
                let push_fn = get_fn(ctx, "forge_array_push")
                let closure_arr = call_0(ctx, arr_fn, "fn_wrap")
                call_2(ctx, push_fn, closure_arr, const_i64(ctx, -559038737), "")
                call_2(ctx, push_fn, closure_arr, fn_i64, "")
                let closure_i64 = to_i64(ctx, closure_arr, "fn_ref_i64")
                let ret_ty = fn_ret_lookup(ctx.fn_rets, path)
                return ok_emit_typed(closure_i64, ValueType.Closure(0, ret_ty))
            }
            err_emit("undefined qualified name `" + path + "`")
        }
        .Assign(name, value) -> {
            let r = emit_expr(ctx, env, value)
            if r.had_error {
                return r
            }
            let local = env_lookup(env, name)
            if local.found {
                forge_llvm_build_store(ctx.builder, r.value, local.alloca)
                return EmitResult { value: r.value, ty: local.ty, had_error: false, error_message: "" }
            }
            let g = toplevel_lookup(ctx.top_level_vars, name)
            if g.found {
                forge_llvm_build_store(ctx.builder, r.value, g.llvm_global)
                return EmitResult { value: r.value, ty: g.ty, had_error: false, error_message: "" }
            }
            err_emit("assignment to undefined variable `" + name + "`")
        }
        .Call(callee, args) -> emit_call(ctx, env, callee, args)
        // Core expression types that don't warrant a feature directory
        .Index(obj, idx) -> emit_index(ctx, env, obj, idx)
        .Block(body) -> emit_block_expr(ctx, env, body)
        .Slice(obj, start, end) -> emit_slice(ctx, env, obj, start, end)
        // All other expression types dispatch through the feature registry.
        _ -> {
            let tag = forge_expr_tag(expr)
            let result = dispatch_expr_emit(ctx.features, tag, ctx, env, expr)
            if result != null {
                return result!
            }
            err_emit("unsupported expression type (tag=" + string(tag) + ")")
        }
    }
}

// emit_is_check moved to features/is_keyword/codegen.fg

// emit_if_expr moved to features/if_stmt/codegen.fg

// emit_field_assign moved to features/struct_decl/codegen.fg

fn emit_block_expr(ctx: Ctx, env: VarEnv, stmts: StmtList) -> EmitResult {
    // A block expression's value is the value of the LAST
    // statement, if that statement is a `Stmt.Expr`. Anything
    // else (return, let, while, ...) yields i64 0. Each non-last
    // statement is executed for its side effects.
    emit_block_loop(ctx, env, stmts, const_i64(ctx, 0), ValueType.Int)
}

// A statement in tail position of a block expression must yield a
// value, even when the parser modeled it as a Stmt rather than an
// Expr. This dispatches each kind of "value-bearing" statement to the
// matching expression-emission helper, recursing through nested
// blocks/ifs as needed. Anything that has no value (let/while/return)
// falls through to emit_stmt and the caller's default last_val.
fn emit_stmt_as_value(ctx: Ctx, env: VarEnv, stmt: Stmt, last_val: ptr, last_ty: ValueType) -> EmitResult {
    match stmt {
        .Expr(e) -> emit_expr(ctx, env, e)
        .Block(body) -> emit_block_expr(ctx, env, body)
        .Match(subject, arms) -> emit_match_expr(ctx, env, subject, arms)
        .If(condition, then_branch, else_branch) -> emit_stmt_if_as_value(ctx, env, condition, then_branch, else_branch)
        _ -> {
            let s = emit_stmt(ctx, env, stmt)
            if s.had_error {
                return err_emit(s.error_message)
            }
            EmitResult { value: last_val, ty: last_ty, had_error: false, error_message: "" }
        }
    }
}

// Mirror of emit_if_expr for the case where the if was parsed as a
// statement (Stmt.If with Stmt branches) but appears in tail position
// of a block expression. We need to phi the branch values back out,
// recursing into emit_stmt_as_value so nested blocks/matches/ifs in
// the branches also propagate their values.
fn emit_stmt_if_as_value(ctx: Ctx, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> EmitResult {
    let cond = emit_expr(ctx, env, condition)
    if cond.had_error {
        return cond
    }
    let cond_i1 = forge_llvm_build_icmp(ctx.builder, 33, cond.value, const_i64(ctx, 0), "sif_cond")
    let then_bb = new_bb(ctx, "sif_then")
    let else_bb = new_bb(ctx, "sif_else")
    let merge_bb = new_bb(ctx, "sif_end")
    let result_slot = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, "sif_result")
    forge_llvm_build_store(ctx.builder, const_i64(ctx, 0), result_slot)
    forge_llvm_build_cond_br(ctx.builder, cond_i1, then_bb, else_bb)

    forge_llvm_position_at_end(ctx.builder, then_bb)
    let zero = const_i64(ctx, 0)
    let t = emit_stmt_as_value(ctx, env, then_branch, zero, ValueType.Int)
    if t.had_error {
        return t
    }
    if forge_llvm_block_has_terminator(ctx.builder) == 0 {
        forge_llvm_build_store(ctx.builder, t.value, result_slot)
        forge_llvm_build_br(ctx.builder, merge_bb)
    }

    forge_llvm_position_at_end(ctx.builder, else_bb)
    if else_branch != null {
        let e = emit_stmt_as_value(ctx, env, else_branch!, zero, ValueType.Int)
        if e.had_error {
            return e
        }
        if forge_llvm_block_has_terminator(ctx.builder) == 0 {
            forge_llvm_build_store(ctx.builder, e.value, result_slot)
            forge_llvm_build_br(ctx.builder, merge_bb)
        }
    } else {
        forge_llvm_build_br(ctx.builder, merge_bb)
    }

    forge_llvm_position_at_end(ctx.builder, merge_bb)
    let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, result_slot, "sif_val")
    EmitResult { value: loaded, ty: t.ty, had_error: false, error_message: "" }
}

export fn emit_block_loop(ctx: Ctx, env: VarEnv, stmts: StmtList, last_val: ptr, last_ty: ValueType) -> EmitResult {
    match stmts {
        .End -> EmitResult { value: last_val, ty: last_ty, had_error: false, error_message: "" }
        .Node(ss, next) -> {
            let line_ctx = ctx with { source_line: ss.line }
            match next {
                .End -> emit_stmt_as_value(line_ctx, env, ss.node, last_val, last_ty)
                _ -> {
                    let s = emit_stmt(line_ctx, env, ss.node)
                    if s.had_error {
                        return err_emit(s.error_message)
                    }
                    emit_block_loop(ctx, s.env, next, last_val, last_ty)
                }
            }
        }
    }
}

// Match codegen lives in features/match_expr/codegen.fg.

fn emit_index(ctx: Ctx, env: VarEnv, obj: Expr, idx: Expr) -> EmitResult {
    let r = emit_expr(ctx, env, obj)
    if r.had_error {
        return r
    }
    // Ptr indexing: ptr[i] → load byte at (ptr + i), returns int (0-255)
    if vtype_eq(r.ty, ValueType.Ptr) {
        let i_r = emit_expr(ctx, env, idx)
        if i_r.had_error { return i_r }
        let off = forge_llvm_build_add(ctx.builder, r.value, i_r.value, "ptr_off")
        let off_ptr = to_ptr(ctx, off, "ptr_idx")
        let byte = forge_llvm_build_load(ctx.builder, forge_llvm_int8_type(ctx.lc), off_ptr, "ptr_byte")
        return ok_emit(forge_llvm_build_zext(ctx.builder, byte, ctx.i64_type, "ptr_byte_ext"))
    }
    // List indexing: list[i] → forge_array_get(list, i)
    if vtype_is_list(r.ty) {
        let i_r = emit_expr(ctx, env, idx)
        if i_r.had_error { return i_r }
        let elem = call_2(ctx, get_fn(ctx, "forge_array_get"), r.value, i_r.value, "list_idx")
        return ok_emit_typed(elem, vtype_list_elem(r.ty))
    }
    if !vtype_is_str(r.ty) {
        return err_emit("indexing on non-string/list value (ty=" + vtype_display(r.ty) + ")")
    }
    let i_r = emit_expr(ctx, env, idx)
    if i_r.had_error {
        return i_r
    }
    // Allocate a 2-byte buffer (1 char + nul), copy the byte at
    // src+i, set buf[1]=0. Returns a fresh str.
    let src_int = r.value
    let off_int = forge_llvm_build_add(ctx.builder, src_int, i_r.value, "idx_off_int")
    let off_ptr = to_ptr(ctx, off_int, "idx_off")
    let byte = forge_llvm_build_load(ctx.builder, forge_llvm_int8_type(ctx.lc), off_ptr, "idx_byte")
    let buf = cg_malloc(ctx, const_i64(ctx, 2))
    forge_llvm_build_store(ctx.builder, byte, buf)
    // buf[1] = 0
    let buf_int = to_i64(ctx, buf, "idx_buf_int")
    let one = const_i64(ctx, 1)
    let nul_int = forge_llvm_build_add(ctx.builder, buf_int, one, "idx_nul_int")
    let nul_ptr = to_ptr(ctx, nul_int, "idx_nul")
    forge_llvm_build_store(ctx.builder, const_i8(ctx, 0), nul_ptr)
    let result_i64 = to_i64(ctx, buf, "idx_result")
    ok_emit_str(result_i64)
}

// emit_struct_lit, malloc_struct_bytes, fill_struct_fields → features/struct_decl/codegen.fg

// emit_field_access moved to features/struct_decl/codegen.fg
// emit_enum_ctor → features/enum_decl/codegen.fg


fn emit_call(ctx: Ctx, env: VarEnv, callee: Expr, args: ExprList) -> EmitResult {
    match callee {
        .Ident(name) -> emit_call_named(ctx, env, name, args)
        .QualifiedIdent(path) -> emit_call_named(ctx, env, path, args)
        .FieldAccess(obj, method) -> emit_method_call(ctx, env, obj, method, args)
        _ -> {
            // Expression callee: evaluate it and call indirectly.
            // All callable values are closure arrays, so route through
            // the closure call path which unpacks [TAG, fn_ptr, caps...].
            let callee_r = emit_expr(ctx, env, callee)
            if callee_r.had_error { return callee_r }
            let ret_ty = vtype_fn_ret(callee_r.ty)
            if vtype_is_closure(callee_r.ty) {
                let num_caps = vtype_closure_captures(callee_r.ty)
                if num_caps >= 0 {
                    return emit_closure_call_typed(ctx, env, callee_r.value, args, num_caps, ret_ty)
                }
            }
            // For values with Fn/FnTyped type (e.g. from intmap_get),
            // the runtime value is still a closure array — route
            // through indirect call which handles both representations.
            emit_indirect_call_typed(ctx, env, callee_r.value, args, ret_ty)
        }
    }
}

fn emit_method_call(ctx: Ctx, env: VarEnv, obj: Expr, method: string, args: ExprList) -> EmitResult {
    // Special-case `.length` and `.substring` on strings — these are
    // emitted via libc strlen / a custom substring helper rather than
    // dispatched as methods.
    let r = emit_expr(ctx, env, obj)
    if r.had_error {
        return r
    }
    if vtype_is_str(r.ty) {
        if method == "length" {
            let str_ptr = to_ptr(ctx, r.value, "len_arg")
            return ok_emit(call_1(ctx, get_fn(ctx, "strlen"), str_ptr, "strlen_call"))
        }
        if method == "substring" {
            return emit_substring(ctx, env, r.value, args)
        }
        // String methods backed by C runtime
        if method == "contains" || method == "starts_with" || method == "ends_with" || method == "index_of" {
            let arg_r = emit_single_arg(ctx, env, args)?
            let fn_name = "forge_str_" + method
            let str_ptr = to_ptr(ctx, r.value, "str_self")
            let arg_ptr = to_ptr(ctx, arg_r.value, "str_arg")
            return ok_emit(call_2(ctx, get_fn(ctx, fn_name), str_ptr, arg_ptr, method))
        }
        if method == "replace" {
            return emit_str_replace(ctx, env, r.value, args)
        }
        if method == "trim" {
            let str_ptr = to_ptr(ctx, r.value, "str_self")
            return ok_emit_str(to_i64(ctx, call_1(ctx, get_fn(ctx, "forge_str_trim"), str_ptr, "trimmed"), "trim_i64"))
        }
        if method == "to_upper" || method == "upper" {
            let str_ptr = to_ptr(ctx, r.value, "str_self")
            return ok_emit_str(to_i64(ctx, call_1(ctx, get_fn(ctx, "forge_str_to_upper"), str_ptr, "upper"), "upper_i64"))
        }
        if method == "to_lower" || method == "lower" {
            let str_ptr = to_ptr(ctx, r.value, "str_self")
            return ok_emit_str(to_i64(ctx, call_1(ctx, get_fn(ctx, "forge_str_to_lower"), str_ptr, "lower"), "lower_i64"))
        }
        if method == "split" {
            let arg_r = emit_single_arg(ctx, env, args)?
            let str_ptr = to_ptr(ctx, r.value, "str_self")
            let sep_ptr = to_ptr(ctx, arg_r.value, "sep_arg")
            let result = call_2(ctx, get_fn(ctx, "forge_str_split"), str_ptr, sep_ptr, "split_result")
            return EmitResult { value: result, ty: ValueType.List(ValueType.Str), had_error: false, error_message: "" }
        }
        if method == "char_code" {
            // str.char_code() → int (first byte as integer)
            let str_ptr = to_ptr(ctx, r.value, "str_self")
            let byte_val = forge_llvm_build_load(ctx.builder, forge_llvm_int8_type(ctx.lc), str_ptr, "char_byte")
            let as_i64 = forge_llvm_build_zext(ctx.builder, byte_val, ctx.i64_type, "char_code")
            return ok_emit(as_i64)
        }
        return err_emit("string method `" + method + "` not implemented")
    }
    // List methods backed by C runtime
    if vtype_is_list(r.ty) {
        if method == "length" || method == "len" {
            return ok_emit(call_1(ctx, get_fn(ctx, "forge_array_len"), r.value, "list_len"))
        }
        if method == "push" {
            let arg_r = emit_single_arg(ctx, env, args)?
            call_2(ctx, get_fn(ctx, "forge_array_push"), r.value, arg_r.value, "")
            return ok_emit(r.value)
        }
        if method == "pop" {
            return ok_emit(call_1(ctx, get_fn(ctx, "forge_array_pop"), r.value, "list_pop"))
        }
        if method == "get" {
            let arg_r = emit_single_arg(ctx, env, args)?
            let elem_ty = vtype_list_elem(r.ty)
            return ok_emit_typed(call_2(ctx, get_fn(ctx, "forge_array_get"), r.value, arg_r.value, "list_get"), elem_ty)
        }
        if method == "set" {
            // list.set(index, value) → forge_array_set(list, index, value)
            return emit_list_set(ctx, env, r.value, args)
        }
        if method == "map" {
            let elem_ty = vtype_list_elem(r.ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, TypeList.Node(elem_ty, TypeList.End))
            if arg_r.had_error { return arg_r }
            let result = call_2(ctx, get_fn(ctx, "forge_array_map"), r.value, arg_r.value, "map")
            // Map's return type is the lambda's return type, not the input element type
            let ret_ty = vtype_fn_ret(arg_r.ty)
            return EmitResult { value: result, ty: ValueType.List(ret_ty), had_error: false, error_message: "" }
        }
        if method == "filter" {
            let elem_ty = vtype_list_elem(r.ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, TypeList.Node(elem_ty, TypeList.End))
            if arg_r.had_error { return arg_r }
            let result = call_2(ctx, get_fn(ctx, "forge_array_filter"), r.value, arg_r.value, "filter")
            return EmitResult { value: result, ty: ValueType.List(elem_ty), had_error: false, error_message: "" }
        }
        if method == "foreach" {
            let elem_ty = vtype_list_elem(r.ty)
            let arg_r = emit_typed_lambda_arg(ctx, env, args, TypeList.Node(elem_ty, TypeList.End))
            if arg_r.had_error { return arg_r }
            call_2(ctx, get_fn(ctx, "forge_array_foreach"), r.value, arg_r.value, "")
            return ok_emit(const_i64(ctx, 0))
        }
        if method == "reduce" {
            let elem_ty = vtype_list_elem(r.ty)
            return emit_list_reduce_typed(ctx, env, r.value, args, elem_ty)
        }
        return err_emit("list method `" + method + "` not implemented")
    }
    // Map methods backed by C runtime
    if vtype_is_map(r.ty) {
        let map_ptr = to_ptr(ctx, r.value, "map_ptr")
        if method == "get" {
            let arg_r = emit_single_arg(ctx, env, args)?
            let key_ptr = to_ptr(ctx, arg_r.value, "map_key")
            return ok_emit(call_2(ctx, get_fn(ctx, "forge_map_get_cstr"), map_ptr, key_ptr, "map_get"))
        }
        if method == "has" {
            let arg_r = emit_single_arg(ctx, env, args)?
            let key_ptr = to_ptr(ctx, arg_r.value, "map_key")
            return ok_emit(call_2(ctx, get_fn(ctx, "forge_map_has_cstr"), map_ptr, key_ptr, "map_has"))
        }
        if method == "set" {
            return emit_map_set(ctx, env, map_ptr, args)
        }
        if method == "len" || method == "length" {
            return ok_emit(call_1(ctx, get_fn(ctx, "forge_map_len_cstr"), map_ptr, "map_len"))
        }
        if method == "keys" {
            let keys = call_1(ctx, get_fn(ctx, "forge_map_keys_cstr"), map_ptr, "map_keys")
            return ok_emit_typed(keys, ValueType.List(ValueType.Str))
        }
        return err_emit("map method `" + method + "` not implemented")
    }
    // Trait dispatch
    let tn = vtype_trait_name(r.ty)
    if tn != "" {
        return emit_trait_dispatch(ctx, env, r.value, tn, method, args)
    }
    // Otherwise: dispatch by type tag → `Type__method(obj, args)`.
    let type_name = vtype_struct_name(r.ty)
    let enum_name = vtype_enum_name(r.ty)
    let owner = if type_name != "" {
        type_name
    } else {
        enum_name
    }
    if owner == "" {
        return err_emit("method call on non-struct/enum value (ty=" + vtype_display(r.ty) + ")")
    }
    let mangled = owner + "__" + method
    let fn_val = forge_llvm_get_named_function(ctx.module, mangled)
    if fn_val == null {
        // Not a method — check if it's a struct field with fn type.
        // e.g. handler.action(25) where action: fn(int) -> int
        if type_name != "" {
            let s_lookup = struct_reg_lookup(ctx.structs, type_name)
            if s_lookup.found {
                let field_ty = translate_param_type(ctx.structs, ctx.enums, field_type_of(s_lookup.fields, method))
                if vtype_is_fn(field_ty) {
                    // Load the field value (fn pointer) and call indirectly
                    let st_ty = forge_llvm_get_type_by_name(ctx.lc, type_name)
                    let obj_ptr = to_ptr(ctx, r.value, "fn_field_obj")
                    let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, obj_ptr, field_index_of(s_lookup.fields, method), "fn_field_ptr")
                    let fn_i64 = forge_llvm_build_load(ctx.builder, ctx.i64_type, gep, "fn_field_val")
                    return emit_indirect_call_value(ctx, env, fn_i64, args)
                }
            }
        }
        return err_emit("undefined method `" + owner + "." + method + "`")
    }
    // Runtime null-pointer dereference check on method receiver (branchless).
    let mzero = const_i64(ctx, 0)
    let m_null_i1 = forge_llvm_build_icmp(ctx.builder, 32, r.value, mzero, "null_meth_chk")
    let m_null = forge_llvm_build_zext(ctx.builder, m_null_i1, ctx.i64_type, "null_meth_ext")
    let m_fld_str = forge_llvm_build_global_string_ptr(ctx.builder, method, "meth_name")
    let m_fld_len = const_i64(ctx, method.length)
    let m_ty_str = forge_llvm_build_global_string_ptr(ctx.builder, owner, "mowner_name")
    let m_ty_len = const_i64(ctx, owner.length)
    let m_file_str = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "msrc_file")
    let m_file_len = const_i64(ctx, ctx.source_file.length)
    let m_src_line = const_i64(ctx, ctx.source_line)
    let m_trap_fn = get_fn(ctx, "forge_null_deref_trap")
    let m_trap_ft = forge_llvm_fn_type_of(m_trap_fn)
    let m_trap_args = forge_llvm_value_array_new(8)
    forge_llvm_value_array_set(m_trap_args, 0, m_fld_str)
    forge_llvm_value_array_set(m_trap_args, 1, m_fld_len)
    forge_llvm_value_array_set(m_trap_args, 2, m_ty_str)
    forge_llvm_value_array_set(m_trap_args, 3, m_ty_len)
    forge_llvm_value_array_set(m_trap_args, 4, m_null)
    forge_llvm_value_array_set(m_trap_args, 5, m_file_str)
    forge_llvm_value_array_set(m_trap_args, 6, m_file_len)
    forge_llvm_value_array_set(m_trap_args, 7, m_src_line)
    forge_llvm_build_call(ctx.builder, m_trap_ft, m_trap_fn, m_trap_args, 8, "")
    forge_llvm_value_array_free(m_trap_args)

    // Build arg array with self prepended.
    let extra_count = expr_list_length(args)
    let arg_count = extra_count + 1
    let arg_arr = forge_llvm_value_array_new(arg_count)
    forge_llvm_value_array_set(arg_arr, 0, r.value)
    let fill = fill_arg_array(ctx, env, arg_arr, args, 1)
    if fill.had_error {
        forge_llvm_value_array_free(arg_arr)
        return fill
    }
    let param_arr = forge_llvm_type_array_new(arg_count)
    fill_i64_param_array(param_arr, ctx.i64_type, 0, arg_count)
    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arg_count, 0)
    forge_llvm_type_array_free(param_arr)
    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_val, arg_arr, arg_count, "methcall")
    forge_llvm_value_array_free(arg_arr)
    let ret_ty = fn_ret_lookup(ctx.fn_rets, mangled)
    ok_emit_typed(result, ret_ty)
}

fn trait_method_idx(methods: TraitMethodNames, name: string, idx: int) -> int {
    match methods {
        .End -> 0 - 1
        .Node(n, _, next) -> {
            if n == name { return idx }
            trait_method_idx(next, name, idx + 1)
        }
    }
}

// Look up the return type string for a trait method.
fn trait_method_ret_ty(methods: TraitMethodNames, name: string) -> string {
    match methods {
        .End -> ""
        .Node(n, ret, next) -> {
            if n == name { return ret }
            trait_method_ret_ty(next, name)
        }
    }
}

fn emit_trait_dispatch(ctx: Ctx, env: VarEnv, obj_val: ptr, trait_name: string, method: string, args: ExprList) -> EmitResult {
    let obj_ptr = to_ptr(ctx, obj_val, "tobj_ptr")
    let concrete = call_1(ctx, get_fn(ctx, "forge_trait_object_value"), obj_ptr, "concrete")
    let vtable = call_1(ctx, get_fn(ctx, "forge_trait_object_vtable"), obj_ptr, "vtable")
    let methods = trait_decl_lookup(ctx.trait_decls, trait_name)
    let idx = trait_method_idx(methods, method, 0)
    if idx < 0 {
        return err_emit("trait has no method `" + method + "`")
    }
    // Determine return type from trait declaration
    let ret_ty_str = trait_method_ret_ty(methods, method)
    let ret_ty = translate_type_ctx(ctx, ret_ty_str)
    let fn_closure = call_2(ctx, get_fn(ctx, "forge_array_get"), vtable, const_i64(ctx, idx), "vmethod")
    let user_count = expr_list_length(args)
    if user_count == 0 {
        return ok_emit_typed(call_2(ctx, get_fn(ctx, "forge_closure_call_1"), fn_closure, concrete, "tcall"), ret_ty)
    }
    // 1-arg case
    let first_arg = emit_first_arg(ctx, env, args)
    if first_arg.had_error { return first_arg }
    ok_emit_typed(call_3(ctx, get_fn(ctx, "forge_closure_call_2"), fn_closure, concrete, first_arg.value, "tcall"), ret_ty)
}

fn emit_first_arg(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("expected argument")
        .Node(se, _) -> emit_expr(ctx, env, se.node)
    }
}

fn emit_call_named(ctx: Ctx, env: VarEnv, name: string, args: ExprList) -> EmitResult {
    if name == "println" {
        return emit_println(ctx, env, args)
    }
    if name == "eprintln" {
        return emit_eprintln(ctx, env, args)
    }
    if name == "string" {
        return emit_int_to_string(ctx, env, args)
    }
    if name == "int" {
        return emit_string_to_int(ctx, env, args)
    }
    if name == "float" {
        return emit_string_to_float(ctx, env, args)
    }
    if name == "panic" {
        return emit_panic(ctx, env, args)
    }
    let fn_val = forge_llvm_get_named_function(ctx.module, name)
    if fn_val == null {
        // Not a named function — might be a lambda stored in a variable.
        let local = env_lookup(env, name)
        if local.found && vtype_is_fn(local.ty) {
            return emit_indirect_call(ctx, env, local.alloca, name, args)
        }
        let g = toplevel_lookup(ctx.top_level_vars, name)
        if g.found && vtype_is_fn(g.ty) {
            return emit_indirect_call_from_global(ctx, env, g.llvm_global, name, args, g.ty)
        }
        return err_emit("undefined function `" + name + "`")
    }

    let arg_count = expr_list_length(args)
    let arg_arr = forge_llvm_value_array_new(arg_count)
    let ptypes = fn_param_lookup(ctx.fn_params, name)
    let fill = fill_arg_array_boxing(ctx, env, arg_arr, args, ptypes, 0)
    if fill.had_error {
        forge_llvm_value_array_free(arg_arr)
        return fill
    }
    // All bootstrap functions have the same shape: (i64, i64, ...) -> i64.
    let param_arr = forge_llvm_type_array_new(arg_count)
    fill_i64_param_array(param_arr, ctx.i64_type, 0, arg_count)
    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arg_count, 0)
    forge_llvm_type_array_free(param_arr)

    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_val, arg_arr, arg_count, "calltmp")
    forge_llvm_value_array_free(arg_arr)
    let ret_ty = fn_ret_lookup(ctx.fn_rets, name)
    ok_emit_typed(result, ret_ty)
}

fn emit_int_to_string(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // string(i64) → str via snprintf into a 32-byte malloc'd buffer.
    match args {
        .End -> err_emit("string() expects 1 arg")
        .Node(se, _) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error {
                return r
            }
            // If the value is already a str, pass it through.
            if vtype_is_str(r.ty) {
                return r
            }
            // Float → string via forge_float_to_string(i64_bits) → ptr
            if vtype_eq(r.ty, ValueType.Float) {
                let str_ptr = call_1(ctx, get_fn(ctx, "forge_float_to_string"), r.value, "f2s")
                return ok_emit_str(to_i64(ctx, str_ptr, "f2s_i64"))
            }
            // Int → string via snprintf into a 32-byte malloc'd buffer.
            let buf = cg_malloc(ctx, const_i64(ctx, 32))
            let fmt = forge_llvm_build_global_string_ptr(ctx.builder, "%lld", ".i2s_fmt")
            call_4(ctx, get_fn(ctx, "snprintf"), buf, const_i64(ctx, 32), fmt, r.value, "")
            let result_i64 = to_i64(ctx, buf, "i2s_result")
            ok_emit_str(result_i64)
        }
    }
}

fn emit_string_to_int(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // int(str) → i64 via libc atoi.
    match args {
        .End -> err_emit("int() expects 1 arg")
        .Node(se, _) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error {
                return r
            }
            if !vtype_is_str(r.ty) {
                // Already an int — pass through.
                return r
            }
            let str_ptr = to_ptr(ctx, r.value, "atoi_arg")
            let result32 = call_1(ctx, get_fn(ctx, "atoi"), str_ptr, "atoi_call")
            // Sign-extend i32 → i64.
            ok_emit(forge_llvm_build_sext(ctx.builder, result32, ctx.i64_type, "atoi_ext"))
        }
    }
}

fn emit_string_to_float(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // float(str) → f64 bits via forge_float_parse.
    // float(int) → f64 bits via int-to-double cast + bitcast.
    match args {
        .End -> err_emit("float() expects 1 arg")
        .Node(se, _) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error { return r }
            if vtype_eq(r.ty, ValueType.Float) {
                return r
            }
            if vtype_is_str(r.ty) {
                let str_ptr = to_ptr(ctx, r.value, "f_parse_arg")
                return ok_emit_typed(call_1(ctx, get_fn(ctx, "forge_float_parse"), str_ptr, "f_bits"), ValueType.Float)
            }
            // Int → float: use sitofp + bitcast
            let dbl = forge_llvm_build_si_to_fp(ctx.builder, r.value, forge_llvm_double_type(ctx.lc), "i2f")
            ok_emit_typed(forge_llvm_build_bitcast(ctx.builder, dbl, ctx.i64_type, "f_bits"), ValueType.Float)
        }
    }
}

fn emit_panic(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("panic() expects 1 argument")
        .Node(se, _) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error { return r }
            // Print "panic: <message>" to stderr
            let prefix = forge_llvm_build_global_string_ptr(ctx.builder, "panic: ", ".panic_prefix")
            let prefix_i64 = to_i64(ctx, prefix, "prefix_i64")
            let msg = emit_concat(ctx, prefix_i64, r.value)
            let msg_ptr = to_ptr(ctx, msg.value, "panic_msg")
            let eprint_fn = get_fn(ctx, "forge_eprintln")
            let arr = forge_llvm_value_array_new(1)
            forge_llvm_value_array_set(arr, 0, msg_ptr)
            let void_type = forge_llvm_void_type(ctx.lc)
            let pa = forge_llvm_type_array_new(1)
            forge_llvm_type_array_set(pa, 0, ctx.ptr_type)
            let fn_type = forge_llvm_function_type(void_type, pa, 1, 0)
            forge_llvm_type_array_free(pa)
            forge_llvm_build_call(ctx.builder, fn_type, eprint_fn, arr, 1, "")
            forge_llvm_value_array_free(arr)
            // exit(1)
            call_1(ctx, get_fn(ctx, "exit"), const_i64(ctx, 1), "")
            // Unreachable — but return a value for the type system
            ok_emit(const_i64(ctx, 0))
        }
    }
}

fn emit_eprintln(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("eprintln() expects 1 arg")
        .Node(se, _) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error { return r }
            let str_val = if vtype_is_str(r.ty) {
                r.value
            } else if vtype_eq(r.ty, ValueType.Float) {
                let sp = call_1(ctx, get_fn(ctx, "forge_float_to_string"), r.value, "ef2s")
                to_i64(ctx, sp, "ef2s_i64")
            } else {
                // Convert to string first
                let buf = cg_malloc(ctx, const_i64(ctx, 32))
                let fmt = forge_llvm_build_global_string_ptr(ctx.builder, "%lld", ".eprint_fmt")
                call_4(ctx, get_fn(ctx, "snprintf"), buf, const_i64(ctx, 32), fmt, r.value, "")
                to_i64(ctx, buf, "eprint_str")
            }
            let str_ptr = to_ptr(ctx, str_val, "eprint_arg")
            let eprint_fn = get_fn(ctx, "forge_eprintln")
            let arr = forge_llvm_value_array_new(1)
            forge_llvm_value_array_set(arr, 0, str_ptr)
            let void_type = forge_llvm_void_type(ctx.lc)
            let pa = forge_llvm_type_array_new(1)
            forge_llvm_type_array_set(pa, 0, ctx.ptr_type)
            let fn_type = forge_llvm_function_type(void_type, pa, 1, 0)
            forge_llvm_type_array_free(pa)
            forge_llvm_build_call(ctx.builder, fn_type, eprint_fn, arr, 1, "")
            forge_llvm_value_array_free(arr)
            ok_emit(const_i64(ctx, 0))
        }
    }
}

fn emit_println(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // Special-case the most common shape: `println("literal")`. We
    // destructure straight to the inner string text in a single
    // match — going through any extra binding clobbers the payload
    // (host miscompilation, see TECH_DEBT.md #11).
    let str_i64 = match args {
        .Node(se, _) -> {
            match se.node {
                .String(text) -> {
                    let inner = strip_quotes(text)
                    let str_ptr = forge_llvm_build_global_string_ptr(ctx.builder, inner, ".str")
                    to_i64(ctx, str_ptr, "str_i64")
                }
                _ -> {
                    let r = emit_expr(ctx, env, se.node)
                    if r.had_error {
                        return r
                    }
                    if vtype_eq(r.ty, ValueType.Float) {
                        let sp = call_1(ctx, get_fn(ctx, "forge_float_to_string"), r.value, "f2s")
                        to_i64(ctx, sp, "f2s_i64")
                    } else {
                        r.value
                    }
                }
            }
        }
        .End -> {
            return err_emit("println expects 1 argument")
        }
    }
    let str_ptr2 = to_ptr(ctx, str_i64, "str_ptr")
    call_1(ctx, get_fn(ctx, "puts"), str_ptr2, "")
    ok_emit(const_i64(ctx, 0))
}

fn emit_concat(ctx: Ctx, lhs_i64: ptr, rhs_i64: ptr) -> EmitResult {
    let lhs_ptr = to_ptr(ctx, lhs_i64, "concat_l")
    let rhs_ptr = to_ptr(ctx, rhs_i64, "concat_r")

    let strlen_fn = get_fn(ctx, "strlen")
    let lhs_len = call_1(ctx, strlen_fn, lhs_ptr, "lhs_len")
    let rhs_len = call_1(ctx, strlen_fn, rhs_ptr, "rhs_len")

    let total = forge_llvm_build_add(ctx.builder, lhs_len, rhs_len, "concat_total")
    let one = const_i64(ctx, 1)
    let alloc_size = forge_llvm_build_add(ctx.builder, total, one, "concat_size")
    let buf = cg_malloc(ctx, alloc_size)

    let memcpy_fn = get_fn(ctx, "memcpy")
    call_3(ctx, memcpy_fn, buf, lhs_ptr, lhs_len, "")

    let buf_int = to_i64(ctx, buf, "buf_int")
    let dst2_int = forge_llvm_build_add(ctx.builder, buf_int, lhs_len, "dst2_int")
    let dst2 = to_ptr(ctx, dst2_int, "dst2")
    let rhs_len_plus_1 = forge_llvm_build_add(ctx.builder, rhs_len, one, "rhs_len_p1")
    call_3(ctx, memcpy_fn, dst2, rhs_ptr, rhs_len_plus_1, "")

    ok_emit_str(to_i64(ctx, buf, "concat_i64"))
}

fn emit_list_set(ctx: Ctx, env: VarEnv, list: ptr, args: ExprList) -> EmitResult {
    match args {
        .Node(se_idx, rest) -> {
            match rest {
                .Node(se_val, _) -> {
                    let idx_r = emit_expr(ctx, env, se_idx.node)
                    if idx_r.had_error { return idx_r }
                    let val_r = emit_expr(ctx, env, se_val.node)
                    if val_r.had_error { return val_r }
                    call_3(ctx, get_fn(ctx, "forge_array_set"), list, idx_r.value, val_r.value, "")
                    ok_emit(list)
                }
                _ -> err_emit("list.set expects 2 arguments: index and value")
            }
        }
        _ -> err_emit("list.set expects 2 arguments: index and value")
    }
}

fn emit_slice(ctx: Ctx, env: VarEnv, obj: Expr, start: Expr, end: Expr) -> EmitResult {
    let obj_r = emit_expr(ctx, env, obj)
    if obj_r.had_error { return obj_r }
    let start_r = emit_expr(ctx, env, start)
    if start_r.had_error { return start_r }
    let end_r = emit_expr(ctx, env, end)
    if end_r.had_error { return end_r }
    let result = call_3(ctx, get_fn(ctx, "forge_array_slice"), obj_r.value, start_r.value, end_r.value, "slice")
    ok_emit_typed(result, obj_r.ty)
}

fn emit_map_set(ctx: Ctx, env: VarEnv, map: ptr, args: ExprList) -> EmitResult {
    match args {
        .Node(se_key, rest) -> {
            match rest {
                .Node(se_val, _) -> {
                    let key_r = emit_expr(ctx, env, se_key.node)
                    if key_r.had_error { return key_r }
                    let val_r = emit_expr(ctx, env, se_val.node)
                    if val_r.had_error { return val_r }
                    let key_ptr = to_ptr(ctx, key_r.value, "set_key")
                    call_3(ctx, get_fn(ctx, "forge_map_set_cstr"), map, key_ptr, val_r.value, "")
                    ok_emit(map)
                }
                _ -> err_emit("map.set expects 2 arguments: key and value")
            }
        }
        _ -> err_emit("map.set expects 2 arguments: key and value")
    }
}



// Evaluate a single-argument method call. Returns the EmitResult for that arg.
fn emit_single_arg(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("expected 1 argument, got 0")
        .Node(se, _) -> emit_expr(ctx, env, se.node)
    }
}

fn emit_str_replace(ctx: Ctx, env: VarEnv, str_i64: ptr, args: ExprList) -> EmitResult {
    match args {
        .Node(se_from, rest) -> {
            match rest {
                .Node(se_to, _) -> {
                    let from_r = emit_expr(ctx, env, se_from.node)
                    if from_r.had_error { return from_r }
                    let to_r = emit_expr(ctx, env, se_to.node)
                    if to_r.had_error { return to_r }
                    let str_ptr = to_ptr(ctx, str_i64, "rep_self")
                    let from_ptr = to_ptr(ctx, from_r.value, "rep_from")
                    let to_ptr_v = to_ptr(ctx, to_r.value, "rep_to")
                    let result = call_3(ctx, get_fn(ctx, "forge_str_replace"), str_ptr, from_ptr, to_ptr_v, "replaced")
                    ok_emit_str(to_i64(ctx, result, "rep_i64"))
                }
                _ -> err_emit("replace expects 2 arguments")
            }
        }
        _ -> err_emit("replace expects 2 arguments")
    }
}

fn emit_substring(ctx: Ctx, env: VarEnv, str_i64: ptr, args: ExprList) -> EmitResult {
    // Expect exactly two integer args: start and end (exclusive).
    // Destructure exactly once — repeated `match args` corrupts
    // the inner payloads (host-compiler issue).
    match args {
        .End -> err_emit("substring expects 2 args, got 0")
        .Node(se_start, rest) -> {
            match rest {
                .End -> err_emit("substring expects 2 args, got 1")
                .Node(se_end, _) -> emit_substring_inner(ctx, env, str_i64, se_start.node, se_end.node)
            }
        }
    }
}

fn emit_substring_inner(ctx: Ctx, env: VarEnv, str_i64: ptr, start_arg: Expr, end_arg: Expr) -> EmitResult {
    let start_r = emit_expr(ctx, env, start_arg)
    if start_r.had_error {
        return start_r
    }
    let end_r = emit_expr(ctx, env, end_arg)
    if end_r.had_error {
        return end_r
    }
    let str_ptr = to_ptr(ctx, str_i64, "sub_src")
    let len = forge_llvm_build_sub(ctx.builder, end_r.value, start_r.value, "sub_len")
    let one = const_i64(ctx, 1)
    let alloc_size = forge_llvm_build_add(ctx.builder, len, one, "sub_alloc")
    // malloc(alloc_size)
    let buf = cg_malloc(ctx, alloc_size)
    // memcpy(buf, src + start, len)
    let src_int = to_i64(ctx, str_ptr, "sub_src_int")
    let off_int = forge_llvm_build_add(ctx.builder, src_int, start_r.value, "sub_off_int")
    let off_ptr = to_ptr(ctx, off_int, "sub_off")
    call_3(ctx, get_fn(ctx, "memcpy"), buf, off_ptr, len, "")
    // Null-terminate at buf[len].
    let buf_int2 = to_i64(ctx, buf, "sub_buf_int")
    let nul_int = forge_llvm_build_add(ctx.builder, buf_int2, len, "sub_nul_int")
    let nul_ptr = to_ptr(ctx, nul_int, "sub_nul")
    forge_llvm_build_store(ctx.builder, const_i8(ctx, 0), nul_ptr)
    let result_i64 = to_i64(ctx, buf, "sub_result")
    ok_emit_str(result_i64)
}

fn emit_str_cmp(ctx: Ctx, lhs_i64: ptr, rhs_i64: ptr, pred: int) -> EmitResult {
    // Lower string ordering ops (<, <=, >, >=) to a libc strcmp
    // call followed by a signed comparison of the result against
    // 0. We sign-extend strcmp's i32 result into i64 ourselves
    // because the host's build_icmp wrapper auto-promotes i32
    // operands via zero-extend, which would turn a negative
    // strcmp result into a huge positive i64 and break signed
    // comparison.
    let lhs_ptr = to_ptr(ctx, lhs_i64, "scmp_l")
    let rhs_ptr = to_ptr(ctx, rhs_i64, "scmp_r")
    let result32 = call_2(ctx, get_fn(ctx, "strcmp"), lhs_ptr, rhs_ptr, "strcmp_call")
    let result64 = forge_llvm_build_sext(ctx.builder, result32, ctx.i64_type, "strcmp_sext")
    let zero64 = const_i64(ctx, 0)
    let cmp = forge_llvm_build_icmp(ctx.builder, pred, result64, zero64, "scmp_cmp")
    ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "scmp_ext"))
}

fn emit_str_eq(ctx: Ctx, lhs_i64: ptr, rhs_i64: ptr, invert: bool) -> EmitResult {
    let lhs_ptr = to_ptr(ctx, lhs_i64, "streq_l")
    let rhs_ptr = to_ptr(ctx, rhs_i64, "streq_r")
    let result32 = call_2(ctx, get_fn(ctx, "strcmp"), lhs_ptr, rhs_ptr, "strcmp_call")
    // Sign-extend strcmp's i32 to i64 so the icmp operands match.
    let result64 = forge_llvm_build_sext(ctx.builder, result32, ctx.i64_type, "strcmp_sext")
    let zero64 = const_i64(ctx, 0)
    let pred = if invert { 33 } else { 32 }
    let cmp = forge_llvm_build_icmp(ctx.builder, pred, result64, zero64, "streq_cmp")
    ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "streq_ext"))
}

fn strip_quotes(s: string) -> string {
    let len = s.length
    if len < 2 {
        return s
    }
    s.substring(1, len - 1)
}

fn fill_arg_array(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(se, next) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error {
                return r
            }
            forge_llvm_value_array_set(arr, idx, r.value)
            fill_arg_array(ctx, env, arr, next, idx + 1)
        }
    }
}

// Like fill_arg_array but checks each parameter's declared type annotation.
// If the parameter expects a trait type and the argument is a concrete
// struct/enum, box the argument into a trait object before passing it.
fn fill_arg_array_boxing(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, ptypes: ParamTypeList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(se, next) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error {
                return r
            }
            let ptype_str = param_type_at(ptypes, idx)
            // Check if the parameter type is a trait and the argument is concrete
            let value = if ptype_str != "" && trait_decl_has(ctx.trait_decls, ptype_str) {
                let concrete_name = resolve_concrete_type_name(r.ty)
                if concrete_name != "" && !trait_decl_has(ctx.trait_decls, concrete_name) {
                    // The argument is a concrete type but the parameter expects a trait.
                    // Box the value into a trait object.
                    box_for_trait(ctx, r.value, ptype_str, concrete_name)
                } else {
                    // Already a trait object or same trait — pass through.
                    r.value
                }
            } else {
                r.value
            }
            forge_llvm_value_array_set(arr, idx, value)
            fill_arg_array_boxing(ctx, env, arr, next, ptypes, idx + 1)
        }
    }
}

// Resolve the concrete type name (struct or enum) from a ValueType.
fn resolve_concrete_type_name(ty: ValueType) -> string {
    let s = vtype_struct_name(ty)
    if s != "" { return s }
    let e = vtype_enum_name(ty)
    if e != "" { return e }
    ""
}

// Box a concrete value into a trait object for dynamic dispatch.
// Creates a vtable array with closure-wrapped method pointers, then
// calls forge_trait_object_new(value, vtable).
export fn box_for_trait(ctx: Ctx, value: ptr, trait_name: string, concrete_name: string) -> ptr {
    let methods = trait_decl_lookup(ctx.trait_decls, trait_name)
    let arr_fn = get_fn(ctx, "forge_array_new")
    let vtable = call_0(ctx, arr_fn, "vtable")
    push_vtable_entries_call(ctx, vtable, methods, concrete_name)
    let obj_val = call_2(ctx, get_fn(ctx, "forge_trait_object_new"), value, vtable, "tobj")
    to_i64(ctx, obj_val, "tobj_i64")
}

// Push closure-wrapped method pointers into a vtable array for trait boxing.
fn push_vtable_entries_call(ctx: Ctx, vtable: ptr, methods: TraitMethodNames, concrete_name: string) {
    match methods {
        .End -> {}
        .Node(method_name, _, next) -> {
            let mangled = concrete_name + "__" + method_name
            let fn_val = forge_llvm_get_named_function(ctx.module, mangled)
            let push_fn = get_fn(ctx, "forge_array_push")
            // Wrap in closure array: [TAG, fn_ptr]
            let closure = call_0(ctx, get_fn(ctx, "forge_array_new"), "vclosure")
            let tag = const_i64(ctx, -559038737)
            call_2(ctx, push_fn, closure, tag, "")
            let fn_i64 = forge_llvm_build_ptr_to_int(ctx.builder, fn_val, ctx.i64_type, "vfn_ptr")
            call_2(ctx, push_fn, closure, fn_i64, "")
            let closure_i64 = to_i64(ctx, closure, "vcl_i64")
            call_2(ctx, push_fn, vtable, closure_i64, "")
            push_vtable_entries_call(ctx, vtable, next, concrete_name)
        }
    }
}

fn emit_unary(ctx: Ctx, env: VarEnv, op: UnOp, right: Expr) -> EmitResult {
    let r = emit_expr(ctx, env, right)
    if r.had_error { return r }

    match op {
        .Neg -> {
            if vtype_eq(r.ty, ValueType.Float) {
                let fval = to_f64(ctx, r.value, "fneg_in")
                let neg = forge_llvm_build_fneg(ctx.builder, fval, "fneg")
                return ok_emit_typed(f64_to_i64(ctx, neg, "fneg_bits"), ValueType.Float)
            }
            ok_emit(forge_llvm_build_sub(ctx.builder, const_i64(ctx, 0), r.value, "neg"))
        }
        .Not -> {
            let cmp = forge_llvm_build_icmp(ctx.builder, 32, r.value, const_i64(ctx, 0), "not_cmp")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "not"))
        }
        .BitNot -> ok_emit(forge_llvm_build_not(ctx.builder, r.value, "bnot"))
    }
}

fn is_null_literal(e: Expr) -> bool {
    match e {
        .Null -> true
        _ -> false
    }
}

fn emit_binary(ctx: Ctx, env: VarEnv, left: Expr, op: BinOp, right: Expr) -> EmitResult {
    let left_result = emit_expr(ctx, env, left)
    if left_result.had_error { return left_result }
    let lhs = left_result.value

    let right_result = emit_expr(ctx, env, right)
    if right_result.had_error { return right_result }
    let rhs = right_result.value

    let null_cmp = is_null_literal(left) || is_null_literal(right)
    let is_str = vtype_is_str(left_result.ty) || vtype_is_str(right_result.ty)
    let is_float = vtype_eq(left_result.ty, ValueType.Float) || vtype_eq(right_result.ty, ValueType.Float)

    if is_float {
        return emit_float_binary(ctx, lhs, rhs, op, left_result.ty, right_result.ty)
    }

    let is_ptr = vtype_eq(left_result.ty, ValueType.Ptr) || vtype_eq(right_result.ty, ValueType.Ptr)

    match op {
        .Add -> {
            if is_str { return emit_concat(ctx, lhs, rhs) }
            if is_ptr { return ok_emit_typed(forge_llvm_build_add(ctx.builder, lhs, rhs, "ptr_add"), ValueType.Ptr) }
            ok_emit(forge_llvm_build_add(ctx.builder, lhs, rhs, "add"))
        }
        .Sub -> {
            if is_ptr { return ok_emit_typed(forge_llvm_build_sub(ctx.builder, lhs, rhs, "ptr_sub"), ValueType.Ptr) }
            ok_emit(forge_llvm_build_sub(ctx.builder, lhs, rhs, "sub"))
        }
        .Mul -> ok_emit(forge_llvm_build_mul(ctx.builder, lhs, rhs, "mul"))
        .Div -> {
            // Runtime division-by-zero check (branchless — C function checks internally).
            let zero = const_i64(ctx, 0)
            let is_zero_i1 = forge_llvm_build_icmp(ctx.builder, 32, rhs, zero, "div_zero_chk")
            let is_zero = forge_llvm_build_zext(ctx.builder, is_zero_i1, ctx.i64_type, "div_zero_ext")
            let dz_file = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "dz_file")
            let dz_flen = const_i64(ctx, ctx.source_file.length)
            let dz_line = const_i64(ctx, ctx.source_line)
            call_4(ctx, get_fn(ctx, "forge_div_by_zero_trap"), is_zero, dz_file, dz_flen, dz_line, "")
            ok_emit(forge_llvm_build_sdiv(ctx.builder, lhs, rhs, "div"))
        }
        .Mod -> {
            // Runtime division-by-zero check (branchless — C function checks internally).
            let zero = const_i64(ctx, 0)
            let is_zero_i1 = forge_llvm_build_icmp(ctx.builder, 32, rhs, zero, "mod_zero_chk")
            let is_zero = forge_llvm_build_zext(ctx.builder, is_zero_i1, ctx.i64_type, "mod_zero_ext")
            let mz_file = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "mz_file")
            let mz_flen = const_i64(ctx, ctx.source_file.length)
            let mz_line = const_i64(ctx, ctx.source_line)
            call_4(ctx, get_fn(ctx, "forge_div_by_zero_trap"), is_zero, mz_file, mz_flen, mz_line, "")
            ok_emit(forge_llvm_build_srem(ctx.builder, lhs, rhs, "mod"))
        }
        .BitAnd -> ok_emit(forge_llvm_build_and(ctx.builder, lhs, rhs, "band"))
        .BitOr -> ok_emit(forge_llvm_build_or(ctx.builder, lhs, rhs, "bor"))
        .BitXor -> ok_emit(forge_llvm_build_xor(ctx.builder, lhs, rhs, "bxor"))
        .Shl -> ok_emit(forge_llvm_build_shl(ctx.builder, lhs, rhs, "shl"))
        .Shr -> ok_emit(forge_llvm_build_ashr(ctx.builder, lhs, rhs, "shr"))
        .Eq -> {
            if !null_cmp && is_str { return emit_str_eq(ctx, lhs, rhs, false) }
            let cmp = forge_llvm_build_icmp(ctx.builder, 32, lhs, rhs, "eq")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "eq_ext"))
        }
        .Ne -> {
            if !null_cmp && is_str { return emit_str_eq(ctx, lhs, rhs, true) }
            let cmp = forge_llvm_build_icmp(ctx.builder, 33, lhs, rhs, "ne")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "ne_ext"))
        }
        .Lt -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 40) }
            let cmp = forge_llvm_build_icmp(ctx.builder, 40, lhs, rhs, "slt")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "slt_ext"))
        }
        .Le -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 41) }
            let cmp = forge_llvm_build_icmp(ctx.builder, 41, lhs, rhs, "sle")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "sle_ext"))
        }
        .Gt -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 38) }
            let cmp = forge_llvm_build_icmp(ctx.builder, 38, lhs, rhs, "sgt")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "sgt_ext"))
        }
        .Ge -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 39) }
            let cmp = forge_llvm_build_icmp(ctx.builder, 39, lhs, rhs, "sge")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "sge_ext"))
        }
    }
}

fn coerce_to_f64(ctx: Ctx, val: ptr, ty: ValueType) -> ptr {
    if vtype_eq(ty, ValueType.Float) {
        return to_f64(ctx, val, "f64")
    }
    // Int → float: sitofp
    forge_llvm_build_si_to_fp(ctx.builder, val, forge_llvm_double_type(ctx.lc), "i2f")
}

fn emit_float_binary(ctx: Ctx, lhs: ptr, rhs: ptr, op: BinOp, lty: ValueType, rty: ValueType) -> EmitResult {
    let fl = coerce_to_f64(ctx, lhs, lty)
    let fr = coerce_to_f64(ctx, rhs, rty)
    match op {
        .Add -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fadd(ctx.builder, fl, fr, "fadd"), "f_bits"), ValueType.Float)
        .Sub -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fsub(ctx.builder, fl, fr, "fsub"), "f_bits"), ValueType.Float)
        .Mul -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fmul(ctx.builder, fl, fr, "fmul"), "f_bits"), ValueType.Float)
        .Div -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fdiv(ctx.builder, fl, fr, "fdiv"), "f_bits"), ValueType.Float)
        .Mod -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_frem(ctx.builder, fl, fr, "frem"), "f_bits"), ValueType.Float)
        // fcmp ordered predicates: OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6
        .Eq -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 1, fl, fr, "feq")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "feq_ext"))
        }
        .Ne -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 6, fl, fr, "fne")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "fne_ext"))
        }
        .Lt -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 4, fl, fr, "flt")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "flt_ext"))
        }
        .Le -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 5, fl, fr, "fle")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "fle_ext"))
        }
        .Gt -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 2, fl, fr, "fgt")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "fgt_ext"))
        }
        .Ge -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 3, fl, fr, "fge")
            ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, "fge_ext"))
        }
        // Bitwise ops don't make sense for floats — fall through to int
        _ -> ok_emit(forge_llvm_build_add(ctx.builder, lhs, rhs, "add"))
    }
}

// Short-circuit evaluation for && and ||.
//
// For `a && b`:
//   evaluate a → to_bool → if false, result is 0, else evaluate b → to_bool
//
// For `a || b`:
//   evaluate a → to_bool → if true, result is 1, else evaluate b → to_bool
//
// Uses cond_br + phi to avoid evaluating the right side when unnecessary.
fn emit_logical(ctx: Ctx, env: VarEnv, left: Expr, op: LogicOp, right: Expr) -> EmitResult {
    let left_result = emit_expr(ctx, env, left)
    if left_result.had_error { return left_result }

    let l_bool = forge_llvm_build_icmp(ctx.builder, 33, left_result.value, const_i64(ctx, 0), "l_bool")
    let left_bb = forge_llvm_get_insert_block(ctx.builder)

    let rhs_bb = new_bb(ctx, "sc_rhs")
    let merge_bb = new_bb(ctx, "sc_merge")

    // &&: skip rhs if false. ||: skip rhs if true.
    match op {
        .And -> forge_llvm_build_cond_br(ctx.builder, l_bool, rhs_bb, merge_bb)
        .Or -> forge_llvm_build_cond_br(ctx.builder, l_bool, merge_bb, rhs_bb)
    }

    forge_llvm_position_at_end(ctx.builder, rhs_bb)
    let right_result = emit_expr(ctx, env, right)
    if right_result.had_error { return right_result }
    let r_bool = forge_llvm_build_icmp(ctx.builder, 33, right_result.value, const_i64(ctx, 0), "r_bool")
    let rhs_end_bb = forge_llvm_get_insert_block(ctx.builder)
    forge_llvm_build_br(ctx.builder, merge_bb)

    forge_llvm_position_at_end(ctx.builder, merge_bb)
    let phi = forge_llvm_build_phi(ctx.builder, forge_llvm_int1_type(ctx.lc), "sc_phi")

    let sc_val = match op {
        .And -> forge_llvm_const_int(forge_llvm_int1_type(ctx.lc), 0, 0)
        .Or -> forge_llvm_const_int(forge_llvm_int1_type(ctx.lc), 1, 0)
    }
    forge_llvm_add_incoming(phi, sc_val, left_bb)
    forge_llvm_add_incoming(phi, r_bool, rhs_end_bb)

    ok_emit(forge_llvm_build_zext(ctx.builder, phi, ctx.i64_type, "sc_ext"))
}
