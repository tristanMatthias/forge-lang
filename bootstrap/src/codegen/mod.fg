export mut RC_RELEASABLE: ReleasableSet = .End
export fn rc_set_releasable(rs: ReleasableSet) { RC_RELEASABLE = rs }
export fn rc_releasable_save() -> ReleasableSet { RC_RELEASABLE }
export fn rc_releasable_restore(saved: ReleasableSet) { RC_RELEASABLE = saved }
use core.registry.{build_registry, dispatch_expr_emit, dispatch_stmt_emit, forge_expr_tag, forge_stmt_tag, has_expr_emit, has_stmt_emit}
