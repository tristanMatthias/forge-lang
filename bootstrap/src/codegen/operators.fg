// WHY: codegen for operators — binary, unary, logical, float.

use core.ast.{Expr, ExprList, VarEnv, ValueType, BinOp, UnOp, LogicOp, vtype_eq, vtype_enum_name, vtype_is_str}
use codegen.types.{Ctx, EmitResult, ok_emit, ok_emit_typed, ok_emit_str, err_emit, const_i64, const_i8, to_ptr, to_i64, to_f64, f64_to_i64, new_bb, get_fn, call_2}
use codegen.{emit_expr}
use codegen.strings.{emit_concat, emit_str_eq, emit_str_cmp}
use codegen.helpers.{is_null_literal}
use features.enum_decl.codegen.{emit_enum_tag_cmp}

export fn emit_unary(ctx: Ctx, env: VarEnv, op: UnOp, right: Expr) -> EmitResult {
    let r = emit_expr(ctx, env, right)?

    match op {
        .Neg -> {
            if vtype_eq(r.ty, .Float) {
                let fval = to_f64(ctx, r.value, "fneg_in")
                let neg = forge_llvm_build_fneg(ctx.builder, fval, "fneg")
                return ok_emit_typed(f64_to_i64(ctx, neg, "fneg_bits"), .Float)
            }
            ok_emit(ctx.build_sub(const_i64(ctx, 0), r.value, "neg"))
        }
        .Not -> {
            ok_emit(ctx.icmp_eq(r.value, const_i64(ctx, 0), "not_cmp"))
        }
        .BitNot -> ok_emit(forge_llvm_build_not(ctx.builder, r.value, "bnot"))
    }
}

export fn emit_binary(ctx: Ctx, env: VarEnv, left: Expr, op: BinOp, right: Expr) -> EmitResult {
    let left_result = emit_expr(ctx, env, left)?
    let lhs = left_result.value

    let right_result = emit_expr(ctx, env, right)?
    let rhs = right_result.value

    let null_cmp = is_null_literal(left) || is_null_literal(right)
    let is_str = vtype_is_str(left_result.ty) || vtype_is_str(right_result.ty)
    let is_float = vtype_eq(left_result.ty, .Float) || vtype_eq(right_result.ty, .Float)

    if is_float {
        return emit_float_binary(ctx, lhs, rhs, op, left_result.ty, right_result.ty)
    }

    let is_ptr = vtype_eq(left_result.ty, .Ptr) || vtype_eq(right_result.ty, .Ptr)

    match op {
        .Add -> {
            if is_str { return emit_concat(ctx, lhs, rhs) }
            if is_ptr { return ok_emit_typed(ctx.build_add(lhs, rhs, "ptr_add"), .Ptr) }
            ok_emit(ctx.build_add(lhs, rhs, "add"))
        }
        .Sub -> {
            if is_ptr { return ok_emit_typed(ctx.build_sub(lhs, rhs, "ptr_sub"), .Ptr) }
            ok_emit(ctx.build_sub(lhs, rhs, "sub"))
        }
        .Mul -> ok_emit(forge_llvm_build_mul(ctx.builder, lhs, rhs, "mul"))
        .Div -> {
            // Runtime division-by-zero check (branchless — C function checks internally).
            let zero = const_i64(ctx, 0)
            let is_zero = ctx.icmp_eq(rhs, zero, "div_zero_chk")
            let dz_file = ctx.global_str(ctx.source_file, "dz_file")
            let dz_flen = const_i64(ctx, ctx.source_file.length)
            let dz_line = const_i64(ctx, ctx.source_line)
            call_4(ctx, get_fn(ctx, "forge_div_by_zero_trap"), is_zero, dz_file, dz_flen, dz_line, "")
            ok_emit(forge_llvm_build_sdiv(ctx.builder, lhs, rhs, "div"))
        }
        .Mod -> {
            // Runtime division-by-zero check (branchless — C function checks internally).
            let zero = const_i64(ctx, 0)
            let is_zero = ctx.icmp_eq(rhs, zero, "mod_zero_chk")
            let mz_file = ctx.global_str(ctx.source_file, "mz_file")
            let mz_flen = const_i64(ctx, ctx.source_file.length)
            let mz_line = const_i64(ctx, ctx.source_line)
            call_4(ctx, get_fn(ctx, "forge_div_by_zero_trap"), is_zero, mz_file, mz_flen, mz_line, "")
            ok_emit(forge_llvm_build_srem(ctx.builder, lhs, rhs, "mod"))
        }
        .BitAnd -> ok_emit(forge_llvm_build_and(ctx.builder, lhs, rhs, "band"))
        .BitOr -> ok_emit(ctx.build_or(lhs, rhs, "bor"))
        .BitXor -> ok_emit(forge_llvm_build_xor(ctx.builder, lhs, rhs, "bxor"))
        .Shl -> ok_emit(forge_llvm_build_shl(ctx.builder, lhs, rhs, "shl"))
        .Shr -> ok_emit(forge_llvm_build_ashr(ctx.builder, lhs, rhs, "shr"))
        .Eq -> {
            if !null_cmp && is_str { return emit_str_eq(ctx, lhs, rhs, false) }
            let is_enum = vtype_enum_name(left_result.ty) != "" && vtype_enum_name(right_result.ty) != ""
            if is_enum { return emit_enum_tag_cmp(ctx, lhs, rhs, left_result.ty, 32) }
            ok_emit(ctx.icmp_eq(lhs, rhs, "eq"))
        }
        .Ne -> {
            if !null_cmp && is_str { return emit_str_eq(ctx, lhs, rhs, true) }
            let is_enum = vtype_enum_name(left_result.ty) != "" && vtype_enum_name(right_result.ty) != ""
            if is_enum { return emit_enum_tag_cmp(ctx, lhs, rhs, left_result.ty, 33) }
            ok_emit(ctx.icmp_ne(lhs, rhs, "ne"))
        }
        .Lt -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 40) }
            let cmp = ctx.icmp(40, lhs, rhs, "slt")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "slt_ext"))
        }
        .Le -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 41) }
            let cmp = ctx.icmp(41, lhs, rhs, "sle")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "sle_ext"))
        }
        .Gt -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 38) }
            let cmp = ctx.icmp(38, lhs, rhs, "sgt")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "sgt_ext"))
        }
        .Ge -> {
            if is_str { return emit_str_cmp(ctx, lhs, rhs, 39) }
            let cmp = ctx.icmp(39, lhs, rhs, "sge")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "sge_ext"))
        }
    }
}


export fn coerce_to_f64(ctx: Ctx, val: ptr, ty: ValueType) -> ptr {
    if vtype_eq(ty, .Float) {
        return to_f64(ctx, val, "f64")
    }
    // Int → float: sitofp
    forge_llvm_build_si_to_fp(ctx.builder, val, forge_llvm_double_type(ctx.lc), "i2f")
}

export fn emit_float_binary(ctx: Ctx, lhs: ptr, rhs: ptr, op: BinOp, lty: ValueType, rty: ValueType) -> EmitResult {
    let fl = coerce_to_f64(ctx, lhs, lty)
    let fr = coerce_to_f64(ctx, rhs, rty)
    match op {
        .Add -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fadd(ctx.builder, fl, fr, "fadd"), "f_bits"), .Float)
        .Sub -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fsub(ctx.builder, fl, fr, "fsub"), "f_bits"), .Float)
        .Mul -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fmul(ctx.builder, fl, fr, "fmul"), "f_bits"), .Float)
        .Div -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_fdiv(ctx.builder, fl, fr, "fdiv"), "f_bits"), .Float)
        .Mod -> ok_emit_typed(f64_to_i64(ctx, forge_llvm_build_frem(ctx.builder, fl, fr, "frem"), "f_bits"), .Float)
        // fcmp ordered predicates: OEQ=1, OGT=2, OGE=3, OLT=4, OLE=5, ONE=6
        .Eq -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 1, fl, fr, "feq")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "feq_ext"))
        }
        .Ne -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 6, fl, fr, "fne")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "fne_ext"))
        }
        .Lt -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 4, fl, fr, "flt")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "flt_ext"))
        }
        .Le -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 5, fl, fr, "fle")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "fle_ext"))
        }
        .Gt -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 2, fl, fr, "fgt")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "fgt_ext"))
        }
        .Ge -> {
            let cmp = forge_llvm_build_fcmp(ctx.builder, 3, fl, fr, "fge")
            ok_emit(ctx.zext(cmp, ctx.i64_type, "fge_ext"))
        }
        // Bitwise ops don't make sense for floats — fall through to int
        _ -> ok_emit(ctx.build_add(lhs, rhs, "add"))
    }
}

export fn emit_logical(ctx: Ctx, env: VarEnv, left: Expr, op: LogicOp, right: Expr) -> EmitResult {
    let left_result = emit_expr(ctx, env, left)?

    let l_bool = ctx.icmp(33, left_result.value, const_i64(ctx, 0), "l_bool")
    let left_bb = forge_llvm_get_insert_block(ctx.builder)

    let rhs_bb = new_bb(ctx, "sc_rhs")
    let merge_bb = new_bb(ctx, "sc_merge")

    // &&: skip rhs if false. ||: skip rhs if true.
    match op {
        .And -> ctx.cond_br(l_bool, rhs_bb, merge_bb)
        .Or -> ctx.cond_br(l_bool, merge_bb, rhs_bb)
    }

    ctx.position(rhs_bb)
    let right_result = emit_expr(ctx, env, right)?
    let r_bool = ctx.icmp(33, right_result.value, const_i64(ctx, 0), "r_bool")
    let rhs_end_bb = forge_llvm_get_insert_block(ctx.builder)
    ctx.br(merge_bb)

    ctx.position(merge_bb)
    let phi = forge_llvm_build_phi(ctx.builder, forge_llvm_int1_type(ctx.lc), "sc_phi")

    let sc_val = match op {
        .And -> forge_llvm_const_int(forge_llvm_int1_type(ctx.lc), 0, 0)
        .Or -> forge_llvm_const_int(forge_llvm_int1_type(ctx.lc), 1, 0)
    }
    forge_llvm_add_incoming(phi, sc_val, left_bb)
    forge_llvm_add_incoming(phi, r_bool, rhs_end_bb)

    ok_emit(ctx.zext(phi, ctx.i64_type, "sc_ext"))
}

