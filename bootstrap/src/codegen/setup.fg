// WHY: compilation setup — declaration passes and top-level emission.

use core.ast.{Expr, ExprList, FieldList, ParamList, Stmt, StmtList, ValueType, VarEnv, VariantList, SStmt, field_list_has, field_list_length, filter_fields_only, filter_fields_without, param_list_length, stmt_unwrap, variant_max_payload, vtype_eq, vtype_fn_ret, vtype_is_closure, vtype_is_unknown, vtype_enum_name, vtype_struct_name, env_extend}
use codegen.types.{Ctx, CgNewtypeReg, CgUnionAliasReg, CopySet, TypeRegs, DeferStack, RcCleanupStack, ReleasableSet, EmitValue, EnumReg, EnumLookup, FnParamTypes, FnRetTypes, LoopStack, ParamTypeList, StmtResult, StructLookup, StructReg, TopLevelLookup, TopLevelVars, TraitDeclReg, TraitMethodNames, err_emit, err_stmt, llvm_type_for_full, ok_emit, ok_stmt, struct_reg_lookup, trait_decl_has, vtype_is_ptr_type, enum_reg_lookup}
use codegen.escape.{analyze_releasable, analyze_copy_types}
use codegen.cycles.{CycleSet, analyze_cycles, cycle_set_has}
use core.registry.{build_registry}
use features.union_type.codegen.{emit_union_wrap, needs_union_wrap}
use codegen.{emit_expr, emit_stmt, emit_stmt_list}
use codegen.helpers.{stmts_last_expr}
use diagnostics.{bag_new}
use features.fn_decl.codegen.{emit_function_bodies}

// Declare an extern function from a list of parameter types.
fn decl(m: ptr, name: string, ret: ptr, params: [ptr]) {
    let count = params.length
    let arr = forge_llvm_type_array_new(count)
    for i in 0..count {
        forge_llvm_type_array_set(arr, i, params[i])
    }
    let fn_type = forge_llvm_function_type(ret, arr, count, 0)
    forge_llvm_type_array_free(arr)
    forge_llvm_add_function(m, name, fn_type)
}

fn decl_va(m: ptr, name: string, ret: ptr, params: [ptr]) {
    let count = params.length
    let arr = forge_llvm_type_array_new(count)
    for i in 0..count {
        forge_llvm_type_array_set(arr, i, params[i])
    }
    let fn_type = forge_llvm_function_type(ret, arr, count, 1)
    forge_llvm_type_array_free(arr)
    forge_llvm_add_function(m, name, fn_type)
}

export fn compile_program(stmts: StmtList, output_path: string, debug_null_checks: bool, source_file: string) -> Result<int, string> {
    let lc = forge_llvm_context_create()
    let m = forge_llvm_module_create("bootstrap", lc)
    let builder = forge_llvm_create_builder(lc)

    let i64t = forge_llvm_int64_type(lc)
    let i1t = forge_llvm_int1_type(lc)
    let pt = forge_llvm_pointer_type(lc)

    let i32t = forge_llvm_int32_type(lc)
    let vt = forge_llvm_void_type(lc)

    // ── libc ──
    decl(m, "puts", i32t, [pt])
    decl(m, "forge_eprintln", vt, [pt])
    decl(m, "strlen", i64t, [pt])
    decl(m, "malloc", pt, [i64t])
    decl(m, "forge_rc_alloc", pt, [i64t])
    decl(m, "forge_rc_retain", vt, [pt])
    decl(m, "forge_rc_release", vt, [pt])
    decl(m, "forge_rc_should_free", i64t, [pt])
    decl(m, "forge_rc_free", vt, [pt])
    decl(m, "forge_rc_suspect", vt, [pt])
    decl(m, "forge_rc_collect", vt, [])
    decl(m, "memcpy", pt, [pt, pt, i64t])
    decl(m, "strcmp", i32t, [pt, pt])
    decl_va(m, "snprintf", i32t, [pt, i64t, pt])
    decl(m, "atoi", i32t, [pt])
    decl(m, "exit", vt, [i32t])

    // ── null safety ──
    decl(m, "forge_null_arg_check", vt, [pt, i64t, pt, i64t, i64t])
    decl(m, "forge_null_deref_trap", vt, [pt, i64t, pt, i64t, i64t, pt, i64t, i64t])
    decl(m, "forge_div_by_zero_trap", vt, [i64t, pt, i64t, i64t])

    // ── arrays ──
    decl(m, "forge_array_new", pt, [])
    decl(m, "forge_array_push", vt, [pt, i64t])
    decl(m, "forge_array_get", i64t, [pt, i64t])
    decl(m, "forge_array_len", i64t, [pt])
    decl(m, "forge_array_set", vt, [pt, i64t, i64t])
    decl(m, "forge_array_pop", i64t, [pt])
    decl(m, "forge_array_slice", pt, [pt, i64t, i64t])

    // ── closures ──
    decl(m, "forge_closure_get_fn", i64t, [i64t])
    decl(m, "forge_closure_num_captures", i64t, [i64t])
    decl(m, "forge_closure_get_capture", i64t, [pt, i64t])
    decl(m, "forge_closure_call_0", i64t, [i64t])
    decl(m, "forge_closure_call_1", i64t, [i64t, i64t])
    decl(m, "forge_closure_call_2", i64t, [i64t, i64t, i64t])
    decl(m, "forge_closure_call_3", i64t, [i64t, i64t, i64t, i64t])
    decl(m, "forge_closure_call_4", i64t, [i64t, i64t, i64t, i64t, i64t])
    decl(m, "forge_closure_call_5", i64t, [i64t, i64t, i64t, i64t, i64t, i64t])

    // ── higher-order list ops ──
    decl(m, "forge_array_map", pt, [pt, i64t])
    decl(m, "forge_array_filter", pt, [pt, i64t])
    decl(m, "forge_array_foreach", vt, [pt, i64t])
    decl(m, "forge_array_reduce", i64t, [pt, i64t, i64t])
    decl(m, "forge_array_contains", i64t, [pt, i64t])
    decl(m, "forge_array_index_of", i64t, [pt, i64t])
    decl(m, "forge_array_reverse", pt, [pt])

    // ── strings ──
    decl(m, "forge_str_contains", i64t, [pt, pt])
    decl(m, "forge_str_starts_with", i64t, [pt, pt])
    decl(m, "forge_str_ends_with", i64t, [pt, pt])
    decl(m, "forge_str_index_of", i64t, [pt, pt])
    decl(m, "forge_str_split", pt, [pt, pt])
    decl(m, "forge_str_replace", pt, [pt, pt, pt])
    decl(m, "forge_str_trim", pt, [pt])
    decl(m, "forge_str_to_upper", pt, [pt])
    decl(m, "forge_str_to_lower", pt, [pt])
    decl(m, "forge_str_join", pt, [pt, pt])
    decl(m, "forge_str_char_at", pt, [pt, i64t])
    decl(m, "forge_str_substring", pt, [pt, i64t, i64t])
    decl(m, "forge_str_repeat", pt, [pt, i64t])
    decl(m, "forge_str_reverse", pt, [pt])

    // ── maps ──
    decl(m, "forge_map_new_cstr", pt, [])
    decl(m, "forge_map_set_cstr", vt, [pt, pt, i64t])
    decl(m, "forge_map_get_cstr", i64t, [pt, pt])
    decl(m, "forge_map_has_cstr", i64t, [pt, pt])
    decl(m, "forge_map_len_cstr", i64t, [pt])
    decl(m, "forge_map_keys_cstr", pt, [pt])
    decl(m, "forge_map_values_cstr", pt, [pt])
    decl(m, "forge_map_remove_cstr", i64t, [pt, pt])

    // ── file I/O ──
    decl(m, "forge_file_read", pt, [pt])
    decl(m, "forge_file_write", i64t, [pt, pt])
    decl(m, "forge_file_exists", i64t, [pt])
    decl(m, "forge_intmap_new", pt, [])
    decl(m, "forge_intmap_set", vt, [pt, i64t, i64t])
    decl(m, "forge_intmap_get", i64t, [pt, i64t])
    decl(m, "forge_intmap_has", i64t, [pt, i64t])

    // ── float ──
    decl(m, "forge_float_parse", i64t, [pt])
    decl(m, "forge_float_to_string", i64t, [i64t])
    decl(m, "forge_format_float", pt, [i64t, pt])
    decl(m, "forge_format_int", pt, [i64t, pt])

    // ── ptr ops ──
    decl(m, "forge_ptr_store_byte", vt, [pt, i64t, i64t])
    decl(m, "forge_string_from_ptr", i64t, [pt, i64t])

    // ── trait objects ──
    decl(m, "forge_trait_object_new", i64t, [pt, i64t])
    decl(m, "forge_trait_object_value", i64t, [pt])
    decl(m, "forge_trait_object_vtable", pt, [pt])

    // ── datetime ──
    decl(m, "forge_datetime_now", i64t, [])
    decl(m, "forge_datetime_format", i64t, [pt, i64t])
    decl(m, "forge_datetime_year", i64t, [pt])
    decl(m, "forge_datetime_month", i64t, [pt])
    decl(m, "forge_datetime_day", i64t, [pt])
    decl(m, "forge_datetime_hour", i64t, [pt])
    decl(m, "forge_datetime_minute", i64t, [pt])
    decl(m, "forge_datetime_second", i64t, [pt])

    // ── json ──
    decl(m, "forge_json_stringify_int", pt, [pt])
    decl(m, "forge_json_stringify_string", pt, [pt])
    decl(m, "forge_json_stringify_bool", pt, [pt])
    decl(m, "forge_json_get_int", i64t, [pt, i64t])
    decl(m, "forge_json_get_string", i64t, [pt, i64t])
    decl(m, "forge_json_get_bool", i64t, [pt, i64t])

    // ── semver ──
    decl(m, "forge_semver_major", i64t, [pt])
    decl(m, "forge_semver_minor", i64t, [pt])
    decl(m, "forge_semver_patch", i64t, [pt])
    decl(m, "forge_semver_compare", i64t, [pt, i64t])

    // ── validation ──
    decl(m, "forge_validate_not_null", i64t, [pt, i64t])
    decl(m, "forge_validate_positive", i64t, [pt, i64t])
    decl(m, "forge_validate_not_empty", i64t, [pt, i64t])

    // ── toml ──
    decl(m, "forge_toml_get_string", i64t, [pt, i64t])
    decl(m, "forge_toml_get_int", i64t, [pt, i64t])
    decl(m, "forge_toml_get_bool", i64t, [pt, i64t])
    decl(m, "forge_toml_get_section_string", i64t, [pt, i64t, i64t])
    decl(m, "forge_toml_has_section", i64t, [pt, i64t])

    // ── concurrency ──
    decl(m, "forge_spawn", i64t, [pt])
    decl(m, "forge_task_await", i64t, [pt])
    decl(m, "forge_thread_join", i32t, [pt])
    decl(m, "forge_yield", vt, [])
    decl(m, "forge_scheduler_run", vt, [])
    decl(m, "forge_task_group_new", pt, [])
    decl(m, "forge_task_group_add", vt, [pt, pt])
    decl(m, "forge_task_group_await_all", vt, [pt])
    decl(m, "forge_channel_new", pt, [])
    decl(m, "forge_channel_send", vt, [pt, i64t])
    decl(m, "forge_channel_recv", i64t, [pt])
    decl(m, "forge_channel_close", i32t, [pt])
    decl(m, "forge_parallel_run", i32t, [pt])
    decl(m, "forge_select", i64t, [pt, i64t])
    decl(m, "forge_select_index", i64t, [pt])
    decl(m, "forge_select_value", i64t, [pt])

    // ── spec tests ──
    decl(m, "forge_test_start_spec", i32t, [pt])
    decl(m, "forge_test_end_spec", i32t, [pt])
    decl(m, "forge_test_start_given", i32t, [pt])
    decl(m, "forge_test_end_given", i32t, [pt])
    decl(m, "forge_test_run_then", i64t, [pt, i64t])
    decl(m, "forge_test_summary", i32t, [])

    // ── arenas (spec Axis 9.6) ──
    decl(m, "forge_arena_new", pt, [])
    decl(m, "forge_arena_alloc", pt, [pt, i64t])
    decl(m, "forge_arena_destroy", vt, [pt])

    // ── match trap ──
    decl(m, "forge_match_unreachable", vt, [pt, i64t, pt, i64t])

    // ── type introspection ──
    decl(m, "forge_llvm_is_ptr_value", i32t, [pt])
    decl(m, "forge_llvm_typeof", pt, [pt])
    decl(m, "forge_llvm_cast_to_type", pt, [pt, pt, pt])
    decl(m, "forge_llvm_is_void_value", i32t, [pt])
    decl(m, "forge_llvm_build_store_cast", vt, [pt, pt, pt])
    decl(m, "forge_llvm_verify_function", i32t, [pt])
    decl(m, "forge_llvm_type_kind", i64t, [pt])
    decl(m, "forge_llvm_int_type_width", i64t, [pt])
    decl(m, "forge_llvm_build_call_coerce", pt, [pt, pt, pt, pt, i64t, pt])

    // Build the per-compile registries by walking the AST once.
    // These are threaded through Ctx as immutable data — no
    // mutable globals.
    let dt = forge_llvm_double_type(lc)
    // Collect newtype/union alias registries first — needed for field type resolution
    let cg_newtypes = collect_newtypes(stmts, CgNewtypeReg.End)
    let cg_union_aliases = collect_union_aliases(stmts, CgUnionAliasReg.End)
    let structs = declare_structs(lc, i64t, i1t, dt, pt, stmts, cg_newtypes, cg_union_aliases, StructReg.End)
    let enums = declare_enums(lc, i64t, i1t, dt, pt, stmts, structs, cg_newtypes, cg_union_aliases, EnumReg.End)
    // Union type layout: {i64 tag, ptr payload} — same as enums
    let union_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(union_arr, 0, i64t)
    forge_llvm_type_array_set(union_arr, 1, pt)
    let union_st = forge_llvm_struct_create_named(lc, "__union")
    forge_llvm_struct_set_body(union_st, union_arr, 2, 0)
    forge_llvm_type_array_free(union_arr)
    let trait_decls = collect_trait_decls(stmts, TraitDeclReg.End)
    let top_level_vars = declare_globals(m, lc, i64t, i1t, dt, pt, structs, enums, stmts, TopLevelVars.End)
    let type_regs = TypeRegs { structs, enums, newtypes: cg_newtypes, union_aliases: cg_union_aliases }
    let fn_rets = declare_functions(m, lc, i64t, i1t, dt, pt, type_regs, trait_decls, stmts, FnRetTypes.End)
    let fn_params = collect_fn_params(stmts, FnParamTypes.End)

    // Synthesize a wrapper function for the top-level non-function
    // statements. If the source already defines its own `fn main`,
    // use a different name (`__bs_top_level`) so we don't collide
    // — the user's main becomes the program entry point. Otherwise
    // we name the wrapper `main` so it serves as the entry.
    let user_main = forge_llvm_get_named_function(m, "main")
    let main_name = if user_main == null { "main" } else { "__bs_top_level" }
    let main_params = forge_llvm_type_array_new(0)
    let main_type = forge_llvm_function_type(i64t, main_params, 0, 0)
    forge_llvm_type_array_free(main_params)
    let main_fn = forge_llvm_add_function(m, main_name, main_type)

    let entry = forge_llvm_append_basic_block(lc, main_fn, "entry")
    forge_llvm_position_at_end(builder, entry)

    let copy_types = analyze_copy_types(structs, enums)
    mut ctx = Ctx {
        lc,
        module: m,
        builder,
        current_fn: main_fn,
        current_fn_name: main_name,
        i64_type: i64t,
        i1_type: i1t,
        ptr_type: pt,
        double_type: forge_llvm_double_type(lc),
        structs,
        enums,
        fn_rets,
        fn_params,
        top_level_vars,
        loops: LoopStack.End,
        defers: DeferStack.End,
        rc_cleanup: RcCleanupStack.End,
        rc_releasable: ReleasableSet.End,
        features: build_registry(),
        trait_decls,
        newtypes: cg_newtypes,
        union_aliases: cg_union_aliases,
        copy_types,
        debug_null_checks,
        source_file,
        source_line: 0,
        arena_ptr: null,
        copy_alloc_target: null,
        task_group: null,
        bag: bag_new(),
    }

    // Analyze which types are cycle-capable (can reference themselves
    // through any chain of fields). Used by release functions to add
    // suspects for cycle collection (spec Axis 9.5).
    let cycles = analyze_cycles(ctx.structs, ctx.enums)

    // Generate __release_TypeName functions for recursive RC field cleanup.
    // Must happen after Ctx is built (needs all type registries) but before
    // function bodies (they may call release functions via emit_rc_release_typed).
    emit_release_functions(ctx, cycles)

    // Reposition builder at main's entry after release fn emission.
    ctx.position(entry)

    // Pass 2: emit each user-defined function's body, then emit
    // every non-function top-level statement into main.
    match emit_function_bodies(ctx, stmts) {
        .Ok(_) -> {}
        .Err(e) -> {
            ctx.dispose()
            return Result.Err(e)
        }
    }

    // After emitting any function bodies, the builder may be sitting
    // in a function-body block. Reposition it back at main's entry
    // before emitting top-level statements.
    ctx.position(entry)
    ctx.rc_releasable = analyze_releasable(stmts)
    let initial: VarEnv = VarEnv.End
    match emit_top_level(ctx, initial, stmts) {
        .Ok(_) -> {}
        .Err(e) -> {
            ctx.dispose()
            return Result.Err(e)
        }
    }

    // Emit test summary if any spec blocks were compiled, then
    // run cycle collector before exit.
    if !ctx.has_terminator() {
        ctx.call("forge_test_summary", [])
        ctx.call("forge_rc_collect", [])
        ctx.ret(ctx.i64(0), .Int)
    }

    ctx.verify_module()
    let write_result = ctx.write_ir(output_path)
    ctx.dispose()

    if write_result != 0 {
        return Result.Err("codegen error: failed to write IR to ${output_path}")
    }

    Result.Ok(0)
}

// Rebuild a FieldList with `resolved` populated from `resolve_type`.
fn resolve_variant_fields(variants: VariantList, regs: TypeRegs) -> VariantList {
    match variants {
        .End -> .End
        .Node(name, fields, next) ->
            VariantList.Node(name, resolve_field_list(fields, regs), resolve_variant_fields(next, regs))
    }
}

fn resolve_field_list(fields: FieldList, regs: TypeRegs) -> FieldList {
    match fields {
        .End -> .End
        .Node(name, pv, next) ->
            .Node(name, resolve_field_vt(regs, pv), resolve_field_list(next, regs))
    }
}

fn resolve_param_list(params: ParamList, regs: TypeRegs) -> ParamList {
    match params {
        .End -> .End
        .Node(name, pv, next) ->
            .Node(name, resolve_setup_vt(regs, pv), resolve_param_list(next, regs))
    }
}

fn resolve_field_vt(regs: TypeRegs, pv: ValueType) -> ValueType {
    if !vtype_is_unknown(pv) {
        let resolved = resolve_setup_vt(regs, pv)
        if !vtype_is_unknown(resolved) { return resolved }
    }
    pv
}

// Resolve a parser-produced ValueType using setup registries.
// Ensures Struct("EnumName") → Enum("EnumName", ...) consistency.
fn resolve_setup_vt(regs: TypeRegs, vt: ValueType) -> ValueType {
    match vt {
        .Struct(name) -> {
            let e = enum_reg_lookup(regs.enums, name)
            if e.found { return ValueType.Enum(name, TypeList.End) }
            let s = struct_reg_lookup(regs.structs, name)
            if s.found { return ValueType.Struct(name) }
            // Not in any registry — return Unknown (consistent with resolve_type)
            ValueType.Unknown
        }
        .List(elem) -> ValueType.List(resolve_setup_vt(regs, elem))
        .Union(types) -> ValueType.Union(resolve_setup_vt_list(regs, types))
        .Enum(name, args) -> ValueType.Enum(name, resolve_setup_vt_list(regs, args))
        .FnTyped(params, ret) -> ValueType.FnTyped(resolve_setup_vt_list(regs, params), resolve_setup_vt(regs, ret))
        _ -> vt
    }
}

fn resolve_setup_vt_list(regs: TypeRegs, types: TypeList) -> TypeList {
    match types {
        .End -> .End
        .Node(ty, next) -> TypeList.Node(resolve_setup_vt(regs, ty), resolve_setup_vt_list(regs, next))
    }
}


fn fill_struct_field_types(arr: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, fields: FieldList, idx: int) {
    match fields {
        .End -> {}
        .Node(_, resolved, next) -> {
            forge_llvm_type_array_set(arr, idx, llvm_type_for_full(i64t, i1t, dt, pt, resolved))
            fill_struct_field_types(arr, i64t, i1t, dt, pt, next, idx + 1)
        }
    }
}

fn declare_structs(ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, stmts: StmtList, nts: CgNewtypeReg, uas: CgUnionAliasReg, reg: StructReg) -> StructReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .TypeDecl(name, _, fields) -> {
                    let op_fields = resolve_type_operator(fields, reg)
                    let base_regs = TypeRegs { structs: reg, enums: EnumReg.End, newtypes: nts, union_aliases: uas }
                    let resolved_fields = resolve_field_list(op_fields, base_regs)
                    let count = field_list_length(resolved_fields)
                    let field_arr = forge_llvm_type_array_new(count)
                    fill_struct_field_types(field_arr, i64t, i1t, dt, pt, resolved_fields, 0)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, count, 0)
                    forge_llvm_type_array_free(field_arr)
                    StructReg.Node(name, resolved_fields, reg)
                }
                .ShapeDecl(name, fields) -> {
                    let base_regs = TypeRegs { structs: reg, enums: EnumReg.End, newtypes: nts, union_aliases: uas }
                    let resolved_fields = resolve_field_list(fields, base_regs)
                    let count = field_list_length(resolved_fields)
                    let field_arr = forge_llvm_type_array_new(count)
                    fill_struct_field_types(field_arr, i64t, i1t, dt, pt, resolved_fields, 0)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, count, 0)
                    forge_llvm_type_array_free(field_arr)
                    StructReg.Node(name, resolved_fields, reg)
                }
                .UnionAliasDecl(_, _) -> reg
                .NewtypeDecl(_, _) -> reg
                .Module(_, body) -> declare_structs(ctx, i64t, i1t, dt, pt, body, nts, uas, reg)
                _ -> reg
            }
            declare_structs(ctx, i64t, i1t, dt, pt, next, nts, uas, updated)
        }
    }
}

fn declare_one_global(m: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, structs: StructReg, enums: EnumReg, name: string, ty_vt: ValueType, reg: TopLevelVars) -> TopLevelVars {
    let vt = if !vtype_is_unknown(ty_vt) { ty_vt } else { ValueType.Int }
    let llvm_ty = llvm_type_for_full(i64t, i1t, dt, pt, vt)
    let g = forge_llvm_add_global(m, llvm_ty, name)
    forge_llvm_set_initializer(g, forge_llvm_const_null(llvm_ty))
    TopLevelVars.Node(name, g, vt, reg)
}

fn declare_globals(m: ptr, ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: TopLevelVars) -> TopLevelVars {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Let(name, ty_vt, _) -> declare_one_global(m, i64t, i1t, dt, pt, structs, enums, name, ty_vt, reg)
                .Mut(name, ty_vt, _) -> declare_one_global(m, i64t, i1t, dt, pt, structs, enums, name, ty_vt, reg)
                .Const(name, ty_vt, _) -> declare_one_global(m, i64t, i1t, dt, pt, structs, enums, name, ty_vt, reg)
                .Module(_, body) -> declare_globals(m, ctx, i64t, i1t, dt, pt, structs, enums, body, reg)
                _ -> reg
            }
            declare_globals(m, ctx, i64t, i1t, dt, pt, structs, enums, next, updated)
        }
    }
}

// Declare per-variant payload struct types: %EnumName.VariantName = type { field_types... }
fn declare_variant_payloads(lc: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, enum_name: string, variants: VariantList, structs: StructReg, nts: CgNewtypeReg, uas: CgUnionAliasReg, enums: EnumReg) {
    match variants {
        .End -> {}
        .Node(vname, fields, next) -> {
            let count = field_list_length(fields)
            if count > 0 {
                let payload_name = "${enum_name}__${vname}"
                let vp_regs = TypeRegs { structs, enums, newtypes: nts, union_aliases: uas }
                let resolved_fields = resolve_field_list(fields, vp_regs)
                let arr = forge_llvm_type_array_new(count)
                fill_struct_field_types(arr, i64t, i1t, dt, pt, resolved_fields, 0)
                let st = forge_llvm_struct_create_named(lc, payload_name)
                forge_llvm_struct_set_body(st, arr, count, 0)
                forge_llvm_type_array_free(arr)
            }
            declare_variant_payloads(lc, i64t, i1t, dt, pt, enum_name, next, structs, nts, uas, enums)
        }
    }
}

fn declare_enums(ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, stmts: StmtList, structs: StructReg, nts: CgNewtypeReg, uas: CgUnionAliasReg, reg: EnumReg) -> EnumReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .EnumDecl(name, _, variants) -> {
                    // Enum outer layout: {i64 tag, ptr payload}
                    let field_arr = forge_llvm_type_array_new(2)
                    forge_llvm_type_array_set(field_arr, 0, i64t)
                    forge_llvm_type_array_set(field_arr, 1, forge_llvm_pointer_type(ctx))
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, 2, 0)
                    forge_llvm_type_array_free(field_arr)
                    // Per-variant typed payload structs
                    declare_variant_payloads(ctx, i64t, i1t, dt, pt, name, variants, structs, nts, uas, reg)
                    let ev_regs = TypeRegs { structs, enums: reg, newtypes: nts, union_aliases: uas }
                    let resolved_variants = resolve_variant_fields(variants, ev_regs)
                    EnumReg.Node(name, resolved_variants, reg)
                }
                .Module(_, body) -> declare_enums(ctx, i64t, i1t, dt, pt, body, structs, nts, uas, reg)
                _ -> reg
            }
            declare_enums(ctx, i64t, i1t, dt, pt, next, structs, nts, uas, updated)
        }
    }
}

// ── Per-type release functions ──────────────────────────────────────
// Generate __release_TypeName functions for every struct/enum that has
// RC-managed (ptr-type) fields. These functions are called from
// emit_rc_release_typed to recursively release inner objects before
// freeing the outer one.

// Check if a FieldList contains any ptr-type fields.
fn fields_have_rc(fields: FieldList) -> bool {
    match fields {
        .End -> false
        .Node(_, resolved, next) -> {
            if vtype_is_ptr_type(resolved) { true }
            else { fields_have_rc(next) }
        }
    }
}

// Check if any variant in a VariantList has ptr-type payload fields.
fn variants_have_rc(variants: VariantList) -> bool {
    match variants {
        .End -> false
        .Node(_, fields, next) -> {
            if fields_have_rc(fields) { true }
            else { variants_have_rc(next) }
        }
    }
}

// Declare __release_TypeName function signatures for all structs and enums
// that have RC fields. Must happen before bodies are emitted so that
// mutually-recursive types can reference each other's release functions.
fn declare_release_fns_structs(m: ptr, i64t: ptr, pt: ptr, reg: StructReg) {
    match reg {
        .End -> {}
        .Node(name, fields, next) -> {
            // Declare release function if struct has RC fields OR a drop impl
            let has_drop = forge_llvm_get_named_function(m, "${name}__drop") != null
            if fields_have_rc(fields) || has_drop {
                decl(m, "__release_${name}", i64t, [pt])
            }
            declare_release_fns_structs(m, i64t, pt, next)
        }
    }
}

fn declare_release_fns_enums(m: ptr, i64t: ptr, pt: ptr, reg: EnumReg) {
    match reg {
        .End -> {}
        .Node(name, variants, next) -> {
            if variants_have_rc(variants) {
                decl(m, "__release_${name}", i64t, [pt])
            }
            declare_release_fns_enums(m, i64t, pt, next)
        }
    }
}

// Emit a call to release a single field value based on its ValueType.
// For Struct/Enum types: calls __release_TypeName if it exists, else forge_rc_release.
// For other ptr types: calls forge_rc_release.
fn emit_field_release(ctx: Ctx, val: ptr, ty: ValueType) {
    match ty {
        .Struct(sn) -> {
            let rfn = ctx.get_fn("__release_${sn}")
            if rfn != null {
                ctx.call("__release_${sn}", [val])
            } else {
                ctx.call("forge_rc_release", [val])
            }
        }
        .Enum(en, _) -> {
            let rfn = ctx.get_fn("__release_${en}")
            if rfn != null {
                ctx.call("__release_${en}", [val])
            } else {
                ctx.call("forge_rc_release", [val])
            }
        }
        _ -> ctx.call("forge_rc_release", [val])
    }
}

// Emit release calls for each ptr-type field in a struct.
fn emit_struct_field_releases(ctx: Ctx, obj: ptr, type_name: string, fields: FieldList, idx: int) {
    match fields {
        .End -> {}
        .Node(fname, resolved, next) -> {
            if vtype_is_ptr_type(resolved) {
                let st_ty = forge_llvm_get_type_by_name(ctx.lc, type_name)
                let fld_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, obj, idx, "rel_${fname}_ptr")
                let fld_val = forge_llvm_build_load(ctx.builder, ctx.ptr_type, fld_gep, "rel_${fname}")
                // Null check: field may be uninitialized or nullable
                let is_null = forge_llvm_build_icmp(ctx.builder, 32, fld_val, forge_llvm_const_null(ctx.ptr_type), "is_null_${fname}")
                let then_bb = forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, "rel_${fname}_skip")
                let else_bb = forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, "rel_${fname}_do")
                forge_llvm_build_cond_br(ctx.builder, is_null, then_bb, else_bb)
                forge_llvm_position_at_end(ctx.builder, else_bb)
                emit_field_release(ctx, fld_val, resolved)
                forge_llvm_build_br(ctx.builder, then_bb)
                forge_llvm_position_at_end(ctx.builder, then_bb)
            }
            emit_struct_field_releases(ctx, obj, type_name, next, idx + 1)
        }
    }
}

// Emit the body of a __release_StructName function.
// Shared scaffolding for __release_TypeName functions.
// Sets up: entry → should_free check → free_bb / alive_bb / done_bb.
// Returns (fctx, obj, free_bb, done_bb) positioned at free_bb.
// Caller emits type-specific field releases, then calls emit_release_finish.
type ReleaseScaffold = { fctx: Ctx, obj: ptr, free_bb: ptr, alive_bb: ptr, done_bb: ptr }

fn emit_release_scaffold(ctx: Ctx, name: string) -> ReleaseScaffold? {
    let fn_val = ctx.get_fn("__release_${name}")
    if fn_val == null { return null }
    let fctx = ctx.with_fn(fn_val, "__release_${name}")
    let entry = forge_llvm_append_basic_block(ctx.lc, fn_val, "entry")
    forge_llvm_position_at_end(fctx.builder, entry)
    let obj = forge_llvm_get_param(fn_val, 0)
    let should = fctx.call("forge_rc_should_free", [obj])
    let cond = forge_llvm_build_icmp(fctx.builder, 33, should, forge_llvm_const_int(fctx.i64_type, 0, 0), "should_free")
    let free_bb = forge_llvm_append_basic_block(ctx.lc, fn_val, "do_free")
    let alive_bb = forge_llvm_append_basic_block(ctx.lc, fn_val, "alive")
    let done_bb = forge_llvm_append_basic_block(ctx.lc, fn_val, "done")
    forge_llvm_build_cond_br(fctx.builder, cond, free_bb, alive_bb)
    // Builder left after entry's cond_br. Caller positions at free_bb.
    ReleaseScaffold { fctx, obj, free_bb, alive_bb, done_bb }
}

fn emit_release_finish(sc: ReleaseScaffold, is_cyclic: bool) {
    forge_llvm_position_at_end(sc.fctx.builder, sc.alive_bb)
    if is_cyclic {
        sc.fctx.call("forge_rc_suspect", [sc.obj])
    }
    forge_llvm_build_br(sc.fctx.builder, sc.done_bb)
    forge_llvm_position_at_end(sc.fctx.builder, sc.done_bb)
    forge_llvm_build_ret(sc.fctx.builder, forge_llvm_const_int(sc.fctx.i64_type, 0, 0))
}

fn emit_release_body_struct(ctx: Ctx, name: string, fields: FieldList, is_cyclic: bool) {
    let sc = emit_release_scaffold(ctx, name)
    if sc == null { return }
    let s = sc!
    forge_llvm_position_at_end(s.fctx.builder, s.free_bb)
    // Call user-defined Drop::drop(self) if impl Drop for Type exists
    let drop_fn = s.fctx.get_fn("${name}__drop")
    if drop_fn != null {
        s.fctx.call("${name}__drop", [s.obj])
    }
    emit_struct_field_releases(s.fctx, s.obj, name, fields, 0)
    s.fctx.call("forge_rc_free", [s.obj])
    forge_llvm_build_br(s.fctx.builder, s.done_bb)
    emit_release_finish(s, is_cyclic)
}

// Emit release calls for ptr-type fields in an enum variant payload.
fn emit_variant_field_releases(ctx: Ctx, payload: ptr, enum_name: string, variant_name: string, fields: FieldList, idx: int) {
    match fields {
        .End -> {}
        .Node(fname, resolved, next) -> {
            if vtype_is_ptr_type(resolved) {
                let payload_type_name = "${enum_name}__${variant_name}"
                let pay_ty = forge_llvm_get_type_by_name(ctx.lc, payload_type_name)
                if pay_ty != null {
                    let fld_gep = forge_llvm_build_struct_gep2(ctx.builder, pay_ty, payload, idx, "vrel_${fname}_ptr")
                    let fld_val = forge_llvm_build_load(ctx.builder, ctx.ptr_type, fld_gep, "vrel_${fname}")
                    let is_null = forge_llvm_build_icmp(ctx.builder, 32, fld_val, forge_llvm_const_null(ctx.ptr_type), "vrel_null_${fname}")
                    let then_bb = forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, "vrel_${fname}_skip")
                    let else_bb = forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, "vrel_${fname}_do")
                    forge_llvm_build_cond_br(ctx.builder, is_null, then_bb, else_bb)
                    forge_llvm_position_at_end(ctx.builder, else_bb)
                    emit_field_release(ctx, fld_val, resolved)
                    forge_llvm_build_br(ctx.builder, then_bb)
                    forge_llvm_position_at_end(ctx.builder, then_bb)
                }
            }
            emit_variant_field_releases(ctx, payload, enum_name, variant_name, next, idx + 1)
        }
    }
}

// Emit tag-check + field-release code for each enum variant.
fn emit_enum_variant_releases(ctx: Ctx, tag_val: ptr, payload: ptr, enum_name: string, variants: VariantList, done_bb: ptr) {
    match variants {
        .End -> {}
        .Node(vname, fields, next) -> {
            if fields_have_rc(fields) {
                let tag_hash = forge_variant_hash(vname)
                let tag_const = forge_llvm_const_int(ctx.i64_type, tag_hash, 0)
                let cmp = forge_llvm_build_icmp(ctx.builder, 32, tag_val, tag_const, "is_${vname}")
                let match_bb = forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, "rel_${vname}")
                let next_bb = forge_llvm_append_basic_block(ctx.lc, ctx.current_fn, "try_next_${vname}")
                forge_llvm_build_cond_br(ctx.builder, cmp, match_bb, next_bb)
                forge_llvm_position_at_end(ctx.builder, match_bb)
                // Cast payload ptr to variant struct type and release fields
                emit_variant_field_releases(ctx, payload, enum_name, vname, fields, 0)
                forge_llvm_build_br(ctx.builder, done_bb)
                forge_llvm_position_at_end(ctx.builder, next_bb)
            }
            emit_enum_variant_releases(ctx, tag_val, payload, enum_name, next, done_bb)
        }
    }
}

fn emit_release_body_enum(ctx: Ctx, name: string, variants: VariantList, is_cyclic: bool) {
    let sc = emit_release_scaffold(ctx, name)
    if sc == null { return }
    let s = sc!
    let fn_val = ctx.get_fn("__release_${name}")
    forge_llvm_position_at_end(s.fctx.builder, s.free_bb)
    let enum_ty = forge_llvm_get_type_by_name(s.fctx.lc, name)
    let tag_gep = forge_llvm_build_struct_gep2(s.fctx.builder, enum_ty, s.obj, 0, "tag_ptr")
    let tag_val = forge_llvm_build_load(s.fctx.builder, s.fctx.i64_type, tag_gep, "tag")
    let pay_gep = forge_llvm_build_struct_gep2(s.fctx.builder, enum_ty, s.obj, 1, "pay_ptr")
    let payload = forge_llvm_build_load(s.fctx.builder, s.fctx.ptr_type, pay_gep, "payload")
    let fields_done_bb = forge_llvm_append_basic_block(ctx.lc, fn_val, "fields_done")
    emit_enum_variant_releases(s.fctx, tag_val, payload, name, variants, fields_done_bb)
    forge_llvm_build_br(s.fctx.builder, fields_done_bb)
    forge_llvm_position_at_end(s.fctx.builder, fields_done_bb)
    s.fctx.call("forge_rc_free", [s.obj])
    forge_llvm_build_br(s.fctx.builder, s.done_bb)
    emit_release_finish(s, is_cyclic)
}

// Walk StructReg and emit release function bodies.
fn emit_release_bodies_structs(ctx: Ctx, reg: StructReg, cycles: CycleSet) {
    match reg {
        .End -> {}
        .Node(name, fields, next) -> {
            // Generate release function if struct has RC fields OR a drop impl
            let has_drop = ctx.get_fn("${name}__drop") != null
            if fields_have_rc(fields) || has_drop {
                let is_cyclic = cycle_set_has(cycles, name)
                emit_release_body_struct(ctx, name, fields, is_cyclic)
            }
            emit_release_bodies_structs(ctx, next, cycles)
        }
    }
}

// Walk EnumReg and emit release function bodies.
fn emit_release_bodies_enums(ctx: Ctx, reg: EnumReg, cycles: CycleSet) {
    match reg {
        .End -> {}
        .Node(name, variants, next) -> {
            if variants_have_rc(variants) {
                let is_cyclic = cycle_set_has(cycles, name)
                emit_release_body_enum(ctx, name, variants, is_cyclic)
            }
            emit_release_bodies_enums(ctx, next, cycles)
        }
    }
}

// Top-level entry: declare + emit all release functions.
fn emit_release_functions(ctx: Ctx, cycles: CycleSet) {
    // Phase 1: declare all signatures (needed for mutual recursion)
    declare_release_fns_structs(ctx.module, ctx.i64_type, ctx.ptr_type, ctx.structs)
    declare_release_fns_enums(ctx.module, ctx.i64_type, ctx.ptr_type, ctx.enums)
    // Phase 2: emit bodies (cycle-capable types get suspect calls)
    emit_release_bodies_structs(ctx, ctx.structs, cycles)
    emit_release_bodies_enums(ctx, ctx.enums, cycles)
}

fn collect_trait_decls(stmts: StmtList, reg: TraitDeclReg) -> TraitDeclReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .TraitDecl(name, methods) -> .Node(name, collect_trait_fn_names(methods), reg)
                .Module(_, body) -> collect_trait_decls(body, reg)
                _ -> reg
            }
            collect_trait_decls(next, updated)
        }
    }
}

fn collect_trait_fn_names(stmts: StmtList) -> TraitMethodNames {
    match stmts {
        .End -> .End
        .Node(ss, next) -> {
            match stmt_unwrap(ss.node) {
                .ExternFn(name, _, ret_vt) -> .Node(name, ret_vt, collect_trait_fn_names(next))
                .Function(name, _, _, ret_vt, _) -> .Node(name, ret_vt, collect_trait_fn_names(next))
                _ -> collect_trait_fn_names(next)
            }
        }
    }
}

fn collect_newtypes(stmts: StmtList, reg: CgNewtypeReg) -> CgNewtypeReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .NewtypeDecl(name, inner_vt) -> CgNewtypeReg.Node(name, inner_vt, reg)
                .Module(_, body) -> collect_newtypes(body, reg)
                _ -> reg
            }
            collect_newtypes(next, updated)
        }
    }
}

fn collect_union_aliases(stmts: StmtList, reg: CgUnionAliasReg) -> CgUnionAliasReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .UnionAliasDecl(name, type_vt) -> CgUnionAliasReg.Node(name, type_vt, reg)
                .Module(_, body) -> collect_union_aliases(body, reg)
                _ -> reg
            }
            collect_union_aliases(next, updated)
        }
    }
}

fn resolve_type_operator(fields: FieldList, reg: StructReg) -> FieldList {
    match fields {
        .Node(marker, base_vt, rest) if marker == "__base" -> {
            let base_name = vtype_struct_name(base_vt)
            match rest {
                .Node(op_marker, _, excluded_fields) -> {
                    let base_lookup = struct_reg_lookup(reg, base_name)
                    if !base_lookup.found { return FieldList.End }
                    if op_marker == "__without" {
                        return filter_fields_without(base_lookup.fields, excluded_fields)
                    }
                    if op_marker == "__only" {
                        return filter_fields_only(base_lookup.fields, excluded_fields)
                    }
                    base_lookup.fields
                }
                _ -> fields
            }
        }
        _ -> fields
    }
}

// field_list_has, filter_fields_without, filter_fields_only now in core/ast.fg

fn fill_i64_param_array_offset(arr: ptr, i64t: ptr, base: int, count: int) {
    if count <= 0 {
        return
    }
    forge_llvm_type_array_set(arr, base, i64t)
    fill_i64_param_array_offset(arr, i64t, base + 1, count - 1)
}

// Fill a type array with the correct LLVM types for each parameter.
fn fill_typed_param_array(arr: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, params: ParamList, idx: int) {
    match params {
        .End -> {}
        .Node(_, resolved, next) -> {
            forge_llvm_type_array_set(arr, idx, llvm_type_for_full(i64t, i1t, dt, pt, resolved))
            fill_typed_param_array(arr, i64t, i1t, dt, pt, next, idx + 1)
        }
    }
}

fn resolve_fn_ret(regs: TypeRegs, traits: TraitDeclReg, rvt: ValueType, body: StmtList) -> ValueType {
    mut base = if vtype_is_unknown(rvt) {
        ValueType.Void
    } else {
        let resolved = resolve_setup_vt(regs, rvt)
        match resolved {
            .Enum(name, _) -> {
                let found = enum_reg_lookup(regs.enums, name)
                if found.found { ValueType.Enum(name, TypeList.End) } else { resolved }
            }
            _ -> resolved
        }
    }
    // Check if it's a trait name (use original rvt in case resolution lost the name)
    let sn = match base { .Struct(n) -> n, _ -> match rvt { .Struct(n) -> n, _ -> "" } }
    if sn != "" && trait_decl_has(traits, sn) { base = ValueType.Trait(sn) }
    let last = stmts_last_expr(body)
    match last {
        .Lambda(_, _) -> ValueType.Closure(-1, vtype_fn_ret(base))
        _ -> base
    }
}

fn declare_functions(m: ptr, ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, regs: TypeRegs, traits: TraitDeclReg, stmts: StmtList, reg: FnRetTypes) -> FnRetTypes {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Function(name, _, params, rvt, body) -> {
                    let resolved_params = resolve_param_list(params, regs)
                    let arity = param_list_length(resolved_params)
                    let existing = forge_llvm_get_named_function(m, name)
                    if existing != null {
                        fail("FATAL: duplicate function `${name}` — rename to avoid collision")
                    }
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_typed_param_array(param_arr, i64t, i1t, dt, pt, resolved_params, 0)
                    let ret_vt = resolve_fn_ret(regs, traits, rvt, body)
                    let ret_llvm = llvm_type_for_full(i64t, i1t, dt, pt, ret_vt)
                    let fn_type = forge_llvm_function_type(ret_llvm, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    FnRetTypes.Node(name, ret_vt, reg)
                }
                .ExternFn(name, params, ext_rvt) -> {
                    let resolved_params = resolve_param_list(params, regs)
                    let arity = param_list_length(resolved_params)
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_typed_param_array(param_arr, i64t, i1t, dt, pt, resolved_params, 0)
                    let ret_vt = resolve_fn_ret(regs, traits, ext_rvt, StmtList.End)
                    let ret_llvm = llvm_type_for_full(i64t, i1t, dt, pt, ret_vt)
                    let fn_type = forge_llvm_function_type(ret_llvm, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    FnRetTypes.Node(name, ret_vt, reg)
                }
                .Impl(_, methods) -> declare_functions(m, ctx, i64t, i1t, dt, pt, regs, traits, methods, reg)
                .Module(_, body) -> declare_functions(m, ctx, i64t, i1t, dt, pt, regs, traits, body, reg)
                _ -> reg
            }
            declare_functions(m, ctx, i64t, i1t, dt, pt, regs, traits, next, updated)
        }
    }
}

fn params_to_type_list(params: ParamList) -> ParamTypeList {
    match params {
        .End -> .End
        .Node(_, resolved, next) -> .Node(resolved, params_to_type_list(next))
    }
}

fn collect_fn_params(stmts: StmtList, reg: FnParamTypes) -> FnParamTypes {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Function(name, _, params, _, _) -> {
                    .Node(name, params_to_type_list(params), reg)
                }
                .Impl(_, methods) -> collect_fn_params(methods, reg)
                .Module(_, body) -> collect_fn_params(body, reg)
                _ -> reg
            }
            collect_fn_params(next, updated)
        }
    }
}

fn emit_top_level(ctx: Ctx, env: VarEnv, stmts: StmtList) -> Result<VarEnv, string> {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let tl_ctx = ctx with { source_line: ss.line }
            let stmt = stmt_unwrap(ss.node)
            match stmt {
                .Function(_, _, _, _, _) -> emit_top_level(ctx, env, next)
                .Module(_, body) -> {
                    let new_env = emit_top_level(tl_ctx, env, body)?
                    emit_top_level(ctx, new_env, next)
                }
                .Let(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)?
                    emit_top_level(result.ctx, result.env, next)
                }
                .Mut(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)?
                    emit_top_level(result.ctx, result.env, next)
                }
                .Const(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)?
                    emit_top_level(result.ctx, result.env, next)
                }
                _ -> {
                    let sr = emit_stmt(tl_ctx, env, stmt)?
                    emit_top_level(sr.ctx, sr.env, next)
                }
            }
        }
    }
}

fn emit_top_level_init(ctx: Ctx, env: VarEnv, name: string, init: Expr) -> Result<StmtResult, string> {
    let g = ctx.lookup_toplevel(name)
    if !g.found {
        return Result.Err("codegen error: global `${name}` not declared")
    }
    let r = ctx.emit(env, init)?
    if needs_union_wrap(r.ty, g.ty) {
        let wrapped = emit_union_wrap(ctx, r.value, r.ty, g.ty)?
        ctx.store(wrapped.value, g.llvm_global)
    } else {
        ctx.store(r.value, g.llvm_global)
    }
    let updated_top = TopLevelVars.Node(name, g.llvm_global, r.ty, ctx.top_level_vars)
    let updated_cg = ctx.with_top_level(updated_top)
    Result.Ok(StmtResult { ctx: updated_cg, env })
}
