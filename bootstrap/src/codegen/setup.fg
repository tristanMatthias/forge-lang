// WHY: compilation setup — declaration passes and top-level emission.

use core.ast.{Expr, ExprList, FieldList, ParamList, Stmt, StmtList, ValueType, VarEnv, VariantList, SStmt, field_list_length, param_list_length, stmt_unwrap, variant_max_payload, vtype_fn_ret, vtype_is_closure, env_extend}
use codegen.types.{Ctx, CodegenResult, DeferStack, EmitResult, EnumReg, FnParamTypes, FnRetTypes, LoopStack, ParamTypeList, StmtResult, StructLookup, StructReg, TopLevelLookup, TopLevelVars, TraitDeclReg, TraitMethodNames, err_emit, err_stmt, err_stmt_from_expr, llvm_type_for, llvm_type_for_full, ok_emit, ok_stmt, struct_reg_lookup, translate_param_type, translate_type_ctx}
use core.registry.{build_registry}
use codegen.{emit_expr, emit_stmt, emit_stmt_list, TopLevelResult}
use codegen.helpers.{stmts_last_expr}
use features.fn_decl.codegen.{emit_function_bodies}

// Declare an extern function from a list of parameter types.
fn decl(m: ptr, name: string, ret: ptr, params: [ptr]) {
    let count = params.length
    let arr = forge_llvm_type_array_new(count)
    for i in 0..count {
        forge_llvm_type_array_set(arr, i, params[i])
    }
    let fn_type = forge_llvm_function_type(ret, arr, count, 0)
    forge_llvm_type_array_free(arr)
    forge_llvm_add_function(m, name, fn_type)
}

fn decl_va(m: ptr, name: string, ret: ptr, params: [ptr]) {
    let count = params.length
    let arr = forge_llvm_type_array_new(count)
    for i in 0..count {
        forge_llvm_type_array_set(arr, i, params[i])
    }
    let fn_type = forge_llvm_function_type(ret, arr, count, 1)
    forge_llvm_type_array_free(arr)
    forge_llvm_add_function(m, name, fn_type)
}

export fn compile_program(stmts: StmtList, output_path: string, debug_null_checks: bool, source_file: string) -> CodegenResult {
    let lc = forge_llvm_context_create()
    let m = forge_llvm_module_create("bootstrap", lc)
    let builder = forge_llvm_create_builder(lc)

    let i64t = forge_llvm_int64_type(lc)
    let i1t = forge_llvm_int1_type(lc)
    let pt = forge_llvm_pointer_type(lc)

    let i32t = forge_llvm_int32_type(lc)
    let vt = forge_llvm_void_type(lc)

    // ── libc ──
    decl(m, "puts", i32t, [pt])
    decl(m, "forge_eprintln", vt, [pt])
    decl(m, "strlen", i64t, [pt])
    decl(m, "malloc", pt, [i64t])
    decl(m, "forge_bump_alloc", pt, [i64t])
    decl(m, "memcpy", pt, [pt, pt, i64t])
    decl(m, "strcmp", i32t, [pt, pt])
    decl_va(m, "snprintf", i32t, [pt, i64t, pt])
    decl(m, "atoi", i32t, [pt])
    decl(m, "exit", vt, [i32t])

    // ── null safety ──
    decl(m, "forge_null_arg_check", vt, [pt, i64t, pt, i64t, i64t])
    decl(m, "forge_null_deref_trap", vt, [pt, i64t, pt, i64t, i64t, pt, i64t, i64t])
    decl(m, "forge_div_by_zero_trap", vt, [i64t, pt, i64t, i64t])

    // ── arrays ──
    decl(m, "forge_array_new", pt, [])
    decl(m, "forge_array_push", vt, [pt, i64t])
    decl(m, "forge_array_get", i64t, [pt, i64t])
    decl(m, "forge_array_len", i64t, [pt])
    decl(m, "forge_array_set", vt, [pt, i64t, i64t])
    decl(m, "forge_array_pop", i64t, [pt])
    decl(m, "forge_array_slice", pt, [pt, i64t, i64t])

    // ── closures ──
    decl(m, "forge_closure_get_fn", i64t, [i64t])
    decl(m, "forge_closure_num_captures", i64t, [i64t])
    decl(m, "forge_closure_get_capture", i64t, [pt, i64t])
    decl(m, "forge_closure_call_0", i64t, [i64t])
    decl(m, "forge_closure_call_1", i64t, [i64t, i64t])
    decl(m, "forge_closure_call_2", i64t, [i64t, i64t, i64t])
    decl(m, "forge_closure_call_3", i64t, [i64t, i64t, i64t, i64t])

    // ── higher-order list ops ──
    decl(m, "forge_array_map", pt, [pt, i64t])
    decl(m, "forge_array_filter", pt, [pt, i64t])
    decl(m, "forge_array_foreach", vt, [pt, i64t])
    decl(m, "forge_array_reduce", i64t, [pt, i64t, i64t])

    // ── strings ──
    decl(m, "forge_str_contains", i64t, [pt, pt])
    decl(m, "forge_str_starts_with", i64t, [pt, pt])
    decl(m, "forge_str_ends_with", i64t, [pt, pt])
    decl(m, "forge_str_index_of", i64t, [pt, pt])
    decl(m, "forge_str_split", pt, [pt, pt])
    decl(m, "forge_str_replace", pt, [pt, pt, pt])
    decl(m, "forge_str_trim", pt, [pt])
    decl(m, "forge_str_to_upper", pt, [pt])
    decl(m, "forge_str_to_lower", pt, [pt])

    // ── maps ──
    decl(m, "forge_map_new_cstr", pt, [])
    decl(m, "forge_map_set_cstr", vt, [pt, pt, i64t])
    decl(m, "forge_map_get_cstr", i64t, [pt, pt])
    decl(m, "forge_map_has_cstr", i64t, [pt, pt])
    decl(m, "forge_map_len_cstr", i64t, [pt])
    decl(m, "forge_map_keys_cstr", pt, [pt])
    decl(m, "forge_intmap_new", pt, [])
    decl(m, "forge_intmap_set", vt, [pt, i64t, i64t])
    decl(m, "forge_intmap_get", i64t, [pt, i64t])
    decl(m, "forge_intmap_has", i64t, [pt, i64t])

    // ── float ──
    decl(m, "forge_float_parse", i64t, [pt])
    decl(m, "forge_float_to_string", i64t, [i64t])

    // ── ptr ops ──
    decl(m, "forge_ptr_store_byte", vt, [pt, i64t, i64t])
    decl(m, "forge_string_from_ptr", i64t, [pt, i64t])

    // ── trait objects ──
    decl(m, "forge_trait_object_new", i64t, [pt, i64t])
    decl(m, "forge_trait_object_value", i64t, [pt])
    decl(m, "forge_trait_object_vtable", pt, [pt])

    // ── datetime ──
    decl(m, "forge_datetime_now", i64t, [])
    decl(m, "forge_datetime_format", i64t, [pt, i64t])
    decl(m, "forge_datetime_year", i64t, [pt])
    decl(m, "forge_datetime_month", i64t, [pt])
    decl(m, "forge_datetime_day", i64t, [pt])
    decl(m, "forge_datetime_hour", i64t, [pt])
    decl(m, "forge_datetime_minute", i64t, [pt])
    decl(m, "forge_datetime_second", i64t, [pt])

    // ── json ──
    decl(m, "forge_json_stringify_int", pt, [pt])
    decl(m, "forge_json_stringify_string", pt, [pt])
    decl(m, "forge_json_stringify_bool", pt, [pt])
    decl(m, "forge_json_get_int", i64t, [pt, i64t])
    decl(m, "forge_json_get_string", i64t, [pt, i64t])
    decl(m, "forge_json_get_bool", i64t, [pt, i64t])

    // ── semver ──
    decl(m, "forge_semver_major", i64t, [pt])
    decl(m, "forge_semver_minor", i64t, [pt])
    decl(m, "forge_semver_patch", i64t, [pt])
    decl(m, "forge_semver_compare", i64t, [pt, i64t])

    // ── validation ──
    decl(m, "forge_validate_not_null", i64t, [pt, i64t])
    decl(m, "forge_validate_positive", i64t, [pt, i64t])
    decl(m, "forge_validate_not_empty", i64t, [pt, i64t])

    // ── toml ──
    decl(m, "forge_toml_get_string", i64t, [pt, i64t])
    decl(m, "forge_toml_get_int", i64t, [pt, i64t])
    decl(m, "forge_toml_get_bool", i64t, [pt, i64t])

    // ── concurrency ──
    decl(m, "forge_spawn", i64t, [pt])
    decl(m, "forge_thread_join", i32t, [pt])
    decl(m, "forge_channel_new", pt, [])
    decl(m, "forge_channel_send", vt, [pt, i64t])
    decl(m, "forge_channel_recv", i64t, [pt])
    decl(m, "forge_channel_close", i32t, [pt])
    decl(m, "forge_parallel_run", i32t, [pt])
    decl(m, "forge_select", i64t, [pt, i64t])
    decl(m, "forge_select_index", i64t, [pt])
    decl(m, "forge_select_value", i64t, [pt])

    // ── spec tests ──
    decl(m, "forge_test_start_spec", i32t, [pt])
    decl(m, "forge_test_end_spec", i32t, [pt])
    decl(m, "forge_test_start_given", i32t, [pt])
    decl(m, "forge_test_end_given", i32t, [pt])
    decl(m, "forge_test_run_then", i64t, [pt, i64t])
    decl(m, "forge_test_summary", i32t, [pt])

    // ── match trap ──
    decl(m, "forge_match_unreachable", vt, [pt, i64t, pt, i64t])

    // ── type introspection ──
    decl(m, "forge_llvm_is_ptr_value", i32t, [pt])
    decl(m, "forge_llvm_typeof", pt, [pt])
    decl(m, "forge_llvm_cast_to_type", pt, [pt, pt, pt])
    decl(m, "forge_llvm_is_void_value", i32t, [pt])
    decl(m, "forge_llvm_build_store_cast", vt, [pt, pt, pt])
    decl(m, "forge_llvm_verify_function", i32t, [pt])
    decl(m, "forge_llvm_type_kind", i64t, [pt])
    decl(m, "forge_llvm_int_type_width", i64t, [pt])
    decl(m, "forge_llvm_build_call_coerce", pt, [pt, pt, pt, pt, i64t, pt])

    // Build the per-compile registries by walking the AST once.
    // These are threaded through Ctx as immutable data — no
    // mutable globals.
    let dt = forge_llvm_double_type(lc)
    let structs = declare_structs(lc, i64t, i1t, dt, pt, stmts, StructReg.End)
    let enums = declare_enums(lc, i64t, i1t, dt, pt, stmts, structs, EnumReg.End)
    let trait_decls = collect_trait_decls(stmts, TraitDeclReg.End)
    let top_level_vars = declare_globals(m, lc, i64t, i1t, dt, pt, structs, enums, stmts, TopLevelVars.End)
    let fn_rets = declare_functions(m, lc, i64t, i1t, dt, pt, structs, enums, stmts, FnRetTypes.End)
    let fn_params = collect_fn_params(stmts, FnParamTypes.End)

    // Synthesize a wrapper function for the top-level non-function
    // statements. If the source already defines its own `fn main`,
    // use a different name (`__bs_top_level`) so we don't collide
    // — the user's main becomes the program entry point. Otherwise
    // we name the wrapper `main` so it serves as the entry.
    let user_main = forge_llvm_get_named_function(m, "main")
    let main_name = if user_main == null { "main" } else { "__bs_top_level" }
    let main_params = forge_llvm_type_array_new(0)
    let main_type = forge_llvm_function_type(i64t, main_params, 0, 0)
    forge_llvm_type_array_free(main_params)
    let main_fn = forge_llvm_add_function(m, main_name, main_type)

    let entry = forge_llvm_append_basic_block(lc, main_fn, "entry")
    forge_llvm_position_at_end(builder, entry)

    let ctx = Ctx {
        lc,
        module: m,
        builder,
        current_fn: main_fn,
        current_fn_name: main_name,
        i64_type: i64t,
        i1_type: i1t,
        ptr_type: pt,
        double_type: forge_llvm_double_type(lc),
        structs,
        enums,
        fn_rets,
        fn_params,
        top_level_vars,
        loops: LoopStack.End,
        defers: DeferStack.End,
        features: build_registry(),
        trait_decls,
        debug_null_checks,
        source_file,
        source_line: 0,
    }

    // Pass 2: emit each user-defined function's body, then emit
    // every non-function top-level statement into main.
    let body_result = emit_function_bodies(ctx, stmts)
    if body_result.had_error {
        ctx.dispose()
        return CodegenResult { had_error: true, error_message: body_result.error_message }
    }

    // After emitting any function bodies, the builder may be sitting
    // in a function-body block. Reposition it back at main's entry
    // before emitting top-level statements.
    ctx.position(entry)
    let initial: VarEnv = VarEnv.End
    let result = emit_top_level(ctx, initial, stmts)
    if result.had_error {
        ctx.dispose()
        return CodegenResult { had_error: true, error_message: result.error_message }
    }

    // Default return 0 if the program didn't end in an explicit return
    if !ctx.has_terminator() {
        ctx.ret(ctx.i64(0), .Int)
    }

    ctx.verify_module()
    let write_result = ctx.write_ir(output_path)
    ctx.dispose()

    if write_result != 0 {
        return CodegenResult { had_error: true, error_message: "codegen error: failed to write IR to ${output_path}" }
    }

    CodegenResult { had_error: false, error_message: "" }
}

// Rebuild a FieldList with `resolved` populated from `translate_param_type`.
fn resolve_field_list(fields: FieldList, structs: StructReg, enums: EnumReg) -> FieldList {
    match fields {
        .End -> .End
        .Node(name, ty, _, next) ->
            .Node(name, ty, translate_param_type(structs, enums, ty), resolve_field_list(next, structs, enums))
    }
}

// Rebuild a ParamList with `resolved` populated from `translate_param_type`.
fn resolve_param_list(params: ParamList, structs: StructReg, enums: EnumReg) -> ParamList {
    match params {
        .End -> .End
        .Node(name, ty, _, next) ->
            .Node(name, ty, translate_param_type(structs, enums, ty), resolve_param_list(next, structs, enums))
    }
}

fn fill_struct_field_types(arr: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, fields: FieldList, idx: int) {
    match fields {
        .End -> {}
        .Node(_, _, resolved, next) -> {
            forge_llvm_type_array_set(arr, idx, llvm_type_for_full(i64t, i1t, dt, pt, resolved))
            fill_struct_field_types(arr, i64t, i1t, dt, pt, next, idx + 1)
        }
    }
}

fn declare_structs(ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, stmts: StmtList, reg: StructReg) -> StructReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .TypeDecl(name, fields) -> {
                    let op_fields = resolve_type_operator(fields, reg)
                    let resolved_fields = resolve_field_list(op_fields, reg, EnumReg.End)
                    let count = field_list_length(resolved_fields)
                    let field_arr = forge_llvm_type_array_new(count)
                    fill_struct_field_types(field_arr, i64t, i1t, dt, pt, resolved_fields, 0)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, count, 0)
                    forge_llvm_type_array_free(field_arr)
                    StructReg.Node(name, resolved_fields, reg)
                }
                .Module(_, body) -> declare_structs(ctx, i64t, i1t, dt, pt, body, reg)
                _ -> reg
            }
            declare_structs(ctx, i64t, i1t, dt, pt, next, updated)
        }
    }
}

fn declare_globals(m: ptr, ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: TopLevelVars) -> TopLevelVars {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Let(name, ty, _) -> {
                    let vt = translate_param_type(structs, enums, ty)
                    let llvm_ty = llvm_type_for_full(i64t, i1t, dt, pt, vt)
                    let g = forge_llvm_add_global(m, llvm_ty, name)
                    forge_llvm_set_initializer(g, forge_llvm_const_null(llvm_ty))
                    TopLevelVars.Node(name, g, vt, reg)
                }
                .Mut(name, ty, _) -> {
                    let vt = translate_param_type(structs, enums, ty)
                    let llvm_ty = llvm_type_for_full(i64t, i1t, dt, pt, vt)
                    let g = forge_llvm_add_global(m, llvm_ty, name)
                    forge_llvm_set_initializer(g, forge_llvm_const_null(llvm_ty))
                    TopLevelVars.Node(name, g, vt, reg)
                }
                .Module(_, body) -> declare_globals(m, ctx, i64t, i1t, dt, pt, structs, enums, body, reg)
                _ -> reg
            }
            declare_globals(m, ctx, i64t, i1t, dt, pt, structs, enums, next, updated)
        }
    }
}

// Declare per-variant payload struct types: %EnumName.VariantName = type { field_types... }
fn declare_variant_payloads(lc: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, enum_name: string, variants: VariantList, structs: StructReg, enums: EnumReg) {
    match variants {
        .End -> {}
        .Node(vname, fields, next) -> {
            let count = field_list_length(fields)
            if count > 0 {
                let payload_name = "${enum_name}__${vname}"
                let resolved_fields = resolve_field_list(fields, structs, enums)
                let arr = forge_llvm_type_array_new(count)
                fill_struct_field_types(arr, i64t, i1t, dt, pt, resolved_fields, 0)
                let st = forge_llvm_struct_create_named(lc, payload_name)
                forge_llvm_struct_set_body(st, arr, count, 0)
                forge_llvm_type_array_free(arr)
            }
            declare_variant_payloads(lc, i64t, i1t, dt, pt, enum_name, next, structs, enums)
        }
    }
}

fn declare_enums(ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, stmts: StmtList, structs: StructReg, reg: EnumReg) -> EnumReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .EnumDecl(name, variants) -> {
                    // Enum outer layout: {i64 tag, ptr payload}
                    let field_arr = forge_llvm_type_array_new(2)
                    forge_llvm_type_array_set(field_arr, 0, i64t)
                    forge_llvm_type_array_set(field_arr, 1, forge_llvm_pointer_type(ctx))
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, 2, 0)
                    forge_llvm_type_array_free(field_arr)
                    // Per-variant typed payload structs
                    declare_variant_payloads(ctx, i64t, i1t, dt, pt, name, variants, structs, reg)
                    EnumReg.Node(name, variants, reg)
                }
                .Module(_, body) -> declare_enums(ctx, i64t, i1t, dt, pt, body, structs, reg)
                _ -> reg
            }
            declare_enums(ctx, i64t, i1t, dt, pt, next, structs, updated)
        }
    }
}

fn collect_trait_decls(stmts: StmtList, reg: TraitDeclReg) -> TraitDeclReg {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let updated = match stmt_unwrap(ss.node) {
                .TraitDecl(name, methods) -> .Node(name, collect_trait_fn_names(methods), reg)
                .Module(_, body) -> collect_trait_decls(body, reg)
                _ -> reg
            }
            collect_trait_decls(next, updated)
        }
    }
}

fn collect_trait_fn_names(stmts: StmtList) -> TraitMethodNames {
    match stmts {
        .End -> .End
        .Node(ss, next) -> {
            match stmt_unwrap(ss.node) {
                .ExternFn(name, _, ret_ty) -> .Node(name, ret_ty, collect_trait_fn_names(next))
                .Function(name, _, ret_ty, _) -> .Node(name, ret_ty, collect_trait_fn_names(next))
                _ -> collect_trait_fn_names(next)
            }
        }
    }
}

fn resolve_type_operator(fields: FieldList, reg: StructReg) -> FieldList {
    match fields {
        .Node(name, base_name, _, rest) if name == "__base" -> {
            match rest {
                .Node(op_name, op, _, excluded_fields) -> {
                    let base_lookup = struct_reg_lookup(reg, base_name)
                    if !base_lookup.found { return FieldList.End }
                    if op == "without" {
                        return filter_fields_without(base_lookup.fields, excluded_fields)
                    }
                    if op == "only" {
                        return filter_fields_only(base_lookup.fields, excluded_fields)
                    }
                    base_lookup.fields
                }
                _ -> fields
            }
        }
        _ -> fields
    }
}

fn filter_fields_without(base: FieldList, excluded: FieldList) -> FieldList {
    match base {
        .End -> .End
        .Node(name, _, _, next) if field_list_has(excluded, name) -> filter_fields_without(next, excluded)
        .Node(name, ty, r, next) -> .Node(name, ty, r, filter_fields_without(next, excluded))
    }
}

fn filter_fields_only(base: FieldList, included: FieldList) -> FieldList {
    match base {
        .End -> .End
        .Node(name, ty, r, next) if field_list_has(included, name) -> .Node(name, ty, r, filter_fields_only(next, included))
        .Node(_, _, _, next) -> filter_fields_only(next, included)
    }
}

fn field_list_has(list: FieldList, target: string) -> bool {
    match list {
        .End -> false
        .Node(name, _, _, _) if name == target -> true
        .Node(_, _, _, next) -> field_list_has(next, target)
    }
}

fn fill_i64_param_array_offset(arr: ptr, i64t: ptr, base: int, count: int) {
    if count <= 0 {
        return
    }
    forge_llvm_type_array_set(arr, base, i64t)
    fill_i64_param_array_offset(arr, i64t, base + 1, count - 1)
}

// Fill a type array with the correct LLVM types for each parameter.
fn fill_typed_param_array(arr: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, params: ParamList, idx: int) {
    match params {
        .End -> {}
        .Node(_, _, resolved, next) -> {
            forge_llvm_type_array_set(arr, idx, llvm_type_for_full(i64t, i1t, dt, pt, resolved))
            fill_typed_param_array(arr, i64t, i1t, dt, pt, next, idx + 1)
        }
    }
}

fn decl_fn_ret_type(structs: StructReg, enums: EnumReg, ret_ty: string, body: StmtList) -> ValueType {
    let base = translate_param_type(structs, enums, ret_ty)
    let last = stmts_last_expr(body)
    match last {
        .Lambda(_, _) -> {
            let inner_ret = vtype_fn_ret(base)
            ValueType.Closure(-1, inner_ret)
        }
        _ -> base
    }
}

fn declare_functions(m: ptr, ctx: ptr, i64t: ptr, i1t: ptr, dt: ptr, pt: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: FnRetTypes) -> FnRetTypes {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Function(name, params, ret_ty, body) -> {
                    // Names are already qualified by the name resolution pass
                    let resolved_params = resolve_param_list(params, structs, enums)
                    let arity = param_list_length(resolved_params)
                    let existing = forge_llvm_get_named_function(m, name)
                    if existing != null {
                        eprintln("FATAL: duplicate function `${name}` — rename to avoid collision")
                        exit(1)
                    }
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_typed_param_array(param_arr, i64t, i1t, dt, pt, resolved_params, 0)
                    let ret_vt = decl_fn_ret_type(structs, enums, ret_ty, body)
                    let ret_llvm = llvm_type_for_full(i64t, i1t, dt, pt, ret_vt)
                    let fn_type = forge_llvm_function_type(ret_llvm, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    FnRetTypes.Node(name, ret_vt, reg)
                }
                .ExternFn(name, params, ret_ty) -> {
                    let resolved_params = resolve_param_list(params, structs, enums)
                    let arity = param_list_length(resolved_params)
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_typed_param_array(param_arr, i64t, i1t, dt, pt, resolved_params, 0)
                    let ret_vt = translate_param_type(structs, enums, ret_ty)
                    let ret_llvm = llvm_type_for_full(i64t, i1t, dt, pt, ret_vt)
                    let fn_type = forge_llvm_function_type(ret_llvm, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    FnRetTypes.Node(name, ret_vt, reg)
                }
                .Impl(_, methods) -> declare_functions(m, ctx, i64t, i1t, dt, pt, structs, enums, methods, reg)
                .Module(_, body) -> declare_functions(m, ctx, i64t, i1t, dt, pt, structs, enums, body, reg)
                _ -> reg
            }
            declare_functions(m, ctx, i64t, i1t, dt, pt, structs, enums, next, updated)
        }
    }
}

fn params_to_type_list(params: ParamList) -> ParamTypeList {
    match params {
        .End -> .End
        .Node(_, ty, _, next) -> .Node(ty, params_to_type_list(next))
    }
}

fn collect_fn_params(stmts: StmtList, reg: FnParamTypes) -> FnParamTypes {
    match stmts {
        .End -> reg
        .Node(ss, next) -> {
            let stmt = stmt_unwrap(ss.node)
            let updated = match stmt {
                .Function(name, params, _, _) -> {
                    .Node(name, params_to_type_list(params), reg)
                }
                .Impl(_, methods) -> collect_fn_params(methods, reg)
                .Module(_, body) -> collect_fn_params(body, reg)
                _ -> reg
            }
            collect_fn_params(next, updated)
        }
    }
}

fn emit_top_level(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let tl_ctx = ctx with { source_line: ss.line }
            let stmt = stmt_unwrap(ss.node)
            match stmt {
                .Function(_, _, _, _) -> emit_top_level(ctx, env, next)
                .Module(_, body) -> {
                    let r = emit_top_level(tl_ctx, env, body)?
                    emit_top_level(ctx, r.env, next)
                }
                .Let(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)
                    if result.had_error {
                        return err_stmt(result.error_message)
                    }
                    emit_top_level(result.ctx, result.env, next)
                }
                .Mut(name, _, init) -> {
                    let result = emit_top_level_init(tl_ctx, env, name, init)
                    if result.had_error {
                        return err_stmt(result.error_message)
                    }
                    emit_top_level(result.ctx, result.env, next)
                }
                _ -> {
                    let result = emit_stmt(tl_ctx, env, stmt)
                    if result.had_error {
                        return result
                    }
                    emit_top_level(ctx, result.env, next)
                }
            }
        }
    }
}

fn emit_top_level_init(ctx: Ctx, env: VarEnv, name: string, init: Expr) -> TopLevelResult {
    let g = ctx.lookup_toplevel(name)
    if !g.found {
        return TopLevelResult { ctx, env, had_error: true, error_message: "codegen error: global `${name}` not declared" }
    }
    let r = ctx.emit(env, init)
    if r.had_error {
        return TopLevelResult { ctx, env, had_error: true, error_message: r.error_message }
    }
    ctx.store(r.value, g.llvm_global)
    let updated_top = TopLevelVars.Node(name, g.llvm_global, r.ty, ctx.top_level_vars)
    let updated_cg = ctx.with_top_level(updated_top)
    TopLevelResult { ctx: updated_cg, env, had_error: false, error_message: "" }
}

