// WHY: recursive-descent parser with integrated lexer. Scans source
// text one token at a time and builds an AST. Precedence is encoded
// in the call chain: assignment → pipe → null_coalesce → or → and →
// equality → comparison → term → factor → unary → call → primary.
// Feature-specific parsers extend Parser via cross-file impl blocks.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, Pattern, MatchArmList, BinOp, UnOp, LogicOp, SExpr, SStmt, sexpr, sexpr_dummy, sstmt, AnnotationList}
use core.registry.{Registry, build_registry, lookup_decl_parser, lookup_stmt_parser}
use diagnostics.{Span, DiagCode, Diagnostic, DiagnosticBag, bag_new, bag_report, diag_error, diag_with_help, span_new}

export type ParseResult = {
    expr: Expr?,
    had_error: bool,
    error_message: string,
}

export type ProgramParseResult = {
    stmts: StmtList?,
    had_error: bool,
    error_message: string,
    bag: DiagnosticBag,
}

export type Parser = {
    source: string,
    mut start: int,
    mut current: int,
    mut line: int,
    mut column: int,
    mut current_kind: string,
    mut current_lexeme: string,
    mut current_line: int,
    mut current_column: int,
    mut prev_line: int,
    mut had_error: bool,
    mut error_message: string,
    // When false, `Ident { ... }` is parsed as Ident followed by a
    // separate block (used inside `if`/`while` conditions to avoid
    // grabbing the loop body brace as a struct literal). When true,
    // `Ident { ... }` becomes a struct literal expression.
    mut allow_struct_lit: bool,
    // When false, parse_call's loop won't consume `.` as a postfix.
    // Disabled inside match-arm bodies so the next sibling pattern
    // (e.g. `.Variant(x)`) isn't gobbled into the previous body.
    mut allow_dot_postfix: bool,
    // When true, expressions containing `it` in arg lists are wrapped
    // in implicit lambdas. Set by method call parsing (.map, etc.),
    // NOT by regular function calls (prevents double-wrapping).
    mut allow_it_sugar: bool,
    mut current_start: int,   // byte offset where current token started
    mut bag: DiagnosticBag,
    features: Registry,
}

export fn parse_expression_source(source: string) -> ParseResult {
    mut parser = parser_new(source)
    parser.parse_file_expression()
}

export fn parse_program_source(source: string) -> ProgramParseResult {
    mut parser = parser_new(source)
    parser.parse_file_program()
}

fn p_is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

fn p_is_alpha(ch: string) -> bool {
    (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

fn p_is_alpha_numeric(ch: string) -> bool {
    p_is_alpha(ch) || p_is_digit(ch)
}

fn p_is_hex_digit(ch: string) -> bool {
    p_is_digit(ch) || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F")
}

fn p_is_binary_digit(ch: string) -> bool {
    ch == "0" || ch == "1"
}

fn p_is_octal_digit(ch: string) -> bool {
    ch >= "0" && ch <= "7"
}

fn reverse_expr_list(list: ExprList) -> ExprList {
    reverse_expr_list_acc(list, ExprList.End)
}
fn reverse_expr_list_acc(list: ExprList, acc: ExprList) -> ExprList {
    match list {
        .End -> acc
        .Node(se, next) -> reverse_expr_list_acc(next, ExprList.Node(se, acc))
    }
}

// Interleave header names and values: [k1,k2] + [v1,v2] → [k1,v1,k2,v2]
// MapLit expects entries as flat: key1, val1, key2, val2, ...
fn table_zip_entries(headers: ExprList, values: ExprList) -> ExprList {
    match headers {
        .End -> ExprList.End
        .Node(hse, hnext) -> {
            match values {
                .End -> ExprList.End
                .Node(vse, vnext) -> {
                    ExprList.Node(hse, ExprList.Node(vse, table_zip_entries(hnext, vnext)))
                }
            }
        }
    }
}

fn expr_is_ident(e: Expr) -> bool {
    match e {
        .Ident(_) -> true
        .QualifiedIdent(_) -> true
        _ -> false
    }
}

fn expr_is_upper_ident(e: Expr) -> bool {
    match e {
        .Ident(n) -> p_starts_with_upper(n)
        .QualifiedIdent(n) -> p_starts_with_upper(n)
        _ -> false
    }
}

// Convert a list of Ident expressions into a ParamList (for lambda parsing).
// (x, y) -> ... parses the parens as expressions first, then reinterprets
// the Ident names as parameter names when -> is seen.
fn exprs_to_params(exprs: ExprList) -> ParamList {
    match exprs {
        .End -> ParamList.End
        .Node(se, next) -> {
            let name = match se.node {
                .Ident(n) -> n
                .QualifiedIdent(n) -> n
                _ -> "_"  // non-ident in lambda params — use placeholder
            }
            ParamList.Node(name, "i64", exprs_to_params(next))
        }
    }
}

// Check if an expression tree references the identifier `it`.
// Used by `it` parameter sugar: `list.map(it * 2)` becomes
// `list.map((it) -> { it * 2 })`.
fn expr_contains_it(expr: Expr) -> bool {
    match expr {
        .Ident(n) -> n == "it"
        .Binary(l, _, r) -> expr_contains_it(l) || expr_contains_it(r)
        .Unary(_, r) -> expr_contains_it(r)
        .Logical(l, _, r) -> expr_contains_it(l) || expr_contains_it(r)
        .Call(callee, args) -> expr_contains_it(callee) || expr_list_contains_it(args)
        .Grouping(inner) -> expr_contains_it(inner)
        .IfExpr(c, t, e) -> expr_contains_it(c) || expr_contains_it(t) || expr_contains_it(e)
        .Block(stmts) -> stmt_list_contains_it(stmts)
        .Index(obj, idx) -> expr_contains_it(obj) || expr_contains_it(idx)
        .FieldAccess(obj, _) -> expr_contains_it(obj)
        .FieldAssign(obj, _, val) -> expr_contains_it(obj) || expr_contains_it(val)
        .Assign(_, val) -> expr_contains_it(val)
        .NullCoalesce(l, r) -> expr_contains_it(l) || expr_contains_it(r)
        .OptionalChain(obj, _) -> expr_contains_it(obj)
        .Try(inner) -> expr_contains_it(inner)
        .Tuple(elems) -> expr_list_contains_it(elems)
        .TupleIndex(obj, _) -> expr_contains_it(obj)
        .With(obj, _) -> expr_contains_it(obj)
        .ListLit(elems) -> expr_list_contains_it(elems)
        .MapLit(entries) -> expr_list_contains_it(entries)
        .Slice(obj, s, e) -> expr_contains_it(obj) || expr_contains_it(s) || expr_contains_it(e)
        .MatchExpr(subj, _) -> expr_contains_it(subj)
        _ -> false
    }
}

fn expr_list_contains_it(list: ExprList) -> bool {
    match list {
        .End -> false
        .Node(se, next) -> expr_contains_it(se.node) || expr_list_contains_it(next)
    }
}

fn stmt_list_contains_it(list: StmtList) -> bool {
    match list {
        .End -> false
        .Node(ss, next) -> {
            let has = match ss.node {
                .Expr(e) -> expr_contains_it(e)
                .Let(_, _, init) -> expr_contains_it(init)
                .Mut(_, _, init) -> expr_contains_it(init)
                .Return(val) -> expr_contains_it(val)
                _ -> false
            }
            has || stmt_list_contains_it(next)
        }
    }
}

// Wrap an expression in an implicit `(it) -> { expr }` lambda.
fn wrap_in_it_lambda(expr: Expr) -> Expr {
    Expr.Lambda(ParamList.Node("it", "", ParamList.End), expr)
}

fn p_starts_with_upper(name: string) -> bool {
    if name.length < 1 {
        return false
    }
    let head = name.substring(0, 1)
    head >= "A" && head <= "Z"
}

// Check if a template interpolation content is a simple identifier
// (letters, digits, underscores only). Simple idents don't need a
// sub-parser — they're just Expr.Ident.
fn template_is_simple_ident(s: string) -> bool {
    if s.length == 0 { return false }
    mut i = 0
    while i < s.length {
        let ch = s[i]
        if !p_is_alpha_numeric(ch) {
            return false
        }
        i = i + 1
    }
    true
}

// Parse a sub-expression from a string (used by template desugaring).
// Creates its own parser instance to avoid mutating the parent.
fn parse_template_expr(source: string) -> Expr? {
    mut p = parser_new(source)
    p.parse_expression()
}

fn p_keyword_kind(text: string) -> string {
    if text == "and" { return "kw_and" }
    if text == "const" { return "kw_const" }
    if text == "else" { return "kw_else" }
    if text == "false" { return "kw_false" }
    if text == "fn" { return "kw_fn" }
    if text == "if" { return "kw_if" }
    if text == "let" { return "kw_let" }
    if text == "mut" { return "kw_mut" }
    if text == "not" { return "kw_not" }
    if text == "null" { return "kw_null" }
    if text == "or" { return "kw_or" }
    if text == "return" { return "kw_return" }
    if text == "true" { return "kw_true" }
    if text == "for" { return "kw_for" }
    if text == "in" { return "kw_in" }
    if text == "while" { return "kw_while" }
    if text == "type" { return "kw_type" }
    if text == "enum" { return "kw_enum" }
    if text == "match" { return "kw_match" }
    if text == "export" { return "kw_export" }
    if text == "use" { return "kw_use" }
    if text == "mod" { return "kw_mod" }
    if text == "impl" { return "kw_impl" }
    if text == "extern" { return "kw_extern" }
    if text == "break" { return "kw_break" }
    if text == "continue" { return "kw_continue" }
    if text == "defer" { return "kw_defer" }
    if text == "trait" { return "kw_trait" }
    if text == "with" { return "kw_with" }
    if text == "is" { return "kw_is" }
    if text == "spec" { return "kw_spec" }
    if text == "given" { return "kw_given" }
    if text == "then" { return "kw_then" }
    if text == "select" { return "kw_select" }
    if text == "parallel" { return "kw_parallel" }
    return "identifier"
}

export fn parser_new(source: string) -> Parser {
    mut parser = Parser {
        source,
        start: 0,
        current: 0,
        line: 1,
        column: 1,
        current_kind: "",
        current_lexeme: "",
        current_line: 1,
        prev_line: 1,
        current_column: 1,
        had_error: false,
        error_message: "",
        allow_struct_lit: true,
        allow_dot_postfix: true,
        allow_it_sugar: false,
        current_start: 0,
        bag: bag_new(),
        features: build_registry(),
    }
    parser.advance_token()
    parser
}

impl Parser {
    fn parse_file_expression(self) -> ParseResult {
        let expr = self.parse_expression()
        if expr == null {
            return ParseResult {
                expr: null,
                had_error: self.had_error,
                error_message: self.error_message,
            }
        }

        if !self.check("eof") {
            self.set_error("expected end of input")
            return ParseResult {
                expr: null,
                had_error: true,
                error_message: self.error_message,
            }
        }

        ParseResult {
            expr,
            had_error: self.had_error,
            error_message: self.error_message,
        }
    }

    fn parse_file_program(self) -> ProgramParseResult {
        let stmts = self.parse_statement_list(false)
        if stmts == null {
            return ProgramParseResult {
                stmts: null,
                had_error: self.had_error,
                error_message: self.error_message,
                bag: self.bag,
            }
        }

        if !self.check("eof") {
            self.set_error("expected end of input")
            return ProgramParseResult {
                stmts: null,
                had_error: true,
                error_message: self.error_message,
                bag: self.bag,
            }
        }

        ProgramParseResult {
            stmts,
            had_error: self.had_error,
            error_message: self.error_message,
            bag: self.bag,
        }
    }

    fn parse_statement_list(self, stop_at_right_brace: bool) -> StmtList? {
        if stop_at_right_brace && self.check("right_brace") {
            return StmtList.End
        }

        if self.check("eof") {
            return StmtList.End
        }

        if !stop_at_right_brace && self.check("right_brace") {
            // Report but recover — skip the `}` and keep going
            self.report(DiagCode.MismatchedBrace, "unexpected `}`")
            self.advance()
            return self.parse_statement_list(stop_at_right_brace)
        }

        // Capture line/col BEFORE parsing the statement so the SStmt
        // points at the start of the declaration, not the end.
        let stmt_line = self.current_line
        let stmt_col = self.current_column
        let stmt = self.parse_declaration()
        if stmt == null {
            self.synchronize()
            return self.parse_statement_list(stop_at_right_brace)
        }

        let next = self.parse_statement_list(stop_at_right_brace)?

        StmtList.Node(sstmt(stmt!, stmt_line, stmt_col), next)
    }

    fn parse_declaration(self) -> Stmt? {
        // Annotations: `@name` or `@name(args)` before a declaration.
        if self.check("at") {
            let annotations = self.parse_annotations()
            let inner = self.parse_declaration()
            if inner == null { return null }
            return Stmt.Annotated(annotations, inner!)
        }

        // `export` wraps the inner declaration in an @export annotation
        // so the module system's name resolution pass can enforce visibility.
        // Only fn, type, enum, trait, and extern are exportable — no stacking.
        if self.check("kw_export") {
            self.advance()
            let export_handler_raw = lookup_decl_parser(self.features, self.current_kind)
            let inner = if export_handler_raw != null {
                let handler: fn(Parser) -> Stmt? = export_handler_raw!
                handler(self)
            } else {
                self.set_error("expected declaration after `export`")
                null
            }
            if inner == null { return null }
            return Stmt.Annotated(
                AnnotationList.Node("export", ExprList.End, AnnotationList.End),
                inner!
            )
        }

        let decl_raw = lookup_decl_parser(self.features, self.current_kind)
        if decl_raw != null {
            let handler: fn(Parser) -> Stmt? = decl_raw!
            return handler(self)
        }

        self.parse_statement()
    }

    // Parse parallel block: parallel { stmt1; stmt2 }
    // Each statement runs in its own thread, all joined at block end.
    fn parse_parallel_statement(self) -> Stmt? {
        self.advance()  // consume `parallel`
        if !self.consume("left_brace", "expected `{` after parallel") {
            return null
        }
        let body = self.parse_statement_list(true)
        if body == null { return null }
        if !self.consume("right_brace", "expected `}` to close parallel block") {
            return null
        }
        Stmt.Parallel(body!)
    }

    // Parse select statement: select { binding <- channel -> { body } }
    fn parse_select_statement(self) -> Stmt? {
        self.advance()  // consume `select`
        if !self.consume("left_brace", "expected `{` after select") {
            return null
        }
        let arms = self.parse_select_arm_list()
        if !self.consume("right_brace", "expected `}` to close select") {
            return null
        }
        Stmt.Select(arms)
    }

    fn parse_select_arm_list(self) -> SelectArmList {
        if self.check("right_brace") || self.check("eof") {
            return SelectArmList.End
        }
        // Parse: binding <- channel -> { body }
        if !self.check("identifier") { return SelectArmList.End }
        let binding = self.current_lexeme
        self.advance()
        // Expect `<-`
        if !self.check("less") { return SelectArmList.End }
        self.advance()  // consume <
        if !self.check("minus") { return SelectArmList.End }
        self.advance()  // consume -
        // Parse channel expression
        let channel = self.parse_expression()
        if channel == null { return SelectArmList.End }
        // Expect `->`
        if !self.consume("arrow", "expected `->` after channel in select arm") {
            return SelectArmList.End
        }
        // Parse body block
        if !self.consume("left_brace", "expected `{` for select arm body") {
            return SelectArmList.End
        }
        let body = self.parse_statement_list(true)
        if body == null { return SelectArmList.End }
        if !self.consume("right_brace", "expected `}` to close select arm") {
            return SelectArmList.End
        }
        SelectArmList.Node(binding, channel!, body!, self.parse_select_arm_list())
    }

    // Parse one or more annotations: @name or @name(arg1, arg2)
    fn parse_annotations(self) -> AnnotationList {
        if !self.check("at") { return AnnotationList.End }
        self.advance()  // consume @
        let name = self.current_lexeme
        self.advance()  // consume name
        // Optional argument list
        let args = if self.check("left_paren") {
            self.advance()  // consume (
            let a = self.parse_arg_list()
            if self.check("right_paren") { self.advance() }
            if a == null { ExprList.End } else { a! }
        } else {
            ExprList.End
        }
        AnnotationList.Node(name, args, self.parse_annotations())
    }

    // Parse table literal: table { col1 | col2\n val1 | val2\n val3 | val4 }
    // Desugars to ListLit of MapLit entries.
    fn parse_table_literal(self) -> Expr? {
        self.advance()  // consume `{`
        // Parse header row: identifiers separated by `|`
        mut headers: ExprList = ExprList.End
        mut header_count = 0
        let header_line = self.current_line
        while !self.check("right_brace") && !self.check("eof") && self.current_line == header_line {
            if self.check("identifier") {
                let col = self.current_lexeme
                self.advance()
                let quoted_col = "\"" + col + "\""
                headers = ExprList.Node(sexpr(Expr.String(quoted_col), self.current_line, self.current_column), headers)
                header_count = header_count + 1
                if self.check("pipe") {
                    self.advance()
                }
            } else {
                break
            }
        }
        if header_count == 0 {
            if !self.consume("right_brace", "expected `}` to close table") { return null }
            return Expr.ListLit(ExprList.End)
        }
        let header_names = reverse_expr_list(headers)
        // Parse data rows
        mut rows: ExprList = ExprList.End
        while !self.check("right_brace") && !self.check("eof") {
            mut vals: ExprList = ExprList.End
            mut col_idx = 0
            while col_idx < header_count {
                if self.check("right_brace") { break }
                // Use parse_bitwise_xor which stops before `|`
                let val = self.parse_bitwise_xor()
                if val == null { return null }
                vals = ExprList.Node(sexpr(val!, self.current_line, self.current_column), vals)
                col_idx = col_idx + 1
                if self.check("pipe") {
                    self.advance()
                }
            }
            if col_idx == header_count {
                let map_entries = table_zip_entries(header_names, reverse_expr_list(vals))
                let row_map = Expr.MapLit(map_entries)
                rows = ExprList.Node(sexpr(row_map, self.current_line, self.current_column), rows)
            }
        }
        if !self.consume("right_brace", "expected `}` to close table") {
            return null
        }
        Expr.ListLit(reverse_expr_list(rows))
    }

    // Module parser (parse_module_declaration, parse_use_declaration)
    // lives in features/modules/parser.fg.

    // Feature-specific parsers live in features/*/parser.fg.
    // They extend Parser via `impl Parser { ... }` blocks.

    fn parse_statement(self) -> Stmt? {
        if self.check("left_brace") {
            self.advance()
            let body = self.parse_statement_list(true)?
            if !self.consume("right_brace", "expected `}` after block") {
                return null
            }
            return Stmt.Block(body)
        }

        if self.check("kw_break") {
            self.advance()
            return Stmt.Break
        }

        if self.check("kw_continue") {
            self.advance()
            return Stmt.Continue
        }

        let stmt_raw = lookup_stmt_parser(self.features, self.current_kind)
        if stmt_raw != null {
            let handler: fn(Parser) -> Stmt? = stmt_raw!
            return handler(self)
        }

        let expr = self.parse_expression()?
        Stmt.Expr(expr)
    }

    fn parse_expression(self) -> Expr? {
        self.parse_assignment()
    }

    fn parse_assignment(self) -> Expr? {
        let left = self.parse_pipe()?

        if !self.check("equal") {
            return left
        }

        self.advance()
        let value = self.parse_assignment()?

        match left {
            .Ident(name) -> Expr.Assign(name, value)
            .FieldAccess(obj, field) -> Expr.FieldAssign(obj, field, value)
            _ -> {
                self.set_error("invalid assignment target")
                null
            }
        }
    }

    fn parse_pipe(self) -> Expr? {
        let left = self.parse_null_coalesce()?

        mut expr = left
        while self.check("pipe_gt") {
            self.advance()
            let rhs = self.parse_or()?
            // Desugar: `a |> f` → `f(a)`, `a |> f(b)` → `f(a, b)`
            match rhs {
                .Call(callee, args) -> {
                    expr = Expr.Call(callee, ExprList.Node(sexpr(expr, self.current_line, self.current_column), args))
                }
                _ -> {
                    expr = Expr.Call(rhs, ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End))
                }
            }
        }

        expr
    }

    fn parse_null_coalesce(self) -> Expr? {
        let left = self.parse_or()?

        mut expr = left
        while self.check("question_question") {
            self.advance()
            let right = self.parse_or()?
            expr = Expr.NullCoalesce(expr, right)
        }

        expr
    }

    fn parse_or(self) -> Expr? {
        let left = self.parse_and()?

        mut expr = left
        while self.check("pipe_pipe") || self.check("kw_or") {
            self.advance()
            let right = self.parse_and()?
            expr = Expr.Logical(expr, LogicOp.Or, right)
        }

        expr
    }

    fn parse_and(self) -> Expr? {
        let left = self.parse_equality()?

        mut expr = left
        while self.check("amp_amp") || self.check("kw_and") {
            self.advance()
            let right = self.parse_equality()?
            expr = Expr.Logical(expr, LogicOp.And, right)
        }

        expr
    }

    fn parse_equality(self) -> Expr? {
        let left = self.parse_bitwise_or()?

        if self.check("kw_is") {
            self.advance()
            if !self.consume("dot", "expected `.Variant` after `is`") {
                return null
            }
            let vname = self.consume_identifier("expected variant name after `is .`")?
            return Expr.IsCheck(left, vname)
        }

        mut expr = left
        while self.check("equal_equal") || self.check("bang_equal") {
            let op = if self.check("equal_equal") { BinOp.Eq } else { BinOp.Ne }
            self.advance()
            let right = self.parse_bitwise_or()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_bitwise_or(self) -> Expr? {
        let left = self.parse_bitwise_xor()?
        mut expr = left
        while self.check("pipe") {
            self.advance()
            let right = self.parse_bitwise_xor()?
            expr = Expr.Binary(expr, BinOp.BitOr, right)
        }
        expr
    }

    fn parse_bitwise_xor(self) -> Expr? {
        let left = self.parse_bitwise_and()?
        mut expr = left
        while self.check("caret") {
            self.advance()
            let right = self.parse_bitwise_and()?
            expr = Expr.Binary(expr, BinOp.BitXor, right)
        }
        expr
    }

    fn parse_bitwise_and(self) -> Expr? {
        let left = self.parse_comparison()?
        mut expr = left
        while self.check("amp") {
            self.advance()
            let right = self.parse_comparison()?
            expr = Expr.Binary(expr, BinOp.BitAnd, right)
        }
        expr
    }

    fn parse_comparison(self) -> Expr? {
        let left = self.parse_shift()?

        mut expr = left
        while self.check("greater") || self.check("greater_equal") || self.check("less") || self.check("less_equal") {
            let op = if self.check("less") { BinOp.Lt }
                else if self.check("less_equal") { BinOp.Le }
                else if self.check("greater") { BinOp.Gt }
                else { BinOp.Ge }
            self.advance()
            let right = self.parse_shift()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_shift(self) -> Expr? {
        let left = self.parse_term()?
        mut expr = left
        while self.check("shl") || self.check("shr") {
            let op = if self.check("shl") { BinOp.Shl } else { BinOp.Shr }
            self.advance()
            let right = self.parse_term()?
            expr = Expr.Binary(expr, op, right)
        }
        expr
    }

    fn parse_term(self) -> Expr? {
        let left = self.parse_factor()?

        mut expr = left
        while self.check("plus") || self.check("minus") {
            let op = if self.check("plus") { BinOp.Add } else { BinOp.Sub }
            self.advance()
            let right = self.parse_factor()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_factor(self) -> Expr? {
        let left = self.parse_unary()?

        mut expr = left
        while self.check("star") || self.check("slash") || self.check("percent") {
            let op = if self.check("star") { BinOp.Mul }
                else if self.check("percent") { BinOp.Mod }
                else { BinOp.Div }
            self.advance()
            let right = self.parse_unary()?
            expr = Expr.Binary(expr, op, right)
        }

        expr
    }

    fn parse_unary(self) -> Expr? {
        if self.check("bang") || self.check("minus") || self.check("kw_not") || self.check("tilde") {
            let op = if self.check("minus") { UnOp.Neg }
                else if self.check("tilde") { UnOp.BitNot }
                else { UnOp.Not }
            self.advance()
            let right = self.parse_unary()?
            return Expr.Unary(op, right)
        }

        mut expr = self.parse_call()?
        // `expr with { field: value, ... }` — functional struct update (chainable)
        while self.check("kw_with") {
            self.advance()
            if !self.consume("left_brace", "expected `{` after `with`") {
                return null
            }
            let overrides = self.parse_field_init_list()?
            if !self.consume("right_brace", "expected `}` after with fields") {
                return null
            }
            expr = Expr.With(expr, overrides)
        }
        expr
    }

    // Peek at the source character immediately after the current
    // `.` token to see whether the next identifier starts with an
    // uppercase letter.
    fn peek_next_is_upper(self) -> bool {
        if self.current >= self.source.length {
            return false
        }
        let ch = self.source[self.current]
        ch >= "A" && ch <= "Z"
    }

    // Should the current `.` token be consumed as a field / method
    // / enum-ctor postfix on `result`?
    //
    // Always allowed in normal context (`allow_dot_postfix == true`).
    //
    // Inside a match arm body (`allow_dot_postfix == false`):
    //   - `.lowerIdent`  → always a field / method, never a sibling
    //                       pattern, so allow it
    //   - `.UpperIdent`  → might be a sibling pattern unless
    //                       `result` is itself an uppercase Ident
    //                       (an enum-type prefix like `Foo.Bar`).
    //                       Otherwise suppress so the next pattern
    //                       can be parsed.
    fn dot_is_postfix(self, result: Expr) -> bool {
        if self.allow_dot_postfix {
            return true
        }
        if !self.peek_next_is_upper() {
            return true
        }
        expr_is_upper_ident(result)
    }

    fn parse_call(self) -> Expr? {
        let expr = self.parse_primary()?

        mut result = expr
        // If [ appears on a DIFFERENT line than the previous token,
        // it's a new statement (list literal), not postfix indexing.
        while (self.check("left_paren") && self.current_line == self.prev_line) || (self.check("dot") && self.dot_is_postfix(result)) || self.check("bang") || (self.check("left_bracket") && self.current_line == self.prev_line) || self.check("question_dot") || self.check("question") {
            // Force-unwrap `expr!` is a no-op pass-through since we
            // don't track nullability in the value tag.
            while self.check("bang") {
                self.advance()
            }
            // Error propagation: `expr?` — if null, return null
            // from the enclosing function.
            if self.check("question") {
                self.advance()
                result = Expr.Try(result)
                continue
            }
            // Optional chaining: `expr?.field`
            if self.check("question_dot") {
                self.advance()
                let field = self.consume_identifier("expected field name after `?.`")?
                result = Expr.OptionalChain(result, field)
            } else if self.check("left_bracket") {
                self.advance()
                let idx = self.parse_expression()?
                // Slice: list[start..end]
                if self.check("dot_dot") {
                    self.advance()
                    let end = self.parse_expression()?
                    if !self.consume("right_bracket", "expected `]` after slice") {
                        return null
                    }
                    result = Expr.Slice(result, idx, end)
                    continue
                }
                if !self.consume("right_bracket", "expected `]` after index") {
                    return null
                }
                result = Expr.Index(result, idx)
            } else if !self.check("left_paren") && !self.check("dot") {
                return result
            } else {
            if self.check("left_paren") {
                self.advance()
                // Enable `it` sugar for method calls (obj.method(it * 2))
                // but not for regular function calls (to prevent
                // double-wrapping in `f(it)` inside `.map(f(it))`).
                let saved_it = self.allow_it_sugar
                let is_method = match result {
                    .FieldAccess(_, _) -> true
                    _ -> false
                }
                self.allow_it_sugar = is_method
                let args = self.parse_arg_list()?
                self.allow_it_sugar = saved_it
                if !self.consume("right_paren", "expected `)` after arguments") {
                    return null
                }
                result = Expr.Call(result, args)
            } else {
                self.advance()
                // Tuple index: `t.0`, `t.1` — number after dot
                if self.check("number") {
                    let idx_text = self.current_lexeme
                    self.advance()
                    result = Expr.TupleIndex(result, int(idx_text))
                    continue
                }
                let field = self.consume_identifier("expected field name after `.`")?
                // Detect enum constructor: `Type.Variant(args)`. We
                // distinguish from method calls by requiring the
                // head Ident to start with an uppercase letter
                // (Forge convention: types are PascalCase).
                let type_name = match result {
                    .Ident(n) -> {
                        if p_starts_with_upper(n) {
                            n
                        } else {
                            ""
                        }
                    }
                    _ -> ""
                }
                if type_name != "" && self.check("left_paren") {
                    self.advance()
                    let args = self.parse_arg_list()?
                    if !self.consume("right_paren", "expected `)` after arguments") {
                        return null
                    }
                    result = Expr.EnumCtor(type_name, field, args)
                } else {
                    result = Expr.FieldAccess(result, field)
                }
            }
            }
        }

        result
    }

    fn parse_arg_list(self) -> ExprList? {
        // Inside a paren-bounded arg list we're unambiguously not
        // at a sibling pattern position, so re-enable `.field`
        // postfix consumption.
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let result = self.parse_arg_list_inner()
        self.allow_dot_postfix = saved
        result
    }

    fn parse_arg_list_inner(self) -> ExprList? {
        if self.check("right_paren") {
            return ExprList.End
        }

        let raw_expr = self.parse_expression()?
        // `it` parameter sugar: only wrap if allow_it_sugar is set
        // (method calls like .map/.filter set this, regular function
        // calls do not, preventing double-wrapping in `f(it)` inside
        // `.map(f(it))`).
        let expr = if self.allow_it_sugar {
            match raw_expr {
                .Lambda(_, _) -> raw_expr
                _ -> {
                    if expr_contains_it(raw_expr) {
                        wrap_in_it_lambda(raw_expr)
                    } else {
                        raw_expr
                    }
                }
            }
        } else {
            raw_expr
        }

        if self.check("comma") {
            self.advance()
            let rest = self.parse_arg_list_inner()?
            return ExprList.Node(sexpr(expr, self.current_line, self.current_column), rest)
        }

        ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
    }

    fn parse_primary(self) -> Expr? {
        if self.check("number") {
            let value = self.current_lexeme
            self.advance()
            return Expr.Number(value)
        }

        if self.check("float") {
            let value = self.current_lexeme
            self.advance()
            return Expr.FloatLit(value)
        }

        if self.check("string") {
            let value = self.current_lexeme
            self.advance()
            return Expr.String(value)
        }

        if self.check("template") {
            let raw = self.current_lexeme
            self.advance()
            return self.desugar_template(raw)
        }

        if self.check("kw_true") || self.check("kw_false") {
            let value = self.current_lexeme
            self.advance()
            return Expr.Bool(value)
        }

        if self.check("kw_null") {
            self.advance()
            return Expr.Null
        }

        // Contextual enum variant: `.Variant` or `.Variant(args)`
        // Resolved at codegen time using the expected type from context.
        if self.check("dot") {
            self.advance()  // consume .
            if self.check("identifier") {
                let variant = self.current_lexeme
                self.advance()  // consume variant name
                if self.check("left_paren") {
                    self.advance()
                    let args = self.parse_arg_list()?
                    if !self.consume("right_paren", "expected `)` after variant args") {
                        return null
                    }
                    return Expr.EnumCtor("", variant, args)
                }
                return Expr.EnumCtor("", variant, ExprList.End)
            }
        }

        if self.check("identifier") {
            let name = self.current_lexeme
            self.advance()
            // Table literal: table { col1 | col2; val1 | val2 }
            // Must check BEFORE struct literal since both start with ident + {
            if name == "table" && self.check("left_brace") {
                return self.parse_table_literal()
            }
            if self.allow_struct_lit && self.check("left_brace") {
                self.advance()
                let inits = self.parse_field_init_list()?
                if !self.consume("right_brace", "expected `}` after struct fields") {
                    return null
                }
                return Expr.StructLit(name, inits)
            }
            // Tagged template: `tag`template with ${expr}`
            // Desugars to: tag(desugar_template(raw))
            if self.check("template") {
                let raw = self.current_lexeme
                self.advance()
                let template_expr = self.desugar_template(raw)
                if template_expr == null { return null }
                let args = ExprList.Node(sexpr(template_expr!, self.current_line, self.current_column), ExprList.End)
                return Expr.Call(Expr.Ident(name), args)
            }
            return Expr.Ident(name)
        }

        if self.check("left_paren") {
            self.advance()
            let saved = self.allow_dot_postfix
            self.allow_dot_postfix = true
            // Empty parens: () → could be empty tuple or zero-arg lambda
            if self.check("right_paren") {
                self.allow_dot_postfix = saved
                self.advance()
                // () -> expr  is a zero-arg lambda
                if self.check("arrow") {
                    self.advance()
                    let body = self.parse_lambda_body()?
                    return Expr.Lambda(ParamList.End, body)
                }
                return Expr.Tuple(ExprList.End)
            }
            // Typed lambda: (x: int, y: string) -> body
            // Detect by peeking: if current is identifier and next non-ws is ':'
            if self.check("identifier") && self.peek_after_ident_is_colon() {
                self.allow_dot_postfix = saved
                let params = self.parse_param_list()?
                if !self.consume("right_paren", "expected `)` after typed parameters") {
                    return null
                }
                if !self.consume("arrow", "expected `->` after typed lambda parameters") {
                    return null
                }
                let body = self.parse_lambda_body()?
                return Expr.Lambda(params, body)
            }
            let expr = self.parse_expression()
            self.allow_dot_postfix = saved
            if expr == null { return null }
            // (a, b, ...) — comma after first: tuple or multi-param lambda
            if self.check("comma") {
                self.advance()
                let rest = self.parse_tuple_rest()?
                if !self.consume("right_paren", "expected `)` after tuple") {
                    return null
                }
                // (a, b) -> expr  is a lambda
                if self.check("arrow") {
                    self.advance()
                    let params = exprs_to_params(ExprList.Node(sexpr(expr!, self.current_line, self.current_column), rest))
                    let body = self.parse_lambda_body()?
                    return Expr.Lambda(params, body)
                }
                return Expr.Tuple(ExprList.Node(sexpr(expr!, self.current_line, self.current_column), rest))
            }
            if !self.consume("right_paren", "expected `)` after expression") {
                return null
            }
            // (x) -> expr  is a single-param lambda
            if self.check("arrow") {
                self.advance()
                let params = exprs_to_params(ExprList.Node(sexpr(expr!, self.current_line, self.current_column), ExprList.End))
                let body = self.parse_lambda_body()?
                return Expr.Lambda(params, body)
            }
            return Expr.Grouping(expr!)
        }

        // List literal: [expr, expr, ...]
        if self.check("left_bracket") {
            self.advance()
            if self.check("right_bracket") {
                self.advance()
                return Expr.ListLit(ExprList.End)
            }
            let elements = self.parse_list_elements()?
            if !self.consume("right_bracket", "expected `]` after list") {
                return null
            }
            return Expr.ListLit(elements)
        }

        if self.check("kw_match") {
            return self.parse_match_expression()
        }

        if self.check("kw_if") {
            return self.parse_if_expression()
        }

        if self.check("left_brace") {
            // Map literal: { "key": value, ... }
            // Disambiguate from block: if first token after { is a string,
            // and the token after that is a colon, it's a map.
            if self.is_map_literal() {
                return self.parse_map_literal()
            }
            return self.parse_block_expression()
        }

        if self.current_lexeme == ";" {
            self.report(DiagCode.UnexpectedSemicolon, "unexpected `;`")
        } else {
            self.report(DiagCode.ExpectedExpression, "expected expression")
        }
        null
    }

    // Desugar `hello ${expr}!` into `"hello " + string(expr) + "!"`
    // The content between `${` and `}` is parsed as a full expression
    // by creating a sub-parser, so `${a + b}`, `${foo.bar}`, and
    // `${string(x)}` all work.
    fn desugar_template(self, raw: string) -> Expr? {
        mut result: Expr? = null
        mut i = 0
        let len = raw.length
        mut text_start = 0
        while i < len {
            if i + 1 < len && raw[i] == "$" && raw[i + 1] == "{" {
                // Flush text segment before the interpolation.
                if i > text_start {
                    let seg = "\"" + raw.substring(text_start, i) + "\""
                    let str_expr = Expr.String(seg)
                    if result == null {
                        result = str_expr
                    } else {
                        result = Expr.Binary(result!, BinOp.Add, str_expr)
                    }
                }
                // Find matching `}` (no nesting — braces inside
                // template expressions are not supported).
                let expr_start = i + 2
                mut j = expr_start
                mut brace_depth = 0
                while j < len {
                    if raw[j] == "{" { brace_depth = brace_depth + 1 }
                    if raw[j] == "}" {
                        if brace_depth == 0 { break }
                        brace_depth = brace_depth - 1
                    }
                    j = j + 1
                }
                if j >= len {
                    self.set_error("unterminated template expression in string")
                    return null
                }
                // Parse the content between ${ and } as an expression.
                // Simple identifiers become Expr.Ident directly. Complex
                // expressions (containing parens, dots, operators) use a
                // sub-parser. This split avoids creating a Parser struct
                // for the common case.
                let sub_source = raw.substring(expr_start, j)
                let parsed = if template_is_simple_ident(sub_source) {
                    Expr.Ident(sub_source)
                } else {
                    let sub_result = parse_template_expr(sub_source)
                    if sub_result == null {
                        self.set_error("invalid expression in template: " + sub_source)
                        return null
                    }
                    sub_result!
                }
                // Wrap in string() call for automatic conversion.
                let str_call = Expr.Call(Expr.Ident("string"), ExprList.Node(sexpr_dummy(parsed!), ExprList.End))
                if result == null {
                    result = str_call
                } else {
                    result = Expr.Binary(result!, BinOp.Add, str_call)
                }
                i = j + 1
                text_start = i
            } else {
                i = i + 1
            }
        }
        // Flush trailing text after last interpolation.
        if text_start < len {
            let seg = "\"" + raw.substring(text_start, len) + "\""
            let str_expr = Expr.String(seg)
            if result == null {
                result = str_expr
            } else {
                result = Expr.Binary(result!, BinOp.Add, str_expr)
            }
        }
        if result == null {
            result = Expr.String("\"\"")
        }
        result
    }

    // Lookahead: is the current `{` the start of a map literal?
    // A map starts with `{ "string" :` or `{ }` (empty map).
    fn is_map_literal(self) -> bool {
        // Save position for lookahead
        let saved_pos = self.current
        let saved_start = self.start
        let saved_kind = self.current_kind
        let saved_lex = self.current_lexeme

        self.advance()  // consume {
        let is_map = self.check("right_brace") || (self.check("string") && {
            self.advance()  // consume string
            self.check("colon")
        })

        // Restore position
        self.current = saved_pos
        self.start = saved_start
        self.current_kind = saved_kind
        self.current_lexeme = saved_lex
        is_map
    }

    fn parse_map_literal(self) -> Expr? {
        self.advance()  // consume {
        if self.check("right_brace") {
            self.advance()
            return Expr.MapLit(ExprList.End)
        }
        let entries = self.parse_map_entries()?
        if !self.consume("right_brace", "expected `}` after map") {
            return null
        }
        Expr.MapLit(entries)
    }

    // Parse key:value pairs into a flat list: key1, val1, key2, val2, ...
    fn parse_map_entries(self) -> ExprList? {
        let key = self.parse_expression()?
        if !self.consume("colon", "expected `:` after map key") {
            return null
        }
        let value = self.parse_expression()?
        if self.check("comma") {
            self.advance()
            if self.check("right_brace") {
                return ExprList.Node(sexpr(key, self.current_line, self.current_column), ExprList.Node(sexpr(value, self.current_line, self.current_column), ExprList.End))
            }
            let rest = self.parse_map_entries()?
            return ExprList.Node(sexpr(key, self.current_line, self.current_column), ExprList.Node(sexpr(value, self.current_line, self.current_column), rest))
        }
        ExprList.Node(sexpr(key, self.current_line, self.current_column), ExprList.Node(sexpr(value, self.current_line, self.current_column), ExprList.End))
    }

    fn parse_lambda_body(self) -> Expr? {
        // Lambda body: either a block { ... } or a single expression.
        if self.check("left_brace") {
            return self.parse_block_expression()
        }
        self.parse_expression()
    }

    fn parse_list_elements(self) -> ExprList? {
        let expr = self.parse_expression()?
        if self.check("comma") {
            self.advance()
            if self.check("right_bracket") {
                // Trailing comma: [1, 2,]
                return ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
            }
            let rest = self.parse_list_elements()?
            return ExprList.Node(sexpr(expr, self.current_line, self.current_column), rest)
        }
        ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
    }

    fn parse_tuple_rest(self) -> ExprList? {
        // After the first comma in a tuple. Parse remaining elements.
        if self.check("right_paren") {
            return ExprList.End
        }
        let expr = self.parse_expression()?
        if self.check("comma") {
            self.advance()
            let rest = self.parse_tuple_rest()?
            return ExprList.Node(sexpr(expr, self.current_line, self.current_column), rest)
        }
        ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
    }

    fn parse_block_expression(self) -> Expr? {
        self.advance()
        // A block expression's body is parsed as a regular statement
        // list. Re-enable `.field` postfix consumption inside —
        // we're back in normal expression-statement context.
        let saved_dot = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let body = self.parse_statement_list(true)
        self.allow_dot_postfix = saved_dot
        if body == null { return null }
        if !self.consume("right_brace", "expected `}` after block expression") {
            return null
        }
        Expr.Block(body!)
    }

    fn check(self, kind: string) -> bool {
        self.current_kind == kind
    }

    // Peek ahead: after the current identifier, skip whitespace,
    // return true if the next char is ':'. For typed lambda detection.
    fn peek_after_ident_is_colon(self) -> bool {
        let end = self.current_start + self.current_lexeme.length
        mut i = end
        while i < self.source.length {
            let ch = self.source.substring(i, i + 1)
            if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
                return ch == ":"
            }
            i = i + 1
        }
        false
    }

    fn advance(self) {
        self.prev_line = self.current_line
        self.advance_token()
    }

    fn consume(self, kind: string, message: string) -> bool {
        if self.check(kind) {
            self.advance()
            return true
        }
        self.set_error(message)
        false
    }

    fn consume_identifier(self, message: string) -> string? {
        if self.check("identifier") {
            let name = self.current_lexeme
            self.advance()
            return name
        }
        self.set_error(message)
        null
    }

    // Consume a type reference: identifier optionally followed by
    // generic arguments `<A, B>` and/or nullable `?`.
    // Both generics and nullable are erased — we return the base name.
    fn consume_type(self, message: string) -> string? {
        // fn(T, T) -> T  as a type
        // Returns "fn" for simple fn, "fn->RetType" for fn with return type
        if self.check("kw_fn") {
            self.advance()
            // Parse fn type: fn, fn(A, B) -> C, fn -> C
            mut param_str = ""
            if self.check("left_paren") {
                self.advance()
                mut first = true
                while !self.check("right_paren") && !self.check("eof") {
                    if !first {
                        if self.check("comma") { self.advance() }
                    }
                    first = false
                    let pty = self.consume_type("expected parameter type")?
                    if param_str == "" {
                        param_str = pty
                    } else {
                        param_str = param_str + "," + pty
                    }
                }
                if self.check("right_paren") { self.advance() }
            }
            if self.check("arrow") {
                self.advance()
                let ret = self.consume_type("expected return type after `->`")?
                if param_str != "" {
                    return "fn(" + param_str + ")->" + ret
                }
                return "fn->" + ret
            }
            if param_str != "" {
                return "fn(" + param_str + ")"
            }
            return "fn"
        }
        if !self.check("identifier") {
            self.set_error(message)
            return null
        }
        mut name = self.current_lexeme
        self.advance()
        // Consume dotted path: core.ast.BinOp -> "core.ast.BinOp"
        while self.check("dot") {
            self.advance()
            if !self.check("identifier") {
                self.set_error("expected identifier after '.' in type path")
                return null
            }
            name = name + "." + self.current_lexeme
            self.advance()
        }
        // Skip generic arguments: Type<A, B>
        if self.check("less") {
            self.skip_angle_brackets()
        }
        if self.check("question") {
            self.advance()
        }
        name
    }

    // Skip a balanced `< ... >` bracket group, handling nesting.
    // Used for both generic declarations (`fn foo<T>`) and generic
    // arguments in types (`List<int>`). Content is discarded since
    // the bootstrap erases all types to i64.
    fn skip_angle_brackets(self) {
        self.advance()  // consume `<`
        mut depth = 1
        while depth > 0 && !self.check("eof") {
            if self.check("less") {
                depth = depth + 1
            } else if self.check("greater") {
                depth = depth - 1
            }
            self.advance()
        }
    }

    fn advance_token(self) {
        self.skip_whitespace_and_comments()

        self.start = self.current
        self.current_start = self.current
        self.current_line = self.line
        self.current_column = self.column

        if self.is_at_end() {
            self.set_current("eof", "")
            return
        }

        let ch = self.advance_char()

        if ch == "," {
            self.set_current("comma", ",")
            return
        }
        if ch == "(" {
            self.set_current("left_paren", "(")
            return
        }
        if ch == ")" {
            self.set_current("right_paren", ")")
            return
        }
        if ch == "{" {
            self.set_current("left_brace", "{")
            return
        }
        if ch == "}" {
            self.set_current("right_brace", "}")
            return
        }
        if ch == "+" {
            self.set_current("plus", "+")
            return
        }
        if ch == "-" {
            if self.match_next(">") {
                self.set_current("arrow", "->")
            } else {
                self.set_current("minus", "-")
            }
            return
        }
        if ch == "*" {
            self.set_current("star", "*")
            return
        }
        if ch == "/" {
            self.set_current("slash", "/")
            return
        }
        if ch == ":" {
            self.set_current("colon", ":")
            return
        }
        if ch == "." {
            if self.match_next(".") {
                self.set_current("dot_dot", "..")
                return
            }
            self.set_current("dot", ".")
            return
        }
        if ch == "?" {
            if self.match_next("?") {
                self.set_current("question_question", "??")
            } else if self.match_next(".") {
                self.set_current("question_dot", "?.")
            } else {
                self.set_current("question", "?")
            }
            return
        }
        if ch == "@" {
            self.set_current("at", "@")
            return
        }
        if ch == "[" {
            self.set_current("left_bracket", "[")
            return
        }
        if ch == "]" {
            self.set_current("right_bracket", "]")
            return
        }

        if ch == "&" {
            if self.match_next("&") {
                self.set_current("amp_amp", "&&")
            } else {
                self.set_current("amp", "&")
            }
            return
        }

        if ch == "|" {
            if self.match_next("|") {
                self.set_current("pipe_pipe", "||")
                return
            }
            if self.match_next(">") {
                self.set_current("pipe_gt", "|>")
                return
            }
            self.set_current("pipe", "|")
            return
        }

        if ch == "^" {
            self.set_current("caret", "^")
            return
        }
        if ch == "~" {
            self.set_current("tilde", "~")
            return
        }
        if ch == "%" {
            self.set_current("percent", "%")
            return
        }

        if ch == "!" {
            if self.match_next("=") {
                self.set_current("bang_equal", "!=")
            } else {
                self.set_current("bang", "!")
            }
            return
        }

        if ch == "=" {
            if self.match_next("=") {
                self.set_current("equal_equal", "==")
            } else {
                self.set_current("equal", "=")
            }
            return
        }

        if ch == "<" {
            if self.match_next("<") {
                self.set_current("shl", "<<")
            } else if self.match_next("=") {
                self.set_current("less_equal", "<=")
            } else {
                self.set_current("less", "<")
            }
            return
        }

        if ch == ">" {
            if self.match_next(">") {
                self.set_current("shr", ">>")
                return
            }
            if self.match_next("=") {
                self.set_current("greater_equal", ">=")
            } else {
                self.set_current("greater", ">")
            }
            return
        }

        if ch == "\"" {
            self.scan_string_token()
            return
        }

        if ch == "`" {
            self.scan_template_token()
            return
        }

        if p_is_digit(ch) {
            self.scan_number_token()
            return
        }

        if p_is_alpha(ch) {
            self.scan_identifier_token()
            return
        }

        self.set_error("unexpected character `" + ch + "`")
        self.set_current("error", ch)
    }

    fn scan_string_token(self) {
        // Build the lexeme with escapes resolved. Surrounding quotes
        // are kept so codegen.fg's strip_quotes still works.
        //
        // If ${...} is found, the string is emitted as a "template"
        // token instead. Inside ${}, nested "..." are tracked via
        // brace-depth so inner quotes don't end the outer string.
        mut content = "\""
        mut has_interpolation = false
        mut brace_depth = 0
        while !self.is_at_end() {
            let ch = self.peek_char()
            // Inside ${...}: track braces, skip nested strings
            if brace_depth > 0 {
                if ch == "\"" {
                    content = content + ch
                    self.advance_char()
                    while !self.is_at_end() && self.peek_char() != "\"" {
                        if self.peek_char() == "\\" {
                            content = content + self.peek_char()
                            self.advance_char()
                        }
                        if !self.is_at_end() {
                            content = content + self.peek_char()
                            self.advance_char()
                        }
                    }
                    if !self.is_at_end() {
                        content = content + self.peek_char()
                        self.advance_char()
                    }
                    continue
                }
                if ch == "{" { brace_depth = brace_depth + 1 }
                if ch == "}" { brace_depth = brace_depth - 1 }
                content = content + ch
                self.advance_char()
                continue
            }
            // Outside ${}: check for end of string or start of interpolation
            if ch == "\"" { break }
            if ch == "$" && self.peek_next_char() == "{" {
                has_interpolation = true
                brace_depth = 1
                content = content + "$" + "{"
                self.advance_char()
                self.advance_char()
                continue
            }
            if ch == "\\" {
                self.advance_char()
                if self.is_at_end() { break }
                let esc = self.peek_char()
                self.advance_char()
                if esc == "n" {
                    content = content + "\n"
                } else if esc == "t" {
                    content = content + "\t"
                } else if esc == "r" {
                    content = content + "\r"
                } else if esc == "\\" {
                    content = content + "\\"
                } else if esc == "\"" {
                    content = content + "\""
                } else if esc == "0" {
                    content = content + "\0"
                } else if esc == "x" {
                    let hi = self.advance_char()
                    let lo = self.advance_char()
                    content = content + forge_char_from_hex(hi, lo)
                } else {
                    content = content + "\\" + esc
                }
            } else {
                content = content + ch
                self.advance_char()
            }
        }

        if self.is_at_end() {
            self.report(DiagCode.UnterminatedString, "unterminated string")
            self.set_current("error", "")
            return
        }

        self.advance_char()
        if has_interpolation {
            // Strip leading quote, emit as template for desugaring
            self.set_current("template", content.substring(1, content.length))
        } else {
            content = content + "\""
            self.set_current("string", content)
        }
    }

    // Scan a backtick-delimited template string. The raw content between
    // backticks is stored as the lexeme (without the backtick delimiters).
    // The parser later splits on `${...}` to desugar into concatenation.
    fn scan_template_token(self) {
        mut content = ""
        while !self.is_at_end() && self.peek_char() != "`" {
            content = content + self.peek_char()
            self.advance_char()
        }
        if self.is_at_end() {
            self.report(DiagCode.UnterminatedTemplate, "unterminated template string")
            self.set_current("error", "")
            return
        }
        self.advance_char()
        self.set_current("template", content)
    }

    fn scan_number_token(self) {
        // Check for 0x, 0b, 0o prefixes
        let first = self.source[self.start]
        if first == "0" {
            let prefix = self.peek_char()
            if prefix == "x" || prefix == "X" {
                self.advance_char()
                while p_is_hex_digit(self.peek_char()) || self.peek_char() == "_" {
                    self.advance_char()
                }
                self.set_current("number", self.source.substring(self.start, self.current))
                return
            }
            if prefix == "b" || prefix == "B" {
                self.advance_char()
                while p_is_binary_digit(self.peek_char()) || self.peek_char() == "_" {
                    self.advance_char()
                }
                self.set_current("number", self.source.substring(self.start, self.current))
                return
            }
            if prefix == "o" || prefix == "O" {
                self.advance_char()
                while p_is_octal_digit(self.peek_char()) || self.peek_char() == "_" {
                    self.advance_char()
                }
                self.set_current("number", self.source.substring(self.start, self.current))
                return
            }
        }

        while p_is_digit(self.peek_char()) || self.peek_char() == "_" {
            self.advance_char()
        }

        if self.peek_char() == "." && p_is_digit(self.peek_next_char()) {
            self.advance_char()
            while p_is_digit(self.peek_char()) || self.peek_char() == "_" {
                self.advance_char()
            }
            self.set_current("float", self.source.substring(self.start, self.current))
            return
        }

        // Duration suffix: Nd, Nh, Nm, Ns, Nms → milliseconds
        let next = self.peek_char()
        if next == "d" && !p_is_alpha_numeric(self.peek_next_char()) {
            self.advance_char()
            let num_str = self.source.substring(self.start, self.current - 1)
            self.set_current("number", string(int(num_str) * 86400000))
            return
        }
        if next == "h" && !p_is_alpha_numeric(self.peek_next_char()) {
            self.advance_char()
            let num_str = self.source.substring(self.start, self.current - 1)
            self.set_current("number", string(int(num_str) * 3600000))
            return
        }
        if next == "m" {
            if self.peek_next_char() == "s" {
                self.advance_char()
                self.advance_char()
                let num_str = self.source.substring(self.start, self.current - 2)
                self.set_current("number", string(int(num_str)))
                return
            }
            if !p_is_alpha_numeric(self.peek_next_char()) {
                self.advance_char()
                let num_str = self.source.substring(self.start, self.current - 1)
                self.set_current("number", string(int(num_str) * 60000))
                return
            }
        }
        if next == "s" && !p_is_alpha_numeric(self.peek_next_char()) {
            self.advance_char()
            let num_str = self.source.substring(self.start, self.current - 1)
            self.set_current("number", string(int(num_str) * 1000))
            return
        }
        self.set_current("number", self.source.substring(self.start, self.current))
    }

    fn scan_identifier_token(self) {
        while p_is_alpha_numeric(self.peek_char()) {
            self.advance_char()
        }

        let text = self.source.substring(self.start, self.current)
        self.set_current(p_keyword_kind(text), text)
    }

    fn set_current(self, kind: string, lexeme: string) {
        self.current_kind = kind
        self.current_lexeme = lexeme
    }

    fn skip_whitespace_and_comments(self) {
        while !self.is_at_end() {
            let ch = self.peek_char()
            if ch == " " || ch == "\r" || ch == "\t" || ch == "\n" {
                self.advance_char()
            } else if ch == "/" && self.peek_next_char() == "/" {
                while !self.is_at_end() && self.peek_char() != "\n" {
                    self.advance_char()
                }
            } else {
                return
            }
        }
    }

    fn is_at_end(self) -> bool {
        self.current >= self.source.length
    }

    fn peek_char(self) -> string {
        if self.current >= self.source.length {
            return ""
        }
        self.source[self.current]
    }

    fn peek_next_char(self) -> string {
        if self.current + 1 >= self.source.length {
            return ""
        }
        self.source[self.current + 1]
    }

    fn match_next(self, expected: string) -> bool {
        if self.is_at_end() {
            return false
        }
        if self.source[self.current] != expected {
            return false
        }
        self.advance_char()
        true
    }

    fn advance_char(self) -> string {
        let ch = self.source[self.current]
        self.current = self.current + 1
        if ch == "\n" {
            self.line = self.line + 1
            self.column = 1
        } else {
            self.column = self.column + 1
        }
        ch
    }

    fn set_error(self, message: string) {
        self.report(DiagCode.SyntaxError, message)
    }

    fn report(self, code: DiagCode, message: string) {
        // Always add to the bag — even if we already had an error.
        // This lets us show ALL parse errors, not just the first.
        let sp = span_new(self.current_start, self.current, self.current_line, self.current_column)
        let diag = diag_error(code, message, sp)
        self.bag = bag_report(self.bag, diag)
        // Set had_error + message for backward compat (first error wins)
        if !self.had_error {
            self.had_error = true
            self.error_message = "parse error at " + string(self.current_line) + ":" + string(self.current_column) + ": " + message
        }
    }

    // Panic-mode recovery: skip tokens until we find something that
    // looks like the start of a new statement. This lets us resume
    // parsing and find more errors.
    fn synchronize(self) {
        while !self.check("eof") {
            if self.check("kw_fn") || self.check("kw_let") || self.check("kw_const") || self.check("kw_mut") || self.check("kw_type") || self.check("kw_enum") || self.check("kw_impl") || self.check("kw_if") || self.check("kw_while") || self.check("kw_for") || self.check("kw_match") || self.check("kw_return") || self.check("kw_extern") || self.check("kw_trait") || self.check("kw_defer") || self.check("kw_spec") || self.check("kw_given") || self.check("kw_then") || self.check("kw_select") || self.check("right_brace") {
                return
            }
            self.advance()
        }
    }
}
