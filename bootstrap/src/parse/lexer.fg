// WHY: integrated lexer for the recursive-descent parser.
// Scans source characters one at a time, producing Tk-typed tokens.

use core.ast.{Tk}
use diagnostics.{DiagCode}
use parse.{p_keyword_kind}

export fn p_is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

export fn p_is_alpha(ch: string) -> bool {
    (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

export fn p_is_alpha_numeric(ch: string) -> bool {
    p_is_alpha(ch) || p_is_digit(ch)
}

export fn p_is_hex_digit(ch: string) -> bool {
    p_is_digit(ch) || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F")
}

export fn p_is_binary_digit(ch: string) -> bool {
    ch == "0" || ch == "1"
}

export fn p_is_octal_digit(ch: string) -> bool {
    ch >= "0" && ch <= "7"
}

impl Parser {
    fn advance_token(self) {
        self.skip_whitespace_and_comments()

        self.start = self.current
        self.current_start = self.current
        self.current_line = self.line
        self.current_column = self.column

        if self.is_at_end() {
            self.set_current(Tk.Eof, "")
            return
        }

        let ch = self.advance_char()

        if ch == "," {
            self.set_current(Tk.Comma, ",")
            return
        }
        if ch == "(" {
            self.set_current(Tk.LeftParen, "(")
            return
        }
        if ch == ")" {
            self.set_current(Tk.RightParen, ")")
            return
        }
        if ch == "{" {
            self.set_current(Tk.LeftBrace, "{")
            return
        }
        if ch == "}" {
            self.set_current(Tk.RightBrace, "}")
            return
        }
        if ch == "+" {
            self.set_current(Tk.Plus, "+")
            return
        }
        if ch == "-" {
            if self.match_next(">") {
                self.set_current(Tk.Arrow, "->")
            } else {
                self.set_current(Tk.Minus, "-")
            }
            return
        }
        if ch == "*" {
            self.set_current(Tk.Star, "*")
            return
        }
        if ch == "/" {
            self.set_current(Tk.Slash, "/")
            return
        }
        if ch == ":" {
            self.set_current(Tk.Colon, ":")
            return
        }
        if ch == "." {
            if self.match_next(".") {
                self.set_current(Tk.DotDot, "..")
                return
            }
            self.set_current(Tk.Dot, ".")
            return
        }
        if ch == "?" {
            if self.match_next("?") {
                self.set_current(Tk.QuestionQuestion, "??")
            } else if self.match_next(".") {
                self.set_current(Tk.QuestionDot, "?.")
            } else {
                self.set_current(Tk.Question, "?")
            }
            return
        }
        if ch == "@" {
            self.set_current(Tk.At, "@")
            return
        }
        if ch == "[" {
            self.set_current(Tk.LeftBracket, "[")
            return
        }
        if ch == "]" {
            self.set_current(Tk.RightBracket, "]")
            return
        }

        if ch == "&" {
            if self.match_next("&") {
                self.set_current(Tk.AmpAmp, "&&")
            } else {
                self.set_current(Tk.Amp, "&")
            }
            return
        }

        if ch == "|" {
            if self.match_next("|") {
                self.set_current(Tk.PipePipe, "||")
                return
            }
            if self.match_next(">") {
                self.set_current(Tk.PipeGt, "|>")
                return
            }
            self.set_current(Tk.Pipe, "|")
            return
        }

        if ch == "^" {
            self.set_current(Tk.Caret, "^")
            return
        }
        if ch == "~" {
            self.set_current(Tk.Tilde, "~")
            return
        }
        if ch == "%" {
            self.set_current(Tk.Percent, "%")
            return
        }

        if ch == "!" {
            if self.match_next("=") {
                self.set_current(Tk.BangEqual, "!=")
            } else {
                self.set_current(Tk.Bang, "!")
            }
            return
        }

        if ch == "=" {
            if self.match_next("=") {
                self.set_current(Tk.EqualEqual, "==")
            } else {
                self.set_current(Tk.Equal, "=")
            }
            return
        }

        if ch == "<" {
            if self.match_next("<") {
                self.set_current(Tk.Shl, "<<")
            } else if self.match_next("=") {
                self.set_current(Tk.LessEqual, "<=")
            } else {
                self.set_current(Tk.Less, "<")
            }
            return
        }

        if ch == ">" {
            if self.match_next(">") {
                self.set_current(Tk.Shr, ">>")
                return
            }
            if self.match_next("=") {
                self.set_current(Tk.GreaterEqual, ">=")
            } else {
                self.set_current(Tk.Greater, ">")
            }
            return
        }

        if ch == "\"" {
            self.scan_string_token()
            return
        }

        if ch == "`" {
            self.scan_template_token()
            return
        }

        if p_is_digit(ch) {
            self.scan_number_token()
            return
        }

        if p_is_alpha(ch) {
            self.scan_identifier_token()
            return
        }

        self.set_error("unexpected character `" + ch + "`")
        self.set_current(Tk.Error, ch)
    }



    fn scan_template_token(self) {
        mut content = ""
        while !self.is_at_end() && self.peek_char() != "`" {
            content = content + self.peek_char()
            self.advance_char()
        }
        if self.is_at_end() {
            self.report(DiagCode.UnterminatedTemplate, "unterminated template string")
            self.set_current(Tk.Error, "")
            return
        }
        self.advance_char()
        self.set_current(Tk.Template, content)
    }

    fn scan_number_token(self) {
        // Check for 0x, 0b, 0o prefixes
        let first = self.source[self.start]
        if first == "0" {
            let prefix = self.peek_char()
            if prefix == "x" || prefix == "X" {
                self.advance_char()
                while p_is_hex_digit(self.peek_char()) || self.peek_char() == "_" {
                    self.advance_char()
                }
                self.set_current(Tk.Number, self.source.substring(self.start, self.current))
                return
            }
            if prefix == "b" || prefix == "B" {
                self.advance_char()
                while p_is_binary_digit(self.peek_char()) || self.peek_char() == "_" {
                    self.advance_char()
                }
                self.set_current(Tk.Number, self.source.substring(self.start, self.current))
                return
            }
            if prefix == "o" || prefix == "O" {
                self.advance_char()
                while p_is_octal_digit(self.peek_char()) || self.peek_char() == "_" {
                    self.advance_char()
                }
                self.set_current(Tk.Number, self.source.substring(self.start, self.current))
                return
            }
        }

        while p_is_digit(self.peek_char()) || self.peek_char() == "_" {
            self.advance_char()
        }

        if self.peek_char() == "." && p_is_digit(self.peek_next_char()) {
            self.advance_char()
            while p_is_digit(self.peek_char()) || self.peek_char() == "_" {
                self.advance_char()
            }
            self.set_current(Tk.Float, self.source.substring(self.start, self.current))
            return
        }

        // Duration suffix: Nd, Nh, Nm, Ns, Nms → milliseconds
        let next = self.peek_char()
        if next == "d" && !p_is_alpha_numeric(self.peek_next_char()) {
            self.advance_char()
            let num_str = self.source.substring(self.start, self.current - 1)
            self.set_current(Tk.Number, string(int(num_str) * 86400000))
            return
        }
        if next == "h" && !p_is_alpha_numeric(self.peek_next_char()) {
            self.advance_char()
            let num_str = self.source.substring(self.start, self.current - 1)
            self.set_current(Tk.Number, string(int(num_str) * 3600000))
            return
        }
        if next == "m" {
            if self.peek_next_char() == "s" {
                self.advance_char()
                self.advance_char()
                let num_str = self.source.substring(self.start, self.current - 2)
                self.set_current(Tk.Number, string(int(num_str)))
                return
            }
            if !p_is_alpha_numeric(self.peek_next_char()) {
                self.advance_char()
                let num_str = self.source.substring(self.start, self.current - 1)
                self.set_current(Tk.Number, string(int(num_str) * 60000))
                return
            }
        }
        if next == "s" && !p_is_alpha_numeric(self.peek_next_char()) {
            self.advance_char()
            let num_str = self.source.substring(self.start, self.current - 1)
            self.set_current(Tk.Number, string(int(num_str) * 1000))
            return
        }
        self.set_current(Tk.Number, self.source.substring(self.start, self.current))
    }

    fn scan_identifier_token(self) {
        while p_is_alpha_numeric(self.peek_char()) {
            self.advance_char()
        }

        let text = self.source.substring(self.start, self.current)
        self.set_current(p_keyword_kind(text), text)
    }

    fn set_current(self, kind: Tk, lexeme: string) {
        self.current_kind = kind
        self.current_lexeme = lexeme
    }

    fn skip_whitespace_and_comments(self) {
        while !self.is_at_end() {
            let ch = self.peek_char()
            if ch == " " || ch == "\r" || ch == "\t" || ch == "\n" {
                self.advance_char()
            } else if ch == "/" && self.peek_next_char() == "/" {
                while !self.is_at_end() && self.peek_char() != "\n" {
                    self.advance_char()
                }
            } else {
                return
            }
        }
    }

    fn is_at_end(self) -> bool {
        self.current >= self.source.length
    }

    fn peek_char(self) -> string {
        if self.current >= self.source.length {
            return Tk.Identifier
        }
        self.source[self.current]
    }

    fn peek_next_char(self) -> string {
        if self.current + 1 >= self.source.length {
            return Tk.Identifier
        }
        self.source[self.current + 1]
    }

    fn match_next(self, expected: string) -> bool {
        if self.is_at_end() {
            return false
        }
        if self.source[self.current] != expected {
            return false
        }
        self.advance_char()
        true
    }

    fn advance_char(self) -> string {
        let ch = self.source[self.current]
        self.current = self.current + 1
        if ch == "\n" {
            self.line = self.line + 1
            self.column = 1
        } else {
            self.column = self.column + 1
        }
        ch
    }

    fn scan_string_token(self) {
        // Build the lexeme with escapes resolved. Surrounding quotes
        // are kept so codegen.fg's strip_quotes still works.
        //
        // If ${...} is found, the string is emitted as a "template"
        // token instead. Inside ${}, nested "..." are tracked via
        // brace-depth so inner quotes don't end the outer string.
        mut content = "\""
        mut has_interpolation = false
        mut brace_depth = 0
        while !self.is_at_end() {
            let ch = self.peek_char()
            // Inside ${...}: track braces, skip nested strings
            if brace_depth > 0 {
                if ch == "\"" {
                    content = content + ch
                    self.advance_char()
                    while !self.is_at_end() && self.peek_char() != "\"" {
                        if self.peek_char() == "\\" {
                            content = content + self.peek_char()
                            self.advance_char()
                        }
                        if !self.is_at_end() {
                            content = content + self.peek_char()
                            self.advance_char()
                        }
                    }
                    if !self.is_at_end() {
                        content = content + self.peek_char()
                        self.advance_char()
                    }
                    continue
                }
                if ch == "{" { brace_depth = brace_depth + 1 }
                if ch == "}" { brace_depth = brace_depth - 1 }
                content = content + ch
                self.advance_char()
                continue
            }
            // Outside ${}: check for end of string or start of interpolation
            if ch == "\"" { break }
            if ch == "$" && self.peek_next_char() == "{" {
                has_interpolation = true
                brace_depth = 1
                content = content + "$" + "{"
                self.advance_char()
                self.advance_char()
                continue
            }
            if ch == "\\" {
                self.advance_char()
                if self.is_at_end() { break }
                let esc = self.peek_char()
                self.advance_char()
                if esc == "n" {
                    content = content + "\n"
                } else if esc == "t" {
                    content = content + "\t"
                } else if esc == "r" {
                    content = content + "\r"
                } else if esc == "\\" {
                    content = content + "\\"
                } else if esc == "\"" {
                    content = content + "\""
                } else if esc == "0" {
                    content = content + "\0"
                } else if esc == "x" {
                    let hi = self.advance_char()
                    let lo = self.advance_char()
                    content = content + forge_char_from_hex(hi, lo)
                } else {
                    content = content + "\\" + esc
                }
            } else {
                content = content + ch
                self.advance_char()
            }
        }

        if self.is_at_end() {
            self.report(DiagCode.UnterminatedString, "unterminated string")
            self.set_current(Tk.Error, "")
            return
        }

        self.advance_char()
        if has_interpolation {
            // Strip leading quote, emit as template for desugaring
            self.set_current(Tk.Template, content.substring(1, content.length))
        } else {
            content = content + "\""
            self.set_current(Tk.String, content)
        }
    }

}

// ── Numeric literal parsing ──

export fn strip_underscores(s: string) -> string {
    mut out = ""
    mut i = 0
    while i < s.length {
        if s[i] != "_" {
            out = out + s[i]
        }
        i = i + 1
    }
    out
}


export fn parse_int_literal(text: string) -> int {
    let clean = strip_underscores(text)
    if clean.length > 2 {
        let prefix = clean.substring(0, 2)
        if prefix == "0x" || prefix == "0X" {
            return parse_hex(clean.substring(2, clean.length))
        }
        if prefix == "0b" || prefix == "0B" {
            return parse_binary(clean.substring(2, clean.length))
        }
        if prefix == "0o" || prefix == "0O" {
            return parse_octal(clean.substring(2, clean.length))
        }
    }
    int(clean)
}


export fn hex_digit_value(ch: string) -> int {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    if ch == "a" || ch == "A" { return 10 }
    if ch == "b" || ch == "B" { return 11 }
    if ch == "c" || ch == "C" { return 12 }
    if ch == "d" || ch == "D" { return 13 }
    if ch == "e" || ch == "E" { return 14 }
    if ch == "f" || ch == "F" { return 15 }
    0
}


export fn parse_hex(digits: string) -> int {
    mut result = 0
    mut i = 0
    while i < digits.length {
        result = result * 16 + hex_digit_value(digits[i])
        i = i + 1
    }
    result
}


export fn parse_binary(digits: string) -> int {
    mut result = 0
    mut i = 0
    while i < digits.length {
        let ch = digits[i]
        if ch == "1" {
            result = result * 2 + 1
        } else {
            result = result * 2
        }
        i = i + 1
    }
    result
}


export fn parse_octal(digits: string) -> int {
    mut result = 0
    mut i = 0
    while i < digits.length {
        result = result * 8 + decimal_digit_value(digits[i])
        i = i + 1
    }
    result
}


export fn decimal_digit_value(ch: string) -> int {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    0
}


