// WHY: emits function bodies and binds parameters into the body scope.
// Also emits null-argument checks when debug_null_checks is enabled on Ctx.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, VarEnv, env_extend, env_lookup, ValueType, SStmt, stmt_unwrap, expr_list_length, field_index_of, field_type_of, vtype_closure_captures, vtype_display, vtype_enum_name, vtype_eq, vtype_fn_ret, vtype_is_closure, vtype_is_fn, vtype_is_list, vtype_is_map, vtype_is_str, vtype_list_elem, vtype_struct_name, vtype_trait_name}
use codegen.types.{Ctx, EmitResult, ParamTypeList, StmtResult, ok_emit, ok_emit_str, ok_emit_typed, ok_stmt, err_emit, err_stmt, translate_type_ctx, translate_param_type, ctx_with_fn, struct_reg_lookup, fn_ret_lookup, fn_param_lookup, param_type_at, trait_decl_has, toplevel_lookup, null_ptr_val, call_2}
use features.closures.codegen.{emit_closure_call_typed, emit_indirect_call, emit_indirect_call_from_global, emit_indirect_call_typed, emit_indirect_call_value}
use features.defer_stmt.codegen.{defer_reset, emit_defers}

export fn emit_function_bodies(ctx: Ctx, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(VarEnv.End)
        .Node(ss, next) -> {
            let r = match stmt_unwrap(ss.node) {
                // Function names are already qualified by the name
                // resolution pass — use them as-is for LLVM lookup.
                .Function(name, params, _, body) -> emit_function_body(ctx, name, params, body)
                .Impl(_, methods) -> emit_function_bodies(ctx, methods)
                .Module(_, body) -> emit_function_bodies(ctx, body)
                _ -> ok_stmt(VarEnv.End)
            }?
            emit_function_bodies(ctx, next)
        }
    }
}

export fn emit_function_body(ctx: Ctx, name: string, params: ParamList, body: StmtList) -> StmtResult {
    let fn_val = forge_llvm_get_named_function(ctx.module, name)
    if fn_val == null {
        return err_stmt("codegen error: function `${name}` was not declared in pass 1")
    }
    let entry = forge_llvm_append_basic_block(ctx.lc, fn_val, "entry")
    ctx.position(entry)

    let body_cg = ctx_with_fn(ctx, fn_val, name)

    let empty_env: VarEnv = VarEnv.End
    let env = bind_params_inline(body_cg, fn_val, params, 0, empty_env)

    // Emit null checks for all ptr/struct/enum parameters when debug mode is on.
    if body_cg.debug_null_checks {
        emit_null_checks(body_cg, name, params, env)
    }

    defer_reset()

    let r = emit_block_loop(body_cg, env, body, ctx.i64(0), .Int)
    if r.had_error { return err_stmt(r.error_message) }
    if !ctx.has_terminator() {
        emit_defers(body_cg, env)
        ctx.build_ret(r.value)
    }
    ok_stmt(VarEnv.End)
}

fn bind_params_inline(ctx: Ctx, fn_val: ptr, params: ParamList, idx: int, env: VarEnv) -> VarEnv {
    match params {
        .End -> env
        .Node(name, ty, next) -> {
            let arg = forge_llvm_get_param(fn_val, idx)
            let alloca = ctx.alloca_i64(name)
            ctx.store(arg, alloca)
            let internal_ty = translate_type_ctx(ctx, ty)
            bind_params_inline(ctx, fn_val, next, idx + 1, env_extend(env, name, alloca, internal_ty))
        }
    }
}

// ── Debug null checks ──
//
// When --debug-null is active, emit an icmp eq i64 %val, 0 check for
// every parameter whose declared type is ptr, a struct, or an enum.
// If null, call forge_null_arg_trap with the function name and
// parameter name, then emit unreachable. This catches null propagation
// at the source function instead of crashing 8000 calls later.

fn should_null_check(ty: string) -> bool {
    // Check types that are pointers at runtime: ptr, string, structs,
    // enums, lists, maps, and named types (which are usually structs/enums).
    // Skip: int, bool, float, fn (which are value types).
    if ty in ["ptr", "string"] { return true }
    // If it starts with uppercase, it's likely a named struct/enum type.
    if ty.length > 0 {
        let first = ty.substring(0, 1)
        if first in "A".."Z" { return true }
    }
    false
}

fn emit_null_checks(ctx: Ctx, fn_name: string, params: ParamList, env: VarEnv) {
    match params {
        .End -> {}
        .Node(name, ty, next) -> {
            if should_null_check(ty) {
                emit_one_null_check(ctx, fn_name, name, env)
            }
            emit_null_checks(ctx, fn_name, next, env)
        }
    }
}

fn emit_one_null_check(ctx: Ctx, fn_name: string, param_name: string, env: VarEnv) {
    let lookup = env_lookup(env, param_name)
    if !lookup.found { return }

    // Load the parameter value (stored as i64 in the alloca).
    let val = ctx.load_i64(lookup.alloca, "${param_name}_val")
    let zero = ctx.i64(0)
    // icmp eq i64 %val, 0 → i1
    let is_null_i1 = ctx.eq(val, zero, "${param_name}_null")
    // zext i1 to i64 for the C function
    let is_null = ctx.zext(is_null_i1, ctx.i64_type, "${param_name}_nz")

    // Build the call to forge_null_arg_check(fn_name, fn_len, param_name, param_len, is_null).
    // No branching — the C function does the check internally.
    let fn_str = ctx.global_str(fn_name, "dbg_fn")
    let fn_len = ctx.i64(fn_name.length)
    let p_str = ctx.global_str(param_name, "dbg_param")
    let p_len = ctx.i64(param_name.length)
    let check_fn = ctx.get_fn("forge_null_arg_check")
    let ft = forge_llvm_fn_type_of(check_fn)
    let args = forge_llvm_value_array_new(5)
    forge_llvm_value_array_set(args, 0, fn_str)
    forge_llvm_value_array_set(args, 1, fn_len)
    forge_llvm_value_array_set(args, 2, p_str)
    forge_llvm_value_array_set(args, 3, p_len)
    forge_llvm_value_array_set(args, 4, is_null)
    forge_llvm_build_call(ctx.builder, ft, check_fn, args, 5, "")
    forge_llvm_value_array_free(args)
}

// ── Call dispatch (moved from codegen/mod.fg) ──

use codegen.strings.{emit_concat, emit_substring, emit_str_replace}
use codegen.printing.{emit_println, emit_eprintln}
use features.list_lit.codegen.{emit_list_method_call}
use features.map_lit.codegen.{emit_map_method_call}
use features.trait_decl.codegen.{emit_trait_dispatch}
use codegen.blocks.{emit_block_loop}
use codegen.helpers.{emit_single_arg, fill_arg_array, fill_arg_array_boxing, fill_i64_param_array, strip_quotes}

export fn emit_call(ctx: Ctx, env: VarEnv, callee: Expr, args: ExprList) -> EmitResult {
    match callee {
        .Ident(name) -> emit_call_named(ctx, env, name, args)
        .QualifiedIdent(path) -> emit_call_named(ctx, env, path, args)
        .FieldAccess(obj, method) -> emit_method_call(ctx, env, obj, method, args)
        _ -> {
            // Expression callee: evaluate it and call indirectly.
            // All callable values are closure arrays, so route through
            // the closure call path which unpacks [TAG, fn_ptr, caps...].
            let callee_r = ctx.emit(env, callee)?
            let ret_ty = vtype_fn_ret(callee_r.ty)
            if vtype_is_closure(callee_r.ty) {
                let num_caps = vtype_closure_captures(callee_r.ty)
                if num_caps >= 0 {
                    return emit_closure_call_typed(ctx, env, callee_r.value, args, num_caps, ret_ty)
                }
            }
            // For values with Fn/FnTyped type (e.g. from intmap_get),
            // the runtime value is still a closure array — route
            // through indirect call which handles both representations.
            emit_indirect_call_typed(ctx, env, callee_r.value, args, ret_ty)
        }
    }
}

export fn emit_method_call(ctx: Ctx, env: VarEnv, obj: Expr, method: string, args: ExprList) -> EmitResult {
    // Special-case `.length` and `.substring` on strings — these are
    // emitted via libc strlen / a custom substring helper rather than
    // dispatched as methods.
    let r = ctx.emit(env, obj)?
    if vtype_is_str(r.ty) {
        match method {
            "length" -> {
                let str_ptr = ctx.to_ptr(r.value, "len_arg")
                return ok_emit(ctx.call("strlen", [str_ptr]))
            }
            "substring" -> return emit_substring(ctx, env, r.value, args)
            "contains" or "starts_with" or "ends_with" or "index_of" -> {
                let arg_r = emit_single_arg(ctx, env, args)?
                let str_ptr = ctx.to_ptr(r.value, "str_self")
                let arg_ptr = ctx.to_ptr(arg_r.value, "str_arg")
                return ok_emit(call_2(ctx, ctx.get_fn("forge_str_${method}"), str_ptr, arg_ptr, method))
            }
            "replace" -> return emit_str_replace(ctx, env, r.value, args)
            "trim" -> {
                let str_ptr = ctx.to_ptr(r.value, "str_self")
                return ok_emit_str(ctx.to_i64(ctx.call("forge_str_trim", [str_ptr]), "trim_i64"))
            }
            "to_upper" or "upper" -> {
                let str_ptr = ctx.to_ptr(r.value, "str_self")
                return ok_emit_str(ctx.to_i64(ctx.call("forge_str_to_upper", [str_ptr]), "upper_i64"))
            }
            "to_lower" or "lower" -> {
                let str_ptr = ctx.to_ptr(r.value, "str_self")
                return ok_emit_str(ctx.to_i64(ctx.call("forge_str_to_lower", [str_ptr]), "lower_i64"))
            }
            "split" -> {
                let arg_r = emit_single_arg(ctx, env, args)?
                let str_ptr = ctx.to_ptr(r.value, "str_self")
                let sep_ptr = ctx.to_ptr(arg_r.value, "sep_arg")
                let result = ctx.call("forge_str_split", [str_ptr, sep_ptr])
                return ok_emit_typed(result, .List(.Str))
            }
            "char_code" -> {
                // str.char_code() → int (first byte as integer)
                let str_ptr = ctx.to_ptr(r.value, "str_self")
                let byte_val = ctx.load(forge_llvm_int8_type(ctx.lc), str_ptr, "char_byte")
                let as_i64 = ctx.zext(byte_val, ctx.i64_type, "char_code")
                return ok_emit(as_i64)
            }
            _ -> return err_emit("string method `${method}` not implemented")
        }
    }
    // List methods — dispatched to features/list_lit/codegen.fg
    if vtype_is_list(r.ty) {
        return emit_list_method_call(ctx, env, r.value, r.ty, method, args)
    }
    // Map methods — dispatched to features/map_lit/codegen.fg
    if vtype_is_map(r.ty) {
        let map_ptr = ctx.to_ptr(r.value, "map_ptr")
        return emit_map_method_call(ctx, env, map_ptr, method, args)
    }
    // Trait dispatch
    let tn = vtype_trait_name(r.ty)
    if tn != "" {
        return emit_trait_dispatch(ctx, env, r.value, tn, method, args)
    }
    // Otherwise: dispatch by type tag → `Type__method(obj, args)`.
    let type_name = vtype_struct_name(r.ty)
    let enum_name = vtype_enum_name(r.ty)
    let owner = if type_name != "" {
        type_name
    } else {
        enum_name
    }
    if owner == "" {
        return err_emit("method call on non-struct/enum value (ty=${vtype_display(r.ty)})")
    }
    let mangled = "${owner}__${method}"
    let fn_val = forge_llvm_get_named_function(ctx.module, mangled)
    if fn_val == null {
        // Not a method — check if it's a struct field with fn type.
        // e.g. handler.action(25) where action: fn(int) -> int
        if type_name != "" {
            let s_lookup = struct_reg_lookup(ctx.structs, type_name)
            if s_lookup.found {
                let field_ty = translate_param_type(ctx.structs, ctx.enums, field_type_of(s_lookup.fields, method))
                if vtype_is_fn(field_ty) {
                    // Load the field value (fn pointer) and call indirectly
                    let st_ty = ctx.get_type(type_name)
                    let obj_ptr = ctx.to_ptr(r.value, "fn_field_obj")
                    let gep = ctx.gep(st_ty, obj_ptr, field_index_of(s_lookup.fields, method), "fn_field_ptr")
                    let fn_i64 = ctx.load_i64(gep, "fn_field_val")
                    return emit_indirect_call_value(ctx, env, fn_i64, args)
                }
            }
        }
        return err_emit("undefined method `${owner}.${method}`")
    }
    ctx.null_check(r.value, method, owner)

    // Build arg array with self prepended.
    let extra_count = expr_list_length(args)
    let arg_count = extra_count + 1
    let arg_arr = forge_llvm_value_array_new(arg_count)
    forge_llvm_value_array_set(arg_arr, 0, r.value)
    let fill = fill_arg_array(ctx, env, arg_arr, args, 1)
    if fill.had_error {
        forge_llvm_value_array_free(arg_arr)
        return fill
    }
    let param_arr = forge_llvm_type_array_new(arg_count)
    fill_i64_param_array(param_arr, ctx.i64_type, 0, arg_count)
    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arg_count, 0)
    forge_llvm_type_array_free(param_arr)
    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_val, arg_arr, arg_count, "methcall")
    forge_llvm_value_array_free(arg_arr)
    let ret_ty = fn_ret_lookup(ctx.fn_rets, mangled)
    ok_emit_typed(result, ret_ty)
}

export fn emit_first_arg(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("expected argument")
        .Node(se, _) -> ctx.emit(env, se.node)
    }
}

export fn emit_call_named(ctx: Ctx, env: VarEnv, name: string, args: ExprList) -> EmitResult {
    if name == "println" {
        return emit_println(ctx, env, args)
    }
    if name == "eprintln" {
        return emit_eprintln(ctx, env, args)
    }
    if name == "string" {
        return emit_int_to_string(ctx, env, args)
    }
    if name == "int" {
        return emit_string_to_int(ctx, env, args)
    }
    if name == "float" {
        return emit_string_to_float(ctx, env, args)
    }
    if name == "panic" {
        return emit_panic(ctx, env, args)
    }
    let fn_val = forge_llvm_get_named_function(ctx.module, name)
    if fn_val == null {
        // Not a named function — might be a lambda stored in a variable.
        let local = env_lookup(env, name)
        if local.found && vtype_is_fn(local.ty) {
            return emit_indirect_call(ctx, env, local.alloca, name, args)
        }
        let g = toplevel_lookup(ctx.top_level_vars, name)
        if g.found && vtype_is_fn(g.ty) {
            return emit_indirect_call_from_global(ctx, env, g.llvm_global, name, args, g.ty)
        }
        return err_emit("undefined function `${name}`")
    }

    let arg_count = expr_list_length(args)
    let arg_arr = forge_llvm_value_array_new(arg_count)
    let ptypes = fn_param_lookup(ctx.fn_params, name)
    let fill = fill_arg_array_boxing(ctx, env, arg_arr, args, ptypes, 0)
    if fill.had_error {
        forge_llvm_value_array_free(arg_arr)
        return fill
    }
    // All bootstrap functions have the same shape: (i64, i64, ...) -> i64.
    let param_arr = forge_llvm_type_array_new(arg_count)
    fill_i64_param_array(param_arr, ctx.i64_type, 0, arg_count)
    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arg_count, 0)
    forge_llvm_type_array_free(param_arr)

    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_val, arg_arr, arg_count, "calltmp")
    forge_llvm_value_array_free(arg_arr)
    let ret_ty = fn_ret_lookup(ctx.fn_rets, name)
    ok_emit_typed(result, ret_ty)
}

export fn emit_int_to_string(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // string(i64) → str via snprintf into a 32-byte malloc'd buffer.
    match args {
        .End -> err_emit("string() expects 1 arg")
        .Node(se, _) -> {
            let r = ctx.emit(env, se.node)?
            // If the value is already a str, pass it through.
            if vtype_is_str(r.ty) {
                return r
            }
            // Float → string via forge_float_to_string(i64_bits) → ptr
            if vtype_eq(r.ty, .Float) {
                let str_ptr = ctx.call("forge_float_to_string", [r.value])
                return ok_emit_str(ctx.to_i64(str_ptr, "f2s_i64"))
            }
            // Int → string via snprintf into a 32-byte malloc'd buffer.
            let buf = ctx.malloc(ctx.i64(32))
            let fmt = ctx.global_str("%lld", ".i2s_fmt")
            ctx.call("snprintf", [buf, ctx.i64(32), fmt, r.value])
            let result_i64 = ctx.to_i64(buf, "i2s_result")
            ok_emit_str(result_i64)
        }
    }
}

export fn emit_string_to_int(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // int(str) → i64 via libc atoi.
    match args {
        .End -> err_emit("int() expects 1 arg")
        .Node(se, _) -> {
            let r = ctx.emit(env, se.node)?
            if !vtype_is_str(r.ty) {
                // Already an int — pass through.
                return r
            }
            let str_ptr = ctx.to_ptr(r.value, "atoi_arg")
            let result32 = ctx.call("atoi", [str_ptr])
            // Sign-extend i32 → i64.
            ok_emit(forge_llvm_build_sext(ctx.builder, result32, ctx.i64_type, "atoi_ext"))
        }
    }
}

export fn emit_string_to_float(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    // float(str) → f64 bits via forge_float_parse.
    // float(int) → f64 bits via int-to-double cast + bitcast.
    match args {
        .End -> err_emit("float() expects 1 arg")
        .Node(se, _) -> {
            let r = ctx.emit(env, se.node)?
            if vtype_eq(r.ty, .Float) {
                return r
            }
            if vtype_is_str(r.ty) {
                let str_ptr = ctx.to_ptr(r.value, "f_parse_arg")
                return ok_emit_typed(ctx.call("forge_float_parse", [str_ptr]), .Float)
            }
            // Int → float: use sitofp + bitcast
            let dbl = forge_llvm_build_si_to_fp(ctx.builder, r.value, forge_llvm_double_type(ctx.lc), "i2f")
            ok_emit_typed(forge_llvm_build_bitcast(ctx.builder, dbl, ctx.i64_type, "f_bits"), .Float)
        }
    }
}

export fn emit_panic(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {
    match args {
        .End -> err_emit("panic() expects 1 argument")
        .Node(se, _) -> {
            let r = ctx.emit(env, se.node)?
            // Print "panic: <message>" to stderr
            let prefix = ctx.global_str("panic: ", ".panic_prefix")
            let prefix_i64 = ctx.to_i64(prefix, "prefix_i64")
            let msg = emit_concat(ctx, prefix_i64, r.value)
            let msg_ptr = ctx.to_ptr(msg.value, "panic_msg")
            let eprint_fn = ctx.get_fn("forge_eprintln")
            let arr = forge_llvm_value_array_new(1)
            forge_llvm_value_array_set(arr, 0, msg_ptr)
            let void_type = forge_llvm_void_type(ctx.lc)
            let pa = forge_llvm_type_array_new(1)
            forge_llvm_type_array_set(pa, 0, ctx.ptr_type)
            let fn_type = forge_llvm_function_type(void_type, pa, 1, 0)
            forge_llvm_type_array_free(pa)
            forge_llvm_build_call(ctx.builder, fn_type, eprint_fn, arr, 1, "")
            forge_llvm_value_array_free(arr)
            // exit(1)
            ctx.call("exit", [ctx.i64(1)])
            // Unreachable — but return a value for the type system
            ok_emit(ctx.i64(0))
        }
    }
}

