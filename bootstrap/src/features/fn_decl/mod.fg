mod parser
mod codegen
use core.registry.{feature_new, register}

fn kw_parse_fn(p: Parser) -> Stmt? {
    p.parse_function_declaration()
}

export fn init_fn_decl(reg: Registry) {
    let f = feature_new("fn_decl") with {
        decl_keyword: "kw_fn",
        parse_decl: kw_parse_fn,
    }
    register(reg, f)
}
