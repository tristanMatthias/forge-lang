mod parser
mod codegen

export fn register_while_stmt(reg: Registry) -> Registry {
    register_stmt(reg, Stmt.While(Expr.Null, Stmt.NoOp), stmt_only("while", while_emit_stmt))
}

fn while_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt { .While(cond, body) -> emit_while(ctx, env, cond, body), _ -> err_stmt("expected While") }
}
