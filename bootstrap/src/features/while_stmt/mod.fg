mod parser
mod codegen

fn kw_parse_while(p: Parser) -> Stmt? {
    p.parse_while_statement()
}

export fn init_while_stmt(reg: Registry) {
    let f = feature_new("while") with {
        stmt_tag: Stmt.While(Expr.Null, Stmt.NoOp),
        emit_stmt: while_emit_stmt,
        stmt_keyword: "kw_while",
        parse_stmt: kw_parse_while,
    }
    register(reg, f)
}

fn while_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt { .While(cond, body) -> emit_while(ctx, env, cond, body), _ -> err_stmt("expected While") }
}
