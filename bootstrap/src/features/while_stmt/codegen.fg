// WHY: emits LLVM IR for `while cond { body }` with break/continue
// support via the scoped loop stack in Ctx.

use core.ast.{Expr, Stmt, VarEnv}
use core.cg.{Ctx, LoopStack, StmtResult, ok_stmt, err_stmt_from_expr}
use codegen.{emit_expr, emit_stmt}

export fn emit_while(ctx: Ctx, env: VarEnv, condition: Expr, body: Stmt) -> StmtResult {
    let cond_bb = forge_llvm_append_basic_block(ctx.ctx, ctx.current_fn, "while.cond")
    let body_bb = forge_llvm_append_basic_block(ctx.ctx, ctx.current_fn, "while.body")
    let exit_bb = forge_llvm_append_basic_block(ctx.ctx, ctx.current_fn, "while.exit")
    forge_llvm_build_br(ctx.builder, cond_bb)

    forge_llvm_position_at_end(ctx.builder, cond_bb)
    let cond = emit_expr(ctx, env, condition)
    if cond.had_error { return err_stmt_from_expr(cond) }
    let cond_i1 = forge_llvm_build_icmp(ctx.builder, 33, cond.value, forge_llvm_const_int(ctx.i64_type, 0, 0), "while_cond")
    forge_llvm_build_cond_br(ctx.builder, cond_i1, body_bb, exit_bb)

    // Scoped loop stack: create a new Ctx with this loop's
    // frame pushed. The body sees it; the outer cg is unchanged.
    forge_llvm_position_at_end(ctx.builder, body_bb)
    let body_cg = Ctx {
        ctx: ctx.ctx,
        module: ctx.module,
        builder: ctx.builder,
        current_fn: ctx.current_fn,
        i64_type: ctx.i64_type,
        i1_type: ctx.i1_type,
        ptr_type: ctx.ptr_type,
        structs: ctx.structs,
        enums: ctx.enums,
        fn_rets: ctx.fn_rets,
        top_level_vars: ctx.top_level_vars,
        loops: LoopStack.Frame(cond_bb, exit_bb, ctx.loops),
    }
    let body_result = emit_stmt(body_cg, env, body)
    if body_result.had_error { return body_result }
    if forge_llvm_block_has_terminator(ctx.builder) == 0 {
        forge_llvm_build_br(ctx.builder, cond_bb)
    }

    forge_llvm_position_at_end(ctx.builder, exit_bb)
    ok_stmt(env)
}
