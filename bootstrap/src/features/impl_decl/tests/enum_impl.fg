/// expect: red
/// expect: green
/// expect: blue

enum Color {
    Red
    Green
    Blue
}

impl Color {
    fn name(self) -> string {
        match self {
            .Red -> "red"
            .Green -> "green"
            .Blue -> "blue"
        }
    }
}

fn main() {
    let r = Color.Red
    let g = Color.Green
    let b = Color.Blue
    println(r.name())
    println(g.name())
    println(b.name())
}
