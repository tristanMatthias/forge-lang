// Canonical example of `impl` blocks with methods.

type Counter = {
    count: int
}

impl Counter {
    fn increment(self) {
        self.count = self.count + 1
    }

    fn value(self) -> int {
        self.count
    }
}

fn main() {
    mut c = Counter { count: 0 }
    c.increment()
    c.increment()
    c.increment()
    println(string(c.value()))
}
