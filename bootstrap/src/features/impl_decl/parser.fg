// WHY: parses `impl Type { fn method(self) { ... } }` blocks. Each
// method is desugared to a free function named `Type__method`.

use core.ast.{Stmt, StmtList, ParamList}
use parse.{Parser}

impl Parser {
    fn parse_impl_declaration(self) -> Stmt? {
        self.advance()
        let type_name = self.consume_identifier("expected type name after `impl`")
        if type_name == null { return null }
        if !self.consume("left_brace", "expected `{` after impl type name") {
            return null
        }
        let methods = self.parse_impl_methods(type_name!)
        if methods == null { return null }
        if !self.consume("right_brace", "expected `}` after impl block") {
            return null
        }
        Stmt.Impl(type_name!, methods!)
    }

    fn parse_impl_methods(self, type_name: string) -> StmtList? {
        if self.check("right_brace") {
            return StmtList.End
        }
        if !self.check("kw_fn") {
            self.set_error("expected `fn` inside impl block")
            return null
        }
        let method = self.parse_method_declaration(type_name)
        if method == null { return null }
        let rest = self.parse_impl_methods(type_name)
        if rest == null { return null }
        StmtList.Node(method!, rest!)
    }

    fn parse_method_declaration(self, type_name: string) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected method name")
        if name == null { return null }
        if !self.consume("left_paren", "expected `(` after method name") {
            return null
        }
        // The first parameter is conventionally `self` (implicitly
        // typed as the impl's owner type). Skip it if present and
        // synthesize a properly-typed self param ourselves.
        let params = self.parse_method_param_list(type_name)
        if params == null { return null }
        if !self.consume("right_paren", "expected `)` after parameters") {
            return null
        }
        let ret_ty = if self.check("arrow") {
            self.advance()
            let r = self.consume_type("expected return type after `->`")
            if r == null { return null }
            r!
        } else {
            "i64"
        }
        if !self.consume("left_brace", "expected `{` after method parameters") {
            return null
        }
        let body = self.parse_statement_list(true)
        if body == null { return null }
        if !self.consume("right_brace", "expected `}` after method body") {
            return null
        }
        // Desugar to a top-level function named `Type__method`.
        let mangled = type_name + "__" + name!
        Stmt.Function(mangled, params!, ret_ty, body!)
    }

    fn parse_method_param_list(self, type_name: string) -> ParamList? {
        if self.check("right_paren") {
            return ParamList.End
        }
        // Detect leading `self` and prepend it as a typed parameter.
        if self.check("identifier") && self.current_lexeme == "self" {
            self.advance()
            // Optional `: Type` after self — discarded.
            if self.check("colon") {
                self.advance()
                let _ty = self.consume_type("expected type after `:`")
                if _ty == null { return null }
            }
            // self is followed by either `,` (more params) or `)`.
            if self.check("comma") {
                self.advance()
                let rest = self.parse_param_list()
                if rest == null { return null }
                return ParamList.Node("self", type_name, rest!)
            }
            return ParamList.Node("self", type_name, ParamList.End)
        }
        self.parse_param_list()
    }
}
