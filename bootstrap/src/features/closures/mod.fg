// WHY: closures/lambdas — `(x) -> x * 2`. Lambdas are lifted into
// top-level functions and their pointers are passed as i64 values.
// This enables higher-order functions, .map/.filter on lists, and
// callback patterns.

mod codegen

export fn register_closures(reg: Registry) -> Registry {
    reg_expr(reg, 26, reg_emit_lambda_f)
}

fn reg_emit_lambda_f(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .Lambda(params, body) -> emit_lambda(ctx, env, params, body), _ -> err_emit("expected Lambda") }
}
