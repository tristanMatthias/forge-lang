mod codegen

export fn init_closures(reg: Registry) {
    let f = feature_new("lambda") with {
        expr_tag: Expr.Lambda(ParamList.End, Expr.Null),
        emit_expr: lambda_emit,
    }
    register(reg, f)
}

fn lambda_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .Lambda(params, body) -> emit_lambda(ctx, env, params, body), _ -> err_emit("expected Lambda") }
}
