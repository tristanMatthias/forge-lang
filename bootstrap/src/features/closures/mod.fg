mod codegen

export fn register_closures(reg: Registry) -> Registry {
    register_feature(reg, Feature { name: "lambda", expr_tag: 26, stmt_tag: 0 - 1, emit_expr: lambda_emit, emit_stmt: noop_stmt })
}

fn lambda_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .Lambda(params, body) -> emit_lambda(ctx, env, params, body), _ -> err_emit("expected Lambda") }
}
