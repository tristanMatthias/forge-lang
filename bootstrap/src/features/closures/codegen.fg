// WHY: codegen for lambda/closure expressions.
//
// A lambda `(x, y) -> expr` is compiled to:
// 1. A lifted top-level function `__lambda_N(x, y) -> i64`
// 2. A pointer to that function (returned as i64)
//
// Closures that capture variables from the enclosing scope pack
// the captures into a heap-allocated environment. The lifted
// function takes the environment as an extra first argument.
// The closure value is (fn_ptr, env_ptr) — a 2-element tuple.
//
// For non-capturing lambdas (the common case), the closure value
// is just the function pointer with a null environment.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length, ValueType, TypeList, vtype_closure_captures, vtype_is_closure, vtype_fn_ret, SExpr, SStmt}
use core.cg.{Ctx, EmitResult, ok_emit, err_emit, null_ptr_val, const_i64, to_ptr, to_i64, ctx_with_fn, get_fn, call_0, call_2, DeferStack}
use codegen.{emit_expr}
use features.defer_stmt.codegen.{DEFER_STACK, defer_reset}

// ── Capture detection ──

enum CaptureList {
    End,
    Node(name: string, alloca: ptr, ty: ValueType, next: CaptureList),
}

fn capture_list_len(list: CaptureList) -> int {
    match list {
        .End -> 0
        .Node(_, _, _, next) -> 1 + capture_list_len(next)
    }
}

fn is_param(params: ParamList, name: string) -> bool {
    match params {
        .End -> false
        .Node(pname, _, next) -> {
            if pname == name { return true }
            is_param(next, name)
        }
    }
}

fn is_captured(captures: CaptureList, name: string) -> bool {
    match captures {
        .End -> false
        .Node(cname, _, _, next) -> {
            if cname == name { return true }
            is_captured(next, name)
        }
    }
}

fn find_captures(expr: Expr, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match expr {
        .Ident(name) -> {
            if is_param(params, name) { return captures }
            if is_captured(captures, name) { return captures }
            let lookup = env_lookup(env, name)
            if !lookup.found { return captures }
            CaptureList.Node(name, lookup.alloca, lookup.ty, captures)
        }
        .Binary(left, _, right) -> {
            let c1 = find_captures(left, params, env, captures)
            find_captures(right, params, env, c1)
        }
        .Unary(_, right) -> find_captures(right, params, env, captures)
        .Logical(left, _, right) -> {
            let c1 = find_captures(left, params, env, captures)
            find_captures(right, params, env, c1)
        }
        .Call(callee, args) -> {
            let c1 = find_captures(callee, params, env, captures)
            find_captures_list(args, params, env, c1)
        }
        .Grouping(inner) -> find_captures(inner, params, env, captures)
        .IfExpr(c, t, e) -> {
            let c1 = find_captures(c, params, env, captures)
            let c2 = find_captures(t, params, env, c1)
            find_captures(e, params, env, c2)
        }
        .Block(stmts) -> find_captures_stmts(stmts, params, env, captures)
        .Assign(_, value) -> find_captures(value, params, env, captures)
        .Index(obj, idx) -> {
            let c1 = find_captures(obj, params, env, captures)
            find_captures(idx, params, env, c1)
        }
        _ -> captures
    }
}

fn find_captures_list(exprs: ExprList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match exprs {
        .End -> captures
        .Node(se, next) -> {
            let c1 = find_captures(se.node, params, env, captures)
            find_captures_list(next, params, env, c1)
        }
    }
}

fn find_captures_stmt_body(stmt: Stmt, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match stmt {
        .Block(stmts) -> find_captures_stmts(stmts, params, env, captures)
        .Expr(e) -> find_captures(e, params, env, captures)
        _ -> captures
    }
}

fn find_captures_stmts(stmts: StmtList, params: ParamList, env: VarEnv, captures: CaptureList) -> CaptureList {
    match stmts {
        .End -> captures
        .Node(ss, next) -> {
            let c1 = match ss.node {
                .Expr(e) -> find_captures(e, params, env, captures)
                .Return(e) -> find_captures(e, params, env, captures)
                .Let(_, _, init) -> find_captures(init, params, env, captures)
                .Mut(_, _, init) -> find_captures(init, params, env, captures)
                .If(cond, then_branch, _) -> {
                    let cc = find_captures(cond, params, env, captures)
                    find_captures_stmt_body(then_branch, params, env, cc)
                }
                .While(cond, body) -> {
                    let cc = find_captures(cond, params, env, captures)
                    find_captures_stmt_body(body, params, env, cc)
                }
                .For(_, start, end, body) -> {
                    let cc = find_captures(start, params, env, captures)
                    let cc2 = find_captures(end, params, env, cc)
                    find_captures_stmt_body(body, params, env, cc2)
                }
                .Block(inner_stmts) -> find_captures_stmts(inner_stmts, params, env, captures)
                .Match(subject, _) -> find_captures(subject, params, env, captures)
                _ -> captures
            }
            find_captures_stmts(next, params, env, c1)
        }
    }
}

// Global lambda counter for unique names.
// This is the ONE allowed mutable global — it's a monotonic counter
// that never resets. Thread-safe because the bootstrap is single-threaded.
export mut LAMBDA_COUNTER = 0

// Compile a lambda with default parameter types (all Int).
export fn emit_lambda(ctx: Ctx, env: VarEnv, params: ParamList, body: Expr) -> EmitResult {
    emit_lambda_typed(ctx, env, params, body, TypeList.End)
}

// Compile a lambda with explicit parameter types.
// Used by .map/.filter/.reduce to pass the list's element type
// so that int(x) / x.length / etc. work correctly inside the lambda.
export fn emit_lambda_typed(ctx: Ctx, env: VarEnv, params: ParamList, body: Expr, param_types: TypeList) -> EmitResult {
    let id = LAMBDA_COUNTER
    LAMBDA_COUNTER = LAMBDA_COUNTER + 1
    let name = "__lambda_" + string(id)

    // Detect captured variables from the enclosing scope
    let captures = find_captures(body, params, env, CaptureList.End)
    let num_captures = capture_list_len(captures)
    let arity = param_list_length(params) + num_captures

    let param_arr = forge_llvm_type_array_new(arity)
    fill_i64_params(param_arr, ctx.i64_type, 0, arity)
    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arity, 0)
    forge_llvm_type_array_free(param_arr)
    let fn_val = forge_llvm_add_function(ctx.module, name, fn_type)

    let saved_bb = forge_llvm_get_insert_block(ctx.builder)

    let entry = forge_llvm_append_basic_block(ctx.lc, fn_val, "entry")
    forge_llvm_position_at_end(ctx.builder, entry)

    // Bind declared params first, then captured vars as extra params
    let num_declared = param_list_length(params)
    let env_with_params = bind_lambda_params_typed(ctx, env, params, fn_val, 0, param_types)
    let body_env = bind_captures_as_params(ctx, env_with_params, captures, fn_val, num_declared)

    let body_ctx = ctx_with_fn(ctx, fn_val)
    // Save/restore defer stack so lambda's `return` doesn't emit
    // the outer function's defers.
    let saved_defers = DEFER_STACK
    defer_reset()
    let result = emit_expr(body_ctx, body_env, body)
    DEFER_STACK = saved_defers  // restore outer function's defers
    if result.had_error {
        forge_llvm_position_at_end(ctx.builder, saved_bb)
        return result
    }

    if forge_llvm_block_has_terminator(ctx.builder) == 0 {
        forge_llvm_build_ret(ctx.builder, result.value)
    }

    forge_llvm_position_at_end(ctx.builder, saved_bb)

    // If there are captures, we need to pass the captured values at call time.
    // Pack: [fn_ptr, cap1, cap2, ...] into an array. The C runtime's
    // ALL lambdas use closure arrays: [TAG, fn_ptr, cap1, cap2, ...]
    // Even non-capturing ones get [TAG, fn_ptr] so the C-side
    // forge_closure_call_* trampolines can safely inspect them.
    // Only named function references (let f = my_fn) are bare pointers.
    let arr_fn = get_fn(ctx, "forge_array_new")
    let push_fn = get_fn(ctx, "forge_array_push")
    let closure_arr = call_0(ctx, arr_fn, "closure")
    let tag = const_i64(ctx, -559038737)  // FORGE_CLOSURE_TAG
    call_2(ctx, push_fn, closure_arr, tag, "")
    let fn_ptr_i64 = forge_llvm_build_ptr_to_int(ctx.builder, fn_val, ctx.i64_type, "lambda_ptr")
    call_2(ctx, push_fn, closure_arr, fn_ptr_i64, "")
    if num_captures > 0 {
        push_captured_values(ctx, captures, closure_arr, push_fn)
    }
    let closure_i64 = to_i64(ctx, closure_arr, "closure_i64")
    EmitResult { value: closure_i64, ty: ValueType.Closure(num_captures, result.ty), had_error: false, error_message: "" }
}

fn bind_captures_as_params(ctx: Ctx, env: VarEnv, captures: CaptureList, fn_val: ptr, idx: int) -> VarEnv {
    match captures {
        .End -> env
        .Node(name, _, ty, next) -> {
            let param_val = forge_llvm_get_param(fn_val, idx)
            let alloca = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, name)
            forge_llvm_build_store(ctx.builder, param_val, alloca)
            let new_env = env_extend(env, name, alloca, ty)
            bind_captures_as_params(ctx, new_env, next, fn_val, idx + 1)
        }
    }
}

fn push_captured_values(ctx: Ctx, captures: CaptureList, arr: ptr, push_fn: ptr) {
    match captures {
        .End -> {}
        .Node(_, alloca, _, next) -> {
            let val = forge_llvm_build_load(ctx.builder, ctx.i64_type, alloca, "cap_val")
            call_2(ctx, push_fn, arr, val, "")
            push_captured_values(ctx, next, arr, push_fn)
        }
    }
}

// Emit a lambda argument with typed parameters. If the argument
// expression is a Lambda, compile it with explicit param types so
// that type-dependent operations (int(x), x.length, x.upper())
// work correctly inside the lambda body.
export fn emit_typed_lambda_arg(ctx: Ctx, env: VarEnv, args: ExprList, param_types: TypeList) -> EmitResult {
    match args {
        .End -> err_emit("expected 1 argument, got 0")
        .Node(se, _) -> {
            match se.node {
                .Lambda(params, body) -> emit_lambda_typed(ctx, env, params, body, param_types)
                _ -> emit_expr(ctx, env, se.node)
            }
        }
    }
}

// Call a function pointer stored in a local variable.
// Load the pointer, cast to fn ptr, build indirect call.
export fn emit_indirect_call(ctx: Ctx, env: VarEnv, alloca: ptr, name: string, args: ExprList) -> EmitResult {
    let fn_i64 = forge_llvm_build_load(ctx.builder, ctx.i64_type, alloca, name)
    let local = env_lookup(env, name)
    let ret_ty = vtype_fn_ret(local.ty)
    // Closure values (lambda expressions) are arrays that need unpacking.
    // Fn values (named function refs) are bare pointers that can be called directly.
    if vtype_is_closure(local.ty) {
        let num_caps = vtype_closure_captures(local.ty)
        return emit_closure_call_typed(ctx, env, fn_i64, args, num_caps, ret_ty)
    }
    emit_indirect_call_typed(ctx, env, fn_i64, args, ret_ty)
}

export fn emit_indirect_call_from_global(ctx: Ctx, env: VarEnv, global: ptr, name: string, args: ExprList, ty: ValueType) -> EmitResult {
    let fn_i64 = forge_llvm_build_load(ctx.builder, ctx.i64_type, global, name)
    let ret_ty = vtype_fn_ret(ty)
    if vtype_is_closure(ty) {
        let num_caps = vtype_closure_captures(ty)
        return emit_closure_call_typed(ctx, env, fn_i64, args, num_caps, ret_ty)
    }
    emit_indirect_call_typed(ctx, env, fn_i64, args, ret_ty)
}

// Call a closure with captures. The closure value is a ForgeArray:
// [0] = fn_ptr, [1..N] = captured values.
// We unpack fn_ptr, evaluate user args, append captures, and call.
fn emit_closure_call(ctx: Ctx, env: VarEnv, closure_val: ptr, args: ExprList, num_captures: int) -> EmitResult {
    // Closure array layout: [TAG, fn_ptr, cap1, cap2, ...]
    // TAG is at index 0, fn_ptr at index 1, captures start at index 2.
    let closure_ptr = to_ptr(ctx, closure_val, "closure_ptr")
    // Load fn_ptr from closure array[1] (index 0 is the TAG)
    let get_fn_call = call_2(ctx, get_fn(ctx, "forge_array_get"), closure_ptr, const_i64(ctx, 1), "closure_fn")
    let fn_ptr = forge_llvm_build_int_to_ptr(ctx.builder, get_fn_call, ctx.ptr_type, "fn_ptr")

    let user_arg_count = expr_list_length(args)
    let total_args = user_arg_count + num_captures

    let param_arr = forge_llvm_type_array_new(total_args)
    fill_i64_params(param_arr, ctx.i64_type, 0, total_args)
    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, total_args, 0)
    forge_llvm_type_array_free(param_arr)

    let val_arr = forge_llvm_value_array_new(total_args)
    let fill = fill_lambda_args(ctx, env, val_arr, args, 0)
    if fill.had_error {
        forge_llvm_value_array_free(val_arr)
        return fill
    }
    // Fill captures from closure array (start at index 2)
    fill_closure_captures(ctx, val_arr, closure_ptr, user_arg_count, num_captures, 0)

    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_ptr, val_arr, total_args, "closure_call")
    forge_llvm_value_array_free(val_arr)
    ok_emit(result)
}

fn fill_closure_captures(ctx: Ctx, val_arr: ptr, closure_val: ptr, start_idx: int, count: int, i: int) {
    if i >= count { return }
    // Captures start at array index 2 (after TAG and fn_ptr)
    let cap_val = call_2(ctx, get_fn(ctx, "forge_array_get"), closure_val, const_i64(ctx, i + 2), "cap")
    forge_llvm_value_array_set(val_arr, start_idx + i, cap_val)
    fill_closure_captures(ctx, val_arr, closure_val, start_idx, count, i + 1)
}

fn emit_indirect_call_typed(ctx: Ctx, env: VarEnv, fn_i64: ptr, args: ExprList, ret_ty: ValueType) -> EmitResult {
    let r = emit_indirect_call_value(ctx, env, fn_i64, args)
    if r.had_error { return r }
    ok_emit_typed(r.value, ret_ty)
}

fn emit_closure_call_typed(ctx: Ctx, env: VarEnv, fn_i64: ptr, args: ExprList, num_captures: int, ret_ty: ValueType) -> EmitResult {
    let r = emit_closure_call(ctx, env, fn_i64, args, num_captures)
    if r.had_error { return r }
    ok_emit_typed(r.value, ret_ty)
}

fn emit_indirect_call_value(ctx: Ctx, env: VarEnv, fn_i64: ptr, args: ExprList) -> EmitResult {
    // Unified indirect call — handles BOTH bare fn pointers AND closure
    // arrays transparently. No arity limits, no C trampolines.
    //
    // 1. Call forge_closure_get_fn to extract the fn pointer (works for both)
    // 2. Call forge_closure_num_captures to get capture count (0 for bare ptrs)
    // 3. Build a value array with [user_args..., captures...]
    // 4. Emit a direct LLVM indirect call
    let user_arg_count = expr_list_length(args)

    let resolved_fn = call_1(ctx, get_fn(ctx, "forge_closure_get_fn"), fn_i64, "resolved_fn")
    let fn_ptr = forge_llvm_build_int_to_ptr(ctx.builder, resolved_fn, ctx.ptr_type, "fn_ptr")
    let num_caps = call_1(ctx, get_fn(ctx, "forge_closure_num_captures"), fn_i64, "num_caps")

    // We need to handle two cases at COMPILE TIME since LLVM call
    // instructions need a fixed arg count. But num_caps is a runtime value.
    // Solution: for the general case, use the maximum possible capture
    // count. But we don't know it at compile time.
    //
    // Practical approach: since this path is for values whose type says
    // Fn (not Closure), AND closures that pass through return values lose
    // their Closure type, we use forge_closure_call_N C trampolines only
    // when the type is ambiguous. For known-bare-fn calls (from Ident
    // resolution of named functions), we skip to direct call.
    //
    // For now: use forge_closure_call_N for any indirect call that
    // MIGHT be a closure. This is the safe path.

    // Fast path: if we KNOW it's a bare fn pointer (type == Fn from a
    // named function reference), do a direct call with no capture handling.
    // This is the common case for the feature registry.

    // Slow path: use the appropriate forge_closure_call_N trampoline.
    // These handle both bare ptrs and closure arrays at runtime.
    if user_arg_count == 0 {
        return ok_emit(call_1(ctx, get_fn(ctx, "forge_closure_call_0"), fn_i64, "ccall"))
    }
    if user_arg_count == 1 {
        match args {
            .Node(se, _) -> {
                let a0 = emit_expr(ctx, env, se.node)
                if a0.had_error { return a0 }
                return ok_emit(call_2(ctx, get_fn(ctx, "forge_closure_call_1"), fn_i64, a0.value, "ccall"))
            }
            _ -> { return err_emit("expected 1 arg") }
        }
    }
    if user_arg_count == 2 {
        match args {
            .Node(se0, rest) -> {
                let a0 = emit_expr(ctx, env, se0.node)
                if a0.had_error { return a0 }
                match rest {
                    .Node(se1, _) -> {
                        let a1 = emit_expr(ctx, env, se1.node)
                        if a1.had_error { return a1 }
                        return ok_emit(call_3(ctx, get_fn(ctx, "forge_closure_call_2"), fn_i64, a0.value, a1.value, "ccall"))
                    }
                    _ -> { return err_emit("expected 2 args") }
                }
            }
            _ -> { return err_emit("expected 2 args") }
        }
    }
    if user_arg_count == 3 {
        match args {
            .Node(se0, rest0) -> {
                let a0 = emit_expr(ctx, env, se0.node)
                if a0.had_error { return a0 }
                match rest0 {
                    .Node(se1, rest1) -> {
                        let a1 = emit_expr(ctx, env, se1.node)
                        if a1.had_error { return a1 }
                        match rest1 {
                            .Node(se2, _) -> {
                                let a2 = emit_expr(ctx, env, se2.node)
                                if a2.had_error { return a2 }
                                return ok_emit(call_4(ctx, get_fn(ctx, "forge_closure_call_3"), fn_i64, a0.value, a1.value, a2.value, "ccall"))
                            }
                            _ -> { return err_emit("expected 3 args") }
                        }
                    }
                    _ -> { return err_emit("expected 3 args") }
                }
            }
            _ -> { return err_emit("expected 3 args") }
        }
    }
    err_emit("indirect calls with " + string(user_arg_count) + " args not yet supported")
}

fn fill_lambda_args(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(se, next) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error { return r }
            forge_llvm_value_array_set(arr, idx, r.value)
            fill_lambda_args(ctx, env, arr, next, idx + 1)
        }
    }
}

fn fill_i64_params(arr: ptr, i64t: ptr, idx: int, count: int) {
    if idx >= count { return }
    forge_llvm_type_array_set(arr, idx, i64t)
    fill_i64_params(arr, i64t, idx + 1, count)
}

fn bind_lambda_params_typed(ctx: Ctx, env: VarEnv, params: ParamList, fn_val: ptr, idx: int, types: TypeList) -> VarEnv {
    match params {
        .End -> env
        .Node(name, _, next) -> {
            let param_val = forge_llvm_get_param(fn_val, idx)
            let alloca = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, name)
            forge_llvm_build_store(ctx.builder, param_val, alloca)
            // Use the provided type if available, else default to Int
            let ty = match types {
                .Node(t, _) -> t
                .End -> ValueType.Int
            }
            let rest_types = match types {
                .Node(_, rest) -> rest
                .End -> TypeList.End
            }
            let new_env = env_extend(env, name, alloca, ty)
            bind_lambda_params_typed(ctx, new_env, next, fn_val, idx + 1, rest_types)
        }
    }
}
