// Lambda returning lambda — fn signature carries return type
let make: fn(int) -> fn(int) -> int = (n) -> {
    (x) -> x + n
}
let add5 = make(5)
println(string(add5(10)))
println(string(add5(20)))

// Named function returning closure
fn make_multiplier(n: int) -> fn(int) -> int {
    (x) -> x * n
}
let triple = make_multiplier(3)
println(string(triple(7)))

// Compose with full signature
fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
    (x) -> f(g(x))
}
let inc = (x) -> x + 1
let dbl = (x) -> x * 2
let pipeline = compose(dbl, inc)
println(string(pipeline(5)))
