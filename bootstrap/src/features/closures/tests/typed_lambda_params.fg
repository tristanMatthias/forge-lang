// The bug: int(x) inside reduce lambda on string list
// x was typed as Int, so int(x) passed through without calling atoi
let csv = "10,20,30,40,50"
let values = csv.split(",")
let total = values.reduce(0, (acc, x) -> acc + int(x))
println(string(total))

// Map on string list — x should be typed Str
let upper_parts = "hello,world".split(",").map((x) -> x.upper())
for p in upper_parts {
    println(p)
}

// Filter on string list 
let long_words = ["hi", "hello", "hey", "greetings"].filter((w) -> w.length > 3)
for w in long_words {
    println(w)
}

// Foreach on string list
["a", "b", "c"].foreach((s) -> println(s.upper()))
