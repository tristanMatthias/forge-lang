fn apply(f: fn(int) -> int, x: int) -> int { f(x) }
println(string(apply((x) -> x * 3, 7)))

let negate: fn(int) -> int = (x) -> -x
println(string(negate(42)))

fn make_adder(n: int) -> fn(int) -> int { (x) -> x + n }
let add10 = make_adder(10)
println(string(add10(5)))
println(string(add10(20)))

fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
    (x) -> f(g(x))
}
let inc = (x) -> x + 1
let dbl = (x) -> x * 2
println(string(compose(dbl, inc)(5)))

type Handler = { name: string, action: fn(int) -> int }
let h = Handler { name: "sq", action: (x) -> x * x }
println(string(h.action(7)))
