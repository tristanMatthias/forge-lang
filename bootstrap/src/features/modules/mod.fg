// WHY: module system feature — mod declarations, use imports, export
// visibility, name resolution with qualified identifiers.
//
// This feature has three passes that run before codegen:
//   1. resolver.fg — reads module files, attaches parsed bodies to AST
//   2. names.fg — builds module tree, resolves use aliases, rewrites
//      Expr.Ident → Expr.QualifiedIdent with canonical paths
//   3. codegen integration — Stmt.Module/Use handled as structural
//      recursion in the core codegen passes (not feature-dispatched)
//
// The parser (parser.fg) produces Stmt.Module and Stmt.Use nodes.
// Export is handled in parse/mod.fg since it applies to all declarations.

mod parser
mod resolver
mod names

fn kw_parse_mod(p: Parser) -> Stmt? {
    p.parse_module_declaration()
}

fn kw_parse_use(p: Parser) -> Stmt? {
    p.parse_use_declaration()
}

export fn init_modules(reg: Registry) {
    let f1 = feature_new("mod") with {
        decl_keyword: "kw_mod",
        parse_decl: kw_parse_mod,
    }
    register(reg, f1)

    let f2 = feature_new("use") with {
        decl_keyword: "kw_use",
        parse_decl: kw_parse_use,
    }
    register(reg, f2)
}
