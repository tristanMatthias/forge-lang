// Basic map operations
let m = {"x": "10", "y": "20", "z": "30"}
println(string(m.length))
println(m.get("x"))
println(m.get("z"))

// has
println(string(m.has("x")))
println(string(m.has("w")))

// set overwrites
m.set("x", "99")
println(m.get("x"))

// Empty map
let e = {}
println(string(e.length))
println(string(e.has("anything")))

// keys returns a list
let k = m.keys()
println(string(k.length))

// Map with numeric values (stored as i64)
let nums = {"a": 1, "b": 2, "c": 3}
let sum = nums.get("a") + nums.get("b") + nums.get("c")
println(string(sum))
