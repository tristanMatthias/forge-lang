// WHY: type checking for map method calls.

use core.ast.{ExprList, ValueType}
use typeck.{TC, ExprResult, tc_er}

export fn check_map_method(tc: TC, method: string) -> ExprResult {
    if method == "get" { return tc_er(tc, .Str) }
    if method == "has" { return tc_er(tc, .Bool) }
    if method == "set" { return tc_er(tc, .Void) }
    if method == "keys" { return tc_er(tc, ValueType.List(ValueType.Str)) }
    if method == "length" { return tc_er(tc, .Int) }
    tc_er(tc, .Int)
}
