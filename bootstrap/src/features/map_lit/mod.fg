mod codegen

export fn register_map_lit(reg: Registry) -> Registry {
    register_feature(reg, expr_feature("map_lit", 27, map_emit))
}

fn map_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .MapLit(entries) -> emit_map_lit(ctx, env, entries), _ -> err_emit("expected MapLit") }
}
