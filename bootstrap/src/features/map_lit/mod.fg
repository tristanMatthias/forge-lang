// WHY: map literals {"key": value, ...} backed by C-runtime hash maps.

mod codegen

export fn register_map_lit(reg: Registry) -> Registry {
    reg_expr(reg, 27, reg_emit_map_lit_f)
}

fn reg_emit_map_lit_f(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .MapLit(entries) -> emit_map_lit(ctx, env, entries), _ -> err_emit("expected MapLit") }
}
