mod codegen

fn kw_parse_select(p: Parser) -> Stmt? {
    p.parse_select_statement()
}

export fn init_select_stmt(reg: Registry) {
    let f = feature_new("select") with {
        stmt_tag: Stmt.Select(SelectArmList.End),
        emit_stmt: select_emit_stmt,
        decl_keyword: "kw_select",
        parse_decl: kw_parse_select,
    }
    register(reg, f)
}
