// WHY: codegen for `select { binding <- channel -> { body } }`.
// Builds an array of channel pointers, calls forge_select to block
// until one has data, then dispatches to the matching arm.

use codegen.types.{err_stmt, ok_stmt}
use codegen.blocks.{emit_block_loop}
export fn select_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Select(arms) -> emit_select(ctx, env, arms)
        _ -> err_stmt("select_emit_stmt: expected Select")
    }
}

fn emit_select(ctx: Ctx, env: VarEnv, arms: SelectArmList) -> StmtResult {
    let channels = ctx.call("forge_array_new", [])
    let count = push_channels(ctx, env, arms, channels, 0)

    let result = ctx.call("forge_select", [channels, ctx.i64(count)])
    let idx = ctx.call("forge_select_index", [result])
    let val = ctx.call("forge_select_value", [result])

    emit_select_dispatch(ctx, env, arms, idx, val, 0)
}

fn push_channels(ctx: Ctx, env: VarEnv, arms: SelectArmList, arr: ptr, count: int) -> int {
    match arms {
        .End -> count
        .Node(_, channel, _, next) -> {
            let r = ctx.emit(env, channel)
            if r.had_error { return count }
            ctx.call("forge_array_push", [arr, ctx.to_i64(r.value, "ch_i64")])
            push_channels(ctx, env, next, arr, count + 1)
        }
    }
}

fn emit_select_dispatch(ctx: Ctx, env: VarEnv, arms: SelectArmList, idx: ptr, val: ptr, arm_idx: int) -> StmtResult {
    match arms {
        .End -> ok_stmt(env)
        .Node(binding, _, body, next) -> {
            let cmp = ctx.eq(idx, ctx.i64(arm_idx), "sel_cmp")
            let then_bb = ctx.bb("sel_then")
            let else_bb = ctx.bb("sel_else")
            let merge_bb = ctx.bb("sel_merge")
            ctx.cond_br(cmp, then_bb, else_bb)

            ctx.position(then_bb)
            let body_env = ctx.bind(env, binding, val, .Int)
            let body_r = emit_block_loop(ctx, body_env, body, ctx.i64(0), .Int)
            if body_r.had_error { return err_stmt(body_r.error_message) }
            ctx.br_if_open(merge_bb)

            ctx.position(else_bb)
            let next_r = emit_select_dispatch(ctx, env, next, idx, val, arm_idx + 1)?
            ctx.br_if_open(merge_bb)

            ctx.position(merge_bb)
            ok_stmt(env)
        }
    }
}
