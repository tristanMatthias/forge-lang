mod parser
mod codegen

export fn register_match(reg: Registry) -> Registry {
    register_dual(reg, Expr.MatchExpr(Expr.Null, MatchArmList.End), Stmt.Match(Expr.Null, MatchArmList.End), Feature {
        name: "match",
        emit_expr: match_emit_expr,
        emit_stmt: match_emit_stmt,
        resolve_expr: noop_resolve,
        check_expr: noop_check,
    })
}

fn match_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .MatchExpr(subject, arms) -> emit_match_expr(ctx, env, subject, arms), _ -> err_emit("expected MatchExpr") }
}

fn match_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt { .Match(subject, arms) -> emit_match(ctx, env, subject, arms), _ -> err_stmt("expected Match") }
}
