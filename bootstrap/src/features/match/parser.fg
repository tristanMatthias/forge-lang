// WHY: parses `match` as both a statement and an expression, plus the
// pattern syntax that match arms use.
//
// AGENT:
//   read this file when:    adding match-arm forms or new pattern shapes
//   do NOT read this file when:   the issue is expression precedence (parser.fg)
//   related:                features/match/codegen.fg, core.ast.{Pattern, MatchArmList}

use core.ast.{Stmt, Expr, Pattern, MatchArmList, ParamList}
use parse.{Parser}

impl Parser {
    fn parse_match_statement(self) -> Stmt? {
        self.advance()
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject = self.parse_expression()
        self.allow_struct_lit = saved
        if subject == null { return null }
        if !self.consume("left_brace", "expected `{` after match subject") {
            return null
        }
        let arms = self.parse_match_arm_list()?
        if !self.consume("right_brace", "expected `}` after match arms") {
            return null
        }
        Stmt.Match(subject!, arms)
    }

    fn parse_match_arm_list(self) -> MatchArmList? {
        if self.check("right_brace") {
            return MatchArmList.End
        }
        let pattern = self.parse_pattern()?
        // Optional guard: `pattern if cond ->`
        let guard: Expr? = if self.check("kw_if") {
            self.advance()
            let g = self.parse_expression()?
            g
        } else {
            null
        }
        if !self.consume("arrow", "expected `->` after pattern") {
            return null
        }
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = false
        let body = self.parse_expression()
        self.allow_dot_postfix = saved
        if body == null { return null }
        if self.check("comma") {
            self.advance()
        }
        let rest = self.parse_match_arm_list()?
        MatchArmList.Node(pattern, guard, body!, rest)
    }

    fn parse_pattern(self) -> Pattern? {
        if self.check("identifier") && self.current_lexeme == "_" {
            self.advance()
            return Pattern.Wildcard
        }
        if !self.consume("dot", "expected `.` or `_` to start pattern") {
            return null
        }
        let name = self.consume_identifier("expected variant name in pattern")?
        if !self.check("left_paren") {
            return Pattern.Variant(name, ParamList.End)
        }
        self.advance()
        let bindings = self.parse_param_list()?
        if !self.consume("right_paren", "expected `)` after binding list") {
            return null
        }
        Pattern.Variant(name, bindings)
    }

    fn parse_match_expression(self) -> Expr? {
        self.advance()
        let saved_struct = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject = self.parse_expression()
        self.allow_struct_lit = saved_struct
        if subject == null { return null }
        if !self.consume("left_brace", "expected `{` after match subject") {
            return null
        }
        let arms = self.parse_match_arm_list()?
        if !self.consume("right_brace", "expected `}` after match arms") {
            return null
        }
        Expr.MatchExpr(subject!, arms)
    }
}
