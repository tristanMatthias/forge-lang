// Float literal support — f64 values stored as i64 bit patterns.

fn main() {
    // Float literals
    let x = 3.14
    x |> string |> println

    let y = 2.718
    y |> string |> println

    let z = 0.5
    z |> string |> println

    // float() conversion: string → float
    let a = float("9.81")
    a |> string |> println

    // float() conversion: int → float
    let b = float(100)
    b |> string |> println

    // Arithmetic
    let sum = 3.0 + 2.0
    sum |> string |> println
    println(string(3.0 * 2.0))
    println(string(10.0 / 4.0))
    println(string(10.0 - 3.5))

    // Negation
    println(string(-1.5))

    // Comparisons
    if 3.14 > 2.0 {
        println("gt")
    }
    if 1.0 < 2.0 {
        println("lt")
    }
    if 3.0 == 3.0 {
        println("eq")
    }

    // Float pattern matching
    let val = 3.14
    match val {
        1.0 -> println("one")
        3.14 -> println("pi")
        _ -> println("other")
    }
}
