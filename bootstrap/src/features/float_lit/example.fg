// Float literal support — f64 values stored as i64 bit patterns.

fn main() {
    // Float literals
    let x = 3.14
    println(string(x))

    let y = 2.718
    println(string(y))

    let z = 0.5
    println(string(z))

    // float() conversion: string → float
    let a = float("9.81")
    println(string(a))

    // float() conversion: int → float
    let b = float(100)
    println(string(b))

    // Arithmetic
    let sum = 3.0 + 2.0
    println(string(sum))
    println(string(3.0 * 2.0))
    println(string(10.0 / 4.0))
    println(string(10.0 - 3.5))

    // Negation
    println(string(-1.5))

    // Comparisons
    if 3.14 > 2.0 {
        println("gt")
    }
    if 1.0 < 2.0 {
        println("lt")
    }
    if 3.0 == 3.0 {
        println("eq")
    }
}
