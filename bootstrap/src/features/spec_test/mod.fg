mod parser
mod codegen

export fn register_spec_test(reg: Registry) -> Registry {
    mut r = register_stmt(reg, Stmt.SpecBlock("", StmtList.End), stmt_only("spec", spec_emit_stmt))
    r = register_stmt(r, Stmt.GivenBlock("", StmtList.End), stmt_only("given", spec_emit_stmt))
    r = register_stmt(r, Stmt.ThenBlock("", Expr.Null), stmt_only("then", spec_emit_stmt))
    r
}
