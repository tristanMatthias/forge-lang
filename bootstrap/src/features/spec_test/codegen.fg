// WHY: emits spec test runtime calls for spec/given/then blocks.

use core.ast.{sstmt_dummy}
use codegen.types.{err_stmt, ok_stmt}
use codegen.blocks.{emit_block_loop}
export fn spec_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<VarEnv, string> {
    match stmt {
        .SpecBlock(name, body) -> emit_spec_block(ctx, env, name, body)
        .GivenBlock(name, body) -> emit_given_block(ctx, env, name, body)
        .ThenBlock(name, cond) -> emit_then_block(ctx, env, name, cond)
        _ -> err_stmt("spec_emit_stmt: unexpected statement")
    }
}

fn emit_spec_block(ctx: Ctx, env: VarEnv, name: string, body: StmtList) -> Result<VarEnv, string> {
    let name_val = ctx.global_str(name, "spec_str")
    ctx.call("forge_test_start_spec", [name_val])
    let r = emit_spec_stmts(ctx, env, body)?
    ctx.call("forge_test_end_spec", [name_val])
    ok_stmt(env)
}

fn emit_given_block(ctx: Ctx, env: VarEnv, name: string, body: StmtList) -> Result<VarEnv, string> {
    let name_val = ctx.global_str(name, "spec_str")
    ctx.call("forge_test_start_given", [name_val])
    let new_env = emit_spec_stmts(ctx, env, body)?
    ctx.call("forge_test_end_given", [name_val])
    ok_stmt(new_env)
}

fn emit_then_block(ctx: Ctx, env: VarEnv, name: string, cond: Expr) -> Result<VarEnv, string> {
    let r = ctx.emit(env, cond)?
    ctx.call("forge_test_run_then", [ctx.global_str(name, "spec_str"), r.value])
    ok_stmt(env)
}

fn emit_spec_stmts(ctx: Ctx, env: VarEnv, stmts: StmtList) -> Result<VarEnv, string> {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let new_env = emit_spec_single(ctx, env, ss.node)?
            emit_spec_stmts(ctx, new_env, next)
        }
    }
}

fn emit_spec_single(ctx: Ctx, env: VarEnv, stmt: Stmt) -> Result<VarEnv, string> {
    match stmt {
        .SpecBlock(name, body) -> emit_spec_block(ctx, env, name, body)
        .GivenBlock(name, body) -> emit_given_block(ctx, env, name, body)
        .ThenBlock(name, cond) -> emit_then_block(ctx, env, name, cond)
        _ -> {
            let wrapped = StmtList.Node(sstmt_dummy(stmt), StmtList.End)
            emit_block_loop(ctx, env, wrapped, ctx.i64(0), .Int)?
            ok_stmt(env)
        }
    }
}
