// WHY: emits spec test runtime calls for spec/given/then blocks.

// Imports resolved by bootstrap's module-qualified name resolution.

use codegen.{emit_expr}
use core.ast.{sstmt_dummy}
use codegen.types.{call_1, call_2, const_i64, err_stmt, get_fn, ok_stmt}
use codegen.blocks.{emit_block_loop}
export fn spec_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .SpecBlock(name, body) -> emit_spec_block(ctx, env, name, body)
        .GivenBlock(name, body) -> emit_given_block(ctx, env, name, body)
        .ThenBlock(name, cond) -> emit_then_block(ctx, env, name, cond)
        _ -> err_stmt("spec_emit_stmt: unexpected statement")
    }
}

fn emit_spec_block(ctx: Ctx, env: VarEnv, name: string, body: StmtList) -> StmtResult {
    let name_val = emit_string_const(ctx, name)
    call_1(ctx, get_fn(ctx, "forge_test_start_spec"), name_val, "")
    let r = emit_spec_stmts(ctx, env, body)?
    call_1(ctx, get_fn(ctx, "forge_test_end_spec"), name_val, "")
    ok_stmt(env)
}

fn emit_given_block(ctx: Ctx, env: VarEnv, name: string, body: StmtList) -> StmtResult {
    let name_val = emit_string_const(ctx, name)
    call_1(ctx, get_fn(ctx, "forge_test_start_given"), name_val, "")
    let r = emit_spec_stmts(ctx, env, body)?
    call_1(ctx, get_fn(ctx, "forge_test_end_given"), name_val, "")
    ok_stmt(r.env)
}

fn emit_then_block(ctx: Ctx, env: VarEnv, name: string, cond: Expr) -> StmtResult {
    let r = emit_expr(ctx, env, cond)
    if r.had_error { return err_stmt(r.error_message) }
    let name_val = emit_string_const(ctx, name)
    call_2(ctx, get_fn(ctx, "forge_test_run_then"), name_val, r.value, "")
    ok_stmt(env)
}

fn emit_string_const(ctx: Ctx, s: string) -> ptr {
    let global = forge_llvm_build_global_string_ptr(ctx.builder, s, "spec_str")
    global
}

fn emit_spec_stmts(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            let r = emit_spec_single(ctx, env, ss.node)?
            emit_spec_stmts(ctx, r.env, next)
        }
    }
}

fn emit_spec_single(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .SpecBlock(name, body) -> emit_spec_block(ctx, env, name, body)
        .GivenBlock(name, body) -> emit_given_block(ctx, env, name, body)
        .ThenBlock(name, cond) -> emit_then_block(ctx, env, name, cond)
        _ -> {
            // Regular statements inside spec blocks — wrap in a StmtList
            // and emit via emit_block_loop, which handles all statement types.
            let wrapped = StmtList.Node(sstmt_dummy(stmt), StmtList.End)
            let r = emit_block_loop(ctx, env, wrapped, const_i64(ctx, 0), .Int)
            if r.had_error { return err_stmt(r.error_message) }
            ok_stmt(env)
        }
    }
}
