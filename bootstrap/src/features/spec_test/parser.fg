// WHY: parses spec test syntax:
//   spec "name" { given "setup" { then "assertion" { expr } } }

// Imports resolved by bootstrap's module-qualified name resolution.

use core.ast.{sstmt}
impl Parser {
    fn parse_spec_block(self) -> Stmt? {
        self.advance()  // consume `spec`
        if !self.check("string") {
            return null
        }
        let name = self.current_lexeme
        self.advance()
        if !self.consume("left_brace", "expected `{` after spec name") {
            return null
        }
        let body = self.parse_spec_body()
        if !self.consume("right_brace", "expected `}` to close spec block") {
            return null
        }
        Stmt.SpecBlock(name, body)
    }

    fn parse_spec_body(self) -> StmtList {
        if self.check("right_brace") || self.check("eof") {
            return StmtList.End
        }
        let line = self.current_line
        let col = self.current_column
        let stmt = if self.check("kw_given") {
            self.parse_given_block()
        } else if self.check("kw_then") {
            self.parse_then_block()
        } else {
            self.parse_declaration()
        }
        if stmt == null { return StmtList.End }
        StmtList.Node(sstmt(stmt!, line, col), self.parse_spec_body())
    }

    fn parse_given_block(self) -> Stmt? {
        self.advance()  // consume `given`
        if !self.check("string") {
            return null
        }
        let name = self.current_lexeme
        self.advance()
        if !self.consume("left_brace", "expected `{` after given name") {
            return null
        }
        let body = self.parse_spec_body()
        if !self.consume("right_brace", "expected `}` to close given block") {
            return null
        }
        Stmt.GivenBlock(name, body)
    }

    fn parse_then_block(self) -> Stmt? {
        self.advance()  // consume `then`
        if !self.check("string") {
            return null
        }
        let name = self.current_lexeme
        self.advance()
        if !self.consume("left_brace", "expected `{` after then name") {
            return null
        }
        let condition = self.parse_expression()
        if condition == null { return null }
        if !self.consume("right_brace", "expected `}` to close then block") {
            return null
        }
        Stmt.ThenBlock(name, condition!)
    }
}
