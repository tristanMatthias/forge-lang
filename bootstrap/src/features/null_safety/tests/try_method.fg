type Config = { port: int }

fn load_config(name: string) -> Config? {
    if name == "prod" {
        return Config { port: 8080 }
    }
    null
}

fn get_port(name: string) -> int? {
    let cfg = load_config(name)?
    cfg.port
}

println(string(get_port("prod") ?? 0))
println(string(get_port("dev") ?? 0))
