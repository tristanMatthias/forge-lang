mod codegen
use codegen.types.{err_emit}
use features.eval.{error_result}
use core.registry.{feature_new, register}
use resolve.{resolve_expr}
use features.null_safety.codegen.{emit_null_coalesce, emit_optional_chain, emit_try}
use features.struct_decl.typeck.{check_field_access}
use typeck.{check_expr, tc_er}

export fn init_null_safety(reg: Registry) {
    let f1 = feature_new("null_coalesce") with {
        expr_tag: Expr.NullCoalesce(Expr.Null, Expr.Null),
        emit_expr: null_coalesce_emit_expr,
        resolve_expr: (r: int, expr: Expr) -> match expr {
            .NullCoalesce(left, right) -> {
                let after_left = resolve_expr(r, left)
                resolve_expr(after_left, right)
            }
            _ -> r
        },
        check_expr: nc_check_expr,
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .NullCoalesce(_, _) -> error_result(rt, "null coalesce is not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected NullCoalesce")
        },
    }
    register(reg, f1)

    let f2 = feature_new("optional_chain") with {
        expr_tag: Expr.OptionalChain(Expr.Null, ""),
        emit_expr: optional_chain_emit_expr,
        resolve_expr: (r: int, expr: Expr) -> match expr { .OptionalChain(obj, _) -> resolve_expr(r, obj), _ -> r },
        check_expr: (tc: int, expr: Expr) -> match expr {
            .OptionalChain(obj, field) -> check_field_access(tc, obj, field)
            _ -> tc_er(tc, .Int)
        },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .OptionalChain(_, _) -> error_result(rt, "optional chain is not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected OptionalChain")
        },
    }
    register(reg, f2)

    let f3 = feature_new("try") with {
        expr_tag: Expr.Try(Expr.Null),
        emit_expr: try_emit_expr,
        resolve_expr: (r: int, expr: Expr) -> match expr { .Try(inner) -> resolve_expr(r, inner), _ -> r },
        check_expr: (tc: int, expr: Expr) -> match expr { .Try(inner) -> check_expr(tc, inner), _ -> tc_er(tc, .Int) },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .Try(_) -> error_result(rt, "try operator is not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected Try")
        },
    }
    register(reg, f3)
}

fn nc_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .NullCoalesce(left, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            tc_er(r.tc, r.ty)
        }
        _ -> tc_er(tc, .Int)
    }
}

fn null_coalesce_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .NullCoalesce(left, right) -> emit_null_coalesce(ctx, env, left, right)
        _ -> err_emit("expected NullCoalesce")
    }
}

fn optional_chain_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .OptionalChain(obj, field) -> emit_optional_chain(ctx, env, obj, field)
        _ -> err_emit("expected OptionalChain")
    }
}

fn try_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> Result<EmitValue, string> {
    match expr {
        .Try(inner) -> emit_try(ctx, env, inner)
        _ -> err_emit("expected Try")
    }
}
