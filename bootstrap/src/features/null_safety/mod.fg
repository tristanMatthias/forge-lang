mod parser
mod codegen

export fn register_null_safety(reg: Registry) -> Registry {
    mut r = register_feature(reg, expr_feature("null_coalesce", 19, nc_emit))
    r = register_feature(r, expr_feature("optional_chain", 20, oc_emit))
    register_feature(r, expr_feature("try", 21, try_emit))
}

fn nc_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .NullCoalesce(left, right) -> emit_null_coalesce(ctx, env, left, right), _ -> err_emit("expected NullCoalesce") }
}

fn oc_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .OptionalChain(obj, field) -> emit_optional_chain(ctx, env, obj, field), _ -> err_emit("expected OptionalChain") }
}

fn try_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .Try(inner) -> emit_try(ctx, env, inner), _ -> err_emit("expected Try") }
}
