// WHY: codegen for null safety operators `??`, `?.`, and `?`.
//
// `a ?? b`   → short-circuit: if a != 0 then a else b
// `a?.field` → if a == 0 then 0 else a.field
// `a?`       → two modes:
//              1. Result enum: check tag, extract Ok value or return Err
//              2. Nullable: if a == 0, return 0 from enclosing fn
//
// In the bootstrap's everything-is-i64 model, null == 0. These
// operators compile to i64 null-check or enum-tag-check branches.

use core.ast.{Expr, VarEnv, env_lookup, field_index_of, ValueType, vtype_eq, vtype_is_unknown, vtype_is_str, vtype_struct_name, vtype_enum_name}
use codegen.types.{Ctx, EmitValue, ok_emit, ok_emit_typed, err_emit, null_ptr_val}
use features.defer_stmt.codegen.{emit_defers_on_error}
use features.union_type.codegen.{emit_union_wrap, needs_union_wrap}

export fn emit_null_coalesce(ctx: Ctx, env: VarEnv, left: Expr, right: Expr) -> Result<EmitValue, string> {
    let l = ctx.emit(env, left)?

    // Short-circuit: if left != 0/null (non-null), skip right.
    let l_ptr = ctx.is_ptr_value(l.value)
    let is_null = if l_ptr {
        ctx.eq(l.value, ctx.zero_for(ValueType.Str), "nc_null")
    } else {
        ctx.eq(l.value, ctx.i64(0), "nc_null")
    }
    let then_bb = ctx.bb("nc_rhs")
    let merge_bb = ctx.bb("nc_end")
    let result_slot = ctx.alloca_i64("nc_result")
    ctx.store(ctx.to_i64(l.value, "nc_lhs"), result_slot)
    ctx.cond_br(is_null, then_bb, merge_bb)

    // Right-hand side: only evaluated when left is null.
    ctx.position(then_bb)
    let r = ctx.emit(env, right)?
    ctx.store(ctx.to_i64(r.value, "nc_rhs"), result_slot)
    ctx.br(merge_bb)

    ctx.position(merge_bb)
    let loaded = ctx.load_i64(result_slot, "nc_val")
    let merged_ty = if (vtype_is_unknown(l.ty) || vtype_eq(l.ty, .Void)) && vtype_is_str(r.ty) { ValueType.Str } else { l.ty }
    ok_emit_typed(loaded, merged_ty)
}

export fn emit_optional_chain(ctx: Ctx, env: VarEnv, obj: Expr, field: string) -> Result<EmitValue, string> {
    let r = ctx.emit(env, obj)?

    // If the object is null, produce null without accessing.
    let is_null = if ctx.is_ptr_value(r.value) {
        ctx.eq(r.value, ctx.zero_for(ValueType.Str), "oc_null")
    } else {
        ctx.eq(r.value, ctx.i64(0), "oc_null")
    }
    let access_bb = ctx.bb("oc_access")
    let merge_bb = ctx.bb("oc_end")
    let result_slot = ctx.alloca_i64("oc_result")
    ctx.store(ctx.i64(0), result_slot)
    ctx.cond_br(is_null, merge_bb, access_bb)

    // Access the field (only reached when obj is non-null).
    ctx.position(access_bb)
    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        // For non-struct types (e.g. strings), fall back to
        // returning the value itself. ?. on a non-struct is
        // effectively a null-check passthrough.
        ctx.store(r.value, result_slot)
        ctx.br(merge_bb)
        ctx.position(merge_bb)
        let loaded = ctx.load_i64(result_slot, "oc_val")
        return ok_emit_typed(loaded, r.ty)
    }
    let lookup = ctx.lookup_struct(struct_name)
    if !lookup.found {
        return err_emit("unknown struct `${struct_name}` in optional chain")
    }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 {
        return err_emit("unknown field `${field}` on struct `${struct_name}` in optional chain")
    }
    let st_ty = ctx.get_type(struct_name)
    let obj_ptr = ctx.to_ptr(r.value, "oc_ptr")
    let gep = ctx.gep(st_ty, obj_ptr, idx, "oc_fld")
    let loaded_field = ctx.load_i64(gep, field)
    ctx.store(loaded_field, result_slot)
    ctx.br(merge_bb)

    ctx.position(merge_bb)
    let final_val = ctx.load_i64(result_slot, "oc_val")
    let field_ty = ctx.resolve_field_type(lookup.fields, field)
    ok_emit_typed(final_val, field_ty)
}

export fn emit_try(ctx: Ctx, env: VarEnv, inner: Expr) -> Result<EmitValue, string> {
    // This is the compiler's implementation of the source-level `?`
    // operator, but codegen failures from the inner expression should
    // still propagate normally.
    let r = ctx.emit(env, inner)?

    // ── Mode 1: Result enum (including monomorphized Result__T__E) ──
    // Check tag: Ok → extract payload value, Err → return Result.
    let enum_name = vtype_enum_name(r.ty)
    if enum_name == "Result" || enum_name.starts_with("Result__") {
        let enum_ty = ctx.get_type(enum_name)
        let enum_ptr = ctx.to_ptr(r.value, "try_res_ptr")
        let tag_gep = ctx.gep(enum_ty, enum_ptr, 0, "try_tag_ptr")
        let tag = ctx.load_i64(tag_gep, "try_tag")
        let ok_tag = ctx.i64(forge_variant_hash("Ok"))
        let is_ok = ctx.eq(tag, ok_tag, "try_is_ok")
        let ok_bb = ctx.bb("try_ok")
        let err_bb = ctx.bb("try_err")
        ctx.cond_br(is_ok, ok_bb, err_bb)

        ctx.position(err_bb)
        emit_defers_on_error(ctx, env)
        let try_fn_ret = ctx.current_fn_ret()
        // ── Auto-widening: if inner error type is narrower than outer, wrap ──
        let outer_enum_name = vtype_enum_name(try_fn_ret)
        let ret_val = if outer_enum_name != "" && outer_enum_name != enum_name {
            // Inner and outer Result are different monomorphizations.
            // Extract error payload from inner, widen if needed, build outer Result.
            let inner_err_ty = ctx.resolve_err_type(enum_name)
            let outer_err_ty = ctx.resolve_err_type(outer_enum_name)
            if needs_union_wrap(inner_err_ty, outer_err_ty) {
                // Extract error payload from inner Result
                let err_pay_gep = ctx.gep(enum_ty, enum_ptr, 1, "try_widen_pay_slot")
                let err_pay_ptr = ctx.load(ctx.ptr_type, err_pay_gep, "try_widen_payload")
                let err_val = ctx.load_i64(err_pay_ptr, "try_err_val")
                // Wrap the concrete error in the wider union type
                let wrapped = emit_union_wrap(ctx, err_val, inner_err_ty, outer_err_ty)?
                // Build a new outer Result enum: {tag=Err, payload=wrapped_err}
                let outer_st_ty = ctx.get_type(outer_enum_name)
                let outer_buf = ctx.arena_alloc(ctx.i64(16))
                let outer_tag_gep = ctx.gep(outer_st_ty, outer_buf, 0, "try_widen_tag")
                ctx.store(ctx.i64(forge_variant_hash("Err")), outer_tag_gep)
                let outer_pay_buf = ctx.arena_alloc(ctx.i64(8))
                ctx.store_slot(outer_pay_buf, 0, wrapped.value, outer_err_ty)
                let outer_pay_gep = ctx.gep(outer_st_ty, outer_buf, 1, "try_widen_pay")
                ctx.store(outer_pay_buf, outer_pay_gep)
                ctx.to_i64(outer_buf, "try_widened_result")
            } else {
                r.value
            }
        } else {
            r.value
        }
        ctx.ret(ret_val, try_fn_ret)

        ctx.position(ok_bb)
        let pay_gep = ctx.gep(enum_ty, enum_ptr, 1, "try_pay_slot")
        let pay_ptr = ctx.load(ctx.ptr_type, pay_gep, "try_payload")
        let ok_val = ctx.load_i64(pay_ptr, "try_ok_val")
        // Resolve the Ok variant's payload type from the enum registry.
        let ok_ty = ctx.resolve_ok_type(enum_name)
        return ok_emit_typed(ok_val, ok_ty)
    }

    // ── Mode 2: Struct with `had_error` field ──
    // Check field: if true, return the struct (propagate). Otherwise
    // the expression evaluates to the struct itself.
    let struct_name = vtype_struct_name(r.ty)
    if struct_name != "" {
        let lookup = ctx.lookup_struct(struct_name)
        if lookup.found {
            let err_idx = field_index_of(lookup.fields, "had_error")
            if err_idx >= 0 {
                let st_ty = ctx.get_type(struct_name)
                let obj_ptr = ctx.to_ptr(r.value, "try_ptr")
                let gep = ctx.gep(st_ty, obj_ptr, err_idx, "try_err_ptr")
                let err_val = ctx.load_i64(gep, "try_had_error")
                // icmp ne (not-equal to 0) = truthy = had error
                let is_err = ctx.truthy(err_val, "try_is_err")
                let cont_bb = ctx.bb("try_ok")
                let ret_bb = ctx.bb("try_err")
                ctx.cond_br(is_err, ret_bb, cont_bb)

                ctx.position(ret_bb)
                emit_defers_on_error(ctx, env)
                let s_fn_ret = ctx.current_fn_ret()
                ctx.ret(r.value, s_fn_ret)

                ctx.position(cont_bb)
                return ok_emit_typed(r.value, r.ty)
            }
        }
    }

    // ── Mode 3: Nullable ──
    // If value is null/0, return null from enclosing fn.
    let is_null = if ctx.is_ptr_value(r.value) {
        ctx.eq(r.value, ctx.zero_for(ValueType.Str), "try_null")
    } else {
        ctx.eq(r.value, ctx.i64(0), "try_null")
    }
    let cont_bb = ctx.bb("try_ok")
    let ret_bb = ctx.bb("try_ret")
    ctx.cond_br(is_null, ret_bb, cont_bb)

    ctx.position(ret_bb)
    emit_defers_on_error(ctx, env)
    let fn_ret = ctx.current_fn_ret()
    ctx.ret_void(fn_ret)

    ctx.position(cont_bb)
    ok_emit_typed(r.value, r.ty)
}

export fn emit_catch(ctx: Ctx, env: VarEnv, inner: Expr, binding: string, body: Expr) -> Result<EmitValue, string> {
    let r = ctx.emit(env, inner)?

    // Result enum: check tag, Ok → extract value, Err → evaluate catch body
    let enum_name = vtype_enum_name(r.ty)
    if enum_name == "Result" || enum_name.starts_with("Result__") {
        let enum_ty = ctx.get_type(enum_name)
        let enum_ptr = ctx.to_ptr(r.value, "catch_res_ptr")
        let tag_gep = ctx.gep(enum_ty, enum_ptr, 0, "catch_tag_ptr")
        let tag = ctx.load_i64(tag_gep, "catch_tag")
        let ok_tag = ctx.i64(forge_variant_hash("Ok"))
        let is_ok = ctx.eq(tag, ok_tag, "catch_is_ok")
        let ok_bb = ctx.bb("catch_ok")
        let err_bb = ctx.bb("catch_err")
        let merge_bb = ctx.bb("catch_merge")
        let result_slot = ctx.alloca_i64("catch_result")
        ctx.cond_br(is_ok, ok_bb, err_bb)

        // Ok path: extract payload
        ctx.position(ok_bb)
        let pay_gep = ctx.gep(enum_ty, enum_ptr, 1, "catch_pay_slot")
        let pay_ptr = ctx.load(ctx.ptr_type, pay_gep, "catch_payload")
        let ok_val = ctx.load_i64(pay_ptr, "catch_ok_val")
        ctx.store(ok_val, result_slot)
        ctx.br(merge_bb)

        // Err path: evaluate catch body, optionally binding the error
        ctx.position(err_bb)
        let err_env = if binding.length > 0 {
            // Extract error payload and bind it
            let err_pay_gep = ctx.gep(enum_ty, enum_ptr, 1, "catch_err_pay_slot")
            let err_pay_ptr = ctx.load(ctx.ptr_type, err_pay_gep, "catch_err_payload")
            let err_val = ctx.load_i64(err_pay_ptr, "catch_err_val")
            ctx.bind(env, binding, err_val, .Unknown)
        } else { env }
        let catch_r = ctx.emit(err_env, body)?
        ctx.store(ctx.to_i64(catch_r.value, "catch_body_val"), result_slot)
        ctx.br_if_open(merge_bb)

        ctx.position(merge_bb)
        let merged = ctx.load_i64(result_slot, "catch_merged")
        return ok_emit_typed(merged, ctx.resolve_ok_type(enum_name))
    }

    // Nullable: if null, evaluate catch body
    let is_null = if ctx.is_ptr_value(r.value) {
        ctx.eq(r.value, ctx.zero_for(ValueType.Str), "catch_null")
    } else {
        ctx.eq(r.value, ctx.i64(0), "catch_null")
    }
    let ok_bb = ctx.bb("catch_ok")
    let null_bb = ctx.bb("catch_null_body")
    let merge_bb = ctx.bb("catch_merge")
    let result_slot = ctx.alloca_i64("catch_result")
    ctx.store(ctx.to_i64(r.value, "catch_lhs"), result_slot)
    ctx.cond_br(is_null, null_bb, ok_bb)

    ctx.position(null_bb)
    let null_env = if binding.length > 0 { ctx.bind(env, binding, ctx.i64(0), .Unknown) } else { env }
    let catch_r = ctx.emit(null_env, body)?
    ctx.store(ctx.to_i64(catch_r.value, "catch_null_val"), result_slot)
    ctx.br_if_open(merge_bb)

    ctx.position(ok_bb)
    ctx.br(merge_bb)

    ctx.position(merge_bb)
    let merged = ctx.load_i64(result_slot, "catch_merged")
    ok_emit_typed(merged, r.ty)
}
