// Test: same generic function called with different types produces
// separate monomorphized copies.
/// expect: 42
/// expect: hello
/// expect: 99

fn identity<T>(x: T) -> T {
    x
}

// Three different instantiations: identity__int, identity__string, identity__int (deduped)
let n = identity(42)
println(string(n))

let s = identity("hello")
println(s)

let m = identity(99)
println(string(m))
