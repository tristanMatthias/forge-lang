// Test: generic enum with monomorphization.
/// expect: 42
/// expect: hello

enum Option<T> {
    None,
    Some(value: T),
}

let a = Option.Some(42)
match a {
    .None -> println("none")
    .Some(v) -> println(string(v))
}

let b = Option.Some("hello")
match b {
    .None -> println("none")
    .Some(v) -> println(v)
}
