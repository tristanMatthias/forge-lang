// WHY: parses `type Foo = { ... }` and `shape Foo = { ... }` declarations
// and the supporting field grammars (declaration + literal init).

use core.ast.{Stmt, Expr, FieldList, FieldInitList, SExpr, sexpr, TypeParamList, TypeExpr, ValueType, render_type_expr, type_expr_to_vtype}
use parse.{Parser}
use core.ast.{Tk}

impl Parser {
    fn parse_type_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected type name")?
        // Optional generic parameters: type Foo<T, U> = { ... }
        let tp = if self.check(Tk.Less) {
            self.parse_type_params()
        } else {
            TypeParamList.End
        }
        if !self.consume(Tk.Equal, "expected `=` after type name") {
            return null
        }
        // Struct body: type X = { fields }
        if self.check(Tk.LeftBrace) {
            self.advance()
            let fields = self.parse_field_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after fields") {
                return null
            }
            return Stmt.TypeDecl(name, tp, fields)
        }
        // Non-brace RHS: type expressions, type operators, or aliases
        // Handles: type X = int | string, type X = Base without { f }, type X = OtherType
        if self.check(Tk.Identifier) || self.check(Tk.KwFn) || self.check(Tk.LeftBracket) {
            let te = self.parse_type_expr("expected type after `=`")
            if te != null {
                let type_expr = te!
                // Union type alias: type X = int | string
                // Match on the TypeExpr structure, not string content
                match type_expr {
                    .Union(_, _) -> {
                        return Stmt.UnionAliasDecl(name, render_type_expr(type_expr))
                    }
                    _ -> {}
                }
                let rendered = render_type_expr(type_expr)
                // Type operators: type X = Base without { fields }
                if self.check(Tk.Identifier) {
                    let op = self.current_lexeme
                    if op in ["without", "only"] {
                        self.advance()
                        if !self.consume(Tk.LeftBrace, "expected `{` after type operator") { return null }
                        let op_fields = self.parse_ident_list()
                        if !self.consume(Tk.RightBrace, "expected `}` after type operator fields") { return null }
                        let derived = FieldList.Node("__base", rendered, ValueType.Unknown, FieldList.Node("__op", op, ValueType.Unknown, op_fields))
                        return Stmt.TypeDecl(name, tp, derived)
                    }
                }
                // Newtype wrapper: type UserId = string — nominal distinction
                return Stmt.NewtypeDecl(name, rendered, type_expr_to_vtype(type_expr))
            }
        }
        Stmt.TypeDecl(name, tp, FieldList.End)
    }

    // shape Name = { field: Type, ... }
    // Structural type — all fields public, width subtyping (spec Axis 3.1-3.7).
    fn parse_shape_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected shape name")?
        if !self.consume(Tk.Equal, "expected `=` after shape name") {
            return null
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after `=` in shape declaration") {
            return null
        }
        let fields = self.parse_field_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after shape fields") {
            return null
        }
        Stmt.ShapeDecl(name, fields)
    }

    // Parse a list of identifiers separated by commas: {a, b, c}
    fn parse_ident_list(self) -> FieldList {
        if self.check(Tk.RightBrace) { return FieldList.End }
        if !self.check(Tk.Identifier) { return FieldList.End }
        let id = self.current_lexeme
        self.advance()
        if self.check(Tk.Comma) { self.advance() }
        FieldList.Node(id, "", ValueType.Unknown, self.parse_ident_list())
    }

    fn parse_field_list(self) -> FieldList? {
        if self.check(Tk.RightBrace) {
            return FieldList.End
        }
        // Optional `mut` modifier — ignored for now.
        if self.check(Tk.KwMut) {
            self.advance()
        }
        let name = self.consume_identifier("expected field name")?
        if !self.consume(Tk.Colon, "expected `:` after field name") {
            return null
        }
        let te = self.parse_type_expr("expected field type")?
        let ty = render_type_expr(te)
        let resolved = type_expr_to_vtype(te)
        if self.check(Tk.Comma) {
            self.advance()
            let rest = self.parse_field_list()?
            return FieldList.Node(name, ty, resolved, rest)
        }
        FieldList.Node(name, ty, resolved, FieldList.End)
    }

    fn parse_field_init_list(self) -> FieldInitList? {
        if self.check(Tk.RightBrace) {
            return FieldInitList.End
        }
        let name = self.consume_identifier("expected field name")?
        // Shorthand: `Foo { name }` is sugar for `Foo { name: name }`.
        // If the next token is `,` or `}`, the field value is just
        // the variable with the same name.
        let value = if self.check(Tk.Colon) {
            self.advance()
            let v = self.parse_expression()?
            v
        } else {
            Expr.Ident(name)
        }
        if self.check(Tk.Comma) {
            self.advance()
            let rest = self.parse_field_init_list()?
            return FieldInitList.Node(name, sexpr(value, self.current_line, self.current_column), rest)
        }
        FieldInitList.Node(name, sexpr(value, self.current_line, self.current_column), FieldInitList.End)
    }
}
