// WHY: parses `type Foo = { ... }` declarations and the
// supporting field grammars (declaration + literal init).

use core.ast.{Stmt, Expr, FieldList, FieldInitList, SExpr, sexpr}
use parse.{Parser}

impl Parser {
    fn parse_type_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected type name")?
        // Optional generic parameters: type Foo<T, U> = { ... }
        // Erased in the bootstrap — everything is i64.
        if self.check("less") {
            self.skip_angle_brackets()
        }
        if !self.consume("equal", "expected `=` after type name") {
            return null
        }
        // Type operators: Type without {fields} / Type only {fields} / partial Type
        if self.check("identifier") && self.current_lexeme != "table" {
            let base = self.current_lexeme
            self.advance()
            if self.check("identifier") {
                let op = self.current_lexeme
                if op == "without" || op == "only" {
                    self.advance()
                    if !self.consume("left_brace", "expected `{` after type operator") { return null }
                    let op_fields = self.parse_ident_list()
                    if !self.consume("right_brace", "expected `}` after type operator fields") { return null }
                    // Encode derivation: __base=Base, __op=without, then excluded field names
                    let derived = FieldList.Node("__base", base, FieldList.Node("__op", op, op_fields))
                    return Stmt.TypeDecl(name, derived)
                }
            }
            // Not a type operator — could be `type X = BaseType` (alias)
            // For now, emit as TypeDecl with empty fields
            return Stmt.TypeDecl(name, FieldList.End)
        }
        if self.check("left_brace") {
            self.advance()
            let fields = self.parse_field_list()?
            if !self.consume("right_brace", "expected `}` after fields") {
                return null
            }
            return Stmt.TypeDecl(name, fields)
        }
        Stmt.TypeDecl(name, FieldList.End)
    }

    // Parse a list of identifiers separated by commas: {a, b, c}
    fn parse_ident_list(self) -> FieldList {
        if self.check("right_brace") { return FieldList.End }
        if !self.check("identifier") { return FieldList.End }
        let id = self.current_lexeme
        self.advance()
        if self.check("comma") { self.advance() }
        FieldList.Node(id, "", self.parse_ident_list())
    }

    fn parse_field_list(self) -> FieldList? {
        if self.check("right_brace") {
            return FieldList.End
        }
        // Optional `mut` modifier — ignored for now.
        if self.check("kw_mut") {
            self.advance()
        }
        let name = self.consume_identifier("expected field name")?
        if !self.consume("colon", "expected `:` after field name") {
            return null
        }
        let ty = self.consume_type("expected field type")?
        if self.check("comma") {
            self.advance()
            let rest = self.parse_field_list()?
            return FieldList.Node(name, ty, rest)
        }
        FieldList.Node(name, ty, FieldList.End)
    }

    fn parse_field_init_list(self) -> FieldInitList? {
        if self.check("right_brace") {
            return FieldInitList.End
        }
        let name = self.consume_identifier("expected field name")?
        // Shorthand: `Foo { name }` is sugar for `Foo { name: name }`.
        // If the next token is `,` or `}`, the field value is just
        // the variable with the same name.
        let value = if self.check("colon") {
            self.advance()
            let v = self.parse_expression()?
            v
        } else {
            Expr.Ident(name)
        }
        if self.check("comma") {
            self.advance()
            let rest = self.parse_field_init_list()?
            return FieldInitList.Node(name, sexpr(value, self.current_line, self.current_column), rest)
        }
        FieldInitList.Node(name, sexpr(value, self.current_line, self.current_column), FieldInitList.End)
    }
}
