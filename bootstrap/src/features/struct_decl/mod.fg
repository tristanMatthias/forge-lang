mod parser
mod codegen

export fn init_struct_decl(reg: Registry) {
    let f1 = feature_new("struct_lit") with {
        expr_tag: Expr.StructLit("", FieldInitList.End),
        emit_expr: struct_lit_emit,
    }
    register(reg, f1)

    let f2 = feature_new("field_access") with {
        expr_tag: Expr.FieldAccess(Expr.Null, ""),
        emit_expr: field_access_emit,
    }
    register(reg, f2)

    let f3 = feature_new("enum_ctor") with {
        expr_tag: Expr.EnumCtor("", "", ExprList.End),
        emit_expr: enum_ctor_emit,
    }
    register(reg, f3)

    let f4 = feature_new("field_assign") with {
        expr_tag: Expr.FieldAssign(Expr.Null, "", Expr.Null),
        emit_expr: field_assign_emit,
    }
    register(reg, f4)
}

fn struct_lit_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .StructLit(name, inits) -> emit_struct_lit(ctx, env, name, inits), _ -> err_emit("expected StructLit") }
}

fn field_access_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .FieldAccess(obj, field) -> emit_field_access(ctx, env, obj, field), _ -> err_emit("expected FieldAccess") }
}

fn enum_ctor_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .EnumCtor(tn, v, args) -> emit_enum_ctor(ctx, env, tn, v, args), _ -> err_emit("expected EnumCtor") }
}

fn field_assign_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .FieldAssign(obj, field, value) -> emit_field_assign(ctx, env, obj, field, value), _ -> err_emit("expected FieldAssign") }
}
