// WHY: emits struct literal construction and field-filling.

use core.ast.{Expr, ExprList, FieldList, FieldInitList, VarEnv, field_index_of, field_type_of, field_list_length, ValueType, vtype_struct_name, vtype_display, vtype_is_str, vtype_is_list, vtype_is_map, SExpr}
use codegen.types.{Ctx, EmitResult, ok_emit, err_emit, null_ptr_val, struct_reg_lookup, enum_reg_lookup, translate_param_type, const_i64, to_ptr, to_i64, get_fn, call_1, cg_malloc}
use codegen.{emit_expr, emit_enum_ctor}
use features.enum_decl.codegen.{emit_enum_ctor}


export fn emit_struct_lit(ctx: Ctx, env: VarEnv, name: string, inits: FieldInitList) -> EmitResult {
    let lookup = struct_reg_lookup(ctx.structs, name)
    if !lookup.found {
        return err_emit("undefined struct type `${name}`")
    }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, name)
    if st_ty == null {
        return err_emit("LLVM struct type `${name}` not declared")
    }
    let buf = malloc_struct_bytes(ctx, lookup.fields)
    let fill = fill_struct_fields(ctx, env, st_ty, buf, inits, lookup.fields)
    if fill.had_error { return fill }
    let as_i64 = to_i64(ctx, buf, "struct_i64")
    EmitResult { value: as_i64, ty: ValueType.Struct(name), had_error: false, error_message: "" }
}

fn malloc_struct_bytes(ctx: Ctx, fields: FieldList) -> ptr {
    let count = field_list_length(fields)
    cg_malloc(ctx, const_i64(ctx, count * 8))
}

fn fill_struct_fields(ctx: Ctx, env: VarEnv, st_ty: ptr, alloca: ptr, inits: FieldInitList, fields: FieldList) -> EmitResult {
    match inits {
        .End -> ok_emit(null_ptr_val())
        .Node(field_name, sv, next) -> {
            let idx = field_index_of(fields, field_name)
            if idx < 0 { return err_emit("unknown field `${field_name}`") }
            let r = emit_expr(ctx, env, sv.node)
            if r.had_error { return r }
            let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, alloca, idx, "fld_ptr")
            forge_llvm_build_store(ctx.builder, r.value, gep)
            fill_struct_fields(ctx, env, st_ty, alloca, next, fields)
        }
    }
}

export fn emit_field_assign(ctx: Ctx, env: VarEnv, obj: Expr, field: string, value: Expr) -> EmitResult {
    let r = emit_expr(ctx, env, obj)
    if r.had_error { return r }
    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        return err_emit("field assignment on non-struct value (ty=${vtype_display(r.ty)})")
    }
    let lookup = struct_reg_lookup(ctx.structs, struct_name)
    if !lookup.found { return err_emit("unknown struct `${struct_name}`") }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 { return err_emit("unknown field `${field}` on struct `${struct_name}`") }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, struct_name)
    let obj_ptr = to_ptr(ctx, r.value, "fa_ptr")
    let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, obj_ptr, idx, "fa_fld")
    let v = emit_expr(ctx, env, value)
    if v.had_error { return v }
    forge_llvm_build_store(ctx.builder, v.value, gep)
    ok_emit(v.value)
}

export fn emit_field_access(ctx: Ctx, env: VarEnv, obj: Expr, field: string) -> EmitResult {
    // Bare `EnumName.Variant` (zero-arg enum constructor)
    match obj {
        .Ident(head) -> {
            let enum_l = enum_reg_lookup(ctx.enums, head)
            if enum_l.found {
                return emit_enum_ctor(ctx, env, head, field, ExprList.End)
            }
        }
        _ -> {}
    }

    let r = emit_expr(ctx, env, obj)
    if r.had_error { return r }

    // String/List/Map .length
    if vtype_is_str(r.ty) && field == "length" {
        let str_ptr = to_ptr(ctx, r.value, "len_arg")
        return ok_emit(call_1(ctx, get_fn(ctx, "strlen"), str_ptr, "strlen_call"))
    }
    if vtype_is_list(r.ty) && field == "length" {
        return ok_emit(call_1(ctx, get_fn(ctx, "forge_array_len"), r.value, "list_len"))
    }
    if vtype_is_map(r.ty) && field == "length" {
        return ok_emit(call_1(ctx, get_fn(ctx, "forge_map_len_cstr"), r.value, "map_len"))
    }

    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        return err_emit("field access on non-struct value (ty=${vtype_display(r.ty)}, field=${field})")
    }
    let lookup = struct_reg_lookup(ctx.structs, struct_name)
    if !lookup.found { return err_emit("unknown struct `${struct_name}`") }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 { return err_emit("unknown field `${field}` on struct `${struct_name}`") }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, struct_name)
    let obj_ptr = to_ptr(ctx, r.value, "obj_ptr")

    // Null deref check
    let zero = const_i64(ctx, 0)
    let is_null_i1 = forge_llvm_build_icmp(ctx.builder, 32, r.value, zero, "null_fld_chk")
    let is_null = forge_llvm_build_zext(ctx.builder, is_null_i1, ctx.i64_type, "null_fld_ext")
    let fld_str = forge_llvm_build_global_string_ptr(ctx.builder, field, "fld_name")
    let fld_len = const_i64(ctx, field.length)
    let ty_str = forge_llvm_build_global_string_ptr(ctx.builder, struct_name, "sty_name")
    let ty_len = const_i64(ctx, struct_name.length)
    let file_str = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "src_file")
    let file_len = const_i64(ctx, ctx.source_file.length)
    let src_line = const_i64(ctx, ctx.source_line)
    let trap_fn = get_fn(ctx, "forge_null_deref_trap")
    let trap_ft = forge_llvm_fn_type_of(trap_fn)
    let trap_args = forge_llvm_value_array_new(8)
    forge_llvm_value_array_set(trap_args, 0, fld_str)
    forge_llvm_value_array_set(trap_args, 1, fld_len)
    forge_llvm_value_array_set(trap_args, 2, ty_str)
    forge_llvm_value_array_set(trap_args, 3, ty_len)
    forge_llvm_value_array_set(trap_args, 4, is_null)
    forge_llvm_value_array_set(trap_args, 5, file_str)
    forge_llvm_value_array_set(trap_args, 6, file_len)
    forge_llvm_value_array_set(trap_args, 7, src_line)
    forge_llvm_build_call(ctx.builder, trap_ft, trap_fn, trap_args, 8, "")
    forge_llvm_value_array_free(trap_args)

    let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, obj_ptr, idx, "fld_ptr")
    let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, gep, field)
    let field_ty = translate_param_type(ctx.structs, ctx.enums, field_type_of(lookup.fields, field))
    EmitResult { value: loaded, ty: field_ty, had_error: false, error_message: "" }
}
