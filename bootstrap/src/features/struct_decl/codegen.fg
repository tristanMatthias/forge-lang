// WHY: emits struct literal construction and field-filling.

use core.ast.{Expr, ExprList, FieldList, FieldInitList, VarEnv, field_index_of, field_list_length, ValueType, vtype_struct_name, vtype_display, vtype_is_str, vtype_is_list, vtype_is_map, SExpr}
use codegen.types.{Ctx, EmitValue, ok_emit, ok_emit_typed, err_emit, null_ptr_val}
use codegen.{emit_expr, emit_enum_ctor}
use features.enum_decl.codegen.{emit_enum_ctor}
use features.union_type.codegen.{emit_union_wrap, needs_union_wrap}

export fn emit_struct_lit(ctx: Ctx, env: VarEnv, name: string, inits: FieldInitList) -> Result<EmitValue, string> {
    let lookup = ctx.lookup_struct(name)
    if !lookup.found {
        return err_emit("undefined struct type `${name}`")
    }
    let st_ty = ctx.get_type(name)
    if st_ty == null {
        return err_emit("LLVM struct type `${name}` not declared")
    }
    let buf = malloc_struct_bytes(ctx, name, lookup.fields)
    let fill = fill_struct_fields(ctx, env, st_ty, buf, inits, lookup.fields)?
    let as_i64 = ctx.to_i64(buf, "struct_i64")
    ok_emit_typed(as_i64, .Struct(name))
}

fn malloc_struct_bytes(ctx: Ctx, name: string, fields: FieldList) -> ptr {
    // Copy-type stack allocation (spec 9.12): if a pre-allocated stack
    // target exists (set by emit_var_decl), write directly into it.
    if ctx.copy_alloc_target != null {
        return ctx.copy_alloc_target
    }
    let count = field_list_length(fields)
    ctx.arena_alloc(ctx.i64(count * 8))
}

fn fill_struct_fields(ctx: Ctx, env: VarEnv, st_ty: ptr, alloca: ptr, inits: FieldInitList, fields: FieldList) -> Result<EmitValue, string> {
    match inits {
        .End -> ok_emit(null_ptr_val())
        .Node(field_name, sv, next) -> {
            let idx = field_index_of(fields, field_name)
            if idx < 0 { return err_emit("unknown field `${field_name}`") }
            let r = ctx.emit(env, sv.node)?
            let fld_ty = ctx.resolve_field_type(fields, field_name)
            let gep = ctx.gep(st_ty, alloca, idx, "fld_ptr")
            // Union wrapping: if field type is union and value is a concrete member
            if needs_union_wrap(r.ty, fld_ty) {
                let wrapped = emit_union_wrap(ctx, r.value, r.ty, fld_ty)?
                ctx.store_field(wrapped.value, gep, fld_ty)
            } else {
                ctx.store_field(r.value, gep, fld_ty)
            }
            fill_struct_fields(ctx, env, st_ty, alloca, next, fields)
        }
    }
}

export fn emit_field_assign(ctx: Ctx, env: VarEnv, obj: Expr, field: string, value: Expr) -> Result<EmitValue, string> {
    let r = ctx.emit(env, obj)?
    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        return err_emit("field assignment on non-struct value (ty=${vtype_display(r.ty)})")
    }
    let lookup = ctx.lookup_struct(struct_name)
    if !lookup.found { return err_emit("unknown struct `${struct_name}`") }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 { return err_emit("unknown field `${field}` on struct `${struct_name}`") }
    let st_ty = ctx.get_type(struct_name)
    let obj_ptr = ctx.to_ptr(r.value, "fa_ptr")
    let gep = ctx.gep(st_ty, obj_ptr, idx, "fa_fld")
    let v = ctx.emit(env, value)?
    let fld_ty = ctx.resolve_field_type(lookup.fields, field)
    if needs_union_wrap(v.ty, fld_ty) {
        let wrapped = emit_union_wrap(ctx, v.value, v.ty, fld_ty)?
        ctx.store_field(wrapped.value, gep, fld_ty)
        ok_emit(wrapped.value)
    } else {
        ctx.store_field(v.value, gep, fld_ty)
        ok_emit(v.value)
    }
}

export fn emit_field_access(ctx: Ctx, env: VarEnv, obj: Expr, field: string) -> Result<EmitValue, string> {
    // Bare `EnumName.Variant` (zero-arg enum constructor)
    match obj {
        .Ident(head) -> {
            let enum_l = ctx.lookup_enum(head)
            if enum_l.found {
                return emit_enum_ctor(ctx, env, head, field, ExprList.End)
            }
        }
        _ -> {}
    }

    let r = ctx.emit(env, obj)?

    // String/List/Map .length
    if vtype_is_str(r.ty) && field == "length" {
        let str_ptr = ctx.to_ptr(r.value, "len_arg")
        return ok_emit(ctx.call("strlen", [str_ptr]))
    }
    if vtype_is_list(r.ty) && field == "length" {
        return ok_emit(ctx.array_len(r.value))
    }
    if vtype_is_map(r.ty) && field == "length" {
        return ok_emit(ctx.call("forge_map_len_cstr", [r.value]))
    }

    let struct_name = vtype_struct_name(r.ty)
    if struct_name == "" {
        return err_emit("field access on non-struct value (ty=${vtype_display(r.ty)}, field=${field}, line=${string(ctx.source_line)})")
    }
    let lookup = ctx.lookup_struct(struct_name)
    if !lookup.found { return err_emit("unknown struct `${struct_name}`") }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 { return err_emit("unknown field `${field}` on struct `${struct_name}`") }
    let st_ty = ctx.get_type(struct_name)
    let obj_ptr = ctx.to_ptr(r.value, "obj_ptr")

    ctx.null_check(r.value, field, struct_name)

    let field_ty = ctx.resolve_field_type(lookup.fields, field)
    let loaded = ctx.field_typed(r.value, struct_name, idx, field_ty, field)
    ok_emit_typed(loaded, field_ty)
}
