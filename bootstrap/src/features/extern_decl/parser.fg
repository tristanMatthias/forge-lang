// WHY: parses `extern fn name(params) -> Type` declarations.

use core.ast.{Stmt, ValueType, render_type_expr, type_expr_to_vtype}
use parse.{Parser}
use core.ast.{Tk}

impl Parser {
    fn parse_extern_declaration(self) -> Stmt? {
        self.advance()
        if !self.consume(Tk.KwFn, "expected `fn` after `extern`") {
            return null
        }
        let name = self.consume_identifier("expected extern fn name")?
        if !self.consume(Tk.LeftParen, "expected `(` after extern fn name") {
            return null
        }
        let params = self.parse_param_list()?
        if !self.consume(Tk.RightParen, "expected `)` after parameters") {
            return null
        }
        mut ret_ty = ""
        mut ret_vt = ValueType.Void
        if self.check(Tk.Arrow) {
            self.advance()
            let te = self.parse_type_expr("expected return type after `->`")?
            ret_ty = render_type_expr(te)
            ret_vt = type_expr_to_vtype(te)
        }
        Stmt.ExternFn(name, params, ret_ty, ret_vt)
    }
}
