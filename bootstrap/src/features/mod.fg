// WHY: aggregator for all language features. Each subdirectory is
// one feature with its own parser.fg, codegen.fg, example.fg.
//
// Features whose name collides with a reserved keyword (return, if,
// while, let, mut, fn, struct, enum, impl, extern, break, continue)
// use a `_stmt` or `_decl` suffix in the directory name.

mod match_expr
mod return_stmt
mod if_stmt
mod while_stmt
mod for_stmt
mod extern_decl
mod let_stmt
mod fn_decl
mod struct_decl
mod enum_decl
mod impl_decl
mod generics
mod null_safety
mod trait_decl
mod tuples
mod with_expr
mod list_lit
mod closures
mod map_lit
mod defer_stmt
mod is_keyword
mod in_operator
mod spec_test
mod select_stmt
mod parallel_stmt
mod modules
mod eval
use features.closures.{init_closures}
use features.defer_stmt.{init_defer_stmt}
use features.enum_decl.{init_enum_decl}
use features.extern_decl.{init_extern_decl}
use features.fn_decl.{init_fn_decl}
use features.for_stmt.{init_for_stmt}
use features.if_stmt.{init_if_stmt}
use features.impl_decl.{init_impl_decl}
use features.is_keyword.{init_is_keyword}
use features.in_operator.{init_in_operator}
use features.let_stmt.{init_let_stmt}
use features.list_lit.{init_list_lit}
use features.map_lit.{init_map_lit}
use features.match_expr.{init_match_expr}
use features.modules.{init_modules}
use features.null_safety.{init_null_safety}
use features.parallel_stmt.{init_parallel_stmt}
use features.return_stmt.{init_return_stmt}
use features.select_stmt.{init_select_stmt}
use features.spec_test.{init_spec_test}
use features.struct_decl.{init_struct_decl}
use features.trait_decl.{init_trait_decl}
use features.tuples.{init_tuples}
use features.while_stmt.{init_while_stmt}
use features.with_expr.{init_with_expr}

export fn init_features(reg: Registry) {
    init_if_stmt(reg)
    init_match_expr(reg)
    init_struct_decl(reg)
    init_null_safety(reg)
    init_tuples(reg)
    init_with_expr(reg)
    init_list_lit(reg)
    init_closures(reg)
    init_map_lit(reg)
    init_is_keyword(reg)
    init_in_operator(reg)
    init_while_stmt(reg)
    init_for_stmt(reg)
    init_let_stmt(reg)
    init_defer_stmt(reg)
    init_spec_test(reg)
    init_select_stmt(reg)
    init_parallel_stmt(reg)
    init_fn_decl(reg)
    init_enum_decl(reg)
    init_impl_decl(reg)
    init_extern_decl(reg)
    init_trait_decl(reg)
    init_return_stmt(reg)
    init_modules(reg)
}
