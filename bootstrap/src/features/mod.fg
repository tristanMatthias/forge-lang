// WHY: aggregator for all language features. Each subdirectory is
// one feature with its own parser.fg, codegen.fg, example.fg.
//
// Features whose name collides with a reserved keyword (return, if,
// while, let, mut, fn, struct, enum, impl, extern, break, continue)
// use a `_stmt` or `_decl` suffix in the directory name.

mod match
mod return_stmt
mod if_stmt
mod while_stmt
mod for_stmt
mod extern_decl
mod let_stmt
mod fn_decl
mod struct_decl
mod enum_decl
mod impl_decl
mod generics
mod null_safety
mod trait_decl
mod tuples
mod with_expr
mod list_lit
mod closures
mod map_lit
mod defer_stmt
mod is_keyword
mod spec_test
mod select_stmt
