mod codegen
use core.ast.{vtype_tuple_at}
use codegen.types.{err_emit}
use features.eval.{error_result}
use core.registry.{feature_new, register}
use resolve.{resolve_expr, resolve_expr_list}
use features.tuples.codegen.{emit_tuple, emit_tuple_index}
use typeck.{check_expr, check_expr_list_types, tc_er}

export fn init_tuples(reg: Registry) {
    let f1 = feature_new("tuple") with {
        expr_tag: Expr.Tuple(ExprList.End),
        emit_expr: (ctx: int, env, expr: Expr) -> match expr { .Tuple(elements) -> emit_tuple(ctx, env, elements), _ -> err_emit("expected Tuple") },
        resolve_expr: (r: int, expr: Expr) -> match expr { .Tuple(elements) -> resolve_expr_list(r, elements), _ -> r },
        check_expr: (tc: int, expr: Expr) -> match expr {
            .Tuple(elements) -> {
                let pair = check_expr_list_types(tc, elements)
                tc_er(pair.tc, .Tuple(pair.types))
            }
            _ -> tc_er(tc, .Int)
        },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .Tuple(_) -> error_result(rt, "tuples are not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected Tuple")
        },
    }
    register(reg, f1)

    let f2 = feature_new("tuple_index") with {
        expr_tag: Expr.TupleIndex(Expr.Null, 0),
        emit_expr: (ctx: int, env, expr: Expr) -> match expr { .TupleIndex(obj, idx) -> emit_tuple_index(ctx, env, obj, idx), _ -> err_emit("expected TupleIndex") },
        resolve_expr: (r: int, expr: Expr) -> match expr { .TupleIndex(obj, _) -> resolve_expr(r, obj), _ -> r },
        check_expr: (tc: int, expr: Expr) -> match expr {
            .TupleIndex(obj, idx) -> {
                let o = check_expr(tc, obj)
                tc_er(o.tc, vtype_tuple_at(o.ty, idx))
            }
            _ -> tc_er(tc, .Int)
        },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .TupleIndex(_, _) -> error_result(rt, "tuple indexing is not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected TupleIndex")
        },
    }
    register(reg, f2)
}
