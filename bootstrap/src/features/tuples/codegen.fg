// WHY: codegen for tuple literals, tuple indexing, and let-destructuring.
//
// In the bootstrap's i64 model, a tuple (a, b, c) is a heap-allocated
// buffer of i64 values. Tuple index t.0 loads from offset 0*8, etc.
// Destructuring `let (x, y) = expr` loads each element into a local.
//
// Type tracking: tuple EmitResult carries a ValueType.Tuple(TypeList)
// so that tuple indexing can return the correct element type
// (critical for match on enum tuple elements).

use core.ast.{Expr, ExprList, ParamList, VarEnv, env_extend, expr_list_length, ValueType, TypeList, vtype_tuple_at}
use core.cg.{Ctx, EmitResult, StmtResult, ok_emit, err_emit, ok_stmt, err_stmt_from_expr, const_i64, to_ptr, to_i64, cg_malloc}
use codegen.{emit_expr}

// ── Pointer arithmetic helpers ──

fn tuple_load(ctx: Ctx, base: ptr, idx: int, name: string) -> ptr {
    let base_int = forge_llvm_build_ptr_to_int(ctx.builder, base, ctx.i64_type, "tup_base")
    let offset = const_i64(ctx, idx * 8)
    let addr = forge_llvm_build_add(ctx.builder, base_int, offset, "tup_addr")
    let slot_ptr = forge_llvm_build_int_to_ptr(ctx.builder, addr, ctx.ptr_type, "tup_slot")
    forge_llvm_build_load(ctx.builder, ctx.i64_type, slot_ptr, name)
}

fn tuple_store(ctx: Ctx, base: ptr, idx: int, value: ptr) {
    let base_int = forge_llvm_build_ptr_to_int(ctx.builder, base, ctx.i64_type, "ts_base")
    let offset = const_i64(ctx, idx * 8)
    let addr = forge_llvm_build_add(ctx.builder, base_int, offset, "ts_addr")
    let slot_ptr = forge_llvm_build_int_to_ptr(ctx.builder, addr, ctx.ptr_type, "ts_slot")
    forge_llvm_build_store(ctx.builder, value, slot_ptr)
}

// ── Emit functions ──

export fn emit_tuple(ctx: Ctx, env: VarEnv, elements: ExprList) -> EmitResult {
    let count = expr_list_length(elements)
    let buf = cg_malloc(ctx, const_i64(ctx, count * 8))
    store_tuple_elements(ctx, env, elements, buf, 0, TypeList.End)
}

fn store_tuple_elements(ctx: Ctx, env: VarEnv, elements: ExprList, buf: ptr, idx: int, types_acc: TypeList) -> EmitResult {
    match elements {
        .End -> {
            let ty = ValueType.Tuple(reverse_type_list(types_acc, TypeList.End))
            EmitResult { value: to_i64(ctx, buf, "tuple_i64"), ty, had_error: false, error_message: "" }
        }
        .Node(expr, next) -> {
            let r = emit_expr(ctx, env, expr)
            if r.had_error { return r }
            tuple_store(ctx, buf, idx, r.value)
            let new_types = TypeList.Node(r.ty, types_acc)
            store_tuple_elements(ctx, env, next, buf, idx + 1, new_types)
        }
    }
}

fn reverse_type_list(list: TypeList, acc: TypeList) -> TypeList {
    match list {
        .End -> acc
        .Node(ty, next) -> reverse_type_list(next, TypeList.Node(ty, acc))
    }
}

export fn emit_tuple_index(ctx: Ctx, env: VarEnv, obj: Expr, idx: int) -> EmitResult {
    let r = emit_expr(ctx, env, obj)
    if r.had_error { return r }
    let ptr = to_ptr(ctx, r.value, "tup_ptr")
    let loaded = tuple_load(ctx, ptr, idx, "tup_val")
    let elem_ty = vtype_tuple_at(r.ty, idx)
    EmitResult { value: loaded, ty: elem_ty, had_error: false, error_message: "" }
}

export fn emit_let_destructure(ctx: Ctx, env: VarEnv, names: ParamList, initializer: Expr) -> StmtResult {
    let r = emit_expr(ctx, env, initializer)
    if r.had_error { return err_stmt_from_expr(r) }
    let ptr = to_ptr(ctx, r.value, "destruct_ptr")
    destructure_names(ctx, env, names, ptr, r.ty, 0)
}

fn destructure_names(ctx: Ctx, env: VarEnv, names: ParamList, base: ptr, tuple_ty: ValueType, idx: int) -> StmtResult {
    match names {
        .End -> ok_stmt(env)
        .Node(name, _, next) -> {
            let loaded = tuple_load(ctx, base, idx, name)
            let alloca = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, name)
            forge_llvm_build_store(ctx.builder, loaded, alloca)
            let elem_ty = vtype_tuple_at(tuple_ty, idx)
            let new_env = env_extend(env, name, alloca, elem_ty)
            destructure_names(ctx, new_env, next, base, tuple_ty, idx + 1)
        }
    }
}
