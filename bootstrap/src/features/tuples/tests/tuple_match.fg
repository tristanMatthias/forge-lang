enum Result {
    Ok(value: int),
    Err(code: int),
}

fn divide(a: int, b: int) -> Result {
    if b == 0 { return Result.Err(0) }
    Result.Ok(a / b)
}

// Tuple of enums — indexing should preserve enum type
let results = (divide(10, 2), divide(10, 0))

match results.0 {
    .Ok(v) -> v |> string |> println
    .Err(_) -> println("error")
}
match results.1 {
    .Ok(v) -> v |> string |> println
    .Err(_) -> println("div by zero")
}

// Destructure should also preserve types
let (r1, r2) = (divide(20, 4), divide(20, 0))
match r1 {
    .Ok(v) -> v |> string |> println
    .Err(_) -> println("error")
}
match r2 {
    .Ok(v) -> v |> string |> println
    .Err(_) -> println("div by zero")
}
