// Tuple literal and indexing
let pair = (10, 20)
println(string(pair.0))
println(string(pair.1))

// 3-element tuple
let triple = (1, 2, 3)
println(string(triple.0 + triple.1 + triple.2))

// Destructuring
let (x, y) = (100, 200)
println(string(x))
println(string(y))

// Tuple of mixed types
let mixed = (42, "hello")
println(string(mixed.0))
println(mixed.1)
