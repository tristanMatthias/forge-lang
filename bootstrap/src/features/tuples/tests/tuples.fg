// Tuple literal and indexing
let pair = (10, 20)
pair.0 |> string |> println
pair.1 |> string |> println

// 3-element tuple
let triple = (1, 2, 3)
println(string(triple.0 + triple.1 + triple.2))

// Destructuring
let (x, y) = (100, 200)
x |> string |> println
y |> string |> println

// Tuple of mixed types
let mixed = (42, "hello")
mixed.0 |> string |> println
println(mixed.1)
