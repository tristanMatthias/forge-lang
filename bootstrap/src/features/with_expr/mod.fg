mod codegen

export fn init_with_expr(reg: Registry) {
    let f = feature_new("with") with {
        expr_tag: Expr.With(Expr.Null, FieldInitList.End),
        emit_expr: with_emit,
    }
    register(reg, f)
}

fn with_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .With(obj, overrides) -> emit_with(ctx, env, obj, overrides), _ -> err_emit("expected With") }
}
