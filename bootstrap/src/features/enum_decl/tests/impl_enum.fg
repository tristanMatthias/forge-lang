// Impl block for an enum type
enum Shape {
    Circle(radius: int),
    Rect(w: int, h: int),
}

impl Shape {
    fn area(self) -> int {
        match self {
            .Circle(r) -> r * r * 3
            .Rect(w, h) -> w * h
        }
    }

    fn describe(self) -> string {
        match self {
            .Circle(r) -> `circle r=${string(r)}`
            .Rect(w, h) -> `rect ${string(w)}x${string(h)}`
        }
    }
}

let c = Shape.Circle(5)
let r = Shape.Rect(4, 6)

println(string(c.area()))
println(c.describe())
println(string(r.area()))
println(r.describe())
