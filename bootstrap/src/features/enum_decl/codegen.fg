// WHY: emits enum constructors (heap-allocated tagged unions).

use core.ast.{Expr, ExprList, VariantList, VarEnv, variant_lookup, variant_max_payload}
use core.cg.{Ctx, EmitResult, ok_emit, err_emit, null_ptr_val, enum_reg_lookup}
use codegen.{emit_expr}


export fn emit_enum_ctor(ctx: Ctx, env: VarEnv, type_name: string, variant: string, args: ExprList) -> EmitResult {
    let enum_l = enum_reg_lookup(ctx.enums, type_name)
    if !enum_l.found {
        return err_emit("undefined enum type `" + type_name + "`")
    }
    let v = variant_lookup(enum_l.variants, variant)
    if !v.found {
        return err_emit("enum `" + type_name + "` has no variant `" + variant + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, type_name)
    if st_ty == null {
        return err_emit("LLVM enum type `" + type_name + "` not declared")
    }
    let buf = malloc_enum_bytes(ctx, enum_l.variants)
    let tag_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, buf, 0, "tag_ptr")
    let tag_val = const_i8(ctx, v.tag)
    forge_llvm_build_store(ctx.builder, tag_val, tag_gep)
    let fill = fill_enum_payload(ctx, env, st_ty, buf, args, 0)
    if fill.had_error { return fill }
    let as_i64 = to_i64(ctx, buf, "enum_i64")
    EmitResult { value: as_i64, ty: "enum:" + type_name, had_error: false, error_message: "" }
}

export fn malloc_enum_bytes(ctx: Ctx, variants: VariantList) -> ptr {
    let max_payload = variant_max_payload(variants)
    let size = forge_llvm_const_int(ctx.i64_type, (max_payload + 1) * 8, 0)
    let malloc_fn = forge_llvm_get_named_function(ctx.module, "malloc")
    let pa = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(pa, 0, ctx.i64_type)
    let malloc_type = forge_llvm_function_type(ctx.ptr_type, pa, 1, 0)
    forge_llvm_type_array_free(pa)
    let arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(arr, 0, size)
    let buf = forge_llvm_build_call(ctx.builder, malloc_type, malloc_fn, arr, 1, "enum_buf")
    forge_llvm_value_array_free(arr)
    buf
}

fn fill_enum_payload(ctx: Ctx, env: VarEnv, st_ty: ptr, alloca: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(expr, next) -> {
            let r = emit_expr(ctx, env, expr)
            if r.had_error { return r }
            let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, alloca, idx + 1, "epay_ptr")
            forge_llvm_build_store(ctx.builder, r.value, gep)
            fill_enum_payload(ctx, env, st_ty, alloca, next, idx + 1)
        }
    }
}
