// WHY: emits enum constructors (heap-allocated tagged unions).

use core.ast.{Expr, ExprList, FieldList, VariantList, VarEnv, variant_lookup, variant_max_payload, field_list_length, ValueType}
use codegen.types.{Ctx, EmitResult, ok_emit, err_emit, null_ptr_val, enum_reg_lookup, enum_reg_find_by_variant, const_i64, const_i8, to_i64, cg_malloc}
use codegen.{emit_expr}


export fn emit_enum_ctor(ctx: Ctx, env: VarEnv, type_name: string, variant: string, args: ExprList) -> EmitResult {
    // Contextual resolution: `.Variant` with empty type_name.
    // Search all enums for a variant with this name.
    let resolved_name = if type_name == "" {
        let found = enum_reg_find_by_variant(ctx.enums, variant)
        if found == "" {
            return err_emit("no enum has variant `${variant}`")
        }
        found
    } else {
        type_name
    }
    let enum_l = enum_reg_lookup(ctx.enums, resolved_name)
    if !enum_l.found {
        return err_emit("undefined enum type `${resolved_name}`")
    }
    let v = variant_lookup(enum_l.variants, variant)
    if !v.found {
        return err_emit("enum `${resolved_name}` has no variant `${variant}`")
    }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, resolved_name)
    if st_ty == null {
        return err_emit("LLVM enum type `${resolved_name}` not declared")
    }
    // Enum layout: {i8 tag, ptr payload}
    // Allocate outer struct (always 16 bytes)
    let buf = cg_malloc(ctx, const_i64(ctx, 16))
    let tag_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, buf, 0, "tag_ptr")
    forge_llvm_build_store(ctx.builder, const_i64(ctx, v.tag), tag_gep)

    // Allocate payload if variant has fields
    let num_fields = field_list_length(v.fields)
    let payload_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, buf, 1, "pay_ptr")
    if num_fields == 0 {
        // Nullary variant — null payload
        let null_val = forge_llvm_const_null(forge_llvm_pointer_type(ctx.lc))
        forge_llvm_build_store(ctx.builder, null_val, payload_gep)
    } else {
        // Allocate payload: num_fields * 8 bytes
        let pay_buf = cg_malloc(ctx, const_i64(ctx, num_fields * 8))
        forge_llvm_build_store(ctx.builder, pay_buf, payload_gep)
        let fill = fill_enum_payload(ctx, env, pay_buf, args, 0)
        if fill.had_error { return fill }
    }
    let as_i64 = to_i64(ctx, buf, "enum_i64")
    EmitResult { value: as_i64, ty: .Enum(resolved_name), had_error: false, error_message: "" }
}

export fn malloc_enum_bytes(ctx: Ctx, variants: VariantList) -> ptr {
    // Fixed size: {i8 tag, ptr payload} = 16 bytes always
    cg_malloc(ctx, const_i64(ctx, 16))
}

fn fill_enum_payload(ctx: Ctx, env: VarEnv, payload_ptr: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(se, next) -> {
            let r = emit_expr(ctx, env, se.node)
            if r.had_error { return r }
            // Write field at offset idx * 8 in the payload buffer
            let base_i64 = forge_llvm_build_ptr_to_int(ctx.builder, payload_ptr, ctx.i64_type, "pay_base")
            let offset_val = const_i64(ctx, idx * 8)
            let addr = forge_llvm_build_add(ctx.builder, base_i64, offset_val, "pay_addr")
            let field_ptr = forge_llvm_build_int_to_ptr(ctx.builder, addr, forge_llvm_pointer_type(ctx.lc), "fld_ptr")
            forge_llvm_build_store(ctx.builder, r.value, field_ptr)
            fill_enum_payload(ctx, env, payload_ptr, next, idx + 1)
        }
    }
}
