mod codegen
use codegen.types.{err_emit}
use features.eval.{error_result}
use core.registry.{feature_new, register}
use resolve.{resolve_expr}
use features.is_keyword.codegen.{emit_is_check}
use typeck.{check_expr, tc_er}

export fn init_is_keyword(reg: Registry) {
    let f = feature_new("is") with {
        expr_tag: Expr.IsCheck(Expr.Null, ""),
        emit_expr: (ctx: int, env, expr: Expr) -> match expr { .IsCheck(subject, vname) -> emit_is_check(ctx, env, subject, vname), _ -> err_emit("expected IsCheck") },
        resolve_expr: (r: int, expr: Expr) -> match expr { .IsCheck(subject, _) -> resolve_expr(r, subject), _ -> r },
        check_expr: (tc: int, expr: Expr) -> match expr {
            .IsCheck(subject, _) -> {
                let s = check_expr(tc, subject)
                tc_er(s.tc, .Bool)
            }
            _ -> tc_er(tc, .Int)
        },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .IsCheck(_, _) -> error_result(rt, "is-check is not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected IsCheck")
        },
    }
    register(reg, f)
}
