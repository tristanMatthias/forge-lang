// WHY: parses `match` as both a statement and an expression, plus the
// pattern syntax that match arms use.
//
// AGENT:
//   read this file when:    adding match-arm forms or new pattern shapes
//   do NOT read this file when:   the issue is expression precedence (parser.fg)
//   related:                features/match_expr/codegen.fg, core.ast.{Pattern, MatchArmList}

use core.ast.{Stmt, Expr, ExprList, Pattern, PatternList, MatchArmList, WhenArmList, ParamList, SExpr, sexpr, StmtList, sstmt}use parse.{Parser, reverse_expr_list, table_zip_entries}
use core.ast.{Tk}

impl Parser {
    fn parse_match_statement(self) -> Stmt? {
        self.advance()
        // Subjectless match at statement level: wrap result in Stmt.Expr(Expr.When(...))
        if self.check(Tk.LeftBrace) {
            self.advance()
            let arms = self.parse_when_arm_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after match arms") { return null }
            return Stmt.Expr(Expr.When(arms))
        }
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject_opt = self.parse_expression()
        self.allow_struct_lit = saved
        let subject = subject_opt?
        // Match table: `match expr table { pattern | col | col; .A | v | v }`
        if self.check(Tk.Identifier) && self.current_lexeme == "table" {
            self.advance()  // consume `table`
            if !self.consume(Tk.LeftBrace, "expected `{` after match table") { return null }
            let arms = self.parse_match_table_arms()?
            if !self.consume(Tk.RightBrace, "expected `}` after match table") { return null }
            return Stmt.Match(subject, arms)
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after match subject") {
            return null
        }
        let arms = self.parse_match_arm_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after match arms") {
            return null
        }
        Stmt.Match(subject, arms)
    }

    // Parse match table: first row is headers, remaining rows are pattern | values.
    // Desugars each row to a match arm returning a MapLit.
    fn parse_match_table_arms(self) -> MatchArmList? {
        // Parse header row: identifiers separated by |
        mut headers: ExprList = ExprList.End
        mut header_count = 0
        let header_line = self.current_line
        while !self.check(Tk.RightBrace) && !self.check(Tk.Eof) && self.current_line == header_line {
            if self.check(Tk.Identifier) {
                let col = self.current_lexeme
                self.advance()
                // Wrap in quotes so strip_quotes in codegen produces the correct key
                let quoted_col = "\"${col}\""
                headers = ExprList.Node(sexpr(Expr.String(quoted_col), self.current_line, self.current_column), headers)
                header_count = header_count + 1
                if self.check(Tk.Pipe) { self.advance() }
            } else {
                break
            }
        }
        if header_count < 2 { return MatchArmList.End }
        // Skip the first header (pattern column)
        let value_headers = match reverse_expr_list(headers) {
            .End -> ExprList.End
            .Node(_, rest) -> rest
        }
        let value_count = header_count - 1
        // Parse data rows: pattern | val1 | val2
        self.parse_match_table_rows(value_headers, value_count)
    }

    fn parse_match_table_rows(self, headers: ExprList, value_count: int) -> MatchArmList? {
        if self.current_kind in [Tk.RightBrace, Tk.Eof] { return MatchArmList.End }
        // Parse pattern — disable dot postfix to prevent .Variant from
        // becoming a field access on the previous expression
        let saved_dot = self.allow_dot_postfix
        self.allow_dot_postfix = false
        let pattern = self.parse_pattern()?
        self.allow_dot_postfix = saved_dot
        if self.check(Tk.Pipe) { self.advance() }
        // Parse values — one per column, stopping at | separators
        let row_line = self.current_line
        mut vals: ExprList = ExprList.End
        mut i = 0
        while i < value_count {
            if self.check(Tk.RightBrace) { break }
            // Use primary-only parsing for table cells to avoid
            // consuming | or the next row's pattern
            let val = self.parse_primary()?
            vals = ExprList.Node(sexpr(val, self.current_line, self.current_column), vals)
            i = i + 1
            if self.check(Tk.Pipe) { self.advance() }
        }
        // Build map body
        let map_entries = table_zip_entries(headers, reverse_expr_list(vals))
        let body = Expr.MapLit(map_entries)
        if self.check(Tk.Comma) { self.advance() }
        let rest = self.parse_match_table_rows(headers, value_count)?
        MatchArmList.Node(pattern, null, sexpr(body, self.current_line, self.current_column), rest)
    }

    // Parse a pattern that may be an OR of alternatives: `pat or pat or pat`.
    // Only used in normal match arms — table rows use parse_pattern directly
    // so that `|` column separators are not consumed as part of OR patterns.
    fn parse_pattern_or(self) -> Pattern? {
        let left = self.parse_pattern()?
        if !self.check(Tk.KwOr) { return left }
        self.advance()
        let right = self.parse_pattern_or()?
        Pattern.Or(left, right)
    }

    fn parse_match_arm_list(self) -> MatchArmList? {
        if self.check(Tk.RightBrace) {
            return MatchArmList.End
        }
        let pattern = self.parse_pattern_or()?
        // Optional guard: `pattern if cond ->`
        let guard: SExpr? = if self.check(Tk.KwIf) {
            self.advance()
            let g = self.parse_expression()?
            sexpr(g, self.current_line, self.current_column)
        } else {
            null
        }
        if !self.consume(Tk.Arrow, "expected `->` after pattern") {
            return null
        }
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = false
        // Allow `return expr` in bare match arm position by wrapping
        // it in a Block expression: `{ return expr }`
        let body = if self.check(Tk.KwReturn) {
            self.advance()
            let ret_val = self.parse_expression()
            if ret_val == null { null } else {
                let ret_stmt = sstmt(Stmt.Return(ret_val!), self.current_line, self.current_column)
                Expr.Block(StmtList.Node(ret_stmt, StmtList.End))
            }
        } else {
            self.parse_expression()
        }
        self.allow_dot_postfix = saved
        let body_val = body?
        if self.check(Tk.Comma) {
            self.advance()
        }
        let rest = self.parse_match_arm_list()?
        MatchArmList.Node(pattern, guard, sexpr(body_val, self.current_line, self.current_column), rest)
    }

    fn parse_pattern(self) -> Pattern? {
        if self.check(Tk.Identifier) && self.current_lexeme == "_" {
            self.advance()
            return Pattern.Wildcard
        }
        // Literal patterns: "string", 42, true, false
        if self.check(Tk.String) {
            let raw = self.current_lexeme
            self.advance()
            // Strip surrounding quotes from the lexeme
            let content = raw.substring(1, raw.length - 1)
            return Pattern.LitString(content)
        }
        if self.check(Tk.Number) {
            let val = int(self.current_lexeme)
            self.advance()
            return Pattern.LitInt(val)
        }
        if self.check(Tk.Float) {
            let val = self.current_lexeme
            self.advance()
            return Pattern.LitFloat(val)
        }
        // Negative literal patterns: -42, -3.14
        if self.check(Tk.Minus) {
            self.advance()
            if self.check(Tk.Number) {
                let val = int(self.current_lexeme)
                self.advance()
                return Pattern.LitInt(0 - val)
            }
            if self.check(Tk.Float) {
                let val = "-${self.current_lexeme}"
                self.advance()
                return Pattern.LitFloat(val)
            }
            self.set_error("expected number after `-` in pattern")
            return null
        }
        if self.check(Tk.KwTrue) {
            self.advance()
            return Pattern.LitBool(true)
        }
        if self.check(Tk.KwFalse) {
            self.advance()
            return Pattern.LitBool(false)
        }
        // Union type pattern: int(n), string(s), MyStruct(v)
        // Recognized when an identifier is followed by '(' — distinguishes from
        // enum variant patterns which start with '.'.
        if self.check(Tk.Identifier) && self.peek_after_ident_is_paren() {
            let type_name = self.current_lexeme
            self.advance()  // past type name identifier
            if !self.consume(Tk.LeftParen, "expected `(` in type pattern") { return null }
            let binding = self.consume_identifier("expected binding name in type pattern")?
            if !self.consume(Tk.RightParen, "expected `)` after type pattern binding") {
                return null
            }
            return Pattern.TypePattern(type_name, binding)
        }
        if !self.consume(Tk.Dot, "expected `.`, `_`, literal, or type pattern to start pattern") {
            return null
        }
        let name = self.consume_identifier("expected variant name in pattern")?
        if !self.check(Tk.LeftParen) {
            return Pattern.Variant(name, ParamList.End)
        }
        self.advance()
        // Detect nested patterns: if first token inside parens is `.`, `_`,
        // a literal, or `-`, parse as sub-pattern list. Otherwise simple bindings.
        if self.is_pattern_start() {
            let sub = self.parse_pattern_list()?
            if !self.consume(Tk.RightParen, "expected `)` after nested patterns") {
                return null
            }
            return Pattern.NestedVariant(name, sub)
        }
        let bindings = self.parse_param_list()?
        if !self.consume(Tk.RightParen, "expected `)` after binding list") {
            return null
        }
        Pattern.Variant(name, bindings)
    }

    fn is_pattern_start(self) -> bool {
        // Only `.` (sub-variant) triggers nested pattern mode.
        // Literals and `_` are ambiguous with simple bindings, so
        // we don't use them as triggers — they'll be parsed as
        // simple param bindings via parse_param_list.
        self.check(Tk.Dot)
    }

    fn parse_pattern_list(self) -> PatternList? {
        if self.check(Tk.RightParen) {
            return PatternList.End
        }
        let p = self.parse_pattern()?
        if self.check(Tk.Comma) {
            self.advance()
        }
        if self.check(Tk.RightParen) {
            return PatternList.Node(p, PatternList.End)
        }
        let rest = self.parse_pattern_list()?
        PatternList.Node(p, rest)
    }

    fn parse_match_expression(self) -> Expr? {
        self.advance()
        // Subjectless match: `match { cond -> body ... _ -> fallback }`
        if self.check(Tk.LeftBrace) {
            self.advance()
            let arms = self.parse_when_arm_list()?
            if !self.consume(Tk.RightBrace, "expected `}` after match arms") { return null }
            return Expr.When(arms)
        }
        let saved_struct = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject_opt = self.parse_expression()
        self.allow_struct_lit = saved_struct
        let subject = subject_opt?
        // Match table expression
        if self.check(Tk.Identifier) && self.current_lexeme == "table" {
            self.advance()
            if !self.consume(Tk.LeftBrace, "expected `{` after match table") { return null }
            let arms = self.parse_match_table_arms()?
            if !self.consume(Tk.RightBrace, "expected `}` after match table") { return null }
            return Expr.MatchExpr(subject, arms)
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after match subject") {
            return null
        }
        let arms = self.parse_match_arm_list()?
        if !self.consume(Tk.RightBrace, "expected `}` after match arms") {
            return null
        }
        Expr.MatchExpr(subject, arms)
    }

    // Convert subjectless match arms to an if-else chain.
    fn parse_when_arm_list(self) -> WhenArmList? {
        if self.check(Tk.RightBrace) { return WhenArmList.End }
        // `_` → else/wildcard arm (no condition)
        let cond: SExpr? = if self.check(Tk.Identifier) && self.current_lexeme == "_" {
            self.advance()
            null
        } else {
            let c = self.parse_expression()?
            sexpr(c, self.current_line, self.current_column)
        }
        if !self.consume(Tk.Arrow, "expected `->` in match arm") { return null }
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = false
        let body_expr = self.parse_expression()?
        self.allow_dot_postfix = saved
        if self.check(Tk.Comma) { self.advance() }
        let rest = self.parse_when_arm_list()?
        WhenArmList.Node(cond, sexpr(body_expr, self.current_line, self.current_column), rest)
    }
}
