// Match as expression in various positions
enum Dir { N, S, E, W }

// Match as function argument
fn double(n: int) -> int { n * 2 }
let d = Dir.E
let val = double(match d { .N -> 1, .S -> 2, .E -> 3, .W -> 4 })
val |> string |> println

// Match as initializer
let label = match d {
    .N -> "north"
    .S -> "south"
    .E -> "east"
    .W -> "west"
}
println(label)

// Match in binary expression
let score = 100 + match d { .N -> 1, .S -> 2, .E -> 3, .W -> 4 }
score |> string |> println
