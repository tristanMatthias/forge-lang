// Tests for subjectless match { cond -> body ... _ -> fallback }
// expect:
// negative
// zero
// small
// large
// fizzbuzz
// fizz
// buzz
// 7
// pass
// fail

fn classify(n: int) -> string {
    match {
        n < 0  -> "negative"
        n == 0 -> "zero"
        n < 10 -> "small"
        _      -> "large"
    }
}

fn fizzbuzz(n: int) -> string {
    match {
        n % 15 == 0 -> "fizzbuzz"
        n % 3 == 0  -> "fizz"
        n % 5 == 0  -> "buzz"
        _           -> string(n)
    }
}

fn grade(score: int) -> string {
    match {
        score >= 90 -> "pass"
        _           -> "fail"
    }
}

println(classify(-5))
println(classify(0))
println(classify(7))
println(classify(100))
println(fizzbuzz(15))
println(fizzbuzz(9))
println(fizzbuzz(10))
println(fizzbuzz(7))
println(grade(95))
println(grade(50))
