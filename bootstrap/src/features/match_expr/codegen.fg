// WHY: emits LLVM IR for `match` as both a statement and an expression.

use core.ast.{Expr, Pattern, PatternList, MatchArmList, ParamList, FieldList, VariantList, VarEnv, env_extend, variant_lookup, ValueType, vtype_enum_name, vtype_display, vtype_eq, vtype_is_str, SExpr}
use codegen.types.{Ctx, EmitResult, StmtResult, ok_stmt, err_stmt, err_stmt_from_expr, err_emit, ok_emit, ok_emit_typed, ok_emit_str, null_ptr_val, enum_reg_lookup, translate_param_type, field_type_at, advance_field_list, new_bb, const_i8, const_i64, to_ptr, to_i64, to_f64, get_fn, call_1, call_2, call_4}
use codegen.{emit_expr}


// ── Match as expression ──

export fn emit_match_expr(ctx: Ctx, env: VarEnv, subject: Expr, arms: MatchArmList) -> EmitResult {
    let r = emit_expr(ctx, env, subject)?
    let enum_name = vtype_enum_name(r.ty)
    if enum_name == "" {
        // Non-enum match: treat as guard-based if-else chain.
        // Each arm must be a wildcard with an optional guard.
        return emit_primitive_match_expr(ctx, env, r, arms)
    }
    let lookup = enum_reg_lookup(ctx.enums, enum_name)
    if !lookup.found { return err_emit("unknown enum `${enum_name}`") }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, enum_name)
    let subj_ptr = to_ptr(ctx, r.value, "match_subj")
    let tag_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, subj_ptr, 0, "tag_ptr")
    let tag_val = forge_llvm_build_load(ctx.builder, ctx.i64_type, tag_gep, "tag")
    let result_slot = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, "match_result")
    forge_llvm_build_store(ctx.builder, const_i64(ctx, 0), result_slot)
    let merge_bb = new_bb(ctx, "match_end")
    let arm_result = emit_match_expr_arms(ctx, env, arms, st_ty, subj_ptr, tag_val, lookup.variants, merge_bb, result_slot)?
    forge_llvm_position_at_end(ctx.builder, merge_bb)
    let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, result_slot, "match_val")
    ok_emit_typed(loaded, arm_result.ty)
}

fn emit_match_expr_arms(ctx: Ctx, env: VarEnv, arms: MatchArmList, st_ty: ptr, subj_ptr: ptr, tag_val: ptr, variants: VariantList, merge_bb: ptr, result_slot: ptr) -> EmitResult {
    match arms {
        .End -> {
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                let fn_name_str = forge_llvm_build_global_string_ptr(ctx.builder, ctx.current_fn_name, ".match_fn")
                let tag_i64 = tag_val
                let mu_file = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "mu_file")
                let mu_line = const_i64(ctx, ctx.source_line)
                call_4(ctx, get_fn(ctx, "forge_match_unreachable"), fn_name_str, tag_i64, mu_file, mu_line, "")
                forge_llvm_build_unreachable(ctx.builder)
            }
            ok_emit(null_ptr_val())
        }
        .Node(pattern, guard, body, next) -> {
            let arm_bb = new_bb(ctx, "march_arm")
            let next_bb = new_bb(ctx, "march_next")
            emit_pattern_tag_branch(ctx, pattern, tag_val, variants, arm_bb, next_bb)
            forge_llvm_position_at_end(ctx.builder, arm_bb)
            // For nested patterns, check inner variant tags before binding
            emit_nested_tag_checks(ctx, pattern, st_ty, subj_ptr, variants, next_bb)
            let arm_env = bind_pattern_payload(ctx, env, pattern, st_ty, subj_ptr, variants)
            // Guard: if present, check condition; if false, skip to next arm
            if guard != null {
                let guard_r = emit_expr(ctx, arm_env, guard!.node)?
                let guard_bool = forge_llvm_build_icmp(ctx.builder, 33, guard_r.value, const_i64(ctx, 0), "guard")
                let guard_pass_bb = new_bb(ctx, "guard_pass")
                forge_llvm_build_cond_br(ctx.builder, guard_bool, guard_pass_bb, next_bb)
                forge_llvm_position_at_end(ctx.builder, guard_pass_bb)
            }
            let body_result = emit_expr(ctx, arm_env, body.node)?
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                forge_llvm_build_store(ctx.builder, body_result.value, result_slot)
                forge_llvm_build_br(ctx.builder, merge_bb)
            }
            forge_llvm_position_at_end(ctx.builder, next_bb)
            let rest = emit_match_expr_arms(ctx, env, next, st_ty, subj_ptr, tag_val, variants, merge_bb, result_slot)?
            if !vtype_eq(rest.ty, .Int) && !vtype_eq(body_result.ty, rest.ty) {
                eprintln("warning: match arms have different types: `${vtype_display(body_result.ty)}` vs `${vtype_display(rest.ty)}`")
            }
            ok_emit_typed(body_result.value, body_result.ty)
        }
    }
}

// ── Match as statement ──

export fn emit_match(ctx: Ctx, env: VarEnv, subject: Expr, arms: MatchArmList) -> StmtResult {
    let r = emit_expr(ctx, env, subject)
    if r.had_error { return err_stmt_from_expr(r) }
    let enum_name = vtype_enum_name(r.ty)
    if enum_name == "" {
        // Non-enum match: treat as guard-based if-else chain.
        return emit_primitive_match_stmt(ctx, env, r, arms)
    }
    let lookup = enum_reg_lookup(ctx.enums, enum_name)
    if !lookup.found { return err_stmt("codegen error: unknown enum `${enum_name}`") }
    let st_ty = forge_llvm_get_type_by_name(ctx.lc, enum_name)
    let subj_ptr = to_ptr(ctx, r.value, "match_subj")
    let tag_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, subj_ptr, 0, "tag_ptr")
    let tag_val = forge_llvm_build_load(ctx.builder, ctx.i64_type, tag_gep, "tag")
    let merge_bb = new_bb(ctx, "match_end")
    let arm_result = emit_match_arms(ctx, env, arms, st_ty, subj_ptr, tag_val, lookup.variants, merge_bb)?
    forge_llvm_position_at_end(ctx.builder, merge_bb)
    ok_stmt(env)
}

fn emit_match_arms(ctx: Ctx, env: VarEnv, arms: MatchArmList, st_ty: ptr, subj_ptr: ptr, tag_val: ptr, variants: VariantList, merge_bb: ptr) -> StmtResult {
    match arms {
        .End -> {
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                let fn_name_str = forge_llvm_build_global_string_ptr(ctx.builder, ctx.current_fn_name, ".match_fn")
                let tag_i64 = tag_val
                let mu_file = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "mu_file")
                let mu_line = const_i64(ctx, ctx.source_line)
                call_4(ctx, get_fn(ctx, "forge_match_unreachable"), fn_name_str, tag_i64, mu_file, mu_line, "")
                forge_llvm_build_unreachable(ctx.builder)
            }
            ok_stmt(env)
        }
        .Node(pattern, guard, body, next) -> {
            let arm_bb = new_bb(ctx, "match_arm")
            let next_bb = new_bb(ctx, "match_next")
            emit_pattern_tag_branch(ctx, pattern, tag_val, variants, arm_bb, next_bb)
            forge_llvm_position_at_end(ctx.builder, arm_bb)
            emit_nested_tag_checks(ctx, pattern, st_ty, subj_ptr, variants, next_bb)
            let arm_env = bind_pattern_payload(ctx, env, pattern, st_ty, subj_ptr, variants)
            if guard != null {
                let guard_r = emit_expr(ctx, arm_env, guard!.node)
                if guard_r.had_error { return err_stmt(guard_r.error_message) }
                let guard_bool = forge_llvm_build_icmp(ctx.builder, 33, guard_r.value, const_i64(ctx, 0), "guard")
                let guard_pass_bb = new_bb(ctx, "guard_pass")
                forge_llvm_build_cond_br(ctx.builder, guard_bool, guard_pass_bb, next_bb)
                forge_llvm_position_at_end(ctx.builder, guard_pass_bb)
            }
            let body_result = emit_expr(ctx, arm_env, body.node)
            if body_result.had_error { return err_stmt(body_result.error_message) }
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                forge_llvm_build_br(ctx.builder, merge_bb)
            }
            forge_llvm_position_at_end(ctx.builder, next_bb)
            emit_match_arms(ctx, env, next, st_ty, subj_ptr, tag_val, variants, merge_bb)
        }
    }
}

// ── Pattern payload binding ──

// Shared tag dispatch: compare pattern's variant tag against subject's tag.
fn pattern_variant_name(pattern: Pattern) -> string {
    match pattern {
        .Variant(vname, _) -> vname
        .NestedVariant(vname, _) -> vname
        _ -> ""
    }
}

fn emit_pattern_tag_branch(ctx: Ctx, pattern: Pattern, tag_val: ptr, variants: VariantList, arm_bb: ptr, next_bb: ptr) -> ptr {
    let vname = pattern_variant_name(pattern)
    if vname == "" {
        // Wildcard or literal: always take arm
        return forge_llvm_build_br(ctx.builder, arm_bb)
    }
    let v = variant_lookup(variants, vname)
    if !v.found {
        return forge_llvm_build_br(ctx.builder, next_bb)
    }
    let cmp = forge_llvm_build_icmp(ctx.builder, 32, tag_val, const_i64(ctx, v.tag), "tag_eq")
    forge_llvm_build_cond_br(ctx.builder, cmp, arm_bb, next_bb)
}

// Emit runtime checks for inner variant tags in nested patterns.
// If the inner tag doesn't match, branch to next_bb (skip this arm).
fn emit_nested_tag_checks(ctx: Ctx, pattern: Pattern, st_ty: ptr, subj_ptr: ptr, variants: VariantList, next_bb: ptr) {
    match pattern {
        .NestedVariant(vname, sub_pats) -> {
            let v = variant_lookup(variants, vname)
            if !v.found { return }
            emit_nested_tag_check_list(ctx, st_ty, subj_ptr, sub_pats, v.fields, 0, next_bb)
        }
        _ -> {}
    }
}

fn emit_nested_tag_check_list(ctx: Ctx, st_ty: ptr, subj_ptr: ptr, pats: PatternList, fields: FieldList, idx: int, next_bb: ptr) {
    match pats {
        .End -> {}
        .Node(pat, next) -> {
            match pat {
                .Variant(inner_vname, _) -> {
                    let field_type_name = field_type_at(fields, 0)
                    let inner_ty = translate_param_type(ctx.structs, ctx.enums, field_type_name)
                    let enum_name = vtype_enum_name(inner_ty)
                    if enum_name != "" {
                        let lookup = enum_reg_lookup(ctx.enums, enum_name)
                        if lookup.found {
                            let iv = variant_lookup(lookup.variants, inner_vname)
                            if iv.found {
                                let inner_val = load_payload_field(ctx, st_ty, subj_ptr, idx, "inner_i64")
                                let inner_ptr = to_ptr(ctx, inner_val, "inner_enum_ptr")
                                let inner_struct_ty = forge_llvm_get_type_by_name(ctx.lc, enum_name)
                                let inner_tag_gep = forge_llvm_build_struct_gep2(ctx.builder, inner_struct_ty, inner_ptr, 0, "inner_tag_ptr")
                                let inner_tag = forge_llvm_build_load(ctx.builder, ctx.i64_type, inner_tag_gep, "inner_tag")
                                let want = const_i64(ctx, iv.tag)
                                let cmp = forge_llvm_build_icmp(ctx.builder, 32, inner_tag, want, "inner_tag_eq")
                                let pass_bb = new_bb(ctx, "inner_pass")
                                forge_llvm_build_cond_br(ctx.builder, cmp, pass_bb, next_bb)
                                forge_llvm_position_at_end(ctx.builder, pass_bb)
                            }
                        }
                    }
                }
                .NestedVariant(inner_vname, _) -> {
                    // Same tag check for deeper nesting
                    let field_type_name = field_type_at(fields, 0)
                    let inner_ty = translate_param_type(ctx.structs, ctx.enums, field_type_name)
                    let enum_name = vtype_enum_name(inner_ty)
                    if enum_name != "" {
                        let lookup = enum_reg_lookup(ctx.enums, enum_name)
                        if lookup.found {
                            let iv = variant_lookup(lookup.variants, inner_vname)
                            if iv.found {
                                let inner_val = load_payload_field(ctx, st_ty, subj_ptr, idx, "inner_i64")
                                let inner_ptr = to_ptr(ctx, inner_val, "inner_enum_ptr")
                                let inner_struct_ty = forge_llvm_get_type_by_name(ctx.lc, enum_name)
                                let inner_tag_gep = forge_llvm_build_struct_gep2(ctx.builder, inner_struct_ty, inner_ptr, 0, "inner_tag_ptr")
                                let inner_tag = forge_llvm_build_load(ctx.builder, ctx.i64_type, inner_tag_gep, "inner_tag")
                                let want = const_i64(ctx, iv.tag)
                                let cmp = forge_llvm_build_icmp(ctx.builder, 32, inner_tag, want, "inner_tag_eq")
                                let pass_bb = new_bb(ctx, "inner_pass")
                                forge_llvm_build_cond_br(ctx.builder, cmp, pass_bb, next_bb)
                                forge_llvm_position_at_end(ctx.builder, pass_bb)
                            }
                        }
                    }
                }
                _ -> {}
            }
            emit_nested_tag_check_list(ctx, st_ty, subj_ptr, next, advance_field_list(fields), idx + 1, next_bb)
        }
    }
}

// Load payload field at index `idx` from an enum value.
// Enum layout: {i8 tag, ptr payload}. Payload is an array of i64 values.
fn load_payload_field(ctx: Ctx, st_ty: ptr, subj_ptr: ptr, idx: int, label: string) -> ptr {
    let pay_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, subj_ptr, 1, "pay_slot")
    let pay_ptr = forge_llvm_build_load(ctx.builder, forge_llvm_pointer_type(ctx.lc), pay_gep, "payload")
    let pay_i64 = forge_llvm_build_ptr_to_int(ctx.builder, pay_ptr, ctx.i64_type, "pay_base")
    let addr = forge_llvm_build_add(ctx.builder, pay_i64, const_i64(ctx, idx * 8), "fld_addr")
    let fld_ptr = forge_llvm_build_int_to_ptr(ctx.builder, addr, forge_llvm_pointer_type(ctx.lc), "fld_ptr")
    forge_llvm_build_load(ctx.builder, ctx.i64_type, fld_ptr, label)
}

fn bind_pattern_payload(ctx: Ctx, env: VarEnv, pattern: Pattern, st_ty: ptr, subj_ptr: ptr, variants: VariantList) -> VarEnv {
    match pattern {
        .Wildcard -> env
        .Variant(vname, bindings) -> {
            let v = variant_lookup(variants, vname)
            if !v.found { return env }
            bind_pattern_payload_loop(ctx, env, st_ty, subj_ptr, bindings, v.fields, 0)
        }
        .NestedVariant(vname, sub_pats) -> {
            let v = variant_lookup(variants, vname)
            if !v.found { return env }
            bind_nested_patterns(ctx, env, st_ty, subj_ptr, sub_pats, v.fields, 0)
        }
        _ -> env  // Literal patterns don't bind variables
    }
}

fn bind_pattern_payload_loop(ctx: Ctx, env: VarEnv, st_ty: ptr, subj_ptr: ptr, bindings: ParamList, fields: FieldList, idx: int) -> VarEnv {
    match bindings {
        .End -> env
        .Node(name, _, next_b) if name == "_" ->
            bind_pattern_payload_loop(ctx, env, st_ty, subj_ptr, next_b, advance_field_list(fields), idx + 1)
        .Node(name, _, next_b) -> {
            let loaded = load_payload_field(ctx, st_ty, subj_ptr, idx, name)
            let alloca = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, name)
            forge_llvm_build_store(ctx.builder, loaded, alloca)
            let field_ty = translate_param_type(ctx.structs, ctx.enums, field_type_at(fields, 0))
            let extended = env_extend(env, name, alloca, field_ty)
            bind_pattern_payload_loop(ctx, extended, st_ty, subj_ptr, next_b, advance_field_list(fields), idx + 1)
        }
    }
}

// Bind nested sub-patterns: each PatternList element matches against the
// corresponding payload field of the outer variant.
fn bind_nested_patterns(ctx: Ctx, env: VarEnv, st_ty: ptr, subj_ptr: ptr, pats: PatternList, fields: FieldList, idx: int) -> VarEnv {
    match pats {
        .End -> env
        .Node(pat, next) -> {
            let loaded = load_payload_field(ctx, st_ty, subj_ptr, idx, "npat_val")
            let field_ty = translate_param_type(ctx.structs, ctx.enums, field_type_at(fields, 0))
            let new_env = bind_single_sub_pattern(ctx, env, pat, loaded, field_ty)
            bind_nested_patterns(ctx, new_env, st_ty, subj_ptr, next, advance_field_list(fields), idx + 1)
        }
    }
}

// Bind a single sub-pattern against a value extracted from a payload field.
fn bind_single_sub_pattern(ctx: Ctx, env: VarEnv, pat: Pattern, value: ptr, ty: ValueType) -> VarEnv {
    match pat {
        .Wildcard -> env
        .Variant(vname, bindings) -> {
            // Inner variant: extract its payload. The value is an i64
            // holding a pointer to the inner enum struct.
            let enum_name = vtype_enum_name(ty)
            if enum_name == "" {
                // Not an enum type — try to bind directly
                return bind_first_param(ctx, env, bindings, value, ty)
            }
            let lookup = enum_reg_lookup(ctx.enums, enum_name)
            if !lookup.found { return env }
            let inner_ptr = to_ptr(ctx, value, "inner_ptr")
            let inner_ty = forge_llvm_get_type_by_name(ctx.lc, enum_name)
            let v = variant_lookup(lookup.variants, vname)
            if !v.found { return env }
            bind_pattern_payload_loop(ctx, env, inner_ty, inner_ptr, bindings, v.fields, 0)
        }
        .NestedVariant(vname, sub_pats) -> {
            let enum_name = vtype_enum_name(ty)
            if enum_name == "" { return env }
            let lookup = enum_reg_lookup(ctx.enums, enum_name)
            if !lookup.found { return env }
            let inner_ptr = to_ptr(ctx, value, "inner_ptr")
            let inner_ty = forge_llvm_get_type_by_name(ctx.lc, enum_name)
            let v = variant_lookup(lookup.variants, vname)
            if !v.found { return env }
            bind_nested_patterns(ctx, env, inner_ty, inner_ptr, sub_pats, v.fields, 0)
        }
        _ -> env  // Literal sub-patterns don't bind
    }
}

// Bind the first param from a ParamList as a simple variable.
fn bind_first_param(ctx: Ctx, env: VarEnv, bindings: ParamList, value: ptr, ty: ValueType) -> VarEnv {
    match bindings {
        .End -> env
        .Node(name, _, _) if name == "_" -> env
        .Node(name, _, _) -> {
            let alloca = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, name)
            forge_llvm_build_store(ctx.builder, value, alloca)
            env_extend(env, name, alloca, ty)
        }
    }
}

// ── Primitive match (non-enum) ──
// When the match subject is not an enum, arms are treated as a
// guard-based if-else chain. Only wildcard patterns are allowed.
// The subject value is available in the guard via the original variable.

fn emit_primitive_match_expr(ctx: Ctx, env: VarEnv, subj: EmitResult, arms: MatchArmList) -> EmitResult {
    let result_slot = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, "pmatch_result")
    forge_llvm_build_store(ctx.builder, const_i64(ctx, 0), result_slot)
    let merge_bb = new_bb(ctx, "pmatch_end")
    emit_primitive_arms_expr(ctx, env, subj, arms, merge_bb, result_slot)
}

// Generate a boolean comparison for a literal pattern against the subject.
fn emit_literal_cmp(ctx: Ctx, subj: EmitResult, pattern: Pattern) -> ptr {
    match pattern {
        .LitInt(val) -> {
            forge_llvm_build_icmp(ctx.builder, 32, subj.value, const_i64(ctx, val), "lit_eq")
        }
        .LitBool(val) -> {
            let cmp_val = if val { const_i64(ctx, 1) } else { const_i64(ctx, 0) }
            forge_llvm_build_icmp(ctx.builder, 32, subj.value, cmp_val, "lit_eq")
        }
        .LitString(val) -> {
            let subj_ptr = to_ptr(ctx, subj.value, "lit_str_ptr")
            let lit_ptr = forge_llvm_build_global_string_ptr(ctx.builder, val, ".lit_str")
            let cmp_result = call_2(ctx, get_fn(ctx, "strcmp"), subj_ptr, lit_ptr, "strcmp_r")
            // Sign-extend i32 strcmp result to i64 for type-safe icmp (LLVM 21 requires matching types)
            let cmp_ext = forge_llvm_build_sext(ctx.builder, cmp_result, ctx.i64_type, "strcmp_sext")
            forge_llvm_build_icmp(ctx.builder, 32, cmp_ext, const_i64(ctx, 0), "str_eq")
        }
        .LitFloat(val) -> {
            // Parse the float literal string → i64 bits, then compare as f64
            let lit_str = forge_llvm_build_global_string_ptr(ctx.builder, val, ".flit_str")
            let lit_bits = call_1(ctx, get_fn(ctx, "forge_float_parse"), lit_str, "flit_bits")
            let subj_f64 = to_f64(ctx, subj.value, "subj_f64")
            let lit_f64 = forge_llvm_build_bitcast(ctx.builder, lit_bits, forge_llvm_double_type(ctx.lc), "lit_f64")
            // OEQ = 1 (ordered equal)
            forge_llvm_build_fcmp(ctx.builder, 1, subj_f64, lit_f64, "flit_eq")
        }
        _ -> {
            // Wildcard / Variant — should not reach here
            const_i64(ctx, 1)
        }
    }
}

fn is_literal_pattern(pattern: Pattern) -> bool {
    match pattern {
        .LitString(_) -> true
        .LitInt(_) -> true
        .LitBool(_) -> true
        .LitFloat(_) -> true
        _ -> false
    }
}

fn emit_primitive_arms_expr(ctx: Ctx, env: VarEnv, subj: EmitResult, arms: MatchArmList, merge_bb: ptr, result_slot: ptr) -> EmitResult {
    match arms {
        .End -> {
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                let fn_name_str = forge_llvm_build_global_string_ptr(ctx.builder, ctx.current_fn_name, ".match_fn")
                let mu_file = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "mu_file")
                let mu_line = const_i64(ctx, ctx.source_line)
                call_4(ctx, get_fn(ctx, "forge_match_unreachable"), fn_name_str, const_i64(ctx, -1), mu_file, mu_line, "")
                forge_llvm_build_unreachable(ctx.builder)
            }
            forge_llvm_position_at_end(ctx.builder, merge_bb)
            let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, result_slot, "pmatch_val")
            ok_emit(loaded)
        }
        .Node(pattern, guard, body, next) -> {
            let body_bb = new_bb(ctx, "parm_body")
            let next_bb = new_bb(ctx, "parm_next")

            if is_literal_pattern(pattern) {
                // Literal pattern: compare subject against the literal
                let cmp = emit_literal_cmp(ctx, subj, pattern)
                if guard != null {
                    // Literal + guard: both must be true
                    let lit_pass_bb = new_bb(ctx, "lit_guard")
                    forge_llvm_build_cond_br(ctx.builder, cmp, lit_pass_bb, next_bb)
                    forge_llvm_position_at_end(ctx.builder, lit_pass_bb)
                    let guard_r = emit_expr(ctx, env, guard!.node)?
                    let guard_bool = forge_llvm_build_icmp(ctx.builder, 33, guard_r.value, const_i64(ctx, 0), "pguard")
                    forge_llvm_build_cond_br(ctx.builder, guard_bool, body_bb, next_bb)
                } else {
                    forge_llvm_build_cond_br(ctx.builder, cmp, body_bb, next_bb)
                }
            } else if guard != null {
                // Guarded wildcard: if guard { body } else { next arm }
                let guard_r = emit_expr(ctx, env, guard!.node)?
                let guard_bool = forge_llvm_build_icmp(ctx.builder, 33, guard_r.value, const_i64(ctx, 0), "pguard")
                forge_llvm_build_cond_br(ctx.builder, guard_bool, body_bb, next_bb)
            } else {
                // Unguarded wildcard: always matches (catch-all)
                forge_llvm_build_br(ctx.builder, body_bb)
            }

            forge_llvm_position_at_end(ctx.builder, body_bb)
            let body_r = emit_expr(ctx, env, body.node)?
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                forge_llvm_build_store(ctx.builder, body_r.value, result_slot)
                forge_llvm_build_br(ctx.builder, merge_bb)
            }

            forge_llvm_position_at_end(ctx.builder, next_bb)
            let rest = emit_primitive_arms_expr(ctx, env, subj, next, merge_bb, result_slot)?
            // Return the merged loaded value from result_slot (via rest),
            // but carry the type from this arm's body.
            ok_emit_typed(rest.value, body_r.ty)
        }
    }
}

fn emit_primitive_match_stmt(ctx: Ctx, env: VarEnv, subj: EmitResult, arms: MatchArmList) -> StmtResult {
    let merge_bb = new_bb(ctx, "pmatch_end")
    emit_primitive_arms_stmt(ctx, env, subj, arms, merge_bb)
}

fn emit_primitive_arms_stmt(ctx: Ctx, env: VarEnv, subj: EmitResult, arms: MatchArmList, merge_bb: ptr) -> StmtResult {
    match arms {
        .End -> {
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                let fn_name_str = forge_llvm_build_global_string_ptr(ctx.builder, ctx.current_fn_name, ".match_fn")
                let mu_file = forge_llvm_build_global_string_ptr(ctx.builder, ctx.source_file, "mu_file")
                let mu_line = const_i64(ctx, ctx.source_line)
                call_4(ctx, get_fn(ctx, "forge_match_unreachable"), fn_name_str, const_i64(ctx, -1), mu_file, mu_line, "")
                forge_llvm_build_unreachable(ctx.builder)
            }
            forge_llvm_position_at_end(ctx.builder, merge_bb)
            ok_stmt(env)
        }
        .Node(pattern, guard, body, next) -> {
            let body_bb = new_bb(ctx, "parm_body")
            let next_bb = new_bb(ctx, "parm_next")

            if is_literal_pattern(pattern) {
                let cmp = emit_literal_cmp(ctx, subj, pattern)
                if guard != null {
                    let lit_pass_bb = new_bb(ctx, "lit_guard")
                    forge_llvm_build_cond_br(ctx.builder, cmp, lit_pass_bb, next_bb)
                    forge_llvm_position_at_end(ctx.builder, lit_pass_bb)
                    let guard_r = emit_expr(ctx, env, guard!.node)
                    if guard_r.had_error { return err_stmt_from_expr(guard_r) }
                    let guard_bool = forge_llvm_build_icmp(ctx.builder, 33, guard_r.value, const_i64(ctx, 0), "pguard")
                    forge_llvm_build_cond_br(ctx.builder, guard_bool, body_bb, next_bb)
                } else {
                    forge_llvm_build_cond_br(ctx.builder, cmp, body_bb, next_bb)
                }
            } else if guard != null {
                let guard_r = emit_expr(ctx, env, guard!.node)
                if guard_r.had_error { return err_stmt_from_expr(guard_r) }
                let guard_bool = forge_llvm_build_icmp(ctx.builder, 33, guard_r.value, const_i64(ctx, 0), "pguard")
                forge_llvm_build_cond_br(ctx.builder, guard_bool, body_bb, next_bb)
            } else {
                forge_llvm_build_br(ctx.builder, body_bb)
            }

            forge_llvm_position_at_end(ctx.builder, body_bb)
            let body_r = emit_expr(ctx, env, body.node)
            if body_r.had_error { return err_stmt_from_expr(body_r) }
            if forge_llvm_block_has_terminator(ctx.builder) == 0 {
                forge_llvm_build_br(ctx.builder, merge_bb)
            }

            forge_llvm_position_at_end(ctx.builder, next_bb)
            emit_primitive_arms_stmt(ctx, env, subj, next, merge_bb)
        }
    }
}
