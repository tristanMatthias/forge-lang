mod parser
mod codegen
mod resolver
mod typeck
use codegen.types.{err_emit, err_stmt}
use features.eval.{error_result}
use core.registry.{feature_new, register}
use resolve.{resolve_expr}
use features.match_expr.codegen.{emit_match, emit_match_expr}
use features.match_expr.resolver.{resolve_match_arms}
use features.match_expr.typeck.{check_match_arms, check_match_expr_arms, tc_check_exhaustive}
use typeck.{check_expr, tc_er}

export fn init_match_expr(reg: Registry) {
    let f = feature_new("match") with {
        expr_tag: Expr.MatchExpr(Expr.Null, MatchArmList.End),
        stmt_tag: Stmt.Match(Expr.Null, MatchArmList.End),
        emit_expr: (ctx: int, env, expr: Expr) -> match expr { .MatchExpr(subject, arms) -> emit_match_expr(ctx, env, subject, arms), _ -> err_emit("expected MatchExpr") },
        emit_stmt: (ctx: int, env, stmt: Stmt) -> match stmt { .Match(subject, arms) -> emit_match(ctx, env, subject, arms), _ -> err_stmt("expected Match") },
        resolve_stmt: (r: int, stmt: Stmt) -> match stmt {
            .Match(subject, arms) -> {
                let after_subject = resolve_expr(r, subject)
                resolve_match_arms(after_subject, arms)
            }
            _ -> r
        },
        resolve_expr: (r: int, expr: Expr) -> match expr {
            .MatchExpr(subject, arms) -> {
                let after_subject = resolve_expr(r, subject)
                resolve_match_arms(after_subject, arms)
            }
            _ -> r
        },
        check_stmt: match_check_stmt,
        check_expr: match_check_expr,
        eval_stmt: (rt: int, stmt: Stmt) -> match stmt {
            .Match(_, _) -> error_result(rt, "match statements are not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected Match")
        },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .MatchExpr(_, _) -> error_result(rt, "match expressions are not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected MatchExpr")
        },
        stmt_keyword: "kw_match",
        parse_stmt: (p: Parser) -> p.parse_match_statement(),
    }
    register(reg, f)
}

fn match_check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Match(subject, arms) -> {
            let s = check_expr(tc, subject)
            let checked = tc_check_exhaustive(s.tc, s.ty, arms)
            check_match_arms(checked, arms)
        }
        _ -> tc
    }
}

fn match_check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .MatchExpr(subject, arms) -> {
            let s = check_expr(tc, subject)
            let checked = tc_check_exhaustive(s.tc, s.ty, arms)
            check_match_expr_arms(checked, arms, .Int)
        }
        _ -> tc_er(tc, .Int)
    }
}
