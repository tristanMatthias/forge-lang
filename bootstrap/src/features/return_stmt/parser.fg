// WHY: parses the `return` statement, both with and without a value.

use core.ast.{Stmt}
use parse.{Parser}

impl Parser {
    fn parse_return_statement(self) -> Stmt? {
        self.advance()

        if self.check("right_brace") || self.check("eof") {
            return Stmt.ReturnEmpty
        }

        let value = self.parse_expression()?
        Stmt.Return(value)
    }
}
