// WHY: trait conformance checking — verifies impl blocks provide all required methods.

use core.ast.{Stmt, StmtList, SStmt, ParamList, param_list_length}
use diagnostics.{DiagCode}
use typeck.{TC, tc_report, TraitRegistry, TraitMethodList, TraitAssocTypes, trait_lookup, trait_has, trait_assoc_types, tc_owns_type}

export fn check_trait_conformance(tc: TC, impl_name: string, methods: StmtList) -> TC {
    let colon_idx = impl_name.index_of(":")
    if colon_idx < 0 { return tc }

    let trait_name = impl_name.substring(0, colon_idx)
    let type_name = impl_name.substring(colon_idx + 1, impl_name.length)

    // Orphan rule (spec Axis 16.5): you can only `impl Trait for Type`
    // if you own either the Trait or the Type. In practice this means
    // at least one must be defined in the current compilation unit.
    let owns_trait = trait_has(tc.traits, trait_name)
    let owns_type = tc_owns_type(tc, type_name)
    if !owns_trait && !owns_type {
        return tc_report(tc, DiagCode.OrphanImpl, "orphan impl: neither trait `${trait_name}` nor type `${type_name}` is defined in this compilation unit")
    }

    if !owns_trait {
        return tc_report(tc, DiagCode.TypeMismatch, "unknown trait `${trait_name}`")
    }

    let required = trait_lookup(tc.traits, trait_name)
    let after_methods = check_required_methods(tc, trait_name, type_name, required, methods)
    // Check associated types are provided
    let required_assoc = trait_assoc_types(tc.traits, trait_name)
    check_required_assoc_types(after_methods, trait_name, type_name, required_assoc, methods)
}

fn check_required_assoc_types(tc: TC, trait_name: string, type_name: string, required: TraitAssocTypes, impl_stmts: StmtList) -> TC {
    match required {
        .End -> tc
        .Node(name, next) -> {
            if !impl_has_assoc_type(impl_stmts, name) {
                let after = tc_report(tc, DiagCode.TypeMismatch, "trait `${trait_name}` requires associated type `${name}` but `${type_name}` does not define it")
                check_required_assoc_types(after, trait_name, type_name, next, impl_stmts)
            } else {
                check_required_assoc_types(tc, trait_name, type_name, next, impl_stmts)
            }
        }
    }
}

fn impl_has_assoc_type(stmts: StmtList, name: string) -> bool {
    match stmts {
        .End -> false
        .Node(ss, next) -> {
            match ss.node {
                .AssocType(n, ty, _) if n == name && ty != "" -> true
                _ -> impl_has_assoc_type(next, name)
            }
        }
    }
}

fn check_required_methods(tc: TC, trait_name: string, type_name: string, required: TraitMethodList, impl_methods: StmtList) -> TC {
    match required {
        .End -> tc
        .Node(name, expected_params, expected_ret, next) -> {
            let mangled = "${type_name}__${name}"
            if !impl_has_method(impl_methods, mangled) {
                let after = tc_report(tc, DiagCode.TypeMismatch, "trait `${trait_name}` requires method `${name}` but `${type_name}` does not implement it")
                check_required_methods(after, trait_name, type_name, next, impl_methods)
            } else {
                // Check parameter count matches (including self)
                let actual_params = impl_method_param_count(impl_methods, mangled)
                let after = if actual_params >= 0 && actual_params != expected_params {
                    tc_report(tc, DiagCode.TypeMismatch, "method `${name}` in `impl ${trait_name} for ${type_name}` has ${string(actual_params)} parameters but trait requires ${string(expected_params)}")
                } else { tc }
                check_required_methods(after, trait_name, type_name, next, impl_methods)
            }
        }
    }
}

fn impl_method_param_count(methods: StmtList, name: string) -> int {
    match methods {
        .End -> -1
        .Node(ss, next) -> {
            match ss.node {
                .Function(fn_name, _, params, _, _) if fn_name == name -> param_list_length(params)
                _ -> impl_method_param_count(next, name)
            }
        }
    }
}

fn impl_has_method(methods: StmtList, name: string) -> bool {
    match methods {
        .End -> false
        .Node(ss, next) -> {
            match ss.node {
                .Function(fn_name, _, _, _, _) if fn_name == name -> true
                _ -> impl_has_method(next, name)
            }
        }
    }
}

export fn collect_method_names_from_stmts(stmts: StmtList) -> TraitMethodList {
    match stmts {
        .End -> TraitMethodList.End
        .Node(ss, next) -> {
            match ss.node {
                .ExternFn(name, params, _) -> TraitMethodList.Node(name, param_list_length(params), "", collect_method_names_from_stmts(next))
                _ -> collect_method_names_from_stmts(next)
            }
        }
    }
}

export fn collect_assoc_types_from_stmts(stmts: StmtList) -> TraitAssocTypes {
    match stmts {
        .End -> TraitAssocTypes.End
        .Node(ss, next) -> {
            match ss.node {
                .AssocType(name, _, _) -> TraitAssocTypes.Node(name, collect_assoc_types_from_stmts(next))
                _ -> collect_assoc_types_from_stmts(next)
            }
        }
    }
}

fn method_list_has(list: TraitMethodList, name: string) -> bool {
    match list {
        .End -> false
        .Node(n, _, _, _) if n == name -> true
        .Node(_, _, _, next) -> method_list_has(next, name)
    }
}
