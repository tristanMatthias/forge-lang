// WHY: codegen for trait dynamic dispatch.

use core.ast.{Expr, ExprList, VarEnv, ValueType, vtype_display, vtype_struct_name, vtype_enum_name, expr_list_length}
use codegen.types.{Ctx, EmitValue, TraitMethodNames, ok_emit_typed, err_emit, translate_type_ctx, trait_decl_lookup}
use features.fn_decl.codegen.{emit_first_arg}

export fn trait_method_idx(methods: TraitMethodNames, name: string, idx: int) -> int {
    match methods {
        .End -> 0 - 1
        .Node(n, _, _) if n == name -> idx
        .Node(_, _, next) -> trait_method_idx(next, name, idx + 1)
    }
}

export fn trait_method_ret_ty(methods: TraitMethodNames, name: string) -> string {
    match methods {
        .End -> ""
        .Node(n, ret, _) if n == name -> ret
        .Node(_, _, next) -> trait_method_ret_ty(next, name)
    }
}

export fn emit_trait_dispatch(ctx: Ctx, env: VarEnv, obj_val: ptr, trait_name: string, method: string, args: ExprList) -> Result<EmitValue, string> {
    let obj_ptr = ctx.to_ptr(obj_val, "tobj_ptr")
    let concrete = ctx.call("forge_trait_object_value", [obj_ptr])
    let vtable = ctx.call("forge_trait_object_vtable", [obj_ptr])
    let methods = trait_decl_lookup(ctx.trait_decls, trait_name)
    let idx = trait_method_idx(methods, method, 0)
    if idx < 0 {
        return err_emit("trait has no method `${method}`")
    }
    // Determine return type from trait declaration
    let ret_ty_str = trait_method_ret_ty(methods, method)
    let ret_ty = translate_type_ctx(ctx, ret_ty_str)
    let fn_closure = ctx.array_get(vtable, ctx.i64(idx))
    let user_count = expr_list_length(args)
    if user_count == 0 {
        return ok_emit_typed(ctx.call("forge_closure_call_1", [fn_closure, concrete]), ret_ty)
    }
    // 1-arg case
    let first_arg = emit_first_arg(ctx, env, args)?
    ok_emit_typed(ctx.call("forge_closure_call_2", [fn_closure, concrete, first_arg.value]), ret_ty)
}

export fn resolve_concrete_type_name(ty: ValueType) -> string {
    let s = vtype_struct_name(ty)
    if s != "" { return s }
    let e = vtype_enum_name(ty)
    if e != "" { return e }
    ""
}

export fn box_for_trait(ctx: Ctx, value: ptr, trait_name: string, concrete_name: string) -> ptr {
    let methods = trait_decl_lookup(ctx.trait_decls, trait_name)
    let vtable = ctx.array_new()
    push_vtable_entries_call(ctx, vtable, methods, concrete_name)
    let obj_val = ctx.call("forge_trait_object_new", [value, vtable])
    ctx.to_i64(obj_val, "tobj_i64")
}

export fn push_vtable_entries_call(ctx: Ctx, vtable: ptr, methods: TraitMethodNames, concrete_name: string) {
    match methods {
        .End -> {}
        .Node(method_name, _, next) -> {
            let mangled = "${concrete_name}__${method_name}"
            let fn_val = ctx.get_fn(mangled)
            let fn_i64 = ctx.ptr_to_int(fn_val, "vfn_ptr")
            let closure = ctx.closure_array(fn_i64)
            ctx.array_push(vtable, ctx.to_i64(closure, "vcl_i64"))
            push_vtable_entries_call(ctx, vtable, next, concrete_name)
        }
    }
}

