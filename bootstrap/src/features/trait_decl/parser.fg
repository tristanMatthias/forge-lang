// WHY: parses `trait Name { fn method(self) -> Type ... }` declarations.
// Methods are stored as ExternFn statements (signatures only, no body).
// The trait declaration itself is a no-op at codegen — the methods
// are implemented by `impl Trait for Type { ... }` blocks.

use core.ast.{Stmt, StmtList, ParamList, TypeParamList, SStmt, sstmt}
use parse.{Parser}
use core.ast.{Tk}

impl Parser {
    fn parse_trait_declaration(self) -> Stmt? {
        self.advance()  // consume `trait`
        let name = self.consume_identifier("expected trait name")?
        // Optional generic parameters: trait Name<T> { ... }
        if self.check(Tk.Less) {
            self.skip_angle_brackets()
        }
        if !self.consume(Tk.LeftBrace, "expected `{` after trait name") {
            return null
        }
        let methods = self.parse_trait_methods()?
        if !self.consume(Tk.RightBrace, "expected `}` after trait body") {
            return null
        }
        Stmt.TraitDecl(name, methods)
    }

    // Parse method signatures inside a trait body. Each method is
    // stored as an ExternFn (name, params, ret_ty) — they have no body.
    fn parse_trait_methods(self) -> StmtList? {
        if self.check(Tk.RightBrace) {
            return StmtList.End
        }
        let method = self.parse_trait_method_sig()?
        let rest = self.parse_trait_methods()?
        StmtList.Node(sstmt(method, self.current_line, self.current_column), rest)
    }

    fn parse_trait_method_sig(self) -> Stmt? {
        if !self.consume(Tk.KwFn, "expected `fn` in trait method") {
            return null
        }
        let name = self.consume_identifier("expected method name")?
        // Optional generic parameters on the method itself
        if self.check(Tk.Less) {
            self.skip_angle_brackets()
        }
        if !self.consume(Tk.LeftParen, "expected `(` after method name") {
            return null
        }
        let params = self.parse_param_list()?
        if !self.consume(Tk.RightParen, "expected `)` after parameters") {
            return null
        }
        let ret_ty = if self.check(Tk.Arrow) {
            self.advance()
            let r = self.consume_type("expected return type after `->`")?
            r
        } else {
            ""
        }
        // Default method: if there's a body `{ ... }`, parse it as a Function.
        // Otherwise it's a signature only (ExternFn).
        if self.check(Tk.LeftBrace) {
            self.advance()
            let body = self.parse_statement_list(true)?
            if !self.consume(Tk.RightBrace, "expected `}` after default method body") {
                return null
            }
            return Stmt.Function(name, TypeParamList.End, params, ret_ty, body)
        }
        Stmt.ExternFn(name, params, ret_ty)
    }
}
