/// expect: result: 5
/// expect: chained: 10

fn add(a: int, b: int) -> int {
    a + b
}

fn main() {
    // dbg returns the value — can be used inline
    let x = dbg(add(2, 3))
    println("result: ${string(x)}")

    // dbg in a chain
    let y = dbg(x) + dbg(x)
    println("chained: ${string(y)}")
}
