// WHY: codegen for `expr in [a, b, c]` — expands to `expr == a || expr == b || expr == c`.
// Uses emit_binary(Eq) for each comparison so enum tags, strings, etc. are handled correctly.

use codegen.{emit_expr}
use codegen.types.{Ctx, EmitResult, ok_emit, err_emit, const_i64}
use codegen.operators.{emit_binary}
use core.ast.{Expr, ExprList, BinOp, VarEnv, ValueType, vtype_is_str}

export fn emit_in_check(ctx: Ctx, env: VarEnv, needle: Expr, items: ExprList) -> EmitResult {
    emit_in_items(ctx, env, needle, items)
}

fn emit_in_items(ctx: Ctx, env: VarEnv, needle: Expr, items: ExprList) -> EmitResult {
    match items {
        .End -> ok_emit(ctx.i64(0))
        .Node(item, next) -> {
            let cmp = emit_binary(ctx, env, needle, BinOp.Eq, item.node)?
            let rest = emit_in_items(ctx, env, needle, next)?
            ok_emit(ctx.build_or(cmp.value, rest.value, "in_or"))
        }
    }
}
