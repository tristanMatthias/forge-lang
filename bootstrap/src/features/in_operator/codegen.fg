// WHY: codegen for `expr in [a, b, c]` — expands to `expr == a || expr == b || expr == c`.
// Uses emit_binary(Eq) for each comparison so enum tags, strings, etc. are handled correctly.

use codegen.types.{Ctx, EmitValue, ok_emit}
use codegen.operators.{emit_binary}
use core.ast.{Expr, ExprList, BinOp, VarEnv}

export fn emit_in_check(ctx: Ctx, env: VarEnv, needle: Expr, items: ExprList) -> Result<EmitValue, string> {
    emit_in_items(ctx, env, needle, items)
}

fn emit_in_items(ctx: Ctx, env: VarEnv, needle: Expr, items: ExprList) -> Result<EmitValue, string> {
    match items {
        .End -> ok_emit(ctx.i64(0))
        .Node(item, next) -> {
            let cmp = emit_binary(ctx, env, needle, BinOp.Eq, item.node)?
            let rest = emit_in_items(ctx, env, needle, next)?
            ok_emit(ctx.bit_or(cmp.value, rest.value, "in_or"))
        }
    }
}
