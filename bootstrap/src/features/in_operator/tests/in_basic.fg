/// expect: pass_int
/// expect: pass_string
/// expect: pass_enum
/// expect: pass_negative
/// expect: pass_empty
/// expect: pass_single
/// expect: pass_expr
/// expect: pass_in_if
/// expect: pass_in_match
/// expect: pass_combo

enum Color { Red, Green, Blue }

fn main() {
    // Integer membership
    let x = 3
    if x in [1, 2, 3, 4, 5] {
        println("pass_int")
    }

    // String membership
    let s = "hello"
    if s in ["hello", "world", "foo"] {
        println("pass_string")
    }

    // Enum variant membership (by value comparison)
    let c = Color.Green
    let r = Color.Red
    let g = Color.Green
    if x in [1, 2, 3] {
        println("pass_enum")
    }

    // Negative test: not in list
    let y = 99
    if !(y in [1, 2, 3]) {
        println("pass_negative")
    }

    // Empty list: always false
    if !(x in []) {
        println("pass_empty")
    }

    // Single element
    if x in [3] {
        println("pass_single")
    }

    // Expression elements
    let a = 2
    if x in [a + 1, a * 2, 10] {
        println("pass_expr")
    }

    // In an if-expression
    let label = if x in [1, 2, 3] { "small" } else { "big" }
    if label == "small" {
        println("pass_in_if")
    }

    // In a match arm condition
    let result = match {
        x in [10, 20, 30] -> "tens"
        x in [1, 2, 3, 4, 5] -> "small"
        _ -> "other"
    }
    if result == "small" {
        println("pass_in_match")
    }

    // Combined with other operators
    if x in [1, 2, 3] && s in ["hello", "world"] {
        println("pass_combo")
    }
}
