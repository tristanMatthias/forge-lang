mod parser
mod codegen

export fn register_defer_stmt(reg: Registry) -> Registry {
    register_feature(reg, stmt_feature("defer", 21, defer_emit_stmt))
}

fn defer_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Defer(body) -> {
            defer_push(sexpr_dummy(body))
            ok_stmt(env)
        }
        _ -> err_stmt("expected Defer")
    }
}
