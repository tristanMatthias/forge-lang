// WHY: parses `defer { ... }` and `defer expr` statements.
// Deferred code runs when the enclosing function returns.

use core.ast.{Stmt, Expr}
use parse.{Parser}

impl Parser {
    fn parse_defer_statement(self) -> Stmt? {
        self.advance()  // consume 'defer'
        let body = self.parse_expression()?
        Stmt.Defer(body)
    }
}
