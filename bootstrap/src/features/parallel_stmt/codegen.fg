// WHY: codegen for `parallel { fn1(); fn2(); fn3() }`.
// Each expression in the block is treated as a callable. All are
// spawned in parallel threads via forge_parallel_run.

use codegen.{emit_expr}
use core.cg.{call_0, call_1, call_2, err_stmt, get_fn, ok_stmt}
export fn parallel_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Parallel(body) -> emit_parallel(ctx, env, body)
        _ -> err_stmt("parallel_emit_stmt: expected Parallel")
    }
}

fn emit_parallel(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {
    // Build array of closures from each statement
    let arr_fn = get_fn(ctx, "forge_array_new")
    let push_fn = get_fn(ctx, "forge_array_push")
    let closures = call_0(ctx, arr_fn, "par_closures")

    let r = collect_parallel_closures(ctx, env, stmts, closures, push_fn)
    if r.had_error { return r }

    // Run all in parallel
    call_1(ctx, get_fn(ctx, "forge_parallel_run"), closures, "")
    ok_stmt(env)
}

fn collect_parallel_closures(ctx: Ctx, env: VarEnv, stmts: StmtList, arr: ptr, push_fn: ptr) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(ss, next) -> {
            // Each statement should be an Expr that evaluates to a callable.
            // Emit the expression and push the result as a closure.
            match ss.node {
                .Expr(expr) -> {
                    let r = emit_expr(ctx, env, expr)
                    if r.had_error { return err_stmt(r.error_message) }
                    call_2(ctx, push_fn, arr, r.value, "")
                    collect_parallel_closures(ctx, env, next, arr, push_fn)
                }
                _ -> {
                    // Non-expression statements: skip with warning
                    collect_parallel_closures(ctx, env, next, arr, push_fn)
                }
            }
        }
    }
}
