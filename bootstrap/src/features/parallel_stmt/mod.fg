mod codegen

fn kw_parse_parallel(p: Parser) -> Stmt? {
    p.parse_parallel_statement()
}

export fn init_parallel_stmt(reg: Registry) {
    let f = feature_new("parallel") with {
        stmt_tag: Stmt.Parallel(StmtList.End),
        emit_stmt: parallel_emit_stmt,
        decl_keyword: "kw_parallel",
        parse_decl: kw_parse_parallel,
    }
    register(reg, f)
}
