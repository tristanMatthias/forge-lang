// WHY: emits LLVM IR for `let` and `mut` variable bindings.
// Handles trait boxing: `let d: Describable = Circle { ... }` creates
// a trait object with a vtable for dynamic dispatch.

use core.ast.{Expr, ValueType, VarEnv, vtype_trait_name, vtype_struct_name, vtype_enum_name, field_list_length}
use codegen.types.{Ctx, ok_stmt, translate_type_ctx, vtype_is_copy, releasable_has}
use features.trait_decl.codegen.{box_for_trait}
use features.union_type.codegen.{emit_union_wrap, needs_union_wrap}

export fn emit_var_decl(ctx: Ctx, env: VarEnv, name: string, ty_annotation: string, initializer: Expr) -> Result<VarEnv, string> {
    // Copy-type stack allocation (spec 9.12): if the initializer is
    // a struct literal, the type is Copy, and the local is releasable
    // (non-escaping), pre-allocate a stack buffer and pass it through
    // Ctx so emit_struct_lit writes directly into it. No heap alloc needed.
    let copy_target = try_copy_stack_target(ctx, name, ty_annotation, initializer)
    let emit_ctx = if copy_target.active {
        ctx with { copy_alloc_target: copy_target.alloca_ptr }
    } else {
        ctx
    }
    let r = emit_ctx.emit(env, initializer)?
    // Use the type annotation when present, otherwise infer from initializer.
    let var_ty = if ty_annotation != "" {
        translate_type_ctx(ctx, ty_annotation)
    } else {
        r.ty
    }
    // Trait boxing: `let d: Trait = concrete_value`
    let trait_name = vtype_trait_name(var_ty)
    if trait_name != "" {
        let concrete_name = resolve_concrete_name(r.ty)
        if concrete_name != "" {
            let obj_i64 = box_for_trait(ctx, r.value, trait_name, concrete_name)
            return ok_stmt(ctx.bind(env, name, obj_i64, var_ty))
        }
    }
    // Union wrapping: `let x: int | string = 42` → wrap into discriminated union
    if needs_union_wrap(r.ty, var_ty) {
        let wrapped = emit_union_wrap(ctx, r.value, r.ty, var_ty)?
        return ok_stmt(ctx.bind(env, name, wrapped.value, var_ty))
    }
    // For Copy-type stack allocations, bind without RC cleanup.
    // The struct data is on the stack — no heap free needed.
    if copy_target.active {
        let sn = vtype_struct_name(var_ty)
        if sn != "" {
            return ok_stmt(ctx.bind_copy_stack(env, name, r.value, var_ty, sn))
        }
    }
    ok_stmt(ctx.bind(env, name, r.value, var_ty))
}

type CopyTarget = { active: bool, alloca_ptr: ptr }

fn try_copy_stack_target(ctx: Ctx, name: string, ty_ann: string, init: Expr) -> CopyTarget {
    let n: ptr = null
    if !releasable_has(ctx.rc_releasable, name) {
        return CopyTarget { active: false, alloca_ptr: n }
    }
    match init {
        .StructLit(sname, _) -> try_copy_for_struct(ctx, name, ty_ann, sname)
        .With(_, _) -> {
            // `with` expressions produce the same struct type as the source.
            // The type annotation tells us the struct name.
            if ty_ann != "" {
                let var_ty = translate_type_ctx(ctx, ty_ann)
                let sname = vtype_struct_name(var_ty)
                if sname != "" {
                    return try_copy_for_struct(ctx, name, ty_ann, sname)
                }
            }
            CopyTarget { active: false, alloca_ptr: n }
        }
        _ -> CopyTarget { active: false, alloca_ptr: n }
    }
}

fn try_copy_for_struct(ctx: Ctx, name: string, ty_ann: string, sname: string) -> CopyTarget {
    let n: ptr = null
    let var_ty = if ty_ann != "" { translate_type_ctx(ctx, ty_ann) } else { ValueType.Struct(sname) }
    if vtype_is_copy(var_ty, ctx.copy_types) {
        let st_ty = ctx.get_type(sname)
        if st_ty != null {
            let buf = ctx.alloca(st_ty, "${name}_copy")
            return CopyTarget { active: true, alloca_ptr: buf }
        }
    }
    CopyTarget { active: false, alloca_ptr: n }
}

// Resolve the concrete type name from a ValueType.
fn resolve_concrete_name(ty: ValueType) -> string {
    let s = vtype_struct_name(ty)
    if s != "" { return s }
    let e = vtype_enum_name(ty)
    if e != "" { return e }
    ""
}

// build_vtable and push_vtable_entries removed — use box_for_trait from codegen/mod.fg
