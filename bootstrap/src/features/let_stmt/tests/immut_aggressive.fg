// Immutability: mut in various scopes
mut global_counter = 0

fn increment() -> int {
    global_counter = global_counter + 1
    global_counter
}

println(string(increment()))
println(string(increment()))
println(string(increment()))

// mut inside loop
mut total = 0
for i in 0..10 {
    mut local = i * i
    local = local + 1
    total = total + local
}
total |> string |> println

// let in nested blocks — inner shadow doesn't affect outer
let x = 100
{
    let x = 200
    {
        let x = 300
        x |> string |> println
    }
    x |> string |> println
}
x |> string |> println

// mut struct fields (field assign is separate from variable immutability)
type Counter = { value: int }
let c = Counter { value: 0 }
c.value = 42
c.value |> string |> println

// mut in match arms
enum Action { Inc(n: int), Dec(n: int), Reset }
mut acc = 50
let actions = [Action.Inc(10), Action.Dec(3), Action.Inc(7), Action.Reset, Action.Inc(5)]
for a in actions {
    match a {
        .Inc(n) -> { acc = acc + n }
        .Dec(n) -> { acc = acc - n }
        .Reset -> { acc = 0 }
    }
}
acc |> string |> println

// mut with closures
mut sum = 0
[1, 2, 3, 4, 5].foreach((x) -> {
    sum = sum + x
})
sum |> string |> println

// mut with with-expression (original unchanged)
type Point = { x: int, y: int }
let p = Point { x: 1, y: 2 }
let p2 = p with { x: 99 }
p.x |> string |> println
p2.x |> string |> println

// mut with ?? and ?
fn maybe(x: int) -> int? {
    if x > 0 { return x }
    null
}
mut result = 0
result = maybe(42) ?? -1
result |> string |> println
result = maybe(-5) ?? -1
result |> string |> println
