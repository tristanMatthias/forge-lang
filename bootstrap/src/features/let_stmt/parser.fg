// WHY: parses `let`, `mut`, and `const` variable bindings.

use core.ast.{Stmt, ParamList, ValueType, type_expr_to_vtype}
use parse.{Parser}
use core.ast.{Tk}

impl Parser {
    fn parse_let_statement(self) -> Stmt? {
        self.advance()
        let is_mut = self.check(Tk.KwMut)
        if is_mut { self.advance() }
        if self.check(Tk.LeftParen) {
            return self.parse_let_destructure()
        }
        let name = self.consume_identifier("expected variable name")?
        mut ty_vt = ValueType.Unknown
        if self.check(Tk.Colon) {
            self.advance()
            let te = self.parse_type_expr("expected type after `:`")?
            ty_vt = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.Equal, "expected `=` after variable name") { return null }
        let initializer = self.parse_expression()?
        if is_mut { Stmt.Mut(name, ty_vt, initializer) } else { Stmt.Let(name, ty_vt, initializer) }
    }

    fn parse_mut_statement(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected variable name")?
        mut ty_vt = ValueType.Unknown
        if self.check(Tk.Colon) {
            self.advance()
            let te = self.parse_type_expr("expected type after `:`")?
            ty_vt = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.Equal, "expected `=` after variable name") { return null }
        let initializer = self.parse_expression()?
        Stmt.Mut(name, ty_vt, initializer)
    }

    fn parse_const_statement(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected constant name")?
        mut ty_vt = ValueType.Unknown
        if self.check(Tk.Colon) {
            self.advance()
            let te = self.parse_type_expr("expected type after `:`")?
            ty_vt = type_expr_to_vtype(te)
        }
        if !self.consume(Tk.Equal, "expected `=` after constant name") { return null }
        let initializer = self.parse_expression()?
        Stmt.Const(name, ty_vt, initializer)
    }

    fn parse_let_destructure(self) -> Stmt? {
        self.advance()
        let names = self.parse_destructure_names()?
        if !self.consume(Tk.RightParen, "expected `)` after destructure names") { return null }
        if !self.consume(Tk.Equal, "expected `=` after destructure pattern") { return null }
        let initializer = self.parse_expression()?
        Stmt.LetDestructure(names, initializer)
    }

    fn parse_destructure_names(self) -> ParamList? {
        if self.check(Tk.RightParen) { return ParamList.End }
        let name = self.consume_identifier("expected variable name in destructure")?
        if self.check(Tk.Comma) {
            self.advance()
            let rest = self.parse_destructure_names()?
            return ParamList.Node(name, ValueType.Int, rest)
        }
        ParamList.Node(name, ValueType.Int, ParamList.End)
    }
}
