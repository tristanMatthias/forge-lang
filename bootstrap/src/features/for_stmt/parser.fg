// WHY: parses `for variable in start..end { body }` (range)
// and `for variable in collection { body }` (for-in iteration).

use core.ast.{Stmt}
use parse.{Parser}
use diagnostics.{DiagCode}

impl Parser {
    fn parse_for_statement(self) -> Stmt? {
        self.advance()

        let name = self.consume_identifier("expected variable name after `for`")?

        if !self.consume("kw_in", "expected `in` after loop variable") {
            return null
        }

        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let expr = self.parse_expression()
        self.allow_struct_lit = saved
        if expr == null { return null }

        // Range form: `for x in start..end { body }`
        if self.check("dot_dot") {
            self.advance()
            let saved2 = self.allow_struct_lit
            self.allow_struct_lit = false
            let end = self.parse_expression()
            self.allow_struct_lit = saved2
            if end == null { return null }

            if !self.check("left_brace") {
                self.report(DiagCode.ExpectedBlock, "expected `{` after for range")
                return null
            }
            let body = self.parse_statement()?
            return Stmt.For(name, expr!, end!, body)
        }

        // Collection form: `for x in list { body }`
        if !self.check("left_brace") {
            self.report(DiagCode.ExpectedBlock, "expected `{` or `..` after for expression")
            return null
        }
        let body = self.parse_statement()?
        Stmt.ForIn(name, expr!, body)
    }
}
