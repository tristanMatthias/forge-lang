// WHY: emits LLVM IR for `for variable in start..end { body }` with
// break/continue support via the scoped loop stack in Ctx.

use core.ast.{Expr, Stmt, VarEnv, env_extend, ValueType, vtype_list_elem}
use codegen.types.{Ctx, LoopStack, StmtResult, call_1, call_2, const_i64, ctx_with_loops, err_stmt_from_expr, get_fn, new_bb, ok_stmt}
use codegen.{emit_expr, emit_stmt}

export fn emit_for(ctx: Ctx, env: VarEnv, variable: string, start: Expr, end: Expr, body: Stmt) -> StmtResult {
    // Evaluate start and end once, store in allocas
    let start_r = emit_expr(ctx, env, start)
    if start_r.had_error { return err_stmt_from_expr(start_r) }

    let end_r = emit_expr(ctx, env, end)
    if end_r.had_error { return err_stmt_from_expr(end_r) }

    let counter = ctx.alloca_i64(variable)
    ctx.store(start_r.value, counter)

    let end_alloca = ctx.alloca_i64("for_end")
    ctx.store(end_r.value, end_alloca)

    let body_env = env_extend(env, variable, counter, .Int)

    // Basic blocks: condition, body, increment, exit
    let cond_bb = new_bb(ctx, "for.cond")
    let body_bb = new_bb(ctx, "for.body")
    let incr_bb = new_bb(ctx, "for.incr")
    let exit_bb = new_bb(ctx, "for.exit")
    ctx.br(cond_bb)

    // Condition: counter < end
    ctx.position(cond_bb)
    let cur = ctx.load_i64(counter, variable)
    let lim = ctx.load_i64(end_alloca, "for_end_val")
    // icmp predicate 40 = SLT (signed less than)
    let cond_i1 = ctx.icmp(40, cur, lim, "for_cmp")
    ctx.cond_br(cond_i1, body_bb, exit_bb)

    // Body — continue jumps to incr_bb, break jumps to exit_bb
    ctx.position(body_bb)
    let body_ctx = ctx_with_loops(ctx, .Frame(incr_bb, exit_bb, ctx.loops))
    let body_result = emit_stmt(body_ctx, body_env, body)?
    ctx.br_if_open(incr_bb)

    // Increment: counter = counter + 1
    ctx.position(incr_bb)
    let old = ctx.load_i64(counter, variable)
    let one = const_i64(ctx, 1)
    let next = ctx.build_add(old, one, "for_next")
    ctx.store(next, counter)
    ctx.br(cond_bb)

    // Exit
    ctx.position(exit_bb)
    ok_stmt(env)
}

// for x in collection { body } — desugars to index-based iteration:
//   let __len = forge_array_len(collection)
//   for __i in 0..__len {
//       let x = forge_array_get(collection, __i)
//       body
//   }
export fn emit_for_in(ctx: Ctx, env: VarEnv, variable: string, collection: Expr, body: Stmt) -> StmtResult {
    let coll_r = emit_expr(ctx, env, collection)
    if coll_r.had_error { return err_stmt_from_expr(coll_r) }

    // Get length
    let len_val = call_1(ctx, get_fn(ctx, "forge_array_len"), coll_r.value, "forin_len")
    let len_alloca = ctx.alloca_i64("forin_len")
    ctx.store(len_val, len_alloca)

    // Counter alloca
    let counter = ctx.alloca_i64("forin_i")
    ctx.store(const_i64(ctx, 0), counter)

    // Element alloca — bind with the list's element type
    let elem_alloca = ctx.alloca_i64(variable)
    let body_env = env_extend(env, variable, elem_alloca, vtype_list_elem(coll_r.ty))

    // Basic blocks
    let cond_bb = new_bb(ctx, "forin.cond")
    let body_bb = new_bb(ctx, "forin.body")
    let incr_bb = new_bb(ctx, "forin.incr")
    let exit_bb = new_bb(ctx, "forin.exit")
    ctx.br(cond_bb)

    // Condition: counter < len
    ctx.position(cond_bb)
    let cur = ctx.load_i64(counter, "forin_i_val")
    let lim = ctx.load_i64(len_alloca, "forin_len_val")
    let cond_i1 = ctx.icmp(40, cur, lim, "forin_cmp")
    ctx.cond_br(cond_i1, body_bb, exit_bb)

    // Body: load element, then execute body
    ctx.position(body_bb)
    let elem = call_2(ctx, get_fn(ctx, "forge_array_get"), coll_r.value, cur, "forin_elem")
    ctx.store(elem, elem_alloca)

    let body_ctx = ctx_with_loops(ctx, .Frame(incr_bb, exit_bb, ctx.loops))
    let body_result = emit_stmt(body_ctx, body_env, body)?
    ctx.br_if_open(incr_bb)

    // Increment
    ctx.position(incr_bb)
    let old = ctx.load_i64(counter, "forin_i_old")
    let next = ctx.build_add(old, const_i64(ctx, 1), "forin_next")
    ctx.store(next, counter)
    ctx.br(cond_bb)

    // Exit
    ctx.position(exit_bb)
    ok_stmt(env)
}
