// For loop with break and continue
mut sum = 0
for i in 0..10 {
    if i == 7 {
        break
    }
    if i == 3 || i == 5 {
        continue
    }
    sum = sum + i
}
// 0 + 1 + 2 + 4 + 6 = 13
sum |> string |> println

// Nested for loops with break
mut found = 0
for i in 0..5 {
    for j in 0..5 {
        if i * 5 + j == 13 {
            found = i * 5 + j
            break
        }
    }
    if found > 0 {
        break
    }
}
found |> string |> println
