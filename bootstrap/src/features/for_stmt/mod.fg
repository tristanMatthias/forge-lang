mod parser
mod codegen

fn kw_parse_for(p: Parser) -> Stmt? {
    p.parse_for_statement()
}

export fn init_for_stmt(reg: Registry) {
    let f1 = feature_new("for") with {
        stmt_tag: Stmt.For("", Expr.Null, Expr.Null, Stmt.NoOp),
        emit_stmt: for_emit_stmt,
        stmt_keyword: "kw_for",
        parse_stmt: kw_parse_for,
    }
    register(reg, f1)

    let f2 = feature_new("for_in") with {
        stmt_tag: Stmt.ForIn("", Expr.Null, Stmt.NoOp),
        emit_stmt: for_in_emit_stmt,
    }
    register(reg, f2)
}

fn for_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt { .For(var, start, end, body) -> emit_for(ctx, env, var, start, end, body), _ -> err_stmt("expected For") }
}

fn for_in_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt { .ForIn(var, coll, body) -> emit_for_in(ctx, env, var, coll, body), _ -> err_stmt("expected ForIn") }
}
