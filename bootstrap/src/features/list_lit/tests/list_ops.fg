// List literals
let nums = [10, 20, 30]
println(string(nums.length))
println(string(nums[0]))
println(string(nums[1]))
println(string(nums[2]))

// Push
nums.push(40)
println(string(nums.length))
println(string(nums[3]))

// Pop
let last = nums.pop()
println(string(last))
println(string(nums.length))

// Empty list
let empty = []
println(string(empty.length))

// List in a loop
mut sum = 0
for i in 0..nums.length {
    sum = sum + nums[i]
}
println(string(sum))
