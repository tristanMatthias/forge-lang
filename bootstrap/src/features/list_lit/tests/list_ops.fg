// List literals
let nums = [10, 20, 30]
nums.length |> string |> println
nums[0] |> string |> println
nums[1] |> string |> println
nums[2] |> string |> println

// Push
nums.push(40)
nums.length |> string |> println
nums[3] |> string |> println

// Pop
let last = nums.pop()
last |> string |> println
nums.length |> string |> println

// Empty list
let empty = []
empty.length |> string |> println

// List in a loop
mut sum = 0
for i in 0..nums.length {
    sum = sum + nums[i]
}
sum |> string |> println
