// WHY: parses list literal expressions `[expr, expr, ...]`.

use core.ast.{Expr, ExprList, SExpr, sexpr}
use parse.{Parser}
use core.ast.{Tk}

impl Parser {
    fn parse_list_elements(self) -> ExprList? {
        let expr = self.parse_expression()?
        if self.check(Tk.Comma) {
            self.advance()
            if self.check(Tk.RightBracket) {
                // Trailing comma: [1, 2,]
                return ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
            }
            let rest = self.parse_list_elements()?
            return ExprList.Node(sexpr(expr, self.current_line, self.current_column), rest)
        }
        ExprList.Node(sexpr(expr, self.current_line, self.current_column), ExprList.End)
    }
}
