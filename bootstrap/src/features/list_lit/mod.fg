mod codegen

export fn init_list_lit(reg: Registry) {
    let f = feature_new("list_lit") with {
        expr_tag: Expr.ListLit(ExprList.End),
        emit_expr: list_emit,
    }
    register(reg, f)
}

fn list_emit(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    match expr { .ListLit(elements) -> emit_list_lit(ctx, env, elements), _ -> err_emit("expected ListLit") }
}
