mod codegen
mod typeck
use codegen.types.{err_emit}
use features.eval.{error_result}
use core.registry.{feature_new, register}
use resolve.{resolve_expr_list}
use features.list_lit.codegen.{emit_list_lit}
use features.list_lit.typeck.{check_list_lit}
use typeck.{tc_er}

export fn init_list_lit(reg: Registry) {
    let f = feature_new("list_lit") with {
        expr_tag: Expr.ListLit(ExprList.End),
        emit_expr: (ctx: int, env, expr: Expr) -> match expr { .ListLit(elements) -> emit_list_lit(ctx, env, elements), _ -> err_emit("expected ListLit") },
        resolve_expr: (r: int, expr: Expr) -> match expr { .ListLit(elements) -> resolve_expr_list(r, elements), _ -> r },
        check_expr: (tc: int, expr: Expr) -> match expr {
            .ListLit(elements) -> check_list_lit(tc, elements)
            _ -> tc_er(tc, .Int)
        },
        eval_expr: (rt: int, expr: Expr) -> match expr {
            .ListLit(_) -> error_result(rt, "list literals are not supported by the tree-walk evaluator")
            _ -> error_result(rt, "expected ListLit")
        },
    }
    register(reg, f)
}
