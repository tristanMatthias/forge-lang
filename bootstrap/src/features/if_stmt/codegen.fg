// WHY: emits LLVM IR for `if` as statement and expression.

use core.ast.{Expr, Stmt, VarEnv}
use codegen.types.{Ctx, EmitResult, StmtResult, ok_stmt, ok_emit_typed, err_stmt_from_expr}
use codegen.{emit_expr, emit_stmt}

export fn emit_if(ctx: Ctx, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> StmtResult {
    let cond = ctx.emit(env, condition)
    if cond.had_error { return err_stmt_from_expr(cond) }
    let merge_bb = ctx.bb("ifcont")
    let else_bb = ctx.if_true(cond.value, "if")

    let then_result = emit_stmt(ctx, env, then_branch)?
    ctx.br_if_open(merge_bb)

    ctx.position(else_bb)
    if else_branch != null {
        let else_result = emit_stmt(ctx, env, else_branch!)?
    }
    ctx.br_if_open(merge_bb)

    ctx.position(merge_bb)
    ok_stmt(env)
}

export fn emit_if_expr(ctx: Ctx, env: VarEnv, condition: Expr, then_branch: Expr, else_branch: Expr) -> EmitResult {
    let cond = ctx.emit(env, condition)?
    let merge_bb = ctx.bb("ife_end")
    let else_bb = ctx.if_true(cond.value, "ife")

    let t = ctx.emit(env, then_branch)?
    let t_val = ctx.cast_to(t.value, t.ty)
    let then_end = ctx.current_bb()
    ctx.br_if_open(merge_bb)

    ctx.position(else_bb)
    let e = ctx.emit(env, else_branch)?
    let e_val = ctx.cast_to(e.value, t.ty)
    let else_end = ctx.current_bb()
    ctx.br_if_open(merge_bb)

    ctx.position(merge_bb)
    let phi = ctx.phi_for(t.ty, "ife_val")
    ctx.add_incoming(phi, t_val, then_end)
    ctx.add_incoming(phi, e_val, else_end)
    ok_emit_typed(phi, t.ty)
}
