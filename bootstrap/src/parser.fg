use ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, Pattern, MatchArmList}

export type ParseResult = {
    expr: Expr?,
    had_error: bool,
    error_message: string,
}

export type ProgramParseResult = {
    stmts: StmtList?,
    had_error: bool,
    error_message: string,
}

export type Parser = {
    source: string,
    mut start: int,
    mut current: int,
    mut line: int,
    mut column: int,
    mut current_kind: string,
    mut current_lexeme: string,
    mut current_line: int,
    mut current_column: int,
    mut had_error: bool,
    mut error_message: string,
    // When false, `Ident { ... }` is parsed as Ident followed by a
    // separate block (used inside `if`/`while` conditions to avoid
    // grabbing the loop body brace as a struct literal). When true,
    // `Ident { ... }` becomes a struct literal expression.
    mut allow_struct_lit: bool,
    // When false, parse_call's loop won't consume `.` as a postfix.
    // Disabled inside match-arm bodies so the next sibling pattern
    // (e.g. `.Variant(x)`) isn't gobbled into the previous body.
    mut allow_dot_postfix: bool,
}

export fn parse_expression_source(source: string) -> ParseResult {
    mut parser = parser_new(source)
    parser.parse_file_expression()
}

export fn parse_program_source(source: string) -> ProgramParseResult {
    mut parser = parser_new(source)
    parser.parse_file_program()
}

fn is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

fn is_alpha(ch: string) -> bool {
    (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

fn is_alpha_numeric(ch: string) -> bool {
    is_alpha(ch) || is_digit(ch)
}

fn starts_with_upper_p(name: string) -> bool {
    if name.length < 1 {
        return false
    }
    let head = name.substring(0, 1)
    head >= "A" && head <= "Z"
}

fn keyword_kind(text: string) -> string {
    if text == "else" { return "kw_else" }
    if text == "false" { return "kw_false" }
    if text == "fn" { return "kw_fn" }
    if text == "if" { return "kw_if" }
    if text == "let" { return "kw_let" }
    if text == "mut" { return "kw_mut" }
    if text == "null" { return "kw_null" }
    if text == "return" { return "kw_return" }
    if text == "true" { return "kw_true" }
    if text == "while" { return "kw_while" }
    if text == "type" { return "kw_type" }
    if text == "enum" { return "kw_enum" }
    if text == "match" { return "kw_match" }
    if text == "export" { return "kw_export" }
    if text == "use" { return "kw_use" }
    if text == "mod" { return "kw_mod" }
    if text == "impl" { return "kw_impl" }
    if text == "extern" { return "kw_extern" }
    return "identifier"
}

export fn parser_new(source: string) -> Parser {
    mut parser = Parser {
        source,
        start: 0,
        current: 0,
        line: 1,
        column: 1,
        current_kind: "",
        current_lexeme: "",
        current_line: 1,
        current_column: 1,
        had_error: false,
        error_message: "",
        allow_struct_lit: true,
        allow_dot_postfix: true,
    }
    parser.advance_token()
    parser
}

impl Parser {
    fn parse_file_expression(self) -> ParseResult {
        let expr = self.parse_expression()
        if expr == null {
            return ParseResult {
                expr: null,
                had_error: self.had_error,
                error_message: self.error_message,
            }
        }

        if !self.check("eof") {
            self.set_error("expected end of input")
            return ParseResult {
                expr: null,
                had_error: true,
                error_message: self.error_message,
            }
        }

        ParseResult {
            expr,
            had_error: self.had_error,
            error_message: self.error_message,
        }
    }

    fn parse_file_program(self) -> ProgramParseResult {
        let stmts = self.parse_statement_list(false)
        if stmts == null {
            return ProgramParseResult {
                stmts: null,
                had_error: self.had_error,
                error_message: self.error_message,
            }
        }

        if !self.check("eof") {
            self.set_error("expected end of input")
            return ProgramParseResult {
                stmts: null,
                had_error: true,
                error_message: self.error_message,
            }
        }

        ProgramParseResult {
            stmts,
            had_error: self.had_error,
            error_message: self.error_message,
        }
    }

    fn parse_statement_list(self, stop_at_right_brace: bool) -> StmtList? {
        if stop_at_right_brace && self.check("right_brace") {
            return StmtList.End
        }

        if self.check("eof") {
            return StmtList.End
        }

        if !stop_at_right_brace && self.check("right_brace") {
            self.set_error("unexpected `}`")
            return null
        }

        let stmt = self.parse_declaration()
        if stmt == null { return null }

        let next = self.parse_statement_list(stop_at_right_brace)
        if next == null { return null }

        StmtList.Node(stmt!, next!)
    }

    fn parse_declaration(self) -> Stmt? {
        // `export` is currently a no-op modifier — every top-level
        // declaration is reachable from main, so the visibility tag
        // is irrelevant for single-file MVP compilation. Recorded
        // here so bootstrap source files parse cleanly.
        if self.check("kw_export") {
            self.advance()
        }

        // `use ...` and `mod ...` parse to NoOp. Multi-file modules
        // aren't supported yet — we expect every file the bootstrap
        // compiles to be self-contained.
        if self.check("kw_use") {
            return self.parse_use_or_mod_skip()
        }
        if self.check("kw_mod") {
            return self.parse_use_or_mod_skip()
        }

        if self.check("kw_fn") {
            return self.parse_function_declaration()
        }

        if self.check("kw_let") {
            return self.parse_let_statement()
        }

        if self.check("kw_mut") {
            return self.parse_mut_statement()
        }

        if self.check("kw_type") {
            return self.parse_type_declaration()
        }

        if self.check("kw_enum") {
            return self.parse_enum_declaration()
        }

        if self.check("kw_impl") {
            return self.parse_impl_declaration()
        }

        if self.check("kw_extern") {
            return self.parse_extern_declaration()
        }

        self.parse_statement()
    }

    fn parse_extern_declaration(self) -> Stmt? {
        self.advance()
        if !self.consume("kw_fn", "expected `fn` after `extern`") {
            return null
        }
        let name = self.consume_identifier("expected extern fn name")
        if name == null { return null }
        if !self.consume("left_paren", "expected `(` after extern fn name") {
            return null
        }
        let params = self.parse_param_list()
        if params == null { return null }
        if !self.consume("right_paren", "expected `)` after parameters") {
            return null
        }
        if self.check("arrow") {
            self.advance()
            let _ret = self.consume_type("expected return type after `->`")
            if _ret == null { return null }
        }
        Stmt.ExternFn(name!, params!)
    }

    fn parse_use_or_mod_skip(self) -> Stmt? {
        // Skip everything until we hit a top-level token that
        // could start a new declaration. This is intentionally
        // lazy — `use ast.{a, b, c}` and `mod foo` both
        // disappear into the void.
        self.advance()
        while !self.check("eof") {
            if self.check("kw_fn") || self.check("kw_let") || self.check("kw_mut") || self.check("kw_type") || self.check("kw_enum") || self.check("kw_impl") || self.check("kw_export") || self.check("kw_use") || self.check("kw_mod") || self.check("kw_if") || self.check("kw_while") || self.check("kw_match") || self.check("kw_return") {
                break
            }
            self.advance()
        }
        Stmt.NoOp
    }

    fn parse_impl_declaration(self) -> Stmt? {
        self.advance()
        let type_name = self.consume_identifier("expected type name after `impl`")
        if type_name == null { return null }
        if !self.consume("left_brace", "expected `{` after impl type name") {
            return null
        }
        let methods = self.parse_impl_methods(type_name!)
        if methods == null { return null }
        if !self.consume("right_brace", "expected `}` after impl block") {
            return null
        }
        Stmt.Impl(type_name!, methods!)
    }

    fn parse_impl_methods(self, type_name: string) -> StmtList? {
        if self.check("right_brace") {
            return StmtList.End
        }
        if !self.check("kw_fn") {
            self.set_error("expected `fn` inside impl block")
            return null
        }
        let method = self.parse_method_declaration(type_name)
        if method == null { return null }
        let rest = self.parse_impl_methods(type_name)
        if rest == null { return null }
        StmtList.Node(method!, rest!)
    }

    fn parse_method_declaration(self, type_name: string) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected method name")
        if name == null { return null }
        if !self.consume("left_paren", "expected `(` after method name") {
            return null
        }
        // The first parameter is conventionally `self` (implicitly
        // typed as the impl's owner type). Skip it if present and
        // synthesize a properly-typed self param ourselves.
        let params = self.parse_method_param_list(type_name)
        if params == null { return null }
        if !self.consume("right_paren", "expected `)` after parameters") {
            return null
        }
        if self.check("arrow") {
            self.advance()
            let _ret = self.consume_type("expected return type after `->`")
            if _ret == null { return null }
        }
        if !self.consume("left_brace", "expected `{` after method parameters") {
            return null
        }
        let body = self.parse_statement_list(true)
        if body == null { return null }
        if !self.consume("right_brace", "expected `}` after method body") {
            return null
        }
        // Desugar to a top-level function named `Type__method`.
        let mangled = type_name + "__" + name!
        Stmt.Function(mangled, params!, body!)
    }

    fn parse_method_param_list(self, type_name: string) -> ParamList? {
        if self.check("right_paren") {
            return ParamList.End
        }
        // Detect leading `self` and prepend it as a typed parameter.
        if self.check("identifier") && self.current_lexeme == "self" {
            self.advance()
            // Optional `: Type` after self — discarded.
            if self.check("colon") {
                self.advance()
                let _ty = self.consume_type("expected type after `:`")
                if _ty == null { return null }
            }
            // self is followed by either `,` (more params) or `)`.
            if self.check("comma") {
                self.advance()
                let rest = self.parse_param_list()
                if rest == null { return null }
                return ParamList.Node("self", type_name, rest!)
            }
            return ParamList.Node("self", type_name, ParamList.End)
        }
        self.parse_param_list()
    }

    fn parse_enum_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected enum name")
        if name == null { return null }
        if !self.consume("left_brace", "expected `{` after enum name") {
            return null
        }
        let variants = self.parse_variant_list()
        if variants == null { return null }
        if !self.consume("right_brace", "expected `}` after variants") {
            return null
        }
        Stmt.EnumDecl(name!, variants!)
    }

    fn parse_variant_list(self) -> VariantList? {
        if self.check("right_brace") {
            return VariantList.End
        }
        let name = self.consume_identifier("expected variant name")
        if name == null { return null }
        // Optional payload: `(name: ty, name: ty)`
        if self.check("left_paren") {
            self.advance()
            let fields = self.parse_field_list_until_paren()
            if fields == null { return null }
            if !self.consume("right_paren", "expected `)` after variant fields") {
                return null
            }
            return self.finish_variant(name!, fields!)
        }
        self.finish_variant(name!, FieldList.End)
    }

    fn finish_variant(self, name: string, fields: FieldList) -> VariantList? {
        if self.check("comma") {
            self.advance()
            let rest = self.parse_variant_list()
            if rest == null { return null }
            return VariantList.Node(name, fields, rest!)
        }
        VariantList.Node(name, fields, VariantList.End)
    }

    fn parse_field_list_until_paren(self) -> FieldList? {
        if self.check("right_paren") {
            return FieldList.End
        }
        // Optional `mut` modifier — ignored for now.
        if self.check("kw_mut") {
            self.advance()
        }
        let name = self.consume_identifier("expected field name")
        if name == null { return null }
        if !self.consume("colon", "expected `:` after field name") {
            return null
        }
        let ty = self.consume_type("expected field type")
        if ty == null { return null }
        if self.check("comma") {
            self.advance()
            let rest = self.parse_field_list_until_paren()
            if rest == null { return null }
            return FieldList.Node(name!, ty!, rest!)
        }
        FieldList.Node(name!, ty!, FieldList.End)
    }

    fn parse_type_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected type name")
        if name == null { return null }
        if !self.consume("equal", "expected `=` after type name") {
            return null
        }
        if !self.consume("left_brace", "expected `{` after `=`") {
            return null
        }
        let fields = self.parse_field_list()
        if fields == null { return null }
        if !self.consume("right_brace", "expected `}` after fields") {
            return null
        }
        Stmt.TypeDecl(name!, fields!)
    }

    fn parse_field_list(self) -> FieldList? {
        if self.check("right_brace") {
            return FieldList.End
        }
        // Optional `mut` modifier — ignored for now.
        if self.check("kw_mut") {
            self.advance()
        }
        let name = self.consume_identifier("expected field name")
        if name == null { return null }
        if !self.consume("colon", "expected `:` after field name") {
            return null
        }
        let ty = self.consume_type("expected field type")
        if ty == null { return null }
        if self.check("comma") {
            self.advance()
            let rest = self.parse_field_list()
            if rest == null { return null }
            return FieldList.Node(name!, ty!, rest!)
        }
        FieldList.Node(name!, ty!, FieldList.End)
    }

    fn parse_let_statement(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected variable name")
        if name == null { return null }
        if !self.consume("equal", "expected `=` after variable name") {
            return null
        }
        let initializer = self.parse_expression()
        if initializer == null { return null }
        Stmt.Let(name!, initializer!)
    }

    fn parse_mut_statement(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected variable name")
        if name == null { return null }
        if !self.consume("equal", "expected `=` after variable name") {
            return null
        }
        let initializer = self.parse_expression()
        if initializer == null { return null }
        Stmt.Mut(name!, initializer!)
    }

    fn parse_statement(self) -> Stmt? {
        if self.check("left_brace") {
            self.advance()
            let body = self.parse_statement_list(true)
            if body == null { return null }
            if !self.consume("right_brace", "expected `}` after block") {
                return null
            }
            return Stmt.Block(body!)
        }

        if self.check("kw_if") {
            return self.parse_if_statement()
        }

        if self.check("kw_while") {
            return self.parse_while_statement()
        }

        if self.check("kw_return") {
            return self.parse_return_statement()
        }

        if self.check("kw_match") {
            return self.parse_match_statement()
        }

        let expr = self.parse_expression()
        if expr == null { return null }
        Stmt.Expr(expr!)
    }

    fn parse_match_statement(self) -> Stmt? {
        self.advance()
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject = self.parse_expression()
        self.allow_struct_lit = saved
        if subject == null { return null }
        if !self.consume("left_brace", "expected `{` after match subject") {
            return null
        }
        let arms = self.parse_match_arm_list()
        if arms == null { return null }
        if !self.consume("right_brace", "expected `}` after match arms") {
            return null
        }
        Stmt.Match(subject!, arms!)
    }

    fn parse_match_arm_list(self) -> MatchArmList? {
        if self.check("right_brace") {
            return MatchArmList.End
        }
        let pattern = self.parse_pattern()
        if pattern == null { return null }
        if !self.consume("arrow", "expected `->` after pattern") {
            return null
        }
        // Disable `.field` postfix consumption while parsing the
        // arm body so the next sibling pattern (`.Variant(...)`)
        // isn't gobbled into the body. Brace-block bodies
        // re-enable the flag inside their statement list.
        let saved = self.allow_dot_postfix
        self.allow_dot_postfix = false
        let body = self.parse_expression()
        self.allow_dot_postfix = saved
        if body == null { return null }
        if self.check("comma") {
            self.advance()
        }
        let rest = self.parse_match_arm_list()
        if rest == null { return null }
        MatchArmList.Node(pattern!, body!, rest!)
    }

    fn parse_pattern(self) -> Pattern? {
        if self.check("identifier") && self.current_lexeme == "_" {
            self.advance()
            return Pattern.Wildcard
        }
        if !self.consume("dot", "expected `.` or `_` to start pattern") {
            return null
        }
        let name = self.consume_identifier("expected variant name in pattern")
        if name == null { return null }
        if !self.check("left_paren") {
            return Pattern.Variant(name!, ParamList.End)
        }
        self.advance()
        let bindings = self.parse_param_list()
        if bindings == null { return null }
        if !self.consume("right_paren", "expected `)` after binding list") {
            return null
        }
        Pattern.Variant(name!, bindings!)
    }

    fn parse_if_statement(self) -> Stmt? {
        self.advance()
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let condition = self.parse_expression()
        self.allow_struct_lit = saved
        if condition == null { return null }

        if !self.check("left_brace") {
            self.set_error("expected `{` after if condition")
            return null
        }

        let then_branch = self.parse_statement()
        if then_branch == null { return null }

        if self.check("kw_else") {
            self.advance()
            let else_branch = self.parse_statement()
            if else_branch == null { return null }
            return Stmt.If(condition!, then_branch!, else_branch)
        }

        Stmt.If(condition!, then_branch!, null)
    }

    fn parse_while_statement(self) -> Stmt? {
        self.advance()
        let saved = self.allow_struct_lit
        self.allow_struct_lit = false
        let condition = self.parse_expression()
        self.allow_struct_lit = saved
        if condition == null { return null }

        if !self.check("left_brace") {
            self.set_error("expected `{` after while condition")
            return null
        }

        let body = self.parse_statement()
        if body == null { return null }

        Stmt.While(condition!, body!)
    }

    fn parse_function_declaration(self) -> Stmt? {
        self.advance()
        let name = self.consume_identifier("expected function name")
        if name == null { return null }
        if !self.consume("left_paren", "expected `(` after function name") {
            return null
        }

        let params = self.parse_param_list()
        if params == null { return null }

        if !self.consume("right_paren", "expected `)` after parameters") {
            return null
        }

        // Optional return type annotation: `-> Type`. The MVP
        // doesn't carry the type through to codegen (every fn
        // returns i64), but accepting it lets bootstrap source
        // parse cleanly.
        if self.check("arrow") {
            self.advance()
            let _ret = self.consume_type("expected return type after `->`")
            if _ret == null { return null }
        }

        if !self.consume("left_brace", "expected `{` after function parameters") {
            return null
        }

        let body = self.parse_statement_list(true)
        if body == null { return null }

        if !self.consume("right_brace", "expected `}` after function body") {
            return null
        }

        Stmt.Function(name!, params!, body!)
    }

    fn parse_param_list(self) -> ParamList? {
        if self.check("right_paren") {
            return ParamList.End
        }

        let name = self.consume_identifier("expected parameter name")
        if name == null { return null }

        // Optional `: Type` annotation. Stored verbatim; codegen
        // translates the textual type into its internal value tag.
        if self.check("colon") {
            self.advance()
            let ty = self.consume_type("expected parameter type after `:`")
            if ty == null { return null }
            return self.finish_param(name!, ty!)
        }

        self.finish_param(name!, "i64")
    }

    fn finish_param(self, name: string, ty: string) -> ParamList? {
        if self.check("comma") {
            self.advance()
            let rest = self.parse_param_list()
            if rest == null { return null }
            return ParamList.Node(name, ty, rest!)
        }
        ParamList.Node(name, ty, ParamList.End)
    }

    fn parse_return_statement(self) -> Stmt? {
        self.advance()

        if self.check("right_brace") || self.check("eof") {
            return Stmt.RetEmpty
        }

        let value = self.parse_expression()
        if value == null { return null }
        Stmt.Ret(value!)
    }

    fn parse_expression(self) -> Expr? {
        self.parse_assignment()
    }

    fn parse_assignment(self) -> Expr? {
        let left = self.parse_or()
        if left == null { return null }

        if !self.check("equal") {
            return left
        }

        self.advance()
        let value = self.parse_assignment()
        if value == null { return null }

        match left! {
            .Ident(name) -> Expr.Assign(name, value!)
            _ -> {
                self.set_error("invalid assignment target")
                null
            }
        }
    }

    fn parse_or(self) -> Expr? {
        let left = self.parse_and()
        if left == null { return null }

        mut expr = left!
        while self.check("pipe_pipe") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_and()
            if right == null { return null }
            expr = Expr.Logical(expr, operator, right!)
        }

        expr
    }

    fn parse_and(self) -> Expr? {
        let left = self.parse_equality()
        if left == null { return null }

        mut expr = left!
        while self.check("amp_amp") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_equality()
            if right == null { return null }
            expr = Expr.Logical(expr, operator, right!)
        }

        expr
    }

    fn parse_equality(self) -> Expr? {
        let left = self.parse_comparison()
        if left == null { return null }

        mut expr = left!
        while self.check("equal_equal") || self.check("bang_equal") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_comparison()
            if right == null { return null }
            expr = Expr.Binary(expr, operator, right!)
        }

        expr
    }

    fn parse_comparison(self) -> Expr? {
        let left = self.parse_term()
        if left == null { return null }

        mut expr = left!
        while self.check("greater") || self.check("greater_equal") || self.check("less") || self.check("less_equal") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_term()
            if right == null { return null }
            expr = Expr.Binary(expr, operator, right!)
        }

        expr
    }

    fn parse_term(self) -> Expr? {
        let left = self.parse_factor()
        if left == null { return null }

        mut expr = left!
        while self.check("plus") || self.check("minus") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_factor()
            if right == null { return null }
            expr = Expr.Binary(expr, operator, right!)
        }

        expr
    }

    fn parse_factor(self) -> Expr? {
        let left = self.parse_unary()
        if left == null { return null }

        mut expr = left!
        while self.check("star") || self.check("slash") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_unary()
            if right == null { return null }
            expr = Expr.Binary(expr, operator, right!)
        }

        expr
    }

    fn parse_unary(self) -> Expr? {
        if self.check("bang") || self.check("minus") {
            let operator = self.current_lexeme
            self.advance()
            let right = self.parse_unary()
            if right == null { return null }
            return Expr.Unary(operator, right!)
        }

        self.parse_call()
    }

    fn parse_call(self) -> Expr? {
        let expr = self.parse_primary()
        if expr == null { return null }

        mut result = expr!
        while self.check("left_paren") || (self.check("dot") && self.allow_dot_postfix) || self.check("bang") || self.check("left_bracket") {
            // Force-unwrap `expr!` is a no-op pass-through since we
            // don't track nullability in the value tag.
            while self.check("bang") {
                self.advance()
            }
            if self.check("left_bracket") {
                self.advance()
                let idx = self.parse_expression()
                if idx == null { return null }
                if !self.consume("right_bracket", "expected `]` after index") {
                    return null
                }
                result = Expr.Index(result, idx!)
            } else if !self.check("left_paren") && !self.check("dot") {
                return result
            } else {
            if self.check("left_paren") {
                self.advance()
                let args = self.parse_arg_list()
                if args == null { return null }
                if !self.consume("right_paren", "expected `)` after arguments") {
                    return null
                }
                result = Expr.Call(result, args!)
            } else {
                self.advance()
                let field = self.consume_identifier("expected field name after `.`")
                if field == null { return null }
                // Detect enum constructor: `Type.Variant(args)`. We
                // distinguish from method calls by requiring the
                // head Ident to start with an uppercase letter
                // (Forge convention: types are PascalCase).
                let type_name = match result {
                    .Ident(n) -> {
                        if starts_with_upper_p(n) {
                            n
                        } else {
                            ""
                        }
                    }
                    _ -> ""
                }
                if type_name != "" && self.check("left_paren") {
                    self.advance()
                    let args = self.parse_arg_list()
                    if args == null { return null }
                    if !self.consume("right_paren", "expected `)` after arguments") {
                        return null
                    }
                    result = Expr.EnumCtor(type_name, field!, args!)
                } else {
                    result = Expr.FieldAccess(result, field!)
                }
            }
            }
        }

        result
    }

    fn parse_field_init_list(self) -> FieldInitList? {
        if self.check("right_brace") {
            return FieldInitList.End
        }
        let name = self.consume_identifier("expected field name")
        if name == null { return null }
        // Shorthand: `Foo { name }` is sugar for `Foo { name: name }`.
        // If the next token is `,` or `}`, the field value is just
        // the variable with the same name.
        let value = if self.check("colon") {
            self.advance()
            let v = self.parse_expression()
            if v == null { return null }
            v!
        } else {
            Expr.Ident(name!)
        }
        if self.check("comma") {
            self.advance()
            let rest = self.parse_field_init_list()
            if rest == null { return null }
            return FieldInitList.Node(name!, value, rest!)
        }
        FieldInitList.Node(name!, value, FieldInitList.End)
    }

    fn parse_arg_list(self) -> ExprList? {
        if self.check("right_paren") {
            return ExprList.End
        }

        let expr = self.parse_expression()
        if expr == null { return null }

        if self.check("comma") {
            self.advance()
            let rest = self.parse_arg_list()
            if rest == null { return null }
            return ExprList.Node(expr!, rest!)
        }

        ExprList.Node(expr!, ExprList.End)
    }

    fn parse_primary(self) -> Expr? {
        if self.check("number") {
            let value = self.current_lexeme
            self.advance()
            return Expr.Number(value)
        }

        if self.check("string") {
            let value = self.current_lexeme
            self.advance()
            return Expr.String(value)
        }

        if self.check("kw_true") || self.check("kw_false") {
            let value = self.current_lexeme
            self.advance()
            return Expr.Bool(value)
        }

        if self.check("kw_null") {
            self.advance()
            return Expr.Null
        }

        if self.check("identifier") {
            let name = self.current_lexeme
            self.advance()
            if self.allow_struct_lit && self.check("left_brace") {
                self.advance()
                let inits = self.parse_field_init_list()
                if inits == null { return null }
                if !self.consume("right_brace", "expected `}` after struct fields") {
                    return null
                }
                return Expr.StructLit(name, inits!)
            }
            return Expr.Ident(name)
        }

        if self.check("left_paren") {
            self.advance()
            let expr = self.parse_expression()
            if expr == null { return null }
            if !self.consume("right_paren", "expected `)` after expression") {
                return null
            }
            return Expr.Grouping(expr!)
        }

        if self.check("kw_match") {
            return self.parse_match_expression()
        }

        if self.check("left_brace") {
            return self.parse_block_expression()
        }

        self.set_error("expected expression")
        null
    }

    fn parse_block_expression(self) -> Expr? {
        self.advance()
        // A block expression's body is parsed as a regular statement
        // list. Re-enable `.field` postfix consumption inside —
        // we're back in normal expression-statement context.
        let saved_dot = self.allow_dot_postfix
        self.allow_dot_postfix = true
        let body = self.parse_statement_list(true)
        self.allow_dot_postfix = saved_dot
        if body == null { return null }
        if !self.consume("right_brace", "expected `}` after block expression") {
            return null
        }
        Expr.Block(body!)
    }

    fn parse_match_expression(self) -> Expr? {
        self.advance()
        let saved_struct = self.allow_struct_lit
        self.allow_struct_lit = false
        let subject = self.parse_expression()
        self.allow_struct_lit = saved_struct
        if subject == null { return null }
        if !self.consume("left_brace", "expected `{` after match subject") {
            return null
        }
        let arms = self.parse_match_arm_list()
        if arms == null { return null }
        if !self.consume("right_brace", "expected `}` after match arms") {
            return null
        }
        Expr.MatchExpr(subject!, arms!)
    }

    fn check(self, kind: string) -> bool {
        self.current_kind == kind
    }

    fn advance(self) {
        self.advance_token()
    }

    fn consume(self, kind: string, message: string) -> bool {
        if self.check(kind) {
            self.advance()
            return true
        }
        self.set_error(message)
        false
    }

    fn consume_identifier(self, message: string) -> string? {
        if self.check("identifier") {
            let name = self.current_lexeme
            self.advance()
            return name
        }
        self.set_error(message)
        null
    }

    // Consume a type reference: identifier optionally followed by `?`.
    // The trailing `?` (nullable) is currently erased — we just
    // return the underlying name.
    fn consume_type(self, message: string) -> string? {
        if !self.check("identifier") {
            self.set_error(message)
            return null
        }
        let name = self.current_lexeme
        self.advance()
        if self.check("question") {
            self.advance()
        }
        name
    }

    fn advance_token(self) {
        self.skip_whitespace_and_comments()

        self.start = self.current
        self.current_line = self.line
        self.current_column = self.column

        if self.is_at_end() {
            self.set_current("eof", "")
            return
        }

        let ch = self.advance_char()

        if ch == "," {
            self.set_current("comma", ",")
            return
        }
        if ch == "(" {
            self.set_current("left_paren", "(")
            return
        }
        if ch == ")" {
            self.set_current("right_paren", ")")
            return
        }
        if ch == "{" {
            self.set_current("left_brace", "{")
            return
        }
        if ch == "}" {
            self.set_current("right_brace", "}")
            return
        }
        if ch == "+" {
            self.set_current("plus", "+")
            return
        }
        if ch == "-" {
            if self.match_next(">") {
                self.set_current("arrow", "->")
            } else {
                self.set_current("minus", "-")
            }
            return
        }
        if ch == "*" {
            self.set_current("star", "*")
            return
        }
        if ch == "/" {
            self.set_current("slash", "/")
            return
        }
        if ch == ":" {
            self.set_current("colon", ":")
            return
        }
        if ch == "." {
            self.set_current("dot", ".")
            return
        }
        if ch == "?" {
            self.set_current("question", "?")
            return
        }
        if ch == "[" {
            self.set_current("left_bracket", "[")
            return
        }
        if ch == "]" {
            self.set_current("right_bracket", "]")
            return
        }

        if ch == "&" {
            if self.match_next("&") {
                self.set_current("amp_amp", "&&")
                return
            }
            self.set_error("unexpected character `&`")
            self.set_current("error", "&")
            return
        }

        if ch == "|" {
            if self.match_next("|") {
                self.set_current("pipe_pipe", "||")
                return
            }
            self.set_error("unexpected character `|`")
            self.set_current("error", "|")
            return
        }

        if ch == "!" {
            if self.match_next("=") {
                self.set_current("bang_equal", "!=")
            } else {
                self.set_current("bang", "!")
            }
            return
        }

        if ch == "=" {
            if self.match_next("=") {
                self.set_current("equal_equal", "==")
            } else {
                self.set_current("equal", "=")
            }
            return
        }

        if ch == "<" {
            if self.match_next("=") {
                self.set_current("less_equal", "<=")
            } else {
                self.set_current("less", "<")
            }
            return
        }

        if ch == ">" {
            if self.match_next("=") {
                self.set_current("greater_equal", ">=")
            } else {
                self.set_current("greater", ">")
            }
            return
        }

        if ch == "\"" {
            self.scan_string_token()
            return
        }

        if is_digit(ch) {
            self.scan_number_token()
            return
        }

        if is_alpha(ch) {
            self.scan_identifier_token()
            return
        }

        self.set_error("unexpected character `" + ch + "`")
        self.set_current("error", ch)
    }

    fn scan_string_token(self) {
        // Build the lexeme with escapes resolved. Surrounding quotes
        // are kept so codegen.fg's strip_quotes still works.
        mut content = "\""
        while !self.is_at_end() && self.peek_char() != "\"" {
            if self.peek_char() == "\\" {
                self.advance_char()
                if self.is_at_end() {
                    break
                }
                let esc = self.peek_char()
                self.advance_char()
                if esc == "n" {
                    content = content + "\n"
                } else if esc == "t" {
                    content = content + "\t"
                } else if esc == "r" {
                    content = content + "\r"
                } else if esc == "\\" {
                    content = content + "\\"
                } else if esc == "\"" {
                    content = content + "\""
                } else if esc == "0" {
                    content = content + "\0"
                } else {
                    content = content + "\\" + esc
                }
            } else {
                content = content + self.peek_char()
                self.advance_char()
            }
        }

        if self.is_at_end() {
            self.set_error("unterminated string")
            self.set_current("error", "")
            return
        }

        self.advance_char()
        content = content + "\""
        self.set_current("string", content)
    }

    fn scan_number_token(self) {
        while is_digit(self.peek_char()) {
            self.advance_char()
        }

        if self.peek_char() == "." && is_digit(self.peek_next_char()) {
            self.advance_char()
            while is_digit(self.peek_char()) {
                self.advance_char()
            }
        }

        self.set_current("number", self.source.substring(self.start, self.current))
    }

    fn scan_identifier_token(self) {
        while is_alpha_numeric(self.peek_char()) {
            self.advance_char()
        }

        let text = self.source.substring(self.start, self.current)
        self.set_current(keyword_kind(text), text)
    }

    fn set_current(self, kind: string, lexeme: string) {
        self.current_kind = kind
        self.current_lexeme = lexeme
    }

    fn skip_whitespace_and_comments(self) {
        while !self.is_at_end() {
            let ch = self.peek_char()
            if ch == " " || ch == "\r" || ch == "\t" || ch == "\n" {
                self.advance_char()
            } else if ch == "/" && self.peek_next_char() == "/" {
                while !self.is_at_end() && self.peek_char() != "\n" {
                    self.advance_char()
                }
            } else {
                return
            }
        }
    }

    fn is_at_end(self) -> bool {
        self.current >= self.source.length
    }

    fn peek_char(self) -> string {
        if self.current >= self.source.length {
            return ""
        }
        self.source[self.current]
    }

    fn peek_next_char(self) -> string {
        if self.current + 1 >= self.source.length {
            return ""
        }
        self.source[self.current + 1]
    }

    fn match_next(self, expected: string) -> bool {
        if self.is_at_end() {
            return false
        }
        if self.source[self.current] != expected {
            return false
        }
        self.advance_char()
        true
    }

    fn advance_char(self) -> string {
        let ch = self.source[self.current]
        self.current = self.current + 1
        if ch == "\n" {
            self.line = self.line + 1
            self.column = 1
        } else {
            self.column = self.column + 1
        }
        ch
    }

    fn set_error(self, message: string) {
        if self.had_error {
            return
        }
        self.had_error = true
        self.error_message = "parse error at " + string(self.current_line) + ":" + string(self.current_column) + ": " + message
    }
}
