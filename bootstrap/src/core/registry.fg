// WHY: central feature registry. Each feature declares a Feature struct
// with all handlers (emit, resolve, check). Registration uses dummy
// enum values to derive tags — no magic numbers.
//
// To add a new feature:
//   1. Create features/<name>/mod.fg
//   2. Build a Feature with your handlers
//   3. Call register_feature() with a dummy Expr/Stmt value
//   4. One line in build_registry()

// C-side helpers
extern fn forge_expr_tag(expr: int) -> int
extern fn forge_stmt_tag(stmt: int) -> int
extern fn forge_intmap_new() -> ptr
extern fn forge_intmap_set(map: ptr, key: int, value: int)
extern fn forge_intmap_get(map: ptr, key: int) -> int
extern fn forge_intmap_has(map: ptr, key: int) -> int

// ── Feature type ──

export type Feature = {
    name: string,
    emit_expr: fn(Ctx, VarEnv, Expr) -> EmitResult,
    emit_stmt: fn(Ctx, VarEnv, Stmt) -> StmtResult,
    resolve_expr: fn(Resolver, Expr) -> Resolver,
    check_expr: fn(TC, Expr) -> ExprResult,
}

// ── No-op handlers ──

fn noop_emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult { err_emit("no expr handler") }
fn noop_emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult { err_stmt("no stmt handler") }
fn noop_resolve(r: Resolver, expr: Expr) -> Resolver { r }
fn noop_check(tc: TC, expr: Expr) -> ExprResult { tc_er(tc, ValueType.Int) }

// ── Registry ──

export type Registry = {
    expr_emitters: ptr,
    stmt_emitters: ptr,
    expr_resolvers: ptr,
    expr_checkers: ptr,
}

export fn registry_new() -> Registry {
    Registry {
        expr_emitters: forge_intmap_new(),
        stmt_emitters: forge_intmap_new(),
        expr_resolvers: forge_intmap_new(),
        expr_checkers: forge_intmap_new(),
    }
}

// Register an expression feature. Pass a DUMMY Expr value to derive the tag.
// Example: register_expr(reg, Expr.IsCheck(Expr.Null, ""), my_feature)
export fn register_expr(reg: Registry, dummy: Expr, f: Feature) -> Registry {
    let tag = forge_expr_tag(dummy)
    forge_intmap_set(reg.expr_emitters, tag, f.emit_expr)
    forge_intmap_set(reg.expr_resolvers, tag, f.resolve_expr)
    forge_intmap_set(reg.expr_checkers, tag, f.check_expr)
    reg
}

// Register a statement feature. Pass a DUMMY Stmt value to derive the tag.
export fn register_stmt(reg: Registry, dummy: Stmt, f: Feature) -> Registry {
    let tag = forge_stmt_tag(dummy)
    forge_intmap_set(reg.stmt_emitters, tag, f.emit_stmt)
    reg
}

// Register both expr and stmt forms.
export fn register_dual(reg: Registry, expr_dummy: Expr, stmt_dummy: Stmt, f: Feature) -> Registry {
    let etag = forge_expr_tag(expr_dummy)
    let stag = forge_stmt_tag(stmt_dummy)
    forge_intmap_set(reg.expr_emitters, etag, f.emit_expr)
    forge_intmap_set(reg.expr_resolvers, etag, f.resolve_expr)
    forge_intmap_set(reg.expr_checkers, etag, f.check_expr)
    forge_intmap_set(reg.stmt_emitters, stag, f.emit_stmt)
    reg
}

// ── Convenience constructors ──

export fn emit_only(name: string, emit: fn(Ctx, VarEnv, Expr) -> EmitResult) -> Feature {
    Feature { name, emit_expr: emit, emit_stmt: noop_emit_stmt, resolve_expr: noop_resolve, check_expr: noop_check }
}

export fn stmt_only(name: string, emit: fn(Ctx, VarEnv, Stmt) -> StmtResult) -> Feature {
    Feature { name, emit_expr: noop_emit_expr, emit_stmt: emit, resolve_expr: noop_resolve, check_expr: noop_check }
}

export fn full_expr(name: string, emit: fn(Ctx, VarEnv, Expr) -> EmitResult, resolve: fn(Resolver, Expr) -> Resolver, check: fn(TC, Expr) -> ExprResult) -> Feature {
    Feature { name, emit_expr: emit, emit_stmt: noop_emit_stmt, resolve_expr: resolve, check_expr: check }
}

// ── Dispatch ──

export fn dispatch_expr_emit(reg: Registry, tag: int, ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult? {
    if forge_intmap_has(reg.expr_emitters, tag) == 0 { return null }
    let handler: fn(Ctx, VarEnv, Expr) -> EmitResult = forge_intmap_get(reg.expr_emitters, tag)
    handler(ctx, env, expr)
}

export fn dispatch_stmt_emit(reg: Registry, tag: int, ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult? {
    if forge_intmap_has(reg.stmt_emitters, tag) == 0 { return null }
    let handler: fn(Ctx, VarEnv, Stmt) -> StmtResult = forge_intmap_get(reg.stmt_emitters, tag)
    handler(ctx, env, stmt)
}

export fn dispatch_expr_resolve(reg: Registry, tag: int, r: Resolver, expr: Expr) -> Resolver? {
    if forge_intmap_has(reg.expr_resolvers, tag) == 0 { return null }
    let handler: fn(Resolver, Expr) -> Resolver = forge_intmap_get(reg.expr_resolvers, tag)
    handler(r, expr)
}

export fn dispatch_expr_check(reg: Registry, tag: int, tc: TC, expr: Expr) -> ExprResult? {
    if forge_intmap_has(reg.expr_checkers, tag) == 0 { return null }
    let handler: fn(TC, Expr) -> ExprResult = forge_intmap_get(reg.expr_checkers, tag)
    handler(tc, expr)
}

// ── Build the registry ──

export fn build_registry() -> Registry {
    mut reg = registry_new()
    reg = register_struct_decl(reg)
    reg = register_match(reg)
    reg = register_if_stmt(reg)
    reg = register_null_safety(reg)
    reg = register_tuples(reg)
    reg = register_with_expr(reg)
    reg = register_list_lit(reg)
    reg = register_closures(reg)
    reg = register_map_lit(reg)
    reg = register_is_keyword(reg)
    reg = register_while_stmt(reg)
    reg = register_for_stmt(reg)
    reg = register_let_stmt(reg)
    reg = register_defer_stmt(reg)
    reg = register_spec_test(reg)
    reg = register_select_stmt(reg)
    reg = register_parallel_stmt(reg)
    reg
}
