// WHY: central feature registry for the compiler. Each language feature
// registers its handlers into int-keyed maps for O(1) dispatch.
// No linked lists, no linear scans.
//
// To add a new feature:
//   1. Create features/<name>/mod.fg
//   2. Add a register_<name>(reg) function that calls reg_expr/reg_stmt
//   3. Call it from build_registry()
//
// AGENT:
//   read this file when:    adding a new language feature
//   do NOT read this file when:   feature-specific logic (go to features/<name>/)

// C-side helpers
extern fn forge_expr_tag(expr: int) -> int
extern fn forge_stmt_tag(stmt: int) -> int
extern fn forge_intmap_new() -> ptr
extern fn forge_intmap_set(map: ptr, key: int, value: int)
extern fn forge_intmap_get(map: ptr, key: int) -> int
extern fn forge_intmap_has(map: ptr, key: int) -> int
// Dispatch uses typed let bindings: `let handler: fn(...) = intmap_get(...)`
// The type annotation tells codegen the value is callable.

// ── Tag reference ──
// Tags are enum variant indices in ast.fg.
//
// Expr:  0=Number  1=String  2=Bool  3=Null  4=Ident  5=Assign
//        6=Grouping  7=Unary  8=Binary  9=Logical  10=Call
//       11=StructLit  12=FieldAccess  13=EnumCtor  14=Index
//       15=Block  16=MatchExpr  17=FieldAssign  18=IfExpr
//       19=NullCoalesce  20=OptionalChain  21=Try  22=Tuple
//       23=TupleIndex  24=With  25=ListLit  26=Lambda
//       27=MapLit  28=Slice  29=FloatLit  30=IsCheck
//
// Stmt:  0=Let  1=Mut  2=Expr  3=Block  4=If  5=While  6=For  7=ForIn
//        8=Function  9=Return  10=ReturnEmpty  11=TypeDecl  12=EnumDecl
//       13=Match  14=Impl  15=NoOp  16=ExternFn  17=Break  18=Continue
//       19=TraitDecl  20=LetDestructure  21=Defer

// ── Registry ──
// Two int-keyed maps: tag → handler function pointer.
// O(1) lookup. Stored in Ctx and threaded through compilation.

export type Registry = {
    expr_handlers: ptr,   // intmap: expr tag → fn(Ctx, VarEnv, Expr) -> EmitResult
    stmt_handlers: ptr,   // intmap: stmt tag → fn(Ctx, VarEnv, Stmt) -> StmtResult
}

export fn registry_new() -> Registry {
    Registry {
        expr_handlers: forge_intmap_new(),
        stmt_handlers: forge_intmap_new(),
    }
}

// Register a handler for an expression tag.
export fn reg_expr(reg: Registry, tag: int, handler: fn(Ctx, VarEnv, Expr) -> EmitResult) -> Registry {
    forge_intmap_set(reg.expr_handlers, tag, handler)
    reg
}

// Register a handler for a statement tag.
export fn reg_stmt(reg: Registry, tag: int, handler: fn(Ctx, VarEnv, Stmt) -> StmtResult) -> Registry {
    forge_intmap_set(reg.stmt_handlers, tag, handler)
    reg
}

// Dispatch an expression through the registry. Returns null if no handler.
export fn dispatch_expr(reg: Registry, tag: int, ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult? {
    if forge_intmap_has(reg.expr_handlers, tag) == 0 {
        return null
    }
    let handler: fn(Ctx, VarEnv, Expr) -> EmitResult = forge_intmap_get(reg.expr_handlers, tag)
    handler(ctx, env, expr)
}

// Dispatch a statement through the registry. Returns null if no handler.
export fn dispatch_stmt(reg: Registry, tag: int, ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult? {
    if forge_intmap_has(reg.stmt_handlers, tag) == 0 {
        return null
    }
    let handler: fn(Ctx, VarEnv, Stmt) -> StmtResult = forge_intmap_get(reg.stmt_handlers, tag)
    handler(ctx, env, stmt)
}

// ── Build the registry ──
// Each feature registers its handlers here.

export fn build_registry() -> Registry {
    mut reg = registry_new()

    // Expression features
    reg = reg_expr(reg, 11, reg_emit_struct_lit)
    reg = reg_expr(reg, 12, reg_emit_field_access)
    reg = reg_expr(reg, 13, reg_emit_enum_ctor)
    reg = reg_expr(reg, 14, reg_emit_index)
    reg = reg_expr(reg, 15, reg_emit_block_expr)
    reg = reg_expr(reg, 16, reg_emit_match_expr)
    reg = reg_expr(reg, 17, reg_emit_field_assign)
    reg = reg_expr(reg, 18, reg_emit_if_expr)
    reg = reg_expr(reg, 19, reg_emit_null_coalesce)
    reg = reg_expr(reg, 20, reg_emit_optional_chain)
    reg = reg_expr(reg, 21, reg_emit_try)
    reg = reg_expr(reg, 22, reg_emit_tuple)
    reg = reg_expr(reg, 23, reg_emit_tuple_index)
    reg = reg_expr(reg, 24, reg_emit_with)
    reg = reg_expr(reg, 25, reg_emit_list_lit)
    reg = reg_expr(reg, 26, reg_emit_lambda)
    reg = reg_expr(reg, 27, reg_emit_map_lit)
    reg = reg_expr(reg, 28, reg_emit_slice)
    reg = reg_expr(reg, 30, reg_emit_is_check)

    // Statement features
    reg = reg_stmt(reg, 4, reg_emit_if)
    reg = reg_stmt(reg, 5, reg_emit_while)
    reg = reg_stmt(reg, 6, reg_emit_for)
    reg = reg_stmt(reg, 7, reg_emit_for_in)
    reg = reg_stmt(reg, 13, reg_emit_match_stmt)
    reg = reg_stmt(reg, 20, reg_emit_let_destructure)
    reg = reg_stmt(reg, 21, reg_emit_defer)

    reg
}
