// WHY: central feature registry. Each feature declares a single Feature
// struct with ALL its handlers. One struct, one registration call.
//
// To add a new feature:
//   1. Create features/<name>/mod.fg
//   2. Build a Feature struct with your handlers
//   3. Call register_feature() in build_registry()

// C-side helpers
extern fn forge_expr_tag(expr: int) -> int
extern fn forge_stmt_tag(stmt: int) -> int
extern fn forge_intmap_new() -> ptr
extern fn forge_intmap_set(map: ptr, key: int, value: int)
extern fn forge_intmap_get(map: ptr, key: int) -> int
extern fn forge_intmap_has(map: ptr, key: int) -> int

// ── Tag reference ──
// Expr:  0=Number  1=String  2=Bool  3=Null  4=Ident  5=Assign
//        6=Grouping  7=Unary  8=Binary  9=Logical  10=Call
//       11=StructLit  12=FieldAccess  13=EnumCtor  14=Index
//       15=Block  16=MatchExpr  17=FieldAssign  18=IfExpr
//       19=NullCoalesce  20=OptionalChain  21=Try  22=Tuple
//       23=TupleIndex  24=With  25=ListLit  26=Lambda
//       27=MapLit  28=Slice  29=FloatLit  30=IsCheck
//
// Stmt:  0=Let  1=Mut  2=Expr  3=Block  4=If  5=While  6=For  7=ForIn
//        8=Function  9=Return  10=ReturnEmpty  11=TypeDecl  12=EnumDecl
//       13=Match  14=Impl  15=NoOp  16=ExternFn  17=Break  18=Continue
//       19=TraitDecl  20=LetDestructure  21=Defer

// ── Unified Feature type ──

export type Feature = {
    name: string,
    expr_tag: int,                                       // -1 = no expression form
    stmt_tag: int,                                       // -1 = no statement form
    emit_expr: fn(Ctx, VarEnv, Expr) -> EmitResult,
    emit_stmt: fn(Ctx, VarEnv, Stmt) -> StmtResult,
}

// ── No-op handlers for features that only have one form ──

export fn noop_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {
    err_emit("no expr handler")
}

export fn noop_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {
    err_stmt("no stmt handler")
}

// ── Registry ──

export type Registry = {
    expr_handlers: ptr,
    stmt_handlers: ptr,
}

export fn registry_new() -> Registry {
    Registry { expr_handlers: forge_intmap_new(), stmt_handlers: forge_intmap_new() }
}

export fn register_feature(reg: Registry, f: Feature) -> Registry {
    if f.expr_tag >= 0 {
        forge_intmap_set(reg.expr_handlers, f.expr_tag, f.emit_expr)
    }
    if f.stmt_tag >= 0 {
        forge_intmap_set(reg.stmt_handlers, f.stmt_tag, f.emit_stmt)
    }
    reg
}

// ── Dispatch ──

export fn dispatch_expr(reg: Registry, tag: int, ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult? {
    if forge_intmap_has(reg.expr_handlers, tag) == 0 {
        return null
    }
    let handler: fn(Ctx, VarEnv, Expr) -> EmitResult = forge_intmap_get(reg.expr_handlers, tag)
    handler(ctx, env, expr)
}

export fn dispatch_stmt(reg: Registry, tag: int, ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult? {
    if forge_intmap_has(reg.stmt_handlers, tag) == 0 {
        return null
    }
    let handler: fn(Ctx, VarEnv, Stmt) -> StmtResult = forge_intmap_get(reg.stmt_handlers, tag)
    handler(ctx, env, stmt)
}

// ── Build the registry ──

export fn build_registry() -> Registry {
    mut reg = registry_new()
    reg = register_struct_decl(reg)
    reg = register_match(reg)
    reg = register_if_stmt(reg)
    reg = register_null_safety(reg)
    reg = register_tuples(reg)
    reg = register_with_expr(reg)
    reg = register_list_lit(reg)
    reg = register_closures(reg)
    reg = register_map_lit(reg)
    reg = register_is_keyword(reg)
    reg = register_while_stmt(reg)
    reg = register_for_stmt(reg)
    reg = register_let_stmt(reg)
    reg = register_defer_stmt(reg)
    reg
}
