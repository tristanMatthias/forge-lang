// WHY: module-aware name resolution — builds a module tree from
// Stmt.Module nodes, resolves `use` imports into alias tables, and
// rewrites Expr.Ident references to Expr.QualifiedIdent with their
// fully-qualified canonical paths (e.g. "core::ast::render_expr").
//
// This pass runs AFTER module file resolution (resolve_module_files
// in main.fg) and BEFORE the existing resolver (core/resolver.fg).
// The existing resolver handles variable scoping; this pass handles
// module-level name qualification.
//
//   read this file when:    working on module visibility, use imports,
//                           or qualified name resolution
//   do NOT read this file when:   the issue is variable scoping or
//                                  type checking

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldInitList, MatchArmList, Pattern, PatternList, SExpr, SStmt, sexpr, sexpr_dummy, sstmt, stmt_unwrap, AnnotationList}
use diagnostics.{DiagCode, DiagnosticBag, bag_new, bag_report, bag_has_errors, diag_error, span_dummy}

// ── Module tree ──
//
// Hierarchical namespace built from Stmt.Module nodes. Each node
// contains the items (functions, types, enums) defined in that module
// and links to child modules.

enum ModuleItem {
    End
    Node(short_name: string, canonical: string, exported: bool, next: ModuleItem)
}

enum ModuleNode {
    End
    Node(name: string, path: string, items: ModuleItem, children: ModuleNode, next: ModuleNode)
}

// ── Alias table ──
//
// Maps short names to canonical paths within a module scope.
// Built from `use` declarations.

enum AliasEntry {
    End
    Node(short_name: string, canonical: string, next: AliasEntry)
}

fn alias_lookup(aliases: AliasEntry, name: string) -> string {
    match aliases {
        .End -> ""
        .Node(short, canonical, next) -> {
            if short == name { return canonical }
            alias_lookup(next, name)
        }
    }
}

// ── Module item lookup ──

fn item_lookup(items: ModuleItem, name: string) -> string {
    match items {
        .End -> ""
        .Node(short, canonical, _, next) -> {
            if short == name { return canonical }
            item_lookup(next, name)
        }
    }
}

fn item_is_exported(items: ModuleItem, name: string) -> bool {
    match items {
        .End -> false
        .Node(short, _, exported, next) -> {
            if short == name { return exported }
            item_is_exported(next, name)
        }
    }
}

// Build a flat index of ALL items across ALL modules. Called once
// at the start of resolve_names. Turns the O(n*m) tree traversal
// per identifier into an O(m) linked-list scan (same as alias_lookup).
fn build_global_index(tree: ModuleNode, index: ModuleItem) -> ModuleItem {
    match tree {
        .End -> index
        .Node(_, _, items, children, next) -> {
            let with_items = append_items(items, index)
            let with_children = build_global_index(children, with_items)
            build_global_index(next, with_children)
        }
    }
}

fn append_items(items: ModuleItem, rest: ModuleItem) -> ModuleItem {
    match items {
        .End -> rest
        .Node(short, canonical, exported, next) -> {
            append_items(next, ModuleItem.Node(short, canonical, exported, rest))
        }
    }
}

// Find a module node by path (e.g. "helpers" or "core::ast")
fn module_find(tree: ModuleNode, path: string) -> ModuleNode {
    match tree {
        .End -> ModuleNode.End
        .Node(name, mod_path, items, children, next) -> {
            if mod_path == path { return tree }
            // Search children
            let in_children = module_find(children, path)
            match in_children {
                .End -> module_find(next, path)
                _ -> in_children
            }
        }
    }
}

// ── Pass 1: Build module tree ──
//
// Walk the AST and collect all module-level declarations (fn, type,
// enum, trait, extern fn) into a hierarchical ModuleNode tree.

fn build_module_tree(stmts: StmtList, parent_path: string, tree: ModuleNode) -> ModuleNode {
    match stmts {
        .End -> tree
        .Node(ss, next) -> {
            let updated = build_tree_from_stmt(ss.node, parent_path, tree)
            build_module_tree(next, parent_path, updated)
        }
    }
}

fn build_tree_from_stmt(stmt: Stmt, parent_path: string, tree: ModuleNode) -> ModuleNode {
    match stmt {
        .Module(name, body) -> {
            let mod_path = if parent_path == "" { name } else { parent_path + "::" + name }
            // Collect items in this module
            let items = collect_module_items(body, mod_path)
            // Recursively build tree for nested modules
            let children = build_module_tree(body, mod_path, ModuleNode.End)
            // Add this module to the tree
            ModuleNode.Node(name, mod_path, items, children, tree)
        }
        .Annotated(_, inner) -> build_tree_from_stmt(inner, parent_path, tree)
        _ -> tree
    }
}

// Collect all declaration names in a module's body
fn collect_module_items(stmts: StmtList, mod_path: string) -> ModuleItem {
    match stmts {
        .End -> ModuleItem.End
        .Node(ss, next) -> {
            let rest = collect_module_items(next, mod_path)
            collect_item_from_stmt(ss.node, mod_path, false, rest)
        }
    }
}

fn collect_item_from_stmt(stmt: Stmt, mod_path: string, exported: bool, rest: ModuleItem) -> ModuleItem {
    match stmt {
        .Function(name, _, _, _) -> {
            let canonical = mod_path + "::" + name
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .ExternFn(name, _, _) -> {
            // Extern fns keep bare names (C ABI) but are registered
            // for visibility tracking
            ModuleItem.Node(name, name, true, rest)
        }
        .TypeDecl(name, _) -> {
            let canonical = mod_path + "::" + name
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .EnumDecl(name, _) -> {
            let canonical = mod_path + "::" + name
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .TraitDecl(name, _) -> {
            let canonical = mod_path + "::" + name
            ModuleItem.Node(name, canonical, exported, rest)
        }
        .Impl(_, methods) -> collect_impl_items(methods, mod_path, rest)
        .Annotated(annotations, inner) -> {
            let is_export = annotation_has_export(annotations)
            collect_item_from_stmt(inner, mod_path, is_export, rest)
        }
        _ -> rest
    }
}

fn collect_impl_items(stmts: StmtList, mod_path: string, rest: ModuleItem) -> ModuleItem {
    match stmts {
        .End -> rest
        .Node(ss, next) -> {
            let with_this = match stmt_unwrap(ss.node) {
                .Function(name, _, _, _) -> {
                    // Impl methods are already mangled as Type__method.
                    // Keep bare name — method call codegen uses Type__method directly.
                    ModuleItem.Node(name, name, true, rest)
                }
                _ -> rest
            }
            collect_impl_items(next, mod_path, with_this)
        }
    }
}

fn annotation_has_export(annotations: AnnotationList) -> bool {
    match annotations {
        .End -> false
        .Node(name, _, next) -> {
            if name == "export" { return true }
            annotation_has_export(next)
        }
    }
}

// ── Pass 2: Resolve use aliases ──
//
// Walk the AST and for each Stmt.Use, look up the imported names in
// the module tree and build an alias table for the containing scope.

fn resolve_use_aliases(stmts: StmtList, tree: ModuleNode) -> UseResult {
    match stmts {
        .End -> UseResult { aliases: AliasEntry.End, bag: bag_new() }
        .Node(ss, next) -> {
            let rest = resolve_use_aliases(next, tree)
            match ss.node {
                .Use(mod_path, names) -> {
                    let canonical_path = dots_to_colons(mod_path)
                    resolve_use_names(canonical_path, names, tree, rest)
                }
                _ -> rest
            }
        }
    }
}

// Use resolution result — carries aliases + diagnostics bag.
type UseResult = {
    aliases: AliasEntry,
    bag: DiagnosticBag,
}

fn resolve_use_names(mod_path: string, names: ParamList, tree: ModuleNode, result: UseResult) -> UseResult {
    match names {
        .End -> result
        .Node(name, _, next) -> {
            let mod_node = module_find(tree, mod_path)
            let found_info = match mod_node {
                .End -> {
                    let d = diag_error(DiagCode.ImportNotFound, "`use " + mod_path + "` — module not found in module tree", span_dummy())
                    UseResult { aliases: result.aliases, bag: bag_report(result.bag, d) }
                }
                .Node(_, _, items, _, _) -> {
                    let found = item_lookup(items, name)
                    if found == "" {
                        let d = diag_error(DiagCode.ImportNotFound, "`" + name + "` not found in module `" + mod_path + "`", span_dummy())
                        UseResult { aliases: result.aliases, bag: bag_report(result.bag, d) }
                    } else if !item_is_exported(items, name) {
                        let d = diag_error(DiagCode.ImportPrivate, "`" + name + "` is private in module `" + mod_path + "`", span_dummy())
                        UseResult { aliases: result.aliases, bag: bag_report(result.bag, d) }
                    } else {
                        UseResult { aliases: AliasEntry.Node(name, found, result.aliases), bag: result.bag }
                    }
                }
                _ -> result
            }
            resolve_use_names(mod_path, next, tree, found_info)
        }
        _ -> result
    }
}

fn dots_to_colons(path: string) -> string {
    mut result = ""
    mut i = 0
    let len = path.length
    while i < len {
        let ch = path[i]
        if ch == "." {
            result = result + "::"
        } else {
            result = result + ch
        }
        i = i + 1
    }
    result
}

// ── Pass 3: Rewrite identifiers ──
//
// Walk all expressions in the AST. For each Expr.Ident that references
// a module-level item (via use aliases or implicit sibling access),
// rewrite it to Expr.QualifiedIdent with the canonical path.
//
// Local variables (let/mut/fn params/for/match bindings) are tracked
// in a scope stack and are NOT rewritten — they stay as Expr.Ident.

enum LocalScope {
    End
    Node(name: string, next: LocalScope)
}

fn scope_has(scope: LocalScope, name: string) -> bool {
    match scope {
        .End -> false
        .Node(n, next) -> {
            if n == name { return true }
            scope_has(next, name)
        }
    }
}

// Builtin functions that should never be qualified
fn is_builtin_name(name: string) -> bool {
    name == "println" || name == "eprintln" || name == "print" || name == "eprint" ||
    name == "string" || name == "int" || name == "float" || name == "panic" ||
    name == "exit" || name == "self"
}


// ── Name resolution context ──

type NameCtx = {
    tree: ModuleNode,
    aliases: AliasEntry,
    current_module: string,
    locals: LocalScope,
    // Flat index of ALL items across ALL modules — O(1) lookup
    // by short name. Built once in resolve_names, used by the
    // global search fallback in rewrite_ident.
    global_index: ModuleItem,
}

fn ctx_with_locals(ctx: NameCtx, locals: LocalScope) -> NameCtx {
    NameCtx { tree: ctx.tree, aliases: ctx.aliases, current_module: ctx.current_module, locals, global_index: ctx.global_index }
}

fn ctx_with_module(ctx: NameCtx, current_module: string, aliases: AliasEntry) -> NameCtx {
    NameCtx { tree: ctx.tree, aliases, current_module, locals: ctx.locals, global_index: ctx.global_index }
}

fn bind_params_ctx(ctx: NameCtx, params: ParamList) -> NameCtx {
    match params {
        .End -> ctx
        .Node(name, _, next) -> bind_params_ctx(ctx_with_locals(ctx, LocalScope.Node(name, ctx.locals)), next)
        _ -> ctx
    }
}

fn bind_pattern_ctx(ctx: NameCtx, pattern: Pattern) -> NameCtx {
    match pattern {
        .Wildcard -> ctx
        .Variant(_, bindings) -> bind_params_ctx(ctx, bindings)
        .NestedVariant(_, sub_pats) -> bind_pattern_list(ctx, sub_pats)
        _ -> ctx  // LitString, LitInt, LitBool, LitFloat — no bindings
    }
}

fn bind_pattern_list(ctx: NameCtx, pats: PatternList) -> NameCtx {
    match pats {
        .End -> ctx
        .Node(pat, next) -> bind_pattern_list(bind_pattern_ctx(ctx, pat), next)
        _ -> ctx
    }
}


fn merge_aliases(base: AliasEntry, extra: AliasEntry) -> AliasEntry {
    match extra {
        .End -> base
        .Node(short, canonical, next) -> merge_aliases(AliasEntry.Node(short, canonical, base), next)
    }
}

// ── Public entry point ──

export type NameResolveResult = {
    stmts: StmtList,
    had_error: bool,
    error_message: string,
    bag: DiagnosticBag,
}

export fn resolve_names(stmts: StmtList) -> NameResolveResult {
    let tree = build_module_tree(stmts, "", ModuleNode.End)
    let use_result = resolve_use_aliases(stmts, tree)
    let global_index = build_global_index(tree, ModuleItem.End)
    let ctx = NameCtx { tree, aliases: use_result.aliases, current_module: "", locals: LocalScope.End, global_index }
    let rewritten = rewrite_stmt_list(ctx, stmts)
    let has_errors = bag_has_errors(use_result.bag)
    NameResolveResult {
        stmts: rewritten,
        had_error: has_errors,
        error_message: if has_errors { "module resolution errors" } else { "" },
        bag: use_result.bag,
    }
}

// ── Statement rewriting ──

fn rewrite_stmt_list(ctx: NameCtx, stmts: StmtList) -> StmtList {
    match stmts {
        .End -> StmtList.End
        .Node(ss, next) -> StmtList.Node(sstmt(rewrite_stmt(ctx, ss.node), ss.line, ss.col), rewrite_stmt_list(ctx, next))
    }
}

fn rewrite_stmt(ctx: NameCtx, stmt: Stmt) -> Stmt {
    match stmt {
        .Let(name, ty, init) -> Stmt.Let(name, ty, rewrite_expr(ctx, init))
        .Mut(name, ty, init) -> Stmt.Mut(name, ty, rewrite_expr(ctx, init))
        .Expr(e) -> Stmt.Expr(rewrite_expr(ctx, e))
        .Return(e) -> Stmt.Return(rewrite_expr(ctx, e))
        .Block(body) -> Stmt.Block(rewrite_stmt_list(ctx, body))
        .If(cond, then_b, else_b) -> {
            let new_else = if else_b != null { rewrite_stmt(ctx, else_b!) } else { null }
            Stmt.If(rewrite_expr(ctx, cond), rewrite_stmt(ctx, then_b), new_else)
        }
        .While(cond, body) -> Stmt.While(rewrite_expr(ctx, cond), rewrite_stmt(ctx, body))
        .For(var, start, end, body) -> Stmt.For(var, rewrite_expr(ctx, start), rewrite_expr(ctx, end), rewrite_stmt(ctx, body))
        .ForIn(var, coll, body) -> Stmt.ForIn(var, rewrite_expr(ctx, coll), rewrite_stmt(ctx, body))
        .Function(name, params, ret_ty, body) -> {
            let is_impl_method = name.contains("__")
            let qualified = if ctx.current_module != "" && name != "main" && !is_impl_method { ctx.current_module + "::" + name } else { name }
            Stmt.Function(qualified, params, ret_ty, rewrite_stmt_list(bind_params_ctx(ctx, params), body))
        }
        .Match(subject, arms) -> Stmt.Match(rewrite_expr(ctx, subject), rewrite_match_arms(ctx, arms))
        .Module(name, body) -> {
            let mod_path = if ctx.current_module == "" { name } else { ctx.current_module + "::" + name }
            let mod_uses = resolve_use_aliases(body, ctx.tree)
            Stmt.Module(name, rewrite_stmt_list(ctx_with_module(ctx, mod_path, merge_aliases(ctx.aliases, mod_uses.aliases)), body))
        }
        .Impl(type_name, methods) -> Stmt.Impl(type_name, rewrite_stmt_list(ctx, methods))
        .Annotated(annotations, inner) -> Stmt.Annotated(annotations, rewrite_stmt(ctx, inner))
        .Defer(body) -> Stmt.Defer(rewrite_expr(ctx, body))
        .LetDestructure(names, init) -> Stmt.LetDestructure(names, rewrite_expr(ctx, init))
        _ -> stmt
    }
}

// ── Expression rewriting ──

fn rewrite_expr(ctx: NameCtx, expr: Expr) -> Expr {
    if expr == null { return Expr.Null }
    match expr {
        .Ident(name) -> rewrite_ident(ctx, name, expr)
        .Call(callee, args) -> Expr.Call(rewrite_expr(ctx, callee), rewrite_expr_list(ctx, args))
        .Binary(l, op, r) -> Expr.Binary(rewrite_expr(ctx, l), op, rewrite_expr(ctx, r))
        .Unary(op, r) -> Expr.Unary(op, rewrite_expr(ctx, r))
        .Logical(l, op, r) -> Expr.Logical(rewrite_expr(ctx, l), op, rewrite_expr(ctx, r))
        .Grouping(inner) -> Expr.Grouping(rewrite_expr(ctx, inner))
        .Assign(name, val) -> Expr.Assign(name, rewrite_expr(ctx, val))
        .Index(obj, idx) -> Expr.Index(rewrite_expr(ctx, obj), rewrite_expr(ctx, idx))
        .Try(inner) -> Expr.Try(rewrite_expr(ctx, inner))
        .Block(body) -> Expr.Block(rewrite_stmt_list(ctx, body))
        _ -> rewrite_expr_compound(ctx, expr)
    }
}

fn rewrite_expr_compound(ctx: NameCtx, expr: Expr) -> Expr {
    if expr == null { return Expr.Null }
    match expr {
        .FieldAccess(obj, field) -> Expr.FieldAccess(rewrite_expr(ctx, obj), field)
        .FieldAssign(obj, field, val) -> Expr.FieldAssign(rewrite_expr(ctx, obj), field, rewrite_expr(ctx, val))
        .IfExpr(c, t, e) -> Expr.IfExpr(rewrite_expr(ctx, c), rewrite_expr(ctx, t), rewrite_expr(ctx, e))
        .NullCoalesce(l, r) -> Expr.NullCoalesce(rewrite_expr(ctx, l), rewrite_expr(ctx, r))
        .OptionalChain(obj, field) -> Expr.OptionalChain(rewrite_expr(ctx, obj), field)
        .Tuple(elems) -> Expr.Tuple(rewrite_expr_list(ctx, elems))
        .TupleIndex(obj, idx) -> Expr.TupleIndex(rewrite_expr(ctx, obj), idx)
        .ListLit(elems) -> Expr.ListLit(rewrite_expr_list(ctx, elems))
        .MapLit(entries) -> Expr.MapLit(rewrite_expr_list(ctx, entries))
        .Slice(obj, s, e) -> Expr.Slice(rewrite_expr(ctx, obj), rewrite_expr(ctx, s), rewrite_expr(ctx, e))
        .With(obj, overrides) -> Expr.With(rewrite_expr(ctx, obj), rewrite_field_inits(ctx, overrides))
        .StructLit(name, inits) -> Expr.StructLit(name, rewrite_field_inits(ctx, inits))
        .EnumCtor(type_name, variant, args) -> Expr.EnumCtor(type_name, variant, rewrite_expr_list(ctx, args))
        .MatchExpr(subject, arms) -> Expr.MatchExpr(rewrite_expr(ctx, subject), rewrite_match_arms(ctx, arms))
        .Lambda(params, body) -> Expr.Lambda(params, rewrite_expr(bind_params_ctx(ctx, params), body))
        .IsCheck(subject, variant) -> Expr.IsCheck(rewrite_expr(ctx, subject), variant)
        _ -> expr
    }
}

fn rewrite_ident(ctx: NameCtx, name: string, original: Expr) -> Expr {
    // 1. Local variable — don't rewrite
    if scope_has(ctx.locals, name) { return original }
    // 2. Builtin function — don't rewrite
    if is_builtin_name(name) { return original }
    // 3. Uppercase = type/enum name — resolved by codegen registries
    if name.length > 0 && name[0] >= "A" && name[0] <= "Z" { return original }
    // 4. Use alias (from `use path.{name}`)
    let from_alias = alias_lookup(ctx.aliases, name)
    if from_alias != "" { return Expr.QualifiedIdent(from_alias) }
    // 5. Sibling in current module
    if ctx.current_module != "" {
        let mod_node = module_find(ctx.tree, ctx.current_module)
        let from_sibling = match mod_node {
            .End -> ""
            .Node(_, _, items, _, _) -> item_lookup(items, name)
            _ -> ""
        }
        if from_sibling != "" { return Expr.QualifiedIdent(from_sibling) }
    }
    // 6. Global index — flat scan of all module items (O(m) not O(n*m))
    let from_global = item_lookup(ctx.global_index, name)
    if from_global != "" { return Expr.QualifiedIdent(from_global) }
    original
}

fn rewrite_expr_list(ctx: NameCtx, exprs: ExprList) -> ExprList {
    match exprs {
        .End -> ExprList.End
        .Node(se, next) -> ExprList.Node(sexpr(rewrite_expr(ctx, se.node), se.line, se.col), rewrite_expr_list(ctx, next))
    }
}

fn rewrite_field_inits(ctx: NameCtx, inits: FieldInitList) -> FieldInitList {
    match inits {
        .End -> FieldInitList.End
        .Node(name, se, next) -> FieldInitList.Node(name, sexpr(rewrite_expr(ctx, se.node), se.line, se.col), rewrite_field_inits(ctx, next))
    }
}

fn rewrite_match_arms(ctx: NameCtx, arms: MatchArmList) -> MatchArmList {
    match arms {
        .End -> MatchArmList.End
        .Node(pattern, guard, body, next) -> {
            let arm_ctx = bind_pattern_ctx(ctx, pattern)
            let new_guard = if guard != null { sexpr(rewrite_expr(arm_ctx, guard!.node), guard!.line, guard!.col) } else { null }
            MatchArmList.Node(pattern, new_guard, sexpr(rewrite_expr(arm_ctx, body.node), body.line, body.col), rewrite_match_arms(ctx, next))
        }
    }
}
