// WHY: token representation — used by the standalone scanner (core/scanner.fg)
// for the `tokens` command. The parser has its own built-in lexer and does
// not use these types.

export type Token = {
    kind: string,
    lexeme: string,
    line: int,
    column: int,
}

export fn token_new(kind: string, lexeme: string, line: int, column: int) -> Token {
    Token { kind, lexeme, line, column }
}

fn escape_lexeme(text: string) -> string {
    mut out = ""
    for i in 0..text.length {
        let ch = text[i]
        if ch == "\\" {
            out = out + "\\\\"
        } else if ch == "\"" {
            out = out + "\\\""
        } else if ch == "\n" {
            out = out + "\\n"
        } else if ch == "\r" {
            out = out + "\\r"
        } else if ch == "\t" {
            out = out + "\\t"
        } else {
            out = out + ch
        }
    }
    out
}

export fn token_render(kind: string, lexeme: string, line: int, column: int) -> string {
    string(line) + ":" + string(column) + " " + kind + " \"" + escape_lexeme(lexeme) + "\""
}

export fn token_render_struct(token: Token) -> string {
    token_render(token.kind, token.lexeme, token.line, token.column)
}
