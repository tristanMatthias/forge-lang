// WHY: name resolution pass — checks that every variable reference
// has a visible declaration before codegen runs. Tracks scopes via
// a linked-list stack; functions are pre-declared so mutual
// recursion works.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldInitList, MatchArmList, Pattern, PatternList, SExpr, SStmt}
use diagnostics.{DiagCode, DiagnosticBag, bag_new, bag_report, bag_has_errors, diag_error, diag_with_help, span_dummy}

export type ResolveResult = {
    had_error: bool,
    error_message: string,
    bag: DiagnosticBag,
}

enum ScopeEntry {
    End
    Node(name: string, defined: bool, mutable: bool, depth: int, next: ScopeEntry)
}

enum FnEntry {
    End
    Node(name: string, next: FnEntry)
}

type Resolver = {
    scopes: ScopeEntry,
    functions: FnEntry,
    depth: int,
    had_error: bool,
    error_message: string,
    bag: DiagnosticBag,
}

export fn resolve_program(stmts: StmtList) -> ResolveResult {
    mut r = resolver_new()
    r = collect_function_names(r, stmts)
    r = resolve_stmt_list(r, stmts)
    ResolveResult {
        had_error: r.had_error,
        error_message: r.error_message,
        bag: r.bag,
    }
}

fn collect_function_names(r: Resolver, stmts: StmtList) -> Resolver {
    mut current = stmts
    mut res = r
    while true {
        match current {
            .End -> { return res }
            .Node(ss, next) -> {
                res = match stmt_unwrap(ss.node) {
                    .Function(name, _, _, _) -> declare_function(res, name)
                    .ExternFn(name, _, _) -> declare_function(res, name)
                    .Impl(type_name, methods) -> collect_method_names(res, type_name, methods)
                    _ -> res
                }
                current = next
            }
        }
    }
    res
}

fn collect_method_names(r: Resolver, type_name: string, methods: StmtList) -> Resolver {
    mut current = methods
    mut res = r
    while true {
        match current {
            .End -> { return res }
            .Node(ss, next) -> {
                res = match stmt_unwrap(ss.node) {
                    .Function(name, _, _, _) -> declare_function(res, name)
                    _ -> res
                }
                current = next
            }
        }
    }
    res
}

fn resolver_new() -> Resolver {
    Resolver {
        scopes: ScopeEntry.End,
        functions: FnEntry.End,
        depth: 0,
        had_error: false,
        error_message: "",
        bag: bag_new(),
    }
}

fn set_resolve_error(r: Resolver, message: string) -> Resolver {
    resolve_report(r, DiagCode.UndefinedVariable, message)
}

fn resolve_report(r: Resolver, code: DiagCode, message: string) -> Resolver {
    let diag = diag_error(code, message, span_dummy())
    r with {
        had_error: true,
        error_message: if r.error_message.length == 0 { "resolve error: " + message } else { r.error_message },
        bag: bag_report(r.bag, diag),
    }
}

fn enter_resolve_scope(r: Resolver) -> Resolver {
    r with { depth: r.depth + 1 }
}

fn exit_resolve_scope(r: Resolver) -> Resolver {
    r with { scopes: pop_resolve_scope(r.scopes, r.depth), depth: r.depth - 1 }
}

fn pop_resolve_scope(entries: ScopeEntry, depth: int) -> ScopeEntry {
    match entries {
        .End -> ScopeEntry.End
        .Node(name, defined, is_mut, entry_depth, next) -> {
            if entry_depth == depth {
                return pop_resolve_scope(next, depth)
            }
            ScopeEntry.Node(name, defined, is_mut, entry_depth, next)
        }
    }
}

fn declare_name(r: Resolver, name: string) -> Resolver {
    declare_name_mut(r, name, false)
}

fn declare_name_mutable(r: Resolver, name: string) -> Resolver {
    declare_name_mut(r, name, true)
}

fn declare_name_mut(r: Resolver, name: string, is_mut: bool) -> Resolver {
    r with { scopes: ScopeEntry.Node(name, false, is_mut, r.depth, r.scopes) }
}

fn define_name(r: Resolver, name: string) -> Resolver {
    r with { scopes: mark_defined(r.scopes, name, r.depth) }
}

fn define_param_names(r: Resolver, params: ParamList) -> Resolver {
    match params {
        .End -> r
        .Node(name, _, next) -> {
            let after = declare_name(r, name)
            let defined = define_name(after, name)
            define_param_names(defined, next)
        }
    }
}

fn mark_defined(entries: ScopeEntry, name: string, depth: int) -> ScopeEntry {
    match entries {
        .End -> ScopeEntry.End
        .Node(entry_name, defined, is_mut, entry_depth, next) -> {
            if entry_name == name && entry_depth == depth {
                return ScopeEntry.Node(entry_name, true, is_mut, entry_depth, next)
            }
            ScopeEntry.Node(entry_name, defined, is_mut, entry_depth, mark_defined(next, name, depth))
        }
    }
}

fn declare_function(r: Resolver, name: string) -> Resolver {
    r with { functions: FnEntry.Node(name, r.functions) }
}

type NameLookup = {
    found: bool,
    defined: bool,
    mutable: bool,
}

fn lookup_name(entries: ScopeEntry, name: string) -> NameLookup {
    match entries {
        .End -> NameLookup { found: false, defined: false, mutable: false }
        .Node(entry_name, defined, is_mut, _, next) -> {
            if entry_name == name {
                return NameLookup { found: true, defined, mutable: is_mut }
            }
            lookup_name(next, name)
        }
    }
}

fn lookup_fn(fns: FnEntry, name: string) -> bool {
    match fns {
        .End -> false
        .Node(fn_name, next) -> {
            if fn_name == name {
                return true
            }
            lookup_fn(next, name)
        }
    }
}

fn is_builtin(name: string) -> bool {
    if name == "println" { return true }
    if name == "eprintln" { return true }
    if name == "string" { return true }
    if name == "int" { return true }
    if name == "float" { return true }
    if name == "panic" { return true }
    if name == "self" { return true }
    false
}

fn resolve_stmt_list(r: Resolver, stmts: StmtList) -> Resolver {
    mut current = stmts
    mut res = r
    while true {
        if res.had_error { return res }
        match current {
            .End -> { return res }
            .Node(ss, next) -> {
                res = resolve_stmt(res, ss.node)
                current = next
            }
        }
    }
    res
}

fn resolve_stmt(r: Resolver, stmt: Stmt) -> Resolver {
    if r.had_error {
        return r
    }
    match stmt {
        .Let(name, _, initializer) -> {
            let declared = declare_name(r, name)  // immutable
            let after_init = resolve_expr(declared, initializer)
            define_name(after_init, name)
        }
        .Mut(name, _, initializer) -> {
            let declared = declare_name_mutable(r, name)  // mutable
            let after_init = resolve_expr(declared, initializer)
            define_name(after_init, name)
        }
        .Expr(expr) -> resolve_expr(r, expr)
        .Block(body) -> {
            let entered = enter_resolve_scope(r)
            let after = resolve_stmt_list(entered, body)
            exit_resolve_scope(after)
        }
        .If(condition, then_branch, else_branch) -> {
            let after_cond = resolve_expr(r, condition)
            let after_then = resolve_stmt(after_cond, then_branch)
            if else_branch != null {
                return resolve_stmt(after_then, else_branch!)
            }
            after_then
        }
        .While(condition, body) -> {
            let after_cond = resolve_expr(r, condition)
            resolve_stmt(after_cond, body)
        }
        .Function(name, params, _, body) -> {
            let with_fn = declare_function(r, name)
            let entered = enter_resolve_scope(with_fn)
            let with_params = declare_params(entered, params)
            let after_body = resolve_stmt_list(with_params, body)
            exit_resolve_scope(after_body)
        }
        .Return(value) -> resolve_expr(r, value)
        .ReturnEmpty -> r
        .TypeDecl(_, _) -> r
        .EnumDecl(_, _) -> r
        .Match(subject, arms) -> {
            let after_subject = resolve_expr(r, subject)
            resolve_match_arms(after_subject, arms)
        }
        .For(variable, start, end, body) -> {
            let after_start = resolve_expr(r, start)
            let after_end = resolve_expr(after_start, end)
            let entered = enter_resolve_scope(after_end)
            let declared = declare_name(entered, variable)
            let defined = define_name(declared, variable)
            let after_body = resolve_stmt(defined, body)
            exit_resolve_scope(after_body)
        }
        .ForIn(variable, collection, body) -> {
            let after_coll = resolve_expr(r, collection)
            let entered = enter_resolve_scope(after_coll)
            let declared = declare_name(entered, variable)
            let defined = define_name(declared, variable)
            let after_body = resolve_stmt(defined, body)
            exit_resolve_scope(after_body)
        }
        .Impl(_, methods) -> resolve_stmt_list(r, methods)
        .NoOp -> r
        .ExternFn(name, _, _) -> declare_function(r, name)
        .Break -> r
        .Continue -> r
        .TraitDecl(_, _) -> r  // trait declarations are no-ops
        .LetDestructure(names, initializer) -> {
            let after_init = resolve_expr(r, initializer)
            define_param_names(after_init, names)
        }
        .Defer(body) -> resolve_expr(r, body)
        .Annotated(_, inner) -> resolve_stmt(r, inner)
        .SpecBlock(_, body) -> resolve_stmt_list(r, body)
        .GivenBlock(_, body) -> resolve_stmt_list(r, body)
        .ThenBlock(_, cond) -> resolve_expr(r, cond)
        .Select(arms) -> resolve_select_arms(r, arms)
    }
}

fn resolve_select_arms(r: Resolver, arms: SelectArmList) -> Resolver {
    match arms {
        .End -> r
        .Node(binding, channel, body, next) -> {
            let after_ch = resolve_expr(r, channel)
            let scoped = enter_resolve_scope(after_ch)
            let with_binding = declare_name(scoped, binding)
            let defined = define_name(with_binding, binding)
            let after_body = resolve_stmt_list(defined, body)
            let exited = exit_resolve_scope(after_body)
            resolve_select_arms(exited, next)
        }
    }
}

fn resolve_match_arms(r: Resolver, arms: MatchArmList) -> Resolver {
    mut current = arms
    mut res = r
    while true {
        if res.had_error { return res }
        match current {
            .End -> { return res }
            .Node(pattern, guard, body, next) -> {
                let entered = enter_resolve_scope(res)
                let with_bindings = declare_pattern_bindings(entered, pattern)
                let after_guard = if guard != null { resolve_expr(with_bindings, guard!.node) } else { with_bindings }
                let after_body = resolve_expr(after_guard, body.node)
                res = exit_resolve_scope(after_body)
                current = next
            }
        }
    }
    res
}

fn declare_pattern_bindings(r: Resolver, pattern: Pattern) -> Resolver {
    match pattern {
        .Wildcard -> r
        .Variant(_, bindings) -> declare_params(r, bindings)
        .NestedVariant(_, sub_pats) -> declare_pattern_list(r, sub_pats)
        _ -> r  // Literal patterns don't bind variables
    }
}

fn declare_pattern_list(r: Resolver, pats: PatternList) -> Resolver {
    match pats {
        .End -> r
        .Node(p, next) -> declare_pattern_list(declare_pattern_bindings(r, p), next)
    }
}

fn declare_params(r: Resolver, params: ParamList) -> Resolver {
    mut current = params
    mut res = r
    while true {
        match current {
            .End -> { return res }
            .Node(name, _, next) -> {
                let declared = declare_name(res, name)
                res = define_name(declared, name)
                current = next
            }
        }
    }
    res
}

fn resolve_expr(r: Resolver, expr: Expr) -> Resolver {
    if r.had_error {
        return r
    }
    match expr {
        .Number(_) -> r
        .FloatLit(_) -> r
        .String(_) -> r
        .Bool(_) -> r
        .Null -> r
        .Ident(name) -> {
            if is_builtin(name) {
                return r
            }
            // Uppercase identifiers are treated as type names — the
            // resolver doesn't track them, codegen does.
            if starts_with_upper(name) {
                return r
            }
            let result = lookup_name(r.scopes, name)
            if result.found {
                if !result.defined {
                    return set_resolve_error(r, "cannot read variable `" + name + "` in its own initializer")
                }
                return r
            }
            if lookup_fn(r.functions, name) {
                return r
            }
            set_resolve_error(r, "undefined variable `" + name + "`")
        }
        .Assign(name, value) -> {
            let after_value = resolve_expr(r, value)
            // Uppercase names are treated as opaque mut globals.
            if starts_with_upper(name) {
                return after_value
            }
            let result = lookup_name(after_value.scopes, name)
            if !result.found {
                return set_resolve_error(after_value, "undefined variable `" + name + "`")
            }
            if !result.mutable {
                return resolve_report(after_value, DiagCode.ImmutableAssign, "cannot assign to immutable variable `" + name + "`")
            }
            after_value
        }
        .Grouping(inner) -> resolve_expr(r, inner)
        .Unary(_, right) -> resolve_expr(r, right)
        .Binary(left, _, right) -> {
            let after_left = resolve_expr(r, left)
            resolve_expr(after_left, right)
        }
        .Logical(left, _, right) -> {
            let after_left = resolve_expr(r, left)
            resolve_expr(after_left, right)
        }
        .Call(callee, args) -> {
            let after_callee = resolve_expr(r, callee)
            resolve_expr_list(after_callee, args)
        }
        .StructLit(_, inits) -> resolve_field_init_list(r, inits)
        .FieldAccess(obj, _) -> {
            // `Type.Variant` (a zero-arg enum constructor) is parsed
            // as FieldAccess(Ident(Type), Variant). Skip the inner
            // Ident lookup when it starts with an uppercase letter
            // because it's a type name, not a runtime value.
            // Codegen does the actual validity check against the
            // enum/struct registries.
            match obj {
                .Ident(name) -> {
                    if starts_with_upper(name) {
                        return r
                    }
                    resolve_expr(r, obj)
                }
                _ -> resolve_expr(r, obj)
            }
        }
        .EnumCtor(_, _, args) -> resolve_expr_list(r, args)
        .Index(obj, idx) -> {
            let after_obj = resolve_expr(r, obj)
            resolve_expr(after_obj, idx)
        }
        .Block(body) -> {
            let entered = enter_resolve_scope(r)
            let after = resolve_stmt_list(entered, body)
            exit_resolve_scope(after)
        }
        .MatchExpr(subject, arms) -> {
            let after_subject = resolve_expr(r, subject)
            resolve_match_arms(after_subject, arms)
        }
        .FieldAssign(obj, _, value) -> {
            let after_obj = resolve_expr(r, obj)
            resolve_expr(after_obj, value)
        }
        .IfExpr(c, t, e) -> {
            let after_c = resolve_expr(r, c)
            let after_t = resolve_expr(after_c, t)
            resolve_expr(after_t, e)
        }
        .NullCoalesce(left, right) -> {
            let after_left = resolve_expr(r, left)
            resolve_expr(after_left, right)
        }
        .OptionalChain(obj, _) -> resolve_expr(r, obj)
        .Try(inner) -> resolve_expr(r, inner)
        .Tuple(elements) -> resolve_expr_list(r, elements)
        .TupleIndex(obj, _) -> resolve_expr(r, obj)
        .ListLit(elements) -> resolve_expr_list(r, elements)
        .MapLit(entries) -> resolve_expr_list(r, entries)
        .Slice(obj, start, end) -> {
            let a = resolve_expr(r, obj)
            let b = resolve_expr(a, start)
            resolve_expr(b, end)
        }
        .Lambda(params, body) -> {
            let entered = enter_resolve_scope(r)
            let with_params = declare_params(entered, params)
            let after_body = resolve_expr(with_params, body)
            exit_resolve_scope(after_body)
        }
        .With(obj, overrides) -> {
            let after_obj = resolve_expr(r, obj)
            resolve_field_init_list(after_obj, overrides)
        }
        .IsCheck(subject, _) -> resolve_expr(r, subject)
    }
}

fn starts_with_upper(name: string) -> bool {
    if name.length < 1 {
        return false
    }
    let head = name.substring(0, 1)
    head >= "A" && head <= "Z"
}

fn resolve_field_init_list(r: Resolver, inits: FieldInitList) -> Resolver {
    mut current = inits
    mut res = r
    while true {
        if res.had_error { return res }
        match current {
            .End -> { return res }
            .Node(_, sv, next) -> {
                res = resolve_expr(res, sv.node)
                current = next
            }
        }
    }
    res
}

fn resolve_expr_list(r: Resolver, exprs: ExprList) -> Resolver {
    mut current = exprs
    mut res = r
    while true {
        if res.had_error { return res }
        match current {
            .End -> { return res }
            .Node(se, next) -> {
                res = resolve_expr(res, se.node)
                current = next
            }
        }
    }
    res
}
