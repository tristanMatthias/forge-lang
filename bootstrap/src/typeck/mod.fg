// WHY: type checker — walks the AST after name resolution and
// computes a ValueType for every expression. Reports type errors
// via DiagnosticBag. Currently ADDITIVE ONLY — runs alongside
// codegen, doesn't gate it, doesn't modify the AST. Once it
// produces zero false positives on self-compilation, we flip it
// to gating and start simplifying codegen.

use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, MatchArmList, Pattern, ValueType, TypeList, BinOp, vtype_display, vtype_eq, vtype_list_elem, vtype_fn_ret, vtype_tuple_at}
use diagnostics.{DiagCode, DiagnosticBag, bag_new, bag_report, bag_has_errors, diag_error, diag_with_help, span_dummy}

// ── Type environment ──

enum TypeEntry {
    End
    Node(name: string, ty: ValueType, depth: int, next: TypeEntry)
}

fn type_lookup(env: TypeEntry, name: string) -> ValueType {
    match env {
        .End -> ValueType.Int  // fallback — resolver already caught undefined
        .Node(n, ty, _, next) -> {
            if n == name { return ty }
            type_lookup(next, name)
        }
    }
}

fn type_bind(env: TypeEntry, name: string, ty: ValueType, depth: int) -> TypeEntry {
    TypeEntry.Node(name, ty, depth, env)
}

fn type_pop_scope(env: TypeEntry, depth: int) -> TypeEntry {
    match env {
        .End -> TypeEntry.End
        .Node(_, _, d, next) -> {
            if d >= depth { return type_pop_scope(next, depth) }
            env
        }
    }
}

// ── Function type registry ──

enum FnTypeEntry {
    End
    Node(name: string, params: ParamList, ret_ty: ValueType, next: FnTypeEntry)
}

fn fn_type_lookup(fns: FnTypeEntry, name: string) -> ValueType {
    match fns {
        .End -> ValueType.Int
        .Node(n, _, ret, next) -> {
            if n == name { return ret }
            fn_type_lookup(next, name)
        }
    }
}

fn fn_type_has(fns: FnTypeEntry, name: string) -> bool {
    match fns {
        .End -> false
        .Node(n, _, _, next) -> {
            if n == name { return true }
            fn_type_has(next, name)
        }
    }
}

fn tc_fn_arity(fns: FnTypeEntry, name: string) -> int {
    match fns {
        .End -> 0
        .Node(n, params, _, next) -> {
            if n == name { return param_list_length(params) }
            tc_fn_arity(next, name)
        }
    }
}

fn tc_count_args(list: ExprList) -> int {
    match list {
        .End -> 0
        .Node(_, next) -> 1 + tc_count_args(next)
    }
}

// ── Struct/Enum registries ──

enum StructTypeReg {
    End
    Node(name: string, fields: FieldList, next: StructTypeReg)
}

fn struct_type_lookup(reg: StructTypeReg, name: string) -> FieldList {
    match reg {
        .End -> FieldList.End
        .Node(n, fields, next) -> {
            if n == name { return fields }
            struct_type_lookup(next, name)
        }
    }
}

fn struct_type_has(reg: StructTypeReg, name: string) -> bool {
    match reg {
        .End -> false
        .Node(n, _, next) -> {
            if n == name { return true }
            struct_type_has(next, name)
        }
    }
}

enum EnumTypeReg {
    End
    Node(name: string, variants: VariantList, next: EnumTypeReg)
}

fn enum_type_has(reg: EnumTypeReg, name: string) -> bool {
    match reg {
        .End -> false
        .Node(n, _, next) -> {
            if n == name { return true }
            enum_type_has(next, name)
        }
    }
}

// ── Checker state ──

type TC = {
    types: TypeEntry,
    fns: FnTypeEntry,
    structs: StructTypeReg,
    enums: EnumTypeReg,
    depth: int,
    bag: DiagnosticBag,
}

type ExprResult = {
    tc: TC,
    ty: ValueType,
}

fn tc_new() -> TC {
    TC {
        types: TypeEntry.End,
        fns: FnTypeEntry.End,
        structs: StructTypeReg.End,
        enums: EnumTypeReg.End,
        depth: 0,
        bag: bag_new(),
    }
}

fn tc_enter(tc: TC) -> TC { tc with { depth: tc.depth + 1 } }
fn tc_exit(tc: TC) -> TC {
    tc with { types: type_pop_scope(tc.types, tc.depth), depth: tc.depth - 1 }
}
fn tc_bind(tc: TC, name: string, ty: ValueType) -> TC {
    tc with { types: type_bind(tc.types, name, ty, tc.depth) }
}
fn tc_report(tc: TC, code: DiagCode, message: string) -> TC {
    tc with { bag: bag_report(tc.bag, diag_error(code, message, span_dummy())) }
}

fn tc_er(tc: TC, ty: ValueType) -> ExprResult { ExprResult { tc, ty } }

// ── Type string translation ──

fn translate_type(tc: TC, ty: string) -> ValueType {
    if ty == "str" || ty == "string" { return ValueType.Str }
    if ty == "i64" || ty == "int" { return ValueType.Int }
    if ty == "bool" { return ValueType.Bool }
    if ty == "ptr" { return ValueType.Ptr }
    if ty == "fn" { return ValueType.Fn(ValueType.Int) }
    if ty == "List" { return ValueType.List(ValueType.Int) }
    if ty == "Map" { return ValueType.Map }
    if ty.length > 4 && ty.substring(0, 4) == "fn->" {
        let ret_name = ty.substring(4, ty.length)
        return ValueType.Fn(translate_type(tc, ret_name))
    }
    if enum_type_has(tc.enums, ty) { return ValueType.Enum(ty) }
    if struct_type_has(tc.structs, ty) { return ValueType.Struct(ty) }
    ValueType.Int
}

// ── Entry point ──

export type TypeCheckResult = {
    had_error: bool,
    bag: DiagnosticBag,
}

export fn typecheck_program(stmts: StmtList) -> TypeCheckResult {
    let tc0 = tc_new()
    // Pass 1: collect declarations (types, enums, functions)
    let tc1 = collect_decls(tc0, stmts)
    // Pass 2: check all statement bodies — DISABLED for debugging
    let tc2 = check_stmts(tc1, stmts)
    TypeCheckResult { had_error: bag_has_errors(tc2.bag), bag: tc2.bag }
}

// ── Pass 1: Declaration collection ──

fn collect_decls(tc: TC, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(stmt, next) -> {
            let updated = match stmt {
                .TypeDecl(name, fields) -> tc with {
                    structs: StructTypeReg.Node(name, fields, tc.structs)
                }
                .EnumDecl(name, variants) -> tc with {
                    enums: EnumTypeReg.Node(name, variants, tc.enums)
                }
                .Function(name, params, ret_ty, _) -> tc with {
                    fns: FnTypeEntry.Node(name, params, translate_type(tc, ret_ty), tc.fns)
                }
                .ExternFn(name, params, ret_ty) -> tc with {
                    fns: FnTypeEntry.Node(name, params, translate_type(tc, ret_ty), tc.fns)
                }
                .Impl(_, methods) -> collect_decls(tc, methods)
                _ -> tc
            }
            collect_decls(updated, next)
        }
    }
}

// ── Pass 2: Statement checking ──

fn check_stmts(tc: TC, stmts: StmtList) -> TC {
    match stmts {
        .End -> tc
        .Node(stmt, next) -> {
            let updated = check_stmt(tc, stmt)
            check_stmts(updated, next)
        }
    }
}

fn check_stmt(tc: TC, stmt: Stmt) -> TC {
    match stmt {
        .Let(name, ty_str, init) -> {
            let r = check_expr(tc, init)
            let declared_ty = if ty_str.length > 0 { translate_type(r.tc, ty_str) } else { r.ty }
            tc_bind(r.tc, name, declared_ty)
        }
        .Mut(name, ty_str, init) -> {
            let r = check_expr(tc, init)
            let declared_ty = if ty_str.length > 0 { translate_type(r.tc, ty_str) } else { r.ty }
            tc_bind(r.tc, name, declared_ty)
        }
        .Expr(e) -> {
            let r = check_expr(tc, e)
            r.tc
        }
        .Return(value) -> {
            let r = check_expr(tc, value)
            r.tc
        }
        .ReturnEmpty -> tc
        .Block(body) -> {
            let inner = tc_enter(tc)
            let checked = check_stmts(inner, body)
            tc_exit(checked)
        }
        .If(cond, then_branch, else_branch) -> {
            let c = check_expr(tc, cond)
            let after_then = check_stmt(c.tc, then_branch)
            if else_branch != null {
                return check_stmt(after_then, else_branch!)
            }
            after_then
        }
        .While(cond, body) -> {
            let c = check_expr(tc, cond)
            check_stmt(c.tc, body)
        }
        .For(variable, start, end, body) -> {
            let s = check_expr(tc, start)
            let e = check_expr(s.tc, end)
            let inner = tc_enter(e.tc)
            let bound = tc_bind(inner, variable, ValueType.Int)
            let after = check_stmt(bound, body)
            tc_exit(after)
        }
        .ForIn(variable, collection, body) -> {
            let c = check_expr(tc, collection)
            let elem_ty = vtype_list_elem(c.ty)
            let inner = tc_enter(c.tc)
            let bound = tc_bind(inner, variable, elem_ty)
            let after = check_stmt(bound, body)
            tc_exit(after)
        }
        .Function(name, params, ret_ty, body) -> {
            let inner = tc_enter(tc)
            let with_params = tc_bind_params(inner, params)
            let checked = check_stmts(with_params, body)
            tc_exit(checked)
        }
        .Match(subject, arms) -> {
            let s = check_expr(tc, subject)
            check_match_arms(s.tc, arms)
        }
        .Impl(_, methods) -> check_stmts(tc, methods)
        .LetDestructure(names, init) -> {
            let r = check_expr(tc, init)
            bind_destructure(r.tc, names, r.ty)
        }
        .Defer(body) -> {
            let r = check_expr(tc, body)
            r.tc
        }
        _ -> tc  // TypeDecl, EnumDecl, ExternFn, NoOp, Break, Continue, TraitDecl
    }
}

fn tc_bind_params(tc: TC, params: ParamList) -> TC {
    match params {
        .End -> tc
        .Node(name, ty_str, next) -> {
            let ty = if ty_str.length > 0 { translate_type(tc, ty_str) } else { ValueType.Int }
            tc_bind_params(tc_bind(tc, name, ty), next)
        }
    }
}

fn bind_destructure(tc: TC, names: ParamList, tuple_ty: ValueType) -> TC {
    bind_destructure_idx(tc, names, tuple_ty, 0)
}

fn bind_destructure_idx(tc: TC, names: ParamList, tuple_ty: ValueType, idx: int) -> TC {
    match names {
        .End -> tc
        .Node(name, _, next) -> {
            let elem_ty = vtype_tuple_at(tuple_ty, idx)
            bind_destructure_idx(tc_bind(tc, name, elem_ty), next, tuple_ty, idx + 1)
        }
    }
}

fn check_match_arms(tc: TC, arms: MatchArmList) -> TC {
    match arms {
        .End -> tc
        .Node(pattern, guard, body, next) -> {
            let inner = tc_enter(tc)
            // TODO: bind pattern variables
            let with_guard = if guard != null {
                let g = check_expr(inner, guard!)
                g.tc
            } else { inner }
            let b = check_expr(with_guard, body)
            let after = tc_exit(b.tc)
            check_match_arms(after, next)
        }
    }
}

// ── Expression checking ──

fn check_expr(tc: TC, expr: Expr) -> ExprResult {
    match expr {
        .Number(_) -> tc_er(tc, ValueType.Int)
        .String(_) -> tc_er(tc, ValueType.Str)
        .Bool(_) -> tc_er(tc, ValueType.Bool)
        .Null -> tc_er(tc, ValueType.Void)
        .Ident(name) -> {
            let ty = type_lookup(tc.types, name)
            // If not found in locals, check function registry
            if vtype_eq(ty, ValueType.Int) && fn_type_has(tc.fns, name) {
                return tc_er(tc, ValueType.Fn(fn_type_lookup(tc.fns, name)))
            }
            tc_er(tc, ty)
        }
        .Binary(left, op, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            check_binary_type(r.tc, l.ty, op, r.ty)
        }
        .Unary(_, right) -> {
            let r = check_expr(tc, right)
            tc_er(r.tc, r.ty)
        }
        .Logical(left, _, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            tc_er(r.tc, ValueType.Bool)
        }
        .Grouping(inner) -> check_expr(tc, inner)
        .Call(callee, args) -> check_call(tc, callee, args)
        .StructLit(name, inits) -> {
            let checked = check_field_inits(tc, inits)
            tc_er(checked, ValueType.Struct(name))
        }
        .FieldAccess(obj, field) -> check_field_access(tc, obj, field)
        .EnumCtor(type_name, _, args) -> {
            let checked = check_expr_list(tc, args)
            tc_er(checked, ValueType.Enum(type_name))
        }
        .Index(obj, idx) -> {
            let o = check_expr(tc, obj)
            let i = check_expr(o.tc, idx)
            let elem_ty = vtype_list_elem(o.ty)
            tc_er(i.tc, elem_ty)
        }
        .Block(body) -> check_block(tc, body)
        .MatchExpr(subject, arms) -> check_match_expr(tc, subject, arms)
        .FieldAssign(obj, _, value) -> {
            let o = check_expr(tc, obj)
            let v = check_expr(o.tc, value)
            tc_er(v.tc, v.ty)
        }
        .IfExpr(cond, then_branch, else_branch) -> {
            let c = check_expr(tc, cond)
            let t = check_expr(c.tc, then_branch)
            let e = check_expr(t.tc, else_branch)
            // Both branches should agree. Report if not.
            if !vtype_eq(t.ty, e.ty) {
                let msg = "if-expression branches have different types: `" + vtype_display(t.ty) + "` vs `" + vtype_display(e.ty) + "`"
                return tc_er(tc_report(e.tc, DiagCode.TypeMismatch, msg), t.ty)
            }
            tc_er(e.tc, t.ty)
        }
        .NullCoalesce(left, right) -> {
            let l = check_expr(tc, left)
            let r = check_expr(l.tc, right)
            tc_er(r.tc, r.ty)
        }
        .OptionalChain(obj, field) -> check_field_access(tc, obj, field)
        .Try(inner) -> check_expr(tc, inner)
        .Tuple(elements) -> {
            let pair = check_expr_list_types(tc, elements)
            tc_er(pair.tc, ValueType.Tuple(pair.types))
        }
        .TupleIndex(obj, idx) -> {
            let o = check_expr(tc, obj)
            tc_er(o.tc, vtype_tuple_at(o.ty, idx))
        }
        .With(obj, overrides) -> {
            let o = check_expr(tc, obj)
            let checked = check_field_inits(o.tc, overrides)
            tc_er(checked, o.ty)
        }
        .ListLit(elements) -> check_list_lit(tc, elements)
        .Lambda(params, body) -> {
            let inner = tc_enter(tc)
            let with_params = tc_bind_params(inner, params)
            let b = check_expr(with_params, body)
            let after = tc_exit(b.tc)
            tc_er(after, ValueType.Fn(b.ty))
        }
        .MapLit(entries) -> {
            let checked = check_expr_list(tc, entries)
            tc_er(checked, ValueType.Map)
        }
        .Slice(obj, start, end) -> {
            let o = check_expr(tc, obj)
            let s = check_expr(o.tc, start)
            let e = check_expr(s.tc, end)
            tc_er(e.tc, o.ty)
        }
        .Assign(name, value) -> {
            let v = check_expr(tc, value)
            tc_er(v.tc, v.ty)
        }
        _ -> tc_er(tc, ValueType.Int)
    }
}

// ── Binary operator type rules ──

fn check_binary_type(tc: TC, left: ValueType, op: BinOp, right: ValueType) -> ExprResult {
    match op {
        .Add -> {
            // String + anything = String
            if vtype_eq(left, ValueType.Str) || vtype_eq(right, ValueType.Str) {
                return tc_er(tc, ValueType.Str)
            }
            tc_er(tc, ValueType.Int)
        }
        .Eq -> tc_er(tc, ValueType.Bool)
        .Ne -> tc_er(tc, ValueType.Bool)
        .Lt -> tc_er(tc, ValueType.Bool)
        .Le -> tc_er(tc, ValueType.Bool)
        .Gt -> tc_er(tc, ValueType.Bool)
        .Ge -> tc_er(tc, ValueType.Bool)
        _ -> tc_er(tc, ValueType.Int)  // Sub, Mul, Div, Rem, bitwise
    }
}

// ── Call type inference ──

fn check_call(tc: TC, callee: Expr, args: ExprList) -> ExprResult {
    match callee {
        .Ident(name) -> {
            let checked = check_expr_list(tc, args)
            // Built-in functions
            if name == "string" { return tc_er(checked, ValueType.Str) }
            if name == "int" { return tc_er(checked, ValueType.Int) }
            if name == "println" || name == "eprintln" || name == "print" || name == "eprint" {
                return tc_er(checked, ValueType.Void)
            }
            // User-defined function
            if fn_type_has(checked.fns, name) {
                let expected = tc_fn_arity(checked.fns, name)
                let actual = tc_count_args(args)
                if expected != actual {
                    let msg = "`" + name + "` expects " + string(expected) + " argument" + if expected != 1 { "s" } else { "" } + ", got " + string(actual)
                    return tc_er(tc_report(checked, DiagCode.WrongArgCount, msg), fn_type_lookup(checked.fns, name))
                }
                return tc_er(checked, fn_type_lookup(checked.fns, name))
            }
            // Variable holding a closure
            let var_ty = type_lookup(checked.types, name)
            if vtype_eq(var_ty, ValueType.Int) {
                return tc_er(checked, ValueType.Int) // unknown
            }
            tc_er(checked, vtype_fn_ret(var_ty))
        }
        .FieldAccess(obj, method) -> check_method_call(tc, obj, method, args)
        _ -> {
            // Expression callee (e.g. compose(f,g)(x))
            let c = check_expr(tc, callee)
            let checked = check_expr_list(c.tc, args)
            tc_er(checked, vtype_fn_ret(c.ty))
        }
    }
}

// ── Method call type inference ──

fn check_method_call(tc: TC, obj: Expr, method: string, args: ExprList) -> ExprResult {
    let o = check_expr(tc, obj)
    let checked_args = check_expr_list(o.tc, args)

    // String methods
    if vtype_eq(o.ty, ValueType.Str) {
        if method == "length" { return tc_er(checked_args, ValueType.Int) }
        if method == "substring" || method == "trim" || method == "upper" || method == "lower" || method == "replace" {
            return tc_er(checked_args, ValueType.Str)
        }
        if method == "contains" || method == "starts_with" || method == "ends_with" {
            return tc_er(checked_args, ValueType.Bool)
        }
        if method == "index_of" { return tc_er(checked_args, ValueType.Int) }
        if method == "split" { return tc_er(checked_args, ValueType.List(ValueType.Str)) }
        if method == "char_code" { return tc_er(checked_args, ValueType.Int) }
    }

    // List methods
    if vtype_eq(o.ty, ValueType.List(ValueType.Int)) || vtype_eq(o.ty, ValueType.List(ValueType.Str)) {
        let elem = vtype_list_elem(o.ty)
        if method == "length" { return tc_er(checked_args, ValueType.Int) }
        if method == "push" { return tc_er(checked_args, ValueType.Void) }
        if method == "pop" { return tc_er(checked_args, elem) }
        if method == "get" { return tc_er(checked_args, elem) }
        if method == "map" { return tc_er(checked_args, ValueType.List(ValueType.Int)) } // TODO: infer lambda ret
        if method == "filter" { return tc_er(checked_args, o.ty) }
        if method == "reduce" { return tc_er(checked_args, ValueType.Int) }
        if method == "foreach" { return tc_er(checked_args, ValueType.Void) }
    }

    // Map methods
    if vtype_eq(o.ty, ValueType.Map) {
        if method == "get" { return tc_er(checked_args, ValueType.Str) }
        if method == "has" { return tc_er(checked_args, ValueType.Bool) }
        if method == "set" { return tc_er(checked_args, ValueType.Void) }
        if method == "keys" { return tc_er(checked_args, ValueType.List(ValueType.Str)) }
        if method == "length" { return tc_er(checked_args, ValueType.Int) }
    }

    // Struct method — look up in fn registry as TypeName__method
    let struct_name = match o.ty {
        .Struct(n) -> n
        _ -> ""
    }
    if struct_name.length > 0 {
        let qualified = struct_name + "__" + method
        if fn_type_has(checked_args.fns, qualified) {
            return tc_er(checked_args, fn_type_lookup(checked_args.fns, qualified))
        }
    }

    // Fallback
    tc_er(checked_args, ValueType.Int)
}

// ── Field access type inference ──

fn check_field_access(tc: TC, obj: Expr, field: string) -> ExprResult {
    let o = check_expr(tc, obj)
    // String .length
    if vtype_eq(o.ty, ValueType.Str) && field == "length" {
        return tc_er(o.tc, ValueType.Int)
    }
    // List .length
    if vtype_eq(o.ty, ValueType.List(ValueType.Int)) || vtype_eq(o.ty, ValueType.List(ValueType.Str)) {
        if field == "length" { return tc_er(o.tc, ValueType.Int) }
    }
    // Struct field
    let struct_name = match o.ty {
        .Struct(n) -> n
        _ -> ""
    }
    if struct_name.length > 0 {
        let fields = struct_type_lookup(o.tc.structs, struct_name)
        if !tc_field_exists(fields, field) {
            let msg = "no field `" + field + "` on type `" + struct_name + "`"
            return tc_er(tc_report(o.tc, DiagCode.TypeMismatch, msg), ValueType.Int)
        }
        let field_ty = field_type_in(o.tc, fields, field)
        return tc_er(o.tc, field_ty)
    }
    // Map .get is handled in method call
    tc_er(o.tc, ValueType.Int)
}

fn tc_field_exists(fields: FieldList, name: string) -> bool {
    match fields {
        .End -> false
        .Node(fname, _, next) -> {
            if fname == name { return true }
            tc_field_exists(next, name)
        }
    }
}

fn field_type_in(tc: TC, fields: FieldList, name: string) -> ValueType {
    match fields {
        .End -> ValueType.Int
        .Node(fname, ftype, next) -> {
            if fname == name { return translate_type(tc, ftype) }
            field_type_in(tc, next, name)
        }
    }
}

// ── List literal type ──

fn check_list_lit(tc: TC, elements: ExprList) -> ExprResult {
    match elements {
        .End -> tc_er(tc, ValueType.List(ValueType.Int))
        .Node(first, _) -> {
            let r = check_expr(tc, first)
            let checked = check_expr_list(r.tc, elements)
            tc_er(checked, ValueType.List(r.ty))
        }
    }
}

// ── Block expression type ──

fn check_block(tc: TC, stmts: StmtList) -> ExprResult {
    let inner = tc_enter(tc)
    let pair = check_block_stmts(inner, stmts)
    let after = tc_exit(pair.tc)
    tc_er(after, pair.ty)
}

fn check_block_stmts(tc: TC, stmts: StmtList) -> ExprResult {
    match stmts {
        .End -> tc_er(tc, ValueType.Void)
        .Node(stmt, next) -> {
            match next {
                .End -> {
                    // Last statement — its type is the block's type
                    match stmt {
                        .Expr(e) -> check_expr(tc, e)
                        _ -> {
                            let checked = check_stmt(tc, stmt)
                            tc_er(checked, ValueType.Void)
                        }
                    }
                }
                _ -> {
                    let checked = check_stmt(tc, stmt)
                    check_block_stmts(checked, next)
                }
            }
        }
    }
}

// ── Match expression type ──

fn check_match_expr(tc: TC, subject: Expr, arms: MatchArmList) -> ExprResult {
    let s = check_expr(tc, subject)
    check_match_expr_arms(s.tc, arms, ValueType.Int)
}

fn check_match_expr_arms(tc: TC, arms: MatchArmList, first_ty: ValueType) -> ExprResult {
    match arms {
        .End -> tc_er(tc, first_ty)
        .Node(_, guard, body, next) -> {
            let inner = tc_enter(tc)
            let with_guard = if guard != null {
                let g = check_expr(inner, guard!)
                g.tc
            } else { inner }
            let b = check_expr(with_guard, body)
            let after = tc_exit(b.tc)
            // Use first arm's type as the result type
            let result_ty = match next {
                .End -> b.ty
                _ -> first_ty
            }
            let use_ty = if vtype_eq(first_ty, ValueType.Int) { b.ty } else { first_ty }
            check_match_expr_arms(after, next, use_ty)
        }
    }
}

// ── Helpers ──

fn check_expr_list(tc: TC, exprs: ExprList) -> TC {
    match exprs {
        .End -> tc
        .Node(expr, next) -> {
            let r = check_expr(tc, expr)
            check_expr_list(r.tc, next)
        }
    }
}

type ExprListResult = {
    tc: TC,
    types: TypeList,
}

fn check_expr_list_types(tc: TC, exprs: ExprList) -> ExprListResult {
    match exprs {
        .End -> ExprListResult { tc, types: TypeList.End }
        .Node(expr, next) -> {
            let r = check_expr(tc, expr)
            let rest = check_expr_list_types(r.tc, next)
            ExprListResult { tc: rest.tc, types: TypeList.Node(r.ty, rest.types) }
        }
    }
}

fn check_field_inits(tc: TC, inits: FieldInitList) -> TC {
    match inits {
        .End -> tc
        .Node(_, expr, next) -> {
            let r = check_expr(tc, expr)
            check_field_inits(r.tc, next)
        }
    }
}
