use token.{Token, token_new, token_render, token_render_struct}

export type ScanResult = {
    rendered: string,
    had_error: bool,
    error_message: string,
}

export type Scanner = {
    source: string,
    mut start: int,
    mut current: int,
    mut line: int,
    mut column: int,
    mut token_line: int,
    mut token_column: int,
    mut rendered: string,
    mut token_count: int,
    mut had_error: bool,
    mut error_message: string,
}

export fn scanner_new(source: string) -> Scanner {
    Scanner {
        source,
        start: 0,
        current: 0,
        line: 1,
        column: 1,
        token_line: 1,
        token_column: 1,
        rendered: "",
        token_count: 0,
        had_error: false,
        error_message: "",
    }
}

export fn scan_source(source: string) -> ScanResult {
    mut scanner = scanner_new(source)
    scanner.render_all_tokens()
}

export fn render_tokens(result: ScanResult) -> string {
    result.rendered
}

fn is_digit(ch: string) -> bool {
    ch >= "0" && ch <= "9"
}

fn is_alpha(ch: string) -> bool {
    (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

fn is_alpha_numeric(ch: string) -> bool {
    is_alpha(ch) || is_digit(ch)
}

fn keyword_kind(text: string) -> string {
    if text == "and" { return "kw_and" }
    if text == "else" { return "kw_else" }
    if text == "false" { return "kw_false" }
    if text == "fn" { return "kw_fn" }
    if text == "for" { return "kw_for" }
    if text == "if" { return "kw_if" }
    if text == "let" { return "kw_let" }
    if text == "mod" { return "kw_mod" }
    if text == "mut" { return "kw_mut" }
    if text == "null" { return "kw_null" }
    if text == "or" { return "kw_or" }
    if text == "return" { return "kw_return" }
    if text == "true" { return "kw_true" }
    if text == "use" { return "kw_use" }
    if text == "while" { return "kw_while" }
    if text == "type" { return "kw_type" }
    if text == "enum" { return "kw_enum" }
    if text == "match" { return "kw_match" }
    return "identifier"
}

impl Scanner {
    fn is_at_end(self) -> bool {
        self.current >= self.source.length
    }

    fn peek(self) -> string {
        if self.current >= self.source.length {
            return ""
        }
        self.source[self.current]
    }

    fn peek_next(self) -> string {
        if self.current + 1 >= self.source.length {
            return ""
        }
        self.source[self.current + 1]
    }

    fn advance(self) -> string {
        let ch = self.source[self.current]
        self.current = self.current + 1
        if ch == "\n" {
            self.line = self.line + 1
            self.column = 1
        } else {
            self.column = self.column + 1
        }
        ch
    }

    fn match_next(self, expected: string) -> bool {
        if self.is_at_end() {
            return false
        }
        if self.source[self.current] != expected {
            return false
        }
        self.advance()
        true
    }

    fn current_lexeme(self) -> string {
        self.source.substring(self.start, self.current)
    }

    fn make_token(self, kind: string) -> Token {
        let lexeme = self.current_lexeme()
        self.make_token_with_lexeme(kind, lexeme)
    }

    fn make_token_with_lexeme(self, kind: string, lexeme: string) -> Token {
        token_new(kind, lexeme, self.token_line, self.token_column)
    }

    fn append_token(self, token: Token) {
        let line = token_render_struct(token)
        if self.token_count > 0 {
            self.rendered = self.rendered + "\n"
        }
        self.rendered = self.rendered + line
        self.token_count = self.token_count + 1
    }

    fn set_error(self, message: string) {
        if self.had_error {
            return
        }
        self.had_error = true
        self.error_message = "scan error at " + string(self.token_line) + ":" + string(self.token_column) + ": " + message
    }

    fn render_all_tokens(self) -> ScanResult {
        while true {
            let token = self.next_token()
            if self.had_error {
                break
            }
            self.append_token(token)
            if token.kind == "eof" {
                break
            }
        }

        ScanResult {
            rendered: self.rendered,
            had_error: self.had_error,
            error_message: self.error_message,
        }
    }

    fn next_token(self) -> Token {
        while true {
            if self.is_at_end() {
                self.start = self.current
                self.token_line = self.line
                self.token_column = self.column
                return self.make_token_with_lexeme("eof", "")
            }

            self.start = self.current
            self.token_line = self.line
            self.token_column = self.column

            let token = self.scan_token()
            if token.kind != "skip" {
                return token
            }
        }
    }

    fn scan_token(self) -> Token {
        let ch = self.advance()

        if ch == " " || ch == "\r" || ch == "\t" {
            return self.make_token_with_lexeme("skip", "")
        }

        if ch == "\n" {
            return self.make_token_with_lexeme("newline", "\n")
        }

        if ch == "(" {
            return self.make_token("left_paren")
        }
        if ch == ")" {
            return self.make_token("right_paren")
        }
        if ch == "{" {
            return self.make_token("left_brace")
        }
        if ch == "}" {
            return self.make_token("right_brace")
        }
        if ch == "[" {
            return self.make_token("left_bracket")
        }
        if ch == "]" {
            return self.make_token("right_bracket")
        }
        if ch == "," {
            return self.make_token("comma")
        }
        if ch == "." {
            return self.make_token("dot")
        }
        if ch == ":" {
            return self.make_token("colon")
        }
        if ch == ";" {
            return self.make_token("semicolon")
        }
        if ch == "+" {
            return self.make_token("plus")
        }
        if ch == "*" {
            return self.make_token("star")
        }
        if ch == "?" {
            return self.make_token("question")
        }

        if ch == "-" {
            if self.match_next(">") {
                return self.make_token("arrow")
            } else {
                return self.make_token("minus")
            }
        }

        if ch == "!" {
            if self.match_next("=") {
                return self.make_token("bang_equal")
            } else {
                return self.make_token("bang")
            }
        }

        if ch == "=" {
            if self.match_next("=") {
                return self.make_token("equal_equal")
            } else {
                return self.make_token("equal")
            }
        }

        if ch == "<" {
            if self.match_next("=") {
                return self.make_token("less_equal")
            } else {
                return self.make_token("less")
            }
        }

        if ch == ">" {
            if self.match_next("=") {
                return self.make_token("greater_equal")
            } else {
                return self.make_token("greater")
            }
        }

        if ch == "/" {
            if self.match_next("/") {
                while !self.is_at_end() && self.peek() != "\n" {
                    self.advance()
                }
                return self.make_token_with_lexeme("skip", "")
            } else {
                return self.make_token("slash")
            }
        }

        if ch == "\"" {
            return self.scan_string()
        }

        if is_digit(ch) {
            return self.scan_number()
        }

        if is_alpha(ch) {
            return self.scan_identifier()
        }

        self.set_error("unexpected character `" + ch + "`")
        self.make_token_with_lexeme("error", "")
    }

    fn scan_string(self) -> Token {
        while !self.is_at_end() && self.peek() != "\"" {
            if self.peek() == "\\" {
                self.advance()
                if !self.is_at_end() {
                    self.advance()
                }
            } else {
                self.advance()
            }
        }

        if self.is_at_end() {
            self.set_error("unterminated string")
            return self.make_token_with_lexeme("error", "")
        }

        self.advance()
        self.make_token("string")
    }

    fn scan_number(self) -> Token {
        while is_digit(self.peek()) {
            self.advance()
        }

        if self.peek() == "." && is_digit(self.peek_next()) {
            self.advance()
            while is_digit(self.peek()) {
                self.advance()
            }
        }

        self.make_token("number")
    }

    fn scan_identifier(self) -> Token {
        while is_alpha_numeric(self.peek()) {
            self.advance()
        }

        let text = self.current_lexeme()
        self.make_token_with_lexeme(keyword_kind(text), text)
    }
}
