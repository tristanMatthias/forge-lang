use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, Pattern, MatchArmList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length, field_list_length, field_init_length, field_index_of, field_type_of, variant_lookup, variant_max_payload}

// ── Direct C extern declarations ──
//
// The bootstrap codegen calls a small set of LLVM-C-API wrappers
// (the `forge_llvm_*` symbols exposed by the @std.llvm package's
// native library) plus a handful of libc helpers. We declare them
// directly as `extern fn` so the bootstrap source has no
// dependence on the host's package namespace dispatch — it just
// calls C symbols.
//
// We keep the local helper names matching the old `llvm.X` shape
// (e.g. `bs_llvm_context_create`) so the rest of this file reads
// the same as before; the helpers are thin wrappers over the
// underlying C symbols.

extern fn forge_llvm_context_create() -> ptr
extern fn forge_llvm_context_dispose(ctx: ptr)
extern fn forge_llvm_module_create(name: string, ctx: ptr) -> ptr
extern fn forge_llvm_module_dispose(m: ptr)
extern fn forge_llvm_create_builder(ctx: ptr) -> ptr
extern fn forge_llvm_dispose_builder(b: ptr)

extern fn forge_llvm_int1_type(ctx: ptr) -> ptr
extern fn forge_llvm_int8_type(ctx: ptr) -> ptr
extern fn forge_llvm_int32_type(ctx: ptr) -> ptr
extern fn forge_llvm_int64_type(ctx: ptr) -> ptr
extern fn forge_llvm_pointer_type(ctx: ptr) -> ptr
extern fn forge_llvm_void_type(ctx: ptr) -> ptr
extern fn forge_llvm_function_type(ret: ptr, params: ptr, count: int, is_var: int) -> ptr
extern fn forge_llvm_type_array_new(count: int) -> ptr
extern fn forge_llvm_type_array_set(arr: ptr, idx: int, ty: ptr)
extern fn forge_llvm_type_array_free(arr: ptr)
extern fn forge_llvm_value_array_new(count: int) -> ptr
extern fn forge_llvm_value_array_set(arr: ptr, idx: int, val: ptr)
extern fn forge_llvm_value_array_free(arr: ptr)

extern fn forge_llvm_add_function(m: ptr, name: string, fn_type: ptr) -> ptr
extern fn forge_llvm_add_global(m: ptr, ty: ptr, name: string) -> ptr
extern fn forge_llvm_set_initializer(g: ptr, val: ptr)
extern fn forge_llvm_get_named_function(m: ptr, name: string) -> ptr
extern fn forge_llvm_get_param(fn_val: ptr, idx: int) -> ptr
extern fn forge_llvm_get_type_by_name(ctx: ptr, name: string) -> ptr

extern fn forge_llvm_append_basic_block(ctx: ptr, fn_val: ptr, name: string) -> ptr
extern fn forge_llvm_position_at_end(b: ptr, bb: ptr)
extern fn forge_llvm_block_has_terminator(b: ptr) -> int

extern fn forge_llvm_build_ret(b: ptr, val: ptr) -> ptr
extern fn forge_llvm_build_br(b: ptr, dest: ptr) -> ptr
extern fn forge_llvm_build_cond_br(b: ptr, cond: ptr, then_bb: ptr, else_bb: ptr) -> ptr
extern fn forge_llvm_build_alloca(b: ptr, ty: ptr, name: string) -> ptr
extern fn forge_llvm_build_store(b: ptr, val: ptr, ptr_val: ptr) -> ptr
extern fn forge_llvm_build_load(b: ptr, ty: ptr, ptr_val: ptr, name: string) -> ptr
extern fn forge_llvm_build_call(b: ptr, fn_type: ptr, fn_val: ptr, args: ptr, count: int, name: string) -> ptr
extern fn forge_llvm_build_add(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn forge_llvm_build_sub(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn forge_llvm_build_mul(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn forge_llvm_build_sdiv(b: ptr, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn forge_llvm_build_icmp(b: ptr, pred: int, lhs: ptr, rhs: ptr, name: string) -> ptr
extern fn forge_llvm_build_zext(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn forge_llvm_build_sext(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn forge_llvm_build_ptr_to_int(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn forge_llvm_build_int_to_ptr(b: ptr, val: ptr, dest_ty: ptr, name: string) -> ptr
extern fn forge_llvm_build_struct_gep2(b: ptr, ty: ptr, ptr_val: ptr, idx: int, name: string) -> ptr
extern fn forge_llvm_build_global_string_ptr(b: ptr, s: string, name: string) -> ptr
extern fn forge_llvm_const_int(ty: ptr, value: int, sign_extend: int) -> ptr

extern fn forge_llvm_struct_create_named(ctx: ptr, name: string) -> ptr
extern fn forge_llvm_struct_set_body(st: ptr, elems: ptr, count: int, packed: int) -> ptr

extern fn forge_llvm_verify_module_print(m: ptr) -> int
extern fn forge_llvm_print_module_to_file(m: ptr, path: string) -> int

// ── Public API ──

export type CodegenResult = {
    had_error: bool,
    error_message: string,
}

export type Codegen = {
    ctx: ptr,
    module: ptr,
    builder: ptr,
    // The function whose body the builder is currently positioned in.
    // append_basic_block needs this; codegen for `if`/`while` and
    // function bodies all use it.
    current_fn: ptr,
    i64_type: ptr,
    i1_type: ptr,
    ptr_type: ptr,
}

export fn null_ptr_val() -> ptr {
    let n: ptr = null
    n
}

// ── Struct registry ──
//
// Maps struct name → its FieldList. We need this to look up field
// indices and types at use sites (struct literals, field access).
// LLVM also has the named struct type, but it doesn't carry field
// names — that information lives only here.
//
// The mut global is rebuilt on every compile_program call.
enum StructReg {
    End
    Node(name: string, fields: FieldList, next: StructReg)
}

mut CG_STRUCTS: StructReg = StructReg.End

// Function return type registry. The bootstrap MVP doesn't carry
// declared return types through to LLVM (every function returns
// i64 at the ABI level), but we track the declared *value tag*
// here so chained method calls and `let x = call()` get the right
// downstream type. Looked up by mangled function name.
enum FnRetTypes {
    End
    Node(name: string, ret_ty: string, next: FnRetTypes)
}

mut CG_FN_RETS: FnRetTypes = FnRetTypes.End

fn fn_ret_register(name: string, ret_ty: string) {
    CG_FN_RETS = FnRetTypes.Node(name, ret_ty, CG_FN_RETS)
}

fn fn_ret_lookup(name: string) -> string {
    fn_ret_lookup_loop(CG_FN_RETS, name)
}

fn fn_ret_lookup_loop(reg: FnRetTypes, name: string) -> string {
    match reg {
        .End -> ""
        .Node(n, ty, next) -> {
            if n == name {
                return ty
            }
            fn_ret_lookup_loop(next, name)
        }
    }
}

// Top-level `mut` global registry. Each declaration emits an LLVM
// global of i64 type, and the environment-lookup path consults
// this registry when a name isn't a local. The value tag tracks
// what type the global holds (so reads return a properly-tagged
// value).
enum GlobalReg {
    End
    Node(name: string, llvm_global: ptr, ty: string, next: GlobalReg)
}

mut CG_GLOBALS: GlobalReg = GlobalReg.End

type GlobalLookup = {
    found: bool,
    llvm_global: ptr,
    ty: string,
}

fn global_register(name: string, llvm_global: ptr, ty: string) {
    CG_GLOBALS = GlobalReg.Node(name, llvm_global, ty, CG_GLOBALS)
}

fn global_lookup(name: string) -> GlobalLookup {
    global_lookup_loop(CG_GLOBALS, name)
}

fn global_lookup_loop(reg: GlobalReg, name: string) -> GlobalLookup {
    match reg {
        .End -> {
            let n: ptr = null
            GlobalLookup { found: false, llvm_global: n, ty: "i64" }
        }
        .Node(n, g, ty, next) -> {
            if n == name {
                return GlobalLookup { found: true, llvm_global: g, ty }
            }
            global_lookup_loop(next, name)
        }
    }
}

// Loop stack for break/continue. Each frame holds the basic block
// to branch to for `continue` (the loop's condition check block)
// and the block to branch to for `break` (the loop's exit block).
enum LoopStack {
    End
    Frame(cond_bb: ptr, exit_bb: ptr, next: LoopStack)
}

mut CG_LOOPS: LoopStack = LoopStack.End

fn loops_push(cond_bb: ptr, exit_bb: ptr) {
    CG_LOOPS = LoopStack.Frame(cond_bb, exit_bb, CG_LOOPS)
}

fn loops_pop() {
    match CG_LOOPS {
        .End -> {}
        .Frame(_, _, next) -> CG_LOOPS = next
    }
}

type LoopFrame = {
    found: bool,
    cond_bb: ptr,
    exit_bb: ptr,
}

fn loops_top() -> LoopFrame {
    match CG_LOOPS {
        .End -> {
            let n: ptr = null
            LoopFrame { found: false, cond_bb: n, exit_bb: n }
        }
        .Frame(c, e, _) -> LoopFrame { found: true, cond_bb: c, exit_bb: e }
    }
}

type StructLookup = {
    found: bool,
    fields: FieldList,
}

fn struct_reg_lookup(name: string) -> StructLookup {
    struct_reg_lookup_loop(CG_STRUCTS, name)
}

fn struct_reg_lookup_loop(reg: StructReg, name: string) -> StructLookup {
    match reg {
        .End -> StructLookup { found: false, fields: FieldList.End }
        .Node(n, fields, next) -> {
            if n == name {
                return StructLookup { found: true, fields }
            }
            struct_reg_lookup_loop(next, name)
        }
    }
}

fn struct_reg_extend(name: string, fields: FieldList) {
    CG_STRUCTS = StructReg.Node(name, fields, CG_STRUCTS)
}

// ── Enum registry ──
//
// Maps enum name → its VariantList. Same idea as the struct
// registry: LLVM holds the named struct type, but variant names,
// tags, and field types live only here.
enum EnumReg {
    End
    Node(name: string, variants: VariantList, next: EnumReg)
}

mut CG_ENUMS: EnumReg = EnumReg.End

export type EnumLookup = {
    found: bool,
    variants: VariantList,
}

export fn enum_reg_lookup(name: string) -> EnumLookup {
    enum_reg_lookup_loop(CG_ENUMS, name)
}

fn enum_reg_lookup_loop(reg: EnumReg, name: string) -> EnumLookup {
    match reg {
        .End -> EnumLookup { found: false, variants: VariantList.End }
        .Node(n, variants, next) -> {
            if n == name {
                return EnumLookup { found: true, variants }
            }
            enum_reg_lookup_loop(next, name)
        }
    }
}

fn enum_reg_extend(name: string, variants: VariantList) {
    CG_ENUMS = EnumReg.Node(name, variants, CG_ENUMS)
}

export fn compile_program(stmts: StmtList, output_path: string) -> CodegenResult {
    let ctx = forge_llvm_context_create()
    let m = forge_llvm_module_create("bootstrap", ctx)
    let builder = forge_llvm_create_builder(ctx)

    let i64t = forge_llvm_int64_type(ctx)
    let i1t = forge_llvm_int1_type(ctx)
    let pt = forge_llvm_pointer_type(ctx)

    // Declare libc helpers we lower string ops onto.
    //   puts(ptr) -> i32        — for println(str)
    //   strlen(ptr) -> i64
    //   malloc(i64) -> ptr
    //   memcpy(ptr, ptr, i64) -> ptr
    let puts_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(puts_param_arr, 0, pt)
    let puts_type = forge_llvm_function_type(forge_llvm_int32_type(ctx), puts_param_arr, 1, 0)
    forge_llvm_type_array_free(puts_param_arr)
    forge_llvm_add_function(m, "puts", puts_type)

    let strlen_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(strlen_param_arr, 0, pt)
    let strlen_type = forge_llvm_function_type(i64t, strlen_param_arr, 1, 0)
    forge_llvm_type_array_free(strlen_param_arr)
    forge_llvm_add_function(m, "strlen", strlen_type)

    let malloc_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(malloc_param_arr, 0, i64t)
    let malloc_type = forge_llvm_function_type(pt, malloc_param_arr, 1, 0)
    forge_llvm_type_array_free(malloc_param_arr)
    forge_llvm_add_function(m, "malloc", malloc_type)

    let memcpy_param_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(memcpy_param_arr, 0, pt)
    forge_llvm_type_array_set(memcpy_param_arr, 1, pt)
    forge_llvm_type_array_set(memcpy_param_arr, 2, i64t)
    let memcpy_type = forge_llvm_function_type(pt, memcpy_param_arr, 3, 0)
    forge_llvm_type_array_free(memcpy_param_arr)
    forge_llvm_add_function(m, "memcpy", memcpy_type)

    let strcmp_param_arr = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(strcmp_param_arr, 0, pt)
    forge_llvm_type_array_set(strcmp_param_arr, 1, pt)
    let strcmp_type = forge_llvm_function_type(forge_llvm_int32_type(ctx), strcmp_param_arr, 2, 0)
    forge_llvm_type_array_free(strcmp_param_arr)
    forge_llvm_add_function(m, "strcmp", strcmp_type)

    // snprintf(buf, size, fmt, ...) declared as variadic for the
    // string() builtin's int → str conversion.
    let snprintf_param_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(snprintf_param_arr, 0, pt)
    forge_llvm_type_array_set(snprintf_param_arr, 1, i64t)
    forge_llvm_type_array_set(snprintf_param_arr, 2, pt)
    let snprintf_type = forge_llvm_function_type(forge_llvm_int32_type(ctx), snprintf_param_arr, 3, 1)
    forge_llvm_type_array_free(snprintf_param_arr)
    forge_llvm_add_function(m, "snprintf", snprintf_type)

    // atoi(str) -> i32 for the int() builtin.
    let atoi_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(atoi_param_arr, 0, pt)
    let atoi_type = forge_llvm_function_type(forge_llvm_int32_type(ctx), atoi_param_arr, 1, 0)
    forge_llvm_type_array_free(atoi_param_arr)
    forge_llvm_add_function(m, "atoi", atoi_type)

    // exit(int) for process.exit
    let exit_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(exit_param_arr, 0, forge_llvm_int32_type(ctx))
    let exit_type = forge_llvm_function_type(forge_llvm_void_type(ctx), exit_param_arr, 1, 0)
    forge_llvm_type_array_free(exit_param_arr)
    forge_llvm_add_function(m, "exit", exit_type)

    // Reset and rebuild the per-compile registries.
    CG_STRUCTS = StructReg.End
    CG_ENUMS = EnumReg.End
    CG_LOOPS = LoopStack.End
    CG_FN_RETS = FnRetTypes.End
    CG_GLOBALS = GlobalReg.End
    declare_structs(ctx, i64t, stmts)
    declare_enums(ctx, i64t, stmts)
    declare_globals(m, ctx, i64t, stmts)

    // Pass 1: declare every user-defined function as an LLVM
    // prototype so call sites (which may appear before the
    // declaration in source order) can resolve them by name via
    // `llvm.get_named_function`.
    declare_functions(m, ctx, i64t, stmts)

    // Synthesize a wrapper function for the top-level non-function
    // statements. If the source already defines its own `fn main`,
    // use a different name (`__bs_top_level`) so we don't collide
    // — the user's main becomes the program entry point. Otherwise
    // we name the wrapper `main` so it serves as the entry.
    let user_main = forge_llvm_get_named_function(m, "main")
    let main_name = if user_main == null { "main" } else { "__bs_top_level" }
    let main_params = forge_llvm_type_array_new(0)
    let main_type = forge_llvm_function_type(i64t, main_params, 0, 0)
    forge_llvm_type_array_free(main_params)
    let main_fn = forge_llvm_add_function(m, main_name, main_type)

    let entry = forge_llvm_append_basic_block(ctx, main_fn, "entry")
    forge_llvm_position_at_end(builder, entry)

    let cg = Codegen {
        ctx,
        module: m,
        builder,
        current_fn: main_fn,
        i64_type: i64t,
        i1_type: i1t,
        ptr_type: pt,
    }

    // Pass 2: emit each user-defined function's body, then emit
    // every non-function top-level statement into main.
    let body_result = emit_function_bodies(cg, stmts)
    if body_result.had_error {
        forge_llvm_dispose_builder(builder)
        forge_llvm_module_dispose(m)
        forge_llvm_context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: body_result.error_message }
    }

    // After emitting any function bodies, the builder may be sitting
    // in a function-body block. Reposition it back at main's entry
    // before emitting top-level statements.
    forge_llvm_position_at_end(builder, entry)
    let initial: VarEnv = VarEnv.End
    let result = emit_top_level(cg, initial, stmts)
    if result.had_error {
        forge_llvm_dispose_builder(builder)
        forge_llvm_module_dispose(m)
        forge_llvm_context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: result.error_message }
    }

    // Default return 0 if the program didn't end in an explicit return
    if forge_llvm_block_has_terminator(builder) == 0 {
        forge_llvm_build_ret(builder, forge_llvm_const_int(i64t, 0, 0))
    }

    // Verify
    let verify = forge_llvm_verify_module_print(m)
    if verify != 0 {
        forge_llvm_dispose_builder(builder)
        forge_llvm_module_dispose(m)
        forge_llvm_context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: "codegen error: LLVM module verification failed" }
    }

    let write_result = forge_llvm_print_module_to_file(m, output_path)

    forge_llvm_dispose_builder(builder)
    forge_llvm_module_dispose(m)
    forge_llvm_context_dispose(ctx)

    if write_result != 0 {
        return CodegenResult { had_error: true, error_message: "codegen error: failed to write IR to " + output_path }
    }

    CodegenResult { had_error: false, error_message: "" }
}

// ── Helpers ──

export type EmitResult = {
    value: ptr,
    // "i64" or "str". `str` values are stored as i64-encoded
    // pointers (ptrtoint) and decoded back to `ptr` at use sites
    // (println, concat). The tag tells `+` whether to emit an i64
    // add or a string concat.
    ty: string,
    had_error: bool,
    error_message: string,
}

export fn ok_emit(value: ptr) -> EmitResult {
    EmitResult { value, ty: "i64", had_error: false, error_message: "" }
}

export fn ok_emit_str(value: ptr) -> EmitResult {
    EmitResult { value, ty: "str", had_error: false, error_message: "" }
}

export fn err_emit(message: string) -> EmitResult {
    EmitResult { value: null_ptr_val(), ty: "i64", had_error: true, error_message: "codegen error: " + message }
}

export type StmtResult = {
    env: VarEnv,
    had_error: bool,
    error_message: string,
}

export fn ok_stmt(env: VarEnv) -> StmtResult {
    StmtResult { env, had_error: false, error_message: "" }
}

export fn err_stmt(message: string) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: message }
}

export fn err_stmt_from_expr(r: EmitResult) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: r.error_message }
}

// ── Struct declaration pass ──

fn declare_structs(ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .TypeDecl(name, fields) -> {
                    // Build a named LLVM struct type with N i64 slots.
                    // Every bootstrap value lives in an i64 slot
                    // (str values are pointer-encoded), so a struct
                    // is just an array of i64s with named offsets.
                    let count = field_list_length(fields)
                    let field_arr = forge_llvm_type_array_new(count)
                    fill_i64_param_array(field_arr, i64t, 0, count)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, count, 0)
                    forge_llvm_type_array_free(field_arr)
                    struct_reg_extend(name, fields)
                }
                _ -> {}
            }
            declare_structs(ctx, i64t, next)
        }
    }
}

// ── Global declaration pass ──
//
// Top-level `let` and `mut` declarations become module-level LLVM
// globals (i64). Their initializers are deferred to a synthetic
// `bs_init_globals` function called from `main` at startup; the
// declaration pass only allocates the global slot itself, since
// initializers may reference user functions and structs that
// haven't been emitted yet.

fn declare_globals(m: ptr, ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .Let(name, ty, _) -> {
                    let g = forge_llvm_add_global(m, i64t, name)
                    forge_llvm_set_initializer(g, forge_llvm_const_int(i64t, 0, 0))
                    global_register(name, g, translate_param_type(ty))
                }
                .Mut(name, ty, _) -> {
                    let g = forge_llvm_add_global(m, i64t, name)
                    forge_llvm_set_initializer(g, forge_llvm_const_int(i64t, 0, 0))
                    global_register(name, g, translate_param_type(ty))
                }
                _ -> {}
            }
            declare_globals(m, ctx, i64t, next)
        }
    }
}

// ── Enum declaration pass ──

fn declare_enums(ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .EnumDecl(name, variants) -> {
                    // Each enum is laid out as `{i8 tag, i64 x N}`
                    // where N = max number of fields across variants.
                    // Field types are erased to i64 — strings are
                    // pointer-encoded already.
                    let max_fields = variant_max_payload(variants)
                    let total_fields = max_fields + 1
                    let field_arr = forge_llvm_type_array_new(total_fields)
                    forge_llvm_type_array_set(field_arr, 0, forge_llvm_int8_type(ctx))
                    fill_i64_param_array_offset(field_arr, i64t, 1, max_fields)
                    let st = forge_llvm_struct_create_named(ctx, name)
                    forge_llvm_struct_set_body(st, field_arr, total_fields, 0)
                    forge_llvm_type_array_free(field_arr)
                    enum_reg_extend(name, variants)
                }
                _ -> {}
            }
            declare_enums(ctx, i64t, next)
        }
    }
}

fn fill_i64_param_array_offset(arr: ptr, i64t: ptr, base: int, count: int) {
    if count <= 0 {
        return
    }
    forge_llvm_type_array_set(arr, base, i64t)
    fill_i64_param_array_offset(arr, i64t, base + 1, count - 1)
}

// ── Function declaration pass ──

fn declare_functions(m: ptr, ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .Function(name, params, ret_ty, body) -> {
                    let arity = param_list_length(params)
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_i64_param_array(param_arr, i64t, 0, arity)
                    let fn_type = forge_llvm_function_type(i64t, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    fn_ret_register(name, translate_param_type(ret_ty))
                }
                .ExternFn(name, params, ret_ty) -> {
                    // Same shape as a normal function declaration:
                    // every parameter and the return value are i64
                    // in the bootstrap MVP. Codegen calls this via
                    // get_named_function in emit_call_named.
                    let arity = param_list_length(params)
                    let param_arr = forge_llvm_type_array_new(arity)
                    fill_i64_param_array(param_arr, i64t, 0, arity)
                    let fn_type = forge_llvm_function_type(i64t, param_arr, arity, 0)
                    forge_llvm_type_array_free(param_arr)
                    forge_llvm_add_function(m, name, fn_type)
                    fn_ret_register(name, translate_param_type(ret_ty))
                }
                .Impl(_, methods) -> declare_functions(m, ctx, i64t, methods)
                _ -> {}
            }
            declare_functions(m, ctx, i64t, next)
        }
    }
}

fn fill_i64_param_array(arr: ptr, i64t: ptr, idx: int, count: int) {
    if idx >= count {
        return
    }
    forge_llvm_type_array_set(arr, idx, i64t)
    fill_i64_param_array(arr, i64t, idx + 1, count)
}

// ── Function body pass ──

fn emit_function_bodies(cg: Codegen, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(VarEnv.End)
        .Node(stmt, next) -> {
            let r = match stmt {
                .Function(name, params, _, body) -> emit_function_body(cg, name, params, body)
                .Impl(_, methods) -> emit_function_bodies(cg, methods)
                _ -> ok_stmt(VarEnv.End)
            }
            if r.had_error {
                return r
            }
            emit_function_bodies(cg, next)
        }
    }
}

fn emit_function_body(cg: Codegen, name: string, params: ParamList, body: StmtList) -> StmtResult {
    let fn_val = forge_llvm_get_named_function(cg.module, name)
    if fn_val == null {
        return err_stmt("codegen error: function `" + name + "` was not declared in pass 1")
    }

    let entry = forge_llvm_append_basic_block(cg.ctx, fn_val, "entry")
    forge_llvm_position_at_end(cg.builder, entry)

    let empty_env: VarEnv = VarEnv.End
    let env = bind_params_inline(cg.builder, cg.i64_type, fn_val, params, 0, empty_env)

    let body_cg = Codegen {
        ctx: cg.ctx,
        module: cg.module,
        builder: cg.builder,
        current_fn: fn_val,
        i64_type: cg.i64_type,
        i1_type: cg.i1_type,
        ptr_type: cg.ptr_type,
    }

    // Treat the function body as a block expression: walk each
    // statement, and if the last one is an expression statement
    // its value becomes the function's implicit return value.
    // This matches Forge's semantics ("a function returns its
    // last expression unless an explicit `return` says otherwise")
    // and fixes single-expression wrapper bodies like
    // `fn file_exists(p) { forge_selfhost_file_exists(p) }`.
    let r = emit_block_loop(body_cg, env, body, forge_llvm_const_int(cg.i64_type, 0, 0), "i64")
    if r.had_error {
        return err_stmt(r.error_message)
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_ret(cg.builder, r.value)
    }
    ok_stmt(VarEnv.End)
}

fn bind_params_inline(builder: ptr, i64t: ptr, fn_val: ptr, params: ParamList, idx: int, env: VarEnv) -> VarEnv {
    match params {
        .End -> env
        .Node(name, ty, next) -> {
            let arg = forge_llvm_get_param(fn_val, idx)
            let alloca = forge_llvm_build_alloca(builder, i64t, name)
            forge_llvm_build_store(builder, arg, alloca)
            // Translate the user-facing type annotation into the
            // codegen's internal value tag. "str" stays as-is,
            // anything starting with uppercase is assumed to be a
            // struct or enum and tagged accordingly so that field
            // access and match can find the right registry entry.
            let internal_ty = translate_param_type(ty)
            bind_params_inline(builder, i64t, fn_val, next, idx + 1, env_extend(env, name, alloca, internal_ty))
        }
    }
}

export fn translate_param_type(ty: string) -> string {
    if ty == "str" { return "str" }
    if ty == "string" { return "str" }
    if ty == "i64" { return "i64" }
    if ty == "int" { return "i64" }
    if ty == "bool" { return "i64" }
    if ty == "ptr" { return "i64" }
    // Anything else: check the registries. Enum first, then struct.
    let enum_l = enum_reg_lookup(ty)
    if enum_l.found {
        return "enum:" + ty
    }
    let struct_l = struct_reg_lookup(ty)
    if struct_l.found {
        return "struct:" + ty
    }
    "i64"
}

// ── Top-level pass (skips function decls) ──

fn emit_top_level(cg: Codegen, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(stmt, next) -> {
            let result = match stmt {
                .Function(_, _, _, _) -> ok_stmt(env)
                .Let(name, _, init) -> emit_top_level_init(cg, env, name, init)
                .Mut(name, _, init) -> emit_top_level_init(cg, env, name, init)
                _ -> emit_stmt(cg, env, stmt)
            }
            if result.had_error {
                return result
            }
            emit_top_level(cg, result.env, next)
        }
    }
}

fn emit_top_level_init(cg: Codegen, env: VarEnv, name: string, init: Expr) -> StmtResult {
    // Top-level let/mut declarations were already allocated as
    // module globals in declare_globals. Here we just emit the
    // initializer expression at main's entry and store it.
    let g = global_lookup(name)
    if !g.found {
        return err_stmt("codegen error: global `" + name + "` not declared")
    }
    let r = emit_expr(cg, env, init)
    if r.had_error {
        return err_stmt_from_expr(r)
    }
    forge_llvm_build_store(cg.builder, r.value, g.llvm_global)
    // Update the global registry's value tag with the inferred
    // type so subsequent reads carry the right tag.
    global_register(name, g.llvm_global, r.ty)
    ok_stmt(env)
}

// ── Statement emission ──

fn emit_stmt_list(cg: Codegen, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(stmt, next) -> {
            let result = emit_stmt(cg, env, stmt)
            if result.had_error {
                return result
            }
            emit_stmt_list(cg, result.env, next)
        }
    }
}

fn emit_stmt(cg: Codegen, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Expr(expr) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            ok_stmt(env)
        }
        .Ret(value) -> {
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            forge_llvm_build_ret(cg.builder, r.value)
            ok_stmt(env)
        }
        .RetEmpty -> {
            forge_llvm_build_ret(cg.builder, forge_llvm_const_int(cg.i64_type, 0, 0))
            ok_stmt(env)
        }
        .Let(name, _, initializer) -> emit_var_decl(cg, env, name, initializer)
        .Mut(name, _, initializer) -> emit_var_decl(cg, env, name, initializer)
        .Block(body) -> {
            let inner = emit_stmt_list(cg, env, body)
            if inner.had_error {
                return inner
            }
            // Block exits restore the outer scope.
            ok_stmt(env)
        }
        .If(condition, then_branch, else_branch) -> emit_if(cg, env, condition, then_branch, else_branch)
        .While(condition, body) -> emit_while(cg, env, condition, body)
        .TypeDecl(_, _) -> ok_stmt(env)
        .EnumDecl(_, _) -> ok_stmt(env)
        .Match(subject, arms) -> emit_match(cg, env, subject, arms)
        .Impl(_, _) -> ok_stmt(env)
        .NoOp -> ok_stmt(env)
        .ExternFn(_, _, _) -> ok_stmt(env)
        .Break -> {
            let frame = loops_top()
            if !frame.found {
                return err_stmt("codegen error: break outside loop")
            }
            forge_llvm_build_br(cg.builder, frame.exit_bb)
            ok_stmt(env)
        }
        .Continue -> {
            let frame = loops_top()
            if !frame.found {
                return err_stmt("codegen error: continue outside loop")
            }
            forge_llvm_build_br(cg.builder, frame.cond_bb)
            ok_stmt(env)
        }
        _ -> err_stmt("codegen error: unsupported statement type")
    }
}

fn emit_var_decl(cg: Codegen, env: VarEnv, name: string, initializer: Expr) -> StmtResult {
    let r = emit_expr(cg, env, initializer)
    if r.had_error {
        return err_stmt_from_expr(r)
    }
    let alloca = forge_llvm_build_alloca(cg.builder, cg.i64_type, name)
    forge_llvm_build_store(cg.builder, r.value, alloca)
    ok_stmt(env_extend(env, name, alloca, r.ty))
}

fn emit_if(cg: Codegen, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> StmtResult {
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return err_stmt_from_expr(cond)
    }
    // Truncate i64 → i1 for the branch.
    let cond_i1 = forge_llvm_build_icmp(cg.builder, 33, cond.value, forge_llvm_const_int(cg.i64_type, 0, 0), "if_cond")

    let then_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "then")
    let else_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "else")
    let merge_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "ifcont")

    forge_llvm_build_cond_br(cg.builder, cond_i1, then_bb, else_bb)

    // Then branch
    forge_llvm_position_at_end(cg.builder, then_bb)
    let then_result = emit_stmt(cg, env, then_branch)
    if then_result.had_error {
        return then_result
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_br(cg.builder, merge_bb)
    }

    // Else branch
    forge_llvm_position_at_end(cg.builder, else_bb)
    if else_branch != null {
        let else_result = emit_stmt(cg, env, else_branch!)
        if else_result.had_error {
            return else_result
        }
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_br(cg.builder, merge_bb)
    }

    forge_llvm_position_at_end(cg.builder, merge_bb)
    ok_stmt(env)
}

fn emit_while(cg: Codegen, env: VarEnv, condition: Expr, body: Stmt) -> StmtResult {
    let cond_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "while.cond")
    let body_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "while.body")
    let exit_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "while.exit")

    forge_llvm_build_br(cg.builder, cond_bb)

    forge_llvm_position_at_end(cg.builder, cond_bb)
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return err_stmt_from_expr(cond)
    }
    let cond_i1 = forge_llvm_build_icmp(cg.builder, 33, cond.value, forge_llvm_const_int(cg.i64_type, 0, 0), "while_cond")
    forge_llvm_build_cond_br(cg.builder, cond_i1, body_bb, exit_bb)

    forge_llvm_position_at_end(cg.builder, body_bb)
    loops_push(cond_bb, exit_bb)
    let body_result = emit_stmt(cg, env, body)
    loops_pop()
    if body_result.had_error {
        return body_result
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_br(cg.builder, cond_bb)
    }

    forge_llvm_position_at_end(cg.builder, exit_bb)
    ok_stmt(env)
}

// ── Expression emission ──

export fn emit_expr(cg: Codegen, env: VarEnv, expr: Expr) -> EmitResult {
    match expr {
        .Number(text) -> {
            let value = int(text)
            ok_emit(forge_llvm_const_int(cg.i64_type, value, 0))
        }
        .Bool(text) -> {
            if text == "true" {
                return ok_emit(forge_llvm_const_int(cg.i64_type, 1, 0))
            }
            ok_emit(forge_llvm_const_int(cg.i64_type, 0, 0))
        }
        .Null -> ok_emit(forge_llvm_const_int(cg.i64_type, 0, 0))
        .String(text) -> {
            let inner = strip_quotes(text)
            let str_ptr = forge_llvm_build_global_string_ptr(cg.builder, inner, ".str")
            ok_emit_str(forge_llvm_build_ptr_to_int(cg.builder, str_ptr, cg.i64_type, "str_i64"))
        }
        .Grouping(inner) -> emit_expr(cg, env, inner)
        .Unary(operator, right) -> emit_unary(cg, env, operator, right)
        .Binary(left, operator, right) -> emit_binary(cg, env, left, operator, right)
        .Logical(left, operator, right) -> emit_binary(cg, env, left, operator, right)
        .Ident(name) -> {
            let local = env_lookup(env, name)
            if local.found {
                let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, local.alloca, name)
                return EmitResult { value: loaded, ty: local.ty, had_error: false, error_message: "" }
            }
            let g = global_lookup(name)
            if g.found {
                let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, g.llvm_global, name)
                return EmitResult { value: loaded, ty: g.ty, had_error: false, error_message: "" }
            }
            err_emit("undefined variable `" + name + "`")
        }
        .Assign(name, value) -> {
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return r
            }
            let local = env_lookup(env, name)
            if local.found {
                forge_llvm_build_store(cg.builder, r.value, local.alloca)
                return EmitResult { value: r.value, ty: local.ty, had_error: false, error_message: "" }
            }
            let g = global_lookup(name)
            if g.found {
                forge_llvm_build_store(cg.builder, r.value, g.llvm_global)
                return EmitResult { value: r.value, ty: g.ty, had_error: false, error_message: "" }
            }
            err_emit("assignment to undefined variable `" + name + "`")
        }
        .Call(callee, args) -> emit_call(cg, env, callee, args)
        .StructLit(name, inits) -> emit_struct_lit(cg, env, name, inits)
        .FieldAccess(obj, field) -> emit_field_access(cg, env, obj, field)
        .EnumCtor(type_name, variant, args) -> emit_enum_ctor(cg, env, type_name, variant, args)
        .Index(obj, idx) -> emit_index(cg, env, obj, idx)
        .Block(body) -> emit_block_expr(cg, env, body)
        .MatchExpr(subject, arms) -> emit_match_expr(cg, env, subject, arms)
        .FieldAssign(obj, field, value) -> emit_field_assign(cg, env, obj, field, value)
        .IfExpr(c, t, e) -> emit_if_expr(cg, env, c, t, e)
        _ -> err_emit("unsupported expression type")
    }
}

fn emit_if_expr(cg: Codegen, env: VarEnv, condition: Expr, then_branch: Expr, else_branch: Expr) -> EmitResult {
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return cond
    }
    let cond_i1 = forge_llvm_build_icmp(cg.builder, 33, cond.value, forge_llvm_const_int(cg.i64_type, 0, 0), "ife_cond")
    let then_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "ife_then")
    let else_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "ife_else")
    let merge_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "ife_end")
    let result_slot = forge_llvm_build_alloca(cg.builder, cg.i64_type, "ife_result")
    forge_llvm_build_store(cg.builder, forge_llvm_const_int(cg.i64_type, 0, 0), result_slot)
    forge_llvm_build_cond_br(cg.builder, cond_i1, then_bb, else_bb)

    forge_llvm_position_at_end(cg.builder, then_bb)
    let t = emit_expr(cg, env, then_branch)
    if t.had_error {
        return t
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_store(cg.builder, t.value, result_slot)
        forge_llvm_build_br(cg.builder, merge_bb)
    }

    forge_llvm_position_at_end(cg.builder, else_bb)
    let e = emit_expr(cg, env, else_branch)
    if e.had_error {
        return e
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_store(cg.builder, e.value, result_slot)
        forge_llvm_build_br(cg.builder, merge_bb)
    }

    forge_llvm_position_at_end(cg.builder, merge_bb)
    let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, result_slot, "ife_val")
    ok_emit(loaded)
}

fn emit_field_assign(cg: Codegen, env: VarEnv, obj: Expr, field: string, value: Expr) -> EmitResult {
    let r = emit_expr(cg, env, obj)
    if r.had_error {
        return r
    }
    let struct_name = strip_struct_prefix(r.ty)
    if struct_name == "" {
        return err_emit("field assignment on non-struct value (ty=" + r.ty + ")")
    }
    let lookup = struct_reg_lookup(struct_name)
    if !lookup.found {
        return err_emit("unknown struct `" + struct_name + "`")
    }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 {
        return err_emit("unknown field `" + field + "` on struct `" + struct_name + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(cg.ctx, struct_name)
    let obj_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "fa_ptr")
    let gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, obj_ptr, idx, "fa_fld")
    let v = emit_expr(cg, env, value)
    if v.had_error {
        return v
    }
    forge_llvm_build_store(cg.builder, v.value, gep)
    ok_emit(v.value)
}

fn emit_block_expr(cg: Codegen, env: VarEnv, stmts: StmtList) -> EmitResult {
    // A block expression's value is the value of the LAST
    // statement, if that statement is a `Stmt.Expr`. Anything
    // else (return, let, while, ...) yields i64 0. Each non-last
    // statement is executed for its side effects.
    emit_block_loop(cg, env, stmts, forge_llvm_const_int(cg.i64_type, 0, 0), "i64")
}

// A statement in tail position of a block expression must yield a
// value, even when the parser modeled it as a Stmt rather than an
// Expr. This dispatches each kind of "value-bearing" statement to the
// matching expression-emission helper, recursing through nested
// blocks/ifs as needed. Anything that has no value (let/while/return)
// falls through to emit_stmt and the caller's default last_val.
fn emit_stmt_as_value(cg: Codegen, env: VarEnv, stmt: Stmt, last_val: ptr, last_ty: string) -> EmitResult {
    match stmt {
        .Expr(e) -> emit_expr(cg, env, e)
        .Block(body) -> emit_block_expr(cg, env, body)
        .Match(subject, arms) -> emit_match_expr(cg, env, subject, arms)
        .If(condition, then_branch, else_branch) -> emit_stmt_if_as_value(cg, env, condition, then_branch, else_branch)
        _ -> {
            let s = emit_stmt(cg, env, stmt)
            if s.had_error {
                return err_emit(s.error_message)
            }
            EmitResult { value: last_val, ty: last_ty, had_error: false, error_message: "" }
        }
    }
}

// Mirror of emit_if_expr for the case where the if was parsed as a
// statement (Stmt.If with Stmt branches) but appears in tail position
// of a block expression. We need to phi the branch values back out,
// recursing into emit_stmt_as_value so nested blocks/matches/ifs in
// the branches also propagate their values.
fn emit_stmt_if_as_value(cg: Codegen, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> EmitResult {
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return cond
    }
    let cond_i1 = forge_llvm_build_icmp(cg.builder, 33, cond.value, forge_llvm_const_int(cg.i64_type, 0, 0), "sif_cond")
    let then_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "sif_then")
    let else_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "sif_else")
    let merge_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "sif_end")
    let result_slot = forge_llvm_build_alloca(cg.builder, cg.i64_type, "sif_result")
    forge_llvm_build_store(cg.builder, forge_llvm_const_int(cg.i64_type, 0, 0), result_slot)
    forge_llvm_build_cond_br(cg.builder, cond_i1, then_bb, else_bb)

    forge_llvm_position_at_end(cg.builder, then_bb)
    let zero = forge_llvm_const_int(cg.i64_type, 0, 0)
    let t = emit_stmt_as_value(cg, env, then_branch, zero, "i64")
    if t.had_error {
        return t
    }
    if forge_llvm_block_has_terminator(cg.builder) == 0 {
        forge_llvm_build_store(cg.builder, t.value, result_slot)
        forge_llvm_build_br(cg.builder, merge_bb)
    }

    forge_llvm_position_at_end(cg.builder, else_bb)
    if else_branch != null {
        let e = emit_stmt_as_value(cg, env, else_branch!, zero, "i64")
        if e.had_error {
            return e
        }
        if forge_llvm_block_has_terminator(cg.builder) == 0 {
            forge_llvm_build_store(cg.builder, e.value, result_slot)
            forge_llvm_build_br(cg.builder, merge_bb)
        }
    } else {
        forge_llvm_build_br(cg.builder, merge_bb)
    }

    forge_llvm_position_at_end(cg.builder, merge_bb)
    let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, result_slot, "sif_val")
    EmitResult { value: loaded, ty: t.ty, had_error: false, error_message: "" }
}

fn emit_block_loop(cg: Codegen, env: VarEnv, stmts: StmtList, last_val: ptr, last_ty: string) -> EmitResult {
    match stmts {
        .End -> EmitResult { value: last_val, ty: last_ty, had_error: false, error_message: "" }
        .Node(stmt, next) -> {
            match next {
                .End -> emit_stmt_as_value(cg, env, stmt, last_val, last_ty)
                _ -> {
                    let s = emit_stmt(cg, env, stmt)
                    if s.had_error {
                        return err_emit(s.error_message)
                    }
                    emit_block_loop(cg, s.env, next, last_val, last_ty)
                }
            }
        }
    }
}

fn emit_match_expr(cg: Codegen, env: VarEnv, subject: Expr, arms: MatchArmList) -> EmitResult {
    let r = emit_expr(cg, env, subject)
    if r.had_error {
        return r
    }
    let enum_name = strip_enum_prefix(r.ty)
    if enum_name == "" {
        return err_emit("match subject is not an enum (ty=" + r.ty + ")")
    }
    let lookup = enum_reg_lookup(enum_name)
    if !lookup.found {
        return err_emit("unknown enum `" + enum_name + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(cg.ctx, enum_name)
    let subj_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "match_subj")
    let tag_gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, subj_ptr, 0, "tag_ptr")
    let tag_val = forge_llvm_build_load(cg.builder, forge_llvm_int8_type(cg.ctx), tag_gep, "tag")

    // Allocate a result slot. Each arm stores its value here, and
    // we load from it after the merge block.
    let result_slot = forge_llvm_build_alloca(cg.builder, cg.i64_type, "match_result")
    forge_llvm_build_store(cg.builder, forge_llvm_const_int(cg.i64_type, 0, 0), result_slot)

    let merge_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "match_end")
    // The arm-emission helper returns an EmitResult whose `ty`
    // field carries the type tag of the FIRST arm body — that
    // becomes the type of the whole match expression. All arms are
    // expected to produce the same type; we don't unify here.
    let arm_result = emit_match_expr_arms(cg, env, arms, st_ty, subj_ptr, tag_val, lookup.variants, merge_bb, result_slot)
    if arm_result.had_error {
        return arm_result
    }
    forge_llvm_position_at_end(cg.builder, merge_bb)
    let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, result_slot, "match_val")
    EmitResult { value: loaded, ty: arm_result.ty, had_error: false, error_message: "" }
}

fn emit_match_expr_arms(cg: Codegen, env: VarEnv, arms: MatchArmList, st_ty: ptr, subj_ptr: ptr, tag_val: ptr, variants: VariantList, merge_bb: ptr, result_slot: ptr) -> EmitResult {
    match arms {
        .End -> {
            if forge_llvm_block_has_terminator(cg.builder) == 0 {
                forge_llvm_build_br(cg.builder, merge_bb)
            }
            // No more arms — the surrounding match expression keeps
            // the type that an earlier arm already carried, so we
            // return a placeholder ty which the caller's first-arm
            // tracking ignores.
            EmitResult { value: null_ptr_val(), ty: "i64", had_error: false, error_message: "" }
        }
        .Node(pattern, body, next) -> {
            let arm_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "march_arm")
            let next_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "march_next")
            match pattern {
                .Wildcard -> forge_llvm_build_br(cg.builder, arm_bb)
                .Variant(vname, _) -> {
                    let v = variant_lookup(variants, vname)
                    if !v.found {
                        return err_emit("pattern references unknown variant `" + vname + "`")
                    }
                    let want_tag = forge_llvm_const_int(forge_llvm_int8_type(cg.ctx), v.tag, 0)
                    let cmp = forge_llvm_build_icmp(cg.builder, 32, tag_val, want_tag, "tag_eq")
                    forge_llvm_build_cond_br(cg.builder, cmp, arm_bb, next_bb)
                }
            }
            forge_llvm_position_at_end(cg.builder, arm_bb)
            let arm_env = bind_pattern_payload(cg, env, pattern, st_ty, subj_ptr, variants)
            let body_result = emit_expr(cg, arm_env, body)
            if body_result.had_error {
                return body_result
            }
            if forge_llvm_block_has_terminator(cg.builder) == 0 {
                forge_llvm_build_store(cg.builder, body_result.value, result_slot)
                forge_llvm_build_br(cg.builder, merge_bb)
            }
            forge_llvm_position_at_end(cg.builder, next_bb)
            // Recurse to emit the remaining arms; we keep this
            // arm's result type as the match expression's overall
            // type. (The bootstrap source doesn't mix types
            // across arms.)
            let _rest = emit_match_expr_arms(cg, env, next, st_ty, subj_ptr, tag_val, variants, merge_bb, result_slot)
            EmitResult { value: body_result.value, ty: body_result.ty, had_error: false, error_message: "" }
        }
    }
}

fn emit_index(cg: Codegen, env: VarEnv, obj: Expr, idx: Expr) -> EmitResult {
    let r = emit_expr(cg, env, obj)
    if r.had_error {
        return r
    }
    if r.ty != "str" && r.ty != "string" {
        return err_emit("indexing on non-string value (ty=" + r.ty + ")")
    }
    let i_r = emit_expr(cg, env, idx)
    if i_r.had_error {
        return i_r
    }
    // Allocate a 2-byte buffer (1 char + nul), copy the byte at
    // src+i, set buf[1]=0. Returns a fresh str.
    let src_int = r.value
    let off_int = forge_llvm_build_add(cg.builder, src_int, i_r.value, "idx_off_int")
    let off_ptr = forge_llvm_build_int_to_ptr(cg.builder, off_int, cg.ptr_type, "idx_off")
    let byte = forge_llvm_build_load(cg.builder, forge_llvm_int8_type(cg.ctx), off_ptr, "idx_byte")
    let malloc_fn = forge_llvm_get_named_function(cg.module, "malloc")
    let mpa = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(mpa, 0, cg.i64_type)
    let malloc_type = forge_llvm_function_type(cg.ptr_type, mpa, 1, 0)
    forge_llvm_type_array_free(mpa)
    let m_arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(m_arr, 0, forge_llvm_const_int(cg.i64_type, 2, 0))
    let buf = forge_llvm_build_call(cg.builder, malloc_type, malloc_fn, m_arr, 1, "idx_buf")
    forge_llvm_value_array_free(m_arr)
    forge_llvm_build_store(cg.builder, byte, buf)
    // buf[1] = 0
    let buf_int = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "idx_buf_int")
    let one = forge_llvm_const_int(cg.i64_type, 1, 0)
    let nul_int = forge_llvm_build_add(cg.builder, buf_int, one, "idx_nul_int")
    let nul_ptr = forge_llvm_build_int_to_ptr(cg.builder, nul_int, cg.ptr_type, "idx_nul")
    forge_llvm_build_store(cg.builder, forge_llvm_const_int(forge_llvm_int8_type(cg.ctx), 0, 0), nul_ptr)
    let result_i64 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "idx_result")
    ok_emit_str(result_i64)
}

fn emit_struct_lit(cg: Codegen, env: VarEnv, name: string, inits: FieldInitList) -> EmitResult {
    let lookup = struct_reg_lookup(name)
    if !lookup.found {
        return err_emit("undefined struct type `" + name + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(cg.ctx, name)
    if st_ty == null {
        return err_emit("LLVM struct type `" + name + "` not declared")
    }
    // Heap-allocate the struct so it survives across function
    // returns (a stack alloca would be a dangling pointer once the
    // creating frame is popped). Bootstrap leaks: the compiler
    // runs once and the OS reclaims everything.
    let buf = malloc_struct_bytes(cg, lookup.fields)
    let fill = fill_struct_fields(cg, env, st_ty, buf, inits, lookup.fields)
    if fill.had_error {
        return fill
    }
    let as_i64 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "struct_i64")
    EmitResult { value: as_i64, ty: "struct:" + name, had_error: false, error_message: "" }
}

// malloc(field_count * 8 bytes) — every struct field is an i64
// slot (strings/structs/enums are pointer-encoded).
fn malloc_struct_bytes(cg: Codegen, fields: FieldList) -> ptr {
    let count = field_list_length(fields)
    let size = forge_llvm_const_int(cg.i64_type, count * 8, 0)
    let malloc_fn = forge_llvm_get_named_function(cg.module, "malloc")
    let pa = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(pa, 0, cg.i64_type)
    let malloc_type = forge_llvm_function_type(cg.ptr_type, pa, 1, 0)
    forge_llvm_type_array_free(pa)
    let arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(arr, 0, size)
    let buf = forge_llvm_build_call(cg.builder, malloc_type, malloc_fn, arr, 1, "struct_buf")
    forge_llvm_value_array_free(arr)
    buf
}

fn fill_struct_fields(cg: Codegen, env: VarEnv, st_ty: ptr, alloca: ptr, inits: FieldInitList, fields: FieldList) -> EmitResult {
    match inits {
        .End -> ok_emit(null_ptr_val())
        .Node(field_name, value, next) -> {
            let idx = field_index_of(fields, field_name)
            if idx < 0 {
                return err_emit("unknown field `" + field_name + "`")
            }
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return r
            }
            let gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, alloca, idx, "fld_ptr")
            forge_llvm_build_store(cg.builder, r.value, gep)
            fill_struct_fields(cg, env, st_ty, alloca, next, fields)
        }
    }
}

fn emit_field_access(cg: Codegen, env: VarEnv, obj: Expr, field: string) -> EmitResult {
    // Special case: bare `EnumName.Variant` (zero-arg enum
    // constructor). The parser models this as
    // FieldAccess(Ident(EnumName), Variant).
    match obj {
        .Ident(head) -> {
            let enum_l = enum_reg_lookup(head)
            if enum_l.found {
                return emit_enum_ctor(cg, env, head, field, ExprList.End)
            }
        }
        _ -> {}
    }

    let r = emit_expr(cg, env, obj)
    if r.had_error {
        return r
    }
    // String property access — `s.length` is a libc strlen.
    if r.ty == "str" && field == "length" {
        let str_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "len_arg")
        let strlen_fn = forge_llvm_get_named_function(cg.module, "strlen")
        let pa = forge_llvm_type_array_new(1)
        forge_llvm_type_array_set(pa, 0, cg.ptr_type)
        let strlen_ty = forge_llvm_function_type(cg.i64_type, pa, 1, 0)
        forge_llvm_type_array_free(pa)
        let arr = forge_llvm_value_array_new(1)
        forge_llvm_value_array_set(arr, 0, str_ptr)
        let len = forge_llvm_build_call(cg.builder, strlen_ty, strlen_fn, arr, 1, "strlen_call")
        forge_llvm_value_array_free(arr)
        return ok_emit(len)
    }
    // The object's ty tag tells us which struct it is.
    let struct_name = strip_struct_prefix(r.ty)
    if struct_name == "" {
        return err_emit("field access on non-struct value (ty=" + r.ty + ", field=" + field + ")")
    }
    let lookup = struct_reg_lookup(struct_name)
    if !lookup.found {
        return err_emit("unknown struct `" + struct_name + "`")
    }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 {
        return err_emit("unknown field `" + field + "` on struct `" + struct_name + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(cg.ctx, struct_name)
    let obj_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "obj_ptr")
    let gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, obj_ptr, idx, "fld_ptr")
    let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, gep, field)
    let field_ty = translate_param_type(field_type_of(lookup.fields, field))
    EmitResult { value: loaded, ty: field_ty, had_error: false, error_message: "" }
}

fn emit_enum_ctor(cg: Codegen, env: VarEnv, type_name: string, variant: string, args: ExprList) -> EmitResult {
    let enum_l = enum_reg_lookup(type_name)
    if !enum_l.found {
        return err_emit("undefined enum type `" + type_name + "`")
    }
    let v = variant_lookup(enum_l.variants, variant)
    if !v.found {
        return err_emit("enum `" + type_name + "` has no variant `" + variant + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(cg.ctx, type_name)
    if st_ty == null {
        return err_emit("LLVM enum type `" + type_name + "` not declared")
    }
    // Heap-allocate the enum so it survives across function returns.
    let buf = malloc_enum_bytes(cg, enum_l.variants)
    let tag_gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, buf, 0, "tag_ptr")
    let tag_val = forge_llvm_const_int(forge_llvm_int8_type(cg.ctx), v.tag, 0)
    forge_llvm_build_store(cg.builder, tag_val, tag_gep)
    let fill = fill_enum_payload(cg, env, st_ty, buf, args, 0)
    if fill.had_error {
        return fill
    }
    let as_i64 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "enum_i64")
    EmitResult { value: as_i64, ty: "enum:" + type_name, had_error: false, error_message: "" }
}

// malloc((max_payload + 1) * 8 bytes) — one i64 for the tag plus
// one i64 per payload slot. The tag is technically i8 but the
// LLVM struct layout aligns the next field to 8 bytes.
fn malloc_enum_bytes(cg: Codegen, variants: VariantList) -> ptr {
    let max_payload = variant_max_payload(variants)
    let size = forge_llvm_const_int(cg.i64_type, (max_payload + 1) * 8, 0)
    let malloc_fn = forge_llvm_get_named_function(cg.module, "malloc")
    let pa = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(pa, 0, cg.i64_type)
    let malloc_type = forge_llvm_function_type(cg.ptr_type, pa, 1, 0)
    forge_llvm_type_array_free(pa)
    let arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(arr, 0, size)
    let buf = forge_llvm_build_call(cg.builder, malloc_type, malloc_fn, arr, 1, "enum_buf")
    forge_llvm_value_array_free(arr)
    buf
}

fn fill_enum_payload(cg: Codegen, env: VarEnv, st_ty: ptr, alloca: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(expr, next) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return r
            }
            let gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, alloca, idx + 1, "payload_ptr")
            forge_llvm_build_store(cg.builder, r.value, gep)
            fill_enum_payload(cg, env, st_ty, alloca, next, idx + 1)
        }
    }
}

// "enum:Name" → "Name"; anything else → "".
fn emit_match(cg: Codegen, env: VarEnv, subject: Expr, arms: MatchArmList) -> StmtResult {
    let r = emit_expr(cg, env, subject)
    if r.had_error {
        return err_stmt_from_expr(r)
    }
    let enum_name = strip_enum_prefix(r.ty)
    if enum_name == "" {
        let dbg = match subject {
            .Ident(n) -> "ident " + n
            .Call(callee, _) -> {
                match callee {
                    .Ident(cn) -> "call " + cn
                    _ -> "call other"
                }
            }
            .FieldAccess(_, f) -> "field " + f
            _ -> "other"
        }
        return err_stmt("codegen error: match subject is not an enum (ty=" + r.ty + ") subj=" + dbg)
    }
    let lookup = enum_reg_lookup(enum_name)
    if !lookup.found {
        return err_stmt("codegen error: unknown enum `" + enum_name + "`")
    }
    let st_ty = forge_llvm_get_type_by_name(cg.ctx, enum_name)
    let subj_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "match_subj")
    // Load tag once.
    let tag_gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, subj_ptr, 0, "tag_ptr")
    let tag_val = forge_llvm_build_load(cg.builder, forge_llvm_int8_type(cg.ctx), tag_gep, "tag")

    let merge_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "match_end")
    let arm_result = emit_match_arms(cg, env, arms, st_ty, subj_ptr, tag_val, lookup.variants, merge_bb)
    if arm_result.had_error {
        return arm_result
    }
    forge_llvm_position_at_end(cg.builder, merge_bb)
    ok_stmt(env)
}

fn emit_match_arms(cg: Codegen, env: VarEnv, arms: MatchArmList, st_ty: ptr, subj_ptr: ptr, tag_val: ptr, variants: VariantList, merge_bb: ptr) -> StmtResult {
    match arms {
        .End -> {
            // No more arms — terminate the current block by branching
            // to merge if it isn't already terminated. (A wildcard
            // arm is the standard way to handle this.)
            if forge_llvm_block_has_terminator(cg.builder) == 0 {
                forge_llvm_build_br(cg.builder, merge_bb)
            }
            ok_stmt(env)
        }
        .Node(pattern, body, next) -> {
            let arm_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "match_arm")
            let next_bb = forge_llvm_append_basic_block(cg.ctx, cg.current_fn, "match_next")
            // Compare current tag against this pattern's variant tag,
            // or always-true for wildcard.
            match pattern {
                .Wildcard -> {
                    forge_llvm_build_br(cg.builder, arm_bb)
                }
                .Variant(vname, _) -> {
                    let v = variant_lookup(variants, vname)
                    if !v.found {
                        return err_stmt("codegen error: pattern references unknown variant `" + vname + "`")
                    }
                    let want_tag = forge_llvm_const_int(forge_llvm_int8_type(cg.ctx), v.tag, 0)
                    let cmp = forge_llvm_build_icmp(cg.builder, 32, tag_val, want_tag, "tag_eq")
                    forge_llvm_build_cond_br(cg.builder, cmp, arm_bb, next_bb)
                }
            }
            // Emit the arm body (now an Expr — we discard the value
            // because this is the statement form). With payload
            // bindings if any.
            forge_llvm_position_at_end(cg.builder, arm_bb)
            let arm_env = bind_pattern_payload(cg, env, pattern, st_ty, subj_ptr, variants)
            let body_result = emit_expr(cg, arm_env, body)
            if body_result.had_error {
                return err_stmt(body_result.error_message)
            }
            if forge_llvm_block_has_terminator(cg.builder) == 0 {
                forge_llvm_build_br(cg.builder, merge_bb)
            }
            // Continue dispatch in next_bb.
            forge_llvm_position_at_end(cg.builder, next_bb)
            emit_match_arms(cg, env, next, st_ty, subj_ptr, tag_val, variants, merge_bb)
        }
    }
}

fn bind_pattern_payload(cg: Codegen, env: VarEnv, pattern: Pattern, st_ty: ptr, subj_ptr: ptr, variants: VariantList) -> VarEnv {
    match pattern {
        .Wildcard -> env
        .Variant(vname, bindings) -> {
            let v = variant_lookup(variants, vname)
            if !v.found {
                return env
            }
            // Walk the bindings ParamList in parallel with the
            // variant's FieldList. For each name, GEP to payload
            // index (1 + i), load i64, alloca, store.
            bind_pattern_payload_loop(cg, env, st_ty, subj_ptr, bindings, v.fields, 0)
        }
    }
}

fn bind_pattern_payload_loop(cg: Codegen, env: VarEnv, st_ty: ptr, subj_ptr: ptr, bindings: ParamList, fields: FieldList, idx: int) -> VarEnv {
    match bindings {
        .End -> env
        .Node(name, _, next_b) -> {
            // _ in a binding position is a "don't bind" placeholder.
            if name == "_" {
                return bind_pattern_payload_loop(cg, env, st_ty, subj_ptr, next_b, advance_field_list(fields), idx + 1)
            }
            let gep = forge_llvm_build_struct_gep2(cg.builder, st_ty, subj_ptr, idx + 1, "pbind_ptr")
            let loaded = forge_llvm_build_load(cg.builder, cg.i64_type, gep, name)
            let alloca = forge_llvm_build_alloca(cg.builder, cg.i64_type, name)
            forge_llvm_build_store(cg.builder, loaded, alloca)
            let field_ty = translate_param_type(field_type_at(fields, 0))
            let extended = env_extend(env, name, alloca, field_ty)
            bind_pattern_payload_loop(cg, extended, st_ty, subj_ptr, next_b, advance_field_list(fields), idx + 1)
        }
    }
}

export fn advance_field_list(fields: FieldList) -> FieldList {
    match fields {
        .End -> FieldList.End
        .Node(_, _, next) -> next
    }
}

export fn field_type_at(fields: FieldList, idx: int) -> string {
    match fields {
        .End -> "i64"
        .Node(_, ty, next) -> {
            if idx <= 0 {
                return ty
            }
            field_type_at(next, idx - 1)
        }
    }
}

export fn strip_enum_prefix(ty: string) -> string {
    if ty.length < 6 {
        return ""
    }
    let head = ty.substring(0, 5)
    if head != "enum:" {
        return ""
    }
    ty.substring(5, ty.length)
}

// "struct:Name" → "Name"; anything else → "".
fn strip_struct_prefix(ty: string) -> string {
    if ty.length < 8 {
        return ""
    }
    let head = ty.substring(0, 7)
    if head != "struct:" {
        return ""
    }
    ty.substring(7, ty.length)
}

fn emit_call(cg: Codegen, env: VarEnv, callee: Expr, args: ExprList) -> EmitResult {
    // Destructure callee exactly once.
    match callee {
        .Ident(name) -> emit_call_named(cg, env, name, args)
        .FieldAccess(obj, method) -> emit_method_call(cg, env, obj, method, args)
        _ -> err_emit("only direct function calls are supported")
    }
}

fn emit_method_call(cg: Codegen, env: VarEnv, obj: Expr, method: string, args: ExprList) -> EmitResult {
    // Special-case `.length` and `.substring` on strings — these are
    // emitted via libc strlen / a custom substring helper rather than
    // dispatched as methods.
    let r = emit_expr(cg, env, obj)
    if r.had_error {
        return r
    }
    if r.ty == "str" {
        if method == "length" {
            let str_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "len_arg")
            let strlen_fn = forge_llvm_get_named_function(cg.module, "strlen")
            let pa = forge_llvm_type_array_new(1)
            forge_llvm_type_array_set(pa, 0, cg.ptr_type)
            let strlen_ty = forge_llvm_function_type(cg.i64_type, pa, 1, 0)
            forge_llvm_type_array_free(pa)
            let arr = forge_llvm_value_array_new(1)
            forge_llvm_value_array_set(arr, 0, str_ptr)
            let len = forge_llvm_build_call(cg.builder, strlen_ty, strlen_fn, arr, 1, "strlen_call")
            forge_llvm_value_array_free(arr)
            return ok_emit(len)
        }
        if method == "substring" {
            return emit_substring(cg, env, r.value, args)
        }
        return err_emit("string method `" + method + "` not implemented")
    }
    // Otherwise: dispatch by type tag → `Type__method(obj, args)`.
    let type_name = strip_struct_prefix(r.ty)
    let enum_name = strip_enum_prefix(r.ty)
    let owner = if type_name != "" {
        type_name
    } else {
        enum_name
    }
    if owner == "" {
        return err_emit("method call on non-struct/enum value (ty=" + r.ty + ")")
    }
    let mangled = owner + "__" + method
    let fn_val = forge_llvm_get_named_function(cg.module, mangled)
    if fn_val == null {
        return err_emit("undefined method `" + owner + "." + method + "`")
    }
    // Build arg array with self prepended.
    let extra_count = expr_list_length(args)
    let arg_count = extra_count + 1
    let arg_arr = forge_llvm_value_array_new(arg_count)
    forge_llvm_value_array_set(arg_arr, 0, r.value)
    let fill = fill_arg_array(cg, env, arg_arr, args, 1)
    if fill.had_error {
        forge_llvm_value_array_free(arg_arr)
        return fill
    }
    let param_arr = forge_llvm_type_array_new(arg_count)
    fill_i64_param_array(param_arr, cg.i64_type, 0, arg_count)
    let fn_type = forge_llvm_function_type(cg.i64_type, param_arr, arg_count, 0)
    forge_llvm_type_array_free(param_arr)
    let result = forge_llvm_build_call(cg.builder, fn_type, fn_val, arg_arr, arg_count, "methcall")
    forge_llvm_value_array_free(arg_arr)
    let ret_ty = fn_ret_lookup(mangled)
    if ret_ty == "" {
        return ok_emit(result)
    }
    EmitResult { value: result, ty: ret_ty, had_error: false, error_message: "" }
}

fn emit_call_named(cg: Codegen, env: VarEnv, name: string, args: ExprList) -> EmitResult {
    if name == "println" {
        return emit_println(cg, env, args)
    }
    if name == "eprintln" {
        // Same as println for the MVP — go to stdout. Bootstrap
        // source uses eprintln only for diagnostics.
        return emit_println(cg, env, args)
    }
    if name == "string" {
        return emit_int_to_string(cg, env, args)
    }
    if name == "int" {
        return emit_string_to_int(cg, env, args)
    }
    let fn_val = forge_llvm_get_named_function(cg.module, name)
    if fn_val == null {
        return err_emit("undefined function `" + name + "`")
    }

    let arg_count = expr_list_length(args)
    let arg_arr = forge_llvm_value_array_new(arg_count)
    let fill = fill_arg_array(cg, env, arg_arr, args, 0)
    if fill.had_error {
        forge_llvm_value_array_free(arg_arr)
        return fill
    }
    // All bootstrap functions have the same shape: (i64, i64, ...) -> i64.
    let param_arr = forge_llvm_type_array_new(arg_count)
    fill_i64_param_array(param_arr, cg.i64_type, 0, arg_count)
    let fn_type = forge_llvm_function_type(cg.i64_type, param_arr, arg_count, 0)
    forge_llvm_type_array_free(param_arr)

    let result = forge_llvm_build_call(cg.builder, fn_type, fn_val, arg_arr, arg_count, "calltmp")
    forge_llvm_value_array_free(arg_arr)
    let ret_ty = fn_ret_lookup(name)
    if ret_ty == "" {
        return ok_emit(result)
    }
    EmitResult { value: result, ty: ret_ty, had_error: false, error_message: "" }
}

fn emit_int_to_string(cg: Codegen, env: VarEnv, args: ExprList) -> EmitResult {
    // string(i64) → str via snprintf into a 32-byte malloc'd buffer.
    match args {
        .End -> err_emit("string() expects 1 arg")
        .Node(arg, _) -> {
            let r = emit_expr(cg, env, arg)
            if r.had_error {
                return r
            }
            // If the value is already a str, pass it through.
            if r.ty == "str" {
                return r
            }
            // malloc(32)
            let malloc_fn = forge_llvm_get_named_function(cg.module, "malloc")
            let mpa = forge_llvm_type_array_new(1)
            forge_llvm_type_array_set(mpa, 0, cg.i64_type)
            let malloc_type = forge_llvm_function_type(cg.ptr_type, mpa, 1, 0)
            forge_llvm_type_array_free(mpa)
            let m_arr = forge_llvm_value_array_new(1)
            forge_llvm_value_array_set(m_arr, 0, forge_llvm_const_int(cg.i64_type, 32, 0))
            let buf = forge_llvm_build_call(cg.builder, malloc_type, malloc_fn, m_arr, 1, "i2s_buf")
            forge_llvm_value_array_free(m_arr)
            // snprintf(buf, 32, "%lld", value)
            let fmt = forge_llvm_build_global_string_ptr(cg.builder, "%lld", ".i2s_fmt")
            let snprintf_fn = forge_llvm_get_named_function(cg.module, "snprintf")
            let spa = forge_llvm_type_array_new(3)
            forge_llvm_type_array_set(spa, 0, cg.ptr_type)
            forge_llvm_type_array_set(spa, 1, cg.i64_type)
            forge_llvm_type_array_set(spa, 2, cg.ptr_type)
            let snprintf_type = forge_llvm_function_type(forge_llvm_int32_type(cg.ctx), spa, 3, 1)
            forge_llvm_type_array_free(spa)
            let s_arr = forge_llvm_value_array_new(4)
            forge_llvm_value_array_set(s_arr, 0, buf)
            forge_llvm_value_array_set(s_arr, 1, forge_llvm_const_int(cg.i64_type, 32, 0))
            forge_llvm_value_array_set(s_arr, 2, fmt)
            forge_llvm_value_array_set(s_arr, 3, r.value)
            forge_llvm_build_call(cg.builder, snprintf_type, snprintf_fn, s_arr, 4, "")
            forge_llvm_value_array_free(s_arr)
            let result_i64 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "i2s_result")
            ok_emit_str(result_i64)
        }
    }
}

fn emit_string_to_int(cg: Codegen, env: VarEnv, args: ExprList) -> EmitResult {
    // int(str) → i64 via libc atoi.
    match args {
        .End -> err_emit("int() expects 1 arg")
        .Node(arg, _) -> {
            let r = emit_expr(cg, env, arg)
            if r.had_error {
                return r
            }
            if r.ty != "str" {
                // Already an int — pass through.
                return r
            }
            let str_ptr = forge_llvm_build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "atoi_arg")
            let atoi_fn = forge_llvm_get_named_function(cg.module, "atoi")
            let pa = forge_llvm_type_array_new(1)
            forge_llvm_type_array_set(pa, 0, cg.ptr_type)
            let atoi_type = forge_llvm_function_type(forge_llvm_int32_type(cg.ctx), pa, 1, 0)
            forge_llvm_type_array_free(pa)
            let arr = forge_llvm_value_array_new(1)
            forge_llvm_value_array_set(arr, 0, str_ptr)
            let result32 = forge_llvm_build_call(cg.builder, atoi_type, atoi_fn, arr, 1, "atoi_call")
            forge_llvm_value_array_free(arr)
            // Sign-extend i32 → i64.
            ok_emit(forge_llvm_build_sext(cg.builder, result32, cg.i64_type, "atoi_ext"))
        }
    }
}

fn emit_println(cg: Codegen, env: VarEnv, args: ExprList) -> EmitResult {
    // Special-case the most common shape: `println("literal")`. We
    // destructure straight to the inner string text in a single
    // match — going through any extra binding clobbers the payload
    // (host miscompilation, see TECH_DEBT.md #11).
    let str_i64 = match args {
        .Node(e, _) -> {
            match e {
                .String(text) -> {
                    let inner = strip_quotes(text)
                    let str_ptr = forge_llvm_build_global_string_ptr(cg.builder, inner, ".str")
                    forge_llvm_build_ptr_to_int(cg.builder, str_ptr, cg.i64_type, "str_i64")
                }
                _ -> {
                    let r = emit_expr(cg, env, e)
                    if r.had_error {
                        return r
                    }
                    r.value
                }
            }
        }
        .End -> {
            return err_emit("println expects 1 argument")
        }
    }
    let str_ptr2 = forge_llvm_build_int_to_ptr(cg.builder, str_i64, cg.ptr_type, "str_ptr")
    let puts_fn = forge_llvm_get_named_function(cg.module, "puts")
    let arg_arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(arg_arr, 0, str_ptr2)
    let puts_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(puts_param_arr, 0, cg.ptr_type)
    let puts_type = forge_llvm_function_type(forge_llvm_int32_type(cg.ctx), puts_param_arr, 1, 0)
    forge_llvm_type_array_free(puts_param_arr)
    forge_llvm_build_call(cg.builder, puts_type, puts_fn, arg_arr, 1, "")
    forge_llvm_value_array_free(arg_arr)
    ok_emit(forge_llvm_const_int(cg.i64_type, 0, 0))
}

fn emit_concat(cg: Codegen, lhs_i64: ptr, rhs_i64: ptr) -> EmitResult {
    // Decode the i64-encoded operands back to ptrs.
    let lhs_ptr = forge_llvm_build_int_to_ptr(cg.builder, lhs_i64, cg.ptr_type, "concat_l")
    let rhs_ptr = forge_llvm_build_int_to_ptr(cg.builder, rhs_i64, cg.ptr_type, "concat_r")

    // strlen each side.
    let strlen_fn = forge_llvm_get_named_function(cg.module, "strlen")
    let strlen_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(strlen_param_arr, 0, cg.ptr_type)
    let strlen_type = forge_llvm_function_type(cg.i64_type, strlen_param_arr, 1, 0)
    forge_llvm_type_array_free(strlen_param_arr)

    let l_arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(l_arr, 0, lhs_ptr)
    let lhs_len = forge_llvm_build_call(cg.builder, strlen_type, strlen_fn, l_arr, 1, "lhs_len")
    forge_llvm_value_array_free(l_arr)

    let r_arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(r_arr, 0, rhs_ptr)
    let rhs_len = forge_llvm_build_call(cg.builder, strlen_type, strlen_fn, r_arr, 1, "rhs_len")
    forge_llvm_value_array_free(r_arr)

    // total = lhs_len + rhs_len; alloc = total + 1 (null terminator)
    let total = forge_llvm_build_add(cg.builder, lhs_len, rhs_len, "concat_total")
    let one = forge_llvm_const_int(cg.i64_type, 1, 0)
    let alloc_size = forge_llvm_build_add(cg.builder, total, one, "concat_size")

    // malloc(alloc_size)
    let malloc_fn = forge_llvm_get_named_function(cg.module, "malloc")
    let malloc_param_arr = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(malloc_param_arr, 0, cg.i64_type)
    let malloc_type = forge_llvm_function_type(cg.ptr_type, malloc_param_arr, 1, 0)
    forge_llvm_type_array_free(malloc_param_arr)

    let m_arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(m_arr, 0, alloc_size)
    let buf = forge_llvm_build_call(cg.builder, malloc_type, malloc_fn, m_arr, 1, "concat_buf")
    forge_llvm_value_array_free(m_arr)

    // memcpy(buf, lhs_ptr, lhs_len)
    let memcpy_fn = forge_llvm_get_named_function(cg.module, "memcpy")
    let memcpy_param_arr = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(memcpy_param_arr, 0, cg.ptr_type)
    forge_llvm_type_array_set(memcpy_param_arr, 1, cg.ptr_type)
    forge_llvm_type_array_set(memcpy_param_arr, 2, cg.i64_type)
    let memcpy_type = forge_llvm_function_type(cg.ptr_type, memcpy_param_arr, 3, 0)
    forge_llvm_type_array_free(memcpy_param_arr)

    let mc1_arr = forge_llvm_value_array_new(3)
    forge_llvm_value_array_set(mc1_arr, 0, buf)
    forge_llvm_value_array_set(mc1_arr, 1, lhs_ptr)
    forge_llvm_value_array_set(mc1_arr, 2, lhs_len)
    forge_llvm_build_call(cg.builder, memcpy_type, memcpy_fn, mc1_arr, 3, "")
    forge_llvm_value_array_free(mc1_arr)

    // memcpy(buf + lhs_len, rhs_ptr, rhs_len + 1)  — copies rhs and the trailing NUL
    let buf_int = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "buf_int")
    let dst2_int = forge_llvm_build_add(cg.builder, buf_int, lhs_len, "dst2_int")
    let dst2 = forge_llvm_build_int_to_ptr(cg.builder, dst2_int, cg.ptr_type, "dst2")
    let rhs_len_plus_1 = forge_llvm_build_add(cg.builder, rhs_len, one, "rhs_len_p1")

    let mc2_arr = forge_llvm_value_array_new(3)
    forge_llvm_value_array_set(mc2_arr, 0, dst2)
    forge_llvm_value_array_set(mc2_arr, 1, rhs_ptr)
    forge_llvm_value_array_set(mc2_arr, 2, rhs_len_plus_1)
    forge_llvm_build_call(cg.builder, memcpy_type, memcpy_fn, mc2_arr, 3, "")
    forge_llvm_value_array_free(mc2_arr)

    let result_i64 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "concat_i64")
    ok_emit_str(result_i64)
}

fn emit_substring(cg: Codegen, env: VarEnv, str_i64: ptr, args: ExprList) -> EmitResult {
    // Expect exactly two integer args: start and end (exclusive).
    // Destructure exactly once — repeated `match args` corrupts
    // the inner payloads (host-compiler issue).
    match args {
        .End -> err_emit("substring expects 2 args, got 0")
        .Node(start_arg, rest) -> {
            match rest {
                .End -> err_emit("substring expects 2 args, got 1")
                .Node(end_arg, _) -> emit_substring_inner(cg, env, str_i64, start_arg, end_arg)
            }
        }
    }
}

fn emit_substring_inner(cg: Codegen, env: VarEnv, str_i64: ptr, start_arg: Expr, end_arg: Expr) -> EmitResult {
    let start_r = emit_expr(cg, env, start_arg)
    if start_r.had_error {
        return start_r
    }
    let end_r = emit_expr(cg, env, end_arg)
    if end_r.had_error {
        return end_r
    }
    let str_ptr = forge_llvm_build_int_to_ptr(cg.builder, str_i64, cg.ptr_type, "sub_src")
    let len = forge_llvm_build_sub(cg.builder, end_r.value, start_r.value, "sub_len")
    let one = forge_llvm_const_int(cg.i64_type, 1, 0)
    let alloc_size = forge_llvm_build_add(cg.builder, len, one, "sub_alloc")
    // malloc(alloc_size)
    let malloc_fn = forge_llvm_get_named_function(cg.module, "malloc")
    let mpa = forge_llvm_type_array_new(1)
    forge_llvm_type_array_set(mpa, 0, cg.i64_type)
    let malloc_type = forge_llvm_function_type(cg.ptr_type, mpa, 1, 0)
    forge_llvm_type_array_free(mpa)
    let m_arr = forge_llvm_value_array_new(1)
    forge_llvm_value_array_set(m_arr, 0, alloc_size)
    let buf = forge_llvm_build_call(cg.builder, malloc_type, malloc_fn, m_arr, 1, "sub_buf")
    forge_llvm_value_array_free(m_arr)
    // memcpy(buf, src + start, len)
    let src_int = forge_llvm_build_ptr_to_int(cg.builder, str_ptr, cg.i64_type, "sub_src_int")
    let off_int = forge_llvm_build_add(cg.builder, src_int, start_r.value, "sub_off_int")
    let off_ptr = forge_llvm_build_int_to_ptr(cg.builder, off_int, cg.ptr_type, "sub_off")
    let memcpy_fn = forge_llvm_get_named_function(cg.module, "memcpy")
    let mcpa = forge_llvm_type_array_new(3)
    forge_llvm_type_array_set(mcpa, 0, cg.ptr_type)
    forge_llvm_type_array_set(mcpa, 1, cg.ptr_type)
    forge_llvm_type_array_set(mcpa, 2, cg.i64_type)
    let memcpy_type = forge_llvm_function_type(cg.ptr_type, mcpa, 3, 0)
    forge_llvm_type_array_free(mcpa)
    let mc_arr = forge_llvm_value_array_new(3)
    forge_llvm_value_array_set(mc_arr, 0, buf)
    forge_llvm_value_array_set(mc_arr, 1, off_ptr)
    forge_llvm_value_array_set(mc_arr, 2, len)
    forge_llvm_build_call(cg.builder, memcpy_type, memcpy_fn, mc_arr, 3, "")
    forge_llvm_value_array_free(mc_arr)
    // Null-terminate at buf[len].
    let buf_int2 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "sub_buf_int")
    let nul_int = forge_llvm_build_add(cg.builder, buf_int2, len, "sub_nul_int")
    let nul_ptr = forge_llvm_build_int_to_ptr(cg.builder, nul_int, cg.ptr_type, "sub_nul")
    forge_llvm_build_store(cg.builder, forge_llvm_const_int(forge_llvm_int8_type(cg.ctx), 0, 0), nul_ptr)
    let result_i64 = forge_llvm_build_ptr_to_int(cg.builder, buf, cg.i64_type, "sub_result")
    ok_emit_str(result_i64)
}

fn emit_str_cmp(cg: Codegen, lhs_i64: ptr, rhs_i64: ptr, pred: int) -> EmitResult {
    // Lower string ordering ops (<, <=, >, >=) to a libc strcmp
    // call followed by a signed comparison of the result against
    // 0. We sign-extend strcmp's i32 result into i64 ourselves
    // because the host's build_icmp wrapper auto-promotes i32
    // operands via zero-extend, which would turn a negative
    // strcmp result into a huge positive i64 and break signed
    // comparison.
    let lhs_ptr = forge_llvm_build_int_to_ptr(cg.builder, lhs_i64, cg.ptr_type, "scmp_l")
    let rhs_ptr = forge_llvm_build_int_to_ptr(cg.builder, rhs_i64, cg.ptr_type, "scmp_r")
    let strcmp_fn = forge_llvm_get_named_function(cg.module, "strcmp")
    let pa = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(pa, 0, cg.ptr_type)
    forge_llvm_type_array_set(pa, 1, cg.ptr_type)
    let strcmp_type = forge_llvm_function_type(forge_llvm_int32_type(cg.ctx), pa, 2, 0)
    forge_llvm_type_array_free(pa)
    let arr = forge_llvm_value_array_new(2)
    forge_llvm_value_array_set(arr, 0, lhs_ptr)
    forge_llvm_value_array_set(arr, 1, rhs_ptr)
    let result32 = forge_llvm_build_call(cg.builder, strcmp_type, strcmp_fn, arr, 2, "strcmp_call")
    forge_llvm_value_array_free(arr)
    let result64 = forge_llvm_build_sext(cg.builder, result32, cg.i64_type, "strcmp_sext")
    let zero64 = forge_llvm_const_int(cg.i64_type, 0, 0)
    let cmp = forge_llvm_build_icmp(cg.builder, pred, result64, zero64, "scmp_cmp")
    ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "scmp_ext"))
}

fn emit_str_eq(cg: Codegen, lhs_i64: ptr, rhs_i64: ptr, invert: bool) -> EmitResult {
    let lhs_ptr = forge_llvm_build_int_to_ptr(cg.builder, lhs_i64, cg.ptr_type, "streq_l")
    let rhs_ptr = forge_llvm_build_int_to_ptr(cg.builder, rhs_i64, cg.ptr_type, "streq_r")
    let strcmp_fn = forge_llvm_get_named_function(cg.module, "strcmp")
    let pa = forge_llvm_type_array_new(2)
    forge_llvm_type_array_set(pa, 0, cg.ptr_type)
    forge_llvm_type_array_set(pa, 1, cg.ptr_type)
    let strcmp_type = forge_llvm_function_type(forge_llvm_int32_type(cg.ctx), pa, 2, 0)
    forge_llvm_type_array_free(pa)
    let arr = forge_llvm_value_array_new(2)
    forge_llvm_value_array_set(arr, 0, lhs_ptr)
    forge_llvm_value_array_set(arr, 1, rhs_ptr)
    let result32 = forge_llvm_build_call(cg.builder, strcmp_type, strcmp_fn, arr, 2, "strcmp_call")
    forge_llvm_value_array_free(arr)
    // Compare strcmp result against 0 (i32). For == we want eq;
    // for != we want ne. The result of icmp is i1; zext to i64.
    let zero32 = forge_llvm_const_int(forge_llvm_int32_type(cg.ctx), 0, 0)
    let pred = if invert { 33 } else { 32 }
    let cmp = forge_llvm_build_icmp(cg.builder, pred, result32, zero32, "streq_cmp")
    ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "streq_ext"))
}

fn strip_quotes(s: string) -> string {
    let len = s.length
    if len < 2 {
        return s
    }
    s.substring(1, len - 1)
}

fn fill_arg_array(cg: Codegen, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(expr, next) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return r
            }
            forge_llvm_value_array_set(arr, idx, r.value)
            fill_arg_array(cg, env, arr, next, idx + 1)
        }
    }
}

fn emit_unary(cg: Codegen, env: VarEnv, operator: string, right: Expr) -> EmitResult {
    let right_result = emit_expr(cg, env, right)
    if right_result.had_error {
        return right_result
    }

    if operator == "-" {
        let zero = forge_llvm_const_int(cg.i64_type, 0, 0)
        return ok_emit(forge_llvm_build_sub(cg.builder, zero, right_result.value, "neg"))
    }

    if operator == "!" {
        let cmp = forge_llvm_build_icmp(cg.builder, 32, right_result.value, forge_llvm_const_int(cg.i64_type, 0, 0), "not_cmp")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "not"))
    }

    err_emit("unsupported unary operator `" + operator + "`")
}

fn is_null_literal(e: Expr) -> bool {
    match e {
        .Null -> true
        _ -> false
    }
}

fn emit_binary(cg: Codegen, env: VarEnv, left: Expr, operator: string, right: Expr) -> EmitResult {
    let left_result = emit_expr(cg, env, left)
    if left_result.had_error {
        return left_result
    }
    let lhs = left_result.value

    let right_result = emit_expr(cg, env, right)
    if right_result.had_error {
        return right_result
    }
    let rhs = right_result.value

    // Comparing against a null literal must always be a plain pointer/i64
    // icmp — never strcmp, which would deref the NULL side and crash.
    let null_cmp = is_null_literal(left) || is_null_literal(right)

    if operator == "+" {
        // Dispatch + on operand types: if either side is a string,
        // emit a string concat sequence (strlen+strlen+malloc+memcpy
        // ×2 + null-terminate). Otherwise it's an integer add.
        if left_result.ty == "str" || right_result.ty == "str" {
            return emit_concat(cg, lhs, rhs)
        }
        return ok_emit(forge_llvm_build_add(cg.builder, lhs, rhs, "add"))
    }
    if operator == "-" { return ok_emit(forge_llvm_build_sub(cg.builder, lhs, rhs, "sub")) }
    if operator == "*" { return ok_emit(forge_llvm_build_mul(cg.builder, lhs, rhs, "mul")) }
    if operator == "/" { return ok_emit(forge_llvm_build_sdiv(cg.builder, lhs, rhs, "div")) }

    // Comparisons: icmp returns i1, zext to i64
    // pred: 32=eq, 33=ne, 38=sgt, 39=sge, 40=slt, 41=sle
    if operator == "==" {
        if !null_cmp && (left_result.ty == "str" || right_result.ty == "str") {
            return emit_str_eq(cg, lhs, rhs, false)
        }
        let cmp = forge_llvm_build_icmp(cg.builder, 32, lhs, rhs, "eq")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "eq_ext"))
    }
    if operator == "!=" {
        if !null_cmp && (left_result.ty == "str" || right_result.ty == "str") {
            return emit_str_eq(cg, lhs, rhs, true)
        }
        let cmp = forge_llvm_build_icmp(cg.builder, 33, lhs, rhs, "ne")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "ne_ext"))
    }
    if operator == "<" {
        if left_result.ty == "str" || right_result.ty == "str" {
            return emit_str_cmp(cg, lhs, rhs, 40)
        }
        let cmp = forge_llvm_build_icmp(cg.builder, 40, lhs, rhs, "slt")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "slt_ext"))
    }
    if operator == "<=" {
        if left_result.ty == "str" || right_result.ty == "str" {
            return emit_str_cmp(cg, lhs, rhs, 41)
        }
        let cmp = forge_llvm_build_icmp(cg.builder, 41, lhs, rhs, "sle")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "sle_ext"))
    }
    if operator == ">" {
        if left_result.ty == "str" || right_result.ty == "str" {
            return emit_str_cmp(cg, lhs, rhs, 38)
        }
        let cmp = forge_llvm_build_icmp(cg.builder, 38, lhs, rhs, "sgt")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "sgt_ext"))
    }
    if operator == ">=" {
        if left_result.ty == "str" || right_result.ty == "str" {
            return emit_str_cmp(cg, lhs, rhs, 39)
        }
        let cmp = forge_llvm_build_icmp(cg.builder, 39, lhs, rhs, "sge")
        return ok_emit(forge_llvm_build_zext(cg.builder, cmp, cg.i64_type, "sge_ext"))
    }

    if operator == "&&" {
        // Eager-bitwise lowering — short-circuit can come later.
        let l_bool = forge_llvm_build_icmp(cg.builder, 33, lhs, forge_llvm_const_int(cg.i64_type, 0, 0), "l_bool")
        let r_bool = forge_llvm_build_icmp(cg.builder, 33, rhs, forge_llvm_const_int(cg.i64_type, 0, 0), "r_bool")
        let l_ext = forge_llvm_build_zext(cg.builder, l_bool, cg.i64_type, "l_ext")
        let r_ext = forge_llvm_build_zext(cg.builder, r_bool, cg.i64_type, "r_ext")
        return ok_emit(forge_llvm_build_mul(cg.builder, l_ext, r_ext, "and"))
    }
    if operator == "||" {
        let l_bool = forge_llvm_build_icmp(cg.builder, 33, lhs, forge_llvm_const_int(cg.i64_type, 0, 0), "l_bool")
        let r_bool = forge_llvm_build_icmp(cg.builder, 33, rhs, forge_llvm_const_int(cg.i64_type, 0, 0), "r_bool")
        let l_ext = forge_llvm_build_zext(cg.builder, l_bool, cg.i64_type, "l_ext")
        let r_ext = forge_llvm_build_zext(cg.builder, r_bool, cg.i64_type, "r_ext")
        let sum = forge_llvm_build_add(cg.builder, l_ext, r_ext, "or_sum")
        let nonzero = forge_llvm_build_icmp(cg.builder, 33, sum, forge_llvm_const_int(cg.i64_type, 0, 0), "or_cmp")
        return ok_emit(forge_llvm_build_zext(cg.builder, nonzero, cg.i64_type, "or"))
    }

    err_emit("unsupported binary operator `" + operator + "`")
}
