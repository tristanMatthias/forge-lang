use @std.llvm
use ast.{Expr, ExprList, Stmt, StmtList, ParamList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length}

// ── Public API ──

export type CodegenResult = {
    had_error: bool,
    error_message: string,
}

type Codegen = {
    ctx: ptr,
    module: ptr,
    builder: ptr,
    // The function whose body the builder is currently positioned in.
    // append_basic_block needs this; codegen for `if`/`while` and
    // function bodies all use it.
    current_fn: ptr,
    i64_type: ptr,
    i1_type: ptr,
    ptr_type: ptr,
}

fn null_ptr_val() -> ptr {
    let n: ptr = null
    n
}

export fn compile_program(stmts: StmtList, output_path: string) -> CodegenResult {
    let ctx = llvm.context_create()
    let m = llvm.module_create("bootstrap", ctx)
    let builder = llvm.create_builder(ctx)

    let i64t = llvm.int64_type(ctx)
    let i1t = llvm.int1_type(ctx)
    let pt = llvm.pointer_type(ctx)

    // Pass 1: declare every user-defined function as an LLVM
    // prototype so call sites (which may appear before the
    // declaration in source order) can resolve them by name via
    // `llvm.get_named_function`.
    declare_functions(m, ctx, i64t, stmts)

    // Create main: () -> i64. Top-level non-function statements run
    // inside it.
    let main_params = llvm.type_array_new(0)
    let main_type = llvm.function_type(i64t, main_params, 0, 0)
    llvm.type_array_free(main_params)
    let main_fn = llvm.add_function(m, "main", main_type)

    let entry = llvm.append_basic_block(ctx, main_fn, "entry")
    llvm.position_at_end(builder, entry)

    let cg = Codegen {
        ctx,
        module: m,
        builder,
        current_fn: main_fn,
        i64_type: i64t,
        i1_type: i1t,
        ptr_type: pt,
    }

    // Pass 2: emit each user-defined function's body, then emit
    // every non-function top-level statement into main.
    let body_result = emit_function_bodies(cg, stmts)
    if body_result.had_error {
        llvm.dispose_builder(builder)
        llvm.module_dispose(m)
        llvm.context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: body_result.error_message }
    }

    // After emitting any function bodies, the builder may be sitting
    // in a function-body block. Reposition it back at main's entry
    // before emitting top-level statements.
    llvm.position_at_end(builder, entry)
    let initial: VarEnv = VarEnv.End
    let result = emit_top_level(cg, initial, stmts)
    if result.had_error {
        llvm.dispose_builder(builder)
        llvm.module_dispose(m)
        llvm.context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: result.error_message }
    }

    // Default return 0 if the program didn't end in an explicit return
    if !llvm.block_has_terminator(builder) {
        llvm.build_ret(builder, llvm.const_int(i64t, 0, 0))
    }

    // Verify
    let verify = llvm.verify_module_print(m)
    if verify != 0 {
        llvm.dispose_builder(builder)
        llvm.module_dispose(m)
        llvm.context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: "codegen error: LLVM module verification failed" }
    }

    let write_result = llvm.print_module_to_file(m, output_path)

    llvm.dispose_builder(builder)
    llvm.module_dispose(m)
    llvm.context_dispose(ctx)

    if write_result != 0 {
        return CodegenResult { had_error: true, error_message: "codegen error: failed to write IR to " + output_path }
    }

    CodegenResult { had_error: false, error_message: "" }
}

// ── Helpers ──

type EmitResult = {
    value: ptr,
    had_error: bool,
    error_message: string,
}

fn ok_emit(value: ptr) -> EmitResult {
    EmitResult { value, had_error: false, error_message: "" }
}

fn err_emit(message: string) -> EmitResult {
    EmitResult { value: null_ptr_val(), had_error: true, error_message: "codegen error: " + message }
}

type StmtResult = {
    env: VarEnv,
    had_error: bool,
    error_message: string,
}

fn ok_stmt(env: VarEnv) -> StmtResult {
    StmtResult { env, had_error: false, error_message: "" }
}

fn err_stmt(message: string) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: message }
}

fn err_stmt_from_expr(r: EmitResult) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: r.error_message }
}

// ── Function declaration pass ──

fn declare_functions(m: ptr, ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .Function(name, params, body) -> {
                    let arity = param_list_length(params)
                    let param_arr = llvm.type_array_new(arity)
                    fill_i64_param_array(param_arr, i64t, 0, arity)
                    let fn_type = llvm.function_type(i64t, param_arr, arity, 0)
                    llvm.type_array_free(param_arr)
                    llvm.add_function(m, name, fn_type)
                }
                _ -> {}
            }
            declare_functions(m, ctx, i64t, next)
        }
    }
}

fn fill_i64_param_array(arr: ptr, i64t: ptr, idx: int, count: int) {
    if idx >= count {
        return
    }
    llvm.type_array_set(arr, idx, i64t)
    fill_i64_param_array(arr, i64t, idx + 1, count)
}

// ── Function body pass ──

fn emit_function_bodies(cg: Codegen, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(VarEnv.End)
        .Node(stmt, next) -> {
            let r = match stmt {
                .Function(name, params, body) -> emit_function_body(cg, name, params, body)
                _ -> ok_stmt(VarEnv.End)
            }
            if r.had_error {
                return r
            }
            emit_function_bodies(cg, next)
        }
    }
}

fn emit_function_body(cg: Codegen, name: string, params: ParamList, body: StmtList) -> StmtResult {
    let fn_val = llvm.get_named_function(cg.module, name)
    if fn_val == null {
        return err_stmt("codegen error: function `" + name + "` was not declared in pass 1")
    }

    let entry = llvm.append_basic_block(cg.ctx, fn_val, "entry")
    llvm.position_at_end(cg.builder, entry)

    let empty_env: VarEnv = VarEnv.End
    let env = bind_params_inline(cg.builder, cg.i64_type, fn_val, params, 0, empty_env)

    let body_cg = Codegen {
        ctx: cg.ctx,
        module: cg.module,
        builder: cg.builder,
        current_fn: fn_val,
        i64_type: cg.i64_type,
        i1_type: cg.i1_type,
        ptr_type: cg.ptr_type,
    }

    let r = emit_stmt_list(body_cg, env, body)
    if r.had_error {
        return r
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_ret(cg.builder, llvm.const_int(cg.i64_type, 0, 0))
    }
    ok_stmt(VarEnv.End)
}

fn bind_params_inline(builder: ptr, i64t: ptr, fn_val: ptr, params: ParamList, idx: int, env: VarEnv) -> VarEnv {
    match params {
        .End -> env
        .Node(name, next) -> {
            let arg = llvm.get_param(fn_val, idx)
            let alloca = llvm.build_alloca(builder, i64t, name)
            llvm.build_store(builder, arg, alloca)
            bind_params_inline(builder, i64t, fn_val, next, idx + 1, env_extend(env, name, alloca))
        }
    }
}

// ── Top-level pass (skips function decls) ──

fn emit_top_level(cg: Codegen, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(stmt, next) -> {
            let result = match stmt {
                .Function(_, _, _) -> ok_stmt(env)
                _ -> emit_stmt(cg, env, stmt)
            }
            if result.had_error {
                return result
            }
            emit_top_level(cg, result.env, next)
        }
    }
}

// ── Statement emission ──

fn emit_stmt_list(cg: Codegen, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(stmt, next) -> {
            let result = emit_stmt(cg, env, stmt)
            if result.had_error {
                return result
            }
            emit_stmt_list(cg, result.env, next)
        }
    }
}

fn emit_stmt(cg: Codegen, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Expr(expr) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            ok_stmt(env)
        }
        .Ret(value) -> {
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            llvm.build_ret(cg.builder, r.value)
            ok_stmt(env)
        }
        .RetEmpty -> {
            llvm.build_ret(cg.builder, llvm.const_int(cg.i64_type, 0, 0))
            ok_stmt(env)
        }
        .Let(name, initializer) -> emit_var_decl(cg, env, name, initializer)
        .Mut(name, initializer) -> emit_var_decl(cg, env, name, initializer)
        .Block(body) -> {
            let inner = emit_stmt_list(cg, env, body)
            if inner.had_error {
                return inner
            }
            // Block exits restore the outer scope.
            ok_stmt(env)
        }
        .If(condition, then_branch, else_branch) -> emit_if(cg, env, condition, then_branch, else_branch)
        .While(condition, body) -> emit_while(cg, env, condition, body)
        _ -> err_stmt("codegen error: unsupported statement type")
    }
}

fn emit_var_decl(cg: Codegen, env: VarEnv, name: string, initializer: Expr) -> StmtResult {
    let r = emit_expr(cg, env, initializer)
    if r.had_error {
        return err_stmt_from_expr(r)
    }
    let alloca = llvm.build_alloca(cg.builder, cg.i64_type, name)
    llvm.build_store(cg.builder, r.value, alloca)
    ok_stmt(env_extend(env, name, alloca))
}

fn emit_if(cg: Codegen, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> StmtResult {
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return err_stmt_from_expr(cond)
    }
    // Truncate i64 → i1 for the branch.
    let cond_i1 = llvm.build_icmp(cg.builder, 33, cond.value, llvm.const_int(cg.i64_type, 0, 0), "if_cond")

    let then_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "then")
    let else_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "else")
    let merge_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "ifcont")

    llvm.build_cond_br(cg.builder, cond_i1, then_bb, else_bb)

    // Then branch
    llvm.position_at_end(cg.builder, then_bb)
    let then_result = emit_stmt(cg, env, then_branch)
    if then_result.had_error {
        return then_result
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_br(cg.builder, merge_bb)
    }

    // Else branch
    llvm.position_at_end(cg.builder, else_bb)
    if else_branch != null {
        let else_result = emit_stmt(cg, env, else_branch!)
        if else_result.had_error {
            return else_result
        }
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_br(cg.builder, merge_bb)
    }

    llvm.position_at_end(cg.builder, merge_bb)
    ok_stmt(env)
}

fn emit_while(cg: Codegen, env: VarEnv, condition: Expr, body: Stmt) -> StmtResult {
    let cond_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "while.cond")
    let body_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "while.body")
    let exit_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "while.exit")

    llvm.build_br(cg.builder, cond_bb)

    llvm.position_at_end(cg.builder, cond_bb)
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return err_stmt_from_expr(cond)
    }
    let cond_i1 = llvm.build_icmp(cg.builder, 33, cond.value, llvm.const_int(cg.i64_type, 0, 0), "while_cond")
    llvm.build_cond_br(cg.builder, cond_i1, body_bb, exit_bb)

    llvm.position_at_end(cg.builder, body_bb)
    let body_result = emit_stmt(cg, env, body)
    if body_result.had_error {
        return body_result
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_br(cg.builder, cond_bb)
    }

    llvm.position_at_end(cg.builder, exit_bb)
    ok_stmt(env)
}

// ── Expression emission ──

fn emit_expr(cg: Codegen, env: VarEnv, expr: Expr) -> EmitResult {
    match expr {
        .Number(text) -> {
            let value = int(text)
            ok_emit(llvm.const_int(cg.i64_type, value, 0))
        }
        .Bool(text) -> {
            if text == "true" {
                return ok_emit(llvm.const_int(cg.i64_type, 1, 0))
            }
            ok_emit(llvm.const_int(cg.i64_type, 0, 0))
        }
        .Null -> ok_emit(llvm.const_int(cg.i64_type, 0, 0))
        .Grouping(inner) -> emit_expr(cg, env, inner)
        .Unary(operator, right) -> emit_unary(cg, env, operator, right)
        .Binary(left, operator, right) -> emit_binary(cg, env, left, operator, right)
        .Logical(left, operator, right) -> emit_binary(cg, env, left, operator, right)
        .Ident(name) -> {
            let alloca = env_lookup(env, name)
            if alloca == null {
                return err_emit("undefined variable `" + name + "`")
            }
            ok_emit(llvm.build_load(cg.builder, cg.i64_type, alloca, name))
        }
        .Assign(name, value) -> {
            let alloca = env_lookup(env, name)
            if alloca == null {
                return err_emit("assignment to undefined variable `" + name + "`")
            }
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return r
            }
            llvm.build_store(cg.builder, r.value, alloca)
            ok_emit(r.value)
        }
        .Call(callee, args) -> emit_call(cg, env, callee, args)
        _ -> err_emit("unsupported expression type")
    }
}

fn emit_call(cg: Codegen, env: VarEnv, callee: Expr, args: ExprList) -> EmitResult {
    // Destructure callee exactly once. Repeated `match` of the same
    // enum value miscompiles in the host: the second destructure
    // produces a corrupted payload (an empty string in this case),
    // which makes the function lookup silently fail.
    match callee {
        .Ident(name) -> emit_call_named(cg, env, name, args)
        _ -> err_emit("only direct function calls are supported")
    }
}

fn emit_call_named(cg: Codegen, env: VarEnv, name: string, args: ExprList) -> EmitResult {
    let fn_val = llvm.get_named_function(cg.module, name)
    if fn_val == null {
        return err_emit("undefined function `" + name + "`")
    }

    let arg_count = expr_list_length(args)
    let arg_arr = llvm.value_array_new(arg_count)
    let fill = fill_arg_array(cg, env, arg_arr, args, 0)
    if fill.had_error {
        llvm.value_array_free(arg_arr)
        return fill
    }
    // All bootstrap functions have the same shape: (i64, i64, ...) -> i64.
    let param_arr = llvm.type_array_new(arg_count)
    fill_i64_param_array(param_arr, cg.i64_type, 0, arg_count)
    let fn_type = llvm.function_type(cg.i64_type, param_arr, arg_count, 0)
    llvm.type_array_free(param_arr)

    let result = llvm.build_call(cg.builder, fn_type, fn_val, arg_arr, arg_count, "calltmp")
    llvm.value_array_free(arg_arr)
    ok_emit(result)
}

fn fill_arg_array(cg: Codegen, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(expr, next) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return r
            }
            llvm.value_array_set(arr, idx, r.value)
            fill_arg_array(cg, env, arr, next, idx + 1)
        }
    }
}

fn emit_unary(cg: Codegen, env: VarEnv, operator: string, right: Expr) -> EmitResult {
    let right_result = emit_expr(cg, env, right)
    if right_result.had_error {
        return right_result
    }

    if operator == "-" {
        let zero = llvm.const_int(cg.i64_type, 0, 0)
        return ok_emit(llvm.build_sub(cg.builder, zero, right_result.value, "neg"))
    }

    if operator == "!" {
        let cmp = llvm.build_icmp(cg.builder, 32, right_result.value, llvm.const_int(cg.i64_type, 0, 0), "not_cmp")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "not"))
    }

    err_emit("unsupported unary operator `" + operator + "`")
}

fn emit_binary(cg: Codegen, env: VarEnv, left: Expr, operator: string, right: Expr) -> EmitResult {
    let left_result = emit_expr(cg, env, left)
    if left_result.had_error {
        return left_result
    }
    let lhs = left_result.value

    let right_result = emit_expr(cg, env, right)
    if right_result.had_error {
        return right_result
    }
    let rhs = right_result.value

    if operator == "+" { return ok_emit(llvm.build_add(cg.builder, lhs, rhs, "add")) }
    if operator == "-" { return ok_emit(llvm.build_sub(cg.builder, lhs, rhs, "sub")) }
    if operator == "*" { return ok_emit(llvm.build_mul(cg.builder, lhs, rhs, "mul")) }
    if operator == "/" { return ok_emit(llvm.build_sdiv(cg.builder, lhs, rhs, "div")) }

    // Comparisons: icmp returns i1, zext to i64
    // pred: 32=eq, 33=ne, 38=sgt, 39=sge, 40=slt, 41=sle
    if operator == "==" {
        let cmp = llvm.build_icmp(cg.builder, 32, lhs, rhs, "eq")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "eq_ext"))
    }
    if operator == "!=" {
        let cmp = llvm.build_icmp(cg.builder, 33, lhs, rhs, "ne")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "ne_ext"))
    }
    if operator == "<" {
        let cmp = llvm.build_icmp(cg.builder, 40, lhs, rhs, "slt")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "slt_ext"))
    }
    if operator == "<=" {
        let cmp = llvm.build_icmp(cg.builder, 41, lhs, rhs, "sle")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "sle_ext"))
    }
    if operator == ">" {
        let cmp = llvm.build_icmp(cg.builder, 38, lhs, rhs, "sgt")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "sgt_ext"))
    }
    if operator == ">=" {
        let cmp = llvm.build_icmp(cg.builder, 39, lhs, rhs, "sge")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "sge_ext"))
    }

    if operator == "&&" {
        // Eager-bitwise lowering — short-circuit can come later.
        let l_bool = llvm.build_icmp(cg.builder, 33, lhs, llvm.const_int(cg.i64_type, 0, 0), "l_bool")
        let r_bool = llvm.build_icmp(cg.builder, 33, rhs, llvm.const_int(cg.i64_type, 0, 0), "r_bool")
        let l_ext = llvm.build_zext(cg.builder, l_bool, cg.i64_type, "l_ext")
        let r_ext = llvm.build_zext(cg.builder, r_bool, cg.i64_type, "r_ext")
        return ok_emit(llvm.build_mul(cg.builder, l_ext, r_ext, "and"))
    }
    if operator == "||" {
        let l_bool = llvm.build_icmp(cg.builder, 33, lhs, llvm.const_int(cg.i64_type, 0, 0), "l_bool")
        let r_bool = llvm.build_icmp(cg.builder, 33, rhs, llvm.const_int(cg.i64_type, 0, 0), "r_bool")
        let l_ext = llvm.build_zext(cg.builder, l_bool, cg.i64_type, "l_ext")
        let r_ext = llvm.build_zext(cg.builder, r_bool, cg.i64_type, "r_ext")
        let sum = llvm.build_add(cg.builder, l_ext, r_ext, "or_sum")
        let nonzero = llvm.build_icmp(cg.builder, 33, sum, llvm.const_int(cg.i64_type, 0, 0), "or_cmp")
        return ok_emit(llvm.build_zext(cg.builder, nonzero, cg.i64_type, "or"))
    }

    err_emit("unsupported binary operator `" + operator + "`")
}
