use @std.llvm
use ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, Pattern, MatchArmList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length, field_list_length, field_init_length, field_index_of, field_type_of, variant_lookup, variant_max_payload}

// ── Public API ──

export type CodegenResult = {
    had_error: bool,
    error_message: string,
}

type Codegen = {
    ctx: ptr,
    module: ptr,
    builder: ptr,
    // The function whose body the builder is currently positioned in.
    // append_basic_block needs this; codegen for `if`/`while` and
    // function bodies all use it.
    current_fn: ptr,
    i64_type: ptr,
    i1_type: ptr,
    ptr_type: ptr,
}

fn null_ptr_val() -> ptr {
    let n: ptr = null
    n
}

// ── Struct registry ──
//
// Maps struct name → its FieldList. We need this to look up field
// indices and types at use sites (struct literals, field access).
// LLVM also has the named struct type, but it doesn't carry field
// names — that information lives only here.
//
// The mut global is rebuilt on every compile_program call.
enum StructReg {
    End
    Node(name: string, fields: FieldList, next: StructReg)
}

mut CG_STRUCTS: StructReg = StructReg.End

type StructLookup = {
    found: bool,
    fields: FieldList,
}

fn struct_reg_lookup(name: string) -> StructLookup {
    struct_reg_lookup_loop(CG_STRUCTS, name)
}

fn struct_reg_lookup_loop(reg: StructReg, name: string) -> StructLookup {
    match reg {
        .End -> StructLookup { found: false, fields: FieldList.End }
        .Node(n, fields, next) -> {
            if n == name {
                return StructLookup { found: true, fields }
            }
            struct_reg_lookup_loop(next, name)
        }
    }
}

fn struct_reg_extend(name: string, fields: FieldList) {
    CG_STRUCTS = StructReg.Node(name, fields, CG_STRUCTS)
}

// ── Enum registry ──
//
// Maps enum name → its VariantList. Same idea as the struct
// registry: LLVM holds the named struct type, but variant names,
// tags, and field types live only here.
enum EnumReg {
    End
    Node(name: string, variants: VariantList, next: EnumReg)
}

mut CG_ENUMS: EnumReg = EnumReg.End

type EnumLookup = {
    found: bool,
    variants: VariantList,
}

fn enum_reg_lookup(name: string) -> EnumLookup {
    enum_reg_lookup_loop(CG_ENUMS, name)
}

fn enum_reg_lookup_loop(reg: EnumReg, name: string) -> EnumLookup {
    match reg {
        .End -> EnumLookup { found: false, variants: VariantList.End }
        .Node(n, variants, next) -> {
            if n == name {
                return EnumLookup { found: true, variants }
            }
            enum_reg_lookup_loop(next, name)
        }
    }
}

fn enum_reg_extend(name: string, variants: VariantList) {
    CG_ENUMS = EnumReg.Node(name, variants, CG_ENUMS)
}

export fn compile_program(stmts: StmtList, output_path: string) -> CodegenResult {
    let ctx = llvm.context_create()
    let m = llvm.module_create("bootstrap", ctx)
    let builder = llvm.create_builder(ctx)

    let i64t = llvm.int64_type(ctx)
    let i1t = llvm.int1_type(ctx)
    let pt = llvm.pointer_type(ctx)

    // Declare libc helpers we lower string ops onto.
    //   puts(ptr) -> i32        — for println(str)
    //   strlen(ptr) -> i64
    //   malloc(i64) -> ptr
    //   memcpy(ptr, ptr, i64) -> ptr
    let puts_param_arr = llvm.type_array_new(1)
    llvm.type_array_set(puts_param_arr, 0, pt)
    let puts_type = llvm.function_type(llvm.int32_type(ctx), puts_param_arr, 1, 0)
    llvm.type_array_free(puts_param_arr)
    llvm.add_function(m, "puts", puts_type)

    let strlen_param_arr = llvm.type_array_new(1)
    llvm.type_array_set(strlen_param_arr, 0, pt)
    let strlen_type = llvm.function_type(i64t, strlen_param_arr, 1, 0)
    llvm.type_array_free(strlen_param_arr)
    llvm.add_function(m, "strlen", strlen_type)

    let malloc_param_arr = llvm.type_array_new(1)
    llvm.type_array_set(malloc_param_arr, 0, i64t)
    let malloc_type = llvm.function_type(pt, malloc_param_arr, 1, 0)
    llvm.type_array_free(malloc_param_arr)
    llvm.add_function(m, "malloc", malloc_type)

    let memcpy_param_arr = llvm.type_array_new(3)
    llvm.type_array_set(memcpy_param_arr, 0, pt)
    llvm.type_array_set(memcpy_param_arr, 1, pt)
    llvm.type_array_set(memcpy_param_arr, 2, i64t)
    let memcpy_type = llvm.function_type(pt, memcpy_param_arr, 3, 0)
    llvm.type_array_free(memcpy_param_arr)
    llvm.add_function(m, "memcpy", memcpy_type)

    // Reset and rebuild the per-compile struct/enum registries.
    CG_STRUCTS = StructReg.End
    CG_ENUMS = EnumReg.End
    declare_structs(ctx, i64t, stmts)
    declare_enums(ctx, i64t, stmts)

    // Pass 1: declare every user-defined function as an LLVM
    // prototype so call sites (which may appear before the
    // declaration in source order) can resolve them by name via
    // `llvm.get_named_function`.
    declare_functions(m, ctx, i64t, stmts)

    // Create main: () -> i64. Top-level non-function statements run
    // inside it.
    let main_params = llvm.type_array_new(0)
    let main_type = llvm.function_type(i64t, main_params, 0, 0)
    llvm.type_array_free(main_params)
    let main_fn = llvm.add_function(m, "main", main_type)

    let entry = llvm.append_basic_block(ctx, main_fn, "entry")
    llvm.position_at_end(builder, entry)

    let cg = Codegen {
        ctx,
        module: m,
        builder,
        current_fn: main_fn,
        i64_type: i64t,
        i1_type: i1t,
        ptr_type: pt,
    }

    // Pass 2: emit each user-defined function's body, then emit
    // every non-function top-level statement into main.
    let body_result = emit_function_bodies(cg, stmts)
    if body_result.had_error {
        llvm.dispose_builder(builder)
        llvm.module_dispose(m)
        llvm.context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: body_result.error_message }
    }

    // After emitting any function bodies, the builder may be sitting
    // in a function-body block. Reposition it back at main's entry
    // before emitting top-level statements.
    llvm.position_at_end(builder, entry)
    let initial: VarEnv = VarEnv.End
    let result = emit_top_level(cg, initial, stmts)
    if result.had_error {
        llvm.dispose_builder(builder)
        llvm.module_dispose(m)
        llvm.context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: result.error_message }
    }

    // Default return 0 if the program didn't end in an explicit return
    if !llvm.block_has_terminator(builder) {
        llvm.build_ret(builder, llvm.const_int(i64t, 0, 0))
    }

    // Verify
    let verify = llvm.verify_module_print(m)
    if verify != 0 {
        llvm.dispose_builder(builder)
        llvm.module_dispose(m)
        llvm.context_dispose(ctx)
        return CodegenResult { had_error: true, error_message: "codegen error: LLVM module verification failed" }
    }

    let write_result = llvm.print_module_to_file(m, output_path)

    llvm.dispose_builder(builder)
    llvm.module_dispose(m)
    llvm.context_dispose(ctx)

    if write_result != 0 {
        return CodegenResult { had_error: true, error_message: "codegen error: failed to write IR to " + output_path }
    }

    CodegenResult { had_error: false, error_message: "" }
}

// ── Helpers ──

type EmitResult = {
    value: ptr,
    // "i64" or "str". `str` values are stored as i64-encoded
    // pointers (ptrtoint) and decoded back to `ptr` at use sites
    // (println, concat). The tag tells `+` whether to emit an i64
    // add or a string concat.
    ty: string,
    had_error: bool,
    error_message: string,
}

fn ok_emit(value: ptr) -> EmitResult {
    EmitResult { value, ty: "i64", had_error: false, error_message: "" }
}

fn ok_emit_str(value: ptr) -> EmitResult {
    EmitResult { value, ty: "str", had_error: false, error_message: "" }
}

fn err_emit(message: string) -> EmitResult {
    EmitResult { value: null_ptr_val(), ty: "i64", had_error: true, error_message: "codegen error: " + message }
}

type StmtResult = {
    env: VarEnv,
    had_error: bool,
    error_message: string,
}

fn ok_stmt(env: VarEnv) -> StmtResult {
    StmtResult { env, had_error: false, error_message: "" }
}

fn err_stmt(message: string) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: message }
}

fn err_stmt_from_expr(r: EmitResult) -> StmtResult {
    StmtResult { env: VarEnv.End, had_error: true, error_message: r.error_message }
}

// ── Struct declaration pass ──

fn declare_structs(ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .TypeDecl(name, fields) -> {
                    // Build a named LLVM struct type with N i64 slots.
                    // Every bootstrap value lives in an i64 slot
                    // (str values are pointer-encoded), so a struct
                    // is just an array of i64s with named offsets.
                    let count = field_list_length(fields)
                    let field_arr = llvm.type_array_new(count)
                    fill_i64_param_array(field_arr, i64t, 0, count)
                    let st = llvm.struct_create_named(ctx, name)
                    llvm.struct_set_body(st, field_arr, count, 0)
                    llvm.type_array_free(field_arr)
                    struct_reg_extend(name, fields)
                }
                _ -> {}
            }
            declare_structs(ctx, i64t, next)
        }
    }
}

// ── Enum declaration pass ──

fn declare_enums(ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .EnumDecl(name, variants) -> {
                    // Each enum is laid out as `{i8 tag, i64 x N}`
                    // where N = max number of fields across variants.
                    // Field types are erased to i64 — strings are
                    // pointer-encoded already.
                    let max_fields = variant_max_payload(variants)
                    let total_fields = max_fields + 1
                    let field_arr = llvm.type_array_new(total_fields)
                    llvm.type_array_set(field_arr, 0, llvm.int8_type(ctx))
                    fill_i64_param_array_offset(field_arr, i64t, 1, max_fields)
                    let st = llvm.struct_create_named(ctx, name)
                    llvm.struct_set_body(st, field_arr, total_fields, 0)
                    llvm.type_array_free(field_arr)
                    enum_reg_extend(name, variants)
                }
                _ -> {}
            }
            declare_enums(ctx, i64t, next)
        }
    }
}

fn fill_i64_param_array_offset(arr: ptr, i64t: ptr, base: int, count: int) {
    if count <= 0 {
        return
    }
    llvm.type_array_set(arr, base, i64t)
    fill_i64_param_array_offset(arr, i64t, base + 1, count - 1)
}

// ── Function declaration pass ──

fn declare_functions(m: ptr, ctx: ptr, i64t: ptr, stmts: StmtList) {
    match stmts {
        .End -> {}
        .Node(stmt, next) -> {
            match stmt {
                .Function(name, params, body) -> {
                    let arity = param_list_length(params)
                    let param_arr = llvm.type_array_new(arity)
                    fill_i64_param_array(param_arr, i64t, 0, arity)
                    let fn_type = llvm.function_type(i64t, param_arr, arity, 0)
                    llvm.type_array_free(param_arr)
                    llvm.add_function(m, name, fn_type)
                }
                _ -> {}
            }
            declare_functions(m, ctx, i64t, next)
        }
    }
}

fn fill_i64_param_array(arr: ptr, i64t: ptr, idx: int, count: int) {
    if idx >= count {
        return
    }
    llvm.type_array_set(arr, idx, i64t)
    fill_i64_param_array(arr, i64t, idx + 1, count)
}

// ── Function body pass ──

fn emit_function_bodies(cg: Codegen, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(VarEnv.End)
        .Node(stmt, next) -> {
            let r = match stmt {
                .Function(name, params, body) -> emit_function_body(cg, name, params, body)
                _ -> ok_stmt(VarEnv.End)
            }
            if r.had_error {
                return r
            }
            emit_function_bodies(cg, next)
        }
    }
}

fn emit_function_body(cg: Codegen, name: string, params: ParamList, body: StmtList) -> StmtResult {
    let fn_val = llvm.get_named_function(cg.module, name)
    if fn_val == null {
        return err_stmt("codegen error: function `" + name + "` was not declared in pass 1")
    }

    let entry = llvm.append_basic_block(cg.ctx, fn_val, "entry")
    llvm.position_at_end(cg.builder, entry)

    let empty_env: VarEnv = VarEnv.End
    let env = bind_params_inline(cg.builder, cg.i64_type, fn_val, params, 0, empty_env)

    let body_cg = Codegen {
        ctx: cg.ctx,
        module: cg.module,
        builder: cg.builder,
        current_fn: fn_val,
        i64_type: cg.i64_type,
        i1_type: cg.i1_type,
        ptr_type: cg.ptr_type,
    }

    let r = emit_stmt_list(body_cg, env, body)
    if r.had_error {
        return r
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_ret(cg.builder, llvm.const_int(cg.i64_type, 0, 0))
    }
    ok_stmt(VarEnv.End)
}

fn bind_params_inline(builder: ptr, i64t: ptr, fn_val: ptr, params: ParamList, idx: int, env: VarEnv) -> VarEnv {
    match params {
        .End -> env
        .Node(name, next) -> {
            let arg = llvm.get_param(fn_val, idx)
            let alloca = llvm.build_alloca(builder, i64t, name)
            llvm.build_store(builder, arg, alloca)
            // Function parameters are i64 by default in the MVP.
            bind_params_inline(builder, i64t, fn_val, next, idx + 1, env_extend(env, name, alloca, "i64"))
        }
    }
}

// ── Top-level pass (skips function decls) ──

fn emit_top_level(cg: Codegen, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(stmt, next) -> {
            let result = match stmt {
                .Function(_, _, _) -> ok_stmt(env)
                _ -> emit_stmt(cg, env, stmt)
            }
            if result.had_error {
                return result
            }
            emit_top_level(cg, result.env, next)
        }
    }
}

// ── Statement emission ──

fn emit_stmt_list(cg: Codegen, env: VarEnv, stmts: StmtList) -> StmtResult {
    match stmts {
        .End -> ok_stmt(env)
        .Node(stmt, next) -> {
            let result = emit_stmt(cg, env, stmt)
            if result.had_error {
                return result
            }
            emit_stmt_list(cg, result.env, next)
        }
    }
}

fn emit_stmt(cg: Codegen, env: VarEnv, stmt: Stmt) -> StmtResult {
    match stmt {
        .Expr(expr) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            ok_stmt(env)
        }
        .Ret(value) -> {
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return err_stmt_from_expr(r)
            }
            llvm.build_ret(cg.builder, r.value)
            ok_stmt(env)
        }
        .RetEmpty -> {
            llvm.build_ret(cg.builder, llvm.const_int(cg.i64_type, 0, 0))
            ok_stmt(env)
        }
        .Let(name, initializer) -> emit_var_decl(cg, env, name, initializer)
        .Mut(name, initializer) -> emit_var_decl(cg, env, name, initializer)
        .Block(body) -> {
            let inner = emit_stmt_list(cg, env, body)
            if inner.had_error {
                return inner
            }
            // Block exits restore the outer scope.
            ok_stmt(env)
        }
        .If(condition, then_branch, else_branch) -> emit_if(cg, env, condition, then_branch, else_branch)
        .While(condition, body) -> emit_while(cg, env, condition, body)
        .TypeDecl(_, _) -> ok_stmt(env)
        .EnumDecl(_, _) -> ok_stmt(env)
        .Match(subject, arms) -> emit_match(cg, env, subject, arms)
        _ -> err_stmt("codegen error: unsupported statement type")
    }
}

fn emit_var_decl(cg: Codegen, env: VarEnv, name: string, initializer: Expr) -> StmtResult {
    let r = emit_expr(cg, env, initializer)
    if r.had_error {
        return err_stmt_from_expr(r)
    }
    let alloca = llvm.build_alloca(cg.builder, cg.i64_type, name)
    llvm.build_store(cg.builder, r.value, alloca)
    ok_stmt(env_extend(env, name, alloca, r.ty))
}

fn emit_if(cg: Codegen, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> StmtResult {
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return err_stmt_from_expr(cond)
    }
    // Truncate i64 → i1 for the branch.
    let cond_i1 = llvm.build_icmp(cg.builder, 33, cond.value, llvm.const_int(cg.i64_type, 0, 0), "if_cond")

    let then_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "then")
    let else_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "else")
    let merge_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "ifcont")

    llvm.build_cond_br(cg.builder, cond_i1, then_bb, else_bb)

    // Then branch
    llvm.position_at_end(cg.builder, then_bb)
    let then_result = emit_stmt(cg, env, then_branch)
    if then_result.had_error {
        return then_result
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_br(cg.builder, merge_bb)
    }

    // Else branch
    llvm.position_at_end(cg.builder, else_bb)
    if else_branch != null {
        let else_result = emit_stmt(cg, env, else_branch!)
        if else_result.had_error {
            return else_result
        }
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_br(cg.builder, merge_bb)
    }

    llvm.position_at_end(cg.builder, merge_bb)
    ok_stmt(env)
}

fn emit_while(cg: Codegen, env: VarEnv, condition: Expr, body: Stmt) -> StmtResult {
    let cond_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "while.cond")
    let body_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "while.body")
    let exit_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "while.exit")

    llvm.build_br(cg.builder, cond_bb)

    llvm.position_at_end(cg.builder, cond_bb)
    let cond = emit_expr(cg, env, condition)
    if cond.had_error {
        return err_stmt_from_expr(cond)
    }
    let cond_i1 = llvm.build_icmp(cg.builder, 33, cond.value, llvm.const_int(cg.i64_type, 0, 0), "while_cond")
    llvm.build_cond_br(cg.builder, cond_i1, body_bb, exit_bb)

    llvm.position_at_end(cg.builder, body_bb)
    let body_result = emit_stmt(cg, env, body)
    if body_result.had_error {
        return body_result
    }
    if !llvm.block_has_terminator(cg.builder) {
        llvm.build_br(cg.builder, cond_bb)
    }

    llvm.position_at_end(cg.builder, exit_bb)
    ok_stmt(env)
}

// ── Expression emission ──

fn emit_expr(cg: Codegen, env: VarEnv, expr: Expr) -> EmitResult {
    match expr {
        .Number(text) -> {
            let value = int(text)
            ok_emit(llvm.const_int(cg.i64_type, value, 0))
        }
        .Bool(text) -> {
            if text == "true" {
                return ok_emit(llvm.const_int(cg.i64_type, 1, 0))
            }
            ok_emit(llvm.const_int(cg.i64_type, 0, 0))
        }
        .Null -> ok_emit(llvm.const_int(cg.i64_type, 0, 0))
        .String(text) -> {
            let inner = strip_quotes(text)
            let str_ptr = llvm.build_global_string_ptr(cg.builder, inner, ".str")
            ok_emit_str(llvm.build_ptr_to_int(cg.builder, str_ptr, cg.i64_type, "str_i64"))
        }
        .Grouping(inner) -> emit_expr(cg, env, inner)
        .Unary(operator, right) -> emit_unary(cg, env, operator, right)
        .Binary(left, operator, right) -> emit_binary(cg, env, left, operator, right)
        .Logical(left, operator, right) -> emit_binary(cg, env, left, operator, right)
        .Ident(name) -> {
            let lookup = env_lookup(env, name)
            if !lookup.found {
                return err_emit("undefined variable `" + name + "`")
            }
            let loaded = llvm.build_load(cg.builder, cg.i64_type, lookup.alloca, name)
            EmitResult { value: loaded, ty: lookup.ty, had_error: false, error_message: "" }
        }
        .Assign(name, value) -> {
            let lookup = env_lookup(env, name)
            if !lookup.found {
                return err_emit("assignment to undefined variable `" + name + "`")
            }
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return r
            }
            llvm.build_store(cg.builder, r.value, lookup.alloca)
            EmitResult { value: r.value, ty: lookup.ty, had_error: false, error_message: "" }
        }
        .Call(callee, args) -> emit_call(cg, env, callee, args)
        .StructLit(name, inits) -> emit_struct_lit(cg, env, name, inits)
        .FieldAccess(obj, field) -> emit_field_access(cg, env, obj, field)
        .EnumCtor(type_name, variant, args) -> emit_enum_ctor(cg, env, type_name, variant, args)
        _ -> err_emit("unsupported expression type")
    }
}

fn emit_struct_lit(cg: Codegen, env: VarEnv, name: string, inits: FieldInitList) -> EmitResult {
    let lookup = struct_reg_lookup(name)
    if !lookup.found {
        return err_emit("undefined struct type `" + name + "`")
    }
    let st_ty = llvm.get_type_by_name(cg.ctx, name)
    if st_ty == null {
        return err_emit("LLVM struct type `" + name + "` not declared")
    }
    // alloca + zero + per-field store via GEP, then load the whole
    // struct value and ptrtoint it into i64 storage. The struct's
    // pointer is what callers use as a struct value.
    let alloca = llvm.build_alloca(cg.builder, st_ty, name)
    let fill = fill_struct_fields(cg, env, st_ty, alloca, inits, lookup.fields)
    if fill.had_error {
        return fill
    }
    // Encode the alloca pointer as i64 so it lives in the same value
    // space as everything else.
    let as_i64 = llvm.build_ptr_to_int(cg.builder, alloca, cg.i64_type, "struct_i64")
    EmitResult { value: as_i64, ty: "struct:" + name, had_error: false, error_message: "" }
}

fn fill_struct_fields(cg: Codegen, env: VarEnv, st_ty: ptr, alloca: ptr, inits: FieldInitList, fields: FieldList) -> EmitResult {
    match inits {
        .End -> ok_emit(null_ptr_val())
        .Node(field_name, value, next) -> {
            let idx = field_index_of(fields, field_name)
            if idx < 0 {
                return err_emit("unknown field `" + field_name + "`")
            }
            let r = emit_expr(cg, env, value)
            if r.had_error {
                return r
            }
            let gep = llvm.build_struct_gep2(cg.builder, st_ty, alloca, idx, "fld_ptr")
            llvm.build_store(cg.builder, r.value, gep)
            fill_struct_fields(cg, env, st_ty, alloca, next, fields)
        }
    }
}

fn emit_field_access(cg: Codegen, env: VarEnv, obj: Expr, field: string) -> EmitResult {
    // Special case: bare `EnumName.Variant` (zero-arg enum
    // constructor). The parser models this as
    // FieldAccess(Ident(EnumName), Variant) because there's no
    // following `(`. Detect that here by checking the enum registry
    // before falling back to struct field access.
    match obj {
        .Ident(head) -> {
            let enum_l = enum_reg_lookup(head)
            if enum_l.found {
                return emit_enum_ctor(cg, env, head, field, ExprList.End)
            }
        }
        _ -> {}
    }

    let r = emit_expr(cg, env, obj)
    if r.had_error {
        return r
    }
    // The object's ty tag tells us which struct it is.
    let struct_name = strip_struct_prefix(r.ty)
    if struct_name == "" {
        return err_emit("field access on non-struct value (ty=" + r.ty + ")")
    }
    let lookup = struct_reg_lookup(struct_name)
    if !lookup.found {
        return err_emit("unknown struct `" + struct_name + "`")
    }
    let idx = field_index_of(lookup.fields, field)
    if idx < 0 {
        return err_emit("unknown field `" + field + "` on struct `" + struct_name + "`")
    }
    let st_ty = llvm.get_type_by_name(cg.ctx, struct_name)
    let obj_ptr = llvm.build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "obj_ptr")
    let gep = llvm.build_struct_gep2(cg.builder, st_ty, obj_ptr, idx, "fld_ptr")
    let loaded = llvm.build_load(cg.builder, cg.i64_type, gep, field)
    let field_ty = field_type_of(lookup.fields, field)
    EmitResult { value: loaded, ty: field_ty, had_error: false, error_message: "" }
}

fn emit_enum_ctor(cg: Codegen, env: VarEnv, type_name: string, variant: string, args: ExprList) -> EmitResult {
    let enum_l = enum_reg_lookup(type_name)
    if !enum_l.found {
        return err_emit("undefined enum type `" + type_name + "`")
    }
    let v = variant_lookup(enum_l.variants, variant)
    if !v.found {
        return err_emit("enum `" + type_name + "` has no variant `" + variant + "`")
    }
    let st_ty = llvm.get_type_by_name(cg.ctx, type_name)
    if st_ty == null {
        return err_emit("LLVM enum type `" + type_name + "` not declared")
    }
    let alloca = llvm.build_alloca(cg.builder, st_ty, type_name)
    // Set tag at field index 0.
    let tag_gep = llvm.build_struct_gep2(cg.builder, st_ty, alloca, 0, "tag_ptr")
    let tag_val = llvm.const_int(llvm.int8_type(cg.ctx), v.tag, 0)
    llvm.build_store(cg.builder, tag_val, tag_gep)
    // Store payload args at field indices 1..N.
    let fill = fill_enum_payload(cg, env, st_ty, alloca, args, 0)
    if fill.had_error {
        return fill
    }
    let as_i64 = llvm.build_ptr_to_int(cg.builder, alloca, cg.i64_type, "enum_i64")
    EmitResult { value: as_i64, ty: "enum:" + type_name, had_error: false, error_message: "" }
}

fn fill_enum_payload(cg: Codegen, env: VarEnv, st_ty: ptr, alloca: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(expr, next) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return r
            }
            let gep = llvm.build_struct_gep2(cg.builder, st_ty, alloca, idx + 1, "payload_ptr")
            llvm.build_store(cg.builder, r.value, gep)
            fill_enum_payload(cg, env, st_ty, alloca, next, idx + 1)
        }
    }
}

// "enum:Name" → "Name"; anything else → "".
fn emit_match(cg: Codegen, env: VarEnv, subject: Expr, arms: MatchArmList) -> StmtResult {
    let r = emit_expr(cg, env, subject)
    if r.had_error {
        return err_stmt_from_expr(r)
    }
    let enum_name = strip_enum_prefix(r.ty)
    if enum_name == "" {
        return err_stmt("codegen error: match subject is not an enum (ty=" + r.ty + ")")
    }
    let lookup = enum_reg_lookup(enum_name)
    if !lookup.found {
        return err_stmt("codegen error: unknown enum `" + enum_name + "`")
    }
    let st_ty = llvm.get_type_by_name(cg.ctx, enum_name)
    let subj_ptr = llvm.build_int_to_ptr(cg.builder, r.value, cg.ptr_type, "match_subj")
    // Load tag once.
    let tag_gep = llvm.build_struct_gep2(cg.builder, st_ty, subj_ptr, 0, "tag_ptr")
    let tag_val = llvm.build_load(cg.builder, llvm.int8_type(cg.ctx), tag_gep, "tag")

    let merge_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "match_end")
    let arm_result = emit_match_arms(cg, env, arms, st_ty, subj_ptr, tag_val, lookup.variants, merge_bb)
    if arm_result.had_error {
        return arm_result
    }
    llvm.position_at_end(cg.builder, merge_bb)
    ok_stmt(env)
}

fn emit_match_arms(cg: Codegen, env: VarEnv, arms: MatchArmList, st_ty: ptr, subj_ptr: ptr, tag_val: ptr, variants: VariantList, merge_bb: ptr) -> StmtResult {
    match arms {
        .End -> {
            // No more arms — terminate the current block by branching
            // to merge if it isn't already terminated. (A wildcard
            // arm is the standard way to handle this.)
            if !llvm.block_has_terminator(cg.builder) {
                llvm.build_br(cg.builder, merge_bb)
            }
            ok_stmt(env)
        }
        .Node(pattern, body, next) -> {
            let arm_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "match_arm")
            let next_bb = llvm.append_basic_block(cg.ctx, cg.current_fn, "match_next")
            // Compare current tag against this pattern's variant tag,
            // or always-true for wildcard.
            match pattern {
                .Wildcard -> {
                    llvm.build_br(cg.builder, arm_bb)
                }
                .Variant(vname, _) -> {
                    let v = variant_lookup(variants, vname)
                    if !v.found {
                        return err_stmt("codegen error: pattern references unknown variant `" + vname + "`")
                    }
                    let want_tag = llvm.const_int(llvm.int8_type(cg.ctx), v.tag, 0)
                    let cmp = llvm.build_icmp(cg.builder, 32, tag_val, want_tag, "tag_eq")
                    llvm.build_cond_br(cg.builder, cmp, arm_bb, next_bb)
                }
            }
            // Emit the arm body, with payload bindings if any.
            llvm.position_at_end(cg.builder, arm_bb)
            let arm_env = bind_pattern_payload(cg, env, pattern, st_ty, subj_ptr, variants)
            let body_result = emit_stmt(cg, arm_env, body)
            if body_result.had_error {
                return body_result
            }
            if !llvm.block_has_terminator(cg.builder) {
                llvm.build_br(cg.builder, merge_bb)
            }
            // Continue dispatch in next_bb.
            llvm.position_at_end(cg.builder, next_bb)
            emit_match_arms(cg, env, next, st_ty, subj_ptr, tag_val, variants, merge_bb)
        }
    }
}

fn bind_pattern_payload(cg: Codegen, env: VarEnv, pattern: Pattern, st_ty: ptr, subj_ptr: ptr, variants: VariantList) -> VarEnv {
    match pattern {
        .Wildcard -> env
        .Variant(vname, bindings) -> {
            let v = variant_lookup(variants, vname)
            if !v.found {
                return env
            }
            // Walk the bindings ParamList in parallel with the
            // variant's FieldList. For each name, GEP to payload
            // index (1 + i), load i64, alloca, store.
            bind_pattern_payload_loop(cg, env, st_ty, subj_ptr, bindings, v.fields, 0)
        }
    }
}

fn bind_pattern_payload_loop(cg: Codegen, env: VarEnv, st_ty: ptr, subj_ptr: ptr, bindings: ParamList, fields: FieldList, idx: int) -> VarEnv {
    match bindings {
        .End -> env
        .Node(name, next_b) -> {
            // _ in a binding position is a "don't bind" placeholder.
            if name == "_" {
                return bind_pattern_payload_loop(cg, env, st_ty, subj_ptr, next_b, advance_field_list(fields), idx + 1)
            }
            let gep = llvm.build_struct_gep2(cg.builder, st_ty, subj_ptr, idx + 1, "pbind_ptr")
            let loaded = llvm.build_load(cg.builder, cg.i64_type, gep, name)
            let alloca = llvm.build_alloca(cg.builder, cg.i64_type, name)
            llvm.build_store(cg.builder, loaded, alloca)
            let field_ty = field_type_at(fields, 0)
            let extended = env_extend(env, name, alloca, field_ty)
            bind_pattern_payload_loop(cg, extended, st_ty, subj_ptr, next_b, advance_field_list(fields), idx + 1)
        }
    }
}

fn advance_field_list(fields: FieldList) -> FieldList {
    match fields {
        .End -> FieldList.End
        .Node(_, _, next) -> next
    }
}

fn field_type_at(fields: FieldList, idx: int) -> string {
    match fields {
        .End -> "i64"
        .Node(_, ty, next) -> {
            if idx <= 0 {
                if ty == "str" {
                    return "str"
                }
                return "i64"
            }
            field_type_at(next, idx - 1)
        }
    }
}

fn strip_enum_prefix(ty: string) -> string {
    if ty.length < 6 {
        return ""
    }
    let head = ty.substring(0, 5)
    if head != "enum:" {
        return ""
    }
    ty.substring(5, ty.length)
}

// "struct:Name" → "Name"; anything else → "".
fn strip_struct_prefix(ty: string) -> string {
    if ty.length < 8 {
        return ""
    }
    let head = ty.substring(0, 7)
    if head != "struct:" {
        return ""
    }
    ty.substring(7, ty.length)
}

fn emit_call(cg: Codegen, env: VarEnv, callee: Expr, args: ExprList) -> EmitResult {
    // Destructure callee exactly once. Repeated `match` of the same
    // enum value miscompiles in the host: the second destructure
    // produces a corrupted payload (an empty string in this case),
    // which makes the function lookup silently fail.
    match callee {
        .Ident(name) -> emit_call_named(cg, env, name, args)
        _ -> err_emit("only direct function calls are supported")
    }
}

fn emit_call_named(cg: Codegen, env: VarEnv, name: string, args: ExprList) -> EmitResult {
    if name == "println" {
        return emit_println(cg, env, args)
    }
    let fn_val = llvm.get_named_function(cg.module, name)
    if fn_val == null {
        return err_emit("undefined function `" + name + "`")
    }

    let arg_count = expr_list_length(args)
    let arg_arr = llvm.value_array_new(arg_count)
    let fill = fill_arg_array(cg, env, arg_arr, args, 0)
    if fill.had_error {
        llvm.value_array_free(arg_arr)
        return fill
    }
    // All bootstrap functions have the same shape: (i64, i64, ...) -> i64.
    let param_arr = llvm.type_array_new(arg_count)
    fill_i64_param_array(param_arr, cg.i64_type, 0, arg_count)
    let fn_type = llvm.function_type(cg.i64_type, param_arr, arg_count, 0)
    llvm.type_array_free(param_arr)

    let result = llvm.build_call(cg.builder, fn_type, fn_val, arg_arr, arg_count, "calltmp")
    llvm.value_array_free(arg_arr)
    ok_emit(result)
}

fn emit_println(cg: Codegen, env: VarEnv, args: ExprList) -> EmitResult {
    // Special-case the most common shape: `println("literal")`. We
    // destructure straight to the inner string text in a single
    // match — going through any extra binding clobbers the payload
    // (host miscompilation, see TECH_DEBT.md #11).
    let str_i64 = match args {
        .Node(e, _) -> {
            match e {
                .String(text) -> {
                    let inner = strip_quotes(text)
                    let str_ptr = llvm.build_global_string_ptr(cg.builder, inner, ".str")
                    llvm.build_ptr_to_int(cg.builder, str_ptr, cg.i64_type, "str_i64")
                }
                _ -> {
                    let r = emit_expr(cg, env, e)
                    if r.had_error {
                        return r
                    }
                    r.value
                }
            }
        }
        .End -> {
            return err_emit("println expects 1 argument")
        }
    }
    let str_ptr2 = llvm.build_int_to_ptr(cg.builder, str_i64, cg.ptr_type, "str_ptr")
    let puts_fn = llvm.get_named_function(cg.module, "puts")
    let arg_arr = llvm.value_array_new(1)
    llvm.value_array_set(arg_arr, 0, str_ptr2)
    let puts_param_arr = llvm.type_array_new(1)
    llvm.type_array_set(puts_param_arr, 0, cg.ptr_type)
    let puts_type = llvm.function_type(llvm.int32_type(cg.ctx), puts_param_arr, 1, 0)
    llvm.type_array_free(puts_param_arr)
    llvm.build_call(cg.builder, puts_type, puts_fn, arg_arr, 1, "")
    llvm.value_array_free(arg_arr)
    ok_emit(llvm.const_int(cg.i64_type, 0, 0))
}

fn emit_concat(cg: Codegen, lhs_i64: ptr, rhs_i64: ptr) -> EmitResult {
    // Decode the i64-encoded operands back to ptrs.
    let lhs_ptr = llvm.build_int_to_ptr(cg.builder, lhs_i64, cg.ptr_type, "concat_l")
    let rhs_ptr = llvm.build_int_to_ptr(cg.builder, rhs_i64, cg.ptr_type, "concat_r")

    // strlen each side.
    let strlen_fn = llvm.get_named_function(cg.module, "strlen")
    let strlen_param_arr = llvm.type_array_new(1)
    llvm.type_array_set(strlen_param_arr, 0, cg.ptr_type)
    let strlen_type = llvm.function_type(cg.i64_type, strlen_param_arr, 1, 0)
    llvm.type_array_free(strlen_param_arr)

    let l_arr = llvm.value_array_new(1)
    llvm.value_array_set(l_arr, 0, lhs_ptr)
    let lhs_len = llvm.build_call(cg.builder, strlen_type, strlen_fn, l_arr, 1, "lhs_len")
    llvm.value_array_free(l_arr)

    let r_arr = llvm.value_array_new(1)
    llvm.value_array_set(r_arr, 0, rhs_ptr)
    let rhs_len = llvm.build_call(cg.builder, strlen_type, strlen_fn, r_arr, 1, "rhs_len")
    llvm.value_array_free(r_arr)

    // total = lhs_len + rhs_len; alloc = total + 1 (null terminator)
    let total = llvm.build_add(cg.builder, lhs_len, rhs_len, "concat_total")
    let one = llvm.const_int(cg.i64_type, 1, 0)
    let alloc_size = llvm.build_add(cg.builder, total, one, "concat_size")

    // malloc(alloc_size)
    let malloc_fn = llvm.get_named_function(cg.module, "malloc")
    let malloc_param_arr = llvm.type_array_new(1)
    llvm.type_array_set(malloc_param_arr, 0, cg.i64_type)
    let malloc_type = llvm.function_type(cg.ptr_type, malloc_param_arr, 1, 0)
    llvm.type_array_free(malloc_param_arr)

    let m_arr = llvm.value_array_new(1)
    llvm.value_array_set(m_arr, 0, alloc_size)
    let buf = llvm.build_call(cg.builder, malloc_type, malloc_fn, m_arr, 1, "concat_buf")
    llvm.value_array_free(m_arr)

    // memcpy(buf, lhs_ptr, lhs_len)
    let memcpy_fn = llvm.get_named_function(cg.module, "memcpy")
    let memcpy_param_arr = llvm.type_array_new(3)
    llvm.type_array_set(memcpy_param_arr, 0, cg.ptr_type)
    llvm.type_array_set(memcpy_param_arr, 1, cg.ptr_type)
    llvm.type_array_set(memcpy_param_arr, 2, cg.i64_type)
    let memcpy_type = llvm.function_type(cg.ptr_type, memcpy_param_arr, 3, 0)
    llvm.type_array_free(memcpy_param_arr)

    let mc1_arr = llvm.value_array_new(3)
    llvm.value_array_set(mc1_arr, 0, buf)
    llvm.value_array_set(mc1_arr, 1, lhs_ptr)
    llvm.value_array_set(mc1_arr, 2, lhs_len)
    llvm.build_call(cg.builder, memcpy_type, memcpy_fn, mc1_arr, 3, "")
    llvm.value_array_free(mc1_arr)

    // memcpy(buf + lhs_len, rhs_ptr, rhs_len + 1)  — copies rhs and the trailing NUL
    let buf_int = llvm.build_ptr_to_int(cg.builder, buf, cg.i64_type, "buf_int")
    let dst2_int = llvm.build_add(cg.builder, buf_int, lhs_len, "dst2_int")
    let dst2 = llvm.build_int_to_ptr(cg.builder, dst2_int, cg.ptr_type, "dst2")
    let rhs_len_plus_1 = llvm.build_add(cg.builder, rhs_len, one, "rhs_len_p1")

    let mc2_arr = llvm.value_array_new(3)
    llvm.value_array_set(mc2_arr, 0, dst2)
    llvm.value_array_set(mc2_arr, 1, rhs_ptr)
    llvm.value_array_set(mc2_arr, 2, rhs_len_plus_1)
    llvm.build_call(cg.builder, memcpy_type, memcpy_fn, mc2_arr, 3, "")
    llvm.value_array_free(mc2_arr)

    let result_i64 = llvm.build_ptr_to_int(cg.builder, buf, cg.i64_type, "concat_i64")
    ok_emit_str(result_i64)
}

fn strip_quotes(s: string) -> string {
    let len = s.length
    if len < 2 {
        return s
    }
    s.substring(1, len - 1)
}

fn fill_arg_array(cg: Codegen, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {
    match args {
        .End -> ok_emit(null_ptr_val())
        .Node(expr, next) -> {
            let r = emit_expr(cg, env, expr)
            if r.had_error {
                return r
            }
            llvm.value_array_set(arr, idx, r.value)
            fill_arg_array(cg, env, arr, next, idx + 1)
        }
    }
}

fn emit_unary(cg: Codegen, env: VarEnv, operator: string, right: Expr) -> EmitResult {
    let right_result = emit_expr(cg, env, right)
    if right_result.had_error {
        return right_result
    }

    if operator == "-" {
        let zero = llvm.const_int(cg.i64_type, 0, 0)
        return ok_emit(llvm.build_sub(cg.builder, zero, right_result.value, "neg"))
    }

    if operator == "!" {
        let cmp = llvm.build_icmp(cg.builder, 32, right_result.value, llvm.const_int(cg.i64_type, 0, 0), "not_cmp")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "not"))
    }

    err_emit("unsupported unary operator `" + operator + "`")
}

fn emit_binary(cg: Codegen, env: VarEnv, left: Expr, operator: string, right: Expr) -> EmitResult {
    let left_result = emit_expr(cg, env, left)
    if left_result.had_error {
        return left_result
    }
    let lhs = left_result.value

    let right_result = emit_expr(cg, env, right)
    if right_result.had_error {
        return right_result
    }
    let rhs = right_result.value

    if operator == "+" {
        // Dispatch + on operand types: if either side is a string,
        // emit a string concat sequence (strlen+strlen+malloc+memcpy
        // ×2 + null-terminate). Otherwise it's an integer add.
        if left_result.ty == "str" || right_result.ty == "str" {
            return emit_concat(cg, lhs, rhs)
        }
        return ok_emit(llvm.build_add(cg.builder, lhs, rhs, "add"))
    }
    if operator == "-" { return ok_emit(llvm.build_sub(cg.builder, lhs, rhs, "sub")) }
    if operator == "*" { return ok_emit(llvm.build_mul(cg.builder, lhs, rhs, "mul")) }
    if operator == "/" { return ok_emit(llvm.build_sdiv(cg.builder, lhs, rhs, "div")) }

    // Comparisons: icmp returns i1, zext to i64
    // pred: 32=eq, 33=ne, 38=sgt, 39=sge, 40=slt, 41=sle
    if operator == "==" {
        let cmp = llvm.build_icmp(cg.builder, 32, lhs, rhs, "eq")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "eq_ext"))
    }
    if operator == "!=" {
        let cmp = llvm.build_icmp(cg.builder, 33, lhs, rhs, "ne")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "ne_ext"))
    }
    if operator == "<" {
        let cmp = llvm.build_icmp(cg.builder, 40, lhs, rhs, "slt")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "slt_ext"))
    }
    if operator == "<=" {
        let cmp = llvm.build_icmp(cg.builder, 41, lhs, rhs, "sle")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "sle_ext"))
    }
    if operator == ">" {
        let cmp = llvm.build_icmp(cg.builder, 38, lhs, rhs, "sgt")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "sgt_ext"))
    }
    if operator == ">=" {
        let cmp = llvm.build_icmp(cg.builder, 39, lhs, rhs, "sge")
        return ok_emit(llvm.build_zext(cg.builder, cmp, cg.i64_type, "sge_ext"))
    }

    if operator == "&&" {
        // Eager-bitwise lowering — short-circuit can come later.
        let l_bool = llvm.build_icmp(cg.builder, 33, lhs, llvm.const_int(cg.i64_type, 0, 0), "l_bool")
        let r_bool = llvm.build_icmp(cg.builder, 33, rhs, llvm.const_int(cg.i64_type, 0, 0), "r_bool")
        let l_ext = llvm.build_zext(cg.builder, l_bool, cg.i64_type, "l_ext")
        let r_ext = llvm.build_zext(cg.builder, r_bool, cg.i64_type, "r_ext")
        return ok_emit(llvm.build_mul(cg.builder, l_ext, r_ext, "and"))
    }
    if operator == "||" {
        let l_bool = llvm.build_icmp(cg.builder, 33, lhs, llvm.const_int(cg.i64_type, 0, 0), "l_bool")
        let r_bool = llvm.build_icmp(cg.builder, 33, rhs, llvm.const_int(cg.i64_type, 0, 0), "r_bool")
        let l_ext = llvm.build_zext(cg.builder, l_bool, cg.i64_type, "l_ext")
        let r_ext = llvm.build_zext(cg.builder, r_bool, cg.i64_type, "r_ext")
        let sum = llvm.build_add(cg.builder, l_ext, r_ext, "or_sum")
        let nonzero = llvm.build_icmp(cg.builder, 33, sum, llvm.const_int(cg.i64_type, 0, 0), "or_cmp")
        return ok_emit(llvm.build_zext(cg.builder, nonzero, cg.i64_type, "or"))
    }

    err_emit("unsupported binary operator `" + operator + "`")
}
