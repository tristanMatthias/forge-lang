use @std.process
// Load-bearing import: the host compiler's package prescan only walks
// the entry file's tokens, so even though codegen.fg is the actual
// caller of `@std.llvm` we have to declare the dependency here too
// (otherwise the package is not loaded and link `-u` symbols are not
// emitted). See bootstrap/TECH_DEBT.md #10.
use @std.llvm

// Direct C externs for the small set of host process helpers we
// need at the entry point. The bootstrap codegen doesn't model
// the @std.process package's List<string> argv shape, so we use
// the lower-level forge_selfhost_argc / forge_selfhost_get_arg
// runtime helpers (defined in forge/stdlib/runtime.c) and libc
// exit directly. The host compiler also accepts these because
// they are just C symbols.
extern fn forge_selfhost_argc() -> int
extern fn forge_selfhost_get_arg_cstr(idx: int) -> string
extern fn forge_selfhost_trace(s: string)
extern fn forge_selfhost_trace_int(label: string, val: int)
extern fn exit(code: int)

// File-system builtins. The bootstrap codegen passes strings as a
// single i64 (the C-string pointer) rather than the host's
// ForgeString {ptr, len} struct, so we link against the
// forge_selfhost_* C-wrappers in stdlib/runtime.c that take plain
// `const char*` arguments.
extern fn forge_selfhost_file_exists(path: string) -> int
extern fn forge_selfhost_read_file(path: string) -> string
extern fn forge_selfhost_write_file(path: string, content: string) -> int

// Convenience aliases so the rest of the bootstrap source can keep
// using the short names.
fn file_exists(path: string) -> int { forge_selfhost_file_exists(path) }
fn read_file(path: string) -> string { forge_selfhost_read_file(path) }
fn write_file(path: string, content: string) -> int { forge_selfhost_write_file(path, content) }

mod core
mod parse
mod features
mod codegen

use core.scanner.{scan_source, render_tokens}
use parse.{parse_expression_source, parse_program_source}
use core.ast.{render_expr, render_stmt_list}
use core.eval.{eval_expression_source, execute_program_source, render_value}
use core.resolver.{resolve_program}
use codegen.{compile_program}

fn print_usage() {
    eprintln("forge-bootstrap v0.1.0")
    eprintln("Usage: bootstrapc <tokens|expr|program|eval|check|compile|run> <file.fg>")
}

fn fail(message: string) {
    eprintln(message)
    exit(1)
}

// Returns the directory portion of a path, with trailing slash, or
// "" if the path has no slash.
fn dirname(path: string) -> string {
    let len = path.length
    mut i = len
    while i > 0 {
        let prev = i - 1
        if path[prev] == "/" {
            return path.substring(0, i)
        }
        i = prev
    }
    ""
}

// Walk the source line by line. For each `mod foo` line, replace it
// with the content of `<dir>/foo.fg` OR `<dir>/foo/mod.fg`, then
// recursively preprocess the inlined content so nested module
// hierarchies work. The directory style (`foo/mod.fg`) is what
// powers the feature-organized layout where each language feature
// lives under `features/<name>/`.
fn preprocess_modules(source: string, entry_path: string) -> string {
    let dir = dirname(entry_path)
    mut out = ""
    mut i = 0
    let n = source.length
    while i < n {
        let line_start = i
        while i < n {
            if source[i] == "\n" {
                i = i + 1
                break
            }
            i = i + 1
        }
        let line = source.substring(line_start, i)
        let mod_name = extract_mod_name(line)
        if mod_name == "" {
            out = out + line
        } else {
            // Try sibling-file form first: <dir>/<name>.fg
            let sibling_path = dir + mod_name + ".fg"
            // Then directory-module form: <dir>/<name>/mod.fg
            let dir_mod_path = dir + mod_name + "/mod.fg"
            if file_exists(sibling_path) {
                let mod_src = read_file(sibling_path)
                let inlined = preprocess_modules(mod_src, sibling_path)
                out = out + "// === module " + mod_name + " ===\n"
                out = out + inlined
                out = out + "\n"
            } else if file_exists(dir_mod_path) {
                let mod_src = read_file(dir_mod_path)
                let inlined = preprocess_modules(mod_src, dir_mod_path)
                out = out + "// === module " + mod_name + " ===\n"
                out = out + inlined
                out = out + "\n"
            } else {
                out = out + "// === module " + mod_name + " (not found) ===\n"
            }
        }
    }
    out
}

// If `line` starts with `mod <name>`, return `<name>`. Otherwise "".
// Trims leading whitespace.
fn extract_mod_name(line: string) -> string {
    let len = line.length
    mut i = 0
    while i < len {
        let ch = line[i]
        if ch != " " && ch != "\t" {
            break
        }
        i = i + 1
    }
    if i + 4 > len {
        return ""
    }
    if line[i] != "m" { return "" }
    if line[i + 1] != "o" { return "" }
    if line[i + 2] != "d" { return "" }
    if line[i + 3] != " " { return "" }
    mut j = i + 4
    let name_start = j
    while j < len {
        let ch = line[j]
        if ch == " " || ch == "\n" || ch == "\t" || ch == "\r" {
            break
        }
        j = j + 1
    }
    line.substring(name_start, j)
}

fn main() {
    if forge_selfhost_argc() < 3 {
        print_usage()
        exit(1)
    }

    let command = forge_selfhost_get_arg_cstr(1)
    let path = forge_selfhost_get_arg_cstr(2)
    if !file_exists(path) {
        fail("error: file not found: " + path)
    }

    let source = read_file(path)
    if command == "tokens" {
        let result = scan_source(source)
        if result.had_error {
            fail(result.error_message)
        }

        println(render_tokens(result))
        return
    }

    if command == "expr" {
        let result = parse_expression_source(source)
        if result.had_error || result.expr == null {
            fail(result.error_message)
        }

        println(render_expr(result.expr!))
        return
    }

    if command == "program" {
        let result = parse_program_source(source)
        if result.had_error || result.stmts == null {
            fail(result.error_message)
        }

        println(render_stmt_list(result.stmts!))
        return
    }

    if command == "eval" {
        let result = eval_expression_source(source)
        if result.had_error || result.value == null {
            fail(result.error_message)
        }

        println(render_value(result.value!))
        return
    }

    if command == "check" {
        let parsed = parse_program_source(source)
        if parsed.had_error || parsed.stmts == null {
            fail(parsed.error_message)
        }
        let resolved = resolve_program(parsed.stmts!)
        if resolved.had_error {
            fail(resolved.error_message)
        }
        println("ok")
        return
    }

    if command == "compile" {
        let merged = preprocess_modules(source, path)
        let parsed = parse_program_source(merged)
        if parsed.had_error || parsed.stmts == null {
            fail(parsed.error_message)
        }
        let resolved = resolve_program(parsed.stmts!)
        if resolved.had_error {
            fail(resolved.error_message)
        }

        let output = path + ".ll"
        let compiled = compile_program(parsed.stmts!, output)
        if compiled.had_error {
            fail(compiled.error_message)
        }
        println(output)
        return
    }

    if command == "run" {
        let result = execute_program_source(source)
        if result.had_error || result.value == null {
            fail(result.error_message)
        }

        println(render_value(result.value!))
        return
    }

    print_usage()
    exit(1)
}
