// C externs for process helpers and file I/O.
// These are provided by bootstrap/runtime.c.
extern fn forge_selfhost_argc() -> int
extern fn forge_selfhost_get_arg_cstr(idx: int) -> string
extern fn forge_selfhost_trace(s: string)
extern fn forge_selfhost_trace_int(label: string, val: int)
extern fn exit(code: int)
extern fn forge_char_from_hex(hi: string, lo: string) -> string

// Developer tooling — crash guard, tracing, AST inspection
extern fn forge_trace_ptr(label: string, val: int)
extern fn forge_dump_stmt(label: string, stmt: int)
extern fn forge_dump_stmt_list(label: string, list: int)

// File-system builtins. The bootstrap codegen passes strings as a
// single i64 (the C-string pointer) rather than the host's
// ForgeString {ptr, len} struct, so we link against the
// forge_selfhost_* C-wrappers in stdlib/runtime.c that take plain
// `const char*` arguments.
extern fn forge_selfhost_file_exists(path: string) -> int
extern fn forge_selfhost_read_file(path: string) -> string
extern fn forge_selfhost_write_file(path: string, content: string) -> int

// Convenience aliases so the rest of the bootstrap source can keep
// using the short names.
fn file_exists(path: string) -> int { forge_selfhost_file_exists(path) }
fn read_file(path: string) -> string { forge_selfhost_read_file(path) }
fn write_file(path: string, content: string) -> int { forge_selfhost_write_file(path, content) }

mod core
mod diagnostics
mod parse
mod features
mod typeck
mod codegen

use core.scanner.{scan_source, render_tokens}
use parse.{parse_expression_source, parse_program_source}
use core.ast.{render_expr, render_stmt_list}
use core.eval.{eval_expression_source, execute_program_source, render_value}
use core.resolver.{resolve_program}
use features.modules.names.{resolve_names}
use features.modules.resolver.{resolve_module_files, modules_dirname, LoadedPaths}
use typeck.{typecheck_program}
use diagnostics.{bag_has_errors}
use diagnostics.render.{render_bag}
use codegen.{compile_program}

fn print_usage() {
    eprintln("forge-bootstrap v0.1.0")
    eprintln("Usage: bootstrapc <tokens|expr|program|eval|check|compile|run> <file.fg>")
    eprintln("       bootstrapc compile --stop-after=<parse|resolve|names|check> <file.fg>")
}

fn fail(message: string) {
    eprintln(message)
    exit(1)
}

// Module file resolution and name resolution live in features/modules/.

fn main() {
    if forge_selfhost_argc() < 3 {
        print_usage()
        exit(1)
    }

    let command = forge_selfhost_get_arg_cstr(1)
    let path = forge_selfhost_get_arg_cstr(2)
    // Skip file existence check when arg 2 is a flag (e.g. --stop-after=X).
    // The compile command handles its own path validation in that case.
    let is_flag = path.length > 2 && path.substring(0, 2) == "--"
    if !is_flag && !file_exists(path) {
        fail("error: file not found: " + path)
    }

    let source = if is_flag { "" } else { read_file(path) }
    if command == "tokens" {
        let result = scan_source(source)
        if result.had_error {
            fail(result.error_message)
        }

        println(render_tokens(result))
        return
    }

    if command == "expr" {
        let result = parse_expression_source(source)
        if result.had_error || result.expr == null {
            fail(result.error_message)
        }

        println(render_expr(result.expr!))
        return
    }

    if command == "program" {
        let result = parse_program_source(source)
        if result.had_error || result.stmts == null {
            fail(result.error_message)
        }

        println(render_stmt_list(result.stmts!))
        return
    }

    if command == "eval" {
        let result = eval_expression_source(source)
        if result.had_error || result.value == null {
            fail(result.error_message)
        }

        println(render_value(result.value!))
        return
    }

    if command == "check" {
        let parsed = parse_program_source(source)
        if parsed.had_error || parsed.stmts == null {
            if bag_has_errors(parsed.bag) {
                render_bag(source, path, parsed.bag)
            }
            fail(parsed.error_message)
        }
        // Resolve module files
        let entry_dir = modules_dirname(path)
        let mod_resolved = resolve_module_files(parsed.stmts!, entry_dir, LoadedPaths.End)
        if mod_resolved.had_error {
            let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
            render_bag(source, path, mod_bag)
            fail(mod_resolved.error_message)
        }
        let named = resolve_names(mod_resolved.stmts)
        if bag_has_errors(named.bag) {
            render_bag(source, path, named.bag)
        }
        if named.had_error { fail(named.error_message) }
        let resolved = resolve_program(named.stmts)
        if resolved.had_error {
            if bag_has_errors(resolved.bag) {
                render_bag(source, path, resolved.bag)
            }
            fail(resolved.error_message)
        }
        // Type check
        let tc_result = typecheck_program(named.stmts)
        if bag_has_errors(tc_result.bag) {
            render_bag(source, path, tc_result.bag)
        }
        println("ok")
        return
    }

    if command == "compile" {
        // Check for --stop-after=<pass> flag. When present, arg 2 is the
        // flag and arg 3 is the file path.
        let has_stop_flag = path.length > 13 && path.substring(0, 13) == "--stop-after="
        let stop_after = if has_stop_flag { path.substring(13, path.length) } else { "" }
        if has_stop_flag && forge_selfhost_argc() < 4 {
            fail("error: --stop-after requires a file path argument")
        }
        let cpath = if has_stop_flag { forge_selfhost_get_arg_cstr(3) } else { path }
        if has_stop_flag && !file_exists(cpath) {
            fail("error: file not found: " + cpath)
        }
        let csource = if has_stop_flag { read_file(cpath) } else { source }

        let parsed = parse_program_source(csource)
        if parsed.had_error || parsed.stmts == null {
            if bag_has_errors(parsed.bag) {
                render_bag(csource, cpath, parsed.bag)
            }
            fail(parsed.error_message)
        }
        if stop_after == "parse" {
            println("ok")
            return
        }
        // Resolve module files: walk the AST, find `mod` stubs, read
        // and parse the referenced files, attach parsed bodies.
        let entry_dir = modules_dirname(cpath)
        let mod_resolved = resolve_module_files(parsed.stmts!, entry_dir, LoadedPaths.End)
        if mod_resolved.had_error {
            let mod_bag = bag_report(bag_new(), diag_error(DiagCode.ModuleNotFound, mod_resolved.error_message, span_dummy()))
            render_bag(csource, cpath, mod_bag)
            fail(mod_resolved.error_message)
        }
        if stop_after == "resolve" {
            println("ok")
            return
        }
        let named = resolve_names(mod_resolved.stmts)
        if bag_has_errors(named.bag) {
            render_bag(csource, cpath, named.bag)
        }
        if named.had_error { fail(named.error_message) }
        if stop_after == "names" {
            println("ok")
            return
        }
        let resolved = resolve_program(named.stmts)
        if resolved.had_error {
            if bag_has_errors(resolved.bag) {
                render_bag(csource, cpath, resolved.bag)
            }
            fail(resolved.error_message)
        }
        // Type check (additive — reports but doesn't block compilation)
        let tc_result = typecheck_program(named.stmts)
        if bag_has_errors(tc_result.bag) {
            render_bag(csource, cpath, tc_result.bag)
        }
        if stop_after == "check" {
            println("ok")
            return
        }
        let output = cpath + ".ll"
        let compiled = compile_program(named.stmts, output)
        if compiled.had_error {
            fail(compiled.error_message)
        }
        println(output)
        return
    }

    if command == "run" {
        let result = execute_program_source(source)
        if result.had_error || result.value == null {
            fail(result.error_message)
        }

        println(render_value(result.value!))
        return
    }

    print_usage()
    exit(1)
}
