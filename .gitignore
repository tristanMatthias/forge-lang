.ralph/.last_reset
.ralph/.loop_start_sha
.ralph/live.log
.ralph/progress.json
.ralph/status.json
.ralph/docs/

# Beads / Dolt files (added by bd init)
.beads-credential-key

# macOS metadata
.DS_Store
**/.DS_Store

# sha256_file sidecar cache (mtime-keyed memo, runtime.c)
*.avra-sha256

# Gate/test logs (transient)
.gt/

# Pin-don't-vendor (sdmg.3): the seed artifact is fetched per seed/seed.lock,
# not tracked. A locally cycled seed.ll must never be committed either.
bootstrap/seed/seed.ll
