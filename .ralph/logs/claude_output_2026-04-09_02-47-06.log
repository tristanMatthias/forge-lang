ength) + \" tokens\")\n    mut p = parser_new_with_source(tokens, source)\n    p.parse_program()\n    eprintln(\"BC: parsed, \" + string(FN_NAMES.length) + \" fns\")\n\n    // Phase 2: Single LLVM module — declare all, then emit bodies\n    eprintln(\"[BSC] before codegen_init\")\n    codegen_init(\"forgec_output\")\n    eprintln(\"[BSC] after codegen_init\")\n    eprintln(\"[BSC] before create_globals\")\n    create_globals_from_registry()\n    eprintln(\"[BSC] after create_globals\")\n    EMIT_FILE_IDX = -1\n    mut cg = codegen_new()","numLines":25,"startLine":315,"totalLines":422}}}
