{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CkkEjtmfDKWpzVLFCwqMYc","type":"tool_result","content":"The file /Users/tristan/projects/tristanMatthias/forge-crafting-intepreters/bootstrap/src/codegen/mod.fg has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"99531a4f-114c-49ff-a929-dced21bdd83f","uuid":"5cde4046-882e-4a08-99ca-f9980610f282","timestamp":"2026-04-09T10:00:19.389Z","tool_use_result":{"filePath":"/Users/tristan/projects/tristanMatthias/forge-crafting-intepreters/bootstrap/src/codegen/mod.fg","oldString":"        .Logical(left, operator, right) -> emit_binary(ctx, env, left, operator, right)","newString":"        .Logical(left, operator, right) -> emit_logical(ctx, env, left, operator, right)","originalFile":"use core.ast.{Expr, ExprList, Stmt, StmtList, ParamList, FieldList, FieldInitList, VariantList, Pattern, MatchArmList, VarEnv, env_lookup, env_extend, param_list_length, expr_list_length, field_list_length, field_init_length, field_index_of, field_type_of, variant_lookup, variant_max_payload}\nuse core.cg.{Ctx, EmitResult, StmtResult, null_ptr_val, ok_emit, ok_emit_str, err_emit, ok_stmt, err_stmt, err_stmt_from_expr, advance_field_list, field_type_at, strip_enum_prefix, strip_struct_prefix, EnumLookup, StructLookup, StructReg, EnumReg, FnRetTypes, TopLevelVars, LoopStack, TopLevelLookup, LoopFrame, enum_reg_lookup, struct_reg_lookup, fn_ret_lookup, toplevel_lookup, loops_top, translate_param_type, new_bb, const_i64, const_i8, to_ptr, to_i64, get_fn, call_1, call_2, call_3, call_4, call_named_1, cg_malloc}\n\n// ── Direct C extern declarations ──\n//\n// The bootstrap codegen calls a small set of LLVM-C-API wrappers\n// (the `forge_llvm_*` symbols exposed by the @std.llvm package's\n// native library) plus a handful of libc helpers. We declare them\n// directly as `extern fn` so the bootstrap source has no\n// dependence on the host's package namespace dispatch — it just\n// calls C symbols.\n//\n// We keep the local helper names matching the old `llvm.X` shape\n// (e.g. `bs_llvm_context_create`) so the rest of this file reads\n// the same as before; the helpers are thin wrappers over the\n// underlying C symbols.\n\n\n\n\n\n\n\n\n// ── Public API ──\n\nexport type CodegenResult = {\n    had_error: bool,\n    error_message: string,\n}\n\n// Ctx, EmitResult, StmtResult, ok_emit, err_emit, ok_stmt,\n// err_stmt, err_stmt_from_expr, null_ptr_val, advance_field_list,\n// field_type_at, strip_enum_prefix all moved to core/cg.fg as\n// part of Phase 4b of the feature migration. They're imported via\n// the `use core.cg.{...}` line near the top of this file.\n\n// StructReg, CG_STRUCTS, struct_reg_lookup, struct_reg_extend,\n// EnumReg, CG_ENUMS, enum_reg_lookup, enum_reg_extend,\n// translate_param_type, strip_struct_prefix all moved to core/cg.fg.\n\n// Function return type registry. The bootstrap MVP doesn't carry\n// All registries live in core/cg.fg as fields on the Ctx struct.\n// Zero mutable globals.\n\n\n// EnumReg, CG_ENUMS, enum_reg_lookup, enum_reg_extend — see core/cg.fg note above.\n\nexport fn compile_program(stmts: StmtList, output_path: string) -> CodegenResult {\n    let lc = forge_llvm_context_create()\n    let m = forge_llvm_module_create(\"bootstrap\", lc)\n    let builder = forge_llvm_create_builder(lc)\n\n    let i64t = forge_llvm_int64_type(lc)\n    let i1t = forge_llvm_int1_type(lc)\n    let pt = forge_llvm_pointer_type(lc)\n\n    // Declare libc helpers we lower string ops onto.\n    //   puts(ptr) -> i32        — for println(str)\n    //   strlen(ptr) -> i64\n    //   malloc(i64) -> ptr\n    //   memcpy(ptr, ptr, i64) -> ptr\n    let puts_param_arr = forge_llvm_type_array_new(1)\n    forge_llvm_type_array_set(puts_param_arr, 0, pt)\n    let puts_type = forge_llvm_function_type(forge_llvm_int32_type(lc), puts_param_arr, 1, 0)\n    forge_llvm_type_array_free(puts_param_arr)\n    forge_llvm_add_function(m, \"puts\", puts_type)\n\n    let strlen_param_arr = forge_llvm_type_array_new(1)\n    forge_llvm_type_array_set(strlen_param_arr, 0, pt)\n    let strlen_type = forge_llvm_function_type(i64t, strlen_param_arr, 1, 0)\n    forge_llvm_type_array_free(strlen_param_arr)\n    forge_llvm_add_function(m, \"strlen\", strlen_type)\n\n    let malloc_param_arr = forge_llvm_type_array_new(1)\n    forge_llvm_type_array_set(malloc_param_arr, 0, i64t)\n    let malloc_type = forge_llvm_function_type(pt, malloc_param_arr, 1, 0)\n    forge_llvm_type_array_free(malloc_param_arr)\n    forge_llvm_add_function(m, \"malloc\", malloc_type)\n\n    let memcpy_param_arr = forge_llvm_type_array_new(3)\n    forge_llvm_type_array_set(memcpy_param_arr, 0, pt)\n    forge_llvm_type_array_set(memcpy_param_arr, 1, pt)\n    forge_llvm_type_array_set(memcpy_param_arr, 2, i64t)\n    let memcpy_type = forge_llvm_function_type(pt, memcpy_param_arr, 3, 0)\n    forge_llvm_type_array_free(memcpy_param_arr)\n    forge_llvm_add_function(m, \"memcpy\", memcpy_type)\n\n    let strcmp_param_arr = forge_llvm_type_array_new(2)\n    forge_llvm_type_array_set(strcmp_param_arr, 0, pt)\n    forge_llvm_type_array_set(strcmp_param_arr, 1, pt)\n    let strcmp_type = forge_llvm_function_type(forge_llvm_int32_type(lc), strcmp_param_arr, 2, 0)\n    forge_llvm_type_array_free(strcmp_param_arr)\n    forge_llvm_add_function(m, \"strcmp\", strcmp_type)\n\n    // snprintf(buf, size, fmt, ...) declared as variadic for the\n    // string() builtin's int → str conversion.\n    let snprintf_param_arr = forge_llvm_type_array_new(3)\n    forge_llvm_type_array_set(snprintf_param_arr, 0, pt)\n    forge_llvm_type_array_set(snprintf_param_arr, 1, i64t)\n    forge_llvm_type_array_set(snprintf_param_arr, 2, pt)\n    let snprintf_type = forge_llvm_function_type(forge_llvm_int32_type(lc), snprintf_param_arr, 3, 1)\n    forge_llvm_type_array_free(snprintf_param_arr)\n    forge_llvm_add_function(m, \"snprintf\", snprintf_type)\n\n    // atoi(str) -> i32 for the int() builtin.\n    let atoi_param_arr = forge_llvm_type_array_new(1)\n    forge_llvm_type_array_set(atoi_param_arr, 0, pt)\n    let atoi_type = forge_llvm_function_type(forge_llvm_int32_type(lc), atoi_param_arr, 1, 0)\n    forge_llvm_type_array_free(atoi_param_arr)\n    forge_llvm_add_function(m, \"atoi\", atoi_type)\n\n    // exit(int) for process.exit\n    let exit_param_arr = forge_llvm_type_array_new(1)\n    forge_llvm_type_array_set(exit_param_arr, 0, forge_llvm_int32_type(lc))\n    let exit_type = forge_llvm_function_type(forge_llvm_void_type(lc), exit_param_arr, 1, 0)\n    forge_llvm_type_array_free(exit_param_arr)\n    forge_llvm_add_function(m, \"exit\", exit_type)\n\n    // Build the per-compile registries by walking the AST once.\n    // These are threaded through Ctx as immutable data — no\n    // mutable globals.\n    let structs = declare_structs(lc, i64t, stmts, StructReg.End)\n    let enums = declare_enums(lc, i64t, stmts, EnumReg.End)\n    let top_level_vars = declare_globals(m, lc, i64t, structs, enums, stmts, TopLevelVars.End)\n    let fn_rets = declare_functions(m, lc, i64t, structs, enums, stmts, FnRetTypes.End)\n\n    // Synthesize a wrapper function for the top-level non-function\n    // statements. If the source already defines its own `fn main`,\n    // use a different name (`__bs_top_level`) so we don't collide\n    // — the user's main becomes the program entry point. Otherwise\n    // we name the wrapper `main` so it serves as the entry.\n    let user_main = forge_llvm_get_named_function(m, \"main\")\n    let main_name = if user_main == null { \"main\" } else { \"__bs_top_level\" }\n    let main_params = forge_llvm_type_array_new(0)\n    let main_type = forge_llvm_function_type(i64t, main_params, 0, 0)\n    forge_llvm_type_array_free(main_params)\n    let main_fn = forge_llvm_add_function(m, main_name, main_type)\n\n    let entry = forge_llvm_append_basic_block(lc, main_fn, \"entry\")\n    forge_llvm_position_at_end(builder, entry)\n\n    let ctx = Ctx {\n        lc,\n        module: m,\n        builder,\n        current_fn: main_fn,\n        i64_type: i64t,\n        i1_type: i1t,\n        ptr_type: pt,\n        structs,\n        enums,\n        fn_rets,\n        top_level_vars,\n        loops: LoopStack.End,\n    }\n\n    // Pass 2: emit each user-defined function's body, then emit\n    // every non-function top-level statement into main.\n    let body_result = emit_function_bodies(ctx, stmts)\n    if body_result.had_error {\n        forge_llvm_dispose_builder(builder)\n        forge_llvm_module_dispose(m)\n        forge_llvm_context_dispose(ctx.lc)\n        return CodegenResult { had_error: true, error_message: body_result.error_message }\n    }\n\n    // After emitting any function bodies, the builder may be sitting\n    // in a function-body block. Reposition it back at main's entry\n    // before emitting top-level statements.\n    forge_llvm_position_at_end(builder, entry)\n    let initial: VarEnv = VarEnv.End\n    let result = emit_top_level(ctx, initial, stmts)\n    if result.had_error {\n        forge_llvm_dispose_builder(builder)\n        forge_llvm_module_dispose(m)\n        forge_llvm_context_dispose(ctx.lc)\n        return CodegenResult { had_error: true, error_message: result.error_message }\n    }\n\n    // Default return 0 if the program didn't end in an explicit return\n    if forge_llvm_block_has_terminator(builder) == 0 {\n        forge_llvm_build_ret(builder, forge_llvm_const_int(i64t, 0, 0))\n    }\n\n    // Verify\n    let verify = forge_llvm_verify_module_print(m)\n    if verify != 0 {\n        forge_llvm_dispose_builder(builder)\n        forge_llvm_module_dispose(m)\n        forge_llvm_context_dispose(ctx.lc)\n        return CodegenResult { had_error: true, error_message: \"codegen error: LLVM module verification failed\" }\n    }\n\n    let write_result = forge_llvm_print_module_to_file(m, output_path)\n\n    forge_llvm_dispose_builder(builder)\n    forge_llvm_module_dispose(m)\n    forge_llvm_context_dispose(ctx.lc)\n\n    if write_result != 0 {\n        return CodegenResult { had_error: true, error_message: \"codegen error: failed to write IR to \" + output_path }\n    }\n\n    CodegenResult { had_error: false, error_message: \"\" }\n}\n\n// ── Helpers ──\n\n// EmitResult, StmtResult, and the ok_*/err_* helpers moved to\n// core/ctx.fg. See note above the deleted Ctx definition.\n\n// ── Struct declaration pass ──\n\nfn declare_structs(ctx: ptr, i64t: ptr, stmts: StmtList, reg: StructReg) -> StructReg {\n    match stmts {\n        .End -> reg\n        .Node(stmt, next) -> {\n            let updated = match stmt {\n                .TypeDecl(name, fields) -> {\n                    let count = field_list_length(fields)\n                    let field_arr = forge_llvm_type_array_new(count)\n                    fill_i64_param_array(field_arr, i64t, 0, count)\n                    let st = forge_llvm_struct_create_named(ctx, name)\n                    forge_llvm_struct_set_body(st, field_arr, count, 0)\n                    forge_llvm_type_array_free(field_arr)\n                    StructReg.Node(name, fields, reg)\n                }\n                _ -> reg\n            }\n            declare_structs(ctx, i64t, next, updated)\n        }\n    }\n}\n\n// ── Global declaration pass ──\n//\n// Top-level `let` and `mut` declarations become module-level LLVM\n// globals (i64). Their initializers are deferred to a synthetic\n// `bs_init_globals` function called from `main` at startup; the\n// declaration pass only allocates the global slot itself, since\n// initializers may reference user functions and structs that\n// haven't been emitted yet.\n\nfn declare_globals(m: ptr, ctx: ptr, i64t: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: TopLevelVars) -> TopLevelVars {\n    match stmts {\n        .End -> reg\n        .Node(stmt, next) -> {\n            let updated = match stmt {\n                .Let(name, ty, _) -> {\n                    let g = forge_llvm_add_global(m, i64t, name)\n                    forge_llvm_set_initializer(g, forge_llvm_const_int(i64t, 0, 0))\n                    TopLevelVars.Node(name, g, translate_param_type(structs, enums, ty), reg)\n                }\n                .Mut(name, ty, _) -> {\n                    let g = forge_llvm_add_global(m, i64t, name)\n                    forge_llvm_set_initializer(g, forge_llvm_const_int(i64t, 0, 0))\n                    TopLevelVars.Node(name, g, translate_param_type(structs, enums, ty), reg)\n                }\n                _ -> reg\n            }\n            declare_globals(m, ctx, i64t, structs, enums, next, updated)\n        }\n    }\n}\n\n// ── Enum declaration pass ──\n\nfn declare_enums(ctx: ptr, i64t: ptr, stmts: StmtList, reg: EnumReg) -> EnumReg {\n    match stmts {\n        .End -> reg\n        .Node(stmt, next) -> {\n            let updated = match stmt {\n                .EnumDecl(name, variants) -> {\n                    let max_fields = variant_max_payload(variants)\n                    let total_fields = max_fields + 1\n                    let field_arr = forge_llvm_type_array_new(total_fields)\n                    forge_llvm_type_array_set(field_arr, 0, forge_llvm_int8_type(ctx))\n                    fill_i64_param_array_offset(field_arr, i64t, 1, max_fields)\n                    let st = forge_llvm_struct_create_named(ctx, name)\n                    forge_llvm_struct_set_body(st, field_arr, total_fields, 0)\n                    forge_llvm_type_array_free(field_arr)\n                    EnumReg.Node(name, variants, reg)\n                }\n                _ -> reg\n            }\n            declare_enums(ctx, i64t, next, updated)\n        }\n    }\n}\n\nfn fill_i64_param_array_offset(arr: ptr, i64t: ptr, base: int, count: int) {\n    if count <= 0 {\n        return\n    }\n    forge_llvm_type_array_set(arr, base, i64t)\n    fill_i64_param_array_offset(arr, i64t, base + 1, count - 1)\n}\n\n// ── Function declaration pass ──\n\nfn declare_functions(m: ptr, ctx: ptr, i64t: ptr, structs: StructReg, enums: EnumReg, stmts: StmtList, reg: FnRetTypes) -> FnRetTypes {\n    match stmts {\n        .End -> reg\n        .Node(stmt, next) -> {\n            let updated = match stmt {\n                .Function(name, params, ret_ty, body) -> {\n                    let arity = param_list_length(params)\n                    let param_arr = forge_llvm_type_array_new(arity)\n                    fill_i64_param_array(param_arr, i64t, 0, arity)\n                    let fn_type = forge_llvm_function_type(i64t, param_arr, arity, 0)\n                    forge_llvm_type_array_free(param_arr)\n                    forge_llvm_add_function(m, name, fn_type)\n                    FnRetTypes.Node(name, translate_param_type(structs, enums, ret_ty), reg)\n                }\n                .ExternFn(name, params, ret_ty) -> {\n                    let arity = param_list_length(params)\n                    let param_arr = forge_llvm_type_array_new(arity)\n                    fill_i64_param_array(param_arr, i64t, 0, arity)\n                    let fn_type = forge_llvm_function_type(i64t, param_arr, arity, 0)\n                    forge_llvm_type_array_free(param_arr)\n                    forge_llvm_add_function(m, name, fn_type)\n                    FnRetTypes.Node(name, translate_param_type(structs, enums, ret_ty), reg)\n                }\n                .Impl(_, methods) -> declare_functions(m, ctx, i64t, structs, enums, methods, reg)\n                _ -> reg\n            }\n            declare_functions(m, ctx, i64t, structs, enums, next, updated)\n        }\n    }\n}\n\nfn fill_i64_param_array(arr: ptr, i64t: ptr, idx: int, count: int) {\n    if idx >= count {\n        return\n    }\n    forge_llvm_type_array_set(arr, idx, i64t)\n    fill_i64_param_array(arr, i64t, idx + 1, count)\n}\n\n// ── Function body pass ──\n\n// emit_function_bodies, emit_function_body, bind_params_inline → features/fn_decl/codegen.fg\n\n// translate_param_type — moved to core/ctx.fg.\n\n// ── Top-level pass (skips function decls) ──\n\n// TopLevelResult carries an updated Ctx so emit_top_level_init\n// can thread updated top_level_vars forward without changing the\n// StmtResult type (which would require updating ~50 call sites).\ntype TopLevelResult = {\n    ctx: Ctx,\n    env: VarEnv,\n    had_error: bool,\n    error_message: string,\n}\n\nfn emit_top_level(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {\n    match stmts {\n        .End -> ok_stmt(env)\n        .Node(stmt, next) -> {\n            match stmt {\n                .Function(_, _, _, _) -> emit_top_level(ctx, env, next)\n                .Let(name, _, init) -> {\n                    let result = emit_top_level_init(ctx, env, name, init)\n                    if result.had_error {\n                        return err_stmt(result.error_message)\n                    }\n                    emit_top_level(result.ctx, result.env, next)\n                }\n                .Mut(name, _, init) -> {\n                    let result = emit_top_level_init(ctx, env, name, init)\n                    if result.had_error {\n                        return err_stmt(result.error_message)\n                    }\n                    emit_top_level(result.ctx, result.env, next)\n                }\n                _ -> {\n                    let result = emit_stmt(ctx, env, stmt)\n                    if result.had_error {\n                        return result\n                    }\n                    emit_top_level(ctx, result.env, next)\n                }\n            }\n        }\n    }\n}\n\nfn emit_top_level_init(ctx: Ctx, env: VarEnv, name: string, init: Expr) -> TopLevelResult {\n    let g = toplevel_lookup(ctx.top_level_vars, name)\n    if !g.found {\n        return TopLevelResult { ctx, env, had_error: true, error_message: \"codegen error: global `\" + name + \"` not declared\" }\n    }\n    let r = emit_expr(ctx, env, init)\n    if r.had_error {\n        return TopLevelResult { ctx, env, had_error: true, error_message: r.error_message }\n    }\n    forge_llvm_build_store(ctx.builder, r.value, g.llvm_global)\n    let updated_top = TopLevelVars.Node(name, g.llvm_global, r.ty, ctx.top_level_vars)\n    let updated_cg = ctx_with_top_level(ctx, updated_top)\n    TopLevelResult { ctx: updated_cg, env, had_error: false, error_message: \"\" }\n}\n\n// ── Statement emission ──\n\nfn emit_stmt_list(ctx: Ctx, env: VarEnv, stmts: StmtList) -> StmtResult {\n    match stmts {\n        .End -> ok_stmt(env)\n        .Node(stmt, next) -> {\n            let result = emit_stmt(ctx, env, stmt)\n            if result.had_error {\n                return result\n            }\n            emit_stmt_list(ctx, result.env, next)\n        }\n    }\n}\n\nexport fn emit_stmt(ctx: Ctx, env: VarEnv, stmt: Stmt) -> StmtResult {\n    match stmt {\n        .Expr(expr) -> {\n            let r = emit_expr(ctx, env, expr)\n            if r.had_error {\n                return err_stmt_from_expr(r)\n            }\n            ok_stmt(env)\n        }\n        .Ret(value) -> {\n            let r = emit_expr(ctx, env, value)\n            if r.had_error {\n                return err_stmt_from_expr(r)\n            }\n            forge_llvm_build_ret(ctx.builder, r.value)\n            ok_stmt(env)\n        }\n        .RetEmpty -> {\n            forge_llvm_build_ret(ctx.builder, const_i64(ctx, 0))\n            ok_stmt(env)\n        }\n        .Let(name, _, initializer) -> emit_var_decl(ctx, env, name, initializer)\n        .Mut(name, _, initializer) -> emit_var_decl(ctx, env, name, initializer)\n        .Block(body) -> {\n            let inner = emit_stmt_list(ctx, env, body)\n            if inner.had_error {\n                return inner\n            }\n            // Block exits restore the outer scope.\n            ok_stmt(env)\n        }\n        .If(condition, then_branch, else_branch) -> emit_if(ctx, env, condition, then_branch, else_branch)\n        .While(condition, body) -> emit_while(ctx, env, condition, body)\n        .TypeDecl(_, _) -> ok_stmt(env)\n        .EnumDecl(_, _) -> ok_stmt(env)\n        .Match(subject, arms) -> emit_match(ctx, env, subject, arms)\n        .Impl(_, _) -> ok_stmt(env)\n        .NoOp -> ok_stmt(env)\n        .ExternFn(_, _, _) -> ok_stmt(env)\n        .Break -> {\n            let frame = loops_top(ctx.loops)\n            if !frame.found {\n                return err_stmt(\"codegen error: break outside loop\")\n            }\n            forge_llvm_build_br(ctx.builder, frame.exit_bb)\n            ok_stmt(env)\n        }\n        .Continue -> {\n            let frame = loops_top(ctx.loops)\n            if !frame.found {\n                return err_stmt(\"codegen error: continue outside loop\")\n            }\n            forge_llvm_build_br(ctx.builder, frame.cond_bb)\n            ok_stmt(env)\n        }\n        _ -> err_stmt(\"codegen error: unsupported statement type\")\n    }\n}\n\n// emit_var_decl → features/let_stmt/codegen.fg\n// emit_if      → features/if_stmt/codegen.fg\n// emit_while   → features/while_stmt/codegen.fg\n\n// ── Expression emission ──\n\nexport fn emit_expr(ctx: Ctx, env: VarEnv, expr: Expr) -> EmitResult {\n    match expr {\n        .Number(text) -> {\n            let value = int(text)\n            ok_emit(const_i64(ctx, value))\n        }\n        .Bool(text) -> {\n            if text == \"true\" {\n                return ok_emit(const_i64(ctx, 1))\n            }\n            ok_emit(const_i64(ctx, 0))\n        }\n        .Null -> ok_emit(const_i64(ctx, 0))\n        .String(text) -> {\n            let inner = strip_quotes(text)\n            let str_ptr = forge_llvm_build_global_string_ptr(ctx.builder, inner, \".str\")\n            ok_emit_str(to_i64(ctx, str_ptr, \"str_i64\"))\n        }\n        .Grouping(inner) -> emit_expr(ctx, env, inner)\n        .Unary(operator, right) -> emit_unary(ctx, env, operator, right)\n        .Binary(left, operator, right) -> emit_binary(ctx, env, left, operator, right)\n        .Logical(left, operator, right) -> emit_binary(ctx, env, left, operator, right)\n        .Ident(name) -> {\n            let local = env_lookup(env, name)\n            if local.found {\n                let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, local.alloca, name)\n                return EmitResult { value: loaded, ty: local.ty, had_error: false, error_message: \"\" }\n            }\n            let g = toplevel_lookup(ctx.top_level_vars, name)\n            if g.found {\n                let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, g.llvm_global, name)\n                return EmitResult { value: loaded, ty: g.ty, had_error: false, error_message: \"\" }\n            }\n            err_emit(\"undefined variable `\" + name + \"`\")\n        }\n        .Assign(name, value) -> {\n            let r = emit_expr(ctx, env, value)\n            if r.had_error {\n                return r\n            }\n            let local = env_lookup(env, name)\n            if local.found {\n                forge_llvm_build_store(ctx.builder, r.value, local.alloca)\n                return EmitResult { value: r.value, ty: local.ty, had_error: false, error_message: \"\" }\n            }\n            let g = toplevel_lookup(ctx.top_level_vars, name)\n            if g.found {\n                forge_llvm_build_store(ctx.builder, r.value, g.llvm_global)\n                return EmitResult { value: r.value, ty: g.ty, had_error: false, error_message: \"\" }\n            }\n            err_emit(\"assignment to undefined variable `\" + name + \"`\")\n        }\n        .Call(callee, args) -> emit_call(ctx, env, callee, args)\n        .StructLit(name, inits) -> emit_struct_lit(ctx, env, name, inits)\n        .FieldAccess(obj, field) -> emit_field_access(ctx, env, obj, field)\n        .EnumCtor(type_name, variant, args) -> emit_enum_ctor(ctx, env, type_name, variant, args)\n        .Index(obj, idx) -> emit_index(ctx, env, obj, idx)\n        .Block(body) -> emit_block_expr(ctx, env, body)\n        .MatchExpr(subject, arms) -> emit_match_expr(ctx, env, subject, arms)\n        .FieldAssign(obj, field, value) -> emit_field_assign(ctx, env, obj, field, value)\n        .IfExpr(c, t, e) -> emit_if_expr(ctx, env, c, t, e)\n        _ -> err_emit(\"unsupported expression type\")\n    }\n}\n\nfn emit_if_expr(ctx: Ctx, env: VarEnv, condition: Expr, then_branch: Expr, else_branch: Expr) -> EmitResult {\n    let cond = emit_expr(ctx, env, condition)\n    if cond.had_error {\n        return cond\n    }\n    let cond_i1 = forge_llvm_build_icmp(ctx.builder, 33, cond.value, const_i64(ctx, 0), \"ife_cond\")\n    let then_bb = new_bb(ctx, \"ife_then\")\n    let else_bb = new_bb(ctx, \"ife_else\")\n    let merge_bb = new_bb(ctx, \"ife_end\")\n    let result_slot = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, \"ife_result\")\n    forge_llvm_build_store(ctx.builder, const_i64(ctx, 0), result_slot)\n    forge_llvm_build_cond_br(ctx.builder, cond_i1, then_bb, else_bb)\n\n    forge_llvm_position_at_end(ctx.builder, then_bb)\n    let t = emit_expr(ctx, env, then_branch)\n    if t.had_error {\n        return t\n    }\n    if forge_llvm_block_has_terminator(ctx.builder) == 0 {\n        forge_llvm_build_store(ctx.builder, t.value, result_slot)\n        forge_llvm_build_br(ctx.builder, merge_bb)\n    }\n\n    forge_llvm_position_at_end(ctx.builder, else_bb)\n    let e = emit_expr(ctx, env, else_branch)\n    if e.had_error {\n        return e\n    }\n    if forge_llvm_block_has_terminator(ctx.builder) == 0 {\n        forge_llvm_build_store(ctx.builder, e.value, result_slot)\n        forge_llvm_build_br(ctx.builder, merge_bb)\n    }\n\n    forge_llvm_position_at_end(ctx.builder, merge_bb)\n    let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, result_slot, \"ife_val\")\n    ok_emit(loaded)\n}\n\nfn emit_field_assign(ctx: Ctx, env: VarEnv, obj: Expr, field: string, value: Expr) -> EmitResult {\n    let r = emit_expr(ctx, env, obj)\n    if r.had_error {\n        return r\n    }\n    let struct_name = strip_struct_prefix(r.ty)\n    if struct_name == \"\" {\n        return err_emit(\"field assignment on non-struct value (ty=\" + r.ty + \")\")\n    }\n    let lookup = struct_reg_lookup(ctx.structs, struct_name)\n    if !lookup.found {\n        return err_emit(\"unknown struct `\" + struct_name + \"`\")\n    }\n    let idx = field_index_of(lookup.fields, field)\n    if idx < 0 {\n        return err_emit(\"unknown field `\" + field + \"` on struct `\" + struct_name + \"`\")\n    }\n    let st_ty = forge_llvm_get_type_by_name(ctx.lc, struct_name)\n    let obj_ptr = to_ptr(ctx, r.value, \"fa_ptr\")\n    let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, obj_ptr, idx, \"fa_fld\")\n    let v = emit_expr(ctx, env, value)\n    if v.had_error {\n        return v\n    }\n    forge_llvm_build_store(ctx.builder, v.value, gep)\n    ok_emit(v.value)\n}\n\nfn emit_block_expr(ctx: Ctx, env: VarEnv, stmts: StmtList) -> EmitResult {\n    // A block expression's value is the value of the LAST\n    // statement, if that statement is a `Stmt.Expr`. Anything\n    // else (return, let, while, ...) yields i64 0. Each non-last\n    // statement is executed for its side effects.\n    emit_block_loop(ctx, env, stmts, const_i64(ctx, 0), \"i64\")\n}\n\n// A statement in tail position of a block expression must yield a\n// value, even when the parser modeled it as a Stmt rather than an\n// Expr. This dispatches each kind of \"value-bearing\" statement to the\n// matching expression-emission helper, recursing through nested\n// blocks/ifs as needed. Anything that has no value (let/while/return)\n// falls through to emit_stmt and the caller's default last_val.\nfn emit_stmt_as_value(ctx: Ctx, env: VarEnv, stmt: Stmt, last_val: ptr, last_ty: string) -> EmitResult {\n    match stmt {\n        .Expr(e) -> emit_expr(ctx, env, e)\n        .Block(body) -> emit_block_expr(ctx, env, body)\n        .Match(subject, arms) -> emit_match_expr(ctx, env, subject, arms)\n        .If(condition, then_branch, else_branch) -> emit_stmt_if_as_value(ctx, env, condition, then_branch, else_branch)\n        _ -> {\n            let s = emit_stmt(ctx, env, stmt)\n            if s.had_error {\n                return err_emit(s.error_message)\n            }\n            EmitResult { value: last_val, ty: last_ty, had_error: false, error_message: \"\" }\n        }\n    }\n}\n\n// Mirror of emit_if_expr for the case where the if was parsed as a\n// statement (Stmt.If with Stmt branches) but appears in tail position\n// of a block expression. We need to phi the branch values back out,\n// recursing into emit_stmt_as_value so nested blocks/matches/ifs in\n// the branches also propagate their values.\nfn emit_stmt_if_as_value(ctx: Ctx, env: VarEnv, condition: Expr, then_branch: Stmt, else_branch: Stmt?) -> EmitResult {\n    let cond = emit_expr(ctx, env, condition)\n    if cond.had_error {\n        return cond\n    }\n    let cond_i1 = forge_llvm_build_icmp(ctx.builder, 33, cond.value, const_i64(ctx, 0), \"sif_cond\")\n    let then_bb = new_bb(ctx, \"sif_then\")\n    let else_bb = new_bb(ctx, \"sif_else\")\n    let merge_bb = new_bb(ctx, \"sif_end\")\n    let result_slot = forge_llvm_build_alloca(ctx.builder, ctx.i64_type, \"sif_result\")\n    forge_llvm_build_store(ctx.builder, const_i64(ctx, 0), result_slot)\n    forge_llvm_build_cond_br(ctx.builder, cond_i1, then_bb, else_bb)\n\n    forge_llvm_position_at_end(ctx.builder, then_bb)\n    let zero = const_i64(ctx, 0)\n    let t = emit_stmt_as_value(ctx, env, then_branch, zero, \"i64\")\n    if t.had_error {\n        return t\n    }\n    if forge_llvm_block_has_terminator(ctx.builder) == 0 {\n        forge_llvm_build_store(ctx.builder, t.value, result_slot)\n        forge_llvm_build_br(ctx.builder, merge_bb)\n    }\n\n    forge_llvm_position_at_end(ctx.builder, else_bb)\n    if else_branch != null {\n        let e = emit_stmt_as_value(ctx, env, else_branch!, zero, \"i64\")\n        if e.had_error {\n            return e\n        }\n        if forge_llvm_block_has_terminator(ctx.builder) == 0 {\n            forge_llvm_build_store(ctx.builder, e.value, result_slot)\n            forge_llvm_build_br(ctx.builder, merge_bb)\n        }\n    } else {\n        forge_llvm_build_br(ctx.builder, merge_bb)\n    }\n\n    forge_llvm_position_at_end(ctx.builder, merge_bb)\n    let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, result_slot, \"sif_val\")\n    EmitResult { value: loaded, ty: t.ty, had_error: false, error_message: \"\" }\n}\n\nexport fn emit_block_loop(ctx: Ctx, env: VarEnv, stmts: StmtList, last_val: ptr, last_ty: string) -> EmitResult {\n    match stmts {\n        .End -> EmitResult { value: last_val, ty: last_ty, had_error: false, error_message: \"\" }\n        .Node(stmt, next) -> {\n            match next {\n                .End -> emit_stmt_as_value(ctx, env, stmt, last_val, last_ty)\n                _ -> {\n                    let s = emit_stmt(ctx, env, stmt)\n                    if s.had_error {\n                        return err_emit(s.error_message)\n                    }\n                    emit_block_loop(ctx, s.env, next, last_val, last_ty)\n                }\n            }\n        }\n    }\n}\n\n// emit_match_expr, emit_match_expr_arms, emit_match, emit_match_arms,\n// bind_pattern_payload, bind_pattern_payload_loop all moved to\n// features/match/codegen.fg. The dispatchers below call emit_match\n// and emit_match_expr by name — Forge resolves them globally across\n// the module tree, same as it does for cross-file impl blocks.\n\nfn emit_index(ctx: Ctx, env: VarEnv, obj: Expr, idx: Expr) -> EmitResult {\n    let r = emit_expr(ctx, env, obj)\n    if r.had_error {\n        return r\n    }\n    if r.ty != \"str\" && r.ty != \"string\" {\n        return err_emit(\"indexing on non-string value (ty=\" + r.ty + \")\")\n    }\n    let i_r = emit_expr(ctx, env, idx)\n    if i_r.had_error {\n        return i_r\n    }\n    // Allocate a 2-byte buffer (1 char + nul), copy the byte at\n    // src+i, set buf[1]=0. Returns a fresh str.\n    let src_int = r.value\n    let off_int = forge_llvm_build_add(ctx.builder, src_int, i_r.value, \"idx_off_int\")\n    let off_ptr = to_ptr(ctx, off_int, \"idx_off\")\n    let byte = forge_llvm_build_load(ctx.builder, forge_llvm_int8_type(ctx.lc), off_ptr, \"idx_byte\")\n    let buf = cg_malloc(ctx, const_i64(ctx, 2))\n    forge_llvm_build_store(ctx.builder, byte, buf)\n    // buf[1] = 0\n    let buf_int = to_i64(ctx, buf, \"idx_buf_int\")\n    let one = const_i64(ctx, 1)\n    let nul_int = forge_llvm_build_add(ctx.builder, buf_int, one, \"idx_nul_int\")\n    let nul_ptr = to_ptr(ctx, nul_int, \"idx_nul\")\n    forge_llvm_build_store(ctx.builder, const_i8(ctx, 0), nul_ptr)\n    let result_i64 = to_i64(ctx, buf, \"idx_result\")\n    ok_emit_str(result_i64)\n}\n\n// emit_struct_lit, malloc_struct_bytes, fill_struct_fields → features/struct_decl/codegen.fg\n\nfn emit_field_access(ctx: Ctx, env: VarEnv, obj: Expr, field: string) -> EmitResult {\n    // Special case: bare `EnumName.Variant` (zero-arg enum\n    // constructor). The parser models this as\n    // FieldAccess(Ident(EnumName), Variant).\n    match obj {\n        .Ident(head) -> {\n            let enum_l = enum_reg_lookup(ctx.enums, head)\n            if enum_l.found {\n                return emit_enum_ctor(ctx, env, head, field, ExprList.End)\n            }\n        }\n        _ -> {}\n    }\n\n    let r = emit_expr(ctx, env, obj)\n    if r.had_error {\n        return r\n    }\n    // String property access — `s.length` is a libc strlen.\n    if r.ty == \"str\" && field == \"length\" {\n        let str_ptr = to_ptr(ctx, r.value, \"len_arg\")\n        let len = call_1(ctx, get_fn(ctx, \"strlen\"), str_ptr, \"strlen_call\")\n        return ok_emit(len)\n    }\n    // The object's ty tag tells us which struct it is.\n    let struct_name = strip_struct_prefix(r.ty)\n    if struct_name == \"\" {\n        return err_emit(\"field access on non-struct value (ty=\" + r.ty + \", field=\" + field + \")\")\n    }\n    let lookup = struct_reg_lookup(ctx.structs, struct_name)\n    if !lookup.found {\n        return err_emit(\"unknown struct `\" + struct_name + \"`\")\n    }\n    let idx = field_index_of(lookup.fields, field)\n    if idx < 0 {\n        return err_emit(\"unknown field `\" + field + \"` on struct `\" + struct_name + \"`\")\n    }\n    let st_ty = forge_llvm_get_type_by_name(ctx.lc, struct_name)\n    let obj_ptr = to_ptr(ctx, r.value, \"obj_ptr\")\n    let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, obj_ptr, idx, \"fld_ptr\")\n    let loaded = forge_llvm_build_load(ctx.builder, ctx.i64_type, gep, field)\n    let field_ty = translate_param_type(ctx.structs, ctx.enums, field_type_of(lookup.fields, field))\n    EmitResult { value: loaded, ty: field_ty, had_error: false, error_message: \"\" }\n}\n\n// emit_enum_ctor, malloc_enum_bytes, fill_enum_payload → features/enum_decl/codegen.fg\n\n\n// emit_match, emit_match_arms, bind_pattern_payload,\n// bind_pattern_payload_loop — see features/match/codegen.fg.\n\n// advance_field_list, field_type_at, strip_enum_prefix moved to\n// core/ctx.fg.\n\n// \"struct:Name\" → \"Name\"; anything else → \"\".\n// strip_struct_prefix — moved to core/ctx.fg.\n\nfn emit_call(ctx: Ctx, env: VarEnv, callee: Expr, args: ExprList) -> EmitResult {\n    // Destructure callee exactly once.\n    match callee {\n        .Ident(name) -> emit_call_named(ctx, env, name, args)\n        .FieldAccess(obj, method) -> emit_method_call(ctx, env, obj, method, args)\n        _ -> err_emit(\"only direct function calls are supported\")\n    }\n}\n\nfn emit_method_call(ctx: Ctx, env: VarEnv, obj: Expr, method: string, args: ExprList) -> EmitResult {\n    // Special-case `.length` and `.substring` on strings — these are\n    // emitted via libc strlen / a custom substring helper rather than\n    // dispatched as methods.\n    let r = emit_expr(ctx, env, obj)\n    if r.had_error {\n        return r\n    }\n    if r.ty == \"str\" {\n        if method == \"length\" {\n            let str_ptr = to_ptr(ctx, r.value, \"len_arg\")\n            let len = call_1(ctx, get_fn(ctx, \"strlen\"), str_ptr, \"strlen_call\")\n            return ok_emit(len)\n        }\n        if method == \"substring\" {\n            return emit_substring(ctx, env, r.value, args)\n        }\n        return err_emit(\"string method `\" + method + \"` not implemented\")\n    }\n    // Otherwise: dispatch by type tag → `Type__method(obj, args)`.\n    let type_name = strip_struct_prefix(r.ty)\n    let enum_name = strip_enum_prefix(r.ty)\n    let owner = if type_name != \"\" {\n        type_name\n    } else {\n        enum_name\n    }\n    if owner == \"\" {\n        return err_emit(\"method call on non-struct/enum value (ty=\" + r.ty + \")\")\n    }\n    let mangled = owner + \"__\" + method\n    let fn_val = forge_llvm_get_named_function(ctx.module, mangled)\n    if fn_val == null {\n        return err_emit(\"undefined method `\" + owner + \".\" + method + \"`\")\n    }\n    // Build arg array with self prepended.\n    let extra_count = expr_list_length(args)\n    let arg_count = extra_count + 1\n    let arg_arr = forge_llvm_value_array_new(arg_count)\n    forge_llvm_value_array_set(arg_arr, 0, r.value)\n    let fill = fill_arg_array(ctx, env, arg_arr, args, 1)\n    if fill.had_error {\n        forge_llvm_value_array_free(arg_arr)\n        return fill\n    }\n    let param_arr = forge_llvm_type_array_new(arg_count)\n    fill_i64_param_array(param_arr, ctx.i64_type, 0, arg_count)\n    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arg_count, 0)\n    forge_llvm_type_array_free(param_arr)\n    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_val, arg_arr, arg_count, \"methcall\")\n    forge_llvm_value_array_free(arg_arr)\n    let ret_ty = fn_ret_lookup(ctx.fn_rets, mangled)\n    if ret_ty == \"\" {\n        return ok_emit(result)\n    }\n    EmitResult { value: result, ty: ret_ty, had_error: false, error_message: \"\" }\n}\n\nfn emit_call_named(ctx: Ctx, env: VarEnv, name: string, args: ExprList) -> EmitResult {\n    if name == \"println\" {\n        return emit_println(ctx, env, args)\n    }\n    if name == \"eprintln\" {\n        // Same as println for the MVP — go to stdout. Bootstrap\n        // source uses eprintln only for diagnostics.\n        return emit_println(ctx, env, args)\n    }\n    if name == \"string\" {\n        return emit_int_to_string(ctx, env, args)\n    }\n    if name == \"int\" {\n        return emit_string_to_int(ctx, env, args)\n    }\n    let fn_val = forge_llvm_get_named_function(ctx.module, name)\n    if fn_val == null {\n        return err_emit(\"undefined function `\" + name + \"`\")\n    }\n\n    let arg_count = expr_list_length(args)\n    let arg_arr = forge_llvm_value_array_new(arg_count)\n    let fill = fill_arg_array(ctx, env, arg_arr, args, 0)\n    if fill.had_error {\n        forge_llvm_value_array_free(arg_arr)\n        return fill\n    }\n    // All bootstrap functions have the same shape: (i64, i64, ...) -> i64.\n    let param_arr = forge_llvm_type_array_new(arg_count)\n    fill_i64_param_array(param_arr, ctx.i64_type, 0, arg_count)\n    let fn_type = forge_llvm_function_type(ctx.i64_type, param_arr, arg_count, 0)\n    forge_llvm_type_array_free(param_arr)\n\n    let result = forge_llvm_build_call(ctx.builder, fn_type, fn_val, arg_arr, arg_count, \"calltmp\")\n    forge_llvm_value_array_free(arg_arr)\n    let ret_ty = fn_ret_lookup(ctx.fn_rets, name)\n    if ret_ty == \"\" {\n        return ok_emit(result)\n    }\n    EmitResult { value: result, ty: ret_ty, had_error: false, error_message: \"\" }\n}\n\nfn emit_int_to_string(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {\n    // string(i64) → str via snprintf into a 32-byte malloc'd buffer.\n    match args {\n        .End -> err_emit(\"string() expects 1 arg\")\n        .Node(arg, _) -> {\n            let r = emit_expr(ctx, env, arg)\n            if r.had_error {\n                return r\n            }\n            // If the value is already a str, pass it through.\n            if r.ty == \"str\" {\n                return r\n            }\n            // malloc(32)\n            let buf = cg_malloc(ctx, const_i64(ctx, 32))\n            // snprintf(buf, 32, \"%lld\", value)\n            let fmt = forge_llvm_build_global_string_ptr(ctx.builder, \"%lld\", \".i2s_fmt\")\n            call_4(ctx, get_fn(ctx, \"snprintf\"), buf, const_i64(ctx, 32), fmt, r.value, \"\")\n            let result_i64 = to_i64(ctx, buf, \"i2s_result\")\n            ok_emit_str(result_i64)\n        }\n    }\n}\n\nfn emit_string_to_int(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {\n    // int(str) → i64 via libc atoi.\n    match args {\n        .End -> err_emit(\"int() expects 1 arg\")\n        .Node(arg, _) -> {\n            let r = emit_expr(ctx, env, arg)\n            if r.had_error {\n                return r\n            }\n            if r.ty != \"str\" {\n                // Already an int — pass through.\n                return r\n            }\n            let str_ptr = to_ptr(ctx, r.value, \"atoi_arg\")\n            let result32 = call_1(ctx, get_fn(ctx, \"atoi\"), str_ptr, \"atoi_call\")\n            // Sign-extend i32 → i64.\n            ok_emit(forge_llvm_build_sext(ctx.builder, result32, ctx.i64_type, \"atoi_ext\"))\n        }\n    }\n}\n\nfn emit_println(ctx: Ctx, env: VarEnv, args: ExprList) -> EmitResult {\n    // Special-case the most common shape: `println(\"literal\")`. We\n    // destructure straight to the inner string text in a single\n    // match — going through any extra binding clobbers the payload\n    // (host miscompilation, see TECH_DEBT.md #11).\n    let str_i64 = match args {\n        .Node(e, _) -> {\n            match e {\n                .String(text) -> {\n                    let inner = strip_quotes(text)\n                    let str_ptr = forge_llvm_build_global_string_ptr(ctx.builder, inner, \".str\")\n                    to_i64(ctx, str_ptr, \"str_i64\")\n                }\n                _ -> {\n                    let r = emit_expr(ctx, env, e)\n                    if r.had_error {\n                        return r\n                    }\n                    r.value\n                }\n            }\n        }\n        .End -> {\n            return err_emit(\"println expects 1 argument\")\n        }\n    }\n    let str_ptr2 = to_ptr(ctx, str_i64, \"str_ptr\")\n    call_1(ctx, get_fn(ctx, \"puts\"), str_ptr2, \"\")\n    ok_emit(const_i64(ctx, 0))\n}\n\nfn emit_concat(ctx: Ctx, lhs_i64: ptr, rhs_i64: ptr) -> EmitResult {\n    let lhs_ptr = to_ptr(ctx, lhs_i64, \"concat_l\")\n    let rhs_ptr = to_ptr(ctx, rhs_i64, \"concat_r\")\n\n    let strlen_fn = get_fn(ctx, \"strlen\")\n    let lhs_len = call_1(ctx, strlen_fn, lhs_ptr, \"lhs_len\")\n    let rhs_len = call_1(ctx, strlen_fn, rhs_ptr, \"rhs_len\")\n\n    let total = forge_llvm_build_add(ctx.builder, lhs_len, rhs_len, \"concat_total\")\n    let one = const_i64(ctx, 1)\n    let alloc_size = forge_llvm_build_add(ctx.builder, total, one, \"concat_size\")\n    let buf = cg_malloc(ctx, alloc_size)\n\n    let memcpy_fn = get_fn(ctx, \"memcpy\")\n    call_3(ctx, memcpy_fn, buf, lhs_ptr, lhs_len, \"\")\n\n    let buf_int = to_i64(ctx, buf, \"buf_int\")\n    let dst2_int = forge_llvm_build_add(ctx.builder, buf_int, lhs_len, \"dst2_int\")\n    let dst2 = to_ptr(ctx, dst2_int, \"dst2\")\n    let rhs_len_plus_1 = forge_llvm_build_add(ctx.builder, rhs_len, one, \"rhs_len_p1\")\n    call_3(ctx, memcpy_fn, dst2, rhs_ptr, rhs_len_plus_1, \"\")\n\n    ok_emit_str(to_i64(ctx, buf, \"concat_i64\"))\n}\n\nfn emit_substring(ctx: Ctx, env: VarEnv, str_i64: ptr, args: ExprList) -> EmitResult {\n    // Expect exactly two integer args: start and end (exclusive).\n    // Destructure exactly once — repeated `match args` corrupts\n    // the inner payloads (host-compiler issue).\n    match args {\n        .End -> err_emit(\"substring expects 2 args, got 0\")\n        .Node(start_arg, rest) -> {\n            match rest {\n                .End -> err_emit(\"substring expects 2 args, got 1\")\n                .Node(end_arg, _) -> emit_substring_inner(ctx, env, str_i64, start_arg, end_arg)\n            }\n        }\n    }\n}\n\nfn emit_substring_inner(ctx: Ctx, env: VarEnv, str_i64: ptr, start_arg: Expr, end_arg: Expr) -> EmitResult {\n    let start_r = emit_expr(ctx, env, start_arg)\n    if start_r.had_error {\n        return start_r\n    }\n    let end_r = emit_expr(ctx, env, end_arg)\n    if end_r.had_error {\n        return end_r\n    }\n    let str_ptr = to_ptr(ctx, str_i64, \"sub_src\")\n    let len = forge_llvm_build_sub(ctx.builder, end_r.value, start_r.value, \"sub_len\")\n    let one = const_i64(ctx, 1)\n    let alloc_size = forge_llvm_build_add(ctx.builder, len, one, \"sub_alloc\")\n    // malloc(alloc_size)\n    let buf = cg_malloc(ctx, alloc_size)\n    // memcpy(buf, src + start, len)\n    let src_int = to_i64(ctx, str_ptr, \"sub_src_int\")\n    let off_int = forge_llvm_build_add(ctx.builder, src_int, start_r.value, \"sub_off_int\")\n    let off_ptr = to_ptr(ctx, off_int, \"sub_off\")\n    call_3(ctx, get_fn(ctx, \"memcpy\"), buf, off_ptr, len, \"\")\n    // Null-terminate at buf[len].\n    let buf_int2 = to_i64(ctx, buf, \"sub_buf_int\")\n    let nul_int = forge_llvm_build_add(ctx.builder, buf_int2, len, \"sub_nul_int\")\n    let nul_ptr = to_ptr(ctx, nul_int, \"sub_nul\")\n    forge_llvm_build_store(ctx.builder, const_i8(ctx, 0), nul_ptr)\n    let result_i64 = to_i64(ctx, buf, \"sub_result\")\n    ok_emit_str(result_i64)\n}\n\nfn emit_str_cmp(ctx: Ctx, lhs_i64: ptr, rhs_i64: ptr, pred: int) -> EmitResult {\n    // Lower string ordering ops (<, <=, >, >=) to a libc strcmp\n    // call followed by a signed comparison of the result against\n    // 0. We sign-extend strcmp's i32 result into i64 ourselves\n    // because the host's build_icmp wrapper auto-promotes i32\n    // operands via zero-extend, which would turn a negative\n    // strcmp result into a huge positive i64 and break signed\n    // comparison.\n    let lhs_ptr = to_ptr(ctx, lhs_i64, \"scmp_l\")\n    let rhs_ptr = to_ptr(ctx, rhs_i64, \"scmp_r\")\n    let result32 = call_2(ctx, get_fn(ctx, \"strcmp\"), lhs_ptr, rhs_ptr, \"strcmp_call\")\n    let result64 = forge_llvm_build_sext(ctx.builder, result32, ctx.i64_type, \"strcmp_sext\")\n    let zero64 = const_i64(ctx, 0)\n    let cmp = forge_llvm_build_icmp(ctx.builder, pred, result64, zero64, \"scmp_cmp\")\n    ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"scmp_ext\"))\n}\n\nfn emit_str_eq(ctx: Ctx, lhs_i64: ptr, rhs_i64: ptr, invert: bool) -> EmitResult {\n    let lhs_ptr = to_ptr(ctx, lhs_i64, \"streq_l\")\n    let rhs_ptr = to_ptr(ctx, rhs_i64, \"streq_r\")\n    let result32 = call_2(ctx, get_fn(ctx, \"strcmp\"), lhs_ptr, rhs_ptr, \"strcmp_call\")\n    // Compare strcmp result against 0 (i32). For == we want eq;\n    // for != we want ne. The result of icmp is i1; zext to i64.\n    let zero32 = forge_llvm_const_int(forge_llvm_int32_type(ctx.lc), 0, 0)\n    let pred = if invert { 33 } else { 32 }\n    let cmp = forge_llvm_build_icmp(ctx.builder, pred, result32, zero32, \"streq_cmp\")\n    ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"streq_ext\"))\n}\n\nfn strip_quotes(s: string) -> string {\n    let len = s.length\n    if len < 2 {\n        return s\n    }\n    s.substring(1, len - 1)\n}\n\nfn fill_arg_array(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {\n    match args {\n        .End -> ok_emit(null_ptr_val())\n        .Node(expr, next) -> {\n            let r = emit_expr(ctx, env, expr)\n            if r.had_error {\n                return r\n            }\n            forge_llvm_value_array_set(arr, idx, r.value)\n            fill_arg_array(ctx, env, arr, next, idx + 1)\n        }\n    }\n}\n\nfn emit_unary(ctx: Ctx, env: VarEnv, operator: string, right: Expr) -> EmitResult {\n    let right_result = emit_expr(ctx, env, right)\n    if right_result.had_error {\n        return right_result\n    }\n\n    if operator == \"-\" {\n        let zero = const_i64(ctx, 0)\n        return ok_emit(forge_llvm_build_sub(ctx.builder, zero, right_result.value, \"neg\"))\n    }\n\n    if operator == \"!\" {\n        let cmp = forge_llvm_build_icmp(ctx.builder, 32, right_result.value, const_i64(ctx, 0), \"not_cmp\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"not\"))\n    }\n\n    err_emit(\"unsupported unary operator `\" + operator + \"`\")\n}\n\nfn is_null_literal(e: Expr) -> bool {\n    match e {\n        .Null -> true\n        _ -> false\n    }\n}\n\nfn emit_binary(ctx: Ctx, env: VarEnv, left: Expr, operator: string, right: Expr) -> EmitResult {\n    let left_result = emit_expr(ctx, env, left)\n    if left_result.had_error {\n        return left_result\n    }\n    let lhs = left_result.value\n\n    let right_result = emit_expr(ctx, env, right)\n    if right_result.had_error {\n        return right_result\n    }\n    let rhs = right_result.value\n\n    // Comparing against a null literal must always be a plain pointer/i64\n    // icmp — never strcmp, which would deref the NULL side and crash.\n    let null_cmp = is_null_literal(left) || is_null_literal(right)\n\n    if operator == \"+\" {\n        // Dispatch + on operand types: if either side is a string,\n        // emit a string concat sequence (strlen+strlen+malloc+memcpy\n        // ×2 + null-terminate). Otherwise it's an integer add.\n        if left_result.ty == \"str\" || right_result.ty == \"str\" {\n            return emit_concat(ctx, lhs, rhs)\n        }\n        return ok_emit(forge_llvm_build_add(ctx.builder, lhs, rhs, \"add\"))\n    }\n    if operator == \"-\" { return ok_emit(forge_llvm_build_sub(ctx.builder, lhs, rhs, \"sub\")) }\n    if operator == \"*\" { return ok_emit(forge_llvm_build_mul(ctx.builder, lhs, rhs, \"mul\")) }\n    if operator == \"/\" { return ok_emit(forge_llvm_build_sdiv(ctx.builder, lhs, rhs, \"div\")) }\n\n    // Comparisons: icmp returns i1, zext to i64\n    // pred: 32=eq, 33=ne, 38=sgt, 39=sge, 40=slt, 41=sle\n    if operator == \"==\" {\n        if !null_cmp && (left_result.ty == \"str\" || right_result.ty == \"str\") {\n            return emit_str_eq(ctx, lhs, rhs, false)\n        }\n        let cmp = forge_llvm_build_icmp(ctx.builder, 32, lhs, rhs, \"eq\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"eq_ext\"))\n    }\n    if operator == \"!=\" {\n        if !null_cmp && (left_result.ty == \"str\" || right_result.ty == \"str\") {\n            return emit_str_eq(ctx, lhs, rhs, true)\n        }\n        let cmp = forge_llvm_build_icmp(ctx.builder, 33, lhs, rhs, \"ne\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"ne_ext\"))\n    }\n    if operator == \"<\" {\n        if left_result.ty == \"str\" || right_result.ty == \"str\" {\n            return emit_str_cmp(ctx, lhs, rhs, 40)\n        }\n        let cmp = forge_llvm_build_icmp(ctx.builder, 40, lhs, rhs, \"slt\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"slt_ext\"))\n    }\n    if operator == \"<=\" {\n        if left_result.ty == \"str\" || right_result.ty == \"str\" {\n            return emit_str_cmp(ctx, lhs, rhs, 41)\n        }\n        let cmp = forge_llvm_build_icmp(ctx.builder, 41, lhs, rhs, \"sle\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"sle_ext\"))\n    }\n    if operator == \">\" {\n        if left_result.ty == \"str\" || right_result.ty == \"str\" {\n            return emit_str_cmp(ctx, lhs, rhs, 38)\n        }\n        let cmp = forge_llvm_build_icmp(ctx.builder, 38, lhs, rhs, \"sgt\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"sgt_ext\"))\n    }\n    if operator == \">=\" {\n        if left_result.ty == \"str\" || right_result.ty == \"str\" {\n            return emit_str_cmp(ctx, lhs, rhs, 39)\n        }\n        let cmp = forge_llvm_build_icmp(ctx.builder, 39, lhs, rhs, \"sge\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"sge_ext\"))\n    }\n\n    if operator == \"&&\" {\n        // Eager-bitwise lowering — short-circuit can come later.\n        let l_bool = forge_llvm_build_icmp(ctx.builder, 33, lhs, const_i64(ctx, 0), \"l_bool\")\n        let r_bool = forge_llvm_build_icmp(ctx.builder, 33, rhs, const_i64(ctx, 0), \"r_bool\")\n        let l_ext = forge_llvm_build_zext(ctx.builder, l_bool, ctx.i64_type, \"l_ext\")\n        let r_ext = forge_llvm_build_zext(ctx.builder, r_bool, ctx.i64_type, \"r_ext\")\n        return ok_emit(forge_llvm_build_mul(ctx.builder, l_ext, r_ext, \"and\"))\n    }\n    if operator == \"||\" {\n        let l_bool = forge_llvm_build_icmp(ctx.builder, 33, lhs, const_i64(ctx, 0), \"l_bool\")\n        let r_bool = forge_llvm_build_icmp(ctx.builder, 33, rhs, const_i64(ctx, 0), \"r_bool\")\n        let l_ext = forge_llvm_build_zext(ctx.builder, l_bool, ctx.i64_type, \"l_ext\")\n        let r_ext = forge_llvm_build_zext(ctx.builder, r_bool, ctx.i64_type, \"r_ext\")\n        let sum = forge_llvm_build_add(ctx.builder, l_ext, r_ext, \"or_sum\")\n        let nonzero = forge_llvm_build_icmp(ctx.builder, 33, sum, const_i64(ctx, 0), \"or_cmp\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, nonzero, ctx.i64_type, \"or\"))\n    }\n\n    err_emit(\"unsupported binary operator `\" + operator + \"`\")\n}\n","structuredPatch":[{"oldStart":504,"oldLines":7,"newStart":504,"newLines":7,"lines":["         .Grouping(inner) -> emit_expr(ctx, env, inner)","         .Unary(operator, right) -> emit_unary(ctx, env, operator, right)","         .Binary(left, operator, right) -> emit_binary(ctx, env, left, operator, right)","-  