, invert: bool) -> EmitResult {\n    let lhs_ptr = to_ptr(ctx, lhs_i64, \"streq_l\")\n    let rhs_ptr = to_ptr(ctx, rhs_i64, \"streq_r\")\n    let result32 = call_2(ctx, get_fn(ctx, \"strcmp\"), lhs_ptr, rhs_ptr, \"strcmp_call\")\n    // Compare strcmp result against 0 (i32). For == we want eq;\n    // for != we want ne. The result of icmp is i1; zext to i64.\n    let zero32 = forge_llvm_const_int(forge_llvm_int32_type(ctx.lc), 0, 0)\n    let pred = if invert { 33 } else { 32 }\n    let cmp = forge_llvm_build_icmp(ctx.builder, pred, result32, zero32, \"streq_cmp\")\n    ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"streq_ext\"))\n}\n\nfn strip_quotes(s: string) -> string {\n    let len = s.length\n    if len < 2 {\n        return s\n    }\n    s.substring(1, len - 1)\n}\n\nfn fill_arg_array(ctx: Ctx, env: VarEnv, arr: ptr, args: ExprList, idx: int) -> EmitResult {\n    match args {\n        .End -> ok_emit(null_ptr_val())\n        .Node(expr, next) -> {\n            let r = emit_expr(ctx, env, expr)\n            if r.had_error {\n                return r\n            }\n            forge_llvm_value_array_set(arr, idx, r.value)\n            fill_arg_array(ctx, env, arr, next, idx + 1)\n        }\n    }\n}\n\nfn emit_unary(ctx: Ctx, env: VarEnv, operator: string, right: Expr) -> EmitResult {\n    let right_result = emit_expr(ctx, env, right)\n    if right_result.had_error {\n        return right_result\n    }\n\n    if operator == \"-\" {\n        let zero = const_i64(ctx, 0)\n        return ok_emit(forge_llvm_build_sub(ctx.builder, zero, right_result.value, \"neg\"))\n    }\n\n    if operator == \"!\" {\n        let cmp = forge_llvm_build_icmp(ctx.builder, 32, right_result.value, const_i64(ctx, 0), \"not_cmp\")\n        return ok_emit(forge_llvm_build_zext(ctx.builder, cmp, ctx.i64_type, \"not\"))\n    }\n\n    err_emit(\"unsupported unary operator `\" + operator + \"`\")\n}\n\nfn is_null_literal(e: Expr) -> bool {\n    match e {\n        .Null -> t