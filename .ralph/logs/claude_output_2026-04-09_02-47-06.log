{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MSe5WceD5AvSNMNYJ7REwG","type":"tool_result","content":"     1→// WHY: emits enum constructors (heap-allocated tagged unions).\n     2→\n     3→use core.ast.{Expr, ExprList, VariantList, VarEnv, variant_lookup, variant_max_payload}\n     4→use core.cg.{Ctx, EmitResult, ok_emit, err_emit, null_ptr_val, enum_reg_lookup}\n     5→use codegen.{emit_expr}\n     6→\n     7→\n     8→export fn emit_enum_ctor(ctx: Ctx, env: VarEnv, type_name: string, variant: string, args: ExprList) -> EmitResult {\n     9→    let enum_l = enum_reg_lookup(ctx.enums, type_name)\n    10→    if !enum_l.found {\n    11→        return err_emit(\"undefined enum type `\" + type_name + \"`\")\n    12→    }\n    13→    let v = variant_lookup(enum_l.variants, variant)\n    14→    if !v.found {\n    15→        return err_emit(\"enum `\" + type_name + \"` has no variant `\" + variant + \"`\")\n    16→    }\n    17→    let st_ty = forge_llvm_get_type_by_name(ctx.lc, type_name)\n    18→    if st_ty == null {\n    19→        return err_emit(\"LLVM enum type `\" + type_name + \"` not declared\")\n    20→    }\n    21→    let buf = malloc_enum_bytes(ctx, enum_l.variants)\n    22→    let tag_gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, buf, 0, \"tag_ptr\")\n    23→    let tag_val = const_i8(ctx, v.tag)\n    24→    forge_llvm_build_store(ctx.builder, tag_val, tag_gep)\n    25→    let fill = fill_enum_payload(ctx, env, st_ty, buf, args, 0)\n    26→    if fill.had_error { return fill }\n    27→    let as_i64 = to_i64(ctx, buf, \"enum_i64\")\n    28→    EmitResult { value: as_i64, ty: \"enum:\" + type_name, had_error: false, error_message: \"\" }\n    29→}\n    30→\n    31→export fn malloc_enum_bytes(ctx: Ctx, variants: VariantList) -> ptr {\n    32→    let max_payload = variant_max_payload(variants)\n    33→    let size = forge_llvm_const_int(ctx.i64_type, (max_payload + 1) * 8, 0)\n    34→    let malloc_fn = forge_llvm_get_named_function(ctx.module, \"malloc\")\n    35→    let pa = forge_llvm_type_array_new(1)\n    36→    forge_llvm_type_array_set(pa, 0, ctx.i64_type)\n    37→    let malloc_type = forge_llvm_function_type(ctx.ptr_type, pa, 1, 0)\n    38→    forge_llvm_type_array_free(pa)\n    39→    let arr = forge_llvm_value_array_new(1)\n    40→    forge_llvm_value_array_set(arr, 0, size)\n    41→    let buf = forge_llvm_build_call(ctx.builder, malloc_type, malloc_fn, arr, 1, \"enum_buf\")\n    42→    forge_llvm_value_array_free(arr)\n    43→    buf\n    44→}\n    45→\n    46→fn fill_enum_payload(ctx: Ctx, env: VarEnv, st_ty: ptr, alloca: ptr, args: ExprList, idx: int) -> EmitResult {\n    47→    match args {\n    48→        .End -> ok_emit(null_ptr_val())\n    49→        .Node(expr, next) -> {\n    50→            let r = emit_expr(ctx, env, expr)\n    51→            if r.had_error { return r }\n    52→            let gep = forge_llvm_build_struct_gep2(ctx.builder, st_ty, alloca, idx + 1, \"epay_ptr\")\n    53→            forge_llvm_build_store(ctx.builder, r.value, gep)\n    54→            fill_enum_payload(ctx, env, st_ty, alloca, next, idx + 1)\n    55→        }\n    56→    }\n    57→}\n    58→"}]},"parent_tool_use_id":"toolu_01RGkfPQEKR22Wd4E5Q2H9dn","session_id":"99531a4f-114c-49ff-a929-dced21bdd83f","uuid":"5956dca9-9e91-4086-903f-c7f6f0ce2277","timestamp":"2026-04-09T09:48:30.770Z"}
